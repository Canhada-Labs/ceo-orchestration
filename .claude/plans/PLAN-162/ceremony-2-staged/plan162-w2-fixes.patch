+    """
+    data = json.loads(_SETTINGS_PATH.read_text(encoding="utf-8"))
+    found: List[float] = []
+    for entries in (data.get("hooks") or {}).values():
+        for entry in entries or []:
+            for h in entry.get("hooks") or []:
+                if "check_canonical_edit" in (h.get("command") or ""):
+                    value = h.get("timeout")
