+def test_invocation_is_blocked(slug, command):
+    """The model rail must not be able to RUN the posture toggle."""
+    d = decide_command(command)
+    assert not d.allow, (
+        "NF-08 [%s]: model-rail invocation of the posture toggle was ALLOWED: %r"
+        % (slug, command)
