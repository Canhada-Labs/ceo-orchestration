+                "- MAY read docs; %s\n" % suffix
+            )
+            self.assertEqual(state, "unparseable", suffix)
+
+    def test_denied_path_with_authority_substring_passes(self):
+        """Codex r42: `- CANNOT edit: src/write.py` é path negado
