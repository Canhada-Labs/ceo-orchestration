   923	        self.assertLess(
   924	            block.index("%s delta" % _GUARD_MODULE),
   925	            block.index("%s ancestry" % _GUARD_MODULE),
   926	            "pinned order broken inside the gate: delta before ancestry",
   927	        )
   928	        self.assertLess(
