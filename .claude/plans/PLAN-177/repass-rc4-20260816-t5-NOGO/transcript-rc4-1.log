   170	class TestNonCanonicalTopLevelKeySyntax(unittest.TestCase):
   171	    """PLAN-177 t2 (re-pass rc.4 P1-a) — one grammar for both release rails.
   172	
   173	    `verdict : NO-GO` is valid YAML and last-wins under a real parser. THIS
   174	    validator strips the key, so it saw two declarations; the local tag guard
   175	    (`.claude/scripts/local/_release_tag_guard.py`, the rail with no escape
   176	    hatch) required the colon immediately after the name, saw ONE, and parsed
   177	    the following `verdict: GO`. Cured semantics, identical in both files:
   178	    non-canonical top-level syntax is REFUSED — exit 3, never 1, so the
   179	    transition mode cannot wave it through.
   180	    """
   181	
   182	    PARENT = "abcdef0123456789abcdef0123456789abcdef01"
   183	    DIAGNOSTIC = "non-canonical top-level key syntax"
   184	
   185	    def _run_decisions(self, decision_lines):
   186	        v = _make_verdict(
   187	            decision_lines=decision_lines,
   188	            parent_sha=self.PARENT,
   189	            release_tag="v1.99.0",
   190	        )
   191	        return _run(
   192	            ["--parent-sha", self.PARENT, "--release-tag", "v1.99.0"], v
   193	        )
   194	
   195	    def test_space_before_colon_duplicate_is_refused(self):
   196	        r = self._run_decisions(["verdict : NO-GO", "verdict: GO"])
   197	        self.assertEqual(r.returncode, EXIT_VERDICT_INVALID, msg=r.stderr)
   198	        self.assertIn(self.DIAGNOSTIC, r.stderr)
   199	        self.assertNotIn("Traceback", r.stderr)
