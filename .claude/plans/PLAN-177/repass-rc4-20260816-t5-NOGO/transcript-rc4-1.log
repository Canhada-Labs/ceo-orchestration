   745	class W1BReleaseGateDeltaAncestryTest(TestEnvContext):
   746	    """The verdict delta + ancestry gate step (dual-context)."""
   747	
   748	    def setUp(self):
   749	        super().setUp()
   750	        resolved = _w1b_release_text()
   751	        if resolved is None:
   752	            self.skipTest(
   753	                "PLAN-166 W1-B release.yml not landed and staged mirror "
   754	                "absent (pre-landing CI window)"
   755	            )
   756	        self.source, self.context = resolved
   757	
   758	    # -- existence + independence from the step-15 escape hatches --------
   759	
   760	    def test_gate_step_present(self):
   761	        self.assertIn(
   762	            "- name: %s" % _W1B_STEP_NAME, self.source,
   763	            "the W1-B verdict delta + ancestry gate step is missing",
   764	        )
