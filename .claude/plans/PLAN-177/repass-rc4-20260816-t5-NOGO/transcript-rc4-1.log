   154	    m = _YAML_BLOCK_RE.search(text)
   155	    if not m:
   156	        return []
   157	    bad: List[str] = []
   158	    prev_scalar_decl = False
   159	    for raw in m.group(1).splitlines():
   160	        line = _strip_comment(raw)
   161	        if not line.strip():
   162	            continue
   163	        if line[0] in (" ", "\t"):
   164	            # Sub-level line. Legitimate ONLY under a parent declared as a
   165	            # bare `key:` (mapping/list). After a SCALAR `key: value`, an
   166	            # indented non-comment line is a YAML CONTINUATION that changes
   167	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   168	            # while this minimal reader still saw `GO` — reject fail-closed
   169	            # (re-pass rc.4 t2 P1).
   170	            if prev_scalar_decl:
   171	                bad.append(line)
   172	            continue
   173	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   174	            _key, _, _val = line.partition(":")
   175	            prev_scalar_decl = bool(_val.strip())
   176	            continue
   177	        if line.startswith("- "):  # top-level list item
   178	            prev_scalar_decl = False
   179	            continue
   180	        bad.append(line)
   181	        prev_scalar_decl = False
   182	    return bad
   183	
   184	
   185	def count_top_level_key(text: str, key: str) -> int:
   186	    """How many times `key:` is declared at the top level of the block.
   187	
   188	    Both readers of this signed file are LAST-WINS, so a second
   189	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   190	    as GO. Callers require exactly one.
   191	
   192	    Only meaningful once `noncanonical_top_level_lines` is empty: this
   193	    counter strips the key, so it sees `verdict : X` as a declaration and
   194	    the twin counter in the tag guard does not. Callers run the shape
   195	    check FIRST.
   196	    """
   197	    m = _YAML_BLOCK_RE.search(text)
   198	    if not m:
   199	        return 0
   200	    seen = 0
   201	    for raw in m.group(1).splitlines():
   202	        line = _strip_comment(raw)
   203	        if not line.strip() or line[0] in (" ", "\t"):
   204	            continue
   205	        if line.partition(":")[0].strip() == key:
   206	            seen += 1
   207	    return seen
   208	
   209	
   210	def parse_verdict_text(text: str) -> Dict[str, Any]:
   211	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   212	    m = _YAML_BLOCK_RE.search(text)
   213	    if not m:
   214	        raise ValueError("verdict file missing yaml frontmatter block")
   215	    yaml_body = m.group(1)
   216	    # Inline minimal YAML parse (stdlib only)
   217	    out: Dict[str, Any] = {}
   218	    current_key: Optional[str] = None
   219	    for raw in yaml_body.splitlines():
   220	        line = _strip_comment(raw)
   221	        if not line.strip():
   222	            continue
   223	        if line[0] not in (" ", "\t"):
   224	            if ":" in line:
   225	                k, _, v = line.partition(":")
   226	                v = v.strip()
   227	                if v:
   228	                    out[k.strip()] = v
   229	                else:
   230	                    out[k.strip()] = {}
   231	                    current_key = k.strip()
   232	        elif current_key and ":" in line:
   233	            sub_k, _, sub_v = line.partition(":")
   234	            if isinstance(out[current_key], dict):
   235	                out[current_key][sub_k.strip()] = sub_v.strip()
   236	    return out
   237	
   238	
   239	def parse_verdict_file(path: Path) -> Dict[str, Any]:
   240	    """Path wrapper over parse_verdict_text (published entry point)."""
   241	    if not path.exists():
   242	        raise FileNotFoundError(f"verdict file: {path}")
   243	    return parse_verdict_text(path.read_text(encoding="utf-8"))
   244	
   245	
   246	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   247	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   248	    if not manifest_path.exists():
   249	        raise FileNotFoundError(f"manifest: {manifest_path}")
   250	    paths = []
   251	    for line in manifest_path.read_text().splitlines():
   252	        line = line.split("#", 1)[0].strip()
   253	        if line:
   254	            paths.append(line)
   255	    paths.sort()
   256	    hashes = {}
   257	    for p in paths:
   258	        result = subprocess.run(
   259	            ["git", "hash-object", p],
   260	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   261	        )
   262	        if result.returncode != 0:
   263	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   264	        hashes[p] = result.stdout.strip()
   265	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   266	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   267	
   268	
   269	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   270	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   271	    if not pin_file.exists():
   272	        return None, None
   273	    for line in pin_file.read_text().splitlines():
   274	        line = line.split("#", 1)[0].strip()
   275	        if not line:
   276	            continue
   277	        # parse `>=X.Y.Z,<A.B.C` shape
   278	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   279	        if m:
   280	            return m.group(1), m.group(2)
   281	    return None, None
   282	
   283	
   284	def parse_semver(s: str) -> Tuple[int, int, int]:
   285	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   286	    if not m:
   287	        raise ValueError(f"unparseable semver: {s!r}")
   288	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   289	
   290	
   291	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   292	    try:
   293	        v = parse_semver(version)
   294	        lo = parse_semver(min_v)
   295	        hi = parse_semver(max_v)
   296	        return lo <= v < hi
   297	    except ValueError:
   298	        return False
   299	
