    88	E_REMOTE_REF = 5
    89	E_DELTA = 6
    90	E_MANIFEST_PIN = 7
    91	E_MANIFEST_CONTENT = 8
    92	E_MANIFEST_SET = 9
    93	E_VERDICT = 10
    94	E_VACUOUS = 11
