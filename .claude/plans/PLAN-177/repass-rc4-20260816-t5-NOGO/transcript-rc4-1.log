   978	class W1BGuardModuleContractTest(TestEnvContext):
   979	    """The live module surface the workflow step depends on.
   980	
   981	    These asserts pin the CONTRACT the W1-B step consumes, so a module
   982	    refactor that renames a subcommand or the parser is caught by the
   983	    suite before it bricks a release run.
   984	    """
   985	
   986	    def setUp(self):
   987	        super().setUp()
   988	        self.module_path = _REPO / _GUARD_MODULE
   989	        if not self.module_path.is_file():
   990	            self.fail(
   991	                "%s missing — the W1-B release.yml step invokes it; "
   992	                "landing the workflow without the module bricks every "
   993	                "release run" % _GUARD_MODULE
   994	            )
   995	        import importlib.util
   996	
   997	        spec = importlib.util.spec_from_file_location(
   998	            "release_tag_guard_w1b_contract", str(self.module_path)
   999	        )
  1000	        self.mod = importlib.util.module_from_spec(spec)
  1001	        spec.loader.exec_module(self.mod)
  1002	
  1003	    def test_module_exposes_the_consumed_surface(self):
  1004	        for attr in ("_parse_verdict", "delta", "ancestry", "main"):
  1005	            self.assertTrue(
  1006	                hasattr(self.mod, attr),
  1007	                "module lost %r — the W1-B workflow step consumes it"
  1008	                % attr,
  1009	            )
  1010	
  1011	    def test_parse_verdict_reads_parent_sha(self):
  1012	        fields = self.mod._parse_verdict(
  1013	            "# t\n\n```yaml\nparent_sha: "
  1014	            "4111a115190d375c39c90cc33ac1d9d5899c1cf2\n```\n"
  1015	        )
  1016	        self.assertEqual(
  1017	            fields.get("parent_sha"),
  1018	            "4111a115190d375c39c90cc33ac1d9d5899c1cf2",
  1019	        )
  1020	
  1021	    def test_module_exit_codes_are_distinct_nonzero(self):
  1022	        # The workflow relies on ANY non-zero exit failing the step
  1023	        # (set -euo pipefail); pin that the module failure codes are
  1024	        # non-zero and mutually distinct so the failure MODE stays
  1025	        # testable.
  1026	        #
  1027	        # PLAN-177 W0.1 / CF-4: DERIVED from the module, not enumerated
  1028	        # by hand. The hand-kept list rotted -- it omitted
  1029	        # E_PARENT_NOT_ANCESTOR (12) from the day that mode was added, so
  1030	        # the assert stopped covering the NEWEST failure mode, which is
  1031	        # precisely when it is load-bearing. vars() cannot rot.
  1032	        codes = {
  1033	            name: value
  1034	            for name, value in vars(self.mod).items()
  1035	            if name.startswith("E_") and isinstance(value, int)
  1036	        }
  1037	        self.assertGreaterEqual(
  1038	            len(codes), 12,
  1039	            "the exit-code table shrank (%d modes) -- a removed mode is "
  1040	            "a removed failure surface: %r" % (len(codes), codes),
  1041	        )
  1042	        self.assertNotIn(
  1043	            0, list(codes.values()),
  1044	            "a failure mode with exit 0 is a silent pass: %r" % codes,
  1045	        )
  1046	        self.assertEqual(
  1047	            len(set(codes.values())), len(codes),
  1048	            "two modes share an exit code -- the failure MODE stops "
  1049	            "being testable: %r" % codes,
  1050	        )
  1051	        # the decision gate is a mode of its own (PLAN-177 W0.1)
  1052	        self.assertIn("E_DECISION", codes)
  1053	
