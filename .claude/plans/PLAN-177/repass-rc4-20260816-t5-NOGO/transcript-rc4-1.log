   845	    def test_delta_semantics_not_reimplemented_in_bash(self):
   846	        # The bash body must not carry the decision vocabulary of the
   847	        # module — reading the allowlist or hashing the manifest in
   848	        # shell would be a second implementation of the same closed-set
   849	        # semantics. Comment lines are excluded: the step's rationale
   850	        # comment legitimately NAMES what the module does; only CODE
   851	        # lines may not do it.
   852	        block = _step_block(self.source, _W1B_STEP_NAME)
   853	        code_lines = "\n".join(
   854	            line for line in block.splitlines()
   855	            if not line.lstrip().startswith("#")
   856	        )
   857	        for forbidden in ("delta_allowlist", "shasum -c", "shasum -a 256"):
   858	            self.assertNotIn(
   859	                forbidden, code_lines,
   860	                "the W1-B step re-implements delta semantics in bash "
   861	                "(%r found outside comments) — the module is the only "
   862	                "implementation" % forbidden,
   863	            )
