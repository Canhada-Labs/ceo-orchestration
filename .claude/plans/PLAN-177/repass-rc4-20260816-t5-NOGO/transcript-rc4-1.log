  2500	def test_both_rails_answer_identically_on_every_key_shape():
  2501	    """The instrument that would have caught P1-a: ONE question, two readers.
  2502	
  2503	    A divergence is only visible when the same bytes are put to both. For any
  2504	    block both accept, they must also agree on how many decisions it declares
  2505	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2506	    things on the two machines that gate a release.
  2507	    """
  2508	    def block(body: str) -> str:
  2509	        return "# fixture\n\n```yaml\n%s```\n" % body
  2510	
  2511	    canonical_shapes = [
  2512	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2513	        "verdict: NO-GO\nverdict: GO\n",
  2514	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2515	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2516	        "verdict: GO  # inline comment\n",
  2517	        "verdict: GO#NO-GO\nrelease_tag: v1.2.3\n",
  2518	        "# verdict: NO-GO\nverdict: GO\n",
  2519	    ]
  2520	    noncanonical_shapes = [
  2521	        "verdict: GO\n  NO-GO\nrelease_tag: v1.2.3\n",
  2522	        "verdict : NO-GO\nverdict: GO\n",
  2523	        "verdict\t: NO-GO\nverdict: GO\n",
  2524	        "verdict : GO\n",
  2525	        '"verdict": GO\n',
  2526	        "verdict :GO\n",
  2527	    ]
  2528	    for body in canonical_shapes:
  2529	        text = block(body)
  2530	        assert validator.noncanonical_top_level_lines(text) == [], body
  2531	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2532	        assert validator.count_top_level_key(
  2533	            text, "verdict"
  2534	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2535	            "the two rails disagree on how many decisions %r declares" % body
  2536	        )
  2537	        assert validator.parse_verdict_text(text).get(
  2538	            "verdict"
  2539	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2540	            "the two rails disagree on WHICH decision wins in %r" % body
  2541	        )
  2542	    for body in noncanonical_shapes:
  2543	        text = block(body)
  2544	        assert validator.noncanonical_top_level_lines(text) != [], body
  2545	        assert (
  2546	            tag_guard._noncanonical_top_level_lines(text)
  2547	            == validator.noncanonical_top_level_lines(text)
  2548	        ), "the two shape gates disagree about %r" % body
  2549	
