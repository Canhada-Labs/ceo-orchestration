   886	    def test_gate_step_invokes_the_guard_delta_mode(self):
   887	        """PLAN-177 W0.1 / CF-3 -- the decision gate ships in two rails
   888	        and only ONE of them enforces in every mode. Step 15 carries
   889	        `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   890	        (release.yml), so the decision check THERE is defence in depth;
   891	        this step has no escape hatch (pinned by
   892	        test_gate_step_has_no_continue_on_error), which makes the module
   893	        invocation below the enforcement path in all modes. Pinned so a
   894	        refactor cannot drop the call and leave the decision gated only by
   895	        the step that can be waived."""
   896	        block = _step_block(self.source, _W1B_STEP_NAME)
   897	        self.assertIn(
   898	            "%s delta" % _GUARD_MODULE, block,
   899	            "the fail-closed gate step no longer invokes the tag guard "
   900	            "in delta mode -- that call is where the verdict DECISION is "
   901	            "enforced when the step-15 escape hatch is open",
