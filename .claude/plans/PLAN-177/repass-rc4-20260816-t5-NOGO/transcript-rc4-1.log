   112	class TestParentShaBind(unittest.TestCase):
   113	    """S104 redesign: --parent-sha is the canonical bind."""
   114	
   115	    PARENT = "abcdef0123456789abcdef0123456789abcdef01"
   116	
   117	    def test_parent_sha_match_passes_bind(self):
   118	        v = _make_verdict(parent_sha=self.PARENT, release_tag="v1.99.0")
   119	        r = _run(
   120	            [
   121	                "--parent-sha", self.PARENT,
   122	                "--release-tag", "v1.99.0",
   123	            ],
   124	            v,
   125	        )
   126	        # Bind passes; other checks may still pass too (no pin files
   127	        # requested → skipped). Expected exit 0.
   128	        self.assertEqual(r.returncode, EXIT_OK, msg=r.stderr)
   129	
