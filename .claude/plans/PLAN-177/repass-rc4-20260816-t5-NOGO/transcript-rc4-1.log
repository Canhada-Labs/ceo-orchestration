   906	    def test_pinned_step_order(self):
   907	        i_gpg = self.source.index("- name: %s" % _W1B_GPG_STEP_NAME)
   908	        i_verdict = self.source.index("- name: %s" % _W1B_STEP15_NAME)
   909	        i_gate = self.source.index("- name: %s" % _W1B_STEP_NAME)
   910	        self.assertLess(
   911	            i_gpg, i_verdict,
   912	            "pinned order broken: GPG verify must precede the verdict "
   913	            "validation",
   914	        )
   915	        self.assertLess(
   916	            i_verdict, i_gate,
   917	            "pinned order broken: the verdict validation (step 15) must "
   918	            "precede the delta+ancestry gate",
