   200	def _parse_verdict(text: str) -> Dict[str, object]:
   201	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   202	
   203	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   204	    of `  - item` list entries, and ignores everything else. Anything it cannot
   205	    read is absent, and every consumer below treats absent as fail-closed.
   206	
   207	    Parity with the step-15 reader (`.github/scripts/
   208	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   209	    scope: block selection (the regex below is the validator's own — the
   210	    first ```yaml fence, not the first fence of any language) and inline
   211	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   212	    parse_verdict_file reads key:value and sub-dicts and would drop
   213	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   214	    ONE shared reader (this file is the declared reference), never grow a
   215	    third parser of the same signed file.
   216	    """
   217	    fields: Dict[str, object] = {}
   218	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   219	    if block is None:
   220	        # No yaml block -> no fields -> every consumer below fails closed.
   221	        return fields
   222	    cur_list: Optional[str] = None
   223	    for raw in block.group(1).splitlines():
   224	        line = _strip_yaml_comment(raw)
   225	        if not line.strip():
   226	            continue
   227	        if line.startswith(("  - ", "- ")) and cur_list:
   228	            item = line.split("-", 1)[1].strip()
   229	            if item:
   230	                fields[cur_list].append(item)  # type: ignore[union-attr]
   231	            continue
   232	        m = re.match(r"\A([A-Za-z0-9_]+):\s*(.*)\Z", line)
   233	        if not m:
   234	            continue
   235	        key, val = m.group(1), m.group(2).strip()
   236	        if val == "":
   237	            fields[key] = []
   238	            cur_list = key
   239	        else:
   240	            fields[key] = val
   241	            cur_list = None
   242	    return fields
   243	
   244	
   245	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   246	# The two readers of this signed file disagreed about what a key IS: the
   247	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   248	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   249	# file demand the colon immediately after the name, so they skipped the line.
   250	# The valid-YAML pair
   251	#
   252	#     verdict : NO-GO
   253	#     verdict: GO
   254	#
   255	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   256	# and this is the rail that enforces in every mode, so the tag was authorised.
   257	#
   258	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   259	# fail-closed. Trimming the key in both readers would also close the
   260	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   261	# author writes and no template emits; refusing the shape is the smaller
   262	# surface and is the only behaviour that cannot silently prefer a value.
   263	# A top-level line is canonical iff it is `name:` with no whitespace before
   264	# the colon, or a `- ` list item.
   265	def _strip_yaml_comment(raw):
   266	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   267	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   268	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Byte-for-
   269	    byte twin of `_strip_comment` in validate-pair-rail-verdict.py.
   270	    """
   271	    if raw.lstrip().startswith("#"):
   272	        return ""
   273	    i = 0
   274	    while True:
   275	        j = raw.find("#", i)
   276	        if j == -1:
   277	            return raw.rstrip()
   278	        if j > 0 and raw[j - 1] in (" ", "\t"):
   279	            return raw[:j].rstrip()
   280	        i = j + 1
   281	
   282	
   283	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:")
   284	
   285	
   286	def _noncanonical_top_level_lines(text: str) -> List[str]:
   287	    """Top-level lines of the yaml block that are not canonical declarations.
   288	
   289	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   290	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   291	    separate machines; neither may import the other — keep them identical).
   292	    Empty list == the block speaks the grammar both readers assume.
   293	    """
   294	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   295	    if block is None:
   296	        return []
   297	    bad: List[str] = []
   298	    prev_scalar_decl = False
   299	    for raw in block.group(1).splitlines():
   300	        line = _strip_yaml_comment(raw)
   301	        if not line.strip():
   302	            continue
   303	        if line[0] in (" ", "\t"):
   304	            # Sub-level line. Legitimate ONLY under a parent declared as a
   305	            # bare `key:` (mapping/list). After a SCALAR `key: value`, an
   306	            # indented non-comment line is a YAML CONTINUATION that changes
   307	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   308	            # while this minimal reader still saw `GO` — reject fail-closed
   309	            # (re-pass rc.4 t2 P1).
   310	            if prev_scalar_decl:
   311	                bad.append(line)
   312	            continue
   313	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   314	            _key, _, _val = line.partition(":")
   315	            prev_scalar_decl = bool(_val.strip())
   316	            continue
   317	        if line.startswith("- "):  # top-level list item
   318	            prev_scalar_decl = False
   319	            continue
   320	        bad.append(line)
   321	        prev_scalar_decl = False
   322	    return bad
   323	
   324	
   325	def _count_top_level_key(text: str, key: str) -> int:
   326	    """How many times `key:` is declared at the top level of the block.
   327	
   328	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   329	    step-15 reader: a second `verdict:` silently overrides the first, so
   330	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   331	    block selection and same comment rule as the reader, or the count
   332	    would be about a different text than the parse.
   333	
   334	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   335	    counter does NOT strip the key and the step-15 twin does, so on a
   336	    non-canonical block the two counts differ. delta() checks the shape
   337	    first.
   338	    """
   339	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   340	    if block is None:
   341	        return 0
   342	    seen = 0
   343	    for raw in block.group(1).splitlines():
   344	        line = _strip_yaml_comment(raw)
   345	        if not line.strip() or line[0] in (" ", "\t"):
   346	            continue
   347	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   348	        if m and m.group(1) == key:
   349	            seen += 1
   350	    return seen
   351	
   352	
   353	def _sha256(path: str) -> str:
   354	    h = hashlib.sha256()
   355	    with open(path, "rb") as fh:
   356	        for chunk in iter(lambda: fh.read(65536), b""):
   357	            h.update(chunk)
   358	    return h.hexdigest()
   359	
   360	
   361	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   362	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   363	    entries: List[Tuple[str, str]] = []
   364	    with open(path, encoding="utf-8") as fh:
   365	        for line in fh:
   366	            line = line.rstrip("\n")
   367	            if not line.strip():
   368	                continue
   369	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   370	            if not m:
   371	                raise ValueError("unparsable manifest line: %r" % line)
   372	            entries.append((m.group(1), m.group(2)))
   373	    return entries
   374	
   375	
   376	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   377	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   378	    directory = os.path.dirname(manifest) or "."
   379	    name = os.path.basename(manifest)
   380	    try:
   381	        proc = subprocess.run(
   382	            ["shasum", "-a", "256", "-c", name],
   383	            cwd=directory,
   384	            stdout=subprocess.PIPE,
   385	            stderr=subprocess.STDOUT,
   386	            universal_newlines=True,
   387	        )
   388	        return proc.returncode == 0, proc.stdout.strip()
   389	    except (OSError, FileNotFoundError):
   390	        bad: List[str] = []
   391	        for want, rel in _read_manifest(manifest):
   392	            full = os.path.join(directory, rel)
   393	            if not os.path.isfile(full) or _sha256(full) != want:
   394	                bad.append(rel)
   395	        if bad:
   396	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   397	        return True, "hashlib fallback: all entries match"
   398	
