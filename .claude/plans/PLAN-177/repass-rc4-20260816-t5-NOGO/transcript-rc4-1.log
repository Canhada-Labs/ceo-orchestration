   930	            block.index('git merge-base --is-ancestor "$PARENT_SHA"'),
   931	            "pinned order broken inside the gate: module ancestry "
   932	            "(fetch + HEAD) before the parent merge-base judgment — the "
   933	            "parent must be judged against the freshly fetched ref",
