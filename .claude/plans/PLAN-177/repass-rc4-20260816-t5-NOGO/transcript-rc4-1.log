   766	    def test_gate_step_has_no_continue_on_error(self):
   767	        block = _step_block(self.source, _W1B_STEP_NAME)
   768	        self.assertNotIn(
   769	            "continue-on-error", block,
   770	            "the W1-B gate must NEVER carry continue-on-error — that is "
   771	            "exactly the step-15 escape hatch it exists to be independent "
   772	            "of (debate r3 scoped VETO)",
   773	        )
   774	
   775	    def test_file_carries_exactly_one_continue_on_error(self):
   776	        # The legacy step 15 keeps its documented transition hatch
   777	        # UNCHANGED (the plan adds a new step; it does not rewrite the
   778	        # neighbourhood). Exactly one KEY occurrence pins both
   779	        # directions at once: the hatch was not silently removed from
   780	        # step 15, and no step (new or old) gained a second one. Comment
   781	        # mentions of the phrase do not count — only the YAML key form.
   782	        key_form = re.findall(
   783	            r"^\s*continue-on-error:", self.source, re.MULTILINE
   784	        )
   785	        self.assertEqual(
   786	            len(key_form), 1,
   787	            "release.yml must carry exactly one continue-on-error KEY "
   788	            "(the legacy step-15 transition hatch); found %d"
   789	            % len(key_form),
   790	        )
