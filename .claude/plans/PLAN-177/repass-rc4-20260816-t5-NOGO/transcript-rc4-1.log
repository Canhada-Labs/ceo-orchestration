   680	# PLAN-166 W1-B — structural asserts for the release.yml verdict delta +
   681	# ancestry gate (F2 server side; re-pass r15+r17+r18, debate r3 scoped
   682	# VETO). Merged verbatim from the W1-B slice file
   683	# (test_release_workflow_asserts_w1b.py) by the PLAN-166 ceremony
   684	# assembler — one runnable asserts file per the W1 pack discipline. Only
   685	# names that would collide with the W1-A section above were renamed
   686	# (_MARKER → _MARKER_W1B, _LIVE_WF/_STAGED_WF → _W1B_*).
   687	#
   688	# What is pinned here, and why each pin exists:
   689	# - The gate step exists, carries NO continue-on-error, and FAILS CLOSED
   690	#   on CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 — the step-15 neighbourhood has
   691	#   two escape hatches keyed to that var (`continue-on-error:` and the
   692	#   empty `--parent-sha ""` bind, which the validator only binds when
   693	#   non-empty); the new gate must never inherit the switch.
   694	# - The delta decision is DELEGATED to
   695	#   .claude/scripts/local/_release_tag_guard.py (the reference
   696	#   implementation) — never re-implemented in bash.
   697	# - Ancestry covers BOTH the reviewed parent AND GITHUB_SHA (r18:
   698	#   parent-only lets the tag-without-push / orphan-verdict scenario pass).
   699	# - PINNED ORDER: Verify tag GPG signature → Validate pair-rail verdict →
   700	#   delta → ancestry.
   701	# - The job keeps the exact name `release-gate` — the W1-A
   702	#   await-release-gate poller resolves the job BY NAME via the Actions
   703	#   jobs endpoint; renaming the job silently breaks the npm-publish gate.
   704	# ---------------------------------------------------------------------
   705	
   706	# Marker written into the W1-B step's comment block; its presence in the
   707	# LIVE file means the ceremony landed and the live copy is authoritative.
   708	_MARKER_W1B = "PLAN-166 W1-B"
   709	
   710	_W1B_LIVE_WF = _WF / "release.yml"
   711	_W1B_STAGED_WF = _STAGED_166_WF / "release.yml"
   712	
   713	_W1B_STEP_NAME = "Verify verdict delta + ancestry (fail-closed)"
   714	_W1B_STEP15_NAME = "Validate pair-rail verdict"
   715	_W1B_GPG_STEP_NAME = "Verify tag GPG signature"
   716	_GUARD_MODULE = ".claude/scripts/local/_release_tag_guard.py"
   717	
   718	
   719	def _w1b_release_text() -> Optional[Tuple[str, str]]:
   720	    """Return (text, context) for release.yml, or None pre-landing.
   721	
   722	    Priority: live copy carrying the W1-B marker (post-landing,
   723	    authoritative) → staged ceremony copy (pre-landing local mirror;
   724	    gitignored so absent in CI) → None (pre-landing CI: skip).
   725	    """
   726	    if _W1B_LIVE_WF.is_file():
   727	        live = _W1B_LIVE_WF.read_text(encoding="utf-8")
   728	        if _MARKER_W1B in live:
   729	            return live, "live"
   730	    if _W1B_STAGED_WF.is_file():
   731	        return _W1B_STAGED_WF.read_text(encoding="utf-8"), "staged"
   732	    return None
   733	
   734	
   735	def _step_block(source: str, step_name: str) -> str:
   736	    """The text of one step: from its `- name:` to the next step/job."""
   737	    start = source.index("- name: %s" % step_name)
   738	    nxt = source.find("\n      - name:", start + 1)
   739	    job = source.find("\n  publish-release:", start + 1)
   740	    candidates = [i for i in (nxt, job) if i != -1]
   741	    end = min(candidates) if candidates else len(source)
   742	    return source[start:end]
   743	
