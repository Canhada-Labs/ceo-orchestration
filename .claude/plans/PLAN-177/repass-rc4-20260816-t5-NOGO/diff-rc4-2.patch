+        "desc_preview": "Load WebFetch via ToolSearch?",
+        "desc_hash":
+            "3aa1aca1be9b616da5fd32fd9db7b6de5037ed45182e1e350f31cc8dbd67c24f",
+        "skill": "unknown",
+        "has_profile": False,
+        "has_file_assignment": False,
+        "rail": None,
+        "archetype": None,
