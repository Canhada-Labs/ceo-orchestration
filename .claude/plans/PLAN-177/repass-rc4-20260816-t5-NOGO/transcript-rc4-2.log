--- a/.claude/scripts/ceo-boot.py
+++ b/.claude/scripts/ceo-boot.py
@@ -430,166 +430,169 @@ def _iter_audit_events_since(hours: float = 24.0):
                 continue
             try:
                 ev = json.loads(line)
