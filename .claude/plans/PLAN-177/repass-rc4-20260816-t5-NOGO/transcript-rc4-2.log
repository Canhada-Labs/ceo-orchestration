   604	def check_skill_unknown_ratio() -> Tuple[str, str, Any]:
   605	    """Detect spawns that should have SKILL injection but didn't.
   606	
   607	    S94 follow-up: excludes intentionally skill-less archetypes —
   608	    `general-purpose` subagent dispatches via the mitigated rail
   609	    (ADR-082) by design have no SKILL.md anchor. They broker cross-
   610	    LLM gate calls and similar utility work; counting them as FPs
   611	    inflates the ratio to 100% during healthy Codex MCP sessions
   612	    and trains the operator to ignore the channel.
   613	
   614	    A spawn counts as "skill missing" ONLY when its `archetype` is
   615	    a custom (non-general-purpose) one AND `skill` is unknown/empty.
   625	    for ev in _iter_audit_events_since(24):
   626	        if ev.get("action") != "agent_spawn":
   627	            continue
   628	        if _is_test_pollution_event(ev):
   629	            test_pollution_skipped += 1
   630	            continue
   631	        if _is_ghost_spawn_event(ev):
   632	            ghosts_skipped += 1
   633	            continue
   634	        if _is_harness_probe_event(ev):
   635	            harness_probes_skipped += 1
   636	            continue
   637	        # Skill-less by design: general-purpose archetype dispatches
   638	        # (mitigated rail per ADR-082) AND built-in subagent types like
   639	        # Explore/Plan/claude-code-guide that have no .claude/agents/<name>.md
   640	        # and so cannot carry a `Loads <skill> skill via reference` phrase
   641	        # (drift-detector contract per S143 lesson). Adding them to
   642	        # _ARCHETYPE_TO_SKILL would violate the contract — exclude here instead.
   643	        # S200: claude/claude-code-guide/statusline-setup are first-party
   644	        # Claude Code built-ins (no .claude/agents anchor); counting them as a
   645	        # governance gap is a false positive — exactly the FP class this filter
   646	        # exists to prevent (else healthy claude-code-guide use trains the
   647	        # operator to ignore the channel).
   648	        _SKILL_LESS_BUILTINS = {
   649	            "general-purpose", "Explore", "Plan",
   650	            "claude", "claude-code-guide", "statusline-setup",
   651	        }
   652	        if (
   653	            ev.get("subagent_type") in _SKILL_LESS_BUILTINS
   654	            and ev.get("archetype") in _SKILL_LESS_BUILTINS
   655	        ):
   656	            skill_less_by_design += 1
   657	            continue
   658	        total += 1
   659	        if ev.get("skill") in (None, "unknown", ""):
   660	            unknown += 1
   661	    if total == 0:
   662	        msg = (
   663	            "no custom-archetype spawns "
   664	            "({s} general-purpose, {g} ghosts, {p} harness-probes, "
   665	            "{t} test-pollution)".format(
   666	                s=skill_less_by_design, g=ghosts_skipped,
   667	                p=harness_probes_skipped, t=test_pollution_skipped,
   668	            )
   669	        )
   670	        return "green", msg, {
   671	            "unknown": 0, "total": 0,
   672	            "ghosts_skipped": ghosts_skipped,
   673	            "harness_probes_skipped": harness_probes_skipped,
   674	            "skill_less_by_design": skill_less_by_design,
   675	            "test_pollution_skipped": test_pollution_skipped,
   676	        }
   677	    ratio = unknown / total
   678	    status = "red" if ratio > 0.10 else "yellow" if ratio > 0 else "green"
   679	    return status, f"{unknown}/{total} = {ratio:.0%}", {
   680	        "unknown": unknown, "total": total,
   681	        "ghosts_skipped": ghosts_skipped,
   682	        "harness_probes_skipped": harness_probes_skipped,
   683	        "skill_less_by_design": skill_less_by_design,
   684	        "test_pollution_skipped": test_pollution_skipped,
   685	    }
