2:     2	# uninstall.sh — manifest-honoring uninstaller for ceo-orchestration
3-     3	# (PLAN-083 sub-1.9)
4-     4	#
5-     5	# Safety property: ONLY removes files whose current sha256 matches the
6:     6	# recorded manifest entry. Files modified by the user post-install have
7:     7	# divergent SHAs and are PRESERVED. Files NOT listed in the manifest
8-     8	# (Owner-authored, never installed by us) are also PRESERVED.
9-     9	#
10-    10	# Usage:
--
15-    15	#   --restore <backup-path>    Inverse mode: restore .claude/ from a backup .tar.gz
16-    16	#   --force                    Remove files even if SHA mismatches (DESTRUCTIVE)
17-    17	#   --no-backup                Skip the pre-uninstall backup tarball
18:    18	#   --no-hmac-verify           Skip HMAC verification of the manifest sidecar
19-    19	#   -h, --help                 Show this help
20-    20	#
21-    21	# Exit codes:
22-    22	#   0  success (or dry-run preview)
23-    23	#   1  generic failure / invalid args
24:    24	#   2  target path invalid OR no manifest found
25:    25	#   3  HMAC verification failed (manifest tampered)
26-    26	#   4  --restore: backup tar.gz invalid or HMAC mismatch
27-    27	#   5  --force not provided when SHA mismatches encountered
28-    28	#
--
