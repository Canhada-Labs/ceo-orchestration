   855	  # cannot match a same-named path deeper in an adopter tree.
   856	  printf '%s\n' \
   857	    "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9)." \
   858	    "#" \
   859	    "# Per-machine posture + runtime state that must never reach VCS:" \
   860	    "#   state/             runtime state as a whole (PLAN-163 T3.1)" \
   861	    "#   settings.local.json  permission overlay deciding the NEXT session's" \
   862	    "#                        posture (PLAN-165)" \
   863	    "#" \
   864	    "# The root .gitignore carries the same exclusions for adopters who track" \
   865	    "# this tree from the repository root. This file additionally covers the" \
   866	    "# --ceremony user install, which never writes outside .claude/ and so" \
   867	    "# never received them." \
   868	    "#" \
   869	    "# Adopter-owned once created: install and upgrade create it only when it" \
   870	    "# is absent, and NEVER rewrite it." \
   871	    "/state/" \
   872	    "/settings.local.json"
   873	}
   874	
   875	_apply_claude_dir_gitignore() {
   876	  # $1 = the adopter .claude directory.
   877	  # Create when absent; when PRESENT, append only the entries that are
   878	  # missing, per line, preserving every adopter byte (re-pass rc.4 t1
   879	  # P1-b: an adopter with a pre-existing .claude/.gitignore -- e.g.
   880	  # /cache/ only -- never received /state/ nor /settings.local.json,
   881	  # so night-mode state stayed commit-eligible under --ceremony user;
   882	  # create-if-missing alone proved the clean-target case only). Same
   883	  # grep -Fxq per-entry predicate as the root blocks: the file stays
   884	  # adopter-owned, nothing is rewritten, a deliberate edit to OUR
   885	  # comment lines is never repaired.
   886	  _cdg_dir="$1"
   887	  _cdg_file="$_cdg_dir/.gitignore"
   888	  # Re-pass rc.4 t2 (P1): NEVER follow a symlink here. A .claude/.gitignore
   889	  # symlinked to another writable file would receive framework appends at
   890	  # the EXTERNAL target; a dangling symlink passes `[ ! -e ]` and the
   891	  # redirect would CREATE its target. -L catches both, before any read.
   892	  if [ -L "$_cdg_file" ]; then
   893	    echo "    ERROR: .claude/.gitignore is a symlink — refusing to read or write through it (preserve/replace it manually)" >&2
   894	    return 1
   895	  fi
   896	  if [ ! -e "$_cdg_file" ]; then
   897	    [ -d "$_cdg_dir" ] || mkdir -p "$_cdg_dir"
   898	    _claude_dir_gitignore_body > "$_cdg_file"
   899	    echo "    CREATED: .claude/.gitignore"
   900	    return 0
   901	  fi
   902	  if [ ! -f "$_cdg_file" ]; then
   903	    echo "    ERROR: .claude/.gitignore exists but is not a regular file" >&2
   904	    return 1
   905	  fi
   906	  _cdg_added=0
   907	  for _cdg_entry in "/state/" "/settings.local.json"; do
   908	    if grep -Fxq "$_cdg_entry" "$_cdg_file"; then
   909	      continue
   910	    fi
   911	    {
   912	      echo ""
   913	      echo "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9): per-machine"
   914	      echo "# posture/runtime state (never commit)."
   915	      printf '%s\n' "$_cdg_entry"
   916	    } >> "$_cdg_file"
   917	    _cdg_added=1
   918	  done
   919	  if [ "$_cdg_added" = "1" ]; then
   920	    echo "    APPENDED: missing posture entries into existing .claude/.gitignore"
   921	  else
   922	    echo "    EXISTS: .claude/.gitignore already carries both entries"
   923	  fi
   924	  return 0
   925	}
   926	
   927	_preview_claude_dir_gitignore() {
   928	  # Dry-run twin of _apply_claude_dir_gitignore (re-pass rc.4 t2 P1):
   929	  # SAME per-entry predicate, ZERO writes. Reports the action the real
   930	  # run would take — including would-APPEND on a seeded adopter file.
   931	  _pcg_file="$1/.gitignore"
   932	  if [ -L "$_pcg_file" ]; then
   933	    echo "    (dry-run) ERROR: .claude/.gitignore is a symlink — real run would REFUSE" >&2
   934	    return 1
   935	  fi
   936	  if [ ! -e "$_pcg_file" ]; then
   937	    echo "    (dry-run) would CREATE: .claude/.gitignore"
   938	    return 0
   939	  fi
   940	  if [ ! -f "$_pcg_file" ]; then
   941	    echo "    (dry-run) ERROR: .claude/.gitignore exists but is not a regular file" >&2
   942	    return 1
   943	  fi
   944	  _pcg_missing=""
   945	  for _pcg_entry in "/state/" "/settings.local.json"; do
   946	    grep -Fxq "$_pcg_entry" "$_pcg_file" || _pcg_missing="$_pcg_missing $_pcg_entry"
   947	  done
   948	  if [ -n "$_pcg_missing" ]; then
   949	    echo "    (dry-run) would APPEND into existing .claude/.gitignore:$_pcg_missing"
   950	  else
   951	    echo "    (dry-run) EXISTS: .claude/.gitignore already carries both entries (would PRESERVE)"
   952	  fi
   953	  return 0
   954	}
