        # Codex S82 P0 #1 fix: was 0.5s (insufficient for governance_validate ~1.78s);
        # now 1.0 default + per-check overrides dict for slower subprocess-bound checks.
        self.assertEqual(_mod.PER_CHECK_TIMEOUT_S, 1.0)

