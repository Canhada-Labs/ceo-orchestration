   369	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   370	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   371	    verdict_abs = os.path.join(repo, verdict_rel)
   372	    if not os.path.isfile(verdict_abs):
   373	        return _fail(
   374	            E_VERDICT,
   375	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   376	            "be committed before the tag is cut (release.yml validates it per "
   377	            "tag on the tagged tree)." % verdict_rel,
   378	        )
   379	    with open(verdict_abs, encoding="utf-8") as fh:
