  1389	def test_npm_docs_carry_no_bare_version_literal(tmp_path):
  1390	    """P1-2. `npm/INTEGRITY.md` declared its own version and drifted three
  1391	    minors behind `VERSION` while `bump --stable` correctly reported a no-op:
  1392	    the file is not a bump site and — until this commit — not a scanned
  1393	    surface either. The cure is version-NEUTRAL prose, not a new writer row
  1394	    (a writer with no oracle is the dead rule `_release_bump_sites.py`
  1395	    already refuses to reintroduce)."""
  1396	    assert NPM_DOC_SURFACES, "no npm doc is scanned — the P1-2 surface is unwatched"
  1397	
  1398	    # Positive control FIRST, in a throwaway tree, and planted in the SAME
  1399	    # relative paths the real scan uses: this proves the SURFACE is covered,
  1400	    # not merely that the regex can match a version somewhere. The stamped
  1401	    # file rides along because an over-firing control gets exempted away
  1402	    # within a release.
  1403	    for rel in NPM_DOC_SURFACES:
  1404	        target = tmp_path / rel
  1405	        target.parent.mkdir(parents=True, exist_ok=True)
  1406	        target.write_text(
  1407	            "> built and versioned (`VERSION` / `package.json`, "
  1408	            "currently 1.0.1).\n"
  1409	            "<!-- last-reviewed: 2026-08-05 v1.3.0 -->\n",
  1410	            encoding="utf-8",
  1411	        )
  1412	    planted = _bare_version_offenders_in_npm_docs(tmp_path)
  1413	    assert len(planted) == len(NPM_DOC_SURFACES), (
  1414	        "positive control did not flag every scanned npm doc exactly once "
  1415	        "(stamp line must stay exempt): %s" % planted
  1416	    )
  1417	    for rel in NPM_DOC_SURFACES:
  1418	        assert any(o.startswith(rel + ":") for o in planted), (
  1419	            "%s is in SCAN_ROOTS but the planted literal there was not "
  1420	            "reported: %s" % (rel, planted)
  1421	        )
  1422	
  1423	    offenders = _bare_version_offenders_in_npm_docs(REPO_ROOT)
  1424	    assert not offenders, (
  1425	        "bare version literal in an npm doc (VERSION is the only authority; "
  1426	        "make the prose version-neutral):\n%s" % "\n".join(offenders)
  1427	    )
