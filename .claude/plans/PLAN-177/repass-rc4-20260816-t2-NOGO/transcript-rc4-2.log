   557	
   558	def _is_harness_probe_event(ev: Dict[str, Any]) -> bool:
   559	    """True iff the agent_spawn row is a harness-internal tool-loading probe.
   560	
   561	    S303: the ghost filter above was written for the ToolSearch probes of an
   562	    older harness, whose Agent-shaped PostToolUse rows carried NO description
   563	    (desc_preview == "" and desc_hash == SHA256(b"")). The current harness
   564	    supplies a human-readable description for the same class of call — e.g.
   565	    ``Load WebFetch via ToolSearch?`` with prompt ``noop`` and a fixed cheap
   566	    model — so all four ghost conditions no longer hold and a pure
   567	    tool-materialization probe lands in the denominator as a governance gap.
   568	
   569	    The discriminator is ``subagent_type``: the Agent/Task spawn contract makes
   570	    it REQUIRED for every governed dispatch (``check_agent_spawn.py`` derives
   571	    the authoritative archetype from it, and ``extract_skill`` Path D needs it),
   572	    so a row that carries none was never a CEO dispatch. All five conditions
   573	    must hold — no subagent_type, no archetype, no rail attribution, no
   574	    ``## AGENT PROFILE`` and no ``## FILE ASSIGNMENT`` — so a real named spawn
   575	    that merely lost one field still counts. Skipped rows stay OBSERVABLE via
   576	    the ``harness_probes_skipped`` counter: this suppresses a false alarm, it
   577	    does not hide the event.
   578	
   579	    PLAN-177 t2 (P1-f): those five are NECESSARY, NOT SUFFICIENT. Absence is
   580	    exactly the shape of the event this ratio exists to expose — a markerless
   581	    REAL spawn, including one admitted because the PreToolUse hook failed
   582	    open, matched all five and was deleted from the denominator. The row must
   583	    ALSO carry the closed harness signature
   584	    (``_has_harness_probe_fingerprint``); an unrecognised description counts,
   585	    however markerless the row is.
   586	    """
   587	    return (
   588	        not ev.get("subagent_type")
   589	        and not ev.get("archetype")
   590	        and ev.get("rail") is None
   591	        and ev.get("has_profile") is False
   592	        and ev.get("has_file_assignment") is False
   593	        and _has_harness_probe_fingerprint(ev)
   594	    )
