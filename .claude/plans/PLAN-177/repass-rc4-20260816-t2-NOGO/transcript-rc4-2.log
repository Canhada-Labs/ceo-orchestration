   714	    p_anc = sub.add_parser("ancestry", help="HEAD must be on origin/<branch>")
   715	    p_anc.add_argument("--repo", default=".")
   716	    p_anc.add_argument("--remote", default="origin")
   717	    p_anc.add_argument("--branch", default="main")
   718	    p_anc.add_argument(
   719	        "--offline-ack",
   720	        action="store_true",
   721	        help="named escape hatch: skip the fetch and judge against the "
   722	        "last-known remote ref (loudly announced)",
   723	    )
   724	
   725	    p_delta = sub.add_parser("delta", help="restricted delta vs the verdict")
   726	    p_delta.add_argument("--repo", default=".")
   727	    p_delta.add_argument("--tag", required=True)
   728	    p_delta.add_argument("--verdict", default=None)
   729	
   730	    args = parser.parse_args(argv)
   731	    if args.cmd == "ancestry":
   732	        return ancestry(args.repo, args.remote, args.branch, args.offline_ack)
   733	    if args.cmd == "delta":
   734	        return delta(args.repo, args.tag, args.verdict)
   735	    parser.print_usage(sys.stderr)
   736	    return E_USAGE
