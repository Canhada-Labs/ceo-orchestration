  1998	# --------------------------------------------------------------------------
  1999	# The npm signature recipe has to audit the thing the reader just installed
  2000	#
  2001	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2002	# no package-selecting positional (a trailing package name is ignored), and it
  2003	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2004	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2005	# with `npm audit signatures` verified nothing the reader had just installed —
  2006	# it audited whatever directory they happened to be standing in, and could
  2007	# return a confident green having examined a different tree entirely.
  2008	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2009	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2010	# project install followed by a BARE `npm audit signatures`.
  2011	# --------------------------------------------------------------------------
  2012	
  2013	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2014	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2015	# (ephemeral — nothing is left in a dependency tree to audit).
  2016	_UNAUDITABLE_INSTALL = re.compile(
  2017	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2018	)
  2019	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2020	# the reader believes it selected a package. `#` is excluded so the honest
  2021	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2022	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2023	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2024	_AUDIT_GLOBAL_FLAG = re.compile(
  2025	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2026	)
  2027	
  2028	
  2029	def _recipe_units(text: str) -> List[tuple]:
  2030	    """(label, body) for each fenced code block, and for each line outside one.
  2031	
  2032	    A recipe is what a reader copies, and they copy a whole code block — so the
  2033	    block, not the line, is the unit in which "install here, audit there" has
  2034	    to be judged. Prose lines are units of their own so a one-line table row
  2035	    (the shape `SUPPORT.md` used) is still examined."""
  2036	    units: List[tuple] = []
  2037	    block: Optional[List] = None
  2038	    for num, line in enumerate(text.splitlines(), 1):
  2039	        if line.strip().startswith("```"):
  2040	            if block is None:
  2041	                block = [num, []]
  2042	            else:
  2043	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2044	                block = None
  2045	            continue
  2046	        if block is not None:
  2047	            block[1].append(line)
  2048	        else:
  2049	            units.append(("line@%d" % num, line))
  2050	    if block is not None:  # unterminated fence: judge what we collected
  2051	        units.append(("block@%d" % block[0], "\n".join(block[1])))
  2052	    return units
  2053	
  2054	
  2055	def test_documented_npm_signature_recipe_matches_what_npm_audits():
  2056	    """Every documented `npm audit signatures` has to be reachable by npm.
  2057	
  2058	    A recipe offends when its unit pairs the command with an install npm cannot
  2059	    audit, passes a positional npm ignores, or passes `--global`, which npm
  2060	    rejects. Naming `EAUDITGLOBAL` in the unit is the tolerance: a document is
  2061	    free — and encouraged — to put the global install next to the command in
  2062	    order to say that the command does NOT reach it."""
  2063	    offenders: List[str] = []
  2064	    units_examined = 0
  2065	    for path in _live_doc_surfaces():
  2066	        rel = path.relative_to(REPO_ROOT).as_posix()
  2067	        text = path.read_text(encoding="utf-8")
  2068	        if not _AUDIT_SIGNATURES.search(text):
  2069	            continue
  2070	        for label, unit in _recipe_units(text):
  2071	            if not _AUDIT_SIGNATURES.search(unit):
  2072	                continue
  2073	            units_examined += 1
  2074	            faults = []
  2075	            if _UNAUDITABLE_INSTALL.search(unit) and "EAUDITGLOBAL" not in unit:
  2076	                faults.append(
  2077	                    "pairs the audit with an install npm cannot audit "
  2078	                    "(global, or exec/npx leaving no dependency behind)"
  2079	                )
  2080	            positional = _AUDIT_POSITIONAL.search(unit)
  2081	            if positional:
  2082	                faults.append(
  2083	                    "passes the positional %r, which npm ignores — the audit "
  2084	                    "still reads the current project" % positional.group(1)
  2085	                )
  2086	            if _AUDIT_GLOBAL_FLAG.search(unit):
  2087	                faults.append("passes --global, which npm rejects (EAUDITGLOBAL)")
  2088	            if faults:
  2089	                offenders.append(
  2090	                    "%s %s: %s\n    %s"
  2091	                    % (rel, label, "; ".join(faults), unit.strip()[:160])
  2092	                )
  2093	
  2094	    # Vacuity guard: the sweep is worthless if it found no recipe to judge.
  2095	    assert units_examined >= 5, (
  2096	        "only %d recipe units examined — the sweep lost sight of the docs it "
  2097	        "exists to watch" % units_examined
  2098	    )
  2099	    assert not offenders, (
  2100	        "documented `npm audit signatures` recipes do not audit what the "
  2101	        "reader installed:\n%s" % "\n\n".join(offenders)
  2102	    )
