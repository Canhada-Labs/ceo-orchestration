   198	# (b) restricted delta
   199	# ---------------------------------------------------------------------------
   200	def _parse_verdict(text: str) -> Dict[str, object]:
   201	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   202	
   203	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   204	    of `  - item` list entries, and ignores everything else. Anything it cannot
   205	    read is absent, and every consumer below treats absent as fail-closed.
   206	
   207	    Parity with the step-15 reader (`.github/scripts/
   208	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   209	    scope: block selection (the regex below is the validator's own — the
   210	    first ```yaml fence, not the first fence of any language) and inline
   211	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   212	    parse_verdict_file reads key:value and sub-dicts and would drop
   213	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   214	    ONE shared reader (this file is the declared reference), never grow a
   215	    third parser of the same signed file.
   216	    """
   217	    fields: Dict[str, object] = {}
   218	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   219	    if block is None:
   220	        # No yaml block -> no fields -> every consumer below fails closed.
   221	        return fields
   222	    cur_list: Optional[str] = None
   223	    for raw in block.group(1).splitlines():
   224	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   225	        if not line.strip():
   226	            continue
   227	        if line.startswith(("  - ", "- ")) and cur_list:
   228	            item = line.split("-", 1)[1].strip()
   229	            if item:
   230	                fields[cur_list].append(item)  # type: ignore[union-attr]
   231	            continue
   232	        m = re.match(r"\A([A-Za-z0-9_]+):\s*(.*)\Z", line)
   233	        if not m:
   234	            continue
   235	        key, val = m.group(1), m.group(2).strip()
   236	        if val == "":
   237	            fields[key] = []
   238	            cur_list = key
   239	        else:
   240	            fields[key] = val
   240	            fields[key] = val
   241	            cur_list = None
   242	    return fields
   243	
   244	
   245	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   246	# The two readers of this signed file disagreed about what a key IS: the
   247	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   248	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   249	# file demand the colon immediately after the name, so they skipped the line.
   250	# The valid-YAML pair
   251	#
   252	#     verdict : NO-GO
   253	#     verdict: GO
   254	#
   255	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   256	# and this is the rail that enforces in every mode, so the tag was authorised.
   257	#
   258	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   259	# fail-closed. Trimming the key in both readers would also close the
   260	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   261	# author writes and no template emits; refusing the shape is the smaller
   262	# surface and is the only behaviour that cannot silently prefer a value.
   263	# A top-level line is canonical iff it is `name:` with no whitespace before
   264	# the colon, or a `- ` list item.
   265	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:")
   266	
   267	
   268	def _noncanonical_top_level_lines(text: str) -> List[str]:
   269	    """Top-level lines of the yaml block that are not canonical declarations.
   270	
   271	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   272	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   273	    separate machines; neither may import the other — keep them identical).
   274	    Empty list == the block speaks the grammar both readers assume.
   275	    """
   276	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   277	    if block is None:
   278	        return []
   279	    bad: List[str] = []
   280	    for raw in block.group(1).splitlines():
   281	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   282	        if not line.strip():
   283	            continue
   284	        if line[0] in (" ", "\t"):  # sub-level: not a top-level declaration
   285	            continue
   286	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   287	            continue
   288	        if line.startswith("- "):  # top-level list item
   289	            continue
   290	        bad.append(line)
   291	    return bad
   292	
   293	
   294	def _count_top_level_key(text: str, key: str) -> int:
   295	    """How many times `key:` is declared at the top level of the block.
   296	
   297	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   298	    step-15 reader: a second `verdict:` silently overrides the first, so
   299	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   300	    block selection and same comment rule as the reader, or the count
   301	    would be about a different text than the parse.
   302	
   303	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   304	    counter does NOT strip the key and the step-15 twin does, so on a
   305	    non-canonical block the two counts differ. delta() checks the shape
   306	    first.
   307	    """
   308	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   309	    if block is None:
   310	        return 0
   311	    seen = 0
   312	    for raw in block.group(1).splitlines():
   313	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   314	        if not line.strip() or line[0] in (" ", "\t"):
   315	            continue
   316	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   317	        if m and m.group(1) == key:
   318	            seen += 1
   319	    return seen
