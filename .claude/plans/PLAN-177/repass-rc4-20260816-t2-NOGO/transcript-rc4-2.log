  1735	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1736	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1737	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1738	#     at the table rather than enumerating mechanisms, and the tag-signing
  1739	#     paragraph cites SECURITY.md as the authority instead of restating the
  1740	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1741	#     needs no exemption, so it has none.
  1742	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1743	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1744	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1745	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1746	#     are the file speaking about what the pipeline does.
  1747	#     A broad list that has to be switched off is worth less than a narrow
  1748	#     one that stays on.
  1749	#
  1750	# Matching is on word boundaries after normalization. Substring matching was
  1751	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1752	# substring-vs-exact class, for the fourth time in this plan.
  1753	_ENFORCEMENT_VOCAB = (
  1754	    "enforced today",
  1755	    "is enforced",
  1756	    "are enforced",
  1757	    "enforced by",
  1758	    "enforced at",
  1759	    "every tag publish",
  1760	    "recorded by",
  1761	    "is verified",
  1762	    "are verified",
  1763	    "verifies",
  1764	    "must satisfy",
  1765	    "guarantees",
  1766	    "is guaranteed",
  1767	    "are guaranteed",
  1768	    "asserted by",
  1769	    "checked by",
  1770	    "gated by",
  1771	    "fails closed",
  1772	    "fail closes",
  1773	    "asserts",
  1774	    "ensures",
  1775	    "is signed",
  1776	    "are signed",
  1777	)
  1778	
  1779	
  1780	def _normalize_prose(text: str) -> str:
  1781	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1782	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1783	    normalize the same way, so a claim cannot hide behind formatting."""
  1784	    text = text.lower()
  1785	    for ch in ("*", "`", "_"):
  1786	        text = text.replace(ch, "")
  1787	    text = text.replace("-", " ")
  1788	    return re.sub(r"\s+", " ", text)
  1789	
  1790	
  1791	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1792	    """Everything that is neither a Contract table row nor §Not yet
  1793	    automated — the surfaces where a mechanism claim answers to nothing."""
  1794	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1795	    return "\n".join(
  1796	        line for line in body.splitlines() if not line.strip().startswith("|")
  1797	    )
  1798	
  1799	
  1800	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1801	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1802	    offenders = []
  1803	    for phrase in _ENFORCEMENT_VOCAB:
  1804	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1805	            offenders.append(
  1806	                "%r outside the declared zones: ...%s..."
  1807	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1808	            )
  1809	    return offenders
