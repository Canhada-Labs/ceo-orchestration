  1527	def test_integrity_contract_rows_name_a_live_step():
  1528	    """P1-3. The contract claimed a per-tarball SHA-256 manifest was
  1529	    "enforced today" and pointed at `validate.yml (to-add)`: a guarantee whose
  1530	    alleged gate could not fail because it did not exist. A row now declares a
  1531	    Status from a closed set, and an `enforced` one must name a step that is
  1532	    really in the YAML."""
  1533	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1534	    rows = _contract_rows(doc)
  1535	    assert len(rows) >= 5, "Contract table parsed as %d rows" % len(rows)
  1536	
  1537	    pairs = _integrity_enforced_pairs(doc)
  1538	    assert len(pairs) >= _MIN_ENFORCED_PAIRS, (
  1539	        "only %d enforced (workflow, step) claims parsed — below the floor of "
  1540	        "%d. Either the table stopped documenting enforcement, or its format "
  1541	        "changed and this gate is now checking nothing."
  1542	        % (len(pairs), _MIN_ENFORCED_PAIRS)
  1543	    )
  1544	
  1545	    # (a) a renamed step must go red. The fixture is DERIVED from the parsed
  1546	    # table, never a hand-typed row literal: an anchor typed here stops
  1547	    # matching the day that row is edited, and the control dies quietly.
  1548	    step = pairs[0][2]
  1549	    renamed = doc.replace('step "%s"' % step, 'step "%s renamed"' % step, 1)
  1550	    assert renamed != doc, "rename fixture did not patch the doc"
  1551	    renamed_offenders = _integrity_contract_offenders(renamed, REPO_ROOT)
  1552	    assert any("renamed" in o for o in renamed_offenders), (
  1553	        "control did not flag a row naming a nonexistent step: %s"
  1554	        % renamed_offenders
  1555	    )
  1556	
  1557	    # (b) a table with NO parseable step claim must go red on the COUNT, not
  1558	    # report zero offenders. That is the vacuity failure itself.
  1559	    stripped = doc.replace('step "', "step ")
  1560	    assert len(_integrity_enforced_pairs(stripped)) < _MIN_ENFORCED_PAIRS, (
  1561	        "a table with no parseable step claim still met the floor — the count "
  1562	        "check cannot detect vacuity"
  1563	    )
  1564	
  1565	    # (c) unknown Status vocabulary must go red, not be waved through.
  1566	    unknown = doc.replace("| enforced |", "| mostly enforced |", 1)
  1567	    assert unknown != doc, "status fixture did not patch the doc"
  1568	    assert any(
  1569	        "outside the closed set" in o
  1570	        for o in _integrity_contract_offenders(unknown, REPO_ROOT)
  1571	    ), "an unknown Status was accepted"
  1572	
  1573	    offenders = _integrity_contract_offenders(doc, REPO_ROOT)
  1574	    assert not offenders, "npm/INTEGRITY.md contract row without a live step:\n%s" % (
  1575	        "\n".join(offenders)
  1576	    )
