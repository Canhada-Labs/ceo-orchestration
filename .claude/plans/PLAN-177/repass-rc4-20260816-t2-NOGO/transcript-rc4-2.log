  1342	# PLAN-177 W0 — the npm/ surfaces: a version nobody watched (P1-2) and an
  1343	# "enforced today" guarantee with no step behind it (P1-3).
  1344	# ===========================================================================
  1345	
  1346	# The npm docs are DERIVED from SCAN_ROOTS, not re-typed: adding a third npm
  1347	# surface up there extends this rule too, and the two lists cannot drift.
  1348	# What stays out, and why the predicate is narrow ON PURPOSE:
  1349	#   * `npm/SHA256SUMS.txt` records tarball FILENAMES
  1350	#     (`ceo-orchestration-<version>.tgz`) — historical data about a build that
  1351	#     happened, not a claim about the current release. Flagging it would train
  1352	#     whoever hits the red to add an exemption, and an exemption is how a
  1353	#     control stops controlling.
  1354	#   * `npm/.npmignore` cites past packaging incidents by the version they
  1355	#     happened in — same category.
  1356	#   * `npm/package.json` is a real bump site with a real oracle
  1357	#     (`_release_bump_sites.py` + verify-counts); it is written, not stale.
  1358	# Prose in a shipped `.md` is the only one that can go stale silently, which
  1359	# is exactly what happened.
  1360	NPM_DOC_SURFACES = tuple(
  1361	    root for root in SCAN_ROOTS if root.startswith("npm/") and root.endswith(".md")
  1362	)
  1363	# The one legitimate version literal in an npm doc: the review stamp, itself a
  1364	# bump site (`("npm/README.md", STAMP, STAMP_RX)`), so it has an oracle.
  1365	_STAMP_LINE_RX = re.compile(r"last-reviewed:\s*\d{4}-\d{2}-\d{2}\s+v\d+\.\d+\.\d+")
  1366	
  1367	
  1368	def _bare_version_offenders_in_npm_docs(repo_root: Path) -> List[str]:
  1369	    """Bare `X.Y.Z` in a scanned npm doc, outside a review stamp. Takes the
  1370	    root as an ARGUMENT so the positive control can plant the defect in a tmp
  1371	    tree and never write into the repo under test."""
  1372	    offenders: List[str] = []
  1373	    for rel in NPM_DOC_SURFACES:
  1374	        path = repo_root / rel
  1375	        if not path.is_file():
  1376	            continue
  1377	        try:
  1378	            body = path.read_text(encoding="utf-8")
  1379	        except (UnicodeDecodeError, OSError):
  1380	            continue
  1381	        for num, line in enumerate(body.splitlines(), 1):
  1382	            if _STAMP_LINE_RX.search(line):
  1383	                continue
  1384	            for hit in SEMVER_RX.findall(line):
  1385	                offenders.append("%s:%d: %s (%s)" % (rel, num, line.strip(), hit))
  1386	    return offenders
