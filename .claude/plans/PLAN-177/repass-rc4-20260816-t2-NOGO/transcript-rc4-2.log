   597	def check_skill_unknown_ratio() -> Tuple[str, str, Any]:
   598	    """Detect spawns that should have SKILL injection but didn't.
   599	
   600	    S94 follow-up: excludes intentionally skill-less archetypes —
   601	    `general-purpose` subagent dispatches via the mitigated rail
   602	    (ADR-082) by design have no SKILL.md anchor. They broker cross-
   603	    LLM gate calls and similar utility work; counting them as FPs
   604	    inflates the ratio to 100% during healthy Codex MCP sessions
   605	    and trains the operator to ignore the channel.
   606	
   607	    A spawn counts as "skill missing" ONLY when its `archetype` is
   608	    a custom (non-general-purpose) one AND `skill` is unknown/empty.
   609	    That is the original PLAN-020 ADR-051 governance gap the
   610	    detector was built for.
   611	    """
   612	    total = 0
   613	    unknown = 0
   614	    ghosts_skipped = 0
   615	    harness_probes_skipped = 0
   616	    skill_less_by_design = 0
   617	    test_pollution_skipped = 0
   618	    for ev in _iter_audit_events_since(24):
   619	        if ev.get("action") != "agent_spawn":
   620	            continue
   621	        if _is_test_pollution_event(ev):
   622	            test_pollution_skipped += 1
   623	            continue
   624	        if _is_ghost_spawn_event(ev):
   625	            ghosts_skipped += 1
   626	            continue
   627	        if _is_harness_probe_event(ev):
   628	            harness_probes_skipped += 1
   629	            continue
   630	        # Skill-less by design: general-purpose archetype dispatches
   631	        # (mitigated rail per ADR-082) AND built-in subagent types like
   632	        # Explore/Plan/claude-code-guide that have no .claude/agents/<name>.md
   633	        # and so cannot carry a `Loads <skill> skill via reference` phrase
   634	        # (drift-detector contract per S143 lesson). Adding them to
   635	        # _ARCHETYPE_TO_SKILL would violate the contract — exclude here instead.
   636	        # S200: claude/claude-code-guide/statusline-setup are first-party
   637	        # Claude Code built-ins (no .claude/agents anchor); counting them as a
   638	        # governance gap is a false positive — exactly the FP class this filter
   639	        # exists to prevent (else healthy claude-code-guide use trains the
   640	        # operator to ignore the channel).
   641	        _SKILL_LESS_BUILTINS = {
   642	            "general-purpose", "Explore", "Plan",
   643	            "claude", "claude-code-guide", "statusline-setup",
   644	        }
   645	        if (
   646	            ev.get("subagent_type") in _SKILL_LESS_BUILTINS
   647	            and ev.get("archetype") in _SKILL_LESS_BUILTINS
   648	        ):
   649	            skill_less_by_design += 1
   650	            continue
   651	        total += 1
   652	        if ev.get("skill") in (None, "unknown", ""):
   653	            unknown += 1
   654	    if total == 0:
   655	        msg = (
   656	            "no custom-archetype spawns "
   657	            "({s} general-purpose, {g} ghosts, {p} harness-probes, "
   658	            "{t} test-pollution)".format(
   659	                s=skill_less_by_design, g=ghosts_skipped,
   660	                p=harness_probes_skipped, t=test_pollution_skipped,
   661	            )
   662	        )
   663	        return "green", msg, {
   664	            "unknown": 0, "total": 0,
   665	            "ghosts_skipped": ghosts_skipped,
   666	            "harness_probes_skipped": harness_probes_skipped,
   667	            "skill_less_by_design": skill_less_by_design,
   668	            "test_pollution_skipped": test_pollution_skipped,
   669	        }
   670	    ratio = unknown / total
   671	    status = "red" if ratio > 0.10 else "yellow" if ratio > 0 else "green"
   672	    return status, f"{unknown}/{total} = {ratio:.0%}", {
   673	        "unknown": unknown, "total": total,
   674	        "ghosts_skipped": ghosts_skipped,
   675	        "harness_probes_skipped": harness_probes_skipped,
   676	        "skill_less_by_design": skill_less_by_design,
   677	        "test_pollution_skipped": test_pollution_skipped,
   678	    }
