  2029	def _recipe_units(text: str) -> List[tuple]:
  2030	    """(label, body) for each fenced code block, and for each line outside one.
  2031	
  2032	    A recipe is what a reader copies, and they copy a whole code block — so the
  2033	    block, not the line, is the unit in which "install here, audit there" has
  2034	    to be judged. Prose lines are units of their own so a one-line table row
  2035	    (the shape `SUPPORT.md` used) is still examined."""
  2036	    units: List[tuple] = []
  2037	    block: Optional[List] = None
  2038	    for num, line in enumerate(text.splitlines(), 1):
  2039	        if line.strip().startswith("```"):
  2040	            if block is None:
  2041	                block = [num, []]
  2042	            else:
  2043	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2044	                block = None
  2045	            continue
  2046	        if block is not None:
  2047	            block[1].append(line)
  2048	        else:
  2049	            units.append(("line@%d" % num, line))
  2050	    if block is not None:  # unterminated fence: judge what we collected
  2051	        units.append(("block@%d" % block[0], "\n".join(block[1])))
  2052	    return units
  2053	
  2054	
  2055	def test_documented_npm_signature_recipe_matches_what_npm_audits():
