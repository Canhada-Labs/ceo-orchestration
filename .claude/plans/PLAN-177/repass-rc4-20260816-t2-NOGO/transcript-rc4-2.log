   165	# -------------------------------- npm pack -----------------------------------
   166	echo "==> Building tarball"
   167	TARBALL="$(cd "$NPM_DIR" && npm pack 2>/dev/null | tail -1)"
   168	TARBALL_PATH="$NPM_DIR/$TARBALL"
   169	
   170	if [[ ! -f "$TARBALL_PATH" ]]; then
   171	  echo "::error::npm pack did not produce $TARBALL_PATH" >&2
   172	  exit 1
   173	fi
   174	TARBALL_SIZE_KB=$(( $(wc -c < "$TARBALL_PATH") / 1024 ))
   175	echo "OK: tarball built — $TARBALL ($TARBALL_SIZE_KB KB)"
   176	
   177	# -------------------------------- sha256 emission ----------------------------
   178	# PLAN-019 DevOps-P2-3 — LOCAL build-integrity record.
   179	#
   180	# Emit the sha256 of the tarball just built, next to it, in
   181	# NPM_DIR/SHA256SUMS.txt (one line per tarball NAME, replaced in place on a
   182	# rebuild) and in the per-tarball sidecar `<tarball>.sha256` written further
   183	# down. Both use the `<64-hex>  <filename>` form checksum tools consume.
   184	#
   185	# Which of the two a maintainer can actually CHECK differs, so say it here
   186	# rather than leave the reader to find out: the SIDECAR verifies (it names one
   187	# file, and that file was just built). The cumulative manifest does NOT verify
   188	# as a whole — it keeps lines for tarballs of OTHER versions, `npm/*.tgz` is
   189	# git-ignored so a fresh clone has none of them on disk, and a bulk check
   190	# therefore exits non-zero on "No such file or directory" for every line but
   191	# the current one. Measured, not assumed (PLAN-177 W1). Compare the single
   192	# line for the tarball you just built, or check the sidecar.
   193	#
   194	# SCOPE — what this is NOT (PLAN-177 P1-3). Two claims used to live here and
   195	# both were false; the honest model in SECURITY.md:79-81 is the one to follow.
   196	#
   197	#   1. "CI verification (npm-publish.yml) computes the checksum of the tarball
   198	#      it publishes and appends to the release notes." It does not. That
   199	#      workflow never materialises a .tgz (its `npm pack --dry-run` writes
   200	#      nothing) and appends nothing to any release notes. The one sha256 it
   201	#      does compute is over the install.sh BODY, for the
   202	#      `# CEO-INSTALL-SHA256:` trailer — a different artifact entirely.
   203	#
   204	#   2. A consumer recipe that fetched this manifest over the network:
   205	#        curl -LO https://registry.npmjs.org/.../tarball
   206	#        curl -LO https://.../SHA256SUMS.txt
   207	#      There is no such URL. SHA256SUMS.txt is not in package.json `files`, so
   208	#      it does not travel in the published tarball, and no workflow attaches it
   209	#      to a GitHub release. A consumer who wants to verify a published tarball
   210	#      should use npm's own integrity metadata (`npm view <pkg> dist.integrity`)
   211	#      until a per-tarball manifest is actually published.
   212	#
   213	# Publishing a real per-tarball manifest is a change to the publish path and is
   214	# deferred to the v1.4.0 train (PLAN-177 §Escopo — route (i), excluded from
   215	# rc.4 on purpose). Until then this file records LOCAL builds only.
   216	#
   217	# Stdlib-only: prefer `sha256sum` (Linux / Ubuntu runners) then fall back
   218	# to `shasum -a 256` (macOS). python3 -m hashlib as last-resort fallback.
   219	SHA_MANIFEST="$NPM_DIR/SHA256SUMS.txt"
   220	if command -v sha256sum >/dev/null 2>&1; then
   221	  HASH_LINE=$(cd "$NPM_DIR" && sha256sum "$TARBALL")
   222	elif command -v shasum >/dev/null 2>&1; then
   223	  HASH_LINE=$(cd "$NPM_DIR" && shasum -a 256 "$TARBALL")
   224	else
   225	  HASH_HEX=$(python3 -c "
   226	import hashlib, sys
   227	h = hashlib.sha256()
   228	with open(sys.argv[1], 'rb') as f:
   229	    for chunk in iter(lambda: f.read(65536), b''):
   230	        h.update(chunk)
   231	print(h.hexdigest())
   232	" "$TARBALL_PATH")
   233	  HASH_LINE="${HASH_HEX}  ${TARBALL}"
   234	fi
   235	
   236	# Normalise output to exactly two spaces between hash + filename (sha256sum
   237	# -c strict format), strip any extra whitespace introduced by BSD shasum.
   238	HASH_HEX="${HASH_LINE%% *}"
   239	HASH_LINE="${HASH_HEX}  ${TARBALL}"
   240	
   241	# Dedup-or-append (PLAN-023 Phase A F-comp-002 follow-up): replace any
   242	# existing line for the same filename in-place, else append. Prevents
   243	# SHA256SUMS.txt from accumulating stale entries across local rebuilds
   244	# (previously observed: 51 stale entries before PLAN-025 Batch I reset).
   245	# Preserves header comment lines (starting with #) untouched.
