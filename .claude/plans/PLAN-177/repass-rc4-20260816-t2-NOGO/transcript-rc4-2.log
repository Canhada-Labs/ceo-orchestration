  1579	def test_integrity_unenforced_rows_are_restated_where_the_reader_looks():
  1580	    """The escape hatch a closed set alone leaves open: mark everything
  1581	    `deferred` and list it nowhere. Every non-enforced row must repeat its
  1582	    control name, verbatim and bold, under §Not yet automated — the section a
  1583	    reader actually reads."""
  1584	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1585	    section = re.search(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", doc)
  1586	    assert section, "npm/INTEGRITY.md has no §Not yet automated section"
  1587	    body = section.group(0)
