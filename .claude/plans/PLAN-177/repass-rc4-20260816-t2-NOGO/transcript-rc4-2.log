   854	_apply_claude_dir_gitignore() {
   855	  # $1 = the adopter .claude directory.
   856	  # Create when absent; when PRESENT, append only the entries that are
   857	  # missing, per line, preserving every adopter byte (re-pass rc.4 t1
   858	  # P1-b: an adopter with a pre-existing .claude/.gitignore -- e.g.
   859	  # /cache/ only -- never received /state/ nor /settings.local.json,
   860	  # so night-mode state stayed commit-eligible under --ceremony user;
   861	  # create-if-missing alone proved the clean-target case only). Same
   862	  # grep -Fxq per-entry predicate as the root blocks: the file stays
   863	  # adopter-owned, nothing is rewritten, a deliberate edit to OUR
   864	  # comment lines is never repaired.
   865	  _cdg_dir="$1"
   866	  _cdg_file="$_cdg_dir/.gitignore"
   867	  if [ ! -e "$_cdg_file" ]; then
   868	    [ -d "$_cdg_dir" ] || mkdir -p "$_cdg_dir"
   869	    _claude_dir_gitignore_body > "$_cdg_file"
   870	    echo "    CREATED: .claude/.gitignore"
   871	    return 0
   872	  fi
   873	  if [ ! -f "$_cdg_file" ]; then
   874	    echo "    ERROR: .claude/.gitignore exists but is not a regular file" >&2
   875	    return 1
   876	  fi
   877	  _cdg_added=0
   878	  for _cdg_entry in "/state/" "/settings.local.json"; do
   879	    if grep -Fxq "$_cdg_entry" "$_cdg_file"; then
   880	      continue
   881	    fi
   882	    {
   883	      echo ""
   884	      echo "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9): per-machine"
   885	      echo "# posture/runtime state (never commit)."
   886	      printf '%s\n' "$_cdg_entry"
   887	    } >> "$_cdg_file"
   888	    _cdg_added=1
   889	  done
   890	  if [ "$_cdg_added" = "1" ]; then
   891	    echo "    APPENDED: missing posture entries into existing .claude/.gitignore"
   892	  else
   893	    echo "    EXISTS: .claude/.gitignore already carries both entries"
   894	  fi
   895	  return 0
   896	}
