  1429	
  1430	INTEGRITY_DOC = REPO_ROOT / "npm" / "INTEGRITY.md"
  1431	# Closed set. A row whose Status is anything else is a red — fail-closed on
  1432	# unknown vocabulary, because the way this table decayed the first time was a
  1433	# cell that READ like enforcement ("(to-add)", "Release script (Sprint 17
  1434	# scope)") without ever being it.
  1435	_CONTRACT_STATUSES = ("enforced", "deferred", "operator")
  1436	# `<workflow>.yml` in backticks, then the step name in straight quotes. Both
  1437	# delimiters are load-bearing: they are what makes the claim parseable at all.
  1438	_ENFORCED_RX = re.compile(r'`([^`]+\.yml)`\s+step\s+"([^"]+)"')
  1439	# Without a floor, a parser that suddenly matches nothing reports zero
  1440	# offenders and the gate passes having checked NOTHING. Two is the smallest
  1441	# floor that also keeps a one-row table from satisfying it by accident.
  1442	_MIN_ENFORCED_PAIRS = 2
  1443	
  1444	
  1445	def _yaml_step_names(path: Path) -> List[str]:
  1446	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1447	    call site: a substring match would accept "Verify VERSION" for a step
  1448	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1449	    already cost this repo three incidents in one session."""
  1450	    text = path.read_text(encoding="utf-8")
  1451	    names = []
  1452	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1453	        name = m.group(1)
  1454	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1455	            name = name[1:-1]
  1456	        names.append(name)
  1457	    return names
  1458	
  1459	
  1460	def _contract_rows(doc_text: str) -> List[List[str]]:
  1461	    """The `## Contract` table as [control, mechanism, status, where]."""
  1462	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1463	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1464	    rows = []
  1465	    for line in m.group(0).splitlines():
  1466	        line = line.strip()
  1467	        if not line.startswith("|"):
  1468	            continue
  1469	        cells = [c.strip() for c in line.strip("|").split("|")]
  1470	        if len(cells) != 4:
  1471	            continue
  1472	        if cells[0] == "Control" or set(cells[0]) <= set("- :"):
  1473	            continue
  1474	        rows.append(cells)
  1475	    return rows
  1476	
  1477	
  1478	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1479	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1480	    Status are not read — a row that claims no enforcement makes no claim to
  1481	    check."""
  1482	    out: List[List[str]] = []
  1483	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1484	        if status != "enforced":
  1485	            continue
  1486	        for workflow, step in _ENFORCED_RX.findall(where):
  1487	            out.append([control, workflow, step])
  1488	    return out
  1489	
  1490	
  1491	def _integrity_contract_offenders(doc_text: str, repo_root: Path) -> List[str]:
  1492	    """Closed-set Status, plus: every `enforced` row names a workflow that
  1493	    exists and a step that exists in it, by exact equality."""
  1494	    offenders: List[str] = []
  1495	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1496	        if status not in _CONTRACT_STATUSES:
  1497	            offenders.append(
  1498	                "%s: Status %r is outside the closed set %s"
  1499	                % (control, status, list(_CONTRACT_STATUSES))
  1500	            )
  1501	            continue
  1502	        if status != "enforced":
  1503	            continue
  1504	        pairs = _ENFORCED_RX.findall(where)
  1505	        if not pairs:
  1506	            offenders.append(
  1507	                "%s: Status is enforced but `Where enforced` names no "
  1508	                "workflow+step in the parseable form — %r" % (control, where)
  1509	            )
  1510	            continue
  1511	        for workflow, step in pairs:
  1512	            wf = repo_root / workflow
  1513	            if not wf.is_file():
  1514	                offenders.append(
  1515	                    "%s: names workflow %s, which does not exist"
  1516	                    % (control, workflow)
  1517	                )
  1518	                continue
  1519	            if step not in _yaml_step_names(wf):
  1520	                offenders.append(
  1521	                    "%s: names step %r in %s, which has no such step"
  1522	                    % (control, step, workflow)
  1523	                )
  1524	    return offenders
  1525	
