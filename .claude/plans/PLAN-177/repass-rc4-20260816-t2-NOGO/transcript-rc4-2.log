  2363	# Cured semantics (identical in both files): non-canonical top-level syntax
  2364	# is REFUSED. So the duplicate variants are red for the SHAPE, and the single
  2365	# non-canonical key is red too -- an authorizing decision must be spelled the
  2366	# one way the template spells it.
  2367	_NONCANONICAL_DIAGNOSTIC = "non-canonical top-level key syntax"
  2368	_NONCANONICAL_DECISIONS = [
