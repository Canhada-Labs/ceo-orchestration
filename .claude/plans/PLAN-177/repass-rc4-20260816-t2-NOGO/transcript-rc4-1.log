  2353	
  2354	# PLAN-177 t2 (re-pass rc.4 P1-a) -- the GRAMMAR the two rails share.
  2355	#
  2356	# `verdict : NO-GO` is valid YAML and last-wins under a real parser. The
  2357	# server validator strips the key, so it counted TWO declarations; the local
  2358	# tag guard's regex required the colon immediately after the name, so it
  2359	# counted ONE and parsed GO -- and the local guard is the rail with no escape
  2360	# hatch. The first round of controls could not see this: every fixture line
  2361	# was built as `"verdict: %s"`, which can only produce canonical keys.
  2362	#
  2363	# Cured semantics (identical in both files): non-canonical top-level syntax
  2364	# is REFUSED. So the duplicate variants are red for the SHAPE, and the single
  2365	# non-canonical key is red too -- an authorizing decision must be spelled the
  2366	# one way the template spells it.
  2367	_NONCANONICAL_DIAGNOSTIC = "non-canonical top-level key syntax"
  2368	_NONCANONICAL_DECISIONS = [
  2369	    [("verdict ", "NO-GO"), "GO"],
  2370	    [("verdict\t", "NO-GO"), "GO"],
  2371	    [("verdict ", "GO")],
  2372	    [("verdict\t", "GO")],
  2373	]
  2374	_NONCANONICAL_IDS = [
  2375	    "space-before-colon-duplicate", "tab-before-colon-duplicate",
  2376	    "space-before-colon-alone", "tab-before-colon-alone",
  2377	]
  2378	
