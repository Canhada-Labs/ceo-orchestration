   357	        manifest_path = Path(td) / "codex-cli-pin-manifest.json"
   358	        if manifest_text is not None:
   359	            manifest_path.write_text(manifest_text, encoding="utf-8")
   360	        cmd = [
   361	            sys.executable, str(SCRIPT),
   362	            "--verdict-file", str(verdict_path),
   363	            "--codex-pin-manifest-file", str(manifest_path),
   364	            *args,
   365	        ]
   366	        return subprocess.run(cmd, capture_output=True, text=True, timeout=30)
