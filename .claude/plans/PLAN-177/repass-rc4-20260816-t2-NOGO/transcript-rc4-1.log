   330	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   331	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   332	    entries: List[Tuple[str, str]] = []
   333	    with open(path, encoding="utf-8") as fh:
   334	        for line in fh:
   335	            line = line.rstrip("\n")
   336	            if not line.strip():
   337	                continue
   338	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   339	            if not m:
   340	                raise ValueError("unparsable manifest line: %r" % line)
   341	            entries.append((m.group(1), m.group(2)))
   342	    return entries
   343	
