     1	"""test_validate_pair_rail_verdict.py — S104 PLAN-081 GA tail.
     2	
     3	Tests for the parent_sha / commit_sha bind redesign in
     4	.github/scripts/validate-pair-rail-verdict.py. The legacy
     5	`verdict.commit_sha` self-reference is replaced with `verdict.parent_sha`
     6	to break the chicken-and-egg problem the v1.16.0 GA ceremony hit
     7	(verdict file cannot declare its own commit SHA because the SHA is
     8	only known AFTER the verdict file is committed).
     9	
    10	Coverage:
    11	- --parent-sha match → exit 0
    12	- --parent-sha mismatch → exit VERDICT_INVALID (3)
    13	- --parent-sha against verdict with no parent_sha field, legacy
    14	  commit_sha present → ADVISORY (skip bind), exit 0 if rest valid
    15	- --parent-sha against verdict with no parent_sha + no commit_sha →
    16	  exit VERDICT_INVALID (3)
    17	- Legacy --commit-sha path still works on legacy verdicts (exit 0)
    18	- Legacy --commit-sha mismatch → exit VERDICT_INVALID (3)
    19	- --parent-sha takes precedence when both args passed
    20	
    21	ADR-182 payload pin (PLAN-163 T5.2 pin-pack):
    22	- --codex-pin-manifest-file + matching triple/sha envelope → exit 0
    23	- payload sha mismatch → VERDICT_INVALID (3)
    24	- targetTriple absent from manifest → VERDICT_INVALID (3)
    25	- envelope missing triple/sha fields → VERDICT_INVALID (3)
    26	- manifest file unreadable → infra (1)
    27	- comment-only tombstone as --codex-cli-binary-sha256-file → legacy
    28	  launcher pin skipped (exit 0)
    29	
    30	Stdlib only. Python ≥3.9. Run via pytest from repo root.
    31	"""
    32	
    33	from __future__ import annotations
    34	
    35	import subprocess
    36	import sys
    37	import tempfile
    38	import textwrap
    39	import unittest
    40	from pathlib import Path
    41	from typing import Sequence
    42	
    43	REPO_ROOT = Path(__file__).resolve().parents[3]
    44	SCRIPT = REPO_ROOT / ".github" / "scripts" / "validate-pair-rail-verdict.py"
    45	
    46	EXIT_OK = 0
    47	EXIT_INFRA_ERROR = 1
    48	EXIT_VERDICT_EXPIRED = 2
    49	EXIT_VERDICT_INVALID = 3
    50	
    51	
    52	def _make_verdict(
    53	    *,
    54	    decision_lines: Sequence[str] = ("verdict: GO",),
    55	    release_tag: str = "v1.99.0",
    56	    parent_sha: str = "",
    57	    commit_sha: str = "",
    58	    inputs_hash: str = "deadbeef" * 8,
    59	    generated_at: str = "9999-01-01T00:00:00Z",
    60	    ttl_hours: int = 87600,
    61	    tool_versions_block: str = (
    62	        "  codex_cli: 0.129.0\n"
    63	        "  codex_cli_binary_sha256: " + "a" * 64
    64	    ),
    65	    include_signature: bool = True,
    66	) -> str:
    67	    """Build a verdict markdown file with the requested envelope.
    68	
    69	    `decision_lines` are emitted VERBATIM (PLAN-177 t2 / P1-a): the grammar
    70	    divergence between this validator and the local tag guard can only be
    71	    expressed by writing the key spelling itself -- `verdict : NO-GO` is
    72	    valid YAML and was counted here but skipped there.
    73	    """
    74	    lines = [
    75	        "# Pair-Rail Verdict — test",
    76	        "",
    77	        "```yaml",
    78	        *decision_lines,
    79	        f"generated_at: {generated_at}",
    80	        f"ttl_hours: {ttl_hours}",
    81	        f"release_tag: {release_tag}",
    82	    ]
    83	    if parent_sha:
    84	        lines.append(f"parent_sha: {parent_sha}")
    85	    if commit_sha:
    86	        lines.append(f"commit_sha: {commit_sha}")
    87	    lines.append(f"inputs_hash: {inputs_hash}")
    88	    lines.append("tool_versions:")
    89	    lines.append(tool_versions_block)
    90	    if include_signature:
    91	        lines.append("gpg_signature: |")
    92	        lines.append("  -----BEGIN PGP SIGNATURE-----")
    93	        lines.append("  fake-sig-for-test")
    94	        lines.append("  -----END PGP SIGNATURE-----")
    95	    lines.append("```")
    96	    return "\n".join(lines) + "\n"
    97	
    98	
    99	def _run(args, verdict_text: str):
   100	    """Run validator on a tmpdir-scoped verdict file. Returns CompletedProcess."""
   101	    with tempfile.TemporaryDirectory() as td:
   102	        verdict_path = Path(td) / "verdict.md"
   103	        verdict_path.write_text(verdict_text, encoding="utf-8")
   104	        cmd = [
   105	            sys.executable, str(SCRIPT),
   106	            "--verdict-file", str(verdict_path),
   107	            *args,
   108	        ]
   109	        return subprocess.run(cmd, capture_output=True, text=True, timeout=30)
   110	
   111	
   112	class TestParentShaBind(unittest.TestCase):
   113	    """S104 redesign: --parent-sha is the canonical bind."""
   114	
   115	    PARENT = "abcdef0123456789abcdef0123456789abcdef01"
   116	
   117	    def test_parent_sha_match_passes_bind(self):
   118	        v = _make_verdict(parent_sha=self.PARENT, release_tag="v1.99.0")
   119	        r = _run(
   120	            [
   121	                "--parent-sha", self.PARENT,
   122	                "--release-tag", "v1.99.0",
   123	            ],
   124	            v,
   125	        )
   126	        # Bind passes; other checks may still pass too (no pin files
   127	        # requested → skipped). Expected exit 0.
   128	        self.assertEqual(r.returncode, EXIT_OK, msg=r.stderr)
   129	
   130	    def test_parent_sha_mismatch_returns_invalid(self):
