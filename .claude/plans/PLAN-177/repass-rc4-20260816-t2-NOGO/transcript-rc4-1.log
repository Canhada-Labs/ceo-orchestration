  2283	def _run_ci_validator(tmp_path, env, decisions: Sequence[str], bind_parent: bool):
  2284	    """Run the server-side validator with the LITERAL step-15 argv.
  2285	
  2286	    Source of the argv: .github/workflows/release.yml, job release-gate.
  2287	
  2288	    bind_parent=False is the --parent-sha "" shape of
  2289	    CEO_PAIR_RAIL_VERDICT_OPTIONAL=1. In THAT mode the step also carries
  2290	    continue-on-error, so this variant is a UNIT test of the validator, not a
  2291	    claim about the pipeline: what blocks a release in transition mode is
  2292	    _release_tag_guard.py delta (see the tag-guard controls below).
  2293	    """
  2294	    tag = "v0.0.0-plan177-decision-gate"
  2295	    parent = _repo_head()
  2296	    verdict_file = tmp_path / "pair-rail-verdict-fixture.md"
  2297	    _write_live_shaped_verdict(verdict_file, tag, decisions, parent)
  2298	    argv = [
  2299	        sys.executable, str(VALIDATOR_SRC),
  2300	        "--verdict-file", str(verdict_file),
  2301	        "--parent-sha", parent if bind_parent else "",
  2302	        "--release-tag", tag,
  2303	        "--max-age-hours", "24",
  2304	        "--recompute-inputs-hash",
  2305	        "--codex-cli-pin-file", ".claude/governance/codex-cli-pin.txt",
  2306	        "--codex-cli-binary-sha256-file",
  2307	        ".claude/governance/codex-cli-binary-sha256.txt",
  2308	        "--codex-pin-manifest-file",
  2309	        ".claude/governance/codex-cli-pin-manifest.json",
  2310	        "--inputs-hash-paths-file",
  2311	        ".claude/governance/pair-rail-inputs-hash-manifest.txt",
  2312	    ]
  2313	    return run(argv, REPO_ROOT, env)
