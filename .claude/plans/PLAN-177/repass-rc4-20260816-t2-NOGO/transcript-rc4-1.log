   590	
   591	# ---------------------------------------------------------------------------
   592	# Tag — annotated + GPG-signed INLINE. The tag message is the Owner-visible
   593	# artifact; pushing it starts release.yml AND npm-publish.yml.
   594	#
   595	# Two fail-closed guards run first, for RC and stable ALIKE. Scoping them to
   596	# `--stable` would let an rc.N ship a post-review commit and then become the
   597	# unreviewed baseline the GA is promoted from.
   598	#
   599	# THE LOCAL ASSERT IS NOT ENOUGH — say it out loud. A tag signed by hand skips
   600	# this driver entirely, and the pair-rail step 15 recomputes inputs_hash only
   601	# over `pair-rail-inputs-hash-manifest.txt`, which deliberately EXCLUDES the
   602	# bump surfaces (including them would make every legitimate bump change the
   603	# inputs_hash and break the verdict replay). The same restricted-delta assert
   604	# therefore goes SERVER-SIDE into `.github/workflows/release.yml` in PLAN-166
   605	# W1. release.yml is canonical: it changes under the GPG ceremony, not here.
   606	# `_release_tag_guard.py` is the reference implementation for both.
   607	# ---------------------------------------------------------------------------
   608	tag() {
   609	  hdr "sign tag $TARGET_TAG"
   610	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to tag"
   611	
   612	  # VERSION carries the BARE semver even for an RC tag (see the bump header),
   613	  # so compare against $TARGET_BASE, never $TARGET_VERSION.
   614	  cur_version="$(tr -d ' \n' < VERSION)"
   615	  [ "$cur_version" = "$TARGET_BASE" ] \
   616	    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
   617	  ok "VERSION ($cur_version) matches the base version of the tag"
   618	
   619	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   620	    && die "tag $TARGET_TAG already exists"
   621	
   622	  hdr "tag guards (unconditional — RC and stable)"
   623	  if [ "$OFFLINE_ACK" -eq 1 ]; then
   624	    python3 "$TAG_GUARD" ancestry --repo "$REPO_ROOT" --remote origin --branch main --offline-ack \
   625	      || die "ancestry guard refused the tag (see above)"
   626	  else
   627	    python3 "$TAG_GUARD" ancestry --repo "$REPO_ROOT" --remote origin --branch main \
   628	      || die "ancestry guard refused the tag (see above)"
   629	  fi
   630	  python3 "$TAG_GUARD" delta --repo "$REPO_ROOT" --tag "$TARGET_TAG" \
   631	    || die "restricted-delta guard refused the tag (see above)"
   632	
   633	  anchor="$(git rev-parse HEAD)"
   634	  msg="$TARGET_TAG — $RELEASE_TITLE
   635	
   636	Anchor: $anchor
   637	Scope:  $RELEASE_SCOPE
   638	
   639	Headline: $RELEASE_HEADLINE
   640	
   641	No speed claim. See CHANGELOG.md [$TARGET_BASE]."
   642	
   643	  if [ "$DRY_RUN" -eq 1 ]; then
   644	    note "dry-run: tag NOT created. Message that would be signed:"
   645	    printf '%s\n' "$msg" | sed 's/^/      | /'
   646	    return 0
   647	  fi
   648	
   649	  git tag -s -u "$SIGN_KEY" -m "$msg" "$TARGET_TAG" \
   650	    || die "git tag -s failed (key $SIGN_KEY)"
