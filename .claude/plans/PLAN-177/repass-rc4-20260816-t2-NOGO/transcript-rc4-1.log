   294	def _count_top_level_key(text: str, key: str) -> int:
   295	    """How many times `key:` is declared at the top level of the block.
   296	
   297	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   298	    step-15 reader: a second `verdict:` silently overrides the first, so
   299	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   300	    block selection and same comment rule as the reader, or the count
   301	    would be about a different text than the parse.
   302	
   303	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   304	    counter does NOT strip the key and the step-15 twin does, so on a
   305	    non-canonical block the two counts differ. delta() checks the shape
   306	    first.
   307	    """
   308	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   309	    if block is None:
   310	        return 0
   311	    seen = 0
   312	    for raw in block.group(1).splitlines():
   313	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   314	        if not line.strip() or line[0] in (" ", "\t"):
   315	            continue
   316	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   317	        if m and m.group(1) == key:
   318	            seen += 1
   319	    return seen
