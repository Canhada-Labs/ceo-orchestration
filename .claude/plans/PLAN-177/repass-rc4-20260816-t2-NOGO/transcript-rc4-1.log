   322	def _sha256(path: str) -> str:
   323	    h = hashlib.sha256()
   324	    with open(path, "rb") as fh:
   325	        for chunk in iter(lambda: fh.read(65536), b""):
   326	            h.update(chunk)
   327	    return h.hexdigest()
   328	
