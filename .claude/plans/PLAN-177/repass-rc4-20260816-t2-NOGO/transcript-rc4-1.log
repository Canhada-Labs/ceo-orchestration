import builtins, contextlib, io, pathlib, subprocess, types

def module_from_text(name, text, filename):
    m=types.ModuleType(name)
    m.__file__=filename
    m.__dict__[\"__name__\"]=name
    exec(compile(text,filename,\"exec\"),m.__dict__)
    return m

def current(path,name):
    return module_from_text(name,pathlib.Path(path).read_text(),path)

def base(path,name):
    text=subprocess.run([\"git\",\"show\",\"v1.3.0-rc.3:\"+path],capture_output=True,text=True,check=True).stdout
    return module_from_text(name,text,\"rc3:\"+path)

