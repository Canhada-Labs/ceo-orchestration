  2252	def _write_live_shaped_verdict(
  2253	    path: Path, tag: str, decisions: Sequence[str], parent: str
  2254	) -> None:
  2255	    """A verdict envelope the LIVE governance files accept end to end.
  2256	
  2257	    `decisions` is a SEQUENCE so the fixture can express the three shapes the
  2258	    gate must separate: zero lines (absent), one line (normal), two lines (the
  2259	    last-wins override). Values are written verbatim -- a malformed or unknown
  2260	    token reaches the validator exactly as authored.
  2261	    """
  2262	    tv = _live_tool_versions()
  2263	    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
  2264	    lines = ["# Pair-Rail Verdict -- fixture", "", "```yaml"]
  2265	    lines += [_decision_line(d).rstrip("\n") for d in decisions]
  2266	    lines += [
  2267	        "generated_at: %sZ" % now,
  2268	        "ttl_hours: 24",
  2269	        "parent_sha: %s" % parent,
  2270	        "release_tag: %s" % tag,
  2271	        "inputs_hash: %s" % _live_inputs_hash(),
  2272	        "tool_versions:",
  2273	        "  codex_cli: %s" % tv["codex_cli"],
  2274	        "  codex_target_triple: %s" % tv["codex_target_triple"],
  2275	        "  codex_payload_sha256: %s" % tv["codex_payload_sha256"],
  2276	        "gpg_signature: -----BEGIN PGP SIGNATURE----- fixture-not-a-signature",
  2277	        "```",
  2278	        "",
  2279	    ]
  2280	    path.write_text("\n".join(lines), encoding="utf-8")
