   345	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   346	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   347	    directory = os.path.dirname(manifest) or "."
   348	    name = os.path.basename(manifest)
   349	    try:
   350	        proc = subprocess.run(
   351	            ["shasum", "-a", "256", "-c", name],
   352	            cwd=directory,
   353	            stdout=subprocess.PIPE,
   354	            stderr=subprocess.STDOUT,
   355	            universal_newlines=True,
   356	        )
   357	        return proc.returncode == 0, proc.stdout.strip()
   358	    except (OSError, FileNotFoundError):
   359	        bad: List[str] = []
   360	        for want, rel in _read_manifest(manifest):
   361	            full = os.path.join(directory, rel)
   362	            if not os.path.isfile(full) or _sha256(full) != want:
   363	                bad.append(rel)
   364	        if bad:
   365	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   366	        return True, "hashlib fallback: all entries match"
