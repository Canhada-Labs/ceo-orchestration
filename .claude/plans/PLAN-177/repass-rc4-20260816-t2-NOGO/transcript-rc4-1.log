  2342	def test_ci_validator_stops_a_duplicated_decision_key(tmp_path, ci_env, bind_parent):
  2343	    """Both readers are last-wins: NO-GO followed by GO parses as GO. An
  2344	    envelope with two decision lines is not a verdict, it is an override."""
  2345	    proc = _run_ci_validator(tmp_path, ci_env, ["NO-GO", "GO"], bind_parent)
  2346	    assert proc.returncode == validator.EXIT_VERDICT_INVALID, (
  2347	        "a duplicated verdict key was accepted -- last-wins parsing turned a "
  2348	        "NO-GO into a GO.\n%s%s" % (proc.stdout, proc.stderr)
