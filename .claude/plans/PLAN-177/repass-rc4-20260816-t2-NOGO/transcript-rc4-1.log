  2489	def test_both_rails_answer_identically_on_every_key_shape():
  2490	    """The instrument that would have caught P1-a: ONE question, two readers.
  2491	
  2492	    A divergence is only visible when the same bytes are put to both. For any
  2493	    block both accept, they must also agree on how many decisions it declares
  2494	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2495	    things on the two machines that gate a release.
  2496	    """
  2497	    def block(body: str) -> str:
  2498	        return "# fixture\n\n```yaml\n%s```\n" % body
  2499	
  2500	    canonical_shapes = [
  2501	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2502	        "verdict: NO-GO\nverdict: GO\n",
  2503	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2504	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2505	        "verdict: GO  # inline comment\n",
  2506	        "# verdict: NO-GO\nverdict: GO\n",
  2507	    ]
  2508	    noncanonical_shapes = [
  2509	        "verdict : NO-GO\nverdict: GO\n",
  2510	        "verdict\t: NO-GO\nverdict: GO\n",
  2511	        "verdict : GO\n",
  2512	        '"verdict": GO\n',
  2513	        "verdict :GO\n",
  2514	    ]
  2515	    for body in canonical_shapes:
  2516	        text = block(body)
  2517	        assert validator.noncanonical_top_level_lines(text) == [], body
  2518	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2519	        assert validator.count_top_level_key(
  2520	            text, "verdict"
  2521	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2522	            "the two rails disagree on how many decisions %r declares" % body
  2523	        )
  2524	        assert validator.parse_verdict_text(text).get(
  2525	            "verdict"
  2526	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2527	            "the two rails disagree on WHICH decision wins in %r" % body
  2528	        )
  2529	    for body in noncanonical_shapes:
  2530	        text = block(body)
  2531	        assert validator.noncanonical_top_level_lines(text) != [], body
  2532	        assert (
  2533	            tag_guard._noncanonical_top_level_lines(text)
  2534	            == validator.noncanonical_top_level_lines(text)
  2535	        ), "the two shape gates disagree about %r" % body
