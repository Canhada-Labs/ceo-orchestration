     1	#!/usr/bin/env bash
     2	# scripts/tests/test-install-upgrade-parity-e2e.sh
     3	# PLAN-166 W0 / F4 (OQ-4) — install≠upgrade parity, measured on the RESULTING
     4	# TREES, per ceremony mode.
     5	#
     6	# WHY THIS EXISTS (F4, P1)
     7	# ------------------------
     8	# The previous parity gate was dead twice over:
     9	#   (a) TAUTOLOGICAL — scripts/tests/test_install_baseline_manifest.sh "C.2"
    10	#       compared `_framework_target_entries()` with `_framework_target_entries()`
    11	#       and admitted it in a comment ("the enumeration is static
    12	#       (root-independent), so an 'install context' and an 'upgrade context'
    13	#       derive an identical target set by construction"). It also carried a
    14	#       hand-written closed list of "required entries".
    15	#   (b) INVISIBLE — no workflow ran scripts/tests/*.sh except smoke-install.yml,
    16	#       and neither the old assertion nor this file was wired into it. 5th
    17	#       instance of the "red gate nobody runs" class.
    18	# Set-equality of ENUMERATIONS — even independently derived ones — can NEVER
    19	# reach the delivery sites that live OUTSIDE the enumeration. That is exactly
    20	# how F3 was born: `SPEC/v1` is delivered by install.sh (`install_one "SPEC/v1"`,
    21	# install.sh:1307) and by NOTHING in upgrade.sh, and it is absent from
    22	# `_framework_target_entries()`. So this test compares REAL TREES.
    23	#
    24	# WHAT IT DOES
    25	# ------------
    26	#   Route A (fresh)      : install.sh (WORKING TREE)                      -> A
    27	#   Route B (historical) : install.sh @ $PIN -> upgrade.sh (WORKING TREE) -> B
    28	# for EACH ceremony mode (maintainer, user). Both targets get the SAME basename
    29	# so install.sh's {{PROJECT_NAME}} substitution is identical on both sides.
    30	#
    31	# THE MEASUREMENT (why "diff -r A B" is the wrong instrument)
    32	# -----------------------------------------------------------
    33	# A raw byte-diff of the two trees answers "are these two installs identical",
    34	# which is not the question. The question is "did the upgrade deliver the
    35	# CURRENT generation of framework content?" So every path is classified against
    36	# BOTH source generations (the working tree and the $PIN archive):
    37	#
    38	#   IDENTICAL      A(p) == B(p)                                      ok
    39	#   PERSONALIZED   B(p) == head_src(p): upgrade shipped CURRENT       advisory
    40	#                  framework bytes; install.sh additionally
    41	#                  substitutes {{PROJECT_NAME}}-class placeholders
    42	#   STALE          B(p) == pin_src(p) != head_src(p): the upgrade     FATAL
    43	#                  LEFT THE OLD GENERATION IN PLACE   <-- F3 signature
    44	#   MISSING_IN_B   install delivered p, upgrade did not               FATAL
    45	#   UNCLASSIFIED   diverges and matches neither generation            FATAL
    46	#                  (generated/adopter-owned paths must be DECLARED)
    47	#   MODE_DIFF      same bytes, different +x bit ("cp lost the exec     FATAL
    48	#                  bit" is a verified S286 failure mode here)
    49	#   ONLY_IN_B      upgrade's `cp -R` drags content install's          advisory
    50	#                  selective walk never ships (ADR-155 pre-existing
    51	#                  drift) -- EXCEPT outside .claude/ in `user` mode,
    52	#                  which is FATAL (the WS4 no-writes-outside-.claude
    53	#                  invariant that smoke-install.yml already asserts
    54	#                  for install and nobody asserts for upgrade)
    55	#
    56	# Declarations are checked for ROT in both directions:
    57	#   * KNOWN-OPEN ledger entries are MANDATORY-FIRE: an entry that matches
    58	#     nothing is FATAL ("the bug you named is closed -- delete the entry").
    59	#     A ledger cannot outlive its bug.
    60	#   * DECLARED generated/adopter-owned paths that turn out IDENTICAL emit a
    61	#     WARNING (declaration is stale; harmless).
    62	#   * Any divergence matching NO declaration is FATAL. That is the live gate;
    63	#     the positive control trips exactly there.
    64	#
    65	# EXIT CODES
    66	#   0  parity   — no fatal divergence and no KNOWN-OPEN entry outstanding
    67	#   1  FAIL     — undeclared divergence (what the positive control must
    68	#                 produce, and what a real install/upgrade regression produces)
    69	#   2  KNOWN-OPEN — only the explicitly named PLAN-166 W1 prerequisites are
    70	#                 outstanding. STILL A FAILURE, never a silent skip: the
    71	#                 printed ledger names each one and what unblocks it. This is
    72	#                 the expected pre-W1 result.
    73	#   9  SCAFFOLD-ERROR — the fixture itself broke (tag unresolvable, install or
    74	#                 upgrade returned non-zero, python3 missing). NEVER a verdict
    75	#                 on the bug. In CI the historical leg needs the TAG: a
    76	#                 `fetch-depth: 1` checkout does not have it.
    77	#
    78	# POSITIVE CONTROL
    79	#   --positive-control deletes ONE `backup_and_replace "<dir>"` line from a COPY
    80	#   of upgrade.sh and re-runs the whole thing. The expected outcome is exit 1 in
    81	#   EVERY mode tested. If any mode does NOT go fatal, the run ends in exit 9
    82	#   SCAFFOLD-ERROR ("the control is vacuous"), never in a green — a control that
    83	#   silently stops firing is worse than no control at all. That happens for a
    84	#   real reason: the plant only bites if the planted directory actually drifted
    85	#   between $PIN and HEAD, so the guard is DERIVED from the run, not asserted
    86	#   from memory.
    87	#   ORDERING MATTERS: the control only proves something when the UN-planted run
    88	#   was not already fatal, otherwise rc=1 could come from a pre-existing
    89	#   divergence rather than from the plant. So CI runs the plain gate FIRST and
    90	#   the control only after it passed; run it the same way by hand.
    91	#
    92	# USAGE
    93	#   bash scripts/tests/test-install-upgrade-parity-e2e.sh
    94	#   bash scripts/tests/test-install-upgrade-parity-e2e.sh --mode user
    95	#   bash scripts/tests/test-install-upgrade-parity-e2e.sh --positive-control
    96	#   bash scripts/tests/test-install-upgrade-parity-e2e.sh --print-pin
    97	#
    98	# W1 CHECKLIST: the KNOWN_OPEN ledger in _parity_classify.py is MANDATORY-FIRE.
    99	# When W1 lands the F3 fix those entries stop matching and the classifier goes
   100	# fatal on ledger-rot BY DESIGN — deleting them belongs to the same commit.
   101	#
   102	# bash-3.2 safe (no associative arrays, no mapfile). Network-free. Writes only
   103	# under mktemp -d. Requires: git, python3, tar.
   104	
   105	set -uo pipefail   # NOT -e: failures are classified, not fatal-by-default.
   106	
   107	SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
   108	REPO_ROOT="$( cd "$SCRIPT_DIR/../.." && pwd )"
   109	
   110	PIN="${CEO_PARITY_PIN:-v1.2.0}"
   111	PROFILE="${CEO_PARITY_PROFILE:-core}"
   112	MODES="maintainer user"
   113	POSITIVE_CONTROL=0
   114	# The single line deleted from a COPY of upgrade.sh by --positive-control.
   115	PLANT_TARGET='.claude/commands'
   116	
   117	PRINT_PIN=0
   118	
   119	while [ $# -gt 0 ]; do
   120	  case "$1" in
   730	    rm -f "$_ppid_tmp" 2>/dev/null
   731	    return 0
   732	  fi
   733	  rm -f "$_ppid_tmp" 2>/dev/null
   734	  return 1
   735	}
   736	
   737	# =============================================================================
   738	# PLAN-177 W1 (P1-1 / CF-9) — the ONE owner of every .gitignore surface the
   739	# framework delivers.
   740	#
   741	# THE BUG. install.sh has appended two marker-guarded blocks to the adopter's
   742	# ROOT .gitignore for a long time — the MCP shared-secret store (PLAN-019
   743	# P2-SEC-H) and the posture/runtime state (PLAN-165 CX-3) — and upgrade.sh has
   744	# appended NOTHING, ever. An adopter who installed at v1.2.0 and only ever runs
   745	# upgrade.sh therefore receives /night-mode without the ignores, so
   746	# `/night-mode on` leaves .claude/settings.local.json and the state marker as
   747	# untracked files (falsifying PLAN-165 AC-1, "git status stays empty") and
   748	# risks committing a machine-specific permission posture. The parity gate NAMED
   749	# that gap and allowlisted it, so CI was structurally unable to fail on it.
   750	#
   751	# WHY BOTH BLOCKS. Owning only the posture block would leave the mcp-secrets
   752	# block as a second, unowned copy of the same kind of text on the same file —
   753	# a ceremony that grants ownership of half a surface. An adopter older than
   754	# v1.2.0 also never received the mcp-secrets entry from an upgrade.
   755	#
   756	# WHY ONE PLACE. This is INV-4 (PLAN-168 W2): install.sh and upgrade.sh each
   757	# carrying a private copy of the same emitted text is precisely the class that
   758	# produced the PROTOCOL.md pointer divergence. Both callers render through
   759	# these functions, so the routes cannot diverge again.
   760	#
   761	# BYTE-COMPATIBILITY (do not "tidy"): every emission below reproduces the
   762	# shipped install.sh output exactly, including two idiosyncrasies that a
   763	# reviewer will be tempted to clean up.
   764	#   1. The posture header comment is emitted INSIDE the loop, once per APPENDED
   765	#      entry. Hoisting it to a single header changes the bytes on every adopter
   766	#      .gitignore and breaks install/upgrade tree parity.
   767	#   2. The mcp-secrets CREATE branch (no .gitignore yet) writes the header with
   768	#      NO leading blank line, while the APPEND branch writes one. Same file,
   769	#      two shapes, by construction.
   770	# BYTE-PROOF.md plants both as mutations and requires the harness to go red.
   771	#
   772	# IDEMPOTENCE, and its deliberate limit. Re-running never duplicates a line:
   773	# every entry is `grep -Fxq` (fixed-string, whole-line) checked first. The
   774	# check is PER LINE, not per block, so an adopter who deliberately deletes one
   775	# entry gets it re-appended on the next install/upgrade — with a fresh header
   776	# comment above it. That is intentional, not an oversight: these entries exist
   777	# to keep secrets and per-machine permission posture out of VCS, so the
   778	# framework re-asserts them rather than honouring a deletion it cannot
   779	# distinguish from an accident. An adopter who truly wants the path tracked
   780	# should scope it in .git/info/exclude or a nested .gitignore instead.
   781	#
   782	# Functions:
   783	#   _mcp_secrets_ignore_entry              -> the mcp-secrets entry (one line)
   784	#   _apply_mcp_secrets_ignore GITIGNORE    -> ensure it, create-or-append
   785	#   _posture_state_ignore_entries          -> the posture entries (one line,
   786	#                                             space-separated; both callers
   787	#                                             word-split it AND print it
   788	#                                             verbatim, so the single-line
   789	#                                             shape is part of the contract)
   790	#   _apply_posture_state_ignores GITIGNORE -> ensure them, append-only
   791	#   _claude_dir_gitignore_body             -> the NEW .claude/.gitignore body
   792	#   _apply_claude_dir_gitignore CLAUDE_DIR -> create-if-missing, never rewrite
   793	#   _preview_claude_dir_gitignore CLAUDE_DIR -> dry-run twin of the apply:
   794	#       reports would-CREATE / would-APPEND (per missing entry) /
   795	#       would-PRESERVE, so a seeded adopter file (e.g. `/cache/` only) is
   796	#       never misreported as PRESERVE when the real run would append
   797	#       (re-pass rc.4 t2 P1 — the seeded-file dry-run regression)
   798	# =============================================================================
   799	
   800	_mcp_secrets_ignore_entry() {
   801	  printf '%s\n' "state/mcp_client_secrets/"
   802	}
   803	
   804	_apply_mcp_secrets_ignore() {
   805	  # $1 = path to the adopter ROOT .gitignore (may not exist yet).
   806	  _msi_gitignore="$1"
   807	  # Re-pass rc.4 t2 (P1): shared symlink refusal — a root .gitignore
   808	  # symlink must never route framework appends elsewhere.
   809	  _root_gitignore_symlink_guard "$_msi_gitignore" || return 1
   810	  _msi_line="$( _mcp_secrets_ignore_entry )"
   811	  if [ -f "$_msi_gitignore" ]; then
   812	    if ! grep -Fxq "$_msi_line" "$_msi_gitignore" 2>/dev/null; then
   813	      {
   814	        echo ""
   815	        echo "# PLAN-019 P2-SEC-H: MCP shared-secret store (never commit)"
   816	        echo "$_msi_line"
   817	      } >> "$_msi_gitignore"
   818	      echo "    APPENDED to .gitignore: $_msi_line"
   819	    else
   820	      echo "    .gitignore already excludes $_msi_line"
   821	    fi
   822	  else
   823	    {
   824	      echo "# PLAN-019 P2-SEC-H: MCP shared-secret store (never commit)"
   825	      echo "$_msi_line"
   826	    } > "$_msi_gitignore"
   827	    echo "    CREATED .gitignore with: $_msi_line"
   828	  fi
   829	  # t9 P1: the SECRET store is exactly where textual presence must not be
   830	  # mistaken for effective exclusion — a later `!` negation would leave
   831	  # secret files commit-eligible while this applier reports "already
   832	  # excludes". Same shared probe + re-assert as the posture entries.
   833	  _msi_repo="$( dirname "$_msi_gitignore" )"
   834	  _gitignore_reassert_effective "$_msi_repo" "$_msi_gitignore" \
   835	    "$_msi_line" "state/mcp_client_secrets/__ceo_ignore_probe__" || return 1
   836	  return 0
   837	}
   838	
   839	_posture_state_ignore_entries() {
   840	  printf '%s\n' ".claude/state/ .claude/settings.local.json"
   841	}
   842	
   843	_root_gitignore_symlink_guard() {
   844	  # $1 = path to the adopter ROOT .gitignore. 0 = safe; 1 = symlink
   845	  # (re-pass rc.4 t3 P2: shared predicate for APPLY *and* dry-run
   846	  # previews — the preview must never say "would ENSURE" where the real
   847	  # run refuses).
   848	  if [ -L "$1" ]; then
   849	    echo "    ERROR: root .gitignore is a symlink — refusing to write through it" >&2
   850	    return 1
   851	  fi
   852	  return 0
   853	}
   854	
   855	# t8 P1: textual PRESENCE of an exact ignore line is not EFFECTIVENESS —
   856	# a later `!*.json` negation in the same (or a deeper) file wins in git,
   857	# so `grep -Fxq` alone let night-mode artifacts stay commit-eligible.
   858	# _gitignore_reassert_effective probes git's EFFECTIVE answer for each
   859	# mandatory exclusion; when a probe is visible it APPENDS the exclusion
   860	# again (after the winning negation — last matching rule wins) and
   861	# re-probes; a still-visible probe fails loudly (the negation lives in a
   862	# file this applier does not own, e.g. a deeper .gitignore).
   863	#   $1 = repo root to run git in; $2 = gitignore file to re-assert into;
   864	#   $3 = the raw exclusion line; $4 = repo-relative probe path.
   865	# Outside a git work tree the probe cannot run — NOTE and return 0
   866	# (fail-open on infra; the textual pass above already ran).
   867	_gitignore_reassert_effective() {
   868	  _gre_repo="$1"; _gre_file="$2"; _gre_line="$3"; _gre_probe="$4"
   869	  if ! git -C "$_gre_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
   870	    echo "    NOTE: not a git work tree — cannot probe effective ignore for $_gre_line"
   871	    return 0
   872	  fi
   873	  # t10 P1 #2: ignore rules NEVER affect files already in the index — a
   874	  # pre-rc.4 adopter who committed the posture/secret path stays dirty no
   875	  # matter what this file says. Detect tracked content FIRST and require
   876	  # an explicit migration; this is fail-CLOSED because leaving it silent
   877	  # is exactly the leak this delivery exists to close.
   878	  case "$_gre_probe" in
   879	    */__ceo_ignore_probe__) _gre_scope="$( dirname "$_gre_probe" )" ;;
   880	    *)                      _gre_scope="$_gre_probe" ;;
   881	  esac
   882	  # sed, never `head` (t11 P2): under the callers' pipefail, head closing
   883	  # the pipe early makes ls-files exit 141 and aborts the WHOLE upgrade
   884	  # before the migration message prints (the repo's known SIGPIPE class).
   885	  _gre_tracked="$( git -C "$_gre_repo" ls-files -- "$_gre_scope" 2>/dev/null | sed -n '1,5p' )"
   886	  if [ -n "$_gre_tracked" ]; then
   887	    echo "    ERROR: $_gre_scope is already TRACKED by git — an ignore rule cannot protect it." >&2
   888	    echo "      Migrate explicitly, then re-run:" >&2
   889	    printf '%s\n' "$_gre_tracked" | while IFS= read -r _gre_t; do
   890	      echo "        git rm --cached '$_gre_t'" >&2
   891	    done
   892	    return 1
   893	  fi
   894	  # t10 P1 #2: --no-index — plain check-ignore consults the index and
   895	  # reports a tracked path as unmatched, causing a re-assert loop; the
   896	  # question here is strictly "does the PATTERN SET cover this path?".
   897	  if git -C "$_gre_repo" check-ignore -q --no-index -- "$_gre_probe" 2>/dev/null; then
   898	    return 0
   899	  fi
   900	  {
   901	    echo ""
   902	    echo "# Re-asserted by ceo-orchestration (re-pass rc.4 t8 P1): a later"
   903	    echo "# rule in this file negated the mandatory exclusion below; git's"
   904	    echo "# last-matching-rule-wins makes this trailing copy effective."
   905	    printf '%s\n' "$_gre_line"
   906	  } >> "$_gre_file"
   907	  if git -C "$_gre_repo" check-ignore -q --no-index -- "$_gre_probe" 2>/dev/null; then
   908	    echo "    RE-ASSERTED (was textually present but negated): $_gre_line"
   909	    return 0
   910	  fi
   911	  # t10 P1 #1: a still-visible SECURITY exclusion is a FAILURE, not a
   912	  # warning — returning 0 here let install/upgrade finish green while
   913	  # the secret store stayed commit-eligible (e.g. a deeper
   914	  # state/.gitignore re-including it, which outranks this file).
   915	  echo "    ERROR: $_gre_line is present but NOT effective (a rule outside $_gre_file wins — e.g. a deeper .gitignore re-including it). Fix the adopter ignore rules, then re-run." >&2
   916	  return 1
   917	}
   918	
   919	_apply_posture_state_ignores() {
   920	  # $1 = path to the adopter ROOT .gitignore (append creates it if absent).
   921	  _psi_gitignore="$1"
   922	  _root_gitignore_symlink_guard "$_psi_gitignore" || return 1
   923	  for _psi_line in $( _posture_state_ignore_entries ); do
   924	    if [ -f "$_psi_gitignore" ] && grep -Fxq "$_psi_line" "$_psi_gitignore" 2>/dev/null; then
   925	      echo "    .gitignore already excludes $_psi_line"
   926	      continue
   927	    fi
   928	    {
   929	      echo ""
   930	      echo "# PLAN-165 CX-3: per-machine posture/runtime state (never commit)"
   931	      echo "$_psi_line"
   932	    } >> "$_psi_gitignore"
   933	    echo "    APPENDED to .gitignore: $_psi_line"
   934	  done
   935	  # t8 P1: presence pass done — now assert EFFECTIVENESS per entry.
   936	  _psi_repo="$( dirname "$_psi_gitignore" )"
   937	  _gitignore_reassert_effective "$_psi_repo" "$_psi_gitignore" \
   938	    ".claude/state/" ".claude/state/__ceo_ignore_probe__" || return 1
   939	  _gitignore_reassert_effective "$_psi_repo" "$_psi_gitignore" \
   940	    ".claude/settings.local.json" ".claude/settings.local.json" || return 1
   941	  return 0
   942	}
   943	
   944	_claude_dir_gitignore_body() {
   945	  # Paths are anchored with a leading slash so they bind to .claude/ ONLY and
   946	  # cannot match a same-named path deeper in an adopter tree.
   947	  printf '%s\n' \
   948	    "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9)." \
   949	    "#" \
   950	    "# Per-machine posture + runtime state that must never reach VCS:" \
   951	    "#   state/             runtime state as a whole (PLAN-163 T3.1)" \
   952	    "#   settings.local.json  permission overlay deciding the NEXT session's" \
   953	    "#                        posture (PLAN-165)" \
   954	    "#" \
   955	    "# The root .gitignore carries the same exclusions for adopters who track" \
   956	    "# this tree from the repository root. This file additionally covers the" \
   957	    "# --ceremony user install, which never writes outside .claude/ and so" \
   958	    "# never received them." \
   959	    "#" \
   960	    "# Adopter-owned once created: install and upgrade never REPLACE this" \
   961	    "# file — adopter bytes are preserved; missing mandatory framework" \
   962	    "# security entries may be APPENDED (additively reasserted) on upgrade." \
   963	    "/state/" \
   964	    "/settings.local.json"
   965	}
   966	
   967	_apply_claude_dir_gitignore() {
   968	  # $1 = the adopter .claude directory.
   969	  # Create when absent; when PRESENT, append only the entries that are
   970	  # missing, per line, preserving every adopter byte (re-pass rc.4 t1
   971	  # P1-b: an adopter with a pre-existing .claude/.gitignore -- e.g.
   972	  # /cache/ only -- never received /state/ nor /settings.local.json,
   973	  # so night-mode state stayed commit-eligible under --ceremony user;
   974	  # create-if-missing alone proved the clean-target case only). Same
   975	  # grep -Fxq per-entry predicate as the root blocks: the file stays
   976	  # adopter-owned, nothing is rewritten, a deliberate edit to OUR
   977	  # comment lines is never repaired.
   978	  _cdg_dir="$1"
   979	  _cdg_file="$_cdg_dir/.gitignore"
   980	  # Re-pass rc.4 t2 (P1): NEVER follow a symlink here. A .claude/.gitignore
   981	  # symlinked to another writable file would receive framework appends at
   982	  # the EXTERNAL target; a dangling symlink passes `[ ! -e ]` and the
   983	  # redirect would CREATE its target. -L catches both, before any read.
   984	  if [ -L "$_cdg_file" ]; then
   985	    echo "    ERROR: .claude/.gitignore is a symlink — refusing to read or write through it (preserve/replace it manually)" >&2
   986	    return 1
   987	  fi
   988	  if [ ! -e "$_cdg_file" ]; then
   989	    [ -d "$_cdg_dir" ] || mkdir -p "$_cdg_dir"
   990	    _claude_dir_gitignore_body > "$_cdg_file"
   991	    echo "    CREATED: .claude/.gitignore"
   992	    # t11 P1: DO NOT return here — the effectiveness + tracked checks
   993	    # below must run on the freshly created file too. A user-ceremony
   994	    # adopter with an already-TRACKED .claude/settings.local.json got a
   995	    # green install while the overlay stayed commit-eligible (user
   996	    # ceremony never runs the root helper that would have caught it).
   997	    _cdg_repo="$( dirname "$_cdg_dir" )"
   998	    _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
   999	      "/state/" ".claude/state/__ceo_ignore_probe__" || return 1
  1000	    _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
  1001	      "/settings.local.json" ".claude/settings.local.json" || return 1
  1002	    return 0
  1003	  fi
  1004	  if [ ! -f "$_cdg_file" ]; then
  1005	    echo "    ERROR: .claude/.gitignore exists but is not a regular file" >&2
  1006	    return 1
  1007	  fi
  1008	  _cdg_added=0
  1009	  for _cdg_entry in "/state/" "/settings.local.json"; do
  1010	    if grep -Fxq "$_cdg_entry" "$_cdg_file"; then
  1011	      continue
  1012	    fi
  1013	    {
  1014	      echo ""
  1015	      echo "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9): per-machine"
  1016	      echo "# posture/runtime state (never commit)."
  1017	      printf '%s\n' "$_cdg_entry"
  1018	    } >> "$_cdg_file"
  1019	    _cdg_added=1
  1020	  done
  1021	  # t8 P1: presence pass done — now assert EFFECTIVENESS per entry
  1022	  # (probes are repo-relative; the repo root is the parent of .claude/).
  1023	  _cdg_repo="$( dirname "$_cdg_dir" )"
  1024	  _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
  1025	    "/state/" ".claude/state/__ceo_ignore_probe__" || return 1
  1026	  _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
  1027	    "/settings.local.json" ".claude/settings.local.json" || return 1
  1028	  if [ "$_cdg_added" = "1" ]; then
  1029	    echo "    APPENDED: missing posture entries into existing .claude/.gitignore"
  1030	  else
  1031	    echo "    EXISTS: .claude/.gitignore already carries both entries"
  1032	  fi
  1033	  return 0
  1034	}
  1035	
  1036	# t11 P1 #2: read-only tracked-path classifier SHARED by apply previews —
  1037	# prints the tracked sensitive paths (max 5) under $2.. scopes of repo $1;
  1038	# empty output == nothing tracked. Never writes, never fails the caller.
  1039	_gitignore_tracked_sensitive() {
  1040	  _gts_repo="$1"; shift
  1041	  git -C "$_gts_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
  1042	  for _gts_scope in "$@"; do
  1043	    git -C "$_gts_repo" ls-files -- "$_gts_scope" 2>/dev/null
  1044	  done | sed -n '1,5p'
  1045	  return 0
  1046	}
  1047	
  1048	_preview_claude_dir_gitignore() {
  1049	  # Dry-run twin of _apply_claude_dir_gitignore (re-pass rc.4 t2 P1):
  1050	  # SAME per-entry predicate, ZERO writes. Reports the action the real
  1051	  # run would take — including would-APPEND on a seeded adopter file.
  1052	  _pcg_file="$1/.gitignore"
