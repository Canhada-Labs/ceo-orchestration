  1977	# --------------------------------------------------------------------------
  1978	# Supply-chain honesty: the two claims that survive being corrected in one file
  1979	#
  1980	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  2090	        )
  2091	
  2092	
  2093	# --------------------------------------------------------------------------
  2094	# The npm signature recipe has to audit the thing the reader just installed
  2095	#
  2096	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2097	# no package-selecting positional (a trailing package name is ignored), and it
  2098	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2099	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2100	# with `npm audit signatures` verified nothing the reader had just installed —
  2101	# it audited whatever directory they happened to be standing in, and could
  2102	# return a confident green having examined a different tree entirely.
  2103	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2104	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2105	# project install followed by a BARE `npm audit signatures`.
  2106	# --------------------------------------------------------------------------
  2107	
  2108	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2109	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2110	# (ephemeral — nothing is left in a dependency tree to audit).
  2111	_UNAUDITABLE_INSTALL = re.compile(
  2112	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2113	)
  2114	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2115	# the reader believes it selected a package. `#` is excluded so the honest
  2116	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2117	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2118	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2119	_AUDIT_GLOBAL_FLAG = re.compile(
  2120	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2121	)
  2122	
  2123	
  2124	def _recipe_units(text: str) -> List[tuple]:
  2125	    """(label, body) for each fenced code block, and for each line outside one.
  2126	
  2127	    A recipe is what a reader copies, and they copy a whole code block — so the
  2128	    block, not the line, is the unit in which "install here, audit there" has
  2129	    to be judged. Prose lines are units of their own so a one-line table row
  2130	    (the shape `SUPPORT.md` used) is still examined."""
  2131	    units: List[tuple] = []
  2132	    block: Optional[List] = None
  2133	    for num, line in enumerate(text.splitlines(), 1):
  2134	        if line.strip().startswith("```"):
  2135	            if block is None:
  2136	                block = [num, []]
  2137	            else:
  2138	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2139	                block = None
  2140	            continue
  2141	        if block is not None:
  2142	            block[1].append(line)
  2143	        else:
  2144	            units.append(("line@%d" % num, line))
  2145	    if block is not None:  # unterminated fence: judge what we collected
  2146	        units.append(("block@%d" % block[0], "\n".join(block[1])))
  2147	    return units
  2148	
