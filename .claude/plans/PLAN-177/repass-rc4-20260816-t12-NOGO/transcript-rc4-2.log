  2124	def _recipe_units(text: str) -> List[tuple]:
  2125	    """(label, body) for each fenced code block, and for each line outside one.
  2126	
  2127	    A recipe is what a reader copies, and they copy a whole code block — so the
  2128	    block, not the line, is the unit in which "install here, audit there" has
  2129	    to be judged. Prose lines are units of their own so a one-line table row
  2130	    (the shape `SUPPORT.md` used) is still examined."""
  2131	    units: List[tuple] = []
  2132	    block: Optional[List] = None
  2133	    for num, line in enumerate(text.splitlines(), 1):
  2134	        if line.strip().startswith("```"):
  2135	            if block is None:
  2136	                block = [num, []]
  2137	            else:
  2138	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2139	                block = None
  2140	            continue
  2141	        if block is not None:
  2142	            block[1].append(line)
  2143	        else:
  2144	            units.append(("line@%d" % num, line))
  2145	    if block is not None:  # unterminated fence: judge what we collected

