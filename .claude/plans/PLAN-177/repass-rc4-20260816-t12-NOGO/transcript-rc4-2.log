  1741	        line for line in sums.splitlines()
  1742	        if line.startswith("#") and line[1:].startswith("   ")
  1743	    ]
  1744	    assert recipe, "the manifest no longer documents any regeneration command"
  1745	    assert not any(".shasum" in line for line in recipe), (
  1746	        "a regeneration command extracts npm's `.shasum` again -- that is "
  1747	        "SHA-1, not SHA-256, and it emits no filename: %s" % recipe
  1748	    )
  1749	    assert not any("--dry-run" in line for line in recipe), (
  1750	        "a regeneration command runs `npm pack --dry-run` -- it writes no "
  1751	        "tarball, so there is nothing to hash: %s" % recipe
  1752	    )
  1753	    assert any(
  1754	        ("sha256sum" in line or "shasum -a 256" in line) for line in recipe
  1755	    ), "no recipe line names a SHA-256 hasher: %s" % recipe
  1756	    assert any(
  1757	        ("$TARBALL" in line or '"filename"' in line) for line in recipe
  1758	    ), (
  1759	        "the recipe never materialises the tarball NAME -- the manifest "
  1760	        "format is `<sha256>  <filename>`: %s" % recipe
  1761	    )
  1762	    # the writer the file attributes itself to must exist AND hash with the
  1763	    # algorithm the filename promises (attribution is checked, not trusted).
