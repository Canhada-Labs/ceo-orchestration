  1028	def check_tier_a_spec_version_drift() -> Tuple[str, str, Any]:
  1029	    """VERSION major vs latest SPEC/v* major agreement — red on drift.
  1030	
  1031	    Cured in PLAN-178 W-C Lote A (C3): the original body read both
  1032	    inputs and never compared them — every reachable path returned
  1033	    green (the S287-class "registered-vacuous" case documented in
  1034	    memory feedback-check-tier-a-spec-version-drift-vacuous and in the
  1035	    W0 coverage table). Invariant now enforced: the MAJOR of the
  1036	    FRAMEWORK version must equal the highest SPEC/v<N> directory major.
  1037	
  1038	    Ownership-aware source (codex Lote-A P2-1): the root ``VERSION``
  1039	    in an ADOPTER repo is the adopter app's version (ADR-155-AMEND-1
  1040	    §2) — comparing it to the shipped SPEC would false-red. The
  1041	    framework version is ``.claude/.framework-version`` (written by
  1042	    install/upgrade; present in the dogfood checkout too). Without
  1043	    that file no drift claim is possible — informational green, never
  1044	    red on unattributable input.
  1045	
  1046	    Provenance (codex r2 P2-1, ADR-155-AMEND-1 §5): existence is not
  1047	    authority. The marker only supports a RED verdict when its
  1048	    delivery is verifiable: (a) the baseline manifest
  1049	    ``.claude/.install-manifest.sha256`` carries a record for it
  1050	    (adopter install/upgrade path), or (b) the marker is git-tracked
  1051	    in this checkout (framework/dogfood path). Unverified marker +
  1052	    mismatch => yellow (drift SUSPECTED), never red — and never a
  1053	    silent green either.
  1054	    """
  1055	    fw_file = REPO_ROOT / ".claude" / ".framework-version"
  1056	    if not fw_file.exists():
  1057	        return "green", "no .framework-version (drift not attributable)", None
  1058	    try:
  1059	        repo_v = fw_file.read_text(encoding="utf-8", errors="replace").strip()
  1060	    except OSError:
  1061	        return "yellow", ".framework-version unreadable", None
  1062	    provenance_ok = False
  1063	    manifest = REPO_ROOT / ".claude" / ".install-manifest.sha256"
  1064	    try:
  1065	        if manifest.exists() and ".claude/.framework-version" in manifest.read_text(
  1066	                encoding="utf-8", errors="replace"):
  1067	            provenance_ok = True
  1068	    except OSError:
  1069	        pass
  1070	    if not provenance_ok:
  1071	        try:
  1072	            provenance_ok = subprocess.run(
  1073	                ["git", "-C", str(REPO_ROOT), "ls-files", "--error-unmatch",
  1074	                 ".claude/.framework-version"],
  1075	                capture_output=True, timeout=2,
  1076	            ).returncode == 0
  1077	        except (OSError, subprocess.SubprocessError):
  1078	            provenance_ok = False
  1079	    spec_root = REPO_ROOT / "SPEC"
  1080	    if not spec_root.exists():
  1081	        return "green", f"repo {repo_v}, no SPEC dir", repo_v
  1082	    spec_majors = []
  1083	    for p in spec_root.iterdir():
  1084	        if p.is_dir() and p.name.startswith("v"):
  1085	            try:
  1086	                spec_majors.append(int(p.name[1:]))
