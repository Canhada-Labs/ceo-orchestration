  1697	    assert not re.search(r"rotation-log\.md`?\s*§\s*NPM", doc), (
  1698	        "the doc again points at a rotation-log section that does not exist"
  1699	    )
  1700	    assert ".well-known/gpg.asc" not in doc, (
  1701	        "the doc again advertises a key distribution point this project does "
  1702	        "not serve"
  1703	    )
  1704	    assert not (REPO_ROOT / ".well-known").exists(), (
  1705	        "`.well-known/` now exists — re-open the signing-key section"
  1706	    )
  1707	    for name in ("docs/rotation-log.md", ".claude/trust/owner.asc"):
  1708	        if name in doc:
  1709	            assert (REPO_ROOT / name).exists(), "doc points at missing %s" % name
  1710	    # the reproducible-build row is `deferred` because NO workflow sets the
  1711	    # variable. If one ever does, this red is the reminder to re-read the row.
  1712	    for workflow in (
  1713	        ".github/workflows/validate.yml",
  1714	        ".github/workflows/npm-publish.yml",
  1715	    ):
  1716	        body = (REPO_ROOT / workflow).read_text(encoding="utf-8")
  1717	        assert "SOURCE_DATE_EPOCH" not in body, (
  1718	            "%s now sets SOURCE_DATE_EPOCH — the reproducible-build row may "
  1719	            "have become real" % workflow
  1720	        )
  1721	    assert "npm packlist gate" in doc, (
  1722	        "the doc no longer names the packlist gate that actually runs"
  1723	    )
