  1762	    # the writer the file attributes itself to must exist AND hash with the
  1763	    # algorithm the filename promises (attribution is checked, not trusted).
  1764	    writer = REPO_ROOT / "scripts" / "install-npm.sh"
  1765	    assert any("install-npm.sh" in line for line in recipe), (
  1766	        "the recipe no longer points at the real local writer: %s" % recipe
