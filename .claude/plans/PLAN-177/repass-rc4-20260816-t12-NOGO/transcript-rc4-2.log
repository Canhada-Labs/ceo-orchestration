   450	# =============================================================================
   451	# PLAN-167 — _ownership_verdict: THE ownership decision.
   452	#
   453	# install.sh and upgrade.sh stop deciding and start executing. Every defect in
   454	# the 35-finding S296 review series was a cell of this space whose answer was
   455	# decided branch-locally, so two branches could disagree about the same
   456	# question and nothing detected it.
   457	#
   458	#   $1 surface        spec | protocol | marker
   459	#   $2 prior_record   none | hash | link_match | link_retargeted
   460	#   $3 live_type      absent | dir | dir_empty | regular | symlink | special
   461	#                     | ancestor_symlink
   462	#   $4 live_content   pristine | legacy_pristine | legacy_pristine_partial
   463	#                     | edited | -
   464	#   $5 source_has     yes | no
   465	#   $6 mode           copy | link
   466	#   $7 ceremony       user | maintainer
   467	#   $8 operation      install_fresh | install_rerun | upgrade
   468	#   $9 skip_requested none | self | descendant
   469	#
   470	#   stdout: "<VERDICT> <HASH_SOURCE>", rc 0
   471	#   rc 1, no output: a combination the legality rules forbid.
   472	#
   473	# PURE: no filesystem, no globals, no environment. Callers observe the nine
   474	# dimensions and pass them in. That purity is what lets the same table drive a
   475	# millisecond unit oracle as well as the ~25-minute end-to-end suite; S296 had
   476	# only the slow instrument, at one cell per ~40-minute round.
   477	#
   478	# ABORT_SURFACE is deliberately NOT produced here (round-1 consensus C2). A
   479	# failed backup is not a property of these nine dimensions — it is the CALLER
   480	# failing to carry out a verdict it was handed. And per INV-3 that failure
   481	# NEVER advances the record: recording a delivery that did not happen is the
   482	# over-claiming direction ADR-155-AMEND-1 §3 forbids.
   483	#
   484	# Contract: docs/ownership-decision-table.md · Truth: scripts/tests/ownership_table.tsv
   485	# =============================================================================
   486	_ownership_verdict() {
   487	  _ov_surface="$1"; _ov_prior="$2";  _ov_ltype="$3"; _ov_lcontent="$4"
   488	  _ov_shas="$5";    _ov_mode="$6";   _ov_cer="$7";   _ov_op="$8"; _ov_skip="$9"
   489	
   490	  # Do not touch the surface; decide the RECORD. Ownership continuity and the
   491	  # digit it carries are separate decisions, and moving one without the other
   492	  # produced four distinct defects — so they are resolved together, once.
   493	  _ov_carry() {
   494	    case "$_ov_prior" in
   495	      link_match)      printf 'PRESERVE_OWNED LINK_RECORD';  return 0 ;;
   496	      link_retargeted) printf 'PRESERVE_UNOWNED HASH_NONE'; return 0 ;;
   497	      none)            printf 'PRESERVE_UNOWNED HASH_NONE';  return 0 ;;
   498	    esac
   499	    # prior_record=hash. HASH_TARGET is never an option: it re-baselines the
   500	    # bytes now on disk, which is how a later upgrade comes to overwrite an
   501	    # adopter edit and uninstall comes to delete it.
   502	    if [ "$_ov_surface" = "protocol" ] \
   503	       || [ "$_ov_shas" = "no" ] \
   504	       || [ "$_ov_ltype" = "dir_empty" ]; then
   505	      printf 'PRESERVE_OWNED HASH_PRIOR_RECORD'   # no source bytes to hash
   506	    else
   507	      printf 'PRESERVE_OWNED HASH_SOURCE'
   508	    fi
   509	  }
   510	
   511	  # The framework must not claim this path. Whether a record existed changes
   512	  # only which NAME the observation takes (OQ-9 — the evidence that these are
   513	  # one outcome, not two).
   514	  # OQ-9 (ratificada pelo Owner 2026-08-07): PRESERVE_UNOWNED é o único nome.
   515	  # OMIT_RECORD dizia a mesma coisa — sem registro no disco — e diferia apenas
   516	  # por já existir registro antes, que é a coluna prior_record. Um membro de
   517	  # enum redundante é onde dois ramos discordam sobre qual deles se aplica.
   518	  _ov_unowned() { printf 'PRESERVE_UNOWNED HASH_NONE'; }
   519	
   520	  # --- Stage A: gates that refuse to act, in priority order ------------------
   521	
   522	  # A1. The source cannot deliver this surface.
   523	  if [ "$_ov_shas" = "no" ]; then
   524	    case "$_ov_surface" in
   525	      marker)   printf 'PRESERVE_UNOWNED HASH_NONE'; return 0 ;;  # --pin: readers fall back to VERSION
   526	      protocol) return 1 ;;                                  # R-03: generated, never absent
   527	      *)        _ov_carry; return 0 ;;
   528	    esac
   529	  fi
   530	
   531	  # A2. A user ceremony never receives the root surfaces (WS4).
   532	  if [ "$_ov_cer" = "user" ] && [ "$_ov_surface" != "marker" ]; then
   533	    if [ "$_ov_op" = "install_fresh" ]; then printf 'PRESERVE_UNOWNED HASH_NONE'
   534	    else _ov_carry; fi
   535	    return 0
   536	  fi
   537	
   538	  # A3. Reachable only by writing THROUGH a symlink, out of the target tree.
   539	  # Always unowned: the relpath sanitizer already dropped any record whose path
   540	  # crosses a symlink, so there is no record left to carry (docs §5.8).
   541	  if [ "$_ov_ltype" = "ancestor_symlink" ]; then _ov_unowned; return 0; fi
   542	
   543	  # A4. A leaf symlink is healthy ONLY as the recorded link-mode delivery.
   544	  # The absence of a LINK row is not a match — it is the absence of evidence.
   545	  if [ "$_ov_ltype" = "symlink" ]; then
   546	    if [ "$_ov_prior" = "link_match" ]; then printf 'PRESERVE_OWNED LINK_RECORD'
   547	    else _ov_unowned; fi
   548	    return 0
   549	  fi
   550	

