  1768	    assert writer.exists(), "SHA256SUMS.txt names a writer that is not there"
  1769	    writer_body = writer.read_text(encoding="utf-8")
  1770	    assert "sha256sum" in writer_body or "shasum -a 256" in writer_body, (
