  2150	def test_documented_npm_signature_recipe_matches_what_npm_audits():
  2151	    """Every documented `npm audit signatures` has to be reachable by npm.
  2152	
  2153	    A recipe offends when its unit pairs the command with an install npm cannot
  2154	    audit, passes a positional npm ignores, or passes `--global`, which npm
  2155	    rejects. Naming `EAUDITGLOBAL` in the unit is the tolerance: a document is
  2156	    free — and encouraged — to put the global install next to the command in
  2157	    order to say that the command does NOT reach it."""
  2158	    offenders: List[str] = []
  2159	    units_examined = 0
  2160	    for path in _live_doc_surfaces():
  2161	        rel = path.relative_to(REPO_ROOT).as_posix()
  2162	        text = path.read_text(encoding="utf-8")
  2163	        if not _AUDIT_SIGNATURES.search(text):
  2164	            continue
  2165	        for label, unit in _recipe_units(text):
  2166	            if not _AUDIT_SIGNATURES.search(unit):
  2167	                continue
  2168	            units_examined += 1
  2169	            faults = []
  2170	            if _UNAUDITABLE_INSTALL.search(unit) and "EAUDITGLOBAL" not in unit:
  2171	                faults.append(
  2172	                    "pairs the audit with an install npm cannot audit "
  2173	                    "(global, or exec/npx leaving no dependency behind)"
  2174	                )
  2175	            positional = _AUDIT_POSITIONAL.search(unit)
  2176	            if positional:
  2177	                faults.append(
  2178	                    "passes the positional %r, which npm ignores — the audit "
  2179	                    "still reads the current project" % positional.group(1)
  2180	                )
  2181	            if _AUDIT_GLOBAL_FLAG.search(unit):
  2182	                faults.append("passes --global, which npm rejects (EAUDITGLOBAL)")
  2183	            if faults:
  2184	                offenders.append(
  2185	                    "%s %s: %s\n    %s"
  2186	                    % (rel, label, "; ".join(faults), unit.strip()[:160])
  2187	                )
  2188	
  2189	    # Vacuity guard: the sweep is worthless if it found no recipe to judge.
  2190	    assert units_examined >= 5, (
  2191	        "only %d recipe units examined — the sweep lost sight of the docs it "
  2192	        "exists to watch" % units_examined
  2193	    )
  2194	    assert not offenders, (
  2195	        "documented `npm audit signatures` recipes do not audit what the "
  2196	        "reader installed:\n%s" % "\n\n".join(offenders)
  2197	    )
