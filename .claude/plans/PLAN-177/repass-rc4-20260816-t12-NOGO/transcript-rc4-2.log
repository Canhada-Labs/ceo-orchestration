  1455	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1680	    excluded from the package `files:` array, and no workflow materialises a
  1681	    `.tgz` to hash — so the consumer recipe this file used to publish was
  1682	    impossible, and is REMOVED rather than caveated."""
  1683	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1684	    header = doc.split("## Contract", 1)[0]
  1685	    assert "no** per-tarball" in header or "no per-tarball" in header, (
  1686	        "header no longer states that the tarball checksum is absent"
  1687	    )
  1688	    assert "scripts/install-npm.sh" in doc, (
  1689	        "the doc does not attribute SHA256SUMS.txt to its real, local writer"
  1690	    )
  1691	    assert "sha256sum -c SHA256SUMS.txt" not in doc, (
  1692	        "the impossible consumer recipe is back — it cannot run, because "
  1693	        "SHA256SUMS.txt is not inside the published package"
