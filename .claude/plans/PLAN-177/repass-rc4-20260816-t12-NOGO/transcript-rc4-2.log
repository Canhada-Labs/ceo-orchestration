  1783	# PLAN-177 W0.3 delta (codex P1-4 of the v4 round) — the generic sweep.
  1784	#
  1785	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1786	# checksum gate anchors three named phantom referents. A NEW enforcement
  1787	# promise, about some other subject, written into a section nobody watches,
  1788	# passes all of them. The original defect is the proof that this is not
  1789	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1790	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1791	#
  1792	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1793	# Contract table row (machine-checked by
  1794	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1795	# to the table's un-enforced rows by
  1796	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1797	# Anywhere else it is answerable to nothing, and is a red.
  1798	#
  1799	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1800	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1801	#
  1802	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1803	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1804	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1805	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1806	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1807	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1808	#     at the table rather than enumerating mechanisms, and the tag-signing
  1809	#     paragraph cites SECURITY.md as the authority instead of restating the
  1810	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1811	#     needs no exemption, so it has none.
  1812	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1813	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1814	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1815	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1816	#     are the file speaking about what the pipeline does.
  1817	#     A broad list that has to be switched off is worth less than a narrow
  1818	#     one that stays on.
  1819	#
  1820	# Matching is on word boundaries after normalization. Substring matching was
  1821	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1822	# substring-vs-exact class, for the fourth time in this plan.
  1823	_ENFORCEMENT_VOCAB = (
  1824	    "enforced today",
  1825	    "is enforced",
  1826	    "are enforced",
  1827	    "enforced by",
  1828	    "enforced at",
  1829	    "every tag publish",
  1830	    "recorded by",
  1831	    "is verified",
  1832	    "are verified",
  1833	    "verifies",
  1834	    "must satisfy",
  1835	    "guarantees",
  1836	    "is guaranteed",
  1837	    "are guaranteed",
  1838	    "asserted by",
  1839	    "checked by",
  1840	    "gated by",
  1841	    "fails closed",
  1842	    "fail closes",
  1843	    "asserts",
  1844	    "ensures",
  1845	    "is signed",
  2250	# PLAN-177 W0.1 (P1-4) -- the pair-rail DECISION gate
  2251	# ===========================================================================
  2252	# The re-pass of 2026-08-12 found that BOTH release rails read the verdict
  2253	# envelope for pinning, TTL, anchor and delta, and NEITHER read the decision:
  2254	# a cross-model NO-GO returned "OK: verdict ... valid" / exit 0 from the
  2255	# server-side validator, release-gate went green, and only the Owner running
  2256	# OWNER-GA-CUT.sh stood between a negative review and an irreversible publish.
  2257	#
  2258	# CF-3 asymmetry, restated here because it decides what each control PROVES:
  2259	# step 15 carries continue-on-error under CEO_PAIR_RAIL_VERDICT_OPTIONAL=1, so
  2260	# the validator control is a UNIT control over defence in depth; the control
  2261	# that stands for enforcement in every mode is the tag-guard one below.
  2262	_VALIDATOR_INPUTS_HASH_CACHE = {}
  2263	
  2264	# Anchors on the DIAGNOSTIC, not just the exit code: a gate that fires for the
  2265	# wrong reason is a dead probe wearing a green badge (S-lesson: a control that
  2266	# cannot fail proves nothing).
  2267	_ACCEPTED_SET_TEXT = "{GO, GO-WITH-CONDITIONS}"
  2268	_DECISION_REFUSED = "not in " + _ACCEPTED_SET_TEXT
  2269	_CI_DUPLICATE_DIAGNOSTIC = "verdict decision declared more than once"
