  1728	    assert "Generated by `.github/workflows/npm-publish.yml`" not in sums
  1729	
  1730	    # PLAN-177 t2 (re-pass rc.4 P2-c): the REGENERATION RECIPE must be able to
  1731	    # regenerate. The recipe this file shipped extracted `npm pack --json`'s
  1732	    # `.shasum`, which is npm's legacy SHA-1 and carries no filename -- it
  1733	    # produces neither the algorithm nor the `<sha256>  <name>` format of the
  1734	    # lines below, and under `--dry-run` there is no tarball to hash at all.
  1735	    # An operator following it would have written invalid evidence.
  1736	    #
  1737	    # Command lines are the ones indented as a block (`#` + 3 spaces); prose
  1738	    # that NAMES the rejected recipe is deliberately left readable, so the
  1739	    # gate reads commands, not the whole file.
