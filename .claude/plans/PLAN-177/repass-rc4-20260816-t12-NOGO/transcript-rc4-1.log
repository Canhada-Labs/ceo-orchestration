   796	def main(argv: Optional[Sequence[str]] = None) -> int:
   797	    parser = argparse.ArgumentParser(prog="_release_tag_guard.py")
   798	    sub = parser.add_subparsers(dest="cmd")
   799	
   800	    p_anc = sub.add_parser("ancestry", help="HEAD must be on origin/<branch>")
   801	    p_anc.add_argument("--repo", default=".")
   802	    p_anc.add_argument("--remote", default="origin")
   803	    p_anc.add_argument("--branch", default="main")
   804	    p_anc.add_argument(
   805	        "--offline-ack",
   806	        action="store_true",
   807	        help="named escape hatch: skip the fetch and judge against the "
   808	        "last-known remote ref (loudly announced)",
   809	    )
   810	
   811	    p_delta = sub.add_parser("delta", help="restricted delta vs the verdict")
   812	    p_delta.add_argument("--repo", default=".")
   813	    p_delta.add_argument("--tag", required=True)
   814	    p_delta.add_argument("--verdict", default=None)
   815	
   816	    args = parser.parse_args(argv)
   817	    if args.cmd == "ancestry":
   818	        return ancestry(args.repo, args.remote, args.branch, args.offline_ack)
   819	    if args.cmd == "delta":
   820	        return delta(args.repo, args.tag, args.verdict)
   821	    parser.print_usage(sys.stderr)
   822	    return E_USAGE
   823	
   824	
   825	if __name__ == "__main__":
   826	    sys.exit(main())

