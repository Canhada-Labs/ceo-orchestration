   156	def _fail(code: int, msg: str) -> int:
   157	    # Flush the ok-lines first: an operator reading a release failure must see
   158	    # WHICH checks passed before the one that stopped it, in order.
   159	    sys.stdout.flush()
   160	    print("FAIL: %s" % msg, file=sys.stderr)
   161	    sys.stderr.flush()
   162	    return code
