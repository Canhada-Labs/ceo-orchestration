   100	def _run(args, verdict_text: str):
   101	    """Run validator on a tmpdir-scoped verdict file. Returns CompletedProcess."""
   102	    with tempfile.TemporaryDirectory() as td:
   103	        verdict_path = Path(td) / "verdict.md"
   104	        verdict_path.write_text(verdict_text, encoding="utf-8")
   105	        cmd = [
   106	            sys.executable, str(SCRIPT),
   107	            "--verdict-file", str(verdict_path),
   108	            *args,
   109	        ]
   110	        return subprocess.run(cmd, capture_output=True, text=True, timeout=30)
