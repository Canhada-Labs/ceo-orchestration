    44	
    45	`parent_sha:` solves it cleanly. The verdict declares the commit it was
    46	generated AGAINST (the parent of the verdict-file commit). That value is
    47	known when the verdict is authored (it's `git rev-parse HEAD` before the
    48	verdict commit). Step 15 validates against `git log -n1 --format=%H --
    49	<verdict-file>` parent, which is observable + immutable.
    50	
    51	Backward-compat: when only `commit_sha:` (legacy) is present and
    52	`--parent-sha` is empty, the bind is skipped with an ADVISORY (matches
    53	prior CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 behavior). Legacy verdicts for
    54	already-shipped tags (v1.16.0 etc.) keep their existing semantics; new
    55	verdicts use `parent_sha:`.
    56	
    57	## Exit codes
    58	
    59	- 0: verdict valid; release proceeds.
    60	- 1: infra error (file missing / unparseable / etc.); release.yml
    61	     decides based on CEO_PAIR_RAIL_VERDICT_OPTIONAL.
    62	- 2: VERDICT_EXPIRED — distinct from infra-error per R1 S-QA-Unseen-2.
    63	     Release.yml can route this to a "verdict regen" branch.
    64	- 3: VERDICT_INVALID — decision not authorizing (PLAN-177 W0.1) /
    65	     non-canonical top-level key syntax, i.e. a spelling this reader and
    66	     the local tag guard resolve differently (PLAN-177 t2) /
    67	     release_tag mismatch / parent_sha mismatch / inputs_hash mismatch /
    68	     pin mismatch / signature missing. Release MUST stop here.
    69	
    70	stdlib only. Python ≥3.9.
    71	"""
    72	
    73	from __future__ import annotations
    74	
    75	import argparse
    76	import hashlib
    77	import json
    78	import re
    79	import subprocess
    80	import sys
    81	from datetime import datetime, timezone
    82	from pathlib import Path
    83	from typing import Any, Dict, List, Optional, Tuple
    84	
    85	EXIT_OK = 0
    86	EXIT_INFRA_ERROR = 1
    87	EXIT_VERDICT_EXPIRED = 2
    88	EXIT_VERDICT_INVALID = 3
    89	
    90	# PLAN-177 W0.1 (P1-4). The decisions that AUTHORIZE a release. Every other
    91	# value — NO-GO, absent, empty, malformed, or simply unknown — is
    92	# non-authorizing and stops the release. Spelling is the template's
    93	# (.claude/governance/pair-rail-verdict-template.md:
    94	# `verdict: GO | NO-GO | GO-WITH-CONDITIONS`); membership is tested by EXACT
    95	# equality on purpose — case folding or a substring/prefix rule would read
    96	# NO-GO as authorizing because it CONTAINS GO.
    97	ACCEPTED_DECISIONS = ("GO", "GO-WITH-CONDITIONS")
    98	
    99	
   100	# t8 P1 (root cause below the finding): Python \s is Unicode-aware, so
   101	# `\s*` after the fence opener SWALLOWED a leading U+00A0 line before
   102	# the shape classifier ever saw it. ASCII-only here, like every other
   103	# trim in this reader.
   104	_YAML_BLOCK_RE = re.compile(r"```yaml[ \t]*\n(.*?)```", re.DOTALL)  # legacy: superseded by _extract_single_yaml_block below
   105	
   106	# t9 P1 (both twins): ONE strict extractor for the signed yaml block.
   107	#   * the artifact must contain EXACTLY ONE occurrence of the literal
   108	#     ```yaml anywhere in the text — a second occurrence (even quoted
   109	#     inside a four-backtick block) makes the authoritative block
   110	#     ambiguous, so the artifact is rejected fail-closed;
   111	#   * the opener must sit at line start, column 0, exactly three
   112	#     backticks, closed by a line-start ``` — an unanchored search let a
   113	#     quoted GO envelope inside a ````-fence shadow the real NO-GO one;
   114	#   * the block must be free of every line separator except \n and of
   115	#     every control char except \t: str.splitlines() also splits on
   116	#     U+000B/000C/001C-001E/0085/2028/2029, so `GO<U+000B>#NO-GO`
   117	#     parsed as the exact token GO on both rails (t9 P1 #2). CR included:
   118	#     the generator only ever emits LF.
   119	# Returns the block body, or None when the artifact is rejected.
   120	_FORBIDDEN_CTRL_RE = re.compile(
   121	    "[\u0000-\u0008\u000b-\u001f\u007f\u0085\u2028\u2029]"
   122	)
   123	
   124	
   125	def _extract_single_yaml_block(text):
   126	    if text.count("```yaml") != 1:
   127	        return None
   128	    # t10 P1: the CLOSER must be canonical too — a bare ^``` matched
   129	    # ANY line starting with three backticks, so ```not-a-closer
   130	    # closed the body early and hid a later NO-GO.
   131	    m = re.search(
   132	        r"(?m)^```yaml[ \t]*\n(.*?)^```[ \t]*(?:\n|\Z)",
   133	        text,
   134	        re.DOTALL,
   135	    )
   136	    if not m:
   137	        return None
   138	    body = m.group(1)
   139	    if _FORBIDDEN_CTRL_RE.search(body):
   140	        return None
   141	    return body
   142	
   143	
   144	
   145	def _strip_comment(raw: str) -> str:
   146	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   147	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   148	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Truncating
   149	    at every `#` authorized that value on both rails. Byte-for-byte twin of
   150	    `_strip_yaml_comment` in _release_tag_guard.py.
   151	    """
   152	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   153	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   154	    if raw.lstrip(" \t").startswith("#"):
   155	        return ""
   156	    i = 0
   157	    while True:
   158	        j = raw.find("#", i)
   159	        if j == -1:
   160	            return raw.rstrip(" \t")
   161	        if j > 0 and raw[j - 1] in (" ", "\t"):
   162	            return raw[:j].rstrip(" \t")
   163	        i = j + 1
   164	
   165	
   166	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   167	# Two readers of the same signed file must not disagree about what a key
   168	# IS: this validator counted `verdict : NO-GO` as a declaration of
   169	# `verdict` (it strips the key), while the local tag guard's regex demanded
   170	# the colon immediately after the name and skipped the line entirely. The
   171	# valid-YAML pair
   172	#
   173	#     verdict : NO-GO
   174	#     verdict: GO
   175	#
   176	# is therefore two declarations here and ONE (=GO) there — a last-wins
   177	# override that the rail enforcing in every mode never saw.
   178	#
   179	# The semantics chosen for BOTH rails, and the reason: NON-CANONICAL
   180	# top-level syntax is REJECTED, fail-closed. Trimming the key in both
   181	# readers would also close the divergence, but it widens the grammar of a
   182	# SIGNED artifact to shapes no author writes and no template emits — every
   183	# new accepted spelling is another chance for the next reader to disagree.
   184	# Refusing the shape is a smaller surface and is the one behaviour that
   185	# cannot silently prefer a value. A top-level line is canonical iff it is
   186	# `name:` with no whitespace before the colon; list items are legal
   187	# ONLY indented under an active bare key (t8 P2: a root `- item` is
   188	# rejected — the old comment said otherwise and misled operators).
   189	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   190	
   191	
   192	def noncanonical_top_level_lines(text: str) -> List[str]:
   193	    """Top-level lines of the yaml block that are not canonical declarations.
   194	
   195	    Byte-for-byte twin of `_noncanonical_top_level_lines` in
   196	    `.claude/scripts/local/_release_tag_guard.py` (separate processes on
   197	    separate machines; neither may import the other — keep them identical).
   198	    Empty list == the block speaks the grammar both readers assume.
   199	    """
   200	    body = _extract_single_yaml_block(text)
   201	    if body is None:
   202	        # Ambiguous/absent/forbidden-bytes block: the artifact as a WHOLE
   203	        # is noncanonical — surface a synthetic offender so every caller
   204	        # that gates on "empty == canonical" fails closed.
   205	        return ["<yaml block rejected: ambiguous fence, bad opener, or "
   206	                "forbidden control/separator bytes>"]
   207	    bad: List[str] = []
   208	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   209	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   210	    # Both None (before any key) and "scalar" reject — an orphan-indented
   211	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   212	    # through the prev_scalar_decl=False initial state and resolved as GO,
   213	    # and a root-level `- item` is malformed for this signed format (its
   214	    # only lists are INDENTED under a bare key) yet was accepted outright.
   215	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   216	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   217	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   218	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   219	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   220	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   221	    # reopening the orphan-indentation class through the whitespace side.
   222	    parent = None  # None | "scalar" | "bare"
   223	    for raw in body.split("\n"):
   224	        line = _strip_comment(raw)
   225	        if not line.strip(" \t"):
   226	            continue
   227	        if line[0] in (" ", "\t"):
   228	            if parent != "bare":
   229	                bad.append(line)
   230	            continue
   231	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   232	            _key, _, _val = line.partition(":")
   233	            parent = "scalar" if _val.strip(" \t") else "bare"
   234	            continue
   235	        bad.append(line)
   236	        parent = None
   237	    return bad
   238	
   239	
   240	def count_top_level_key(text: str, key: str) -> int:
   241	    """How many times `key:` is declared at the top level of the block.
   242	
   243	    Both readers of this signed file are LAST-WINS, so a second
   244	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   245	    as GO. Callers require exactly one.
   246	
   247	    Only meaningful once `noncanonical_top_level_lines` is empty: this
   248	    counter strips the key, so it sees `verdict : X` as a declaration and
   249	    the twin counter in the tag guard does not. Callers run the shape
   250	    check FIRST.
   251	    """
   252	    _body = _extract_single_yaml_block(text)
   253	    if _body is None:
   254	        return 0
   255	    seen = 0
   256	    for raw in _body.split("\n"):
   257	        line = _strip_comment(raw)
   258	        if not line.strip() or line[0] in (" ", "\t"):
   259	            continue
   260	        if line.partition(":")[0].strip() == key:
   261	            seen += 1
   262	    return seen
   263	
   264	
   265	def parse_verdict_text(text: str) -> Dict[str, Any]:
   266	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   267	    yaml_body = _extract_single_yaml_block(text)
   268	    if yaml_body is None:
   269	        raise ValueError(
   270	            "verdict yaml block rejected: absent, ambiguous fence, or "
   271	            "forbidden control/separator bytes"
   272	        )
   273	    # Inline minimal YAML parse (stdlib only)
   274	    out: Dict[str, Any] = {}
   275	    current_key: Optional[str] = None
   276	    for raw in yaml_body.split("\n"):
   277	        line = _strip_comment(raw)
   278	        if not line.strip():
   279	            continue
   280	        if line[0] not in (" ", "\t"):
   281	            if ":" in line:
   282	                k, _, v = line.partition(":")
   283	                # ASCII-only value trim (t5 P1): a Unicode strip() would
   284	                # normalize `GO<U+00A0>` into the exact authorizing token.
   285	                v = v.strip(" \t")
   286	                if v:
   287	                    out[k.strip(" \t")] = v
   288	                else:
   289	                    out[k.strip(" \t")] = {}
   290	                    current_key = k.strip(" \t")
   291	        elif current_key and ":" in line:
   292	            sub_k, _, sub_v = line.partition(":")
   293	            if isinstance(out[current_key], dict):
   294	                out[current_key][sub_k.strip(" \t")] = sub_v.strip(" \t")
   295	    return out
   296	
   297	
   298	def parse_verdict_file(path: Path) -> Dict[str, Any]:
   299	    """Path wrapper over parse_verdict_text (published entry point)."""
   300	    if not path.exists():
   301	        raise FileNotFoundError(f"verdict file: {path}")
   302	    # t10 P2: raw bytes, NO universal-newline translation — read_text()
   303	    # silently ate the CR that the grammar promises to reject.
   304	    return parse_verdict_text(path.read_bytes().decode("utf-8"))
   305	
   306	
   307	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   308	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   309	    if not manifest_path.exists():
   310	        raise FileNotFoundError(f"manifest: {manifest_path}")
   311	    paths = []
   312	    for line in manifest_path.read_text().splitlines():
   313	        line = line.split("#", 1)[0].strip()
   314	        if line:
   315	            paths.append(line)
   316	    paths.sort()
   317	    hashes = {}
   318	    for p in paths:
   319	        result = subprocess.run(
   320	            ["git", "hash-object", p],
   321	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   322	        )
   323	        if result.returncode != 0:
   324	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   325	        hashes[p] = result.stdout.strip()
   326	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   327	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   328	
   329	
   330	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   331	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   332	    if not pin_file.exists():
   333	        return None, None
   334	    for line in pin_file.read_text().splitlines():
   335	        line = line.split("#", 1)[0].strip()
   336	        if not line:
   337	            continue
   338	        # parse `>=X.Y.Z,<A.B.C` shape
   339	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   340	        if m:
   341	            return m.group(1), m.group(2)
   342	    return None, None
   343	
   344	
   345	def parse_semver(s: str) -> Tuple[int, int, int]:
   346	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   347	    if not m:
   348	        raise ValueError(f"unparseable semver: {s!r}")
   349	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   350	
   351	
   352	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   353	    try:
   354	        v = parse_semver(version)
   355	        lo = parse_semver(min_v)
   356	        hi = parse_semver(max_v)
   357	        return lo <= v < hi
   358	    except ValueError:
   359	        return False
   360	
   361	
   362	def main(argv: Optional[List[str]] = None) -> int:
   363	    parser = argparse.ArgumentParser()
   364	    parser.add_argument("--verdict-file", required=True)
   365	    parser.add_argument(
   366	        "--parent-sha",
   367	        default="",
   368	        help=(
   369	            "Expected verdict.parent_sha — the commit the verdict was "
   370	            "generated against (parent of the verdict-file commit). "
   371	            "Resolves the self-reference problem the legacy --commit-sha "
   372	            "bind had with PLAN-081 v1.16.0 GA. Empty string = skip bind."
   373	        ),
   374	    )
   375	    parser.add_argument(
   376	        "--commit-sha",
   377	        default="",
   378	        help=(
   379	            "DEPRECATED legacy bind. Retained for backward-compat with "
   380	            "v1.16.0-era verdicts that ship `commit_sha:` field. "
   381	            "Mutually exclusive with --parent-sha; if both passed, "
   382	            "--parent-sha wins."
   383	        ),
   384	    )
   385	    parser.add_argument("--release-tag", required=True)
   386	    parser.add_argument("--max-age-hours", type=int, default=24)
   387	    parser.add_argument("--recompute-inputs-hash", action="store_true")
   388	    parser.add_argument("--codex-cli-pin-file", default="")
   389	    parser.add_argument("--codex-cli-binary-sha256-file", default="")
   390	    parser.add_argument(
   391	        "--codex-pin-manifest-file",
   392	        default="",
   393	        help=(
   394	            "ADR-182 payload-pin manifest (codex-cli-pin-manifest.json). "
   395	            "When passed, verdict.tool_versions.codex_target_triple + "
   396	            ".codex_payload_sha256 MUST match the manifest entry "
   397	            "(fail-CLOSED — VERDICT_INVALID on any miss)."
   398	        ),
   399	    )
   400	    parser.add_argument("--inputs-hash-paths-file", default="")
   401	    args = parser.parse_args(argv)
   402	
   403	    verdict_path = Path(args.verdict_file)
   404	    repo_root = Path.cwd()
   405	
   406	    # Parse verdict. The TEXT is kept: the duplicate-key check below reads
   407	    # the same bytes the parse consumed (a second read could disagree).
   408	    try:
   409	        verdict_text = verdict_path.read_bytes().decode("utf-8")  # t10 P2: raw, keep CR
   410	        verdict = parse_verdict_text(verdict_text)
   411	    except FileNotFoundError as e:
   412	        print(f"INFRA: verdict file not found: {e}", file=sys.stderr)
   413	        return EXIT_INFRA_ERROR
   414	    except OSError as e:
   415	        print(f"INFRA: verdict file unreadable: {e}", file=sys.stderr)
   416	        return EXIT_INFRA_ERROR
   417	    except UnicodeDecodeError as e:
   418	        # t10 P2: non-UTF-8 SIGNED CONTENT is input-invalid, not infra.
   419	        print(f"INVALID: verdict is not UTF-8: {e}", file=sys.stderr)
   420	        return EXIT_VERDICT_INVALID
   421	    except ValueError as e:
   422	        # t10 P2: a parse rejection of SIGNED CONTENT (absent/ambiguous
   423	        # fence, forbidden bytes) is the promised input-invalid exit 3 —
   424	        # routing it through INFRA let CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   425	        # soften a rejection the contract says must stop the release.
   426	        print(f"INVALID: verdict content rejected: {e}", file=sys.stderr)
   427	        return EXIT_VERDICT_INVALID
   428	
   429	    # PLAN-177 W0.1 (P1-4): the DECISION gate. Until this block existed
   430	    # the validator read pinning, TTL and signature presence but never the
   431	    # verdict itself: a cross-model NO-GO returned OK / exit 0.
   432	    #
   433	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on):
   434	    # this step carries `continue-on-error` when
   435	    # CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 (release.yml:689), so the gate HERE
   436	    # is defence in depth; the rail that enforces in EVERY mode is
   437	    # `.claude/scripts/local/_release_tag_guard.py delta`, invoked by a
   438	    # step with no escape hatch. Neither may be dropped for the other.
   439	    #
   440	    # Fail-CLOSED on SHAPE as well as value (CF-1): the reader above
   441	    # returns a dict for an empty `verdict:` line, so the type check
   442	    # precedes the compare and a malformed decision exits 3 (INVALID),
   443	    # never 1 (INFRA) -- which the transition mode is allowed to wave
   444	    # through. Same precedent as the tool_versions dict check below.
   445	    # PLAN-177 t2 (P1-a): SHAPE BEFORE VALUE. The counter below and the tag
   446	    # guard's counter only agree on a canonical block; a non-canonical
   447	    # top-level line is refused here rather than parsed by two grammars.
   448	    # INVALID (3), never INFRA (1): the transition mode may wave INFRA
   449	    # through, and this is a property of the SIGNED bytes, not of the runner.
   450	    noncanonical = noncanonical_top_level_lines(verdict_text)
   451	    if noncanonical:
   452	        print(
   453	            f"INVALID: non-canonical top-level key syntax in the verdict "
   454	            f"block: {noncanonical!r} -- a top-level line must be `name:` "
   455	            f"with no whitespace before the colon; list items only INDENTED "
   456	            f"under a bare key, never at the root. "
   457	            f"The two release rails read this file with different "
   458	            f"grammars, so `verdict : NO-GO` followed by `verdict: GO` "
   459	            f"counts as two declarations here and one there; the shape is "
   460	            f"refused instead of guessed.",
   461	            file=sys.stderr,
   462	        )
   463	        return EXIT_VERDICT_INVALID
   464	
   465	    decisions_declared = count_top_level_key(verdict_text, "verdict")
   466	    if decisions_declared > 1:
   467	        print(
   468	            f"INVALID: verdict decision declared more than once "
   469	            f"(x{decisions_declared}) -- the reader is last-wins, so a "
   470	            f"duplicated `verdict:` silently overrides the first; exactly "
   471	            f"one is required.",
   472	            file=sys.stderr,
   473	        )
   474	        return EXIT_VERDICT_INVALID
   475	    raw_decision = verdict.get("verdict")
   476	    if raw_decision is None:
   477	        shown = "<absent>"
   478	    elif not isinstance(raw_decision, str):
   479	        shown = "<non-string:%s>" % type(raw_decision).__name__
   480	    else:
   481	        # ASCII-only trim (t5 P1): `GO<U+00A0>` must FAIL the exact-token
   482	        # membership below, never be normalized into `GO`.
   483	        shown = raw_decision.strip(" \t")
   484	    if shown not in ACCEPTED_DECISIONS:
   485	        accepted = "{%s}" % ", ".join(ACCEPTED_DECISIONS)
   486	        print(
   487	            f"INVALID: verdict decision '{shown}' not in {accepted} -- a "
   488	            f"release requires an explicit authorizing decision from the "
   489	            f"pair-rail. Exact match: no case folding, no substring rule "
   490	            f"(NO-GO contains GO).",
   491	            file=sys.stderr,
   492	        )
   493	        return EXIT_VERDICT_INVALID
   494	
   495	    # R1 S-Sec-3: release_tag bind
   496	    declared_tag = verdict.get("release_tag", "").strip()
   497	    if declared_tag != args.release_tag:
   498	        print(
   499	            f"INVALID: verdict release_tag mismatch — "
   500	            f"declared='{declared_tag}', argv='{args.release_tag}'",
   501	            file=sys.stderr,
   502	        )
   503	        return EXIT_VERDICT_INVALID
   504	
   505	    # parent_sha / commit_sha bind (S104 redesign — see docstring).
   506	    # Precedence: --parent-sha (canonical, post-S104) wins. Falls back to
   507	    # legacy --commit-sha for v1.16.0-era verdicts that still ship the old
   508	    # field.
   509	    if args.parent_sha:
   510	        declared_parent = verdict.get("parent_sha", "").strip()
   511	        if not declared_parent:
   512	            # New-style validation requested but verdict lacks the field.
   513	            # Could be a stale verdict generated before the redesign. Fall
   514	            # back to legacy commit_sha if available; else hard-fail.
   515	            legacy_sha = verdict.get("commit_sha", "").strip()
