   171	class TestNonCanonicalTopLevelKeySyntax(unittest.TestCase):
   172	    """PLAN-177 t2 (re-pass rc.4 P1-a) — one grammar for both release rails.
   173	
   174	    `verdict : NO-GO` is valid YAML and last-wins under a real parser. THIS
   175	    validator strips the key, so it saw two declarations; the local tag guard
   176	    (`.claude/scripts/local/_release_tag_guard.py`, the rail with no escape
   177	    hatch) required the colon immediately after the name, saw ONE, and parsed
   178	    the following `verdict: GO`. Cured semantics, identical in both files:
   179	    non-canonical top-level syntax is REFUSED — exit 3, never 1, so the
   180	    transition mode cannot wave it through.
   181	    """
   182	
   183	    PARENT = "abcdef0123456789abcdef0123456789abcdef01"
   184	    DIAGNOSTIC = "non-canonical top-level key syntax"
   185	
   186	    def _run_decisions(self, decision_lines):
   187	        v = _make_verdict(
   188	            decision_lines=decision_lines,
   189	            parent_sha=self.PARENT,
   190	            release_tag="v1.99.0",
   191	        )
   192	        return _run(
   193	            ["--parent-sha", self.PARENT, "--release-tag", "v1.99.0"], v
   194	        )
   195	
   196	    def test_space_before_colon_duplicate_is_refused(self):
   197	        r = self._run_decisions(["verdict : NO-GO", "verdict: GO"])
   198	        self.assertEqual(r.returncode, EXIT_VERDICT_INVALID, msg=r.stderr)
   199	        self.assertIn(self.DIAGNOSTIC, r.stderr)
   200	        self.assertNotIn("Traceback", r.stderr)
   201	
   202	    def test_tab_before_colon_duplicate_is_refused(self):
   203	        r = self._run_decisions(["verdict\t: NO-GO", "verdict: GO"])
   204	        self.assertEqual(r.returncode, EXIT_VERDICT_INVALID, msg=r.stderr)
   205	        self.assertIn(self.DIAGNOSTIC, r.stderr)
   206	
   207	    def test_single_noncanonical_key_is_refused(self):
   208	        """Not only the duplicate shape: a lone `verdict : GO` is a spelling
   209	        the two readers disagree about, so it is refused rather than read."""
   210	        for line in ("verdict : GO", "verdict\t: GO"):
   211	            r = self._run_decisions([line])
   212	            self.assertEqual(r.returncode, EXIT_VERDICT_INVALID, msg=r.stderr)
   213	            self.assertIn(self.DIAGNOSTIC, r.stderr)
   214	            self.assertNotEqual(r.returncode, EXIT_INFRA_ERROR)
   215	
   216	    def test_canonical_envelope_is_untouched_by_the_shape_gate(self):
   217	        """The control that keeps the gate from being a blanket refusal."""
   218	        r = self._run_decisions(["verdict: GO"])
   219	        self.assertEqual(r.returncode, EXIT_OK, msg=r.stderr)
   220	        self.assertNotIn(self.DIAGNOSTIC, r.stderr)
   221	
   222	    def test_list_items_and_sub_keys_stay_canonical(self):
   223	        """delta_allowlist entries and `tool_versions:` children are the two
   224	        non-`name:` shapes a real envelope carries — neither may trip it."""
   225	        v = _make_verdict(
   226	            decision_lines=[
   227	                "verdict: GO",
   228	                "delta_allowlist:",
   229	                "  - .claude/governance/pair-rail-verdict-v1.99.0.md",
   230	            ],
   231	            parent_sha=self.PARENT,
   232	            release_tag="v1.99.0",
   233	        )
   234	        r = _run(
   235	            ["--parent-sha", self.PARENT, "--release-tag", "v1.99.0"], v
   236	        )
   237	        self.assertEqual(r.returncode, EXIT_OK, msg=r.stderr)
   238	        self.assertNotIn(self.DIAGNOSTIC, r.stderr)
