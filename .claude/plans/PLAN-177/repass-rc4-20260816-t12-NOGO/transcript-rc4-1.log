   221	SNAPSHOT_ARMED=0
   222	restore_snapshot() {
   223	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   224	  # The bump phase refuses to run on a dirty tree (untracked included), so
   225	  # HEAD is exactly the pre-bump state: reset unstages, checkout restores
   226	  # content. Both halves are needed — an index-only restore leaves the files
   227	  # modified, and a content-only restore leaves them staged (the S273 trap).
   228	  #
   229	  # PER PATH, never one multi-path command: `git checkout -- a b c` is
   230	  # ATOMIC — a single path absent from HEAD (a file the bump CREATED, e.g. a
   231	  # plugin manifest on its first appearance) aborts the WHOLE command and
   232	  # restores nothing, and the old `|| true` swallowed that error while the
   233	  # message below still claimed success. A path HEAD carries is checked out;
   234	  # a path HEAD does not carry was created by the bump and is removed.
   235	  local _p _dirty
   236	  for _p in "${VERSION_FILES[@]}"; do
   237	    git reset --quiet HEAD -- "$_p" 2>/dev/null || true
   238	    if git cat-file -e "HEAD:$_p" 2>/dev/null; then
   239	      git checkout --quiet -- "$_p" 2>/dev/null || true
   240	    else
   241	      rm -f "$_p" 2>/dev/null || true
   242	      # a directory created for that file may remain; drop it only if empty
   243	      # (never recursive — this is a restore, not a cleanup)
   244	      rmdir "$(dirname "$_p")" 2>/dev/null || true
   245	    fi
   246	  done
