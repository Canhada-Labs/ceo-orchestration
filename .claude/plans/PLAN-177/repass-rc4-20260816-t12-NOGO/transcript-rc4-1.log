   165	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   166	    proc = subprocess.run(
   167	        ["git"] + list(args),
   168	        cwd=repo,
   169	        stdout=subprocess.PIPE,
   170	        stderr=subprocess.PIPE,
   171	        universal_newlines=True,
   172	    )
   173	    return proc.returncode, proc.stdout, proc.stderr
