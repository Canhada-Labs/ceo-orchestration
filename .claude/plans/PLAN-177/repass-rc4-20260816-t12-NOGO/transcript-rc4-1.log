.claude/scripts/local/release.sh-613-#
.claude/scripts/local/release.sh-614-# THE LOCAL ASSERT IS NOT ENOUGH — say it out loud. A tag signed by hand skips
.claude/scripts/local/release.sh-615-# this driver entirely, and the pair-rail step 15 recomputes inputs_hash only
.claude/scripts/local/release.sh-616-# over `pair-rail-inputs-hash-manifest.txt`, which deliberately EXCLUDES the
.claude/scripts/local/release.sh-617-# bump surfaces (including them would make every legitimate bump change the
.claude/scripts/local/release.sh-618-# inputs_hash and break the verdict replay). The same restricted-delta assert
.claude/scripts/local/release.sh-619-# therefore goes SERVER-SIDE into `.github/workflows/release.yml` in PLAN-166
.claude/scripts/local/release.sh-620-# W1. release.yml is canonical: it changes under the GPG ceremony, not here.
.claude/scripts/local/release.sh:621:# `_release_tag_guard.py` is the reference implementation for both.
.claude/scripts/local/release.sh-622-# ---------------------------------------------------------------------------
.claude/scripts/local/release.sh-623-tag() {
.claude/scripts/local/release.sh-624-  hdr "sign tag $TARGET_TAG"
.claude/scripts/local/release.sh-625-  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to tag"
.claude/scripts/local/release.sh-626-
.claude/scripts/local/release.sh-627-  # VERSION carries the BARE semver even for an RC tag (see the bump header),
.claude/scripts/local/release.sh-628-  # so compare against $TARGET_BASE, never $TARGET_VERSION.
.claude/scripts/local/release.sh-629-  cur_version="$(tr -d ' \n' < VERSION)"
.claude/scripts/local/release.sh-630-  [ "$cur_version" = "$TARGET_BASE" ] \
.claude/scripts/local/release.sh-631-    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
