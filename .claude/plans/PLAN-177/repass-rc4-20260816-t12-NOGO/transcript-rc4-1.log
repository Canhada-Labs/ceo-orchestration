   284	# ---------------------------------------------------------------------------
   285	# Preflight — every gate fail-closed. Mirrors `.github/release-checklist.md`
   286	# and runs the SAME suites CI runs (a subset gate passes while CI is red; that
   287	# lesson is expensive and already paid).
   288	# ---------------------------------------------------------------------------
   289	preflight() {
   290	  hdr "git state"
   291	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — commit or stash first"
   292	  ok "tree clean"
   293	
   294	  branch="$(git rev-parse --abbrev-ref HEAD)"
   295	  [ "$branch" = "main" ] || die "on branch '$branch' — releases are cut from main"
   296	  ok "on main"
   297	
   298	  git fetch --quiet origin main || die "git fetch origin main failed"
   299	  local_sha="$(git rev-parse HEAD)"
   300	  remote_sha="$(git rev-parse origin/main)"
   301	  [ "$local_sha" = "$remote_sha" ] \
   302	    || die "HEAD ($local_sha) != origin/main ($remote_sha) — push or pull first"
   303	  ok "HEAD == origin/main ($local_sha)"
   304	
   305	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   306	    && die "tag $TARGET_TAG already exists"
   307	  ok "tag $TARGET_TAG is free"
   308	
   309	  hdr "CI for HEAD"
   310	  if command -v gh >/dev/null 2>&1; then
   311	    runs="$(gh run list --limit 40 \
   312	      --json headSha,conclusion,status,workflowName 2>/dev/null || true)"
   313	    if [ -n "$runs" ]; then
   314	      verdict="$(mktemp)"
   315	      printf '%s' "$runs" | HEAD_SHA="$local_sha" python3 -c '
   316	import json, os, sys
   317	sha = os.environ["HEAD_SHA"]
   318	runs = [r for r in json.load(sys.stdin) if r.get("headSha") == sha]
   319	if not runs:
   320	    print("NO_RUNS"); sys.exit(0)
   321	bad = [r for r in runs if r.get("conclusion") not in ("success", "skipped", "")]
   322	pend = [r for r in runs if r.get("status") != "completed"]
   323	val = [r for r in runs if "Validate" in (r.get("workflowName") or "")]
   324	for r in bad:
   325	    print("BAD %s=%s" % (r["workflowName"], r["conclusion"]))
   326	for r in pend:
   327	    print("PENDING %s" % r["workflowName"])
   328	if not any(r.get("conclusion") == "success" for r in val):
   329	    print("NO_VALIDATE_SUCCESS")
   330	' > "$verdict" || die "CI verdict parse failed"
   331	      if grep -q '^BAD ' "$verdict"; then
   332	        cat "$verdict" >&2; rm -f "$verdict"
   333	        die "a workflow for HEAD is not green"
   334	      fi
   335	      if grep -q '^PENDING ' "$verdict"; then
   336	        cat "$verdict" >&2; rm -f "$verdict"
   337	        die "a workflow for HEAD is still running — wait for it"
   338	      fi
   339	      if grep -q 'NO_VALIDATE_SUCCESS' "$verdict"; then
   340	        rm -f "$verdict"
   341	        die "no successful Validate run for HEAD"
   342	      fi
   343	      if grep -q 'NO_RUNS' "$verdict"; then
   344	        rm -f "$verdict"
   345	        die "no CI runs found for HEAD — push it and let CI run"
   346	      fi
   347	      rm -f "$verdict"
   348	      ok "all workflows for HEAD green (Validate success)"
   349	    else
   350	      die "gh returned no run data — cannot confirm CI (fail-closed)"
   351	    fi
   352	  else
   353	    die "gh CLI not available — cannot confirm CI (fail-closed)"
   354	  fi
   355	
   356	  # These MUST be the invocations validate.yml uses, not `unittest discover`.
   357	  # The suite is pytest-only BY CONSTRUCTION: conftest.py carries the sys.path
   358	  # bootstrap and the _lib resolution guards as pytest collection hooks, and
   359	  # several modules isolate their environment with pytest `autouse` fixtures.
   360	  # `unittest discover` loads none of that, so those modules run with their
   610	# Two fail-closed guards run first, for RC and stable ALIKE. Scoping them to
   611	# `--stable` would let an rc.N ship a post-review commit and then become the
   612	# unreviewed baseline the GA is promoted from.
   613	#
   614	# THE LOCAL ASSERT IS NOT ENOUGH — say it out loud. A tag signed by hand skips
   615	# this driver entirely, and the pair-rail step 15 recomputes inputs_hash only
   616	# over `pair-rail-inputs-hash-manifest.txt`, which deliberately EXCLUDES the
   617	# bump surfaces (including them would make every legitimate bump change the
   618	# inputs_hash and break the verdict replay). The same restricted-delta assert
   619	# therefore goes SERVER-SIDE into `.github/workflows/release.yml` in PLAN-166
   620	# W1. release.yml is canonical: it changes under the GPG ceremony, not here.
   621	# `_release_tag_guard.py` is the reference implementation for both.
   622	# ---------------------------------------------------------------------------
   623	tag() {
   624	  hdr "sign tag $TARGET_TAG"
   625	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to tag"
   626	
   627	  # VERSION carries the BARE semver even for an RC tag (see the bump header),
   628	  # so compare against $TARGET_BASE, never $TARGET_VERSION.
   629	  cur_version="$(tr -d ' \n' < VERSION)"
   630	  [ "$cur_version" = "$TARGET_BASE" ] \
   631	    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
   632	  ok "VERSION ($cur_version) matches the base version of the tag"
   633	
   634	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   635	    && die "tag $TARGET_TAG already exists"
   636	
   637	  hdr "tag guards (unconditional — RC and stable)"
   638	  if [ "$OFFLINE_ACK" -eq 1 ]; then
   639	    python3 "$TAG_GUARD" ancestry --repo "$REPO_ROOT" --remote origin --branch main --offline-ack \
   640	      || die "ancestry guard refused the tag (see above)"
   641	  else
   642	    python3 "$TAG_GUARD" ancestry --repo "$REPO_ROOT" --remote origin --branch main \
   643	      || die "ancestry guard refused the tag (see above)"
   644	  fi
   645	  python3 "$TAG_GUARD" delta --repo "$REPO_ROOT" --tag "$TARGET_TAG" \
   646	    || die "restricted-delta guard refused the tag (see above)"
   647	
   648	  anchor="$(git rev-parse HEAD)"
   649	  msg="$TARGET_TAG — $RELEASE_TITLE
   650	
   651	Anchor: $anchor
   652	Scope:  $RELEASE_SCOPE
   653	
   654	Headline: $RELEASE_HEADLINE
   655	
   656	No speed claim. See CHANGELOG.md [$TARGET_BASE]."
   657	
   658	  if [ "$DRY_RUN" -eq 1 ]; then
   659	    note "dry-run: tag NOT created. Message that would be signed:"
   660	    printf '%s\n' "$msg" | sed 's/^/      | /'
   661	    return 0
   662	  fi
   663	
   664	  git tag -s -u "$SIGN_KEY" -m "$msg" "$TARGET_TAG" \
   665	    || die "git tag -s failed (key $SIGN_KEY)"
   666	  ok "tag created"
   667	
   668	  git tag -v "$TARGET_TAG" >/dev/null 2>&1 \
   669	    || die "tag signature does not verify — delete it and investigate"
   670	  ok "tag signature verifies"
   671	
   672	  cat <<EOF
   673	
   674	TAG $TARGET_TAG IS SIGNED LOCALLY AND NOT PUSHED.
   675	
   676	Pushing starts release.yml (the gate) and npm-publish.yml (which is what
   677	publishes to npm, via OIDC). That is the irreversible, outward-facing step —
   678	it stays yours:
   679	
   680	    git push origin $TARGET_TAG
   681	
   682	Then, per .github/release-checklist.md:
   683	  - gh run watch                      (all release.yml steps green)
   684	EOF
   685	  if [ "$STABLE" -eq 1 ]; then
   686	    cat <<EOF
   687	  - GitHub Release from the tag, "pre-release" NOT checked (this is the GA)
   688	  - npm view <pkg> version            (OIDC publish landed the bare semver)
   689	  - close the release: CHANGELOG links, memory topic, archive the RC hold
   690	EOF
   691	  else
   692	    cat <<EOF
   693	  - GitHub Release from the tag, "pre-release" checked while this is an RC
   694	  - ADR-103 hold: >=24 h, Codex re-pass against the RC, adopter smoke test
   695	  - promote: bash $0 bump --stable --npm-readme-reviewed && bash $0 tag --stable
   696	EOF
   697	  fi
   698	}
