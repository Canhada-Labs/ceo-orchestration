   404	def _sha256(path: str) -> str:
   405	    h = hashlib.sha256()
   406	    with open(path, "rb") as fh:
   407	        for chunk in iter(lambda: fh.read(65536), b""):
   408	            h.update(chunk)
   409	    return h.hexdigest()
   410	
   411	
   412	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   413	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   414	    entries: List[Tuple[str, str]] = []
   415	    # t10 P2: newline="" keeps CR bytes visible to the grammar.
   416	    with open(path, encoding="utf-8", newline="") as fh:
   417	        for line in fh:
   418	            line = line.rstrip("\n")
   419	            if not line.strip():
   420	                continue
   740	    # --- the delta itself ---
   741	    # --no-renames on purpose: with rename detection a file moved OUT of the
   742	    # allowlisted evidence directory is reported only under its destination
   743	    # name, and the disappearance of the reviewed original goes unmentioned.
   744	    # Literal paths on both sides or the set comparison is not a set comparison.
   745	    rc, out, err = _git(repo, "diff", "--no-renames", "%s..HEAD" % parent, "--name-only")
   746	    if rc != 0:
   747	        return _fail(
   748	            E_DELTA,
   749	            "`git diff --no-renames %s..HEAD --name-only` failed: %s"
   750	            % (parent, err.strip()),
   751	        )
   752	    changed = [line for line in out.splitlines() if line.strip()]
   753	    outside = sorted(p for p in changed if p not in allow_set)
   754	    if outside:
   755	        return _fail(
   756	            E_DELTA,
   757	            "files changed after the reviewed parent %s that the verdict does "
   758	            "NOT allow:\n%s\n"
   759	            "      The invariant is: NOTHING landed after what the re-pass "
   760	            "reviewed,\n"
   761	            "      other than the verdict and its pinned evidence. Either "
   762	            "re-run the\n"
   763	            "      re-pass against this tree, or drop these commits."
   764	            % (parent[:12], "\n".join("        - %s" % p for p in outside)),
   765	        )
   766	
   767	    # VACUITY. Everything above is satisfied trivially by an anchor that sits
   768	    # AT (or after) the verdict: the delta is then empty or verdict-free and
   769	    # "all files are inside the allowlist" proves nothing at all. The verdict
   770	    # has to have LANDED after the tree it certifies.
   771	    if verdict_rel not in changed:
   772	        return _fail(
   773	            E_VACUOUS,
   774	            "the verdict %s is not part of the delta %s..HEAD — this assert "
   775	            "would pass\n"
   776	            "      VACUOUSLY. parent_sha has to be the commit the re-pass "
   777	            "reviewed, with\n"
   778	            "      the verdict landing after it; parent_sha == HEAD (or any "
   779	            "anchor whose\n"
   780	            "      tree already carried the verdict) is the v1.16.0 "
   781	            "self-reference bug that\n"
   782	            "      the parent_sha field was introduced to kill."
   783	            % (verdict_rel, parent[:12]),
   784	        )
   785	
   786	    # State the inputs, not just the verdict: an operator reading a release log
   787	    # has to be able to tell what this assert actually examined.
   788	    print(
   789	        "  ok   delta %s..HEAD is %d file(s), all inside the verdict's closed "
   790	        "allowlist of %d (verdict present in the delta)"
   791	        % (parent[:12], len(changed), len(allow_set))
   792	    )
   793	    return 0
