   236	# (b) restricted delta
   237	# ---------------------------------------------------------------------------
   238	def _parse_verdict(text: str) -> Dict[str, object]:
   239	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   240	
   241	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   242	    of `  - item` list entries, and ignores everything else. Anything it cannot
   243	    read is absent, and every consumer below treats absent as fail-closed.
   244	
   245	    Parity with the step-15 reader (`.github/scripts/
   246	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   247	    scope: block selection (the regex below is the validator's own — the
   248	    first ```yaml fence, not the first fence of any language) and inline
   249	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   250	    parse_verdict_file reads key:value and sub-dicts and would drop
   251	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   252	    ONE shared reader (this file is the declared reference), never grow a
   253	    third parser of the same signed file.
   254	    """
   255	    fields: Dict[str, object] = {}
   256	    _body = _extract_single_yaml_block(text)
   257	    if _body is None:
   258	        # No/ambiguous/forbidden-bytes block -> no fields -> every
   259	        # consumer below fails closed.
   260	        return fields
   261	    cur_list: Optional[str] = None
   262	    for raw in _body.split("\n"):
   263	        line = _strip_yaml_comment(raw)
   264	        if not line.strip():
   265	            continue
   266	        if line.startswith(("  - ", "- ")) and cur_list:
   267	            item = line.split("-", 1)[1].strip()
   268	            if item:
   269	                fields[cur_list].append(item)  # type: ignore[union-attr]
   270	            continue
   271	        # [ \t]* not \s* (t5 P1): Python \s is Unicode-aware and would
   272	        # swallow a NBSP that must stay attached to the VALUE.
   273	        m = re.match(r"\A([A-Za-z0-9_]+):(?:[ \t]+(.*))?\Z", line)
   274	        if not m:
   275	            continue
   276	        key, val = m.group(1), (m.group(2) or "").strip(" \t")
   277	        if val == "":
   278	            fields[key] = []
   279	            cur_list = key
   280	        else:
   281	            fields[key] = val
   282	            cur_list = None
   283	    return fields
   284	
   285	
   286	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   287	# The two readers of this signed file disagreed about what a key IS: the
   288	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   289	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   290	# file demand the colon immediately after the name, so they skipped the line.
   291	# The valid-YAML pair
   292	#
   293	#     verdict : NO-GO
   294	#     verdict: GO
   295	#
   296	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   297	# and this is the rail that enforces in every mode, so the tag was authorised.
   298	#
   299	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   300	# fail-closed. Trimming the key in both readers would also close the
   301	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   302	# author writes and no template emits; refusing the shape is the smaller
   303	# surface and is the only behaviour that cannot silently prefer a value.
   304	# A top-level line is canonical iff it is `name:` with no whitespace before
   305	# the colon; list items are legal ONLY indented under an active bare
   306	# key (t8 P2: a root `- item` is rejected — the old comment said
   307	# otherwise and misled operators).
   308	def _strip_yaml_comment(raw):
   309	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   310	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   311	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Byte-for-
   312	    byte twin of `_strip_comment` in validate-pair-rail-verdict.py.
   313	    """
   314	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   315	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   316	    if raw.lstrip(" \t").startswith("#"):
   317	        return ""
   318	    i = 0
   319	    while True:
   320	        j = raw.find("#", i)
   321	        if j == -1:
   322	            return raw.rstrip(" \t")
   323	        if j > 0 and raw[j - 1] in (" ", "\t"):
   324	            return raw[:j].rstrip(" \t")
   325	        i = j + 1
   326	
   327	
   328	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   329	
   330	
   331	def _noncanonical_top_level_lines(text: str) -> List[str]:
   332	    """Top-level lines of the yaml block that are not canonical declarations.
   333	
   334	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   335	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   336	    separate machines; neither may import the other — keep them identical).
   337	    Empty list == the block speaks the grammar both readers assume.
   338	    """
   339	    body = _extract_single_yaml_block(text)
   340	    if body is None:
   341	        return ["<yaml block rejected: ambiguous fence, bad opener, or "
   342	                "forbidden control/separator bytes>"]
   343	    bad: List[str] = []
   344	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   345	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   346	    # Both None (before any key) and "scalar" reject — an orphan-indented
   347	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   348	    # through the prev_scalar_decl=False initial state and resolved as GO,
   349	    # and a root-level `- item` is malformed for this signed format (its
   350	    # only lists are INDENTED under a bare key) yet was accepted outright.
   351	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   352	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   353	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   354	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   355	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   356	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   357	    # reopening the orphan-indentation class through the whitespace side.
   358	    parent = None  # None | "scalar" | "bare"
   359	    for raw in body.split("\n"):
   360	        line = _strip_yaml_comment(raw)
   361	        if not line.strip(" \t"):
   362	            continue
   363	        if line[0] in (" ", "\t"):
   364	            if parent != "bare":
   365	                bad.append(line)
   366	            continue
   367	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   368	            _key, _, _val = line.partition(":")
   369	            parent = "scalar" if _val.strip(" \t") else "bare"
   370	            continue
   371	        bad.append(line)
   372	        parent = None
   373	    return bad
   374	
   375	
   376	def _count_top_level_key(text: str, key: str) -> int:
   377	    """How many times `key:` is declared at the top level of the block.
   378	
   379	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   380	    step-15 reader: a second `verdict:` silently overrides the first, so
   381	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   382	    block selection and same comment rule as the reader, or the count
   383	    would be about a different text than the parse.
   384	
   385	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   386	    counter does NOT strip the key and the step-15 twin does, so on a
   387	    non-canonical block the two counts differ. delta() checks the shape
   388	    first.
   389	    """
   390	    _body = _extract_single_yaml_block(text)
   391	    if _body is None:
   392	        return 0
   393	    seen = 0
   394	    for raw in _body.split("\n"):
   395	        line = _strip_yaml_comment(raw)
   396	        if not line.strip() or line[0] in (" ", "\t"):
   397	            continue
   398	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   399	        if m and m.group(1) == key:
   400	            seen += 1
   401	    return seen
   402	
   403	
   404	def _sha256(path: str) -> str:
   405	    h = hashlib.sha256()
   406	    with open(path, "rb") as fh:
   407	        for chunk in iter(lambda: fh.read(65536), b""):
   408	            h.update(chunk)
   409	    return h.hexdigest()
   410	
   411	
   412	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   413	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   414	    entries: List[Tuple[str, str]] = []
   415	    # t10 P2: newline="" keeps CR bytes visible to the grammar.
   416	    with open(path, encoding="utf-8", newline="") as fh:
   417	        for line in fh:
   418	            line = line.rstrip("\n")
   419	            if not line.strip():
   420	                continue
   421	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   422	            if not m:
   423	                raise ValueError("unparsable manifest line: %r" % line)
   424	            entries.append((m.group(1), m.group(2)))
   425	    return entries
