   142	def _str(value: Any) -> str:
   143	    """Coerce a JSON value to a string, tolerating None/missing."""
   144	    if value is None:
   145	        return ""
   146	    if isinstance(value, str):
   147	        return value
   148	    # For numeric or bool, stringify — this is a display/log artifact
   149	    return str(value)
