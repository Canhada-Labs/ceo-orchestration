   277	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   278	    try:
   279	        v = parse_semver(version)
   280	        lo = parse_semver(min_v)
   281	        hi = parse_semver(max_v)
   282	        return lo <= v < hi
   283	    except ValueError:
   284	        return False
