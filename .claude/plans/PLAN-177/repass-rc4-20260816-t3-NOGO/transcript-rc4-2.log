  command -v _posture_state_ignore_entries >/dev/null 2>&1 || {
    echo "    ERROR: _posture_state_ignore_entries unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot ensure posture-state .gitignore entries" >&2
