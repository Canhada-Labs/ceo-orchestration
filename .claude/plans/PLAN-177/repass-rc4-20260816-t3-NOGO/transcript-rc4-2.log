   132	def noncanonical_top_level_lines(text: str) -> List[str]:
   133	    """Top-level lines of the yaml block that are not canonical declarations.
   134	
   135	    Byte-for-byte twin of `_noncanonical_top_level_lines` in
   136	    `.claude/scripts/local/_release_tag_guard.py` (separate processes on
   137	    separate machines; neither may import the other — keep them identical).
   138	    Empty list == the block speaks the grammar both readers assume.
   139	    """
   140	    m = _YAML_BLOCK_RE.search(text)
   141	    if not m:
   142	        return []
   143	    bad: List[str] = []
   144	    prev_scalar_decl = False
   145	    for raw in m.group(1).splitlines():
   146	        line = _strip_comment(raw)
   147	        if not line.strip():
   148	            continue
   149	        if line[0] in (" ", "\t"):
   150	            # Sub-level line. Legitimate ONLY under a parent declared as a
   151	            # bare `key:` (mapping/list). After a SCALAR `key: value`, an
   152	            # indented non-comment line is a YAML CONTINUATION that changes
   153	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   154	            # while this minimal reader still saw `GO` — reject fail-closed
   155	            # (re-pass rc.4 t2 P1).
   156	            if prev_scalar_decl:
   157	                bad.append(line)
   158	            continue
   159	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   160	            _key, _, _val = line.partition(":")
   161	            prev_scalar_decl = bool(_val.strip())
   162	            continue
   163	        if line.startswith("- "):  # top-level list item
   164	            prev_scalar_decl = False
   165	            continue
   166	        bad.append(line)
   167	        prev_scalar_decl = False
   168	    return bad
