    94	def parse_text(text: str) -> HookPayload:
    95	    """Parse a JSON text into a HookPayload. Used by tests and parse_stdin.
    96	
    97	    Empty input is treated as a valid empty payload (not an error) — matches
    98	    the bash behavior where `cat` with no input yields ""  and `jq // ""`
    99	    defaults to empty.
   100	    """
   101	    payload = HookPayload(raw=text)
   102	
   103	    if not text or not text.strip():
   104	        return payload
   105	
   106	    try:
   107	        data = json.loads(text)
   108	    except json.JSONDecodeError as e:
   109	        payload.raw_error = f"JSON parse error: {e.msg} at line {e.lineno} col {e.colno}"
   110	        return payload
   111	
   112	    if not isinstance(data, dict):
   113	        payload.raw_error = f"payload must be a JSON object, got {type(data).__name__}"
   114	        return payload
   115	
   116	    # Top-level fields
   117	    payload.session_id = _str(data.get("session_id"))
   118	    payload.tool_name = _str(data.get("tool_name"))
   119	
   120	    # PLAN-125 WS-1 — top-level lifecycle scalars. `tool_use_id` is a string
   121	    # pairing key; `duration_ms` stays numeric (int-or-None) so the duration
   122	    # bucketing mapper receives a number, never a stringified value.
   123	    payload.tool_use_id = _str(data.get("tool_use_id"))
   124	    payload.duration_ms = _int_or_none(data.get("duration_ms"))
   125	
   126	    # tool_input sub-object
   127	    tool_input = data.get("tool_input") or {}
   128	    if isinstance(tool_input, dict):
   129	        payload.tool_input = tool_input
   130	        payload.description = _str(tool_input.get("description"))
   131	        payload.prompt = _str(tool_input.get("prompt"))
   132	        payload.subagent_type = _str(tool_input.get("subagent_type"))
   133	    # If tool_input is not a dict, the fields above stay empty — don't error,
   134	    # fail-open is the protocol.
   135	
   136	    # tool_response — may be dict, str, or absent (PostToolUse variants differ)
   137	    payload.tool_response = data.get("tool_response")
   138	
   139	    return payload
