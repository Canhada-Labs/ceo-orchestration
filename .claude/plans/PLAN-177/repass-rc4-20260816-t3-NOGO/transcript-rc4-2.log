   685	def check_governance_validate() -> Tuple[str, str, Any]:
   686	    """PLAN-082 Codex Item A: dispatch fast-profile validator.
   687	
   688	    Calls `validate-governance.sh --fast --json` (delegates to
   689	    `validate_governance_fast.py`) with a 1.8 s timeout. Parses JSON
   690	    output; `rc != 0` is the red truth signal (NOT `stdout.count("ERROR")`
   691	    — Codex 6th-option catch: the full validator emits `FAIL:` in some
   692	    sections without printing literal "ERROR", which underclassified
   693	    failures as yellow).
   694	    """
   695	    script = REPO_ROOT / ".claude" / "scripts" / "validate-governance.sh"
   696	    if not script.exists():
   697	        return "yellow", "validate-governance missing", None
   698	    try:
   699	        proc = subprocess.run(
   700	            ["bash", str(script), "--fast", "--json"],
   701	            capture_output=True, text=True, timeout=1.8, cwd=str(REPO_ROOT),
   702	        )
   703	    except subprocess.TimeoutExpired:
   704	        return "red", "validate timeout (fast)", None
   705	    rc = proc.returncode
   706	    try:
   707	        payload = json.loads(proc.stdout) if proc.stdout else {}
   708	    except (json.JSONDecodeError, ValueError):
   709	        payload = {}
   710	    errors = payload.get("errors", []) if isinstance(payload, dict) else []
