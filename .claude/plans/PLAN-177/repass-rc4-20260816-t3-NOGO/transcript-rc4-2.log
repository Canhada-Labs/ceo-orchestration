   118	def _fail(code: int, msg: str) -> int:
   119	    # Flush the ok-lines first: an operator reading a release failure must see
   120	    # WHICH checks passed before the one that stopped it, in order.
   121	    sys.stdout.flush()
   122	    print("FAIL: %s" % msg, file=sys.stderr)
   123	    sys.stderr.flush()
   124	    return code
