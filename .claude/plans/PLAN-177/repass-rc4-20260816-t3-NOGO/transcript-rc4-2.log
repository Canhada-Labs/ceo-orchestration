   232	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   233	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   234	    if not manifest_path.exists():
   235	        raise FileNotFoundError(f"manifest: {manifest_path}")
   236	    paths = []
   237	    for line in manifest_path.read_text().splitlines():
   238	        line = line.split("#", 1)[0].strip()
   239	        if line:
   240	            paths.append(line)
   241	    paths.sort()
   242	    hashes = {}
   243	    for p in paths:
   244	        result = subprocess.run(
   245	            ["git", "hash-object", p],
   246	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   247	        )
   248	        if result.returncode != 0:
   249	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   250	        hashes[p] = result.stdout.strip()
   251	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   252	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
