   550	    if not isinstance(desc, str) or not _HARNESS_PROBE_DESC_RE.match(desc):
   551	        return False
   552	    digest = ev.get("desc_hash")
   553	    if not isinstance(digest, str) or not digest:
   554	        return False
   555	    return digest == hashlib.sha256(desc.encode("utf-8")).hexdigest()
   556	
   557	
   558	def _is_harness_probe_event(ev: Dict[str, Any]) -> bool:
   559	    """True iff the agent_spawn row is a harness-internal tool-loading probe.
   560	
   561	    S303: the ghost filter above was written for the ToolSearch probes of an
   562	    older harness, whose Agent-shaped PostToolUse rows carried NO description
   563	    (desc_preview == "" and desc_hash == SHA256(b"")). The current harness
   564	    supplies a human-readable description for the same class of call — e.g.
   565	    ``Load WebFetch via ToolSearch?`` with prompt ``noop`` and a fixed cheap
   566	    model — so all four ghost conditions no longer hold and a pure
   567	    tool-materialization probe lands in the denominator as a governance gap.
   568	
   569	    The discriminator is ``subagent_type``: the Agent/Task spawn contract makes
   570	    it REQUIRED for every governed dispatch (``check_agent_spawn.py`` derives
   571	    the authoritative archetype from it, and ``extract_skill`` Path D needs it),
   572	    so a row that carries none was never a CEO dispatch. All five conditions
   573	    must hold — no subagent_type, no archetype, no rail attribution, no
   574	    ``## AGENT PROFILE`` and no ``## FILE ASSIGNMENT`` — so a real named spawn
   575	    that merely lost one field still counts. Skipped rows stay OBSERVABLE via
   576	    the ``harness_probes_skipped`` counter: this suppresses a false alarm, it
   577	    does not hide the event.
   578	
   579	    PLAN-177 t2 (P1-f): those five are NECESSARY, NOT SUFFICIENT. Absence is
   580	    exactly the shape of the event this ratio exists to expose — a markerless
   581	    REAL spawn, including one admitted because the PreToolUse hook failed
   582	    open, matched all five and was deleted from the denominator. The row must
   583	    ALSO carry the closed harness signature
   584	    (``_has_harness_probe_fingerprint``); an unrecognised description counts,
   585	    however markerless the row is.
   586	    """
   587	    # Re-pass rc.4 t2 (P1): the S303 exemption is RETIRED until trusted
   588	    # provenance exists. `desc_preview` and `desc_hash` are both derived
   589	    # from the same CALLER-CONTROLLED description, so the hash corroborates
   590	    # nothing: a real markerless spawn described as
   591	    # `Load WebFetch via ToolSearch?` was silently deleted from the
   592	    # denominator — the exact event this ratio exists to expose. Until the
   593	    # EMITTER can stamp provenance the caller cannot forge, probe-shaped
   594	    # rows COUNT (the conservative direction for an advisory: a yellow the
   595	    # operator triages beats a green that hides a fail-open spawn).
   596	    # _has_harness_probe_fingerprint is kept (tested) as the shape
   597	    # DETECTOR for that future provenance-bearing emitter.
   598	    return False
   599	
   600	
   601	def check_skill_unknown_ratio() -> Tuple[str, str, Any]:
   602	    """Detect spawns that should have SKILL injection but didn't.
   603	
   604	    S94 follow-up: excludes intentionally skill-less archetypes —
   605	    `general-purpose` subagent dispatches via the mitigated rail
   606	    (ADR-082) by design have no SKILL.md anchor. They broker cross-
   607	    LLM gate calls and similar utility work; counting them as FPs
   608	    inflates the ratio to 100% during healthy Codex MCP sessions
   609	    and trains the operator to ignore the channel.
   610	
   611	    A spawn counts as "skill missing" ONLY when its `archetype` is
   612	    a custom (non-general-purpose) one AND `skill` is unknown/empty.
   613	    That is the original PLAN-020 ADR-051 governance gap the
   614	    detector was built for.
   615	    """
   616	    total = 0
   617	    unknown = 0
   618	    ghosts_skipped = 0
   619	    harness_probes_skipped = 0
   620	    skill_less_by_design = 0
   621	    test_pollution_skipped = 0
   622	    for ev in _iter_audit_events_since(24):
   623	        if ev.get("action") != "agent_spawn":
   624	            continue
   625	        if _is_test_pollution_event(ev):
   626	            test_pollution_skipped += 1
   627	            continue
   628	        if _is_ghost_spawn_event(ev):
   629	            ghosts_skipped += 1
   630	            continue
   631	        if _is_harness_probe_event(ev):
   632	            harness_probes_skipped += 1
   633	            continue
   634	        # Skill-less by design: general-purpose archetype dispatches
   635	        # (mitigated rail per ADR-082) AND built-in subagent types like
   636	        # Explore/Plan/claude-code-guide that have no .claude/agents/<name>.md
   637	        # and so cannot carry a `Loads <skill> skill via reference` phrase
   638	        # (drift-detector contract per S143 lesson). Adding them to
   639	        # _ARCHETYPE_TO_SKILL would violate the contract — exclude here instead.
   640	        # S200: claude/claude-code-guide/statusline-setup are first-party
   641	        # Claude Code built-ins (no .claude/agents anchor); counting them as a
   642	        # governance gap is a false positive — exactly the FP class this filter
   643	        # exists to prevent (else healthy claude-code-guide use trains the
   644	        # operator to ignore the channel).
   645	        _SKILL_LESS_BUILTINS = {
   646	            "general-purpose", "Explore", "Plan",
   647	            "claude", "claude-code-guide", "statusline-setup",
   648	        }
   649	        if (
   650	            ev.get("subagent_type") in _SKILL_LESS_BUILTINS
   651	            and ev.get("archetype") in _SKILL_LESS_BUILTINS
   652	        ):
   653	            skill_less_by_design += 1
   654	            continue
   655	        total += 1
   656	        if ev.get("skill") in (None, "unknown", ""):
   657	            unknown += 1
   658	    if total == 0:
   659	        msg = (
   660	            "no custom-archetype spawns "
   661	            "({s} general-purpose, {g} ghosts, {p} harness-probes, "
   662	            "{t} test-pollution)".format(
   663	                s=skill_less_by_design, g=ghosts_skipped,
   664	                p=harness_probes_skipped, t=test_pollution_skipped,
   665	            )
   666	        )
   667	        return "green", msg, {
   668	            "unknown": 0, "total": 0,
   669	            "ghosts_skipped": ghosts_skipped,
   670	            "harness_probes_skipped": harness_probes_skipped,
   671	            "skill_less_by_design": skill_less_by_design,
   672	            "test_pollution_skipped": test_pollution_skipped,
   673	        }
   674	    ratio = unknown / total
   675	    status = "red" if ratio > 0.10 else "yellow" if ratio > 0 else "green"
   676	    return status, f"{unknown}/{total} = {ratio:.0%}", {
   677	        "unknown": unknown, "total": total,
   678	        "ghosts_skipped": ghosts_skipped,
   679	        "harness_probes_skipped": harness_probes_skipped,
   680	        "skill_less_by_design": skill_less_by_design,
   681	        "test_pollution_skipped": test_pollution_skipped,
   682	    }
   683	
