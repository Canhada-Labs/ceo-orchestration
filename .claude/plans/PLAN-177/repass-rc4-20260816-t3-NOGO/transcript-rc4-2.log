   270	def parse_semver(s: str) -> Tuple[int, int, int]:
   271	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   272	    if not m:
   273	        raise ValueError(f"unparseable semver: {s!r}")
   274	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
