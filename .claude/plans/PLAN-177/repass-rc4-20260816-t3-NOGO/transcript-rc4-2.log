   198	# (b) restricted delta
   199	# ---------------------------------------------------------------------------
   200	def _parse_verdict(text: str) -> Dict[str, object]:
   201	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   202	
   203	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   204	    of `  - item` list entries, and ignores everything else. Anything it cannot
   205	    read is absent, and every consumer below treats absent as fail-closed.
   206	
   207	    Parity with the step-15 reader (`.github/scripts/
   208	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   209	    scope: block selection (the regex below is the validator's own — the
   210	    first ```yaml fence, not the first fence of any language) and inline
   211	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   212	    parse_verdict_file reads key:value and sub-dicts and would drop
   213	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   214	    ONE shared reader (this file is the declared reference), never grow a
   215	    third parser of the same signed file.
   216	    """
   217	    fields: Dict[str, object] = {}
   218	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   219	    if block is None:
   220	        # No yaml block -> no fields -> every consumer below fails closed.
   250	# The valid-YAML pair
   251	#
   252	#     verdict : NO-GO
   253	#     verdict: GO
   254	#
   255	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   256	# and this is the rail that enforces in every mode, so the tag was authorised.
   257	#
   258	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   259	# fail-closed. Trimming the key in both readers would also close the
   260	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   261	# author writes and no template emits; refusing the shape is the smaller
   262	# surface and is the only behaviour that cannot silently prefer a value.
   263	# A top-level line is canonical iff it is `name:` with no whitespace before
   264	# the colon, or a `- ` list item.
   265	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:")
   266	
   267	
   268	def _noncanonical_top_level_lines(text: str) -> List[str]:
   269	    """Top-level lines of the yaml block that are not canonical declarations.
   270	
   271	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   272	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   273	    separate machines; neither may import the other — keep them identical).
   274	    Empty list == the block speaks the grammar both readers assume.
   275	    """
   276	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   277	    if block is None:
   278	        return []
   279	    bad: List[str] = []
   280	    prev_scalar_decl = False
   281	    for raw in block.group(1).splitlines():
   282	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   283	        if not line.strip():
   284	            continue
   285	        if line[0] in (" ", "\t"):
   286	            # Sub-level line. Legitimate ONLY under a parent declared as a
   287	            # bare `key:` (mapping/list). After a SCALAR `key: value`, an
   288	            # indented non-comment line is a YAML CONTINUATION that changes
   289	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   290	            # while this minimal reader still saw `GO` — reject fail-closed
   291	            # (re-pass rc.4 t2 P1).
   292	            if prev_scalar_decl:
   293	                bad.append(line)
   294	            continue
   295	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   296	            _key, _, _val = line.partition(":")
   297	            prev_scalar_decl = bool(_val.strip())
   298	            continue
   299	        if line.startswith("- "):  # top-level list item
   300	            prev_scalar_decl = False
   301	            continue
   302	        bad.append(line)
   303	        prev_scalar_decl = False
   304	    return bad
   305	
   306	
   307	def _count_top_level_key(text: str, key: str) -> int:
   308	    """How many times `key:` is declared at the top level of the block.
   309	
   310	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   311	    step-15 reader: a second `verdict:` silently overrides the first, so
   312	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   313	    block selection and same comment rule as the reader, or the count
   314	    would be about a different text than the parse.
   315	
   316	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   317	    counter does NOT strip the key and the step-15 twin does, so on a
   318	    non-canonical block the two counts differ. delta() checks the shape
   319	    first.
   320	    """
   321	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   322	    if block is None:
   323	        return 0
   324	    seen = 0
   325	    for raw in block.group(1).splitlines():
   326	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   327	        if not line.strip() or line[0] in (" ", "\t"):
   328	            continue
   329	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   330	        if m and m.group(1) == key:
   331	            seen += 1
   332	    return seen
   333	
   334	
   335	def _sha256(path: str) -> str:
   336	    h = hashlib.sha256()
   337	    with open(path, "rb") as fh:
   338	        for chunk in iter(lambda: fh.read(65536), b""):
   339	            h.update(chunk)
   340	    return h.hexdigest()
   341	
   342	
   343	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   344	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   345	    entries: List[Tuple[str, str]] = []
   346	    with open(path, encoding="utf-8") as fh:
   347	        for line in fh:
   348	            line = line.rstrip("\n")
   349	            if not line.strip():
   350	                continue
   351	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   352	            if not m:
   353	                raise ValueError("unparsable manifest line: %r" % line)
   354	            entries.append((m.group(1), m.group(2)))
   355	    return entries
   356	
   357	
   358	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   359	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   360	    directory = os.path.dirname(manifest) or "."
   361	    name = os.path.basename(manifest)
   362	    try:
   363	        proc = subprocess.run(
   364	            ["shasum", "-a", "256", "-c", name],
   365	            cwd=directory,
   366	            stdout=subprocess.PIPE,
   367	            stderr=subprocess.STDOUT,
   368	            universal_newlines=True,
   369	        )
   370	        return proc.returncode == 0, proc.stdout.strip()
   371	    except (OSError, FileNotFoundError):
   372	        bad: List[str] = []
   373	        for want, rel in _read_manifest(manifest):
   374	            full = os.path.join(directory, rel)
   375	            if not os.path.isfile(full) or _sha256(full) != want:
   376	                bad.append(rel)
   377	        if bad:
   378	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   379	        return True, "hashlib fallback: all entries match"
   380	
