   170	
   171	def count_top_level_key(text: str, key: str) -> int:
   172	    """How many times `key:` is declared at the top level of the block.
   173	
   174	    Both readers of this signed file are LAST-WINS, so a second
   175	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   176	    as GO. Callers require exactly one.
   177	
   178	    Only meaningful once `noncanonical_top_level_lines` is empty: this
   179	    counter strips the key, so it sees `verdict : X` as a declaration and
   180	    the twin counter in the tag guard does not. Callers run the shape
   181	    check FIRST.
   182	    """
   183	    m = _YAML_BLOCK_RE.search(text)
   184	    if not m:
   185	        return 0
   186	    seen = 0
   187	    for raw in m.group(1).splitlines():
   188	        line = _strip_comment(raw)
   189	        if not line.strip() or line[0] in (" ", "\t"):
   190	            continue
   191	        if line.partition(":")[0].strip() == key:
   192	            seen += 1
   193	    return seen
   194	
   195	
   196	def parse_verdict_text(text: str) -> Dict[str, Any]:
   197	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   198	    m = _YAML_BLOCK_RE.search(text)
   199	    if not m:
   200	        raise ValueError("verdict file missing yaml frontmatter block")
   201	    yaml_body = m.group(1)
   202	    # Inline minimal YAML parse (stdlib only)
   203	    out: Dict[str, Any] = {}
   204	    current_key: Optional[str] = None
   205	    for raw in yaml_body.splitlines():
   206	        line = _strip_comment(raw)
   207	        if not line.strip():
   208	            continue
   209	        if line[0] not in (" ", "\t"):
   210	            if ":" in line:
   211	                k, _, v = line.partition(":")
   212	                v = v.strip()
   213	                if v:
   214	                    out[k.strip()] = v
   215	                else:
   216	                    out[k.strip()] = {}
   217	                    current_key = k.strip()
   218	        elif current_key and ":" in line:
   219	            sub_k, _, sub_v = line.partition(":")
   220	            if isinstance(out[current_key], dict):
   221	                out[current_key][sub_k.strip()] = sub_v.strip()
   222	    return out
   223	
   224	
   225	def parse_verdict_file(path: Path) -> Dict[str, Any]:
   226	    """Path wrapper over parse_verdict_text (published entry point)."""
   227	    if not path.exists():
   228	        raise FileNotFoundError(f"verdict file: {path}")
   229	    return parse_verdict_text(path.read_text(encoding="utf-8"))
   230	
