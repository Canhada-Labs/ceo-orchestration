   255	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   256	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   257	    if not pin_file.exists():
   258	        return None, None
   259	    for line in pin_file.read_text().splitlines():
   260	        line = line.split("#", 1)[0].strip()
   261	        if not line:
   262	            continue
   263	        # parse `>=X.Y.Z,<A.B.C` shape
   264	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   265	        if m:
   266	            return m.group(1), m.group(2)
   267	    return None, None
