   343	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   344	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   345	    entries: List[Tuple[str, str]] = []
   346	    with open(path, encoding="utf-8") as fh:
   347	        for line in fh:
   348	            line = line.rstrip("\n")
   349	            if not line.strip():
   350	                continue
   351	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   352	            if not m:
   353	                raise ValueError("unparsable manifest line: %r" % line)
   354	            entries.append((m.group(1), m.group(2)))
   355	    return entries
