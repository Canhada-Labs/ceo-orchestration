   727	# WS4-mtime-helper: portable file mtime (epoch seconds) — GNU + BSD stat.
   728	detect_mtime() {
   729	  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
   730	}
