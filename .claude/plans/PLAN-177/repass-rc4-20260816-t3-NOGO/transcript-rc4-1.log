  1199	  printf '%s\n' "$listing" | while IFS= read -r rel; do
  1200	    [[ -n "$rel" ]] || continue
  1201	    # PLAN-161 U2 (CF-7): the canonical framework-internal exclusion set —
  1202	    # never install, never re-add after an adopter deletes, never report.
  1203	    # Silent skip; the opt-in U3 purge is the ONLY code allowed to touch
  1204	    # these paths (and only hash-gated).
  1205	    if command -v _framework_path_excluded >/dev/null 2>&1 && _framework_path_excluded "$rel"; then
  1206	      continue
  1207	    fi
  1208	    if _path_is_skipped "$rel"; then
  1209	      echo "    SKIPPED (--skip): $rel"
  1210	      continue
  1211	    fi
  1212	    # Source-removed file: present at dst, absent at src. Report, never delete.
  1213	    if [[ ! -f "$SOURCE_DIR/$rel" ]]; then
  1214	      echo "    KEPT (no longer shipped by framework — not removed): $rel" >&2
  1215	      continue
  1216	    fi
  1217	    # New framework file: absent at dst. Just install it.
  1218	    if [[ ! -f "$TARGET/$rel" ]]; then
  1219	      _apply_single_file "$rel"
  1220	      echo "    ADDED: $rel"
  1221	      continue
  1222	    fi
  1223	    verdict="$( _classify_against_baseline "$rel" )"
  1224	    case "$verdict" in
  1225	      IDENTICAL)
  1226	        : ;;  # nothing to do
  1227	      FRAMEWORK-CHANGED)
  1228	        # Quiet auto-update is the intended path (dst matched the recorded
  1229	        # baseline => the adopter had not customized this file). BUT the manifest
  1230	        # is UNSIGNED/target-side (OQ-trust): a tampered line where H_base==H_dst
  1231	        # would mis-classify a customized file into this branch. We cannot detect
  1232	        # that without a signed manifest, so per Codex R1 P0#1 this is downgraded
  1233	        # to NON-SILENT: _apply_single_file always backs up the original first,
  1234	        # and we surface the overwrite + backup location on stderr (recoverable
  1235	        # AND visible — worst case equals today's warn-then-clobber).
  1236	        _apply_single_file "$rel"
  1237	        echo "    UPDATED (framework-changed; unsigned baseline — original backed up to $BAK_DIR/$rel): $rel" >&2
  1238	        ;;
  1239	      ADOPTER-CUSTOMIZED)
  1240	        echo "    PRESERVED (ADOPTER-CUSTOMIZED — not overwritten): $rel" >&2
  1241	        ;;
  1242	      CONFLICT)
  1243	        case "$ON_CONFLICT" in
  1244	          theirs)
  1245	            _apply_single_file "$rel"
  1246	            echo "    OVERWROTE (CONFLICT, --on-conflict=theirs): $rel" >&2
  1247	            ;;
  1248	          backup)
  1249	            _apply_single_file "$rel"
  1250	            echo "    OVERWROTE (CONFLICT, --on-conflict=backup; original in $BAK_DIR/$rel): $rel" >&2
  1251	            ;;
  1252	          *)  # refuse (default): per-file skip-and-report-and-CONTINUE
  1253	            echo "    REFUSED (CONFLICT, --on-conflict=refuse — not overwritten): $rel" >&2
  1254	            ;;
  1255	        esac
  1256	        ;;
  1257	      FALLBACK|*)
  1258	        # No usable baseline for this file — today's diff -q warn-then-clobber.
  1259	        if [[ "$DIFF_WARN" -eq 1 ]] && ! diff -q "$TARGET/$rel" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
  1260	          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN (no baseline)" >&2
  1261	          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
  1262	        fi
  1263	        _apply_single_file "$rel"
  1264	        echo "    UPDATED (fallback): $rel"
  1265	        ;;
  1266	    esac
  1267	  done
  1268	}
