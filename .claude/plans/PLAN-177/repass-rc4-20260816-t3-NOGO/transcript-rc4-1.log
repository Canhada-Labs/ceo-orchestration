  1270	# PLAN-161 W2 fix-3 (codex r3 F11a): TRUE (rc 0) iff any STRICT ancestor
  1271	# component of relpath $2 under root $1 is a symlink. A preserved excluded
  1272	# SYMLINK must be an opaque leaf: a -f/-d/-L test (or rm/rmdir) on a path
  1273	# that runs THROUGH it resolves into the link TARGET, so an unguarded
  1274	# prune could delete adopter data OUTSIDE the tree. Every prune-side
  1275	# test/delete on "$TARGET/$rel" must first pass this lstat-walk guard.
  1276	# bash 3.2-safe: pure string splitting, [[ -L ]] never follows the leaf.
  1277	_lg_ancestor_is_symlink() {
  1278	  local _as_root="$1" _as_rel="$2" _as_walk=""
  1279	  while [[ "$_as_rel" == */* ]]; do
  1280	    _as_walk="${_as_walk:+$_as_walk/}${_as_rel%%/*}"
  1281	    _as_rel="${_as_rel#*/}"
  1282	    if [[ -L "$_as_root/$_as_walk" ]]; then return 0; fi
  1283	  done
  1284	  return 1
  1285	}
