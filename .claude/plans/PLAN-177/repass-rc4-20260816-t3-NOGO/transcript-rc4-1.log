  1164	# PLAN-138 Wave C (ADR-155): update ONE file under a classified directory walk.
  1165	# $1 = repo-relative file path. Backs up the dst file then copies src over it.
  1166	# Used by _per_file_classified_update for the FRAMEWORK-CHANGED / theirs / backup
  1167	# branches. find+delete idiom is unnecessary for a single file (plain cp).
  1168	_apply_single_file() {
  1169	  local rel="$1"
  1170	  local s="$SOURCE_DIR/$rel"
  1171	  local d="$TARGET/$rel"
  1172	  local b="$BAK_DIR/$rel"
  1173	  [[ -f "$s" ]] || return 0
  1174	  if [[ -e "$d" ]]; then
  1175	    mkdir -p "$( dirname "$b" )"
  1176	    cp "$d" "$b" 2>/dev/null || true
  1177	  fi
  1178	  mkdir -p "$( dirname "$d" )"
  1179	  cp "$s" "$d"
  1180	}
  1181	
  1182	# PLAN-138 Wave C (ADR-155): per-file walk of a DIRECTORY target driven by the
  1183	# baseline classifier. Replaces the whole-tree delete+cp -R when a baseline
  1184	# manifest is loaded, so an adopter customization INSIDE a directory is
  1185	# preserved/refused per-file instead of being wiped. The union of source + dst
  1186	# files is walked so framework-added files land and removed-from-source files
  1187	# are reported (never auto-deleted — destructive removals stay manual).
  1188	_per_file_classified_update() {
  1189	  local rel_dir="$1"
  1190	  local sdir="$SOURCE_DIR/$rel_dir"
  1191	  local ddir="$TARGET/$rel_dir"
  1192	  local listing rel verdict
  1193	  # Build the union of relpaths under src + dst (regular files only).
  1194	  listing="$( {
  1195	    [[ -d "$sdir" ]] && find "$sdir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$SOURCE_DIR"/}"; done
  1196	    [[ -d "$ddir" ]] && find "$ddir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$TARGET"/}"; done
  1197	  } | LC_ALL=C sort -u )"
