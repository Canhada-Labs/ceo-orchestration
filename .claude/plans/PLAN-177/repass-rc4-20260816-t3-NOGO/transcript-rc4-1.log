   358	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   359	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   360	    directory = os.path.dirname(manifest) or "."
   361	    name = os.path.basename(manifest)
   362	    try:
   363	        proc = subprocess.run(
   364	            ["shasum", "-a", "256", "-c", name],
   365	            cwd=directory,
   366	            stdout=subprocess.PIPE,
   367	            stderr=subprocess.STDOUT,
   368	            universal_newlines=True,
   369	        )
   370	        return proc.returncode == 0, proc.stdout.strip()
   371	    except (OSError, FileNotFoundError):
   372	        bad: List[str] = []
   373	        for want, rel in _read_manifest(manifest):
   374	            full = os.path.join(directory, rel)
   375	            if not os.path.isfile(full) or _sha256(full) != want:
   376	                bad.append(rel)
   377	        if bad:
   378	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   379	        return True, "hashlib fallback: all entries match"
