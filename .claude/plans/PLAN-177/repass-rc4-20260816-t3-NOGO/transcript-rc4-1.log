   716	            echo "::error::cannot resolve parent of $VERDICT_FILE_COMMIT — step 15 fails"
   717	            exit 1
   718	          fi
   719	          echo "::notice::S104 bind: VERDICT_FILE_COMMIT=$VERDICT_FILE_COMMIT, PARENT_SHA=$PARENT_SHA"
   720	          # When transition mode is on, allow parent_sha mismatch (skip bind)
   721	          # by passing empty string. Default is hard-bind on PARENT_SHA.
   722	          PARENT_SHA_ARG="$PARENT_SHA"
   723	          if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL:-0}" = "1" ]; then
   724	            PARENT_SHA_ARG=""
   725	          fi
   726	          python3 .github/scripts/validate-pair-rail-verdict.py \
   727	            --verdict-file "$VERDICT_FILE" \
   728	            --parent-sha "$PARENT_SHA_ARG" \
   729	            --release-tag "${GITHUB_REF_NAME}" \
   730	            --max-age-hours 24 \
   731	            --recompute-inputs-hash \
   732	            --codex-cli-pin-file .claude/governance/codex-cli-pin.txt \
   733	            --codex-cli-binary-sha256-file .claude/governance/codex-cli-binary-sha256.txt \
   734	            --codex-pin-manifest-file .claude/governance/codex-cli-pin-manifest.json \
   735	            --inputs-hash-paths-file .claude/governance/pair-rail-inputs-hash-manifest.txt
   736	
   737	      # ==========================================================
   738	      # PLAN-166 W1-B — verdict delta + ancestry gate (F2 server side)
   739	      # ==========================================================
   740	      # Re-pass findings r15 + r17 + r18 (PLAN-166), debate r3 scoped VETO.
   741	      #
   742	      # WHY A SEPARATE STEP: the step-15 neighbourhood above carries two
   743	      # escape hatches keyed to CEO_PAIR_RAIL_VERDICT_OPTIONAL —
   744	      # `continue-on-error:` on the step itself, and an empty
   745	      # `--parent-sha ""` bind (the validator only binds the field when
