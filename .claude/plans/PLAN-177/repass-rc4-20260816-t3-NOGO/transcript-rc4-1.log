  1052	install_lib_selective() {
  1053	  echo ""
  1054	  echo "==> Installing hooks/_lib (runtime only — tests/, test_isolation.py, testing.py excluded)"
  1055	  local e base preexisting
  1056	  for e in "$SOURCE_DIR/.claude/hooks/_lib/"*; do
  1057	    [[ -e "$e" ]] || continue
  1058	    base="$( basename "$e" )"
  1059	    # PLAN-161 U2 (CF-7): route through the ONE canonical framework-internal
  1060	    # exclusion predicate (scripts/_framework_manifest_set.sh) so install and
  1061	    # upgrade can never drift apart again. Behavior identical to the previous
  1062	    # literal case; the fallback case below only serves a partial checkout
  1063	    # where the helper file was absent at source time (fail-open parity).
  1064	    if command -v _framework_path_excluded >/dev/null 2>&1; then
  1065	      if _framework_path_excluded ".claude/hooks/_lib/$base"; then continue; fi
  1066	    else
  1067	      case "$base" in
  1068	        tests|test_isolation.py|testing.py|__pycache__) continue ;;
  1069	      esac
  1070	    fi
  1071	    preexisting=0
  1072	    [[ -e "$TARGET/.claude/hooks/_lib/$base" || -L "$TARGET/.claude/hooks/_lib/$base" ]] && preexisting=1
  1073	    install_one ".claude/hooks/_lib/$base"
  1074	    # PLAN-161 U2 (codex r1 F7): only a directory we JUST copied is pruned —
  1075	    # a pre-existing (EXISTS-skipped) adopter dir is left untouched, link
  1076	    # mode installs a symlink (the prune helper refuses symlink roots), and
  1077	    # dry-run copies nothing.
  1078	    if [[ "$DRY_RUN" -eq 0 && "$MODE" != "link" && "$preexisting" -eq 0 && -d "$e" && ! -L "$e" ]]; then
  1079	      _prune_pycache_under "$TARGET/.claude/hooks/_lib/$base"
  1080	    fi
  1081	  done
  1082	}
