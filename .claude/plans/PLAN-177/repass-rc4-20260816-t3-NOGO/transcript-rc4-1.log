   335	def _sha256(path: str) -> str:
   336	    h = hashlib.sha256()
   337	    with open(path, "rb") as fh:
   338	        for chunk in iter(lambda: fh.read(65536), b""):
   339	            h.update(chunk)
   340	    return h.hexdigest()
