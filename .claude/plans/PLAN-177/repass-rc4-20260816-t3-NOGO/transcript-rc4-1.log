   195	    def test_space_before_colon_duplicate_is_refused(self):
   196	        r = self._run_decisions(["verdict : NO-GO", "verdict: GO"])
   197	        self.assertEqual(r.returncode, EXIT_VERDICT_INVALID, msg=r.stderr)
   198	        self.assertIn(self.DIAGNOSTIC, r.stderr)
   199	        self.assertNotIn("Traceback", r.stderr)
   200	
   201	    def test_tab_before_colon_duplicate_is_refused(self):
   202	        r = self._run_decisions(["verdict\t: NO-GO", "verdict: GO"])
   203	        self.assertEqual(r.returncode, EXIT_VERDICT_INVALID, msg=r.stderr)
   204	        self.assertIn(self.DIAGNOSTIC, r.stderr)
   205	
   206	    def test_single_noncanonical_key_is_refused(self):
   207	        """Not only the duplicate shape: a lone `verdict : GO` is a spelling
