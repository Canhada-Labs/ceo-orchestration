   307	def _count_top_level_key(text: str, key: str) -> int:
   308	    """How many times `key:` is declared at the top level of the block.
   309	
   310	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   311	    step-15 reader: a second `verdict:` silently overrides the first, so
   312	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   313	    block selection and same comment rule as the reader, or the count
   314	    would be about a different text than the parse.
   315	
   316	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   317	    counter does NOT strip the key and the step-15 twin does, so on a
   318	    non-canonical block the two counts differ. delta() checks the shape
   319	    first.
   320	    """
   321	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   322	    if block is None:
   323	        return 0
   324	    seen = 0
   325	    for raw in block.group(1).splitlines():
   326	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   327	        if not line.strip() or line[0] in (" ", "\t"):
   328	            continue
   329	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   330	        if m and m.group(1) == key:
   331	            seen += 1
   332	    return seen
