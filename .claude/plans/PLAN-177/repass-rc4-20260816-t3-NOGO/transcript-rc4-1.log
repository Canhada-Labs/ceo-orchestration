   996	# NOTE (PLAN-003 Phase 0 I-4): hooks/ and scripts/ are installed
   997	# SELECTIVELY — only top-level files + hooks/_lib/ are shipped to
   998	# targets. Framework-internal directories excluded:
   999	#
  1000	#   .claude/hooks/tests/      — 89 unit tests for the framework itself
  1001	#   .claude/hooks/legacy/     — Sprint 1 bash fallbacks (removed in
  1002	#                                Sprint 3 Item C once invariants met)
  1003	#   .claude/scripts/tests/    — 74 unit tests for audit-query,
  1004	#                                run-skill-benchmark, check-tier-boundaries
  1005	#
  1006	# Rationale: targets don't need our tests or fallbacks — they add ~100
  1007	# files of bloat. Target installs should only carry the ACTIVE runtime
  1008	# surface: _lib/, _python-hook.sh, active Python hooks, and active
  1009	# scripts. New hooks added at the top level (e.g. check_bash_safety.py
  1010	# in I-5a) are picked up automatically by the *.py/*.sh glob below.
  1011	
  1012	# PLAN-120-FOLLOWUP WS-D (E4-F1/E4-F2) — install _lib/ SELECTIVELY. A flat
  1013	# `install_one .claude/hooks/_lib` does cp -R (or a whole-tree symlink),
  1014	# which drags the framework's OWN test harness into the adopter runtime:
  1015	# _lib/tests/ (emits real audit events with no session redirect — no
  1016	# conftest ships) + test_isolation.py / testing.py (both `import pytest`
  1017	# at module top). We iterate the top-level _lib entries and skip exactly
  1018	# those three names; everything else (all runtime *.py + the runtime
  1019	# subdirs adapters/ estimation/ federation/ mcp/ otel/ tier_policy/ +
  1020	# __init__.py) ships. New runtime modules are picked up automatically by
  1021	# the glob, matching the install_scripts_selective convention.
  1022	# PLAN-161 U2 (codex r1 F7): prune nested __pycache__/ dirs + *.pyc files
  1023	# under a freshly-copied destination directory. The exclusion predicate above
  1024	# screens only TOP-LEVEL _lib entries; a permitted SUBDIRECTORY (e.g.
  1025	# _lib/adapters) is cp -R'd wholesale, dragging nested __pycache__ dirs and
  1026	# .pyc files the predicate declares globally excluded. Per-file delete +
  1027	# rmdir only — NEVER rm -rf. Refuses to operate through a symlink root
  1028	# (link-mode dst is a symlink into the SOURCE tree). Fail-open: every step
  1029	# is guarded; never changes the install exit status.
  1030	_prune_pycache_under() {
  1031	  local _pp_root="$1" _pp_d _pp_f
  1032	  [[ -d "$_pp_root" && ! -L "$_pp_root" ]] || return 0
  1033	  # 1) *.pyc files anywhere under the copied destination (find without -L:
  1034	  #    symlinks are never followed).
  1035	  while IFS= read -r _pp_f; do
  1036	    [[ -n "$_pp_f" ]] || continue
  1037	    rm -f "$_pp_f" 2>/dev/null || true
  1038	  done < <( find "$_pp_root" -type f -name '*.pyc' -print 2>/dev/null )
  1039	  # 2) __pycache__ dirs, deepest first (-depth): delete their files one by
  1040	  #    one, then rmdir. A dir still holding anything unexpected simply stays.
  1041	  while IFS= read -r _pp_d; do
  1042	    [[ -n "$_pp_d" && -d "$_pp_d" && ! -L "$_pp_d" ]] || continue
  1043	    while IFS= read -r _pp_f; do
  1044	      [[ -n "$_pp_f" ]] || continue
  1045	      rm -f "$_pp_f" 2>/dev/null || true
  1046	    done < <( find "$_pp_d" \( -type f -o -type l \) -print 2>/dev/null )
  1047	    rmdir "$_pp_d" 2>/dev/null || true
  1048	  done < <( find "$_pp_root" -depth -type d -name '__pycache__' -print 2>/dev/null )
  1049	  return 0
  1050	}
