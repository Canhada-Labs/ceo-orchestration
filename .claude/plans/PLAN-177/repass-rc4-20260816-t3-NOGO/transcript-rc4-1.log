   268	def _noncanonical_top_level_lines(text: str) -> List[str]:
   269	    """Top-level lines of the yaml block that are not canonical declarations.
   270	
   271	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   272	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   273	    separate machines; neither may import the other — keep them identical).
   274	    Empty list == the block speaks the grammar both readers assume.
   275	    """
   276	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   277	    if block is None:
   278	        return []
   279	    bad: List[str] = []
   280	    prev_scalar_decl = False
   281	    for raw in block.group(1).splitlines():
   282	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   283	        if not line.strip():
   284	            continue
   285	        if line[0] in (" ", "\t"):
   286	            # Sub-level line. Legitimate ONLY under a parent declared as a
   287	            # bare `key:` (mapping/list). After a SCALAR `key: value`, an
   288	            # indented non-comment line is a YAML CONTINUATION that changes
   289	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   290	            # while this minimal reader still saw `GO` — reject fail-closed
   291	            # (re-pass rc.4 t2 P1).
   292	            if prev_scalar_decl:
   293	                bad.append(line)
