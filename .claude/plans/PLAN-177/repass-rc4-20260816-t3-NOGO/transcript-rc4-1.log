   232	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   233	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   234	    if not manifest_path.exists():
   235	        raise FileNotFoundError(f"manifest: {manifest_path}")
   236	    paths = []
   237	    for line in manifest_path.read_text().splitlines():
   238	        line = line.split("#", 1)[0].strip()
   239	        if line:
   240	            paths.append(line)
   241	    paths.sort()
   242	    hashes = {}
   243	    for p in paths:
   244	        result = subprocess.run(
   245	            ["git", "hash-object", p],
   246	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   247	        )
   248	        if result.returncode != 0:
   249	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   250	        hashes[p] = result.stdout.strip()
   251	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   252	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   253	
   254	
   255	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   256	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   257	    if not pin_file.exists():
   258	        return None, None
   259	    for line in pin_file.read_text().splitlines():
   260	        line = line.split("#", 1)[0].strip()
   261	        if not line:
   262	            continue
   263	        # parse `>=X.Y.Z,<A.B.C` shape
   264	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   265	        if m:
   266	            return m.group(1), m.group(2)
   267	    return None, None
   268	
   269	
   270	def parse_semver(s: str) -> Tuple[int, int, int]:
   271	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   272	    if not m:
   273	        raise ValueError(f"unparseable semver: {s!r}")
   274	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   275	
   276	
   277	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   278	    try:
   279	        v = parse_semver(version)
   280	        lo = parse_semver(min_v)
   281	        hi = parse_semver(max_v)
   282	        return lo <= v < hi
   283	    except ValueError:
   284	        return False
