  2204	def test_checklist_attributes_repo_exhaustiveness_to_the_scanner():
  2205	    """The checklist read as a census OF THE REPOSITORY while it was a census
  2206	    of the driver's TABLE — which is why `npm/INTEGRITY.md` could hold a stale
  2207	    version and the checklist still be, on its own terms, true. It now says
  2208	    which instrument answers for the repo, and names the roots that
  2209	    instrument scans; adding a root without documenting it goes red here."""
  2210	    text = (REPO_ROOT / ".github/release-checklist.md").read_text(encoding="utf-8")
  2211	    assert "SCAN_ROOTS" in text, "the checklist names no repo-wide instrument"
  2212	    missing = [root for root in SCAN_ROOTS if root not in text]
  2213	    assert not missing, "SCAN_ROOTS entries undocumented in the checklist: %s" % missing
  2214	    # the assertion above can only mean something if it is falsifiable — a root
  2215	    # that is NOT in the tuple must be absent from the prose.
  2216	    assert "docs/formal-verification" not in text
  2217	
