def _env(home: Path) -> Dict[str, str]:
    """A subprocess environment that cannot reach the real HOME or repo."""
    env = dict(os.environ)
    for key in ("CLAUDE_PROJECT_DIR", "GIT_DIR", "GIT_WORK_TREE"):
        env.pop(key, None)
