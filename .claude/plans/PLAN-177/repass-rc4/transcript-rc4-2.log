   239	      # fixes are in-tree — land atomically with them).
   240	      - name: Upgrade oracle — --dry-run identity (U1)
   241	        run: |
   242	          set -euo pipefail
   243	          bash scripts/tests/test-upgrade-dryrun-identity.sh
   244	
