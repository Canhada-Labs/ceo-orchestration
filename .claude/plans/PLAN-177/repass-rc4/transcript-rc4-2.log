  1601	def test_integrity_contract_rows_name_a_live_step():
  1602	    """P1-3. The contract claimed a per-tarball SHA-256 manifest was
  1603	    "enforced today" and pointed at `validate.yml (to-add)`: a guarantee whose
  1604	    alleged gate could not fail because it did not exist. A row now declares a
  1605	    Status from a closed set, and an `enforced` one must name a step that is
  1606	    really in the YAML."""
  1607	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1608	    rows = _contract_rows(doc)
  1609	    assert len(rows) >= 5, "Contract table parsed as %d rows" % len(rows)
  1610	
  1611	    pairs = _integrity_enforced_pairs(doc)
  1612	    assert len(pairs) >= _MIN_ENFORCED_PAIRS, (
  1613	        "only %d enforced (workflow, step) claims parsed — below the floor of "
  1614	        "%d. Either the table stopped documenting enforcement, or its format "
  1615	        "changed and this gate is now checking nothing."
  1616	        % (len(pairs), _MIN_ENFORCED_PAIRS)
  1617	    )
  1618	
  1619	    # (a) a renamed step must go red. The fixture is DERIVED from the parsed
  1620	    # table, never a hand-typed row literal: an anchor typed here stops
  1621	    # matching the day that row is edited, and the control dies quietly.
  1622	    step = pairs[0][2]
  1623	    renamed = doc.replace('step "%s"' % step, 'step "%s renamed"' % step, 1)
  1624	    assert renamed != doc, "rename fixture did not patch the doc"
  1625	    renamed_offenders = _integrity_contract_offenders(renamed, REPO_ROOT)
  1626	    assert any("renamed" in o for o in renamed_offenders), (
  1627	        "control did not flag a row naming a nonexistent step: %s"
  1628	        % renamed_offenders
  1629	    )
  1630	
  1631	    # (b) a table with NO parseable step claim must go red on the COUNT, not
  1632	    # report zero offenders. That is the vacuity failure itself.
  1633	    stripped = doc.replace('step "', "step ")
  1634	    assert len(_integrity_enforced_pairs(stripped)) < _MIN_ENFORCED_PAIRS, (
  1635	        "a table with no parseable step claim still met the floor — the count "
  1636	        "check cannot detect vacuity"
  1637	    )
  1638	
  1639	    # (c) unknown Status vocabulary must go red, not be waved through.
  1640	    unknown = doc.replace("| enforced |", "| mostly enforced |", 1)
  1641	    assert unknown != doc, "status fixture did not patch the doc"
  1642	    assert any(
  1643	        "outside the closed set" in o
  1644	        for o in _integrity_contract_offenders(unknown, REPO_ROOT)
  1645	    ), "an unknown Status was accepted"
  1646	
  1647	    offenders = _integrity_contract_offenders(doc, REPO_ROOT)
  1648	    assert not offenders, "npm/INTEGRITY.md contract row without a live step:\n%s" % (
  1649	        "\n".join(offenders)
  1650	    )
