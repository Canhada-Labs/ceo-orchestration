    72	# Internal: is profile $1 present in the active profile list?
    73	_fms_has_profile() {
    74	  _fms_want="$1"
    75	  _fms_p=""
    76	  for _fms_p in $( _fms_profile_parts ); do
    77	    if [ "$_fms_p" = "$_fms_want" ]; then
    78	      return 0
    79	    fi
    80	  done
    81	  return 1
    82	}
