   132	jobs:
   133	  smoke:
   134	    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity.
   135	    if: vars.CEO_SOTA_DISABLE != '1'
   136	    runs-on: ubuntu-latest
   137	    # PLAN-161: 5 -> 8 — headroom for the two upgrade oracles (each runs
   138	    # full install + upgrade legs against fixture adopter repos).
   139	    # PLAN-166 F4: 8 -> 20. MEASURED, not guessed. The parity e2e runs 2 full
   140	    # install legs + 1 upgrade leg PER ceremony mode, and the positive control
   141	    # runs the same again with a planted divergence: 12 install/upgrade
   142	    # operations added to this job. Local wall time (Darwin arm64, 16 cores,
   143	    # 2026-08-05): gate 122s + control 118s = 240s. A 2-core ubuntu-latest
   144	    # runner is the usual 2-3x slower, i.e. 8-12 min of NEW work on top of the
   145	    # ~5 min this job already spent. 15 would sit inside the noise band, and
   146	    # the perf-gate N=20 flake (PLAN-159) was exactly that mistake. Re-tighten
   147	    # once real CI runs give a p95.
   148	    # PLAN-166 F3 (assembler): 20 -> 25. The spec-ownership e2e adds 4 more
   149	    # installs + 3 upgrades (S1-S8; ~3-4 min local per the W1-C measurement),
   150	    # i.e. up to ~8-10 more CI minutes at the same 2-3x factor. Same
   151	    # anti-flake sizing rule as the F4 bump above.
   152	    # PLAN-177 W1 (CF-9): 25 -> 32. The night-mode efficacy e2e adds 3 installs
   153	    # + 2 upgrades. MEASURED, not guessed: 2m06s wall on Darwin arm64 (16
   154	    # cores, 2026-08-13), reproduced across two runs. At the same 2-3x runner
   155	    # factor this workflow already sizes with, that is 4-7 CI minutes, so +7.
   156	    # A job-level timeout that clips a green run reports as `cancelled` on an
   157	    # innocent step (the S2xx lesson), so the margin stays deliberate.
   158	    timeout-minutes: 32
   159	    permissions:
   160	      contents: read
   161	    steps:
   162	      - name: Checkout
   163	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   164	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   165	        with:
   166	          fetch-depth: 1
   167	
   168	      # PLAN-166 F4: the parity e2e's historical leg installs from a PINNED
   169	      # TAG. `fetch-depth: 1` produces a checkout with NO tags, so the pin
   170	      # would not resolve and the gate would die before comparing a single
   171	      # tree - "it passes on my clone" is precisely the hole this test exists
   172	      # to close. The pin is READ FROM THE TEST (--print-pin) so the workflow
   173	      # never becomes a second copy of that truth.
   174	      - name: Fetch the parity pin tag
   175	        run: |
   176	          set -euo pipefail
   177	          PIN="$(bash scripts/tests/test-install-upgrade-parity-e2e.sh --print-pin)"
   178	          echo "parity historical pin: $PIN"
   179	          git fetch --no-tags --depth 1 origin "+refs/tags/$PIN:refs/tags/$PIN"
   180	          git rev-parse --verify "refs/tags/$PIN^{commit}"
   181	
   182	      - name: Setup Python 3.11
   183	        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
   184	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
   185	        with:
   186	          python-version: "3.11"
   187	
   188	      - name: Install jq (for settings.json merge)
   189	        run: |
   190	          set -euo pipefail
   191	          if ! command -v jq >/dev/null 2>&1; then
   192	            sudo apt-get update -qq
   193	            sudo apt-get install -y -qq jq
   194	          fi
   195	          jq --version
   196	
   197	      # PLAN-168 W1 (AC-4, per-PR half): the DECISION oracle —
   198	      # _ownership_verdict() against every truth-table cell, in milliseconds.
   199	      # The OBSERVATION half (the ~25-min e2e) runs in ownership-nightly.yml;
   200	      # this fast half is what makes table/harness PRs cheap to gate.
   201	      - name: Ownership verdict unit oracle (milliseconds)
   202	        run: |
   203	          set -euo pipefail
   204	          bash scripts/tests/test-ownership-verdict-unit.sh
   205	
   206	      # Re-pass rc.4 t7 P2 (t6 condition 5): the gitignore symlink-refusal +
