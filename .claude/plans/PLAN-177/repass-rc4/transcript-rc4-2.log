  1346	# ===========================================================================
  1347	# PLAN-177 W0 — the npm/ surfaces: a version nobody watched (P1-2) and an
  1348	# "enforced today" guarantee with no step behind it (P1-3).
  1349	# ===========================================================================
  1350	
  1351	# The npm docs are DERIVED from SCAN_ROOTS, not re-typed: adding a third npm
  1352	# surface up there extends this rule too, and the two lists cannot drift.
  1353	# What stays out, and why the predicate is narrow ON PURPOSE:
  1354	#   * `npm/SHA256SUMS.txt` records tarball FILENAMES
  1355	#     (`ceo-orchestration-<version>.tgz`) — historical data about a build that
  1356	#     happened, not a claim about the current release. Flagging it would train
  1357	#     whoever hits the red to add an exemption, and an exemption is how a
  1358	#     control stops controlling.
  1359	#   * `npm/.npmignore` cites past packaging incidents by the version they
  1360	#     happened in — same category.
  1361	#   * `npm/package.json` is a real bump site with a real oracle
  1362	#     (`_release_bump_sites.py` + verify-counts); it is written, not stale.
  1363	# Prose in a shipped `.md` is the only one that can go stale silently, which
  1364	# is exactly what happened.
  1365	NPM_DOC_SURFACES = tuple(
  1366	    root for root in SCAN_ROOTS if root.startswith("npm/") and root.endswith(".md")
  1367	)
  1368	# The one legitimate version literal in an npm doc: the review stamp, itself a
  1369	# bump site (`("npm/README.md", STAMP, STAMP_RX)`), so it has an oracle.
  1370	_STAMP_LINE_RX = re.compile(r"last-reviewed:\s*\d{4}-\d{2}-\d{2}\s+v\d+\.\d+\.\d+")
  1371	
  1372	
  1373	def _bare_version_offenders_in_npm_docs(repo_root: Path) -> List[str]:
  1374	    """Bare `X.Y.Z` in a scanned npm doc, outside a review stamp. Takes the
  1375	    root as an ARGUMENT so the positive control can plant the defect in a tmp
  1376	    tree and never write into the repo under test."""
  1377	    offenders: List[str] = []
  1378	    for rel in NPM_DOC_SURFACES:
  1379	        path = repo_root / rel
  1380	        if not path.is_file():
  1381	            continue
  1382	        try:
  1383	            body = path.read_text(encoding="utf-8")
  1384	        except (UnicodeDecodeError, OSError):
  1385	            continue
  1386	        for num, line in enumerate(body.splitlines(), 1):
  1387	            # Re-pass rc.4 t6-cond-1 / t7 P2: remove ONLY the stamp
  1388	            # substring and scan the remainder — skipping the whole line
  1389	            # let `currently 9.9.9 <!-- last-reviewed ... -->` ride a
  1390	            # valid stamp on the same line.
  1391	            scannable = _STAMP_LINE_RX.sub("", line)
  1392	            for hit in SEMVER_RX.findall(scannable):
  1393	                offenders.append("%s:%d: %s (%s)" % (rel, num, line.strip(), hit))
  1394	    return offenders
  1395	
