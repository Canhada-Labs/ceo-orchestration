  1458	def _yaml_step_names(path: Path) -> List[str]:
  1459	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1460	    call site: a substring match would accept "Verify VERSION" for a step
  1461	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1462	    already cost this repo three incidents in one session."""
  1463	    text = path.read_text(encoding="utf-8")
  1464	    names = []
  1465	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1466	        name = m.group(1)
  1467	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1468	            name = name[1:-1]
  1469	        names.append(name)
  1470	    return names
