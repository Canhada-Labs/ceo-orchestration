   950	    "# Per-machine posture + runtime state that must never reach VCS:" \
   951	    "#   state/             runtime state as a whole (PLAN-163 T3.1)" \
   952	    "#   settings.local.json  permission overlay deciding the NEXT session's" \
   953	    "#                        posture (PLAN-165)" \
   954	    "#" \
   955	    "# The root .gitignore carries the same exclusions for adopters who track" \
   956	    "# this tree from the repository root. This file additionally covers the" \
   957	    "# --ceremony user install, which never writes outside .claude/ and so" \
   958	    "# never received them." \
   959	    "#" \
   960	    "# Adopter-owned once created: install and upgrade never REPLACE this" \
   961	    "# file — adopter bytes are preserved; missing mandatory framework" \
   962	    "# security entries may be APPENDED (additively reasserted) on upgrade." \
   963	    "/state/" \
   964	    "/settings.local.json"
   965	}
