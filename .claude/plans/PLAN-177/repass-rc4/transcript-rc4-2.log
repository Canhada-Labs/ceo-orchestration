   234	    def write_project_file(self, relative: str, content: str) -> Path:
   235	        """Write a file under self.project_dir, creating parents as needed."""
   236	        target = self.project_dir / relative
   237	        target.parent.mkdir(parents=True, exist_ok=True)
   238	        target.write_text(content, encoding="utf-8")
   239	        return target
   240	
   241	    def write_audit_file(self, relative: str, content: str) -> Path:
   242	        """Write a file under self.audit_dir (the isolated audit dir)."""
   243	        target = self.audit_dir / relative
   244	        target.parent.mkdir(parents=True, exist_ok=True)
   245	        target.write_text(content, encoding="utf-8")
   246	        return target
   247	
   248	    def read_audit_log(self) -> str:
   249	        """Read the audit log contents (empty string if missing)."""
   250	        log_path = self.audit_dir / "audit-log.jsonl"
   251	        if not log_path.is_file():
   252	            return ""
   253	        return log_path.read_text(encoding="utf-8")
   254	
   255	    def read_audit_errors(self) -> str:
   256	        """Read the audit errors breadcrumb file."""
   257	        err_path = self.audit_dir / "audit-log.errors"
   258	        if not err_path.is_file():
   259	            return ""
   260	        return err_path.read_text(encoding="utf-8")
