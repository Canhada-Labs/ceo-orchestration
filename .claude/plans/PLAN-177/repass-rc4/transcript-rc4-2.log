    84	# _framework_path_excluded — PLAN-161 U2 (CF-7): the SINGLE canonical
    85	# framework-internal exclusion predicate. $1 = repo-relative path. Returns 0
    86	# (excluded) for content the framework NEVER ships to adopters — the dogfood
    87	# test/legacy trees, the two pytest-importing _lib helpers, __pycache__ dirs
    88	# and *.pyc anywhere. Also matches the bare directory paths themselves (no
    89	# trailing slash/content) so callers can test dirs. Mirrors install.sh's
    90	# structural exclusions (install_hooks_selective / install_lib_selective /
    91	# install_scripts_selective); install.sh's _lib walk now calls THIS predicate,
    92	# and upgrade.sh applies it at its three write surfaces (classified union
    93	# walk, legacy cp -R prune, manifest enumeration below).
    94	# bash 3.2-safe: pure case globs, no arrays.
    95	_framework_path_excluded() {
    96	  case "$1" in
    97	    .claude/hooks/tests|.claude/hooks/tests/*) return 0 ;;
    98	    .claude/hooks/legacy|.claude/hooks/legacy/*) return 0 ;;
    99	    .claude/scripts/tests|.claude/scripts/tests/*) return 0 ;;
   100	    .claude/hooks/_lib/tests|.claude/hooks/_lib/tests/*) return 0 ;;
   101	    .claude/hooks/_lib/test_isolation.py) return 0 ;;
   102	    .claude/hooks/_lib/testing.py) return 0 ;;
   103	    __pycache__|*/__pycache__|__pycache__/*|*/__pycache__/*) return 0 ;;
   104	    *.pyc) return 0 ;;
   105	  esac
   106	  return 1
   107	}
   108	
   109	# _framework_target_entries — the top-level target relpaths (files + dirs),
   110	# profile-aware, sorted + deduped. This is the STATIC intended set; it does not
   111	# touch disk (so install and upgrade derive an identical list regardless of
   112	# what is currently present).
   113	_framework_target_entries() {
   114	  {
   115	    # Root governance pointer (the verified S238 driver target — outside
   116	    # .claude/). PLAN-166 F3 (ADR-155-AMEND-1): CONDITIONAL on the recorded
   117	    # delivery. A `--ceremony user` install SKIPS install_protocol_pointer
   118	    # (install.sh WS4-guard-proto), and a maintainer target that ALREADY had
   119	    # its own root PROTOCOL.md was never written by the framework —
   120	    # enumerating it unconditionally records the ADOPTER's file as
   121	    # framework-owned (r13/r17).
   122	    if [ "${FMS_DELIVERED_PROTOCOL:-0}" = "1" ]; then
   123	      printf '%s\n' "PROTOCOL.md"
   124	    fi
   125	
   126	    # SPEC/v1 published contract (PLAN-166 F3): an upgrade surface as of
   127	    # v1.3.0 — same delivery-record condition (never ceremony alone, never
   128	    # file presence; r7/r17).
   129	    if [ "${FMS_DELIVERED_SPEC:-0}" = "1" ]; then
   130	      printf '%s\n' "SPEC/v1"
   131	    fi
   132	
   133	    # Framework version marker (PLAN-166 F3): a NORMAL tracked-file entry —
   134	    # present in the source tree, so the FMS_HASH_ROOT baseline rewrite
   135	    # (below) preserves it with no generated-file special-case — but
   136	    # ownership still derives from the registered delivery: a target whose
   137	    # marker pre-existed (install_one EXISTS-skip) stays adopter-owned and
   138	    # every marker-first reader keyed off this same record falls back to
   139	    # VERSION (r20).
   140	    if [ "${FMS_DELIVERED_MARKER:-0}" = "1" ]; then
   141	      printf '%s\n' ".claude/.framework-version"
   142	    fi
   143	
   144	    # Always-installed team rosters + universal catalogs.
   145	    printf '%s\n' ".claude/team.md"
   146	    printf '%s\n' ".claude/frontend-team.md"
   147	    printf '%s\n' ".claude/pitfalls-catalog.yaml"
   148	    printf '%s\n' ".claude/task-chains.yaml"
   149	    # Framework schema contracts (re-pass rc.4 t5 P1, t8 P1): enumerated so
   150	    # the NEXT generation's baseline manifest classifies them 3-state — but
   151	    # ONLY when this run actually DELIVERED them (install_one wrote, or the
   152	    # upgrade's hash-gated refresh installed/refreshed/found-identical
   153	    # bytes). Same delivery-record condition as PROTOCOL.md/SPEC above:
   154	    # never file presence. An EXISTS-skipped adopter-customized schema in
   155	    # the manifest would record the ADOPTER's bytes as framework-owned, and
   156	    # a later uninstall would see the matching hash and DELETE it (t8 P1).
   157	    if [ "${FMS_DELIVERED_PLAN_SCHEMA:-0}" = "1" ]; then
   158	      printf '%s\n' ".claude/plans/PLAN-SCHEMA.md"
   159	    fi
   160	    if [ "${FMS_DELIVERED_DEBATE_SCHEMA:-0}" = "1" ]; then
   161	      printf '%s\n' ".claude/plans/DEBATE-SCHEMA.md"
   162	    fi
   163	
   164	    # Protocol-enforcement directory targets (always installed).
   165	    printf '%s\n' ".claude/hooks"
   166	    printf '%s\n' ".claude/scripts"
   167	    printf '%s\n' ".claude/commands"
   168	
   169	    # Skills are profile-gated.
   170	    if _fms_has_profile "core"; then
   171	      printf '%s\n' ".claude/skills/core"
   172	    fi
   173	    if _fms_has_profile "frontend"; then
   174	      printf '%s\n' ".claude/skills/frontend"
   175	    fi
   176	    # Domain profiles: any profile part that is neither core nor frontend.
   177	    for _fms_part in $( _fms_profile_parts ); do
   178	      case "$_fms_part" in
   179	        core|frontend) : ;;
   180	        *) printf '%s\n' ".claude/skills/domains/$_fms_part" ;;
   181	      esac
   182	    done
   183	  } | LC_ALL=C sort -u
   184	}
   185	
   186	# _framework_manifest_files — expand every target entry into its per-file
   187	# relpaths, relative to FMS_ROOT. Directories are walked (regular files only;
   188	# symlinks are NOT followed into — a symlinked file is emitted as its own
   189	# relpath and the manifest writer records it as a LINK record). EXCLUDES the
   190	# manifest dotfile + .claude.bak/. Sorted + deduped. Missing entries (e.g. a
   191	# profile dir absent on disk) are silently skipped — profile-awareness.
   192	_framework_manifest_files() {
   193	  _fms_root="${FMS_ROOT:-.}"
   194	  {
   195	    _framework_target_entries | while IFS= read -r _fms_entry; do
   196	      [ -n "$_fms_entry" ] || continue
   197	      _fms_abs="$_fms_root/$_fms_entry"
   198	      if [ -f "$_fms_abs" ] || [ -L "$_fms_abs" ]; then
   199	        # A plain file (or symlinked file) target.
   200	        printf '%s\n' "$_fms_entry"
   201	      elif [ -d "$_fms_abs" ]; then
   202	        # Walk the directory for regular files + symlinks. `-print` with a
   203	        # leading "./"-stripped relpath; we re-root each hit at $_fms_entry.
   204	        # bash 3.2-safe: no mapfile; pipe find into a read loop.
   205	        find "$_fms_abs" \( -type f -o -type l \) -print 2>/dev/null | while IFS= read -r _fms_hit; do
   206	          # Strip the "$_fms_root/" prefix to get a repo-relative path.
   207	          _fms_rel="${_fms_hit#"$_fms_root"/}"
   208	          printf '%s\n' "$_fms_rel"
   209	        done
   210	      fi
   211	      # else: entry absent on disk for this profile — skip (profile-aware).
   212	    done
   213	  } | grep -v -e '^\.claude/\.install-manifest\.sha256$' \
   214	            -e '^\.claude\.bak/' \
   215	            -e '/\.claude\.bak/' \
   216	            -e '/__pycache__/' \
   217	            -e '\.pyc$' \
   218	    | while IFS= read -r _fms_out; do
   219	        # PLAN-161 U2 (CF-7): never record framework-internal excluded paths
   220	        # in the baseline — recording them would legitimize a mis-install
   220	        # in the baseline — recording them would legitimize a mis-install
   221	        # (and the upgrade would re-add what an adopter deleted by hand).
   222	        if ! _framework_path_excluded "$_fms_out"; then
   223	          printf '%s\n' "$_fms_out"
   224	        fi
   225	      done \
   226	    | LC_ALL=C sort -u
   227	}
   228	
   229	# _write_baseline_manifest — THE single baseline-manifest generator (ADR-155
   230	# decision (iv)). Called by install.sh write_install_manifest AND by upgrade.sh
   231	# after a successful upgrade, so a long-lived adopter who upgrades but never
   232	# re-runs install.sh acquires/refreshes a manifest.
   233	#
   234	# Inputs (callers export these before calling):
   235	#   FMS_ROOT          — the installed target root (paths are relative to it)
   236	#   FMS_PROFILE_PARTS — space-separated profile list (profile-aware enumeration)
   237	#   FMS_MODE          — "link" to emit LINK records for symlinks, else "copy"
   238	# Requires _hash_file (from _hash_lib.sh) on PATH. Writes validated records to
   239	# $1 (the manifest path) atomically. Fail-open: returns 0 with a stderr NOTE on
   240	# any problem; never aborts the caller.
   241	#
   242	# Grammar:
   243	#   <64hex>  <relpath>          — content hash
   244	#   LINK  <relpath>  <target>   — link-mode symlink (content == source)
   245	
   246	# Does FMS_HASH_ROOT apply to this relpath? UNSET FMS_HASH_ROOT_PATHS means
   247	# ALL of them — the upgrade posture, where every enumerated file must record
   248	# what the framework SHIPS. install.sh needs the opposite default for most of
   249	# the tree: it RENDERS templates (`.claude/team.md`, skills, `{{X}}`
   250	# placeholders under --project et al), so those legitimately differ from
   251	# source and their baseline must be the rendered TARGET. A global
   252	# FMS_HASH_ROOT on an install rerun rewrote every rendered file's hash to the
   253	# unrendered source, which doctor.sh reads as widespread adopter drift and
   254	# later upgrades read as customized => the files stop being refreshed (codex
   255	# W1 round 8, P1). Scoping the override to the ownership-continuity paths
   256	# keeps the round-5 fix (an EDITED delivered SPEC must not be re-baselined as
   257	# framework-owned, or uninstall would delete the adopter's fork) without
   258	# touching the rendered tree. Prefix match: an entry covers the path itself
   259	# and everything under it.
   260	_wbm_hash_root_applies() {
   261	  [ -n "${FMS_HASH_ROOT_PATHS:-}" ] || return 0
   262	  _hra_rel="$1"
   263	  _hra_oldIFS="$IFS"
   264	  IFS='
   265	'
   266	  for _hra_p in $FMS_HASH_ROOT_PATHS; do
   267	    [ -n "$_hra_p" ] || continue
   268	    case "$_hra_rel" in
   269	      "$_hra_p"|"$_hra_p"/*)
   270	        IFS="$_hra_oldIFS"
   271	        return 0
   272	        ;;
   273	    esac
   274	  done
   275	  IFS="$_hra_oldIFS"
   276	  return 1
   277	}
   278	
   279	# May this relpath be serialized as a LINK record? UNSET FMS_LINK_PATHS means
   280	# ANY live symlink may — correct on the INSTALL path, where the installer
   281	# itself created every symlink it is about to record. On the UPGRADE rewrite
   282	# that default is too wide (codex W1 round 10, P2): FMS_MODE=link is inferred
   283	# from the presence of ANY prior LINK record, and every live symlink then
   284	# serializes as a delivery record — including an adopter's OWN symlink
   285	# preserved inside an enumerated directory like `.claude/hooks/`, converting
   286	# an unowned path into framework-managed content that doctor.sh polices.
   287	# upgrade.sh passes the exact set of pre-upgrade LINK relpaths instead.
   288	_wbm_link_allowed() {
   289	  [ -n "${FMS_LINK_PATHS:-}" ] || return 0
   290	  _wla_rel="$1"
   291	  _wla_oldIFS="$IFS"
   292	  IFS='
   293	'
   294	  for _wla_p in $FMS_LINK_PATHS; do
   295	    [ -n "$_wla_p" ] || continue
   296	    if [ "$_wla_rel" = "$_wla_p" ]; then
   297	      IFS="$_wla_oldIFS"
   298	      return 0
   299	    fi
   300	  done
   301	  IFS="$_wla_oldIFS"
   302	  return 1
   303	}
   304	
   305	# --- PLAN-167 W2.3: the DECISION reaches the generator ----------------------
   306	# _ownership_verdict chooses a hash_source per conditional surface; the writer
   307	# obeys it instead of falling back to a default. Across all 62 rows of the
   308	# table the default (HASH_TARGET) is never the correct answer, and it is
   309	# exactly what let three P1 defects re-baseline adopter content as
   310	# framework-owned (docs §3.4).
   311	_wbm_declared_hash_source() {
   312	  case "$1" in
   313	    SPEC/v1|SPEC/v1/*)          printf '%s' "${FMS_HASH_SOURCE_SPEC:-}" ;;
   314	    PROTOCOL.md)                printf '%s' "${FMS_HASH_SOURCE_PROTOCOL:-}" ;;
   315	    .claude/.framework-version) printf '%s' "${FMS_HASH_SOURCE_MARKER:-}" ;;
   316	    *)                          printf '' ;;
   317	  esac
   318	}
   319	
   320	_wbm_is_conditional() {
   321	  case "$1" in
   322	    SPEC/v1|SPEC/v1/*|PROTOCOL.md|.claude/.framework-version) return 0 ;;
   323	  esac
   324	  return 1
   325	}
   326	
   327	# The digest the PRE-run manifest recorded. Empty when unavailable, which the
   328	# fail-closed branch turns into "do not record" rather than a guess.
   329	_wbm_prior_digest() {
   330	  [ -n "${FMS_PRIOR_MANIFEST:-}" ] && [ -f "$FMS_PRIOR_MANIFEST" ] || { printf ''; return 0; }
   331	  grep -E "^[0-9a-f]{64}  $1\$" "$FMS_PRIOR_MANIFEST" 2>/dev/null | head -1 | cut -d' ' -f1 || printf ''
   332	}
   333	
   334	_write_baseline_manifest() {
   335	  _wbm_manifest="$1"
   336	  if ! command -v _framework_manifest_files >/dev/null 2>&1 \
   337	     || ! command -v _hash_file >/dev/null 2>&1; then
   338	    echo "    NOTE: baseline manifest skipped — hash/enumeration helpers not sourced" >&2
   339	    return 0
   340	  fi
   341	  : "${FMS_ROOT:?_write_baseline_manifest requires FMS_ROOT}"
   342	  # FMS_HASH_ROOT (optional): hash the FRAMEWORK version of each file from here
   343	  # instead of FMS_ROOT. The ENUMERATION still walks FMS_ROOT (what the target
   344	  # holds), but the recorded baseline must be what the framework SHIPS — never
   345	  # an adopter-customized target file. Without this, upgrade.sh's post-upgrade
   346	  # rewrite (C.7) records hash(customized-but-preserved file) as the baseline,
   347	  # which the NEXT upgrade reads as H_dst==H_base => FRAMEWORK-CHANGED => clobber
   348	  # (the verified C.5 idempotency failure). Default = FMS_ROOT (install path,
   349	  # where the target IS the freshly-written framework version). The root
   350	  # PROTOCOL.md is GENERATED (a pointer), not a source copy, so it always hashes
   351	  # from FMS_ROOT (the target pointer), never FMS_HASH_ROOT. (Codex R1 + dry-run)
   352	  _wbm_hash_root="${FMS_HASH_ROOT:-$FMS_ROOT}"
   353	
   354	  _wbm_tmp="$( mktemp "$_wbm_manifest.XXXXXX" 2>/dev/null )" || {
   355	    echo "    NOTE: baseline manifest skipped (mktemp failed) — advisory only" >&2
   356	    return 0
   357	  }
   358	
   359	  _framework_manifest_files | while IFS= read -r _wbm_rel; do
   360	    [ -n "$_wbm_rel" ] || continue
   361	    _wbm_abs="$FMS_ROOT/$_wbm_rel"
   362	    # Drop relpaths carrying control chars (line-based manifest).
   363	    case "$_wbm_rel" in
   364	      *[$'\n\r\t']*) continue ;;
   365	    esac
   366	    if [ "${FMS_MODE:-copy}" = "link" ] && [ -L "$_wbm_abs" ] \
   367	       && _wbm_link_allowed "$_wbm_rel"; then
   368	      _wbm_target="$( readlink "$_wbm_abs" 2>/dev/null || true )"
   369	      [ -n "$_wbm_target" ] || continue
   370	      case "$_wbm_target" in
   371	        *[$'\n\r\t']*) continue ;;
   372	      esac
   373	      printf 'LINK  %s  %s\n' "$_wbm_rel" "$_wbm_target" >> "$_wbm_tmp"
   374	    elif [ -f "$_wbm_abs" ]; then
   375	      if [ "$_wbm_rel" = "PROTOCOL.md" ]; then
   376	        # Generated pointer. Use the CANONICAL pointer hash (FMS_PROTOCOL_HASH,
   377	        # exported by upgrade.sh _refresh_protocol_pointer) so a PRESERVED
   378	        # adopter-customized PROTOCOL.md is NOT re-recorded as its own baseline
   379	        # (Codex R2 P0 — else the next upgrade reads H_dst==H_base and clobbers
   380	        # it). On install (no FMS_PROTOCOL_HASH) the target IS the freshly
   381	        # written pointer, so hashing it directly is correct.
   382	        if [ -n "${FMS_PROTOCOL_HASH:-}" ]; then
   383	          _wbm_digest="$FMS_PROTOCOL_HASH"
   384	        else
   385	          _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )"
   386	        fi
   387	      elif _wbm_is_conditional "$_wbm_rel"; then
   388	        _wbm_decl="$( _wbm_declared_hash_source "$_wbm_rel" )"
   389	        case "$_wbm_decl" in
   390	          HASH_SOURCE)
   391	            # FMS_SOURCE_ROOT, never FMS_HASH_ROOT: the global override is an
   392	            # upgrade-only mechanism, and borrowing it here is what dragged
   393	            # install into the r8-F1 rendered-tree regression.
   394	            if [ -n "${FMS_SOURCE_ROOT:-}" ] && [ -f "$FMS_SOURCE_ROOT/$_wbm_rel" ]; then
   395	              _wbm_digest="$( _hash_file "$FMS_SOURCE_ROOT/$_wbm_rel" 2>/dev/null || true )"
   396	            else
   397	              continue   # the framework no longer ships it: record nothing
   398	            fi
   399	            ;;
   400	          HASH_PRIOR_RECORD)   _wbm_digest="$( _wbm_prior_digest "$_wbm_rel" )" ;;
   401	          HASH_CANONICAL_POINTER) _wbm_digest="${FMS_PROTOCOL_HASH:-}" ;;
   402	          HASH_TARGET)         _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )" ;;
   403	          HASH_NONE)           continue ;;
   404	          *)
   405	            # FAIL-CLOSED, scoped to the three conditional surfaces (Owner
   406	            # ratified 2026-08-07). Under-claiming is recoverable; over-claiming
   407	            # is the delete-the-adopter's-file class.
   408	            echo "    NOTE: $_wbm_rel delivered but declared no hash_source —" >&2
   409	            echo "          NOT recorded (fail-closed; ownership under-claimed)" >&2
   410	            continue
   411	            ;;
   412	        esac
   413	        case "$_wbm_digest" in
   414	          "" ) continue ;;
   415	        esac
   416	      else
   417	        # Hash the FRAMEWORK version. When FMS_HASH_ROOT is set (upgrade) and the
   418	        # path is ABSENT there, the framework no longer ships it — OMIT it from
   419	        # the baseline (recording the adopter-retained target file would falsely
   420	        # mark it FRAMEWORK-CHANGED if the framework later reintroduces the
  1120	  fi
  1121	  return 0
  1122	}
