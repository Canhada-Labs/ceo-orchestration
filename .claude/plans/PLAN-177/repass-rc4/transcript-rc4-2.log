  3029	# Re-pass rc.4 t3 (smoke STALE) + t5 P1 (ownership): the plans/ SCHEMA
  3030	# docs are FRAMEWORK contract files that install.sh seeds but upgrade never
  3031	# refreshed — the first framework edit (S305, DEBATE-SCHEMA) left every
  3032	# upgraded adopter on the old generation (F3 STALE). But a blanket
  3033	# backup_and_replace would CLOBBER an adopter-modified schema (t5 P1: the
  3034	# schemas are not in the baseline ownership enumeration for pre-existing
  3035	# installs, so classification falls back to legacy overwrite). Refresh is
  3036	# therefore HASH-GATED: only a byte-pristine copy of a KNOWN prior
  3037	# framework generation is replaced; anything else is PRESERVED loudly.
  3038	# t8 P1: delivery flags for the baseline manifest — the schemas enter the
  3039	# enumeration ONLY when this upgrade left FRAMEWORK bytes at the path
  3040	# (INSTALLED / REFRESHED / IDENTICAL). PRESERVED and SKIPPED stay out, so
  3041	# an adopter-customized schema is never recorded as framework-owned.
  3042	_SCHEMA_DELIVERED_PLAN=0
  3043	_SCHEMA_DELIVERED_DEBATE=0
  3044	_rsd_mark_delivered() {
  3045	  case "$1" in
  3046	    .claude/plans/PLAN-SCHEMA.md)   _SCHEMA_DELIVERED_PLAN=1 ;;
  3047	    .claude/plans/DEBATE-SCHEMA.md) _SCHEMA_DELIVERED_DEBATE=1 ;;
  3048	  esac
  3049	}
  3050	_refresh_schema_doc() {
  3051	  # $1 = rel path; $2.. = sha256 of KNOWN prior framework generations.
  3052	  _rsd_rel="$1"; shift
  3053	  _rsd_src="$SOURCE_DIR/$_rsd_rel"; _rsd_dst="$TARGET/$_rsd_rel"
  3054	  # Re-pass rc.4 t7 P1 (skip contract): --skip excludes this path from
  3055	  # inspection AND write, like every other delivery in this script.
  3056	  if _path_is_skipped "$_rsd_rel"; then
  3057	    echo "    SKIPPED (--skip): $_rsd_rel"
  3058	    return 0
  3059	  fi
  3060	  [ -e "$_rsd_src" ] || { echo "    SKIP (source missing): $_rsd_rel"; return 0; }
  3061	  # Re-pass rc.4 t7 P1 (symlink escape): refuse to read or write through a
  3062	  # symlinked LEAF (checked before -e: a BROKEN link would otherwise fall
  3063	  # into the install branch and cp would create the referent outside the
  3064	  # target) or any symlinked ANCESTOR — a --link install's schema symlink,
  3065	  # or a hostile .claude/plans link, would make cp modify the referent
  3066	  # outside the adopter target. Preservation is the only safe verdict.
  3067	  if [ -L "$_rsd_dst" ]; then
  3068	    echo "    WARNING: PRESERVED $_rsd_rel (destination is a symlink — a refresh would write through it, outside the target; replace the link manually if that is intended)"
  3069	    return 0
  3070	  fi
  3071	  _rsd_walk="$(dirname "$_rsd_rel")"
  3072	  while [ -n "$_rsd_walk" ] && [ "$_rsd_walk" != "." ] && [ "$_rsd_walk" != "/" ]; do
  3073	    if [ -L "$TARGET/$_rsd_walk" ]; then
  3074	      echo "    WARNING: PRESERVED $_rsd_rel (ancestor $_rsd_walk is a symlink — refusing to write through it)"
  3075	      return 0
  3076	    fi
  3077	    _rsd_walk="$(dirname "$_rsd_walk")"
  3078	  done
  3079	  if [ ! -e "$_rsd_dst" ]; then
  3080	    mkdir -p "$(dirname "$_rsd_dst")"
  3081	    cp "$_rsd_src" "$_rsd_dst"
  3082	    echo "    INSTALLED: $_rsd_rel"
  3083	    _rsd_mark_delivered "$_rsd_rel"
  3084	    return 0
  3085	  fi
  3086	  # Re-pass rc.4 t7 P1 (hasher portability): the shared _hash_file
  3087	  # abstraction, never a bare `shasum` — absent on Perl-less Linux hosts,
  3088	  # where set -e would abort the whole upgrade mid-inspection. No usable
  3089	  # hasher => ownership cannot be proven => preserve loudly.
  3090	  if ! command -v _hash_file >/dev/null 2>&1; then
  3091	    echo "    WARNING: PRESERVED $_rsd_rel (no sha256 hasher available — ownership unprovable, not refreshing)"
  3092	    return 0
  3093	  fi
  3094	  if ! _rsd_h_dst="$(_hash_file "$_rsd_dst")" || [ -z "$_rsd_h_dst" ]; then
  3095	    echo "    WARNING: PRESERVED $_rsd_rel (no sha256 hasher available — ownership unprovable, not refreshing)"
  3096	    return 0
  3097	  fi
  3098	  if ! _rsd_h_src="$(_hash_file "$_rsd_src")" || [ -z "$_rsd_h_src" ]; then
  3099	    echo "    WARNING: PRESERVED $_rsd_rel (no sha256 hasher available — ownership unprovable, not refreshing)"
  3100	    return 0
  3101	  fi
  3102	  if [ "$_rsd_h_dst" = "$_rsd_h_src" ]; then
  3103	    echo "    IDENTICAL: $_rsd_rel"
  3104	    _rsd_mark_delivered "$_rsd_rel"
  3105	    return 0
  3106	  fi
