  1260	def test_driver_derives_every_version_string_from_target_base():
  1261	    """Zero stale literals — and deliberately NO coupling to the repo's current
  1262	    VERSION file. Pinning the driver to VERSION would go red in the one window
  1263	    where the driver MUST be ahead of it: the moment TARGET_BASE is set for the
  1264	    next release and `bump` has not run yet. A gate that blocks the documented
  1265	    path is the failure mode this plan exists to close, not a new instance."""
  1266	    text = DRIVER_SRC.read_text(encoding="utf-8")
  1267	    m = re.search(r'(?m)^TARGET_BASE="(\d+\.\d+\.\d+)"$', text)
  1268	    assert m, "TARGET_BASE is not a bare-semver assignment"
  1269	    target = m.group(1)
  1270	    offenders = []
  1271	    for num, line in enumerate(text.splitlines(), 1):
  1272	        if line.strip() == 'TARGET_BASE="%s"' % target:
  1273	            continue
  1274	        for hit in SEMVER_RX.findall(line):
  1275	            # tolerated: a reference to a PAST incident. It is a historical
  1276	            # fact and cannot be derived from TARGET_BASE.
  1277	            if re.search(r"v%s-rc\.\d+" % re.escape(hit), line):
  1278	                continue
  1279	            offenders.append("%d: %s" % (num, line.strip()))
  1280	    assert not offenders, "version literals not derived from TARGET_BASE:\n%s" % (
  1281	        "\n".join(offenders)
  1282	    )
