  1048	_preview_claude_dir_gitignore() {
  1049	  # Dry-run twin of _apply_claude_dir_gitignore (re-pass rc.4 t2 P1):
  1050	  # SAME per-entry predicate, ZERO writes. Reports the action the real
  1051	  # run would take — including would-APPEND on a seeded adopter file.
  1052	  _pcg_file="$1/.gitignore"
  1053	  if [ -L "$_pcg_file" ]; then
  1054	    echo "    (dry-run) ERROR: .claude/.gitignore is a symlink — real run would REFUSE" >&2
  1055	    return 1
  1056	  fi
  1057	  if [ ! -e "$_pcg_file" ]; then
  1058	    # t12 P1: the ABSENT branch must be as honest as the rest — the real
  1059	    # run CREATES the file and then fails on the tracked check, so a
  1060	    # would-CREATE + exit 0 preview over a tracked overlay lies. Same
  1061	    # read-only classifier, still zero writes.
  1062	    _pcg_repo="$( dirname "$1" )"
  1063	    _pcg_tracked="$( _gitignore_tracked_sensitive "$_pcg_repo" \
  1064	      ".claude/settings.local.json" ".claude/state" )"
  1065	    if [ -n "$_pcg_tracked" ]; then
  1066	      echo "    (dry-run) ERROR: sensitive path(s) already TRACKED — real run would CREATE .claude/.gitignore and then REFUSE, demanding git rm --cached:" >&2
  1067	      printf '%s\n' "$_pcg_tracked" | sed 's/^/      /' >&2
  1068	      return 1
  1069	    fi
  1070	    echo "    (dry-run) would CREATE: .claude/.gitignore"
  1071	    return 0
  1072	  fi
  1073	  if [ ! -f "$_pcg_file" ]; then
  1074	    echo "    (dry-run) ERROR: .claude/.gitignore exists but is not a regular file" >&2
  1075	    return 1
  1076	  fi
  1077	  _pcg_missing=""
  1078	  for _pcg_entry in "/state/" "/settings.local.json"; do
  1079	    grep -Fxq "$_pcg_entry" "$_pcg_file" || _pcg_missing="$_pcg_missing $_pcg_entry"
  1080	  done
  1081	  # t9 P1: the real run now RE-ASSERTS a textually-present-but-negated
  1082	  # entry, so a "would PRESERVE" preview over that state is a lie. Run the
  1083	  # SAME read-only `git check-ignore` probes and report would-RE-ASSERT.
  1084	  _pcg_repo="$( dirname "$1" )"
  1085	  _pcg_reassert=""
  1086	  if git -C "$_pcg_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  1087	    if ! git -C "$_pcg_repo" check-ignore -q --no-index -- \
  1088	         ".claude/state/__ceo_ignore_probe__" 2>/dev/null; then
  1089	      case "$_pcg_missing" in
  1090	        *" /state/"*) : ;;  # already reported as would-APPEND
  1091	        *) _pcg_reassert="$_pcg_reassert /state/" ;;
  1092	      esac
  1093	    fi
  1094	    if ! git -C "$_pcg_repo" check-ignore -q --no-index -- \
  1095	         ".claude/settings.local.json" 2>/dev/null; then
  1096	      case "$_pcg_missing" in
  1097	        *" /settings.local.json"*) : ;;
  1098	        *) _pcg_reassert="$_pcg_reassert /settings.local.json" ;;
  1099	      esac
  1100	    fi
  1101	  fi
  1102	  if [ -n "$_pcg_missing" ]; then
  1103	    echo "    (dry-run) would APPEND into existing .claude/.gitignore:$_pcg_missing"
  1104	  fi
  1105	  if [ -n "$_pcg_reassert" ]; then
  1106	    echo "    (dry-run) would RE-ASSERT (present but negated by a later rule):$_pcg_reassert"
  1107	  fi
  1108	  # t11 P1 #2: the REAL run refuses on tracked sensitive paths — a
  1109	  # would-PRESERVE preview over that state is dishonest. Same read-only
  1110	  # classifier, no writes.
  1111	  _pcg_tracked="$( _gitignore_tracked_sensitive "$_pcg_repo" \
  1112	    ".claude/settings.local.json" ".claude/state" )"
  1113	  if [ -n "$_pcg_tracked" ]; then
  1114	    echo "    (dry-run) ERROR: sensitive path(s) already TRACKED — real run would REFUSE and demand git rm --cached:" >&2
  1115	    printf '%s\n' "$_pcg_tracked" | sed 's/^/      /' >&2
  1116	    return 1
  1117	  fi
  1118	  if [ -z "$_pcg_missing" ] && [ -z "$_pcg_reassert" ]; then
  1119	    echo "    (dry-run) EXISTS: .claude/.gitignore already carries both entries (would PRESERVE)"
  1120	  fi
  1121	  return 0
  1122	}

