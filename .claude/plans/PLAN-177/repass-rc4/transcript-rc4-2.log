  2527	# Writes $TARGET/.claude/.install-state.json (next to the ADR-155 baseline
  2528	# manifest): the ORIGINAL request — verbatim argv + every parsed flag + the
  2529	# RESOLVED placeholder map (CLI > env > deterministic default; empty values
  2530	# omitted) — plus the operation journal for THIS run.
   230	# shellcheck disable=SC2034  # CODEX_WITH_SKILLS/CODEX_FORCE consumed by the sourced _codex_harness.sh
   231	CODEX_WITH_SKILLS=0
   232	# shellcheck disable=SC2034
   233	CODEX_FORCE=0          # upgrade derives this from --on-conflict for the codex refresh
   234	PROFILE_EXPLICIT=0      # PLAN-153 B2: explicit --profile always beats a replayed value
   235	STACK_EXPLICIT=0        # PLAN-153 B2: explicit --stack always beats a replayed value
   236	SKIP_GLOBS=()
   237	
   238	while [[ $# -gt 0 ]]; do
   239	  case "$1" in
   240	    --profile)
   241	      PROFILE="${2:-}"
   242	      PROFILE_EXPLICIT=1
   243	      shift 2
   244	      ;;
   245	    --stack)
   246	      STACK="${2:-}"
   247	      STACK_EXPLICIT=1
   248	      shift 2
   249	      ;;
   250	    --pin)
   251	      PIN_REF="${2:-}"
   252	      shift 2
   253	      ;;
   254	    --dry-run)
   255	      DRY_RUN=1
   256	      shift
   257	      ;;
   258	    --ceremony)
   259	      # Re-pass rc.4 t3 (P1): explicit ceremony for PRE-STATE targets
   260	      # (no readable .install-state.json). A RECORDED ceremony always
   261	      # wins over this flag — the flag exists for the migration case.
   262	      CEREMONY_FLAG="${2:-}"
   263	      case "$CEREMONY_FLAG" in
   264	        maintainer|user) : ;;
   265	        *) echo "ERROR: --ceremony must be 'maintainer' or 'user' (got '$CEREMONY_FLAG')" >&2; exit 2 ;;
   266	      esac
   267	      shift 2
   268	      ;;
   269	    --purge-misinstalled)
   270	      # PLAN-161 U3 (OQ1 Owner-ratified): opt-in, hash-gated purge of
   271	      # mis-installed framework-internal excluded-tree files. NEVER default-on.
   272	      PURGE_MISINSTALLED=1
   273	      shift
   274	      ;;
   275	    --no-diff-warn)
   276	      DIFF_WARN=0
   277	      shift
   278	      ;;
   279	    --no-deprecation-warn)
   280	      DEPRECATION_WARN=0
   740	      echo "          debate C back-compat must-fix); a valid state file is rewritten" >&2
   741	      echo "          after this upgrade completes." >&2
   742	    fi
   743	  else
   744	    _REPLAY_SOURCE="fallback-no-state"
   745	    echo "    NOTE: no .claude/.install-state.json in target (pre-Wave-B install)." >&2
   746	    echo "          Proceeding with CLI/default flags on the ADR-155 path (baseline" >&2
   747	    echo "          drift-classifier when a manifest exists, else diff -q warn-then-" >&2
   748	    echo "          clobber). A state file is recorded after this upgrade completes." >&2
