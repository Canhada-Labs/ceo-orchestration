  1786	# ---------------------------------------------------------------------------
  1787	# PLAN-177 W0.3 delta (codex P1-4 of the v4 round) — the generic sweep.
  1788	#
  1789	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1790	# checksum gate anchors three named phantom referents. A NEW enforcement
  1791	# promise, about some other subject, written into a section nobody watches,
  1792	# passes all of them. The original defect is the proof that this is not
  1793	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1794	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1795	#
  1796	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1797	# Contract table row (machine-checked by
  1798	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1799	# to the table's un-enforced rows by
  1800	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1801	# Anywhere else it is answerable to nothing, and is a red.
  1802	#
  1803	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1804	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1805	#
  1806	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1807	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1808	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1809	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1810	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1811	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1812	#     at the table rather than enumerating mechanisms, and the tag-signing
  1813	#     paragraph cites SECURITY.md as the authority instead of restating the
  1814	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1815	#     needs no exemption, so it has none.
  1816	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1817	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1818	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1819	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1820	#     are the file speaking about what the pipeline does.
  1821	#     A broad list that has to be switched off is worth less than a narrow
  1822	#     one that stays on.
  1823	#
  1824	# Matching is on word boundaries after normalization. Substring matching was
  1825	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1826	# substring-vs-exact class, for the fourth time in this plan.
  1827	_ENFORCEMENT_VOCAB = (
  1828	    "enforced today",
  1829	    "is enforced",
  1830	    "are enforced",
  1831	    "enforced by",
  1832	    "enforced at",
  1833	    "every tag publish",
  1834	    "recorded by",
  1835	    "is verified",
  1836	    "are verified",
  1837	    "verifies",
  1838	    "must satisfy",
  1839	    "guarantees",
  1840	    "is guaranteed",
  1841	    "are guaranteed",
  1842	    "asserted by",
  1843	    "checked by",
  1844	    "gated by",
  1845	    "fails closed",
  1846	    "fail closes",
  1847	    "asserts",
  1848	    "ensures",
  1849	    "is signed",
  1850	    "are signed",
  1851	)
  1852	
  1853	
  1854	def _normalize_prose(text: str) -> str:
  1855	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1856	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1857	    normalize the same way, so a claim cannot hide behind formatting."""
  1858	    text = text.lower()
  1859	    for ch in ("*", "`", "_"):
  1860	        text = text.replace(ch, "")
  1861	    text = text.replace("-", " ")
  1862	    return re.sub(r"\s+", " ", text)
  1863	
  1864	
  1865	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1866	    """Everything that is neither a `## Contract` table row nor §Not yet
  1867	    automated — the surfaces where a mechanism claim answers to nothing.
  1868	
  1869	    Re-pass rc.4 t9 P2: strip table rows ONLY inside `## Contract` — the
  1870	    blanket startswith("|") filter exempted EVERY table anywhere in the
  1871	    doc, so a new table outside the Contract section could carry an
  1872	    enforcement claim past this sweep unchecked.
  1873	    """
  1874	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1875	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", body)
  1876	    if m:
  1877	        stripped_section = "\n".join(
  1878	            line for line in m.group(0).splitlines()
  1879	            if not line.strip().startswith("|")
  1880	        )
  1881	        body = body[: m.start()] + stripped_section + body[m.end():]
  1882	    return body
  1883	
  1884	
  1885	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1886	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1887	    offenders = []
  1888	    for phrase in _ENFORCEMENT_VOCAB:
  1889	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1890	            offenders.append(
  1891	                "%r outside the declared zones: ...%s..."
  1892	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1893	            )
  1894	    return offenders
  1895	
  1896	
  1897	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1898	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1899	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1900	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1901	    even standing somewhere that can be checked?" — the question the file
  1902	    failed on the day it shipped."""
  1903	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1904	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1905	
  1906	    # The sweep must be looking at the right text: intro present, table absent.
  1907	    swept = _prose_outside_the_declared_zones(doc)
  1908	    assert "Integrity contract for the" in swept, (
  1909	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1910	        "the prose it exists to watch"
  1911	    )
  1912	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1913	    assert len(swept) > len(doc) // 3, (
  1914	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1915	        % (len(swept), len(doc))
  1916	    )
  1917	
  1918	    # t9 P2 positive control: a table OUTSIDE `## Contract` carrying an
  1919	    # enforcement claim must NOT be exempted by the sweep — the old blanket
  1920	    # `startswith("|")` filter stripped every table anywhere.
  1921	    outside_table = (
  1922	        doc
  1923	        + "\n## Some new section\n\n"
  1924	        + "| per-tarball SHA-256 manifest | enforced today; recorded by "
  1925	        + "npm-publish.yml |\n"
  1926	    )
  1927	    assert _enforcement_vocabulary_offenders(outside_table), (
  1928	        "an enforcement claim inside a table OUTSIDE ## Contract passed the "
  1929	        "generic sweep — the exemption must be Contract-section-only"
  1930	    )
  1931	
  1932	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1933	    # merits. The order matters and was learned the hard way — the controls
  1934	    # below build their fixtures FROM the live file, so when the file itself
  1935	    # carries a planted defect they fail first and the red names the fixture
  1936	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1937	    # always reds on the assertion that describes what is actually wrong.
  1938	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1939	    offenders = _enforcement_vocabulary_offenders(doc)
  1940	    assert not offenders, (
  1941	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1942	        "§Not yet automated. Move the claim into a table row (with a step the "
  1943	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1944	    )
  1945	
  1946	    # (b) positive control: the historical claim restored to the introduction.
  1947	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1948	    # today's wording — an anchor on current prose stops matching the moment
  1949	    # that prose is edited, and then the control fails for the wrong reason.
  1950	    title, _, rest = doc.partition("\n")
  1951	    claim = (
  1952	        "The integrity controls enforced today are: (1) the `install.sh` "
  1953	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1954	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1955	    )
  1956	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1957	    assert relapse != doc, "relapse fixture did not patch the doc"
  1958	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1959	    assert any("enforced today" in o for o in relapse_offenders), (
  1960	        "an enforcement claim in the introduction went unseen: %s"
  1961	        % relapse_offenders
  1962	    )
  1963	    assert any("recorded by" in o for o in relapse_offenders), (
  1964	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1965	    )
  1966	
  1967	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1968	    # offender. This is the predicate as documented, not a global grep — that
  1969	    # section is where honest prose about absence has to be able to use these
  1970	    # words. Its own honesty is held by the restatement test above; a claim
  1971	    # parked there is the residual gap, and it is a narrow, watched one.
  1972	    marker = "## Not yet automated"
  1973	    assert marker in doc
  1974	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1975	    assert not _enforcement_vocabulary_offenders(parked), (
  1976	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1977	        "a declared zone"
  1978	    )
