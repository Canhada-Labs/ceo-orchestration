   208	      # install-state replay (B2 pre-state ceremony persistence + B2-c3/c4
   209	      # schema-refresh, --skip and symlink-refusal legs) is many minutes of
   210	      # real installs and runs in ownership-nightly.yml instead.
   211	      - name: Gitignore symlink + dry-run preview unit (t7)
   212	        run: |
   213	          set -euo pipefail
   214	          bash scripts/tests/test-gitignore-symlink-and-dryrun-unit.sh
   215	
   216	      # PLAN-168 W1 (rail r3 P1): the nightly gate's fake-harness control is
   217	      # milliseconds — run it per-PR so a PR touching the gate cannot break
   218	      # its rc/status handling while PR checks stay green.
   219	      - name: Ownership nightly-gate positive control (fake harness)
   220	        run: |
   221	          set -euo pipefail
   222	          bash scripts/tests/test-ownership-nightly-gate.sh
   223	
   224	      # PLAN-168 W2 (AC-6, per-PR half of INV-4): the shared pointer
   225	      # generator's 8-scenario control — includes ONE real install (~1-2 min
   226	      # on CI iron). The full install->upgrade->cure e2e (4 legs, ~5 min CI)
   227	      # is nightly-only; MEASURED per the smoke budget notes above.
   228	      - name: Protocol pointer render control (generator parity)
   229	        run: |
   230	          set -euo pipefail
   231	          bash scripts/tests/test-protocol-pointer-render.sh
   232	
