   967	_apply_claude_dir_gitignore() {
   968	  # $1 = the adopter .claude directory.
   969	  # Create when absent; when PRESENT, append only the entries that are
   970	  # missing, per line, preserving every adopter byte (re-pass rc.4 t1
   971	  # P1-b: an adopter with a pre-existing .claude/.gitignore -- e.g.
   972	  # /cache/ only -- never received /state/ nor /settings.local.json,
   973	  # so night-mode state stayed commit-eligible under --ceremony user;
   974	  # create-if-missing alone proved the clean-target case only). Same
   975	  # grep -Fxq per-entry predicate as the root blocks: the file stays
   976	  # adopter-owned, nothing is rewritten, a deliberate edit to OUR
   977	  # comment lines is never repaired.
   978	  _cdg_dir="$1"
   979	  _cdg_file="$_cdg_dir/.gitignore"
   980	  # Re-pass rc.4 t2 (P1): NEVER follow a symlink here. A .claude/.gitignore
   981	  # symlinked to another writable file would receive framework appends at
   982	  # the EXTERNAL target; a dangling symlink passes `[ ! -e ]` and the
   983	  # redirect would CREATE its target. -L catches both, before any read.
   984	  if [ -L "$_cdg_file" ]; then
   985	    echo "    ERROR: .claude/.gitignore is a symlink — refusing to read or write through it (preserve/replace it manually)" >&2
   986	    return 1
   987	  fi
   988	  if [ ! -e "$_cdg_file" ]; then
   989	    [ -d "$_cdg_dir" ] || mkdir -p "$_cdg_dir"
   990	    _claude_dir_gitignore_body > "$_cdg_file"
   991	    echo "    CREATED: .claude/.gitignore"
   992	    # t11 P1: DO NOT return here — the effectiveness + tracked checks
   993	    # below must run on the freshly created file too. A user-ceremony
   994	    # adopter with an already-TRACKED .claude/settings.local.json got a
   995	    # green install while the overlay stayed commit-eligible (user
   996	    # ceremony never runs the root helper that would have caught it).
   997	    _cdg_repo="$( dirname "$_cdg_dir" )"
   998	    _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
   999	      "/state/" ".claude/state/__ceo_ignore_probe__" || return 1
  1000	    _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
  1001	      "/settings.local.json" ".claude/settings.local.json" || return 1
  1002	    return 0
  1003	  fi
  1004	  if [ ! -f "$_cdg_file" ]; then
  1005	    echo "    ERROR: .claude/.gitignore exists but is not a regular file" >&2
  1006	    return 1
  1007	  fi
  1008	  _cdg_added=0
  1009	  for _cdg_entry in "/state/" "/settings.local.json"; do
  1010	    if grep -Fxq "$_cdg_entry" "$_cdg_file"; then
  1011	      continue
  1012	    fi
  1013	    {
  1014	      echo ""
  1015	      echo "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9): per-machine"
  1016	      echo "# posture/runtime state (never commit)."
  1017	      printf '%s\n' "$_cdg_entry"
  1018	    } >> "$_cdg_file"
