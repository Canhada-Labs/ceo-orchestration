  1473	def _contract_rows(doc_text: str) -> List[List[str]]:
  1474	    """The `## Contract` table as [control, mechanism, status, where].
  1475	
  1476	    Re-pass rc.4 t6-cond-2 / t7 P2: a malformed non-header row (any cell
  1477	    count other than 4) FAILS instead of being silently discarded — an
  1478	    enforcement claim that grows an extra `|` must not vanish from the
  1479	    oracle while the remaining rows keep the non-vacuity floors green.
  1480	    """
  1481	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1482	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1483	    rows = []
  1484	    malformed = []
  1485	    for line in m.group(0).splitlines():
  1486	        line = line.strip()
  1487	        if not line.startswith("|"):
  1488	            continue
  1489	        cells = [c.strip() for c in line.strip("|").split("|")]
  1490	        if cells and (cells[0] == "Control" or set(cells[0]) <= set("- :")):
  1491	            continue
  1492	        if len(cells) != 4:
  1493	            malformed.append(line)
  1494	            continue
  1495	        rows.append(cells)
  1496	    assert not malformed, (
  1497	        "malformed `## Contract` row(s) (cell count != 4) would be silently "
  1498	        "dropped from the enforcement oracle: %s" % malformed
  1499	    )
  1500	    return rows
  1501	
