  1981	# --------------------------------------------------------------------------
  1982	# Supply-chain honesty: the two claims that survive being corrected in one file
  1983	#
  1984	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  1985	# was green while `npm/README.md` — the README an npm consumer actually
  1986	# RECEIVES, it is in package.json `files` — still promised "SLSA 3 provenance",
  1987	# and while README.pt-BR, INSTALL.md and both QUICKSTARTs repeated Level 3 and
  1988	# a checksum coverage the release does not have (repass-rc4 part 2, P1 §2).
  1989	# A single-file gate cannot see that class, so the surface list below is
  1990	# EXPLICIT, and `_live_doc_surfaces()` re-derives the population from the repo
  1991	# so a NEW document carrying either claim also lands in front of the gate.
  1992	#
  1993	# `.claude/**` is deliberately outside the population: plans, debates and
  1994	# archived verdicts are historical records, and they have to be able to quote a
  1995	# false claim verbatim without turning this gate red.
  1996	# --------------------------------------------------------------------------
  1997	
  1998	SUPPLY_CHAIN_HONESTY_SURFACES = (
  1999	    "README.md",
  2000	    "README.pt-BR.md",
  2001	    "npm/README.md",
  2002	    "npm/INTEGRITY.md",
  2003	    "INSTALL.md",
  2004	    "SECURITY.md",
  2005	    "SUPPORT.md",
  2006	    "SBOM.md",
  2007	    "docs/QUICKSTART.md",
  2008	    "docs/QUICKSTART.pt-BR.md",
  2009	    "docs/CTO-GUIDE.md",
  2010	    "docs/threat-model.md",
  2011	)
  2012	
  2013	# "SLSA 3", "SLSA-3", "SLSA Level 3", "SLSA L3", "SLSA provenance L3" and
  2014	# "provenance (SLSA L3)" all normalise to the same false claim. The earlier
  2015	# pattern only caught the first three, which is why `SBOM.md` ("SLSA L3") and
  2016	# `docs/QUICKSTART.md` ("SLSA provenance L3") were invisible to it.
  2017	_SLSA_LEVEL3_CLAIM = re.compile(
  2018	    r"SLSA[\s\-]*(?:provenance[\s\-]*)?(?:Level[\s\-]*|L)?3\b"
  2019	    r"|(?:provenance|attestation)[\s\-]*(?:Level[\s\-]*|L)3\b",
  2020	    re.IGNORECASE,
  2021	)
  2022	
  2023	# Plural = aggregate. Release checksum coverage is `install.sh` alone
  2024	# (SECURITY.md §How to verify what you install); "ships SHA-256 checksums"
  2025	# promises a SHA256SUMS that no workflow produces.
  2026	_CHECKSUM_AGGREGATE_CLAIM = re.compile(
  2027	    r"SHA-?256\s+checksums|checksums\s+SHA-?256", re.IGNORECASE
  2028	)
  2029	
  2030	
  2031	def _live_doc_surfaces() -> List[Path]:
  2032	    """Root-level, `docs/` and `npm/` markdown — every document a reader or an
  2033	    npm consumer meets. Deliberately NOT `.claude/**` (see the block comment)."""
  2034	    found = sorted(REPO_ROOT.glob("*.md"))
  2035	    for sub in ("docs", "npm"):
  2036	        base = REPO_ROOT / sub
  2037	        if base.exists():
  2038	            found += sorted(base.rglob("*.md"))
  2039	    return found
  2040	
  2041	
  2042	def test_slsa_and_checksum_claims_are_true_on_every_shipped_surface():
  2043	    """The npm consumer reads `npm/README.md`; the Portuguese reader reads
  2044	    `README.pt-BR.md`. Correcting the root README alone left both promising a
  2045	    Level the pipeline never reaches. The gate now runs over an explicit list
  2046	    AND over every live doc, so neither a missed translation nor a new file can
  2047	    carry the claim silently."""
  2048	    surfaces = {p.relative_to(REPO_ROOT).as_posix(): p for p in _live_doc_surfaces()}
  2049	
  2050	    # (a) The explicit list is not allowed to name a file that stopped
  2051	    # existing: a surface silently dropped from the repo is a gate that
  2052	    # quietly narrows.
  2053	    missing = [s for s in SUPPLY_CHAIN_HONESTY_SURFACES if s not in surfaces]
  2054	    assert not missing, "declared honesty surfaces that no longer exist: %s" % missing
  2055	
  2056	    offenders: List[str] = []
  2057	    for rel, path in surfaces.items():
  2058	        text = path.read_text(encoding="utf-8")
  2059	        for m in _SLSA_LEVEL3_CLAIM.finditer(text):
  2060	            # Tolerance is scoped to what FOLLOWS the mention, never to the
  2061	            # line: the honest sentence names Level 2 and disclaims Level 3 in
  2062	            # one breath, so a line-wide exemption would let the false claim
  2063	            # ride along beside its own disclaimer. The window is 120 chars
  2064	            # because the live disclaimer parenthesises its reason
  2065	            # ("(hermetic build + two-party review) is out of scope") — at the
  2066	            # old width of 40 the only honest Level-3 sentence in the repo
  2067	            # would have been the gate's first false positive.
  2068	            tail = text[m.end():m.end() + 120]
  2069	            if "out of scope" in tail or "fora de escopo" in tail:
  2070	                continue
  2071	            offenders.append(
  2072	                "%s: ...%s..."
  2073	                % (rel, text[max(0, m.start() - 60):m.end() + 40].strip().replace("\n", " "))
  2074	            )
  2075	        for m in _CHECKSUM_AGGREGATE_CLAIM.finditer(text):
  2076	            offenders.append(
  2077	                "%s: ...%s..."
  2078	                % (rel, text[max(0, m.start() - 70):m.end() + 30].strip().replace("\n", " "))
  2079	            )
  2080	
  2081	    assert not offenders, (
  2082	        "shipped docs claim SLSA Level 3 and/or aggregate release checksums; "
  2083	        "the pipeline reaches Level 2 (`npm publish --provenance`) and the "
  2084	        "release checksum covers `install.sh` only:\n%s" % "\n".join(offenders)
  2085	    )
  2086	
  2087	    # (b) Positive statement, on the two most-read surfaces: silence about the
  2088	    # level is not honesty either. The npm README is named explicitly because
  2089	    # it is the one that travels inside the tarball.
  2090	    for rel in ("README.md", "npm/README.md"):
  2091	        text = surfaces[rel].read_text(encoding="utf-8")
  2092	        assert "SLSA **Level 2**" in text or "SLSA Level 2" in text, (
  2093	            "%s no longer states the level the pipeline reaches" % rel
  2094	        )
  2095	
  2096	
  2097	# --------------------------------------------------------------------------
  2098	# The npm signature recipe has to audit the thing the reader just installed
  2099	#
  2100	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2101	# no package-selecting positional (a trailing package name is ignored), and it
  2102	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2103	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2104	# with `npm audit signatures` verified nothing the reader had just installed —
  2105	# it audited whatever directory they happened to be standing in, and could
  2106	# return a confident green having examined a different tree entirely.
  2107	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2108	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2109	# project install followed by a BARE `npm audit signatures`.
  2110	# --------------------------------------------------------------------------
  2111	
  2112	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2113	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2114	# (ephemeral — nothing is left in a dependency tree to audit).
  2115	_UNAUDITABLE_INSTALL = re.compile(
  2116	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2117	)
  2118	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2119	# the reader believes it selected a package. `#` is excluded so the honest
  2120	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2121	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2122	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2123	_AUDIT_GLOBAL_FLAG = re.compile(
  2124	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2125	)
  2126	
  2127	
  2128	def _recipe_units(text: str) -> List[tuple]:
  2129	    """(label, body) for each fenced code block, and for each line outside one.
  2130	
  2131	    A recipe is what a reader copies, and they copy a whole code block — so the
  2132	    block, not the line, is the unit in which "install here, audit there" has
  2133	    to be judged. Prose lines are units of their own so a one-line table row
  2134	    (the shape `SUPPORT.md` used) is still examined."""
  2135	    units: List[tuple] = []
  2136	    block: Optional[List] = None
  2137	    for num, line in enumerate(text.splitlines(), 1):
  2138	        if line.strip().startswith("```"):
  2139	            if block is None:
  2140	                block = [num, []]
  2141	            else:
  2142	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2143	                block = None
  2144	            continue
