  1503	def test_contract_rows_reject_malformed_row_instead_of_dropping_it():
  1504	    """t7 P2 positive control: a Contract row with an extra `|` (5 cells)
  1505	    must FAIL the parser, not disappear from validation."""
  1506	    doc = (
  1507	        "## Contract\n\n"
  1508	        "| Control | Mechanism | Status | Where |\n"
  1509	        "| --- | --- | --- | --- |\n"
  1510	        "| good row | m | enforced | w (`a.yml` step `b`) |\n"
  1511	        "| bad | row | with | extra | cell |\n"
  1512	    )
  1513	    try:
  1514	        _contract_rows(doc)
  1515	    except AssertionError as exc:
  1516	        assert "bad" in str(exc)
  1517	    else:
  1518	        raise AssertionError(
  1519	            "5-cell Contract row was silently accepted/dropped"
  1520	        )
