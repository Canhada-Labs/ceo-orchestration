   485	# `_probe_*` (the prefix would have excluded `_probe_anything`). These are the
   486	# only `_probe_*` archetypes in the agent registry (Codex S239 review, P2).
   487	_PROBE_ARCHETYPES = frozenset({
   488	    "_probe_missing_skill",
   489	    "_probe_canonical_edit",
   490	    "_probe_architect",
   491	})
