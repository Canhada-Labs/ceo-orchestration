  1200	# "<number> [word] site(s)" — a census in a comment has no oracle behind it.
  1201	# repass-r2 part-d P2: ordinals count too — "12th site" is as much an
  1202	# oracle-less census claim as "12 sites"; the guard missed the suffix.
  1203	SITE_COUNT_RX = re.compile(
  1204	    r"\b(?:one|two|three|four|five|six|seven|eight|nine|ten|"
  1205	    r"\d+(?:st|nd|rd|th)?)\s+"
  1206	    r"(?:\w+\s+)?sites?\b",
  1207	    re.IGNORECASE,
  1208	)
  1209	# Assembled at RUNTIME, never as a literal: a control whose own file is a hit
  1210	# has to exempt itself, and an exemption is how a control stops controlling.
  1211	# (`"a" "b"` and `"a" + "b"` are both folded by the compiler and would land in
  1212	# this module's .pyc verbatim; str.join is not folded.)
  1213	OLD_DRIVER_STEM = "-".join(("release", "v1", "2", "0"))
  1214	# PLAN-177 W0 item 2 (P1-2): the npm docs joined the roots because they were
  1215	# the one published surface no scanner could see — `npm/INTEGRITY.md` carried
  1216	# a hardcoded version through several releases and every gate stayed green.
  1217	# They are listed as FILES, never as the `npm` directory: `npm/` receives a
  1218	# mirrored copy of `.claude/**` + `scripts/**` (the publish staging rsync, and
  1219	# any local `install-npm.sh` run), so a directory root would have the scanner
  1220	# auditing clones of this repo — slow, and every hit a duplicate of a hit it
  1221	# already reported. `RELEASE.md` is the precedent: this tuple takes files.
  1222	SCAN_ROOTS = (
  1223	    ".github",
  1224	    "RELEASE.md",
  1225	    ".claude/scripts",
  1226	    "scripts",
  1227	    "npm/INTEGRITY.md",
  1228	    "npm/README.md",
  1229	)
