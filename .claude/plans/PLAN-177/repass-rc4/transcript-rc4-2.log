  1572	def test_tarball_checksum_row_stays_deferred_until_a_real_mechanism_exists():
  1573	    """t10 P2: the name-based gate above verifies that an `enforced` row
  1574	    names a workflow STEP that exists — but any unrelated existing step
  1575	    satisfies it. Until a semantic predicate proves non-dry-run tarball
  1576	    creation + SHA-256 + publication, this row is PINNED to `deferred`:
  1577	    flipping it to `enforced` (the historical false promise) must go RED
  1578	    here first, forcing whoever flips it to also build the semantic gate."""
  1579	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1580	    rows = [r for r in _contract_rows(doc) if "SHA-256 tarball" in r[0]]
  1581	    assert len(rows) == 1, (
  1582	        "expected exactly one SHA-256-tarball Contract row, got %r" % rows
  1583	    )
  1584	    assert rows[0][2] == "deferred", (
  1585	        "the SHA-256 tarball row flipped to %r — a name-check alone cannot "
  1586	        "prove hashing/publication; add a semantic workflow predicate "
  1587	        "(non-dry-run pack + sha256 + upload) and update THIS pin together"
  1588	        % rows[0][2]
  1589	    )
  1590	    # mutation control: the dishonest flip is DETECTABLE by this pin.
  1591	    mutated = doc.replace(
  1592	        "| deferred | nothing — see §Not yet automated |",
  1593	        "| enforced | released (`npm-publish.yml` step `Publish to npm`) |",
  1594	        1,
  1595	    )
  1596	    assert mutated != doc, "fixture broke: the deferred row text moved"
  1597	    mrows = [r for r in _contract_rows(mutated) if "SHA-256 tarball" in r[0]]
  1598	    assert mrows and mrows[0][2] == "enforced", "mutation did not land"
