  2154	def test_documented_npm_signature_recipe_matches_what_npm_audits():
  2155	    """Every documented `npm audit signatures` has to be reachable by npm.
  2156	
  2157	    A recipe offends when its unit pairs the command with an install npm cannot
  2158	    audit, passes a positional npm ignores, or passes `--global`, which npm
  2159	    rejects. Naming `EAUDITGLOBAL` in the unit is the tolerance: a document is
  2160	    free — and encouraged — to put the global install next to the command in
  2161	    order to say that the command does NOT reach it."""
  2162	    offenders: List[str] = []
  2163	    units_examined = 0
  2164	    for path in _live_doc_surfaces():
  2165	        rel = path.relative_to(REPO_ROOT).as_posix()
  2166	        text = path.read_text(encoding="utf-8")
  2167	        if not _AUDIT_SIGNATURES.search(text):
  2168	            continue
  2169	        for label, unit in _recipe_units(text):
  2170	            if not _AUDIT_SIGNATURES.search(unit):
  2171	                continue
  2172	            units_examined += 1
  2173	            faults = []
  2174	            if _UNAUDITABLE_INSTALL.search(unit) and "EAUDITGLOBAL" not in unit:
  2175	                faults.append(
  2176	                    "pairs the audit with an install npm cannot audit "
  2177	                    "(global, or exec/npx leaving no dependency behind)"
  2178	                )
  2179	            positional = _AUDIT_POSITIONAL.search(unit)
  2180	            if positional:
  2181	                faults.append(
  2182	                    "passes the positional %r, which npm ignores — the audit "
  2183	                    "still reads the current project" % positional.group(1)
  2184	                )
  2185	            if _AUDIT_GLOBAL_FLAG.search(unit):
  2186	                faults.append("passes --global, which npm rejects (EAUDITGLOBAL)")
  2187	            if faults:
  2188	                offenders.append(
  2189	                    "%s %s: %s\n    %s"
  2190	                    % (rel, label, "; ".join(faults), unit.strip()[:160])
  2191	                )
  2192	
  2193	    # Vacuity guard: the sweep is worthless if it found no recipe to judge.
  2194	    assert units_examined >= 5, (
  2195	        "only %d recipe units examined — the sweep lost sight of the docs it "
  2196	        "exists to watch" % units_examined
  2197	    )
  2198	    assert not offenders, (
  2199	        "documented `npm audit signatures` recipes do not audit what the "
  2200	        "reader installed:\n%s" % "\n\n".join(offenders)
  2201	    )
