  1544	                % (control, status, list(_CONTRACT_STATUSES))
  1545	            )
  1546	            continue
  1547	        if status != "enforced":
  1548	            continue
  1549	        pairs = _ENFORCED_RX.findall(where)
  1550	        if not pairs:
  1551	            offenders.append(
  1552	                "%s: Status is enforced but `Where enforced` names no "
  1553	                "workflow+step in the parseable form — %r" % (control, where)
  1554	            )
  1555	            continue
  1556	        for workflow, step in pairs:
  1557	            wf = repo_root / workflow
  1558	            if not wf.is_file():
  1559	                offenders.append(
  1560	                    "%s: names workflow %s, which does not exist"
  1561	                    % (control, workflow)
  1562	                )
  1563	                continue
  1564	            if step not in _yaml_step_names(wf):
  1565	                offenders.append(
  1566	                    "%s: names step %r in %s, which has no such step"
  1567	                    % (control, step, workflow)
  1568	                )
  1569	    return offenders
