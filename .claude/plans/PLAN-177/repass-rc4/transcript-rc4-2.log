  1237	    scanned = 0
  1238	    for root in SCAN_ROOTS:
  1239	        base = REPO_ROOT / root
  1240	        if not base.exists():
  1241	            continue
  1242	        paths = [base] if base.is_file() else sorted(base.rglob("*"))
  1243	        for path in paths:
  1244	            if not path.is_file() or "__pycache__" in path.parts:
  1245	                continue
  1246	            try:
  1247	                body = path.read_text(encoding="utf-8")
  1248	            except (UnicodeDecodeError, OSError):
  1249	                continue  # binary artifact: not a live text surface
  1250	            scanned += 1
  1251	            for num, line in enumerate(body.splitlines(), 1):
  1252	                if needle in line:
  1253	                    hits.append(
  1254	                        "%s:%d: %s"
  1255	                        % (path.relative_to(REPO_ROOT), num, line.strip())
  1256	                    )
  1257	    return scanned, hits
