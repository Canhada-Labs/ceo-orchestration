  1688	    header = doc.split("## Contract", 1)[0]
  1689	    assert "no** per-tarball" in header or "no per-tarball" in header, (
  1690	        "header no longer states that the tarball checksum is absent"
  1691	    )
  1692	    assert "scripts/install-npm.sh" in doc, (
  1693	        "the doc does not attribute SHA256SUMS.txt to its real, local writer"
  1694	    )
  1695	    assert "sha256sum -c SHA256SUMS.txt" not in doc, (
  1696	        "the impossible consumer recipe is back — it cannot run, because "
  1697	        "SHA256SUMS.txt is not inside the published package"
  1698	    )
  1699	
  1700	    # --- sweep findings: three promises whose referent does not exist ---
  1701	    assert not re.search(r"rotation-log\.md`?\s*§\s*NPM", doc), (
  1702	        "the doc again points at a rotation-log section that does not exist"
  1703	    )
  1704	    assert ".well-known/gpg.asc" not in doc, (
  1705	        "the doc again advertises a key distribution point this project does "
  1706	        "not serve"
  1707	    )
  1708	    assert not (REPO_ROOT / ".well-known").exists(), (
  1709	        "`.well-known/` now exists — re-open the signing-key section"
  1710	    )
  1711	    for name in ("docs/rotation-log.md", ".claude/trust/owner.asc"):
  1712	        if name in doc:
  1713	            assert (REPO_ROOT / name).exists(), "doc points at missing %s" % name
  1714	    # the reproducible-build row is `deferred` because NO workflow sets the
  1715	    # variable. If one ever does, this red is the reminder to re-read the row.
  1716	    for workflow in (
  1717	        ".github/workflows/validate.yml",
  1718	        ".github/workflows/npm-publish.yml",
  1719	    ):
  1720	        body = (REPO_ROOT / workflow).read_text(encoding="utf-8")
  1721	        assert "SOURCE_DATE_EPOCH" not in body, (
  1722	            "%s now sets SOURCE_DATE_EPOCH — the reproducible-build row may "
  1723	            "have become real" % workflow
  1724	        )
  1725	    assert "npm packlist gate" in doc, (
  1726	        "the doc no longer names the packlist gate that actually runs"
  1727	    )
  1728	
  1729	    # the sibling promise, on the manifest itself
  1730	    sums = (REPO_ROOT / "npm" / "SHA256SUMS.txt").read_text(encoding="utf-8")
  1731	    assert "NOT generated by CI" in sums
  1732	    assert "Generated by `.github/workflows/npm-publish.yml`" not in sums
  1733	
  1734	    # PLAN-177 t2 (re-pass rc.4 P2-c): the REGENERATION RECIPE must be able to
  1735	    # regenerate. The recipe this file shipped extracted `npm pack --json`'s
  1736	    # `.shasum`, which is npm's legacy SHA-1 and carries no filename -- it
  1737	    # produces neither the algorithm nor the `<sha256>  <name>` format of the
  1738	    # lines below, and under `--dry-run` there is no tarball to hash at all.
  1739	    # An operator following it would have written invalid evidence.
  1740	    #
  1741	    # Command lines are the ones indented as a block (`#` + 3 spaces); prose
  1742	    # that NAMES the rejected recipe is deliberately left readable, so the
  1743	    # gate reads commands, not the whole file.
  1744	    recipe = [
  1745	        line for line in sums.splitlines()
  1746	        if line.startswith("#") and line[1:].startswith("   ")
  1747	    ]
  1748	    assert recipe, "the manifest no longer documents any regeneration command"
  1749	    assert not any(".shasum" in line for line in recipe), (
  1750	        "a regeneration command extracts npm's `.shasum` again -- that is "
  1751	        "SHA-1, not SHA-256, and it emits no filename: %s" % recipe
  1752	    )
  1753	    assert not any("--dry-run" in line for line in recipe), (
  1754	        "a regeneration command runs `npm pack --dry-run` -- it writes no "
  1755	        "tarball, so there is nothing to hash: %s" % recipe
  1756	    )
  1757	    assert any(
  1758	        ("sha256sum" in line or "shasum -a 256" in line) for line in recipe
  1759	    ), "no recipe line names a SHA-256 hasher: %s" % recipe
  1760	    assert any(
  1761	        ("$TARBALL" in line or '"filename"' in line) for line in recipe
  1762	    ), (
  1763	        "the recipe never materialises the tarball NAME -- the manifest "
  1764	        "format is `<sha256>  <filename>`: %s" % recipe
  1765	    )
  1766	    # the writer the file attributes itself to must exist AND hash with the
  1767	    # algorithm the filename promises (attribution is checked, not trusted).
  1768	    writer = REPO_ROOT / "scripts" / "install-npm.sh"
  1769	    assert any("install-npm.sh" in line for line in recipe), (
  1770	        "the recipe no longer points at the real local writer: %s" % recipe
  1771	    )
  1772	    assert writer.exists(), "SHA256SUMS.txt names a writer that is not there"
  1773	    writer_body = writer.read_text(encoding="utf-8")
  1774	    assert "sha256sum" in writer_body or "shasum -a 256" in writer_body, (
  1775	        "install-npm.sh no longer computes a SHA-256 -- the attribution in "
  1776	        "SHA256SUMS.txt has gone stale"
  1777	    )
  1778	    # `files:` really does exclude it — the claim above is checked, not trusted
  1779	    pkg = json.loads((REPO_ROOT / "npm" / "package.json").read_text(encoding="utf-8"))
  1780	    assert not any("SHA256SUMS" in entry for entry in pkg["files"]), (
  1781	        "SHA256SUMS.txt now ships in the tarball — re-open the doc, the "
  1782	        "un-automated control may have become real"
  1783	    )
