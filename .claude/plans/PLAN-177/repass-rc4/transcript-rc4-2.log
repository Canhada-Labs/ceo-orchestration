  1849	# the overlay + marker as untracked files — falsifying PLAN-165 AC-1
  1850	# ("git status stays empty" after `on`) and risking an accidental commit
  1851	# of a machine-specific permission posture. Additive + idempotent, same
  1852	# contract as install_mcp_secrets_dir above.
  1853	install_posture_state_ignores() {
  1854	  local gitignore="$TARGET/.gitignore"
  1855	  local entries
  1856	
  1857	  # PLAN-177 W1 (CF-9): entry list AND append loop live in the ONE generator —
  1858	  # see the rationale on install_mcp_secrets_dir above. Fail LOUD if absent.
  1859	  command -v _posture_state_ignore_entries >/dev/null 2>&1 || {
  1860	    echo "    ERROR: _posture_state_ignore_entries unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot ensure posture-state .gitignore entries" >&2
  1861	    return 1
  1862	  }
  1863	  command -v _apply_posture_state_ignores >/dev/null 2>&1 || {
  1864	    echo "    ERROR: _apply_posture_state_ignores unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot ensure posture-state .gitignore entries" >&2
  1865	    return 1
  1866	  }
  1867	  entries="$( _posture_state_ignore_entries )"
  1868	
  1869	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1870	    echo ""
  1871	    echo "==> Posture-state .gitignore entries (PLAN-165 CX-3)"
  1872	    # t8 P2: the SHARED predicate, not a duplicated -L — the preview must
  1873	    # refuse exactly where the real run refuses, by the same code path.
  1874	    if ! _root_gitignore_symlink_guard "$TARGET/.gitignore" >/dev/null 2>&1; then
  1875	      echo "    (dry-run) ERROR: root .gitignore is a symlink — real run would REFUSE" >&2
  1876	      exit 1
  1877	    fi
  1878	    # t11 P1 #2: honest dry-run for TRACKED sensitive paths too — the
  1879	    # real run refuses and demands git rm --cached.
  1880	    _dry_tracked="$( _gitignore_tracked_sensitive "$TARGET" \
  1881	      ".claude/settings.local.json" ".claude/state" "state/mcp_client_secrets" )"
  1882	    if [ -n "$_dry_tracked" ]; then
  1883	      echo "    (dry-run) ERROR: sensitive path(s) already TRACKED — real run would REFUSE and demand git rm --cached:" >&2
  1884	      printf '%s\n' "$_dry_tracked" | sed 's/^/      /' >&2
  1885	      exit 1
  1886	    fi
  1887	    echo "    (dry-run) would ENSURE .gitignore excludes: $entries"
  1888	    return 0
  1889	  fi
  1890	
  1891	  echo ""
  1892	  echo "==> Posture-state .gitignore entries (PLAN-165 CX-3)"
  1893	  _state_record_op "ensure_posture_state_ignores" "$entries"
  1894	  _apply_posture_state_ignores "$gitignore"
  1895	}
