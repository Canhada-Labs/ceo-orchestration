  2231	def test_checklist_enumerates_the_verdict_fields_the_tag_guard_requires():
  2232	    """The tag guard enforces FOUR verdict fields; the canonical template
  2233	    (.claude/governance/pair-rail-verdict-template.md, W1 ceremony scope)
  2234	    still documents only parent_sha. Until that patch lands, the checklist is
  2235	    the authoring surface — a contract enforced by code but documented on no
  2236	    authoring surface is how the first rc.2 verdict dies at E_VERDICT."""
  2237	    text = (REPO_ROOT / ".github/release-checklist.md").read_text(encoding="utf-8")
  2238	    for field in (
  2239	        "parent_sha",
  2240	        "delta_allowlist",
