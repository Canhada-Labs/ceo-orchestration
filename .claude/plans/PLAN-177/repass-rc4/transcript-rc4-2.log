  1523	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1524	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1525	    Status are not read — a row that claims no enforcement makes no claim to
  1526	    check."""
  1527	    out: List[List[str]] = []
  1528	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1529	        if status != "enforced":
  1530	            continue
  1531	        for workflow, step in _ENFORCED_RX.findall(where):
  1532	            out.append([control, workflow, step])
  1533	    return out
  1534	
