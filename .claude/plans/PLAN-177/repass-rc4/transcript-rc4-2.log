    44	class TestEnvContext(unittest.TestCase):
    45	    """Base test case that isolates env, HOME, CLAUDE_PROJECT_DIR, sys.path.
    46	
    47	    Subclasses that override setUp/tearDown MUST call super().
    48	
    49	    ## CEO_AUDIT_SYNC_MODE default (PLAN-107 Wave A.1)
    50	
    51	    Since PLAN-094 v1.27.0, ``audit_emit`` defaults to **async-spool** writes
    52	    (events buffered in a background spool writer thread). Tests that read
    53	    the audit log buffer immediately after triggering an emit would race
    54	    the spool drain and see stale state. The kill-switch
    55	    ``CEO_AUDIT_SYNC_MODE=1`` reverts to pre-Wave-A synchronous
    56	    fsync-per-call semantics (see ``_lib/spool_writer.py:348``).
    57	
    58	    Lesson [[feedback-test-set-ceo-audit-sync-mode]] (S141) established
    59	    that every emit-read test needs sync mode on. PLAN-107 Wave A.1
    60	    promotes this to a TestEnvContext default — subclasses that genuinely
    61	    exercise the async path (e.g. ``test_audit_emit_async_flush``) opt out
    62	    by setting class attribute ``SYNC_MODE_DEFAULT = False`` and managing
    63	    the env var themselves.
    64	    """
    65	
    66	    # Class-level opt-out for the rare tests that genuinely exercise the
    67	    # async spool path. Subclass and set False to disable the default.
    68	    SYNC_MODE_DEFAULT: bool = True
    69	
    70	    # PLAN-106-FOLLOWUP Wave A.2 — agent-binding fixture opt-in.
    71	    # Subclasses that exercise dispatch paths through VETO_FLOOR_ROLES
    72	    # populate this with the agent names to materialize inside
    73	    # self.project_dir's sandboxed `.claude/agents/` dir. Default is
    74	    # empty list — backwards-compatible no-op for existing subclasses.
    75	    AGENT_BINDINGS_TO_MATERIALIZE: list = []
    76	
    77	    # Attributes populated in setUp
    78	    project_dir: Path
    79	    home_dir: Path
    80	    audit_dir: Path
    81	
    82	    _env_snapshot: Dict[str, Optional[str]]
    83	    _cwd_snapshot: str
    84	    _syspath_snapshot: list
    85	    _tmp_root: Path
    86	
    87	    def setUp(self) -> None:
    88	        """Snapshot environment + build an isolated per-test tmp tree.
    89	
    90	        Captures all env vars matching ``CEO_*``, ``CLAUDE_*``, and
    91	        ``HOME`` into ``self._env_snapshot`` so ``tearDown`` can restore
    92	        them exactly. Creates a temp directory with ``home/`` +
    93	        ``project/`` + ``audit-dir/`` subtrees and points the hook's env
    94	        vars (``HOME``, ``CLAUDE_PROJECT_DIR``, ``CEO_AUDIT_LOG_*``) at
    95	        the isolated tree. Subclass tests can then exercise hook logic
    96	        without touching the real user profile.
    97	        """
    98	        super().setUp()
    99	        # Snapshot env vars we care about so tearDown can restore them.
   100	        # We snapshot a broad set: HOME, CLAUDE_*, CEO_*, and PYTHON*.
   101	        self._env_snapshot = {}
   102	        for key in list(os.environ.keys()):
   103	            if (
   104	                key.startswith("CEO_")
   105	                or key.startswith("CLAUDE_")
   106	                or key == "HOME"
   107	            ):
   108	                self._env_snapshot[key] = os.environ.get(key)
   109	
   110	        # PLAN-107 Wave A.1: parent-shell env-leak prevention.
   111	        # Snapshot above preserves restore semantics, but the test must
   112	        # start with a CLEAN env or parent-shell CEO_KERNEL_OVERRIDE /
   113	        # CEO_QUIET_MODE / CEO_BUDGET_GUARD_* will leak into the test
   114	        # subject's behavior. Strip the most disruptive overrides while
   115	        # the test runs; tearDown restores from the snapshot.
   116	        for key in list(os.environ.keys()):
   117	            if (
   118	                key.startswith("CEO_KERNEL_OVERRIDE")
   119	                or key.startswith("CEO_BUDGET_GUARD_")
   120	                or key.startswith("CEO_PRUNE_")
   121	                or key == "CEO_QUIET_MODE"
   122	                or key == "CEO_OVERHEAD_ACK"
   123	                or key == "CEO_SKIP_REAL_REGISTRY_SMOKE"
   124	                or key == "CEO_SOTA_DISABLE"
   125	            ):
   126	                del os.environ[key]
   127	
   128	        # Snapshot cwd + sys.path
   129	        self._cwd_snapshot = os.getcwd()
   130	        self._syspath_snapshot = list(sys.path)
   131	
   132	        # Build an isolated temp tree:
   133	        #   <tmp_root>/
   134	        #       home/
   135	        #           .claude/projects/test/
   136	        #               (audit-log.jsonl lives here)
   137	        #       project/
   138	        #           .claude/
   139	        #               team.md, frontend-team.md, skills/, ...
   140	        self._tmp_root = Path(tempfile.mkdtemp(prefix="ceo-hook-test-"))
   141	        self.home_dir = self._tmp_root / "home"
   142	        self.project_dir = self._tmp_root / "project"
   143	        self.audit_dir = self.home_dir / ".claude" / "projects" / "test"
   144	
   145	        (self.project_dir / ".claude").mkdir(parents=True, exist_ok=True)
   146	        self.audit_dir.mkdir(parents=True, exist_ok=True)
   147	
   148	        # Point the hook env at the isolated tree
   149	        os.environ["HOME"] = str(self.home_dir)
   150	        os.environ["CLAUDE_PROJECT_DIR"] = str(self.project_dir)
   151	        os.environ["CEO_AUDIT_LOG_DIR"] = str(self.audit_dir)
   152	        os.environ["CEO_AUDIT_LOG_PATH"] = str(self.audit_dir / "audit-log.jsonl")
   153	        os.environ["CEO_AUDIT_LOG_ERR"] = str(self.audit_dir / "audit-log.errors")
   154	        os.environ["CEO_AUDIT_LOG_LOCK"] = str(self.audit_dir / "audit-log.lock")
   155	
   156	        # PLAN-107 Wave A.1 — sync-mode default for emit-read tests.
   157	        # Async-spool was the v1.27.0 default; tests need sync to see emits.
   158	        if self.SYNC_MODE_DEFAULT:
   159	            os.environ["CEO_AUDIT_SYNC_MODE"] = "1"
   160	
   161	        # PLAN-111 Wave A.5 — invalidate spool_writer state-dir cache
   162	        # on test setup (env-tuple may have rotated since last test).
   163	        try:
   164	            from _lib import spool_writer as _spool_writer
   165	            _spool_writer._reset_caches_for_test()
   166	        except Exception:
   167	            pass  # fail-open; cache invalidation is hygiene, not correctness
   168	
   169	
   170	        # PLAN-106-FOLLOWUP Wave A.2 — materialize agent bindings for
   171	        # subclasses that opt in via AGENT_BINDINGS_TO_MATERIALIZE.
   172	        # See `.claude/hooks/tests/_agent_fixture.py` for the helper.
   173	        if self.AGENT_BINDINGS_TO_MATERIALIZE:
   174	            # Lazy import keeps this module's import surface stable.
   175	            from tests._agent_fixture import materialize_agent_binding  # noqa: E402
   176	            for _name in self.AGENT_BINDINGS_TO_MATERIALIZE:
   177	                materialize_agent_binding(
   178	                    self.project_dir, _name, tmp_root=self._tmp_root,
   179	                )
   180	
   181	    def tearDown(self) -> None:
   182	        """Restore env + cwd + sys.path + remove the per-test tmp tree.
   183	
   184	        Two-step env restoration:
   185	
   186	        1. Remove any ``CEO_*``/``CLAUDE_*``/``HOME`` env var NOT present
   187	           in ``self._env_snapshot`` (tests may have added new ones).
   188	        2. Restore the snapshotted values (delete if value was ``None``
   189	           indicating originally-unset, otherwise set to recorded value).
   190	
   191	        Also chdir back to the original cwd and restore ``sys.path`` so
   192	        test-local imports don't leak between cases.
   193	        """
   194	
   195	        # PLAN-111 Wave A.5 — invalidate spool_writer state-dir cache
   196	        # on test teardown (env restored so cache will resolve to a
   197	        # potentially-now-deleted tmpdir).
   198	        try:
   199	            from _lib import spool_writer as _spool_writer
   200	            _spool_writer._reset_caches_for_test()
   201	        except Exception:
   202	            pass
   203	        # Restore env
   204	        # 1. Remove any env vars we may have set that weren't in the snapshot
   205	        for key in list(os.environ.keys()):
   206	            if (
   207	                key.startswith("CEO_")
   208	                or key.startswith("CLAUDE_")
   209	                or key == "HOME"
   210	            ):
   211	                if key not in self._env_snapshot:
   212	                    del os.environ[key]
   213	        # 2. Restore snapshotted values
   214	        for key, value in self._env_snapshot.items():
   215	            if value is None:
   216	                os.environ.pop(key, None)
   217	            else:
   218	                os.environ[key] = value
   219	
   220	        # Restore cwd + sys.path
   221	        try:
   222	            os.chdir(self._cwd_snapshot)
   223	        except OSError:
   224	            pass
   225	        sys.path[:] = self._syspath_snapshot
   226	
   227	        # Clean the temp dir
   228	        shutil.rmtree(self._tmp_root, ignore_errors=True)
   229	
   230	        super().tearDown()
