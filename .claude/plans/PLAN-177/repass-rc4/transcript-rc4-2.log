  1443	INTEGRITY_DOC = REPO_ROOT / "npm" / "INTEGRITY.md"
  1444	# Closed set. A row whose Status is anything else is a red — fail-closed on
  1445	# unknown vocabulary, because the way this table decayed the first time was a
  1446	# cell that READ like enforcement ("(to-add)", "Release script (Sprint 17
  1447	# scope)") without ever being it.
  1448	_CONTRACT_STATUSES = ("enforced", "deferred", "operator")
  1449	# `<workflow>.yml` in backticks, then the step name in straight quotes. Both
  1450	# delimiters are load-bearing: they are what makes the claim parseable at all.
  1451	_ENFORCED_RX = re.compile(r'`([^`]+\.yml)`\s+step\s+"([^"]+)"')
  1452	# Without a floor, a parser that suddenly matches nothing reports zero
  1453	# offenders and the gate passes having checked NOTHING. Two is the smallest
  1454	# floor that also keeps a one-row table from satisfying it by accident.
  1455	_MIN_ENFORCED_PAIRS = 2
