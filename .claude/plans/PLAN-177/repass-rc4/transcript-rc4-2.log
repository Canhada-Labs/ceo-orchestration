   790	# Re-pass rc.4 t2 (P2): with NO readable install-state the old default was
   791	# maintainer (fail-open) — a pre-v1.2 USER-ceremony install could receive
   792	# root .gitignore writes across the user boundary. The fail-SAFE default is
   793	# user (root surfaces skipped, loudly); a pre-state MAINTAINER install opts
   794	# back in explicitly via CEO_UPGRADE_CEREMONY=maintainer.
   795	CEREMONY_EFFECTIVE="user"
   796	_CEREMONY_SOURCE="default (no readable install-state — fail-safe user; pass --ceremony maintainer to opt back in)"
   797	# t5 P1: only RECORDED or EXPLICIT resolutions may persist into the state
   798	# file — persisting the fail-safe INFERENCE would make one missed migration
   799	# flag permanent (recorded state wins on the next run by design).
   800	_CEREMONY_PERSIST="0"
   801	_cer_line=""
   802	if _cer_line="$(_read_install_state_ceremony)" && [[ -n "$_cer_line" ]]; then
   803	  CEREMONY_EFFECTIVE="$_cer_line"
   804	  _CEREMONY_SOURCE="recorded install request (.claude/.install-state.json)"
   805	  _CEREMONY_PERSIST="1"
   806	elif [[ -n "${CEREMONY_FLAG:-}" ]]; then
   807	  CEREMONY_EFFECTIVE="$CEREMONY_FLAG"
   808	  _CEREMONY_SOURCE="explicit --ceremony flag (no install-state)"
   809	  _CEREMONY_PERSIST="1"
   810	elif [[ "${CEO_UPGRADE_CEREMONY:-}" == "maintainer" || "${CEO_UPGRADE_CEREMONY:-}" == "user" ]]; then
   811	  CEREMONY_EFFECTIVE="$CEO_UPGRADE_CEREMONY"
   812	  _CEREMONY_SOURCE="explicit CEO_UPGRADE_CEREMONY override (no install-state)"
   813	  _CEREMONY_PERSIST="1"
   814	fi
