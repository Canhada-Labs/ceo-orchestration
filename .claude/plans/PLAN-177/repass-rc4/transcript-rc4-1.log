   186	# ---------------------------------------------------------------------------
   187	# (a) ancestry
   188	# ---------------------------------------------------------------------------
   189	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   190	    ref = "%s/%s" % (remote, branch)
   191	    if offline_ack:
   192	        print(
   193	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   194	            "merge-base below is judged against a possibly STALE %s" % ref
   195	        )
   196	    else:
   197	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   198	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   199	        # stale ref reads as approval.
   200	        if rc != 0:
   201	            return _fail(
   202	                E_FETCH,
   203	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   204	                "      This is NOT a verdict on the commit — the check did not "
   205	                "run.\n"
   206	                "      Fix the network/remote and re-run, or, if you are "
   207	                "deliberately\n"
   208	                "      offline and accept judging against the last-known ref, "
   209	                "re-run\n"
   210	                "      with --offline-ack (it is recorded in the output).\n"
   211	                "      git said: %s" % (remote, branch, rc, err.strip()),
   212	            )
   213	        print("  ok   fetched %s" % ref)
   214	
   215	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   216	    if rc != 0 or not out.strip():
   217	        return _fail(
   218	            E_REMOTE_REF,
   219	            "no usable ref %s in this repo — cannot judge ancestry "
   220	            "(git said: %s)" % (ref, err.strip()),
   221	        )
   222	    remote_sha = out.strip()
   223	
   224	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   225	    if rc == 0:
   226	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   227	        return 0
   228	    if rc == 1:
   229	        return _fail(
   230	            E_NOT_ANCESTOR,
   231	            "HEAD is not an ancestor of %s — push main and re-run the "
   232	            "preflight.\n"
   233	            "      A tag on an unpushed commit points at a tree CI never "
   234	            "saw; the\n"
   235	            "      preflight's green verdict was about a different SHA."
   236	            % ref,
   237	        )
   238	    return _fail(
   239	        E_REMOTE_REF,
   240	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   241	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   242	    )
   243	
