  2362	def _write_live_shaped_verdict(
  2363	    path: Path, tag: str, decisions: Sequence[str], parent: str
  2364	) -> None:
  2365	    """A verdict envelope the LIVE governance files accept end to end.
  2366	
  2367	    `decisions` is a SEQUENCE so the fixture can express the three shapes the
  2368	    gate must separate: zero lines (absent), one line (normal), two lines (the
  2369	    last-wins override). Values are written verbatim -- a malformed or unknown
  2370	    token reaches the validator exactly as authored.
  2371	    """
  2372	    tv = _live_tool_versions()
  2373	    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
  2374	    lines = ["# Pair-Rail Verdict -- fixture", "", "```yaml"]
  2375	    lines += [_decision_line(d).rstrip("\n") for d in decisions]
  2376	    lines += [
  2377	        "generated_at: %sZ" % now,
  2378	        "ttl_hours: 24",
  2379	        "parent_sha: %s" % parent,
  2380	        "release_tag: %s" % tag,
  2381	        "inputs_hash: %s" % _live_inputs_hash(),
  2382	        "tool_versions:",
  2383	        "  codex_cli: %s" % tv["codex_cli"],
  2384	        "  codex_target_triple: %s" % tv["codex_target_triple"],
  2385	        "  codex_payload_sha256: %s" % tv["codex_payload_sha256"],
  2386	        "gpg_signature: -----BEGIN PGP SIGNATURE----- fixture-not-a-signature",
  2387	        "```",
  2388	        "",
  2389	    ]
  2390	    path.write_text("\n".join(lines), encoding="utf-8")
