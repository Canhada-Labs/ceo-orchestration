  2595	def test_a_malformed_decision_is_invalid_never_infra(tmp_path, ci_env):
  2596	    """CF-1: exit 3 (INVALID), never 1 (INFRA) and never a traceback.
  2597	
  2598	    The distinction is load-bearing: release.yml routes INFRA through
  2599	    CEO_PAIR_RAIL_VERDICT_OPTIONAL, so a malformed decision leaving by the
  2600	    infra door would be waivable by a repository variable.
  2601	    """
