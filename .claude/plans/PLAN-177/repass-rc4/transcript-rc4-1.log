  2792	def test_both_rails_answer_identically_on_every_key_shape():
  2793	    """The instrument that would have caught P1-a: ONE question, two readers.
  2794	
  2795	    A divergence is only visible when the same bytes are put to both. For any
  2796	    block both accept, they must also agree on how many decisions it declares
  2797	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2798	    things on the two machines that gate a release.
  2799	    """
  2800	    def block(body: str) -> str:
  2801	        return "# fixture\n\n```yaml\n%s```\n" % body
  2802	
  2803	    canonical_shapes = [
  2804	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2805	        "verdict: NO-GO\nverdict: GO\n",
  2806	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2807	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2808	        "verdict: GO  # inline comment\n",
  2809	        "verdict: GO#NO-GO\nrelease_tag: v1.2.3\n",
  2810	        "# verdict: NO-GO\nverdict: GO\n",
  2811	    ]
  2812	    noncanonical_shapes = [
  2813	        "verdict:GO\n",
  2814	        "verdict: GO\n  NO-GO\nrelease_tag: v1.2.3\n",
  2815	        "verdict : NO-GO\nverdict: GO\n",
  2816	        "verdict\t: NO-GO\nverdict: GO\n",
  2817	        "verdict : GO\n",
  2818	        '"verdict": GO\n',
  2819	        "verdict :GO\n",
  2820	        # Re-pass rc.4 t7 P1: an ORPHAN-indented first line (no active bare
  2821	        # parent) previously slipped the prev_scalar_decl=False initial
  2822	        # state — `  verdict: NO-GO` + `verdict: GO` resolved as GO.
  2823	        "  verdict: NO-GO\nverdict: GO\n",
  2824	        # Same class after a scalar has RESET the state to non-bare.
  2825	        "release_tag: v1.2.3\n  verdict: NO-GO\nverdict: GO\n",
  2826	        # Root-level list item: this signed format's only lists are
  2827	        # INDENTED under a bare key; a root `- item` is malformed and was
  2828	        # accepted outright.
  2829	        "- verdict: NO-GO\nverdict: GO\n",
  2830	        "verdict: GO\n- trailing root list item\n",
  2831	        # Re-pass rc.4 t8 P1: Unicode-aware strip() in the SHAPE classifier
  2832	        # treated a U+00A0 VALUE as a bare parent (legitimizing an
  2833	        # orphan-indented line under it) and a lone-U+00A0 line as blank.
  2834	        "padding: \u00a0\n  verdict: NO-GO\nverdict: GO\n",
  2835	        "\u00a0\nverdict: GO\n",
  2836	        # Re-pass rc.4 t9 P1 #2: str.splitlines() also splits on VT/FF/
  2837	        # FS-RS/NEL/LS/PS \u2014 `GO<U+000B>#NO-GO` parsed as the exact token
  2838	        # GO on both rails. The extractor now rejects every control byte
  2839	        # except TAB and every separator except LF.
  2840	        "verdict: GO\u000b#NO-GO\n",
  2841	        "verdict: GO\u2028verdict: NO-GO\n",
  2842	        "verdict: GO\u0085release_tag: v1.2.3\n",
  2843	        "verdict: GO\r\nrelease_tag: v1.2.3\n",
  2844	    ]
  2845	    for body in canonical_shapes:
  2846	        text = block(body)
  2847	        assert validator.noncanonical_top_level_lines(text) == [], body
  2848	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2849	        assert validator.count_top_level_key(
  2850	            text, "verdict"
  2851	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2852	            "the two rails disagree on how many decisions %r declares" % body
  2853	        )
  2854	        assert validator.parse_verdict_text(text).get(
  2855	            "verdict"
  2856	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2857	            "the two rails disagree on WHICH decision wins in %r" % body
  2858	        )
  2859	    for body in noncanonical_shapes:
  2860	        text = block(body)
  2861	        assert validator.noncanonical_top_level_lines(text) != [], body
  2862	        assert (
  2863	            tag_guard._noncanonical_top_level_lines(text)
  2864	            == validator.noncanonical_top_level_lines(text)
  2865	        ), "the two shape gates disagree about %r" % body
