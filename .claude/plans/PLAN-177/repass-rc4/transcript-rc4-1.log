   245	# ---------------------------------------------------------------------------
   246	# (b) restricted delta
   247	# ---------------------------------------------------------------------------
   248	def _parse_verdict(text: str) -> Dict[str, object]:
   249	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   250	
   251	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   252	    of `  - item` list entries, and ignores everything else. Anything it cannot
   253	    read is absent, and every consumer below treats absent as fail-closed.
   254	
   255	    Parity with the step-15 reader (`.github/scripts/
   256	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   257	    scope: block selection (the regex below is the validator's own — the
   258	    first ```yaml fence, not the first fence of any language) and inline
   259	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   260	    parse_verdict_file reads key:value and sub-dicts and would drop
   261	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   262	    ONE shared reader (this file is the declared reference), never grow a
   263	    third parser of the same signed file.
   264	    """
   265	    fields: Dict[str, object] = {}
   266	    _body = _extract_single_yaml_block(text)
   267	    if _body is None:
   268	        # No/ambiguous/forbidden-bytes block -> no fields -> every
   269	        # consumer below fails closed.
   270	        return fields
   271	    cur_list: Optional[str] = None
   272	    for raw in _body.split("\n"):
   273	        line = _strip_yaml_comment(raw)
   274	        if not line.strip():
   275	            continue
   276	        if line.startswith(("  - ", "- ")) and cur_list:
   277	            item = line.split("-", 1)[1].strip()
   278	            if item:
   279	                fields[cur_list].append(item)  # type: ignore[union-attr]
   280	            continue
   281	        # [ \t]* not \s* (t5 P1): Python \s is Unicode-aware and would
   282	        # swallow a NBSP that must stay attached to the VALUE.
   283	        m = re.match(r"\A([A-Za-z0-9_]+):(?:[ \t]+(.*))?\Z", line)
   284	        if not m:
   285	            continue
   286	        key, val = m.group(1), (m.group(2) or "").strip(" \t")
   287	        if val == "":
   288	            fields[key] = []
   289	            cur_list = key
   290	        else:
   291	            fields[key] = val
   292	            cur_list = None
   293	    return fields
   294	
   295	
   296	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   297	# The two readers of this signed file disagreed about what a key IS: the
   298	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   299	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   300	# file demand the colon immediately after the name, so they skipped the line.
   301	# The valid-YAML pair
   302	#
   303	#     verdict : NO-GO
   304	#     verdict: GO
   305	#
   306	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   307	# and this is the rail that enforces in every mode, so the tag was authorised.
   308	#
   309	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   310	# fail-closed. Trimming the key in both readers would also close the
   311	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   312	# author writes and no template emits; refusing the shape is the smaller
   313	# surface and is the only behaviour that cannot silently prefer a value.
   314	# A top-level line is canonical iff it is `name:` with no whitespace before
   315	# the colon; list items are legal ONLY indented under an active bare
   316	# key (t8 P2: a root `- item` is rejected — the old comment said
   317	# otherwise and misled operators).
   318	def _strip_yaml_comment(raw):
   319	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   320	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   321	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Byte-for-
   322	    byte twin of `_strip_comment` in validate-pair-rail-verdict.py.
   323	    """
   324	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   325	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   326	    if raw.lstrip(" \t").startswith("#"):
   327	        return ""
   328	    i = 0
   329	    while True:
   330	        j = raw.find("#", i)
   331	        if j == -1:
   332	            return raw.rstrip(" \t")
   333	        if j > 0 and raw[j - 1] in (" ", "\t"):
   334	            return raw[:j].rstrip(" \t")
   335	        i = j + 1
   336	
   337	
   338	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   339	
   340	
   341	def _noncanonical_top_level_lines(text: str) -> List[str]:
   342	    """Top-level lines of the yaml block that are not canonical declarations.
   343	
   344	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   345	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   346	    separate machines; neither may import the other — keep them identical).
   347	    Empty list == the block speaks the grammar both readers assume.
   348	    """
   349	    body = _extract_single_yaml_block(text)
   350	    if body is None:
   351	        return ["<yaml block rejected: ambiguous fence, bad opener, or "
   352	                "forbidden control/separator bytes>"]
   353	    bad: List[str] = []
   354	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   355	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   356	    # Both None (before any key) and "scalar" reject — an orphan-indented
   357	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   358	    # through the prev_scalar_decl=False initial state and resolved as GO,
   359	    # and a root-level `- item` is malformed for this signed format (its
   360	    # only lists are INDENTED under a bare key) yet was accepted outright.
   361	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   362	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   363	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   364	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   365	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   366	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   367	    # reopening the orphan-indentation class through the whitespace side.
   368	    parent = None  # None | "scalar" | "bare"
   369	    for raw in body.split("\n"):
   370	        line = _strip_yaml_comment(raw)
   371	        if not line.strip(" \t"):
   372	            continue
   373	        if line[0] in (" ", "\t"):
   374	            if parent != "bare":
   375	                bad.append(line)
   376	            continue
   377	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   378	            _key, _, _val = line.partition(":")
   379	            parent = "scalar" if _val.strip(" \t") else "bare"
   380	            continue
   381	        bad.append(line)
   382	        parent = None
   383	    return bad
   384	
   385	
   386	def _count_top_level_key(text: str, key: str) -> int:
   387	    """How many times `key:` is declared at the top level of the block.
   388	
   389	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   390	    step-15 reader: a second `verdict:` silently overrides the first, so
   391	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   392	    block selection and same comment rule as the reader, or the count
   393	    would be about a different text than the parse.
   394	
   395	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   396	    counter does NOT strip the key and the step-15 twin does, so on a
   397	    non-canonical block the two counts differ. delta() checks the shape
   398	    first.
   399	    """
   400	    _body = _extract_single_yaml_block(text)
   401	    if _body is None:
   402	        return 0
   403	    seen = 0
   404	    for raw in _body.split("\n"):
   405	        line = _strip_yaml_comment(raw)
   406	        if not line.strip() or line[0] in (" ", "\t"):
   407	            continue
   408	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   409	        if m and m.group(1) == key:
   410	            seen += 1
   411	    return seen
   412	
   413	
   414	def _sha256(path: str) -> str:
   415	    h = hashlib.sha256()
   416	    with open(path, "rb") as fh:
   417	        for chunk in iter(lambda: fh.read(65536), b""):
   418	            h.update(chunk)
   419	    return h.hexdigest()
   420	
   421	
   422	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   423	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   424	    entries: List[Tuple[str, str]] = []
   425	    # t10 P2: newline="" keeps CR bytes visible to the grammar.
   426	    with open(path, encoding="utf-8", newline="") as fh:
   427	        for line in fh:
   428	            line = line.rstrip("\n")
   429	            if not line.strip():
   430	                continue
   431	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   432	            if not m:
   433	                raise ValueError("unparsable manifest line: %r" % line)
   434	            entries.append((m.group(1), m.group(2)))
   435	    return entries
   436	
   437	
   438	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   439	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   440	    directory = os.path.dirname(manifest) or "."
   441	    name = os.path.basename(manifest)
   442	    try:
   443	        proc = subprocess.run(
   444	            ["shasum", "-a", "256", "-c", name],
   445	            cwd=directory,
   446	            stdout=subprocess.PIPE,
   447	            stderr=subprocess.STDOUT,
   448	            universal_newlines=True,
   449	        )
   450	        return proc.returncode == 0, proc.stdout.strip()
   451	    except (OSError, FileNotFoundError):
   452	        bad: List[str] = []
   453	        for want, rel in _read_manifest(manifest):
   454	            full = os.path.join(directory, rel)
   455	            if not os.path.isfile(full) or _sha256(full) != want:
   456	                bad.append(rel)
   457	        if bad:
   458	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   459	        return True, "hashlib fallback: all entries match"
   460	
   461	
   462	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   463	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   464	    verdict_abs = os.path.join(repo, verdict_rel)
   465	    if not os.path.isfile(verdict_abs):
   466	        return _fail(
   467	            E_VERDICT,
   468	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   469	            "be committed before the tag is cut (release.yml validates it per "
   470	            "tag on the tagged tree)." % verdict_rel,
   471	        )
   472	    # t10 P2: newline="" keeps CR bytes visible to the grammar.
   473	    with open(verdict_abs, encoding="utf-8", newline="") as fh:
   474	        verdict_text = fh.read()
   475	    # PLAN-177 t2 (P1-a): SHAPE BEFORE ANY FIELD. Both rails read this file;
   476	    # they only agree on a canonical block. A non-canonical top-level line is
   477	    # refused here rather than handed to two different grammars — E_DECISION
   478	    # because the class this closes is the decision override (`verdict :
   479	    # NO-GO` + `verdict: GO`), and because a refusal that names the decision
   480	    # rail is the one an operator can act on.
   481	    noncanonical = _noncanonical_top_level_lines(verdict_text)
   482	    if noncanonical:
   483	        return _fail(
   484	            E_DECISION,
   485	            "verdict %s: non-canonical top-level key syntax %r -- a "
   486	            "top-level line must be\n"
   487	            "      `name:` with no whitespace before the colon (or a `- ` "
   488	            "list item only when INDENTED under a bare key, never at the "
   489	            "root). The two release rails read this\n"
   490	            "      file with different grammars, so `verdict : NO-GO` "
   491	            "followed by `verdict: GO` counts as two\n"
   492	            "      declarations server-side and one here; the shape is "
   493	            "refused instead of guessed."
   494	            % (verdict_rel, noncanonical),
   495	        )
   496	    fields = _parse_verdict(verdict_text)
   497	
   498	    release_tag = fields.get("release_tag")
   499	    if release_tag != tag:
   500	        return _fail(
   501	            E_VERDICT,
   502	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   503	            "to judge this tag against another tag's verdict."
   504	            % (verdict_rel, release_tag, tag),
   505	        )
   506	    # PLAN-177 W0.1 (P1-4) -- the DECISION gate.
   507	    #
   508	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on): the
   509	    # server-side twin (.github/scripts/validate-pair-rail-verdict.py, step
   510	    # 15) carries `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   511	    # (release.yml:689) -- there the decision check is defence in depth.
   512	    # THIS is the rail that enforces in every mode: release.sh calls it with
   513	    # `|| die`, and the release.yml step that calls it carries no escape
   514	    # hatch. Neither may be dropped for the other.
   515	    #
   516	    # Fail-CLOSED on SHAPE as well as value (CF-1): _parse_verdict returns a
   517	    # LIST for an empty `verdict:` line, so the type check precedes the
   518	    # compare -- a malformed decision is a named refusal, never a crash.
   519	    declared_decisions = _count_top_level_key(verdict_text, "verdict")
   520	    if declared_decisions > 1:
