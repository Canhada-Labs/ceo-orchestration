   529	                    f"(='{legacy_sha[:12]}'); --parent-sha bind skipped. "
   530	                    f"Re-author verdict with parent_sha for full S104 "
   531	                    f"bind enforcement.",
   532	                    file=sys.stderr,
   533	                )
   534	            else:
