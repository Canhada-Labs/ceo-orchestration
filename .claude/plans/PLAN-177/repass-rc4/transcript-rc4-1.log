   554	            print(
   555	                f"INVALID: verdict commit_sha mismatch — "
   556	                f"declared='{declared_sha[:12]}', argv='{args.commit_sha[:12]}'",
   557	                file=sys.stderr,
   558	            )
   559	            return EXIT_VERDICT_INVALID
