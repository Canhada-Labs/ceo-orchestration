  2744	    assert tag_guard._parse_verdict(quoted_only_envelope).get("verdict") != "GO"
  2745	    # t12 P1: a complete envelope QUOTED inside a four-backtick block as
  2746	    # the document's ONLY ```yaml occurrence must NOT become authoritative
  2747	    # (count==1 passed; the first-fence binding now rejects it).
  2748	    quoted_only_envelope = (
  2749	        "# quoted example, real decision in prose\n\n"
  2750	        "````markdown\n"
  2751	        "```yaml\n"
  2752	        "verdict: GO\n"
  2753	        "release_tag: v9.9.9\n"
  2754	        "```\n"
  2755	        "````\n\n"
