   541	        elif declared_parent != args.parent_sha:
   542	            print(
   543	                f"INVALID: verdict parent_sha mismatch — "
   544	                f"declared='{declared_parent[:12]}', "
   545	                f"argv='{args.parent_sha[:12]}'",
   546	                file=sys.stderr,
   547	            )
   548	            return EXIT_VERDICT_INVALID
   549	    elif args.commit_sha:
   550	        # Legacy path — only used when --parent-sha not passed (e.g.
   551	        # bridging older release.yml invocations against new validator).
   552	        declared_sha = verdict.get("commit_sha", "").strip()
