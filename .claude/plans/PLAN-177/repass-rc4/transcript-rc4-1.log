    98	# PLAN-177 W0.1 (P1-4). Spelled out here rather than imported from
    99	# .github/scripts/validate-pair-rail-verdict.py: the two rails are separate
   100	# processes on separate machines and neither may become a dependency of the
   101	# other. The set itself comes from
   102	# .claude/governance/pair-rail-verdict-template.md. EXACT equality, no case
   103	# folding and no prefix/substring rule -- NO-GO contains GO.
   104	ACCEPTED_DECISIONS = ("GO", "GO-WITH-CONDITIONS")
   105	
   106	HEX40 = re.compile(r"\A[0-9a-f]{40}\Z")
   107	
   108	# t9 P1 (byte-for-byte twin of the step-15 validator): ONE strict
   109	# extractor for the signed yaml block.
   110	#   * the artifact must contain EXACTLY ONE occurrence of the literal
   111	#     three-backtick yaml opener anywhere — a second occurrence (even
   112	#     quoted inside a four-backtick block) makes the authoritative block
   113	#     ambiguous, so the artifact is rejected fail-closed;
   114	#   * the opener must sit at line start, column 0, closed by a
   115	#     line-start fence — an unanchored search let a quoted GO envelope
   116	#     inside a four-backtick block shadow the real NO-GO one;
   117	#   * the body must be free of every line separator except LF and every
   118	#     control char except TAB: str.splitlines() also splits on
   119	#     U+000B/000C/001C-001E/0085/2028/2029, so a value glued to
   120	#     <U+000B>#NO-GO parsed as the exact token GO on both rails.
   121	# Returns the block body, or None when the artifact is rejected.
   122	_FORBIDDEN_CTRL_RE = re.compile(
   123	    "[\u0000-\u0008\u000b-\u001f\u007f\u0085\u2028\u2029]"
   124	)
   125	
   126	
   127	def _extract_single_yaml_block(text):
   128	    if text.count("```yaml") != 1:
   129	        return None
   130	    # t12 P1: the FIRST fence of the document must BE the canonical
   131	    # yaml opener — a complete envelope quoted inside a four-backtick
   132	    # block as the document's ONLY ```yaml occurrence passed the
   133	    # count==1 gate and became authoritative while the real decision
   134	    # sat in prose. Any fence-looking line BEFORE the opener rejects.
   135	    _first_fence = re.search(r"(?m)^`{3,}", text)
   136	    if _first_fence is not None and not text[
   137	        _first_fence.start():
   138	    ].startswith("```yaml"):
   139	        return None
   140	    # t10 P1: the CLOSER must be canonical too — a bare ^``` matched
   141	    # ANY line starting with three backticks, so ```not-a-closer
   142	    # closed the body early and hid a later NO-GO.
   143	    m = re.search(
   144	        r"(?m)^```yaml[ \t]*\n(.*?)^```[ \t]*(?:\n|\Z)",
   145	        text,
   146	        re.DOTALL,
   147	    )
   148	    if not m:
   149	        return None
   150	    body = m.group(1)
   151	    if _FORBIDDEN_CTRL_RE.search(body):
   152	        return None
   153	    return body
   154	
   155	HEX64 = re.compile(r"\A[0-9a-f]{64}\Z")
   156	GLOB_CHARS = "*?["
   157	VERDICT_PREFIX = ".claude/governance/pair-rail-verdict-"
   158	# The allowlist is EXHAUSTIVE, not merely closed: the verdict for this tag plus
   159	# plan-side evidence (the `verdict-fields-<TAG>` pair and the re-pass artifact
   160	# directory both live under `.claude/plans/`). Anything else — a version site, a
   161	# workflow, any code path — would re-open the very hole the delta assert exists
   162	# to close: a post-review bump commit riding in on the tag.
   163	EVIDENCE_PREFIX = ".claude/plans/"
   164	
