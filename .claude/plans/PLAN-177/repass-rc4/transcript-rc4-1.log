  2253	# ===========================================================================
  2254	# PLAN-177 W0.1 (P1-4) -- the pair-rail DECISION gate
  2255	# ===========================================================================
  2256	# The re-pass of 2026-08-12 found that BOTH release rails read the verdict
  2257	# envelope for pinning, TTL, anchor and delta, and NEITHER read the decision:
  2258	# a cross-model NO-GO returned "OK: verdict ... valid" / exit 0 from the
  2259	# server-side validator, release-gate went green, and only the Owner running
  2260	# OWNER-GA-CUT.sh stood between a negative review and an irreversible publish.
  2261	#
  2262	# CF-3 asymmetry, restated here because it decides what each control PROVES:
  2263	# step 15 carries continue-on-error under CEO_PAIR_RAIL_VERDICT_OPTIONAL=1, so
  2264	# the validator control is a UNIT control over defence in depth; the control
  2265	# that stands for enforcement in every mode is the tag-guard one below.
  2266	_VALIDATOR_INPUTS_HASH_CACHE = {}
  2267	
  2268	# Anchors on the DIAGNOSTIC, not just the exit code: a gate that fires for the
  2269	# wrong reason is a dead probe wearing a green badge (S-lesson: a control that
  2270	# cannot fail proves nothing).
  2271	_ACCEPTED_SET_TEXT = "{GO, GO-WITH-CONDITIONS}"
  2272	_DECISION_REFUSED = "not in " + _ACCEPTED_SET_TEXT
  2273	_CI_DUPLICATE_DIAGNOSTIC = "verdict decision declared more than once"
  2274	_GUARD_DUPLICATE_DIAGNOSTIC = "declares the decision"
  2275	
  2276	# Value-shaped refusals. `GO | NO-GO | GO-WITH-CONDITIONS` is the LITERAL of
  2277	# pair-rail-verdict-template.md:13 -- an envelope copied from the template
  2278	# without filling the field in.
  2279	_REFUSED_DECISIONS = [
  2280	    ["NO-GO"],
  2281	    [],
  2282	    ["MAYBE"],
  2283	    [""],
  2284	    ["go"],
  2285	    ["no-go"],
  2286	    ["GO WITH CONDITIONS"],
  2287	    ["GO | NO-GO | GO-WITH-CONDITIONS"],
  2288	    # Re-pass rc.4 t3 P1: `#` WITHOUT preceding whitespace is NOT a YAML
  2289	    # comment — these are single unknown values, not GO + comment.
  2290	    ["GO#NO-GO"],
  2291	    ["GO-WITH-CONDITIONS#NO-GO"],
  2292	    # Re-pass rc.4 t5 P1: Unicode whitespace must stay attached to the
  2293	    # VALUE — `GO<U+00A0>` is not the exact authorizing token.
  2294	    ["GO\u00a0"],
  2295	    ["\u00a0GO"],
  2296	    ["GO-WITH-CONDITIONS\u00a0"],
  2297	]
  2298	_REFUSED_IDS = [
  2299	    "no-go", "absent", "unknown", "empty", "lowercase", "lower-no-go",
  2300	    "spaced", "template-literal",
  2301	    "hash-glued-no-go", "hash-glued-gwc",
  2302	    "trailing-nbsp", "leading-nbsp", "gwc-trailing-nbsp",
  2303	]
