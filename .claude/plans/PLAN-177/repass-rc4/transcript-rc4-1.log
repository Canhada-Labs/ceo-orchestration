   175	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   176	    proc = subprocess.run(
   177	        ["git"] + list(args),
   178	        cwd=repo,
   179	        stdout=subprocess.PIPE,
   180	        stderr=subprocess.PIPE,
   181	        universal_newlines=True,
   182	    )
   183	    return proc.returncode, proc.stdout, proc.stderr
