  2524	# PLAN-177 t2 (re-pass rc.4 P1-a) -- the GRAMMAR the two rails share.
  2525	#
  2526	# `verdict : NO-GO` is valid YAML and last-wins under a real parser. The
  2527	# server validator strips the key, so it counted TWO declarations; the local
  2528	# tag guard's regex required the colon immediately after the name, so it
  2529	# counted ONE and parsed GO -- and the local guard is the rail with no escape
  2530	# hatch. The first round of controls could not see this: every fixture line
  2531	# was built as `"verdict: %s"`, which can only produce canonical keys.
  2532	#
  2533	# Cured semantics (identical in both files): non-canonical top-level syntax
  2534	# is REFUSED. So the duplicate variants are red for the SHAPE, and the single
  2535	# non-canonical key is red too -- an authorizing decision must be spelled the
  2536	# one way the template spells it.
  2537	_NONCANONICAL_DIAGNOSTIC = "non-canonical top-level key syntax"
  2538	_NONCANONICAL_DECISIONS = [
  2539	    [("verdict ", "NO-GO"), "GO"],
  2540	    [("verdict\t", "NO-GO"), "GO"],
  2541	    [("verdict ", "GO")],
  2542	    [("verdict\t", "GO")],
  2543	    # Re-pass rc.4 t2 P1: an INDENTED CONTINUATION line after the scalar —
  2544	    # valid YAML resolving to the non-authorizing scalar "GO NO-GO", which
  2545	    # both minimal readers previously read as `GO` (indented lines were
  2546	    # unconditionally skipped). Written verbatim by _decision_line.
  2547	    ["GO\n  NO-GO"],
  2548	]
  2549	_NONCANONICAL_IDS = [
  2550	    "space-before-colon-duplicate", "tab-before-colon-duplicate",
  2551	    "space-before-colon-alone", "tab-before-colon-alone",
  2552	    "indented-continuation",
  2553	]
  2554	
