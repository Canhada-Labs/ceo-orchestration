   166	def _fail(code: int, msg: str) -> int:
   167	    # Flush the ok-lines first: an operator reading a release failure must see
   168	    # WHICH checks passed before the one that stopped it, in order.
   169	    sys.stdout.flush()
   170	    print("FAIL: %s" % msg, file=sys.stderr)
   171	    sys.stderr.flush()
   172	    return code
   173	
