  1195	SEMVER_RX = re.compile(r"\b\d+\.\d+\.\d+\b")
  1196	# "<number> [word] site(s)" — a census in a comment has no oracle behind it.
  1197	# repass-r2 part-d P2: ordinals count too — "12th site" is as much an
  1198	# oracle-less census claim as "12 sites"; the guard missed the suffix.
  1199	SITE_COUNT_RX = re.compile(
  1200	    r"\b(?:one|two|three|four|five|six|seven|eight|nine|ten|"
  1201	    r"\d+(?:st|nd|rd|th)?)\s+"
  1202	    r"(?:\w+\s+)?sites?\b",
  1203	    re.IGNORECASE,
  1204	)
  1205	# Assembled at RUNTIME, never as a literal: a control whose own file is a hit
  1206	# has to exempt itself, and an exemption is how a control stops controlling.
  1207	# (`"a" "b"` and `"a" + "b"` are both folded by the compiler and would land in
  1208	# this module's .pyc verbatim; str.join is not folded.)
  1209	OLD_DRIVER_STEM = "-".join(("release", "v1", "2", "0"))
  1210	# PLAN-177 W0 item 2 (P1-2): the npm docs joined the roots because they were
  1211	# the one published surface no scanner could see — `npm/INTEGRITY.md` carried
  1212	# a hardcoded version through several releases and every gate stayed green.
  1213	# They are listed as FILES, never as the `npm` directory: `npm/` receives a
  1214	# mirrored copy of `.claude/**` + `scripts/**` (the publish staging rsync, and
  1215	# any local `install-npm.sh` run), so a directory root would have the scanner
  1216	# auditing clones of this repo — slow, and every hit a duplicate of a hit it
  1217	# already reported. `RELEASE.md` is the precedent: this tuple takes files.
  1218	SCAN_ROOTS = (
  1219	    ".github",
  1220	    "RELEASE.md",
  1221	    ".claude/scripts",
  1222	    "scripts",
  1223	    "npm/INTEGRITY.md",
  1224	    "npm/README.md",
  1225	)
