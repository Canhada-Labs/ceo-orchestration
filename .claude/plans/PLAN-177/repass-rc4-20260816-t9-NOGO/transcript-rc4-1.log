  1753	# ---------------------------------------------------------------------------
  1754	# PLAN-177 W0.3 delta (codex P1-4 of the v4 round) — the generic sweep.
  1755	#
  1756	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1757	# checksum gate anchors three named phantom referents. A NEW enforcement
  1758	# promise, about some other subject, written into a section nobody watches,
  1759	# passes all of them. The original defect is the proof that this is not
  1760	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1761	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1762	#
  1763	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1764	# Contract table row (machine-checked by
  1765	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1766	# to the table's un-enforced rows by
  1767	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1768	# Anywhere else it is answerable to nothing, and is a red.
  1769	#
  1770	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1771	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1772	#
  1773	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1774	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1775	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1776	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1777	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1778	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1779	#     at the table rather than enumerating mechanisms, and the tag-signing
  1780	#     paragraph cites SECURITY.md as the authority instead of restating the
  1781	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1782	#     needs no exemption, so it has none.
  1783	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1784	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1785	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1786	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1787	#     are the file speaking about what the pipeline does.
  1788	#     A broad list that has to be switched off is worth less than a narrow
  1789	#     one that stays on.
  1790	#
  1791	# Matching is on word boundaries after normalization. Substring matching was
  1792	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1793	# substring-vs-exact class, for the fourth time in this plan.
  1794	_ENFORCEMENT_VOCAB = (
  1795	    "enforced today",
  1796	    "is enforced",
  1797	    "are enforced",
  1798	    "enforced by",
  1799	    "enforced at",
  1800	    "every tag publish",
  1801	    "recorded by",
  1802	    "is verified",
  1803	    "are verified",
  1804	    "verifies",
  1805	    "must satisfy",
  1806	    "guarantees",
  1807	    "is guaranteed",
  1808	    "are guaranteed",
  1809	    "asserted by",
  1810	    "checked by",
  1811	    "gated by",
  1812	    "fails closed",
  1813	    "fail closes",
  1814	    "asserts",
  1815	    "ensures",
  1816	    "is signed",
  1817	    "are signed",
  1818	)
  1819	
  1820	
  1821	def _normalize_prose(text: str) -> str:
  1822	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1823	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1824	    normalize the same way, so a claim cannot hide behind formatting."""
  1825	    text = text.lower()
  1826	    for ch in ("*", "`", "_"):
  1827	        text = text.replace(ch, "")
  1828	    text = text.replace("-", " ")
  1829	    return re.sub(r"\s+", " ", text)
  1830	
  1831	
  1832	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1833	    """Everything that is neither a Contract table row nor §Not yet
  1834	    automated — the surfaces where a mechanism claim answers to nothing."""
  1835	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1836	    return "\n".join(
  1837	        line for line in body.splitlines() if not line.strip().startswith("|")
  1838	    )
  1839	
  1840	
  1841	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1842	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1843	    offenders = []
  1844	    for phrase in _ENFORCEMENT_VOCAB:
  1845	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1846	            offenders.append(
  1847	                "%r outside the declared zones: ...%s..."
  1848	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1849	            )
  1850	    return offenders
  1851	
  1852	
  1853	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1854	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1855	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1856	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1857	    even standing somewhere that can be checked?" — the question the file
  1858	    failed on the day it shipped."""
  1859	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1860	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1861	
  1862	    # The sweep must be looking at the right text: intro present, table absent.
  1863	    swept = _prose_outside_the_declared_zones(doc)
  1864	    assert "Integrity contract for the" in swept, (
  1865	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1866	        "the prose it exists to watch"
  1867	    )
  1868	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1869	    assert len(swept) > len(doc) // 3, (
  1870	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1871	        % (len(swept), len(doc))
  1872	    )
  1873	
  1874	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1875	    # merits. The order matters and was learned the hard way — the controls
  1876	    # below build their fixtures FROM the live file, so when the file itself
  1877	    # carries a planted defect they fail first and the red names the fixture
  1878	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1879	    # always reds on the assertion that describes what is actually wrong.
  1880	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1881	    offenders = _enforcement_vocabulary_offenders(doc)
  1882	    assert not offenders, (
  1883	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1884	        "§Not yet automated. Move the claim into a table row (with a step the "
  1885	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1886	    )
  1887	
  1888	    # (b) positive control: the historical claim restored to the introduction.
  1889	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1890	    # today's wording — an anchor on current prose stops matching the moment
  1891	    # that prose is edited, and then the control fails for the wrong reason.
  1892	    title, _, rest = doc.partition("\n")
  1893	    claim = (
  1894	        "The integrity controls enforced today are: (1) the `install.sh` "
  1895	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1896	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1897	    )
  1898	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1899	    assert relapse != doc, "relapse fixture did not patch the doc"
  1900	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1901	    assert any("enforced today" in o for o in relapse_offenders), (
  1902	        "an enforcement claim in the introduction went unseen: %s"
  1903	        % relapse_offenders
  1904	    )
  1905	    assert any("recorded by" in o for o in relapse_offenders), (
  1906	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1907	    )
  1908	
  1909	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1910	    # offender. This is the predicate as documented, not a global grep — that
  1911	    # section is where honest prose about absence has to be able to use these
  1912	    # words. Its own honesty is held by the restatement test above; a claim
  1913	    # parked there is the residual gap, and it is a narrow, watched one.
  1914	    marker = "## Not yet automated"
  1915	    assert marker in doc
  1916	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1917	    assert not _enforcement_vocabulary_offenders(parked), (
  1918	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1919	        "a declared zone"
  1920	    )
