   364	def _sha256(path: str) -> str:
   365	    h = hashlib.sha256()
   366	    with open(path, "rb") as fh:
   367	        for chunk in iter(lambda: fh.read(65536), b""):
   368	            h.update(chunk)
   369	    return h.hexdigest()
   370	
   371	
   372	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   373	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   374	    entries: List[Tuple[str, str]] = []
   375	    with open(path, encoding="utf-8") as fh:
   376	        for line in fh:
   377	            line = line.rstrip("\n")
   378	            if not line.strip():
   379	                continue
   380	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   381	            if not m:
   382	                raise ValueError("unparsable manifest line: %r" % line)
   383	            entries.append((m.group(1), m.group(2)))
   384	    return entries
   385	
   386	
   387	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   388	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   389	    directory = os.path.dirname(manifest) or "."
   390	    name = os.path.basename(manifest)
   391	    try:
   392	        proc = subprocess.run(
   393	            ["shasum", "-a", "256", "-c", name],
   394	            cwd=directory,
   395	            stdout=subprocess.PIPE,
   396	            stderr=subprocess.STDOUT,
   397	            universal_newlines=True,
   398	        )
   399	        return proc.returncode == 0, proc.stdout.strip()
   400	    except (OSError, FileNotFoundError):
   401	        bad: List[str] = []
   402	        for want, rel in _read_manifest(manifest):
   403	            full = os.path.join(directory, rel)
   404	            if not os.path.isfile(full) or _sha256(full) != want:
   405	                bad.append(rel)
   406	        if bad:
   407	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   408	        return True, "hashlib fallback: all entries match"
   409	
