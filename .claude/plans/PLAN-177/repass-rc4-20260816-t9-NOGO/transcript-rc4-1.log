   434	            "top-level line must be\n"
   435	            "      `name:` with no whitespace before the colon (or a `- ` "
   436	            "list item only when INDENTED under a bare key, never at the "
   437	            "root). The two release rails read this\n"
   438	            "      file with different grammars, so `verdict : NO-GO` "
   439	            "followed by `verdict: GO` counts as two\n"
   440	            "      declarations server-side and one here; the shape is "
   441	            "refused instead of guessed."
   442	            % (verdict_rel, noncanonical),
   443	        )
