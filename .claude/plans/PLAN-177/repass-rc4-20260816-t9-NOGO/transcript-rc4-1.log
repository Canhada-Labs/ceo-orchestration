   197	# ---------------------------------------------------------------------------
   198	# (b) restricted delta
   199	# ---------------------------------------------------------------------------
   200	def _parse_verdict(text: str) -> Dict[str, object]:
   201	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   202	
   203	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   204	    of `  - item` list entries, and ignores everything else. Anything it cannot
   205	    read is absent, and every consumer below treats absent as fail-closed.
   206	
   207	    Parity with the step-15 reader (`.github/scripts/
   208	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   209	    scope: block selection (the regex below is the validator's own — the
   210	    first ```yaml fence, not the first fence of any language) and inline
   211	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   212	    parse_verdict_file reads key:value and sub-dicts and would drop
   213	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   214	    ONE shared reader (this file is the declared reference), never grow a
   215	    third parser of the same signed file.
   216	    """
   217	    fields: Dict[str, object] = {}
   218	    block = re.search(r"```yaml[ \t]*\n(.*?)```", text, re.DOTALL)  # t8 P1: ASCII-only, \s swallowed a leading NBSP line
   219	    if block is None:
   220	        # No yaml block -> no fields -> every consumer below fails closed.
   221	        return fields
   222	    cur_list: Optional[str] = None
   223	    for raw in block.group(1).splitlines():
   224	        line = _strip_yaml_comment(raw)
   225	        if not line.strip():
   226	            continue
   227	        if line.startswith(("  - ", "- ")) and cur_list:
   228	            item = line.split("-", 1)[1].strip()
   229	            if item:
   230	                fields[cur_list].append(item)  # type: ignore[union-attr]
   231	            continue
   232	        # [ \t]* not \s* (t5 P1): Python \s is Unicode-aware and would
   233	        # swallow a NBSP that must stay attached to the VALUE.
   234	        m = re.match(r"\A([A-Za-z0-9_]+):(?:[ \t]+(.*))?\Z", line)
   235	        if not m:
   236	            continue
   237	        key, val = m.group(1), (m.group(2) or "").strip(" \t")
   238	        if val == "":
   239	            fields[key] = []
   240	            cur_list = key
   241	        else:
   242	            fields[key] = val
   243	            cur_list = None
   244	    return fields
   245	
   246	
   247	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   248	# The two readers of this signed file disagreed about what a key IS: the
   249	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   250	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   251	# file demand the colon immediately after the name, so they skipped the line.
   252	# The valid-YAML pair
   253	#
   254	#     verdict : NO-GO
   255	#     verdict: GO
   256	#
   257	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   258	# and this is the rail that enforces in every mode, so the tag was authorised.
   259	#
   260	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   261	# fail-closed. Trimming the key in both readers would also close the
   262	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   263	# author writes and no template emits; refusing the shape is the smaller
   264	# surface and is the only behaviour that cannot silently prefer a value.
   265	# A top-level line is canonical iff it is `name:` with no whitespace before
   266	# the colon; list items are legal ONLY indented under an active bare
   267	# key (t8 P2: a root `- item` is rejected — the old comment said
   268	# otherwise and misled operators).
   269	def _strip_yaml_comment(raw):
   270	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   271	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   272	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Byte-for-
   273	    byte twin of `_strip_comment` in validate-pair-rail-verdict.py.
   274	    """
   275	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   276	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   277	    if raw.lstrip(" \t").startswith("#"):
   278	        return ""
   279	    i = 0
   280	    while True:
   281	        j = raw.find("#", i)
   282	        if j == -1:
   283	            return raw.rstrip(" \t")
   284	        if j > 0 and raw[j - 1] in (" ", "\t"):
   285	            return raw[:j].rstrip(" \t")
   286	        i = j + 1
   287	
   288	
   289	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   290	
   291	
   292	def _noncanonical_top_level_lines(text: str) -> List[str]:
   293	    """Top-level lines of the yaml block that are not canonical declarations.
   294	
   295	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   296	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   297	    separate machines; neither may import the other — keep them identical).
   298	    Empty list == the block speaks the grammar both readers assume.
   299	    """
   300	    block = re.search(r"```yaml[ \t]*\n(.*?)```", text, re.DOTALL)  # t8 P1: ASCII-only, \s swallowed a leading NBSP line
   301	    if block is None:
   302	        return []
   303	    bad: List[str] = []
   304	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   305	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   306	    # Both None (before any key) and "scalar" reject — an orphan-indented
   307	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   308	    # through the prev_scalar_decl=False initial state and resolved as GO,
   309	    # and a root-level `- item` is malformed for this signed format (its
   310	    # only lists are INDENTED under a bare key) yet was accepted outright.
   311	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   312	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   313	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   314	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   315	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   316	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   317	    # reopening the orphan-indentation class through the whitespace side.
   318	    parent = None  # None | "scalar" | "bare"
   319	    for raw in block.group(1).splitlines():
   320	        line = _strip_yaml_comment(raw)
   321	        if not line.strip(" \t"):
   322	            continue
   323	        if line[0] in (" ", "\t"):
   324	            if parent != "bare":
   325	                bad.append(line)
   326	            continue
   327	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   328	            _key, _, _val = line.partition(":")
   329	            parent = "scalar" if _val.strip(" \t") else "bare"
   330	            continue
   331	        bad.append(line)
   332	        parent = None
   333	    return bad
   334	
   335	
   336	def _count_top_level_key(text: str, key: str) -> int:
   337	    """How many times `key:` is declared at the top level of the block.
   338	
   339	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   340	    step-15 reader: a second `verdict:` silently overrides the first, so
   341	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   342	    block selection and same comment rule as the reader, or the count
   343	    would be about a different text than the parse.
   344	
   345	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   346	    counter does NOT strip the key and the step-15 twin does, so on a
   347	    non-canonical block the two counts differ. delta() checks the shape
   348	    first.
   349	    """
   350	    block = re.search(r"```yaml[ \t]*\n(.*?)```", text, re.DOTALL)  # t8 P1: ASCII-only, \s swallowed a leading NBSP line
   351	    if block is None:
   352	        return 0
   353	    seen = 0
   354	    for raw in block.group(1).splitlines():
   355	        line = _strip_yaml_comment(raw)
   356	        if not line.strip() or line[0] in (" ", "\t"):
   357	            continue
   358	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   359	        if m and m.group(1) == key:
   360	            seen += 1
   361	    return seen
   362	
   363	
   364	def _sha256(path: str) -> str:
   365	    h = hashlib.sha256()
   366	    with open(path, "rb") as fh:
   367	        for chunk in iter(lambda: fh.read(65536), b""):
   368	            h.update(chunk)
   369	    return h.hexdigest()
   370	
   371	
   372	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   373	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   374	    entries: List[Tuple[str, str]] = []
   375	    with open(path, encoding="utf-8") as fh:
   376	        for line in fh:
   377	            line = line.rstrip("\n")
   378	            if not line.strip():
   379	                continue
   380	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   381	            if not m:
   382	                raise ValueError("unparsable manifest line: %r" % line)
   383	            entries.append((m.group(1), m.group(2)))
   384	    return entries
   385	
   386	
   387	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   388	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   389	    directory = os.path.dirname(manifest) or "."
   390	    name = os.path.basename(manifest)
   391	    try:
   392	        proc = subprocess.run(
   393	            ["shasum", "-a", "256", "-c", name],
   394	            cwd=directory,
   395	            stdout=subprocess.PIPE,
   396	            stderr=subprocess.STDOUT,
   397	            universal_newlines=True,
   398	        )
   399	        return proc.returncode == 0, proc.stdout.strip()
   400	    except (OSError, FileNotFoundError):
   401	        bad: List[str] = []
   402	        for want, rel in _read_manifest(manifest):
   403	            full = os.path.join(directory, rel)
   404	            if not os.path.isfile(full) or _sha256(full) != want:
   405	                bad.append(rel)
   406	        if bad:
   407	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   408	        return True, "hashlib fallback: all entries match"
   409	
   410	
   411	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   412	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   413	    verdict_abs = os.path.join(repo, verdict_rel)
   414	    if not os.path.isfile(verdict_abs):
   415	        return _fail(
   416	            E_VERDICT,
   417	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   418	            "be committed before the tag is cut (release.yml validates it per "
   419	            "tag on the tagged tree)." % verdict_rel,
   420	        )
   421	    with open(verdict_abs, encoding="utf-8") as fh:
   422	        verdict_text = fh.read()
   423	    # PLAN-177 t2 (P1-a): SHAPE BEFORE ANY FIELD. Both rails read this file;
   424	    # they only agree on a canonical block. A non-canonical top-level line is
   425	    # refused here rather than handed to two different grammars — E_DECISION
   426	    # because the class this closes is the decision override (`verdict :
   427	    # NO-GO` + `verdict: GO`), and because a refusal that names the decision
   428	    # rail is the one an operator can act on.
   429	    noncanonical = _noncanonical_top_level_lines(verdict_text)
   430	    if noncanonical:
   431	        return _fail(
   432	            E_DECISION,
   433	            "verdict %s: non-canonical top-level key syntax %r -- a "
   434	            "top-level line must be\n"
   435	            "      `name:` with no whitespace before the colon (or a `- ` "
   436	            "list item only when INDENTED under a bare key, never at the "
   437	            "root). The two release rails read this\n"
   438	            "      file with different grammars, so `verdict : NO-GO` "
   439	            "followed by `verdict: GO` counts as two\n"
   440	            "      declarations server-side and one here; the shape is "
   441	            "refused instead of guessed."
   442	            % (verdict_rel, noncanonical),
   443	        )
   444	    fields = _parse_verdict(verdict_text)
   445	
   446	    release_tag = fields.get("release_tag")
   447	    if release_tag != tag:
   448	        return _fail(
   449	            E_VERDICT,
   450	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   451	            "to judge this tag against another tag's verdict."
   452	            % (verdict_rel, release_tag, tag),
   453	        )
   454	    # PLAN-177 W0.1 (P1-4) -- the DECISION gate.
   455	    #
   456	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on): the
   457	    # server-side twin (.github/scripts/validate-pair-rail-verdict.py, step
   458	    # 15) carries `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   459	    # (release.yml:689) -- there the decision check is defence in depth.
   460	    # THIS is the rail that enforces in every mode: release.sh calls it with
   461	    # `|| die`, and the release.yml step that calls it carries no escape
   462	    # hatch. Neither may be dropped for the other.
   463	    #
   464	    # Fail-CLOSED on SHAPE as well as value (CF-1): _parse_verdict returns a
   465	    # LIST for an empty `verdict:` line, so the type check precedes the
   466	    # compare -- a malformed decision is a named refusal, never a crash.
   467	    declared_decisions = _count_top_level_key(verdict_text, "verdict")
   468	    if declared_decisions > 1:
   469	        return _fail(
   470	            E_DECISION,
   471	            "verdict %s declares the decision %d times -- this reader "
   472	            "is last-wins, so a duplicated\n"
   473	            "      `verdict:` silently overrides the first; exactly one "
   474	            "is required."
   475	            % (verdict_rel, declared_decisions),
   476	        )
   477	    decision = fields.get("verdict")
   478	    if decision is None:
   479	        shown = "<absent>"
   480	    elif not isinstance(decision, str):
   481	        shown = "<non-string:%s>" % type(decision).__name__
   482	    else:
   483	        # ASCII-only trim (t5 P1) — twin of the server validator.
   484	        shown = decision.strip(" \t")
   485	    if shown not in ACCEPTED_DECISIONS:
   486	        return _fail(
   487	            E_DECISION,
   488	            "verdict %s: decision '%s' not in {%s} -- a tag may only be "
   489	            "cut on an authorizing decision.\n"
   490	            "      Everything the checks below assert (anchor, closed "
   491	            "allowlist, manifest content) is about WHICH TREE the\n"
   492	            "      re-pass saw; this one is about what the re-pass SAID "
   493	            "about it. A NO-GO over a perfect delta is still a NO-GO."
   494	            % (verdict_rel, shown, ", ".join(ACCEPTED_DECISIONS)),
   495	        )
   496	    parent = fields.get("parent_sha")
   497	    if not isinstance(parent, str) or not HEX40.match(parent):
   498	        return _fail(
   499	            E_VERDICT,
   500	            "verdict %s has no usable 40-hex `parent_sha:` — that field IS "
   501	            "the review anchor." % verdict_rel,
   502	        )
   503	    rc, _out, _err = _git(repo, "cat-file", "-e", parent + "^{commit}")
   504	    if rc != 0:
   505	        return _fail(
   506	            E_VERDICT,
   507	            "parent_sha %s from %s is not a commit in this repo."
   508	            % (parent, verdict_rel),
   509	        )
   510	    # Existence is not lineage. A fabricated anchor (`git commit-tree` over
   511	    # HEAD's own tree, parented anywhere, on no branch) passes `cat-file -e`
   512	    # and makes diff(parent..HEAD) contain ONLY the verdict + evidence while
   513	    # unreviewed work sits on main — every check below then passes and the
   514	    # guard prints approval over a tree the re-pass never saw. The anchor has
   515	    # to be a commit HEAD actually descends from. (The staged W1 server-side
   516	    # port asserts the same against origin/main — keep the two in sync.)
   517	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", parent, "HEAD")
   518	    if rc == 1:
   519	        return _fail(
   520	            E_PARENT_NOT_ANCESTOR,
   521	            "parent_sha %s from %s is not an ancestor of HEAD — the review "
   522	            "anchor is not in\n"
