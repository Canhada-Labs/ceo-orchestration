  1393	def test_npm_docs_carry_no_bare_version_literal(tmp_path):
  1394	    """P1-2. `npm/INTEGRITY.md` declared its own version and drifted three
  1395	    minors behind `VERSION` while `bump --stable` correctly reported a no-op:
  1396	    the file is not a bump site and — until this commit — not a scanned
  1397	    surface either. The cure is version-NEUTRAL prose, not a new writer row
  1398	    (a writer with no oracle is the dead rule `_release_bump_sites.py`
  1399	    already refuses to reintroduce)."""
  1400	    assert NPM_DOC_SURFACES, "no npm doc is scanned — the P1-2 surface is unwatched"
  1401	
  1402	    # Positive control FIRST, in a throwaway tree, and planted in the SAME
  1403	    # relative paths the real scan uses: this proves the SURFACE is covered,
  1404	    # not merely that the regex can match a version somewhere. The stamped
  1405	    # file rides along because an over-firing control gets exempted away
  1406	    # within a release.
  1407	    for rel in NPM_DOC_SURFACES:
  1408	        target = tmp_path / rel
  1409	        target.parent.mkdir(parents=True, exist_ok=True)
  1410	        target.write_text(
  1411	            "> built and versioned (`VERSION` / `package.json`, "
  1412	            "currently 1.0.1).\n"
  1413	            "<!-- last-reviewed: 2026-08-05 v1.3.0 -->\n"
  1414	            # t7 P2 relapse control: a stale literal SHARING the line with
  1415	            # a valid stamp must still be flagged (the old scanner skipped
  1416	            # the whole line on any stamp hit).
  1417	            "currently 9.9.9 <!-- last-reviewed: 2026-08-05 v1.3.0 -->\n",
  1418	            encoding="utf-8",
  1419	        )
  1420	    planted = _bare_version_offenders_in_npm_docs(tmp_path)
  1420	    planted = _bare_version_offenders_in_npm_docs(tmp_path)
  1421	    assert len(planted) == 2 * len(NPM_DOC_SURFACES), (
  1422	        "positive control did not flag every scanned npm doc exactly twice "
  1423	        "(bare literal + same-line-as-stamp literal; stamp itself exempt): "
  1424	        "%s" % planted
  1425	    )
  1426	    for rel in NPM_DOC_SURFACES:
  1427	        assert any(o.startswith(rel + ":") for o in planted), (
  1428	            "%s is in SCAN_ROOTS but the planted literal there was not "
  1429	            "reported: %s" % (rel, planted)
  1430	        )
  1431	
  1432	    offenders = _bare_version_offenders_in_npm_docs(REPO_ROOT)
  1433	    assert not offenders, (
  1434	        "bare version literal in an npm doc (VERSION is the only authority; "
  1435	        "make the prose version-neutral):\n%s" % "\n".join(offenders)
  1436	    )
