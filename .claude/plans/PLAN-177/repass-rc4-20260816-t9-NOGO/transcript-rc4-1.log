  2571	def test_both_rails_answer_identically_on_every_key_shape():
  2572	    """The instrument that would have caught P1-a: ONE question, two readers.
  2573	
  2574	    A divergence is only visible when the same bytes are put to both. For any
  2575	    block both accept, they must also agree on how many decisions it declares
  2576	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2577	    things on the two machines that gate a release.
  2578	    """
  2579	    def block(body: str) -> str:
  2580	        return "# fixture\n\n```yaml\n%s```\n" % body
  2581	
  2582	    canonical_shapes = [
  2583	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2584	        "verdict: NO-GO\nverdict: GO\n",
  2585	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2586	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2587	        "verdict: GO  # inline comment\n",
  2588	        "verdict: GO#NO-GO\nrelease_tag: v1.2.3\n",
  2589	        "# verdict: NO-GO\nverdict: GO\n",
  2590	    ]
  2591	    noncanonical_shapes = [
  2592	        "verdict:GO\n",
  2593	        "verdict: GO\n  NO-GO\nrelease_tag: v1.2.3\n",
  2594	        "verdict : NO-GO\nverdict: GO\n",
  2595	        "verdict\t: NO-GO\nverdict: GO\n",
  2596	        "verdict : GO\n",
  2597	        '"verdict": GO\n',
  2598	        "verdict :GO\n",
  2599	        # Re-pass rc.4 t7 P1: an ORPHAN-indented first line (no active bare
  2600	        # parent) previously slipped the prev_scalar_decl=False initial
  2601	        # state — `  verdict: NO-GO` + `verdict: GO` resolved as GO.
  2602	        "  verdict: NO-GO\nverdict: GO\n",
  2603	        # Same class after a scalar has RESET the state to non-bare.
  2604	        "release_tag: v1.2.3\n  verdict: NO-GO\nverdict: GO\n",
  2605	        # Root-level list item: this signed format's only lists are
  2606	        # INDENTED under a bare key; a root `- item` is malformed and was
  2607	        # accepted outright.
  2608	        "- verdict: NO-GO\nverdict: GO\n",
  2609	        "verdict: GO\n- trailing root list item\n",
  2610	        # Re-pass rc.4 t8 P1: Unicode-aware strip() in the SHAPE classifier
  2611	        # treated a U+00A0 VALUE as a bare parent (legitimizing an
  2612	        # orphan-indented line under it) and a lone-U+00A0 line as blank.
  2613	        "padding: \u00a0\n  verdict: NO-GO\nverdict: GO\n",
  2614	        "\u00a0\nverdict: GO\n",
  2615	    ]
  2616	    for body in canonical_shapes:
  2617	        text = block(body)
  2618	        assert validator.noncanonical_top_level_lines(text) == [], body
  2619	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2620	        assert validator.count_top_level_key(
  2621	            text, "verdict"
  2622	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2623	            "the two rails disagree on how many decisions %r declares" % body
  2624	        )
  2625	        assert validator.parse_verdict_text(text).get(
  2626	            "verdict"
  2627	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2628	            "the two rails disagree on WHICH decision wins in %r" % body
  2629	        )
  2630	    for body in noncanonical_shapes:
  2631	        text = block(body)
  2632	        assert validator.noncanonical_top_level_lines(text) != [], body
  2633	        assert (
  2634	            tag_guard._noncanonical_top_level_lines(text)
  2635	            == validator.noncanonical_top_level_lines(text)
  2636	        ), "the two shape gates disagree about %r" % body
