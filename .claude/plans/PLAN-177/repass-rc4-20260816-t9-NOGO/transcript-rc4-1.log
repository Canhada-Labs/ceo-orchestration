  1923	# --------------------------------------------------------------------------
  1924	# Supply-chain honesty: the two claims that survive being corrected in one file
  1925	#
  1926	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  1927	# was green while `npm/README.md` — the README an npm consumer actually
  1928	# RECEIVES, it is in package.json `files` — still promised "SLSA 3 provenance",
  1929	# and while README.pt-BR, INSTALL.md and both QUICKSTARTs repeated Level 3 and
  1930	# a checksum coverage the release does not have (repass-rc4 part 2, P1 §2).
  1931	# A single-file gate cannot see that class, so the surface list below is
  1932	# EXPLICIT, and `_live_doc_surfaces()` re-derives the population from the repo
  1933	# so a NEW document carrying either claim also lands in front of the gate.
  1934	#
  1935	# `.claude/**` is deliberately outside the population: plans, debates and
  1936	# archived verdicts are historical records, and they have to be able to quote a
  1937	# false claim verbatim without turning this gate red.
  1938	# --------------------------------------------------------------------------
  1939	
  1940	SUPPLY_CHAIN_HONESTY_SURFACES = (
  1941	    "README.md",
  1942	    "README.pt-BR.md",
  1943	    "npm/README.md",
  1944	    "npm/INTEGRITY.md",
  1945	    "INSTALL.md",
  1946	    "SECURITY.md",
  1947	    "SUPPORT.md",
  1948	    "SBOM.md",
  1949	    "docs/QUICKSTART.md",
  1950	    "docs/QUICKSTART.pt-BR.md",
  1951	    "docs/CTO-GUIDE.md",
  1952	    "docs/threat-model.md",
  1953	)
  1954	
  1955	# "SLSA 3", "SLSA-3", "SLSA Level 3", "SLSA L3", "SLSA provenance L3" and
  1956	# "provenance (SLSA L3)" all normalise to the same false claim. The earlier
  1957	# pattern only caught the first three, which is why `SBOM.md` ("SLSA L3") and
  1958	# `docs/QUICKSTART.md` ("SLSA provenance L3") were invisible to it.
  1959	_SLSA_LEVEL3_CLAIM = re.compile(
  1960	    r"SLSA[\s\-]*(?:provenance[\s\-]*)?(?:Level[\s\-]*|L)?3\b"
  1961	    r"|(?:provenance|attestation)[\s\-]*(?:Level[\s\-]*|L)3\b",
  1962	    re.IGNORECASE,
  1963	)
  1964	
  1965	# Plural = aggregate. Release checksum coverage is `install.sh` alone
  1966	# (SECURITY.md §How to verify what you install); "ships SHA-256 checksums"
  1967	# promises a SHA256SUMS that no workflow produces.
  1968	_CHECKSUM_AGGREGATE_CLAIM = re.compile(
  1969	    r"SHA-?256\s+checksums|checksums\s+SHA-?256", re.IGNORECASE
  1970	)
  1971	
  1972	
  1973	def _live_doc_surfaces() -> List[Path]:
  1974	    """Root-level, `docs/` and `npm/` markdown — every document a reader or an
  1975	    npm consumer meets. Deliberately NOT `.claude/**` (see the block comment)."""
  1976	    found = sorted(REPO_ROOT.glob("*.md"))
  1977	    for sub in ("docs", "npm"):
  1978	        base = REPO_ROOT / sub
  1979	        if base.exists():
  1980	            found += sorted(base.rglob("*.md"))
  1981	    return found
  1982	
  1983	
  1984	def test_slsa_and_checksum_claims_are_true_on_every_shipped_surface():
  1985	    """The npm consumer reads `npm/README.md`; the Portuguese reader reads
  1986	    `README.pt-BR.md`. Correcting the root README alone left both promising a
  1987	    Level the pipeline never reaches. The gate now runs over an explicit list
  1988	    AND over every live doc, so neither a missed translation nor a new file can
  1989	    carry the claim silently."""
  1990	    surfaces = {p.relative_to(REPO_ROOT).as_posix(): p for p in _live_doc_surfaces()}
  1991	
  1992	    # (a) The explicit list is not allowed to name a file that stopped
  1993	    # existing: a surface silently dropped from the repo is a gate that
  1994	    # quietly narrows.
  1995	    missing = [s for s in SUPPLY_CHAIN_HONESTY_SURFACES if s not in surfaces]
  1996	    assert not missing, "declared honesty surfaces that no longer exist: %s" % missing
  1997	
  1998	    offenders: List[str] = []
  1999	    for rel, path in surfaces.items():
  2000	        text = path.read_text(encoding="utf-8")
  2001	        for m in _SLSA_LEVEL3_CLAIM.finditer(text):
  2002	            # Tolerance is scoped to what FOLLOWS the mention, never to the
  2003	            # line: the honest sentence names Level 2 and disclaims Level 3 in
  2004	            # one breath, so a line-wide exemption would let the false claim
  2005	            # ride along beside its own disclaimer. The window is 120 chars
  2006	            # because the live disclaimer parenthesises its reason
  2007	            # ("(hermetic build + two-party review) is out of scope") — at the
  2008	            # old width of 40 the only honest Level-3 sentence in the repo
  2009	            # would have been the gate's first false positive.
  2010	            tail = text[m.end():m.end() + 120]
  2011	            if "out of scope" in tail or "fora de escopo" in tail:
  2012	                continue
  2013	            offenders.append(
  2014	                "%s: ...%s..."
  2015	                % (rel, text[max(0, m.start() - 60):m.end() + 40].strip().replace("\n", " "))
  2016	            )
  2017	        for m in _CHECKSUM_AGGREGATE_CLAIM.finditer(text):
  2018	            offenders.append(
  2019	                "%s: ...%s..."
  2020	                % (rel, text[max(0, m.start() - 70):m.end() + 30].strip().replace("\n", " "))
  2021	            )
  2022	
  2023	    assert not offenders, (
  2024	        "shipped docs claim SLSA Level 3 and/or aggregate release checksums; "
  2025	        "the pipeline reaches Level 2 (`npm publish --provenance`) and the "
  2026	        "release checksum covers `install.sh` only:\n%s" % "\n".join(offenders)
  2027	    )
  2028	
  2029	    # (b) Positive statement, on the two most-read surfaces: silence about the
  2030	    # level is not honesty either. The npm README is named explicitly because
  2031	    # it is the one that travels inside the tarball.
  2032	    for rel in ("README.md", "npm/README.md"):
  2033	        text = surfaces[rel].read_text(encoding="utf-8")
  2034	        assert "SLSA **Level 2**" in text or "SLSA Level 2" in text, (
  2035	            "%s no longer states the level the pipeline reaches" % rel
  2036	        )
  2037	
  2038	
  2039	# --------------------------------------------------------------------------
  2040	# The npm signature recipe has to audit the thing the reader just installed
  2041	#
  2042	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2043	# no package-selecting positional (a trailing package name is ignored), and it
  2044	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2045	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2046	# with `npm audit signatures` verified nothing the reader had just installed —
  2047	# it audited whatever directory they happened to be standing in, and could
  2048	# return a confident green having examined a different tree entirely.
  2049	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2050	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2051	# project install followed by a BARE `npm audit signatures`.
  2052	# --------------------------------------------------------------------------
  2053	
  2054	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2055	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2056	# (ephemeral — nothing is left in a dependency tree to audit).
  2057	_UNAUDITABLE_INSTALL = re.compile(
  2058	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2059	)
  2060	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2061	# the reader believes it selected a package. `#` is excluded so the honest
  2062	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2063	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2064	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2065	_AUDIT_GLOBAL_FLAG = re.compile(
  2066	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2067	)
  2068	
  2069	
  2070	def _recipe_units(text: str) -> List[tuple]:
  2071	    """(label, body) for each fenced code block, and for each line outside one.
  2072	
  2073	    A recipe is what a reader copies, and they copy a whole code block — so the
  2074	    block, not the line, is the unit in which "install here, audit there" has
  2075	    to be judged. Prose lines are units of their own so a one-line table row
  2076	    (the shape `SUPPORT.md` used) is still examined."""
  2077	    units: List[tuple] = []
  2078	    block: Optional[List] = None
  2079	    for num, line in enumerate(text.splitlines(), 1):
  2080	        if line.strip().startswith("```"):
  2081	            if block is None:
  2082	                block = [num, []]
  2083	            else:
  2084	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2085	                block = None
  2086	            continue
  2087	        if block is not None:
  2088	            block[1].append(line)
  2089	        else:
  2090	            units.append(("line@%d" % num, line))
  2091	    if block is not None:  # unterminated fence: judge what we collected
  2092	        units.append(("block@%d" % block[0], "\n".join(block[1])))
  2093	    return units
  2094	
  2095	
  2096	def test_documented_npm_signature_recipe_matches_what_npm_audits():
  2097	    """Every documented `npm audit signatures` has to be reachable by npm.
  2098	
  2099	    A recipe offends when its unit pairs the command with an install npm cannot
  2100	    audit, passes a positional npm ignores, or passes `--global`, which npm
  2101	    rejects. Naming `EAUDITGLOBAL` in the unit is the tolerance: a document is
  2102	    free — and encouraged — to put the global install next to the command in
  2103	    order to say that the command does NOT reach it."""
  2104	    offenders: List[str] = []
  2105	    units_examined = 0
  2106	    for path in _live_doc_surfaces():
  2107	        rel = path.relative_to(REPO_ROOT).as_posix()
  2108	        text = path.read_text(encoding="utf-8")
  2109	        if not _AUDIT_SIGNATURES.search(text):
  2110	            continue
  2111	        for label, unit in _recipe_units(text):
  2112	            if not _AUDIT_SIGNATURES.search(unit):
  2113	                continue
  2114	            units_examined += 1
  2115	            faults = []
  2116	            if _UNAUDITABLE_INSTALL.search(unit) and "EAUDITGLOBAL" not in unit:
  2117	                faults.append(
  2118	                    "pairs the audit with an install npm cannot audit "
  2119	                    "(global, or exec/npx leaving no dependency behind)"
  2120	                )
  2121	            positional = _AUDIT_POSITIONAL.search(unit)
  2122	            if positional:
  2123	                faults.append(
  2124	                    "passes the positional %r, which npm ignores — the audit "
  2125	                    "still reads the current project" % positional.group(1)
  2126	                )
  2127	            if _AUDIT_GLOBAL_FLAG.search(unit):
