    54	#   2 usage   3 fetch failed   4 not-ancestor   5 remote ref unusable
    55	#   6 delta outside allowlist  7 manifest sha pin mismatch
    56	#   8 manifest content mismatch (shasum -c)  9 manifest/allowlist set mismatch
    57	#  10 verdict unusable (missing file/field, wildcard, wrong tag, bad parent)
    58	#  11 the assert would be VACUOUS (the verdict is not inside the delta it
    59	#     anchors — e.g. parent_sha == HEAD, which makes the verdict review itself)
    60	#  12 parent_sha is not an ancestor of HEAD (a fabricated/orphan anchor:
    61	#     `cat-file -e` proves existence, not lineage — a `commit-tree` object
    62	#     carrying HEAD's own tree makes diff(parent..HEAD) contain only the
    63	#     verdict while unreviewed work sits on main)
    64	#  13 the verdict DECISION does not authorize a release (NO-GO, absent,
    65	#     empty, or an unknown token), OR the block spells a top-level key in a
    66	#     form this reader and the step-15 validator resolve differently.
    67	#     PLAN-177 W0.1 / P1-4: this guard read the tag, the anchor, the
    68	#     allowlist and the manifest of a verdict but never its DECISION, so a
    69	#     cross-model NO-GO still cut a tag. PLAN-177 t2 / P1-a: it then read
    70	#     the DECISION with a grammar the other rail did not share, so
    71	#     `verdict : NO-GO` + `verdict: GO` cut a tag on a NO-GO.
    72	# ============================================================================
    73	"""Ancestry + restricted-delta asserts for the release tag phase."""
    74	
    75	from __future__ import annotations
    76	
    77	import argparse
    78	import hashlib
    79	import os
    80	import re
    81	import subprocess
    82	import sys
    83	from typing import Dict, List, Optional, Sequence, Set, Tuple
    84	
    85	E_USAGE = 2
    86	E_FETCH = 3
    87	E_NOT_ANCESTOR = 4
    88	E_REMOTE_REF = 5
    89	E_DELTA = 6
    90	E_MANIFEST_PIN = 7
    91	E_MANIFEST_CONTENT = 8
    92	E_MANIFEST_SET = 9
    93	E_VERDICT = 10
    94	E_VACUOUS = 11
    95	E_PARENT_NOT_ANCESTOR = 12
    96	E_DECISION = 13
    97	
    98	# PLAN-177 W0.1 (P1-4). Spelled out here rather than imported from
    99	# .github/scripts/validate-pair-rail-verdict.py: the two rails are separate
   100	# processes on separate machines and neither may become a dependency of the
   101	# other. The set itself comes from
   102	# .claude/governance/pair-rail-verdict-template.md. EXACT equality, no case
   103	# folding and no prefix/substring rule -- NO-GO contains GO.
   104	ACCEPTED_DECISIONS = ("GO", "GO-WITH-CONDITIONS")
   105	
   106	HEX40 = re.compile(r"\A[0-9a-f]{40}\Z")
   107	HEX64 = re.compile(r"\A[0-9a-f]{64}\Z")
   108	GLOB_CHARS = "*?["
   109	VERDICT_PREFIX = ".claude/governance/pair-rail-verdict-"
   110	# The allowlist is EXHAUSTIVE, not merely closed: the verdict for this tag plus
   111	# plan-side evidence (the `verdict-fields-<TAG>` pair and the re-pass artifact
   112	# directory both live under `.claude/plans/`). Anything else — a version site, a
   113	# workflow, any code path — would re-open the very hole the delta assert exists
   114	# to close: a post-review bump commit riding in on the tag.
   115	EVIDENCE_PREFIX = ".claude/plans/"
   116	
   117	
   118	def _fail(code: int, msg: str) -> int:
   119	    # Flush the ok-lines first: an operator reading a release failure must see
   120	    # WHICH checks passed before the one that stopped it, in order.
   121	    sys.stdout.flush()
   122	    print("FAIL: %s" % msg, file=sys.stderr)
   123	    sys.stderr.flush()
   124	    return code
   125	
   126	
   127	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   128	    proc = subprocess.run(
   129	        ["git"] + list(args),
   130	        cwd=repo,
   131	        stdout=subprocess.PIPE,
   132	        stderr=subprocess.PIPE,
   133	        universal_newlines=True,
   134	    )
   135	    return proc.returncode, proc.stdout, proc.stderr
   136	
   137	
   138	# ---------------------------------------------------------------------------
   139	# (a) ancestry
   140	# ---------------------------------------------------------------------------
   141	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   142	    ref = "%s/%s" % (remote, branch)
   143	    if offline_ack:
   144	        print(
   145	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   146	            "merge-base below is judged against a possibly STALE %s" % ref
   147	        )
   148	    else:
   149	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   150	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   151	        # stale ref reads as approval.
   152	        if rc != 0:
   153	            return _fail(
   154	                E_FETCH,
   155	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   156	                "      This is NOT a verdict on the commit — the check did not "
   157	                "run.\n"
   158	                "      Fix the network/remote and re-run, or, if you are "
   159	                "deliberately\n"
   160	                "      offline and accept judging against the last-known ref, "
   161	                "re-run\n"
   162	                "      with --offline-ack (it is recorded in the output).\n"
   163	                "      git said: %s" % (remote, branch, rc, err.strip()),
   164	            )
   165	        print("  ok   fetched %s" % ref)
   166	
   167	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   168	    if rc != 0 or not out.strip():
   169	        return _fail(
   170	            E_REMOTE_REF,
   171	            "no usable ref %s in this repo — cannot judge ancestry "
   172	            "(git said: %s)" % (ref, err.strip()),
   173	        )
   174	    remote_sha = out.strip()
   175	
   176	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   177	    if rc == 0:
   178	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   179	        return 0
   180	    if rc == 1:
   181	        return _fail(
   182	            E_NOT_ANCESTOR,
   183	            "HEAD is not an ancestor of %s — push main and re-run the "
   184	            "preflight.\n"
   185	            "      A tag on an unpushed commit points at a tree CI never "
   186	            "saw; the\n"
   187	            "      preflight's green verdict was about a different SHA."
   188	            % ref,
   189	        )
   190	    return _fail(
   191	        E_REMOTE_REF,
   192	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   193	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   194	    )
   195	
