   676	      #
   677	      # continue-on-error: ONLY when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 env
   678	      # explicitly set (e.g. legacy rc tags pre-verdict-rollout). Default is
   679	      # hard-block on any validator failure.
   680	      - name: Validate pair-rail verdict (PLAN-081 Phase 6-bis step 15)
   681	        env:
   682	          # Codex iter-8 P1 fix: source the env var from a repository
   683	          # variable so the `continue-on-error` expression has something
   684	          # to evaluate against. Owner sets via `gh variable set
   685	          # CEO_PAIR_RAIL_VERDICT_OPTIONAL --body 1` for transition mode
