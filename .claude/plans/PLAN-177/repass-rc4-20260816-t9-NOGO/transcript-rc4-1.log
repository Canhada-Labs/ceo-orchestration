   266	    for line in manifest_path.read_text().splitlines():
   267	        line = line.split("#", 1)[0].strip()
   268	        if line:
   269	            paths.append(line)
   270	    paths.sort()
   271	    hashes = {}
   272	    for p in paths:
   273	        result = subprocess.run(
   274	            ["git", "hash-object", p],
   275	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   276	        )
   277	        if result.returncode != 0:
   278	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   279	        hashes[p] = result.stdout.strip()
   280	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   335	            "Mutually exclusive with --parent-sha; if both passed, "
   336	            "--parent-sha wins."
