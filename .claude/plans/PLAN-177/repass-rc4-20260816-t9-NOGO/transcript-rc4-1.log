   154	def noncanonical_top_level_lines(text: str) -> List[str]:
   155	    """Top-level lines of the yaml block that are not canonical declarations.
   156	
   157	    Byte-for-byte twin of `_noncanonical_top_level_lines` in
   158	    `.claude/scripts/local/_release_tag_guard.py` (separate processes on
   159	    separate machines; neither may import the other — keep them identical).
   160	    Empty list == the block speaks the grammar both readers assume.
   161	    """
   162	    m = _YAML_BLOCK_RE.search(text)
   163	    if not m:
   164	        return []
   165	    bad: List[str] = []
   166	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   167	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   168	    # Both None (before any key) and "scalar" reject — an orphan-indented
   169	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   170	    # through the prev_scalar_decl=False initial state and resolved as GO,
   171	    # and a root-level `- item` is malformed for this signed format (its
   172	    # only lists are INDENTED under a bare key) yet was accepted outright.
   173	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   174	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   175	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   176	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   177	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   178	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   179	    # reopening the orphan-indentation class through the whitespace side.
   180	    parent = None  # None | "scalar" | "bare"
   181	    for raw in m.group(1).splitlines():
   182	        line = _strip_comment(raw)
   183	        if not line.strip(" \t"):
   184	            continue
   185	        if line[0] in (" ", "\t"):
   186	            if parent != "bare":
   187	                bad.append(line)
   188	            continue
   189	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   190	            _key, _, _val = line.partition(":")
   191	            parent = "scalar" if _val.strip(" \t") else "bare"
   192	            continue
   193	        bad.append(line)
   194	        parent = None
   195	    return bad
