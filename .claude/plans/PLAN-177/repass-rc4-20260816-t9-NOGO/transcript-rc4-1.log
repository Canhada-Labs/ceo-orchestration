  2195	# ===========================================================================
  2196	# PLAN-177 W0.1 (P1-4) -- the pair-rail DECISION gate
  2197	# ===========================================================================
  2198	# The re-pass of 2026-08-12 found that BOTH release rails read the verdict
  2199	# envelope for pinning, TTL, anchor and delta, and NEITHER read the decision:
  2200	# a cross-model NO-GO returned "OK: verdict ... valid" / exit 0 from the
  2201	# server-side validator, release-gate went green, and only the Owner running
  2202	# OWNER-GA-CUT.sh stood between a negative review and an irreversible publish.
  2203	#
  2204	# CF-3 asymmetry, restated here because it decides what each control PROVES:
  2205	# step 15 carries continue-on-error under CEO_PAIR_RAIL_VERDICT_OPTIONAL=1, so
  2206	# the validator control is a UNIT control over defence in depth; the control
  2207	# that stands for enforcement in every mode is the tag-guard one below.
  2208	_VALIDATOR_INPUTS_HASH_CACHE = {}
  2209	
  2210	# Anchors on the DIAGNOSTIC, not just the exit code: a gate that fires for the
  2211	# wrong reason is a dead probe wearing a green badge (S-lesson: a control that
  2212	# cannot fail proves nothing).
  2213	_ACCEPTED_SET_TEXT = "{GO, GO-WITH-CONDITIONS}"
  2214	_DECISION_REFUSED = "not in " + _ACCEPTED_SET_TEXT
  2215	_CI_DUPLICATE_DIAGNOSTIC = "verdict decision declared more than once"
  2216	_GUARD_DUPLICATE_DIAGNOSTIC = "declares the decision"
  2217	
  2218	# Value-shaped refusals. `GO | NO-GO | GO-WITH-CONDITIONS` is the LITERAL of
  2219	# pair-rail-verdict-template.md:13 -- an envelope copied from the template
  2220	# without filling the field in.
  2221	_REFUSED_DECISIONS = [
  2222	    ["NO-GO"],
  2223	    [],
  2224	    ["MAYBE"],
  2225	    [""],
  2226	    ["go"],
  2227	    ["no-go"],
  2228	    ["GO WITH CONDITIONS"],
  2229	    ["GO | NO-GO | GO-WITH-CONDITIONS"],
  2230	    # Re-pass rc.4 t3 P1: `#` WITHOUT preceding whitespace is NOT a YAML
  2231	    # comment — these are single unknown values, not GO + comment.
  2232	    ["GO#NO-GO"],
  2233	    ["GO-WITH-CONDITIONS#NO-GO"],
  2234	    # Re-pass rc.4 t5 P1: Unicode whitespace must stay attached to the
  2235	    # VALUE — `GO<U+00A0>` is not the exact authorizing token.
  2236	    ["GO\u00a0"],
  2237	    ["\u00a0GO"],
  2238	    ["GO-WITH-CONDITIONS\u00a0"],
  2239	]
  2240	_REFUSED_IDS = [
  2241	    "no-go", "absent", "unknown", "empty", "lowercase", "lower-no-go",
  2242	    "spaced", "template-literal",
  2243	    "hash-glued-no-go", "hash-glued-gwc",
