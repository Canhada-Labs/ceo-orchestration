   411	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   412	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   413	    verdict_abs = os.path.join(repo, verdict_rel)
   414	    if not os.path.isfile(verdict_abs):
   415	        return _fail(
   416	            E_VERDICT,
   417	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   418	            "be committed before the tag is cut (release.yml validates it per "
   419	            "tag on the tagged tree)." % verdict_rel,
   420	        )
   421	    with open(verdict_abs, encoding="utf-8") as fh:
   422	        verdict_text = fh.read()
