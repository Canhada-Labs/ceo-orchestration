   292	def _noncanonical_top_level_lines(text: str) -> List[str]:
   293	    """Top-level lines of the yaml block that are not canonical declarations.
   294	
   295	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   296	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   297	    separate machines; neither may import the other — keep them identical).
   298	    Empty list == the block speaks the grammar both readers assume.
   299	    """
   300	    block = re.search(r"```yaml[ \t]*\n(.*?)```", text, re.DOTALL)  # t8 P1: ASCII-only, \s swallowed a leading NBSP line
   301	    if block is None:
   302	        return []
   303	    bad: List[str] = []
   304	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   305	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   306	    # Both None (before any key) and "scalar" reject — an orphan-indented
   307	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   308	    # through the prev_scalar_decl=False initial state and resolved as GO,
   309	    # and a root-level `- item` is malformed for this signed format (its
   310	    # only lists are INDENTED under a bare key) yet was accepted outright.
   311	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   312	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   313	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   314	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   315	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   316	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   317	    # reopening the orphan-indentation class through the whitespace side.
   318	    parent = None  # None | "scalar" | "bare"
   319	    for raw in block.group(1).splitlines():
   320	        line = _strip_yaml_comment(raw)
   321	        if not line.strip(" \t"):
   322	            continue
   323	        if line[0] in (" ", "\t"):
   324	            if parent != "bare":
   325	                bad.append(line)
   326	            continue
   327	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   328	            _key, _, _val = line.partition(":")
   329	            parent = "scalar" if _val.strip(" \t") else "bare"
   330	            continue
   331	        bad.append(line)
   332	        parent = None
   333	    return bad
