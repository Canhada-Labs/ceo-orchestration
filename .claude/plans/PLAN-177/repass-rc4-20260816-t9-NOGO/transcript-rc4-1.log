     1	#!/usr/bin/env python3
     2	"""validate-pair-rail-verdict.py — PLAN-081 Phase 6 release.yml step 15.
     3	
     4	Validates a Pair-Rail verdict artifact (`.claude/governance/
     5	pair-rail-verdict-<release-tag>.md`) per R1 S-Sec-3 replay defense +
     6	R1 S-Sec-4 inputs_hash determinism + R1 C5 Codex CLI pin enforcement
     7	+ R1 S-QA-Unseen-2 distinct VERDICT_EXPIRED exit code.
     8	
     9	## Usage
    10	
    11	    python3 .github/scripts/validate-pair-rail-verdict.py \\
    12	      --verdict-file .claude/governance/pair-rail-verdict-${GITHUB_REF_NAME}.md \\
    13	      --parent-sha ${PARENT_SHA} \\
    14	      --release-tag ${GITHUB_REF_NAME} \\
    15	      --max-age-hours 24 \\
    16	      --recompute-inputs-hash \\
    17	      --codex-cli-pin-file .claude/governance/codex-cli-pin.txt \\
    18	      --codex-pin-manifest-file .claude/governance/codex-cli-pin-manifest.json \\
    19	      --inputs-hash-paths-file .claude/governance/pair-rail-inputs-hash-manifest.txt
    20	
    21	## ADR-182 payload pin (PLAN-163 T5.2)
    22	
    23	`--codex-pin-manifest-file` enforces the payload pin: the verdict
    24	envelope MUST declare `tool_versions.codex_target_triple` (the platform
    25	triple of the run that generated the verdict) and
    26	`tool_versions.codex_payload_sha256` (sha256 of the NATIVE codex
    27	payload for that triple — NOT the npm JS launcher). The validator
    28	compares the declared sha against
    29	`manifest.payloads[<triple>].sha256`. Fail-CLOSED: missing fields,
    30	triple absent from the manifest, malformed entry, or sha mismatch →
    31	VERDICT_INVALID (3). Manifest file unreadable → infra (1). The legacy
    32	`--codex-cli-binary-sha256-file` launcher-hash pin is retained only for
    33	pre-ADR-182 tags; the live pin file is a comment-only tombstone, which
    34	that legacy path treats as "no pin" (skip).
    35	
    36	## parent_sha vs commit_sha (S104 redesign)
    37	
    38	The legacy `--commit-sha` arg + verdict `commit_sha:` field bound the
    39	verdict to a SHA the verdict commit itself produced — an unsolvable
    40	self-reference (`pair-rail-verdict-vX.md` cannot declare its own commit
    41	SHA because that SHA is only known AFTER the verdict file is committed).
    42	The v1.16.0 GA ceremony bridged this via `CEO_PAIR_RAIL_VERDICT_OPTIONAL=1`
    43	transition mode, which silently disabled the bind.
    44	
    45	`parent_sha:` solves it cleanly. The verdict declares the commit it was
    46	generated AGAINST (the parent of the verdict-file commit). That value is
    47	known when the verdict is authored (it's `git rev-parse HEAD` before the
    48	verdict commit). Step 15 validates against `git log -n1 --format=%H --
    49	<verdict-file>` parent, which is observable + immutable.
    50	
    51	Backward-compat: when only `commit_sha:` (legacy) is present and
    52	`--parent-sha` is empty, the bind is skipped with an ADVISORY (matches
    53	prior CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 behavior). Legacy verdicts for
    54	already-shipped tags (v1.16.0 etc.) keep their existing semantics; new
    55	verdicts use `parent_sha:`.
    56	
    57	## Exit codes
    58	
    59	- 0: verdict valid; release proceeds.
    60	- 1: infra error (file missing / unparseable / etc.); release.yml
    61	     decides based on CEO_PAIR_RAIL_VERDICT_OPTIONAL.
    62	- 2: VERDICT_EXPIRED — distinct from infra-error per R1 S-QA-Unseen-2.
    63	     Release.yml can route this to a "verdict regen" branch.
    64	- 3: VERDICT_INVALID — decision not authorizing (PLAN-177 W0.1) /
    65	     non-canonical top-level key syntax, i.e. a spelling this reader and
    66	     the local tag guard resolve differently (PLAN-177 t2) /
    67	     release_tag mismatch / parent_sha mismatch / inputs_hash mismatch /
    68	     pin mismatch / signature missing. Release MUST stop here.
    69	
    70	stdlib only. Python ≥3.9.
    71	"""
    72	
    73	from __future__ import annotations
    74	
    75	import argparse
    76	import hashlib
    77	import json
    78	import re
    79	import subprocess
    80	import sys
    81	from datetime import datetime, timezone
    82	from pathlib import Path
    83	from typing import Any, Dict, List, Optional, Tuple
    84	
    85	EXIT_OK = 0
    86	EXIT_INFRA_ERROR = 1
    87	EXIT_VERDICT_EXPIRED = 2
    88	EXIT_VERDICT_INVALID = 3
    89	
    90	# PLAN-177 W0.1 (P1-4). The decisions that AUTHORIZE a release. Every other
    91	# value — NO-GO, absent, empty, malformed, or simply unknown — is
    92	# non-authorizing and stops the release. Spelling is the template's
    93	# (.claude/governance/pair-rail-verdict-template.md:
    94	# `verdict: GO | NO-GO | GO-WITH-CONDITIONS`); membership is tested by EXACT
    95	# equality on purpose — case folding or a substring/prefix rule would read
    96	# NO-GO as authorizing because it CONTAINS GO.
    97	ACCEPTED_DECISIONS = ("GO", "GO-WITH-CONDITIONS")
    98	
    99	
   100	# t8 P1 (root cause below the finding): Python \s is Unicode-aware, so
   101	# `\s*` after the fence opener SWALLOWED a leading U+00A0 line before
   102	# the shape classifier ever saw it. ASCII-only here, like every other
   103	# trim in this reader.
   104	_YAML_BLOCK_RE = re.compile(r"```yaml[ \t]*\n(.*?)```", re.DOTALL)
   105	
   106	
   107	def _strip_comment(raw: str) -> str:
   108	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   109	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   110	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Truncating
   111	    at every `#` authorized that value on both rails. Byte-for-byte twin of
   112	    `_strip_yaml_comment` in _release_tag_guard.py.
   113	    """
   114	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   115	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   116	    if raw.lstrip(" \t").startswith("#"):
   117	        return ""
   118	    i = 0
   119	    while True:
   120	        j = raw.find("#", i)
   121	        if j == -1:
   122	            return raw.rstrip(" \t")
   123	        if j > 0 and raw[j - 1] in (" ", "\t"):
   124	            return raw[:j].rstrip(" \t")
   125	        i = j + 1
   126	
   127	
   128	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   129	# Two readers of the same signed file must not disagree about what a key
   130	# IS: this validator counted `verdict : NO-GO` as a declaration of
   131	# `verdict` (it strips the key), while the local tag guard's regex demanded
   132	# the colon immediately after the name and skipped the line entirely. The
   133	# valid-YAML pair
   134	#
   135	#     verdict : NO-GO
   136	#     verdict: GO
   137	#
   138	# is therefore two declarations here and ONE (=GO) there — a last-wins
   139	# override that the rail enforcing in every mode never saw.
   140	#
   141	# The semantics chosen for BOTH rails, and the reason: NON-CANONICAL
   142	# top-level syntax is REJECTED, fail-closed. Trimming the key in both
   143	# readers would also close the divergence, but it widens the grammar of a
   144	# SIGNED artifact to shapes no author writes and no template emits — every
   145	# new accepted spelling is another chance for the next reader to disagree.
   146	# Refusing the shape is a smaller surface and is the one behaviour that
   147	# cannot silently prefer a value. A top-level line is canonical iff it is
   148	# `name:` with no whitespace before the colon; list items are legal
   149	# ONLY indented under an active bare key (t8 P2: a root `- item` is
   150	# rejected — the old comment said otherwise and misled operators).
   151	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   152	
   153	
   154	def noncanonical_top_level_lines(text: str) -> List[str]:
   155	    """Top-level lines of the yaml block that are not canonical declarations.
   156	
   157	    Byte-for-byte twin of `_noncanonical_top_level_lines` in
   158	    `.claude/scripts/local/_release_tag_guard.py` (separate processes on
   159	    separate machines; neither may import the other — keep them identical).
   160	    Empty list == the block speaks the grammar both readers assume.
   161	    """
   162	    m = _YAML_BLOCK_RE.search(text)
   163	    if not m:
   164	        return []
   165	    bad: List[str] = []
   166	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   167	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   168	    # Both None (before any key) and "scalar" reject — an orphan-indented
   169	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   170	    # through the prev_scalar_decl=False initial state and resolved as GO,
   171	    # and a root-level `- item` is malformed for this signed format (its
   172	    # only lists are INDENTED under a bare key) yet was accepted outright.
   173	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   174	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   175	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   176	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   177	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   178	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   179	    # reopening the orphan-indentation class through the whitespace side.
   180	    parent = None  # None | "scalar" | "bare"
   181	    for raw in m.group(1).splitlines():
   182	        line = _strip_comment(raw)
   183	        if not line.strip(" \t"):
   184	            continue
   185	        if line[0] in (" ", "\t"):
   186	            if parent != "bare":
   187	                bad.append(line)
   188	            continue
   189	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   190	            _key, _, _val = line.partition(":")
   191	            parent = "scalar" if _val.strip(" \t") else "bare"
   192	            continue
   193	        bad.append(line)
   194	        parent = None
   195	    return bad
   196	
   197	
   198	def count_top_level_key(text: str, key: str) -> int:
   199	    """How many times `key:` is declared at the top level of the block.
   200	
   201	    Both readers of this signed file are LAST-WINS, so a second
   202	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   203	    as GO. Callers require exactly one.
   204	
   205	    Only meaningful once `noncanonical_top_level_lines` is empty: this
   206	    counter strips the key, so it sees `verdict : X` as a declaration and
   207	    the twin counter in the tag guard does not. Callers run the shape
   208	    check FIRST.
   209	    """
   210	    m = _YAML_BLOCK_RE.search(text)
   211	    if not m:
   212	        return 0
   213	    seen = 0
   214	    for raw in m.group(1).splitlines():
   215	        line = _strip_comment(raw)
   216	        if not line.strip() or line[0] in (" ", "\t"):
   217	            continue
   218	        if line.partition(":")[0].strip() == key:
   219	            seen += 1
   220	    return seen
   221	
   222	
   223	def parse_verdict_text(text: str) -> Dict[str, Any]:
   224	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   225	    m = _YAML_BLOCK_RE.search(text)
   226	    if not m:
   227	        raise ValueError("verdict file missing yaml frontmatter block")
   228	    yaml_body = m.group(1)
   229	    # Inline minimal YAML parse (stdlib only)
   230	    out: Dict[str, Any] = {}
   231	    current_key: Optional[str] = None
   232	    for raw in yaml_body.splitlines():
   233	        line = _strip_comment(raw)
   234	        if not line.strip():
   235	            continue
   236	        if line[0] not in (" ", "\t"):
   237	            if ":" in line:
   238	                k, _, v = line.partition(":")
   239	                # ASCII-only value trim (t5 P1): a Unicode strip() would
   240	                # normalize `GO<U+00A0>` into the exact authorizing token.
   241	                v = v.strip(" \t")
   242	                if v:
   243	                    out[k.strip(" \t")] = v
   244	                else:
   245	                    out[k.strip(" \t")] = {}
   246	                    current_key = k.strip(" \t")
   247	        elif current_key and ":" in line:
   248	            sub_k, _, sub_v = line.partition(":")
   249	            if isinstance(out[current_key], dict):
   250	                out[current_key][sub_k.strip(" \t")] = sub_v.strip(" \t")
   251	    return out
   252	
   253	
   254	def parse_verdict_file(path: Path) -> Dict[str, Any]:
   255	    """Path wrapper over parse_verdict_text (published entry point)."""
   256	    if not path.exists():
   257	        raise FileNotFoundError(f"verdict file: {path}")
   258	    return parse_verdict_text(path.read_text(encoding="utf-8"))
   259	
   260	
   261	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   262	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   263	    if not manifest_path.exists():
   264	        raise FileNotFoundError(f"manifest: {manifest_path}")
   265	    paths = []
   266	    for line in manifest_path.read_text().splitlines():
   267	        line = line.split("#", 1)[0].strip()
   268	        if line:
   269	            paths.append(line)
   270	    paths.sort()
   271	    hashes = {}
   272	    for p in paths:
   273	        result = subprocess.run(
   274	            ["git", "hash-object", p],
   275	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   276	        )
   277	        if result.returncode != 0:
   278	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   279	        hashes[p] = result.stdout.strip()
   280	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   281	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   282	
   283	
   284	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   285	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   286	    if not pin_file.exists():
   287	        return None, None
   288	    for line in pin_file.read_text().splitlines():
   289	        line = line.split("#", 1)[0].strip()
   290	        if not line:
   291	            continue
   292	        # parse `>=X.Y.Z,<A.B.C` shape
   293	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   294	        if m:
   295	            return m.group(1), m.group(2)
   296	    return None, None
   297	
   298	
   299	def parse_semver(s: str) -> Tuple[int, int, int]:
   300	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   301	    if not m:
   302	        raise ValueError(f"unparseable semver: {s!r}")
   303	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   304	
   305	
   306	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   307	    try:
   308	        v = parse_semver(version)
   309	        lo = parse_semver(min_v)
   310	        hi = parse_semver(max_v)
   311	        return lo <= v < hi
   312	    except ValueError:
   313	        return False
   314	
   315	
   316	def main(argv: Optional[List[str]] = None) -> int:
   317	    parser = argparse.ArgumentParser()
   318	    parser.add_argument("--verdict-file", required=True)
   319	    parser.add_argument(
   320	        "--parent-sha",
   321	        default="",
   322	        help=(
   323	            "Expected verdict.parent_sha — the commit the verdict was "
   324	            "generated against (parent of the verdict-file commit). "
   325	            "Resolves the self-reference problem the legacy --commit-sha "
   326	            "bind had with PLAN-081 v1.16.0 GA. Empty string = skip bind."
   327	        ),
   328	    )
   329	    parser.add_argument(
   330	        "--commit-sha",
   331	        default="",
   332	        help=(
   333	            "DEPRECATED legacy bind. Retained for backward-compat with "
   334	            "v1.16.0-era verdicts that ship `commit_sha:` field. "
   335	            "Mutually exclusive with --parent-sha; if both passed, "
   336	            "--parent-sha wins."
   337	        ),
   338	    )
   339	    parser.add_argument("--release-tag", required=True)
   340	    parser.add_argument("--max-age-hours", type=int, default=24)
   341	    parser.add_argument("--recompute-inputs-hash", action="store_true")
   342	    parser.add_argument("--codex-cli-pin-file", default="")
   343	    parser.add_argument("--codex-cli-binary-sha256-file", default="")
   344	    parser.add_argument(
   345	        "--codex-pin-manifest-file",
   346	        default="",
   347	        help=(
   348	            "ADR-182 payload-pin manifest (codex-cli-pin-manifest.json). "
   349	            "When passed, verdict.tool_versions.codex_target_triple + "
   350	            ".codex_payload_sha256 MUST match the manifest entry "
   351	            "(fail-CLOSED — VERDICT_INVALID on any miss)."
   352	        ),
   353	    )
   354	    parser.add_argument("--inputs-hash-paths-file", default="")
   355	    args = parser.parse_args(argv)
   356	
   357	    verdict_path = Path(args.verdict_file)
   358	    repo_root = Path.cwd()
   359	
   360	    # Parse verdict. The TEXT is kept: the duplicate-key check below reads
   361	    # the same bytes the parse consumed (a second read could disagree).
   362	    try:
   363	        verdict_text = verdict_path.read_text(encoding="utf-8")
   364	        verdict = parse_verdict_text(verdict_text)
   365	    except FileNotFoundError as e:
   366	        print(f"INFRA: verdict file not found: {e}", file=sys.stderr)
   367	        return EXIT_INFRA_ERROR
   368	    except OSError as e:
   369	        print(f"INFRA: verdict file unreadable: {e}", file=sys.stderr)
   370	        return EXIT_INFRA_ERROR
   371	    except ValueError as e:
   372	        print(f"INFRA: verdict parse error: {e}", file=sys.stderr)
   373	        return EXIT_INFRA_ERROR
   374	
   375	    # PLAN-177 W0.1 (P1-4): the DECISION gate. Until this block existed
   376	    # the validator read pinning, TTL and signature presence but never the
   377	    # verdict itself: a cross-model NO-GO returned OK / exit 0.
   378	    #
   379	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on):
   380	    # this step carries `continue-on-error` when
   381	    # CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 (release.yml:689), so the gate HERE
   382	    # is defence in depth; the rail that enforces in EVERY mode is
   383	    # `.claude/scripts/local/_release_tag_guard.py delta`, invoked by a
   384	    # step with no escape hatch. Neither may be dropped for the other.
   385	    #
   386	    # Fail-CLOSED on SHAPE as well as value (CF-1): the reader above
   387	    # returns a dict for an empty `verdict:` line, so the type check
   388	    # precedes the compare and a malformed decision exits 3 (INVALID),
   389	    # never 1 (INFRA) -- which the transition mode is allowed to wave
   390	    # through. Same precedent as the tool_versions dict check below.
   391	    # PLAN-177 t2 (P1-a): SHAPE BEFORE VALUE. The counter below and the tag
   392	    # guard's counter only agree on a canonical block; a non-canonical
   393	    # top-level line is refused here rather than parsed by two grammars.
   394	    # INVALID (3), never INFRA (1): the transition mode may wave INFRA
   395	    # through, and this is a property of the SIGNED bytes, not of the runner.
   396	    noncanonical = noncanonical_top_level_lines(verdict_text)
   397	    if noncanonical:
   398	        print(
   399	            f"INVALID: non-canonical top-level key syntax in the verdict "
   400	            f"block: {noncanonical!r} -- a top-level line must be `name:` "
   401	            f"with no whitespace before the colon; list items only INDENTED "
   402	            f"under a bare key, never at the root. "
   403	            f"The two release rails read this file with different "
   404	            f"grammars, so `verdict : NO-GO` followed by `verdict: GO` "
   405	            f"counts as two declarations here and one there; the shape is "
   406	            f"refused instead of guessed.",
   407	            file=sys.stderr,
   408	        )
   409	        return EXIT_VERDICT_INVALID
   410	
   411	    decisions_declared = count_top_level_key(verdict_text, "verdict")
   412	    if decisions_declared > 1:
   413	        print(
   414	            f"INVALID: verdict decision declared more than once "
   415	            f"(x{decisions_declared}) -- the reader is last-wins, so a "
   416	            f"duplicated `verdict:` silently overrides the first; exactly "
   417	            f"one is required.",
   418	            file=sys.stderr,
   419	        )
   420	        return EXIT_VERDICT_INVALID
   421	    raw_decision = verdict.get("verdict")
   422	    if raw_decision is None:
   423	        shown = "<absent>"
   424	    elif not isinstance(raw_decision, str):
   425	        shown = "<non-string:%s>" % type(raw_decision).__name__
   426	    else:
   427	        # ASCII-only trim (t5 P1): `GO<U+00A0>` must FAIL the exact-token
   428	        # membership below, never be normalized into `GO`.
   429	        shown = raw_decision.strip(" \t")
   430	    if shown not in ACCEPTED_DECISIONS:
   431	        accepted = "{%s}" % ", ".join(ACCEPTED_DECISIONS)
   432	        print(
   433	            f"INVALID: verdict decision '{shown}' not in {accepted} -- a "
   434	            f"release requires an explicit authorizing decision from the "
   435	            f"pair-rail. Exact match: no case folding, no substring rule "
   436	            f"(NO-GO contains GO).",
   437	            file=sys.stderr,
   438	        )
   439	        return EXIT_VERDICT_INVALID
   440	
   441	    # R1 S-Sec-3: release_tag bind
   442	    declared_tag = verdict.get("release_tag", "").strip()
   443	    if declared_tag != args.release_tag:
   444	        print(
   445	            f"INVALID: verdict release_tag mismatch — "
   446	            f"declared='{declared_tag}', argv='{args.release_tag}'",
   447	            file=sys.stderr,
   448	        )
   449	        return EXIT_VERDICT_INVALID
