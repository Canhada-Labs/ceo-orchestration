   198	def count_top_level_key(text: str, key: str) -> int:
   199	    """How many times `key:` is declared at the top level of the block.
   200	
   201	    Both readers of this signed file are LAST-WINS, so a second
   202	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   203	    as GO. Callers require exactly one.
   204	
   205	    Only meaningful once `noncanonical_top_level_lines` is empty: this
   206	    counter strips the key, so it sees `verdict : X` as a declaration and
   207	    the twin counter in the tag guard does not. Callers run the shape
   208	    check FIRST.
   209	    """
   210	    m = _YAML_BLOCK_RE.search(text)
   211	    if not m:
   212	        return 0
   213	    seen = 0
   214	    for raw in m.group(1).splitlines():
   215	        line = _strip_comment(raw)
   216	        if not line.strip() or line[0] in (" ", "\t"):
   217	            continue
   218	        if line.partition(":")[0].strip() == key:
   219	            seen += 1
   220	    return seen
