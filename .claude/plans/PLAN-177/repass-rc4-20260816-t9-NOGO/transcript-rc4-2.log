  while [ -n "$_rsd_walk" ] && [ "$_rsd_walk" != "." ] && [ "$_rsd_walk" != "/" ]; do
    if [ -L "$TARGET/$_rsd_walk" ]; then
      echo "    WARNING: PRESERVED $_rsd_rel (ancestor $_rsd_walk is a symlink — refusing to write through it)"
      return 0
    fi
    _rsd_walk="$(dirname "$_rsd_walk")"
  done
