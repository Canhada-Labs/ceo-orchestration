   852	# mandatory exclusion; when a probe is visible it APPENDS the exclusion
   853	# again (after the winning negation — last matching rule wins) and
   854	# re-probes; a still-visible probe fails loudly (the negation lives in a
   855	# file this applier does not own, e.g. a deeper .gitignore).
   856	#   $1 = repo root to run git in; $2 = gitignore file to re-assert into;
   857	#   $3 = the raw exclusion line; $4 = repo-relative probe path.
   858	# Outside a git work tree the probe cannot run — NOTE and return 0
   859	# (fail-open on infra; the textual pass above already ran).
   860	_gitignore_reassert_effective() {
