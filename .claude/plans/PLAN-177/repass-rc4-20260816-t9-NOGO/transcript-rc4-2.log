   649	class TestHarnessProbeFilter(TestEnvContext):
   650	    """S303: harness tool-loading probes (ToolSearch materialization) carry a
   651	    description now, so the S86 ghost filter (which requires desc_preview=='')
   652	    misses them and a single probe pins skill_unknown_ratio to 1/1 = 100%.
   653	    """
   654	
   655	    REAL_EVENT = {
   656	        "action": "agent_spawn",
   657	        "subagent_type": "",
   658	        "desc_preview": "Load WebFetch via ToolSearch?",
   659	        "desc_hash":
   660	            "3aa1aca1be9b616da5fd32fd9db7b6de5037ed45182e1e350f31cc8dbd67c24f",
   661	        "skill": "unknown",
   662	        "has_profile": False,
   663	        "has_file_assignment": False,
   664	        "rail": None,
   665	        "archetype": None,
   666	    }
   667	
   668	    def test_probe_shaped_event_is_not_exempt(self):
   669	        """Re-pass rc.4 t2 (P1): the S303 exemption is RETIRED — desc_preview
   670	        and desc_hash derive from the SAME caller-controlled description, so
   671	        the hash corroborates nothing. Probe-shaped rows COUNT until the
   672	        emitter can stamp provenance the caller cannot forge. The shape
   673	        DETECTOR is kept for that future emitter."""
   674	        self.assertFalse(_mod._is_ghost_spawn_event(self.REAL_EVENT))
   675	        self.assertFalse(_mod._is_harness_probe_event(self.REAL_EVENT))
   676	        self.assertTrue(_mod._has_harness_probe_fingerprint(self.REAL_EVENT))
   677	
   678	    def test_filter_is_not_a_governance_escape_hatch(self):
   679	        # NEGATIVE CONTROL: a real skill-less dispatch that carries ANY one of
   680	        # the five governed markers must still count in the denominator.
   681	        for over in (
   682	            {"subagent_type": "security-engineer"},
   683	            {"archetype": "security-engineer"},
   684	            {"rail": "claude"},
   685	            {"has_profile": True},
   686	            {"has_file_assignment": True},
   687	        ):
   688	            ev = dict(self.REAL_EVENT)
   689	            ev.update(over)
   690	            self.assertFalse(_mod._is_harness_probe_event(ev), repr(over))
   691	
   692	    # ------------------------------------------------------------------
   693	    # PLAN-177 t2 (re-pass rc.4 P1-f) — the filter needs a POSITIVE
   694	    # fingerprint, not five absences.
