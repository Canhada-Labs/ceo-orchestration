   503	def _is_ghost_spawn_event(ev: Dict[str, Any]) -> bool:
   504	    """True iff the agent_spawn event is a harness ghost-event (no real payload).
   505	
   506	    All four conditions must hold simultaneously to avoid false-positives on
   507	    legitimate near-empty dispatches: empty desc, no rail attribution, no
   508	    profile marker, and SHA-of-empty-string desc_hash.
   509	    """
   510	    # Re-pass rc.4 t3 (P1): RETIRED with the same rationale as the S303
   511	    # harness-probe exemption — every condition here is ABSENCE, and
   512	    # desc_hash == SHA256("") corroborates nothing (it derives from the
   513	    # same empty caller-controlled description). A real markerless spawn
   514	    # with an empty description — e.g. one a fail-open PreToolUse hook
   515	    # admitted — matched all four and was deleted from the denominator.
   516	    # Ghost-shaped rows COUNT until the emitter can stamp provenance the
   517	    # caller cannot forge.
   518	    return False
   519	
   520	
   521	# PLAN-177 t2 (re-pass rc.4 P1-f). The POSITIVE half of the probe test.
   522	#
   523	# The S303 filter below identified a probe by ABSENCE alone — five governed
   524	# markers missing — and absence is the shape of the events the ratio exists to
   525	# find: a markerless real spawn (including one the PreToolUse hook admitted by
   526	# failing open) was classified as harness noise and removed from the
   527	# denominator. A probe-only window then reported green with
   528	# `harness_probes_skipped=1` while the governance gap it was built to surface
   529	# went unrendered.
   530	#
   531	# So the structural conditions are necessary, not sufficient: the row must ALSO
   532	# carry the observed harness signature. The signature is CLOSED — the literal
   533	# description the tool-materialization probe emits, anchored at both ends
   534	# (`Load <Tool> via ToolSearch?`, S303 observation, prompt `noop`) — plus
   535	# corroboration by `desc_hash`, which the emitter computes over the RAW
   536	# description: if the two disagree the preview was truncated or redacted, i.e.
   537	# not this short, secret-free probe line. Anything else counts. Every
   538	# uncertainty resolves toward VISIBLE.
   539	_HARNESS_PROBE_DESC_RE = re.compile(
   540	    r"\ALoad [A-Za-z0-9_.\-]+(?:,[ ]?[A-Za-z0-9_.\-]+)* via ToolSearch\?\Z"
   541	)
   542	
   543	
   544	def _has_harness_probe_fingerprint(ev: Dict[str, Any]) -> bool:
   545	    """True iff the row carries the CLOSED, observed harness-probe signature.
   546	
   547	    Positive identification, never inferred from missing fields. An absent or
   548	    non-matching `desc_hash` is NOT corroboration, so it returns False and the
   549	    row is counted — the safe direction for an advisory that exists to expose
   550	    unclassified spawns.
   551	    """
   552	    desc = ev.get("desc_preview")
   553	    if not isinstance(desc, str) or not _HARNESS_PROBE_DESC_RE.match(desc):
   554	        return False
   555	    digest = ev.get("desc_hash")
   556	    if not isinstance(digest, str) or not digest:
   557	        return False
   558	    return digest == hashlib.sha256(desc.encode("utf-8")).hexdigest()
   559	
   560	
   561	def _is_harness_probe_event(ev: Dict[str, Any]) -> bool:
   562	    """True iff the agent_spawn row is a harness-internal tool-loading probe.
   563	
   564	    S303: the ghost filter above was written for the ToolSearch probes of an
   565	    older harness, whose Agent-shaped PostToolUse rows carried NO description
   566	    (desc_preview == "" and desc_hash == SHA256(b"")). The current harness
   567	    supplies a human-readable description for the same class of call — e.g.
   568	    ``Load WebFetch via ToolSearch?`` with prompt ``noop`` and a fixed cheap
   569	    model — so all four ghost conditions no longer hold and a pure
   570	    tool-materialization probe lands in the denominator as a governance gap.
   571	
   572	    The discriminator is ``subagent_type``: the Agent/Task spawn contract makes
   573	    it REQUIRED for every governed dispatch (``check_agent_spawn.py`` derives
   574	    the authoritative archetype from it, and ``extract_skill`` Path D needs it),
   575	    so a row that carries none was never a CEO dispatch. All five conditions
   576	    must hold — no subagent_type, no archetype, no rail attribution, no
   577	    ``## AGENT PROFILE`` and no ``## FILE ASSIGNMENT`` — so a real named spawn
   578	    that merely lost one field still counts.
   579	
   580	    T-2 STATUS (re-pass rc.4 t5/t7 P2): DEFERRED, not cured — this function
   581	    ALWAYS returns False today and probe-shaped rows COUNT in the
   582	    denominator (a probe-only window reads 1/1 red and the operator
   583	    triages it). The former ``harness_probes_skipped`` counter was removed
   584	    together with the exemption; no row is skipped, so nothing is
   585	    "reported through" anything.
   586	
   587	    PLAN-177 t2 (P1-f): those five are NECESSARY, NOT SUFFICIENT. Absence is
   588	    exactly the shape of the event this ratio exists to expose — a markerless
   589	    REAL spawn, including one admitted because the PreToolUse hook failed
   590	    open, matched all five and was deleted from the denominator. The row must
   591	    ALSO carry the closed harness signature
   592	    (``_has_harness_probe_fingerprint``); an unrecognised description counts,
   593	    however markerless the row is.
   594	    """
   595	    # Re-pass rc.4 t2 (P1): the S303 exemption is RETIRED until trusted
   596	    # provenance exists. `desc_preview` and `desc_hash` are both derived
   597	    # from the same CALLER-CONTROLLED description, so the hash corroborates
   598	    # nothing: a real markerless spawn described as
   599	    # `Load WebFetch via ToolSearch?` was silently deleted from the
   600	    # denominator — the exact event this ratio exists to expose. Until the
   601	    # EMITTER can stamp provenance the caller cannot forge, probe-shaped
   602	    # rows COUNT (the conservative direction for an advisory: a yellow the
   603	    # operator triages beats a green that hides a fail-open spawn).
   604	    # _has_harness_probe_fingerprint is kept (tested) as the shape
   605	    # DETECTOR for that future provenance-bearing emitter.
   606	    return False
