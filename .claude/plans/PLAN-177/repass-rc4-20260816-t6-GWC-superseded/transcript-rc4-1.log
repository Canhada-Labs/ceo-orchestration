  1460	def _contract_rows(doc_text: str) -> List[List[str]]:
  1461	    """The `## Contract` table as [control, mechanism, status, where]."""
  1462	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
