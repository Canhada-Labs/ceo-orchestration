  2055	def test_documented_npm_signature_recipe_matches_what_npm_audits():
  2056	    """Every documented `npm audit signatures` has to be reachable by npm.
  2057	
  2058	    A recipe offends when its unit pairs the command with an install npm cannot
  2059	    audit, passes a positional npm ignores, or passes `--global`, which npm
  2060	    rejects. Naming `EAUDITGLOBAL` in the unit is the tolerance: a document is
  2061	    free — and encouraged — to put the global install next to the command in
  2062	    order to say that the command does NOT reach it."""
  2063	    offenders: List[str] = []
  2064	    units_examined = 0
  2065	    for path in _live_doc_surfaces():
  2066	        rel = path.relative_to(REPO_ROOT).as_posix()
  2067	        text = path.read_text(encoding="utf-8")
  2068	        if not _AUDIT_SIGNATURES.search(text):
  2069	            continue
  2070	        for label, unit in _recipe_units(text):
  2071	            if not _AUDIT_SIGNATURES.search(unit):
  2072	                continue
  2073	            units_examined += 1
  2074	            faults = []
  2075	            if _UNAUDITABLE_INSTALL.search(unit) and "EAUDITGLOBAL" not in unit:
  2076	                faults.append(
  2077	                    "pairs the audit with an install npm cannot audit "
  2078	                    "(global, or exec/npx leaving no dependency behind)"
  2079	                )
  2080	            positional = _AUDIT_POSITIONAL.search(unit)
  2081	            if positional:
  2082	                faults.append(
  2083	                    "passes the positional %r, which npm ignores — the audit "
  2084	                    "still reads the current project" % positional.group(1)
  2085	                )
  2086	            if _AUDIT_GLOBAL_FLAG.search(unit):
  2087	                faults.append("passes --global, which npm rejects (EAUDITGLOBAL)")
  2088	            if faults:
  2089	                offenders.append(
  2090	                    "%s %s: %s\n    %s"
  2091	                    % (rel, label, "; ".join(faults), unit.strip()[:160])
