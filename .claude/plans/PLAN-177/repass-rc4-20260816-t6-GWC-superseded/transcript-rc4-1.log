  1235	        if not base.exists():
  1236	            continue
  1237	        paths = [base] if base.is_file() else sorted(base.rglob("*"))
  1238	        for path in paths:
  1239	            if not path.is_file() or "__pycache__" in path.parts:
  1240	                continue
  1241	            try:
  1242	                body = path.read_text(encoding="utf-8")
  1243	            except (UnicodeDecodeError, OSError):
  1244	                continue  # binary artifact: not a live text surface
  1245	            scanned += 1
  1246	            for num, line in enumerate(body.splitlines(), 1):
  1247	                if needle in line:
  1248	                    hits.append(
  1249	                        "%s:%d: %s"
  1250	                        % (path.relative_to(REPO_ROOT), num, line.strip())
  1251	                    )
  1252	    return scanned, hits
