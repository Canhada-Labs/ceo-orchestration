  1227	def scan_live_surfaces(needle: str):
  1228	    """grep, in Python. The local `grep` is ugrep and disagrees with GNU grep
  1229	    about binary files, so a subprocess control would not mean the same thing
  1230	    here and in CI. Returns (files_scanned, hits)."""
