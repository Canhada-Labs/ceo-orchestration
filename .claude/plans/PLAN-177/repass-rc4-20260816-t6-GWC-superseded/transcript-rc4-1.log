  1465	    for line in m.group(0).splitlines():
  1466	        line = line.strip()
  1467	        if not line.startswith("|"):
  1468	            continue
  1469	        cells = [c.strip() for c in line.strip("|").split("|")]
  1470	        if len(cells) != 4:
  1471	            continue
  1472	        if cells[0] == "Control" or set(cells[0]) <= set("- :"):
  1473	            continue
  1474	        rows.append(cells)
  1475	    return rows
