   103	def _strip_comment(raw: str) -> str:
   104	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   105	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   106	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Truncating
   107	    at every `#` authorized that value on both rails. Byte-for-byte twin of
   108	    `_strip_yaml_comment` in _release_tag_guard.py.
   109	    """
   110	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   111	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   112	    if raw.lstrip(" \t").startswith("#"):
   113	        return ""
   114	    i = 0
   115	    while True:
   116	        j = raw.find("#", i)
   117	        if j == -1:
   118	            return raw.rstrip(" \t")
   119	        if j > 0 and raw[j - 1] in (" ", "\t"):
   120	            return raw[:j].rstrip(" \t")
   121	        i = j + 1
   122	
