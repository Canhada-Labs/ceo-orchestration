  1812	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1813	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1814	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1815	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1816	    even standing somewhere that can be checked?" — the question the file
  1817	    failed on the day it shipped."""
  1818	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1819	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1820	
  1821	    # The sweep must be looking at the right text: intro present, table absent.
  1822	    swept = _prose_outside_the_declared_zones(doc)
  1823	    assert "Integrity contract for the" in swept, (
  1824	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1825	        "the prose it exists to watch"
  1826	    )
  1827	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1828	    assert len(swept) > len(doc) // 3, (
  1829	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1830	        % (len(swept), len(doc))
  1831	    )
  1832	
  1833	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1834	    # merits. The order matters and was learned the hard way — the controls
  1835	    # below build their fixtures FROM the live file, so when the file itself
  1836	    # carries a planted defect they fail first and the red names the fixture
  1837	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1838	    # always reds on the assertion that describes what is actually wrong.
  1839	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1840	    offenders = _enforcement_vocabulary_offenders(doc)
  1841	    assert not offenders, (
  1842	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1843	        "§Not yet automated. Move the claim into a table row (with a step the "
  1844	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1845	    )
  1846	
  1847	    # (b) positive control: the historical claim restored to the introduction.
  1848	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1849	    # today's wording — an anchor on current prose stops matching the moment
  1850	    # that prose is edited, and then the control fails for the wrong reason.
  1851	    title, _, rest = doc.partition("\n")
  1852	    claim = (
  1853	        "The integrity controls enforced today are: (1) the `install.sh` "
  1854	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1855	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1856	    )
  1857	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1858	    assert relapse != doc, "relapse fixture did not patch the doc"
  1859	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1860	    assert any("enforced today" in o for o in relapse_offenders), (
  1861	        "an enforcement claim in the introduction went unseen: %s"
  1862	        % relapse_offenders
  1863	    )
  1864	    assert any("recorded by" in o for o in relapse_offenders), (
  1865	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1866	    )
  1867	
  1868	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1869	    # offender. This is the predicate as documented, not a global grep — that
  1870	    # section is where honest prose about absence has to be able to use these
  1871	    # words. Its own honesty is held by the restatement test above; a claim
  1872	    # parked there is the residual gap, and it is a narrow, watched one.
  1873	    marker = "## Not yet automated"
  1874	    assert marker in doc
  1875	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1876	    assert not _enforcement_vocabulary_offenders(parked), (
  1877	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1878	        "a declared zone"
  1879	    )
  1880	
  1881	
  1882	# --------------------------------------------------------------------------
  1883	# Supply-chain honesty: the two claims that survive being corrected in one file
  1884	#
  1885	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  1886	# was green while `npm/README.md` — the README an npm consumer actually
  1887	# RECEIVES, it is in package.json `files` — still promised "SLSA 3 provenance",
  1888	# and while README.pt-BR, INSTALL.md and both QUICKSTARTs repeated Level 3 and
  1889	# a checksum coverage the release does not have (repass-rc4 part 2, P1 §2).
  1890	# A single-file gate cannot see that class, so the surface list below is
  1891	# EXPLICIT, and `_live_doc_surfaces()` re-derives the population from the repo
  1892	# so a NEW document carrying either claim also lands in front of the gate.
  1893	#
  1894	# `.claude/**` is deliberately outside the population: plans, debates and
  1895	# archived verdicts are historical records, and they have to be able to quote a
  1896	# false claim verbatim without turning this gate red.
  1897	# --------------------------------------------------------------------------
  1898	
  1899	SUPPLY_CHAIN_HONESTY_SURFACES = (
  1900	    "README.md",
  1901	    "README.pt-BR.md",
  1902	    "npm/README.md",
  1903	    "npm/INTEGRITY.md",
  1904	    "INSTALL.md",
  1905	    "SECURITY.md",
  1905	    "SECURITY.md",
  1906	    "SUPPORT.md",
  1907	    "SBOM.md",
  1908	    "docs/QUICKSTART.md",
  1909	    "docs/QUICKSTART.pt-BR.md",
  1910	    "docs/CTO-GUIDE.md",
  1911	    "docs/threat-model.md",
  1912	)
  1913	
  1914	# "SLSA 3", "SLSA-3", "SLSA Level 3", "SLSA L3", "SLSA provenance L3" and
  1915	# "provenance (SLSA L3)" all normalise to the same false claim. The earlier
  1916	# pattern only caught the first three, which is why `SBOM.md` ("SLSA L3") and
  1917	# `docs/QUICKSTART.md` ("SLSA provenance L3") were invisible to it.
  1918	_SLSA_LEVEL3_CLAIM = re.compile(
  1919	    r"SLSA[\s\-]*(?:provenance[\s\-]*)?(?:Level[\s\-]*|L)?3\b"
  1920	    r"|(?:provenance|attestation)[\s\-]*(?:Level[\s\-]*|L)3\b",
  1921	    re.IGNORECASE,
  1922	)
  1923	
  1924	# Plural = aggregate. Release checksum coverage is `install.sh` alone
  1925	# (SECURITY.md §How to verify what you install); "ships SHA-256 checksums"
  1926	# promises a SHA256SUMS that no workflow produces.
  1927	_CHECKSUM_AGGREGATE_CLAIM = re.compile(
  1928	    r"SHA-?256\s+checksums|checksums\s+SHA-?256", re.IGNORECASE
  1929	)
  1930	
  1931	
  1932	def _live_doc_surfaces() -> List[Path]:
  1933	    """Root-level, `docs/` and `npm/` markdown — every document a reader or an
  1934	    npm consumer meets. Deliberately NOT `.claude/**` (see the block comment)."""
  1935	    found = sorted(REPO_ROOT.glob("*.md"))
  1936	    for sub in ("docs", "npm"):
  1937	        base = REPO_ROOT / sub
  1938	        if base.exists():
  1939	            found += sorted(base.rglob("*.md"))
  1940	    return found
  1941	
  1942	
  1943	def test_slsa_and_checksum_claims_are_true_on_every_shipped_surface():
  1944	    """The npm consumer reads `npm/README.md`; the Portuguese reader reads
  1945	    `README.pt-BR.md`. Correcting the root README alone left both promising a
  1946	    Level the pipeline never reaches. The gate now runs over an explicit list
  1947	    AND over every live doc, so neither a missed translation nor a new file can
  1948	    carry the claim silently."""
  1949	    surfaces = {p.relative_to(REPO_ROOT).as_posix(): p for p in _live_doc_surfaces()}
  1950	
  1951	    # (a) The explicit list is not allowed to name a file that stopped
  1952	    # existing: a surface silently dropped from the repo is a gate that
  1953	    # quietly narrows.
  1954	    missing = [s for s in SUPPLY_CHAIN_HONESTY_SURFACES if s not in surfaces]
  1955	    assert not missing, "declared honesty surfaces that no longer exist: %s" % missing
  1956	
  1957	    offenders: List[str] = []
  1958	    for rel, path in surfaces.items():
  1959	        text = path.read_text(encoding="utf-8")
  1960	        for m in _SLSA_LEVEL3_CLAIM.finditer(text):
  1961	            # Tolerance is scoped to what FOLLOWS the mention, never to the
  1962	            # line: the honest sentence names Level 2 and disclaims Level 3 in
  1963	            # one breath, so a line-wide exemption would let the false claim
  1964	            # ride along beside its own disclaimer. The window is 120 chars
  1965	            # because the live disclaimer parenthesises its reason
  1966	            # ("(hermetic build + two-party review) is out of scope") — at the
  1967	            # old width of 40 the only honest Level-3 sentence in the repo
  1968	            # would have been the gate's first false positive.
  1969	            tail = text[m.end():m.end() + 120]
  1970	            if "out of scope" in tail or "fora de escopo" in tail:
  1971	                continue
  1972	            offenders.append(
  1973	                "%s: ...%s..."
  1974	                % (rel, text[max(0, m.start() - 60):m.end() + 40].strip().replace("\n", " "))
  1975	            )
  1976	        for m in _CHECKSUM_AGGREGATE_CLAIM.finditer(text):
  1977	            offenders.append(
  1978	                "%s: ...%s..."
  1979	                % (rel, text[max(0, m.start() - 70):m.end() + 30].strip().replace("\n", " "))
  1980	            )
  1981	
  1982	    assert not offenders, (
  1983	        "shipped docs claim SLSA Level 3 and/or aggregate release checksums; "
  1984	        "the pipeline reaches Level 2 (`npm publish --provenance`) and the "
  1985	        "release checksum covers `install.sh` only:\n%s" % "\n".join(offenders)
  1986	    )
  1987	
  1988	    # (b) Positive statement, on the two most-read surfaces: silence about the
  1989	    # level is not honesty either. The npm README is named explicitly because
  1990	    # it is the one that travels inside the tarball.
  1991	    for rel in ("README.md", "npm/README.md"):
  1992	        text = surfaces[rel].read_text(encoding="utf-8")
  1993	        assert "SLSA **Level 2**" in text or "SLSA Level 2" in text, (
  1994	            "%s no longer states the level the pipeline reaches" % rel
  1995	        )
  1996	
  1997	
  1998	# --------------------------------------------------------------------------
  1999	# The npm signature recipe has to audit the thing the reader just installed
  2000	#
  2001	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2002	# no package-selecting positional (a trailing package name is ignored), and it
  2003	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2004	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2005	# with `npm audit signatures` verified nothing the reader had just installed —
  2006	# it audited whatever directory they happened to be standing in, and could
  2007	# return a confident green having examined a different tree entirely.
  2008	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2009	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2010	# project install followed by a BARE `npm audit signatures`.
  2011	# --------------------------------------------------------------------------
  2012	
  2013	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2014	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2015	# (ephemeral — nothing is left in a dependency tree to audit).
  2016	_UNAUDITABLE_INSTALL = re.compile(
  2017	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2018	)
  2019	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2020	# the reader believes it selected a package. `#` is excluded so the honest
  2021	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2022	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2023	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2024	_AUDIT_GLOBAL_FLAG = re.compile(
  2025	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2026	)
