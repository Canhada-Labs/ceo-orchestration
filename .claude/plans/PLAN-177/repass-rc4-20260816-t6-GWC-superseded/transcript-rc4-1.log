.claude/scripts/local/release.sh-610-  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to tag"
.claude/scripts/local/release.sh-611-
.claude/scripts/local/release.sh-612-  # VERSION carries the BARE semver even for an RC tag (see the bump header),
.claude/scripts/local/release.sh-613-  # so compare against $TARGET_BASE, never $TARGET_VERSION.
.claude/scripts/local/release.sh-614-  cur_version="$(tr -d ' \n' < VERSION)"
.claude/scripts/local/release.sh-615-  [ "$cur_version" = "$TARGET_BASE" ] \
.claude/scripts/local/release.sh-616-    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
.claude/scripts/local/release.sh-617-  ok "VERSION ($cur_version) matches the base version of the tag"
.claude/scripts/local/release.sh-618-
.claude/scripts/local/release.sh-619-  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
.claude/scripts/local/release.sh-620-    && die "tag $TARGET_TAG already exists"
.claude/scripts/local/release.sh-621-
.claude/scripts/local/release.sh-622-  hdr "tag guards (unconditional — RC and stable)"
.claude/scripts/local/release.sh-623-  if [ "$OFFLINE_ACK" -eq 1 ]; then
.claude/scripts/local/release.sh-624-    python3 "$TAG_GUARD" ancestry --repo "$REPO_ROOT" --remote origin --branch main --offline-ack \
