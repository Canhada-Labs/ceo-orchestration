   141	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   142	    ref = "%s/%s" % (remote, branch)
   143	    if offline_ack:
   144	        print(
   145	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   146	            "merge-base below is judged against a possibly STALE %s" % ref
   147	        )
   148	    else:
   149	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   150	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   151	        # stale ref reads as approval.
   152	        if rc != 0:
   153	            return _fail(
   154	                E_FETCH,
   155	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   156	                "      This is NOT a verdict on the commit — the check did not "
   157	                "run.\n"
   158	                "      Fix the network/remote and re-run, or, if you are "
   159	                "deliberately\n"
   160	                "      offline and accept judging against the last-known ref, "
   161	                "re-run\n"
   162	                "      with --offline-ack (it is recorded in the output).\n"
   163	                "      git said: %s" % (remote, branch, rc, err.strip()),
   164	            )
   165	        print("  ok   fetched %s" % ref)
   166	
   167	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   168	    if rc != 0 or not out.strip():
   169	        return _fail(
   170	            E_REMOTE_REF,
   171	            "no usable ref %s in this repo — cannot judge ancestry "
   172	            "(git said: %s)" % (ref, err.strip()),
   173	        )
   174	    remote_sha = out.strip()
   175	
   176	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   177	    if rc == 0:
   178	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   179	        return 0
   180	    if rc == 1:
   181	        return _fail(
   182	            E_NOT_ANCESTOR,
   183	            "HEAD is not an ancestor of %s — push main and re-run the "
   184	            "preflight.\n"
   185	            "      A tag on an unpushed commit points at a tree CI never "
   186	            "saw; the\n"
   187	            "      preflight's green verdict was about a different SHA."
   188	            % ref,
   189	        )
   190	    return _fail(
   191	        E_REMOTE_REF,
   192	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   193	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   194	    )
   195	
