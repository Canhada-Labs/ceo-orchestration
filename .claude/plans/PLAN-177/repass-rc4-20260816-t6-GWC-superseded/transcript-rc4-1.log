   357	def _sha256(path: str) -> str:
   358	    h = hashlib.sha256()
   359	    with open(path, "rb") as fh:
   360	        for chunk in iter(lambda: fh.read(65536), b""):
   361	            h.update(chunk)
   362	    return h.hexdigest()
