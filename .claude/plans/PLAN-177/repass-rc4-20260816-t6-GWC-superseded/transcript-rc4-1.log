   212	def parse_verdict_text(text: str) -> Dict[str, Any]:
   213	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   214	    m = _YAML_BLOCK_RE.search(text)
   215	    if not m:
   216	        raise ValueError("verdict file missing yaml frontmatter block")
   217	    yaml_body = m.group(1)
   218	    # Inline minimal YAML parse (stdlib only)
   219	    out: Dict[str, Any] = {}
   220	    current_key: Optional[str] = None
   221	    for raw in yaml_body.splitlines():
   222	        line = _strip_comment(raw)
   223	        if not line.strip():
   224	            continue
   225	        if line[0] not in (" ", "\t"):
   226	            if ":" in line:
   227	                k, _, v = line.partition(":")
   228	                # ASCII-only value trim (t5 P1): a Unicode strip() would
   229	                # normalize `GO<U+00A0>` into the exact authorizing token.
   230	                v = v.strip(" \t")
   231	                if v:
   232	                    out[k.strip(" \t")] = v
   233	                else:
   234	                    out[k.strip(" \t")] = {}
   235	                    current_key = k.strip(" \t")
   236	        elif current_key and ":" in line:
   237	            sub_k, _, sub_v = line.partition(":")
   238	            if isinstance(out[current_key], dict):
   239	                out[current_key][sub_k.strip(" \t")] = sub_v.strip(" \t")
   240	    return out
