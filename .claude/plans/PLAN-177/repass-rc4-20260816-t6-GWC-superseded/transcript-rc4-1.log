   149	    """Top-level lines of the yaml block that are not canonical declarations.
   150	
   151	    Byte-for-byte twin of `_noncanonical_top_level_lines` in
   152	    `.claude/scripts/local/_release_tag_guard.py` (separate processes on
   153	    separate machines; neither may import the other — keep them identical).
   154	    Empty list == the block speaks the grammar both readers assume.
   155	    """
   156	    m = _YAML_BLOCK_RE.search(text)
   157	    if not m:
   158	        return []
   159	    bad: List[str] = []
   160	    prev_scalar_decl = False
   161	    for raw in m.group(1).splitlines():
   162	        line = _strip_comment(raw)
   163	        if not line.strip():
   164	            continue
   165	        if line[0] in (" ", "\t"):
   166	            # Sub-level line. Legitimate ONLY under a parent declared as a
   167	            # bare `key:` (mapping/list). After a SCALAR `key: value`, an
   168	            # indented non-comment line is a YAML CONTINUATION that changes
   169	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   170	            # while this minimal reader still saw `GO` — reject fail-closed
   171	            # (re-pass rc.4 t2 P1).
   172	            if prev_scalar_decl:
   173	                bad.append(line)
   174	            continue
   175	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   176	            _key, _, _val = line.partition(":")
   177	            prev_scalar_decl = bool(_val.strip())
   178	            continue
   179	        if line.startswith("- "):  # top-level list item
   180	            prev_scalar_decl = False
   181	            continue
   182	        bad.append(line)
   183	        prev_scalar_decl = False
   184	    return bad
