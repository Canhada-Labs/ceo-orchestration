     1	#!/usr/bin/env bash
     2	# scripts/tests/test_install_state_replay.sh
     3	# PLAN-153 Wave B items B1+B2 — install-state persistence + upgrade replay.
     4	#
     5	# Exercises:
     6	#   B1-a  fresh install writes .claude/.install-state.json (schema v1):
     7	#         verbatim argv, parsed flags, resolved placeholder map (incl.
     8	#         quote/backslash round-trip), non-empty operations journal
     9	#   B1-b  re-run updates in place: run_count increments, first_recorded_at
    10	#         preserved, history grows, file stays valid JSON (atomic write)
    11	#   B1-c  --dry-run never creates the state file ("no files modified")
    12	#   B2-a  upgrade with NO flags replays the recorded --profile (core-only
    13	#         install does NOT grow a frontend tree); state (re)written by
    14	#         upgrade.sh with last_upgrade.replay_source == "replay" and the
    15	#         ORIGINAL install request (placeholders/argv/ceremony) preserved
    16	#   B2-b  explicit --profile beats the replayed value and is re-recorded
    17	#   B2-c  BACK-COMPAT (debate C must-fix): state file DELETED (pre-Wave-B
    18	#         population) => upgrade rc=0, NOT a no-op (backup + refresh ran),
    19	#         fallback NOTE emitted, state file ACQUIRED post-upgrade
    20	#   B2-d  garbage state file => rc=0, invalid-state NOTE, fallback, state
    21	#         rewritten valid
    22	#   B2-e  hostile-but-valid-JSON state (shell metacharacters in profile)
    23	#         => charset validation rejects, NO replay, rc=0
    24	#   B2-f  --dry-run upgrade resolves replay for the preview but does NOT
    25	#         modify the state file; --no-replay disables replay entirely
