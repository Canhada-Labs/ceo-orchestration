  2252	    manifest = json.loads(
  2253	        (GOVERNANCE / "codex-cli-pin-manifest.json").read_text(encoding="utf-8")
  2254	    )
  2255	    triple = sorted(manifest["payloads"])[0]
  2256	    return {
  2257	        "codex_cli": min_v,
  2258	        "codex_target_triple": triple,
