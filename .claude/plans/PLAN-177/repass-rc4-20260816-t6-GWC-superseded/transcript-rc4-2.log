     1	#!/bin/bash
     2	# Unit-shell controls for the .gitignore delivery helpers (re-pass rc.4 t2
     3	# P1 #1 + #3). Sources scripts/_framework_manifest_set.sh directly — no
     4	# install, milliseconds (pattern: test-ownership-verdict-unit.sh).
     5	#
     6	#   S1  .claude/.gitignore SYMLINK to a writable file -> apply REFUSES (rc 1)
     7	#       and the external target is byte-identical after the call
     8	#   S2  DANGLING symlink -> apply REFUSES; the dangling target is NOT created
     9	#   S3  seeded file (/cache/ only) -> preview says "would APPEND"; real apply
    10	#       appends both entries (dry-run twin honesty — the seeded regression)
    11	#   S4  absent file -> preview says "would CREATE"
    12	#   S5  complete file -> preview says "would PRESERVE"
    13	#   S6  root .gitignore SYMLINK -> mcp-secrets helper REFUSES (rc 1)
    14	set -uo pipefail
    15	HERE="$(cd "$(dirname "$0")" && pwd)"
    16	# shellcheck source=/dev/null
    17	. "$HERE/../_framework_manifest_set.sh"
    18	
    19	FAILS=0
    20	_t() { # name rc_expected rc_actual
    21	  if [ "$2" = "$3" ]; then echo "PASS: $1"; else echo "FAIL: $1 (rc esperado $2, veio $3)"; FAILS=$((FAILS + 1)); fi
    22	}
    23	
    24	TMP="$(mktemp -d "${TMPDIR:-/tmp}/gitignore-unit.XXXXXX")"
    25	trap 'rm -rf "$TMP"' EXIT
    26	
    27	# --- S1: symlink para arquivo externo gravável ---
    28	mkdir -p "$TMP/s1/.claude"
    29	echo "external content" > "$TMP/s1/external.txt"
    30	ln -s "$TMP/s1/external.txt" "$TMP/s1/.claude/.gitignore"
    31	_before="$(cat "$TMP/s1/external.txt")"
    32	_apply_claude_dir_gitignore "$TMP/s1/.claude" >/dev/null 2>&1; rc=$?
    33	_t "S1 apply recusa symlink" 1 "$rc"
    34	_after="$(cat "$TMP/s1/external.txt")"
    35	[ "$_before" = "$_after" ] && echo "PASS: S1 target externo intocado" \
    36	  || { echo "FAIL: S1 target externo MODIFICADO"; FAILS=$((FAILS + 1)); }
    37	
    38	# --- S2: symlink dangling ---
    39	mkdir -p "$TMP/s2/.claude"
    40	ln -s "$TMP/s2/nonexistent-target" "$TMP/s2/.claude/.gitignore"
    41	_apply_claude_dir_gitignore "$TMP/s2/.claude" >/dev/null 2>&1; rc=$?
    42	_t "S2 apply recusa symlink dangling" 1 "$rc"
    43	[ ! -e "$TMP/s2/nonexistent-target" ] && echo "PASS: S2 target dangling NAO criado" \
    44	  || { echo "FAIL: S2 target dangling foi CRIADO"; FAILS=$((FAILS + 1)); }
    45	
    46	# --- S3: seeded (/cache/ only) — preview APPEND + apply apenda de verdade ---
    47	mkdir -p "$TMP/s3/.claude"
    48	printf '/cache/\n' > "$TMP/s3/.claude/.gitignore"
    49	out="$(_preview_claude_dir_gitignore "$TMP/s3/.claude")"; rc=$?
    50	_t "S3 preview rc" 0 "$rc"
    51	case "$out" in
    52	  *"would APPEND"*) echo "PASS: S3 preview diz would APPEND" ;;
    53	  *) echo "FAIL: S3 preview nao disse would APPEND: $out"; FAILS=$((FAILS + 1)) ;;
    54	esac
    55	_apply_claude_dir_gitignore "$TMP/s3/.claude" >/dev/null 2>&1; rc=$?
    56	_t "S3 apply rc" 0 "$rc"
    57	grep -Fxq "/state/" "$TMP/s3/.claude/.gitignore" \
    58	  && grep -Fxq "/settings.local.json" "$TMP/s3/.claude/.gitignore" \
    59	  && grep -Fxq "/cache/" "$TMP/s3/.claude/.gitignore" \
    60	  && echo "PASS: S3 apply apendou preservando o seed" \
    61	  || { echo "FAIL: S3 apply nao entregou as entries"; FAILS=$((FAILS + 1)); }
    62	
    63	# --- S4: ausente — preview CREATE ---
    64	mkdir -p "$TMP/s4/.claude"
    65	out="$(_preview_claude_dir_gitignore "$TMP/s4/.claude")"; rc=$?
    66	_t "S4 preview rc" 0 "$rc"
    67	case "$out" in
    68	  *"would CREATE"*) echo "PASS: S4 preview diz would CREATE" ;;
    69	  *) echo "FAIL: S4 preview nao disse would CREATE: $out"; FAILS=$((FAILS + 1)) ;;
    70	esac
    71	[ ! -e "$TMP/s4/.claude/.gitignore" ] && echo "PASS: S4 preview nao escreveu nada" \
    72	  || { echo "FAIL: S4 preview ESCREVEU"; FAILS=$((FAILS + 1)); }
    73	
    74	# --- S5: completo — preview PRESERVE ---
    75	mkdir -p "$TMP/s5/.claude"
    76	_claude_dir_gitignore_body > "$TMP/s5/.claude/.gitignore"
    77	out="$(_preview_claude_dir_gitignore "$TMP/s5/.claude")"; rc=$?
    78	_t "S5 preview rc" 0 "$rc"
    79	case "$out" in
    80	  *"would PRESERVE"*) echo "PASS: S5 preview diz would PRESERVE" ;;
    81	  *) echo "FAIL: S5 preview nao disse would PRESERVE: $out"; FAILS=$((FAILS + 1)) ;;
    82	esac
    83	
    84	# --- S6: root .gitignore symlink — helper mcp recusa ---
    85	mkdir -p "$TMP/s6"
    86	echo "external root" > "$TMP/s6/external-root.txt"
    87	ln -s "$TMP/s6/external-root.txt" "$TMP/s6/.gitignore"
    88	_apply_mcp_secrets_ignore "$TMP/s6/.gitignore" >/dev/null 2>&1; rc=$?
    89	_t "S6 root helper recusa symlink" 1 "$rc"
    90	_after="$(cat "$TMP/s6/external-root.txt")"
    91	[ "$_after" = "external root" ] && echo "PASS: S6 root target intocado" \
    92	  || { echo "FAIL: S6 root target modificado"; FAILS=$((FAILS + 1)); }
    93	
    94	# --- S7: posture writer (3o writer do root) recusa symlink ---
    95	mkdir -p "$TMP/s7"
    96	echo "external root 7" > "$TMP/s7/external-root.txt"
    97	ln -s "$TMP/s7/external-root.txt" "$TMP/s7/.gitignore"
    98	_apply_posture_state_ignores "$TMP/s7/.gitignore" >/dev/null 2>&1; rc=$?
    99	_t "S7 posture writer recusa symlink" 1 "$rc"
   100	_after="$(cat "$TMP/s7/external-root.txt")"
   101	[ "$_after" = "external root 7" ] && echo "PASS: S7 target intocado" \
   102	  || { echo "FAIL: S7 target modificado"; FAILS=$((FAILS + 1)); }
   103	
   104	# --- S8: predicado compartilhado de preview ---
   105	_root_gitignore_symlink_guard "$TMP/s7/.gitignore" >/dev/null 2>&1; rc=$?
   106	_t "S8 preview guard detecta symlink" 1 "$rc"
   107	mkdir -p "$TMP/s8"; printf 'x\n' > "$TMP/s8/.gitignore"
   108	_root_gitignore_symlink_guard "$TMP/s8/.gitignore" >/dev/null 2>&1; rc=$?
   109	_t "S8 preview guard passa arquivo regular" 0 "$rc"
   110	
   111	echo
   112	if [ "$FAILS" -eq 0 ]; then echo "ALL GREEN"; exit 0; else echo "$FAILS FAIL(s)"; exit 1; fi

