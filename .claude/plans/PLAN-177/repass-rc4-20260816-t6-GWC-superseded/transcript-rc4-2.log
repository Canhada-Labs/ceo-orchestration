    37	# while they still live in a plan-staging mirror (PLAN-153 discipline).
    38	# NOTE: an override must point INTO a full framework checkout — install.sh /
    39	# upgrade.sh derive their source tree from their own resolved location.
    40	INSTALL="${CEO_INSTALL_UNDER_TEST:-$SOURCE_DIR/scripts/install.sh}"
