  1997	
  1998	# --------------------------------------------------------------------------
  1999	# The npm signature recipe has to audit the thing the reader just installed
  2000	#
  2001	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2002	# no package-selecting positional (a trailing package name is ignored), and it
  2003	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2004	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2005	# with `npm audit signatures` verified nothing the reader had just installed —
  2006	# it audited whatever directory they happened to be standing in, and could
  2007	# return a confident green having examined a different tree entirely.
  2008	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2009	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2010	# project install followed by a BARE `npm audit signatures`.
  2011	# --------------------------------------------------------------------------
  2012	
  2013	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2014	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2015	# (ephemeral — nothing is left in a dependency tree to audit).
  2016	_UNAUDITABLE_INSTALL = re.compile(
  2017	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2018	)
  2019	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2020	# the reader believes it selected a package. `#` is excluded so the honest
  2021	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2022	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2023	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2024	_AUDIT_GLOBAL_FLAG = re.compile(
  2025	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2160	# server-side validator, release-gate went green, and only the Owner running
  2161	# OWNER-GA-CUT.sh stood between a negative review and an irreversible publish.
  2162	#
  2163	# CF-3 asymmetry, restated here because it decides what each control PROVES:
  2164	# step 15 carries continue-on-error under CEO_PAIR_RAIL_VERDICT_OPTIONAL=1, so
  2165	# the validator control is a UNIT control over defence in depth; the control
  2166	# that stands for enforcement in every mode is the tag-guard one below.
  2167	_VALIDATOR_INPUTS_HASH_CACHE = {}
  2168	
  2169	# Anchors on the DIAGNOSTIC, not just the exit code: a gate that fires for the
  2170	# wrong reason is a dead probe wearing a green badge (S-lesson: a control that
  2171	# cannot fail proves nothing).
  2172	_ACCEPTED_SET_TEXT = "{GO, GO-WITH-CONDITIONS}"
  2173	_DECISION_REFUSED = "not in " + _ACCEPTED_SET_TEXT
  2174	_CI_DUPLICATE_DIAGNOSTIC = "verdict decision declared more than once"
  2175	_GUARD_DUPLICATE_DIAGNOSTIC = "declares the decision"
  2176	
  2177	# Value-shaped refusals. `GO | NO-GO | GO-WITH-CONDITIONS` is the LITERAL of
  2178	# pair-rail-verdict-template.md:13 -- an envelope copied from the template
  2179	# without filling the field in.
  2180	_REFUSED_DECISIONS = [
  2181	    ["NO-GO"],
  2182	    [],
  2183	    ["MAYBE"],
  2184	    [""],
  2185	    ["go"],
  2186	    ["no-go"],
  2187	    ["GO WITH CONDITIONS"],
  2188	    ["GO | NO-GO | GO-WITH-CONDITIONS"],
  2189	    # Re-pass rc.4 t3 P1: `#` WITHOUT preceding whitespace is NOT a YAML
  2190	    # comment — these are single unknown values, not GO + comment.
  2191	    ["GO#NO-GO"],
  2192	    ["GO-WITH-CONDITIONS#NO-GO"],
  2193	    # Re-pass rc.4 t5 P1: Unicode whitespace must stay attached to the
  2194	    # VALUE — `GO<U+00A0>` is not the exact authorizing token.
  2195	    ["GO\u00a0"],
  2196	    ["\u00a0GO"],
  2197	    ["GO-WITH-CONDITIONS\u00a0"],
  2198	]
  2199	_REFUSED_IDS = [
  2200	    "no-go", "absent", "unknown", "empty", "lowercase", "lower-no-go",
  2201	    "spaced", "template-literal",
  2202	    "hash-glued-no-go", "hash-glued-gwc",
  2203	    "trailing-nbsp", "leading-nbsp", "gwc-trailing-nbsp",
  2204	]
