  1255	def test_driver_derives_every_version_string_from_target_base():
  1256	    """Zero stale literals — and deliberately NO coupling to the repo's current
  1257	    VERSION file. Pinning the driver to VERSION would go red in the one window
  1258	    where the driver MUST be ahead of it: the moment TARGET_BASE is set for the
  1259	    next release and `bump` has not run yet. A gate that blocks the documented
  1260	    path is the failure mode this plan exists to close, not a new instance."""
  1261	    text = DRIVER_SRC.read_text(encoding="utf-8")
  1262	    m = re.search(r'(?m)^TARGET_BASE="(\d+\.\d+\.\d+)"$', text)
  1263	    assert m, "TARGET_BASE is not a bare-semver assignment"
  1264	    target = m.group(1)
  1265	    offenders = []
  1266	    for num, line in enumerate(text.splitlines(), 1):
  1267	        if line.strip() == 'TARGET_BASE="%s"' % target:
  1268	            continue
  1269	        for hit in SEMVER_RX.findall(line):
  1270	            # tolerated: a reference to a PAST incident. It is a historical
  1271	            # fact and cannot be derived from TARGET_BASE.
  1272	            if re.search(r"v%s-rc\.\d+" % re.escape(hit), line):
  1273	                continue
  1274	            offenders.append("%d: %s" % (num, line.strip()))
  1275	    assert not offenders, "version literals not derived from TARGET_BASE:\n%s" % (
  1276	        "\n".join(offenders)
  1277	    )
