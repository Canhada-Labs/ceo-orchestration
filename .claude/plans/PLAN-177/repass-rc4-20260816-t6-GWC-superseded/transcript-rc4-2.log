   404	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   405	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   406	    verdict_abs = os.path.join(repo, verdict_rel)
   407	    if not os.path.isfile(verdict_abs):
   408	        return _fail(
   409	            E_VERDICT,
   410	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   411	            "be committed before the tag is cut (release.yml validates it per "
   412	            "tag on the tagged tree)." % verdict_rel,
   413	        )
   414	    with open(verdict_abs, encoding="utf-8") as fh:
   415	        verdict_text = fh.read()
   416	    # PLAN-177 t2 (P1-a): SHAPE BEFORE ANY FIELD. Both rails read this file;
   417	    # they only agree on a canonical block. A non-canonical top-level line is
   418	    # refused here rather than handed to two different grammars — E_DECISION
   419	    # because the class this closes is the decision override (`verdict :
   420	    # NO-GO` + `verdict: GO`), and because a refusal that names the decision
   421	    # rail is the one an operator can act on.
   422	    noncanonical = _noncanonical_top_level_lines(verdict_text)
   423	    if noncanonical:
   424	        return _fail(
   425	            E_DECISION,
   426	            "verdict %s: non-canonical top-level key syntax %r -- a "
   427	            "top-level line must be\n"
   428	            "      `name:` with no whitespace before the colon (or a `- ` "
   429	            "list item). The two release rails read this\n"
   430	            "      file with different grammars, so `verdict : NO-GO` "
   431	            "followed by `verdict: GO` counts as two\n"
   432	            "      declarations server-side and one here; the shape is "
   433	            "refused instead of guessed."
   434	            % (verdict_rel, noncanonical),
   435	        )
   436	    fields = _parse_verdict(verdict_text)
   437	
   438	    release_tag = fields.get("release_tag")
   439	    if release_tag != tag:
   440	        return _fail(
   441	            E_VERDICT,
   442	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   443	            "to judge this tag against another tag's verdict."
   444	            % (verdict_rel, release_tag, tag),
   445	        )
   446	    # PLAN-177 W0.1 (P1-4) -- the DECISION gate.
   447	    #
   448	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on): the
   449	    # server-side twin (.github/scripts/validate-pair-rail-verdict.py, step
   450	    # 15) carries `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   451	    # (release.yml:689) -- there the decision check is defence in depth.
   452	    # THIS is the rail that enforces in every mode: release.sh calls it with
   453	    # `|| die`, and the release.yml step that calls it carries no escape
   454	    # hatch. Neither may be dropped for the other.
   455	    #
   456	    # Fail-CLOSED on SHAPE as well as value (CF-1): _parse_verdict returns a
   457	    # LIST for an empty `verdict:` line, so the type check precedes the
   458	    # compare -- a malformed decision is a named refusal, never a crash.
   459	    declared_decisions = _count_top_level_key(verdict_text, "verdict")
   460	    if declared_decisions > 1:
   461	        return _fail(
   462	            E_DECISION,
   463	            "verdict %s declares the decision %d times -- this reader "
   464	            "is last-wins, so a duplicated\n"
   465	            "      `verdict:` silently overrides the first; exactly one "
   466	            "is required."
   467	            % (verdict_rel, declared_decisions),
   468	        )
   469	    decision = fields.get("verdict")
   470	    if decision is None:
   471	        shown = "<absent>"
   472	    elif not isinstance(decision, str):
   473	        shown = "<non-string:%s>" % type(decision).__name__
   474	    else:
   475	        # ASCII-only trim (t5 P1) — twin of the server validator.
   476	        shown = decision.strip(" \t")
   477	    if shown not in ACCEPTED_DECISIONS:
   478	        return _fail(
   479	            E_DECISION,
   480	            "verdict %s: decision '%s' not in {%s} -- a tag may only be "
   481	            "cut on an authorizing decision.\n"
   482	            "      Everything the checks below assert (anchor, closed "
   483	            "allowlist, manifest content) is about WHICH TREE the\n"
   484	            "      re-pass saw; this one is about what the re-pass SAID "
   485	            "about it. A NO-GO over a perfect delta is still a NO-GO."
   486	            % (verdict_rel, shown, ", ".join(ACCEPTED_DECISIONS)),
   487	        )
   488	    parent = fields.get("parent_sha")
   489	    if not isinstance(parent, str) or not HEX40.match(parent):
   490	        return _fail(
   491	            E_VERDICT,
   492	            "verdict %s has no usable 40-hex `parent_sha:` — that field IS "
   493	            "the review anchor." % verdict_rel,
   494	        )
   495	    rc, _out, _err = _git(repo, "cat-file", "-e", parent + "^{commit}")
   496	    if rc != 0:
   497	        return _fail(
   498	            E_VERDICT,
   499	            "parent_sha %s from %s is not a commit in this repo."
   500	            % (parent, verdict_rel),
   501	        )
   502	    # Existence is not lineage. A fabricated anchor (`git commit-tree` over
   503	    # HEAD's own tree, parented anywhere, on no branch) passes `cat-file -e`
   504	    # and makes diff(parent..HEAD) contain ONLY the verdict + evidence while
   505	    # unreviewed work sits on main — every check below then passes and the
   506	    # guard prints approval over a tree the re-pass never saw. The anchor has
   507	    # to be a commit HEAD actually descends from. (The staged W1 server-side
   508	    # port asserts the same against origin/main — keep the two in sync.)
   509	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", parent, "HEAD")
   510	    if rc == 1:
   511	        return _fail(
   512	            E_PARENT_NOT_ANCESTOR,
   513	            "parent_sha %s from %s is not an ancestor of HEAD — the review "
   514	            "anchor is not in\n"
   515	            "      the history this tag would sign. `cat-file -e` proves the "
   516	            "object exists, not\n"
   517	            "      that main descends from it; a fabricated commit carrying "
   518	            "HEAD's own tree\n"
   519	            "      makes the delta below trivially clean while unreviewed "
   520	            "work rides the tag."
   521	            % (parent[:12], verdict_rel),
   522	        )
   523	    if rc != 0:
   524	        return _fail(
   525	            E_PARENT_NOT_ANCESTOR,
   526	            "`git merge-base --is-ancestor %s HEAD` exited %d (neither yes "
   527	            "nor no) — refusing to guess (git said: %s)"
   528	            % (parent[:12], rc, err.strip()),
   529	        )
   530	    print("  ok   parent_sha %s is an ancestor of HEAD" % parent[:12])
   531	
   532	    allow = fields.get("delta_allowlist")
   533	    if not isinstance(allow, list) or not allow:
   534	        return _fail(
   535	            E_VERDICT,
   536	            "verdict %s carries no `delta_allowlist:` entries — the closed "
   537	            "set is what makes the delta assert meaningful." % verdict_rel,
   538	        )
   539	    for entry in allow:
   540	        if any(ch in entry for ch in GLOB_CHARS):
   230	      # behind VERSION than its tier allows (security docs N=1; general N=3).
   231	      # Missing/malformed stamp fails-CLOSED. Closes F-D4.
   232	      #
   233	      # Emergency bypass: the checker self-reads an Owner-signed
   234	      # `doc_freshness:` entry (matching this release version) in
   235	      # `.claude/governance/governance-waivers.yaml` and, when present,
   236	      # passes WITH a surfaced ::warning (never a silent skip).
   237	      # -----------------------------------------------------------------
   238	      - name: Canonical doc freshness gate
   239	        run: |
   240	          set -euo pipefail
   241	          python3 .claude/scripts/check-canonical-doc-freshness.py
   242	
   243	      # -----------------------------------------------------------------
   244	      # PLAN-013 Phase 0 item 0.3 — mandatory RC-to-GA hold enforcement.
   245	      # AMENDED 2026-05-03 per ADR-103: 7-day calendar gate REDUCED to
   246	      # 24h Codex re-pass mechanical window per ADR-095 §gate-#6.
   247	      #
   248	      # Debate Round 1 consensus §S3 HIGH (DevOps): "7-day RC hold is
   249	      # policy not mechanism. Policy without mechanism is hope."
   250	      #
   251	      # Rule: a GA tag `v1.x.y` MAY only ship after its corresponding
   252	      # RC tag `v1.x.y-rc.N` has existed for ≥24 hours. The 24h window
   253	      # is mechanical: bounds the maximum Codex external re-pass
   254	      # turnaround (anti same-LLM bias per ADR-095 §gate-#6). NOT a
   255	      # "settle period" — vibecoder-only thesis (ADR-096) means no
   256	      # external adopter pressure for calendar buffers.
   257	      #
   258	      # Mechanism:
   259	      #   1. If tag contains `-rc.` → skip check (RC tags always pass)
   260	      #   2. Else find most recent `v<VERSION>-rc.*` tag (by creator date)
   261	      #   3. If none exists → fail (mandatory RC before GA)
   262	      #   4. Else compute delta; reject if < 24h (86400 seconds)
   263	      # -----------------------------------------------------------------
   264	      - name: Assert 24h Codex re-pass window (GA tags only, waiver-aware)
   265	        run: |
   266	          set -euo pipefail
   267	          TAG="${GITHUB_REF_NAME}"
   268	          VERSION="${TAG#v}"
   269	
   270	          # RC tags short-circuit — they are always permitted.
   271	          if [[ "$TAG" == *-rc.* ]]; then
   272	            echo "::notice::$TAG is an RC tag — skipping 24h hold check"
   273	            exit 0
   274	          fi
   275	
   276	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment).
   277	          # During initial framework development with adopter_count=0,
   278	          # the RC-hold window can be waived per Owner authorization
   279	          # recorded in .claude/governance/rc-hold-waivers.yaml. The
   280	          # waiver is additive: post-first-adopter, the file is expected
   281	          # to be empty and ADR-007 default resumes. Each waiver entry
   282	          # cites Owner directive + round-NN sentinel commit.
   283	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   284	          if [[ -f "$WAIVER_FILE" ]]; then
   285	            if awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   286	              echo "::notice::$TAG has a pre-GA RC-hold waiver in $WAIVER_FILE — skipping hold check"
   287	              exit 0
   288	            fi
   289	          fi
   290	
   291	          # Find the most-recent RC tag for this version, by creator date.
   292	          # `git tag -l --sort=-creatordate` handles both lightweight and
   293	          # annotated tags uniformly via the dereferenced date.
   294	          LAST_RC=$(git tag -l --sort=-creatordate "v${VERSION}-rc.*" | head -1)
   295	
   296	          if [[ -z "$LAST_RC" ]]; then
   297	            echo "::error::GA tag $TAG has no prior v${VERSION}-rc.* tag"
   298	            echo "::error::Mandatory RC-hold requires a prior RC tag"
   299	            echo "::error::Cut v${VERSION}-rc.1 first; wait 24h (Codex re-pass turnaround); then cut $TAG"
   300	            exit 1
   301	          fi
   302	
   303	          # Creator-date gives a unix-epoch timestamp for both
   304	          # annotated (tagger date) and lightweight (committer date) tags.
   305	          RC_TS=$(git tag -l --format='%(creatordate:unix)' "$LAST_RC")
   306	          GA_TS=$(git tag -l --format='%(creatordate:unix)' "$TAG")
   307	
   308	          if [[ -z "$RC_TS" || -z "$GA_TS" ]]; then
   309	            echo "::error::Could not read creator-date for $LAST_RC or $TAG"
   310	            exit 1
   311	          fi
   312	
   313	          DELTA=$((GA_TS - RC_TS))
   314	          ONE_DAY=$((1 * 86400))
   315	          HOURS=$((DELTA / 3600))
   316	
   317	          if [[ "$DELTA" -lt "$ONE_DAY" ]]; then
   318	            echo "::error::GA tag $TAG is only $HOURS hours after $LAST_RC"
   319	            echo "::error::Mandatory 24h Codex re-pass window not met (delta=${DELTA}s < 86400s)"
   320	            echo "::error::Wait $((24 - HOURS)) more hours OR run Codex re-pass synchronously and add waiver"
   321	            exit 1
   322	          fi
   323	
   324	          echo "OK: $TAG is $HOURS hours after $LAST_RC (≥24h Codex re-pass window per ADR-103)"
   325	
   326	      - name: Assert CHANGELOG entry exists
   327	        run: |
   328	          set -euo pipefail
   329	          TAG="${GITHUB_REF_NAME}"
   330	          VERSION="${TAG#v}"
   331	          # PLAN-153 Wave B item 5 (c) — same RC normalization as the
   332	          # "Assert VERSION matches tag" step above: RC tags never get
   333	          # their own CHANGELOG section; an RC for X.Y.Z validates
   334	          # against the GA `## [X.Y.Z]` section (which exists at RC-cut
   335	          # time because the VERSION bump + CHANGELOG entry land before
   336	          # the RC is tagged). Without this strip the fixed VERSION gate
   337	          # would just move the RC red run one step later.
   338	          VERSION="${VERSION%-rc.[0-9]*}"
   339	          if ! grep -qE "^## \[${VERSION}\]" CHANGELOG.md; then
   340	            echo "::error::CHANGELOG.md has no '## [${VERSION}]' section"
   341	            exit 1
   342	          fi
   343	          echo "OK: CHANGELOG has entry for [$VERSION]"
   344	
   345	      - name: Registry validation (must be clean)
   346	        run: python3 .claude/scripts/registry.py --validate
   347	
   348	      - name: Governance structural validation
   349	        run: bash .claude/scripts/validate-governance.sh
   350	
   351	      - name: Install test deps (CI-only, not shipped)
   352	        # Post-tag-v1.6.0-rc.1 hardening (Session 33 CI batch): Hook +
   353	        # Script test suites need pytest (4 script tests + several hook
   354	        # tests use pytest.fixture / tmp_path / capsys / pytest.raises)
   355	        # and pyyaml (benchmark loader). These are dev-only deps — never
   356	        # shipped in install.sh / upgrade.sh tarballs. Mirrors coverage.yml
   357	        # install step.
   358	        run: python3 -m pip install --quiet --no-cache-dir "pyyaml" "pytest==8.*"
   359	
   360	      - name: Hook test suite (all 168+ tests)
   361	        # pytest discovers both unittest.TestCase and pure-pytest tests.
   362	        run: python3 -m pytest .claude/hooks/tests -q --tb=short
   363	
   364	      - name: Script test suite (all 132+ tests)
   365	        run: python3 -m pytest .claude/scripts/tests -q --tb=short
   366	
   367	      - name: Replay test suite (PLAN-069 Phase 1 / ADR-101)
   368	        # 89+ tests covering replay-as-fixture mode, PII redaction, HMAC
   369	        # salt rebind, post-load defense-in-depth. Already wired via
   370	        # pytest.ini testpaths but invoked explicitly here for the tag
   371	        # release gate (Codex Session 81 P2#4 close).
   372	        run: python3 -m pytest .claude/scripts/replay/tests -q --tb=short
   373	
   374	      - name: Smoke install on scratch directory
   375	        run: |
   376	          set -euo pipefail
   377	          SCRATCH="$(mktemp -d -t ceo-smoke-XXXXXX)"
   378	          mkdir -p "$SCRATCH/target"
   379	          cd "$SCRATCH/target" && git init -q && cd - >/dev/null
   380	          bash scripts/install.sh "$SCRATCH/target" --profile core,frontend
   381	          # Essential files present?
   382	          test -f "$SCRATCH/target/.claude/team.md" || { echo "::error::team.md missing"; exit 1; }
   383	          test -f "$SCRATCH/target/.claude/settings.json" || { echo "::error::settings.json missing"; exit 1; }
   384	          test -d "$SCRATCH/target/.claude/skills/core" || { echo "::error::core skills missing"; exit 1; }
   385	          # Placeholders leaked?
   386	          if grep -rq "{{OWNER_NAME}}\|{{PROJECT_NAME}}" "$SCRATCH/target/.claude/hooks/" 2>/dev/null; then
   387	            echo "::error::unrendered placeholders leaked into hooks"
   388	            exit 1
   389	          fi
   390	          python3 -c "import json; json.load(open('$SCRATCH/target/.claude/settings.json'))"
     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# release.sh — operator release driver. Version-neutral BY NAME.
     4	#
     5	# The previous driver carried a release number in its own FILENAME, and was
     6	# still driving the release after that one — the root of a whole class: a
     7	# driver named for one release is a standing invitation for every other version
     8	# literal inside it to go stale too. Everything release-specific now lives in
     9	# the PER-RELEASE block below, and every message derives from it. The old path
    10	# is deliberately left unspelled on every live surface, so the AC-6 control
    11	# needs no "except this one" exemption; `git log --follow` is the archaeology.
    12	#
    13	# Implements the documented procedure in `.github/release-checklist.md`:
    14	# RC first (vX.Y.Z-rc.N), then the ADR-103 24 h hold, then promote stable.
    15	#
    16	# WHAT THE OWNER SIGNS. Nothing here is a canonical-edit ceremony: CHANGELOG.md,
    17	# VERSION and npm/package.json are NOT in `_CANONICAL_GUARDS`
    18	# (`.claude/hooks/check_canonical_edit.py`), so no sentinel `approved.md`
    19	# exists for a release. The Owner signature is the **annotated GPG tag**,
    20	# produced INLINE by the `tag` phase (family lesson: a ceremony script signs
    21	# inline and never demands a pre-existing `.asc`).
    22	#
    23	# WHAT THIS SCRIPT NEVER DOES. It never pushes, and it never publishes.
    24	# Pushing the tag is the irreversible, outward-facing step: it starts BOTH
    25	# `.github/workflows/release.yml` (the release gate) and
    26	# `.github/workflows/npm-publish.yml` — and npm-publish.yml is what actually
    27	# publishes to npm via OIDC. This driver prints the push command and stops.
    28	#
    29	# Phases (run in order):
    30	#   preflight  read-only gates, fail-closed          (default)
    31	#   bump       version sites + plugin manifests + commit
    32	#   tag        annotated GPG tag, signed inline, behind two fail-closed guards
    33	#
    34	# Usage:
    35	#   bash .claude/scripts/local/release.sh preflight
    36	#   bash .claude/scripts/local/release.sh bump --dry-run
    37	#   bash .claude/scripts/local/release.sh bump
    38	#   bash .claude/scripts/local/release.sh tag --dry-run
    39	#   bash .claude/scripts/local/release.sh tag
    40	#
    41	# Options:
    42	#   --dry-run        make no lasting change; restores BOTH working tree and
    43	#                    index on exit (trap), including on failure. The restore
    44	#                    list is DERIVED from _release_bump_sites.py, never typed.
    45	#   --stable         target the bare version instead of -rc.N (post-hold promote)
    46	#   --rc N           RC ordinal (default 1)
    47	#   --key KEYID      GPG key to sign with (default: the key of the last release)
    48	#   --today DATE     YYYY-MM-DD stamped into the `last-reviewed:` lines
    49	#                    (default: today). It exists so the D/D+1 idempotence
    50	#                    invariant is testable at the driver level; it changes only
    51	#                    the stamp date and skips no gate.
    52	#   --restamp        force the four `last-reviewed:` stamps to move even when
    53	#                    the version is unchanged — the named route for a REAL
    54	#                    re-review. Requires --npm-readme-reviewed and disables the
    55	#                    no-op fast path (otherwise it would be dead letter).
    56	#   --offline-ack    ancestry guard: skip the `git fetch` and judge HEAD
    57	#                    against the last-known origin/main (announced loudly)
    58	#   --npm-readme-reviewed
    59	#                    required by `bump` when it writes: acknowledges that
    60	#                    npm/README.md was actually re-read. Its `last-reviewed`
    61	#                    stamp is a release tripwire by design; re-stamping it
    62	#                    silently would defeat the gate.
    63	# ============================================================================
    64	set -euo pipefail
    65	
    66	# ---------------------------------------------------------------------------
    67	# PER-RELEASE — the only block that changes between releases. Rewrite all of it
    68	# together. RELEASE_SCOPE and RELEASE_HEADLINE end up inside the SIGNED tag
    69	# annotation, so stale text there is a false claim on a signed surface (the P0
    70	# class of this repo) — and no preflight can prove prose matches a diff.
    71	# The tag stands for the WHOLE release train in CHANGELOG.md, never just the
    72	# newest plan: list every plan of the train and the full ADR range.
    73	# ---------------------------------------------------------------------------
    74	TARGET_BASE="1.3.0"
    75	RELEASE_TITLE="night-mode + release-mechanics hardening"
    76	# repass-r2 part-d P1 (S299): the v1.3.0 train grew past the rc.1 text —
    77	# 167/168 (ownership decision table) and 169 W0-W2 (Linux port + verified
    78	# fixes) landed between rc.1 and rc.2. The tag stands for the WHOLE train.
    79	RELEASE_SCOPE="PLAN-162 / PLAN-165 / PLAN-166 / PLAN-167 / PLAN-168 / PLAN-169 W0-W2 (ADRs 184 -> 190)"
    80	RELEASE_HEADLINE="night-mode — the Owner arms per-machine autonomy for one upcoming
    81	session (gitignored overlay, next-session semantics), and arming it is a
    82	HUMAN action by construction: the writer script self-path-guards, the Bash
    83	rail matches invocation best-effort, and every on/off/refusal lands in the
    84	HMAC chain as night_mode_toggled (proven live, not by fixture).
    85	
    86	Also: a case-fold bypass that let .claude/settings.JSON slip past BOTH the
    87	canonical and kernel rails on case-insensitive filesystems (P0, fixed on
    88	both rails); ADR-186 settles the hook-deadline conflict — the canonical
    89	matcher wall deadline fails CLOSED as a named exception to the published
    90	fail-open-on-infrastructure contract, with a provenance-pinned unlock as the
    91	recovery route; sentinel unlock inside a git worktree now REQUIRES that
    92	provenance (ADR-119 Invariant 5); pair-rail 120/150 -> 180/210 with
    93	timeout_ms and a censoring-rate trigger, ratified only after a live probe
    94	proved the harness honors a 210 s registration; four scheduled workflows that
    95	had been red without ever surfacing in push CI; and the release mechanics
    96	themselves — an idempotent bump, plus an ancestry gate and a restricted-delta
    97	gate on the tag phase (PLAN-166)."
    98	
    99	RC_NUM="1"
   100	STABLE=0
   101	DRY_RUN=0
   102	NPM_README_REVIEWED=0
   103	RESTAMP=0
   104	OFFLINE_ACK=0
   105	TODAY=""
   106	PHASE=""
   107	
   108	BUMP_SITES=".claude/scripts/local/_release_bump_sites.py"
   109	TAG_GUARD=".claude/scripts/local/_release_tag_guard.py"
   110	
   111	# Continuity: the key that signed the previous release. Overridable, but never
   112	# guessed at signing time — the preflight proves it can actually produce a
   113	# signature.
   114	SIGN_KEY="CFCFACF00335DC74"
   115	
   116	die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
   117	ok()  { printf '  ok   %s\n' "$*"; }
   118	note(){ printf '  --   %s\n' "$*"; }
   119	hdr() { printf '\n== %s ==\n' "$*"; }
   120	
   121	usage() {
   122	  cat <<USAGE
   123	release.sh — operator release driver (target base version: $TARGET_BASE)
   124	
   125	  bash $0 preflight [--rc N | --stable]
   126	  bash $0 bump      [--rc N | --stable] --npm-readme-reviewed [--dry-run]
   127	  bash $0 tag       [--rc N | --stable] [--dry-run]
   128	
   129	  --dry-run              no lasting change; tree AND index restored on exit
   130	  --stable               target $TARGET_BASE (post-hold promote)
   131	  --rc N                 target ${TARGET_BASE}-rc.N (default N=$RC_NUM)
   132	  --key KEYID            GPG key (default $SIGN_KEY)
   133	  --today YYYY-MM-DD     date stamped into the last-reviewed lines
   134	  --restamp              move the review stamps at an unchanged version
   135	                         (requires --npm-readme-reviewed)
   136	  --offline-ack          ancestry guard judges a possibly stale origin/main
   137	  --npm-readme-reviewed  assert npm/README.md was actually re-read
   138	
   139	The header of this file documents what the Owner signs, why this script never
   140	pushes, and why it never publishes.
   141	USAGE
   142	}
   143	
   144	while [ "$#" -gt 0 ]; do
   145	  case "$1" in
   146	    preflight|bump|tag) PHASE="$1"; shift ;;
   147	    --dry-run) DRY_RUN=1; shift ;;
