  2154	# ===========================================================================
  2155	# PLAN-177 W0.1 (P1-4) -- the pair-rail DECISION gate
  2156	# ===========================================================================
  2157	# The re-pass of 2026-08-12 found that BOTH release rails read the verdict
  2158	# envelope for pinning, TTL, anchor and delta, and NEITHER read the decision:
  2159	# a cross-model NO-GO returned "OK: verdict ... valid" / exit 0 from the
  2160	# server-side validator, release-gate went green, and only the Owner running
  2161	# OWNER-GA-CUT.sh stood between a negative review and an irreversible publish.
  2162	#
  2163	# CF-3 asymmetry, restated here because it decides what each control PROVES:
  2164	# step 15 carries continue-on-error under CEO_PAIR_RAIL_VERDICT_OPTIONAL=1, so
  2165	# the validator control is a UNIT control over defence in depth; the control
  2166	# that stands for enforcement in every mode is the tag-guard one below.
  2167	_VALIDATOR_INPUTS_HASH_CACHE = {}
  2168	
  2169	# Anchors on the DIAGNOSTIC, not just the exit code: a gate that fires for the
  2170	# wrong reason is a dead probe wearing a green badge (S-lesson: a control that
  2171	# cannot fail proves nothing).
  2172	_ACCEPTED_SET_TEXT = "{GO, GO-WITH-CONDITIONS}"
  2173	_DECISION_REFUSED = "not in " + _ACCEPTED_SET_TEXT
  2174	_CI_DUPLICATE_DIAGNOSTIC = "verdict decision declared more than once"
  2175	_GUARD_DUPLICATE_DIAGNOSTIC = "declares the decision"
  2176	
  2177	# Value-shaped refusals. `GO | NO-GO | GO-WITH-CONDITIONS` is the LITERAL of
  2178	# pair-rail-verdict-template.md:13 -- an envelope copied from the template
  2179	# without filling the field in.
  2180	_REFUSED_DECISIONS = [
  2181	    ["NO-GO"],
  2182	    [],
  2183	    ["MAYBE"],
  2184	    [""],
  2185	    ["go"],
  2186	    ["no-go"],
  2187	    ["GO WITH CONDITIONS"],
  2188	    ["GO | NO-GO | GO-WITH-CONDITIONS"],
  2189	    # Re-pass rc.4 t3 P1: `#` WITHOUT preceding whitespace is NOT a YAML
  2190	    # comment — these are single unknown values, not GO + comment.
  2191	    ["GO#NO-GO"],
  2192	    ["GO-WITH-CONDITIONS#NO-GO"],
  2193	    # Re-pass rc.4 t5 P1: Unicode whitespace must stay attached to the
  2194	    # VALUE — `GO<U+00A0>` is not the exact authorizing token.
  2195	    ["GO\u00a0"],
  2196	    ["\u00a0GO"],
  2197	    ["GO-WITH-CONDITIONS\u00a0"],
  2198	]
