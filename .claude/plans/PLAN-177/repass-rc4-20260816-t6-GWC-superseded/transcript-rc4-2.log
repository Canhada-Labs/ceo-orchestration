   209	# PLAN-153 Wave B item B2 — capture the ORIGINAL upgrade argv verbatim BEFORE
   210	# parsing, for the post-upgrade state record (data only, never eval-ed).
   211	ORIG_UP_ARGV=( "$@" )
   212	
   213	TARGET=""
   214	PROFILE="core,frontend"
   215	STACK="none"
   216	PIN_REF=""
   217	DRY_RUN=0
   218	PURGE_MISINSTALLED=0   # PLAN-161 U3: opt-in hash-gated purge of mis-installed framework-internal files
   219	DIFF_WARN=1
   220	DEPRECATION_WARN=1
   221	SETTINGS_MERGE=1
   222	SETTINGS_MIGRATE=1       # PLAN-163 T5.4: baseline-aware settings migration (opt out: --no-settings-migrate)
   223	SETTINGS_MIGRATE_ONLY=0  # PLAN-163 T5.4: run ONLY the settings migration (test/ops seam)
   224	ON_CONFLICT="refuse"   # PLAN-138 Wave C (ADR-155): {refuse|theirs|backup}; default refuse (OQ2)
   225	REPLAY=1               # PLAN-153 Wave B item B2: replay the recorded install request (opt out: --no-replay)
   226	HARNESS=""             # PLAN-155 Wave 5: "" = infer from recorded request.harness (B2 mirror)
   227	HARNESS_EXPLICIT=0     # explicit --harness always beats a replayed value
   228	CODEX_MANAGED_HOOKS=0  # replayed from request.managed_hooks unless --managed-hooks
   229	# shellcheck disable=SC2034  # CODEX_WITH_SKILLS/CODEX_FORCE consumed by the sourced _codex_harness.sh
   230	CODEX_WITH_SKILLS=0
   231	# shellcheck disable=SC2034
   232	CODEX_FORCE=0          # upgrade derives this from --on-conflict for the codex refresh
   233	PROFILE_EXPLICIT=0      # PLAN-153 B2: explicit --profile always beats a replayed value
   234	STACK_EXPLICIT=0        # PLAN-153 B2: explicit --stack always beats a replayed value
   235	SKIP_GLOBS=()
   236	
   237	while [[ $# -gt 0 ]]; do
   238	  case "$1" in
   239	    --profile)
   240	      PROFILE="${2:-}"
   241	      PROFILE_EXPLICIT=1
   242	      shift 2
   243	      ;;
   244	    --stack)
   245	      STACK="${2:-}"
   246	      STACK_EXPLICIT=1
   247	      shift 2
   248	      ;;
   249	    --pin)
   250	      PIN_REF="${2:-}"
   251	      shift 2
   252	      ;;
   253	    --dry-run)
   254	      DRY_RUN=1
   255	      shift
   256	      ;;
   257	    --ceremony)
   258	      # Re-pass rc.4 t3 (P1): explicit ceremony for PRE-STATE targets
   259	      # (no readable .install-state.json). A RECORDED ceremony always
   260	      # wins over this flag — the flag exists for the migration case.
   261	      CEREMONY_FLAG="${2:-}"
   262	      case "$CEREMONY_FLAG" in
   263	        maintainer|user) : ;;
   264	        *) echo "ERROR: --ceremony must be 'maintainer' or 'user' (got '$CEREMONY_FLAG')" >&2; exit 2 ;;
   265	      esac
   266	      shift 2
   267	      ;;
   268	    --purge-misinstalled)
   269	      # PLAN-161 U3 (OQ1 Owner-ratified): opt-in, hash-gated purge of
   270	      # mis-installed framework-internal excluded-tree files. NEVER default-on.
   271	      PURGE_MISINSTALLED=1
   272	      shift
   273	      ;;
   274	    --no-diff-warn)
   275	      DIFF_WARN=0
   276	      shift
   277	      ;;
   278	    --no-deprecation-warn)
   279	      DEPRECATION_WARN=0
   280	      shift
   281	      ;;
   282	    --no-settings-merge)
   283	      SETTINGS_MERGE=0
   284	      shift
   285	      ;;
   286	    --no-settings-migrate)
   287	      # PLAN-163 T5.4: skip the baseline-aware settings migration.
   288	      SETTINGS_MIGRATE=0
   289	      shift
   290	      ;;
   291	    --settings-migrate-only)
   292	      # PLAN-163 T5.4: run ONLY the settings migration against <target>
   293	      # and exit (test/ops seam; honors --dry-run + --no-settings-migrate).
   294	      SETTINGS_MIGRATE_ONLY=1
   295	      shift
   296	      ;;
   297	    --print-settings-baselines)
   298	      # PLAN-163 T5.4: introspection for oracles — the normative baseline
   299	      # table IS the artifact; tests parse this output (never hardcode).
   300	      printf '%s\n' "$_T54_BASELINES_JSON"
   301	      exit 0
   302	      ;;
   303	    --no-replay)
   304	      # PLAN-153 Wave B item B2: ignore .claude/.install-state.json entirely.
   305	      REPLAY=0
   306	      shift
   307	      ;;
   308	    --harness)
   309	      # PLAN-155 Wave 5: explicit override of the replayed harness.
   310	      HARNESS="${2:-}"
   311	      case "$HARNESS" in
   312	        claude|codex|grok) ;;
   313	        *) echo "ERROR: --harness must be 'claude', 'codex', or 'grok' (got: $HARNESS)" >&2; exit 2 ;;
   314	      esac
   315	      HARNESS_EXPLICIT=1
   316	      shift 2
   317	      ;;
   318	    --managed-hooks)
   319	      CODEX_MANAGED_HOOKS=1
   320	      shift
   321	      ;;
   322	    --skip)
   323	      SKIP_GLOBS+=( "${2:-}" )
   324	      shift 2
   325	      ;;
   326	    --skip=*)
   327	      SKIP_GLOBS+=( "${1#--skip=}" )
   328	      shift
   329	      ;;
   330	    --on-conflict)
   700	      # TAB-separated: profile<TAB>stack<TAB>harness<TAB>managed (PLAN-155 W5).
   701	      IFS=$'\t' read -r _rp_profile _rp_stack _rp_harness _rp_managed <<< "$_rp_line"
   702	      _rp_used=0
   703	      if [[ "$PROFILE_EXPLICIT" -eq 0 && -n "$_rp_profile" ]]; then
   704	        PROFILE="$_rp_profile"
   705	        _rp_used=1
   706	        echo "    REPLAY: --profile $PROFILE (recorded request in .claude/.install-state.json; pass --profile or --no-replay to override)" >&2
   707	      fi
   708	      if [[ "$STACK_EXPLICIT" -eq 0 && -n "$_rp_stack" ]]; then
   709	        STACK="$_rp_stack"
   710	        _rp_used=1
   711	        echo "    REPLAY: --stack $STACK (recorded request in .claude/.install-state.json; pass --stack or --no-replay to override)" >&2
   712	      fi
   713	      if [[ "$HARNESS_EXPLICIT" -eq 0 && -n "$_rp_harness" ]]; then
   714	        HARNESS="$_rp_harness"
   715	        _rp_used=1
   716	        echo "    REPLAY: --harness $HARNESS (recorded request in .claude/.install-state.json; pass --harness or --no-replay to override)" >&2
   717	      fi
   718	      if [[ "$CODEX_MANAGED_HOOKS" -eq 0 && "${_rp_managed:-0}" = "1" ]]; then
   719	        CODEX_MANAGED_HOOKS=1
   720	        _rp_used=1
   721	      fi
   722	      if [[ "$_rp_used" -eq 1 ]]; then
   723	        _REPLAY_SOURCE="replay"
   724	      fi
   725	    else
   726	      _REPLAY_SOURCE="fallback-invalid-state"
   727	      echo "    NOTE: .claude/.install-state.json present but unreadable/invalid — IGNORED." >&2
   728	      echo "          Proceeding with CLI/default flags on the ADR-155 path (baseline" >&2
   729	      echo "          drift-classifier; --dry-run previews). Never blocks (PLAN-153" >&2
   730	      echo "          debate C back-compat must-fix); a valid state file is rewritten" >&2
   731	      echo "          after this upgrade completes." >&2
   732	    fi
   733	  else
   734	    _REPLAY_SOURCE="fallback-no-state"
   735	    echo "    NOTE: no .claude/.install-state.json in target (pre-Wave-B install)." >&2
   736	    echo "          Proceeding with CLI/default flags on the ADR-155 path (baseline" >&2
   737	    echo "          drift-classifier when a manifest exists, else diff -q warn-then-" >&2
   738	    echo "          clobber). A state file is recorded after this upgrade completes." >&2
   739	  fi
   740	fi
   741	
   742	# ===========================================================================
   743	# PLAN-166 F3 (ADR-155-AMEND-1) — resolve the RECORDED install ceremony with
   744	# a reader of its OWN, INDEPENDENT of the replay path: --no-replay sets
   745	# REPLAY=0 and the replay block above (incl. _read_install_state_request) is
   746	# skipped entirely, so if the ceremony rode the replay, the documented
   747	# `upgrade.sh <target> --no-replay` would treat a `--ceremony user` install
   748	# as maintainer and force SPEC/protocol into the adopter's root (r9). This
   749	# reader ALWAYS runs. Fail-open: state absent/unreadable/invalid (ALL
   750	# pre-Wave-B installs) => "maintainer" — the pre-existing behavior; the
   751	# consequence is named in INSTALL.md §Upgrade flow. Same trust class as the
   752	# replay reader: target-side, UNSIGNED, advisory; the value is validated
   753	# against the closed enum {maintainer,user} and never eval-ed.
   754	# ===========================================================================
   755	_read_install_state_ceremony() {
   756	  command -v python3 >/dev/null 2>&1 || return 3
   757	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
   758	  PYTHONNOUSERSITE=1 python3 -I -c '
   759	import json, sys
   760	try:
   761	    with open(sys.argv[1], "r", encoding="utf-8") as f:
   762	        d = json.load(f)
   763	except (OSError, ValueError):
   764	    sys.exit(3)
   765	if not isinstance(d, dict) or d.get("schema_version") != 1:
   766	    sys.exit(3)
   767	req = d.get("request")
   768	if not isinstance(req, dict):
   769	    sys.exit(3)
   770	cer = req.get("ceremony", "")
   771	if cer not in ("maintainer", "user"):
   772	    sys.exit(3)
   773	sys.stdout.write(cer + "\n")
   774	' "$_INSTALL_STATE_FILE" 2>/dev/null
   775	}
   776	
   777	# Re-pass rc.4 t2 (P2): with NO readable install-state the old default was
   778	# maintainer (fail-open) — a pre-v1.2 USER-ceremony install could receive
   779	# root .gitignore writes across the user boundary. The fail-SAFE default is
   780	# user (root surfaces skipped, loudly); a pre-state MAINTAINER install opts
   781	# back in explicitly via CEO_UPGRADE_CEREMONY=maintainer.
   782	CEREMONY_EFFECTIVE="user"
   783	_CEREMONY_SOURCE="default (no readable install-state — fail-safe user; pass --ceremony maintainer to opt back in)"
   784	# t5 P1: only RECORDED or EXPLICIT resolutions may persist into the state
   785	# file — persisting the fail-safe INFERENCE would make one missed migration
   786	# flag permanent (recorded state wins on the next run by design).
   787	_CEREMONY_PERSIST="0"
   788	_cer_line=""
