  2367	# PLAN-177 t2 (re-pass rc.4 P1-a) -- the GRAMMAR the two rails share.
  2368	#
  2369	# `verdict : NO-GO` is valid YAML and last-wins under a real parser. The
  2370	# server validator strips the key, so it counted TWO declarations; the local
  2371	# tag guard's regex required the colon immediately after the name, so it
  2372	# counted ONE and parsed GO -- and the local guard is the rail with no escape
  2373	# hatch. The first round of controls could not see this: every fixture line
  2374	# was built as `"verdict: %s"`, which can only produce canonical keys.
  2375	#
  2376	# Cured semantics (identical in both files): non-canonical top-level syntax
  2377	# is REFUSED. So the duplicate variants are red for the SHAPE, and the single
  2378	# non-canonical key is red too -- an authorizing decision must be spelled the
  2379	# one way the template spells it.
  2380	_NONCANONICAL_DIAGNOSTIC = "non-canonical top-level key syntax"
  2381	_NONCANONICAL_DECISIONS = [
  2382	    [("verdict ", "NO-GO"), "GO"],
  2383	    [("verdict\t", "NO-GO"), "GO"],
  2384	    [("verdict ", "GO")],
  2385	    [("verdict\t", "GO")],
  2386	    # Re-pass rc.4 t2 P1: an INDENTED CONTINUATION line after the scalar —
  2387	    # valid YAML resolving to the non-authorizing scalar "GO NO-GO", which
  2388	    # both minimal readers previously read as `GO` (indented lines were
  2389	    # unconditionally skipped). Written verbatim by _decision_line.
  2390	    ["GO\n  NO-GO"],
  2391	]
  2392	_NONCANONICAL_IDS = [
  2393	    "space-before-colon-duplicate", "tab-before-colon-duplicate",
  2394	    "space-before-colon-alone", "tab-before-colon-alone",
  2395	    "indented-continuation",
  2396	]
