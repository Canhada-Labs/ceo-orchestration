   657	        ):
   658	            skill_less_by_design += 1
   659	            continue
   660	        total += 1
   661	        if ev.get("skill") in (None, "unknown", ""):
   662	            unknown += 1
   663	    if total == 0:
   664	        msg = (
   665	            "no custom-archetype spawns "
   666	            "({s} general-purpose, {t} test-pollution)".format(
   667	                s=skill_less_by_design, t=test_pollution_skipped,
   668	            )
   669	        )
   670	        return "green", msg, {
   671	            "unknown": 0, "total": 0,
   672	            "skill_less_by_design": skill_less_by_design,
   673	            "test_pollution_skipped": test_pollution_skipped,
   674	        }
   675	    ratio = unknown / total
