  2263	def _write_live_shaped_verdict(
  2264	    path: Path, tag: str, decisions: Sequence[str], parent: str
  2265	) -> None:
  2266	    """A verdict envelope the LIVE governance files accept end to end.
  2267	
  2268	    `decisions` is a SEQUENCE so the fixture can express the three shapes the
  2269	    gate must separate: zero lines (absent), one line (normal), two lines (the
  2270	    last-wins override). Values are written verbatim -- a malformed or unknown
  2271	    token reaches the validator exactly as authored.
  2272	    """
  2273	    tv = _live_tool_versions()
  2274	    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
  2275	    lines = ["# Pair-Rail Verdict -- fixture", "", "```yaml"]
  2276	    lines += [_decision_line(d).rstrip("\n") for d in decisions]
  2277	    lines += [
  2278	        "generated_at: %sZ" % now,
  2279	        "ttl_hours: 24",
  2280	        "parent_sha: %s" % parent,
  2281	        "release_tag: %s" % tag,
  2282	        "inputs_hash: %s" % _live_inputs_hash(),
  2283	        "tool_versions:",
  2284	        "  codex_cli: %s" % tv["codex_cli"],
  2285	        "  codex_target_triple: %s" % tv["codex_target_triple"],
  2286	        "  codex_payload_sha256: %s" % tv["codex_payload_sha256"],
  2287	        "gpg_signature: -----BEGIN PGP SIGNATURE----- fixture-not-a-signature",
  2288	        "```",
  2289	        "",
  2290	    ]
  2291	    path.write_text("\n".join(lines), encoding="utf-8")
