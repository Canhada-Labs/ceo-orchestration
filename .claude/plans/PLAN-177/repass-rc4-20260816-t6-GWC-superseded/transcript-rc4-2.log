   620	    # ghost filter and the S303 probe filter are RETIRED (absence-based,
   621	    # caller-forgeable); every agent_spawn row counts until the EMITTER can
   622	    # stamp provenance the caller cannot forge. The skipped counters were
   623	    # removed with them — a permanently-zero counter reads as "filter
   624	    # active, nothing skipped", which is the wrong claim.
   625	    total = 0
   626	    unknown = 0
   627	    skill_less_by_design = 0
   628	    test_pollution_skipped = 0
   629	    for ev in _iter_audit_events_since(24):
   630	        if ev.get("action") != "agent_spawn":
   631	            continue
   632	        if _is_test_pollution_event(ev):
   633	            test_pollution_skipped += 1
   634	            continue
   635	        # T-2 deferred (t5 P2): ghost/probe exemptions RETIRED — the shape
   636	        # detectors above stay tested for a future provenance-bearing
   637	        # emitter, but no row is skipped on caller-controlled absence.
   638	
   639	        # Skill-less by design: general-purpose archetype dispatches
   640	        # (mitigated rail per ADR-082) AND built-in subagent types like
   641	        # Explore/Plan/claude-code-guide that have no .claude/agents/<name>.md
   642	        # and so cannot carry a `Loads <skill> skill via reference` phrase
   643	        # (drift-detector contract per S143 lesson). Adding them to
   644	        # _ARCHETYPE_TO_SKILL would violate the contract — exclude here instead.
   645	        # S200: claude/claude-code-guide/statusline-setup are first-party
   646	        # Claude Code built-ins (no .claude/agents anchor); counting them as a
   647	        # governance gap is a false positive — exactly the FP class this filter
   648	        # exists to prevent (else healthy claude-code-guide use trains the
   649	        # operator to ignore the channel).
   650	        _SKILL_LESS_BUILTINS = {
   651	            "general-purpose", "Explore", "Plan",
   652	            "claude", "claude-code-guide", "statusline-setup",
   653	        }
   654	        if (
   655	            ev.get("subagent_type") in _SKILL_LESS_BUILTINS
