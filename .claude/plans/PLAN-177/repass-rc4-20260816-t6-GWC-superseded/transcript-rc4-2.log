  2530	def test_both_rails_answer_identically_on_every_key_shape():
  2531	    """The instrument that would have caught P1-a: ONE question, two readers.
  2532	
  2533	    A divergence is only visible when the same bytes are put to both. For any
  2534	    block both accept, they must also agree on how many decisions it declares
  2535	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2536	    things on the two machines that gate a release.
  2537	    """
  2538	    def block(body: str) -> str:
  2539	        return "# fixture\n\n```yaml\n%s```\n" % body
  2540	
  2541	    canonical_shapes = [
  2542	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2543	        "verdict: NO-GO\nverdict: GO\n",
  2544	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2545	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2546	        "verdict: GO  # inline comment\n",
  2547	        "verdict: GO#NO-GO\nrelease_tag: v1.2.3\n",
  2548	        "# verdict: NO-GO\nverdict: GO\n",
  2549	    ]
  2550	    noncanonical_shapes = [
  2551	        "verdict:GO\n",
  2552	        "verdict: GO\n  NO-GO\nrelease_tag: v1.2.3\n",
  2553	        "verdict : NO-GO\nverdict: GO\n",
  2554	        "verdict\t: NO-GO\nverdict: GO\n",
  2555	        "verdict : GO\n",
  2556	        '"verdict": GO\n',
  2557	        "verdict :GO\n",
  2558	    ]
  2559	    for body in canonical_shapes:
  2560	        text = block(body)
  2561	        assert validator.noncanonical_top_level_lines(text) == [], body
  2562	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2563	        assert validator.count_top_level_key(
  2564	            text, "verdict"
  2565	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2566	            "the two rails disagree on how many decisions %r declares" % body
  2567	        )
  2568	        assert validator.parse_verdict_text(text).get(
  2569	            "verdict"
  2570	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2571	            "the two rails disagree on WHICH decision wins in %r" % body
  2572	        )
  2573	    for body in noncanonical_shapes:
  2574	        text = block(body)
  2575	        assert validator.noncanonical_top_level_lines(text) != [], body
  2576	        assert (
  2577	            tag_guard._noncanonical_top_level_lines(text)
  2578	            == validator.noncanonical_top_level_lines(text)
  2579	        ), "the two shape gates disagree about %r" % body
  2580	
