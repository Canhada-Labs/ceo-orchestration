  2530	def test_both_rails_answer_identically_on_every_key_shape():
  2531	    """The instrument that would have caught P1-a: ONE question, two readers.
  2532	
  2533	    A divergence is only visible when the same bytes are put to both. For any
  2534	    block both accept, they must also agree on how many decisions it declares
  2535	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2536	    things on the two machines that gate a release.
  2537	    """
  2538	    def block(body: str) -> str:
  2539	        return "# fixture\n\n```yaml\n%s```\n" % body
  2540	
  2541	    canonical_shapes = [
  2542	        "verdict: GO\nrelease_tag: v1.2.3\n",
