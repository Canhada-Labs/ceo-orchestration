  2294	def _run_ci_validator(tmp_path, env, decisions: Sequence[str], bind_parent: bool):
  2295	    """Run the server-side validator with the LITERAL step-15 argv.
  2296	
  2297	    Source of the argv: .github/workflows/release.yml, job release-gate.
  2298	
  2299	    bind_parent=False is the --parent-sha "" shape of
  2300	    CEO_PAIR_RAIL_VERDICT_OPTIONAL=1. In THAT mode the step also carries
  2301	    continue-on-error, so this variant is a UNIT test of the validator, not a
  2302	    claim about the pipeline: what blocks a release in transition mode is
  2303	    _release_tag_guard.py delta (see the tag-guard controls below).
  2304	    """
  2305	    tag = "v0.0.0-plan177-decision-gate"
  2306	    parent = _repo_head()
  2307	    verdict_file = tmp_path / "pair-rail-verdict-fixture.md"
  2308	    _write_live_shaped_verdict(verdict_file, tag, decisions, parent)
  2309	    argv = [
  2310	        sys.executable, str(VALIDATOR_SRC),
  2311	        "--verdict-file", str(verdict_file),
  2312	        "--parent-sha", parent if bind_parent else "",
  2313	        "--release-tag", tag,
  2314	        "--max-age-hours", "24",
  2315	        "--recompute-inputs-hash",
  2316	        "--codex-cli-pin-file", ".claude/governance/codex-cli-pin.txt",
  2317	        "--codex-cli-binary-sha256-file",
  2318	        ".claude/governance/codex-cli-binary-sha256.txt",
  2319	        "--codex-pin-manifest-file",
  2320	        ".claude/governance/codex-cli-pin-manifest.json",
  2321	        "--inputs-hash-paths-file",
  2322	        ".claude/governance/pair-rail-inputs-hash-manifest.txt",
  2323	    ]
  2324	    return run(argv, REPO_ROOT, env)
