  1528	def test_integrity_contract_rows_name_a_live_step():
  1529	    """P1-3. The contract claimed a per-tarball SHA-256 manifest was
  1530	    "enforced today" and pointed at `validate.yml (to-add)`: a guarantee whose
  1531	    alleged gate could not fail because it did not exist. A row now declares a
  1532	    Status from a closed set, and an `enforced` one must name a step that is
  1533	    really in the YAML."""
  1534	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1535	    rows = _contract_rows(doc)
  1536	    assert len(rows) >= 5, "Contract table parsed as %d rows" % len(rows)
  1537	
  1538	    pairs = _integrity_enforced_pairs(doc)
  1539	    assert len(pairs) >= _MIN_ENFORCED_PAIRS, (
  1540	        "only %d enforced (workflow, step) claims parsed — below the floor of "
  1541	        "%d. Either the table stopped documenting enforcement, or its format "
  1542	        "changed and this gate is now checking nothing."
  1543	        % (len(pairs), _MIN_ENFORCED_PAIRS)
  1544	    )
  1545	
  1546	    # (a) a renamed step must go red. The fixture is DERIVED from the parsed
  1547	    # table, never a hand-typed row literal: an anchor typed here stops
  1548	    # matching the day that row is edited, and the control dies quietly.
  1549	    step = pairs[0][2]
  1550	    renamed = doc.replace('step "%s"' % step, 'step "%s renamed"' % step, 1)
  1551	    assert renamed != doc, "rename fixture did not patch the doc"
  1552	    renamed_offenders = _integrity_contract_offenders(renamed, REPO_ROOT)
  1553	    assert any("renamed" in o for o in renamed_offenders), (
  1554	        "control did not flag a row naming a nonexistent step: %s"
  1555	        % renamed_offenders
  1556	    )
  1557	
  1558	    # (b) a table with NO parseable step claim must go red on the COUNT, not
  1559	    # report zero offenders. That is the vacuity failure itself.
  1560	    stripped = doc.replace('step "', "step ")
  1561	    assert len(_integrity_enforced_pairs(stripped)) < _MIN_ENFORCED_PAIRS, (
  1562	        "a table with no parseable step claim still met the floor — the count "
  1563	        "check cannot detect vacuity"
  1564	    )
  1565	
  1566	    # (c) unknown Status vocabulary must go red, not be waved through.
  1567	    unknown = doc.replace("| enforced |", "| mostly enforced |", 1)
  1568	    assert unknown != doc, "status fixture did not patch the doc"
  1569	    assert any(
  1570	        "outside the closed set" in o
  1571	        for o in _integrity_contract_offenders(unknown, REPO_ROOT)
  1572	    ), "an unknown Status was accepted"
  1573	
  1574	    offenders = _integrity_contract_offenders(doc, REPO_ROOT)
  1575	    assert not offenders, "npm/INTEGRITY.md contract row without a live step:\n%s" % (
  1576	        "\n".join(offenders)
  1577	    )
