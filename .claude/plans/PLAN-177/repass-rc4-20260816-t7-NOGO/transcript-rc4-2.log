+      # wins over this flag — the flag exists for the migration case.
+      CEREMONY_FLAG="${2:-}"
+      case "$CEREMONY_FLAG" in
+        maintainer|user) : ;;
+        *) echo "ERROR: --ceremony must be 'maintainer' or 'user' (got '$CEREMONY_FLAG')" >&2; exit 2 ;;
+      esac
+      shift 2
+      ;;
