  2228	def _live_inputs_hash() -> str:
  2229	    """Recompute inputs_hash in THIS checkout, with the validator own manifest.
  2230	
  2231	    Never copied from a real envelope (codex P2-2): the validator is itself
  2232	    listed in pair-rail-inputs-hash-manifest.txt, so the P1-4 cure CHANGES the
  2233	    expected hash. A hardcoded hex would make the green cases fail on
  2234	    inputs_hash and the test would prove nothing about the decision.
  2235	    """
  2236	    key = "inputs_hash"
  2237	    if key not in _VALIDATOR_INPUTS_HASH_CACHE:
  2238	        _VALIDATOR_INPUTS_HASH_CACHE[key] = validator.compute_inputs_hash(
  2239	            REPO_ROOT, GOVERNANCE / "pair-rail-inputs-hash-manifest.txt"
  2240	        )
  2241	    return _VALIDATOR_INPUTS_HASH_CACHE[key]
