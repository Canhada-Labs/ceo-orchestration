   562	            return _fail(
   563	                E_VERDICT,
   564	                "delta_allowlist entry %r is neither this tag's verdict nor "
   565	                "plan-side evidence under %s\n"
   566	                "      The allowlist is EXHAUSTIVE: the verdict, its "
   567	                "verdict-fields, and the\n"
   568	                "      re-pass artifacts — nothing else. Allowlisting a "
   569	                "version site, a\n"
   570	                "      workflow or any code path turns this assert into "
   570	                "      workflow or any code path turns this assert into "
   571	                "permission to land\n"
   572	                "      unreviewed work on the tag, which is the hole it "
   573	                "exists to close."
   574	                % (entry, EVIDENCE_PREFIX),
   575	            )
   576	    allow_set: Set[str] = set(allow)
   577	    if verdict_rel not in allow_set:
   578	        return _fail(
   579	            E_VERDICT,
   580	            "the verdict itself (%s) is not in its own delta_allowlist — it "
   581	            "has to be committed, so it has to be allowed." % verdict_rel,
   582	        )
   583	
   584	    manifest_rel = fields.get("delta_manifest")
   585	    manifest_sha = fields.get("delta_manifest_sha256")
   586	    if not isinstance(manifest_rel, str) or not manifest_rel:
   587	        return _fail(
   588	            E_VERDICT,
   589	            "verdict %s carries no `delta_manifest:` — without it the "
   590	            "re-pass artifacts close by NAME only, and any file dropped into "
   591	            "the directory after the review would pass." % verdict_rel,
   592	        )
   593	    if not isinstance(manifest_sha, str) or not HEX64.match(manifest_sha):
   594	        return _fail(
   595	            E_VERDICT,
   596	            "verdict %s has no usable 64-hex `delta_manifest_sha256:`."
   597	            % verdict_rel,
   598	        )
   599	    if manifest_rel not in allow_set:
   600	        return _fail(
   601	            E_VERDICT,
   602	            "delta_manifest %s is not in delta_allowlist." % manifest_rel,
   603	        )
   604	
   605	    # --- content pin: the manifest itself, then everything it lists ---
   606	    manifest_abs = os.path.join(repo, manifest_rel)
   607	    if not os.path.isfile(manifest_abs):
   608	        return _fail(E_MANIFEST_PIN, "delta_manifest %s missing" % manifest_rel)
   609	    actual = _sha256(manifest_abs)
   610	    if actual != manifest_sha:
   611	        return _fail(
   612	            E_MANIFEST_PIN,
   613	            "delta_manifest sha256 mismatch for %s\n"
   614	            "      verdict pins %s\n"
   615	            "      on disk      %s" % (manifest_rel, manifest_sha, actual),
   616	        )
   617	    print("  ok   %s matches the sha256 pinned in the verdict" % manifest_rel)
   618	
   619	    try:
   620	        entries = _read_manifest(manifest_abs)
   621	    except (OSError, ValueError) as exc:
   622	        return _fail(E_MANIFEST_CONTENT, "cannot read %s: %s" % (manifest_rel, exc))
   623	    good, detail = _verify_manifest_content(manifest_abs)
   624	    if not good:
   625	        return _fail(
   626	            E_MANIFEST_CONTENT,
   627	            "re-pass artifacts do not match %s (shasum -c failed):\n      %s"
   628	            % (manifest_rel, detail),
   629	        )
