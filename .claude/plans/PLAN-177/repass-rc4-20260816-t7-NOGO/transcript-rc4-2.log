  1431	INTEGRITY_DOC = REPO_ROOT / "npm" / "INTEGRITY.md"
  1432	# Closed set. A row whose Status is anything else is a red — fail-closed on
  1433	# unknown vocabulary, because the way this table decayed the first time was a
  1434	# cell that READ like enforcement ("(to-add)", "Release script (Sprint 17
  1435	# scope)") without ever being it.
  1436	_CONTRACT_STATUSES = ("enforced", "deferred", "operator")
  1437	# `<workflow>.yml` in backticks, then the step name in straight quotes. Both
  1438	# delimiters are load-bearing: they are what makes the claim parseable at all.
  1439	_ENFORCED_RX = re.compile(r'`([^`]+\.yml)`\s+step\s+"([^"]+)"')
  1440	# Without a floor, a parser that suddenly matches nothing reports zero
  1441	# offenders and the gate passes having checked NOTHING. Two is the smallest
  1442	# floor that also keeps a one-row table from satisfying it by accident.
  1443	_MIN_ENFORCED_PAIRS = 2
  1444	
  1445	
  1446	def _yaml_step_names(path: Path) -> List[str]:
  1447	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1448	    call site: a substring match would accept "Verify VERSION" for a step
  1449	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1450	    already cost this repo three incidents in one session."""
  1451	    text = path.read_text(encoding="utf-8")
  1452	    names = []
  1453	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1454	        name = m.group(1)
  1455	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1456	            name = name[1:-1]
  1457	        names.append(name)
  1458	    return names
  1459	
  1460	
  1461	def _contract_rows(doc_text: str) -> List[List[str]]:
  1462	    """The `## Contract` table as [control, mechanism, status, where]."""
  1463	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1464	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1465	    rows = []
  1466	    for line in m.group(0).splitlines():
  1467	        line = line.strip()
  1468	        if not line.startswith("|"):
  1469	            continue
  1470	        cells = [c.strip() for c in line.strip("|").split("|")]
  1471	        if len(cells) != 4:
  1472	            continue
  1473	        if cells[0] == "Control" or set(cells[0]) <= set("- :"):
  1474	            continue
  1475	        rows.append(cells)
  1476	    return rows
  1477	
  1478	
  1479	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1480	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1481	    Status are not read — a row that claims no enforcement makes no claim to
  1482	    check."""
  1483	    out: List[List[str]] = []
  1484	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1485	        if status != "enforced":
  1486	            continue
  1487	        for workflow, step in _ENFORCED_RX.findall(where):
  1488	            out.append([control, workflow, step])
  1489	    return out
  1490	
  1491	
  1492	def _integrity_contract_offenders(doc_text: str, repo_root: Path) -> List[str]:
  1493	    """Closed-set Status, plus: every `enforced` row names a workflow that
  1494	    exists and a step that exists in it, by exact equality."""
  1495	    offenders: List[str] = []
  1496	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1497	        if status not in _CONTRACT_STATUSES:
  1498	            offenders.append(
  1499	                "%s: Status %r is outside the closed set %s"
  1500	                % (control, status, list(_CONTRACT_STATUSES))
  1501	            )
  1502	            continue
  1503	        if status != "enforced":
  1504	            continue
  1505	        pairs = _ENFORCED_RX.findall(where)
  1506	        if not pairs:
  1507	            offenders.append(
  1508	                "%s: Status is enforced but `Where enforced` names no "
  1509	                "workflow+step in the parseable form — %r" % (control, where)
  1510	            )
  1511	            continue
  1512	        for workflow, step in pairs:
  1513	            wf = repo_root / workflow
  1514	            if not wf.is_file():
  1515	                offenders.append(
  1516	                    "%s: names workflow %s, which does not exist"
  1517	                    % (control, workflow)
  1518	                )
  1519	                continue
  1520	            if step not in _yaml_step_names(wf):
  1521	                offenders.append(
  1522	                    "%s: names step %r in %s, which has no such step"
  1523	                    % (control, step, workflow)
  1524	                )
  1525	    return offenders
  1526	
