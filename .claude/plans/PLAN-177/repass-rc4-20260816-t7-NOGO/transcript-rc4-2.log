   101	# Shared python assert runner: python3 - <state> <label> [extra args] <<PY.
   102	# The heredoc script exits non-zero on the first failed assert and prints
   103	# the reason; the caller converts rc into ok/bad.
   104	py_assert() {
   105	  local state="$1" label="$2"; shift 2
   106	  if python3 - "$state" "$@" <<'PY'
   107	import json, sys
   108	state_path = sys.argv[1]
   109	mode = sys.argv[2]
   110	with open(state_path, "r", encoding="utf-8") as f:
   111	    d = json.load(f)
   112	
   113	def die(msg):
   114	    sys.stderr.write("assert failed: %s\n" % msg)
   115	    sys.exit(1)
   116	
   117	if d.get("schema") != "ceo.install-state/v1":
   118	    die("schema field")
   119	if d.get("schema_version") != 1:
   120	    die("schema_version")
   121	req = d.get("request")
   122	if not isinstance(req, dict):
   123	    die("request not a dict")
   124	
   125	if mode == "fresh":
   126	    exp_owner, exp_deploy = sys.argv[3], sys.argv[4]
   127	    exp_argv = sys.argv[5:]
   128	    if d.get("run_count") != 1: die("run_count != 1 (got %r)" % d.get("run_count"))
   129	    if d.get("tool", {}).get("name") != "install.sh": die("tool.name")
   130	    if req.get("profile") != "core": die("request.profile (got %r)" % req.get("profile"))
   131	    if req.get("mode") != "copy": die("request.mode")
   132	    if req.get("stack") != "none": die("request.stack")
   133	    if req.get("stack_explicit") is not False: die("stack_explicit")
   134	    if req.get("ceremony") != "maintainer": die("ceremony")
   135	    if req.get("verify") is not False: die("verify")
   136	    ph = req.get("placeholders")
   137	    if not isinstance(ph, dict): die("placeholders not a dict")
   138	    if ph.get("OWNER_NAME") != exp_owner: die("OWNER_NAME roundtrip (got %r)" % ph.get("OWNER_NAME"))
   139	    if ph.get("DEPLOY_COMMAND") != exp_deploy: die("DEPLOY_COMMAND roundtrip")
   140	    if "PROJECT_NAME" not in ph: die("deterministic-default PROJECT_NAME missing")
   141	    if "CITY" in ph: die("empty placeholder CITY should be omitted")
   142	    if req.get("argv") != exp_argv: die("argv verbatim (got %r)" % req.get("argv"))
   143	    ops = [o.get("op") for o in d.get("operations", [])]
   144	    for needed in ("install_team_rosters", "install_skills", "install_hooks",
   145	                   "install_scripts", "build_settings", "write_install_manifest"):
   146	        if needed not in ops: die("operation %s not journaled (ops=%r)" % (needed, ops))
   147	    details = [o.get("detail") for o in d.get("operations", []) if o.get("op") == "install_skills"]
   148	    if "core" not in details: die("install_skills core detail")
   149	    if "frontend" in details: die("frontend skills journaled on a core-only install")
   150	    if d.get("result", {}).get("install_succeeded") is not True: die("result.install_succeeded")
   151	elif mode == "rerun":
   152	    exp_first = sys.argv[3]
   153	    if d.get("run_count") != 2: die("run_count != 2 (got %r)" % d.get("run_count"))
   154	    if d.get("first_recorded_at") != exp_first: die("first_recorded_at not preserved")
   155	    if not d.get("history"): die("history empty after rerun")
   156	elif mode == "replayed-upgrade":
   157	    if d.get("tool", {}).get("name") != "upgrade.sh": die("tool.name after upgrade")
   158	    lu = d.get("last_upgrade")
   159	    if not isinstance(lu, dict): die("last_upgrade missing")
   160	    if lu.get("replay_source") != "replay": die("replay_source (got %r)" % lu.get("replay_source"))
   161	    if req.get("profile") != "core": die("request.profile after replayed upgrade")
   162	    ph = req.get("placeholders")
   163	    if not isinstance(ph, dict) or "OWNER_NAME" not in ph:
   164	        die("install placeholders NOT preserved through upgrade rewrite")
   165	    if not req.get("argv"): die("original install argv NOT preserved through upgrade rewrite")
   166	    ops = [o.get("op") for o in d.get("operations", [])]
   167	    for needed in ("refresh_target", "refresh_protocol_pointer", "rewrite_baseline_manifest"):
   168	        if needed not in ops: die("upgrade op %s not journaled (ops=%r)" % (needed, ops))
   169	elif mode == "explicit-upgrade":
   170	    if req.get("profile") != "core,frontend": die("explicit --profile not re-recorded")
   171	elif mode == "acquired":
   172	    if d.get("tool", {}).get("name") != "upgrade.sh": die("tool.name")
   173	    if "synthesized" not in str(req.get("note", "")): die("synthesized note missing on acquired state")
   174	    if req.get("profile") != "core,frontend": die("fallback default profile not recorded")
   175	    lu = d.get("last_upgrade", {})
   176	    if lu.get("replay_source") != "fallback-no-state": die("replay_source (got %r)" % lu.get("replay_source"))
   177	elif mode == "valid":
   178	    pass
   179	else:
   180	    die("unknown assert mode %s" % mode)
   181	sys.exit(0)
   182	PY
   183	  then ok "$label"; else bad "$label"; fi
   184	}
