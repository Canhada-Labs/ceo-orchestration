   647	    vf_expected = "%s/%s" % (plan_dir, vf_name) if plan_dir else vf_name
   648	    for entry in sorted(allow_set):
   649	        if entry == verdict_rel or entry == manifest_rel:
   650	            continue
   651	        if entry.startswith(man_dir + "/"):
   652	            continue
   653	        if entry != vf_expected:
   654	            return _fail(
   655	                E_VERDICT,
   656	                "delta_allowlist entry %r is outside the manifest directory "
   657	                "(%s/) and is not this\n"
   658	                "      tag's verdict-fields at its canonical path (%s).\n"
   659	                "      Outside the manifest nothing pins content — a "
   660	                "post-review edit there\n"
   661	                "      would ride the tag by NAME alone, and a basename "
   662	                "match in any other\n"
   663	                "      directory is a look-alike, not the plan's file. Move "
   664	                "the file into the\n"
   665	                "      re-pass manifest, or it must be exactly %s."
   666	                % (entry, man_dir, vf_expected, vf_expected),
   667	            )
   668	
   669	    # --- set equality by NAME, both directions, inside the manifest dir ---
   670	    listed = set(
   671	        os.path.normpath(os.path.join(man_dir, name)).replace(os.sep, "/")
   672	        for _sha, name in entries
   673	    )
   674	    listed.add(manifest_rel)
   675	    allowed_in_dir = set(
   676	        e for e in allow_set if man_dir and (e == manifest_rel or e.startswith(man_dir + "/"))
   677	    )
   678	    if allowed_in_dir != listed:
   679	        extra = sorted(allowed_in_dir - listed)
   680	        missing = sorted(listed - allowed_in_dir)
   681	        return _fail(
   682	            E_MANIFEST_SET,
   683	            "re-pass artifact set is not closed under %s\n"
   684	            "      allowlisted but not in the manifest: %s\n"
   685	            "      in the manifest but not allowlisted: %s"
   686	            % (manifest_rel, extra or "-", missing or "-"),
   687	        )
   688	    print("  ok   re-pass artifact set closes (name equality with the manifest)")
   689	
   690	    # --- the delta itself ---
   691	    # --no-renames on purpose: with rename detection a file moved OUT of the
   692	    # allowlisted evidence directory is reported only under its destination
   693	    # name, and the disappearance of the reviewed original goes unmentioned.
   694	    # Literal paths on both sides or the set comparison is not a set comparison.
   695	    rc, out, err = _git(repo, "diff", "--no-renames", "%s..HEAD" % parent, "--name-only")
   696	    if rc != 0:
   697	        return _fail(
   698	            E_DELTA,
   699	            "`git diff --no-renames %s..HEAD --name-only` failed: %s"
   700	            % (parent, err.strip()),
   701	        )
   702	    changed = [line for line in out.splitlines() if line.strip()]
   703	    outside = sorted(p for p in changed if p not in allow_set)
   704	    if outside:
   705	        return _fail(
   706	            E_DELTA,
   707	            "files changed after the reviewed parent %s that the verdict does "
   708	            "NOT allow:\n%s\n"
   709	            "      The invariant is: NOTHING landed after what the re-pass "
   710	            "reviewed,\n"
   711	            "      other than the verdict and its pinned evidence. Either "
   712	            "re-run the\n"
   713	            "      re-pass against this tree, or drop these commits."
   714	            % (parent[:12], "\n".join("        - %s" % p for p in outside)),
   715	        )
   716	
   717	    # VACUITY. Everything above is satisfied trivially by an anchor that sits
   718	    # AT (or after) the verdict: the delta is then empty or verdict-free and
   719	    # "all files are inside the allowlist" proves nothing at all. The verdict
   720	    # has to have LANDED after the tree it certifies.
   721	    if verdict_rel not in changed:
   722	        return _fail(
   723	            E_VACUOUS,
   724	            "the verdict %s is not part of the delta %s..HEAD — this assert "
   725	            "would pass\n"
   726	            "      VACUOUSLY. parent_sha has to be the commit the re-pass "
   727	            "reviewed, with\n"
   728	            "      the verdict landing after it; parent_sha == HEAD (or any "
   729	            "anchor whose\n"
   730	            "      tree already carried the verdict) is the v1.16.0 "
   731	            "self-reference bug that\n"
   732	            "      the parent_sha field was introduced to kill."
   733	            % (verdict_rel, parent[:12]),
   734	        )
   735	
   736	    # State the inputs, not just the verdict: an operator reading a release log
   737	    # has to be able to tell what this assert actually examined.
   738	    print(
   739	        "  ok   delta %s..HEAD is %d file(s), all inside the verdict's closed "
   740	        "allowlist of %d (verdict present in the delta)"
   741	        % (parent[:12], len(changed), len(allow_set))
   742	    )
   743	    return 0
   744	
   745	
   746	def main(argv: Optional[Sequence[str]] = None) -> int:
   747	    parser = argparse.ArgumentParser(prog="_release_tag_guard.py")
   748	    sub = parser.add_subparsers(dest="cmd")
   749	
   750	    p_anc = sub.add_parser("ancestry", help="HEAD must be on origin/<branch>")
   751	    p_anc.add_argument("--repo", default=".")
   752	    p_anc.add_argument("--remote", default="origin")
   753	    p_anc.add_argument("--branch", default="main")
   754	    p_anc.add_argument(
   755	        "--offline-ack",
   756	        action="store_true",
   757	        help="named escape hatch: skip the fetch and judge against the "
   758	        "last-known remote ref (loudly announced)",
   759	    )
   760	
   761	    p_delta = sub.add_parser("delta", help="restricted delta vs the verdict")
   762	    p_delta.add_argument("--repo", default=".")
   763	    p_delta.add_argument("--tag", required=True)
   764	    p_delta.add_argument("--verdict", default=None)
   765	
   766	    args = parser.parse_args(argv)
   767	    if args.cmd == "ancestry":
   768	        return ancestry(args.repo, args.remote, args.branch, args.offline_ack)
   769	    if args.cmd == "delta":
   770	        return delta(args.repo, args.tag, args.verdict)
   771	    parser.print_usage(sys.stderr)
   772	    return E_USAGE
   773	
   774	
   775	if __name__ == "__main__":
   776	    sys.exit(main())

