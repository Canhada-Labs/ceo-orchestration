    73	run_install() {
    74	  # $1 = target, rest passed through. Log is a SIBLING of the target
    75	  # (never inside it — WS4 user-ceremony guard would trip otherwise).
    76	  local t="$1"; shift
    77	  bash "$INSTALL" "$t" "$@" >"$t.install.log" 2>&1
    78	}
    79	
    80	run_upgrade() {
    81	  local t="$1"; shift
    82	  bash "$UPGRADE" "$t" --no-deprecation-warn "$@" >"$t.upgrade.log" 2>&1
    83	}
