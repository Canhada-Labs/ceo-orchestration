diff --git a/.github/workflows/tournament.yml b/.github/workflows/tournament.yml
index d72a583..d3cc8db 100644
--- a/.github/workflows/tournament.yml
+++ b/.github/workflows/tournament.yml
@@ -187,6 +187,12 @@ jobs:
             echo ""
             echo "See SPEC/v1/tournament-report.schema.md for report format."
           } >> "$GITHUB_STEP_SUMMARY"
+        # projection.txt is produced by the "Cost projection" step, which
+        # runs in .claude/scripts. Without this, json.load() below always
