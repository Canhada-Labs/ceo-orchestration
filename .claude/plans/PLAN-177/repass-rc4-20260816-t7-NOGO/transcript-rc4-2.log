    85	fresh_install() {
    86	  # $1 = leg tag, rest = install args. Echoes the target path.
    87	  local tag="$1"; shift
    88	  local t
    89	  t="$( mktemp -d "$WORKROOT/tgt-$tag-XXXXXX" )"
    90	  _git_init_retry "$t"
    91	  if ! run_install "$t" "$@"; then
    92	    echo "INSTALL_FAILED ($tag)" >&2
    93	    tail -30 "$t.install.log" >&2
    94	    return 1
    95	  fi
    96	  printf '%s\n' "$t"
    97	}
