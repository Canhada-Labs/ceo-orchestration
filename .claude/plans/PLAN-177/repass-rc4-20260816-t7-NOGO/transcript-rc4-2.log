   742	# ===========================================================================
   743	# PLAN-166 F3 (ADR-155-AMEND-1) — resolve the RECORDED install ceremony with
   744	# a reader of its OWN, INDEPENDENT of the replay path: --no-replay sets
   745	# REPLAY=0 and the replay block above (incl. _read_install_state_request) is
   746	# skipped entirely, so if the ceremony rode the replay, the documented
   747	# `upgrade.sh <target> --no-replay` would treat a `--ceremony user` install
   748	# as maintainer and force SPEC/protocol into the adopter's root (r9). This
   749	# reader ALWAYS runs. Fail-open: state absent/unreadable/invalid (ALL
   750	# pre-Wave-B installs) => "maintainer" — the pre-existing behavior; the
   751	# consequence is named in INSTALL.md §Upgrade flow. Same trust class as the
   752	# replay reader: target-side, UNSIGNED, advisory; the value is validated
   753	# against the closed enum {maintainer,user} and never eval-ed.
   754	# ===========================================================================
   755	_read_install_state_ceremony() {
   756	  command -v python3 >/dev/null 2>&1 || return 3
   757	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
   758	  PYTHONNOUSERSITE=1 python3 -I -c '
   759	import json, sys
   760	try:
   761	    with open(sys.argv[1], "r", encoding="utf-8") as f:
   762	        d = json.load(f)
   763	except (OSError, ValueError):
   764	    sys.exit(3)
   765	if not isinstance(d, dict) or d.get("schema_version") != 1:
   766	    sys.exit(3)
   767	req = d.get("request")
   768	if not isinstance(req, dict):
   769	    sys.exit(3)
   770	cer = req.get("ceremony", "")
   771	if cer not in ("maintainer", "user"):
   772	    sys.exit(3)
   773	sys.stdout.write(cer + "\n")
   774	' "$_INSTALL_STATE_FILE" 2>/dev/null
   775	}
