    63	# git-index-lock-safe init: small retry around `git init` (parallel CI hosts).
    64	_git_init_retry() {
    65	  local d="$1" n=0
    66	  while [ "$n" -lt 5 ]; do
    67	    if ( cd "$d" && git init -q 2>/dev/null ); then return 0; fi
    68	    n=$((n+1)); sleep 1
    69	  done
    70	  ( cd "$d" && git init -q )
    71	}
