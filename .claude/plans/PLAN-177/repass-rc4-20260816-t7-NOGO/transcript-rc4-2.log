  2356	def test_ci_validator_stops_a_duplicated_decision_key(tmp_path, ci_env, bind_parent):
  2357	    """Both readers are last-wins: NO-GO followed by GO parses as GO. An
  2358	    envelope with two decision lines is not a verdict, it is an override."""
  2359	    proc = _run_ci_validator(tmp_path, ci_env, ["NO-GO", "GO"], bind_parent)
  2360	    assert proc.returncode == validator.EXIT_VERDICT_INVALID, (
