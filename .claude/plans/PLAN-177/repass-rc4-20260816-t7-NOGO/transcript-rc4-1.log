  2295	def _run_ci_validator(tmp_path, env, decisions: Sequence[str], bind_parent: bool):
  2296	    """Run the server-side validator with the LITERAL step-15 argv.
  2297	
  2298	    Source of the argv: .github/workflows/release.yml, job release-gate.
  2299	
  2300	    bind_parent=False is the --parent-sha "" shape of
  2301	    CEO_PAIR_RAIL_VERDICT_OPTIONAL=1. In THAT mode the step also carries
  2302	    continue-on-error, so this variant is a UNIT test of the validator, not a
  2303	    claim about the pipeline: what blocks a release in transition mode is
  2304	    _release_tag_guard.py delta (see the tag-guard controls below).
  2305	    """
  2306	    tag = "v0.0.0-plan177-decision-gate"
  2307	    parent = _repo_head()
  2308	    verdict_file = tmp_path / "pair-rail-verdict-fixture.md"
  2309	    _write_live_shaped_verdict(verdict_file, tag, decisions, parent)
  2310	    argv = [
  2311	        sys.executable, str(VALIDATOR_SRC),
  2312	        "--verdict-file", str(verdict_file),
  2313	        "--parent-sha", parent if bind_parent else "",
  2314	        "--release-tag", tag,
  2315	        "--max-age-hours", "24",
  2316	        "--recompute-inputs-hash",
  2317	        "--codex-cli-pin-file", ".claude/governance/codex-cli-pin.txt",
  2318	        "--codex-cli-binary-sha256-file",
  2319	        ".claude/governance/codex-cli-binary-sha256.txt",
  2320	        "--codex-pin-manifest-file",
  2321	        ".claude/governance/codex-cli-pin-manifest.json",
  2322	        "--inputs-hash-paths-file",
  2323	        ".claude/governance/pair-rail-inputs-hash-manifest.txt",
  2324	    ]
  2325	    return run(argv, REPO_ROOT, env)
