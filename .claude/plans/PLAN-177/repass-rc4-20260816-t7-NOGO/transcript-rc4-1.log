  2515	        encoding="utf-8"
  2516	    )
  2517	    for exc in (".claude/policies/fixtures/", "templates/oidc-proxy/tests/"):
  2518	        assert exc in publish, (
  2519	            "fixture drifted: %r no longer shipped by npm-publish.yml -- "
  2520	            "update INTEGRITY.md AND this test together" % exc
  2521	        )
  2522	        assert exc in integrity, (
  2523	            "INTEGRITY.md packlist claim omits the SHIPPED exception %r" % exc
  2524	        )
  2525	    assert "PLAN-N" in integrity, (
  2526	        "INTEGRITY.md must state the real predicate (numbered PLAN-N "
  2527	        "artifacts excluded), not a blanket no-plan-material claim"
  2528	    )
  2529	
  2530	
  2531	def test_both_rails_answer_identically_on_every_key_shape():
  2532	    """The instrument that would have caught P1-a: ONE question, two readers.
  2533	
  2534	    A divergence is only visible when the same bytes are put to both. For any
  2535	    block both accept, they must also agree on how many decisions it declares
  2536	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2537	    things on the two machines that gate a release.
  2538	    """
  2539	    def block(body: str) -> str:
  2540	        return "# fixture\n\n```yaml\n%s```\n" % body
  2541	
  2542	    canonical_shapes = [
  2543	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2544	        "verdict: NO-GO\nverdict: GO\n",
  2545	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2546	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2547	        "verdict: GO  # inline comment\n",
  2548	        "verdict: GO#NO-GO\nrelease_tag: v1.2.3\n",
  2549	        "# verdict: NO-GO\nverdict: GO\n",
  2550	    ]
  2551	    noncanonical_shapes = [
  2552	        "verdict:GO\n",
  2553	        "verdict: GO\n  NO-GO\nrelease_tag: v1.2.3\n",
  2554	        "verdict : NO-GO\nverdict: GO\n",
  2555	        "verdict\t: NO-GO\nverdict: GO\n",
  2556	        "verdict : GO\n",
  2557	        '"verdict": GO\n',
  2558	        "verdict :GO\n",
  2559	    ]
  2560	    for body in canonical_shapes:
  2561	        text = block(body)
  2562	        assert validator.noncanonical_top_level_lines(text) == [], body
  2563	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2564	        assert validator.count_top_level_key(
  2565	            text, "verdict"
  2566	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2567	            "the two rails disagree on how many decisions %r declares" % body
  2568	        )
  2569	        assert validator.parse_verdict_text(text).get(
  2570	            "verdict"
  2571	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2572	            "the two rails disagree on WHICH decision wins in %r" % body
  2573	        )
  2574	    for body in noncanonical_shapes:
  2575	        text = block(body)
  2576	        assert validator.noncanonical_top_level_lines(text) != [], body
  2577	        assert (
  2578	            tag_guard._noncanonical_top_level_lines(text)
  2579	            == validator.noncanonical_top_level_lines(text)
  2580	        ), "the two shape gates disagree about %r" % body
  2581	
  2582	
  2583	@pytest.mark.parametrize("decision", ["GO", "GO-WITH-CONDITIONS"])
  2584	def test_delta_still_cuts_a_tag_on_an_authorizing_verdict(synth, decision):
  2585	    arm_verdict(synth, "v1.3.0-rc.2", verdict=decision)
  2586	    proc = guard(synth, "delta", "--repo", str(synth["repo"]), "--tag", "v1.3.0-rc.2")
  2587	    assert _DECISION_REFUSED not in proc.stderr, proc.stderr
  2588	    assert proc.returncode == 0, proc.stdout + proc.stderr
  2589	    assert "closed allowlist" in proc.stdout

