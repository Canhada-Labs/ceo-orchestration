  1479	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1480	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1481	    Status are not read — a row that claims no enforcement makes no claim to
  1482	    check."""
  1483	    out: List[List[str]] = []
  1484	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1485	        if status != "enforced":
  1486	            continue
  1487	        for workflow, step in _ENFORCED_RX.findall(where):
  1488	            out.append([control, workflow, step])
  1489	    return out
