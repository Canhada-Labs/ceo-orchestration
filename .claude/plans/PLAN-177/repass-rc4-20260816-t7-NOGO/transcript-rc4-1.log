  1492	def _integrity_contract_offenders(doc_text: str, repo_root: Path) -> List[str]:
  1493	    """Closed-set Status, plus: every `enforced` row names a workflow that
  1494	    exists and a step that exists in it, by exact equality."""
  1495	    offenders: List[str] = []
  1496	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1497	        if status not in _CONTRACT_STATUSES:
  1498	            offenders.append(
  1499	                "%s: Status %r is outside the closed set %s"
  1500	                % (control, status, list(_CONTRACT_STATUSES))
  1501	            )
  1502	            continue
  1503	        if status != "enforced":
  1504	            continue
  1505	        pairs = _ENFORCED_RX.findall(where)
  1506	        if not pairs:
  1507	            offenders.append(
  1508	                "%s: Status is enforced but `Where enforced` names no "
  1509	                "workflow+step in the parseable form — %r" % (control, where)
  1510	            )
  1511	            continue
  1512	        for workflow, step in pairs:
  1513	            wf = repo_root / workflow
  1514	            if not wf.is_file():
  1515	                offenders.append(
  1516	                    "%s: names workflow %s, which does not exist"
  1517	                    % (control, workflow)
  1518	                )
  1519	                continue
  1520	            if step not in _yaml_step_names(wf):
  1521	                offenders.append(
  1522	                    "%s: names step %r in %s, which has no such step"
  1523	                    % (control, step, workflow)
  1524	                )
  1525	    return offenders
