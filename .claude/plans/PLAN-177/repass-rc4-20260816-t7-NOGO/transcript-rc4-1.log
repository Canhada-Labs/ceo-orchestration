  2244	def _live_tool_versions() -> Dict[str, str]:
  2245	    """codex pins read from the LIVE governance files, not from memory.
  2246	
  2247	    Both pins drift by ceremony (the semver range has been widened four times);
  2248	    deriving them keeps this control testing the decision instead of decaying
  2249	    into a pin-drift alarm.
  2250	    """
  2251	    min_v, _max_v = validator.parse_pin_range(GOVERNANCE / "codex-cli-pin.txt")
  2252	    assert min_v, "fixture broke: no semver range in codex-cli-pin.txt"
  2253	    manifest = json.loads(
  2254	        (GOVERNANCE / "codex-cli-pin-manifest.json").read_text(encoding="utf-8")
  2255	    )
  2256	    triple = sorted(manifest["payloads"])[0]
  2257	    return {
  2258	        "codex_cli": min_v,
  2259	        "codex_target_triple": triple,
  2260	        "codex_payload_sha256": manifest["payloads"][triple]["sha256"],
  2261	    }
