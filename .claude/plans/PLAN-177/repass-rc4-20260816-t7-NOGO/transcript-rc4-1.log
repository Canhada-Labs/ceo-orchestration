  1377	            continue
  1378	        try:
  1379	            body = path.read_text(encoding="utf-8")
  1380	        except (UnicodeDecodeError, OSError):
  1381	            continue
  1382	        for num, line in enumerate(body.splitlines(), 1):
  1383	            if _STAMP_LINE_RX.search(line):
  1384	                continue
  1385	            for hit in SEMVER_RX.findall(line):
  1386	                offenders.append("%s:%d: %s (%s)" % (rel, num, line.strip(), hit))
