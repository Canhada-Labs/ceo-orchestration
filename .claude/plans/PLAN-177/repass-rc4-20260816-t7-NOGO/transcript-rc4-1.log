  2155	# ===========================================================================
  2156	# PLAN-177 W0.1 (P1-4) -- the pair-rail DECISION gate
  2157	# ===========================================================================
  2158	# The re-pass of 2026-08-12 found that BOTH release rails read the verdict
  2159	# envelope for pinning, TTL, anchor and delta, and NEITHER read the decision:
  2160	# a cross-model NO-GO returned "OK: verdict ... valid" / exit 0 from the
  2161	# server-side validator, release-gate went green, and only the Owner running
  2162	# OWNER-GA-CUT.sh stood between a negative review and an irreversible publish.
  2163	#
  2164	# CF-3 asymmetry, restated here because it decides what each control PROVES:
  2165	# step 15 carries continue-on-error under CEO_PAIR_RAIL_VERDICT_OPTIONAL=1, so
  2166	# the validator control is a UNIT control over defence in depth; the control
  2167	# that stands for enforcement in every mode is the tag-guard one below.
  2168	_VALIDATOR_INPUTS_HASH_CACHE = {}
  2169	
  2170	# Anchors on the DIAGNOSTIC, not just the exit code: a gate that fires for the
  2171	# wrong reason is a dead probe wearing a green badge (S-lesson: a control that
  2172	# cannot fail proves nothing).
  2173	_ACCEPTED_SET_TEXT = "{GO, GO-WITH-CONDITIONS}"
  2174	_DECISION_REFUSED = "not in " + _ACCEPTED_SET_TEXT
  2175	_CI_DUPLICATE_DIAGNOSTIC = "verdict decision declared more than once"
  2176	_GUARD_DUPLICATE_DIAGNOSTIC = "declares the decision"
  2177	
  2178	# Value-shaped refusals. `GO | NO-GO | GO-WITH-CONDITIONS` is the LITERAL of
  2179	# pair-rail-verdict-template.md:13 -- an envelope copied from the template
  2180	# without filling the field in.
  2180	# without filling the field in.
  2181	_REFUSED_DECISIONS = [
  2182	    ["NO-GO"],
  2183	    [],
  2184	    ["MAYBE"],
  2185	    [""],
  2186	    ["go"],
  2187	    ["no-go"],
  2188	    ["GO WITH CONDITIONS"],
  2189	    ["GO | NO-GO | GO-WITH-CONDITIONS"],
  2190	    # Re-pass rc.4 t3 P1: `#` WITHOUT preceding whitespace is NOT a YAML
  2191	    # comment — these are single unknown values, not GO + comment.
  2192	    ["GO#NO-GO"],
  2193	    ["GO-WITH-CONDITIONS#NO-GO"],
  2194	    # Re-pass rc.4 t5 P1: Unicode whitespace must stay attached to the
  2195	    # VALUE — `GO<U+00A0>` is not the exact authorizing token.
  2196	    ["GO\u00a0"],
  2197	    ["\u00a0GO"],
  2198	    ["GO-WITH-CONDITIONS\u00a0"],
  2199	]
  2200	_REFUSED_IDS = [
  2201	    "no-go", "absent", "unknown", "empty", "lowercase", "lower-no-go",
  2202	    "spaced", "template-literal",
  2203	    "hash-glued-no-go", "hash-glued-gwc",
  2204	    "trailing-nbsp", "leading-nbsp", "gwc-trailing-nbsp",
  2205	]
