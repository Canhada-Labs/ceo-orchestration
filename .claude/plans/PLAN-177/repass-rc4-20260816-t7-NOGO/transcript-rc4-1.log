   249	
   250	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   251	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   252	    if not manifest_path.exists():
   253	        raise FileNotFoundError(f"manifest: {manifest_path}")
   254	    paths = []
   255	    for line in manifest_path.read_text().splitlines():
   256	        line = line.split("#", 1)[0].strip()
   257	        if line:
   258	            paths.append(line)
   259	    paths.sort()
   260	    hashes = {}
   261	    for p in paths:
   262	        result = subprocess.run(
   263	            ["git", "hash-object", p],
   264	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   265	        )
   266	        if result.returncode != 0:
   267	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   268	        hashes[p] = result.stdout.strip()
   269	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   270	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   271	
   272	
   273	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   274	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   275	    if not pin_file.exists():
   276	        return None, None
   277	    for line in pin_file.read_text().splitlines():
   278	        line = line.split("#", 1)[0].strip()
   279	        if not line:
   280	            continue
   281	        # parse `>=X.Y.Z,<A.B.C` shape
   282	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   283	        if m:
   284	            return m.group(1), m.group(2)
   285	    return None, None
   286	
   287	
   288	def parse_semver(s: str) -> Tuple[int, int, int]:
   289	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   290	    if not m:
   291	        raise ValueError(f"unparseable semver: {s!r}")
   292	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   293	
   294	
   295	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   296	    try:
   297	        v = parse_semver(version)
   298	        lo = parse_semver(min_v)
   299	        hi = parse_semver(max_v)
   300	        return lo <= v < hi
   301	    except ValueError:
   302	        return False
