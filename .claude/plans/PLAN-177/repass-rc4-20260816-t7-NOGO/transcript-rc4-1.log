   169	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   170	            # while this minimal reader still saw `GO` — reject fail-closed
   171	            # (re-pass rc.4 t2 P1).
   172	            if prev_scalar_decl:
   173	                bad.append(line)
   174	            continue
   175	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   176	            _key, _, _val = line.partition(":")
   177	            prev_scalar_decl = bool(_val.strip())
   178	            continue
   179	        if line.startswith("- "):  # top-level list item
   180	            prev_scalar_decl = False
   181	            continue
   182	        bad.append(line)
   183	        prev_scalar_decl = False
   184	    return bad
