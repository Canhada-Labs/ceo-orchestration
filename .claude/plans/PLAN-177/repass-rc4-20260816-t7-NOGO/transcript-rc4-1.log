  1673	        if line.startswith("#") and line[1:].startswith("   ")
  1674	    ]
  1675	    assert recipe, "the manifest no longer documents any regeneration command"
  1676	    assert not any(".shasum" in line for line in recipe), (
  1677	        "a regeneration command extracts npm's `.shasum` again -- that is "
  1678	        "SHA-1, not SHA-256, and it emits no filename: %s" % recipe
  1679	    )
  1680	    assert not any("--dry-run" in line for line in recipe), (
  1681	        "a regeneration command runs `npm pack --dry-run` -- it writes no "
  1682	        "tarball, so there is nothing to hash: %s" % recipe
  1683	    )
  1684	    assert any(
  1685	        ("sha256sum" in line or "shasum -a 256" in line) for line in recipe
  1686	    ), "no recipe line names a SHA-256 hasher: %s" % recipe
  1687	    assert any(
  1688	        ("$TARBALL" in line or '"filename"' in line) for line in recipe
  1689	    ), (
  1690	        "the recipe never materialises the tarball NAME -- the manifest "
  1691	        "format is `<sha256>  <filename>`: %s" % recipe
  1692	    )
  1693	    # the writer the file attributes itself to must exist AND hash with the
  1694	    # algorithm the filename promises (attribution is checked, not trusted).
  1695	    writer = REPO_ROOT / "scripts" / "install-npm.sh"
  1696	    assert any("install-npm.sh" in line for line in recipe), (
  1697	        "the recipe no longer points at the real local writer: %s" % recipe
  1698	    )
  1699	    assert writer.exists(), "SHA256SUMS.txt names a writer that is not there"
  1700	    writer_body = writer.read_text(encoding="utf-8")
  1701	    assert "sha256sum" in writer_body or "shasum -a 256" in writer_body, (
  1702	        "install-npm.sh no longer computes a SHA-256 -- the attribution in "
  1703	        "SHA256SUMS.txt has gone stale"
  1704	    )
  1705	    # `files:` really does exclude it — the claim above is checked, not trusted
  1706	    pkg = json.loads((REPO_ROOT / "npm" / "package.json").read_text(encoding="utf-8"))
  1707	    assert not any("SHA256SUMS" in entry for entry in pkg["files"]), (
  1708	        "SHA256SUMS.txt now ships in the tarball — re-open the doc, the "
  1709	        "un-automated control may have become real"
