  1446	def _yaml_step_names(path: Path) -> List[str]:
  1447	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1448	    call site: a substring match would accept "Verify VERSION" for a step
  1449	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1450	    already cost this repo three incidents in one session."""
  1451	    text = path.read_text(encoding="utf-8")
  1452	    names = []
  1453	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1454	        name = m.group(1)
  1455	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1456	            name = name[1:-1]
  1457	        names.append(name)
  1458	    return names
  1459	
