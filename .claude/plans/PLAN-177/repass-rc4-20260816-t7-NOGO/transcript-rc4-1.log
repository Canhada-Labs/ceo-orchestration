  1461	def _contract_rows(doc_text: str) -> List[List[str]]:
  1462	    """The `## Contract` table as [control, mechanism, status, where]."""
  1463	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1464	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1465	    rows = []
  1466	    for line in m.group(0).splitlines():
  1467	        line = line.strip()
  1468	        if not line.startswith("|"):
  1469	            continue
  1470	        cells = [c.strip() for c in line.strip("|").split("|")]
  1471	        if len(cells) != 4:
  1472	            continue
  1473	        if cells[0] == "Control" or set(cells[0]) <= set("- :"):
  1474	            continue
  1475	        rows.append(cells)
  1476	    return rows
