   200	def _parse_verdict(text: str) -> Dict[str, object]:
   201	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   202	
   203	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   204	    of `  - item` list entries, and ignores everything else. Anything it cannot
   205	    read is absent, and every consumer below treats absent as fail-closed.
   206	
   207	    Parity with the step-15 reader (`.github/scripts/
   208	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   209	    scope: block selection (the regex below is the validator's own — the
   210	    first ```yaml fence, not the first fence of any language) and inline
   211	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   212	    parse_verdict_file reads key:value and sub-dicts and would drop
   213	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   214	    ONE shared reader (this file is the declared reference), never grow a
   215	    third parser of the same signed file.
   216	    """
   217	    fields: Dict[str, object] = {}
   218	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   219	    if block is None:
   220	        # No yaml block -> no fields -> every consumer below fails closed.
   221	        return fields
   222	    cur_list: Optional[str] = None
   223	    for raw in block.group(1).splitlines():
   224	        line = _strip_yaml_comment(raw)
   225	        if not line.strip():
   226	            continue
   227	        if line.startswith(("  - ", "- ")) and cur_list:
   228	            item = line.split("-", 1)[1].strip()
   229	            if item:
   230	                fields[cur_list].append(item)  # type: ignore[union-attr]
   231	            continue
   232	        # [ \t]* not \s* (t5 P1): Python \s is Unicode-aware and would
   233	        # swallow a NBSP that must stay attached to the VALUE.
   234	        m = re.match(r"\A([A-Za-z0-9_]+):(?:[ \t]+(.*))?\Z", line)
   235	        if not m:
   236	            continue
   237	        key, val = m.group(1), (m.group(2) or "").strip(" \t")
   238	        if val == "":
   239	            fields[key] = []
   240	            cur_list = key
   241	        else:
   242	            fields[key] = val
   243	            cur_list = None
   244	    return fields
   245	
   246	
   247	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   248	# The two readers of this signed file disagreed about what a key IS: the
   249	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   250	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   251	# file demand the colon immediately after the name, so they skipped the line.
   252	# The valid-YAML pair
   253	#
   254	#     verdict : NO-GO
   255	#     verdict: GO
   256	#
   257	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   258	# and this is the rail that enforces in every mode, so the tag was authorised.
   259	#
   260	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   261	# fail-closed. Trimming the key in both readers would also close the
   262	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   263	# author writes and no template emits; refusing the shape is the smaller
   264	# surface and is the only behaviour that cannot silently prefer a value.
   265	# A top-level line is canonical iff it is `name:` with no whitespace before
   266	# the colon, or a `- ` list item.
   267	def _strip_yaml_comment(raw):
   268	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   269	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   270	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Byte-for-
   271	    byte twin of `_strip_comment` in validate-pair-rail-verdict.py.
   272	    """
   273	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   274	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   275	    if raw.lstrip(" \t").startswith("#"):
   276	        return ""
   277	    i = 0
   278	    while True:
   279	        j = raw.find("#", i)
   280	        if j == -1:
   281	            return raw.rstrip(" \t")
   282	        if j > 0 and raw[j - 1] in (" ", "\t"):
   283	            return raw[:j].rstrip(" \t")
   284	        i = j + 1
   285	
   286	
   287	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   288	
   289	
   290	def _noncanonical_top_level_lines(text: str) -> List[str]:
   291	    """Top-level lines of the yaml block that are not canonical declarations.
   292	
   293	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   294	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   295	    separate machines; neither may import the other — keep them identical).
   296	    Empty list == the block speaks the grammar both readers assume.
   297	    """
   298	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   299	    if block is None:
   300	        return []
   301	    bad: List[str] = []
   302	    prev_scalar_decl = False
   303	    for raw in block.group(1).splitlines():
   304	        line = _strip_yaml_comment(raw)
   305	        if not line.strip():
   306	            continue
   307	        if line[0] in (" ", "\t"):
   308	            # Sub-level line. Legitimate ONLY under a parent declared as a
   309	            # bare `key:` (mapping/list). After a SCALAR `key: value`, an
   310	            # indented non-comment line is a YAML CONTINUATION that changes
   311	            # the scalar's value (`verdict: GO` + `  NO-GO` == "GO NO-GO")
   312	            # while this minimal reader still saw `GO` — reject fail-closed
   313	            # (re-pass rc.4 t2 P1).
   314	            if prev_scalar_decl:
   315	                bad.append(line)
   316	            continue
   317	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   318	            _key, _, _val = line.partition(":")
   319	            prev_scalar_decl = bool(_val.strip())
   320	            continue
   321	        if line.startswith("- "):  # top-level list item
   322	            prev_scalar_decl = False
   323	            continue
   324	        bad.append(line)
   325	        prev_scalar_decl = False
   326	    return bad
   327	
   328	
   329	def _count_top_level_key(text: str, key: str) -> int:
   330	    """How many times `key:` is declared at the top level of the block.
   331	
   332	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   333	    step-15 reader: a second `verdict:` silently overrides the first, so
   334	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   335	    block selection and same comment rule as the reader, or the count
   336	    would be about a different text than the parse.
   337	
   338	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   339	    counter does NOT strip the key and the step-15 twin does, so on a
   340	    non-canonical block the two counts differ. delta() checks the shape
   341	    first.
   342	    """
   343	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   344	    if block is None:
   345	        return 0
   346	    seen = 0
   347	    for raw in block.group(1).splitlines():
   348	        line = _strip_yaml_comment(raw)
   349	        if not line.strip() or line[0] in (" ", "\t"):
   350	            continue
   351	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   352	        if m and m.group(1) == key:
   353	            seen += 1
   354	    return seen
   355	
   356	
   357	def _sha256(path: str) -> str:
   358	    h = hashlib.sha256()
   359	    with open(path, "rb") as fh:
   360	        for chunk in iter(lambda: fh.read(65536), b""):
   361	            h.update(chunk)
   362	    return h.hexdigest()
   363	
   364	
   365	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   366	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   367	    entries: List[Tuple[str, str]] = []
   368	    with open(path, encoding="utf-8") as fh:
   369	        for line in fh:
   370	            line = line.rstrip("\n")
   371	            if not line.strip():
   372	                continue
   373	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   374	            if not m:
   375	                raise ValueError("unparsable manifest line: %r" % line)
   376	            entries.append((m.group(1), m.group(2)))
   377	    return entries
   378	
   379	
   380	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   381	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   382	    directory = os.path.dirname(manifest) or "."
   383	    name = os.path.basename(manifest)
   384	    try:
   385	        proc = subprocess.run(
   386	            ["shasum", "-a", "256", "-c", name],
   387	            cwd=directory,
   388	            stdout=subprocess.PIPE,
   389	            stderr=subprocess.STDOUT,
   390	            universal_newlines=True,
   391	        )
   392	        return proc.returncode == 0, proc.stdout.strip()
   393	    except (OSError, FileNotFoundError):
   394	        bad: List[str] = []
   395	        for want, rel in _read_manifest(manifest):
   396	            full = os.path.join(directory, rel)
   397	            if not os.path.isfile(full) or _sha256(full) != want:
   398	                bad.append(rel)
   399	        if bad:
   400	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   401	        return True, "hashlib fallback: all entries match"
   402	
   403	
   404	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   405	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   406	    verdict_abs = os.path.join(repo, verdict_rel)
   407	    if not os.path.isfile(verdict_abs):
   408	        return _fail(
   409	            E_VERDICT,
   410	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   411	            "be committed before the tag is cut (release.yml validates it per "
   412	            "tag on the tagged tree)." % verdict_rel,
   413	        )
   414	    with open(verdict_abs, encoding="utf-8") as fh:
   415	        verdict_text = fh.read()
   416	    # PLAN-177 t2 (P1-a): SHAPE BEFORE ANY FIELD. Both rails read this file;
   417	    # they only agree on a canonical block. A non-canonical top-level line is
   418	    # refused here rather than handed to two different grammars — E_DECISION
   419	    # because the class this closes is the decision override (`verdict :
   420	    # NO-GO` + `verdict: GO`), and because a refusal that names the decision
   421	    # rail is the one an operator can act on.
   422	    noncanonical = _noncanonical_top_level_lines(verdict_text)
   423	    if noncanonical:
   424	        return _fail(
   425	            E_DECISION,
   426	            "verdict %s: non-canonical top-level key syntax %r -- a "
   427	            "top-level line must be\n"
   428	            "      `name:` with no whitespace before the colon (or a `- ` "
   429	            "list item). The two release rails read this\n"
   430	            "      file with different grammars, so `verdict : NO-GO` "
   431	            "followed by `verdict: GO` counts as two\n"
   432	            "      declarations server-side and one here; the shape is "
   433	            "refused instead of guessed."
   434	            % (verdict_rel, noncanonical),
   435	        )
   436	    fields = _parse_verdict(verdict_text)
   437	
   438	    release_tag = fields.get("release_tag")
   439	    if release_tag != tag:
   440	        return _fail(
   441	            E_VERDICT,
   442	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   443	            "to judge this tag against another tag's verdict."
   444	            % (verdict_rel, release_tag, tag),
   445	        )
   446	    # PLAN-177 W0.1 (P1-4) -- the DECISION gate.
   447	    #
   448	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on): the
   449	    # server-side twin (.github/scripts/validate-pair-rail-verdict.py, step
   450	    # 15) carries `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   451	    # (release.yml:689) -- there the decision check is defence in depth.
   452	    # THIS is the rail that enforces in every mode: release.sh calls it with
   453	    # `|| die`, and the release.yml step that calls it carries no escape
   454	    # hatch. Neither may be dropped for the other.
   455	    #
   456	    # Fail-CLOSED on SHAPE as well as value (CF-1): _parse_verdict returns a
   457	    # LIST for an empty `verdict:` line, so the type check precedes the
   458	    # compare -- a malformed decision is a named refusal, never a crash.
   459	    declared_decisions = _count_top_level_key(verdict_text, "verdict")
   460	    if declared_decisions > 1:
   461	        return _fail(
   462	            E_DECISION,
   463	            "verdict %s declares the decision %d times -- this reader "
   464	            "is last-wins, so a duplicated\n"
   465	            "      `verdict:` silently overrides the first; exactly one "
   466	            "is required."
   467	            % (verdict_rel, declared_decisions),
   468	        )
   469	    decision = fields.get("verdict")
   470	    if decision is None:
   471	        shown = "<absent>"
   472	    elif not isinstance(decision, str):
   473	        shown = "<non-string:%s>" % type(decision).__name__
   474	    else:
   475	        # ASCII-only trim (t5 P1) — twin of the server validator.
   476	        shown = decision.strip(" \t")
   477	    if shown not in ACCEPTED_DECISIONS:
   478	        return _fail(
   479	            E_DECISION,
   480	            "verdict %s: decision '%s' not in {%s} -- a tag may only be "
   481	            "cut on an authorizing decision.\n"
   482	            "      Everything the checks below assert (anchor, closed "
   483	            "allowlist, manifest content) is about WHICH TREE the\n"
   484	            "      re-pass saw; this one is about what the re-pass SAID "
   485	            "about it. A NO-GO over a perfect delta is still a NO-GO."
   486	            % (verdict_rel, shown, ", ".join(ACCEPTED_DECISIONS)),
   487	        )
   488	    parent = fields.get("parent_sha")
   489	    if not isinstance(parent, str) or not HEX40.match(parent):
   490	        return _fail(
   491	            E_VERDICT,
   492	            "verdict %s has no usable 40-hex `parent_sha:` — that field IS "
   493	            "the review anchor." % verdict_rel,
   494	        )
   495	    rc, _out, _err = _git(repo, "cat-file", "-e", parent + "^{commit}")
   496	    if rc != 0:
   497	        return _fail(
   498	            E_VERDICT,
   499	            "parent_sha %s from %s is not a commit in this repo."
   500	            % (parent, verdict_rel),
   501	        )
   502	    # Existence is not lineage. A fabricated anchor (`git commit-tree` over
   503	    # HEAD's own tree, parented anywhere, on no branch) passes `cat-file -e`
   504	    # and makes diff(parent..HEAD) contain ONLY the verdict + evidence while
   505	    # unreviewed work sits on main — every check below then passes and the
   506	    # guard prints approval over a tree the re-pass never saw. The anchor has
   507	    # to be a commit HEAD actually descends from. (The staged W1 server-side
   508	    # port asserts the same against origin/main — keep the two in sync.)
   509	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", parent, "HEAD")
   510	    if rc == 1:
   511	        return _fail(
   512	            E_PARENT_NOT_ANCESTOR,
   513	            "parent_sha %s from %s is not an ancestor of HEAD — the review "
   514	            "anchor is not in\n"
   515	            "      the history this tag would sign. `cat-file -e` proves the "
   516	            "object exists, not\n"
   517	            "      that main descends from it; a fabricated commit carrying "
   518	            "HEAD's own tree\n"
   519	            "      makes the delta below trivially clean while unreviewed "
   520	            "work rides the tag."
   521	            % (parent[:12], verdict_rel),
   522	        )
   523	    if rc != 0:
   524	        return _fail(
   525	            E_PARENT_NOT_ANCESTOR,
   526	            "`git merge-base --is-ancestor %s HEAD` exited %d (neither yes "
   527	            "nor no) — refusing to guess (git said: %s)"
   528	            % (parent[:12], rc, err.strip()),
   529	        )
   530	    print("  ok   parent_sha %s is an ancestor of HEAD" % parent[:12])
   531	
   532	    allow = fields.get("delta_allowlist")
   533	    if not isinstance(allow, list) or not allow:
   534	        return _fail(
   535	            E_VERDICT,
   536	            "verdict %s carries no `delta_allowlist:` entries — the closed "
   537	            "set is what makes the delta assert meaningful." % verdict_rel,
   538	        )
   539	    for entry in allow:
   540	        if any(ch in entry for ch in GLOB_CHARS):
   541	            return _fail(
   542	                E_VERDICT,
   543	                "delta_allowlist entry %r contains a glob metacharacter. The "
   544	                "set is CLOSED and literal: a pattern like "
   545	                "`pair-rail-verdict-*.md` would let a historical verdict or "
   546	                "the template be edited and still pass." % entry,
   547	            )
   548	        if entry.startswith("/") or ".." in entry.split("/"):
   549	            return _fail(
   550	                E_VERDICT,
   551	                "delta_allowlist entry %r must be a repo-relative path with "
   552	                "no `..` segment." % entry,
   553	            )
   554	        if entry.startswith(VERDICT_PREFIX) and entry != verdict_rel:
   555	            return _fail(
   556	                E_VERDICT,
   557	                "delta_allowlist entry %r is another tag's verdict (or the "
   558	                "template). Only %s may move for this tag."
   559	                % (entry, verdict_rel),
   560	            )
