  2368	# PLAN-177 t2 (re-pass rc.4 P1-a) -- the GRAMMAR the two rails share.
  2369	#
  2370	# `verdict : NO-GO` is valid YAML and last-wins under a real parser. The
  2371	# server validator strips the key, so it counted TWO declarations; the local
  2372	# tag guard's regex required the colon immediately after the name, so it
  2373	# counted ONE and parsed GO -- and the local guard is the rail with no escape
  2374	# hatch. The first round of controls could not see this: every fixture line
  2375	# was built as `"verdict: %s"`, which can only produce canonical keys.
  2376	#
  2377	# Cured semantics (identical in both files): non-canonical top-level syntax
  2378	# is REFUSED. So the duplicate variants are red for the SHAPE, and the single
  2379	# non-canonical key is red too -- an authorizing decision must be spelled the
  2380	# one way the template spells it.
  2381	_NONCANONICAL_DIAGNOSTIC = "non-canonical top-level key syntax"
  2382	_NONCANONICAL_DECISIONS = [
  2383	    [("verdict ", "NO-GO"), "GO"],
  2384	    [("verdict\t", "NO-GO"), "GO"],
  2385	    [("verdict ", "GO")],
  2386	    [("verdict\t", "GO")],
  2387	    # Re-pass rc.4 t2 P1: an INDENTED CONTINUATION line after the scalar —
  2388	    # valid YAML resolving to the non-authorizing scalar "GO NO-GO", which
  2389	    # both minimal readers previously read as `GO` (indented lines were
  2390	    # unconditionally skipped). Written verbatim by _decision_line.
  2391	    ["GO\n  NO-GO"],
  2392	]
  2393	_NONCANONICAL_IDS = [
  2394	    "space-before-colon-duplicate", "tab-before-colon-duplicate",
  2395	    "space-before-colon-alone", "tab-before-colon-alone",
  2396	    "indented-continuation",
  2397	]
  2398	
