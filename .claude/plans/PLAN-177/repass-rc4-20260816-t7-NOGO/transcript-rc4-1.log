  1369	def _bare_version_offenders_in_npm_docs(repo_root: Path) -> List[str]:
  1370	    """Bare `X.Y.Z` in a scanned npm doc, outside a review stamp. Takes the
  1371	    root as an ARGUMENT so the positive control can plant the defect in a tmp
  1372	    tree and never write into the repo under test."""
