   186	
   187	def count_top_level_key(text: str, key: str) -> int:
   188	    """How many times `key:` is declared at the top level of the block.
   189	
   190	    Both readers of this signed file are LAST-WINS, so a second
   191	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   192	    as GO. Callers require exactly one.
   193	
   194	    Only meaningful once `noncanonical_top_level_lines` is empty: this
   195	    counter strips the key, so it sees `verdict : X` as a declaration and
   196	    the twin counter in the tag guard does not. Callers run the shape
   197	    check FIRST.
   198	    """
   199	    m = _YAML_BLOCK_RE.search(text)
   200	    if not m:
   201	        return 0
   202	    seen = 0
   203	    for raw in m.group(1).splitlines():
   204	        line = _strip_comment(raw)
   205	        if not line.strip() or line[0] in (" ", "\t"):
   206	            continue
   207	        if line.partition(":")[0].strip() == key:
   208	            seen += 1
   209	    return seen
   210	
   211	
   212	def parse_verdict_text(text: str) -> Dict[str, Any]:
   213	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   214	    m = _YAML_BLOCK_RE.search(text)
   215	    if not m:
   216	        raise ValueError("verdict file missing yaml frontmatter block")
   217	    yaml_body = m.group(1)
   218	    # Inline minimal YAML parse (stdlib only)
   219	    out: Dict[str, Any] = {}
   220	    current_key: Optional[str] = None
   221	    for raw in yaml_body.splitlines():
   222	        line = _strip_comment(raw)
   223	        if not line.strip():
   224	            continue
   225	        if line[0] not in (" ", "\t"):
   226	            if ":" in line:
   227	                k, _, v = line.partition(":")
   228	                # ASCII-only value trim (t5 P1): a Unicode strip() would
   229	                # normalize `GO<U+00A0>` into the exact authorizing token.
   230	                v = v.strip(" \t")
   231	                if v:
   232	                    out[k.strip(" \t")] = v
   233	                else:
   234	                    out[k.strip(" \t")] = {}
   235	                    current_key = k.strip(" \t")
   236	        elif current_key and ":" in line:
   237	            sub_k, _, sub_v = line.partition(":")
   238	            if isinstance(out[current_key], dict):
   239	                out[current_key][sub_k.strip(" \t")] = sub_v.strip(" \t")
   240	    return out
   241	
   242	
   243	def parse_verdict_file(path: Path) -> Dict[str, Any]:
   244	    """Path wrapper over parse_verdict_text (published entry point)."""
   245	    if not path.exists():
   246	        raise FileNotFoundError(f"verdict file: {path}")
   247	    return parse_verdict_text(path.read_text(encoding="utf-8"))
