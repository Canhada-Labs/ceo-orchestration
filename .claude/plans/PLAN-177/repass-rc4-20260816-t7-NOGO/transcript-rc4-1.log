  1813	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1814	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1815	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1816	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1817	    even standing somewhere that can be checked?" — the question the file
  1818	    failed on the day it shipped."""
  1819	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1820	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1821	
  1822	    # The sweep must be looking at the right text: intro present, table absent.
  1823	    swept = _prose_outside_the_declared_zones(doc)
  1824	    assert "Integrity contract for the" in swept, (
  1825	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1826	        "the prose it exists to watch"
  1827	    )
  1828	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1829	    assert len(swept) > len(doc) // 3, (
  1830	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1831	        % (len(swept), len(doc))
  1832	    )
  1833	
  1834	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1835	    # merits. The order matters and was learned the hard way — the controls
  1836	    # below build their fixtures FROM the live file, so when the file itself
  1837	    # carries a planted defect they fail first and the red names the fixture
  1838	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1839	    # always reds on the assertion that describes what is actually wrong.
  1840	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1841	    offenders = _enforcement_vocabulary_offenders(doc)
  1842	    assert not offenders, (
  1843	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1844	        "§Not yet automated. Move the claim into a table row (with a step the "
  1845	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1846	    )
  1847	
  1848	    # (b) positive control: the historical claim restored to the introduction.
  1849	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1850	    # today's wording — an anchor on current prose stops matching the moment
  1851	    # that prose is edited, and then the control fails for the wrong reason.
  1852	    title, _, rest = doc.partition("\n")
  1853	    claim = (
  1854	        "The integrity controls enforced today are: (1) the `install.sh` "
  1855	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1856	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1857	    )
  1858	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1859	    assert relapse != doc, "relapse fixture did not patch the doc"
  1860	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1861	    assert any("enforced today" in o for o in relapse_offenders), (
  1862	        "an enforcement claim in the introduction went unseen: %s"
  1863	        % relapse_offenders
  1864	    )
  1865	    assert any("recorded by" in o for o in relapse_offenders), (
  1866	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1867	    )
  1868	
  1869	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1870	    # offender. This is the predicate as documented, not a global grep — that
  1871	    # section is where honest prose about absence has to be able to use these
  1872	    # words. Its own honesty is held by the restatement test above; a claim
  1873	    # parked there is the residual gap, and it is a narrow, watched one.
  1874	    marker = "## Not yet automated"
  1875	    assert marker in doc
  1876	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1877	    assert not _enforcement_vocabulary_offenders(parked), (
  1878	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1879	        "a declared zone"
  1880	    )
  1881	
  1882	
  1883	# --------------------------------------------------------------------------
  1884	# Supply-chain honesty: the two claims that survive being corrected in one file
  1885	#
  1886	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  1887	# was green while `npm/README.md` — the README an npm consumer actually
  1888	# RECEIVES, it is in package.json `files` — still promised "SLSA 3 provenance",
  1889	# and while README.pt-BR, INSTALL.md and both QUICKSTARTs repeated Level 3 and
  1890	# a checksum coverage the release does not have (repass-rc4 part 2, P1 §2).
  1891	# A single-file gate cannot see that class, so the surface list below is
  1892	# EXPLICIT, and `_live_doc_surfaces()` re-derives the population from the repo
  1893	# so a NEW document carrying either claim also lands in front of the gate.
  1894	#
  1895	# `.claude/**` is deliberately outside the population: plans, debates and
  1896	# archived verdicts are historical records, and they have to be able to quote a
  1897	# false claim verbatim without turning this gate red.
  1898	# --------------------------------------------------------------------------
  1899	
  1900	SUPPLY_CHAIN_HONESTY_SURFACES = (
  1901	    "README.md",
  1902	    "README.pt-BR.md",
  1903	    "npm/README.md",
  1904	    "npm/INTEGRITY.md",
  1905	    "INSTALL.md",
  1906	    "SECURITY.md",
  1907	    "SUPPORT.md",
  1908	    "SBOM.md",
  1909	    "docs/QUICKSTART.md",
  1910	    "docs/QUICKSTART.pt-BR.md",
  1911	    "docs/CTO-GUIDE.md",
  1912	    "docs/threat-model.md",
  1913	)
  1914	
  1915	# "SLSA 3", "SLSA-3", "SLSA Level 3", "SLSA L3", "SLSA provenance L3" and
  1916	# "provenance (SLSA L3)" all normalise to the same false claim. The earlier
  1917	# pattern only caught the first three, which is why `SBOM.md` ("SLSA L3") and
  1918	# `docs/QUICKSTART.md` ("SLSA provenance L3") were invisible to it.
  1919	_SLSA_LEVEL3_CLAIM = re.compile(
  1920	    r"SLSA[\s\-]*(?:provenance[\s\-]*)?(?:Level[\s\-]*|L)?3\b"
  1921	    r"|(?:provenance|attestation)[\s\-]*(?:Level[\s\-]*|L)3\b",
  1922	    re.IGNORECASE,
  1923	)
  1924	
  1925	# Plural = aggregate. Release checksum coverage is `install.sh` alone
  1926	# (SECURITY.md §How to verify what you install); "ships SHA-256 checksums"
  1927	# promises a SHA256SUMS that no workflow produces.
  1928	_CHECKSUM_AGGREGATE_CLAIM = re.compile(
  1929	    r"SHA-?256\s+checksums|checksums\s+SHA-?256", re.IGNORECASE
  1930	)
  1931	
  1932	
  1933	def _live_doc_surfaces() -> List[Path]:
  1934	    """Root-level, `docs/` and `npm/` markdown — every document a reader or an
  1935	    npm consumer meets. Deliberately NOT `.claude/**` (see the block comment)."""
  1936	    found = sorted(REPO_ROOT.glob("*.md"))
  1937	    for sub in ("docs", "npm"):
  1938	        base = REPO_ROOT / sub
  1939	        if base.exists():
  1940	            found += sorted(base.rglob("*.md"))
  1941	    return found
  1942	
  1943	
  1944	def test_slsa_and_checksum_claims_are_true_on_every_shipped_surface():
  1945	    """The npm consumer reads `npm/README.md`; the Portuguese reader reads
  1946	    `README.pt-BR.md`. Correcting the root README alone left both promising a
  1947	    Level the pipeline never reaches. The gate now runs over an explicit list
  1948	    AND over every live doc, so neither a missed translation nor a new file can
  1949	    carry the claim silently."""
  1950	    surfaces = {p.relative_to(REPO_ROOT).as_posix(): p for p in _live_doc_surfaces()}
  1951	
  1952	    # (a) The explicit list is not allowed to name a file that stopped
  1953	    # existing: a surface silently dropped from the repo is a gate that
  1954	    # quietly narrows.
  1955	    missing = [s for s in SUPPLY_CHAIN_HONESTY_SURFACES if s not in surfaces]
  1956	    assert not missing, "declared honesty surfaces that no longer exist: %s" % missing
  1957	
  1958	    offenders: List[str] = []
  1959	    for rel, path in surfaces.items():
  1960	        text = path.read_text(encoding="utf-8")
  1961	        for m in _SLSA_LEVEL3_CLAIM.finditer(text):
  1962	            # Tolerance is scoped to what FOLLOWS the mention, never to the
  1963	            # line: the honest sentence names Level 2 and disclaims Level 3 in
  1964	            # one breath, so a line-wide exemption would let the false claim
  1965	            # ride along beside its own disclaimer. The window is 120 chars
  1966	            # because the live disclaimer parenthesises its reason
  1967	            # ("(hermetic build + two-party review) is out of scope") — at the
  1968	            # old width of 40 the only honest Level-3 sentence in the repo
  1969	            # would have been the gate's first false positive.
  1970	            tail = text[m.end():m.end() + 120]
  1971	            if "out of scope" in tail or "fora de escopo" in tail:
  1972	                continue
  1973	            offenders.append(
  1974	                "%s: ...%s..."
  1975	                % (rel, text[max(0, m.start() - 60):m.end() + 40].strip().replace("\n", " "))
  1976	            )
  1977	        for m in _CHECKSUM_AGGREGATE_CLAIM.finditer(text):
  1978	            offenders.append(
  1979	                "%s: ...%s..."
  1980	                % (rel, text[max(0, m.start() - 70):m.end() + 30].strip().replace("\n", " "))
  1981	            )
  1982	
  1983	    assert not offenders, (
  1984	        "shipped docs claim SLSA Level 3 and/or aggregate release checksums; "
  1985	        "the pipeline reaches Level 2 (`npm publish --provenance`) and the "
  1986	        "release checksum covers `install.sh` only:\n%s" % "\n".join(offenders)
  1987	    )
  1988	
  1989	    # (b) Positive statement, on the two most-read surfaces: silence about the
  1990	    # level is not honesty either. The npm README is named explicitly because
  1991	    # it is the one that travels inside the tarball.
  1992	    for rel in ("README.md", "npm/README.md"):
  1993	        text = surfaces[rel].read_text(encoding="utf-8")
  1994	        assert "SLSA **Level 2**" in text or "SLSA Level 2" in text, (
  1995	            "%s no longer states the level the pipeline reaches" % rel
  1996	        )
  1997	
  1998	
  1999	# --------------------------------------------------------------------------
  2000	# The npm signature recipe has to audit the thing the reader just installed
  2001	#
  2002	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2003	# no package-selecting positional (a trailing package name is ignored), and it
  2004	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2005	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2006	# with `npm audit signatures` verified nothing the reader had just installed —
  2007	# it audited whatever directory they happened to be standing in, and could
  2008	# return a confident green having examined a different tree entirely.
  2009	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2010	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2011	# project install followed by a BARE `npm audit signatures`.
  2012	# --------------------------------------------------------------------------
  2013	
  2014	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2015	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2016	# (ephemeral — nothing is left in a dependency tree to audit).
  2017	_UNAUDITABLE_INSTALL = re.compile(
  2018	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2019	)
  2020	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2021	# the reader believes it selected a package. `#` is excluded so the honest
  2022	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2023	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2024	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2025	_AUDIT_GLOBAL_FLAG = re.compile(
  2026	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2027	)
  2028	
  2029	
  2030	def _recipe_units(text: str) -> List[tuple]:
  2031	    """(label, body) for each fenced code block, and for each line outside one.
  2032	
  2033	    A recipe is what a reader copies, and they copy a whole code block — so the
  2034	    block, not the line, is the unit in which "install here, audit there" has
  2035	    to be judged. Prose lines are units of their own so a one-line table row
  2036	    (the shape `SUPPORT.md` used) is still examined."""
  2037	    units: List[tuple] = []
  2038	    block: Optional[List] = None
  2039	    for num, line in enumerate(text.splitlines(), 1):
  2040	        if line.strip().startswith("```"):
  2041	            if block is None:
  2042	                block = [num, []]
  2043	            else:
  2044	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2045	                block = None
  2046	            continue
  2047	        if block is not None:
  2048	            block[1].append(line)
  2049	        else:
  2050	            units.append(("line@%d" % num, line))
  2051	    if block is not None:  # unterminated fence: judge what we collected
  2052	        units.append(("block@%d" % block[0], "\n".join(block[1])))
  2053	    return units
  2054	
  2055	
  2056	def test_documented_npm_signature_recipe_matches_what_npm_audits():
  2057	    """Every documented `npm audit signatures` has to be reachable by npm.
  2058	
  2059	    A recipe offends when its unit pairs the command with an install npm cannot
  2060	    audit, passes a positional npm ignores, or passes `--global`, which npm
  2061	    rejects. Naming `EAUDITGLOBAL` in the unit is the tolerance: a document is
  2062	    free — and encouraged — to put the global install next to the command in
  2063	    order to say that the command does NOT reach it."""
  2064	    offenders: List[str] = []
  2065	    units_examined = 0
  2066	    for path in _live_doc_surfaces():
  2067	        rel = path.relative_to(REPO_ROOT).as_posix()
  2068	        text = path.read_text(encoding="utf-8")
  2069	        if not _AUDIT_SIGNATURES.search(text):
  2070	            continue
  2071	        for label, unit in _recipe_units(text):
  2072	            if not _AUDIT_SIGNATURES.search(unit):
  2073	                continue
  2074	            units_examined += 1
  2075	            faults = []
  2076	            if _UNAUDITABLE_INSTALL.search(unit) and "EAUDITGLOBAL" not in unit:
  2077	                faults.append(
  2078	                    "pairs the audit with an install npm cannot audit "
  2079	                    "(global, or exec/npx leaving no dependency behind)"
  2080	                )
  2081	            positional = _AUDIT_POSITIONAL.search(unit)
  2082	            if positional:
  2083	                faults.append(
  2084	                    "passes the positional %r, which npm ignores — the audit "
  2085	                    "still reads the current project" % positional.group(1)
  2086	                )
  2087	            if _AUDIT_GLOBAL_FLAG.search(unit):
  2088	                faults.append("passes --global, which npm rejects (EAUDITGLOBAL)")
  2089	            if faults:
  2090	                offenders.append(
  2091	                    "%s %s: %s\n    %s"
  2092	                    % (rel, label, "; ".join(faults), unit.strip()[:160])
  2093	                )
  2094	
  2095	    # Vacuity guard: the sweep is worthless if it found no recipe to judge.
  2096	    assert units_examined >= 5, (
  2097	        "only %d recipe units examined — the sweep lost sight of the docs it "
  2098	        "exists to watch" % units_examined
  2099	    )
  2100	    assert not offenders, (
  2101	        "documented `npm audit signatures` recipes do not audit what the "
  2102	        "reader installed:\n%s" % "\n\n".join(offenders)
  2103	    )
  2104	
  2105	
  2106	def test_checklist_attributes_repo_exhaustiveness_to_the_scanner():
  2107	    """The checklist read as a census OF THE REPOSITORY while it was a census
  2108	    of the driver's TABLE — which is why `npm/INTEGRITY.md` could hold a stale
  2109	    version and the checklist still be, on its own terms, true. It now says
  2110	    which instrument answers for the repo, and names the roots that
