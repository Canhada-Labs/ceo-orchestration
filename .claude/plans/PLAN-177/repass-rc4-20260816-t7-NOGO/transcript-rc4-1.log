  2264	def _write_live_shaped_verdict(
  2265	    path: Path, tag: str, decisions: Sequence[str], parent: str
  2266	) -> None:
  2267	    """A verdict envelope the LIVE governance files accept end to end.
  2268	
  2269	    `decisions` is a SEQUENCE so the fixture can express the three shapes the
  2270	    gate must separate: zero lines (absent), one line (normal), two lines (the
  2271	    last-wins override). Values are written verbatim -- a malformed or unknown
  2272	    token reaches the validator exactly as authored.
  2273	    """
  2274	    tv = _live_tool_versions()
  2275	    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
  2276	    lines = ["# Pair-Rail Verdict -- fixture", "", "```yaml"]
  2277	    lines += [_decision_line(d).rstrip("\n") for d in decisions]
  2278	    lines += [
  2279	        "generated_at: %sZ" % now,
  2280	        "ttl_hours: 24",
  2281	        "parent_sha: %s" % parent,
  2282	        "release_tag: %s" % tag,
  2283	        "inputs_hash: %s" % _live_inputs_hash(),
  2284	        "tool_versions:",
  2285	        "  codex_cli: %s" % tv["codex_cli"],
  2286	        "  codex_target_triple: %s" % tv["codex_target_triple"],
  2287	        "  codex_payload_sha256: %s" % tv["codex_payload_sha256"],
  2288	        "gpg_signature: -----BEGIN PGP SIGNATURE----- fixture-not-a-signature",
  2289	        "```",
  2290	        "",
  2291	    ]
  2292	    path.write_text("\n".join(lines), encoding="utf-8")
  2293	
