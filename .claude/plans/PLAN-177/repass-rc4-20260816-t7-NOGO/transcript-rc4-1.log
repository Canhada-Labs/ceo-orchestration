# =====================  CHANGELOG HEADER RULE (scoped)  =====================
# PLAN-166 W2 rc.3 (GA re-pass part-1 P1): the CHANGELOG header carries a
# four-count "as of vX.Y.Z: N skills, N slash commands, N ADRs, N `_lib`
# modules" claim that no matcher watched — it sat at 188 ADRs while disk
# had 190 and this gate stayed green. CHANGELOG.md deliberately does NOT
# join DOCS: the log BODY legitimately carries historical counts (184,
# 178, 171, ...) that every metric matcher would flag as drift. Only the
# header claim is enforced, by this dedicated scoped rule. Fail modes:
# stale count (exact mismatch) AND dead matcher (header rephrased so the
# regex stops matching -> violation, never silence).
CHANGELOG_DOC = "CHANGELOG.md"
try:
    _chlog_text = open(os.path.join(root, CHANGELOG_DOC), encoding="utf-8").read()
except OSError:
    _chlog_text = ""
_CHLOG_HEADER_RX = re.compile(
    r"v[\d.]+: (\d+) skills, (\d+) slash commands, (\d+) ADRs, "
    r"(\d+) `_lib` modules\)"
)
# HEADER-scoped for real (rail rc.3 r1 P1-4): only the PREAMBLE — the text
# before the first "## [" release heading — is searched. A body claim can
# neither satisfy the matcher (masking a removed header) nor duplicate it.
_chlog_hdr_end = re.search(r"(?m)^## \[", _chlog_text)
_chlog_preamble = (
    _chlog_text[:_chlog_hdr_end.start()] if _chlog_hdr_end else _chlog_text
)
_chlog_ms = list(_CHLOG_HEADER_RX.finditer(_chlog_preamble))
if len(_chlog_ms) == 0:
    # Dead-matcher violation ONLY when the file exists: synthetic test
    # fixtures build trees without a CHANGELOG and must not fail here.
    # Real-repo liveness is NOT lost to this scoping — the census mirror
    # (test_verify_counts.py::_EXPECTED_SITES) asserts the four
    # *@CHANGELOG.md pairs exist with exact counts in the real repo, so
    # a deleted CHANGELOG or a rephrased header still fails loudly there.
    if _chlog_text:
        violations.append(
            "%s: header count claim ('as of vX.Y.Z: N skills, N slash"
            " commands, N ADRs, N `_lib` modules') not found in the"
            " preamble — matcher dead or claim rephrased"
            "  (rule: changelog/header)" % CHANGELOG_DOC
        )
elif len(_chlog_ms) > 1:
    violations.append(
        "%s: %d header count claims in the preamble — the site census"
        " requires exactly one  (rule: changelog/header)"
        % (CHANGELOG_DOC, len(_chlog_ms))
    )
else:
    _chlog_m = _chlog_ms[0]
    for _chm_metric, _chm_idx in (
        ("skills", 1), ("commands", 2), ("adrs", 3), ("lib", 4),
    ):
        _note(_chm_metric, CHANGELOG_DOC)
        _chm_v = int(_chlog_m.group(_chm_idx))
        if _chm_v != live[_chm_metric]:
            violations.append(
                "%s: header cites %s=%d, live=%d  (rule: changelog/header)"
                % (CHANGELOG_DOC, _chm_metric, _chm_v, live[_chm_metric])
            )

