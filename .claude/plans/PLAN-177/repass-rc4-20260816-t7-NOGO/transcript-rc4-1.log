  1713	# ---------------------------------------------------------------------------
  1714	# PLAN-177 W0.3 delta (codex P1-4 of the v4 round) — the generic sweep.
  1715	#
  1716	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1717	# checksum gate anchors three named phantom referents. A NEW enforcement
  1718	# promise, about some other subject, written into a section nobody watches,
  1719	# passes all of them. The original defect is the proof that this is not
  1720	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1721	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1722	#
  1723	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1724	# Contract table row (machine-checked by
  1725	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1726	# to the table's un-enforced rows by
  1727	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1728	# Anywhere else it is answerable to nothing, and is a red.
  1729	#
  1730	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1731	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1732	#
  1733	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1734	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1735	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1736	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1737	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1738	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1739	#     at the table rather than enumerating mechanisms, and the tag-signing
  1740	#     paragraph cites SECURITY.md as the authority instead of restating the
  1741	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1742	#     needs no exemption, so it has none.
  1743	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1744	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1745	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1746	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1747	#     are the file speaking about what the pipeline does.
  1748	#     A broad list that has to be switched off is worth less than a narrow
  1749	#     one that stays on.
  1750	#
  1751	# Matching is on word boundaries after normalization. Substring matching was
  1752	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1753	# substring-vs-exact class, for the fourth time in this plan.
  1754	_ENFORCEMENT_VOCAB = (
  1755	    "enforced today",
  1756	    "is enforced",
  1757	    "are enforced",
  1758	    "enforced by",
  1759	    "enforced at",
  1760	    "every tag publish",
  1761	    "recorded by",
  1762	    "is verified",
  1763	    "are verified",
  1764	    "verifies",
  1765	    "must satisfy",
  1766	    "guarantees",
  1767	    "is guaranteed",
  1768	    "are guaranteed",
  1769	    "asserted by",
  1770	    "checked by",
  1771	    "gated by",
  1772	    "fails closed",
  1773	    "fail closes",
  1774	    "asserts",
  1775	    "ensures",
  1776	    "is signed",
  1777	    "are signed",
  1778	)
  1779	
  1780	
  1781	def _normalize_prose(text: str) -> str:
  1782	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1783	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1784	    normalize the same way, so a claim cannot hide behind formatting."""
  1785	    text = text.lower()
  1786	    for ch in ("*", "`", "_"):
  1787	        text = text.replace(ch, "")
  1788	    text = text.replace("-", " ")
  1789	    return re.sub(r"\s+", " ", text)
  1790	
  1791	
  1792	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1793	    """Everything that is neither a Contract table row nor §Not yet
  1794	    automated — the surfaces where a mechanism claim answers to nothing."""
  1795	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1796	    return "\n".join(
  1797	        line for line in body.splitlines() if not line.strip().startswith("|")
  1798	    )
  1799	
  1800	
  1801	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1802	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1803	    offenders = []
  1804	    for phrase in _ENFORCEMENT_VOCAB:
  1805	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1806	            offenders.append(
  1807	                "%r outside the declared zones: ...%s..."
  1808	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1809	            )
  1810	    return offenders
  1811	
