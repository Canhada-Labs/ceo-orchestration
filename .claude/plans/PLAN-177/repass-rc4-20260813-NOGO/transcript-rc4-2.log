  1248	        for hit in SEMVER_RX.findall(line):
  1249	            # tolerated: a reference to a PAST incident. It is a historical
  1250	            # fact and cannot be derived from TARGET_BASE.
  1251	            if re.search(r"v%s-rc\.\d+" % re.escape(hit), line):
  1252	                continue
  1253	            offenders.append("%d: %s" % (num, line.strip()))
  1254	    assert not offenders, "version literals not derived from TARGET_BASE:\n%s" % (
