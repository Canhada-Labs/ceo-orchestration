   272	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   273	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   274	    entries: List[Tuple[str, str]] = []
   275	    with open(path, encoding="utf-8") as fh:
   276	        for line in fh:
   277	            line = line.rstrip("\n")
   278	            if not line.strip():
   279	                continue
   280	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   281	            if not m:
   282	                raise ValueError("unparsable manifest line: %r" % line)
   283	            entries.append((m.group(1), m.group(2)))
   284	    return entries
