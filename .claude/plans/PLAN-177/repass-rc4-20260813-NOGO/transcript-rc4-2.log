  2773	def _classify_block_reason(reason: str) -> str:
  2774	    """Map a Decision.reason string to a stable audit reason_code.
  2775	
  2776	    Defaults to ``unknown_block`` when no marker matches — visibility
  2777	    on a marker drift is preferable to silent misclassification.
