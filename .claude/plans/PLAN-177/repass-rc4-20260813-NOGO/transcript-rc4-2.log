   696	def test_fetch_failure_and_non_ancestor_are_DISTINCT(synth):
   697	    repo, env = synth["repo"], synth["env"]
   698	
   699	    # (1) origin unreachable — the check did NOT run; this is not a verdict
   700	    git(repo, env, "remote", "set-url", "origin", str(repo.parent / "does-not-exist"))
   701	    broken = guard(synth, "ancestry", "--repo", str(repo))
   702	    assert broken.returncode == tag_guard.E_FETCH, broken.stderr
   703	    assert "could not talk to origin" in broken.stderr
   704	    assert "--offline-ack" in broken.stderr
   705	
   706	    # (2) origin reachable, HEAD unpushed — a real governance stop
   707	    git(repo, env, "remote", "set-url", "origin", str(synth["origin"]))
   708	    (repo / "late.txt").write_text("landed after CI\n", encoding="utf-8")
   709	    git(repo, env, "add", "late.txt")
   710	    git(repo, env, "commit", "-q", "-m", "unpushed")
   711	    stop = guard(synth, "ancestry", "--repo", str(repo))
   712	    assert stop.returncode == tag_guard.E_NOT_ANCESTOR, stop.stderr
   713	    assert "not an ancestor" in stop.stderr
   714	    assert "could not talk to origin" not in stop.stderr
   715	
   716	    # the two failures do not share an exit code — the MODE is distinguishable
   717	    assert tag_guard.E_FETCH != tag_guard.E_NOT_ANCESTOR
