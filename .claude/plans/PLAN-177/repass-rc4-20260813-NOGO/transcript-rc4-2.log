  1100	def test_delta_refuses_to_pass_vacuously_when_the_verdict_anchors_itself(synth):
  1101	    """An anchor at (or after) the verdict makes every assert above trivially
  1102	    true: the delta is empty, and "all changed files are allowlisted" is a
  1103	    statement about nothing. That is the v1.16.0 self-reference bug wearing a
  1104	    new hat, and it is the vacuous-gate class this repo keeps paying for.
  1105	
  1106	    The guard reads the verdict from the working tree, which is what makes the
  1107	    fixture possible; the driver's own clean-tree check blocks this route
  1108	    locally, but the server-side port in release.yml reads a tree it did not
  1109	    produce, so the assert has to prove it actually saw the verdict move."""
  1110	    repo, env = synth["repo"], synth["env"]
  1111	    armed = arm_verdict(synth, "v1.3.0-rc.2")
  1112	    head = git(repo, env, "rev-parse", "HEAD")
  1113	    write_verdict(
  1114	        repo,
  1115	        "v1.3.0-rc.2",
  1116	        head,  # the commit that ALREADY contains this verdict
  1117	        [armed["verdict_rel"], armed["ev"]["manifest_rel"]]
  1118	        + armed["ev"]["artifact_rels"],
  1119	        armed["ev"]["manifest_rel"],
  1120	        armed["ev"]["manifest_sha"],
  1121	    )
  1122	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
  1123	    assert proc.returncode == tag_guard.E_VACUOUS, proc.stdout + proc.stderr
  1124	    assert "VACUOUSLY" in proc.stderr
  1125	    # and it is a DISTINCT mode from "a file landed outside the allowlist"
  1126	    assert tag_guard.E_VACUOUS != tag_guard.E_DELTA
