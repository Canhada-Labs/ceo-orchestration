   723	# =============================================================================
   724	# PLAN-177 W1 (P1-1 / CF-9) — the ONE owner of every .gitignore surface the
   725	# framework delivers.
   726	#
   727	# THE BUG. install.sh has appended two marker-guarded blocks to the adopter's
   728	# ROOT .gitignore for a long time — the MCP shared-secret store (PLAN-019
   729	# P2-SEC-H) and the posture/runtime state (PLAN-165 CX-3) — and upgrade.sh has
   730	# appended NOTHING, ever. An adopter who installed at v1.2.0 and only ever runs
   731	# upgrade.sh therefore receives /night-mode without the ignores, so
   732	# `/night-mode on` leaves .claude/settings.local.json and the state marker as
   733	# untracked files (falsifying PLAN-165 AC-1, "git status stays empty") and
   734	# risks committing a machine-specific permission posture. The parity gate NAMED
   735	# that gap and allowlisted it, so CI was structurally unable to fail on it.
   736	#
   737	# WHY BOTH BLOCKS. Owning only the posture block would leave the mcp-secrets
   738	# block as a second, unowned copy of the same kind of text on the same file —
   739	# a ceremony that grants ownership of half a surface. An adopter older than
   740	# v1.2.0 also never received the mcp-secrets entry from an upgrade.
   741	#
   742	# WHY ONE PLACE. This is INV-4 (PLAN-168 W2): install.sh and upgrade.sh each
   743	# carrying a private copy of the same emitted text is precisely the class that
   744	# produced the PROTOCOL.md pointer divergence. Both callers render through
   745	# these functions, so the routes cannot diverge again.
   746	#
   747	# BYTE-COMPATIBILITY (do not "tidy"): every emission below reproduces the
   748	# shipped install.sh output exactly, including two idiosyncrasies that a
   749	# reviewer will be tempted to clean up.
   750	#   1. The posture header comment is emitted INSIDE the loop, once per APPENDED
   751	#      entry. Hoisting it to a single header changes the bytes on every adopter
   752	#      .gitignore and breaks install/upgrade tree parity.
   753	#   2. The mcp-secrets CREATE branch (no .gitignore yet) writes the header with
   754	#      NO leading blank line, while the APPEND branch writes one. Same file,
   755	#      two shapes, by construction.
   756	# BYTE-PROOF.md plants both as mutations and requires the harness to go red.
   757	#
   758	# IDEMPOTENCE, and its deliberate limit. Re-running never duplicates a line:
   759	# every entry is `grep -Fxq` (fixed-string, whole-line) checked first. The
   760	# check is PER LINE, not per block, so an adopter who deliberately deletes one
   761	# entry gets it re-appended on the next install/upgrade — with a fresh header
   762	# comment above it. That is intentional, not an oversight: these entries exist
   763	# to keep secrets and per-machine permission posture out of VCS, so the
   764	# framework re-asserts them rather than honouring a deletion it cannot
   765	# distinguish from an accident. An adopter who truly wants the path tracked
   766	# should scope it in .git/info/exclude or a nested .gitignore instead.
   767	#
   768	# Functions:
   769	#   _mcp_secrets_ignore_entry              -> the mcp-secrets entry (one line)
   770	#   _apply_mcp_secrets_ignore GITIGNORE    -> ensure it, create-or-append
   771	#   _posture_state_ignore_entries          -> the posture entries (one line,
   772	#                                             space-separated; both callers
   773	#                                             word-split it AND print it
   774	#                                             verbatim, so the single-line
   775	#                                             shape is part of the contract)
   776	#   _apply_posture_state_ignores GITIGNORE -> ensure them, append-only
   777	#   _claude_dir_gitignore_body             -> the NEW .claude/.gitignore body
   778	#   _apply_claude_dir_gitignore CLAUDE_DIR -> create-if-missing, never rewrite
   779	# =============================================================================
   780	
   781	_mcp_secrets_ignore_entry() {
   782	  printf '%s\n' "state/mcp_client_secrets/"
   783	}
   784	
   785	_apply_mcp_secrets_ignore() {
   786	  # $1 = path to the adopter ROOT .gitignore (may not exist yet).
   787	  _msi_gitignore="$1"
   788	  _msi_line="$( _mcp_secrets_ignore_entry )"
   789	  if [ -f "$_msi_gitignore" ]; then
   790	    if ! grep -Fxq "$_msi_line" "$_msi_gitignore" 2>/dev/null; then
   791	      {
   792	        echo ""
   793	        echo "# PLAN-019 P2-SEC-H: MCP shared-secret store (never commit)"
   794	        echo "$_msi_line"
   795	      } >> "$_msi_gitignore"
   796	      echo "    APPENDED to .gitignore: $_msi_line"
   797	    else
   798	      echo "    .gitignore already excludes $_msi_line"
   799	    fi
   800	  else
   801	    {
   802	      echo "# PLAN-019 P2-SEC-H: MCP shared-secret store (never commit)"
   803	      echo "$_msi_line"
   804	    } > "$_msi_gitignore"
   805	    echo "    CREATED .gitignore with: $_msi_line"
   806	  fi
   807	  return 0
   808	}
   809	
   810	_posture_state_ignore_entries() {
   811	  printf '%s\n' ".claude/state/ .claude/settings.local.json"
   812	}
   813	
   814	_apply_posture_state_ignores() {
   815	  # $1 = path to the adopter ROOT .gitignore (append creates it if absent).
   816	  _psi_gitignore="$1"
   817	  for _psi_line in $( _posture_state_ignore_entries ); do
   818	    if [ -f "$_psi_gitignore" ] && grep -Fxq "$_psi_line" "$_psi_gitignore" 2>/dev/null; then
   819	      echo "    .gitignore already excludes $_psi_line"
