   196	def _parse_verdict(text: str) -> Dict[str, object]:
   197	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   198	
   199	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   200	    of `  - item` list entries, and ignores everything else. Anything it cannot
   201	    read is absent, and every consumer below treats absent as fail-closed.
   202	
   203	    Parity with the step-15 reader (`.github/scripts/
   204	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   205	    scope: block selection (the regex below is the validator's own — the
   206	    first ```yaml fence, not the first fence of any language) and inline
   207	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   208	    parse_verdict_file reads key:value and sub-dicts and would drop
   209	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   210	    ONE shared reader (this file is the declared reference), never grow a
   211	    third parser of the same signed file.
   212	    """
   213	    fields: Dict[str, object] = {}
   214	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   215	    if block is None:
   216	        # No yaml block -> no fields -> every consumer below fails closed.
   217	        return fields
   218	    cur_list: Optional[str] = None
   219	    for raw in block.group(1).splitlines():
   220	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   221	        if not line.strip():
   222	            continue
   223	        if line.startswith(("  - ", "- ")) and cur_list:
   224	            item = line.split("-", 1)[1].strip()
   225	            if item:
   226	                fields[cur_list].append(item)  # type: ignore[union-attr]
   227	            continue
   228	        m = re.match(r"\A([A-Za-z0-9_]+):\s*(.*)\Z", line)
   229	        if not m:
   230	            continue
   231	        key, val = m.group(1), m.group(2).strip()
   232	        if val == "":
   233	            fields[key] = []
   234	            cur_list = key
   235	        else:
   236	            fields[key] = val
   237	            cur_list = None
   238	    return fields
