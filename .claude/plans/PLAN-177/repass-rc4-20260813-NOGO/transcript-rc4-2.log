   546	def check_skill_unknown_ratio() -> Tuple[str, str, Any]:
   547	    """Detect spawns that should have SKILL injection but didn't.
   548	
   549	    S94 follow-up: excludes intentionally skill-less archetypes —
   550	    `general-purpose` subagent dispatches via the mitigated rail
   551	    (ADR-082) by design have no SKILL.md anchor. They broker cross-
   552	    LLM gate calls and similar utility work; counting them as FPs
   553	    inflates the ratio to 100% during healthy Codex MCP sessions
   554	    and trains the operator to ignore the channel.
   555	
   556	    A spawn counts as "skill missing" ONLY when its `archetype` is
   557	    a custom (non-general-purpose) one AND `skill` is unknown/empty.
   558	    That is the original PLAN-020 ADR-051 governance gap the
   559	    detector was built for.
   560	    """
   561	    total = 0
   562	    unknown = 0
   563	    ghosts_skipped = 0
   564	    harness_probes_skipped = 0
   565	    skill_less_by_design = 0
   566	    test_pollution_skipped = 0
   567	    for ev in _iter_audit_events_since(24):
   568	        if ev.get("action") != "agent_spawn":
   569	            continue
   570	        if _is_test_pollution_event(ev):
   571	            test_pollution_skipped += 1
   572	            continue
   573	        if _is_ghost_spawn_event(ev):
   574	            ghosts_skipped += 1
   575	            continue
   576	        if _is_harness_probe_event(ev):
   577	            harness_probes_skipped += 1
   578	            continue
   579	        # Skill-less by design: general-purpose archetype dispatches
   580	        # (mitigated rail per ADR-082) AND built-in subagent types like
   581	        # Explore/Plan/claude-code-guide that have no .claude/agents/<name>.md
   582	        # and so cannot carry a `Loads <skill> skill via reference` phrase
   583	        # (drift-detector contract per S143 lesson). Adding them to
   584	        # _ARCHETYPE_TO_SKILL would violate the contract — exclude here instead.
   585	        # S200: claude/claude-code-guide/statusline-setup are first-party
   586	        # Claude Code built-ins (no .claude/agents anchor); counting them as a
   587	        # governance gap is a false positive — exactly the FP class this filter
   588	        # exists to prevent (else healthy claude-code-guide use trains the
   589	        # operator to ignore the channel).
   590	        _SKILL_LESS_BUILTINS = {
   591	            "general-purpose", "Explore", "Plan",
   592	            "claude", "claude-code-guide", "statusline-setup",
   593	        }
   594	        if (
   595	            ev.get("subagent_type") in _SKILL_LESS_BUILTINS
   596	            and ev.get("archetype") in _SKILL_LESS_BUILTINS
   597	        ):
   598	            skill_less_by_design += 1
   599	            continue
   600	        total += 1
   601	        if ev.get("skill") in (None, "unknown", ""):
   602	            unknown += 1
   603	    if total == 0:
   604	        msg = (
   605	            "no custom-archetype spawns "
   606	            "({s} general-purpose, {g} ghosts, {p} harness-probes, "
   607	            "{t} test-pollution)".format(
   608	                s=skill_less_by_design, g=ghosts_skipped,
   609	                p=harness_probes_skipped, t=test_pollution_skipped,
   610	            )
   611	        )
   612	        return "green", msg, {
   613	            "unknown": 0, "total": 0,
   614	            "ghosts_skipped": ghosts_skipped,
   615	            "harness_probes_skipped": harness_probes_skipped,
   616	            "skill_less_by_design": skill_less_by_design,
   617	            "test_pollution_skipped": test_pollution_skipped,
   618	        }
   619	    ratio = unknown / total
   620	    status = "red" if ratio > 0.10 else "yellow" if ratio > 0 else "green"
   621	    return status, f"{unknown}/{total} = {ratio:.0%}", {
   622	        "unknown": unknown, "total": total,
   623	        "ghosts_skipped": ghosts_skipped,
   624	        "harness_probes_skipped": harness_probes_skipped,
   625	        "skill_less_by_design": skill_less_by_design,
   626	        "test_pollution_skipped": test_pollution_skipped,
   627	    }
