   217	STUB_FRESHNESS = '''#!/usr/bin/env python3
   218	"""Fixture stand-in for check-canonical-doc-freshness.py.
   219	
   220	Mirrors the property that matters: the gate judges the VERSION on the stamp,
   221	never the date. That is what makes freezing the date safe.
   222	"""
   223	import os, re, sys
   224	
   225	version = open("VERSION").read().strip()
   226	bad = []
   227	for path in ("npm/README.md", "SBOM.md", "SECURITY.md", "VERSIONING.md"):
   228	    if not os.path.exists(path):
   229	        continue
   230	    m = re.search(r"last-reviewed: \\d{4}-\\d{2}-\\d{2} v(\\d+\\.\\d+\\.\\d+)",
   231	                  open(path).read())
   232	    if not m or m.group(1) != version:
   233	        bad.append(path)
   234	for path in bad:
   235	    print("  !!  stale stamp: %s" % path)
   236	sys.exit(1 if bad else 0)
   237	'''
   238	
   239	
   240	def _support_window(version: str):
   241	    """(current_minor, previous_minor) the way the live oracle derives them:
   242	    prev = minor-1, None (not derivable) at X.0."""
   243	    maj, mnr = (int(x) for x in version.split(".")[:2])
   244	    prev = "%d.%d" % (maj, mnr - 1) if mnr > 0 else None
   245	    return "%d.%d" % (maj, mnr), prev
   246	
   247	
   248	def write_sites(repo: Path, version: str, stamp_date: str) -> None:
   249	    (repo / "npm").mkdir(exist_ok=True)
   250	    (repo / "docs").mkdir(exist_ok=True)
   251	    stamp = "<!-- last-reviewed: %s v%s -->" % (stamp_date, version)
   252	    cur_minor, prev_minor = _support_window(version)
   253	    prev_sec = (
   254	        "- **Previous MINOR** (`v%s.x`) — security-only patches.\n" % prev_minor
   255	        if prev_minor
   256	        else ""
   257	    )
   258	    prev_ver = (
   259	        "| Previous MINOR (`v%s.x`) | Security-only patches |\n" % prev_minor
   260	        if prev_minor
   520	    writer = {(path, kind) for path, kind, _rx in bump_sites._SITES}
   521	    writer_paths = {path for path, _kind in writer}
   522	    missing = []
   523	    for doc, mode in entries:
   524	        covered = doc in writer_paths if mode == "full" else (doc, mode) in writer
   525	        if not covered:
   526	            missing.append((doc, mode))
   527	    assert not missing, (
   528	        "verify-counts VERSION_SITES entries with NO writer site (the next "
   529	        "bump that moves these modes dies mid-phase): %s" % missing
   530	    )
