   492	def _is_test_pollution_event(ev: Dict[str, Any]) -> bool:
   493	    if ev.get("test") in _TEST_DISCRIMINANTS:
   494	        return True
   495	    for key in ("archetype", "subagent_type"):
   496	        if ev.get(key) in _PROBE_ARCHETYPES:
   497	            return True
   498	    return False
