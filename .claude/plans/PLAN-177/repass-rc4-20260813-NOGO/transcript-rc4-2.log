  1648	#
  1649	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1650	# checksum gate anchors three named phantom referents. A NEW enforcement
  1651	# promise, about some other subject, written into a section nobody watches,
  1652	# passes all of them. The original defect is the proof that this is not
  1653	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1654	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1655	#
  1656	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1657	# Contract table row (machine-checked by
  1658	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1659	# to the table's un-enforced rows by
  1660	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1661	# Anywhere else it is answerable to nothing, and is a red.
  1662	#
  1663	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1664	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1665	#
  1666	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1667	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1668	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1669	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1670	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1671	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1672	#     at the table rather than enumerating mechanisms, and the tag-signing
  1673	#     paragraph cites SECURITY.md as the authority instead of restating the
  1674	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1675	#     needs no exemption, so it has none.
  1676	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1677	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1678	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1679	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1680	#     are the file speaking about what the pipeline does.
  1681	#     A broad list that has to be switched off is worth less than a narrow
  1682	#     one that stays on.
  1683	#
  1684	# Matching is on word boundaries after normalization. Substring matching was
  1685	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1686	# substring-vs-exact class, for the fourth time in this plan.
  1687	_ENFORCEMENT_VOCAB = (
  1688	    "enforced today",
  1689	    "is enforced",
  1690	    "are enforced",
  1691	    "enforced by",
  1692	    "enforced at",
  1693	    "every tag publish",
  1694	    "recorded by",
  1695	    "is verified",
  1696	    "are verified",
  1697	    "verifies",
  1698	    "must satisfy",
  1699	    "guarantees",
  1700	    "is guaranteed",
  1701	    "are guaranteed",
  1702	    "asserted by",
  1703	    "checked by",
  1704	    "gated by",
  1705	    "fails closed",
  1706	    "fail closes",
  1707	    "asserts",
  1708	    "ensures",
  1709	    "is signed",
  1710	    "are signed",
  1711	)
  1712	
  1713	
  1714	def _normalize_prose(text: str) -> str:
  1715	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1716	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1717	    normalize the same way, so a claim cannot hide behind formatting."""
  1718	    text = text.lower()
  1719	    for ch in ("*", "`", "_"):
  1720	        text = text.replace(ch, "")
  1721	    text = text.replace("-", " ")
  1722	    return re.sub(r"\s+", " ", text)
  1723	
  1724	
  1725	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1726	    """Everything that is neither a Contract table row nor §Not yet
  1727	    automated — the surfaces where a mechanism claim answers to nothing."""
  1728	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1729	    return "\n".join(
  1730	        line for line in body.splitlines() if not line.strip().startswith("|")
  1731	    )
  1732	
  1733	
  1734	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1735	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1736	    offenders = []
  1737	    for phrase in _ENFORCEMENT_VOCAB:
  1738	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1739	            offenders.append(
  1740	                "%r outside the declared zones: ...%s..."
  1741	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1742	            )
  1743	    return offenders
  1744	
