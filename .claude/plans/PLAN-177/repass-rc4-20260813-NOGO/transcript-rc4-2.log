  1506	def test_integrity_contract_rows_name_a_live_step():
  1507	    """P1-3. The contract claimed a per-tarball SHA-256 manifest was
  1508	    "enforced today" and pointed at `validate.yml (to-add)`: a guarantee whose
  1509	    alleged gate could not fail because it did not exist. A row now declares a
  1510	    Status from a closed set, and an `enforced` one must name a step that is
  1511	    really in the YAML."""
  1512	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1513	    rows = _contract_rows(doc)
  1514	    assert len(rows) >= 5, "Contract table parsed as %d rows" % len(rows)
  1515	
  1516	    pairs = _integrity_enforced_pairs(doc)
  1517	    assert len(pairs) >= _MIN_ENFORCED_PAIRS, (
  1518	        "only %d enforced (workflow, step) claims parsed — below the floor of "
  1519	        "%d. Either the table stopped documenting enforcement, or its format "
  1520	        "changed and this gate is now checking nothing."
  1521	        % (len(pairs), _MIN_ENFORCED_PAIRS)
  1522	    )
  1523	
  1524	    # (a) a renamed step must go red. The fixture is DERIVED from the parsed
  1525	    # table, never a hand-typed row literal: an anchor typed here stops
  1526	    # matching the day that row is edited, and the control dies quietly.
  1527	    step = pairs[0][2]
  1528	    renamed = doc.replace('step "%s"' % step, 'step "%s renamed"' % step, 1)
  1529	    assert renamed != doc, "rename fixture did not patch the doc"
  1530	    renamed_offenders = _integrity_contract_offenders(renamed, REPO_ROOT)
  1531	    assert any("renamed" in o for o in renamed_offenders), (
  1532	        "control did not flag a row naming a nonexistent step: %s"
  1533	        % renamed_offenders
  1534	    )
  1535	
  1536	    # (b) a table with NO parseable step claim must go red on the COUNT, not
  1537	    # report zero offenders. That is the vacuity failure itself.
  1538	    stripped = doc.replace('step "', "step ")
  1539	    assert len(_integrity_enforced_pairs(stripped)) < _MIN_ENFORCED_PAIRS, (
  1540	        "a table with no parseable step claim still met the floor — the count "
  1541	        "check cannot detect vacuity"
  1542	    )
  1543	
  1544	    # (c) unknown Status vocabulary must go red, not be waved through.
  1545	    unknown = doc.replace("| enforced |", "| mostly enforced |", 1)
  1546	    assert unknown != doc, "status fixture did not patch the doc"
  1547	    assert any(
  1548	        "outside the closed set" in o
  1549	        for o in _integrity_contract_offenders(unknown, REPO_ROOT)
  1550	    ), "an unknown Status was accepted"
  1551	
  1552	    offenders = _integrity_contract_offenders(doc, REPO_ROOT)
  1553	    assert not offenders, "npm/INTEGRITY.md contract row without a live step:\n%s" % (
  1554	        "\n".join(offenders)
  1555	    )
