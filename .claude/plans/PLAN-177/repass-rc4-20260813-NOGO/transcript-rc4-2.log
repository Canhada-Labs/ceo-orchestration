   287	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   288	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   289	    directory = os.path.dirname(manifest) or "."
   290	    name = os.path.basename(manifest)
   291	    try:
   292	        proc = subprocess.run(
   293	            ["shasum", "-a", "256", "-c", name],
   294	            cwd=directory,
   295	            stdout=subprocess.PIPE,
   296	            stderr=subprocess.STDOUT,
   297	            universal_newlines=True,
   298	        )
   299	        return proc.returncode == 0, proc.stdout.strip()
   300	    except (OSError, FileNotFoundError):
   301	        bad: List[str] = []
   302	        for want, rel in _read_manifest(manifest):
   303	            full = os.path.join(directory, rel)
   304	            if not os.path.isfile(full) or _sha256(full) != want:
   305	                bad.append(rel)
   306	        if bad:
   307	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   308	        return True, "hashlib fallback: all entries match"
