  2451	def _parse_event_ts(ts) -> Optional[float]:
  2452	    """Parse audit-log ts field (ISO-8601 UTC string or epoch float) → epoch seconds."""
  2453	    if ts is None:
  2454	        return None
  2455	    if isinstance(ts, (int, float)):
  2456	        return float(ts)
  2457	    if isinstance(ts, str):
  2458	        s = ts.strip()
  2459	        if not s:
  2460	            return None
  2461	        # Try epoch first.
  2462	        try:
  2463	            return float(s)
  2464	        except (TypeError, ValueError):
  2465	            pass
  2466	        # ISO-8601 — strip trailing Z, parse via datetime.fromisoformat.
  2467	        import datetime as _dt
  2468	        try:
  2469	            if s.endswith("Z"):
  2470	                s = s[:-1] + "+00:00"
  2471	            return _dt.datetime.fromisoformat(s).timestamp()
  2472	        except Exception:
  2473	            return None
  2474	    return None
