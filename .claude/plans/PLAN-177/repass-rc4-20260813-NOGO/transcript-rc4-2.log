  1755	    # The sweep must be looking at the right text: intro present, table absent.
  1756	    swept = _prose_outside_the_declared_zones(doc)
  1757	    assert "Integrity contract for the" in swept, (
  1758	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1759	        "the prose it exists to watch"
