   832	_claude_dir_gitignore_body() {
   833	  # Paths are anchored with a leading slash so they bind to .claude/ ONLY and
   834	  # cannot match a same-named path deeper in an adopter tree.
   835	  printf '%s\n' \
   836	    "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9)." \
   837	    "#" \
   838	    "# Per-machine posture + runtime state that must never reach VCS:" \
   839	    "#   state/             runtime state as a whole (PLAN-163 T3.1)" \
   840	    "#   settings.local.json  permission overlay deciding the NEXT session's" \
   841	    "#                        posture (PLAN-165)" \
   842	    "#" \
   843	    "# The root .gitignore carries the same exclusions for adopters who track" \
   844	    "# this tree from the repository root. This file additionally covers the" \
   845	    "# --ceremony user install, which never writes outside .claude/ and so" \
   846	    "# never received them." \
   847	    "#" \
   848	    "# Adopter-owned once created: install and upgrade create it only when it" \
   849	    "# is absent, and NEVER rewrite it." \
   850	    "/state/" \
   851	    "/settings.local.json"
   852	}
   853	
   854	_apply_claude_dir_gitignore() {
   855	  # $1 = the adopter .claude directory. Create-if-missing ONLY.
   856	  _cdg_dir="$1"
   857	  _cdg_file="$_cdg_dir/.gitignore"
   858	  if [ -e "$_cdg_file" ]; then
   859	    echo "    EXISTS: .claude/.gitignore (adopter-owned, preserved)"
   860	    return 0
   861	  fi
   862	  [ -d "$_cdg_dir" ] || mkdir -p "$_cdg_dir"
   863	  _claude_dir_gitignore_body > "$_cdg_file"
   864	  echo "    CREATED: .claude/.gitignore"
   865	  return 0
   866	}
