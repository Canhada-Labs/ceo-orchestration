   500	
   501	def _is_ghost_spawn_event(ev: Dict[str, Any]) -> bool:
   502	    """True iff the agent_spawn event is a harness ghost-event (no real payload).
   503	
   504	    All four conditions must hold simultaneously to avoid false-positives on
   505	    legitimate near-empty dispatches: empty desc, no rail attribution, no
   506	    profile marker, and SHA-of-empty-string desc_hash.
   507	    """
   508	    return (
   509	        ev.get("desc_preview") == ""
   510	        and ev.get("rail") is None
   511	        and ev.get("has_profile") is False
   512	        and ev.get("desc_hash") == _EMPTY_SHA256
   513	    )
   514	
   515	
   516	def _is_harness_probe_event(ev: Dict[str, Any]) -> bool:
   517	    """True iff the agent_spawn row is a harness-internal tool-loading probe.
   518	
   519	    S303: the ghost filter above was written for the ToolSearch probes of an
   520	    older harness, whose Agent-shaped PostToolUse rows carried NO description
   521	    (desc_preview == "" and desc_hash == SHA256(b"")). The current harness
   522	    supplies a human-readable description for the same class of call — e.g.
   523	    ``Load WebFetch via ToolSearch?`` with prompt ``noop`` and a fixed cheap
   524	    model — so all four ghost conditions no longer hold and a pure
   525	    tool-materialization probe lands in the denominator as a governance gap.
   526	
   527	    The discriminator is ``subagent_type``: the Agent/Task spawn contract makes
   528	    it REQUIRED for every governed dispatch (``check_agent_spawn.py`` derives
   529	    the authoritative archetype from it, and ``extract_skill`` Path D needs it),
   530	    so a row that carries none was never a CEO dispatch. All five conditions
   531	    must hold — no subagent_type, no archetype, no rail attribution, no
   532	    ``## AGENT PROFILE`` and no ``## FILE ASSIGNMENT`` — so a real named spawn
   533	    that merely lost one field still counts. Skipped rows stay OBSERVABLE via
   534	    the ``harness_probes_skipped`` counter: this suppresses a false alarm, it
   535	    does not hide the event.
   536	    """
   537	    return (
   538	        not ev.get("subagent_type")
   539	        and not ev.get("archetype")
   540	        and ev.get("rail") is None
   541	        and ev.get("has_profile") is False
   542	        and ev.get("has_file_assignment") is False
   543	    )
