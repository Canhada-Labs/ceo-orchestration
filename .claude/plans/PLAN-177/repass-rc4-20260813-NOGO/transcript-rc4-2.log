  1424	def _yaml_step_names(path: Path) -> List[str]:
  1425	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1426	    call site: a substring match would accept "Verify VERSION" for a step
  1427	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1428	    already cost this repo three incidents in one session."""
  1429	    text = path.read_text(encoding="utf-8")
  1430	    names = []
  1431	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1432	        name = m.group(1)
  1433	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1434	            name = name[1:-1]
  1435	        names.append(name)
  1436	    return names
  1437	
  1438	
  1439	def _contract_rows(doc_text: str) -> List[List[str]]:
  1440	    """The `## Contract` table as [control, mechanism, status, where]."""
  1441	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1442	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1443	    rows = []
  1444	    for line in m.group(0).splitlines():
  1445	        line = line.strip()
  1446	        if not line.startswith("|"):
  1447	            continue
  1448	        cells = [c.strip() for c in line.strip("|").split("|")]
  1449	        if len(cells) != 4:
  1450	            continue
  1451	        if cells[0] == "Control" or set(cells[0]) <= set("- :"):
  1452	            continue
  1453	        rows.append(cells)
  1454	    return rows
  1455	
  1456	
  1457	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1458	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1459	    Status are not read — a row that claims no enforcement makes no claim to
  1460	    check."""
  1461	    out: List[List[str]] = []
  1462	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1463	        if status != "enforced":
  1464	            continue
  1465	        for workflow, step in _ENFORCED_RX.findall(where):
  1466	            out.append([control, workflow, step])
  1467	    return out
  1468	
  1469	
  1470	def _integrity_contract_offenders(doc_text: str, repo_root: Path) -> List[str]:
  1471	    """Closed-set Status, plus: every `enforced` row names a workflow that
  1472	    exists and a step that exists in it, by exact equality."""
  1473	    offenders: List[str] = []
  1474	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1475	        if status not in _CONTRACT_STATUSES:
  1476	            offenders.append(
  1477	                "%s: Status %r is outside the closed set %s"
  1478	                % (control, status, list(_CONTRACT_STATUSES))
  1479	            )
  1480	            continue
  1481	        if status != "enforced":
  1482	            continue
  1483	        pairs = _ENFORCED_RX.findall(where)
  1484	        if not pairs:
  1485	            offenders.append(
  1486	                "%s: Status is enforced but `Where enforced` names no "
  1487	                "workflow+step in the parseable form — %r" % (control, where)
  1488	            )
  1489	            continue
  1490	        for workflow, step in pairs:
  1491	            wf = repo_root / workflow
  1492	            if not wf.is_file():
  1493	                offenders.append(
  1494	                    "%s: names workflow %s, which does not exist"
  1495	                    % (control, workflow)
  1496	                )
  1497	                continue
  1498	            if step not in _yaml_step_names(wf):
  1499	                offenders.append(
  1500	                    "%s: names step %r in %s, which has no such step"
  1501	                    % (control, step, workflow)
  1502	                )
  1503	    return offenders
  1504	
