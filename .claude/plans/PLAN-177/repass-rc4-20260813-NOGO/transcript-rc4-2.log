   955	def test_delta_catches_a_tampered_artifact_and_a_tampered_manifest(synth):
   956	    repo, env = synth["repo"], synth["env"]
   957	    armed = arm_verdict(synth, "v1.3.0-rc.2")
   958	    artifact = repo / armed["ev"]["artifact_rels"][0]
