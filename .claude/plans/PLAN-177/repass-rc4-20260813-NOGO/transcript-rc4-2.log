   632	def main(argv: Optional[Sequence[str]] = None) -> int:
   633	    parser = argparse.ArgumentParser(prog="_release_tag_guard.py")
   634	    sub = parser.add_subparsers(dest="cmd")
   635	
   636	    p_anc = sub.add_parser("ancestry", help="HEAD must be on origin/<branch>")
   637	    p_anc.add_argument("--repo", default=".")
   638	    p_anc.add_argument("--remote", default="origin")
   639	    p_anc.add_argument("--branch", default="main")
