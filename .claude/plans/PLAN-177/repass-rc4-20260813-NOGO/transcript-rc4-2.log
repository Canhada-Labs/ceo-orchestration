  1006	def test_delta_rejects_an_allowlist_entry_that_is_not_evidence(synth):
  1007	    """Wildcard-free is not enough — the allowlist must also be EXHAUSTIVE.
  1008	    A verdict that allowlists `VERSION` would wave through exactly the
  1009	    post-review bump commit that F2 is about, and every check below it would
  1010	    still report green. The refusal has to land on the allowlist itself."""
  1011	    repo, env = synth["repo"], synth["env"]
  1012	    parent = git(repo, env, "rev-parse", "HEAD")
  1013	    ev = make_repass(repo, "repass-r2", {"verdict-r1.txt": "GO\n"})
  1014	    verdict_rel = ".claude/governance/pair-rail-verdict-v1.3.0-rc.2.md"
  1015	    write_verdict(
  1016	        repo,
  1017	        "v1.3.0-rc.2",
  1018	        parent,
  1019	        [verdict_rel, ev["manifest_rel"], "VERSION"] + ev["artifact_rels"],
  1020	        ev["manifest_rel"],
  1021	        ev["manifest_sha"],
  1022	    )
  1023	    git(repo, env, "add", "-A")
  1024	    git(repo, env, "commit", "-q", "-m", "allowlist a version site")
  1025	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
  1026	    assert proc.returncode == tag_guard.E_VERDICT, proc.stdout + proc.stderr
  1027	    assert "EXHAUSTIVE" in proc.stderr
  1028	    assert "'VERSION'" in proc.stderr
