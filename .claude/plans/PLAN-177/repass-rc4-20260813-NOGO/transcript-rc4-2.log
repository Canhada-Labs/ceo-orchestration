  1031	@pytest.mark.parametrize(
  1032	    "entry",
  1033	    [
  1034	        # the plan file itself — post-review edits would ride the tag
  1035	        ".claude/plans/PLAN-166-release-hold-findings-closure.md",
  1036	        # ANOTHER tag's verdict-fields — stale evidence smuggled by name
  1037	        ".claude/plans/PLAN-166/verdict-fields-v1.2.0.md",
  1038	        # immutable historical evidence outside the pinned manifest dir
  1039	        ".claude/plans/PLAN-166/repass-r1/old-evidence.txt",
  1040	        # W0 re-pass r2 P2: the RIGHT basename in the WRONG directory — a
  1041	        # basename-only rule admits any number of look-alikes anywhere under
  1042	        # .claude/plans/; the file must sit at its canonical path (the plan
  1043	        # directory that CONTAINS the manifest dir)
  1044	        ".claude/plans/archive/verdict-fields-v1.3.0-rc.2.md",
  1045	        ".claude/plans/PLAN-166/repass-r1/verdict-fields-v1.3.0-rc.2.md",
  1046	    ],
  1047	)
  1048	def test_delta_rejects_plan_paths_outside_the_manifest_dir(synth, entry):
  1049	    """Re-pass P2: `.claude/plans/` entries OUTSIDE the manifest directory
  1050	    used to close by NAME alone — no content pin, no manifest coverage, no
  1051	    tag specificity — while the same guard rejected `VERSION` as
  1052	    non-EXHAUSTIVE. Only `verdict-fields-<THIS TAG>.md` at its CANONICAL
  1053	    path (directly inside the plan directory holding the manifest dir) may
  1054	    live outside the content-pinned manifest directory; everything else —
  1055	    including same-basename look-alikes elsewhere — must be IN it."""
  1056	    arm_verdict(synth, "v1.3.0-rc.2", extra_allow=[entry])
  1057	    proc = guard(synth, "delta", "--repo", str(synth["repo"]), "--tag", "v1.3.0-rc.2")
  1058	    assert proc.returncode == tag_guard.E_VERDICT, proc.stdout + proc.stderr
  1059	    assert "verdict-fields" in proc.stderr, proc.stderr
