   990	    write_verdict(
   991	        repo,
   992	        "v1.3.0-rc.2",
   993	        parent,
   994	        [verdict_rel, ev["manifest_rel"], "%s/smuggled.sh" % ev["dir"]]
   995	        + ev["artifact_rels"],
   996	        ev["manifest_rel"],
   997	        ev["manifest_sha"],
   998	    )
   999	    git(repo, env, "add", "-A")
  1000	    git(repo, env, "commit", "-q", "-m", "smuggle")
  1001	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
  1002	    assert proc.returncode == tag_guard.E_MANIFEST_SET, proc.stdout + proc.stderr
  1003	    assert "smuggled.sh" in proc.stderr
