  2783	            if code == "__REFERENCE_PREFIX__":
  2784	                # Embedded reason_code form: "GOVERNANCE: <code>: <detail>".
  2785	                # Skill-reference path emits codes like reference_hash_mismatch,
  2786	                # reference_unsafe_path, etc. (constants at
  2787	                # check_agent_spawn.py:188 REASON_REFERENCE_*).
  2788	                head = reason[len("GOVERNANCE: "):]
  2789	                colon = head.find(":")
  2790	                return head[:colon] if colon > 0 else "reference_invalid"
  2791	            return code
  2792	    return "unknown_block"
