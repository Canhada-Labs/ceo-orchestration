   821	    fi
   822	    {
   823	      echo ""
   824	      echo "# PLAN-165 CX-3: per-machine posture/runtime state (never commit)"
   825	      echo "$_psi_line"
   826	    } >> "$_psi_gitignore"
   827	    echo "    APPENDED to .gitignore: $_psi_line"
   828	  done
   829	  return 0
   830	}
