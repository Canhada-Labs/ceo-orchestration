   843	def test_delta_blocks_a_fabricated_parent_outside_head_history(synth):
   844	    """W0 re-pass r2 P1: `cat-file -e` proves the anchor EXISTS, not that it
   845	    is in the history this tag signs. A fabricated commit over HEAD's own
   846	    tree (`git commit-tree`, parented off an older commit, on no branch)
   847	    makes diff(parent..HEAD) contain ONLY the verdict + evidence while an
   848	    unreviewed file sits on main — every downstream check (allowlist,
   849	    manifest pin, set equality, vacuity) then passes and the guard prints
   850	    "all inside the verdict's closed allowlist" over an unreviewed tree."""
   851	    repo, env = synth["repo"], synth["env"]
   852	    h0 = git(repo, env, "rev-parse", "HEAD")
   853	
   854	    # unreviewed work lands on main
   855	    (repo / "unreviewed.py").write_text("print('never reviewed')\n", encoding="utf-8")
   856	    git(repo, env, "add", "unreviewed.py")
   857	    git(repo, env, "commit", "-q", "-m", "unreviewed change")
   858	    m2_tree = git(repo, env, "rev-parse", "HEAD^{tree}")
   859	
   860	    # fabricated anchor: HEAD's exact tree, parented off h0, on NO branch —
   861	    # it exists in the object store but HEAD does not descend from it
   862	    orphan = git(repo, env, "commit-tree", m2_tree, "-p", h0, "-m", "fabricated anchor")
   863	    not_anc = run(["git", "merge-base", "--is-ancestor", orphan, "HEAD"], repo, env)
   864	    assert not_anc.returncode == 1, "fixture broke: orphan IS an ancestor"
   865	
   866	    ev = make_repass(repo, "repass-r2", {"verdict-r1.txt": "GO\n"})
   867	    verdict_rel = ".claude/governance/pair-rail-verdict-v1.3.0-rc.2.md"
   868	    write_verdict(
   869	        repo,
   870	        "v1.3.0-rc.2",
   871	        orphan,
   872	        [verdict_rel, ev["manifest_rel"]] + ev["artifact_rels"],
   873	        ev["manifest_rel"],
   874	        ev["manifest_sha"],
   875	    )
   876	    git(repo, env, "add", "-A")
   877	    git(repo, env, "commit", "-q", "-m", "verdict anchored on the fabricated commit")
   878	
   879	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
   880	    assert proc.returncode == tag_guard.E_PARENT_NOT_ANCESTOR, (
   881	        proc.stdout + proc.stderr
   882	    )
   883	    assert "ancestor" in proc.stderr
   884	    # and it is a DISTINCT mode from both "bad verdict" and "delta outside"
   885	    assert tag_guard.E_PARENT_NOT_ANCESTOR != tag_guard.E_VERDICT
   886	    assert tag_guard.E_PARENT_NOT_ANCESTOR != tag_guard.E_DELTA
   887	
