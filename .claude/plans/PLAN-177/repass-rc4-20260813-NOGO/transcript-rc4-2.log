   646	
   647	    p_delta = sub.add_parser("delta", help="restricted delta vs the verdict")
   648	    p_delta.add_argument("--repo", default=".")
   649	    p_delta.add_argument("--tag", required=True)
   650	    p_delta.add_argument("--verdict", default=None)
   651	
   652	    args = parser.parse_args(argv)
   653	    if args.cmd == "ancestry":
   654	        return ancestry(args.repo, args.remote, args.branch, args.offline_ack)
   655	    if args.cmd == "delta":
   656	        return delta(args.repo, args.tag, args.verdict)
   657	    parser.print_usage(sys.stderr)
   658	    return E_USAGE
   659	
   660	
   661	if __name__ == "__main__":
   662	    sys.exit(main())

