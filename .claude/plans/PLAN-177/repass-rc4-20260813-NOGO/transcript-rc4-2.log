  1320	# ===========================================================================
  1321	# PLAN-177 W0 — the npm/ surfaces: a version nobody watched (P1-2) and an
  1322	# "enforced today" guarantee with no step behind it (P1-3).
  1323	# ===========================================================================
  1324	
  1325	# The npm docs are DERIVED from SCAN_ROOTS, not re-typed: adding a third npm
  1326	# surface up there extends this rule too, and the two lists cannot drift.
  1327	# What stays out, and why the predicate is narrow ON PURPOSE:
  1328	#   * `npm/SHA256SUMS.txt` records tarball FILENAMES
  1329	#     (`ceo-orchestration-<version>.tgz`) — historical data about a build that
  1330	#     happened, not a claim about the current release. Flagging it would train
  1331	#     whoever hits the red to add an exemption, and an exemption is how a
  1332	#     control stops controlling.
  1333	#   * `npm/.npmignore` cites past packaging incidents by the version they
  1334	#     happened in — same category.
  1335	#   * `npm/package.json` is a real bump site with a real oracle
  1336	#     (`_release_bump_sites.py` + verify-counts); it is written, not stale.
  1337	# Prose in a shipped `.md` is the only one that can go stale silently, which
  1338	# is exactly what happened.
  1339	NPM_DOC_SURFACES = tuple(
  1340	    root for root in SCAN_ROOTS if root.startswith("npm/") and root.endswith(".md")
  1341	)
  1342	# The one legitimate version literal in an npm doc: the review stamp, itself a
  1343	# bump site (`("npm/README.md", STAMP, STAMP_RX)`), so it has an oracle.
  1344	_STAMP_LINE_RX = re.compile(r"last-reviewed:\s*\d{4}-\d{2}-\d{2}\s+v\d+\.\d+\.\d+")
  1345	
  1346	
  1347	def _bare_version_offenders_in_npm_docs(repo_root: Path) -> List[str]:
  1348	    """Bare `X.Y.Z` in a scanned npm doc, outside a review stamp. Takes the
  1349	    root as an ARGUMENT so the positive control can plant the defect in a tmp
  1350	    tree and never write into the repo under test."""
  1351	    offenders: List[str] = []
  1352	    for rel in NPM_DOC_SURFACES:
  1353	        path = repo_root / rel
  1354	        if not path.is_file():
  1355	            continue
  1356	        try:
  1357	            body = path.read_text(encoding="utf-8")
  1358	        except (UnicodeDecodeError, OSError):
  1359	            continue
  1360	        for num, line in enumerate(body.splitlines(), 1):
  1361	            if _STAMP_LINE_RX.search(line):
  1362	                continue
  1363	            for hit in SEMVER_RX.findall(line):
  1364	                offenders.append("%s:%d: %s (%s)" % (rel, num, line.strip(), hit))
  1365	    return offenders
