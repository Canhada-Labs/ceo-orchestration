   665	def test_dry_run_restores_when_a_derived_site_is_absent_from_head(synth):
   666	    """W0 re-pass r2 P1: `git checkout -- <all paths>` is ATOMIC — one path
   667	    absent from HEAD (a file the bump CREATED, e.g. a plugin manifest on its
   668	    first appearance) aborts the whole restore, `|| true` swallowed the error,
   669	    and the trap still printed "restored to HEAD" over a fully dirty tree.
   670	    The restore must be per-path (checkout what HEAD has, remove what the
   671	    bump created) and the trap must ASSERT the postcondition, not the
   672	    attempt."""
   673	    repo, env = synth["repo"], synth["env"]
   674	    write_sites(repo, "1.2.0", D0)
   675	    git(repo, env, "rm", "-q", "-r", ".claude-plugin")
   676	    git(repo, env, "add", "-A")
   677	    git(repo, env, "commit", "-q", "-m", "fixture: 1.2.0 tree, no plugin manifests in HEAD")
   678	    head_before = git(repo, env, "rev-parse", "HEAD")
   679	
   680	    proc = driver(
   681	        synth, "bump", "--stable", "--npm-readme-reviewed", "--dry-run", "--today", D1
   682	    )
   683	    assert proc.returncode == 0, proc.stdout + proc.stderr
   684	    assert "restored to HEAD" in proc.stdout
   685	    assert git(repo, env, "rev-parse", "HEAD") == head_before
   686	    index_and_worktree_clean(repo, env)
   687	    assert (repo / "VERSION").read_text() == "1.2.0\n"
   688	    # the files the bump CREATED (not in HEAD) are gone again, not debris
   689	    assert not (repo / ".claude-plugin" / "plugin.json").exists()
   690	    assert not (repo / ".claude-plugin" / "marketplace.json").exists()
