  1206	def scan_live_surfaces(needle: str):
  1207	    """grep, in Python. The local `grep` is ugrep and disagrees with GNU grep
  1208	    about binary files, so a subprocess control would not mean the same thing
  1209	    here and in CI. Returns (files_scanned, hits)."""
  1210	    hits: List[str] = []
  1211	    scanned = 0
  1212	    for root in SCAN_ROOTS:
  1213	        base = REPO_ROOT / root
  1214	        if not base.exists():
  1215	            continue
  1216	        paths = [base] if base.is_file() else sorted(base.rglob("*"))
  1217	        for path in paths:
  1218	            if not path.is_file() or "__pycache__" in path.parts:
  1219	                continue
  1220	            try:
  1221	                body = path.read_text(encoding="utf-8")
  1222	            except (UnicodeDecodeError, OSError):
  1223	                continue  # binary artifact: not a live text surface
  1224	            scanned += 1
  1225	            for num, line in enumerate(body.splitlines(), 1):
  1226	                if needle in line:
  1227	                    hits.append(
  1228	                        "%s:%d: %s"
  1229	                        % (path.relative_to(REPO_ROOT), num, line.strip())
  1230	                    )
  1231	    return scanned, hits
