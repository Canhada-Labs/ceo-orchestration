   264	def _sha256(path: str) -> str:
   265	    h = hashlib.sha256()
   266	    with open(path, "rb") as fh:
   267	        for chunk in iter(lambda: fh.read(65536), b""):
   268	            h.update(chunk)
   269	    return h.hexdigest()
