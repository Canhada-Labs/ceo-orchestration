  1766	
  1767	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1768	    # merits. The order matters and was learned the hard way — the controls
  1769	    # below build their fixtures FROM the live file, so when the file itself
  1770	    # carries a planted defect they fail first and the red names the fixture
  1771	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1772	    # always reds on the assertion that describes what is actually wrong.
  1773	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1774	    offenders = _enforcement_vocabulary_offenders(doc)
  1775	    assert not offenders, (
  1776	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1777	        "§Not yet automated. Move the claim into a table row (with a step the "
  1778	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1779	    )
  1780	
  1781	    # (b) positive control: the historical claim restored to the introduction.
  1782	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1783	    # today's wording — an anchor on current prose stops matching the moment
  1784	    # that prose is edited, and then the control fails for the wrong reason.
  1785	    title, _, rest = doc.partition("\n")
  1786	    claim = (
  1787	        "The integrity controls enforced today are: (1) the `install.sh` "
  1788	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1789	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1790	    )
  1791	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1792	    assert relapse != doc, "relapse fixture did not patch the doc"
  1793	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1794	    assert any("enforced today" in o for o in relapse_offenders), (
  1795	        "an enforcement claim in the introduction went unseen: %s"
  1796	        % relapse_offenders
  1797	    )
  1798	    assert any("recorded by" in o for o in relapse_offenders), (
  1799	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1800	    )
  1801	
  1802	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1803	    # offender. This is the predicate as documented, not a global grep — that
  1804	    # section is where honest prose about absence has to be able to use these
  1805	    # words. Its own honesty is held by the restatement test above; a claim
  1806	    # parked there is the residual gap, and it is a narrow, watched one.
  1807	    marker = "## Not yet automated"
  1808	    assert marker in doc
  1809	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1810	    assert not _enforcement_vocabulary_offenders(parked), (
  1811	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1812	        "a declared zone"
  1813	    )
