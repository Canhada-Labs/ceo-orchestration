   114	def _fail(code: int, msg: str) -> int:
   115	    # Flush the ok-lines first: an operator reading a release failure must see
   116	    # WHICH checks passed before the one that stopped it, in order.
   117	    sys.stdout.flush()
   118	    print("FAIL: %s" % msg, file=sys.stderr)
   119	    sys.stderr.flush()
   120	    return code
   121	
   122	
   123	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   124	    proc = subprocess.run(
   125	        ["git"] + list(args),
   126	        cwd=repo,
   127	        stdout=subprocess.PIPE,
   128	        stderr=subprocess.PIPE,
   129	        universal_newlines=True,
   130	    )
   131	    return proc.returncode, proc.stdout, proc.stderr
   132	
   133	
   134	# ---------------------------------------------------------------------------
   135	# (a) ancestry
   136	# ---------------------------------------------------------------------------
   137	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   138	    ref = "%s/%s" % (remote, branch)
   139	    if offline_ack:
   140	        print(
   141	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   142	            "merge-base below is judged against a possibly STALE %s" % ref
   143	        )
   144	    else:
   145	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   146	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   147	        # stale ref reads as approval.
   148	        if rc != 0:
   149	            return _fail(
   150	                E_FETCH,
   151	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   152	                "      This is NOT a verdict on the commit — the check did not "
   153	                "run.\n"
   154	                "      Fix the network/remote and re-run, or, if you are "
   155	                "deliberately\n"
   156	                "      offline and accept judging against the last-known ref, "
   157	                "re-run\n"
   158	                "      with --offline-ack (it is recorded in the output).\n"
   159	                "      git said: %s" % (remote, branch, rc, err.strip()),
   160	            )
   161	        print("  ok   fetched %s" % ref)
   162	
   163	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   164	    if rc != 0 or not out.strip():
   165	        return _fail(
   166	            E_REMOTE_REF,
   167	            "no usable ref %s in this repo — cannot judge ancestry "
   168	            "(git said: %s)" % (ref, err.strip()),
   169	        )
   170	    remote_sha = out.strip()
   171	
   172	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   173	    if rc == 0:
   174	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   175	        return 0
   176	    if rc == 1:
   177	        return _fail(
   178	            E_NOT_ANCESTOR,
   179	            "HEAD is not an ancestor of %s — push main and re-run the "
   180	            "preflight.\n"
   181	            "      A tag on an unpushed commit points at a tree CI never "
   182	            "saw; the\n"
   183	            "      preflight's green verdict was about a different SHA."
   184	            % ref,
   185	        )
   186	    return _fail(
   187	        E_REMOTE_REF,
   188	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   189	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   190	    )
   191	
   192	
   193	# ---------------------------------------------------------------------------
   194	# (b) restricted delta
   195	# ---------------------------------------------------------------------------
   196	def _parse_verdict(text: str) -> Dict[str, object]:
   197	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   198	
   199	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   200	    of `  - item` list entries, and ignores everything else. Anything it cannot
   201	    read is absent, and every consumer below treats absent as fail-closed.
   202	
   203	    Parity with the step-15 reader (`.github/scripts/
   204	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   205	    scope: block selection (the regex below is the validator's own — the
   206	    first ```yaml fence, not the first fence of any language) and inline
   207	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   208	    parse_verdict_file reads key:value and sub-dicts and would drop
   209	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   210	    ONE shared reader (this file is the declared reference), never grow a
   211	    third parser of the same signed file.
   212	    """
   213	    fields: Dict[str, object] = {}
   214	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   215	    if block is None:
   216	        # No yaml block -> no fields -> every consumer below fails closed.
   217	        return fields
   218	    cur_list: Optional[str] = None
   219	    for raw in block.group(1).splitlines():
   220	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
    84	- **Plan naming:** `PLAN-<NNN>-<slug>.md`, `NNN` zero-padded three digits, monotonic. Plan subdirectories must be `PLAN-<NNN>/`, `examples/`, or `archive/`. Enforced in `PLAN-SCHEMA.md`.
    85	- **ADRs for L3+ decisions:** every cross-cutting architectural choice gets a formal record at `.claude/adr/ADR-<NNN>-<slug>.md`.
    86	- **Debate for L3+ plans:** run `/debate start PLAN-<NNN> "<proposal>"` before execution. Canonical on-disk layout is in `DEBATE-SCHEMA.md`.
    87	- **No contamination:** never hardcode personal handles or private project names in template or framework content. Docs use neutral placeholders (`Canhada-Labs`, `the maintainer`, `your-app`). `.github/CODEOWNERS` is the only live file carrying a real handle.
    88	- **Spawn protocol:** every named spawn must include `## AGENT PROFILE`, `## SKILL CONTENT`, and `## FILE ASSIGNMENT`. The `check_agent_spawn.py` hook blocks non-compliant spawns.
    89	- **Install/upgrade ownership is ONE decision, not a cascade (PLAN-167, landed `7c0828a`; PLAN-168 closed the follow-ups).** Whether the framework owns `PROTOCOL.md`, `SPEC/v1` or `.claude/.framework-version` is answered by `_ownership_verdict()` in `scripts/_framework_manifest_set.sh` — a pure function of 10 dimensions returning `"<VERDICT> <HASH_SOURCE>"`. `install.sh` and `upgrade.sh` **observe → call → execute**; they do not decide. Contract: `docs/ownership-decision-table.md`. Truth: `scripts/tests/ownership_table.tsv`. Two oracles read that same table — a unit one (`test-ownership-verdict-unit.sh`, milliseconds: catches a wrong DECISION) and an e2e one (`test-ownership-table.sh`, ~25 min of real installs: catches a wrong OBSERVATION), plus the INV-4 e2e (`test-protocol-pointer-inv4.sh`: install and upgrade render the pointer through the ONE shared generator — byte-identical, degraded bodies CURED with backup, adopter edits preserved). CI: the unit oracle + fast controls run per-PR in `smoke-install.yml`; the full e2e runs in `ownership-nightly.yml`, whose gate (`ownership-nightly-gate.sh`) compares the exact RED id set against `ownership-expected-reds.txt` and fails on ANY difference. **The e2e ends 62 green / 3 red by design** (`OWN-0024`/`0027` test defects, `OWN-0016` product — causes in ADR-190; `OWN-0074` was closed by PLAN-168 W2). An all-green run means the table changed — stop and find out why. Adding a branch that decides ownership locally re-opens the class this replaced.
    90	- **Fail-open on infrastructure, fail-closed on input (security matchers):** hooks never block the user session on INFRASTRUCTURE bugs — on a missing file, import failure, or timeout, a hook logs a breadcrumb and emits `{}` (a schema-compliant allow). But an INPUT-parse failure inside a security matcher is fail-CLOSED by design: content the guard cannot parse is blocked, not waved through (precedents in `check_bash_safety.py`: the `_e3` whole-command parse gate and `_check_credential_leak`; codified by PLAN-152, debate C4). **Deliberate exception (ADR-186):** the canonical-edit matcher's per-invocation wall deadline is fail-CLOSED — a timeout *there* is an incomplete verification, not infrastructure; the recovery route is the provenance-pinned unlock (`CEO_SENTINEL_UNLOCK` + `CEO_SESSION_ANCHOR_SHA` or `CEO_SENTINEL_UNLOCK_SHA256`).
    91	
    92	## 5. Honest limitations
    93	
    94	- **The pair-rail verdict does not gate the generic release path (OPEN P1, found by the v1.3.0 GA re-pass, 2026-08-12).** The exact-`GO` check exists **only** in `.claude/plans/PLAN-166/OWNER-GA-CUT.sh`. `.github/scripts/validate-pair-rail-verdict.py` contains **zero** occurrences of `GO`/`NO-GO` — it validates pinning and TTL, never the decision — and `_release_tag_guard.py` / `release.sh tag --stable` accept a verdict whose decision is `NO-GO`, missing, or unknown. Reproduced with the workflow's exact step-15 arguments: flipping `verdict` to `NO-GO` returns `OK`, exit 0, after which `release-gate` succeeds and environment approval can irreversibly publish npm. This is a re-finding of the `repass-r2/verdict-c.txt` P1 whose earlier cure covered one path only. Until both validators require `verdict ∈ {GO, GO-WITH-CONDITIONS}` (with a regression test using those exact arguments), **a negative cross-model review does not mechanically block a release** — only the Owner running `OWNER-GA-CUT.sh` does.
    95	
    96	- **Bus factor.** Single primary maintainer; treat operational continuity accordingly.
    97	- **Same-vendor reviewer caveat.** The pair-rail reduces single-model blind spots but does not eliminate shared-vendor or shared-training-data failure modes.
    98	- **Formal model not in CI.** A TLA+ specification of the core state machine exists (`docs/formal-verification/`), but model-checking is not yet wired into CI — these are specifications, not a "formally verified" claim.
    99	- **Alternatives.** If you want multi-agent orchestration without this governance layer, look at AutoGen, MetaGPT, or LangGraph; `ceo-orchestration` trades raw flexibility for auditability and gating.
   100	
   101	## 6. At session end (closeout only)
   102	
   103	1. Update memory at `~/.claude/projects/<cwd-slug>/memory/` (`project_current_state.md`, plus the `MEMORY.md` index if new topics were added).
   104	2. Update this `CLAUDE.md` only if the durable operating contract changed — not for session narration.

