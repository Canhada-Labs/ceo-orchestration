   664	        "cache_coverage_bps": cache_coverage_bps,
   665	        "rail": rail,
   666	        # PLAN-021 v2.8 addition (ADDITIVE — ADR-052 multi-model).
   667	        "model": model,
   668	        # PLAN-044 audit-v2 v2.14 additions (Wave B C3-P0-08).
   669	        "archetype": archetype,
   670	        "dispatch_mode": dispatch_mode,
   671	        # PLAN-080 Phase 1 v2.24 addition (M2-C3 + M2-CDX-1) —
