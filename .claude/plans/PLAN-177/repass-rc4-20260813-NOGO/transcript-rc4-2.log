    74	# helpers
    75	# ---------------------------------------------------------------------------
    76	def _env(home: Path) -> Dict[str, str]:
    77	    """A subprocess environment that cannot reach the real HOME or repo."""
    78	    env = dict(os.environ)
    79	    for key in ("CLAUDE_PROJECT_DIR", "GIT_DIR", "GIT_WORK_TREE"):
    80	        env.pop(key, None)
    81	    env.update(
    82	        {
    83	            "HOME": str(home),
    84	            "GNUPGHOME": str(home / "gnupg"),
    85	            "GIT_CONFIG_GLOBAL": str(home / "gitconfig"),
    86	            "GIT_CONFIG_SYSTEM": os.devnull,
    87	            "GIT_AUTHOR_NAME": "Release Test",
    88	            "GIT_AUTHOR_EMAIL": "release-test@example.invalid",
    89	            "GIT_COMMITTER_NAME": "Release Test",
    90	            "GIT_COMMITTER_EMAIL": "release-test@example.invalid",
    91	            "LC_ALL": "C",
    92	        }
    93	    )
    94	    return env
    95	
    96	
    97	def run(args: Sequence[str], cwd: Path, env: Dict[str, str]):
    98	    return subprocess.run(
    99	        list(args),
   100	        cwd=str(cwd),
   101	        env=env,
   102	        stdout=subprocess.PIPE,
   103	        stderr=subprocess.PIPE,
   104	        universal_newlines=True,
   105	    )
   106	
   107	
   108	def git(repo: Path, env: Dict[str, str], *args: str) -> str:
   109	    proc = run(["git"] + list(args), repo, env)
   110	    assert proc.returncode == 0, "git %s failed: %s%s" % (
   111	        " ".join(args),
   112	        proc.stdout,
   113	        proc.stderr,
   114	    )
   115	    return proc.stdout.strip()
   116	
   117	
   118	def sha256_file(path: Path) -> str:
   119	    return hashlib.sha256(path.read_bytes()).hexdigest()
   120	
   121	
   122	def tree_fingerprint(repo: Path) -> Dict[str, str]:
   123	    """Content hash of every file the bump may touch (writes are visible here
   124	    even when they are later committed, unlike `git status`)."""
   125	    out: Dict[str, str] = {}
   126	    for rel in bump_sites.site_paths(include_generated=True):
   127	        full = repo / rel
   128	        if full.is_file():
   129	            out[rel] = sha256_file(full)
   130	    return out
   131	
