   143	STUB_VERIFY_COUNTS = """#!/usr/bin/env bash
   144	# Fixture stand-in for verify-counts.sh: version equality across the watched
   145	# doc/package sites. Deliberately simple — the real oracle is exercised by the
   146	# real repo, this one only has to be RIGHT about same-tree vs drifted-tree.
   147	#
   148	# It DOES model the support-window family (VERSION_SITES modes "minor" and
   149	# "prev_minor" on SECURITY.md/VERSIONING.md, added S293): the re-pass F-sites
   150	# finding was a fixture oracle WITHOUT these modes staying green over a writer
   151	# that never wrote them — the exact fixture!=live class. Derivation mirrors
   152	# the live oracle: prev = minor-1, empty (value-check skipped) at X.0.
   153	set -eu
   154	version="$(tr -d ' \\n' < VERSION)"
   155	minor="${version%.*}"
   156	maj="${minor%%.*}"
   157	min="${minor##*.}"
   158	prev=""
   159	if [ "$min" -gt 0 ]; then prev="${maj}.$((min - 1))"; fi
   160	rc=0
   161	for f in npm/package.json pyproject.toml INSTALL.md docs/ARCHITECTURE.md npm/README.md; do
   162	  [ -f "$f" ] || continue
   163	  if ! grep -q "$version" "$f"; then rc=1; fi
   164	done
   165	# repass-r2 part-d P2: the marker is a bump site (W2.6) — a fixture oracle
   166	# that ignores it stays green over a writer that skipped it (fixture!=live).
   167	if [ -f .claude/.framework-version ]; then
   168	  marker="$(tr -d ' \\n' < .claude/.framework-version)"
   169	  [ "$marker" = "$version" ] || rc=1
   170	fi
   171	for f in SECURITY.md VERSIONING.md; do
   172	  [ -f "$f" ] || continue
   173	  cur_line="$(grep 'Current MINOR' "$f" || true)"
   174	  case "$cur_line" in
   175	    "") ;;
   176	    *"v${minor}.x"*) ;;
   177	    *) rc=1 ;;
   178	  esac
   179	  if [ -n "$prev" ]; then
   180	    prev_line="$(grep 'Previous MINOR' "$f" || true)"
   181	    case "$prev_line" in
   182	      "") ;;
   183	      *"v${prev}.x"*) ;;
   184	      *) rc=1 ;;
   185	    esac
   186	  fi
   187	done
   188	exit "$rc"
   189	"""
   190	
   191	STUB_BUILD_PLUGIN = '''#!/usr/bin/env python3
   192	import json, os, sys
   193	
   194	TARGETS = [".claude-plugin/plugin.json", ".claude-plugin/marketplace.json"]
   195	version = open("VERSION").read().strip()
   196	mode = sys.argv[1] if len(sys.argv) > 1 else "--check"
   197	if mode == "--write-manifests":
   198	    for t in TARGETS:
   199	        os.makedirs(os.path.dirname(t), exist_ok=True)
   200	        with open(t, "w") as fh:
   201	            json.dump({"version": version}, fh, indent=2)
   202	            fh.write("\\n")
   203	    sys.exit(0)
   204	if mode == "--check":
   205	    for t in TARGETS:
   206	        try:
   207	            with open(t) as fh:
   208	                data = json.load(fh)
   209	        except Exception:
   210	            sys.exit(1)
   211	        if data.get("version") != version:
   212	            sys.exit(1)
   213	    sys.exit(0)
   214	sys.exit(2)
   215	'''
