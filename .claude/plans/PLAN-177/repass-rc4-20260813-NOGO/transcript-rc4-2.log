   734	# ===========================================================================
   735	# tag guard — restricted delta
   736	# ===========================================================================
   737	def make_repass(repo: Path, slug: str, artifacts: Dict[str, str]) -> Dict[str, str]:
   738	    directory = repo / ".claude/plans/PLAN-166" / slug
   739	    directory.mkdir(parents=True, exist_ok=True)
   740	    lines: List[str] = []
   741	    for name, body in sorted(artifacts.items()):
   742	        (directory / name).write_text(body, encoding="utf-8")
   743	        lines.append("%s  %s" % (sha256_file(directory / name), name))
   744	    manifest = directory / "MANIFEST.sha256"
   745	    manifest.write_text("\n".join(lines) + "\n", encoding="utf-8")
   746	    rel = ".claude/plans/PLAN-166/%s" % slug
   747	    return {
   748	        "dir": rel,
   749	        "manifest_rel": "%s/MANIFEST.sha256" % rel,
   750	        "manifest_sha": sha256_file(manifest),
   751	        "artifact_rels": ["%s/%s" % (rel, n) for n in sorted(artifacts)],
   752	    }
   753	
   754	
   755	def write_verdict(
   756	    repo: Path,
   757	    tag: str,
   758	    parent: str,
   759	    allowlist: Sequence[str],
   760	    manifest_rel: str,
   761	    manifest_sha: str,
   762	    verdict=("GO",),
   763	) -> str:
   764	    """`verdict` accepts a str, None, or a SEQUENCE of decision lines.
   765	
   766	    The three shapes the PLAN-177 gate must separate: one line (normal),
   767	    zero lines (an author who never filled the template field in), two
   768	    lines (the last-wins override, where NO-GO followed by GO parses as
   769	    GO).
   770	    """
   771	    rel = ".claude/governance/pair-rail-verdict-%s.md" % tag
   772	    path = repo / rel
   773	    path.parent.mkdir(parents=True, exist_ok=True)
   774	    entries = "\n".join("  - %s" % e for e in allowlist)
   775	    if verdict is None:
   776	        decisions = []
   777	    elif isinstance(verdict, str):
   778	        decisions = [verdict]
   779	    else:
   780	        decisions = list(verdict)
   781	    decision = "".join("verdict: %s\n" % d for d in decisions)
   782	    path.write_text(
   783	        "# Pair-Rail Verdict \u2014 %s\n\n```yaml\n%srelease_tag: %s\n"
   784	        "parent_sha: %s\ndelta_allowlist:\n%s\ndelta_manifest: %s\n"
   785	        "delta_manifest_sha256: %s\n```\n" % (
   786	            tag, decision, tag, parent, entries, manifest_rel, manifest_sha,
   787	        ),
   788	        encoding="utf-8",
   789	    )
   790	    return rel
   791	
   792	
   793	def arm_verdict(
   794	    synth,
   795	    tag: str,
   796	    slug: str = "repass-r2",
   797	    extra_allow=(),
   798	    verdict=("GO",),
   799	):
   800	    """Commit a re-pass + verdict for `tag`, anchored at the pre-verdict HEAD."""
   801	    repo, env = synth["repo"], synth["env"]
   802	    parent = git(repo, env, "rev-parse", "HEAD")
   803	    ev = make_repass(
   804	        repo, slug, {"verdict-r1.txt": "GO\n", "transcript-r1.log": "rounds: 3\n"}
   805	    )
   806	    verdict_rel = ".claude/governance/pair-rail-verdict-%s.md" % tag
   807	    allow = [verdict_rel, ev["manifest_rel"]] + ev["artifact_rels"] + list(extra_allow)
   808	    write_verdict(
   809	        repo, tag, parent, allow, ev["manifest_rel"],
   810	        ev["manifest_sha"], verdict=verdict,
   811	    )
   812	    git(repo, env, "add", "-A")
   813	    git(repo, env, "commit", "-q", "-m", "governance: verdict %s" % tag)
   814	    git(repo, env, "push", "-q", "origin", "main")
   815	    git(repo, env, "fetch", "-q", "origin", "main")
   816	    return {"parent": parent, "verdict_rel": verdict_rel, "ev": ev}
   817	
