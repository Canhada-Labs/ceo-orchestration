    58	def _load(path: Path, name: str):
    59	    spec = importlib.util.spec_from_file_location(name, str(path))
    60	    assert spec and spec.loader, path
    61	    mod = importlib.util.module_from_spec(spec)
    62	    spec.loader.exec_module(mod)
    63	    return mod
    64	
    65	
    66	bump_sites = _load(SITES_SRC, "_release_bump_sites_under_test")
    67	tag_guard = _load(GUARD_SRC, "_release_tag_guard_under_test")
    68	validator = _load(
    69	    VALIDATOR_SRC, "_validate_pair_rail_verdict_under_test"
    70	)
