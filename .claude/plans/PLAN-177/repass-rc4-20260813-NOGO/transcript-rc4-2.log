   241	def _count_top_level_key(text: str, key: str) -> int:
   242	    """How many times `key:` is declared at the top level of the block.
   243	
   244	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   245	    step-15 reader: a second `verdict:` silently overrides the first, so
   246	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   247	    block selection and same comment rule as the reader, or the count
   248	    would be about a different text than the parse.
   249	    """
   250	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   251	    if block is None:
   252	        return 0
   253	    seen = 0
   254	    for raw in block.group(1).splitlines():
   255	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   256	        if not line.strip() or line[0] in (" ", "\t"):
   257	            continue
   258	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   259	        if m and m.group(1) == key:
   260	            seen += 1
   261	    return seen
