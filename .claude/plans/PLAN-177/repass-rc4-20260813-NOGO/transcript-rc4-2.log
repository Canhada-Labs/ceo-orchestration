   133	def index_and_worktree_clean(repo: Path, env: Dict[str, str]) -> None:
   134	    porcelain = git(repo, env, "status", "--porcelain")
   135	    assert porcelain == "", "working tree not clean:\n%s" % porcelain
   136	    staged = run(["git", "diff", "--cached", "--quiet"], repo, env)
   137	    assert staged.returncode == 0, "index not clean:\n%s" % git(
   138	        repo, env, "diff", "--cached", "--name-only"
   139	    )
