   578	    skill = extract_skill(prompt, subagent_type)
   579	
   580	    # PLAN-006 Phase 5b (ADR-016): extract token counts from tool_response.
   581	    # Always emit the keys (even if None) so consumers can distinguish
   582	    # "post-ADR-016 emitter with unknown shape" from "pre-ADR-016 emitter".
   583	    tin, tout = _tokens.extract_tokens(tool_response)
   584	    ttotal = _tokens.total_tokens(tool_response)
   585	
   586	    # PLAN-020 Phase 0 item 1: capture Anthropic usage_metadata for cache
   587	    # coverage analysis. Additive v2.7 fields. Null-safe for emitters that
   588	    # don't provide usage_metadata (legacy + non-Anthropic adapters).
   589	    usage_metadata = _extract_usage_metadata(tool_response)
   590	    # PLAN-118 WS-E (S181): the derived ratio is a FLOAT, which
   591	    # ``canonical_json.encode()`` forbids in HMAC-covered payloads
   592	    # (``CanonicalJsonError`` → fail-open ``hmac:null`` → chain one-way-rule
   593	    # break → whole-chain ``tamper``). Encode as integer basis-points
   594	    # (ratio × 10000, clamped 0..10000) BEFORE it reaches the entry dict.
   595	    # Mirrors the S164 ``hit_rate`` → ``hit_rate_bps`` class fix; closes the
   596	    # last live float-in-HMAC leak (the agent_spawn observer path that the
   597	    # S164 emit_* introspection guard never covered).
   598	    cache_coverage = _compute_cache_coverage(usage_metadata)
   599	    cache_coverage_bps = (
   600	        max(0, min(10000, int(round(cache_coverage * 10000))))
   601	        if cache_coverage is not None
   602	        else None
   603	    )
   604	
   605	    # PLAN-020 Phase 1: dual-rail discriminator. Detect from prompt
   606	    # structure (## SKILL REFERENCE = native rail; ## SKILL CONTENT =
   607	    # custom inline rail) OR from subagent_type matching canonical-5.
   608	    rail = _detect_rail(prompt, subagent_type)
   609	
   610	    # PLAN-021 ADR-052: model discriminator. Captured from Anthropic
   611	    # API response when present. Null-safe for non-Anthropic adapters.
   612	    # PLAN-044 audit-v2 C3-P0-01 (Wave B): fall back to ADR-052
   613	    # role-to-model policy when tool_response.model is null (default
   614	    # behavior of Task tool response shape at v1.11.0).
   615	    model = _extract_model(tool_response, subagent_type=subagent_type)
   616	
   617	    # PLAN-044 audit-v2 C3-P0-08 (Wave B): archetype + dispatch_mode
   618	    # fields. Audit-telemetry.py per-archetype rollups depend on these
   619	    # being non-null. ADR-082 per-archetype dispatch claim was undone
   620	    # at v1.11.0 because no emitter wrote them. Wave B closes the gap.
