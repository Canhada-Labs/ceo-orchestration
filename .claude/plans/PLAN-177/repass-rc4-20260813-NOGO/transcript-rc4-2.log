  2477	def _tail_recent_rendered(
  2478	    plan_id: str,
  2479	    max_age_s: int = _GOAP_RENDER_LOOKBACK_S,
  2480	    session_id: Optional[str] = None,
  2481	):
  2482	    """Tail audit log for most-recent goap_recommendation_rendered matching plan_id.
  2483	
  2484	    PLAN-105 R2 P1 fold:
  2485	    - Optional `session_id` filter — same-session join (concurrent sessions
  2486	      with same plan_id within 5 min cannot misclassify).
  2487	    - Conservative ts handling — unparseable / missing ts treated as
  2488	      out-of-window (skipped), not as "match-anyway".
  2489	
  2490	    Returns parsed event dict (Optional[dict]). Returns None if no match
  2491	    within `max_age_s` seconds. Bounded tail = last 256 lines (~512KB).
  2492	    """
  2493	    log_path = _audit_log_path()
  2494	    if log_path is None or not log_path.exists():
  2495	        return None
  2496	    try:
  2497	        import json as _json
  2498	        import time as _time
  2499	        with log_path.open("r", encoding="utf-8") as f:
  2500	            # Read last ~256 lines via seek-from-end (bounded perf).
  2501	            try:
  2502	                f.seek(0, 2)
  2503	                size = f.tell()
  2504	                read_back = min(size, 256 * 2048)  # ~512KB max
  2505	                start_offset = max(0, size - read_back)
  2506	                f.seek(start_offset, 0)
  2507	                # Only discard partial first line if we didn't seek to 0
  2508	                # (otherwise we'd lose the first real line of a small file).
  2509	                if start_offset > 0:
  2510	                    f.readline()
  2511	                tail = f.readlines()
  2512	            except OSError:
  2513	                tail = f.readlines()[-256:]
  2514	        now = _time.time()
  2515	        for line in reversed(tail):
  2516	            try:
  2517	                ev = _json.loads(line)
  2518	            except Exception:
  2519	                continue
  2520	            if ev.get("action") != "goap_recommendation_rendered":
  2521	                continue
  2522	            if ev.get("plan_id") != plan_id:
  2523	                continue
  2524	            # PLAN-105 R2 P1-3 fold — same-session filter when provided.
  2525	            if session_id is not None and ev.get("session_id") != session_id:
  2526	                continue
  2527	            ts_f = _parse_event_ts(ev.get("ts"))
  2528	            # PLAN-105 R2 P1-2 fold — conservative: unparseable ts skipped.
  2529	            if ts_f is None:
  2530	                continue
  2531	            if (now - ts_f) > max_age_s:
  2532	                # Older than the window — skip.
  2533	                continue
  2534	            return ev
  2535	        return None
  2536	    except Exception:
  2537	        return None
