     5	
     6	    {
     7	      "session_id": "...",
     8	      "tool_name": "Agent",
     9	      "tool_input": {
    10	        "description": "...",
    11	        "prompt": "...",
    12	        "subagent_type": "..."       # optional
    13	      },
    14	      "tool_response": {...}          # PostToolUse only
    15	    }
