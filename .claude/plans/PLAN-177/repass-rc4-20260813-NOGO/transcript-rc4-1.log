    98	_YAML_BLOCK_RE = re.compile(r"```yaml\s*\n(.*?)```", re.DOTALL)
    99	
   100	
   101	def _strip_comment(raw: str) -> str:
   102	    """The comment/whitespace rule of the reader below, in ONE place."""
   103	    return raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   104	
   105	
   106	def count_top_level_key(text: str, key: str) -> int:
   107	    """How many times `key:` is declared at the top level of the block.
   108	
   109	    Both readers of this signed file are LAST-WINS, so a second
   110	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   111	    as GO. Callers require exactly one.
   112	    """
   113	    m = _YAML_BLOCK_RE.search(text)
   114	    if not m:
   115	        return 0
   116	    seen = 0
   117	    for raw in m.group(1).splitlines():
   118	        line = _strip_comment(raw)
   119	        if not line.strip() or line[0] in (" ", "\t"):
   120	            continue
   121	        if line.partition(":")[0].strip() == key:
   122	            seen += 1
   123	    return seen
   124	
   125	
   126	def parse_verdict_text(text: str) -> Dict[str, Any]:
   127	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   128	    m = _YAML_BLOCK_RE.search(text)
   129	    if not m:
   130	        raise ValueError("verdict file missing yaml frontmatter block")
   131	    yaml_body = m.group(1)
   132	    # Inline minimal YAML parse (stdlib only)
   133	    out: Dict[str, Any] = {}
   134	    current_key: Optional[str] = None
   135	    for raw in yaml_body.splitlines():
   136	        line = _strip_comment(raw)
   137	        if not line.strip():
   138	            continue
   139	        if line[0] not in (" ", "\t"):
   140	            if ":" in line:
   141	                k, _, v = line.partition(":")
   142	                v = v.strip()
   143	                if v:
   144	                    out[k.strip()] = v
   145	                else:
   146	                    out[k.strip()] = {}
   147	                    current_key = k.strip()
   148	        elif current_key and ":" in line:
   149	            sub_k, _, sub_v = line.partition(":")
   150	            if isinstance(out[current_key], dict):
   151	                out[current_key][sub_k.strip()] = sub_v.strip()
   152	    return out
