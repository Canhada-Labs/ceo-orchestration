    36	import json
    37	import sys
    38	from dataclasses import dataclass, field
    39	from typing import Any, Dict, Optional
    40	
    41	
    42	@dataclass
    43	class HookPayload:
    44	    """Typed view of a Claude Code hook stdin payload."""
    45	
    46	    # Always-present fields (may be empty strings if missing)
    47	    session_id: str = ""
    48	    tool_name: str = ""
    49	    description: str = ""
    50	    prompt: str = ""
    51	    subagent_type: str = ""
    52	
    53	    # Structured sub-objects (PostToolUse only)
    54	    tool_input: Dict[str, Any] = field(default_factory=dict)
    55	    tool_response: Any = None
    56	
    57	    # PLAN-125 WS-1 — per-tool-call lifecycle scalars. Top-level payload
    58	    # keys (siblings of tool_name / tool_response per the Claude Code hook
    59	    # docs). `tool_use_id` is the per-call pairing key; `duration_ms` is the
    60	    # native tool wall-clock on PostToolUse / PostToolUseFailure. Kept numeric
    61	    # (int-or-None) — NOT coerced to str — so the bucketing mapper sees a number.
    62	    tool_use_id: str = ""
    63	    duration_ms: Optional[int] = None
    64	
    65	    # Error state — set if stdin could not be parsed
    66	    raw_error: Optional[str] = None
    67	
    68	    # Raw stdin (for debugging / breadcrumbs)
    69	    raw: str = ""
