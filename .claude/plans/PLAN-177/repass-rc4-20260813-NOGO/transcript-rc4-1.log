    72	def parse_stdin(stream: Optional[Any] = None) -> HookPayload:
    73	    """Parse stdin JSON into a HookPayload. Never raises.
    74	
    75	    Args:
    76	        stream: A file-like object with a .read() method. If None (default),
    77	            uses `sys.stdin`. Tests pass a StringIO.
    78	
    79	    Returns:
    80	        HookPayload. On parse failure, `raw_error` is set to the exception
    81	        message and all other fields remain at defaults.
    82	    """
    83	    if stream is None:
    84	        stream = sys.stdin
    85	
    86	    try:
    87	        raw = stream.read()
    88	    except Exception as e:  # pragma: no cover — stdin.read() failure is exotic
    89	        return HookPayload(raw_error=f"stdin read failed: {e}")
    90	
    91	    return parse_text(raw)
    92	
