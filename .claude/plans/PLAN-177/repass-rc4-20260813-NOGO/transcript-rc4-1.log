   328	            E_VERDICT,
   329	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   330	            "to judge this tag against another tag's verdict."
   331	            % (verdict_rel, release_tag, tag),
   332	        )
   333	    # PLAN-177 W0.1 (P1-4) -- the DECISION gate.
   334	    #
   335	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on): the
   336	    # server-side twin (.github/scripts/validate-pair-rail-verdict.py, step
   337	    # 15) carries `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
