  1841	def test_checklist_attributes_repo_exhaustiveness_to_the_scanner():
  1842	    """The checklist read as a census OF THE REPOSITORY while it was a census
  1843	    of the driver's TABLE — which is why `npm/INTEGRITY.md` could hold a stale
  1844	    version and the checklist still be, on its own terms, true. It now says
  1845	    which instrument answers for the repo, and names the roots that
  1846	    instrument scans; adding a root without documenting it goes red here."""
  1847	    text = (REPO_ROOT / ".github/release-checklist.md").read_text(encoding="utf-8")
  1848	    assert "SCAN_ROOTS" in text, "the checklist names no repo-wide instrument"
  1849	    missing = [root for root in SCAN_ROOTS if root not in text]
  1850	    assert not missing, "SCAN_ROOTS entries undocumented in the checklist: %s" % missing
  1851	    # the assertion above can only mean something if it is falsifiable — a root
  1852	    # that is NOT in the tuple must be absent from the prose.
  1853	    assert "docs/formal-verification" not in text
  1854	
