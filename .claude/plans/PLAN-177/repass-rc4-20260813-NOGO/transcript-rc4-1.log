 if [[ ! -f "$NPM_DIR/scripts/install.sh" ]]; then
   echo "::error::staged bundle missing scripts/install.sh" >&2
   exit 1
 fi
 
 # Syntax-check the shim (mirror npm-publish.yml step).
 node --check "$NPM_DIR/bin/ceo-orch-init.js"
 echo "OK: shim syntax"
 
