scripts/install.sh-1-#!/usr/bin/env bash
scripts/install.sh-2-# install.sh — install ceo-orchestration into a target repo
scripts/install.sh-3-#
scripts/install.sh-4-# Usage:
scripts/install.sh-5-#   ./install.sh <target-repo-path> [options]
scripts/install.sh-6-#
scripts/install.sh-7-# Options:
scripts/install.sh-8-#   --link                         Use symlinks instead of copies (for submodule mode)
scripts/install.sh:9:#   --ceremony <m|u>               Ceremony mode (WS4-ceremony-help):
scripts/install.sh-10-#                                    maintainer (default, full governance) OR
scripts/install.sh:11:#                                    user (no-GPG; advisory hooks only; writes .claude/ only)
scripts/install.sh-12-#   --profile <list>               Comma-separated profiles to install (default: core,frontend)
scripts/install.sh-13-#                                    Available: core, frontend, <domain-name>
scripts/install.sh-14-#                                    Example: --profile core,fintech
scripts/install.sh-15-#                                             --profile core,frontend,fintech
scripts/install.sh-16-#   --stack <name>                 Stack-specific hooks to merge into settings.json
scripts/install.sh-17-#                                    Available: node, none
scripts/install.sh-18-#                                    Example: --stack node  (adds tsc + vitest pre-commit gate)
scripts/install.sh-19-#                                    Default: none
scripts/install.sh-20-#   --github-owner <handle>        GitHub handle to substitute into CODEOWNERS.template
scripts/install.sh-21-#                                    and {{OWNER_HANDLE}} placeholders (e.g. --github-owner alice).
--
scripts/install.sh-137-#      pypirc reads, common .env variants, curl-pipe-bash tripwire).
scripts/install.sh-138-#      HONEST FRAMING: a coarse harness backstop, deliberately NOT sold
scripts/install.sh-139-#      as coverage — the pipe-to-shell class is owned by
scripts/install.sh-140-#      check_bash_safety.py's parse gate. Skipped when settings.json
scripts/install.sh-141-#      pre-existed (re-runs never re-add removed entries) or when
scripts/install.sh-142-#      CEO_INSTALL_SKIP_DENY_BASELINE=1. See docs/deny-baseline.md.
scripts/install.sh-143-#   5. Copies templates/CLAUDE.md to target as CLAUDE.md (only if missing)
scripts/install.sh-144-#   6. Copies templates/MEMORY.md to target as MEMORY.md (only if missing)
scripts/install.sh-145-#   6b. (PLAN-135 W1 S5-lite) Copies templates/.mcp.json to target as
scripts/install.sh-146-#      .mcp.json (only if missing — project-scope MCP registration for
scripts/install.sh:147:#      the Codex pair-rail; maintainer ceremony only, same EXISTS->SKIP
scripts/install.sh-148-#      idempotency as CLAUDE.md/MEMORY.md).
scripts/install.sh-149-#   7. (NEW — P1-CR-3) Runs a sed substitution pass over freshly-installed
scripts/install.sh-150-#      template files for the placeholders supplied via CLI / env. Any
scripts/install.sh-151-#      placeholder left unrendered is reported with a stderr warning and
scripts/install.sh-152-#      listed at the end.
scripts/install.sh:153:#   8. Lists placeholders the user must fill in.
scripts/install.sh-154-#   9. (PLAN-153 Wave B item B1) Records the install-state at
scripts/install.sh-155-#      .claude/.install-state.json (schema ceo.install-state/v1, atomic
scripts/install.sh-156-#      same-directory tmpfile + rename): the ORIGINAL request (verbatim
scripts/install.sh-157-#      argv + every parsed flag + the RESOLVED placeholder map) and each
scripts/install.sh-158-#      operation performed, updated on every run. Target-side, UNSIGNED,
scripts/install.sh-159-#      advisory — same trust class as the ADR-155 baseline manifest.
scripts/install.sh-160-#      upgrade.sh (item B2) replays request.profile / request.stack as
scripts/install.sh-161-#      DEFAULTS when its own flags are omitted.
scripts/install.sh-162-#
scripts/install.sh-163-# Idempotent: re-running won't clobber edited files.
