  1234	def test_driver_derives_every_version_string_from_target_base():
  1235	    """Zero stale literals — and deliberately NO coupling to the repo's current
  1236	    VERSION file. Pinning the driver to VERSION would go red in the one window
  1237	    where the driver MUST be ahead of it: the moment TARGET_BASE is set for the
  1238	    next release and `bump` has not run yet. A gate that blocks the documented
  1239	    path is the failure mode this plan exists to close, not a new instance."""
  1240	    text = DRIVER_SRC.read_text(encoding="utf-8")
  1241	    m = re.search(r'(?m)^TARGET_BASE="(\d+\.\d+\.\d+)"$', text)
  1242	    assert m, "TARGET_BASE is not a bare-semver assignment"
  1243	    target = m.group(1)
  1244	    offenders = []
  1245	    for num, line in enumerate(text.splitlines(), 1):
  1246	        if line.strip() == 'TARGET_BASE="%s"' % target:
  1247	            continue
  1248	        for hit in SEMVER_RX.findall(line):
  1249	            # tolerated: a reference to a PAST incident. It is a historical
  1250	            # fact and cannot be derived from TARGET_BASE.
  1251	            if re.search(r"v%s-rc\.\d+" % re.escape(hit), line):
  1252	                continue
  1253	            offenders.append("%d: %s" % (num, line.strip()))
  1254	    assert not offenders, "version literals not derived from TARGET_BASE:\n%s" % (
  1255	        "\n".join(offenders)
  1256	    )
