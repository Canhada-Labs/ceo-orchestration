     for phase in ("preflight", "bump", "tag"):
@@ -1304,3 +1885,283 @@ def test_install_md_describes_the_current_pair_rail_migration():
     text = (REPO_ROOT / "INSTALL.md").read_text(encoding="utf-8")
     assert "150 → 210 s, ADR-110-AMEND-2" in text
