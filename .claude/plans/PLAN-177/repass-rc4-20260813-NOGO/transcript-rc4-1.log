rg -n \"apply_claude_dir_gitignore|apply_mcp_secrets_ignore|apply_posture_state_ignores|install_posture_state_ignores|install_mcp_secrets_dir\" scripts/install.sh scripts/install-npm.sh scripts/upgrade.sh
