   207	
   208	def _sanitize_for_recs(s: str) -> str:
   209	    """Sanitize a disk-sourced string before recommendation rendering (Sec MF-4).
   210	
   211	    Pipeline (deterministic, applied in order):
   212	
   213	    1. Coerce non-str → str.
   214	    2. Strip NUL bytes (defense vs. accidental binary in audit-log).
   215	    3. NFKC normalize (PLAN-065 Sec MF-4 — collapse homoglyph escapes:
   216	       fullwidth, ligatures, mathematical alphanumerics).
   217	    4. Collapse every line-boundary character (and TAB) to a single space
   218	       (PLAN-165 NF-07, 2026-08-03). Recommendations render one per line
   219	       (``f"{i}. {rec}"``), so a rec carrying a newline became TWO digest
   220	       lines — the second one arbitrary text in the surface the Owner reads
   221	       at boot. Verified end to end: a planted night-mode marker field
   222	       produced a forged ``- [OK] night-mode: DISARMED, posture is the
   223	       ratified manual`` line directly under the true line saying the
   224	       opposite. This step is deliberately INSIDE the shared sanitizer, not
   225	       at the night-mode call site: EVERY rec consumer echoes disk-sourced
   226	       text (check summaries, audit-log classes, stale-plan names), so the
   227	       fix belongs where they all pass. Runs BEFORE the bound (the bound
   228	       must apply to the final string) and BEFORE the scan (a pattern split
   229	       across a line break becomes visible to the scanner).
   230	    5. Length-bound to 200 chars (post-NFKC; NFKC may expand a few code
   231	       points but bound applies to final rendered string).
   232	    6. injection_patterns scan; substitute [REDACTED-INJECTION-PATTERN] on hit.
   233	    7. Strip HTML angle brackets + markdown link URL + backticks (defensive
   234	       belt-and-suspenders if patterns library missed a variant).
   235	
   236	    Note this is a COLLAPSE, not a rejection: recs are advisory text and the
   237	    boot digest must never be blocked by unexpected input (fail-open on
   238	    infrastructure). Callers that need fail-CLOSED rejection of a line break
   239	    do it on the RAW text before calling here — see
   240	    `_lesson_render_safe`'s bounded-vocabulary gate (A5).
   241	    """
   242	    if not isinstance(s, str):
   243	        s = str(s)
   244	    # NUL strip pre-NFKC (NFKC preserves NUL otherwise)
   245	    s = s.replace("\x00", "")
   246	    # NFKC homoglyph collapse — must run BEFORE length bound + scan so that
   247	    # fullwidth/ligature variants are normalized to their ASCII canonicals
   248	    # before the pattern scan (otherwise scanner misses them).
   249	    try:
   250	        s = unicodedata.normalize("NFKC", s)
   251	    except (TypeError, ValueError):
   252	        pass
   253	    # NF-07 (2026-08-03): line-break collapse — post-NFKC, pre-bound,
   254	    # pre-scan (see step 4 of the docstring pipeline).
   255	    s = s.translate(_RECS_ONE_LINE_TABLE)
   256	    s = s[:200]
   257	    if _injection_patterns is not None:
   258	        try:
   259	            # Codex S82 P0 #3 (post-patch v2): scan_harness_mimicry returns
   260	            # ScanResult dataclass (.matched bool), NOT iterable. Previous
   261	            # `if hits:` was always truthy → over-redaction of clean strings.
   262	            # Now check .matched attr; fall back to scan_text alias signature.
   263	            scan_fn = (
   264	                getattr(_injection_patterns, "scan_harness_mimicry", None)
   265	                or getattr(_injection_patterns, "scan_text", None)
   266	            )
   267	            if callable(scan_fn):
   268	                result = scan_fn(s)
   269	                # ScanResult has .matched (bool); legacy iterable returns truthy non-empty
   270	                matched = getattr(result, "matched", None)
   271	                if matched is None:
   272	                    matched = bool(result)  # legacy iterable contract
   273	                if matched:
   274	                    return "[REDACTED-INJECTION-PATTERN]"
   275	        except Exception:  # noqa: BLE001
   276	            pass
   277	    # Strip HTML angle brackets + markdown link syntax + backticks (defensive)
   278	    s = re.sub(r"[<>`]", "", s)
   279	    s = re.sub(r"\[([^\]]*)\]\([^)]*\)", r"\1", s)
   280	    return s
   281	
   282	
   283	# ---- Result dataclass-lite -------------------------------------------------
   284	class CheckResult:
   285	    __slots__ = ("name", "status", "summary", "duration_ms", "detail")
   286	
   287	    def __init__(self, name: str, status: str, summary: str, duration_ms: float, detail: Any = None):
   288	        self.name = name
   289	        self.status = status  # green/yellow/red/timeout/error
   290	        self.summary = summary
   291	        self.duration_ms = duration_ms
   292	        self.detail = detail
   293	
   294	
   295	# ---- 15 Tier-S checks (PoC implementations) -------------------------------
   296	
   297	def check_plans_executing() -> Tuple[str, str, Any]:
   298	    plans = _get_plan_paths()
   299	    executing: List[str] = []
   300	    for p in plans:
   301	        try:
   302	            text = p.read_text(encoding="utf-8", errors="replace")
   303	        except OSError:
   304	            continue
   305	        m = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
   306	        if not m:
   307	            continue
   308	        if re.search(r"^status:\s*executing\s*$", m.group(1), re.MULTILINE):
   309	            executing.append(p.stem)
   310	    status = "yellow" if executing else "green"
   311	    return status, f"{len(executing)} executing", executing
   312	
   313	
   314	def check_plans_reviewed_pending() -> Tuple[str, str, Any]:
   315	    plans = _get_plan_paths()
   316	    reviewed: List[str] = []
   317	    for p in plans:
   318	        try:
   319	            text = p.read_text(encoding="utf-8", errors="replace")
   320	        except OSError:
   321	            continue
   322	        m = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
   323	        if not m:
   324	            continue
   325	        if re.search(r"^status:\s*reviewed\s*$", m.group(1), re.MULTILINE):
   326	            reviewed.append(p.stem)
   327	    return ("yellow" if reviewed else "green", f"{len(reviewed)} reviewed", reviewed)
   328	
   329	
   330	def check_plans_stranded_executing() -> Tuple[str, str, Any]:
   331	    # Subprocess: git log --since=24h --name-only
   332	    try:
   333	        proc = subprocess.run(
   334	            ["git", "-C", str(REPO_ROOT), "log", "--since=24 hours ago", "--name-only", "--pretty=format:"],
   335	            capture_output=True, text=True, timeout=2.0,
   336	        )
   337	        touched = {line.strip() for line in proc.stdout.splitlines() if line.strip()}
   338	    except (subprocess.TimeoutExpired, FileNotFoundError):
   339	        return "yellow", "git unavailable", None
   340	    # Cross-ref against executing plans
   341	    executing_status, _, executing_list = check_plans_executing()
   342	    stranded = [
   343	        plan for plan in executing_list
   344	        if not any(plan in t for t in touched)
   345	    ]
   346	    return ("red" if stranded else "green", f"{len(stranded)} stranded", stranded)
   347	
   348	
   349	def check_plans_draft() -> Tuple[str, str, Any]:
   350	    plans = _get_plan_paths()
   351	    draft: List[str] = []
   352	    for p in plans:
   353	        try:
   354	            text = p.read_text(encoding="utf-8", errors="replace")
   355	        except OSError:
   356	            continue
   357	        m = re.match(r"^---\s*\n(.*?)\n---\s*\n", text, re.DOTALL)
   358	        if not m:
   359	            continue
   360	        if re.search(r"^status:\s*draft\s*$", m.group(1), re.MULTILINE):
   361	            draft.append(p.stem)
   362	    return "green", f"{len(draft)} draft", draft
