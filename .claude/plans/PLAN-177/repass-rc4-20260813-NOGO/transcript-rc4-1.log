  1816	def test_readme_states_the_slsa_level_the_pipeline_actually_reaches():
  1817	    """Same class, most-read file: README advertised "SLSA 3 provenance" while
  1818	    `npm publish --provenance` is a Level-2 attestation and INTEGRITY.md says
  1819	    Level 3 is out of scope. README has no reason to name Level 3 except to
  1820	    disclaim it, so the claim is pinned here."""
  1821	    text = (REPO_ROOT / "README.md").read_text(encoding="utf-8")
  1822	    # The tolerance is scoped to what FOLLOWS the mention, not to the line: the
  1823	    # honest sentence names Level 2 and disclaims Level 3 in one breath, so a
  1824	    # line-wide "out of scope" exemption would let the false claim ride along
  1825	    # beside its own disclaimer. (It did — the first run of this control went
  1826	    # red on the wrong assertion.)
  1827	    offenders = [
  1828	        text[max(0, m.start() - 60):m.end() + 40].strip().replace("\n", " ")
  1829	        for m in re.finditer(r"SLSA[\s-]*(?:Level[\s-]*)?3\b", text)
  1830	        if "out of scope" not in text[m.end():m.end() + 40]
  1831	    ]
  1832	    assert not offenders, (
  1833	        "README claims SLSA Level 3; the shipped provenance is Level 2:\n%s"
  1834	        % "\n".join(offenders)
  1835	    )
  1836	    assert "SLSA **Level 2**" in text or "SLSA Level 2" in text, (
  1837	        "README no longer states the level the pipeline reaches"
  1838	    )
  1839	
