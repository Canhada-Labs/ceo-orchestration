  1586	def test_integrity_doc_makes_no_enforced_claim_for_the_tarball_checksum():
  1587	    """The narrower half of P1-3, plus the whole-file sweep that followed it.
  1588	    `SHA256SUMS.txt` is written by a LOCAL `scripts/install-npm.sh` run, is
  1589	    excluded from the package `files:` array, and no workflow materialises a
  1590	    `.tgz` to hash — so the consumer recipe this file used to publish was
  1591	    impossible, and is REMOVED rather than caveated."""
  1592	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1593	    header = doc.split("## Contract", 1)[0]
  1594	    assert "no** per-tarball" in header or "no per-tarball" in header, (
  1595	        "header no longer states that the tarball checksum is absent"
  1596	    )
  1597	    assert "scripts/install-npm.sh" in doc, (
  1598	        "the doc does not attribute SHA256SUMS.txt to its real, local writer"
  1599	    )
  1600	    assert "sha256sum -c SHA256SUMS.txt" not in doc, (
  1601	        "the impossible consumer recipe is back — it cannot run, because "
  1602	        "SHA256SUMS.txt is not inside the published package"
