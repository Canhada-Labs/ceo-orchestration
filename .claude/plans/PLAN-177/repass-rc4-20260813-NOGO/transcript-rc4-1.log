  1646	# ---------------------------------------------------------------------------
  1647	# PLAN-177 W0.3 delta (codex P1-4 of the v4 round) — the generic sweep.
  1648	#
  1649	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1650	# checksum gate anchors three named phantom referents. A NEW enforcement
  1651	# promise, about some other subject, written into a section nobody watches,
  1652	# passes all of them. The original defect is the proof that this is not
  1653	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1654	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1655	#
  1656	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1657	# Contract table row (machine-checked by
  1658	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1659	# to the table's un-enforced rows by
  1660	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1661	# Anywhere else it is answerable to nothing, and is a red.
  1662	#
  1663	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1664	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1665	#
  1666	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1667	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1668	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1669	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1670	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1671	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1672	#     at the table rather than enumerating mechanisms, and the tag-signing
  1673	#     paragraph cites SECURITY.md as the authority instead of restating the
  1674	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1675	#     needs no exemption, so it has none.
  1676	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1677	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1678	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1679	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1680	#     are the file speaking about what the pipeline does.
  1681	#     A broad list that has to be switched off is worth less than a narrow
  1682	#     one that stays on.
  1683	#
  1684	# Matching is on word boundaries after normalization. Substring matching was
  1685	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1686	# substring-vs-exact class, for the fourth time in this plan.
  1687	_ENFORCEMENT_VOCAB = (
  1688	    "enforced today",
  1689	    "is enforced",
  1690	    "are enforced",
  1691	    "enforced by",
  1692	    "enforced at",
  1693	    "every tag publish",
  1694	    "recorded by",
  1695	    "is verified",
  1696	    "are verified",
  1697	    "verifies",
  1698	    "must satisfy",
  1699	    "guarantees",
  1700	    "is guaranteed",
  1701	    "are guaranteed",
  1702	    "asserted by",
  1703	    "checked by",
  1704	    "gated by",
  1705	    "fails closed",
  1706	    "fail closes",
  1707	    "asserts",
  1708	    "ensures",
  1709	    "is signed",
  1710	    "are signed",
  1711	)
  1712	
  1713	
  1714	def _normalize_prose(text: str) -> str:
  1715	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1716	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1717	    normalize the same way, so a claim cannot hide behind formatting."""
  1718	    text = text.lower()
  1719	    for ch in ("*", "`", "_"):
  1720	        text = text.replace(ch, "")
  1721	    text = text.replace("-", " ")
  1722	    return re.sub(r"\s+", " ", text)
  1723	
  1724	
  1725	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1726	    """Everything that is neither a Contract table row nor §Not yet
  1727	    automated — the surfaces where a mechanism claim answers to nothing."""
  1728	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1729	    return "\n".join(
  1730	        line for line in body.splitlines() if not line.strip().startswith("|")
  1731	    )
  1732	
  1733	
  1734	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1735	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1736	    offenders = []
  1737	    for phrase in _ENFORCEMENT_VOCAB:
  1738	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1739	            offenders.append(
  1740	                "%r outside the declared zones: ...%s..."
  1741	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1742	            )
  1743	    return offenders
  1744	
  1745	
  1746	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1747	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1748	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1749	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1750	    even standing somewhere that can be checked?" — the question the file
  1751	    failed on the day it shipped."""
  1752	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1753	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1754	
  1755	    # The sweep must be looking at the right text: intro present, table absent.
  1756	    swept = _prose_outside_the_declared_zones(doc)
  1757	    assert "Integrity contract for the" in swept, (
  1758	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1759	        "the prose it exists to watch"
  1760	    )
  1761	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1762	    assert len(swept) > len(doc) // 3, (
  1763	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1764	        % (len(swept), len(doc))
  1765	    )
  1766	
  1767	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1768	    # merits. The order matters and was learned the hard way — the controls
  1769	    # below build their fixtures FROM the live file, so when the file itself
  1770	    # carries a planted defect they fail first and the red names the fixture
  1771	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1772	    # always reds on the assertion that describes what is actually wrong.
  1773	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1774	    offenders = _enforcement_vocabulary_offenders(doc)
  1775	    assert not offenders, (
  1776	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1777	        "§Not yet automated. Move the claim into a table row (with a step the "
  1778	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1779	    )
  1780	
  1781	    # (b) positive control: the historical claim restored to the introduction.
  1782	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1783	    # today's wording — an anchor on current prose stops matching the moment
  1784	    # that prose is edited, and then the control fails for the wrong reason.
  1785	    title, _, rest = doc.partition("\n")
  1786	    claim = (
  1787	        "The integrity controls enforced today are: (1) the `install.sh` "
  1788	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1789	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1790	    )
  1791	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1792	    assert relapse != doc, "relapse fixture did not patch the doc"
  1793	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1794	    assert any("enforced today" in o for o in relapse_offenders), (
  1795	        "an enforcement claim in the introduction went unseen: %s"
  1796	        % relapse_offenders
  1797	    )
  1798	    assert any("recorded by" in o for o in relapse_offenders), (
  1799	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1800	    )
  1801	
  1802	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1803	    # offender. This is the predicate as documented, not a global grep — that
  1804	    # section is where honest prose about absence has to be able to use these
  1805	    # words. Its own honesty is held by the restatement test above; a claim
  1806	    # parked there is the residual gap, and it is a narrow, watched one.
  1807	    marker = "## Not yet automated"
  1808	    assert marker in doc
  1809	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1810	    assert not _enforcement_vocabulary_offenders(parked), (
  1811	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1812	        "a declared zone"
  1813	    )
  1814	
