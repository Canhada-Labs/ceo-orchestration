  1368	def test_npm_docs_carry_no_bare_version_literal(tmp_path):
  1369	    """P1-2. `npm/INTEGRITY.md` declared its own version and drifted three
  1370	    minors behind `VERSION` while `bump --stable` correctly reported a no-op:
  1371	    the file is not a bump site and — until this commit — not a scanned
  1372	    surface either. The cure is version-NEUTRAL prose, not a new writer row
  1373	    (a writer with no oracle is the dead rule `_release_bump_sites.py`
  1374	    already refuses to reintroduce)."""
  1375	    assert NPM_DOC_SURFACES, "no npm doc is scanned — the P1-2 surface is unwatched"
  1376	
  1377	    # Positive control FIRST, in a throwaway tree, and planted in the SAME
  1378	    # relative paths the real scan uses: this proves the SURFACE is covered,
  1379	    # not merely that the regex can match a version somewhere. The stamped
  1380	    # file rides along because an over-firing control gets exempted away
  1381	    # within a release.
  1382	    for rel in NPM_DOC_SURFACES:
  1383	        target = tmp_path / rel
  1384	        target.parent.mkdir(parents=True, exist_ok=True)
  1385	        target.write_text(
  1386	            "> built and versioned (`VERSION` / `package.json`, "
  1387	            "currently 1.0.1).\n"
  1388	            "<!-- last-reviewed: 2026-08-05 v1.3.0 -->\n",
  1389	            encoding="utf-8",
  1390	        )
  1391	    planted = _bare_version_offenders_in_npm_docs(tmp_path)
  1392	    assert len(planted) == len(NPM_DOC_SURFACES), (
  1393	        "positive control did not flag every scanned npm doc exactly once "
  1394	        "(stamp line must stay exempt): %s" % planted
  1395	    )
  1396	    for rel in NPM_DOC_SURFACES:
  1397	        assert any(o.startswith(rel + ":") for o in planted), (
  1398	            "%s is in SCAN_ROOTS but the planted literal there was not "
  1399	            "reported: %s" % (rel, planted)
  1400	        )
  1401	
  1402	    offenders = _bare_version_offenders_in_npm_docs(REPO_ROOT)
  1403	    assert not offenders, (
  1404	        "bare version literal in an npm doc (VERSION is the only authority; "
  1405	        "make the prose version-neutral):\n%s" % "\n".join(offenders)
  1406	    )
  1407	
  1408	
  1409	INTEGRITY_DOC = REPO_ROOT / "npm" / "INTEGRITY.md"
  1410	# Closed set. A row whose Status is anything else is a red — fail-closed on
  1411	# unknown vocabulary, because the way this table decayed the first time was a
  1412	# cell that READ like enforcement ("(to-add)", "Release script (Sprint 17
  1413	# scope)") without ever being it.
  1414	_CONTRACT_STATUSES = ("enforced", "deferred", "operator")
  1415	# `<workflow>.yml` in backticks, then the step name in straight quotes. Both
  1416	# delimiters are load-bearing: they are what makes the claim parseable at all.
  1417	_ENFORCED_RX = re.compile(r'`([^`]+\.yml)`\s+step\s+"([^"]+)"')
  1418	# Without a floor, a parser that suddenly matches nothing reports zero
  1419	# offenders and the gate passes having checked NOTHING. Two is the smallest
  1420	# floor that also keeps a one-row table from satisfying it by accident.
  1421	_MIN_ENFORCED_PAIRS = 2
  1422	
  1423	
  1424	def _yaml_step_names(path: Path) -> List[str]:
  1425	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1426	    call site: a substring match would accept "Verify VERSION" for a step
  1427	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1428	    already cost this repo three incidents in one session."""
  1429	    text = path.read_text(encoding="utf-8")
  1430	    names = []
  1431	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1432	        name = m.group(1)
  1433	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1434	            name = name[1:-1]
  1435	        names.append(name)
  1436	    return names
  1437	
  1438	
  1439	def _contract_rows(doc_text: str) -> List[List[str]]:
  1440	    """The `## Contract` table as [control, mechanism, status, where]."""
  1441	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1442	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1443	    rows = []
  1444	    for line in m.group(0).splitlines():
  1445	        line = line.strip()
  1446	        if not line.startswith("|"):
  1447	            continue
  1448	        cells = [c.strip() for c in line.strip("|").split("|")]
  1449	        if len(cells) != 4:
  1450	            continue
  1451	        if cells[0] == "Control" or set(cells[0]) <= set("- :"):
  1452	            continue
  1453	        rows.append(cells)
  1454	    return rows
  1455	
  1456	
  1457	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1458	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1459	    Status are not read — a row that claims no enforcement makes no claim to
  1460	    check."""
  1461	    out: List[List[str]] = []
  1462	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1463	        if status != "enforced":
  1464	            continue
  1465	        for workflow, step in _ENFORCED_RX.findall(where):
  1466	            out.append([control, workflow, step])
  1467	    return out
  1468	
  1469	
  1470	def _integrity_contract_offenders(doc_text: str, repo_root: Path) -> List[str]:
  1471	    """Closed-set Status, plus: every `enforced` row names a workflow that
  1472	    exists and a step that exists in it, by exact equality."""
  1473	    offenders: List[str] = []
  1474	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1475	        if status not in _CONTRACT_STATUSES:
  1476	            offenders.append(
  1477	                "%s: Status %r is outside the closed set %s"
  1478	                % (control, status, list(_CONTRACT_STATUSES))
  1479	            )
  1480	            continue
  1481	        if status != "enforced":
  1482	            continue
  1483	        pairs = _ENFORCED_RX.findall(where)
  1484	        if not pairs:
  1485	            offenders.append(
  1486	                "%s: Status is enforced but `Where enforced` names no "
  1487	                "workflow+step in the parseable form — %r" % (control, where)
  1488	            )
  1489	            continue
  1490	        for workflow, step in pairs:
  1491	            wf = repo_root / workflow
  1492	            if not wf.is_file():
  1493	                offenders.append(
  1494	                    "%s: names workflow %s, which does not exist"
  1495	                    % (control, workflow)
  1496	                )
  1497	                continue
  1498	            if step not in _yaml_step_names(wf):
  1499	                offenders.append(
  1500	                    "%s: names step %r in %s, which has no such step"
  1501	                    % (control, step, workflow)
  1502	                )
  1503	    return offenders
  1504	
