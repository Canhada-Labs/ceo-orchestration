   116	concurrency:
   117	  group: smoke-install-${{ github.ref }}
   118	  cancel-in-progress: true
   119	
   120	jobs:
   121	  smoke:
   122	    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity.
   123	    if: vars.CEO_SOTA_DISABLE != '1'
   124	    runs-on: ubuntu-latest
   125	    # PLAN-161: 5 -> 8 — headroom for the two upgrade oracles (each runs
   126	    # full install + upgrade legs against fixture adopter repos).
   127	    # PLAN-166 F4: 8 -> 20. MEASURED, not guessed. The parity e2e runs 2 full
   128	    # install legs + 1 upgrade leg PER ceremony mode, and the positive control
   129	    # runs the same again with a planted divergence: 12 install/upgrade
   130	    # operations added to this job. Local wall time (Darwin arm64, 16 cores,
   131	    # 2026-08-05): gate 122s + control 118s = 240s. A 2-core ubuntu-latest
   132	    # runner is the usual 2-3x slower, i.e. 8-12 min of NEW work on top of the
   133	    # ~5 min this job already spent. 15 would sit inside the noise band, and
   134	    # the perf-gate N=20 flake (PLAN-159) was exactly that mistake. Re-tighten
   135	    # once real CI runs give a p95.
   136	    # PLAN-166 F3 (assembler): 20 -> 25. The spec-ownership e2e adds 4 more
   137	    # installs + 3 upgrades (S1-S8; ~3-4 min local per the W1-C measurement),
   138	    # i.e. up to ~8-10 more CI minutes at the same 2-3x factor. Same
   139	    # anti-flake sizing rule as the F4 bump above.
   140	    # PLAN-177 W1 (CF-9): 25 -> 32. The night-mode efficacy e2e adds 3 installs
   141	    # + 2 upgrades. MEASURED, not guessed: 2m06s wall on Darwin arm64 (16
   142	    # cores, 2026-08-13), reproduced across two runs. At the same 2-3x runner
   143	    # factor this workflow already sizes with, that is 4-7 CI minutes, so +7.
   144	    # A job-level timeout that clips a green run reports as `cancelled` on an
   145	    # innocent step (the S2xx lesson), so the margin stays deliberate.
   146	    timeout-minutes: 32
   147	    permissions:
   148	      contents: read
   149	    steps:
   150	      - name: Checkout
   151	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   152	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   153	        with:
   154	          fetch-depth: 1
   155	
   156	      # PLAN-166 F4: the parity e2e's historical leg installs from a PINNED
   157	      # TAG. `fetch-depth: 1` produces a checkout with NO tags, so the pin
   158	      # would not resolve and the gate would die before comparing a single
   159	      # tree - "it passes on my clone" is precisely the hole this test exists
   160	      # to close. The pin is READ FROM THE TEST (--print-pin) so the workflow
   161	      # never becomes a second copy of that truth.
   162	      - name: Fetch the parity pin tag
   163	        run: |
   164	          set -euo pipefail
   165	          PIN="$(bash scripts/tests/test-install-upgrade-parity-e2e.sh --print-pin)"
   166	          echo "parity historical pin: $PIN"
   167	          git fetch --no-tags --depth 1 origin "+refs/tags/$PIN:refs/tags/$PIN"
   168	          git rev-parse --verify "refs/tags/$PIN^{commit}"
   169	
   170	      - name: Setup Python 3.11
   171	        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
   172	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
   173	        with:
   174	          python-version: "3.11"
   175	
   176	      - name: Install jq (for settings.json merge)
   177	        run: |
   178	          set -euo pipefail
   179	          if ! command -v jq >/dev/null 2>&1; then
   180	            sudo apt-get update -qq
   181	            sudo apt-get install -y -qq jq
   182	          fi
   183	          jq --version
   184	
   185	      # PLAN-168 W1 (AC-4, per-PR half): the DECISION oracle —
   186	      # _ownership_verdict() against every truth-table cell, in milliseconds.
   187	      # The OBSERVATION half (the ~25-min e2e) runs in ownership-nightly.yml;
   188	      # this fast half is what makes table/harness PRs cheap to gate.
   189	      - name: Ownership verdict unit oracle (milliseconds)
   190	        run: |
   191	          set -euo pipefail
   192	          bash scripts/tests/test-ownership-verdict-unit.sh
   193	
   194	      # PLAN-168 W1 (rail r3 P1): the nightly gate's fake-harness control is
   195	      # milliseconds — run it per-PR so a PR touching the gate cannot break
   196	      # its rc/status handling while PR checks stay green.
   197	      - name: Ownership nightly-gate positive control (fake harness)
   198	        run: |
   199	          set -euo pipefail
   200	          bash scripts/tests/test-ownership-nightly-gate.sh
   201	
   202	      # PLAN-168 W2 (AC-6, per-PR half of INV-4): the shared pointer
   203	      # generator's 8-scenario control — includes ONE real install (~1-2 min
   204	      # on CI iron). The full install->upgrade->cure e2e (4 legs, ~5 min CI)
   205	      # is nightly-only; MEASURED per the smoke budget notes above.
   206	      - name: Protocol pointer render control (generator parity)
   207	        run: |
   208	          set -euo pipefail
   209	          bash scripts/tests/test-protocol-pointer-render.sh
   210	
   211	      - name: Run smoke install
   212	        run: |
   213	          set -euo pipefail
   214	          bash scripts/tests/smoke-install.sh
   215	
   216	      # PLAN-161 upgrade oracles (green only once the U1/U2/U3 upgrade.sh
   217	      # fixes are in-tree — land atomically with them).
   218	      - name: Upgrade oracle — --dry-run identity (U1)
   219	        run: |
   220	          set -euo pipefail
   221	          bash scripts/tests/test-upgrade-dryrun-identity.sh
   222	
   223	      - name: Upgrade oracle — exclusion parity + opt-in purge (U2/U3)
   224	        run: |
   225	          set -euo pipefail
   226	          bash scripts/tests/test-upgrade-exclusions.sh
   227	
   228	      # WS4-user-ceremony-leg
   229	      - name: Install with --ceremony user (governance rc=0 + no out-of-.claude writes)
   230	        run: |
   231	          set -euo pipefail
   232	          U="$(mktemp -d)"
   233	          ( cd "$U" && git init -q )
   234	          CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   235	            bash scripts/install.sh "$U" --ceremony user
   236	          echo '--- validate-governance.sh (user) ---'
   237	          ( cd "$U" && bash .claude/scripts/validate-governance.sh )
   238	          echo '--- assert only .claude/ at top level ---'  # WS4-sc2010-glob
   239	          extra=""
   240	          for _e in "$U"/* "$U"/.[!.]* "$U"/..?*; do
   241	            [ -e "$_e" ] || continue
   242	            _b="$(basename "$_e")"
   243	            case "$_b" in .claude|.git) continue ;; esac
   244	            extra="$extra $_b"
   245	          done
   246	          if [ -n "$extra" ]; then
   247	            echo "::error::--ceremony user wrote outside .claude/:$extra"
   248	            exit 1
   249	          fi
   250	          echo 'user-ceremony leg: PASS'
   251	
   252	      # PLAN-166 F4 (OQ-4) - install/upgrade parity on the RESULTING TREES,
   253	      # per ceremony mode. NO continue-on-error, deliberately: the assertion
   254	      # this replaces was dead twice over (tautological AND wired into no
   255	      # workflow), and an escape hatch here would reinstate exactly that.
   256	      # Exit 2 (KNOWN-OPEN) is a FAILURE too - it NAMES the outstanding
   257	      # PLAN-166 W1 prerequisites instead of skipping them silently.
   258	      - name: Install/upgrade parity e2e (maintainer + user ceremony)
   259	        run: |
   260	          set -euo pipefail

