  1856	def test_checklist_documents_the_new_driver_and_the_await_gate_recovery():
  1857	    text = (REPO_ROOT / ".github/release-checklist.md").read_text(encoding="utf-8")
  1858	    for phase in ("preflight", "bump", "tag"):
  1859	        assert "release.sh %s" % phase in text, phase
  1860	    assert "await-release-gate" in text
  1861	    # the recovery route is a re-run, explicitly NOT a delete + re-tag
  1862	    assert "re-rodar o job" in text
  1863	    assert "deletar/re-criar a tag" in text
  1864	    # and the manual approval is the last human chance, not a second opinion
  1865	    assert "última chance" in text
