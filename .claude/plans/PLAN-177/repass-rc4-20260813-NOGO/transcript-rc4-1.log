     1	"""PLAN-177 W1 (T-1) — every tournament.yml step that touches ``projection.txt``
     2	must run where that file lives.
     3	
     4	WHY THIS EXISTS
     5	---------------
     6	``projection.txt`` is written by the "Cost projection" step, which declares
     7	``working-directory: .claude/scripts``. The "Emit step summary" step read it
     8	with a bare relative path from the repo root, so ``json.load`` always raised
     9	``FileNotFoundError`` — swallowed by ``2>/dev/null || echo "N/A"``. The summary
    10	reported ``Projection: N/A`` on fully green runs and nobody could tell that
    11	apart from a real absence. Adding ``working-directory`` to that step is the
    12	fix; this test is the control that keeps it, and that would have caught the
    13	original bug.
    14	
    15	The assertion is STRUCTURAL, not a substring count: a step "carries" the
    16	working-directory only if the key belongs to THAT step's own mapping. A
    17	``grep -c working-directory`` would pass with the key attached to the wrong
    18	step. Parsing is stdlib-only and deliberately does not ``import yaml`` — a
    19	gate that ``skipTest``s itself when an optional dependency is missing is a gate
    20	that can silently stop running (the "instrument green with a stale question"
    21	class this repo keeps re-finding).
    22	
    23	SCOPE: ``run`` steps only. ``working-directory`` is a property of a ``run``
    24	step; a ``uses:`` step does not accept it, and the artifact upload names the
    25	file through ``path: .claude/scripts/projection.txt`` precisely because it
    26	cannot. A gate over "every step that mentions projection.txt" would demand the
    27	key from a step that is already correct and cannot have it — a false red on
    28	correct code, which is how gates get disabled.
    29	
    30	The exemption is DERIVED, not asserted: a step qualifies only if it has a
    31	``run:`` key AND names the artifact by a relative path. A ``uses:`` step is out
    32	of scope structurally, and a ``run`` step that later drops the
    33	``.claude/scripts/`` prefix comes back into scope automatically.
    34	"""
    35	from __future__ import annotations
    36	
    37	import re
    38	import sys
    39	import unittest
    40	from pathlib import Path
    41	from typing import List, Optional, Tuple
    42	
    43	_REPO = Path(__file__).resolve().parent.parent.parent.parent
    44	_WORKFLOW = _REPO / ".github" / "workflows" / "tournament.yml"
    45	
    46	_HOOKS_DIR = _REPO / ".claude" / "hooks"
    47	if str(_HOOKS_DIR) not in sys.path:
    48	    sys.path.insert(0, str(_HOOKS_DIR))
    49	from _lib.testing import TestEnvContext  # noqa: E402
    50	
    51	_ARTIFACT = "projection.txt"
    52	_QUALIFIED = ".claude/scripts/" + _ARTIFACT
    53	_REQUIRED_WORKDIR = ".claude/scripts"
    54	
    55	_STEP_RE = re.compile(r"^(\s*)-\s+name:\s*(.*)$")
    56	_KEY_RE = re.compile(r"^(\s*)([A-Za-z][A-Za-z0-9_-]*):\s*(.*)$")
    57	
    58	
    59	def _indent(line: str) -> int:
    60	    return len(line) - len(line.lstrip(" "))
    61	
    62	
    63	def _split_steps(text: str) -> List[Tuple[str, List[str]]]:
    64	    """Return ``(step_name, body_lines)`` for every ``- name:`` step.
    65	
    66	    A step runs from its ``- name:`` line until the next ``- name:`` at the
    67	    same or shallower indent, or until the first non-blank line indented LESS
    68	    than the dash (which ends the enclosing ``steps:`` list).
    69	    """
    70	    lines = text.splitlines()
    71	    starts = [i for i, ln in enumerate(lines) if _STEP_RE.match(ln)]
    72	    steps: List[Tuple[str, List[str]]] = []
    73	    for pos, start in enumerate(starts):
    74	        m = _STEP_RE.match(lines[start])
    75	        assert m is not None
    76	        dash_indent = len(m.group(1))
    77	        end = len(lines)
    78	        for j in range(start + 1, len(lines)):
    79	            ln = lines[j]
    80	            if not ln.strip():
    81	                continue
    82	            nxt = _STEP_RE.match(ln)
    83	            if nxt is not None and len(nxt.group(1)) <= dash_indent:
    84	                end = j
    85	                break
    86	            if _indent(ln) < dash_indent:
    87	                end = j
    88	                break
    89	        steps.append((m.group(2).strip(), lines[start:end]))
    90	        del pos
    91	    return steps
    92	
    93	
    94	def _step_key(body: List[str], key: str) -> Optional[str]:
    95	    """Value of ``key`` in the step's OWN mapping, else None.
    96	
    97	    The step's own keys sit exactly two columns right of the dash. Keys nested
    98	    deeper belong to a sub-mapping (``with:``, ``env:``) and do not count.
    99	    """
   100	    m = _STEP_RE.match(body[0])
   101	    assert m is not None
   102	    own_indent = len(m.group(1)) + 2
   103	    for ln in body[1:]:
   104	        km = _KEY_RE.match(ln)
   105	        if km is None or len(km.group(1)) != own_indent:
   106	            continue
   107	        if km.group(2) == key:
   108	            return km.group(3).strip()
   109	    return None
   110	
   111	
   112	def _in_scope(body: List[str]) -> bool:
   113	    """True iff this step can and must declare ``working-directory``.
   114	
   115	    Two conditions, both derived from the step itself:
   116	
   117	    * it is a ``run`` step. ``working-directory`` is a property of ``run``;
   118	      a ``uses:`` step does not accept the key at all, so demanding it there
   119	      would be a false red on correct code (the artifact upload is exactly
   120	      that step, and it names the file by its full path for this reason).
   121	    * it names the artifact by a RELATIVE path — i.e. at least one mention is
   122	      not part of ``.claude/scripts/projection.txt``.
   123	    """
   124	    if _step_key(body, "run") is None:
   125	        return False
   126	    blob = "\n".join(body)
   127	    if _ARTIFACT not in blob:
   128	        return False
   129	    return blob.count(_ARTIFACT) != blob.count(_QUALIFIED)
   130	
   131	
   132	def steps_touching_artifact(text: str) -> List[str]:
   133	    """Names of the ``run`` steps that reference ``projection.txt`` relatively."""
   134	    return [name for name, body in _split_steps(text) if _in_scope(body)]
   135	
   136	
   137	def steps_missing_workdir(text: str) -> List[str]:
   138	    """The gate: in-scope steps whose own mapping lacks the workdir."""
   139	    return [
   140	        name for name, body in _split_steps(text)
   141	        if _in_scope(body)
   142	        and _step_key(body, "working-directory") != _REQUIRED_WORKDIR
   143	    ]
   144	
   145	
   146	def uses_steps_touching_artifact(text: str) -> List[str]:
   147	    """``uses:`` steps that mention the artifact — must never be in scope."""
   148	    return [
   149	        name for name, body in _split_steps(text)
   150	        if _step_key(body, "uses") is not None
   151	        and _ARTIFACT in "\n".join(body)
   152	    ]
   153	
   154	
   155	class TournamentProjectionWorkdirTest(TestEnvContext):
   156	    """T-1 — the summary step reads projection.txt where it is written."""
   157	
   158	    def setUp(self):
   159	        super().setUp()
   160	        self.source = _WORKFLOW.read_text(encoding="utf-8")
   161	
   162	    def test_parser_sees_the_workflow_steps(self):
   163	        # Non-vacuity floor for the parser itself: tournament.yml is a
   164	        # multi-step workflow, so a parse that finds ~nothing is broken.
   165	        self.assertGreaterEqual(len(_split_steps(self.source)), 10)
   166	
   167	    def test_at_least_two_steps_use_the_artifact(self):
   168	        # MANDATORY-FIRE: the producer ("Cost projection") and the consumer
   169	        # ("Emit step summary"). If this drops to <2, either the workflow was
   170	        # restructured or the matcher went blind — either way the gate below
   171	        # stops meaning anything and must be re-derived, not deleted.
   172	        touching = steps_touching_artifact(self.source)
   173	        self.assertGreaterEqual(
   174	            len(touching), 2,
   175	            "expected >=2 steps referencing projection.txt by relative path, "
   176	            "found: %r" % (touching,))
   177	
   178	    def test_every_relative_step_declares_working_directory(self):
   179	        missing = steps_missing_workdir(self.source)
   180	        self.assertEqual(
   181	            missing, [],
   182	            "tournament.yml steps reference %s relatively but do not declare "
   183	            "`working-directory: %s`, so the read resolves against the repo "
   184	            "root and silently yields N/A: %r"
   185	            % (_ARTIFACT, _REQUIRED_WORKDIR, missing))
   186	
   187	    def test_uses_steps_are_out_of_scope_structurally(self):
   188	        # The artifact upload is a `uses:` step. GitHub Actions does not accept
   189	        # `working-directory` on `uses:` steps at all, so it must be out of
   190	        # scope BY ITS SHAPE — not by a hardcoded step-name exemption. It must
   191	        # also actually exist, or this assertion is vacuous.
   192	        uses_steps = uses_steps_touching_artifact(self.source)
   193	        self.assertTrue(
   194	            uses_steps,
   195	            "no `uses:` step mentions the artifact — the exemption this test "
   196	            "guards no longer has a subject; re-derive it")
   197	        in_scope = steps_touching_artifact(self.source)
   198	        for name in uses_steps:
   199	            self.assertNotIn(
   200	                name, in_scope,
   201	                "`uses:` step %r was pulled into scope; a gate demanding "
   202	                "working-directory there would red-flag correct code" % (name,))
   203	        self.assertIn(_QUALIFIED, self.source)
   204	
   205	    def test_a_uses_step_with_a_relative_path_stays_out_of_scope(self):
   206	        # Even if a `uses:` step named the artifact relatively, it still cannot
   207	        # carry working-directory — so the `run:` condition, not the path
   208	        # shape, is what must keep it out.
   209	        mutated = self.source.replace(
   210	            "          path: " + _QUALIFIED,
   211	            "          path: " + _ARTIFACT)
   212	        self.assertNotEqual(mutated, self.source, "mutation changed nothing")
   213	        self.assertEqual(
   214	            uses_steps_touching_artifact(mutated),
   215	            [n for n in uses_steps_touching_artifact(mutated)
   216	             if n not in steps_touching_artifact(mutated)],
   217	            "a `uses:` step entered scope once its path went relative — the "
   218	            "gate is keying on the path, not on `run:`")
