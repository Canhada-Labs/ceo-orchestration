   221	class PositiveControlTest(TestEnvContext):
   222	    """The gate must go RED on the exact regression it exists to prevent."""
   223	
   224	    def setUp(self):
   225	        super().setUp()
   226	        self.source = _WORKFLOW.read_text(encoding="utf-8")
   227	
   228	    def test_removing_every_workdir_is_detected(self):
   229	        mutated = self.source.replace(
   230	            "        working-directory: .claude/scripts\n", "")
   231	        self.assertNotEqual(mutated, self.source, "mutation changed nothing")
   232	        self.assertGreaterEqual(
   233	            len(steps_missing_workdir(mutated)), 2,
   234	            "stripping the working-directory keys did not turn the gate red")
   235	
   236	    def test_removing_only_the_last_workdir_is_detected(self):
   237	        marker = "        working-directory: .claude/scripts\n"
   238	        cut = self.source.rfind(marker)
   239	        self.assertNotEqual(cut, -1, "marker not found — mutation vacuous")
   240	        mutated = self.source[:cut] + self.source[cut + len(marker):]
   241	        missing = steps_missing_workdir(mutated)
   242	        self.assertEqual(
   243	            len(missing), 1,
   244	            "removing ONE working-directory should flag exactly one step, "
   245	            "got: %r" % (missing,))
   246	
   247	    def test_key_nested_under_with_does_not_count(self):
   248	        # A working-directory placed inside a sub-mapping must not satisfy the
   249	        # gate — this is what separates a structural check from `grep -c`.
   250	        mutated = self.source.replace(
   251	            "        working-directory: .claude/scripts\n",
   252	            "        with:\n          working-directory: .claude/scripts\n")
   253	        self.assertNotEqual(mutated, self.source, "mutation changed nothing")
   254	        self.assertGreaterEqual(
   255	            len(steps_missing_workdir(mutated)), 2,
   256	            "a nested working-directory satisfied the gate — the check is "
   257	            "matching text, not structure")
