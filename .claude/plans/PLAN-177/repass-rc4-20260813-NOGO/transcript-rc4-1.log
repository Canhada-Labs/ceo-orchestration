   162	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   163	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   164	    if not manifest_path.exists():
   165	        raise FileNotFoundError(f"manifest: {manifest_path}")
   166	    paths = []
   167	    for line in manifest_path.read_text().splitlines():
   168	        line = line.split("#", 1)[0].strip()
   169	        if line:
   170	            paths.append(line)
   171	    paths.sort()
   172	    hashes = {}
   173	    for p in paths:
   174	        result = subprocess.run(
   175	            ["git", "hash-object", p],
   176	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   177	        )
   178	        if result.returncode != 0:
   179	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   180	        hashes[p] = result.stdout.strip()
   181	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   182	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   183	
   184	
   185	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   186	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   187	    if not pin_file.exists():
   188	        return None, None
   189	    for line in pin_file.read_text().splitlines():
   190	        line = line.split("#", 1)[0].strip()
   191	        if not line:
   192	            continue
   193	        # parse `>=X.Y.Z,<A.B.C` shape
   194	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   195	        if m:
   196	            return m.group(1), m.group(2)
   197	    return None, None
   198	
   199	
   200	def parse_semver(s: str) -> Tuple[int, int, int]:
   201	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   202	    if not m:
   203	        raise ValueError(f"unparseable semver: {s!r}")
   204	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   205	
   206	
   207	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   208	    try:
   209	        v = parse_semver(version)
   210	        lo = parse_semver(min_v)
   211	        hi = parse_semver(max_v)
   212	        return lo <= v < hi
   213	    except ValueError:
   214	        return False
