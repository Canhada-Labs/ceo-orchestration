   365	def check_audit_log_freshness() -> Tuple[str, str, Any]:
   366	    """Check audit-log freshness + surface errors sidecar signals.
   367	
   368	    F-6.3 (PLAN-113 W7-OPS): also inspects audit-log.errors sidecar so
   369	    that spool_writer FAIL-CLOSED floods become visible at boot time.
   370	    The errors sidecar is resolved via CEO_AUDIT_LOG_ERR env var if set,
   371	    otherwise defaults to audit-log.errors sibling of AUDIT_LOG_DEFAULT.
   372	    Fail-open on any OSError — never blocks boot.
   373	    """
   374	    try:
   375	        st = AUDIT_LOG_DEFAULT.stat()
   376	    except OSError:
   377	        return "yellow", "audit-log missing", None
   378	    age_s = time.time() - st.st_mtime
   379	    age_h = age_s / 3600.0
   380	    size_mb = st.st_size / (1024 * 1024)
   381	
   382	    # F-6.3: inspect audit-log.errors sidecar for write failures.
   383	    errors_path_raw = os.environ.get("CEO_AUDIT_LOG_ERR", "")
   384	    if errors_path_raw:
   385	        errors_path = Path(errors_path_raw)
   386	    else:
   387	        errors_path = AUDIT_LOG_DEFAULT.parent / "audit-log.errors"
   388	
   389	    errors_present = False
   390	    errors_line_count = 0
   391	    try:
   392	        if errors_path.is_file():
   393	            errors_st = errors_path.stat()
   394	            if errors_st.st_size > 0:
   395	                errors_present = True
   396	                # Count lines without reading the full file into memory.
   397	                with errors_path.open("rb") as ef:
   398	                    errors_line_count = sum(1 for _ in ef)
   399	    except OSError:
   400	        pass  # fail-open
   401	
   402	    detail: Dict[str, Any] = {
   403	        "age_hours": age_h,
   404	        "size_mb": size_mb,
   405	        "errors_present": errors_present,
   406	        "errors_line_count": errors_line_count,
   407	    }
   408	    if errors_present:
   409	        status = "yellow"
   410	        summary = (
   411	            f"{age_h:.1f}h old, {size_mb:.1f} MB "
   412	            f"[audit-log.errors: {errors_line_count} lines]"
   413	        )
   414	    else:
   415	        status = "green" if age_h < 24 else "yellow"
   416	        summary = f"{age_h:.1f}h old, {size_mb:.1f} MB"
   417	    return status, summary, detail
   418	
