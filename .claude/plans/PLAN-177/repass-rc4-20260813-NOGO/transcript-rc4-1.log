    58	    def test_manifest_dedup_on_rebuild(self):
    59	        # PLAN-023 Phase A: when the manifest already carries a line
    60	        # for the same tarball filename, install-npm.sh must REPLACE
    61	        # that line in-place rather than append a duplicate. This
