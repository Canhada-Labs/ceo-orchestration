     1	#!/usr/bin/env bash
     2	# scripts/tests/test-night-mode-ignore-effect.sh
     3	# PLAN-177 W1 (CF-9) — EFFICACY of the posture-state ignores, not parity.
     4	#
     5	# WHY THIS EXISTS
     6	# ---------------
     7	# The install/upgrade parity e2e proves the two routes converge on the same
     8	# BYTES, and BYTE-PROOF.md proves the generator reproduces install.sh's output
     9	# exactly. Neither can see whether the delivered bytes actually WORK: an
    10	# ineffective ignore — wrong anchor, wrong path, right file in the wrong
    11	# directory — is equally ineffective on both routes, so it is byte-identical
    12	# and every parity check stays green. That is the "instrument green with a
    13	# stale question" class. This test asks the question the P1 actually named:
    14	#
    15	#   after `/night-mode on`, does `git status` in the adopter stay clean?
    16	#
    17	# PLAN-165 AC-1 words it as "git status stays empty"; the GA re-pass
    18	# (verdict-ga-1.txt:5) names the `--ceremony user` population as the one that
    19	# never got any protection, because a user install writes nothing outside
    20	# .claude/ and the root .gitignore blocks are all there was.
    21	#
    22	# WHY THE ARTIFACTS ARE SIMULATED, NOT ARMED
    23	# ------------------------------------------
    24	# This test CREATES the two files `/night-mode on` leaves behind rather than
    25	# invoking the toggle. That is not a sandbox shortcut — arming the autonomy
    26	# posture is a HUMAN action (PLAN-165 OQ1-redo, Owner-ratified 2026-08-03) and
    27	# the model rail is blocked from running `.claude/scripts/night-mode.py` at
    28	# all. A CI job arming a real posture would be the same violation. What is
    29	# under test is whether git ignores those two paths, and for that the file
    30	# CONTENT is irrelevant — only their names and locations matter, and those are
    31	# read from night-mode.py's own docstring/`_marker_path` (`.claude/state/
    32	# night-mode.json`, `.claude/settings.local.json`).
    33	#
    34	# SCENARIOS
    35	#   A  install @ $PIN (maintainer) -> upgrade (working tree)   [the upgrade route]
    36	#   B  install @ $PIN (user)       -> upgrade (working tree)   [the damaged population]
    37	#   C  install (working tree, user)                            [fresh user install]
    38	#
    39	# EVERY scenario carries its own POSITIVE CONTROL, inline and unconditional:
    40	# after asserting the tree is clean, the delivered ignores are removed and the
    41	# SAME assertion must go dirty. A control that can be skipped is a control that
    42	# silently stops firing, so there is no flag to turn this off.
    43	#
    44	# EXIT CODES
    45	#   0  every scenario clean, every control fired
    46	#   1  FAIL — a night-mode artifact was visible to git, or a control did not fire
    47	#   9  SCAFFOLD-ERROR — the fixture broke (pin unresolvable, install/upgrade
    48	#      returned non-zero, git missing). NEVER a verdict on the bug.
    49	#
    50	# bash-3.2 safe. Network-free (the pin must already be fetched — CI does that
    51	# in the "Fetch the parity pin tag" step). Writes only under mktemp -d.
    52	set -uo pipefail
    53	
    54	# HERMETIC IGNORE SOURCES — measured, not assumed.
    55	#
    56	# git consults THREE ignore sources outside the repo: the system config, the
    57	# user's global config, and `core.excludesFile` (commonly
    58	# ~/.config/git/ignore). On this maintainer's machine that file contains
    59	# `**/.claude/settings.local.json`, which means the overlay is invisible to git
    60	# whether or not the framework delivers anything. Left alone, that produces a
    61	# test whose control is half-blind locally and full-sighted on a clean CI
    62	# runner — "it passes on my machine" with the sign flipped, and the exact class
    63	# the probe-needs-a-neutral-user-layer lesson names.
    64	#
    65	# Neutralising them makes every scenario measure ONLY what install/upgrade put
    66	# in the target. GIT_CONFIG_GLOBAL/SYSTEM need git >= 2.32; each target also
    67	# sets core.excludesFile to an empty file so older git is covered too.
    68	export GIT_CONFIG_GLOBAL=/dev/null
    69	export GIT_CONFIG_SYSTEM=/dev/null
    70	
    71	SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    72	REPO_ROOT="$( cd "$SCRIPT_DIR/../.." && pwd )"
    73	
    74	# Single source of truth for the pin: ask the parity e2e rather than hardcoding
    75	# a second copy that drifts (the same rule smoke-install.yml follows).
    76	PIN="${CEO_PARITY_PIN:-}"
    77	if [ -z "$PIN" ]; then
    78	  PIN="$( bash "$SCRIPT_DIR/test-install-upgrade-parity-e2e.sh" --print-pin 2>/dev/null )"
    79	fi
    80	PROFILE="${CEO_PARITY_PROFILE:-core}"
    81	
    82	# The two paths `/night-mode on` writes. Derived from night-mode.py so a rename
    83	# there surfaces here as a scaffold error instead of a silently narrowed test.
    84	MARKER_REL=".claude/state/night-mode.json"
    85	OVERLAY_REL=".claude/settings.local.json"
    86	
    87	FAILED=0
    88	
    89	say()  { echo "$@"; }
    90	fail() { echo "  FAIL: $*" >&2; FAILED=1; }
    91	scaffold() {
    92	  echo "" >&2
    93	  echo "SCAFFOLD-ERROR: $*" >&2
    94	  echo "  (this is a broken fixture, NOT a verdict on the ignores)" >&2
    95	  exit 9
    96	}
    97	
    98	command -v git >/dev/null 2>&1 || scaffold "git not on PATH"
    99	[ -n "$PIN" ] || scaffold "could not resolve the historical pin (--print-pin returned empty)"
   100	git -C "$REPO_ROOT" rev-parse --verify "refs/tags/$PIN^{commit}" >/dev/null 2>&1 \
   101	  || scaffold "pin tag $PIN not present in this checkout (CI must fetch it first)"
   102	
   103	# Assert night-mode.py still names the paths this test asserts on. A rename
   104	# there would leave this test green while testing nothing.
   105	_NM="$REPO_ROOT/.claude/scripts/night-mode.py"
   106	if [ -f "$_NM" ]; then
   107	  grep -Fq 'night-mode.json' "$_NM" \
   108	    || scaffold "night-mode.py no longer mentions night-mode.json — re-derive MARKER_REL"
   109	  grep -Fq 'settings.local.json' "$_NM" \
   110	    || scaffold "night-mode.py no longer mentions settings.local.json — re-derive OVERLAY_REL"
   111	fi
   112	
   113	WORK="$( mktemp -d "${TMPDIR:-/tmp}/ceo-nightmode-ignore-XXXXXX" )" || scaffold "mktemp failed"
   114	cleanup() { [ -n "${WORK:-}" ] && rm -rf "$WORK"; }
   115	trap cleanup EXIT
   116	
   117	say "=============================================================="
   118	say " night-mode ignore EFFICACY  (PLAN-177 W1 / CF-9)"
   119	say "=============================================================="
   120	say "  repo            : $REPO_ROOT"
   121	say "  historical pin  : $PIN"
   122	say "  profile         : $PROFILE"
   123	say "  workdir         : $WORK"
   124	say "--------------------------------------------------------------"
   125	
   126	PIN_SRC="$WORK/src-$PIN"
   127	mkdir -p "$PIN_SRC"
   128	git -C "$REPO_ROOT" archive "$PIN" | tar -x -C "$PIN_SRC" \
   129	  || scaffold "git archive $PIN | tar -x failed"
   130	[ -f "$PIN_SRC/scripts/install.sh" ] || scaffold "$PIN archive has no scripts/install.sh"
   131	
   132	# --- helpers ---------------------------------------------------------------
   133	
   134	new_target() {  # $1 = name -> echoes the path
   135	  local t="$WORK/$1"
   136	  mkdir -p "$t"
   137	  : > "$WORK/empty-excludes"
   138	  ( cd "$t" \
   139	      && git init -q \
   140	      && git config user.email t@e \
   141	      && git config user.name t \
   142	      && git config core.excludesFile "$WORK/empty-excludes" ) \
   143	    || scaffold "git init failed in $t"
   144	  echo "$t"
   145	}
   146	
   147	# Fail loudly if any ignore source outside the target survives the
   148	# neutralisation above: a leftover rule would silently weaken every control.
   149	assert_no_external_ignores() {  # $1 = target
   150	  local src
   151	  for src in "$MARKER_REL" "$OVERLAY_REL"; do
   152	    local probe
   153	    probe="$( cd "$1" && git check-ignore -v --no-index "$src" 2>/dev/null )" || true
   154	    case "$probe" in
   155	      ""|.gitignore:*|.claude/.gitignore:*) : ;;
   156	      *) scaffold "an ignore source OUTSIDE the target still matches $src: $probe" ;;
   157	    esac
   158	  done
   159	}
   160	
   161	do_install() {  # $1 = source dir, $2 = target, $3 = ceremony
   162	  CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   163	    bash "$1/scripts/install.sh" "$2" --ceremony "$3" --profile "$PROFILE" \
   164	    > "$2.install.log" 2>&1 \
   165	    || scaffold "install.sh ($3, source=$1) exited non-zero — see $2.install.log"
   166	}
   167	
   168	do_upgrade() {  # $1 = target
   169	  CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   170	    bash "$REPO_ROOT/scripts/upgrade.sh" "$1" --profile "$PROFILE" \
   171	    > "$1.upgrade.log" 2>&1 \
   172	    || scaffold "upgrade.sh exited non-zero — see $1.upgrade.log"
   173	}
   174	
   175	arm_night_mode_artifacts() {  # $1 = target — simulate, never arm (see header)
   176	  mkdir -p "$1/.claude/state"
   177	  printf '%s\n' '{"armed": true, "plan": "PLAN-177 test fixture"}' > "$1/$MARKER_REL"
   178	  printf '%s\n' '{"permissions": {"defaultMode": "acceptEdits"}}' > "$1/$OVERLAY_REL"
   179	}
   180	
   181	# Lines git reports for the two artifacts.
   182	#
   183	# `-uall` is LOAD-BEARING, not a flourish. Plain `git status --porcelain` in a
   184	# repo where nothing is committed collapses the whole tree to a single
   185	# `?? .claude/` line, so a matcher looking for `.claude/state/...` finds
   186	# nothing and reports "clean" no matter what the ignores do. That vacuous shape
   187	# is exactly what this test's own positive control caught on its first run, and
   188	# it is why the scenarios commit a baseline first: a real adopter has the
   189	# framework committed before ever running `/night-mode on`.
   190	leaked() {  # $1 = target
   191	  ( cd "$1" && git status --porcelain -uall 2>/dev/null ) \
   192	    | grep -E "(\.claude/state/|\.claude/settings\.local\.json)" || true
   193	}
   194	
   195	# WHICH rule does the ignoring. `git status` alone cannot tell "ignored by the
   196	# file we delivered" from "ignored by something else the adopter already had",
   197	# and only the former is evidence for this cure. `git check-ignore -v` prints
   198	# `<source>:<line>:<pattern>\t<path>`, so the source file is checkable.
   199	ignoring_rule() {  # $1 = target, $2 = relpath
   200	  ( cd "$1" && git check-ignore -v "$2" 2>/dev/null ) || true
   201	}
   202	
   203	strip_delivered_ignores() {  # $1 = target — the positive control's mutation
   204	  rm -f "$1/.claude/.gitignore"
   205	  if [ -f "$1/.gitignore" ]; then
   206	    grep -v -x -e '.claude/state/' -e '.claude/settings.local.json' \
   207	      "$1/.gitignore" > "$1/.gitignore.stripped" 2>/dev/null || true
   208	    mv "$1/.gitignore.stripped" "$1/.gitignore"
   209	  fi
   210	}
   211	
   212	commit_baseline() {  # $1 = target — what a real adopter does after installing
   213	  ( cd "$1" && git add -A && git commit -q -m "install framework" ) \
   214	    || scaffold "baseline commit failed in $1"
   215	  # The install itself must not have staged posture state into that commit.
   216	  local tracked
   217	  tracked="$( cd "$1" && git ls-files | grep -E "(\.claude/state/|\.claude/settings\.local\.json)" || true )"
   218	  [ -z "$tracked" ] && return 0
   219	  fail "baseline commit TRACKS posture state (it should be ignored):"
   220	  echo "$tracked" | sed 's/^/        /' >&2
   221	}
   222	
   223	check_scenario() {  # $1 = label, $2 = target
   224	  local label="$1" t="$2" out n rule_m rule_o
   225	  assert_no_external_ignores "$t"
   226	  commit_baseline "$t"
   227	  arm_night_mode_artifacts "$t"
   228	
   229	  # Sanity: the artifacts really are on disk. Without this the "clean" verdict
   230	  # could just mean nothing was ever created.
   231	  [ -f "$t/$MARKER_REL" ]  || scaffold "$label: fixture did not create $MARKER_REL"
   232	  [ -f "$t/$OVERLAY_REL" ] || scaffold "$label: fixture did not create $OVERLAY_REL"
   233	
   234	  out="$( leaked "$t" )"
   235	  if [ -n "$out" ]; then
   236	    fail "$label: night-mode artifacts are VISIBLE to git:"
   237	    echo "$out" | sed 's/^/        /' >&2
   238	  else
   239	    say "  $label: clean — git -uall sees no night-mode artifacts"
   240	  fi
   241	
   242	  # Attribution: a framework-delivered .gitignore must be the rule doing it.
   243	  rule_m="$( ignoring_rule "$t" "$MARKER_REL" )"
   244	  rule_o="$( ignoring_rule "$t" "$OVERLAY_REL" )"
   245	  for _r in "$rule_m" "$rule_o"; do
   246	    case "$_r" in
   247	      .claude/.gitignore:*|.gitignore:*) : ;;
   248	      "") fail "$label: no ignore rule matches one of the artifacts: '$_r'" ;;
   249	      *)  fail "$label: ignored by an UNEXPECTED source (not a framework-delivered .gitignore): $_r" ;;
   250	    esac
   251	  done
   252	  [ -n "$rule_m" ] && say "  $label: rule -> ${rule_m%%	*}"
   253	
   254	  # --- inline positive control ---------------------------------------------
   255	  strip_delivered_ignores "$t"
   256	  out="$( leaked "$t" )"
   257	  n="$( printf '%s' "$out" | grep -c . || true )"
   258	  # BOTH artifacts must surface. "At least one" would pass while some other
   259	  # ignore source still hid the other one -- which is exactly what happened on
   260	  # the first run of this test, before the external sources were neutralised.
   261	  if [ "$n" -ne 2 ]; then
   262	    fail "$label: CONTROL FIRED PARTIALLY OR NOT AT ALL — after removing the"
   263	    fail "       delivered ignores git should report BOTH artifacts, got $n:"
   264	    [ -n "$out" ] && echo "$out" | sed 's/^/        /' >&2
   265	    fail "       (something ELSE is hiding a path, or the matcher is blind)"
   266	  else
   267	    say "  $label: control fired — without the ignores git reports both artifacts"
   268	  fi
   269	}
   270	
   271	# Count the posture entries in the ROOT .gitignore.
   272	#
   273	# WHY THIS EXISTS SEPARATELY from the git-status assertion: `.claude/.gitignore`
   274	# alone is enough to make every scenario below report "clean", so an upgrade
   275	# whose ROOT delivery silently did nothing would still pass. `git check-ignore`
   276	# reports only the WINNING rule, and that is the .claude one. So the root block
   277	# is measured directly, and BEFORE/AFTER — which also pins the fixture: the pin
   278	# must still reproduce the gap, or the whole scenario has stopped testing it.
   279	root_posture_count() {  # $1 = target -> number of the two posture entries present
   280	  # `grep -c` PRINTS 0 and EXITS 1 when nothing matches, so the obvious
   281	  # `grep -c ... || echo 0` emits TWO lines ("0\n0") and every arithmetic test
   282	  # downstream dies with "integer expression expected". Capture first, then
   283	  # default — verified by the run that produced exactly that scaffold error.
   284	  local n
   285	  [ -f "$1/.gitignore" ] || { echo 0; return 0; }
   286	  n="$( grep -c -x -e '.claude/state/' -e '.claude/settings.local.json' "$1/.gitignore" 2>/dev/null )" || n=0
   287	  [ -n "$n" ] || n=0
   288	  echo "$n"
   289	}
   290	
   291	# --- A: pinned install (maintainer) -> upgrade -------------------------------
   292	say ""
   293	say "--> [A] install @ $PIN (maintainer) -> upgrade (working tree)"
   294	TA="$( new_target A-pin-maintainer )"
   295	do_install "$PIN_SRC" "$TA" maintainer
   296	[ -f "$TA/.claude/.gitignore" ] && scaffold "[A] the $PIN install already ships .claude/.gitignore — the fixture no longer reproduces the gap"
   297	_A_BEFORE="$( root_posture_count "$TA" )"
   298	[ "$_A_BEFORE" -eq 0 ] || scaffold "[A] the $PIN install already writes $_A_BEFORE posture entr(y|ies) into the root .gitignore — the fixture no longer reproduces the P1-1 gap"
   299	do_upgrade "$TA"
   300	_A_AFTER="$( root_posture_count "$TA" )"
   301	if [ "$_A_AFTER" -eq 2 ]; then
   302	  say "  [A] root .gitignore: posture entries 0 -> 2 across the upgrade — the P1-1 delivery"
   303	else
   304	  fail "[A] the upgrade did NOT deliver the root posture block (entries: $_A_BEFORE -> $_A_AFTER, expected 2)"
   305	fi
   306	check_scenario "[A] upgrade/maintainer" "$TA"
   307	
   308	# --- B: pinned install (user) -> upgrade -------------------------------------
   309	say ""
   310	say "--> [B] install @ $PIN (user) -> upgrade (working tree)"
   311	TB="$( new_target B-pin-user )"
   312	do_install "$PIN_SRC" "$TB" user
   313	do_upgrade "$TB"
   314	# The mirror assertion: in `user` ceremony NEITHER route touches the root, so
   315	# the count must stay 0. A cure that delivered here would break the WS4
   316	# invariant install.sh has always honoured — and the parity gate would only
   317	# see it as a divergence, never as a rule violation.
   318	_B_ROOT="$( root_posture_count "$TB" )"
   319	if [ "$_B_ROOT" -eq 0 ]; then
   320	  say "  [B] root .gitignore: still 0 posture entries — user ceremony skipped on BOTH routes"
   321	else
   322	  fail "[B] the upgrade wrote $_B_ROOT posture entr(y|ies) into the root .gitignore under --ceremony user"
   323	fi
   324	check_scenario "[B] upgrade/user" "$TB"
   325	
   326	# --- C: fresh user install ---------------------------------------------------
   327	say ""
   328	say "--> [C] install (working tree) --ceremony user"
   329	TC="$( new_target C-fresh-user )"
   330	do_install "$REPO_ROOT" "$TC" user
   331	# WS4 belt-and-braces: a user install must still write nothing outside .claude/
   332	_extra=""
   333	for _e in "$TC"/* "$TC"/.[!.]* "$TC"/..?*; do
   334	  [ -e "$_e" ] || continue
   335	  _b="$( basename "$_e" )"
   336	  case "$_b" in .claude|.git) continue ;; esac
   337	  _extra="$_extra $_b"
   338	done
   339	[ -n "$_extra" ] && fail "[C] --ceremony user wrote outside .claude/:$_extra"
   340	check_scenario "[C] fresh/user" "$TC"
   341	
   342	say ""
   343	say "--------------------------------------------------------------"
   344	if [ "$FAILED" -eq 0 ]; then
   345	  say "RESULT: PASS — after a simulated \`/night-mode on\`, git reports no"
   346	  say "        posture artifacts in any route or ceremony, and every"
   347	  say "        scenario's control fired."
   348	  say "=============================================================="
   349	  exit 0
   350	fi
   351	say "RESULT: FAIL (exit 1) — see the FAIL lines above."
   352	say "=============================================================="
   353	exit 1
