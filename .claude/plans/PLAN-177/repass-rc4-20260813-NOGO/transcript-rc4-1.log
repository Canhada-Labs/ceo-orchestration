   311	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   312	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   313	    verdict_abs = os.path.join(repo, verdict_rel)
   314	    if not os.path.isfile(verdict_abs):
