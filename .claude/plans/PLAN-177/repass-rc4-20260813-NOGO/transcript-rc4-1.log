  1988	def _write_live_shaped_verdict(
  1989	    path: Path, tag: str, decisions: Sequence[str], parent: str
  1990	) -> None:
  1991	    """A verdict envelope the LIVE governance files accept end to end.
  1992	
  1993	    `decisions` is a SEQUENCE so the fixture can express the three shapes the
  1994	    gate must separate: zero lines (absent), one line (normal), two lines (the
  1995	    last-wins override). Values are written verbatim -- a malformed or unknown
  1996	    token reaches the validator exactly as authored.
  1997	    """
  1998	    tv = _live_tool_versions()
  1999	    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
  2000	    lines = ["# Pair-Rail Verdict -- fixture", "", "```yaml"]
  2001	    lines += ["verdict: %s" % d for d in decisions]
  2002	    lines += [
  2003	        "generated_at: %sZ" % now,
  2004	        "ttl_hours: 24",
  2005	        "parent_sha: %s" % parent,
  2006	        "release_tag: %s" % tag,
  2007	        "inputs_hash: %s" % _live_inputs_hash(),
  2008	        "tool_versions:",
  2009	        "  codex_cli: %s" % tv["codex_cli"],
  2010	        "  codex_target_triple: %s" % tv["codex_target_triple"],
  2011	        "  codex_payload_sha256: %s" % tv["codex_payload_sha256"],
  2012	        "gpg_signature: -----BEGIN PGP SIGNATURE----- fixture-not-a-signature",
  2013	        "```",
  2014	        "",
  2015	    ]
  2016	    path.write_text("\n".join(lines), encoding="utf-8")
