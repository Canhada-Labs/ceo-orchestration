  2032	    verdict_file = tmp_path / "pair-rail-verdict-fixture.md"
  2033	    _write_live_shaped_verdict(verdict_file, tag, decisions, parent)
  2034	    argv = [
  2035	        sys.executable, str(VALIDATOR_SRC),
  2036	        "--verdict-file", str(verdict_file),
  2037	        "--parent-sha", parent if bind_parent else "",
  2038	        "--release-tag", tag,
  2039	        "--max-age-hours", "24",
  2040	        "--recompute-inputs-hash",
  2041	        "--codex-cli-pin-file", ".claude/governance/codex-cli-pin.txt",
  2042	        "--codex-cli-binary-sha256-file",
  2043	        ".claude/governance/codex-cli-binary-sha256.txt",
  2044	        "--codex-pin-manifest-file",
  2045	        ".claude/governance/codex-cli-pin-manifest.json",
  2046	        "--inputs-hash-paths-file",
  2047	        ".claude/governance/pair-rail-inputs-hash-manifest.txt",
  2048	    ]
  2049	    return run(argv, REPO_ROOT, env)
