   196	def _parse_verdict(text: str) -> Dict[str, object]:
   197	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   198	
   199	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   200	    of `  - item` list entries, and ignores everything else. Anything it cannot
   201	    read is absent, and every consumer below treats absent as fail-closed.
   202	
   203	    Parity with the step-15 reader (`.github/scripts/
   204	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   205	    scope: block selection (the regex below is the validator's own — the
   206	    first ```yaml fence, not the first fence of any language) and inline
   207	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   208	    parse_verdict_file reads key:value and sub-dicts and would drop
   209	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   210	    ONE shared reader (this file is the declared reference), never grow a
   211	    third parser of the same signed file.
   212	    """
   213	    fields: Dict[str, object] = {}
   214	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   215	    if block is None:
   216	        # No yaml block -> no fields -> every consumer below fails closed.
   217	        return fields
   218	    cur_list: Optional[str] = None
   219	    for raw in block.group(1).splitlines():
   220	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   221	        if not line.strip():
   222	            continue
   223	        if line.startswith(("  - ", "- ")) and cur_list:
   224	            item = line.split("-", 1)[1].strip()
   225	            if item:
   226	                fields[cur_list].append(item)  # type: ignore[union-attr]
   227	            continue
   228	        m = re.match(r"\A([A-Za-z0-9_]+):\s*(.*)\Z", line)
   229	        if not m:
   230	            continue
   231	        key, val = m.group(1), m.group(2).strip()
   232	        if val == "":
   233	            fields[key] = []
   234	            cur_list = key
   235	        else:
   236	            fields[key] = val
   237	            cur_list = None
   238	    return fields
   239	
   240	
   241	def _count_top_level_key(text: str, key: str) -> int:
   242	    """How many times `key:` is declared at the top level of the block.
   243	
   244	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   245	    step-15 reader: a second `verdict:` silently overrides the first, so
   246	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   247	    block selection and same comment rule as the reader, or the count
   248	    would be about a different text than the parse.
   249	    """
   250	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   251	    if block is None:
   252	        return 0
   253	    seen = 0
   254	    for raw in block.group(1).splitlines():
   255	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   256	        if not line.strip() or line[0] in (" ", "\t"):
   257	            continue
   258	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   259	        if m and m.group(1) == key:
   260	            seen += 1
   261	    return seen
   262	
   263	
   264	def _sha256(path: str) -> str:
   265	    h = hashlib.sha256()
   266	    with open(path, "rb") as fh:
   267	        for chunk in iter(lambda: fh.read(65536), b""):
   268	            h.update(chunk)
   269	    return h.hexdigest()
   270	
   271	
   272	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   273	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   274	    entries: List[Tuple[str, str]] = []
   275	    with open(path, encoding="utf-8") as fh:
   276	        for line in fh:
   277	            line = line.rstrip("\n")
   278	            if not line.strip():
   279	                continue
   280	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   281	            if not m:
   282	                raise ValueError("unparsable manifest line: %r" % line)
   283	            entries.append((m.group(1), m.group(2)))
   284	    return entries
   285	
   286	
   287	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   288	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   289	    directory = os.path.dirname(manifest) or "."
   290	    name = os.path.basename(manifest)
   291	    try:
   292	        proc = subprocess.run(
   293	            ["shasum", "-a", "256", "-c", name],
   294	            cwd=directory,
   295	            stdout=subprocess.PIPE,
   296	            stderr=subprocess.STDOUT,
   297	            universal_newlines=True,
   298	        )
   299	        return proc.returncode == 0, proc.stdout.strip()
   300	    except (OSError, FileNotFoundError):
   301	        bad: List[str] = []
   302	        for want, rel in _read_manifest(manifest):
   303	            full = os.path.join(directory, rel)
   304	            if not os.path.isfile(full) or _sha256(full) != want:
   305	                bad.append(rel)
   306	        if bad:
   307	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   308	        return True, "hashlib fallback: all entries match"
