         adopter_model=$(grep -E "^model:" "$DST" | head -1 || true)
         framework_model=$(grep -E "^model:" "$SRC" | head -1 || true)
         cp "$DST" "$BAK_DIR/agents-$name.bak" 2>/dev/null || true
       fi
