     1	#!/bin/bash
     2	# OWNER-GA-CUT.sh - promocao v1.3.0-rc.3 -> GA v1.3.0 em UM comando.
     3	# (o freeze do main comeca no CORTE DA rc.3 - rail rc.3 r5 P2)
     4	#
     5	#   bash .claude/plans/PLAN-166/OWNER-GA-CUT.sh
     6	#
     7	# Pre-requisito: rc.3 cortada ha >= 24h (hold ADR-103). O script:
     8	# (rc.3 = rc.2 + curas dos 8 achados do re-pass NO-GO de 10/08; ver
     9	#  OWNER-RC3-CUT.sh e repass-ga-rc2-NOGO/TRIAGE-ga-repass.md)
    10	#   1. valida janela do hold + freeze (origin/main == commit da rc.3)
    11	#   2. roda o re-pass do hold (codex, ~10-15 min) se ainda nao rodou;
    12	#      exige VERDICT: GO ou GO-WITH-CONDITIONS (NO-GO => aborta)
    13	#   3. commit 1: evidencia do re-pass (repass-ga/**)
    14	#   4. gera verdict-fields GA e voce assina (pinentry 1)
    15	#   5. monta o verdito GA, commit 2, guard local, push, espera CI
    16	#   6. preflight --stable + bump --stable (no-op esperado) +
    17	#      tag v1.3.0 assinada (pinentry 2)
    18	#   7. push da tag (confirmacao SIM) + espera release.yml + npm:
    19	#      aprovacao production-npm e SUA no browser (o script te da o link)
    20	#   8. GitHub Release (SEM pre-release) + npm view
    21	# Depois do GA: assinar W3 e rodar OWNER-W3-LAND.sh (curas V1-V5).
    22	set -euo pipefail
    23	
    24	REPO="$(git rev-parse --show-toplevel)"; cd "$REPO"
    25	RC_TAG="v1.3.0-rc.3"
    26	TAG="v1.3.0"
    27	KEY="CFCFACF00335DC74"
    28	P166=".claude/plans/PLAN-166"
    29	GA_DIR="$P166/repass-ga"
    30	VF="$P166/verdict-fields-v1.3.0.md"
    31	VD=".claude/governance/pair-rail-verdict-v1.3.0.md"
