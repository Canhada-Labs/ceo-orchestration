  2358	def _write_live_shaped_verdict(
  2359	    path: Path, tag: str, decisions: Sequence[str], parent: str
  2360	) -> None:
  2361	    """A verdict envelope the LIVE governance files accept end to end.
  2362	
  2363	    `decisions` is a SEQUENCE so the fixture can express the three shapes the
  2364	    gate must separate: zero lines (absent), one line (normal), two lines (the
  2365	    last-wins override). Values are written verbatim -- a malformed or unknown
  2366	    token reaches the validator exactly as authored.
  2367	    """
  2368	    tv = _live_tool_versions()
  2369	    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
  2370	    lines = ["# Pair-Rail Verdict -- fixture", "", "```yaml"]
  2371	    lines += [_decision_line(d).rstrip("\n") for d in decisions]
  2372	    lines += [
  2373	        "generated_at: %sZ" % now,
  2374	        "ttl_hours: 24",
  2375	        "parent_sha: %s" % parent,
  2376	        "release_tag: %s" % tag,
  2377	        "inputs_hash: %s" % _live_inputs_hash(),
  2378	        "tool_versions:",
  2379	        "  codex_cli: %s" % tv["codex_cli"],
  2380	        "  codex_target_triple: %s" % tv["codex_target_triple"],
  2381	        "  codex_payload_sha256: %s" % tv["codex_payload_sha256"],
  2382	        "gpg_signature: -----BEGIN PGP SIGNATURE----- fixture-not-a-signature",
  2383	        "```",
  2384	        "",
  2385	    ]
  2386	    path.write_text("\n".join(lines), encoding="utf-8")
