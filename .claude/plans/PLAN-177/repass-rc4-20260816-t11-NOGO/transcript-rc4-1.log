   737	def make_repass(repo: Path, slug: str, artifacts: Dict[str, str]) -> Dict[str, str]:
   738	    directory = repo / ".claude/plans/PLAN-166" / slug
   739	    directory.mkdir(parents=True, exist_ok=True)
   740	    lines: List[str] = []
   741	    for name, body in sorted(artifacts.items()):
