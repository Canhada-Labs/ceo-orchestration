  1597	def test_integrity_contract_rows_name_a_live_step():
  1598	    """P1-3. The contract claimed a per-tarball SHA-256 manifest was
  1599	    "enforced today" and pointed at `validate.yml (to-add)`: a guarantee whose
  1600	    alleged gate could not fail because it did not exist. A row now declares a
  1601	    Status from a closed set, and an `enforced` one must name a step that is
  1602	    really in the YAML."""
  1603	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1604	    rows = _contract_rows(doc)
  1605	    assert len(rows) >= 5, "Contract table parsed as %d rows" % len(rows)
  1606	
  1607	    pairs = _integrity_enforced_pairs(doc)
  1608	    assert len(pairs) >= _MIN_ENFORCED_PAIRS, (
  1609	        "only %d enforced (workflow, step) claims parsed — below the floor of "
  1610	        "%d. Either the table stopped documenting enforcement, or its format "
  1611	        "changed and this gate is now checking nothing."
  1612	        % (len(pairs), _MIN_ENFORCED_PAIRS)
  1613	    )
  1614	
  1615	    # (a) a renamed step must go red. The fixture is DERIVED from the parsed
  1616	    # table, never a hand-typed row literal: an anchor typed here stops
  1617	    # matching the day that row is edited, and the control dies quietly.
  1618	    step = pairs[0][2]
  1619	    renamed = doc.replace('step "%s"' % step, 'step "%s renamed"' % step, 1)
  1620	    assert renamed != doc, "rename fixture did not patch the doc"
  1621	    renamed_offenders = _integrity_contract_offenders(renamed, REPO_ROOT)
  1622	    assert any("renamed" in o for o in renamed_offenders), (
  1623	        "control did not flag a row naming a nonexistent step: %s"
  1624	        % renamed_offenders
  1625	    )
  1626	
  1627	    # (b) a table with NO parseable step claim must go red on the COUNT, not
  1628	    # report zero offenders. That is the vacuity failure itself.
  1629	    stripped = doc.replace('step "', "step ")
  1630	    assert len(_integrity_enforced_pairs(stripped)) < _MIN_ENFORCED_PAIRS, (
  1631	        "a table with no parseable step claim still met the floor — the count "
  1632	        "check cannot detect vacuity"
  1633	    )
  1634	
  1635	    # (c) unknown Status vocabulary must go red, not be waved through.
  1636	    unknown = doc.replace("| enforced |", "| mostly enforced |", 1)
  1637	    assert unknown != doc, "status fixture did not patch the doc"
  1638	    assert any(
  1639	        "outside the closed set" in o
  1640	        for o in _integrity_contract_offenders(unknown, REPO_ROOT)
  1641	    ), "an unknown Status was accepted"
  1642	
  1643	    offenders = _integrity_contract_offenders(doc, REPO_ROOT)
  1644	    assert not offenders, "npm/INTEGRITY.md contract row without a live step:\n%s" % (
  1645	        "\n".join(offenders)
  1646	    )
