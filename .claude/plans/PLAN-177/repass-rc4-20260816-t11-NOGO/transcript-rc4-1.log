  2519	
  2520	# PLAN-177 t2 (re-pass rc.4 P1-a) -- the GRAMMAR the two rails share.
  2521	#
  2522	# `verdict : NO-GO` is valid YAML and last-wins under a real parser. The
  2523	# server validator strips the key, so it counted TWO declarations; the local
  2524	# tag guard's regex required the colon immediately after the name, so it
  2525	# counted ONE and parsed GO -- and the local guard is the rail with no escape
  2526	# hatch. The first round of controls could not see this: every fixture line
  2527	# was built as `"verdict: %s"`, which can only produce canonical keys.
  2528	#
  2529	# Cured semantics (identical in both files): non-canonical top-level syntax
  2530	# is REFUSED. So the duplicate variants are red for the SHAPE, and the single
  2531	# non-canonical key is red too -- an authorizing decision must be spelled the
  2532	# one way the template spells it.
  2533	_NONCANONICAL_DIAGNOSTIC = "non-canonical top-level key syntax"
  2534	_NONCANONICAL_DECISIONS = [
  2535	    [("verdict ", "NO-GO"), "GO"],
  2536	    [("verdict\t", "NO-GO"), "GO"],
  2537	    [("verdict ", "GO")],
  2538	    [("verdict\t", "GO")],
  2539	    # Re-pass rc.4 t2 P1: an INDENTED CONTINUATION line after the scalar —
  2540	    # valid YAML resolving to the non-authorizing scalar "GO NO-GO", which
  2541	    # both minimal readers previously read as `GO` (indented lines were
  2542	    # unconditionally skipped). Written verbatim by _decision_line.
  2543	    ["GO\n  NO-GO"],
  2544	]
  2545	_NONCANONICAL_IDS = [
  2546	    "space-before-colon-duplicate", "tab-before-colon-duplicate",
  2547	    "space-before-colon-alone", "tab-before-colon-alone",
  2548	    "indented-continuation",
  2549	]
  2550	
  2551	
  2552	@pytest.mark.parametrize("bind_parent", [True, False], ids=["bound", "unbound"])
  2553	@pytest.mark.parametrize("decisions", _NONCANONICAL_DECISIONS, ids=_NONCANONICAL_IDS)
  2554	def test_ci_validator_refuses_a_noncanonical_decision_key(
  2555	    tmp_path, ci_env, decisions, bind_parent
  2556	):
  2557	    proc = _run_ci_validator(tmp_path, ci_env, decisions, bind_parent)
  2558	    assert proc.returncode == validator.EXIT_VERDICT_INVALID, (
  2559	        "non-canonical key %r returned %d -- the two rails parse this file "
  2560	        "with different grammars, so any shape they can read differently "
  2561	        "must be refused, not guessed.\n%s%s"
  2562	        % (decisions, proc.returncode, proc.stdout, proc.stderr)
  2563	    )
  2564	    assert _NONCANONICAL_DIAGNOSTIC in proc.stderr, (
  2565	        "red for the wrong reason -- the refusal must name the SHAPE: %s"
  2566	        % proc.stderr
  2567	    )
  2568	    assert proc.returncode != validator.EXIT_INFRA_ERROR
  2569	    assert "Traceback" not in proc.stderr, proc.stderr
  2570	    assert "OK: verdict" not in proc.stdout
