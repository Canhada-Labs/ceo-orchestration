   439	# ---------------------------------------------------------------------------
   440	# Bump.
   441	#
   442	# The site table lives in `_release_bump_sites.py` and NOWHERE else: this
   443	# driver invokes it, and derives the dry-run restore list from it.
   444	#
   445	# The version written is always the BARE semver ($TARGET_BASE), never
   446	# X.Y.Z-rc.N. Two independent reasons: (a) precedent — every previous RC
   447	# carries the bare version in VERSION, the RC lives only in the tag name;
   448	# (b) every gate regex matches `\d+\.\d+\.\d+` only, so an -rc.N string would
   449	# match NOTHING and the gate would pass VACUOUSLY — silently stopping the
   450	# drift check exactly when it matters most.
   451	#
   452	# IDEMPOTENCE (F2, the v1.3.0-rc.1 re-pass). A bump on a tree that is already
   453	# at the target must write NOTHING — not one byte, not one index entry. It
   454	# used to re-date four `last-reviewed:` stamps with today date, which on D+1
   455	# of the ADR-103 hold produced a dirty tree, then a commit made AFTER the
   456	# preflight proved CI green, which `tag()` then signed. That commit was also
   457	# invisible to the pair-rail step 15 (none of the four files is in
   458	# `pair-rail-inputs-hash-manifest.txt`). Two independent defenses now:
   459	#   1. the same-tree predicate below (four oracles) short-circuits the phase;
   460	#   2. the writer skips each stamp line whose version is already the target.
   461	# ---------------------------------------------------------------------------
   462	_oracle() {
   463	  label="$1"; shift
   464	  if "$@" >/dev/null 2>&1; then
   465	    printf '  --   oracle %s: PASS  (%s)\n' "$label" "$*"
   466	    return 0
   467	  fi
   468	  printf '  --   oracle %s: RED   (%s)\n' "$label" "$*"
   469	  return 1
   470	}
   471	
   472	# All four are required. The fourth is not redundant: it is the ONLY watcher
   473	# of the SBOM/SECURITY/VERSIONING stamps, which are outside the VERSION_SITES
   474	# of verify-counts. Without it an external no-op would block the in-loop
   475	# self-heal from ever running over a stale stamp. Freezing the DATE is safe
   476	# because the freshness gate decides on the stamp VERSION, not its date.
   477	tree_already_at_target() {
   478	  cur_version="$(tr -d ' \n' < VERSION)"
   479	  printf '  --   oracle 1/4: VERSION=%s, target=%s\n' "$cur_version" "$TARGET_BASE"
   480	  [ "$cur_version" = "$TARGET_BASE" ] || return 1
   481	  _oracle "2/4" bash .claude/scripts/local/verify-counts.sh --quiet --no-tests || return 1
   482	  _oracle "3/4" python3 scripts/build-plugin.py --check || return 1
   483	  _oracle "4/4" python3 .claude/scripts/check-canonical-doc-freshness.py || return 1
   484	  return 0
   485	}
   486	
   487	bump() {
   488	  hdr "bump version sites to $TARGET_BASE"
   489	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to bump"
   490	
   491	  if [ "$RESTAMP" -eq 1 ] && [ "$NPM_README_REVIEWED" -eq 0 ]; then
   492	    die "--restamp moves every last-reviewed stamp — it REQUIRES --npm-readme-reviewed, otherwise it is exactly the tripwire bypass the stamp exists to prevent"
   493	  fi
   494	
   495	  if [ "$RESTAMP" -eq 1 ]; then
   496	    hdr "restamp requested — no-op fast path DISABLED by design"
   497	    note "in the normal re-review case (same version, four clean oracles) the"
   498	    note "predicate would return BEFORE any substitution and --restamp would"
   499	    note "be dead letter. It is skipped so a real re-review can be recorded."
   500	  else
   501	    hdr "same-tree predicate — four oracles, ALL required"
   502	    if tree_already_at_target; then
   503	      ok "no-op: tree is already at $TARGET_BASE and all four oracles are clean"
   504	      note "NOTHING was written: not a file, not an index entry. The"
   505	      note "post-condition of this phase (tree at $TARGET_BASE, gates green) is"
   506	      note "already satisfied, so a no-op bump is SUCCESS, not failure."
   507	      note "For a genuine re-review of the docs: --restamp --npm-readme-reviewed"
   508	      hint_next_phase
   509	      return 0
   510	    fi
   511	    note "at least one oracle is unsatisfied — running the bump"
   512	  fi
   513	
   514	  # The npm/README.md stamp is a DELIBERATE release tripwire: its date+version
   515	  # line asserts the npm-facing copy was re-read for this release. Re-stamping
   516	  # it silently would defeat the whole purpose of the gate, so it takes an
   517	  # explicit acknowledgement. Checked AFTER the no-op predicate on purpose: a
   518	  # run that writes nothing asserts nothing, and demanding the flag there would
   519	  # be asking the Owner to certify a review that is not happening.
   520	  if [ "$NPM_README_REVIEWED" -eq 0 ]; then
   521	    cat >&2 <<'EOF'
   522	FAIL: npm/README.md carries a "last-reviewed: <date> v<version>" stamp, and
   523	      verify-counts treats it as a release tripwire — bumping it asserts that
   524	      the npm-facing README was actually re-read for this release.
   525	
   526	      Read npm/README.md, then re-run with --npm-readme-reviewed.
   527	EOF
   528	    exit 1
   529	  fi
   530	
   531	  [ "$DRY_RUN" -eq 1 ] && take_snapshot
   532	
   533	  if [ "$RESTAMP" -eq 1 ]; then
   534	    python3 "$BUMP_SITES" bump --target "$TARGET_BASE" --today "$TODAY" --restamp \
   535	      || die "version-site bump failed"
   536	  else
   537	    python3 "$BUMP_SITES" bump --target "$TARGET_BASE" --today "$TODAY" \
   538	      || die "version-site bump failed"
   539	  fi
   540	
   541	  # Plugin manifests (.claude-plugin/{plugin,marketplace}.json) are GENERATED
   542	  # from VERSION, never hand-patched. The release.yml gate "Assert plugin
   543	  # manifest versions match VERSION" enforces them — and verify-counts does
   544	  # NOT, which is exactly how the v1.2.0-rc.1 run went red: the manifests were
   545	  # version sites invisible to the local oracle.
   546	  python3 scripts/build-plugin.py --write-manifests >/dev/null 2>&1 \
   547	    || die "build-plugin.py --write-manifests failed"
   548	  python3 scripts/build-plugin.py --check >/dev/null 2>&1 \
   549	    || die "plugin manifests still out of sync with the generator"
   550	  ok "plugin manifests regenerated from VERSION (build-plugin.py)"
   551	
   552	  # verify-counts covers the doc/package sites; the release.yml gate family
   553	  # covers the plugin manifests; the freshness gate covers the review stamps
   554	  # outside both. NOT ONE of them is the full oracle — the union is. If a new
   555	  # site is added upstream, expect it to surface in one of the three, and
   556	  # mirror it into _release_bump_sites.py.
   557	  bash .claude/scripts/local/verify-counts.sh --quiet --no-tests >/dev/null 2>&1 \
   558	    || {
   559	      bash .claude/scripts/local/verify-counts.sh --json --no-tests 2>&1 \
   560	        | python3 -c 'import json,sys
