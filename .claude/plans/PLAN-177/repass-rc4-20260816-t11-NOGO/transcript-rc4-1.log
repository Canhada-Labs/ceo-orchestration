  2736	        false_closer, "verdict"
  2737	    ) == 2, "validator: false closer hid the later NO-GO"
  2738	    assert g_shape != [] or tag_guard._count_top_level_key(
  2739	        false_closer, "verdict"
  2740	    ) == 2, "tag guard: false closer hid the later NO-GO"
  2741	    assert validator.parse_verdict_text(false_closer).get("verdict") != "GO" \
  2742	        or validator.count_top_level_key(false_closer, "verdict") == 2
  2743	    assert v_shape == g_shape, "the two rails disagree on the false closer"
