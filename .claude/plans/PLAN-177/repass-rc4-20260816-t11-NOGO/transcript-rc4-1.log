  2249	# ===========================================================================
  2250	# PLAN-177 W0.1 (P1-4) -- the pair-rail DECISION gate
  2251	# ===========================================================================
  2252	# The re-pass of 2026-08-12 found that BOTH release rails read the verdict
  2253	# envelope for pinning, TTL, anchor and delta, and NEITHER read the decision:
  2254	# a cross-model NO-GO returned "OK: verdict ... valid" / exit 0 from the
  2255	# server-side validator, release-gate went green, and only the Owner running
  2256	# OWNER-GA-CUT.sh stood between a negative review and an irreversible publish.
  2257	#
  2258	# CF-3 asymmetry, restated here because it decides what each control PROVES:
  2259	# step 15 carries continue-on-error under CEO_PAIR_RAIL_VERDICT_OPTIONAL=1, so
  2260	# the validator control is a UNIT control over defence in depth; the control
  2261	# that stands for enforcement in every mode is the tag-guard one below.
  2262	_VALIDATOR_INPUTS_HASH_CACHE = {}
  2263	
  2264	# Anchors on the DIAGNOSTIC, not just the exit code: a gate that fires for the
  2265	# wrong reason is a dead probe wearing a green badge (S-lesson: a control that
  2266	# cannot fail proves nothing).
  2267	_ACCEPTED_SET_TEXT = "{GO, GO-WITH-CONDITIONS}"
  2268	_DECISION_REFUSED = "not in " + _ACCEPTED_SET_TEXT
  2269	_CI_DUPLICATE_DIAGNOSTIC = "verdict decision declared more than once"
  2270	_GUARD_DUPLICATE_DIAGNOSTIC = "declares the decision"
  2271	
  2272	# Value-shaped refusals. `GO | NO-GO | GO-WITH-CONDITIONS` is the LITERAL of
  2273	# pair-rail-verdict-template.md:13 -- an envelope copied from the template
  2274	# without filling the field in.
  2275	_REFUSED_DECISIONS = [
  2276	    ["NO-GO"],
  2277	    [],
  2278	    ["MAYBE"],
  2279	    [""],
  2280	    ["go"],
  2281	    ["no-go"],
  2282	    ["GO WITH CONDITIONS"],
  2283	    ["GO | NO-GO | GO-WITH-CONDITIONS"],
  2284	    # Re-pass rc.4 t3 P1: `#` WITHOUT preceding whitespace is NOT a YAML
  2285	    # comment — these are single unknown values, not GO + comment.
  2286	    ["GO#NO-GO"],
  2287	    ["GO-WITH-CONDITIONS#NO-GO"],
  2288	    # Re-pass rc.4 t5 P1: Unicode whitespace must stay attached to the
  2289	    # VALUE — `GO<U+00A0>` is not the exact authorizing token.
  2290	    ["GO\u00a0"],
  2291	    ["\u00a0GO"],
  2292	    ["GO-WITH-CONDITIONS\u00a0"],
  2293	]
  2294	_REFUSED_IDS = [
  2295	    "no-go", "absent", "unknown", "empty", "lowercase", "lower-no-go",
  2296	    "spaced", "template-literal",
  2297	    "hash-glued-no-go", "hash-glued-gwc",
  2298	    "trailing-nbsp", "leading-nbsp", "gwc-trailing-nbsp",
  2299	]
