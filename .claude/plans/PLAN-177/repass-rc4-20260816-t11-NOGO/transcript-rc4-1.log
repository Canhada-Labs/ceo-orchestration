  2507	@pytest.mark.parametrize("bind_parent", [True, False], ids=["bound", "unbound"])
  2508	def test_ci_validator_stops_a_duplicated_decision_key(tmp_path, ci_env, bind_parent):
  2509	    """Both readers are last-wins: NO-GO followed by GO parses as GO. An
  2510	    envelope with two decision lines is not a verdict, it is an override."""
  2511	    proc = _run_ci_validator(tmp_path, ci_env, ["NO-GO", "GO"], bind_parent)
  2512	    assert proc.returncode == validator.EXIT_VERDICT_INVALID, (
  2513	        "a duplicated verdict key was accepted -- last-wins parsing turned a "
  2514	        "NO-GO into a GO.\n%s%s" % (proc.stdout, proc.stderr)
  2515	    )
  2516	    assert _CI_DUPLICATE_DIAGNOSTIC in proc.stderr, proc.stderr
  2517	    assert "OK: verdict" not in proc.stdout
