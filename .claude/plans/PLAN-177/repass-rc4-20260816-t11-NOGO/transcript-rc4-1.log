  2338	def _live_tool_versions() -> Dict[str, str]:
  2339	    """codex pins read from the LIVE governance files, not from memory.
  2340	
  2341	    Both pins drift by ceremony (the semver range has been widened four times);
  2342	    deriving them keeps this control testing the decision instead of decaying
  2343	    into a pin-drift alarm.
  2344	    """
  2345	    min_v, _max_v = validator.parse_pin_range(GOVERNANCE / "codex-cli-pin.txt")
  2346	    assert min_v, "fixture broke: no semver range in codex-cli-pin.txt"
  2347	    manifest = json.loads(
  2348	        (GOVERNANCE / "codex-cli-pin-manifest.json").read_text(encoding="utf-8")
  2349	    )
  2350	    triple = sorted(manifest["payloads"])[0]
  2351	    return {
  2352	        "codex_cli": min_v,
  2353	        "codex_target_triple": triple,
  2354	        "codex_payload_sha256": manifest["payloads"][triple]["sha256"],
  2355	    }
