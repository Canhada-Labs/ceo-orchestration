  2389	def _run_ci_validator(tmp_path, env, decisions: Sequence[str], bind_parent: bool):
  2390	    """Run the server-side validator with the LITERAL step-15 argv.
  2391	
  2392	    Source of the argv: .github/workflows/release.yml, job release-gate.
  2393	
  2394	    bind_parent=False is the --parent-sha "" shape of
  2395	    CEO_PAIR_RAIL_VERDICT_OPTIONAL=1. In THAT mode the step also carries
  2396	    continue-on-error, so this variant is a UNIT test of the validator, not a
  2397	    claim about the pipeline: what blocks a release in transition mode is
  2398	    _release_tag_guard.py delta (see the tag-guard controls below).
