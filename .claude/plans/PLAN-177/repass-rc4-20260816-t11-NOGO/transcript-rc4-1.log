   136	usage() {
   137	  cat <<USAGE
   138	release.sh — operator release driver (target base version: $TARGET_BASE)
   139	
   140	  bash $0 preflight [--rc N | --stable]
   141	  bash $0 bump      [--rc N | --stable] --npm-readme-reviewed [--dry-run]
   142	  bash $0 tag       [--rc N | --stable] [--dry-run]
   143	
   144	  --dry-run              no lasting change; tree AND index restored on exit
   145	  --stable               target $TARGET_BASE (post-hold promote)
   146	  --rc N                 target ${TARGET_BASE}-rc.N (default N=$RC_NUM)
   147	  --key KEYID            GPG key (default $SIGN_KEY)
   148	  --today YYYY-MM-DD     date stamped into the last-reviewed lines
   149	  --restamp              move the review stamps at an unchanged version
   150	                         (requires --npm-readme-reviewed)
   151	  --offline-ack          ancestry guard judges a possibly stale origin/main
   152	  --npm-readme-reviewed  assert npm/README.md was actually re-read
   153	
   154	The header of this file documents what the Owner signs, why this script never
   155	pushes, and why it never publishes.
   156	USAGE
   157	}
   158	
   159	while [ "$#" -gt 0 ]; do
   160	  case "$1" in
   161	    preflight|bump|tag) PHASE="$1"; shift ;;
   162	    --dry-run) DRY_RUN=1; shift ;;
   163	    --stable)  STABLE=1; shift ;;
   164	    --npm-readme-reviewed) NPM_README_REVIEWED=1; shift ;;
   165	    --restamp) RESTAMP=1; shift ;;
   166	    --offline-ack) OFFLINE_ACK=1; shift ;;
   167	    --today)   TODAY="${2:?--today needs YYYY-MM-DD}"; shift 2 ;;
   168	    --rc)      RC_NUM="${2:?--rc needs a number}"; shift 2 ;;
   169	    --key)     SIGN_KEY="${2:?--key needs a keyid}"; shift 2 ;;
   170	    -h|--help) usage; exit 0 ;;
   171	    *) die "unknown argument: $1" ;;
   172	  esac
   173	done
   174	[ -n "$PHASE" ] || die "no phase given (preflight|bump|tag); see --help"
   175	
   176	if [ -n "$TODAY" ]; then
   177	  case "$TODAY" in
   178	    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
   179	    *) die "--today must be YYYY-MM-DD, got '$TODAY'" ;;
   180	  esac
   181	else
   182	  TODAY="$(date +%F)"
   183	fi
   184	
   185	if [ "$STABLE" -eq 1 ]; then
   186	  TARGET_VERSION="$TARGET_BASE"
   187	else
   188	  TARGET_VERSION="${TARGET_BASE}-rc.${RC_NUM}"
   189	fi
   190	TARGET_TAG="v${TARGET_VERSION}"
   191	
   192	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo"
   193	cd "$REPO_ROOT"
   194	
   195	# GPG in a non-interactive shell needs an explicit TTY or pinentry fails with
   196	# a misleading "No pinentry" (recurring footgun in this repo ceremonies).
   197	GPG_TTY="$(tty 2>/dev/null || true)"
   198	export GPG_TTY
   199	
   200	# Every file the bump phase may write — DERIVED, never typed. A hand-kept
   201	# restore list is how a dry-run left debris behind once already (S273): the
   202	# writer grew a site, the restore list did not. `--include-generated` adds the
   203	# two plugin manifests, which `build-plugin.py --write-manifests` rewrites
   204	# from VERSION during the bump.
   205	sites_out="$(python3 "$BUMP_SITES" print-sites --include-generated)" \
   206	  || die "cannot enumerate version sites from $BUMP_SITES"
   207	VERSION_FILES=()
   208	while IFS= read -r _site; do
   209	  [ -n "$_site" ] || continue
   210	  VERSION_FILES+=("$_site")
   211	done <<< "$sites_out"
   212	[ "${#VERSION_FILES[@]}" -gt 0 ] || die "$BUMP_SITES returned no version sites"
   213	
   214	printf 'release driver — target %s (tag %s), phase=%s, dry-run=%s, today=%s\n' \
   215	  "$TARGET_VERSION" "$TARGET_TAG" "$PHASE" "$DRY_RUN" "$TODAY"
   216	
   217	# ---------------------------------------------------------------------------
   218	# Dry-run safety net. Snapshot every file the `bump` phase writes plus the
   219	# index state, and restore both on ANY exit path.
   220	# ---------------------------------------------------------------------------
   221	SNAPSHOT_ARMED=0
   222	restore_snapshot() {
   223	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   224	  # The bump phase refuses to run on a dirty tree (untracked included), so
   225	  # HEAD is exactly the pre-bump state: reset unstages, checkout restores
   226	  # content. Both halves are needed — an index-only restore leaves the files
   227	  # modified, and a content-only restore leaves them staged (the S273 trap).
   228	  #
   229	  # PER PATH, never one multi-path command: `git checkout -- a b c` is
   230	  # ATOMIC — a single path absent from HEAD (a file the bump CREATED, e.g. a
   231	  # plugin manifest on its first appearance) aborts the WHOLE command and
   232	  # restores nothing, and the old `|| true` swallowed that error while the
   233	  # message below still claimed success. A path HEAD carries is checked out;
   234	  # a path HEAD does not carry was created by the bump and is removed.
   235	  local _p _dirty
   236	  for _p in "${VERSION_FILES[@]}"; do
   237	    git reset --quiet HEAD -- "$_p" 2>/dev/null || true
   238	    if git cat-file -e "HEAD:$_p" 2>/dev/null; then
   239	      git checkout --quiet -- "$_p" 2>/dev/null || true
   240	    else
   241	      rm -f "$_p" 2>/dev/null || true
   242	      # a directory created for that file may remain; drop it only if empty
   243	      # (never recursive — this is a restore, not a cleanup)
   244	      rmdir "$(dirname "$_p")" 2>/dev/null || true
   245	    fi
   246	  done
   247	  # ASSERT the postcondition, not the attempt: worktree AND index must be
   248	  # clean across every derived path, or this dry-run left debris and the only
   249	  # honest exit is a loud non-zero — printing "restored" over a dirty tree is
   250	  # the S273 class silenced instead of closed.
   251	  # The verification itself is fail-CLOSED (codex W0-residuals round): if
   252	  # `git status` ERRORS (repo/permission/object failure), an `|| true` here
   253	  # would read as "empty = clean" and print "asserted clean" over a
   254	  # postcondition that was never checked — capture the exit status instead.
   255	  _dirty="$(git status --porcelain -- "${VERSION_FILES[@]}" 2>/dev/null)"
   256	  _status_rc=$?
   257	  if [ "$_status_rc" -ne 0 ]; then
   258	    printf 'FAIL: dry-run restore verification could not run (git status rc=%s) — tree state UNVERIFIED, refusing to report clean\n' "$_status_rc" >&2
   259	    exit 1
   260	  fi
   261	  if [ -n "$_dirty" ]; then
   262	    printf 'FAIL: dry-run restore left these paths dirty (worktree/index != HEAD):\n' >&2
   263	    printf '%s\n' "$_dirty" >&2
   264	    exit 1
   265	  fi
   266	  printf '  --   dry-run: working tree AND index restored to HEAD (asserted clean)\n'
   267	}
   268	
   269	take_snapshot() {
   270	  SNAPSHOT_ARMED=1
   271	  trap restore_snapshot EXIT INT TERM
   272	}
