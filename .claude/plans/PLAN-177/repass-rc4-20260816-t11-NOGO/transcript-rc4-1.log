  2746	def test_both_rails_answer_identically_on_every_key_shape():
  2747	    """The instrument that would have caught P1-a: ONE question, two readers.
  2748	
  2749	    A divergence is only visible when the same bytes are put to both. For any
  2750	    block both accept, they must also agree on how many decisions it declares
  2751	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2752	    things on the two machines that gate a release.
  2753	    """
  2754	    def block(body: str) -> str:
  2755	        return "# fixture\n\n```yaml\n%s```\n" % body
  2756	
  2757	    canonical_shapes = [
  2758	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2759	        "verdict: NO-GO\nverdict: GO\n",
  2760	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2761	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2762	        "verdict: GO  # inline comment\n",
  2763	        "verdict: GO#NO-GO\nrelease_tag: v1.2.3\n",
  2764	        "# verdict: NO-GO\nverdict: GO\n",
  2765	    ]
  2766	    noncanonical_shapes = [
  2767	        "verdict:GO\n",
  2768	        "verdict: GO\n  NO-GO\nrelease_tag: v1.2.3\n",
  2769	        "verdict : NO-GO\nverdict: GO\n",
  2770	        "verdict\t: NO-GO\nverdict: GO\n",
  2771	        "verdict : GO\n",
  2772	        '"verdict": GO\n',
  2773	        "verdict :GO\n",
  2774	        # Re-pass rc.4 t7 P1: an ORPHAN-indented first line (no active bare
  2775	        # parent) previously slipped the prev_scalar_decl=False initial
  2776	        # state — `  verdict: NO-GO` + `verdict: GO` resolved as GO.
  2777	        "  verdict: NO-GO\nverdict: GO\n",
  2778	        # Same class after a scalar has RESET the state to non-bare.
  2779	        "release_tag: v1.2.3\n  verdict: NO-GO\nverdict: GO\n",
  2780	        # Root-level list item: this signed format's only lists are
  2781	        # INDENTED under a bare key; a root `- item` is malformed and was
  2782	        # accepted outright.
  2783	        "- verdict: NO-GO\nverdict: GO\n",
  2784	        "verdict: GO\n- trailing root list item\n",
  2785	        # Re-pass rc.4 t8 P1: Unicode-aware strip() in the SHAPE classifier
  2786	        # treated a U+00A0 VALUE as a bare parent (legitimizing an
  2787	        # orphan-indented line under it) and a lone-U+00A0 line as blank.
  2788	        "padding: \u00a0\n  verdict: NO-GO\nverdict: GO\n",
  2789	        "\u00a0\nverdict: GO\n",
  2790	        # Re-pass rc.4 t9 P1 #2: str.splitlines() also splits on VT/FF/
  2791	        # FS-RS/NEL/LS/PS \u2014 `GO<U+000B>#NO-GO` parsed as the exact token
  2792	        # GO on both rails. The extractor now rejects every control byte
  2793	        # except TAB and every separator except LF.
  2794	        "verdict: GO\u000b#NO-GO\n",
  2795	        "verdict: GO\u2028verdict: NO-GO\n",
  2796	        "verdict: GO\u0085release_tag: v1.2.3\n",
  2797	        "verdict: GO\r\nrelease_tag: v1.2.3\n",
  2798	    ]
  2799	    for body in canonical_shapes:
  2800	        text = block(body)
  2801	        assert validator.noncanonical_top_level_lines(text) == [], body
  2802	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2803	        assert validator.count_top_level_key(
  2804	            text, "verdict"
  2805	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2806	            "the two rails disagree on how many decisions %r declares" % body
  2807	        )
  2808	        assert validator.parse_verdict_text(text).get(
  2809	            "verdict"
  2810	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2811	            "the two rails disagree on WHICH decision wins in %r" % body
  2812	        )
  2813	    for body in noncanonical_shapes:
  2814	        text = block(body)
  2815	        assert validator.noncanonical_top_level_lines(text) != [], body
  2816	        assert (
  2817	            tag_guard._noncanonical_top_level_lines(text)
  2818	            == validator.noncanonical_top_level_lines(text)
  2819	        ), "the two shape gates disagree about %r" % body
