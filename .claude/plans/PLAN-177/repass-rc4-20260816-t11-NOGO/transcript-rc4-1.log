  2683	def test_both_rails_reject_ambiguous_or_multiple_yaml_fences():
  2684	    """Re-pass rc.4 t9 P1 #1: an unanchored block regex let a QUOTED
  2685	    ```yaml fence inside a four-backtick block become the authoritative
  2686	    verdict — a quoted GO envelope shadowed the real top-level NO-GO one
  2687	    and both rails exited 0. The strict extractor rejects any artifact
  2688	    whose literal ```yaml count differs from exactly one."""
  2689	    quoted_go_shadowing_real_nogo = (
  2690	        "# quoted example\n\n"
  2691	        "````markdown\n"
  2692	        "```yaml\n"
  2693	        "verdict: GO\n"
  2694	        "release_tag: v9.9.9\n"
  2695	        "```\n"
  2696	        "````\n\n"
  2697	        "```yaml\n"
  2698	        "verdict: NO-GO\n"
  2699	        "release_tag: v9.9.9\n"
  2700	        "```\n"
  2701	    )
  2702	    two_plain_blocks = (
  2703	        "```yaml\nverdict: GO\n```\n\n```yaml\nverdict: NO-GO\n```\n"
  2704	    )
  2705	    for text in (quoted_go_shadowing_real_nogo, two_plain_blocks):
  2706	        assert validator.noncanonical_top_level_lines(text) != [], (
  2707	            "step-15 validator accepted an ambiguous multi-fence artifact"
  2708	        )
  2709	        assert tag_guard._noncanonical_top_level_lines(text) != [], (
  2710	            "tag guard accepted an ambiguous multi-fence artifact"
  2711	        )
  2712	        try:
  2713	            parsed = validator.parse_verdict_text(text)
  2714	        except ValueError:
  2715	            parsed = {}
  2716	        assert parsed.get("verdict") != "GO", (
  2717	            "the quoted GO must never win: %r" % parsed
  2718	        )
  2719	        assert tag_guard._parse_verdict(text).get("verdict") != "GO"
  2720	    # An indented (column>0) opener is NOT the canonical fence either.
  2721	    indented_opener = " ```yaml\nverdict: GO\n```\n"
  2722	    assert validator.noncanonical_top_level_lines(indented_opener) != []
  2723	    assert tag_guard._noncanonical_top_level_lines(indented_opener) != []
  2724	    # t10 P1: a FALSE CLOSER (```not-a-closing-fence) must not end the
  2725	    # body early — the old bare ^``` closer hid a later NO-GO.
  2726	    false_closer = (
  2727	        "```yaml\n"
  2728	        "verdict: GO\n"
  2729	        "```not-a-closing-fence\n"
  2730	        "verdict: NO-GO\n"
  2731	        "```\n"
  2732	    )
  2733	    v_shape = validator.noncanonical_top_level_lines(false_closer)
