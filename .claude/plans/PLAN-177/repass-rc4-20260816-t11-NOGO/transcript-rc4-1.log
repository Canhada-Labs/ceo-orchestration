   560	            if age_hours > args.max_age_hours:
    70	#     the DECISION with a grammar the other rail did not share, so
    71	#     `verdict : NO-GO` + `verdict: GO` cut a tag on a NO-GO.
    72	# ============================================================================
    73	"""Ancestry + restricted-delta asserts for the release tag phase."""
    74	
    75	from __future__ import annotations
    76	
    77	import argparse
    78	import hashlib
    79	import os
    80	import re
    81	import subprocess
    82	import sys
    83	from typing import Dict, List, Optional, Sequence, Set, Tuple
    84	
    85	E_USAGE = 2
    86	E_FETCH = 3
    87	E_NOT_ANCESTOR = 4
    88	E_REMOTE_REF = 5
    89	E_DELTA = 6
    90	E_MANIFEST_PIN = 7
    91	E_MANIFEST_CONTENT = 8
    92	E_MANIFEST_SET = 9
    93	E_VERDICT = 10
    94	E_VACUOUS = 11
    95	E_PARENT_NOT_ANCESTOR = 12
    96	E_DECISION = 13
    97	
    98	# PLAN-177 W0.1 (P1-4). Spelled out here rather than imported from
    99	# .github/scripts/validate-pair-rail-verdict.py: the two rails are separate
   100	# processes on separate machines and neither may become a dependency of the
   101	# other. The set itself comes from
   102	# .claude/governance/pair-rail-verdict-template.md. EXACT equality, no case
   103	# folding and no prefix/substring rule -- NO-GO contains GO.
   104	ACCEPTED_DECISIONS = ("GO", "GO-WITH-CONDITIONS")
   105	
   106	HEX40 = re.compile(r"\A[0-9a-f]{40}\Z")
   107	
   108	# t9 P1 (byte-for-byte twin of the step-15 validator): ONE strict
   109	# extractor for the signed yaml block.
   110	#   * the artifact must contain EXACTLY ONE occurrence of the literal
   111	#     three-backtick yaml opener anywhere — a second occurrence (even
   112	#     quoted inside a four-backtick block) makes the authoritative block
   113	#     ambiguous, so the artifact is rejected fail-closed;
   114	#   * the opener must sit at line start, column 0, closed by a
   115	#     line-start fence — an unanchored search let a quoted GO envelope
   116	#     inside a four-backtick block shadow the real NO-GO one;
   117	#   * the body must be free of every line separator except LF and every
   118	#     control char except TAB: str.splitlines() also splits on
   119	#     U+000B/000C/001C-001E/0085/2028/2029, so a value glued to
   120	#     <U+000B>#NO-GO parsed as the exact token GO on both rails.
   121	# Returns the block body, or None when the artifact is rejected.
   122	_FORBIDDEN_CTRL_RE = re.compile(
   123	    "[\u0000-\u0008\u000b-\u001f\u007f\u0085\u2028\u2029]"
   124	)
   125	
   126	
   127	def _extract_single_yaml_block(text):
   128	    if text.count("```yaml") != 1:
   129	        return None
   130	    # t10 P1: the CLOSER must be canonical too — a bare ^``` matched
   131	    # ANY line starting with three backticks, so ```not-a-closer
   132	    # closed the body early and hid a later NO-GO.
   133	    m = re.search(
   134	        r"(?m)^```yaml[ \t]*\n(.*?)^```[ \t]*(?:\n|\Z)",
   135	        text,
   136	        re.DOTALL,
   137	    )
   138	    if not m:
   139	        return None
   140	    body = m.group(1)
   141	    if _FORBIDDEN_CTRL_RE.search(body):
   142	        return None
   143	    return body
   144	
   145	HEX64 = re.compile(r"\A[0-9a-f]{64}\Z")
   146	GLOB_CHARS = "*?["
   147	VERDICT_PREFIX = ".claude/governance/pair-rail-verdict-"
   148	# The allowlist is EXHAUSTIVE, not merely closed: the verdict for this tag plus
   149	# plan-side evidence (the `verdict-fields-<TAG>` pair and the re-pass artifact
   150	# directory both live under `.claude/plans/`). Anything else — a version site, a
   151	# workflow, any code path — would re-open the very hole the delta assert exists
   152	# to close: a post-review bump commit riding in on the tag.
   153	EVIDENCE_PREFIX = ".claude/plans/"
   154	
   155	
   156	def _fail(code: int, msg: str) -> int:
   157	    # Flush the ok-lines first: an operator reading a release failure must see
   158	    # WHICH checks passed before the one that stopped it, in order.
   159	    sys.stdout.flush()
   160	    print("FAIL: %s" % msg, file=sys.stderr)
   161	    sys.stderr.flush()
   162	    return code
   163	
   164	
   165	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   166	    proc = subprocess.run(
   167	        ["git"] + list(args),
   168	        cwd=repo,
   169	        stdout=subprocess.PIPE,
   170	        stderr=subprocess.PIPE,
   171	        universal_newlines=True,
   172	    )
   173	    return proc.returncode, proc.stdout, proc.stderr
   174	
   175	
   176	# ---------------------------------------------------------------------------
   177	# (a) ancestry
   178	# ---------------------------------------------------------------------------
   179	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   180	    ref = "%s/%s" % (remote, branch)
   181	    if offline_ack:
   182	        print(
   183	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   184	            "merge-base below is judged against a possibly STALE %s" % ref
   185	        )
   186	    else:
   187	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   188	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   189	        # stale ref reads as approval.
   190	        if rc != 0:
   191	            return _fail(
   192	                E_FETCH,
   193	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   194	                "      This is NOT a verdict on the commit — the check did not "
   195	                "run.\n"
   196	                "      Fix the network/remote and re-run, or, if you are "
   197	                "deliberately\n"
   198	                "      offline and accept judging against the last-known ref, "
   199	                "re-run\n"
   200	                "      with --offline-ack (it is recorded in the output).\n"
   201	                "      git said: %s" % (remote, branch, rc, err.strip()),
   202	            )
   203	        print("  ok   fetched %s" % ref)
   204	
   205	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   206	    if rc != 0 or not out.strip():
   207	        return _fail(
   208	            E_REMOTE_REF,
   209	            "no usable ref %s in this repo — cannot judge ancestry "
   210	            "(git said: %s)" % (ref, err.strip()),
   211	        )
   212	    remote_sha = out.strip()
   213	
   214	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   215	    if rc == 0:
   216	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   217	        return 0
   218	    if rc == 1:
   219	        return _fail(
   220	            E_NOT_ANCESTOR,
   221	            "HEAD is not an ancestor of %s — push main and re-run the "
   222	            "preflight.\n"
