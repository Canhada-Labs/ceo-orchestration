   452	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   453	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   454	    verdict_abs = os.path.join(repo, verdict_rel)
   455	    if not os.path.isfile(verdict_abs):
   456	        return _fail(
   457	            E_VERDICT,
   458	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   459	            "be committed before the tag is cut (release.yml validates it per "
   460	            "tag on the tagged tree)." % verdict_rel,
   461	        )
   462	    # t10 P2: newline="" keeps CR bytes visible to the grammar.
   463	    with open(verdict_abs, encoding="utf-8", newline="") as fh:
   464	        verdict_text = fh.read()
   465	    # PLAN-177 t2 (P1-a): SHAPE BEFORE ANY FIELD. Both rails read this file;
   466	    # they only agree on a canonical block. A non-canonical top-level line is
   467	    # refused here rather than handed to two different grammars — E_DECISION
   468	    # because the class this closes is the decision override (`verdict :
   469	    # NO-GO` + `verdict: GO`), and because a refusal that names the decision
   470	    # rail is the one an operator can act on.
   471	    noncanonical = _noncanonical_top_level_lines(verdict_text)
   472	    if noncanonical:
   473	        return _fail(
   474	            E_DECISION,
   475	            "verdict %s: non-canonical top-level key syntax %r -- a "
   476	            "top-level line must be\n"
   477	            "      `name:` with no whitespace before the colon (or a `- ` "
   478	            "list item only when INDENTED under a bare key, never at the "
   479	            "root). The two release rails read this\n"
   480	            "      file with different grammars, so `verdict : NO-GO` "
   481	            "followed by `verdict: GO` counts as two\n"
   482	            "      declarations server-side and one here; the shape is "
   483	            "refused instead of guessed."
   484	            % (verdict_rel, noncanonical),
   485	        )
   486	    fields = _parse_verdict(verdict_text)
   487	
   488	    release_tag = fields.get("release_tag")
   489	    if release_tag != tag:
   490	        return _fail(
   491	            E_VERDICT,
   492	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   493	            "to judge this tag against another tag's verdict."
   494	            % (verdict_rel, release_tag, tag),
   495	        )
   496	    # PLAN-177 W0.1 (P1-4) -- the DECISION gate.
   497	    #
   498	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on): the
   499	    # server-side twin (.github/scripts/validate-pair-rail-verdict.py, step
   500	    # 15) carries `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   501	    # (release.yml:689) -- there the decision check is defence in depth.
   502	    # THIS is the rail that enforces in every mode: release.sh calls it with
   503	    # `|| die`, and the release.yml step that calls it carries no escape
   504	    # hatch. Neither may be dropped for the other.
   505	    #
   506	    # Fail-CLOSED on SHAPE as well as value (CF-1): _parse_verdict returns a
   507	    # LIST for an empty `verdict:` line, so the type check precedes the
   508	    # compare -- a malformed decision is a named refusal, never a crash.
   509	    declared_decisions = _count_top_level_key(verdict_text, "verdict")
   510	    if declared_decisions > 1:
   511	        return _fail(
   512	            E_DECISION,
   513	            "verdict %s declares the decision %d times -- this reader "
   514	            "is last-wins, so a duplicated\n"
   515	            "      `verdict:` silently overrides the first; exactly one "
   516	            "is required."
   517	            % (verdict_rel, declared_decisions),
   518	        )
   519	    decision = fields.get("verdict")
   520	    if decision is None:
   521	        shown = "<absent>"
   522	    elif not isinstance(decision, str):
   523	        shown = "<non-string:%s>" % type(decision).__name__
   524	    else:
   525	        # ASCII-only trim (t5 P1) — twin of the server validator.
   526	        shown = decision.strip(" \t")
   527	    if shown not in ACCEPTED_DECISIONS:
   528	        return _fail(
   529	            E_DECISION,
   530	            "verdict %s: decision '%s' not in {%s} -- a tag may only be "
   531	            "cut on an authorizing decision.\n"
   532	            "      Everything the checks below assert (anchor, closed "
   533	            "allowlist, manifest content) is about WHICH TREE the\n"
   534	            "      re-pass saw; this one is about what the re-pass SAID "
   535	            "about it. A NO-GO over a perfect delta is still a NO-GO."
   536	            % (verdict_rel, shown, ", ".join(ACCEPTED_DECISIONS)),
   537	        )
   538	    parent = fields.get("parent_sha")
   539	    if not isinstance(parent, str) or not HEX40.match(parent):
   540	        return _fail(
   541	            E_VERDICT,
   542	            "verdict %s has no usable 40-hex `parent_sha:` — that field IS "
   543	            "the review anchor." % verdict_rel,
   544	        )
   545	    rc, _out, _err = _git(repo, "cat-file", "-e", parent + "^{commit}")
   546	    if rc != 0:
   547	        return _fail(
   548	            E_VERDICT,
   549	            "parent_sha %s from %s is not a commit in this repo."
   550	            % (parent, verdict_rel),
   551	        )
   552	    # Existence is not lineage. A fabricated anchor (`git commit-tree` over
   553	    # HEAD's own tree, parented anywhere, on no branch) passes `cat-file -e`
   554	    # and makes diff(parent..HEAD) contain ONLY the verdict + evidence while
   555	    # unreviewed work sits on main — every check below then passes and the
   556	    # guard prints approval over a tree the re-pass never saw. The anchor has
   557	    # to be a commit HEAD actually descends from. (The staged W1 server-side
   558	    # port asserts the same against origin/main — keep the two in sync.)
   559	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", parent, "HEAD")
   560	    if rc == 1:
   561	        return _fail(
   562	            E_PARENT_NOT_ANCESTOR,
   563	            "parent_sha %s from %s is not an ancestor of HEAD — the review "
   564	            "anchor is not in\n"
   565	            "      the history this tag would sign. `cat-file -e` proves the "
   566	            "object exists, not\n"
   567	            "      that main descends from it; a fabricated commit carrying "
   568	            "HEAD's own tree\n"
   569	            "      makes the delta below trivially clean while unreviewed "
   570	            "work rides the tag."
   571	            % (parent[:12], verdict_rel),
   572	        )
   573	    if rc != 0:
   574	        return _fail(
   575	            E_PARENT_NOT_ANCESTOR,
   576	            "`git merge-base --is-ancestor %s HEAD` exited %d (neither yes "
   577	            "nor no) — refusing to guess (git said: %s)"
   578	            % (parent[:12], rc, err.strip()),
   579	        )
   580	    print("  ok   parent_sha %s is an ancestor of HEAD" % parent[:12])
   581	
   582	    allow = fields.get("delta_allowlist")
   583	    if not isinstance(allow, list) or not allow:
   584	        return _fail(
   585	            E_VERDICT,
   586	            "verdict %s carries no `delta_allowlist:` entries — the closed "
   587	            "set is what makes the delta assert meaningful." % verdict_rel,
   588	        )
   589	    for entry in allow:
   590	        if any(ch in entry for ch in GLOB_CHARS):
   591	            return _fail(
   592	                E_VERDICT,
   593	                "delta_allowlist entry %r contains a glob metacharacter. The "
   594	                "set is CLOSED and literal: a pattern like "
   595	                "`pair-rail-verdict-*.md` would let a historical verdict or "
   596	                "the template be edited and still pass." % entry,
   597	            )
   598	        if entry.startswith("/") or ".." in entry.split("/"):
   599	            return _fail(
   600	                E_VERDICT,
   601	                "delta_allowlist entry %r must be a repo-relative path with "
   602	                "no `..` segment." % entry,
   603	            )
   604	        if entry.startswith(VERDICT_PREFIX) and entry != verdict_rel:
   605	            return _fail(
   606	                E_VERDICT,
   607	                "delta_allowlist entry %r is another tag's verdict (or the "
   608	                "template). Only %s may move for this tag."
   609	                % (entry, verdict_rel),
   610	            )
   611	        if entry != verdict_rel and not entry.startswith(EVIDENCE_PREFIX):
   612	            return _fail(
   613	                E_VERDICT,
   614	                "delta_allowlist entry %r is neither this tag's verdict nor "
   615	                "plan-side evidence under %s\n"
   616	                "      The allowlist is EXHAUSTIVE: the verdict, its "
   617	                "verdict-fields, and the\n"
   618	                "      re-pass artifacts — nothing else. Allowlisting a "
   619	                "version site, a\n"
   620	                "      workflow or any code path turns this assert into "
