   412	  ok "canonical doc freshness (review stamps current)"
   413	
   414	  cur_version="$(tr -d ' \n' < VERSION)"
   415	  if [ "$cur_version" = "$TARGET_BASE" ]; then
   416	    note "VERSION already $TARGET_BASE — bump phase is a no-op (expected on promote)"
   417	  else
   418	    note "VERSION is $cur_version, becomes $TARGET_BASE in the bump phase"
   419	  fi
   420	
   421	  hdr "signing key (proves it can actually sign — not just that it exists)"
   422	  gpg --list-secret-keys "$SIGN_KEY" >/dev/null 2>&1 \
   423	    || die "no secret key $SIGN_KEY in the keyring"
   424	  ok "secret key $SIGN_KEY present"
