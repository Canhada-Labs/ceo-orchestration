   131	die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
   132	ok()  { printf '  ok   %s\n' "$*"; }
   133	note(){ printf '  --   %s\n' "$*"; }
   134	hdr() { printf '\n== %s ==\n' "$*"; }
