  1568	def test_tarball_checksum_row_stays_deferred_until_a_real_mechanism_exists():
  1569	    """t10 P2: the name-based gate above verifies that an `enforced` row
  1570	    names a workflow STEP that exists — but any unrelated existing step
  1571	    satisfies it. Until a semantic predicate proves non-dry-run tarball
  1572	    creation + SHA-256 + publication, this row is PINNED to `deferred`:
  1573	    flipping it to `enforced` (the historical false promise) must go RED
  1574	    here first, forcing whoever flips it to also build the semantic gate."""
  1575	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1576	    rows = [r for r in _contract_rows(doc) if "SHA-256 tarball" in r[0]]
  1577	    assert len(rows) == 1, (
  1578	        "expected exactly one SHA-256-tarball Contract row, got %r" % rows
  1579	    )
  1580	    assert rows[0][2] == "deferred", (
  1581	        "the SHA-256 tarball row flipped to %r — a name-check alone cannot "
  1582	        "prove hashing/publication; add a semantic workflow predicate "
  1583	        "(non-dry-run pack + sha256 + upload) and update THIS pin together"
  1584	        % rows[0][2]
  1585	    )
  1586	    # mutation control: the dishonest flip is DETECTABLE by this pin.
  1587	    mutated = doc.replace(
  1588	        "| deferred | nothing — see §Not yet automated |",
  1589	        "| enforced | released (`npm-publish.yml` step `Publish to npm`) |",
  1590	        1,
  1591	    )
  1592	    assert mutated != doc, "fixture broke: the deferred row text moved"
  1593	    mrows = [r for r in _contract_rows(mutated) if "SHA-256 tarball" in r[0]]
  1594	    assert mrows and mrows[0][2] == "enforced", "mutation did not land"
