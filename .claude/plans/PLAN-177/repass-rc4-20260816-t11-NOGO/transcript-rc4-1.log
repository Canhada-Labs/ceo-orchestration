  2322	def _live_inputs_hash() -> str:
  2323	    """Recompute inputs_hash in THIS checkout, with the validator own manifest.
  2324	
  2325	    Never copied from a real envelope (codex P2-2): the validator is itself
  2326	    listed in pair-rail-inputs-hash-manifest.txt, so the P1-4 cure CHANGES the
  2327	    expected hash. A hardcoded hex would make the green cases fail on
  2328	    inputs_hash and the test would prove nothing about the decision.
  2329	    """
  2330	    key = "inputs_hash"
  2331	    if key not in _VALIDATOR_INPUTS_HASH_CACHE:
  2332	        _VALIDATOR_INPUTS_HASH_CACHE[key] = validator.compute_inputs_hash(
  2333	            REPO_ROOT, GOVERNANCE / "pair-rail-inputs-hash-manifest.txt"
