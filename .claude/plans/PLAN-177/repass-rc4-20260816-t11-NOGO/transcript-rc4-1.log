   274	hint_next_phase() {
   275	  # Test the VALUE: `${STABLE:+...}` expands for STABLE=0 (a non-empty string)
   276	  # and would tell the Owner to cut the STABLE tag during an RC run.
   277	  if [ "$STABLE" -eq 1 ]; then
   278	    note "proceed to: bash $0 tag --stable"
   279	  else
   280	    note "proceed to: bash $0 tag --rc $RC_NUM"
   281	  fi
   282	}
   283	
   284	# ---------------------------------------------------------------------------
   285	# Preflight — every gate fail-closed. Mirrors `.github/release-checklist.md`
   286	# and runs the SAME suites CI runs (a subset gate passes while CI is red; that
   287	# lesson is expensive and already paid).
   288	# ---------------------------------------------------------------------------
   289	preflight() {
   290	  hdr "git state"
   291	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — commit or stash first"
   292	  ok "tree clean"
   293	
   294	  branch="$(git rev-parse --abbrev-ref HEAD)"
   295	  [ "$branch" = "main" ] || die "on branch '$branch' — releases are cut from main"
   296	  ok "on main"
   297	
   298	  git fetch --quiet origin main || die "git fetch origin main failed"
   299	  local_sha="$(git rev-parse HEAD)"
   300	  remote_sha="$(git rev-parse origin/main)"
   301	  [ "$local_sha" = "$remote_sha" ] \
   302	    || die "HEAD ($local_sha) != origin/main ($remote_sha) — push or pull first"
   303	  ok "HEAD == origin/main ($local_sha)"
   304	
   305	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   306	    && die "tag $TARGET_TAG already exists"
   307	  ok "tag $TARGET_TAG is free"
   308	
   309	  hdr "CI for HEAD"
   310	  if command -v gh >/dev/null 2>&1; then
   311	    runs="$(gh run list --limit 40 \
   312	      --json headSha,conclusion,status,workflowName 2>/dev/null || true)"
   313	    if [ -n "$runs" ]; then
   314	      verdict="$(mktemp)"
   315	      printf '%s' "$runs" | HEAD_SHA="$local_sha" python3 -c '
   316	import json, os, sys
   317	sha = os.environ["HEAD_SHA"]
   318	runs = [r for r in json.load(sys.stdin) if r.get("headSha") == sha]
   319	if not runs:
   320	    print("NO_RUNS"); sys.exit(0)
   321	bad = [r for r in runs if r.get("conclusion") not in ("success", "skipped", "")]
   322	pend = [r for r in runs if r.get("status") != "completed"]
   323	val = [r for r in runs if "Validate" in (r.get("workflowName") or "")]
   324	for r in bad:
   325	    print("BAD %s=%s" % (r["workflowName"], r["conclusion"]))
   326	for r in pend:
   327	    print("PENDING %s" % r["workflowName"])
   328	if not any(r.get("conclusion") == "success" for r in val):
   329	    print("NO_VALIDATE_SUCCESS")
   330	' > "$verdict" || die "CI verdict parse failed"
   331	      if grep -q '^BAD ' "$verdict"; then
   332	        cat "$verdict" >&2; rm -f "$verdict"
   333	        die "a workflow for HEAD is not green"
   334	      fi
   335	      if grep -q '^PENDING ' "$verdict"; then
   336	        cat "$verdict" >&2; rm -f "$verdict"
   337	        die "a workflow for HEAD is still running — wait for it"
   338	      fi
   339	      if grep -q 'NO_VALIDATE_SUCCESS' "$verdict"; then
   340	        rm -f "$verdict"
   341	        die "no successful Validate run for HEAD"
   342	      fi
   343	      if grep -q 'NO_RUNS' "$verdict"; then
   344	        rm -f "$verdict"
   345	        die "no CI runs found for HEAD — push it and let CI run"
   346	      fi
   347	      rm -f "$verdict"
   348	      ok "all workflows for HEAD green (Validate success)"
   349	    else
   350	      die "gh returned no run data — cannot confirm CI (fail-closed)"
   351	    fi
   352	  else
   353	    die "gh CLI not available — cannot confirm CI (fail-closed)"
   354	  fi
   355	
   356	  # These MUST be the invocations validate.yml uses, not `unittest discover`.
   357	  # The suite is pytest-only BY CONSTRUCTION: conftest.py carries the sys.path
   358	  # bootstrap and the _lib resolution guards as pytest collection hooks, and
   359	  # several modules isolate their environment with pytest `autouse` fixtures.
   360	  # `unittest discover` loads none of that, so those modules run with their
   361	  # declared isolation silently disabled — which leaks CLAUDE_PROJECT_DIR into
   362	  # later modules. test_flip_closures then resolves settings.json /
   363	  # red-team.yml under a dead tmp dir and reports that files which plainly
   364	  # exist "must exist". It passes 12/12 when run alone. Diagnosed 2026-08-02
   365	  # during a GA promote; the old invocation made this gate a FALSE RED that
   366	  # blocked a release whose CI was green.
   367	  hdr "test suites (the same ones CI runs)"
   368	  python3 -m pytest .claude/hooks/tests/ -n auto -m 'not serial' \
   369	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   370	    || die "hooks test suite failed (not serial)"
   371	  python3 -m pytest .claude/hooks/tests/ -m 'serial' \
   372	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   373	    || die "hooks test suite failed (serial)"
   374	  ok "hooks tests pass"
   375	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   376	    -n auto -m 'not serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   377	    || die "scripts test suite failed (not serial)"
   378	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   379	    -m 'serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   380	    || die "scripts test suite failed (serial)"
   381	  ok "scripts tests pass"
   382	
   383	  hdr "governance gates"
   384	  bash .claude/scripts/validate-governance.sh >/dev/null 2>&1 \
   385	    || die "validate-governance.sh nonzero"
   386	  ok "validate-governance"
   387	  bash .claude/scripts/check-contamination.sh >/dev/null 2>&1 \
   388	    || die "check-contamination.sh nonzero"
   389	  ok "check-contamination"
   390	  python3 .claude/scripts/check-claude-md-claims.py >/dev/null 2>&1 \
   391	    || die "check-claude-md-claims.py nonzero"
   392	  ok "CLAUDE.md claims"
   393	  bash .claude/scripts/local/verify-counts.sh --quiet >/dev/null 2>&1 \
   394	    || die "verify-counts.sh reports drift"
   395	  ok "derived counts (no drift)"
   396	
   397	  hdr "release artifacts"
