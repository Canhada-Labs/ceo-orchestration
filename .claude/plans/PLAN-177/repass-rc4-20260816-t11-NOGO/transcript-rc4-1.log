    83	from typing import Dict, List, Optional, Sequence, Set, Tuple
    84	
    85	E_USAGE = 2
    86	E_FETCH = 3
    87	E_NOT_ANCESTOR = 4
    88	E_REMOTE_REF = 5
    89	E_DELTA = 6
    90	E_MANIFEST_PIN = 7
    91	E_MANIFEST_CONTENT = 8
    92	E_MANIFEST_SET = 9
    93	E_VERDICT = 10
    94	E_VACUOUS = 11
    95	E_PARENT_NOT_ANCESTOR = 12
    96	E_DECISION = 13
