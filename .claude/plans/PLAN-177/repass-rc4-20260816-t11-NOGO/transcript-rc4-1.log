  2400	    tag = "v0.0.0-plan177-decision-gate"
  2401	    parent = _repo_head()
  2402	    verdict_file = tmp_path / "pair-rail-verdict-fixture.md"
  2403	    _write_live_shaped_verdict(verdict_file, tag, decisions, parent)
  2404	    argv = [
  2405	        sys.executable, str(VALIDATOR_SRC),
  2406	        "--verdict-file", str(verdict_file),
  2407	        "--parent-sha", parent if bind_parent else "",
  2408	        "--release-tag", tag,
  2409	        "--max-age-hours", "24",
  2410	        "--recompute-inputs-hash",
  2411	        "--codex-cli-pin-file", ".claude/governance/codex-cli-pin.txt",
  2412	        "--codex-cli-binary-sha256-file",
  2413	        ".claude/governance/codex-cli-binary-sha256.txt",
  2414	        "--codex-pin-manifest-file",
  2415	        ".claude/governance/codex-cli-pin-manifest.json",
  2416	        "--inputs-hash-paths-file",
  2417	        ".claude/governance/pair-rail-inputs-hash-manifest.txt",
  2418	    ]
  2419	    return run(argv, REPO_ROOT, env)
