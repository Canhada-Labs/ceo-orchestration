  1519	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1520	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1521	    Status are not read — a row that claims no enforcement makes no claim to
  1522	    check."""
  1523	    out: List[List[str]] = []
  1524	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1525	        if status != "enforced":
  1526	            continue
  1527	        for workflow, step in _ENFORCED_RX.findall(where):
  1528	            out.append([control, workflow, step])
  1529	    return out
  1530	
  1531	
  1532	def _integrity_contract_offenders(doc_text: str, repo_root: Path) -> List[str]:
  1533	    """Closed-set Status, plus: every `enforced` row names a workflow that
  1534	    exists and a step that exists in it, by exact equality."""
  1535	    offenders: List[str] = []
  1536	    for control, _mechanism, status, where in _contract_rows(doc_text):
  1537	        if status not in _CONTRACT_STATUSES:
  1538	            offenders.append(
  1539	                "%s: Status %r is outside the closed set %s"
  1540	                % (control, status, list(_CONTRACT_STATUSES))
  1541	            )
  1542	            continue
  1543	        if status != "enforced":
  1544	            continue
  1545	        pairs = _ENFORCED_RX.findall(where)
  1546	        if not pairs:
  1547	            offenders.append(
  1548	                "%s: Status is enforced but `Where enforced` names no "
  1549	                "workflow+step in the parseable form — %r" % (control, where)
  1550	            )
  1551	            continue
  1552	        for workflow, step in pairs:
  1553	            wf = repo_root / workflow
  1554	            if not wf.is_file():
  1555	                offenders.append(
  1556	                    "%s: names workflow %s, which does not exist"
  1557	                    % (control, workflow)
  1558	                )
  1559	                continue
  1560	            if step not in _yaml_step_names(wf):
  1561	                offenders.append(
  1562	                    "%s: names step %r in %s, which has no such step"
  1563	                    % (control, step, workflow)
  1564	                )
  1565	    return offenders
  1566	
