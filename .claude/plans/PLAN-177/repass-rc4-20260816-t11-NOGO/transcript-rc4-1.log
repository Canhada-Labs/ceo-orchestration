   404	def _sha256(path: str) -> str:
   405	    h = hashlib.sha256()
   406	    with open(path, "rb") as fh:
   407	        for chunk in iter(lambda: fh.read(65536), b""):
   408	            h.update(chunk)
   409	    return h.hexdigest()
   410	
   411	
   412	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   413	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   414	    entries: List[Tuple[str, str]] = []
   415	    # t10 P2: newline="" keeps CR bytes visible to the grammar.
   416	    with open(path, encoding="utf-8", newline="") as fh:
   417	        for line in fh:
   418	            line = line.rstrip("\n")
   419	            if not line.strip():
   420	                continue
   421	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   422	            if not m:
   423	                raise ValueError("unparsable manifest line: %r" % line)
   424	            entries.append((m.group(1), m.group(2)))
   425	    return entries
   426	
   427	
   428	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   429	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   430	    directory = os.path.dirname(manifest) or "."
   431	    name = os.path.basename(manifest)
   432	    try:
   433	        proc = subprocess.run(
   434	            ["shasum", "-a", "256", "-c", name],
   435	            cwd=directory,
   436	            stdout=subprocess.PIPE,
   437	            stderr=subprocess.STDOUT,
   438	            universal_newlines=True,
   439	        )
   440	        return proc.returncode == 0, proc.stdout.strip()
   441	    except (OSError, FileNotFoundError):
   442	        bad: List[str] = []
   443	        for want, rel in _read_manifest(manifest):
   444	            full = os.path.join(directory, rel)
   445	            if not os.path.isfile(full) or _sha256(full) != want:
   446	                bad.append(rel)
   447	        if bad:
   448	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   449	        return True, "hashlib fallback: all entries match"
   450	
