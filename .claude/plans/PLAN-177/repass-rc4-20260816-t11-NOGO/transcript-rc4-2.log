   892	  # reports a tracked path as unmatched, causing a re-assert loop; the
   893	  # question here is strictly "does the PATTERN SET cover this path?".
   894	  if git -C "$_gre_repo" check-ignore -q --no-index -- "$_gre_probe" 2>/dev/null; then
   895	    return 0
   896	  fi
   897	  {
   898	    echo ""
   899	    echo "# Re-asserted by ceo-orchestration (re-pass rc.4 t8 P1): a later"
   900	    echo "# rule in this file negated the mandatory exclusion below; git's"
   901	    echo "# last-matching-rule-wins makes this trailing copy effective."
   902	    printf '%s\n' "$_gre_line"
   903	  } >> "$_gre_file"
   904	  if git -C "$_gre_repo" check-ignore -q --no-index -- "$_gre_probe" 2>/dev/null; then
   905	    echo "    RE-ASSERTED (was textually present but negated): $_gre_line"
   906	    return 0
   907	  fi
   908	  # t10 P1 #1: a still-visible SECURITY exclusion is a FAILURE, not a
   909	  # warning — returning 0 here let install/upgrade finish green while
   910	  # the secret store stayed commit-eligible (e.g. a deeper
   911	  # state/.gitignore re-including it, which outranks this file).
   912	  echo "    ERROR: $_gre_line is present but NOT effective (a rule outside $_gre_file wins — e.g. a deeper .gitignore re-including it). Fix the adopter ignore rules, then re-run." >&2
   913	  return 1
