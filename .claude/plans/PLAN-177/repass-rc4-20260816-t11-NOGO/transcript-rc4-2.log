  1977	# --------------------------------------------------------------------------
  1978	# Supply-chain honesty: the two claims that survive being corrected in one file
  1979	#
  1980	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  1981	# was green while `npm/README.md` — the README an npm consumer actually
  1982	# RECEIVES, it is in package.json `files` — still promised "SLSA 3 provenance",
  1983	# and while README.pt-BR, INSTALL.md and both QUICKSTARTs repeated Level 3 and
  1984	# a checksum coverage the release does not have (repass-rc4 part 2, P1 §2).
  1985	# A single-file gate cannot see that class, so the surface list below is
  1986	# EXPLICIT, and `_live_doc_surfaces()` re-derives the population from the repo
  1987	# so a NEW document carrying either claim also lands in front of the gate.
  1988	#
  1989	# `.claude/**` is deliberately outside the population: plans, debates and
  1990	# archived verdicts are historical records, and they have to be able to quote a
  1991	# false claim verbatim without turning this gate red.
  1992	# --------------------------------------------------------------------------
  1993	
  1994	SUPPLY_CHAIN_HONESTY_SURFACES = (
  1995	    "README.md",
  1996	    "README.pt-BR.md",
  1997	    "npm/README.md",
  1998	    "npm/INTEGRITY.md",
  1999	    "INSTALL.md",
  2000	    "SECURITY.md",
  2001	    "SUPPORT.md",
  2002	    "SBOM.md",
  2003	    "docs/QUICKSTART.md",
  2004	    "docs/QUICKSTART.pt-BR.md",
  2005	    "docs/CTO-GUIDE.md",
  2006	    "docs/threat-model.md",
  2007	)
  2008	
  2009	# "SLSA 3", "SLSA-3", "SLSA Level 3", "SLSA L3", "SLSA provenance L3" and
  2010	# "provenance (SLSA L3)" all normalise to the same false claim. The earlier
  2011	# pattern only caught the first three, which is why `SBOM.md` ("SLSA L3") and
  2012	# `docs/QUICKSTART.md` ("SLSA provenance L3") were invisible to it.
  2013	_SLSA_LEVEL3_CLAIM = re.compile(
  2014	    r"SLSA[\s\-]*(?:provenance[\s\-]*)?(?:Level[\s\-]*|L)?3\b"
  2015	    r"|(?:provenance|attestation)[\s\-]*(?:Level[\s\-]*|L)3\b",
  2016	    re.IGNORECASE,
  2017	)
  2018	
  2019	# Plural = aggregate. Release checksum coverage is `install.sh` alone
  2020	# (SECURITY.md §How to verify what you install); "ships SHA-256 checksums"
  2021	# promises a SHA256SUMS that no workflow produces.
  2022	_CHECKSUM_AGGREGATE_CLAIM = re.compile(
  2023	    r"SHA-?256\s+checksums|checksums\s+SHA-?256", re.IGNORECASE
  2024	)
  2025	
  2026	
  2027	def _live_doc_surfaces() -> List[Path]:
  2028	    """Root-level, `docs/` and `npm/` markdown — every document a reader or an
  2029	    npm consumer meets. Deliberately NOT `.claude/**` (see the block comment)."""
  2030	    found = sorted(REPO_ROOT.glob("*.md"))
  2031	    for sub in ("docs", "npm"):
  2032	        base = REPO_ROOT / sub
  2033	        if base.exists():
  2034	            found += sorted(base.rglob("*.md"))
  2035	    return found
  2036	
  2037	
  2038	def test_slsa_and_checksum_claims_are_true_on_every_shipped_surface():
  2039	    """The npm consumer reads `npm/README.md`; the Portuguese reader reads
  2040	    `README.pt-BR.md`. Correcting the root README alone left both promising a
  2041	    Level the pipeline never reaches. The gate now runs over an explicit list
  2042	    AND over every live doc, so neither a missed translation nor a new file can
  2043	    carry the claim silently."""
  2044	    surfaces = {p.relative_to(REPO_ROOT).as_posix(): p for p in _live_doc_surfaces()}
  2045	
  2046	    # (a) The explicit list is not allowed to name a file that stopped
  2047	    # existing: a surface silently dropped from the repo is a gate that
  2048	    # quietly narrows.
  2049	    missing = [s for s in SUPPLY_CHAIN_HONESTY_SURFACES if s not in surfaces]
  2050	    assert not missing, "declared honesty surfaces that no longer exist: %s" % missing
  2051	
  2052	    offenders: List[str] = []
  2053	    for rel, path in surfaces.items():
  2054	        text = path.read_text(encoding="utf-8")
  2055	        for m in _SLSA_LEVEL3_CLAIM.finditer(text):
  2056	            # Tolerance is scoped to what FOLLOWS the mention, never to the
  2057	            # line: the honest sentence names Level 2 and disclaims Level 3 in
  2058	            # one breath, so a line-wide exemption would let the false claim
  2059	            # ride along beside its own disclaimer. The window is 120 chars
  2060	            # because the live disclaimer parenthesises its reason
  2061	            # ("(hermetic build + two-party review) is out of scope") — at the
  2062	            # old width of 40 the only honest Level-3 sentence in the repo
  2063	            # would have been the gate's first false positive.
  2064	            tail = text[m.end():m.end() + 120]
  2065	            if "out of scope" in tail or "fora de escopo" in tail:
  2066	                continue
  2067	            offenders.append(
  2068	                "%s: ...%s..."
  2069	                % (rel, text[max(0, m.start() - 60):m.end() + 40].strip().replace("\n", " "))
  2070	            )
  2071	        for m in _CHECKSUM_AGGREGATE_CLAIM.finditer(text):
  2072	            offenders.append(
  2073	                "%s: ...%s..."
  2074	                % (rel, text[max(0, m.start() - 70):m.end() + 30].strip().replace("\n", " "))
  2075	            )
  2076	
  2077	    assert not offenders, (
  2078	        "shipped docs claim SLSA Level 3 and/or aggregate release checksums; "
  2079	        "the pipeline reaches Level 2 (`npm publish --provenance`) and the "
  2080	        "release checksum covers `install.sh` only:\n%s" % "\n".join(offenders)
  2081	    )
  2082	
  2083	    # (b) Positive statement, on the two most-read surfaces: silence about the
  2084	    # level is not honesty either. The npm README is named explicitly because
  2085	    # it is the one that travels inside the tarball.
  2086	    for rel in ("README.md", "npm/README.md"):
  2087	        text = surfaces[rel].read_text(encoding="utf-8")
  2088	        assert "SLSA **Level 2**" in text or "SLSA Level 2" in text, (
  2089	            "%s no longer states the level the pipeline reaches" % rel
  2090	        )
