   752	# ===========================================================================
   753	# PLAN-166 F3 (ADR-155-AMEND-1) — resolve the RECORDED install ceremony with
   754	# a reader of its OWN, INDEPENDENT of the replay path: --no-replay sets
   755	# REPLAY=0 and the replay block above (incl. _read_install_state_request) is
   756	# skipped entirely, so if the ceremony rode the replay, the documented
   757	# `upgrade.sh <target> --no-replay` would treat a `--ceremony user` install
   758	# as maintainer and force SPEC/protocol into the adopter's root (r9). This
   759	# reader ALWAYS runs. Fail-SAFE (re-pass rc.4 t3/t5, corrected t9 P2 —
   760	# this comment previously described the OLD maintainer default): state
   761	# absent/unreadable/invalid (ALL pre-Wave-B installs) => "user" — root
   762	# files untouched; a pre-state MAINTAINER opts back in explicitly with
   763	# `--ceremony maintainer` (or CEO_UPGRADE_CEREMONY), and only an explicit
   764	# or recorded value ever persists. Same trust class as the replay reader:
   765	# target-side, UNSIGNED, advisory; the value is validated against the
   766	# closed enum {maintainer,user} and never eval-ed.
   767	# ===========================================================================
   768	_read_install_state_ceremony() {
   769	  command -v python3 >/dev/null 2>&1 || return 3
   770	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
   771	  PYTHONNOUSERSITE=1 python3 -I -c '
   772	import json, sys
   773	try:
   774	    with open(sys.argv[1], "r", encoding="utf-8") as f:
   775	        d = json.load(f)
   776	except (OSError, ValueError):
   777	    sys.exit(3)
   778	if not isinstance(d, dict) or d.get("schema_version") != 1:
   779	    sys.exit(3)
   780	req = d.get("request")
   781	if not isinstance(req, dict):
   782	    sys.exit(3)
   783	cer = req.get("ceremony", "")
   784	if cer not in ("maintainer", "user"):
   785	    sys.exit(3)
   786	sys.stdout.write(cer + "\n")
   787	' "$_INSTALL_STATE_FILE" 2>/dev/null
   788	}
