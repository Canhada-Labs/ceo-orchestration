   206	def _seed_fw(tmp_path: pathlib.Path, version: str,
   207	             delivered: bool = True) -> None:
   208	    (tmp_path / ".claude").mkdir(parents=True, exist_ok=True)
   209	    (tmp_path / ".claude" / ".framework-version").write_text(version + "\n")
   210	    if delivered:
   211	        # registro de entrega (ADR-155-AMEND-1): baseline manifest com
   212	        # record do marker => proveniencia verificada
   213	        (tmp_path / ".claude" / ".install-manifest.sha256").write_text(
   214	            "0" * 64 + "  .claude/.framework-version\n"
   215	        )
