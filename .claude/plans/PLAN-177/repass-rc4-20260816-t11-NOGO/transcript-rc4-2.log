 if [ -n "$TODAY" ]; then
   case "$TODAY" in
     [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
     *) die "--today must be YYYY-MM-DD, got '$TODAY'" ;;
   esac
