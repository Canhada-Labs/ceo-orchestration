   237	
   238	      # PLAN-161 upgrade oracles (green only once the U1/U2/U3 upgrade.sh
   239	      # fixes are in-tree — land atomically with them).
   240	      - name: Upgrade oracle — --dry-run identity (U1)
   241	        run: |
   242	          set -euo pipefail
   243	          bash scripts/tests/test-upgrade-dryrun-identity.sh
   244	
   245	      - name: Upgrade oracle — exclusion parity + opt-in purge (U2/U3)
   246	        run: |
   247	          set -euo pipefail
   248	          bash scripts/tests/test-upgrade-exclusions.sh
   249	
   250	      # WS4-user-ceremony-leg
   251	      - name: Install with --ceremony user (governance rc=0 + no out-of-.claude writes)
   252	        run: |
   253	          set -euo pipefail
   254	          U="$(mktemp -d)"
   255	          ( cd "$U" && git init -q )
   256	          CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   257	            bash scripts/install.sh "$U" --ceremony user
   258	          echo '--- validate-governance.sh (user) ---'
   259	          ( cd "$U" && bash .claude/scripts/validate-governance.sh )
   260	          echo '--- assert only .claude/ at top level ---'  # WS4-sc2010-glob
   261	          extra=""
   262	          for _e in "$U"/* "$U"/.[!.]* "$U"/..?*; do
   263	            [ -e "$_e" ] || continue
   264	            _b="$(basename "$_e")"
   265	            case "$_b" in .claude|.git) continue ;; esac
   266	            extra="$extra $_b"
   267	          done
   268	          if [ -n "$extra" ]; then
   269	            echo "::error::--ceremony user wrote outside .claude/:$extra"
   270	            exit 1
