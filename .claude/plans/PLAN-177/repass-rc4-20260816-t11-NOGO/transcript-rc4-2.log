+say ""
+say "--> [D2] pinned user install -> SEED -> upgrade"
+TD2="$( new_target D2-seeded-upgrade )"
+do_install "$PIN_SRC" "$TD2" user
+printf '%s\n' "# adopter file" "/cache/" > "$TD2/.claude/.gitignore"
