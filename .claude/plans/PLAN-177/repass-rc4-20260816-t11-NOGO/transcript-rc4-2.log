+  say "        posture artifacts in any route or ceremony, and every"
+  say "        scenario's control fired."
+  say "=============================================================="
+  exit 0
+fi
+say "RESULT: FAIL (exit 1) — see the FAIL lines above."
+say "=============================================================="
+exit 1
