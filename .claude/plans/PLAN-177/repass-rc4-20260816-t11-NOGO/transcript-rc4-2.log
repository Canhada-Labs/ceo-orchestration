  1893	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1894	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1895	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1896	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1897	    even standing somewhere that can be checked?" — the question the file
  1898	    failed on the day it shipped."""
  1899	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1900	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1901	
  1902	    # The sweep must be looking at the right text: intro present, table absent.
  1903	    swept = _prose_outside_the_declared_zones(doc)
  1904	    assert "Integrity contract for the" in swept, (
  1905	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1906	        "the prose it exists to watch"
  1907	    )
  1908	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1909	    assert len(swept) > len(doc) // 3, (
  1910	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1911	        % (len(swept), len(doc))
  1912	    )
  1913	
  1914	    # t9 P2 positive control: a table OUTSIDE `## Contract` carrying an
  1915	    # enforcement claim must NOT be exempted by the sweep — the old blanket
  1916	    # `startswith("|")` filter stripped every table anywhere.
  1917	    outside_table = (
  1918	        doc
  1919	        + "\n## Some new section\n\n"
  1920	        + "| per-tarball SHA-256 manifest | enforced today; recorded by "
  1921	        + "npm-publish.yml |\n"
  1922	    )
  1923	    assert _enforcement_vocabulary_offenders(outside_table), (
  1924	        "an enforcement claim inside a table OUTSIDE ## Contract passed the "
  1925	        "generic sweep — the exemption must be Contract-section-only"
  1926	    )
  1927	
  1928	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1929	    # merits. The order matters and was learned the hard way — the controls
  1930	    # below build their fixtures FROM the live file, so when the file itself
  1931	    # carries a planted defect they fail first and the red names the fixture
  1932	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1933	    # always reds on the assertion that describes what is actually wrong.
  1934	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1935	    offenders = _enforcement_vocabulary_offenders(doc)
  1936	    assert not offenders, (
  1937	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1938	        "§Not yet automated. Move the claim into a table row (with a step the "
  1939	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1940	    )
  1941	
  1942	    # (b) positive control: the historical claim restored to the introduction.
  1943	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1944	    # today's wording — an anchor on current prose stops matching the moment
  1945	    # that prose is edited, and then the control fails for the wrong reason.
  1946	    title, _, rest = doc.partition("\n")
  1947	    claim = (
  1948	        "The integrity controls enforced today are: (1) the `install.sh` "
  1949	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1950	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1951	    )
  1952	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1953	    assert relapse != doc, "relapse fixture did not patch the doc"
  1954	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1955	    assert any("enforced today" in o for o in relapse_offenders), (
  1956	        "an enforcement claim in the introduction went unseen: %s"
  1957	        % relapse_offenders
  1958	    )
  1959	    assert any("recorded by" in o for o in relapse_offenders), (
