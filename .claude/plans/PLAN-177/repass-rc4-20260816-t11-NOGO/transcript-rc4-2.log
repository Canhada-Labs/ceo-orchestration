   188	def _extract_spec_drift_fn(repo_root: pathlib.Path):
   189	    """Extrai check_tier_a_spec_version_drift do ceo-boot.py real e a
   190	    executa num namespace com REPO_ROOT stubbado (sem importar o script
   191	    inteiro — top-level do ceo-boot tem efeitos de sessao)."""
   192	    src = CEO_BOOT.read_text(encoding="utf-8")
   193	    tree = ast.parse(src)
   194	    fn = next(
   195	        node for node in ast.walk(tree)
   196	        if isinstance(node, ast.FunctionDef)
   197	        and node.name == "check_tier_a_spec_version_drift"
   198	    )
   199	    segment = ast.get_source_segment(src, fn)
   200	    ns: dict = {"REPO_ROOT": repo_root, "Tuple": Tuple, "Any": Any,
   201	                "subprocess": subprocess}
   202	    exec(compile(segment, str(CEO_BOOT), "exec"), ns)  # noqa: S102
   203	    return ns["check_tier_a_spec_version_drift"]
