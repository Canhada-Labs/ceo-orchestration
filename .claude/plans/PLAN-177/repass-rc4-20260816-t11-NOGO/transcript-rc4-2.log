  1782	# ---------------------------------------------------------------------------
  1783	# PLAN-177 W0.3 delta (codex P1-4 of the v4 round) — the generic sweep.
  1784	#
  1785	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1786	# checksum gate anchors three named phantom referents. A NEW enforcement
  1787	# promise, about some other subject, written into a section nobody watches,
  1788	# passes all of them. The original defect is the proof that this is not
  1789	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1790	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1791	#
  1792	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1793	# Contract table row (machine-checked by
  1794	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1795	# to the table's un-enforced rows by
  1796	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1797	# Anywhere else it is answerable to nothing, and is a red.
  1798	#
  1799	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1800	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1801	#
  1802	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1803	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1804	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1805	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1806	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1807	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1808	#     at the table rather than enumerating mechanisms, and the tag-signing
  1809	#     paragraph cites SECURITY.md as the authority instead of restating the
  1810	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1811	#     needs no exemption, so it has none.
  1812	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1813	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1814	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1815	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1816	#     are the file speaking about what the pipeline does.
  1817	#     A broad list that has to be switched off is worth less than a narrow
  1818	#     one that stays on.
  1819	#
  1820	# Matching is on word boundaries after normalization. Substring matching was
  1821	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1822	# substring-vs-exact class, for the fourth time in this plan.
  1823	_ENFORCEMENT_VOCAB = (
  1824	    "enforced today",
  1825	    "is enforced",
  1826	    "are enforced",
  1827	    "enforced by",
  1828	    "enforced at",
  1829	    "every tag publish",
  1830	    "recorded by",
  1831	    "is verified",
  1832	    "are verified",
  1833	    "verifies",
  1834	    "must satisfy",
  1835	    "guarantees",
  1836	    "is guaranteed",
  1837	    "are guaranteed",
  1838	    "asserted by",
  1839	    "checked by",
  1840	    "gated by",
  1841	    "fails closed",
  1842	    "fail closes",
  1843	    "asserts",
  1844	    "ensures",
  1845	    "is signed",
  1846	    "are signed",
  1847	)
  1848	
  1849	
  1850	def _normalize_prose(text: str) -> str:
  1851	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1852	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1853	    normalize the same way, so a claim cannot hide behind formatting."""
  1854	    text = text.lower()
  1855	    for ch in ("*", "`", "_"):
  1856	        text = text.replace(ch, "")
  1857	    text = text.replace("-", " ")
  1858	    return re.sub(r"\s+", " ", text)
  1859	
  1860	
  1861	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1862	    """Everything that is neither a `## Contract` table row nor §Not yet
  1863	    automated — the surfaces where a mechanism claim answers to nothing.
  1864	
  1865	    Re-pass rc.4 t9 P2: strip table rows ONLY inside `## Contract` — the
  1866	    blanket startswith("|") filter exempted EVERY table anywhere in the
  1867	    doc, so a new table outside the Contract section could carry an
  1868	    enforcement claim past this sweep unchecked.
  1869	    """
  1870	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1871	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", body)
  1872	    if m:
  1873	        stripped_section = "\n".join(
  1874	            line for line in m.group(0).splitlines()
  1875	            if not line.strip().startswith("|")
  1876	        )
  1877	        body = body[: m.start()] + stripped_section + body[m.end():]
  1878	    return body
  1879	
  1880	
  1881	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1882	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1883	    offenders = []
  1884	    for phrase in _ENFORCEMENT_VOCAB:
  1885	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1886	            offenders.append(
  1887	                "%r outside the declared zones: ...%s..."
  1888	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1889	            )
  1890	    return offenders
  1891	
  1892	
  1893	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1894	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1895	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1896	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1897	    even standing somewhere that can be checked?" — the question the file
  1898	    failed on the day it shipped."""
  1899	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1900	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1901	
  1902	    # The sweep must be looking at the right text: intro present, table absent.
  1903	    swept = _prose_outside_the_declared_zones(doc)
  1904	    assert "Integrity contract for the" in swept, (
  1905	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1906	        "the prose it exists to watch"
  1907	    )
  1908	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1909	    assert len(swept) > len(doc) // 3, (
  1910	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1911	        % (len(swept), len(doc))
  1912	    )
  1913	
  1914	    # t9 P2 positive control: a table OUTSIDE `## Contract` carrying an
  1915	    # enforcement claim must NOT be exempted by the sweep — the old blanket
  1916	    # `startswith("|")` filter stripped every table anywhere.
  1917	    outside_table = (
  1918	        doc
  1919	        + "\n## Some new section\n\n"
  1920	        + "| per-tarball SHA-256 manifest | enforced today; recorded by "
  1921	        + "npm-publish.yml |\n"
  1922	    )
  1923	    assert _enforcement_vocabulary_offenders(outside_table), (
  1924	        "an enforcement claim inside a table OUTSIDE ## Contract passed the "
  1925	        "generic sweep — the exemption must be Contract-section-only"
  1926	    )
  1927	
  1928	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1929	    # merits. The order matters and was learned the hard way — the controls
  1930	    # below build their fixtures FROM the live file, so when the file itself
  1931	    # carries a planted defect they fail first and the red names the fixture
  1932	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1933	    # always reds on the assertion that describes what is actually wrong.
  1934	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1935	    offenders = _enforcement_vocabulary_offenders(doc)
  1936	    assert not offenders, (
  1937	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1938	        "§Not yet automated. Move the claim into a table row (with a step the "
  1939	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1940	    )
  1941	
  1942	    # (b) positive control: the historical claim restored to the introduction.
  1943	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1944	    # today's wording — an anchor on current prose stops matching the moment
  1945	    # that prose is edited, and then the control fails for the wrong reason.
  1946	    title, _, rest = doc.partition("\n")
  1947	    claim = (
  1948	        "The integrity controls enforced today are: (1) the `install.sh` "
  1949	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1950	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1951	    )
  1952	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1953	    assert relapse != doc, "relapse fixture did not patch the doc"
  1954	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1955	    assert any("enforced today" in o for o in relapse_offenders), (
  1956	        "an enforcement claim in the introduction went unseen: %s"
  1957	        % relapse_offenders
  1958	    )
  1959	    assert any("recorded by" in o for o in relapse_offenders), (
  1960	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1961	    )
  1962	
  1963	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1964	    # offender. This is the predicate as documented, not a global grep — that
  1965	    # section is where honest prose about absence has to be able to use these
  1966	    # words. Its own honesty is held by the restatement test above; a claim
  1967	    # parked there is the residual gap, and it is a narrow, watched one.
  1968	    marker = "## Not yet automated"
  1969	    assert marker in doc
  1970	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1971	    assert not _enforcement_vocabulary_offenders(parked), (
  1972	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1973	        "a declared zone"
  1974	    )
