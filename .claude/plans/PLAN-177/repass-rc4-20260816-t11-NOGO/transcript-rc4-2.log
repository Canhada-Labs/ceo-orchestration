  1850	def _normalize_prose(text: str) -> str:
  1851	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1852	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1853	    normalize the same way, so a claim cannot hide behind formatting."""
  1854	    text = text.lower()
  1855	    for ch in ("*", "`", "_"):
  1856	        text = text.replace(ch, "")
  1857	    text = text.replace("-", " ")
  1858	    return re.sub(r"\s+", " ", text)
  1859	
  1860	
  1861	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1862	    """Everything that is neither a `## Contract` table row nor §Not yet
  1863	    automated — the surfaces where a mechanism claim answers to nothing.
  1864	
  1865	    Re-pass rc.4 t9 P2: strip table rows ONLY inside `## Contract` — the
  1866	    blanket startswith("|") filter exempted EVERY table anywhere in the
  1867	    doc, so a new table outside the Contract section could carry an
  1868	    enforcement claim past this sweep unchecked.
  1869	    """
  1870	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1871	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", body)
  1872	    if m:
  1873	        stripped_section = "\n".join(
  1874	            line for line in m.group(0).splitlines()
  1875	            if not line.strip().startswith("|")
  1876	        )
  1877	        body = body[: m.start()] + stripped_section + body[m.end():]
  1878	    return body
  1879	
  1880	
  1881	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1882	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1883	    offenders = []
  1884	    for phrase in _ENFORCEMENT_VOCAB:
  1885	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1886	            offenders.append(
  1887	                "%r outside the declared zones: ...%s..."
  1888	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1889	            )
  1890	    return offenders
  1891	
