   394	      - name: Validate install.sh self-SHA mechanism (P0-15, PLAN-045)
   395	        # PLAN-045 F-15R2-01 / Session 41: end-to-end validation that
   396	        # the install.sh self-SHA verification works. We (a) confirm the
   397	        # placeholder is still present (source checkout state), (b) compute
   398	        # the expected sha, (c) substitute it into a temp copy, (d) run the
   399	        # temp copy — self-verify passes → rc=1 (usage exit, not rc=5).
   400	        run: |
   401	          set -euo pipefail
   402	          FILE="scripts/install.sh"
   403	          # (a) Placeholder must be present in source tree.
   404	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   405	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   406	            echo "::error::Source install.sh trailer has drifted from placeholder."
   407	            echo "got: $TRAILER_LINE"
   408	            exit 1
   409	          fi
   410	          # (b) + (c) stage a populated copy in a scratch dir.
   411	          SCRATCH="$(mktemp -d -t ceo-selfsha-XXXXXX)"
   412	          cp "$FILE" "$SCRATCH/install.sh"
   413	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$SCRATCH/install.sh" "$SCRATCH/install.sh" | sha256sum | awk '{print $1}')
   414	          awk -v hash="$HASH" '
   415	            NR == FNR { total = NR; next }
   416	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   417	            { print }
   418	          ' "$SCRATCH/install.sh" "$SCRATCH/install.sh" > "$SCRATCH/install.sh.new"
   419	          mv "$SCRATCH/install.sh.new" "$SCRATCH/install.sh"
   420	          chmod +x "$SCRATCH/install.sh"
   421	          # (d) Run the populated copy with no args; must exit rc=1
   422	          #     (usage), NOT rc=5 (self-SHA mismatch).
   423	          set +e
   424	          bash "$SCRATCH/install.sh" > /dev/null 2>"$SCRATCH/err"
   425	          RC=$?
   426	          set -e
   427	          if [ "$RC" -eq 5 ]; then
   428	            echo "::error::populated install.sh still rc=5 — self-SHA mechanism broken"
   429	            cat "$SCRATCH/err"
   430	            exit 1
     1	#!/usr/bin/env python3
     2	# ============================================================================
     3	# _release_tag_guard.py — the two fail-closed asserts `tag()` runs before it
     4	# asks the Owner's key to sign anything.
     5	#
     6	# WHY THIS EXISTS (v1.3.0-rc.1 re-pass, F2 + the F1/F2 composite risk):
     7	#
     8	#   (a) ANCESTRY. Nothing verified that the commit being tagged is on main.
     9	#       `bump` could create a local commit AFTER the preflight proved CI green
    10	#       for a different SHA, and `tag()` would sign that never-tested tree.
    11	#       Two DISTINCT failures, never merged into one message: "could not talk
    12	#       to origin" (network/offline — has a named escape hatch) and "HEAD is
    13	#       not an ancestor of origin/main" (a real governance stop). The fetch and
    14	#       the merge-base are SEPARATE statements: a failed fetch followed by a
    15	#       merge-base against a stale ref is a FALSE APPROVAL.
    16	#
    17	#   (b) RESTRICTED DELTA. The invariant is "nothing landed after what the
    18	#       re-pass reviewed, other than the verdict itself". The anchor is the
    19	#       REVIEWED PARENT recorded in the signed verdict — one rule for RC and
    20	#       GA. Anchoring on "the last RC" is wrong in both directions: for the GA
    21	#       it coincides by accident, and for an rc.2 it would reject the very
    22	#       W0/W1 fixes the re-pass just reviewed.
    23	#
    24	#       The allowlist is TAG-SPECIFIC and CLOSED:
    25	#         * never the wildcard `pair-rail-verdict-*.md` — that would let a
    26	#           historical verdict or the template be touched and still pass;
    27	#         * never `repass-<N>/**` — any file dropped into that directory after
    28	#           the review would pass the guard, and the pair-rail step-15 replay
    29	#           does not cover plan artifacts;
    30	#         * so the set closes by NAME (exact paths, set equality against the
    31	#           re-pass MANIFEST) *and* by CONTENT (the verdict pins the sha256 of
    32	#           MANIFEST.sha256, and the manifest itself is verified with
    33	#           `shasum -a 256 -c`);
    34	#         * and a plan path OUTSIDE the manifest directory — where no sha256
    35	#           pins content — is admitted ONLY as `verdict-fields-<TAG>.md` with
    36	#           the literal target tag, at its ONE canonical path (directly in
    37	#           the plan directory containing the manifest dir): the plan file
    38	#           itself, immutable repass history, another tag's verdict-fields,
    39	#           and same-basename look-alikes in any other directory all close by
    40	#           name alone and would carry a post-review edit onto the tag;
    41	#         * the reviewed parent itself must be an ANCESTOR of HEAD —
    42	#           `cat-file -e` proves existence, not lineage, and a fabricated
    43	#           `commit-tree` anchor makes the whole delta trivially clean.
    44	#
    45	# THE LOCAL ASSERT IS NOT ENOUGH. A tag signed by hand skips this driver
    46	# entirely, and the pair-rail step 15 recomputes inputs_hash only over the
    47	# manifest — which deliberately EXCLUDES the bump surfaces. The same assert
    48	# therefore goes server-side into `.github/workflows/release.yml` in PLAN-166
    49	# W1 (release.yml is canonical; it is changed under the GPG ceremony, not
    50	# here). Keep the two implementations in sync: this file is the reference.
    51	#
    52	# Exit codes are distinct so the failure MODE is testable, not just the
    53	# failure:
    54	#   2 usage   3 fetch failed   4 not-ancestor   5 remote ref unusable
    55	#   6 delta outside allowlist  7 manifest sha pin mismatch
    56	#   8 manifest content mismatch (shasum -c)  9 manifest/allowlist set mismatch
    57	#  10 verdict unusable (missing file/field, wildcard, wrong tag, bad parent)
    58	#  11 the assert would be VACUOUS (the verdict is not inside the delta it
    59	#     anchors — e.g. parent_sha == HEAD, which makes the verdict review itself)
    60	#  12 parent_sha is not an ancestor of HEAD (a fabricated/orphan anchor:
    61	#     `cat-file -e` proves existence, not lineage — a `commit-tree` object
    62	#     carrying HEAD's own tree makes diff(parent..HEAD) contain only the
    63	#     verdict while unreviewed work sits on main)
    64	#  13 the verdict DECISION does not authorize a release (NO-GO, absent,
    65	#     empty, or an unknown token), OR the block spells a top-level key in a
    66	#     form this reader and the step-15 validator resolve differently.
    67	#     PLAN-177 W0.1 / P1-4: this guard read the tag, the anchor, the
    68	#     allowlist and the manifest of a verdict but never its DECISION, so a
    69	#     cross-model NO-GO still cut a tag. PLAN-177 t2 / P1-a: it then read
    70	#     the DECISION with a grammar the other rail did not share, so
    71	#     `verdict : NO-GO` + `verdict: GO` cut a tag on a NO-GO.
    72	# ============================================================================
    73	"""Ancestry + restricted-delta asserts for the release tag phase."""
    74	
    75	from __future__ import annotations
    76	
    77	import argparse
    78	import hashlib
    79	import os
    80	import re
    81	import subprocess
    82	import sys
    83	from typing import Dict, List, Optional, Sequence, Set, Tuple
    84	
    85	E_USAGE = 2
    86	E_FETCH = 3
    87	E_NOT_ANCESTOR = 4
    88	E_REMOTE_REF = 5
    89	E_DELTA = 6
    90	E_MANIFEST_PIN = 7
    91	E_MANIFEST_CONTENT = 8
    92	E_MANIFEST_SET = 9
    93	E_VERDICT = 10
    94	E_VACUOUS = 11
    95	E_PARENT_NOT_ANCESTOR = 12
    96	E_DECISION = 13
    97	
    98	# PLAN-177 W0.1 (P1-4). Spelled out here rather than imported from
    99	# .github/scripts/validate-pair-rail-verdict.py: the two rails are separate
   100	# processes on separate machines and neither may become a dependency of the
   101	# other. The set itself comes from
   102	# .claude/governance/pair-rail-verdict-template.md. EXACT equality, no case
   103	# folding and no prefix/substring rule -- NO-GO contains GO.
   104	ACCEPTED_DECISIONS = ("GO", "GO-WITH-CONDITIONS")
   105	
   106	HEX40 = re.compile(r"\A[0-9a-f]{40}\Z")
   107	
   108	# t9 P1 (byte-for-byte twin of the step-15 validator): ONE strict
   109	# extractor for the signed yaml block.
   110	#   * the artifact must contain EXACTLY ONE occurrence of the literal
   111	#     three-backtick yaml opener anywhere — a second occurrence (even
   112	#     quoted inside a four-backtick block) makes the authoritative block
   113	#     ambiguous, so the artifact is rejected fail-closed;
   114	#   * the opener must sit at line start, column 0, closed by a
   115	#     line-start fence — an unanchored search let a quoted GO envelope
   116	#     inside a four-backtick block shadow the real NO-GO one;
   117	#   * the body must be free of every line separator except LF and every
   118	#     control char except TAB: str.splitlines() also splits on
   119	#     U+000B/000C/001C-001E/0085/2028/2029, so a value glued to
   120	#     <U+000B>#NO-GO parsed as the exact token GO on both rails.
   121	# Returns the block body, or None when the artifact is rejected.
   122	_FORBIDDEN_CTRL_RE = re.compile(
   123	    "[\u0000-\u0008\u000b-\u001f\u007f\u0085\u2028\u2029]"
   124	)
   125	
   126	
   127	def _extract_single_yaml_block(text):
   128	    if text.count("```yaml") != 1:
   129	        return None
   130	    m = re.search(r"(?m)^```yaml[ \t]*\n(.*?)^```", text, re.DOTALL)
   131	    if not m:
   132	        return None
   133	    body = m.group(1)
   134	    if _FORBIDDEN_CTRL_RE.search(body):
   135	        return None
   136	    return body
   137	
   138	HEX64 = re.compile(r"\A[0-9a-f]{64}\Z")
   139	GLOB_CHARS = "*?["
   140	VERDICT_PREFIX = ".claude/governance/pair-rail-verdict-"
   141	# The allowlist is EXHAUSTIVE, not merely closed: the verdict for this tag plus
   142	# plan-side evidence (the `verdict-fields-<TAG>` pair and the re-pass artifact
   143	# directory both live under `.claude/plans/`). Anything else — a version site, a
   144	# workflow, any code path — would re-open the very hole the delta assert exists
   145	# to close: a post-review bump commit riding in on the tag.
   146	EVIDENCE_PREFIX = ".claude/plans/"
   147	
   148	
   149	def _fail(code: int, msg: str) -> int:
   150	    # Flush the ok-lines first: an operator reading a release failure must see
   151	    # WHICH checks passed before the one that stopped it, in order.
   152	    sys.stdout.flush()
   153	    print("FAIL: %s" % msg, file=sys.stderr)
   154	    sys.stderr.flush()
   155	    return code
   156	
   157	
   158	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   159	    proc = subprocess.run(
   160	        ["git"] + list(args),
   161	        cwd=repo,
   162	        stdout=subprocess.PIPE,
   163	        stderr=subprocess.PIPE,
   164	        universal_newlines=True,
   165	    )
   166	    return proc.returncode, proc.stdout, proc.stderr
   167	
   168	
   169	# ---------------------------------------------------------------------------
   170	# (a) ancestry
   171	# ---------------------------------------------------------------------------
   172	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   173	    ref = "%s/%s" % (remote, branch)
   174	    if offline_ack:
   175	        print(
   176	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   177	            "merge-base below is judged against a possibly STALE %s" % ref
   178	        )
   179	    else:
   180	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   181	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   182	        # stale ref reads as approval.
   183	        if rc != 0:
   184	            return _fail(
   185	                E_FETCH,
   186	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   187	                "      This is NOT a verdict on the commit — the check did not "
   188	                "run.\n"
   189	                "      Fix the network/remote and re-run, or, if you are "
   190	                "deliberately\n"
   191	                "      offline and accept judging against the last-known ref, "
   192	                "re-run\n"
   193	                "      with --offline-ack (it is recorded in the output).\n"
   194	                "      git said: %s" % (remote, branch, rc, err.strip()),
   195	            )
   196	        print("  ok   fetched %s" % ref)
   197	
   198	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   199	    if rc != 0 or not out.strip():
   200	        return _fail(
   201	            E_REMOTE_REF,
   202	            "no usable ref %s in this repo — cannot judge ancestry "
   203	            "(git said: %s)" % (ref, err.strip()),
   204	        )
   205	    remote_sha = out.strip()
   206	
   207	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   208	    if rc == 0:
   209	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   210	        return 0
   211	    if rc == 1:
   212	        return _fail(
   213	            E_NOT_ANCESTOR,
   214	            "HEAD is not an ancestor of %s — push main and re-run the "
   215	            "preflight.\n"
   216	            "      A tag on an unpushed commit points at a tree CI never "
   217	            "saw; the\n"
   218	            "      preflight's green verdict was about a different SHA."
   219	            % ref,
   220	        )
   221	    return _fail(
   222	        E_REMOTE_REF,
   223	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   224	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   225	    )
   226	
