  1043	    )
  1044	    git(repo, env, "add", "-A")
  1045	    git(repo, env, "commit", "-q", "-m", "allowlist a version site")
  1046	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
  1047	    assert proc.returncode == tag_guard.E_VERDICT, proc.stdout + proc.stderr
  1048	    assert "EXHAUSTIVE" in proc.stderr
  1049	    assert "'VERSION'" in proc.stderr
