  2245	# without filling the field in.
  2246	_REFUSED_DECISIONS = [
  2247	    ["NO-GO"],
  2248	    [],
  2249	    ["MAYBE"],
  2250	    [""],
  2251	    ["go"],
  2252	    ["no-go"],
