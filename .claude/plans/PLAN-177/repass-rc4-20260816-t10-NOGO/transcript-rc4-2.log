   336	def parse_semver(s: str) -> Tuple[int, int, int]:
   337	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   338	    if not m:
   339	        raise ValueError(f"unparseable semver: {s!r}")
   340	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   341	
