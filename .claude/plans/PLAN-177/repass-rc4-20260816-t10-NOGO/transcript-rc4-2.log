   916	_claude_dir_gitignore_body() {
   917	  # Paths are anchored with a leading slash so they bind to .claude/ ONLY and
   918	  # cannot match a same-named path deeper in an adopter tree.
   919	  printf '%s\n' \
   920	    "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9)." \
   921	    "#" \
   922	    "# Per-machine posture + runtime state that must never reach VCS:" \
   923	    "#   state/             runtime state as a whole (PLAN-163 T3.1)" \
   924	    "#   settings.local.json  permission overlay deciding the NEXT session's" \
   925	    "#                        posture (PLAN-165)" \
   926	    "#" \
   927	    "# The root .gitignore carries the same exclusions for adopters who track" \
   928	    "# this tree from the repository root. This file additionally covers the" \
   929	    "# --ceremony user install, which never writes outside .claude/ and so" \
   930	    "# never received them." \
   931	    "#" \
   932	    "# Adopter-owned once created: install and upgrade never REPLACE this" \
   933	    "# file — adopter bytes are preserved; missing mandatory framework" \
   934	    "# security entries may be APPENDED (additively reasserted) on upgrade." \
   935	    "/state/" \
   936	    "/settings.local.json"
   937	}
   938	
   939	_apply_claude_dir_gitignore() {
   940	  # $1 = the adopter .claude directory.
   941	  # Create when absent; when PRESENT, append only the entries that are
   942	  # missing, per line, preserving every adopter byte (re-pass rc.4 t1
   943	  # P1-b: an adopter with a pre-existing .claude/.gitignore -- e.g.
   944	  # /cache/ only -- never received /state/ nor /settings.local.json,
   945	  # so night-mode state stayed commit-eligible under --ceremony user;
   946	  # create-if-missing alone proved the clean-target case only). Same
   947	  # grep -Fxq per-entry predicate as the root blocks: the file stays
   948	  # adopter-owned, nothing is rewritten, a deliberate edit to OUR
   949	  # comment lines is never repaired.
   950	  _cdg_dir="$1"
   951	  _cdg_file="$_cdg_dir/.gitignore"
   952	  # Re-pass rc.4 t2 (P1): NEVER follow a symlink here. A .claude/.gitignore
   953	  # symlinked to another writable file would receive framework appends at
   954	  # the EXTERNAL target; a dangling symlink passes `[ ! -e ]` and the
   955	  # redirect would CREATE its target. -L catches both, before any read.
   956	  if [ -L "$_cdg_file" ]; then
   957	    echo "    ERROR: .claude/.gitignore is a symlink — refusing to read or write through it (preserve/replace it manually)" >&2
   958	    return 1
   959	  fi
   960	  if [ ! -e "$_cdg_file" ]; then
   961	    [ -d "$_cdg_dir" ] || mkdir -p "$_cdg_dir"
   962	    _claude_dir_gitignore_body > "$_cdg_file"
   963	    echo "    CREATED: .claude/.gitignore"
   964	    return 0
   965	  fi
   966	  if [ ! -f "$_cdg_file" ]; then
   967	    echo "    ERROR: .claude/.gitignore exists but is not a regular file" >&2
   968	    return 1
   969	  fi
   970	  _cdg_added=0
   971	  for _cdg_entry in "/state/" "/settings.local.json"; do
   972	    if grep -Fxq "$_cdg_entry" "$_cdg_file"; then
   973	      continue
   974	    fi
   975	    {
   976	      echo ""
   977	      echo "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9): per-machine"
   978	      echo "# posture/runtime state (never commit)."
   979	      printf '%s\n' "$_cdg_entry"
   980	    } >> "$_cdg_file"
   981	    _cdg_added=1
   982	  done
   983	  # t8 P1: presence pass done — now assert EFFECTIVENESS per entry
   984	  # (probes are repo-relative; the repo root is the parent of .claude/).
   985	  _cdg_repo="$( dirname "$_cdg_dir" )"
   986	  _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
   987	    "/state/" ".claude/state/__ceo_ignore_probe__"
   988	  _gitignore_reassert_effective "$_cdg_repo" "$_cdg_file" \
   989	    "/settings.local.json" ".claude/settings.local.json"
   990	  if [ "$_cdg_added" = "1" ]; then
   991	    echo "    APPENDED: missing posture entries into existing .claude/.gitignore"
   992	  else
   993	    echo "    EXISTS: .claude/.gitignore already carries both entries"
   994	  fi
   995	  return 0
   996	}
   997	
   998	_preview_claude_dir_gitignore() {
   999	  # Dry-run twin of _apply_claude_dir_gitignore (re-pass rc.4 t2 P1):
  1000	  # SAME per-entry predicate, ZERO writes. Reports the action the real
  1001	  # run would take — including would-APPEND on a seeded adopter file.
  1002	  _pcg_file="$1/.gitignore"
  1003	  if [ -L "$_pcg_file" ]; then
  1004	    echo "    (dry-run) ERROR: .claude/.gitignore is a symlink — real run would REFUSE" >&2
  1005	    return 1
  1006	  fi
  1007	  if [ ! -e "$_pcg_file" ]; then
  1008	    echo "    (dry-run) would CREATE: .claude/.gitignore"
  1009	    return 0
  1010	  fi
  1011	  if [ ! -f "$_pcg_file" ]; then
  1012	    echo "    (dry-run) ERROR: .claude/.gitignore exists but is not a regular file" >&2
  1013	    return 1
  1014	  fi
  1015	  _pcg_missing=""
  1016	  for _pcg_entry in "/state/" "/settings.local.json"; do
  1017	    grep -Fxq "$_pcg_entry" "$_pcg_file" || _pcg_missing="$_pcg_missing $_pcg_entry"
  1018	  done
  1019	  # t9 P1: the real run now RE-ASSERTS a textually-present-but-negated
  1020	  # entry, so a "would PRESERVE" preview over that state is a lie. Run the
  1021	  # SAME read-only `git check-ignore` probes and report would-RE-ASSERT.
  1022	  _pcg_repo="$( dirname "$1" )"
  1023	  _pcg_reassert=""
  1024	  if git -C "$_pcg_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  1025	    if ! git -C "$_pcg_repo" check-ignore -q -- \
  1026	         ".claude/state/__ceo_ignore_probe__" 2>/dev/null; then
  1027	      case "$_pcg_missing" in
  1028	        *" /state/"*) : ;;  # already reported as would-APPEND
  1029	        *) _pcg_reassert="$_pcg_reassert /state/" ;;
  1030	      esac
  1031	    fi
  1032	    if ! git -C "$_pcg_repo" check-ignore -q -- \
  1033	         ".claude/settings.local.json" 2>/dev/null; then
  1034	      case "$_pcg_missing" in
  1035	        *" /settings.local.json"*) : ;;
  1036	        *) _pcg_reassert="$_pcg_reassert /settings.local.json" ;;
  1037	      esac
  1038	    fi
  1039	  fi
  1040	  if [ -n "$_pcg_missing" ]; then
  1041	    echo "    (dry-run) would APPEND into existing .claude/.gitignore:$_pcg_missing"
  1042	  fi
  1043	  if [ -n "$_pcg_reassert" ]; then
  1044	    echo "    (dry-run) would RE-ASSERT (present but negated by a later rule):$_pcg_reassert"
  1045	  fi
  1046	  if [ -z "$_pcg_missing" ] && [ -z "$_pcg_reassert" ]; then
  1047	    echo "    (dry-run) EXISTS: .claude/.gitignore already carries both entries (would PRESERVE)"
  1048	  fi
  1049	  return 0
  1050	}
