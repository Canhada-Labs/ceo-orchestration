   343	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   344	    try:
   345	        v = parse_semver(version)
   346	        lo = parse_semver(min_v)
   347	        hi = parse_semver(max_v)
   348	        return lo <= v < hi
   349	    except ValueError:
   350	        return False
