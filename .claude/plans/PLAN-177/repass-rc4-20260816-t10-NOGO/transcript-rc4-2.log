   175	arm_night_mode_artifacts() {  # $1 = target — simulate, never arm (see header)
   176	  mkdir -p "$1/.claude/state"
   177	  printf '%s\n' '{"armed": true, "plan": "PLAN-177 test fixture"}' > "$1/$MARKER_REL"
   178	  printf '%s\n' '{"permissions": {"defaultMode": "acceptEdits"}}' > "$1/$OVERLAY_REL"
   179	}
   180	
   181	# Lines git reports for the two artifacts.
   182	#
   183	# `-uall` is LOAD-BEARING, not a flourish. Plain `git status --porcelain` in a
   184	# repo where nothing is committed collapses the whole tree to a single
   185	# `?? .claude/` line, so a matcher looking for `.claude/state/...` finds
   186	# nothing and reports "clean" no matter what the ignores do. That vacuous shape
   187	# is exactly what this test's own positive control caught on its first run, and
   188	# it is why the scenarios commit a baseline first: a real adopter has the
   189	# framework committed before ever running `/night-mode on`.
   190	leaked() {  # $1 = target
   220	  echo "$tracked" | sed 's/^/        /' >&2
   221	}
   222	
   223	check_scenario() {  # $1 = label, $2 = target
   224	  local label="$1" t="$2" out n rule_m rule_o
   225	  assert_no_external_ignores "$t"
   226	  commit_baseline "$t"
   227	  arm_night_mode_artifacts "$t"
   228	
   229	  # Sanity: the artifacts really are on disk. Without this the "clean" verdict
   230	  # could just mean nothing was ever created.
   231	  [ -f "$t/$MARKER_REL" ]  || scaffold "$label: fixture did not create $MARKER_REL"
   232	  [ -f "$t/$OVERLAY_REL" ] || scaffold "$label: fixture did not create $OVERLAY_REL"
   233	
   234	  out="$( leaked "$t" )"
   235	  if [ -n "$out" ]; then
   236	    fail "$label: night-mode artifacts are VISIBLE to git:"
   237	    echo "$out" | sed 's/^/        /' >&2
   238	  else
   239	    say "  $label: clean — git -uall sees no night-mode artifacts"
   240	  fi
   241	
   242	  # Attribution: a framework-delivered .gitignore must be the rule doing it.
   243	  rule_m="$( ignoring_rule "$t" "$MARKER_REL" )"
   244	  rule_o="$( ignoring_rule "$t" "$OVERLAY_REL" )"
   245	  for _r in "$rule_m" "$rule_o"; do
   246	    case "$_r" in
   247	      .claude/.gitignore:*|.gitignore:*) : ;;
   248	      "") fail "$label: no ignore rule matches one of the artifacts: '$_r'" ;;
   249	      *)  fail "$label: ignored by an UNEXPECTED source (not a framework-delivered .gitignore): $_r" ;;
   250	    esac
   251	  done
   252	  [ -n "$rule_m" ] && say "  $label: rule -> ${rule_m%%	*}"
   253	
   254	  # --- inline positive control ---------------------------------------------
   255	  strip_delivered_ignores "$t"
   256	  out="$( leaked "$t" )"
   257	  n="$( printf '%s' "$out" | grep -c . || true )"
   258	  # BOTH artifacts must surface. "At least one" would pass while some other
   259	  # ignore source still hid the other one -- which is exactly what happened on
   260	  # the first run of this test, before the external sources were neutralised.
   261	  if [ "$n" -ne 2 ]; then
   262	    fail "$label: CONTROL FIRED PARTIALLY OR NOT AT ALL — after removing the"
   263	    fail "       delivered ignores git should report BOTH artifacts, got $n:"
   264	    [ -n "$out" ] && echo "$out" | sed 's/^/        /' >&2
   265	    fail "       (something ELSE is hiding a path, or the matcher is blind)"
   266	  else
   267	    say "  $label: control fired — without the ignores git reports both artifacts"
   268	  fi
   269	}
   270	
   271	# Count the posture entries in the ROOT .gitignore.
   272	#
   273	# WHY THIS EXISTS SEPARATELY from the git-status assertion: `.claude/.gitignore`
   274	# alone is enough to make every scenario below report "clean", so an upgrade
   275	# whose ROOT delivery silently did nothing would still pass. `git check-ignore`
   285	  [ -f "$1/.gitignore" ] || { echo 0; return 0; }
   286	  n="$( grep -c -x -e '.claude/state/' -e '.claude/settings.local.json' "$1/.gitignore" 2>/dev/null )" || n=0
   287	  [ -n "$n" ] || n=0
   288	  echo "$n"
   289	}
