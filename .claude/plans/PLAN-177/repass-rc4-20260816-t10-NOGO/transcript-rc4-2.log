   314	# The mirror assertion: in `user` ceremony NEITHER route touches the root, so
   315	# the count must stay 0. A cure that delivered here would break the WS4
   316	# invariant install.sh has always honoured — and the parity gate would only
   317	# see it as a divergence, never as a rule violation.
   318	_B_ROOT="$( root_posture_count "$TB" )"
   319	if [ "$_B_ROOT" -eq 0 ]; then
