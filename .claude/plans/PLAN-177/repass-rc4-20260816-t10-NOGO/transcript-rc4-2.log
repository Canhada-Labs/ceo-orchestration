   321	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   322	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   323	    if not pin_file.exists():
   324	        return None, None
   325	    for line in pin_file.read_text().splitlines():
   326	        line = line.split("#", 1)[0].strip()
   327	        if not line:
   328	            continue
   329	        # parse `>=X.Y.Z,<A.B.C` shape
   330	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   331	        if m:
   332	            return m.group(1), m.group(2)
   333	    return None, None
