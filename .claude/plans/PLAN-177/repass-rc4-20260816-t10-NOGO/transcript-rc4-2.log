  1096	def test_guard_selects_the_yaml_block_like_the_step15_reader(synth):
  1097	    """Re-pass P2 (reader parity): the step-15 validator selects the FIRST
  1098	    ```yaml fence specifically (validate-pair-rail-verdict.py); the guard used
  1099	    to enter the first fence of ANY language, so a verdict with a leading
  1100	    non-yaml fence (a quoted transcript, say) parsed as EMPTY here while the
  1101	    validator read it fine — two readers of the same signed file disagreeing,
  1102	    fail-closed direction but still a disagreement."""
  1103	    repo, env = synth["repo"], synth["env"]
