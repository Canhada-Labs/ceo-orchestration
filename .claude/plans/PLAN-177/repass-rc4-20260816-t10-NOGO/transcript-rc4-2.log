  1069	def test_delta_rejects_plan_paths_outside_the_manifest_dir(synth, entry):
  1070	    """Re-pass P2: `.claude/plans/` entries OUTSIDE the manifest directory
  1071	    used to close by NAME alone — no content pin, no manifest coverage, no
  1072	    tag specificity — while the same guard rejected `VERSION` as
  1073	    non-EXHAUSTIVE. Only `verdict-fields-<THIS TAG>.md` at its CANONICAL
  1074	    path (directly inside the plan directory holding the manifest dir) may
  1075	    live outside the content-pinned manifest directory; everything else —
  1076	    including same-basename look-alikes elsewhere — must be IN it."""
  1077	    arm_verdict(synth, "v1.3.0-rc.2", extra_allow=[entry])
  1078	    proc = guard(synth, "delta", "--repo", str(synth["repo"]), "--tag", "v1.3.0-rc.2")
  1079	    assert proc.returncode == tag_guard.E_VERDICT, proc.stdout + proc.stderr
  1080	    assert "verdict-fields" in proc.stderr, proc.stderr
