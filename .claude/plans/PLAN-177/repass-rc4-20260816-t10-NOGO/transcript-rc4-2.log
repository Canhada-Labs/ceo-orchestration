   864	def test_delta_blocks_a_fabricated_parent_outside_head_history(synth):
   865	    """W0 re-pass r2 P1: `cat-file -e` proves the anchor EXISTS, not that it
   866	    is in the history this tag signs. A fabricated commit over HEAD's own
   867	    tree (`git commit-tree`, parented off an older commit, on no branch)
   868	    makes diff(parent..HEAD) contain ONLY the verdict + evidence while an
   869	    unreviewed file sits on main — every downstream check (allowlist,
   870	    manifest pin, set equality, vacuity) then passes and the guard prints
   871	    "all inside the verdict's closed allowlist" over an unreviewed tree."""
   872	    repo, env = synth["repo"], synth["env"]
   873	    h0 = git(repo, env, "rev-parse", "HEAD")
   874	
   875	    # unreviewed work lands on main
   876	    (repo / "unreviewed.py").write_text("print('never reviewed')\n", encoding="utf-8")
   877	    git(repo, env, "add", "unreviewed.py")
   878	    git(repo, env, "commit", "-q", "-m", "unreviewed change")
   879	    m2_tree = git(repo, env, "rev-parse", "HEAD^{tree}")
   880	
   881	    # fabricated anchor: HEAD's exact tree, parented off h0, on NO branch —
   882	    # it exists in the object store but HEAD does not descend from it
   883	    orphan = git(repo, env, "commit-tree", m2_tree, "-p", h0, "-m", "fabricated anchor")
   884	    not_anc = run(["git", "merge-base", "--is-ancestor", orphan, "HEAD"], repo, env)
   885	    assert not_anc.returncode == 1, "fixture broke: orphan IS an ancestor"
   886	
   887	    ev = make_repass(repo, "repass-r2", {"verdict-r1.txt": "GO\n"})
   888	    verdict_rel = ".claude/governance/pair-rail-verdict-v1.3.0-rc.2.md"
   889	    write_verdict(
   890	        repo,
   891	        "v1.3.0-rc.2",
   892	        orphan,
   893	        [verdict_rel, ev["manifest_rel"]] + ev["artifact_rels"],
   894	        ev["manifest_rel"],
   895	        ev["manifest_sha"],
   896	    )
   897	    git(repo, env, "add", "-A")
   898	    git(repo, env, "commit", "-q", "-m", "verdict anchored on the fabricated commit")
   899	
   900	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
   901	    assert proc.returncode == tag_guard.E_PARENT_NOT_ANCESTOR, (
   902	        proc.stdout + proc.stderr
   903	    )
   904	    assert "ancestor" in proc.stderr
   905	    # and it is a DISTINCT mode from both "bad verdict" and "delta outside"
   906	    assert tag_guard.E_PARENT_NOT_ANCESTOR != tag_guard.E_VERDICT
   907	    assert tag_guard.E_PARENT_NOT_ANCESTOR != tag_guard.E_DELTA
