   161	do_install() {  # $1 = source dir, $2 = target, $3 = ceremony
   162	  CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   163	    bash "$1/scripts/install.sh" "$2" --ceremony "$3" --profile "$PROFILE" \
   164	    > "$2.install.log" 2>&1 \
   165	    || scaffold "install.sh ($3, source=$1) exited non-zero — see $2.install.log"
   166	}
