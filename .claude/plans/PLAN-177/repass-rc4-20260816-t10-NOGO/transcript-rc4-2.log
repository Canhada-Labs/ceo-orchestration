   258	def parse_verdict_text(text: str) -> Dict[str, Any]:
   259	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   260	    yaml_body = _extract_single_yaml_block(text)
   261	    if yaml_body is None:
   262	        raise ValueError(
   263	            "verdict yaml block rejected: absent, ambiguous fence, or "
   264	            "forbidden control/separator bytes"
   265	        )
   266	    # Inline minimal YAML parse (stdlib only)
   267	    out: Dict[str, Any] = {}
   268	    current_key: Optional[str] = None
   269	    for raw in yaml_body.split("\n"):
   270	        line = _strip_comment(raw)
   271	        if not line.strip():
   272	            continue
   273	        if line[0] not in (" ", "\t"):
   274	            if ":" in line:
   275	                k, _, v = line.partition(":")
   276	                # ASCII-only value trim (t5 P1): a Unicode strip() would
   277	                # normalize `GO<U+00A0>` into the exact authorizing token.
   278	                v = v.strip(" \t")
   279	                if v:
   280	                    out[k.strip(" \t")] = v
   281	                else:
   282	                    out[k.strip(" \t")] = {}
   283	                    current_key = k.strip(" \t")
   284	        elif current_key and ":" in line:
   285	            sub_k, _, sub_v = line.partition(":")
   286	            if isinstance(out[current_key], dict):
   287	                out[current_key][sub_k.strip(" \t")] = sub_v.strip(" \t")
   288	    return out
