   149	def _fail(code: int, msg: str) -> int:
   150	    # Flush the ok-lines first: an operator reading a release failure must see
   151	    # WHICH checks passed before the one that stopped it, in order.
   152	    sys.stdout.flush()
   153	    print("FAIL: %s" % msg, file=sys.stderr)
   154	    sys.stderr.flush()
   155	    return code
