   369	def _count_top_level_key(text: str, key: str) -> int:
   370	    """How many times `key:` is declared at the top level of the block.
   371	
   372	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   373	    step-15 reader: a second `verdict:` silently overrides the first, so
   374	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   375	    block selection and same comment rule as the reader, or the count
   376	    would be about a different text than the parse.
   377	
   378	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   379	    counter does NOT strip the key and the step-15 twin does, so on a
   380	    non-canonical block the two counts differ. delta() checks the shape
   381	    first.
   382	    """
   383	    _body = _extract_single_yaml_block(text)
   384	    if _body is None:
   385	        return 0
   386	    seen = 0
   387	    for raw in _body.split("\n"):
   388	        line = _strip_yaml_comment(raw)
   389	        if not line.strip() or line[0] in (" ", "\t"):
   390	            continue
   391	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   392	        if m and m.group(1) == key:
   393	            seen += 1
   394	    return seen
