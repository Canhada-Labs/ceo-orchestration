   231	def _parse_verdict(text: str) -> Dict[str, object]:
   232	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   233	
   234	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   235	    of `  - item` list entries, and ignores everything else. Anything it cannot
   236	    read is absent, and every consumer below treats absent as fail-closed.
   237	
   238	    Parity with the step-15 reader (`.github/scripts/
   239	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   240	    scope: block selection (the regex below is the validator's own — the
   241	    first ```yaml fence, not the first fence of any language) and inline
   242	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   243	    parse_verdict_file reads key:value and sub-dicts and would drop
   244	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   245	    ONE shared reader (this file is the declared reference), never grow a
   246	    third parser of the same signed file.
   247	    """
   248	    fields: Dict[str, object] = {}
   249	    _body = _extract_single_yaml_block(text)
   250	    if _body is None:
   251	        # No/ambiguous/forbidden-bytes block -> no fields -> every
   252	        # consumer below fails closed.
   253	        return fields
   254	    cur_list: Optional[str] = None
   255	    for raw in _body.split("\n"):
   256	        line = _strip_yaml_comment(raw)
   257	        if not line.strip():
   258	            continue
   259	        if line.startswith(("  - ", "- ")) and cur_list:
   260	            item = line.split("-", 1)[1].strip()
   261	            if item:
   262	                fields[cur_list].append(item)  # type: ignore[union-attr]
   263	            continue
   264	        # [ \t]* not \s* (t5 P1): Python \s is Unicode-aware and would
   265	        # swallow a NBSP that must stay attached to the VALUE.
   266	        m = re.match(r"\A([A-Za-z0-9_]+):(?:[ \t]+(.*))?\Z", line)
   267	        if not m:
   268	            continue
   269	        key, val = m.group(1), (m.group(2) or "").strip(" \t")
   270	        if val == "":
   271	            fields[key] = []
   272	            cur_list = key
   273	        else:
   274	            fields[key] = val
   275	            cur_list = None
   276	    return fields
