   158	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   159	    proc = subprocess.run(
   160	        ["git"] + list(args),
   161	        cwd=repo,
   162	        stdout=subprocess.PIPE,
   163	        stderr=subprocess.PIPE,
   164	        universal_newlines=True,
   165	    )
   166	    return proc.returncode, proc.stdout, proc.stderr
