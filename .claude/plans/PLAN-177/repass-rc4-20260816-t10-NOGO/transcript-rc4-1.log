   172	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   173	    ref = "%s/%s" % (remote, branch)
   174	    if offline_ack:
   175	        print(
   176	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   177	            "merge-base below is judged against a possibly STALE %s" % ref
   178	        )
   179	    else:
   180	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   181	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   182	        # stale ref reads as approval.
   183	        if rc != 0:
   184	            return _fail(
   185	                E_FETCH,
   186	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   187	                "      This is NOT a verdict on the commit — the check did not "
   188	                "run.\n"
   189	                "      Fix the network/remote and re-run, or, if you are "
   190	                "deliberately\n"
   191	                "      offline and accept judging against the last-known ref, "
   192	                "re-run\n"
   193	                "      with --offline-ack (it is recorded in the output).\n"
   194	                "      git said: %s" % (remote, branch, rc, err.strip()),
   195	            )
   196	        print("  ok   fetched %s" % ref)
   197	
   198	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   199	    if rc != 0 or not out.strip():
   200	        return _fail(
   201	            E_REMOTE_REF,
   202	            "no usable ref %s in this repo — cannot judge ancestry "
   203	            "(git said: %s)" % (ref, err.strip()),
   204	        )
   205	    remote_sha = out.strip()
   206	
   207	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   208	    if rc == 0:
   209	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   210	        return 0
   211	    if rc == 1:
   212	        return _fail(
   213	            E_NOT_ANCESTOR,
   214	            "HEAD is not an ancestor of %s — push main and re-run the "
   215	            "preflight.\n"
   216	            "      A tag on an unpushed commit points at a tree CI never "
   217	            "saw; the\n"
   218	            "      preflight's green verdict was about a different SHA."
   219	            % ref,
   220	        )
   221	    return _fail(
   222	        E_REMOTE_REF,
   223	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   224	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   225	    )
