   298	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   299	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   300	    if not manifest_path.exists():
   301	        raise FileNotFoundError(f"manifest: {manifest_path}")
   302	    paths = []
   303	    for line in manifest_path.read_text().splitlines():
   304	        line = line.split("#", 1)[0].strip()
   305	        if line:
   306	            paths.append(line)
   307	    paths.sort()
   308	    hashes = {}
   309	    for p in paths:
   310	        result = subprocess.run(
   311	            ["git", "hash-object", p],
   312	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   313	        )
   314	        if result.returncode != 0:
   315	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   316	        hashes[p] = result.stdout.strip()
   317	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   318	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
