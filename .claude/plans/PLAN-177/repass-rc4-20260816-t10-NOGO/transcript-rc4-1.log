  1438	
  1439	INTEGRITY_DOC = REPO_ROOT / "npm" / "INTEGRITY.md"
  1440	# Closed set. A row whose Status is anything else is a red — fail-closed on
  1441	# unknown vocabulary, because the way this table decayed the first time was a
  1442	# cell that READ like enforcement ("(to-add)", "Release script (Sprint 17
  1443	# scope)") without ever being it.
  1444	_CONTRACT_STATUSES = ("enforced", "deferred", "operator")
  1445	# `<workflow>.yml` in backticks, then the step name in straight quotes. Both
  1446	# delimiters are load-bearing: they are what makes the claim parseable at all.
  1447	_ENFORCED_RX = re.compile(r'`([^`]+\.yml)`\s+step\s+"([^"]+)"')
  1448	# Without a floor, a parser that suddenly matches nothing reports zero
  1449	# offenders and the gate passes having checked NOTHING. Two is the smallest
  1450	# floor that also keeps a one-row table from satisfying it by accident.
  1451	_MIN_ENFORCED_PAIRS = 2
  1452	
  1453	
  1454	def _yaml_step_names(path: Path) -> List[str]:
  1455	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1456	    call site: a substring match would accept "Verify VERSION" for a step
  1457	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1458	    already cost this repo three incidents in one session."""
  1459	    text = path.read_text(encoding="utf-8")
  1460	    names = []
  1461	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1462	        name = m.group(1)
  1463	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1464	            name = name[1:-1]
  1465	        names.append(name)
  1466	    return names
  1467	
  1468	
  1469	def _contract_rows(doc_text: str) -> List[List[str]]:
  1470	    """The `## Contract` table as [control, mechanism, status, where].
  1471	
  1472	    Re-pass rc.4 t6-cond-2 / t7 P2: a malformed non-header row (any cell
  1473	    count other than 4) FAILS instead of being silently discarded — an
  1474	    enforcement claim that grows an extra `|` must not vanish from the
  1475	    oracle while the remaining rows keep the non-vacuity floors green.
  1476	    """
  1477	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1478	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1479	    rows = []
  1480	    malformed = []
  1481	    for line in m.group(0).splitlines():
  1482	        line = line.strip()
  1483	        if not line.startswith("|"):
  1484	            continue
  1485	        cells = [c.strip() for c in line.strip("|").split("|")]
  1486	        if cells and (cells[0] == "Control" or set(cells[0]) <= set("- :")):
  1487	            continue
  1488	        if len(cells) != 4:
  1489	            malformed.append(line)
  1490	            continue
  1491	        rows.append(cells)
  1492	    assert not malformed, (
  1493	        "malformed `## Contract` row(s) (cell count != 4) would be silently "
  1494	        "dropped from the enforcement oracle: %s" % malformed
  1495	    )
  1496	    return rows
  1497	
