  1753	# ---------------------------------------------------------------------------
  1754	# PLAN-177 W0.3 delta (codex P1-4 of the v4 round) — the generic sweep.
  1755	#
  1756	# The gates above are SUBJECT-BOUND: the table gate checks rows, and the
  1757	# checksum gate anchors three named phantom referents. A NEW enforcement
  1758	# promise, about some other subject, written into a section nobody watches,
  1759	# passes all of them. The original defect is the proof that this is not
  1760	# hypothetical: "(3) a per-tarball SHA-256 manifest ... recorded by
  1761	# npm-publish.yml at tag cut" was written in the INTRODUCTION, not in a row.
  1762	#
  1763	# Rule: a claim that a mechanism runs may live in exactly two places — a
  1764	# Contract table row (machine-checked by
  1765	# test_integrity_contract_rows_name_a_live_step) or §Not yet automated (tied
  1766	# to the table's un-enforced rows by
  1767	# test_integrity_unenforced_rows_are_restated_where_the_reader_looks).
  1768	# Anywhere else it is answerable to nothing, and is a red.
  1769	#
  1770	# PREDICATE CHOICE (the honest part). This is a closed VOCABULARY list with
  1771	# NO negation exemption, and both halves were chosen from evidence, not taste:
  1772	#
  1773	#   * An earlier draft tolerated a phrase when a negation appeared within ~120
  1774	#     chars. Probing the real file showed that exemption firing by ACCIDENT —
  1775	#     "MUST satisfy" was excused by a "not" belonging to the next paragraph,
  1776	#     and "fail-closes" by the "not" inside "does not verify". An exemption
  1777	#     that triggers on unrelated words is not an exemption, it is a hole. So
  1778	#     the prose was cured instead (PLAN-177 W0.3 delta: the intro now points
  1779	#     at the table rather than enumerating mechanisms, and the tag-signing
  1780	#     paragraph cites SECURITY.md as the authority instead of restating the
  1781	#     gate), and the rule became absolute. Zero occurrences today: the sweep
  1782	#     needs no exemption, so it has none.
  1783	#   * The list is deliberately NARROW: phrases that assert a mechanism is in
  1784	#     force. Bare "verify" is absent on purpose — the file legitimately tells
  1785	#     a reader to `Verify locally with gpg --import ...`, an instruction, not
  1786	#     a claim about the pipeline. "verifies"/"is verified" ARE listed: those
  1787	#     are the file speaking about what the pipeline does.
  1788	#     A broad list that has to be switched off is worth less than a narrow
  1789	#     one that stays on.
  1790	#
  1791	# Matching is on word boundaries after normalization. Substring matching was
  1792	# tried first and reported "asserted by" inside "asserted byte-for-byte" — the
  1793	# substring-vs-exact class, for the fourth time in this plan.
  1794	_ENFORCEMENT_VOCAB = (
  1795	    "enforced today",
  1796	    "is enforced",
  1797	    "are enforced",
  1798	    "enforced by",
  1799	    "enforced at",
  1800	    "every tag publish",
  1801	    "recorded by",
  1802	    "is verified",
  1803	    "are verified",
  1804	    "verifies",
  1805	    "must satisfy",
  1806	    "guarantees",
  1807	    "is guaranteed",
  1808	    "are guaranteed",
  1809	    "asserted by",
  1810	    "checked by",
  1811	    "gated by",
  1812	    "fails closed",
  1813	    "fail closes",
  1814	    "asserts",
  1815	    "ensures",
  1816	    "is signed",
  1817	    "are signed",
  1818	)
  1819	
  1820	
  1821	def _normalize_prose(text: str) -> str:
  1822	    """Lowercase; drop markdown emphasis and code ticks; hyphens to spaces;
  1823	    collapse whitespace. `**Fails Closed**`, `fails-closed` and `fails closed`
  1824	    normalize the same way, so a claim cannot hide behind formatting."""
  1825	    text = text.lower()
  1826	    for ch in ("*", "`", "_"):
  1827	        text = text.replace(ch, "")
  1828	    text = text.replace("-", " ")
  1829	    return re.sub(r"\s+", " ", text)
  1830	
  1831	
  1832	def _prose_outside_the_declared_zones(doc_text: str) -> str:
  1833	    """Everything that is neither a `## Contract` table row nor §Not yet
  1834	    automated — the surfaces where a mechanism claim answers to nothing.
  1835	
  1836	    Re-pass rc.4 t9 P2: strip table rows ONLY inside `## Contract` — the
  1837	    blanket startswith("|") filter exempted EVERY table anywhere in the
  1838	    doc, so a new table outside the Contract section could carry an
  1839	    enforcement claim past this sweep unchecked.
  1840	    """
  1841	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1842	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", body)
  1843	    if m:
  1844	        stripped_section = "\n".join(
  1845	            line for line in m.group(0).splitlines()
  1846	            if not line.strip().startswith("|")
  1847	        )
  1848	        body = body[: m.start()] + stripped_section + body[m.end():]
  1849	    return body
  1850	
  1851	
  1852	def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
  1853	    norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
  1854	    offenders = []
  1855	    for phrase in _ENFORCEMENT_VOCAB:
  1856	        for m in re.finditer(r"\b%s\b" % re.escape(phrase), norm):
  1857	            offenders.append(
  1858	                "%r outside the declared zones: ...%s..."
  1859	                % (phrase, norm[max(0, m.start() - 70) : m.end() + 70])
  1860	            )
  1861	    return offenders
  1862	
  1863	
  1864	def test_integrity_prose_states_no_mechanism_outside_the_declared_zones():
  1865	    """Generic negative sweep: no enforcement vocabulary anywhere in
  1866	    npm/INTEGRITY.md except a Contract table row or §Not yet automated. Where
  1867	    the earlier gates ask "is this row honest?", this one asks "is this claim
  1868	    even standing somewhere that can be checked?" — the question the file
  1869	    failed on the day it shipped."""
  1870	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1871	    assert _ENFORCEMENT_VOCAB, "the vocabulary is empty; the sweep checks nothing"
  1872	
  1873	    # The sweep must be looking at the right text: intro present, table absent.
  1874	    swept = _prose_outside_the_declared_zones(doc)
  1875	    assert "Integrity contract for the" in swept, (
  1876	        "the introduction fell out of the swept zone — zone-stripping is eating "
  1877	        "the prose it exists to watch"
  1878	    )
  1879	    assert "| enforced |" not in swept, "the Contract table was not stripped"
  1880	    assert len(swept) > len(doc) // 3, (
  1881	        "swept prose is %d chars of a %d-char file — the zones swallowed it"
  1882	        % (len(swept), len(doc))
  1883	    )
  1884	
  1885	    # t9 P2 positive control: a table OUTSIDE `## Contract` carrying an
  1886	    # enforcement claim must NOT be exempted by the sweep — the old blanket
  1887	    # `startswith("|")` filter stripped every table anywhere.
  1888	    outside_table = (
  1889	        doc
  1890	        + "\n## Some new section\n\n"
  1891	        + "| per-tarball SHA-256 manifest | enforced today; recorded by "
  1892	        + "npm-publish.yml |\n"
  1893	    )
  1894	    assert _enforcement_vocabulary_offenders(outside_table), (
  1895	        "an enforcement claim inside a table OUTSIDE ## Contract passed the "
  1896	        "generic sweep — the exemption must be Contract-section-only"
  1897	    )
  1898	
  1899	    # (a) NEGATIVE control FIRST, deliberately: today's text passes on its own
  1900	    # merits. The order matters and was learned the hard way — the controls
  1901	    # below build their fixtures FROM the live file, so when the file itself
  1902	    # carries a planted defect they fail first and the red names the fixture
  1903	    # instead of the defect. Asserting cleanliness up front means a dirty file
  1904	    # always reds on the assertion that describes what is actually wrong.
  1905	    # Vacuity is not the risk here: (b) proves the instrument can still fail.
  1906	    offenders = _enforcement_vocabulary_offenders(doc)
  1907	    assert not offenders, (
  1908	        "npm/INTEGRITY.md states a mechanism outside the Contract table and "
  1909	        "§Not yet automated. Move the claim into a table row (with a step the "
  1910	        "YAML really has) or into §Not yet automated:\n%s" % "\n".join(offenders)
  1911	    )
  1912	
  1913	    # (b) positive control: the historical claim restored to the introduction.
  1914	    # The fixture INSERTS a paragraph after the title rather than rewriting
  1915	    # today's wording — an anchor on current prose stops matching the moment
  1916	    # that prose is edited, and then the control fails for the wrong reason.
  1917	    title, _, rest = doc.partition("\n")
  1918	    claim = (
  1919	        "The integrity controls enforced today are: (1) the `install.sh` "
  1920	        "self-SHA trailer, and (2) a per-tarball SHA-256 manifest "
  1921	        "(`npm/SHA256SUMS.txt`) recorded by `npm-publish.yml` at tag cut."
  1922	    )
  1923	    relapse = "%s\n\n%s\n%s" % (title, claim, rest)
  1924	    assert relapse != doc, "relapse fixture did not patch the doc"
  1925	    relapse_offenders = _enforcement_vocabulary_offenders(relapse)
  1926	    assert any("enforced today" in o for o in relapse_offenders), (
  1927	        "an enforcement claim in the introduction went unseen: %s"
  1928	        % relapse_offenders
  1929	    )
  1930	    assert any("recorded by" in o for o in relapse_offenders), (
  1931	        "the attribution half of the claim went unseen: %s" % relapse_offenders
  1932	    )
  1933	
  1934	    # (c) scope control: the SAME sentence inside §Not yet automated is NOT an
  1935	    # offender. This is the predicate as documented, not a global grep — that
  1936	    # section is where honest prose about absence has to be able to use these
  1937	    # words. Its own honesty is held by the restatement test above; a claim
  1938	    # parked there is the residual gap, and it is a narrow, watched one.
  1939	    marker = "## Not yet automated"
  1940	    assert marker in doc
  1941	    parked = doc.replace(marker, "%s\n\n%s" % (marker, claim), 1)
  1942	    assert not _enforcement_vocabulary_offenders(parked), (
  1943	        "the sweep is a global grep, not a zone rule — it flagged text inside "
  1944	        "a declared zone"
  1945	    )
