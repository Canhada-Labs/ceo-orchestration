  1948	# --------------------------------------------------------------------------
  1949	# Supply-chain honesty: the two claims that survive being corrected in one file
  1950	#
  1951	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  1952	# was green while `npm/README.md` — the README an npm consumer actually
  1953	# RECEIVES, it is in package.json `files` — still promised "SLSA 3 provenance",
  1954	# and while README.pt-BR, INSTALL.md and both QUICKSTARTs repeated Level 3 and
  1955	# a checksum coverage the release does not have (repass-rc4 part 2, P1 §2).
  1956	# A single-file gate cannot see that class, so the surface list below is
  1957	# EXPLICIT, and `_live_doc_surfaces()` re-derives the population from the repo
  1958	# so a NEW document carrying either claim also lands in front of the gate.
  1959	#
  1960	# `.claude/**` is deliberately outside the population: plans, debates and
  1961	# archived verdicts are historical records, and they have to be able to quote a
  1962	# false claim verbatim without turning this gate red.
  1963	# --------------------------------------------------------------------------
  1964	
  1965	SUPPLY_CHAIN_HONESTY_SURFACES = (
  1966	    "README.md",
  1967	    "README.pt-BR.md",
  1968	    "npm/README.md",
  1969	    "npm/INTEGRITY.md",
  1970	    "INSTALL.md",
  1971	    "SECURITY.md",
  1972	    "SUPPORT.md",
  1973	    "SBOM.md",
  1974	    "docs/QUICKSTART.md",
  1975	    "docs/QUICKSTART.pt-BR.md",
  1976	    "docs/CTO-GUIDE.md",
  1977	    "docs/threat-model.md",
  1978	)
  1979	
  1980	# "SLSA 3", "SLSA-3", "SLSA Level 3", "SLSA L3", "SLSA provenance L3" and
  1981	# "provenance (SLSA L3)" all normalise to the same false claim. The earlier
  1982	# pattern only caught the first three, which is why `SBOM.md` ("SLSA L3") and
  1983	# `docs/QUICKSTART.md` ("SLSA provenance L3") were invisible to it.
  1984	_SLSA_LEVEL3_CLAIM = re.compile(
  1985	    r"SLSA[\s\-]*(?:provenance[\s\-]*)?(?:Level[\s\-]*|L)?3\b"
  1986	    r"|(?:provenance|attestation)[\s\-]*(?:Level[\s\-]*|L)3\b",
  1987	    re.IGNORECASE,
  1988	)
  1989	
  1990	# Plural = aggregate. Release checksum coverage is `install.sh` alone
  1991	# (SECURITY.md §How to verify what you install); "ships SHA-256 checksums"
  1992	# promises a SHA256SUMS that no workflow produces.
  1993	_CHECKSUM_AGGREGATE_CLAIM = re.compile(
  1994	    r"SHA-?256\s+checksums|checksums\s+SHA-?256", re.IGNORECASE
  1995	)
