   278	
   279	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   280	# The two readers of this signed file disagreed about what a key IS: the
   281	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   282	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   283	# file demand the colon immediately after the name, so they skipped the line.
   284	# The valid-YAML pair
   285	#
   286	#     verdict : NO-GO
   287	#     verdict: GO
   288	#
   289	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   290	# and this is the rail that enforces in every mode, so the tag was authorised.
   291	#
   292	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   293	# fail-closed. Trimming the key in both readers would also close the
   294	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   295	# author writes and no template emits; refusing the shape is the smaller
   296	# surface and is the only behaviour that cannot silently prefer a value.
   297	# A top-level line is canonical iff it is `name:` with no whitespace before
   298	# the colon; list items are legal ONLY indented under an active bare
   299	# key (t8 P2: a root `- item` is rejected — the old comment said
   300	# otherwise and misled operators).
   301	def _strip_yaml_comment(raw):
   302	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   303	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   304	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Byte-for-
   305	    byte twin of `_strip_comment` in validate-pair-rail-verdict.py.
   306	    """
   307	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   308	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   309	    if raw.lstrip(" \t").startswith("#"):
   310	        return ""
   311	    i = 0
   312	    while True:
   313	        j = raw.find("#", i)
   314	        if j == -1:
   315	            return raw.rstrip(" \t")
   316	        if j > 0 and raw[j - 1] in (" ", "\t"):
   317	            return raw[:j].rstrip(" \t")
   318	        i = j + 1
   319	
   320	
   321	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   322	
   323	
   324	def _noncanonical_top_level_lines(text: str) -> List[str]:
   325	    """Top-level lines of the yaml block that are not canonical declarations.
   326	
   327	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   328	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   329	    separate machines; neither may import the other — keep them identical).
   330	    Empty list == the block speaks the grammar both readers assume.
   331	    """
   332	    body = _extract_single_yaml_block(text)
   333	    if body is None:
   334	        return ["<yaml block rejected: ambiguous fence, bad opener, or "
   335	                "forbidden control/separator bytes>"]
   336	    bad: List[str] = []
   337	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   338	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   339	    # Both None (before any key) and "scalar" reject — an orphan-indented
   340	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   341	    # through the prev_scalar_decl=False initial state and resolved as GO,
   342	    # and a root-level `- item` is malformed for this signed format (its
   343	    # only lists are INDENTED under a bare key) yet was accepted outright.
   344	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   345	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   346	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   347	    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware
   348	    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a
   349	    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),
   350	    # reopening the orphan-indentation class through the whitespace side.
   351	    parent = None  # None | "scalar" | "bare"
   352	    for raw in body.split("\n"):
   353	        line = _strip_yaml_comment(raw)
   354	        if not line.strip(" \t"):
   355	            continue
   356	        if line[0] in (" ", "\t"):
   357	            if parent != "bare":
   358	                bad.append(line)
   359	            continue
   360	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   361	            _key, _, _val = line.partition(":")
   362	            parent = "scalar" if _val.strip(" \t") else "bare"
   363	            continue
   364	        bad.append(line)
   365	        parent = None
   366	    return bad
