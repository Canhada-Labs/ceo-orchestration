  1025	        # testable.
  1026	        #
  1027	        # PLAN-177 W0.1 / CF-4: DERIVED from the module, not enumerated
  1028	        # by hand. The hand-kept list rotted -- it omitted
  1029	        # E_PARENT_NOT_ANCESTOR (12) from the day that mode was added, so
  1030	        # the assert stopped covering the NEWEST failure mode, which is
