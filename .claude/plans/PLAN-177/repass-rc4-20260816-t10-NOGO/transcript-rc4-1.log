  1948	# --------------------------------------------------------------------------
  1949	# Supply-chain honesty: the two claims that survive being corrected in one file
  1950	#
  1951	# The previous revision of the SLSA gate read `README.md` and nothing else. It
  1952	# was green while `npm/README.md` — the README an npm consumer actually
  1953	# RECEIVES, it is in package.json `files` — still promised "SLSA 3 provenance",
  1954	# and while README.pt-BR, INSTALL.md and both QUICKSTARTs repeated Level 3 and
  1955	# a checksum coverage the release does not have (repass-rc4 part 2, P1 §2).
  1956	# A single-file gate cannot see that class, so the surface list below is
  1957	# EXPLICIT, and `_live_doc_surfaces()` re-derives the population from the repo
  1958	# so a NEW document carrying either claim also lands in front of the gate.
  1959	#
  1960	# `.claude/**` is deliberately outside the population: plans, debates and
  1961	# archived verdicts are historical records, and they have to be able to quote a
  1962	# false claim verbatim without turning this gate red.
  1963	# --------------------------------------------------------------------------
  1964	
  1965	SUPPLY_CHAIN_HONESTY_SURFACES = (
  1966	    "README.md",
  1967	    "README.pt-BR.md",
  1968	    "npm/README.md",
  1969	    "npm/INTEGRITY.md",
  1970	    "INSTALL.md",
  1971	    "SECURITY.md",
  1972	    "SUPPORT.md",
  1973	    "SBOM.md",
  1974	    "docs/QUICKSTART.md",
  1975	    "docs/QUICKSTART.pt-BR.md",
  1976	    "docs/CTO-GUIDE.md",
  1977	    "docs/threat-model.md",
  1978	)
  1979	
  1980	# "SLSA 3", "SLSA-3", "SLSA Level 3", "SLSA L3", "SLSA provenance L3" and
  1981	# "provenance (SLSA L3)" all normalise to the same false claim. The earlier
  1982	# pattern only caught the first three, which is why `SBOM.md` ("SLSA L3") and
  1983	# `docs/QUICKSTART.md` ("SLSA provenance L3") were invisible to it.
  1984	_SLSA_LEVEL3_CLAIM = re.compile(
  1985	    r"SLSA[\s\-]*(?:provenance[\s\-]*)?(?:Level[\s\-]*|L)?3\b"
  1986	    r"|(?:provenance|attestation)[\s\-]*(?:Level[\s\-]*|L)3\b",
  1987	    re.IGNORECASE,
  1988	)
  1989	
  1990	# Plural = aggregate. Release checksum coverage is `install.sh` alone
  1991	# (SECURITY.md §How to verify what you install); "ships SHA-256 checksums"
  1992	# promises a SHA256SUMS that no workflow produces.
  1993	_CHECKSUM_AGGREGATE_CLAIM = re.compile(
  1994	    r"SHA-?256\s+checksums|checksums\s+SHA-?256", re.IGNORECASE
  1995	)
  1996	
  1997	
  1998	def _live_doc_surfaces() -> List[Path]:
  1999	    """Root-level, `docs/` and `npm/` markdown — every document a reader or an
  2000	    npm consumer meets. Deliberately NOT `.claude/**` (see the block comment)."""
  2001	    found = sorted(REPO_ROOT.glob("*.md"))
  2002	    for sub in ("docs", "npm"):
  2003	        base = REPO_ROOT / sub
  2004	        if base.exists():
  2005	            found += sorted(base.rglob("*.md"))
  2006	    return found
  2007	
  2008	
  2009	def test_slsa_and_checksum_claims_are_true_on_every_shipped_surface():
  2010	    """The npm consumer reads `npm/README.md`; the Portuguese reader reads
  2011	    `README.pt-BR.md`. Correcting the root README alone left both promising a
  2012	    Level the pipeline never reaches. The gate now runs over an explicit list
  2013	    AND over every live doc, so neither a missed translation nor a new file can
  2014	    carry the claim silently."""
  2015	    surfaces = {p.relative_to(REPO_ROOT).as_posix(): p for p in _live_doc_surfaces()}
  2016	
  2017	    # (a) The explicit list is not allowed to name a file that stopped
  2018	    # existing: a surface silently dropped from the repo is a gate that
  2019	    # quietly narrows.
  2020	    missing = [s for s in SUPPLY_CHAIN_HONESTY_SURFACES if s not in surfaces]
  2021	    assert not missing, "declared honesty surfaces that no longer exist: %s" % missing
  2022	
  2023	    offenders: List[str] = []
  2024	    for rel, path in surfaces.items():
  2025	        text = path.read_text(encoding="utf-8")
  2026	        for m in _SLSA_LEVEL3_CLAIM.finditer(text):
  2027	            # Tolerance is scoped to what FOLLOWS the mention, never to the
  2028	            # line: the honest sentence names Level 2 and disclaims Level 3 in
  2029	            # one breath, so a line-wide exemption would let the false claim
  2030	            # ride along beside its own disclaimer. The window is 120 chars
  2031	            # because the live disclaimer parenthesises its reason
  2032	            # ("(hermetic build + two-party review) is out of scope") — at the
  2033	            # old width of 40 the only honest Level-3 sentence in the repo
  2034	            # would have been the gate's first false positive.
  2035	            tail = text[m.end():m.end() + 120]
  2036	            if "out of scope" in tail or "fora de escopo" in tail:
  2037	                continue
  2038	            offenders.append(
  2039	                "%s: ...%s..."
  2040	                % (rel, text[max(0, m.start() - 60):m.end() + 40].strip().replace("\n", " "))
  2041	            )
  2042	        for m in _CHECKSUM_AGGREGATE_CLAIM.finditer(text):
  2043	            offenders.append(
  2044	                "%s: ...%s..."
  2045	                % (rel, text[max(0, m.start() - 70):m.end() + 30].strip().replace("\n", " "))
  2046	            )
  2047	
  2048	    assert not offenders, (
  2049	        "shipped docs claim SLSA Level 3 and/or aggregate release checksums; "
  2050	        "the pipeline reaches Level 2 (`npm publish --provenance`) and the "
  2051	        "release checksum covers `install.sh` only:\n%s" % "\n".join(offenders)
  2052	    )
  2053	
  2054	    # (b) Positive statement, on the two most-read surfaces: silence about the
  2055	    # level is not honesty either. The npm README is named explicitly because
  2056	    # it is the one that travels inside the tarball.
  2057	    for rel in ("README.md", "npm/README.md"):
  2058	        text = surfaces[rel].read_text(encoding="utf-8")
  2059	        assert "SLSA **Level 2**" in text or "SLSA Level 2" in text, (
  2060	            "%s no longer states the level the pipeline reaches" % rel
  2061	        )
  2062	
  2063	
  2064	# --------------------------------------------------------------------------
  2065	# The npm signature recipe has to audit the thing the reader just installed
  2066	#
  2067	# `npm audit signatures` reads the CURRENT project's dependency tree. It takes
  2068	# no package-selecting positional (a trailing package name is ignored), and it
  2069	# refuses global installs outright with EAUDITGLOBAL. So the documented pairing
  2070	# of `npm install -g` (or `npm exec` / `npx`, which leave no dependency behind)
  2071	# with `npm audit signatures` verified nothing the reader had just installed —
  2072	# it audited whatever directory they happened to be standing in, and could
  2073	# return a confident green having examined a different tree entirely.
  2074	# Both behaviours were observed directly against npm 11.16.0 (repass-rc4
  2075	# part 2, P1 §3); the honest routes are the npm provenance panel, or a local
  2076	# project install followed by a BARE `npm audit signatures`.
  2077	# --------------------------------------------------------------------------
  2078	
  2079	_AUDIT_SIGNATURES = re.compile(r"npm\s+audit\s+signatures")
  2080	# Installs that `npm audit signatures` cannot reach: global, or exec/npx
  2081	# (ephemeral — nothing is left in a dependency tree to audit).
  2082	_UNAUDITABLE_INSTALL = re.compile(
  2083	    r"npm\s+(?:i|install)\b[^\n]*?(?:\s-g\b|\s--global\b)|npm\s+exec\b|\bnpx\b"
  2084	)
  2085	# A trailing token that is neither a comment nor a flag: npm ignores it, and
  2086	# the reader believes it selected a package. `#` is excluded so the honest
  2087	# recipes may explain themselves in a trailing comment; `-` is excluded so a
  2088	# flag is diagnosed by the flag rule below and not mislabelled a positional.
  2089	_AUDIT_POSITIONAL = re.compile(r"npm\s+audit\s+signatures\s+(?![#-])([^\s`|#\n]+)")
  2090	_AUDIT_GLOBAL_FLAG = re.compile(
  2091	    r"npm\s+audit\s+signatures[^\n]*(?:\s-g\b|\s--global\b)"
  2092	)
  2093	
  2094	
  2095	def _recipe_units(text: str) -> List[tuple]:
  2096	    """(label, body) for each fenced code block, and for each line outside one.
  2097	
  2098	    A recipe is what a reader copies, and they copy a whole code block — so the
  2099	    block, not the line, is the unit in which "install here, audit there" has
  2100	    to be judged. Prose lines are units of their own so a one-line table row
  2101	    (the shape `SUPPORT.md` used) is still examined."""
  2102	    units: List[tuple] = []
  2103	    block: Optional[List] = None
  2104	    for num, line in enumerate(text.splitlines(), 1):
  2105	        if line.strip().startswith("```"):
  2106	            if block is None:
  2107	                block = [num, []]
  2108	            else:
  2109	                units.append(("block@%d" % block[0], "\n".join(block[1])))
  2110	                block = None
  2111	            continue
  2112	        if block is not None:
  2113	            block[1].append(line)
  2114	        else:
  2115	            units.append(("line@%d" % num, line))
  2116	    if block is not None:  # unterminated fence: judge what we collected
  2117	        units.append(("block@%d" % block[0], "\n".join(block[1])))
  2118	    return units
  2119	
  2120	
  2121	def test_documented_npm_signature_recipe_matches_what_npm_audits():
  2122	    """Every documented `npm audit signatures` has to be reachable by npm.
  2123	
  2124	    A recipe offends when its unit pairs the command with an install npm cannot
  2125	    audit, passes a positional npm ignores, or passes `--global`, which npm
  2126	    rejects. Naming `EAUDITGLOBAL` in the unit is the tolerance: a document is
  2127	    free — and encouraged — to put the global install next to the command in
  2128	    order to say that the command does NOT reach it."""
  2129	    offenders: List[str] = []
  2130	    units_examined = 0
  2131	    for path in _live_doc_surfaces():
  2132	        rel = path.relative_to(REPO_ROOT).as_posix()
  2133	        text = path.read_text(encoding="utf-8")
  2134	        if not _AUDIT_SIGNATURES.search(text):
  2135	            continue
  2136	        for label, unit in _recipe_units(text):
  2137	            if not _AUDIT_SIGNATURES.search(unit):
  2138	                continue
  2139	            units_examined += 1
  2140	            faults = []
  2141	            if _UNAUDITABLE_INSTALL.search(unit) and "EAUDITGLOBAL" not in unit:
  2142	                faults.append(
  2143	                    "pairs the audit with an install npm cannot audit "
  2144	                    "(global, or exec/npx leaving no dependency behind)"
