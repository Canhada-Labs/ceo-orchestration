  1519	def _integrity_enforced_pairs(doc_text: str) -> List[List[str]]:
  1520	    """[control, workflow, step] for every `enforced` row. Rows with any other
  1521	    Status are not read — a row that claims no enforcement makes no claim to
  1522	    check."""
