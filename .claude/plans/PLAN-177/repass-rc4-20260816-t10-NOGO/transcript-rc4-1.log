 def _git(repo: str, *args: str) -> Tuple[int, str, str]:
     proc = subprocess.run(
         ["git"] + list(args),
         cwd=repo,
         stdout=subprocess.PIPE,
         stderr=subprocess.PIPE,
         universal_newlines=True,
     )
     return proc.returncode, proc.stdout, proc.stderr
 
 
