  2596	def test_both_rails_reject_ambiguous_or_multiple_yaml_fences():
  2597	    """Re-pass rc.4 t9 P1 #1: an unanchored block regex let a QUOTED
  2598	    ```yaml fence inside a four-backtick block become the authoritative
  2599	    verdict — a quoted GO envelope shadowed the real top-level NO-GO one
  2600	    and both rails exited 0. The strict extractor rejects any artifact
  2601	    whose literal ```yaml count differs from exactly one."""
  2602	    quoted_go_shadowing_real_nogo = (
  2603	        "# quoted example\n\n"
  2604	        "````markdown\n"
  2605	        "```yaml\n"
  2606	        "verdict: GO\n"
  2607	        "release_tag: v9.9.9\n"
  2608	        "```\n"
  2609	        "````\n\n"
  2610	        "```yaml\n"
  2611	        "verdict: NO-GO\n"
  2612	        "release_tag: v9.9.9\n"
  2613	        "```\n"
  2614	    )
  2615	    two_plain_blocks = (
  2616	        "```yaml\nverdict: GO\n```\n\n```yaml\nverdict: NO-GO\n```\n"
  2617	    )
  2618	    for text in (quoted_go_shadowing_real_nogo, two_plain_blocks):
  2619	        assert validator.noncanonical_top_level_lines(text) != [], (
  2620	            "step-15 validator accepted an ambiguous multi-fence artifact"
  2621	        )
  2622	        assert tag_guard._noncanonical_top_level_lines(text) != [], (
  2623	            "tag guard accepted an ambiguous multi-fence artifact"
  2624	        )
  2625	        try:
  2626	            parsed = validator.parse_verdict_text(text)
  2627	        except ValueError:
  2628	            parsed = {}
  2629	        assert parsed.get("verdict") != "GO", (
  2630	            "the quoted GO must never win: %r" % parsed
  2631	        )
  2632	        assert tag_guard._parse_verdict(text).get("verdict") != "GO"
  2633	    # An indented (column>0) opener is NOT the canonical fence either.
  2634	    indented_opener = " ```yaml\nverdict: GO\n```\n"
  2635	    assert validator.noncanonical_top_level_lines(indented_opener) != []
  2636	    assert tag_guard._noncanonical_top_level_lines(indented_opener) != []
