  1228	def scan_live_surfaces(needle: str):
  1229	    """grep, in Python. The local `grep` is ugrep and disagrees with GNU grep
  1230	    about binary files, so a subprocess control would not mean the same thing
  1231	    here and in CI. Returns (files_scanned, hits)."""
  1232	    hits: List[str] = []
  1233	    scanned = 0
  1234	    for root in SCAN_ROOTS:
  1235	        base = REPO_ROOT / root
  1236	        if not base.exists():
  1237	            continue
  1238	        paths = [base] if base.is_file() else sorted(base.rglob("*"))
  1239	        for path in paths:
  1240	            if not path.is_file() or "__pycache__" in path.parts:
  1241	                continue
  1242	            try:
  1243	                body = path.read_text(encoding="utf-8")
  1244	            except (UnicodeDecodeError, OSError):
  1245	                continue  # binary artifact: not a live text surface
  1246	            scanned += 1
  1247	            for num, line in enumerate(body.splitlines(), 1):
  1248	                if needle in line:
  1249	                    hits.append(
  1250	                        "%s:%d: %s"
  1251	                        % (path.relative_to(REPO_ROOT), num, line.strip())
  1252	                    )
  1253	    return scanned, hits
