  2639	def test_both_rails_answer_identically_on_every_key_shape():
  2640	    """The instrument that would have caught P1-a: ONE question, two readers.
  2641	
  2642	    A divergence is only visible when the same bytes are put to both. For any
  2643	    block both accept, they must also agree on how many decisions it declares
  2644	    and on which one wins -- otherwise the pair `NO-GO`/`GO` means different
  2645	    things on the two machines that gate a release.
  2646	    """
  2647	    def block(body: str) -> str:
  2648	        return "# fixture\n\n```yaml\n%s```\n" % body
  2649	
  2650	    canonical_shapes = [
  2651	        "verdict: GO\nrelease_tag: v1.2.3\n",
  2652	        "verdict: NO-GO\nverdict: GO\n",
  2653	        "verdict: GO\ndelta_allowlist:\n  - a/b.md\n  - c/d.md\n",
  2654	        "verdict: GO\ntool_versions:\n  codex_cli: 0.144.6\n",
  2655	        "verdict: GO  # inline comment\n",
  2656	        "verdict: GO#NO-GO\nrelease_tag: v1.2.3\n",
  2657	        "# verdict: NO-GO\nverdict: GO\n",
  2658	    ]
  2659	    noncanonical_shapes = [
  2660	        "verdict:GO\n",
  2661	        "verdict: GO\n  NO-GO\nrelease_tag: v1.2.3\n",
  2662	        "verdict : NO-GO\nverdict: GO\n",
  2663	        "verdict\t: NO-GO\nverdict: GO\n",
  2664	        "verdict : GO\n",
  2665	        '"verdict": GO\n',
  2666	        "verdict :GO\n",
  2667	        # Re-pass rc.4 t7 P1: an ORPHAN-indented first line (no active bare
  2668	        # parent) previously slipped the prev_scalar_decl=False initial
  2669	        # state — `  verdict: NO-GO` + `verdict: GO` resolved as GO.
  2670	        "  verdict: NO-GO\nverdict: GO\n",
  2671	        # Same class after a scalar has RESET the state to non-bare.
  2672	        "release_tag: v1.2.3\n  verdict: NO-GO\nverdict: GO\n",
  2673	        # Root-level list item: this signed format's only lists are
  2674	        # INDENTED under a bare key; a root `- item` is malformed and was
  2675	        # accepted outright.
  2676	        "- verdict: NO-GO\nverdict: GO\n",
  2677	        "verdict: GO\n- trailing root list item\n",
  2678	        # Re-pass rc.4 t8 P1: Unicode-aware strip() in the SHAPE classifier
  2679	        # treated a U+00A0 VALUE as a bare parent (legitimizing an
  2680	        # orphan-indented line under it) and a lone-U+00A0 line as blank.
  2681	        "padding: \u00a0\n  verdict: NO-GO\nverdict: GO\n",
  2682	        "\u00a0\nverdict: GO\n",
  2683	        # Re-pass rc.4 t9 P1 #2: str.splitlines() also splits on VT/FF/
  2684	        # FS-RS/NEL/LS/PS \u2014 `GO<U+000B>#NO-GO` parsed as the exact token
  2685	        # GO on both rails. The extractor now rejects every control byte
  2686	        # except TAB and every separator except LF.
  2687	        "verdict: GO\u000b#NO-GO\n",
  2688	        "verdict: GO\u2028verdict: NO-GO\n",
  2689	        "verdict: GO\u0085release_tag: v1.2.3\n",
  2690	        "verdict: GO\r\nrelease_tag: v1.2.3\n",
  2691	    ]
  2692	    for body in canonical_shapes:
  2693	        text = block(body)
  2694	        assert validator.noncanonical_top_level_lines(text) == [], body
  2695	        assert tag_guard._noncanonical_top_level_lines(text) == [], body
  2696	        assert validator.count_top_level_key(
  2697	            text, "verdict"
  2698	        ) == tag_guard._count_top_level_key(text, "verdict"), (
  2699	            "the two rails disagree on how many decisions %r declares" % body
  2700	        )
  2701	        assert validator.parse_verdict_text(text).get(
  2702	            "verdict"
  2703	        ) == tag_guard._parse_verdict(text).get("verdict"), (
  2704	            "the two rails disagree on WHICH decision wins in %r" % body
  2705	        )
  2706	    for body in noncanonical_shapes:
  2707	        text = block(body)
  2708	        assert validator.noncanonical_top_level_lines(text) != [], body
  2709	        assert (
  2710	            tag_guard._noncanonical_top_level_lines(text)
  2711	            == validator.noncanonical_top_level_lines(text)
  2712	        ), "the two shape gates disagree about %r" % body
