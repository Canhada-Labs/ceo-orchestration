   444	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   445	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   446	    verdict_abs = os.path.join(repo, verdict_rel)
   447	    if not os.path.isfile(verdict_abs):
   448	        return _fail(
   449	            E_VERDICT,
   450	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   451	            "be committed before the tag is cut (release.yml validates it per "
   452	            "tag on the tagged tree)." % verdict_rel,
   453	        )
   454	    with open(verdict_abs, encoding="utf-8") as fh:
   455	        verdict_text = fh.read()
   456	    # PLAN-177 t2 (P1-a): SHAPE BEFORE ANY FIELD. Both rails read this file;
   457	    # they only agree on a canonical block. A non-canonical top-level line is
   458	    # refused here rather than handed to two different grammars — E_DECISION
   459	    # because the class this closes is the decision override (`verdict :
   460	    # NO-GO` + `verdict: GO`), and because a refusal that names the decision
   461	    # rail is the one an operator can act on.
   462	    noncanonical = _noncanonical_top_level_lines(verdict_text)
   463	    if noncanonical:
   464	        return _fail(
   465	            E_DECISION,
   466	            "verdict %s: non-canonical top-level key syntax %r -- a "
   467	            "top-level line must be\n"
   468	            "      `name:` with no whitespace before the colon (or a `- ` "
   469	            "list item only when INDENTED under a bare key, never at the "
   470	            "root). The two release rails read this\n"
   471	            "      file with different grammars, so `verdict : NO-GO` "
   472	            "followed by `verdict: GO` counts as two\n"
   473	            "      declarations server-side and one here; the shape is "
   474	            "refused instead of guessed."
   475	            % (verdict_rel, noncanonical),
   476	        )
   477	    fields = _parse_verdict(verdict_text)
   478	
   479	    release_tag = fields.get("release_tag")
