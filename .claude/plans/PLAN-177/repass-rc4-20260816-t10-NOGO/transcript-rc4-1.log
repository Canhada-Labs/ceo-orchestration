   397	def _sha256(path: str) -> str:
   398	    h = hashlib.sha256()
   399	    with open(path, "rb") as fh:
   400	        for chunk in iter(lambda: fh.read(65536), b""):
   401	            h.update(chunk)
   402	    return h.hexdigest()
   403	
   404	
   405	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   406	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   407	    entries: List[Tuple[str, str]] = []
   408	    with open(path, encoding="utf-8") as fh:
   409	        for line in fh:
   410	            line = line.rstrip("\n")
   411	            if not line.strip():
   412	                continue
   413	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   414	            if not m:
   415	                raise ValueError("unparsable manifest line: %r" % line)
   416	            entries.append((m.group(1), m.group(2)))
   417	    return entries
   418	
   419	
   420	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   421	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   422	    directory = os.path.dirname(manifest) or "."
   423	    name = os.path.basename(manifest)
   424	    try:
   425	        proc = subprocess.run(
   426	            ["shasum", "-a", "256", "-c", name],
   427	            cwd=directory,
   428	            stdout=subprocess.PIPE,
   429	            stderr=subprocess.STDOUT,
   430	            universal_newlines=True,
   431	        )
   432	        return proc.returncode == 0, proc.stdout.strip()
   433	    except (OSError, FileNotFoundError):
   434	        bad: List[str] = []
   435	        for want, rel in _read_manifest(manifest):
   436	            full = os.path.join(directory, rel)
   437	            if not os.path.isfile(full) or _sha256(full) != want:
   438	                bad.append(rel)
   439	        if bad:
   440	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   441	        return True, "hashlib fallback: all entries match"
   442	
