  1701	    # PLAN-177 t2 (re-pass rc.4 P2-c): the REGENERATION RECIPE must be able to
  1702	    # regenerate. The recipe this file shipped extracted `npm pack --json`'s
  1703	    # `.shasum`, which is npm's legacy SHA-1 and carries no filename -- it
  1704	    # produces neither the algorithm nor the `<sha256>  <name>` format of the
  1705	    # lines below, and under `--dry-run` there is no tarball to hash at all.
  1706	    # An operator following it would have written invalid evidence.
  1707	    #
  1708	    # Command lines are the ones indented as a block (`#` + 3 spaces); prose
  1709	    # that NAMES the rejected recipe is deliberately left readable, so the
  1710	    # gate reads commands, not the whole file.
  1711	    recipe = [
  1712	        line for line in sums.splitlines()
  1713	        if line.startswith("#") and line[1:].startswith("   ")
  1714	    ]
  1715	    assert recipe, "the manifest no longer documents any regeneration command"
  1716	    assert not any(".shasum" in line for line in recipe), (
  1717	        "a regeneration command extracts npm's `.shasum` again -- that is "
  1718	        "SHA-1, not SHA-256, and it emits no filename: %s" % recipe
  1719	    )
  1720	    assert not any("--dry-run" in line for line in recipe), (
  1721	        "a regeneration command runs `npm pack --dry-run` -- it writes no "
  1722	        "tarball, so there is nothing to hash: %s" % recipe
  1723	    )
  1724	    assert any(
  1725	        ("sha256sum" in line or "shasum -a 256" in line) for line in recipe
  1726	    ), "no recipe line names a SHA-256 hasher: %s" % recipe
  1727	    assert any(
  1728	        ("$TARBALL" in line or '"filename"' in line) for line in recipe
  1729	    ), (
  1730	        "the recipe never materialises the tarball NAME -- the manifest "
  1731	        "format is `<sha256>  <filename>`: %s" % recipe
  1732	    )
  1733	    # the writer the file attributes itself to must exist AND hash with the
  1734	    # algorithm the filename promises (attribution is checked, not trusted).
  1735	    writer = REPO_ROOT / "scripts" / "install-npm.sh"
  1736	    assert any("install-npm.sh" in line for line in recipe), (
  1737	        "the recipe no longer points at the real local writer: %s" % recipe
  1738	    )
  1739	    assert writer.exists(), "SHA256SUMS.txt names a writer that is not there"
  1740	    writer_body = writer.read_text(encoding="utf-8")
  1741	    assert "sha256sum" in writer_body or "shasum -a 256" in writer_body, (
  1742	        "install-npm.sh no longer computes a SHA-256 -- the attribution in "
  1743	        "SHA256SUMS.txt has gone stale"
  1744	    )
  1745	    # `files:` really does exclude it — the claim above is checked, not trusted
  1746	    pkg = json.loads((REPO_ROOT / "npm" / "package.json").read_text(encoding="utf-8"))
  1747	    assert not any("SHA256SUMS" in entry for entry in pkg["files"]), (
  1748	        "SHA256SUMS.txt now ships in the tarball — re-open the doc, the "
  1749	        "un-automated control may have become real"
  1750	    )
