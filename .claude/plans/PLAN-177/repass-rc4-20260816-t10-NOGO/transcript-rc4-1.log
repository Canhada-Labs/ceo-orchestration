+            if not line.strip().startswith("|")
+        )
+        body = body[: m.start()] + stripped_section + body[m.end():]
+    return body
 
 
 def _enforcement_vocabulary_offenders(doc_text: str) -> List[str]:
     norm = _normalize_prose(_prose_outside_the_declared_zones(doc_text))
