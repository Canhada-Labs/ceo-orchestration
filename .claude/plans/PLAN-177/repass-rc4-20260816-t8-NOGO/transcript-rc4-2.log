   213	def parse_verdict_text(text: str) -> Dict[str, Any]:
   214	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   215	    m = _YAML_BLOCK_RE.search(text)
   216	    if not m:
   217	        raise ValueError("verdict file missing yaml frontmatter block")
   218	    yaml_body = m.group(1)
   219	    # Inline minimal YAML parse (stdlib only)
   220	    out: Dict[str, Any] = {}
   221	    current_key: Optional[str] = None
   222	    for raw in yaml_body.splitlines():
   223	        line = _strip_comment(raw)
   224	        if not line.strip():
   225	            continue
   226	        if line[0] not in (" ", "\t"):
   227	            if ":" in line:
   228	                k, _, v = line.partition(":")
   229	                # ASCII-only value trim (t5 P1): a Unicode strip() would
   230	                # normalize `GO<U+00A0>` into the exact authorizing token.
   231	                v = v.strip(" \t")
   232	                if v:
   233	                    out[k.strip(" \t")] = v
   234	                else:
   235	                    out[k.strip(" \t")] = {}
   236	                    current_key = k.strip(" \t")
   237	        elif current_key and ":" in line:
   238	            sub_k, _, sub_v = line.partition(":")
   239	            if isinstance(out[current_key], dict):
   240	                out[current_key][sub_k.strip(" \t")] = sub_v.strip(" \t")
   241	    return out
