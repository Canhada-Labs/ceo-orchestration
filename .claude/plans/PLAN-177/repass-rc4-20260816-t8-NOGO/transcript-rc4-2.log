   381	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   382	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   383	    directory = os.path.dirname(manifest) or "."
   384	    name = os.path.basename(manifest)
   385	    try:
   386	        proc = subprocess.run(
   387	            ["shasum", "-a", "256", "-c", name],
   388	            cwd=directory,
   389	            stdout=subprocess.PIPE,
   390	            stderr=subprocess.STDOUT,
   391	            universal_newlines=True,
   392	        )
   393	        return proc.returncode == 0, proc.stdout.strip()
   394	    except (OSError, FileNotFoundError):
   395	        bad: List[str] = []
   396	        for want, rel in _read_manifest(manifest):
   397	            full = os.path.join(directory, rel)
   398	            if not os.path.isfile(full) or _sha256(full) != want:
   399	                bad.append(rel)
   400	        if bad:
   401	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   402	        return True, "hashlib fallback: all entries match"
