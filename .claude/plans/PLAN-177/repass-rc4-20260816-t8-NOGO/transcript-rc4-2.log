  1369	def _bare_version_offenders_in_npm_docs(repo_root: Path) -> List[str]:
  1370	    """Bare `X.Y.Z` in a scanned npm doc, outside a review stamp. Takes the
  1371	    root as an ARGUMENT so the positive control can plant the defect in a tmp
  1372	    tree and never write into the repo under test."""
  1373	    offenders: List[str] = []
  1374	    for rel in NPM_DOC_SURFACES:
  1375	        path = repo_root / rel
  1376	        if not path.is_file():
  1377	            continue
  1378	        try:
  1379	            body = path.read_text(encoding="utf-8")
  1380	        except (UnicodeDecodeError, OSError):
  1381	            continue
  1382	        for num, line in enumerate(body.splitlines(), 1):
  1383	            # Re-pass rc.4 t6-cond-1 / t7 P2: remove ONLY the stamp
  1384	            # substring and scan the remainder — skipping the whole line
  1385	            # let `currently 9.9.9 <!-- last-reviewed ... -->` ride a
  1386	            # valid stamp on the same line.
  1387	            scannable = _STAMP_LINE_RX.sub("", line)
  1388	            for hit in SEMVER_RX.findall(scannable):
  1389	                offenders.append("%s:%d: %s (%s)" % (rel, num, line.strip(), hit))
  1390	    return offenders
  1391	
