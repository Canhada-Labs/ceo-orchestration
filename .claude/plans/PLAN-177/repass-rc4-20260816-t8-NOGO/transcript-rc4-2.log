  1454	def _yaml_step_names(path: Path) -> List[str]:
  1455	    """Every `- name:` in a workflow, unquoted. Compared by EQUALITY at the
  1456	    call site: a substring match would accept "Verify VERSION" for a step
  1457	    actually called "Verify VERSION matches tag", and substring-vs-exact has
  1458	    already cost this repo three incidents in one session."""
  1459	    text = path.read_text(encoding="utf-8")
  1460	    names = []
  1461	    for m in re.finditer(r"(?m)^\s*-\s+name:\s*(.+?)\s*$", text):
  1462	        name = m.group(1)
  1463	        if len(name) >= 2 and name[0] == name[-1] and name[0] in "\"'":
  1464	            name = name[1:-1]
  1465	        names.append(name)
  1466	    return names
