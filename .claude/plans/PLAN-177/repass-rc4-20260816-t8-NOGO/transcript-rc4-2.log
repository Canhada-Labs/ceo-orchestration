  1648	def test_integrity_doc_makes_no_enforced_claim_for_the_tarball_checksum():
  1649	    """The narrower half of P1-3, plus the whole-file sweep that followed it.
  1650	    `SHA256SUMS.txt` is written by a LOCAL `scripts/install-npm.sh` run, is
  1651	    excluded from the package `files:` array, and no workflow materialises a
  1652	    `.tgz` to hash — so the consumer recipe this file used to publish was
  1653	    impossible, and is REMOVED rather than caveated."""
  1654	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1655	    header = doc.split("## Contract", 1)[0]
  1656	    assert "no** per-tarball" in header or "no per-tarball" in header, (
  1657	        "header no longer states that the tarball checksum is absent"
  1658	    )
  1659	    assert "scripts/install-npm.sh" in doc, (
  1660	        "the doc does not attribute SHA256SUMS.txt to its real, local writer"
  1661	    )
