  1568	def test_integrity_contract_rows_name_a_live_step():
  1569	    """P1-3. The contract claimed a per-tarball SHA-256 manifest was
  1570	    "enforced today" and pointed at `validate.yml (to-add)`: a guarantee whose
  1571	    alleged gate could not fail because it did not exist. A row now declares a
  1572	    Status from a closed set, and an `enforced` one must name a step that is
  1573	    really in the YAML."""
  1574	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1575	    rows = _contract_rows(doc)
  1576	    assert len(rows) >= 5, "Contract table parsed as %d rows" % len(rows)
  1577	
  1578	    pairs = _integrity_enforced_pairs(doc)
  1579	    assert len(pairs) >= _MIN_ENFORCED_PAIRS, (
  1580	        "only %d enforced (workflow, step) claims parsed — below the floor of "
  1581	        "%d. Either the table stopped documenting enforcement, or its format "
  1582	        "changed and this gate is now checking nothing."
  1583	        % (len(pairs), _MIN_ENFORCED_PAIRS)
  1584	    )
  1585	
  1586	    # (a) a renamed step must go red. The fixture is DERIVED from the parsed
  1587	    # table, never a hand-typed row literal: an anchor typed here stops
  1588	    # matching the day that row is edited, and the control dies quietly.
  1589	    step = pairs[0][2]
  1590	    renamed = doc.replace('step "%s"' % step, 'step "%s renamed"' % step, 1)
  1591	    assert renamed != doc, "rename fixture did not patch the doc"
  1592	    renamed_offenders = _integrity_contract_offenders(renamed, REPO_ROOT)
  1593	    assert any("renamed" in o for o in renamed_offenders), (
  1594	        "control did not flag a row naming a nonexistent step: %s"
  1595	        % renamed_offenders
  1596	    )
  1597	
  1598	    # (b) a table with NO parseable step claim must go red on the COUNT, not
  1599	    # report zero offenders. That is the vacuity failure itself.
  1600	    stripped = doc.replace('step "', "step ")
  1601	    assert len(_integrity_enforced_pairs(stripped)) < _MIN_ENFORCED_PAIRS, (
  1602	        "a table with no parseable step claim still met the floor — the count "
  1603	        "check cannot detect vacuity"
  1604	    )
  1605	
  1606	    # (c) unknown Status vocabulary must go red, not be waved through.
  1607	    unknown = doc.replace("| enforced |", "| mostly enforced |", 1)
  1608	    assert unknown != doc, "status fixture did not patch the doc"
  1609	    assert any(
  1610	        "outside the closed set" in o
  1611	        for o in _integrity_contract_offenders(unknown, REPO_ROOT)
  1612	    ), "an unknown Status was accepted"
  1613	
  1614	    offenders = _integrity_contract_offenders(doc, REPO_ROOT)
  1615	    assert not offenders, "npm/INTEGRITY.md contract row without a live step:\n%s" % (
  1616	        "\n".join(offenders)
  1617	    )
