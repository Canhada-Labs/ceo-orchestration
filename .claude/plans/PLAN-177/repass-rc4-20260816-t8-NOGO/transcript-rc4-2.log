   536	# description: if the two disagree the preview was truncated or redacted, i.e.
   537	# not this short, secret-free probe line. Anything else counts. Every
   538	# uncertainty resolves toward VISIBLE.
   539	_HARNESS_PROBE_DESC_RE = re.compile(
   540	    r"\ALoad [A-Za-z0-9_.\-]+(?:,[ ]?[A-Za-z0-9_.\-]+)* via ToolSearch\?\Z"
   541	)
   542	
   543	
   544	def _has_harness_probe_fingerprint(ev: Dict[str, Any]) -> bool:
   545	    """True iff the row carries the CLOSED, observed harness-probe signature.
   546	
   547	    Positive identification, never inferred from missing fields. An absent or
   548	    non-matching `desc_hash` is NOT corroboration, so it returns False and the
   549	    row is counted — the safe direction for an advisory that exists to expose
   550	    unclassified spawns.
   551	    """
   552	    desc = ev.get("desc_preview")
   553	    if not isinstance(desc, str) or not _HARNESS_PROBE_DESC_RE.match(desc):
   554	        return False
   555	    digest = ev.get("desc_hash")
   556	    if not isinstance(digest, str) or not digest:
   557	        return False
   558	    return digest == hashlib.sha256(desc.encode("utf-8")).hexdigest()
   559	
