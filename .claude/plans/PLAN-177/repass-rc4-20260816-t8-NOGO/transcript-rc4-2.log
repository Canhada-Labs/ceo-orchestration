   215	          set -euo pipefail
   216	          bash scripts/tests/test-ownership-nightly-gate.sh
   217	
   218	      # PLAN-168 W2 (AC-6, per-PR half of INV-4): the shared pointer
   219	      # generator's 8-scenario control — includes ONE real install (~1-2 min
   220	      # on CI iron). The full install->upgrade->cure e2e (4 legs, ~5 min CI)
