   106	    name: Await release-gate (release.yml)
   107	    runs-on: ubuntu-latest
   108	    # 50 > the poller's own 45-minute deadline, so a timeout surfaces as
   109	    # the decision function's fail-CLOSED BLOCK (with its inputs printed),
   110	    # not as an opaque runner kill. 45 min > the release-gate's own
