  1342	# ===========================================================================
  1343	# PLAN-177 W0 — the npm/ surfaces: a version nobody watched (P1-2) and an
  1344	# "enforced today" guarantee with no step behind it (P1-3).
  1345	# ===========================================================================
  1346	
  1347	# The npm docs are DERIVED from SCAN_ROOTS, not re-typed: adding a third npm
  1348	# surface up there extends this rule too, and the two lists cannot drift.
  1349	# What stays out, and why the predicate is narrow ON PURPOSE:
  1350	#   * `npm/SHA256SUMS.txt` records tarball FILENAMES
  1351	#     (`ceo-orchestration-<version>.tgz`) — historical data about a build that
  1352	#     happened, not a claim about the current release. Flagging it would train
  1353	#     whoever hits the red to add an exemption, and an exemption is how a
  1354	#     control stops controlling.
  1355	#   * `npm/.npmignore` cites past packaging incidents by the version they
  1356	#     happened in — same category.
  1357	#   * `npm/package.json` is a real bump site with a real oracle
  1358	#     (`_release_bump_sites.py` + verify-counts); it is written, not stale.
  1359	# Prose in a shipped `.md` is the only one that can go stale silently, which
  1360	# is exactly what happened.
  1361	NPM_DOC_SURFACES = tuple(
  1362	    root for root in SCAN_ROOTS if root.startswith("npm/") and root.endswith(".md")
  1363	)
  1364	# The one legitimate version literal in an npm doc: the review stamp, itself a
  1365	# bump site (`("npm/README.md", STAMP, STAMP_RX)`), so it has an oracle.
  1366	_STAMP_LINE_RX = re.compile(r"last-reviewed:\s*\d{4}-\d{2}-\d{2}\s+v\d+\.\d+\.\d+")
