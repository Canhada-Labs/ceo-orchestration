     1	#!/usr/bin/env bash
     2	# uninstall.sh — manifest-honoring uninstaller for ceo-orchestration
     3	# (PLAN-083 sub-1.9)
     4	#
     5	# Safety property: ONLY removes files whose current sha256 matches the
     6	# recorded manifest entry. Files modified by the user post-install have
     7	# divergent SHAs and are PRESERVED. Files NOT listed in the manifest
     8	# (Owner-authored, never installed by us) are also PRESERVED.
     9	#
    10	# Usage:
    11	#   ./uninstall.sh <target-repo-path> [options]
    12	#
    13	# Options:
    14	#   --dry-run                  Preview what WOULD be removed; touch nothing
    15	#   --restore <backup-path>    Inverse mode: restore .claude/ from a backup .tar.gz
    16	#   --force                    Remove files even if SHA mismatches (DESTRUCTIVE)
    17	#   --no-backup                Skip the pre-uninstall backup tarball
    18	#   --no-hmac-verify           Skip HMAC verification of the manifest sidecar
    19	#   -h, --help                 Show this help
    20	#
    21	# Exit codes:
    22	#   0  success (or dry-run preview)
    23	#   1  generic failure / invalid args
    24	#   2  target path invalid OR no manifest found
    25	#   3  HMAC verification failed (manifest tampered)
    26	#   4  --restore: backup tar.gz invalid or HMAC mismatch
    27	#   5  --force not provided when SHA mismatches encountered
    28	#
    29	# Bash 3.2 portability guard
    30	if [ -z "${BASH_VERSINFO:-}" ]; then
    31	  echo "ERROR: uninstall.sh requires bash" >&2
    32	  exit 1
    33	fi
    34	if [ "${BASH_VERSINFO[0]}" -lt 3 ] || \
    35	   { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
    36	  echo "ERROR: uninstall.sh requires bash >= 3.2 (detected ${BASH_VERSION})" >&2
    37	  exit 1
    38	fi
    39	
    40	set -euo pipefail
    41	
    42	TARGET=""
    43	DRY_RUN=0
    44	RESTORE_PATH=""
    45	FORCE=0
    46	NO_BACKUP=0
    47	NO_HMAC_VERIFY=0
    48	
    49	while [ $# -gt 0 ]; do
    50	  case "$1" in
    51	    --dry-run)         DRY_RUN=1; shift ;;
    52	    --restore)         RESTORE_PATH="${2:-}"; shift 2 ;;
    53	    --restore=*)       RESTORE_PATH="${1#--restore=}"; shift ;;
    54	    --force)           FORCE=1; shift ;;
    55	    --no-backup)       NO_BACKUP=1; shift ;;
    56	    --no-hmac-verify)  NO_HMAC_VERIFY=1; shift ;;
    57	    -h|--help)
    58	      sed -n '1,30p' "${BASH_SOURCE[0]}"
    59	      exit 0
    60	      ;;
    61	    -*)
    62	      echo "ERROR: unknown option: $1" >&2
    63	      exit 1
    64	      ;;
    65	    *)
    66	      TARGET="$1"
    67	      shift
    68	      ;;
    69	  esac
    70	done
    71	
    72	if [ -z "$TARGET" ] || [ ! -d "$TARGET" ]; then
    73	  echo "Usage: $0 <target-repo-path> [--dry-run | --restore <backup.tar.gz> | --force]" >&2
    74	  exit 1
    75	fi
    76	
    77	TARGET="$( cd "$TARGET" && pwd )"
    78	
    79	_log() { printf '%s\n' "$*"; }
    80	_dry() {
    81	  if [ "$DRY_RUN" -eq 1 ]; then
    82	    printf '(dry-run) %s\n' "$*"
    83	    return 0
    84	  fi
    85	  return 1
    86	}
    87	
    88	# ---------------------------------------------------------------------------
    89	# Resolve HMAC backup key (same algorithm as install.sh)
    90	# ---------------------------------------------------------------------------
    91	_resolve_backup_key() {
    92	  if [ -f "$TARGET/.claude/.audit-key" ]; then
    93	    printf '%s\n' "$TARGET/.claude/.audit-key"
    94	    return 0
    95	  fi
    96	  if [ -f "$TARGET/.claude/.install-backup-key" ]; then
    97	    printf '%s\n' "$TARGET/.claude/.install-backup-key"
    98	    return 0
    99	  fi
   100	  return 1
   101	}
   102	
   103	# ---------------------------------------------------------------------------
   104	# RESTORE MODE — invert a backup
   105	# ---------------------------------------------------------------------------
   106	if [ -n "$RESTORE_PATH" ]; then
   107	  if [ ! -f "$RESTORE_PATH" ]; then
   108	    echo "ERROR: backup file not found: $RESTORE_PATH" >&2
   109	    exit 4
   110	  fi
   111	  _log "==> Restore mode: $RESTORE_PATH -> $TARGET"
   112	
   113	  # Optional HMAC verification of backup
   114	  if [ -f "$RESTORE_PATH.hmac" ] && [ "$NO_HMAC_VERIFY" -eq 0 ]; then
   115	    key_path="$(_resolve_backup_key || true)"
   116	    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
   117	      expected_hmac="$(awk '{print $1; exit}' "$RESTORE_PATH.hmac")"
   118	      actual_hmac="$(python3 -c "
   119	import hashlib, hmac, sys
   120	key = open('$key_path', 'rb').read()
   121	tar_sha = hashlib.sha256(open('$RESTORE_PATH', 'rb').read()).digest()
   122	sys.stdout.write(hmac.new(key, tar_sha, hashlib.sha256).hexdigest())
   123	")"
   124	      if [ "$expected_hmac" != "$actual_hmac" ]; then
   125	        echo "ERROR: backup HMAC mismatch — tarball may have been tampered with" >&2
   126	        echo "       expected: $expected_hmac" >&2
   127	        echo "       actual:   $actual_hmac" >&2
   128	        exit 4
   129	      fi
   130	      _log "    Backup HMAC verified."
   131	    else
   132	      _log "    NOTE: no backup key found; skipping HMAC verification"
   133	    fi
   134	  fi
   135	
   136	  if _dry "would EXTRACT $RESTORE_PATH into $TARGET"; then
   137	    exit 0
   138	  fi
   139	
   140	  # Move existing .claude/ aside (safety net)
   141	  if [ -d "$TARGET/.claude" ]; then
   142	    aside="$TARGET/.claude.pre-restore-$(date -u +%Y%m%d-%H%M%SZ)"
   143	    _log "    Moving current .claude/ aside to: $aside"
   144	    mv "$TARGET/.claude" "$aside"
   145	  fi
   146	
   147	  _log "    Extracting backup..."
   148	  ( cd "$TARGET" && tar xzf "$RESTORE_PATH" )
   149	  _log "    Restore complete."
   150	  exit 0
   151	fi
   152	
   153	# ---------------------------------------------------------------------------
   154	# UNINSTALL MODE — manifest-honoring removal
   155	# ---------------------------------------------------------------------------
   156	MANIFEST="$TARGET/.claude/.install-manifest.sha256"
   157	
   158	if [ ! -f "$MANIFEST" ]; then
   159	  echo "ERROR: install manifest not found at $MANIFEST" >&2
   160	  echo "       This target was not installed via PLAN-083 install.sh." >&2
   161	  echo "       To remove manually, see INSTALL.md §Uninstall." >&2
   162	  exit 2
   163	fi
   164	
   165	_log "==> Uninstall mode (manifest-honoring)"
   166	_log "    Target:   $TARGET"
   167	_log "    Manifest: $MANIFEST"
   168	_log "    Dry-run:  $DRY_RUN"
   169	_log "    Force:    $FORCE"
   170	_log ""
   171	
   172	# Pre-uninstall backup (unless --no-backup)
   173	if [ "$NO_BACKUP" -eq 0 ]; then
   174	  if ! _dry "would BACKUP .claude/ before uninstall"; then
   175	    timestamp="$(date -u +%Y%m%d-%H%M%SZ)"
   176	    backup="$TARGET/.claude.backup-uninstall-$timestamp.tar.gz"
   177	    _log "==> Pre-uninstall backup: $backup"
   178	    ( cd "$TARGET" && tar czf "$backup" .claude/ 2>/dev/null )
   179	    key_path="$(_resolve_backup_key || true)"
   180	    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
   181	      backup_hmac="$(python3 -c "
   182	import hashlib, hmac, sys
   183	key = open('$key_path', 'rb').read()
   184	tar_sha = hashlib.sha256(open('$backup', 'rb').read()).digest()
   185	sys.stdout.write(hmac.new(key, tar_sha, hashlib.sha256).hexdigest())
   186	")"
   187	      printf '%s  %s\n' "$backup_hmac" "$backup" > "$backup.hmac"
   188	      chmod 0600 "$backup.hmac"
   189	    fi
   190	  fi
   191	fi
   192	
   193	# Walk the manifest; for each entry, verify SHA before delete.
   194	mismatch_count=0
   195	removed_count=0
   196	preserved_count=0
   197	absent_count=0
   198	mismatch_files=""
   199	
   200	while IFS= read -r line; do
   201	  # Skip comments and blank lines
   202	  case "$line" in
   203	    '#'*|'') continue ;;
   204	  esac
   205	  # Format: <sha>  <relpath>
   206	  recorded_sha="${line%% *}"
   207	  rel="${line#* }"
   208	  rel="${rel#* }"  # strip second space if double-space format
   209	  rel="$(printf '%s' "$line" | awk '{ $1=""; sub(/^ +/, ""); print }')"
   210	  fpath="$TARGET/$rel"
   211	
   212	  if [ ! -e "$fpath" ]; then
   213	    absent_count=$((absent_count + 1))
   214	    continue
   215	  fi
   216	
   217	  if [ ! -f "$fpath" ]; then
   218	    continue
   219	  fi
   220	
   221	  actual_sha="$(python3 -c "
   222	import hashlib, sys
   223	with open(sys.argv[1], 'rb') as f:
   224	    sys.stdout.write(hashlib.sha256(f.read()).hexdigest())
   225	" "$fpath")"
   226	
   227	  if [ "$actual_sha" = "$recorded_sha" ]; then
   228	    if _dry "would REMOVE $rel"; then
   229	      removed_count=$((removed_count + 1))
   230	    else
   231	      rm -f "$fpath"
   232	      removed_count=$((removed_count + 1))
   233	    fi
   234	  else
   235	    mismatch_count=$((mismatch_count + 1))
   236	    mismatch_files="$mismatch_files $rel"
   237	    if [ "$FORCE" -eq 1 ]; then
   238	      if _dry "would FORCE-REMOVE (sha mismatch) $rel"; then
   239	        removed_count=$((removed_count + 1))
   240	      else
   241	        rm -f "$fpath"
   242	        removed_count=$((removed_count + 1))
   243	      fi
   244	    else
   245	      preserved_count=$((preserved_count + 1))
   246	      _log "    PRESERVED (sha mismatch, user-modified): $rel"
   247	    fi
   248	  fi
   249	done < "$MANIFEST"
   250	
   251	# Refuse if mismatches encountered without --force
   252	if [ "$mismatch_count" -gt 0 ] && [ "$FORCE" -eq 0 ]; then
   253	  _log ""
   254	  _log "==> Uninstall summary (incomplete):"
   255	  _log "    Removed:   $removed_count"
   256	  _log "    Preserved: $preserved_count (user-modified — sha didn't match manifest)"
   257	  _log "    Absent:    $absent_count (already gone)"
   258	  _log ""
   259	  _log "    To force-remove user-modified files: re-run with --force"
   260	  _log "    Preserved files were NOT touched."
   261	  exit 0
   262	fi
   263	
   264	# Clean up manifest + empty .claude/ subdirs (only if everything matched)
   265	if ! _dry "would REMOVE manifest $MANIFEST"; then
   266	  if [ "$mismatch_count" -eq 0 ] || [ "$FORCE" -eq 1 ]; then
   267	    rm -f "$MANIFEST"
   268	  fi
   269	fi
   270	
   271	# Clean up empty directories under .claude/ (post-removal sweep)
   272	if [ "$DRY_RUN" -eq 0 ] && [ -d "$TARGET/.claude" ]; then
   273	  find "$TARGET/.claude" -depth -type d -empty -delete 2>/dev/null || true
   274	fi
   275	
   276	_log ""
   277	_log "==> Uninstall summary:"
   278	_log "    Removed:   $removed_count"
   279	_log "    Preserved: $preserved_count"
   280	_log "    Absent:    $absent_count"
   281	_log "    Manifest:  $([ -f "$MANIFEST" ] && echo "KEPT" || echo "REMOVED")"
   282	exit 0
