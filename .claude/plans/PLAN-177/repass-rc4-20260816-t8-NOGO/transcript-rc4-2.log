   161	
   162	      # PLAN-166 F4: the parity e2e's historical leg installs from a PINNED
   163	      # TAG. `fetch-depth: 1` produces a checkout with NO tags, so the pin
   164	      # would not resolve and the gate would die before comparing a single
   165	      # tree - "it passes on my clone" is precisely the hole this test exists
   166	      # to close. The pin is READ FROM THE TEST (--print-pin) so the workflow
   167	      # never becomes a second copy of that truth.
   168	      - name: Fetch the parity pin tag
   169	        run: |
   170	          set -euo pipefail
   171	          PIN="$(bash scripts/tests/test-install-upgrade-parity-e2e.sh --print-pin)"
   172	          echo "parity historical pin: $PIN"
   173	          git fetch --no-tags --depth 1 origin "+refs/tags/$PIN:refs/tags/$PIN"
   174	          git rev-parse --verify "refs/tags/$PIN^{commit}"
   175	
   176	      - name: Setup Python 3.11
   177	        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
   178	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
