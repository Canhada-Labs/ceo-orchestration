   609	def check_skill_unknown_ratio() -> Tuple[str, str, Any]:
   610	    """Detect spawns that should have SKILL injection but didn't.
   611	
   612	    S94 follow-up: excludes intentionally skill-less archetypes —
   613	    `general-purpose` subagent dispatches via the mitigated rail
   614	    (ADR-082) by design have no SKILL.md anchor. They broker cross-
   615	    LLM gate calls and similar utility work; counting them as FPs
   616	    inflates the ratio to 100% during healthy Codex MCP sessions
   617	    and trains the operator to ignore the channel.
   618	
   619	    A spawn counts as "skill missing" ONLY when its `archetype` is
   620	    a custom (non-general-purpose) one AND `skill` is unknown/empty.
   621	    That is the original PLAN-020 ADR-051 governance gap the
   622	    detector was built for.
   623	    """
   624	    # T-2 STATUS (re-pass rc.4 t5 P2): DEFERRED, not cured. Both the S86
   625	    # ghost filter and the S303 probe filter are RETIRED (absence-based,
   626	    # caller-forgeable); every agent_spawn row counts until the EMITTER can
   627	    # stamp provenance the caller cannot forge. The skipped counters were
   628	    # removed with them — a permanently-zero counter reads as "filter
   629	    # active, nothing skipped", which is the wrong claim.
   630	    total = 0
   631	    unknown = 0
   632	    skill_less_by_design = 0
   633	    test_pollution_skipped = 0
   634	    for ev in _iter_audit_events_since(24):
   635	        if ev.get("action") != "agent_spawn":
   636	            continue
   637	        if _is_test_pollution_event(ev):
   638	            test_pollution_skipped += 1
   639	            continue
   640	        # T-2 deferred (t5 P2): ghost/probe exemptions RETIRED — the shape
   641	        # detectors above stay tested for a future provenance-bearing
   642	        # emitter, but no row is skipped on caller-controlled absence.
   643	
   644	        # Skill-less by design: general-purpose archetype dispatches
   645	        # (mitigated rail per ADR-082) AND built-in subagent types like
   646	        # Explore/Plan/claude-code-guide that have no .claude/agents/<name>.md
   647	        # and so cannot carry a `Loads <skill> skill via reference` phrase
   648	        # (drift-detector contract per S143 lesson). Adding them to
   649	        # _ARCHETYPE_TO_SKILL would violate the contract — exclude here instead.
   650	        # S200: claude/claude-code-guide/statusline-setup are first-party
   651	        # Claude Code built-ins (no .claude/agents anchor); counting them as a
   652	        # governance gap is a false positive — exactly the FP class this filter
   653	        # exists to prevent (else healthy claude-code-guide use trains the
   654	        # operator to ignore the channel).
   655	        _SKILL_LESS_BUILTINS = {
   656	            "general-purpose", "Explore", "Plan",
   657	            "claude", "claude-code-guide", "statusline-setup",
   658	        }
   659	        if (
   660	            ev.get("subagent_type") in _SKILL_LESS_BUILTINS
   661	            and ev.get("archetype") in _SKILL_LESS_BUILTINS
   662	        ):
   663	            skill_less_by_design += 1
   664	            continue
   665	        total += 1
   666	        if ev.get("skill") in (None, "unknown", ""):
   667	            unknown += 1
   668	    if total == 0:
   669	        msg = (
   670	            "no custom-archetype spawns "
   671	            "({s} general-purpose, {t} test-pollution)".format(
   672	                s=skill_less_by_design, t=test_pollution_skipped,
   673	            )
   674	        )
   675	        return "green", msg, {
   676	            "unknown": 0, "total": 0,
   677	            "skill_less_by_design": skill_less_by_design,
   678	            "test_pollution_skipped": test_pollution_skipped,
   679	        }
   680	    ratio = unknown / total
   681	    status = "red" if ratio > 0.10 else "yellow" if ratio > 0 else "green"
   682	    return status, f"{unknown}/{total} = {ratio:.0%}", {
   683	        "unknown": unknown, "total": total,
   684	        "skill_less_by_design": skill_less_by_design,
   685	        "test_pollution_skipped": test_pollution_skipped,
   686	    }
