    84	# _framework_path_excluded — PLAN-161 U2 (CF-7): the SINGLE canonical
    85	# framework-internal exclusion predicate. $1 = repo-relative path. Returns 0
    86	# (excluded) for content the framework NEVER ships to adopters — the dogfood
    87	# test/legacy trees, the two pytest-importing _lib helpers, __pycache__ dirs
    88	# and *.pyc anywhere. Also matches the bare directory paths themselves (no
    89	# trailing slash/content) so callers can test dirs. Mirrors install.sh's
    90	# structural exclusions (install_hooks_selective / install_lib_selective /
    91	# install_scripts_selective); install.sh's _lib walk now calls THIS predicate,
    92	# and upgrade.sh applies it at its three write surfaces (classified union
    93	# walk, legacy cp -R prune, manifest enumeration below).
    94	# bash 3.2-safe: pure case globs, no arrays.
    95	_framework_path_excluded() {
    96	  case "$1" in
    97	    .claude/hooks/tests|.claude/hooks/tests/*) return 0 ;;
    98	    .claude/hooks/legacy|.claude/hooks/legacy/*) return 0 ;;
    99	    .claude/scripts/tests|.claude/scripts/tests/*) return 0 ;;
   100	    .claude/hooks/_lib/tests|.claude/hooks/_lib/tests/*) return 0 ;;
   101	    .claude/hooks/_lib/test_isolation.py) return 0 ;;
   102	    .claude/hooks/_lib/testing.py) return 0 ;;
   103	    __pycache__|*/__pycache__|__pycache__/*|*/__pycache__/*) return 0 ;;
   104	    *.pyc) return 0 ;;
   105	  esac
   106	  return 1
   107	}
   108	
   109	# _framework_target_entries — the top-level target relpaths (files + dirs),
   110	# profile-aware, sorted + deduped. This is the STATIC intended set; it does not
   111	# touch disk (so install and upgrade derive an identical list regardless of
   112	# what is currently present).
   113	_framework_target_entries() {
   114	  {
   115	    # Root governance pointer (the verified S238 driver target — outside
   116	    # .claude/). PLAN-166 F3 (ADR-155-AMEND-1): CONDITIONAL on the recorded
   117	    # delivery. A `--ceremony user` install SKIPS install_protocol_pointer
   118	    # (install.sh WS4-guard-proto), and a maintainer target that ALREADY had
   119	    # its own root PROTOCOL.md was never written by the framework —
   120	    # enumerating it unconditionally records the ADOPTER's file as
   121	    # framework-owned (r13/r17).
   122	    if [ "${FMS_DELIVERED_PROTOCOL:-0}" = "1" ]; then
   123	      printf '%s\n' "PROTOCOL.md"
   124	    fi
   125	
   126	    # SPEC/v1 published contract (PLAN-166 F3): an upgrade surface as of
   127	    # v1.3.0 — same delivery-record condition (never ceremony alone, never
   128	    # file presence; r7/r17).
   129	    if [ "${FMS_DELIVERED_SPEC:-0}" = "1" ]; then
   130	      printf '%s\n' "SPEC/v1"
   131	    fi
   132	
   133	    # Framework version marker (PLAN-166 F3): a NORMAL tracked-file entry —
   134	    # present in the source tree, so the FMS_HASH_ROOT baseline rewrite
   135	    # (below) preserves it with no generated-file special-case — but
   136	    # ownership still derives from the registered delivery: a target whose
   137	    # marker pre-existed (install_one EXISTS-skip) stays adopter-owned and
   138	    # every marker-first reader keyed off this same record falls back to
   139	    # VERSION (r20).
   140	    if [ "${FMS_DELIVERED_MARKER:-0}" = "1" ]; then
   141	      printf '%s\n' ".claude/.framework-version"
   142	    fi
   143	
   144	    # Always-installed team rosters + universal catalogs.
   145	    printf '%s\n' ".claude/team.md"
   146	    printf '%s\n' ".claude/frontend-team.md"
   147	    printf '%s\n' ".claude/pitfalls-catalog.yaml"
   148	    printf '%s\n' ".claude/task-chains.yaml"
   149	    # Framework schema contracts (re-pass rc.4 t5 P1): enumerated so the
   150	    # NEXT generation's baseline manifest classifies them 3-state instead
   151	    # of the hash-gated legacy path in upgrade.sh.
   152	    printf '%s\n' ".claude/plans/PLAN-SCHEMA.md"
   153	    printf '%s\n' ".claude/plans/DEBATE-SCHEMA.md"
   154	
   155	    # Protocol-enforcement directory targets (always installed).
   156	    printf '%s\n' ".claude/hooks"
   157	    printf '%s\n' ".claude/scripts"
   158	    printf '%s\n' ".claude/commands"
   159	
   160	    # Skills are profile-gated.
   161	    if _fms_has_profile "core"; then
   162	      printf '%s\n' ".claude/skills/core"
   163	    fi
   164	    if _fms_has_profile "frontend"; then
   165	      printf '%s\n' ".claude/skills/frontend"
   166	    fi
   167	    # Domain profiles: any profile part that is neither core nor frontend.
   168	    for _fms_part in $( _fms_profile_parts ); do
   169	      case "$_fms_part" in
   170	        core|frontend) : ;;
   171	        *) printf '%s\n' ".claude/skills/domains/$_fms_part" ;;
   172	      esac
   173	    done
   174	  } | LC_ALL=C sort -u
   175	}
   176	
   177	# _framework_manifest_files — expand every target entry into its per-file
   178	# relpaths, relative to FMS_ROOT. Directories are walked (regular files only;
   179	# symlinks are NOT followed into — a symlinked file is emitted as its own
   180	# relpath and the manifest writer records it as a LINK record). EXCLUDES the
   181	# manifest dotfile + .claude.bak/. Sorted + deduped. Missing entries (e.g. a
   182	# profile dir absent on disk) are silently skipped — profile-awareness.
   183	_framework_manifest_files() {
   184	  _fms_root="${FMS_ROOT:-.}"
   185	  {
   186	    _framework_target_entries | while IFS= read -r _fms_entry; do
   187	      [ -n "$_fms_entry" ] || continue
   188	      _fms_abs="$_fms_root/$_fms_entry"
   189	      if [ -f "$_fms_abs" ] || [ -L "$_fms_abs" ]; then
   190	        # A plain file (or symlinked file) target.
   191	        printf '%s\n' "$_fms_entry"
   192	      elif [ -d "$_fms_abs" ]; then
   193	        # Walk the directory for regular files + symlinks. `-print` with a
   194	        # leading "./"-stripped relpath; we re-root each hit at $_fms_entry.
   195	        # bash 3.2-safe: no mapfile; pipe find into a read loop.
   196	        find "$_fms_abs" \( -type f -o -type l \) -print 2>/dev/null | while IFS= read -r _fms_hit; do
   197	          # Strip the "$_fms_root/" prefix to get a repo-relative path.
   198	          _fms_rel="${_fms_hit#"$_fms_root"/}"
   199	          printf '%s\n' "$_fms_rel"
   200	        done
   201	      fi
   202	      # else: entry absent on disk for this profile — skip (profile-aware).
   203	    done
   204	  } | grep -v -e '^\.claude/\.install-manifest\.sha256$' \
   205	            -e '^\.claude\.bak/' \
   206	            -e '/\.claude\.bak/' \
   207	            -e '/__pycache__/' \
   208	            -e '\.pyc$' \
   209	    | while IFS= read -r _fms_out; do
   210	        # PLAN-161 U2 (CF-7): never record framework-internal excluded paths
   211	        # in the baseline — recording them would legitimize a mis-install
   212	        # (and the upgrade would re-add what an adopter deleted by hand).
   213	        if ! _framework_path_excluded "$_fms_out"; then
   214	          printf '%s\n' "$_fms_out"
   215	        fi
   216	      done \
   217	    | LC_ALL=C sort -u
   218	}
   219	
   220	# _write_baseline_manifest — THE single baseline-manifest generator (ADR-155
   221	# decision (iv)). Called by install.sh write_install_manifest AND by upgrade.sh
   222	# after a successful upgrade, so a long-lived adopter who upgrades but never
   223	# re-runs install.sh acquires/refreshes a manifest.
   224	#
   225	# Inputs (callers export these before calling):
   226	#   FMS_ROOT          — the installed target root (paths are relative to it)
   227	#   FMS_PROFILE_PARTS — space-separated profile list (profile-aware enumeration)
   228	#   FMS_MODE          — "link" to emit LINK records for symlinks, else "copy"
   229	# Requires _hash_file (from _hash_lib.sh) on PATH. Writes validated records to
   230	# $1 (the manifest path) atomically. Fail-open: returns 0 with a stderr NOTE on
   231	# any problem; never aborts the caller.
   232	#
   233	# Grammar:
   234	#   <64hex>  <relpath>          — content hash
   235	#   LINK  <relpath>  <target>   — link-mode symlink (content == source)
   236	
   237	# Does FMS_HASH_ROOT apply to this relpath? UNSET FMS_HASH_ROOT_PATHS means
   238	# ALL of them — the upgrade posture, where every enumerated file must record
   239	# what the framework SHIPS. install.sh needs the opposite default for most of
   240	# the tree: it RENDERS templates (`.claude/team.md`, skills, `{{X}}`
   240	# the tree: it RENDERS templates (`.claude/team.md`, skills, `{{X}}`
   241	# placeholders under --project et al), so those legitimately differ from
   242	# source and their baseline must be the rendered TARGET. A global
   243	# FMS_HASH_ROOT on an install rerun rewrote every rendered file's hash to the
   244	# unrendered source, which doctor.sh reads as widespread adopter drift and
   245	# later upgrades read as customized => the files stop being refreshed (codex
   246	# W1 round 8, P1). Scoping the override to the ownership-continuity paths
   247	# keeps the round-5 fix (an EDITED delivered SPEC must not be re-baselined as
   248	# framework-owned, or uninstall would delete the adopter's fork) without
   249	# touching the rendered tree. Prefix match: an entry covers the path itself
   250	# and everything under it.
   251	_wbm_hash_root_applies() {
   252	  [ -n "${FMS_HASH_ROOT_PATHS:-}" ] || return 0
   253	  _hra_rel="$1"
   254	  _hra_oldIFS="$IFS"
   255	  IFS='
   256	'
   257	  for _hra_p in $FMS_HASH_ROOT_PATHS; do
   258	    [ -n "$_hra_p" ] || continue
   259	    case "$_hra_rel" in
   260	      "$_hra_p"|"$_hra_p"/*)
   261	        IFS="$_hra_oldIFS"
   262	        return 0
   263	        ;;
   264	    esac
   265	  done
   266	  IFS="$_hra_oldIFS"
   267	  return 1
   268	}
   269	
   270	# May this relpath be serialized as a LINK record? UNSET FMS_LINK_PATHS means
   271	# ANY live symlink may — correct on the INSTALL path, where the installer
   272	# itself created every symlink it is about to record. On the UPGRADE rewrite
   273	# that default is too wide (codex W1 round 10, P2): FMS_MODE=link is inferred
   274	# from the presence of ANY prior LINK record, and every live symlink then
   275	# serializes as a delivery record — including an adopter's OWN symlink
   276	# preserved inside an enumerated directory like `.claude/hooks/`, converting
   277	# an unowned path into framework-managed content that doctor.sh polices.
   278	# upgrade.sh passes the exact set of pre-upgrade LINK relpaths instead.
   279	_wbm_link_allowed() {
   280	  [ -n "${FMS_LINK_PATHS:-}" ] || return 0
   281	  _wla_rel="$1"
   282	  _wla_oldIFS="$IFS"
   283	  IFS='
   284	'
   285	  for _wla_p in $FMS_LINK_PATHS; do
   286	    [ -n "$_wla_p" ] || continue
   287	    if [ "$_wla_rel" = "$_wla_p" ]; then
   288	      IFS="$_wla_oldIFS"
   289	      return 0
   290	    fi
   291	  done
   292	  IFS="$_wla_oldIFS"
   293	  return 1
   294	}
   295	
   296	# --- PLAN-167 W2.3: the DECISION reaches the generator ----------------------
   297	# _ownership_verdict chooses a hash_source per conditional surface; the writer
   298	# obeys it instead of falling back to a default. Across all 62 rows of the
   299	# table the default (HASH_TARGET) is never the correct answer, and it is
   300	# exactly what let three P1 defects re-baseline adopter content as
   301	# framework-owned (docs §3.4).
   302	_wbm_declared_hash_source() {
   303	  case "$1" in
   304	    SPEC/v1|SPEC/v1/*)          printf '%s' "${FMS_HASH_SOURCE_SPEC:-}" ;;
   305	    PROTOCOL.md)                printf '%s' "${FMS_HASH_SOURCE_PROTOCOL:-}" ;;
   306	    .claude/.framework-version) printf '%s' "${FMS_HASH_SOURCE_MARKER:-}" ;;
   307	    *)                          printf '' ;;
   308	  esac
   309	}
   310	
   311	_wbm_is_conditional() {
   312	  case "$1" in
   313	    SPEC/v1|SPEC/v1/*|PROTOCOL.md|.claude/.framework-version) return 0 ;;
   314	  esac
   315	  return 1
   316	}
   317	
   318	# The digest the PRE-run manifest recorded. Empty when unavailable, which the
   319	# fail-closed branch turns into "do not record" rather than a guess.
   320	_wbm_prior_digest() {
   321	  [ -n "${FMS_PRIOR_MANIFEST:-}" ] && [ -f "$FMS_PRIOR_MANIFEST" ] || { printf ''; return 0; }
   322	  grep -E "^[0-9a-f]{64}  $1\$" "$FMS_PRIOR_MANIFEST" 2>/dev/null | head -1 | cut -d' ' -f1 || printf ''
   323	}
   324	
   325	_write_baseline_manifest() {
   326	  _wbm_manifest="$1"
   327	  if ! command -v _framework_manifest_files >/dev/null 2>&1 \
   328	     || ! command -v _hash_file >/dev/null 2>&1; then
   329	    echo "    NOTE: baseline manifest skipped — hash/enumeration helpers not sourced" >&2
   330	    return 0
   331	  fi
   332	  : "${FMS_ROOT:?_write_baseline_manifest requires FMS_ROOT}"
   333	  # FMS_HASH_ROOT (optional): hash the FRAMEWORK version of each file from here
   334	  # instead of FMS_ROOT. The ENUMERATION still walks FMS_ROOT (what the target
   335	  # holds), but the recorded baseline must be what the framework SHIPS — never
   336	  # an adopter-customized target file. Without this, upgrade.sh's post-upgrade
   337	  # rewrite (C.7) records hash(customized-but-preserved file) as the baseline,
   338	  # which the NEXT upgrade reads as H_dst==H_base => FRAMEWORK-CHANGED => clobber
   339	  # (the verified C.5 idempotency failure). Default = FMS_ROOT (install path,
   340	  # where the target IS the freshly-written framework version). The root
   341	  # PROTOCOL.md is GENERATED (a pointer), not a source copy, so it always hashes
   342	  # from FMS_ROOT (the target pointer), never FMS_HASH_ROOT. (Codex R1 + dry-run)
   343	  _wbm_hash_root="${FMS_HASH_ROOT:-$FMS_ROOT}"
   344	
   345	  _wbm_tmp="$( mktemp "$_wbm_manifest.XXXXXX" 2>/dev/null )" || {
   346	    echo "    NOTE: baseline manifest skipped (mktemp failed) — advisory only" >&2
   347	    return 0
   348	  }
   349	
   350	  _framework_manifest_files | while IFS= read -r _wbm_rel; do
   351	    [ -n "$_wbm_rel" ] || continue
   352	    _wbm_abs="$FMS_ROOT/$_wbm_rel"
   353	    # Drop relpaths carrying control chars (line-based manifest).
   354	    case "$_wbm_rel" in
   355	      *[$'\n\r\t']*) continue ;;
   356	    esac
   357	    if [ "${FMS_MODE:-copy}" = "link" ] && [ -L "$_wbm_abs" ] \
   358	       && _wbm_link_allowed "$_wbm_rel"; then
   359	      _wbm_target="$( readlink "$_wbm_abs" 2>/dev/null || true )"
   360	      [ -n "$_wbm_target" ] || continue
   361	      case "$_wbm_target" in
   362	        *[$'\n\r\t']*) continue ;;
   363	      esac
   364	      printf 'LINK  %s  %s\n' "$_wbm_rel" "$_wbm_target" >> "$_wbm_tmp"
   365	    elif [ -f "$_wbm_abs" ]; then
   366	      if [ "$_wbm_rel" = "PROTOCOL.md" ]; then
   367	        # Generated pointer. Use the CANONICAL pointer hash (FMS_PROTOCOL_HASH,
   368	        # exported by upgrade.sh _refresh_protocol_pointer) so a PRESERVED
   369	        # adopter-customized PROTOCOL.md is NOT re-recorded as its own baseline
   370	        # (Codex R2 P0 — else the next upgrade reads H_dst==H_base and clobbers
   371	        # it). On install (no FMS_PROTOCOL_HASH) the target IS the freshly
   372	        # written pointer, so hashing it directly is correct.
   373	        if [ -n "${FMS_PROTOCOL_HASH:-}" ]; then
   374	          _wbm_digest="$FMS_PROTOCOL_HASH"
   375	        else
   376	          _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )"
   377	        fi
   378	      elif _wbm_is_conditional "$_wbm_rel"; then
   379	        _wbm_decl="$( _wbm_declared_hash_source "$_wbm_rel" )"
   380	        case "$_wbm_decl" in
   381	          HASH_SOURCE)
   382	            # FMS_SOURCE_ROOT, never FMS_HASH_ROOT: the global override is an
   383	            # upgrade-only mechanism, and borrowing it here is what dragged
   384	            # install into the r8-F1 rendered-tree regression.
   385	            if [ -n "${FMS_SOURCE_ROOT:-}" ] && [ -f "$FMS_SOURCE_ROOT/$_wbm_rel" ]; then
   386	              _wbm_digest="$( _hash_file "$FMS_SOURCE_ROOT/$_wbm_rel" 2>/dev/null || true )"
   387	            else
   388	              continue   # the framework no longer ships it: record nothing
   389	            fi
   390	            ;;
   391	          HASH_PRIOR_RECORD)   _wbm_digest="$( _wbm_prior_digest "$_wbm_rel" )" ;;
   392	          HASH_CANONICAL_POINTER) _wbm_digest="${FMS_PROTOCOL_HASH:-}" ;;
   393	          HASH_TARGET)         _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )" ;;
   394	          HASH_NONE)           continue ;;
   395	          *)
   396	            # FAIL-CLOSED, scoped to the three conditional surfaces (Owner
   397	            # ratified 2026-08-07). Under-claiming is recoverable; over-claiming
   398	            # is the delete-the-adopter's-file class.
   399	            echo "    NOTE: $_wbm_rel delivered but declared no hash_source —" >&2
   400	            echo "          NOT recorded (fail-closed; ownership under-claimed)" >&2
   401	            continue
   402	            ;;
   403	        esac
   404	        case "$_wbm_digest" in
   405	          "" ) continue ;;
   406	        esac
   407	      else
   408	        # Hash the FRAMEWORK version. When FMS_HASH_ROOT is set (upgrade) and the
   409	        # path is ABSENT there, the framework no longer ships it — OMIT it from
   410	        # the baseline (recording the adopter-retained target file would falsely
   411	        # mark it FRAMEWORK-CHANGED if the framework later reintroduces the
   412	        # path). Codex R2 P1.
   413	        _wbm_hash_path="$_wbm_abs"
   414	        if [ -n "${FMS_HASH_ROOT:-}" ] && _wbm_hash_root_applies "$_wbm_rel"; then
   415	          if [ -f "$_wbm_hash_root/$_wbm_rel" ]; then
   416	            _wbm_hash_path="$_wbm_hash_root/$_wbm_rel"
   417	          else
   418	            continue   # framework no longer ships this path — no baseline record
   419	          fi
   420	        fi
   421	        _wbm_digest="$( _hash_file "$_wbm_hash_path" 2>/dev/null || true )"
   422	      fi
   423	      case "$_wbm_digest" in
   424	        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
   425	        *) continue ;;
   426	      esac
   427	      printf '%s  %s\n' "$_wbm_digest" "$_wbm_rel" >> "$_wbm_tmp"
   428	    fi
   429	  done
   430	
   431	  LC_ALL=C sort -u "$_wbm_tmp" > "$_wbm_tmp.sorted" 2>/dev/null && mv "$_wbm_tmp.sorted" "$_wbm_tmp"
   432	  if mv "$_wbm_tmp" "$_wbm_manifest"; then
   433	    echo "    WROTE: $( wc -l < "$_wbm_manifest" | tr -d ' ' ) baseline records -> $_wbm_manifest"
   434	  else
   435	    rm -f "$_wbm_tmp" "$_wbm_tmp.sorted" 2>/dev/null || true
   436	    echo "    NOTE: baseline manifest atomic mv failed — advisory only" >&2
   437	  fi
   438	  return 0
   439	}
