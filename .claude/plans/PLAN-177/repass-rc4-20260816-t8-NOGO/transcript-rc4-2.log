  1833	    """Everything that is neither a Contract table row nor §Not yet
  1834	    automated — the surfaces where a mechanism claim answers to nothing."""
  1835	    body = re.sub(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", "", doc_text)
  1836	    return "\n".join(
  1837	        line for line in body.splitlines() if not line.strip().startswith("|")
  1838	    )
