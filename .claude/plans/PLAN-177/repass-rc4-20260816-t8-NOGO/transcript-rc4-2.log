     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# release.sh — operator release driver. Version-neutral BY NAME.
     4	#
     5	# The previous driver carried a release number in its own FILENAME, and was
     6	# still driving the release after that one — the root of a whole class: a
     7	# driver named for one release is a standing invitation for every other version
     8	# literal inside it to go stale too. Everything release-specific now lives in
     9	# the PER-RELEASE block below, and every message derives from it. The old path
    10	# is deliberately left unspelled on every live surface, so the AC-6 control
    11	# needs no "except this one" exemption; `git log --follow` is the archaeology.
    12	#
    13	# Implements the documented procedure in `.github/release-checklist.md`:
    14	# RC first (vX.Y.Z-rc.N), then the ADR-103 24 h hold, then promote stable.
    15	#
    16	# WHAT THE OWNER SIGNS. Nothing here is a canonical-edit ceremony: CHANGELOG.md,
    17	# VERSION and npm/package.json are NOT in `_CANONICAL_GUARDS`
    18	# (`.claude/hooks/check_canonical_edit.py`), so no sentinel `approved.md`
    19	# exists for a release. The Owner signature is the **annotated GPG tag**,
    20	# produced INLINE by the `tag` phase (family lesson: a ceremony script signs
    21	# inline and never demands a pre-existing `.asc`).
    22	#
    23	# WHAT THIS SCRIPT NEVER DOES. It never pushes, and it never publishes.
    24	# Pushing the tag is the irreversible, outward-facing step: it starts BOTH
    25	# `.github/workflows/release.yml` (the release gate) and
    26	# `.github/workflows/npm-publish.yml` — and npm-publish.yml is what actually
    27	# publishes to npm via OIDC. This driver prints the push command and stops.
    28	#
    29	# Phases (run in order):
    30	#   preflight  read-only gates, fail-closed          (default)
    31	#   bump       version sites + plugin manifests + commit
    32	#   tag        annotated GPG tag, signed inline, behind two fail-closed guards
    33	#
    34	# Usage:
    35	#   bash .claude/scripts/local/release.sh preflight
    36	#   bash .claude/scripts/local/release.sh bump --dry-run
    37	#   bash .claude/scripts/local/release.sh bump
    38	#   bash .claude/scripts/local/release.sh tag --dry-run
    39	#   bash .claude/scripts/local/release.sh tag
    40	#
    41	# Options:
    42	#   --dry-run        make no lasting change; restores BOTH working tree and
    43	#                    index on exit (trap), including on failure. The restore
    44	#                    list is DERIVED from _release_bump_sites.py, never typed.
    45	#   --stable         target the bare version instead of -rc.N (post-hold promote)
    46	#   --rc N           RC ordinal (default 1)
    47	#   --key KEYID      GPG key to sign with (default: the key of the last release)
    48	#   --today DATE     YYYY-MM-DD stamped into the `last-reviewed:` lines
    49	#                    (default: today). It exists so the D/D+1 idempotence
    50	#                    invariant is testable at the driver level; it changes only
    51	#                    the stamp date and skips no gate.
    52	#   --restamp        force the four `last-reviewed:` stamps to move even when
    53	#                    the version is unchanged — the named route for a REAL
    54	#                    re-review. Requires --npm-readme-reviewed and disables the
    55	#                    no-op fast path (otherwise it would be dead letter).
    56	#   --offline-ack    ancestry guard: skip the `git fetch` and judge HEAD
    57	#                    against the last-known origin/main (announced loudly)
    58	#   --npm-readme-reviewed
    59	#                    required by `bump` when it writes: acknowledges that
    60	#                    npm/README.md was actually re-read. Its `last-reviewed`
    61	#                    stamp is a release tripwire by design; re-stamping it
    62	#                    silently would defeat the gate.
    63	# ============================================================================
    64	set -euo pipefail
    65	
    66	# ---------------------------------------------------------------------------
    67	# PER-RELEASE — the only block that changes between releases. Rewrite all of it
    68	# together. RELEASE_SCOPE and RELEASE_HEADLINE end up inside the SIGNED tag
    69	# annotation, so stale text there is a false claim on a signed surface (the P0
    70	# class of this repo) — and no preflight can prove prose matches a diff.
    71	# The tag stands for the WHOLE release train in CHANGELOG.md, never just the
    72	# newest plan: list every plan of the train and the full ADR range.
    73	# ---------------------------------------------------------------------------
    74	TARGET_BASE="1.3.0"
    75	RELEASE_TITLE="night-mode + release-mechanics hardening"
    76	# repass-r2 part-d P1 (S299): the v1.3.0 train grew past the rc.1 text —
    77	# 167/168 (ownership decision table) and 169 W0-W2 (Linux port + verified
    78	# fixes) landed between rc.1 and rc.2. The tag stands for the WHOLE train.
    79	RELEASE_SCOPE="PLAN-162 / PLAN-165 / PLAN-166 / PLAN-167 / PLAN-168 / PLAN-169 W0-W2 / PLAN-177 / PLAN-178 (ADRs 184 -> 191 + ADR-089-AMEND-1)"
    80	RELEASE_HEADLINE="night-mode — the Owner arms per-machine autonomy for one upcoming
    81	session (gitignored overlay, next-session semantics), and arming it is a
    82	HUMAN action by construction: the writer script self-path-guards, the Bash
    83	rail matches invocation best-effort, and every on/off/refusal lands in the
    84	HMAC chain as night_mode_toggled (proven live, not by fixture).
    85	
    86	Also: a case-fold bypass that let .claude/settings.JSON slip past BOTH the
    87	canonical and kernel rails on case-insensitive filesystems (P0, fixed on
    88	both rails); ADR-186 settles the hook-deadline conflict — the canonical
    89	matcher wall deadline fails CLOSED as a named exception to the published
    90	fail-open-on-infrastructure contract, with a provenance-pinned unlock as the
    91	recovery route; sentinel unlock inside a git worktree now REQUIRES that
    92	provenance (ADR-119 Invariant 5); pair-rail 120/150 -> 180/210 with
    93	timeout_ms and a censoring-rate trigger, ratified only after a live probe
    94	proved the harness honors a 210 s registration; four scheduled workflows that
    95	had been red without ever surfacing in push CI; and the release mechanics
    96	themselves — an idempotent bump, plus an ancestry gate and a restricted-delta
    97	gate on the tag phase (PLAN-166).
    98	
    99	rc.4 additions: the GA re-pass NO-GO cures (PLAN-177 — the two release
   100	verdict readers now share ONE fail-closed ASCII/YAML grammar: indented
   101	continuations, glued comments, Unicode whitespace and separator-less
   102	keys are all named rejections, proven by cross-reader probes; gitignore
   103	delivery is symlink-safe with honest dry-run previews; plans/ schema
   104	docs refresh hash-gated, never clobbering adopter edits; pre-state
   105	ceremony migration fails safe to user with explicit recoverable
   106	opt-in) and PLAN-178 Lote B, the spawn acceptance contract v2 (ADR-191:
   107	FILE ASSIGNMENT grammar with taint semantics + advisory telemetry,
   108	fenced+capped inter-agent ingest with per-dimension truncation
   109	poisoning, pre-dispatch validator in all four Workflow skills, shared
   110	memory query() fenced with a fireable SEC-P0-02 reopen trigger, and the
   111	multi-plan budget-cap cure), authored under its own GPG sentinel and a
   112	44-round cross-model rail."
   113	
   114	RC_NUM="1"
   115	STABLE=0
   116	DRY_RUN=0
   117	NPM_README_REVIEWED=0
   118	RESTAMP=0
   119	OFFLINE_ACK=0
   120	TODAY=""
   121	PHASE=""
   122	
   123	BUMP_SITES=".claude/scripts/local/_release_bump_sites.py"
   124	TAG_GUARD=".claude/scripts/local/_release_tag_guard.py"
   125	
   126	# Continuity: the key that signed the previous release. Overridable, but never
   127	# guessed at signing time — the preflight proves it can actually produce a
   128	# signature.
   129	SIGN_KEY="CFCFACF00335DC74"
   130	
   131	die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
   132	ok()  { printf '  ok   %s\n' "$*"; }
   133	note(){ printf '  --   %s\n' "$*"; }
   134	hdr() { printf '\n== %s ==\n' "$*"; }
   135	
   136	usage() {
   137	  cat <<USAGE
   138	release.sh — operator release driver (target base version: $TARGET_BASE)
   139	
   140	  bash $0 preflight [--rc N | --stable]
   141	  bash $0 bump      [--rc N | --stable] --npm-readme-reviewed [--dry-run]
   142	  bash $0 tag       [--rc N | --stable] [--dry-run]
   143	
   144	  --dry-run              no lasting change; tree AND index restored on exit
   145	  --stable               target $TARGET_BASE (post-hold promote)
   146	  --rc N                 target ${TARGET_BASE}-rc.N (default N=$RC_NUM)
   147	  --key KEYID            GPG key (default $SIGN_KEY)
   148	  --today YYYY-MM-DD     date stamped into the last-reviewed lines
   149	  --restamp              move the review stamps at an unchanged version
   150	                         (requires --npm-readme-reviewed)
   151	  --offline-ack          ancestry guard judges a possibly stale origin/main
   152	  --npm-readme-reviewed  assert npm/README.md was actually re-read
   153	
   154	The header of this file documents what the Owner signs, why this script never
   155	pushes, and why it never publishes.
   156	USAGE
   157	}
   158	
   159	while [ "$#" -gt 0 ]; do
   160	  case "$1" in
   161	    preflight|bump|tag) PHASE="$1"; shift ;;
   162	    --dry-run) DRY_RUN=1; shift ;;
   163	    --stable)  STABLE=1; shift ;;
   164	    --npm-readme-reviewed) NPM_README_REVIEWED=1; shift ;;
   165	    --restamp) RESTAMP=1; shift ;;
   166	    --offline-ack) OFFLINE_ACK=1; shift ;;
   167	    --today)   TODAY="${2:?--today needs YYYY-MM-DD}"; shift 2 ;;
   168	    --rc)      RC_NUM="${2:?--rc needs a number}"; shift 2 ;;
   169	    --key)     SIGN_KEY="${2:?--key needs a keyid}"; shift 2 ;;
   170	    -h|--help) usage; exit 0 ;;
   171	    *) die "unknown argument: $1" ;;
   172	  esac
   173	done
   174	[ -n "$PHASE" ] || die "no phase given (preflight|bump|tag); see --help"
   175	
   176	if [ -n "$TODAY" ]; then
   177	  case "$TODAY" in
   178	    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
   179	    *) die "--today must be YYYY-MM-DD, got '$TODAY'" ;;
   180	  esac
   181	else
   182	  TODAY="$(date +%F)"
   183	fi
   184	
   185	if [ "$STABLE" -eq 1 ]; then
   186	  TARGET_VERSION="$TARGET_BASE"
   187	else
   188	  TARGET_VERSION="${TARGET_BASE}-rc.${RC_NUM}"
   189	fi
   190	TARGET_TAG="v${TARGET_VERSION}"
   191	
   192	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo"
   193	cd "$REPO_ROOT"
   194	
   195	# GPG in a non-interactive shell needs an explicit TTY or pinentry fails with
   196	# a misleading "No pinentry" (recurring footgun in this repo ceremonies).
   197	GPG_TTY="$(tty 2>/dev/null || true)"
   198	export GPG_TTY
   199	
   200	# Every file the bump phase may write — DERIVED, never typed. A hand-kept
   201	# restore list is how a dry-run left debris behind once already (S273): the
   202	# writer grew a site, the restore list did not. `--include-generated` adds the
   203	# two plugin manifests, which `build-plugin.py --write-manifests` rewrites
   204	# from VERSION during the bump.
   205	sites_out="$(python3 "$BUMP_SITES" print-sites --include-generated)" \
   206	  || die "cannot enumerate version sites from $BUMP_SITES"
   207	VERSION_FILES=()
   208	while IFS= read -r _site; do
   209	  [ -n "$_site" ] || continue
   210	  VERSION_FILES+=("$_site")
   211	done <<< "$sites_out"
   212	[ "${#VERSION_FILES[@]}" -gt 0 ] || die "$BUMP_SITES returned no version sites"
   213	
   214	printf 'release driver — target %s (tag %s), phase=%s, dry-run=%s, today=%s\n' \
   215	  "$TARGET_VERSION" "$TARGET_TAG" "$PHASE" "$DRY_RUN" "$TODAY"
   216	
   217	# ---------------------------------------------------------------------------
   218	# Dry-run safety net. Snapshot every file the `bump` phase writes plus the
   219	# index state, and restore both on ANY exit path.
   220	# ---------------------------------------------------------------------------
   221	SNAPSHOT_ARMED=0
   222	restore_snapshot() {
   223	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   224	  # The bump phase refuses to run on a dirty tree (untracked included), so
   225	  # HEAD is exactly the pre-bump state: reset unstages, checkout restores
   226	  # content. Both halves are needed — an index-only restore leaves the files
   227	  # modified, and a content-only restore leaves them staged (the S273 trap).
   228	  #
   229	  # PER PATH, never one multi-path command: `git checkout -- a b c` is
   230	  # ATOMIC — a single path absent from HEAD (a file the bump CREATED, e.g. a
   231	  # plugin manifest on its first appearance) aborts the WHOLE command and
   232	  # restores nothing, and the old `|| true` swallowed that error while the
   233	  # message below still claimed success. A path HEAD carries is checked out;
   234	  # a path HEAD does not carry was created by the bump and is removed.
   235	  local _p _dirty
   236	  for _p in "${VERSION_FILES[@]}"; do
   237	    git reset --quiet HEAD -- "$_p" 2>/dev/null || true
   238	    if git cat-file -e "HEAD:$_p" 2>/dev/null; then
   239	      git checkout --quiet -- "$_p" 2>/dev/null || true
   240	    else
     1	"""test_validate_pair_rail_verdict.py — S104 PLAN-081 GA tail.
     2	
     3	Tests for the parent_sha / commit_sha bind redesign in
     4	.github/scripts/validate-pair-rail-verdict.py. The legacy
     5	`verdict.commit_sha` self-reference is replaced with `verdict.parent_sha`
     6	to break the chicken-and-egg problem the v1.16.0 GA ceremony hit
     7	(verdict file cannot declare its own commit SHA because the SHA is
     8	only known AFTER the verdict file is committed).
     9	
    10	Coverage:
    11	- --parent-sha match → exit 0
    12	- --parent-sha mismatch → exit VERDICT_INVALID (3)
    13	- --parent-sha against verdict with no parent_sha field, legacy
    14	  commit_sha present → ADVISORY (skip bind), exit 0 if rest valid
    15	- --parent-sha against verdict with no parent_sha + no commit_sha →
    16	  exit VERDICT_INVALID (3)
    17	- Legacy --commit-sha path still works on legacy verdicts (exit 0)
    18	- Legacy --commit-sha mismatch → exit VERDICT_INVALID (3)
    19	- --parent-sha takes precedence when both args passed
    20	
    21	ADR-182 payload pin (PLAN-163 T5.2 pin-pack):
    22	- --codex-pin-manifest-file + matching triple/sha envelope → exit 0
    23	- payload sha mismatch → VERDICT_INVALID (3)
    24	- targetTriple absent from manifest → VERDICT_INVALID (3)
    25	- envelope missing triple/sha fields → VERDICT_INVALID (3)
    26	- manifest file unreadable → infra (1)
    27	- comment-only tombstone as --codex-cli-binary-sha256-file → legacy
    28	  launcher pin skipped (exit 0)
    29	
    30	Stdlib only. Python ≥3.9. Run via pytest from repo root.
    31	"""
    32	
    33	from __future__ import annotations
    34	
    35	import subprocess
    36	import sys
    37	import tempfile
    38	import textwrap
    39	import unittest
    40	from pathlib import Path
    41	from typing import Sequence
    42	
    43	REPO_ROOT = Path(__file__).resolve().parents[3]
    44	SCRIPT = REPO_ROOT / ".github" / "scripts" / "validate-pair-rail-verdict.py"
    45	
    46	EXIT_OK = 0
    47	EXIT_INFRA_ERROR = 1
    48	EXIT_VERDICT_EXPIRED = 2
    49	EXIT_VERDICT_INVALID = 3
    50	
    51	
    52	def _make_verdict(
    53	    *,
    54	    decision_lines: Sequence[str] = ("verdict: GO",),
    55	    release_tag: str = "v1.99.0",
    56	    parent_sha: str = "",
    57	    commit_sha: str = "",
    58	    inputs_hash: str = "deadbeef" * 8,
    59	    generated_at: str = "9999-01-01T00:00:00Z",
    60	    ttl_hours: int = 87600,
    61	    tool_versions_block: str = (
    62	        "  codex_cli: 0.129.0\n"
    63	        "  codex_cli_binary_sha256: " + "a" * 64
    64	    ),
    65	    include_signature: bool = True,
    66	) -> str:
    67	    """Build a verdict markdown file with the requested envelope.
    68	
    69	    `decision_lines` are emitted VERBATIM (PLAN-177 t2 / P1-a): the grammar
    70	    divergence between this validator and the local tag guard can only be
    71	    expressed by writing the key spelling itself -- `verdict : NO-GO` is
    72	    valid YAML and was counted here but skipped there.
    73	    """
    74	    lines = [
    75	        "# Pair-Rail Verdict — test",
    76	        "",
    77	        "```yaml",
    78	        *decision_lines,
    79	        f"generated_at: {generated_at}",
    80	        f"ttl_hours: {ttl_hours}",
    81	        f"release_tag: {release_tag}",
    82	    ]
    83	    if parent_sha:
    84	        lines.append(f"parent_sha: {parent_sha}")
    85	    if commit_sha:
    86	        lines.append(f"commit_sha: {commit_sha}")
    87	    lines.append(f"inputs_hash: {inputs_hash}")
    88	    lines.append("tool_versions:")
    89	    lines.append(tool_versions_block)
    90	    if include_signature:
    91	        lines.append("gpg_signature: |")
    92	        lines.append("  -----BEGIN PGP SIGNATURE-----")
    93	        lines.append("  fake-sig-for-test")
    94	        lines.append("  -----END PGP SIGNATURE-----")
    95	    lines.append("```")
    96	    return "\n".join(lines) + "\n"
    97	
    98	
    99	def _run(args, verdict_text: str):
   100	    """Run validator on a tmpdir-scoped verdict file. Returns CompletedProcess."""
   101	    with tempfile.TemporaryDirectory() as td:
   102	        verdict_path = Path(td) / "verdict.md"
   103	        verdict_path.write_text(verdict_text, encoding="utf-8")
   104	        cmd = [
   105	            sys.executable, str(SCRIPT),
   106	            "--verdict-file", str(verdict_path),
   107	            *args,
   108	        ]
   109	        return subprocess.run(cmd, capture_output=True, text=True, timeout=30)
