   244	def parse_verdict_file(path: Path) -> Dict[str, Any]:
   245	    """Path wrapper over parse_verdict_text (published entry point)."""
   246	    if not path.exists():
   247	        raise FileNotFoundError(f"verdict file: {path}")
   248	    return parse_verdict_text(path.read_text(encoding="utf-8"))
