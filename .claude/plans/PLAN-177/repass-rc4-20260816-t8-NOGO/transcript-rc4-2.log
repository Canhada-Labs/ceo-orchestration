   200	def _parse_verdict(text: str) -> Dict[str, object]:
   201	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   202	
   203	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   204	    of `  - item` list entries, and ignores everything else. Anything it cannot
   205	    read is absent, and every consumer below treats absent as fail-closed.
   206	
   207	    Parity with the step-15 reader (`.github/scripts/
   208	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   209	    scope: block selection (the regex below is the validator's own — the
   210	    first ```yaml fence, not the first fence of any language) and inline
   211	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   212	    parse_verdict_file reads key:value and sub-dicts and would drop
   213	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   214	    ONE shared reader (this file is the declared reference), never grow a
   215	    third parser of the same signed file.
   216	    """
   217	    fields: Dict[str, object] = {}
   218	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   219	    if block is None:
   220	        # No yaml block -> no fields -> every consumer below fails closed.
   221	        return fields
   222	    cur_list: Optional[str] = None
   223	    for raw in block.group(1).splitlines():
   224	        line = _strip_yaml_comment(raw)
   225	        if not line.strip():
   226	            continue
   227	        if line.startswith(("  - ", "- ")) and cur_list:
   228	            item = line.split("-", 1)[1].strip()
   229	            if item:
   230	                fields[cur_list].append(item)  # type: ignore[union-attr]
   231	            continue
   232	        # [ \t]* not \s* (t5 P1): Python \s is Unicode-aware and would
   233	        # swallow a NBSP that must stay attached to the VALUE.
   234	        m = re.match(r"\A([A-Za-z0-9_]+):(?:[ \t]+(.*))?\Z", line)
   235	        if not m:
   236	            continue
   237	        key, val = m.group(1), (m.group(2) or "").strip(" \t")
   238	        if val == "":
   239	            fields[key] = []
   240	            cur_list = key
   241	        else:
   242	            fields[key] = val
   243	            cur_list = None
   244	    return fields
   245	
   246	
   247	# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.
   248	# The two readers of this signed file disagreed about what a key IS: the
   249	# step-15 validator strips the key (`line.partition(":")[0].strip()`), so it
   250	# reads `verdict : NO-GO` as a declaration of `verdict`; the regexes in THIS
   251	# file demand the colon immediately after the name, so they skipped the line.
   252	# The valid-YAML pair
   253	#
   254	#     verdict : NO-GO
   255	#     verdict: GO
   256	#
   257	# was therefore two declarations there (refused) and ONE here, parsed as GO —
   258	# and this is the rail that enforces in every mode, so the tag was authorised.
   259	#
   260	# ONE semantics for both rails: NON-CANONICAL top-level syntax is REJECTED,
   261	# fail-closed. Trimming the key in both readers would also close the
   262	# divergence, but it widens the grammar of a SIGNED artifact to spellings no
   263	# author writes and no template emits; refusing the shape is the smaller
   264	# surface and is the only behaviour that cannot silently prefer a value.
   265	# A top-level line is canonical iff it is `name:` with no whitespace before
   266	# the colon, or a `- ` list item.
   267	def _strip_yaml_comment(raw):
   268	    """YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at
   269	    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the
   270	    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Byte-for-
   271	    byte twin of `_strip_comment` in validate-pair-rail-verdict.py.
   272	    """
   273	    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()
   274	    # silently converted `GO<U+00A0>` into the authorizing token `GO`.
   275	    if raw.lstrip(" \t").startswith("#"):
   276	        return ""
   277	    i = 0
   278	    while True:
   279	        j = raw.find("#", i)
   280	        if j == -1:
   281	            return raw.rstrip(" \t")
   282	        if j > 0 and raw[j - 1] in (" ", "\t"):
   283	            return raw[:j].rstrip(" \t")
   284	        i = j + 1
   285	
   286	
   287	_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r"\A[A-Za-z0-9_]+:(?:[ \t]|\Z)")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping
   288	
   289	
   290	def _noncanonical_top_level_lines(text: str) -> List[str]:
   290	def _noncanonical_top_level_lines(text: str) -> List[str]:
   291	    """Top-level lines of the yaml block that are not canonical declarations.
   292	
   293	    Byte-for-byte twin of `noncanonical_top_level_lines` in
   294	    `.github/scripts/validate-pair-rail-verdict.py` (separate processes on
   295	    separate machines; neither may import the other — keep them identical).
   296	    Empty list == the block speaks the grammar both readers assume.
   297	    """
   298	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   299	    if block is None:
   300	        return []
   301	    bad: List[str] = []
   302	    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an
   303	    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.
   304	    # Both None (before any key) and "scalar" reject — an orphan-indented
   305	    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped
   306	    # through the prev_scalar_decl=False initial state and resolved as GO,
   307	    # and a root-level `- item` is malformed for this signed format (its
   308	    # only lists are INDENTED under a bare key) yet was accepted outright.
   309	    # After a SCALAR `key: value`, an indented non-comment line is a YAML
   310	    # CONTINUATION that changes the scalar's value (`verdict: GO` +
   311	    # `  NO-GO` == "GO NO-GO") — reject fail-closed (re-pass rc.4 t2 P1).
   312	    parent = None  # None | "scalar" | "bare"
   313	    for raw in block.group(1).splitlines():
   314	        line = _strip_yaml_comment(raw)
   315	        if not line.strip():
   316	            continue
   317	        if line[0] in (" ", "\t"):
   318	            if parent != "bare":
   319	                bad.append(line)
   320	            continue
   321	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   322	            _key, _, _val = line.partition(":")
   323	            parent = "scalar" if _val.strip() else "bare"
   324	            continue
   325	        bad.append(line)
   326	        parent = None
   327	    return bad
