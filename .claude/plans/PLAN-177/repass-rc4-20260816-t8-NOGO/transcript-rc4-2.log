   236	          set -euo pipefail
   237	          bash scripts/tests/test-upgrade-dryrun-identity.sh
   238	
   239	      - name: Upgrade oracle — exclusion parity + opt-in purge (U2/U3)
   240	        run: |
   241	          set -euo pipefail
   242	          bash scripts/tests/test-upgrade-exclusions.sh
   243	
   244	      # WS4-user-ceremony-leg
   245	      - name: Install with --ceremony user (governance rc=0 + no out-of-.claude writes)
   246	        run: |
   247	          set -euo pipefail
   248	          U="$(mktemp -d)"
   249	          ( cd "$U" && git init -q )
   250	          CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   251	            bash scripts/install.sh "$U" --ceremony user
   252	          echo '--- validate-governance.sh (user) ---'
   253	          ( cd "$U" && bash .claude/scripts/validate-governance.sh )
   254	          echo '--- assert only .claude/ at top level ---'  # WS4-sc2010-glob
   255	          extra=""
   256	          for _e in "$U"/* "$U"/.[!.]* "$U"/..?*; do
   257	            [ -e "$_e" ] || continue
   258	            _b="$(basename "$_e")"
   259	            case "$_b" in .claude|.git) continue ;; esac
   260	            extra="$extra $_b"
   261	          done
   262	          if [ -n "$extra" ]; then
   263	            echo "::error::--ceremony user wrote outside .claude/:$extra"
   264	            exit 1
   265	          fi
   266	          echo 'user-ceremony leg: PASS'
   267	
   268	      # PLAN-166 F4 (OQ-4) - install/upgrade parity on the RESULTING TREES,
   269	      # per ceremony mode. NO continue-on-error, deliberately: the assertion
   270	      # this replaces was dead twice over (tautological AND wired into no
   271	      # workflow), and an escape hatch here would reinstate exactly that.
   272	      # Exit 2 (KNOWN-OPEN) is a FAILURE too - it NAMES the outstanding
   273	      # PLAN-166 W1 prerequisites instead of skipping them silently.
   274	      - name: Install/upgrade parity e2e (maintainer + user ceremony)
   275	        run: |
   276	          set -euo pipefail
   277	          bash scripts/tests/test-install-upgrade-parity-e2e.sh
   278	
   279	      # Control of the control (AC-4). With ONE backup_and_replace line deleted
   280	      # from a COPY of upgrade.sh, the gate above must come back RED in EVERY
   281	      # ceremony mode. rc must be exactly 1: rc 0/2 means the gate went blind,
   282	      # rc 9 means the plant stopped biting (vacuous control). Both fail here.
   283	      # This step MUST stay AFTER the plain gate: if the un-planted run were
   284	      # already fatal, rc=1 here would prove nothing about the plant.
   285	      - name: Install/upgrade parity - positive control (planted divergence)
   286	        run: |
   287	          set -uo pipefail
   288	          rc=0
   289	          bash scripts/tests/test-install-upgrade-parity-e2e.sh \
   290	            --positive-control > /tmp/parity-control.log 2>&1 || rc=$?
   291	          if [ "$rc" -ne 1 ]; then
   292	            cat /tmp/parity-control.log
   293	            echo "::error::parity positive control returned rc=$rc, expected 1 - the planted install/upgrade divergence did NOT turn the gate red, so the gate above proves nothing"
   294	            exit 1
   295	          fi
   296	          # Second factor, LOAD-BEARING (re-pass closure): under `set -uo
   297	          # pipefail` (no -e) a non-matching grep would NOT fail the step, so
   298	          # an rc=1 from a failure UNRELATED to the plant (log with none of
   299	          # the plant markers) would pass — the registered-vacuous class
   300	          # (S292) this step exists to close. Demand plant evidence or fail.
   301	          grep -E "PLANTED|per-mode verdicts|positive control:" /tmp/parity-control.log || {
   302	            cat /tmp/parity-control.log
   303	            echo "::error::rc=1 but the log carries no PLANTED/per-mode-verdict evidence - the control went red for an unrelated reason, which proves nothing about the plant (vacuous control)"
   304	            exit 1
   305	          }
   306	          echo "positive control OK: planted divergence -> exit 1 in every ceremony mode"
   307	
   308	      # PLAN-166 F3 (ADR-155-AMEND-1, AC-3) — delivery-record ownership of
   309	      # the three conditional framework surfaces (SPEC/v1, root PROTOCOL.md,
   310	      # .claude/.framework-version) across install -> upgrade -> doctor ->
