   112	class TestParentShaBind(unittest.TestCase):
   113	    """S104 redesign: --parent-sha is the canonical bind."""
   114	
   115	    PARENT = "abcdef0123456789abcdef0123456789abcdef01"
   116	
   117	    def test_parent_sha_match_passes_bind(self):
   118	        v = _make_verdict(parent_sha=self.PARENT, release_tag="v1.99.0")
   119	        r = _run(
   120	            [
   121	                "--parent-sha", self.PARENT,
   122	                "--release-tag", "v1.99.0",
   123	            ],
   124	            v,
   125	        )
   126	        # Bind passes; other checks may still pass too (no pin files
   127	        # requested → skipped). Expected exit 0.
   128	        self.assertEqual(r.returncode, EXIT_OK, msg=r.stderr)
   129	
   130	    def test_parent_sha_mismatch_returns_invalid(self):
   131	        v = _make_verdict(parent_sha=self.PARENT, release_tag="v1.99.0")
   132	        r = _run(
   133	            [
   134	                "--parent-sha", "f" * 40,
   135	                "--release-tag", "v1.99.0",
   136	            ],
   137	            v,
   138	        )
   139	        self.assertEqual(r.returncode, EXIT_VERDICT_INVALID)
   140	        self.assertIn("parent_sha mismatch", r.stderr)
   141	
   142	    def test_parent_sha_arg_with_legacy_commit_sha_only_advises(self):
   143	        """v1.16.0-era verdict shipping commit_sha but not parent_sha,
   144	        invoked with --parent-sha → ADVISORY skip, proceed."""
   145	        v = _make_verdict(commit_sha="deadbeef" * 5, release_tag="v1.99.0")
   146	        r = _run(
   147	            [
   148	                "--parent-sha", self.PARENT,
   149	                "--release-tag", "v1.99.0",
   150	            ],
   151	            v,
   152	        )
   153	        self.assertEqual(r.returncode, EXIT_OK, msg=r.stderr)
   154	        self.assertIn("ADVISORY", r.stderr)
   155	        self.assertIn("legacy commit_sha", r.stderr)
   156	
   157	    def test_parent_sha_arg_with_no_sha_fields_returns_invalid(self):
   158	        v = _make_verdict(release_tag="v1.99.0")  # neither parent_sha nor commit_sha
   159	        r = _run(
   160	            [
   161	                "--parent-sha", self.PARENT,
   162	                "--release-tag", "v1.99.0",
   163	            ],
   164	            v,
   165	        )
   166	        self.assertEqual(r.returncode, EXIT_VERDICT_INVALID)
   167	        self.assertIn("missing parent_sha field", r.stderr)
