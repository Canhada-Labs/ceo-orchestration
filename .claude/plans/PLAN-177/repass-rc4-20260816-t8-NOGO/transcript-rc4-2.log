   168	# -------------------------------- npm pack -----------------------------------
   169	echo "==> Building tarball"
   170	TARBALL="$(cd "$NPM_DIR" && npm pack 2>/dev/null | tail -1)"
   171	TARBALL_PATH="$NPM_DIR/$TARBALL"
   172	
   173	if [[ ! -f "$TARBALL_PATH" ]]; then
   174	  echo "::error::npm pack did not produce $TARBALL_PATH" >&2
   175	  exit 1
   176	fi
   177	TARBALL_SIZE_KB=$(( $(wc -c < "$TARBALL_PATH") / 1024 ))
   178	echo "OK: tarball built — $TARBALL ($TARBALL_SIZE_KB KB)"
   179	
   180	# -------------------------------- sha256 emission ----------------------------
   181	# PLAN-019 DevOps-P2-3 — LOCAL build-integrity record.
   182	#
   183	# Emit the sha256 of the tarball just built, next to it, in
   184	# NPM_DIR/SHA256SUMS.txt (one line per tarball NAME, replaced in place on a
   185	# rebuild) and in the per-tarball sidecar `<tarball>.sha256` written further
   186	# down. Both use the `<64-hex>  <filename>` form checksum tools consume.
   187	#
   188	# Which of the two a maintainer can actually CHECK differs, so say it here
   189	# rather than leave the reader to find out: the SIDECAR verifies (it names one
   190	# file, and that file was just built). The cumulative manifest does NOT verify
   191	# as a whole — it keeps lines for tarballs of OTHER versions, `npm/*.tgz` is
   192	# git-ignored so a fresh clone has none of them on disk, and a bulk check
   193	# therefore exits non-zero on "No such file or directory" for every line but
   194	# the current one. Measured, not assumed (PLAN-177 W1). Compare the single
   195	# line for the tarball you just built, or check the sidecar.
   196	#
   197	# SCOPE — what this is NOT (PLAN-177 P1-3). Two claims used to live here and
   198	# both were false; the honest model in SECURITY.md:79-81 is the one to follow.
   199	#
   200	#   1. "CI verification (npm-publish.yml) computes the checksum of the tarball
   201	#      it publishes and appends to the release notes." It does not. That
   202	#      workflow never materialises a .tgz (its `npm pack --dry-run` writes
   203	#      nothing) and appends nothing to any release notes. The one sha256 it
   204	#      does compute is over the install.sh BODY, for the
   205	#      `# CEO-INSTALL-SHA256:` trailer — a different artifact entirely.
   206	#
   207	#   2. A consumer recipe that fetched this manifest over the network:
   208	#        curl -LO https://registry.npmjs.org/.../tarball
   209	#        curl -LO https://.../SHA256SUMS.txt
   210	#      There is no such URL. SHA256SUMS.txt is not in package.json `files`, so
   211	#      it does not travel in the published tarball, and no workflow attaches it
   212	#      to a GitHub release. A consumer who wants to verify a published tarball
   213	#      should use npm's own integrity metadata (`npm view <pkg> dist.integrity`)
   214	#      until a per-tarball manifest is actually published.
   215	#
   216	# Publishing a real per-tarball manifest is a change to the publish path and is
   217	# deferred to the v1.4.0 train (PLAN-177 §Escopo — route (i), excluded from
   218	# rc.4 on purpose). Until then this file records LOCAL builds only.
   219	#
   220	# Stdlib-only: prefer `sha256sum` (Linux / Ubuntu runners) then fall back
   221	# to `shasum -a 256` (macOS). python3 -m hashlib as last-resort fallback.
   222	SHA_MANIFEST="$NPM_DIR/SHA256SUMS.txt"
   223	if command -v sha256sum >/dev/null 2>&1; then
   224	  HASH_LINE=$(cd "$NPM_DIR" && sha256sum "$TARBALL")
   225	elif command -v shasum >/dev/null 2>&1; then
   226	  HASH_LINE=$(cd "$NPM_DIR" && shasum -a 256 "$TARBALL")
   227	else
   228	  HASH_HEX=$(python3 -c "
   229	import hashlib, sys
   230	h = hashlib.sha256()
   231	with open(sys.argv[1], 'rb') as f:
   232	    for chunk in iter(lambda: f.read(65536), b''):
   233	        h.update(chunk)
   234	print(h.hexdigest())
   235	" "$TARBALL_PATH")
   236	  HASH_LINE="${HASH_HEX}  ${TARBALL}"
   237	fi
   238	
   239	# Normalise output to exactly two spaces between hash + filename (sha256sum
   240	# -c strict format), strip any extra whitespace introduced by BSD shasum.
   241	HASH_HEX="${HASH_LINE%% *}"
   242	HASH_LINE="${HASH_HEX}  ${TARBALL}"
   243	
   244	# Dedup-or-append (PLAN-023 Phase A F-comp-002 follow-up): replace any
   245	# existing line for the same filename in-place, else append. Prevents
   246	# SHA256SUMS.txt from accumulating stale entries across local rebuilds
   247	# (previously observed: 51 stale entries before PLAN-025 Batch I reset).
   248	# Preserves header comment lines (starting with #) untouched.
   249	if [[ -f "$SHA_MANIFEST" ]] && grep -qE "  ${TARBALL}\$" "$SHA_MANIFEST" 2>/dev/null; then
   250	  # Replace existing line for this filename.
   251	  TMP_MANIFEST="$(mktemp -t ceo-sha-manifest.XXXXXX)"
   252	  awk -v tb="$TARBALL" -v line="$HASH_LINE" '
   253	    $0 ~ ("  " tb "$") { print line; found=1; next }
   254	    { print }
   255	    END { if (!found) print line }
   256	  ' "$SHA_MANIFEST" > "$TMP_MANIFEST"
   257	  mv "$TMP_MANIFEST" "$SHA_MANIFEST"
   258	  echo "OK: sha256 = $HASH_HEX"
   259	  echo "    updated $SHA_MANIFEST (replaced existing line)"
   260	else
   261	  echo "$HASH_LINE" >> "$SHA_MANIFEST"
   262	  echo "OK: sha256 = $HASH_HEX"
   263	  echo "    appended to $SHA_MANIFEST"
   264	fi
   265	
   266	# Remove any stale sidecar files for tarball names OTHER than the current
   267	# one. Keeps the npm/ directory free of version-drift sidecars between
   268	# RC→GA cuts (previously observed: 1.5.0-rc.1.tgz.sha256 lingered after
   269	# 1.6.0-rc.1 bump). Glob over ceo-orchestration-*.tgz.sha256 pattern.
   270	for stale in "$NPM_DIR"/ceo-orchestration-*.tgz.sha256; do
   271	  [[ -f "$stale" ]] || continue
   272	  stale_name="$(basename "$stale" .sha256)"
   273	  if [[ "$stale_name" != "$TARBALL" ]]; then
   274	    rm -f "$stale"
   275	    echo "    pruned stale sidecar: $stale_name.sha256"
   276	  fi
   277	done
   278	
   279	# Also emit a single-purpose .sha256 sidecar alongside the tarball so CI
   280	# can download it separately without parsing the cumulative manifest.
   281	echo "$HASH_HEX  $TARBALL" > "$TARBALL_PATH.sha256"
   282	echo "    sidecar written $TARBALL_PATH.sha256"
