  1469	def _contract_rows(doc_text: str) -> List[List[str]]:
  1470	    """The `## Contract` table as [control, mechanism, status, where].
  1471	
  1472	    Re-pass rc.4 t6-cond-2 / t7 P2: a malformed non-header row (any cell
  1473	    count other than 4) FAILS instead of being silently discarded — an
  1474	    enforcement claim that grows an extra `|` must not vanish from the
  1475	    oracle while the remaining rows keep the non-vacuity floors green.
  1476	    """
  1477	    m = re.search(r"(?ms)^## Contract\b.*?(?=^## |\Z)", doc_text)
  1478	    assert m, "npm/INTEGRITY.md has no `## Contract` section"
  1479	    rows = []
  1480	    malformed = []
  1481	    for line in m.group(0).splitlines():
  1482	        line = line.strip()
  1483	        if not line.startswith("|"):
  1484	            continue
  1485	        cells = [c.strip() for c in line.strip("|").split("|")]
  1486	        if cells and (cells[0] == "Control" or set(cells[0]) <= set("- :")):
  1487	            continue
  1488	        if len(cells) != 4:
  1489	            malformed.append(line)
  1490	            continue
  1491	        rows.append(cells)
  1492	    assert not malformed, (
  1493	        "malformed `## Contract` row(s) (cell count != 4) would be silently "
  1494	        "dropped from the enforcement oracle: %s" % malformed
  1495	    )
  1496	    return rows
  1497	
