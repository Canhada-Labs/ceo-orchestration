   408	    if not os.path.isfile(verdict_abs):
   409	        return _fail(
   410	            E_VERDICT,
   411	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   412	            "be committed before the tag is cut (release.yml validates it per "
   413	            "tag on the tagged tree)." % verdict_rel,
   414	        )
   415	    with open(verdict_abs, encoding="utf-8") as fh:
