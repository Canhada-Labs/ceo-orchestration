  1620	def test_integrity_unenforced_rows_are_restated_where_the_reader_looks():
  1621	    """The escape hatch a closed set alone leaves open: mark everything
  1622	    `deferred` and list it nowhere. Every non-enforced row must repeat its
  1623	    control name, verbatim and bold, under §Not yet automated — the section a
  1624	    reader actually reads."""
  1625	    doc = INTEGRITY_DOC.read_text(encoding="utf-8")
  1626	    section = re.search(r"(?ms)^## Not yet automated\b.*?(?=^## |\Z)", doc)
  1627	    assert section, "npm/INTEGRITY.md has no §Not yet automated section"
  1628	    body = section.group(0)
  1629	    unenforced = [
  1630	        control
  1631	        for control, _m, status, _w in _contract_rows(doc)
  1632	        if status in ("deferred", "operator")
  1633	    ]
  1634	    assert unenforced, (
  1635	        "no un-enforced row parsed — the honest half of the table is missing, "
  1636	        "or the Status column stopped parsing"
  1637	    )
  1638	    unlisted = [c for c in unenforced if ("**%s**" % c) not in body]
  1639	    assert not unlisted, (
