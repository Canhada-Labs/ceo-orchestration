  1256	def test_driver_derives_every_version_string_from_target_base():
  1257	    """Zero stale literals — and deliberately NO coupling to the repo's current
  1258	    VERSION file. Pinning the driver to VERSION would go red in the one window
  1259	    where the driver MUST be ahead of it: the moment TARGET_BASE is set for the
  1260	    next release and `bump` has not run yet. A gate that blocks the documented
  1261	    path is the failure mode this plan exists to close, not a new instance."""
  1262	    text = DRIVER_SRC.read_text(encoding="utf-8")
  1263	    m = re.search(r'(?m)^TARGET_BASE="(\d+\.\d+\.\d+)"$', text)
  1264	    assert m, "TARGET_BASE is not a bare-semver assignment"
  1265	    target = m.group(1)
  1266	    offenders = []
  1267	    for num, line in enumerate(text.splitlines(), 1):
  1268	        if line.strip() == 'TARGET_BASE="%s"' % target:
  1269	            continue
  1270	        for hit in SEMVER_RX.findall(line):
  1271	            # tolerated: a reference to a PAST incident. It is a historical
  1272	            # fact and cannot be derived from TARGET_BASE.
  1273	            if re.search(r"v%s-rc\.\d+" % re.escape(hit), line):
  1274	                continue
  1275	            offenders.append("%d: %s" % (num, line.strip()))
  1276	    assert not offenders, "version literals not derived from TARGET_BASE:\n%s" % (
  1277	        "\n".join(offenders)
  1278	    )
