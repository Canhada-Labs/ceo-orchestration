   366	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   367	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   368	    entries: List[Tuple[str, str]] = []
   369	    with open(path, encoding="utf-8") as fh:
   370	        for line in fh:
   371	            line = line.rstrip("\n")
   372	            if not line.strip():
   373	                continue
   374	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   375	            if not m:
   376	                raise ValueError("unparsable manifest line: %r" % line)
   377	            entries.append((m.group(1), m.group(2)))
   378	    return entries
   379	
