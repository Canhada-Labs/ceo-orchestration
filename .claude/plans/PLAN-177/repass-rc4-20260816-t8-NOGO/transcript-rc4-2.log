   441	# =============================================================================
   442	# PLAN-167 — _ownership_verdict: THE ownership decision.
   443	#
   444	# install.sh and upgrade.sh stop deciding and start executing. Every defect in
   445	# the 35-finding S296 review series was a cell of this space whose answer was
   446	# decided branch-locally, so two branches could disagree about the same
   447	# question and nothing detected it.
   448	#
   449	#   $1 surface        spec | protocol | marker
   450	#   $2 prior_record   none | hash | link_match | link_retargeted
   451	#   $3 live_type      absent | dir | dir_empty | regular | symlink | special
   452	#                     | ancestor_symlink
   453	#   $4 live_content   pristine | legacy_pristine | legacy_pristine_partial
   454	#                     | edited | -
   455	#   $5 source_has     yes | no
   456	#   $6 mode           copy | link
   457	#   $7 ceremony       user | maintainer
   458	#   $8 operation      install_fresh | install_rerun | upgrade
   459	#   $9 skip_requested none | self | descendant
   460	#
   461	#   stdout: "<VERDICT> <HASH_SOURCE>", rc 0
   462	#   rc 1, no output: a combination the legality rules forbid.
   463	#
   464	# PURE: no filesystem, no globals, no environment. Callers observe the nine
   465	# dimensions and pass them in. That purity is what lets the same table drive a
   466	# millisecond unit oracle as well as the ~25-minute end-to-end suite; S296 had
   467	# only the slow instrument, at one cell per ~40-minute round.
   468	#
   469	# ABORT_SURFACE is deliberately NOT produced here (round-1 consensus C2). A
   470	# failed backup is not a property of these nine dimensions — it is the CALLER
   471	# failing to carry out a verdict it was handed. And per INV-3 that failure
   472	# NEVER advances the record: recording a delivery that did not happen is the
   473	# over-claiming direction ADR-155-AMEND-1 §3 forbids.
   474	#
   475	# Contract: docs/ownership-decision-table.md · Truth: scripts/tests/ownership_table.tsv
   476	# =============================================================================
   477	_ownership_verdict() {
   478	  _ov_surface="$1"; _ov_prior="$2";  _ov_ltype="$3"; _ov_lcontent="$4"
   479	  _ov_shas="$5";    _ov_mode="$6";   _ov_cer="$7";   _ov_op="$8"; _ov_skip="$9"
   480	
   481	  # Do not touch the surface; decide the RECORD. Ownership continuity and the
   482	  # digit it carries are separate decisions, and moving one without the other
   483	  # produced four distinct defects — so they are resolved together, once.
   484	  _ov_carry() {
   485	    case "$_ov_prior" in
   486	      link_match)      printf 'PRESERVE_OWNED LINK_RECORD';  return 0 ;;
   487	      link_retargeted) printf 'PRESERVE_UNOWNED HASH_NONE'; return 0 ;;
   488	      none)            printf 'PRESERVE_UNOWNED HASH_NONE';  return 0 ;;
   489	    esac
   490	    # prior_record=hash. HASH_TARGET is never an option: it re-baselines the
   491	    # bytes now on disk, which is how a later upgrade comes to overwrite an
   492	    # adopter edit and uninstall comes to delete it.
   493	    if [ "$_ov_surface" = "protocol" ] \
   494	       || [ "$_ov_shas" = "no" ] \
   495	       || [ "$_ov_ltype" = "dir_empty" ]; then
   496	      printf 'PRESERVE_OWNED HASH_PRIOR_RECORD'   # no source bytes to hash
   497	    else
