   330	def _count_top_level_key(text: str, key: str) -> int:
   331	    """How many times `key:` is declared at the top level of the block.
   332	
   333	    PLAN-177 W0.1 / CF-2. _parse_verdict above is LAST-WINS, and so is the
   334	    step-15 reader: a second `verdict:` silently overrides the first, so
   335	    NO-GO followed by GO parses as GO. delta() requires exactly one. Same
   336	    block selection and same comment rule as the reader, or the count
   337	    would be about a different text than the parse.
   338	
   339	    Only meaningful once `_noncanonical_top_level_lines` is empty: this
   340	    counter does NOT strip the key and the step-15 twin does, so on a
   341	    non-canonical block the two counts differ. delta() checks the shape
   342	    first.
   343	    """
   344	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   345	    if block is None:
   346	        return 0
   347	    seen = 0
   348	    for raw in block.group(1).splitlines():
   349	        line = _strip_yaml_comment(raw)
   350	        if not line.strip() or line[0] in (" ", "\t"):
   351	            continue
   352	        m = re.match(r"\A([A-Za-z0-9_]+):", line)
   353	        if m and m.group(1) == key:
   354	            seen += 1
   355	    return seen
