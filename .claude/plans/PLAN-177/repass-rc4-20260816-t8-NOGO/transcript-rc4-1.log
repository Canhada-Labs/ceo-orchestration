  2284	def _live_tool_versions() -> Dict[str, str]:
  2285	    """codex pins read from the LIVE governance files, not from memory.
  2286	
  2287	    Both pins drift by ceremony (the semver range has been widened four times);
  2288	    deriving them keeps this control testing the decision instead of decaying
  2289	    into a pin-drift alarm.
  2290	    """
  2291	    min_v, _max_v = validator.parse_pin_range(GOVERNANCE / "codex-cli-pin.txt")
  2292	    assert min_v, "fixture broke: no semver range in codex-cli-pin.txt"
  2293	    manifest = json.loads(
  2294	        (GOVERNANCE / "codex-cli-pin-manifest.json").read_text(encoding="utf-8")
  2295	    )
  2296	    triple = sorted(manifest["payloads"])[0]
  2297	    return {
  2298	        "codex_cli": min_v,
  2299	        "codex_target_triple": triple,
  2300	        "codex_payload_sha256": manifest["payloads"][triple]["sha256"],
  2301	    }
