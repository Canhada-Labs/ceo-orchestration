   755	def _decision_line(item) -> str:
   756	    """One `verdict` line, canonical or with a LITERAL key spelling.
   757	
   758	    `item` is either the value (canonical `verdict: <value>`) or a
   759	    `(key_text, value)` pair whose key_text is emitted verbatim before the
   760	    colon — `("verdict ", "NO-GO")` writes `verdict : NO-GO`, the valid YAML
   761	    that the two rails parsed with two different grammars (PLAN-177 t2 P1-a).
   762	    """
   763	    if isinstance(item, tuple):
   764	        key, value = item
   765	        return "%s: %s\n" % (key, value)
   766	    return "verdict: %s\n" % item
   767	
   768	
   769	def write_verdict(
   770	    repo: Path,
   771	    tag: str,
   772	    parent: str,
   773	    allowlist: Sequence[str],
   774	    manifest_rel: str,
   775	    manifest_sha: str,
   776	    verdict=("GO",),
   777	) -> str:
   778	    """`verdict` accepts a str, None, or a SEQUENCE of decision lines.
   779	
   780	    The three shapes the PLAN-177 gate must separate: one line (normal),
   781	    zero lines (an author who never filled the template field in), two
   782	    lines (the last-wins override, where NO-GO followed by GO parses as
   783	    GO).
   784	
   785	    PLAN-177 t2 (P1-a): a sequence item may also be a `(key_text, value)`
   786	    pair, where `key_text` is the LITERAL spelling emitted before the colon
   787	    (`"verdict "`, `"verdict\\t"`). That is the only way to express the
   788	    grammar divergence the two rails had — writing `"verdict: %s"` for every
   789	    line can only produce canonical keys, which is precisely why the first
   790	    round of controls could not see the defect.
   791	    """
   792	    rel = ".claude/governance/pair-rail-verdict-%s.md" % tag
   793	    path = repo / rel
   794	    path.parent.mkdir(parents=True, exist_ok=True)
   795	    entries = "\n".join("  - %s" % e for e in allowlist)
   796	    if verdict is None:
   797	        decisions = []
   798	    elif isinstance(verdict, str):
   799	        decisions = [verdict]
   800	    else:
   801	        decisions = list(verdict)
   802	    decision = "".join(_decision_line(d) for d in decisions)
   803	    path.write_text(
   804	        "# Pair-Rail Verdict \u2014 %s\n\n```yaml\n%srelease_tag: %s\n"
   805	        "parent_sha: %s\ndelta_allowlist:\n%s\ndelta_manifest: %s\n"
   806	        "delta_manifest_sha256: %s\n```\n" % (
   807	            tag, decision, tag, parent, entries, manifest_rel, manifest_sha,
   808	        ),
   809	        encoding="utf-8",
   810	    )
   811	    return rel
