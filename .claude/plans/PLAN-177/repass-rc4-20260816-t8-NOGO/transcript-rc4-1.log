   348	def _run_with_manifest(args, verdict_text: str, manifest_text):
   349	    """Run validator with a tmpdir-scoped verdict + manifest pair.
   350	
   351	    ``manifest_text`` None → pass a nonexistent manifest path (the
   352	    infra arm).
   353	    """
   354	    with tempfile.TemporaryDirectory() as td:
   355	        verdict_path = Path(td) / "verdict.md"
   356	        verdict_path.write_text(verdict_text, encoding="utf-8")
   357	        manifest_path = Path(td) / "codex-cli-pin-manifest.json"
   358	        if manifest_text is not None:
   359	            manifest_path.write_text(manifest_text, encoding="utf-8")
   360	        cmd = [
   330	          VERSION="${TAG#v}"
   331	          # PLAN-153 Wave B item 5 (c) — same RC normalization as the
   332	          # "Assert VERSION matches tag" step above: RC tags never get
   333	          # their own CHANGELOG section; an RC for X.Y.Z validates
   334	          # against the GA `## [X.Y.Z]` section (which exists at RC-cut
   335	          # time because the VERSION bump + CHANGELOG entry land before
   336	          # the RC is tagged). Without this strip the fixed VERSION gate
   337	          # would just move the RC red run one step later.
   338	          VERSION="${VERSION%-rc.[0-9]*}"
   339	          if ! grep -qE "^## \[${VERSION}\]" CHANGELOG.md; then
   340	            echo "::error::CHANGELOG.md has no '## [${VERSION}]' section"
   341	            exit 1
   342	          fi
   343	          echo "OK: CHANGELOG has entry for [$VERSION]"
