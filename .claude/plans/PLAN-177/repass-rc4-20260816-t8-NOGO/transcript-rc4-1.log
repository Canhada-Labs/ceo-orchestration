  2395	@pytest.mark.parametrize("bind_parent", [True, False], ids=["bound", "unbound"])
  2396	def test_ci_validator_stops_a_duplicated_decision_key(tmp_path, ci_env, bind_parent):
  2397	    """Both readers are last-wins: NO-GO followed by GO parses as GO. An
  2398	    envelope with two decision lines is not a verdict, it is an override."""
  2399	    proc = _run_ci_validator(tmp_path, ci_env, ["NO-GO", "GO"], bind_parent)
  2400	    assert proc.returncode == validator.EXIT_VERDICT_INVALID, (
  2401	        "a duplicated verdict key was accepted -- last-wins parsing turned a "
  2402	        "NO-GO into a GO.\n%s%s" % (proc.stdout, proc.stderr)
  2403	    )
  2404	    assert _CI_DUPLICATE_DIAGNOSTIC in proc.stderr, proc.stderr
  2405	    assert "OK: verdict" not in proc.stdout
