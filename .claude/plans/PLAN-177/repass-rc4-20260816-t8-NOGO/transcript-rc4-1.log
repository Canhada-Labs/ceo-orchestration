  1121	def test_delta_refuses_to_pass_vacuously_when_the_verdict_anchors_itself(synth):
  1122	    """An anchor at (or after) the verdict makes every assert above trivially
  1123	    true: the delta is empty, and "all changed files are allowlisted" is a
  1124	    statement about nothing. That is the v1.16.0 self-reference bug wearing a
  1125	    new hat, and it is the vacuous-gate class this repo keeps paying for.
  1126	
  1127	    The guard reads the verdict from the working tree, which is what makes the
  1128	    fixture possible; the driver's own clean-tree check blocks this route
  1129	    locally, but the server-side port in release.yml reads a tree it did not
  1130	    produce, so the assert has to prove it actually saw the verdict move."""
  1131	    repo, env = synth["repo"], synth["env"]
  1132	    armed = arm_verdict(synth, "v1.3.0-rc.2")
  1133	    head = git(repo, env, "rev-parse", "HEAD")
  1134	    write_verdict(
  1135	        repo,
  1136	        "v1.3.0-rc.2",
  1137	        head,  # the commit that ALREADY contains this verdict
  1138	        [armed["verdict_rel"], armed["ev"]["manifest_rel"]]
  1139	        + armed["ev"]["artifact_rels"],
  1140	        armed["ev"]["manifest_rel"],
  1141	        armed["ev"]["manifest_sha"],
  1142	    )
  1143	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
  1144	    assert proc.returncode == tag_guard.E_VACUOUS, proc.stdout + proc.stderr
  1145	    assert "VACUOUSLY" in proc.stderr
  1146	    # and it is a DISTINCT mode from "a file landed outside the allowlist"
  1147	    assert tag_guard.E_VACUOUS != tag_guard.E_DELTA
