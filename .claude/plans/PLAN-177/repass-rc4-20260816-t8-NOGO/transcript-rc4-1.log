  2335	def _run_ci_validator(tmp_path, env, decisions: Sequence[str], bind_parent: bool):
  2336	    """Run the server-side validator with the LITERAL step-15 argv.
  2337	
  2338	    Source of the argv: .github/workflows/release.yml, job release-gate.
  2339	
  2340	    bind_parent=False is the --parent-sha "" shape of
  2341	    CEO_PAIR_RAIL_VERDICT_OPTIONAL=1. In THAT mode the step also carries
  2342	    continue-on-error, so this variant is a UNIT test of the validator, not a
  2343	    claim about the pipeline: what blocks a release in transition mode is
  2344	    _release_tag_guard.py delta (see the tag-guard controls below).
  2345	    """
  2346	    tag = "v0.0.0-plan177-decision-gate"
  2347	    parent = _repo_head()
  2348	    verdict_file = tmp_path / "pair-rail-verdict-fixture.md"
  2349	    _write_live_shaped_verdict(verdict_file, tag, decisions, parent)
  2350	    argv = [
  2351	        sys.executable, str(VALIDATOR_SRC),
  2352	        "--verdict-file", str(verdict_file),
  2353	        "--parent-sha", parent if bind_parent else "",
  2354	        "--release-tag", tag,
  2355	        "--max-age-hours", "24",
  2356	        "--recompute-inputs-hash",
  2357	        "--codex-cli-pin-file", ".claude/governance/codex-cli-pin.txt",
  2358	        "--codex-cli-binary-sha256-file",
  2359	        ".claude/governance/codex-cli-binary-sha256.txt",
  2360	        "--codex-pin-manifest-file",
  2361	        ".claude/governance/codex-cli-pin-manifest.json",
  2362	        "--inputs-hash-paths-file",
  2363	        ".claude/governance/pair-rail-inputs-hash-manifest.txt",
  2364	    ]
  2365	    return run(argv, REPO_ROOT, env)
