  2368	@pytest.mark.parametrize("bind_parent", [True, False], ids=["bound", "unbound"])
  2369	@pytest.mark.parametrize("decisions", _REFUSED_DECISIONS, ids=_REFUSED_IDS)
  2370	def test_ci_validator_stops_a_non_authorizing_decision(
  2371	    tmp_path, ci_env, decisions, bind_parent
  2372	):
  2373	    proc = _run_ci_validator(tmp_path, ci_env, decisions, bind_parent)
  2374	    assert proc.returncode == validator.EXIT_VERDICT_INVALID, (
  2375	        "step-15 argv + decision=%r returned %d -- this is the P1: the "
  2376	        "server-side validator authorised a release it never judged.\n%s%s"
  2377	        % (decisions, proc.returncode, proc.stdout, proc.stderr)
  2378	    )
  2379	    assert _DECISION_REFUSED in proc.stderr, (
  2380	        "red for the wrong reason -- the failure must name the DECISION and "
  2381	        "the accepted set, not a downstream mismatch: %s" % proc.stderr
  2382	    )
  2383	    # ASCII-only trim, mirroring the reader (t5 P1): a Unicode strip() here
  2384	    # would normalize the NBSP the diagnostic is REQUIRED to quote.
  2385	    observed = decisions[0].strip(" \t") if decisions else "<absent>"
  2386	    if decisions and not decisions[0].strip():
  2387	        observed = "<non-string:dict>"
  2388	    assert "'%s'" % observed in proc.stderr, (
  2389	        "the diagnostic must quote the value it OBSERVED (%r): %s"
  2390	        % (observed, proc.stderr)
  2391	    )
  2392	    assert "OK: verdict" not in proc.stdout
