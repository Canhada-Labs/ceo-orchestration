   172	        line = _strip_comment(raw)
   173	        if not line.strip():
   174	            continue
   175	        if line[0] in (" ", "\t"):
   176	            if parent != "bare":
   177	                bad.append(line)
   178	            continue
   179	        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):
   180	            _key, _, _val = line.partition(":")
   181	            parent = "scalar" if _val.strip() else "bare"
   182	            continue
   183	        bad.append(line)
   184	        parent = None
   185	    return bad
