  2268	def _live_inputs_hash() -> str:
  2269	    """Recompute inputs_hash in THIS checkout, with the validator own manifest.
  2270	
  2271	    Never copied from a real envelope (codex P2-2): the validator is itself
  2272	    listed in pair-rail-inputs-hash-manifest.txt, so the P1-4 cure CHANGES the
  2273	    expected hash. A hardcoded hex would make the green cases fail on
  2274	    inputs_hash and the test would prove nothing about the decision.
  2275	    """
  2276	    key = "inputs_hash"
  2277	    if key not in _VALIDATOR_INPUTS_HASH_CACHE:
  2278	        _VALIDATOR_INPUTS_HASH_CACHE[key] = validator.compute_inputs_hash(
  2279	            REPO_ROOT, GOVERNANCE / "pair-rail-inputs-hash-manifest.txt"
  2280	        )
  2281	    return _VALIDATOR_INPUTS_HASH_CACHE[key]
