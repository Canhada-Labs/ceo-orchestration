  2408	# PLAN-177 t2 (re-pass rc.4 P1-a) -- the GRAMMAR the two rails share.
  2409	#
  2410	# `verdict : NO-GO` is valid YAML and last-wins under a real parser. The
  2411	# server validator strips the key, so it counted TWO declarations; the local
  2412	# tag guard's regex required the colon immediately after the name, so it
  2413	# counted ONE and parsed GO -- and the local guard is the rail with no escape
  2414	# hatch. The first round of controls could not see this: every fixture line
  2415	# was built as `"verdict: %s"`, which can only produce canonical keys.
  2416	#
  2417	# Cured semantics (identical in both files): non-canonical top-level syntax
  2418	# is REFUSED. So the duplicate variants are red for the SHAPE, and the single
  2419	# non-canonical key is red too -- an authorizing decision must be spelled the
  2420	# one way the template spells it.
  2421	_NONCANONICAL_DIAGNOSTIC = "non-canonical top-level key syntax"
