   814	def arm_verdict(
   815	    synth,
   816	    tag: str,
   817	    slug: str = "repass-r2",
   818	    extra_allow=(),
   819	    verdict=("GO",),
   820	):
   821	    """Commit a re-pass + verdict for `tag`, anchored at the pre-verdict HEAD."""
   822	    repo, env = synth["repo"], synth["env"]
   823	    parent = git(repo, env, "rev-parse", "HEAD")
   824	    ev = make_repass(
   825	        repo, slug, {"verdict-r1.txt": "GO\n", "transcript-r1.log": "rounds: 3\n"}
   826	    )
   827	    verdict_rel = ".claude/governance/pair-rail-verdict-%s.md" % tag
   828	    allow = [verdict_rel, ev["manifest_rel"]] + ev["artifact_rels"] + list(extra_allow)
   829	    write_verdict(
   830	        repo, tag, parent, allow, ev["manifest_rel"],
   831	        ev["manifest_sha"], verdict=verdict,
   832	    )
   833	    git(repo, env, "add", "-A")
   834	    git(repo, env, "commit", "-q", "-m", "governance: verdict %s" % tag)
   835	    git(repo, env, "push", "-q", "origin", "main")
   836	    git(repo, env, "fetch", "-q", "origin", "main")
   837	    return {"parent": parent, "verdict_rel": verdict_rel, "ev": ev}
