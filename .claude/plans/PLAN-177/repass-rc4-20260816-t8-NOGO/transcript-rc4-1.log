    52	def _make_verdict(
    53	    *,
    54	    decision_lines: Sequence[str] = ("verdict: GO",),
    55	    release_tag: str = "v1.99.0",
    56	    parent_sha: str = "",
    57	    commit_sha: str = "",
    58	    inputs_hash: str = "deadbeef" * 8,
    59	    generated_at: str = "9999-01-01T00:00:00Z",
    60	    ttl_hours: int = 87600,
    61	    tool_versions_block: str = (
    62	        "  codex_cli: 0.129.0\n"
    63	        "  codex_cli_binary_sha256: " + "a" * 64
    64	    ),
    65	    include_signature: bool = True,
    66	) -> str:
    67	    """Build a verdict markdown file with the requested envelope.
    68	
    69	    `decision_lines` are emitted VERBATIM (PLAN-177 t2 / P1-a): the grammar
    70	    divergence between this validator and the local tag guard can only be
    71	    expressed by writing the key spelling itself -- `verdict : NO-GO` is
    72	    valid YAML and was counted here but skipped there.
    73	    """
    74	    lines = [
    75	        "# Pair-Rail Verdict — test",
    76	        "",
    77	        "```yaml",
    78	        *decision_lines,
    79	        f"generated_at: {generated_at}",
    80	        f"ttl_hours: {ttl_hours}",
    81	        f"release_tag: {release_tag}",
    82	    ]
    83	    if parent_sha:
    84	        lines.append(f"parent_sha: {parent_sha}")
    85	    if commit_sha:
    86	        lines.append(f"commit_sha: {commit_sha}")
    87	    lines.append(f"inputs_hash: {inputs_hash}")
    88	    lines.append("tool_versions:")
    89	    lines.append(tool_versions_block)
    90	    if include_signature:
    91	        lines.append("gpg_signature: |")
    92	        lines.append("  -----BEGIN PGP SIGNATURE-----")
    93	        lines.append("  fake-sig-for-test")
    94	        lines.append("  -----END PGP SIGNATURE-----")
    95	    lines.append("```")
    96	    return "\n".join(lines) + "\n"
    97	
    98	
    99	def _run(args, verdict_text: str):
   100	    """Run validator on a tmpdir-scoped verdict file. Returns CompletedProcess."""
   101	    with tempfile.TemporaryDirectory() as td:
   102	        verdict_path = Path(td) / "verdict.md"
   103	        verdict_path.write_text(verdict_text, encoding="utf-8")
   104	        cmd = [
   105	            sys.executable, str(SCRIPT),
   106	            "--verdict-file", str(verdict_path),
   107	            *args,
   108	        ]
   109	        return subprocess.run(cmd, capture_output=True, text=True, timeout=30)
