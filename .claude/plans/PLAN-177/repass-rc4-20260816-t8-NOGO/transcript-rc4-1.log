   751	    p_anc = sub.add_parser("ancestry", help="HEAD must be on origin/<branch>")
   752	    p_anc.add_argument("--repo", default=".")
   753	    p_anc.add_argument("--remote", default="origin")
   754	    p_anc.add_argument("--branch", default="main")
