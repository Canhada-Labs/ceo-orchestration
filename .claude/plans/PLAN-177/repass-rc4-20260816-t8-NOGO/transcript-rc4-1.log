   405	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   406	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   407	    verdict_abs = os.path.join(repo, verdict_rel)
   408	    if not os.path.isfile(verdict_abs):
   409	        return _fail(
   410	            E_VERDICT,
   411	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   412	            "be committed before the tag is cut (release.yml validates it per "
   413	            "tag on the tagged tree)." % verdict_rel,
   414	        )
   415	    with open(verdict_abs, encoding="utf-8") as fh:
   416	        verdict_text = fh.read()
   417	    # PLAN-177 t2 (P1-a): SHAPE BEFORE ANY FIELD. Both rails read this file;
   418	    # they only agree on a canonical block. A non-canonical top-level line is
   419	    # refused here rather than handed to two different grammars — E_DECISION
   420	    # because the class this closes is the decision override (`verdict :
   421	    # NO-GO` + `verdict: GO`), and because a refusal that names the decision
   422	    # rail is the one an operator can act on.
   423	    noncanonical = _noncanonical_top_level_lines(verdict_text)
   424	    if noncanonical:
   425	        return _fail(
   426	            E_DECISION,
   427	            "verdict %s: non-canonical top-level key syntax %r -- a "
   428	            "top-level line must be\n"
   429	            "      `name:` with no whitespace before the colon (or a `- ` "
   430	            "list item). The two release rails read this\n"
   431	            "      file with different grammars, so `verdict : NO-GO` "
   432	            "followed by `verdict: GO` counts as two\n"
   433	            "      declarations server-side and one here; the shape is "
   434	            "refused instead of guessed."
   435	            % (verdict_rel, noncanonical),
   436	        )
   437	    fields = _parse_verdict(verdict_text)
   438	
   439	    release_tag = fields.get("release_tag")
   440	    if release_tag != tag:
   441	        return _fail(
   442	            E_VERDICT,
   443	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   444	            "to judge this tag against another tag's verdict."
   445	            % (verdict_rel, release_tag, tag),
   446	        )
   447	    # PLAN-177 W0.1 (P1-4) -- the DECISION gate.
   448	    #
   449	    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on): the
   450	    # server-side twin (.github/scripts/validate-pair-rail-verdict.py, step
   451	    # 15) carries `continue-on-error` when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1
   452	    # (release.yml:689) -- there the decision check is defence in depth.
   453	    # THIS is the rail that enforces in every mode: release.sh calls it with
   454	    # `|| die`, and the release.yml step that calls it carries no escape
   455	    # hatch. Neither may be dropped for the other.
   456	    #
   457	    # Fail-CLOSED on SHAPE as well as value (CF-1): _parse_verdict returns a
   458	    # LIST for an empty `verdict:` line, so the type check precedes the
   459	    # compare -- a malformed decision is a named refusal, never a crash.
   460	    declared_decisions = _count_top_level_key(verdict_text, "verdict")
   461	    if declared_decisions > 1:
   462	        return _fail(
   463	            E_DECISION,
   464	            "verdict %s declares the decision %d times -- this reader "
   465	            "is last-wins, so a duplicated\n"
   466	            "      `verdict:` silently overrides the first; exactly one "
   467	            "is required."
   468	            % (verdict_rel, declared_decisions),
   469	        )
   470	    decision = fields.get("verdict")
   471	    if decision is None:
   472	        shown = "<absent>"
   473	    elif not isinstance(decision, str):
   474	        shown = "<non-string:%s>" % type(decision).__name__
   475	    else:
   476	        # ASCII-only trim (t5 P1) — twin of the server validator.
   477	        shown = decision.strip(" \t")
   478	    if shown not in ACCEPTED_DECISIONS:
   479	        return _fail(
   480	            E_DECISION,
   481	            "verdict %s: decision '%s' not in {%s} -- a tag may only be "
   482	            "cut on an authorizing decision.\n"
   483	            "      Everything the checks below assert (anchor, closed "
   484	            "allowlist, manifest content) is about WHICH TREE the\n"
   485	            "      re-pass saw; this one is about what the re-pass SAID "
   486	            "about it. A NO-GO over a perfect delta is still a NO-GO."
   487	            % (verdict_rel, shown, ", ".join(ACCEPTED_DECISIONS)),
   488	        )
   489	    parent = fields.get("parent_sha")
   490	    if not isinstance(parent, str) or not HEX40.match(parent):
   491	        return _fail(
   492	            E_VERDICT,
   493	            "verdict %s has no usable 40-hex `parent_sha:` — that field IS "
   494	            "the review anchor." % verdict_rel,
   495	        )
   496	    rc, _out, _err = _git(repo, "cat-file", "-e", parent + "^{commit}")
   497	    if rc != 0:
   498	        return _fail(
   499	            E_VERDICT,
   500	            "parent_sha %s from %s is not a commit in this repo."
   501	            % (parent, verdict_rel),
   502	        )
   503	    # Existence is not lineage. A fabricated anchor (`git commit-tree` over
   504	    # HEAD's own tree, parented anywhere, on no branch) passes `cat-file -e`
   505	    # and makes diff(parent..HEAD) contain ONLY the verdict + evidence while
   506	    # unreviewed work sits on main — every check below then passes and the
   507	    # guard prints approval over a tree the re-pass never saw. The anchor has
   508	    # to be a commit HEAD actually descends from. (The staged W1 server-side
   509	    # port asserts the same against origin/main — keep the two in sync.)
   510	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", parent, "HEAD")
   511	    if rc == 1:
   512	        return _fail(
   513	            E_PARENT_NOT_ANCESTOR,
   514	            "parent_sha %s from %s is not an ancestor of HEAD — the review "
   515	            "anchor is not in\n"
   516	            "      the history this tag would sign. `cat-file -e` proves the "
   517	            "object exists, not\n"
   518	            "      that main descends from it; a fabricated commit carrying "
   519	            "HEAD's own tree\n"
   520	            "      makes the delta below trivially clean while unreviewed "
   521	            "work rides the tag."
   522	            % (parent[:12], verdict_rel),
   523	        )
   524	    if rc != 0:
   525	        return _fail(
   526	            E_PARENT_NOT_ANCESTOR,
   527	            "`git merge-base --is-ancestor %s HEAD` exited %d (neither yes "
   528	            "nor no) — refusing to guess (git said: %s)"
   529	            % (parent[:12], rc, err.strip()),
   530	        )
   531	    print("  ok   parent_sha %s is an ancestor of HEAD" % parent[:12])
   532	
   533	    allow = fields.get("delta_allowlist")
   534	    if not isinstance(allow, list) or not allow:
   535	        return _fail(
   536	            E_VERDICT,
   537	            "verdict %s carries no `delta_allowlist:` entries — the closed "
   538	            "set is what makes the delta assert meaningful." % verdict_rel,
   539	        )
   540	    for entry in allow:
   541	        if any(ch in entry for ch in GLOB_CHARS):
   542	            return _fail(
   543	                E_VERDICT,
   544	                "delta_allowlist entry %r contains a glob metacharacter. The "
   545	                "set is CLOSED and literal: a pattern like "
   546	                "`pair-rail-verdict-*.md` would let a historical verdict or "
   547	                "the template be edited and still pass." % entry,
   548	            )
   549	        if entry.startswith("/") or ".." in entry.split("/"):
   550	            return _fail(
   551	                E_VERDICT,
   552	                "delta_allowlist entry %r must be a repo-relative path with "
   553	                "no `..` segment." % entry,
   554	            )
   555	        if entry.startswith(VERDICT_PREFIX) and entry != verdict_rel:
   556	            return _fail(
   557	                E_VERDICT,
   558	                "delta_allowlist entry %r is another tag's verdict (or the "
   559	                "template). Only %s may move for this tag."
   560	                % (entry, verdict_rel),
