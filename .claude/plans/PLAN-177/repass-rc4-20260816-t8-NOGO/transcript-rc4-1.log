   187	
   188	def count_top_level_key(text: str, key: str) -> int:
   189	    """How many times `key:` is declared at the top level of the block.
   190	
   191	    Both readers of this signed file are LAST-WINS, so a second
   192	    `verdict:` silently overrides the first: NO-GO followed by GO parses
   193	    as GO. Callers require exactly one.
   194	
   195	    Only meaningful once `noncanonical_top_level_lines` is empty: this
   196	    counter strips the key, so it sees `verdict : X` as a declaration and
   197	    the twin counter in the tag guard does not. Callers run the shape
   198	    check FIRST.
   199	    """
   200	    m = _YAML_BLOCK_RE.search(text)
   201	    if not m:
   202	        return 0
   203	    seen = 0
   204	    for raw in m.group(1).splitlines():
   205	        line = _strip_comment(raw)
   206	        if not line.strip() or line[0] in (" ", "\t"):
   207	            continue
   208	        if line.partition(":")[0].strip() == key:
   209	            seen += 1
   210	    return seen
   211	
   212	
   213	def parse_verdict_text(text: str) -> Dict[str, Any]:
   214	    """Parse YAML frontmatter from verdict TEXT. Returns dict."""
   215	    m = _YAML_BLOCK_RE.search(text)
   216	    if not m:
   217	        raise ValueError("verdict file missing yaml frontmatter block")
   218	    yaml_body = m.group(1)
   219	    # Inline minimal YAML parse (stdlib only)
   220	    out: Dict[str, Any] = {}
   221	    current_key: Optional[str] = None
   222	    for raw in yaml_body.splitlines():
   223	        line = _strip_comment(raw)
   224	        if not line.strip():
   225	            continue
   226	        if line[0] not in (" ", "\t"):
   227	            if ":" in line:
   228	                k, _, v = line.partition(":")
   229	                # ASCII-only value trim (t5 P1): a Unicode strip() would
   230	                # normalize `GO<U+00A0>` into the exact authorizing token.
   231	                v = v.strip(" \t")
   232	                if v:
   233	                    out[k.strip(" \t")] = v
   234	                else:
   235	                    out[k.strip(" \t")] = {}
   236	                    current_key = k.strip(" \t")
   237	        elif current_key and ":" in line:
   238	            sub_k, _, sub_v = line.partition(":")
   239	            if isinstance(out[current_key], dict):
   240	                out[current_key][sub_k.strip(" \t")] = sub_v.strip(" \t")
   241	    return out
   242	
   243	
   244	def parse_verdict_file(path: Path) -> Dict[str, Any]:
   245	    """Path wrapper over parse_verdict_text (published entry point)."""
   246	    if not path.exists():
   247	        raise FileNotFoundError(f"verdict file: {path}")
   248	    return parse_verdict_text(path.read_text(encoding="utf-8"))
   249	
   250	
   251	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   252	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   253	    if not manifest_path.exists():
   254	        raise FileNotFoundError(f"manifest: {manifest_path}")
   255	    paths = []
   256	    for line in manifest_path.read_text().splitlines():
   257	        line = line.split("#", 1)[0].strip()
   258	        if line:
   259	            paths.append(line)
   260	    paths.sort()
   261	    hashes = {}
   262	    for p in paths:
   263	        result = subprocess.run(
   264	            ["git", "hash-object", p],
   265	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   266	        )
   267	        if result.returncode != 0:
   268	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   269	        hashes[p] = result.stdout.strip()
   270	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   271	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   272	
   273	
   274	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   275	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   276	    if not pin_file.exists():
   277	        return None, None
   278	    for line in pin_file.read_text().splitlines():
   279	        line = line.split("#", 1)[0].strip()
   280	        if not line:
   281	            continue
   282	        # parse `>=X.Y.Z,<A.B.C` shape
   283	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   284	        if m:
   285	            return m.group(1), m.group(2)
   286	    return None, None
   287	
   288	
   289	def parse_semver(s: str) -> Tuple[int, int, int]:
   290	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   291	    if not m:
   292	        raise ValueError(f"unparseable semver: {s!r}")
   293	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   294	
   295	
   296	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   297	    try:
   298	        v = parse_semver(version)
   299	        lo = parse_semver(min_v)
   300	        hi = parse_semver(max_v)
   301	        return lo <= v < hi
   302	    except ValueError:
   303	        return False
