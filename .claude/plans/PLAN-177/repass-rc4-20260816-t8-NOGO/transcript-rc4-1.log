  1499	def test_contract_rows_reject_malformed_row_instead_of_dropping_it():
  1500	    """t7 P2 positive control: a Contract row with an extra `|` (5 cells)
  1501	    must FAIL the parser, not disappear from validation."""
  1502	    doc = (
  1503	        "## Contract\n\n"
  1504	        "| Control | Mechanism | Status | Where |\n"
  1505	        "| --- | --- | --- | --- |\n"
  1506	        "| good row | m | enforced | w (`a.yml` step `b`) |\n"
  1507	        "| bad | row | with | extra | cell |\n"
  1508	    )
  1509	    try:
  1510	        _contract_rows(doc)
  1511	    except AssertionError as exc:
  1512	        assert "bad" in str(exc)
  1513	    else:
  1514	        raise AssertionError(
  1515	            "5-cell Contract row was silently accepted/dropped"
  1516	        )
