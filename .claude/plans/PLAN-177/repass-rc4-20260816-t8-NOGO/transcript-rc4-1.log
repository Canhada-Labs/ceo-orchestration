  2304	def _write_live_shaped_verdict(
  2305	    path: Path, tag: str, decisions: Sequence[str], parent: str
  2306	) -> None:
  2307	    """A verdict envelope the LIVE governance files accept end to end.
  2308	
  2309	    `decisions` is a SEQUENCE so the fixture can express the three shapes the
  2310	    gate must separate: zero lines (absent), one line (normal), two lines (the
  2311	    last-wins override). Values are written verbatim -- a malformed or unknown
  2312	    token reaches the validator exactly as authored.
  2313	    """
  2314	    tv = _live_tool_versions()
  2315	    now = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%S")
  2316	    lines = ["# Pair-Rail Verdict -- fixture", "", "```yaml"]
  2317	    lines += [_decision_line(d).rstrip("\n") for d in decisions]
  2318	    lines += [
  2319	        "generated_at: %sZ" % now,
  2320	        "ttl_hours: 24",
  2321	        "parent_sha: %s" % parent,
  2322	        "release_tag: %s" % tag,
  2323	        "inputs_hash: %s" % _live_inputs_hash(),
  2324	        "tool_versions:",
  2325	        "  codex_cli: %s" % tv["codex_cli"],
  2326	        "  codex_target_triple: %s" % tv["codex_target_triple"],
  2327	        "  codex_payload_sha256: %s" % tv["codex_payload_sha256"],
  2328	        "gpg_signature: -----BEGIN PGP SIGNATURE----- fixture-not-a-signature",
  2329	        "```",
  2330	        "",
  2331	    ]
  2332	    path.write_text("\n".join(lines), encoding="utf-8")
