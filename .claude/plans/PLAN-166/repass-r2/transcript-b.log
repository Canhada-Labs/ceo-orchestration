   469	_derive_hash_source() {  # $1 surface $2 after_rec $3 prior_rec $4 src_root
   470	  local surface="$1" ar="$2" pr="$3" src="$4"
   471	  [[ -z "$ar" ]] && { printf 'HASH_NONE'; return 0; }
   472	  case "$ar" in link:*) printf 'LINK_RECORD'; return 0 ;; esac
   473	
   474	  local got="${ar#hash:}"
   475	  local rel; rel="$( _relpath_for "$surface" )"
   476	
   477	  # Candidate 1: the bytes now at the target.
   478	  local c_target; c_target="$( _obs_digest "$T/$rel" )"
   479	  # Candidate 2: the framework's copy in the source checkout.
   480	  local c_source; c_source="$( _obs_digest "$src/$rel" )"
   481	  # Candidate 3: the digest the PRE-run manifest recorded.
   482	  local c_prior="${pr#hash:}"
   483	  # Candidate 4: the canonical pointer digest (protocol only).
   484	  local c_pointer="$CANON_POINTER_HASH"
   485	
   486	  # For tree surfaces the recorded value is the roll-up of per-file rows, which
   487	  # is not comparable to a content fingerprint — compare tree membership by
   488	  # re-deriving both roll-ups instead.
   489	  if [[ "$surface" == "spec" ]]; then
   490	    local roll_t roll_s
   491	    roll_t="$( _rollup_from_tree "$T/$rel" "$rel" )"
   492	    roll_s="$( _rollup_from_tree "$src/$rel" "$rel" )"
   493	    [[ -n "$c_prior" && "$got" == "$c_prior" ]] && { printf 'HASH_PRIOR_RECORD'; return 0; }
   494	    [[ -n "$roll_s" && "$got" == "$roll_s" ]] && { printf 'HASH_SOURCE'; return 0; }
   495	    [[ -n "$roll_t" && "$got" == "$roll_t" ]] && { printf 'HASH_TARGET'; return 0; }
   496	    printf 'HASH_UNCLASSIFIED'; return 0
   497	  fi
   498	
   499	  # The canonical pointer digest is the hash of what the framework WOULD
   500	  # generate — it matches no file on disk when the pointer is customised, so it
   501	  # has to be recognised explicitly or every correct record reads as
   502	  # unclassified.
   503	  # Order matters and is NOT arbitrary. For a PRISTINE pointer the canonical
   504	  # digest and the prior record are the SAME bytes, so whichever is tested
   505	  # first wins the name. Testing the prior record first keeps continuity rows
   506	  # reading as HASH_PRIOR_RECORD, and the canonical name is then reached only
   507	  # when the two genuinely differ — i.e. when the pointer was customised, which
   508	  # is the one cell where the distinction carries meaning.
   509	  #
   510	  # PLAN-168 W2 (codex rail r2 P1): post-INV-4, install and upgrade produce
   511	  # the SAME bytes, so on continuity rows c_prior == c_pointer even for the
   512	  # preserved-EDITED cell — the two names collapse into one claim. When they
   513	  # alias and the record matches that one digest, report the name the TABLE
   514	  # expects (5th arg): letting probe order pick would manufacture a
   515	  # distinction the observation cannot make, and the cell would read RED over
   516	  # a naming artifact. This resolves ONLY the aliased case — when the digests
   517	  # genuinely differ, the probes below decide exactly as before.
   518	  local exp_hint="${5:-}"
   519	  if [[ "$surface" == "protocol" && -n "$c_prior" && -n "$c_pointer" \
   520	        && "$c_prior" == "$c_pointer" && "$got" == "$c_prior" ]]; then
   521	    case "$exp_hint" in
   522	      HASH_PRIOR_RECORD|HASH_CANONICAL_POINTER) printf '%s' "$exp_hint"; return 0 ;;
   523	    esac
   524	  fi
   525	  [[ -n "$c_prior"   && "$got" == "$c_prior"   ]] && { printf 'HASH_PRIOR_RECORD'; return 0; }
   526	  if [[ "$surface" == "protocol" && -n "$c_pointer" && "$got" == "$c_pointer" ]]; then
   527	    printf 'HASH_CANONICAL_POINTER'; return 0
   528	  fi
   529	  [[ -n "$c_source"  && "$got" == "$c_source"  ]] && { printf 'HASH_SOURCE'; return 0; }
   530	  [[ -n "$c_pointer" && "$got" == "$c_pointer" ]] && { printf 'HASH_CANONICAL_POINTER'; return 0; }
   531	  [[ -n "$c_target"  && "$got" == "$c_target"  ]] && { printf 'HASH_TARGET'; return 0; }
   532	  printf 'HASH_UNCLASSIFIED'
   533	}
