   539	    | while IFS= read -r r; do
   540	        [[ -n "$r" ]] || continue
   541	        printf '%s  %s/%s\n' "$( _hash_file "$root/$r" 2>/dev/null || echo FAIL )" "$pfx" "${r#./}"
   542	      done | LC_ALL=C sort | _hash_stdin
   543	}
