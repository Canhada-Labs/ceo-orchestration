   603	    || { ERR=$((ERR+1)); return; }
   604	
   605	  # Fault injection from the `fault` COLUMN. It rode in `note` until round-1
   606	  # consensus C1 ruled that a dimension the harness parses out of prose is a
   607	  # dimension nothing validates.
   608	  local bak_guard=""
   609	  case "$fault" in
   610	    backup_unwritable)
