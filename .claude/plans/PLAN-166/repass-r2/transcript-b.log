   159	# Modification-time signature of a surface. GNU stat takes -c, BSD takes -f.
   160	# GNU-FIRST is load-bearing (PLAN-169 W1): on GNU, `stat -f '%m'` SUCCEEDS
   161	# and prints the filesystem MOUNT POINT, so the BSD-first order contaminated
   162	# stdout on Linux and the fallback never ran — the mtime signal was dead on
   163	# every cell. BSD `stat -c` fails clean to stderr, so GNU-first is safe on
   164	# both. Output that is not pure digits is an instrument fault surfaced as
   165	# MTIME-ERR, never discarded (input-parse failure is fail-closed).
   166	_stat_mtime() {  # $1 = abs path
   167	  local out
   168	  out="$( stat -c '%Y' "$1" 2>/dev/null || stat -f '%m' "$1" 2>/dev/null || printf '0' )"
   169	  if [[ "$out" =~ ^[0-9]+$ ]]; then printf '%s' "$out"; else printf 'MTIME-ERR'; fi
   170	}
   171	_obs_mtime() {  # $1 = abs path -> newest mtime under it (or its own)
   172	  local p="$1" newest=0 m r
   173	  if [[ -L "$p" || ! -e "$p" ]]; then printf '%s' "$( _stat_mtime "$p" )"; return 0; fi
   174	  if [[ -d "$p" ]]; then
   175	    while IFS= read -r r; do
   176	      [[ -n "$r" ]] || continue
   177	      m="$( _stat_mtime "$p/$r" )"
   178	      # A non-numeric signature is the instrument lying, not noise: propagate
   179	      # MTIME-ERR so the caller turns it into HARNESS-ERR. The silent
   180	      # `continue` here is what hid the dead signal (sub-detection of
   181	      # 0017/0021). A file that vanished mid-walk stats to '0' and is fine.
   182	      [[ "$m" =~ ^[0-9]+$ ]] || { printf 'MTIME-ERR'; return 0; }
   183	      (( m > newest )) && newest="$m"
   184	    done < <( cd "$p" && find . -type f -print 2>/dev/null )
   185	    printf '%s' "$newest"; return 0
   186	  fi
   187	  printf '%s' "$( _stat_mtime "$p" )"
   188	}
