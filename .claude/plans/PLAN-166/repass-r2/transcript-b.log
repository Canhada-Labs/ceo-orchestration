   545	# =============================================================================
   546	# Row execution
   547	# =============================================================================
   548	PASS=0; FAIL=0; AMBIG=0; ERR=0
   549	MAP_LINES=""
   550	
   551	_run_row() {
   552	  local id="$1" surface="$2" prior_record="$3" live_type="$4" live_content="$5"
   553	  local source_has="$6" mode="$7" ceremony="$8" operation="$9" skip_requested="${10}"
   554	  local fault="${11}"
   555	  local exp_verdict="${12}" exp_hash="${13}" origin="${14}" note="${15}"
   556	
   557	  local rel; rel="$( _relpath_for "$surface" )" || { ERR=$((ERR+1)); return; }
   558	
   559	  # --- base selection ------------------------------------------------------
   560	  # base_mode follows PRIOR_RECORD (the previous run), never `mode` (this run).
   561	  # Conflating them would erase the r11-F1 cell — see docs §4.1.
   562	  local base_mode="copy"
   563	  case "$prior_record" in link_match|link_retargeted) base_mode="link" ;; esac
   564	  local base_ceremony="$ceremony"
   565	  # A user-ceremony row asserting residue of a MAINTAINER install must be built
   566	  # from a maintainer base, then transitioned — that transition is the r7-F2 cell.
   567	  local transition_to_user=0
   568	  if [[ "$ceremony" == "user" && "$prior_record" != "none" && "$surface" != "marker" ]]; then
   569	    base_ceremony="maintainer"; transition_to_user=1
   570	  fi
   735	# blind once without failing: BSD-first stat contaminated stdout on GNU, the
   736	# garbage was discarded silently, and byte-identical REFRESH became invisible
   737	# on every cell (the class that blinded OWN-0073). A dead signal must kill
   738	# the run before any cell executes, not tint the map: rewrite a probe
   739	# byte-identically with a bumped timestamp and REQUIRE the observed
   740	# signature to change, numerically, for both a file and a directory walk.
   741	_selfcheck_mtime() {
   742	  local pf="$WORK/mtime-probe" pd="$WORK/mtime-probe-dir" m1 m2 d1 d2
   743	  mkdir -p "$pd"
   744	  printf 'probe' > "$pf";      printf 'probe' > "$pd/f"
   745	  touch -t 202001010000 "$pf" "$pd/f" 2>/dev/null || true
   746	  m1="$( _obs_mtime "$pf" )";  d1="$( _obs_mtime "$pd" )"
   747	  printf 'probe' > "$pf";      printf 'probe' > "$pd/f"   # byte-identical
   748	  touch -t 202001010001 "$pf" "$pd/f" 2>/dev/null || true
   749	  m2="$( _obs_mtime "$pf" )";  d2="$( _obs_mtime "$pd" )"
   750	  if [[ ! "$m1" =~ ^[0-9]+$ || ! "$m2" =~ ^[0-9]+$ || "$m1" == "$m2" \
   751	     || ! "$d1" =~ ^[0-9]+$ || ! "$d2" =~ ^[0-9]+$ || "$d1" == "$d2" ]]; then
   752	    echo "HARNESS-ERR: mtime-signal self-check FAILED (file $m1->$m2, dir $d1->$d2)." >&2
   753	    echo "             byte-identical REFRESH would be undetectable — refusing to run." >&2
   754	    exit 2
   755	  fi
   756	  rm -f "$pf" "$pd/f"; rmdir "$pd" 2>/dev/null || true
   757	}
   758	_selfcheck_mtime
   759	
   760	# Prime the canonical pointer digest for $T from a real install. Structurally
   761	# fresh rows build no base, so without this the protocol candidate would be
   762	# unavailable exactly where it is needed.
   763	_base_tar maintainer copy >/dev/null || { echo "ERROR: could not prime base" >&2; exit 2; }
   764	
   765	
   766	# Rows are consumed in file order; the map is sorted by id at emit time so the
   767	# output is deterministic regardless of table order.
   768	while IFS=$'\t' read -r id surface prior_record live_type live_content \
   769	      source_has mode ceremony operation skip_requested fault \
   770	      exp_verdict exp_hash origin note; do
   771	  [[ -z "${id:-}" ]] && continue
   772	  case "$id" in \#*|id) continue ;; esac
   773	  # --only takes a comma-separated list: iterating on a cluster of related rows
   774	  # should cost ONE base install, not one per row.
   775	  if [[ -n "$ONLY" && ",$ONLY," != *",$id,"* ]]; then continue; fi
   776	  _run_row "$id" "$surface" "$prior_record" "$live_type" "$live_content" \
   777	           "$source_has" "$mode" "$ceremony" "$operation" "$skip_requested" \
   778	           "${fault:-none}" "$exp_verdict" "$exp_hash" "$origin" "${note:-}"
   779	done < "$TSV"
   780	
   781	printf '%s' "$MAP_LINES" | LC_ALL=C sort
   782	
   783	echo ""
   784	echo "GREEN=$PASS  RED=$FAIL  AMBIG=$AMBIG  HARNESS-ERR=$ERR"
   785	
   786	# --map is a REPORTING mode, never a gate. Suppressing a non-zero exit is its
   787	# whole purpose, so a CI step that uses it becomes a dead gate that reports
   788	# success forever. Say so loudly on the way out, on stderr, so the mistake is
   789	# visible in the job log instead of silent (PLAN-168 debate r1, QA must-fix 2).
   790	if [[ "$MAP_ONLY" -eq 1 ]]; then
   791	  if [[ "$FAIL" -gt 0 || "$ERR" -gt 0 ]]; then
   792	    echo "" >&2
   793	    echo "NOTE: --map is a REPORTING mode and is exiting 0 despite RED=$FAIL ERR=$ERR." >&2
   794	    echo "      Do NOT use --map in a gate. Run without it to get a pass/fail exit." >&2
   795	  fi
   796	  exit 0
   797	fi
   798	[[ "$ERR" -gt 0 ]] && exit 2
   799	[[ "$FAIL" -gt 0 ]] && exit 1
   800	exit 0
    55	ERRS="$WORK/err.txt"
    56	
    57	rc=0
    58	( cd "$REPO_ROOT" && eval "$HARNESS" ) > "$MAP" 2> "$ERRS" || rc=$?
    59	
    60	cat "$MAP"
    61	sed -n '1,40p' "$ERRS" >&2 || true
    62	
    63	if [[ "$rc" -ge 2 ]]; then
    64	  echo "GATE-RED: harness returned rc=$rc (harness/infra error — not comparable)" >&2
    65	  exit 1
    66	fi
    67	
    68	# The summary line is load-bearing: without it, a run that died mid-table
    69	# would present a truncated (smaller) non-GREEN set that could still match a
    70	# shrunken expectation. HARNESS-ERR must be literally 0.
    71	if ! grep -E '^GREEN=[0-9]+[[:space:]]+RED=[0-9]+[[:space:]]+AMBIG=[0-9]+[[:space:]]+HARNESS-ERR=0$' "$MAP" >/dev/null; then
    72	  echo "GATE-RED: summary line missing or HARNESS-ERR>0 — partial or vacuous output cannot pass" >&2
    73	  exit 1
    74	fi
    75	
    76	# The RED-set comparison alone cannot prove the FULL table ran: a run that
    77	# silently skipped every GREEN cell would still present the expected REDs and
    78	# an honest-looking summary (codex pack-review P1). Demand that the observed
    79	# id set equals the TABLE's id set — authority: the harness's own --list
    80	# (which reads the TSV), overridable only by the positive control's seam.
    81	if [[ -n "${OWNERSHIP_GATE_EXPECTED_ALL:-}" ]]; then
    82	  grep -E '^OWN-' "$OWNERSHIP_GATE_EXPECTED_ALL" | LC_ALL=C sort > "$WORK/all-exp.txt"
    83	else
    84	  ( cd "$REPO_ROOT" && bash scripts/tests/test-ownership-table.sh --list ) 2>/dev/null \
    85	    | awk '{print $1}' | grep -E '^OWN-' | LC_ALL=C sort > "$WORK/all-exp.txt"
    86	fi
    87	grep -E '^OWN-[0-9]+[[:space:]]' "$MAP" | awk '{print $1}' | LC_ALL=C sort > "$WORK/all-got.txt"
    88	if [[ ! -s "$WORK/all-exp.txt" ]]; then
    89	  echo "GATE-RED: could not derive the full table id set (--list empty) — cannot certify coverage" >&2
    90	  exit 1
    91	fi
    92	if ! diff -u "$WORK/all-exp.txt" "$WORK/all-got.txt" >/dev/null; then
    93	  echo "GATE-RED: observed cell set != FULL table — a partial run certifies nothing:" >&2
    94	  diff -u "$WORK/all-exp.txt" "$WORK/all-got.txt" | grep -E '^[+-]OWN' | head -10 >&2
    95	  exit 1
    96	fi
    97	
    98	# Statuses other than GREEN and RED are never expected and never comparable:
    99	# TIMEOUT / ESCAPE / AMBIG on an EXPECTED-red id would keep the id set intact
   100	# while hiding a more severe regression behind "same set" (codex rail r2 P1).
   101	grep -E '^OWN-[0-9]+[[:space:]]' "$MAP" \
   102	  | awk '$2 != "GREEN" && $2 != "RED" {print $1" "$2}' > "$WORK/other.txt"
   103	if [[ -s "$WORK/other.txt" ]]; then
   104	  echo "GATE-RED: cell(s) in a status that is never acceptable (TIMEOUT/ESCAPE/AMBIG):" >&2
   105	  sed 's/^/  /' "$WORK/other.txt" >&2
   106	  exit 1
   107	fi
   108	
   109	grep -E '^OWN-[0-9]+[[:space:]]' "$MAP" \
   110	  | awk '$2 == "RED" {print $1}' | LC_ALL=C sort > "$WORK/got.txt"
   111	grep -E '^OWN-' "$EXPECTED" | LC_ALL=C sort > "$WORK/exp.txt"
   112	
   113	if ! diff -u "$WORK/exp.txt" "$WORK/got.txt"; then
   114	  echo "GATE-RED: the RED set CHANGED (shrinkage included: all-green means the table changed — stop and find out why)" >&2
   115	  exit 1
   116	fi
   117	
   118	if [[ -s "$WORK/exp.txt" && "$rc" -ne 1 ]]; then
   119	  echo "GATE-RED: rc=$rc but the expected set is non-empty (harness must exit 1 over expected reds)" >&2
   120	  exit 1
   121	fi
   122	if [[ ! -s "$WORK/exp.txt" && "$rc" -ne 0 ]]; then
   123	  echo "GATE-RED: rc=$rc but the expected set is empty (harness must exit 0 when everything is green)" >&2
   124	  exit 1
   125	fi
   126	
   127	echo "ownership gate: RED set stable ($(wc -l < "$WORK/exp.txt" | tr -d ' ') expected RED cells, zero TIMEOUT/ESCAPE/AMBIG)"
   128	exit 0
