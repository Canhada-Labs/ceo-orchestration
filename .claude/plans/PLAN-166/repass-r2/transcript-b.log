   101	#
   102	# bash-3.2 safe (no associative arrays, no mapfile). Network-free. Writes only
   103	# under mktemp -d. Requires: git, python3, tar.
   104	
   105	set -uo pipefail   # NOT -e: failures are classified, not fatal-by-default.
