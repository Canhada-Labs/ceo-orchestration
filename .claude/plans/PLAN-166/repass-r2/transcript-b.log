   430	_derive_verdict() {  # $1 bd $2 ad $3 br $4 ar $5 out $6 surface $7 rel $8 operation
   431	  # $3 (before-record) went unused when OQ-9 collapsed OMIT_RECORD into
   432	  # PRESERVE_UNOWNED: what a record USED to be no longer changes the name.
   433	  local bd="$1" ad="$2" ar="$4" out="$5" surface="$6" rel="$7" op="${8:-upgrade}"
   434	  if [[ "$bd" != "$ad" ]]; then
   435	    if [[ "$bd" == "absent" ]]; then printf 'DELIVER'; else printf 'REFRESH'; fi
   436	    return 0
   437	  fi
   438	  # Unchanged target from here on.
   439	  if grep -Eq "$_ABORT_MARKERS" "$out" 2>/dev/null; then printf 'ABORT_SURFACE'; return 0; fi
   440	  # A REFRESH that writes byte-identical content leaves the CONTENT unchanged,
   441	  # so a content digest alone cannot separate it from a PRESERVE.
   442	  #
   443	  # Backup presence does not settle it either: the ADOPTER-FORK preserve path
   444	  # also snapshots into BAK_DIR, so "a backup exists" is evidence the framework
   445	  # looked, not that it wrote.
   446	  #
   447	  # Modification time settles it on the UPGRADE path, from state and without
   448	  # reading prose: the forced route replaces content with `cp -R` (no -p),
   449	  # which stamps new mtimes, while every preserve path leaves bytes AND
   450	  # timestamps alone.
   451	  #
   452	  # Restricted to upgrade deliberately. install.sh re-runs placeholder
   453	  # SUBSTITUTION on every invocation, so it rewrites the pointer with identical
   454	  # bytes and a fresh mtime — a write with no semantic content. Counting that
   455	  # as REFRESH would report an ownership change where none happened.
   456	  #
   457	  # No single signal is valid everywhere here: the content digest cannot see an
   458	  # identical-content refresh, the backup fires on the preserve-with-snapshot
   459	  # path, and mtime fires on install re-substitution. Each is used only where
   460	  # it is sound, and the boundary is stated rather than assumed.
   461	  if [[ "$op" == "upgrade" && "$_MTIME_BEFORE" != "$_MTIME_AFTER" ]]; then
   462	    printf 'REFRESH'; return 0
   463	  fi
   464	  # OQ-9 colapsada: sem registro ao final é PRESERVE_UNOWNED, tenha ou não
   465	  # existido um antes. O 'tinha antes?' é prior_record, que já é uma coluna.
   466	  if [[ -n "$ar" ]]; then printf 'PRESERVE_OWNED'; else printf 'PRESERVE_UNOWNED'; fi
   467	}
