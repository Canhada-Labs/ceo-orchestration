   535	_rollup_from_tree() {  # $1 = tree abs path, $2 = relpath prefix
   610	    backup_unwritable)
   611	      # Make the SURFACE unbackupable, not the upgrade unstartable. upgrade.sh
   612	      # creates $BAK_DIR at startup, so locking .claude.bak killed the run
   613	      # before any surface was reached — the branch under test never ran.
   614	      # An unreadable SOURCE makes the copy fail while everything else proceeds.
   615	      bak_guard="$T/$rel"
   616	      chmod 000 "$bak_guard" 2>/dev/null || true ;;
   617	  esac
   618	
   619	  # --- BEFORE snapshot -----------------------------------------------------
   620	  local b_digest b_rec
   621	  b_digest="$( _obs_digest "$T/$rel" )"
   622	  b_rec="$( _obs_record "$T/$MANIFEST_REL" "$rel" )"
   623	  _MTIME_BEFORE="$( _obs_mtime "$T/$rel" )"
   624	  if [[ ! "$_MTIME_BEFORE" =~ ^[0-9]+$ ]]; then
   625	    echo "HARNESS-ERR $id: unparseable mtime signature (before) for $rel: '$_MTIME_BEFORE'" >&2
