   190	# The manifest's record for a relpath: "" | "hash:<64hex>" | "link:<target>"
   191	# For SPEC/v1 the record may be per-file rows; presence of ANY row counts, and
   192	# the digest reported is the tree-shaped roll-up of those rows.
   193	_obs_record() {  # $1 = manifest abs path, $2 = relpath
   194	  local m="$1" rel="$2" line rows
   195	  [[ -f "$m" ]] || { printf ''; return 0; }
   196	  line="$( grep -E "^LINK  ${rel//./\\.}  " "$m" 2>/dev/null | head -1 || true )"
   197	  if [[ -n "$line" ]]; then printf 'link:%s' "${line#LINK  $rel  }"; return 0; fi
   198	  line="$( grep -E "^[0-9a-f]{64}  ${rel//./\\.}$" "$m" 2>/dev/null | head -1 || true )"
