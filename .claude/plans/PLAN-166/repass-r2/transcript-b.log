   300	_self_sha_compute() {
   301	  # SHA256 of everything in the script EXCEPT the last line.
   302	  # Portable across macOS (shasum) and Linux (sha256sum). Reads file
   303	  # twice via awk so it works without GNU-only `head -n -1`.
   304	  local script_path="$1"
   305	  local hasher=""
   306	  if command -v shasum >/dev/null 2>&1; then
   307	    hasher="shasum -a 256"
   308	  elif command -v sha256sum >/dev/null 2>&1; then
   309	    hasher="sha256sum"
   310	  else
   311	    return 1
   312	  fi
   313	  awk 'NR==FNR{n++; next} FNR < n' "$script_path" "$script_path" \
   314	    | eval "$hasher" | awk '{print $1}'
   315	}
