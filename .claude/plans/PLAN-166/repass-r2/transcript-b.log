   697	    status="AMBIG"; AMBIG=$((AMBIG+1))
   698	  elif [[ "$got_verdict" == "TIMEOUT" ]]; then
   699	    status="TIMEOUT"; FAIL=$((FAIL+1))
   700	  else
   701	    FAIL=$((FAIL+1))
   702	  fi
   703	
   704	  MAP_LINES+="$( printf '%-10s %-7s exp=%-16s/%-22s got=%-16s/%-22s rc=%-3s %s\n' \
   705	      "$id" "$status" "$exp_verdict" "$exp_hash" "$got_verdict" "$got_hash" "$rc" "$origin" )"$'\n'
