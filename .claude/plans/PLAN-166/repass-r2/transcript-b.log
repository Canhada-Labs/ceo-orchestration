   656	    [[ "$transition_to_user" -eq 1 ]] && iargs=( "$T" --ceremony user )
   657	    _run_with_timeout "$CELL_TIMEOUT" "$src/scripts/install.sh" "${iargs[@]}" >> "$out" 2>&1
   658	    rc=$?
   659	  fi
   660	  [[ -n "$bak_guard" ]] && chmod -R u+rwX "$bak_guard" 2>/dev/null
   661	
   662	  local timed_out=0
   663	  [[ $rc -eq 124 || $rc -eq 137 ]] && timed_out=1
   664	
   665	  # --- AFTER snapshot + derivation ----------------------------------------
   666	  local a_digest a_rec got_verdict got_hash
   667	  a_digest="$( _obs_digest "$T/$rel" )"
   668	  a_rec="$( _obs_record "$T/$MANIFEST_REL" "$rel" )"
   669	  _MTIME_AFTER="$( _obs_mtime "$T/$rel" )"
   670	  if [[ ! "$_MTIME_AFTER" =~ ^[0-9]+$ ]]; then
   671	    echo "HARNESS-ERR $id: unparseable mtime signature (after) for $rel: '$_MTIME_AFTER'" >&2
   672	    ERR=$((ERR+1)); return
   673	  fi
   674	  _ESCAPE_AFTER="$( _obs_digest "$WORK/foreign/leaf" 2>/dev/null || printf 'absent' )"
   675	
   676	  if [[ "$timed_out" -eq 1 ]]; then
   677	    got_verdict="TIMEOUT"; got_hash="TIMEOUT"
   678	  else
   679	    got_verdict="$( _derive_verdict "$b_digest" "$a_digest" "$b_rec" "$a_rec" "$out" "$surface" "$rel" "$operation" )"
   680	    got_hash="$( _derive_hash_source "$surface" "$a_rec" "$b_rec" "$src" "$exp_hash" )"
   681	  fi
   682	
   683	  # --- compare -------------------------------------------------------------
   684	  local status="RED"
   685	  local alt=""
   686	  case "$note" in *indistinguishable=*) alt="${note##*indistinguishable=}"; alt="${alt%% *}" ;; esac
   687	
   688	  # An escape outranks the verdict comparison. A row whose pair matches while
   689	  # the run wrote OUTSIDE the target has not passed: it has demonstrated the
   690	  # exact damage class this table exists to prevent, and calling that GREEN
   691	  # would be the instrument concealing a data loss.
