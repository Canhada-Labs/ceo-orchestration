   618	
   619	  # --- BEFORE snapshot -----------------------------------------------------
   620	  local b_digest b_rec
   621	  b_digest="$( _obs_digest "$T/$rel" )"
   622	  b_rec="$( _obs_record "$T/$MANIFEST_REL" "$rel" )"
   623	  _MTIME_BEFORE="$( _obs_mtime "$T/$rel" )"
   624	  if [[ ! "$_MTIME_BEFORE" =~ ^[0-9]+$ ]]; then
