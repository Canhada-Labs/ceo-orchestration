   633	  local rc=0
   634	  # A `ceremony=user` UPGRADE row asserts residue of a maintainer install that
   635	  # was later re-run as `--ceremony user`. The ceremony is read from
   636	  # .claude/.install-state.json, so labelling the row is not enough: the
   637	  # transition has to actually happen, or upgrade.sh still sees `maintainer`
   638	  # and the row silently tests the wrong branch.
   639	  if [[ "$transition_to_user" -eq 1 && "$operation" == "upgrade" ]]; then
   640	    _run_with_timeout "$CELL_TIMEOUT" "$src/scripts/install.sh" "$T" --ceremony user \
   641	      >> "$out" 2>&1 || true
   642	  fi
   643	  if [[ "$operation" == "upgrade" ]]; then
   644	    local uargs=( "$T" )
   645	    [[ "$skip_requested" == "self" ]] && uargs+=( --skip "$rel" )
   646	    if [[ "$skip_requested" == "descendant" ]]; then
   647	      local victim; victim="$( ( cd "$T/$rel" 2>/dev/null && find . ! -type d -print 2>/dev/null | LC_ALL=C sort | head -1 ) )"
