   276	# install that wrote the manifest. Reusing one source makes `HASH_SOURCE` and
   277	# `HASH_PRIOR_RECORD` byte-equal, and a classifier can then only tell them
   278	# apart by preferring one — which is resolving an ambiguity by preference, the
   279	# exact thing docs §5.6 forbids. Perturbing the source is how the fixture is
   280	# DIFFERENTIATED until the two candidates separate.
   281	_next_source() {
   282	  local nxt="$WORK/src-next"
   283	  [[ -d "$nxt" ]] && { printf '%s' "$nxt"; return 0; }
