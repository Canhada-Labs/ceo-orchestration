   101	    return $?
   102	  fi
   103	  # Fallback: background + watchdog. Kills the process group so a blocked cp
   104	  # inside the script dies with it.
   105	  "$@" &
   106	  local pid=$!
   107	  ( sleep "$secs"; kill -9 "$pid" 2>/dev/null ) &
   108	  local watch=$!
   109	  wait "$pid" 2>/dev/null
   110	  local rc=$?
