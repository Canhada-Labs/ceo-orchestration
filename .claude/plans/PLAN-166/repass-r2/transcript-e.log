     1	#!/usr/bin/env node
     2	// ceo-orchestration — pass-through shim around scripts/install.sh.
     3	//
     4	// Sprint 5 Phase 4. The bundle ships everything install.sh needs (the
     5	// full source tree at publish time). This binary locates the bundled
     6	// scripts/install.sh via __dirname, spawns bash with the user's
     7	// arguments, and proxies the exit code. Zero runtime dependencies —
     8	// the package.json `dependencies` map is intentionally empty and CI
     9	// asserts it.
    10	//
    11	// Usage:
    12	//   npx ceo-orchestration <target-repo-path> [--profile core,frontend] [--stack node]
    13	//   ceo-orchestration <target-repo-path> [--profile ...]
    14	//
    15	// Behavior contract (SPEC/v1/npm-shim.md):
    16	//   - Locates install.sh relative to __dirname (no PATH lookup, no env).
    17	//   - Forwards every argv[2..] argument unchanged to bash install.sh.
    18	//   - Inherits stdio (live progress visible to the caller).
    19	//   - Exits with the same code as install.sh.
    20	//   - On install.sh missing: exit 2 with a clear message (likely a
    21	//     packaging bug, not user error).
    22	
    23	'use strict';
    24	
    25	const path = require('path');
    26	const fs = require('fs');
    27	const { spawnSync } = require('child_process');
    28	
    29	const ROOT = path.resolve(__dirname, '..');
    30	const INSTALL = path.join(ROOT, 'scripts', 'install.sh');
    31	
    32	if (!fs.existsSync(INSTALL)) {
    33	  process.stderr.write(
    34	    `[ceo-orch/init] FATAL: bundled install.sh missing at ${INSTALL}\n` +
    35	    `This is a packaging bug. Please file an issue at\n` +
    36	    `  https://github.com/Canhada-Labs/ceo-orchestration/issues\n`
    37	  );
    38	  process.exit(2);
    39	}
    40	
    41	const args = process.argv.slice(2);
    42	
    43	const result = spawnSync('bash', [INSTALL, ...args], {
    44	  stdio: 'inherit',
    45	  cwd: process.cwd(),
    46	});
    47	
    48	if (result.error) {
    49	  process.stderr.write(
    50	    `[ceo-orch/init] FATAL: failed to spawn bash: ${result.error.message}\n`
    51	  );
    52	  process.exit(2);
    53	}
    54	
    55	process.exit(result.status === null ? 1 : result.status);
