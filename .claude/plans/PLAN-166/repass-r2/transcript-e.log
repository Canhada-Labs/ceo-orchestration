   250	# Test count: collect-only over the DOCUMENTED scope — no path argument, so
   251	# pytest.ini `testpaths` decides, which is byte-for-byte what `make
   252	# test-collect` runs and what every watched doc tells the reader to run.
   253	# The previous derivation passed `.claude/` explicitly; that walks
   254	# `.claude/sidecars/**` too and reports COLLECTION ERRORS plus phantom
   255	# cases the reader can never reproduce — a different population from the
   256	# one the docs cite. The single dated measurement of BOTH populations
   257	# lives in the COLLECTION SCOPE header block above; do not paste a second
   258	# pair here (W0 re-pass round 2: an undated pair in this comment drifted
   259	# from the dated header pair — one file, one snapshot).
   260	#
   261	# Both the collected count AND the collection-error count are derived: the
   262	# error count is an INPUT of the approx rule (a band applied to a partially
   263	# collected population is meaningless), so it is printed and exported, and
   264	# errors > 0 is a VIOLATION whenever the band was actually enforced over
   265	# >=1 doc site this run — it stays a named WARNING only when the band is
   266	# already suspended (--no-tests / observed 0). That is APPROX CONTRACT
   267	# clause 3 in the header, verbatim; the enforcement is the collect-errors
   268	# branch in the python block below. (W0 re-pass round 2: this comment used
   269	# to say "WARNING when non-zero" — the superseded pre-round-1 contract —
   270	# while header and code both said VIOLATION.)
   271	DERIVED_TESTS=0
   272	DERIVED_TESTS_ERRORS=0
   273	DERIVED_TESTS_CMD='python3 -m pytest --collect-only -q   # pytest.ini testpaths == `make test-collect`'
   274	if [ "$NO_TESTS" -eq 0 ]; then
   275	  _collect_out=$( { cd "$REPO_ROOT" && python3 -m pytest --collect-only -q 2>&1 | tail -5; } || true )
   276	  DERIVED_TESTS=$(
   277	    printf '%s\n' "$_collect_out" | \
   278	    awk '/[0-9]+ tests? collected/ {
   279	      for (i = 1; i <= NF; i++) {
   280	        gsub(/\x1b\[[0-9;]*m/, "", $i)
   281	        if ($i ~ /^[0-9]+$/) { print $i; exit }
   282	      }
   283	    }' || true
   284	  )
   285	  DERIVED_TESTS=${DERIVED_TESTS:-0}
   286	  # "N errors" appears in the same -q summary line ("14219 tests collected,
   287	  # 22 errors in 3.98s"). No match => 0 (a clean collect prints no "errors").
   288	  DERIVED_TESTS_ERRORS=$(
   289	    printf '%s\n' "$_collect_out" | \
   290	    sed -e 's/\x1b\[[0-9;]*m//g' | \
   291	    awk 'match($0, /[0-9]+ error/) {
   292	      s = substr($0, RSTART, RLENGTH); sub(/ error/, "", s); print s; exit
   293	    }' || true
   294	  )
   295	  DERIVED_TESTS_ERRORS=${DERIVED_TESTS_ERRORS:-0}
   296	fi
