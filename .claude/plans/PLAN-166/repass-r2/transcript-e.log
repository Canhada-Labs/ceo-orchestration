   610	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to tag"
   611	
   612	  # VERSION carries the BARE semver even for an RC tag (see the bump header),
   613	  # so compare against $TARGET_BASE, never $TARGET_VERSION.
   614	  cur_version="$(tr -d ' \n' < VERSION)"
   615	  [ "$cur_version" = "$TARGET_BASE" ] \
   616	    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
   617	  ok "VERSION ($cur_version) matches the base version of the tag"
   618	
   619	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   620	    && die "tag $TARGET_TAG already exists"
   621	
   622	  hdr "tag guards (unconditional — RC and stable)"
