    14	# debate r1 QA must-fix 2: describing behavior is not a gate).
    15	#
    16	# rc semantics, explicit by design (codex rail r1 P1):
    17	#   - harness rc >= 2  => harness/infra error, NEVER comparable => gate FAILS
    18	#   - summary line must exist and report HARNESS-ERR=0 (partial output fails)
    19	#   - non-empty expected set REQUIRES harness rc == 1 (its designed status)
    20	#   - empty     expected set REQUIRES harness rc == 0
    21	#   - observed RED set must equal the expected set exactly
    22	#   - any OTHER non-GREEN status (TIMEOUT / ESCAPE / AMBIG) fails OUTRIGHT
    23	#     (codex rail r2 P1): an expected-red id that starts timing out or
    24	#     escaping the target keeps the id set unchanged — comparing ids alone
    25	#     would wave a MORE SEVERE regression through as "same set".
    26	#
    27	# NEVER wire the harness's --map mode into this gate: --map exits 0 over
    28	# failures by design (reporting mode) — a dead gate by construction.
    29	#
    30	# Test seams (positive control only — CI uses the defaults):
    31	#   OWNERSHIP_GATE_HARNESS       command to run instead of the real harness
    32	#   OWNERSHIP_GATE_EXPECTED      expected-reds file to compare against
    33	#   OWNERSHIP_GATE_EXPECTED_ALL  full-id-set file (default: harness --list)
    34	#
    35	# Exit: 0 = set stable. 1 = gate failed (set changed / harness error / vacuous
    36	#       output). 2 = gate usage/infra error (missing expected file).
    37	# =============================================================================
    38	set -uo pipefail
    39	
    40	SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    41	REPO_ROOT="$( cd "$SCRIPT_DIR/../.." && pwd )"
    42	
    43	HARNESS="${OWNERSHIP_GATE_HARNESS:-}"
    44	if [[ -z "$HARNESS" ]]; then
    45	  HARNESS="bash '$SCRIPT_DIR/test-ownership-table.sh'"
    46	fi
    47	EXPECTED="${OWNERSHIP_GATE_EXPECTED:-$SCRIPT_DIR/ownership-expected-reds.txt}"
    48	
    49	[[ -f "$EXPECTED" ]] || { echo "GATE-ERR: expected-reds file not found: $EXPECTED" >&2; exit 2; }
    50	
    51	WORK="$( mktemp -d "${TMPDIR:-/tmp}/own-gate.XXXXXX" )" || exit 2
    52	trap 'rm -rf "$WORK" 2>/dev/null || true' EXIT
    53	
    54	MAP="$WORK/map.txt"
    55	ERRS="$WORK/err.txt"
    56	
    57	rc=0
    58	( cd "$REPO_ROOT" && eval "$HARNESS" ) > "$MAP" 2> "$ERRS" || rc=$?
    59	
    60	cat "$MAP"
    61	sed -n '1,40p' "$ERRS" >&2 || true
    62	
    63	if [[ "$rc" -ge 2 ]]; then
    64	  echo "GATE-RED: harness returned rc=$rc (harness/infra error — not comparable)" >&2
    65	  exit 1
    66	fi
    67	
    68	# The summary line is load-bearing: without it, a run that died mid-table
    69	# would present a truncated (smaller) non-GREEN set that could still match a
    70	# shrunken expectation. HARNESS-ERR must be literally 0.
    71	if ! grep -E '^GREEN=[0-9]+[[:space:]]+RED=[0-9]+[[:space:]]+AMBIG=[0-9]+[[:space:]]+HARNESS-ERR=0$' "$MAP" >/dev/null; then
    72	  echo "GATE-RED: summary line missing or HARNESS-ERR>0 — partial or vacuous output cannot pass" >&2
    73	  exit 1
    74	fi
    75	
    76	# The RED-set comparison alone cannot prove the FULL table ran: a run that
    77	# silently skipped every GREEN cell would still present the expected REDs and
    78	# an honest-looking summary (codex pack-review P1). Demand that the observed
    79	# id set equals the TABLE's id set — authority: the harness's own --list
    80	# (which reads the TSV), overridable only by the positive control's seam.
    81	if [[ -n "${OWNERSHIP_GATE_EXPECTED_ALL:-}" ]]; then
    82	  grep -E '^OWN-' "$OWNERSHIP_GATE_EXPECTED_ALL" | LC_ALL=C sort > "$WORK/all-exp.txt"
    83	else
    84	  ( cd "$REPO_ROOT" && bash scripts/tests/test-ownership-table.sh --list ) 2>/dev/null \
    85	    | awk '{print $1}' | grep -E '^OWN-' | LC_ALL=C sort > "$WORK/all-exp.txt"
    86	fi
    87	grep -E '^OWN-[0-9]+[[:space:]]' "$MAP" | awk '{print $1}' | LC_ALL=C sort > "$WORK/all-got.txt"
    88	if [[ ! -s "$WORK/all-exp.txt" ]]; then
    89	  echo "GATE-RED: could not derive the full table id set (--list empty) — cannot certify coverage" >&2
    90	  exit 1
    91	fi
    92	if ! diff -u "$WORK/all-exp.txt" "$WORK/all-got.txt" >/dev/null; then
    93	  echo "GATE-RED: observed cell set != FULL table — a partial run certifies nothing:" >&2
    94	  diff -u "$WORK/all-exp.txt" "$WORK/all-got.txt" | grep -E '^[+-]OWN' | head -10 >&2
    95	  exit 1
    96	fi
    97	
    98	# Statuses other than GREEN and RED are never expected and never comparable:
    99	# TIMEOUT / ESCAPE / AMBIG on an EXPECTED-red id would keep the id set intact
   100	# while hiding a more severe regression behind "same set" (codex rail r2 P1).
   101	grep -E '^OWN-[0-9]+[[:space:]]' "$MAP" \
   102	  | awk '$2 != "GREEN" && $2 != "RED" {print $1" "$2}' > "$WORK/other.txt"
   103	if [[ -s "$WORK/other.txt" ]]; then
   104	  echo "GATE-RED: cell(s) in a status that is never acceptable (TIMEOUT/ESCAPE/AMBIG):" >&2
   105	  sed 's/^/  /' "$WORK/other.txt" >&2
   106	  exit 1
   107	fi
   108	
   109	grep -E '^OWN-[0-9]+[[:space:]]' "$MAP" \
   110	  | awk '$2 == "RED" {print $1}' | LC_ALL=C sort > "$WORK/got.txt"
   111	grep -E '^OWN-' "$EXPECTED" | LC_ALL=C sort > "$WORK/exp.txt"
   112	
   113	if ! diff -u "$WORK/exp.txt" "$WORK/got.txt"; then
   114	  echo "GATE-RED: the RED set CHANGED (shrinkage included: all-green means the table changed — stop and find out why)" >&2
   115	  exit 1
   116	fi
   117	
   118	if [[ -s "$WORK/exp.txt" && "$rc" -ne 1 ]]; then
   119	  echo "GATE-RED: rc=$rc but the expected set is non-empty (harness must exit 1 over expected reds)" >&2
   120	  exit 1
   121	fi
   122	if [[ ! -s "$WORK/exp.txt" && "$rc" -ne 0 ]]; then
   123	  echo "GATE-RED: rc=$rc but the expected set is empty (harness must exit 0 when everything is green)" >&2
   124	  exit 1
   125	fi
   126	
   127	echo "ownership gate: RED set stable ($(wc -l < "$WORK/exp.txt" | tr -d ' ') expected RED cells, zero TIMEOUT/ESCAPE/AMBIG)"
   128	exit 0
     1	#!/usr/bin/env bash
     2	# =============================================================================
     3	# PLAN-168 W1 — positive control for ownership-nightly-gate.sh.
     4	#
     5	# The gate is the instrument that watches the ownership e2e in CI; this test
     6	# watches the GATE. Every failure mode the gate claims to catch is planted
     7	# here with a fake harness, and the test demands the gate actually goes red —
     8	# green-without-control proves nothing (PLAN-167: 8 instrument defects).
     9	#
    10	# Scenarios:
    11	#   S1  matching set, rc=1, HARNESS-ERR=0            => gate PASSES
    12	#   S2  set GREW (one extra red)                     => gate FAILS
    13	#   S3  set SHRANK (all green, rc=0)                 => gate FAILS
    14	#   S4  harness rc=2 (infra error)                   => gate FAILS
    15	#   S5  summary line missing (truncated output)      => gate FAILS
    16	#   S6  HARNESS-ERR=1 in summary                     => gate FAILS
    17	#   S7  rc=0 while expected set non-empty            => gate FAILS
    18	#   S8  set SWAPPED (same size, different ids)       => gate FAILS
    19	#   S9  empty expected set + all green, rc=0         => gate PASSES
    20	#   S10 expected id degraded to TIMEOUT (same ids)   => gate FAILS
    21	#   S11 expected id degraded to ESCAPE  (same ids)   => gate FAILS
    22	#   S12 green cell degraded to AMBIG                 => gate FAILS
    23	#   S13 PARTIAL run: only the RED rows present, honest summary, correct RED
    24	#       set — but the table has more cells            => gate FAILS
    25	#       (codex pack-review P1: RED-set comparison alone certifies nothing)
    26	#
    27	# Exit: 0 all scenarios behave. 1 at least one does not. 2 harness error.
    28	# =============================================================================
    29	set -uo pipefail
    30	
    31	SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    32	GATE="$SCRIPT_DIR/ownership-nightly-gate.sh"
    33	[[ -f "$GATE" ]] || { echo "ERROR: gate not found: $GATE" >&2; exit 2; }
    34	
    35	WORK="$( mktemp -d "${TMPDIR:-/tmp}/own-gate-test.XXXXXX" )" || exit 2
    36	trap 'rm -rf "$WORK" 2>/dev/null || true' EXIT
    37	
    38	# --- fake harness ------------------------------------------------------------
    39	# Emits a canned map on stdout and exits with a canned rc. The gate consumes
    40	# it via OWNERSHIP_GATE_HARNESS exactly as it would the real harness.
    41	mk_fake() { # $1=out-file $2=rc-file
    42	  cat > "$WORK/fake-harness.sh" <<EOF
    43	#!/usr/bin/env bash
    44	cat "$1"
    45	exit "\$(cat "$2")"
    46	EOF
    47	  chmod +x "$WORK/fake-harness.sh"
    48	}
    49	
    50	map_line() { # $1=id $2=status
    51	  printf '%-10s %-7s exp=%-16s/%-22s got=%-16s/%-22s rc=%-3s %s\n' \
    52	    "$1" "$2" "V" "H" "V" "H" "0" "test"
    53	}
    54	
    55	write_map() { # $1=file, then "id:status" pairs; appends summary from counts
    56	  # Also records every id into $WORK/all.txt — the full-coverage authority
    57	  # the gate compares against (scenarios that SIMULATE partial coverage
    58	  # overwrite all.txt afterwards with the larger "true" table).
    59	  local f="$1"; shift
    60	  local green=0 red=0 err="${SUMMARY_ERR:-0}"
    61	  : > "$f"; : > "$WORK/all.txt"
    62	  local pair id st
    63	  for pair in "$@"; do
    64	    id="${pair%%:*}"; st="${pair##*:}"
    65	    map_line "$id" "$st" >> "$f"
    66	    printf '%s\n' "$id" >> "$WORK/all.txt"
    67	    case "$st" in GREEN) green=$((green+1)) ;; *) red=$((red+1)) ;; esac
    68	  done
    69	  if [[ "${SUMMARY_OMIT:-0}" -ne 1 ]]; then
    70	    printf '\nGREEN=%d  RED=%d  AMBIG=0  HARNESS-ERR=%d\n' "$green" "$red" "$err" >> "$f"
    71	  fi
    72	}
    73	
    74	expected_4() {
    75	  printf 'OWN-0016\nOWN-0024\nOWN-0027\nOWN-0074\n' > "$WORK/exp.txt"
    76	}
    77	
    78	run_gate() { # $1=expected-rc  $2=label
    79	  local want="$1" label="$2" got=0
    80	  OWNERSHIP_GATE_HARNESS="$WORK/fake-harness.sh" \
    81	  OWNERSHIP_GATE_EXPECTED="$WORK/exp.txt" \
    82	  OWNERSHIP_GATE_EXPECTED_ALL="$WORK/all.txt" \
    83	    bash "$GATE" > "$WORK/gate-out.txt" 2> "$WORK/gate-err.txt" || got=$?
    84	  if [[ "$got" -eq "$want" ]]; then
    85	    echo "PASS  $label (gate rc=$got)"
    86	    return 0
    87	  fi
    88	  echo "FAIL  $label — gate rc=$got, expected $want"
    89	  sed -n '1,15p' "$WORK/gate-out.txt" | sed 's/^/      out| /'
    90	  sed -n '1,15p' "$WORK/gate-err.txt" | sed 's/^/      err| /'
    91	  return 1
    92	}
    93	
    94	FAILURES=0
    95	
    96	# S1 — matching set, honest rc=1 => PASS
    97	expected_4
    98	write_map "$WORK/map.txt" OWN-0001:GREEN OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0074:RED
    99	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   100	run_gate 0 "S1 matching set + rc=1" || FAILURES=$((FAILURES+1))
   101	
   102	# S2 — set grew => FAIL
   103	write_map "$WORK/map.txt" OWN-0001:RED OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0074:RED
   104	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   105	run_gate 1 "S2 set grew" || FAILURES=$((FAILURES+1))
   106	
   107	# S3 — set shrank to zero (all green, honest rc=0) => FAIL (all-green = STOP)
   108	write_map "$WORK/map.txt" OWN-0001:GREEN OWN-0016:GREEN OWN-0024:GREEN OWN-0027:GREEN OWN-0074:GREEN
   109	echo 0 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   110	run_gate 1 "S3 set shrank (all green)" || FAILURES=$((FAILURES+1))
   111	
   112	# S4 — harness infra error rc=2 => FAIL
   113	write_map "$WORK/map.txt" OWN-0016:RED
   114	echo 2 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   115	run_gate 1 "S4 harness rc=2" || FAILURES=$((FAILURES+1))
   116	
   117	# S5 — summary line missing (truncated run) => FAIL even with matching ids
   118	# (explicit set/reset: VAR=x prefixed to a FUNCTION call has version-divergent
   119	# persistence semantics in bash — never rely on it.)
   120	SUMMARY_OMIT=1
   121	write_map "$WORK/map.txt" OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0074:RED
   122	SUMMARY_OMIT=0
   123	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   124	run_gate 1 "S5 summary missing" || FAILURES=$((FAILURES+1))
   125	
   126	# S6 — HARNESS-ERR=1 => FAIL even with matching ids
   127	SUMMARY_ERR=1
   128	write_map "$WORK/map.txt" OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0074:RED
   129	SUMMARY_ERR=0
   130	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   131	run_gate 1 "S6 HARNESS-ERR=1" || FAILURES=$((FAILURES+1))
   132	
   133	# S7 — rc=0 while expected set non-empty (rc/set incoherence) => FAIL
   134	write_map "$WORK/map.txt" OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0074:RED
   135	echo 0 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   136	run_gate 1 "S7 rc=0 with non-empty expected set" || FAILURES=$((FAILURES+1))
   137	
   138	# S8 — same size, different ids => FAIL
   139	write_map "$WORK/map.txt" OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0099:RED OWN-0074:GREEN
   140	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   141	run_gate 1 "S8 set swapped" || FAILURES=$((FAILURES+1))
   142	
   143	# S9 — empty expected set + all green + rc=0 => PASS
   144	: > "$WORK/exp.txt"
   145	write_map "$WORK/map.txt" OWN-0001:GREEN OWN-0002:GREEN
   146	echo 0 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   147	run_gate 0 "S9 empty expected set, all green" || FAILURES=$((FAILURES+1))
   148	
   149	# S10-S12 — an EXPECTED-red id degrades to TIMEOUT / ESCAPE / AMBIG: the id
   150	# set is UNCHANGED, so an ids-only comparison would pass a more severe
   151	# regression as "same set" (codex rail r2 P1). The gate must go red on the
   152	# STATUS, not just the set.
   153	expected_4
   154	write_map "$WORK/map.txt" OWN-0016:TIMEOUT OWN-0024:RED OWN-0027:RED OWN-0074:RED
   155	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   156	run_gate 1 "S10 expected id degraded to TIMEOUT" || FAILURES=$((FAILURES+1))
   157	
   158	write_map "$WORK/map.txt" OWN-0016:ESCAPE OWN-0024:RED OWN-0027:RED OWN-0074:RED
   159	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   160	run_gate 1 "S11 expected id degraded to ESCAPE" || FAILURES=$((FAILURES+1))
   161	
   162	write_map "$WORK/map.txt" OWN-0001:AMBIG OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0074:RED
   163	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   164	run_gate 1 "S12 green cell degraded to AMBIG" || FAILURES=$((FAILURES+1))
   165	
   166	# S13 — PARTIAL run: the map carries ONLY the expected RED rows with an
   167	# honest summary and rc=1; the TABLE (all.txt) says there are more cells.
   168	# The gate must refuse: a partial run certifies nothing about the greens.
   169	expected_4
   170	write_map "$WORK/map.txt" OWN-0016:RED OWN-0024:RED OWN-0027:RED OWN-0074:RED
   171	printf 'OWN-0001\nOWN-0002\nOWN-0016\nOWN-0024\nOWN-0027\nOWN-0074\n' > "$WORK/all.txt"
   172	echo 1 > "$WORK/rc.txt"; mk_fake "$WORK/map.txt" "$WORK/rc.txt"
   173	run_gate 1 "S13 partial run (REDs only) refused" || FAILURES=$((FAILURES+1))
   174	
   175	echo ""
   176	if [[ "$FAILURES" -gt 0 ]]; then
   177	  echo "ownership-nightly-gate positive control: $FAILURES scenario(s) FAILED"
   178	  exit 1
   179	fi
   180	echo "ownership-nightly-gate positive control: 13/13 scenarios behave"
   181	exit 0
     1	# PLAN-168 AC-5 — the EXPECTED set of non-GREEN cells in the ownership e2e.
     2	# The nightly gate compares the observed RED set against the OWN- lines below
     3	# and fails on ANY difference — including shrinkage: an all-green run means
     4	# the truth table changed, which is a reason to STOP, not to celebrate
     5	# (CLAUDE.md §4). Any TIMEOUT/ESCAPE/AMBIG status fails outright.
     6	# Causes are recorded in docs/ownership-decision-table.md and ADR-190.
     7	#   OWN-0016 — product defect (open)
     8	#   OWN-0024 — test defect (open)
     9	#   OWN-0027 — test defect (open)
    10	# OWN-0074 was closed by PLAN-168 W2 (INV-4 cure): the shared generator makes
    11	# install and upgrade produce identical pointers, so the recorded digest
    12	# finally matches the disk. It is history, not an expectation.
    13	OWN-0016
    14	OWN-0024
    15	OWN-0027
