  1097	class Plan168OwnershipWiringTest(TestEnvContext):
  1098	    """AC-1/AC-2: the ownership oracles are WIRED, and the two smoke-install
  1099	    filter lists cannot drift apart again (the r10-F4 "red gate nobody
  1100	    runs" class, closed as an assertion instead of a memory)."""
  1101	
  1102	    def _smoke(self) -> Tuple[str, str]:
  1103	        ctx = _plan168_text("smoke-install.yml")
  1104	        if ctx is None:
  1105	            self.skipTest(
  1106	                "PLAN-168 W1 not landed and no staged copy on disk "
  1107	                "(pre-landing CI window)"
  1108	            )
  1109	        return ctx
  1110	
  1111	    def test_filter_lists_are_identical(self):
  1112	        text, _ = self._smoke()
  1113	        pr, push = _workflow_paths_lists(text)
  1114	        self.assertTrue(pr, "pull_request paths filter not found/empty")
  1115	        self.assertTrue(push, "push paths filter not found/empty")
  1116	        # Name-by-name set equality, both directions, duplicates rejected —
  1117	        # the file's own comment says KEEP IDENTICAL.
  1118	        self.assertEqual(
  1119	            len(pr), len(set(pr)), "duplicate entries in pull_request paths")
  1120	        self.assertEqual(
  1121	            len(push), len(set(push)), "duplicate entries in push paths")
  1122	        self.assertEqual(
  1123	            sorted(pr), sorted(push),
  1124	            "smoke-install pull_request and push paths filters have drifted",
  1125	        )
  1126	
  1127	    def test_ownership_paths_present_in_both_filters(self):
  1128	        text, _ = self._smoke()
  1129	        pr, push = _workflow_paths_lists(text)
  1130	        for required in sorted(_OWNERSHIP_FILTER_PATHS):
  1131	            self.assertIn(
  1132	                required, pr, f"{required} missing from pull_request paths")
  1133	            self.assertIn(
  1134	                required, push, f"{required} missing from push paths")
  1135	
  1136	    def test_unit_oracle_step_wired(self):
  1137	        text, _ = self._smoke()
  1138	        steps = text.split("steps:", 1)[-1]
  1139	        self.assertIn(
  1140	            "scripts/tests/test-ownership-verdict-unit.sh", steps,
  1141	            "unit oracle step missing from the smoke job",
  1142	        )
  1143	        self.assertIn(
  1144	            "scripts/tests/test-ownership-nightly-gate.sh", steps,
  1145	            "nightly-gate positive control step missing from the smoke job",
  1146	        )
  1147	        self.assertIn(
  1148	            "scripts/tests/test-protocol-pointer-render.sh", steps,
  1149	            "pointer render control step missing from the smoke job",
  1150	        )
  1151	
  1152	    def test_nightly_workflow_contract(self):
