  1015	# --- PLAN-168 W1 (AC-1/AC-2/AC-4) ------------------------------------
  1016	# Marker written into the PLAN-168 smoke-install.yml + ownership-nightly.yml
  1017	# edits; its presence in the LIVE file means the W1 ceremony landed and the
  1018	# live copy is authoritative (same convention as _MARKER / _MARKER_166).
  1019	_MARKER_168 = "PLAN-168 W1"
  1020	_STAGED_168 = _REPO / ".claude" / "plans" / "PLAN-168" / "staged"
  1021	_STAGED_168_WF = _STAGED_168 / ".github" / "workflows"
  1022	
  1023	# AC-1/AC-2: paths that MUST be present in BOTH smoke-install filter lists.
  1024	# _hash_lib.sh is the r10-F4 regression pin (it was already wired; this
  1025	# assert keeps it that way — AC-2 is an assertion, not work).
  1026	_OWNERSHIP_FILTER_PATHS = frozenset({
  1027	    "scripts/_hash_lib.sh",
  1028	    "scripts/_framework_manifest_set.sh",
  1029	    "scripts/tests/test-ownership-verdict-unit.sh",
  1030	    "scripts/tests/test-ownership-table.sh",
  1031	    "scripts/tests/ownership_table.tsv",
  1032	    "docs/ownership-decision-table.md",
  1033	    # rail r3 P1: the nightly gate + controls must be per-PR gated too.
  1034	    "scripts/tests/ownership-nightly-gate.sh",
  1035	    "scripts/tests/test-ownership-nightly-gate.sh",
  1036	    "scripts/tests/ownership-expected-reds.txt",
  1037	    "scripts/tests/test-protocol-pointer-render.sh",
  1038	    "scripts/tests/test-protocol-pointer-inv4.sh",
  1039	})
  1040	
  1041	
  1042	def _plan168_text(name: str) -> Optional[Tuple[str, str]]:
  1043	    """Return (text, context) for a PLAN-168 workflow edit, or None pre-landing."""
  1044	    live = _WF / name
  1045	    if live.is_file():
  1046	        live_text = live.read_text(encoding="utf-8")
  1047	        if _MARKER_168 in live_text:
  1048	            return live_text, "live"
  1049	    staged = _STAGED_168_WF / name
  1050	    if staged.is_file():
  1051	        return staged.read_text(encoding="utf-8"), "staged"
  1052	    return None
  1053	
  1054	
  1055	def _workflow_paths_lists(text: str) -> Tuple[list, list]:
  1056	    """Extract (pull_request.paths, push.paths) entries from workflow text.
  1057	
  1058	    Text-based on purpose (this file's convention — no yaml dependency in
  1059	    the stdlib-only posture). Collects quoted `- "..."` items under each
  1060	    `paths:` key, skipping comments, stopping at the first line that
  1061	    dedents to the `paths:` level or shallower.
  1062	    """
  1063	    results = []
  1064	    for trigger in ("pull_request:", "push:"):
  1065	        lines = text.splitlines()
  1066	        try:
  1067	            t_idx = next(
  1068	                i for i, ln in enumerate(lines)
  1069	                if ln.strip() == trigger
  1070	                and (len(ln) - len(ln.lstrip())) == 2
  1071	            )
  1072	        except StopIteration:
  1073	            results.append([])
  1074	            continue
  1075	        entries = []
  1076	        paths_indent = None
  1077	        for ln in lines[t_idx + 1:]:
  1078	            stripped = ln.strip()
  1079	            indent = len(ln) - len(ln.lstrip())
  1080	            if stripped and indent <= 2:
  1081	                break  # next trigger / top-level key
  1082	            if paths_indent is None:
  1083	                if stripped == "paths:":
  1084	                    paths_indent = indent
  1085	                continue
  1086	            if not stripped or stripped.startswith("#"):
  1087	                continue
  1088	            if indent <= paths_indent:
  1089	                break
  1090	            m = re.match(r'-\s+"([^"]+)"', stripped)
  1091	            if m:
  1092	                entries.append(m.group(1))
  1093	        results.append(entries)
  1094	    return results[0], results[1]
  1095	
