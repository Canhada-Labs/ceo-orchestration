   134	class _PreStampEvent:
   135	    """Minimal NormalizedEvent-shaped carrier for tool_lifecycle.record_pre.
   136	
   137	    Only the 3 fields record_pre reads (session_id / tool_use_id / tool_name).
   138	    """
   139	
   140	    __slots__ = ("session_id", "tool_use_id", "tool_name")
   141	
   142	    def __init__(self, *, session_id: str, tool_use_id: str, tool_name: str) -> None:
   143	        self.session_id = session_id
   144	        self.tool_use_id = tool_use_id
   145	        self.tool_name = tool_name
   146	
   147	
   148	def _record_pre_lifecycle(payload: Dict[str, Any], session_id: str) -> None:
   149	    """Fail-open PreToolUse lifecycle stamp (PLAN-125 WS-1 / MF-SEC-5).
   150	
   151	    NEVER raises, NEVER emits an audit-chain event. A missing tool_use_id is a
   152	    no-op (record_pre returns early). Kill-switch: CEO_TOOL_LIFECYCLE=0.
   153	    """
   154	    if not _TOOL_LIFECYCLE_AVAILABLE or _tool_lifecycle is None:
   155	        return
   156	    if os.environ.get("CEO_TOOL_LIFECYCLE", "").strip().lower() in {
   157	        "0", "false", "off", "no"
   158	    }:
   159	        return
   160	    try:
   161	        ev = _PreStampEvent(
   162	            session_id=session_id,
   163	            tool_use_id=str(payload.get("tool_use_id") or ""),
   164	            tool_name=str(payload.get("tool_name") or ""),
   165	        )
   166	        _tool_lifecycle.record_pre(ev)
   167	    except Exception:
   168	        return
