  1159	        text, _ = ctx
  1160	        self.assertIn("schedule:", text, "nightly trigger missing")
  1161	        self.assertIn("cron:", text, "cron expression missing")
  1162	        self.assertIn("workflow_dispatch:", text, "manual dispatch missing")
  1163	        self.assertIn(
