   269	# ----------------------------------------------------------------------
   270	# P0-15 (PLAN-045 Session 41 / PLAN-044 F-15R2-01, 2026-04-20;
   271	#        narrative clarified PLAN-063 DIM-01 P1, 2026-04-30):
   272	# supply-chain self-verification.
   273	#
   274	# The LAST line of this script is a `# CEO-INSTALL-SHA256: <hex>` trailer
   275	# populated at release-tag cut by .github/workflows/release.yml. At
   276	# install time the script sha256-hashes its own body (everything except
   277	# the trailer line) and compares. Fail-CLOSED (rc=5) on mismatch,
   278	# missing trailer, or malformed trailer.
   279	#
   280	# Source-tag = GPG-only; the placeholder is INTENTIONAL for source
   281	# installs. Specifically:
   282	#   - The NPM-shim path (npm/install.sh, see scripts/install-npm.sh)
   283	#     anchors version verification on package.json, not on this trailer.
   284	#     Source-tree clones therefore never see a populated trailer and
   285	#     that is by design.
   286	#   - The PLACEHOLDER_RELEASE_FILL trailer applies ONLY to release-tag
   287	#     cuts where .github/workflows/release.yml rewrites the last line
   288	#     with the canonical hex.
   289	#   - Tampering-detection still works for release-tag installs: any
   290	#     post-cut byte change to install.sh trips the SHA mismatch.
   291	#
   292	# Bypass: CEO_INSTALL_SKIP_SELF_SHA=1 (for local dev / tests). Emits a
   293	#         stderr warning so adopters are aware.
   294	# Placeholder: the literal value `PLACEHOLDER_RELEASE_FILL` indicates
   295	#         a source checkout not processed by release.yml; skipped with
   296	#         a stderr warning. Set by the release workflow to the real hex
   297	#         at tag cut. This is the intended behavior for source-tree
   298	#         clones — see notes above.
   299	# ----------------------------------------------------------------------
   300	_self_sha_compute() {
   301	  # SHA256 of everything in the script EXCEPT the last line.
   302	  # Portable across macOS (shasum) and Linux (sha256sum). Reads file
   303	  # twice via awk so it works without GNU-only `head -n -1`.
   304	  local script_path="$1"
   305	  local hasher=""
   306	  if command -v shasum >/dev/null 2>&1; then
   307	    hasher="shasum -a 256"
   308	  elif command -v sha256sum >/dev/null 2>&1; then
   309	    hasher="sha256sum"
   310	  else
   311	    return 1
   312	  fi
   313	  awk 'NR==FNR{n++; next} FNR < n' "$script_path" "$script_path" \
   314	    | eval "$hasher" | awk '{print $1}'
   315	}
   316	
   317	_verify_self_sha() {
   318	  local script_path="$1"
   319	  if [ "${CEO_INSTALL_SKIP_SELF_SHA:-0}" = "1" ]; then
   320	    echo "WARN: install.sh self-SHA verification skipped (CEO_INSTALL_SKIP_SELF_SHA=1)" >&2
   321	    return 0
   322	  fi
   323	  local trailer
   324	  trailer="$(tail -n 1 "$script_path" 2>/dev/null || true)"
   325	  case "$trailer" in
   326	    "# CEO-INSTALL-SHA256: "*)
   327	      local expected="${trailer##"# CEO-INSTALL-SHA256: "}"
   328	      if [ "$expected" = "PLACEHOLDER_RELEASE_FILL" ]; then
   329	        echo "WARN: install.sh self-SHA trailer is the unpopulated placeholder." >&2
   330	        echo "      (Source checkout, not a release tarball. Proceeding.)" >&2
   331	        return 0
   332	      fi
   333	      local actual
   334	      if ! actual="$(_self_sha_compute "$script_path")"; then
   335	        echo "ERROR: install.sh self-SHA cannot compute — shasum/sha256sum missing." >&2
   336	        exit 5
   337	      fi
   338	      if [ "$actual" != "$expected" ]; then
   339	        echo "ERROR: install.sh self-SHA MISMATCH (supply-chain tampering suspected)." >&2
   340	        echo "       expected: $expected" >&2
   341	        echo "       actual:   $actual" >&2
   342	        echo "       The install.sh file has been modified since release cut." >&2
   343	        echo "       If this is intentional (local dev), set" >&2
   344	        echo "       CEO_INSTALL_SKIP_SELF_SHA=1 to bypass." >&2
   345	        exit 5
   346	      fi
   347	      ;;
   348	    *)
   349	      echo "ERROR: install.sh missing/malformed CEO-INSTALL-SHA256 trailer." >&2
   350	      echo "       Expected last line: '# CEO-INSTALL-SHA256: <hex>'" >&2
   351	      echo "       Got:                '$trailer'" >&2
   352	      exit 5
   353	      ;;
   354	  esac
   355	}
   356	
   357	_verify_self_sha "$SCRIPT_SRC"
