    60	    decide,
    61	)
    62	
    63	SCRIPT = Path(__file__).resolve().parent.parent / "await_release_gate.py"
    64	
    65	TAG = "v1.3.0"
    66	HEAD_SHA = "a" * 40
    67	OTHER_SHA = "b" * 40
    68	
    69	# Independent clock: built with calendar.timegm, NOT with the module's own
    70	# parser, so the fixtures are not graded by the code under test.
    71	SELF_CREATED_AT = "2026-08-05T12:00:00Z"
    72	SELF_EPOCH = calendar.timegm((2026, 8, 5, 12, 0, 0, 0, 1, -1))
    73	CANDIDATE_CREATED_AT = "2026-08-05T12:00:05Z"       # same push, +5s jitter
    74	STALE_CREATED_AT = "2026-08-05T11:00:00Z"           # previous tag push, -1h
    75	NOW = SELF_EPOCH + 60
    76	DEADLINE_OPEN = SELF_EPOCH + 1800                   # 30 min of head-room
    77	NOW_PAST_DEADLINE = DEADLINE_OPEN + 1
    78	
    79	
    80	def ctx(now=NOW, deadline=DEADLINE_OPEN):
    81	    """Context with EVERY input pinned explicitly (no ambient clock)."""
    82	    return GateContext(
    83	        tag=TAG,
    84	        head_sha=HEAD_SHA,
    85	        now_epoch=now,
    86	        deadline_epoch=deadline,
    87	        self_created_at_epoch=SELF_EPOCH,
    88	        freshness_skew_seconds=120,
    89	    )
    90	
    91	
    92	def gate_job(conclusion="success", status="completed"):
    93	    return {"name": "release-gate", "status": status, "conclusion": conclusion}
    94	
    95	
    96	def release_run(**over):
    97	    """A run that matches the candidate identity on every field by default."""
    98	    run = {
    99	        "id": 1001,
   100	        "run_attempt": 1,
   101	        "path": ".github/workflows/release.yml",
   102	        "event": "push",
   103	        "head_branch": TAG,
   104	        "head_sha": HEAD_SHA,
   105	        "created_at": CANDIDATE_CREATED_AT,
   106	        "status": "completed",
   107	        "conclusion": "success",
   108	        "jobs": [gate_job()],
   109	    }
   110	    run.update(over)
   111	    return run
   112	
   113	
   114	def self_run():
   115	    """The npm-publish run doing the asking — always in its own head_sha list."""
   116	    return {
   117	        "id": 1002,
   118	        "run_attempt": 1,
   119	        "path": ".github/workflows/npm-publish.yml",
   120	        "event": "push",
   121	        "head_branch": TAG,
   122	        "head_sha": HEAD_SHA,
   123	        "created_at": SELF_CREATED_AT,
   124	        "status": "in_progress",
   125	        "conclusion": None,
   126	        "jobs": [{"name": "await-release-gate", "status": "in_progress", "conclusion": None}],
   127	    }
   128	
   129	
   130	def payload(*runs):
   131	    return {"workflow_runs": list(runs)}
   132	
   133	
   134	def run_cli(raw_body, extra=(), self_created_at=SELF_CREATED_AT):
   135	    """CLI harness. ``self_created_at=None`` OMITS the flag entirely."""
   136	    handle, path = tempfile.mkstemp(suffix=".json")
   137	    with os.fdopen(handle, "w", encoding="utf-8") as fh:
   138	        fh.write(raw_body)
   139	    freshness = [] if self_created_at is None else ["--self-created-at", self_created_at]
   140	    try:
   141	        return subprocess.run(
   142	            [
   143	                sys.executable,
   144	                str(SCRIPT),
   145	                "--payload-file", path,
   146	                "--tag", TAG,
   147	                "--head-sha", HEAD_SHA,
   148	                "--deadline-epoch", str(DEADLINE_OPEN),
   149	                "--now-epoch", str(NOW),
   150	            ] + freshness + list(extra),
   151	            capture_output=True,
   152	            text=True,
   153	        )
   154	    finally:
   155	        os.unlink(path)
