   202	# State store
   203	# -----------------------------------------------------------------------------
   204	
   205	def _project_state_dir() -> Path:
   206	    """Return ~/.claude/projects/<proj>/state/, creating if missing.
   207	
   208	    Project key derived from CLAUDE_PROJECT_DIR (slug-encoded path).
   209	    Falls back to CWD-derived key if env not set.
   210	    """
   211	    proj_dir = os.environ.get("CLAUDE_PROJECT_DIR") or str(Path.cwd())
   212	    # Mimic Claude Code's project slug: leading '-' + path with '/' -> '-'
   213	    slug = "-" + proj_dir.replace("/", "-")
   214	    base = Path.home() / ".claude" / "projects" / slug / "state"
   215	    try:
   216	        base.mkdir(parents=True, exist_ok=True)
   217	    except OSError:
   218	        pass
   219	    return base
   220	
   221	
   222	def _state_path(session_id: str = "") -> Path:
   223	    """Per-SESSION sliding-window state (PLAN-152 economics-03).
   224	
   225	    Pre-v1.0.1 the window file was project-wide, so N parallel sessions
   226	    (sanctioned read-only fan-outs, background agents, a second terminal)
   227	    pooled ONE 5-min budget and tripped each other's P4 grep counter.
   228	    Scope the window by session_id. An empty/absent session_id falls back
   229	    to the legacy project-wide file (stampless subprocess callers keep the
   230	    old — strictly more conservative — behavior).
   231	    """
   232	    sid = re.sub(r"[^A-Za-z0-9._-]", "_", (session_id or ""))[:64]
   233	    if sid:
   234	        return _project_state_dir() / ("ceo-overhead-window-%s.json" % sid)
   235	    return _project_state_dir() / "ceo-overhead-window.json"
   236	
   237	
   238	def _gc_stale_session_windows(state_dir: Path, now: float) -> None:
   239	    """Best-effort GC of per-session window files older than 24h.
   240	
   241	    Called ONCE per session (on first window-file creation), never on the
   242	    hot per-tool-call path. Fail-open: any OS error is swallowed.
   243	    """
   244	    try:
   245	        cutoff = now - 24 * 60 * 60
   246	        for f in state_dir.glob("ceo-overhead-window-*.json"):
   247	            try:
   248	                if f.stat().st_mtime < cutoff:
   249	                    f.unlink()
   250	                    lock = f.with_suffix(".json.lock")
