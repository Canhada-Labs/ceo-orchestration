    64	            exit 1
    65	          fi
    66	          if [[ "$EXPECTED" != "$BASE" ]]; then
    67	            echo "OK: VERSION=$FILE matches RC tag=$TAG (compared against base '$BASE' after stripping the -rc.N pre-release suffix)"
