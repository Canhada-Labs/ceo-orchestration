SPEC/v1/audit-log.schema.md:1510:| `project` | str | Standard base field; truncated if oversized |
     1	#!/usr/bin/env python3
     2	"""Verify the HMAC chain in audit-log.jsonl.
     3	
     4	PLAN-023 Phase B / ADR-055.
     5	
     6	Walks an audit-log.jsonl file (or stdin) from first to last entry,
     7	recomputing the HMAC chain and comparing against the recorded ``hmac``
     8	field on each line. Exits 0 iff the chain is intact.
     9	
    10	## Exit codes
    11	
    12	- **0** — chain intact (or log empty / pre-v2.9 zone only).
    13	- **1** — tamper detected (line-level report on stderr).
    14	- **2** — audit-key file missing or unreadable.
    15	- **3** — malformed JSONL line (distinct from tamper — operator action
    16	  is "recover the partial line", not "investigate tamper").
    17	- **4** — permission error on key or log.
    18	
    19	## Semantics
    20	
    21	1. Genesis ``prev_hmac = b'\\x00' * 32``.
    22	2. Entry without ``hmac`` field in pre-v2.9 zone: tolerated (warning
    23	   only). As soon as the first ``hmac``-bearing entry appears, the
    24	   chain is ACTIVE for that file. Any subsequent entry WITHOUT
    25	   ``hmac`` → tamper (transition-entry rule is one-way).
    26	3. Entry with ``hmac`` field in CHAIN_ACTIVE state: recompute HMAC
    27	   from (key, prev_hmac, entry_sans_hmac_and_hmac_error) and compare.
    28	4. Chain resets ONLY on file boundary (log rotation). A single file
    29	   does not carry multiple chains.
    30	
    31	## Non-goals
    32	
    33	- Does not read or rely on the sidecar ``audit-log.last-hmac`` file
    34	  (the log itself is the source of truth for verification).
    35	- Does not detect tail truncation (covered by external anchor,
    36	  post-v1.6.0).
    37	- Does not detect rollback to an older log+key snapshot pair.
    38	"""
    39	
    40	from __future__ import annotations
    41	
    42	import argparse
    43	import json
    44	import os
    45	import sys
    46	from pathlib import Path
    47	from typing import Any, Dict, Iterator, Optional, Tuple
    48	
    49	
    50	_REPO_HOOKS = Path(__file__).resolve().parent.parent / "hooks"
    51	if str(_REPO_HOOKS) not in sys.path:
    52	    sys.path.insert(0, str(_REPO_HOOKS))
    53	
    54	from _lib import audit_hmac  # noqa: E402
    55	from _lib.audit_hmac import (  # noqa: E402
    56	    AuditHmacError,
    57	    GENESIS_PREV,
    58	    HMAC_BYTES,
    59	    HMAC_HEX_LEN,
    60	    STATUS_INTACT,
    61	    STATUS_KEY_MISSING,
    62	    STATUS_MALFORMED,
    63	    STATUS_PERM_ERROR,
    64	    STATUS_TAMPER,
    65	    VerifyResult,
    66	    compute_entry_hmac,
    67	    from_hex,
    68	    verify_chain,
    69	)
    70	
    71	
    72	# Exit code constants
    73	EXIT_INTACT = 0
    74	EXIT_TAMPER = 1
    75	EXIT_KEY_MISSING = 2
    76	EXIT_MALFORMED = 3
    77	EXIT_PERM = 4
    78	
    79	
    80	def _err(msg: str) -> None:
    81	    sys.stderr.write(msg + "\n")
    82	
    83	
    84	def _read_key(key_file: Optional[Path]) -> bytes:
    85	    """Read and validate the audit-key.
    86	
    87	    If ``key_file`` is None, use :func:`audit_hmac.key_path`.
    88	    """
    89	    p = key_file if key_file is not None else audit_hmac.key_path()
    90	    if not p.exists():
    91	        _err(
    92	            "error: audit-key not found at {p}; "
    93	            "generate one by writing an audit entry, or pass --key-file".format(p=p)
    94	        )
    95	        sys.exit(EXIT_KEY_MISSING)
    96	    try:
    97	        mode = p.stat().st_mode
    98	    except OSError as e:
