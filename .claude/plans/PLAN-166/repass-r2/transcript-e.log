   201	    """Handle the hmac-missing vs. hmac-present fork.
   202	
   203	    Returns ``(status, payload)`` where status is one of:
   204	      - ``"pre_v29"`` — pre-v2.9 entry, skip with counter bump
   205	      - ``"transition"`` — violation: hmac-bearing → hmac-less, exit tamper
   206	      - ``"malformed"`` — hmac field wrong type/length, exit malformed
   207	      - ``"ok"`` — payload is the validated hmac_hex string
   208	    """
   209	    hmac_hex = entry.get("hmac")
   210	    if hmac_hex is None:
   211	        if state == "CHAIN_START":
   212	            return "pre_v29", None
   213	        report = _format_report(
   214	            "tamper", line_num, entry, None, None,
   215	            "transition_violation: hmac-bearing entry followed by "
   216	            "hmac-less entry (one-way rule)",
   217	        )
   218	        _emit_report(report, json_output)
   219	        return "transition", EXIT_TAMPER
