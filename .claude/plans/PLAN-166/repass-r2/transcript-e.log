            E_MANIFEST_SET,
            "re-pass artifact set is not closed under %s\n"
            "      allowlisted but not in the manifest: %s\n"
            "      in the manifest but not allowlisted: %s"
            % (manifest_rel, extra or "-", missing or "-"),
