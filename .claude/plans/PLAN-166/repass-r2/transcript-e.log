   425	# Bump.
   426	#
   427	# The site table lives in `_release_bump_sites.py` and NOWHERE else: this
   428	# driver invokes it, and derives the dry-run restore list from it.
   429	#
   430	# The version written is always the BARE semver ($TARGET_BASE), never
   431	# X.Y.Z-rc.N. Two independent reasons: (a) precedent — every previous RC
   432	# carries the bare version in VERSION, the RC lives only in the tag name;
   433	# (b) every gate regex matches `\d+\.\d+\.\d+` only, so an -rc.N string would
   434	# match NOTHING and the gate would pass VACUOUSLY — silently stopping the
   435	# drift check exactly when it matters most.
   436	#
   437	# IDEMPOTENCE (F2, the v1.3.0-rc.1 re-pass). A bump on a tree that is already
   438	# at the target must write NOTHING — not one byte, not one index entry. It
   439	# used to re-date four `last-reviewed:` stamps with today date, which on D+1
   440	# of the ADR-103 hold produced a dirty tree, then a commit made AFTER the
   441	# preflight proved CI green, which `tag()` then signed. That commit was also
   442	# invisible to the pair-rail step 15 (none of the four files is in
   443	# `pair-rail-inputs-hash-manifest.txt`). Two independent defenses now:
   444	#   1. the same-tree predicate below (four oracles) short-circuits the phase;
   445	#   2. the writer skips each stamp line whose version is already the target.
   446	# ---------------------------------------------------------------------------
   447	_oracle() {
   448	  label="$1"; shift
   449	  if "$@" >/dev/null 2>&1; then
   450	    printf '  --   oracle %s: PASS  (%s)\n' "$label" "$*"
   451	    return 0
   452	  fi
   453	  printf '  --   oracle %s: RED   (%s)\n' "$label" "$*"
   454	  return 1
   455	}
