   469	_derive_hash_source() {  # $1 surface $2 after_rec $3 prior_rec $4 src_root
   470	  local surface="$1" ar="$2" pr="$3" src="$4"
   471	  [[ -z "$ar" ]] && { printf 'HASH_NONE'; return 0; }
