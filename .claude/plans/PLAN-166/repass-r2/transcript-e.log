   744	class W1BReleaseGateDeltaAncestryTest(TestEnvContext):
   745	    """The verdict delta + ancestry gate step (dual-context)."""
   746	
   747	    def setUp(self):
   748	        super().setUp()
   749	        resolved = _w1b_release_text()
   750	        if resolved is None:
   751	            self.skipTest(
   752	                "PLAN-166 W1-B release.yml not landed and staged mirror "
   753	                "absent (pre-landing CI window)"
   754	            )
   755	        self.source, self.context = resolved
   756	
   757	    # -- existence + independence from the step-15 escape hatches --------
   758	
   759	    def test_gate_step_present(self):
   760	        self.assertIn(
   761	            "- name: %s" % _W1B_STEP_NAME, self.source,
   762	            "the W1-B verdict delta + ancestry gate step is missing",
   763	        )
   764	
   765	    def test_gate_step_has_no_continue_on_error(self):
   766	        block = _step_block(self.source, _W1B_STEP_NAME)
   767	        self.assertNotIn(
   768	            "continue-on-error", block,
   769	            "the W1-B gate must NEVER carry continue-on-error — that is "
   770	            "exactly the step-15 escape hatch it exists to be independent "
   771	            "of (debate r3 scoped VETO)",
   772	        )
   773	
   774	    def test_file_carries_exactly_one_continue_on_error(self):
   775	        # The legacy step 15 keeps its documented transition hatch
   776	        # UNCHANGED (the plan adds a new step; it does not rewrite the
   777	        # neighbourhood). Exactly one KEY occurrence pins both
   778	        # directions at once: the hatch was not silently removed from
   779	        # step 15, and no step (new or old) gained a second one. Comment
   780	        # mentions of the phrase do not count — only the YAML key form.
   781	        key_form = re.findall(
   782	            r"^\s*continue-on-error:", self.source, re.MULTILINE
   783	        )
   784	        self.assertEqual(
   785	            len(key_form), 1,
   786	            "release.yml must carry exactly one continue-on-error KEY "
   787	            "(the legacy step-15 transition hatch); found %d"
   788	            % len(key_form),
   789	        )
   790	
   791	    def test_gate_fails_closed_on_transition_var(self):
   792	        block = _step_block(self.source, _W1B_STEP_NAME)
   793	        self.assertIn(
   794	            'if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL}" = "1" ]', block,
   795	            "the W1-B gate must test the transition var explicitly",
   796	        )
   797	        guard = block.index(
   798	            'if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL}" = "1" ]'
   799	        )
   800	        self.assertIn(
   801	            "exit 1", block[guard:guard + 400],
   802	            "the transition-var guard must FAIL CLOSED (exit 1), not skip",
   803	        )
   804	
   805	    def test_gate_never_builds_an_empty_parent_bind(self):
   806	        # The step-15 hatch shape: PARENT_SHA_ARG="" under the var. The
   807	        # W1-B block must not contain that shape in any form.
   808	        block = _step_block(self.source, _W1B_STEP_NAME)
   809	        self.assertNotIn('PARENT_SHA_ARG=""', block)
   810	        self.assertNotIn('--parent-sha ""', block)
   811	
   812	    def test_gate_binds_parent_sha_independently(self):
