   723	                        for m in sorted(self._EXACT_PLANTS)),
   724	                encoding="utf-8")
   725	            r = _run_json(root)
   726	            self.assertEqual(
   727	                r.returncode, 1,
   728	                f"planted pt-BR drift must fail the gate; {r.stdout}")
   729	            vio = json.loads(r.stdout)["violations"]
   730	            pt_vio = [v for v in vio if v.startswith(self._PT_DOC)]
   731	            for m in sorted(planted):
   732	                self.assertTrue(
