   120	
   121	def dump_manifest(obj: dict) -> str:
   122	    """Deterministic JSON: sorted keys, 2-space indent, trailing newline."""
   123	    return json.dumps(obj, indent=2, sort_keys=True) + "\n"
   124	
   125	
   126	def write_manifest_files(dest: Path, version: str = VERSION) -> None:
   127	    """Write plugin.json + marketplace.json (flat) into `dest`. Idempotent."""
   128	    dest.mkdir(parents=True, exist_ok=True)
   129	    (dest / "plugin.json").write_text(dump_manifest(plugin_manifest(version)))
   130	    (dest / "marketplace.json").write_text(dump_manifest(marketplace_manifest(version)))
   131	
   132	
   133	def check_manifests(committed_dir: Path, version: str = VERSION) -> int:
   134	    """Regen+diff idempotency gate (PLAN-153 B6, skill-inventory pattern).
   135	
   136	    Regenerates both manifests into a temp dir and diffs them against the
   137	    committed files in `committed_dir`. Returns 1 (with a unified diff on
   138	    stdout) on any drift or missing file; 0 when byte-identical."""
   139	    rc = 0
   140	    with tempfile.TemporaryDirectory(prefix="ceo-plugin-check-") as td:
   141	        write_manifest_files(Path(td), version)
   142	        for name in ("plugin.json", "marketplace.json"):
   143	            want = (Path(td) / name).read_text()
   144	            committed = committed_dir / name
   145	            if not committed.is_file():
   146	                log(f"DRIFT: {committed} is missing (must be generated + committed)")
   147	                rc = 1
   148	                continue
   149	            got = committed.read_text()
   150	            if got != want:
   151	                log(f"DRIFT: {committed} differs from regenerated content")
   152	                sys.stdout.writelines(difflib.unified_diff(
   153	                    got.splitlines(keepends=True), want.splitlines(keepends=True),
   154	                    fromfile=f"committed/{name}", tofile=f"generated/{name}"))
   155	                rc = 1
   156	    if rc:
   157	        log("fix: python3 scripts/build-plugin.py --write-manifests  (then commit)")
   158	    else:
   159	        log("plugin manifests in sync (.claude-plugin/ == generator output)")
   160	    return rc
   161	
   162	
   163	def write_manifest() -> None:
   164	    (PLUGIN / ".claude-plugin" / "plugin.json").write_text(dump_manifest(plugin_manifest()))
   165	    log("wrote plugin.json")
   166	
   167	
   168	def iter_skills():
   169	    """Yield (profile, src_dir) for every SKILL.md-bearing directory."""
   170	    core = REPO / ".claude/skills/core"
   171	    front = REPO / ".claude/skills/frontend"
   172	    domains = REPO / ".claude/skills/domains"
   173	    for d in sorted(core.glob("*/")):
   174	        if (d / "SKILL.md").exists():
   175	            yield ("core", d)
   176	    for d in sorted(front.glob("*/")):
   177	        if (d / "SKILL.md").exists():
   178	            yield ("frontend", d)
   179	    for dom in sorted(domains.glob("*/")):
   180	        sk = dom / "skills"
   181	        if not sk.is_dir():
   182	            continue
   183	        for d in sorted(sk.glob("*/")):
   184	            if (d / "SKILL.md").exists():
   185	                yield (dom.name, d)
   186	
   187	
   188	def copy_skills() -> int:
   189	    dst_root = PLUGIN / "skills"
   190	    dst_root.mkdir(parents=True, exist_ok=True)
   191	    used: dict[str, str] = {}
   192	    n = 0
   193	    collisions = 0
   194	    for profile, src in iter_skills():
   195	        base = src.name
   196	        name = base
   197	        if name in used:
   198	            # collision: prefix with profile to keep it unique + give context
   199	            name = f"{profile}-{base}"
   200	            collisions += 1
   201	            while name in used:
   202	                name = f"{profile}-{name}"
   203	        used[name] = str(src)
   204	        shutil.copytree(src, dst_root / name)
   205	        n += 1
   206	    log(f"copied {n} skills ({collisions} name collisions disambiguated)")
   207	    return n
   208	
   209	
   210	def copy_dir(rel_src: str, rel_dst: str, pattern: str = "*") -> int:
   211	    src = REPO / rel_src
   212	    dst = PLUGIN / rel_dst
   213	    dst.mkdir(parents=True, exist_ok=True)
   214	    n = 0
   215	    for f in sorted(src.glob(pattern)):
   216	        if f.is_file():
   217	            shutil.copy2(f, dst / f.name)
   218	            n += 1
   219	    return n
