    41	      #
    42	      # THE RC FLOW (documented so this never regresses): an RC tag
    43	      # `v<X.Y.Z>-rc.N` is cut from a tree whose VERSION file ALREADY
    44	      # reads the GA value `X.Y.Z` — the `-rc.N` pre-release suffix
    45	      # exists only in the tag name, never in the VERSION file. (The
    46	      # 24h RC-hold gate below encodes the same convention: it derives
    47	      # the RC tag family `v${VERSION}-rc.*` from the GA VERSION.)
    48	      # The old comparison (`FILE != TAG#v`) therefore hard-failed
    49	      # every RC tag's own release run: `v1.0.1-rc.1` vs
    50	      # `VERSION=1.0.1`. Fix: strip a trailing `-rc.<digits>` from the
    51	      # tag before comparing. GA tags are unaffected (nothing to
    52	      # strip); a wrong-version RC (`v1.0.2-rc.1` on `VERSION=1.0.1`)
    53	      # still hard-fails.
    54	      # -----------------------------------------------------------------
    55	      - name: Assert VERSION matches tag
    56	        run: |
    57	          set -euo pipefail
    58	          TAG="${GITHUB_REF_NAME}"
    59	          FILE="$(tr -d '[:space:]' < VERSION)"
    60	          EXPECTED="${TAG#v}"
    61	          BASE="${EXPECTED%-rc.[0-9]*}"
    62	          if [[ "$FILE" != "$BASE" ]]; then
    63	            echo "::error::VERSION file ('$FILE') does not match tag ('$TAG' → expected '$BASE')"
    64	            exit 1
    65	          fi
    66	          if [[ "$EXPECTED" != "$BASE" ]]; then
    67	            echo "OK: VERSION=$FILE matches RC tag=$TAG (compared against base '$BASE' after stripping the -rc.N pre-release suffix)"
    68	          else
    69	            echo "OK: VERSION=$FILE matches tag=$TAG"
    70	          fi
    71	
    72	      # -----------------------------------------------------------------
    73	      # PLAN-166 W1 item 2 (F3, ADR-155-AMEND-1 §5, Forma A (ii)) — the
    74	      # framework version marker `.claude/.framework-version` is a TRACKED
    75	      # one-line file, byte-identical to VERSION (the version bump writes
    76	      # it as a site; verify-counts.sh cross-checks it). This assert is
    77	      # deliberately UNCONDITIONAL and fail-closed: a missing marker in a
    78	      # release checkout means the ceremony that introduced it was
    79	      # reverted or the bump skipped a site — either way the tag must not
    80	      # ship. Kept NEXT TO the VERSION↔tag assert above so the whole
    81	      # version-consistency family lives in one place (same convention as
    82	      # the plugin-manifest step below).
    83	      # -----------------------------------------------------------------
    84	      - name: Assert framework-version marker matches VERSION
    85	        run: |
    86	          set -euo pipefail
    87	          FILE="$(tr -d '[:space:]' < VERSION)"
    88	          if [[ ! -f .claude/.framework-version ]]; then
    89	            echo "::error::.claude/.framework-version is missing — it is a tracked file (PLAN-166 F3 / ADR-155-AMEND-1); a release checkout without it must not ship"
    90	            exit 1
    91	          fi
    92	          MARKER="$(tr -d '[:space:]' < .claude/.framework-version)"
    93	          if [[ "$MARKER" != "$FILE" ]]; then
    94	            echo "::error::.claude/.framework-version ('$MARKER') does not match VERSION ('$FILE') — the marker is byte-identical to VERSION by contract (Forma A (ii), fail-closed)"
    95	            exit 1
    96	          fi
    97	          echo "OK: .claude/.framework-version=$MARKER matches VERSION"
    98	
    99	      # -----------------------------------------------------------------
   100	      # PLAN-153 Wave B item 5 (e) — version↔plugin-manifest sync, kept
   101	      # NEXT TO the VERSION↔tag assert above so the whole
   102	      # version-consistency family lives in one place.
   103	      #
   104	      # `.claude-plugin/{plugin.json,marketplace.json}` are generated by
   105	      # `build-plugin.py` (Wave B item 6). Until item 6 lands, the
   106	      # manifests do not exist and this step passes with a ::notice
   107	      # (self-arming: the equality checks become enforcing the moment
   108	      # the manifests appear in the tree — no workflow re-edit needed).
   109	      # `marketplace.json`'s schema is owned by build-plugin.py, so we
   110	      # assert on EVERY nested `version` field found rather than
   111	      # hardcoding one JSON path.
   112	      # -----------------------------------------------------------------
   113	      - name: Assert plugin manifest versions match VERSION
   114	        run: |
   115	          set -euo pipefail
   116	          FILE="$(tr -d '[:space:]' < VERSION)"
   117	          if [[ ! -f .claude-plugin/plugin.json ]]; then
   118	            echo "::notice::.claude-plugin/plugin.json not present yet (PLAN-153 Wave B item 6) — sync check self-arms once it lands"
   119	            exit 0
   120	          fi
   121	          PLUGIN_V=$(jq -r '.version // empty' .claude-plugin/plugin.json)
   122	          if [[ "$PLUGIN_V" != "$FILE" ]]; then
   123	            echo "::error::.claude-plugin/plugin.json version ('$PLUGIN_V') does not match VERSION ('$FILE')"
   124	            exit 1
   125	          fi
   126	          echo "OK: plugin.json version=$PLUGIN_V matches VERSION"
   127	          if [[ -f .claude-plugin/marketplace.json ]]; then
   128	            BAD=0
   129	            while IFS= read -r v; do
   130	              [[ -z "$v" ]] && continue
   131	              if [[ "$v" != "$FILE" ]]; then
   132	                echo "::error::.claude-plugin/marketplace.json carries version '$v' != VERSION ('$FILE')"
   133	                BAD=1
   134	              fi
   135	            done < <(jq -r '.. | objects | .version? // empty' .claude-plugin/marketplace.json)
   136	            if [[ "$BAD" -ne 0 ]]; then
   137	              exit 1
   138	            fi
   139	            echo "OK: every marketplace.json version field matches VERSION"
   140	          else
   141	            echo "::notice::.claude-plugin/marketplace.json not present — skipping"
   142	          fi
   143	
   144	      # -----------------------------------------------------------------
   145	      # F5 — RC-hold / staleness waiver SUNSET assertion.
   146	      #
   147	      # The pre-GA waivers in .claude/governance/governance-waivers.yaml
   148	      # are honest ONLY while the project is pre-GA (adopter_count=0).
   149	      # Every existing rc_hold/workflow_staleness entry is a 1.x version
   150	      # carrying "Pre-GA ... adopter_count=0". To stop that 100%-waiver
   151	      # escape from silently following the project into GA, this step
   152	      # FAILS the release the moment any waiver `version` parses >= the
   153	      # configured FIRST_GA floor. The floor is the first version at which
   154	      # the framework intends to claim GA / publish to adopters; per
   155	      # ADR-073 the next major (v2.0.0) is the documented GA/breaking
   156	      # boundary, so 2.0.0 is the mechanical sunset. After the first real
   157	      # adopter ships, lower FIRST_GA (or empty the waiver lists) so the
   158	      # ADR-007 RC-hold + 14-day staleness gates resume real enforcement.
   159	      #
   160	      # Today (max waiver 1.0.0 < 2.0.0) this passes; it is a tripwire,
   161	      # not a behavior change for the current pre-GA train.
   162	      #
   163	      # `-rc.N` pre-release suffixes are stripped before comparison: RC
   164	      # tags forensically short-circuit the hold gate (see below), so an
   165	      # rc.* waiver is never an enforcement bypass on its own.
   166	      # -----------------------------------------------------------------
   167	      - name: Assert no waiver has reached the GA sunset floor
   168	        env:
   169	          # First version at which pre-GA waivers are no longer honest.
   170	          # Bump DOWN (or empty the waiver lists) once an adopter ships.
   171	          FIRST_GA: "2.0.0"
   172	        run: |
   173	          set -euo pipefail
   174	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   175	          if [[ ! -f "$WAIVER_FILE" ]]; then
   176	            echo "OK: no waiver file present — nothing to sunset"
   177	            exit 0
   178	          fi
   179	
   180	          # Extract every `version:` value from BOTH waiver sections using
   181	          # the same flag-based section parser the file documents (a range
   182	          # pattern collapses because the start/end regex overlap), strip
   183	          # any -rc.* suffix, then sort -V -u. Iterated via a while-read
   184	          # loop (portable: no mapfile / bash-4 dependency).
   185	          FAILED=0
   186	          COUNT=0
   187	          while IFS= read -r v; do
   188	            [[ -z "$v" ]] && continue
   189	            COUNT=$((COUNT + 1))
   190	            # v >= FIRST_GA  <=>  the smaller of {v, FIRST_GA} under
   191	            # version-sort is FIRST_GA. (Equal floor counts as reached.)
   192	            LOWER="$(printf '%s\n%s\n' "$v" "$FIRST_GA" | sort -V | head -1)"
   193	            if [[ "$v" == "$FIRST_GA" || "$LOWER" == "$FIRST_GA" ]]; then
   194	              echo "::error::Waiver version $v has reached the GA sunset floor (FIRST_GA=$FIRST_GA)"
   195	              echo "::error::Pre-GA RC-hold/staleness waivers are dishonest at or past GA."
   196	              echo "::error::Remove the $v waiver entry (and resume ADR-007 enforcement) or lower FIRST_GA only with a real adopter."
   197	              FAILED=1
   198	            fi
   199	          done < <(
   200	            {
   201	              awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   202	              awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   203	            } \
   204	              | grep -oE '^[[:space:]]*-[[:space:]]*version:[[:space:]]*[0-9][0-9A-Za-z.+-]*' \
   205	              | grep -oE '[0-9][0-9A-Za-z.+-]*$' \
   206	              | sed -E 's/-rc\.[0-9.]+$//' \
   207	              | sort -V -u
   208	          )
   209	
   210	          if [[ "$COUNT" -eq 0 ]]; then
   211	            echo "OK: waiver file has no version entries to sunset"
   212	            exit 0
   213	          fi
   214	          if [[ "$FAILED" -ne 0 ]]; then
   215	            exit 1
   216	          fi
   217	          echo "OK: all $COUNT waiver versions are pre-GA (< FIRST_GA=$FIRST_GA)"
   218	
   219	      # -----------------------------------------------------------------
   220	      # PLAN-112-FOLLOWUP-canonical-doc-refresh-gate — canonical doc freshness.
   221	      #
   222	      # Fails the release when an in-scope canonical doc's machine-readable
   223	      # `<!-- last-reviewed: DATE vX.Y.Z -->` stamp is more MINOR releases
   224	      # behind VERSION than its tier allows (security docs N=1; general N=3).
   225	      # Missing/malformed stamp fails-CLOSED. Closes F-D4.
   226	      #
   227	      # Emergency bypass: the checker self-reads an Owner-signed
   228	      # `doc_freshness:` entry (matching this release version) in
   229	      # `.claude/governance/governance-waivers.yaml` and, when present,
   230	      # passes WITH a surfaced ::warning (never a silent skip).
   231	      # -----------------------------------------------------------------
   232	      - name: Canonical doc freshness gate
   233	        run: |
   234	          set -euo pipefail
   235	          python3 .claude/scripts/check-canonical-doc-freshness.py
   236	
   237	      # -----------------------------------------------------------------
   238	      # PLAN-013 Phase 0 item 0.3 — mandatory RC-to-GA hold enforcement.
   239	      # AMENDED 2026-05-03 per ADR-103: 7-day calendar gate REDUCED to
   240	      # 24h Codex re-pass mechanical window per ADR-095 §gate-#6.
   241	      #
   242	      # Debate Round 1 consensus §S3 HIGH (DevOps): "7-day RC hold is
   243	      # policy not mechanism. Policy without mechanism is hope."
   244	      #
   245	      # Rule: a GA tag `v1.x.y` MAY only ship after its corresponding
   246	      # RC tag `v1.x.y-rc.N` has existed for ≥24 hours. The 24h window
   247	      # is mechanical: bounds the maximum Codex external re-pass
   248	      # turnaround (anti same-LLM bias per ADR-095 §gate-#6). NOT a
   249	      # "settle period" — vibecoder-only thesis (ADR-096) means no
   250	      # external adopter pressure for calendar buffers.
   251	      #
   252	      # Mechanism:
   253	      #   1. If tag contains `-rc.` → skip check (RC tags always pass)
   254	      #   2. Else find most recent `v<VERSION>-rc.*` tag (by creator date)
   255	      #   3. If none exists → fail (mandatory RC before GA)
   256	      #   4. Else compute delta; reject if < 24h (86400 seconds)
   257	      # -----------------------------------------------------------------
   258	      - name: Assert 24h Codex re-pass window (GA tags only, waiver-aware)
   259	        run: |
   260	          set -euo pipefail
   261	          TAG="${GITHUB_REF_NAME}"
   262	          VERSION="${TAG#v}"
   263	
   264	          # RC tags short-circuit — they are always permitted.
   265	          if [[ "$TAG" == *-rc.* ]]; then
   266	            echo "::notice::$TAG is an RC tag — skipping 24h hold check"
   267	            exit 0
   268	          fi
   269	
   270	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment).
   271	          # During initial framework development with adopter_count=0,
   272	          # the RC-hold window can be waived per Owner authorization
   273	          # recorded in .claude/governance/rc-hold-waivers.yaml. The
   274	          # waiver is additive: post-first-adopter, the file is expected
   275	          # to be empty and ADR-007 default resumes. Each waiver entry
   276	          # cites Owner directive + round-NN sentinel commit.
   277	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   278	          if [[ -f "$WAIVER_FILE" ]]; then
   279	            if awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   280	              echo "::notice::$TAG has a pre-GA RC-hold waiver in $WAIVER_FILE — skipping hold check"

