   589	def _archetype_match(lesson_archetype: str, query_archetype: str) -> float:
   590	    """1.0 exact, 0.3 related (same word overlap), 0.0 otherwise."""
   591	    if not lesson_archetype or not query_archetype:
   592	        return 0.0
   593	    la = set(lesson_archetype.lower().split())
   594	    qa = set(query_archetype.lower().split())
   595	    if la == qa:
   596	        return 1.0
   597	    if la & qa:
   598	        return 0.3
   599	    return 0.0
   600	
   601	
   602	def _scope_overlap(lesson_tags: List[str], query_keywords: List[str]) -> float:
   603	    """Jaccard similarity of tag sets."""
   604	    if not lesson_tags or not query_keywords:
   605	        return 0.0
   606	    a = set(t.lower() for t in lesson_tags)
   607	    b = set(k.lower() for k in query_keywords)
   608	    intersection = len(a & b)
   609	    union = len(a | b)
   610	    if union == 0:
   611	        return 0.0
   612	    return intersection / union
   613	
   614	
   615	def _recency_decay(
   616	    created_at: str,
   617	    now_fn: Optional[Callable[[], Any]] = None,
   618	) -> float:
   619	    """exp(-days/90) exponential decay — 90-day e-folding time.
   620	
   621	    PLAN-154 A14 docstring fix: the old wording claimed a "90-day
   622	    half-life"; the actual half-life of exp(-days/90) is 90·ln(2) ≈
   623	    62.4 days (90 days is the e-folding constant, decay ≈ 0.368).
   624	
   625	    PLAN-154 A9: injectable ``now_fn`` (wall clock only as default) so
   626	    decay is deterministic under test — golden-value boundaries,
   627	    monotonicity, and twice-run-identical are pinned in
   628	    ``test_lessons_candidates.py``.
   629	    """
   630	    try:
   631	        # Parse ISO 8601
   632	        if created_at.endswith("Z"):
   633	            created_at = created_at[:-1] + "+00:00"
   634	        dt = datetime.fromisoformat(created_at)
   635	        if dt.tzinfo is None:
   636	            dt = dt.replace(tzinfo=timezone.utc)
   637	        now = _now_utc(now_fn)
   638	        days = (now - dt).total_seconds() / 86400
   639	        return math.exp(-days / 90)
   640	    except (ValueError, TypeError, AttributeError):
   641	        return 0.5  # neutral if unparseable
   642	
   643	
   644	def rank_lessons(
   645	    archetype: str,
   646	    keywords: List[str],
   647	    base_dir: Optional[str] = None,
   648	    now_fn: Optional[Callable[[], Any]] = None,
   649	) -> List[Lesson]:
   650	    """Return top-3 lessons by relevance score (injection-sized)."""
   651	    return get_top_k(archetype, keywords, k=3, base_dir=base_dir, now_fn=now_fn)
   652	
   653	
   654	def get_top_k(
   655	    archetype: str,
   656	    keywords: List[str],
   657	    k: int = 50,
   658	    base_dir: Optional[str] = None,
   659	    now_fn: Optional[Callable[[], Any]] = None,
   660	) -> List[Lesson]:
   661	    """Return top-K lessons by relevance score, capped by K.
   662	
   663	    PLAN-006 Phase 4 (ADR-015, R-VP4 10x scale): hard cap prevents O(n)
   664	    cross-archetype scoring on every spawn from degrading at scale.
   665	    Relevance weighted by `archetype_match × scope_overlap ×
   666	    recency_decay × hit_rate_weight`.
   667	
   668	    Default K=50 (ADR-015 scaling envelope). Injection path uses K=3.
   669	    """
   670	    if k < 1:
   671	        k = 1
   672	    if k > 50:
   673	        k = 50  # hard ceiling per ADR-015
   674	
   675	    lessons = list_lessons(base_dir)
   676	    if not lessons:
   677	        return []
   678	
   679	    scored = []
   680	    for lesson in lessons:
   681	        am = _archetype_match(lesson.archetype, archetype)
   682	        so = _scope_overlap(lesson.scope_tags, keywords)
   683	        rd = _recency_decay(lesson.created_at, now_fn=now_fn)
   684	        # Hit-rate weight: untested lessons (n<3) get neutral 1.0;
   685	        # proven lessons in [0.5, 1.5] range so confirmed winners
   686	        # (hr=1.0 → hw=1.5) outrank untested ones, while confirmed
   687	        # losers (hr=0.0 → hw=0.5) are down-weighted but not zeroed
   688	        # (pruning policy in ADR-017 handles deletion separately).
   689	        hr = lesson.hit_rate()
   690	        hw = 1.0 if hr is None else max(0.1, 0.5 + hr)
   691	        score = am * so * rd * hw
   692	        if score > 0:
   693	            scored.append((score, lesson))
   694	
   695	    scored.sort(key=lambda x: x[0], reverse=True)
   696	    return [lesson for _, lesson in scored[:k]]
