     1	#!/usr/bin/env python3
     2	# ============================================================================
     3	# _release_bump_sites.py — the ONE source of truth for the release version
     4	# sites, and the only writer of them.
     5	#
     6	# Why a module and not a heredoc. Until PLAN-166/W0 this table lived inside
     7	# `release.sh` as a `python3 - <<'PY'` heredoc. That had two costs that both
     8	# showed up in the v1.3.0-rc.1 re-pass:
     9	#
    10	#   1. the site list existed TWICE — once in the heredoc (the writer) and once
    11	#      in the driver's `VERSION_FILES` array (the dry-run restore list). A list
    12	#      that must match another list by hand does not stay matched; a restore
    13	#      list shorter than the write list leaves debris (the S273 class).
    14	#   2. it was untestable. `--today` could not be pinned, so the D+1
    15	#      non-idempotence (F2) could not be exercised by a test.
    16	#
    17	# Both are closed here: the driver DERIVES its restore list from
    18	# `print-sites --include-generated`, and `--today` is a REQUIRED parameter with
    19	# NO DEFAULT (a parameter that changes the verdict never has a default —
    20	# frozen-evidence lesson).
    21	#
    22	# Idempotence contract (F2). A `last-reviewed:` stamp asserts "this document
    23	# was re-read FOR THIS RELEASE". Re-dating it without re-reading is a false
    24	# claim on a surface that a signed tag then covers. So the stamp sites
    25	# skip the ENTIRE line — neither date nor version — when the version already
    26	# on the stamp is the target. `--restamp` is the named, explicit route for a
    27	# real re-review.
    28	#
    29	# The two stamp oracles (do not collapse them). `npm/README.md` is watched by
    30	# verify-counts' VERSION_SITES; SBOM.md / SECURITY.md / VERSIONING.md are
    31	# watched ONLY by check-canonical-doc-freshness.py. Both oracles decide on the
    32	# VERSION in the stamp, never on the date — which is what makes freezing the
    33	# date safe.
    34	#
    35	# The support window (kinds "minor"/"prev_minor" — v1.3.0 re-pass, F-sites).
    36	# verify-counts' VERSION_SITES also watches "Current MINOR (vX.Y.x)" and
    37	# "Previous MINOR (vX.Y.x)" in SECURITY.md and VERSIONING.md (S293). Those
    38	# sites were OUTSIDE this table at birth, so the next MINOR bump would write
    39	# everything else, then DIE at the driver's own verify-counts call with a
    40	# half-written tree (outside --dry-run there is no restore trap). The rule the
    41	# oracle enforces is mechanical — Current = the target's minor, Previous = the
    42	# minor immediately before it — so this writer derives both from --target and
    43	# the "ONE source of truth" claim above stays true. The single non-derivable
    44	# case, an X.0.0 target, is SKIPPED loudly and never guessed: the oracle
    45	# cannot value-check it either (it derives prev="" at X.0), and a MAJOR
    46	# support-window transition is release-train judgment, not sed.
    47	# ============================================================================
    48	"""Release version-site table + writer (stdlib only, Python >= 3.9)."""
    49	
    50	from __future__ import annotations
    51	
    52	import argparse
    53	import os
    54	import re
    55	import sys
    56	from typing import Callable, List, Optional, Sequence, Tuple
    57	
    58	SEMVER = r"\d+\.\d+\.\d+"
    59	STAMP_RX = r"(last-reviewed: )(\d{4}-\d{2}-\d{2})( +v)(" + SEMVER + r")"
    60	DATE_RX = re.compile(r"\A\d{4}-\d{2}-\d{2}\Z")
    61	
    62	# Kinds:
    63	#   "plain"      — literal regex substitution, no stamp semantics.
    64	#   "stamp"      — "last-reviewed: <date> v<version>"; skipped wholesale when
    65	#                  the version already equals the target (unless --restamp).
    66	#   "minor"      — support-window site carrying the TARGET's minor (vX.Y.x).
    67	#   "prev_minor" — support-window site carrying the minor immediately BEFORE
    68	#                  the target; not derivable at X.0.0 (skipped loudly there).
    69	PLAIN = "plain"
    70	STAMP = "stamp"
    71	MINOR = "minor"
    72	PREV_MINOR = "prev_minor"
    73	
    74	# (path, kind, pattern) — patterns anchored exactly as their oracle checks
    75	# them, so historical version mentions elsewhere in the file are never touched.
    76	_SITES: List[Tuple[str, str, str]] = [
    77	    ("VERSION", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    78	    # PLAN-169 W2.6 (ledger E.1/F.7/A.0.4): the install-state marker is the
    79	    # surface check-framework-updates.sh reads MARKER-FIRST — a bump that
    80	    # skips it leaves every adopter's updater reporting behind-minor
    81	    # forever. 12th site; oracle mirror in verify-counts VERSION_SITES.
    82	    (".claude/.framework-version", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    83	    ("npm/package.json", PLAIN, r'("version"\s*:\s*")' + SEMVER + r'(")'),
    84	    ("pyproject.toml", PLAIN, r'(?m)^(version\s*=\s*")' + SEMVER + r'(")'),
    85	    ("INSTALL.md", PLAIN, r"(--pin v)" + SEMVER),
    86	    (
    87	        "docs/ARCHITECTURE.md",
    88	        PLAIN,
    89	        r"(currently\s+v)" + SEMVER + r"(, aligned with the repo)",
    90	    ),
    91	    # README.md and CLAUDE.md are deliberately NOT rows here: neither is a
    92	    # version site. `VERSION=` never existed in either (verify-counts dropped
    93	    # its dead rules for both in S291 — `git log -S 'VERSION='` finds no
    94	    # commit that added one — and the release checklist states the same). A
    95	    # writer row for a site no oracle watches would be that dead rule
    96	    # reintroduced on the WRITE side: the day someone adds a `VERSION=` line
    97	    # to README.md, the bump would rewrite a file every other surface
    98	    # declares out of scope.
    99	    ("SBOM.md", PLAIN, r"(\*\*Version:\*\* `)" + SEMVER + r"(`)"),
   100	    # --- the support window (oracle: verify-counts VERSION_SITES modes
   101	    #     "minor"/"prev_minor", S293). Patterns anchored exactly as the
   102	    #     oracle's — SECURITY.md bolds the label, VERSIONING.md does not. ---
   103	    ("SECURITY.md", MINOR, r"(\*\*Current MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   104	    ("VERSIONING.md", MINOR, r"(Current MINOR \(`v)\d+\.\d+(\.x`\))"),
   105	    ("SECURITY.md", PREV_MINOR, r"(\*\*Previous MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   106	    ("VERSIONING.md", PREV_MINOR, r"(Previous MINOR \(`v)\d+\.\d+(\.x`\))"),
   107	    # --- the review stamps (idempotence-critical; the table IS the census,
   108	    #     a numeral here would be a mirror that drifts) ---
   109	    ("npm/README.md", STAMP, STAMP_RX),
   110	    ("SBOM.md", STAMP, STAMP_RX),
   111	    ("SECURITY.md", STAMP, STAMP_RX),
   112	    ("VERSIONING.md", STAMP, STAMP_RX),
   113	]
   114	
   115	# Written by the bump PHASE but not by this module: `build-plugin.py
   116	# --write-manifests` regenerates them from VERSION. They belong in any
   117	# derived restore/guard list, which is why they are exported here instead of
   118	# being re-typed by every caller (the duplicated-list failure this module
   119	# exists to kill).
   120	GENERATED_BY_BUMP: List[str] = [
   121	    ".claude-plugin/plugin.json",
   122	    ".claude-plugin/marketplace.json",
   123	]
   124	
   125	
   126	def site_paths(include_generated: bool = False) -> List[str]:
   127	    """Every path this module may write, de-duplicated, in table order."""
   128	    out: List[str] = []
   129	    for path, _kind, _rx in _SITES:
   130	        if path not in out:
   131	            out.append(path)
   132	    if include_generated:
   133	        for path in GENERATED_BY_BUMP:
   134	            if path not in out:
   135	                out.append(path)
   136	    return out
   137	
   138	
   139	def _plain_replacement(pattern: str, target: str) -> str:
   140	    """Replacement string for a PLAIN site, rebuilt from its group count."""
   141	    if pattern.startswith(r"\A"):  # the bare VERSION file
   142	        return target + "\n"
   143	    groups = re.compile(pattern).groups
   144	    if groups == 0:
   145	        return target
   146	    if groups == 1:
   147	        return r"\g<1>" + target
   148	    return r"\g<1>" + target + r"\g<2>"
   149	
   150	
   151	def _stamp_replacer(
   152	    target: str, today: str, restamp: bool
   153	) -> Callable[["re.Match"], str]:
   154	    def _repl(m: "re.Match") -> str:
   155	        if not restamp and m.group(4) == target:
   156	            # Defense in depth: the whole line is left byte-identical. Both
   157	            # stamp oracles read the VERSION, so freezing the date costs
   158	            # nothing and re-dating without re-reading would be a false claim.
   159	            return m.group(0)
   160	        return m.group(1) + today + m.group(3) + target
   161	
   162	    return _repl
   163	
   164	
   165	def bump(
   166	    target: str,
   167	    today: str,
   168	    *,
   169	    restamp: bool = False,
   170	    root: Optional[str] = None,
   171	    out=None,
   172	) -> int:
   173	    """Rewrite every version site to `target`. Returns files CHANGED."""
   174	    if not DATE_RX.match(today):
   175	        raise ValueError("--today must be YYYY-MM-DD, got %r" % (today,))
   176	    if not re.match(r"\A" + SEMVER + r"\Z", target):
   177	        raise ValueError("--target must be a bare semver, got %r" % (target,))
   178	    stream = out if out is not None else sys.stdout
   179	    base = root or os.getcwd()
   180	    # Support-window derivation, BEFORE any byte is written: whether every
   181	    # site is writable is decided up front, never discovered mid-loop with a
   182	    # half-bumped tree behind it.
   183	    _maj, _min = (int(x) for x in target.split(".")[:2])
   184	    minor_target = "%d.%d" % (_maj, _min)
   185	    prev_minor = "%d.%d" % (_maj, _min - 1) if _min > 0 else None
   186	    changed = 0
   187	    for path, kind, pattern in _SITES:
   188	        if kind == PREV_MINOR and prev_minor is None:
   189	            # X.0.0: Previous MINOR is not derivable from the target, and the
   190	            # oracle skips value-checking it there too (prev="" at X.0). Never
   191	            # guess a support-window promise — leave it and say so, loudly.
   192	            print(
   193	                "  !!   %s: Previous MINOR left untouched — not derivable "
   194	                "from %s (X.0.0); the support window needs release-train "
   195	                "judgment here" % (path, target),
   196	                file=stream,
   197	            )
   198	            continue
   199	        full = os.path.join(base, path)
   200	        try:
   201	            with open(full, encoding="utf-8") as fh:
   202	                src = fh.read()
   203	        except OSError:
   204	            print("  --   %s absent, skipped" % path, file=stream)
   205	            continue
   206	        written = target
   207	        if kind == STAMP:
   208	            new, n = re.subn(pattern, _stamp_replacer(target, today, restamp), src)
   209	            label = "review stamp"
   210	        elif kind == MINOR:
   211	            written = minor_target
   212	            new, n = re.subn(pattern, r"\g<1>" + written + r"\g<2>", src)
   213	            label = "support-window (Current MINOR) site"
   214	        elif kind == PREV_MINOR:
   215	            written = prev_minor
   216	            new, n = re.subn(pattern, r"\g<1>" + written + r"\g<2>", src)
   217	            label = "support-window (Previous MINOR) site"
   218	        else:
   219	            new, n = re.subn(pattern, _plain_replacement(pattern, target), src)
   220	            label = "version site"
   221	        if n == 0:
   222	            print(
   223	                "  --   %s: no %s found (ok if unwatched)" % (path, label),
   224	                file=stream,
   225	            )
   226	            continue
   227	        if new == src:
   228	            print(
   229	                "  --   %s: %s already at %s (line untouched)"
   230	                % (path, label, written),
   231	                file=stream,
   232	            )
   233	            continue
   234	        with open(full, "w", encoding="utf-8") as fh:
   235	            fh.write(new)
   236	        changed += 1
   237	        print(
   238	            "  ok   %s (%d %s%s -> %s)"
   239	            % (path, n, label, "" if n == 1 else "s", written),
   240	            file=stream,
   241	        )
   242	    return changed
   243	
   244	
   245	def main(argv: Optional[Sequence[str]] = None) -> int:
   246	    parser = argparse.ArgumentParser(
   247	        prog="_release_bump_sites.py",
   248	        description="Release version-site table + writer (single source).",
   249	    )
   250	    sub = parser.add_subparsers(dest="cmd")
   251	
   252	    p_list = sub.add_parser(
   253	        "print-sites",
   254	        help="print every path the bump may write, one per line",
   255	    )
   256	    p_list.add_argument(
   257	        "--include-generated",
   258	        action="store_true",
   259	        help="also print the plugin manifests regenerated by build-plugin.py",
   260	    )
   261	
   262	    p_bump = sub.add_parser("bump", help="rewrite the version sites")
   263	    # NO DEFAULT, BY CONTRACT. `--today` decides whether a signed
   264	    # "last-reviewed" claim moves; a parameter that changes the verdict is
   265	    # never defaulted (frozen-evidence lesson).
   266	    p_bump.add_argument("--today", required=True, help="YYYY-MM-DD (required)")
   267	    p_bump.add_argument("--target", required=True, help="bare semver, e.g. 1.3.0")
   268	    p_bump.add_argument(
   269	        "--restamp",
   270	        action="store_true",
   271	        help="force the review stamps to move even at the same version",
   272	    )
   273	    p_bump.add_argument("--root", default=None, help="repo root (default: cwd)")
   274	
   275	    args = parser.parse_args(argv)
   276	    if args.cmd == "print-sites":
   277	        for path in site_paths(include_generated=args.include_generated):
   278	            print(path)
   279	        return 0
   280	    if args.cmd == "bump":
   281	        try:
   282	            bump(
   283	                args.target,
   284	                args.today,
   285	                restamp=args.restamp,
   286	                root=args.root,
   287	            )
   288	        except ValueError as exc:
   289	            print("FAIL: %s" % exc, file=sys.stderr)
   290	            return 2
   291	        return 0
   292	    parser.print_usage(sys.stderr)
   293	    return 2
