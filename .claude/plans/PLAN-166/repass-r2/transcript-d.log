   296	if __name__ == "__main__":
   297	    sys.exit(main())
     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# release.sh — operator release driver. Version-neutral BY NAME.
     4	#
     5	# The previous driver carried a release number in its own FILENAME, and was
     6	# still driving the release after that one — the root of a whole class: a
     7	# driver named for one release is a standing invitation for every other version
     8	# literal inside it to go stale too. Everything release-specific now lives in
     9	# the PER-RELEASE block below, and every message derives from it. The old path
    10	# is deliberately left unspelled on every live surface, so the AC-6 control
    11	# needs no "except this one" exemption; `git log --follow` is the archaeology.
    12	#
    13	# Implements the documented procedure in `.github/release-checklist.md`:
    14	# RC first (vX.Y.Z-rc.N), then the ADR-103 24 h hold, then promote stable.
    15	#
    16	# WHAT THE OWNER SIGNS. Nothing here is a canonical-edit ceremony: CHANGELOG.md,
    17	# VERSION and npm/package.json are NOT in `_CANONICAL_GUARDS`
    18	# (`.claude/hooks/check_canonical_edit.py`), so no sentinel `approved.md`
    19	# exists for a release. The Owner signature is the **annotated GPG tag**,
    20	# produced INLINE by the `tag` phase (family lesson: a ceremony script signs
    21	# inline and never demands a pre-existing `.asc`).
    22	#
    23	# WHAT THIS SCRIPT NEVER DOES. It never pushes, and it never publishes.
    24	# Pushing the tag is the irreversible, outward-facing step: it starts BOTH
    25	# `.github/workflows/release.yml` (the release gate) and
    26	# `.github/workflows/npm-publish.yml` — and npm-publish.yml is what actually
    27	# publishes to npm via OIDC. This driver prints the push command and stops.
    28	#
    29	# Phases (run in order):
    30	#   preflight  read-only gates, fail-closed          (default)
    31	#   bump       version sites + plugin manifests + commit
    32	#   tag        annotated GPG tag, signed inline, behind two fail-closed guards
    33	#
    34	# Usage:
    35	#   bash .claude/scripts/local/release.sh preflight
    36	#   bash .claude/scripts/local/release.sh bump --dry-run
    37	#   bash .claude/scripts/local/release.sh bump
    38	#   bash .claude/scripts/local/release.sh tag --dry-run
    39	#   bash .claude/scripts/local/release.sh tag
    40	#
    41	# Options:
    42	#   --dry-run        make no lasting change; restores BOTH working tree and
    43	#                    index on exit (trap), including on failure. The restore
    44	#                    list is DERIVED from _release_bump_sites.py, never typed.
    45	#   --stable         target the bare version instead of -rc.N (post-hold promote)
    46	#   --rc N           RC ordinal (default 1)
    47	#   --key KEYID      GPG key to sign with (default: the key of the last release)
    48	#   --today DATE     YYYY-MM-DD stamped into the `last-reviewed:` lines
    49	#                    (default: today). It exists so the D/D+1 idempotence
    50	#                    invariant is testable at the driver level; it changes only
    51	#                    the stamp date and skips no gate.
    52	#   --restamp        force the four `last-reviewed:` stamps to move even when
    53	#                    the version is unchanged — the named route for a REAL
    54	#                    re-review. Requires --npm-readme-reviewed and disables the
    55	#                    no-op fast path (otherwise it would be dead letter).
    56	#   --offline-ack    ancestry guard: skip the `git fetch` and judge HEAD
    57	#                    against the last-known origin/main (announced loudly)
    58	#   --npm-readme-reviewed
    59	#                    required by `bump` when it writes: acknowledges that
    60	#                    npm/README.md was actually re-read. Its `last-reviewed`
    61	#                    stamp is a release tripwire by design; re-stamping it
    62	#                    silently would defeat the gate.
    63	# ============================================================================
    64	set -euo pipefail
    65	
    66	# ---------------------------------------------------------------------------
    67	# PER-RELEASE — the only block that changes between releases. Rewrite all of it
    68	# together. RELEASE_SCOPE and RELEASE_HEADLINE end up inside the SIGNED tag
    69	# annotation, so stale text there is a false claim on a signed surface (the P0
    70	# class of this repo) — and no preflight can prove prose matches a diff.
    71	# The tag stands for the WHOLE release train in CHANGELOG.md, never just the
    72	# newest plan: list every plan of the train and the full ADR range.
    73	# ---------------------------------------------------------------------------
    74	TARGET_BASE="1.3.0"
    75	RELEASE_TITLE="night-mode + release-mechanics hardening"
    76	RELEASE_SCOPE="PLAN-162 / PLAN-165 / PLAN-166 (ADRs 184 -> 189)"
    77	RELEASE_HEADLINE="night-mode — the Owner arms per-machine autonomy for one upcoming
    78	session (gitignored overlay, next-session semantics), and arming it is a
    79	HUMAN action by construction: the writer script self-path-guards, the Bash
    80	rail matches invocation best-effort, and every on/off/refusal lands in the
    81	HMAC chain as night_mode_toggled (proven live, not by fixture).
    82	
    83	Also: a case-fold bypass that let .claude/settings.JSON slip past BOTH the
    84	canonical and kernel rails on case-insensitive filesystems (P0, fixed on
    85	both rails); ADR-186 settles the hook-deadline conflict — the canonical
    86	matcher wall deadline fails CLOSED as a named exception to the published
    87	fail-open-on-infrastructure contract, with a provenance-pinned unlock as the
    88	recovery route; sentinel unlock inside a git worktree now REQUIRES that
    89	provenance (ADR-119 Invariant 5); pair-rail 120/150 -> 180/210 with
    90	timeout_ms and a censoring-rate trigger, ratified only after a live probe
    91	proved the harness honors a 210 s registration; four scheduled workflows that
    92	had been red without ever surfacing in push CI; and the release mechanics
    93	themselves — an idempotent bump, plus an ancestry gate and a restricted-delta
    94	gate on the tag phase (PLAN-166)."
    95	
    96	RC_NUM="1"
    97	STABLE=0
    98	DRY_RUN=0
    99	NPM_README_REVIEWED=0
   100	RESTAMP=0
   101	OFFLINE_ACK=0
   102	TODAY=""
   103	PHASE=""
   104	
   105	BUMP_SITES=".claude/scripts/local/_release_bump_sites.py"
   106	TAG_GUARD=".claude/scripts/local/_release_tag_guard.py"
   107	
   108	# Continuity: the key that signed the previous release. Overridable, but never
   109	# guessed at signing time — the preflight proves it can actually produce a
   110	# signature.
   111	SIGN_KEY="CFCFACF00335DC74"
   112	
   113	die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
   114	ok()  { printf '  ok   %s\n' "$*"; }
   115	note(){ printf '  --   %s\n' "$*"; }
   116	hdr() { printf '\n== %s ==\n' "$*"; }
   117	
   118	usage() {
   119	  cat <<USAGE
   120	release.sh — operator release driver (target base version: $TARGET_BASE)
   121	
   122	  bash $0 preflight [--rc N | --stable]
   123	  bash $0 bump      [--rc N | --stable] --npm-readme-reviewed [--dry-run]
   124	  bash $0 tag       [--rc N | --stable] [--dry-run]
   125	
   126	  --dry-run              no lasting change; tree AND index restored on exit
   127	  --stable               target $TARGET_BASE (post-hold promote)
   128	  --rc N                 target ${TARGET_BASE}-rc.N (default N=$RC_NUM)
   129	  --key KEYID            GPG key (default $SIGN_KEY)
   130	  --today YYYY-MM-DD     date stamped into the last-reviewed lines
   131	  --restamp              move the review stamps at an unchanged version
   132	                         (requires --npm-readme-reviewed)
   133	  --offline-ack          ancestry guard judges a possibly stale origin/main
   134	  --npm-readme-reviewed  assert npm/README.md was actually re-read
   135	
   136	The header of this file documents what the Owner signs, why this script never
   137	pushes, and why it never publishes.
   138	USAGE
   139	}
   140	
   141	while [ "$#" -gt 0 ]; do
   142	  case "$1" in
   143	    preflight|bump|tag) PHASE="$1"; shift ;;
   144	    --dry-run) DRY_RUN=1; shift ;;
   145	    --stable)  STABLE=1; shift ;;
   146	    --npm-readme-reviewed) NPM_README_REVIEWED=1; shift ;;
   147	    --restamp) RESTAMP=1; shift ;;
   148	    --offline-ack) OFFLINE_ACK=1; shift ;;
   149	    --today)   TODAY="${2:?--today needs YYYY-MM-DD}"; shift 2 ;;
   150	    --rc)      RC_NUM="${2:?--rc needs a number}"; shift 2 ;;
   151	    --key)     SIGN_KEY="${2:?--key needs a keyid}"; shift 2 ;;
   152	    -h|--help) usage; exit 0 ;;
   153	    *) die "unknown argument: $1" ;;
   154	  esac
   155	done
   156	[ -n "$PHASE" ] || die "no phase given (preflight|bump|tag); see --help"
   157	
   158	if [ -n "$TODAY" ]; then
   159	  case "$TODAY" in
   160	    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
   161	    *) die "--today must be YYYY-MM-DD, got '$TODAY'" ;;
   162	  esac
   163	else
   164	  TODAY="$(date +%F)"
   165	fi
   166	
   167	if [ "$STABLE" -eq 1 ]; then
   168	  TARGET_VERSION="$TARGET_BASE"
   169	else
   170	  TARGET_VERSION="${TARGET_BASE}-rc.${RC_NUM}"
   171	fi
   172	TARGET_TAG="v${TARGET_VERSION}"
   173	
   174	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo"
   175	cd "$REPO_ROOT"
   176	
   177	# GPG in a non-interactive shell needs an explicit TTY or pinentry fails with
   178	# a misleading "No pinentry" (recurring footgun in this repo ceremonies).
   179	GPG_TTY="$(tty 2>/dev/null || true)"
   180	export GPG_TTY
   181	
   182	# Every file the bump phase may write — DERIVED, never typed. A hand-kept
   183	# restore list is how a dry-run left debris behind once already (S273): the
   184	# writer grew a site, the restore list did not. `--include-generated` adds the
   185	# two plugin manifests, which `build-plugin.py --write-manifests` rewrites
   186	# from VERSION during the bump.
   187	sites_out="$(python3 "$BUMP_SITES" print-sites --include-generated)" \
   188	  || die "cannot enumerate version sites from $BUMP_SITES"
   189	VERSION_FILES=()
   190	while IFS= read -r _site; do
   191	  [ -n "$_site" ] || continue
   192	  VERSION_FILES+=("$_site")
   193	done <<< "$sites_out"
   194	[ "${#VERSION_FILES[@]}" -gt 0 ] || die "$BUMP_SITES returned no version sites"
   195	
   196	printf 'release driver — target %s (tag %s), phase=%s, dry-run=%s, today=%s\n' \
   197	  "$TARGET_VERSION" "$TARGET_TAG" "$PHASE" "$DRY_RUN" "$TODAY"
   198	
   199	# ---------------------------------------------------------------------------
   200	# Dry-run safety net. Snapshot every file the `bump` phase writes plus the
   201	# index state, and restore both on ANY exit path.
   202	# ---------------------------------------------------------------------------
   203	SNAPSHOT_ARMED=0
   204	restore_snapshot() {
   205	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   206	  # The bump phase refuses to run on a dirty tree (untracked included), so
   207	  # HEAD is exactly the pre-bump state: reset unstages, checkout restores
   208	  # content. Both halves are needed — an index-only restore leaves the files
   209	  # modified, and a content-only restore leaves them staged (the S273 trap).
   210	  #
   211	  # PER PATH, never one multi-path command: `git checkout -- a b c` is
   212	  # ATOMIC — a single path absent from HEAD (a file the bump CREATED, e.g. a
   213	  # plugin manifest on its first appearance) aborts the WHOLE command and
   214	  # restores nothing, and the old `|| true` swallowed that error while the
   215	  # message below still claimed success. A path HEAD carries is checked out;
   216	  # a path HEAD does not carry was created by the bump and is removed.
   217	  local _p _dirty
   218	  for _p in "${VERSION_FILES[@]}"; do
   219	    git reset --quiet HEAD -- "$_p" 2>/dev/null || true
   220	    if git cat-file -e "HEAD:$_p" 2>/dev/null; then
   221	      git checkout --quiet -- "$_p" 2>/dev/null || true
   222	    else
   223	      rm -f "$_p" 2>/dev/null || true
   224	      # a directory created for that file may remain; drop it only if empty
   225	      # (never recursive — this is a restore, not a cleanup)
   226	      rmdir "$(dirname "$_p")" 2>/dev/null || true
   227	    fi
   228	  done
   229	  # ASSERT the postcondition, not the attempt: worktree AND index must be
   230	  # clean across every derived path, or this dry-run left debris and the only
   231	  # honest exit is a loud non-zero — printing "restored" over a dirty tree is
   232	  # the S273 class silenced instead of closed.
   233	  # The verification itself is fail-CLOSED (codex W0-residuals round): if
   234	  # `git status` ERRORS (repo/permission/object failure), an `|| true` here
   235	  # would read as "empty = clean" and print "asserted clean" over a
   236	  # postcondition that was never checked — capture the exit status instead.
   237	  _dirty="$(git status --porcelain -- "${VERSION_FILES[@]}" 2>/dev/null)"
   238	  _status_rc=$?
   239	  if [ "$_status_rc" -ne 0 ]; then
   240	    printf 'FAIL: dry-run restore verification could not run (git status rc=%s) — tree state UNVERIFIED, refusing to report clean\n' "$_status_rc" >&2
   241	    exit 1
   242	  fi
   243	  if [ -n "$_dirty" ]; then
   244	    printf 'FAIL: dry-run restore left these paths dirty (worktree/index != HEAD):\n' >&2
   245	    printf '%s\n' "$_dirty" >&2
   246	    exit 1
   247	  fi
   248	  printf '  --   dry-run: working tree AND index restored to HEAD (asserted clean)\n'
   249	}
   250	
   251	take_snapshot() {
   252	  SNAPSHOT_ARMED=1
   253	  trap restore_snapshot EXIT INT TERM
   254	}
   255	
   256	hint_next_phase() {
   257	  # Test the VALUE: `${STABLE:+...}` expands for STABLE=0 (a non-empty string)
   258	  # and would tell the Owner to cut the STABLE tag during an RC run.
   259	  if [ "$STABLE" -eq 1 ]; then
   260	    note "proceed to: bash $0 tag --stable"
   261	  else
   262	    note "proceed to: bash $0 tag --rc $RC_NUM"
   263	  fi
   264	}
   265	
   266	# ---------------------------------------------------------------------------
   267	# Preflight — every gate fail-closed. Mirrors `.github/release-checklist.md`
   268	# and runs the SAME suites CI runs (a subset gate passes while CI is red; that
   269	# lesson is expensive and already paid).
   270	# ---------------------------------------------------------------------------
   271	preflight() {
   272	  hdr "git state"
   273	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — commit or stash first"
   274	  ok "tree clean"
   275	
   276	  branch="$(git rev-parse --abbrev-ref HEAD)"
   277	  [ "$branch" = "main" ] || die "on branch '$branch' — releases are cut from main"
   278	  ok "on main"
   279	
   280	  git fetch --quiet origin main || die "git fetch origin main failed"
   281	  local_sha="$(git rev-parse HEAD)"
   282	  remote_sha="$(git rev-parse origin/main)"
   283	  [ "$local_sha" = "$remote_sha" ] \
   284	    || die "HEAD ($local_sha) != origin/main ($remote_sha) — push or pull first"
   285	  ok "HEAD == origin/main ($local_sha)"
   286	
   287	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   288	    && die "tag $TARGET_TAG already exists"
   289	  ok "tag $TARGET_TAG is free"
   290	
   291	  hdr "CI for HEAD"
   292	  if command -v gh >/dev/null 2>&1; then
   293	    runs="$(gh run list --limit 40 \
   294	      --json headSha,conclusion,status,workflowName 2>/dev/null || true)"
   295	    if [ -n "$runs" ]; then
   296	      verdict="$(mktemp)"
   297	      printf '%s' "$runs" | HEAD_SHA="$local_sha" python3 -c '
   298	import json, os, sys
   299	sha = os.environ["HEAD_SHA"]
   300	runs = [r for r in json.load(sys.stdin) if r.get("headSha") == sha]
   301	if not runs:
   302	    print("NO_RUNS"); sys.exit(0)
   303	bad = [r for r in runs if r.get("conclusion") not in ("success", "skipped", "")]
   304	pend = [r for r in runs if r.get("status") != "completed"]
   305	val = [r for r in runs if "Validate" in (r.get("workflowName") or "")]
   306	for r in bad:
   307	    print("BAD %s=%s" % (r["workflowName"], r["conclusion"]))
   308	for r in pend:
   309	    print("PENDING %s" % r["workflowName"])
   310	if not any(r.get("conclusion") == "success" for r in val):
   311	    print("NO_VALIDATE_SUCCESS")
   312	' > "$verdict" || die "CI verdict parse failed"
   313	      if grep -q '^BAD ' "$verdict"; then
   314	        cat "$verdict" >&2; rm -f "$verdict"
   315	        die "a workflow for HEAD is not green"
   316	      fi
   317	      if grep -q '^PENDING ' "$verdict"; then
   318	        cat "$verdict" >&2; rm -f "$verdict"
   319	        die "a workflow for HEAD is still running — wait for it"
   320	      fi
   321	      if grep -q 'NO_VALIDATE_SUCCESS' "$verdict"; then
   322	        rm -f "$verdict"
   323	        die "no successful Validate run for HEAD"
   324	      fi
   325	      if grep -q 'NO_RUNS' "$verdict"; then
   326	        rm -f "$verdict"
   327	        die "no CI runs found for HEAD — push it and let CI run"
   328	      fi
   329	      rm -f "$verdict"
   330	      ok "all workflows for HEAD green (Validate success)"
   331	    else
   332	      die "gh returned no run data — cannot confirm CI (fail-closed)"
   333	    fi
   334	  else
   335	    die "gh CLI not available — cannot confirm CI (fail-closed)"
   336	  fi
   337	
   338	  # These MUST be the invocations validate.yml uses, not `unittest discover`.
   339	  # The suite is pytest-only BY CONSTRUCTION: conftest.py carries the sys.path
   340	  # bootstrap and the _lib resolution guards as pytest collection hooks, and
   341	  # several modules isolate their environment with pytest `autouse` fixtures.
   342	  # `unittest discover` loads none of that, so those modules run with their
   343	  # declared isolation silently disabled — which leaks CLAUDE_PROJECT_DIR into
   344	  # later modules. test_flip_closures then resolves settings.json /
   345	  # red-team.yml under a dead tmp dir and reports that files which plainly
   346	  # exist "must exist". It passes 12/12 when run alone. Diagnosed 2026-08-02
   347	  # during a GA promote; the old invocation made this gate a FALSE RED that
   348	  # blocked a release whose CI was green.
   349	  hdr "test suites (the same ones CI runs)"
   350	  python3 -m pytest .claude/hooks/tests/ -n auto -m 'not serial' \
   351	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   352	    || die "hooks test suite failed (not serial)"
   353	  python3 -m pytest .claude/hooks/tests/ -m 'serial' \
   354	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   355	    || die "hooks test suite failed (serial)"
   356	  ok "hooks tests pass"
   357	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   358	    -n auto -m 'not serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   359	    || die "scripts test suite failed (not serial)"
   360	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   361	    -m 'serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   362	    || die "scripts test suite failed (serial)"
   363	  ok "scripts tests pass"
   364	
   365	  hdr "governance gates"
   366	  bash .claude/scripts/validate-governance.sh >/dev/null 2>&1 \
   367	    || die "validate-governance.sh nonzero"
   368	  ok "validate-governance"
   369	  bash .claude/scripts/check-contamination.sh >/dev/null 2>&1 \
   370	    || die "check-contamination.sh nonzero"
   371	  ok "check-contamination"
   372	  python3 .claude/scripts/check-claude-md-claims.py >/dev/null 2>&1 \
   373	    || die "check-claude-md-claims.py nonzero"
   374	  ok "CLAUDE.md claims"
   375	  bash .claude/scripts/local/verify-counts.sh --quiet >/dev/null 2>&1 \
   376	    || die "verify-counts.sh reports drift"
   377	  ok "derived counts (no drift)"
   378	
   379	  hdr "release artifacts"
   380	  grep -q "^## \[${TARGET_BASE}\]" CHANGELOG.md \
   381	    || die "CHANGELOG.md has no '## [${TARGET_BASE}]' entry"
   382	  ok "CHANGELOG has [${TARGET_BASE}]"
   383	
   384	  # Two gates that burned earlier RCs — release.yml enforces both and neither
   385	  # is covered by verify-counts, so the preflight mirrors them:
   386	  python3 scripts/build-plugin.py --check >/dev/null 2>&1 \
   387	    || die "plugin manifests out of sync (run: python3 scripts/build-plugin.py --write-manifests)"
   388	  ok "plugin manifests in sync with generator"
   389	  python3 .claude/scripts/check-canonical-doc-freshness.py >/dev/null 2>&1 \
   390	    || {
   391	      python3 .claude/scripts/check-canonical-doc-freshness.py 2>&1 | grep '!!' >&2 || true
   392	      die "canonical doc freshness gate red (stale last-reviewed stamps; review + re-stamp the docs listed above)"
   393	    }
   394	  ok "canonical doc freshness (review stamps current)"
   395	
   396	  cur_version="$(tr -d ' \n' < VERSION)"
   397	  if [ "$cur_version" = "$TARGET_BASE" ]; then
   398	    note "VERSION already $TARGET_BASE — bump phase is a no-op (expected on promote)"
   399	  else
   400	    note "VERSION is $cur_version, becomes $TARGET_BASE in the bump phase"
   401	  fi
   402	
   403	  hdr "signing key (proves it can actually sign — not just that it exists)"
   404	  gpg --list-secret-keys "$SIGN_KEY" >/dev/null 2>&1 \
