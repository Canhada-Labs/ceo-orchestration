   613	class TestPtBrLabelControls(unittest.TestCase):
   614	    """PLAN-166 W0 AC-5 positive controls, pt-BR leg (W0 re-pass round 2).
   615	
   616	    The _EXPECTED_SITES manifest proves the pt-BR matchers MATCH (liveness:
   617	    _note() fires before the enforce branch) — it does NOT prove a match
   618	    ENFORCES. A kind-binding bug could keep the manifest green while
   619	    enforcement silently died. These controls plant a WRONG number at every
   620	    watched pt-BR label/phrasing of README.pt-BR.md and demand one named
   621	    violation per plant, preceded by a clean-control run so each failure is
   622	    attributable to its plant, not to the phrasing.
   623	
   624	    The metric list is DERIVED from the manifest keys ending in
   625	    '@README.pt-BR.md' — never a recalled list (the numeral-espelho lesson:
   626	    recited enumerations failed 4x in this plan) — so ratifying a new pt
   627	    site into the manifest without adding its control phrasing fails here
   628	    first, in the coverage test below.
   629	    """
   630	
   631	    _PT_DOC = "README.pt-BR.md"
   632	
   633	    # metric -> snippet factory carrying that metric's watched pt-BR
   634	    # phrasing(s) with the given (planted) value. Phrasings mirror the live
   635	    # sites in README.pt-BR.md: the four pt table labels (Checklists de
   636	    # skills / Scripts de hook / Hooks ligados em / Módulos de biblioteca
   637	    # compartilhada) and the pt prose forms (arquivos de skill / em disco /
   638	    # ligados / registros de evento / core-frontend-de domínio split /
   639	    # SPEC-v1 arquivos / `*.schema.md` / '# N ADRs' / N slash commands).
   640	    _EXACT_PLANTS = {
   641	        "skills": lambda v: (
   642	            "| Checklists de skills | **%d** | x |\n"
   643	            "entrega **%d arquivos de skill** reutilizáveis.\n" % (v, v)),
   644	        "core": lambda v: "organizadas em %d core + outros tiers.\n" % v,
   645	        "frontend": lambda v: "mais %d frontend + o resto.\n" % v,
   646	        "domain": lambda v: "e + %d de domínio no total.\n" % v,
   647	        "adrs": lambda v: "ls .claude/adr  # %d ADRs\n" % v,
   648	        "commands": lambda v: (
   649	            "%d slash commands em `.claude/commands/`.\n" % v),
   650	        "hook_py": lambda v: (
   651	            "| Scripts de hook (em disco) | **%d** | x |\n"
   652	            "a diferença entre **%d em disco** e os ligados.\n" % (v, v)),
   653	        "registered": lambda v: (
   654	            "| Hooks ligados em `settings.json` | **%d** | x |\n"
   655	            "são **%d ligados** no total.\n" % (v, v)),
   656	        "registrations": lambda v: "com %d registros de evento.\n" % v,
   657	        "lib": lambda v: (
   658	            "| Módulos de biblioteca compartilhada | **%d** | x |\n" % v),
   659	        "spec_v1": lambda v: (
   660	            "contrato em `SPEC/v1/` (%d arquivos — fixado).\n" % v),
   661	        "schema_files": lambda v: (
   662	            "sendo %d `*.schema.md` de contrato.\n" % v),
   663	    }
   664	    # `tests` is approx-kind: a wrong EXACT integer is a different rule, so
   665	    # its control is the out-of-band ~Nk plant below.
   666	    _APPROX_CONTROLLED = {"tests"}
   667	
   668	    def test_pt_control_coverage_is_derived_from_manifest(self):
   669	        """Every metric the ratified manifest watches at README.pt-BR.md has
   670	        a planted control here — and no control exists for an unwatched
   671	        metric. Derived from _EXPECTED_SITES, never recited."""
   672	        derived = sorted(set(
   673	            k.split("@")[0] for k in TestVerifyCounts._EXPECTED_SITES
   674	            if k.endswith("@" + self._PT_DOC)))
   675	        covered = sorted(set(self._EXACT_PLANTS) | self._APPROX_CONTROLLED)
   676	        self.assertEqual(
   677	            covered, derived,
   678	            "pt-BR positive-control coverage drifted from the ratified "
   679	            "manifest: every metric watched at README.pt-BR.md needs a "
   680	            "planted control (and none may be invented).")
