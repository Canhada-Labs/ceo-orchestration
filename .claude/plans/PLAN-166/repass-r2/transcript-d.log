   647	def test_dry_run_restores_when_a_derived_site_is_absent_from_head(synth):
   648	    """W0 re-pass r2 P1: `git checkout -- <all paths>` is ATOMIC — one path
   649	    absent from HEAD (a file the bump CREATED, e.g. a plugin manifest on its
   650	    first appearance) aborts the whole restore, `|| true` swallowed the error,
   651	    and the trap still printed "restored to HEAD" over a fully dirty tree.
   652	    The restore must be per-path (checkout what HEAD has, remove what the
   653	    bump created) and the trap must ASSERT the postcondition, not the
   654	    attempt."""
   655	    repo, env = synth["repo"], synth["env"]
   656	    write_sites(repo, "1.2.0", D0)
