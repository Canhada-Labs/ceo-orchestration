   107	      # dispatch via subagent_type=general-purpose to bypass H4 rail
   108	      # anomaly (custom subagent_types qa/pe/se/devops receive only
   109	      # Grep+Glob from runtime despite frontmatter declaring full tools).
   110	      # Persona is injected via ## SKILL CONTENT; general-purpose has
   111	      # full tool universe (Bash+Edit+Read+Write+...).
   112	      DISPATCH_MODE_FROM_FLAG="mitigated"
   113	      shift
   114	      ;;
   115	    --dispatch=native)
   116	      DISPATCH_MODE_FROM_FLAG="native"
   117	      shift
   118	      ;;
   119	    --pair-mode)
   120	      PAIR_MODE=1
   121	      shift
   122	      ;;
   123	    --coder=*)
   124	      PAIR_CODER_OVERRIDE="${1#--coder=}"
   125	      shift
   126	      ;;
   127	    --reviewer=*)
   128	      PAIR_REVIEWER_OVERRIDE="${1#--reviewer=}"
   129	      shift
   130	      ;;
   131	  esac
   132	done
   133	
   134	# Honor CEO_SOTA_DISABLE master kill — forces inline regardless of flag.
   135	if [ "${CEO_SOTA_DISABLE:-}" = "1" ]; then
   136	  SKILL_INJECTION_MODE="inline"
   137	fi
   138	# Honor CEO_SKILL_REFERENCE_MODE=0 explicit opt-out.
   139	if [ "${CEO_SKILL_REFERENCE_MODE:-}" = "0" ]; then
