   209	    def test_threshold_boundary_exact_0_7(self):
   210	        # Build a 7/10 overlap: 7 shared + 3 unique each side -> Jaccard = 7/13 ~= 0.538
   211	        # Easier: 7 shared + 0 unique -> 1.0; craft 7 shared + 3 unique in one to get 0.7.
   212	        # 7 shared, 3 unique in round-2 only: |inter|=7 |union|=10 -> 0.7 exact.
   213	        tmp = Path(tempfile.mkdtemp(prefix="rt-boundary-"))
