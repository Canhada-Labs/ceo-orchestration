   315	def _parse(argv: List[str]) -> argparse.Namespace:
   316	    p = argparse.ArgumentParser(
   317	        description="Compute Jaccard convergence for a debate round"
   318	    )
   319	    p.add_argument("--plan", required=True, help="Plan ID (PLAN-NNN)")
   320	    p.add_argument(
   321	        "--round",
   322	        type=int,
   323	        required=True,
   324	        dest="round_num",
   325	        help="Round number (>= 2)",
   326	    )
   327	    p.add_argument(
   328	        "--plans-root",
   329	        type=str,
   330	        default=None,
   331	        help="Override plans root (defaults to ../plans relative to this script)",
   332	    )
   333	    p.add_argument(
   334	        "--threshold",
   335	        type=float,
   336	        default=DEFAULT_JACCARD_THRESHOLD,
   337	        help=f"Jaccard threshold for convergence (default {DEFAULT_JACCARD_THRESHOLD})",
   338	    )
   339	    return p.parse_args(argv)
   340	
   341	
   342	def main(argv: Optional[List[str]] = None) -> int:
   343	    """CLI entrypoint — compute Jaccard convergence across debate rounds."""
   344	    args = _parse(argv if argv is not None else sys.argv[1:])
   345	    if args.round_num < 2:
   346	        print(
   347	            f"ERROR: --round must be >= 2 (got {args.round_num})",
   348	            file=sys.stderr,
   349	        )
   350	        return 1
   351	    if not re.match(r"^PLAN-[0-9]{3}$", args.plan):
   352	        print(
   353	            f"ERROR: --plan must match PLAN-NNN (got {args.plan!r})",
   354	            file=sys.stderr,
   355	        )
   356	        return 1
   357	
   358	    plans_root = (
   359	        Path(args.plans_root).resolve() if args.plans_root else _plans_root_default()
   360	    )
   361	
   362	    try:
   363	        result = compute_convergence(
   364	            plans_root, args.plan, args.round_num, threshold=args.threshold
   365	        )
   366	    except FileNotFoundError as e:
   367	        print(f"ERROR: {e}", file=sys.stderr)
   368	        return 1
   369	    except RisksSectionEmptyError as e:
   370	        # W2.9(i) fail-closed: a critique with a Risks heading and zero
   371	        # parseable bullets is an input-parse failure, never a silent zero.
   372	        # Exit 4 is distinct so orchestrators can tell "fix the critique
   373	        # format" apart from convergence outcomes.
   374	        print(f"ERROR: {e}", file=sys.stderr)
   375	        return 4
   376	
   377	    if result.get("zero_coverage"):
   378	        # Still print the JSON (machine-readable) and exit 2
   379	        print(json.dumps(result, sort_keys=True))
   380	        return 2

