   678	def test_fetch_failure_and_non_ancestor_are_DISTINCT(synth):
   679	    repo, env = synth["repo"], synth["env"]
   680	
   681	    # (1) origin unreachable — the check did NOT run; this is not a verdict
   682	    git(repo, env, "remote", "set-url", "origin", str(repo.parent / "does-not-exist"))
   683	    broken = guard(synth, "ancestry", "--repo", str(repo))
   684	    assert broken.returncode == tag_guard.E_FETCH, broken.stderr
   685	    assert "could not talk to origin" in broken.stderr
   686	    assert "--offline-ack" in broken.stderr
   687	
   688	    # (2) origin reachable, HEAD unpushed — a real governance stop
   689	    git(repo, env, "remote", "set-url", "origin", str(synth["origin"]))
   690	    (repo / "late.txt").write_text("landed after CI\n", encoding="utf-8")
   691	    git(repo, env, "add", "late.txt")
   692	    git(repo, env, "commit", "-q", "-m", "unpushed")
   693	    stop = guard(synth, "ancestry", "--repo", str(repo))
   694	    assert stop.returncode == tag_guard.E_NOT_ANCESTOR, stop.stderr
   695	    assert "not an ancestor" in stop.stderr
   696	    assert "could not talk to origin" not in stop.stderr
   697	
   698	    # the two failures do not share an exit code — the MODE is distinguishable
   699	    assert tag_guard.E_FETCH != tag_guard.E_NOT_ANCESTOR
