    55	def _load(path: Path, name: str):
    56	    spec = importlib.util.spec_from_file_location(name, str(path))
    57	    assert spec and spec.loader, path
    58	    mod = importlib.util.module_from_spec(spec)
    59	    spec.loader.exec_module(mod)
    60	    return mod
    61	
    62	
    63	bump_sites = _load(SITES_SRC, "_release_bump_sites_under_test")
    64	tag_guard = _load(GUARD_SRC, "_release_tag_guard_under_test")
