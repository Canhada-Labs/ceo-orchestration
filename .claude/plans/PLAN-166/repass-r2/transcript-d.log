   230	                + "\n".join(f"- {s}" for s in shared + unique)
   231	                + "\n",
   232	                encoding="utf-8",
   233	            )
   234	            result = dc.compute_convergence(tmp, "PLAN-999", 2, threshold=0.7)
   235	            self.assertAlmostEqual(result["jaccard"], 0.7, places=3)
   236	            self.assertTrue(result["converged"])  # >= 0.7 is converged
   237	        finally:
   238	            shutil.rmtree(tmp, ignore_errors=True)
