     2	# ============================================================================
     3	# _release_bump_sites.py — the ONE source of truth for the release version
     4	# sites, and the only writer of them.
     5	#
     6	# Why a module and not a heredoc. Until PLAN-166/W0 this table lived inside
     7	# `release.sh` as a `python3 - <<'PY'` heredoc. That had two costs that both
     8	# showed up in the v1.3.0-rc.1 re-pass:
     9	#
    10	#   1. the site list existed TWICE — once in the heredoc (the writer) and once
    11	#      in the driver's `VERSION_FILES` array (the dry-run restore list). A list
    12	#      that must match another list by hand does not stay matched; a restore
    13	#      list shorter than the write list leaves debris (the S273 class).
    14	#   2. it was untestable. `--today` could not be pinned, so the D+1
    15	#      non-idempotence (F2) could not be exercised by a test.
    16	#
    17	# Both are closed here: the driver DERIVES its restore list from
    18	# `print-sites --include-generated`, and `--today` is a REQUIRED parameter with
    19	# NO DEFAULT (a parameter that changes the verdict never has a default —
    20	# frozen-evidence lesson).
    21	#
    22	# Idempotence contract (F2). A `last-reviewed:` stamp asserts "this document
    23	# was re-read FOR THIS RELEASE". Re-dating it without re-reading is a false
    24	# claim on a surface that a signed tag then covers. So the stamp sites
    25	# skip the ENTIRE line — neither date nor version — when the version already
    26	# on the stamp is the target. `--restamp` is the named, explicit route for a
    27	# real re-review.
    28	#
    29	# The two stamp oracles (do not collapse them). `npm/README.md` is watched by
    30	# verify-counts' VERSION_SITES; SBOM.md / SECURITY.md / VERSIONING.md are
    31	# watched ONLY by check-canonical-doc-freshness.py. Both oracles decide on the
    32	# VERSION in the stamp, never on the date — which is what makes freezing the
    33	# date safe.
    34	#
    35	# The support window (kinds "minor"/"prev_minor" — v1.3.0 re-pass, F-sites).
    36	# verify-counts' VERSION_SITES also watches "Current MINOR (vX.Y.x)" and
    37	# "Previous MINOR (vX.Y.x)" in SECURITY.md and VERSIONING.md (S293). Those
    38	# sites were OUTSIDE this table at birth, so the next MINOR bump would write
    39	# everything else, then DIE at the driver's own verify-counts call with a
    40	# half-written tree (outside --dry-run there is no restore trap). The rule the
    41	# oracle enforces is mechanical — Current = the target's minor, Previous = the
    42	# minor immediately before it — so this writer derives both from --target and
    43	# the "ONE source of truth" claim above stays true. The single non-derivable
    44	# case, an X.0.0 target, is SKIPPED loudly and never guessed: the oracle
    45	# cannot value-check it either (it derives prev="" at X.0), and a MAJOR
    46	# support-window transition is release-train judgment, not sed.
    47	# ============================================================================
    48	"""Release version-site table + writer (stdlib only, Python >= 3.9)."""
    49	
    50	from __future__ import annotations
    51	
    52	import argparse
    53	import os
    54	import re
    55	import sys
    56	from typing import Callable, List, Optional, Sequence, Tuple
    57	
    58	SEMVER = r"\d+\.\d+\.\d+"
    59	STAMP_RX = r"(last-reviewed: )(\d{4}-\d{2}-\d{2})( +v)(" + SEMVER + r")"
    60	DATE_RX = re.compile(r"\A\d{4}-\d{2}-\d{2}\Z")
    61	
    62	# Kinds:
    63	#   "plain"      — literal regex substitution, no stamp semantics.
    64	#   "stamp"      — "last-reviewed: <date> v<version>"; skipped wholesale when
    65	#                  the version already equals the target (unless --restamp).
    66	#   "minor"      — support-window site carrying the TARGET's minor (vX.Y.x).
    67	#   "prev_minor" — support-window site carrying the minor immediately BEFORE
    68	#                  the target; not derivable at X.0.0 (skipped loudly there).
    69	PLAIN = "plain"
    70	STAMP = "stamp"
    71	MINOR = "minor"
    72	PREV_MINOR = "prev_minor"
    73	
    74	# (path, kind, pattern) — patterns anchored exactly as their oracle checks
    75	# them, so historical version mentions elsewhere in the file are never touched.
    76	_SITES: List[Tuple[str, str, str]] = [
    77	    ("VERSION", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    78	    # PLAN-169 W2.6 (ledger E.1/F.7/A.0.4): the install-state marker is the
    79	    # surface check-framework-updates.sh reads MARKER-FIRST — a bump that
    80	    # skips it leaves every adopter's updater reporting behind-minor
    81	    # forever. Joins _SITES with its oracle mirror in verify-counts
    82	    # VERSION_SITES (no census numeral here: the F6 guard forbids
    83	    # site-count claims in comments, ordinals included).
    84	    (".claude/.framework-version", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    85	    ("npm/package.json", PLAIN, r'("version"\s*:\s*")' + SEMVER + r'(")'),
    86	    ("pyproject.toml", PLAIN, r'(?m)^(version\s*=\s*")' + SEMVER + r'(")'),
    87	    ("INSTALL.md", PLAIN, r"(--pin v)" + SEMVER),
    88	    (
    89	        "docs/ARCHITECTURE.md",
    90	        PLAIN,
    91	        r"(currently\s+v)" + SEMVER + r"(, aligned with the repo)",
    92	    ),
    93	    # README.md and CLAUDE.md are deliberately NOT rows here: neither is a
    94	    # version site. `VERSION=` never existed in either (verify-counts dropped
    95	    # its dead rules for both in S291 — `git log -S 'VERSION='` finds no
    96	    # commit that added one — and the release checklist states the same). A
    97	    # writer row for a site no oracle watches would be that dead rule
    98	    # reintroduced on the WRITE side: the day someone adds a `VERSION=` line
    99	    # to README.md, the bump would rewrite a file every other surface
   100	    # declares out of scope.
   101	    ("SBOM.md", PLAIN, r"(\*\*Version:\*\* `)" + SEMVER + r"(`)"),
   102	    # --- the support window (oracle: verify-counts VERSION_SITES modes
   103	    #     "minor"/"prev_minor", S293). Patterns anchored exactly as the
   104	    #     oracle's — SECURITY.md bolds the label, VERSIONING.md does not. ---
   105	    ("SECURITY.md", MINOR, r"(\*\*Current MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   106	    ("VERSIONING.md", MINOR, r"(Current MINOR \(`v)\d+\.\d+(\.x`\))"),
   107	    ("SECURITY.md", PREV_MINOR, r"(\*\*Previous MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   108	    ("VERSIONING.md", PREV_MINOR, r"(Previous MINOR \(`v)\d+\.\d+(\.x`\))"),
   109	    # --- the review stamps (idempotence-critical; the table IS the census,
   110	    #     a numeral here would be a mirror that drifts) ---
   111	    ("npm/README.md", STAMP, STAMP_RX),
   112	    ("SBOM.md", STAMP, STAMP_RX),
   113	    ("SECURITY.md", STAMP, STAMP_RX),
   114	    ("VERSIONING.md", STAMP, STAMP_RX),
   115	]
   116	
   117	# Written by the bump PHASE but not by this module: `build-plugin.py
   118	# --write-manifests` regenerates them from VERSION. They belong in any
   119	# derived restore/guard list, which is why they are exported here instead of
   120	# being re-typed by every caller (the duplicated-list failure this module
   121	# exists to kill).
   122	GENERATED_BY_BUMP: List[str] = [
   123	    ".claude-plugin/plugin.json",
   124	    ".claude-plugin/marketplace.json",
   125	]
   126	
   127	
   128	def site_paths(include_generated: bool = False) -> List[str]:
   129	    """Every path this module may write, de-duplicated, in table order."""
   130	    out: List[str] = []
   131	    for path, _kind, _rx in _SITES:
   132	        if path not in out:
   133	            out.append(path)
   134	    if include_generated:
   135	        for path in GENERATED_BY_BUMP:
   136	            if path not in out:
   137	                out.append(path)
   138	    return out
   139	
   140	
   141	def _plain_replacement(pattern: str, target: str) -> str:
   142	    """Replacement string for a PLAIN site, rebuilt from its group count."""
   143	    if pattern.startswith(r"\A"):  # the bare VERSION file
   144	        return target + "\n"
   145	    groups = re.compile(pattern).groups
   146	    if groups == 0:
   147	        return target
   148	    if groups == 1:
   149	        return r"\g<1>" + target
   150	    return r"\g<1>" + target + r"\g<2>"
   151	
   152	
   153	def _stamp_replacer(
   154	    target: str, today: str, restamp: bool
   155	) -> Callable[["re.Match"], str]:
   156	    def _repl(m: "re.Match") -> str:
   157	        if not restamp and m.group(4) == target:
   158	            # Defense in depth: the whole line is left byte-identical. Both
   159	            # stamp oracles read the VERSION, so freezing the date costs
   160	            # nothing and re-dating without re-reading would be a false claim.
   161	            return m.group(0)
   162	        return m.group(1) + today + m.group(3) + target
   163	
   164	    return _repl
   165	
   166	
   167	def bump(
   168	    target: str,
   169	    today: str,
   170	    *,
   171	    restamp: bool = False,
   172	    root: Optional[str] = None,
   173	    out=None,
   174	) -> int:
   175	    """Rewrite every version site to `target`. Returns files CHANGED."""
   176	    if not DATE_RX.match(today):
   177	        raise ValueError("--today must be YYYY-MM-DD, got %r" % (today,))
   178	    if not re.match(r"\A" + SEMVER + r"\Z", target):
   179	        raise ValueError("--target must be a bare semver, got %r" % (target,))
   180	    stream = out if out is not None else sys.stdout
   181	    base = root or os.getcwd()
   182	    # Support-window derivation, BEFORE any byte is written: whether every
   183	    # site is writable is decided up front, never discovered mid-loop with a
   184	    # half-bumped tree behind it.
   185	    _maj, _min = (int(x) for x in target.split(".")[:2])
   186	    minor_target = "%d.%d" % (_maj, _min)
   187	    prev_minor = "%d.%d" % (_maj, _min - 1) if _min > 0 else None
   188	    changed = 0
   189	    for path, kind, pattern in _SITES:
   190	        if kind == PREV_MINOR and prev_minor is None:
   191	            # X.0.0: Previous MINOR is not derivable from the target, and the
   192	            # oracle skips value-checking it there too (prev="" at X.0). Never
   193	            # guess a support-window promise — leave it and say so, loudly.
   194	            print(
   195	                "  !!   %s: Previous MINOR left untouched — not derivable "
   196	                "from %s (X.0.0); the support window needs release-train "
   197	                "judgment here" % (path, target),
   198	                file=stream,
   199	            )
   200	            continue
   201	        full = os.path.join(base, path)
   202	        try:
   203	            with open(full, encoding="utf-8") as fh:
   204	                src = fh.read()
   205	        except OSError:
   206	            print("  --   %s absent, skipped" % path, file=stream)
   207	            continue
   208	        written = target
   209	        if kind == STAMP:
   210	            new, n = re.subn(pattern, _stamp_replacer(target, today, restamp), src)
   211	            label = "review stamp"
   212	        elif kind == MINOR:
   213	            written = minor_target
   214	            new, n = re.subn(pattern, r"\g<1>" + written + r"\g<2>", src)
   215	            label = "support-window (Current MINOR) site"
   216	        elif kind == PREV_MINOR:
   217	            written = prev_minor
   218	            new, n = re.subn(pattern, r"\g<1>" + written + r"\g<2>", src)
   219	            label = "support-window (Previous MINOR) site"
   220	        else:
   221	            new, n = re.subn(pattern, _plain_replacement(pattern, target), src)
   222	            label = "version site"
   223	        if n == 0:
   224	            print(
   225	                "  --   %s: no %s found (ok if unwatched)" % (path, label),
   226	                file=stream,
   227	            )
   228	            continue
   229	        if new == src:
   230	            print(
   231	                "  --   %s: %s already at %s (line untouched)"
   232	                % (path, label, written),
   233	                file=stream,
   234	            )
   235	            continue
   236	        with open(full, "w", encoding="utf-8") as fh:
   237	            fh.write(new)
   238	        changed += 1
   239	        print(
   240	            "  ok   %s (%d %s%s -> %s)"
   241	            % (path, n, label, "" if n == 1 else "s", written),
   242	            file=stream,
   243	        )
   244	    return changed
   245	
   246	
   247	def main(argv: Optional[Sequence[str]] = None) -> int:
   248	    parser = argparse.ArgumentParser(
   249	        prog="_release_bump_sites.py",
   250	        description="Release version-site table + writer (single source).",
   251	    )
   252	    sub = parser.add_subparsers(dest="cmd")
   253	
   254	    p_list = sub.add_parser(
   255	        "print-sites",
   256	        help="print every path the bump may write, one per line",
   257	    )
   258	    p_list.add_argument(
   259	        "--include-generated",
   260	        action="store_true",
   261	        help="also print the plugin manifests regenerated by build-plugin.py",
   262	    )
   263	
   264	    p_bump = sub.add_parser("bump", help="rewrite the version sites")
   265	    # NO DEFAULT, BY CONTRACT. `--today` decides whether a signed
   266	    # "last-reviewed" claim moves; a parameter that changes the verdict is
   267	    # never defaulted (frozen-evidence lesson).
   268	    p_bump.add_argument("--today", required=True, help="YYYY-MM-DD (required)")
   269	    p_bump.add_argument("--target", required=True, help="bare semver, e.g. 1.3.0")
   270	    p_bump.add_argument(
   271	        "--restamp",
   272	        action="store_true",
   273	        help="force the review stamps to move even at the same version",
   274	    )
   275	    p_bump.add_argument("--root", default=None, help="repo root (default: cwd)")
   276	
   277	    args = parser.parse_args(argv)
   278	    if args.cmd == "print-sites":
   279	        for path in site_paths(include_generated=args.include_generated):
   280	            print(path)
   281	        return 0
   282	    if args.cmd == "bump":
   283	        try:
   284	            bump(
   285	                args.target,
   286	                args.today,
   287	                restamp=args.restamp,
   288	                root=args.root,
   289	            )
   290	        except ValueError as exc:
   291	            print("FAIL: %s" % exc, file=sys.stderr)
   292	            return 2
   293	        return 0
   294	    parser.print_usage(sys.stderr)
   295	    return 2
   296	
   297	
   298	if __name__ == "__main__":
   299	    sys.exit(main())
   150	    --restamp) RESTAMP=1; shift ;;
   151	    --offline-ack) OFFLINE_ACK=1; shift ;;
   152	    --today)   TODAY="${2:?--today needs YYYY-MM-DD}"; shift 2 ;;
   153	    --rc)      RC_NUM="${2:?--rc needs a number}"; shift 2 ;;
   154	    --key)     SIGN_KEY="${2:?--key needs a keyid}"; shift 2 ;;
   155	    -h|--help) usage; exit 0 ;;
   156	    *) die "unknown argument: $1" ;;
   157	  esac
   158	done
   159	[ -n "$PHASE" ] || die "no phase given (preflight|bump|tag); see --help"
   160	
   161	if [ -n "$TODAY" ]; then
   162	  case "$TODAY" in
   163	    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
   164	    *) die "--today must be YYYY-MM-DD, got '$TODAY'" ;;
   165	  esac
   166	else
   167	  TODAY="$(date +%F)"
   168	fi
   169	
   170	if [ "$STABLE" -eq 1 ]; then
   171	  TARGET_VERSION="$TARGET_BASE"
   172	else
   173	  TARGET_VERSION="${TARGET_BASE}-rc.${RC_NUM}"
   174	fi
   175	TARGET_TAG="v${TARGET_VERSION}"
   176	
   177	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo"
   178	cd "$REPO_ROOT"
   179	
   180	# GPG in a non-interactive shell needs an explicit TTY or pinentry fails with
   181	# a misleading "No pinentry" (recurring footgun in this repo ceremonies).
   182	GPG_TTY="$(tty 2>/dev/null || true)"
   183	export GPG_TTY
   184	
   185	# Every file the bump phase may write — DERIVED, never typed. A hand-kept
   186	# restore list is how a dry-run left debris behind once already (S273): the
   187	# writer grew a site, the restore list did not. `--include-generated` adds the
   188	# two plugin manifests, which `build-plugin.py --write-manifests` rewrites
   189	# from VERSION during the bump.
   190	sites_out="$(python3 "$BUMP_SITES" print-sites --include-generated)" \
   191	  || die "cannot enumerate version sites from $BUMP_SITES"
   192	VERSION_FILES=()
   193	while IFS= read -r _site; do
   194	  [ -n "$_site" ] || continue
   195	  VERSION_FILES+=("$_site")
   196	done <<< "$sites_out"
   197	[ "${#VERSION_FILES[@]}" -gt 0 ] || die "$BUMP_SITES returned no version sites"
   198	
   199	printf 'release driver — target %s (tag %s), phase=%s, dry-run=%s, today=%s\n' \
   200	  "$TARGET_VERSION" "$TARGET_TAG" "$PHASE" "$DRY_RUN" "$TODAY"
   201	
   202	# ---------------------------------------------------------------------------
   203	# Dry-run safety net. Snapshot every file the `bump` phase writes plus the
   204	# index state, and restore both on ANY exit path.
   205	# ---------------------------------------------------------------------------
   206	SNAPSHOT_ARMED=0
   207	restore_snapshot() {
   208	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   209	  # The bump phase refuses to run on a dirty tree (untracked included), so
   210	  # HEAD is exactly the pre-bump state: reset unstages, checkout restores
   211	  # content. Both halves are needed — an index-only restore leaves the files
   212	  # modified, and a content-only restore leaves them staged (the S273 trap).
   213	  #
   214	  # PER PATH, never one multi-path command: `git checkout -- a b c` is
   215	  # ATOMIC — a single path absent from HEAD (a file the bump CREATED, e.g. a
   216	  # plugin manifest on its first appearance) aborts the WHOLE command and
   217	  # restores nothing, and the old `|| true` swallowed that error while the
   218	  # message below still claimed success. A path HEAD carries is checked out;
   219	  # a path HEAD does not carry was created by the bump and is removed.
   220	  local _p _dirty
   221	  for _p in "${VERSION_FILES[@]}"; do
   222	    git reset --quiet HEAD -- "$_p" 2>/dev/null || true
   223	    if git cat-file -e "HEAD:$_p" 2>/dev/null; then
   224	      git checkout --quiet -- "$_p" 2>/dev/null || true
   225	    else
   226	      rm -f "$_p" 2>/dev/null || true
   227	      # a directory created for that file may remain; drop it only if empty
   228	      # (never recursive — this is a restore, not a cleanup)
   229	      rmdir "$(dirname "$_p")" 2>/dev/null || true
   230	    fi
   231	  done
   232	  # ASSERT the postcondition, not the attempt: worktree AND index must be
   233	  # clean across every derived path, or this dry-run left debris and the only
   234	  # honest exit is a loud non-zero — printing "restored" over a dirty tree is
   235	  # the S273 class silenced instead of closed.
   236	  # The verification itself is fail-CLOSED (codex W0-residuals round): if
   237	  # `git status` ERRORS (repo/permission/object failure), an `|| true` here
   238	  # would read as "empty = clean" and print "asserted clean" over a
   239	  # postcondition that was never checked — capture the exit status instead.
   240	  _dirty="$(git status --porcelain -- "${VERSION_FILES[@]}" 2>/dev/null)"
   241	  _status_rc=$?
   242	  if [ "$_status_rc" -ne 0 ]; then
   243	    printf 'FAIL: dry-run restore verification could not run (git status rc=%s) — tree state UNVERIFIED, refusing to report clean\n' "$_status_rc" >&2
   244	    exit 1
   245	  fi
   246	  if [ -n "$_dirty" ]; then
   247	    printf 'FAIL: dry-run restore left these paths dirty (worktree/index != HEAD):\n' >&2
   248	    printf '%s\n' "$_dirty" >&2
   249	    exit 1
   250	  fi
   430	# The version written is always the BARE semver ($TARGET_BASE), never
   431	# X.Y.Z-rc.N. Two independent reasons: (a) precedent — every previous RC
   432	# carries the bare version in VERSION, the RC lives only in the tag name;
   433	# (b) every gate regex matches `\d+\.\d+\.\d+` only, so an -rc.N string would
   434	# match NOTHING and the gate would pass VACUOUSLY — silently stopping the
   435	# drift check exactly when it matters most.
   436	#
   437	# IDEMPOTENCE (F2, the v1.3.0-rc.1 re-pass). A bump on a tree that is already
   438	# at the target must write NOTHING — not one byte, not one index entry. It
   439	# used to re-date four `last-reviewed:` stamps with today date, which on D+1
   440	# of the ADR-103 hold produced a dirty tree, then a commit made AFTER the
   441	# preflight proved CI green, which `tag()` then signed. That commit was also
   442	# invisible to the pair-rail step 15 (none of the four files is in
   443	# `pair-rail-inputs-hash-manifest.txt`). Two independent defenses now:
   444	#   1. the same-tree predicate below (four oracles) short-circuits the phase;
   445	#   2. the writer skips each stamp line whose version is already the target.
   446	# ---------------------------------------------------------------------------
   447	_oracle() {
   448	  label="$1"; shift
   449	  if "$@" >/dev/null 2>&1; then
   450	    printf '  --   oracle %s: PASS  (%s)\n' "$label" "$*"
   451	    return 0
   452	  fi
   453	  printf '  --   oracle %s: RED   (%s)\n' "$label" "$*"
   454	  return 1
   455	}
   456	
   457	# All four are required. The fourth is not redundant: it is the ONLY watcher
   458	# of the SBOM/SECURITY/VERSIONING stamps, which are outside the VERSION_SITES
   459	# of verify-counts. Without it an external no-op would block the in-loop
   460	# self-heal from ever running over a stale stamp. Freezing the DATE is safe
   461	# because the freshness gate decides on the stamp VERSION, not its date.
   462	tree_already_at_target() {
   463	  cur_version="$(tr -d ' \n' < VERSION)"
   464	  printf '  --   oracle 1/4: VERSION=%s, target=%s\n' "$cur_version" "$TARGET_BASE"
   465	  [ "$cur_version" = "$TARGET_BASE" ] || return 1
   466	  _oracle "2/4" bash .claude/scripts/local/verify-counts.sh --quiet --no-tests || return 1
   467	  _oracle "3/4" python3 scripts/build-plugin.py --check || return 1
   468	  _oracle "4/4" python3 .claude/scripts/check-canonical-doc-freshness.py || return 1
   469	  return 0
   470	}
   471	
   472	bump() {
   473	  hdr "bump version sites to $TARGET_BASE"
   474	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to bump"
   475	
   476	  if [ "$RESTAMP" -eq 1 ] && [ "$NPM_README_REVIEWED" -eq 0 ]; then
   477	    die "--restamp moves every last-reviewed stamp — it REQUIRES --npm-readme-reviewed, otherwise it is exactly the tripwire bypass the stamp exists to prevent"
   478	  fi
   479	
   480	  if [ "$RESTAMP" -eq 1 ]; then
   481	    hdr "restamp requested — no-op fast path DISABLED by design"
   482	    note "in the normal re-review case (same version, four clean oracles) the"
   483	    note "predicate would return BEFORE any substitution and --restamp would"
   484	    note "be dead letter. It is skipped so a real re-review can be recorded."
   485	  else
   486	    hdr "same-tree predicate — four oracles, ALL required"
   487	    if tree_already_at_target; then
   488	      ok "no-op: tree is already at $TARGET_BASE and all four oracles are clean"
   489	      note "NOTHING was written: not a file, not an index entry. The"
   490	      note "post-condition of this phase (tree at $TARGET_BASE, gates green) is"
   491	      note "already satisfied, so a no-op bump is SUCCESS, not failure."
   492	      note "For a genuine re-review of the docs: --restamp --npm-readme-reviewed"
   493	      hint_next_phase
   494	      return 0
   495	    fi
   496	    note "at least one oracle is unsatisfied — running the bump"
   497	  fi
   498	
   499	  # The npm/README.md stamp is a DELIBERATE release tripwire: its date+version
   500	  # line asserts the npm-facing copy was re-read for this release. Re-stamping
   501	  # it silently would defeat the whole purpose of the gate, so it takes an
   502	  # explicit acknowledgement. Checked AFTER the no-op predicate on purpose: a
   503	  # run that writes nothing asserts nothing, and demanding the flag there would
   504	  # be asking the Owner to certify a review that is not happening.
   505	  if [ "$NPM_README_REVIEWED" -eq 0 ]; then
   506	    cat >&2 <<'EOF'
   507	FAIL: npm/README.md carries a "last-reviewed: <date> v<version>" stamp, and
   508	      verify-counts treats it as a release tripwire — bumping it asserts that
   509	      the npm-facing README was actually re-read for this release.
   510	
   511	      Read npm/README.md, then re-run with --npm-readme-reviewed.
   512	EOF
   513	    exit 1
   514	  fi
   515	
   516	  [ "$DRY_RUN" -eq 1 ] && take_snapshot
   517	
   518	  if [ "$RESTAMP" -eq 1 ]; then
   519	    python3 "$BUMP_SITES" bump --target "$TARGET_BASE" --today "$TODAY" --restamp \
   520	      || die "version-site bump failed"
   521	  else
   522	    python3 "$BUMP_SITES" bump --target "$TARGET_BASE" --today "$TODAY" \
   523	      || die "version-site bump failed"
   524	  fi
   525	
   526	  # Plugin manifests (.claude-plugin/{plugin,marketplace}.json) are GENERATED
   527	  # from VERSION, never hand-patched. The release.yml gate "Assert plugin
   528	  # manifest versions match VERSION" enforces them — and verify-counts does
   529	  # NOT, which is exactly how the v1.2.0-rc.1 run went red: the manifests were
   530	  # version sites invisible to the local oracle.
   531	  python3 scripts/build-plugin.py --write-manifests >/dev/null 2>&1 \
   532	    || die "build-plugin.py --write-manifests failed"
   533	  python3 scripts/build-plugin.py --check >/dev/null 2>&1 \
   534	    || die "plugin manifests still out of sync with the generator"
   535	  ok "plugin manifests regenerated from VERSION (build-plugin.py)"
   536	
   537	  # verify-counts covers the doc/package sites; the release.yml gate family
   538	  # covers the plugin manifests; the freshness gate covers the review stamps
   539	  # outside both. NOT ONE of them is the full oracle — the union is. If a new
   540	  # site is added upstream, expect it to surface in one of the three, and
   541	  # mirror it into _release_bump_sites.py.
   542	  bash .claude/scripts/local/verify-counts.sh --quiet --no-tests >/dev/null 2>&1 \
   543	    || {
   544	      bash .claude/scripts/local/verify-counts.sh --json --no-tests 2>&1 \
   545	        | python3 -c 'import json,sys
   546	d = json.load(sys.stdin)
   547	for v in d.get("violations", []):
   548	    print("  !!   " + v, file=sys.stderr)' || true
   549	      die "verify-counts still reports version drift — a site is unpatched (see above)"
   550	    }
   551	  ok "verify-counts clean across the doc/package version sites"
   552	
   553	  if [ "$DRY_RUN" -eq 1 ]; then
   554	    git --no-pager diff --stat || true
   555	    note "dry-run: no commit made"
   556	    return 0
   557	  fi
   558	
