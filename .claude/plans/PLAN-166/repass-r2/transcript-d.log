   259	def compute_convergence(
   260	    plans_root: Path,
   261	    plan_id: str,
   262	    round_num: int,
   263	    threshold: float = DEFAULT_JACCARD_THRESHOLD,
   264	) -> dict:
   265	    """Compute Jaccard across round N and N-1. Returns a dict shaped
   266	    like :class:`ConvergenceResult` plus legacy keys (``jaccard``,
   267	    ``converged``, ``red_team_needed``, ``round``, ``plan``, risk counts,
   268	    ``zero_coverage``).
   269	
   270	    Ceiling semantics (PLAN-169 W2.9(iii), aligns with PROTOCOL §12.4):
   271	    a round at ``round_num >= MAX_ROUNDS`` is TERMINAL either way, but
   272	    convergence at the ceiling is CONVERGENCE — when jaccard >= threshold
   273	    the outcome is ``converged`` (met=True); only a below-threshold
   274	    ceiling round reports ``max_rounds_reached`` (met=False, escalate to
   275	    Owner). Termination is preserved (closes PLAN-012 chaos CRITICAL-2:
   276	    no round beyond the ceiling), the mislabel is not.
   277	
   278	    Resolved-vs-novel (W2.9(ii)): Jaccard PUNISHES cure — a risk that
   279	    left the set because it was RESOLVED between rounds shrinks the
   280	    intersection exactly like fresh divergence would. The score is kept
   281	    as-is (set-stability semantics, documented), and ``resolved_count``/
   282	    ``novel_count`` are reported separately so the CEO verdict never
   283	    rides on a number that penalizes fixing things."""
   284	    prev_dir = _round_dir(plans_root, plan_id, round_num - 1)
   285	    cur_dir = _round_dir(plans_root, plan_id, round_num)
   286	    if not prev_dir.is_dir():
   287	        raise FileNotFoundError(f"round {round_num - 1} directory missing: {prev_dir}")
   288	    if not cur_dir.is_dir():
   289	        raise FileNotFoundError(f"round {round_num} directory missing: {cur_dir}")
   290	    max_rounds_reached = bool(round_num >= MAX_ROUNDS)
   291	    prev_set = collect_risk_set(prev_dir)
   292	    cur_set = collect_risk_set(cur_dir)
   293	    zero_coverage = not prev_set and not cur_set
   294	    score = 0.0 if zero_coverage else jaccard(prev_set, cur_set)
   295	    jaccard_converged = (not zero_coverage) and score >= threshold
   296	    # W2.9(iii): convergence at the ceiling IS convergence (§12.4). The
   297	    # ceiling still terminates the debate — it only stops masking a
   298	    # jaccard >= threshold as an impasse.
   299	    convergence_met = jaccard_converged
   300	    if jaccard_converged:
   301	        outcome = _OUTCOME_CONVERGED
   302	    elif max_rounds_reached:
   303	        outcome = _OUTCOME_MAX_ROUNDS
   304	    else:
   305	        outcome = _OUTCOME_DIVERGED
   306	    return {
   307	        "jaccard": round(score, 6),
   308	        "converged": bool(convergence_met),
   309	        "red_team_needed": bool(convergence_met and round_num <= 2),
   310	        "round": round_num,
   311	        "plan": plan_id,
   312	        "prev_risk_count": len(prev_set),
   313	        "curr_risk_count": len(cur_set),
   314	        "resolved_count": len(prev_set - cur_set),
   315	        "novel_count": len(cur_set - prev_set),
   316	        "resolved_risks": sorted(prev_set - cur_set),
   317	        "novel_risks": sorted(cur_set - prev_set),
   318	        "threshold": threshold,
   319	        "zero_coverage": zero_coverage,
   320	        "convergence_met": bool(convergence_met),
   321	        "max_rounds_reached": max_rounds_reached,
   322	        "jaccard_score": round(score, 6),
   323	        "outcome": outcome,
   324	        "round_number": round_num,
   325	    }
