   149	def manifest_entries(manifest: Path) -> List[str]:
   150	    """Parse `manifest` with the validator's OWN parser, executed.
   151	
   152	    `compute_inputs_hash()` is run with the module-level `subprocess` reference
   153	    swapped for a stub, so no `git hash-object` ever runs; the argv the stub
   154	    receives is the authority's parse result. If the validator changes its
   155	    comment/blank-line rule, this guard follows it for free instead of drifting
   156	    against a re-implementation.
   157	    """
   158	    seen: List[str] = []
   159	
   160	    def _fake_run(cmd, **kwargs):
   161	        if list(cmd[:2]) != ["git", "hash-object"]:
   162	            raise AssertionError("unexpected subprocess call: %r" % (cmd,))
   163	        seen.append(cmd[2])
   164	        return types.SimpleNamespace(returncode=0, stdout="0" * 40 + "\n", stderr="")
   165	
   166	    with mock.patch.object(VALIDATOR, "subprocess", types.SimpleNamespace(run=_fake_run)):
   167	        VALIDATOR.compute_inputs_hash(REPO, manifest)
   168	    return seen
