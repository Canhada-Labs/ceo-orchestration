   294	def find_gate_job(run: Dict[str, Any], gate_job: str) -> Optional[Dict[str, Any]]:
   295	    """The ``release-gate`` job inside a run, or None if not materialised yet."""
   296	    jobs = run.get("jobs")
   297	    if isinstance(jobs, dict):
   298	        jobs = jobs.get("jobs")
   299	    if not isinstance(jobs, list):
   300	        return None
   301	    for job in jobs:
   302	        if isinstance(job, dict) and job.get("name") == gate_job:
   303	            return job
   304	    return None
   305	
   306	
   307	def _wait_or_block(reason: str, ctx: GateContext, facts: Dict[str, Any]) -> Decision:
   308	    """Every non-GRANT state collapses to BLOCK once the deadline elapses."""
   309	    if ctx.deadline_passed:
   310	        return Decision(BLOCK, "deadline-exceeded:" + reason, facts)
   311	    return Decision(WAIT, reason, facts)
   312	
   313	
   314	def _candidate_facts(run: Dict[str, Any]) -> Dict[str, Any]:
   315	    return {
   316	        "candidate_run_id": run.get("id"),
   317	        "candidate_run_attempt": run.get("run_attempt"),
   318	        "candidate_created_at": run.get("created_at"),
   319	        "candidate_run_status": run.get("status"),
   320	        "candidate_run_conclusion": run.get("conclusion"),
   321	    }
   322	
   323	
   324	def decide(payload: Any, ctx: GateContext) -> Decision:
   325	    """The whole decision. Pure: no network, no clock, no filesystem."""
   326	    facts: Dict[str, Any] = {}
   327	    try:
   328	        runs = extract_runs(payload)
   329	        candidate, census = select_candidate(runs, ctx)
   330	    except MalformedPayload as exc:
   331	        facts["error"] = str(exc)
   332	        return Decision(BLOCK, "malformed-payload", facts)
   333	    facts.update(census)
   334	    if candidate is None:
   335	        reason = "stale-candidates-only" if census["stale_candidates"] else "candidate-not-yet-created"
   336	        return _wait_or_block(reason, ctx, facts)
   337	    facts.update(_candidate_facts(candidate))
   338	    job = find_gate_job(candidate, ctx.gate_job)
   339	    if job is None:
   340	        facts["gate_job_present"] = False
   341	        return _wait_or_block("gate-job-not-materialised", ctx, facts)
   342	    facts["gate_job_present"] = True
   343	    facts["gate_job_status"] = job.get("status")
   344	    conclusion = job.get("conclusion")
   345	    facts["gate_job_conclusion"] = conclusion
   346	    if conclusion is None:
   347	        return _wait_or_block("gate-job-not-concluded", ctx, facts)
   348	    if not isinstance(conclusion, str):
   349	        facts["error"] = "gate job conclusion is %s, expected string or null" % type(conclusion).__name__
   350	        return Decision(BLOCK, "malformed-payload", facts)
   351	    if conclusion == "success":
   352	        return Decision(GRANT, "gate-job-success", facts)
   353	    return Decision(BLOCK, "gate-job-" + conclusion, facts)
   354	
   355	
   356	def render(decision: Decision, ctx: GateContext) -> str:
   357	    """Human-readable record. A decision that hides its inputs is unauditable."""
   358	    remaining = "n/a"
   359	    if ctx.deadline_epoch is not None:
   360	        remaining = str(ctx.deadline_epoch - ctx.now_epoch)
   361	    lines = [
   362	        "decision=%s reason=%s" % (decision.decision, decision.reason),
   363	        "inputs: workflow=%s gate_job=%s event=%s tag=%s head_sha=%s"
   364	        % (ctx.workflow, ctx.gate_job, ctx.event, ctx.tag, ctx.head_sha),
   365	        "inputs: now_epoch=%s deadline_epoch=%s deadline_remaining_s=%s"
   366	        % (ctx.now_epoch, ctx.deadline_epoch, remaining),
   367	        "inputs: self_created_at_epoch=%s freshness_skew_s=%s freshness_floor_epoch=%s"
   368	        % (ctx.self_created_at_epoch, ctx.freshness_skew_seconds, ctx.freshness_floor),
   369	    ]
   370	    for key in sorted(decision.facts):
   371	        lines.append("fact: %s=%r" % (key, decision.facts[key]))
   372	    return "\n".join(lines)
   373	
   374	
   375	def _load_payload(path: str) -> Any:
   376	    raw = sys.stdin.read() if path == "-" else open(path, "r", encoding="utf-8").read()
   377	    return json.loads(raw)
   378	
   379	
   380	def build_parser() -> argparse.ArgumentParser:
   381	    parser = argparse.ArgumentParser(description="Decide whether release-gate authorises an npm publish.")
   382	    parser.add_argument("--payload-file", default="-", help="JSON of runs+jobs ('-' = stdin)")
   383	    parser.add_argument("--tag", required=True, help="tag name, i.e. head_branch of the release run")
   384	    parser.add_argument("--head-sha", required=True, help="GITHUB_SHA the publish is running against")
   385	    parser.add_argument("--workflow", default=DEFAULT_WORKFLOW)
   386	    parser.add_argument("--gate-job", default=DEFAULT_GATE_JOB)
   387	    parser.add_argument("--event", default=DEFAULT_EVENT)
   388	    parser.add_argument(
   389	        "--deadline-epoch",
   390	        type=int,
   391	        required=True,
   392	        help="epoch seconds after which any non-GRANT state becomes BLOCK (fail-closed)",
   393	    )
   394	    parser.add_argument("--now-epoch", type=int, default=None, help="override the clock (tests)")
   395	    parser.add_argument(
   396	        "--self-created-at",
   397	        required=True,
   398	        help=(
   399	            "created_at of the ASKING run; candidates older than this minus "
   400	            "the skew are stale. Required: this input arms the delete+re-tag "
   401	            "freshness leg, and a verdict-changing parameter has no default"
   402	        ),
   403	    )
   404	    parser.add_argument(
   405	        "--freshness-skew-seconds", type=int, default=DEFAULT_FRESHNESS_SKEW_SECONDS
   406	    )
   407	    parser.add_argument("--json", action="store_true", help="emit the decision record as JSON")
   408	    return parser
   409	
   410	
   411	def main(argv: Optional[Sequence[str]] = None) -> int:
   412	    args = build_parser().parse_args(argv)
   413	    # Unconditional parse: `required=True` rejects the OMITTED flag, and this
   414	    # rejects the empty/garbage value that a truthiness guard would have
   415	    # silently mapped to "freshness leg off".
   416	    self_created_at_epoch = parse_timestamp(args.self_created_at)
   417	    if self_created_at_epoch is None:
   418	        sys.stderr.write(
   419	            "error: --self-created-at %r is not an ISO-8601 timestamp "
   420	            "(the freshness leg cannot run without it)\n" % args.self_created_at
   421	        )
   422	        return EXIT_USAGE
   423	    ctx = GateContext(
   424	        tag=args.tag,
   425	        head_sha=args.head_sha,
   426	        now_epoch=args.now_epoch if args.now_epoch is not None else int(time.time()),
   427	        workflow=args.workflow,
   428	        gate_job=args.gate_job,
   429	        event=args.event,
   430	        deadline_epoch=args.deadline_epoch,
   431	        self_created_at_epoch=self_created_at_epoch,
   432	        freshness_skew_seconds=args.freshness_skew_seconds,
   433	    )
   434	    try:
   435	        payload = _load_payload(args.payload_file)
   436	    except (OSError, ValueError) as exc:
   437	        decision = Decision(BLOCK, "malformed-payload", {"error": str(exc)})
   438	    else:
   439	        decision = decide(payload, ctx)
   440	    if args.json:
   441	        print(json.dumps({
   442	            "decision": decision.decision,
   443	            "reason": decision.reason,
   444	            "facts": decision.facts,
   445	            "inputs": ctx._asdict(),
   446	        }, sort_keys=True, default=str))
   447	    else:
   448	        print(render(decision, ctx))
   449	    return decision.exit_code
   450	
   451	
   452	if __name__ == "__main__":
   453	    sys.exit(main())
