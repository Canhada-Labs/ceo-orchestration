   964	def test_delta_rejects_an_allowlist_entry_that_is_not_evidence(synth):
   965	    """Wildcard-free is not enough — the allowlist must also be EXHAUSTIVE.
   966	    A verdict that allowlists `VERSION` would wave through exactly the
   967	    post-review bump commit that F2 is about, and every check below it would
   968	    still report green. The refusal has to land on the allowlist itself."""
   969	    repo, env = synth["repo"], synth["env"]
   970	    parent = git(repo, env, "rev-parse", "HEAD")
   971	    ev = make_repass(repo, "repass-r2", {"verdict-r1.txt": "GO\n"})
   972	    verdict_rel = ".claude/governance/pair-rail-verdict-v1.3.0-rc.2.md"
   973	    write_verdict(
   974	        repo,
   975	        "v1.3.0-rc.2",
   976	        parent,
   977	        [verdict_rel, ev["manifest_rel"], "VERSION"] + ev["artifact_rels"],
   978	        ev["manifest_rel"],
   979	        ev["manifest_sha"],
   980	    )
   981	    git(repo, env, "add", "-A")
   982	    git(repo, env, "commit", "-q", "-m", "allowlist a version site")
   983	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
   984	    assert proc.returncode == tag_guard.E_VERDICT, proc.stdout + proc.stderr
   985	    assert "EXHAUSTIVE" in proc.stderr
   986	    assert "'VERSION'" in proc.stderr
