    56	class TestJaccardMath(unittest.TestCase):
    57	
    58	    def test_identity_returns_one(self):
    59	        s = {"a", "b", "c"}
    60	        self.assertEqual(dc.jaccard(s, s), 1.0)
    61	
    62	    def test_disjoint_sets_return_zero(self):
    63	        self.assertEqual(dc.jaccard({"a"}, {"b"}), 0.0)
    64	
    65	    def test_empty_both_returns_one(self):
    66	        # Convention: no evidence of divergence
    67	        self.assertEqual(dc.jaccard(set(), set()), 1.0)
    68	
    69	    def test_empty_one_returns_zero(self):
    70	        self.assertEqual(dc.jaccard({"a"}, set()), 0.0)
    71	        self.assertEqual(dc.jaccard(set(), {"a"}), 0.0)
    72	
    73	    def test_symmetry(self):
    74	        a = {"alpha", "beta"}
    75	        b = {"beta", "gamma"}
    76	        self.assertEqual(dc.jaccard(a, b), dc.jaccard(b, a))
    77	
    78	    def test_half_overlap_is_point_three_three(self):
    79	        # {a,b} vs {b,c} -> 1/3
    80	        self.assertAlmostEqual(dc.jaccard({"a", "b"}, {"b", "c"}), 1.0 / 3.0, places=6)
