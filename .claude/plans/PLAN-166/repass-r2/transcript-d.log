   327	class TestMaxRoundsHardStop(unittest.TestCase):
   328	    """MAX_ROUNDS=5 hard stop — PLAN-012 Phase 1 D3.5 + chaos CRITICAL-2."""
   329	
   330	    def setUp(self):
   331	        self.tmp = Path(tempfile.mkdtemp(prefix="maxr-"))
   332	
   333	    def tearDown(self):
   334	        shutil.rmtree(self.tmp, ignore_errors=True)
   335	
   336	    def _seed(self, highest: int, risks=None) -> None:
   337	        """Populate round-1..N; risks=None -> per-round unique (Jaccard=0)."""
   338	        base = self.tmp / "PLAN-999" / "debate"
   339	        for r in range(1, highest + 1):
   340	            d = base / f"round-{r}"
   341	            d.mkdir(parents=True, exist_ok=True)
   342	            body = ("\n".join(f"- {x}" for x in risks) + "\n"
   343	                    if risks is not None else f"- unique risk round {r}\n")
   344	            (d / "a.md").write_text(f"## Risks\n\n{body}", encoding="utf-8")
   345	
   346	    def _seed_pair(self, round_num: int, prev_risks, cur_risks) -> None:
   347	        """Populate exactly round N-1 and N with the given risk sets."""
   348	        base = self.tmp / "PLAN-999" / "debate"
   349	        for r, risks in ((round_num - 1, prev_risks), (round_num, cur_risks)):
   350	            d = base / f"round-{r}"
   351	            d.mkdir(parents=True, exist_ok=True)
   352	            body = "\n".join(f"- {x}" for x in risks) + "\n"
   353	            (d / "a.md").write_text(f"## Risks\n\n{body}", encoding="utf-8")
   354	
   355	    def test_module_exports_max_rounds_constant(self):
   356	        self.assertTrue(hasattr(dc, "MAX_ROUNDS"))
   357	        self.assertEqual(dc.MAX_ROUNDS, 5)
