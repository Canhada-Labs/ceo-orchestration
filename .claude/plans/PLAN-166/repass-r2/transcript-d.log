+class TestDocFreshness(unittest.TestCase):
+    """PLAN-166 W0 re-pass finding 6: docs/CTO-GUIDE.md carried v0-era
+    roadmap claims ('HMAC chain queued (DYN-SEC3 / Sprint 16)', Sprint 15-16
