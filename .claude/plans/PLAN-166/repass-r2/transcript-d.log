   328	def _parse(argv: List[str]) -> argparse.Namespace:
   329	    p = argparse.ArgumentParser(
   330	        description="Compute Jaccard convergence for a debate round"
   331	    )
   332	    p.add_argument("--plan", required=True, help="Plan ID (PLAN-NNN)")
   333	    p.add_argument(
   334	        "--round",
   335	        type=int,
   336	        required=True,
   337	        dest="round_num",
   338	        help="Round number (>= 2)",
   339	    )
   340	    p.add_argument(
   341	        "--plans-root",
   342	        type=str,
   343	        default=None,
   344	        help="Override plans root (defaults to ../plans relative to this script)",
   345	    )
   346	    p.add_argument(
   347	        "--threshold",
   348	        type=float,
   349	        default=DEFAULT_JACCARD_THRESHOLD,
   350	        help=f"Jaccard threshold for convergence (default {DEFAULT_JACCARD_THRESHOLD})",
   351	    )
   352	    return p.parse_args(argv)
   353	
