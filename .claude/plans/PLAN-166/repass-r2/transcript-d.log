  1141	def scan_live_surfaces(needle: str):
  1142	    """grep, in Python. The local `grep` is ugrep and disagrees with GNU grep
  1143	    about binary files, so a subprocess control would not mean the same thing
  1144	    here and in CI. Returns (files_scanned, hits)."""
  1145	    hits: List[str] = []
  1146	    scanned = 0
  1147	    for root in SCAN_ROOTS:
  1148	        base = REPO_ROOT / root
  1149	        if not base.exists():
  1150	            continue
  1151	        paths = [base] if base.is_file() else sorted(base.rglob("*"))
  1152	        for path in paths:
  1153	            if not path.is_file() or "__pycache__" in path.parts:
  1154	                continue
  1155	            try:
  1156	                body = path.read_text(encoding="utf-8")
  1157	            except (UnicodeDecodeError, OSError):
  1158	                continue  # binary artifact: not a live text surface
  1159	            scanned += 1
  1160	            for num, line in enumerate(body.splitlines(), 1):
  1160	            for num, line in enumerate(body.splitlines(), 1):
  1161	                if needle in line:
  1162	                    hits.append(
  1163	                        "%s:%d: %s"
  1164	                        % (path.relative_to(REPO_ROOT), num, line.strip())
  1165	                    )
  1166	    return scanned, hits
