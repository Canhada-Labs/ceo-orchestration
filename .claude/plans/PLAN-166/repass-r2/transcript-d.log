   100	def _load(src: Path, name: str):
   101	    """Import a dashed/dotted script by path WITHOUT touching sys.modules.
   102	
   103	    sys.modules rebinding is not CI-safe (S265 lesson); these three scripts are
   104	    flat, import nothing relative, so exec_module on an unregistered module is
   105	    enough.
   106	    """
   107	    if not src.is_file():
   108	        raise AssertionError(
   109	            "authority missing: %s — this guard derives its reference list "
   110	            "from that file; a rename must update this test, never silently "
   111	            "disable it" % src
   112	        )
   113	    spec = importlib.util.spec_from_file_location(name, str(src))
   114	    if spec is None or spec.loader is None:
   115	        raise AssertionError("cannot build import spec for %s" % src)
