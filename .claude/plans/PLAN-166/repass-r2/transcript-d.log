  1006	def test_delta_rejects_plan_paths_outside_the_manifest_dir(synth, entry):
  1007	    """Re-pass P2: `.claude/plans/` entries OUTSIDE the manifest directory
  1008	    used to close by NAME alone — no content pin, no manifest coverage, no
  1009	    tag specificity — while the same guard rejected `VERSION` as
  1010	    non-EXHAUSTIVE. Only `verdict-fields-<THIS TAG>.md` at its CANONICAL
  1011	    path (directly inside the plan directory holding the manifest dir) may
  1012	    live outside the content-pinned manifest directory; everything else —
  1013	    including same-basename look-alikes elsewhere — must be IN it."""
  1014	    arm_verdict(synth, "v1.3.0-rc.2", extra_allow=[entry])
  1015	    proc = guard(synth, "delta", "--repo", str(synth["repo"]), "--tag", "v1.3.0-rc.2")
  1016	    assert proc.returncode == tag_guard.E_VERDICT, proc.stdout + proc.stderr
  1017	    assert "verdict-fields" in proc.stderr, proc.stderr
