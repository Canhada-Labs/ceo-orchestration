   989	@pytest.mark.parametrize(
   990	    "entry",
   991	    [
   992	        # the plan file itself — post-review edits would ride the tag
   993	        ".claude/plans/PLAN-166-release-hold-findings-closure.md",
   994	        # ANOTHER tag's verdict-fields — stale evidence smuggled by name
   995	        ".claude/plans/PLAN-166/verdict-fields-v1.2.0.md",
   996	        # immutable historical evidence outside the pinned manifest dir
   997	        ".claude/plans/PLAN-166/repass-r1/old-evidence.txt",
   998	        # W0 re-pass r2 P2: the RIGHT basename in the WRONG directory — a
   999	        # basename-only rule admits any number of look-alikes anywhere under
  1000	        # .claude/plans/; the file must sit at its canonical path (the plan
  1001	        # directory that CONTAINS the manifest dir)
  1002	        ".claude/plans/archive/verdict-fields-v1.3.0-rc.2.md",
  1003	        ".claude/plans/PLAN-166/repass-r1/verdict-fields-v1.3.0-rc.2.md",
