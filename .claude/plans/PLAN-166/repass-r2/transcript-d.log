   327	class TestMaxRoundsHardStop(unittest.TestCase):
   328	    """MAX_ROUNDS=5 hard stop — PLAN-012 Phase 1 D3.5 + chaos CRITICAL-2."""
   329	
   330	    def setUp(self):
   331	        self.tmp = Path(tempfile.mkdtemp(prefix="maxr-"))
   332	
   333	    def tearDown(self):
   334	        shutil.rmtree(self.tmp, ignore_errors=True)
   335	
   336	    def _seed(self, highest: int, risks=None) -> None:
   337	        """Populate round-1..N; risks=None -> per-round unique (Jaccard=0)."""
   338	        base = self.tmp / "PLAN-999" / "debate"
   339	        for r in range(1, highest + 1):
   340	            d = base / f"round-{r}"
   341	            d.mkdir(parents=True, exist_ok=True)
   342	            body = ("\n".join(f"- {x}" for x in risks) + "\n"
   343	                    if risks is not None else f"- unique risk round {r}\n")
   344	            (d / "a.md").write_text(f"## Risks\n\n{body}", encoding="utf-8")
   345	
   346	    def _seed_pair(self, round_num: int, prev_risks, cur_risks) -> None:
   347	        """Populate exactly round N-1 and N with the given risk sets."""
   348	        base = self.tmp / "PLAN-999" / "debate"
   349	        for r, risks in ((round_num - 1, prev_risks), (round_num, cur_risks)):
   350	            d = base / f"round-{r}"
   351	            d.mkdir(parents=True, exist_ok=True)
   352	            body = "\n".join(f"- {x}" for x in risks) + "\n"
   353	            (d / "a.md").write_text(f"## Risks\n\n{body}", encoding="utf-8")
   354	
   355	    def test_module_exports_max_rounds_constant(self):
   356	        self.assertTrue(hasattr(dc, "MAX_ROUNDS"))
   357	        self.assertEqual(dc.MAX_ROUNDS, 5)
   358	
   359	    def test_max_rounds_reached_at_round_5_returns_true(self):
   360	        self._seed(5)
   361	        r = dc.compute_convergence(self.tmp, "PLAN-999", 5, threshold=0.7)
   362	        self.assertTrue(r["max_rounds_reached"])
   363	        self.assertEqual(r["outcome"], "max_rounds_reached")
   364	        self.assertFalse(r["convergence_met"])
   365	        self.assertFalse(r["converged"])
   366	        self.assertEqual(r["round_number"], 5)
   367	
   368	    def test_max_rounds_not_reached_at_round_4(self):
   369	        self._seed(4)
   370	        r = dc.compute_convergence(self.tmp, "PLAN-999", 4, threshold=0.7)
   371	        self.assertFalse(r["max_rounds_reached"])
   372	        self.assertEqual(r["outcome"], "diverged")
   373	        self.assertEqual(r["round_number"], 4)
   374	
   375	    def test_ceiling_convergence_is_convergence(self):
   376	        # PLAN-169 W2.9(iii), PROTOCOL §12.4: Jaccard >= threshold at the
   377	        # MAX_ROUNDS ceiling IS convergence — the old contract forced
   378	        # convergence_met=False here, masking a met threshold as impasse.
   379	        # The ceiling still terminates (max_rounds_reached stays True for
   380	        # orchestrators); only the mislabel is gone.
   381	        self._seed(5, ["alpha", "beta", "gamma"])
   382	        r = dc.compute_convergence(self.tmp, "PLAN-999", 5, threshold=0.7)
   383	        self.assertEqual(r["jaccard_score"], 1.0)
   384	        self.assertEqual(r["jaccard"], 1.0)
   385	        self.assertTrue(r["max_rounds_reached"])
   386	        self.assertEqual(r["outcome"], "converged")
   387	        self.assertTrue(r["convergence_met"])
   388	        self.assertTrue(r["converged"])
   389	        self.assertFalse(r["red_team_needed"])
   390	        self.assertEqual(r["resolved_count"], 0)
   391	        self.assertEqual(r["novel_count"], 0)
   392	
   393	    def test_resolved_vs_novel_reported_separately(self):
   394	        # PLAN-169 W2.9(ii): a risk leaving the set (cured) and a risk
   395	        # entering it are reported apart from the Jaccard that conflates
   396	        # them, so the CEO verdict can see cure vs true divergence.
   397	        self._seed_pair(3, ["a", "b", "c"], ["b", "c", "d"])
   398	        r = dc.compute_convergence(self.tmp, "PLAN-999", 3, threshold=0.99)
   399	        self.assertEqual(r["resolved_count"], 1)
   400	        self.assertEqual(r["novel_count"], 1)
   401	        self.assertEqual(r["resolved_risks"], ["a"])
   402	        self.assertEqual(r["novel_risks"], ["d"])
   403	
