    88	def _write_docs(root: Path, *, total, core, frontend, domain, adrs,
    89	                hook_py, lib, registered, readme_total=None) -> None:
    90	    claude = (
    91	        f"{total} reusable skills organized into `core/` ({core} universal), "
    92	        f"`frontend/` ({frontend} universal frontend), {domain} domain across 29 profiles.\n"
    93	        f"{adrs} ADRs total on disk.\n"
    94	        f"{hook_py} hook scripts on disk / {registered} registered hooks in settings.json.\n"
    95	        f"{lib} shared modules under `_lib/`.\n"
    96	    )
    97	    (root / "CLAUDE.md").write_text(claude, encoding="utf-8")
    98	    rt = readme_total if readme_total is not None else total
    99	    (root / "README.md").write_text(f"{rt} reusable skills here.\n", encoding="utf-8")
   100	    (root / "INSTALL.md").write_text(f"adds {core} universal core skills\n", encoding="utf-8")
