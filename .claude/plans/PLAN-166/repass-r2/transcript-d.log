   682	    def test_wrong_number_at_each_pt_label_fails(self):
   683	        """AC-5 control (a): a wrong number planted at EACH watched pt-BR
   684	        label/phrasing must produce a named violation for that metric."""
   685	        import tempfile
   686	        with tempfile.TemporaryDirectory() as td:
   687	            root = Path(td)
