     1	"""PLAN-119 WS-A — pytest conftest for ``.claude/scripts/tests/`` (net-new).
     2	
     3	This tree had **no conftest of its own** and ~398 raw ``unittest.TestCase``
     4	subclasses (not ``TestEnvContext``) — the highest-risk unguarded test tree for
     5	LIVE audit-log pollution (security P0-2 / qa RC-1 / Codex R1 P2). Any of them
     6	that triggers an audit emit wrote to the real ``~/.claude`` chain.
     7	
     8	This conftest registers the suite-wide audit-dir isolation REDIRECT fixtures
     9	(``_lib.test_isolation``) so the session redirect covers the scripts test tree
    10	even when pytest is invoked against it directly (e.g. the ``validate.yml``
    11	scripts step). The redirect is idempotent across the three conftests that
    12	register it — a no-op here if the root conftest already redirected.
    13	
    14	Also seeds ``sys.path`` (``.claude/scripts`` + ``.claude/hooks``) for the same
    15	reason the root conftest does, so scripts tests resolve both their own modules
    16	and ``_lib.*`` without a per-file ``sys.path.insert``.
    17	"""
    18	from __future__ import annotations
    19	
    20	import sys
    21	from pathlib import Path
    22	
    23	# Seed sys.path BEFORE importing _lib.test_isolation, so this conftest is
    24	# self-sufficient regardless of conftest import ordering.
    25	_SCRIPTS_DIR = str(Path(__file__).resolve().parent.parent)            # .claude/scripts
    26	_HOOKS_DIR = str(Path(__file__).resolve().parent.parent.parent / "hooks")  # .claude/hooks
    27	for _p in (_HOOKS_DIR, _SCRIPTS_DIR):
    28	    if _p not in sys.path:
    29	        sys.path.insert(0, _p)
    30	
    31	from _lib.test_isolation import (  # noqa: E402,F401
    32	    _ceo_audit_isolation_session,
    33	    _ceo_audit_isolation_check,
    34	)
    35	
    36	
    37	def pytest_collectstart(collector):  # noqa: D401
    38	    """Ensure ``.claude/scripts`` + ``.claude/hooks`` are on sys.path BEFORE any
    39	    scripts test module imports (mirror of the hooks-tests conftest)."""
    40	    for _p in (_HOOKS_DIR, _SCRIPTS_DIR):
    41	        if _p not in sys.path:
    42	            sys.path.insert(0, _p)

