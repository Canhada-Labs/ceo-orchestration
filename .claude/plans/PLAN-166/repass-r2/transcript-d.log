    77	@dataclass
    78	class ConvergenceResult:
    79	    """Structured convergence probe result; see compute_convergence()."""
    80	
    81	    convergence_met: bool
    82	    max_rounds_reached: bool
    83	    jaccard_score: float
    84	    threshold: float
    85	    outcome: str  # one of _OUTCOME_*
    86	    round_number: int
    87	
    88	
    89	# Files that live under round-N/ but are NOT agent critiques.
    90	_NON_CRITIQUE_FILES = {
    91	    "proposal.md",
    92	    "consensus.md",
    93	    "synthesis.md",
    94	    "red-team.md",
    95	    # DEBATE-SCHEMA §13.2 anonymized-synthesis audit record (PLAN-134 W1)
    96	    "anonymization-map.md",
    97	}
    98	
    99	
   100	_HEADING_RE = re.compile(r"^\s*##\s+(.+?)\s*$")
   101	_BULLET_RE = re.compile(r"^\s*-\s+(.+?)\s*$")
   102	
   103	# Punctuation table used for normalization. We replace all ASCII
   104	# punctuation characters with a space (so "rate-limit" -> "rate limit",
   105	# not "ratelimit"); unicode punctuation is collapsed via split().
   106	_PUNCT_TABLE = str.maketrans(string.punctuation, " " * len(string.punctuation))
   107	
   108	
   109	def _plans_root_default() -> Path:
   110	    """Return the default `.claude/plans/` root based on __file__ location."""
   111	    # __file__ is at .claude/scripts/debate-converge.py — plans root is sibling.
   112	    return Path(__file__).resolve().parent.parent / "plans"
   113	
   114	
   115	def _round_dir(plans_root: Path, plan_id: str, round_num: int) -> Path:
   116	    return plans_root / plan_id / "debate" / f"round-{round_num}"
   117	
   118	
   119	def _normalize_risk(text: str) -> str:
   120	    """Normalize a risk bullet for set-membership comparison.
   121	
   122	    Steps:
   123	    - lowercase
   124	    - strip ASCII punctuation
   125	    - collapse whitespace (handles unicode spaces via .split())
   126	    - drop leading inline-ID prefixes like "R-VP1:", "R-SEC2 -",
   127	      so two rounds that renumber IDs still match on substance.
   128	    """
   129	    s = text.lower()
   130	    # Strip leading ID markers: "r-xxx:", "r-xxx -", "c1:", "m1:"
   131	    s = re.sub(r"^\s*(r-[a-z0-9]+|c\d+|m\d+|s\d+|h\d+)\s*[:\-—]\s*", "", s)
   132	    s = s.translate(_PUNCT_TABLE)
   133	    s = " ".join(s.split())
   134	    return s
   135	
   136	
   137	def extract_risks(md_text: str) -> List[str]:
   138	    """Extract and normalize bullet items under the `## Risks` heading.
   139	
   140	    Returns a list (order preserved, duplicates allowed; caller dedupes
   141	    via set()).
   142	    """
   143	    lines = md_text.splitlines()
   144	    risks: List[str] = []
   145	    in_risks = False
   146	    for raw in lines:
   147	        heading = _HEADING_RE.match(raw)
   148	        if heading:
   149	            title = heading.group(1).strip().lower()
   150	            # Accept "Risks", "risks (prioritized)", "Risks:"
   151	            if title == "risks" or title.startswith("risks "):
   152	                in_risks = True
   153	                continue
   154	            # Any other heading closes the Risks section
   155	            if in_risks:
   156	                in_risks = False
   157	            continue
   158	        if not in_risks:
   159	            continue
   160	        bullet = _BULLET_RE.match(raw)
   161	        if bullet:
   162	            normalized = _normalize_risk(bullet.group(1))
   163	            if normalized:
   164	                risks.append(normalized)
   165	    return risks
   166	
   167	
   168	def iter_agent_critiques(round_dir: Path) -> Iterable[Path]:
   169	    """Yield paths of agent critique files under round_dir (alpha-sorted).
   170	
   171	    Excludes proposal.md, consensus.md, synthesis.md, red-team.md.
   172	    """
   173	    if not round_dir.is_dir():
   174	        return
   175	    for p in sorted(round_dir.iterdir()):
   176	        if p.name in _NON_CRITIQUE_FILES:
   177	            continue
   178	        if p.suffix != ".md":
   179	            continue
   180	        if not p.is_file():
   181	            continue
   182	        yield p
   183	
   184	
   185	class RisksSectionEmptyError(ValueError):
   186	    """A critique has a `## Risks` heading that parsed to ZERO bullets.
   187	
   188	    PLAN-169 W2.9(i): paragraph-style risks (`**R-X** ...` prose) are
   189	    invisible to the bullet parser, so the critique silently contributed
   190	    an EMPTY set to the round (registered-vacuous family — the round-1
   191	    Security critique of PLAN-169 contributed 0 risks and nobody knew).
   192	    A present-but-unparseable section is an INPUT-parse failure and is
   193	    fail-closed: loud per-critique error, never a silent zero.
   194	    """
   195	
   196	
   197	def _risks_heading_present(md_text: str) -> bool:
   198	    """True when a `## Risks`-family heading exists in the text."""
   199	    for raw in md_text.splitlines():
   200	        heading = _HEADING_RE.match(raw)
   201	        if heading:
   202	            title = heading.group(1).strip().lower()
   203	            if title == "risks" or title.startswith("risks "):
   204	                return True
   205	    return False
   206	
   207	
   208	def collect_risk_set(round_dir: Path) -> Set[str]:
   209	    """Union all agent critique risks in a round into a normalized set.
   210	
   211	    Raises :class:`RisksSectionEmptyError` (fail-closed, W2.9(i)) when a
   212	    critique carries a Risks heading but zero parseable bullets.
   213	    """
   214	    out: Set[str] = set()
   215	    for critique_path in iter_agent_critiques(round_dir):
   216	        try:
   217	            text = critique_path.read_text(encoding="utf-8")
   218	        except OSError:
   219	            continue
   220	        items = extract_risks(text)
   221	        if not items and _risks_heading_present(text):
   222	            raise RisksSectionEmptyError(
   223	                f"{critique_path}: '## Risks' heading present but ZERO "
   224	                f"bullet items parsed — paragraph-style risks are invisible "
   225	                f"to the machine; rewrite them as '- ' bullets. Refusing to "
   226	                f"count this critique as silently empty."
   227	            )
   228	        out.update(items)
   229	    return out
   230	
   231	
   232	def jaccard(a: Set[str], b: Set[str]) -> float:
   233	    """Return Jaccard similarity. Empty/empty = 1.0 by convention (no
   234	    evidence of divergence); anything vs empty = 0.0."""
   235	    if not a and not b:
   236	        return 1.0
   237	    if not a or not b:
   238	        return 0.0
   239	    inter = len(a & b)
   240	    union = len(a | b)
   241	    if union == 0:
   242	        return 1.0  # defensive; unreachable with above guards
   243	    return inter / union
   244	
   245	
   246	def compute_convergence(
   247	    plans_root: Path,
   248	    plan_id: str,
   249	    round_num: int,
   250	    threshold: float = DEFAULT_JACCARD_THRESHOLD,
   251	) -> dict:
   252	    """Compute Jaccard across round N and N-1. Returns a dict shaped
   253	    like :class:`ConvergenceResult` plus legacy keys (``jaccard``,
   254	    ``converged``, ``red_team_needed``, ``round``, ``plan``, risk counts,
   255	    ``zero_coverage``).
   256	
   257	    Ceiling semantics (PLAN-169 W2.9(iii), aligns with PROTOCOL §12.4):
   258	    a round at ``round_num >= MAX_ROUNDS`` is TERMINAL either way, but
   259	    convergence at the ceiling is CONVERGENCE — when jaccard >= threshold
   260	    the outcome is ``converged`` (met=True); only a below-threshold
   261	    ceiling round reports ``max_rounds_reached`` (met=False, escalate to
   262	    Owner). Termination is preserved (closes PLAN-012 chaos CRITICAL-2:
   263	    no round beyond the ceiling), the mislabel is not.
   264	
   265	    Resolved-vs-novel (W2.9(ii)): Jaccard PUNISHES cure — a risk that
   266	    left the set because it was RESOLVED between rounds shrinks the
   267	    intersection exactly like fresh divergence would. The score is kept
   268	    as-is (set-stability semantics, documented), and ``resolved_count``/
   269	    ``novel_count`` are reported separately so the CEO verdict never
   270	    rides on a number that penalizes fixing things."""
   271	    prev_dir = _round_dir(plans_root, plan_id, round_num - 1)
   272	    cur_dir = _round_dir(plans_root, plan_id, round_num)
   273	    if not prev_dir.is_dir():
   274	        raise FileNotFoundError(f"round {round_num - 1} directory missing: {prev_dir}")
   275	    if not cur_dir.is_dir():
   276	        raise FileNotFoundError(f"round {round_num} directory missing: {cur_dir}")
   277	    max_rounds_reached = bool(round_num >= MAX_ROUNDS)
   278	    prev_set = collect_risk_set(prev_dir)
   279	    cur_set = collect_risk_set(cur_dir)
   280	    zero_coverage = not prev_set and not cur_set
   281	    score = 0.0 if zero_coverage else jaccard(prev_set, cur_set)
   282	    jaccard_converged = (not zero_coverage) and score >= threshold
   283	    # W2.9(iii): convergence at the ceiling IS convergence (§12.4). The
   284	    # ceiling still terminates the debate — it only stops masking a
   285	    # jaccard >= threshold as an impasse.
   286	    convergence_met = jaccard_converged
   287	    if jaccard_converged:
   288	        outcome = _OUTCOME_CONVERGED
   289	    elif max_rounds_reached:
   290	        outcome = _OUTCOME_MAX_ROUNDS
   291	    else:
   292	        outcome = _OUTCOME_DIVERGED
   293	    return {
   294	        "jaccard": round(score, 6),
   295	        "converged": bool(convergence_met),
   296	        "red_team_needed": bool(convergence_met and round_num <= 2),
   297	        "round": round_num,
   298	        "plan": plan_id,
   299	        "prev_risk_count": len(prev_set),
   300	        "curr_risk_count": len(cur_set),
   301	        "resolved_count": len(prev_set - cur_set),
   302	        "novel_count": len(cur_set - prev_set),
   303	        "resolved_risks": sorted(prev_set - cur_set),
   304	        "novel_risks": sorted(cur_set - prev_set),
   305	        "threshold": threshold,
   306	        "zero_coverage": zero_coverage,
   307	        "convergence_met": bool(convergence_met),
   308	        "max_rounds_reached": max_rounds_reached,
   309	        "jaccard_score": round(score, 6),
   310	        "outcome": outcome,
   311	        "round_number": round_num,
   312	    }
   313	
