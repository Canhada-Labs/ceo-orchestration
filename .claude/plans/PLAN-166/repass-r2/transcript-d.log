   137	STUB_VERIFY_COUNTS = """#!/usr/bin/env bash
   138	# Fixture stand-in for verify-counts.sh: version equality across the watched
   139	# doc/package sites. Deliberately simple — the real oracle is exercised by the
   140	# real repo, this one only has to be RIGHT about same-tree vs drifted-tree.
   141	#
   142	# It DOES model the support-window family (VERSION_SITES modes "minor" and
   143	# "prev_minor" on SECURITY.md/VERSIONING.md, added S293): the re-pass F-sites
   144	# finding was a fixture oracle WITHOUT these modes staying green over a writer
   145	# that never wrote them — the exact fixture!=live class. Derivation mirrors
   146	# the live oracle: prev = minor-1, empty (value-check skipped) at X.0.
   147	set -eu
   148	version="$(tr -d ' \\n' < VERSION)"
   149	minor="${version%.*}"
   150	maj="${minor%%.*}"
   151	min="${minor##*.}"
   152	prev=""
   153	if [ "$min" -gt 0 ]; then prev="${maj}.$((min - 1))"; fi
   154	rc=0
   155	for f in npm/package.json pyproject.toml INSTALL.md docs/ARCHITECTURE.md npm/README.md; do
   156	  [ -f "$f" ] || continue
   157	  if ! grep -q "$version" "$f"; then rc=1; fi
   158	done
   159	for f in SECURITY.md VERSIONING.md; do
   160	  [ -f "$f" ] || continue
   161	  cur_line="$(grep 'Current MINOR' "$f" || true)"
   162	  case "$cur_line" in
   163	    "") ;;
   164	    *"v${minor}.x"*) ;;
   165	    *) rc=1 ;;
   166	  esac
   167	  if [ -n "$prev" ]; then
   168	    prev_line="$(grep 'Previous MINOR' "$f" || true)"
   169	    case "$prev_line" in
   170	      "") ;;
   171	      *"v${prev}.x"*) ;;
   172	      *) rc=1 ;;
   173	    esac
   174	  fi
   175	done
   176	exit "$rc"
   177	"""
