   245	def jaccard(a: Set[str], b: Set[str]) -> float:
   246	    """Return Jaccard similarity. Empty/empty = 1.0 by convention (no
   247	    evidence of divergence); anything vs empty = 0.0."""
   248	    if not a and not b:
   249	        return 1.0
   250	    if not a or not b:
   251	        return 0.0
   252	    inter = len(a & b)
   253	    union = len(a | b)
   254	    if union == 0:
   255	        return 1.0  # defensive; unreachable with above guards
   256	    return inter / union
