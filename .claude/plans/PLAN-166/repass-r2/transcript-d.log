    99	
   100	def marketplace_manifest(version: str = VERSION) -> dict:
   101	    """Marketplace manifest content — PURE (same contract as plugin_manifest).
   102	
   103	    `source: ./ceo-plugin` is the layout of the PUBLISHED marketplace repo
   104	    (publish-plugin.sh copies this file next to the materialized ceo-plugin/
   105	    tree); in the framework repo itself the committed copy is the canonical
   106	    record of what the generator produces, not an installable marketplace."""
   107	    return {
   108	        "name": "ceo-marketplace",
   109	        "owner": {"name": "CEO Orchestration"},
   110	        "plugins": [
   111	            {
   112	                "name": NS,
   113	                "source": "./ceo-plugin",
   114	                "description": "CEO Orchestration — governed multi-agent Claude Code with audit + accelerators.",
   115	                "version": version,
   116	            }
   117	        ],
   118	    }
