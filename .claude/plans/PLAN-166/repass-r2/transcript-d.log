   561	
   562	    lessons = []
   563	    count = 0
   564	    for f in sorted(d.iterdir()):
   565	        if count >= _MAX_SCAN:
   566	            break
   567	        if not f.suffix == ".json":
   568	            continue
   569	        count += 1
   570	        try:
   571	            data = json.loads(f.read_text(encoding="utf-8"))
   572	            # PLAN-154 belt: a candidate record misplaced in the live
