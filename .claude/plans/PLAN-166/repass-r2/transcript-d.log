   801	def test_delta_blocks_a_fabricated_parent_outside_head_history(synth):
   802	    """W0 re-pass r2 P1: `cat-file -e` proves the anchor EXISTS, not that it
   803	    is in the history this tag signs. A fabricated commit over HEAD's own
   804	    tree (`git commit-tree`, parented off an older commit, on no branch)
   805	    makes diff(parent..HEAD) contain ONLY the verdict + evidence while an
   806	    unreviewed file sits on main — every downstream check (allowlist,
   807	    manifest pin, set equality, vacuity) then passes and the guard prints
   808	    "all inside the verdict's closed allowlist" over an unreviewed tree."""
   809	    repo, env = synth["repo"], synth["env"]
   810	    h0 = git(repo, env, "rev-parse", "HEAD")
   811	
   812	    # unreviewed work lands on main
   813	    (repo / "unreviewed.py").write_text("print('never reviewed')\n", encoding="utf-8")
   814	    git(repo, env, "add", "unreviewed.py")
   815	    git(repo, env, "commit", "-q", "-m", "unreviewed change")
   816	    m2_tree = git(repo, env, "rev-parse", "HEAD^{tree}")
   817	
   818	    # fabricated anchor: HEAD's exact tree, parented off h0, on NO branch —
   819	    # it exists in the object store but HEAD does not descend from it
   820	    orphan = git(repo, env, "commit-tree", m2_tree, "-p", h0, "-m", "fabricated anchor")
   821	    not_anc = run(["git", "merge-base", "--is-ancestor", orphan, "HEAD"], repo, env)
   822	    assert not_anc.returncode == 1, "fixture broke: orphan IS an ancestor"
   823	
   824	    ev = make_repass(repo, "repass-r2", {"verdict-r1.txt": "GO\n"})
   825	    verdict_rel = ".claude/governance/pair-rail-verdict-v1.3.0-rc.2.md"
   826	    write_verdict(
   827	        repo,
   828	        "v1.3.0-rc.2",
   829	        orphan,
   830	        [verdict_rel, ev["manifest_rel"]] + ev["artifact_rels"],
   831	        ev["manifest_rel"],
   832	        ev["manifest_sha"],
   833	    )
   834	    git(repo, env, "add", "-A")
   835	    git(repo, env, "commit", "-q", "-m", "verdict anchored on the fabricated commit")
   836	
   837	    proc = guard(synth, "delta", "--repo", str(repo), "--tag", "v1.3.0-rc.2")
   838	    assert proc.returncode == tag_guard.E_PARENT_NOT_ANCESTOR, (
   839	        proc.stdout + proc.stderr
   840	    )
   841	    assert "ancestor" in proc.stderr
   842	    # and it is a DISTINCT mode from both "bad verdict" and "delta outside"
   843	    assert tag_guard.E_PARENT_NOT_ANCESTOR != tag_guard.E_VERDICT
   844	    assert tag_guard.E_PARENT_NOT_ANCESTOR != tag_guard.E_DELTA
   845	
