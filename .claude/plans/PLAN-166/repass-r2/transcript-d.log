   678	# ---------------------------------------------------------------------
   679	# PLAN-166 W1-B — structural asserts for the release.yml verdict delta +
   680	# ancestry gate (F2 server side; re-pass r15+r17+r18, debate r3 scoped
   681	# VETO). Merged verbatim from the W1-B slice file
   682	# (test_release_workflow_asserts_w1b.py) by the PLAN-166 ceremony
   683	# assembler — one runnable asserts file per the W1 pack discipline. Only
   684	# names that would collide with the W1-A section above were renamed
   685	# (_MARKER → _MARKER_W1B, _LIVE_WF/_STAGED_WF → _W1B_*).
   686	#
   687	# What is pinned here, and why each pin exists:
   688	# - The gate step exists, carries NO continue-on-error, and FAILS CLOSED
   689	#   on CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 — the step-15 neighbourhood has
   690	#   two escape hatches keyed to that var (`continue-on-error:` and the
   691	#   empty `--parent-sha ""` bind, which the validator only binds when
   692	#   non-empty); the new gate must never inherit the switch.
   693	# - The delta decision is DELEGATED to
   694	#   .claude/scripts/local/_release_tag_guard.py (the reference
   695	#   implementation) — never re-implemented in bash.
   696	# - Ancestry covers BOTH the reviewed parent AND GITHUB_SHA (r18:
   697	#   parent-only lets the tag-without-push / orphan-verdict scenario pass).
   698	# - PINNED ORDER: Verify tag GPG signature → Validate pair-rail verdict →
   699	#   delta → ancestry.
   700	# - The job keeps the exact name `release-gate` — the W1-A
   701	#   await-release-gate poller resolves the job BY NAME via the Actions
   702	#   jobs endpoint; renaming the job silently breaks the npm-publish gate.
   703	# ---------------------------------------------------------------------
   704	
   705	# Marker written into the W1-B step's comment block; its presence in the
   706	# LIVE file means the ceremony landed and the live copy is authoritative.
   707	_MARKER_W1B = "PLAN-166 W1-B"
   708	
   709	_W1B_LIVE_WF = _WF / "release.yml"
   710	_W1B_STAGED_WF = _STAGED_166_WF / "release.yml"
   711	
   712	_W1B_STEP_NAME = "Verify verdict delta + ancestry (fail-closed)"
   713	_W1B_STEP15_NAME = "Validate pair-rail verdict"
   714	_W1B_GPG_STEP_NAME = "Verify tag GPG signature"
   715	_GUARD_MODULE = ".claude/scripts/local/_release_tag_guard.py"
   716	
   717	
   718	def _w1b_release_text() -> Optional[Tuple[str, str]]:
   719	    """Return (text, context) for release.yml, or None pre-landing.
   720	
   721	    Priority: live copy carrying the W1-B marker (post-landing,
   722	    authoritative) → staged ceremony copy (pre-landing local mirror;
   723	    gitignored so absent in CI) → None (pre-landing CI: skip).
   724	    """
   725	    if _W1B_LIVE_WF.is_file():
   726	        live = _W1B_LIVE_WF.read_text(encoding="utf-8")
   727	        if _MARKER_W1B in live:
   728	            return live, "live"
   729	    if _W1B_STAGED_WF.is_file():
   730	        return _W1B_STAGED_WF.read_text(encoding="utf-8"), "staged"
   731	    return None
   732	
   733	
   734	def _step_block(source: str, step_name: str) -> str:
   735	    """The text of one step: from its `- name:` to the next step/job."""
   736	    start = source.index("- name: %s" % step_name)
   737	    nxt = source.find("\n      - name:", start + 1)
   738	    job = source.find("\n  publish-release:", start + 1)
   739	    candidates = [i for i in (nxt, job) if i != -1]
   740	    end = min(candidates) if candidates else len(source)
   741	    return source[start:end]
   742	
