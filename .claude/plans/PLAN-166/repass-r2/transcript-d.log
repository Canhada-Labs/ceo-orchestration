   149	def audit_carrier_overrides(root: Path, *, sync_mode: bool = False) -> Dict[str, str]:
   150	    """Return the carrier env vars to SET so the FULL audit/HMAC surface resolves
   151	    under ``root`` (an isolated tmp tree), plus the sticky test signals.
   152	
   153	    Only the directory anchors + flags are SET; the per-file path overrides are
