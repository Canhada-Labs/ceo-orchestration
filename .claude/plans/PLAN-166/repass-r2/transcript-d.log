+    def test_cto_guide_carries_no_v0_roadmap_markers(self):
+        text = (REPO_ROOT / "docs" / "CTO-GUIDE.md").read_text(encoding="utf-8")
+        found = [m for m in self._STALE_MARKERS if m in text]
+        self.assertEqual(
