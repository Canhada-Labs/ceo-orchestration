   500	
   501	def _load_debate_converge() -> Any:
   502	    """Dynamic-import debate-converge.py (hyphen); sys.modules-cached
   503	    so @dataclass annotation resolution on Python 3.9 succeeds."""
   504	    import importlib.util
   505	    key = "debate_converge_module"
   506	    cached = sys.modules.get(key)
   507	    if cached is not None:
   508	        return cached
   509	    spec = importlib.util.spec_from_file_location(key, _script_dir() / "debate-converge.py")
   510	    if spec is None or spec.loader is None:
   511	        raise RuntimeError("failed to load debate-converge module")
   512	    mod = importlib.util.module_from_spec(spec)
   513	    sys.modules[key] = mod  # register BEFORE exec_module
   514	    spec.loader.exec_module(mod)
   515	    return mod
