   146	
   147	if [ -z "$AGENT_NAME" ]; then
   148	  echo "Usage: inject-agent-context.sh <AgentName> [task description]" >&2
   149	  echo "  <AgentName> must match: ^[A-Za-z][A-Za-z0-9 _-]{0,60}$" >&2
   150	  exit 1
   151	fi
