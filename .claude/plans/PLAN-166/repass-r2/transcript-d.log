   794	  # does. Kills the substring family: "security engineer" is a substring
   795	  # of "cybersecurity engineer" but never a component of it.
   796	  section=$(awk -v name="$AGENT_NAME" '
   797	    function norm(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return tolower(s) }
   798	    function exact(line,   h, i, parts) {
