   326	    def test_real_repo_per_document_liveness(self):
   327	        """Every watched (metric, doc) pair must match its EXACT count.
   328	
   329	        Both directions are failures: a pair that drops below its count
   330	        is silent coverage loss; a pair that appears or grows without the
   331	        manifest being updated is an unratified claim site."""
   332	        r = subprocess.run(
   333	            ["bash", str(SCRIPT), "--json", "--no-tests"],
   334	            capture_output=True, text=True, timeout=60, env=os.environ.copy())
   335	        self.assertEqual(r.returncode, 0, r.stdout)
   336	        by_doc = json.loads(r.stdout).get("rule_matches_by_doc", {})
   337	        # The dict diff is long and unreadable; the named lists below are
   338	        # the actionable part, so show them rather than the raw diff.
   339	        self.maxDiff = None
   340	        self.assertEqual(
   341	            by_doc, self._EXPECTED_SITES,
   342	            "watched claim sites drifted from the ratified manifest. "
   343	            "Lost: {0}. Unratified/new: {1}.".format(
   344	                sorted(k for k in self._EXPECTED_SITES
   345	                       if by_doc.get(k, 0) != self._EXPECTED_SITES[k]),
   346	                sorted(k for k in by_doc if k not in self._EXPECTED_SITES),
   347	            ))
