   415	def _run_json(root: Path, no_tests: bool = True) -> subprocess.CompletedProcess:
   416	    env = os.environ.copy()
   417	    env["VERIFY_COUNTS_ROOT"] = str(root)
   418	    args = ["bash", str(SCRIPT), "--json"]
