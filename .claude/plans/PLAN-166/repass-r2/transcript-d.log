   523	) -> Dict[str, object]:
   524	    """Import and call debate-converge's compute_convergence.
   525	
   526	    Returns the result dict. Raises FileNotFoundError if prior round
   527	    data is missing (orchestrator must ensure round N-1 exists before
   528	    calling check_convergence for round N).
   529	    """
   530	    return _load_debate_converge().compute_convergence(
   531	        plans_root, plan_id, round_num, threshold=threshold
   532	    )
