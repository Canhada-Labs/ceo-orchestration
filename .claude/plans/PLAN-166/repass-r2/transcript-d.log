   800	      if (norm(h) == norm(name)) return 1
   801	      gsub(/ — /, SUBSEP, h); gsub(/ - /, SUBSEP, h)
   802	      split(h, parts, SUBSEP)
   803	      for (i in parts) if (norm(parts[i]) == norm(name)) return 1
