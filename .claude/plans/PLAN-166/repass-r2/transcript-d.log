   488	def test_writer_table_covers_every_mode_of_the_live_oracle():
   489	    """Structural closure of the F-sites class: every (doc, mode) pair in the
   490	    LIVE verify-counts VERSION_SITES must have a writer site — derived from
   491	    the authority's own source, never recalled (closed-set lesson). A pair
   492	    added to the oracle without a writer is a mid-bump death deferred to the
   493	    next bump that moves that mode."""
   494	    text = (LOCAL / "verify-counts.sh").read_text(encoding="utf-8")
   495	    entries = re.findall(
   496	        r'\(\s*"([^"]+)",\s*r\'[^\']*\',\s*"(full|minor|prev_minor)"\s*\)', text
   497	    )
   498	    modes = {mode for _doc, mode in entries}
   499	    # parser liveness first: all three modes must be found, or the regex above
   500	    # went stale and "nothing missing" would mean nothing at all
   501	    assert {"full", "minor", "prev_minor"} <= modes, entries
   502	    writer = {(path, kind) for path, kind, _rx in bump_sites._SITES}
   503	    writer_paths = {path for path, _kind in writer}
   504	    missing = []
   505	    for doc, mode in entries:
   506	        covered = doc in writer_paths if mode == "full" else (doc, mode) in writer
   507	        if not covered:
   508	            missing.append((doc, mode))
   509	    assert not missing, (
   510	        "verify-counts VERSION_SITES entries with NO writer site (the next "
   511	        "bump that moves these modes dies mid-phase): %s" % missing
   512	    )
