   193	
   194	    def hit_rate(self) -> Optional[float]:
   195	        """Ratio hits / (hits + misses). None when n < 3 (low signal)."""
   196	        n = self.hit_count + self.miss_count
   197	        if n < 3:
   198	            return None
   199	        return self.hit_count / n
