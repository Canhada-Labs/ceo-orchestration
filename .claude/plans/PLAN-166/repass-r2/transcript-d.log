    67	# ---------------------------------------------------------------------------
    68	# helpers
    69	# ---------------------------------------------------------------------------
    70	def _env(home: Path) -> Dict[str, str]:
    71	    """A subprocess environment that cannot reach the real HOME or repo."""
    72	    env = dict(os.environ)
    73	    for key in ("CLAUDE_PROJECT_DIR", "GIT_DIR", "GIT_WORK_TREE"):
    74	        env.pop(key, None)
    75	    env.update(
    76	        {
    77	            "HOME": str(home),
    78	            "GNUPGHOME": str(home / "gnupg"),
    79	            "GIT_CONFIG_GLOBAL": str(home / "gitconfig"),
    80	            "GIT_CONFIG_SYSTEM": os.devnull,
    81	            "GIT_AUTHOR_NAME": "Release Test",
    82	            "GIT_AUTHOR_EMAIL": "release-test@example.invalid",
    83	            "GIT_COMMITTER_NAME": "Release Test",
    84	            "GIT_COMMITTER_EMAIL": "release-test@example.invalid",
    85	            "LC_ALL": "C",
    86	        }
    87	    )
    88	    return env
    89	
    90	
    91	def run(args: Sequence[str], cwd: Path, env: Dict[str, str]):
    92	    return subprocess.run(
    93	        list(args),
    94	        cwd=str(cwd),
    95	        env=env,
    96	        stdout=subprocess.PIPE,
    97	        stderr=subprocess.PIPE,
    98	        universal_newlines=True,
    99	    )
