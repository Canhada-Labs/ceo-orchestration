   348	        type=float,
   349	        default=DEFAULT_JACCARD_THRESHOLD,
   350	        help=f"Jaccard threshold for convergence (default {DEFAULT_JACCARD_THRESHOLD})",
   351	    )
   352	    return p.parse_args(argv)
   353	
   354	
   355	def main(argv: Optional[List[str]] = None) -> int:
   356	    """CLI entrypoint — compute Jaccard convergence across debate rounds."""
   357	    args = _parse(argv if argv is not None else sys.argv[1:])
   358	    if args.round_num < 2:
   359	        print(
   360	            f"ERROR: --round must be >= 2 (got {args.round_num})",
   361	            file=sys.stderr,
   362	        )
   363	        return 1
   364	    if not re.match(r"^PLAN-[0-9]{3}$", args.plan):
   365	        print(
   366	            f"ERROR: --plan must match PLAN-NNN (got {args.plan!r})",
   367	            file=sys.stderr,
   368	        )
   369	        return 1
   370	
   371	    plans_root = (
   372	        Path(args.plans_root).resolve() if args.plans_root else _plans_root_default()
   373	    )
   374	
   375	    try:
   376	        result = compute_convergence(
   377	            plans_root, args.plan, args.round_num, threshold=args.threshold
   378	        )
   379	    except FileNotFoundError as e:
   380	        print(f"ERROR: {e}", file=sys.stderr)
   381	        return 1
   382	    except RisksSectionEmptyError as e:
   383	        # W2.9(i) fail-closed: a critique with a Risks heading and zero
   384	        # parseable bullets is an input-parse failure, never a silent zero.
   385	        # Exit 4 is distinct so orchestrators can tell "fix the critique
   386	        # format" apart from convergence outcomes.
   387	        print(f"ERROR: {e}", file=sys.stderr)
   388	        return 4
   389	
   390	    if result.get("zero_coverage"):
   391	        # Still print the JSON (machine-readable) and exit 2
   392	        print(json.dumps(result, sort_keys=True))
   393	        return 2
   394	
   395	    # Exit code 3 signals terminal max-rounds-BELOW-threshold to the
   396	    # orchestrator + CI scripts (distinct from exit 0 converged / exit 4
   397	    # unparseable-critique). W2.9(iii): a ceiling round whose jaccard met
   398	    # the threshold reports outcome=converged and exits 0 — convergence
   399	    # at the ceiling is convergence (§12.4), so the flag alone no longer
   400	    # forces the impasse path.
   401	    if result.get("outcome") == _OUTCOME_MAX_ROUNDS:
   402	        print(json.dumps(result, sort_keys=True))
   403	        return 3
   404	
   405	    print(json.dumps(result, sort_keys=True))
   406	    return 0
   407	
   408	
   409	if __name__ == "__main__":
   410	    sys.exit(main())
