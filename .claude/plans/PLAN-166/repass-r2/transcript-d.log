   173	class TestRedTeamGateSemantics(unittest.TestCase):
   174	    """red_team_needed = converged AND round <= 2."""
   175	
   176	    def _make_min_tree(self, tmp: Path, round_num: int, risks: list) -> None:
   177	        """Create round-1 and round-N directories with identical risks."""
   178	        base = tmp / "PLAN-999" / "debate"
   179	        for r in range(1, round_num + 1):
   180	            d = base / f"round-{r}"
   181	            d.mkdir(parents=True, exist_ok=True)
   182	            bullets = "\n".join(f"- {x}" for x in risks)
   183	            (d / "a.md").write_text(
   184	                f"## Risks\n\n{bullets}\n", encoding="utf-8"
   185	            )
   186	
   187	    def test_converged_at_round_2_triggers_red_team(self):
   188	        tmp = Path(tempfile.mkdtemp(prefix="rt-gate-"))
   189	        try:
   190	            self._make_min_tree(tmp, 2, ["risk one", "risk two", "risk three"])
   191	            result = dc.compute_convergence(tmp, "PLAN-999", 2, threshold=0.7)
   192	            self.assertEqual(result["jaccard"], 1.0)
   193	            self.assertTrue(result["converged"])
   194	            self.assertTrue(result["red_team_needed"])
   195	        finally:
   196	            shutil.rmtree(tmp, ignore_errors=True)
   197	
   198	    def test_converged_at_round_3_does_not_trigger_red_team(self):
   199	        tmp = Path(tempfile.mkdtemp(prefix="rt-gate-r3-"))
   200	        try:
   201	            self._make_min_tree(tmp, 3, ["risk a", "risk b"])
   202	            result = dc.compute_convergence(tmp, "PLAN-999", 3, threshold=0.7)
   203	            self.assertTrue(result["converged"])
   204	            # round > 2 -> red_team_needed=False even though converged=True
   205	            self.assertFalse(result["red_team_needed"])
   206	        finally:
   207	            shutil.rmtree(tmp, ignore_errors=True)
   208	
   209	    def test_threshold_boundary_exact_0_7(self):
   210	        # Build a 7/10 overlap: 7 shared + 3 unique each side -> Jaccard = 7/13 ~= 0.538
   211	        # Easier: 7 shared + 0 unique -> 1.0; craft 7 shared + 3 unique in one to get 0.7.
   212	        # 7 shared, 3 unique in round-2 only: |inter|=7 |union|=10 -> 0.7 exact.
   213	        tmp = Path(tempfile.mkdtemp(prefix="rt-boundary-"))
   214	        try:
   215	            base = tmp / "PLAN-999" / "debate"
   216	            r1 = base / "round-1"
   217	            r1.mkdir(parents=True)
   218	            shared = [f"shared risk {i}" for i in range(7)]
   219	            (r1 / "a.md").write_text(
   220	                "## Risks\n\n"
   221	                + "\n".join(f"- {s}" for s in shared)
   222	                + "\n",
   223	                encoding="utf-8",
   224	            )
   225	            r2 = base / "round-2"
   226	            r2.mkdir(parents=True)
   227	            unique = [f"unique r2 {i}" for i in range(3)]
   228	            (r2 / "a.md").write_text(
   229	                "## Risks\n\n"
   230	                + "\n".join(f"- {s}" for s in shared + unique)
   231	                + "\n",
   232	                encoding="utf-8",
   233	            )
   234	            result = dc.compute_convergence(tmp, "PLAN-999", 2, threshold=0.7)
   235	            self.assertAlmostEqual(result["jaccard"], 0.7, places=3)
   236	            self.assertTrue(result["converged"])  # >= 0.7 is converged
   237	        finally:
   238	            shutil.rmtree(tmp, ignore_errors=True)
