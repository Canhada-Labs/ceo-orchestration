   227	
   228	def _support_window(version: str):
   229	    """(current_minor, previous_minor) the way the live oracle derives them:
   230	    prev = minor-1, None (not derivable) at X.0."""
   231	    maj, mnr = (int(x) for x in version.split(".")[:2])
   232	    prev = "%d.%d" % (maj, mnr - 1) if mnr > 0 else None
   233	    return "%d.%d" % (maj, mnr), prev
   234	
   235	
   236	def write_sites(repo: Path, version: str, stamp_date: str) -> None:
   237	    (repo / "npm").mkdir(exist_ok=True)
   238	    (repo / "docs").mkdir(exist_ok=True)
   239	    stamp = "<!-- last-reviewed: %s v%s -->" % (stamp_date, version)
   240	    cur_minor, prev_minor = _support_window(version)
   241	    prev_sec = (
   242	        "- **Previous MINOR** (`v%s.x`) — security-only patches.\n" % prev_minor
   243	        if prev_minor
   244	        else ""
   245	    )
   246	    prev_ver = (
   247	        "| Previous MINOR (`v%s.x`) | Security-only patches |\n" % prev_minor
   248	        if prev_minor
   249	        else ""
   250	    )
   251	    (repo / "VERSION").write_text(version + "\n", encoding="utf-8")
   252	    (repo / "npm" / "package.json").write_text(
   253	        json.dumps({"name": "fixture", "version": version}, indent=2) + "\n",
   254	        encoding="utf-8",
   255	    )
   256	    (repo / "pyproject.toml").write_text(
   257	        '[project]\nname = "fixture"\nversion = "%s"\n' % version, encoding="utf-8"
   258	    )
   259	    (repo / "INSTALL.md").write_text(
   260	        "bash install.sh --pin v%s\n" % version, encoding="utf-8"
   261	    )
   262	    (repo / "docs" / "ARCHITECTURE.md").write_text(
   263	        "The framework is currently v%s, aligned with the repo VERSION.\n" % version,
   264	        encoding="utf-8",
   265	    )
   266	    (repo / "npm" / "README.md").write_text(
   267	        "# fixture\n\n%s\n" % stamp, encoding="utf-8"
   268	    )
   269	    (repo / "README.md").write_text("VERSION=%s\n" % version, encoding="utf-8")
   270	    (repo / "SBOM.md").write_text(
   271	        "%s\n\n**Version:** `%s` (tracks repo-root VERSION)\n" % (stamp, version),
   272	        encoding="utf-8",
   273	    )
   274	    (repo / "SECURITY.md").write_text(
   275	        "%s\n\n# Security\n\n"
   276	        "- **Current MINOR** (`v%s.x`) — full security support.\n"
   277	        "%s" % (stamp, cur_minor, prev_sec),
   278	        encoding="utf-8",
   279	    )
   280	    (repo / "VERSIONING.md").write_text(
   281	        "%s\n\n# Versioning\n\n"
   282	        "| Current MINOR (`v%s.x`) | Full support |\n"
   283	        "%s" % (stamp, cur_minor, prev_ver),
   284	        encoding="utf-8",
   285	    )
   286	    (repo / "CHANGELOG.md").write_text(
   287	        "# Changelog\n\n## [1.3.0]\n\n- fixture\n", encoding="utf-8"
   288	    )
