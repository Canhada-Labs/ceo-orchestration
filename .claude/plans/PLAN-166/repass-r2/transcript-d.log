   853	  fi
   854	fi
   855	
   856	if [ "$FOUND_PROFILE" -eq 0 ]; then
   857	  # Rung 3 — a role that exists ONLY as a SKILL MAP row (no persona, no
   858	  # agents/ file, e.g. "VP Engineering") gets a profile synthesized from
   859	  # the row itself — name + skill + authority — labeled as such. This is
   860	  # what the CEO assembled by hand in S298; now it is the mechanism.
