   424	def _pytest_scaffold(root: Path, cases: int = 100, broken: bool = False) -> None:
   425	    """Give the synthetic tree a REAL pytest-collect population so the gate's
   426	    full run (no --no-tests) derives a live `tests` value inside the tree."""
   427	    (root / "pytest.ini").write_text("[pytest]\ntestpaths = tests\n",
   428	                                     encoding="utf-8")
   429	    tdir = root / "tests"
   430	    tdir.mkdir(exist_ok=True)
   431	    (tdir / "test_ok.py").write_text(
   432	        "import pytest\n"
   433	        f"@pytest.mark.parametrize('i', range({cases}))\n"
   434	        "def test_p(i):\n    pass\n",
   435	        encoding="utf-8",
   436	    )
   437	    if broken:
