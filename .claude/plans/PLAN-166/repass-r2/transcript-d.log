   242	def write_sites(repo: Path, version: str, stamp_date: str) -> None:
   243	    (repo / "npm").mkdir(exist_ok=True)
   244	    (repo / "docs").mkdir(exist_ok=True)
   245	    stamp = "<!-- last-reviewed: %s v%s -->" % (stamp_date, version)
   246	    cur_minor, prev_minor = _support_window(version)
   247	    prev_sec = (
   248	        "- **Previous MINOR** (`v%s.x`) — security-only patches.\n" % prev_minor
   249	        if prev_minor
   250	        else ""
   251	    )
   252	    prev_ver = (
   253	        "| Previous MINOR (`v%s.x`) | Security-only patches |\n" % prev_minor
   254	        if prev_minor
   255	        else ""
   256	    )
   257	    (repo / "VERSION").write_text(version + "\n", encoding="utf-8")
   258	    # repass-r2 part-d P2: the marker site (W2.6) exists in the fixture so
   259	    # the e2e bump exercises the writer AND the stub oracle checks it.
   260	    (repo / ".claude").mkdir(exist_ok=True)
   261	    (repo / ".claude" / ".framework-version").write_text(
   262	        version + "\n", encoding="utf-8"
