    81	def plugin_manifest(version: str = VERSION) -> dict:
    82	    """Plugin manifest content — PURE: depends only on `version` + literals.
    83	
    84	    Determinism contract (PLAN-153 B6): no timestamps, no environment reads,
    85	    no filesystem scans. Serialize only via dump_manifest()."""
    86	    return {
    87	        "name": NS,
    88	        "description": (
    89	            "CEO Orchestration — run Claude Code as a governed team of specialist agents: "
    90	            "Plan->Debate->Execute, tamper-evident audit chain, cross-LLM Codex review, "
    91	            "a curated skill-checklist library, and a zero-config edit->verify->review accelerator loop."
    92	        ),
    93	        "version": version,
    94	        "author": {"name": "CEO Orchestration"},
    95	        "license": "MIT",
    96	        "keywords": ["governance", "audit", "orchestration", "agents", "skills", "code-review"],
