   734	def _step_block(source: str, step_name: str) -> str:
   735	    """The text of one step: from its `- name:` to the next step/job."""
   736	    start = source.index("- name: %s" % step_name)
   737	    nxt = source.find("\n      - name:", start + 1)
   738	    job = source.find("\n  publish-release:", start + 1)
   739	    candidates = [i for i in (nxt, job) if i != -1]
   740	    end = min(candidates) if candidates else len(source)
   741	    return source[start:end]
