   128	def manifest_path_from_workflows() -> Path:
   129	    """The manifest path as the CONSUMER spells it (release.yml step 15)."""
   130	    wf_dir = REPO / ".github" / "workflows"
   131	    found = set()
   132	    for wf in sorted(wf_dir.glob("*.yml")):
   133	        text = wf.read_text(encoding="utf-8")
   134	        for m in re.finditer(re.escape(_FLAG) + r"\s+([^\s\\]+)", text):
   135	            found.add(m.group(1).strip("'\""))
   136	    if not found:
   137	        raise AssertionError(
   138	            "no workflow passes %s — either the pair-rail replay defence was "
   139	            "removed (a governance regression) or the flag was renamed; this "
   140	            "guard refuses to pass vacuously" % _FLAG
   141	        )
   142	    if len(found) != 1:
   143	        raise AssertionError(
   144	            "workflows disagree on the inputs manifest: %s" % sorted(found)
   145	        )
   146	    return REPO / sorted(found)[0]
