   957	class W1BGuardModuleContractTest(TestEnvContext):
   958	    """The live module surface the workflow step depends on.
   959	
   960	    These asserts pin the CONTRACT the W1-B step consumes, so a module
   961	    refactor that renames a subcommand or the parser is caught by the
   962	    suite before it bricks a release run.
   963	    """
   964	
   965	    def setUp(self):
   966	        super().setUp()
   967	        self.module_path = _REPO / _GUARD_MODULE
   968	        if not self.module_path.is_file():
   969	            self.fail(
   970	                "%s missing — the W1-B release.yml step invokes it; "
   971	                "landing the workflow without the module bricks every "
   972	                "release run" % _GUARD_MODULE
   973	            )
   974	        import importlib.util
   975	
   976	        spec = importlib.util.spec_from_file_location(
   977	            "release_tag_guard_w1b_contract", str(self.module_path)
   978	        )
   979	        self.mod = importlib.util.module_from_spec(spec)
   980	        spec.loader.exec_module(self.mod)
   981	
   982	    def test_module_exposes_the_consumed_surface(self):
   983	        for attr in ("_parse_verdict", "delta", "ancestry", "main"):
   984	            self.assertTrue(
   985	                hasattr(self.mod, attr),
   986	                "module lost %r — the W1-B workflow step consumes it"
   987	                % attr,
   988	            )
   989	
   990	    def test_parse_verdict_reads_parent_sha(self):
   991	        fields = self.mod._parse_verdict(
   992	            "# t\n\n```yaml\nparent_sha: "
   993	            "4111a115190d375c39c90cc33ac1d9d5899c1cf2\n```\n"
   994	        )
   995	        self.assertEqual(
   996	            fields.get("parent_sha"),
   997	            "4111a115190d375c39c90cc33ac1d9d5899c1cf2",
   998	        )
   999	
  1000	    def test_module_exit_codes_are_distinct_nonzero(self):
  1001	        # The workflow relies on ANY non-zero exit failing the step
  1002	        # (set -euo pipefail); pin that the module's failure codes are
  1003	        # non-zero and mutually distinct so the failure MODE stays
  1004	        # testable.
  1005	        codes = [
  1006	            self.mod.E_USAGE, self.mod.E_FETCH, self.mod.E_NOT_ANCESTOR,
  1007	            self.mod.E_REMOTE_REF, self.mod.E_DELTA,
  1008	            self.mod.E_MANIFEST_PIN, self.mod.E_MANIFEST_CONTENT,
  1009	            self.mod.E_MANIFEST_SET, self.mod.E_VERDICT, self.mod.E_VACUOUS,
  1010	        ]
  1011	        self.assertNotIn(0, codes)
  1012	        self.assertEqual(len(codes), len(set(codes)))
