  1042	def _plan168_text(name: str) -> Optional[Tuple[str, str]]:
  1043	    """Return (text, context) for a PLAN-168 workflow edit, or None pre-landing."""
  1044	    live = _WF / name
  1045	    if live.is_file():
  1046	        live_text = live.read_text(encoding="utf-8")
  1047	        if _MARKER_168 in live_text:
  1048	            return live_text, "live"
  1049	    staged = _STAGED_168_WF / name
  1050	    if staged.is_file():
  1051	        return staged.read_text(encoding="utf-8"), "staged"
  1052	    return None
