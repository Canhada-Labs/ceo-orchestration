  1055	def _workflow_paths_lists(text: str) -> Tuple[list, list]:
  1056	    """Extract (pull_request.paths, push.paths) entries from workflow text.
  1057	
  1058	    Text-based on purpose (this file's convention — no yaml dependency in
  1059	    the stdlib-only posture). Collects quoted `- "..."` items under each
  1060	    `paths:` key, skipping comments, stopping at the first line that
  1061	    dedents to the `paths:` level or shallower.
  1062	    """
  1063	    results = []
  1064	    for trigger in ("pull_request:", "push:"):
  1065	        lines = text.splitlines()
  1066	        try:
  1067	            t_idx = next(
  1068	                i for i, ln in enumerate(lines)
  1069	                if ln.strip() == trigger
  1070	                and (len(ln) - len(ln.lstrip())) == 2
  1071	            )
  1072	        except StopIteration:
  1073	            results.append([])
  1074	            continue
  1075	        entries = []
  1076	        paths_indent = None
  1077	        for ln in lines[t_idx + 1:]:
  1078	            stripped = ln.strip()
  1079	            indent = len(ln) - len(ln.lstrip())
  1080	            if stripped and indent <= 2:
  1081	                break  # next trigger / top-level key
  1082	            if paths_indent is None:
  1083	                if stripped == "paths:":
  1084	                    paths_indent = indent
  1085	                continue
  1086	            if not stripped or stripped.startswith("#"):
  1087	                continue
  1088	            if indent <= paths_indent:
  1089	                break
  1090	            m = re.match(r'-\s+"([^"]+)"', stripped)
  1091	            if m:
  1092	                entries.append(m.group(1))
  1093	        results.append(entries)
  1094	    return results[0], results[1]
  1095	
