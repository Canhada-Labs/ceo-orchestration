   206	def extract_runs(payload: Any) -> List[Dict[str, Any]]:
   207	    """Pull the run list out of the payload, or raise MalformedPayload.
   208	
   209	    Accepts the raw GitHub envelope (``workflow_runs``) or a plain ``runs``
   210	    list. An API error body (``{"message": "Bad credentials", ...}``) has
   211	    neither key and therefore raises — BLOCK, by design.
   212	    """
   213	    if not isinstance(payload, dict):
   214	        raise MalformedPayload("payload is %s, expected a JSON object" % type(payload).__name__)
