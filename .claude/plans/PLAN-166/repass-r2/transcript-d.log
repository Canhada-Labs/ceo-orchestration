   104	concurrency:
   105	  group: smoke-install-${{ github.ref }}
   106	  cancel-in-progress: true
   107	
   108	jobs:
   109	  smoke:
   110	    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity.
   111	    if: vars.CEO_SOTA_DISABLE != '1'
   112	    runs-on: ubuntu-latest
   113	    # PLAN-161: 5 -> 8 — headroom for the two upgrade oracles (each runs
   114	    # full install + upgrade legs against fixture adopter repos).
   115	    # PLAN-166 F4: 8 -> 20. MEASURED, not guessed. The parity e2e runs 2 full
   116	    # install legs + 1 upgrade leg PER ceremony mode, and the positive control
   117	    # runs the same again with a planted divergence: 12 install/upgrade
   118	    # operations added to this job. Local wall time (Darwin arm64, 16 cores,
   119	    # 2026-08-05): gate 122s + control 118s = 240s. A 2-core ubuntu-latest
   120	    # runner is the usual 2-3x slower, i.e. 8-12 min of NEW work on top of the
   121	    # ~5 min this job already spent. 15 would sit inside the noise band, and
   122	    # the perf-gate N=20 flake (PLAN-159) was exactly that mistake. Re-tighten
   123	    # once real CI runs give a p95.
   124	    # PLAN-166 F3 (assembler): 20 -> 25. The spec-ownership e2e adds 4 more
   125	    # installs + 3 upgrades (S1-S8; ~3-4 min local per the W1-C measurement),
   126	    # i.e. up to ~8-10 more CI minutes at the same 2-3x factor. Same
   127	    # anti-flake sizing rule as the F4 bump above.
   128	    timeout-minutes: 25
   129	    permissions:
   130	      contents: read
   131	    steps:
   132	      - name: Checkout
   133	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   134	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   135	        with:
   136	          fetch-depth: 1
   137	
   138	      # PLAN-166 F4: the parity e2e's historical leg installs from a PINNED
   139	      # TAG. `fetch-depth: 1` produces a checkout with NO tags, so the pin
   140	      # would not resolve and the gate would die before comparing a single
   141	      # tree - "it passes on my clone" is precisely the hole this test exists
   142	      # to close. The pin is READ FROM THE TEST (--print-pin) so the workflow
   143	      # never becomes a second copy of that truth.
   144	      - name: Fetch the parity pin tag
   145	        run: |
   146	          set -euo pipefail
   147	          PIN="$(bash scripts/tests/test-install-upgrade-parity-e2e.sh --print-pin)"
   148	          echo "parity historical pin: $PIN"
   149	          git fetch --no-tags --depth 1 origin "+refs/tags/$PIN:refs/tags/$PIN"
   150	          git rev-parse --verify "refs/tags/$PIN^{commit}"
   151	
   152	      - name: Setup Python 3.11
   153	        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
   154	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
   155	        with:
   156	          python-version: "3.11"
   157	
   158	      - name: Install jq (for settings.json merge)
   159	        run: |
   160	          set -euo pipefail
   161	          if ! command -v jq >/dev/null 2>&1; then
   162	            sudo apt-get update -qq
   163	            sudo apt-get install -y -qq jq
   164	          fi
   165	          jq --version
   166	
   167	      # PLAN-168 W1 (AC-4, per-PR half): the DECISION oracle —
   168	      # _ownership_verdict() against every truth-table cell, in milliseconds.
   169	      # The OBSERVATION half (the ~25-min e2e) runs in ownership-nightly.yml;
   170	      # this fast half is what makes table/harness PRs cheap to gate.
   171	      - name: Ownership verdict unit oracle (milliseconds)
   172	        run: |
   173	          set -euo pipefail
   174	          bash scripts/tests/test-ownership-verdict-unit.sh
   175	
   176	      # PLAN-168 W1 (rail r3 P1): the nightly gate's fake-harness control is
   177	      # milliseconds — run it per-PR so a PR touching the gate cannot break
   178	      # its rc/status handling while PR checks stay green.
   179	      - name: Ownership nightly-gate positive control (fake harness)
   180	        run: |
   181	          set -euo pipefail
   182	          bash scripts/tests/test-ownership-nightly-gate.sh
   183	
   184	      # PLAN-168 W2 (AC-6, per-PR half of INV-4): the shared pointer
   185	      # generator's 8-scenario control — includes ONE real install (~1-2 min
   186	      # on CI iron). The full install->upgrade->cure e2e (4 legs, ~5 min CI)
   187	      # is nightly-only; MEASURED per the smoke budget notes above.
   188	      - name: Protocol pointer render control (generator parity)
   189	        run: |
   190	          set -euo pipefail
   191	          bash scripts/tests/test-protocol-pointer-render.sh
   192	
   193	      - name: Run smoke install
   194	        run: |
   195	          set -euo pipefail
   196	          bash scripts/tests/smoke-install.sh
   197	
   198	      # PLAN-161 upgrade oracles (green only once the U1/U2/U3 upgrade.sh
   199	      # fixes are in-tree — land atomically with them).
   200	      - name: Upgrade oracle — --dry-run identity (U1)
   201	        run: |
   202	          set -euo pipefail
   203	          bash scripts/tests/test-upgrade-dryrun-identity.sh
   204	
   205	      - name: Upgrade oracle — exclusion parity + opt-in purge (U2/U3)
   206	        run: |
   207	          set -euo pipefail
   208	          bash scripts/tests/test-upgrade-exclusions.sh
   209	
   210	      # WS4-user-ceremony-leg
   211	      - name: Install with --ceremony user (governance rc=0 + no out-of-.claude writes)
   212	        run: |
   213	          set -euo pipefail
   214	          U="$(mktemp -d)"
   215	          ( cd "$U" && git init -q )
   216	          CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   217	            bash scripts/install.sh "$U" --ceremony user
   218	          echo '--- validate-governance.sh (user) ---'
   219	          ( cd "$U" && bash .claude/scripts/validate-governance.sh )
   220	          echo '--- assert only .claude/ at top level ---'  # WS4-sc2010-glob
   221	          extra=""
   222	          for _e in "$U"/* "$U"/.[!.]* "$U"/..?*; do
   223	            [ -e "$_e" ] || continue
   224	            _b="$(basename "$_e")"
   225	            case "$_b" in .claude|.git) continue ;; esac
   226	            extra="$extra $_b"
   227	          done
   228	          if [ -n "$extra" ]; then
   229	            echo "::error::--ceremony user wrote outside .claude/:$extra"
   230	            exit 1
     1	name: Ownership Nightly
     2	
     3	# PLAN-168 W1 (AC-4/AC-5, Owner decision D4): the ownership e2e runs the FULL
     4	# truth table — 62 real install/upgrade cells, ~25 min locally, 2-3x that on a
     5	# 2-core runner — so it cannot live inside smoke-install's 25-min job (that
     6	# budget was already raised 4x: 5→8→20→25). And `schedule:` events IGNORE
     7	# `paths:` filters, so the nightly split is a separate WORKFLOW, not a filter
     8	# entry (debate r1 devops must-fix 1). The fast per-PR half (the unit oracle)
     9	# stays in smoke-install.yml.
    10	#
    11	# The gate compares the observed non-GREEN set against
    12	# scripts/tests/ownership-expected-reds.txt and fails on ANY difference —
    13	# including shrinkage. 4 deliberate reds are part of the contract
    14	# (CLAUDE.md §4): an all-green run means the table changed — STOP and find
    15	# out why, never celebrate. NEVER run the harness with --map here: --map is a
    16	# reporting mode that exits 0 over failures (a dead gate by construction).
    17	
    18	on:
    19	  schedule:
    20	    # Off-peak UTC, off-minute deliberately (fleet etiquette — avoid :00/:30).
    21	    - cron: "43 6 * * *"
    22	  # Manual runs for harness/table PRs that want the full e2e before merge.
    23	  workflow_dispatch: {}
    24	
    25	concurrency:
    26	  group: ownership-nightly
    27	  cancel-in-progress: true
    28	
    29	jobs:
    30	  ownership-e2e:
    31	    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity (same switch as smoke-install).
    32	    if: vars.CEO_SOTA_DISABLE != '1'
    33	    runs-on: ubuntu-latest
    34	    # ~25 min local (Darwin arm64, 16 cores, 2026-08-07); ubuntu-latest is the
    35	    # usual 2-3x slower => 50-75 min expected. Same anti-flake sizing rule as
    36	    # the smoke-install budget notes: leave headroom, re-tighten on a real p95.
    37	    timeout-minutes: 90
    38	    permissions:
    39	      contents: read
    40	    steps:
    41	      - name: Checkout
    42	        # SHA-pinned (same pin as smoke-install.yml): actions/checkout@v6.0.2
    43	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
    44	        with:
    45	          fetch-depth: 1
    46	
    47	      # `fetch-depth: 1` produces a checkout with NO tags, and the
    48	      # legacy_pristine* fixtures build from a REAL shipped tree. The tag is
    49	      # READ FROM THE HARNESS (--print-legacy-tag) so this workflow never
    50	      # becomes a second copy of that truth (same --print-pin shape as the
    51	      # parity e2e in smoke-install.yml).
    52	      - name: Fetch the legacy_pristine tag
    53	        run: |
    54	          set -euo pipefail
    55	          TAG="$(bash scripts/tests/test-ownership-table.sh --print-legacy-tag)"
    56	          echo "legacy pristine tag: $TAG"
    57	          git fetch --no-tags --depth 1 origin "+refs/tags/$TAG:refs/tags/$TAG"
    58	          git rev-parse --verify "refs/tags/$TAG^{commit}"
    59	
    60	      - name: Install jq (install.sh settings merge dependency)
    61	        run: |
    62	          set -euo pipefail
    63	          if ! command -v jq >/dev/null 2>&1; then
    64	            sudo apt-get update -qq
    65	            sudo apt-get install -y -qq jq
    66	          fi
    67	          jq --version
    68	
    69	      # Fast preflight: a broken DECISION should fail in milliseconds here,
    70	      # not 40 minutes into the observation run.
    71	      - name: Ownership verdict unit oracle (preflight)
    72	        run: |
    73	          set -euo pipefail
    74	          bash scripts/tests/test-ownership-verdict-unit.sh
    75	
    76	      # PLAN-168 W2 (AC-6/AC-6b): INV-4 as an executable assertion — install
    77	      # and upgrade produce the SAME pointer (byte identity + content
    78	      # soundness), repeat upgrades are idempotent, a degraded body is CURED
    79	      # with backup, and an adopter-customized pointer is PRESERVED (S238).
    80	      - name: Protocol pointer INV-4 e2e (4 legs)
    81	        run: |
    82	          set -euo pipefail
    83	          bash scripts/tests/test-protocol-pointer-inv4.sh
    84	
    85	      # The gate itself is proven BEFORE it is trusted: every failure mode it
    86	      # claims to catch is planted with a fake harness and must go red. A CI
    87	      # gate nobody can test is a gate nobody has proven (PLAN-167: 8
    88	      # instrument defects).
    89	      - name: Gate positive control (planted failure modes)
    90	        run: |
    91	          set -euo pipefail
    92	          bash scripts/tests/test-ownership-nightly-gate.sh
    93	
    94	      # PLAN-168 AC-5 — the SCRIPT is the gate (debate r1 QA must-fix 2:
    95	      # describing behavior is not a gate). ownership-nightly-gate.sh runs the
    96	      # e2e and enforces: rc>=2 = infra error (never comparable); summary line
    97	      # present with HARNESS-ERR=0 (partial output fails); observed non-GREEN
    98	      # id set == scripts/tests/ownership-expected-reds.txt exactly; rc
    99	      # coherent with the set (non-empty => rc=1, empty => rc=0). NEVER --map.
   100	      - name: Ownership e2e — full table vs expected non-GREEN set
   101	        env:
   102	          # 60s/cell flakes on 2-core CI iron (2-3x slower than the local
   103	          # baseline the default was sized on).
   104	          CELL_TIMEOUT: "180"
   105	        run: |
   106	          set -euo pipefail
