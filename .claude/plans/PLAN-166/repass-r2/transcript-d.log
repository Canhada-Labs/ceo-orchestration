    52	import argparse
    53	import json
    54	import re
    55	import string
    56	import sys
    57	from dataclasses import dataclass
    58	from pathlib import Path
    59	from typing import Iterable, List, Optional, Set
    60	
    61	
    62	# Default threshold; overridable via --threshold for stress tests.
    63	DEFAULT_JACCARD_THRESHOLD = 0.7
    64	
    65	# MAX_ROUNDS — HARD STOP (PLAN-012 Phase 1 D3.5 + debate round-1
    66	# chaos-engineer.md CRITICAL-2 "cost runaway via adversarial injection";
    67	# ADR-032 amendment). compute_convergence() forces outcome
    68	# "max_rounds_reached" when round_number >= MAX_ROUNDS, independent of
    69	# Jaccard score and budget hook state.
    70	MAX_ROUNDS = 5
    71	
    72	_OUTCOME_CONVERGED = "converged"
    73	_OUTCOME_DIVERGED = "diverged"
    74	_OUTCOME_MAX_ROUNDS = "max_rounds_reached"
