+    mod.write_text(
+        src.replace(
+            marker,
+            '_SITES.append(("EXTRA.md", PLAIN, r"(pinned v)" + SEMVER))\n\n' + marker,
+        ),
+        encoding="utf-8",
+    )
+    write_sites(repo, "1.2.0", D0)
+    run([sys.executable, "scripts/build-plugin.py", "--write-manifests"], repo, env)
+    git(repo, env, "add", "-A")
