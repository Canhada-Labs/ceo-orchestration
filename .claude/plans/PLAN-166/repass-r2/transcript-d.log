    40	def _fixture_plans_root_from(fixture_name: str) -> Path:
    41	    """Copy a fixture into a tempdir shaped as .claude/plans/PLAN-NNN/debate.
    42	
    43	    Returns the tempdir path to use as --plans-root.
    44	    """
    45	    src = _FIXTURES / fixture_name
    46	    tmp = Path(tempfile.mkdtemp(prefix=f"converge-test-{fixture_name}-"))
    47	    # Shape: tmp/PLAN-999/debate/round-1/*  tmp/PLAN-999/debate/round-2/*
    48	    target_base = tmp / "PLAN-999" / "debate"
    49	    target_base.mkdir(parents=True)
    50	    for sub in src.iterdir():
    51	        if sub.is_dir() and sub.name.startswith("round-"):
    52	            shutil.copytree(sub, target_base / sub.name)
    53	    return tmp
