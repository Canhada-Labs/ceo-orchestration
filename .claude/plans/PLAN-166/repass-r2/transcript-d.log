   183	def bump_reference_paths() -> List[str]:
   184	    """Every path a `release.sh bump` may rewrite: module table + generated."""
   185	    out: List[str] = list(BUMP.site_paths(include_generated=False))
   186	    for p in generated_manifest_paths():
   187	        if p not in out:
   188	            out.append(p)
   189	    return out
