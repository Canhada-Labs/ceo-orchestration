   716	# ===========================================================================
   717	# tag guard — restricted delta
   718	# ===========================================================================
   719	def make_repass(repo: Path, slug: str, artifacts: Dict[str, str]) -> Dict[str, str]:
   720	    directory = repo / ".claude/plans/PLAN-166" / slug
   721	    directory.mkdir(parents=True, exist_ok=True)
   722	    lines: List[str] = []
   723	    for name, body in sorted(artifacts.items()):
   724	        (directory / name).write_text(body, encoding="utf-8")
   725	        lines.append("%s  %s" % (sha256_file(directory / name), name))
   726	    manifest = directory / "MANIFEST.sha256"
   727	    manifest.write_text("\n".join(lines) + "\n", encoding="utf-8")
   728	    rel = ".claude/plans/PLAN-166/%s" % slug
   729	    return {
   730	        "dir": rel,
   731	        "manifest_rel": "%s/MANIFEST.sha256" % rel,
   732	        "manifest_sha": sha256_file(manifest),
   733	        "artifact_rels": ["%s/%s" % (rel, n) for n in sorted(artifacts)],
   734	    }
   735	
   736	
   737	def write_verdict(
   738	    repo: Path,
   739	    tag: str,
   740	    parent: str,
   741	    allowlist: Sequence[str],
   742	    manifest_rel: str,
   743	    manifest_sha: str,
   744	) -> str:
   745	    rel = ".claude/governance/pair-rail-verdict-%s.md" % tag
   746	    path = repo / rel
   747	    path.parent.mkdir(parents=True, exist_ok=True)
   748	    entries = "\n".join("  - %s" % e for e in allowlist)
   749	    path.write_text(
   750	        "# Pair-Rail Verdict — %s\n\n```yaml\nverdict: GO\nrelease_tag: %s\n"
   751	        "parent_sha: %s\ndelta_allowlist:\n%s\ndelta_manifest: %s\n"
   752	        "delta_manifest_sha256: %s\n```\n" % (
   753	            tag, tag, parent, entries, manifest_rel, manifest_sha,
   754	        ),
   755	        encoding="utf-8",
   756	    )
   757	    return rel
   758	
   759	
   760	def arm_verdict(synth, tag: str, slug: str = "repass-r2", extra_allow=()):
   760	def arm_verdict(synth, tag: str, slug: str = "repass-r2", extra_allow=()):
   761	    """Commit a re-pass + verdict for `tag`, anchored at the pre-verdict HEAD."""
   762	    repo, env = synth["repo"], synth["env"]
   763	    parent = git(repo, env, "rev-parse", "HEAD")
   764	    ev = make_repass(
   765	        repo, slug, {"verdict-r1.txt": "GO\n", "transcript-r1.log": "rounds: 3\n"}
   766	    )
   767	    verdict_rel = ".claude/governance/pair-rail-verdict-%s.md" % tag
   768	    allow = [verdict_rel, ev["manifest_rel"]] + ev["artifact_rels"] + list(extra_allow)
   769	    write_verdict(repo, tag, parent, allow, ev["manifest_rel"], ev["manifest_sha"])
   770	    git(repo, env, "add", "-A")
   771	    git(repo, env, "commit", "-q", "-m", "governance: verdict %s" % tag)
   772	    git(repo, env, "push", "-q", "origin", "main")
   773	    git(repo, env, "fetch", "-q", "origin", "main")
   774	    return {"parent": parent, "verdict_rel": verdict_rel, "ev": ev}
   775	
