   221	                + "\n".join(f"- {s}" for s in shared)
   222	                + "\n",
   223	                encoding="utf-8",
   224	            )
   225	            r2 = base / "round-2"
   226	            r2.mkdir(parents=True)
   227	            unique = [f"unique r2 {i}" for i in range(3)]
   228	            (r2 / "a.md").write_text(
