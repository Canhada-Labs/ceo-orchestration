   419	        return _fail(
   420	            E_MANIFEST_PIN,
   421	            "delta_manifest sha256 mismatch for %s\n"
   422	            "      verdict pins %s\n"
   423	            "      on disk      %s" % (manifest_rel, manifest_sha, actual),
   424	        )
   425	    print("  ok   %s matches the sha256 pinned in the verdict" % manifest_rel)
   426	
   427	    try:
   428	        entries = _read_manifest(manifest_abs)
   429	    except (OSError, ValueError) as exc:
   430	        return _fail(E_MANIFEST_CONTENT, "cannot read %s: %s" % (manifest_rel, exc))
   431	    good, detail = _verify_manifest_content(manifest_abs)
   432	    if not good:
   433	        return _fail(
   434	            E_MANIFEST_CONTENT,
   435	            "re-pass artifacts do not match %s (shasum -c failed):\n      %s"
   436	            % (manifest_rel, detail),
   437	        )
   438	    print("  ok   shasum -a 256 -c %s (%d entries)" % (manifest_rel, len(entries)))
   439	
   440	    # --- plan-side entries OUTSIDE the manifest directory ---
   441	    # Everything inside the manifest directory is content-pinned (sha256 of
   442	    # the manifest in the signed verdict + shasum -c + name equality below).
   443	    # An EVIDENCE_PREFIX entry outside it closes by NAME ONLY — the plan file
   444	    # itself, immutable repass history, or ANOTHER tag's verdict-fields could
   445	    # be allowlisted and a post-review edit would ride the tag. The one such
   446	    # file the plan promises is the verdict-fields for THIS tag, at its ONE
   447	    # canonical path: directly inside the plan directory that CONTAINS the
   448	    # manifest dir. A basename-only rule would admit any number of
   449	    # look-alikes anywhere under EVIDENCE_PREFIX (plans/archive/, a sibling
   450	    # repass dir, ...), each an unpinned name-only pass-through. Mirror this
   451	    # rule in the W1 server-side port.
   452	    man_dir = os.path.dirname(manifest_rel)
   453	    plan_dir = os.path.dirname(man_dir)
   454	    vf_name = "verdict-fields-%s.md" % tag
   455	    vf_expected = "%s/%s" % (plan_dir, vf_name) if plan_dir else vf_name
   456	    for entry in sorted(allow_set):
   457	        if entry == verdict_rel or entry == manifest_rel:
   458	            continue
   459	        if entry.startswith(man_dir + "/"):
   460	            continue
   461	        if entry != vf_expected:
   462	            return _fail(
   463	                E_VERDICT,
   464	                "delta_allowlist entry %r is outside the manifest directory "
   465	                "(%s/) and is not this\n"
   466	                "      tag's verdict-fields at its canonical path (%s).\n"
   467	                "      Outside the manifest nothing pins content — a "
   468	                "post-review edit there\n"
   469	                "      would ride the tag by NAME alone, and a basename "
   470	                "match in any other\n"
   471	                "      directory is a look-alike, not the plan's file. Move "
   472	                "the file into the\n"
   473	                "      re-pass manifest, or it must be exactly %s."
   474	                % (entry, man_dir, vf_expected, vf_expected),
   475	            )
