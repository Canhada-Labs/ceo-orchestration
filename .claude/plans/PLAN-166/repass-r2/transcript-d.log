   267	    )
   268	    (repo / "pyproject.toml").write_text(
   269	        '[project]\nname = "fixture"\nversion = "%s"\n' % version, encoding="utf-8"
   270	    )
   271	    (repo / "INSTALL.md").write_text(
   272	        "bash install.sh --pin v%s\n" % version, encoding="utf-8"
   273	    )
   274	    (repo / "docs" / "ARCHITECTURE.md").write_text(
