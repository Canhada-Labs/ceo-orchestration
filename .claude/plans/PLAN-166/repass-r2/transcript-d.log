   540	def generate_round_1(
   541	    plans_root: Path,
   542	    plan_id: str,
   543	    proposal: str,
   544	    archetypes: List[str],
   545	    *,
   546	    dry_run: bool = False,
   547	) -> List[Path]:
   548	    """Write proposal.md + one prompt file per archetype under round-1/.
   549	
   550	    Returns the list of files written.
   551	    """
   552	    round_dir = _round_dir(plans_root, plan_id, 1)
