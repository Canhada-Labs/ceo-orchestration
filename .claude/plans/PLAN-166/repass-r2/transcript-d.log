   389	
   390	
   391	def _anon_label(idx: int) -> str:
   392	    return "Critic-%s" % chr(ord("A") + idx) if idx < 26 else "Critic-%d" % (idx + 1)
   393	
   394	
   395	def consolidate_round(round_dir: Path) -> str:
   396	    """Concatenate all agent critique files from a round, ANONYMIZED.
   397	
   398	    DEBATE-SCHEMA §13.2 (PLAN-134 W1, Codex S228 finding #4): the
   399	    consolidated text that feeds round N+1 / red-team / synthesis carries
   400	    `Critic-A/B/C` labels instead of archetype filenames; persona-identifying
   401	    frontmatter keys (archetype/agent_persona/skill) are stripped and
   402	    archetype-name strings scrubbed from bodies. The label↔file mapping is
   403	    written to `round_dir/anonymization-map.md` for audit (best-effort —
   404	    consolidation never fails on a map-write error). Non-critique files
   405	    (consensus/proposal/synthesis/red-team/anonymization-map) excluded.
   406	    On-disk critique files keep their names (§13.2 item 4).
   407	    """
   408	    if not round_dir.is_dir():
   409	        return ""
   410	    excluded = {
   411	        "proposal.md",
   412	        "consensus.md",
   413	        "synthesis.md",
   414	        "red-team.md",
   415	        "anonymization-map.md",
   416	    }
   417	    critique_files = [
   418	        p for p in sorted(round_dir.iterdir())
   419	        if p.suffix == ".md" and p.name not in excluded
   420	    ]
   421	    labels: Dict[str, str] = {
   422	        p.name: _anon_label(i) for i, p in enumerate(critique_files)
   423	    }
   424	    # Name fragments to scrub from bodies (anti-halo): file stems and their
   425	    # space variants, longest first so 'security-engineer' wins over 'security'.
   426	    frags: List[str] = []
   427	    for p in critique_files:
   428	        frags.extend((p.stem, p.stem.replace("-", " ")))
   429	    frags = sorted({f for f in frags if len(f) >= 4}, key=len, reverse=True)
   430	    parts: List[str] = []
   431	    for p in critique_files:
   432	        try:
   433	            text = p.read_text(encoding="utf-8")
   434	        except OSError:
   435	            continue
   436	        label = labels[p.name]
   437	        kept: List[str] = []
   438	        in_fm = False
   439	        first = True
   440	        for line in text.splitlines():
   441	            s = line.strip()
   442	            if first:
   443	                first = False
   444	                if s == "---":
   445	                    in_fm = True
   446	                    kept.append(line)
   447	                    continue
   448	            if in_fm:
   449	                if s == "---":
   450	                    in_fm = False
   451	                    kept.append(line)
   452	                    continue
   453	                if s.startswith(("archetype:", "agent_persona:", "skill:")):
   454	                    continue  # identifying frontmatter stripped (§13.2 item 2)
   455	            kept.append(line)
   456	        body = "\n".join(kept)
   457	        for frag in frags:
   458	            body = re.sub(re.escape(frag), label, body, flags=re.IGNORECASE)
   459	        parts.append(f"### {label}\n\n{body}")
   460	    if critique_files:
   461	        round_m = re.match(r"round-(\d+)$", round_dir.name)
   462	        plan = next(
   463	            (a.name for a in round_dir.parents if a.name.startswith("PLAN-")),
   464	            "unknown",
   465	        )
   466	        map_text = "\n".join(
   467	            ["---", f"plan: {plan}",
   468	             "round: %s" % (round_m.group(1) if round_m else round_dir.name),
   469	             "labels:"]
   470	            + ["  %s: %s" % (labels[p.name], p.stem) for p in critique_files]
   471	            + ["---", ""]
   472	        )
   473	        try:
   474	            (round_dir / "anonymization-map.md").write_text(
   475	                map_text, encoding="utf-8"
   476	            )
   477	        except OSError:
   478	            pass
   479	    return "\n\n".join(parts)
