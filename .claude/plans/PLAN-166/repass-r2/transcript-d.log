   444	def test_major_bump_shifts_current_and_leaves_previous_to_judgment(synth):
   445	    """X.0.0: Previous MINOR is NOT derivable from the target alone, and the
   446	    live oracle skips value-checking it there too (it derives prev="" at X.0).
   447	    The writer must neither guess nor die half-written: Current shifts,
   448	    Previous is left byte-identical, and the skip is ANNOUNCED — a silent
   449	    stale support window is the unwatched-doc class wearing a new hat."""
   450	    repo = synth["repo"]
   451	    proc = module(synth, "bump", "--target", "2.0.0", "--today", D2)
   452	    assert proc.returncode == 0, proc.stderr
   453	    for doc in ("SECURITY.md", "VERSIONING.md"):
   454	        text = (repo / doc).read_text()
   455	        assert "v2.0.x" in text, doc
   456	        assert "v1.2.x" in text, doc  # the old Previous, untouched
   457	    assert "release-train judgment" in proc.stdout, proc.stdout
