   216	        if not m:
   217	            continue
   218	        key, val = m.group(1), m.group(2).strip()
   219	        if val == "":
   220	            fields[key] = []
   221	            cur_list = key
   222	        else:
   223	            fields[key] = val
   224	            cur_list = None
   225	    return fields
