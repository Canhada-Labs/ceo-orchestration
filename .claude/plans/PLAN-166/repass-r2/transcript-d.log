    76	PAIR_CODER_OVERRIDE=""
    77	PAIR_REVIEWER_OVERRIDE=""
    78	
    79	# Parse leading flags. Order-independent. Positional args validated below.
    80	while [ "${1:-}" = "--skill-retrieve" ] \
    81	   || [ "${1:-}" = "--mode=reference" ] \
    82	   || [ "${1:-}" = "--mode=inline" ] \
    83	   || [ "${1:-}" = "--dispatch=mitigated" ] \
    84	   || [ "${1:-}" = "--dispatch=native" ] \
    85	   || [ "${1:-}" = "--pair-mode" ] \
    86	   || [[ "${1:-}" == --coder=* ]] \
    87	   || [[ "${1:-}" == --reviewer=* ]]; do
    88	  case "${1}" in
    89	    --skill-retrieve)
    90	      USE_SKILL_RETRIEVE=1
    91	      shift
    92	      ;;
    93	    --mode=reference)
    94	      # PLAN-020 Phase 2 (ADR-051): emit ## SKILL REFERENCE with hash-pin
    95	      # instead of inline ## SKILL CONTENT. Smaller, cache-friendlier
    96	      # spawn prompts; sub-agent Reads SKILL.md and re-hashes for forensic
    97	      # observation via check_skill_reference_read.py.
    98	      SKILL_INJECTION_MODE="reference"
    99	      shift
   100	      ;;
   101	    --mode=inline)
   102	      SKILL_INJECTION_MODE="inline"
   103	      shift
   104	      ;;
   105	    --dispatch=mitigated)
