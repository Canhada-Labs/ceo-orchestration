   371	        self.assertFalse(r["max_rounds_reached"])
   372	        self.assertEqual(r["outcome"], "diverged")
   373	        self.assertEqual(r["round_number"], 4)
   374	
   375	    def test_ceiling_convergence_is_convergence(self):
   376	        # PLAN-169 W2.9(iii), PROTOCOL §12.4: Jaccard >= threshold at the
   377	        # MAX_ROUNDS ceiling IS convergence — the old contract forced
   378	        # convergence_met=False here, masking a met threshold as impasse.
   379	        # The ceiling still terminates (max_rounds_reached stays True for
   380	        # orchestrators); only the mislabel is gone.
   381	        self._seed(5, ["alpha", "beta", "gamma"])
   382	        r = dc.compute_convergence(self.tmp, "PLAN-999", 5, threshold=0.7)
   383	        self.assertEqual(r["jaccard_score"], 1.0)
   384	        self.assertEqual(r["jaccard"], 1.0)
   385	        self.assertTrue(r["max_rounds_reached"])
   386	        self.assertEqual(r["outcome"], "converged")
   387	        self.assertTrue(r["convergence_met"])
   388	        self.assertTrue(r["converged"])
   389	        self.assertFalse(r["red_team_needed"])
   390	        self.assertEqual(r["resolved_count"], 0)
   391	        self.assertEqual(r["novel_count"], 0)
