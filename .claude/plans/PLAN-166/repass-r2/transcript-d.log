   171	def generated_manifest_paths() -> List[str]:
   172	    """Run the generator; observe which manifests it writes (never recall)."""
   173	    with tempfile.TemporaryDirectory(prefix="ceo-t166-gen-") as td:
   174	        dest = Path(td) / "out"
   175	        BUILD_PLUGIN.write_manifest_files(dest)
   176	        names = sorted(p.name for p in dest.iterdir() if p.is_file())
   177	    if not names:
   178	        raise AssertionError("build-plugin wrote no manifests — derivation broken")
   179	    rel = BUILD_PLUGIN.MANIFESTS.resolve().relative_to(REPO.resolve()).as_posix()
   180	    return [rel + "/" + n for n in names]
