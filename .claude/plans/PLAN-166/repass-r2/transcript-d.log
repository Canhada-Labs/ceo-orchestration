   482	def redact_consolidated(text: str) -> str:
   483	    """Apply `_lib.redact.redact_secrets` to consolidated text.
   484	
   485	    max_chars=0 → no truncation. The bounded-growth invariant from
   486	    redact.py still caps output at 2x input.
   487	    """
   488	    redact = _load_redact_secrets()
   489	    try:
   490	        return redact(text, max_chars=0)
   491	    except TypeError:
   492	        # Fallback if redact signature differs (fail-open)
   493	        return redact(text)
