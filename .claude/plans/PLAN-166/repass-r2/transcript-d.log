   477	    # --- set equality by NAME, both directions, inside the manifest dir ---
   478	    listed = set(
   479	        os.path.normpath(os.path.join(man_dir, name)).replace(os.sep, "/")
   480	        for _sha, name in entries
   481	    )
   482	    listed.add(manifest_rel)
