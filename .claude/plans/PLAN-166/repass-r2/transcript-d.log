   234	def _support_window(version: str):
   235	    """(current_minor, previous_minor) the way the live oracle derives them:
   236	    prev = minor-1, None (not derivable) at X.0."""
   237	    maj, mnr = (int(x) for x in version.split(".")[:2])
   238	    prev = "%d.%d" % (maj, mnr - 1) if mnr > 0 else None
   239	    return "%d.%d" % (maj, mnr), prev
   240	
