   101	
   102	def git(repo: Path, env: Dict[str, str], *args: str) -> str:
   103	    proc = run(["git"] + list(args), repo, env)
   104	    assert proc.returncode == 0, "git %s failed: %s%s" % (
   105	        " ".join(args),
   106	        proc.stdout,
   107	        proc.stderr,
   108	    )
   109	    return proc.stdout.strip()
   110	
   111	
   112	def sha256_file(path: Path) -> str:
   113	    return hashlib.sha256(path.read_bytes()).hexdigest()
   114	
   115	
   116	def tree_fingerprint(repo: Path) -> Dict[str, str]:
   117	    """Content hash of every file the bump may touch (writes are visible here
   118	    even when they are later committed, unlike `git status`)."""
   119	    out: Dict[str, str] = {}
   120	    for rel in bump_sites.site_paths(include_generated=True):
   121	        full = repo / rel
   122	        if full.is_file():
   123	            out[rel] = sha256_file(full)
   124	    return out
   125	
   126	
   127	def index_and_worktree_clean(repo: Path, env: Dict[str, str]) -> None:
   128	    porcelain = git(repo, env, "status", "--porcelain")
   129	    assert porcelain == "", "working tree not clean:\n%s" % porcelain
   130	    staged = run(["git", "diff", "--cached", "--quiet"], repo, env)
   131	    assert staged.returncode == 0, "index not clean:\n%s" % git(
   132	        repo, env, "diff", "--cached", "--name-only"
   133	    )
