+_STAGED_166_TRUSTED_PUBLISHER = (
+    _STAGED_166 / ".claude" / "governance" / "npm-trusted-publisher.txt"
+)
+_TRUSTED_PUBLISHER_KEYS = frozenset({"repository", "workflow", "environment"})
