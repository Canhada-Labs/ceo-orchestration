   849	def _handle_convergence(conv, args, plans_root) -> "Optional[int]":
   850	    """Dispatch on convergence result after round-N write.
   851	
   852	    Returns an exit code if the caller should return immediately, or
   853	    ``None`` to fall through to ``return 0``.
   854	    """
   855	    print(
   856	        f"  jaccard={conv['jaccard']:.3f} "
   857	        f"converged={conv['converged']} "
   858	        f"red_team_needed={conv['red_team_needed']} "
   859	        f"outcome={conv.get('outcome', '')}"
   860	    )
   861	    # PLAN-169 W2.9(iii) consumer fix (repass-r2 part-d P1: the first
   862	    # fix-forward changed compute_convergence + CLI but this branch still
   863	    # tested the FLAG before the label, so a ceiling round that met the
   864	    # threshold was written up as unresolved). Ceiling semantics: terminal
   865	    # either way; converged-at-ceiling is CONVERGENCE (§12.4, and the TLA
   866	    # MaxRoundsExhausted action only fires with jaccard < threshold) — it
   867	    # falls through to the consensus path below. Only the
   868	    # below-threshold ceiling terminates as unresolved here.
   869	    if conv.get("max_rounds_reached") and not conv.get("converged"):
   870	        _emit_max_rounds_event(args.plan, args.round_num, dry_run=args.dry_run)
   871	        unresolved_path = write_unresolved_consensus(
   872	            plans_root, args.plan, args.round_num, args.max_rounds,
   873	            float(conv.get("jaccard", 0.0)), dry_run=args.dry_run,
