     1	#!/usr/bin/env python3
     2	"""Build the Claude Code plugin `ceo` from the live .claude/ tree.
     3	
     4	Generates dist/ceo-plugin/ (the plugin) + dist/ceo-marketplace/ (a marketplace
     5	that lists it). Reproducible: re-run after changing .claude/ to refresh.
     6	
     7	Scope = the `--ceremony user` (advisory) surface + the PLAN-128 accelerators.
     8	The canonical/GPG self-protection hooks are copied (so imports don't break) but
     9	NOT registered in hooks.json — they only protect the framework's own repo and
    10	need the Owner's GPG key, which an adopter does not have.
    11	
    12	The committed `.claude-plugin/{plugin.json,marketplace.json}` at repo root are
    13	GENERATED by this script (PLAN-153 Wave B item 6) — never hand-edit them. CI
    14	runs `--check` (regen to a temp dir + diff) so any drift between the committed
    15	manifests and this generator fails the build (same pattern as the skill
    16	inventory idempotency step in validate.yml). Generation is deterministic:
    17	content depends only on VERSION + string literals; sorted keys; no timestamps.
    18	
    19	Usage:
    20	  python3 scripts/build-plugin.py                    # full dist build (also refreshes .claude-plugin/)
    21	  python3 scripts/build-plugin.py --write-manifests  # regen ONLY the committed .claude-plugin/*.json
    22	  python3 scripts/build-plugin.py --check            # regen to temp + diff vs committed; exit 1 on drift
    23	"""
    24	from __future__ import annotations
    25	
    26	import argparse
    27	import difflib
    28	import json
    29	import re
    30	import shutil
    31	import sys
    32	import tempfile
    33	from pathlib import Path
    34	from typing import List, Optional
    35	
    36	REPO = Path(__file__).resolve().parent.parent
    37	OUT_ROOT = REPO / "dist"
    38	PLUGIN = OUT_ROOT / "ceo-plugin"
    39	MARKET = OUT_ROOT / "ceo-marketplace"
    40	MANIFESTS = REPO / ".claude-plugin"   # committed, generator-owned (PLAN-153 B6)
    41	NS = "ceo"
    42	VERSION = (REPO / "VERSION").read_text().strip()
    43	
    44	# Accelerators (PLAN-128) to add on top of the advisory settings.user.json set.
    45	ACCEL = {
    46	    "PostToolUse": [
    47	        {"matcher": "Edit|Write|MultiEdit", "hooks": [
    48	            {"type": "command",
    49	             "command": 'bash "$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh" accel_dispatch.py',
    50	             "timeout": 20, "statusMessage": "Verifying edit..."}]},
    51	    ],
    52	    "Stop": [
    53	        {"matcher": "", "hooks": [
    54	            {"type": "command",
    55	             "command": 'bash "$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh" codex_review_user_code.py',
    56	             "timeout": 130, "statusMessage": "Checking for risky diff..."},
    57	            {"type": "command",
    58	             "command": 'bash "$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh" review_loop.py',
    59	             "timeout": 60}]},
    60	    ],
    61	    "SessionStart": [
    62	        {"matcher": "", "hooks": [
    63	            {"type": "command",
    64	             "command": 'bash "$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh" turbo_sessionstart.py',
    65	             "timeout": 10}]},
    66	    ],
    67	}
