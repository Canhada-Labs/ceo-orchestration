+        "import pytest\n"
+        f"@pytest.mark.parametrize('i', range({cases}))\n"
+        "def test_p(i):\n    pass\n",
+        encoding="utf-8",
+    )
+    if broken:
+        (tdir / "test_broken.py").write_text(
+            "import module_that_does_not_exist_plan166_repass\n",
+            encoding="utf-8",
