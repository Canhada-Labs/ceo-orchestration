   349	    def test_real_repo_rule_liveness(self):
   350	        """S287 vacuous-gate class: every doc-gated metric must match >=1
   351	        site in the real repo's watched docs. A metric at 0 matches is a
   352	        DEAD gate — it reports "no drift" with a number nobody compares
   353	        (`registered` was dead from birth: derived 47 phantom, matched no
   354	        doc, said "no drift" for months)."""
   355	        env = os.environ.copy()
   356	        r = subprocess.run(
   357	            ["bash", str(SCRIPT), "--json", "--no-tests"],
   358	            capture_output=True, text=True, timeout=60, env=env)
   359	        self.assertEqual(r.returncode, 0, r.stdout)
   360	        data = json.loads(r.stdout)
   361	        self.assertIn("rule_matches", data)
   362	        dead = sorted(k for k, v in data["rule_matches"].items() if v == 0)
   363	        self.assertEqual(dead, [], f"dead doc-gate rules (0 matches): {dead}")
