   844	    def test_delta_semantics_not_reimplemented_in_bash(self):
   845	        # The bash body must not carry the decision vocabulary of the
   846	        # module — reading the allowlist or hashing the manifest in
   847	        # shell would be a second implementation of the same closed-set
   848	        # semantics. Comment lines are excluded: the step's rationale
   849	        # comment legitimately NAMES what the module does; only CODE
   850	        # lines may not do it.
   850	        # lines may not do it.
   851	        block = _step_block(self.source, _W1B_STEP_NAME)
   852	        code_lines = "\n".join(
   853	            line for line in block.splitlines()
   854	            if not line.lstrip().startswith("#")
   855	        )
   856	        for forbidden in ("delta_allowlist", "shasum -c", "shasum -a 256"):
   857	            self.assertNotIn(
   858	                forbidden, code_lines,
