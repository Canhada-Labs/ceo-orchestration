    74	def clean() -> None:
    75	    if OUT_ROOT.exists():
    76	        shutil.rmtree(OUT_ROOT)
    77	    (PLUGIN / ".claude-plugin").mkdir(parents=True)
    78	    (MARKET / ".claude-plugin").mkdir(parents=True)
