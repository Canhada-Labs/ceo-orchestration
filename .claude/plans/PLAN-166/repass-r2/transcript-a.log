    49	while [ $# -gt 0 ]; do
    50	  case "$1" in
    51	    --dry-run)         DRY_RUN=1; shift ;;
    52	    --restore)         RESTORE_PATH="${2:-}"; shift 2 ;;
    53	    --restore=*)       RESTORE_PATH="${1#--restore=}"; shift ;;
    54	    --force)           FORCE=1; shift ;;
    55	    --no-backup)       NO_BACKUP=1; shift ;;
    56	    --no-hmac-verify)  NO_HMAC_VERIFY=1; shift ;;
    57	    -h|--help)
    58	      sed -n '1,30p' "${BASH_SOURCE[0]}"
    59	      exit 0
    60	      ;;
    61	    -*)
    62	      echo "ERROR: unknown option: $1" >&2
    63	      exit 1
    64	      ;;
    65	    *)
