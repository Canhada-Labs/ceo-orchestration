  1072	    printf 'FALLBACK\n'; return 0
  1073	  fi
  1074	  if [ "$_cab_dst" = "$_cab_src" ]; then
  1075	    printf 'IDENTICAL\n'; return 0
  1076	  fi
  1077	  if [ "$_cab_dst" = "$_cab_base" ] && [ "$_cab_src" != "$_cab_base" ]; then
  1078	    printf 'FRAMEWORK-CHANGED\n'; return 0
  1079	  fi
