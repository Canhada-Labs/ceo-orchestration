  2028	  #   - .claude/adr/ADR-*.md           (user's own ADRs)
  2029	  #   - .claude/scripts/*              (executable code; placeholders
  2030	  #     inside .py docstrings are instructional, not install-time)
  2031	  #   - .claude/hooks/*                (same reason)
  2032	  # WS4-explicit-files-partition: maintainer rewrites root + docs/ +
  2033	  # .claude/ template files; user ceremony rewrites ONLY .claude/ files so
  2034	  # a real adopter repo's own root/docs files are never touched.
  2035	  local explicit_files=(
  2036	    "$TARGET/.claude/team.md"
  2037	    "$TARGET/.claude/frontend-team.md"
  2038	    "$TARGET/.claude/agent-metrics.md"
  2039	  )
  2040	  if [[ "$CEREMONY" != "user" ]]; then
  2041	    explicit_files=(
