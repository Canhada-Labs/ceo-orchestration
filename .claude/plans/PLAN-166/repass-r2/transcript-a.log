  2447	# ----------------------------------------------------------------------
  2448	# PLAN-153 Wave B item B1 — persist the install-state.
  2449	# ----------------------------------------------------------------------
  2450	# Writes $TARGET/.claude/.install-state.json (next to the ADR-155 baseline
  2451	# manifest): the ORIGINAL request — verbatim argv + every parsed flag + the
  2452	# RESOLVED placeholder map (CLI > env > deterministic default; empty values
  2453	# omitted) — plus the operation journal for THIS run.
  2454	#
  2455	#   * Atomic: python writes a same-directory tempfile, then os.replace().
  2456	#   * Updated on every run: first_recorded_at + run_count + a bounded
  2457	#     history (last 20 runs) survive re-installs; request/operations
  2458	#     reflect the LATEST run.
  2459	#   * Schema-versioned: schema ceo.install-state/v1, schema_version 1.
  2460	#   * Consumed by upgrade.sh (PLAN-153 B2): request.profile/request.stack
  2461	#     become upgrade DEFAULTS when its own flags are omitted. A missing or
  2462	#     invalid state file degrades upgrade.sh to the ADR-155 drift-classifier
  2463	#     path — never an error, never a no-op (debate C back-compat must-fix).
  2464	#   * TRUST: target-side, UNSIGNED, advisory — the same trust class as the
  2465	#     ADR-155 baseline manifest (whoever can write the target tree can
  2466	#     rewrite it). upgrade.sh charset-validates every replayed value and
  2467	#     falls back on anything suspect; values are data, never eval-ed.
  2468	#   * Fail-open: no python3 / write error => stderr NOTE, install still
  2469	#     succeeds. Dry-run never writes (the "no files modified" promise).
  2470	#   * NOT covered by the baseline-manifest enumeration (like the manifest
  2471	#     dotfile itself), so the upgrade classifier never touches it.
  2472	_write_install_state() {
  2473	  [[ "${DRY_RUN:-0}" -eq 0 ]] || return 0
  2474	  if ! command -v python3 >/dev/null 2>&1; then
  2475	    echo "    NOTE: install-state skipped (python3 not found) — upgrade.sh will use the ADR-155 fallback path" >&2
  2476	    return 0
  2477	  fi
  2478	  local state_file="$TARGET/.claude/.install-state.json"
  2479	  local fw_version=""
  2480	  if [[ -f "$SOURCE_DIR/VERSION" ]]; then
  2481	    fw_version="$(tr -d '[:space:]' < "$SOURCE_DIR/VERSION" 2>/dev/null || true)"
  2482	  fi
  2483	
  2484	  echo ""
  2485	  echo "==> Writing install-state (.claude/.install-state.json — PLAN-153 Wave B)"
  2486	
  2487	  # Flat key/value pairs, argv-passed (PLAN-106 G.2.b house pattern: never
  2488	  # source-string interpolation; python3 -I + PYTHONNOUSERSITE=1). Keys with
  2489	  # a "ph." prefix land in request.placeholders; empty ph values are omitted.
  2490	  local pairs=(
     1	#!/usr/bin/env bash
     2	# upgrade.sh — update an existing ceo-orchestration install in a target repo
     3	#
     4	# Usage:
     5	#   ./upgrade.sh <target-repo-path> [--profile <list>] [--stack <name>]
     6	#                                    [--pin <tag>] [--dry-run]
     7	#                                    [--skip <glob>] [--no-diff-warn]
     8	#                                    [--no-deprecation-warn]
     9	#
    10	# What it does:
    11	#   - Backs up the current .claude/team.md, .claude/frontend-team.md, .claude/skills/,
    12	#     .claude/hooks/, .claude/scripts/, .claude/commands/, .claude/pitfalls-catalog.yaml,
    13	#     .claude/task-chains.yaml to .claude.bak/{timestamp}/
    14	#   - (F-CHAOS-3) Before overwriting any adopter file that differs from the source,
    15	#     emits a `diff -q`-style WARNING line (shown on stderr) so the Owner is aware
    16	#     a customization will be replaced. Pass --no-diff-warn to silence.
    17	#     Pass --skip=<glob> to exclude files from the overwrite entirely (one --skip per pattern).
    18	#   - Replaces them with the latest from this repo, respecting --profile and --stack
