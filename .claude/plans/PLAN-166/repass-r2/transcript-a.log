  1948	# Build the sed script iteratively. Each non-empty placeholder adds an
  1949	# expression. We use `|` as the delimiter so slashes in values (paths)
  1950	# don't break. Values with `|` are escaped.
  1951	build_sed_script() {
  1952	  local script=""
  1953	  _add_sub() {
  1954	    local key="$1" val="$2"
  1955	    if [[ -n "$val" ]]; then
  1956	      # Escape | & \ in the replacement
  1957	      local esc
  1958	      esc="$(printf '%s' "$val" | sed 's/[|&\\]/\\&/g')"
  1959	      script="${script}s|{{${key}}}|${esc}|g;"
  1960	    fi
  1961	  }
