  3073	# DevOps-P1-4: PROTOCOL.md is framework-derived (pointer), not user data —
  3074	# refresh it so it stays aligned with the current source layout.
  3075	# PLAN-166 F3 (ADR-155-AMEND-1): CEREMONY-GATED — the refresh used to run
  3076	# unconditionally and `cat >`-created a root PROTOCOL.md that a
  3077	# `--ceremony user` install deliberately never has (install.sh
  3078	# WS4-guard-proto forbids root files); the F4 tree-comparison e2e exposes
  3079	# exactly this divergence (r7/r13). The gate reads the ceremony from
  3080	# .claude/.install-state.json via the replay-independent reader above.
  3081	_PROTOCOL_DELIVERED=0
  3082	echo ""
  3083	echo "==> Refreshing PROTOCOL.md pointer"
  3084	if [[ "$CEREMONY_EFFECTIVE" == "user" ]]; then
  3085	  echo "    SKIP: PROTOCOL.md pointer (recorded --ceremony user install — a user install never creates root files, WS4; r13)"
  3086	  # Ownership continuity on the analogous skip (codex W1 round 7, P2) — see
  3087	  # the SPEC/v1 ceremony skip: preserving the tree while erasing its record
  3088	  # strands a framework-delivered pointer as unowned.
  3089	  #
  3090	  # But the flag alone is NOT enough (codex W1 round 9, P1): this skip never
  3091	  # runs _refresh_protocol_pointer, so _REFRESH_PROTOCOL_CANON_HASH stays
  3092	  # empty, and _write_baseline_manifest then hashes the LIVE pointer —
  3093	  # re-recording an adopter-CUSTOMIZED PROTOCOL.md as the framework baseline,
  3094	  # which the next upgrade overwrites and uninstall can DELETE. Retaining
  3095	  # ownership must never retain the wrong bytes. Carry the PRIOR canonical
  3096	  # digest; a LINK record needs none (the link branch of the rewrite fires
  3097	  # before the PROTOCOL special case). When neither is available, DROP the
  3098	  # claim — the pointer stays adopter-owned and preserved, which is the
  3099	  # pre-continuity behaviour and loses nothing.
  3100	  if _baseline_has_protocol_record; then
  3101	    _REFRESH_PROTOCOL_CANON_HASH="$( _baseline_lookup "PROTOCOL.md" 2>/dev/null || true )"
  3102	    if [[ -n "$_REFRESH_PROTOCOL_CANON_HASH" ]] \
  3103	       || grep -Eq '^LINK  PROTOCOL\.md(  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
  3104	      _PROTOCOL_DELIVERED=1
  3105	    else
