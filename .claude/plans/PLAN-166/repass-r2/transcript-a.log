  1877	    _osk_hit=""
  1878	    while IFS= read -r _osk_f; do
  1879	      [ -n "$_osk_f" ] || continue
  1880	      if _path_is_skipped "$_osk_f"; then _osk_hit=1; break; fi
  1881	    done <<EOF
  1882	$( { ( cd "$SOURCE_DIR" && find SPEC/v1 ! -type d -print 2>/dev/null );
  1883	     [ -d "$TARGET/SPEC/v1" ] && ( cd "$TARGET" && find SPEC/v1 ! -type d -print 2>/dev/null ); } | LC_ALL=C sort -u )
  1884	EOF
  1885	    [ -n "$_osk_hit" ] && { printf 'descendant'; return 0; }
