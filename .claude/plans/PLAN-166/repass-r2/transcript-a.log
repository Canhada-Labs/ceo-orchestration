  2343	  if [[ "${_DELIVERED_PROTOCOL:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  2344	     && grep -Eq '^([0-9a-f]{64}|LINK)  PROTOCOL\.md(  |$)' "$manifest" 2>/dev/null \
  2345	     && _prior_link_target_matches "$manifest" "PROTOCOL.md"; then
