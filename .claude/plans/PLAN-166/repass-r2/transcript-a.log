  1312	      local _drv
  1313	      _drv="$( _classify_against_baseline "$rel_path" )"
  1314	      case "$_drv" in
  1315	        IDENTICAL)
  1316	          echo "    (dry-run) would SKIP (IDENTICAL): $rel_path" ;;
  1317	        ADOPTER-CUSTOMIZED)
  1318	          echo "    (dry-run) would PRESERVE (ADOPTER-CUSTOMIZED): $rel_path" ;;
  1319	        CONFLICT)
  1320	          echo "    (dry-run) would apply --on-conflict=$ON_CONFLICT (CONFLICT): $rel_path" ;;
  1321	        FRAMEWORK-CHANGED)
  1322	          echo "    (dry-run) would UPDATE (FRAMEWORK-CHANGED; original would be backed up to $BAK_DIR/$rel_path): $rel_path" ;;
  1323	        FALLBACK|*)
  1324	          echo "    (dry-run) would BACKUP + UPDATE (no usable baseline): $rel_path" ;;
  1325	      esac
  1326	      return
  1327	    fi
  1328	    echo "    (dry-run) would BACKUP + UPDATE: $rel_path"
  1329	    return
  1330	  fi
