  2043	      "$TARGET/MEMORY.md"
  2044	      "$TARGET/PROTOCOL.md"
  2045	      "$TARGET/docs/BRANCH-PROTECTION.md"
  2046	      "$TARGET/docs/rotation-log.md"
  2047	      "$TARGET/.claude/team.md"
  2048	      "$TARGET/.claude/frontend-team.md"
  2049	      "$TARGET/.claude/agent-metrics.md"
  2050	    )
  2051	  fi
  2052	
  2053	  local f
  2054	  for f in "${explicit_files[@]}"; do
  2055	    [[ -f "$f" ]] || continue
  2056	    if [[ "$DRY_RUN" -eq 1 ]]; then
  2057	      echo "    (dry-run) would SUBSTITUTE placeholders in: ${f#$TARGET/}"
  2058	      continue
  2059	    fi
  2060	    portable_sed_inplace "$sed_script" "$f"
  2061	    echo "    SUBSTITUTED: ${f#$TARGET/}"
  2062	  done
  2063	
  2064	  # Skills/**/SKILL*.md, skills/**/team-personas.md + pitfalls.yaml, and
  2065	  # progressive-disclosure references/*.md (PLAN-153 Wave C splits) —
  2066	  # these are canonical content that ships {{PROJECT_NAME}}, {{OWNER_NAME}},
