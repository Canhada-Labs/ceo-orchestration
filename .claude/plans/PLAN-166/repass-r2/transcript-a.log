  3353	        os.unlink(tmp)
  3354	    except OSError:
  3355	        pass
  3356	    raise
  3357	' "$_INSTALL_STATE_FILE" "${_UP_OPS_FILE:-}" "$fw_version" "${#pairs[@]}" "${pairs[@]}" \
