  2007	apply_placeholder_substitutions() {
  2008	  local sed_script
  2009	  sed_script="$(build_sed_script)"
  2010	
  2011	  if [[ -z "$sed_script" ]]; then
  2012	    echo ""
  2013	    echo "==> Placeholder substitution: no values supplied (use --owner / --project / env vars)"
