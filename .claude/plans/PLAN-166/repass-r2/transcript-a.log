   891	      if [ "$_bru_kind" = "link" ] && [ "$_bru_i" -eq "$_bru_n" ]; then
   892	        continue                          # the LINK record's own leaf
   893	      fi
   894	      IFS="$_bru_oldIFS"
   895	      return 0
   896	    fi
   897	  done
   898	  IFS="$_bru_oldIFS"
   899	  return 1
   900	}
