  1869	# _ov_obs_skip <relpath> — none | self | descendant.
  1870	# The descendant scan walks the UNION of source and target and includes every
  1871	# removable entry, not just regular files: the forced route find-deletes them
  1872	# all, so a target-only symlink must be visible to skip detection too.
  1873	_ov_obs_skip() {
  1874	  _osk_rel="$1"
  1875	  if _path_is_skipped "$_osk_rel"; then printf 'self'; return 0; fi
  1876	  if [ "$_osk_rel" = "SPEC/v1" ]; then
  1877	    _osk_hit=""
  1878	    while IFS= read -r _osk_f; do
  1879	      [ -n "$_osk_f" ] || continue
  1880	      if _path_is_skipped "$_osk_f"; then _osk_hit=1; break; fi
  1881	    done <<EOF
  1882	$( { ( cd "$SOURCE_DIR" && find SPEC/v1 ! -type d -print 2>/dev/null );
  1883	     [ -d "$TARGET/SPEC/v1" ] && ( cd "$TARGET" && find SPEC/v1 ! -type d -print 2>/dev/null ); } | LC_ALL=C sort -u )
  1884	EOF
  1885	    [ -n "$_osk_hit" ] && { printf 'descendant'; return 0; }
  1886	  fi
  1887	  printf 'none'
  1888	}
  1889	
  1890	# _ov_obs_mode — the delivery mode this run carries. Evidence order: a prior
  1891	# LINK record (authoritative), else a symlink probe on the owned roots.
  1892	_ov_obs_mode() {
  1893	  if [ -n "${_BASELINE_MANIFEST_FILE:-}" ] && [ -f "$_BASELINE_MANIFEST_FILE" ] \
  1894	     && grep -Eq '^LINK  ' "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
  1895	    printf 'link'; return 0
  1896	  fi
  1897	  if [ -L "$TARGET/SPEC/v1" ] || [ -L "$TARGET/.claude/.framework-version" ]; then
  1898	    printf 'link'; return 0
  1899	  fi
  1900	  printf 'copy'
  1901	}
