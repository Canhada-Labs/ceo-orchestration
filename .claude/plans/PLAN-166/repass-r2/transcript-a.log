    85	#     --app-name <str>             -> {{APP_NAME}}                   (env: CEO_APP_NAME)
    86	#     --source-file-count <int>    -> {{SOURCE_FILE_COUNT}}          (env: CEO_SOURCE_FILE_COUNT)
    87	#     --line-count <int>           -> {{LINE_COUNT}}                 (env: CEO_LINE_COUNT)
