  1534	# DevOps-P1-4: refresh PROTOCOL.md pointer on upgrade. This is
  1535	# framework-derived content (not user data), so preserving it as-is
  1536	# across upgrades traps stale pointers when the framework moves. We
  1537	# regenerate it with the same heuristic install.sh uses.
  1538	_refresh_protocol_pointer() {
  1539	  local pointer="$TARGET/PROTOCOL.md"
  1540	
  1541	  # PLAN-168 W2 (AC-6, Owner decision D1-b): the body comes from the ONE
  1542	  # shared generator in _framework_manifest_set.sh — never a private heredoc.
  1543	  # INV-4 existed because this function and install.sh each carried their own
  1544	  # copy of this text: install substituted {{PROTOCOL_SOURCE}}, this one did
  1545	  # not — two bodies for the same file, and the recorded digest never matched
  1546	  # the disk (OWN-0074). A missing generator preserves the surface (upgrade's
  1547	  # fail-toward-preservation posture, same as an illegal cell below).
  1548	  if ! command -v _render_protocol_pointer >/dev/null 2>&1; then
  1549	    echo "    WARNING: _render_protocol_pointer unavailable — PROTOCOL.md pointer PRESERVED" >&2
  1550	    return 0
  1551	  fi
  1552	
  1553	  # Resolve the PROTOCOL_SOURCE the pointer should name (AC-6c, Owner
  1554	  # decision D3). Precedence:
  1555	  #   1. request.placeholders.PROTOCOL_SOURCE from the install-state — the
  1556	  #      install has ALWAYS persisted it there (union across runs; the
  1557	  #      PLAN-168 debate's claim that it was never persisted checked the
  1558	  #      wrong key — codex rail r1 P1).
  1559	  #   2. A HEALTHY on-disk pointer: extract the value it already names and
  1560	  #      keep it — never silently rename a sound pointer to today's checkout.
  1561	  #   3. $SOURCE_DIR (this upgrade's checkout) — last resort, used for
  1562	  #      genuinely old installs with no state and no sound pointer (incl.
  1563	  #      the degraded-cure path, where the pointer names nothing usable).
  1564	  local _ptr_psource=""
  1565	  if [ -f "$_INSTALL_STATE_FILE" ] && command -v python3 >/dev/null 2>&1; then
  1566	    _ptr_psource="$( python3 - "$_INSTALL_STATE_FILE" <<'PYEOF' 2>/dev/null || true
  1567	import json, sys
  1568	try:
  1569	    with open(sys.argv[1], "r", encoding="utf-8") as f:
  1570	        doc = json.load(f)
  1571	    v = (doc.get("request") or {}).get("placeholders", {}).get("PROTOCOL_SOURCE", "")
  1572	    if isinstance(v, str) and v and "{{" not in v:
  1573	        sys.stdout.write(v)
  1574	except Exception:
  1575	    pass
  1576	PYEOF
  1577	)"
  1578	  fi
  1579	  if [ -z "$_ptr_psource" ] && [ -f "$pointer" ]; then
  1580	    # D3 route 2: trust a SOUND pointer. Extract the source it names and
  1581	    # accept it only if re-rendering with that value reproduces the file
  1582	    # byte-for-byte (the same reconstruction discipline as the degraded
  1583	    # recognizer — anything else is adopter content, not a source of truth).
  1584	    local _ptr_cand
  1585	    _ptr_cand="$( sed -n 's|^\(.*\)/PROTOCOL\.md$|\1|p' "$pointer" 2>/dev/null | sed -n '1p' )"
  1586	    if [ -n "$_ptr_cand" ] && [ "${_ptr_cand#\{\{}" = "$_ptr_cand" ]; then
  1587	      if _render_protocol_pointer "$SOURCE_DIR" "$TARGET" "$PROFILE" "$STACK" "$_ptr_cand" \
  1588	           | cmp -s - "$pointer" 2>/dev/null; then
  1589	        _ptr_psource="$_ptr_cand"
  1590	      fi
  1591	    fi
  1592	  fi
  1593	  if [ -z "$_ptr_psource" ]; then
  1594	    _ptr_psource="$SOURCE_DIR"
  1595	  fi
  1596	
  1597	  local _ptr_full
  1598	  _ptr_full="$( _render_protocol_pointer "$SOURCE_DIR" "$TARGET" "$PROFILE" "$STACK" "$_ptr_psource" )"
  1599	
  1600	  # The CANONICAL digest: the hash of exactly what the framework WOULD write.
  1601	  # Computed on every path, because the baseline rewrite must record it even
  1602	  # when the pointer is preserved — recording the customised bytes instead
  1603	  # would make the NEXT upgrade read H_dst == H_base and clobber them (C.5).
  1604	  # Post-PLAN-168 this is the hash of the SUBSTITUTED body — the same bytes
  1605	  # install writes — so the recorded digest finally matches the disk (INV-4).
  1606	  _REFRESH_PROTOCOL_CANON_HASH=""
  1607	  if command -v _hash_stdin >/dev/null 2>&1; then
  1608	    _REFRESH_PROTOCOL_CANON_HASH="$( printf '%s\n' "$_ptr_full" | _hash_stdin 2>/dev/null || true )"
  1609	  fi
  1610	
  1611	  # ---- OBSERVE -------------------------------------------------------------
  1612	  local _lt _pr _lc
  1613	  _lt="$( _ov_obs_live_type "$pointer" )"
  1614	  _pr="$( _ov_obs_prior_record "PROTOCOL.md" )"
  1615	  if [ "$_lt" != "regular" ]; then
  1616	    _lc="-"
  1617	  elif _protocol_pointer_is_degraded "$pointer"; then
  1618	    # PLAN-168 W2 (AC-6b, Owner decision D2): byte-exact reconstruction of
  1619	    # the {{PROTOCOL_SOURCE}}-literal template this script used to write.
  1620	    # Framework garbage, not adopter content — the verdict routes it to the
  1621	    # REFRESH cure below. Checked BEFORE pristine/edited: a degraded body
  1622	    # can never equal the substituted canonical, and classifying it `edited`
  1623	    # is exactly the immortal-defect route this wave closes.
  1624	    _lc="degraded"
  1625	  elif [ -n "$_REFRESH_PROTOCOL_CANON_HASH" ] \
  1626	       && [ "$( _hash_file "$pointer" 2>/dev/null || true )" = "$_REFRESH_PROTOCOL_CANON_HASH" ]; then
  1627	    _lc="pristine"
  1628	  else
  1629	    _lc="edited"
  1630	  fi
  1631	
  1632	  # ---- DECIDE --------------------------------------------------------------
  1633	  local _pair _verdict
  1634	  if ! _pair="$( _ownership_verdict protocol "$_pr" "$_lt" "$_lc" yes copy \
  1635	                   "$CEREMONY_EFFECTIVE" upgrade none )"; then
  1636	    echo "    WARNING: PROTOCOL.md dimensions are not a legal cell — PRESERVED" >&2
  1637	    return 0
  1638	  fi
  1639	  _verdict="${_pair%% *}"
  1640	  _PROTOCOL_HASH_SOURCE="${_pair##* }"
  1641	
  1642	  # ---- EXECUTE -------------------------------------------------------------
  1643	  # The guards this surface never had are not new branches: they are what the
  1644	  # decision already says. A destination that is not a regular file is
  1645	  # adopter-owned, so the verdict is unowned and nothing is written — which is
  1646	  # exactly the leaf-symlink / directory / FIFO protection SPEC and the marker
  1647	  # acquired during the S296 rounds and the pointer did not.
  1648	  case "$_verdict" in
  1649	    PRESERVE_UNOWNED|OMIT_RECORD)
  1650	      case "$_lt" in
  1651	        symlink) echo "    SKIP: PROTOCOL.md is a symlink — refusing to write THROUGH it (would mutate a path outside the target)" >&2 ;;
  1652	        dir|dir_empty) echo "    SKIP: PROTOCOL.md is a directory — adopter-owned, refusing to write into it" >&2 ;;
  1653	        special) echo "    SKIP: PROTOCOL.md is an unsupported special file — preserved, surface untouched" >&2 ;;
  1654	        *) echo "    SKIP: PROTOCOL.md pointer (recorded --ceremony user install — a user install never creates root files, WS4)" ;;
  1655	      esac
  1656	      return 0
  1657	      ;;
  1658	
  1659	    PRESERVE_OWNED)
  1660	      _PROTOCOL_DELIVERED=1
  1661	      if [ "$_lc" = "edited" ]; then
  1662	        # ADR-155 decision (iii): the verified S238 case. An adopter-customised
  1663	        # pointer is CONTENT, not a fork — it is preserved, and the record keeps
  1664	        # the canonical digest so the next upgrade does not read it as pristine.
  1665	        if [ "$DRY_RUN" -eq 0 ] && [ -f "$pointer" ]; then
  1666	          mkdir -p "$BAK_DIR" 2>/dev/null || true
  1667	          cp "$pointer" "$BAK_DIR/PROTOCOL.md" 2>/dev/null || true
  1668	        fi
  1669	        echo "    PRESERVED (root PROTOCOL.md is adopter-customised — pointer NOT refreshed; backup in $BAK_DIR/PROTOCOL.md)" >&2
  1670	      else
  1671	        echo "    SKIP: PROTOCOL.md pointer (ownership carried forward)"
  1672	      fi
  1673	      return 0
  1674	      ;;
  1675	
  1676	    DELIVER|REFRESH)
  1677	      if [ "$DRY_RUN" -eq 1 ]; then
  1678	        echo "    (dry-run) would REFRESH: PROTOCOL.md pointer"
  1679	        return 0
  1680	      fi
  1681	      _up_record_op "refresh_protocol_pointer" "PROTOCOL.md"
  1682	      # Backup-always before the overwrite, even with no baseline manifest —
  1683	      # this is what made the S238 loss recoverable on a FIRST upgrade.
  1684	      if [ -f "$pointer" ]; then
  1685	        mkdir -p "$BAK_DIR" 2>/dev/null || true
  1686	        cp "$pointer" "$BAK_DIR/PROTOCOL.md" 2>/dev/null || true
  1687	        echo "    BACKED UP: PROTOCOL.md (root) -> $BAK_DIR/PROTOCOL.md"
  1688	      fi
  1689	      printf '%s\n' "$_ptr_full" > "$pointer"
  1690	      _PROTOCOL_DELIVERED=1
  1691	      if [ "$_lc" = "degraded" ]; then
  1692	        echo "    CURED: PROTOCOL.md pointer was framework-degraded ({{PROTOCOL_SOURCE}} left literal by an old upgrade) — refreshed; original in $BAK_DIR/PROTOCOL.md"
  1693	      else
  1694	        echo "    REFRESHED: PROTOCOL.md pointer"
  1695	      fi
  1696	      return 0
  1697	      ;;
  1698	  esac
  1699	}
  1700	
  1701	# ===========================================================================
  1702	# PLAN-166 F3 (ADR-155-AMEND-1) — delivery-record lookups + SPEC/v1 FORCED
  1703	# refresh + framework version marker refresh.
  1704	# ---------------------------------------------------------------------------
  1705	# Ownership of the three conditional surfaces (PROTOCOL.md, SPEC/v1,
  1706	# .claude/.framework-version) derives from the REGISTERED DELIVERY — here,
  1707	# the PRE-upgrade baseline manifest records (the same record install.sh
  1708	# writes and doctor.sh reads) — never from the ceremony alone and never from
  1709	# file presence (r7/r13/r17/r19/r20).
  1710	# ===========================================================================
  1711	_baseline_has_spec_record() {
  1712	  [[ -n "$_BASELINE_MANIFEST_FILE" && -f "$_BASELINE_MANIFEST_FILE" ]] || return 1
  1713	  # `(/|  |$)` and not a bare trailing slash: a --mode link install records
  1714	  # the WHOLE tree as one directory symlink — `LINK  SPEC/v1  <target>`, no
  1715	  # trailing slash — which a `SPEC/v1/` fragment can never match (the same
  1716	  # `(  |$)` treatment the marker/PROTOCOL readers already have; family
  1717	  # swept with doctor.sh _dr_delivered, re-pass closure).
  1718	  grep -Eq '^([0-9a-f]{64}|LINK)  SPEC/v1(/|  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null
  1719	}
  1720	_baseline_has_marker_record() {
  1721	  [[ -n "$_BASELINE_MANIFEST_FILE" && -f "$_BASELINE_MANIFEST_FILE" ]] || return 1
  1722	  grep -Eq '^([0-9a-f]{64}|LINK)  \.claude/\.framework-version(  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null
  1723	}
  1724	# Third sibling of the family (codex W1 round 7, P2): the `--ceremony user`
  1725	# skip needs the same ownership-continuity question the SPEC/marker skips
  1726	# already ask. `_baseline_lookup` is not a substitute — it resolves HASH
  1727	# records only, and a --mode link PROTOCOL.md is a LINK record.
  1728	_baseline_has_protocol_record() {
  1729	  [[ -n "$_BASELINE_MANIFEST_FILE" && -f "$_BASELINE_MANIFEST_FILE" ]] || return 1
  1730	  grep -Eq '^([0-9a-f]{64}|LINK)  PROTOCOL\.md(  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null
  1731	}
  1732	
  1733	# PRISTINE fingerprints of every SPEC/v1 tree the framework shipped at
  1734	# v1.2.0 and earlier (r20 LEGACY MIGRATION: v1.2-and-earlier installs never
  1735	# enumerated SPEC/v1, so no historical delivery record can distinguish a
  1736	# framework-installed SPEC from an adopter's own — the ambiguity resolves by
  1737	# CONTENT). Derivation (deterministic — pinned tag content; run in the
  1738	# framework repo, reproduces _spec_tree_fingerprint byte-for-byte):
  1739	#   for t in v1.0.0 v1.0.1 v1.0.1-rc.1 v1.1.0 v1.1.0-rc.1 \
  1740	#            v1.2.0 v1.2.0-rc.1 v1.2.0-rc.2 v1.2.0-rc.3; do
  1741	#     git ls-tree -r --name-only "$t" -- SPEC/v1 | LC_ALL=C sort \
  1742	#     | while IFS= read -r f; do
  1743	#         printf '%s  %s\n' \
  1744	#           "$(git show "$t:$f" | shasum -a 256 | awk '{print $1}')" "$f"
  1745	#       done | shasum -a 256 | awk '{print $1}'
  1746	#   done
  1747	# Three distinct trees across the nine shipped tags:
  1748	#   a4a4... = v1.0.0 / v1.0.1 / v1.0.1-rc.1
  1749	#   94aa... = v1.1.0 / v1.1.0-rc.1
  1750	#   469a... = v1.2.0 / v1.2.0-rc.1 / v1.2.0-rc.2 / v1.2.0-rc.3
  1751	_SPEC_PRISTINE_FINGERPRINTS="a4a4504a224d72a975a853dd71a75d8e678fef034a70deb49df291dbb712c161 94aa62f781285ce4897ad1220edf15e97b4e9d7b629f9f7ba3389da5d45f22b1 469a49238867be181490214305b43bc7299f2bae3ef0b282a5452f6caf327f0b"
  1752	
  1753	# _spec_tree_fingerprint <root> — sha256 over the LC_ALL=C-sorted
  1754	# "<sha256(file)>  <relpath>" lines of every regular file under
  1755	# <root>/SPEC/v1 (the derivation comment above reproduces this from a tag).
  1756	# Fails (rc 1, no output) on a missing tree/hasher or any unhashable file —
  1757	# a PARTIAL fingerprint must never be compared against a pristine one.
  1758	_spec_tree_fingerprint() {
  1759	  local _sf_root="$1"
  1760	  command -v _hash_file >/dev/null 2>&1 || return 1
  1761	  command -v _hash_stdin >/dev/null 2>&1 || return 1
  1762	  [[ -d "$_sf_root/SPEC/v1" ]] || return 1
  1763	  # COMPLETENESS gate (codex W1-ceremony round, P2): the fingerprint hashes
  1764	  # regular files only, so an adopter-ADDED symlink/fifo/etc would be
  1765	  # invisible — the partial fingerprint could still byte-match a pristine
  1766	  # release and the forced refresh would REPLACE an adopter-modified tree
  1767	  # (the S238 class). Any non-regular, non-directory entry => no
  1768	  # fingerprint (rc 1) => the caller's safe path (ADOPTER-FORK preserve).
  1769	  # A find traversal error (unreadable subdir) is the same: partial
  1770	  # inventory must never be compared against a pristine fingerprint.
  1771	  local _sf_odd
  1772	  _sf_odd="$( ( cd "$_sf_root" && find SPEC/v1 -mindepth 1 ! -type f ! -type d -print 2>&1 ) )" || return 1
  1773	  [[ -z "$_sf_odd" ]] || return 1
  1774	  local _sf_lines
  1775	  _sf_lines="$(
  1776	    ( cd "$_sf_root" && find SPEC/v1 -type f -print 2>/dev/null ) \
  1777	      | LC_ALL=C sort | while IFS= read -r _sf_rel; do
  1778	          [[ -n "$_sf_rel" ]] || continue
  1779	          _sf_h="$( _hash_file "$_sf_root/$_sf_rel" 2>/dev/null || true )"
  1780	          if [[ -z "$_sf_h" ]]; then
  1781	            printf 'HASH-FAILED\n'
  1782	            break
  1783	          fi
  1784	          printf '%s  %s\n' "$_sf_h" "$_sf_rel"
  1785	        done
  1786	  )"
  1787	  case "$_sf_lines" in
  1788	    ""|*HASH-FAILED*) return 1 ;;
  1789	  esac
  1790	  printf '%s\n' "$_sf_lines" | _hash_stdin
  1791	}
  1792	
  1793	
  1794	# =============================================================================
  1795	# PLAN-167 W2.2 — OBSERVERS.
  1796	#
  1797	# The callers no longer decide. They observe the nine dimensions, hand them to
  1798	# _ownership_verdict, and execute what comes back. Everything below answers a
  1799	# question about the world; nothing below chooses an outcome.
  1800	#
  1801	# That separation is the entire point. In S296 the answer to "is this owned?"
  1802	# was recomputed inline at every branch, so two branches could answer the same
  1803	# question differently and nothing detected the contradiction.
  1804	# =============================================================================
  1805	
  1806	# _ov_obs_live_type <abs path> — lstat vocabulary, never following.
  1807	_ov_obs_live_type() {
  1808	  _olt_p="$1"
  1809	  # Classify NON-REGULAR entries before anything opens the path. `ls -A` on a
  1810	  # FIFO blocks forever waiting for a writer, so testing -d before -p turned
  1811	  # the observer itself into the hang it was written to detect.
  1812	  if   [ -L "$_olt_p" ]; then printf 'symlink'
  1813	  elif [ ! -e "$_olt_p" ]; then printf 'absent'
  1814	  elif [ -p "$_olt_p" ] || [ -S "$_olt_p" ]; then printf 'special'
  1815	  elif [ -d "$_olt_p" ]; then
  1815	  elif [ -d "$_olt_p" ]; then
  1816	    if [ -z "$( ls -A "$_olt_p" 2>/dev/null )" ]; then printf 'dir_empty'; else printf 'dir'; fi
  1817	  elif [ -f "$_olt_p" ]; then printf 'regular'
  1818	  else printf 'special'; fi
  1819	}
  1820	
  1821	# _ov_obs_prior_record <relpath> — what the PRE-run sanitized baseline says.
  1822	# link_match only when the recorded target still equals the live readlink; a
  1823	# LINK row whose target moved is link_retargeted, and so is a LINK row whose
  1824	# live path is no longer a symlink at all (readlink yields empty, which never
  1825	# equals a recorded non-empty target).
  1826	_ov_obs_prior_record() {
  1827	  _opr_rel="$1"
  1828	  [ -n "${_BASELINE_MANIFEST_FILE:-}" ] && [ -f "$_BASELINE_MANIFEST_FILE" ] || { printf 'none'; return 0; }
  1829	  _opr_link="$( grep -E "^LINK  ${_opr_rel}  " "$_BASELINE_MANIFEST_FILE" 2>/dev/null | head -1 || true )"
  1830	  if [ -n "$_opr_link" ]; then
  1831	    # Fixed double-space delimiter, never whitespace field-splitting: a
  1832	    # checkout path containing a space made awk '{print $3}' read an unchanged
  1833	    # delivery as redirected.
  1834	    _opr_rec="${_opr_link#LINK  ${_opr_rel}  }"
  1835	    _opr_live="$( readlink "$TARGET/$_opr_rel" 2>/dev/null || true )"
  1836	    if [ -n "$_opr_rec" ] && [ "$_opr_rec" = "$_opr_live" ]; then printf 'link_match'
  1837	    else printf 'link_retargeted'; fi
  1838	    return 0
  1839	  fi
  1840	  if grep -Eq "^[0-9a-f]{64}  ${_opr_rel}(/|$)" "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
  1841	    printf 'hash'; return 0
  1842	  fi
  1843	  printf 'none'
  1844	}
  1845	
  1846	# _ov_obs_spec_content — pristine | legacy_pristine | legacy_pristine_partial
  1847	#                        | edited | -
  1848	# A tree the fingerprint cannot fully inventory is NOT "pristine with a note":
  1849	# it is its own observable, because a partial inventory must never certify a
  1850	# wholesale replace (ADR-155-AMEND-1 §4).
  1851	_ov_obs_spec_content() {
  1852	  [ -e "$TARGET/SPEC/v1" ] || { printf '-'; return 0; }
  1853	  _osc_fp="$( _spec_tree_fingerprint "$TARGET" 2>/dev/null || true )"
  1854	  if [ -z "$_osc_fp" ]; then
  1855	    # No fingerprint. Distinguish "cannot inventory" (a non-regular entry is
  1856	    # present) from "not comparable at all".
  1857	    _osc_odd="$( ( cd "$TARGET" && find SPEC/v1 -mindepth 1 ! -type f ! -type d -print 2>/dev/null ) )"
  1858	    if [ -n "$_osc_odd" ]; then printf 'legacy_pristine_partial'; else printf 'edited'; fi
  1859	    return 0
  1860	  fi
  1861	  _osc_src="$( _spec_tree_fingerprint "$SOURCE_DIR" 2>/dev/null || true )"
  1862	  if [ -n "$_osc_src" ] && [ "$_osc_fp" = "$_osc_src" ]; then printf 'pristine'; return 0; fi
  1863	  for _osc_pf in $_SPEC_PRISTINE_FINGERPRINTS; do
  1864	    if [ "$_osc_fp" = "$_osc_pf" ]; then printf 'legacy_pristine'; return 0; fi
  1865	  done
  1866	  printf 'edited'
  1867	}
  1868	
  1869	# _ov_obs_skip <relpath> — none | self | descendant.
  1870	# The descendant scan walks the UNION of source and target and includes every
  1871	# removable entry, not just regular files: the forced route find-deletes them
  1872	# all, so a target-only symlink must be visible to skip detection too.
  1873	_ov_obs_skip() {
  1874	  _osk_rel="$1"
  1875	  if _path_is_skipped "$_osk_rel"; then printf 'self'; return 0; fi
  1876	  if [ "$_osk_rel" = "SPEC/v1" ]; then
  1877	    _osk_hit=""
  1878	    while IFS= read -r _osk_f; do
  1879	      [ -n "$_osk_f" ] || continue
  1880	      if _path_is_skipped "$_osk_f"; then _osk_hit=1; break; fi
  1881	    done <<EOF
  1882	$( { ( cd "$SOURCE_DIR" && find SPEC/v1 ! -type d -print 2>/dev/null );
  1883	     [ -d "$TARGET/SPEC/v1" ] && ( cd "$TARGET" && find SPEC/v1 ! -type d -print 2>/dev/null ); } | LC_ALL=C sort -u )
  1884	EOF
  1885	    [ -n "$_osk_hit" ] && { printf 'descendant'; return 0; }
  1886	  fi
  1887	  printf 'none'
  1888	}
  1889	
  1890	# _ov_obs_mode — the delivery mode this run carries. Evidence order: a prior
  1891	# LINK record (authoritative), else a symlink probe on the owned roots.
  1892	_ov_obs_mode() {
  1893	  if [ -n "${_BASELINE_MANIFEST_FILE:-}" ] && [ -f "$_BASELINE_MANIFEST_FILE" ] \
  1894	     && grep -Eq '^LINK  ' "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
  1895	    printf 'link'; return 0
  1896	  fi
  1897	  if [ -L "$TARGET/SPEC/v1" ] || [ -L "$TARGET/.claude/.framework-version" ]; then
  1898	    printf 'link'; return 0
  1899	  fi
  1900	  printf 'copy'
  1901	}
  1902	
  1903	# _refresh_spec_contract — SPEC/v1 takes a FORCED route, NOT the generic
  1904	# backup_and_replace: for a directory target with a baseline, the classified
  1905	# walk PRESERVES adopter edits — so from the 2nd upgrade on, an edited SPEC
  1906	# would classify ADOPTER-CUSTOMIZED and the stale-contract class would
  1907	# return (r6). SPEC/v1 is the published compliance CONTRACT: an adopter edit
  1908	# is a FORK of the contract, not a customization (OQ-3) => backup to
  1909	# $BAK_DIR/SPEC/v1 + replace.
  1910	#   * ceremony: a recorded `--ceremony user` install NEVER receives SPEC/v1
  1911	#     (mirrors install.sh WS4-guard-spec), independent of --no-replay (r9).
  1912	#   * ownership: baseline SPEC records => framework-owned (forced refresh);
  1913	#     no target SPEC => new delivery; target SPEC with NO record => LEGACY
  1914	#     MIGRATION by pristine content (r20): match => framework-owned refresh,
  1915	#     no match => ADOPTER-FORK: preserve + snapshot + named WARNING.
  1916	#   * root VERSION: this function (and the whole upgrade) NEVER touches it —
  1917	#     install_one is skip-if-exists, so on an adopter with its own VERSION
  1918	#     the framework never wrote there; backup_and_replace would TAKE the
  1919	#     file (the S238/ADR-155 "verified worst case", trap C.5). See
  1920	#     ADR-155-AMEND-1 for why the asymmetry is deliberate.
  1921	_SPEC_DELIVERED=0
  1922	_refresh_spec_contract() {
  1923	  local sdir="$SOURCE_DIR/SPEC/v1"
  1924	  local ddir="$TARGET/SPEC/v1"
  1925	  local bdir="$BAK_DIR/SPEC/v1"
  1926	
  1927	  # ---- OBSERVE -------------------------------------------------------------
  1928	  # Nothing here chooses an outcome. Each line answers one question about the
  1929	  # world, and the answers go to _ownership_verdict as the nine dimensions.
  1930	  local _lt _pr _lc _sh _md _sk
  1931	  if _lg_ancestor_is_symlink "$TARGET" "SPEC/v1"; then
  1932	    _lt="ancestor_symlink"           # reachable only by writing THROUGH a symlink
  1933	  else
  1934	    _lt="$( _ov_obs_live_type "$ddir" )"
  1935	  fi
  1936	  _pr="$( _ov_obs_prior_record "SPEC/v1" )"
  1937	  _lc="$( _ov_obs_spec_content )"
  1938	  _sh=no; [ -d "$sdir" ] && _sh=yes
