  2395	      *".claude/.framework-version"*) export FMS_HASH_SOURCE_MARKER="HASH_SOURCE" ;;
  2396	    esac
  2397	    case "$_CONTINUITY_PATHS" in
  2398	      # The generated pointer has no source bytes; carry what was recorded.
  2399	      *"PROTOCOL.md"*)               export FMS_HASH_SOURCE_PROTOCOL="HASH_PRIOR_RECORD" ;;
  2400	    esac
  2401	    echo "    ownership continuity: manifest hashes the preserved paths from the framework source (edited target content stays adopter-owned; rendered files keep their target hash)"
  2402	  fi
  2403	  # Declare on EVERY delivery path, not only continuity. A fresh install
  2404	  # genuinely delivers these surfaces, and the previous attempt at this wave
  2405	  # regressed 24 cells precisely because it left fresh installs undeclared.
  2406	  #
  2407	  # Fresh delivery: the target IS the bytes just written, so HASH_TARGET is
  2408	  # both correct and observationally identical to HASH_SOURCE.
  2409	  # Continuity: the target may be an EDITED fork, so the record must come from
  2410	  # the framework's copy (spec/marker) or the prior record (the generated
  2411	  # pointer, which has no source file).
