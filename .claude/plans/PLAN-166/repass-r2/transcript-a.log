  3320	    "schema_version": 1,
  3321	    "written_at": now,
  3322	    "first_recorded_at": first,
  3323	    "run_count": run_count,
  3324	    "tool": {"name": "upgrade.sh", "framework_version": fw_version},
  3325	    "request": req,
  3326	    "last_upgrade": {
  3327	        "at": now,
  3328	        "argv": up_argv,
  3329	        "profile": vals.get("profile", ""),
  3330	        "stack": vals.get("stack", ""),
  3331	        "on_conflict": vals.get("on_conflict", ""),
  3332	        "pin": vals.get("pin", ""),
  3333	        "replay_source": vals.get("replay_source", ""),
  3334	        "ceremony_effective": vals.get("ceremony_effective", ""),
  3335	    },
  3336	    "operations": ops,
  3337	    "result": {"upgrade_succeeded": True,
