  1940	# Portable sed -i for GNU + BSD (macOS): write to .tmp and mv.
  1941	portable_sed_inplace() {
  1942	  # $1 = sed script, $2 = file
  1943	  local script="$1" file="$2"
  1944	  local tmp="${file}.ceo-sed-tmp"
  1945	  sed "$script" "$file" > "$tmp" && mv "$tmp" "$file"
