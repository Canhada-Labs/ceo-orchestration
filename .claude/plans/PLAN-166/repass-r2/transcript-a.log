    94	#
    95	#   -h, --help                     Show this help
    96	#
    97	#   --strict-placeholders          Post-install validator: fail install if any
    98	#                                  `{{X}}` placeholder remains unsubstituted in
    99	#                                  installed files. Recommended for CI / first
   100	#                                  install of a new adopter. Equivalent to
   101	#                                  exporting `CEO_INSTALL_STRICT_PH=1`.
   102	#                                  (Session 75 Codex Finding 5 — wired here.)
   103	#
   104	#   --verify                       Re-checksum installed skill SHAs against the
   105	#                                  source manifest (.claude/skill-manifest.sha256
   106	#                                  if shipped). Basic integrity check. Sigstore
   107	#                                  backend is OUT OF SCOPE per Owner D2 (Session
   108	#                                  75 lock); use OS-level package signing if you
   109	#                                  need cryptographic provenance.
   110	#
   111	#   --verify-sigstore              DEPRECATED alias for --verify (Session 76
   112	#                                  audit-v3 / Codex DIM-19 closure). Emits a
   113	#                                  stderr deprecation warning and behaves
   114	#                                  identically to --verify. The sigstore
   115	#                                  backend is NOT reintroduced (Owner D2).
   116	#                                  deprecated_in 1.11.4 / removed_in 2.0.0.
   117	#
   118	# What it does:
   119	#   1. (NEW — F-CHAOS-2) Snapshots existing $TARGET/.claude/ to a backup
   120	#      tempdir and restores it atomically on any failure. Cleans the
   121	#      backup on success. trap cleanup_on_failure EXIT.
   122	#   2. Always installs:
   123	#      - .claude/team.md, .claude/frontend-team.md (template with placeholders)
   124	#      - .claude/skills/core/ (universal skills)
   125	#      - .claude/skills/frontend/ (if frontend profile selected)
   126	#      - .claude/hooks/, .claude/scripts/, .claude/commands/
   127	#      - .claude/pitfalls-catalog.yaml, .claude/task-chains.yaml, .claude/agent-metrics.md
   128	#   3. If --profile includes a domain name (e.g. fintech):
   129	#      - Installs .claude/skills/domains/<domain>/ with its skills, pitfalls, task-chains,
   130	#        team-personas, commands, scripts.
   131	#   4. Produces .claude/settings.json from templates/settings/settings.base.json
   132	#      (+ settings.stack.<stack>.json if --stack is set), using jq to merge.
   133	#      Hard-fails (rc=3) if --stack is EXPLICITLY supplied and jq is missing.
   134	#   4b. (PLAN-153 Wave E item 3) Injects a coarse credential-read deny
   135	#      baseline into the permissions.deny of a settings.json THIS run
   136	#      created (SSH/AWS/npm/gcloud/kube/docker/git-credentials/netrc/
   137	#      pypirc reads, common .env variants, curl-pipe-bash tripwire).
   138	#      HONEST FRAMING: a coarse harness backstop, deliberately NOT sold
   139	#      as coverage — the pipe-to-shell class is owned by
   140	#      check_bash_safety.py's parse gate. Skipped when settings.json
   141	#      pre-existed (re-runs never re-add removed entries) or when
   142	#      CEO_INSTALL_SKIP_DENY_BASELINE=1. See docs/deny-baseline.md.
   143	#   5. Copies templates/CLAUDE.md to target as CLAUDE.md (only if missing)
   144	#   6. Copies templates/MEMORY.md to target as MEMORY.md (only if missing)
   145	#   6b. (PLAN-135 W1 S5-lite) Copies templates/.mcp.json to target as
   146	#      .mcp.json (only if missing — project-scope MCP registration for
   147	#      the Codex pair-rail; maintainer ceremony only, same EXISTS->SKIP
   148	#      idempotency as CLAUDE.md/MEMORY.md).
   149	#   7. (NEW — P1-CR-3) Runs a sed substitution pass over freshly-installed
   150	#      template files for the placeholders supplied via CLI / env. Any
   151	#      placeholder left unrendered is reported with a stderr warning and
   152	#      listed at the end.
   153	#   8. Lists placeholders the user must fill in.
   154	#   9. (PLAN-153 Wave B item B1) Records the install-state at
   155	#      .claude/.install-state.json (schema ceo.install-state/v1, atomic
   156	#      same-directory tmpfile + rename): the ORIGINAL request (verbatim
   157	#      argv + every parsed flag + the RESOLVED placeholder map) and each
   158	#      operation performed, updated on every run. Target-side, UNSIGNED,
   159	#      advisory — same trust class as the ADR-155 baseline manifest.
   160	#      upgrade.sh (item B2) replays request.profile / request.stack as
   161	#      DEFAULTS when its own flags are omitted.
   162	#
   163	# Idempotent: re-running won't clobber edited files.
   164	#
   165	# Portability: this script targets bash >= 3.2 (macOS default). It uses
   166	#   no bash-4-only features (no associative arrays, no `mapfile`, no
   167	#   `read -d ''`, no `${var^^}`). Tested on Darwin bash-3.2 and Linux
   168	#   bash-5.x.
   169	
   170	# ----------------------------------------------------------------------
   171	# DevOps-P1-3: bash version guard (must appear BEFORE `set -euo pipefail`
   172	# so an old shell that doesn't understand newer constructs errors out
   173	# with a friendly message, not a syntax error)
   174	# ----------------------------------------------------------------------
   175	if [ -z "${BASH_VERSINFO:-}" ]; then
   176	  echo "ERROR: install.sh requires bash (detected non-bash shell)" >&2
   177	  echo "       Run:   bash scripts/install.sh <target>" >&2
   178	  exit 1
   179	fi
   180	
   181	if [ "${BASH_VERSINFO[0]}" -lt 3 ] || \
   182	   { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
   183	  echo "ERROR: install.sh requires bash >= 3.2 (detected ${BASH_VERSION})" >&2
   184	  exit 1
   185	fi
   186	
   187	# ----------------------------------------------------------------------
   188	# P2-SEC-F (PLAN-019 Phase 3 Wave 3B): required-deps preflight.
   189	# Defense-in-depth: if any of jq, sed, git is missing, fail early with
   190	# a clear error pointing to the package manager. Upstream hardened
   191	# bootstrap (checksum-verified deps) is documented in docs/INSTALL.md
   192	# under "Hardened bootstrap".
   193	# ----------------------------------------------------------------------
   194	_missing_deps=""
   195	for _cmd in sed git; do
   196	  if ! command -v "$_cmd" >/dev/null 2>&1; then
   197	    _missing_deps="${_missing_deps:+$_missing_deps }$_cmd"
   198	  fi
   199	done
   200	# jq is conditionally required (only when --stack is explicit). We warn
   201	# softly here; the hard-fail lives in build_settings() below.
   202	if [ -n "$_missing_deps" ]; then
   203	  echo "ERROR: install.sh requires: $_missing_deps" >&2
   204	  echo "       Install via your package manager (apt/brew/dnf) and retry." >&2
   205	  exit 3
   206	fi
   207	unset _missing_deps _cmd
   208	
   209	set -euo pipefail
   210	
   211	# Resolve SCRIPT_DIR with a readlink-with-fallback so the script works
   212	# when invoked via a symlink (e.g. from /usr/local/bin/install-ceo).
   213	_resolve_script_path() {
   214	  local src="$1"
   215	  # If GNU/BSD readlink is available, prefer it; fall back to $src as-is.
   216	  if command -v readlink >/dev/null 2>&1; then
   217	    # Try `readlink -f` (GNU) first; on macOS this may not exist, so
   218	    # fall through to plain readlink which follows one symlink level.
   219	    local resolved
   220	    if resolved="$(readlink -f "$src" 2>/dev/null)" && [ -n "$resolved" ]; then
   221	      printf '%s\n' "$resolved"
   222	      return 0
   223	    fi
   224	    # Manual one-level dereference loop for macOS bash 3.2 without -f.
   225	    while [ -L "$src" ]; do
   226	      local link_target
   227	      link_target="$(readlink "$src")"
   228	      case "$link_target" in
   229	        /*) src="$link_target" ;;
   230	        *)  src="$(cd "$(dirname "$src")" && pwd)/$link_target" ;;
