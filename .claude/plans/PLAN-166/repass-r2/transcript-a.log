  1378	  fi
  1379	
  1380	  if [[ -e "$dst" ]]; then
  1381	    mkdir -p "$( dirname "$bak" )"
  1382	    if [[ -d "$dst" ]]; then
  1383	      cp -R "$dst" "$bak"
  1384	    else
  1385	      cp "$dst" "$bak"
  1386	    fi
  1387	    echo "    BACKED UP: $rel_path"
  1388	  fi
  1389	
  1390	  # PLAN-161 W2 fix-2 (codex r2 F11): the legacy DIRECTORY branch used to
  1391	  # empty $dst WHOLESALE (find -delete + rmdir) before the copy — which
  1392	  # silently DELETED any excluded-tree content already present at dst
  1393	  # (adopter-owned OR mis-installed), before any preview/hash gate: an
  1394	  # implicit purge that violated the opt-in-only --purge-misinstalled
  1395	  # contract (U3). The pre-copy delete now SKIPS excluded paths (files AND
  1396	  # dirs, contents intact) and the copy below never writes them, so a
  1397	  # legacy upgrade neither ADDS nor REMOVES excluded-tree files; the U3
  1398	  # opt-in flag remains the ONLY path that deletes them. Survivors are
  1399	  # recorded (relpaths, one per line) so the r1 post-copy prune can tell
