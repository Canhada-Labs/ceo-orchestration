   535	_rollup_from_tree() {  # $1 = tree abs path, $2 = relpath prefix
   536	  local root="$1" pfx="$2"
   537	  [[ -d "$root" ]] || { printf ''; return 0; }
   538	  ( cd "$root" && find . -type f -print 2>/dev/null ) | LC_ALL=C sort \
   539	    | while IFS= read -r r; do
   540	        [[ -n "$r" ]] || continue
   541	        printf '%s  %s/%s\n' "$( _hash_file "$root/$r" 2>/dev/null || echo FAIL )" "$pfx" "${r#./}"
   542	      done | LC_ALL=C sort | _hash_stdin
   543	}
