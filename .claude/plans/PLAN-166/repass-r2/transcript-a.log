  1846	# _ov_obs_spec_content — pristine | legacy_pristine | legacy_pristine_partial
  1847	#                        | edited | -
  1848	# A tree the fingerprint cannot fully inventory is NOT "pristine with a note":
  1849	# it is its own observable, because a partial inventory must never certify a
  1850	# wholesale replace (ADR-155-AMEND-1 §4).
     1	# shellcheck shell=bash
     2	# scripts/_hash_lib.sh — portable SHA-256 helpers (PLAN-138 Wave C / ADR-155)
     3	#
     4	# Sourced (not executed) by scripts/install.sh and scripts/upgrade.sh. Extracts
     5	# the shasum||sha256sum probe that previously lived inline in install.sh's
     6	# _self_sha_compute (lines 228-243) so the install/upgrade baseline-manifest
     7	# engine has ONE portable hasher.
     8	#
     9	# Two surfaces, deliberately distinct:
    10	#   _hash_file  <path>   -> sha256 of FILE CONTENT (the manifest baseline + dst/src classification)
    11	#   _hash_stdin          -> sha256 of a STRING/STREAM read from stdin
    12	#                           (upgrade.sh:209 hashes a PATH STRING, not a file —
    13	#                            a content hash there would be wrong)
    14	#
    15	# Contract:
    16	#   * bash 3.2-safe (macOS /bin/bash 3.2.57): no associative arrays, no mapfile,
    17	#     no process-substitution dependency, no GNU-only flags.
    18	#   * Portable across macOS (shasum) and Linux (sha256sum). shasum is preferred
    19	#     (present on macOS by default); sha256sum is the Linux fallback.
    20	#   * Each function prints exactly the 64-hex digest on stdout (no filename
    21	#     column) and returns 0 on success; returns 1 if neither hasher exists or
    22	#     (for _hash_file) the path is unreadable. Never prints a partial/empty
    23	#     digest on success — callers under `set -euo pipefail` rely on this.
    24	#
    25	# This file is CANONICAL (added to _CANONICAL_GUARDS in check_canonical_edit.py):
    26	# it is sourced by the GPG-gated install/upgrade and must not be a soft
    27	# underbelly for tampering with the integrity engine.
    28	
    29	# Resolve the available hasher ONCE and echo the command words. Probe order
    30	# matches install.sh _self_sha_compute (shasum first, sha256sum fallback).
    31	# Prints the hasher invocation (e.g. "shasum -a 256") on stdout; returns 1 if
    32	# neither is on PATH.
    33	_hash_resolver() {
    34	  if command -v shasum >/dev/null 2>&1; then
    35	    printf '%s\n' "shasum -a 256"
    36	    return 0
    37	  elif command -v sha256sum >/dev/null 2>&1; then
    38	    printf '%s\n' "sha256sum"
    39	    return 0
    40	  fi
    41	  return 1
    42	}
    43	
    44	# _hash_file <path> — SHA-256 of the file's CONTENT. Prints 64-hex on stdout.
    45	# Returns 1 if no hasher is available or the path is not a readable file.
    46	_hash_file() {
    47	  _hf_path="$1"
    48	  if [ -z "${_hf_path:-}" ] || [ ! -f "$_hf_path" ] || [ ! -r "$_hf_path" ]; then
    49	    return 1
    50	  fi
    51	  _hf_hasher="$( _hash_resolver )" || return 1
    52	  # Feed the file on stdin so neither hasher prints the filename column; then
    53	  # take the first whitespace-delimited field (the digest). Guard against an
    54	  # empty digest by checking the length downstream is the caller's job, but we
    55	  # never emit a success line without a digest because a hasher failure makes
    56	  # the pipeline's last stage (awk) print nothing AND we propagate non-zero.
    57	  _hf_digest="$( eval "$_hf_hasher" < "$_hf_path" | awk '{print $1; exit}' )"
    58	  if [ -z "${_hf_digest:-}" ]; then
    59	    return 1
    60	  fi
    61	  printf '%s\n' "$_hf_digest"
    62	}
    63	
    64	# _hash_stdin — SHA-256 of whatever is on stdin (a string or a stream). Prints
    65	# 64-hex on stdout. Use for hashing a PATH STRING or other non-file input, e.g.
    66	#   hash="$( printf '%s' "$repo_root" | _hash_stdin )"
    67	# Returns 1 if no hasher is available or the resulting digest is empty.
    68	_hash_stdin() {
    69	  _hs_hasher="$( _hash_resolver )" || return 1
    70	  _hs_digest="$( eval "$_hs_hasher" | awk '{print $1; exit}' )"
    71	  if [ -z "${_hs_digest:-}" ]; then
    72	    return 1
    73	  fi
    74	  printf '%s\n' "$_hs_digest"
    75	}
    76	
    77	# _hash_verify_c <checksum-file> — portable `shasum -a 256 -c` / `sha256sum -c`.
    78	# Verifies the "<hex>  <path>" lines in <checksum-file> against the CURRENT
    79	# working directory (caller cd's first, matching the legacy call sites).
    80	# Returns 0 if all listed files match, 1 otherwise (incl. no hasher). Output is
    81	# suppressed by the caller; this just carries the exit status.
    82	_hash_verify_c() {
    83	  _hv_file="$1"
    84	  if command -v shasum >/dev/null 2>&1; then
    85	    shasum -a 256 -c "$_hv_file"
    86	    return $?
    87	  elif command -v sha256sum >/dev/null 2>&1; then
    88	    sha256sum -c "$_hv_file"
    89	    return $?
    90	  fi
    91	  return 1
    92	}
