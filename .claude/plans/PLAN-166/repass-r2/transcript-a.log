   653	  else
   654	    local iargs=( "$T" --ceremony "$ceremony" )
   655	    [[ "$mode" == "link" ]] && iargs+=( --link )
   656	    [[ "$transition_to_user" -eq 1 ]] && iargs=( "$T" --ceremony user )
   657	    _run_with_timeout "$CELL_TIMEOUT" "$src/scripts/install.sh" "${iargs[@]}" >> "$out" 2>&1
   658	    rc=$?
   659	  fi
   660	  [[ -n "$bak_guard" ]] && chmod -R u+rwX "$bak_guard" 2>/dev/null
   661	
   662	  local timed_out=0
