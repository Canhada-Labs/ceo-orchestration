  3246	import json, os, sys, tempfile, time
  3247	args = sys.argv[1:]
  3248	state_path, ops_path, fw_version = args[0], args[1], args[2]
  3249	n = int(args[3]); kv = args[4:4 + n]; up_argv = list(args[4 + n:])
