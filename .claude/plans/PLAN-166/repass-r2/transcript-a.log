  2020	  _state_record_op "apply_placeholder_substitutions" ""
  2021	
  2022	  # Files we are allowed to rewrite — strictly the template-sourced files
  2023	  # that install.sh just placed. We check existence first.
  2024	  #
  2025	  # We intentionally do NOT touch:
  2026	  #   - .claude/settings.json          (user-edited hook registry)
