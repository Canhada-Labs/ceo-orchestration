  1087	_load_baseline_manifest
  1088	
  1089	# PLAN-161 U1 (codex r1 F4) — manifest-load observability. Byte-identity alone
  1090	# cannot prove a --dry-run kept provenance classification alive (a dry-run
  1091	# that silently lost the baseline would also write nothing), so EVERY run
  1092	# states which classification mode it operates in.
  1093	if [ -n "$_BASELINE_MANIFEST_FILE" ]; then
  1094	  echo "==> Baseline manifest: loaded (provenance classification ACTIVE)"
  1095	else
  1096	  echo "==> Baseline manifest: none — fallback diff -q classification"
  1097	fi
  1098	
  1099	# F-CHAOS-3: match a relative path against the --skip globs list.
  1100	# Returns 0 (true) if matched.
  1101	_path_is_skipped() {
  1102	  local rel="$1"
  1103	  local pattern
  1104	  for pattern in "${SKIP_GLOBS[@]:-}"; do
  1105	    [[ -n "$pattern" ]] || continue
  1106	    # Intentional unquoted glob match (the whole point of --skip patterns).
  1107	    # shellcheck disable=SC2053,SC2254
  1108	    case "$rel" in
  1109	      $pattern) return 0 ;;
  1110	    esac
  1111	  done
  1112	  return 1
  1113	}
  1114	
  1115	# F-CHAOS-3: emit a diff-q-style WARNING line for every adopter file
  1116	# that differs from the source before we overwrite it. Recurses into
  1117	# directories. Respects --no-diff-warn and --skip globs.
  1118	_emit_diff_warnings() {
  1119	  local rel_path="$1"
  1120	  local src="$SOURCE_DIR/$rel_path"
  1121	  local dst="$TARGET/$rel_path"
  1122	
  1123	  [[ "$DIFF_WARN" -eq 1 ]] || return 0
  1124	  [[ -e "$dst" && -e "$src" ]] || return 0
  1125	
  1126	  if [[ -d "$src" && -d "$dst" ]]; then
  1127	    # Per-file diff within the directory
  1128	    local f rel sub
  1129	    while IFS= read -r f; do
  1130	      [[ -n "$f" ]] || continue
  1131	      sub="${f#$dst/}"
  1132	      rel="$rel_path/$sub"
  1133	      if _path_is_skipped "$rel"; then
  1134	        echo "    SKIP-DIFF (--skip): $rel" >&2
  1135	        continue
  1136	      fi
  1137	      if [[ -f "$SOURCE_DIR/$rel" ]]; then
  1138	        if ! diff -q "$f" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
  1139	          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN" >&2
  1140	          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
  1141	        fi
  1142	      fi
  1143	    done < <(find "$dst" -type f 2>/dev/null)
  1144	  elif [[ -f "$src" && -f "$dst" ]]; then
  1145	    if _path_is_skipped "$rel_path"; then
  1146	      echo "    SKIP-DIFF (--skip): $rel_path" >&2
  1147	      return 0
  1148	    fi
  1149	    if ! diff -q "$dst" "$src" >/dev/null 2>&1; then
  1150	      echo "    WARNING: adopter customization in $rel_path will be OVERWRITTEN" >&2
  1151	      echo "             (backup preserved in $BAK_DIR/$rel_path)" >&2
  1152	    fi
  1153	  fi
  1154	}
  1155	
  1156	# PLAN-138 Wave C (ADR-155): update ONE file under a classified directory walk.
  1157	# $1 = repo-relative file path. Backs up the dst file then copies src over it.
  1158	# Used by _per_file_classified_update for the FRAMEWORK-CHANGED / theirs / backup
  1159	# branches. find+delete idiom is unnecessary for a single file (plain cp).
  1160	_apply_single_file() {
  1161	  local rel="$1"
  1162	  local s="$SOURCE_DIR/$rel"
  1163	  local d="$TARGET/$rel"
  1164	  local b="$BAK_DIR/$rel"
  1165	  [[ -f "$s" ]] || return 0
  1166	  if [[ -e "$d" ]]; then
  1167	    mkdir -p "$( dirname "$b" )"
  1168	    cp "$d" "$b" 2>/dev/null || true
  1169	  fi
  1170	  mkdir -p "$( dirname "$d" )"
  1171	  cp "$s" "$d"
  1172	}
  1173	
  1174	# PLAN-138 Wave C (ADR-155): per-file walk of a DIRECTORY target driven by the
  1175	# baseline classifier. Replaces the whole-tree delete+cp -R when a baseline
  1176	# manifest is loaded, so an adopter customization INSIDE a directory is
  1177	# preserved/refused per-file instead of being wiped. The union of source + dst
  1178	# files is walked so framework-added files land and removed-from-source files
  1179	# are reported (never auto-deleted — destructive removals stay manual).
  1180	_per_file_classified_update() {
  1181	  local rel_dir="$1"
  1182	  local sdir="$SOURCE_DIR/$rel_dir"
  1183	  local ddir="$TARGET/$rel_dir"
  1184	  local listing rel verdict
  1185	  # Build the union of relpaths under src + dst (regular files only).
  1186	  listing="$( {
  1187	    [[ -d "$sdir" ]] && find "$sdir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$SOURCE_DIR"/}"; done
  1188	    [[ -d "$ddir" ]] && find "$ddir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$TARGET"/}"; done
  1189	  } | LC_ALL=C sort -u )"
  1190	
  1191	  printf '%s\n' "$listing" | while IFS= read -r rel; do
  1192	    [[ -n "$rel" ]] || continue
  1193	    # PLAN-161 U2 (CF-7): the canonical framework-internal exclusion set —
  1194	    # never install, never re-add after an adopter deletes, never report.
  1195	    # Silent skip; the opt-in U3 purge is the ONLY code allowed to touch
  1196	    # these paths (and only hash-gated).
  1197	    if command -v _framework_path_excluded >/dev/null 2>&1 && _framework_path_excluded "$rel"; then
  1198	      continue
  1199	    fi
  1200	    if _path_is_skipped "$rel"; then
  1201	      echo "    SKIPPED (--skip): $rel"
  1202	      continue
  1203	    fi
  1204	    # Source-removed file: present at dst, absent at src. Report, never delete.
  1205	    if [[ ! -f "$SOURCE_DIR/$rel" ]]; then
  1206	      echo "    KEPT (no longer shipped by framework — not removed): $rel" >&2
  1207	      continue
  1208	    fi
  1209	    # New framework file: absent at dst. Just install it.
  1210	    if [[ ! -f "$TARGET/$rel" ]]; then
  1211	      _apply_single_file "$rel"
  1212	      echo "    ADDED: $rel"
  1213	      continue
  1214	    fi
  1215	    verdict="$( _classify_against_baseline "$rel" )"
  1216	    case "$verdict" in
  1217	      IDENTICAL)
  1218	        : ;;  # nothing to do
  1219	      FRAMEWORK-CHANGED)
  1220	        # Quiet auto-update is the intended path (dst matched the recorded
  1221	        # baseline => the adopter had not customized this file). BUT the manifest
  1222	        # is UNSIGNED/target-side (OQ-trust): a tampered line where H_base==H_dst
  1223	        # would mis-classify a customized file into this branch. We cannot detect
  1224	        # that without a signed manifest, so per Codex R1 P0#1 this is downgraded
  1225	        # to NON-SILENT: _apply_single_file always backs up the original first,
  1226	        # and we surface the overwrite + backup location on stderr (recoverable
  1227	        # AND visible — worst case equals today's warn-then-clobber).
  1228	        _apply_single_file "$rel"
  1229	        echo "    UPDATED (framework-changed; unsigned baseline — original backed up to $BAK_DIR/$rel): $rel" >&2
  1230	        ;;
  1231	      ADOPTER-CUSTOMIZED)
  1232	        echo "    PRESERVED (ADOPTER-CUSTOMIZED — not overwritten): $rel" >&2
  1233	        ;;
  1234	      CONFLICT)
  1235	        case "$ON_CONFLICT" in
  1236	          theirs)
  1237	            _apply_single_file "$rel"
  1238	            echo "    OVERWROTE (CONFLICT, --on-conflict=theirs): $rel" >&2
  1239	            ;;
  1240	          backup)
  1241	            _apply_single_file "$rel"
  1242	            echo "    OVERWROTE (CONFLICT, --on-conflict=backup; original in $BAK_DIR/$rel): $rel" >&2
  1243	            ;;
  1244	          *)  # refuse (default): per-file skip-and-report-and-CONTINUE
  1245	            echo "    REFUSED (CONFLICT, --on-conflict=refuse — not overwritten): $rel" >&2
  1246	            ;;
  1247	        esac
  1248	        ;;
  1249	      FALLBACK|*)
  1250	        # No usable baseline for this file — today's diff -q warn-then-clobber.
  1251	        if [[ "$DIFF_WARN" -eq 1 ]] && ! diff -q "$TARGET/$rel" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
  1252	          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN (no baseline)" >&2
  1253	          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
  1254	        fi
  1255	        _apply_single_file "$rel"
  1256	        echo "    UPDATED (fallback): $rel"
  1257	        ;;
  1258	    esac
  1259	  done
  1260	}
