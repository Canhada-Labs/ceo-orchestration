   642	# validated (profile: [A-Za-z0-9_,.-]{1,200}; stack: [A-Za-z0-9_.-]{1,100}),
   643	# and NEVER eval-ed; anything suspect => fallback, exactly as if absent.
   644	_INSTALL_STATE_FILE="$TARGET/.claude/.install-state.json"
