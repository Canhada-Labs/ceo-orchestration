   974	        case "$target" in
   975	          *[$'\n\r\t']*) continue ;;
   976	        esac
   977	        printf 'LINK  %s  %s\n' "$rel" "$target" >> "$sanitized"
   978	        ;;
   979	      *)
   980	        # Must be exactly 64-hex, two spaces, then relpath.
   981	        digest="${line%%  *}"
