  1432	    while IFS= read -r _lg_hit; do
  1433	      [[ -n "$_lg_hit" ]] || continue
  1434	      _lg_rel="${_lg_hit#"$TARGET"/}"
  1435	      if _framework_path_excluded "$_lg_rel"; then
  1436	        printf '%s\n' "$_lg_rel" >> "$_lg_survivors"
  1437	      else
  1438	        rmdir "$_lg_hit" 2>/dev/null || true
  1439	      fi
  1440	    done < <( find "$dst" -depth -type d -print 2>/dev/null )
