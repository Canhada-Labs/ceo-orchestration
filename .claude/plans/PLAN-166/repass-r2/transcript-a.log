  2395	      *".claude/.framework-version"*) export FMS_HASH_SOURCE_MARKER="HASH_SOURCE" ;;
  2396	    esac
  2397	    case "$_CONTINUITY_PATHS" in
  2398	      # The generated pointer has no source bytes; carry what was recorded.
  2399	      *"PROTOCOL.md"*)               export FMS_HASH_SOURCE_PROTOCOL="HASH_PRIOR_RECORD" ;;
  2400	    esac
  2401	    echo "    ownership continuity: manifest hashes the preserved paths from the framework source (edited target content stays adopter-owned; rendered files keep their target hash)"
  2402	  fi
  2403	  # Declare on EVERY delivery path, not only continuity. A fresh install
  2404	  # genuinely delivers these surfaces, and the previous attempt at this wave
  2405	  # regressed 24 cells precisely because it left fresh installs undeclared.
  2406	  #
  2407	  # Fresh delivery: the target IS the bytes just written, so HASH_TARGET is
  2408	  # both correct and observationally identical to HASH_SOURCE.
  2409	  # Continuity: the target may be an EDITED fork, so the record must come from
  2410	  # the framework's copy (spec/marker) or the prior record (the generated
  2411	  # pointer, which has no source file).
  2412	  export FMS_SOURCE_ROOT="$SOURCE_DIR"
  2413	  export FMS_PRIOR_MANIFEST="$manifest"
  2414	  if [[ "${_DELIVERED_SPEC:-0}" = "1" ]]; then
  2415	    case "${_CONTINUITY_PATHS:-}" in
  2416	      *"SPEC/v1"*) export FMS_HASH_SOURCE_SPEC="HASH_SOURCE" ;;
  2417	      *)           export FMS_HASH_SOURCE_SPEC="HASH_TARGET" ;;
  2418	    esac
  2419	  fi
  2420	  if [[ "${_DELIVERED_MARKER:-0}" = "1" ]]; then
  2421	    case "${_CONTINUITY_PATHS:-}" in
  2422	      *".claude/.framework-version"*) export FMS_HASH_SOURCE_MARKER="HASH_SOURCE" ;;
  2423	      *)                              export FMS_HASH_SOURCE_MARKER="HASH_TARGET" ;;
  2424	    esac
  2425	  fi
  2426	  if [[ "${_DELIVERED_PROTOCOL:-0}" = "1" ]]; then
  2427	    case "${_CONTINUITY_PATHS:-}" in
  2428	      *"PROTOCOL.md"*) export FMS_HASH_SOURCE_PROTOCOL="HASH_PRIOR_RECORD" ;;
  2429	      *)               export FMS_HASH_SOURCE_PROTOCOL="HASH_TARGET" ;;
  2430	    esac
  2431	  fi
  2432	  export FMS_DELIVERED_SPEC="${_DELIVERED_SPEC:-0}"
  2433	  export FMS_DELIVERED_PROTOCOL="${_DELIVERED_PROTOCOL:-0}"
  2434	  export FMS_DELIVERED_MARKER="${_DELIVERED_MARKER:-0}"
  2435	  # Empty on a fresh install (target IS the freshly written pointer, hashing it
  2436	  # is correct); set only by the continuity path above.
  2437	  export FMS_PROTOCOL_HASH="${_PRIOR_PROTOCOL_HASH:-}"
  2438	  _write_baseline_manifest "$manifest"
  2439	  unset FMS_ROOT FMS_PROFILE_PARTS FMS_MODE FMS_HASH_ROOT FMS_PROTOCOL_HASH \
  2440	        FMS_PRIOR_MANIFEST FMS_HASH_SOURCE_SPEC FMS_HASH_SOURCE_PROTOCOL \
  2441	        FMS_HASH_SOURCE_MARKER
  2442	  unset FMS_DELIVERED_SPEC FMS_DELIVERED_PROTOCOL FMS_DELIVERED_MARKER
  2443	  return 0
  2444	}
