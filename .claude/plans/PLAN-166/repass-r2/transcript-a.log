  1160	# PLAN-133 E2 — OSV.dev / OSSF malicious-packages supply-chain advisory.
  1161	#
  1162	# OPT-IN + DEFAULT-OFF + NEVER-HANG. With CEO_OSV_GATE unset this is a no-op
  1163	# (we never add latency or network egress to a default install). When an
  1164	# adopter / CI opts in (CEO_OSV_GATE=advisory or =block), this scans the
  1165	# install commands the framework ships (the squad-install / accelerator npx/
  1166	# uvx/pip lines) against OSV.dev for MAL-* advisories via .claude/scripts/
  1167	# osv_check.py.
  1168	#
  1169	# Hard-timeout + offline-safe + fail-OPEN contract:
  1170	#   * A hard `timeout` ceiling (CEO_OSV_TIMEOUT_S, default 4s) wraps the call
  1171	#     so the gate can NEVER out-live or hang a fast install step.
  1172	#   * If neither `timeout`/`gtimeout` nor python3 is present, we SKIP (advisory)
  1173	#     and print a breadcrumb — we never block on missing infra.
  1174	#   * `advisory` mode never changes the install exit status (rc=0 always).
  1175	#   * `block` mode fails the install (rc=4 from this function → caller may halt)
  1176	#     ONLY on a concrete MAL advisory hit. A timeout / unknown / malformed
  1177	#     response is fail-OPEN by contract and never blocks.
  1178	osv_supply_chain_advisory() {
  1179	  local mode="${CEO_OSV_GATE:-}"
  1180	  case "$mode" in
  1181	    advisory|block) ;;
  1182	    *) return 0 ;;  # default-OFF: opted out, no-op
  1183	  esac
  1184	
  1185	  local checker="$SOURCE_DIR/.claude/scripts/osv_check.py"
  1186	  if [[ ! -f "$checker" ]]; then
  1187	    echo "    SKIP: osv_check.py absent — supply-chain advisory not run" >&2
  1188	    return 0
  1189	  fi
  1190	  if ! command -v python3 >/dev/null 2>&1; then
  1191	    echo "    SKIP: python3 absent — supply-chain advisory not run" >&2
  1192	    return 0
  1193	  fi
  1194	
  1195	  # Hard-timeout wrapper. Prefer GNU `timeout`, fall back to macOS `gtimeout`,
  1196	  # else run bare (osv_check.py has its own per-request hard ceiling, so even
  1197	  # without an outer `timeout` the call is bounded).
  1198	  local timeout_s="${CEO_OSV_TIMEOUT_S:-4}"
  1199	  local outer_budget=$(( ${timeout_s%.*} + 6 ))   # request budget + slack
  1200	  local TO=()
  1201	  if command -v timeout >/dev/null 2>&1; then
  1202	    TO=(timeout -k 2 "${outer_budget}s")
  1203	  elif command -v gtimeout >/dev/null 2>&1; then
  1204	    TO=(gtimeout -k 2 "${outer_budget}s")
  1205	  fi
  1206	
  1207	  echo ""
  1208	  echo "==> Supply-chain advisory (OSV.dev / OSSF malicious-packages) — mode=$mode"
  1209	  _state_record_op "supply_chain_advisory" "mode=$mode"
  1210	
  1211	  # The framework ships no third-party runtime installs of its own (stdlib
  1212	  # only). The surface this gate guards is the set of install commands an
  1213	  # adopter/squad may run; we feed those that are statically known. For the
  1214	  # framework install itself there is nothing to query, so this is a wired,
  1215	  # exercised, never-hang code path with an empty default target list.
  1216	  local cmd rc
  1217	  local -a OSV_TARGET_COMMANDS=()
  1218	  # Adopters / squad-install pass commands via CEO_OSV_COMMANDS (newline-sep).
  1219	  if [[ -n "${CEO_OSV_COMMANDS:-}" ]]; then
  1220	    while IFS= read -r cmd; do
  1221	      [[ -n "$cmd" ]] && OSV_TARGET_COMMANDS+=("$cmd")
  1222	    done <<< "${CEO_OSV_COMMANDS}"
  1223	  fi
  1224	
  1225	  if [[ ${#OSV_TARGET_COMMANDS[@]} -eq 0 ]]; then
  1226	    echo "    (no install commands to scan — framework runtime is stdlib-only)"
  1227	    return 0
  1228	  fi
  1229	
  1230	  local blocked=0
  1231	  for cmd in "${OSV_TARGET_COMMANDS[@]}"; do
  1232	    rc=0
  1233	    if [[ ${#TO[@]} -gt 0 ]]; then
  1234	      CEO_OSV_GATE="$mode" "${TO[@]}" python3 "$checker" --command "$cmd" || rc=$?
  1235	    else
  1236	      CEO_OSV_GATE="$mode" python3 "$checker" --command "$cmd" || rc=$?
  1237	    fi
  1238	    # rc=124 → outer `timeout` fired (hung request) → fail-OPEN (advisory-skip).
  1239	    if [[ "$rc" -eq 124 ]]; then
  1240	      echo "    TIMEOUT: OSV query exceeded ${outer_budget}s — fail-open (advisory-skip)" >&2
  1241	    elif [[ "$rc" -eq 3 ]]; then
  1242	      # block-mode MAL hit (osv_check returns 3).
  1243	      echo "    BLOCKED: malicious-package advisory for an install target" >&2
  1244	      blocked=1
  1245	    fi
  1246	  done
  1247	
  1248	  if [[ "$mode" == "block" && "$blocked" -eq 1 ]]; then
  1249	    return 4
  1250	  fi
  1251	  return 0
  1252	}
