     2	# uninstall.sh — manifest-honoring uninstaller for ceo-orchestration
     3	# (PLAN-083 sub-1.9)
     4	#
     5	# Safety property: ONLY removes files whose current sha256 matches the
     6	# recorded manifest entry. Files modified by the user post-install have
     7	# divergent SHAs and are PRESERVED. Files NOT listed in the manifest
     8	# (Owner-authored, never installed by us) are also PRESERVED.
     9	#
    10	# Usage:
    11	#   ./uninstall.sh <target-repo-path> [options]
    12	#
    13	# Options:
    14	#   --dry-run                  Preview what WOULD be removed; touch nothing
    15	#   --restore <backup-path>    Inverse mode: restore .claude/ from a backup .tar.gz
    16	#   --force                    Remove files even if SHA mismatches (DESTRUCTIVE)
    17	#   --no-backup                Skip the pre-uninstall backup tarball
    18	#   --no-hmac-verify           Skip HMAC verification of the manifest sidecar
    19	#   -h, --help                 Show this help
    20	#
    21	# Exit codes:
    22	#   0  success (or dry-run preview)
    23	#   1  generic failure / invalid args
    24	#   2  target path invalid OR no manifest found
    25	#   3  HMAC verification failed (manifest tampered)
    26	#   4  --restore: backup tar.gz invalid or HMAC mismatch
    27	#   5  --force not provided when SHA mismatches encountered
    28	#
    29	# Bash 3.2 portability guard
    30	if [ -z "${BASH_VERSINFO:-}" ]; then
    31	  echo "ERROR: uninstall.sh requires bash" >&2
    32	  exit 1
    33	fi
    34	if [ "${BASH_VERSINFO[0]}" -lt 3 ] || \
    35	   { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
    36	  echo "ERROR: uninstall.sh requires bash >= 3.2 (detected ${BASH_VERSION})" >&2
    37	  exit 1
    38	fi
    39	
    40	set -euo pipefail
    41	
    42	TARGET=""
    43	DRY_RUN=0
    44	RESTORE_PATH=""
    45	FORCE=0
    46	NO_BACKUP=0
    47	NO_HMAC_VERIFY=0
