   570	  fi
   571	
   572	  # --- source selection (BEFORE the fixture — `pristine` syncs from it) ----
   573	  local src
   574	  if [[ "$source_has" == "no" ]]; then
   575	    src="$( _alt_source "$surface" )" || { ERR=$((ERR+1)); return; }
