  1701	# ===========================================================================
  1702	# PLAN-166 F3 (ADR-155-AMEND-1) — delivery-record lookups + SPEC/v1 FORCED
  1703	# refresh + framework version marker refresh.
  1704	# ---------------------------------------------------------------------------
  1705	# Ownership of the three conditional surfaces (PROTOCOL.md, SPEC/v1,
  1706	# .claude/.framework-version) derives from the REGISTERED DELIVERY — here,
  1707	# the PRE-upgrade baseline manifest records (the same record install.sh
  1708	# writes and doctor.sh reads) — never from the ceremony alone and never from
  1709	# file presence (r7/r13/r17/r19/r20).
  1710	# ===========================================================================
  1711	_baseline_has_spec_record() {
  1712	  [[ -n "$_BASELINE_MANIFEST_FILE" && -f "$_BASELINE_MANIFEST_FILE" ]] || return 1
  1713	  # `(/|  |$)` and not a bare trailing slash: a --mode link install records
  1714	  # the WHOLE tree as one directory symlink — `LINK  SPEC/v1  <target>`, no
  1715	  # trailing slash — which a `SPEC/v1/` fragment can never match (the same
  2240	# PLAN-138 Wave C (ADR-155) — write the baseline SHA-256 manifest.
  2241	#
  2242	# Records, per framework-owned file, a baseline digest so a later upgrade can
  2243	# tell "the framework changed this" apart from "the adopter changed this" and
  2244	# PRESERVE/REFUSE customizations instead of clobbering them (incl. the root
  2245	# PROTOCOL.md — the verified S238 driver). The enumeration is the SINGLE shared
  2246	# set from _framework_manifest_set.sh, so the manifest writer (here) and the
  2247	# upgrade classifier walk an identical list.
  2248	#
  2249	# Manifest grammar (two record kinds):
  2250	#   <64hex>  <relpath>            — content hash of a copied file
  2251	#   LINK  <relpath>  <target>     — a --mode link symlink (content == source,
  2252	#                                   so a content hash is meaningless; the
  2253	#                                   upgrade classifier short-circuits LINK)
  2254	#
  2255	# Written to $TARGET/.claude/.install-manifest.sha256 (distinct from the
  2256	# release skill-manifest.sha256). EXCLUDES the manifest itself + .claude.bak/.
  2257	# Fail-open: any missing helper / unreadable file is skipped with a NOTE; the
  2258	# install never fails because the manifest could not be fully written.
  2259	# ----------------------------------------------------------------------
  2260	write_install_manifest() {
  2261	  # Guarded by the caller for DRY_RUN; defensive re-check here.
  2262	  [[ "${DRY_RUN:-0}" -eq 0 ]] || return 0
  2263	
  2264	  if ! command -v _write_baseline_manifest >/dev/null 2>&1; then
  2265	    echo "    NOTE: baseline manifest skipped — generator helper not sourced" >&2
  2266	    return 0
  2267	  fi
  2268	
  2269	  local manifest="$TARGET/.claude/.install-manifest.sha256"
  2270	  echo ""
  2271	  echo "==> Writing install baseline manifest (.claude/.install-manifest.sha256)"
  2272	  _state_record_op "write_install_manifest" ".claude/.install-manifest.sha256"
  2273	
  2274	  # Profile-aware enumeration rooted at the installed target; the SINGLE shared
  2275	  # generator in _framework_manifest_set.sh does the walk + hashing + LINK
  2276	  # records (the SAME generator upgrade.sh calls after a successful upgrade).
  2277	  export FMS_ROOT="$TARGET"
  2278	  export FMS_PROFILE_PARTS="${PROFILE_PARTS[*]}"
  2279	  export FMS_MODE="$MODE"
  2280	  # PLAN-166 F3 (ADR-155-AMEND-1): conditional ownership from the DELIVERY
  2281	  # RECORD — never the ceremony alone, never file presence. A path
  2282	  # install_one EXISTS-skipped stays out of the baseline, so doctor, the
  2283	  # update-checker and uninstall never treat an adopter file as
  2284	  # framework-owned (r7/r13/r17).
  2285	  #
  2286	  # Ownership CONTINUITY on reruns (codex W1-ceremony round, P1): a rerun
  2287	  # over an already-installed target EXISTS-skips all three paths, so the
  2288	  # THIS-RUN flags are 0 — but the manifest rewrite below REPLACES the old
  2289	  # manifest. Without consulting the PRIOR manifest's records, a rerun
  2290	  # would silently drop framework ownership of SPEC/PROTOCOL/marker (and a
  2291	  # v1.3 SPEC would later misclassify as ADOPTER-FORK — it is absent from
  2292	  # the legacy pristine fingerprints). Preserve a valid prior record: the
  2293	  # regexes mirror upgrade.sh _baseline_has_*_record byte-for-byte
  2294	  # (family-swept; `(/|  |$)` covers the --mode link single-LINK-line form).
  2295	  # A prior LINK record carries ownership forward only while the live symlink
  2296	  # still points where it was RECORDED (codex W1 round 10, P2). On a --link
  2297	  # reinstall over a RETARGETED managed symlink, install_one EXISTS-skips the
  2298	  # path and the continuity check used to accept the record blindly; the
  2299	  # rewrite then serialized the redirected target as the new delivery record
  2300	  # and every later upgrade accepted the foreign tree as healthy. Mirrors the
  2301	  # readlink-vs-record checks upgrade.sh already applies on its refresh
  2302	  # routes. Returns 0 (carry on) when there is no LINK record to compare.
  2303	  _prior_link_target_matches() {   # $1 = manifest, $2 = relpath
  2304	    local _plt_line _plt_rec="" _plt_live
  2305	    while IFS= read -r _plt_line || [[ -n "$_plt_line" ]]; do
  2306	      case "$_plt_line" in
  2307	        "LINK  $2  "*) _plt_rec="${_plt_line#LINK  $2  }"; break ;;
  2308	      esac
  2309	    done < "$1"
  2310	    _plt_live="$( readlink "$TARGET/$2" 2>/dev/null || true )"
  2311	    # A live SYMLINK with no prior LINK record is NOT a match — it is the
  2312	    # ABSENCE of evidence. Returning success there let a --link rerun over a
  2313	    # copy-installed path serialize an arbitrary symlink as a trusted delivery,
  2314	    # converting adopter-owned content into framework-owned (r11-F1, open since
  2315	    # S296; codex W3 r2 P1).
  2316	    if [[ -z "$_plt_rec" ]]; then
  2317	      # No prior LINK record. Ownership carries forward ONLY while the live
  2318	      # path still has the shape the record described. A symlink contradicts a
  2319	      # HASH record (r11-F1); so does a DIRECTORY, and that one is worse — the
  2320	      # continuity branch would enumerate the adopter's own children under it
  2321	      # and record their live hashes, so a later uninstall could delete files
  2322	      # the framework never wrote (codex W3 r3 P1).
  2323	      [[ -z "$_plt_live" ]] || return 1
  2324	      # SPEC/v1 IS a directory by design; only the two SINGLE-FILE surfaces are
  2325	      # contradicted by one. Rejecting every directory broke SPEC continuity.
  2326	      case "$2" in
  2327	        SPEC/v1) : ;;
  2328	        *) [[ ! -d "$TARGET/$2" ]] || return 1 ;;
  2329	      esac
  2330	      return 0
  2331	    fi
  2332	    [[ "$_plt_rec" == "$_plt_live" ]]
  2333	  }
  2334	  if [[ "${_DELIVERED_SPEC:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  2335	     && grep -Eq '^([0-9a-f]{64}|LINK)  SPEC/v1(/|  |$)' "$manifest" 2>/dev/null \
  2336	     && _prior_link_target_matches "$manifest" "SPEC/v1"; then
  2337	    _DELIVERED_SPEC=1
  2338	    _CONTINUITY_FIRED=1
  2339	    _CONTINUITY_PATHS="${_CONTINUITY_PATHS:-}
  2340	SPEC/v1"
  2341	    echo "    ownership continuity: SPEC/v1 delivery record preserved from prior manifest"
  2342	  fi
  2343	  if [[ "${_DELIVERED_PROTOCOL:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  2344	     && grep -Eq '^([0-9a-f]{64}|LINK)  PROTOCOL\.md(  |$)' "$manifest" 2>/dev/null \
  2345	     && _prior_link_target_matches "$manifest" "PROTOCOL.md"; then
  2346	    # FMS_HASH_ROOT does NOT reach PROTOCOL.md: _write_baseline_manifest
  2347	    # special-cases the generated pointer and hashes the TARGET unless
  2348	    # FMS_PROTOCOL_HASH is supplied — which install never set. So a rerun over
  2349	    # a CUSTOMIZED delivered pointer re-baselined the adopter's own bytes as
  2350	    # framework-owned; the next upgrade would then overwrite them and
  2351	    # uninstall could DELETE them (codex W1 round 9, P1). Carry the PRIOR
  2352	    # recorded digest. A LINK record needs none (the rewrite's link branch
  2353	    # fires before the PROTOCOL special case); with neither, DROP the
  2354	    # ownership claim rather than record a knowingly wrong baseline.
  2355	    _PRIOR_PROTOCOL_HASH="$( grep -E '^[0-9a-f]{64}  PROTOCOL\.md$' "$manifest" 2>/dev/null | head -1 | cut -d' ' -f1 || true )"
  2356	    if [[ -n "$_PRIOR_PROTOCOL_HASH" ]] \
  2357	       || grep -Eq '^LINK  PROTOCOL\.md(  |$)' "$manifest" 2>/dev/null; then
  2358	      _DELIVERED_PROTOCOL=1
  2359	      _CONTINUITY_FIRED=1
  2360	      _CONTINUITY_PATHS="${_CONTINUITY_PATHS:-}
  2361	PROTOCOL.md"
  2362	      echo "    ownership continuity: PROTOCOL.md delivery record preserved from prior manifest"
  2363	    else
  2364	      echo "    NOTE: PROTOCOL.md record present but its digest is unrecoverable —" >&2
  2365	      echo "          ownership NOT claimed (the pointer stays adopter-owned)" >&2
  2366	    fi
  2367	  fi
  2368	  if [[ "${_DELIVERED_MARKER:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  2369	     && grep -Eq '^([0-9a-f]{64}|LINK)  \.claude/\.framework-version(  |$)' "$manifest" 2>/dev/null \
  2370	     && _prior_link_target_matches "$manifest" ".claude/.framework-version"; then
  2371	    _DELIVERED_MARKER=1
  2372	    _CONTINUITY_FIRED=1
  2373	    _CONTINUITY_PATHS="${_CONTINUITY_PATHS:-}
  2374	.claude/.framework-version"
  2375	    echo "    ownership continuity: .framework-version delivery record preserved from prior manifest"
  2376	  fi
  2377	  # For the continuity-preserved paths ONLY, hash the FRAMEWORK's pristine
  2378	  # copies instead of the (possibly edited) target's (codex W1 round 5, P1):
  2379	  # install normally hashes FMS_ROOT=$TARGET — on a rerun over an EDITED
  2380	  # delivered SPEC that would re-baseline the fork's bytes as framework-owned,
  2381	  # and a later uninstall would happily DELETE the user's modified tree (its
  2382	  # hash matches the manifest). Same C.5 idempotency posture upgrade.sh uses.
  2383	  #
  2384	  # SCOPED, not global (codex W1 round 8, P1): install RENDERS templates
  2385	  # (`.claude/team.md`, skills, `{{X}}` placeholders under --project et al),
  2386	  # so a global FMS_HASH_ROOT rewrote every rendered file's baseline to the
  2387	  # UNRENDERED source — doctor.sh then reports repo-wide adopter drift and
  2388	  # later upgrades classify those files as customized and stop refreshing
  2389	  # them. PLAN-167 W2.3 replaced that confinement with an EXPLICIT per-surface
  2390	  # hash_source: the decision says which paths take the framework's bytes,
  2391	  # so no global override is set here at all.
  2392	  if [[ "${_CONTINUITY_FIRED:-0}" = "1" ]]; then
  2393	    : # per-surface hash_source below replaces the global override
  2394	    case "$_CONTINUITY_PATHS" in
  2395	      *".claude/.framework-version"*) export FMS_HASH_SOURCE_MARKER="HASH_SOURCE" ;;
  2396	    esac
  2397	    case "$_CONTINUITY_PATHS" in
  2398	      # The generated pointer has no source bytes; carry what was recorded.
  2399	      *"PROTOCOL.md"*)               export FMS_HASH_SOURCE_PROTOCOL="HASH_PRIOR_RECORD" ;;
  2400	    esac
  2401	    echo "    ownership continuity: manifest hashes the preserved paths from the framework source (edited target content stays adopter-owned; rendered files keep their target hash)"
  2402	  fi
  2403	  # Declare on EVERY delivery path, not only continuity. A fresh install
  2404	  # genuinely delivers these surfaces, and the previous attempt at this wave
  2405	  # regressed 24 cells precisely because it left fresh installs undeclared.
  2406	  #
  2407	  # Fresh delivery: the target IS the bytes just written, so HASH_TARGET is
  2408	  # both correct and observationally identical to HASH_SOURCE.
  2409	  # Continuity: the target may be an EDITED fork, so the record must come from
  2410	  # the framework's copy (spec/marker) or the prior record (the generated
  2411	  # pointer, which has no source file).
  2412	  export FMS_SOURCE_ROOT="$SOURCE_DIR"
  2413	  export FMS_PRIOR_MANIFEST="$manifest"
  2414	  if [[ "${_DELIVERED_SPEC:-0}" = "1" ]]; then
  2415	    case "${_CONTINUITY_PATHS:-}" in
  2416	      *"SPEC/v1"*) export FMS_HASH_SOURCE_SPEC="HASH_SOURCE" ;;
  2417	      *)           export FMS_HASH_SOURCE_SPEC="HASH_TARGET" ;;
  2418	    esac
  2419	  fi
  2420	  if [[ "${_DELIVERED_MARKER:-0}" = "1" ]]; then
  2421	    case "${_CONTINUITY_PATHS:-}" in
  2422	      *".claude/.framework-version"*) export FMS_HASH_SOURCE_MARKER="HASH_SOURCE" ;;
  2423	      *)                              export FMS_HASH_SOURCE_MARKER="HASH_TARGET" ;;
  2424	    esac
  2425	  fi
  2426	  if [[ "${_DELIVERED_PROTOCOL:-0}" = "1" ]]; then
  2427	    case "${_CONTINUITY_PATHS:-}" in
  2428	      *"PROTOCOL.md"*) export FMS_HASH_SOURCE_PROTOCOL="HASH_PRIOR_RECORD" ;;
  2429	      *)               export FMS_HASH_SOURCE_PROTOCOL="HASH_TARGET" ;;
  2430	    esac
  2431	  fi
  2432	  export FMS_DELIVERED_SPEC="${_DELIVERED_SPEC:-0}"
  2433	  export FMS_DELIVERED_PROTOCOL="${_DELIVERED_PROTOCOL:-0}"
  2434	  export FMS_DELIVERED_MARKER="${_DELIVERED_MARKER:-0}"
  2435	  # Empty on a fresh install (target IS the freshly written pointer, hashing it
  2436	  # is correct); set only by the continuity path above.
  2437	  export FMS_PROTOCOL_HASH="${_PRIOR_PROTOCOL_HASH:-}"
  2438	  _write_baseline_manifest "$manifest"
  2439	  unset FMS_ROOT FMS_PROFILE_PARTS FMS_MODE FMS_HASH_ROOT FMS_PROTOCOL_HASH \
  2440	        FMS_PRIOR_MANIFEST FMS_HASH_SOURCE_SPEC FMS_HASH_SOURCE_PROTOCOL \
  2441	        FMS_HASH_SOURCE_MARKER
  2442	  unset FMS_DELIVERED_SPEC FMS_DELIVERED_PROTOCOL FMS_DELIVERED_MARKER
