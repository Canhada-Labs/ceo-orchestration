  1793	
  1794	# =============================================================================
  1795	# PLAN-167 W2.2 — OBSERVERS.
  1796	#
  1797	# The callers no longer decide. They observe the nine dimensions, hand them to
  1798	# _ownership_verdict, and execute what comes back. Everything below answers a
  1799	# question about the world; nothing below chooses an outcome.
  1800	#
  1801	# That separation is the entire point. In S296 the answer to "is this owned?"
  1802	# was recomputed inline at every branch, so two branches could answer the same
  1803	# question differently and nothing detected the contradiction.
  1804	# =============================================================================
  1805	
  1806	# _ov_obs_live_type <abs path> — lstat vocabulary, never following.
  1807	_ov_obs_live_type() {
  1808	  _olt_p="$1"
  1809	  # Classify NON-REGULAR entries before anything opens the path. `ls -A` on a
  1810	  # FIFO blocks forever waiting for a writer, so testing -d before -p turned
  1811	  # the observer itself into the hang it was written to detect.
  1812	  if   [ -L "$_olt_p" ]; then printf 'symlink'
  1813	  elif [ ! -e "$_olt_p" ]; then printf 'absent'
  1814	  elif [ -p "$_olt_p" ] || [ -S "$_olt_p" ]; then printf 'special'
  1815	  elif [ -d "$_olt_p" ]; then
  1816	    if [ -z "$( ls -A "$_olt_p" 2>/dev/null )" ]; then printf 'dir_empty'; else printf 'dir'; fi
  1817	  elif [ -f "$_olt_p" ]; then printf 'regular'
  1818	  else printf 'special'; fi
  1819	}
  1820	
  1821	# _ov_obs_prior_record <relpath> — what the PRE-run sanitized baseline says.
  1822	# link_match only when the recorded target still equals the live readlink; a
  1823	# LINK row whose target moved is link_retargeted, and so is a LINK row whose
  1824	# live path is no longer a symlink at all (readlink yields empty, which never
  1825	# equals a recorded non-empty target).
  1826	_ov_obs_prior_record() {
  1827	  _opr_rel="$1"
  1828	  [ -n "${_BASELINE_MANIFEST_FILE:-}" ] && [ -f "$_BASELINE_MANIFEST_FILE" ] || { printf 'none'; return 0; }
  1829	  _opr_link="$( grep -E "^LINK  ${_opr_rel}  " "$_BASELINE_MANIFEST_FILE" 2>/dev/null | head -1 || true )"
  1830	  if [ -n "$_opr_link" ]; then
  1831	    # Fixed double-space delimiter, never whitespace field-splitting: a
  1832	    # checkout path containing a space made awk '{print $3}' read an unchanged
  1833	    # delivery as redirected.
  1834	    _opr_rec="${_opr_link#LINK  ${_opr_rel}  }"
  1835	    _opr_live="$( readlink "$TARGET/$_opr_rel" 2>/dev/null || true )"
  1836	    if [ -n "$_opr_rec" ] && [ "$_opr_rec" = "$_opr_live" ]; then printf 'link_match'
  1837	    else printf 'link_retargeted'; fi
  1838	    return 0
  1839	  fi
  1840	  if grep -Eq "^[0-9a-f]{64}  ${_opr_rel}(/|$)" "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
  1841	    printf 'hash'; return 0
  1842	  fi
  1843	  printf 'none'
  1844	}
  1845	
  1846	# _ov_obs_spec_content — pristine | legacy_pristine | legacy_pristine_partial
  1847	#                        | edited | -
  1848	# A tree the fingerprint cannot fully inventory is NOT "pristine with a note":
  1849	# it is its own observable, because a partial inventory must never certify a
  1850	# wholesale replace (ADR-155-AMEND-1 §4).
  1851	_ov_obs_spec_content() {
  1852	  [ -e "$TARGET/SPEC/v1" ] || { printf '-'; return 0; }
  1853	  _osc_fp="$( _spec_tree_fingerprint "$TARGET" 2>/dev/null || true )"
  1854	  if [ -z "$_osc_fp" ]; then
  1855	    # No fingerprint. Distinguish "cannot inventory" (a non-regular entry is
  1856	    # present) from "not comparable at all".
  1857	    _osc_odd="$( ( cd "$TARGET" && find SPEC/v1 -mindepth 1 ! -type f ! -type d -print 2>/dev/null ) )"
  1858	    if [ -n "$_osc_odd" ]; then printf 'legacy_pristine_partial'; else printf 'edited'; fi
  1859	    return 0
  1860	  fi
  1861	  _osc_src="$( _spec_tree_fingerprint "$SOURCE_DIR" 2>/dev/null || true )"
  1862	  if [ -n "$_osc_src" ] && [ "$_osc_fp" = "$_osc_src" ]; then printf 'pristine'; return 0; fi
  1863	  for _osc_pf in $_SPEC_PRISTINE_FINGERPRINTS; do
  1864	    if [ "$_osc_fp" = "$_osc_pf" ]; then printf 'legacy_pristine'; return 0; fi
  1865	  done
  1866	  printf 'edited'
  1867	}
  1868	
  1869	# _ov_obs_skip <relpath> — none | self | descendant.
  1870	# The descendant scan walks the UNION of source and target and includes every
  1871	# removable entry, not just regular files: the forced route find-deletes them
  1872	# all, so a target-only symlink must be visible to skip detection too.
  1873	_ov_obs_skip() {
  1874	  _osk_rel="$1"
  1875	  if _path_is_skipped "$_osk_rel"; then printf 'self'; return 0; fi
  1876	  if [ "$_osk_rel" = "SPEC/v1" ]; then
  1877	    _osk_hit=""
  1878	    while IFS= read -r _osk_f; do
  1879	      [ -n "$_osk_f" ] || continue
  1880	      if _path_is_skipped "$_osk_f"; then _osk_hit=1; break; fi
  1881	    done <<EOF
  1882	$( { ( cd "$SOURCE_DIR" && find SPEC/v1 ! -type d -print 2>/dev/null );
  1883	     [ -d "$TARGET/SPEC/v1" ] && ( cd "$TARGET" && find SPEC/v1 ! -type d -print 2>/dev/null ); } | LC_ALL=C sort -u )
  1884	EOF
  1885	    [ -n "$_osk_hit" ] && { printf 'descendant'; return 0; }
  1886	  fi
  1887	  printf 'none'
  1888	}
  1889	
  1890	# _ov_obs_mode — the delivery mode this run carries. Evidence order: a prior
  1891	# LINK record (authoritative), else a symlink probe on the owned roots.
  1892	_ov_obs_mode() {
  1893	  if [ -n "${_BASELINE_MANIFEST_FILE:-}" ] && [ -f "$_BASELINE_MANIFEST_FILE" ] \
  1894	     && grep -Eq '^LINK  ' "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
  1895	    printf 'link'; return 0
  1896	  fi
  1897	  if [ -L "$TARGET/SPEC/v1" ] || [ -L "$TARGET/.claude/.framework-version" ]; then
  1898	    printf 'link'; return 0
  1899	  fi
  1900	  printf 'copy'
  1901	}
  1902	
  1903	# _refresh_spec_contract — SPEC/v1 takes a FORCED route, NOT the generic
  1904	# backup_and_replace: for a directory target with a baseline, the classified
  1905	# walk PRESERVES adopter edits — so from the 2nd upgrade on, an edited SPEC
  1906	# would classify ADOPTER-CUSTOMIZED and the stale-contract class would
  1907	# return (r6). SPEC/v1 is the published compliance CONTRACT: an adopter edit
  1908	# is a FORK of the contract, not a customization (OQ-3) => backup to
  1909	# $BAK_DIR/SPEC/v1 + replace.
  1910	#   * ceremony: a recorded `--ceremony user` install NEVER receives SPEC/v1
  1911	#     (mirrors install.sh WS4-guard-spec), independent of --no-replay (r9).
  1912	#   * ownership: baseline SPEC records => framework-owned (forced refresh);
  1913	#     no target SPEC => new delivery; target SPEC with NO record => LEGACY
  1914	#     MIGRATION by pristine content (r20): match => framework-owned refresh,
  1915	#     no match => ADOPTER-FORK: preserve + snapshot + named WARNING.
  1916	#   * root VERSION: this function (and the whole upgrade) NEVER touches it —
  1917	#     install_one is skip-if-exists, so on an adopter with its own VERSION
  1918	#     the framework never wrote there; backup_and_replace would TAKE the
  1919	#     file (the S238/ADR-155 "verified worst case", trap C.5). See
  1920	#     ADR-155-AMEND-1 for why the asymmetry is deliberate.
  1921	_SPEC_DELIVERED=0
  1922	_refresh_spec_contract() {
  1923	  local sdir="$SOURCE_DIR/SPEC/v1"
  1924	  local ddir="$TARGET/SPEC/v1"
  1925	  local bdir="$BAK_DIR/SPEC/v1"
  1926	
  1927	  # ---- OBSERVE -------------------------------------------------------------
  1928	  # Nothing here chooses an outcome. Each line answers one question about the
  1929	  # world, and the answers go to _ownership_verdict as the nine dimensions.
  1930	  local _lt _pr _lc _sh _md _sk
  1931	  if _lg_ancestor_is_symlink "$TARGET" "SPEC/v1"; then
  1932	    _lt="ancestor_symlink"           # reachable only by writing THROUGH a symlink
  1933	  else
  1934	    _lt="$( _ov_obs_live_type "$ddir" )"
  1935	  fi
  1936	  _pr="$( _ov_obs_prior_record "SPEC/v1" )"
  1937	  _lc="$( _ov_obs_spec_content )"
  1938	  _sh=no; [ -d "$sdir" ] && _sh=yes
  1939	  _md="$( _ov_obs_mode )"
  1940	  _sk="$( _ov_obs_skip "SPEC/v1" )"
  1941	
  1942	  # ---- DECIDE --------------------------------------------------------------
  1943	  local _pair _verdict _hash
  1944	  if ! _pair="$( _ownership_verdict spec "$_pr" "$_lt" "$_lc" "$_sh" "$_md" \
  1945	                   "$CEREMONY_EFFECTIVE" upgrade "$_sk" )"; then
  1946	    # The decision function refuses combinations its legality rules forbid.
  1947	    # Fail toward preserve — under-claiming is recoverable, over-claiming is
  1948	    # the delete-the-adopter's-file class (ADR-155-AMEND-1 §3).
  1949	    echo "    WARNING: SPEC/v1 dimensions are not a legal cell" >&2
  1950	    echo "             ($_pr/$_lt/$_lc/$_sh/$_md/$CEREMONY_EFFECTIVE/$_sk) —" >&2
  1951	    echo "             PRESERVED without ownership. Please report this combination." >&2
  1952	    return 0
  1953	  fi
  1954	  _verdict="${_pair%% *}"; _hash="${_pair##* }"
  1955	  _SPEC_HASH_SOURCE="$_hash"   # consumed by the baseline rewrite
  1956	
  1957	  # ---- EXECUTE -------------------------------------------------------------
  1958	  case "$_verdict" in
  1959	    PRESERVE_OWNED)
  1960	      _SPEC_DELIVERED=1
  1961	      case "$_lt/$_sk/$_sh" in
  1962	        ancestor_symlink/*/*) echo "    SKIP: SPEC/v1 has a symlinked ancestor (refusing to write through it — F11a)" ;;
  1963	        symlink/*/*)          echo "    SKIP: SPEC/v1 is the recorded --mode link delivery (target unchanged)" ;;
  1964	        */self/*)             echo "    SKIPPED (--skip): SPEC/v1" ;;
  1965	        */descendant/*)       echo "    SKIPPED (--skip matches a descendant): SPEC/v1 refreshes as ONE contract unit — preserving the whole tree" ;;
  1966	        */*/no)               echo "    SKIP: SPEC/v1 absent in source (ownership carried forward)" ;;
  1967	        *)                    echo "    SKIP: SPEC/v1 (recorded --ceremony user install — root surfaces are out of scope, WS4)" ;;
  1968	      esac
  1969	      return 0
  1970	      ;;
  1971	
  1972	    PRESERVE_UNOWNED|OMIT_RECORD)
  1973	      # An adopter-owned surface. The ONLY case that earns a snapshot plus
  1974	      # recovery guidance is the true ADOPTER-FORK: content the framework
  1975	      # cannot claim, with no gate having refused first.
  1976	      if [ "$_lt" = "dir" ] || [ "$_lt" = "dir_empty" ]; then
  1977	        if [ "$DRY_RUN" -eq 1 ]; then
  1978	          echo "    (dry-run) would PRESERVE (SPEC/v1 ADOPTER-FORK): SPEC/v1"
  1979	          return 0
  1980	        fi
  1981	        local _snap_ok=0
  1982	        if mkdir -p "$( dirname "$bdir" )" 2>/dev/null && cp -R "$ddir" "$bdir" 2>/dev/null; then
  1983	          _snap_ok=1
  1984	        fi
  1985	        # The token "ADOPTER-FORK" is CONTRACT, not prose: the §1869 route
  1986	        # comment promises a NAMED warning, and the F3 e2e (S4) greps for it.
  1987	        # The PLAN-167 rewrite dropped it — caught by that e2e on the PLAN-166
  1988	        # land (44/45) and restored here (PLAN-168).
  1989	        echo "    WARNING: SPEC/v1 ADOPTER-FORK — not framework-owned (no delivery" >&2
  1990	        echo "             record; matches neither this checkout nor any pristine shipped SPEC)" >&2
  1991	        if [ "$_snap_ok" -eq 1 ]; then
  1992	          echo "             — PRESERVED in place (snapshot in $BAK_DIR/SPEC/v1)." >&2
  1993	          echo "             To hand it back to the framework: remove the target SPEC/v1," >&2
  1994	          echo "             copy this checkout's tree in, and re-run — a byte-identical" >&2
  1995	          echo "             tree is taken over and recorded." >&2
  1996	        else
  1997	          # Recovery guidance is WITHHELD without a snapshot: following it
  1998	          # would destroy the only copy of the fork.
  1999	          echo "             — PRESERVED in place, but the forensic snapshot COULD NOT be" >&2
  2000	          echo "             created. Back SPEC/v1 up yourself before any manual takeover." >&2
  2001	        fi
  2002	        _up_record_op "preserve_spec_v1_adopter_fork" "SPEC/v1"
  2003	      else
  2004	        echo "    SKIP: SPEC/v1 is $_lt — adopter-owned, preserved without ownership" >&2
  2005	      fi
  2006	      return 0
  2007	      ;;
  2008	
  2009	    DELIVER|REFRESH)
  2010	      if [ "$DRY_RUN" -eq 1 ]; then
  2011	        if [ "$_verdict" = "REFRESH" ]; then
  2012	          echo "    (dry-run) would FORCE-REFRESH (backup to $BAK_DIR/SPEC/v1): SPEC/v1"
  2013	        else
  2014	          echo "    (dry-run) would ADD: SPEC/v1"
  2015	        fi
  2016	        return 0
  2017	      fi
  2018	      _up_record_op "refresh_spec_v1" "$_pr/$_lc"
  2019	
  2020	      if [ "$_lt" = "dir" ] || [ "$_lt" = "dir_empty" ]; then
  2021	        mkdir -p "$( dirname "$bdir" )" 2>/dev/null || true
  2022	        # `|| true` is load-bearing: under `set -euo pipefail` a failing cp
  2023	        # KILLS the run before the guard below can refuse the surface, so the
  2024	        # upgrade dies mid-way instead of leaving this surface untouched.
  2025	        if ! { cp -R "$ddir" "$bdir" 2>/dev/null || false; }; then
  2026	          # INV-3: an execution failure NEVER advances the record. The surface
  2027	          # is left exactly as it was, and so is its prior ownership record.
  2028	          echo "    WARNING: could not back up SPEC/v1 — REFUSING to replace it" >&2
  2029	          echo "             (backup-before-replace is the contract; surface untouched)" >&2
  2030	          # INV-3: the REFRESH did not happen, so the record must not advance
  2031	          # to source hashes. Retain the prior digest with the ownership.
  2032	          _up_record_op "preserve_spec_v1_backup_failed" "SPEC/v1"
  2033	          if [ "$_pr" = "hash" ]; then
  2034	            _SPEC_DELIVERED=1
  2035	            _SPEC_HASH_SOURCE="HASH_PRIOR_RECORD"
  2036	          fi
  2037	          return 0
  2038	        fi
  2039	        echo "    BACKED UP: SPEC/v1 -> $BAK_DIR/SPEC/v1"
  2040	        find "$ddir" -mindepth 1 -delete
  2041	        rmdir "$ddir" 2>/dev/null || true
  2042	      elif [ "$_lt" = "regular" ]; then
  2043	        mkdir -p "$( dirname "$bdir" )"
  2044	        if cp "$ddir" "$bdir" 2>/dev/null; then
  2045	          rm -f "$ddir"
  2046	          echo "    BACKED UP: SPEC/v1 (non-directory) -> $BAK_DIR/SPEC/v1"
  2047	        else
  2048	          echo "    WARNING: could not back up non-directory SPEC/v1 — REFUSING to remove it" >&2
  2049	          # INV-3: the REFRESH did not happen, so the record must not advance
  2050	          # to source hashes. Retain the prior digest with the ownership.
  2051	          _up_record_op "preserve_spec_v1_backup_failed" "SPEC/v1"
  2052	          if [ "$_pr" = "hash" ]; then
  2053	            _SPEC_DELIVERED=1
  2054	            _SPEC_HASH_SOURCE="HASH_PRIOR_RECORD"
  2055	          fi
  2056	          return 0
  2057	        fi
  2058	      fi
  2059	
  2060	      mkdir -p "$( dirname "$ddir" )"
  2061	      cp -R "$sdir" "$ddir"
  2062	      _SPEC_DELIVERED=1
  2063	      echo "    REFRESHED (forced — $_pr/$_lc): SPEC/v1"
  2064	      return 0
  2065	      ;;
  2066	  esac
  2067	}
  2068	
  2069	# _refresh_framework_marker — FORCED + VALIDATED write (r20 option (a)):
  2070	# the marker is generated-refresh content — the upgrade rewrites it to the
  2071	# source VERSION every run, backs up a differing pre-existing copy, and
  2072	# read-back-validates the write. A marker the upgrade could not validate is
  2073	# NOT recorded as delivered, so the FMS entry (and every marker-first
  2074	# reader keyed off the SAME record) falls back to VERSION instead of
  2075	# trusting a stale value. Delivered in BOTH ceremonies (inside .claude/).
  2076	_MARKER_DELIVERED=0
  2077	_refresh_framework_marker() {
  2078	  local src="$SOURCE_DIR/.claude/.framework-version"
  2079	  local dst="$TARGET/.claude/.framework-version"
  2080	  local bak="$BAK_DIR/.claude/.framework-version"
  2081	
  2082	  # ---- OBSERVE -------------------------------------------------------------
  2083	  local _lt _pr _lc _sh _md _sk
  2084	  if _lg_ancestor_is_symlink "$TARGET" ".claude/.framework-version"; then
  2085	    _lt="ancestor_symlink"
  2086	  else
  2087	    _lt="$( _ov_obs_live_type "$dst" )"
  2088	  fi
  2089	  _pr="$( _ov_obs_prior_record ".claude/.framework-version" )"
  2090	  _sh=no; [ -f "$src" ] && _sh=yes
  2091	  # Inspect CONTENT only for a regular file. `cmp` on a FIFO blocks waiting for
  2092	  # a writer, hanging the upgrade before the verdict can say PRESERVE_UNOWNED —
  2093	  # the third instance of "a reader opens what lstat already classified"
  2094	  # (codex W3 r4 P1; the OWN-0029 timeout).
  2095	  if [ "$_lt" != "regular" ]; then
  2096	    _lc="-"
  2097	  elif [ "$_sh" = yes ] && cmp -s "$src" "$dst" 2>/dev/null; then
  2098	    _lc="pristine"
  2099	  else
  2100	    _lc="edited"
  2101	  fi
  2102	  _md="$( _ov_obs_mode )"
  2103	  _sk="$( _ov_obs_skip ".claude/.framework-version" )"
  2104	
  2105	  # ---- DECIDE --------------------------------------------------------------
  2106	  local _pair _verdict
  2107	  if ! _pair="$( _ownership_verdict marker "$_pr" "$_lt" "$_lc" "$_sh" "$_md" \
  2108	                   "$CEREMONY_EFFECTIVE" upgrade "$_sk" )"; then
  2109	    echo "    WARNING: .claude/.framework-version dimensions are not a legal cell" >&2
  2110	    echo "             — PRESERVED without ownership. Please report this combination." >&2
  2111	    return 0
  2112	  fi
  2113	  _verdict="${_pair%% *}"
  2114	  _MARKER_HASH_SOURCE="${_pair##* }"
  2115	
  2116	  # ---- EXECUTE -------------------------------------------------------------
  2117	  case "$_verdict" in
  2118	    PRESERVE_OWNED)
  2119	      _MARKER_DELIVERED=1
  2120	      case "$_lt/$_sk" in
  2121	        ancestor_symlink/*) echo "    SKIP: .claude/.framework-version has a symlinked ancestor (refusing to write through it — F11a)" ;;
  2122	        symlink/*)          echo "    SKIP: .claude/.framework-version is the recorded --mode link delivery (target unchanged)" ;;
  2123	        */self)             echo "    SKIPPED (--skip): .claude/.framework-version" ;;
  2124	        *)                  echo "    SKIP: .claude/.framework-version (ownership carried forward)" ;;
  2125	      esac
  2126	      return 0
  2127	      ;;
  2128	
  2129	    OMIT_RECORD|PRESERVE_UNOWNED)
  2130	      if [ "$_sh" = no ]; then
  2131	        # The documented --pin downgrade: this source predates the marker, so a
  2132	        # retained record would keep advertising a newer version over older
  2133	        # content. Readers fall back to VERSION, which the pin DID update.
  2134	        echo "    SKIP: .claude/.framework-version absent in source (pre-v1.3.0 checkout)"
  2135	        if [ "$_pr" != "none" ]; then
  2136	          echo "    NOTE: the prior delivery record is NOT carried forward — version" >&2
  2137	          echo "          readers fall back to VERSION (which reflects the pinned source)" >&2
  2138	        fi
  2139	      elif [ "$_lt" = "symlink" ]; then
  2140	        echo "    WARNING: .claude/.framework-version is a symlink that does NOT match the" >&2
  2141	        echo "             recorded LINK delivery — preserved WITHOUT framework ownership" >&2
  2142	        echo "             (readers fall back to VERSION)" >&2
  2143	      else
  2144	        echo "    SKIP: .claude/.framework-version is $_lt — adopter-owned, refusing to write into/through it"
  2145	      fi
  2146	      return 0
  2147	      ;;
  2148	
  2149	    DELIVER|REFRESH)
  2150	      if [ "$DRY_RUN" -eq 1 ]; then
  2151	        echo "    (dry-run) would REFRESH: .claude/.framework-version ($(tr -d '[:space:]' < "$src" 2>/dev/null || true))"
  2152	        return 0
  2153	      fi
  2154	      if [ "$_verdict" = "REFRESH" ] && [ "$_lc" = "edited" ]; then
  2155	        mkdir -p "$( dirname "$bak" )" 2>/dev/null || true
  2156	        if { cp "$dst" "$bak" 2>/dev/null || false; }; then
  2157	          echo "    BACKED UP: .claude/.framework-version -> $bak"
  2158	        else
  2159	          # INV-3: an execution failure never advances the record.
  2160	          echo "    WARNING: could not back up differing .claude/.framework-version —" >&2
  2161	          echo "             REFUSING to overwrite it (backup-before-replace)" >&2
  2162	          # INV-3, same as the SPEC branch above.
  2163	          _up_record_op "preserve_marker_backup_failed" ".claude/.framework-version"
  2164	          if [ "$_pr" = "hash" ]; then
  2165	            _MARKER_DELIVERED=1
  2166	            _MARKER_HASH_SOURCE="HASH_PRIOR_RECORD"
  2167	          fi
  2168	          return 0
  2169	        fi
  2170	      fi
  2171	      mkdir -p "$( dirname "$dst" )"
  2172	      cp "$src" "$dst"
  2173	      # Read-back validation: a write that cannot be confirmed is NOT recorded
  2174	      # as delivered, so every marker-first reader falls back to VERSION rather
  2175	      # than trusting a value the upgrade could not verify.
  2176	      if cmp -s "$src" "$dst" 2>/dev/null; then
  2177	        _MARKER_DELIVERED=1
  2178	        _up_record_op "refresh_framework_marker" "$(tr -d '[:space:]' < "$src" 2>/dev/null || true)"
  2179	        echo "    REFRESHED: .claude/.framework-version ($(tr -d '[:space:]' < "$dst" 2>/dev/null || true))"
  2180	      else
  2181	        echo "    WARNING: .claude/.framework-version write did not validate — NOT recorded as" >&2
  2182	        echo "             delivered (marker-first readers fall back to VERSION; r20)" >&2
  2183	      fi
  2184	      return 0
  2185	      ;;
  2186	  esac
  2187	}
