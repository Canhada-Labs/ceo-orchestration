  1367	          *)
  1368	            echo "    REFUSED (CONFLICT, --on-conflict=refuse — not overwritten): $rel_path" >&2
  1369	            return ;;
  1370	        esac ;;
  1371	      FRAMEWORK-CHANGED)
  1372	        _apply_single_file "$rel_path"
  1373	        echo "    UPDATED (framework-changed): $rel_path"
  1374	        return ;;
  1375	      FALLBACK|*)
