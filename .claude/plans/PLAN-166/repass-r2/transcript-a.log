  1074	    # PLAN-161 U2 (codex r1 F7): only a directory we JUST copied is pruned —
  1075	    # a pre-existing (EXISTS-skipped) adopter dir is left untouched, link
  1076	    # mode installs a symlink (the prune helper refuses symlink roots), and
  1077	    # dry-run copies nothing.
  1078	    if [[ "$DRY_RUN" -eq 0 && "$MODE" != "link" && "$preexisting" -eq 0 && -d "$e" && ! -L "$e" ]]; then
