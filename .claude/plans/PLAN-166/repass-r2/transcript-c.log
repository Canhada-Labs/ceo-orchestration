    95	    echo "  CEO_PAIR_RAIL_DISABLE=1 is emergency-only, NOT an auth route."
    96	    exit 1
    97	  fi
    98	fi
    99	
   100	# ---- Gate 2: last rotation <90 days — API-KEY ROUTE ONLY ----
   101	# PLAN-169 W2.5 [codex r20-P2]: on route=login there is no API key in
   102	# play — applying the key-rotation cadence there would let a stale
   103	# rotation-log row (last OPENAI_API_KEY entry 2026-05-09) fail a valid
   104	# login session. The gate is skipped EXPLICITLY, with the route named.
   105	echo ""
   106	if [ "$AUTH_ROUTE" != "api-key" ]; then
   107	  echo "Gate 2: rotation cadence SKIPPED (route=login — no API key in play)"
   108	else
   109	echo "Gate 2: OPENAI_API_KEY rotation cadence (90-day)"
   110	ROTATION_LOG="docs/rotation-log.md"
   111	if [ ! -f "$ROTATION_LOG" ]; then
   112	  echo "  WARN: rotation-log.md missing; skipping cadence check"
   113	else
   114	  # Find the latest OPENAI_API_KEY row's date column. The row format is:
   115	  #   | YYYY-MM-DD | OPENAI_API_KEY | ... |
   116	  LAST_ROTATION_DATE=$(grep -E '^\| [0-9]{4}-[0-9]{2}-[0-9]{2} \| OPENAI_API_KEY' "$ROTATION_LOG" \
   117	    | tail -1 \
   118	    | awk -F'|' '{gsub(/ /,"",$2); print $2}' \
   119	    || echo "")
   120	  if [ -z "$LAST_ROTATION_DATE" ]; then
   121	    echo "  WARN: no OPENAI_API_KEY rotation row found in log"
   122	    if [ "${CEO_CODEX_KEY_ROTATION_OVERRIDE:-}" != "1" ]; then
   123	      echo "  Set CEO_CODEX_KEY_ROTATION_OVERRIDE=1 to bypass + log a fresh rotation."
   124	      exit 1
   125	    fi
   126	  else
   127	    # Compute days since rotation
   128	    if command -v gdate >/dev/null 2>&1; then
   129	      DATE_CMD="gdate"
   130	    else
   131	      DATE_CMD="date"
   132	    fi
   133	    LAST_TS=$($DATE_CMD -d "$LAST_ROTATION_DATE" +%s 2>/dev/null || $DATE_CMD -j -f "%Y-%m-%d" "$LAST_ROTATION_DATE" +%s 2>/dev/null || echo 0)
   134	    NOW_TS=$($DATE_CMD +%s)
   135	    if [ "$LAST_TS" = "0" ]; then
   136	      echo "  WARN: could not parse rotation date $LAST_ROTATION_DATE; skipping cadence"
   137	    else
   138	      DAYS_SINCE=$(( (NOW_TS - LAST_TS) / 86400 ))
   139	      echo "  Last rotation: $LAST_ROTATION_DATE ($DAYS_SINCE days ago)"
   140	      if [ "$DAYS_SINCE" -ge 90 ]; then
   141	        if [ "${CEO_CODEX_KEY_ROTATION_OVERRIDE:-}" = "1" ]; then
   142	          echo "  WARN: rotation >90d but CEO_CODEX_KEY_ROTATION_OVERRIDE=1 — bypassing"
   143	        else
   144	          echo "  FAIL: OPENAI_API_KEY rotation $DAYS_SINCE days ago exceeds 90-day cadence"
   145	          echo "  Rotate via OpenAI dashboard + append to docs/rotation-log.md."
   146	          echo "  Or set CEO_CODEX_KEY_ROTATION_OVERRIDE=1 for emergency/off-cycle."
   147	          exit 1
   148	        fi
   149	      elif [ "$DAYS_SINCE" -ge 75 ]; then
   150	        echo "  WARN: rotation $DAYS_SINCE days ago — approaching 90-day refusal"
   151	      else
   152	        echo "  OK: rotation $DAYS_SINCE days ago (<75 day warn threshold)"
   153	      fi
   154	    fi
   155	  fi
   156	fi
   157	fi  # end Gate 2 route wrapper (W2.5)
   158	
   159	# ---- Gate 3a: Codex CLI PRESENT (path resolution only — NO exec yet) ----
   160	# M4 (PLAN-163 fix-pass): `command -v` resolves the launcher path WITHOUT
   161	# executing the binary. The warm-startup `codex --version` exec is deferred
   162	# to Gate 3b, AFTER the ADR-182 pin verification (Gate 4) has run — so on
   163	# Phase 6 an unverified / swapped payload is NEVER exec'd. The pin check
   164	# itself (check_pair_rail.py --verify-codex-pin) only HASHES the payload; it
   165	# never spawns it.
   166	echo ""
   167	echo "Gate 3: Codex CLI present + warm startup"
   168	if ! command -v codex >/dev/null 2>&1; then
   169	  echo "  FAIL: codex CLI not found in PATH"
   170	  echo "  Install via: npm install -g @openai/codex"
   171	  exit 1
   172	fi
   173	CODEX_PATH="$(command -v codex)"
   174	echo "  Codex CLI path: $CODEX_PATH"
   175	
   176	# ---- Gate 4 (Phase 6): codex pin check — semver file + ADR-182 payload sha ----
   177	# M4: MUST run BEFORE the Gate 3b warm-startup exec. If the pin fails we
   178	# abort here, having never executed the unverified codex payload.
   179	if [ "$PHASE_NUM" = "6" ]; then
   180	  echo ""
   181	  echo "Gate 4: Codex CLI version pin check (BEFORE any binary exec — M4)"
   182	  PIN_FILE=".claude/governance/codex-cli-pin.txt"
   183	  if [ ! -f "$PIN_FILE" ]; then
   184	    echo "  FAIL: $PIN_FILE missing (Phase 6 deliverable)"
   185	    exit 1
   186	  fi
   187	  # ADR-182 (PLAN-163 T5.2): the old "binary sha" here compared only the
   188	  # semver / launcher artifact — `shasum -a 256 $(which codex)` hashes
   189	  # the npm JS launcher, not the native payload that executes. Gate 4
   190	  # now performs the REAL payload-sha comparison via the SAME helper the
   191	  # runtime hook uses (`check_pair_rail.py verify_codex_payload()`), so
   192	  # the pre-flight and the per-invocation check can never disagree on
   193	  # algorithm or manifest. Exit contract of the helper CLI:
   194	  #   0 = verified; 1 = mismatch/triple-missing (fail-CLOSED);
   195	  #   3 = infra (manifest unreadable, payload unresolvable, ...).
   196	  # The Owner pre-flight is strict: ANY non-zero fails the gate — an
   197	  # infra arm at pre-flight means the pin ceremony is incomplete.
   198	  echo "  Gate 4b: ADR-182 payload-pin verification (codex-cli-pin-manifest.json)"
   199	  PIN_MANIFEST=".claude/governance/codex-cli-pin-manifest.json"
   200	  if [ ! -f "$PIN_MANIFEST" ]; then
   201	    echo "  FAIL: $PIN_MANIFEST missing (ADR-182 deliverable)"
   202	    exit 1
   203	  fi
   204	  set +e
   205	  PIN_JSON=$(python3 .claude/hooks/check_pair_rail.py --verify-codex-pin "$CODEX_PATH")
   206	  PIN_RC=$?
   207	  set -e
   208	  echo "  verify-codex-pin: $PIN_JSON"
   209	  if [ "$PIN_RC" -ne 0 ]; then
   210	    echo "  FAIL: ADR-182 payload-pin verification exited rc=$PIN_RC"
   211	    echo "  (1=sha mismatch / triple missing — possible supply-chain swap;"
   212	    echo "   3=infra — manifest unreadable or payload unresolvable)"
   213	    echo "  If a codex upgrade is legitimate, re-pin via the ADR-182 ceremony."
   214	    echo "  Refusing to exec the unverified codex payload (M4 ordering)."
   215	    exit 1
   216	  fi
   217	  echo "  OK: native payload sha256 matches codex-cli-pin-manifest.json"
   218	fi
   219	
   220	# ---- Gate 3b: Codex CLI warm startup (exec) — gated behind Gate 4 on Phase 6 ----
   221	echo ""
   222	echo "Gate 3b: codex --version warm startup"
   223	# Run --version (5s timeout — Codex CLI cold start is typically <2s). On
   224	# Phase 6 this line is reached ONLY after Gate 4 verified the payload sha.
   225	# PLAN-169 W2.5 (ledger C.2): coreutils `timeout` does NOT exist on stock
   226	# macOS — the old invocation died with "command not found" garbage in the
   227	# captured string, so the gate never ran to completion on this machine.
   228	# perl alarm is the portable 5s bound (perl ships with macOS and Linux).
   229	if command -v timeout >/dev/null 2>&1; then
   230	  CODEX_VERSION=$(timeout 5 codex --version 2>&1 || echo "TIMEOUT")
   231	else
   232	  CODEX_VERSION=$(perl -e 'alarm 5; exec @ARGV' codex --version 2>&1 || echo "TIMEOUT")
   233	fi
   234	case "$CODEX_VERSION" in *TIMEOUT*)
   235	  echo "  FAIL: codex --version timed out (>5s) or failed to exec"
   236	  exit 1
   237	;; esac
   238	echo "  Codex CLI version: $CODEX_VERSION"
   239	
   240	echo ""
   241	echo "============================================"
   242	echo "All Phase $PHASE_NUM pre-flight gates PASS"
   243	echo "============================================"
   244	exit 0
