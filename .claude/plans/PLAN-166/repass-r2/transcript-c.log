    85	def parse_version(text: str) -> Optional[Tuple[int, int, int]]:
    86	    m = VERSION_RE.match(text.strip())
    87	    if not m:
    88	        return None
    89	    return (int(m.group(1)), int(m.group(2)), int(m.group(3)))
