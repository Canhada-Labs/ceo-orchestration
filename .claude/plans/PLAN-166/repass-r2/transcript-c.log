     1	"""PLAN-169 W2.3 — inject-agent-context.sh EXACT resolution ladder tests.
     2	
     3	The pre-W2.3 matcher used awk ``index()`` substring search and delivered
     4	"Government Cybersecurity Engineer" for "Security Engineer" in live use
     5	(the PLAN-169 debate, ledger C.1). The ladder under test:
     6	
     7	    1. EXACT persona-heading match (component equality, never substring)
     8	    2. explicit core-archetype -> .claude/agents/<slug>.md table
     9	       (slugs not derivable: "DevOps Engineer" -> devops.md)
    10	    3. SKILL-MAP-row-only role -> synthesized profile, labeled
    11	    4. unknown name -> hard error exit 3 (fail-closed, never a warning)
    12	
    13	Plus the [codex r12-P2] grammar extension: real roster names carry "/"
    14	and "&" ("UI/UX Lead", "Accessibility & i18n Engineer") and must pass
    15	input validation (old charset rejected them with exit 2).
    16	"""
    17	
    18	from __future__ import annotations
    19	
    20	import os
    21	import subprocess
    22	import unittest
    23	from pathlib import Path
    24	
    25	REPO_ROOT = Path(__file__).resolve().parent.parent.parent.parent
    26	SCRIPT = REPO_ROOT / ".claude" / "scripts" / "inject-agent-context.sh"
    27	
    28	
    29	def _run(*args, env_extra=None):
    30	    env = {**os.environ}
    31	    if env_extra:
    32	        env.update(env_extra)
    33	    return subprocess.run(
    34	        ["bash", str(SCRIPT), *args],
    35	        capture_output=True,
    36	        text=True,
    37	        timeout=15,
    38	        env=env,
    39	    )
    40	
    41	
    42	class ExactResolutionLadderTest(unittest.TestCase):
    43	
    44	    def test_security_engineer_never_resolves_by_substring(self):
    45	        # The C.1 defect: "security engineer" is a SUBSTRING of
    46	        # "cybersecurity engineer". Exact/component matching must never
    47	        # deliver a Government/Cyber-prefixed persona for this name.
    48	        result = _run("Security Engineer", "audit")
    49	        self.assertEqual(result.returncode, 0, result.stderr)
    50	        self.assertIn("## AGENT PROFILE", result.stdout)
    51	        self.assertNotIn("Government Cybersecurity", result.stdout)
    52	        self.assertNotIn("Cybersecurity Engineer", result.stdout)
    53	
    54	    def test_devops_engineer_resolves_via_native_table(self):
    55	        # team.md has no per-persona headings for DevOps Engineer; the
    56	        # explicit table must route to .claude/agents/devops.md (rung 2).
    57	        result = _run("DevOps Engineer", "ci work")
    58	        self.assertEqual(result.returncode, 0, result.stderr)
    59	        self.assertIn(".claude/agents/devops.md", result.stdout)
    60	
    61	    def test_vp_engineering_gets_synthesized_profile(self):
    62	        # "VP Engineering" exists ONLY as a SKILL MAP row — no persona
    63	        # section, no agents/ file. Rung 3 synthesizes from the row and
    64	        # says so explicitly.
    65	        result = _run("VP Engineering", "design review")
    66	        self.assertEqual(result.returncode, 0, result.stderr)
    67	        self.assertIn("SYNTHESIZED FROM THE SKILL MAP ROW", result.stdout)
    68	        self.assertIn("architecture-decisions", result.stdout)
    69	
    70	    def test_unknown_name_fails_closed_exit_3(self):
    71	        result = _run("Fictitious Nonexistent Person", "anything")
    72	        self.assertEqual(result.returncode, 3)
    73	        self.assertIn("resolves to NOTHING", result.stderr)
    74	
    75	    def test_grammar_accepts_slash_and_ampersand_names(self):
    76	        # Roster-real names must pass INPUT validation (not exit 2). They
    77	        # may still fail RESOLUTION (exit 3) in a backend-only checkout —
    78	        # both outcomes are fine; the grammar rejection is not.
    79	        for name in ("UI/UX Lead", "Accessibility & i18n Engineer"):
    80	            result = _run(name, "frontend work")
    81	            self.assertNotEqual(
    82	                result.returncode, 2,
    83	                f"grammar rejected roster-real name {name!r}: {result.stderr}",
    84	            )
    85	
    86	    def test_grammar_still_rejects_metacharacters(self):
    87	        for bad in ("$(rm x)", "a;b", "a|b", "../etc", "a\nb"):
    88	            result = _run(bad, "x")
    89	            self.assertEqual(result.returncode, 2, f"accepted {bad!r}")
    90	
    91	
    92	if __name__ == "__main__":
    93	    unittest.main(verbosity=2)

