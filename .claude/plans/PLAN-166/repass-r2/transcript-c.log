    91	
    92	def minor_releases_behind(
    93	    cur: Tuple[int, int, int], stamp: Tuple[int, int, int]
    94	) -> int:
    95	    """How many MINOR releases the stamp is behind the current VERSION.
    96	
    97	    MAJOR bumps count as a large jump (1000 minors) so a stale-across-major
    98	    doc always trips. A stamp at or ahead of current returns <= 0.
    99	    """
   100	    cur_major, cur_minor, _ = cur
   101	    st_major, st_minor, _ = stamp
   102	    return (cur_major - st_major) * 1000 + (cur_minor - st_minor)
   103	
