   155	def resolve_roots(
   156	    cli_roots: List[str], env_value: Optional[str]
   157	) -> List[str]:
   158	    """argv roots > CEO_DEPRECATION_SCAN_ROOTS > the framework repo itself."""
   159	    if cli_roots:
