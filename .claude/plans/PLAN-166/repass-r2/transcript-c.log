.claude/team.md:738:| `NEEDS_CONTEXT` | Blocked on missing information, not on capability | Re-dispatch the **same model** with the missing context added (not a more capable one) |
     1	#!/bin/bash
     2	# Usage: bash .claude/scripts/inject-agent-context.sh \
     3	#          [--skill-retrieve] [--mode=inline|reference] [--dispatch=native|mitigated] \
     4	#          "AgentName" "task description"
     5	# Outputs: Full agent context ready for Agent tool prompt
     6	#
     7	# Resolves the agent's primary skill through all tiers:
     8	#   .claude/skills/core/<skill>/SKILL.md
     9	#   .claude/skills/frontend/<skill>/SKILL.md
    10	#   .claude/skills/domains/<domain>/skills/<skill>/SKILL.md
    11	#
    12	# Security: AGENT_NAME is user-controlled (reaches here via the /spawn
    13	# slash command). We validate it against a strict whitelist and use
    14	# grep -F (fixed-string) for all matches to prevent regex injection.
    15	#
    16	# PLAN-011 Phase 2: opt-in --skill-retrieve flag.
    17	#   When passed, the script calls .claude/scripts/skill-retrieve.py and
    18	#   emits a "## RETRIEVED SKILLS" section listing the top-3 lexical tf-idf
    19	#   matches for the task description (in addition to the archetype's
    20	#   primary skill). Default behavior is unchanged.
    21	#
    22	# PLAN-060 Layer 7c (ADR-080): --dispatch=mitigated flag.
    23	#   Emits a header instructing the caller to dispatch via
    24	#   subagent_type=general-purpose to bypass the H4 rail anomaly
    25	#   (custom subagent_types qa/pe/se/devops receive only Grep+Glob
    26	#   from the Claude Code runtime despite frontmatter declaring full
    27	#   tools). general-purpose has full tool universe; persona injected
    28	#   via ## SKILL CONTENT in the prompt body. Empirically 13/13 success.
    29	#   Env-var fallback: CEO_DISPATCHER_MODE=native|mitigated.
    30	#   Kill-switch: CEO_MITIGATION_DISABLE=1 forces native universally.
    31	#
    32	# PLAN-061 (ADR-082): default flips to per-archetype.
    33	#   - Default `native` for `code-reviewer` archetype (full tool grant
    34	#     works empirically; preserves ADR-052 VETO floor).
    35	#   - Default `mitigated` for non-`code-reviewer` archetypes
    36	#     (qa-architect, performance-engineer, security-engineer, devops).
    37	#   Resolution precedence (highest first):
    38	#     kill-switch > --dispatch flag > CEO_DISPATCHER_MODE env > archetype default
    39	
    40	set -euo pipefail
    41	
    42	USE_SKILL_RETRIEVE=0
    43	# PLAN-059 / ADR-090 #1 (Session 67): Format B SKILL REFERENCE is now
    44	# the default for canonical-5 archetypes. Default flips per archetype
    45	# during the SKILL MAP lookup below; CEO_SKILL_REFERENCE_MODE=0 reverts
    46	# universally to inline. Adopters can also pass --mode=inline per-call.
    47	SKILL_INJECTION_MODE="reference"  # PLAN-059 ADR-090 #1: default flipped from "inline"
    48	# DISPATCH_MODE is resolved per-archetype below (see PLAN-061 / ADR-082).
    49	# Empty until resolution; the literal default flag-from-flag is tracked
    50	# separately to enforce precedence.
    51	DISPATCH_MODE=""
    52	DISPATCH_MODE_FROM_FLAG=""
    53	
    54	# PLAN-081 Phase 2 — Pair-Rail dispatcher mode.
    55	#   --pair-mode             Activate Pair-Rail routing via .claude/dispatcher/
    56	#                           routing-matrix.yaml. Looks up archetype's coder+
    57	#                           reviewer providers + sandbox + fallback policy.
    58	#                           Emits `## PAIR-RAIL DISPATCH` header instructing
    59	#                           caller to dispatch coder via primary rail and
    60	#                           pair the reviewer provider via PostToolUse hook.
    61	#   --coder=<provider>      Override the matrix-resolved coder provider.
    62	#                           Honored only when --pair-mode is active.
    63	#   --reviewer=<provider>   Override the matrix-resolved reviewer provider.
    64	#                           Honored only when --pair-mode is active.
    65	#
    66	# Resolution precedence (highest first):
    67	#   1. CEO_PAIR_RAIL_DISABLE=1   (kill-switch — forces single-LLM Claude)
    68	#   2. --pair-mode flag absent   (legacy single-rail path; no dispatcher
    69	#                                consultation; no dispatcher_route)
    70	#   3. disable_predicate fired   (matrix's predicates evaluated;
    71	#                                 fallback_provider engaged)
    72	#   4. --coder= / --reviewer=    (Owner override; emitted as reason_code
    73	#                                  override_<arg>)
    74	#   5. matrix archetype entry    (default coder+reviewer per spec.md §10)
    75	PAIR_MODE=0
    76	PAIR_CODER_OVERRIDE=""
    77	PAIR_REVIEWER_OVERRIDE=""
    78	
    79	# Parse leading flags. Order-independent. Positional args validated below.
    80	while [ "${1:-}" = "--skill-retrieve" ] \
    81	   || [ "${1:-}" = "--mode=reference" ] \
    82	   || [ "${1:-}" = "--mode=inline" ] \
    83	   || [ "${1:-}" = "--dispatch=mitigated" ] \
    84	   || [ "${1:-}" = "--dispatch=native" ] \
    85	   || [ "${1:-}" = "--pair-mode" ] \
    86	   || [[ "${1:-}" == --coder=* ]] \
    87	   || [[ "${1:-}" == --reviewer=* ]]; do
    88	  case "${1}" in
    89	    --skill-retrieve)
    90	      USE_SKILL_RETRIEVE=1
    91	      shift
    92	      ;;
    93	    --mode=reference)
    94	      # PLAN-020 Phase 2 (ADR-051): emit ## SKILL REFERENCE with hash-pin
    95	      # instead of inline ## SKILL CONTENT. Smaller, cache-friendlier
    96	      # spawn prompts; sub-agent Reads SKILL.md and re-hashes for forensic
    97	      # observation via check_skill_reference_read.py.
    98	      SKILL_INJECTION_MODE="reference"
    99	      shift
   100	      ;;
   101	    --mode=inline)
   102	      SKILL_INJECTION_MODE="inline"
   103	      shift
   104	      ;;
   105	    --dispatch=mitigated)
   106	      # PLAN-060 Layer 7c (ADR-080): emit header instructing caller to
   107	      # dispatch via subagent_type=general-purpose to bypass H4 rail
   108	      # anomaly (custom subagent_types qa/pe/se/devops receive only
   109	      # Grep+Glob from runtime despite frontmatter declaring full tools).
   110	      # Persona is injected via ## SKILL CONTENT; general-purpose has
   111	      # full tool universe (Bash+Edit+Read+Write+...).
   112	      DISPATCH_MODE_FROM_FLAG="mitigated"
   113	      shift
   114	      ;;
   115	    --dispatch=native)
   116	      DISPATCH_MODE_FROM_FLAG="native"
   117	      shift
   118	      ;;
   119	    --pair-mode)
   120	      PAIR_MODE=1
   121	      shift
   122	      ;;
   123	    --coder=*)
   124	      PAIR_CODER_OVERRIDE="${1#--coder=}"
   125	      shift
   126	      ;;
   127	    --reviewer=*)
   128	      PAIR_REVIEWER_OVERRIDE="${1#--reviewer=}"
   129	      shift
   130	      ;;
   131	  esac
   132	done
   133	
   134	# Honor CEO_SOTA_DISABLE master kill — forces inline regardless of flag.
   135	if [ "${CEO_SOTA_DISABLE:-}" = "1" ]; then
   136	  SKILL_INJECTION_MODE="inline"
   137	fi
   138	# Honor CEO_SKILL_REFERENCE_MODE=0 explicit opt-out.
   139	if [ "${CEO_SKILL_REFERENCE_MODE:-}" = "0" ]; then
   140	  SKILL_INJECTION_MODE="inline"
   141	fi
   142	
   143	AGENT_NAME="${1:-}"
   144	TASK_DESC="${2:-}"
   145	REPO_ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
   146	
   147	if [ -z "$AGENT_NAME" ]; then
   148	  echo "Usage: inject-agent-context.sh <AgentName> [task description]" >&2
   149	  echo "  <AgentName> must match: ^[A-Za-z][A-Za-z0-9 _-]{0,60}$" >&2
   150	  exit 1
   151	fi
   152	
   153	# Whitelist validation: letters, digits, space, underscore, dash, plus —
   154	# PLAN-169 W2.3 [codex r12-P2] — slash and ampersand, because the REAL
   155	# roster contains "UI/UX Lead" and "Accessibility & i18n Engineer" and the
   156	# old charset rejected both. First char must be a letter; max 61 chars.
   157	# Dot stays OUT of the charset, so path traversal via the name remains
   158	# impossible by construction; downstream the name is only (a) compared
   159	# fixed-string/equality-wise and (b) used as a KEY into the fixed
   160	# name->slug table — never interpolated into a path or a regex.
   161	# Whole-string bash =~, NOT a grep pipe: grep matches PER LINE, so a name
   162	# carrying an embedded newline ("a\nb") was ACCEPTED — each line matched
   163	# the charset on its own (caught by the W2.3 mirror test on the first CI
   164	# run, Linux job; the class is per-line-vs-whole-string, cousin of the
   165	# substring-vs-exact family this very item cures).
   166	_AN_RX='^[A-Za-z][A-Za-z0-9 _/&-]{0,60}$'
   167	if [[ ! "$AGENT_NAME" =~ $_AN_RX ]]; then
   168	  echo "ERROR: Invalid AgentName '$AGENT_NAME'" >&2
   169	  echo "  Must start with a letter and contain only letters, digits, spaces, underscores, slashes, ampersands, and dashes (max 61 chars)." >&2
   170	  exit 2
   171	fi
   172	
   173	# Resolve a skill name to its full SKILL.md path across all tiers.
   174	resolve_skill_path() {
   175	  local skill="$1"
   176	  local f
   177	  # Check core
   178	  f="$REPO_ROOT/.claude/skills/core/$skill/SKILL.md"
   179	  if [ -f "$f" ]; then
   180	    echo "$f"
   181	    return 0
   182	  fi
   183	  # Check frontend
   184	  f="$REPO_ROOT/.claude/skills/frontend/$skill/SKILL.md"
   185	  if [ -f "$f" ]; then
   186	    echo "$f"
   187	    return 0
   188	  fi
   189	  # Check domains
   190	  for domain_dir in "$REPO_ROOT/.claude/skills/domains/"*/; do
   191	    f="${domain_dir}skills/$skill/SKILL.md"
   192	    if [ -f "$f" ]; then
   193	      echo "$f"
   194	      return 0
   195	    fi
   196	  done
   197	  return 1
   198	}
   199	
   200	# Build the TEAM_FILES list once, used both for archetype detection
   201	# (PLAN-061 / ADR-082 default-on resolution below) and for emitting
   202	# the AGENT PROFILE / SKILL MAP sections later.
   203	TEAM_FILES=(
   204	  "$REPO_ROOT/.claude/team.md"
   205	  "$REPO_ROOT/.claude/frontend-team.md"
   206	)
   207	# Include domain persona files (fintech example + any others)
   208	for f in "$REPO_ROOT"/.claude/skills/domains/*/team-personas.md \
   209	         "$REPO_ROOT"/.claude/skills/domains/*/frontend-team-personas.md; do
   210	  [ -f "$f" ] && TEAM_FILES+=("$f")
   211	done
   212	
   213	# PLAN-061 (ADR-082) — Resolve DISPATCH_MODE per archetype before
   214	# emitting any output. Look up the archetype's primary skill from the
   215	# SKILL MAP; if it's `code-review-checklist`, the archetype default is
   216	# `native` (full tool grant works empirically + ADR-052 VETO floor).
   217	# Otherwise default is `mitigated` (qa-architect, performance-engineer,
   218	# security-engineer, devops all suffer the H4 rail anomaly).
   219	DETECTED_SKILL=""
   220	for team_file in "${TEAM_FILES[@]}"; do
   680	)
   681	        elif [ "$PAIR_RAIL_AUDIT_RAIL" = "fallback_claude_only" ] || [ "$PAIR_RAIL_AUDIT_RAIL" = "fallback_codex_only" ]; then
   682	          PAIR_RAIL_HEADER=$(cat <<PAIR_FALLBACK_HEADER
   683	## PAIR-RAIL FALLBACK — PLAN-081 Phase 2
   684	
   685	Pair-Rail is **disabled** for archetype \`$ARCHETYPE_KEY\` per
   686	\`.claude/dispatcher/routing-matrix.yaml\` disable-predicate evaluation:
   687	
   688	  Reason:                       \`$PAIR_RAIL_AUDIT_REASON\`
   689	  Active rail:                  $PAIR_RAIL_AUDIT_RAIL
   690	  Coder (single-LLM):           **$PAIR_RAIL_AUDIT_CODER**${PAIR_RAIL_AUDIT_CODER_MODEL:+ (model: \`$PAIR_RAIL_AUDIT_CODER_MODEL\`)}
   691	  Cross-LLM review:             SKIPPED (will resume when predicate clears)
   692	
   693	Forensic: \`audit-query.py dispatcher-routes-summary --window 24h\`
   694	will reflect \`reason_code: $PAIR_RAIL_AUDIT_REASON\` for this dispatch.
   695	
   696	---
   697	
   698	PAIR_FALLBACK_HEADER
   699	)
   700	        fi
   701	      fi
   702	    fi
   703	  fi
   704	fi
   705	
   706	if [ -n "$PAIR_RAIL_HEADER" ]; then
   707	  printf '%s\n' "$PAIR_RAIL_HEADER"
   708	fi
   709	
   710	# 0. PLAN-060 Layer 7c (ADR-080) — Mitigation dispatch header.
   711	#    When DISPATCH_MODE=mitigated, emit a header instructing the caller
   712	#    to dispatch via subagent_type=general-purpose with this entire
   713	#    block as the prompt body. Native subagent_types qa-architect,
   714	#    performance-engineer, security-engineer, devops suffer a runtime
   715	#    tool-grant divergence (receive Grep+Glob only despite frontmatter
   716	#    declaring Read,Grep,Glob,Bash). general-purpose receives the full
   717	#    tool universe (Bash,Edit,Read,Write,Glob,Grep,ScheduleWakeup,
   718	#    Skill,ToolSearch). Confirmed empirically 13/13 dispatches in
   719	#    PLAN-060 Layer 7c (.claude/plans/PLAN-060/audit/round-2/h4-layer7c-
   720	#    mitigation-via-general-purpose.md).
   721	if [ "$DISPATCH_MODE" = "mitigated" ]; then
   722	  cat <<'MITIGATION_HEADER'
   723	## DISPATCH MITIGATION — PLAN-060 Layer 7c (ADR-080)
   724	
   725	This prompt is constructed for dispatch via the BUILT-IN subagent_type
   726	"general-purpose" to bypass the H4 rail anomaly (custom subagent_types
   727	receive only Grep+Glob from the Claude Code runtime despite frontmatter
   728	declaring full tools). The persona below is injected via ## SKILL CONTENT;
   729	general-purpose has the full tool universe and executes Bash/Read/Edit
   730	correctly.
   731	
   732	CALLER MUST DISPATCH AS:
   733	  Task(subagent_type="general-purpose", prompt=<this entire block>)
   734	
   735	NOT AS:
   736	  Task(subagent_type="<original-archetype>", prompt=<this entire block>)
   737	
   738	Kill-switch: export CEO_MITIGATION_DISABLE=1 to revert to native dispatch
   739	(fails with tool-grant subset for non-cr archetypes).
   740	
   741	---
   742	
   743	MITIGATION_HEADER
   744	
   745	  # PLAN-069 S80 lesson: under mitigated rail, sub-agent inherits parent
   746	  # model unless `model:` param is passed explicit. Emit recommendation.
   747	  cat <<MODEL_HINT_HEADER
   748	## DISPATCH MODEL — recommendation per archetype (S80 lesson)
   749	
   750	CALLER MUST PASS \`model:\` param on the Agent tool call:
   751	
   752	  Task(
   753	    subagent_type="general-purpose",
   754	    model="${MODEL_HINT}",
   755	    prompt=<this entire block>
   756	  )
   757	
   758	Recommendation: **${MODEL_HINT}** for skill \`${DETECTED_SKILL:-unknown}\`
   759	Reason: ${MODEL_HINT_REASON}
   760	
   761	If omitted: sub-agent INHERITS the parent CEO session model (whatever
   762	generation the session runs — no specific id is implied here; PLAN-169
   763	W2.10 D3).
   764	Custom-agent frontmatter (\`.claude/agents/<archetype>.md\`) routing is
   765	DORMANT under mitigated rail (PLAN-061 / ADR-082 trade-off).
   766	
   767	VETO holders (CR + Sec) MUST be Opus per ADR-052 — never downgrade.
   768	Override per-call: pass \`model: "opus"\` explicit if Owner judges
   769	adversarial reasoning required.
   770	
   771	---
   772	
   773	MODEL_HINT_HEADER
   774	fi
   775	
   776	# 1. Extract agent profile from team.md (and fintech personas if present).
   777	#    TEAM_FILES was built earlier (before DISPATCH_MODE resolution).
   778	echo "## AGENT PROFILE"
   779	echo ""
   780	
   781	# PLAN-169 W2.3 (ledger C.1 + codex r6/r7-P1): EXACT resolution ladder,
   782	# fail-closed. The old substring matcher (`index()`) delivered
   783	# "Government Cybersecurity Engineer" for "Security Engineer" in live use
   784	# (the PLAN-169 debate itself). Rungs, in order, with a REAL target each:
   785	#   1. EXACT persona-heading match (component equality, never substring)
   786	#   2. explicit core-archetype -> .claude/agents/<slug>.md table
   787	#   3. SKILL MAP row only -> profile SYNTHESIZED from the row, labeled
   788	#   4. nothing -> hard error (exit 3), never a warning that spawns anyway
   789	FOUND_PROFILE=0
   790	for team_file in "${TEAM_FILES[@]}"; do
   791	  [ -f "$team_file" ] || continue
   792	  # Equality semantics: heading minus "### "/numbering equals the name
   793	  # (case-insensitive), or one of its " — "/" - "-separated components
   794	  # does. Kills the substring family: "security engineer" is a substring
   795	  # of "cybersecurity engineer" but never a component of it.
   796	  section=$(awk -v name="$AGENT_NAME" '
   797	    function norm(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return tolower(s) }
   798	    function exact(line,   h, i, parts) {
   799	      h = line; sub(/^###+ +/, "", h); sub(/^[0-9]+\. +/, "", h)
   800	      if (norm(h) == norm(name)) return 1
   801	      gsub(/ — /, SUBSEP, h); gsub(/ - /, SUBSEP, h)
   802	      split(h, parts, SUBSEP)
   803	      for (i in parts) if (norm(parts[i]) == norm(name)) return 1
   804	      return 0
   805	    }
   806	    /^###/ { if (found) exit; if (exact($0)) found=1 }
   807	    found && /^---$/ { print; exit }
   808	    found { print }
   809	  ' "$team_file")
   810	  if [ -n "$section" ]; then
   811	    echo "$section"
   812	    FOUND_PROFILE=1
   813	    break
   814	  fi
   815	done
   816	
   817	if [ "$FOUND_PROFILE" -eq 0 ]; then
   818	  # Rung 2 — the slugs are NOT derivable from the names ("DevOps
   819	  # Engineer" -> devops.md; "VP Engineering" has NO agents/ file at
   820	  # all), so this is an explicit table, not a heuristic.
   821	  NATIVE_SLUG=""
   822	  _an_lc=$(printf '%s' "$AGENT_NAME" | tr '[:upper:]' '[:lower:]')
   823	  case "$_an_lc" in
   824	    "staff code reviewer"|"code reviewer")   NATIVE_SLUG="code-reviewer" ;;
   825	    "devops engineer")                       NATIVE_SLUG="devops" ;;
   826	    "security engineer")                     NATIVE_SLUG="security-engineer" ;;
   827	    "principal qa architect"|"qa architect") NATIVE_SLUG="qa-architect" ;;
   828	    "principal performance engineer"|"performance engineer")
   829	                                             NATIVE_SLUG="performance-engineer" ;;
   830	    "principal identity and trust architect"|"identity trust architect")
   831	                                             NATIVE_SLUG="identity-trust-architect" ;;
   832	    "principal incident commander"|"incident commander")
   833	                                             NATIVE_SLUG="incident-commander" ;;
   834	    "principal threat detection engineer"|"threat detection engineer")
   835	                                             NATIVE_SLUG="threat-detection-engineer" ;;
   836	    "llm finops architect")                  NATIVE_SLUG="llm-finops-architect" ;;
   837	  esac
   838	  if [ -n "$NATIVE_SLUG" ] && [ -f "$REPO_ROOT/.claude/agents/$NATIVE_SLUG.md" ]; then
   839	    echo "(native archetype file: .claude/agents/$NATIVE_SLUG.md — W2.3 rung 2)"
   840	    echo ""
   841	    # Emit the BODY only: the YAML frontmatter is harness config, and the
   842	    # body's own "## " headings collide with the spawn-protocol markers
   843	    # this script emits. Demoting to "### " is NOT enough — substring
   844	    # checks still see "## SKILL REFERENCE" inside "### SKILL REFERENCE"
   845	    # (the same substring-vs-exact class W2.3 exists to kill). Rewrite
   846	    # the prefix to a non-heading token instead.
   847	    awk 'NR==1 && /^---$/ {fm=1; next}
   848	         fm==1 && /^---$/ {fm=2; next}
   849	         fm==1 {next}
   850	         {sub(/^## /, "[h2] "); print}' \
   851	      "$REPO_ROOT/.claude/agents/$NATIVE_SLUG.md"
   852	    FOUND_PROFILE=1
   853	  fi
   854	fi
   855	
   856	if [ "$FOUND_PROFILE" -eq 0 ]; then
   857	  # Rung 3 — a role that exists ONLY as a SKILL MAP row (no persona, no
   858	  # agents/ file, e.g. "VP Engineering") gets a profile synthesized from
   859	  # the row itself — name + skill + authority — labeled as such. This is
   860	  # what the CEO assembled by hand in S298; now it is the mechanism.
   861	  ROW=""
   862	  for team_file in "${TEAM_FILES[@]}"; do
   863	    [ -f "$team_file" ] || continue
   864	    ROW=$(grep -iF "**$AGENT_NAME**" "$team_file" 2>/dev/null | head -1 || true)
   865	    [ -n "$ROW" ] && break
   866	  done
   867	  if [ -n "$ROW" ]; then
   868	    echo "(PROFILE SYNTHESIZED FROM THE SKILL MAP ROW — W2.3 rung 3: no"
   869	    echo " persona section and no native agents/ file exist for this role;"
   870	    echo " everything below derives from the table row itself.)"
   871	    echo ""
   872	    echo "**Role:** $AGENT_NAME"
   873	    echo "**Skill-map row:** $ROW"
   874	    if [ -n "$DETECTED_SKILL" ]; then
   875	      echo "**Primary skill:** \`$DETECTED_SKILL\`"
   876	    fi
   877	    FOUND_PROFILE=1
   878	  fi
   879	fi
   880	

exec
