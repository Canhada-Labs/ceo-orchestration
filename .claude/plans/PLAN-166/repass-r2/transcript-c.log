   168	def classify_entry(
   169	    entry: Dict, today: datetime.date, warn_days: int
   170	) -> Tuple[str, str]:
   171	    """(severity, label) for one ledger entry relative to `today`."""
   172	    retirement = parse_iso_date(entry.get("retirement"))
   173	    if retirement is None:
   174	        return SEV_INFO, "DEPRECATED-NO-DATE"
   175	    if retirement <= today:
   176	        return SEV_BREAK, "ALREADY-RETIRED"
   177	    label = "RETIRE-%s" % retirement.isoformat()
   178	    if (retirement - today).days <= warn_days:
   179	        return SEV_WARN, label
   180	    return SEV_INFO, label
   181	
   182	
   183	def first_inert_rule(
   184	    rel_path: str, inert_rules: List[Tuple[str, "re.Pattern[str]"]]
   185	) -> Optional[str]:
   186	    for rule_id, rule_re in inert_rules:
   187	        if rule_re.search(rel_path):
   188	            return rule_id
   189	    return None
