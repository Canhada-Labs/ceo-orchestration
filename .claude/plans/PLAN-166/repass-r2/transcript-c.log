    92	def normalize_model_name(model: str) -> str:
    93	    """Canonicalize a Claude model id by alias/whitespace/case ONLY.
    94	
    95	    Steps (in order):
    96	      1. coerce to str, lower-case, strip, collapse internal whitespace.
    97	      2. drop a cosmetic ``anthropic/`` vendor prefix.
    98	      3. map a known raw alias (incl. a date-stamp or ``[1m]`` packaging tag) onto
    99	         its dateless canonical slug.
   100	    The ``major.minor`` version token is NEVER altered: ``opus-4-1`` and
   101	    ``opus-4-8`` return DISTINCT ids. An unrecognized id is returned in its
   102	    case/whitespace-normalized form (callers flag-and-zero-price it; we never
   103	    guess). Never raises.
   104	
   105	    Examples:
   106	        ``"  Claude-Opus-4-8  "`` -> ``"claude-opus-4-8"``
   107	        ``"claude-opus-4-8-20251101"`` -> ``"claude-opus-4-8"``
   108	        ``"opus-4-1"`` -> ``"claude-opus-4-1"`` (NOT ``claude-opus-4-8``)
   109	        ``"claude-opus-4-8[1m]"`` -> ``"claude-opus-4-8"``
   110	        ``"anthropic/claude-sonnet-4-6"`` -> ``"claude-sonnet-4-6"``
   111	        ``"some-future-model-9-9"`` -> ``"some-future-model-9-9"`` (passthrough)
   112	    """
   113	    try:
   114	        m = _WS_RX.sub("", str(model or "").strip().lower())
   115	        if not m:
   116	            return ""
   117	        # Drop a cosmetic ``anthropic/`` namespace prefix before alias lookup.
   118	        m = _VENDOR_PREFIX_RX.sub("", m)
   119	        # Exact alias fold (date-stamp / bare-family / ``[1m]`` tag). NEVER fuzzy.
   120	        if m in _RAW_ALIASES:
   121	            return _RAW_ALIASES[m]
   122	        return m
   123	    except Exception:
   124	        # Total + deterministic; the only way here is a pathological ``__str__``.
   125	        # Fail-open to a safe empty string (caller treats as unknown -> zero-price).
   126	        return ""
