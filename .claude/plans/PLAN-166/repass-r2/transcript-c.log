   293	
   294	def compute_cost_usd(
   295	    model: Optional[str],
   296	    tokens_in: int,
   297	    tokens_out: int,
   298	    pricing: Optional[Dict[str, Dict[str, float]]] = None,
   299	) -> Optional[float]:
   300	    """Compute USD cost from model + token counts; None on unknown model."""
   301	    if pricing is None:
   302	        pricing = _DEFAULT_PRICING
   303	    if not isinstance(model, str) or not model:
   304	        return None
   305	    row = pricing.get(model.lower())
   306	    if not row:
   307	        return None
   308	    cost = (tokens_in / 1000.0) * row.get("in", 0.0)
   309	    cost += (tokens_out / 1000.0) * row.get("out", 0.0)
   310	    return round(cost, 6)
