   211	STUB_FRESHNESS = '''#!/usr/bin/env python3
   212	"""Fixture stand-in for check-canonical-doc-freshness.py.
   213	
   214	Mirrors the property that matters: the gate judges the VERSION on the stamp,
   215	never the date. That is what makes freezing the date safe.
   216	"""
   217	import os, re, sys
   218	
   219	version = open("VERSION").read().strip()
   220	bad = []
   221	for path in ("npm/README.md", "SBOM.md", "SECURITY.md", "VERSIONING.md"):
   222	    if not os.path.exists(path):
   223	        continue
   224	    m = re.search(r"last-reviewed: \\d{4}-\\d{2}-\\d{2} v(\\d+\\.\\d+\\.\\d+)",
