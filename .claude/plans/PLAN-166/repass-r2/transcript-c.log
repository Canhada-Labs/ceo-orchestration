+echo "Gate 1: Codex auth route (API key OR authenticated login)"
+AUTH_ROUTE=""
+if [ -n "${OPENAI_API_KEY:-}" ]; then
+  KEY_LEN="${#OPENAI_API_KEY}"
+  if [ "$KEY_LEN" -lt 16 ]; then
