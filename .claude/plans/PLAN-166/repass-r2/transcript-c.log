   458	            continue
   459	        if entry.startswith(man_dir + "/"):
   460	            continue
   461	        if entry != vf_expected:
   462	            return _fail(
   463	                E_VERDICT,
   464	                "delta_allowlist entry %r is outside the manifest directory "
   465	                "(%s/) and is not this\n"
   466	                "      tag's verdict-fields at its canonical path (%s).\n"
   467	                "      Outside the manifest nothing pins content — a "
   468	                "post-review edit there\n"
   469	                "      would ride the tag by NAME alone, and a basename "
   470	                "match in any other\n"
   471	                "      directory is a look-alike, not the plan's file. Move "
   472	                "the file into the\n"
   473	                "      re-pass manifest, or it must be exactly %s."
   474	                % (entry, man_dir, vf_expected, vf_expected),
   475	            )
   476	
   477	    # --- set equality by NAME, both directions, inside the manifest dir ---
   478	    listed = set(
   479	        os.path.normpath(os.path.join(man_dir, name)).replace(os.sep, "/")
   480	        for _sha, name in entries
   481	    )
   482	    listed.add(manifest_rel)
   483	    allowed_in_dir = set(
   484	        e for e in allow_set if man_dir and (e == manifest_rel or e.startswith(man_dir + "/"))
   485	    )
   486	    if allowed_in_dir != listed:
   487	        extra = sorted(allowed_in_dir - listed)
   488	        missing = sorted(listed - allowed_in_dir)
   489	        return _fail(
   490	            E_MANIFEST_SET,
   491	            "re-pass artifact set is not closed under %s\n"
   492	            "      allowlisted but not in the manifest: %s\n"
   493	            "      in the manifest but not allowlisted: %s"
   494	            % (manifest_rel, extra or "-", missing or "-"),
   495	        )
   496	    print("  ok   re-pass artifact set closes (name equality with the manifest)")
   497	
   498	    # --- the delta itself ---
   499	    # --no-renames on purpose: with rename detection a file moved OUT of the
   500	    # allowlisted evidence directory is reported only under its destination
   501	    # name, and the disappearance of the reviewed original goes unmentioned.
   502	    # Literal paths on both sides or the set comparison is not a set comparison.
   503	    rc, out, err = _git(repo, "diff", "--no-renames", "%s..HEAD" % parent, "--name-only")
   504	    if rc != 0:
   505	        return _fail(
   506	            E_DELTA,
   507	            "`git diff --no-renames %s..HEAD --name-only` failed: %s"
   508	            % (parent, err.strip()),
   509	        )
   510	    changed = [line for line in out.splitlines() if line.strip()]
   511	    outside = sorted(p for p in changed if p not in allow_set)
   512	    if outside:
   513	        return _fail(
   514	            E_DELTA,
   515	            "files changed after the reviewed parent %s that the verdict does "
   516	            "NOT allow:\n%s\n"
   517	            "      The invariant is: NOTHING landed after what the re-pass "
   518	            "reviewed,\n"
   519	            "      other than the verdict and its pinned evidence. Either "
   520	            "re-run the\n"
   521	            "      re-pass against this tree, or drop these commits."
   522	            % (parent[:12], "\n".join("        - %s" % p for p in outside)),
   523	        )
   524	
   525	    # VACUITY. Everything above is satisfied trivially by an anchor that sits
   526	    # AT (or after) the verdict: the delta is then empty or verdict-free and
   527	    # "all files are inside the allowlist" proves nothing at all. The verdict
   528	    # has to have LANDED after the tree it certifies.
   529	    if verdict_rel not in changed:
   530	        return _fail(
   531	            E_VACUOUS,
   532	            "the verdict %s is not part of the delta %s..HEAD — this assert "
   533	            "would pass\n"
   534	            "      VACUOUSLY. parent_sha has to be the commit the re-pass "
   535	            "reviewed, with\n"
   536	            "      the verdict landing after it; parent_sha == HEAD (or any "
   537	            "anchor whose\n"
   538	            "      tree already carried the verdict) is the v1.16.0 "
   539	            "self-reference bug that\n"
   540	            "      the parent_sha field was introduced to kill."
   541	            % (verdict_rel, parent[:12]),
   542	        )
   543	
   544	    # State the inputs, not just the verdict: an operator reading a release log
   545	    # has to be able to tell what this assert actually examined.
   546	    print(
   547	        "  ok   delta %s..HEAD is %d file(s), all inside the verdict's closed "
   548	        "allowlist of %d (verdict present in the delta)"
   549	        % (parent[:12], len(changed), len(allow_set))
   550	    )
   551	    return 0
