   242	def write_sites(repo: Path, version: str, stamp_date: str) -> None:
   243	    (repo / "npm").mkdir(exist_ok=True)
   244	    (repo / "docs").mkdir(exist_ok=True)
   245	    stamp = "<!-- last-reviewed: %s v%s -->" % (stamp_date, version)
   246	    cur_minor, prev_minor = _support_window(version)
   247	    prev_sec = (
   248	        "- **Previous MINOR** (`v%s.x`) — security-only patches.\n" % prev_minor
   249	        if prev_minor
   250	        else ""
   251	    )
   252	    prev_ver = (
   253	        "| Previous MINOR (`v%s.x`) | Security-only patches |\n" % prev_minor
   254	        if prev_minor
   255	        else ""
   256	    )
   257	    (repo / "VERSION").write_text(version + "\n", encoding="utf-8")
   258	    # repass-r2 part-d P2: the marker site (W2.6) exists in the fixture so
   259	    # the e2e bump exercises the writer AND the stub oracle checks it.
   260	    (repo / ".claude").mkdir(exist_ok=True)
   261	    (repo / ".claude" / ".framework-version").write_text(
   262	        version + "\n", encoding="utf-8"
   263	    )
   264	    (repo / "npm" / "package.json").write_text(
   265	        json.dumps({"name": "fixture", "version": version}, indent=2) + "\n",
   266	        encoding="utf-8",
   267	    )
   268	    (repo / "pyproject.toml").write_text(
   269	        '[project]\nname = "fixture"\nversion = "%s"\n' % version, encoding="utf-8"
   270	    )
   271	    (repo / "INSTALL.md").write_text(
   272	        "bash install.sh --pin v%s\n" % version, encoding="utf-8"
   273	    )
   274	    (repo / "docs" / "ARCHITECTURE.md").write_text(
   275	        "The framework is currently v%s, aligned with the repo VERSION.\n" % version,
   276	        encoding="utf-8",
   277	    )
   278	    (repo / "npm" / "README.md").write_text(
   279	        "# fixture\n\n%s\n" % stamp, encoding="utf-8"
   280	    )
   281	    (repo / "README.md").write_text("VERSION=%s\n" % version, encoding="utf-8")
   282	    (repo / "SBOM.md").write_text(
   283	        "%s\n\n**Version:** `%s` (tracks repo-root VERSION)\n" % (stamp, version),
   284	        encoding="utf-8",
   285	    )
   286	    (repo / "SECURITY.md").write_text(
   287	        "%s\n\n# Security\n\n"
   288	        "- **Current MINOR** (`v%s.x`) — full security support.\n"
   289	        "%s" % (stamp, cur_minor, prev_sec),
   290	        encoding="utf-8",
   291	    )
   292	    (repo / "VERSIONING.md").write_text(
   293	        "%s\n\n# Versioning\n\n"
   294	        "| Current MINOR (`v%s.x`) | Full support |\n"
   295	        "%s" % (stamp, cur_minor, prev_ver),
   296	        encoding="utf-8",
   297	    )
