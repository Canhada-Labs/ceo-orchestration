   183	def _parse_verdict(text: str) -> Dict[str, object]:
   184	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   185	
   186	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   187	    of `  - item` list entries, and ignores everything else. Anything it cannot
   188	    read is absent, and every consumer below treats absent as fail-closed.
   189	
   190	    Parity with the step-15 reader (`.github/scripts/
   191	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   192	    scope: block selection (the regex below is the validator's own — the
   193	    first ```yaml fence, not the first fence of any language) and inline
   194	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   195	    parse_verdict_file reads key:value and sub-dicts and would drop
   196	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   197	    ONE shared reader (this file is the declared reference), never grow a
   198	    third parser of the same signed file.
   199	    """
   200	    fields: Dict[str, object] = {}
   201	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   202	    if block is None:
   203	        # No yaml block -> no fields -> every consumer below fails closed.
   204	        return fields
   205	    cur_list: Optional[str] = None
   206	    for raw in block.group(1).splitlines():
   207	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   208	        if not line.strip():
   209	            continue
   210	        if line.startswith(("  - ", "- ")) and cur_list:
   211	            item = line.split("-", 1)[1].strip()
   212	            if item:
   213	                fields[cur_list].append(item)  # type: ignore[union-attr]
   214	            continue
   215	        m = re.match(r"\A([A-Za-z0-9_]+):\s*(.*)\Z", line)
   216	        if not m:
   217	            continue
   218	        key, val = m.group(1), m.group(2).strip()
   219	        if val == "":
   220	            fields[key] = []
   221	            cur_list = key
   222	        else:
   223	            fields[key] = val
   224	            cur_list = None
   225	    return fields
   226	
   227	
   228	def _sha256(path: str) -> str:
   229	    h = hashlib.sha256()
   230	    with open(path, "rb") as fh:
   231	        for chunk in iter(lambda: fh.read(65536), b""):
   232	            h.update(chunk)
   233	    return h.hexdigest()
   234	
   235	
   236	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   237	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   238	    entries: List[Tuple[str, str]] = []
   239	    with open(path, encoding="utf-8") as fh:
   240	        for line in fh:
   241	            line = line.rstrip("\n")
   242	            if not line.strip():
   243	                continue
   244	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   245	            if not m:
   246	                raise ValueError("unparsable manifest line: %r" % line)
   247	            entries.append((m.group(1), m.group(2)))
   248	    return entries
   249	
   250	
   251	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   252	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   253	    directory = os.path.dirname(manifest) or "."
   254	    name = os.path.basename(manifest)
   255	    try:
   256	        proc = subprocess.run(
   257	            ["shasum", "-a", "256", "-c", name],
   258	            cwd=directory,
   259	            stdout=subprocess.PIPE,
   260	            stderr=subprocess.STDOUT,
   261	            universal_newlines=True,
   262	        )
   263	        return proc.returncode == 0, proc.stdout.strip()
   264	    except (OSError, FileNotFoundError):
   265	        bad: List[str] = []
   266	        for want, rel in _read_manifest(manifest):
   267	            full = os.path.join(directory, rel)
   268	            if not os.path.isfile(full) or _sha256(full) != want:
   269	                bad.append(rel)
   270	        if bad:
   271	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   272	        return True, "hashlib fallback: all entries match"
   273	
