    54	
    55	def _load(path: Path, name: str):
    56	    spec = importlib.util.spec_from_file_location(name, str(path))
    57	    assert spec and spec.loader, path
    58	    mod = importlib.util.module_from_spec(spec)
    59	    spec.loader.exec_module(mod)
    60	    return mod
    61	
    62	
    63	bump_sites = _load(SITES_SRC, "_release_bump_sites_under_test")
    64	tag_guard = _load(GUARD_SRC, "_release_tag_guard_under_test")
    65	
    66	
    67	# ---------------------------------------------------------------------------
    68	# helpers
    69	# ---------------------------------------------------------------------------
    70	def _env(home: Path) -> Dict[str, str]:
    71	    """A subprocess environment that cannot reach the real HOME or repo."""
    72	    env = dict(os.environ)
    73	    for key in ("CLAUDE_PROJECT_DIR", "GIT_DIR", "GIT_WORK_TREE"):
    74	        env.pop(key, None)
    75	    env.update(
    76	        {
    77	            "HOME": str(home),
    78	            "GNUPGHOME": str(home / "gnupg"),
    79	            "GIT_CONFIG_GLOBAL": str(home / "gitconfig"),
    80	            "GIT_CONFIG_SYSTEM": os.devnull,
    81	            "GIT_AUTHOR_NAME": "Release Test",
    82	            "GIT_AUTHOR_EMAIL": "release-test@example.invalid",
    83	            "GIT_COMMITTER_NAME": "Release Test",
    84	            "GIT_COMMITTER_EMAIL": "release-test@example.invalid",
    85	            "LC_ALL": "C",
    86	        }
    87	    )
    88	    return env
    89	
    90	
    91	def run(args: Sequence[str], cwd: Path, env: Dict[str, str]):
    92	    return subprocess.run(
    93	        list(args),
    94	        cwd=str(cwd),
    95	        env=env,
    96	        stdout=subprocess.PIPE,
    97	        stderr=subprocess.PIPE,
    98	        universal_newlines=True,
    99	    )
   100	
   101	
   102	def git(repo: Path, env: Dict[str, str], *args: str) -> str:
   103	    proc = run(["git"] + list(args), repo, env)
   104	    assert proc.returncode == 0, "git %s failed: %s%s" % (
   105	        " ".join(args),
   106	        proc.stdout,
   107	        proc.stderr,
   108	    )
   109	    return proc.stdout.strip()
   110	
   111	
   112	def sha256_file(path: Path) -> str:
   113	    return hashlib.sha256(path.read_bytes()).hexdigest()
   114	
   115	
   116	def tree_fingerprint(repo: Path) -> Dict[str, str]:
   117	    """Content hash of every file the bump may touch (writes are visible here
   118	    even when they are later committed, unlike `git status`)."""
   119	    out: Dict[str, str] = {}
   120	    for rel in bump_sites.site_paths(include_generated=True):
   121	        full = repo / rel
   122	        if full.is_file():
   123	            out[rel] = sha256_file(full)
   124	    return out
   125	
   126	
   127	def index_and_worktree_clean(repo: Path, env: Dict[str, str]) -> None:
   128	    porcelain = git(repo, env, "status", "--porcelain")
   129	    assert porcelain == "", "working tree not clean:\n%s" % porcelain
   130	    staged = run(["git", "diff", "--cached", "--quiet"], repo, env)
   131	    assert staged.returncode == 0, "index not clean:\n%s" % git(
   132	        repo, env, "diff", "--cached", "--name-only"
   133	    )
