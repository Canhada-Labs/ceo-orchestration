   191	
   192	def scan_root(
   193	    root: str,
   194	    pattern: "re.Pattern[str]",
   195	    literal_map: Dict[str, Dict],
   196	    inert_rules: List[Tuple[str, "re.Pattern[str]"]],
   197	    today: datetime.date,
   198	    warn_days: int,
   199	) -> List[Dict]:
   200	    """S230 sweep walk, ledger-driven; returns one dict per hit."""
   201	    hits: List[Dict] = []
   202	    for dirpath, dirnames, filenames in os.walk(root):
   203	        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
   204	        for fn in filenames:
   205	            path = os.path.join(dirpath, fn)
   206	            try:
   207	                # lstat + S_ISREG, not getsize: opening a FIFO BLOCKS FOREVER
   208	                # waiting for a writer, and getsize reports 0 for one, so the
   209	                # size cap never sees it. An adopter with a FIFO anywhere under
   210	                # the target used to hang the whole upgrade here — mid-run,
   211	                # after earlier surfaces had already been modified
   212	                # (PLAN-167 docs §5.7). Symlinks are skipped for the same
   213	                # no-follow reason the rest of the install surface uses.
   214	                st = os.lstat(path)
   215	                if not stat.S_ISREG(st.st_mode):
   216	                    continue
   217	                if st.st_size > MAX_BYTES:
   218	                    continue
   219	                with open(path, "rb") as fh:
   220	                    raw = fh.read()
   221	                if b"\x00" in raw[:8192]:
   222	                    continue
   223	                text = raw.decode("utf-8", errors="ignore")
   224	            except OSError:
   225	                continue
   226	            rel = os.path.relpath(path, root).replace(os.sep, "/")
   227	            inert_rule = first_inert_rule(rel, inert_rules)
   228	            for m in pattern.finditer(text):
   229	                entry = literal_map.get(m.group(0))
   230	                if entry is None:  # pragma: no cover — map covers pattern
   231	                    continue
   232	                severity, label = classify_entry(entry, today, warn_days)
   233	                hit = {
   234	                    "root": root,
   235	                    "path": rel,
   236	                    "line": text.count("\n", 0, m.start()) + 1,
   237	                    "matched": m.group(0),
   238	                    "model_id": entry.get("model_id"),
   239	                    "replacement": entry.get("replacement"),
   240	                    "retirement": entry.get("retirement"),
   241	                    "label": label,
   242	                    "severity": SEV_INERT if inert_rule else severity,
   243	                }
   244	                if inert_rule:
   245	                    hit["inert_rule"] = inert_rule
   246	                hits.append(hit)
   247	    return hits
   248	
