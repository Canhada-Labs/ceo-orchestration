   380	def build_parser() -> argparse.ArgumentParser:
   381	    parser = argparse.ArgumentParser(description="Decide whether release-gate authorises an npm publish.")
   382	    parser.add_argument("--payload-file", default="-", help="JSON of runs+jobs ('-' = stdin)")
   383	    parser.add_argument("--tag", required=True, help="tag name, i.e. head_branch of the release run")
   384	    parser.add_argument("--head-sha", required=True, help="GITHUB_SHA the publish is running against")
   385	    parser.add_argument("--workflow", default=DEFAULT_WORKFLOW)
   386	    parser.add_argument("--gate-job", default=DEFAULT_GATE_JOB)
   387	    parser.add_argument("--event", default=DEFAULT_EVENT)
   388	    parser.add_argument(
   389	        "--deadline-epoch",
   390	        type=int,
   391	        required=True,
   392	        help="epoch seconds after which any non-GRANT state becomes BLOCK (fail-closed)",
   393	    )
   394	    parser.add_argument("--now-epoch", type=int, default=None, help="override the clock (tests)")
   395	    parser.add_argument(
   396	        "--self-created-at",
   397	        required=True,
   398	        help=(
   399	            "created_at of the ASKING run; candidates older than this minus "
   400	            "the skew are stale. Required: this input arms the delete+re-tag "
   401	            "freshness leg, and a verdict-changing parameter has no default"
   402	        ),
   403	    )
   404	    parser.add_argument(
   405	        "--freshness-skew-seconds", type=int, default=DEFAULT_FRESHNESS_SKEW_SECONDS
   406	    )
   407	    parser.add_argument("--json", action="store_true", help="emit the decision record as JSON")
   408	    return parser
   409	
   410	
   411	def main(argv: Optional[Sequence[str]] = None) -> int:
   412	    args = build_parser().parse_args(argv)
   413	    # Unconditional parse: `required=True` rejects the OMITTED flag, and this
   414	    # rejects the empty/garbage value that a truthiness guard would have
   415	    # silently mapped to "freshness leg off".
   416	    self_created_at_epoch = parse_timestamp(args.self_created_at)
   417	    if self_created_at_epoch is None:
   418	        sys.stderr.write(
   419	            "error: --self-created-at %r is not an ISO-8601 timestamp "
   420	            "(the freshness leg cannot run without it)\n" % args.self_created_at
   421	        )
   422	        return EXIT_USAGE
   423	    ctx = GateContext(
   424	        tag=args.tag,
   425	        head_sha=args.head_sha,
   426	        now_epoch=args.now_epoch if args.now_epoch is not None else int(time.time()),
   427	        workflow=args.workflow,
   428	        gate_job=args.gate_job,
   429	        event=args.event,
   430	        deadline_epoch=args.deadline_epoch,
   431	        self_created_at_epoch=self_created_at_epoch,
   432	        freshness_skew_seconds=args.freshness_skew_seconds,
   433	    )
   434	    try:
   435	        payload = _load_payload(args.payload_file)
   436	    except (OSError, ValueError) as exc:
   437	        decision = Decision(BLOCK, "malformed-payload", {"error": str(exc)})
   438	    else:
   439	        decision = decide(payload, ctx)
   440	    if args.json:
   441	        print(json.dumps({
   442	            "decision": decision.decision,
   443	            "reason": decision.reason,
   444	            "facts": decision.facts,
   445	            "inputs": ctx._asdict(),
   446	        }, sort_keys=True, default=str))
   447	    else:
   448	        print(render(decision, ctx))
   449	    return decision.exit_code
   450	

