      # test_release_workflow_asserts.py, WaveB5 pattern):
      #   Verify tag GPG signature → Validate pair-rail verdict →
      #   delta → ancestry.
      # Do not reorder, do not merge into step 15.
      - name: Verify verdict delta + ancestry (fail-closed)
