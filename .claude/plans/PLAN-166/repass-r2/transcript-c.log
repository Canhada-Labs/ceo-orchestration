     1	#!/usr/bin/env python3
     2	"""debate-converge.py — Jaccard convergence detector for debate rounds.
     3	
     4	PLAN-011 Phase 5. Detects when a debate has converged by computing the
     5	Jaccard similarity of the risk sets between round N and round N-1
     6	across all agent critique files.
     7	
     8	## Usage
     9	
    10	    debate-converge.py --plan PLAN-NNN --round N [--plans-root <path>]
    11	
    12	    N must be >= 2. Round N-1 must exist on disk.
    13	
    14	## Algorithm
    15	
    16	1. For round N and round N-1, read every `<archetype>.md` file under
    17	   `.claude/plans/PLAN-NNN/debate/round-<N>/` (excluding `proposal.md`,
    18	   `consensus.md`, `synthesis.md`, `red-team.md` — those are CEO/meta
    19	   artifacts, not agent critiques).
    20	2. In each file, locate the `## Risks` heading and extract bullet items
    21	   (lines starting with `- `). Continue through subsequent bullets
    22	   until a new heading (`## `) or EOF.
    23	3. Normalize each risk bullet: lowercase, strip punctuation, collapse
    24	   whitespace, dedupe within a file.
    25	4. Union all risk bullets per round into a set.
    26	5. Compute Jaccard = |A ∩ B| / |A ∪ B| (0 if both sets are empty).
    27	6. Output JSON: `{"jaccard": float, "converged": bool, "red_team_needed": bool}`.
    28	
    29	`converged` is True iff jaccard >= threshold (default 0.7).
    30	`red_team_needed` is True iff `converged AND round <= 2`. This is the
    31	M1 anti-groupthink gate from PLAN-011 consensus round 1.
    32	
    33	## Why 0.7
    34	
    35	See ADR-032 §Decision drivers. 0.7 means ~70% of the risk vocabulary
    36	overlaps between rounds — high enough to distinguish "same topics
    37	reordered" from "genuine agreement". Lower thresholds (0.5) would
    38	declare convergence on largely disjoint sets; higher (0.9) would
    39	require near-exact text, which rarely survives Round→Round agent
    40	paraphrase.
    41	
    42	## Exit codes
    43	
    44	    0 — convergence computed successfully (JSON printed to stdout)
    45	    1 — bad args / round < 2 / round N-1 missing
    46	    2 — no agent critique files found in either round (zero coverage)
    47	    3 — max_rounds_reached (terminal; orchestrator also exits 3)
    48	"""
    49	
    50	from __future__ import annotations
    51	
    52	import argparse
    53	import json
    54	import re
    55	import string
    56	import sys
    57	from dataclasses import dataclass
    58	from pathlib import Path
    59	from typing import Iterable, List, Optional, Set
    60	
    61	
    62	# Default threshold; overridable via --threshold for stress tests.
    63	DEFAULT_JACCARD_THRESHOLD = 0.7
    64	
    65	# MAX_ROUNDS — HARD STOP (PLAN-012 Phase 1 D3.5 + debate round-1
    66	# chaos-engineer.md CRITICAL-2 "cost runaway via adversarial injection";
    67	# ADR-032 amendment). compute_convergence() forces outcome
    68	# "max_rounds_reached" when round_number >= MAX_ROUNDS, independent of
    69	# Jaccard score and budget hook state.
    70	MAX_ROUNDS = 5
    71	
    72	_OUTCOME_CONVERGED = "converged"
    73	_OUTCOME_DIVERGED = "diverged"
    74	_OUTCOME_MAX_ROUNDS = "max_rounds_reached"
    75	
    76	
    77	@dataclass
    78	class ConvergenceResult:
    79	    """Structured convergence probe result; see compute_convergence()."""
    80	
    81	    convergence_met: bool
    82	    max_rounds_reached: bool
    83	    jaccard_score: float
    84	    threshold: float
    85	    outcome: str  # one of _OUTCOME_*
    86	    round_number: int
    87	
    88	
    89	# Files that live under round-N/ but are NOT agent critiques.
    90	_NON_CRITIQUE_FILES = {
    91	    "proposal.md",
    92	    "consensus.md",
    93	    "synthesis.md",
    94	    "red-team.md",
    95	    # DEBATE-SCHEMA §13.2 anonymized-synthesis audit record (PLAN-134 W1)
    96	    "anonymization-map.md",
    97	}
    98	
    99	
   100	_HEADING_RE = re.compile(r"^\s*##\s+(.+?)\s*$")
   101	_BULLET_RE = re.compile(r"^\s*-\s+(.+?)\s*$")
   102	
   103	# Punctuation table used for normalization. We replace all ASCII
   104	# punctuation characters with a space (so "rate-limit" -> "rate limit",
   105	# not "ratelimit"); unicode punctuation is collapsed via split().
   106	_PUNCT_TABLE = str.maketrans(string.punctuation, " " * len(string.punctuation))
   107	
   108	
   109	def _plans_root_default() -> Path:
   110	    """Return the default `.claude/plans/` root based on __file__ location."""
   111	    # __file__ is at .claude/scripts/debate-converge.py — plans root is sibling.
   112	    return Path(__file__).resolve().parent.parent / "plans"
   113	
   114	
   115	def _round_dir(plans_root: Path, plan_id: str, round_num: int) -> Path:
   116	    return plans_root / plan_id / "debate" / f"round-{round_num}"
   117	
   118	
   119	def _normalize_risk(text: str) -> str:
   120	    """Normalize a risk bullet for set-membership comparison.
   121	
   122	    Steps:
   123	    - lowercase
   124	    - strip ASCII punctuation
   125	    - collapse whitespace (handles unicode spaces via .split())
   126	    - drop leading inline-ID prefixes like "R-VP1:", "R-SEC2 -",
   127	      so two rounds that renumber IDs still match on substance.
   128	    """
   129	    s = text.lower()
   130	    # Strip leading ID markers: "r-xxx:", "r-xxx -", "c1:", "m1:"
   131	    s = re.sub(r"^\s*(r-[a-z0-9]+|c\d+|m\d+|s\d+|h\d+)\s*[:\-—]\s*", "", s)
   132	    s = s.translate(_PUNCT_TABLE)
   133	    s = " ".join(s.split())
   134	    return s
   135	
   136	
   137	def extract_risks(md_text: str) -> List[str]:
   138	    """Extract and normalize bullet items under the `## Risks` heading.
   139	
   140	    Returns a list (order preserved, duplicates allowed; caller dedupes
   141	    via set()).
   142	    """
   143	    lines = md_text.splitlines()
   144	    risks: List[str] = []
   145	    in_risks = False
   146	    for raw in lines:
   147	        heading = _HEADING_RE.match(raw)
   148	        if heading:
   149	            title = heading.group(1).strip().lower()
   150	            # Accept "Risks", "risks (prioritized)", "Risks:"
   151	            if title == "risks" or title.startswith("risks "):
   152	                in_risks = True
   153	                continue
   154	            # Any other heading closes the Risks section
   155	            if in_risks:
   156	                in_risks = False
   157	            continue
   158	        if not in_risks:
   159	            continue
   160	        bullet = _BULLET_RE.match(raw)
   161	        if bullet:
   162	            normalized = _normalize_risk(bullet.group(1))
   163	            if normalized:
   164	                risks.append(normalized)
   165	    return risks
   166	
   167	
   168	def iter_agent_critiques(round_dir: Path) -> Iterable[Path]:
   169	    """Yield paths of agent critique files under round_dir (alpha-sorted).
   170	
   171	    Excludes proposal.md, consensus.md, synthesis.md, red-team.md.
   172	    """
   173	    if not round_dir.is_dir():
   174	        return
   175	    for p in sorted(round_dir.iterdir()):
   176	        if p.name in _NON_CRITIQUE_FILES:
   177	            continue
   178	        if p.suffix != ".md":
   179	            continue
   180	        if not p.is_file():
   181	            continue
   182	        yield p
   183	
   184	
   185	class RisksSectionEmptyError(ValueError):
   186	    """A critique has a `## Risks` heading that parsed to ZERO bullets.
   187	
   188	    PLAN-169 W2.9(i): paragraph-style risks (`**R-X** ...` prose) are
   189	    invisible to the bullet parser, so the critique silently contributed
   190	    an EMPTY set to the round (registered-vacuous family — the round-1
   191	    Security critique of PLAN-169 contributed 0 risks and nobody knew).
   192	    A present-but-unparseable section is an INPUT-parse failure and is
   193	    fail-closed: loud per-critique error, never a silent zero.
   194	    """
   195	
   196	
   197	def _risks_heading_present(md_text: str) -> bool:
   198	    """True when a `## Risks`-family heading exists in the text."""
   199	    for raw in md_text.splitlines():
   200	        heading = _HEADING_RE.match(raw)
   201	        if heading:
   202	            title = heading.group(1).strip().lower()
   203	            if title == "risks" or title.startswith("risks "):
   204	                return True
   205	    return False
   206	
   207	
   208	def collect_risk_set(round_dir: Path) -> Set[str]:
   209	    """Union all agent critique risks in a round into a normalized set.
   210	
   211	    Raises :class:`RisksSectionEmptyError` (fail-closed, W2.9(i)) when a
   212	    critique carries a Risks heading but zero parseable bullets.
   213	    """
   214	    out: Set[str] = set()
   215	    for critique_path in iter_agent_critiques(round_dir):
   216	        try:
   217	            text = critique_path.read_text(encoding="utf-8")
   218	        except OSError:
   219	            continue
   220	        items = extract_risks(text)
   221	        if not items:
   222	            if _risks_heading_present(text):
   223	                raise RisksSectionEmptyError(
   224	                    f"{critique_path}: '## Risks' heading present but ZERO "
   225	                    f"bullet items parsed — paragraph-style risks are "
   226	                    f"invisible to the machine; rewrite them as '- ' "
   227	                    f"bullets. Refusing to count this critique as silently "
   228	                    f"empty."
   229	                )
   230	            # repass-r2 part-d P1: Risks is one of the 7 REQUIRED critique
   231	            # sections (SPEC/v1/debate.schema.md). A critique with NO Risks
   232	            # section at all is malformed input, not an empty set — counting
   233	            # it as zero silently removes a critic's risks and can fake
   234	            # convergence. Same fail-closed posture, named separately.
   235	            raise RisksSectionEmptyError(
   236	                f"{critique_path}: required '## Risks' section is MISSING "
   237	                f"(SPEC/v1/debate.schema.md lists it among the 7 required "
   238	                f"critique sections). Refusing to count this critique as an "
   239	                f"empty risk set."
   240	            )
   241	        out.update(items)
   242	    return out
   243	
   244	
   245	def jaccard(a: Set[str], b: Set[str]) -> float:
   246	    """Return Jaccard similarity. Empty/empty = 1.0 by convention (no
   247	    evidence of divergence); anything vs empty = 0.0."""
   248	    if not a and not b:
   249	        return 1.0
   250	    if not a or not b:
   251	        return 0.0
   252	    inter = len(a & b)
   253	    union = len(a | b)
   254	    if union == 0:
   255	        return 1.0  # defensive; unreachable with above guards
   256	    return inter / union
   257	
   258	
   259	def compute_convergence(
   260	    plans_root: Path,
   261	    plan_id: str,
   262	    round_num: int,
   263	    threshold: float = DEFAULT_JACCARD_THRESHOLD,
   264	) -> dict:
   265	    """Compute Jaccard across round N and N-1. Returns a dict shaped
   266	    like :class:`ConvergenceResult` plus legacy keys (``jaccard``,
   267	    ``converged``, ``red_team_needed``, ``round``, ``plan``, risk counts,
   268	    ``zero_coverage``).
   269	
   270	    Ceiling semantics (PLAN-169 W2.9(iii), aligns with PROTOCOL §12.4):
   271	    a round at ``round_num >= MAX_ROUNDS`` is TERMINAL either way, but
   272	    convergence at the ceiling is CONVERGENCE — when jaccard >= threshold
   273	    the outcome is ``converged`` (met=True); only a below-threshold
   274	    ceiling round reports ``max_rounds_reached`` (met=False, escalate to
   275	    Owner). Termination is preserved (closes PLAN-012 chaos CRITICAL-2:
   276	    no round beyond the ceiling), the mislabel is not.
   277	
   278	    Resolved-vs-novel (W2.9(ii)): Jaccard PUNISHES cure — a risk that
   279	    left the set because it was RESOLVED between rounds shrinks the
   280	    intersection exactly like fresh divergence would. The score is kept
   281	    as-is (set-stability semantics, documented), and ``resolved_count``/
   282	    ``novel_count`` are reported separately so the CEO verdict never
   283	    rides on a number that penalizes fixing things."""
   284	    prev_dir = _round_dir(plans_root, plan_id, round_num - 1)
   285	    cur_dir = _round_dir(plans_root, plan_id, round_num)
   286	    if not prev_dir.is_dir():
   287	        raise FileNotFoundError(f"round {round_num - 1} directory missing: {prev_dir}")
   288	    if not cur_dir.is_dir():
   289	        raise FileNotFoundError(f"round {round_num} directory missing: {cur_dir}")
   290	    max_rounds_reached = bool(round_num >= MAX_ROUNDS)
   291	    prev_set = collect_risk_set(prev_dir)
   292	    cur_set = collect_risk_set(cur_dir)
   293	    zero_coverage = not prev_set and not cur_set
   294	    score = 0.0 if zero_coverage else jaccard(prev_set, cur_set)
   295	    jaccard_converged = (not zero_coverage) and score >= threshold
   296	    # W2.9(iii): convergence at the ceiling IS convergence (§12.4). The
   297	    # ceiling still terminates the debate — it only stops masking a
   298	    # jaccard >= threshold as an impasse.
   299	    convergence_met = jaccard_converged
   300	    if jaccard_converged:
   301	        outcome = _OUTCOME_CONVERGED
   302	    elif max_rounds_reached:
   303	        outcome = _OUTCOME_MAX_ROUNDS
   304	    else:
   305	        outcome = _OUTCOME_DIVERGED
   306	    return {
   307	        "jaccard": round(score, 6),
   308	        "converged": bool(convergence_met),
   309	        "red_team_needed": bool(convergence_met and round_num <= 2),
   310	        "round": round_num,
   311	        "plan": plan_id,
   312	        "prev_risk_count": len(prev_set),
   313	        "curr_risk_count": len(cur_set),
   314	        "resolved_count": len(prev_set - cur_set),
   315	        "novel_count": len(cur_set - prev_set),
   316	        "resolved_risks": sorted(prev_set - cur_set),
   317	        "novel_risks": sorted(cur_set - prev_set),
   318	        "threshold": threshold,
   319	        "zero_coverage": zero_coverage,
   320	        "convergence_met": bool(convergence_met),
   321	        "max_rounds_reached": max_rounds_reached,
   322	        "jaccard_score": round(score, 6),
   323	        "outcome": outcome,
   324	        "round_number": round_num,
   325	    }
   326	
   327	
   328	def _parse(argv: List[str]) -> argparse.Namespace:
   329	    p = argparse.ArgumentParser(
   330	        description="Compute Jaccard convergence for a debate round"
   331	    )
   332	    p.add_argument("--plan", required=True, help="Plan ID (PLAN-NNN)")
   333	    p.add_argument(
   334	        "--round",
   335	        type=int,
   336	        required=True,
   337	        dest="round_num",
   338	        help="Round number (>= 2)",
   339	    )
   340	    p.add_argument(
   341	        "--plans-root",
   342	        type=str,
   343	        default=None,
   344	        help="Override plans root (defaults to ../plans relative to this script)",
   345	    )
   346	    p.add_argument(
   347	        "--threshold",
   348	        type=float,
   349	        default=DEFAULT_JACCARD_THRESHOLD,
   350	        help=f"Jaccard threshold for convergence (default {DEFAULT_JACCARD_THRESHOLD})",
   351	    )
   352	    return p.parse_args(argv)
   353	
   354	
   355	def main(argv: Optional[List[str]] = None) -> int:
   356	    """CLI entrypoint — compute Jaccard convergence across debate rounds."""
   357	    args = _parse(argv if argv is not None else sys.argv[1:])
   358	    if args.round_num < 2:
   359	        print(
   360	            f"ERROR: --round must be >= 2 (got {args.round_num})",
   361	            file=sys.stderr,
   362	        )
   363	        return 1
   364	    if not re.match(r"^PLAN-[0-9]{3}$", args.plan):
   365	        print(
   366	            f"ERROR: --plan must match PLAN-NNN (got {args.plan!r})",
   367	            file=sys.stderr,
   368	        )
   369	        return 1
   370	
   371	    plans_root = (
   372	        Path(args.plans_root).resolve() if args.plans_root else _plans_root_default()
   373	    )
   374	
   375	    try:
   376	        result = compute_convergence(
   377	            plans_root, args.plan, args.round_num, threshold=args.threshold
   378	        )
   379	    except FileNotFoundError as e:
   380	        print(f"ERROR: {e}", file=sys.stderr)
   381	        return 1
   382	    except RisksSectionEmptyError as e:
   383	        # W2.9(i) fail-closed: a critique with a Risks heading and zero
   384	        # parseable bullets is an input-parse failure, never a silent zero.
   385	        # Exit 4 is distinct so orchestrators can tell "fix the critique
   386	        # format" apart from convergence outcomes.
   387	        print(f"ERROR: {e}", file=sys.stderr)
   388	        return 4
   389	
   390	    if result.get("zero_coverage"):
   391	        # Still print the JSON (machine-readable) and exit 2
   392	        print(json.dumps(result, sort_keys=True))
   393	        return 2
   394	
   395	    # Exit code 3 signals terminal max-rounds-BELOW-threshold to the
   396	    # orchestrator + CI scripts (distinct from exit 0 converged / exit 4
   397	    # unparseable-critique). W2.9(iii): a ceiling round whose jaccard met
   398	    # the threshold reports outcome=converged and exits 0 — convergence
   399	    # at the ceiling is convergence (§12.4), so the flag alone no longer
   400	    # forces the impasse path.
   401	    if result.get("outcome") == _OUTCOME_MAX_ROUNDS:
   402	        print(json.dumps(result, sort_keys=True))
