   239	      # -----------------------------------------------------------------
   240	      # PLAN-153 Wave B item 5 (a) — `already_published` idempotency
   241	      # guard. Before publishing, ask the registry whether this exact
   242	      # name@version already exists. If it does (a re-run of a
   243	      # previously successful publish, or a re-run after a post-publish
   244	      # step failed), the Publish step is skipped and the job succeeds
   245	      # as a documented no-op instead of going red on EPUBLISHCONFLICT.
   246	      #
   247	      # Detection is deliberately conservative: "published" ONLY when
   248	      # `npm view <name>@<version> version` exits 0 AND prints exactly
   249	      # the version (npm has historically flip-flopped between
   250	      # rc!=0/E404 and rc=0/empty-stdout for a missing version of an
   251	      # existing package — both shapes are treated as not-published).
   252	      # Any registry/network error therefore falls through to the
   253	      # publish attempt, which preserves today's behavior (npm itself
   254	      # fails closed on a true conflict). No auth needed: the package
   255	      # is public and `npm view` is an unauthenticated read.
   256	      # -----------------------------------------------------------------
   257	      - name: Check registry for already-published version
   258	        id: already_published
   259	        working-directory: npm
   260	        run: |
   261	          set -euo pipefail
   262	          PKG_NAME=$(node -p "require('./package.json').name")
   263	          PKG_VERSION=$(node -p "require('./package.json').version")
   264	          set +e
   265	          SEEN=$(npm view "${PKG_NAME}@${PKG_VERSION}" version 2>/dev/null)
   266	          RC=$?
   267	          set -e
   268	          if [[ "$RC" -eq 0 && "$SEEN" == "$PKG_VERSION" ]]; then
   269	            echo "published=true" >> "$GITHUB_OUTPUT"
   270	            echo "::notice::${PKG_NAME}@${PKG_VERSION} already exists in the registry — publish will be skipped (idempotent re-run, succeed-as-noop)"
   271	          else
   272	            echo "published=false" >> "$GITHUB_OUTPUT"
   273	            echo "OK: ${PKG_NAME}@${PKG_VERSION} not in registry (rc=$RC) — proceeding to publish"
   274	          fi
   275	
   276	      - name: Publish (Trusted Publishing — OIDC)
   277	        if: steps.already_published.outputs.published != 'true'
   278	        working-directory: npm
   279	        # PLAN-158 W1: NO long-lived token — npm >=11.5.1 detects the
   280	        # GitHub Actions OIDC context and mints a short-lived credential
   281	        # against the npmjs trusted-publisher registration (repo
