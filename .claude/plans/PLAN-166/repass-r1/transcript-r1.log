   704	  publish-release:
   705	    name: Publish GitHub Release + assets
   706	    needs: release-gate
   707	    runs-on: ubuntu-latest
   708	    permissions:
   709	      contents: write
   710	    steps:
   711	      - name: Checkout tag
   712	        # SHA-pinned: actions/checkout@v6.0.2
   713	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   714	        with:
   715	          fetch-depth: 0
   716	      - name: Setup Python 3.11
   717	        # SHA-pinned: actions/setup-python@v6.2.0
   718	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
   719	        with:
   720	          python-version: "3.11"
   721	      - name: Compute install.sh.sha256 (body excluding self-SHA trailer)
   722	        run: |
   723	          set -euo pipefail
   724	          FILE="scripts/install.sh"
   725	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
   726	          printf '%s  install.sh\n' "$HASH" > install.sh.sha256
   727	          echo "install.sh.sha256 = $HASH"
   728	      - name: Generate CycloneDX SBOM
   729	        run: |
   730	          set -euo pipefail
   731	          python3 .claude/scripts/generate-sbom.py --output sbom.cyclonedx.json
   732	      # -----------------------------------------------------------------
   733	      # PLAN-153 Wave B item 5 (d) — templatized release notes.
   734	      # Closes PLAN-152 §Deferred `release-notes-hardcoded-first-release`:
   735	      # the notes string used to hardcode a v1.0.0-only launch sentence,
   736	      # stale for every later tag. Notes are now rendered from
   737	      # `.github/release-notes-template.md` with {{TAG}} / {{VERSION}} /
   738	      # {{BASE_VERSION}} interpolation (BASE_VERSION = VERSION with any
   739	      # -rc.N suffix stripped, so RC notes point at the GA CHANGELOG
   740	      # section). Fail-closed on a missing template or an unrendered
   741	      # placeholder.
   742	      # -----------------------------------------------------------------
   743	      - name: Render release notes from template
   744	        run: |
   745	          set -euo pipefail
   746	          TAG="${GITHUB_REF_NAME}"
   747	          VERSION="${TAG#v}"
   748	          BASE_VERSION="${VERSION%-rc.[0-9]*}"
   749	          TEMPLATE=".github/release-notes-template.md"
   750	          if [[ ! -f "$TEMPLATE" ]]; then
   751	            echo "::error::release-notes template missing at $TEMPLATE"
   752	            exit 1
   753	          fi
   754	          sed -e "s/{{TAG}}/${TAG}/g" \
   755	              -e "s/{{VERSION}}/${VERSION}/g" \
   756	              -e "s/{{BASE_VERSION}}/${BASE_VERSION}/g" \
   757	              "$TEMPLATE" > release-notes.md
   758	          if grep -q '{{' release-notes.md; then
   759	            echo "::error::unrendered placeholders remain in release-notes.md"
   760	            exit 1
   761	          fi
   762	          echo "Rendered release notes:"
   763	          cat release-notes.md
