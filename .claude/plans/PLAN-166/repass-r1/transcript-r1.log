   435	      # -----------------------------------------------------------------
   436	      # PLAN-012 Phase 2 §R11 — weekly-workflow status gate.
   437	      # PLAN-019 P2 DevOps-P2-1 — 14-day staleness check added.
   438	      #
   439	      # Before a tag ships, assert that recent runs of the six advisory
   440	      # workflows (chaos, otel-smoke, perf-profile, adapter-live,
   441	      # red-team, formal-verify) have NOT been failing AND are fresh
   442	      # (most-recent run within 14 days). A red chaos.yml in the past 3
   443	      # runs means we have live regressions that a tag should not paper
   444	      # over. A stale workflow (no runs in 14 days) means the advisory
   445	      # check is silently disabled — kill switch, cron disabled, or
   446	      # workflow deleted.
   447	      #
   448	      # Staleness defense (P2 DevOps-P2-1): absence of runs is NOT
   449	      # neutral. Prior logic treated "no runs" as pass — a 1-year-old
   450	      # repo with 0 runs silently passed, turning the gate into a
   451	      # honeypot. Now: most-recent run must have started within 14 days
   452	      # OR the gate fails with `Workflow X stale — last run N days ago`.
   453	      #
   454	      # Uses `gh run list` against the REST API via $GITHUB_TOKEN; read
   455	      # permission on `actions` is granted at job level.
   456	      # -----------------------------------------------------------------
   457	      - name: Weekly workflow status gate (advisory health check + 14-day staleness, waiver-aware)
   458	        env:
   459	          GH_TOKEN: ${{ github.token }}
   460	        run: |
   460	        run: |
   461	          set -euo pipefail
   462	          TAG="${GITHUB_REF_NAME}"
   463	          VERSION="${TAG#v}"
   464	
   465	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment
   466	          # extension). Same waiver registry as the RC-hold gate:
   467	          # pre-GA phase with adopter_count=0 waives advisory-workflow
   468	          # staleness per Owner authorization. Post-first-adopter, the
   469	          # waiver file is expected to be empty and the gate resumes
   470	          # default enforcement.
   471	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   472	          if [[ -f "$WAIVER_FILE" ]]; then
   473	            if awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   474	              echo "::notice::$TAG has a pre-GA waiver in $WAIVER_FILE — skipping weekly workflow staleness gate"
   475	              exit 0
   476	            fi
   477	          fi
   478	
   479	          # PLAN-025 Batch G F-wf-002: fail-fast if gh is unavailable (rare
   480	          # on ubuntu-latest but not impossible on custom runners). Clearer
   481	          # error than "gh: command not found" in an obscure subshell.
   482	          command -v gh >/dev/null 2>&1 || {
   483	            echo "::error::gh CLI not found on runner; install via \"sudo apt-get install gh\" or use actions/setup-gh"
   484	            exit 1
   485	          }
   486	          # Tolerance: each workflow is checked across the last 3 runs.
   487	          # If ANY run in that window is `failure` → fail the release.
   488	          # `skipped` runs are fine (kill-switch or paths-filter).
   489	          WORKFLOWS=(chaos.yml otel-smoke.yml perf-profile.yml adapter-live.yml red-team.yml formal-verify.yml)
   490	          STALENESS_DAYS=14
   491	          STALENESS_SECS=$((STALENESS_DAYS * 86400))
   492	          NOW_SECS=$(date -u +%s)
   493	          FAILED=0
   494	          for wf in "${WORKFLOWS[@]}"; do
   495	            # Fetch up to 3 runs with both conclusion AND startedAt timestamp.
   496	            runs_json=$(gh run list --workflow "$wf" --limit 3 \
   497	              --json conclusion,startedAt 2>/dev/null || echo "[]")
   498	            if [ -z "$runs_json" ] || [ "$runs_json" = "[]" ]; then
   499	              # Absence of runs is NOT neutral post-DevOps-P2-1: it means
   500	              # the advisory workflow has never triggered in this repo.
   501	              # For a mature release (v1.x.y), that's a bug — kill switch
   502	              # set, cron disabled, or workflow deleted.
   503	              echo "::error::$wf — zero runs recorded; staleness gate fails"
   504	              FAILED=1
   505	              continue
   506	            fi
   507	            # Extract conclusions for the failure-scan logic.
   508	            # Session 33 refinement: the previous rule "any failure in
   509	            # last 3 → block" did not distinguish "past bug, now fixed"
   510	            # from "still broken / intermittent flake". Both classes
   511	            # block release, but only the second is a real tag risk.
   512	            # New rule: block iff BOTH of these hold simultaneously:
   513	            #   (a) at least one failure in last 3 runs
   514	            #   (b) the MOST RECENT run also failed
   515	            # Rationale: (a) alone is false-positive after a root-cause
   516	            # fix; (b) alone would let a "one green after 10 reds"
   517	            # flake slip through. Both together = persistent failure
   518	            # that a tag should not paper over.
   519	            conclusions=$(echo "$runs_json" | jq -r '.[].conclusion')
   520	            latest_conclusion=$(echo "$runs_json" | jq -r '.[0].conclusion')
   521	            if echo "$conclusions" | grep -q '^failure$' \
   522	               && [ "$latest_conclusion" = "failure" ]; then
   523	              echo "::error::$wf — failure in last 3 AND latest run failed; block release"
   524	              FAILED=1
   525	            elif echo "$conclusions" | grep -q '^failure$'; then
   526	              echo "::notice::$wf — past failure in last 3 but latest run green; accepting as fixed"
   527	            fi
   528	            # Staleness check: most-recent run's startedAt must be within
   529	            # STALENESS_DAYS of now. startedAt is ISO-8601 UTC
   530	            # (e.g. "2026-04-10T12:34:56Z"). GitHub runners are Linux →
   531	            # GNU `date -d` is always available.
   532	            latest_started=$(echo "$runs_json" | jq -r '.[0].startedAt')
   533	            if [ -z "$latest_started" ] || [ "$latest_started" = "null" ]; then
   534	              echo "::error::$wf — cannot parse startedAt for most-recent run"
   535	              FAILED=1
   536	              continue
   537	            fi
   538	            started_secs=$(date -u -d "$latest_started" +%s 2>/dev/null || echo 0)
   539	            if [ "$started_secs" -eq 0 ]; then
   540	              echo "::error::$wf — failed to parse startedAt: $latest_started"
   541	              FAILED=1
   542	              continue
   543	            fi
   544	            delta=$((NOW_SECS - started_secs))
   545	            days=$((delta / 86400))
   546	            if [ "$delta" -gt "$STALENESS_SECS" ]; then
   547	              echo "::error::$wf stale — last run $days days ago (> $STALENESS_DAYS day limit)"
   548	              FAILED=1
   549	            else
   550	              echo "::notice::$wf — recent runs OK; last run $days days ago"
   551	            fi
   552	          done
   553	          if [ "$FAILED" -eq 1 ]; then
   554	            echo "::error::release gate: one or more advisory workflows red or stale"
   555	            exit 1
   556	          fi
   557	          echo "OK: all 6 advisory workflows clean in last 3 runs + fresh within $STALENESS_DAYS days"
   558	
