   434	
   435	      # -----------------------------------------------------------------
   436	      # PLAN-012 Phase 2 §R11 — weekly-workflow status gate.
   437	      # PLAN-019 P2 DevOps-P2-1 — 14-day staleness check added.
   438	      #
   439	      # Before a tag ships, assert that recent runs of the six advisory
   440	      # workflows (chaos, otel-smoke, perf-profile, adapter-live,
   441	      # red-team, formal-verify) have NOT been failing AND are fresh
   442	      # (most-recent run within 14 days). A red chaos.yml in the past 3
   443	      # runs means we have live regressions that a tag should not paper
   444	      # over. A stale workflow (no runs in 14 days) means the advisory
   445	      # check is silently disabled — kill switch, cron disabled, or
   446	      # workflow deleted.
   447	      #
   448	      # Staleness defense (P2 DevOps-P2-1): absence of runs is NOT
   449	      # neutral. Prior logic treated "no runs" as pass — a 1-year-old
   450	      # repo with 0 runs silently passed, turning the gate into a
   451	      # honeypot. Now: most-recent run must have started within 14 days
   452	      # OR the gate fails with `Workflow X stale — last run N days ago`.
   453	      #
   454	      # Uses `gh run list` against the REST API via $GITHUB_TOKEN; read
   455	      # permission on `actions` is granted at job level.
   456	      # -----------------------------------------------------------------
   457	      - name: Weekly workflow status gate (advisory health check + 14-day staleness, waiver-aware)
   458	        env:
   459	          GH_TOKEN: ${{ github.token }}
   460	        run: |
   461	          set -euo pipefail
   462	          TAG="${GITHUB_REF_NAME}"
   463	          VERSION="${TAG#v}"
   464	
   465	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment
   466	          # extension). Same waiver registry as the RC-hold gate:
   467	          # pre-GA phase with adopter_count=0 waives advisory-workflow
   468	          # staleness per Owner authorization. Post-first-adopter, the
   469	          # waiver file is expected to be empty and the gate resumes
   470	          # default enforcement.
   471	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   472	          if [[ -f "$WAIVER_FILE" ]]; then
   473	            if awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   474	              echo "::notice::$TAG has a pre-GA waiver in $WAIVER_FILE — skipping weekly workflow staleness gate"
   475	              exit 0
   476	            fi
   477	          fi
   478	
   479	          # PLAN-025 Batch G F-wf-002: fail-fast if gh is unavailable (rare
   480	          # on ubuntu-latest but not impossible on custom runners). Clearer
   481	          # error than "gh: command not found" in an obscure subshell.
   482	          command -v gh >/dev/null 2>&1 || {
   483	            echo "::error::gh CLI not found on runner; install via \"sudo apt-get install gh\" or use actions/setup-gh"
   484	            exit 1
   485	          }
   486	          # Tolerance: each workflow is checked across the last 3 runs.
   487	          # If ANY run in that window is `failure` → fail the release.
   488	          # `skipped` runs are fine (kill-switch or paths-filter).
   489	          WORKFLOWS=(chaos.yml otel-smoke.yml perf-profile.yml adapter-live.yml red-team.yml formal-verify.yml)
   490	          STALENESS_DAYS=14
   491	          STALENESS_SECS=$((STALENESS_DAYS * 86400))
   492	          NOW_SECS=$(date -u +%s)
   493	          FAILED=0
   494	          for wf in "${WORKFLOWS[@]}"; do
   495	            # Fetch up to 3 runs with both conclusion AND startedAt timestamp.
   496	            runs_json=$(gh run list --workflow "$wf" --limit 3 \
   497	              --json conclusion,startedAt 2>/dev/null || echo "[]")
   498	            if [ -z "$runs_json" ] || [ "$runs_json" = "[]" ]; then
   499	              # Absence of runs is NOT neutral post-DevOps-P2-1: it means
   500	              # the advisory workflow has never triggered in this repo.
   501	              # For a mature release (v1.x.y), that's a bug — kill switch
   502	              # set, cron disabled, or workflow deleted.
   503	              echo "::error::$wf — zero runs recorded; staleness gate fails"
   504	              FAILED=1
   505	              continue
   506	            fi
   507	            # Extract conclusions for the failure-scan logic.
   508	            # Session 33 refinement: the previous rule "any failure in
   509	            # last 3 → block" did not distinguish "past bug, now fixed"
   510	            # from "still broken / intermittent flake". Both classes
   511	            # block release, but only the second is a real tag risk.
   512	            # New rule: block iff BOTH of these hold simultaneously:
   513	            #   (a) at least one failure in last 3 runs
   514	            #   (b) the MOST RECENT run also failed
   515	            # Rationale: (a) alone is false-positive after a root-cause
   516	            # fix; (b) alone would let a "one green after 10 reds"
   517	            # flake slip through. Both together = persistent failure
   518	            # that a tag should not paper over.
   519	            conclusions=$(echo "$runs_json" | jq -r '.[].conclusion')
   520	            latest_conclusion=$(echo "$runs_json" | jq -r '.[0].conclusion')
     1	name: NPM Publish
     2	
     3	# Sprint 5 Phase 4; registry auth migrated to npm **Trusted Publishing**
     4	# (OIDC) by PLAN-158 Wave 1 (PLAN-152 §Deferred backlog-oidc successor).
     5	# Publishes ceo-orchestration on tag push (`v*`): the npm CLI (>=11.5.1,
     6	# upgraded in-job — Node 20 bundles npm 10.x, which cannot do the
     7	# exchange) detects the GitHub Actions OIDC context (`id-token: write`)
     8	# and exchanges the per-run JWT for a short-lived publish credential
     9	# scoped to this repo + workflow + `production-npm` environment as
    10	# registered in the npmjs.com trusted-publisher config (Owner console).
    11	# The same JWT keeps feeding the Sigstore `--provenance` attestation.
    12	# The long-lived NPM_TOKEN is NOT read by this workflow anymore and is
    13	# REVOKED once the first OIDC GA publish succeeds (until then it exists
    14	# solely as the rollback path:
    15	# .claude/plans/PLAN-158/staged/wave1/rollback-oidc-to-token.patch +
    16	# .claude/plans/PLAN-158/oidc-failure-playbook.md — tag runs pin the
    17	# workflow to the tag's tree, so a failed GA publish means rollback +
    18	# delete/re-tag; there is no workflow_dispatch here by design).
    19	# Manual `npm publish` is not used. The workflow:
    20	#   1. Verifies VERSION + npm/package.json version + tag are consistent
    21	#   2. Asserts package.json has zero runtime dependencies
    22	#   3. Checks the registry for the exact version (PLAN-153 Wave B item 5
    23	#      `already_published` idempotency guard) — if already present, the
    24	#      run succeeds as a no-op instead of failing on EPUBLISHCONFLICT
    25	#   4. Publishes with --provenance (Sigstore-attested)
    26	#
    27	# PLAN-013 Phase 0 item 0.2 hardening (debate Round 1 consensus §C5
    28	# CRITICAL, 2/5 agents — DevOps + Staff Backend):
    29	#   - Skip RC tags entirely (`if: !contains(github.ref, '-rc.')`) —
    30	#     pushing `v1.4.0-rc.1` MUST NOT trigger a public npm publish;
    31	#     that would violate PLAN-013 anti-goal #3 ("NO NPM publish during
    32	#     Sprint 13") and anti-goal #16 ("NO auto-publish from tag without
    33	#     manual approval").
    34	#   - GA tags (`v1.4.0`) gate through `environment: production-npm`,
    35	#     which requires a manual approval step in GitHub's Environments
    36	#     settings before the job runs. The manual approval is the
    37	#     Owner-in-the-loop gate covering the Sprint 17 public-launch
    38	#     go/no-go decision (private-first strategy per
    39	#     `project_closure_strategy.md`).
    40	
    41	on:
    42	  push:
    43	    tags:
    44	      - "v*"
    45	
    46	concurrency:
    47	  group: npm-publish-${{ github.ref }}
    48	  cancel-in-progress: false
    49	
    50	permissions:
    51	  contents: read
    52	  id-token: write   # required for OIDC trusted publishing + provenance
    53	
    54	jobs:
    55	  publish:
    56	    # PLAN-013 Phase 0 item 0.2 — RC tag guard.
    57	    # RC tags contain `-rc.` (e.g. `v1.4.0-rc.1`). Skip them entirely.
    58	    # Only GA tags (`v1.4.0`) proceed, and those gate through the
    59	    # `production-npm` environment (manual approval).
    60	    # PLAN-153 Wave B item 5 (f): RC posture UNCHANGED — this exclusion
    61	    # is load-bearing (PLAN-013 anti-goals #3/#16) and MUST survive any
    62	    # future edit to this file; the draft `next` dist-tag idea was
    63	    # DROPPED by ratified debate. Pinned by
    64	    # .claude/scripts/tests/test_release_workflow_asserts.py.
    65	    if: "!contains(github.ref, '-rc.')"
    66	    runs-on: ubuntu-latest
    67	    environment: production-npm
    68	    timeout-minutes: 8
    69	    steps:
    70	      - name: Checkout tag
    71	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
    72	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
    73	        with:
    74	          fetch-depth: 0
    75	
    76	      - name: Setup Node 20
    77	        # SHA-pinned: actions/setup-node@v4.1.0
    78	        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e
    79	        with:
    80	          node-version: "20"
    81	          registry-url: "https://registry.npmjs.org"
    82	
    83	      - name: Upgrade npm CLI for Trusted Publishing (OIDC)
    84	        # PLAN-158 W1 (debate, all 3 critics): Node 20 bundles npm 10.x,
    85	        # which does NOT implement the trusted-publishing token exchange —
    86	        # without this step the OIDC publish dies ENEEDAUTH at GA, and
    87	        # there is no earlier proof point (RC tags skip this workflow
    88	        # entirely). npm >=11.5.1 is the first trusted-publishing-GA CLI.
    89	        run: |
    90	          set -euo pipefail
    91	          npm install -g npm@^11.5.1
    92	          NPM_V="$(npm --version)"
    93	          case "$NPM_V" in
    94	            10.*|11.0.*|11.1.*|11.2.*|11.3.*|11.4.*|11.5.0)
    95	              echo "::error::npm $NPM_V < 11.5.1 — trusted publishing unsupported"
    96	              exit 1
    97	              ;;
    98	          esac
    99	          echo "OK: npm $NPM_V (>=11.5.1, trusted-publishing capable)"
