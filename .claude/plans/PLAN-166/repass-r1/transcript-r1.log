   372	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   373	            echo "::error::Source install.sh trailer has drifted from placeholder."
   374	            echo "got: $TRAILER_LINE"
   375	            exit 1
   376	          fi
   377	          # (b) + (c) stage a populated copy in a scratch dir.
   378	          SCRATCH="$(mktemp -d -t ceo-selfsha-XXXXXX)"
   379	          cp "$FILE" "$SCRATCH/install.sh"
   380	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$SCRATCH/install.sh" "$SCRATCH/install.sh" | sha256sum | awk '{print $1}')
   381	          awk -v hash="$HASH" '
   382	            NR == FNR { total = NR; next }
   383	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   384	            { print }
   385	          ' "$SCRATCH/install.sh" "$SCRATCH/install.sh" > "$SCRATCH/install.sh.new"
   386	          mv "$SCRATCH/install.sh.new" "$SCRATCH/install.sh"
   387	          chmod +x "$SCRATCH/install.sh"
   388	          # (d) Run the populated copy with no args; must exit rc=1
   389	          #     (usage), NOT rc=5 (self-SHA mismatch).
   390	          set +e
   391	          bash "$SCRATCH/install.sh" > /dev/null 2>"$SCRATCH/err"
   392	          RC=$?
   393	          set -e
   394	          if [ "$RC" -eq 5 ]; then
   395	            echo "::error::populated install.sh still rc=5 — self-SHA mechanism broken"
   396	            cat "$SCRATCH/err"
   397	            exit 1
   398	          fi
   399	          if [ "$RC" -ne 1 ]; then
   400	            echo "::error::populated install.sh rc=$RC (expected 1 for usage exit)"
   401	            cat "$SCRATCH/err"
   402	            exit 1
   403	          fi
   404	          # (e) Tamper test: mutate body, verify rc=5.
   405	          # Prepend malicious line before the trailer
   406	          head -n -1 "$SCRATCH/install.sh" > "$SCRATCH/install.sh.tmp1"
   407	          echo 'echo "MALICIOUS_INJECT" >&2' >> "$SCRATCH/install.sh.tmp1"
   408	          tail -n 1 "$SCRATCH/install.sh" >> "$SCRATCH/install.sh.tmp1"
   409	          chmod +x "$SCRATCH/install.sh.tmp1"
   410	          set +e
   411	          bash "$SCRATCH/install.sh.tmp1" > /dev/null 2>"$SCRATCH/err2"
   412	          RC2=$?
   413	          set -e
   414	          if [ "$RC2" -ne 5 ]; then
   415	            echo "::error::tampered install.sh did NOT rc=5 (got $RC2) — self-SHA gate broken"
   416	            cat "$SCRATCH/err2"
   417	            exit 1
   418	          fi
   419	          echo "OK: install.sh self-SHA mechanism end-to-end validated"
   420	          rm -rf "$SCRATCH"
