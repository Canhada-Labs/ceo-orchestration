   643	      #
   644	      # continue-on-error: ONLY when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 env
   645	      # explicitly set (e.g. legacy rc tags pre-verdict-rollout). Default is
   646	      # hard-block on any validator failure.
   647	      - name: Validate pair-rail verdict (PLAN-081 Phase 6-bis step 15)
   648	        env:
   649	          # Codex iter-8 P1 fix: source the env var from a repository
   650	          # variable so the `continue-on-error` expression has something
   651	          # to evaluate against. Owner sets via `gh variable set
   652	          # CEO_PAIR_RAIL_VERDICT_OPTIONAL --body 1` for transition mode
   653	          # (e.g. legacy v1.16.0-era verdicts shipping only commit_sha:);
   654	          # unset / 0 = hard-block (default).
   655	          CEO_PAIR_RAIL_VERDICT_OPTIONAL: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL || '0' }}
   656	        continue-on-error: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL == '1' }}
   657	        run: |
   658	          set -euo pipefail
   659	          VERDICT_FILE=".claude/governance/pair-rail-verdict-${GITHUB_REF_NAME}.md"
   660	          if [ ! -f "$VERDICT_FILE" ]; then
   661	            if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL:-0}" = "1" ]; then
   662	              echo "::notice::no verdict file at $VERDICT_FILE; CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 → skipping"
   663	              exit 0
   664	            fi
   665	            echo "::error::verdict file missing at $VERDICT_FILE — step 15 blocks release"
   666	            exit 1
   667	          fi
   668	          # S104 redesign: resolve PARENT_SHA = parent of the verdict-file
   669	          # commit. The tag commit (${GITHUB_SHA}) is what we're releasing,
   670	          # and the verdict file at $VERDICT_FILE either:
   671	          #   (a) was committed in the tag commit itself → parent = ${GITHUB_SHA}^
   672	          #   (b) was committed earlier (multi-commit prep) → parent = git log of file
   673	          # We use (b)'s general form: find the commit that introduced the
   674	          # current verdict file, then take its parent. This handles both
   675	          # single-commit-with-verdict and multi-commit-prep flows.
   676	          VERDICT_FILE_COMMIT=$(git log -n1 --format=%H -- "$VERDICT_FILE")
   677	          if [ -z "$VERDICT_FILE_COMMIT" ]; then
   678	            echo "::error::cannot resolve commit for $VERDICT_FILE — step 15 fails"
   679	            exit 1
   680	          fi
   681	          PARENT_SHA=$(git rev-parse "${VERDICT_FILE_COMMIT}^" 2>/dev/null || echo "")
   682	          if [ -z "$PARENT_SHA" ]; then
   683	            echo "::error::cannot resolve parent of $VERDICT_FILE_COMMIT — step 15 fails"
   684	            exit 1
   685	          fi
   686	          echo "::notice::S104 bind: VERDICT_FILE_COMMIT=$VERDICT_FILE_COMMIT, PARENT_SHA=$PARENT_SHA"
   687	          # When transition mode is on, allow parent_sha mismatch (skip bind)
   688	          # by passing empty string. Default is hard-bind on PARENT_SHA.
   689	          PARENT_SHA_ARG="$PARENT_SHA"
   690	          if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL:-0}" = "1" ]; then
   691	            PARENT_SHA_ARG=""
   692	          fi
   693	          python3 .github/scripts/validate-pair-rail-verdict.py \
   694	            --verdict-file "$VERDICT_FILE" \
   695	            --parent-sha "$PARENT_SHA_ARG" \
   696	            --release-tag "${GITHUB_REF_NAME}" \
   697	            --max-age-hours 24 \
   698	            --recompute-inputs-hash \
   699	            --codex-cli-pin-file .claude/governance/codex-cli-pin.txt \
   700	            --codex-cli-binary-sha256-file .claude/governance/codex-cli-binary-sha256.txt \
   701	            --codex-pin-manifest-file .claude/governance/codex-cli-pin-manifest.json \
   702	            --inputs-hash-paths-file .claude/governance/pair-rail-inputs-hash-manifest.txt
