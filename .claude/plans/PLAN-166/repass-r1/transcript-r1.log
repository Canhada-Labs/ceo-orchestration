   278	        working-directory: npm
   279	        # PLAN-158 W1: NO long-lived token — npm >=11.5.1 detects the
   280	        # GitHub Actions OIDC context and mints a short-lived credential
   281	        # against the npmjs trusted-publisher registration (repo
   282	        # Canhada-Labs/ceo-orchestration, workflow npm-publish.yml,
   283	        # environment production-npm). --provenance keeps working (same
   284	        # OIDC JWT feeds Sigstore).
