   146	        run: |
   147	          set -euo pipefail
   148	          RSYNC_EXCLUDES=(
   149	            --include='.claude/policies/fixtures/'
   150	            --include='templates/oidc-proxy/tests/'
   151	            --include='templates/oidc-proxy/tests/**'
   152	            --exclude='**/tests/'
   153	            --exclude='**/fixtures/'
   154	            --exclude='.claude/scripts/red-team-corpus/'
   155	            --exclude='.claude/eval/'
