   290	        # granular NPM_TOKEN in the Owner console, then delete + re-tag
   291	        # (tag runs pin the workflow to the tag's tree — a re-run of the
   292	        # failed run would re-execute the OIDC tree). Full sequence:
   293	        # .claude/plans/PLAN-158/oidc-failure-playbook.md
   294	        run: npm publish --provenance --access public
   295	
   296	      - name: Publish skipped — version already in registry (no-op success)
   297	        if: steps.already_published.outputs.published == 'true'
   298	        run: |
   299	          echo "::notice::publish skipped — exact version already in the registry; this re-run is an idempotent no-op (PLAN-153 Wave B item 5)"

