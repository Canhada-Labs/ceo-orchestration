  2159	    [ -n "$_pts_comp" ] || continue
  2160	    [ "$_pts_comp" = "." ] && continue
  2161	    _pts_cur="$_pts_cur/$_pts_comp"
  2162	    if [ -n "$_pts_relcur" ]; then
  2163	      _pts_relcur="$_pts_relcur/$_pts_comp"
  2164	    else
  2165	      _pts_relcur="$_pts_comp"
  2166	    fi
  2167	    if [ -L "$_pts_cur" ]; then
  2168	      IFS="$_pts_oldIFS"
