   426	          REQUIRED='ts|action|session_id|project|tool|subagent_type|desc_preview|desc_hash|skill|has_profile|has_file_assignment|prompt_len_bucket|response_kind|hook_duration_ms'
   427	          for f in $(echo "$REQUIRED" | tr '|' ' '); do
   428	            if ! grep -q "\"$f\":" .claude/plans/AUDIT-LOG-SCHEMA.md && ! grep -q "\`$f\`" .claude/plans/AUDIT-LOG-SCHEMA.md; then
   429	              echo "::error::v1 agent_spawn field '$f' missing from AUDIT-LOG-SCHEMA.md"
