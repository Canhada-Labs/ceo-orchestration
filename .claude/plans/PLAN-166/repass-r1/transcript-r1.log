    96	            echo "::error::.claude-plugin/plugin.json version ('$PLUGIN_V') does not match VERSION ('$FILE')"
    97	            exit 1
    98	          fi
    99	          echo "OK: plugin.json version=$PLUGIN_V matches VERSION"
