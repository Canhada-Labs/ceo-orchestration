   134	      - name: Stage bundle into npm/
   135	        # The npm package needs the framework source tree relative to npm/.
   136	        # Copy (don't symlink — npm pack walks symlinks unpredictably across hosts).
   137	        # PLAN-152 tarball-01: SELECTIVE staging. The root .npmignore is INERT
