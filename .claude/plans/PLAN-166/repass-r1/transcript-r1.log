   727	TIMESTAMP="$( date +%Y%m%d-%H%M%S )"
   728	BAK_DIR="$TARGET/.claude.bak/$TIMESTAMP"
   729	
   730	IFS=',' read -r -a PROFILE_PARTS <<< "$PROFILE"
   731	
   732	echo "==> Upgrading ceo-orchestration"
   733	echo "    Source:  $SOURCE_DIR"
   734	echo "    Target:  $TARGET"
   735	echo "    Backup:  $BAK_DIR"
   736	echo "    Profile: $PROFILE"
   737	echo "    Stack:   $STACK"
   738	if [[ "$_REPLAY_SOURCE" == "replay" ]]; then
   739	  echo "    Request: replayed from .claude/.install-state.json (PLAN-153 B2)"
   740	fi
   741	if [[ -n "$PIN_REF" ]]; then
   742	  echo "    Pinned:  $PIN_REF"
   743	fi
   744	echo ""
   745	
   746	# PLAN-161 U1: --dry-run must write NOTHING inside the target — eagerly
   747	# creating the (timestamped, thus always-new) backup dir was one of the three
   748	# dry-run-ignoring writer families found live in the 2026-07-21 adopter
   749	# upgrade. Real runs still create it up front (the U3 purge backup and the
   750	# agents-pin backup below rely on it existing).
   751	if [[ "$DRY_RUN" -eq 0 ]]; then
   752	  mkdir -p "$BAK_DIR"
