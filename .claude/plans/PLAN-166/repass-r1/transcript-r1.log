     1	#!/usr/bin/env bash
     2	# verify-counts.sh — PLAN-087 W-F.3 + PLAN-112-FOLLOWUP-claude-md-count-drift —
     3	# README/INSTALL/CLAUDE.md numeric-claim drift detector (bidirectional).
     4	#
     5	# Derives the canonical counts at runtime and compares them to the values
     6	# cited in the framework's top-level docs (CLAUDE.md, README.md, INSTALL.md).
     7	# Reports drift as one violation per line; exits 0 on full parity, 1 on any
     8	# drift.
     9	#
    10	# Usage:
    11	#   bash .claude/scripts/local/verify-counts.sh              # human report + exit code
    12	#   bash .claude/scripts/local/verify-counts.sh --quiet      # exit code only
    13	#   bash .claude/scripts/local/verify-counts.sh --json       # machine-readable JSON
    14	#   bash .claude/scripts/local/verify-counts.sh --no-tests   # skip the slow pytest collect
    15	#
    16	# =====================  COUNT CONTRACT (W1, S160/S161)  =====================
    17	# Each metric below is derived from a single live source of truth and then
    18	# checked against EVERY occurrence in the three docs (all-matches, NOT
    19	# head -1). Two rule kinds:
    20	#   - exact : the doc number MUST equal the live count.
    21	#   - floor : the doc states "N+"; the live count MUST be >= N (so adding a
    22	#             test never churns the docs — AC6).
    23	# The check is BIDIRECTIONAL (a doc number that disagrees with live fails)
    24	# and CROSS-FILE (each doc is checked against the live value, so all docs are
    25	# mutually consistent by transitivity — AC3/AC4).
    26	#
    27	#   metric            live source                                   rule
    28	#   ----------------  --------------------------------------------  -----
    29	#   skills (total)    find .claude/skills -name SKILL.md            exact (166)
    30	#   core skills       find .claude/skills/core -name SKILL.md       exact (42)
    31	#   frontend skills   find .claude/skills/frontend -name SKILL.md   exact (8)
    32	#   domain skills     find .claude/skills/domains -name SKILL.md    exact (116)
    33	#   ADRs              ls .claude/adr/ADR-*.md                        exact (188)
    34	#   hook .py files    ls .claude/hooks/*.py                          exact (57)
    35	#   registered hooks  distinct *.py in settings.json hooks{} tree   exact (46)
    36	#   registrations     total hook entries in settings.json hooks{}   exact (48)
    37	#   _lib modules      ls .claude/hooks/_lib/*.py  (TOP-LEVEL glob)   exact (68)
    38	#   SPEC v1 files     ls SPEC/v1/*.md                                exact (32)
    39	#   tests             pytest --collect-only -q .claude/             floor (N+)
    40	#   release_steps     grep -c '      - name:' release.yml           exact (29)
    41	#   commands          find .claude/commands -name '*.md'             exact (27)
    42	#   workflows         find .github/workflows -name '*.yml'           derived only (no doc cites it — not doc-gated)
    43	#
    44	# NOTE on the two glob-ambiguous / underivable numbers (code-reviewer P2):
    45	#   - "_lib modules" is pinned to the TOP-LEVEL `_lib/*.py` glob (68). The
    46	#     recursive `_lib/**/*.py` count (incl. adapters/ + subdirs) is larger
    47	#     (~140); docs must state the top-level number to match this gate.
    48	#   - "registered hooks" (46) = distinct `*.py` script basenames appearing in
    49	#     command strings of the settings.json hooks{} SUBTREE, parsed as JSON
    50	#     (matches the hook_live_smoke check). S287: the old whole-file grep with
    51	#     a hyphenless regex captured the statusLine `statusline-ceo.py` as a
    52	#     phantom `ceo.py` (47). This is distinct from "hook .py files on disk"
    53	#     (57) — some on-disk hooks are not wired into settings.json — and from
    54	#     "registrations" (48): total hook ENTRIES incl. non-.py commands (one
    55	#     script can fire on several events).
    56	#
    57	# RULE-LIVENESS CONTRACT (S287 vacuous-gate lesson): a metric whose regexes
    58	# match ZERO watched docs reports "no drift" with a number nobody checks —
    59	# a dead gate. The per-metric match count is exported as `rule_matches` in
    60	# --json, and the real-repo test suite asserts every doc-gated metric
    61	# matches >=1 site (test_verify_counts.py). Synthetic test trees are exempt
    62	# by construction (the assertion lives in the real-repo test, not here).
    63	# The historical "6 core hooks" enumeration in CLAUDE.md is a labelled
    64	# historical subset, NOT a live total — it is not gated here.
    65	# ============================================================================
    66	#
    67	# Bash 3.2 portable (macOS default). Doc-parsing delegated to a stdlib-only
    68	# python3 block (python3 is already required for the test-collect step).
    69	
    70	set -euo pipefail
    71	
    72	REPO_ROOT="${VERIFY_COUNTS_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../../.." && pwd)}"
    73	
    74	QUIET=0
    75	JSON=0
    76	NO_TESTS=0
    77	for arg in "$@"; do
    78	  case "$arg" in
    79	    --quiet)    QUIET=1 ;;
    80	    --json)     JSON=1 ;;
    81	    --no-tests) NO_TESTS=1 ;;
    82	    -h|--help)
    83	      sed -n '2,75p' "$0"
    84	      exit 0
    85	      ;;
    86	    *)
    87	      echo "verify-counts.sh: unknown arg: $arg" >&2
    88	      exit 2
    89	      ;;
    90	  esac
    91	done
    92	
    93	# -------------------------- derive canonical counts -------------------------
    94	
    95	DERIVED_SKILLS=$(find "$REPO_ROOT/.claude/skills" -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')
    96	DERIVED_CORE=$(find "$REPO_ROOT/.claude/skills/core" -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')
    97	DERIVED_FRONTEND=$(find "$REPO_ROOT/.claude/skills/frontend" -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')
    98	DERIVED_DOMAIN=$(find "$REPO_ROOT/.claude/skills/domains" -name SKILL.md 2>/dev/null | wc -l | tr -d ' ')
    99	DERIVED_ADRS=$(ls "$REPO_ROOT"/.claude/adr/ADR-*.md 2>/dev/null | wc -l | tr -d ' ')
   100	DERIVED_HOOK_PY=$(ls "$REPO_ROOT"/.claude/hooks/*.py 2>/dev/null | wc -l | tr -d ' ')
   101	# "_lib modules" = importable application modules, which EXCLUDES the
   102	# package marker __init__.py (the docs cite "68 modules, excluding the
   103	# package __init__.py"; the raw glob is 69 incl. __init__.py). Aligns the
   104	# live count to the documented contract (header note: exact 68).
   105	DERIVED_LIB=$( { find "$REPO_ROOT/.claude/hooks/_lib" -maxdepth 1 -name '*.py' ! -name '__init__.py' 2>/dev/null || true; } | wc -l | tr -d ' ')
   106	# Recursive _lib count (E9-F10 i): find descends adapters/ + subdirs. Guard the
   107	# pipeline against set -e/pipefail when the tree has zero matches.
   108	DERIVED_LIB_RECURSIVE=$(
   109	  { find "$REPO_ROOT/.claude/hooks/_lib" -name '*.py' 2>/dev/null || true; } \
   110	    | wc -l | tr -d ' '
   111	)
   112	# Live SPEC VERSION (E9-F10 iii): single source of truth = the VERSION file.
   113	# Trim whitespace/newlines so the string compares cleanly against doc literals.
   114	DERIVED_VERSION=$(tr -d ' \t\n\r' < "$REPO_ROOT/VERSION" 2>/dev/null || true)
   115	DERIVED_SPEC_V1=$(ls "$REPO_ROOT"/SPEC/v1/*.md 2>/dev/null | wc -l | tr -d ' ')
   116	# "schema files" = the *.schema.md subset (excludes README/compat/cli/shim docs).
   117	# Use find (not ls glob) so a zero-match tree does not trip set -e/pipefail.
   118	DERIVED_SCHEMA_FILES=$(find "$REPO_ROOT/SPEC/v1" -maxdepth 1 -name '*.schema.md' 2>/dev/null | wc -l | tr -d ' ')
   119	# Registered hooks (46) + registrations (48) — parsed from the settings.json
   120	# hooks{} SUBTREE as JSON, never a whole-file grep (S287: the old grep +
   121	# hyphenless regex counted the statusLine `statusline-ceo.py` as a phantom
   122	# `ceo.py`). registered = distinct *.py basenames across hook command
   123	# strings (hyphens admitted); registrations = total hook entries (incl.
   124	# non-.py commands). Unparseable settings.json derives 0/0 (a synthetic
   125	# tree citing non-zero then fails loud — fail-closed on input).
   126	_reg_out=$(python3 - "$REPO_ROOT/.claude/settings.json" <<'PYREG' 2>/dev/null
   127	import json, os, re, sys
   128	try:
   129	    s = json.load(open(sys.argv[1], encoding="utf-8"))
   130	except Exception:
   131	    print("0 0"); raise SystemExit(0)
   132	hooks = s.get("hooks", {})
   133	distinct, total = set(), 0
   134	if isinstance(hooks, dict):
   135	    for _event, matchers in hooks.items():
   136	        if not isinstance(matchers, list):
   137	            continue
   138	        for m in matchers:
   139	            if not isinstance(m, dict):
   140	                continue
   141	            for h in m.get("hooks", []):
   142	                if not isinstance(h, dict):
   143	                    continue
   144	                total += 1
   145	                for tok in re.findall(r"[A-Za-z0-9_.-]+\.py", str(h.get("command", ""))):
   146	                    distinct.add(os.path.basename(tok))
   147	print("%d %d" % (len(distinct), total))
   148	PYREG
   149	) || _reg_out="0 0"
   150	DERIVED_REGISTERED=${_reg_out% *}
   151	DERIVED_REGISTRATIONS=${_reg_out#* }
   152	
   153	# Test count: collect-only across .claude/. Collection errors in plan-specific
   154	# fixture suites are tolerated (they don't represent code regressions). The
   155	# collected integer is the load-bearing floor signal.
   156	DERIVED_TESTS=0
   157	if [ "$NO_TESTS" -eq 0 ]; then
   158	  DERIVED_TESTS=$(
   159	    cd "$REPO_ROOT" && \
   160	    python3 -m pytest --collect-only -q .claude/ 2>&1 | \
   161	    awk '/[0-9]+ tests? collected/ {
   162	      for (i = 1; i <= NF; i++) {
   163	        gsub(/\x1b\[[0-9;]*m/, "", $i)
   164	        if ($i ~ /^[0-9]+$/) { print $i; exit }
   165	      }
   166	    }' || true
   167	  )
   168	  DERIVED_TESTS=${DERIVED_TESTS:-0}
   169	fi
   170	
   171	# Release steps = count of "      - name:" lines in release.yml (proper 6-space indent
   172	# distinguishes job-level steps from nested lines). Use grep -c for portability.
   173	DERIVED_RELEASE_STEPS=$(
   174	  grep -c '      - name:' "$REPO_ROOT/.github/workflows/release.yml" 2>/dev/null || echo 0
   175	)
   176	
   177	# Slash-command count = number of *.md files under .claude/commands/
   178	# The || echo 0 guards against find returning non-zero when dir is absent
   179	# (can happen in synthetic test trees that don't create all directories).
   180	DERIVED_COMMANDS=$(
   181	  { find "$REPO_ROOT/.claude/commands" -maxdepth 1 -name '*.md' 2>/dev/null || true; } \
   182	    | wc -l | tr -d ' '
   183	)
   184	
   185	# Workflow count = number of *.yml files under .github/workflows/
   186	DERIVED_WORKFLOWS=$(
   187	  { find "$REPO_ROOT/.github/workflows" -maxdepth 1 -name '*.yml' 2>/dev/null || true; } \
   188	    | wc -l | tr -d ' '
   189	)
   190	
   191	# ADR existence-by-status gate (E9-F10 ii). bash-3.2 portable: no assoc arrays;
   192	# the inventory is space-separated lists + glob-with-[-e]-guard (the canonical
   193	# nullglob-free idiom). Each violation is appended as one newline-terminated
   194	# line and handed to the python3 block via VC_ADR_VIOLATIONS for merge.
   195	ADR_PRESENT_ACCEPTED="127 128 131"   # MUST exist on disk with status: ACCEPTED
   196	ADR_RESERVED_ABSENT="130 134"        # MUST be ABSENT (a file = lifecycle drift)
   197	ADR_VIOLATIONS=""
   198	
   199	_adr_file() {  # echo the first ADR-<n>-*.md path that actually exists, else ""
   200	  local n="$1" hit
   201	  for hit in "$REPO_ROOT"/.claude/adr/ADR-"$n"-*.md; do
   202	    if [ -e "$hit" ]; then printf '%s\n' "$hit"; return 0; fi
   203	  done
   204	  return 0
   205	}
   206	
   207	# The ADR-lifecycle gate is real-repo-specific: it asserts the fixed
   208	# {127,128,131}-present / {130,134}-absent inventory that only the real repo
   209	# (and the E9-F10 remediation test scaffold) carry. A generic synthetic tree
   210	# (e.g. test_verify_counts.py, ADR-000..004) legitimately lacks it — gate it on
   211	# the RESERVED-ADR enumeration being present in CLAUDE.md so it stays robust and
   212	# does not break the existing clean-synthetic-tree contract.
   213	if grep -q 'RESERVED (no file' "$REPO_ROOT/CLAUDE.md" 2>/dev/null; then
   214	for _n in $ADR_PRESENT_ACCEPTED; do
   215	  _f=$(_adr_file "$_n")
   216	  if [ -z "$_f" ]; then
   217	    ADR_VIOLATIONS="${ADR_VIOLATIONS}adr_lifecycle: ADR-${_n} expected present with status: ACCEPTED, but NO file on disk
   218	"
   219	  elif ! grep -qiE '^status:[[:space:]]*ACCEPTED' "$_f"; then
   220	    ADR_VIOLATIONS="${ADR_VIOLATIONS}adr_lifecycle: ADR-${_n} present but its status: frontmatter is not ACCEPTED
   221	"
   222	  fi
   223	done
   224	for _n in $ADR_RESERVED_ABSENT; do
   225	  _f=$(_adr_file "$_n")
   226	  if [ -n "$_f" ]; then
   227	    ADR_VIOLATIONS="${ADR_VIOLATIONS}adr_lifecycle: ADR-${_n} is a RESERVED slot and MUST be ABSENT on disk, but a file exists (presence = drift)
   228	"
   229	  fi
   230	done
   231	fi
   232	
   233	# -------------------------- bidirectional doc check -------------------------
   234	# Delegated to a stdlib python3 block: reads the 3 docs, applies the
   235	# all-matches exact/floor rules, prints violations, exits 1 on any drift.
   236	
   237	export VC_REPO_ROOT="$REPO_ROOT"
   238	export VC_SKILLS="$DERIVED_SKILLS" VC_CORE="$DERIVED_CORE" VC_FRONTEND="$DERIVED_FRONTEND"
   239	export VC_DOMAIN="$DERIVED_DOMAIN" VC_ADRS="$DERIVED_ADRS" VC_HOOK_PY="$DERIVED_HOOK_PY"
   240	export VC_LIB="$DERIVED_LIB" VC_SPEC="$DERIVED_SPEC_V1" VC_REGISTERED="$DERIVED_REGISTERED"
   241	export VC_REGISTRATIONS="$DERIVED_REGISTRATIONS"
   242	export VC_SCHEMA="$DERIVED_SCHEMA_FILES"
   243	export VC_TESTS="$DERIVED_TESTS" VC_QUIET="$QUIET" VC_JSON="$JSON" VC_NO_TESTS="$NO_TESTS"
   244	export VC_RELEASE_STEPS="$DERIVED_RELEASE_STEPS" VC_COMMANDS="$DERIVED_COMMANDS"
   245	export VC_WORKFLOWS="$DERIVED_WORKFLOWS"
   246	export VC_LIB_RECURSIVE="$DERIVED_LIB_RECURSIVE" VC_VERSION="$DERIVED_VERSION"
   247	export VC_ADR_VIOLATIONS="$ADR_VIOLATIONS"
   248	# Inventory echoed so the python3 block can assert CLAUDE.md's RESERVED list.
   249	export VC_ADR_RESERVED_ABSENT="$ADR_RESERVED_ABSENT"
   250	
   251	python3 - <<'PYEOF'
   252	import os, re, json, sys
   253	
   254	root = os.environ["VC_REPO_ROOT"]
   255	def iv(k): return int(os.environ.get(k, "0") or "0")
   256	live = {
   257	    "skills": iv("VC_SKILLS"), "core": iv("VC_CORE"), "frontend": iv("VC_FRONTEND"),
   258	    "domain": iv("VC_DOMAIN"), "adrs": iv("VC_ADRS"), "hook_py": iv("VC_HOOK_PY"),
   259	    "lib": iv("VC_LIB"), "spec_v1": iv("VC_SPEC"), "registered": iv("VC_REGISTERED"),
   260	    "registrations": iv("VC_REGISTRATIONS"),
   261	    "schema_files": iv("VC_SCHEMA"),
   262	    "tests": iv("VC_TESTS"),
   263	    "release_steps": iv("VC_RELEASE_STEPS"),
   264	    "commands": iv("VC_COMMANDS"),
   265	    "workflows": iv("VC_WORKFLOWS"),
   266	    "lib_recursive": iv("VC_LIB_RECURSIVE"),
   267	}
