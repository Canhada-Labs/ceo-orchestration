   361	      - name: Validate install.sh self-SHA mechanism (P0-15, PLAN-045)
   362	        # PLAN-045 F-15R2-01 / Session 41: end-to-end validation that
   363	        # the install.sh self-SHA verification works. We (a) confirm the
   364	        # placeholder is still present (source checkout state), (b) compute
   365	        # the expected sha, (c) substitute it into a temp copy, (d) run the
   366	        # temp copy — self-verify passes → rc=1 (usage exit, not rc=5).
   367	        run: |
   368	          set -euo pipefail
   369	          FILE="scripts/install.sh"
   370	          # (a) Placeholder must be present in source tree.
