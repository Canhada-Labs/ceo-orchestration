   174	      - name: Syntax-check the shim
   175	        run: node --check npm/bin/ceo-orch-init.js
   176	
   177	      - name: Verify scripts/install.sh is present in staged bundle
   178	        run: test -f npm/scripts/install.sh
   179	
   180	      - name: Populate install.sh self-SHA trailer (P0-15, PLAN-045)
   181	        # PLAN-045 F-15R2-01 / Session 41: install.sh ships with a
   182	        # `# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL` trailer as its
   183	        # last line. At publish time, compute sha256 of the script body
   184	        # (all lines EXCEPT the last) and substitute the placeholder with
   185	        # the real hex. The script's own self-verify logic reads the same
   186	        # last-line pattern, so downstream adopters running
   187	        # `bash install.sh ...` trigger a rc=5 fail-CLOSED if the script
   188	        # is modified in transit.
   189	        working-directory: npm
   190	        run: |
   191	          set -euo pipefail
   192	          FILE="scripts/install.sh"
   193	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   194	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   195	            echo "::error::$FILE trailer not at expected placeholder state"
   196	            echo "got: $TRAILER_LINE"
   197	            exit 1
   198	          fi
   199	          # Compute sha of everything EXCEPT the last line.
   200	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
   201	          # In-place substitute ONLY the last line.
   202	          awk -v hash="$HASH" '
   203	            NR == FNR { total = NR; next }
   204	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   205	            { print }
   206	          ' "$FILE" "$FILE" > "$FILE.new"
   207	          mv "$FILE.new" "$FILE"
   208	          chmod +x "$FILE"
   209	          # Smoke-verify: execute the self-verify branch by running
   210	          # the script without args (hits _verify_self_sha, then usage).
   211	          bash "$FILE" 2>&1 | head -3 || true
   212	          echo "OK: install.sh trailer populated with sha256 $HASH"
   213	
   214	      - name: Packlist gate (PLAN-152 tarball-02)
   215	        # Last-line assert before publish: the would-be tarball must carry no
   216	        # tests/ or fixtures/ dirs (except .claude/policies/fixtures/, shipped
   217	        # by install.sh contract), no .claude/eval/, no red-team-corpus/, no
   218	        # .claude/plans/PLAN-<N>* artifacts, no _lib/testing.py or
   219	        # _lib/test_isolation.py. Fail-closed: a pack or JSON parse failure
   220	        # fails the job (set -euo pipefail).
   221	        working-directory: npm
   222	        run: |
   223	          set -euo pipefail
   224	          npm pack --dry-run --json 2>/dev/null | python3 -c '
   225	          import json, re, sys
   226	          d = json.load(sys.stdin)
   227	          o = d[0] if isinstance(d, list) else d
   228	          paths = [f["path"] for f in o["files"]]
   229	          pat = re.compile(r"(^|/)(tests|fixtures)(/|$)|(^|/)eval/|(^|/)red-team-corpus/|(^|/)plans/PLAN-[0-9]|(^|/)_lib/(testing|test_isolation)\.py$")
   230	          allow = (".claude/policies/fixtures/", "templates/oidc-proxy/tests/")
   231	          bad = [p for p in paths if pat.search(p) and not p.startswith(allow)]
   232	          if bad:
   233	              print("::error::tarball would ship %d framework-internal artifact(s):" % len(bad))
   234	              print("\n".join(bad[:40]))
   235	              sys.exit(1)
   236	          print("OK: packlist clean — %d files" % len(paths))
   237	          '
