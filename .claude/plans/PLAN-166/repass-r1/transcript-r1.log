    37	#   --stable         target v1.2.0 instead of v1.2.0-rc.N (post-hold promote)
    38	#   --rc N           RC ordinal (default 1)
    39	#   --key KEYID      GPG key to sign with (default: the key that signed v1.1.0)
    40	#   --npm-readme-reviewed
    41	#                    required by `bump`: acknowledges that npm/README.md was
    42	#                    actually re-read. Its "last-reviewed" stamp is a release
    43	#                    tripwire by design; re-stamping it silently would defeat
    44	#                    the gate.
    45	# ============================================================================
    46	set -euo pipefail
    47	
    48	TARGET_BASE="1.3.0"
    49	RC_NUM="1"
    50	STABLE=0
    51	DRY_RUN=0
    52	NPM_README_REVIEWED=0
    53	PHASE=""
    54	
    55	# Every file the bump phase may write. Load-bearing for the dry-run trap:
    56	# a restore list shorter than the write list leaves debris behind.
    57	VERSION_FILES=(
    58	  "VERSION"
    59	  "npm/package.json"
    60	  "pyproject.toml"
    61	  "INSTALL.md"
    62	  "docs/ARCHITECTURE.md"
    63	  "npm/README.md"
    64	  "README.md"
    65	  "SBOM.md"
    66	  "SECURITY.md"
    67	  "VERSIONING.md"
    68	  ".claude-plugin/plugin.json"
    69	  ".claude-plugin/marketplace.json"
    70	)
    71	# Continuity: the key that signed v1.1.0. Overridable, but never guessed at
    72	# signing time — the preflight proves it can actually produce a signature.
    73	SIGN_KEY="CFCFACF00335DC74"
    74	
    75	die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
    76	ok()  { printf '  ok   %s\n' "$*"; }
    77	note(){ printf '  --   %s\n' "$*"; }
    78	hdr() { printf '\n== %s ==\n' "$*"; }
    79	
    80	while [ "$#" -gt 0 ]; do
    81	  case "$1" in
    82	    preflight|bump|tag) PHASE="$1"; shift ;;
    83	    --dry-run) DRY_RUN=1; shift ;;
    84	    --stable)  STABLE=1; shift ;;
    85	    --npm-readme-reviewed) NPM_README_REVIEWED=1; shift ;;
    86	    --rc)      RC_NUM="${2:?--rc needs a number}"; shift 2 ;;
    87	    --key)     SIGN_KEY="${2:?--key needs a keyid}"; shift 2 ;;
    88	    -h|--help) sed -n '2,40p' "$0"; exit 0 ;;
    89	    *) die "unknown argument: $1" ;;
    90	  esac
    91	done
    92	[ -n "$PHASE" ] || die "no phase given (preflight|bump|tag); see --help"
    93	
    94	if [ "$STABLE" -eq 1 ]; then
    95	  TARGET_VERSION="$TARGET_BASE"
    96	else
    97	  TARGET_VERSION="${TARGET_BASE}-rc.${RC_NUM}"
    98	fi
    99	TARGET_TAG="v${TARGET_VERSION}"
   100	
   101	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo"
   102	cd "$REPO_ROOT"
   103	
   104	# GPG in a non-interactive shell needs an explicit TTY or pinentry fails with
   105	# a misleading "No pinentry" (recurring footgun in this repo's ceremonies).
   106	GPG_TTY="$(tty 2>/dev/null || true)"
   107	export GPG_TTY
   108	
   109	printf 'release driver — target %s (tag %s), phase=%s, dry-run=%s\n' \
   110	  "$TARGET_VERSION" "$TARGET_TAG" "$PHASE" "$DRY_RUN"
   111	
   112	# ---------------------------------------------------------------------------
   113	# Dry-run safety net. Snapshot the two files the `bump` phase writes plus the
   114	# index state, and restore both on ANY exit path. A dry-run that leaves staged
   115	# deletions behind has bitten this repo before (S273).
   116	# ---------------------------------------------------------------------------
   117	SNAPSHOT_ARMED=0
   118	restore_snapshot() {
   119	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   120	  # The bump phase refuses to run on a dirty tree, so HEAD is exactly the
   121	  # pre-bump state: reset unstages, checkout restores content. Both halves are
   122	  # needed — an index-only restore leaves the files modified, and a
   123	  # content-only restore leaves them staged (the S273 trap).
   124	  git reset --quiet HEAD -- "${VERSION_FILES[@]}" 2>/dev/null || true
   125	  git checkout --quiet -- "${VERSION_FILES[@]}" 2>/dev/null || true
   126	  printf '  --   dry-run: working tree AND index restored to HEAD\n'
   127	}
   128	
   129	take_snapshot() {
   130	  SNAPSHOT_ARMED=1
   131	  trap restore_snapshot EXIT INT TERM
   132	}
   133	
   134	# ---------------------------------------------------------------------------
   135	# Preflight — every gate fail-closed. Mirrors `.github/release-checklist.md`
   136	# §Pré-tag and runs the SAME suites CI runs (a subset gate passes while CI is
   137	# red; that lesson is expensive and already paid).
   138	# ---------------------------------------------------------------------------
   139	preflight() {
   140	  hdr "git state"
   141	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — commit or stash first"
   142	  ok "tree clean"
   143	
   144	  branch="$(git rev-parse --abbrev-ref HEAD)"
   145	  [ "$branch" = "main" ] || die "on branch '$branch' — releases are cut from main"
   146	  ok "on main"
   147	
   148	  git fetch --quiet origin main || die "git fetch origin main failed"
   149	  local_sha="$(git rev-parse HEAD)"
   150	  remote_sha="$(git rev-parse origin/main)"
   151	  [ "$local_sha" = "$remote_sha" ] \
   152	    || die "HEAD ($local_sha) != origin/main ($remote_sha) — push or pull first"
   153	  ok "HEAD == origin/main ($local_sha)"
   154	
   155	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   156	    && die "tag $TARGET_TAG already exists"
   157	  ok "tag $TARGET_TAG is free"
   158	
   159	  hdr "CI for HEAD"
   160	  if command -v gh >/dev/null 2>&1; then
   161	    runs="$(gh run list --limit 40 \
   162	      --json headSha,conclusion,status,workflowName 2>/dev/null || true)"
   163	    if [ -n "$runs" ]; then
   164	      verdict="$(mktemp)"
   165	      printf '%s' "$runs" | HEAD_SHA="$local_sha" python3 -c '
   166	import json, os, sys
   167	sha = os.environ["HEAD_SHA"]
   168	runs = [r for r in json.load(sys.stdin) if r.get("headSha") == sha]
   169	if not runs:
   170	    print("NO_RUNS"); sys.exit(0)
   171	bad = [r for r in runs if r.get("conclusion") not in ("success", "skipped", "")]
   172	pend = [r for r in runs if r.get("status") != "completed"]
   173	val = [r for r in runs if "Validate" in (r.get("workflowName") or "")]
   174	for r in bad:
   175	    print("BAD %s=%s" % (r["workflowName"], r["conclusion"]))
   176	for r in pend:
   177	    print("PENDING %s" % r["workflowName"])
   178	if not any(r.get("conclusion") == "success" for r in val):
   179	    print("NO_VALIDATE_SUCCESS")
   180	' > "$verdict" || die "CI verdict parse failed"
   181	      if grep -q '^BAD ' "$verdict"; then
   182	        cat "$verdict" >&2; rm -f "$verdict"
   183	        die "a workflow for HEAD is not green"
   184	      fi
   185	      if grep -q '^PENDING ' "$verdict"; then
   186	        cat "$verdict" >&2; rm -f "$verdict"
   187	        die "a workflow for HEAD is still running — wait for it"
   188	      fi
   189	      if grep -q 'NO_VALIDATE_SUCCESS' "$verdict"; then
   190	        rm -f "$verdict"
   191	        die "no successful Validate run for HEAD"
   192	      fi
   193	      if grep -q 'NO_RUNS' "$verdict"; then
   194	        rm -f "$verdict"
   195	        die "no CI runs found for HEAD — push it and let CI run"
   196	      fi
   197	      rm -f "$verdict"
   198	      ok "all workflows for HEAD green (Validate success)"
   199	    else
   200	      die "gh returned no run data — cannot confirm CI (fail-closed)"
   201	    fi
   202	  else
   203	    die "gh CLI not available — cannot confirm CI (fail-closed)"
   204	  fi
   205	
   206	  # These MUST be the invocations validate.yml uses (:341-342, :424-425), not
   207	  # `unittest discover`. The suite is pytest-only BY CONSTRUCTION: conftest.py
   208	  # carries the sys.path bootstrap and the _lib resolution guards as pytest
   209	  # collection hooks, and several modules isolate their environment with
   210	  # pytest `autouse` fixtures. `unittest discover` loads none of that, so those
   211	  # modules run with their declared isolation silently disabled — which leaks
   212	  # CLAUDE_PROJECT_DIR into later modules. test_flip_closures then resolves
   213	  # settings.json / red-team.yml under a dead tmp dir and reports that files
   214	  # which plainly exist "must exist". It passes 12/12 when run alone.
   215	  # Diagnosed 2026-08-02 during the v1.2.0 GA promote; the old invocation made
   216	  # this gate a FALSE RED that blocked a release whose CI was green.
   217	  hdr "test suites (the same ones CI runs)"
   218	  python3 -m pytest .claude/hooks/tests/ -n auto -m 'not serial' \
   219	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   220	    || die "hooks test suite failed (not serial)"
   221	  python3 -m pytest .claude/hooks/tests/ -m 'serial' \
   222	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   223	    || die "hooks test suite failed (serial)"
   224	  ok "hooks tests pass"
   225	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   226	    -n auto -m 'not serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   227	    || die "scripts test suite failed (not serial)"
   228	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   229	    -m 'serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   230	    || die "scripts test suite failed (serial)"
   231	  ok "scripts tests pass"
   232	
   233	  hdr "governance gates"
   234	  bash .claude/scripts/validate-governance.sh >/dev/null 2>&1 \
   235	    || die "validate-governance.sh nonzero"
   236	  ok "validate-governance"
   237	  bash .claude/scripts/check-contamination.sh >/dev/null 2>&1 \
   238	    || die "check-contamination.sh nonzero"
   239	  ok "check-contamination"
   240	  python3 .claude/scripts/check-claude-md-claims.py >/dev/null 2>&1 \
   241	    || die "check-claude-md-claims.py nonzero"
   242	  ok "CLAUDE.md claims"
   243	  bash .claude/scripts/local/verify-counts.sh --quiet >/dev/null 2>&1 \
   244	    || die "verify-counts.sh reports drift"
   245	  ok "derived counts (no drift)"
   246	
   247	  hdr "release artifacts"
   248	  grep -q "^## \[${TARGET_BASE}\]" CHANGELOG.md \
   249	    || die "CHANGELOG.md has no '## [${TARGET_BASE}]' entry"
   250	  ok "CHANGELOG has [${TARGET_BASE}]"
   251	
   252	  # The two gates that burned rc.1 and rc.2 — release.yml enforces both and
   253	  # neither is covered by verify-counts, so the preflight mirrors them:
   254	  python3 scripts/build-plugin.py --check >/dev/null 2>&1 \
   255	    || die "plugin manifests out of sync (run: python3 scripts/build-plugin.py --write-manifests) — this is what killed v1.2.0-rc.1"
   256	  ok "plugin manifests in sync with generator"
   257	  python3 .claude/scripts/check-canonical-doc-freshness.py >/dev/null 2>&1 \
   258	    || {
   259	      python3 .claude/scripts/check-canonical-doc-freshness.py 2>&1 | grep '!!' >&2 || true
   260	      die "canonical doc freshness gate red (stale last-reviewed stamps; review + re-stamp the docs listed above) — this is what killed v1.2.0-rc.2"
   261	    }
   262	  ok "canonical doc freshness (review stamps current)"
   263	
   264	  cur_version="$(tr -d ' \n' < VERSION)"
   265	  if [ "$cur_version" = "$TARGET_BASE" ]; then
   266	    note "VERSION already $TARGET_BASE — bump phase is a no-op (expected on promote)"
   267	  else
   268	    note "VERSION is $cur_version, becomes $TARGET_BASE in the bump phase (6 sites)"
   269	  fi
   270	
   271	  hdr "signing key (proves it can actually sign — not just that it exists)"
   272	  gpg --list-secret-keys "$SIGN_KEY" >/dev/null 2>&1 \
   273	    || die "no secret key $SIGN_KEY in the keyring"
   274	  ok "secret key $SIGN_KEY present"
   275	  sig_probe="$(mktemp)"
   276	  if printf 'release-preflight-probe' \
   277	      | gpg --local-user "$SIGN_KEY" --armor --detach-sign --output "$sig_probe" \
   278	        >/dev/null 2>&1; then
   279	    ok "inline signature probe succeeded (pinentry works)"
   280	  else
   281	    rm -f "$sig_probe"
   282	    die "the key cannot sign right now — try: gpgconf --kill gpg-agent; export GPG_TTY=\$(tty)"
   283	  fi
   284	  rm -f "$sig_probe"
   285	
   286	  printf '\nPREFLIGHT GREEN for %s\n' "$TARGET_TAG"
   287	}
   288	
   289	# ---------------------------------------------------------------------------
   290	# Bump — SIX version sites, not two.
   291	#
   292	# `verify-counts.sh` enforces exact version equality across VERSION,
   293	# npm/package.json, pyproject.toml, INSTALL.md, docs/ARCHITECTURE.md and
   294	# npm/README.md (`:384-421`). The release checklist mentions only VERSION,
   295	# which is how a manual bump silently misses pyproject + the three docs — the
   296	# `bump --dry-run` of this script is what surfaced that.
   297	#
   298	# The version written is always the BARE semver ($TARGET_BASE), never
   299	# `1.2.0-rc.1`. Two independent reasons: (a) precedent — `v1.1.0-rc.1` and
   300	# `v1.0.1-rc.1` both carry the bare version in VERSION, the RC lives only in
   301	# the tag name; (b) every gate regex matches `\d+\.\d+\.\d+` only, so an
   302	# `-rc.N` string would match NOTHING and the gate would pass VACUOUSLY —
   303	# silently stopping the drift check exactly when it matters most.
   304	#
   305	# Regex-targeted (never a blanket 1.1.0 -> 1.2.0 sweep): the anchored patterns
   306	# below are copied from verify-counts' own sites, so historical version
   307	# mentions in CHANGELOG entries and docs are left untouched.
   308	# ---------------------------------------------------------------------------
   309	bump() {
   310	  hdr "bump version sites to $TARGET_BASE"
   311	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to bump"
   312	
   313	  [ "$DRY_RUN" -eq 1 ] && take_snapshot
   314	
   315	  # The npm/README.md stamp is a DELIBERATE release tripwire: its date+version
   316	  # line asserts the npm-facing copy was re-read for this release. Re-stamping
   317	  # it silently would defeat the gate's whole purpose, so it takes an explicit
   318	  # acknowledgement.
   319	  if [ "$NPM_README_REVIEWED" -eq 0 ]; then
   320	    cat >&2 <<'EOF'
   321	FAIL: npm/README.md carries a "last-reviewed: <date> v<version>" stamp, and
   322	      verify-counts treats it as a release tripwire — bumping it asserts that
   323	      the npm-facing README was actually re-read for this release.
   324	
   325	      Read npm/README.md, then re-run with --npm-readme-reviewed.
   326	EOF
   327	    exit 1
   328	  fi
   329	
   330	  TARGET_BASE="$TARGET_BASE" python3 - <<'PY' || die "version-site bump failed"
   331	import os, re, sys, datetime
   332	
   333	target = os.environ["TARGET_BASE"]
   334	today = datetime.date.today().isoformat()
   335	SEMVER = r'\d+\.\d+\.\d+'
   336	
   337	# (path, pattern, replacement) — patterns anchored exactly as verify-counts
   338	# checks them, so nothing else in the file can be touched.
   339	SITES = [
   340	    ("VERSION", r'\A\s*' + SEMVER + r'\s*\Z', target + "\n"),
   341	    ("npm/package.json", r'("version"\s*:\s*")' + SEMVER + r'(")', r'\g<1>' + target + r'\g<2>'),
   342	    ("pyproject.toml", r'(?m)^(version\s*=\s*")' + SEMVER + r'(")', r'\g<1>' + target + r'\g<2>'),
   343	    ("INSTALL.md", r'(--pin v)' + SEMVER, r'\g<1>' + target),
   344	    ("docs/ARCHITECTURE.md",
   345	     r'(currently\s+v)' + SEMVER + r'(, aligned with the repo)',
   346	     r'\g<1>' + target + r'\g<2>'),
   347	    ("npm/README.md",
   348	     r'(last-reviewed: )\d{4}-\d{2}-\d{2} v' + SEMVER,
   349	     r'\g<1>' + today + ' v' + target),
   350	    # Present in the watched list but currently has no such literal; a zero
   351	    # match here is fine — verify-counts is the oracle, not this table.
   352	    ("README.md", r'(VERSION=)' + SEMVER, r'\g<1>' + target),
   353	    # S293 (codex re-pass v1.3.0-rc.1, P1): os três sites que ficaram stale
   354	    # no bump 1.3.0 porque não estavam NEM aqui NEM no verify-counts (a
   355	    # classe unwatched-doc de S291). Agora estão nos DOIS. SBOM declara o
   356	    # triple + stamp; SECURITY/VERSIONING têm stamp mecânico aqui e a
   357	    # JANELA de suporte (vX.Y.x Current/Previous) fica MANUAL de propósito —
   358	    # o shift Previous<-Current pede juízo de release-train; o verify-counts
   359	    # (família minor) falha ALTO se esquecida, que é o contrato.
   360	    ("SBOM.md", r'(\*\*Version:\*\* `)' + SEMVER + r'(`)', r'\g<1>' + target + r'\g<2>'),
   361	    ("SBOM.md", r'(last-reviewed: )\d{4}-\d{2}-\d{2}( v)' + SEMVER,
   362	     r'\g<1>' + today + r'\g<2>' + target),
   363	    ("SECURITY.md", r'(last-reviewed: )\d{4}-\d{2}-\d{2}( v)' + SEMVER,
   364	     r'\g<1>' + today + r'\g<2>' + target),
   365	    ("VERSIONING.md", r'(last-reviewed: )\d{4}-\d{2}-\d{2}( v)' + SEMVER,
   366	     r'\g<1>' + today + r'\g<2>' + target),
   367	]
   368	
   369	for path, rx, repl in SITES:
   370	    try:
   371	        src = open(path, encoding="utf-8").read()
   372	    except OSError:
   373	        print("  --   %s absent, skipped" % path)
   374	        continue
   375	    new, n = re.subn(rx, repl, src)
   376	    if n == 0:
   377	        print("  --   %s: no version site found (ok if unwatched)" % path)
   378	        continue
   379	    if new != src:
   380	        open(path, "w", encoding="utf-8").write(new)
   381	    print("  ok   %s (%d site%s -> %s)" % (path, n, "" if n == 1 else "s", target))
   382	PY
   383	
   384	  # Plugin manifests (.claude-plugin/{plugin,marketplace}.json) are GENERATED
   385	  # from VERSION, never hand-patched. release.yml's "Assert plugin manifest
   386	  # versions match VERSION" gate enforces them — and verify-counts does NOT,
   387	  # which is exactly how the v1.2.0-rc.1 run went red: the manifests were the
   388	  # seventh and eighth version sites, invisible to the local oracle.
   389	  python3 scripts/build-plugin.py --write-manifests >/dev/null 2>&1 \
   390	    || die "build-plugin.py --write-manifests failed"
   391	  python3 scripts/build-plugin.py --check >/dev/null 2>&1 \
   392	    || die "plugin manifests still out of sync with the generator"
   393	  ok "plugin manifests regenerated from VERSION (build-plugin.py)"
   394	
   395	  # verify-counts covers the six doc/package sites above; release.yml's gate
   396	  # family covers the plugin manifests. NEITHER alone is the full oracle — the
   397	  # union is. If a new site is added upstream, expect it to surface in one of
   398	  # these two, and mirror it here.
   399	  bash .claude/scripts/local/verify-counts.sh --quiet --no-tests >/dev/null 2>&1 \
   400	    || {
   401	      bash .claude/scripts/local/verify-counts.sh --json --no-tests 2>&1 \
   402	        | python3 -c 'import json,sys
   403	d = json.load(sys.stdin)
   404	for v in d.get("violations", []):
   405	    print("  !!   " + v, file=sys.stderr)' || true
   406	      die "verify-counts still reports version drift — a site is unpatched (see above)"
   407	    }
   408	  ok "verify-counts clean across the doc/package version sites"
   409	
   410	  if [ "$DRY_RUN" -eq 1 ]; then
   411	    git --no-pager diff --stat || true
   412	    note "dry-run: no commit made"
   413	    return 0
   414	  fi
   415	
   416	  git add -A
   417	  # S293 (codex re-pass r4, P1): IDEMPOTÊNCIA. Se a árvore já está na versão
   418	  # alvo (bump feito à mão, ou `bump` re-rodado), não há nada staged e um
   419	  # `git commit` incondicional MORRE — o caminho documentado de três fases
   420	  # ficaria inexecutável exatamente quando os gates já estão verdes. Um
   421	  # bump sem-mudança é SUCESSO (a pós-condição "árvore na versão alvo"
   422	  # está satisfeita), não falha. Os gates acima já provaram a coerência.
   423	  if git diff --cached --quiet; then
   424	    ok "nothing to commit — tree already at ${TARGET_BASE} (idempotent no-op)"
   425	    # `${STABLE:+...}` expande com STABLE=0 (string nao-vazia) e mandaria
   426	    # o Owner cortar a tag STABLE numa run de RC. Teste o VALOR.
   427	    if [ "$STABLE" -eq 1 ]; then
   428	      note "proceed to: bash $0 tag --stable"
   429	    else
   430	      note "proceed to: bash $0 tag --rc $RC_NUM"
   431	    fi
   432	    return 0
   433	  fi
   434	  git commit -q -m "release: v${TARGET_BASE}
   435	
   436	Version bump across every site verify-counts enforces (VERSION,
   437	npm/package.json, pyproject.toml, INSTALL.md, docs/ARCHITECTURE.md,
   438	npm/README.md review stamp, SBOM.md, and the SECURITY/VERSIONING review
   439	stamps) for ${TARGET_TAG}.
   440	
   441	VERSION carries the BARE semver: the RC lives only in the tag name, matching
   442	v1.1.0-rc.1 / v1.0.1-rc.1. An -rc.N string in VERSION would match none of the
   443	gate's \\d+.\\d+.\\d+ patterns and the drift check would pass vacuously.
   444	
   445	CHANGELOG entry [${TARGET_BASE}] landed separately; its counts are
   446	reproducible via .claude/scripts/local/verify-counts.sh."
   447	  ok "commit $(git rev-parse --short HEAD)"
   448	}
   449	
   450	# ---------------------------------------------------------------------------
   451	# Tag — annotated + GPG-signed INLINE. The tag message is the Owner-visible
   452	# artifact; `release.yml` triggers on `push: tags: v*`.
   453	# ---------------------------------------------------------------------------
   454	tag() {
   455	  hdr "sign tag $TARGET_TAG"
   456	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to tag"
   457	
   458	  # VERSION carries the BARE semver even for an RC tag (see the bump header),
   459	  # so compare against $TARGET_BASE, never $TARGET_VERSION.
   460	  cur_version="$(tr -d ' \n' < VERSION)"
   461	  [ "$cur_version" = "$TARGET_BASE" ] \
   462	    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
   463	  ok "VERSION ($cur_version) matches the tag's base version"
   464	
   465	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   466	    && die "tag $TARGET_TAG already exists"
   467	
   468	  anchor="$(git rev-parse HEAD)"
   469	  # S293 (codex re-pass r3, P1): a anotação é ASSINADA — descrever a release
