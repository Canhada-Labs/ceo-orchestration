   907	def check_tier_a_lessons_30d() -> Tuple[str, str, Any]:
   908	    """Count lessons added in memory dir over 30d (informational)."""
   909	    # Derive the Claude Code project slug from the project dir (absolute path
   910	    # with "/" -> "-") instead of hard-coding the meta-repo's slug, so this
   911	    # resolves correctly in any install. (Previously hard-coded the Owner's
