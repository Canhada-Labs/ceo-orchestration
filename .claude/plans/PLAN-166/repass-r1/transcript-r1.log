   913	    # contamination guard.)
   914	    project_dir = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
   915	    slug = str(Path(project_dir).resolve()).replace("/", "-")
   916	    mem_dir = Path.home() / ".claude" / "projects" / slug / "memory"
   917	    if not mem_dir.exists():
   918	        return "green", "memory dir absent", 0
   919	    cutoff = time.time() - 30 * 86400
   920	    n = 0
