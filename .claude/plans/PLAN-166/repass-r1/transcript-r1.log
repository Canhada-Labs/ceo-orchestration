   438	      #
   439	      # Before a tag ships, assert that recent runs of the six advisory
   440	      # workflows (chaos, otel-smoke, perf-profile, adapter-live,
   640	      #   - verdict generated_at within 24h (TTL per ADR-103)
   641	      #   - inputs_hash deterministically recomputed via inputs-hash-manifest.txt
