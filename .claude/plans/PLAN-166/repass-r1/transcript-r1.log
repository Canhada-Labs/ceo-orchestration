    72	      # -----------------------------------------------------------------
    73	      # PLAN-153 Wave B item 5 (e) — version↔plugin-manifest sync, kept
    74	      # NEXT TO the VERSION↔tag assert above so the whole
    75	      # version-consistency family lives in one place.
