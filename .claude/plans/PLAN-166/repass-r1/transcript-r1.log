   765	      # -----------------------------------------------------------------
   766	      # PLAN-153 Wave B item 5 (b) — idempotent release creation
   767	      # (`gh release view || gh release create`). A re-run of this job
   768	      # (workflow re-run, transient asset-upload failure) must not fail
   769	      # on an existing release: if the release already exists we
   770	      # re-sync the assets with `--clobber` and succeed-as-noop —
   771	      # covering the partial-failure case where `gh release create`
   772	      # made the release but died mid-asset-upload.
   773	      # RC tags (which reach this job since the RC-aware VERSION gate
   774	      # fix) are marked --prerelease so they never show as "Latest".
   775	      # NOTE: bash arrays are fine here — this runs on ubuntu-latest
   776	      # (bash 5); the bash-3.2 house rule applies to adopter-machine
   777	      # scripts (install.sh), and release.yml already uses arrays in
   778	      # the weekly-workflow gate (WORKFLOWS=(...)).
   779	      # -----------------------------------------------------------------
   780	      - name: Create GitHub Release with assets (idempotent)
   781	        env:
   782	          GH_TOKEN: ${{ github.token }}
   783	        run: |
   784	          set -euo pipefail
   785	          TAG="${GITHUB_REF_NAME}"
   786	          if gh release view "$TAG" >/dev/null 2>&1; then
   787	            echo "::notice::release $TAG already exists — idempotent re-run; re-syncing assets with --clobber instead of create"
   788	            gh release upload "$TAG" --clobber install.sh.sha256 sbom.cyclonedx.json
   789	            exit 0
   790	          fi
   791	          CREATE_ARGS=(--verify-tag --title "$TAG" --notes-file release-notes.md)
   792	          if [[ "$TAG" == *-rc.* ]]; then
   793	            CREATE_ARGS+=(--prerelease)
   794	          fi
   795	          gh release create "$TAG" "${CREATE_ARGS[@]}" install.sh.sha256 sbom.cyclonedx.json

