   271	          else
   272	            echo "published=false" >> "$GITHUB_OUTPUT"
   273	            echo "OK: ${PKG_NAME}@${PKG_VERSION} not in registry (rc=$RC) — proceeding to publish"
   274	          fi
   275	
   276	      - name: Publish (Trusted Publishing — OIDC)
