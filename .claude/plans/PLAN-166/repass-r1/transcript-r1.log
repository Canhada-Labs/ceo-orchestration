   625	# present + valid, request.profile / request.stack become the DEFAULTS for
   626	# this upgrade so an adopter who installed `--profile core,fintech` does not
   627	# silently get the core,frontend default by forgetting the flag. Explicit
   628	# flags always win; --no-replay opts out.
   629	#
   630	# BACK-COMPAT (debate C must-fix): missing state (ALL pre-Wave-B installs)
   631	# or unreadable/invalid state NEVER errors and NEVER no-ops — the upgrade
   632	# proceeds with CLI/default flags on the ADR-155 path (the --dry-run preview
   633	# and the baseline drift-classifier below), and a state file is (re)written
   634	# after a successful non-dry upgrade so the NEXT run can replay.
   635	#
   636	# TRUST: the state file is target-side, UNSIGNED, advisory (ADR-155 trust
   637	# class). Values are parsed by python3 -I under PYTHONNOUSERSITE=1, charset-
   638	# validated (profile: [A-Za-z0-9_,.-]{1,200}; stack: [A-Za-z0-9_.-]{1,100}),
   639	# and NEVER eval-ed; anything suspect => fallback, exactly as if absent.
   640	_INSTALL_STATE_FILE="$TARGET/.claude/.install-state.json"
   641	_REPLAY_SOURCE="cli-default"
   642	_UP_OPS_FILE=""
   643	
   644	# Print "<profile>\t<stack>" from a valid state file; non-zero rc on ANY
   645	# problem (missing python3, unreadable file, bad JSON, wrong schema_version,
   646	# non-string or charset-violating values) => caller falls back.
   647	_read_install_state_request() {
   648	  command -v python3 >/dev/null 2>&1 || return 3
   649	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
   650	  PYTHONNOUSERSITE=1 python3 -I -c '
   651	import json, re, sys
   652	try:
   653	    with open(sys.argv[1], "r", encoding="utf-8") as f:
   654	        d = json.load(f)
   655	except (OSError, ValueError):
   656	    sys.exit(3)
   657	if not isinstance(d, dict):
   658	    sys.exit(3)
   659	if d.get("schema_version") != 1:
   660	    sys.exit(3)
   661	req = d.get("request")
   662	if not isinstance(req, dict):
   663	    sys.exit(3)
   664	prof = req.get("profile", "")
   665	stack = req.get("stack", "")
   666	if not isinstance(prof, str) or not isinstance(stack, str):
   667	    sys.exit(3)
   668	if prof and not re.match(r"^[A-Za-z0-9_,.-]{1,200}$", prof):
   669	    sys.exit(3)
   670	if stack and not re.match(r"^[A-Za-z0-9_.-]{1,100}$", stack):
   671	    sys.exit(3)
   672	# PLAN-155 Wave 5: harness (closed enum) + managed_hooks bool round-trip.
   673	harness = req.get("harness", "")
   674	if harness not in ("", "claude", "codex"):
   675	    harness = ""  # unknown value => fall back to CLI/default, never trust it
   676	managed = "1" if req.get("managed_hooks") is True else "0"
   677	sys.stdout.write(prof + "\t" + stack + "\t" + harness + "\t" + managed + "\n")
   678	' "$_INSTALL_STATE_FILE" 2>/dev/null
   679	}
   680	
   681	if [[ "$REPLAY" -eq 1 ]]; then
   682	  if [[ -f "$_INSTALL_STATE_FILE" ]]; then
   683	    _rp_line=""
   684	    if _rp_line="$(_read_install_state_request)" && [[ -n "$_rp_line" ]]; then
   685	      # TAB-separated: profile<TAB>stack<TAB>harness<TAB>managed (PLAN-155 W5).
   686	      IFS=$'\t' read -r _rp_profile _rp_stack _rp_harness _rp_managed <<< "$_rp_line"
   687	      _rp_used=0
   688	      if [[ "$PROFILE_EXPLICIT" -eq 0 && -n "$_rp_profile" ]]; then
   689	        PROFILE="$_rp_profile"
   690	        _rp_used=1
   691	        echo "    REPLAY: --profile $PROFILE (recorded request in .claude/.install-state.json; pass --profile or --no-replay to override)" >&2
   692	      fi
   693	      if [[ "$STACK_EXPLICIT" -eq 0 && -n "$_rp_stack" ]]; then
   694	        STACK="$_rp_stack"
   695	        _rp_used=1
   696	        echo "    REPLAY: --stack $STACK (recorded request in .claude/.install-state.json; pass --stack or --no-replay to override)" >&2
   697	      fi
   698	      if [[ "$HARNESS_EXPLICIT" -eq 0 && -n "$_rp_harness" ]]; then
   699	        HARNESS="$_rp_harness"
   700	        _rp_used=1
   701	        echo "    REPLAY: --harness $HARNESS (recorded request in .claude/.install-state.json; pass --harness or --no-replay to override)" >&2
   702	      fi
   703	      if [[ "$CODEX_MANAGED_HOOKS" -eq 0 && "${_rp_managed:-0}" = "1" ]]; then
   704	        CODEX_MANAGED_HOOKS=1
   705	        _rp_used=1
   706	      fi
   707	      if [[ "$_rp_used" -eq 1 ]]; then
   708	        _REPLAY_SOURCE="replay"
   709	      fi
   710	    else
   711	      _REPLAY_SOURCE="fallback-invalid-state"
   712	      echo "    NOTE: .claude/.install-state.json present but unreadable/invalid — IGNORED." >&2
   713	      echo "          Proceeding with CLI/default flags on the ADR-155 path (baseline" >&2
   714	      echo "          drift-classifier; --dry-run previews). Never blocks (PLAN-153" >&2
   715	      echo "          debate C back-compat must-fix); a valid state file is rewritten" >&2
   716	      echo "          after this upgrade completes." >&2
   717	    fi
   718	  else
   719	    _REPLAY_SOURCE="fallback-no-state"
   720	    echo "    NOTE: no .claude/.install-state.json in target (pre-Wave-B install)." >&2
   721	    echo "          Proceeding with CLI/default flags on the ADR-155 path (baseline" >&2
   722	    echo "          drift-classifier when a manifest exists, else diff -q warn-then-" >&2
   723	    echo "          clobber). A state file is recorded after this upgrade completes." >&2
   724	  fi
   725	fi
