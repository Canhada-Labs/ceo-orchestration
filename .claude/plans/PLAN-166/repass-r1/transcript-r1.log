   773	# ===========================================================================
   774	# PLAN-138 Wave C (ADR-155) — baseline manifest load + per-file classifier.
   775	# ===========================================================================
   776	# Read $TARGET/.claude/.install-manifest.sha256 ONCE at startup into a
   777	# validated, sanitized lookup file. Every line is re-validated here against the
   778	# two accepted record grammars; any line that matches NEITHER, or whose relpath
   779	# is absolute / contains `..` / control chars / duplicates an earlier relpath /
   780	# traverses a symlinked component, is DROPPED so it can never drive a silent
  1010	# PLAN-161 U1 (codex r1 F4) — manifest-load observability. Byte-identity alone
  1011	# cannot prove a --dry-run kept provenance classification alive (a dry-run
  1012	# that silently lost the baseline would also write nothing), so EVERY run
  1013	# states which classification mode it operates in.
  1014	if [ -n "$_BASELINE_MANIFEST_FILE" ]; then
  1015	  echo "==> Baseline manifest: loaded (provenance classification ACTIVE)"
  1016	else
  1017	  echo "==> Baseline manifest: none — fallback diff -q classification"
  1018	fi
  1019	
  1020	# F-CHAOS-3: match a relative path against the --skip globs list.
  1021	# Returns 0 (true) if matched.
  1022	_path_is_skipped() {
  1023	  local rel="$1"
  1024	  local pattern
  1025	  for pattern in "${SKIP_GLOBS[@]:-}"; do
  1026	    [[ -n "$pattern" ]] || continue
  1027	    # Intentional unquoted glob match (the whole point of --skip patterns).
  1028	    # shellcheck disable=SC2053,SC2254
  1029	    case "$rel" in
  1030	      $pattern) return 0 ;;
  1031	    esac
  1032	  done
  1033	  return 1
  1034	}
  1035	
  1036	# F-CHAOS-3: emit a diff-q-style WARNING line for every adopter file
  1037	# that differs from the source before we overwrite it. Recurses into
  1038	# directories. Respects --no-diff-warn and --skip globs.
  1039	_emit_diff_warnings() {
  1040	  local rel_path="$1"
  1041	  local src="$SOURCE_DIR/$rel_path"
  1042	  local dst="$TARGET/$rel_path"
  1043	
  1044	  [[ "$DIFF_WARN" -eq 1 ]] || return 0
  1045	  [[ -e "$dst" && -e "$src" ]] || return 0
  1046	
  1047	  if [[ -d "$src" && -d "$dst" ]]; then
  1048	    # Per-file diff within the directory
  1049	    local f rel sub
  1050	    while IFS= read -r f; do
  1051	      [[ -n "$f" ]] || continue
  1052	      sub="${f#$dst/}"
  1053	      rel="$rel_path/$sub"
  1054	      if _path_is_skipped "$rel"; then
  1055	        echo "    SKIP-DIFF (--skip): $rel" >&2
  1056	        continue
  1057	      fi
  1058	      if [[ -f "$SOURCE_DIR/$rel" ]]; then
  1059	        if ! diff -q "$f" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
  1060	          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN" >&2
  1061	          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
  1062	        fi
  1063	      fi
  1064	    done < <(find "$dst" -type f 2>/dev/null)
  1065	  elif [[ -f "$src" && -f "$dst" ]]; then
  1066	    if _path_is_skipped "$rel_path"; then
  1067	      echo "    SKIP-DIFF (--skip): $rel_path" >&2
  1068	      return 0
  1069	    fi
  1070	    if ! diff -q "$dst" "$src" >/dev/null 2>&1; then
  1071	      echo "    WARNING: adopter customization in $rel_path will be OVERWRITTEN" >&2
  1072	      echo "             (backup preserved in $BAK_DIR/$rel_path)" >&2
  1073	    fi
  1074	  fi
  1075	}
  1076	
  1077	# PLAN-138 Wave C (ADR-155): update ONE file under a classified directory walk.
  1078	# $1 = repo-relative file path. Backs up the dst file then copies src over it.
  1079	# Used by _per_file_classified_update for the FRAMEWORK-CHANGED / theirs / backup
  1080	# branches. find+delete idiom is unnecessary for a single file (plain cp).
  1081	_apply_single_file() {
  1082	  local rel="$1"
  1083	  local s="$SOURCE_DIR/$rel"
  1084	  local d="$TARGET/$rel"
  1085	  local b="$BAK_DIR/$rel"
  1086	  [[ -f "$s" ]] || return 0
  1087	  if [[ -e "$d" ]]; then
  1088	    mkdir -p "$( dirname "$b" )"
  1089	    cp "$d" "$b" 2>/dev/null || true
  1090	  fi
  1091	  mkdir -p "$( dirname "$d" )"
  1092	  cp "$s" "$d"
  1093	}
  1094	
  1095	# PLAN-138 Wave C (ADR-155): per-file walk of a DIRECTORY target driven by the
  1096	# baseline classifier. Replaces the whole-tree delete+cp -R when a baseline
  1097	# manifest is loaded, so an adopter customization INSIDE a directory is
  1098	# preserved/refused per-file instead of being wiped. The union of source + dst
  1099	# files is walked so framework-added files land and removed-from-source files
  1100	# are reported (never auto-deleted — destructive removals stay manual).
  1101	_per_file_classified_update() {
  1102	  local rel_dir="$1"
  1103	  local sdir="$SOURCE_DIR/$rel_dir"
  1104	  local ddir="$TARGET/$rel_dir"
  1105	  local listing rel verdict
  1106	  # Build the union of relpaths under src + dst (regular files only).
  1107	  listing="$( {
  1108	    [[ -d "$sdir" ]] && find "$sdir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$SOURCE_DIR"/}"; done
  1109	    [[ -d "$ddir" ]] && find "$ddir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$TARGET"/}"; done
  1110	  } | LC_ALL=C sort -u )"
  1111	
  1112	  printf '%s\n' "$listing" | while IFS= read -r rel; do
  1113	    [[ -n "$rel" ]] || continue
  1114	    # PLAN-161 U2 (CF-7): the canonical framework-internal exclusion set —
  1115	    # never install, never re-add after an adopter deletes, never report.
  1116	    # Silent skip; the opt-in U3 purge is the ONLY code allowed to touch
  1117	    # these paths (and only hash-gated).
  1118	    if command -v _framework_path_excluded >/dev/null 2>&1 && _framework_path_excluded "$rel"; then
  1119	      continue
  1120	    fi
  1121	    if _path_is_skipped "$rel"; then
  1122	      echo "    SKIPPED (--skip): $rel"
  1123	      continue
  1124	    fi
  1125	    # Source-removed file: present at dst, absent at src. Report, never delete.
  1126	    if [[ ! -f "$SOURCE_DIR/$rel" ]]; then
  1127	      echo "    KEPT (no longer shipped by framework — not removed): $rel" >&2
  1128	      continue
  1129	    fi
  1130	    # New framework file: absent at dst. Just install it.
  1131	    if [[ ! -f "$TARGET/$rel" ]]; then
  1132	      _apply_single_file "$rel"
  1133	      echo "    ADDED: $rel"
  1134	      continue
  1135	    fi
  1136	    verdict="$( _classify_against_baseline "$rel" )"
  1137	    case "$verdict" in
  1138	      IDENTICAL)
  1139	        : ;;  # nothing to do
  1140	      FRAMEWORK-CHANGED)
  1141	        # Quiet auto-update is the intended path (dst matched the recorded
  1142	        # baseline => the adopter had not customized this file). BUT the manifest
  1143	        # is UNSIGNED/target-side (OQ-trust): a tampered line where H_base==H_dst
  1144	        # would mis-classify a customized file into this branch. We cannot detect
  1145	        # that without a signed manifest, so per Codex R1 P0#1 this is downgraded
  1146	        # to NON-SILENT: _apply_single_file always backs up the original first,
  1147	        # and we surface the overwrite + backup location on stderr (recoverable
  1148	        # AND visible — worst case equals today's warn-then-clobber).
  1149	        _apply_single_file "$rel"
  1150	        echo "    UPDATED (framework-changed; unsigned baseline — original backed up to $BAK_DIR/$rel): $rel" >&2
  1151	        ;;
  1152	      ADOPTER-CUSTOMIZED)
  1153	        echo "    PRESERVED (ADOPTER-CUSTOMIZED — not overwritten): $rel" >&2
  1154	        ;;
  1155	      CONFLICT)
  1156	        case "$ON_CONFLICT" in
  1157	          theirs)
  1158	            _apply_single_file "$rel"
  1159	            echo "    OVERWROTE (CONFLICT, --on-conflict=theirs): $rel" >&2
  1160	            ;;
  1161	          backup)
  1162	            _apply_single_file "$rel"
  1163	            echo "    OVERWROTE (CONFLICT, --on-conflict=backup; original in $BAK_DIR/$rel): $rel" >&2
  1164	            ;;
  1165	          *)  # refuse (default): per-file skip-and-report-and-CONTINUE
  1166	            echo "    REFUSED (CONFLICT, --on-conflict=refuse — not overwritten): $rel" >&2
  1167	            ;;
  1168	        esac
  1169	        ;;
  1170	      FALLBACK|*)
  1171	        # No usable baseline for this file — today's diff -q warn-then-clobber.
  1172	        if [[ "$DIFF_WARN" -eq 1 ]] && ! diff -q "$TARGET/$rel" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
  1173	          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN (no baseline)" >&2
  1174	          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
  1175	        fi
  1176	        _apply_single_file "$rel"
  1177	        echo "    UPDATED (fallback): $rel"
  1178	        ;;
  1179	    esac
  1180	  done
  1181	}
  1182	
  1183	# PLAN-161 W2 fix-3 (codex r3 F11a): TRUE (rc 0) iff any STRICT ancestor
  1184	# component of relpath $2 under root $1 is a symlink. A preserved excluded
  1185	# SYMLINK must be an opaque leaf: a -f/-d/-L test (or rm/rmdir) on a path
  1186	# that runs THROUGH it resolves into the link TARGET, so an unguarded
  1187	# prune could delete adopter data OUTSIDE the tree. Every prune-side
  1188	# test/delete on "$TARGET/$rel" must first pass this lstat-walk guard.
  1189	# bash 3.2-safe: pure string splitting, [[ -L ]] never follows the leaf.
  1190	_lg_ancestor_is_symlink() {
  1191	  local _as_root="$1" _as_rel="$2" _as_walk=""
  1192	  while [[ "$_as_rel" == */* ]]; do
  1193	    _as_walk="${_as_walk:+$_as_walk/}${_as_rel%%/*}"
  1194	    _as_rel="${_as_rel#*/}"
  1195	    if [[ -L "$_as_root/$_as_walk" ]]; then return 0; fi
  1196	  done
  1197	  return 1
  1198	}
  1199	
  1200	backup_and_replace() {
  1201	  local rel_path="$1"
  1202	  local src="$SOURCE_DIR/$rel_path"
  1203	  local dst="$TARGET/$rel_path"
  1204	  local bak="$BAK_DIR/$rel_path"
  1205	
  1206	  if [[ ! -e "$src" ]]; then
  1207	    echo "    SKIP (source missing): $rel_path"
  1208	    return
  1209	  fi
  1210	
  1211	  _up_record_op "refresh_target" "$rel_path"
  1212	
  1213	  # F-CHAOS-3: warn the Owner about any customization we're about to
  1214	  # clobber, BEFORE the overwrite takes place. The backup under
  1215	  # $BAK_DIR is still the rollback path, but the warning surfaces the
  1216	  # diff at the moment it happens — without requiring the Owner to
  1217	  # notice it via `git diff` later.
  1218	  _emit_diff_warnings "$rel_path"
  1219	
  1220	  # Honour --skip for top-level files/dirs too
  1221	  if _path_is_skipped "$rel_path"; then
  1222	    echo "    SKIPPED (--skip): $rel_path"
  1223	    return
  1224	  fi
  1225	
  1226	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1227	    # PLAN-161 U1 (codex r1 F4): classification-aware preview for single-FILE
  1228	    # targets when a baseline manifest is loaded — the dry-run log must PROVE
  1229	    # the provenance classifier still runs (byte-identity alone would pass on
  1230	    # a dry-run that silently lost classification). DIRECTORY targets keep
  1231	    # the legacy one-line preview.
  1232	    if [[ -f "$dst" && -f "$src" && -n "$_BASELINE_MANIFEST_FILE" ]]; then
  1233	      local _drv
  1234	      _drv="$( _classify_against_baseline "$rel_path" )"
  1235	      case "$_drv" in
  1236	        IDENTICAL)
  1237	          echo "    (dry-run) would SKIP (IDENTICAL): $rel_path" ;;
  1238	        ADOPTER-CUSTOMIZED)
  1239	          echo "    (dry-run) would PRESERVE (ADOPTER-CUSTOMIZED): $rel_path" ;;
  1240	        CONFLICT)
  1241	          echo "    (dry-run) would apply --on-conflict=$ON_CONFLICT (CONFLICT): $rel_path" ;;
  1242	        FRAMEWORK-CHANGED)
  1243	          echo "    (dry-run) would UPDATE (FRAMEWORK-CHANGED; original would be backed up to $BAK_DIR/$rel_path): $rel_path" ;;
  1244	        FALLBACK|*)
  1245	          echo "    (dry-run) would BACKUP + UPDATE (no usable baseline): $rel_path" ;;
  1246	      esac
  1247	      return
  1248	    fi
  1249	    echo "    (dry-run) would BACKUP + UPDATE: $rel_path"
  1250	    return
  1251	  fi
  1252	
  1253	  # PLAN-138 Wave C (ADR-155): when this is a DIRECTORY target AND a baseline
  1254	  # manifest is loaded, do a per-file classified walk so adopter customizations
  1255	  # inside the tree are preserved/refused instead of wiped by delete+cp -R.
  1256	  # Falls through to the legacy whole-tree path for FILE targets or when no
  1257	  # manifest is present (fail-open to today's behavior). The whole-tree backup
  1258	  # below still runs first so $BAK_DIR holds the pre-upgrade tree for rollback.
  1259	  if [[ -d "$dst" && -d "$src" && -n "$_BASELINE_MANIFEST_FILE" ]]; then
  1260	    if [[ -e "$dst" ]]; then
  1261	      mkdir -p "$( dirname "$bak" )"
  1262	      cp -R "$dst" "$bak"
  1263	      echo "    BACKED UP: $rel_path"
  1264	    fi
  1265	    _per_file_classified_update "$rel_path"
  1266	    echo "    UPDATED (per-file classified): $rel_path"
  1267	    return
  1268	  fi
  1269	
  1270	  # PLAN-138 Wave C (ADR-155): single-FILE target with a baseline loaded —
  1271	  # classify it too (e.g. .claude/task-chains.yaml, .claude/team.md). Preserve
  1272	  # an ADOPTER-CUSTOMIZED file / refuse a CONFLICT instead of clobbering.
  1273	  if [[ -f "$dst" && -f "$src" && -n "$_BASELINE_MANIFEST_FILE" ]]; then
  1274	    local _bfr_verdict
  1275	    _bfr_verdict="$( _classify_against_baseline "$rel_path" )"
  1276	    case "$_bfr_verdict" in
  1277	      IDENTICAL)
  1278	        return ;;
  1279	      ADOPTER-CUSTOMIZED)
  1280	        echo "    PRESERVED (ADOPTER-CUSTOMIZED — not overwritten): $rel_path" >&2
  1281	        return ;;
  1282	      CONFLICT)
