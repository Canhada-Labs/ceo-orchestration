   390	      # -----------------------------------------------------------------
   391	      # PLAN-153 Wave B item 5 (a) — `already_published` idempotency
   392	      # guard. Before publishing, ask the registry whether this exact
   393	      # name@version already exists. If it does (a re-run of a
   394	      # previously successful publish, or a re-run after a post-publish
   395	      # step failed), the Publish step is skipped and the job succeeds
   396	      # as a documented no-op instead of going red on EPUBLISHCONFLICT.
   397	      #
   398	      # Detection is deliberately conservative: "published" ONLY when
   399	      # `npm view <name>@<version> version` exits 0 AND prints exactly
   400	      # the version (npm has historically flip-flopped between
   401	      # rc!=0/E404 and rc=0/empty-stdout for a missing version of an
   402	      # existing package — both shapes are treated as not-published).
   403	      # Any registry/network error therefore falls through to the
   404	      # publish attempt, which preserves today's behavior (npm itself
   405	      # fails closed on a true conflict). No auth needed: the package
   406	      # is public and `npm view` is an unauthenticated read.
   407	      # -----------------------------------------------------------------
   408	      - name: Check registry for already-published version
   409	        id: already_published
   410	        working-directory: npm
   411	        run: |
   412	          set -euo pipefail
   413	          PKG_NAME=$(node -p "require('./package.json').name")
   414	          PKG_VERSION=$(node -p "require('./package.json').version")
   415	          set +e
   416	          SEEN=$(npm view "${PKG_NAME}@${PKG_VERSION}" version 2>/dev/null)
   417	          RC=$?
   418	          set -e
   419	          if [[ "$RC" -eq 0 && "$SEEN" == "$PKG_VERSION" ]]; then
   420	            echo "published=true" >> "$GITHUB_OUTPUT"
   421	            echo "::notice::${PKG_NAME}@${PKG_VERSION} already exists in the registry — publish will be skipped (idempotent re-run, succeed-as-noop)"
   422	          else
   423	            echo "published=false" >> "$GITHUB_OUTPUT"
   424	            echo "OK: ${PKG_NAME}@${PKG_VERSION} not in registry (rc=$RC) — proceeding to publish"
   425	          fi
   426	
