   244	# O job await-release-gate do npm-publish.yml roda TAMBEM em tag rc —
   245	# e o controle positivo VIVO do gate de publish do GA (pair-rail S300
   246	# r10 P1-2): se ele falha na rc, o hold de 24h comecaria sobre um
   247	# caminho de publish nunca validado. Exigimos o JOB verde (o run
   248	# inteiro pode ficar aguardando aprovacao production-npm - normal).
   249	printf 'esperando o job await-release-gate do npm-publish.yml (controle positivo)...\n'
   250	i=0
   251	while :; do
   252	  i=$((i+1)); [ "$i" -le 30 ] || die "await-release-gate nao concluiu em 30 min"
   253	  sleep 60
   254	  NID="$(gh run list --workflow npm-publish.yml --limit 10 \
   255	    --json headSha,databaseId \
   256	    --jq "[.[]|select(.headSha==\"$TAGSHA\")][0].databaseId" 2>/dev/null || echo "")"
   257	  if [ -z "$NID" ] || [ "$NID" = "null" ]; then
   258	    printf '  ... run do npm-publish ainda nao apareceu\n'; continue
   259	  fi
   260	  AC="$(gh run view "$NID" --json jobs \
   261	    --jq '[.jobs[]|select(.name|startswith("Await release-gate"))][0].conclusion' 2>/dev/null || echo "")"
   262	  printf '  ... await-release-gate: %s\n' "${AC:-pendente}"
   263	  [ "$AC" = "failure" ] && die "await-release-gate FALHOU na rc - controle positivo do publish morto; me chame no Claude"
   264	  [ "$AC" = "success" ] && break
   265	done
   266	echo "   controle positivo do npm-gate: verde"
