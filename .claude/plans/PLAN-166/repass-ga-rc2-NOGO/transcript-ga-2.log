   152	    def freshness_floor(self) -> int:
   153	        if self.self_created_at_epoch is None:
   154	            # A NamedTuple cannot stop an explicit None; refusing loudly here
   155	            # keeps "freshness leg silently off" unrepresentable at every
   156	            # layer instead of only at the CLI.
   157	            raise ValueError(
   158	                "freshness leg unarmed: self_created_at_epoch is None — the "
   159	                "delete+re-tag freshness leg cannot be silently disabled"
   160	            )
   161	        return self.self_created_at_epoch - self.freshness_skew_seconds
