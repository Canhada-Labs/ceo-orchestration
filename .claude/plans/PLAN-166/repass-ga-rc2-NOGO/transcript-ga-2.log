   462	      # -----------------------------------------------------------------
   463	      # PLAN-012 Phase 2 §R11 — weekly-workflow status gate.
   464	      # PLAN-019 P2 DevOps-P2-1 — 14-day staleness check added.
   465	      #
   466	      # Before a tag ships, assert that recent runs of the six advisory
   467	      # workflows (chaos, otel-smoke, perf-profile, adapter-live,
   468	      # red-team, formal-verify) have NOT been failing AND are fresh
   469	      # (most-recent run within 14 days). A red chaos.yml in the past 3
   470	      # runs means we have live regressions that a tag should not paper
   471	      # over. A stale workflow (no runs in 14 days) means the advisory
   472	      # check is silently disabled — kill switch, cron disabled, or
   473	      # workflow deleted.
   474	      #
   475	      # Staleness defense (P2 DevOps-P2-1): absence of runs is NOT
   476	      # neutral. Prior logic treated "no runs" as pass — a 1-year-old
   477	      # repo with 0 runs silently passed, turning the gate into a
   478	      # honeypot. Now: most-recent run must have started within 14 days
   479	      # OR the gate fails with `Workflow X stale — last run N days ago`.
   480	      #
   481	      # Uses `gh run list` against the REST API via $GITHUB_TOKEN; read
   482	      # permission on `actions` is granted at job level.
   483	      # -----------------------------------------------------------------
   484	      - name: Weekly workflow status gate (advisory health check + 14-day staleness, waiver-aware)
   485	        env:
   486	          GH_TOKEN: ${{ github.token }}
   487	        run: |
   488	          set -euo pipefail
   489	          TAG="${GITHUB_REF_NAME}"
   490	          VERSION="${TAG#v}"
   491	
   492	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment
   493	          # extension). Same waiver registry as the RC-hold gate:
   494	          # pre-GA phase with adopter_count=0 waives advisory-workflow
   495	          # staleness per Owner authorization. Post-first-adopter, the
   496	          # waiver file is expected to be empty and the gate resumes
   497	          # default enforcement.
   498	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   499	          if [[ -f "$WAIVER_FILE" ]]; then
   500	            if awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   501	              echo "::notice::$TAG has a pre-GA waiver in $WAIVER_FILE — skipping weekly workflow staleness gate"
   502	              exit 0
   503	            fi
   504	          fi
   505	
   506	          # PLAN-025 Batch G F-wf-002: fail-fast if gh is unavailable (rare
   507	          # on ubuntu-latest but not impossible on custom runners). Clearer
   508	          # error than "gh: command not found" in an obscure subshell.
   509	          command -v gh >/dev/null 2>&1 || {
   510	            echo "::error::gh CLI not found on runner; install via \"sudo apt-get install gh\" or use actions/setup-gh"
   511	            exit 1
   512	          }
   513	          # Tolerance: each workflow is checked across the last 3 runs.
   514	          # If ANY run in that window is `failure` → fail the release.
   515	          # `skipped` runs are fine (kill-switch or paths-filter).
   516	          WORKFLOWS=(chaos.yml otel-smoke.yml perf-profile.yml adapter-live.yml red-team.yml formal-verify.yml)
   517	          STALENESS_DAYS=14
   518	          STALENESS_SECS=$((STALENESS_DAYS * 86400))
   519	          NOW_SECS=$(date -u +%s)
   520	          FAILED=0
   521	          for wf in "${WORKFLOWS[@]}"; do
   522	            # Fetch up to 3 runs with both conclusion AND startedAt timestamp.
   523	            runs_json=$(gh run list --workflow "$wf" --limit 3 \
   524	              --json conclusion,startedAt 2>/dev/null || echo "[]")
   525	            if [ -z "$runs_json" ] || [ "$runs_json" = "[]" ]; then
   526	              # Absence of runs is NOT neutral post-DevOps-P2-1: it means
   527	              # the advisory workflow has never triggered in this repo.
   528	              # For a mature release (v1.x.y), that's a bug — kill switch
   529	              # set, cron disabled, or workflow deleted.
   530	              echo "::error::$wf — zero runs recorded; staleness gate fails"
   531	              FAILED=1
   532	              continue
   533	            fi
   534	            # Extract conclusions for the failure-scan logic.
   535	            # Session 33 refinement: the previous rule "any failure in
   536	            # last 3 → block" did not distinguish "past bug, now fixed"
   537	            # from "still broken / intermittent flake". Both classes
   538	            # block release, but only the second is a real tag risk.
   539	            # New rule: block iff BOTH of these hold simultaneously:
   540	            #   (a) at least one failure in last 3 runs
   541	            #   (b) the MOST RECENT run also failed
   542	            # Rationale: (a) alone is false-positive after a root-cause
   543	            # fix; (b) alone would let a "one green after 10 reds"
   544	            # flake slip through. Both together = persistent failure
   545	            # that a tag should not paper over.
   546	            conclusions=$(echo "$runs_json" | jq -r '.[].conclusion')
   547	            latest_conclusion=$(echo "$runs_json" | jq -r '.[0].conclusion')
   548	            if echo "$conclusions" | grep -q '^failure$' \
   549	               && [ "$latest_conclusion" = "failure" ]; then
   550	              echo "::error::$wf — failure in last 3 AND latest run failed; block release"
   551	              FAILED=1
   552	            elif echo "$conclusions" | grep -q '^failure$'; then
   553	              echo "::notice::$wf — past failure in last 3 but latest run green; accepting as fixed"
   554	            fi
   555	            # Staleness check: most-recent run's startedAt must be within
   556	            # STALENESS_DAYS of now. startedAt is ISO-8601 UTC
   557	            # (e.g. "2026-04-10T12:34:56Z"). GitHub runners are Linux →
   558	            # GNU `date -d` is always available.
   559	            latest_started=$(echo "$runs_json" | jq -r '.[0].startedAt')
   560	            if [ -z "$latest_started" ] || [ "$latest_started" = "null" ]; then
   561	              echo "::error::$wf — cannot parse startedAt for most-recent run"
   562	              FAILED=1
   563	              continue
   564	            fi
   565	            started_secs=$(date -u -d "$latest_started" +%s 2>/dev/null || echo 0)
   566	            if [ "$started_secs" -eq 0 ]; then
   567	              echo "::error::$wf — failed to parse startedAt: $latest_started"
   568	              FAILED=1
   569	              continue
   570	            fi
   571	            delta=$((NOW_SECS - started_secs))
   572	            days=$((delta / 86400))
   573	            if [ "$delta" -gt "$STALENESS_SECS" ]; then
   574	              echo "::error::$wf stale — last run $days days ago (> $STALENESS_DAYS day limit)"
   575	              FAILED=1
   576	            else
   577	              echo "::notice::$wf — recent runs OK; last run $days days ago"
   578	            fi
   579	          done
   580	          if [ "$FAILED" -eq 1 ]; then
   581	            echo "::error::release gate: one or more advisory workflows red or stale"
   582	            exit 1
   583	          fi
   584	          echo "OK: all 6 advisory workflows clean in last 3 runs + fresh within $STALENESS_DAYS days"
