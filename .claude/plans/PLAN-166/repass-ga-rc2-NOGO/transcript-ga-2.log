   145	    freshness_skew_seconds: int = DEFAULT_FRESHNESS_SKEW_SECONDS
   146	
   147	    @property
   148	    def deadline_passed(self) -> bool:
   149	        return self.deadline_epoch is not None and self.now_epoch > self.deadline_epoch
   150	
