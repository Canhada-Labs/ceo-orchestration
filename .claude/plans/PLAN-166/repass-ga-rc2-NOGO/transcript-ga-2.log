   204	class BlockTests(TestEnvContext):
   205	    def test_candidate_with_skipped_gate_job_blocks(self):
   206	        # CEO_SOTA_DISABLE=1 skips the job while the RUN stays green.
   207	        run = release_run(jobs=[gate_job(conclusion="skipped")])
   208	        result = decide(payload(self_run(), run), ctx())
   209	        self.assertEqual(BLOCK, result.decision)
   210	        self.assertEqual("gate-job-skipped", result.reason)
   211	
   212	    def test_candidate_with_failed_gate_job_blocks(self):
   213	        run = release_run(conclusion="failure", jobs=[gate_job(conclusion="failure")])
   214	        result = decide(payload(self_run(), run), ctx())
   215	        self.assertEqual(BLOCK, result.decision)
   216	        self.assertEqual("gate-job-failure", result.reason)
   217	        proc = run_cli(json.dumps(payload(self_run(), run)))
   218	        self.assertEqual(EXIT_BLOCK, proc.returncode)
   219	        self.assertIn("decision=BLOCK", proc.stdout)
   220	
   221	    def test_no_candidate_past_the_deadline_blocks(self):
   222	        result = decide(payload(self_run()), ctx(now=NOW_PAST_DEADLINE))
   223	        self.assertEqual(BLOCK, result.decision)
   224	        self.assertEqual("deadline-exceeded:candidate-not-yet-created", result.reason)
   225	
   226	    def test_malformed_payloads_block(self):
   227	        for body in ([], "workflow_runs", {"message": "Bad credentials"},
   228	                     {"workflow_runs": {"nope": 1}}, {"workflow_runs": ["not-an-object"]}):
   229	            result = decide(body, ctx())
   230	            self.assertEqual(BLOCK, result.decision, body)
   231	            self.assertEqual("malformed-payload", result.reason, body)
   232	        proc = run_cli("{not json at all")
   233	        self.assertEqual(EXIT_BLOCK, proc.returncode)
   234	        self.assertIn("reason=malformed-payload", proc.stdout)
