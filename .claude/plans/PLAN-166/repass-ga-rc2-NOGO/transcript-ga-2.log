   296	class UsageTests(TestEnvContext):
   297	    """A parameter that changes the verdict has no default (FIXER pass, W0).
   298	
   299	    ``--self-created-at`` used to be optional with ``default=None`` — and
   300	    ``None`` DISABLES the freshness floor, so omitting one flag turned the
   301	    exact stale-success payload FreshnessTests rejects into a GRANT. Same
   302	    class as F2's ``--today`` in ``_release_bump_sites.py``: the input that
   303	    flips the verdict must be explicit or the run must refuse.
   304	    """
   305	
   306	    def _stale_only_body(self):
   307	        # The delete+re-tag payload: ONLY a success predating the asking run.
   308	        return json.dumps(payload(self_run(), release_run(id=900, created_at=STALE_CREATED_AT)))
   309	
   310	    def test_omitting_self_created_at_refuses_instead_of_granting(self):
   311	        proc = run_cli(self._stale_only_body(), self_created_at=None)
   312	        self.assertNotEqual(
   313	            EXIT_GRANT, proc.returncode,
   314	            "omitting --self-created-at must never GRANT a stale success:\n" + proc.stdout,
   315	        )
   316	        self.assertEqual(EXIT_USAGE, proc.returncode, proc.stdout + proc.stderr)
   317	        self.assertIn("--self-created-at", proc.stderr)
   318	
   319	    def test_empty_self_created_at_is_a_usage_error_not_a_disabled_leg(self):
   320	        # required=True alone would still let `--self-created-at ""` slip
   321	        # through the old `if args.self_created_at:` truthiness parse-skip.
   322	        proc = run_cli(self._stale_only_body(), self_created_at="")
   323	        self.assertNotEqual(EXIT_GRANT, proc.returncode, proc.stdout)
   324	        self.assertEqual(EXIT_USAGE, proc.returncode, proc.stdout + proc.stderr)
   325	
