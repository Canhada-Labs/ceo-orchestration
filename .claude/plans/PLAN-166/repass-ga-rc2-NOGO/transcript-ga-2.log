   163	
   164	class Decision(NamedTuple):
   165	    decision: str
   166	    reason: str
   167	    facts: Dict[str, Any]
   168	
   169	    @property
   170	    def exit_code(self) -> int:
   171	        return _EXIT_BY_DECISION[self.decision]
   172	
   173	
   174	_TS_RE = re.compile(
   175	    r"^(\d{4})-(\d{2})-(\d{2})[Tt ](\d{2}):(\d{2}):(\d{2})"
   176	    r"(?:\.\d+)?(Z|z|[+-]\d{2}:?\d{2})?$"
   177	)
   178	
   179	
   180	def parse_timestamp(raw: Any) -> Optional[int]:
   181	    """ISO-8601 (GitHub flavour) -> epoch seconds UTC. ``None`` if unparseable.
   182	
   183	    ``datetime.fromisoformat`` cannot read a trailing ``Z`` on Python 3.9, so
   184	    this parses explicitly instead of depending on interpreter version.
   185	    """
   186	    if not isinstance(raw, str):
   187	        return None
   188	    m = _TS_RE.match(raw.strip())
   189	    if m is None:
   190	        return None
   191	    parts = [int(m.group(i)) for i in range(1, 7)]
   192	    try:
   193	        epoch = calendar.timegm(
   194	            (parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], 0, 1, -1)
   195	        )
   196	    except (ValueError, OverflowError):
   197	        return None
   198	    off = m.group(7)
   199	    if off and off not in ("Z", "z"):
   200	        sign = 1 if off[0] == "+" else -1
   201	        digits = off[1:].replace(":", "")
   202	        epoch -= sign * (int(digits[:2]) * 3600 + int(digits[2:4]) * 60)
   203	    return epoch
   204	
   205	
   206	def extract_runs(payload: Any) -> List[Dict[str, Any]]:
   207	    """Pull the run list out of the payload, or raise MalformedPayload.
   208	
   209	    Accepts the raw GitHub envelope (``workflow_runs``) or a plain ``runs``
   210	    list. An API error body (``{"message": "Bad credentials", ...}``) has
   211	    neither key and therefore raises — BLOCK, by design.
   212	    """
   213	    if not isinstance(payload, dict):
   214	        raise MalformedPayload("payload is %s, expected a JSON object" % type(payload).__name__)
   215	    for key in ("workflow_runs", "runs"):
   216	        if key in payload:
   217	            value = payload[key]
   218	            if not isinstance(value, list):
   219	                raise MalformedPayload("payload['%s'] is not a list" % key)
   220	            for item in value:
   221	                if not isinstance(item, dict):
   222	                    raise MalformedPayload("payload['%s'] holds a non-object entry" % key)
   223	            return value
   224	    raise MalformedPayload("payload has no 'workflow_runs' (or 'runs') key")
   225	
   226	
   227	def _workflow_file(run: Dict[str, Any]) -> Optional[str]:
   228	    for key in ("path", "workflow_path"):
   229	        value = run.get(key)
   230	        if isinstance(value, str) and value.strip():
   231	            return value.strip().rsplit("/", 1)[-1]
   232	    return None
   233	
   234	
   235	def _same_sha(left: Any, right: Any) -> bool:
   236	    if not isinstance(left, str) or not isinstance(right, str):
   237	        return False
   238	    return left.strip().lower() == right.strip().lower()
   239	
   240	
   241	def is_identity_match(run: Dict[str, Any], ctx: GateContext) -> bool:
   242	    """workflow + event + tag + head_sha, all four, no partial credit."""
   243	    return (
   244	        _workflow_file(run) == ctx.workflow
   245	        and run.get("event") == ctx.event
   246	        and run.get("head_branch") == ctx.tag
   247	        and _same_sha(run.get("head_sha"), ctx.head_sha)
   248	    )
   249	
   250	
   251	def _sort_key(run: Dict[str, Any], created_at: int) -> Tuple[int, int, int]:
   252	    attempt = run.get("run_attempt")
   253	    run_id = run.get("id")
   254	    return (
   255	        created_at,
   256	        attempt if isinstance(attempt, int) else 0,
   257	        run_id if isinstance(run_id, int) else 0,
   258	    )
   259	
   260	
   261	def select_candidate(
   262	    runs: Sequence[Dict[str, Any]], ctx: GateContext
   263	) -> Tuple[Optional[Dict[str, Any]], Dict[str, int]]:
   264	    """Most recent FRESH identity-matching run, plus a census of what was seen.
   265	
   266	    Raises MalformedPayload when an identity-matching run carries a
   267	    ``created_at`` we cannot parse: a candidate we cannot date cannot be
   268	    proven fresh, and unverifiable input is fail-CLOSED.
   269	    """
   270	    census = {"runs_total": len(runs), "identity_matches": 0, "stale_candidates": 0}
   271	    best: Optional[Dict[str, Any]] = None
   272	    best_key: Optional[Tuple[int, int, int]] = None
   273	    floor = ctx.freshness_floor
   274	    for run in runs:
   275	        if not is_identity_match(run, ctx):
   276	            continue
   277	        census["identity_matches"] += 1
   278	        created_at = parse_timestamp(run.get("created_at"))
   279	        if created_at is None:
   280	            raise MalformedPayload(
   281	                "candidate run id=%r has an unparseable created_at=%r"
   282	                % (run.get("id"), run.get("created_at"))
   283	            )
   284	        if created_at < floor:
   285	            census["stale_candidates"] += 1
   286	            continue
   287	        key = _sort_key(run, created_at)
   288	        if best_key is None or key > best_key:
   289	            best, best_key = run, key
   290	    census["fresh_candidates"] = census["identity_matches"] - census["stale_candidates"]
   291	    return best, census
   292	
   293	
   294	def find_gate_job(run: Dict[str, Any], gate_job: str) -> Optional[Dict[str, Any]]:
   295	    """The ``release-gate`` job inside a run, or None if not materialised yet."""
   296	    jobs = run.get("jobs")
   297	    if isinstance(jobs, dict):
   298	        jobs = jobs.get("jobs")
   299	    if not isinstance(jobs, list):
   300	        return None
   301	    for job in jobs:
   302	        if isinstance(job, dict) and job.get("name") == gate_job:
   303	            return job
   304	    return None
   305	
   306	
   307	def _wait_or_block(reason: str, ctx: GateContext, facts: Dict[str, Any]) -> Decision:
   308	    """Every non-GRANT state collapses to BLOCK once the deadline elapses."""
   309	    if ctx.deadline_passed:
   310	        return Decision(BLOCK, "deadline-exceeded:" + reason, facts)
   311	    return Decision(WAIT, reason, facts)
   312	
   313	
   314	def _candidate_facts(run: Dict[str, Any]) -> Dict[str, Any]:
   315	    return {
   316	        "candidate_run_id": run.get("id"),
   317	        "candidate_run_attempt": run.get("run_attempt"),
   318	        "candidate_created_at": run.get("created_at"),
   319	        "candidate_run_status": run.get("status"),
   320	        "candidate_run_conclusion": run.get("conclusion"),
   321	    }
   322	
   323	
   324	def decide(payload: Any, ctx: GateContext) -> Decision:
   325	    """The whole decision. Pure: no network, no clock, no filesystem."""
   326	    facts: Dict[str, Any] = {}
   327	    try:
   328	        runs = extract_runs(payload)
   329	        candidate, census = select_candidate(runs, ctx)
   330	    except MalformedPayload as exc:
   331	        facts["error"] = str(exc)
   332	        return Decision(BLOCK, "malformed-payload", facts)
   333	    facts.update(census)
   334	    if candidate is None:
   335	        reason = "stale-candidates-only" if census["stale_candidates"] else "candidate-not-yet-created"
   336	        return _wait_or_block(reason, ctx, facts)
   337	    facts.update(_candidate_facts(candidate))
   338	    job = find_gate_job(candidate, ctx.gate_job)
   339	    if job is None:
   340	        facts["gate_job_present"] = False
   341	        return _wait_or_block("gate-job-not-materialised", ctx, facts)
   342	    facts["gate_job_present"] = True
   343	    facts["gate_job_status"] = job.get("status")
   344	    conclusion = job.get("conclusion")
   345	    facts["gate_job_conclusion"] = conclusion
   346	    if conclusion is None:
   347	        return _wait_or_block("gate-job-not-concluded", ctx, facts)
   348	    if not isinstance(conclusion, str):
   349	        facts["error"] = "gate job conclusion is %s, expected string or null" % type(conclusion).__name__
   350	        return Decision(BLOCK, "malformed-payload", facts)
   351	    if conclusion == "success":
   352	        return Decision(GRANT, "gate-job-success", facts)
   353	    return Decision(BLOCK, "gate-job-" + conclusion, facts)
   354	
   355	
   356	def render(decision: Decision, ctx: GateContext) -> str:
   357	    """Human-readable record. A decision that hides its inputs is unauditable."""
   358	    remaining = "n/a"
   359	    if ctx.deadline_epoch is not None:
   360	        remaining = str(ctx.deadline_epoch - ctx.now_epoch)
   361	    lines = [
   362	        "decision=%s reason=%s" % (decision.decision, decision.reason),
   363	        "inputs: workflow=%s gate_job=%s event=%s tag=%s head_sha=%s"
   364	        % (ctx.workflow, ctx.gate_job, ctx.event, ctx.tag, ctx.head_sha),
   365	        "inputs: now_epoch=%s deadline_epoch=%s deadline_remaining_s=%s"
   366	        % (ctx.now_epoch, ctx.deadline_epoch, remaining),
   367	        "inputs: self_created_at_epoch=%s freshness_skew_s=%s freshness_floor_epoch=%s"
   368	        % (ctx.self_created_at_epoch, ctx.freshness_skew_seconds, ctx.freshness_floor),
   369	    ]
   370	    for key in sorted(decision.facts):
   371	        lines.append("fact: %s=%r" % (key, decision.facts[key]))
   372	    return "\n".join(lines)
   373	
   374	
   375	def _load_payload(path: str) -> Any:
   376	    raw = sys.stdin.read() if path == "-" else open(path, "r", encoding="utf-8").read()
   377	    return json.loads(raw)
   378	
   379	
   380	def build_parser() -> argparse.ArgumentParser:
   381	    parser = argparse.ArgumentParser(description="Decide whether release-gate authorises an npm publish.")
   382	    parser.add_argument("--payload-file", default="-", help="JSON of runs+jobs ('-' = stdin)")
   383	    parser.add_argument("--tag", required=True, help="tag name, i.e. head_branch of the release run")
   384	    parser.add_argument("--head-sha", required=True, help="GITHUB_SHA the publish is running against")
   385	    parser.add_argument("--workflow", default=DEFAULT_WORKFLOW)
   386	    parser.add_argument("--gate-job", default=DEFAULT_GATE_JOB)
   387	    parser.add_argument("--event", default=DEFAULT_EVENT)
   388	    parser.add_argument(
   389	        "--deadline-epoch",
   390	        type=int,
   391	        required=True,
   392	        help="epoch seconds after which any non-GRANT state becomes BLOCK (fail-closed)",
   393	    )
   394	    parser.add_argument("--now-epoch", type=int, default=None, help="override the clock (tests)")
   395	    parser.add_argument(
   396	        "--self-created-at",
   397	        required=True,
   398	        help=(
   399	            "created_at of the ASKING run; candidates older than this minus "
   400	            "the skew are stale. Required: this input arms the delete+re-tag "
   401	            "freshness leg, and a verdict-changing parameter has no default"
   402	        ),
   403	    )
   404	    parser.add_argument(
   405	        "--freshness-skew-seconds", type=int, default=DEFAULT_FRESHNESS_SKEW_SECONDS
   406	    )
   407	    parser.add_argument("--json", action="store_true", help="emit the decision record as JSON")
   408	    return parser
   409	
   410	
   411	def main(argv: Optional[Sequence[str]] = None) -> int:
   412	    args = build_parser().parse_args(argv)
   413	    # Unconditional parse: `required=True` rejects the OMITTED flag, and this
   414	    # rejects the empty/garbage value that a truthiness guard would have
   415	    # silently mapped to "freshness leg off".
   416	    self_created_at_epoch = parse_timestamp(args.self_created_at)
   417	    if self_created_at_epoch is None:
   418	        sys.stderr.write(
   419	            "error: --self-created-at %r is not an ISO-8601 timestamp "
   420	            "(the freshness leg cannot run without it)\n" % args.self_created_at
   421	        )
   422	        return EXIT_USAGE
   423	    ctx = GateContext(
   424	        tag=args.tag,
   425	        head_sha=args.head_sha,
   426	        now_epoch=args.now_epoch if args.now_epoch is not None else int(time.time()),
   427	        workflow=args.workflow,
   428	        gate_job=args.gate_job,
   429	        event=args.event,
   430	        deadline_epoch=args.deadline_epoch,
   431	        self_created_at_epoch=self_created_at_epoch,
   432	        freshness_skew_seconds=args.freshness_skew_seconds,
   433	    )
   434	    try:
   435	        payload = _load_payload(args.payload_file)
   436	    except (OSError, ValueError) as exc:
   437	        decision = Decision(BLOCK, "malformed-payload", {"error": str(exc)})
   438	    else:
   439	        decision = decide(payload, ctx)
   440	    if args.json:
   441	        print(json.dumps({
   442	            "decision": decision.decision,
   443	            "reason": decision.reason,
   444	            "facts": decision.facts,
   445	            "inputs": ctx._asdict(),
   446	        }, sort_keys=True, default=str))
   447	    else:
   448	        print(render(decision, ctx))
   449	    return decision.exit_code
   450	
   451	
   452	if __name__ == "__main__":
   453	    sys.exit(main())
     1	#!/usr/bin/env python3
     2	# ============================================================================
     3	# _release_bump_sites.py — the ONE source of truth for the release version
     4	# sites, and the only writer of them.
     5	#
     6	# Why a module and not a heredoc. Until PLAN-166/W0 this table lived inside
     7	# `release.sh` as a `python3 - <<'PY'` heredoc. That had two costs that both
     8	# showed up in the v1.3.0-rc.1 re-pass:
     9	#
    10	#   1. the site list existed TWICE — once in the heredoc (the writer) and once
    11	#      in the driver's `VERSION_FILES` array (the dry-run restore list). A list
    12	#      that must match another list by hand does not stay matched; a restore
    13	#      list shorter than the write list leaves debris (the S273 class).
    14	#   2. it was untestable. `--today` could not be pinned, so the D+1
    15	#      non-idempotence (F2) could not be exercised by a test.
    16	#
    17	# Both are closed here: the driver DERIVES its restore list from
    18	# `print-sites --include-generated`, and `--today` is a REQUIRED parameter with
    19	# NO DEFAULT (a parameter that changes the verdict never has a default —
    20	# frozen-evidence lesson).
    21	#
    22	# Idempotence contract (F2). A `last-reviewed:` stamp asserts "this document
    23	# was re-read FOR THIS RELEASE". Re-dating it without re-reading is a false
    24	# claim on a surface that a signed tag then covers. So the stamp sites
    25	# skip the ENTIRE line — neither date nor version — when the version already
    26	# on the stamp is the target. `--restamp` is the named, explicit route for a
    27	# real re-review.
    28	#
    29	# The two stamp oracles (do not collapse them). `npm/README.md` is watched by
    30	# verify-counts' VERSION_SITES; SBOM.md / SECURITY.md / VERSIONING.md are
    31	# watched ONLY by check-canonical-doc-freshness.py. Both oracles decide on the
    32	# VERSION in the stamp, never on the date — which is what makes freezing the
    33	# date safe.
    34	#
    35	# The support window (kinds "minor"/"prev_minor" — v1.3.0 re-pass, F-sites).
    36	# verify-counts' VERSION_SITES also watches "Current MINOR (vX.Y.x)" and
    37	# "Previous MINOR (vX.Y.x)" in SECURITY.md and VERSIONING.md (S293). Those
    38	# sites were OUTSIDE this table at birth, so the next MINOR bump would write
    39	# everything else, then DIE at the driver's own verify-counts call with a
    40	# half-written tree (outside --dry-run there is no restore trap). The rule the
    41	# oracle enforces is mechanical — Current = the target's minor, Previous = the
    42	# minor immediately before it — so this writer derives both from --target and
    43	# the "ONE source of truth" claim above stays true. The single non-derivable
    44	# case, an X.0.0 target, is SKIPPED loudly and never guessed: the oracle
    45	# cannot value-check it either (it derives prev="" at X.0), and a MAJOR
    46	# support-window transition is release-train judgment, not sed.
    47	# ============================================================================
    48	"""Release version-site table + writer (stdlib only, Python >= 3.9)."""
    49	
    50	from __future__ import annotations
    51	
    52	import argparse
    53	import os
    54	import re
    55	import sys
    56	from typing import Callable, List, Optional, Sequence, Tuple
    57	
    58	SEMVER = r"\d+\.\d+\.\d+"
    59	STAMP_RX = r"(last-reviewed: )(\d{4}-\d{2}-\d{2})( +v)(" + SEMVER + r")"
    60	DATE_RX = re.compile(r"\A\d{4}-\d{2}-\d{2}\Z")
    61	
    62	# Kinds:
    63	#   "plain"      — literal regex substitution, no stamp semantics.
    64	#   "stamp"      — "last-reviewed: <date> v<version>"; skipped wholesale when
    65	#                  the version already equals the target (unless --restamp).
    66	#   "minor"      — support-window site carrying the TARGET's minor (vX.Y.x).
    67	#   "prev_minor" — support-window site carrying the minor immediately BEFORE
    68	#                  the target; not derivable at X.0.0 (skipped loudly there).
    69	PLAIN = "plain"
    70	STAMP = "stamp"
    71	MINOR = "minor"
    72	PREV_MINOR = "prev_minor"
    73	
    74	# (path, kind, pattern) — patterns anchored exactly as their oracle checks
    75	# them, so historical version mentions elsewhere in the file are never touched.
    76	_SITES: List[Tuple[str, str, str]] = [
    77	    ("VERSION", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    78	    # PLAN-169 W2.6 (ledger E.1/F.7/A.0.4): the install-state marker is the
    79	    # surface check-framework-updates.sh reads MARKER-FIRST — a bump that
    80	    # skips it leaves every adopter's updater reporting behind-minor
    81	    # forever. Joins _SITES with its oracle mirror in verify-counts
    82	    # VERSION_SITES (no census numeral here: the F6 guard forbids
    83	    # site-count claims in comments, ordinals included).
    84	    (".claude/.framework-version", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    85	    ("npm/package.json", PLAIN, r'("version"\s*:\s*")' + SEMVER + r'(")'),
    86	    ("pyproject.toml", PLAIN, r'(?m)^(version\s*=\s*")' + SEMVER + r'(")'),
    87	    ("INSTALL.md", PLAIN, r"(--pin v)" + SEMVER),
    88	    (
    89	        "docs/ARCHITECTURE.md",
    90	        PLAIN,
    91	        r"(currently\s+v)" + SEMVER + r"(, aligned with the repo)",
    92	    ),
    93	    # README.md and CLAUDE.md are deliberately NOT rows here: neither is a
    94	    # version site. `VERSION=` never existed in either (verify-counts dropped
    95	    # its dead rules for both in S291 — `git log -S 'VERSION='` finds no
    96	    # commit that added one — and the release checklist states the same). A
    97	    # writer row for a site no oracle watches would be that dead rule
    98	    # reintroduced on the WRITE side: the day someone adds a `VERSION=` line
    99	    # to README.md, the bump would rewrite a file every other surface
   100	    # declares out of scope.
   101	    ("SBOM.md", PLAIN, r"(\*\*Version:\*\* `)" + SEMVER + r"(`)"),
   102	    # --- the support window (oracle: verify-counts VERSION_SITES modes
   103	    #     "minor"/"prev_minor", S293). Patterns anchored exactly as the
   104	    #     oracle's — SECURITY.md bolds the label, VERSIONING.md does not. ---
   105	    ("SECURITY.md", MINOR, r"(\*\*Current MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   106	    ("VERSIONING.md", MINOR, r"(Current MINOR \(`v)\d+\.\d+(\.x`\))"),
   107	    ("SECURITY.md", PREV_MINOR, r"(\*\*Previous MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   108	    ("VERSIONING.md", PREV_MINOR, r"(Previous MINOR \(`v)\d+\.\d+(\.x`\))"),
   109	    # --- the review stamps (idempotence-critical; the table IS the census,
   110	    #     a numeral here would be a mirror that drifts) ---
   111	    ("npm/README.md", STAMP, STAMP_RX),
   112	    ("SBOM.md", STAMP, STAMP_RX),
   113	    ("SECURITY.md", STAMP, STAMP_RX),
   114	    ("VERSIONING.md", STAMP, STAMP_RX),
   115	]
   116	
   117	# Written by the bump PHASE but not by this module: `build-plugin.py
   118	# --write-manifests` regenerates them from VERSION. They belong in any
   119	# derived restore/guard list, which is why they are exported here instead of
   120	# being re-typed by every caller (the duplicated-list failure this module
   121	# exists to kill).
   122	GENERATED_BY_BUMP: List[str] = [
   123	    ".claude-plugin/plugin.json",
   124	    ".claude-plugin/marketplace.json",
   125	]
   126	
   127	
   128	def site_paths(include_generated: bool = False) -> List[str]:
   129	    """Every path this module may write, de-duplicated, in table order."""
   130	    out: List[str] = []
   131	    for path, _kind, _rx in _SITES:
   132	        if path not in out:
   133	            out.append(path)
   134	    if include_generated:
   135	        for path in GENERATED_BY_BUMP:
   136	            if path not in out:
   137	                out.append(path)
   138	    return out
   139	
   140	
   141	def _plain_replacement(pattern: str, target: str) -> str:
   142	    """Replacement string for a PLAIN site, rebuilt from its group count."""
   143	    if pattern.startswith(r"\A"):  # the bare VERSION file
   144	        return target + "\n"
   145	    groups = re.compile(pattern).groups
   146	    if groups == 0:
   147	        return target
   148	    if groups == 1:
   149	        return r"\g<1>" + target
   150	    return r"\g<1>" + target + r"\g<2>"
   151	
   152	
   153	def _stamp_replacer(
   154	    target: str, today: str, restamp: bool
   155	) -> Callable[["re.Match"], str]:
   156	    def _repl(m: "re.Match") -> str:
   157	        if not restamp and m.group(4) == target:
   158	            # Defense in depth: the whole line is left byte-identical. Both
   159	            # stamp oracles read the VERSION, so freezing the date costs
   160	            # nothing and re-dating without re-reading would be a false claim.
   161	            return m.group(0)
   162	        return m.group(1) + today + m.group(3) + target
   163	
   164	    return _repl
   165	
   166	
   167	def bump(
   168	    target: str,
   169	    today: str,
   170	    *,
   171	    restamp: bool = False,
   172	    root: Optional[str] = None,
   173	    out=None,
   174	) -> int:
   175	    """Rewrite every version site to `target`. Returns files CHANGED."""
   176	    if not DATE_RX.match(today):
   177	        raise ValueError("--today must be YYYY-MM-DD, got %r" % (today,))
   178	    if not re.match(r"\A" + SEMVER + r"\Z", target):
   179	        raise ValueError("--target must be a bare semver, got %r" % (target,))
   180	    stream = out if out is not None else sys.stdout
   181	    base = root or os.getcwd()
   182	    # Support-window derivation, BEFORE any byte is written: whether every
