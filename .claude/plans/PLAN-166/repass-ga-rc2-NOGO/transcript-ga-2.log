     1	"""Behaviour battery for ``await_release_gate.decide`` (PLAN-166 W0 item 6, F1).
     2	
     3	The AC-2 enumeration in PLAN-166 is the ONLY source for what is covered here.
     4	No test count is asserted or written anywhere — a mirrored numeral has drifted
     5	from reality four times in this plan; the enumeration below IS the census.
     6	
     7	Case classes, in AC-2 order:
     8	
     9	* GRANT — exact candidate (release.yml + push + tag + sha + fresh) whose
    10	  ``release-gate`` job concluded ``success``. MANDATORY: without it an
    11	  always-BLOCK implementation would pass the entire battery.
    12	* NEVER-GRANT — payloads holding ONLY green NON-candidate runs (rc tag,
    13	  other sha, wrong workflow, workflow_dispatch). Each proves twice over that
    14	  a look-alike green run neither grants NOR falsely blocks the race.
    15	* BLOCK — candidate gate ``skipped``; candidate gate ``failure``; no
    16	  candidate with the deadline elapsed; malformed JSON.
    17	* WAIT — empty run list in time; candidate present with the ``release-gate``
    18	  job absent from the jobs payload in time (eventual consistency); candidate
    19	  with ``conclusion: null`` in time (this one kills the naive
    20	  ``!= "failure"`` implementation).
    21	* FRESHNESS — a ``success`` candidate created BEFORE the asking run started
    22	  (delete + re-tag of the same sha) does not count as GRANT.
    23	* USAGE — the freshness input is load-bearing, so it has no default:
    24	  omitting ``--self-created-at`` (or passing an empty value) is a usage
    25	  error (exit 2), NEVER a run with the delete+re-tag leg silently off.
    26	  Without this class the FRESHNESS tests above prove nothing about the W1
    27	  wiring — the same stale payload they reject becomes a GRANT the moment
    28	  the caller forgets one flag.
    29	"""
    30	
    31	from __future__ import annotations
    32	
    33	import calendar
    34	import json
    35	import os
    36	import subprocess
    37	import sys
    38	import tempfile
    39	import unittest
    40	from pathlib import Path
    41	
    42	# Env-hygiene gate (check-test-env-hygiene.py): test classes subclass
    43	# TestEnvContext, not bare unittest.TestCase, so HOME / CLAUDE_PROJECT_DIR /
    44	# os.environ / sys.path are snapshot-restored around every test.
    45	_HOOKS_DIR = Path(__file__).resolve().parents[2] / "hooks"
    46	if str(_HOOKS_DIR) not in sys.path:
    47	    sys.path.insert(0, str(_HOOKS_DIR))
    48	
    49	from _lib.testing import TestEnvContext  # noqa: E402
    50	
    51	from await_release_gate import (
    52	    BLOCK,
    53	    EXIT_BLOCK,
    54	    EXIT_GRANT,
    55	    EXIT_USAGE,
    56	    EXIT_WAIT,
    57	    GRANT,
    58	    WAIT,
    59	    GateContext,
    60	    decide,
    61	)
    62	
    63	SCRIPT = Path(__file__).resolve().parent.parent / "await_release_gate.py"
    64	
    65	TAG = "v1.3.0"
    66	HEAD_SHA = "a" * 40
    67	OTHER_SHA = "b" * 40
    68	
    69	# Independent clock: built with calendar.timegm, NOT with the module's own
    70	# parser, so the fixtures are not graded by the code under test.
    71	SELF_CREATED_AT = "2026-08-05T12:00:00Z"
    72	SELF_EPOCH = calendar.timegm((2026, 8, 5, 12, 0, 0, 0, 1, -1))
    73	CANDIDATE_CREATED_AT = "2026-08-05T12:00:05Z"       # same push, +5s jitter
    74	STALE_CREATED_AT = "2026-08-05T11:00:00Z"           # previous tag push, -1h
    75	NOW = SELF_EPOCH + 60
    76	DEADLINE_OPEN = SELF_EPOCH + 1800                   # 30 min of head-room
    77	NOW_PAST_DEADLINE = DEADLINE_OPEN + 1
    78	
    79	
    80	def ctx(now=NOW, deadline=DEADLINE_OPEN):
    81	    """Context with EVERY input pinned explicitly (no ambient clock)."""
    82	    return GateContext(
    83	        tag=TAG,
    84	        head_sha=HEAD_SHA,
    85	        now_epoch=now,
    86	        deadline_epoch=deadline,
    87	        self_created_at_epoch=SELF_EPOCH,
    88	        freshness_skew_seconds=120,
    89	    )
