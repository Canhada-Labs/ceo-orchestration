   351	    def test_real_repo_rule_liveness(self):
   352	        """S287 vacuous-gate class: every doc-gated metric must match >=1
   353	        site in the real repo's watched docs. A metric at 0 matches is a
   354	        DEAD gate — it reports "no drift" with a number nobody compares
   355	        (`registered` was dead from birth: derived 47 phantom, matched no
   356	        doc, said "no drift" for months)."""
   357	        env = os.environ.copy()
   358	        r = subprocess.run(
   359	            ["bash", str(SCRIPT), "--json", "--no-tests"],
   360	            capture_output=True, text=True, timeout=60, env=env)
   361	        self.assertEqual(r.returncode, 0, r.stdout)
   362	        data = json.loads(r.stdout)
   363	        self.assertIn("rule_matches", data)
   364	        dead = sorted(k for k, v in data["rule_matches"].items() if v == 0)
   365	        self.assertEqual(dead, [], f"dead doc-gate rules (0 matches): {dead}")
