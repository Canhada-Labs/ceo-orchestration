   426	def _pytest_scaffold(root: Path, cases: int = 100, broken: bool = False) -> None:
   427	    """Give the synthetic tree a REAL pytest-collect population so the gate's
   428	    full run (no --no-tests) derives a live `tests` value inside the tree."""
   429	    (root / "pytest.ini").write_text("[pytest]\ntestpaths = tests\n",
   430	                                     encoding="utf-8")
   431	    tdir = root / "tests"
   432	    tdir.mkdir(exist_ok=True)
   433	    (tdir / "test_ok.py").write_text(
   434	        "import pytest\n"
   435	        f"@pytest.mark.parametrize('i', range({cases}))\n"
   436	        "def test_p(i):\n    pass\n",
   437	        encoding="utf-8",
   438	    )
   439	    if broken:
   440	        (tdir / "test_broken.py").write_text(
   441	            "import module_that_does_not_exist_plan166_repass\n",
   442	            encoding="utf-8",
   443	        )
