   750	def iter_table_rows(text):
   751	    for line in text.splitlines():
   752	        s = line.strip()
   753	        if not (s.startswith('|') and s.endswith('|') and s.count('|') >= 3):
   754	            continue
   755	        cells = [c.strip() for c in s.strip('|').split('|')]
   756	        if len(cells) >= 2:
   757	            yield cells
   758	
   759	violations = []
   760	# S287 rule-liveness accounting: per-metric count of doc sites each rule
   761	# actually matched (prose + table cells). Exported in --json as
   762	# `rule_matches`; the real-repo test asserts every doc-gated metric >= 1
   763	# (a metric at 0 is a dead gate reporting "no drift" unchecked).
   764	rule_matches = {m: 0 for m, _, _ in RULES}
   765	for m, _, _ in TABLE_RULES:
   766	    rule_matches.setdefault(m, 0)
   767	# PER-DOCUMENT accounting (pair-rail R3, P2). Aggregate-per-metric
   768	# liveness is a FLOOR, not the proof: a rule matching 5 of 6 watched docs
   769	# looks alive while the 6th drifts — which is exactly how
   770	# `docs/GUIA-COMPLETO.md` sat stale at 44 hooks after the metric-level
   771	# rule was "fixed". `rule_matches_by_doc[(metric, doc)]` lets the
   772	# real-repo test assert an explicit expectation SET, so a document that
   773	# silently stops matching is a failure rather than an invisible hole.
   774	rule_matches_by_doc = {}
   775	
   776	
   777	def _note(metric, doc):
   778	    rule_matches[metric] = rule_matches.get(metric, 0) + 1
   779	    key = "%s@%s" % (metric, doc)
   780	    rule_matches_by_doc[key] = rule_matches_by_doc.get(key, 0) + 1
   781	
   782	for metric, kind, label_rx in TABLE_RULES:
   783	    lv = live[metric]
   784	    for doc in DOCS:
   785	        for cells in iter_table_rows(texts.get(doc, "")):
   786	            label = re.sub(r'[*`]', '', cells[0]).strip()
   787	            if not re.match(label_rx, label, re.IGNORECASE):
   788	                continue
   789	            value_cell = re.sub(r'[*`,]', '', cells[1])
   790	            m = re.search(r'(\d+)', value_cell)
   791	            if m is None:
   792	                continue
   793	            _note(metric, doc)
   794	            v = int(m.group(1))
   795	            if kind == "exact" and v != lv:
   796	                violations.append(
   797	                    f"{doc}: table row '{label}' cites {metric}={v}, live={lv}  (rule: exact/table-cell)"
   798	                )
   799	
   800	for metric, kind, regexes in RULES:
   801	    # tests under --no-tests: still COUNT matches (liveness stays
   802	    # observable) but never enforce against the skipped live value.
   803	    enforce = not (metric == "tests" and no_tests)
   804	    lv = live[metric]
   805	    # release_steps scans both DOCS and RELEASE_DOCS; all others scan only DOCS.
   806	    scan_docs = (DOCS + list(_RELEASE_STEPS_EXTRA_DOCS)
   807	                 if metric == "release_steps" else DOCS)
   808	    for doc in scan_docs:
   809	        text = texts.get(doc, "")
   810	        for rx in regexes:
   811	            for m in re.finditer(rx, text):
   812	                _note(metric, doc)
   813	                if not enforce:
   814	                    continue
   815	                v = int(m.group(1))
   816	                if kind == "exact" and v != lv:
   817	                    violations.append(
   818	                        f"{doc}: cites {metric}={v}, live={lv}  (rule: exact)"
   819	                    )
   820	                elif kind == "floor" and lv < v:
   821	                    violations.append(
   822	                        f"{doc}: cites {metric}>={v}+ but live={lv} (regression; rule: floor)"
   823	                    )
