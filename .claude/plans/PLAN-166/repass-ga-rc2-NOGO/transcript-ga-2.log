   177	# -------------------------------- sha256 emission ----------------------------
   178	# PLAN-019 DevOps-P2-3 — supply-chain tarball integrity.
   179	#
   180	# The shipped NPM tarball MUST carry a sha256 checksum so consumers + CI can
   181	# verify the bytes against what was produced locally. Emit the checksum next
   182	# to the tarball in NPM_DIR/SHA256SUMS.txt (cumulative file; one line per
   183	# build). CI verification (npm-publish.yml) computes the checksum of the
   184	# tarball it publishes and appends to the release notes.
   185	#
   186	# Format is `<64-hex>  <filename>` — compatible with `sha256sum -c` so a
   187	# consumer can do:
   188	#   curl -LO https://registry.npmjs.org/.../tarball
   189	#   curl -LO https://.../SHA256SUMS.txt
   190	#   sha256sum -c SHA256SUMS.txt
   191	#
   192	# Stdlib-only: prefer `sha256sum` (Linux / Ubuntu runners) then fall back
   193	# to `shasum -a 256` (macOS). python3 -m hashlib as last-resort fallback.
   194	SHA_MANIFEST="$NPM_DIR/SHA256SUMS.txt"
   195	if command -v sha256sum >/dev/null 2>&1; then
   196	  HASH_LINE=$(cd "$NPM_DIR" && sha256sum "$TARBALL")
   197	elif command -v shasum >/dev/null 2>&1; then
   198	  HASH_LINE=$(cd "$NPM_DIR" && shasum -a 256 "$TARBALL")
   199	else
   200	  HASH_HEX=$(python3 -c "
   201	import hashlib, sys
   202	h = hashlib.sha256()
   203	with open(sys.argv[1], 'rb') as f:
   204	    for chunk in iter(lambda: f.read(65536), b''):
   205	        h.update(chunk)
   206	print(h.hexdigest())
   207	" "$TARBALL_PATH")
   208	  HASH_LINE="${HASH_HEX}  ${TARBALL}"
   209	fi
   210	
   211	# Normalise output to exactly two spaces between hash + filename (sha256sum
   212	# -c strict format), strip any extra whitespace introduced by BSD shasum.
   213	HASH_HEX="${HASH_LINE%% *}"
   214	HASH_LINE="${HASH_HEX}  ${TARBALL}"
   215	
   216	# Dedup-or-append (PLAN-023 Phase A F-comp-002 follow-up): replace any
   217	# existing line for the same filename in-place, else append. Prevents
   218	# SHA256SUMS.txt from accumulating stale entries across local rebuilds
   219	# (previously observed: 51 stale entries before PLAN-025 Batch I reset).
   220	# Preserves header comment lines (starting with #) untouched.
   221	if [[ -f "$SHA_MANIFEST" ]] && grep -qE "  ${TARBALL}\$" "$SHA_MANIFEST" 2>/dev/null; then
   222	  # Replace existing line for this filename.
   223	  TMP_MANIFEST="$(mktemp -t ceo-sha-manifest.XXXXXX)"
   224	  awk -v tb="$TARBALL" -v line="$HASH_LINE" '
   225	    $0 ~ ("  " tb "$") { print line; found=1; next }
   226	    { print }
   227	    END { if (!found) print line }
   228	  ' "$SHA_MANIFEST" > "$TMP_MANIFEST"
   229	  mv "$TMP_MANIFEST" "$SHA_MANIFEST"
   230	  echo "OK: sha256 = $HASH_HEX"
   231	  echo "    updated $SHA_MANIFEST (replaced existing line)"
   232	else
   233	  echo "$HASH_LINE" >> "$SHA_MANIFEST"
   234	  echo "OK: sha256 = $HASH_HEX"
   235	  echo "    appended to $SHA_MANIFEST"
   236	fi
   237	
   238	# Remove any stale sidecar files for tarball names OTHER than the current
   239	# one. Keeps the npm/ directory free of version-drift sidecars between
   240	# RC→GA cuts (previously observed: 1.5.0-rc.1.tgz.sha256 lingered after
   241	# 1.6.0-rc.1 bump). Glob over ceo-orchestration-*.tgz.sha256 pattern.
   242	for stale in "$NPM_DIR"/ceo-orchestration-*.tgz.sha256; do
   243	  [[ -f "$stale" ]] || continue
   244	  stale_name="$(basename "$stale" .sha256)"
   245	  if [[ "$stale_name" != "$TARBALL" ]]; then
   246	    rm -f "$stale"
   247	    echo "    pruned stale sidecar: $stale_name.sha256"
   248	  fi
   249	done
   250	
   251	# Also emit a single-purpose .sha256 sidecar alongside the tarball so CI
   252	# can download it separately without parsing the cumulative manifest.
   253	echo "$HASH_HEX  $TARBALL" > "$TARBALL_PATH.sha256"
   254	echo "    sidecar written $TARBALL_PATH.sha256"
