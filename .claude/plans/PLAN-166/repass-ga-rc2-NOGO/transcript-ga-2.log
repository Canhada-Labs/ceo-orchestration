   825	# ============================  APPROX EVALUATION  ===========================
   826	# Three failure modes (band, cross-doc equality, missing `~` marker), one
   827	# non-failure mode (registered PENDING site), and a printed input record for
   828	# every metric. See the APPROX CONTRACT block at the top of the file.
   829	warnings = []
   830	pending = []
   831	approx_sites = []        # [{metric, doc, cited, pending}]
   832	_approx_consumed = {}    # doc -> set of char offsets of `~` already consumed
   833	
   834	
   835	def _consume(doc, off):
   836	    _approx_consumed.setdefault(doc, set()).add(off)
   837	
   838	
   839	def _record_approx(metric, doc, raw, off):
   840	    _note(metric, doc)
   841	    _consume(doc, off)
   842	    cited = approx_norm(raw)
   843	    if cited is None:
   844	        violations.append(
   845	            "%s: %s approx claim '~%s' is not a parseable figure"
   846	            "  (rule: approx/shape)" % (doc, metric, raw)
   847	        )
   848	        return
   849	    approx_sites.append({"metric": metric, "doc": doc, "cited": cited})
   850	
   851	
   852	for _metric, _regexes in APPROX_RULES:
   853	    for _doc in DOCS:
   854	        _text = texts.get(_doc, "")
   855	        for _rx in _regexes:
   856	            for _m in re.finditer(_rx, _text):
   857	                _record_approx(_metric, _doc, _m.group(1), _m.start())
   858	
   859	# Table-cell sites: the numeral sits alone in the VALUE cell with no noun
   860	# after it, so the prose regexes above are structurally blind to it.
   861	for _doc in DOCS:
   862	    _off = 0
   863	    for _line in texts.get(_doc, "").splitlines(True):
   864	        _s = _line.strip()
   865	        if _s.startswith('|') and _s.endswith('|') and _s.count('|') >= 3:
   866	            _cells = [c.strip() for c in _s.strip('|').split('|')]
   867	            if len(_cells) >= 2:
   868	                _label = re.sub(r'[*`]', '', _cells[0]).strip()
   869	                for _metric, _label_rx in APPROX_TABLE_RULES:
   870	                    if not re.match(_label_rx, _label, re.IGNORECASE):
   871	                        continue
   872	                    _cm = re.search(_APPROX_NUM, _cells[1])
   873	                    if _cm is None:
   874	                        # An approx metric written as a bare exact integer
   875	                        # claims a precision this gate cannot honour, and the
   876	                        # row would otherwise go completely unchecked (that is
   877	                        # how docs/CTO-GUIDE.md sat at "| Test files | 676 |").
   878	                        if re.search(r'\d', _cells[1]):
   879	                            violations.append(
   880	                                "%s: table row '%s' cites %s WITHOUT the '~' "
   881	                                "marker (%r); approx metrics must be written "
   882	                                "'~N'  (rule: approx/table-cell)"
   883	                                % (_doc, _label, _metric, _cells[1])
   884	                            )
   885	                        continue
   886	                    _lm = re.search(_APPROX_NUM, _line)
   887	                    _record_approx(_metric, _doc, _cm.group(1),
   888	                                   _off + (_lm.start() if _lm else 0))
   889	        _off += len(_line)
   890	
   891	_by_metric = {}
   892	for _site in approx_sites:
   893	    _by_metric.setdefault(_site["metric"], []).append(_site)
   894	
   895	for _metric in sorted(_by_metric):
   896	    _sites = _by_metric[_metric]
   897	    _in = APPROX_INPUTS.get(_metric)
   898	    _lv = _in["observed"] if _in else live.get(_metric, 0)
   899	    # A live value of 0 means the derivation could not run in this tree (no
   900	    # git work tree, --no-tests). A +/-5% band around 0 rejects every possible
   900	    # git work tree, --no-tests). A +/-5% band around 0 rejects every possible
   901	    # doc figure, so enforcement is suspended and the fact is WARNED, never
   902	    # silently skipped.
   903	    _skip = bool(_in and _in["skipped"]) or _lv <= 0
   904	    _tol = _lv * APPROX_BAND
   905	    _pool = {}
   906	    for _site in _sites:
   907	        _frozen = _pending_index.get((_site["doc"], _metric))
   908	        if _frozen is not None and _site["cited"] == _frozen[0]:
   909	            _site["pending"] = True
   910	            pending.append(
   911	                "%s: %s=~%d is a REGISTERED PENDING site (live=%d, band "
   912	                "+/-%d%%). %s" % (_site["doc"], _metric, _site["cited"],
   913	                                  _lv, int(APPROX_BAND * 100), _frozen[1])
   914	            )
   915	            continue
   916	        _site["pending"] = False
   917	        _pool.setdefault(_site["cited"], []).append(_site["doc"])
   918	        if _skip:
   919	            continue
   920	        if abs(_site["cited"] - _lv) > _tol:
   921	            violations.append(
   922	                "%s: cites %s=~%d, live=%d — OUTSIDE the +/-%d%% band "
   923	                "[%d..%d]  (rule: approx; measured by `%s`)"
   924	                % (_site["doc"], _metric, _site["cited"], _lv,
   925	                   int(APPROX_BAND * 100), int(_lv - _tol), int(_lv + _tol),
   926	                   (_in or {}).get("command", "n/a"))
   927	            )
   928	    if len(_pool) > 1:
   929	        _detail = "; ".join(
   930	            "~%d in %s" % (v, ", ".join(sorted(set(ds))))
   931	            for v, ds in sorted(_pool.items())
   932	        )
   933	        violations.append(
   934	            "approx metric '%s' is cited with DIFFERENT figures across "
   935	            "watched docs: %s  (rule: approx/cross-doc-equality)"
   936	            % (_metric, _detail)
   937	        )
   938	
   939	# Inputs of the band, surfaced as named WARNINGs (contract clause 3).
   940	for _metric in sorted(APPROX_INPUTS):
   941	    _in = APPROX_INPUTS[_metric]
   942	    if _in["skipped"]:
   943	        warnings.append(
   944	            "approx metric '%s': live measurement SKIPPED (--no-tests) — the "
   945	            "band is NOT enforced this run" % _metric
   946	        )
   947	        continue
   948	    if _in["collect_errors"]:
   949	        _msg = (
   950	            "approx metric '%s': %d COLLECTION ERROR(S) in `%s` — the observed "
   951	            "value (%d) is measured over a PARTIAL population, so the +/-%d%% "
   952	            "band is being applied to the wrong number. Fix the collection "
   953	            "errors before trusting this rule."
   954	            % (_metric, _in["collect_errors"], _in["command"],
   955	               _in["observed"], int(APPROX_BAND * 100))
   956	        )
   957	        # Contract clause 3 (PLAN-166 W0 re-pass): when the band was actually
   958	        # ENFORCED over >=1 doc site this run, a partial population makes the
   959	        # verdict untrustworthy — and the automated callers (validate.yml
   960	        # --quiet, the release preflight piping to /dev/null) can only see
   961	        # the exit code, so this MUST fail the gate, not warn into a void.
   962	        # It stays a warning only when the band is already suspended
   963	        # (observed<=0) — there is no verdict to corrupt then.
   964	        _enforced_sites = [
   965	            s for s in approx_sites
   966	            if s["metric"] == _metric and not s.get("pending")
   967	        ]
   968	        if _enforced_sites and _in["observed"] > 0:
   969	            violations.append(_msg + "  (rule: approx/collect-errors)")
   970	        else:
   971	            warnings.append(_msg)
   972	    if _in["observed"] <= 0:
   973	        warnings.append(
   974	            "approx metric '%s': `%s` returned 0 — the rule is VACUOUS in this "
   975	            "tree (band suspended)" % (_metric, _in["command"])
   976	        )
