  1020	    # design (they point at the VERSION file). Every remaining site is
  1021	    # liveness-accounted below — a site that matches nothing now FAILS.
  1022	    VERSION_SITES = [
  1023	        ("INSTALL.md", r'--pin v(\d+\.\d+\.\d+)', "full"),
  1024	        # PLAN-161 V1 — current-version declaration sites in the newly-watched
  1025	        # docs (the npm README review stamp is a deliberate release tripwire:
  1026	        # a version bump forces a fresh review of the npm-facing copy).
  1027	        ("docs/ARCHITECTURE.md", r'currently\s+v(\d+\.\d+\.\d+), aligned with the repo', "full"),
  1028	        ("npm/README.md", r'last-reviewed: \d{4}-\d{2}-\d{2} v(\d+\.\d+\.\d+)', "full"),
  1029	        # S293 (codex NO-GO no rc.1 do v1.3.0 — P0s 2-4): TRÊS declarações de
  1030	        # versão corrente que estavam FORA desta lista e ficaram stale no
