   331	      - name: Populate install.sh self-SHA trailer (P0-15, PLAN-045)
   332	        # PLAN-045 F-15R2-01 / Session 41: install.sh ships with a
   333	        # `# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL` trailer as its
   334	        # last line. At publish time, compute sha256 of the script body
   335	        # (all lines EXCEPT the last) and substitute the placeholder with
   336	        # the real hex. The script's own self-verify logic reads the same
   337	        # last-line pattern, so downstream adopters running
   338	        # `bash install.sh ...` trigger a rc=5 fail-CLOSED if the script
   339	        # is modified in transit.
   340	        working-directory: npm
   341	        run: |
   342	          set -euo pipefail
   343	          FILE="scripts/install.sh"
   344	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   345	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   346	            echo "::error::$FILE trailer not at expected placeholder state"
   347	            echo "got: $TRAILER_LINE"
   348	            exit 1
   349	          fi
   350	          # Compute sha of everything EXCEPT the last line.
   351	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
   352	          # In-place substitute ONLY the last line.
   353	          awk -v hash="$HASH" '
   354	            NR == FNR { total = NR; next }
   355	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   356	            { print }
   357	          ' "$FILE" "$FILE" > "$FILE.new"
   358	          mv "$FILE.new" "$FILE"
   359	          chmod +x "$FILE"
   360	          # Smoke-verify: execute the self-verify branch by running
   361	          # the script without args (hits _verify_self_sha, then usage).
   362	          bash "$FILE" 2>&1 | head -3 || true
   363	          echo "OK: install.sh trailer populated with sha256 $HASH"
