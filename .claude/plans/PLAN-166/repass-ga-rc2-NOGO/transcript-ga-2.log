   388	      - name: Validate install.sh self-SHA mechanism (P0-15, PLAN-045)
   389	        # PLAN-045 F-15R2-01 / Session 41: end-to-end validation that
   390	        # the install.sh self-SHA verification works. We (a) confirm the
   391	        # placeholder is still present (source checkout state), (b) compute
   392	        # the expected sha, (c) substitute it into a temp copy, (d) run the
   393	        # temp copy — self-verify passes → rc=1 (usage exit, not rc=5).
   394	        run: |
   395	          set -euo pipefail
   396	          FILE="scripts/install.sh"
   397	          # (a) Placeholder must be present in source tree.
   398	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   399	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   400	            echo "::error::Source install.sh trailer has drifted from placeholder."
   401	            echo "got: $TRAILER_LINE"
   402	            exit 1
   403	          fi
   404	          # (b) + (c) stage a populated copy in a scratch dir.
   405	          SCRATCH="$(mktemp -d -t ceo-selfsha-XXXXXX)"
   406	          cp "$FILE" "$SCRATCH/install.sh"
   407	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$SCRATCH/install.sh" "$SCRATCH/install.sh" | sha256sum | awk '{print $1}')
   408	          awk -v hash="$HASH" '
   409	            NR == FNR { total = NR; next }
   410	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   411	            { print }
   412	          ' "$SCRATCH/install.sh" "$SCRATCH/install.sh" > "$SCRATCH/install.sh.new"
   413	          mv "$SCRATCH/install.sh.new" "$SCRATCH/install.sh"
   414	          chmod +x "$SCRATCH/install.sh"
   415	          # (d) Run the populated copy with no args; must exit rc=1
   416	          #     (usage), NOT rc=5 (self-SHA mismatch).
   417	          set +e
   418	          bash "$SCRATCH/install.sh" > /dev/null 2>"$SCRATCH/err"
   419	          RC=$?
   420	          set -e
   421	          if [ "$RC" -eq 5 ]; then
   422	            echo "::error::populated install.sh still rc=5 — self-SHA mechanism broken"
   423	            cat "$SCRATCH/err"
   424	            exit 1
   425	          fi
   426	          if [ "$RC" -ne 1 ]; then
   427	            echo "::error::populated install.sh rc=$RC (expected 1 for usage exit)"
   428	            cat "$SCRATCH/err"
   429	            exit 1
   430	          fi
   431	          # (e) Tamper test: mutate body, verify rc=5.
   432	          # Prepend malicious line before the trailer
   433	          head -n -1 "$SCRATCH/install.sh" > "$SCRATCH/install.sh.tmp1"
   434	          echo 'echo "MALICIOUS_INJECT" >&2' >> "$SCRATCH/install.sh.tmp1"
   435	          tail -n 1 "$SCRATCH/install.sh" >> "$SCRATCH/install.sh.tmp1"
   436	          chmod +x "$SCRATCH/install.sh.tmp1"
   437	          set +e
   438	          bash "$SCRATCH/install.sh.tmp1" > /dev/null 2>"$SCRATCH/err2"
   439	          RC2=$?
   440	          set -e
   441	          if [ "$RC2" -ne 5 ]; then
   442	            echo "::error::tampered install.sh did NOT rc=5 (got $RC2) — self-SHA gate broken"
   443	            cat "$SCRATCH/err2"
   444	            exit 1
   445	          fi
   446	          echo "OK: install.sh self-SHA mechanism end-to-end validated"
   447	          rm -rf "$SCRATCH"
