   657	      #   - verdict.parent_sha == git log -n1 --format=%H -- <verdict-file>^
   658	      #   - verdict.release_tag == ${GITHUB_REF_NAME}  (replay defense)
   659	      #   - verdict.tool_versions.codex_cli in codex-cli-pin.txt range
   660	      #   - verdict.tool_versions.codex_payload_sha256 (+ codex_target_triple)
   661	      #     == codex-cli-pin-manifest.json payloads[<triple>].sha256
   662	      #     (ADR-182 payload pin — the sha of the NATIVE codex payload,
   663	      #     not the npm JS launcher; PLAN-163 T5.2. The legacy
   664	      #     codex_cli_binary_sha256 launcher pin is retained only for
