   457	# The numeral shape an approx claim MUST be written in: a tilde, then digits
   458	# with optional thousands separators (`,` EN / `.` pt-BR) or a `k` suffix.
   459	# One capturing group, always.
   460	_APPROX_NUM = r'~\s*(\d[\d.,]*\s*[kKmM]?)'
   461	
   462	
   463	def approx_norm(raw):
   464	    """'14,000' / '14.000' / '14k' / '730' -> int. None when unparseable.
   465	
   466	    Separator-agnostic on purpose: README.md writes ~14,000 and
   467	    README.pt-BR.md writes ~14.000 and they are the SAME claim, so the
   468	    cross-doc equality check must see the same integer for both.
   469	    """
   470	    s = (raw or "").strip().lower().replace(" ", "").rstrip(".,")
   471	    mult = 1
   472	    if s.endswith("k"):
   473	        mult, s = 1000, s[:-1]
   474	        # Decimal-k (PLAN-166 W0 re-pass): a '.'/',' followed by 1-2 digits
   475	        # before the k is a DECIMAL, not a thousands separator — "~1.4k" is
   476	        # 1,400. The old separator-strip path normalized it to 14,000, a
   477	        # 10x error in the FALSE-PASS direction (a doc citing ~1.4k sailed
   478	        # through a band around a live ~14,000). Integer math, no float.
   479	        _dm = re.fullmatch(r'(\d+)[.,](\d{1,2})', s)
   480	        if _dm:
   481	            _whole, _frac = _dm.group(1), _dm.group(2)
   482	            return int(_whole) * 1000 + int(_frac) * (10 ** (3 - len(_frac)))
   483	    s = s.replace(",", "").replace(".", "")
   484	    if not s.isdigit():
   485	        return None
   486	    return int(s) * mult
