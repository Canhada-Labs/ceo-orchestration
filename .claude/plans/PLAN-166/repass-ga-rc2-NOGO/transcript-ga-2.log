   328	    def test_real_repo_per_document_liveness(self):
   329	        """Every watched (metric, doc) pair must match its EXACT count.
   330	
   331	        Both directions are failures: a pair that drops below its count
   332	        is silent coverage loss; a pair that appears or grows without the
   333	        manifest being updated is an unratified claim site."""
   334	        r = subprocess.run(
   335	            ["bash", str(SCRIPT), "--json", "--no-tests"],
   336	            capture_output=True, text=True, timeout=60, env=os.environ.copy())
   337	        self.assertEqual(r.returncode, 0, r.stdout)
   338	        by_doc = json.loads(r.stdout).get("rule_matches_by_doc", {})
   339	        # The dict diff is long and unreadable; the named lists below are
   340	        # the actionable part, so show them rather than the raw diff.
   341	        self.maxDiff = None
   342	        self.assertEqual(
   343	            by_doc, self._EXPECTED_SITES,
   344	            "watched claim sites drifted from the ratified manifest. "
   345	            "Lost: {0}. Unratified/new: {1}.".format(
   346	                sorted(k for k in self._EXPECTED_SITES
   347	                       if by_doc.get(k, 0) != self._EXPECTED_SITES[k]),
   348	                sorted(k for k in by_doc if k not in self._EXPECTED_SITES),
   349	            ))
