   357	_adr_file() {  # echo the first ADR-<n>-*.md path that actually exists, else ""
   358	  local n="$1" hit
   359	  for hit in "$REPO_ROOT"/.claude/adr/ADR-"$n"-*.md; do
   360	    if [ -e "$hit" ]; then printf '%s\n' "$hit"; return 0; fi
   361	  done
   362	  return 0
   363	}
