   670	      #
   671	      # continue-on-error: ONLY when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 env
   672	      # explicitly set (e.g. legacy rc tags pre-verdict-rollout). Default is
   673	      # hard-block on any validator failure.
   674	      - name: Validate pair-rail verdict (PLAN-081 Phase 6-bis step 15)
   675	        env:
   676	          # Codex iter-8 P1 fix: source the env var from a repository
   677	          # variable so the `continue-on-error` expression has something
   678	          # to evaluate against. Owner sets via `gh variable set
   679	          # CEO_PAIR_RAIL_VERDICT_OPTIONAL --body 1` for transition mode
   680	          # (e.g. legacy v1.16.0-era verdicts shipping only commit_sha:);
   681	          # unset / 0 = hard-block (default).
   682	          CEO_PAIR_RAIL_VERDICT_OPTIONAL: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL || '0' }}
   683	        continue-on-error: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL == '1' }}
   684	        run: |
   685	          set -euo pipefail
   686	          VERDICT_FILE=".claude/governance/pair-rail-verdict-${GITHUB_REF_NAME}.md"
   687	          if [ ! -f "$VERDICT_FILE" ]; then
   688	            if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL:-0}" = "1" ]; then
   689	              echo "::notice::no verdict file at $VERDICT_FILE; CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 → skipping"
   690	              exit 0
   691	            fi
   692	            echo "::error::verdict file missing at $VERDICT_FILE — step 15 blocks release"
   693	            exit 1
   694	          fi
   695	          # S104 redesign: resolve PARENT_SHA = parent of the verdict-file
   696	          # commit. The tag commit (${GITHUB_SHA}) is what we're releasing,
   697	          # and the verdict file at $VERDICT_FILE either:
   698	          #   (a) was committed in the tag commit itself → parent = ${GITHUB_SHA}^
   699	          #   (b) was committed earlier (multi-commit prep) → parent = git log of file
   700	          # We use (b)'s general form: find the commit that introduced the
   701	          # current verdict file, then take its parent. This handles both
   702	          # single-commit-with-verdict and multi-commit-prep flows.
