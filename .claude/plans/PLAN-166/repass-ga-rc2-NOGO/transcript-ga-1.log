   594	  # Refuse on uncommitted target .claude/ changes unless CEO_ORCH_FORCE=1
   595	  if [[ -d "$TARGET/.claude" ]] && [[ -d "$TARGET/.git" ]] && [[ "${CEO_ORCH_FORCE:-0}" != "1" ]]; then
