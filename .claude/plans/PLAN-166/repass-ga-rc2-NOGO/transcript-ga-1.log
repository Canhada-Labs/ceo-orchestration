   581	if [[ -n "$PIN_REF" ]]; then
   582	  if ! pushd "$SOURCE_DIR" >/dev/null; then
   583	    echo "ERROR: cannot cd to source repo: $SOURCE_DIR" >&2
   584	    exit 1
   585	  fi
   586	  if ! git rev-parse --verify "$PIN_REF" >/dev/null 2>&1; then
   587	    echo "ERROR: unknown --pin ref: $PIN_REF" >&2
   588	    popd >/dev/null || true
   589	    exit 2
   590	  fi
   591	  ORIGINAL_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
   592	  popd >/dev/null || true
