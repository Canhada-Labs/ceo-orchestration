+  elif [ ! -e "$_olt_p" ]; then printf 'absent'
+  elif [ -p "$_olt_p" ] || [ -S "$_olt_p" ]; then printf 'special'
+  elif [ -d "$_olt_p" ]; then
+    if [ -z "$( ls -A "$_olt_p" 2>/dev/null )" ]; then printf 'dir_empty'; else printf 'dir'; fi
+  elif [ -f "$_olt_p" ]; then printf 'regular'
