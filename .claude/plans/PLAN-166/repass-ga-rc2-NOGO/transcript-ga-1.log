   269	# ---------------------------------------------------------------------------
   270	# Preflight — every gate fail-closed. Mirrors `.github/release-checklist.md`
   271	# and runs the SAME suites CI runs (a subset gate passes while CI is red; that
   272	# lesson is expensive and already paid).
   273	# ---------------------------------------------------------------------------
     1	#!/usr/bin/env python3
     2	# ============================================================================
     3	# _release_bump_sites.py — the ONE source of truth for the release version
     4	# sites, and the only writer of them.
     5	#
     6	# Why a module and not a heredoc. Until PLAN-166/W0 this table lived inside
     7	# `release.sh` as a `python3 - <<'PY'` heredoc. That had two costs that both
     8	# showed up in the v1.3.0-rc.1 re-pass:
     9	#
    10	#   1. the site list existed TWICE — once in the heredoc (the writer) and once
    11	#      in the driver's `VERSION_FILES` array (the dry-run restore list). A list
    12	#      that must match another list by hand does not stay matched; a restore
    13	#      list shorter than the write list leaves debris (the S273 class).
    14	#   2. it was untestable. `--today` could not be pinned, so the D+1
    15	#      non-idempotence (F2) could not be exercised by a test.
    16	#
    17	# Both are closed here: the driver DERIVES its restore list from
    18	# `print-sites --include-generated`, and `--today` is a REQUIRED parameter with
    19	# NO DEFAULT (a parameter that changes the verdict never has a default —
    20	# frozen-evidence lesson).
    21	#
    22	# Idempotence contract (F2). A `last-reviewed:` stamp asserts "this document
    23	# was re-read FOR THIS RELEASE". Re-dating it without re-reading is a false
    24	# claim on a surface that a signed tag then covers. So the stamp sites
    25	# skip the ENTIRE line — neither date nor version — when the version already
    26	# on the stamp is the target. `--restamp` is the named, explicit route for a
    27	# real re-review.
    28	#
    29	# The two stamp oracles (do not collapse them). `npm/README.md` is watched by
    30	# verify-counts' VERSION_SITES; SBOM.md / SECURITY.md / VERSIONING.md are
    31	# watched ONLY by check-canonical-doc-freshness.py. Both oracles decide on the
    32	# VERSION in the stamp, never on the date — which is what makes freezing the
    33	# date safe.
    34	#
    35	# The support window (kinds "minor"/"prev_minor" — v1.3.0 re-pass, F-sites).
    36	# verify-counts' VERSION_SITES also watches "Current MINOR (vX.Y.x)" and
    37	# "Previous MINOR (vX.Y.x)" in SECURITY.md and VERSIONING.md (S293). Those
    38	# sites were OUTSIDE this table at birth, so the next MINOR bump would write
    39	# everything else, then DIE at the driver's own verify-counts call with a
    40	# half-written tree (outside --dry-run there is no restore trap). The rule the
    41	# oracle enforces is mechanical — Current = the target's minor, Previous = the
    42	# minor immediately before it — so this writer derives both from --target and
    43	# the "ONE source of truth" claim above stays true. The single non-derivable
    44	# case, an X.0.0 target, is SKIPPED loudly and never guessed: the oracle
    45	# cannot value-check it either (it derives prev="" at X.0), and a MAJOR
    46	# support-window transition is release-train judgment, not sed.
    47	# ============================================================================
    48	"""Release version-site table + writer (stdlib only, Python >= 3.9)."""
    49	
    50	from __future__ import annotations
    51	
    52	import argparse
    53	import os
    54	import re
    55	import sys
    56	from typing import Callable, List, Optional, Sequence, Tuple
    57	
    58	SEMVER = r"\d+\.\d+\.\d+"
    59	STAMP_RX = r"(last-reviewed: )(\d{4}-\d{2}-\d{2})( +v)(" + SEMVER + r")"
    60	DATE_RX = re.compile(r"\A\d{4}-\d{2}-\d{2}\Z")
    61	
    62	# Kinds:
    63	#   "plain"      — literal regex substitution, no stamp semantics.
    64	#   "stamp"      — "last-reviewed: <date> v<version>"; skipped wholesale when
    65	#                  the version already equals the target (unless --restamp).
    66	#   "minor"      — support-window site carrying the TARGET's minor (vX.Y.x).
    67	#   "prev_minor" — support-window site carrying the minor immediately BEFORE
    68	#                  the target; not derivable at X.0.0 (skipped loudly there).
    69	PLAIN = "plain"
    70	STAMP = "stamp"
    71	MINOR = "minor"
    72	PREV_MINOR = "prev_minor"
    73	
    74	# (path, kind, pattern) — patterns anchored exactly as their oracle checks
    75	# them, so historical version mentions elsewhere in the file are never touched.
    76	_SITES: List[Tuple[str, str, str]] = [
    77	    ("VERSION", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    78	    # PLAN-169 W2.6 (ledger E.1/F.7/A.0.4): the install-state marker is the
    79	    # surface check-framework-updates.sh reads MARKER-FIRST — a bump that
    80	    # skips it leaves every adopter's updater reporting behind-minor
    81	    # forever. Joins _SITES with its oracle mirror in verify-counts
    82	    # VERSION_SITES (no census numeral here: the F6 guard forbids
    83	    # site-count claims in comments, ordinals included).
    84	    (".claude/.framework-version", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    85	    ("npm/package.json", PLAIN, r'("version"\s*:\s*")' + SEMVER + r'(")'),
    86	    ("pyproject.toml", PLAIN, r'(?m)^(version\s*=\s*")' + SEMVER + r'(")'),
    87	    ("INSTALL.md", PLAIN, r"(--pin v)" + SEMVER),
    88	    (
    89	        "docs/ARCHITECTURE.md",
    90	        PLAIN,
    91	        r"(currently\s+v)" + SEMVER + r"(, aligned with the repo)",
    92	    ),
    93	    # README.md and CLAUDE.md are deliberately NOT rows here: neither is a
    94	    # version site. `VERSION=` never existed in either (verify-counts dropped
    95	    # its dead rules for both in S291 — `git log -S 'VERSION='` finds no
    96	    # commit that added one — and the release checklist states the same). A
    97	    # writer row for a site no oracle watches would be that dead rule
    98	    # reintroduced on the WRITE side: the day someone adds a `VERSION=` line
    99	    # to README.md, the bump would rewrite a file every other surface
   100	    # declares out of scope.
   101	    ("SBOM.md", PLAIN, r"(\*\*Version:\*\* `)" + SEMVER + r"(`)"),
   102	    # --- the support window (oracle: verify-counts VERSION_SITES modes
   103	    #     "minor"/"prev_minor", S293). Patterns anchored exactly as the
   104	    #     oracle's — SECURITY.md bolds the label, VERSIONING.md does not. ---
   105	    ("SECURITY.md", MINOR, r"(\*\*Current MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   106	    ("VERSIONING.md", MINOR, r"(Current MINOR \(`v)\d+\.\d+(\.x`\))"),
   107	    ("SECURITY.md", PREV_MINOR, r"(\*\*Previous MINOR\*\* \(`v)\d+\.\d+(\.x`\))"),
   108	    ("VERSIONING.md", PREV_MINOR, r"(Previous MINOR \(`v)\d+\.\d+(\.x`\))"),
   109	    # --- the review stamps (idempotence-critical; the table IS the census,
   110	    #     a numeral here would be a mirror that drifts) ---
   111	    ("npm/README.md", STAMP, STAMP_RX),
   112	    ("SBOM.md", STAMP, STAMP_RX),
   113	    ("SECURITY.md", STAMP, STAMP_RX),
   114	    ("VERSIONING.md", STAMP, STAMP_RX),
   115	]
   116	
   117	# Written by the bump PHASE but not by this module: `build-plugin.py
   118	# --write-manifests` regenerates them from VERSION. They belong in any
   119	# derived restore/guard list, which is why they are exported here instead of
   120	# being re-typed by every caller (the duplicated-list failure this module
   121	# exists to kill).
   122	GENERATED_BY_BUMP: List[str] = [
   123	    ".claude-plugin/plugin.json",
   124	    ".claude-plugin/marketplace.json",
   125	]
   126	
   127	
   128	def site_paths(include_generated: bool = False) -> List[str]:
   129	    """Every path this module may write, de-duplicated, in table order."""
   130	    out: List[str] = []
   131	    for path, _kind, _rx in _SITES:
   132	        if path not in out:
   133	            out.append(path)
   134	    if include_generated:
   135	        for path in GENERATED_BY_BUMP:
   136	            if path not in out:
   137	                out.append(path)
   138	    return out
   139	
   140	
   141	def _plain_replacement(pattern: str, target: str) -> str:
   142	    """Replacement string for a PLAIN site, rebuilt from its group count."""
   143	    if pattern.startswith(r"\A"):  # the bare VERSION file
   144	        return target + "\n"
   145	    groups = re.compile(pattern).groups
   146	    if groups == 0:
   147	        return target
   148	    if groups == 1:
   149	        return r"\g<1>" + target
   150	    return r"\g<1>" + target + r"\g<2>"
   151	
   152	
   153	def _stamp_replacer(
   154	    target: str, today: str, restamp: bool
   155	) -> Callable[["re.Match"], str]:
   156	    def _repl(m: "re.Match") -> str:
   157	        if not restamp and m.group(4) == target:
   158	            # Defense in depth: the whole line is left byte-identical. Both
   159	            # stamp oracles read the VERSION, so freezing the date costs
   160	            # nothing and re-dating without re-reading would be a false claim.
   161	            return m.group(0)
   162	        return m.group(1) + today + m.group(3) + target
   163	
   164	    return _repl
   165	
   166	
   167	def bump(
   168	    target: str,
   169	    today: str,
   170	    *,
   171	    restamp: bool = False,
   172	    root: Optional[str] = None,
   173	    out=None,
   174	) -> int:
   175	    """Rewrite every version site to `target`. Returns files CHANGED."""
   176	    if not DATE_RX.match(today):
   177	        raise ValueError("--today must be YYYY-MM-DD, got %r" % (today,))
   178	    if not re.match(r"\A" + SEMVER + r"\Z", target):
   179	        raise ValueError("--target must be a bare semver, got %r" % (target,))
   180	    stream = out if out is not None else sys.stdout
   181	    base = root or os.getcwd()
   182	    # Support-window derivation, BEFORE any byte is written: whether every
   183	    # site is writable is decided up front, never discovered mid-loop with a
   184	    # half-bumped tree behind it.
   185	    _maj, _min = (int(x) for x in target.split(".")[:2])
   186	    minor_target = "%d.%d" % (_maj, _min)
   187	    prev_minor = "%d.%d" % (_maj, _min - 1) if _min > 0 else None
   188	    changed = 0
   189	    for path, kind, pattern in _SITES:
   190	        if kind == PREV_MINOR and prev_minor is None:
   191	            # X.0.0: Previous MINOR is not derivable from the target, and the
   192	            # oracle skips value-checking it there too (prev="" at X.0). Never
   193	            # guess a support-window promise — leave it and say so, loudly.
   194	            print(
   195	                "  !!   %s: Previous MINOR left untouched — not derivable "
   196	                "from %s (X.0.0); the support window needs release-train "
   197	                "judgment here" % (path, target),
   198	                file=stream,
   199	            )
   200	            continue
   201	        full = os.path.join(base, path)
   202	        try:
   203	            with open(full, encoding="utf-8") as fh:
   204	                src = fh.read()
   205	        except OSError:
   206	            print("  --   %s absent, skipped" % path, file=stream)
   207	            continue
   208	        written = target
   209	        if kind == STAMP:
   210	            new, n = re.subn(pattern, _stamp_replacer(target, today, restamp), src)
   211	            label = "review stamp"
   212	        elif kind == MINOR:
   213	            written = minor_target
   214	            new, n = re.subn(pattern, r"\g<1>" + written + r"\g<2>", src)
   215	            label = "support-window (Current MINOR) site"
   216	        elif kind == PREV_MINOR:
   217	            written = prev_minor
   218	            new, n = re.subn(pattern, r"\g<1>" + written + r"\g<2>", src)
   219	            label = "support-window (Previous MINOR) site"
   220	        else:
   221	            new, n = re.subn(pattern, _plain_replacement(pattern, target), src)
   222	            label = "version site"
   223	        if n == 0:
   224	            print(
   225	                "  --   %s: no %s found (ok if unwatched)" % (path, label),
   226	                file=stream,
   227	            )
   228	            continue
   229	        if new == src:
   230	            print(
   231	                "  --   %s: %s already at %s (line untouched)"
   232	                % (path, label, written),
   233	                file=stream,
   234	            )
   235	            continue
   236	        with open(full, "w", encoding="utf-8") as fh:
   237	            fh.write(new)
   238	        changed += 1
   239	        print(
   240	            "  ok   %s (%d %s%s -> %s)"
   241	            % (path, n, label, "" if n == 1 else "s", written),
   242	            file=stream,
   243	        )
   244	    return changed
   245	
   246	
   247	def main(argv: Optional[Sequence[str]] = None) -> int:
   248	    parser = argparse.ArgumentParser(
   249	        prog="_release_bump_sites.py",
   250	        description="Release version-site table + writer (single source).",
   251	    )
   252	    sub = parser.add_subparsers(dest="cmd")
   253	
   254	    p_list = sub.add_parser(
   255	        "print-sites",
   256	        help="print every path the bump may write, one per line",
   257	    )
   258	    p_list.add_argument(
   259	        "--include-generated",
   260	        action="store_true",
   261	        help="also print the plugin manifests regenerated by build-plugin.py",
   262	    )
   263	
   264	    p_bump = sub.add_parser("bump", help="rewrite the version sites")
   265	    # NO DEFAULT, BY CONTRACT. `--today` decides whether a signed
   266	    # "last-reviewed" claim moves; a parameter that changes the verdict is
   267	    # never defaulted (frozen-evidence lesson).
   268	    p_bump.add_argument("--today", required=True, help="YYYY-MM-DD (required)")
   269	    p_bump.add_argument("--target", required=True, help="bare semver, e.g. 1.3.0")
   270	    p_bump.add_argument(
   271	        "--restamp",
   272	        action="store_true",
   273	        help="force the review stamps to move even at the same version",
   274	    )
   275	    p_bump.add_argument("--root", default=None, help="repo root (default: cwd)")
   276	
   277	    args = parser.parse_args(argv)
   278	    if args.cmd == "print-sites":
   279	        for path in site_paths(include_generated=args.include_generated):
   280	            print(path)
   281	        return 0
   282	    if args.cmd == "bump":
   283	        try:
   284	            bump(
   285	                args.target,
   286	                args.today,
   287	                restamp=args.restamp,
   288	                root=args.root,
   289	            )
   290	        except ValueError as exc:
   291	            print("FAIL: %s" % exc, file=sys.stderr)
   292	            return 2
   293	        return 0
   294	    parser.print_usage(sys.stderr)
   295	    return 2
   296	
   297	
   298	if __name__ == "__main__":
   299	    sys.exit(main())
     1	name: Release
     2	
     3	on:
     4	  push:
     5	    tags:
     6	      - "v*"
     7	
     8	concurrency:
     9	  group: release-${{ github.ref }}
    10	  cancel-in-progress: false
    11	
    12	jobs:
    13	  release-gate:
    14	    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity.
    15	    if: vars.CEO_SOTA_DISABLE != '1'
    16	    runs-on: ubuntu-latest
    17	    timeout-minutes: 20
    18	    permissions:
    19	      # `contents: read` for checkout; `actions: read` lets the
    20	      # weekly-workflow status gate (see below) call `gh run list`
    21	      # against the public Actions REST API.
    22	      contents: read
    23	      actions: read
    24	    steps:
    25	      - name: Checkout tag
    26	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
    27	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
    28	        with:
    29	          fetch-depth: 0
    30	
    31	      - name: Setup Python 3.11
    32	        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
    33	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
    34	        with:
    35	          python-version: "3.11"
    36	
    37	      # -----------------------------------------------------------------
    38	      # PLAN-153 Wave B item 5 (c) — RC-aware VERSION↔tag comparison.
    39	      # Closes PLAN-152 §Deferred `release-gate-rc-version-mismatch`
    40	      # (red run 28663453202 precedent).
    41	      #
    42	      # THE RC FLOW (documented so this never regresses): an RC tag
    43	      # `v<X.Y.Z>-rc.N` is cut from a tree whose VERSION file ALREADY
    44	      # reads the GA value `X.Y.Z` — the `-rc.N` pre-release suffix
    45	      # exists only in the tag name, never in the VERSION file. (The
    46	      # 24h RC-hold gate below encodes the same convention: it derives
    47	      # the RC tag family `v${VERSION}-rc.*` from the GA VERSION.)
    48	      # The old comparison (`FILE != TAG#v`) therefore hard-failed
    49	      # every RC tag's own release run: `v1.0.1-rc.1` vs
    50	      # `VERSION=1.0.1`. Fix: strip a trailing `-rc.<digits>` from the
    51	      # tag before comparing. GA tags are unaffected (nothing to
    52	      # strip); a wrong-version RC (`v1.0.2-rc.1` on `VERSION=1.0.1`)
    53	      # still hard-fails.
    54	      # -----------------------------------------------------------------
    55	      - name: Assert VERSION matches tag
    56	        run: |
    57	          set -euo pipefail
    58	          TAG="${GITHUB_REF_NAME}"
    59	          FILE="$(tr -d '[:space:]' < VERSION)"
    60	          EXPECTED="${TAG#v}"
    61	          BASE="${EXPECTED%-rc.[0-9]*}"
    62	          if [[ "$FILE" != "$BASE" ]]; then
    63	            echo "::error::VERSION file ('$FILE') does not match tag ('$TAG' → expected '$BASE')"
    64	            exit 1
    65	          fi
    66	          if [[ "$EXPECTED" != "$BASE" ]]; then
    67	            echo "OK: VERSION=$FILE matches RC tag=$TAG (compared against base '$BASE' after stripping the -rc.N pre-release suffix)"
    68	          else
    69	            echo "OK: VERSION=$FILE matches tag=$TAG"
    70	          fi
    71	
    72	      # -----------------------------------------------------------------
    73	      # PLAN-166 W1 item 2 (F3, ADR-155-AMEND-1 §5, Forma A (ii)) — the
    74	      # framework version marker `.claude/.framework-version` is a TRACKED
    75	      # one-line file, byte-identical to VERSION (the version bump writes
    76	      # it as a site; verify-counts.sh cross-checks it). This assert is
    77	      # deliberately UNCONDITIONAL and fail-closed: a missing marker in a
    78	      # release checkout means the ceremony that introduced it was
    79	      # reverted or the bump skipped a site — either way the tag must not
    80	      # ship. Kept NEXT TO the VERSION↔tag assert above so the whole
    81	      # version-consistency family lives in one place (same convention as
    82	      # the plugin-manifest step below).
    83	      # -----------------------------------------------------------------
    84	      - name: Assert framework-version marker matches VERSION
    85	        run: |
    86	          set -euo pipefail
    87	          FILE="$(tr -d '[:space:]' < VERSION)"
    88	          if [[ ! -f .claude/.framework-version ]]; then
    89	            echo "::error::.claude/.framework-version is missing — it is a tracked file (PLAN-166 F3 / ADR-155-AMEND-1); a release checkout without it must not ship"
    90	            exit 1
    91	          fi
    92	          MARKER="$(tr -d '[:space:]' < .claude/.framework-version)"
    93	          if [[ "$MARKER" != "$FILE" ]]; then
    94	            echo "::error::.claude/.framework-version ('$MARKER') does not match VERSION ('$FILE') — the marker is byte-identical to VERSION by contract (Forma A (ii), fail-closed)"
    95	            exit 1
    96	          fi
    97	          echo "OK: .claude/.framework-version=$MARKER matches VERSION"
    98	
    99	      # -----------------------------------------------------------------
   100	      # PLAN-153 Wave B item 5 (e) — version↔plugin-manifest sync, kept
   101	      # NEXT TO the VERSION↔tag assert above so the whole
   102	      # version-consistency family lives in one place.
   103	      #
   104	      # `.claude-plugin/{plugin.json,marketplace.json}` are generated by
   105	      # `build-plugin.py` (Wave B item 6). Until item 6 lands, the
   106	      # manifests do not exist and this step passes with a ::notice
   107	      # (self-arming: the equality checks become enforcing the moment
   108	      # the manifests appear in the tree — no workflow re-edit needed).
   109	      # `marketplace.json`'s schema is owned by build-plugin.py, so we
   110	      # assert on EVERY nested `version` field found rather than
   111	      # hardcoding one JSON path.
   112	      # -----------------------------------------------------------------
   113	      - name: Assert plugin manifest versions match VERSION
   114	        run: |
   115	          set -euo pipefail
   116	          FILE="$(tr -d '[:space:]' < VERSION)"
   117	          if [[ ! -f .claude-plugin/plugin.json ]]; then
   118	            echo "::notice::.claude-plugin/plugin.json not present yet (PLAN-153 Wave B item 6) — sync check self-arms once it lands"
   119	            exit 0
   120	          fi
   121	          PLUGIN_V=$(jq -r '.version // empty' .claude-plugin/plugin.json)
   122	          if [[ "$PLUGIN_V" != "$FILE" ]]; then
   123	            echo "::error::.claude-plugin/plugin.json version ('$PLUGIN_V') does not match VERSION ('$FILE')"
   124	            exit 1
   125	          fi
   126	          echo "OK: plugin.json version=$PLUGIN_V matches VERSION"
   127	          if [[ -f .claude-plugin/marketplace.json ]]; then
   128	            BAD=0
   129	            while IFS= read -r v; do
   130	              [[ -z "$v" ]] && continue
   131	              if [[ "$v" != "$FILE" ]]; then
   132	                echo "::error::.claude-plugin/marketplace.json carries version '$v' != VERSION ('$FILE')"
   133	                BAD=1
   134	              fi
   135	            done < <(jq -r '.. | objects | .version? // empty' .claude-plugin/marketplace.json)
   136	            if [[ "$BAD" -ne 0 ]]; then
   137	              exit 1
   138	            fi
   139	            echo "OK: every marketplace.json version field matches VERSION"
   140	          else
   141	            echo "::notice::.claude-plugin/marketplace.json not present — skipping"
   142	          fi
   143	
   144	      # -----------------------------------------------------------------
   145	      # F5 — RC-hold / staleness waiver SUNSET assertion.
   146	      #
   147	      # The pre-GA waivers in .claude/governance/governance-waivers.yaml
   148	      # are honest ONLY while the project is pre-GA (adopter_count=0).
   149	      # Every existing rc_hold/workflow_staleness entry is a 1.x version
   150	      # carrying "Pre-GA ... adopter_count=0". To stop that 100%-waiver
   151	      # escape from silently following the project into GA, this step
   152	      # FAILS the release the moment any waiver `version` parses >= the
   153	      # configured FIRST_GA floor. The floor is the first version at which
   154	      # the framework intends to claim GA / publish to adopters; per
   155	      # ADR-073 the next major (v2.0.0) is the documented GA/breaking
   156	      # boundary, so 2.0.0 is the mechanical sunset. After the first real
   157	      # adopter ships, lower FIRST_GA (or empty the waiver lists) so the
   158	      # ADR-007 RC-hold + 14-day staleness gates resume real enforcement.
   159	      #
   160	      # Today (max waiver 1.0.0 < 2.0.0) this passes; it is a tripwire,
   161	      # not a behavior change for the current pre-GA train.
   162	      #
   163	      # `-rc.N` pre-release suffixes are stripped before comparison: RC
   164	      # tags forensically short-circuit the hold gate (see below), so an
   165	      # rc.* waiver is never an enforcement bypass on its own.
   166	      # -----------------------------------------------------------------
   167	      - name: Assert no waiver has reached the GA sunset floor
   168	        env:
   169	          # First version at which pre-GA waivers are no longer honest.
   170	          # Bump DOWN (or empty the waiver lists) once an adopter ships.
   171	          FIRST_GA: "2.0.0"
   172	        run: |
   173	          set -euo pipefail
   174	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   175	          if [[ ! -f "$WAIVER_FILE" ]]; then
   176	            echo "OK: no waiver file present — nothing to sunset"
   177	            exit 0
   178	          fi
   179	
   180	          # Extract every `version:` value from BOTH waiver sections using
   181	          # the same flag-based section parser the file documents (a range
   182	          # pattern collapses because the start/end regex overlap), strip
   183	          # any -rc.* suffix, then sort -V -u. Iterated via a while-read
   184	          # loop (portable: no mapfile / bash-4 dependency).
   185	          FAILED=0
   186	          COUNT=0
   187	          while IFS= read -r v; do
   188	            [[ -z "$v" ]] && continue
   189	            COUNT=$((COUNT + 1))
   190	            # v >= FIRST_GA  <=>  the smaller of {v, FIRST_GA} under
   191	            # version-sort is FIRST_GA. (Equal floor counts as reached.)
   192	            LOWER="$(printf '%s\n%s\n' "$v" "$FIRST_GA" | sort -V | head -1)"
   193	            if [[ "$v" == "$FIRST_GA" || "$LOWER" == "$FIRST_GA" ]]; then
   194	              echo "::error::Waiver version $v has reached the GA sunset floor (FIRST_GA=$FIRST_GA)"
   195	              echo "::error::Pre-GA RC-hold/staleness waivers are dishonest at or past GA."
   196	              echo "::error::Remove the $v waiver entry (and resume ADR-007 enforcement) or lower FIRST_GA only with a real adopter."
   197	              FAILED=1
   198	            fi
   199	          done < <(
   200	            {
   201	              awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   202	              awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   203	            } \
   204	              | grep -oE '^[[:space:]]*-[[:space:]]*version:[[:space:]]*[0-9][0-9A-Za-z.+-]*' \
   205	              | grep -oE '[0-9][0-9A-Za-z.+-]*$' \
   206	              | sed -E 's/-rc\.[0-9.]+$//' \
   207	              | sort -V -u
   208	          )
   209	
   210	          if [[ "$COUNT" -eq 0 ]]; then
   211	            echo "OK: waiver file has no version entries to sunset"
   212	            exit 0
   213	          fi
   214	          if [[ "$FAILED" -ne 0 ]]; then
   215	            exit 1
   216	          fi
   217	          echo "OK: all $COUNT waiver versions are pre-GA (< FIRST_GA=$FIRST_GA)"
   218	
   219	      # -----------------------------------------------------------------
   220	      # PLAN-112-FOLLOWUP-canonical-doc-refresh-gate — canonical doc freshness.
   221	      #
   222	      # Fails the release when an in-scope canonical doc's machine-readable
   223	      # `<!-- last-reviewed: DATE vX.Y.Z -->` stamp is more MINOR releases
   224	      # behind VERSION than its tier allows (security docs N=1; general N=3).
   225	      # Missing/malformed stamp fails-CLOSED. Closes F-D4.
   226	      #
   227	      # Emergency bypass: the checker self-reads an Owner-signed
   228	      # `doc_freshness:` entry (matching this release version) in
   229	      # `.claude/governance/governance-waivers.yaml` and, when present,
   230	      # passes WITH a surfaced ::warning (never a silent skip).
   231	      # -----------------------------------------------------------------
   232	      - name: Canonical doc freshness gate
   233	        run: |
   234	          set -euo pipefail
   235	          python3 .claude/scripts/check-canonical-doc-freshness.py
   236	
   237	      # -----------------------------------------------------------------
   238	      # PLAN-013 Phase 0 item 0.3 — mandatory RC-to-GA hold enforcement.
   239	      # AMENDED 2026-05-03 per ADR-103: 7-day calendar gate REDUCED to
   240	      # 24h Codex re-pass mechanical window per ADR-095 §gate-#6.
   241	      #
   242	      # Debate Round 1 consensus §S3 HIGH (DevOps): "7-day RC hold is
   243	      # policy not mechanism. Policy without mechanism is hope."
   244	      #
   245	      # Rule: a GA tag `v1.x.y` MAY only ship after its corresponding
   246	      # RC tag `v1.x.y-rc.N` has existed for ≥24 hours. The 24h window
   247	      # is mechanical: bounds the maximum Codex external re-pass
   248	      # turnaround (anti same-LLM bias per ADR-095 §gate-#6). NOT a
   249	      # "settle period" — vibecoder-only thesis (ADR-096) means no
   250	      # external adopter pressure for calendar buffers.
   251	      #
   252	      # Mechanism:
   253	      #   1. If tag contains `-rc.` → skip check (RC tags always pass)
   254	      #   2. Else find most recent `v<VERSION>-rc.*` tag (by creator date)
   255	      #   3. If none exists → fail (mandatory RC before GA)
   256	      #   4. Else compute delta; reject if < 24h (86400 seconds)
   257	      # -----------------------------------------------------------------
   258	      - name: Assert 24h Codex re-pass window (GA tags only, waiver-aware)
   259	        run: |
   260	          set -euo pipefail
   261	          TAG="${GITHUB_REF_NAME}"
   262	          VERSION="${TAG#v}"
   263	
   264	          # RC tags short-circuit — they are always permitted.
   265	          if [[ "$TAG" == *-rc.* ]]; then
   266	            echo "::notice::$TAG is an RC tag — skipping 24h hold check"
   267	            exit 0
   268	          fi
   269	
   270	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment).
   271	          # During initial framework development with adopter_count=0,
   272	          # the RC-hold window can be waived per Owner authorization
   273	          # recorded in .claude/governance/rc-hold-waivers.yaml. The
   274	          # waiver is additive: post-first-adopter, the file is expected
   275	          # to be empty and ADR-007 default resumes. Each waiver entry
   276	          # cites Owner directive + round-NN sentinel commit.
   277	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   278	          if [[ -f "$WAIVER_FILE" ]]; then
   279	            if awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   280	              echo "::notice::$TAG has a pre-GA RC-hold waiver in $WAIVER_FILE — skipping hold check"
   281	              exit 0
   282	            fi
   283	          fi
   284	
   285	          # Find the most-recent RC tag for this version, by creator date.
   286	          # `git tag -l --sort=-creatordate` handles both lightweight and
   287	          # annotated tags uniformly via the dereferenced date.
   288	          LAST_RC=$(git tag -l --sort=-creatordate "v${VERSION}-rc.*" | head -1)
   289	
   290	          if [[ -z "$LAST_RC" ]]; then
   291	            echo "::error::GA tag $TAG has no prior v${VERSION}-rc.* tag"
   292	            echo "::error::Mandatory RC-hold requires a prior RC tag"
   293	            echo "::error::Cut v${VERSION}-rc.1 first; wait 24h (Codex re-pass turnaround); then cut $TAG"
   294	            exit 1
   295	          fi
   296	
   297	          # Creator-date gives a unix-epoch timestamp for both
   298	          # annotated (tagger date) and lightweight (committer date) tags.
   299	          RC_TS=$(git tag -l --format='%(creatordate:unix)' "$LAST_RC")
   300	          GA_TS=$(git tag -l --format='%(creatordate:unix)' "$TAG")
   301	
   302	          if [[ -z "$RC_TS" || -z "$GA_TS" ]]; then
   303	            echo "::error::Could not read creator-date for $LAST_RC or $TAG"
   304	            exit 1
   305	          fi
   306	
   307	          DELTA=$((GA_TS - RC_TS))
   308	          ONE_DAY=$((1 * 86400))
   309	          HOURS=$((DELTA / 3600))
   310	
   311	          if [[ "$DELTA" -lt "$ONE_DAY" ]]; then
   312	            echo "::error::GA tag $TAG is only $HOURS hours after $LAST_RC"
   313	            echo "::error::Mandatory 24h Codex re-pass window not met (delta=${DELTA}s < 86400s)"
   314	            echo "::error::Wait $((24 - HOURS)) more hours OR run Codex re-pass synchronously and add waiver"
   315	            exit 1
   316	          fi
   317	
   318	          echo "OK: $TAG is $HOURS hours after $LAST_RC (≥24h Codex re-pass window per ADR-103)"
   319	
   320	      - name: Assert CHANGELOG entry exists
   321	        run: |
   322	          set -euo pipefail
   323	          TAG="${GITHUB_REF_NAME}"
   324	          VERSION="${TAG#v}"
   325	          # PLAN-153 Wave B item 5 (c) — same RC normalization as the
   326	          # "Assert VERSION matches tag" step above: RC tags never get
   327	          # their own CHANGELOG section; an RC for X.Y.Z validates
   328	          # against the GA `## [X.Y.Z]` section (which exists at RC-cut
   329	          # time because the VERSION bump + CHANGELOG entry land before
   330	          # the RC is tagged). Without this strip the fixed VERSION gate
   331	          # would just move the RC red run one step later.
   332	          VERSION="${VERSION%-rc.[0-9]*}"
   333	          if ! grep -qE "^## \[${VERSION}\]" CHANGELOG.md; then
   334	            echo "::error::CHANGELOG.md has no '## [${VERSION}]' section"
   335	            exit 1
   336	          fi
   337	          echo "OK: CHANGELOG has entry for [$VERSION]"
   338	
   339	      - name: Registry validation (must be clean)
   340	        run: python3 .claude/scripts/registry.py --validate
   341	
   342	      - name: Governance structural validation
   343	        run: bash .claude/scripts/validate-governance.sh
   344	
   345	      - name: Install test deps (CI-only, not shipped)
   346	        # Post-tag-v1.6.0-rc.1 hardening (Session 33 CI batch): Hook +
   347	        # Script test suites need pytest (4 script tests + several hook
   348	        # tests use pytest.fixture / tmp_path / capsys / pytest.raises)
   349	        # and pyyaml (benchmark loader). These are dev-only deps — never
   350	        # shipped in install.sh / upgrade.sh tarballs. Mirrors coverage.yml
   351	        # install step.
   352	        run: python3 -m pip install --quiet --no-cache-dir "pyyaml" "pytest==8.*"
   353	
   354	      - name: Hook test suite (all 168+ tests)
   355	        # pytest discovers both unittest.TestCase and pure-pytest tests.
   356	        run: python3 -m pytest .claude/hooks/tests -q --tb=short
   357	
   358	      - name: Script test suite (all 132+ tests)
   359	        run: python3 -m pytest .claude/scripts/tests -q --tb=short
   360	
     1	name: NPM Publish
     2	
     3	# Sprint 5 Phase 4; registry auth migrated to npm **Trusted Publishing**
     4	# (OIDC) by PLAN-158 Wave 1 (PLAN-152 §Deferred backlog-oidc successor).
     5	# Publishes ceo-orchestration on tag push (`v*`): the npm CLI (>=11.5.1,
     6	# upgraded in-job — Node 20 bundles npm 10.x, which cannot do the
     7	# exchange) detects the GitHub Actions OIDC context (`id-token: write`)
     8	# and exchanges the per-run JWT for a short-lived publish credential
     9	# scoped to this repo + workflow + `production-npm` environment as
    10	# registered in the npmjs.com trusted-publisher config (Owner console).
    11	# The same JWT keeps feeding the Sigstore `--provenance` attestation.
    12	# The long-lived NPM_TOKEN is NOT read by this workflow anymore and is
    13	# REVOKED once the first OIDC GA publish succeeds (until then it exists
    14	# solely as the rollback path:
    15	# .claude/plans/PLAN-158/staged/wave1/rollback-oidc-to-token.patch +
    16	# .claude/plans/PLAN-158/oidc-failure-playbook.md — tag runs pin the
    17	# workflow to the tag's tree, so a failed GA publish means rollback +
    18	# delete/re-tag; there is no workflow_dispatch here by design).
    19	# Manual `npm publish` is not used. The workflow:
    20	#   1. Verifies VERSION + npm/package.json version + tag are consistent
    21	#   2. Asserts package.json has zero runtime dependencies
    22	#   3. Checks the registry for the exact version (PLAN-153 Wave B item 5
    23	#      `already_published` idempotency guard) — if already present, the
    24	#      run succeeds as a no-op instead of failing on EPUBLISHCONFLICT
    25	#   4. Publishes with --provenance (Sigstore-attested)
    26	#
    27	# PLAN-013 Phase 0 item 0.2 hardening (debate Round 1 consensus §C5
    28	# CRITICAL, 2/5 agents — DevOps + Staff Backend):
    29	#   - Skip RC tags entirely (`if: !contains(github.ref, '-rc.')`) —
    30	#     pushing `v1.4.0-rc.1` MUST NOT trigger a public npm publish;
    31	#     that would violate PLAN-013 anti-goal #3 ("NO NPM publish during
    32	#     Sprint 13") and anti-goal #16 ("NO auto-publish from tag without
    33	#     manual approval").
    34	#   - GA tags (`v1.4.0`) gate through `environment: production-npm`,
    35	#     which requires a manual approval step in GitHub's Environments
    36	#     settings before the job runs. The manual approval is the
    37	#     Owner-in-the-loop gate covering the Sprint 17 public-launch
    38	#     go/no-go decision (private-first strategy per
    39	#     `project_closure_strategy.md`).
    40	#
    41	# ---------------------------------------------------------------------
    42	# PLAN-166 W1 item 1 (F1, P0) — the publish now OBSERVES the governance
    43	# gate. `release.yml` and this workflow both fire on `push: tags: v*` as
    44	# two INDEPENDENT runs; until PLAN-166 nothing made the publish observe
    45	# the gate, so the only barrier was a human approving `production-npm`
    46	# with no machine evidence that `release-gate` was green — a live path
