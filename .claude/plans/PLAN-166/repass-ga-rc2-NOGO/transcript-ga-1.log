  1087	_load_baseline_manifest
  1088	
  1089	# PLAN-161 U1 (codex r1 F4) — manifest-load observability. Byte-identity alone
  1090	# cannot prove a --dry-run kept provenance classification alive (a dry-run
  1091	# that silently lost the baseline would also write nothing), so EVERY run
  1092	# states which classification mode it operates in.
  1093	if [ -n "$_BASELINE_MANIFEST_FILE" ]; then
  1094	  echo "==> Baseline manifest: loaded (provenance classification ACTIVE)"
  1095	else
  2920	    # codex r4 F2: re-check the component chain HERE too (not only at
  2921	    # nomination) — the sweep must never rmdir through a symlinked ancestor
  2922	    # into an external target. Silent skip: the KEPT line already printed
  2923	    # during nomination.
  2924	    for _pm_t in "${_pm_trees[@]}"; do
  2925	      if _purge_tree_symlinked_component "$_pm_t" >/dev/null; then
  2926	        continue
  2927	      fi
  2928	      [[ -d "$TARGET/$_pm_t" && ! -L "$TARGET/$_pm_t" ]] || continue
  2929	      while IFS= read -r _pm_cand; do
  2930	        [[ -n "$_pm_cand" ]] || continue
