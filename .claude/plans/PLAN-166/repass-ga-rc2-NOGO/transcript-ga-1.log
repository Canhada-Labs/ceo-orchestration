   604	      - name: Sign release tarball with sigstore
   605	        # STAGED — activate by setting repo var SIGSTORE_ACTIVATED=true (PLAN-063 round-4: replaces `if: false` per actionlint if-cond; default unset → expression false → step skipped)
   606	        if: ${{ vars.SIGSTORE_ACTIVATED == 'true' }}
   607	        env:
   608	          SIGSTORE_KEY: ${{ secrets.SIGSTORE_PRIVATE_KEY }}
   609	        run: |
   610	          python3 -m sigstore sign \
   611	            --key "$SIGSTORE_KEY" \
   612	            --output-signature ceo-orchestration-${{ github.ref_name }}.sig \
   613	            ceo-orchestration-${{ github.ref_name }}.tar.gz
   614	
   615	      - name: Verify owner.asc populated
   616	        # Session 75 Codex Finding 1 closure: prior workflow imported
   617	        # `.claude/trust/owner.asc` without validating it carries a real
   618	        # PGP block. Empty file silently no-ops `gpg --import` and the
   619	        # subsequent `git tag --verify` could fall through. Fail-closed
   620	        # gate ensures the trust anchor is populated before the import.
