     1	#!/bin/bash
     2	# Re-pass do hold ADR-103 para o GA v1.3.0 (PLAN-166 W2 / W6.1) - 2 PARTES.
     3	# Pipeline identico ao r1/r2: prompt + diff -> redactor ADR-114 ->
     4	# controles -> codex exec read-only de worktree detached DA TAG rc.2.
     5	# O diff v1.2.0..rc.2 do escopo release-mechanics tem ~282KB > cap de
     6	# 250KB do redactor => particao coerente em 2 payloads (medida S300):
     7	#   g1: superficies de versao/docs/config + upgrade.sh (blast radius
     8	#       do adotante) ~111KB
     9	#   g2: maquinaria executavel do release (workflows + driver + guard +
    10	#       bump-sites + await-gate + validador step-15) ~176KB
    11	# Saida por parte: payload-ga-N.redacted.txt, diff-ga-N.patch,
    12	# paths-ga-N.manifest.txt, verdict-ga-N.txt, transcript-ga-N.log;
    13	# agregado em PROVENANCE-ga.md + MANIFEST-ga.sha256 (BASENAMES).
    14	# O GA so segue com VERDICT: GO (ou GO-WITH-CONDITIONS) nas DUAS partes.
    15	set -uo pipefail
    16	REPO_ROOT="$(git rev-parse --show-toplevel)"; cd "$REPO_ROOT" || exit 2
    17	OUT="$REPO_ROOT/.claude/plans/PLAN-166/repass-ga"
    18	BASE_TAG="v1.2.0"
    19	RC_TAG="v1.3.0-rc.2"
    20	git rev-parse -q --verify "refs/tags/$RC_TAG" >/dev/null 2>&1 \
    21	  || { echo "FATAL: tag $RC_TAG nao existe - corte a rc.2 primeiro"; exit 2; }
    22	
    23	WT="$(mktemp -d "${TMPDIR:-/tmp}/repass-ga.XXXXXX")/wt"
    24	git worktree add --detach "$WT" "$RC_TAG" >/dev/null || exit 2
    25	trap 'git worktree remove --force "$WT" >/dev/null 2>&1 || true' EXIT
    26	[ -z "$(git -C "$WT" status --porcelain)" ] || { echo "FATAL: worktree sujo"; exit 2; }
    27	
    28	part_paths() {
    29	  case "$1" in
    30	    1) cat <<'P1'
    31	VERSION
    32	npm/README.md
    33	npm/package.json
    34	pyproject.toml
    35	CHANGELOG.md
    36	INSTALL.md
    37	docs/ARCHITECTURE.md
    38	README.md
    39	README.pt-BR.md
    40	SECURITY.md
    41	VERSIONING.md
    42	SBOM.md
    43	.github/release-checklist.md
    44	.claude-plugin/marketplace.json
    45	.claude-plugin/plugin.json
    46	scripts/upgrade.sh
    47	P1
    48	;;
    49	    2) cat <<'P2'
    50	.github/workflows/release.yml
    51	.github/workflows/npm-publish.yml
    52	.claude/scripts/local/verify-counts.sh
    53	.claude/scripts/local/release.sh
    54	.claude/scripts/local/_release_tag_guard.py
    55	.claude/scripts/local/_release_bump_sites.py
    56	.claude/scripts/await_release_gate.py
    57	.github/scripts/validate-pair-rail-verdict.py
    58	P2
    59	;;
    60	  esac
    61	}
    62	part_label() {
    63	  case "$1" in
    64	    1) echo "version/docs/config surfaces + adopter upgrade path" ;;
    65	    2) echo "executable release machinery (workflows, driver, tag guard, bump sites, npm await-gate, step-15 validator)" ;;
    66	  esac
    67	}
    68	
    69	prompt_header() {
    70	cat <<PROMPT
    71	You are the cross-vendor reviewer on the 24h release hold (ADR-103) for
    72	the GA promotion of $RC_TAG to v1.3.0. Be adversarial and concrete.
    73	Your output is advisory evidence, not an authorization. The scope is
    74	SPLIT in 2 payloads (redactor cap); this is payload $1/2: $2.
    75	Each part is judged independently; GA needs GO on both.
    76	
    77	CONTEXT
    78	- Repo: ceo-orchestration, a governance/auditability framework. Python
    79	  stdlib-only, >=3.9. No speed claims anywhere.
    80	- $RC_TAG is CUT, signed, CI-green, published as a GitHub pre-release,
    81	  under a signed pair-rail verdict (GO-WITH-CONDITIONS).
    82	- Review history you must NOT re-litigate: 4 pre-rc.1 rounds (18
    83	  findings, 17 fixed 1 refuted) + 4 multi-part rounds rc.1->rc.2
    84	  (all real findings cured in fix-forwards; final candidate green).
    85	- FOUR NAMED PRODUCT EXCEPTIONS ride this GA by signed decision
    86	  (V1/V2/V4/V5 - upgrade.sh observer w/o baseline-invalid guard; false
    87	  --pin NOTE; rejected-symlink hash fallthrough; FMS_LINK_PATHS unset
    88	  allow-all on install). Cures are STAGED in a post-GA ceremony pack.
    89	  Do NOT report these as new; DO report if any is WORSE than described
    90	  or reachable on the mainline install/upgrade path (they were assessed
    91	  as non-mainline).
    92	- OWN-0016 is a known gated defect (ADR-190 s2.6, expected nightly RED).
    93	
    94	WHAT THIS HOLD RE-PASS IS FOR
    95	1. GA EXECUTABILITY: remaining path is bump --stable (expected no-op),
    96	   tag --stable, push (push triggers npm publish via OIDC). Anything
    97	   non-idempotent or order-dependent?
    98	2. IRREVERSIBILITY: what lands wrong on npm and cannot be undone?
    99	   Version-string disagreement across published surfaces is the
   100	   highest-value class.
   101	3. ADOPTER BLAST RADIUS: v1.2.0 adopter runs the documented upgrade
   102	   against v1.3.0 - broken/locked states?
   103	4. HONESTY OF CLAIMS: every count/guarantee in the changed docs must
   104	   match the code at the tag. A gate that cannot fail is a finding.
   105	5. What a reviewer would most plausibly have missed across 8 rounds.
   106	
   107	OUTPUT FORMAT
   108	Per finding: SEVERITY (P0 blocks GA / P1 fix before GA / P2 follow-up),
   109	FILE:LINE, concrete failure scenario, minimal fix. Cite the diff.
   110	End with exactly one line: "VERDICT: GO" or "VERDICT: NO-GO" or
   111	"VERDICT: GO-WITH-CONDITIONS", plus one sentence. A clean round is a
   112	legitimate result - do not manufacture findings.
   113	
   114	UNIFIED DIFF ($BASE_TAG..$RC_TAG, part $1/2) FOLLOWS.
   115	PROMPT
   116	}
   117	
   118	OVERALL=0
   119	{
   120	  echo "# Proveniencia do re-pass GA (hold ADR-103) - v1.3.0 - 2 partes"
   121	  echo "- Base: $BASE_TAG .. Tag: $RC_TAG ($(git rev-parse "$RC_TAG^{commit}"))"
   122	  echo "- Worktree detached da TAG: sim - Pipeline: prompt+diff -> codex_egress_redact --outgoing -> controles -> codex exec --sandbox read-only"
   123	  echo "- Data: $(date -u +%Y-%m-%dT%H:%MZ)"
   124	} > "$OUT/PROVENANCE-ga.md"
   125	
   126	for P in 1 2; do
   127	  LABEL="$(part_label "$P")"
   128	  MAN="$OUT/paths-ga-$P.manifest.txt"
   129	  part_paths "$P" > "$MAN"
   130	  while IFS= read -r p; do
   131	    [ -z "$p" ] && continue
   132	    git cat-file -e "$RC_TAG:$p" 2>/dev/null \
   133	      || { echo "FATAL: caminho do escopo ausente na tag: $p" >&2; exit 1; }
   134	  done < "$MAN"
   135	  DIFF="$OUT/diff-ga-$P.patch"
   136	  # shellcheck disable=SC2046
   137	  git diff "$BASE_TAG".."$RC_TAG" -- $(tr '\n' ' ' < "$MAN") > "$DIFF"
   138	  DL=$(wc -l < "$DIFF" | tr -d ' ')
   139	  [ "$DL" -ge 50 ] || { echo "FATAL: parte $P com so $DL linhas de diff"; exit 1; }
   140	  RAW="$OUT/payload-ga-$P.raw.txt"; RED="$OUT/payload-ga-$P.redacted.txt"
   141	  { prompt_header "$P" "$LABEL"; echo; cat "$DIFF"; } > "$RAW"
   142	  RAWB=$(wc -c < "$RAW" | tr -d ' ')
   143	  [ "$RAWB" -lt 250000 ] || { echo "FATAL: parte $P ${RAWB}B >= 250KB"; exit 1; }
   144	  python3 .claude/hooks/_lib/codex_egress_redact.py --outgoing < "$RAW" > "$RED" \
   145	    || { echo "FATAL: redactor rc!=0 na parte $P"; exit 1; }
   146	  grep -q 'CODEX-OUTPUT-TRUNCATED' "$RED" && { echo "FATAL: parte $P truncada"; exit 1; }
   147	  RH=$(grep -c '^@@' "$RAW" || true); DH=$(grep -c '^@@' "$RED" || true)
   148	  [ "$RH" = "$DH" ] || { echo "FATAL: parte $P hunks $RH -> $DH"; exit 1; }
   149	  RAWL=$(wc -l < "$RAW" | tr -d ' '); REDL=$(wc -l < "$RED" | tr -d ' ')
   150	  [ "$RAWL" = "$REDL" ] || { echo "FATAL: parte $P linhas $RAWL -> $REDL"; exit 1; }
   151	  echo "parte $P OK (${RAWB}B, $RH hunks) - codex rodando (~10-15 min)..."
   152	  ( cd "$WT" && codex exec --sandbox read-only --color never \
   153	      --output-last-message "$OUT/verdict-ga-$P.txt" \
   154	      - < "$RED" > "$OUT/transcript-ga-$P.log" 2>&1 )
   155	  CRC=$?
   156	  VLINE=$(grep -E '^VERDICT:' "$OUT/verdict-ga-$P.txt" 2>/dev/null | tail -1 || true)
   157	  [ -n "$VLINE" ] || VLINE="(sem linha VERDICT - inspecionar transcript; rc=$CRC)"
   158	  RAW_SHA=$(shasum -a 256 "$RAW" | awk '{print $1}')
   159	  {
   160	    echo "- parte $P ($LABEL): $VLINE [codex rc=$CRC]"
   161	    echo "  - payload-ga-$P.raw.txt NAO commitado; pin sha256: $RAW_SHA"
   162	  } >> "$OUT/PROVENANCE-ga.md"
   163	  mkdir -p "$HOME/.rc2-backup"; mv "$RAW" "$HOME/.rc2-backup/payload-ga-$P.raw.txt"
   164	  echo "parte $P: $VLINE [rc=$CRC]"
   165	  # Pair-rail S300 r3 P1-3: um VERDICT escrito seguido de crash/timeout
   166	  # do codex (rc!=0) e evidencia INCOMPLETA, nao autorizacao — o rc da
   167	  # execucao E a linha exata contam.
   168	  if [ "$CRC" -ne 0 ]; then
   169	    OVERALL=1
   170	  else
   171	    case "$VLINE" in
   172	      "VERDICT: GO"|"VERDICT: GO-WITH-CONDITIONS"*) : ;;
   173	      *) OVERALL=1 ;;
   174	    esac
   175	  fi
   176	done
   177	
   178	( cd "$OUT" && shasum -a 256 \
   179	    payload-ga-1.redacted.txt payload-ga-2.redacted.txt \
   180	    diff-ga-1.patch diff-ga-2.patch \
   181	    paths-ga-1.manifest.txt paths-ga-2.manifest.txt \
   182	    verdict-ga-1.txt verdict-ga-2.txt \
   183	    transcript-ga-1.log transcript-ga-2.log \
   184	    > MANIFEST-ga.sha256 )
   185	echo "RUNNER-OVERALL: rc=$OVERALL" >> "$OUT/PROVENANCE-ga.md"
   186	echo "OVERALL: $( [ "$OVERALL" -eq 0 ] && echo GO-nas-2-partes || echo 'PARTE SEM GO - triagem' )"
   187	exit "$OVERALL"
     1	#!/bin/bash
     2	# OWNER-GA-CUT.sh - promocao v1.3.0-rc.2 -> GA v1.3.0 em UM comando.
     3	#
     4	#   bash .claude/plans/PLAN-166/OWNER-GA-CUT.sh
     5	#
     6	# Pre-requisito: rc.2 cortada ha >= 24h (hold ADR-103). O script:
     7	#   1. valida janela do hold + freeze (origin/main == commit da rc.2)
     8	#   2. roda o re-pass do hold (codex, ~10-15 min) se ainda nao rodou;
     9	#      exige VERDICT: GO ou GO-WITH-CONDITIONS (NO-GO => aborta)
    10	#   3. commit 1: evidencia do re-pass (repass-ga/**)
    11	#   4. gera verdict-fields GA e voce assina (pinentry 1)
    12	#   5. monta o verdito GA, commit 2, guard local, push, espera CI
    13	#   6. preflight --stable + bump --stable (no-op esperado) +
    14	#      tag v1.3.0 assinada (pinentry 2)
    15	#   7. push da tag (confirmacao SIM) + espera release.yml + npm:
    16	#      aprovacao production-npm e SUA no browser (o script te da o link)
    17	#   8. GitHub Release (SEM pre-release) + npm view
    18	# Depois do GA: assinar W3 e rodar OWNER-W3-LAND.sh (curas V1-V5).
    19	set -euo pipefail
    20	
