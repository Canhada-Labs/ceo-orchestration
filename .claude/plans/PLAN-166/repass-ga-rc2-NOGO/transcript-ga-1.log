   755	    sys.exit(3)
   756	req = d.get("request")
   757	if not isinstance(req, dict):
   758	    sys.exit(3)
   759	cer = req.get("ceremony", "")
   760	if cer not in ("maintainer", "user"):
   761	    sys.exit(3)
   762	sys.stdout.write(cer + "\n")
   763	' "$_INSTALL_STATE_FILE" 2>/dev/null
   764	}
