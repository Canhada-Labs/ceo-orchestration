   553	# --pin contract (SPEC v1 install-cli.md, ADR-007):
   554	# - Resolve <ref> via git rev-parse --verify in the source framework repo
   555	# - Refuse if target has uncommitted .claude/ changes (exit 2)
   556	# - On --dry-run: print diff between current and pinned and exit 0
   557	# - Otherwise: git checkout <ref> in source; run normal upgrade;
   558	#   restore original branch at end
   559	PINNED_CHECKOUT_DONE=0
   560	ORIGINAL_BRANCH=""
   561	
   562	# PLAN-161 U1 (codex r2 F4) — ONE composed EXIT cleanup. The --pin block used
   563	# to install an inline EXIT trap restoring the source branch; any later plain
   564	# `trap ... EXIT` would CLOBBER it. All exit-time duties now live in this
   565	# single function, installed ONCE: (a) restore the pinned-source branch,
   566	# guarded by PINNED_CHECKOUT_DONE + ORIGINAL_BRANCH — the non-dry --pin
   567	# restore semantics are preserved exactly, on success AND on mid-run failure;
   568	# (b) reap the sanitized baseline-manifest tempfile, which now lives OUTSIDE
   569	# $TARGET (see _load_baseline_manifest).
   570	_BASELINE_TMP_FILE=""
   571	_upgrade_cleanup() {
   572	  if [[ "${PINNED_CHECKOUT_DONE:-0}" -eq 1 ]] && [[ -n "${ORIGINAL_BRANCH:-}" ]]; then
   573	    ( cd "$SOURCE_DIR" && git checkout --quiet "$ORIGINAL_BRANCH" 2>/dev/null ) || true
   574	  fi
   575	  if [[ -n "${_BASELINE_TMP_FILE:-}" ]]; then
   576	    rm -f "$_BASELINE_TMP_FILE" 2>/dev/null || true
   577	  fi
   578	}
