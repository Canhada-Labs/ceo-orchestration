+        deadline_s = int(m.group(1))
+        self.assertGreaterEqual(
+            deadline_s, self.gate_minutes * 60 + 600,
+            "poller deadline (%ds) must exceed release-gate timeout "
+            "(%d min) by >=10 min margin" % (deadline_s, self.gate_minutes),
