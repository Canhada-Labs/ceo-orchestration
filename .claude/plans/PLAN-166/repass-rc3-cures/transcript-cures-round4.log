+except OSError:
+    _chlog_text = ""
+_CHLOG_HEADER_RX = re.compile(
+    r"v[\d.]+: (\d+) skills, (\d+) slash commands, (\d+) ADRs, "
+    r"(\d+) `_lib` modules\)"
+)
