   703	# ---- PLAN-161 V1: markdown-table-cell rules (the S275 miss class) ----
   704	# A prose regex like "(\d+) ADRs" never matches "| ADRs | 178 |" — the number
   705	# and its label sit in SEPARATE cells. These rules match on the LABEL cell
   706	# (first cell, markdown emphasis stripped) and read the FIRST integer of the
   707	# VALUE cell (second cell). Applied to every doc in DOCS. Tolerance 0.
   708	TABLE_RULES = [
   709	    ("adrs",      "exact", r'^(?:ADRs|Architecture decision records)\b'),
   710	    ("hook_py",   "exact", r'^Hook scripts\b'),
   711	    # PLAN-166 W0 F5: docs/CTO-GUIDE.md §2 labels the row just "Hooks" and
   712	    # puts BOTH numbers in the value cell ("57 .py on disk; 46 wired into
   713	    # `settings.json`"). The table extractor reads the FIRST integer, so this
   714	    # row feeds hook_py; the second number is picked up by the `(\d+) wired
   715	    # into` prose regex. The `$` anchor is load-bearing — an unanchored
   716	    # `^Hooks\b` would also swallow "Hooks registered" / "Hooks wired in"
   717	    # and assert the REGISTERED count against the on-disk metric.
   718	    ("hook_py",   "exact", r'^Hooks$'),
   719	    ("lib",       "exact",
   720	     r'^(?:_lib modules|_lib/ stdlib-only modules|Shared library modules)\b'),
   721	    ("commands",  "exact", r'^Slash commands\b'),
   722	    ("skills",    "exact", r'^(?:Skills|Skill checklists)\b'),
   723	    ("spec_v1",   "exact", r'^SPEC/v1 files\b'),
   724	    ("workflows", "exact", r'^Workflows\b'),
   725	    # ---- PLAN-166 W0 F5: README.pt-BR.md label rules (pt) ----
   726	    # The pt-BR README carried a v1.0.0-era table (55 hooks on disk / 44 wired)
   727	    # for one reason only: no rule spoke Portuguese. These label matchers are
   728	    # deliberately SEPARATE entries rather than alternations bolted onto the
   729	    # English ones, so a pt/EN LABEL COLLISION is impossible to introduce by
   730	    # accident — see the collision audit in the header of this block:
   731	    #   * "Architecture decision records" and "Slash commands" are identical in
   732	    #     both languages AND mean the same metric, so the existing English
