  1191	def _mark_wall_budget_exhausted() -> None:
  1192	    """Latch the budget as spent (see ``_gpg_verify_timeout``).
  1193	
  1194	    Set when a signature verification is REFUSED for want of budget. The
  1195	    clock has not necessarily elapsed yet, but the invocation can no
  1196	    longer reach a verdict, so every subsequent poll must report expiry —
  1197	    otherwise the loop runs to its end and the operator is handed the
  1198	    generic "declare this path in Scope" block, which misdiagnoses a
  1199	    budget fault as a missing sentinel and omits the recovery route.
  1200	    """
  1201	    global _WALL_BUDGET_EXHAUSTED
  1202	    _WALL_BUDGET_EXHAUSTED = True
  1203	
  1204	
  1205	def _wall_budget_expired() -> bool:
  1206	    """True once the armed invocation budget has elapsed (or is spent).
  1207	
  1208	    Disarmed (``None``) => never expired, so direct ``decide()`` callers
  1209	    outside a hook invocation are unaffected.
  1210	    """
  1211	    if _WALL_DEADLINE_AT is None:
  1212	        return False
  1213	    if _WALL_BUDGET_EXHAUSTED:
  1214	        return True
  1215	    return _now() > _WALL_DEADLINE_AT
