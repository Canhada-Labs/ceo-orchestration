   988	def _find_sentinels(repo_root: Path) -> List[Path]:
   989	    """Find all valid Architect sentinel files in the repo.
   990	
   991	    PLAN-045 Wave 1 F-01-04: reject any sentinel that is a symlink or
   992	    whose immediate parent directory is a symlink. Mirrors the
   993	    ``_validate_skill_reference`` hardening pattern (ADR-051 sub-check
   994	    5). Silently drops symlinked entries — an attacker who plants
   995	    ``PLAN-EVIL/architect/round-1/approved.md -> /tmp/evil`` no longer
   996	    gets their sentinel considered.
   997	    """
   998	    base = repo_root / ".claude" / "plans"
   999	    if not base.is_dir():
  1000	        return []
  1001	    # PLAN-085 Wave E.1 — explicit pattern union + grandfather allowlist
  1002	    # (R1 Sec-3). NO catch-all wildcard. Novel architect/* subdirs not
  1003	    # listed below are treated as ORPHAN, NOT TRUSTED.
  1004	    _PATTERNS = (
  1005	        "PLAN-*/architect/round-*/approved.md",
  1006	        "PLAN-*/architect/wave-0a/approved.md",      # PLAN-083 grandfather
  1007	        "PLAN-*/architect/wave-0b/approved.md",      # PLAN-083 grandfather
  1008	        "PLAN-*/architect/wave-1-2/approved.md",     # PLAN-083 grandfather
  1009	        "PLAN-*/architect/wave-minus-1/approved.md", # PLAN-083 grandfather
  1010	        "PLAN-*/staging/review/approved.md",         # PLAN-083 grandfather
  1011	        "PLAN-*/approved.md",                        # plan-root sentinels
  1012	        "PLAN-*/wave-*-approved.md",                 # S109 wave-N-approved.md
  1013	        "PLAN-*/approved-amendment-*.md",            # E.5 amendment files
  1014	        "PLAN-*/audit-v2/architect/round-*/approved.md",  # PLAN-044 audit-v2 historical
  1015	    )
  1016	    seen: set = set()
  1017	    candidates: list = []
  1018	    for pat in _PATTERNS:
  1019	        for c in sorted(base.glob(pat)):
  1020	            if c not in seen:
  1021	                seen.add(c)
  1022	                candidates.append(c)
  1023	    # PLAN162_FIX_2 (PLAN-162 finding #2, consensus C9) — the symlink
  1024	    # rejection must be DEPTH-INDEPENDENT.
  1025	    #
  1026	    # HEAD checked exactly three levels (``p``, ``p.parent``,
  1027	    # ``p.parent.parent``), hard-coded to the depth of
  1028	    # ``PLAN-*/architect/round-*/approved.md``. The ``PLAN-*`` segment one
  1029	    # level further up was never checked, so
  1030	    # ``.claude/plans/PLAN-EVIL -> /tmp/evil`` smuggled a foreign
  1031	    # ``architect/round-1/approved.md`` into the TRUSTED sentinel set —
  1032	    # every intermediate directory is a real directory INSIDE the link
  1033	    # target, so all three checks passed.
  1034	    #
  1035	    # "Cover the real depth of the patterns" was rejected in debate: it
  1036	    # re-couples the guard to the pattern list, and the next 6-segment
  1037	    # pattern silently reopens the hole (the dead-gate class this file has
  1038	    # already suffered twice). Instead we do both depth-free checks:
  1039	    #
  1040	    #   (a) walk EVERY segment from ``p`` up to (excluding) ``base``,
  1041	    #       rejecting any symlinked component; and
  1042	    #   (b) assert ``realpath(p)`` stays under ``realpath(base)``, which
  1043	    #       also catches a symlink that resolves out of the tree without a
  1044	    #       symlinked component we happen to walk.
  1045	    #
  1046	    # RESIDUAL, deliberately not closed here: a symlink at ``base`` itself
  1047	    # (``.claude/plans``) satisfies both forms — (a) excludes base and (b)
  1048	    # resolves base through the same link. Named in the W1 instrument;
  1049	    # pinning today's behaviour there would pin a bypass.
  1050	    try:
  1051	        base_rp = os.path.realpath(str(base))
  1052	    except Exception:
  1053	        return []
  1054	    safe: List[Path] = []
  1055	    for p in candidates:
  1056	        try:
  1057	            # (a) depth-free ancestor walk: p, then every directory above
  1058	            # it, up to but not including `base`. A bound of 64 hops is a
  1059	            # runaway guard, never a semantic limit (real sentinels sit 2-4
  1060	            # levels under base).
  1061	            node = p
  1062	            contained = False
  1063	            for _hop in range(64):
  1064	                if node.is_symlink():
  1065	                    break
  1066	                parent = node.parent
  1067	                if parent == node:  # walked past the filesystem root
  1068	                    break
  1069	                if parent == base:
  1070	                    contained = True
  1071	                    break
  1072	                node = parent
  1073	            if not contained:
  1074	                continue
  1075	            # (b) realpath containment — independent of how many segments
  1076	            # the pattern happens to have.
  1077	            p_rp = os.path.realpath(str(p))
  1078	            if not p_rp.startswith(base_rp + os.sep):
  1079	                continue
  1080	        except OSError:
  1081	            continue
  1082	        safe.append(p)
  1083	    return safe
