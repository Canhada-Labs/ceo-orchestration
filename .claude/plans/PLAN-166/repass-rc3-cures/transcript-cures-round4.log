   335	    def test_real_repo_per_document_liveness(self):
   336	        """Every watched (metric, doc) pair must match its EXACT count.
   337	
   338	        Both directions are failures: a pair that drops below its count
   339	        is silent coverage loss; a pair that appears or grows without the
   340	        manifest being updated is an unratified claim site."""
   341	        r = subprocess.run(
   342	            ["bash", str(SCRIPT), "--json", "--no-tests"],
   343	            capture_output=True, text=True, timeout=60, env=os.environ.copy())
   344	        self.assertEqual(r.returncode, 0, r.stdout)
   345	        by_doc = json.loads(r.stdout).get("rule_matches_by_doc", {})
   346	        # The dict diff is long and unreadable; the named lists below are
   347	        # the actionable part, so show them rather than the raw diff.
   348	        self.maxDiff = None
   349	        self.assertEqual(
   350	            by_doc, self._EXPECTED_SITES,
   351	            "watched claim sites drifted from the ratified manifest. "
   352	            "Lost: {0}. Unratified/new: {1}.".format(
   353	                sorted(k for k in self._EXPECTED_SITES
   354	                       if by_doc.get(k, 0) != self._EXPECTED_SITES[k]),
   355	                sorted(k for k in by_doc if k not in self._EXPECTED_SITES),
   356	            ))
