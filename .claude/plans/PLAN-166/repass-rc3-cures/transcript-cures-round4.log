   802	class TestChangelogHeaderRule(unittest.TestCase):
   803	    """Scoped CHANGELOG header rule (PLAN-166 W2 rc.3, rail r1 P1-4).
   804	
   805	    The rule enforces the four-count header claim in the PREAMBLE only
   806	    (before the first "## [" release heading): exactly one claim, exact
   807	    counts. Body claims are invisible BY CONSTRUCTION — the log's body
   808	    carries historical counts on purpose — so they can neither satisfy
   809	    a removed header nor duplicate the census site.
   810	    """
   811	
   812	    # Matches _scaffold defaults: skills total 9 (3+2+4), commands 0
   813	    # (no .claude/commands dir), adrs 5, lib 6.
   814	    _GOOD_CLAIM = (
   815	        "counts below (as of\n"
   816	        "v0.0.0: 9 skills, 0 slash commands, 5 ADRs, 6 `_lib` modules) are\n"
   817	    )
   818	    _STALE_CLAIM = (
   819	        "v0.0.0: 9 skills, 0 slash commands, 4 ADRs, 6 `_lib` modules) were\n"
   820	    )
   821	    _BODY = "\n## [0.0.1] - 2000-01-01\n\nhistorical notes.\n"
   822	
   823	    def _run_loud(self, tmp):
   824	        # Sem --quiet: os casos de falha asserta(m) a MENSAGEM da
   825	        # violation, que o modo quiet suprime.
   826	        env = os.environ.copy()
   827	        env["VERIFY_COUNTS_ROOT"] = str(tmp)
   828	        return subprocess.run(
   829	            ["bash", str(SCRIPT), "--no-tests"],
   830	            capture_output=True, text=True, timeout=60, env=env)
   831	
   832	    def _tree(self, tmp, chlog):
   833	        import pathlib
   834	        counts = _scaffold(pathlib.Path(tmp))
   835	        _write_docs(pathlib.Path(tmp), **counts)
   836	        if chlog is not None:
   837	            (pathlib.Path(tmp) / "CHANGELOG.md").write_text(
   838	                chlog, encoding="utf-8")
   839	
   840	    def test_absent_changelog_passes(self):
   841	        import tempfile
   842	        with tempfile.TemporaryDirectory() as tmp:
   843	            self._tree(tmp, None)
   844	            r = _run(root=Path(tmp))
   845	            self.assertEqual(r.returncode, 0, r.stdout)
   846	
   847	    def test_correct_header_passes(self):
   848	        import tempfile
   849	        with tempfile.TemporaryDirectory() as tmp:
   850	            self._tree(tmp, self._GOOD_CLAIM + self._BODY)
   851	            r = _run(root=Path(tmp))
   852	            self.assertEqual(r.returncode, 0, r.stdout)
   853	
   854	    def test_wrong_header_count_fails(self):
   855	        import tempfile
   856	        with tempfile.TemporaryDirectory() as tmp:
   857	            self._tree(tmp, self._STALE_CLAIM + self._BODY)
   858	            r = self._run_loud(tmp)
   859	            self.assertNotEqual(r.returncode, 0)
   860	            self.assertIn("changelog/header", r.stdout)
   861	
   862	    def test_body_only_claim_is_dead_matcher_violation(self):
   863	        # A removed header cannot be masked by an exact-shaped claim in
   864	        # the body (rail r1 P1-4's masking scenario).
   865	        import tempfile
   866	        with tempfile.TemporaryDirectory() as tmp:
   867	            self._tree(tmp, "no claim up here.\n" + self._BODY
   868	                       + self._GOOD_CLAIM)
   869	            r = self._run_loud(tmp)
   870	            self.assertNotEqual(r.returncode, 0)
   871	            self.assertIn("changelog/header", r.stdout)
   872	            self.assertIn("not found in the preamble", r.stdout)
   873	
   874	    def test_duplicate_preamble_claims_fail(self):
   875	        import tempfile
   876	        with tempfile.TemporaryDirectory() as tmp:
   877	            self._tree(tmp, self._GOOD_CLAIM + "\n" + self._GOOD_CLAIM
   878	                       + self._BODY)
   879	            r = self._run_loud(tmp)
   880	            self.assertNotEqual(r.returncode, 0)
   881	            self.assertIn("exactly one", r.stdout)
   882	
   883	    def test_stale_body_claim_ignored_by_construction(self):
   884	        # Historical counts in the body stay legitimate.
   885	        import tempfile
   886	        with tempfile.TemporaryDirectory() as tmp:
   887	            self._tree(tmp, self._GOOD_CLAIM + self._BODY
   888	                       + self._STALE_CLAIM)
   889	            r = _run(root=Path(tmp))
   890	            self.assertEqual(r.returncode, 0, r.stdout)
