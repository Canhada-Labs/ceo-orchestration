   393	      # -----------------------------------------------------------------
   394	      # PLAN-153 Wave B item 5 (a) — `already_published` idempotency
   395	      # guard. Before publishing, ask the registry whether this exact
   396	      # name@version already exists. If it does (a re-run of a
   397	      # previously successful publish, or a re-run after a post-publish
   398	      # step failed), the Publish step is skipped and the job succeeds
   399	      # as a documented no-op instead of going red on EPUBLISHCONFLICT.
   400	      #
   401	      # Detection is deliberately conservative: "published" ONLY when
   402	      # `npm view <name>@<version> version` exits 0 AND prints exactly
   403	      # the version (npm has historically flip-flopped between
   404	      # rc!=0/E404 and rc=0/empty-stdout for a missing version of an
   405	      # existing package — both shapes are treated as not-published).
   406	      # Any registry/network error therefore falls through to the
   407	      # publish attempt, which preserves today's behavior (npm itself
   408	      # fails closed on a true conflict). No auth needed: the package
   409	      # is public and `npm view` is an unauthenticated read.
   410	      # -----------------------------------------------------------------
   411	      - name: Check registry for already-published version
   412	        id: already_published
   413	        working-directory: npm
   414	        run: |
   415	          set -euo pipefail
   416	          PKG_NAME=$(node -p "require('./package.json').name")
   417	          PKG_VERSION=$(node -p "require('./package.json').version")
   418	          set +e
   419	          SEEN=$(npm view "${PKG_NAME}@${PKG_VERSION}" version 2>/dev/null)
   420	          RC=$?
   421	          set -e
   422	          if [[ "$RC" -eq 0 && "$SEEN" == "$PKG_VERSION" ]]; then
   423	            echo "published=true" >> "$GITHUB_OUTPUT"
   424	            echo "::notice::${PKG_NAME}@${PKG_VERSION} already exists in the registry — publish will be skipped (idempotent re-run, succeed-as-noop)"
   425	          else
   426	            echo "published=false" >> "$GITHUB_OUTPUT"
   427	            echo "OK: ${PKG_NAME}@${PKG_VERSION} not in registry (rc=$RC) — proceeding to publish"
   428	          fi
   429	
   430	      # -----------------------------------------------------------------
   431	      # PLAN-166 W2 rc.3 (GA re-pass part-2 P1): a delete/re-tag recovery
   432	      # leaves the ORIGINAL run re-approvable (or its failed portion
   433	      # re-runnable) with checkout pinned to the OLD event SHA — every
   434	      # in-run version check still passes (both trees carry the same
   435	      # version string), the registry is still empty, and npm publish
   436	      # would irreversibly ship the WRONG tree while the live tag points
   437	      # elsewhere. Fail-closed liveness assert: the CURRENT remote tag
   438	      # must still peel to this run's GITHUB_SHA immediately before
   439	      # publish. A deleted tag (empty resolve) and a moved tag both
   440	      # abort. This step sits AFTER the production-npm environment
   441	      # approval by job order, so a stale approval cannot race past it.
   442	      # -----------------------------------------------------------------
   443	      - name: Assert remote tag still points at this run's SHA
   444	        # Same skip-condition as the publish step (rail rc.3 r1 P1-2): when
   445	        # the registry already carries the version, publish is a no-op and
   446	        # this guard must not turn the documented idempotent re-run red.
   447	        if: steps.already_published.outputs.published != 'true'
   448	        run: |
   449	          set -euo pipefail
   450	          TAG_REF="${GITHUB_REF_NAME}"
   451	          # ONE ls-remote invocation = ONE remote snapshot (rail rc.3 r1
   452	          # P1-1): separate calls could straddle a concurrent re-tag, keep
   453	          # the OLD peeled SHA and approve the obsolete run.
   454	          SNAP="$(git ls-remote origin "refs/tags/${TAG_REF}" "refs/tags/${TAG_REF}^{}")"
   455	          PEELED="$(printf '%s\n' "$SNAP" | awk -v r="refs/tags/${TAG_REF}^{}" '$2==r{print $1}')"
   456	          PLAIN="$(printf '%s\n' "$SNAP" | awk -v r="refs/tags/${TAG_REF}" '$2==r{print $1}')"
   457	          LIVE="${PEELED:-$PLAIN}"
   458	          if [ -z "$LIVE" ]; then
   459	            echo "::error::tag ${TAG_REF} no longer exists on origin — refusing to publish an orphaned tree (delete/re-tag recovery in flight?)"
   460	            exit 1
   461	          fi
   462	          if [ "$LIVE" != "${GITHUB_SHA}" ]; then
   463	            echo "::error::tag ${TAG_REF} now peels to ${LIVE} but this run was built from ${GITHUB_SHA} — obsolete run; approve/re-run only from the CURRENT tag's run"
   464	            exit 1
   465	          fi
   466	          echo "OK: refs/tags/${TAG_REF} still peels to ${GITHUB_SHA}"
   467	
   468	      - name: Publish (Trusted Publishing — OIDC)
   469	        if: steps.already_published.outputs.published != 'true'
   470	        working-directory: npm
   471	        # PLAN-158 W1: NO long-lived token — npm >=11.5.1 detects the
   472	        # GitHub Actions OIDC context and mints a short-lived credential
   473	        # against the npmjs trusted-publisher registration (repo
   474	        # Canhada-Labs/ceo-orchestration, workflow npm-publish.yml,
   475	        # environment production-npm). --provenance keeps working (same
   476	        # OIDC JWT feeds Sigstore).
   477	        #
   478	        # ROLLBACK (token fallback) — kept dormant BY DESIGN, do not
   479	        # inline-enable: apply
   480	        # .claude/plans/PLAN-158/staged/wave1/rollback-oidc-to-token.patch
   481	        # (restores the `env: NODE_AUTH_TOKEN` block below), regenerate a
   482	        # granular NPM_TOKEN in the Owner console, then delete + re-tag
   483	        # (tag runs pin the workflow to the tag's tree — a re-run of the
   484	        # failed run would re-execute the OIDC tree). Full sequence:
   485	        # .claude/plans/PLAN-158/oidc-failure-playbook.md
   486	        run: npm publish --provenance --access public
