   518	    def test_publish_needs_await_gate(self):
   519	        # String-level (runs even without pyyaml): the load-bearing edge.
   520	        self.assertIn(
   521	            "needs: await-release-gate", self.source,
   522	            "publish no longer waits for the await-release-gate job — "
   523	            "the npm publish would stop observing release.yml's "
   524	            "release-gate (PLAN-166 F1, P0)",
   525	        )
   526	
   527	    def test_publish_needs_await_gate_structurally(self):
   528	        jobs = self._jobs()
   529	        self.assertEqual(
   530	            jobs["publish"].get("needs"), "await-release-gate",
   531	            "the `needs:` must sit on the PUBLISH job itself",
   532	        )
   533	
   534	    def test_await_job_authenticates_gh_cli(self):
   535	        # `permissions:` alone does NOT authenticate the gh CLI on a
   536	        # hosted runner; without GH_TOKEN every poll dies on auth →
   537	        # fail-closed BLOCK breaking every release, RC and GA alike.
   538	        self.assertIn("GH_TOKEN: ${{ github.token }}", self.source)
   539	        jobs = self._jobs()
   540	        env = jobs["await-release-gate"].get("env") or {}
   541	        self.assertEqual(
   542	            env.get("GH_TOKEN"), "${{ github.token }}",
   543	            "await-release-gate must carry GH_TOKEN at the JOB level",
   544	        )
   545	
   546	    def test_await_job_permissions_and_timeout(self):
   547	        jobs = self._jobs()
   548	        gate = jobs["await-release-gate"]
