    78	      # -----------------------------------------------------------------
    79	      # PLAN-166 W1 item 2 (F3, ADR-155-AMEND-1 §5, Forma A (ii)) — the
    80	      # framework version marker `.claude/.framework-version` is a TRACKED
    81	      # one-line file, byte-identical to VERSION (the version bump writes
    82	      # it as a site; verify-counts.sh cross-checks it). This assert is
    83	      # deliberately UNCONDITIONAL and fail-closed: a missing marker in a
    84	      # release checkout means the ceremony that introduced it was
    85	      # reverted or the bump skipped a site — either way the tag must not
    86	      # ship. Kept NEXT TO the VERSION↔tag assert above so the whole
    87	      # version-consistency family lives in one place (same convention as
    88	      # the plugin-manifest step below).
    89	      # -----------------------------------------------------------------
    90	      - name: Assert framework-version marker matches VERSION
    91	        run: |
    92	          set -euo pipefail
    93	          FILE="$(tr -d '[:space:]' < VERSION)"
    94	          if [[ ! -f .claude/.framework-version ]]; then
    95	            echo "::error::.claude/.framework-version is missing — it is a tracked file (PLAN-166 F3 / ADR-155-AMEND-1); a release checkout without it must not ship"
    96	            exit 1
    97	          fi
    98	          MARKER="$(tr -d '[:space:]' < .claude/.framework-version)"
    99	          if [[ "$MARKER" != "$FILE" ]]; then
   100	            echo "::error::.claude/.framework-version ('$MARKER') does not match VERSION ('$FILE') — the marker is byte-identical to VERSION by contract (Forma A (ii), fail-closed)"
   101	            exit 1
   102	          fi
   103	          echo "OK: .claude/.framework-version=$MARKER matches VERSION"
