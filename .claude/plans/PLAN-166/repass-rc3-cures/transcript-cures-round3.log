   105	      # -----------------------------------------------------------------
   106	      # PLAN-153 Wave B item 5 (e) — version↔plugin-manifest sync, kept
   107	      # NEXT TO the VERSION↔tag assert above so the whole
   108	      # version-consistency family lives in one place.
   109	      #
   110	      # `.claude-plugin/{plugin.json,marketplace.json}` are generated by
   111	      # `build-plugin.py` (Wave B item 6). Until item 6 lands, the
   112	      # manifests do not exist and this step passes with a ::notice
   113	      # (self-arming: the equality checks become enforcing the moment
   114	      # the manifests appear in the tree — no workflow re-edit needed).
   115	      # `marketplace.json`'s schema is owned by build-plugin.py, so we
   116	      # assert on EVERY nested `version` field found rather than
   117	      # hardcoding one JSON path.
   118	      # -----------------------------------------------------------------
   119	      - name: Assert plugin manifest versions match VERSION
   120	        run: |
   121	          set -euo pipefail
   122	          FILE="$(tr -d '[:space:]' < VERSION)"
   123	          if [[ ! -f .claude-plugin/plugin.json ]]; then
   124	            echo "::notice::.claude-plugin/plugin.json not present yet (PLAN-153 Wave B item 6) — sync check self-arms once it lands"
   125	            exit 0
   126	          fi
   127	          PLUGIN_V=$(jq -r '.version // empty' .claude-plugin/plugin.json)
   128	          if [[ "$PLUGIN_V" != "$FILE" ]]; then
   129	            echo "::error::.claude-plugin/plugin.json version ('$PLUGIN_V') does not match VERSION ('$FILE')"
   130	            exit 1
   131	          fi
   132	          echo "OK: plugin.json version=$PLUGIN_V matches VERSION"
   133	          if [[ -f .claude-plugin/marketplace.json ]]; then
   134	            BAD=0
   135	            while IFS= read -r v; do
   136	              [[ -z "$v" ]] && continue
   137	              if [[ "$v" != "$FILE" ]]; then
   138	                echo "::error::.claude-plugin/marketplace.json carries version '$v' != VERSION ('$FILE')"
   139	                BAD=1
   140	              fi
   141	            done < <(jq -r '.. | objects | .version? // empty' .claude-plugin/marketplace.json)
   142	            if [[ "$BAD" -ne 0 ]]; then
   143	              exit 1
   144	            fi
   145	            echo "OK: every marketplace.json version field matches VERSION"
   146	          else
   147	            echo "::notice::.claude-plugin/marketplace.json not present — skipping"
   148	          fi
