   150	      # -----------------------------------------------------------------
   151	      # F5 — RC-hold / staleness waiver SUNSET assertion.
   152	      #
   153	      # The pre-GA waivers in .claude/governance/governance-waivers.yaml
   154	      # are honest ONLY while the project is pre-GA (adopter_count=0).
   155	      # Every existing rc_hold/workflow_staleness entry is a 1.x version
   156	      # carrying "Pre-GA ... adopter_count=0". To stop that 100%-waiver
   157	      # escape from silently following the project into GA, this step
   158	      # FAILS the release the moment any waiver `version` parses >= the
   159	      # configured FIRST_GA floor. The floor is the first version at which
   160	      # the framework intends to claim GA / publish to adopters; per
   161	      # ADR-073 the next major (v2.0.0) is the documented GA/breaking
   162	      # boundary, so 2.0.0 is the mechanical sunset. After the first real
   163	      # adopter ships, lower FIRST_GA (or empty the waiver lists) so the
   164	      # ADR-007 RC-hold + 14-day staleness gates resume real enforcement.
   165	      #
   166	      # Today (max waiver 1.0.0 < 2.0.0) this passes; it is a tripwire,
   167	      # not a behavior change for the current pre-GA train.
   168	      #
   169	      # `-rc.N` pre-release suffixes are stripped before comparison: RC
   170	      # tags forensically short-circuit the hold gate (see below), so an
   171	      # rc.* waiver is never an enforcement bypass on its own.
   172	      # -----------------------------------------------------------------
   173	      - name: Assert no waiver has reached the GA sunset floor
   174	        env:
   175	          # First version at which pre-GA waivers are no longer honest.
   176	          # Bump DOWN (or empty the waiver lists) once an adopter ships.
   177	          FIRST_GA: "2.0.0"
   178	        run: |
   179	          set -euo pipefail
   180	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   181	          if [[ ! -f "$WAIVER_FILE" ]]; then
   182	            echo "OK: no waiver file present — nothing to sunset"
   183	            exit 0
   184	          fi
   185	
   186	          # Extract every `version:` value from BOTH waiver sections using
   187	          # the same flag-based section parser the file documents (a range
   188	          # pattern collapses because the start/end regex overlap), strip
   189	          # any -rc.* suffix, then sort -V -u. Iterated via a while-read
   190	          # loop (portable: no mapfile / bash-4 dependency).
   191	          FAILED=0
   192	          COUNT=0
   193	          while IFS= read -r v; do
   194	            [[ -z "$v" ]] && continue
   195	            COUNT=$((COUNT + 1))
   196	            # v >= FIRST_GA  <=>  the smaller of {v, FIRST_GA} under
   197	            # version-sort is FIRST_GA. (Equal floor counts as reached.)
   198	            LOWER="$(printf '%s\n%s\n' "$v" "$FIRST_GA" | sort -V | head -1)"
   199	            if [[ "$v" == "$FIRST_GA" || "$LOWER" == "$FIRST_GA" ]]; then
   200	              echo "::error::Waiver version $v has reached the GA sunset floor (FIRST_GA=$FIRST_GA)"
   201	              echo "::error::Pre-GA RC-hold/staleness waivers are dishonest at or past GA."
   202	              echo "::error::Remove the $v waiver entry (and resume ADR-007 enforcement) or lower FIRST_GA only with a real adopter."
   203	              FAILED=1
   204	            fi
   205	          done < <(
   206	            {
   207	              awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   208	              awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   209	            } \
   210	              | grep -oE '^[[:space:]]*-[[:space:]]*version:[[:space:]]*[0-9][0-9A-Za-z.+-]*' \
   211	              | grep -oE '[0-9][0-9A-Za-z.+-]*$' \
   212	              | sed -E 's/-rc\.[0-9.]+$//' \
   213	              | sort -V -u
   214	          )
   215	
   216	          if [[ "$COUNT" -eq 0 ]]; then
   217	            echo "OK: waiver file has no version entries to sunset"
   218	            exit 0
   219	          fi
   220	          if [[ "$FAILED" -ne 0 ]]; then
   221	            exit 1
   222	          fi
   223	          echo "OK: all $COUNT waiver versions are pre-GA (< FIRST_GA=$FIRST_GA)"
