     1	#!/bin/bash
     2	# Re-pass do hold ADR-103 para o GA v1.3.0 (PLAN-166 W2 / W6.1) - 2 PARTES.
     3	# Pipeline identico ao r1/r2: prompt + diff -> redactor ADR-114 ->
     4	# controles -> codex exec read-only de worktree detached DA TAG rc.2.
     5	# O diff v1.2.0..rc.2 do escopo release-mechanics tem ~282KB > cap de
     6	# 250KB do redactor => particao coerente em 2 payloads (medida S300):
     7	#   g1: superficies de versao/docs/config + upgrade.sh (blast radius
     8	#       do adotante) ~111KB
     9	#   g2: maquinaria executavel do release (workflows + driver + guard +
    10	#       bump-sites + await-gate + validador step-15) ~176KB
    11	# Saida por parte: payload-ga-N.redacted.txt, diff-ga-N.patch,
    12	# paths-ga-N.manifest.txt, verdict-ga-N.txt, transcript-ga-N.log;
    13	# agregado em PROVENANCE-ga.md + MANIFEST-ga.sha256 (BASENAMES).
    14	# O GA so segue com VERDICT: GO (ou GO-WITH-CONDITIONS) nas DUAS partes.
    15	set -uo pipefail
    16	REPO_ROOT="$(git rev-parse --show-toplevel)"; cd "$REPO_ROOT" || exit 2
    17	OUT="$REPO_ROOT/.claude/plans/PLAN-166/repass-ga"
