  1190	def _plan166rc3_text(name: str) -> Optional[Tuple[str, str]]:
  1191	    """Return (text, "live") for a PLAN-166 rc.3 workflow edit, or None.
  1192	
  1193	    LIVE ONLY, no staged fallback (rail rc.3 r1 P1-5): the cured workflow
  1194	    and this test file land ATOMICALLY in the rc.3 cure commit, so from
  1195	    the first commit that carries these tests the live file carries the
  1196	    marker. A staged fallback would let a post-landing revert of the live
  1197	    guard pass the pins against a stale mirror. Callers treat None as a
  1198	    hard FAILURE, never a skip.
  1199	    """
  1200	    live_p = _WF / name
  1201	    if live_p.exists():
  1202	        text = live_p.read_text(encoding="utf-8")
  1203	        if _MARKER_RC3 in text:
  1204	            return (text, "live")
  1205	    return None
