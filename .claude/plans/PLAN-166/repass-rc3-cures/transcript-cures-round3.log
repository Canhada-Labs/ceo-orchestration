   358	    def test_real_repo_rule_liveness(self):
   359	        """S287 vacuous-gate class: every doc-gated metric must match >=1
   360	        site in the real repo's watched docs. A metric at 0 matches is a
   361	        DEAD gate — it reports "no drift" with a number nobody compares
   362	        (`registered` was dead from birth: derived 47 phantom, matched no
   363	        doc, said "no drift" for months)."""
   364	        env = os.environ.copy()
   365	        r = subprocess.run(
   366	            ["bash", str(SCRIPT), "--json", "--no-tests"],
   367	            capture_output=True, text=True, timeout=60, env=env)
   368	        self.assertEqual(r.returncode, 0, r.stdout)
   369	        data = json.loads(r.stdout)
   370	        self.assertIn("rule_matches", data)
   371	        dead = sorted(k for k, v in data["rule_matches"].items() if v == 0)
   372	        self.assertEqual(dead, [], f"dead doc-gate rules (0 matches): {dead}")
