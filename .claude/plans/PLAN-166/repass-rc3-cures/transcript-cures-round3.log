  1342	        super().setUp()
  1343	        rel = (_WF / "release.yml").read_text(encoding="utf-8")
  1344	        m = re.search(r"^    timeout-minutes: (\d+)$", rel, re.M)
  1345	        assert m, "release.yml sem timeout-minutes de job"
  1346	        self.gate_minutes = int(m.group(1))
  1347	        if self.gate_minutes == 20:
  1348	            self.skipTest("pre-landing: release-gate ainda em 20 min")
  1349	        self.npm = (_WF / "npm-publish.yml").read_text(encoding="utf-8")
  1350	
  1351	    def test_poller_deadline_exceeds_gate_timeout_with_margin(self):
  1352	        m = re.search(r"DEADLINE=\$\(\( \$\(date \+%s\) \+ (\d+) \)\)", self.npm)
  1353	        self.assertIsNotNone(m, "linha DEADLINE do poller nao encontrada")
  1354	        deadline_s = int(m.group(1))
  1355	        self.assertGreaterEqual(
  1356	            deadline_s, self.gate_minutes * 60 + 600,
  1357	            "poller deadline (%ds) must exceed release-gate timeout "
  1358	            "(%d min) by >=10 min margin" % (deadline_s, self.gate_minutes),
  1359	        )
  1360	
  1361	    def test_await_job_timeout_exceeds_poller_deadline(self):
  1362	        m = re.search(r"DEADLINE=\$\(\( \$\(date \+%s\) \+ (\d+) \)\)", self.npm)
  1363	        self.assertIsNotNone(m)
  1364	        deadline_s = int(m.group(1))
  1365	        try:
  1366	            import yaml  # type: ignore
  1367	        except ImportError:  # pragma: no cover
