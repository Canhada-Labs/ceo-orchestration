   763	# (a metric at 0 is a dead gate reporting "no drift" unchecked).
   764	rule_matches = {m: 0 for m, _, _ in RULES}
   765	for m, _, _ in TABLE_RULES:
   766	    rule_matches.setdefault(m, 0)
   767	# PER-DOCUMENT accounting (pair-rail R3, P2). Aggregate-per-metric
   768	# liveness is a FLOOR, not the proof: a rule matching 5 of 6 watched docs
   769	# looks alive while the 6th drifts — which is exactly how
   770	# `docs/GUIA-COMPLETO.md` sat stale at 44 hooks after the metric-level
   771	# rule was "fixed". `rule_matches_by_doc[(metric, doc)]` lets the
   772	# real-repo test assert an explicit expectation SET, so a document that
   773	# silently stops matching is a failure rather than an invisible hole.
   774	rule_matches_by_doc = {}
