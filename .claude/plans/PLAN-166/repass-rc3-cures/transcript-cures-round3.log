   501	    def setUp(self):
   502	        super().setUp()
   503	        resolved = _plan166_text("npm-publish.yml")
   504	        if resolved is None:
   505	            self.skipTest(
   506	                "PLAN-166 npm-publish.yml not landed and staged mirror "
   507	                "absent (pre-landing CI window)"
   508	            )
   509	        self.source, self.context = resolved
