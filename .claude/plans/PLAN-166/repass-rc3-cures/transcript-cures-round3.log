   511	    def _jobs(self) -> dict:
   512	        try:
   513	            import yaml  # type: ignore
   514	        except ImportError:  # pragma: no cover - CI installs pyyaml
   515	            self.skipTest("pyyaml not installed")
   516	        return yaml.safe_load(self.source)["jobs"]
