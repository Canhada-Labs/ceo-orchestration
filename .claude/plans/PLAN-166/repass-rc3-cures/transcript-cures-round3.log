   334	      - name: Populate install.sh self-SHA trailer (P0-15, PLAN-045)
   335	        # PLAN-045 F-15R2-01 / Session 41: install.sh ships with a
   336	        # `# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL` trailer as its
   337	        # last line. At publish time, compute sha256 of the script body
   338	        # (all lines EXCEPT the last) and substitute the placeholder with
   339	        # the real hex. The script's own self-verify logic reads the same
   340	        # last-line pattern, so downstream adopters running
   341	        # `bash install.sh ...` trigger a rc=5 fail-CLOSED if the script
   342	        # is modified in transit.
   343	        working-directory: npm
   344	        run: |
   345	          set -euo pipefail
   346	          FILE="scripts/install.sh"
   347	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   348	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   349	            echo "::error::$FILE trailer not at expected placeholder state"
   350	            echo "got: $TRAILER_LINE"
   351	            exit 1
   352	          fi
   353	          # Compute sha of everything EXCEPT the last line.
   354	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
   355	          # In-place substitute ONLY the last line.
   356	          awk -v hash="$HASH" '
   357	            NR == FNR { total = NR; next }
   358	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   359	            { print }
   360	          ' "$FILE" "$FILE" > "$FILE.new"
   361	          mv "$FILE.new" "$FILE"
   362	          chmod +x "$FILE"
   363	          # Smoke-verify: execute the self-verify branch by running
   364	          # the script without args (hits _verify_self_sha, then usage).
   365	          bash "$FILE" 2>&1 | head -3 || true
   366	          echo "OK: install.sh trailer populated with sha256 $HASH"
