   180	def parse_timestamp(raw: Any) -> Optional[int]:
   181	    """ISO-8601 (GitHub flavour) -> epoch seconds UTC. ``None`` if unparseable.
   182	
   183	    ``datetime.fromisoformat`` cannot read a trailing ``Z`` on Python 3.9, so
   184	    this parses explicitly instead of depending on interpreter version.
   185	    """
   186	    if not isinstance(raw, str):
   187	        return None
   188	    m = _TS_RE.match(raw.strip())
   189	    if m is None:
   190	        return None
   191	    parts = [int(m.group(i)) for i in range(1, 7)]
   192	    try:
   193	        epoch = calendar.timegm(
   194	            (parts[0], parts[1], parts[2], parts[3], parts[4], parts[5], 0, 1, -1)
   195	        )
   196	    except (ValueError, OverflowError):
   197	        return None
   198	    off = m.group(7)
   199	    if off and off not in ("Z", "z"):
   200	        sign = 1 if off[0] == "+" else -1
   201	        digits = off[1:].replace(":", "")
   202	        epoch -= sign * (int(digits[:2]) * 3600 + int(digits[2:4]) * 60)
   203	    return epoch
