  2071	# source VERSION every run, backs up a differing pre-existing copy, and
  2072	# read-back-validates the write. A marker the upgrade could not validate is
  2073	# NOT recorded as delivered, so the FMS entry (and every marker-first
  2074	# reader keyed off the SAME record) falls back to VERSION instead of
  2075	# trusting a stale value. Delivered in BOTH ceremonies (inside .claude/).
  2076	_MARKER_DELIVERED=0
  2077	_refresh_framework_marker() {
  2078	  local src="$SOURCE_DIR/.claude/.framework-version"
  2079	  local dst="$TARGET/.claude/.framework-version"
  2080	  local bak="$BAK_DIR/.claude/.framework-version"
  2081	
  2082	  # ---- OBSERVE -------------------------------------------------------------
  2083	  local _lt _pr _lc _sh _md _sk
  2084	  if _lg_ancestor_is_symlink "$TARGET" ".claude/.framework-version"; then
  2085	    _lt="ancestor_symlink"
  2086	  else
  2087	    _lt="$( _ov_obs_live_type "$dst" )"
  2088	  fi
  2089	  _pr="$( _ov_obs_prior_record ".claude/.framework-version" )"
  2090	  _sh=no; [ -f "$src" ] && _sh=yes
  2091	  # Inspect CONTENT only for a regular file. `cmp` on a FIFO blocks waiting for
  2092	  # a writer, hanging the upgrade before the verdict can say PRESERVE_UNOWNED —
  2093	  # the third instance of "a reader opens what lstat already classified"
  2094	  # (codex W3 r4 P1; the OWN-0029 timeout).
  2095	  if [ "$_lt" != "regular" ]; then
  2096	    _lc="-"
  2097	  elif [ "$_sh" = yes ] && cmp -s "$src" "$dst" 2>/dev/null; then
  2098	    _lc="pristine"
  2099	  else
  2100	    _lc="edited"
  2101	  fi
  2102	  _md="$( _ov_obs_mode )"
  2103	  _sk="$( _ov_obs_skip ".claude/.framework-version" )"
  2104	
  2105	  # ---- DECIDE --------------------------------------------------------------
  2106	  local _pair _verdict
  2107	  if ! _pair="$( _ownership_verdict marker "$_pr" "$_lt" "$_lc" "$_sh" "$_md" \
  2108	                   "$CEREMONY_EFFECTIVE" upgrade "$_sk" )"; then
  2109	    echo "    WARNING: .claude/.framework-version dimensions are not a legal cell" >&2
  2110	    echo "             — PRESERVED without ownership. Please report this combination." >&2
  2111	    return 0
  2112	  fi
  2113	  _verdict="${_pair%% *}"
  2114	  _MARKER_HASH_SOURCE="${_pair##* }"
  2115	
  2116	  # ---- EXECUTE -------------------------------------------------------------
  2117	  case "$_verdict" in
  2118	    PRESERVE_OWNED)
  2119	      _MARKER_DELIVERED=1
  2120	      case "$_lt/$_sk" in
  2121	        ancestor_symlink/*) echo "    SKIP: .claude/.framework-version has a symlinked ancestor (refusing to write through it — F11a)" ;;
  2122	        symlink/*)          echo "    SKIP: .claude/.framework-version is the recorded --mode link delivery (target unchanged)" ;;
  2123	        */self)             echo "    SKIPPED (--skip): .claude/.framework-version" ;;
  2124	        *)                  echo "    SKIP: .claude/.framework-version (ownership carried forward)" ;;
  2125	      esac
  2126	      return 0
  2127	      ;;
  2128	
  2129	    OMIT_RECORD|PRESERVE_UNOWNED)
  2130	      if [ "$_sh" = no ]; then
  2131	        # The documented --pin downgrade: this source predates the marker, so a
  2132	        # retained record would keep advertising a newer version over older
  2133	        # content. Readers fall back to VERSION, which the pin DID update.
  2134	        echo "    SKIP: .claude/.framework-version absent in source (pre-v1.3.0 checkout)"
  2135	        if [ "$_pr" != "none" ]; then
  2136	          echo "    NOTE: the prior delivery record is NOT carried forward — version" >&2
  2137	          echo "          readers fall back to VERSION (which reflects the pinned source)" >&2
  2138	        fi
  2139	      elif [ "$_lt" = "symlink" ]; then
  2140	        echo "    WARNING: .claude/.framework-version is a symlink that does NOT match the" >&2
  2141	        echo "             recorded LINK delivery — preserved WITHOUT framework ownership" >&2
  2142	        echo "             (readers fall back to VERSION)" >&2
  2143	      else
  2144	        echo "    SKIP: .claude/.framework-version is $_lt — adopter-owned, refusing to write into/through it"
  2145	      fi
  2146	      return 0
  2147	      ;;
  2148	
  2149	    DELIVER|REFRESH)
  2150	      if [ "$DRY_RUN" -eq 1 ]; then
  2151	        echo "    (dry-run) would REFRESH: .claude/.framework-version ($(tr -d '[:space:]' < "$src" 2>/dev/null || true))"
  2152	        return 0
  2153	      fi
  2154	      if [ "$_verdict" = "REFRESH" ] && [ "$_lc" = "edited" ]; then
  2155	        mkdir -p "$( dirname "$bak" )" 2>/dev/null || true
  2156	        if { cp "$dst" "$bak" 2>/dev/null || false; }; then
  2157	          echo "    BACKED UP: .claude/.framework-version -> $bak"
  2158	        else
  2159	          # INV-3: an execution failure never advances the record.
  2160	          echo "    WARNING: could not back up differing .claude/.framework-version —" >&2
  2161	          echo "             REFUSING to overwrite it (backup-before-replace)" >&2
  2162	          # INV-3, same as the SPEC branch above.
  2163	          _up_record_op "preserve_marker_backup_failed" ".claude/.framework-version"
  2164	          if [ "$_pr" = "hash" ]; then
  2165	            _MARKER_DELIVERED=1
  2166	            _MARKER_HASH_SOURCE="HASH_PRIOR_RECORD"
  2167	          fi
  2168	          return 0
  2169	        fi
  2170	      fi
  2171	      mkdir -p "$( dirname "$dst" )"
  2172	      cp "$src" "$dst"
  2173	      # Read-back validation: a write that cannot be confirmed is NOT recorded
  2174	      # as delivered, so every marker-first reader falls back to VERSION rather
  2175	      # than trusting a value the upgrade could not verify.
  2176	      if cmp -s "$src" "$dst" 2>/dev/null; then
  2177	        _MARKER_DELIVERED=1
  2178	        _up_record_op "refresh_framework_marker" "$(tr -d '[:space:]' < "$src" 2>/dev/null || true)"
  2179	        echo "    REFRESHED: .claude/.framework-version ($(tr -d '[:space:]' < "$dst" 2>/dev/null || true))"
  2180	      else
  2181	        echo "    WARNING: .claude/.framework-version write did not validate — NOT recorded as" >&2
  2182	        echo "             delivered (marker-first readers fall back to VERSION; r20)" >&2
  2183	      fi
  2184	      return 0
  2185	      ;;
  2186	  esac
  2187	}
