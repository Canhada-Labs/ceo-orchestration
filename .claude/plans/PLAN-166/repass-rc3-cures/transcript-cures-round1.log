  1198	def _plan166rc3_text(name: str) -> Optional[Tuple[str, str]]:
  1199	    """Return (text, context) for a PLAN-166 rc.3 workflow edit, or None.
  1200	
  1201	    Priority: live copy carrying the rc.3 marker (post-landing,
  1202	    authoritative) -> staged copy under .claude/plans/PLAN-166/staged-rc3/
  1203	    (pre-landing ceremony pack, tracked) -> None (pre-landing: skip).
  1204	    """
  1205	    live_p = _WF / name
  1206	    if live_p.exists():
  1207	        text = live_p.read_text(encoding="utf-8")
  1208	        if _MARKER_RC3 in text:
  1209	            return (text, "live")
  1210	    staged_p = _STAGED_RC3_WF / name
  1211	    if staged_p.exists():
  1212	        return (staged_p.read_text(encoding="utf-8"), "staged")
  1213	    return None
