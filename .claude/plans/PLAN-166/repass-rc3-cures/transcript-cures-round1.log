   212	    def test_candidate_with_failed_gate_job_blocks(self):
   213	        run = release_run(conclusion="failure", jobs=[gate_job(conclusion="failure")])
   214	        result = decide(payload(self_run(), run), ctx())
   215	        self.assertEqual(BLOCK, result.decision)
   216	        self.assertEqual("gate-job-failure", result.reason)
   217	        proc = run_cli(json.dumps(payload(self_run(), run)))
   218	        self.assertEqual(EXIT_BLOCK, proc.returncode)
