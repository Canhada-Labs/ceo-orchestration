  1216	class NpmPublishTagLivenessTest(TestEnvContext):
  1217	    """rc.3 cure (GA re-pass part-2 P1): obsolete-run publish guard.
  1218	
  1219	    A delete/re-tag recovery leaves the original run re-approvable with
  1220	    checkout pinned to the old event SHA; nothing before `npm publish`
  1221	    re-resolved the remote tag, so an obsolete run could irreversibly
  1222	    publish the wrong tree. These pins keep the fail-closed liveness
  1223	    assert present, correctly shaped, and ORDERED immediately before the
  1224	    publish step.
  1225	    """
  1226	
  1227	    _GUARD_NAME = "Assert remote tag still points at this run's SHA"
  1228	    _PUBLISH_NAME = "Publish (Trusted Publishing — OIDC)"
  1229	
  1230	    def setUp(self):
  1231	        super().setUp()
  1232	        resolved = _plan166rc3_text("npm-publish.yml")
  1233	        if resolved is None:
  1234	            self.skipTest(
  1235	                "rc.3 npm-publish.yml not landed and staged-rc3 mirror "
  1236	                "absent (pre-landing window)"
  1237	            )
  1238	        self.source, self.context = resolved
  1239	
  1240	    def test_guard_step_present(self):
  1241	        self.assertIn(
  1242	            self._GUARD_NAME, self.source,
  1243	            "npm-publish.yml lost the tag-liveness guard — an obsolete "
  1244	            "run (delete/re-tag recovery) could publish the wrong tree "
  1245	            "(GA re-pass part-2 P1)",
  1246	        )
  1247	
  1248	    def test_guard_resolves_and_peels_remote_tag(self):
  1249	        for needle in (
  1250	            'git ls-remote origin "refs/tags/${TAG_REF}^{}"',
  1251	            'git ls-remote origin "refs/tags/${TAG_REF}"',
  1252	        ):
  1253	            self.assertIn(
  1254	                needle, self.source,
  1255	                "guard no longer resolves (or no longer peels) the "
  1256	                "remote tag — annotated and lightweight tags must both "
  1257	                "be covered",
  1258	            )
  1259	
  1260	    def test_guard_compares_against_github_sha_fail_closed(self):
  1261	        self.assertIn('[ "$LIVE" != "${GITHUB_SHA}" ]', self.source)
  1262	        self.assertIn('[ -z "$LIVE" ]', self.source,
  1263	                      "empty resolve (deleted tag) must abort, not pass")
  1264	        guard_body = self.source.split(self._GUARD_NAME, 1)[1].split(
  1265	            "- name:", 1)[0]
  1266	        self.assertIn("set -euo pipefail", guard_body)
  1267	        self.assertEqual(
  1268	            guard_body.count("exit 1"), 2,
  1269	            "guard must abort on BOTH failure branches (deleted tag, "
  1270	            "moved tag)",
  1271	        )
