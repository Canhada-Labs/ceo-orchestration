   226	    def test_malformed_payloads_block(self):
   227	        for body in ([], "workflow_runs", {"message": "Bad credentials"},
   228	                     {"workflow_runs": {"nope": 1}}, {"workflow_runs": ["not-an-object"]}):
   229	            result = decide(body, ctx())
   230	            self.assertEqual(BLOCK, result.decision, body)
   231	            self.assertEqual("malformed-payload", result.reason, body)
