    79	    # surface check-framework-updates.sh reads MARKER-FIRST — a bump that
    80	    # skips it leaves every adopter's updater reporting behind-minor
    81	    # forever. Joins _SITES with its oracle mirror in verify-counts
    82	    # VERSION_SITES (no census numeral here: the F6 guard forbids
    83	    # site-count claims in comments, ordinals included).
    84	    (".claude/.framework-version", PLAIN, r"\A\s*" + SEMVER + r"\s*\Z"),
    85	    ("npm/package.json", PLAIN, r'("version"\s*:\s*")' + SEMVER + r'(")'),
