   113	
   114	def self_run():
   115	    """The npm-publish run doing the asking — always in its own head_sha list."""
   116	    return {
   117	        "id": 1002,
   118	        "run_attempt": 1,
   119	        "path": ".github/workflows/npm-publish.yml",
   120	        "event": "push",
   121	        "head_branch": TAG,
   122	        "head_sha": HEAD_SHA,
   123	        "created_at": SELF_CREATED_AT,
   124	        "status": "in_progress",
   125	        "conclusion": None,
   126	        "jobs": [{"name": "await-release-gate", "status": "in_progress", "conclusion": None}],
   127	    }
   128	
   129	
   130	def payload(*runs):
   131	    return {"workflow_runs": list(runs)}
   132	
   133	
   134	def run_cli(raw_body, extra=(), self_created_at=SELF_CREATED_AT):
   135	    """CLI harness. ``self_created_at=None`` OMITS the flag entirely."""
   136	    handle, path = tempfile.mkstemp(suffix=".json")
   137	    with os.fdopen(handle, "w", encoding="utf-8") as fh:
   138	        fh.write(raw_body)
   139	    freshness = [] if self_created_at is None else ["--self-created-at", self_created_at]
   140	    try:
   141	        return subprocess.run(
   142	            [
   143	                sys.executable,
   144	                str(SCRIPT),
   145	                "--payload-file", path,
   146	                "--tag", TAG,
   147	                "--head-sha", HEAD_SHA,
   148	                "--deadline-epoch", str(DEADLINE_OPEN),
   149	                "--now-epoch", str(NOW),
   150	            ] + freshness + list(extra),
   151	            capture_output=True,
   152	            text=True,
   153	        )
   154	    finally:
   155	        os.unlink(path)
