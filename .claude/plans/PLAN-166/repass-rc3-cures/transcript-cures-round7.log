  1039	# ---- UNMATCHED-APPROX SWEEP ----
  1040	# The "non-inventory numerals" exemption in the header must not become a
  1041	# hiding place. Any thousands-shaped approximation in a watched doc that no
  1042	# approx rule consumed is named here, with its line, as a VIOLATION — it
  1043	# fails the gate. A warning here was a dead census (PLAN-166 W0 re-pass):
  1044	# validate.yml runs --quiet and the release preflight discards output, so
  1045	# no automated caller can see anything but the exit code, and an unmatched
  1046	# "~9k" planted in a watched doc shipped through both in total silence.
  1047	# Decimal-k belongs to the family (W0 re-pass round 2): approx_norm already
  1048	# PARSES '~1.4k' / '~13,5k' as 1400/13500 (round-1 finding 7 declared the
  1049	# form part of the ~Nk family), so a CONSUMED site in that shape is
  1050	# band-checked — but this sweep did not recognize it, and an UNCONSUMED
  1051	# '~1.4k widgets' in a watched doc shipped with EXIT=0: the exact F5
  1052	# false-pass class the sweep was upgraded to VIOLATION to stop. The
  1053	# `[.,]\d{1,2}` alternative admits both EN ('.') and pt (',') decimals;
  1054	# 3-digit groups stay with the thousands alternative.
  1055	_THOUSANDS_RX = re.compile(
  1056	    r'~\s*(?:\d+[.,]\d{3}\b|\d+[.,]\d{1,2}\s*[kK]\b|\d+\s*[kK]\b)')
  1057	for _doc in DOCS:
  1058	    _text = texts.get(_doc, "")
  1059	    _consumed = _approx_consumed.get(_doc, set())
  1060	    for _m in _THOUSANDS_RX.finditer(_text):
  1061	        if _m.start() in _consumed:
  1062	            continue
  1063	        violations.append(
  1064	            "%s:%d: thousands-shaped approximation '%s' is consumed by NO "
  1065	            "approx rule — give it a live metric + matcher, or delete the "
  1066	            "numeral  (rule: approx/unmatched-sweep)"
  1067	            % (_doc, _text.count("\n", 0, _m.start()) + 1, _m.group(0).strip())
  1068	        )
