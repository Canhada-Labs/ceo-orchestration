   804	    lv = live[metric]
   805	    # release_steps scans both DOCS and RELEASE_DOCS; all others scan only DOCS.
   806	    scan_docs = (DOCS + list(_RELEASE_STEPS_EXTRA_DOCS)
   807	                 if metric == "release_steps" else DOCS)
   808	    for doc in scan_docs:
   809	        text = texts.get(doc, "")
   810	        for rx in regexes:
   811	            for m in re.finditer(rx, text):
