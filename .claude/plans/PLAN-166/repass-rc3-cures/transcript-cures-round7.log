  1208	class NpmPublishTagLivenessTest(TestEnvContext):
  1209	    """rc.3 cure (GA re-pass part-2 P1): obsolete-run publish guard.
  1210	
  1211	    A delete/re-tag recovery leaves the original run re-approvable with
  1212	    checkout pinned to the old event SHA; nothing before `npm publish`
  1213	    re-resolved the remote tag, so an obsolete run could irreversibly
  1214	    publish the wrong tree. These pins keep the fail-closed liveness
  1215	    assert present, correctly shaped, and ORDERED immediately before the
  1216	    publish step.
  1217	    """
  1218	
  1219	    _GUARD_NAME = "Assert remote tag still points at this run's SHA"
  1220	    _PUBLISH_NAME = "Publish (Trusted Publishing — OIDC)"
  1221	
  1222	    def setUp(self):
  1223	        super().setUp()
  1224	        resolved = _plan166rc3_text("npm-publish.yml")
  1225	        if resolved is None:
  1226	            self.fail(
  1227	                "npm-publish.yml does not carry the rc.3 tag-liveness "
  1228	                "guard marker — the obsolete-run publish guard was "
  1229	                "reverted or stripped (rail rc.3 r1 P1-5: this is a "
  1230	                "hard failure, never a skip)"
  1231	            )
  1232	        self.source, self.context = resolved
  1233	
  1234	    def test_guard_step_present(self):
  1235	        self.assertIn(
  1236	            self._GUARD_NAME, self.source,
  1237	            "npm-publish.yml lost the tag-liveness guard — an obsolete "
  1238	            "run (delete/re-tag recovery) could publish the wrong tree "
  1239	            "(GA re-pass part-2 P1)",
  1240	        )
  1241	
  1242	    def test_guard_resolves_and_peels_remote_tag(self):
  1243	        # Single snapshot (rail rc.3 r1 P1-1) — but BOTH rows must be
  1244	        # parsed from it: the peeled ref (annotated tags) and the plain
  1245	        # ref (lightweight fallback).
  1246	        guard_body = self.source.split(self._GUARD_NAME, 1)[1].split(
  1247	            "- name:", 1)[0]
  1248	        for needle in (
  1249	            'awk -v r="refs/tags/${TAG_REF}^{}"',
  1250	            'awk -v r="refs/tags/${TAG_REF}"',
  1251	            'LIVE="${PEELED:-$PLAIN}"',
  1252	        ):
  1253	            self.assertIn(
  1254	                needle, guard_body,
  1255	                "guard no longer parses both the peeled and the plain "
  1256	                "ref out of the single ls-remote snapshot — annotated "
  1257	                "and lightweight tags must both be covered",
  1258	            )
  1259	
  1260	    def test_guard_compares_against_github_sha_fail_closed(self):
  1261	        self.assertIn('[ "$LIVE" != "${GITHUB_SHA}" ]', self.source)
  1262	        self.assertIn('[ -z "$LIVE" ]', self.source,
  1263	                      "empty resolve (deleted tag) must abort, not pass")
  1264	        guard_body = self.source.split(self._GUARD_NAME, 1)[1].split(
  1265	            "- name:", 1)[0]
  1266	        self.assertIn("set -euo pipefail", guard_body)
  1267	        self.assertEqual(
  1268	            guard_body.count("exit 1"), 2,
  1269	            "guard must abort on BOTH failure branches (deleted tag, "
  1270	            "moved tag)",
  1271	        )
  1272	
  1273	    def test_guard_ordered_between_registry_check_and_publish(self):
  1274	        i_already = self.source.index(
  1275	            "Check registry for already-published version")
  1276	        i_guard = self.source.index(self._GUARD_NAME)
  1277	        i_publish = self.source.index(self._PUBLISH_NAME)
  1278	        self.assertLess(
  1279	            i_already, i_guard,
