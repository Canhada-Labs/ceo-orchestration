   886	# ============================  APPROX EVALUATION  ===========================
   887	# Three failure modes (band, cross-doc equality, missing `~` marker), one
   888	# non-failure mode (registered PENDING site), and a printed input record for
   889	# every metric. See the APPROX CONTRACT block at the top of the file.
   890	warnings = []
   891	pending = []
   892	approx_sites = []        # [{metric, doc, cited, pending}]
   893	_approx_consumed = {}    # doc -> set of char offsets of `~` already consumed
   894	
   895	
   896	def _consume(doc, off):
   897	    _approx_consumed.setdefault(doc, set()).add(off)
   898	
   899	
   900	def _record_approx(metric, doc, raw, off):
   901	    _note(metric, doc)
   902	    _consume(doc, off)
   903	    cited = approx_norm(raw)
   904	    if cited is None:
   905	        violations.append(
   906	            "%s: %s approx claim '~%s' is not a parseable figure"
   907	            "  (rule: approx/shape)" % (doc, metric, raw)
   908	        )
   909	        return
   910	    approx_sites.append({"metric": metric, "doc": doc, "cited": cited})
  1000	# Inputs of the band, surfaced as named WARNINGs (contract clause 3).
  1001	for _metric in sorted(APPROX_INPUTS):
  1002	    _in = APPROX_INPUTS[_metric]
  1003	    if _in["skipped"]:
  1004	        warnings.append(
  1005	            "approx metric '%s': live measurement SKIPPED (--no-tests) — the "
  1006	            "band is NOT enforced this run" % _metric
  1007	        )
  1008	        continue
  1009	    if _in["collect_errors"]:
  1010	        _msg = (
  1011	            "approx metric '%s': %d COLLECTION ERROR(S) in `%s` — the observed "
  1012	            "value (%d) is measured over a PARTIAL population, so the +/-%d%% "
  1013	            "band is being applied to the wrong number. Fix the collection "
  1014	            "errors before trusting this rule."
  1015	            % (_metric, _in["collect_errors"], _in["command"],
  1016	               _in["observed"], int(APPROX_BAND * 100))
  1017	        )
  1018	        # Contract clause 3 (PLAN-166 W0 re-pass): when the band was actually
  1019	        # ENFORCED over >=1 doc site this run, a partial population makes the
  1020	        # verdict untrustworthy — and the automated callers (validate.yml
  1021	        # --quiet, the release preflight piping to /dev/null) can only see
  1022	        # the exit code, so this MUST fail the gate, not warn into a void.
  1023	        # It stays a warning only when the band is already suspended
  1024	        # (observed<=0) — there is no verdict to corrupt then.
  1025	        _enforced_sites = [
  1026	            s for s in approx_sites
  1027	            if s["metric"] == _metric and not s.get("pending")
  1028	        ]
  1029	        if _enforced_sites and _in["observed"] > 0:
  1030	            violations.append(_msg + "  (rule: approx/collect-errors)")
  1031	        else:
  1032	            warnings.append(_msg)
  1033	    if _in["observed"] <= 0:
  1034	        warnings.append(
  1035	            "approx metric '%s': `%s` returned 0 — the rule is VACUOUS in this "
  1036	            "tree (band suspended)" % (_metric, _in["command"])
  1037	        )
