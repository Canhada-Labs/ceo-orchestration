   966	            # passo FINAL verificado da cerimonia (npm view + recibo do
   967	            # step Publish + rechecks de tag/main). Elimina a janela de
   968	            # GA publico sem npm confirmado sob interrupcao local.
   969	            CREATE_ARGS+=(--draft)
