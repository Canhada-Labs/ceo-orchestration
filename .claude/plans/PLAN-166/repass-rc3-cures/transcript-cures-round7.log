   826	# =====================  CHANGELOG HEADER RULE (scoped)  =====================
   827	# PLAN-166 W2 rc.3 (GA re-pass part-1 P1): the CHANGELOG header carries a
   828	# four-count "as of vX.Y.Z: N skills, N slash commands, N ADRs, N `_lib`
   829	# modules" claim that no matcher watched — it sat at 188 ADRs while disk
   830	# had 190 and this gate stayed green. CHANGELOG.md deliberately does NOT
   831	# join DOCS: the log BODY legitimately carries historical counts (184,
   832	# 178, 171, ...) that every metric matcher would flag as drift. Only the
   833	# header claim is enforced, by this dedicated scoped rule. Fail modes:
   834	# stale count (exact mismatch) AND dead matcher (header rephrased so the
   835	# regex stops matching -> violation, never silence).
   836	CHANGELOG_DOC = "CHANGELOG.md"
   837	try:
   838	    _chlog_text = open(os.path.join(root, CHANGELOG_DOC), encoding="utf-8").read()
   839	except OSError:
   840	    _chlog_text = ""
   841	_CHLOG_HEADER_RX = re.compile(
   842	    r"v[\d.]+: (\d+) skills, (\d+) slash commands, (\d+) ADRs, "
   843	    r"(\d+) `_lib` modules\)"
   844	)
   845	# HEADER-scoped for real (rail rc.3 r1 P1-4): only the PREAMBLE — the text
   846	# before the first "## [" release heading — is searched. A body claim can
   847	# neither satisfy the matcher (masking a removed header) nor duplicate it.
   848	_chlog_hdr_end = re.search(r"(?m)^## \[", _chlog_text)
   849	_chlog_preamble = (
   850	    _chlog_text[:_chlog_hdr_end.start()] if _chlog_hdr_end else _chlog_text
   851	)
   852	_chlog_ms = list(_CHLOG_HEADER_RX.finditer(_chlog_preamble))
   853	if len(_chlog_ms) == 0:
   854	    # Dead-matcher violation ONLY when the file exists: synthetic test
   855	    # fixtures build trees without a CHANGELOG and must not fail here.
   856	    # Real-repo liveness is NOT lost to this scoping — the census mirror
   857	    # (test_verify_counts.py::_EXPECTED_SITES) asserts the four
   858	    # *@CHANGELOG.md pairs exist with exact counts in the real repo, so
   859	    # a deleted CHANGELOG or a rephrased header still fails loudly there.
   860	    if _chlog_text:
   861	        violations.append(
   862	            "%s: header count claim ('as of vX.Y.Z: N skills, N slash"
   863	            " commands, N ADRs, N `_lib` modules') not found in the"
   864	            " preamble — matcher dead or claim rephrased"
   865	            "  (rule: changelog/header)" % CHANGELOG_DOC
   866	        )
   867	elif len(_chlog_ms) > 1:
   868	    violations.append(
   869	        "%s: %d header count claims in the preamble — the site census"
   870	        " requires exactly one  (rule: changelog/header)"
   871	        % (CHANGELOG_DOC, len(_chlog_ms))
   872	    )
   873	else:
   874	    _chlog_m = _chlog_ms[0]
   875	    for _chm_metric, _chm_idx in (
   876	        ("skills", 1), ("commands", 2), ("adrs", 3), ("lib", 4),
   877	    ):
   878	        _note(_chm_metric, CHANGELOG_DOC)
   879	        _chm_v = int(_chlog_m.group(_chm_idx))
   880	        if _chm_v != live[_chm_metric]:
   881	            violations.append(
   882	                "%s: header cites %s=%d, live=%d  (rule: changelog/header)"
   883	                % (CHANGELOG_DOC, _chm_metric, _chm_v, live[_chm_metric])
   884	            )
