   816	                if kind == "exact" and v != lv:
   817	                    violations.append(
   818	                        f"{doc}: cites {metric}={v}, live={lv}  (rule: exact)"
   819	                    )
   820	                elif kind == "floor" and lv < v:
   821	                    violations.append(
   822	                        f"{doc}: cites {metric}>={v}+ but live={lv} (regression; rule: floor)"
   823	                    )
