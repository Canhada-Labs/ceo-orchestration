   899	        run: |
   900	          set -euo pipefail
   930	            exit 1
   931	          fi
   932	          echo "Rendered release notes:"
   933	          cat release-notes.md
   934	
   935	      # -----------------------------------------------------------------
   936	      # PLAN-153 Wave B item 5 (b) — idempotent release creation
   937	      # (`gh release view || gh release create`). A re-run of this job
   938	      # (workflow re-run, transient asset-upload failure) must not fail
   939	      # on an existing release: if the release already exists we
   940	      # re-sync the assets with `--clobber` and succeed-as-noop —
   941	      # covering the partial-failure case where `gh release create`
   942	      # made the release but died mid-asset-upload.
   943	      # RC tags (which reach this job since the RC-aware VERSION gate
   944	      # fix) are marked --prerelease so they never show as "Latest".
   945	      # NOTE: bash arrays are fine here — this runs on ubuntu-latest
   946	      # (bash 5); the bash-3.2 house rule applies to adopter-machine
   947	      # scripts (install.sh), and release.yml already uses arrays in
   948	      # the weekly-workflow gate (WORKFLOWS=(...)).
