    65	def _find_repo() -> Path:
    66	    """Repo root — robust to BOTH homes this file can run from.
    67	
    68	    At its landed path (.claude/scripts/tests/) four parents reach the
    69	    root; at its staged path (.claude/plans/PLAN-166/staged/...) they
    70	    reach the staged mirror instead. Walk up to the first ancestor that
    71	    actually looks like the repo (has the live workflow AND the hooks
    72	    tree) so pre-land verification runs from the staged location give
    73	    the same answers as post-land runs. (Merged in from the W1-B slice
    74	    by the PLAN-166 ceremony assembler.)
    75	    """
    76	    here = Path(__file__).resolve()
    77	    for candidate in here.parents:
    78	        if (
    79	            (candidate / ".github" / "workflows" / "release.yml").is_file()
    80	            and (candidate / ".claude" / "hooks" / "_lib").is_dir()
    81	        ):
    82	            return candidate
    83	    # Fall back to the landed-layout arithmetic; setUp guards will skip
    84	    # or fail loudly if this is wrong.
    85	    return here.parent.parent.parent.parent
    86	
    87	
