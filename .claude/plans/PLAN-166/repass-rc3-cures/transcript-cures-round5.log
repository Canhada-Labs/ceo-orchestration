    92	def gate_job(conclusion="success", status="completed"):
    93	    return {"name": "release-gate", "status": status, "conclusion": conclusion}
    94	
    95	
    96	def release_run(**over):
    97	    """A run that matches the candidate identity on every field by default."""
    98	    run = {
    99	        "id": 1001,
   100	        "run_attempt": 1,
   101	        "path": ".github/workflows/release.yml",
   102	        "event": "push",
   103	        "head_branch": TAG,
   104	        "head_sha": HEAD_SHA,
   105	        "created_at": CANDIDATE_CREATED_AT,
   106	        "status": "completed",
   107	        "conclusion": "success",
   108	        "jobs": [gate_job()],
   109	    }
   110	    run.update(over)
   111	    return run
