    36	def _mk(n: int, make_one) -> None:
    37	    for i in range(n):
    38	        make_one(i)
    39	
    40	
    41	def _scaffold(root: Path, *, core=3, frontend=2, domain=4, adrs=5,
    42	              hook_py=4, lib=6, registered=3, spec=2) -> dict:
    43	    """Build a minimal live tree and return the derived counts."""
    44	    sk = root / ".claude" / "skills"
    45	    _mk(core, lambda i: (sk / "core" / f"c{i}").mkdir(parents=True))
    46	    _mk(core, lambda i: (sk / "core" / f"c{i}" / "SKILL.md").write_text("x", encoding="utf-8"))
    47	    _mk(frontend, lambda i: (sk / "frontend" / f"f{i}").mkdir(parents=True))
    48	    _mk(frontend, lambda i: (sk / "frontend" / f"f{i}" / "SKILL.md").write_text("x", encoding="utf-8"))
    49	    _mk(domain, lambda i: (sk / "domains" / "d" / f"s{i}").mkdir(parents=True))
    50	    _mk(domain, lambda i: (sk / "domains" / "d" / f"s{i}" / "SKILL.md").write_text("x", encoding="utf-8"))
    51	
    52	    adr = root / ".claude" / "adr"; adr.mkdir(parents=True)
    53	    _mk(adrs, lambda i: (adr / f"ADR-{i:03d}-x.md").write_text("x", encoding="utf-8"))
    54	
    55	    hooks = root / ".claude" / "hooks"; (hooks / "_lib").mkdir(parents=True)
    56	    _mk(hook_py, lambda i: (hooks / f"check_{i}.py").write_text("x", encoding="utf-8"))
    57	    _mk(lib, lambda i: (hooks / "_lib" / f"mod_{i}.py").write_text("x", encoding="utf-8"))
    58	
    59	    spec_dir = root / "SPEC" / "v1"; spec_dir.mkdir(parents=True)
    60	    _mk(spec, lambda i: (spec_dir / f"s{i}.md").write_text("x", encoding="utf-8"))
    61	
    62	    # settings.json hooks{} SUBTREE with `registered` distinct hook .py
    63	    # entries — VALID JSON (the S287 fix parses the subtree instead of
    64	    # grepping the whole file). The top-level statusLine decoy references a
    65	    # hyphenated .py OUTSIDE hooks{}: the old whole-file grep mangled it
    66	    # into a phantom `ceo.py` and over-counted; the subtree parse must
    67	    # ignore it entirely.
    68	    settings = {
    69	        "statusLine": {"type": "command", "command": "python3 statusline-ceo.py"},
    70	        "hooks": {
    71	            "PreToolUse": [{
    72	                "matcher": "*",
    73	                "hooks": [
    74	                    {"command": f"bash _python-hook.sh reg_{i}.py"}
    75	                    for i in range(registered)
    76	                ],
    77	            }]
    78	        },
    79	    }
    80	    (hooks.parent / "settings.json").write_text(
    81	        json.dumps(settings, indent=2) + "\n", encoding="utf-8"
    82	    )
    83	    total = core + frontend + domain
    84	    return dict(total=total, core=core, frontend=frontend, domain=domain,
    85	                adrs=adrs, hook_py=hook_py, lib=lib, registered=registered)
