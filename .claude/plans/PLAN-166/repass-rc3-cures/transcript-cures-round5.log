   920	# Table-cell sites: the numeral sits alone in the VALUE cell with no noun
     1	"""verify-counts.sh hardened-gate unit tests.
     2	
     3	PLAN-112-FOLLOWUP-claude-md-count-drift W4 / AC5 — covers the bidirectional
     4	+ cross-file count gate that closes F-3-3.1 / F-4-docs-001.
     5	
     6	Cases (AC5): clean tree passes / wrong number fails / a `_lib` add bumps the
     7	count (proves `_lib` is counted) / cross-file mismatch fails. Plus the live
     8	repo's own docs pass (regression sentinel for the S161 reconciliation).
     9	
    10	The script is pointed at a synthetic tree via VERIFY_COUNTS_ROOT and run with
    11	--no-tests so the slow pytest-collect is skipped.
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import json
    17	import os
    18	import subprocess
    19	import unittest
    20	from pathlib import Path
    21	
    22	REPO_ROOT = Path(__file__).resolve().parents[3]
    23	SCRIPT = REPO_ROOT / ".claude" / "scripts" / "local" / "verify-counts.sh"
    24	
    25	
    26	def _run(root: Path | None = None, no_tests: bool = True) -> subprocess.CompletedProcess:
    27	    env = os.environ.copy()
    28	    if root is not None:
    29	        env["VERIFY_COUNTS_ROOT"] = str(root)
    30	    args = ["bash", str(SCRIPT), "--quiet"]
    31	    if no_tests:
    32	        args.append("--no-tests")
    33	    return subprocess.run(args, capture_output=True, text=True, timeout=60, env=env)
