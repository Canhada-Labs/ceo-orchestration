   129	class GateContext(NamedTuple):
   130	    """Every input the decision depends on. Printed with every decision."""
   131	
   132	    tag: str
   133	    head_sha: str
   134	    now_epoch: int
   135	    # REQUIRED — no default, one layer below the CLI for the same reason the
   136	    # CLI has ``required=True``: this field arms the delete+re-tag freshness
   137	    # leg, and a verdict-changing parameter with a default is a fail-open
   138	    # waiting for the first in-process caller of ``decide()`` that forgets
   139	    # it. Enforcing the doctrine only at argparse left exactly that hole.
   140	    self_created_at_epoch: int
