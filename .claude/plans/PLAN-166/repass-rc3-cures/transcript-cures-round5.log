    89	_WF = _REPO / ".github" / "workflows"
    90	_STAGED_WF = (
    91	    _REPO / ".claude" / "plans" / "PLAN-153" / "staged" / "wave-B"
    92	    / ".github" / "workflows"
    93	)
    94	_TEMPLATE = _REPO / ".github" / "release-notes-template.md"
    95	_PLUGIN_DIR = _REPO / ".claude-plugin"
    96	
    97	# Bootstrap TestEnvContext so env isolation holds (env-hygiene gate).
    98	_HOOKS_DIR = _REPO / ".claude" / "hooks"
    99	if str(_HOOKS_DIR) not in sys.path:
   100	    sys.path.insert(0, str(_HOOKS_DIR))
