    37	#     Owner-in-the-loop gate covering the Sprint 17 public-launch
    38	#     go/no-go decision (private-first strategy per
    39	#     `project_closure_strategy.md`).
    40	#
    41	# ---------------------------------------------------------------------
    42	# PLAN-166 W1 item 1 (F1, P0) — the publish now OBSERVES the governance
    43	# gate. `release.yml` and this workflow both fire on `push: tags: v*` as
    44	# two INDEPENDENT runs; until PLAN-166 nothing made the publish observe
    45	# the gate, so the only barrier was a human approving `production-npm`
    46	# with no machine evidence that `release-gate` was green — a live path
    47	# to publishing an unreviewed tree. A first job (`await-release-gate` —
    48	# deliberately NO `environment:` and NO RC exclusion, so it runs on RC
    49	# tags as a live positive control) polls release.yml's `release-gate`
    50	# JOB (never the run conclusion: CEO_SOTA_DISABLE=1 skips the job while
    51	# the run stays green) for THIS tag at THIS commit and fail-CLOSED
    52	# blocks unless it concluded success. `publish` gains
    53	# `needs: await-release-gate`; its `environment: production-npm`
    54	# approval and the RC exclusion are VERBATIM unchanged. Deliberate
    55	# ordering: the Owner's manual-approval prompt only appears AFTER the
    56	# gate is green — approval can never race ahead of machine evidence —
    57	# and the `already_published` idempotency guard STAYS in the publish
    58	# job (last-resort idempotency), not in the gate job. Do not "optimise"
    59	# the order back.
    60	#
    61	# Alternatives REJECTED (do not resurrect without a new debate):
    62	#   - `workflow_run` trigger: GitHub executes the workflow file from
    63	#     the DEFAULT branch, not the tag's tree — that kills the rollback
    64	#     invariant documented above (tag runs pin this workflow to the
    65	#     tag's tree; a failed GA publish means rollback + delete/re-tag).
    66	#   - moving the publish into release.yml: npm trusted publishing binds
    67	#     OIDC by workflow FILENAME
    68	#     (.claude/plans/PLAN-158/oidc-failure-playbook.md:18) — renaming
    69	#     the publishing workflow breaks the npmjs registration, plus ~6
    70	#     test pins on the npm-publish.yml path.
    71	#   - a reusable `workflow_call` gate shared by both workflows:
    72	#     refactor candidate, post-GA only (PLAN-166 §Deferred) — not
    73	#     during an open release window.
    74	#
    75	# The trusted-publisher binding triple (repository / workflow filename /
    76	# environment) is recorded in
    77	# .claude/governance/npm-trusted-publisher.txt and cross-checked by
    78	# .claude/scripts/tests/test_release_workflow_asserts.py, which READS
    79	# that file (embedding the values in the test would be a 4th copy of
    80	# the truth).
    81	
    82	on:
    83	  push:
    84	    tags:
    85	      - "v*"
    86	
    87	concurrency:
    88	  group: npm-publish-${{ github.ref }}
    89	  cancel-in-progress: false
    90	
    91	permissions:
    92	  contents: read
    93	  id-token: write   # required for OIDC trusted publishing + provenance
    94	
    95	jobs:
    96	  # ---------------------------------------------------------------------
    97	  # PLAN-166 W1 item 1 (F1, P0) — OBSERVE THE GOVERNANCE GATE.
    98	  # This job is the machine evidence that release.yml's `release-gate`
    99	  # job passed for this exact tag+SHA+push. It deliberately carries NO
   100	  # `environment:` and NO RC exclusion: it runs on rc tags too, which
   101	  # makes every RC a live positive control of the gate before GA ever
   102	  # depends on it.
   103	  # Decision function + battery: .claude/scripts/await_release_gate.py,
   104	  # .claude/scripts/tests/test_await_release_gate.py.
   105	  await-release-gate:
   106	    name: Await release-gate (release.yml)
   107	    runs-on: ubuntu-latest
   108	    # 50 > the poller's own 45-minute deadline, so a timeout surfaces as
   109	    # the decision function's fail-CLOSED BLOCK (with its inputs printed),
   110	    # not as an opaque runner kill. 45 min > the release-gate's own
   111	    # 35-minute timeout-minutes with margin (rail rc.3 r1 P1-3): the
   112	    # observer must always outlive the producer, or a gate finishing in
   113	    # minutes 31-35 goes green while the waiter already gave up.
   114	    timeout-minutes: 50
   115	    permissions:
   116	      contents: read   # checkout the tag to get the decision script
   117	      actions: read    # read release.yml's runs + jobs over the REST API
   118	    env:
   119	      # `permissions:` alone does NOT authenticate the `gh` CLI on a
   120	      # hosted runner. Without GH_TOKEN every poll dies on auth, which is
   121	      # BLOCK (fail-closed) — i.e. it would break EVERY release, RC and
   122	      # GA alike. This token is the job's only credential; the job has no
   123	      # id-token and no environment.
   124	      GH_TOKEN: ${{ github.token }}
   125	    steps:
   126	      - name: Checkout tag
   127	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   128	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   129	
   130	      - name: Poll release.yml until release-gate concludes
   131	        # No `${{ }}` interpolation inside this script by design — every
   132	        # value arrives through the environment, so no workflow expression
   133	        # is ever spliced into shell text.
   134	        run: |
   135	          set -euo pipefail
   136	          TAG="${GITHUB_REF_NAME}"
   137	          DEADLINE=$(( $(date +%s) + 2700 ))
   138	          SELF_CREATED_AT="$(gh api \
   139	            "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}" \
   140	            --jq '.created_at' < /dev/null)"
   141	          echo "inputs: tag=${TAG} head_sha=${GITHUB_SHA} run_id=${GITHUB_RUN_ID}"
   142	          echo "inputs: self_created_at=${SELF_CREATED_AT} deadline_epoch=${DEADLINE}"
   143	
   144	          fetch_payload() {
   145	            # One document: every run for THIS head_sha, each carrying its
   146	            # jobs. A run whose jobs endpoint is unreadable keeps no `jobs`
   147	            # key — the decision function reads that as WAIT, never GRANT.
   148	            if ! gh api --paginate \
   149	                "repos/${GITHUB_REPOSITORY}/actions/runs?head_sha=${GITHUB_SHA}&per_page=100" \
   150	                --jq '.workflow_runs[] | {id, run_attempt, path, event, head_branch, head_sha, created_at, status, conclusion}' \
   151	                > runs.ndjson < /dev/null; then
   152	              # An API error is BLOCK by design (ADR-186: input we cannot
   153	              # verify is blocked, not waved through).
   154	              echo '{"api_error": "runs listing failed"}' > payload.json
   155	              return 0
   156	            fi
   157	            : > runs_with_jobs.ndjson
   158	            while read -r run; do
   159	              [ -n "${run}" ] || continue
   160	              rid="$(printf '%s' "${run}" | jq -r '.id')"
   161	              if ! run_jobs="$(gh api \
   162	                  "repos/${GITHUB_REPOSITORY}/actions/runs/${rid}/jobs?per_page=100" \
   163	                  --jq '[.jobs[] | {name, status, conclusion}]' < /dev/null)"; then
   164	                printf '%s\n' "${run}" >> runs_with_jobs.ndjson
   165	                continue
   166	              fi
   167	              printf '%s' "${run}" \
   168	                | jq -c --argjson jobs "${run_jobs}" '. + {jobs: $jobs}' \
   169	                >> runs_with_jobs.ndjson
   170	            done < runs.ndjson
   171	            jq -c -s '{workflow_runs: .}' runs_with_jobs.ndjson > payload.json
   172	          }
   173	
   174	          attempt=0
   175	          while true; do
   176	            attempt=$(( attempt + 1 ))
   177	            fetch_payload
   178	            set +e
   179	            python3 .claude/scripts/await_release_gate.py \
   180	              --payload-file payload.json \
   181	              --tag "${TAG}" \
   182	              --head-sha "${GITHUB_SHA}" \
   183	              --self-created-at "${SELF_CREATED_AT}" \
   184	              --deadline-epoch "${DEADLINE}"
   185	            rc=$?
   186	            set -e
   187	            case "${rc}" in
   188	              0)
   189	                echo "::notice::release-gate green for ${TAG} at ${GITHUB_SHA} — publish authorised (poll ${attempt})"
   190	                exit 0
   191	                ;;
   192	              3)
   193	                sleep 20
   194	                ;;
   195	              *)
   196	                echo "::error::release-gate did not authorise this publish (decision exit ${rc}, poll ${attempt}) — the printed inputs above name the run and job that were evaluated"
   197	                exit 1
   198	                ;;
   199	            esac
   200	          done
   201	
   202	  publish:
   203	    # PLAN-013 Phase 0 item 0.2 — RC tag guard.
   204	    # RC tags contain `-rc.` (e.g. `v1.4.0-rc.1`). Skip them entirely.
   205	    # Only GA tags (`v1.4.0`) proceed, and those gate through the
   206	    # `production-npm` environment (manual approval).
   207	    # PLAN-153 Wave B item 5 (f): RC posture UNCHANGED — this exclusion
   208	    # is load-bearing (PLAN-013 anti-goals #3/#16) and MUST survive any
   209	    # future edit to this file; the draft `next` dist-tag idea was
   210	    # DROPPED by ratified debate. Pinned by
   211	    # .claude/scripts/tests/test_release_workflow_asserts.py.
   212	    if: "!contains(github.ref, '-rc.')"
   213	    # PLAN-166 W1 item 1: publish only starts after `await-release-gate`
   214	    # proved release.yml's release-gate job green for this exact tag+SHA
   215	    # (default `success()` semantics of `needs:` — an await failure skips
   216	    # this job while the run itself goes red). Deliberate ordering: the
   217	    # production-npm manual-approval prompt appears only AFTER the gate
   218	    # is green. The `already_published` guard stays below, in this job.
   219	    needs: await-release-gate
   220	    runs-on: ubuntu-latest
   221	    environment: production-npm
   222	    timeout-minutes: 8
   223	    steps:
   224	      - name: Checkout tag
   225	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   226	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   227	        with:
   228	          fetch-depth: 0
   229	
   230	      - name: Setup Node 20
   231	        # SHA-pinned: actions/setup-node@v4.1.0
   232	        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e
   233	        with:
   234	          node-version: "20"
   235	          registry-url: "https://registry.npmjs.org"
   236	
   237	      - name: Upgrade npm CLI for Trusted Publishing (OIDC)
   238	        # PLAN-158 W1 (debate, all 3 critics): Node 20 bundles npm 10.x,
   239	        # which does NOT implement the trusted-publishing token exchange —
   240	        # without this step the OIDC publish dies ENEEDAUTH at GA, and
   241	        # there is no earlier proof point (RC tags skip this workflow
   242	        # entirely). npm >=11.5.1 is the first trusted-publishing-GA CLI.
   243	        run: |
   244	          set -euo pipefail
   245	          npm install -g npm@^11.5.1
   246	          NPM_V="$(npm --version)"
   247	          case "$NPM_V" in
   248	            10.*|11.0.*|11.1.*|11.2.*|11.3.*|11.4.*|11.5.0)
   249	              echo "::error::npm $NPM_V < 11.5.1 — trusted publishing unsupported"
   250	              exit 1
   251	              ;;
   252	          esac
   253	          echo "OK: npm $NPM_V (>=11.5.1, trusted-publishing capable)"
   254	
   255	      - name: Verify VERSION matches tag
   256	        run: |
   257	          set -euo pipefail
   258	          TAG="${GITHUB_REF_NAME}"
   259	          VERSION_FILE="$(tr -d '[:space:]' < VERSION)"
   260	          EXPECTED="${TAG#v}"
   261	          if [[ "$VERSION_FILE" != "$EXPECTED" ]]; then
   262	            echo "::error::VERSION ($VERSION_FILE) does not match tag ($TAG → $EXPECTED)"
   263	            exit 1
   264	          fi
   265	          echo "OK: VERSION=$VERSION_FILE matches tag=$TAG"
   266	
   267	      - name: Verify npm/package.json version matches VERSION
   268	        run: |
   269	          set -euo pipefail
   270	          PKG_VERSION=$(node -p "require('./npm/package.json').version")
   271	          VERSION_FILE="$(tr -d '[:space:]' < VERSION)"
   272	          if [[ "$PKG_VERSION" != "$VERSION_FILE" ]]; then
   273	            echo "::error::npm/package.json version ($PKG_VERSION) does not match VERSION ($VERSION_FILE)"
   274	            exit 1
   275	          fi
   276	          echo "OK: npm/package.json version=$PKG_VERSION matches VERSION"
   277	
   278	      - name: Verify zero runtime dependencies
   279	        run: |
   280	          set -euo pipefail
   281	          DEP_COUNT=$(node -p "Object.keys(require('./npm/package.json').dependencies || {}).length")
   282	          if [[ "$DEP_COUNT" -ne 0 ]]; then
   283	            echo "::error::ceo-orchestration must ship with 0 runtime dependencies (got $DEP_COUNT)"
   284	            exit 1
   285	          fi
   286	          echo "OK: ceo-orchestration has zero runtime dependencies"
   287	
   288	      - name: Stage bundle into npm/
   289	        # The npm package needs the framework source tree relative to npm/.
   290	        # Copy (don't symlink — npm pack walks symlinks unpredictably across hosts).
   291	        # PLAN-152 tarball-01: SELECTIVE staging. The root .npmignore is INERT
   292	        # (package.json "files" whitelist takes precedence in npm-packlist), so
   293	        # exclusion must happen at stage time. Framework-internal artifacts
   294	        # (test harness, fixture corpora, eval/, red-team corpus, numbered plan
   295	        # trees, _lib/testing.py + _lib/test_isolation.py per the PLAN-120
   296	        # contract install.sh already honors) must NOT ship. Kept deliberately:
   297	        # .claude/plans/ schemas + README + examples/ (install.sh provisions
   298	        # them) and .claude/policies/fixtures/ (install.sh PLAN-014 A.8 ships
   299	        # the policy bundle including fixtures).
   300	        run: |
   301	          set -euo pipefail
   302	          RSYNC_EXCLUDES=(
   303	            --include='.claude/policies/fixtures/'
   304	            --include='templates/oidc-proxy/tests/'
   305	            --include='templates/oidc-proxy/tests/**'
   306	            --exclude='**/tests/'
   307	            --exclude='**/fixtures/'
   308	            --exclude='.claude/scripts/red-team-corpus/'
   309	            --exclude='.claude/eval/'
   310	            --exclude='.claude/plans/PLAN-[0-9]*'
   311	            --exclude='.claude/hooks/_lib/testing.py'
   312	            --exclude='.claude/hooks/_lib/test_isolation.py'
   313	            --exclude='__pycache__/'
   314	            --exclude='*.pyc'
   315	            --exclude='.pytest_cache/'
   316	          )
   317	          # GA-F3 (S288, fechado S293): README.md FORA da lista — rsync do README
   318	          # raiz sobrescrevia o npm/README.md REVISADO (stamp de review é gate de
   319	          # release em verify-counts VERSION_SITES). O npm publica o npm/README.md
   320	          # rastreado, que é a cópia npm-facing revisada a cada bump.
   321	          for src in scripts templates .claude SPEC VERSION LICENSE PROTOCOL.md; do
   322	            if [[ -e "$src" ]]; then
   323	              rsync -a --delete --delete-excluded "${RSYNC_EXCLUDES[@]}" "$src" "npm/"
   324	            fi
   325	          done
   326	          ls -la npm/
   327	
   328	      - name: Syntax-check the shim
   329	        run: node --check npm/bin/ceo-orch-init.js
   330	
   331	      - name: Verify scripts/install.sh is present in staged bundle
   332	        run: test -f npm/scripts/install.sh
   333	
   334	      - name: Populate install.sh self-SHA trailer (P0-15, PLAN-045)
   335	        # PLAN-045 F-15R2-01 / Session 41: install.sh ships with a
   336	        # `# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL` trailer as its
   337	        # last line. At publish time, compute sha256 of the script body
   338	        # (all lines EXCEPT the last) and substitute the placeholder with
   339	        # the real hex. The script's own self-verify logic reads the same
   340	        # last-line pattern, so downstream adopters running
   341	        # `bash install.sh ...` trigger a rc=5 fail-CLOSED if the script
   342	        # is modified in transit.
   343	        working-directory: npm
   344	        run: |
   345	          set -euo pipefail
   346	          FILE="scripts/install.sh"
   347	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   348	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   349	            echo "::error::$FILE trailer not at expected placeholder state"
   350	            echo "got: $TRAILER_LINE"
   351	            exit 1
   352	          fi
   353	          # Compute sha of everything EXCEPT the last line.
   354	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
   355	          # In-place substitute ONLY the last line.
   356	          awk -v hash="$HASH" '
   357	            NR == FNR { total = NR; next }
   358	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   359	            { print }
   360	          ' "$FILE" "$FILE" > "$FILE.new"
   361	          mv "$FILE.new" "$FILE"
   362	          chmod +x "$FILE"
   363	          # Smoke-verify: execute the self-verify branch by running
   364	          # the script without args (hits _verify_self_sha, then usage).
   365	          bash "$FILE" 2>&1 | head -3 || true
   366	          echo "OK: install.sh trailer populated with sha256 $HASH"
   367	
   368	      - name: Packlist gate (PLAN-152 tarball-02)
   369	        # Last-line assert before publish: the would-be tarball must carry no
   370	        # tests/ or fixtures/ dirs (except .claude/policies/fixtures/, shipped
   371	        # by install.sh contract), no .claude/eval/, no red-team-corpus/, no
   372	        # .claude/plans/PLAN-<N>* artifacts, no _lib/testing.py or
   373	        # _lib/test_isolation.py. Fail-closed: a pack or JSON parse failure
   374	        # fails the job (set -euo pipefail).
   375	        working-directory: npm
   376	        run: |
   377	          set -euo pipefail
   378	          npm pack --dry-run --json 2>/dev/null | python3 -c '
   379	          import json, re, sys
   380	          d = json.load(sys.stdin)
   381	          o = d[0] if isinstance(d, list) else d
   382	          paths = [f["path"] for f in o["files"]]
   383	          pat = re.compile(r"(^|/)(tests|fixtures)(/|$)|(^|/)eval/|(^|/)red-team-corpus/|(^|/)plans/PLAN-[0-9]|(^|/)_lib/(testing|test_isolation)\.py$")
   384	          allow = (".claude/policies/fixtures/", "templates/oidc-proxy/tests/")
   385	          bad = [p for p in paths if pat.search(p) and not p.startswith(allow)]
   386	          if bad:
   387	              print("::error::tarball would ship %d framework-internal artifact(s):" % len(bad))
   388	              print("\n".join(bad[:40]))
   389	              sys.exit(1)
   390	          print("OK: packlist clean — %d files" % len(paths))
   391	          '
   392	
   393	      # -----------------------------------------------------------------
   394	      # PLAN-153 Wave B item 5 (a) — `already_published` idempotency
   395	      # guard. Before publishing, ask the registry whether this exact
   396	      # name@version already exists. If it does (a re-run of a
   397	      # previously successful publish, or a re-run after a post-publish
   398	      # step failed), the Publish step is skipped and the job succeeds
   399	      # as a documented no-op instead of going red on EPUBLISHCONFLICT.
   400	      #
   401	      # Detection is deliberately conservative: "published" ONLY when
   402	      # `npm view <name>@<version> version` exits 0 AND prints exactly
   403	      # the version (npm has historically flip-flopped between
   404	      # rc!=0/E404 and rc=0/empty-stdout for a missing version of an
   405	      # existing package — both shapes are treated as not-published).
   406	      # Any registry/network error therefore falls through to the
   407	      # publish attempt, which preserves today's behavior (npm itself
   408	      # fails closed on a true conflict). No auth needed: the package
   409	      # is public and `npm view` is an unauthenticated read.
   410	      # -----------------------------------------------------------------
   411	      - name: Check registry for already-published version
   412	        id: already_published
   413	        working-directory: npm
   414	        run: |
   415	          set -euo pipefail
   416	          PKG_NAME=$(node -p "require('./package.json').name")
   417	          PKG_VERSION=$(node -p "require('./package.json').version")
   418	          set +e
   419	          SEEN=$(npm view "${PKG_NAME}@${PKG_VERSION}" version 2>/dev/null)
   420	          RC=$?
   421	          set -e
   422	          if [[ "$RC" -eq 0 && "$SEEN" == "$PKG_VERSION" ]]; then
   423	            echo "published=true" >> "$GITHUB_OUTPUT"
   424	            echo "::notice::${PKG_NAME}@${PKG_VERSION} already exists in the registry — publish will be skipped (idempotent re-run, succeed-as-noop)"
   425	          else
   426	            echo "published=false" >> "$GITHUB_OUTPUT"
   427	            echo "OK: ${PKG_NAME}@${PKG_VERSION} not in registry (rc=$RC) — proceeding to publish"
   428	          fi
   429	
   430	      # -----------------------------------------------------------------
   431	      # PLAN-166 W2 rc.3 (GA re-pass part-2 P1): a delete/re-tag recovery
   432	      # leaves the ORIGINAL run re-approvable (or its failed portion
   433	      # re-runnable) with checkout pinned to the OLD event SHA — every
   434	      # in-run version check still passes (both trees carry the same
   435	      # version string), the registry is still empty, and npm publish
   436	      # would irreversibly ship the WRONG tree while the live tag points
   437	      # elsewhere. Fail-closed liveness assert: the CURRENT remote tag
   438	      # must still peel to this run's GITHUB_SHA immediately before
   439	      # publish. A deleted tag (empty resolve) and a moved tag both
   440	      # abort. This step sits AFTER the production-npm environment
   441	      # approval by job order, so a stale approval cannot race past it.
   442	      # -----------------------------------------------------------------
   443	      - name: Assert remote tag still points at this run's SHA
   444	        # Same skip-condition as the publish step (rail rc.3 r1 P1-2): when
   445	        # the registry already carries the version, publish is a no-op and
   446	        # this guard must not turn the documented idempotent re-run red.
   447	        if: steps.already_published.outputs.published != 'true'
   448	        run: |
   449	          set -euo pipefail
   450	          TAG_REF="${GITHUB_REF_NAME}"
   451	          # ONE ls-remote invocation = ONE remote snapshot (rail rc.3 r1
   452	          # P1-1): separate calls could straddle a concurrent re-tag, keep
   453	          # the OLD peeled SHA and approve the obsolete run.
   454	          SNAP="$(git ls-remote origin "refs/tags/${TAG_REF}" "refs/tags/${TAG_REF}^{}")"
   455	          PEELED="$(printf '%s\n' "$SNAP" | awk -v r="refs/tags/${TAG_REF}^{}" '$2==r{print $1}')"
   456	          PLAIN="$(printf '%s\n' "$SNAP" | awk -v r="refs/tags/${TAG_REF}" '$2==r{print $1}')"
   457	          LIVE="${PEELED:-$PLAIN}"
   458	          if [ -z "$LIVE" ]; then
   459	            echo "::error::tag ${TAG_REF} no longer exists on origin — refusing to publish an orphaned tree (delete/re-tag recovery in flight?)"
   460	            exit 1
   461	          fi
   462	          if [ "$LIVE" != "${GITHUB_SHA}" ]; then
   463	            echo "::error::tag ${TAG_REF} now peels to ${LIVE} but this run was built from ${GITHUB_SHA} — obsolete run; approve/re-run only from the CURRENT tag's run"
   464	            exit 1
   465	          fi
   466	          echo "OK: refs/tags/${TAG_REF} still peels to ${GITHUB_SHA}"
   467	
   468	      - name: Publish (Trusted Publishing — OIDC)
   469	        if: steps.already_published.outputs.published != 'true'
   470	        working-directory: npm
   471	        # PLAN-158 W1: NO long-lived token — npm >=11.5.1 detects the
   472	        # GitHub Actions OIDC context and mints a short-lived credential
   473	        # against the npmjs trusted-publisher registration (repo
   474	        # Canhada-Labs/ceo-orchestration, workflow npm-publish.yml,
