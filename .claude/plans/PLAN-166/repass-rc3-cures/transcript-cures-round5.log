   273	class FreshnessTests(TestEnvContext):
   274	    def test_success_predating_the_asking_run_does_not_grant(self):
   275	        # delete + re-tag of the SAME sha: the OLD green run is still listed.
   276	        stale = release_run(id=900, created_at=STALE_CREATED_AT)
   277	        body = payload(self_run(), stale)
   278	        result = decide(body, ctx())
   279	        self.assertNotEqual(GRANT, result.decision)
   280	        self.assertEqual(WAIT, result.decision)
   281	        self.assertEqual("stale-candidates-only", result.reason)
   282	        self.assertEqual(1, result.facts["stale_candidates"])
   283	        self.assertEqual(BLOCK, decide(body, ctx(now=NOW_PAST_DEADLINE)).decision)
   284	
   285	    def test_fresh_rerun_wins_over_the_stale_success(self):
   286	        stale = release_run(id=900, created_at=STALE_CREATED_AT)
   287	        fresh_failure = release_run(
   288	            id=901, created_at=CANDIDATE_CREATED_AT,
   289	            conclusion="failure", jobs=[gate_job(conclusion="failure")],
   290	        )
   291	        result = decide(payload(self_run(), stale, fresh_failure), ctx())
   292	        self.assertEqual(BLOCK, result.decision)
   293	        self.assertEqual("gate-job-failure", result.reason)
