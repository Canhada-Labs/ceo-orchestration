  1335	class ObserverProducerDeadlineTest(TestEnvContext):
  1336	    """rail rc.3 r1 P1-3: the await-release-gate observer must outlive
  1337	    the release-gate producer, or a gate finishing inside the widened
  1338	    timeout goes green while the waiter already gave up (order-dependent
  1339	    rerun on the GA path)."""
  1340	
  1341	    def setUp(self):
  1342	        super().setUp()
  1343	        rel = (_WF / "release.yml").read_text(encoding="utf-8")
  1344	        m = re.search(r"^    timeout-minutes: (\d+)$", rel, re.M)
  1345	        assert m, "release.yml sem timeout-minutes de job"
  1346	        self.gate_minutes = int(m.group(1))
  1347	        # rail rc.3 r3 P2: NO pre-landing skip — the cured release.yml and
  1348	        # this test land atomically, so from the first commit carrying this
  1349	        # class the producer timeout is 35. A revert to 20 must FAIL here
  1350	        # loudly (green-by-skip was the exact hole flagged).
  1351	        self.assertEqual(
  1352	            self.gate_minutes, 35,
  1353	            "release-gate timeout-minutes drifted from the ratified 35 "
  1354	            "(a revert of the rc.3 cure, or an unratified retune)",
  1355	        )
  1356	        self.npm = (_WF / "npm-publish.yml").read_text(encoding="utf-8")
  1357	
  1358	    def test_poller_deadline_exceeds_gate_timeout_with_margin(self):
  1359	        m = re.search(r"DEADLINE=\$\(\( \$\(date \+%s\) \+ (\d+) \)\)", self.npm)
  1360	        self.assertIsNotNone(m, "linha DEADLINE do poller nao encontrada")
  1361	        deadline_s = int(m.group(1))
  1362	        self.assertGreaterEqual(
  1363	            deadline_s, self.gate_minutes * 60 + 600,
  1364	            "poller deadline (%ds) must exceed release-gate timeout "
  1365	            "(%d min) by >=10 min margin" % (deadline_s, self.gate_minutes),
  1366	        )
  1367	
  1368	    def test_await_job_timeout_exceeds_poller_deadline(self):
  1369	        m = re.search(r"DEADLINE=\$\(\( \$\(date \+%s\) \+ (\d+) \)\)", self.npm)
  1370	        self.assertIsNotNone(m)
  1371	        deadline_s = int(m.group(1))
  1372	        try:
  1373	            import yaml  # type: ignore
  1374	        except ImportError:  # pragma: no cover
  1375	            self.skipTest("pyyaml not installed")
  1376	        jobs = yaml.safe_load(self.npm)["jobs"]
  1377	        job_minutes = jobs["await-release-gate"]["timeout-minutes"]
  1378	        self.assertGreater(
  1379	            job_minutes * 60, deadline_s,
  1380	            "await job timeout must exceed its own poller deadline so a "
  1381	            "timeout surfaces as the decision function's BLOCK, not an "
  1382	            "opaque runner kill",
  1383	        )
