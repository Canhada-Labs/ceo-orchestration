   886	# ============================  APPROX EVALUATION  ===========================
   887	# Three failure modes (band, cross-doc equality, missing `~` marker), one
   888	# non-failure mode (registered PENDING site), and a printed input record for
   889	# every metric. See the APPROX CONTRACT block at the top of the file.
   890	warnings = []
   891	pending = []
   892	approx_sites = []        # [{metric, doc, cited, pending}]
   893	_approx_consumed = {}    # doc -> set of char offsets of `~` already consumed
   894	
   895	
   896	def _consume(doc, off):
   897	    _approx_consumed.setdefault(doc, set()).add(off)
   898	
   899	
   900	def _record_approx(metric, doc, raw, off):
   901	    _note(metric, doc)
   902	    _consume(doc, off)
   903	    cited = approx_norm(raw)
   904	    if cited is None:
   905	        violations.append(
   906	            "%s: %s approx claim '~%s' is not a parseable figure"
   907	            "  (rule: approx/shape)" % (doc, metric, raw)
   908	        )
   909	        return
   910	    approx_sites.append({"metric": metric, "doc": doc, "cited": cited})
   911	
   912	
   913	for _metric, _regexes in APPROX_RULES:
   914	    for _doc in DOCS:
   915	        _text = texts.get(_doc, "")
   916	        for _rx in _regexes:
   917	            for _m in re.finditer(_rx, _text):
   918	                _record_approx(_metric, _doc, _m.group(1), _m.start())
