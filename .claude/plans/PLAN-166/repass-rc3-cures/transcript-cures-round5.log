   177	class NeverGrantTests(TestEnvContext):
   178	    """Green look-alikes: never GRANT, and never a false BLOCK in time."""
   179	
   180	    def _assert_never_grants(self, run):
   181	        body = payload(self_run(), run)
   182	        in_time = decide(body, ctx())
   183	        self.assertEqual(WAIT, in_time.decision)
   184	        self.assertEqual("candidate-not-yet-created", in_time.reason)
   185	        self.assertEqual(0, in_time.facts["identity_matches"])
   186	        expired = decide(body, ctx(now=NOW_PAST_DEADLINE))
   187	        self.assertEqual(BLOCK, expired.decision)
   188	
   189	    def test_release_gate_success_on_a_different_tag_does_not_grant(self):
   190	        self._assert_never_grants(release_run(head_branch="v1.3.0-rc.2", id=2001))
   191	
   192	    def test_release_gate_success_on_another_commit_does_not_grant(self):
   193	        self._assert_never_grants(release_run(head_sha=OTHER_SHA, id=2002))
   194	
   195	    def test_release_gate_success_from_the_wrong_workflow_does_not_grant(self):
   196	        self._assert_never_grants(
   197	            release_run(path=".github/workflows/validate.yml", id=2003)
   198	        )
   199	
   200	    def test_release_gate_success_from_workflow_dispatch_does_not_grant(self):
   201	        self._assert_never_grants(release_run(event="workflow_dispatch", id=2004))
