   261	def select_candidate(
   262	    runs: Sequence[Dict[str, Any]], ctx: GateContext
   263	) -> Tuple[Optional[Dict[str, Any]], Dict[str, int]]:
   264	    """Most recent FRESH identity-matching run, plus a census of what was seen.
   265	
   266	    Raises MalformedPayload when an identity-matching run carries a
   267	    ``created_at`` we cannot parse: a candidate we cannot date cannot be
   268	    proven fresh, and unverifiable input is fail-CLOSED.
   269	    """
   270	    census = {"runs_total": len(runs), "identity_matches": 0, "stale_candidates": 0}
   271	    best: Optional[Dict[str, Any]] = None
   272	    best_key: Optional[Tuple[int, int, int]] = None
   273	    floor = ctx.freshness_floor
   274	    for run in runs:
   275	        if not is_identity_match(run, ctx):
   276	            continue
   277	        census["identity_matches"] += 1
   278	        created_at = parse_timestamp(run.get("created_at"))
   279	        if created_at is None:
   280	            raise MalformedPayload(
   281	                "candidate run id=%r has an unparseable created_at=%r"
   282	                % (run.get("id"), run.get("created_at"))
   283	            )
   284	        if created_at < floor:
   285	            census["stale_candidates"] += 1
   286	            continue
   287	        key = _sort_key(run, created_at)
   288	        if best_key is None or key > best_key:
   289	            best, best_key = run, key
   290	    census["fresh_candidates"] = census["identity_matches"] - census["stale_candidates"]
   291	    return best, census
