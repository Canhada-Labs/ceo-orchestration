   246	    x="${BASH_REMATCH[1]}"
   247	    y="${BASH_REMATCH[2]}"
   248	    z="${BASH_REMATCH[3]}"
   249	    rc="${BASH_REMATCH[4]}"
   250	  elif [[ "$v" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
   251	    x="${BASH_REMATCH[1]}"
   252	    y="${BASH_REMATCH[2]}"
   253	    z="${BASH_REMATCH[3]}"
   254	    rc="999"
