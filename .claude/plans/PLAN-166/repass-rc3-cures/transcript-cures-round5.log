   158	class GrantTests(TestEnvContext):
   159	    """The mandatory positive control."""
   160	
   161	    def test_exact_candidate_with_successful_gate_job_grants(self):
   162	        # The list deliberately also holds the asking npm-publish run: the
   163	        # sibling must be ignored, not raced against.
   164	        result = decide(payload(self_run(), release_run()), ctx())
   165	        self.assertEqual(GRANT, result.decision)
   166	        self.assertEqual("gate-job-success", result.reason)
   167	        self.assertEqual(1, result.facts["fresh_candidates"])
   168	
   169	    def test_grant_exits_zero_and_prints_its_inputs(self):
   170	        proc = run_cli(json.dumps(payload(self_run(), release_run())))
   171	        self.assertEqual(EXIT_GRANT, proc.returncode, proc.stderr)
   172	        self.assertIn("decision=GRANT", proc.stdout)
   173	        self.assertIn("freshness_skew_s=120", proc.stdout)
   174	        self.assertIn("head_sha=" + HEAD_SHA, proc.stdout)
