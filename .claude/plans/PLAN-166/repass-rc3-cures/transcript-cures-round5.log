  3106	      echo "    NOTE: PROTOCOL.md delivery record present but its canonical digest is" >&2
  3107	      echo "          unrecoverable (ambiguous record) — ownership NOT claimed; the" >&2
  3108	      echo "          pointer stays adopter-owned and preserved" >&2
  3109	    fi
  3110	  fi
  3111	else
  3112	  # _refresh_protocol_pointer sets _PROTOCOL_DELIVERED itself, from the
  3113	  # VERDICT. Forcing it to 1 here overrode a PRESERVE_UNOWNED decision and
  3114	  # recorded an adopter's own pre-existing PROTOCOL.md as framework-owned —
  3115	  # a caller computing the right answer and then ignoring it (codex W3 r1 P1).
  3116	  _refresh_protocol_pointer
  3117	fi
