   327	class ContextLayerTests(TestEnvContext):
   328	    """W0 re-pass r2 P2: the CLI closed the fail-open default, but
   329	    ``GateContext.self_created_at_epoch`` kept ``= None`` one layer down, and
   330	    ``freshness_floor`` mapped None to "leg silently off" — any in-process
   331	    caller of ``decide()`` reproduced the exact GRANT-on-stale-success the
   332	    UsageTests prove the CLI refuses. The doctrine has to hold at EVERY
   333	    construction surface, not just argparse."""
   334	
   335	    def _stale_only_payload(self):
   336	        return payload(self_run(), release_run(id=900, created_at=STALE_CREATED_AT))
   337	
   338	    def test_gate_context_requires_self_created_at_epoch(self):
   339	        # No default: an in-process caller that forgets the field cannot
   340	        # construct a context at all — same failure mode as omitting the flag.
   341	        with self.assertRaises(TypeError):
   342	            GateContext(
   343	                tag=TAG,
   344	                head_sha=HEAD_SHA,
   345	                now_epoch=NOW,
   346	                deadline_epoch=DEADLINE_OPEN,
   347	            )
   348	
   349	    def test_explicit_none_fails_loud_instead_of_disarming_the_leg(self):
   350	        # NamedTuple cannot stop an explicit None; it must refuse loudly,
   351	        # never decide with the delete+re-tag freshness leg silently off.
   352	        disarmed = GateContext(
   353	            tag=TAG,
   354	            head_sha=HEAD_SHA,
   355	            now_epoch=NOW,
   356	            self_created_at_epoch=None,
   357	            deadline_epoch=DEADLINE_OPEN,
   358	        )
   359	        with self.assertRaises(ValueError):
   360	            decide(self._stale_only_payload(), disarmed)
