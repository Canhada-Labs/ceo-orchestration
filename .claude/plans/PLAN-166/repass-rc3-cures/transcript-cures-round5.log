    42	
    43	      # -----------------------------------------------------------------
    44	      # PLAN-153 Wave B item 5 (c) — RC-aware VERSION↔tag comparison.
    45	      # Closes PLAN-152 §Deferred `release-gate-rc-version-mismatch`
    46	      # (red run 28663453202 precedent).
    47	      #
    48	      # THE RC FLOW (documented so this never regresses): an RC tag
    49	      # `v<X.Y.Z>-rc.N` is cut from a tree whose VERSION file ALREADY
    50	      # reads the GA value `X.Y.Z` — the `-rc.N` pre-release suffix
    51	      # exists only in the tag name, never in the VERSION file. (The
    52	      # 24h RC-hold gate below encodes the same convention: it derives
    53	      # the RC tag family `v${VERSION}-rc.*` from the GA VERSION.)
    54	      # The old comparison (`FILE != TAG#v`) therefore hard-failed
    55	      # every RC tag's own release run: `v1.0.1-rc.1` vs
    56	      # `VERSION=1.0.1`. Fix: strip a trailing `-rc.<digits>` from the
    57	      # tag before comparing. GA tags are unaffected (nothing to
    58	      # strip); a wrong-version RC (`v1.0.2-rc.1` on `VERSION=1.0.1`)
    59	      # still hard-fails.
    60	      # -----------------------------------------------------------------
    61	      - name: Assert VERSION matches tag
    62	        run: |
    63	          set -euo pipefail
    64	          TAG="${GITHUB_REF_NAME}"
    65	          FILE="$(tr -d '[:space:]' < VERSION)"
    66	          EXPECTED="${TAG#v}"
    67	          BASE="${EXPECTED%-rc.[0-9]*}"
    68	          if [[ "$FILE" != "$BASE" ]]; then
    69	            echo "::error::VERSION file ('$FILE') does not match tag ('$TAG' → expected '$BASE')"
    70	            exit 1
    71	          fi
    72	          if [[ "$EXPECTED" != "$BASE" ]]; then
    73	            echo "OK: VERSION=$FILE matches RC tag=$TAG (compared against base '$BASE' after stripping the -rc.N pre-release suffix)"
    74	          else
    75	            echo "OK: VERSION=$FILE matches tag=$TAG"
    76	          fi
