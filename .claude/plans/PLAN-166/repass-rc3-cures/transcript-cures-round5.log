   237	class WaitTests(TestEnvContext):
   238	    def test_empty_run_list_in_time_waits(self):
   239	        result = decide(payload(), ctx())
   240	        self.assertEqual(WAIT, result.decision)
   241	        self.assertEqual("candidate-not-yet-created", result.reason)
   242	        proc = run_cli(json.dumps(payload()))
   243	        self.assertEqual(EXIT_WAIT, proc.returncode)
   244	
   245	    def test_candidate_without_the_gate_job_yet_waits(self):
   246	        # Eventual consistency of the jobs endpoint: absent list AND empty list.
   247	        other_job = {"name": "publish-release", "status": "queued", "conclusion": None}
   248	        for run in (release_run(jobs=[]), release_run(jobs=[other_job])):
   249	            body = payload(self_run(), run)
   250	            result = decide(body, ctx())
   251	            self.assertEqual(WAIT, result.decision)
   252	            self.assertEqual("gate-job-not-materialised", result.reason)
   253	        no_jobs_key = release_run()
   254	        del no_jobs_key["jobs"]
   255	        result = decide(payload(self_run(), no_jobs_key), ctx())
   256	        self.assertEqual(WAIT, result.decision)
   257	        self.assertEqual("gate-job-not-materialised", result.reason)
   258	
   259	    def test_running_gate_job_waits(self):
   260	        # Kills `conclusion != "failure"` implementations.
   261	        run = release_run(
   262	            status="in_progress",
   263	            conclusion=None,
   264	            jobs=[gate_job(conclusion=None, status="in_progress")],
   265	        )
   266	        result = decide(payload(self_run(), run), ctx())
   267	        self.assertEqual(WAIT, result.decision)
   268	        self.assertEqual("gate-job-not-concluded", result.reason)
   269	        expired = decide(payload(self_run(), run), ctx(now=NOW_PAST_DEADLINE))
   270	        self.assertEqual(BLOCK, expired.decision)
