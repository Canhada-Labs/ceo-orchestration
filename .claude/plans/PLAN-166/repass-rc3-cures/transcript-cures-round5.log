   163	    for _fms_part in $( _fms_profile_parts ); do
   164	      case "$_fms_part" in
   165	        core|frontend) : ;;
   166	        *) printf '%s\n' ".claude/skills/domains/$_fms_part" ;;
   167	      esac
   168	    done
   169	  } | LC_ALL=C sort -u
   170	}
