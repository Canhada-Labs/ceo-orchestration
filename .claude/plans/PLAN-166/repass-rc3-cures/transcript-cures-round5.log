   251	def _sort_key(run: Dict[str, Any], created_at: int) -> Tuple[int, int, int]:
   252	    attempt = run.get("run_attempt")
   253	    run_id = run.get("id")
   254	    return (
   255	        created_at,
   256	        attempt if isinstance(attempt, int) else 0,
   257	        run_id if isinstance(run_id, int) else 0,
   258	    )
