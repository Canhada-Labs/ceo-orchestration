   615	  [ "$cur_version" = "$TARGET_BASE" ] \
   616	    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
   617	  ok "VERSION ($cur_version) matches the base version of the tag"
   618	
   619	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   620	    && die "tag $TARGET_TAG already exists"
