+  nc="$(printf '%s' "$_nrj" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("conclusion",""))' 2>/dev/null || echo "")"
+  printf '  ... npm-publish: %s/%s\n' "${ns:-?}" "${nc:-?}"
