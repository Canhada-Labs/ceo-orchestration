   633	  anchor="$(git rev-parse HEAD)"
   634	  msg="$TARGET_TAG — $RELEASE_TITLE
   635	
   636	Anchor: $anchor
   637	Scope:  $RELEASE_SCOPE
   638	
   639	Headline: $RELEASE_HEADLINE
   640	
   641	No speed claim. See CHANGELOG.md [$TARGET_BASE]."
   642	
   643	  if [ "$DRY_RUN" -eq 1 ]; then
   644	    note "dry-run: tag NOT created. Message that would be signed:"
   645	    printf '%s\n' "$msg" | sed 's/^/      | /'
   646	    return 0
   647	  fi
   648	
   649	  git tag -s -u "$SIGN_KEY" -m "$msg" "$TARGET_TAG" \
   650	    || die "git tag -s failed (key $SIGN_KEY)"
   651	  ok "tag created"
   652	
   653	  git tag -v "$TARGET_TAG" >/dev/null 2>&1 \
   654	    || die "tag signature does not verify — delete it and investigate"
   655	  ok "tag signature verifies"
   656	
   657	  cat <<EOF
   658	
   659	TAG $TARGET_TAG IS SIGNED LOCALLY AND NOT PUSHED.
   660	
   661	Pushing starts release.yml (the gate) and npm-publish.yml (which is what
   662	publishes to npm, via OIDC). That is the irreversible, outward-facing step —
   663	it stays yours:
   664	
   665	    git push origin $TARGET_TAG
   666	
   667	Then, per .github/release-checklist.md:
   668	  - gh run watch                      (all release.yml steps green)
   669	EOF
   670	  if [ "$STABLE" -eq 1 ]; then
   671	    cat <<EOF
   672	  - GitHub Release from the tag, "pre-release" NOT checked (this is the GA)
   673	  - npm view <pkg> version            (OIDC publish landed the bare semver)
   674	  - close the release: CHANGELOG links, memory topic, archive the RC hold
   675	EOF
   676	  else
   677	    cat <<EOF
   678	  - GitHub Release from the tag, "pre-release" checked while this is an RC
   679	  - ADR-103 hold: >=24 h, Codex re-pass against the RC, adopter smoke test
   680	  - promote: bash $0 bump --stable --npm-readme-reviewed && bash $0 tag --stable
   681	EOF
   682	  fi
   683	}
   684	
   685	case "$PHASE" in
   686	  preflight) preflight ;;
   687	  bump)      bump ;;
   688	  tag)       tag ;;
   689	  *)         die "unreachable phase: $PHASE" ;;
   690	esac
