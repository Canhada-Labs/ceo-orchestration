+    _mdr="$(gh release view "$TAG" --json isDraft --jq .isDraft 2>/dev/null || echo "")"
+    [ "$_mdr" = "true" ] \
+      || die "npm-publish '$nc' e o release NAO virou draft (isDraft='$_mdr') - verifique manualmente; me chame no Claude"
