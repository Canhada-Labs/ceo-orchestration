+_ga_want="$( { printf '%s\n' $GA_OUT_OK; echo "run-ga-repass.sh"; } | sort )"
+[ "$_ga_disk" = "$_ga_want" ] || die "conjunto em repass-ga difere do fechado:
+$(diff <(printf '%s\n' "$_ga_want") <(printf '%s\n' "$_ga_disk") | sed 's/^/   /')"
