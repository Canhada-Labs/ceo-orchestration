.claude-plugin/plugin.json
scripts/upgrade.sh
P1
;;
    2) cat <<'P2'
.github/workflows/release.yml
.github/workflows/npm-publish.yml
.claude/scripts/local/verify-counts.sh
.claude/scripts/local/release.sh
