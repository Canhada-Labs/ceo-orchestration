   226	      # PLAN-112-FOLLOWUP-canonical-doc-refresh-gate — canonical doc freshness.
   227	      #
   228	      # Fails the release when an in-scope canonical doc's machine-readable
   229	      # `<!-- last-reviewed: DATE vX.Y.Z -->` stamp is more MINOR releases
   230	      # behind VERSION than its tier allows (security docs N=1; general N=3).
   231	      # Missing/malformed stamp fails-CLOSED. Closes F-D4.
   232	      #
   233	      # Emergency bypass: the checker self-reads an Owner-signed
   234	      # `doc_freshness:` entry (matching this release version) in
   235	      # `.claude/governance/governance-waivers.yaml` and, when present,
   236	      # passes WITH a surfaced ::warning (never a silent skip).
   237	      # -----------------------------------------------------------------
   238	      - name: Canonical doc freshness gate
   239	        run: |
   240	          set -euo pipefail
   241	          python3 .claude/scripts/check-canonical-doc-freshness.py
   242	
   243	      # -----------------------------------------------------------------
   244	      # PLAN-013 Phase 0 item 0.3 — mandatory RC-to-GA hold enforcement.
   245	      # AMENDED 2026-05-03 per ADR-103: 7-day calendar gate REDUCED to
   246	      # 24h Codex re-pass mechanical window per ADR-095 §gate-#6.
   247	      #
   248	      # Debate Round 1 consensus §S3 HIGH (DevOps): "7-day RC hold is
   249	      # policy not mechanism. Policy without mechanism is hope."
   250	      #
   251	      # Rule: a GA tag `v1.x.y` MAY only ship after its corresponding
   252	      # RC tag `v1.x.y-rc.N` has existed for ≥24 hours. The 24h window
   253	      # is mechanical: bounds the maximum Codex external re-pass
   254	      # turnaround (anti same-LLM bias per ADR-095 §gate-#6). NOT a
   255	      # "settle period" — vibecoder-only thesis (ADR-096) means no
   256	      # external adopter pressure for calendar buffers.
   257	      #
   258	      # Mechanism:
   259	      #   1. If tag contains `-rc.` → skip check (RC tags always pass)
   260	      #   2. Else find most recent `v<VERSION>-rc.*` tag (by creator date)
   261	      #   3. If none exists → fail (mandatory RC before GA)
   262	      #   4. Else compute delta; reject if < 24h (86400 seconds)
   263	      # -----------------------------------------------------------------
   264	      - name: Assert 24h Codex re-pass window (GA tags only, waiver-aware)
   265	        run: |
   266	          set -euo pipefail
   267	          TAG="${GITHUB_REF_NAME}"
   268	          VERSION="${TAG#v}"
   269	
   270	          # RC tags short-circuit — they are always permitted.
   271	          if [[ "$TAG" == *-rc.* ]]; then
   272	            echo "::notice::$TAG is an RC tag — skipping 24h hold check"
   273	            exit 0
   274	          fi
   275	
   276	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment).
   277	          # During initial framework development with adopter_count=0,
   278	          # the RC-hold window can be waived per Owner authorization
   279	          # recorded in .claude/governance/rc-hold-waivers.yaml. The
   280	          # waiver is additive: post-first-adopter, the file is expected
   281	          # to be empty and ADR-007 default resumes. Each waiver entry
   282	          # cites Owner directive + round-NN sentinel commit.
   283	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   284	          if [[ -f "$WAIVER_FILE" ]]; then
   285	            if awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   286	              echo "::notice::$TAG has a pre-GA RC-hold waiver in $WAIVER_FILE — skipping hold check"
   287	              exit 0
   288	            fi
   289	          fi
   290	
   291	          # Find the most-recent RC tag for this version, by creator date.
   292	          # `git tag -l --sort=-creatordate` handles both lightweight and
   293	          # annotated tags uniformly via the dereferenced date.
   294	          LAST_RC=$(git tag -l --sort=-creatordate "v${VERSION}-rc.*" | head -1)
   295	
   296	          if [[ -z "$LAST_RC" ]]; then
   297	            echo "::error::GA tag $TAG has no prior v${VERSION}-rc.* tag"
   298	            echo "::error::Mandatory RC-hold requires a prior RC tag"
   299	            echo "::error::Cut v${VERSION}-rc.1 first; wait 24h (Codex re-pass turnaround); then cut $TAG"
   300	            exit 1
   301	          fi
   302	
   303	          # Creator-date gives a unix-epoch timestamp for both
   304	          # annotated (tagger date) and lightweight (committer date) tags.
   305	          RC_TS=$(git tag -l --format='%(creatordate:unix)' "$LAST_RC")
   306	          GA_TS=$(git tag -l --format='%(creatordate:unix)' "$TAG")
   307	
   308	          if [[ -z "$RC_TS" || -z "$GA_TS" ]]; then
   309	            echo "::error::Could not read creator-date for $LAST_RC or $TAG"
   310	            exit 1
   311	          fi
   312	
   313	          DELTA=$((GA_TS - RC_TS))
   314	          ONE_DAY=$((1 * 86400))
   315	          HOURS=$((DELTA / 3600))
   316	
   317	          if [[ "$DELTA" -lt "$ONE_DAY" ]]; then
   318	            echo "::error::GA tag $TAG is only $HOURS hours after $LAST_RC"
   319	            echo "::error::Mandatory 24h Codex re-pass window not met (delta=${DELTA}s < 86400s)"
   320	            echo "::error::Wait $((24 - HOURS)) more hours OR run Codex re-pass synchronously and add waiver"
   321	            exit 1
   322	          fi
   323	
   324	          echo "OK: $TAG is $HOURS hours after $LAST_RC (≥24h Codex re-pass window per ADR-103)"
