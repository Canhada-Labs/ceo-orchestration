   122	  echo "- Worktree detached da TAG: sim - Pipeline: prompt+diff -> codex_egress_redact --outgoing -> controles -> codex exec --sandbox read-only"
   123	  echo "- Data: $(date -u +%Y-%m-%dT%H:%MZ)"
   124	} > "$OUT/PROVENANCE-ga.md"
   125	
   126	for P in 1 2; do
   127	  LABEL="$(part_label "$P")"
   128	  MAN="$OUT/paths-ga-$P.manifest.txt"
   129	  part_paths "$P" > "$MAN"
   130	  while IFS= read -r p; do
   131	    [ -z "$p" ] && continue
   132	    git cat-file -e "$RC_TAG:$p" 2>/dev/null \
   133	      || { echo "FATAL: caminho do escopo ausente na tag: $p" >&2; exit 1; }
   134	  done < "$MAN"
   135	  DIFF="$OUT/diff-ga-$P.patch"
   136	  # shellcheck disable=SC2046
   137	  git diff "$BASE_TAG".."$RC_TAG" -- $(tr '\n' ' ' < "$MAN") > "$DIFF"
   138	  DL=$(wc -l < "$DIFF" | tr -d ' ')
   139	  [ "$DL" -ge 50 ] || { echo "FATAL: parte $P com so $DL linhas de diff"; exit 1; }
   140	  RAW="$OUT/payload-ga-$P.raw.txt"; RED="$OUT/payload-ga-$P.redacted.txt"
   141	  { prompt_header "$P" "$LABEL"; echo; cat "$DIFF"; } > "$RAW"
   142	  RAWB=$(wc -c < "$RAW" | tr -d ' ')
   143	  [ "$RAWB" -lt 250000 ] || { echo "FATAL: parte $P ${RAWB}B >= 250KB"; exit 1; }
   144	  python3 .claude/hooks/_lib/codex_egress_redact.py --outgoing < "$RAW" > "$RED" \
   145	    || { echo "FATAL: redactor rc!=0 na parte $P"; exit 1; }
   146	  grep -q 'CODEX-OUTPUT-TRUNCATED' "$RED" && { echo "FATAL: parte $P truncada"; exit 1; }
   147	  RH=$(grep -c '^@@' "$RAW" || true); DH=$(grep -c '^@@' "$RED" || true)
   148	  [ "$RH" = "$DH" ] || { echo "FATAL: parte $P hunks $RH -> $DH"; exit 1; }
   149	  RAWL=$(wc -l < "$RAW" | tr -d ' '); REDL=$(wc -l < "$RED" | tr -d ' ')
   150	  [ "$RAWL" = "$REDL" ] || { echo "FATAL: parte $P linhas $RAWL -> $REDL"; exit 1; }
   151	  echo "parte $P OK (${RAWB}B, $RH hunks) - codex rodando (~10-15 min)..."
   152	  ( cd "$WT" && codex exec --sandbox read-only --color never \
   153	      --output-last-message "$OUT/verdict-ga-$P.txt" \
   154	      - < "$RED" > "$OUT/transcript-ga-$P.log" 2>&1 )
   155	  CRC=$?
   156	  VLINE=$(grep -E '^VERDICT:' "$OUT/verdict-ga-$P.txt" 2>/dev/null | tail -1 || true)
   157	  [ -n "$VLINE" ] || VLINE="(sem linha VERDICT - inspecionar transcript; rc=$CRC)"
   158	  RAW_SHA=$(shasum -a 256 "$RAW" | awk '{print $1}')
   159	  {
   160	    echo "- parte $P ($LABEL): $VLINE [codex rc=$CRC]"
   161	    echo "  - payload-ga-$P.raw.txt NAO commitado; pin sha256: $RAW_SHA"
   162	  } >> "$OUT/PROVENANCE-ga.md"
   163	  mkdir -p "$HOME/.rc2-backup"; mv "$RAW" "$HOME/.rc2-backup/payload-ga-$P.raw.txt"
   164	  echo "parte $P: $VLINE [rc=$CRC]"
   165	  # Pair-rail S300 r3 P1-3: um VERDICT escrito seguido de crash/timeout
   166	  # do codex (rc!=0) e evidencia INCOMPLETA, nao autorizacao — o rc da
   167	  # execucao E a linha exata contam.
   168	  if [ "$CRC" -ne 0 ]; then
   169	    OVERALL=1
   170	  else
   171	    case "$VLINE" in
   172	      "VERDICT: GO"|"VERDICT: GO-WITH-CONDITIONS"*) : ;;
   173	      *) OVERALL=1 ;;
   174	    esac
   175	  fi
   176	done
   177	
   178	( cd "$OUT" && shasum -a 256 \
   179	    payload-ga-1.redacted.txt payload-ga-2.redacted.txt \
   180	    diff-ga-1.patch diff-ga-2.patch \
   181	    paths-ga-1.manifest.txt paths-ga-2.manifest.txt \
   182	    verdict-ga-1.txt verdict-ga-2.txt \
   183	    transcript-ga-1.log transcript-ga-2.log \
   184	    > MANIFEST-ga.sha256 )
   185	echo "RUNNER-OVERALL: rc=$OVERALL" >> "$OUT/PROVENANCE-ga.md"
   186	echo "OVERALL: $( [ "$OVERALL" -eq 0 ] && echo GO-nas-2-partes || echo 'PARTE SEM GO - triagem' )"
   187	exit "$OVERALL"

