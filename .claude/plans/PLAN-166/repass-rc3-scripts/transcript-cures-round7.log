+say "4/8 verdito GA + commit 2 + guard local"
+SIG="$(base64 < "$VF.asc" | tr -d '\n')"
+sed -e "s/@@PARENT_SHA@@/$PARENT/" -e "s/@@GENERATED_AT@@/$GEN/" \
+    -e "s/@@DELTA_MANIFEST_SHA@@/$DMS/" -e "s/@@TRANSCRIPT_SHA@@/$TSH/" \
