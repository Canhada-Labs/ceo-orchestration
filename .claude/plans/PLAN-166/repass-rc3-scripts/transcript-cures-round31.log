    34	  || { echo "FATAL: objeto local da $BASE_TAG != pin revisado $BASE_TAG_OBJ"; exit 2; }
    35	[ "$(git rev-parse "$BASE_TAG^{commit}")" = "$BASE_TAG_COMMIT" ] \
