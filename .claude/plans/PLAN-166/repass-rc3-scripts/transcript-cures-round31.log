   269	# ---------------------------------------------------------------------------
   270	# Preflight — every gate fail-closed. Mirrors `.github/release-checklist.md`
   271	# and runs the SAME suites CI runs (a subset gate passes while CI is red; that
   272	# lesson is expensive and already paid).
   273	# ---------------------------------------------------------------------------
   274	preflight() {
   275	  hdr "git state"
   276	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — commit or stash first"
   277	  ok "tree clean"
   278	
   279	  branch="$(git rev-parse --abbrev-ref HEAD)"
   280	  [ "$branch" = "main" ] || die "on branch '$branch' — releases are cut from main"
   281	  ok "on main"
   282	
   283	  git fetch --quiet origin main || die "git fetch origin main failed"
   284	  local_sha="$(git rev-parse HEAD)"
   285	  remote_sha="$(git rev-parse origin/main)"
   286	  [ "$local_sha" = "$remote_sha" ] \
   287	    || die "HEAD ($local_sha) != origin/main ($remote_sha) — push or pull first"
   288	  ok "HEAD == origin/main ($local_sha)"
   289	
   290	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   291	    && die "tag $TARGET_TAG already exists"
   292	  ok "tag $TARGET_TAG is free"
   293	
   294	  hdr "CI for HEAD"
   295	  if command -v gh >/dev/null 2>&1; then
   296	    runs="$(gh run list --limit 40 \
   297	      --json headSha,conclusion,status,workflowName 2>/dev/null || true)"
   298	    if [ -n "$runs" ]; then
   299	      verdict="$(mktemp)"
   300	      printf '%s' "$runs" | HEAD_SHA="$local_sha" python3 -c '
   301	import json, os, sys
   302	sha = os.environ["HEAD_SHA"]
   303	runs = [r for r in json.load(sys.stdin) if r.get("headSha") == sha]
   304	if not runs:
   305	    print("NO_RUNS"); sys.exit(0)
   306	bad = [r for r in runs if r.get("conclusion") not in ("success", "skipped", "")]
   307	pend = [r for r in runs if r.get("status") != "completed"]
   308	val = [r for r in runs if "Validate" in (r.get("workflowName") or "")]
   309	for r in bad:
   310	    print("BAD %s=%s" % (r["workflowName"], r["conclusion"]))
   311	for r in pend:
   312	    print("PENDING %s" % r["workflowName"])
   313	if not any(r.get("conclusion") == "success" for r in val):
   314	    print("NO_VALIDATE_SUCCESS")
   315	' > "$verdict" || die "CI verdict parse failed"
   316	      if grep -q '^BAD ' "$verdict"; then
   317	        cat "$verdict" >&2; rm -f "$verdict"
   318	        die "a workflow for HEAD is not green"
   319	      fi
   320	      if grep -q '^PENDING ' "$verdict"; then
   321	        cat "$verdict" >&2; rm -f "$verdict"
   322	        die "a workflow for HEAD is still running — wait for it"
   323	      fi
   324	      if grep -q 'NO_VALIDATE_SUCCESS' "$verdict"; then
   325	        rm -f "$verdict"
   326	        die "no successful Validate run for HEAD"
   327	      fi
   328	      if grep -q 'NO_RUNS' "$verdict"; then
   329	        rm -f "$verdict"
   330	        die "no CI runs found for HEAD — push it and let CI run"
   331	      fi
   332	      rm -f "$verdict"
   333	      ok "all workflows for HEAD green (Validate success)"
   334	    else
   335	      die "gh returned no run data — cannot confirm CI (fail-closed)"
   336	    fi
   337	  else
   338	    die "gh CLI not available — cannot confirm CI (fail-closed)"
   339	  fi
   340	
   341	  # These MUST be the invocations validate.yml uses, not `unittest discover`.
   342	  # The suite is pytest-only BY CONSTRUCTION: conftest.py carries the sys.path
   343	  # bootstrap and the _lib resolution guards as pytest collection hooks, and
   344	  # several modules isolate their environment with pytest `autouse` fixtures.
   345	  # `unittest discover` loads none of that, so those modules run with their
   346	  # declared isolation silently disabled — which leaks CLAUDE_PROJECT_DIR into
   347	  # later modules. test_flip_closures then resolves settings.json /
   348	  # red-team.yml under a dead tmp dir and reports that files which plainly
   349	  # exist "must exist". It passes 12/12 when run alone. Diagnosed 2026-08-02
   350	  # during a GA promote; the old invocation made this gate a FALSE RED that
   351	  # blocked a release whose CI was green.
   352	  hdr "test suites (the same ones CI runs)"
   353	  python3 -m pytest .claude/hooks/tests/ -n auto -m 'not serial' \
   354	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   355	    || die "hooks test suite failed (not serial)"
   356	  python3 -m pytest .claude/hooks/tests/ -m 'serial' \
   357	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   358	    || die "hooks test suite failed (serial)"
   359	  ok "hooks tests pass"
   360	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   361	    -n auto -m 'not serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   362	    || die "scripts test suite failed (not serial)"
   363	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
