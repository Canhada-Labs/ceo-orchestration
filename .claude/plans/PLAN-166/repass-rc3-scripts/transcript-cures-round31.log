    40	_bt_peel="$(printf '%s\n' "$_bt_rls" | awk -v r="refs/tags/$BASE_TAG^{}" '$2==r{print $1}')"
    41	[ "$_bt_plain" = "$BASE_TAG_OBJ" ] \
    42	  || { echo "FATAL: $BASE_TAG remota != pin revisado"; exit 2; }
