   695	              echo "::notice::no verdict file at $VERDICT_FILE; CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 → skipping"
   696	              exit 0
   697	            fi
   698	            echo "::error::verdict file missing at $VERDICT_FILE — step 15 blocks release"
   699	            exit 1
   700	          fi
   701	          # S104 redesign: resolve PARENT_SHA = parent of the verdict-file
   702	          # commit. The tag commit (${GITHUB_SHA}) is what we're releasing,
   703	          # and the verdict file at $VERDICT_FILE either:
   704	          #   (a) was committed in the tag commit itself → parent = ${GITHUB_SHA}^
   705	          #   (b) was committed earlier (multi-commit prep) → parent = git log of file
   706	          # We use (b)'s general form: find the commit that introduced the
   707	          # current verdict file, then take its parent. This handles both
   708	          # single-commit-with-verdict and multi-commit-prep flows.
   709	          VERDICT_FILE_COMMIT=$(git log -n1 --format=%H -- "$VERDICT_FILE")
   710	          if [ -z "$VERDICT_FILE_COMMIT" ]; then
   711	            echo "::error::cannot resolve commit for $VERDICT_FILE — step 15 fails"
   712	            exit 1
   713	          fi
   714	          PARENT_SHA=$(git rev-parse "${VERDICT_FILE_COMMIT}^" 2>/dev/null || echo "")
   715	          if [ -z "$PARENT_SHA" ]; then
   716	            echo "::error::cannot resolve parent of $VERDICT_FILE_COMMIT — step 15 fails"
   717	            exit 1
   718	          fi
   719	          echo "::notice::S104 bind: VERDICT_FILE_COMMIT=$VERDICT_FILE_COMMIT, PARENT_SHA=$PARENT_SHA"
   720	          # When transition mode is on, allow parent_sha mismatch (skip bind)
   721	          # by passing empty string. Default is hard-bind on PARENT_SHA.
   722	          PARENT_SHA_ARG="$PARENT_SHA"
   723	          if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL:-0}" = "1" ]; then
   724	            PARENT_SHA_ARG=""
   725	          fi
   726	          python3 .github/scripts/validate-pair-rail-verdict.py \
   727	            --verdict-file "$VERDICT_FILE" \
   728	            --parent-sha "$PARENT_SHA_ARG" \
   729	            --release-tag "${GITHUB_REF_NAME}" \
   730	            --max-age-hours 24 \
   731	            --recompute-inputs-hash \
   732	            --codex-cli-pin-file .claude/governance/codex-cli-pin.txt \
   733	            --codex-cli-binary-sha256-file .claude/governance/codex-cli-binary-sha256.txt \
   734	            --codex-pin-manifest-file .claude/governance/codex-cli-pin-manifest.json \
   735	            --inputs-hash-paths-file .claude/governance/pair-rail-inputs-hash-manifest.txt
   736	
   737	      # ==========================================================
   738	      # PLAN-166 W1-B — verdict delta + ancestry gate (F2 server side)
   739	      # ==========================================================
   740	      # Re-pass findings r15 + r17 + r18 (PLAN-166), debate r3 scoped VETO.
   741	      #
   742	      # WHY A SEPARATE STEP: the step-15 neighbourhood above carries two
   743	      # escape hatches keyed to CEO_PAIR_RAIL_VERDICT_OPTIONAL —
   744	      # `continue-on-error:` on the step itself, and an empty
   745	      # `--parent-sha ""` bind (the validator only binds the field when
   746	      # args.parent_sha is non-empty). Inheriting that neighbourhood would
   747	      # inherit the switch. This step therefore:
   748	      #   - carries NO continue-on-error;
   749	      #   - FAILS CLOSED when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1: in that
   750	      #     mode step 15 skipped the parent_sha bind, so the anchor these
   751	      #     asserts hang off was never validated — there is no transition
   752	      #     mode here, by design;
   753	      #   - re-derives and re-binds parent_sha ITSELF (non-empty, 40-hex,
   754	      #     equal to the verdict's `parent_sha:` read with the SAME parser
   755	      #     the local tag guard uses) — independent of step 15's outcome,
   756	      #     which also closes the legacy commit_sha fallback (the
   757	      #     validator downgrades a missing parent_sha to an ADVISORY when
   758	      #     a legacy commit_sha is present; this step does not);
   759	      #   - reuses .claude/scripts/local/_release_tag_guard.py for the
   760	      #     delta decision — the module marks itself as the reference
   761	      #     implementation; the semantics are NEVER re-implemented in
   762	      #     bash (single source of the decision logic);
   763	      #   - asserts ancestry on origin/main of BOTH the reviewed parent
   764	      #     AND GITHUB_SHA itself (r18: parent-only lets the
   765	      #     tag-without-push scenario — verdict V over parent P, tag
   766	      #     pushed, V never reaches main — pass with P ancestral and V
   767	      #     orphaned).
   768	      #
   769	      # THE INVARIANT (one sentence): nothing landed after what the
   770	      # re-pass reviewed, other than the verdict for THIS tag and the
   771	      # evidence it pins by name AND content (sha256 of MANIFEST.sha256
   772	      # in the signed verdict + `shasum -c` over the evidence set).
   773	      #
   774	      # PINNED ORDER (asserted structurally by the W1B* classes of
   775	      # test_release_workflow_asserts.py, WaveB5 pattern):
   776	      #   Verify tag GPG signature → Validate pair-rail verdict →
   777	      #   delta → ancestry.
   778	      # Do not reorder, do not merge into step 15.
   779	      - name: Verify verdict delta + ancestry (fail-closed)
   780	        env:
   781	          CEO_PAIR_RAIL_VERDICT_OPTIONAL: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL || '0' }}
   782	        run: |
   783	          set -euo pipefail
   784	          # (0) No transition mode: with the var on, the parent_sha bind
   785	          # upstream was skipped — refuse to certify against an
   786	          # unvalidated anchor. Fail closed, loudly.
   787	          if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL}" = "1" ]; then
   788	            echo "::error::CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 is set, but the delta+ancestry gate has no transition mode — it fails closed by design (PLAN-166 debate r3). Unset the repo variable (gh variable delete CEO_PAIR_RAIL_VERDICT_OPTIONAL) and re-run."
   789	            exit 1
   790	          fi
   791	          TAG="${GITHUB_REF_NAME}"
   792	          VERDICT_FILE=".claude/governance/pair-rail-verdict-${TAG}.md"
   793	          if [ ! -f "$VERDICT_FILE" ]; then
   794	            echo "::error::no signed verdict at $VERDICT_FILE — the delta+ancestry gate has no optional mode; the re-pass verdict for THIS tag must be committed on the tagged tree."
   795	            exit 1
   796	          fi
   797	          # (1) Checkout sanity: every assert below anchors on HEAD, so
   798	          # HEAD must BE the tagged commit this run is about.
   799	          HEAD_SHA="$(git rev-parse HEAD)"
   800	          if [ "$HEAD_SHA" != "${GITHUB_SHA}" ]; then
   801	            echo "::error::checkout HEAD ($HEAD_SHA) != GITHUB_SHA (${GITHUB_SHA}) — refusing to assert against the wrong tree"
   802	            exit 1
   803	          fi
   804	          # (2) Independent parent_sha bind — non-empty by construction,
   805	          # controlled by no variable. Same derivation as step 15 (parent
   806	          # of the commit that introduced the verdict file); the verdict
   807	          # field is read with the SAME parser the local tag guard uses
   808	          # (_parse_verdict), so two readers of the same signed file
   809	          # cannot disagree about what it says.
   810	          VERDICT_FILE_COMMIT="$(git log -n1 --format=%H -- "$VERDICT_FILE")"
   811	          if [ -z "$VERDICT_FILE_COMMIT" ]; then
   812	            echo "::error::cannot resolve the commit that introduced $VERDICT_FILE — refusing an empty bind"
   813	            exit 1
   814	          fi
   815	          PARENT_SHA="$(git rev-parse "${VERDICT_FILE_COMMIT}^" 2>/dev/null || echo "")"
   816	          if [ -z "$PARENT_SHA" ]; then
   817	            echo "::error::cannot resolve parent of ${VERDICT_FILE_COMMIT} — refusing an empty bind"
   818	            exit 1
   819	          fi
   820	          python3 - "$VERDICT_FILE" "$PARENT_SHA" <<'PYBIND'
   821	          import importlib.util
   822	          import io
   823	          import re
   824	          import sys
   825	
   826	          verdict_path, expected = sys.argv[1], sys.argv[2]
   827	          if not re.match(r"\A[0-9a-f]{40}\Z", expected):
   828	              sys.exit("FAIL: derived parent %r is not a 40-hex SHA" % expected)
   829	          spec = importlib.util.spec_from_file_location(
   830	              "release_tag_guard", ".claude/scripts/local/_release_tag_guard.py"
   831	          )
   832	          mod = importlib.util.module_from_spec(spec)
   833	          spec.loader.exec_module(mod)
   834	          with io.open(verdict_path, encoding="utf-8") as fh:
   835	              fields = mod._parse_verdict(fh.read())
   836	          declared = fields.get("parent_sha")
   837	          if declared != expected:
   838	              sys.exit(
   839	                  "FAIL: verdict parent_sha %r != parent of the verdict-file "
   840	                  "commit (%s) — the anchor was not validated with a "
   841	                  "non-empty bind; a legacy commit_sha fallback does NOT "
   842	                  "count here." % (declared, expected)
   843	              )
   844	          print("  ok   parent_sha bind: %s (derived independently of step 15)" % expected)
   845	          PYBIND
   846	          # (3) DELTA (r15): git diff <reviewed parent>..<tag commit>
   847	          # must be contained in the CLOSED set pinned in the signed
   848	          # verdict — exact names per tag (never the pair-rail-verdict-*
   849	          # wildcard, never repass-<N>/**), set equality against the
   850	          # evidence MANIFEST.sha256, AND content equality (the verdict
   851	          # pins the manifest's sha256; the guard runs `shasum -c` over
   852	          # it). Any extra path = FAIL. Decision logic lives in the local
   853	          # tag guard module — reused, never re-implemented in bash.
   854	          python3 .claude/scripts/local/_release_tag_guard.py delta \
   855	            --repo . --tag "$TAG"
   856	          # (4) ANCESTRY (r17+r18): both the reviewed parent AND the
   857	          # tagged commit itself must be ancestors of origin/main. The
   858	          # module's ancestry subcommand judges HEAD (== GITHUB_SHA,
   859	          # asserted in (1)) after a FAIL-CLOSED fetch of origin/main —
   860	          # a failed fetch is a stop, never a stale-ref approval. The
   861	          # reviewed parent is then judged against the same freshly
   862	          # fetched ref.
   863	          python3 .claude/scripts/local/_release_tag_guard.py ancestry \
   864	            --repo . --remote origin --branch main
   865	          if git merge-base --is-ancestor "$PARENT_SHA" origin/main; then
   866	            echo "  ok   reviewed parent $PARENT_SHA is an ancestor of origin/main"
   867	          else
   868	            RC=$?
   869	            echo "::error::reviewed parent $PARENT_SHA is not on origin/main (merge-base exit $RC) — the verdict is anchored on a commit main never saw (tag-without-push / orphan-verdict scenario, r17+r18)"
   870	            exit 1
   871	          fi
   872	          echo "OK: verdict delta + ancestry asserts all green for $TAG"
   873	
   874	  publish-release:
   875	    name: Publish GitHub Release + assets
     1	#!/bin/bash
     2	# OWNER-GA-CUT.sh - promocao v1.3.0-rc.2 -> GA v1.3.0 em UM comando.
     3	#
     4	#   bash .claude/plans/PLAN-166/OWNER-GA-CUT.sh
     5	#
     6	# Pre-requisito: rc.2 cortada ha >= 24h (hold ADR-103). O script:
     7	#   1. valida janela do hold + freeze (origin/main == commit da rc.2)
     8	#   2. roda o re-pass do hold (codex, ~10-15 min) se ainda nao rodou;
     9	#      exige VERDICT: GO ou GO-WITH-CONDITIONS (NO-GO => aborta)
    10	#   3. commit 1: evidencia do re-pass (repass-ga/**)
    11	#   4. gera verdict-fields GA e voce assina (pinentry 1)
    12	#   5. monta o verdito GA, commit 2, guard local, push, espera CI
    13	#   6. preflight --stable + bump --stable (no-op esperado) +
    14	#      tag v1.3.0 assinada (pinentry 2)
    15	#   7. push da tag (confirmacao SIM) + espera release.yml + npm:
    16	#      aprovacao production-npm e SUA no browser (o script te da o link)
    17	#   8. GitHub Release (SEM pre-release) + npm view
    18	# Depois do GA: assinar W3 e rodar OWNER-W3-LAND.sh (curas V1-V5).
    19	set -euo pipefail
    20	
    21	REPO="$(git rev-parse --show-toplevel)"; cd "$REPO"
    22	RC_TAG="v1.3.0-rc.2"
    23	TAG="v1.3.0"
    24	KEY="CFCFACF00335DC74"
    25	P166=".claude/plans/PLAN-166"
    26	GA_DIR="$P166/repass-ga"
    27	VF="$P166/verdict-fields-v1.3.0.md"
    28	VD=".claude/governance/pair-rail-verdict-v1.3.0.md"
    29	VF_TPL="$P166/verdict-fields-v1.3.0.TEMPLATE.md"
    30	VD_TPL="$P166/pair-rail-verdict-v1.3.0.TEMPLATE.md"
    31	
    32	say() { printf '\n== %s\n' "$*"; }
    33	die() { printf '\nFAIL: %s\n' "$*" >&2; exit 1; }
    34	bell() { printf '\a'; osascript -e "display notification \"$1\" with title \"GA v1.3.0\"" 2>/dev/null || true; }
    35	
    36	GPG_TTY="$(tty 2>/dev/null || true)"; export GPG_TTY
    37	gpgconf --kill gpg-agent 2>/dev/null || true
    38	
    39	say "G0 pre-condicoes"
    40	[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] \
    41	  || die "nao esta em main (branch/detached) - r6-P2 do rail"
    42	git rev-parse -q --verify "refs/tags/$RC_TAG" >/dev/null 2>&1 || die "tag $RC_TAG nao existe"
    43	git rev-parse -q --verify "refs/tags/$TAG" >/dev/null 2>&1 && die "tag $TAG ja existe"
    44	RC_SHA="$(git rev-parse "$RC_TAG^{commit}")"
    45	# Hold medido do EVENTO PUBLICADO, nao do tag local (pair-rail S300 r8
    46	# P1-1): um corte que parou antes do push deixaria taggerdate local
    47	# valido sem NENHUMA rc publica. Exige: tag no remoto apontando o mesmo
    48	# SHA + pre-release publicado; hold conta de publishedAt.
    49	REMOTE_TAG_SHA="$(git ls-remote origin "refs/tags/$RC_TAG^{}" | awk '{print $1}')"
    50	[ -z "$REMOTE_TAG_SHA" ] && REMOTE_TAG_SHA="$(git ls-remote origin "refs/tags/$RC_TAG" | awk '{print $1}')"
    51	[ "$REMOTE_TAG_SHA" = "$RC_SHA" ] || [ "$REMOTE_TAG_SHA" = "$(git rev-parse "$RC_TAG")" ] \
    52	  || die "tag $RC_TAG nao esta no remoto (ou aponta outro SHA) - a rc.2 nunca foi publicada; termine o corte primeiro"
    53	RC_PRE="$(gh release view "$RC_TAG" --json isPrerelease --jq .isPrerelease 2>/dev/null || echo "")"
    54	[ "$RC_PRE" = "true" ] || die "pre-release da $RC_TAG ausente no GitHub - a rc nunca publicou; me chame no Claude"
    55	PUBAT="$(gh release view "$RC_TAG" --json publishedAt --jq .publishedAt 2>/dev/null || echo "")"
    56	[ -n "$PUBAT" ] || die "sem publishedAt no release da $RC_TAG"
    57	PUB_EPOCH="$(python3 - "$PUBAT" <<'PYEOF'
    58	import sys, datetime
    59	ts = sys.argv[1].replace("Z", "+00:00")
    60	print(int(datetime.datetime.fromisoformat(ts).timestamp()))
    61	PYEOF
    62	)"
    63	NOW="$(date +%s)"
    64	HOLD=$(( NOW - PUB_EPOCH ))
    65	[ "$HOLD" -ge 86400 ] || die "hold ADR-103 incompleto: $((HOLD/3600))h < 24h desde o pre-release publicado - volte mais tarde"
    66	git fetch --quiet origin main
    67	# Estados legitimos (pair-rail S300 r13 P2 — retomada real): HEAD ==
    68	# rc.2 (fresh), ou HEAD descendente da rc.2 cujo delta contem SO
    69	# evidencia do hold + artefatos do verdito GA (interrompido apos o
    70	# commit 2/4). origin/main pode ser rc.2 (pre-push) ou o proprio HEAD
    71	# (interrompido apos o push). Qualquer outra coisa = freeze violado.
    72	HEADNOW="$(git rev-parse HEAD)"
    73	if [ "$HEADNOW" != "$RC_SHA" ]; then
    74	  git merge-base --is-ancestor "$RC_SHA" "$HEADNOW" \
    75	    || die "HEAD nao descende do commit da rc.2 - me chame no Claude"
    76	  _bad_delta=""
    77	  while IFS= read -r _dp; do
    78	    [ -n "$_dp" ] || continue
    79	    case "$_dp" in
    80	      "$GA_DIR"/*|"$VF"|"$VD") : ;;
    81	      *) _bad_delta="$_bad_delta
    82	   $_dp" ;;
    83	    esac
    84	  done <<GADELTA
    85	$(git diff --name-only "$RC_SHA"..HEAD)
    86	GADELTA
    87	  [ -z "$_bad_delta" ] \
    88	    || die "delta rc.2..HEAD contem caminho fora da evidencia/verdito GA (freeze violado):$_bad_delta"
    89	  echo "   modo RETOMADA: commits locais contem so evidencia/verdito GA"
    90	fi
    91	OM="$(git rev-parse origin/main)"
    92	[ "$OM" = "$RC_SHA" ] || [ "$OM" = "$HEADNOW" ] \
    93	  || die "origin/main nao e a rc.2 nem o HEAD da retomada - freeze violado; me chame no Claude"
    94	# Arvore limpa EXCETO o conjunto FECHADO de saidas do runner do re-pass
    95	# (pair-rail S300 r11 P2: uma invocacao que rodou o re-pass e parou
    96	# antes do commit deixa esses untracked — o reuso precisa alcanca-los).
    97	GA_OUT_OK="payload-ga-1.redacted.txt payload-ga-2.redacted.txt
    98	diff-ga-1.patch diff-ga-2.patch
    99	paths-ga-1.manifest.txt paths-ga-2.manifest.txt
   100	verdict-ga-1.txt verdict-ga-2.txt
   101	transcript-ga-1.log transcript-ga-2.log
   102	PROVENANCE-ga.md MANIFEST-ga.sha256"
   103	_dirty=""
   104	while IFS= read -r _line; do
   105	  [ -n "$_line" ] || continue
   106	  _pathp="${_line#???}"
   107	  case "$_pathp" in
   108	    "$GA_DIR"/*)
   109	      # SO filhos DIRETOS do dir de evidencia contam (r14 P2: um
   110	      # look-alike aninhado tipo repass-ga/rehearsal/verdict-ga-1.txt
   111	      # cairia no git add do commit 1 e o guard de delta, ancorado no
   112	      # PARENT pos-commit, nunca o veria).
   113	      _rel="${_pathp#"$GA_DIR"/}"
   114	      case "$_rel" in
   115	        */*) _dirty="$_dirty
   116	   $_pathp" ;;
   117	        *)
   118	          _okp=0
   119	          for _b in $GA_OUT_OK; do
   120	            [ "$_rel" = "$_b" ] && { _okp=1; break; }
   121	          done
   122	          [ "$_okp" -eq 1 ] || _dirty="$_dirty
   123	   $_pathp"
   124	          ;;
   125	      esac
   126	      ;;
   127	    *) _dirty="$_dirty
   128	   $_pathp" ;;
   129	  esac
   130	done <<GASTATUS
   131	$(git status --porcelain --untracked-files=all)
   132	GASTATUS
   133	[ -z "$_dirty" ] || die "arvore suja fora do conjunto de saidas do re-pass:$_dirty"
   134	command -v gh >/dev/null 2>&1 || die "gh ausente"
   135	[ -f "$VF_TPL" ] && [ -f "$VD_TPL" ] || die "templates GA ausentes"
   136	PIN_JSON="$(python3 .claude/hooks/check_pair_rail.py --verify-codex-pin 2>/dev/null || true)"
   137	printf '%s' "$PIN_JSON" | grep -q '"status": "verified"' || die "pin do codex nao verifica"
   138	printf '%s' "$PIN_JSON" | grep -q '80a3933d11a9d13ef806aa24f7bb8afc9169cfe4e9b09d6da6a92922cbde9cff' \
   139	  || die "sha do payload codex mudou - re-gerar templates antes de assinar"
   140	
   141	say "1/8 re-pass do hold"
   142	# Reuso SO com proveniencia amarrada (pair-rail S300 r3 P1-2/P1-3):
   143	# verditos de ensaio/stale nao citam o commit REAL da rc.2 nem o
   144	# RUNNER-OVERALL: rc=0 que o runner grava ao final.
   145	if [ -f "$GA_DIR/verdict-ga-1.txt" ] && [ -f "$GA_DIR/verdict-ga-2.txt" ] \
   146	   && grep -q "$RC_SHA" "$GA_DIR/PROVENANCE-ga.md" 2>/dev/null \
   147	   && grep -q "^RUNNER-OVERALL: rc=0$" "$GA_DIR/PROVENANCE-ga.md" 2>/dev/null; then
   148	  echo "   verditos existentes com proveniencia da rc.2 ($RC_SHA) - reusando"
   149	else
   150	  bash "$GA_DIR/run-ga-repass.sh" \
   151	    || die "re-pass do hold nao terminou GO limpo (rc!=0) - triagem comigo no Claude"
   152	fi
   153	# SO "VERDICT: GO" exato segue automatico (pair-rail S300 r2 P1-2):
   154	# um GO-WITH-CONDITIONS do rail carrega condicao NOVA que o envelope
   155	# pre-escrito (so as 4 excecoes herdadas) NAO contem — assinar sem
   156	# triagem omitiria a condicao da decisao assinada. Nesse caso: pare,
   157	# me chame no Claude, triamos e REGERAMOS o envelope antes de assinar.
   158	for _vp in 1 2; do
   159	  VLINE="$(grep -E '^VERDICT:' "$GA_DIR/verdict-ga-$_vp.txt" 2>/dev/null | tail -1 || true)"
   160	  echo "   rail parte $_vp: ${VLINE:-sem verdito}"
   161	  case "$VLINE" in
   162	    "VERDICT: GO") : ;;
   163	    *) die "re-pass parte $_vp: '$VLINE' != GO exato - triagem comigo no Claude (envelope sera regerado se houver condicao nova)" ;;
   164	  esac
   165	done
   166	
   167	say "2/8 commit 1 (evidencia do hold)"
   168	ls "$GA_DIR"/payload-ga-*.raw.txt >/dev/null 2>&1 && die "payload raw ainda na arvore"
   169	git add "$GA_DIR"
   170	if git diff --cached --quiet; then
   171	  echo "   evidencia ja commitada (rerun)"
   172	else
   173	  git commit -m "docs(PLAN-166 W2): evidencia do re-pass do hold ADR-103 (GA v1.3.0)"
   174	fi
   175	PARENT="$(git rev-parse HEAD)"
   176	
   177	say "3/8 verdict-fields GA (parent=$PARENT) - revisar e assinar (pinentry 1)"
   178	GEN="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
   179	DMS="$(shasum -a 256 "$GA_DIR/MANIFEST-ga.sha256" | awk '{print $1}')"
   180	TSH="$(cat "$GA_DIR/transcript-ga-1.log" "$GA_DIR/transcript-ga-2.log" | shasum -a 256 | awk '{print $1}')"
   181	awk 'f{print} /-->/{f=1}' "$VF_TPL" \
   182	  | sed -e "s/@@PARENT_SHA@@/$PARENT/" -e "s/@@GENERATED_AT@@/$GEN/" \
   183	        -e "s/@@DELTA_MANIFEST_SHA@@/$DMS/" -e "s/@@TRANSCRIPT_SHA@@/$TSH/" > "$VF"
   184	printf '\n----- CONTEUDO QUE VOCE VAI ASSINAR -----\n'
   185	cat "$VF"
   186	printf -- '----- FIM -----\n\nEnter para assinar (ctrl-C aborta): '; read -r _
   187	rm -f "$VF.asc"
   188	gpg --armor --detach-sign -u "$KEY" "$VF"
   189	gpg --verify "$VF.asc" "$VF" || die "assinatura nao verifica"
   190	
   191	say "4/8 verdito GA + commit 2 + guard local"
   192	SIG="$(base64 < "$VF.asc" | tr -d '\n')"
