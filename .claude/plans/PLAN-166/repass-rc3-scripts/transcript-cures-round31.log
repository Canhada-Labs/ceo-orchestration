     1	#!/usr/bin/env python3
     2	# ============================================================================
     3	# _release_tag_guard.py — the two fail-closed asserts `tag()` runs before it
     4	# asks the Owner's key to sign anything.
     5	#
     6	# WHY THIS EXISTS (v1.3.0-rc.1 re-pass, F2 + the F1/F2 composite risk):
     7	#
     8	#   (a) ANCESTRY. Nothing verified that the commit being tagged is on main.
     9	#       `bump` could create a local commit AFTER the preflight proved CI green
    10	#       for a different SHA, and `tag()` would sign that never-tested tree.
    11	#       Two DISTINCT failures, never merged into one message: "could not talk
    12	#       to origin" (network/offline — has a named escape hatch) and "HEAD is
    13	#       not an ancestor of origin/main" (a real governance stop). The fetch and
    14	#       the merge-base are SEPARATE statements: a failed fetch followed by a
    15	#       merge-base against a stale ref is a FALSE APPROVAL.
    16	#
    17	#   (b) RESTRICTED DELTA. The invariant is "nothing landed after what the
    18	#       re-pass reviewed, other than the verdict itself". The anchor is the
    19	#       REVIEWED PARENT recorded in the signed verdict — one rule for RC and
    20	#       GA. Anchoring on "the last RC" is wrong in both directions: for the GA
    21	#       it coincides by accident, and for an rc.2 it would reject the very
    22	#       W0/W1 fixes the re-pass just reviewed.
    23	#
    24	#       The allowlist is TAG-SPECIFIC and CLOSED:
    25	#         * never the wildcard `pair-rail-verdict-*.md` — that would let a
    26	#           historical verdict or the template be touched and still pass;
    27	#         * never `repass-<N>/**` — any file dropped into that directory after
    28	#           the review would pass the guard, and the pair-rail step-15 replay
    29	#           does not cover plan artifacts;
    30	#         * so the set closes by NAME (exact paths, set equality against the
    31	#           re-pass MANIFEST) *and* by CONTENT (the verdict pins the sha256 of
    32	#           MANIFEST.sha256, and the manifest itself is verified with
    33	#           `shasum -a 256 -c`);
    34	#         * and a plan path OUTSIDE the manifest directory — where no sha256
    35	#           pins content — is admitted ONLY as `verdict-fields-<TAG>.md` with
    36	#           the literal target tag, at its ONE canonical path (directly in
    37	#           the plan directory containing the manifest dir): the plan file
    38	#           itself, immutable repass history, another tag's verdict-fields,
    39	#           and same-basename look-alikes in any other directory all close by
    40	#           name alone and would carry a post-review edit onto the tag;
    41	#         * the reviewed parent itself must be an ANCESTOR of HEAD —
    42	#           `cat-file -e` proves existence, not lineage, and a fabricated
    43	#           `commit-tree` anchor makes the whole delta trivially clean.
    44	#
    45	# THE LOCAL ASSERT IS NOT ENOUGH. A tag signed by hand skips this driver
    46	# entirely, and the pair-rail step 15 recomputes inputs_hash only over the
    47	# manifest — which deliberately EXCLUDES the bump surfaces. The same assert
    48	# therefore goes server-side into `.github/workflows/release.yml` in PLAN-166
    49	# W1 (release.yml is canonical; it is changed under the GPG ceremony, not
    50	# here). Keep the two implementations in sync: this file is the reference.
    51	#
    52	# Exit codes are distinct so the failure MODE is testable, not just the
    53	# failure:
    54	#   2 usage   3 fetch failed   4 not-ancestor   5 remote ref unusable
    55	#   6 delta outside allowlist  7 manifest sha pin mismatch
    56	#   8 manifest content mismatch (shasum -c)  9 manifest/allowlist set mismatch
    57	#  10 verdict unusable (missing file/field, wildcard, wrong tag, bad parent)
    58	#  11 the assert would be VACUOUS (the verdict is not inside the delta it
    59	#     anchors — e.g. parent_sha == HEAD, which makes the verdict review itself)
    60	#  12 parent_sha is not an ancestor of HEAD (a fabricated/orphan anchor:
    61	#     `cat-file -e` proves existence, not lineage — a `commit-tree` object
    62	#     carrying HEAD's own tree makes diff(parent..HEAD) contain only the
    63	#     verdict while unreviewed work sits on main)
    64	# ============================================================================
    65	"""Ancestry + restricted-delta asserts for the release tag phase."""
    66	
    67	from __future__ import annotations
    68	
    69	import argparse
    70	import hashlib
    71	import os
    72	import re
    73	import subprocess
    74	import sys
    75	from typing import Dict, List, Optional, Sequence, Set, Tuple
    76	
    77	E_USAGE = 2
    78	E_FETCH = 3
    79	E_NOT_ANCESTOR = 4
    80	E_REMOTE_REF = 5
    81	E_DELTA = 6
    82	E_MANIFEST_PIN = 7
    83	E_MANIFEST_CONTENT = 8
    84	E_MANIFEST_SET = 9
    85	E_VERDICT = 10
    86	E_VACUOUS = 11
    87	E_PARENT_NOT_ANCESTOR = 12
    88	
    89	HEX40 = re.compile(r"\A[0-9a-f]{40}\Z")
    90	HEX64 = re.compile(r"\A[0-9a-f]{64}\Z")
    91	GLOB_CHARS = "*?["
    92	VERDICT_PREFIX = ".claude/governance/pair-rail-verdict-"
    93	# The allowlist is EXHAUSTIVE, not merely closed: the verdict for this tag plus
    94	# plan-side evidence (the `verdict-fields-<TAG>` pair and the re-pass artifact
    95	# directory both live under `.claude/plans/`). Anything else — a version site, a
    96	# workflow, any code path — would re-open the very hole the delta assert exists
    97	# to close: a post-review bump commit riding in on the tag.
    98	EVIDENCE_PREFIX = ".claude/plans/"
    99	
   100	
   101	def _fail(code: int, msg: str) -> int:
   102	    # Flush the ok-lines first: an operator reading a release failure must see
   103	    # WHICH checks passed before the one that stopped it, in order.
   104	    sys.stdout.flush()
   105	    print("FAIL: %s" % msg, file=sys.stderr)
   106	    sys.stderr.flush()
   107	    return code
   108	
   109	
   110	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   111	    proc = subprocess.run(
   112	        ["git"] + list(args),
   113	        cwd=repo,
   114	        stdout=subprocess.PIPE,
   115	        stderr=subprocess.PIPE,
   116	        universal_newlines=True,
   117	    )
   118	    return proc.returncode, proc.stdout, proc.stderr
   119	
   120	
   121	# ---------------------------------------------------------------------------
   122	# (a) ancestry
   123	# ---------------------------------------------------------------------------
   124	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   125	    ref = "%s/%s" % (remote, branch)
   126	    if offline_ack:
   127	        print(
   128	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   129	            "merge-base below is judged against a possibly STALE %s" % ref
   130	        )
   131	    else:
   132	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   133	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   134	        # stale ref reads as approval.
   135	        if rc != 0:
   136	            return _fail(
   137	                E_FETCH,
   138	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   139	                "      This is NOT a verdict on the commit — the check did not "
   140	                "run.\n"
   141	                "      Fix the network/remote and re-run, or, if you are "
   142	                "deliberately\n"
   143	                "      offline and accept judging against the last-known ref, "
   144	                "re-run\n"
   145	                "      with --offline-ack (it is recorded in the output).\n"
   146	                "      git said: %s" % (remote, branch, rc, err.strip()),
   147	            )
   148	        print("  ok   fetched %s" % ref)
   149	
   150	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   151	    if rc != 0 or not out.strip():
   152	        return _fail(
   153	            E_REMOTE_REF,
   154	            "no usable ref %s in this repo — cannot judge ancestry "
   155	            "(git said: %s)" % (ref, err.strip()),
   156	        )
   157	    remote_sha = out.strip()
   158	
   159	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   160	    if rc == 0:
   161	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   162	        return 0
   163	    if rc == 1:
   164	        return _fail(
   165	            E_NOT_ANCESTOR,
   166	            "HEAD is not an ancestor of %s — push main and re-run the "
   167	            "preflight.\n"
   168	            "      A tag on an unpushed commit points at a tree CI never "
   169	            "saw; the\n"
   170	            "      preflight's green verdict was about a different SHA."
   171	            % ref,
   172	        )
   173	    return _fail(
   174	        E_REMOTE_REF,
   175	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   176	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   177	    )
   178	
   179	
   180	# ---------------------------------------------------------------------------
   181	# (b) restricted delta
   182	# ---------------------------------------------------------------------------
   183	def _parse_verdict(text: str) -> Dict[str, object]:
   184	    """Minimal, stdlib-only reader for the verdict's fenced YAML block.
   185	
   186	    Deliberately NOT a YAML parser: it accepts `key: value` and a single level
   187	    of `  - item` list entries, and ignores everything else. Anything it cannot
   188	    read is absent, and every consumer below treats absent as fail-closed.
   189	
   190	    Parity with the step-15 reader (`.github/scripts/
   191	    validate-pair-rail-verdict.py`, parse_verdict_file), stated at its REAL
   192	    scope: block selection (the regex below is the validator's own — the
   193	    first ```yaml fence, not the first fence of any language) and inline
   194	    comment stripping MATCH; list parsing (`- item`) exists ONLY here —
   195	    parse_verdict_file reads key:value and sub-dicts and would drop
   196	    `delta_allowlist` silently. The W1 server-side port must therefore extend
   197	    ONE shared reader (this file is the declared reference), never grow a
   198	    third parser of the same signed file.
   199	    """
   200	    fields: Dict[str, object] = {}
   201	    block = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
   202	    if block is None:
   203	        # No yaml block -> no fields -> every consumer below fails closed.
   204	        return fields
   205	    cur_list: Optional[str] = None
   206	    for raw in block.group(1).splitlines():
   207	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   208	        if not line.strip():
   209	            continue
   210	        if line.startswith(("  - ", "- ")) and cur_list:
   211	            item = line.split("-", 1)[1].strip()
   212	            if item:
   213	                fields[cur_list].append(item)  # type: ignore[union-attr]
   214	            continue
   215	        m = re.match(r"\A([A-Za-z0-9_]+):\s*(.*)\Z", line)
   216	        if not m:
   217	            continue
   218	        key, val = m.group(1), m.group(2).strip()
   219	        if val == "":
   220	            fields[key] = []
   221	            cur_list = key
   222	        else:
   223	            fields[key] = val
   224	            cur_list = None
   225	    return fields
   226	
   227	
   228	def _sha256(path: str) -> str:
   229	    h = hashlib.sha256()
   230	    with open(path, "rb") as fh:
   231	        for chunk in iter(lambda: fh.read(65536), b""):
   232	            h.update(chunk)
   233	    return h.hexdigest()
   234	
   235	
   236	def _read_manifest(path: str) -> List[Tuple[str, str]]:
   237	    """`shasum -a 256` format: '<sha>  <name>' — returns [(sha, name)]."""
   238	    entries: List[Tuple[str, str]] = []
   239	    with open(path, encoding="utf-8") as fh:
   240	        for line in fh:
   241	            line = line.rstrip("\n")
   242	            if not line.strip():
   243	                continue
   244	            m = re.match(r"\A([0-9a-f]{64}) [ *](.+)\Z", line)
   245	            if not m:
   246	                raise ValueError("unparsable manifest line: %r" % line)
   247	            entries.append((m.group(1), m.group(2)))
   248	    return entries
   249	
   250	
   251	def _verify_manifest_content(manifest: str) -> Tuple[bool, str]:
   252	    """Run `shasum -a 256 -c`; fall back to hashlib when shasum is absent."""
   253	    directory = os.path.dirname(manifest) or "."
   254	    name = os.path.basename(manifest)
   255	    try:
   256	        proc = subprocess.run(
   257	            ["shasum", "-a", "256", "-c", name],
   258	            cwd=directory,
   259	            stdout=subprocess.PIPE,
   260	            stderr=subprocess.STDOUT,
   261	            universal_newlines=True,
   262	        )
   263	        return proc.returncode == 0, proc.stdout.strip()
   264	    except (OSError, FileNotFoundError):
   265	        bad: List[str] = []
   266	        for want, rel in _read_manifest(manifest):
   267	            full = os.path.join(directory, rel)
   268	            if not os.path.isfile(full) or _sha256(full) != want:
   269	                bad.append(rel)
   270	        if bad:
   271	            return False, "hashlib fallback: mismatch/missing: %s" % ", ".join(bad)
   272	        return True, "hashlib fallback: all entries match"
   273	
   274	
   275	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   276	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   277	    verdict_abs = os.path.join(repo, verdict_rel)
   278	    if not os.path.isfile(verdict_abs):
   279	        return _fail(
   280	            E_VERDICT,
   281	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   282	            "be committed before the tag is cut (release.yml validates it per "
   283	            "tag on the tagged tree)." % verdict_rel,
   284	        )
   285	    with open(verdict_abs, encoding="utf-8") as fh:
   286	        fields = _parse_verdict(fh.read())
   287	
   288	    release_tag = fields.get("release_tag")
   289	    if release_tag != tag:
   290	        return _fail(
   291	            E_VERDICT,
   292	            "verdict %s declares release_tag=%r, target tag is %r — refusing "
   293	            "to judge this tag against another tag's verdict."
   294	            % (verdict_rel, release_tag, tag),
   295	        )
   296	    parent = fields.get("parent_sha")
   297	    if not isinstance(parent, str) or not HEX40.match(parent):
   298	        return _fail(
   299	            E_VERDICT,
   300	            "verdict %s has no usable 40-hex `parent_sha:` — that field IS "
   301	            "the review anchor." % verdict_rel,
   302	        )
   303	    rc, _out, _err = _git(repo, "cat-file", "-e", parent + "^{commit}")
   304	    if rc != 0:
   305	        return _fail(
   306	            E_VERDICT,
   307	            "parent_sha %s from %s is not a commit in this repo."
   308	            % (parent, verdict_rel),
   309	        )
   310	    # Existence is not lineage. A fabricated anchor (`git commit-tree` over
   311	    # HEAD's own tree, parented anywhere, on no branch) passes `cat-file -e`
   312	    # and makes diff(parent..HEAD) contain ONLY the verdict + evidence while
   313	    # unreviewed work sits on main — every check below then passes and the
   314	    # guard prints approval over a tree the re-pass never saw. The anchor has
   315	    # to be a commit HEAD actually descends from. (The staged W1 server-side
   316	    # port asserts the same against origin/main — keep the two in sync.)
   317	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", parent, "HEAD")
   318	    if rc == 1:
   319	        return _fail(
   320	            E_PARENT_NOT_ANCESTOR,
   321	            "parent_sha %s from %s is not an ancestor of HEAD — the review "
   322	            "anchor is not in\n"
   323	            "      the history this tag would sign. `cat-file -e` proves the "
   324	            "object exists, not\n"
   325	            "      that main descends from it; a fabricated commit carrying "
   326	            "HEAD's own tree\n"
   327	            "      makes the delta below trivially clean while unreviewed "
   328	            "work rides the tag."
   329	            % (parent[:12], verdict_rel),
   330	        )
   331	    if rc != 0:
   332	        return _fail(
   333	            E_PARENT_NOT_ANCESTOR,
   334	            "`git merge-base --is-ancestor %s HEAD` exited %d (neither yes "
   335	            "nor no) — refusing to guess (git said: %s)"
   336	            % (parent[:12], rc, err.strip()),
   337	        )
   338	    print("  ok   parent_sha %s is an ancestor of HEAD" % parent[:12])
   339	
   340	    allow = fields.get("delta_allowlist")
   341	    if not isinstance(allow, list) or not allow:
   342	        return _fail(
   343	            E_VERDICT,
   344	            "verdict %s carries no `delta_allowlist:` entries — the closed "
   345	            "set is what makes the delta assert meaningful." % verdict_rel,
   346	        )
   347	    for entry in allow:
   348	        if any(ch in entry for ch in GLOB_CHARS):
   349	            return _fail(
   350	                E_VERDICT,
   351	                "delta_allowlist entry %r contains a glob metacharacter. The "
   352	                "set is CLOSED and literal: a pattern like "
   353	                "`pair-rail-verdict-*.md` would let a historical verdict or "
   354	                "the template be edited and still pass." % entry,
   355	            )
   356	        if entry.startswith("/") or ".." in entry.split("/"):
   357	            return _fail(
   358	                E_VERDICT,
   359	                "delta_allowlist entry %r must be a repo-relative path with "
   360	                "no `..` segment." % entry,
     1	#!/usr/bin/env python3
     2	"""validate-pair-rail-verdict.py — PLAN-081 Phase 6 release.yml step 15.
     3	
     4	Validates a Pair-Rail verdict artifact (`.claude/governance/
     5	pair-rail-verdict-<release-tag>.md`) per R1 S-Sec-3 replay defense +
     6	R1 S-Sec-4 inputs_hash determinism + R1 C5 Codex CLI pin enforcement
     7	+ R1 S-QA-Unseen-2 distinct VERDICT_EXPIRED exit code.
     8	
     9	## Usage
    10	
    11	    python3 .github/scripts/validate-pair-rail-verdict.py \\
    12	      --verdict-file .claude/governance/pair-rail-verdict-${GITHUB_REF_NAME}.md \\
    13	      --parent-sha ${PARENT_SHA} \\
    14	      --release-tag ${GITHUB_REF_NAME} \\
    15	      --max-age-hours 24 \\
    16	      --recompute-inputs-hash \\
    17	      --codex-cli-pin-file .claude/governance/codex-cli-pin.txt \\
    18	      --codex-pin-manifest-file .claude/governance/codex-cli-pin-manifest.json \\
    19	      --inputs-hash-paths-file .claude/governance/pair-rail-inputs-hash-manifest.txt
    20	
    21	## ADR-182 payload pin (PLAN-163 T5.2)
    22	
    23	`--codex-pin-manifest-file` enforces the payload pin: the verdict
    24	envelope MUST declare `tool_versions.codex_target_triple` (the platform
    25	triple of the run that generated the verdict) and
    26	`tool_versions.codex_payload_sha256` (sha256 of the NATIVE codex
    27	payload for that triple — NOT the npm JS launcher). The validator
    28	compares the declared sha against
    29	`manifest.payloads[<triple>].sha256`. Fail-CLOSED: missing fields,
    30	triple absent from the manifest, malformed entry, or sha mismatch →
    31	VERDICT_INVALID (3). Manifest file unreadable → infra (1). The legacy
    32	`--codex-cli-binary-sha256-file` launcher-hash pin is retained only for
    33	pre-ADR-182 tags; the live pin file is a comment-only tombstone, which
    34	that legacy path treats as "no pin" (skip).
    35	
    36	## parent_sha vs commit_sha (S104 redesign)
    37	
    38	The legacy `--commit-sha` arg + verdict `commit_sha:` field bound the
    39	verdict to a SHA the verdict commit itself produced — an unsolvable
    40	self-reference (`pair-rail-verdict-vX.md` cannot declare its own commit
    41	SHA because that SHA is only known AFTER the verdict file is committed).
    42	The v1.16.0 GA ceremony bridged this via `CEO_PAIR_RAIL_VERDICT_OPTIONAL=1`
    43	transition mode, which silently disabled the bind.
    44	
    45	`parent_sha:` solves it cleanly. The verdict declares the commit it was
    46	generated AGAINST (the parent of the verdict-file commit). That value is
    47	known when the verdict is authored (it's `git rev-parse HEAD` before the
    48	verdict commit). Step 15 validates against `git log -n1 --format=%H --
    49	<verdict-file>` parent, which is observable + immutable.
    50	
    51	Backward-compat: when only `commit_sha:` (legacy) is present and
    52	`--parent-sha` is empty, the bind is skipped with an ADVISORY (matches
    53	prior CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 behavior). Legacy verdicts for
    54	already-shipped tags (v1.16.0 etc.) keep their existing semantics; new
    55	verdicts use `parent_sha:`.
    56	
    57	## Exit codes
    58	
    59	- 0: verdict valid; release proceeds.
    60	- 1: infra error (file missing / unparseable / etc.); release.yml
    61	     decides based on CEO_PAIR_RAIL_VERDICT_OPTIONAL.
    62	- 2: VERDICT_EXPIRED — distinct from infra-error per R1 S-QA-Unseen-2.
    63	     Release.yml can route this to a "verdict regen" branch.
    64	- 3: VERDICT_INVALID — release_tag mismatch / parent_sha mismatch /
    65	     inputs_hash mismatch / pin mismatch / signature missing. Release
    66	     MUST stop here.
    67	
    68	stdlib only. Python ≥3.9.
    69	"""
    70	
    71	from __future__ import annotations
    72	
    73	import argparse
    74	import hashlib
    75	import json
    76	import re
    77	import subprocess
    78	import sys
    79	from datetime import datetime, timezone
    80	from pathlib import Path
    81	from typing import Any, Dict, List, Optional, Tuple
