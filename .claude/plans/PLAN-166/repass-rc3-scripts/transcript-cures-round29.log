     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# release.sh — operator release driver. Version-neutral BY NAME.
     4	#
     5	# The previous driver carried a release number in its own FILENAME, and was
     6	# still driving the release after that one — the root of a whole class: a
     7	# driver named for one release is a standing invitation for every other version
     8	# literal inside it to go stale too. Everything release-specific now lives in
     9	# the PER-RELEASE block below, and every message derives from it. The old path
    10	# is deliberately left unspelled on every live surface, so the AC-6 control
    11	# needs no "except this one" exemption; `git log --follow` is the archaeology.
    12	#
    13	# Implements the documented procedure in `.github/release-checklist.md`:
    14	# RC first (vX.Y.Z-rc.N), then the ADR-103 24 h hold, then promote stable.
    15	#
    16	# WHAT THE OWNER SIGNS. Nothing here is a canonical-edit ceremony: CHANGELOG.md,
    17	# VERSION and npm/package.json are NOT in `_CANONICAL_GUARDS`
    18	# (`.claude/hooks/check_canonical_edit.py`), so no sentinel `approved.md`
    19	# exists for a release. The Owner signature is the **annotated GPG tag**,
    20	# produced INLINE by the `tag` phase (family lesson: a ceremony script signs
    21	# inline and never demands a pre-existing `.asc`).
    22	#
    23	# WHAT THIS SCRIPT NEVER DOES. It never pushes, and it never publishes.
    24	# Pushing the tag is the irreversible, outward-facing step: it starts BOTH
    25	# `.github/workflows/release.yml` (the release gate) and
    26	# `.github/workflows/npm-publish.yml` — and npm-publish.yml is what actually
    27	# publishes to npm via OIDC. This driver prints the push command and stops.
    28	#
    29	# Phases (run in order):
    30	#   preflight  read-only gates, fail-closed          (default)
    31	#   bump       version sites + plugin manifests + commit
    32	#   tag        annotated GPG tag, signed inline, behind two fail-closed guards
    33	#
    34	# Usage:
    35	#   bash .claude/scripts/local/release.sh preflight
    36	#   bash .claude/scripts/local/release.sh bump --dry-run
    37	#   bash .claude/scripts/local/release.sh bump
    38	#   bash .claude/scripts/local/release.sh tag --dry-run
    39	#   bash .claude/scripts/local/release.sh tag
    40	#
    41	# Options:
    42	#   --dry-run        make no lasting change; restores BOTH working tree and
    43	#                    index on exit (trap), including on failure. The restore
    44	#                    list is DERIVED from _release_bump_sites.py, never typed.
    45	#   --stable         target the bare version instead of -rc.N (post-hold promote)
    46	#   --rc N           RC ordinal (default 1)
    47	#   --key KEYID      GPG key to sign with (default: the key of the last release)
    48	#   --today DATE     YYYY-MM-DD stamped into the `last-reviewed:` lines
    49	#                    (default: today). It exists so the D/D+1 idempotence
    50	#                    invariant is testable at the driver level; it changes only
    51	#                    the stamp date and skips no gate.
    52	#   --restamp        force the four `last-reviewed:` stamps to move even when
    53	#                    the version is unchanged — the named route for a REAL
    54	#                    re-review. Requires --npm-readme-reviewed and disables the
    55	#                    no-op fast path (otherwise it would be dead letter).
    56	#   --offline-ack    ancestry guard: skip the `git fetch` and judge HEAD
    57	#                    against the last-known origin/main (announced loudly)
    58	#   --npm-readme-reviewed
    59	#                    required by `bump` when it writes: acknowledges that
    60	#                    npm/README.md was actually re-read. Its `last-reviewed`
    61	#                    stamp is a release tripwire by design; re-stamping it
    62	#                    silently would defeat the gate.
    63	# ============================================================================
    64	set -euo pipefail
    65	
    66	# ---------------------------------------------------------------------------
    67	# PER-RELEASE — the only block that changes between releases. Rewrite all of it
    68	# together. RELEASE_SCOPE and RELEASE_HEADLINE end up inside the SIGNED tag
    69	# annotation, so stale text there is a false claim on a signed surface (the P0
    70	# class of this repo) — and no preflight can prove prose matches a diff.
    71	# The tag stands for the WHOLE release train in CHANGELOG.md, never just the
    72	# newest plan: list every plan of the train and the full ADR range.
    73	# ---------------------------------------------------------------------------
    74	TARGET_BASE="1.3.0"
    75	RELEASE_TITLE="night-mode + release-mechanics hardening"
    76	# repass-r2 part-d P1 (S299): the v1.3.0 train grew past the rc.1 text —
    77	# 167/168 (ownership decision table) and 169 W0-W2 (Linux port + verified
    78	# fixes) landed between rc.1 and rc.2. The tag stands for the WHOLE train.
    79	RELEASE_SCOPE="PLAN-162 / PLAN-165 / PLAN-166 / PLAN-167 / PLAN-168 / PLAN-169 W0-W2 (ADRs 184 -> 190)"
    80	RELEASE_HEADLINE="night-mode — the Owner arms per-machine autonomy for one upcoming
    81	session (gitignored overlay, next-session semantics), and arming it is a
    82	HUMAN action by construction: the writer script self-path-guards, the Bash
    83	rail matches invocation best-effort, and every on/off/refusal lands in the
    84	HMAC chain as night_mode_toggled (proven live, not by fixture).
    85	
    86	Also: a case-fold bypass that let .claude/settings.JSON slip past BOTH the
    87	canonical and kernel rails on case-insensitive filesystems (P0, fixed on
    88	both rails); ADR-186 settles the hook-deadline conflict — the canonical
    89	matcher wall deadline fails CLOSED as a named exception to the published
    90	fail-open-on-infrastructure contract, with a provenance-pinned unlock as the
    91	recovery route; sentinel unlock inside a git worktree now REQUIRES that
    92	provenance (ADR-119 Invariant 5); pair-rail 120/150 -> 180/210 with
    93	timeout_ms and a censoring-rate trigger, ratified only after a live probe
    94	proved the harness honors a 210 s registration; four scheduled workflows that
    95	had been red without ever surfacing in push CI; and the release mechanics
    96	themselves — an idempotent bump, plus an ancestry gate and a restricted-delta
    97	gate on the tag phase (PLAN-166)."
    98	
    99	RC_NUM="1"
   100	STABLE=0
   101	DRY_RUN=0
   102	NPM_README_REVIEWED=0
   103	RESTAMP=0
   104	OFFLINE_ACK=0
   105	TODAY=""
   106	PHASE=""
   107	
   108	BUMP_SITES=".claude/scripts/local/_release_bump_sites.py"
   109	TAG_GUARD=".claude/scripts/local/_release_tag_guard.py"
   110	
   111	# Continuity: the key that signed the previous release. Overridable, but never
   112	# guessed at signing time — the preflight proves it can actually produce a
   113	# signature.
   114	SIGN_KEY="CFCFACF00335DC74"
   115	
   116	die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
   117	ok()  { printf '  ok   %s\n' "$*"; }
   118	note(){ printf '  --   %s\n' "$*"; }
   119	hdr() { printf '\n== %s ==\n' "$*"; }
   120	
   121	usage() {
   122	  cat <<USAGE
   123	release.sh — operator release driver (target base version: $TARGET_BASE)
   124	
   125	  bash $0 preflight [--rc N | --stable]
   126	  bash $0 bump      [--rc N | --stable] --npm-readme-reviewed [--dry-run]
   127	  bash $0 tag       [--rc N | --stable] [--dry-run]
   128	
   129	  --dry-run              no lasting change; tree AND index restored on exit
   130	  --stable               target $TARGET_BASE (post-hold promote)
   131	  --rc N                 target ${TARGET_BASE}-rc.N (default N=$RC_NUM)
   132	  --key KEYID            GPG key (default $SIGN_KEY)
   133	  --today YYYY-MM-DD     date stamped into the last-reviewed lines
   134	  --restamp              move the review stamps at an unchanged version
   135	                         (requires --npm-readme-reviewed)
   136	  --offline-ack          ancestry guard judges a possibly stale origin/main
   137	  --npm-readme-reviewed  assert npm/README.md was actually re-read
   138	
   139	The header of this file documents what the Owner signs, why this script never
   140	pushes, and why it never publishes.
   141	USAGE
   142	}
   143	
   144	while [ "$#" -gt 0 ]; do
   145	  case "$1" in
   146	    preflight|bump|tag) PHASE="$1"; shift ;;
   147	    --dry-run) DRY_RUN=1; shift ;;
   148	    --stable)  STABLE=1; shift ;;
   149	    --npm-readme-reviewed) NPM_README_REVIEWED=1; shift ;;
   150	    --restamp) RESTAMP=1; shift ;;
   151	    --offline-ack) OFFLINE_ACK=1; shift ;;
   152	    --today)   TODAY="${2:?--today needs YYYY-MM-DD}"; shift 2 ;;
   153	    --rc)      RC_NUM="${2:?--rc needs a number}"; shift 2 ;;
   154	    --key)     SIGN_KEY="${2:?--key needs a keyid}"; shift 2 ;;
   155	    -h|--help) usage; exit 0 ;;
   156	    *) die "unknown argument: $1" ;;
   157	  esac
   158	done
   159	[ -n "$PHASE" ] || die "no phase given (preflight|bump|tag); see --help"
   160	
   161	if [ -n "$TODAY" ]; then
   162	  case "$TODAY" in
   163	    [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;;
   164	    *) die "--today must be YYYY-MM-DD, got '$TODAY'" ;;
   165	  esac
   166	else
   167	  TODAY="$(date +%F)"
   168	fi
   169	
   170	if [ "$STABLE" -eq 1 ]; then
   171	  TARGET_VERSION="$TARGET_BASE"
   172	else
   173	  TARGET_VERSION="${TARGET_BASE}-rc.${RC_NUM}"
   174	fi
   175	TARGET_TAG="v${TARGET_VERSION}"
   176	
   177	REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || die "not a git repo"
   178	cd "$REPO_ROOT"
   179	
   180	# GPG in a non-interactive shell needs an explicit TTY or pinentry fails with
   181	# a misleading "No pinentry" (recurring footgun in this repo ceremonies).
   182	GPG_TTY="$(tty 2>/dev/null || true)"
   183	export GPG_TTY
   184	
   185	# Every file the bump phase may write — DERIVED, never typed. A hand-kept
   186	# restore list is how a dry-run left debris behind once already (S273): the
   187	# writer grew a site, the restore list did not. `--include-generated` adds the
   188	# two plugin manifests, which `build-plugin.py --write-manifests` rewrites
   189	# from VERSION during the bump.
   190	sites_out="$(python3 "$BUMP_SITES" print-sites --include-generated)" \
   191	  || die "cannot enumerate version sites from $BUMP_SITES"
   192	VERSION_FILES=()
   193	while IFS= read -r _site; do
   194	  [ -n "$_site" ] || continue
   195	  VERSION_FILES+=("$_site")
   196	done <<< "$sites_out"
   197	[ "${#VERSION_FILES[@]}" -gt 0 ] || die "$BUMP_SITES returned no version sites"
   198	
   199	printf 'release driver — target %s (tag %s), phase=%s, dry-run=%s, today=%s\n' \
   200	  "$TARGET_VERSION" "$TARGET_TAG" "$PHASE" "$DRY_RUN" "$TODAY"
   201	
   202	# ---------------------------------------------------------------------------
   203	# Dry-run safety net. Snapshot every file the `bump` phase writes plus the
   204	# index state, and restore both on ANY exit path.
   205	# ---------------------------------------------------------------------------
   206	SNAPSHOT_ARMED=0
   207	restore_snapshot() {
   208	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   209	  # The bump phase refuses to run on a dirty tree (untracked included), so
   210	  # HEAD is exactly the pre-bump state: reset unstages, checkout restores
   211	  # content. Both halves are needed — an index-only restore leaves the files
   212	  # modified, and a content-only restore leaves them staged (the S273 trap).
   213	  #
   214	  # PER PATH, never one multi-path command: `git checkout -- a b c` is
   215	  # ATOMIC — a single path absent from HEAD (a file the bump CREATED, e.g. a
   216	  # plugin manifest on its first appearance) aborts the WHOLE command and
   217	  # restores nothing, and the old `|| true` swallowed that error while the
   218	  # message below still claimed success. A path HEAD carries is checked out;
   219	  # a path HEAD does not carry was created by the bump and is removed.
   220	  local _p _dirty
   221	  for _p in "${VERSION_FILES[@]}"; do
   222	    git reset --quiet HEAD -- "$_p" 2>/dev/null || true
   223	    if git cat-file -e "HEAD:$_p" 2>/dev/null; then
   224	      git checkout --quiet -- "$_p" 2>/dev/null || true
   225	    else
   226	      rm -f "$_p" 2>/dev/null || true
   227	      # a directory created for that file may remain; drop it only if empty
   228	      # (never recursive — this is a restore, not a cleanup)
   229	      rmdir "$(dirname "$_p")" 2>/dev/null || true
   230	    fi
   231	  done
   232	  # ASSERT the postcondition, not the attempt: worktree AND index must be
   233	  # clean across every derived path, or this dry-run left debris and the only
   234	  # honest exit is a loud non-zero — printing "restored" over a dirty tree is
   235	  # the S273 class silenced instead of closed.
   236	  # The verification itself is fail-CLOSED (codex W0-residuals round): if
   237	  # `git status` ERRORS (repo/permission/object failure), an `|| true` here
   238	  # would read as "empty = clean" and print "asserted clean" over a
   239	  # postcondition that was never checked — capture the exit status instead.
   240	  _dirty="$(git status --porcelain -- "${VERSION_FILES[@]}" 2>/dev/null)"
   241	  _status_rc=$?
   242	  if [ "$_status_rc" -ne 0 ]; then
   243	    printf 'FAIL: dry-run restore verification could not run (git status rc=%s) — tree state UNVERIFIED, refusing to report clean\n' "$_status_rc" >&2
   244	    exit 1
   245	  fi
   246	  if [ -n "$_dirty" ]; then
   247	    printf 'FAIL: dry-run restore left these paths dirty (worktree/index != HEAD):\n' >&2
   248	    printf '%s\n' "$_dirty" >&2
   249	    exit 1
   250	  fi
   251	  printf '  --   dry-run: working tree AND index restored to HEAD (asserted clean)\n'
   252	}
   253	
   254	take_snapshot() {
   255	  SNAPSHOT_ARMED=1
   256	  trap restore_snapshot EXIT INT TERM
   257	}
