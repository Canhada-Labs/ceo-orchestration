   259	hint_next_phase() {
   260	  # Test the VALUE: `${STABLE:+...}` expands for STABLE=0 (a non-empty string)
   261	  # and would tell the Owner to cut the STABLE tag during an RC run.
   262	  if [ "$STABLE" -eq 1 ]; then
   263	    note "proceed to: bash $0 tag --stable"
   264	  else
   265	    note "proceed to: bash $0 tag --rc $RC_NUM"
   266	  fi
   267	}
