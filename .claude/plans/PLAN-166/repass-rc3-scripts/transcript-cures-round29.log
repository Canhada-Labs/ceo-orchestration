   144	          fetch_payload() {
   145	            # One document: every run for THIS head_sha, each carrying its
   146	            # jobs. A run whose jobs endpoint is unreadable keeps no `jobs`
   147	            # key — the decision function reads that as WAIT, never GRANT.
   148	            if ! gh api --paginate \
