.claude/plans/PLAN-166/repass-ga/run-ga-repass.sh
     1	#!/bin/bash
     2	# Re-pass do hold ADR-103 para o GA v1.3.0 (PLAN-166 W2 / W6.1) - 2 PARTES.
     3	# Pipeline identico ao r1/r2: prompt + diff -> redactor ADR-114 ->
     4	# controles -> codex exec read-only de worktree detached DA TAG rc.2.
     5	# O diff v1.2.0..rc.2 do escopo release-mechanics tem ~282KB > cap de
     6	# 250KB do redactor => particao coerente em 2 payloads (medida S300):
     7	#   g1: superficies de versao/docs/config + upgrade.sh (blast radius
     8	#       do adotante) ~111KB
     9	#   g2: maquinaria executavel do release (workflows + driver + guard +
    10	#       bump-sites + await-gate + validador step-15) ~176KB
    11	# Saida por parte: payload-ga-N.redacted.txt, diff-ga-N.patch,
    12	# paths-ga-N.manifest.txt, verdict-ga-N.txt, transcript-ga-N.log;
    13	# agregado em PROVENANCE-ga.md + MANIFEST-ga.sha256 (BASENAMES).
    14	# O GA so segue com VERDICT: GO (ou GO-WITH-CONDITIONS) nas DUAS partes.
    15	set -uo pipefail
    16	REPO_ROOT="$(git rev-parse --show-toplevel)"; cd "$REPO_ROOT" || exit 2
    17	OUT="$REPO_ROOT/.claude/plans/PLAN-166/repass-ga"
    18	BASE_TAG="v1.2.0"
    19	RC_TAG="v1.3.0-rc.2"
    20	git rev-parse -q --verify "refs/tags/$RC_TAG" >/dev/null 2>&1 \
    21	  || { echo "FATAL: tag $RC_TAG nao existe - corte a rc.2 primeiro"; exit 2; }
    22	
    23	WT="$(mktemp -d "${TMPDIR:-/tmp}/repass-ga.XXXXXX")/wt"
    24	git worktree add --detach "$WT" "$RC_TAG" >/dev/null || exit 2
    25	trap 'git worktree remove --force "$WT" >/dev/null 2>&1 || true' EXIT
    26	[ -z "$(git -C "$WT" status --porcelain)" ] || { echo "FATAL: worktree sujo"; exit 2; }
    27	
    28	part_paths() {
    29	  case "$1" in
    30	    1) cat <<'P1'
    31	VERSION
    32	npm/README.md
    33	npm/package.json
    34	pyproject.toml
    35	CHANGELOG.md
    36	INSTALL.md
    37	docs/ARCHITECTURE.md
    38	README.md
    39	README.pt-BR.md
    40	SECURITY.md
    41	VERSIONING.md
    42	SBOM.md
    43	.github/release-checklist.md
    44	.claude-plugin/marketplace.json
    45	.claude-plugin/plugin.json
    46	scripts/upgrade.sh
    47	P1
    48	;;
    49	    2) cat <<'P2'
    50	.github/workflows/release.yml
    51	.github/workflows/npm-publish.yml
    52	.claude/scripts/local/verify-counts.sh
    53	.claude/scripts/local/release.sh
    54	.claude/scripts/local/_release_tag_guard.py
    55	.claude/scripts/local/_release_bump_sites.py
    56	.claude/scripts/await_release_gate.py
    57	.github/scripts/validate-pair-rail-verdict.py
    58	P2
    59	;;
    60	  esac
    61	}
