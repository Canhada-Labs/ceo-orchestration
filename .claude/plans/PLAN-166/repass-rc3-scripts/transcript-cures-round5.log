   553	
   554	def main(argv: Optional[Sequence[str]] = None) -> int:
   555	    parser = argparse.ArgumentParser(prog="_release_tag_guard.py")
   556	    sub = parser.add_subparsers(dest="cmd")
   557	
   558	    p_anc = sub.add_parser("ancestry", help="HEAD must be on origin/<branch>")
   559	    p_anc.add_argument("--repo", default=".")
   560	    p_anc.add_argument("--remote", default="origin")
   561	    p_anc.add_argument("--branch", default="main")
   562	    p_anc.add_argument(
   563	        "--offline-ack",
   564	        action="store_true",
   565	        help="named escape hatch: skip the fetch and judge against the "
   566	        "last-known remote ref (loudly announced)",
   567	    )
   568	
   569	    p_delta = sub.add_parser("delta", help="restricted delta vs the verdict")
   570	    p_delta.add_argument("--repo", default=".")
   571	    p_delta.add_argument("--tag", required=True)
   572	    p_delta.add_argument("--verdict", default=None)
   573	
   574	    args = parser.parse_args(argv)
   575	    if args.cmd == "ancestry":
   630	            echo "::error::.claude/trust/owner.asc is empty — release gate cannot verify tag signature"
   631	            exit 1
   632	          fi
   633	          if ! gpg --show-keys .claude/trust/owner.asc >/dev/null 2>&1; then
   634	            echo "::error::.claude/trust/owner.asc is not a valid PGP public-key block"
   635	            exit 1
   636	          fi
   637	          echo "OK: owner.asc is populated and parseable"
   638	
   639	      - name: Verify tag GPG signature
   640	        # PLAN-044 audit-v2 C2-P0-02 — activated Wave A 2026-04-27 (Owner pubkey at .claude/trust/owner.asc; PLAN-063 round-4: removed `if: true` per actionlint if-cond)
   641	        run: |
   642	          gpg --import .claude/trust/owner.asc
   643	          git tag --verify ${{ github.ref_name }}
   644	
   645	      # ==========================================================
   646	      # PLAN-081 Phase 6-bis — Pair-Rail verdict gate (step 15)
   647	      # ==========================================================
   648	      # R1 S-Sec-3 (replay defense) + R1 S-Sec-4 (deterministic inputs_hash)
   649	      # + R1 C5 (Codex CLI pin enforcement) + R1 S-QA-Unseen-2 (distinct
   650	      # VERDICT_EXPIRED exit code) + R1 S-CR-Unseen-6 (explicit "step 15 runs
   651	      # after steps 1-14" ordering).
   652	      #
   653	      # S104 redesign: verdict.commit_sha → verdict.parent_sha.
   654	      # The legacy commit_sha bind was an unsolvable self-reference
   655	      # (verdict file cannot declare its own commit SHA — the SHA is only
   656	      # known AFTER the verdict commit lands). v1.16.0 GA bridged via
   657	      # CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 transition mode. The replacement
   658	      # binds to parent_sha — the commit the verdict was generated
   659	      # against (parent of the verdict-file commit). That value is
   660	      # observable + immutable when the verdict is authored.
   661	      #
   662	      # Step 15 asserts:
   663	      #   - verdict.parent_sha == git log -n1 --format=%H -- <verdict-file>^
   664	      #   - verdict.release_tag == ${GITHUB_REF_NAME}  (replay defense)
   665	      #   - verdict.tool_versions.codex_cli in codex-cli-pin.txt range
   666	      #   - verdict.tool_versions.codex_payload_sha256 (+ codex_target_triple)
   667	      #     == codex-cli-pin-manifest.json payloads[<triple>].sha256
   668	      #     (ADR-182 payload pin — the sha of the NATIVE codex payload,
   669	      #     not the npm JS launcher; PLAN-163 T5.2. The legacy
   670	      #     codex_cli_binary_sha256 launcher pin is retained only for
   671	      #     pre-ADR-182 tags; its pin file is a comment-only tombstone,
   672	      #     which the validator treats as "no launcher pin".)
   673	      #   - verdict generated_at within 24h (TTL per ADR-103)
   674	      #   - inputs_hash deterministically recomputed via inputs-hash-manifest.txt
   675	      #   - GPG signature present + verifies against owner.asc
   676	      #
   677	      # continue-on-error: ONLY when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 env
   678	      # explicitly set (e.g. legacy rc tags pre-verdict-rollout). Default is
   679	      # hard-block on any validator failure.
   680	      - name: Validate pair-rail verdict (PLAN-081 Phase 6-bis step 15)
   681	        env:
   682	          # Codex iter-8 P1 fix: source the env var from a repository
   683	          # variable so the `continue-on-error` expression has something
   684	          # to evaluate against. Owner sets via `gh variable set
   685	          # CEO_PAIR_RAIL_VERDICT_OPTIONAL --body 1` for transition mode
   686	          # (e.g. legacy v1.16.0-era verdicts shipping only commit_sha:);
   687	          # unset / 0 = hard-block (default).
   688	          CEO_PAIR_RAIL_VERDICT_OPTIONAL: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL || '0' }}
