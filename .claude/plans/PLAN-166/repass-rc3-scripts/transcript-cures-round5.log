   145	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   146	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   147	    if not pin_file.exists():
   148	        return None, None
   149	    for line in pin_file.read_text().splitlines():
   150	        line = line.split("#", 1)[0].strip()
   151	        if not line:
   152	            continue
   153	        # parse `>=X.Y.Z,<A.B.C` shape
   154	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   155	        if m:
   156	            return m.group(1), m.group(2)
   157	    return None, None
