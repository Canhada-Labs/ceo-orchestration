   802	            exit 1
   803	          fi
   804	          # (2) Independent parent_sha bind — non-empty by construction,
   805	          # controlled by no variable. Same derivation as step 15 (parent
   806	          # of the commit that introduced the verdict file); the verdict
   807	          # field is read with the SAME parser the local tag guard uses
   808	          # (_parse_verdict), so two readers of the same signed file
   809	          # cannot disagree about what it says.
   810	          VERDICT_FILE_COMMIT="$(git log -n1 --format=%H -- "$VERDICT_FILE")"
   811	          if [ -z "$VERDICT_FILE_COMMIT" ]; then
   812	            echo "::error::cannot resolve the commit that introduced $VERDICT_FILE — refusing an empty bind"
   813	            exit 1
   814	          fi
   815	          PARENT_SHA="$(git rev-parse "${VERDICT_FILE_COMMIT}^" 2>/dev/null || echo "")"
   816	          if [ -z "$PARENT_SHA" ]; then
   817	            echo "::error::cannot resolve parent of ${VERDICT_FILE_COMMIT} — refusing an empty bind"
   818	            exit 1
   819	          fi
   820	          python3 - "$VERDICT_FILE" "$PARENT_SHA" <<'PYBIND'
   821	          import importlib.util
   822	          import io
   823	          import re
   824	          import sys
   825	
   826	          verdict_path, expected = sys.argv[1], sys.argv[2]
   827	          if not re.match(r"\A[0-9a-f]{40}\Z", expected):
   828	              sys.exit("FAIL: derived parent %r is not a 40-hex SHA" % expected)
   829	          spec = importlib.util.spec_from_file_location(
   830	              "release_tag_guard", ".claude/scripts/local/_release_tag_guard.py"
   831	          )
   832	          mod = importlib.util.module_from_spec(spec)
   833	          spec.loader.exec_module(mod)
   834	          with io.open(verdict_path, encoding="utf-8") as fh:
   835	              fields = mod._parse_verdict(fh.read())
   836	          declared = fields.get("parent_sha")
   837	          if declared != expected:
   838	              sys.exit(
   839	                  "FAIL: verdict parent_sha %r != parent of the verdict-file "
   840	                  "commit (%s) — the anchor was not validated with a "
   841	                  "non-empty bind; a legacy commit_sha fallback does NOT "
   842	                  "count here." % (declared, expected)
   843	              )
   844	          print("  ok   parent_sha bind: %s (derived independently of step 15)" % expected)
   845	          PYBIND
   846	          # (3) DELTA (r15): git diff <reviewed parent>..<tag commit>
   847	          # must be contained in the CLOSED set pinned in the signed
   848	          # verdict — exact names per tag (never the pair-rail-verdict-*
   849	          # wildcard, never repass-<N>/**), set equality against the
   850	          # evidence MANIFEST.sha256, AND content equality (the verdict
   851	          # pins the manifest's sha256; the guard runs `shasum -c` over
   852	          # it). Any extra path = FAIL. Decision logic lives in the local
   853	          # tag guard module — reused, never re-implemented in bash.
   854	          python3 .claude/scripts/local/_release_tag_guard.py delta \
   855	            --repo . --tag "$TAG"
   856	          # (4) ANCESTRY (r17+r18): both the reviewed parent AND the
   857	          # tagged commit itself must be ancestors of origin/main. The
   858	          # module's ancestry subcommand judges HEAD (== GITHUB_SHA,
   859	          # asserted in (1)) after a FAIL-CLOSED fetch of origin/main —
   860	          # a failed fetch is a stop, never a stale-ref approval. The
   861	          # reviewed parent is then judged against the same freshly
   862	          # fetched ref.
   863	          python3 .claude/scripts/local/_release_tag_guard.py ancestry \
   864	            --repo . --remote origin --branch main
   865	          if git merge-base --is-ancestor "$PARENT_SHA" origin/main; then
   866	            echo "  ok   reviewed parent $PARENT_SHA is an ancestor of origin/main"
   867	          else
   868	            RC=$?
   869	            echo "::error::reviewed parent $PARENT_SHA is not on origin/main (merge-base exit $RC) — the verdict is anchored on a commit main never saw (tag-without-push / orphan-verdict scenario, r17+r18)"
   870	            exit 1
   871	          fi
   872	          echo "OK: verdict delta + ancestry asserts all green for $TAG"
   873	
   874	  publish-release:
   875	    name: Publish GitHub Release + assets
   876	    needs: release-gate
   877	    runs-on: ubuntu-latest
   878	    permissions:
   879	      contents: write
   880	    steps:
   881	      - name: Checkout tag
   882	        # SHA-pinned: actions/checkout@v6.0.2
   883	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   884	        with:
   885	          fetch-depth: 0
   886	      - name: Setup Python 3.11
   887	        # SHA-pinned: actions/setup-python@v6.2.0
   888	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
   889	        with:
   890	          python-version: "3.11"
   891	      - name: Compute install.sh.sha256 (body excluding self-SHA trailer)
   892	        run: |
   893	          set -euo pipefail
   894	          FILE="scripts/install.sh"
   895	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
   896	          printf '%s  install.sh\n' "$HASH" > install.sh.sha256
   897	          echo "install.sh.sha256 = $HASH"
   898	      - name: Generate CycloneDX SBOM
   899	        run: |
   900	          set -euo pipefail
   901	          python3 .claude/scripts/generate-sbom.py --output sbom.cyclonedx.json
   902	      # -----------------------------------------------------------------
   903	      # PLAN-153 Wave B item 5 (d) — templatized release notes.
   904	      # Closes PLAN-152 §Deferred `release-notes-hardcoded-first-release`:
   905	      # the notes string used to hardcode a v1.0.0-only launch sentence,
   906	      # stale for every later tag. Notes are now rendered from
   907	      # `.github/release-notes-template.md` with {{TAG}} / {{VERSION}} /
   908	      # {{BASE_VERSION}} interpolation (BASE_VERSION = VERSION with any
   909	      # -rc.N suffix stripped, so RC notes point at the GA CHANGELOG
   910	      # section). Fail-closed on a missing template or an unrendered
   911	      # placeholder.
   912	      # -----------------------------------------------------------------
   913	      - name: Render release notes from template
   914	        run: |
   915	          set -euo pipefail
   916	          TAG="${GITHUB_REF_NAME}"
   917	          VERSION="${TAG#v}"
   918	          BASE_VERSION="${VERSION%-rc.[0-9]*}"
   919	          TEMPLATE=".github/release-notes-template.md"
   920	          if [[ ! -f "$TEMPLATE" ]]; then
   921	            echo "::error::release-notes template missing at $TEMPLATE"
   922	            exit 1
   923	          fi
   924	          sed -e "s/{{TAG}}/${TAG}/g" \
   925	              -e "s/{{VERSION}}/${VERSION}/g" \
   926	              -e "s/{{BASE_VERSION}}/${BASE_VERSION}/g" \
   927	              "$TEMPLATE" > release-notes.md
   928	          if grep -q '{{' release-notes.md; then
   929	            echo "::error::unrendered placeholders remain in release-notes.md"
   930	            exit 1
   931	          fi
   932	          echo "Rendered release notes:"
   933	          cat release-notes.md
   934	
   935	      # -----------------------------------------------------------------
   936	      # PLAN-153 Wave B item 5 (b) — idempotent release creation
   937	      # (`gh release view || gh release create`). A re-run of this job
   938	      # (workflow re-run, transient asset-upload failure) must not fail
   939	      # on an existing release: if the release already exists we
   940	      # re-sync the assets with `--clobber` and succeed-as-noop —
     1	#!/usr/bin/env bash
     2	# ============================================================================
     3	# release.sh — operator release driver. Version-neutral BY NAME.
     4	#
     5	# The previous driver carried a release number in its own FILENAME, and was
     6	# still driving the release after that one — the root of a whole class: a
     7	# driver named for one release is a standing invitation for every other version
     8	# literal inside it to go stale too. Everything release-specific now lives in
     9	# the PER-RELEASE block below, and every message derives from it. The old path
    10	# is deliberately left unspelled on every live surface, so the AC-6 control
    11	# needs no "except this one" exemption; `git log --follow` is the archaeology.
    12	#
    13	# Implements the documented procedure in `.github/release-checklist.md`:
    14	# RC first (vX.Y.Z-rc.N), then the ADR-103 24 h hold, then promote stable.
    15	#
    16	# WHAT THE OWNER SIGNS. Nothing here is a canonical-edit ceremony: CHANGELOG.md,
    17	# VERSION and npm/package.json are NOT in `_CANONICAL_GUARDS`
    18	# (`.claude/hooks/check_canonical_edit.py`), so no sentinel `approved.md`
    19	# exists for a release. The Owner signature is the **annotated GPG tag**,
    20	# produced INLINE by the `tag` phase (family lesson: a ceremony script signs
    21	# inline and never demands a pre-existing `.asc`).
    22	#
    23	# WHAT THIS SCRIPT NEVER DOES. It never pushes, and it never publishes.
    24	# Pushing the tag is the irreversible, outward-facing step: it starts BOTH
    25	# `.github/workflows/release.yml` (the release gate) and
    26	# `.github/workflows/npm-publish.yml` — and npm-publish.yml is what actually
    27	# publishes to npm via OIDC. This driver prints the push command and stops.
    28	#
    29	# Phases (run in order):
    30	#   preflight  read-only gates, fail-closed          (default)
    31	#   bump       version sites + plugin manifests + commit
    32	#   tag        annotated GPG tag, signed inline, behind two fail-closed guards
    33	#
    34	# Usage:
    35	#   bash .claude/scripts/local/release.sh preflight
    36	#   bash .claude/scripts/local/release.sh bump --dry-run
    37	#   bash .claude/scripts/local/release.sh bump
    38	#   bash .claude/scripts/local/release.sh tag --dry-run
    39	#   bash .claude/scripts/local/release.sh tag
    40	#
    41	# Options:
    42	#   --dry-run        make no lasting change; restores BOTH working tree and
    43	#                    index on exit (trap), including on failure. The restore
    44	#                    list is DERIVED from _release_bump_sites.py, never typed.
    45	#   --stable         target the bare version instead of -rc.N (post-hold promote)
    46	#   --rc N           RC ordinal (default 1)
    47	#   --key KEYID      GPG key to sign with (default: the key of the last release)
    48	#   --today DATE     YYYY-MM-DD stamped into the `last-reviewed:` lines
    49	#                    (default: today). It exists so the D/D+1 idempotence
    50	#                    invariant is testable at the driver level; it changes only
    51	#                    the stamp date and skips no gate.
    52	#   --restamp        force the four `last-reviewed:` stamps to move even when
    53	#                    the version is unchanged — the named route for a REAL
    54	#                    re-review. Requires --npm-readme-reviewed and disables the
    55	#                    no-op fast path (otherwise it would be dead letter).
    56	#   --offline-ack    ancestry guard: skip the `git fetch` and judge HEAD
    57	#                    against the last-known origin/main (announced loudly)
    58	#   --npm-readme-reviewed
    59	#                    required by `bump` when it writes: acknowledges that
    60	#                    npm/README.md was actually re-read. Its `last-reviewed`
    61	#                    stamp is a release tripwire by design; re-stamping it
    62	#                    silently would defeat the gate.
    63	# ============================================================================
    64	set -euo pipefail
    65	
    66	# ---------------------------------------------------------------------------
    67	# PER-RELEASE — the only block that changes between releases. Rewrite all of it
    68	# together. RELEASE_SCOPE and RELEASE_HEADLINE end up inside the SIGNED tag
    69	# annotation, so stale text there is a false claim on a signed surface (the P0
    70	# class of this repo) — and no preflight can prove prose matches a diff.
