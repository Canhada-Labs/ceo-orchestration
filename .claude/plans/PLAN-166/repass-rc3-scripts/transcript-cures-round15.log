+      [ "$_hit" -eq 1 ] && break
+    done <<ALLOW
+$COMMIT1_ALLOW
+ALLOW
+    [ "$_hit" -eq 1 ] || _bad="$_bad
+   $_path"
+  done <<STATUS
+$_st_out
+STATUS
+  [ -z "$_bad" ] || die "arquivo(s) FORA da allowlist do commit 1 (nao revisados pelo rail):$_bad
+Remova/stash antes de cortar, ou me chame no Claude."
+}
