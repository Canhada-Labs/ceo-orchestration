     1	#!/usr/bin/env python3
     2	"""validate-pair-rail-verdict.py — PLAN-081 Phase 6 release.yml step 15.
     3	
     4	Validates a Pair-Rail verdict artifact (`.claude/governance/
     5	pair-rail-verdict-<release-tag>.md`) per R1 S-Sec-3 replay defense +
     6	R1 S-Sec-4 inputs_hash determinism + R1 C5 Codex CLI pin enforcement
     7	+ R1 S-QA-Unseen-2 distinct VERDICT_EXPIRED exit code.
     8	
     9	## Usage
    10	
    11	    python3 .github/scripts/validate-pair-rail-verdict.py \\
    12	      --verdict-file .claude/governance/pair-rail-verdict-${GITHUB_REF_NAME}.md \\
    13	      --parent-sha ${PARENT_SHA} \\
    14	      --release-tag ${GITHUB_REF_NAME} \\
    15	      --max-age-hours 24 \\
    16	      --recompute-inputs-hash \\
    17	      --codex-cli-pin-file .claude/governance/codex-cli-pin.txt \\
    18	      --codex-pin-manifest-file .claude/governance/codex-cli-pin-manifest.json \\
    19	      --inputs-hash-paths-file .claude/governance/pair-rail-inputs-hash-manifest.txt
    20	
    21	## ADR-182 payload pin (PLAN-163 T5.2)
    22	
    23	`--codex-pin-manifest-file` enforces the payload pin: the verdict
    24	envelope MUST declare `tool_versions.codex_target_triple` (the platform
    25	triple of the run that generated the verdict) and
    26	`tool_versions.codex_payload_sha256` (sha256 of the NATIVE codex
    27	payload for that triple — NOT the npm JS launcher). The validator
    28	compares the declared sha against
    29	`manifest.payloads[<triple>].sha256`. Fail-CLOSED: missing fields,
    30	triple absent from the manifest, malformed entry, or sha mismatch →
    31	VERDICT_INVALID (3). Manifest file unreadable → infra (1). The legacy
    32	`--codex-cli-binary-sha256-file` launcher-hash pin is retained only for
    33	pre-ADR-182 tags; the live pin file is a comment-only tombstone, which
    34	that legacy path treats as "no pin" (skip).
    35	
    36	## parent_sha vs commit_sha (S104 redesign)
    37	
    38	The legacy `--commit-sha` arg + verdict `commit_sha:` field bound the
    39	verdict to a SHA the verdict commit itself produced — an unsolvable
    40	self-reference (`pair-rail-verdict-vX.md` cannot declare its own commit
    41	SHA because that SHA is only known AFTER the verdict file is committed).
    42	The v1.16.0 GA ceremony bridged this via `CEO_PAIR_RAIL_VERDICT_OPTIONAL=1`
    43	transition mode, which silently disabled the bind.
    44	
    45	`parent_sha:` solves it cleanly. The verdict declares the commit it was
    46	generated AGAINST (the parent of the verdict-file commit). That value is
    47	known when the verdict is authored (it's `git rev-parse HEAD` before the
    48	verdict commit). Step 15 validates against `git log -n1 --format=%H --
    49	<verdict-file>` parent, which is observable + immutable.
    50	
    51	Backward-compat: when only `commit_sha:` (legacy) is present and
    52	`--parent-sha` is empty, the bind is skipped with an ADVISORY (matches
    53	prior CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 behavior). Legacy verdicts for
    54	already-shipped tags (v1.16.0 etc.) keep their existing semantics; new
    55	verdicts use `parent_sha:`.
    56	
    57	## Exit codes
    58	
    59	- 0: verdict valid; release proceeds.
    60	- 1: infra error (file missing / unparseable / etc.); release.yml
    61	     decides based on CEO_PAIR_RAIL_VERDICT_OPTIONAL.
    62	- 2: VERDICT_EXPIRED — distinct from infra-error per R1 S-QA-Unseen-2.
    63	     Release.yml can route this to a "verdict regen" branch.
    64	- 3: VERDICT_INVALID — release_tag mismatch / parent_sha mismatch /
    65	     inputs_hash mismatch / pin mismatch / signature missing. Release
    66	     MUST stop here.
    67	
    68	stdlib only. Python ≥3.9.
    69	"""
    70	
    71	from __future__ import annotations
    72	
    73	import argparse
    74	import hashlib
    75	import json
    76	import re
    77	import subprocess
    78	import sys
    79	from datetime import datetime, timezone
    80	from pathlib import Path
    81	from typing import Any, Dict, List, Optional, Tuple
    82	
    83	EXIT_OK = 0
    84	EXIT_INFRA_ERROR = 1
    85	EXIT_VERDICT_EXPIRED = 2
    86	EXIT_VERDICT_INVALID = 3
    87	
    88	
    89	def parse_verdict_file(path: Path) -> Dict[str, Any]:
    90	    """Parse YAML frontmatter from a verdict file. Returns dict."""
    91	    if not path.exists():
    92	        raise FileNotFoundError(f"verdict file: {path}")
    93	    text = path.read_text(encoding="utf-8")
    94	    # Look for ```yaml ... ``` block
    95	    m = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
    96	    if not m:
    97	        raise ValueError("verdict file missing yaml frontmatter block")
    98	    yaml_body = m.group(1)
    99	    # Inline minimal YAML parse (stdlib only)
   100	    out: Dict[str, Any] = {}
   101	    current_key: Optional[str] = None
   102	    for raw in yaml_body.splitlines():
   103	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   104	        if not line.strip():
   105	            continue
   106	        if line[0] not in (" ", "\t"):
   107	            if ":" in line:
   108	                k, _, v = line.partition(":")
   109	                v = v.strip()
   110	                if v:
   111	                    out[k.strip()] = v
   112	                else:
   113	                    out[k.strip()] = {}
   114	                    current_key = k.strip()
   115	        elif current_key and ":" in line:
   116	            sub_k, _, sub_v = line.partition(":")
   117	            if isinstance(out[current_key], dict):
   118	                out[current_key][sub_k.strip()] = sub_v.strip()
   119	    return out
   120	
   121	
   122	def compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:
   123	    """Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4)."""
   124	    if not manifest_path.exists():
   125	        raise FileNotFoundError(f"manifest: {manifest_path}")
   126	    paths = []
   127	    for line in manifest_path.read_text().splitlines():
   128	        line = line.split("#", 1)[0].strip()
   129	        if line:
   130	            paths.append(line)
   131	    paths.sort()
   132	    hashes = {}
   133	    for p in paths:
   134	        result = subprocess.run(
   135	            ["git", "hash-object", p],
   136	            capture_output=True, text=True, cwd=str(repo_root), timeout=10,
   137	        )
   138	        if result.returncode != 0:
   139	            raise ValueError(f"git hash-object failed for {p}: {result.stderr}")
   140	        hashes[p] = result.stdout.strip()
   141	    canon = json.dumps(hashes, sort_keys=True, separators=(",", ":"))
   142	    return hashlib.sha256(canon.encode("utf-8")).hexdigest()
   143	
   144	
   145	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   146	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   147	    if not pin_file.exists():
   148	        return None, None
   149	    for line in pin_file.read_text().splitlines():
   150	        line = line.split("#", 1)[0].strip()
   151	        if not line:
   152	            continue
   153	        # parse `>=X.Y.Z,<A.B.C` shape
   154	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   155	        if m:
   156	            return m.group(1), m.group(2)
   157	    return None, None
   158	
   159	
   160	def parse_semver(s: str) -> Tuple[int, int, int]:
   161	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   162	    if not m:
   163	        raise ValueError(f"unparseable semver: {s!r}")
   164	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   165	
   166	
   167	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   168	    try:
   169	        v = parse_semver(version)
   170	        lo = parse_semver(min_v)
   171	        hi = parse_semver(max_v)
   172	        return lo <= v < hi
   173	    except ValueError:
   174	        return False
   175	
