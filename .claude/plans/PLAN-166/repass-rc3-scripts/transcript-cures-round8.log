   432	                file=sys.stderr,
   433	            )
   434	            return EXIT_VERDICT_INVALID
   435	        if (
   436	            not isinstance(manifest, dict)
   437	            or manifest.get("schema") != 1
   438	            or not isinstance(manifest.get("payloads"), dict)
   439	        ):
