   433	            )
   434	            return EXIT_VERDICT_INVALID
   435	        if (
   436	            not isinstance(manifest, dict)
   437	            or manifest.get("schema") != 1
   438	            or not isinstance(manifest.get("payloads"), dict)
   439	        ):
   440	            print(
   441	                "INVALID: codex-pin-manifest-file schema violation "
   442	                "(expected schema=1 + payloads dict) — fail-CLOSED per "
   443	                "ADR-182",
   444	                file=sys.stderr,
   445	            )
   446	            return EXIT_VERDICT_INVALID
   447	        tool_versions = verdict.get("tool_versions", {})
   448	        if not isinstance(tool_versions, dict):
   449	            print(
   450	                f"INVALID: tool_versions field must be a dict for "
   451	                f"payload-pin check, got "
   452	                f"{type(tool_versions).__name__}: {tool_versions!r}",
   453	                file=sys.stderr,
   454	            )
   455	            return EXIT_VERDICT_INVALID
   456	        declared_triple = str(
   457	            tool_versions.get("codex_target_triple", "")
   458	        ).strip()
   459	        declared_payload_sha = str(
   460	            tool_versions.get("codex_payload_sha256", "")
   461	        ).strip()
   462	        if not declared_triple or not declared_payload_sha:
   463	            print(
   464	                "INVALID: ADR-182 payload pin requested "
   465	                f"(manifest='{manifest_path}') but verdict envelope "
   466	                "lacks tool_versions.codex_target_triple and/or "
   467	                "tool_versions.codex_payload_sha256",
   468	                file=sys.stderr,
   469	            )
   470	            return EXIT_VERDICT_INVALID
   471	        entry = manifest["payloads"].get(declared_triple)
   472	        if not isinstance(entry, dict):
   473	            print(
