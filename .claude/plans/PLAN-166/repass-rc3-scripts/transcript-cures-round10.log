+bash .claude/scripts/local/release.sh preflight --stable
+bash .claude/scripts/local/release.sh bump --stable
+bash .claude/scripts/local/release.sh tag --stable
+
+fi
+
+if [ "$MONITOR_ONLY" -eq 0 ]; then
