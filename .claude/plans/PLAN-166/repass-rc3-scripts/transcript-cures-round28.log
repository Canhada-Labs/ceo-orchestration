+say "6/7 push + espera CI (15-40 min; deixe rodando)"
+git push origin main
+HEADSHA="$(git rev-parse HEAD)"
+i=0
+while :; do
+  i=$((i+1)); [ "$i" -le 90 ] || die "CI nao terminou em 90 min"
