    82	on:
    83	  push:
    84	    tags:
    85	      - "v*"
    86	
    87	concurrency:
    88	  group: npm-publish-${{ github.ref }}
    89	  cancel-in-progress: false
    90	
    91	permissions:
    92	  contents: read
    93	  id-token: write   # required for OIDC trusted publishing + provenance
    94	
    95	jobs:
    96	  # ---------------------------------------------------------------------
    97	  # PLAN-166 W1 item 1 (F1, P0) — OBSERVE THE GOVERNANCE GATE.
    98	  # This job is the machine evidence that release.yml's `release-gate`
    99	  # job passed for this exact tag+SHA+push. It deliberately carries NO
   100	  # `environment:` and NO RC exclusion: it runs on rc tags too, which
   101	  # makes every RC a live positive control of the gate before GA ever
   102	  # depends on it.
   103	  # Decision function + battery: .claude/scripts/await_release_gate.py,
   104	  # .claude/scripts/tests/test_await_release_gate.py.
   105	  await-release-gate:
   106	    name: Await release-gate (release.yml)
   107	    runs-on: ubuntu-latest
   108	    # 50 > the poller's own 45-minute deadline, so a timeout surfaces as
   109	    # the decision function's fail-CLOSED BLOCK (with its inputs printed),
   110	    # not as an opaque runner kill. 45 min > the release-gate's own
   111	    # 35-minute timeout-minutes with margin (rail rc.3 r1 P1-3): the
   112	    # observer must always outlive the producer, or a gate finishing in
   113	    # minutes 31-35 goes green while the waiter already gave up.
   114	    timeout-minutes: 50
   115	    permissions:
   116	      contents: read   # checkout the tag to get the decision script
   117	      actions: read    # read release.yml's runs + jobs over the REST API
   118	    env:
   119	      # `permissions:` alone does NOT authenticate the `gh` CLI on a
   120	      # hosted runner. Without GH_TOKEN every poll dies on auth, which is
   121	      # BLOCK (fail-closed) — i.e. it would break EVERY release, RC and
   122	      # GA alike. This token is the job's only credential; the job has no
   123	      # id-token and no environment.
   124	      GH_TOKEN: ${{ github.token }}
   125	    steps:
   126	      - name: Checkout tag
   127	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   128	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   129	
   130	      - name: Poll release.yml until release-gate concludes
   131	        # No `${{ }}` interpolation inside this script by design — every
   132	        # value arrives through the environment, so no workflow expression
   133	        # is ever spliced into shell text.
   134	        run: |
   135	          set -euo pipefail
   136	          TAG="${GITHUB_REF_NAME}"
   137	          DEADLINE=$(( $(date +%s) + 2700 ))
   138	          SELF_CREATED_AT="$(gh api \
   139	            "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}" \
   140	            --jq '.created_at' < /dev/null)"
   141	          echo "inputs: tag=${TAG} head_sha=${GITHUB_SHA} run_id=${GITHUB_RUN_ID}"
   142	          echo "inputs: self_created_at=${SELF_CREATED_AT} deadline_epoch=${DEADLINE}"
   143	
   144	          fetch_payload() {
   145	            # One document: every run for THIS head_sha, each carrying its
   146	            # jobs. A run whose jobs endpoint is unreadable keeps no `jobs`
   147	            # key — the decision function reads that as WAIT, never GRANT.
   148	            if ! gh api --paginate \
   149	                "repos/${GITHUB_REPOSITORY}/actions/runs?head_sha=${GITHUB_SHA}&per_page=100" \
   150	                --jq '.workflow_runs[] | {id, run_attempt, path, event, head_branch, head_sha, created_at, status, conclusion}' \
   151	                > runs.ndjson < /dev/null; then
   152	              # An API error is BLOCK by design (ADR-186: input we cannot
   153	              # verify is blocked, not waved through).
   154	              echo '{"api_error": "runs listing failed"}' > payload.json
   155	              return 0
   156	            fi
   157	            : > runs_with_jobs.ndjson
   158	            while read -r run; do
   159	              [ -n "${run}" ] || continue
   160	              rid="$(printf '%s' "${run}" | jq -r '.id')"
   161	              if ! run_jobs="$(gh api \
   162	                  "repos/${GITHUB_REPOSITORY}/actions/runs/${rid}/jobs?per_page=100" \
   163	                  --jq '[.jobs[] | {name, status, conclusion}]' < /dev/null)"; then
   164	                printf '%s\n' "${run}" >> runs_with_jobs.ndjson
   165	                continue
   166	              fi
   167	              printf '%s' "${run}" \
   168	                | jq -c --argjson jobs "${run_jobs}" '. + {jobs: $jobs}' \
   169	                >> runs_with_jobs.ndjson
   170	            done < runs.ndjson
   171	            jq -c -s '{workflow_runs: .}' runs_with_jobs.ndjson > payload.json
   172	          }
   173	
   174	          attempt=0
   175	          while true; do
   176	            attempt=$(( attempt + 1 ))
   177	            fetch_payload
   178	            set +e
   179	            python3 .claude/scripts/await_release_gate.py \
   180	              --payload-file payload.json \
   181	              --tag "${TAG}" \
   182	              --head-sha "${GITHUB_SHA}" \
   183	              --self-created-at "${SELF_CREATED_AT}" \
   184	              --deadline-epoch "${DEADLINE}"
   185	            rc=$?
   186	            set -e
   187	            case "${rc}" in
   188	              0)
   189	                echo "::notice::release-gate green for ${TAG} at ${GITHUB_SHA} — publish authorised (poll ${attempt})"
   190	                exit 0
   191	                ;;
   192	              3)
   193	                sleep 20
   194	                ;;
   195	              *)
   196	                echo "::error::release-gate did not authorise this publish (decision exit ${rc}, poll ${attempt}) — the printed inputs above name the run and job that were evaluated"
   197	                exit 1
   198	                ;;
   199	            esac
   200	          done
