   181	          fi
   182	
   183	      # -----------------------------------------------------------------
   184	      # Step: Contamination check (project-specific refs outside allowed zones)
   185	      #
   186	      # Uses `git ls-files` so that (a) .gitignore is honored, (b) .git/
   187	      # is not descended into, (c) path anchoring is stable across runners.
   188	      # NFKC-normalizes each file before grepping to catch Unicode homoglyph
   189	      # attempts.
   190	      # -----------------------------------------------------------------
   191	      - name: Contamination check (no private-project/personal refs outside allowlist)
   192	        run: bash .claude/scripts/check-contamination.sh
   193	
   194	      # -----------------------------------------------------------------
   195	      # Step: Placeholder lint — no unfilled {{PLACEHOLDERS}} beyond the
   196	      # known template set in core/frontend skills.
   197	      # -----------------------------------------------------------------
   198	      - name: Placeholder lint (core/frontend skills only)
   199	        run: |
   200	          set -euo pipefail
   201	          # Known template placeholders we ship with (expected in template text).
   202	          ALLOWED='PROJECT_NAME|PROJECT_PATH|OWNER_NAME|DOMAIN|PRODUCTION_URL|APP_NAME|BACKEND_URL|FRONTEND_REPO_PATH|FOUNDER_NAME|CITY|COUNTRY|LEGAL_ID|STACK|DEPLOY_TARGET|DEPLOY_COMMAND|DATABASE|RUNTIME_NOTES|FILE_COUNT|LINES|TEST_COUNT|TEST_TOOL|LINT_TOOL|CI_TOOL|ARCHITECTURE_DIAGRAM|NUMERIC_RULES|ARCHITECTURE_RULES|SECURITY_RULES|ENDPOINT_LIST|DB_TABLES|ENV_VAR_COUNT|FRONTEND_PATH'
   203	          FOUND=$(grep -rhoE '\{\{[A-Z_][A-Z0-9_]*\}\}' .claude/skills/core .claude/skills/frontend 2>/dev/null | sort -u || true)
   204	          UNKNOWN=$(printf '%s\n' "$FOUND" | grep -vE "^\{\{($ALLOWED)\}\}$" || true)
   205	          if [ -n "$UNKNOWN" ]; then
   206	            echo "❌ Unknown {{PLACEHOLDERS}} in core/frontend skills:"
   207	            printf '%s\n' "$UNKNOWN"
   208	            echo ""
   209	            echo "Either fill the placeholder, replace with archetype text, or add it"
   210	            echo "to the ALLOWED list in .github/workflows/validate.yml (only if it is"
   211	            echo "genuinely a shared template variable)."
   212	            exit 1
   213	          fi
   214	          echo "✓ Only known placeholders present in core/frontend skills"
   215	
   216	      # -----------------------------------------------------------------
   217	      # Step: Function-length advisory (PLAN-044 audit-v2 R4 P1 #12)
   218	      #
   219	      # Reports functions >=50 LoC in `.claude/` Python files without
   220	      # `# justified: <reason >=10 chars>` comment. Advisory only --
   221	      # CI exits 0 regardless. Adopters who want a strict gate run
