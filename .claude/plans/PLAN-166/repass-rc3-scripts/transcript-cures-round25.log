   688	          CEO_PAIR_RAIL_VERDICT_OPTIONAL: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL || '0' }}
   689	        continue-on-error: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL == '1' }}
   690	        run: |
   691	          set -euo pipefail
   692	          VERDICT_FILE=".claude/governance/pair-rail-verdict-${GITHUB_REF_NAME}.md"
   693	          if [ ! -f "$VERDICT_FILE" ]; then
   694	            if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL:-0}" = "1" ]; then
   695	              echo "::notice::no verdict file at $VERDICT_FILE; CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 → skipping"
   696	              exit 0
   697	            fi
   698	            echo "::error::verdict file missing at $VERDICT_FILE — step 15 blocks release"
   699	            exit 1
   700	          fi
   701	          # S104 redesign: resolve PARENT_SHA = parent of the verdict-file
   702	          # commit. The tag commit (${GITHUB_SHA}) is what we're releasing,
   703	          # and the verdict file at $VERDICT_FILE either:
   704	          #   (a) was committed in the tag commit itself → parent = ${GITHUB_SHA}^
   705	          #   (b) was committed earlier (multi-commit prep) → parent = git log of file
   706	          # We use (b)'s general form: find the commit that introduced the
   707	          # current verdict file, then take its parent. This handles both
   708	          # single-commit-with-verdict and multi-commit-prep flows.
   709	          VERDICT_FILE_COMMIT=$(git log -n1 --format=%H -- "$VERDICT_FILE")
   710	          if [ -z "$VERDICT_FILE_COMMIT" ]; then
   711	            echo "::error::cannot resolve commit for $VERDICT_FILE — step 15 fails"
   712	            exit 1
   713	          fi
   714	          PARENT_SHA=$(git rev-parse "${VERDICT_FILE_COMMIT}^" 2>/dev/null || echo "")
   715	          if [ -z "$PARENT_SHA" ]; then
   716	            echo "::error::cannot resolve parent of $VERDICT_FILE_COMMIT — step 15 fails"
   717	            exit 1
   718	          fi
   719	          echo "::notice::S104 bind: VERDICT_FILE_COMMIT=$VERDICT_FILE_COMMIT, PARENT_SHA=$PARENT_SHA"
   720	          # When transition mode is on, allow parent_sha mismatch (skip bind)
   721	          # by passing empty string. Default is hard-bind on PARENT_SHA.
   722	          PARENT_SHA_ARG="$PARENT_SHA"
   723	          if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL:-0}" = "1" ]; then
   724	            PARENT_SHA_ARG=""
   725	          fi
   726	          python3 .github/scripts/validate-pair-rail-verdict.py \
   727	            --verdict-file "$VERDICT_FILE" \
   728	            --parent-sha "$PARENT_SHA_ARG" \
   729	            --release-tag "${GITHUB_REF_NAME}" \
   730	            --max-age-hours 24 \
   731	            --recompute-inputs-hash \
   732	            --codex-cli-pin-file .claude/governance/codex-cli-pin.txt \
   733	            --codex-cli-binary-sha256-file .claude/governance/codex-cli-binary-sha256.txt \
   734	            --codex-pin-manifest-file .claude/governance/codex-cli-pin-manifest.json \
   735	            --inputs-hash-paths-file .claude/governance/pair-rail-inputs-hash-manifest.txt
   736	
   737	      # ==========================================================
   738	      # PLAN-166 W1-B — verdict delta + ancestry gate (F2 server side)
   739	      # ==========================================================
   740	      # Re-pass findings r15 + r17 + r18 (PLAN-166), debate r3 scoped VETO.
   741	      #
   742	      # WHY A SEPARATE STEP: the step-15 neighbourhood above carries two
   743	      # escape hatches keyed to CEO_PAIR_RAIL_VERDICT_OPTIONAL —
   744	      # `continue-on-error:` on the step itself, and an empty
   745	      # `--parent-sha ""` bind (the validator only binds the field when
   746	      # args.parent_sha is non-empty). Inheriting that neighbourhood would
   747	      # inherit the switch. This step therefore:
   748	      #   - carries NO continue-on-error;
   749	      #   - FAILS CLOSED when CEO_PAIR_RAIL_VERDICT_OPTIONAL=1: in that
   750	      #     mode step 15 skipped the parent_sha bind, so the anchor these
   751	      #     asserts hang off was never validated — there is no transition
   752	      #     mode here, by design;
   753	      #   - re-derives and re-binds parent_sha ITSELF (non-empty, 40-hex,
   754	      #     equal to the verdict's `parent_sha:` read with the SAME parser
   755	      #     the local tag guard uses) — independent of step 15's outcome,
   756	      #     which also closes the legacy commit_sha fallback (the
   757	      #     validator downgrades a missing parent_sha to an ADVISORY when
   758	      #     a legacy commit_sha is present; this step does not);
   759	      #   - reuses .claude/scripts/local/_release_tag_guard.py for the
   760	      #     delta decision — the module marks itself as the reference
   761	      #     implementation; the semantics are NEVER re-implemented in
   762	      #     bash (single source of the decision logic);
   763	      #   - asserts ancestry on origin/main of BOTH the reviewed parent
   764	      #     AND GITHUB_SHA itself (r18: parent-only lets the
   765	      #     tag-without-push scenario — verdict V over parent P, tag
   766	      #     pushed, V never reaches main — pass with P ancestral and V
   767	      #     orphaned).
   768	      #
   769	      # THE INVARIANT (one sentence): nothing landed after what the
   770	      # re-pass reviewed, other than the verdict for THIS tag and the
   771	      # evidence it pins by name AND content (sha256 of MANIFEST.sha256
   772	      # in the signed verdict + `shasum -c` over the evidence set).
   773	      #
   774	      # PINNED ORDER (asserted structurally by the W1B* classes of
   775	      # test_release_workflow_asserts.py, WaveB5 pattern):
   776	      #   Verify tag GPG signature → Validate pair-rail verdict →
   777	      #   delta → ancestry.
   778	      # Do not reorder, do not merge into step 15.
   779	      - name: Verify verdict delta + ancestry (fail-closed)
   780	        env:
   781	          CEO_PAIR_RAIL_VERDICT_OPTIONAL: ${{ vars.CEO_PAIR_RAIL_VERDICT_OPTIONAL || '0' }}
   782	        run: |
   783	          set -euo pipefail
   784	          # (0) No transition mode: with the var on, the parent_sha bind
   785	          # upstream was skipped — refuse to certify against an
   786	          # unvalidated anchor. Fail closed, loudly.
   787	          if [ "${CEO_PAIR_RAIL_VERDICT_OPTIONAL}" = "1" ]; then
   788	            echo "::error::CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 is set, but the delta+ancestry gate has no transition mode — it fails closed by design (PLAN-166 debate r3). Unset the repo variable (gh variable delete CEO_PAIR_RAIL_VERDICT_OPTIONAL) and re-run."
   789	            exit 1
   790	          fi
   791	          TAG="${GITHUB_REF_NAME}"
   792	          VERDICT_FILE=".claude/governance/pair-rail-verdict-${TAG}.md"
   793	          if [ ! -f "$VERDICT_FILE" ]; then
   794	            echo "::error::no signed verdict at $VERDICT_FILE — the delta+ancestry gate has no optional mode; the re-pass verdict for THIS tag must be committed on the tagged tree."
   795	            exit 1
   796	          fi
   797	          # (1) Checkout sanity: every assert below anchors on HEAD, so
   798	          # HEAD must BE the tagged commit this run is about.
   799	          HEAD_SHA="$(git rev-parse HEAD)"
   800	          if [ "$HEAD_SHA" != "${GITHUB_SHA}" ]; then
   801	            echo "::error::checkout HEAD ($HEAD_SHA) != GITHUB_SHA (${GITHUB_SHA}) — refusing to assert against the wrong tree"
   802	            exit 1
   803	          fi
   804	          # (2) Independent parent_sha bind — non-empty by construction,
   805	          # controlled by no variable. Same derivation as step 15 (parent
   806	          # of the commit that introduced the verdict file); the verdict
   807	          # field is read with the SAME parser the local tag guard uses
   808	          # (_parse_verdict), so two readers of the same signed file
   809	          # cannot disagree about what it says.
   810	          VERDICT_FILE_COMMIT="$(git log -n1 --format=%H -- "$VERDICT_FILE")"
   811	          if [ -z "$VERDICT_FILE_COMMIT" ]; then
   812	            echo "::error::cannot resolve the commit that introduced $VERDICT_FILE — refusing an empty bind"
   813	            exit 1
   814	          fi
   815	          PARENT_SHA="$(git rev-parse "${VERDICT_FILE_COMMIT}^" 2>/dev/null || echo "")"
   816	          if [ -z "$PARENT_SHA" ]; then
   817	            echo "::error::cannot resolve parent of ${VERDICT_FILE_COMMIT} — refusing an empty bind"
   818	            exit 1
   819	          fi
   820	          python3 - "$VERDICT_FILE" "$PARENT_SHA" <<'PYBIND'
   821	          import importlib.util
   822	          import io
   823	          import re
   824	          import sys
   825	
   826	          verdict_path, expected = sys.argv[1], sys.argv[2]
   827	          if not re.match(r"\A[0-9a-f]{40}\Z", expected):
   828	              sys.exit("FAIL: derived parent %r is not a 40-hex SHA" % expected)
   829	          spec = importlib.util.spec_from_file_location(
   830	              "release_tag_guard", ".claude/scripts/local/_release_tag_guard.py"
   831	          )
   832	          mod = importlib.util.module_from_spec(spec)
   833	          spec.loader.exec_module(mod)
   834	          with io.open(verdict_path, encoding="utf-8") as fh:
   835	              fields = mod._parse_verdict(fh.read())
   836	          declared = fields.get("parent_sha")
   837	          if declared != expected:
   838	              sys.exit(
   839	                  "FAIL: verdict parent_sha %r != parent of the verdict-file "
   840	                  "commit (%s) — the anchor was not validated with a "
   841	                  "non-empty bind; a legacy commit_sha fallback does NOT "
   842	                  "count here." % (declared, expected)
   843	              )
   844	          print("  ok   parent_sha bind: %s (derived independently of step 15)" % expected)
   845	          PYBIND
   846	          # (3) DELTA (r15): git diff <reviewed parent>..<tag commit>
   847	          # must be contained in the CLOSED set pinned in the signed
   848	          # verdict — exact names per tag (never the pair-rail-verdict-*
   849	          # wildcard, never repass-<N>/**), set equality against the
   850	          # evidence MANIFEST.sha256, AND content equality (the verdict
   851	          # pins the manifest's sha256; the guard runs `shasum -c` over
   852	          # it). Any extra path = FAIL. Decision logic lives in the local
   853	          # tag guard module — reused, never re-implemented in bash.
   854	          python3 .claude/scripts/local/_release_tag_guard.py delta \
   855	            --repo . --tag "$TAG"
   856	          # (4) ANCESTRY (r17+r18): both the reviewed parent AND the
   857	          # tagged commit itself must be ancestors of origin/main. The
   858	          # module's ancestry subcommand judges HEAD (== GITHUB_SHA,
   859	          # asserted in (1)) after a FAIL-CLOSED fetch of origin/main —
   860	          # a failed fetch is a stop, never a stale-ref approval. The
   861	          # reviewed parent is then judged against the same freshly
   862	          # fetched ref.
   863	          python3 .claude/scripts/local/_release_tag_guard.py ancestry \
   864	            --repo . --remote origin --branch main
   865	          if git merge-base --is-ancestor "$PARENT_SHA" origin/main; then
   866	            echo "  ok   reviewed parent $PARENT_SHA is an ancestor of origin/main"
   867	          else
   868	            RC=$?
   869	            echo "::error::reviewed parent $PARENT_SHA is not on origin/main (merge-base exit $RC) — the verdict is anchored on a commit main never saw (tag-without-push / orphan-verdict scenario, r17+r18)"
   870	            exit 1
   871	          fi
   872	          echo "OK: verdict delta + ancestry asserts all green for $TAG"
   873	
   874	  publish-release:
   875	    name: Publish GitHub Release + assets
   876	    needs: release-gate
   877	    runs-on: ubuntu-latest
   878	    permissions:
   879	      contents: write
   880	    steps:
   881	      - name: Checkout tag
   882	        # SHA-pinned: actions/checkout@v6.0.2
   883	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   884	        with:
   885	          fetch-depth: 0
     1	name: Validate CEO Orchestration governance
     2	
     3	on:
     4	  pull_request:
     5	  push:
     6	    branches: [main]
     7	
     8	# Cancel in-progress runs when a newer commit lands on the same ref.
     9	# Prevents duplicate compute on rapid-fire PR updates and matches the
    10	# devops-ci-cd skill's concurrency-control mandate.
    11	concurrency:
    12	  group: validate-${{ github.ref }}
    13	  cancel-in-progress: true
    14	
    15	# Least-privilege: this workflow only reads the repo to validate.
    16	permissions:
    17	  contents: read
    18	
    19	jobs:
    20	  validate:
    21	    name: Governance, health, contamination, shellcheck
    22	    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity. Job-level `if:` keeps
    23	    # the kill-switch scoped to a single check instead of per-step
    24	    # guards across 18 steps. A repo admin sets `CEO_SOTA_DISABLE=1`
    25	    # as a repo variable to short-circuit without editing YAML.
    26	    if: vars.CEO_SOTA_DISABLE != '1'
    27	    runs-on: Ceo
    28	    # PLAN-014 G.1 ADJ-040 — bumped 5 → 10 to absorb policy-drift + TLA
    29	    # drift + TestEnvContext mandate steps (Phases A.7 + B.7 + C.4)
    30	    # without sporadic CI flakes on slower runners. S166/PLAN-114: 15->25 —
    31	    # validate-governance.sh (47 steps) + lint + pytest + actionlint +
    32	    # contamination + shellcheck legitimately runs ~10-15min; 15 was marginal
    33	    # and timed out (->cancelled) under CI load. Job does not hang; 25 gives headroom.
    34	    timeout-minutes: 25
    35	
    36	    steps:
    37	      - name: Checkout
    38	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
    39	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
    40	
    41	      # -----------------------------------------------------------------
    42	      # Step: Governance structure validation
    43	      # -----------------------------------------------------------------
    44	      - name: Run validate-governance.sh
    45	        run: |
    46	          set -euo pipefail
    47	          bash .claude/scripts/validate-governance.sh
    48	
    49	      # -----------------------------------------------------------------
    50	      # Step: CLAUDE.md drift check (PLAN-045 Wave 3 P0-14)
    51	      #
    52	      # Mechanical gate that asserts numeric claims in CLAUDE.md match
    53	      # disk truth (ADR count, skill count, plan count). Closes the
    54	      # PLAN-044 F-06-01 / F-06-02 / F-06-03 / F-06-06 / F-05-01 /
    55	      # F-15-04 cross-cutting drift finding — previously 6 dimensions
    56	      # independently flagged that CLAUDE.md aspired to numbers the
    57	      # disk did not have.
    58	      #
    59	      # Failure remediation: one-shot CLAUDE.md edit at next session
    60	      # closeout (Gate-1 cache discipline). Run
    61	      # ``python3 .claude/scripts/check-claude-md-claims.py --verbose``
    62	      # locally to see exact claim/disk deltas.
    63	      # -----------------------------------------------------------------
    64	      - name: Run check-claude-md-claims.py
    65	        run: |
    66	          set -euo pipefail
    67	          python3 .claude/scripts/check-claude-md-claims.py
    68	
    69	      # -----------------------------------------------------------------
    70	      # Step: AGENTS.md freshness gate (PLAN-153 Wave A follow-up)
    71	      #
    72	      # AGENTS.md lists the governance entry-point paths coding agents are
    73	      # told to read; check-agents-md.py asserts every listed path exists
    74	      # on disk so the file cannot drift into pointing at moved/deleted
    75	      # files. Static, stdlib-only, NO network, NO credential — safe on
    76	      # fork PRs. Kill-switch: the job-level `if:` CEO_SOTA_DISABLE gate
    77	      # above (per-repo variable) covers this step like every other.
    78	      # Exit contract: 0 fresh / non-zero stale — non-zero fails the job.
    79	      # -----------------------------------------------------------------
    80	      - name: Run check-agents-md.py (AGENTS.md freshness)
    81	        run: |
    82	          set -euo pipefail
    83	          python3 .claude/scripts/check-agents-md.py
    84	
    85	      # -----------------------------------------------------------------
    86	      # Step: Doc skill-path resolves (PLAN-112-FOLLOWUP-install-md-skill-path)
    87	      #
    88	      # Every `.claude/skills/...SKILL.md` literal in INSTALL/README/CLAUDE.md
    89	      # must resolve on disk (or be a documented placeholder / allowlisted).
    90	      # Closes F-4.2 (INSTALL.md once cited a path missing the `core/` tier).
    91	      # -----------------------------------------------------------------
    92	      - name: Run check-doc-skill-paths.sh
    93	        run: |
    94	          set -euo pipefail
    95	          bash .claude/scripts/local/check-doc-skill-paths.sh
    96	
    97	      # -----------------------------------------------------------------
    98	      # Step: Doc count drift — bidirectional + cross-file
    99	      # (PLAN-112-FOLLOWUP-claude-md-count-drift)
   100	      #
   101	      # Every count claim in CLAUDE.md / README.md / INSTALL.md must match
   102	      # the live source of truth (skills total + core/frontend/domain tiers,
   103	      # ADRs, hook .py files, registered hooks, `_lib` modules; tests as an
   104	      # N+ floor). Closes F-3-3.1 / F-4-docs-001. No `paths:` filter — this
   105	      # job runs on every push/PR, so a docs-only PR cannot bypass it (AC4a).
   106	      # `--no-tests` skips the slow pytest-collect floor (the full suite runs
   107	      # in the test jobs; the exact counts here are the load-bearing signal).
   108	      # -----------------------------------------------------------------
   109	      - name: Run verify-counts.sh
   110	        run: |
   111	          set -euo pipefail
   112	          bash .claude/scripts/local/verify-counts.sh --no-tests --quiet
   113	
   114	      # -----------------------------------------------------------------
   115	      # Step: PLAN-135 W5 surface-hygiene advisory (O8/O11/O12). ADVISORY
   116	      # (continue-on-error) — these checks are drift detectors, not gates;
   117	      # a NEW env-var surface / stale rate-card pin / stale substrate ledger
   118	      # is a maintenance signal the maintainer reads, not a build-breaker.
   119	      # NO network + NO paid spend: every probe here is the STATIC mode of
   120	      # its script (no ANTHROPIC_API_KEY needed; runs on fork PRs). The live
   121	      # GET /v1/models per allowlist member is Owner-run only (ceo-info.py
   122	      # --verify-models --live) and is deliberately NOT wired into CI — fork
   123	      # PRs have no credential and CI must not bill.
   124	      # -----------------------------------------------------------------
   125	      - name: PLAN-135 W5 surface-hygiene (advisory, static, no network)
   126	        continue-on-error: true
   127	        run: |
   128	          set -uo pipefail
   129	          echo "::group::verify-models (static — ADR-149 allowlist vs rate card)"
   130	          python3 .claude/scripts/ceo-info.py --verify-models --json || true
   131	          echo "::endgroup::"
   132	          echo "::group::rate-card calibrate (vs ratified fixtures — the S227 stale-pin class)"
   133	          if python3 .claude/scripts/rate-card-calibrate.py --check; then
   134	            echo "rate-card: clean"
   135	          else
   136	            echo "::warning title=rate-card drift::a rate-card pin disagrees with rate-card-fixtures.json (S227 class) — run rate-card-calibrate.py"
   137	          fi
   138	          echo "::endgroup::"
   139	          echo "::group::env-var inventory drift (the S218 footgun class)"
   140	          if [ -f .claude/scripts/env-inventory-check.py ]; then
   141	            if python3 .claude/scripts/env-inventory-check.py --check; then
   142	              echo "env-inventory: clean"
   143	            else
   144	              echo "::warning title=env-var drift::referenced CLAUDE_*/ANTHROPIC_*/CEO_* names drifted from the inventory — run env-inventory-check.py --generate"
   145	            fi
   146	          fi
   147	          echo "::endgroup::"
   148	          echo "::group::substrate watch (Claude Code + SDK changelog ledger)"
   149	          if [ -f .claude/scripts/check-substrate-watch.py ]; then
   150	            if python3 .claude/scripts/check-substrate-watch.py --check; then
   151	              echo "substrate: current"
   152	            else
   153	              echo "::warning title=substrate watch::the substrate-watch ledger is stale or drifted — Owner-run check-substrate-watch.py --refresh"
   154	            fi
   155	          fi
   156	          echo "::endgroup::"
   157	
   158	      # -----------------------------------------------------------------
   159	      # Step: Skill health check (CI mode tolerates stale framework refs)
   160	      # -----------------------------------------------------------------
   161	      - name: Run check-skill-health.sh --ci
   162	        run: |
   163	          set -euo pipefail
   164	          bash .claude/scripts/check-skill-health.sh --ci
   165	
   166	      # -----------------------------------------------------------------
   167	      # Step: Pitfall regression check
   168	      # -----------------------------------------------------------------
   169	      - name: Run check-pitfall-regression.sh
   170	        run: |
   171	          set -euo pipefail
   172	          if [ -x .claude/scripts/check-pitfall-regression.sh ]; then
   173	            bash .claude/scripts/check-pitfall-regression.sh || {
   174	              rc=$?
