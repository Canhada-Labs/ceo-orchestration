### .github/workflows/actionlint.yml
name: actionlint (advisory)

# PLAN-025 Batch G F-wf-008 — actionlint static analysis of .github/workflows/
# to catch shellcheck issues, undefined env vars, missing permissions blocks,
# unpinned actions, etc. BEFORE they hit production workflow runs.
#
# **Mode:** permanent advisory (continue-on-error: true).
#
# PLAN-045 F-08-02 closure (2026-04-22): the "1 green week then flip"
# sunset was proposed but deliberately not enacted. actionlint flags
# stylistic drift (bash exit-code suggestions, `set -euo pipefail`
# preference, etc) that would block legitimate merges without
# material adopter benefit. The check runs on every PR as a
# **reviewer aid**, not a hard gate. To flip to hard-fail, update
# the `continue-on-error` line below + file an ADR documenting
# the stricter stance.

on:
  pull_request:
    paths:
      - ".github/workflows/**"
      - ".github/actions/**"
  push:
    branches: [main]
    paths:
      - ".github/workflows/**"
      - ".github/actions/**"
  workflow_dispatch:

### .github/workflows/adapter-live.yml
name: Adapter Live Smoke

# PLAN-012 Phase 2 D7. Dedicated workflow for the live-adapter smoke
# suite (tests/integration/test_live_adapter_smoke.py). Split from
# validate.yml per debate §R7 — the live matrix can legitimately run
# 3-15s per provider × 4 providers, which exceeds the 6-min validate
# ceiling. Weekly cadence + push-to-live-paths + manual dispatch.

on:
  schedule:
    # Monday 12:00 UTC. Staggered after chaos (03), perf-profile (06),
    # otel-smoke (09) per PLAN-012 §S6 cron-stagger table. See
    # .github/workflows/_README.md for the full schedule.
    - cron: "0 12 * * 1"
  workflow_dispatch:
  push:
    branches: [main]
    paths:
      - '.claude/hooks/_lib/adapters/live/**'
      - 'tests/integration/test_live_adapter_smoke.py'
      - 'SPEC/v1/live-adapters-policy.schema.md'
      - '.github/workflows/adapter-live.yml'

concurrency:
  # cancel-in-progress: false — a cron run mid-way should not be killed
  # by a push; live smokes against real APIs have real cost implications
  # and a torn run mid-flight would leave provider state indeterminate.
  group: adapter-live-${{ github.ref }}

