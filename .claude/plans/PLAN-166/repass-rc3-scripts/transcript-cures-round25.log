   284	  _bad=""
   285	  while IFS= read -r _line; do
   286	    [ -n "$_line" ] || continue
   287	    _path="${_line#???}"
   288	    _hit=0
   289	    while IFS= read -r _allow; do
   290	      [ -n "$_allow" ] || continue
   291	      case "$_allow" in
   292	        */) case "$_path" in "$_allow"*|"${_allow%/}") _hit=1 ;; esac ;;
   293	        *)  [ "$_path" = "$_allow" ] && _hit=1 ;;
   294	      esac
   295	      [ "$_hit" -eq 1 ] && break
