   116	die() { printf 'FAIL: %s\n' "$*" >&2; exit 1; }
   117	ok()  { printf '  ok   %s\n' "$*"; }
   118	note(){ printf '  --   %s\n' "$*"; }
   119	hdr() { printf '\n== %s ==\n' "$*"; }
