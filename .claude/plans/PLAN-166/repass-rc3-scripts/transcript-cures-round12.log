     1	#!/bin/bash
     2	# Round de review dos SCRIPTS da cerimonia rc.3 (precedente S300: o rail
     3	# achou P1s reais nos scripts de corte, nao so no produto). Artefatos com
     4	# o MESMO naming roundN do rail de curas (entram no mesmo manifesto).
     5	# Uso: bash run-rc3-scripts-review.sh <round-N>
     6	set -uo pipefail
     7	ROUND="${1:?uso: run-rc3-scripts-review.sh <round-N>}"
     8	REPO_ROOT="$(git rev-parse --show-toplevel)"; cd "$REPO_ROOT" || exit 2
     9	OUT="$REPO_ROOT/.claude/plans/PLAN-166/repass-rc3-cures"
    10	WT="/private/tmp/claude-501/-Users-joaocanhada-canhada-labs-ceo-orchestration/cbec69fd-7f41-4426-81f6-544a454e392a/scratchpad/rc3-wt"
    11	
    12	# Conjunto FECHADO dos arquivos de cerimonia sob review.
    13	FILES_LIST="$(cat <<'EOF'
    14	.claude/plans/PLAN-166/OWNER-RC3-CUT.sh
    15	.claude/plans/PLAN-166/RC3-approved-draft.md
    16	.claude/plans/PLAN-166/OWNER-GA-CUT.sh
