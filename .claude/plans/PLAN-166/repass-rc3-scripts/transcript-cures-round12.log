    25	DIFF="$OUT/diff-cures-$ROUND.patch"
    26	: > "$DIFF"
    27	while IFS= read -r f; do
    28	  [ -n "$f" ] || continue
    29	  [ -f "$f" ] || { echo "FATAL: arquivo de cerimonia ausente: $f"; exit 1; }
    30	  # --no-index contra /dev/null gera hunks (@@) para os controles de
