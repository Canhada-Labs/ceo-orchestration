   101	def _fail(code: int, msg: str) -> int:
   102	    # Flush the ok-lines first: an operator reading a release failure must see
   103	    # WHICH checks passed before the one that stopped it, in order.
   104	    sys.stdout.flush()
   105	    print("FAIL: %s" % msg, file=sys.stderr)
   106	    sys.stderr.flush()
   107	    return code
   108	
   109	
   110	def _git(repo: str, *args: str) -> Tuple[int, str, str]:
   111	    proc = subprocess.run(
   112	        ["git"] + list(args),
   113	        cwd=repo,
   114	        stdout=subprocess.PIPE,
   115	        stderr=subprocess.PIPE,
   116	        universal_newlines=True,
   117	    )
   118	    return proc.returncode, proc.stdout, proc.stderr
   119	
   120	
   121	# ---------------------------------------------------------------------------
   122	# (a) ancestry
   123	# ---------------------------------------------------------------------------
   124	def ancestry(repo: str, remote: str, branch: str, offline_ack: bool) -> int:
   125	    ref = "%s/%s" % (remote, branch)
   126	    if offline_ack:
   127	        print(
   128	            "  --   ancestry: --offline-ack given, NOT fetching; the "
   129	            "merge-base below is judged against a possibly STALE %s" % ref
   130	        )
   131	    else:
   132	        rc, _out, err = _git(repo, "fetch", "--quiet", remote, branch)
   133	        # NEVER `;` between the fetch and the merge-base: a failed fetch plus a
   134	        # stale ref reads as approval.
   135	        if rc != 0:
   136	            return _fail(
   137	                E_FETCH,
   138	                "could not talk to origin: `git fetch %s %s` exited %d.\n"
   139	                "      This is NOT a verdict on the commit — the check did not "
   140	                "run.\n"
   141	                "      Fix the network/remote and re-run, or, if you are "
   142	                "deliberately\n"
   143	                "      offline and accept judging against the last-known ref, "
   144	                "re-run\n"
   145	                "      with --offline-ack (it is recorded in the output).\n"
   146	                "      git said: %s" % (remote, branch, rc, err.strip()),
   147	            )
   148	        print("  ok   fetched %s" % ref)
   149	
   150	    rc, out, err = _git(repo, "rev-parse", "--verify", "--quiet", ref)
   151	    if rc != 0 or not out.strip():
   152	        return _fail(
   153	            E_REMOTE_REF,
   154	            "no usable ref %s in this repo — cannot judge ancestry "
   155	            "(git said: %s)" % (ref, err.strip()),
   156	        )
   157	    remote_sha = out.strip()
   158	
   159	    rc, _out, err = _git(repo, "merge-base", "--is-ancestor", "HEAD", ref)
   160	    if rc == 0:
   161	        print("  ok   HEAD is an ancestor of %s (%s)" % (ref, remote_sha[:12]))
   162	        return 0
   163	    if rc == 1:
   164	        return _fail(
   165	            E_NOT_ANCESTOR,
   166	            "HEAD is not an ancestor of %s — push main and re-run the "
   167	            "preflight.\n"
   168	            "      A tag on an unpushed commit points at a tree CI never "
   169	            "saw; the\n"
   170	            "      preflight's green verdict was about a different SHA."
   171	            % ref,
   172	        )
   173	    return _fail(
   174	        E_REMOTE_REF,
   175	        "`git merge-base --is-ancestor HEAD %s` exited %d (neither yes nor "
   176	        "no) — refusing to guess (git said: %s)" % (ref, rc, err.strip()),
   177	    )
   178	
