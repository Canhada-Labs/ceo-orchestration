     1	#!/usr/bin/env python3
     2	# ============================================================================
     3	# _release_tag_guard.py — the two fail-closed asserts `tag()` runs before it
     4	# asks the Owner's key to sign anything.
     5	#
     6	# WHY THIS EXISTS (v1.3.0-rc.1 re-pass, F2 + the F1/F2 composite risk):
     7	#
     8	#   (a) ANCESTRY. Nothing verified that the commit being tagged is on main.
     9	#       `bump` could create a local commit AFTER the preflight proved CI green
    10	#       for a different SHA, and `tag()` would sign that never-tested tree.
    11	#       Two DISTINCT failures, never merged into one message: "could not talk
    12	#       to origin" (network/offline — has a named escape hatch) and "HEAD is
    13	#       not an ancestor of origin/main" (a real governance stop). The fetch and
    14	#       the merge-base are SEPARATE statements: a failed fetch followed by a
    15	#       merge-base against a stale ref is a FALSE APPROVAL.
    16	#
    17	#   (b) RESTRICTED DELTA. The invariant is "nothing landed after what the
    18	#       re-pass reviewed, other than the verdict itself". The anchor is the
    19	#       REVIEWED PARENT recorded in the signed verdict — one rule for RC and
    20	#       GA. Anchoring on "the last RC" is wrong in both directions: for the GA
    21	#       it coincides by accident, and for an rc.2 it would reject the very
    22	#       W0/W1 fixes the re-pass just reviewed.
    23	#
    24	#       The allowlist is TAG-SPECIFIC and CLOSED:
    25	#         * never the wildcard `pair-rail-verdict-*.md` — that would let a
    26	#           historical verdict or the template be touched and still pass;
    27	#         * never `repass-<N>/**` — any file dropped into that directory after
    28	#           the review would pass the guard, and the pair-rail step-15 replay
    29	#           does not cover plan artifacts;
    30	#         * so the set closes by NAME (exact paths, set equality against the
    31	#           re-pass MANIFEST) *and* by CONTENT (the verdict pins the sha256 of
    32	#           MANIFEST.sha256, and the manifest itself is verified with
    33	#           `shasum -a 256 -c`);
    34	#         * and a plan path OUTSIDE the manifest directory — where no sha256
    35	#           pins content — is admitted ONLY as `verdict-fields-<TAG>.md` with
    36	#           the literal target tag, at its ONE canonical path (directly in
    37	#           the plan directory containing the manifest dir): the plan file
    38	#           itself, immutable repass history, another tag's verdict-fields,
    39	#           and same-basename look-alikes in any other directory all close by
    40	#           name alone and would carry a post-review edit onto the tag;
    41	#         * the reviewed parent itself must be an ANCESTOR of HEAD —
    42	#           `cat-file -e` proves existence, not lineage, and a fabricated
    43	#           `commit-tree` anchor makes the whole delta trivially clean.
    44	#
    45	# THE LOCAL ASSERT IS NOT ENOUGH. A tag signed by hand skips this driver
    46	# entirely, and the pair-rail step 15 recomputes inputs_hash only over the
    47	# manifest — which deliberately EXCLUDES the bump surfaces. The same assert
    48	# therefore goes server-side into `.github/workflows/release.yml` in PLAN-166
    49	# W1 (release.yml is canonical; it is changed under the GPG ceremony, not
    50	# here). Keep the two implementations in sync: this file is the reference.
    51	#
    52	# Exit codes are distinct so the failure MODE is testable, not just the
    53	# failure:
    54	#   2 usage   3 fetch failed   4 not-ancestor   5 remote ref unusable
    55	#   6 delta outside allowlist  7 manifest sha pin mismatch
    56	#   8 manifest content mismatch (shasum -c)  9 manifest/allowlist set mismatch
    57	#  10 verdict unusable (missing file/field, wildcard, wrong tag, bad parent)
    58	#  11 the assert would be VACUOUS (the verdict is not inside the delta it
    59	#     anchors — e.g. parent_sha == HEAD, which makes the verdict review itself)
    60	#  12 parent_sha is not an ancestor of HEAD (a fabricated/orphan anchor:
    61	#     `cat-file -e` proves existence, not lineage — a `commit-tree` object
    62	#     carrying HEAD's own tree makes diff(parent..HEAD) contain only the
    63	#     verdict while unreviewed work sits on main)
    64	# ============================================================================
    65	"""Ancestry + restricted-delta asserts for the release tag phase."""
    66	
    67	from __future__ import annotations
    68	
    69	import argparse
    70	import hashlib
    71	import os
    72	import re
    73	import subprocess
    74	import sys
    75	from typing import Dict, List, Optional, Sequence, Set, Tuple
    76	
    77	E_USAGE = 2
    78	E_FETCH = 3
    79	E_NOT_ANCESTOR = 4
    80	E_REMOTE_REF = 5
    81	E_DELTA = 6
    82	E_MANIFEST_PIN = 7
    83	E_MANIFEST_CONTENT = 8
    84	E_MANIFEST_SET = 9
    85	E_VERDICT = 10
    86	E_VACUOUS = 11
    87	E_PARENT_NOT_ANCESTOR = 12
    88	
    89	HEX40 = re.compile(r"\A[0-9a-f]{40}\Z")
    90	HEX64 = re.compile(r"\A[0-9a-f]{64}\Z")
    91	GLOB_CHARS = "*?["
    92	VERDICT_PREFIX = ".claude/governance/pair-rail-verdict-"
    93	# The allowlist is EXHAUSTIVE, not merely closed: the verdict for this tag plus
    94	# plan-side evidence (the `verdict-fields-<TAG>` pair and the re-pass artifact
    95	# directory both live under `.claude/plans/`). Anything else — a version site, a
    96	# workflow, any code path — would re-open the very hole the delta assert exists
    97	# to close: a post-review bump commit riding in on the tag.
    98	EVIDENCE_PREFIX = ".claude/plans/"
