+  done < "$MAN"
+  DIFF="$OUT/diff-ga-$P.patch"
+  # shellcheck disable=SC2046
+  git diff "$BASE_TAG".."$RC_TAG" -- $(tr '\n' ' ' < "$MAN") > "$DIFF" \
+    || { echo "FATAL: git diff da parte $P falhou (rc!=0) - payload seria truncado"; exit 1; }
+  DL=$(wc -l < "$DIFF" | tr -d ' ')
