    77	E_USAGE = 2
    78	E_FETCH = 3
    79	E_NOT_ANCESTOR = 4
    80	E_REMOTE_REF = 5
    81	E_DELTA = 6
    82	E_MANIFEST_PIN = 7
    83	E_MANIFEST_CONTENT = 8
    84	E_MANIFEST_SET = 9
    85	E_VERDICT = 10
    86	E_VACUOUS = 11
    87	E_PARENT_NOT_ANCESTOR = 12
