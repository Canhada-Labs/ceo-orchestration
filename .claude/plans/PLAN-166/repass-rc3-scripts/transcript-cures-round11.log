     1	#!/bin/bash
     2	# OWNER-GA-CUT.sh - promocao v1.3.0-rc.2 -> GA v1.3.0 em UM comando.
     3	#
     4	#   bash .claude/plans/PLAN-166/OWNER-GA-CUT.sh
     5	#
     6	# Pre-requisito: rc.2 cortada ha >= 24h (hold ADR-103). O script:
     7	#   1. valida janela do hold + freeze (origin/main == commit da rc.2)
     8	#   2. roda o re-pass do hold (codex, ~10-15 min) se ainda nao rodou;
     9	#      exige VERDICT: GO ou GO-WITH-CONDITIONS (NO-GO => aborta)
    10	#   3. commit 1: evidencia do re-pass (repass-ga/**)
    11	#   4. gera verdict-fields GA e voce assina (pinentry 1)
    12	#   5. monta o verdito GA, commit 2, guard local, push, espera CI
    13	#   6. preflight --stable + bump --stable (no-op esperado) +
    14	#      tag v1.3.0 assinada (pinentry 2)
    15	#   7. push da tag (confirmacao SIM) + espera release.yml + npm:
    16	#      aprovacao production-npm e SUA no browser (o script te da o link)
    17	#   8. GitHub Release (SEM pre-release) + npm view
