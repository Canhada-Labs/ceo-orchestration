   138	  || die "BINDING do MODES.txt do pack nao bate (exec-bit fora do revisado?)"
   139	echo "   OK: rail GO ($FINAL_ROUND derivado de $FINAL_N rounds; evidencia fechada + BINDING pack/anchor confere)"
   140	}
