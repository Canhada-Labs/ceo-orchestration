   544	    # State the inputs, not just the verdict: an operator reading a release log
   545	    # has to be able to tell what this assert actually examined.
   546	    print(
   547	        "  ok   delta %s..HEAD is %d file(s), all inside the verdict's closed "
   548	        "allowlist of %d (verdict present in the delta)"
   549	        % (parent[:12], len(changed), len(allow_set))
   550	    )
   551	    return 0
   552	
   553	
   554	def main(argv: Optional[Sequence[str]] = None) -> int:
   555	    parser = argparse.ArgumentParser(prog="_release_tag_guard.py")
   556	    sub = parser.add_subparsers(dest="cmd")
   557	
   558	    p_anc = sub.add_parser("ancestry", help="HEAD must be on origin/<branch>")
   559	    p_anc.add_argument("--repo", default=".")
   560	    p_anc.add_argument("--remote", default="origin")
   561	    p_anc.add_argument("--branch", default="main")
   562	    p_anc.add_argument(
   563	        "--offline-ack",
   564	        action="store_true",
   565	        help="named escape hatch: skip the fetch and judge against the "
   566	        "last-known remote ref (loudly announced)",
   567	    )
   568	
   569	    p_delta = sub.add_parser("delta", help="restricted delta vs the verdict")
   570	    p_delta.add_argument("--repo", default=".")
   571	    p_delta.add_argument("--tag", required=True)
   572	    p_delta.add_argument("--verdict", default=None)
   573	
   574	    args = parser.parse_args(argv)
   575	    if args.cmd == "ancestry":
   576	        return ancestry(args.repo, args.remote, args.branch, args.offline_ack)
   577	    if args.cmd == "delta":
   578	        return delta(args.repo, args.tag, args.verdict)
   579	    parser.print_usage(sys.stderr)
   580	    return E_USAGE
   581	
   582	
   583	if __name__ == "__main__":
   584	    sys.exit(main())
