    89	[ "$FINAL_N" -gt 0 ] || die "nenhum round de rail encontrado"
    90	FINAL_ROUND="round$FINAL_N"
    91	FVL="$(grep -E '^VERDICT:' "$CURES/verdict-cures-$FINAL_ROUND.txt" 2>/dev/null | tail -1 || true)"
    92	[ "$FVL" = "VERDICT: GO" ] \
    93	  || die "verdito final do rail ($FINAL_ROUND, derivado do disco): '$FVL' != GO exato - triagem comigo no Claude"
    94	( cd "$CURES" && shasum -a 256 -c MANIFEST-cures.sha256 --status ) \
    95	  || die "MANIFEST-cures nao confere - evidencia do rail adulterada/incompleta"
    96	# Set-equality BIDIRECIONAL: o manifesto lista exatamente as 4-tuplas
    97	# (payload.redacted/diff/verdict/transcript) de TODOS os rounds 1..N -
    98	# um round suprimido do manifesto ou um arquivo extra nele aborta.
    99	_ev_want="$( { _r=1; while [ "$_r" -le "$FINAL_N" ]; do
   100	    echo "diff-cures-round$_r.patch"
   101	    echo "payload-cures-round$_r.redacted.txt"
   102	    echo "transcript-cures-round$_r.log"
   103	    echo "verdict-cures-round$_r.txt"
   104	    _r=$((_r+1)); done; echo "PROVENANCE-cures.md"; } | sort )"
   105	_ev_have="$( awk '{print $2}' "$CURES/MANIFEST-cures.sha256" | sort )"
   106	[ "$_ev_want" = "$_ev_have" ] || die "MANIFEST-cures nao cobre exatamente os rounds 1..$FINAL_N:
   107	$(diff <(printf '%s\n' "$_ev_want") <(printf '%s\n' "$_ev_have") | sed 's/^/   /')"
   108	# Fechamento do DIRETORIO de evidencia por conjunto exato de filhos
   109	# DIRETOS (rail r5 P1-2: prefixo na allowlist admite look-alike
   110	# aninhado que o git add recursivo commitaria como parent revisado).
   111	_cd_odd="$( cd "$CURES" && find . ! -type f ! -type d | head -5 )"
   112	[ -z "$_cd_odd" ] || die "entrada NAO-regular em repass-rc3-cures: $_cd_odd"
