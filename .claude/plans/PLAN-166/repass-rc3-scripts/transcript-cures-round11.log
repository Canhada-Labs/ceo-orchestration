   297	# Idempotente (rail r5 P1-4) e ATOMICO (rail r7 P1-2): copia para um
   298	# temporario no MESMO diretorio, verifica o hash do pack e so entao
   299	# renomeia — uma interrupcao/IO-error nunca deixa o alvo truncado num
   300	# terceiro estado; o tmp remanescente e removido no rerun.
   301	while IFS= read -r _mline; do
   302	  [ -n "$_mline" ] || continue
   303	  _mf="${_mline#*  }"; _msha="${_mline%%  *}"
   304	  _tmp="$(dirname "$_mf")/.rc3tmp.$(basename "$_mf")"
   305	  rm -f "$_tmp"
   306	  _lsha="$(shasum -a 256 "$_mf" | awk '{print $1}')"
   307	  # Modo esperado vem do MODES.txt REVISADO, nunca do pack atual (r9
   308	  # P1-3: um chmod no pack pos-review passaria com sha igual).
   309	  _wmode="$(awk -v f="$_mf" '$2==f{print $1}' "$PACK/MODES.txt")"
