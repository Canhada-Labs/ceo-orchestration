   387	            echo "::error::unrendered placeholders leaked into hooks"
   388	            exit 1
   389	          fi
   390	          python3 -c "import json; json.load(open('$SCRATCH/target/.claude/settings.json'))"
   391	          echo "OK: smoke install complete"
   392	          rm -rf "$SCRATCH"
