   366	class WorkflowHygieneTest(TestEnvContext):
   367	    """Parse + SHA-pin discipline for both tag-triggered workflows."""
   368	
   369	    def test_workflows_parse_as_yaml(self):
   370	        try:
   371	            import yaml  # type: ignore
   372	        except ImportError:  # pragma: no cover - CI installs pyyaml
   373	            self.skipTest("pyyaml not installed")
   374	        for name in ("release.yml", "npm-publish.yml"):
   375	            for path in ((_WF / name), (_STAGED_WF / name),
   376	                         (_STAGED_166_WF / name)):
   377	                if not path.is_file():
   378	                    continue
   379	                with self.subTest(path=str(path)):
   380	                    data = yaml.safe_load(path.read_text(encoding="utf-8"))
   381	                    self.assertIsInstance(data, dict)
   382	                    self.assertIn("jobs", data)
   383	
   384	    def test_all_action_uses_are_sha_pinned(self):
   385	        # Every `uses:` in both workflows (live + staged copies) must
   386	        # pin to a 40-hex commit SHA — no floating tags.
   387	        pattern = re.compile(r"^\s*(?:-\s+)?uses:\s*(\S+)", re.MULTILINE)
   388	        pinned = re.compile(r".+@[0-9a-f]{40}$")
   389	        for name in ("release.yml", "npm-publish.yml"):
   390	            for path in ((_WF / name), (_STAGED_WF / name),
   391	                         (_STAGED_166_WF / name)):
   392	                if not path.is_file():
   393	                    continue
   394	                text = path.read_text(encoding="utf-8")
   395	                for used in pattern.findall(text):
   396	                    with self.subTest(path=str(path), uses=used):
   397	                        self.assertRegex(
   398	                            used, pinned,
   399	                            f"{path.name}: `uses: {used}` is not "
   400	                            "SHA-pinned to a 40-hex commit",
   401	                        )
