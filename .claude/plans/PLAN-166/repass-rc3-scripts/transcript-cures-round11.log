   256	  while IFS= read -r _line; do
   257	    [ -n "$_line" ] || continue
   258	    _path="${_line#???}"
   259	    _hit=0
   260	    while IFS= read -r _allow; do
   261	      [ -n "$_allow" ] || continue
   262	      case "$_allow" in
   263	        */) case "$_path" in "$_allow"*|"${_allow%/}") _hit=1 ;; esac ;;
   264	        *)  [ "$_path" = "$_allow" ] && _hit=1 ;;
   265	      esac
   266	      [ "$_hit" -eq 1 ] && break
   267	    done <<ALLOW
   268	$COMMIT1_ALLOW
   269	ALLOW
   270	    [ "$_hit" -eq 1 ] || _bad="$_bad
   271	   $_path"
