   531	            E_VACUOUS,
   532	            "the verdict %s is not part of the delta %s..HEAD — this assert "
   533	            "would pass\n"
   534	            "      VACUOUSLY. parent_sha has to be the commit the re-pass "
   535	            "reviewed, with\n"
   536	            "      the verdict landing after it; parent_sha == HEAD (or any "
   537	            "anchor whose\n"
