   250	check_tree_is_exactly_the_prep() {
   250	check_tree_is_exactly_the_prep() {
   251	  # git status CAPTURADO com rc checado (rail r8 P1-2: falha dentro de
   252	  # command substitution em heredoc virava "arvore limpa").
   253	  _st_out="$(git status --porcelain --untracked-files=all)" \
   254	    || die "git status falhou - nao vou tratar como arvore limpa"
   255	  _bad=""
   256	  while IFS= read -r _line; do
   257	    [ -n "$_line" ] || continue
   258	    _path="${_line#???}"
   259	    _hit=0
   260	    while IFS= read -r _allow; do
   261	      [ -n "$_allow" ] || continue
   262	      case "$_allow" in
   263	        */) case "$_path" in "$_allow"*|"${_allow%/}") _hit=1 ;; esac ;;
   264	        *)  [ "$_path" = "$_allow" ] && _hit=1 ;;
   265	      esac
   266	      [ "$_hit" -eq 1 ] && break
   267	    done <<ALLOW
   268	$COMMIT1_ALLOW
   269	ALLOW
   270	    [ "$_hit" -eq 1 ] || _bad="$_bad
   271	   $_path"
   272	  done <<STATUS
   273	$_st_out
   274	STATUS
   275	  [ -z "$_bad" ] || die "arquivo(s) FORA da allowlist do commit 1 (nao revisados pelo rail):$_bad
   276	Remova/stash antes de cortar, ou me chame no Claude."
   277	}
   278	# Limpa temporarios de um apply interrompido ANTES do fechamento de
   279	# arvore (rail r7 P1-2: um .rc3tmp.* orfao triparia a allowlist).
   280	while IFS= read -r _mline; do
   281	  [ -n "$_mline" ] || continue
   282	  _mf="${_mline#*  }"
   283	  rm -f "$(dirname "$_mf")/.rc3tmp.$(basename "$_mf")"
   284	done < "$PACK/MANIFEST.sha256"
