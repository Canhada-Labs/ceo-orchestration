   114	[ -z "$_cd_sub" ] || die "subdiretorio/arquivo aninhado em repass-rc3-cures (look-alike?):
   115	$_cd_sub"
   116	_cd_disk="$( cd "$CURES" && find . -maxdepth 1 -type f | sed 's|^\./||' | sort )"
   117	_cd_want="$( { printf '%s\n' "$_ev_want"; \
   118	  echo "MANIFEST-cures.sha256"; \
   119	  echo "RAIL-STATUS.txt"; echo "run-rc3-cure-review.sh"; \
   120	  echo "run-rc3-scripts-review.sh"; } | sort -u )"
   121	[ "$_cd_disk" = "$_cd_want" ] || die "conjunto de arquivos em repass-rc3-cures difere do esperado:
   122	$(diff <(printf '%s\n' "$_cd_want") <(printf '%s\n' "$_cd_disk") | sed 's/^/   /')"
   123	# BINDING evidencia<->pack<->anchor (rail r6 P1-1): a proveniencia —
