+# TERCEIRO estado (cherry-pick perdido, edicao manual) aborta.
+_tri_bad=""
+while IFS= read -r _mline; do
+  [ -n "$_mline" ] || continue
+  _mf="${_mline#*  }"; _msha="${_mline%%  *}"
