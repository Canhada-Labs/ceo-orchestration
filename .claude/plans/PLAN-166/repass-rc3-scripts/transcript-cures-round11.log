   129	def _plan166_text(name: str) -> Optional[Tuple[str, str]]:
   130	    """Return (text, context) for a PLAN-166 workflow edit, or None pre-landing.
   131	
   132	    Priority: live copy carrying the PLAN-166 marker (post-landing,
   133	    authoritative) → staged copy under .claude/plans/PLAN-166/staged/
   134	    (pre-landing, local ceremony mirror; gitignored so absent in CI) →
   135	    None (pre-landing CI: skip). Unlike _wave_b_text this tolerates a
   136	    missing live file — the filename-binding test reports that as a
   137	    FAILURE, not a collection error.
   138	    """
   139	    live = _WF / name
   140	    if live.is_file():
   141	        text = live.read_text(encoding="utf-8")
   142	        if _MARKER_166 in text:
   143	            return text, "live"
   144	    staged = _STAGED_166_WF / name
   145	    if staged.is_file():
   146	        return staged.read_text(encoding="utf-8"), "staged"
   147	    return None
   148	
   149	
   150	def _trusted_publisher_values() -> Optional[Tuple[dict, str]]:
   151	    """Parse npm-trusted-publisher.txt (live → staged), or None pre-landing.
   152	
   153	    Format contract (documented in the file itself): `key=value` lines;
   154	    `#`-prefixed and blank lines are comments; keys are EXACTLY
   155	    repository/workflow/environment. Malformed content raises — a
   156	    binding record we cannot parse must never silently skip the binding
   157	    asserts (fail-closed, ADR-186 posture).
   158	    """
   159	    for path, context in (
   160	        (_TRUSTED_PUBLISHER, "live"),
   161	        (_STAGED_166_TRUSTED_PUBLISHER, "staged"),
   162	    ):
   163	        if not path.is_file():
   164	            continue
   165	        values = {}
   166	        for lineno, raw in enumerate(
   167	            path.read_text(encoding="utf-8").splitlines(), 1
   168	        ):
   169	            line = raw.strip()
   170	            if not line or line.startswith("#"):
   171	                continue
   172	            key, sep, value = line.partition("=")
   173	            key, value = key.strip(), value.strip()
   174	            if not sep or not key or not value:
   175	                raise AssertionError(
   176	                    "%s:%d: expected key=value, got %r" % (path, lineno, raw)
   177	                )
   178	            if key in values:
   179	                raise AssertionError(
   180	                    "%s:%d: duplicate key %r" % (path, lineno, key)
   181	                )
   182	            values[key] = value
   183	        if set(values) != set(_TRUSTED_PUBLISHER_KEYS):
   184	            raise AssertionError(
   185	                "%s must define exactly %s, got %s"
   186	                % (path, sorted(_TRUSTED_PUBLISHER_KEYS), sorted(values))
   187	            )
   188	        return values, context
   189	    return None
   190	
   191	
   192	def _binding_mismatches(values: dict, workflow_text: str) -> list:
   193	    """Which parts of the trusted-publisher triple the workflow does NOT honour.
   194	
   195	    Pure text→list (no filesystem) so the positive-control tests can run
   196	    it against a deliberately mutated COPY of the workflow text.
   197	    """
   198	    mismatches = []
   199	    if ("environment: " + values["environment"]) not in workflow_text:
   200	        mismatches.append(
   201	            "workflow does not gate through `environment: %s` — the npmjs "
   202	            "trusted-publisher registration names that environment"
   203	            % values["environment"]
   204	        )
   205	    if values["repository"] not in workflow_text:
   206	        mismatches.append(
   207	            "workflow no longer names the registered repository %r (the "
   208	            "OIDC registration comment is the in-file record)"
   209	            % values["repository"]
   210	        )
   211	    return mismatches
   212	
