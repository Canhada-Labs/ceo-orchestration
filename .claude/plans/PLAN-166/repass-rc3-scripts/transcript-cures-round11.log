   143	check_pack() {
   144	say "G0c: pack staged-rc3 fechado por manifesto + baseline"
   145	( cd "$PACK" && shasum -a 256 -c MANIFEST.sha256 --status ) \
   146	  || die "staged-rc3 nao confere com o MANIFEST do pack"
   147	_st_odd="$( cd "$PACK" && find . ! -type f ! -type d | head -5 )"
   148	[ -z "$_st_odd" ] || die "entrada NAO-regular dentro de staged-rc3 (symlink/fifo?):
   149	$_st_odd"
   150	_st_disk="$( cd "$PACK" && find . -type f | sed 's|^\./||' | sort )"
   151	_st_want="$( { awk '{print $2}' "$PACK/MANIFEST.sha256"; \
   152	  echo "MANIFEST.sha256"; echo "BASELINE.sha256"; echo "MODES.txt"; } | sort )"
   153	[ "$_st_disk" = "$_st_want" ] || die "conjunto de arquivos em staged-rc3 difere do MANIFEST:
   154	$(diff <(printf '%s\n' "$_st_want") <(printf '%s\n' "$_st_disk") | sed 's/^/   /')"
   155	# TRI-ESTADO por arquivo (rail r5 P1-4: exigir BASELINE puro quebrava o
   156	# rerun anunciado — apos um apply parcial, arquivos ja curados falhavam
   157	# o baseline). Cada arquivo vivo tem de estar EM UM de dois estados:
   158	# pre-cura (== BASELINE) ou ja-curado (== MANIFEST do pack). Qualquer
   159	# TERCEIRO estado (cherry-pick perdido, edicao manual) aborta.
   160	_tri_bad=""
   161	while IFS= read -r _mline; do
   162	  [ -n "$_mline" ] || continue
   163	  _mf="${_mline#*  }"; _msha="${_mline%%  *}"
   164	  _bsha="$(awk -v f="$_mf" '$0 ~ ("  " f "$") {print $1}' "$PACK/BASELINE.sha256")"
   165	  [ -n "$_bsha" ] || die "arquivo do MANIFEST sem linha no BASELINE: $_mf"
   166	  # Symlink no alvo canonico e sempre TERCEIRO estado (rail r8 P1-3):
   167	  # shasum seguiria o link e "ja aplicado" commitaria o symlink.
   168	  if [ -L "$_mf" ]; then
   169	    _tri_bad="$_tri_bad
   170	   $_mf (SYMLINK no lugar do arquivo canonico)"
   171	    continue
   172	  fi
   173	  _lsha="$(shasum -a 256 "$_mf" | awk '{print $1}')"
   174	  if [ "$_lsha" != "$_bsha" ] && [ "$_lsha" != "$_msha" ]; then
   175	    _tri_bad="$_tri_bad
   176	   $_mf (vivo=$_lsha nem baseline nem pack)"
   177	  fi
   178	done < "$PACK/MANIFEST.sha256"
   179	[ -z "$_tri_bad" ] || die "arquivo(s) vivos em TERCEIRO estado (nem rc.2 nem pack) - me chame no Claude:$_tri_bad"
   180	# Exec-bit e parte do material revisado (rail r9 P1-3): sha256 nao
   181	# cobre modo; MODES.txt (pinado no BINDING) e a autoridade — o modo
   182	# ATUAL do pack nao decide nada.
   183	while IFS=' ' read -r _mmode _mpath; do
   184	  [ -n "$_mpath" ] || continue
   185	  _pm="$(python3 -c 'import os,sys;print(oct(os.stat(sys.argv[1]).st_mode & 0o777)[2:])' "$PACK/$_mpath")"
   186	  [ "$_pm" = "$_mmode" ] \
   187	    || die "modo do pack divergiu do MODES.txt revisado: $_mpath ($_pm != $_mmode)"
   188	done < "$PACK/MODES.txt"
   189	echo "   OK: pack fechado ($(grep -c . "$PACK/MANIFEST.sha256") arquivos) + vivos em estado pre-cura ou ja-curado + modes conferem"
   190	}
   191	check_pack
