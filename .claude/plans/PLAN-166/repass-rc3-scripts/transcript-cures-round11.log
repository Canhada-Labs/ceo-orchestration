   229	
   230	def _iter_version_fields(obj: object) -> Iterator[str]:
   231	    """Yield every string-valued `version` field nested anywhere in obj."""
   232	    if isinstance(obj, dict):
   233	        for key, value in obj.items():
   234	            if key == "version" and isinstance(value, str):
   235	                yield value
   236	            else:
   237	                yield from _iter_version_fields(value)
   238	    elif isinstance(obj, list):
   239	        for item in obj:
   240	            yield from _iter_version_fields(item)
