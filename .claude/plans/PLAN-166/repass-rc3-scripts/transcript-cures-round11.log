   214	def _wave_b_text(name: str) -> Optional[Tuple[str, str]]:
   215	    """Return (text, context) for a Wave B workflow, or None pre-landing.
   216	
   217	    Priority: live copy carrying the Wave B marker (post-landing,
   218	    authoritative) → staged copy (pre-landing, local ceremony mirror;
   219	    gitignored so absent in CI) → None (pre-landing CI: skip).
   220	    """
   221	    live = (_WF / name).read_text(encoding="utf-8")
   222	    if _MARKER in live:
   223	        return live, "live"
   224	    staged = _STAGED_WF / name
   225	    if staged.is_file():
   226	        return staged.read_text(encoding="utf-8"), "staged"
   227	    return None
