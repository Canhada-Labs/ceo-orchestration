    76	check_rail_and_evidence() {
    77	say "G0b: rail de curas terminou GO (verificacao completa)"
    78	# O round FINAL e DERIVADO do proprio conjunto de rounds no disco (o
    79	# maior N com verdict presente) - nunca lido de um arquivo de status
    80	# mutavel (rail r5 P1-3: um RAIL-STATUS editado selecionaria um GO
    81	# anterior). RAIL-STATUS.txt existe so como registro informacional.
    82	FINAL_N=0
    83	for _vfp in "$CURES"/verdict-cures-round*.txt; do
    84	  [ -e "$_vfp" ] || die "nenhum verdict-cures-roundN.txt - rail nao rodou"
    85	  _n="${_vfp##*round}"; _n="${_n%.txt}"
    86	  case "$_n" in (*[!0-9]*|'') die "nome de verdito invalido: $_vfp" ;; esac
    87	  [ "$_n" -gt "$FINAL_N" ] && FINAL_N="$_n"
