   394	      - name: Validate install.sh self-SHA mechanism (P0-15, PLAN-045)
   395	        # PLAN-045 F-15R2-01 / Session 41: end-to-end validation that
   396	        # the install.sh self-SHA verification works. We (a) confirm the
   397	        # placeholder is still present (source checkout state), (b) compute
   398	        # the expected sha, (c) substitute it into a temp copy, (d) run the
   399	        # temp copy — self-verify passes → rc=1 (usage exit, not rc=5).
   400	        run: |
   401	          set -euo pipefail
   402	          FILE="scripts/install.sh"
   403	          # (a) Placeholder must be present in source tree.
   404	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   405	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   406	            echo "::error::Source install.sh trailer has drifted from placeholder."
   407	            echo "got: $TRAILER_LINE"
   408	            exit 1
   409	          fi
   410	          # (b) + (c) stage a populated copy in a scratch dir.
   411	          SCRATCH="$(mktemp -d -t ceo-selfsha-XXXXXX)"
   412	          cp "$FILE" "$SCRATCH/install.sh"
   413	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$SCRATCH/install.sh" "$SCRATCH/install.sh" | sha256sum | awk '{print $1}')
   414	          awk -v hash="$HASH" '
   415	            NR == FNR { total = NR; next }
   416	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   417	            { print }
   418	          ' "$SCRATCH/install.sh" "$SCRATCH/install.sh" > "$SCRATCH/install.sh.new"
   419	          mv "$SCRATCH/install.sh.new" "$SCRATCH/install.sh"
   420	          chmod +x "$SCRATCH/install.sh"
   421	          # (d) Run the populated copy with no args; must exit rc=1
   422	          #     (usage), NOT rc=5 (self-SHA mismatch).
   423	          set +e
   424	          bash "$SCRATCH/install.sh" > /dev/null 2>"$SCRATCH/err"
   425	          RC=$?
   426	          set -e
   427	          if [ "$RC" -eq 5 ]; then
   428	            echo "::error::populated install.sh still rc=5 — self-SHA mechanism broken"
   429	            cat "$SCRATCH/err"
   430	            exit 1
   431	          fi
   432	          if [ "$RC" -ne 1 ]; then
   433	            echo "::error::populated install.sh rc=$RC (expected 1 for usage exit)"
   434	            cat "$SCRATCH/err"
   435	            exit 1
   436	          fi
   437	          # (e) Tamper test: mutate body, verify rc=5.
   438	          # Prepend malicious line before the trailer
   439	          head -n -1 "$SCRATCH/install.sh" > "$SCRATCH/install.sh.tmp1"
   440	          echo 'echo "MALICIOUS_INJECT" >&2' >> "$SCRATCH/install.sh.tmp1"
   441	          tail -n 1 "$SCRATCH/install.sh" >> "$SCRATCH/install.sh.tmp1"
   442	          chmod +x "$SCRATCH/install.sh.tmp1"
   443	          set +e
   444	          bash "$SCRATCH/install.sh.tmp1" > /dev/null 2>"$SCRATCH/err2"
   445	          RC2=$?
   446	          set -e
   447	          if [ "$RC2" -ne 5 ]; then
   448	            echo "::error::tampered install.sh did NOT rc=5 (got $RC2) — self-SHA gate broken"
   449	            cat "$SCRATCH/err2"
   450	            exit 1
   451	          fi
   452	          echo "OK: install.sh self-SHA mechanism end-to-end validated"
   453	          rm -rf "$SCRATCH"
