+  _vo="$( cd "$GA_DIR" && find . ! -type f ! -type d | head -3 )"
+  [ -z "$_vo" ] || return 1
+  _vs="$( cd "$GA_DIR" && find . -mindepth 2 | head -3 )"
+  [ -z "$_vs" ] || return 1
+  _vd="$( cd "$GA_DIR" && find . -maxdepth 1 -type f | sed 's|^\./||' | sort )"
+  _vw="$( { printf '%s\n' $GA_OUT_OK; echo "run-ga-repass.sh"; } | sort )"
