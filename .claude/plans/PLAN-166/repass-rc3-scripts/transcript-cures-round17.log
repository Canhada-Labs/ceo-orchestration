+# SIM e imediatamente antes de TODO push de tag - caminho normal E
+# retomada. Um prompt SIM deixado aberto ate o TTL do verdito, ou um
+# main que andou, para AQUI, nao no server.
+prepush_preflight() {
+  git tag -v "$TAG" >/dev/null 2>&1 \
