from pathlib import Path
import hashlib, json, subprocess
p=Path('.claude/governance/pair-rail-inputs-hash-manifest.txt')
items=[]
for line in p.read_text().splitlines():
    line=line.split('#',1)[0].strip()
    if not line: continue
    try:
        b=subprocess.check_output(['git','show','HEAD:'+line])
    except subprocess.CalledProcessError:
        print('MISSING', line); continue
    oid=subprocess.check_output(['git','hash-object','--stdin'],input=b).decode().strip()
    items.append({'path':line,'git_blob_sha1':oid})
print(items)
print(hashlib.sha256(json.dumps(items,sort_keys=True,separators=(',',':')).encode()).hexdigest())
