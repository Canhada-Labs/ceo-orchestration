   621	
   622	  hdr "tag guards (unconditional — RC and stable)"
   623	  if [ "$OFFLINE_ACK" -eq 1 ]; then
   624	    python3 "$TAG_GUARD" ancestry --repo "$REPO_ROOT" --remote origin --branch main --offline-ack \
   625	      || die "ancestry guard refused the tag (see above)"
   626	  else
   627	    python3 "$TAG_GUARD" ancestry --repo "$REPO_ROOT" --remote origin --branch main \
   628	      || die "ancestry guard refused the tag (see above)"
   629	  fi
   630	  python3 "$TAG_GUARD" delta --repo "$REPO_ROOT" --tag "$TARGET_TAG" \
   631	    || die "restricted-delta guard refused the tag (see above)"
