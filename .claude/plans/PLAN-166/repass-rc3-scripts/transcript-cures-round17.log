    89	def parse_verdict_file(path: Path) -> Dict[str, Any]:
    90	    """Parse YAML frontmatter from a verdict file. Returns dict."""
    91	    if not path.exists():
    92	        raise FileNotFoundError(f"verdict file: {path}")
    93	    text = path.read_text(encoding="utf-8")
    94	    # Look for ```yaml ... ``` block
    95	    m = re.search(r"```yaml\s*\n(.*?)```", text, re.DOTALL)
    96	    if not m:
    97	        raise ValueError("verdict file missing yaml frontmatter block")
    98	    yaml_body = m.group(1)
    99	    # Inline minimal YAML parse (stdlib only)
   100	    out: Dict[str, Any] = {}
   101	    current_key: Optional[str] = None
   102	    for raw in yaml_body.splitlines():
   103	        line = raw.split("#", 1)[0].rstrip() if "#" in raw else raw.rstrip()
   104	        if not line.strip():
   105	            continue
   106	        if line[0] not in (" ", "\t"):
   107	            if ":" in line:
   108	                k, _, v = line.partition(":")
   109	                v = v.strip()
   110	                if v:
   111	                    out[k.strip()] = v
   112	                else:
   113	                    out[k.strip()] = {}
   114	                    current_key = k.strip()
   115	        elif current_key and ":" in line:
   116	            sub_k, _, sub_v = line.partition(":")
   117	            if isinstance(out[current_key], dict):
   118	                out[current_key][sub_k.strip()] = sub_v.strip()
   119	    return out
