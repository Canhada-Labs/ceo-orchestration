   821	def _repo_rels(path_str: str, repo_root: Path) -> List[str]:
   822	    """All repo-relative POSIX forms of ``path_str`` (0, 1, or 2 entries).
   823	
   824	    PLAN160_FIX_D (finding D — relative-path classification bypass,
   825	    most-restrictive-wins): a RELATIVE path is resolved against BOTH the
   826	    process CWD (historical anchoring) AND ``repo_root``. A canonical file
   827	    addressed by a relative ``path_str`` from a CWD outside the repo
   828	    previously resolved outside ``repo_root`` → ``relative_to`` raised →
   829	    treated non-canonical → the unsigned edit sailed through ungated.
   830	    Yielding the repo_root-anchored form too closes that bypass. Absolute
   831	    paths yield ONLY the CWD-form (``repo_root / p`` discards ``repo_root``
   832	    when ``p`` is absolute), so classification AND per-call resolve cost
   833	    stay byte-identical on the Edit/Write hot path. Returned in anchoring
   834	    order (CWD-form first) so callers pick the historical rel when both
   835	    land inside the repo (the CWD==repo_root common case → one entry).
   836	
   837	    TOTAL by construction (PLAN-160 finding-A blocker, codex + security
   838	    pair-rail): every resolve is caught with a BROAD ``except Exception``.
   839	    ``Path.resolve()`` raises ``RuntimeError`` — NOT ``ValueError``/``OSError``
   840	    — on a symlink loop; if that propagated, ``_is_canonical`` would raise,
   841	    and a raising candidate in the multi-candidate scan would route through
   842	    ``decide()`` and the outer handler would fail-OPEN (allow) the whole
   843	    event — a gate-bypass strictly worse than HEAD. An unresolvable path is
   844	    simply non-canonical here (its write fails at the OS anyway); the other
   845	    candidates in a multi-candidate event are still scanned and gated.
   846	    """
   847	    p = Path(path_str)
   848	    try:
   849	        root_resolved = repo_root.resolve()
   850	    except Exception:
   851	        return []
   852	    anchorings = [p]
   853	    if not p.is_absolute():
   854	        anchorings.append(repo_root / p)
   855	    rels: List[str] = []
   856	    for cand in anchorings:
   857	        try:
   858	            rels.append(
   859	                str(cand.resolve().relative_to(root_resolved)).replace(os.sep, "/")
   860	            )
   861	        except Exception:
   862	            continue
   863	    return rels
   864	
   865	
   866	# PLAN162_FIX_CASEFOLD (PLAN-162 consensus S1, P0 — BOTH rails).
   867	#
   868	# ``_match_segments`` matches with ``fnmatch.fnmatchcase`` (exact case)
   869	# and ``_CANONICAL_PREFIXES`` is an exact-case frozenset. On a
   870	# case-INSENSITIVE filesystem — APFS, the default on this repo's
   871	# platform — ``.claude/settings.JSON`` IS ``.claude/settings.json``, and
   872	# writing through the variant OVERWRITES the guarded file. Measured on
   873	# HEAD: `.claude/settings.JSON`, `.claude/hooks/_lib/audit_emit.PY` and
   874	# `.CLAUDE/settings.json` all classified NON-canonical AND non-kernel,
   875	# reaching files the threat model assumes unreachable.
   876	#
   877	# Both halves must fold or the guard only LOOKS fixed: the prefix
   878	# fast-path bails out in O(1) BEFORE any glob runs, so folding the glob
   879	# matcher alone would leave `.CLAUDE/...` inert — the dead-gate class
   880	# this file was already bitten by twice (the `.codex` and `.grok` prefix
   881	# omissions).
   882	#
   883	# ``str.lower`` — not ``str.casefold`` — deliberately: casefold expands
   884	# 'ß'→'ss', changing segment LENGTH and hence what a glob matches. The
   885	# exploited class is ASCII case variance, which ``lower()`` covers
   886	# exactly; identical inputs always fold identically, so the
   887	# normalization can only ADD matches (over-classify = the safe
   888	# direction), never remove one.
   889	#
   890	# Precomputed at import: the hot path pays one ``str.lower()`` per
   891	# classification instead of one per (segment x pattern).
   892	_CANONICAL_GUARDS_FOLDED = [pat.lower() for pat in _CANONICAL_GUARDS]
   893	_CANONICAL_PREFIXES_FOLDED = frozenset(
   894	    prefix.lower() for prefix in _CANONICAL_PREFIXES
   895	)
