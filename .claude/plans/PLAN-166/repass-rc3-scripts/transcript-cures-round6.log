   518	            "reviewed,\n"
   519	            "      other than the verdict and its pinned evidence. Either "
   520	            "re-run the\n"
   521	            "      re-pass against this tree, or drop these commits."
   522	            % (parent[:12], "\n".join("        - %s" % p for p in outside)),
