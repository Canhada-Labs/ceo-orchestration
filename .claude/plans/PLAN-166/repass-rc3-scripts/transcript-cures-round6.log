   465	  [ "$cur_version" = "$TARGET_BASE" ] || return 1
   466	  _oracle "2/4" bash .claude/scripts/local/verify-counts.sh --quiet --no-tests || return 1
   467	  _oracle "3/4" python3 scripts/build-plugin.py --check || return 1
   468	  _oracle "4/4" python3 .claude/scripts/check-canonical-doc-freshness.py || return 1
   469	  return 0
   470	}
