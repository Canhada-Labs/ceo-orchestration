   490	            E_MANIFEST_SET,
   491	            "re-pass artifact set is not closed under %s\n"
   492	            "      allowlisted but not in the manifest: %s\n"
   493	            "      in the manifest but not allowlisted: %s"
   494	            % (manifest_rel, extra or "-", missing or "-"),
