   897	
   898	def _matches_canonical_guard(rel_str: str) -> bool:
   899	    """True if a repo-relative POSIX path matches a canonical guard pattern.
   900	
   901	    Split out of ``_is_canonical`` (PLAN160_FIX_D) so the identical
   902	    fast-path prefix check + glob loop runs against each candidate path
   903	    anchoring without duplication. PLAN-025 F-perf-004 fast-path preserved.
   904	
   905	    PLAN162_FIX_CASEFOLD: the rel and the patterns are compared
   906	    case-INSENSITIVELY (see the module note above) — on APFS the case
   907	    variant addresses the very same inode.
   908	    """
   909	    rel_folded = rel_str.lower()
   910	    # Fast path: check the first path segment against known prefixes.
   911	    first_seg = rel_folded.split("/", 1)[0]
   912	    if first_seg not in _CANONICAL_PREFIXES_FOLDED:
   913	        return False
   914	    for pattern in _CANONICAL_GUARDS_FOLDED:
   915	        if _fnmatch_segments(rel_folded, pattern):
   916	            return True
   917	    return False
   918	
   919	
   920	def _canonical_rel(path_str: str, repo_root: Path) -> Optional[str]:
   921	    """The repo-relative form of ``path_str`` that matches a canonical
   922	    guard, or ``None`` if no anchoring is canonical.
   923	
   924	    PLAN160_FIX_D: single source of truth for canonicality AND the
   925	    repo-relative form used downstream (decide() sentinel matching,
   926	    ``_candidate_is_granted``), so a canonical path is ALWAYS paired with
   927	    the exact rel that classified it — the CWD-anchored ``decide()`` resolve
   928	    could otherwise raise on a repo_root-anchored canonical path and route a
   929	    clean sentinel-block through finding C's fault branch instead.
   930	    """
   931	    for rel_str in _repo_rels(path_str, repo_root):
   932	        if _matches_canonical_guard(rel_str):
   933	            return rel_str
   934	    return None
   935	
   936	
   937	def _is_canonical(path_str: str, repo_root: Path) -> bool:
   938	    """True if path_str matches one of the canonical guard patterns.
   939	
   940	    Thin wrapper over ``_canonical_rel`` (PLAN160_FIX_D). NOTE: this is a
   941	    SHARED predicate (hook Layer-A, the ``--is-canonical`` CLI oracle, and
   942	    ``_candidate_is_granted``); the finding-D change WIDENS classification
   943	    (relative paths from a foreign CWD now classify canonical → more
   944	    blocks), never narrows it — see the ADR.
   945	    """
   946	    return _canonical_rel(path_str, repo_root) is not None
   947	
   948	
   949	def _fnmatch_segments(path: str, pattern: str) -> bool:
   950	    """Segment-wise glob matcher.
   951	
   952	    - ``*`` matches exactly one path segment (any non-slash content).
   953	    - ``**`` matches zero or more path segments (Sprint 9 amendment).
   954	    - Literal segments must match exactly.
   955	    """
   956	    p_parts = path.split("/")
   957	    pat_parts = pattern.split("/")
   958	    return _match_segments(p_parts, pat_parts)
   959	
   960	
   961	def _match_segments(p_parts: List[str], pat_parts: List[str]) -> bool:
   962	    """Recursive glob with ``**`` zero-or-more support.
   963	
   964	    Per-segment patterns support full fnmatch semantics (so
   965	    patterns like *.py, *.yaml, or ADR-*.md match one
   966	    segment with a wildcard stem). ** still means zero-or-more
   967	    segments.
   968	    """
   969	    if not pat_parts:
   970	        return not p_parts
   971	    head, rest = pat_parts[0], pat_parts[1:]
   972	    if head == "**":
   973	        # Zero-or-more: try consuming 0..len(p_parts) segments
   974	        for i in range(len(p_parts) + 1):
   975	            if _match_segments(p_parts[i:], rest):
   976	                return True
   977	        return False
   978	    if not p_parts:
   979	        return False
   980	    # Bare-* is equivalent to fnmatch "*", but we keep the explicit
   981	    # branch for readability. fnmatch.fnmatchcase does case-sensitive
   982	    # glob on a single segment (no "/" traversal).
   983	    if head == "*" or fnmatch.fnmatchcase(p_parts[0], head):
   984	        return _match_segments(p_parts[1:], rest)
   985	    return False
   986	
