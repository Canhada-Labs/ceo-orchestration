+  echo "$P166/pair-rail-verdict-v1.3.0-rc.3.TEMPLATE.md"
+  echo "$P166/verdict-fields-v1.3.0.TEMPLATE.md"
+  echo "$P166/pair-rail-verdict-v1.3.0.TEMPLATE.md"
