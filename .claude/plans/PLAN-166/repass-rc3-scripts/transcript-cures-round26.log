   145	def parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:
   146	    """Parse pin range like '>=0.128.0,<0.130.0'. Returns (min, max)."""
   147	    if not pin_file.exists():
   148	        return None, None
   149	    for line in pin_file.read_text().splitlines():
   150	        line = line.split("#", 1)[0].strip()
   151	        if not line:
   152	            continue
   153	        # parse `>=X.Y.Z,<A.B.C` shape
   154	        m = re.search(r">=\s*([\d.]+(?:[-+][\w.]+)?)\s*,\s*<\s*([\d.]+(?:[-+][\w.]+)?)", line)
   155	        if m:
   156	            return m.group(1), m.group(2)
   157	    return None, None
   158	
   159	
   160	def parse_semver(s: str) -> Tuple[int, int, int]:
   161	    m = re.match(r"(\d+)\.(\d+)\.(\d+)", s.strip())
   162	    if not m:
   163	        raise ValueError(f"unparseable semver: {s!r}")
   164	    return int(m.group(1)), int(m.group(2)), int(m.group(3))
   165	
   166	
   167	def semver_in_range(version: str, min_v: str, max_v: str) -> bool:
   168	    try:
   169	        v = parse_semver(version)
   170	        lo = parse_semver(min_v)
   171	        hi = parse_semver(max_v)
   172	        return lo <= v < hi
   173	    except ValueError:
   174	        return False
