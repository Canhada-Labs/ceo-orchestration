+    || die "pre-push: git status falhou"
+  [ -z "$_rp_st" ] || die "pre-push: arvore suja - limpe antes do push"
+  python3 .claude/scripts/local/_release_tag_guard.py delta \
+    --repo "$REPO" --tag "$TAG" || die "pre-push: guard delta recusou - NAO pushe"
