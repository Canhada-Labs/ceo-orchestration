+    --jq "[.[]|select(.headSha==\"$TAGSHA\" and .headBranch==\"$TAG\" and .event==\"push\")][0].status" 2>/dev/null || echo "")"
+  printf '  ... release.yml: %s/%s\n' "${s:-?}" "${c:-?}"
