   275	def delta(repo: str, tag: str, verdict_rel: Optional[str]) -> int:
   276	    verdict_rel = verdict_rel or (VERDICT_PREFIX + tag + ".md")
   277	    verdict_abs = os.path.join(repo, verdict_rel)
   278	    if not os.path.isfile(verdict_abs):
   279	        return _fail(
   280	            E_VERDICT,
   281	            "no signed verdict at %s — the re-pass verdict for THIS tag must "
   282	            "be committed before the tag is cut (release.yml validates it per "
   283	            "tag on the tagged tree)." % verdict_rel,
   284	        )
   285	    with open(verdict_abs, encoding="utf-8") as fh:
   286	        fields = _parse_verdict(fh.read())
   287	
   288	    release_tag = fields.get("release_tag")
