   343	                    f"INVALID: codex_cli version {cli_v!r} not in pin "
   344	                    f"range >={min_v},<{max_v}",
   345	                    file=sys.stderr,
   346	                )
   347	                return EXIT_VERDICT_INVALID
   348	
   349	    # PLAN-081 Phase 6-bis / T-8: Codex CLI binary SHA-256 pin enforcement
   350	    if args.codex_cli_binary_sha256_file:
   351	        pin_path = Path(args.codex_cli_binary_sha256_file)
   352	        if not pin_path.exists():
   353	            # ADVISORY skip per Codex iter-1 P1 — missing pin file is a
   354	            # rollout state (e.g. legacy verdicts pre-Phase-6-bis); do NOT
   355	            # hard-fail. release.yml step 15 still gates on the codex_cli
   356	            # semver pin (R1 C5) which is mandatory.
   357	            print(
