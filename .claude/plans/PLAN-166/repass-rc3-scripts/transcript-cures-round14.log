   130	  --stable               target $TARGET_BASE (post-hold promote)
   131	  --rc N                 target ${TARGET_BASE}-rc.N (default N=$RC_NUM)
   132	  --key KEYID            GPG key (default $SIGN_KEY)
   133	  --today YYYY-MM-DD     date stamped into the last-reviewed lines
   134	  --restamp              move the review stamps at an unchanged version
   135	                         (requires --npm-readme-reviewed)
   136	  --offline-ack          ancestry guard judges a possibly stale origin/main
   137	  --npm-readme-reviewed  assert npm/README.md was actually re-read
   138	
   139	The header of this file documents what the Owner signs, why this script never
   140	pushes, and why it never publishes.
   141	USAGE
   142	}
