   428	        except ValueError as e:
   429	            print(
   430	                f"INVALID: codex-pin-manifest-file is not valid JSON "
   431	                f"({e}) — fail-CLOSED per ADR-182",
   432	                file=sys.stderr,
   433	            )
   434	            return EXIT_VERDICT_INVALID
   435	        if (
   436	            not isinstance(manifest, dict)
   437	            or manifest.get("schema") != 1
   438	            or not isinstance(manifest.get("payloads"), dict)
   439	        ):
   440	            print(
   441	                "INVALID: codex-pin-manifest-file schema violation "
   442	                "(expected schema=1 + payloads dict) — fail-CLOSED per "
   443	                "ADR-182",
   444	                file=sys.stderr,
   445	            )
   446	            return EXIT_VERDICT_INVALID
   447	        tool_versions = verdict.get("tool_versions", {})
   448	        if not isinstance(tool_versions, dict):
   449	            print(
   450	                f"INVALID: tool_versions field must be a dict for "
   451	                f"payload-pin check, got "
   452	                f"{type(tool_versions).__name__}: {tool_versions!r}",
   453	                file=sys.stderr,
   454	            )
   455	            return EXIT_VERDICT_INVALID
   456	        declared_triple = str(
   457	            tool_versions.get("codex_target_triple", "")
   458	        ).strip()
   459	        declared_payload_sha = str(
   460	            tool_versions.get("codex_payload_sha256", "")
   461	        ).strip()
   462	        if not declared_triple or not declared_payload_sha:
   463	            print(
   464	                "INVALID: ADR-182 payload pin requested "
   465	                f"(manifest='{manifest_path}') but verdict envelope "
   466	                "lacks tool_versions.codex_target_triple and/or "
   467	                "tool_versions.codex_payload_sha256",
   468	                file=sys.stderr,
   469	            )
   470	            return EXIT_VERDICT_INVALID
   471	        entry = manifest["payloads"].get(declared_triple)
   472	        if not isinstance(entry, dict):
   473	            print(
   474	                f"INVALID: targetTriple '{declared_triple}' absent from "
   475	                f"codex-pin-manifest payloads — fail-CLOSED per ADR-182",
   476	                file=sys.stderr,
   477	            )
   478	            return EXIT_VERDICT_INVALID
   479	        expected_payload_sha = str(entry.get("sha256", "")).strip()
   480	        if not re.match(r"^[0-9a-f]{64}$", expected_payload_sha):
   481	            print(
   482	                f"INVALID: manifest entry for '{declared_triple}' has "
   483	                f"malformed sha256 — fail-CLOSED per ADR-182",
   484	                file=sys.stderr,
   485	            )
   486	            return EXIT_VERDICT_INVALID
   487	        if declared_payload_sha != expected_payload_sha:
   488	            print(
   489	                f"INVALID: codex_payload_sha256 mismatch for "
   490	                f"'{declared_triple}' — "
   491	                f"declared='{declared_payload_sha[:16]}', "
   492	                f"pin='{expected_payload_sha[:16]}'",
   493	                file=sys.stderr,
   494	            )
   495	            return EXIT_VERDICT_INVALID
   496	
   497	    # GPG signature presence (verifies via separate `git verify-tag` in
   498	    # release.yml; here we just assert the field is present + non-empty)
   499	    sig = verdict.get("gpg_signature", "")
   500	    if not sig or sig.strip() == "":
