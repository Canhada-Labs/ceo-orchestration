   177	def main(argv: Optional[List[str]] = None) -> int:
   178	    parser = argparse.ArgumentParser()
   179	    parser.add_argument("--verdict-file", required=True)
   180	    parser.add_argument(
   181	        "--parent-sha",
   182	        default="",
   183	        help=(
   184	            "Expected verdict.parent_sha — the commit the verdict was "
   185	            "generated against (parent of the verdict-file commit). "
   186	            "Resolves the self-reference problem the legacy --commit-sha "
   187	            "bind had with PLAN-081 v1.16.0 GA. Empty string = skip bind."
   188	        ),
   189	    )
   190	    parser.add_argument(
   191	        "--commit-sha",
   192	        default="",
   193	        help=(
   194	            "DEPRECATED legacy bind. Retained for backward-compat with "
   195	            "v1.16.0-era verdicts that ship `commit_sha:` field. "
   196	            "Mutually exclusive with --parent-sha; if both passed, "
   197	            "--parent-sha wins."
   198	        ),
   199	    )
   200	    parser.add_argument("--release-tag", required=True)
   201	    parser.add_argument("--max-age-hours", type=int, default=24)
   202	    parser.add_argument("--recompute-inputs-hash", action="store_true")
   203	    parser.add_argument("--codex-cli-pin-file", default="")
   204	    parser.add_argument("--codex-cli-binary-sha256-file", default="")
   205	    parser.add_argument(
   206	        "--codex-pin-manifest-file",
   207	        default="",
   208	        help=(
   209	            "ADR-182 payload-pin manifest (codex-cli-pin-manifest.json). "
   210	            "When passed, verdict.tool_versions.codex_target_triple + "
   211	            ".codex_payload_sha256 MUST match the manifest entry "
   212	            "(fail-CLOSED — VERDICT_INVALID on any miss)."
   213	        ),
   214	    )
   215	    parser.add_argument("--inputs-hash-paths-file", default="")
   216	    args = parser.parse_args(argv)
   217	
   218	    verdict_path = Path(args.verdict_file)
   219	    repo_root = Path.cwd()
   220	
   221	    # Parse verdict
   222	    try:
   223	        verdict = parse_verdict_file(verdict_path)
   224	    except FileNotFoundError as e:
   225	        print(f"INFRA: verdict file not found: {e}", file=sys.stderr)
   226	        return EXIT_INFRA_ERROR
   227	    except ValueError as e:
   228	        print(f"INFRA: verdict parse error: {e}", file=sys.stderr)
   229	        return EXIT_INFRA_ERROR
   230	
   231	    # R1 S-Sec-3: release_tag bind
   232	    declared_tag = verdict.get("release_tag", "").strip()
   233	    if declared_tag != args.release_tag:
   234	        print(
   235	            f"INVALID: verdict release_tag mismatch — "
   236	            f"declared='{declared_tag}', argv='{args.release_tag}'",
   237	            file=sys.stderr,
   238	        )
   239	        return EXIT_VERDICT_INVALID
   240	
   241	    # parent_sha / commit_sha bind (S104 redesign — see docstring).
   242	    # Precedence: --parent-sha (canonical, post-S104) wins. Falls back to
   243	    # legacy --commit-sha for v1.16.0-era verdicts that still ship the old
   244	    # field.
   245	    if args.parent_sha:
   246	        declared_parent = verdict.get("parent_sha", "").strip()
   247	        if not declared_parent:
   248	            # New-style validation requested but verdict lacks the field.
   249	            # Could be a stale verdict generated before the redesign. Fall
   250	            # back to legacy commit_sha if available; else hard-fail.
   251	            legacy_sha = verdict.get("commit_sha", "").strip()
   252	            if legacy_sha:
   253	                print(
   254	                    f"ADVISORY: verdict ships legacy commit_sha "
   255	                    f"(='{legacy_sha[:12]}'); --parent-sha bind skipped. "
   256	                    f"Re-author verdict with parent_sha for full S104 "
   257	                    f"bind enforcement.",
   258	                    file=sys.stderr,
   259	                )
   260	            else:
   261	                print(
   262	                    f"INVALID: verdict missing parent_sha field "
   263	                    f"(--parent-sha='{args.parent_sha[:12]}' requested bind)",
   264	                    file=sys.stderr,
   265	                )
   266	                return EXIT_VERDICT_INVALID
   267	        elif declared_parent != args.parent_sha:
   268	            print(
   269	                f"INVALID: verdict parent_sha mismatch — "
   270	                f"declared='{declared_parent[:12]}', "
   271	                f"argv='{args.parent_sha[:12]}'",
   272	                file=sys.stderr,
   273	            )
   274	            return EXIT_VERDICT_INVALID
   275	    elif args.commit_sha:
   276	        # Legacy path — only used when --parent-sha not passed (e.g.
   277	        # bridging older release.yml invocations against new validator).
   278	        declared_sha = verdict.get("commit_sha", "").strip()
   279	        if declared_sha != args.commit_sha:
   280	            print(
   281	                f"INVALID: verdict commit_sha mismatch — "
   282	                f"declared='{declared_sha[:12]}', argv='{args.commit_sha[:12]}'",
   283	                file=sys.stderr,
   284	            )
   285	            return EXIT_VERDICT_INVALID
   286	
   287	    # R1 S-QA-Unseen-2: VERDICT_EXPIRED distinct exit code
   288	    generated_at = verdict.get("generated_at", "")
   289	    if generated_at:
   290	        try:
   291	            ts = datetime.fromisoformat(generated_at.rstrip("Z"))
   292	            if ts.tzinfo is None:
   293	                ts = ts.replace(tzinfo=timezone.utc)
   294	            now = datetime.now(timezone.utc)
   295	            age_hours = (now - ts).total_seconds() / 3600.0
   296	            if age_hours > args.max_age_hours:
   297	                print(
   298	                    f"EXPIRED: verdict {age_hours:.1f}h old "
   299	                    f"(max {args.max_age_hours}h)",
   300	                    file=sys.stderr,
   301	                )
   302	                return EXIT_VERDICT_EXPIRED
   303	        except (TypeError, ValueError):
   304	            print(f"INFRA: unparseable generated_at: {generated_at!r}", file=sys.stderr)
   305	            return EXIT_INFRA_ERROR
   306	
   307	    # R1 S-Sec-4: inputs_hash recompute
   308	    if args.recompute_inputs_hash and args.inputs_hash_paths_file:
   309	        try:
   310	            actual_hash = compute_inputs_hash(
   311	                repo_root, Path(args.inputs_hash_paths_file)
   312	            )
   313	        except (FileNotFoundError, ValueError) as e:
   314	            print(f"INFRA: inputs_hash recompute failed: {e}", file=sys.stderr)
   315	            return EXIT_INFRA_ERROR
   316	        declared_hash = verdict.get("inputs_hash", "").strip()
   317	        if declared_hash != actual_hash:
   318	            print(
   319	                f"INVALID: inputs_hash mismatch — "
   320	                f"declared='{declared_hash[:16]}', actual='{actual_hash[:16]}'",
   321	                file=sys.stderr,
   322	            )
   323	            return EXIT_VERDICT_INVALID
   324	
   325	    # R1 C5: Codex CLI pin enforcement
   326	    if args.codex_cli_pin_file:
   327	        min_v, max_v = parse_pin_range(Path(args.codex_cli_pin_file))
   328	        if min_v and max_v:
   329	            tool_versions = verdict.get("tool_versions", {})
   330	            if not isinstance(tool_versions, dict):
   331	                # Codex iter-6 P1 fix — malformed tool_versions (scalar /
   332	                # non-dict) previously bypassed both semver + binary-SHA
   333	                # checks. Now hard-fail.
   334	                print(
   335	                    f"INVALID: tool_versions field must be a dict, got "
   336	                    f"{type(tool_versions).__name__}: {tool_versions!r}",
   337	                    file=sys.stderr,
   338	                )
   339	                return EXIT_VERDICT_INVALID
   340	            cli_v = tool_versions.get("codex_cli", "")
