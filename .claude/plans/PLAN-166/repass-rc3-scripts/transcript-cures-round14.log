   183	export GPG_TTY
   184	
   185	# Every file the bump phase may write — DERIVED, never typed. A hand-kept
   186	# restore list is how a dry-run left debris behind once already (S273): the
   187	# writer grew a site, the restore list did not. `--include-generated` adds the
   188	# two plugin manifests, which `build-plugin.py --write-manifests` rewrites
   189	# from VERSION during the bump.
   190	sites_out="$(python3 "$BUMP_SITES" print-sites --include-generated)" \
   191	  || die "cannot enumerate version sites from $BUMP_SITES"
   192	VERSION_FILES=()
   193	while IFS= read -r _site; do
   194	  [ -n "$_site" ] || continue
   195	  VERSION_FILES+=("$_site")
   196	done <<< "$sites_out"
   197	[ "${#VERSION_FILES[@]}" -gt 0 ] || die "$BUMP_SITES returned no version sites"
   198	
   199	printf 'release driver — target %s (tag %s), phase=%s, dry-run=%s, today=%s\n' \
   200	  "$TARGET_VERSION" "$TARGET_TAG" "$PHASE" "$DRY_RUN" "$TODAY"
   201	
   202	# ---------------------------------------------------------------------------
   203	# Dry-run safety net. Snapshot every file the `bump` phase writes plus the
   204	# index state, and restore both on ANY exit path.
   205	# ---------------------------------------------------------------------------
   206	SNAPSHOT_ARMED=0
   207	restore_snapshot() {
   208	  [ "$SNAPSHOT_ARMED" -eq 1 ] || return 0
   209	  # The bump phase refuses to run on a dirty tree (untracked included), so
   210	  # HEAD is exactly the pre-bump state: reset unstages, checkout restores
   211	  # content. Both halves are needed — an index-only restore leaves the files
   212	  # modified, and a content-only restore leaves them staged (the S273 trap).
   213	  #
   214	  # PER PATH, never one multi-path command: `git checkout -- a b c` is
   215	  # ATOMIC — a single path absent from HEAD (a file the bump CREATED, e.g. a
   216	  # plugin manifest on its first appearance) aborts the WHOLE command and
   217	  # restores nothing, and the old `|| true` swallowed that error while the
   218	  # message below still claimed success. A path HEAD carries is checked out;
   219	  # a path HEAD does not carry was created by the bump and is removed.
   220	  local _p _dirty
   221	  for _p in "${VERSION_FILES[@]}"; do
   222	    git reset --quiet HEAD -- "$_p" 2>/dev/null || true
   223	    if git cat-file -e "HEAD:$_p" 2>/dev/null; then
   224	      git checkout --quiet -- "$_p" 2>/dev/null || true
   225	    else
   226	      rm -f "$_p" 2>/dev/null || true
   227	      # a directory created for that file may remain; drop it only if empty
   228	      # (never recursive — this is a restore, not a cleanup)
   229	      rmdir "$(dirname "$_p")" 2>/dev/null || true
   230	    fi
   231	  done
   232	  # ASSERT the postcondition, not the attempt: worktree AND index must be
   233	  # clean across every derived path, or this dry-run left debris and the only
   234	  # honest exit is a loud non-zero — printing "restored" over a dirty tree is
   235	  # the S273 class silenced instead of closed.
   236	  # The verification itself is fail-CLOSED (codex W0-residuals round): if
   237	  # `git status` ERRORS (repo/permission/object failure), an `|| true` here
   238	  # would read as "empty = clean" and print "asserted clean" over a
   239	  # postcondition that was never checked — capture the exit status instead.
   240	  _dirty="$(git status --porcelain -- "${VERSION_FILES[@]}" 2>/dev/null)"
   241	  _status_rc=$?
   242	  if [ "$_status_rc" -ne 0 ]; then
   243	    printf 'FAIL: dry-run restore verification could not run (git status rc=%s) — tree state UNVERIFIED, refusing to report clean\n' "$_status_rc" >&2
   244	    exit 1
   245	  fi
   246	  if [ -n "$_dirty" ]; then
   247	    printf 'FAIL: dry-run restore left these paths dirty (worktree/index != HEAD):\n' >&2
   248	    printf '%s\n' "$_dirty" >&2
   249	    exit 1
   250	  fi
   251	  printf '  --   dry-run: working tree AND index restored to HEAD (asserted clean)\n'
   252	}
   253	
   254	take_snapshot() {
   255	  SNAPSHOT_ARMED=1
   256	  trap restore_snapshot EXIT INT TERM
   257	}
   258	
   259	hint_next_phase() {
   260	  # Test the VALUE: `${STABLE:+...}` expands for STABLE=0 (a non-empty string)
   260	  # Test the VALUE: `${STABLE:+...}` expands for STABLE=0 (a non-empty string)
   261	  # and would tell the Owner to cut the STABLE tag during an RC run.
   262	  if [ "$STABLE" -eq 1 ]; then
   263	    note "proceed to: bash $0 tag --stable"
   264	  else
   265	    note "proceed to: bash $0 tag --rc $RC_NUM"
   266	  fi
   267	}
   268	
   269	# ---------------------------------------------------------------------------
   270	# Preflight — every gate fail-closed. Mirrors `.github/release-checklist.md`
   271	# and runs the SAME suites CI runs (a subset gate passes while CI is red; that
   272	# lesson is expensive and already paid).
   273	# ---------------------------------------------------------------------------
   274	preflight() {
   275	  hdr "git state"
   276	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — commit or stash first"
   277	  ok "tree clean"
   278	
   279	  branch="$(git rev-parse --abbrev-ref HEAD)"
   280	  [ "$branch" = "main" ] || die "on branch '$branch' — releases are cut from main"
   281	  ok "on main"
   282	
   283	  git fetch --quiet origin main || die "git fetch origin main failed"
   284	  local_sha="$(git rev-parse HEAD)"
   285	  remote_sha="$(git rev-parse origin/main)"
   286	  [ "$local_sha" = "$remote_sha" ] \
   287	    || die "HEAD ($local_sha) != origin/main ($remote_sha) — push or pull first"
   288	  ok "HEAD == origin/main ($local_sha)"
   289	
   290	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   291	    && die "tag $TARGET_TAG already exists"
   292	  ok "tag $TARGET_TAG is free"
   293	
   294	  hdr "CI for HEAD"
   295	  if command -v gh >/dev/null 2>&1; then
   296	    runs="$(gh run list --limit 40 \
   297	      --json headSha,conclusion,status,workflowName 2>/dev/null || true)"
   298	    if [ -n "$runs" ]; then
   299	      verdict="$(mktemp)"
   300	      printf '%s' "$runs" | HEAD_SHA="$local_sha" python3 -c '
   301	import json, os, sys
   302	sha = os.environ["HEAD_SHA"]
   303	runs = [r for r in json.load(sys.stdin) if r.get("headSha") == sha]
   304	if not runs:
   305	    print("NO_RUNS"); sys.exit(0)
   306	bad = [r for r in runs if r.get("conclusion") not in ("success", "skipped", "")]
   307	pend = [r for r in runs if r.get("status") != "completed"]
   308	val = [r for r in runs if "Validate" in (r.get("workflowName") or "")]
   309	for r in bad:
   310	    print("BAD %s=%s" % (r["workflowName"], r["conclusion"]))
   311	for r in pend:
   312	    print("PENDING %s" % r["workflowName"])
   313	if not any(r.get("conclusion") == "success" for r in val):
   314	    print("NO_VALIDATE_SUCCESS")
   315	' > "$verdict" || die "CI verdict parse failed"
   316	      if grep -q '^BAD ' "$verdict"; then
   317	        cat "$verdict" >&2; rm -f "$verdict"
   318	        die "a workflow for HEAD is not green"
   319	      fi
   320	      if grep -q '^PENDING ' "$verdict"; then
   321	        cat "$verdict" >&2; rm -f "$verdict"
   322	        die "a workflow for HEAD is still running — wait for it"
   323	      fi
   324	      if grep -q 'NO_VALIDATE_SUCCESS' "$verdict"; then
   325	        rm -f "$verdict"
   326	        die "no successful Validate run for HEAD"
   327	      fi
   328	      if grep -q 'NO_RUNS' "$verdict"; then
   329	        rm -f "$verdict"
   330	        die "no CI runs found for HEAD — push it and let CI run"
   331	      fi
   332	      rm -f "$verdict"
   333	      ok "all workflows for HEAD green (Validate success)"
   334	    else
   335	      die "gh returned no run data — cannot confirm CI (fail-closed)"
   336	    fi
   337	  else
   338	    die "gh CLI not available — cannot confirm CI (fail-closed)"
   339	  fi
   340	
   341	  # These MUST be the invocations validate.yml uses, not `unittest discover`.
   342	  # The suite is pytest-only BY CONSTRUCTION: conftest.py carries the sys.path
   343	  # bootstrap and the _lib resolution guards as pytest collection hooks, and
   344	  # several modules isolate their environment with pytest `autouse` fixtures.
   345	  # `unittest discover` loads none of that, so those modules run with their
   346	  # declared isolation silently disabled — which leaks CLAUDE_PROJECT_DIR into
   347	  # later modules. test_flip_closures then resolves settings.json /
   348	  # red-team.yml under a dead tmp dir and reports that files which plainly
   349	  # exist "must exist". It passes 12/12 when run alone. Diagnosed 2026-08-02
   350	  # during a GA promote; the old invocation made this gate a FALSE RED that
   351	  # blocked a release whose CI was green.
   352	  hdr "test suites (the same ones CI runs)"
   353	  python3 -m pytest .claude/hooks/tests/ -n auto -m 'not serial' \
   354	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   355	    || die "hooks test suite failed (not serial)"
   356	  python3 -m pytest .claude/hooks/tests/ -m 'serial' \
   357	    --strict-markers --tb=no -q >/dev/null 2>&1 \
   358	    || die "hooks test suite failed (serial)"
   359	  ok "hooks tests pass"
   360	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   361	    -n auto -m 'not serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   362	    || die "scripts test suite failed (not serial)"
   363	  python3 -m pytest .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
   364	    -m 'serial' --strict-markers --tb=no -q >/dev/null 2>&1 \
   365	    || die "scripts test suite failed (serial)"
   366	  ok "scripts tests pass"
   367	
   368	  hdr "governance gates"
   369	  bash .claude/scripts/validate-governance.sh >/dev/null 2>&1 \
   370	    || die "validate-governance.sh nonzero"
   371	  ok "validate-governance"
   372	  bash .claude/scripts/check-contamination.sh >/dev/null 2>&1 \
   373	    || die "check-contamination.sh nonzero"
   374	  ok "check-contamination"
   375	  python3 .claude/scripts/check-claude-md-claims.py >/dev/null 2>&1 \
   376	    || die "check-claude-md-claims.py nonzero"
   377	  ok "CLAUDE.md claims"
   378	  bash .claude/scripts/local/verify-counts.sh --quiet >/dev/null 2>&1 \
   379	    || die "verify-counts.sh reports drift"
   380	  ok "derived counts (no drift)"
   381	
   382	  hdr "release artifacts"
   383	  grep -q "^## \[${TARGET_BASE}\]" CHANGELOG.md \
   384	    || die "CHANGELOG.md has no '## [${TARGET_BASE}]' entry"
   385	  ok "CHANGELOG has [${TARGET_BASE}]"
   386	
   387	  # Two gates that burned earlier RCs — release.yml enforces both and neither
   388	  # is covered by verify-counts, so the preflight mirrors them:
   389	  python3 scripts/build-plugin.py --check >/dev/null 2>&1 \
   390	    || die "plugin manifests out of sync (run: python3 scripts/build-plugin.py --write-manifests)"
   391	  ok "plugin manifests in sync with generator"
   392	  python3 .claude/scripts/check-canonical-doc-freshness.py >/dev/null 2>&1 \
   393	    || {
   394	      python3 .claude/scripts/check-canonical-doc-freshness.py 2>&1 | grep '!!' >&2 || true
   395	      die "canonical doc freshness gate red (stale last-reviewed stamps; review + re-stamp the docs listed above)"
   396	    }
   397	  ok "canonical doc freshness (review stamps current)"
   398	
   399	  cur_version="$(tr -d ' \n' < VERSION)"
   400	  if [ "$cur_version" = "$TARGET_BASE" ]; then
   401	    note "VERSION already $TARGET_BASE — bump phase is a no-op (expected on promote)"
   402	  else
   403	    note "VERSION is $cur_version, becomes $TARGET_BASE in the bump phase"
   404	  fi
   405	
   406	  hdr "signing key (proves it can actually sign — not just that it exists)"
   407	  gpg --list-secret-keys "$SIGN_KEY" >/dev/null 2>&1 \
   408	    || die "no secret key $SIGN_KEY in the keyring"
   409	  ok "secret key $SIGN_KEY present"
   410	  sig_probe="$(mktemp)"
   411	  if printf 'release-preflight-probe' \
   412	      | gpg --local-user "$SIGN_KEY" --armor --detach-sign --output "$sig_probe" \
   413	        >/dev/null 2>&1; then
   414	    ok "inline signature probe succeeded (pinentry works)"
   415	  else
   416	    rm -f "$sig_probe"
   417	    die "the key cannot sign right now — try: gpgconf --kill gpg-agent; export GPG_TTY=\$(tty)"
   418	  fi
   419	  rm -f "$sig_probe"
   420	
   421	  printf '\nPREFLIGHT GREEN for %s\n' "$TARGET_TAG"
   422	}
   423	
   424	# ---------------------------------------------------------------------------
   425	# Bump.
   426	#
   427	# The site table lives in `_release_bump_sites.py` and NOWHERE else: this
   428	# driver invokes it, and derives the dry-run restore list from it.
   429	#
   430	# The version written is always the BARE semver ($TARGET_BASE), never
   431	# X.Y.Z-rc.N. Two independent reasons: (a) precedent — every previous RC
   432	# carries the bare version in VERSION, the RC lives only in the tag name;
   433	# (b) every gate regex matches `\d+\.\d+\.\d+` only, so an -rc.N string would
   434	# match NOTHING and the gate would pass VACUOUSLY — silently stopping the
   435	# drift check exactly when it matters most.
   436	#
   437	# IDEMPOTENCE (F2, the v1.3.0-rc.1 re-pass). A bump on a tree that is already
   438	# at the target must write NOTHING — not one byte, not one index entry. It
   439	# used to re-date four `last-reviewed:` stamps with today date, which on D+1
   440	# of the ADR-103 hold produced a dirty tree, then a commit made AFTER the
   441	# preflight proved CI green, which `tag()` then signed. That commit was also
   442	# invisible to the pair-rail step 15 (none of the four files is in
   443	# `pair-rail-inputs-hash-manifest.txt`). Two independent defenses now:
   444	#   1. the same-tree predicate below (four oracles) short-circuits the phase;
   445	#   2. the writer skips each stamp line whose version is already the target.
   446	# ---------------------------------------------------------------------------
   447	_oracle() {
   448	  label="$1"; shift
   449	  if "$@" >/dev/null 2>&1; then
   450	    printf '  --   oracle %s: PASS  (%s)\n' "$label" "$*"
   451	    return 0
   452	  fi
   453	  printf '  --   oracle %s: RED   (%s)\n' "$label" "$*"
   454	  return 1
   455	}
   456	
   457	# All four are required. The fourth is not redundant: it is the ONLY watcher
   458	# of the SBOM/SECURITY/VERSIONING stamps, which are outside the VERSION_SITES
   459	# of verify-counts. Without it an external no-op would block the in-loop
   460	# self-heal from ever running over a stale stamp. Freezing the DATE is safe
   461	# because the freshness gate decides on the stamp VERSION, not its date.
   462	tree_already_at_target() {
   463	  cur_version="$(tr -d ' \n' < VERSION)"
   464	  printf '  --   oracle 1/4: VERSION=%s, target=%s\n' "$cur_version" "$TARGET_BASE"
   465	  [ "$cur_version" = "$TARGET_BASE" ] || return 1
   466	  _oracle "2/4" bash .claude/scripts/local/verify-counts.sh --quiet --no-tests || return 1
   467	  _oracle "3/4" python3 scripts/build-plugin.py --check || return 1
   468	  _oracle "4/4" python3 .claude/scripts/check-canonical-doc-freshness.py || return 1
   469	  return 0
   470	}
   471	
   472	bump() {
   473	  hdr "bump version sites to $TARGET_BASE"
   474	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to bump"
   475	
   476	  if [ "$RESTAMP" -eq 1 ] && [ "$NPM_README_REVIEWED" -eq 0 ]; then
   477	    die "--restamp moves every last-reviewed stamp — it REQUIRES --npm-readme-reviewed, otherwise it is exactly the tripwire bypass the stamp exists to prevent"
   478	  fi
   479	
   480	  if [ "$RESTAMP" -eq 1 ]; then
   481	    hdr "restamp requested — no-op fast path DISABLED by design"
   482	    note "in the normal re-review case (same version, four clean oracles) the"
   483	    note "predicate would return BEFORE any substitution and --restamp would"
   484	    note "be dead letter. It is skipped so a real re-review can be recorded."
   485	  else
   486	    hdr "same-tree predicate — four oracles, ALL required"
   487	    if tree_already_at_target; then
   488	      ok "no-op: tree is already at $TARGET_BASE and all four oracles are clean"
   489	      note "NOTHING was written: not a file, not an index entry. The"
   490	      note "post-condition of this phase (tree at $TARGET_BASE, gates green) is"
   491	      note "already satisfied, so a no-op bump is SUCCESS, not failure."
   492	      note "For a genuine re-review of the docs: --restamp --npm-readme-reviewed"
   493	      hint_next_phase
   494	      return 0
   495	    fi
   496	    note "at least one oracle is unsatisfied — running the bump"
   497	  fi
   498	
   499	  # The npm/README.md stamp is a DELIBERATE release tripwire: its date+version
   500	  # line asserts the npm-facing copy was re-read for this release. Re-stamping
   501	  # it silently would defeat the whole purpose of the gate, so it takes an
   502	  # explicit acknowledgement. Checked AFTER the no-op predicate on purpose: a
   503	  # run that writes nothing asserts nothing, and demanding the flag there would
   504	  # be asking the Owner to certify a review that is not happening.
   505	  if [ "$NPM_README_REVIEWED" -eq 0 ]; then
   506	    cat >&2 <<'EOF'
   507	FAIL: npm/README.md carries a "last-reviewed: <date> v<version>" stamp, and
   508	      verify-counts treats it as a release tripwire — bumping it asserts that
   509	      the npm-facing README was actually re-read for this release.
   510	
   511	      Read npm/README.md, then re-run with --npm-readme-reviewed.
   512	EOF
   513	    exit 1
   514	  fi
   515	
   516	  [ "$DRY_RUN" -eq 1 ] && take_snapshot
   517	
   518	  if [ "$RESTAMP" -eq 1 ]; then
   519	    python3 "$BUMP_SITES" bump --target "$TARGET_BASE" --today "$TODAY" --restamp \
   520	      || die "version-site bump failed"
   521	  else
   522	    python3 "$BUMP_SITES" bump --target "$TARGET_BASE" --today "$TODAY" \
   523	      || die "version-site bump failed"
   524	  fi
   525	
   526	  # Plugin manifests (.claude-plugin/{plugin,marketplace}.json) are GENERATED
   527	  # from VERSION, never hand-patched. The release.yml gate "Assert plugin
   528	  # manifest versions match VERSION" enforces them — and verify-counts does
   529	  # NOT, which is exactly how the v1.2.0-rc.1 run went red: the manifests were
   530	  # version sites invisible to the local oracle.
   531	  python3 scripts/build-plugin.py --write-manifests >/dev/null 2>&1 \
   532	    || die "build-plugin.py --write-manifests failed"
   533	  python3 scripts/build-plugin.py --check >/dev/null 2>&1 \
   534	    || die "plugin manifests still out of sync with the generator"
   535	  ok "plugin manifests regenerated from VERSION (build-plugin.py)"
   536	
   537	  # verify-counts covers the doc/package sites; the release.yml gate family
   538	  # covers the plugin manifests; the freshness gate covers the review stamps
   539	  # outside both. NOT ONE of them is the full oracle — the union is. If a new
   540	  # site is added upstream, expect it to surface in one of the three, and
   541	  # mirror it into _release_bump_sites.py.
   542	  bash .claude/scripts/local/verify-counts.sh --quiet --no-tests >/dev/null 2>&1 \
   543	    || {
   544	      bash .claude/scripts/local/verify-counts.sh --json --no-tests 2>&1 \
   545	        | python3 -c 'import json,sys
   546	d = json.load(sys.stdin)
   547	for v in d.get("violations", []):
   548	    print("  !!   " + v, file=sys.stderr)' || true
   549	      die "verify-counts still reports version drift — a site is unpatched (see above)"
   550	    }
   551	  ok "verify-counts clean across the doc/package version sites"
   552	
   553	  if [ "$DRY_RUN" -eq 1 ]; then
   554	    git --no-pager diff --stat || true
   555	    note "dry-run: no commit made"
   556	    return 0
   557	  fi
   558	
   559	  git add -A
   560	  # IDEMPOTENCE, second rail. Even past the predicate, if nothing ended up
   561	  # staged an unconditional `git commit` would DIE and the documented
   562	  # three-phase path would be unusable exactly when the gates are green.
   563	  if git diff --cached --quiet; then
   564	    ok "nothing to commit — tree already at ${TARGET_BASE} (idempotent no-op)"
   565	    hint_next_phase
   566	    return 0
   567	  fi
   568	  git commit -q -m "release: v${TARGET_BASE}
   569	
   570	Version bump across every site the three oracles enforce (the doc/package
   571	sites of verify-counts, the plugin manifests regenerated by build-plugin.py,
   572	and the last-reviewed stamps watched by check-canonical-doc-freshness.py) for
   573	${TARGET_TAG}. The site table is .claude/scripts/local/_release_bump_sites.py.
   574	
   575	VERSION carries the BARE semver: the RC lives only in the tag name. An -rc.N
   576	string in VERSION would match none of the \\d+.\\d+.\\d+ patterns of the gate and
   577	the drift check would pass vacuously.
   578	
   579	CHANGELOG entry [${TARGET_BASE}] landed separately; its counts are
   580	reproducible via .claude/scripts/local/verify-counts.sh."
   581	  ok "commit $(git rev-parse --short HEAD)"
   582	
   583	  cat >&2 <<EOF
   584	
   585	  NOTE: this bump created a commit. The ancestry guard of the tag phase
   586	  requires HEAD to be an ancestor of origin/main, so PUSH main and let CI run
   587	  before tagging — a tag on an unpushed commit points at a tree CI never saw.
   588	EOF
   589	}
   590	
   591	# ---------------------------------------------------------------------------
   592	# Tag — annotated + GPG-signed INLINE. The tag message is the Owner-visible
   593	# artifact; pushing it starts release.yml AND npm-publish.yml.
   594	#
   595	# Two fail-closed guards run first, for RC and stable ALIKE. Scoping them to
   596	# `--stable` would let an rc.N ship a post-review commit and then become the
   597	# unreviewed baseline the GA is promoted from.
   598	#
   599	# THE LOCAL ASSERT IS NOT ENOUGH — say it out loud. A tag signed by hand skips
   600	# this driver entirely, and the pair-rail step 15 recomputes inputs_hash only
   601	# over `pair-rail-inputs-hash-manifest.txt`, which deliberately EXCLUDES the
   602	# bump surfaces (including them would make every legitimate bump change the
   603	# inputs_hash and break the verdict replay). The same restricted-delta assert
   604	# therefore goes SERVER-SIDE into `.github/workflows/release.yml` in PLAN-166
   605	# W1. release.yml is canonical: it changes under the GPG ceremony, not here.
   606	# `_release_tag_guard.py` is the reference implementation for both.
   607	# ---------------------------------------------------------------------------
   608	tag() {
   609	  hdr "sign tag $TARGET_TAG"
   610	  [ -z "$(git status --porcelain)" ] || die "working tree dirty — refusing to tag"
   611	
   612	  # VERSION carries the BARE semver even for an RC tag (see the bump header),
   613	  # so compare against $TARGET_BASE, never $TARGET_VERSION.
   614	  cur_version="$(tr -d ' \n' < VERSION)"
   615	  [ "$cur_version" = "$TARGET_BASE" ] \
   616	    || die "VERSION is '$cur_version', expected $TARGET_BASE for $TARGET_TAG — run the bump phase first"
   617	  ok "VERSION ($cur_version) matches the base version of the tag"
   618	
   619	  git rev-parse -q --verify "refs/tags/$TARGET_TAG" >/dev/null 2>&1 \
   620	    && die "tag $TARGET_TAG already exists"

