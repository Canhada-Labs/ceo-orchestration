   330	          VERSION="${TAG#v}"
   331	          # PLAN-153 Wave B item 5 (c) — same RC normalization as the
   332	          # "Assert VERSION matches tag" step above: RC tags never get
   333	          # their own CHANGELOG section; an RC for X.Y.Z validates
   334	          # against the GA `## [X.Y.Z]` section (which exists at RC-cut
   335	          # time because the VERSION bump + CHANGELOG entry land before
   336	          # the RC is tagged). Without this strip the fixed VERSION gate
   337	          # would just move the RC red run one step later.
   338	          VERSION="${VERSION%-rc.[0-9]*}"
