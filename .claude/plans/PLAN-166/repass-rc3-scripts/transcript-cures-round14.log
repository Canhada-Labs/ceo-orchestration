   417	        try:
   418	            manifest_raw = manifest_path.read_text(encoding="utf-8")
   419	        except OSError as e:
   420	            print(
   420	            print(
   421	                f"INFRA: codex-pin-manifest-file unreadable at "
   422	                f"{manifest_path}: {e}",
   423	                file=sys.stderr,
   424	            )
