+echo "   aguardando npm-publish.yml da TAG (aprove production-npm quando o run pedir)"
+_url_shown=0
+i=0
+while :; do
+  i=$((i+1))
+  if [ "$i" -gt 90 ]; then
+    bell "timeout do npm - draftando o Release GA"
