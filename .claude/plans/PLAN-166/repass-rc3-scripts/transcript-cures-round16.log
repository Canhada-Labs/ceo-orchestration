+    --json headSha,status,conclusion \
+    --jq "[.[]|select(.headSha==\"$TAGSHA\")][0].conclusion" 2>/dev/null || echo "")"
+  printf '  ... npm-publish: %s/%s\n' "${ns:-?}" "${nc:-?}"
