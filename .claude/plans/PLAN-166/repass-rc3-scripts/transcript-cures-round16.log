   396	            E_VERDICT,
   397	            "verdict %s carries no `delta_manifest:` — without it the "
   398	            "re-pass artifacts close by NAME only, and any file dropped into "
   399	            "the directory after the review would pass." % verdict_rel,
   400	        )
   401	    if not isinstance(manifest_sha, str) or not HEX64.match(manifest_sha):
   402	        return _fail(
   403	            E_VERDICT,
   404	            "verdict %s has no usable 64-hex `delta_manifest_sha256:`."
   405	            % verdict_rel,
   406	        )
   407	    if manifest_rel not in allow_set:
   408	        return _fail(
   409	            E_VERDICT,
   410	            "delta_manifest %s is not in delta_allowlist." % manifest_rel,
   411	        )
   412	
   413	    # --- content pin: the manifest itself, then everything it lists ---
   414	    manifest_abs = os.path.join(repo, manifest_rel)
   415	    if not os.path.isfile(manifest_abs):
   416	        return _fail(E_MANIFEST_PIN, "delta_manifest %s missing" % manifest_rel)
   417	    actual = _sha256(manifest_abs)
