+  die "npm view devolveu '$NPMV' apos 5 tentativas - GA draftado automaticamente; re-rode este script (MONITORAMENTO retoma e undrafta quando o registry confirmar)"
+fi
+echo "   npm confirmado: ceo-orchestration@$NPMV"
