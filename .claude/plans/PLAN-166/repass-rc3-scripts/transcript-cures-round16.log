    69	import argparse
    70	import hashlib
    71	import os
    72	import re
    73	import subprocess
    74	import sys
    75	from typing import Dict, List, Optional, Sequence, Set, Tuple
    76	
    77	E_USAGE = 2
    78	E_FETCH = 3
    79	E_NOT_ANCESTOR = 4
    80	E_REMOTE_REF = 5
    81	E_DELTA = 6
    82	E_MANIFEST_PIN = 7
    83	E_MANIFEST_CONTENT = 8
    84	E_MANIFEST_SET = 9
    85	E_VERDICT = 10
    86	E_VACUOUS = 11
    87	E_PARENT_NOT_ANCESTOR = 12
