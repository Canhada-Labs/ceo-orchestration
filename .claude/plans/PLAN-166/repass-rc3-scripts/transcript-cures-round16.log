   468	      # -----------------------------------------------------------------
   469	      # PLAN-012 Phase 2 §R11 — weekly-workflow status gate.
   470	      # PLAN-019 P2 DevOps-P2-1 — 14-day staleness check added.
   471	      #
   472	      # Before a tag ships, assert that recent runs of the six advisory
   473	      # workflows (chaos, otel-smoke, perf-profile, adapter-live,
   474	      # red-team, formal-verify) have NOT been failing AND are fresh
   475	      # (most-recent run within 14 days). A red chaos.yml in the past 3
   476	      # runs means we have live regressions that a tag should not paper
   477	      # over. A stale workflow (no runs in 14 days) means the advisory
   478	      # check is silently disabled — kill switch, cron disabled, or
   479	      # workflow deleted.
   480	      #
   481	      # Staleness defense (P2 DevOps-P2-1): absence of runs is NOT
   482	      # neutral. Prior logic treated "no runs" as pass — a 1-year-old
   483	      # repo with 0 runs silently passed, turning the gate into a
   484	      # honeypot. Now: most-recent run must have started within 14 days
   485	      # OR the gate fails with `Workflow X stale — last run N days ago`.
   486	      #
   487	      # Uses `gh run list` against the REST API via $GITHUB_TOKEN; read
   488	      # permission on `actions` is granted at job level.
   489	      # -----------------------------------------------------------------
   490	      - name: Weekly workflow status gate (advisory health check + 14-day staleness, waiver-aware)
   491	        env:
   492	          GH_TOKEN: ${{ github.token }}
   493	        run: |
   494	          set -euo pipefail
   495	          TAG="${GITHUB_REF_NAME}"
   496	          VERSION="${TAG#v}"
   497	
   498	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment
   499	          # extension). Same waiver registry as the RC-hold gate:
   500	          # pre-GA phase with adopter_count=0 waives advisory-workflow
   501	          # staleness per Owner authorization. Post-first-adopter, the
   502	          # waiver file is expected to be empty and the gate resumes
   503	          # default enforcement.
   504	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   505	          if [[ -f "$WAIVER_FILE" ]]; then
   506	            if awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   507	              echo "::notice::$TAG has a pre-GA waiver in $WAIVER_FILE — skipping weekly workflow staleness gate"
   508	              exit 0
   509	            fi
   510	          fi
   511	
   512	          # PLAN-025 Batch G F-wf-002: fail-fast if gh is unavailable (rare
   513	          # on ubuntu-latest but not impossible on custom runners). Clearer
   514	          # error than "gh: command not found" in an obscure subshell.
   515	          command -v gh >/dev/null 2>&1 || {
   516	            echo "::error::gh CLI not found on runner; install via \"sudo apt-get install gh\" or use actions/setup-gh"
   517	            exit 1
   518	          }
   519	          # Tolerance: each workflow is checked across the last 3 runs.
   520	          # If ANY run in that window is `failure` → fail the release.
   521	          # `skipped` runs are fine (kill-switch or paths-filter).
   522	          WORKFLOWS=(chaos.yml otel-smoke.yml perf-profile.yml adapter-live.yml red-team.yml formal-verify.yml)
   523	          STALENESS_DAYS=14
   524	          STALENESS_SECS=$((STALENESS_DAYS * 86400))
   525	          NOW_SECS=$(date -u +%s)
   526	          FAILED=0
   527	          for wf in "${WORKFLOWS[@]}"; do
   528	            # Fetch up to 3 runs with both conclusion AND startedAt timestamp.
   529	            runs_json=$(gh run list --workflow "$wf" --limit 3 \
   530	              --json conclusion,startedAt 2>/dev/null || echo "[]")
   531	            if [ -z "$runs_json" ] || [ "$runs_json" = "[]" ]; then
   532	              # Absence of runs is NOT neutral post-DevOps-P2-1: it means
   533	              # the advisory workflow has never triggered in this repo.
   534	              # For a mature release (v1.x.y), that's a bug — kill switch
   535	              # set, cron disabled, or workflow deleted.
   536	              echo "::error::$wf — zero runs recorded; staleness gate fails"
   537	              FAILED=1
   538	              continue
   539	            fi
   540	            # Extract conclusions for the failure-scan logic.
   541	            # Session 33 refinement: the previous rule "any failure in
   542	            # last 3 → block" did not distinguish "past bug, now fixed"
   543	            # from "still broken / intermittent flake". Both classes
   544	            # block release, but only the second is a real tag risk.
   545	            # New rule: block iff BOTH of these hold simultaneously:
   546	            #   (a) at least one failure in last 3 runs
   547	            #   (b) the MOST RECENT run also failed
   548	            # Rationale: (a) alone is false-positive after a root-cause
   549	            # fix; (b) alone would let a "one green after 10 reds"
   550	            # flake slip through. Both together = persistent failure
   551	            # that a tag should not paper over.
   552	            conclusions=$(echo "$runs_json" | jq -r '.[].conclusion')
   553	            latest_conclusion=$(echo "$runs_json" | jq -r '.[0].conclusion')
   554	            if echo "$conclusions" | grep -q '^failure$' \
   555	               && [ "$latest_conclusion" = "failure" ]; then
   556	              echo "::error::$wf — failure in last 3 AND latest run failed; block release"
   557	              FAILED=1
   558	            elif echo "$conclusions" | grep -q '^failure$'; then
   559	              echo "::notice::$wf — past failure in last 3 but latest run green; accepting as fixed"
   560	            fi
   561	            # Staleness check: most-recent run's startedAt must be within
   562	            # STALENESS_DAYS of now. startedAt is ISO-8601 UTC
   563	            # (e.g. "2026-04-10T12:34:56Z"). GitHub runners are Linux →
   564	            # GNU `date -d` is always available.
   565	            latest_started=$(echo "$runs_json" | jq -r '.[0].startedAt')
   566	            if [ -z "$latest_started" ] || [ "$latest_started" = "null" ]; then
   567	              echo "::error::$wf — cannot parse startedAt for most-recent run"
   568	              FAILED=1
   569	              continue
   570	            fi
   571	            started_secs=$(date -u -d "$latest_started" +%s 2>/dev/null || echo 0)
   572	            if [ "$started_secs" -eq 0 ]; then
   573	              echo "::error::$wf — failed to parse startedAt: $latest_started"
   574	              FAILED=1
   575	              continue
   576	            fi
   577	            delta=$((NOW_SECS - started_secs))
   578	            days=$((delta / 86400))
   579	            if [ "$delta" -gt "$STALENESS_SECS" ]; then
   580	              echo "::error::$wf stale — last run $days days ago (> $STALENESS_DAYS day limit)"
   581	              FAILED=1
   582	            else
   583	              echo "::notice::$wf — recent runs OK; last run $days days ago"
   584	            fi
   585	          done
   586	          if [ "$FAILED" -eq 1 ]; then
   587	            echo "::error::release gate: one or more advisory workflows red or stale"
   588	            exit 1
   589	          fi
   590	          echo "OK: all 6 advisory workflows clean in last 3 runs + fresh within $STALENESS_DAYS days"
