+# de registry aqui deixava GA parcial PUBLICO sem mitigacao).
+NPMV=""
+_nv=0
+while [ "$_nv" -lt 5 ]; do
+  _nv=$((_nv+1))
+  NPMV="$(npm view ceo-orchestration@1.3.0 version 2>/dev/null || true)"
