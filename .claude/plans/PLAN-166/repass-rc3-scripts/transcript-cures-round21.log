+  _vf_ttl="$(awk '/^ttl_hours:/{print $2}' "$VF" | tail -1)"
+  [ -n "$_vf_gen" ] && [ -n "$_vf_ttl" ] || die "pre-push: verdict-fields sem generated_at/ttl"
+  _vf_epoch="$(python3 - "$_vf_gen" <<'PYVF'
