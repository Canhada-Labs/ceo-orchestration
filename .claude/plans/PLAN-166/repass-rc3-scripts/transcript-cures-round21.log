  integration-tests:
    # PLAN-010 Phase 1 — E2E integration harness (ADR-021).
    # Exercises real hook subprocesses end-to-end. Runs in parallel with
    # the governance `validate` job; does not block fast feedback.
    name: E2E integration tests (pytest)
    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity.
    if: vars.CEO_SOTA_DISABLE != '1'
    runs-on: Ceo
    timeout-minutes: 8

    steps:
      - name: Checkout
        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd

      - name: Setup Python 3.11
        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
        with:
          python-version: "3.11"

      - name: Install pytest (dev dep, not shipped)
        run: python3 -m pip install --quiet --no-cache-dir "pytest==8.*"

      - name: Run E2E integration suite
        run: |
          set -euo pipefail
          cd "$GITHUB_WORKSPACE"
          python3 -m pytest tests/integration/ -v --tb=short

      # PLAN-044 F-03-02 closure — tier_policy_cli/tests/ (191 test defs
      # covering VETO-floor mutation harness, adversarial fixtures,
      # statistical power gate, cooldown) previously ran only on
      # dev laptops. This step gates the CLAUDE.md 100% VETO-floor
      # mutation kill-rate claim mechanically in CI.
          python3 -m pytest .claude/scripts/tier_policy_cli/tests/ -q --tb=short

      # PLAN-044 companion — tournament/tests/ (188 test defs covering
      # scorer 100% kill-rate, judge envelope, reporter byte-identity)
      # for the same "exists but not CI-gated" reason.
      - name: Run tournament tests (scorer + judge + reporter)
        run: |
          set -euo pipefail
          cd "$GITHUB_WORKSPACE"
          python3 -m pytest .claude/scripts/tournament/tests/ -q --tb=short

  formal-verification-mutation-harness:
    # P0-03 from PLAN-018: mutation-kill harness CI enforcement (ADR-044 SOTA claim)
    #
    # Previously `tests/formal_verification/` (4 conformance test classes + 21
    # mutation fixtures, "65 mutations 100% kill" per ADR-044) ran on dev
    # laptops only. No CI workflow exercised it. `formal-verify.yml` runs TLC
    # on TLA+ specs (paths: docs/formal-verification/**) but not the Python
    # conformance harness. This job closes that gap: any mutation that
    # escapes (any test failure) fails the workflow and blocks merge.
    #
    # Modelled on the sibling `integration-tests` job above — same triggers
    # (push to main + pull_request inherited from workflow-level `on:`),
    # same pytest-8 pin, same SHA-pinned checkout + setup-python, same
    # least-privilege `contents: read`. Runs in parallel with `validate` and
    # `integration-tests` — does not serialize fast feedback.
    name: Formal verification mutation harness (pytest)
    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity.
    if: vars.CEO_SOTA_DISABLE != '1'
    runs-on: Ceo
    # Harness finishes in ~seconds on a laptop; 10-min ceiling is a
    # generous safety net against runaway workers.
    timeout-minutes: 10
    permissions:
      contents: read

    steps:
      - name: Checkout
        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd

      - name: Setup Python 3.11
        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
        with:
          python-version: "3.11"
  # PLAN-020 Phase 0 item 6b — opus-4-7-profiler-smoke job
  # ---------------------------------------------------------------------------
  # Runs `.claude/scripts/profile-opus-4-7.py --smoke` on every push + PR.
  # Synthetic mode (no Anthropic API call); ≤30s budget.
  # Catches regressions in:
  #  - Gate-boot file presence (CLAUDE.md + PROTOCOL.md + team.md +
  #    frontend-team.md + ceo-orchestration SKILL.md)
  #  - PLAN-020 frontmatter `status: executing` discipline
  #  - CODEOWNERS Phase 0a globs presence
  # ===========================================================================
  opus-4-7-profiler-smoke:
    if: vars.CEO_SOTA_DISABLE != '1'
    runs-on: ubuntu-latest
    # PLAN-159/ADR-163 (amended PLAN-161 C4): sized for the WORST case —
    # 3x420s (capped attempts) + 2x60s (backoffs) + 30s (probe cap) +
    # 30s (floor-sanity cap) + ~180s (checkout/setup/smoke headroom)
    # ~= 1620s ~= 27min -> 28. Both 30s terms are ENFORCED `timeout 30`
    # wall-caps (probe_floor_raw + the floor-sanity step; codex r3 F4).
    timeout-minutes: 28
    permissions:
      contents: read
    steps:
      - name: Checkout
        # SHA-pinned: actions/checkout@v6.0.2 (matches sibling jobs)
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd

      - name: Setup Python 3.11
        # SHA-pinned: actions/setup-python@v6.2.0 (matches sibling jobs)
        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
        with:
          python-version: "3.11"

      - name: Run profile-opus-4-7.py --smoke
        run: |
          set -euo pipefail
          # 30s budget enforced by --budget-seconds; non-zero exit on overrun
          # E12-F3 fix: script now also exits non-zero if any check.passed=false
          python3 .claude/scripts/profile-opus-4-7.py --smoke --budget-seconds 30
          echo "✓ opus-4-7 profiler smoke green (all checks passed)"

      - name: Run profile-opus-4-7.py --hook-latency (p95/p99 gate)
        run: |
          set -euo pipefail
