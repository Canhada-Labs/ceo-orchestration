+  _rvs="$(printf '%s' "$_rvj" | python3 -c 'import json,sys;print(json.load(sys.stdin)["s"])')"
+  _rvf="$(printf '%s' "$_rvj" | python3 -c 'import json,sys;print(json.load(sys.stdin)["f"])')"
+  [ "$_rvf" -eq 0 ] && [ "$_rvs" -ge 1 ] \
