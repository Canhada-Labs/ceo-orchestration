   163	check_pack() {
   164	say "G0c: pack staged-rc3 fechado por manifesto + baseline"
   165	( cd "$PACK" && shasum -a 256 -c MANIFEST.sha256 --status ) \
   166	  || die "staged-rc3 nao confere com o MANIFEST do pack"
   167	_st_odd="$( cd "$PACK" && find . ! -type f ! -type d | head -5 )"
   168	[ -z "$_st_odd" ] || die "entrada NAO-regular dentro de staged-rc3 (symlink/fifo?):
   169	$_st_odd"
   170	_st_disk="$( cd "$PACK" && find . -type f | sed 's|^\./||' | sort )"
   171	_st_want="$( { awk '{print $2}' "$PACK/MANIFEST.sha256"; \
   172	  echo "MANIFEST.sha256"; echo "BASELINE.sha256"; echo "MODES.txt"; } | sort )"
   173	[ "$_st_disk" = "$_st_want" ] || die "conjunto de arquivos em staged-rc3 difere do MANIFEST:
   174	$(diff <(printf '%s\n' "$_st_want") <(printf '%s\n' "$_st_disk") | sed 's/^/   /')"
   175	# TRI-ESTADO por arquivo (rail r5 P1-4: exigir BASELINE puro quebrava o
   176	# rerun anunciado — apos um apply parcial, arquivos ja curados falhavam
   177	# o baseline). Cada arquivo vivo tem de estar EM UM de dois estados:
   178	# pre-cura (== BASELINE) ou ja-curado (== MANIFEST do pack). Qualquer
   179	# TERCEIRO estado (cherry-pick perdido, edicao manual) aborta.
   180	_tri_bad=""
   181	while IFS= read -r _mline; do
   182	  [ -n "$_mline" ] || continue
   183	  _mf="${_mline#*  }"; _msha="${_mline%%  *}"
   184	  _bsha="$(awk -v f="$_mf" '$0 ~ ("  " f "$") {print $1}' "$PACK/BASELINE.sha256")"
   185	  [ -n "$_bsha" ] || die "arquivo do MANIFEST sem linha no BASELINE: $_mf"
   186	  # Symlink no alvo canonico e sempre TERCEIRO estado (rail r8 P1-3):
   187	  # shasum seguiria o link e "ja aplicado" commitaria o symlink.
   188	  if [ -L "$_mf" ]; then
   189	    _tri_bad="$_tri_bad
   190	   $_mf (SYMLINK no lugar do arquivo canonico)"
   191	    continue
   192	  fi
   193	  _lsha="$(shasum -a 256 "$_mf" | awk '{print $1}')"
   194	  if [ "$_lsha" != "$_bsha" ] && [ "$_lsha" != "$_msha" ]; then
   195	    _tri_bad="$_tri_bad
   196	   $_mf (vivo=$_lsha nem baseline nem pack)"
   197	  fi
   198	  # Estado "ja aplicado" exige tambem o MODO do MODES.txt assinado
   199	  # (rail r12 P1-6: chmod no vivo pos-apply passava o re-check de
   200	  # staging - sha igual, modo nao olhado).
   201	  if [ "$_lsha" = "$_msha" ]; then
   202	    _tri_wm="$(awk -v f="$_mf" '$2==f{print $1}' "$PACK/MODES.txt")"
   203	    _tri_lm="$(python3 -c 'import os,sys;print(oct(os.stat(sys.argv[1]).st_mode & 0o777)[2:])' "$_mf")"
   204	    [ "$_tri_lm" = "$_tri_wm" ] || _tri_bad="$_tri_bad
   205	   $_mf (modo vivo $_tri_lm != $_tri_wm do MODES.txt assinado)"
   206	  fi
   207	done < "$PACK/MANIFEST.sha256"
   208	[ -z "$_tri_bad" ] || die "arquivo(s) vivos em TERCEIRO estado (nem rc.2 nem pack) - me chame no Claude:$_tri_bad"
   209	# Exec-bit e parte do material revisado (rail r9 P1-3): sha256 nao
   210	# cobre modo; MODES.txt (pinado no BINDING) e a autoridade — o modo
   211	# ATUAL do pack nao decide nada.
   212	while IFS=' ' read -r _mmode _mpath; do
   213	  [ -n "$_mpath" ] || continue
   214	  _pm="$(python3 -c 'import os,sys;print(oct(os.stat(sys.argv[1]).st_mode & 0o777)[2:])' "$PACK/$_mpath")"
   215	  [ "$_pm" = "$_mmode" ] \
   216	    || die "modo do pack divergiu do MODES.txt revisado: $_mpath ($_pm != $_mmode)"
   217	done < "$PACK/MODES.txt"
   218	echo "   OK: pack fechado ($(grep -c . "$PACK/MANIFEST.sha256") arquivos) + vivos em estado pre-cura ou ja-curado + modes conferem"
   219	}
   220	check_pack
