+    --jq "[.[]|select(.headSha==\"$(git rev-parse HEAD)\" and .status==\"completed\" and .conclusion==\"success\")][0].databaseId" 2>/dev/null || echo "")"
+  [ -n "$_rvid" ] && [ "$_rvid" != "null" ] || die "pre-push: nenhum run do validate.yml para o HEAD"
