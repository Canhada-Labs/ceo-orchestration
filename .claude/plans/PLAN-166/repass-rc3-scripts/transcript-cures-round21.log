    84	check_rail_and_evidence() {
    85	say "G0b: rail de curas terminou GO (verificacao completa)"
    86	# O round FINAL e DERIVADO do proprio conjunto de rounds no disco (o
    87	# maior N com verdict presente) - nunca lido de um arquivo de status
    88	# mutavel (rail r5 P1-3: um RAIL-STATUS editado selecionaria um GO
    89	# anterior). RAIL-STATUS.txt existe so como registro informacional.
    90	FINAL_N=0
    91	for _vfp in "$CURES"/verdict-cures-round*.txt; do
    92	  [ -e "$_vfp" ] || die "nenhum verdict-cures-roundN.txt - rail nao rodou"
    93	  _n="${_vfp##*round}"; _n="${_n%.txt}"
    94	  case "$_n" in (*[!0-9]*|'') die "nome de verdito invalido: $_vfp" ;; esac
    95	  [ "$_n" -gt "$FINAL_N" ] && FINAL_N="$_n"
    96	done
    97	[ "$FINAL_N" -gt 0 ] || die "nenhum round de rail encontrado"
    98	FINAL_ROUND="round$FINAL_N"
    99	# Exatamente UMA linha VERDICT (rail r11 P1-1): um arquivo com NO-GO
   100	# seguido de GO e ambiguo, nao aprovacao.
   101	_fvn="$(grep -cE '^VERDICT:' "$CURES/verdict-cures-$FINAL_ROUND.txt" 2>/dev/null || true)"
   102	[ "$_fvn" = "1" ] \
   103	  || die "verdito final do rail ($FINAL_ROUND) tem $_fvn linhas VERDICT (exigido: exatamente 1) - ambiguo"
   104	FVL="$(grep -E '^VERDICT:' "$CURES/verdict-cures-$FINAL_ROUND.txt")"
   105	[ "$FVL" = "VERDICT: GO" ] \
   106	  || die "verdito final do rail ($FINAL_ROUND, derivado do disco): '$FVL' != GO exato - triagem comigo no Claude"
   107	( cd "$CURES" && shasum -a 256 -c MANIFEST-cures.sha256 --status ) \
   108	  || die "MANIFEST-cures nao confere - evidencia do rail adulterada/incompleta"
   109	# Set-equality BIDIRECIONAL: o manifesto lista exatamente as 4-tuplas
   110	# (payload.redacted/diff/verdict/transcript) de TODOS os rounds 1..N -
   111	# um round suprimido do manifesto ou um arquivo extra nele aborta.
   112	_ev_want="$( { _r=1; while [ "$_r" -le "$FINAL_N" ]; do
   113	    echo "diff-cures-round$_r.patch"
   114	    echo "payload-cures-round$_r.redacted.txt"
   115	    echo "transcript-cures-round$_r.log"
   116	    echo "verdict-cures-round$_r.txt"
   117	    _r=$((_r+1)); done; echo "PROVENANCE-cures.md"; \
   118	    echo "CEREMONY-MANIFEST.sha256"; } | sort )"
   119	_ev_have="$( awk '{print $2}' "$CURES/MANIFEST-cures.sha256" | sort )"
   120	[ "$_ev_want" = "$_ev_have" ] || die "MANIFEST-cures nao cobre exatamente os rounds 1..$FINAL_N:
   121	$(diff <(printf '%s\n' "$_ev_want") <(printf '%s\n' "$_ev_have") | sed 's/^/   /')"
   122	# Fechamento do DIRETORIO de evidencia por conjunto exato de filhos
   123	# DIRETOS (rail r5 P1-2: prefixo na allowlist admite look-alike
   124	# aninhado que o git add recursivo commitaria como parent revisado).
   125	_cd_odd="$( cd "$CURES" && find . ! -type f ! -type d | head -5 )"
   126	[ -z "$_cd_odd" ] || die "entrada NAO-regular em repass-rc3-cures: $_cd_odd"
   127	_cd_sub="$( cd "$CURES" && find . -mindepth 2 | head -5 )"
   128	[ -z "$_cd_sub" ] || die "subdiretorio/arquivo aninhado em repass-rc3-cures (look-alike?):
   129	$_cd_sub"
   130	_cd_disk="$( cd "$CURES" && find . -maxdepth 1 -type f | sed 's|^\./||' | sort )"
   131	_cd_want="$( { printf '%s\n' "$_ev_want"; \
   132	  echo "MANIFEST-cures.sha256"; \
   133	  echo "RAIL-STATUS.txt"; echo "run-rc3-cure-review.sh"; \
   134	  echo "run-rc3-scripts-review.sh"; } | sort -u )"
   135	[ "$_cd_disk" = "$_cd_want" ] || die "conjunto de arquivos em repass-rc3-cures difere do esperado:
   136	$(diff <(printf '%s\n' "$_cd_want") <(printf '%s\n' "$_cd_disk") | sed 's/^/   /')"
   137	# BINDING evidencia<->pack<->anchor (rail r6 P1-1): a proveniencia —
   138	# que esta DENTRO do manifesto shasum-verificado acima — tem de nomear
   139	# o anchor exato e pinar os manifestos do pack staged-rc3 vigente. Um
   140	# dir de evidencia GO stale pareado com um pack diferente aborta aqui.
   141	_bind_anchor="$(awk '/^BINDING-ANCHOR:/{print $2}' "$CURES/PROVENANCE-cures.md" | tail -1)"
   142	[ "$_bind_anchor" = "$EXPECTED_HEAD" ] \
   143	  || die "BINDING-ANCHOR da evidencia ('$_bind_anchor') != EXPECTED_HEAD - evidencia de outro anchor"
   144	_bind_pm="$(awk '/^BINDING-PACK-MANIFEST-SHA256:/{print $2}' "$CURES/PROVENANCE-cures.md" | tail -1)"
   145	[ "$_bind_pm" = "$(shasum -a 256 "$PACK/MANIFEST.sha256" | awk '{print $1}')" ] \
   146	  || die "BINDING do MANIFEST do pack nao bate - o pack staged-rc3 NAO e o que o rail revisou"
   147	_bind_bl="$(awk '/^BINDING-PACK-BASELINE-SHA256:/{print $2}' "$CURES/PROVENANCE-cures.md" | tail -1)"
   148	[ "$_bind_bl" = "$(shasum -a 256 "$PACK/BASELINE.sha256" | awk '{print $1}')" ] \
   149	  || die "BINDING do BASELINE do pack nao bate"
   150	_bind_md="$(awk '/^BINDING-PACK-MODES-SHA256:/{print $2}' "$CURES/PROVENANCE-cures.md" | tail -1)"
   151	[ "$_bind_md" = "$(shasum -a 256 "$PACK/MODES.txt" | awk '{print $1}')" ] \
   152	  || die "BINDING do MODES.txt do pack nao bate (exec-bit fora do revisado?)"
   153	# Os PROPRIOS arquivos de cerimonia sao content-pinados (rail r16
   154	# P1-1): scripts, templates, sentinel draft e morning doc nao podem
   155	# mudar depois do review por mero same-path. O CEREMONY-MANIFEST esta
   156	# dentro do MANIFEST-cures (bytes) e seu sha no BINDING da proveniencia.
   157	( cd "$REPO" && shasum -a 256 -c "$CURES/CEREMONY-MANIFEST.sha256" --status ) \
   158	  || die "arquivo de CERIMONIA mudou depois do review (CEREMONY-MANIFEST nao confere) - regenerar/re-revisar; me chame no Claude"
   159	echo "   OK: rail GO ($FINAL_ROUND derivado de $FINAL_N rounds; evidencia fechada + BINDING pack/anchor confere)"
   160	}
   161	check_rail_and_evidence
