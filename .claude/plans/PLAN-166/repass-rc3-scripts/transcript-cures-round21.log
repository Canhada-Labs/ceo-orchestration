   377	# Lista LITERAL de arquivos do commit 1, DERIVADA dos manifestos que
   378	# acabaram de verificar - nenhum `git add` de diretorio (rail r8 P1-1).
   379	_commit1_files() {
   380	  awk '{print $2}' "$PACK/MANIFEST.sha256"
