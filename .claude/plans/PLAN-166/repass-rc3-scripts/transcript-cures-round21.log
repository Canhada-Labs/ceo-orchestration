   326	# Idempotente (rail r5 P1-4) e ATOMICO (rail r7 P1-2): copia para um
   327	# temporario no MESMO diretorio, verifica o hash do pack e so entao
   328	# renomeia — uma interrupcao/IO-error nunca deixa o alvo truncado num
   329	# terceiro estado; o tmp remanescente e removido no rerun.
   330	while IFS= read -r _mline; do
   331	  [ -n "$_mline" ] || continue
   332	  _mf="${_mline#*  }"; _msha="${_mline%%  *}"
   333	  _tmp="$(dirname "$_mf")/.rc3tmp.$(basename "$_mf")"
   334	  rm -f "$_tmp"
   335	  _lsha="$(shasum -a 256 "$_mf" | awk '{print $1}')"
   336	  # Modo esperado vem do MODES.txt REVISADO, nunca do pack atual (r9
   337	  # P1-3: um chmod no pack pos-review passaria com sha igual).
   338	  _wmode="$(awk -v f="$_mf" '$2==f{print $1}' "$PACK/MODES.txt")"
   339	  [ -n "$_wmode" ] || die "arquivo sem entrada no MODES.txt: $_mf"
   340	  _lmode="$(python3 -c 'import os,sys;print(oct(os.stat(sys.argv[1]).st_mode & 0o777)[2:])' "$_mf")"
   341	  if [ "$_lsha" = "$_msha" ] && [ ! -L "$_mf" ] && [ -f "$_mf" ] \
   342	     && [ "$_lmode" = "$_wmode" ]; then
   343	    echo "   (ja aplicado) $_mf"
   344	  else
   345	    cp -p "$PACK/$_mf" "$_tmp" || die "cp para temporario falhou: $_mf"
   346	    [ "$(shasum -a 256 "$_tmp" | awk '{print $1}')" = "$_msha" ] \
   347	      || die "temporario nao bate com o pack (IO?): $_mf"
   348	    mv -f "$_tmp" "$_mf" || die "rename atomico falhou: $_mf"
   349	    chmod "$_wmode" "$_mf" || die "chmod para o modo revisado falhou: $_mf"
   350	  fi
   351	done < "$PACK/MANIFEST.sha256"
   352	# pos-apply: o vivo tem de bater byte a byte com o MANIFEST do pack
   353	( shasum -a 256 -c "$PACK/MANIFEST.sha256" --status ) \
   354	  || die "pos-apply: vivo != pack (cp parcial?)"
   355	echo "   pack aplicado; rodando gates locais..."
   356	bash -n .claude/scripts/local/verify-counts.sh || die "bash -n verify-counts falhou"
