+  [ "$(date +%s)" -le $(( _vf_epoch + _vf_ttl * 3600 - 3600 )) ] \
+    || die "pre-push: verdito a menos de 1h do TTL (ou expirado) - NAO pushe; me chame no Claude (rota: regenerar verdito/tag)"
