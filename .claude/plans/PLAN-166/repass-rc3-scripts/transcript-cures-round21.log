+      || die "temporario nao bate com o pack (IO?): $_mf"
+    mv -f "$_tmp" "$_mf" || die "rename atomico falhou: $_mf"
+    chmod "$_wmode" "$_mf" || die "chmod para o modo revisado falhou: $_mf"
+  fi
