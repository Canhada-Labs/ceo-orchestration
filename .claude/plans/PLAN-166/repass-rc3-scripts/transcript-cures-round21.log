    66	# Tag REMOTA tambem (rail r12 P1-5): um rc.3 remoto que o fetch de main
    67	# nao traz deixaria o script commitar/pushar main e so falhar no push da
    68	# tag - com o G0 pos-commit recusando a retomada. Transporte falhando e
    69	# erro, nunca "ausente".
    70	_rls="$(git ls-remote origin "refs/tags/$TAG" "refs/tags/$TAG^{}")" \
    71	  || die "git ls-remote falhou (transporte) - nao vou assumir tag remota ausente"
    72	[ -z "$_rls" ] || die "tag $TAG ja existe no REMOTO:
    73	$_rls"
    74	command -v gh >/dev/null 2>&1 || die "gh CLI ausente"
    75	[ -f "$VF_TPL" ] && [ -f "$VD_TPL" ] || die "templates rc.3 ausentes (o Claude gera pos-rail)"
    76	[ -f "$SENT_DRAFT" ] || die "RC3-approved-draft.md ausente"
    77	grep -q "Anchor-SHA: $EXPECTED_HEAD" "$SENT_DRAFT" \
    78	  || die "Anchor-SHA do sentinel nao bate com o HEAD esperado"
    79	ls "$CURES"/payload-*.raw.txt >/dev/null 2>&1 \
    80	  && die "payload raw do rail ainda na arvore - o Claude devia ter movido"
    81	ls "$NOGO"/payload-*.raw.txt >/dev/null 2>&1 \
    82	  && die "payload raw do NO-GO ainda na arvore"
