+check_pack() {
+say "G0c: pack staged-rc3 fechado por manifesto + baseline"
+( cd "$PACK" && shasum -a 256 -c MANIFEST.sha256 --status ) \
+  || die "staged-rc3 nao confere com o MANIFEST do pack"
+_st_odd="$( cd "$PACK" && find . ! -type f ! -type d | head -5 )"
