   279	check_tree_is_exactly_the_prep() {
   280	  # git status CAPTURADO com rc checado (rail r8 P1-2: falha dentro de
   281	  # command substitution em heredoc virava "arvore limpa").
   282	  _st_out="$(git status --porcelain --untracked-files=all)" \
   283	    || die "git status falhou - nao vou tratar como arvore limpa"
   284	  _bad=""
   285	  while IFS= read -r _line; do
   286	    [ -n "$_line" ] || continue
   287	    _path="${_line#???}"
   288	    _hit=0
   289	    while IFS= read -r _allow; do
   290	      [ -n "$_allow" ] || continue
   291	      case "$_allow" in
   292	        */) case "$_path" in "$_allow"*|"${_allow%/}") _hit=1 ;; esac ;;
   293	        *)  [ "$_path" = "$_allow" ] && _hit=1 ;;
   294	      esac
   295	      [ "$_hit" -eq 1 ] && break
   296	    done <<ALLOW
   297	$COMMIT1_ALLOW
   298	ALLOW
   299	    [ "$_hit" -eq 1 ] || _bad="$_bad
   300	   $_path"
   301	  done <<STATUS
   302	$_st_out
   303	STATUS
   304	  [ -z "$_bad" ] || die "arquivo(s) FORA da allowlist do commit 1 (nao revisados pelo rail):$_bad
   305	Remova/stash antes de cortar, ou me chame no Claude."
   306	}
   307	# Limpa temporarios de um apply interrompido ANTES do fechamento de
   308	# arvore (rail r7 P1-2: um .rc3tmp.* orfao triparia a allowlist).
   309	while IFS= read -r _mline; do
   310	  [ -n "$_mline" ] || continue
   311	  _mf="${_mline#*  }"
   312	  rm -f "$(dirname "$_mf")/.rc3tmp.$(basename "$_mf")"
   313	done < "$PACK/MANIFEST.sha256"
   314	check_tree_is_exactly_the_prep
