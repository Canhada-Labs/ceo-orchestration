   340	  _wbm_tmp="$( mktemp "$_wbm_manifest.XXXXXX" 2>/dev/null )" || {
   341	    echo "    NOTE: baseline manifest skipped (mktemp failed) — advisory only" >&2
   342	    return 0
   343	  }
