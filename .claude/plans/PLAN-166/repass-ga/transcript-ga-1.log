   135	            while IFS= read -r v; do
   136	              [[ -z "$v" ]] && continue
   137	              if [[ "$v" != "$FILE" ]]; then
   138	                echo "::error::.claude-plugin/marketplace.json carries version '$v' != VERSION ('$FILE')"
   139	                BAD=1
   140	              fi
   141	            done < <(jq -r '.. | objects | .version? // empty' .claude-plugin/marketplace.json)
   142	            if [[ "$BAD" -ne 0 ]]; then
   143	              exit 1
   144	            fi
   145	            echo "OK: every marketplace.json version field matches VERSION"
   146	          else
   147	            echo "::notice::.claude-plugin/marketplace.json not present — skipping"
   148	          fi
   149	
   150	      # -----------------------------------------------------------------
   151	      # F5 — RC-hold / staleness waiver SUNSET assertion.
   152	      #
   153	      # The pre-GA waivers in .claude/governance/governance-waivers.yaml
   154	      # are honest ONLY while the project is pre-GA (adopter_count=0).
   155	      # Every existing rc_hold/workflow_staleness entry is a 1.x version
   156	      # carrying "Pre-GA ... adopter_count=0". To stop that 100%-waiver
   157	      # escape from silently following the project into GA, this step
   158	      # FAILS the release the moment any waiver `version` parses >= the
   159	      # configured FIRST_GA floor. The floor is the first version at which
   160	      # the framework intends to claim GA / publish to adopters; per
   161	      # ADR-073 the next major (v2.0.0) is the documented GA/breaking
   162	      # boundary, so 2.0.0 is the mechanical sunset. After the first real
   163	      # adopter ships, lower FIRST_GA (or empty the waiver lists) so the
   164	      # ADR-007 RC-hold + 14-day staleness gates resume real enforcement.
   165	      #
   166	      # Today (max waiver 1.0.0 < 2.0.0) this passes; it is a tripwire,
   167	      # not a behavior change for the current pre-GA train.
   168	      #
   169	      # `-rc.N` pre-release suffixes are stripped before comparison: RC
   170	      # tags forensically short-circuit the hold gate (see below), so an
   245	      # AMENDED 2026-05-03 per ADR-103: 7-day calendar gate REDUCED to
   246	      # 24h Codex re-pass mechanical window per ADR-095 §gate-#6.
   247	      #
   248	      # Debate Round 1 consensus §S3 HIGH (DevOps): "7-day RC hold is
   249	      # policy not mechanism. Policy without mechanism is hope."
   250	      #
   251	      # Rule: a GA tag `v1.x.y` MAY only ship after its corresponding
   252	      # RC tag `v1.x.y-rc.N` has existed for ≥24 hours. The 24h window
   253	      # is mechanical: bounds the maximum Codex external re-pass
   254	      # turnaround (anti same-LLM bias per ADR-095 §gate-#6). NOT a
   255	      # "settle period" — vibecoder-only thesis (ADR-096) means no
   256	      # external adopter pressure for calendar buffers.
   257	      #
   258	      # Mechanism:
   259	      #   1. If tag contains `-rc.` → skip check (RC tags always pass)
   260	      #   2. Else find most recent `v<VERSION>-rc.*` tag (by creator date)
   261	      #   3. If none exists → fail (mandatory RC before GA)
   262	      #   4. Else compute delta; reject if < 24h (86400 seconds)
   263	      # -----------------------------------------------------------------
   264	      - name: Assert 24h Codex re-pass window (GA tags only, waiver-aware)
   265	        run: |
   266	          set -euo pipefail
   267	          TAG="${GITHUB_REF_NAME}"
   268	          VERSION="${TAG#v}"
   269	
   270	          # RC tags short-circuit — they are always permitted.
   271	          if [[ "$TAG" == *-rc.* ]]; then
   272	            echo "::notice::$TAG is an RC tag — skipping 24h hold check"
   273	            exit 0
   274	          fi
   275	
   276	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment).
   277	          # During initial framework development with adopter_count=0,
   278	          # the RC-hold window can be waived per Owner authorization
   279	          # recorded in .claude/governance/rc-hold-waivers.yaml. The
   280	          # waiver is additive: post-first-adopter, the file is expected
   281	          # to be empty and ADR-007 default resumes. Each waiver entry
   282	          # cites Owner directive + round-NN sentinel commit.
   283	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   284	          if [[ -f "$WAIVER_FILE" ]]; then
   285	            if awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   286	              echo "::notice::$TAG has a pre-GA RC-hold waiver in $WAIVER_FILE — skipping hold check"
   287	              exit 0
   288	            fi
   289	          fi
   290	
   291	          # Find the most-recent RC tag for this version, by creator date.
   292	          # `git tag -l --sort=-creatordate` handles both lightweight and
   293	          # annotated tags uniformly via the dereferenced date.
   294	          LAST_RC=$(git tag -l --sort=-creatordate "v${VERSION}-rc.*" | head -1)
   295	
   296	          if [[ -z "$LAST_RC" ]]; then
   297	            echo "::error::GA tag $TAG has no prior v${VERSION}-rc.* tag"
   298	            echo "::error::Mandatory RC-hold requires a prior RC tag"
   299	            echo "::error::Cut v${VERSION}-rc.1 first; wait 24h (Codex re-pass turnaround); then cut $TAG"
   300	            exit 1
   301	          fi
   302	
   303	          # Creator-date gives a unix-epoch timestamp for both
   304	          # annotated (tagger date) and lightweight (committer date) tags.
   305	          RC_TS=$(git tag -l --format='%(creatordate:unix)' "$LAST_RC")
   306	          GA_TS=$(git tag -l --format='%(creatordate:unix)' "$TAG")
   307	
   308	          if [[ -z "$RC_TS" || -z "$GA_TS" ]]; then
   309	            echo "::error::Could not read creator-date for $LAST_RC or $TAG"
   310	            exit 1
   311	          fi
   312	
   313	          DELTA=$((GA_TS - RC_TS))
   314	          ONE_DAY=$((1 * 86400))
   315	          HOURS=$((DELTA / 3600))
   316	
   317	          if [[ "$DELTA" -lt "$ONE_DAY" ]]; then
   318	            echo "::error::GA tag $TAG is only $HOURS hours after $LAST_RC"
   319	            echo "::error::Mandatory 24h Codex re-pass window not met (delta=${DELTA}s < 86400s)"
   320	            echo "::error::Wait $((24 - HOURS)) more hours OR run Codex re-pass synchronously and add waiver"
   321	            exit 1
   322	          fi
   323	
   324	          echo "OK: $TAG is $HOURS hours after $LAST_RC (≥24h Codex re-pass window per ADR-103)"
   325	
   326	      - name: Assert CHANGELOG entry exists
   327	        run: |
   328	          set -euo pipefail
   329	          TAG="${GITHUB_REF_NAME}"
   330	          VERSION="${TAG#v}"
   331	          # PLAN-153 Wave B item 5 (c) — same RC normalization as the
   332	          # "Assert VERSION matches tag" step above: RC tags never get
   333	          # their own CHANGELOG section; an RC for X.Y.Z validates
   334	          # against the GA `## [X.Y.Z]` section (which exists at RC-cut
   335	          # time because the VERSION bump + CHANGELOG entry land before
   336	          # the RC is tagged). Without this strip the fixed VERSION gate
   337	          # would just move the RC red run one step later.
   338	          VERSION="${VERSION%-rc.[0-9]*}"
   339	          if ! grep -qE "^## \[${VERSION}\]" CHANGELOG.md; then
   340	            echo "::error::CHANGELOG.md has no '## [${VERSION}]' section"
   341	            exit 1
   342	          fi
   343	          echo "OK: CHANGELOG has entry for [$VERSION]"
   344	
   345	      - name: Registry validation (must be clean)
   346	        run: python3 .claude/scripts/registry.py --validate
   347	
   348	      - name: Governance structural validation
   349	        run: bash .claude/scripts/validate-governance.sh
   350	
   351	      - name: Install test deps (CI-only, not shipped)
   352	        # Post-tag-v1.6.0-rc.1 hardening (Session 33 CI batch): Hook +
   353	        # Script test suites need pytest (4 script tests + several hook
   354	        # tests use pytest.fixture / tmp_path / capsys / pytest.raises)
   355	        # and pyyaml (benchmark loader). These are dev-only deps — never
   356	        # shipped in install.sh / upgrade.sh tarballs. Mirrors coverage.yml
   357	        # install step.
   358	        run: python3 -m pip install --quiet --no-cache-dir "pyyaml" "pytest==8.*"
   359	
   360	      - name: Hook test suite (all 168+ tests)
   361	        # pytest discovers both unittest.TestCase and pure-pytest tests.
   362	        run: python3 -m pytest .claude/hooks/tests -q --tb=short
   363	
   364	      - name: Script test suite (all 132+ tests)
   365	        run: python3 -m pytest .claude/scripts/tests -q --tb=short

