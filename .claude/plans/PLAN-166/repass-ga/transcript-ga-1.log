  1880	# ---- 8. Drop a pointer to PROTOCOL.md (DevOps-P1-4: relative, not absolute) ----
  1881	
  1882	install_protocol_pointer() {
  1883	  if [[ -e "$TARGET/PROTOCOL.md" ]]; then
  1884	    return 0
  1885	  fi
  1886	
  1887	  # PLAN-168 W2 (AC-6, Owner decision D1-b): the body comes from the ONE
  1888	  # shared generator in _framework_manifest_set.sh — never a private heredoc.
  1889	  # INV-4 existed because this function and upgrade.sh each carried their own
  1890	  # copy of this text; a silent local fallback would resurrect the class, so
  1891	  # a missing generator is a broken checkout and fails LOUD.
  1892	  #
  1893	  # Relative-path heuristic (unchanged): if $SOURCE_DIR starts with $TARGET,
  1894	  # the framework was copied INTO the target — relative pointer. In ALL other
  1895	  # cases the body is written with the user-editable {{PROTOCOL_SOURCE}}
  1896	  # marker and the placeholder substitution pass below resolves it.
  1897	  command -v _render_protocol_pointer >/dev/null 2>&1 || {
  1898	    echo "    ERROR: _render_protocol_pointer unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot write PROTOCOL.md pointer" >&2
  1899	    return 1
  1900	  }
  1901	
  1902	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1903	    echo "    (dry-run) would CREATE: PROTOCOL.md (pointer)"
  1904	    return 0
  1905	  fi
  1906	
  1907	  case "$SOURCE_DIR" in
  1908	    "$TARGET"/*)
  1909	      _render_protocol_pointer "$SOURCE_DIR" "$TARGET" "$PROFILE" "$STACK" "" > "$TARGET/PROTOCOL.md"
  1910	      ;;
  1911	    *)
  1912	      _render_protocol_pointer_degraded "$TARGET" "$PROFILE" "$STACK" > "$TARGET/PROTOCOL.md"
  1913	      ;;
  1914	  esac
  1915	  echo "    CREATED: PROTOCOL.md (pointer)"
  1916	  _state_record_op "install_protocol_pointer" "PROTOCOL.md"
  1917	  # PLAN-166 F3 (ADR-155-AMEND-1): registered delivery — this line is only
  1918	  # reached when the heredoc actually wrote the pointer (the pre-existing
  1919	  # early-return above never gets here, so an adopter's own root
  1920	  # PROTOCOL.md is never inventoried as framework-owned; r13/r17).
  1921	  _DELIVERED_PROTOCOL=1
  1922	  _state_record_op "delivered_protocol_pointer" "PROTOCOL.md"
  1923	}
  1924	
  1925	if [[ "$CEREMONY" != "user" ]]; then install_protocol_pointer; fi  # WS4-guard-proto
