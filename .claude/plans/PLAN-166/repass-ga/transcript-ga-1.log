   222	def _sanitize_frontmatter(text: str) -> str:
   223	    """Re-emit risky frontmatter string fields as JSON-quoted so a strict YAML
   224	    parser accepts them. The Claude Code native loader is tolerant; `claude
   225	    plugin validate` is not. Only quotes scalar string fields that aren't
   226	    already quoted and aren't flow collections (tools: [..])."""
   227	    if not text.startswith("---"):
   228	        return text
   229	    parts = text.split("---", 2)
   230	    if len(parts) < 3:
   231	        return text
   232	    fm, body = parts[1], parts[2]
   233	    quote_keys = ("description", "whenToUse")
   234	    out = []
   235	    for line in fm.splitlines():
   236	        m = re.match(r"^(\w+):[ \t]+(.*)$", line)
   237	        if m and m.group(1) in quote_keys:
   238	            key, val = m.group(1), m.group(2)
   239	            v = val.strip()
   240	            if not (v.startswith('"') or v.startswith("'") or v.startswith("[") or v.startswith("|") or v.startswith(">")):
   241	                out.append(f"{key}: {json.dumps(val, ensure_ascii=False)}")
   242	                continue
   243	        out.append(line)
   244	    return "---" + "\n".join(out) + "---" + body
   245	
   246	
   247	def copy_agents() -> int:
   248	    src = REPO / ".claude/agents"
   249	    dst = PLUGIN / "agents"
   250	    dst.mkdir(parents=True, exist_ok=True)
   251	    n = 0
   252	    for f in sorted(src.glob("*.md")):
   253	        if f.name.startswith("_"):
   254	            continue  # internal framework-dev agents (_probe_* test probes, _dispatch index)
   255	        (dst / f.name).write_text(_sanitize_frontmatter(f.read_text()))
   256	        n += 1
   257	    return n
