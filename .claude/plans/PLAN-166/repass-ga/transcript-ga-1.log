   303	          # Creator-date gives a unix-epoch timestamp for both
   304	          # annotated (tagger date) and lightweight (committer date) tags.
   305	          RC_TS=$(git tag -l --format='%(creatordate:unix)' "$LAST_RC")
   306	          GA_TS=$(git tag -l --format='%(creatordate:unix)' "$TAG")
   307	
   308	          if [[ -z "$RC_TS" || -z "$GA_TS" ]]; then
   309	            echo "::error::Could not read creator-date for $LAST_RC or $TAG"
   310	            exit 1
   311	          fi
   312	
   313	          DELTA=$((GA_TS - RC_TS))
   314	          ONE_DAY=$((1 * 86400))
   315	          HOURS=$((DELTA / 3600))
   316	
   317	          if [[ "$DELTA" -lt "$ONE_DAY" ]]; then
   318	            echo "::error::GA tag $TAG is only $HOURS hours after $LAST_RC"
   319	            echo "::error::Mandatory 24h Codex re-pass window not met (delta=${DELTA}s < 86400s)"
   320	            echo "::error::Wait $((24 - HOURS)) more hours OR run Codex re-pass synchronously and add waiver"
   321	            exit 1
   322	          fi
   323	
   324	          echo "OK: $TAG is $HOURS hours after $LAST_RC (≥24h Codex re-pass window per ADR-103)"
   325	
   326	      - name: Assert CHANGELOG entry exists
   327	        run: |
   328	          set -euo pipefail
   329	          TAG="${GITHUB_REF_NAME}"
   330	          VERSION="${TAG#v}"
   331	          # PLAN-153 Wave B item 5 (c) — same RC normalization as the
   332	          # "Assert VERSION matches tag" step above: RC tags never get
   333	          # their own CHANGELOG section; an RC for X.Y.Z validates
   334	          # against the GA `## [X.Y.Z]` section (which exists at RC-cut
   335	          # time because the VERSION bump + CHANGELOG entry land before
   336	          # the RC is tagged). Without this strip the fixed VERSION gate
   337	          # would just move the RC red run one step later.
   338	          VERSION="${VERSION%-rc.[0-9]*}"
   339	          if ! grep -qE "^## \[${VERSION}\]" CHANGELOG.md; then
   340	            echo "::error::CHANGELOG.md has no '## [${VERSION}]' section"
   341	            exit 1
   342	          fi
   343	          echo "OK: CHANGELOG has entry for [$VERSION]"
   344	
   345	      - name: Registry validation (must be clean)
   346	        run: python3 .claude/scripts/registry.py --validate
   347	
   348	      - name: Governance structural validation
   349	        run: bash .claude/scripts/validate-governance.sh
   350	
   351	      - name: Install test deps (CI-only, not shipped)
   352	        # Post-tag-v1.6.0-rc.1 hardening (Session 33 CI batch): Hook +
   353	        # Script test suites need pytest (4 script tests + several hook
   354	        # tests use pytest.fixture / tmp_path / capsys / pytest.raises)
   355	        # and pyyaml (benchmark loader). These are dev-only deps — never
   356	        # shipped in install.sh / upgrade.sh tarballs. Mirrors coverage.yml
   357	        # install step.
   358	        run: python3 -m pip install --quiet --no-cache-dir "pyyaml" "pytest==8.*"
   359	
   360	      - name: Hook test suite (all 168+ tests)

