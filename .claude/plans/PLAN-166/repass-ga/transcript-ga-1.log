   260	def copy_hooks() -> None:
   261	    """Copy ALL hook .py + _lib + shim (so imports resolve), then write a
   262	    hooks.json that registers ONLY the advisory + accelerator subset."""
   263	    src = REPO / ".claude/hooks"
   264	    dst = PLUGIN / "hooks"
   265	    dst.mkdir(parents=True, exist_ok=True)
   266	    # top-level .py + .sh shim
   267	    npy = 0
   268	    for f in sorted(src.glob("*.py")):
   269	        shutil.copy2(f, dst / f.name)
   270	        npy += 1
   271	    for sh in src.glob("_python-hook.sh"):
   272	        shutil.copy2(sh, dst / sh.name)
   273	    # _lib (runtime only; skip tests/ AND fixtures/ — the latter ships attack
   274	    # samples (yaml_bomb, prototype_pollution) + a 64KiB padding file that trips
   275	    # Claude Code's zip-bomb/compression-ratio heuristic on install. No runtime
   276	    # _lib code reads fixtures/, so excluding it is safe.)
   277	    shutil.copytree(src / "_lib", dst / "_lib",
   278	                    ignore=shutil.ignore_patterns("tests", "fixtures", "__pycache__",
   279	                                                  "test_*.py", "*_test.py", "conftest.py",
   280	                                                  "test_isolation.py", "testing.py"))
   281	    log(f"copied {npy} hook .py + _lib + shim")
   282	
   283	    # Build hooks.json: advisory set (settings.user.json) + accelerators, paths rewritten.
   284	    advisory = json.loads((REPO / "templates/settings/settings.user.json").read_text())
   285	    hooks = advisory.get("hooks", {})
   286	    for ev, arr in ACCEL.items():
   287	        hooks.setdefault(ev, [])
   288	        hooks[ev].extend(arr)
   289	
   290	    def rewrite(obj):
   291	        if isinstance(obj, dict):
   292	            return {k: rewrite(v) for k, v in obj.items()}
   293	        if isinstance(obj, list):
   294	            return [rewrite(v) for v in obj]
   295	        if isinstance(obj, str):
   296	            return obj.replace('"$CLAUDE_PROJECT_DIR/.claude/hooks/',
   297	                               '"${CLAUDE_PLUGIN_ROOT}/hooks/')
   298	        return obj
   299	
   300	    hooks = rewrite(hooks)
   301	    (dst / "hooks.json").write_text(json.dumps({"hooks": hooks}, indent=2) + "\n")
   302	    log("wrote hooks/hooks.json (advisory + accelerators, ${CLAUDE_PLUGIN_ROOT} paths)")
