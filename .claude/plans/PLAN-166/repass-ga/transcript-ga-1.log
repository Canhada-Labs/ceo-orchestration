   156	# shellcheck disable=SC2329  # invoked indirectly by the EXIT trap below
   157	cleanup() {
   158	  [ "${CEO_PARITY_KEEP_WORK:-0}" = "1" ] && return 0
   159	  [ -n "${WORK:-}" ] || return 0
   160	  find "$WORK" -mindepth 1 -depth -exec chmod u+w {} + 2>/dev/null || true
   161	  find "$WORK" -mindepth 1 -depth -delete 2>/dev/null || true
   162	  rmdir "$WORK" 2>/dev/null || true
   163	}
   164	trap cleanup EXIT
   165	
   166	# Non-interactive install/upgrade. A source checkout carries a placeholder
   167	# self-SHA; skipping it keeps the fixture deterministic regardless of
   168	# release-fill state (the same knobs smoke-install.yml already uses).
   169	export CEO_INSTALL_SKIP_SELF_SHA=1
   170	export CEO_RAG_INSTALL_PROMPT=0
   171	
   172	echo "=============================================================="
   173	echo " install/upgrade parity e2e  (PLAN-166 F4 / OQ-4)"
   174	echo "=============================================================="
   175	echo "  repo (route A source) : $REPO_ROOT"
   176	echo "  historical pin        : $PIN"
   177	echo "  profile               : $PROFILE"
   178	echo "  ceremony modes        : $MODES"
   179	echo "  positive control      : $POSITIVE_CONTROL"
   180	echo "  workdir               : $WORK"
   181	echo "  git describe (repo)   : $( git -C "$REPO_ROOT" describe --tags --always --dirty 2>/dev/null || echo '(n/a)' )"
   182	echo "--------------------------------------------------------------"
   183	
   184	# --- historical source: pure read of the tag, never a repo mutation ---------
   185	if ! git -C "$REPO_ROOT" rev-parse --verify --quiet "refs/tags/$PIN" >/dev/null 2>&1; then
   186	  {
   187	    echo ""
   188	    echo "  tag '$PIN' does not resolve in $REPO_ROOT."
   189	    echo "  In CI this is the fetch-depth:1 hole — the checkout has no tags, so"
   190	    echo "  the historical leg cannot run, and 'it passes on my clone' is"
   191	    echo "  exactly the gap this test exists to close. Fetch the tag first:"
   192	    echo "      git fetch --no-tags --depth 1 origin +refs/tags/$PIN:refs/tags/$PIN"
   193	  } >&2
   194	  scaffold "historical pin '$PIN' unresolvable — refusing to skip"
   195	fi
   196	PIN_SRC="$WORK/src-$PIN"
   197	mkdir -p "$PIN_SRC"
   198	if ! git -C "$REPO_ROOT" archive "$PIN" | tar -x -C "$PIN_SRC"; then
   199	  scaffold "git archive $PIN | tar -x failed"
   200	fi
   201	[ -f "$PIN_SRC/scripts/install.sh" ] || scaffold "$PIN archive has no scripts/install.sh"
   202	
   203	# --- optional planted-divergence source for the positive control ------------
   204	# A depth-1 symlink farm over the working tree with ONE edited file. upgrade.sh
   205	# derives SOURCE_DIR from its own location ("cd $SCRIPT_DIR/.." with a logical
   206	# pwd), so the farm root becomes the source and every other path resolves
   207	# through the symlinks to the live tree. Cheap (no 75MB copy) and it perturbs
   208	# exactly one line, which is what a positive control is for.
   209	PLANTED_SRC=""
   210	if [ "$POSITIVE_CONTROL" -eq 1 ]; then
   211	  PLANTED_SRC="$WORK/src-planted"
   212	  mkdir -p "$PLANTED_SRC/scripts"
   213	  for _e in "$REPO_ROOT"/* "$REPO_ROOT"/.[!.]* "$REPO_ROOT"/..?*; do
   214	    [ -e "$_e" ] || continue
   215	    _b="$( basename "$_e" )"
   216	    [ "$_b" = "scripts" ] && continue
   217	    ln -s "$_e" "$PLANTED_SRC/$_b" 2>/dev/null || true
   218	  done
   219	  for _f in "$REPO_ROOT"/scripts/* "$REPO_ROOT"/scripts/.[!.]*; do
   220	    [ -e "$_f" ] || continue
   221	    _b="$( basename "$_f" )"
   222	    [ "$_b" = "upgrade.sh" ] && continue
   223	    ln -s "$_f" "$PLANTED_SRC/scripts/$_b" 2>/dev/null || true
   224	  done
   225	  _before="$( grep -c "^backup_and_replace \"$PLANT_TARGET\"\$" "$REPO_ROOT/scripts/upgrade.sh" || true )"
   226	  grep -v "^backup_and_replace \"$PLANT_TARGET\"\$" \
   227	    "$REPO_ROOT/scripts/upgrade.sh" > "$PLANTED_SRC/scripts/upgrade.sh" \
   228	    || scaffold "could not write planted upgrade.sh"
   229	  _after="$( grep -c "^backup_and_replace \"$PLANT_TARGET\"\$" "$PLANTED_SRC/scripts/upgrade.sh" || true )"
   230	  if [ "${_before:-0}" -lt 1 ] || [ "${_after:-1}" -ne 0 ]; then
   231	    scaffold "planting failed: backup_and_replace \"$PLANT_TARGET\" occurrences before=$_before after=$_after — the control perturbed nothing"
   232	  fi
   233	  echo "  PLANTED: dropped backup_and_replace \"$PLANT_TARGET\" from a COPY of"
   234	  echo "           upgrade.sh (occurrences $_before -> $_after). The live"
   235	  echo "           scripts/upgrade.sh is untouched."
   236	  echo "--------------------------------------------------------------"
   237	fi
   238	
   239	_git_init() {
   240	  _n=0
   241	  while [ "$_n" -lt 5 ]; do
   242	    ( cd "$1" && git init -q 2>/dev/null ) && return 0
   243	    _n=$(( _n + 1 )); sleep 1
   244	  done
   245	  ( cd "$1" && git init -q )
   246	}
   247	
   248	OVERALL=0          # 0 parity | 1 fail | 2 known-open
   249	MODE_VERDICTS=""   # "mode:rc" pairs, bash-3.2 has no associative arrays
   250	for MODE in $MODES; do
   251	  echo ""
   252	  echo "##############################################################"
   253	  echo "# ceremony mode: $MODE"
   254	  echo "##############################################################"
   255	
   256	  # SAME basename on both sides: install.sh substitutes {{PROJECT_NAME}} with
   257	  # basename($TARGET). Different basenames would fabricate ~30 phantom
   258	  # divergences that say nothing about install/upgrade parity.
   259	  A_DIR="$WORK/$MODE/route-a/adopter"
   260	  B_DIR="$WORK/$MODE/route-b/adopter"
   261	  mkdir -p "$A_DIR" "$B_DIR"
   262	  _git_init "$A_DIR"; _git_init "$B_DIR"
   263	
   264	  echo "--> [A] install.sh (working tree) --ceremony $MODE --profile $PROFILE"
   265	  if ! bash "$REPO_ROOT/scripts/install.sh" "$A_DIR" \
   266	        --profile "$PROFILE" --ceremony "$MODE" \
   267	        >"$WORK/$MODE-a-install.log" 2>&1; then
   268	    tail -40 "$WORK/$MODE-a-install.log" >&2
   269	    scaffold "[A] install.sh failed (mode=$MODE)"
   270	  fi
   271	
   272	  echo "--> [B1] install.sh @ $PIN --ceremony $MODE --profile $PROFILE"
   273	  if ! bash "$PIN_SRC/scripts/install.sh" "$B_DIR" \
   274	        --profile "$PROFILE" --ceremony "$MODE" \
   275	        >"$WORK/$MODE-b-install.log" 2>&1; then
   276	    tail -40 "$WORK/$MODE-b-install.log" >&2
   277	    scaffold "[B1] install.sh @ $PIN failed (mode=$MODE)"
   278	  fi
   279	
   280	  UP_SRC="$REPO_ROOT"
   281	  [ -n "$PLANTED_SRC" ] && UP_SRC="$PLANTED_SRC"
   282	  echo "--> [B2] upgrade.sh (source: $UP_SRC)"
   283	  if ! bash "$UP_SRC/scripts/upgrade.sh" "$B_DIR" \
   284	        --profile "$PROFILE" --no-diff-warn \
   285	        >"$WORK/$MODE-b-upgrade.log" 2>&1; then
   286	    tail -40 "$WORK/$MODE-b-upgrade.log" >&2
   287	    scaffold "[B2] upgrade.sh failed (mode=$MODE)"
   288	  fi
   289	
   290	  echo "--> classify"
   291	  # When planted, the farm root is a THIRD absolute source path that can be
   292	  # embedded in generated files; fold it too, so the control fails for the
   293	  # planted reason instead of for an unfolded /tmp path.
   294	  EXTRA_ARGS=""
   295	  [ -n "$PLANTED_SRC" ] && EXTRA_ARGS="--extra-source $PLANTED_SRC"
   296	  # shellcheck disable=SC2086  # EXTRA_ARGS is a controlled, space-free pair
   297	  python3 "$CLASSIFY" \
   298	    --a "$A_DIR" --b "$B_DIR" \
   299	    --head-src "$REPO_ROOT" --pin-src "$PIN_SRC" --pin "$PIN" \
   300	    --mode "$MODE" $EXTRA_ARGS
   301	  rc=$?
   302	  case "$rc" in
   303	    0) : ;;
   304	    2) [ "$OVERALL" -eq 0 ] && OVERALL=2 ;;
   305	    1) OVERALL=1 ;;
   306	    *) scaffold "classifier returned unexpected rc=$rc (mode=$MODE)" ;;
   307	  esac
   308	  MODE_VERDICTS="$MODE_VERDICTS $MODE:$rc"
   309	done
   310	
   311	echo ""
   312	echo "--------------------------------------------------------------"
   313	echo "per-mode verdicts (0 parity / 1 fail / 2 known-open):$MODE_VERDICTS"
   314	
   315	# --- positive-control self-check ------------------------------------------
   316	# A control that stops firing must never read as a pass. Requiring rc==1 in
   317	# EVERY mode is DERIVED from the run: the plant only bites if the planted
   318	# directory actually drifted between $PIN and HEAD.
   319	if [ "$POSITIVE_CONTROL" -eq 1 ]; then
   320	  _not_fatal=""
   321	  for _pair in $MODE_VERDICTS; do
   322	    _m="${_pair%%:*}"; _r="${_pair##*:}"
   323	    [ "$_r" = "1" ] || _not_fatal="$_not_fatal $_m(rc=$_r)"
   324	  done
   325	  if [ -n "$_not_fatal" ]; then
   326	    {
   327	      echo ""
   328	      echo "  The plant removed backup_and_replace \"$PLANT_TARGET\" from the copy"
   329	      echo "  of upgrade.sh, yet these modes did NOT go FATAL:$_not_fatal"
   330	      echo "  Most likely cause: nothing under '$PLANT_TARGET' changed between"
   331	      echo "  $PIN and HEAD, so removing its refresh is undetectable — the"
   332	      echo "  control is vacuous and proves nothing. Pick a PLANT_TARGET with"
   333	      echo "  real drift, or advance the pin."
   334	    } >&2
   335	    scaffold "positive control did not fire in every mode"
   336	  fi
   337	  echo "positive control: FIRED in every mode (rc=1 each) — the gate is alive."
   338	fi
   339	
   340	echo ""
   341	echo "=============================================================="
   342	case "$OVERALL" in
   343	  0) echo "RESULT: PASS — install and upgrade converge on the same framework"
   344	     echo "        content in every ceremony mode tested ($MODES)." ;;
   345	  2) {
   346	       echo "RESULT: KNOWN-OPEN (exit 2) — the ONLY outstanding divergences are the"
   347	       echo "        explicitly named PLAN-166 W1 prerequisites printed above."
   348	       echo "        This is a FAILURE, not a skip. It goes green when W1 lands."
   349	     } >&2 ;;
   350	  1) echo "RESULT: FAIL (exit 1) — undeclared install/upgrade divergence above." >&2 ;;
   351	esac
   352	echo "=============================================================="
   353	exit "$OVERALL"
     1	#!/usr/bin/env bash
     2	# scripts/tests/test-upgrade-spec-ownership.sh
     3	# PLAN-166 F3 (ADR-155-AMEND-1) — delivery-record ownership of the three
     4	# conditional framework surfaces (SPEC/v1, root PROTOCOL.md,
     5	# .claude/.framework-version) across install → upgrade → doctor → updater.
     6	#
     7	# AC-3 scenarios exercised:
     8	#   S1  maintainer fresh install: SPEC/v1 + PROTOCOL.md + marker DELIVERED
     9	#       and recorded in the baseline manifest; marker == source VERSION;
    10	#       delivered_* ops journaled in .install-state.json
    11	#   S2  2nd-upgrade FORCED route (r6 — the load-bearing fixture): baseline
    12	#       ALREADY contains SPEC/v1 records, SPEC edited locally => upgrade
    13	#       REPLACES it (backup in .claude.bak/<ts>/SPEC/v1) — the generic
    14	#       classified walk would have PRESERVED the edit; root VERSION
    15	#       sentinel is NOT touched (S238/ADR-155 class)
    16	#   S3  user-ceremony install + `upgrade --no-replay` (r9 MANDATORY):
    17	#       neither install nor upgrade creates SPEC/v1 or a root PROTOCOL.md
    18	#       (the ceremony is read by the replay-INDEPENDENT reader)
    19	#   S4  legacy ADOPTER-FORK (r20): baseline without SPEC records (v1.2-and-
    20	#       earlier shape) + locally edited SPEC => PRESERVED in place + named
    21	#       WARNING + forensic snapshot (no pristine fingerprint match)
    22	#   S5  pre-existing marker (r20) AND pre-existing root PROTOCOL.md (r13/
    23	#       r17) on a MAINTAINER install: both EXISTS-skipped => NO delivery
    24	#       record => neither is inventoried as framework-owned; the checker
    25	#       refuses the unrecorded marker and falls back to VERSION; doctor
    26	#       does not flag the adopter's PROTOCOL.md as an orphan
    27	#   S6  updater no-loop regression (r8): post-upgrade tree with stale root
    28	#       VERSION reports the NEW version via the recorded marker
    29	#       (up-to-date, exit 0); stripping the marker record flips it back to
    30	#       the stale VERSION (behind, exit != 0) — proves marker-first is
    31	#       load-bearing, not decorative
    32	#   S7  doctor, user mode (r19): adopter's OWN SPEC/v1 + root PROTOCOL.md
    33	#       are NOT orphan candidates under --strict-orphans (flags resolved
    34	#       from the baseline, not from a ceremony default)
    35	#   S8  doctor, maintainer mode (r9 P2): a stray file inside the DELIVERED
    36	#       SPEC/v1 IS an orphan candidate (positive control — the enumeration
    37	#       does include SPEC when the record says delivered)
    38	#
    39	# The pristine-match branch of the legacy migration (target SPEC/v1 byte-
    40	# identical to a shipped v1.2.0-or-earlier tree) deliberately lives in the
    41	# F4 install-v1.2.0→upgrade e2e (needs real tag content); it is NOT
    42	# duplicated here.
    43	#
    44	# bash 3.2-safe. mktemp -d only (xdist/parallel safe). Exits 0 on success,
    45	# non-zero on any failed assertion.
    46	#
    47	# Run:  bash scripts/tests/test-upgrade-spec-ownership.sh ; echo rc=$?
    48	
    49	set -uo pipefail   # NOT -e: we assert on command failures explicitly.
    50	
    51	SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    52	SOURCE_DIR="$( cd "$SCRIPT_DIR/../.." && pwd )"
    53	# Override points so the test can be pointed at staged/candidate scripts
    54	# while they still live in a plan-staging mirror (PLAN-153 discipline).
    55	# NOTE: an override must point INTO a full framework checkout — install.sh /
    56	# upgrade.sh derive their source tree from their own resolved location.
    57	INSTALL="${CEO_INSTALL_UNDER_TEST:-$SOURCE_DIR/scripts/install.sh}"
    58	UPGRADE="${CEO_UPGRADE_UNDER_TEST:-$SOURCE_DIR/scripts/upgrade.sh}"
    59	DOCTOR="${CEO_DOCTOR_UNDER_TEST:-$SOURCE_DIR/scripts/doctor.sh}"
    60	CHECKER="${CEO_UPDATE_CHECKER_UNDER_TEST:-$SOURCE_DIR/.claude/scripts/check-framework-updates.sh}"
    61	
    62	export CEO_INSTALL_SKIP_SELF_SHA=1
    63	export CEO_RAG_INSTALL_PROMPT=0
    64	
    65	if ! command -v python3 >/dev/null 2>&1; then
    66	  echo "==> SKIP: python3 not installed (install-state machinery is python3-backed)"
    67	  exit 0
    68	fi
    69	
    70	SRC_VERSION="$(tr -d '[:space:]' < "$SOURCE_DIR/VERSION" 2>/dev/null || true)"
    71	if [ -z "$SRC_VERSION" ]; then
    72	  echo "FATAL: cannot read $SOURCE_DIR/VERSION" >&2
    73	  exit 2
    74	fi
    75	if [ ! -f "$SOURCE_DIR/.claude/.framework-version" ]; then
    76	  echo "FATAL: source has no .claude/.framework-version (F3 marker missing)" >&2
    77	  exit 2
    78	fi
    79	
    80	FAIL=0
    81	PASS=0
    82	WORKROOT="$( mktemp -d -t ceo-f3-own-XXXXXX )"
    83	cleanup() { [ -n "${WORKROOT:-}" ] && rm -rf "$WORKROOT" 2>/dev/null || true; }
    84	trap cleanup EXIT
    85	
    86	ok()   { PASS=$((PASS+1)); printf '  ok   %s\n' "$1"; }
    87	bad()  { FAIL=$((FAIL+1)); printf '  FAIL %s\n' "$1" >&2; }
    88	
    89	_git_init_retry() {
    90	  local d="$1" n=0
    91	  while [ "$n" -lt 5 ]; do
    92	    if ( cd "$d" && git init -q 2>/dev/null ); then return 0; fi
    93	    n=$((n+1)); sleep 1
    94	  done
    95	  ( cd "$d" && git init -q )
    96	}
    97	
    98	run_install() {
    99	  local t="$1"; shift
   100	  bash "$INSTALL" "$t" "$@" >"$t.install.log" 2>&1
   101	}
   102	
   103	run_upgrade() {
   104	  local t="$1"; shift
   105	  bash "$UPGRADE" "$t" --no-deprecation-warn "$@" >"$t.upgrade.log" 2>&1
   106	}
   107	
   108	fresh_install() {
   109	  # $1 = leg tag, rest = install args. Echoes the target path.
   110	  local tag="$1"; shift
   111	  local t
   112	  t="$( mktemp -d "$WORKROOT/tgt-$tag-XXXXXX" )"
   113	  _git_init_retry "$t"
   114	  if ! run_install "$t" "$@"; then
   115	    echo "INSTALL_FAILED ($tag)" >&2
   116	    tail -30 "$t.install.log" >&2
   117	    return 1
   118	  fi
   119	  printf '%s\n' "$t"
   120	}
   121	
   122	MANIFEST_REL=".claude/.install-manifest.sha256"
   123	MARKER_REL=".claude/.framework-version"
   124	
   125	manifest_has() {  # $1 = target, $2 = ERE fragment at the relpath position
   126	  grep -Eq "^([0-9a-f]{64}|LINK)  $2" "$1/$MANIFEST_REL" 2>/dev/null
   127	}
   128	
   129	# --------------------------------------------------------------------------
   130	# S1 — maintainer fresh install: delivery recorded end-to-end.
   131	# --------------------------------------------------------------------------
   132	echo "==> S1: maintainer install — SPEC/marker/PROTOCOL delivered + recorded"
   133	T1="$( fresh_install m1 --profile core )" || exit 1
   134	
   135	[ -d "$T1/SPEC/v1" ]            && ok "SPEC/v1 installed"            || bad "SPEC/v1 missing after maintainer install"
   136	[ -f "$T1/PROTOCOL.md" ]        && ok "root PROTOCOL.md installed"   || bad "root PROTOCOL.md missing"
   137	[ -f "$T1/$MARKER_REL" ]        && ok "marker installed"             || bad "marker missing"
   138	[ "$(tr -d '[:space:]' < "$T1/$MARKER_REL" 2>/dev/null)" = "$SRC_VERSION" ] \
   139	  && ok "marker == source VERSION ($SRC_VERSION)" \
   140	  || bad "marker != source VERSION (got: $(cat "$T1/$MARKER_REL" 2>/dev/null))"
   141	
   142	manifest_has "$T1" 'SPEC/v1/'                              && ok "baseline records SPEC/v1/"    || bad "baseline has NO SPEC/v1/ record"
   143	manifest_has "$T1" 'PROTOCOL\.md(  |$)'                    && ok "baseline records PROTOCOL.md" || bad "baseline has NO PROTOCOL.md record"
   144	manifest_has "$T1" '\.claude/\.framework-version(  |$)'    && ok "baseline records marker"      || bad "baseline has NO marker record"
   145	
   146	grep -q '"delivered_spec_v1"' "$T1/.claude/.install-state.json" 2>/dev/null \
   147	  && ok "install-state journals delivered_spec_v1" \
   148	  || bad "install-state missing delivered_spec_v1 op"
   149	grep -q '"delivered_framework_marker"' "$T1/.claude/.install-state.json" 2>/dev/null \
   150	  && ok "install-state journals delivered_framework_marker" \
   151	  || bad "install-state missing delivered_framework_marker op"
   152	
   153	# --------------------------------------------------------------------------
   154	# S2 — 2nd-upgrade forced route: record-owned edited SPEC is REPLACED with
   155	# backup; root VERSION sentinel untouched (AC-3 load-bearing fixture).
   156	# --------------------------------------------------------------------------
   157	echo "==> S2: 2nd upgrade — forced SPEC refresh (baseline already has SPEC)"
   158	SPEC_FILE="$( ls "$T1"/SPEC/v1/*.md 2>/dev/null | head -1 )"
   159	if [ -z "$SPEC_FILE" ]; then
   160	  bad "no SPEC file found to edit"
   161	else
   162	  printf '\nADOPTER-EDIT sentinel S2\n' >> "$SPEC_FILE"
   163	fi
   164	printf '1.0.0\n' > "$T1/VERSION"   # adopter-owned root VERSION sentinel
   165	
   166	if run_upgrade "$T1"; then ok "upgrade rc=0 (record-owned fixture)"; else bad "upgrade failed (see $T1.upgrade.log)"; fi
   167	
   168	SPEC_REL="${SPEC_FILE#"$T1"/}"
   169	if [ -n "$SPEC_FILE" ]; then
   170	  cmp -s "$SOURCE_DIR/$SPEC_REL" "$SPEC_FILE" \
   171	    && ok "edited SPEC file was FORCE-replaced with source bytes" \
   172	    || bad "edited SPEC file NOT replaced (classified walk preserved the fork?)"
   173	  BAK_HIT="$( ls -d "$T1"/.claude.bak/*/SPEC/v1 2>/dev/null | head -1 )"
   174	  if [ -n "$BAK_HIT" ] && grep -rq 'ADOPTER-EDIT sentinel S2' "$BAK_HIT" 2>/dev/null; then
   175	    ok "backup of the edited SPEC present under .claude.bak/<ts>/SPEC/v1"
   176	  else
   177	    bad "no .claude.bak backup carrying the edited SPEC content"
   178	  fi
   179	fi
   180	grep -q 'REFRESHED (forced' "$T1.upgrade.log" \
   181	  && ok "upgrade log names the forced route" \
   182	  || bad "upgrade log has no 'REFRESHED (forced' line"
   183	[ "$(tr -d '[:space:]' < "$T1/VERSION" 2>/dev/null)" = "1.0.0" ] \
   184	  && ok "root VERSION sentinel untouched by upgrade (ADR-155-AMEND-1)" \
   185	  || bad "root VERSION was modified by upgrade (got: $(cat "$T1/VERSION" 2>/dev/null))"
   186	[ "$(tr -d '[:space:]' < "$T1/$MARKER_REL" 2>/dev/null)" = "$SRC_VERSION" ] \
   187	  && ok "marker refreshed to source VERSION post-upgrade" \
   188	  || bad "marker not refreshed post-upgrade"
   189	manifest_has "$T1" 'SPEC/v1/' \
   190	  && ok "rewritten baseline still records SPEC/v1/ (ownership continuity)" \
   191	  || bad "rewritten baseline dropped the SPEC/v1 records"
   192	
   193	# --------------------------------------------------------------------------
   194	# S6 — updater no-loop (r8) on the S2 fixture: marker-first wins over the
   195	# stale root VERSION; stripping the marker record flips the source back.
   196	# --------------------------------------------------------------------------
   197	echo "==> S6: check-framework-updates.sh — marker-first, record-gated"
   198	STUB="$WORKROOT/stub-upstream"
   199	mkdir -p "$STUB"
   200	_git_init_retry "$STUB"
   201	( cd "$STUB" \
   202	  && git -c user.email=t@t -c user.name=t commit -q --allow-empty -m x \
   203	  && git tag "v$SRC_VERSION" ) 2>/dev/null \
   204	  && ok "stub upstream tagged v$SRC_VERSION" \
   205	  || bad "stub upstream construction failed"
   206	
   207	CHK_OUT="$WORKROOT/chk1.out"; CHK_ERR="$WORKROOT/chk1.err"
   208	( cd "$T1" && bash "$CHECKER" --upstream "$STUB" ) >"$CHK_OUT" 2>"$CHK_ERR"
   209	CHK_RC=$?
   210	[ "$CHK_RC" -eq 0 ] && grep -q 'up-to-date' "$CHK_OUT" \
   211	  && ok "post-upgrade tree reports up-to-date via marker (no behind-minor loop)" \
   212	  || bad "updater loop regression: rc=$CHK_RC (expected 0/up-to-date via marker; VERSION=1.0.0 is stale by design)"
   213	grep -q 'version source: marker' "$CHK_ERR" \
   214	  && ok "checker names the marker as its version source" \
   215	  || bad "checker did not use the marker (stderr: $(head -3 "$CHK_ERR" 2>/dev/null | tr '\n' ' '))"
   216	
   217	# Negative control: strip the marker record => fallback to stale VERSION.
   218	sed -i.bak '/  \.claude\/\.framework-version/d' "$T1/$MANIFEST_REL" 2>/dev/null \
   219	  || sed -i '' '/  \.claude\/\.framework-version/d' "$T1/$MANIFEST_REL" 2>/dev/null
   220	( cd "$T1" && bash "$CHECKER" --upstream "$STUB" ) >"$WORKROOT/chk2.out" 2>"$WORKROOT/chk2.err"
   221	CHK2_RC=$?
