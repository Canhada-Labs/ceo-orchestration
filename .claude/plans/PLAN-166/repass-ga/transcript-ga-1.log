   230	
   231	REPO_ROOT = Path(__file__).resolve().parents[2]
   232	
   233	# NF-08b — the path this script was INVOKED as, before any symlink is
   234	# followed. Captured at import so it cannot depend on a later `os.chdir`;
   235	# `absolute()` deliberately does NOT resolve links (that is the whole point —
   236	# `REPO_ROOT` above already has the resolved form).
   237	_INVOKED_SELF = Path(__file__).absolute()
   238	
   239	# The one relative location this script may legitimately be executed from.
   240	_CANONICAL_SELF_PARTS = (".claude", "scripts", "night-mode.py")
   241	
   242	# The ONLY mode `on` ever writes (PLAN-165 D1 — bypassPermissions was cut
   243	# in review; do not add a mode flag).
   244	NIGHT_MODE = "acceptEdits"
   245	
   246	# The harness's REAL `--permission-mode` enum — verified against
   247	# `claude --help` on the pinned CLI (2026-08-03). NF-02 (round-3 review):
   248	# the restorable set below is DERIVED from this enum instead of being
   249	# hand-listed, because a hand-listed set drifted BOTH ways at once — it
   250	# carried `default` (never a harness mode) and OMITTED `dontAsk` (a legal
   251	# one). The omission was the dangerous half: an Owner whose overlay
   252	# legitimately carried `dontAsk` had it snapshotted by `on`, and then every
   253	# `off` refused forever with `acceptEdits` left armed — a fail-closed gate
   254	# landing on the PERMISSIVE side. If the CLI gains a mode, update THIS
   255	# constant; the derivation and the diagnostics follow automatically.
   256	_HARNESS_PERMISSION_MODES = frozenset(
   257	    {"acceptEdits", "auto", "bypassPermissions", "manual", "dontAsk", "plan"}
   258	)
