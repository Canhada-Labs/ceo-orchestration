+        "# Protocol reference" \
+        "" \
+        "The full CEO orchestration protocol lives at:" \
+        "./${_rpp_rel}/PROTOCOL.md" \
+        "" \
+        "To pull updates:" \
+        "  ( cd ./${_rpp_rel} && git pull )" \
+        "  ./${_rpp_rel}/scripts/upgrade.sh . --profile $_rpp_profile --stack $_rpp_stack"
+      ;;
+    *)
