   127	# SHA + pre-release publicado; hold conta de publishedAt.
   128	# UM snapshot; OBJETO plain == tag local assinada, peel == commit
   129	# (rail r14 P1-1) + assinatura verificada.
   130	git tag -v "$RC_TAG" >/dev/null 2>&1 \
   131	  || die "assinatura da tag $RC_TAG local nao verifica - me chame no Claude"
   132	_rc_rls="$(git ls-remote origin "refs/tags/$RC_TAG" "refs/tags/$RC_TAG^{}")" \
   133	  || die "git ls-remote da $RC_TAG falhou (transporte)"
   134	_rc_plain="$(printf '%s\n' "$_rc_rls" | awk -v r="refs/tags/$RC_TAG" '$2==r{print $1}')"
   135	_rc_peel="$(printf '%s\n' "$_rc_rls" | awk -v r="refs/tags/$RC_TAG^{}" '$2==r{print $1}')"
   136	[ "$_rc_plain" = "$(git rev-parse "$RC_TAG")" ] \
   137	  || die "tag $RC_TAG remota nao e o mesmo OBJETO assinado local - a rc publicada nao e a assinada; me chame no Claude"
   138	[ -z "$_rc_peel" ] || [ "$_rc_peel" = "$RC_SHA" ] \
   139	  || die "peel remoto da $RC_TAG diverge do commit local"
   140	RC_PREJ="$(gh release view "$RC_TAG" --json isPrerelease,isDraft 2>/dev/null || echo "")"
   141	RC_PRE="$(printf '%s' "$RC_PREJ" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("isPrerelease"))' 2>/dev/null || echo "")"
   142	RC_DR="$(printf '%s' "$RC_PREJ" | python3 -c 'import json,sys;print(json.load(sys.stdin).get("isDraft"))' 2>/dev/null || echo "")"
   143	{ [ "$RC_PRE" = "True" ] && [ "$RC_DR" = "False" ]; } \
   144	  || die "pre-release da $RC_TAG ausente, draft ou nao-prerelease (pre='$RC_PRE' draft='$RC_DR') - o hold conta de release PUBLICO; me chame no Claude"
   145	PUBAT="$(gh release view "$RC_TAG" --json publishedAt --jq .publishedAt 2>/dev/null || echo "")"
   146	[ -n "$PUBAT" ] || die "sem publishedAt no release da $RC_TAG"
   147	PUB_EPOCH="$(python3 - "$PUBAT" <<'PYEOF'
   148	import sys, datetime
   149	ts = sys.argv[1].replace("Z", "+00:00")
   150	print(int(datetime.datetime.fromisoformat(ts).timestamp()))
   151	PYEOF
   152	)"
   153	NOW="$(date +%s)"
   154	HOLD=$(( NOW - PUB_EPOCH ))
   155	[ "$HOLD" -ge 86400 ] || die "hold ADR-103 incompleto: $((HOLD/3600))h < 24h desde o pre-release publicado - volte mais tarde"
   156	# Controle positivo da rc RE-verificado aqui (rail r18 P1): o corte da
   157	# rc pode ter abortado DEPOIS do pre-release publico com o job
   158	# await-release-gate vermelho/timeout - o GA nao pode promover sobre um
   159	# caminho de publish nunca validado.
   160	_pcn="$(gh run list --workflow npm-publish.yml --limit 30 \
   161	  --json headSha,databaseId,headBranch,event \
   162	  --jq "[.[]|select(.headSha==\"$RC_SHA\" and .headBranch==\"$RC_TAG\" and .event==\"push\")][0].databaseId" 2>/dev/null || echo "")"
   163	[ -n "$_pcn" ] && [ "$_pcn" != "null" ] \
   164	  || die "nenhum run do npm-publish.yml para a $RC_TAG ($RC_SHA) - controle positivo ausente; me chame no Claude"
   165	_pca="$(gh run view "$_pcn" --json jobs \
   166	  --jq '[.jobs[]|select(.name|startswith("Await release-gate"))][0].conclusion' 2>/dev/null || echo "")"
   167	[ "$_pca" = "success" ] \
   168	  || die "controle positivo await-release-gate da rc NAO e success ('$_pca') - o corte da rc terminou sem validar o caminho de publish; me chame no Claude"
   169	echo "   controle positivo da rc: await-release-gate success (recibo re-verificado)"
   170	git fetch --quiet origin main
   171	# Estados legitimos (pair-rail S300 r13 P2 — retomada real): HEAD ==
   172	# a rc do trem (fresh), ou HEAD descendente dela cujo delta contem SO
   173	# evidencia do hold + artefatos do verdito GA (interrompido apos o
   174	# commit 2/4). origin/main pode ser rc.2 (pre-push) ou o proprio HEAD
   175	# (interrompido apos o push). Qualquer outra coisa = freeze violado.
   176	# Conjunto FECHADO das saidas do runner do re-pass (definido ANTES da
   177	# checagem de retomada, que o consome — rail rc.3 r5).
   178	GA_OUT_OK="payload-ga-1.redacted.txt payload-ga-2.redacted.txt
   179	diff-ga-1.patch diff-ga-2.patch
   180	paths-ga-1.manifest.txt paths-ga-2.manifest.txt
   181	verdict-ga-1.txt verdict-ga-2.txt
   182	transcript-ga-1.log transcript-ga-2.log
   183	PROVENANCE-ga.md MANIFEST-ga.sha256"
   184	HEADNOW="$(git rev-parse HEAD)"
   185	if [ "$HEADNOW" != "$RC_SHA" ]; then
   186	  git merge-base --is-ancestor "$RC_SHA" "$HEADNOW" \
   187	    || die "HEAD nao descende do commit da rc - me chame no Claude"
   188	  # --no-renames + saida CAPTURADA com rc checado (rail rc.3 r5 P1-1:
   189	  # rename-aware podia reportar so o destino permitido de um rename
   190	  # produto->evidencia, e um git falhando dentro de heredoc virava
   191	  # delta vazio = aprovacao falsa). Conjunto FECHADO: so os filhos
   192	  # DIRETOS nomeados em GA_OUT_OK + VF + VD.
   193	  _delta_out="$(git diff --no-renames --name-only "$RC_SHA"..HEAD)" \
   194	    || die "git diff do delta de retomada falhou - nao vou tratar como vazio"
   195	  _bad_delta=""
   196	  while IFS= read -r _dp; do
   197	    [ -n "$_dp" ] || continue
   198	    if [ "$_dp" = "$VF" ] || [ "$_dp" = "$VD" ]; then continue; fi
   199	    case "$_dp" in
   200	      "$GA_DIR"/*)
   201	        _rel="${_dp#"$GA_DIR"/}"
   202	        _okp=0
   203	        case "$_rel" in
   204	          */) : ;;
   205	          */*) : ;;
   206	          *) for _b in $GA_OUT_OK; do
   207	               [ "$_rel" = "$_b" ] && { _okp=1; break; }
   208	             done ;;
   209	        esac
   210	        [ "$_okp" -eq 1 ] || _bad_delta="$_bad_delta
   211	   $_dp" ;;
   212	      *) _bad_delta="$_bad_delta
   213	   $_dp" ;;
   214	    esac
   215	  done <<GADELTA
   216	$_delta_out
   217	GADELTA
   218	  [ -z "$_bad_delta" ] \
   219	    || die "delta rc..HEAD contem caminho fora do conjunto FECHADO de evidencia/verdito GA (freeze violado):$_bad_delta"
   220	  echo "   modo RETOMADA: commits locais contem so evidencia/verdito GA (conjunto fechado, --no-renames)"
   221	fi
   222	OM="$(git rev-parse origin/main)"
   223	[ "$OM" = "$RC_SHA" ] || [ "$OM" = "$HEADNOW" ] \
   224	  || die "origin/main nao e a rc.2 nem o HEAD da retomada - freeze violado; me chame no Claude"
   225	# Arvore limpa EXCETO o conjunto FECHADO de saidas do runner do re-pass
   226	# (pair-rail S300 r11 P2: uma invocacao que rodou o re-pass e parou
   227	# antes do commit deixa esses untracked — o reuso precisa alcanca-los).
   228	# status CAPTURADO com rc checado (rail r9 P1-2: falha dentro de
   229	# heredoc-substitution virava "arvore limpa").
   230	_ga_st_out="$(git status --porcelain --untracked-files=all)" \
   231	  || die "git status falhou - nao vou tratar como arvore limpa"
   232	_dirty=""
   233	while IFS= read -r _line; do
   234	  [ -n "$_line" ] || continue
   235	  _pathp="${_line#???}"
   236	  case "$_pathp" in
   237	    "$VF.tmp"|"$VD.tmp")
   238	      # Orfaos de uma geracao atomica interrompida (rail r11 P1-2):
   239	      # removidos aqui mesmo (symlink rejeitado antes de remover).
   240	      [ -L "$_pathp" ] && die "temporario de assinatura e SYMLINK: $_pathp"
   241	      rm -f "$_pathp"
   242	      echo "   (limpo) temporario orfao: $_pathp"
   243	      : ;;
   244	    "$VF"|"$VF.asc"|"$VD")
   245	      # Estado parcial de assinatura de uma retomada (rail rc.3 r6
   246	      # P1-3): os tres artefatos sao integralmente REGENERADOS nos
   247	      # passos 3-4 (que comecam com rm -f), entao presenca suja aqui e
   248	      # retomavel. SYMLINK nao (rail r10 P1-1): um $VD -> $VF faria a
   249	      # geracao do verdito SOBRESCREVER o verdict-fields ja assinado.
   250	      [ -L "$_pathp" ] && die "artefato de assinatura e SYMLINK: $_pathp - remova antes"
   251	      : ;;
   252	    "$GA_DIR"/*)
   253	      # SO filhos DIRETOS do dir de evidencia contam (r14 P2: um
   254	      # look-alike aninhado tipo repass-ga/rehearsal/verdict-ga-1.txt
   255	      # cairia no git add do commit 1 e o guard de delta, ancorado no
   256	      # PARENT pos-commit, nunca o veria).
   257	      _rel="${_pathp#"$GA_DIR"/}"
   258	      case "$_rel" in
   259	        */*) _dirty="$_dirty
   260	   $_pathp" ;;
