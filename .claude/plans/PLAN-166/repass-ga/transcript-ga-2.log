    42	
    43	      # -----------------------------------------------------------------
    44	      # PLAN-153 Wave B item 5 (c) — RC-aware VERSION↔tag comparison.
    45	      # Closes PLAN-152 §Deferred `release-gate-rc-version-mismatch`
    46	      # (red run 28663453202 precedent).
    47	      #
    48	      # THE RC FLOW (documented so this never regresses): an RC tag
    49	      # `v<X.Y.Z>-rc.N` is cut from a tree whose VERSION file ALREADY
    50	      # reads the GA value `X.Y.Z` — the `-rc.N` pre-release suffix
    51	      # exists only in the tag name, never in the VERSION file. (The
    52	      # 24h RC-hold gate below encodes the same convention: it derives
    53	      # the RC tag family `v${VERSION}-rc.*` from the GA VERSION.)
    54	      # The old comparison (`FILE != TAG#v`) therefore hard-failed
    55	      # every RC tag's own release run: `v1.0.1-rc.1` vs
    56	      # `VERSION=1.0.1`. Fix: strip a trailing `-rc.<digits>` from the
    57	      # tag before comparing. GA tags are unaffected (nothing to
    58	      # strip); a wrong-version RC (`v1.0.2-rc.1` on `VERSION=1.0.1`)
    59	      # still hard-fails.
    60	      # -----------------------------------------------------------------
    61	      - name: Assert VERSION matches tag
    62	        run: |
    63	          set -euo pipefail
    64	          TAG="${GITHUB_REF_NAME}"
    65	          FILE="$(tr -d '[:space:]' < VERSION)"
    66	          EXPECTED="${TAG#v}"
    67	          BASE="${EXPECTED%-rc.[0-9]*}"
    68	          if [[ "$FILE" != "$BASE" ]]; then
    69	            echo "::error::VERSION file ('$FILE') does not match tag ('$TAG' → expected '$BASE')"
    70	            exit 1
    71	          fi
    72	          if [[ "$EXPECTED" != "$BASE" ]]; then
    73	            echo "OK: VERSION=$FILE matches RC tag=$TAG (compared against base '$BASE' after stripping the -rc.N pre-release suffix)"
    74	          else
    75	            echo "OK: VERSION=$FILE matches tag=$TAG"
    76	          fi
    77	
    78	      # -----------------------------------------------------------------
    79	      # PLAN-166 W1 item 2 (F3, ADR-155-AMEND-1 §5, Forma A (ii)) — the
    80	      # framework version marker `.claude/.framework-version` is a TRACKED
    81	      # one-line file, byte-identical to VERSION (the version bump writes
    82	      # it as a site; verify-counts.sh cross-checks it). This assert is
    83	      # deliberately UNCONDITIONAL and fail-closed: a missing marker in a
    84	      # release checkout means the ceremony that introduced it was
    85	      # reverted or the bump skipped a site — either way the tag must not
    86	      # ship. Kept NEXT TO the VERSION↔tag assert above so the whole
    87	      # version-consistency family lives in one place (same convention as
    88	      # the plugin-manifest step below).
    89	      # -----------------------------------------------------------------
    90	      - name: Assert framework-version marker matches VERSION
    91	        run: |
    92	          set -euo pipefail
    93	          FILE="$(tr -d '[:space:]' < VERSION)"
    94	          if [[ ! -f .claude/.framework-version ]]; then
    95	            echo "::error::.claude/.framework-version is missing — it is a tracked file (PLAN-166 F3 / ADR-155-AMEND-1); a release checkout without it must not ship"
    96	            exit 1
    97	          fi
    98	          MARKER="$(tr -d '[:space:]' < .claude/.framework-version)"
    99	          if [[ "$MARKER" != "$FILE" ]]; then
   100	            echo "::error::.claude/.framework-version ('$MARKER') does not match VERSION ('$FILE') — the marker is byte-identical to VERSION by contract (Forma A (ii), fail-closed)"
   101	            exit 1
   102	          fi
   103	          echo "OK: .claude/.framework-version=$MARKER matches VERSION"
   104	
   105	      # -----------------------------------------------------------------
   106	      # PLAN-153 Wave B item 5 (e) — version↔plugin-manifest sync, kept
   107	      # NEXT TO the VERSION↔tag assert above so the whole
   108	      # version-consistency family lives in one place.
   109	      #
   110	      # `.claude-plugin/{plugin.json,marketplace.json}` are generated by
   111	      # `build-plugin.py` (Wave B item 6). Until item 6 lands, the
   112	      # manifests do not exist and this step passes with a ::notice
   113	      # (self-arming: the equality checks become enforcing the moment
   114	      # the manifests appear in the tree — no workflow re-edit needed).
   115	      # `marketplace.json`'s schema is owned by build-plugin.py, so we
   116	      # assert on EVERY nested `version` field found rather than
   117	      # hardcoding one JSON path.
   118	      # -----------------------------------------------------------------
   119	      - name: Assert plugin manifest versions match VERSION
   120	        run: |
   121	          set -euo pipefail
   122	          FILE="$(tr -d '[:space:]' < VERSION)"
   123	          if [[ ! -f .claude-plugin/plugin.json ]]; then
   124	            echo "::notice::.claude-plugin/plugin.json not present yet (PLAN-153 Wave B item 6) — sync check self-arms once it lands"
   125	            exit 0
   126	          fi
   127	          PLUGIN_V=$(jq -r '.version // empty' .claude-plugin/plugin.json)
   128	          if [[ "$PLUGIN_V" != "$FILE" ]]; then
   129	            echo "::error::.claude-plugin/plugin.json version ('$PLUGIN_V') does not match VERSION ('$FILE')"
   130	            exit 1
   620	
   621	      - name: Verify owner.asc populated
   622	        # Session 75 Codex Finding 1 closure: prior workflow imported
   623	        # `.claude/trust/owner.asc` without validating it carries a real
   624	        # PGP block. Empty file silently no-ops `gpg --import` and the
   625	        # subsequent `git tag --verify` could fall through. Fail-closed
   626	        # gate ensures the trust anchor is populated before the import.
   627	        run: |
   628	          set -euo pipefail
   629	          if [ ! -s .claude/trust/owner.asc ]; then
   630	            echo "::error::.claude/trust/owner.asc is empty — release gate cannot verify tag signature"
   631	            exit 1
   632	          fi
   633	          if ! gpg --show-keys .claude/trust/owner.asc >/dev/null 2>&1; then
   634	            echo "::error::.claude/trust/owner.asc is not a valid PGP public-key block"
   635	            exit 1
   636	          fi
   637	          echo "OK: owner.asc is populated and parseable"
   638	
   639	      - name: Verify tag GPG signature
   640	        # PLAN-044 audit-v2 C2-P0-02 — activated Wave A 2026-04-27 (Owner pubkey at .claude/trust/owner.asc; PLAN-063 round-4: removed `if: true` per actionlint if-cond)
   641	        run: |
   642	          gpg --import .claude/trust/owner.asc
   643	          git tag --verify ${{ github.ref_name }}
