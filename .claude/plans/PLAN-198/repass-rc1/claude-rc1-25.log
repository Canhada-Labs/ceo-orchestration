{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NtvmVJ9NbzZoj8ecd2BsfB","type":"tool_result","content":"1\t#!/bin/bash\n2\t# ceo-backup.sh — snapshot framework state to ~/.ceo-backups/<slug>/\n3\t#\n4\t# Snapshots:\n5\t#   - ${CEO_AUDIT_LOG_DIR:-$HOME/.claude/projects/<slug>}/audit-log.jsonl\n6\t#   - same dir's memory/ subtree (auto-memory)\n7\t#   - .claude/agent-metrics.md (in-repo)\n8\t#   - optionally .claude/plans/ (--include-plans)\n9\t#\n10\t# Output: ts-named tarball at ~/.ceo-backups/<slug>/ceo-backup-YYYY-MM-DDTHHMMSSZ.tar.gz\n11\t#         + sidecar SHA256 file\n12\t#\n13\t# Rotation policy (default):\n14\t#   - keep last 7 daily backups\n15\t#   - keep last 4 weekly backups (Sundays)\n16\t#   - keep last 3 monthly backups (1st of month)\n17\t#\n18\t# Stdlib only (tar + sha256sum or shasum -a 256). No third-party deps.\n19\t#\n20\t# Exit codes:\n21\t#   0 — success\n22\t#   1 — usage error / no audit log to back up\n23\t#   2 — fatal (tar failed, dir unwritable)\n24\t\n25\tset -euo pipefail\n26\t\n27\tDRY_RUN=0\n28\tINCLUDE_PLANS=0\n29\tQUIET=0\n30\tKEEP_DAILY=7\n31\tKEEP_WEEKLY=4\n32\tKEEP_MONTHLY=3\n33\tBACKUP_ROOT_OVERRIDE=\"\"\n34\tPROJECT_SLUG_OVERRIDE=\"\"\n35\tAUDIT_DIR_OVERRIDE=\"\"\n36\t\n37\tusage() {\n38\t  cat <<EOF\n39\tceo-backup.sh — snapshot framework state\n40\t\n41\tUsage:\n42\t  ceo-backup.sh [options]\n43\t\n44\tOptions:\n45\t  --dry-run                Show what would be backed up; create no files\n46\t  --include-plans          Include .claude/plans/ in the tarball\n47\t  --quiet                  Suppress progress output\n48\t  --backup-root <dir>      Override ~/.ceo-backups (default)\n49\t  --project-slug <name>    Override project slug detection (default: ceo-orchestration)\n50\t  --audit-dir <dir>        Override CEO_AUDIT_LOG_DIR\n51\t  --keep-daily <N>         Daily retention (default 7)\n52\t  --keep-weekly <N>        Weekly retention (default 4)\n53\t  --keep-monthly <N>       Monthly retention (default 3)\n54\t  -h, --help               This message\n55\t\n56\tEnv vars honored:\n57\t  CEO_AUDIT_LOG_DIR        Source dir for audit log + memory\n58\t  CEO_PROJECT_NAME         Explicit project slug (default: the single resolver, ADR-001)\n59\t  CEO_BACKUP_ROOT          Default backup destination root\n60\tEOF\n61\t}\n62\t\n63\twhile [[ $# -gt 0 ]]; do\n64\t  case \"$1\" in\n65\t    --dry-run) DRY_RUN=1; shift ;;\n66\t    --include-plans) INCLUDE_PLANS=1; shift ;;\n67\t    --quiet) QUIET=1; shift ;;\n68\t    --backup-root) BACKUP_ROOT_OVERRIDE=\"$2\"; shift 2 ;;\n69\t    --project-slug) PROJECT_SLUG_OVERRIDE=\"$2\"; shift 2 ;;\n70\t    --audit-dir) AUDIT_DIR_OVERRIDE=\"$2\"; shift 2 ;;\n71\t    --keep-daily) KEEP_DAILY=\"$2\"; shift 2 ;;\n72\t    --keep-weekly) KEEP_WEEKLY=\"$2\"; shift 2 ;;\n73\t    --keep-monthly) KEEP_MONTHLY=\"$2\"; shift 2 ;;\n74\t    -h|--help) usage; exit 0 ;;\n75\t    *) echo \"unknown arg: $1\" >&2; usage >&2; exit 1 ;;\n76\t  esac\n77\tdone\n78\t\n79\tlog() {\n80\t  if [ \"$QUIET\" -eq 0 ]; then\n81\t    echo \"$@\" >&2\n82\t  fi\n83\t  return 0\n84\t}\n85\t\n86\t# The framework SINGLE resolver (ADR-001; PLAN-182 OQ-6, S326). The old\n87\t# default slug `ceo-orchestration` named THIS framework, not the adopter: every\n88\t# project under one $HOME backed up -- and restored -- the same shared dir.\n89\t# `--project-slug` / CEO_PROJECT_NAME stay as EXPLICIT operator overrides;\n90\t# nothing is defaulted from a literal. No resolver on disk (partial upgrade)\n91\t# => fail loud rather than guess where the state lives.\n92\t# `|| true` inside: under `set -e` a failed `cd` (script copied outside a\n93\t# framework tree) would abort this assignment SILENTLY, before _resolve_rp can\n94\t# print its loud `fatal:`. An empty dir here simply fails the -f test below.\n95\t_RP_DIR=\"$(dirname \"${BASH_SOURCE[0]}\")/../hooks/_lib\"\n96\t_RP=\"$( { cd \"$_RP_DIR\" 2>/dev/null && pwd; } || printf '%s' \"$_RP_DIR\" )/runtime_paths.py\"\n97\t_project_root() {\n98\t  # The project the state belongs to (rail r1 P2 + r3 P1):\n99\t  #   1. the harness-set CLAUDE_PROJECT_DIR;\n100\t  #   2. else walk up from the CWD to the nearest `.claude/` (the resolver\n101\t  #      falls back to the CWD, so a call from a SUBDIRECTORY would otherwise\n102\t  #      name the subdirectory);\n103\t  #   3. else the project this script is INSTALLED in — it lives at\n104\t  #      <project>/.claude/scripts/ — because the documented cron entry\n105\t  #      (docs/DISASTER-RECOVERY.md) invokes it by absolute path with\n106\t  #      CWD=$HOME and no CLAUDE_PROJECT_DIR, where step 2 finds nothing.\n107\t  # Nothing at all => failure (never a guessed slug).\n108\t  if [ -n \"${CLAUDE_PROJECT_DIR:-}\" ]; then printf '%s' \"$CLAUDE_PROJECT_DIR\"; return 0; fi\n109\t  # A project is a directory with the framework INSTALL MARKER — not merely a\n110\t  # `.claude/` (rail r4 P1): under the documented cron, CWD=$HOME and the\n111\t  # user's GLOBAL ~/.claude exists, so a bare `-d .claude` test picked $HOME\n112\t  # as the project and the backup targeted the wrong slug with exit 0.\n113\t  local cur\n114\t  cur=\"$(pwd)\"\n115\t  while [ \"$cur\" != \"/\" ]; do\n116\t    if [ -f \"$cur/.claude/.framework-version\" ]; then printf '%s' \"$cur\"; return 0; fi\n117\t    cur=\"$(dirname \"$cur\")\"\n118\t  done\n119\t  local here\n120\t  here=\"$( { cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" 2>/dev/null && pwd; } || true )\"\n121\t  if [ -n \"$here\" ] && [ -d \"$here/.claude/scripts\" ] && [ -d \"$here/.claude/hooks\" ]; then printf '%s' \"$here\"; return 0; fi\n122\t  return 1\n123\t}\n124\t_resolve_rp() {\n125\t  if [ ! -f \"$_RP\" ] || ! command -v python3 >/dev/null 2>&1; then\n126\t    echo \"fatal: single resolver not found at $_RP (run scripts/upgrade.sh) -- refusing to guess the state dir\" >&2\n127\t    return 2\n128\t  fi\n129\t  local root\n130\t  root=\"$(_project_root)\" || {\n131\t    echo \"fatal: no project root (.claude/) above $(pwd) and CLAUDE_PROJECT_DIR unset -- pass --project-slug or run from the project\" >&2\n132\t    return 2\n133\t  }\n134\t  python3 \"$_RP\" --project \"$root\" \"$@\"\n135\t}\n136\t\n137\t# Resolve project slug\n138\tif [ -n \"${PROJECT_SLUG_OVERRIDE:-}\" ]; then\n139\t  PROJECT_SLUG=\"$PROJECT_SLUG_OVERRIDE\"\n140\telif [ -n \"${CEO_PROJECT_NAME:-}\" ]; then\n141\t  PROJECT_SLUG=\"$CEO_PROJECT_NAME\"\n142\telse\n143\t  PROJECT_SLUG=\"$(_resolve_rp --slug)\" || exit 2\n144\tfi\n145\t[ -n \"$PROJECT_SLUG\" ] || { echo \"fatal: empty project slug\" >&2; exit 2; }\n146\t\n147\t# Resolve audit dir (where audit-log.jsonl + memory/ live)\n148\tif [ -n \"$AUDIT_DIR_OVERRIDE\" ]; then\n149\t  AUDIT_DIR=\"$AUDIT_DIR_OVERRIDE\"\n150\telif [ -n \"${CEO_AUDIT_LOG_DIR:-}\" ]; then\n151\t  AUDIT_DIR=\"$CEO_AUDIT_LOG_DIR\"\n152\telif [ -n \"${PROJECT_SLUG_OVERRIDE:-}${CEO_PROJECT_NAME:-}\" ]; then\n153\t  # An explicit operator slug names the state dir directly under $HOME.\n154\t  AUDIT_DIR=\"$HOME/.claude/projects/$PROJECT_SLUG\"\n155\telse\n156\t  AUDIT_DIR=\"$(_resolve_rp --state-dir)\" || exit 2\n157\tfi\n158\t[ -n \"$AUDIT_DIR\" ] || { echo \"fatal: empty audit dir\" >&2; exit 2; }\n159\t\n160\t# Resolve backup root\n161\tBACKUP_ROOT=\"${BACKUP_ROOT_OVERRIDE:-${CEO_BACKUP_ROOT:-$HOME/.ceo-backups}}\"\n162\tBACKUP_DIR=\"$BACKUP_ROOT/$PROJECT_SLUG\"\n163\t\n164\tlog \"ceo-backup: source=$AUDIT_DIR slug=$PROJECT_SLUG dest=$BACKUP_DIR\"\n165\t\n166\t# Validate source\n167\tif [ ! -d \"$AUDIT_DIR\" ]; then\n168\t  echo \"warning: audit dir not found: $AUDIT_DIR (nothing to back up)\" >&2\n169\t  echo \"(framework hasn't run yet; this is expected on a fresh install)\" >&2\n170\t  exit 0\n171\tfi\n172\t\n173\t# Resolve sha256 binary (gnu vs mac)\n174\tSHA256_BIN=\"\"\n175\tif command -v sha256sum >/dev/null 2>&1; then\n176\t  SHA256_BIN=\"sha256sum\"\n177\telif command -v shasum >/dev/null 2>&1; then\n178\t  SHA256_BIN=\"shasum -a 256\"\n179\telse\n180\t  echo \"fatal: neither sha256sum nor shasum -a 256 available\" >&2\n181\t  exit 2\n182\tfi\n183\t\n184\t# Find adopter project root (CWD walks up looking for .claude/agent-metrics.md or .claude/)\n185\tADOPTER_ROOT=\"\"\n186\tcur=\"$(pwd)\"\n187\twhile [ \"$cur\" != \"/\" ]; do\n188\t  if [ -d \"$cur/.claude\" ]; then\n189\t    ADOPTER_ROOT=\"$cur\"\n190\t    break\n191\t  fi\n192\t  cur=\"$(dirname \"$cur\")\"\n193\tdone\n194\t\n195\t# Build the file list\n196\tTS=\"$(date -u +%Y-%m-%dT%H%M%SZ)\"\n197\tARCHIVE_NAME=\"ceo-backup-$TS.tar.gz\"\n198\t\n199\tif [ \"$DRY_RUN\" -eq 1 ]; then\n200\t  log \"\"\n201\t  log \"[dry-run] would create: $BACKUP_DIR/$ARCHIVE_NAME\"\n202\t  log \"[dry-run] would include:\"\n203\t  [ -f \"$AUDIT_DIR/audit-log.jsonl\" ] && log \"  - $AUDIT_DIR/audit-log.jsonl\"\n204\t  for f in \"$AUDIT_DIR\"/audit-log-*.jsonl; do\n205\t    [ -f \"$f\" ] && log \"  - $f\"\n206\t  done\n207\t  [ -d \"$AUDIT_DIR/memory\" ] && log \"  - $AUDIT_DIR/memory/\"\n208\t  if [ -n \"$ADOPTER_ROOT\" ] && [ -f \"$ADOPTER_ROOT/.claude/agent-metrics.md\" ]; then\n209\t    log \"  - $ADOPTER_ROOT/.claude/agent-metrics.md\"\n210\t  fi\n211\t  if [ \"$INCLUDE_PLANS\" -eq 1 ] && [ -n \"$ADOPTER_ROOT\" ] && [ -d \"$ADOPTER_ROOT/.claude/plans\" ]; then\n212\t    log \"  - $ADOPTER_ROOT/.claude/plans/\"\n213\t  fi\n214\t  log \"\"\n215\t  log \"[dry-run] retention: keep $KEEP_DAILY daily + $KEEP_WEEKLY weekly + $KEEP_MONTHLY monthly\"\n216\t  exit 0\n217\tfi\n218\t\n219\tmkdir -p \"$BACKUP_DIR\"\n220\t\n221\t# Stage in a temp dir then tar — atomic produce + verify\n222\tSTAGE_DIR=\"$(mktemp -d -t ceo-backup-stage-XXXXXX)\"\n223\ttrap 'rm -rf \"$STAGE_DIR\"' EXIT\n224\t\n225\t# Layout inside the tarball:\n226\t#   audit/audit-log.jsonl\n227\t#   audit/audit-log-YYYY-MM.jsonl  (rotated archives)\n228\t#   audit/audit-log.errors  (if present)\n229\t#   memory/<files>\n230\t#   agent-metrics.md  (if present)\n231\t#   plans/<files>     (if --include-plans)\n232\t\n233\tif [ -f \"$AUDIT_DIR/audit-log.jsonl\" ]; then\n234\t  mkdir -p \"$STAGE_DIR/audit\"\n235\t  cp -p \"$AUDIT_DIR/audit-log.jsonl\" \"$STAGE_DIR/audit/\"\n236\tfi\n237\tfor f in \"$AUDIT_DIR\"/audit-log-*.jsonl; do\n238\t  [ -f \"$f\" ] || continue\n239\t  mkdir -p \"$STAGE_DIR/audit\"\n240\t  cp -p \"$f\" \"$STAGE_DIR/audit/\"\n241\tdone\n242\tif [ -f \"$AUDIT_DIR/audit-log.errors\" ]; then\n243\t  mkdir -p \"$STAGE_DIR/audit\"\n244\t  cp -p \"$AUDIT_DIR/audit-log.errors\" \"$STAGE_DIR/audit/\"\n245\tfi\n246\t\n247\tif [ -d \"$AUDIT_DIR/memory\" ]; then\n248\t  mkdir -p \"$STAGE_DIR/memory\"\n249\t  # Snapshot regular files only.  Keeping a link would make a later restore\n250\t  # able to redirect writes outside the selected state directory.\n251\t  while IFS= read -r -d '' f; do\n252\t    rel=\"${f#\"$AUDIT_DIR/memory/\"}\"\n253\t    mkdir -p \"$STAGE_DIR/memory/$(dirname \"$rel\")\"\n254\t    cp -p -- \"$f\" \"$STAGE_DIR/memory/$rel\"\n255\t  done < <(find \"$AUDIT_DIR/memory\" -type f -print0)\n256\tfi\n257\t\n258\tif [ -n \"$ADOPTER_ROOT\" ] && [ -f \"$ADOPTER_ROOT/.claude/agent-metrics.md\" ]; then\n259\t  cp -p \"$ADOPTER_ROOT/.claude/agent-metrics.md\" \"$STAGE_DIR/\"\n260\tfi\n261\t\n262\tif [ \"$INCLUDE_PLANS\" -eq 1 ] && [ -n \"$ADOPTER_ROOT\" ] && [ -d \"$ADOPTER_ROOT/.claude/plans\" ]; then\n263\t  mkdir -p \"$STAGE_DIR/plans\"\n264\t  cp -pR \"$ADOPTER_ROOT/.claude/plans/.\" \"$STAGE_DIR/plans/\"\n265\tfi\n266\t\n267\t# Detect empty stage — bail with explanation\n268\tif [ -z \"$(ls -A \"$STAGE_DIR\" 2>/dev/null)\" ]; then\n269\t  echo \"warning: nothing to back up at $AUDIT_DIR\" >&2\n270\t  exit 0\n271\tfi\n272\t\n273\t# Manifest of what's in the tarball\n274\t( cd \"$STAGE_DIR\" && find . -type f | sort > MANIFEST.txt )\n275\t\n276\t# Tar.  COPYFILE_DISABLE=1 stops macOS tar (bsdtar) from writing an\n277\t# AppleDouble member `._<name>` before every entry that carries extended\n278\t# attributes; GNU tar does not read the variable, so Linux is unchanged.\n279\tARCHIVE_PATH=\"$BACKUP_DIR/$ARCHIVE_NAME\"\n280\t( cd \"$STAGE_DIR\" && COPYFILE_DISABLE=1 tar -czf \"$ARCHIVE_PATH\" . )\n281\t\n282\t# Sidecar SHA256\n283\tSHA_PATH=\"$ARCHIVE_PATH.sha256\"\n284\t$SHA256_BIN \"$ARCHIVE_PATH\" | awk '{print $1}' > \"$SHA_PATH\"\n285\t\n286\tlog \"ok: $ARCHIVE_PATH ($(stat -f%z \"$ARCHIVE_PATH\" 2>/dev/null || stat -c%s \"$ARCHIVE_PATH\") bytes)\"\n287\tlog \"sha256: $(cat \"$SHA_PATH\")\"\n288\t\n289\t# ----- Rotation -----\n290\t#\n291\t# Group existing backups by intent:\n292\t#   - Daily: any backup ≤ KEEP_DAILY days old (most recent N)\n293\t#   - Weekly: oldest of each ISO-week, up to KEEP_WEEKLY\n294\t#   - Monthly: oldest of each YYYY-MM, up to KEEP_MONTHLY\n295\t# Anything else is removed.\n296\t\n297\t# List all backups, newest first\n298\tALL_BACKUPS=()\n299\twhile IFS= read -r line; do\n300\t  [ -n \"$line\" ] && ALL_BACKUPS+=(\"$line\")\n301\tdone < <(ls -t \"$BACKUP_DIR\"/ceo-backup-*.tar.gz 2>/dev/null || true)\n302\t\n303\tif [ \"${#ALL_BACKUPS[@]}\" -le 1 ]; then\n304\t  log \"rotation: only ${#ALL_BACKUPS[@]} backup(s) present; nothing to prune\"\n305\t  exit 0\n306\tfi\n307\t\n308\t# bash 3.2 has no associative arrays; use newline-delimited strings as sets\n309\t# (keys are fs-safe backup names / week / month tokens — no embedded newlines).\n310\tKEEP_LIST=\"\"\n311\t# Newest N → daily slot\n312\ti=0\n313\tfor b in \"${ALL_BACKUPS[@]}\"; do\n314\t  [ \"$i\" -ge \"$KEEP_DAILY\" ] && break   # check BEFORE appending so --keep-daily 0 keeps zero\n315\t  KEEP_LIST=\"$KEEP_LIST\"$'\\n'\"$b\"\n316\t  i=$((i+1))\n317\tdone\n318\t\n319\t# Walk backups and group by week / month\n320\tWEEK_KEEP_LIST=\"\"\n321\tMONTH_KEEP_LIST=\"\"\n322\tWEEK_KEEP_COUNT=0\n323\tMONTH_KEEP_COUNT=0\n324\tfor b in \"${ALL_BACKUPS[@]}\"; do\n325\t  base=\"$(basename \"$b\" .tar.gz)\"\n326\t  # ceo-backup-YYYY-MM-DDTHHMMSSZ\n327\t  ts=\"${base#ceo-backup-}\"\n328\t  date_part=\"${ts%T*}\"\n329\t  # Extract YYYY-MM and YYYY-WNN\n330\t  ym=\"${date_part%-*}\"\n331\t  case $'\\n'\"$MONTH_KEEP_LIST\"$'\\n' in\n332\t    *$'\\n'\"$ym\"$'\\n'*) : ;; # already have this month\n333\t    *)\n334\t      if [ \"$MONTH_KEEP_COUNT\" -lt \"$KEEP_MONTHLY\" ]; then\n335\t        MONTH_KEEP_LIST=\"$MONTH_KEEP_LIST\"$'\\n'\"$ym\"\n336\t        MONTH_KEEP_COUNT=$((MONTH_KEEP_COUNT+1))\n337\t        KEEP_LIST=\"$KEEP_LIST\"$'\\n'\"$b\"\n338\t      fi\n339\t      ;;\n340\t  esac\n341\t  # ISO week\n342\t  if command -v gdate >/dev/null 2>&1; then\n343\t    iw=\"$(gdate -d \"$date_part\" +%G-%V 2>/dev/null || echo \"$date_part\")\"\n344\t  else\n345\t    # macOS BSD date\n346\t    iw=\"$(date -j -f \"%Y-%m-%d\" \"$date_part\" +%G-%V 2>/dev/null || echo \"$date_part\")\"\n347\t  fi\n348\t  case $'\\n'\"$WEEK_KEEP_LIST\"$'\\n' in\n349\t    *$'\\n'\"$iw\"$'\\n'*) : ;; # already have this week\n350\t    *)\n351\t      if [ \"$WEEK_KEEP_COUNT\" -lt \"$KEEP_WEEKLY\" ]; then\n352\t        WEEK_KEEP_LIST=\"$WEEK_KEEP_LIST\"$'\\n'\"$iw\"\n353\t        WEEK_KEEP_COUNT=$((WEEK_KEEP_COUNT+1))\n354\t        KEEP_LIST=\"$KEEP_LIST\"$'\\n'\"$b\"\n355\t      fi\n356\t      ;;\n357\t  esac\n358\tdone\n359\t\n360\t# Prune\n361\tPRUNED=0\n362\tfor b in \"${ALL_BACKUPS[@]}\"; do\n363\t  case $'\\n'\"$KEEP_LIST\"$'\\n' in\n364\t    *$'\\n'\"$b\"$'\\n'*) : ;; # keep\n365\t    *)\n366\t      rm -f \"$b\" \"$b.sha256\"\n367\t      PRUNED=$((PRUNED+1))\n368\t      ;;\n369\t  esac\n370\tdone\n371\t\n372\t# KEEP_LIST may list a backup twice (daily slot + week/month rep); dedup for the count.\n373\t# Use `awk 'NF'` (not `grep .`) to drop blank lines: grep exits 1 on an all-empty list\n374\t# (e.g. --keep-daily/weekly/monthly all 0), which would abort the script under\n375\t# `set -euo pipefail` before the final log/exit; awk exits 0 and yields a count of 0.\n376\tKEPT_COUNT=\"$(printf '%s\\n' \"$KEEP_LIST\" | awk 'NF' | sort -u | wc -l | tr -d ' ')\"\n377\tlog \"rotation: kept $KEPT_COUNT, pruned $PRUNED\"\n378\texit 0\n379\t"}]},"parent_tool_use_id":null,"session_id":"83b20cfd-a908-4fe3-8caa-faf4ef8d086d","uuid":"6c0de92d-f1e2-4ef9-b422-86bd28c91e88","timestamp":"2026-11-15T11:09:19.462Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/scripts/ceo-backup.sh","content":"#!/bin/bash\n# ceo-backup.sh — snapshot framework state to ~/.ceo-backups/<slug>/\n#\n# Snapshots:\n#   - ${CEO_AUDIT_LOG_DIR:-$HOME/.claude/projects/<slug>}/audit-log.jsonl\n#   - same dir's memory/ subtree (auto-memory)\n#   - .claude/agent-metrics.md (in-repo)\n#   - optionally .claude/plans/ (--include-plans)\n#\n# Output: ts-named tarball at ~/.ceo-backups/<slug>/ceo-backup-YYYY-MM-DDTHHMMSSZ.tar.gz\n#         + sidecar SHA256 file\n#\n# Rotation policy (default):\n#   - keep last 7 daily backups\n#   - keep last 4 weekly backups (Sundays)\n#   - keep last 3 monthly backups (1st of month)\n#\n# Stdlib only (tar + sha256sum or shasum -a 256). No third-party deps.\n#\n# Exit codes:\n#   0 — success\n#   1 — usage error / no audit log to back up\n#   2 — fatal (tar failed, dir unwritable)\n\nset -euo pipefail\n\nDRY_RUN=0\nINCLUDE_PLANS=0\nQUIET=0\nKEEP_DAILY=7\nKEEP_WEEKLY=4\nKEEP_MONTHLY=3\nBACKUP_ROOT_OVERRIDE=\"\"\nPROJECT_SLUG_OVERRIDE=\"\"\nAUDIT_DIR_OVERRIDE=\"\"\n\nusage() {\n  cat <<EOF\nceo-backup.sh — snapshot framework state\n\nUsage:\n  ceo-backup.sh [options]\n\nOptions:\n  --dry-run                Show what would be backed up; create no files\n  --include-plans          Include .claude/plans/ in the tarball\n  --quiet                  Suppress progress output\n  --backup-root <dir>      Override ~/.ceo-backups (default)\n  --project-slug <name>    Override project slug detection (default: ceo-orchestration)\n  --audit-dir <dir>        Override CEO_AUDIT_LOG_DIR\n  --keep-daily <N>         Daily retention (default 7)\n  --keep-weekly <N>        Weekly retention (default 4)\n  --keep-monthly <N>       Monthly retention (default 3)\n  -h, --help               This message\n\nEnv vars honored:\n  CEO_AUDIT_LOG_DIR        Source dir for audit log + memory\n  CEO_PROJECT_NAME         Explicit project slug (default: the single resolver, ADR-001)\n  CEO_BACKUP_ROOT          Default backup destination root\nEOF\n}\n\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --dry-run) DRY_RUN=1; shift ;;\n    --include-plans) INCLUDE_PLANS=1; shift ;;\n    --quiet) QUIET=1; shift ;;\n    --backup-root) BACKUP_ROOT_OVERRIDE=\"$2\"; shift 2 ;;\n    --project-slug) PROJECT_SLUG_OVERRIDE=\"$2\"; shift 2 ;;\n    --audit-dir) AUDIT_DIR_OVERRIDE=\"$2\"; shift 2 ;;\n    --keep-daily) KEEP_DAILY=\"$2\"; shift 2 ;;\n    --keep-weekly) KEEP_WEEKLY=\"$2\"; shift 2 ;;\n    --keep-monthly) KEEP_MONTHLY=\"$2\"; shift 2 ;;\n    -h|--help) usage; exit 0 ;;\n    *) echo \"unknown arg: $1\" >&2; usage >&2; exit 1 ;;\n  esac\ndone\n\nlog() {\n  if [ \"$QUIET\" -eq 0 ]; then\n    echo \"$@\" >&2\n  fi\n  return 0\n}\n\n# The framework SINGLE resolver (ADR-001; PLAN-182 OQ-6, S326). The old\n# default slug `ceo-orchestration` named THIS framework, not the adopter: every\n# project under one $HOME backed up -- and restored -- the same shared dir.\n# `--project-slug` / CEO_PROJECT_NAME stay as EXPLICIT operator overrides;\n# nothing is defaulted from a literal. No resolver on disk (partial upgrade)\n# => fail loud rather than guess where the state lives.\n# `|| true` inside: under `set -e` a failed `cd` (script copied outside a\n# framework tree) would abort this assignment SILENTLY, before _resolve_rp can\n# print its loud `fatal:`. An empty dir here simply fails the -f test below.\n_RP_DIR=\"$(dirname \"${BASH_SOURCE[0]}\")/../hooks/_lib\"\n_RP=\"$( { cd \"$_RP_DIR\" 2>/dev/null && pwd; } || printf '%s' \"$_RP_DIR\" )/runtime_paths.py\"\n_project_root() {\n  # The project the state belongs to (rail r1 P2 + r3 P1):\n  #   1. the harness-set CLAUDE_PROJECT_DIR;\n  #   2. else walk up from the CWD to the nearest `.claude/` (the resolver\n  #      falls back to the CWD, so a call from a SUBDIRECTORY would otherwise\n  #      name the subdirectory);\n  #   3. else the project this script is INSTALLED in — it lives at\n  #      <project>/.claude/scripts/ — because the documented cron entry\n  #      (docs/DISASTER-RECOVERY.md) invokes it by absolute path with\n  #      CWD=$HOME and no CLAUDE_PROJECT_DIR, where step 2 finds nothing.\n  # Nothing at all => failure (never a guessed slug).\n  if [ -n \"${CLAUDE_PROJECT_DIR:-}\" ]; then printf '%s' \"$CLAUDE_PROJECT_DIR\"; return 0; fi\n  # A project is a directory with the framework INSTALL MARKER — not merely a\n  # `.claude/` (rail r4 P1): under the documented cron, CWD=$HOME and the\n  # user's GLOBAL ~/.claude exists, so a bare `-d .claude` test picked $HOME\n  # as the project and the backup targeted the wrong slug with exit 0.\n  local cur\n  cur=\"$(pwd)\"\n  while [ \"$cur\" != \"/\" ]; do\n    if [ -f \"$cur/.claude/.framework-version\" ]; then printf '%s' \"$cur\"; return 0; fi\n    cur=\"$(dirname \"$cur\")\"\n  done\n  local here\n  here=\"$( { cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" 2>/dev/null && pwd; } || true )\"\n  if [ -n \"$here\" ] && [ -d \"$here/.claude/scripts\" ] && [ -d \"$here/.claude/hooks\" ]; then printf '%s' \"$here\"; return 0; fi\n  return 1\n}\n_resolve_rp() {\n  if [ ! -f \"$_RP\" ] || ! command -v python3 >/dev/null 2>&1; then\n    echo \"fatal: single resolver not found at $_RP (run scripts/upgrade.sh) -- refusing to guess the state dir\" >&2\n    return 2\n  fi\n  local root\n  root=\"$(_project_root)\" || {\n    echo \"fatal: no project root (.claude/) above $(pwd) and CLAUDE_PROJECT_DIR unset -- pass --project-slug or run from the project\" >&2\n    return 2\n  }\n  python3 \"$_RP\" --project \"$root\" \"$@\"\n}\n\n# Resolve project slug\nif [ -n \"${PROJECT_SLUG_OVERRIDE:-}\" ]; then\n  PROJECT_SLUG=\"$PROJECT_SLUG_OVERRIDE\"\nelif [ -n \"${CEO_PROJECT_NAME:-}\" ]; then\n  PROJECT_SLUG=\"$CEO_PROJECT_NAME\"\nelse\n  PROJECT_SLUG=\"$(_resolve_rp --slug)\" || exit 2\nfi\n[ -n \"$PROJECT_SLUG\" ] || { echo \"fatal: empty project slug\" >&2; exit 2; }\n\n# Resolve audit dir (where audit-log.jsonl + memory/ live)\nif [ -n \"$AUDIT_DIR_OVERRIDE\" ]; then\n  AUDIT_DIR=\"$AUDIT_DIR_OVERRIDE\"\nelif [ -n \"${CEO_AUDIT_LOG_DIR:-}\" ]; then\n  AUDIT_DIR=\"$CEO_AUDIT_LOG_DIR\"\nelif [ -n \"${PROJECT_SLUG_OVERRIDE:-}${CEO_PROJECT_NAME:-}\" ]; then\n  # An explicit operator slug names the state dir directly under $HOME.\n  AUDIT_DIR=\"$HOME/.claude/projects/$PROJECT_SLUG\"\nelse\n  AUDIT_DIR=\"$(_resolve_rp --state-dir)\" || exit 2\nfi\n[ -n \"$AUDIT_DIR\" ] || { echo \"fatal: empty audit dir\" >&2; exit 2; }\n\n# Resolve backup root\nBACKUP_ROOT=\"${BACKUP_ROOT_OVERRIDE:-${CEO_BACKUP_ROOT:-$HOME/.ceo-backups}}\"\nBACKUP_DIR=\"$BACKUP_ROOT/$PROJECT_SLUG\"\n\nlog \"ceo-backup: source=$AUDIT_DIR slug=$PROJECT_SLUG dest=$BACKUP_DIR\"\n\n# Validate source\nif [ ! -d \"$AUDIT_DIR\" ]; then\n  echo \"warning: audit dir not found: $AUDIT_DIR (nothing to back up)\" >&2\n  echo \"(framework hasn't run yet; this is expected on a fresh install)\" >&2\n  exit 0\nfi\n\n# Resolve sha256 binary (gnu vs mac)\nSHA256_BIN=\"\"\nif command -v sha256sum >/dev/null 2>&1; then\n  SHA256_BIN=\"sha256sum\"\nelif command -v shasum >/dev/null 2>&1; then\n  SHA256_BIN=\"shasum -a 256\"\nelse\n  echo \"fatal: neither sha256sum nor shasum -a 256 available\" >&2\n  exit 2\nfi\n\n# Find adopter project root (CWD walks up looking for .claude/agent-metrics.md or .claude/)\nADOPTER_ROOT=\"\"\ncur=\"$(pwd)\"\nwhile [ \"$cur\" != \"/\" ]; do\n  if [ -d \"$cur/.claude\" ]; then\n    ADOPTER_ROOT=\"$cur\"\n    break\n  fi\n  cur=\"$(dirname \"$cur\")\"\ndone\n\n# Build the file list\nTS=\"$(date -u +%Y-%m-%dT%H%M%SZ)\"\nARCHIVE_NAME=\"ceo-backup-$TS.tar.gz\"\n\nif [ \"$DRY_RUN\" -eq 1 ]; then\n  log \"\"\n  log \"[dry-run] would create: $BACKUP_DIR/$ARCHIVE_NAME\"\n  log \"[dry-run] would include:\"\n  [ -f \"$AUDIT_DIR/audit-log.jsonl\" ] && log \"  - $AUDIT_DIR/audit-log.jsonl\"\n  for f in \"$AUDIT_DIR\"/audit-log-*.jsonl; do\n    [ -f \"$f\" ] && log \"  - $f\"\n  done\n  [ -d \"$AUDIT_DIR/memory\" ] && log \"  - $AUDIT_DIR/memory/\"\n  if [ -n \"$ADOPTER_ROOT\" ] && [ -f \"$ADOPTER_ROOT/.claude/agent-metrics.md\" ]; then\n    log \"  - $ADOPTER_ROOT/.claude/agent-metrics.md\"\n  fi\n  if [ \"$INCLUDE_PLANS\" -eq 1 ] && [ -n \"$ADOPTER_ROOT\" ] && [ -d \"$ADOPTER_ROOT/.claude/plans\" ]; then\n    log \"  - $ADOPTER_ROOT/.claude/plans/\"\n  fi\n  log \"\"\n  log \"[dry-run] retention: keep $KEEP_DAILY daily + $KEEP_WEEKLY weekly + $KEEP_MONTHLY monthly\"\n  exit 0\nfi\n\nmkdir -p \"$BACKUP_DIR\"\n\n# Stage in a temp dir then tar — atomic produce + verify\nSTAGE_DIR=\"$(mktemp -d -t ceo-backup-stage-XXXXXX)\"\ntrap 'rm -rf \"$STAGE_DIR\"' EXIT\n\n# Layout inside the tarball:\n#   audit/audit-log.jsonl\n#   audit/audit-log-YYYY-MM.jsonl  (rotated archives)\n#   audit/audit-log.errors  (if present)\n#   memory/<files>\n#   agent-metrics.md  (if present)\n#   plans/<files>     (if --include-plans)\n\nif [ -f \"$AUDIT_DIR/audit-log.jsonl\" ]; then\n  mkdir -p \"$STAGE_DIR/audit\"\n  cp -p \"$AUDIT_DIR/audit-log.jsonl\" \"$STAGE_DIR/audit/\"\nfi\nfor f in \"$AUDIT_DIR\"/audit-log-*.jsonl; do\n  [ -f \"$f\" ] || continue\n  mkdir -p \"$STAGE_DIR/audit\"\n  cp -p \"$f\" \"$STAGE_DIR/audit/\"\ndone\nif [ -f \"$AUDIT_DIR/audit-log.errors\" ]; then\n  mkdir -p \"$STAGE_DIR/audit\"\n  cp -p \"$AUDIT_DIR/audit-log.errors\" \"$STAGE_DIR/audit/\"\nfi\n\nif [ -d \"$AUDIT_DIR/memory\" ]; then\n  mkdir -p \"$STAGE_DIR/memory\"\n  # Snapshot regular files only.  Keeping a link would make a later restore\n  # able to redirect writes outside the selected state directory.\n  while IFS= read -r -d '' f; do\n    rel=\"${f#\"$AUDIT_DIR/memory/\"}\"\n    mkdir -p \"$STAGE_DIR/memory/$(dirname \"$rel\")\"\n    cp -p -- \"$f\" \"$STAGE_DIR/memory/$rel\"\n  done < <(find \"$AUDIT_DIR/memory\" -type f -print0)\nfi\n\nif [ -n \"$ADOPTER_ROOT\" ] && [ -f \"$ADOPTER_ROOT/.claude/agent-metrics.md\" ]; then\n  cp -p \"$ADOPTER_ROOT/.claude/agent-metrics.md\" \"$STAGE_DIR/\"\nfi\n\nif [ \"$INCLUDE_PLANS\" -eq 1 ] && [ -n \"$ADOPTER_ROOT\" ] && [ -d \"$ADOPTER_ROOT/.claude/plans\" ]; then\n  mkdir -p \"$STAGE_DIR/plans\"\n  cp -pR \"$ADOPTER_ROOT/.claude/plans/.\" \"$STAGE_DIR/plans/\"\nfi\n\n# Detect empty stage — bail with explanation\nif [ -z \"$(ls -A \"$STAGE_DIR\" 2>/dev/null)\" ]; then\n  echo \"warning: nothing to back up at $AUDIT_DIR\" >&2\n  exit 0\nfi\n\n# Manifest of what's in the tarball\n( cd \"$STAGE_DIR\" && find . -type f | sort > MANIFEST.txt )\n\n# Tar.  COPYFILE_DISABLE=1 stops macOS tar (bsdtar) from writing an\n# AppleDouble member `._<name>` before every entry that carries extended\n# attributes; GNU tar does not read the variable, so Linux is unchanged.\nARCHIVE_PATH=\"$BACKUP_DIR/$ARCHIVE_NAME\"\n( cd \"$STAGE_DIR\" && COPYFILE_DISABLE=1 tar -czf \"$ARCHIVE_PATH\" . )\n\n# Sidecar SHA256\nSHA_PATH=\"$ARCHIVE_PATH.sha256\"\n$SHA256_BIN \"$ARCHIVE_PATH\" | awk '{print $1}' > \"$SHA_PATH\"\n\nlog \"ok: $ARCHIVE_PATH ($(stat -f%z \"$ARCHIVE_PATH\" 2>/dev/null || stat -c%s \"$ARCHIVE_PATH\") bytes)\"\nlog \"sha256: $(cat \"$SHA_PATH\")\"\n\n# ----- Rotation -----\n#\n# Group existing backups by intent:\n#   - Daily: any backup ≤ KEEP_DAILY days old (most recent N)\n#   - Weekly: oldest of each ISO-week, up to KEEP_WEEKLY\n#   - Monthly: oldest of each YYYY-MM, up to KEEP_MONTHLY\n# Anything else is removed.\n\n# List all backups, newest first\nALL_BACKUPS=()\nwhile IFS= read -r line; do\n  [ -n \"$line\" ] && ALL_BACKUPS+=(\"$line\")\ndone < <(ls -t \"$BACKUP_DIR\"/ceo-backup-*.tar.gz 2>/dev/null || true)\n\nif [ \"${#ALL_BACKUPS[@]}\" -le 1 ]; then\n  log \"rotation: only ${#ALL_BACKUPS[@]} backup(s) present; nothing to prune\"\n  exit 0\nfi\n\n# bash 3.2 has no associative arrays; use newline-delimited strings as sets\n# (keys are fs-safe backup names / week / month tokens — no embedded newlines).\nKEEP_LIST=\"\"\n# Newest N → daily slot\ni=0\nfor b in \"${ALL_BACKUPS[@]}\"; do\n  [ \"$i\" -ge \"$KEEP_DAILY\" ] && break   # check BEFORE appending so --keep-daily 0 keeps zero\n  KEEP_LIST=\"$KEEP_LIST\"$'\\n'\"$b\"\n  i=$((i+1))\ndone\n\n# Walk backups and group by week / month\nWEEK_KEEP_LIST=\"\"\nMONTH_KEEP_LIST=\"\"\nWEEK_KEEP_COUNT=0\nMONTH_KEEP_COUNT=0\nfor b in \"${ALL_BACKUPS[@]}\"; do\n  base=\"$(basename \"$b\" .tar.gz)\"\n  # ceo-backup-YYYY-MM-DDTHHMMSSZ\n  ts=\"${base#ceo-backup-}\"\n  date_part=\"${ts%T*}\"\n  # Extract YYYY-MM and YYYY-WNN\n  ym=\"${date_part%-*}\"\n  case $'\\n'\"$MONTH_KEEP_LIST\"$'\\n' in\n    *$'\\n'\"$ym\"$'\\n'*) : ;; # already have this month\n    *)\n      if [ \"$MONTH_KEEP_COUNT\" -lt \"$KEEP_MONTHLY\" ]; then\n        MONTH_KEEP_LIST=\"$MONTH_KEEP_LIST\"$'\\n'\"$ym\"\n        MONTH_KEEP_COUNT=$((MONTH_KEEP_COUNT+1))\n        KEEP_LIST=\"$KEEP_LIST\"$'\\n'\"$b\"\n      fi\n      ;;\n  esac\n  # ISO week\n  if command -v gdate >/dev/null 2>&1; then\n    iw=\"$(gdate -d \"$date_part\" +%G-%V 2>/dev/null || echo \"$date_part\")\"\n  else\n    # macOS BSD date\n    iw=\"$(date -j -f \"%Y-%m-%d\" \"$date_part\" +%G-%V 2>/dev/null || echo \"$date_part\")\"\n  fi\n  case $'\\n'\"$WEEK_KEEP_LIST\"$'\\n' in\n    *$'\\n'\"$iw\"$'\\n'*) : ;; # already have this week\n    *)\n      if [ \"$WEEK_KEEP_COUNT\" -lt \"$KEEP_WEEKLY\" ]; then\n        WEEK_KEEP_LIST=\"$WEEK_KEEP_LIST\"$'\\n'\"$iw\"\n        WEEK_KEEP_COUNT=$((WEEK_KEEP_COUNT+1))\n        KEEP_LIST=\"$KEEP_LIST\"$'\\n'\"$b\"\n      fi\n      ;;\n  esac\ndone\n\n# Prune\nPRUNED=0\nfor b in \"${ALL_BACKUPS[@]}\"; do\n  case $'\\n'\"$KEEP_LIST\"$'\\n' in\n    *$'\\n'\"$b\"$'\\n'*) : ;; # keep\n    *)\n      rm -f \"$b\" \"$b.sha256\"\n      PRUNED=$((PRUNED+1))\n      ;;\n  esac\ndone\n\n# KEEP_LIST may list a backup twice (daily slot + week/month rep); dedup for the count.\n# Use `awk 'NF'` (not `grep .`) to drop blank lines: grep exits 1 on an all-empty list\n# (e.g. --keep-daily/weekly/monthly all 0), which would abort the script under\n# `set -euo pipefail` before the final log/exit; awk exits 0 and yields a count of 0.\nKEPT_COUNT=\"$(printf '%s\\n' \"$KEEP_LIST\" | awk 'NF' | sort -u | wc -l | tr -d ' ')\"\nlog \"rotation: kept $KEPT_COUNT, pruned $PRUNED\"\nexit 0\n","numLines":379,"startLine":1,"totalLines":379}},"tool_result_meta":[{"id":"toolu_01NtvmVJ9NbzZoj8ecd2BsfB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
