   243	def lint_file(path: str, rel: str, git_mode: Optional[str]) -> List[dict]:
   244	    findings: List[dict] = []
   245	    try:
   246	        with open(path, errors="replace") as fh:
   247	            body = fh.read()
   248	    except OSError as exc:
   249	        return [{"rule": "R0", "sev": "BLOCKING", "line": 0,
   250	                 "msg": f"ilegível ({exc}) — input fail-closed"}]
   251	    lines = body.splitlines()
   252	
   253	    if PROVENANCE_MARK not in body and EXCEPTION_MARK not in body:
   254	        findings.append({"rule": "R1", "sev": "BLOCKING", "line": 1,
   255	                         "msg": "sem marca AUTO-GENERATED e sem exceção explícita"})
   256	    for i, ln in enumerate(lines, 1):
   257	        if OR_TRUE_RE.search(ln):
   258	            if IRREVERSIBLE_RE.search(ln):
   259	                findings.append({"rule": "R2", "sev": "BLOCKING", "line": i,
   260	                                 "msg": "`|| true` sobre operação remota irreversível"})
   261	            else:
   262	                findings.append({"rule": "R2a", "sev": "ADVISORY", "line": i,
   263	                                 "msg": "`|| true` cru"})
   264	        if GREP_TAIL_RE.search(ln):
   265	            findings.append({"rule": "R3", "sev": "BLOCKING", "line": i,
   266	                             "msg": "grep|tail em parsing de VERDICT"})
   267	        if GIT_ADD_DIR_RE.search(ln):
   268	            findings.append({"rule": "R4", "sev": "BLOCKING", "line": i,
   269	                             "msg": "git add de diretório"})
   270	        if CP_MV_VARDEST_RE.search(ln):
   271	            ctx = "\n".join(lines[max(0, i - 6):i - 1])
   272	            if not SYMLINK_TEST_RE.search(ctx):
   273	                findings.append({"rule": "R5", "sev": "ADVISORY", "line": i,
   274	                                 "msg": "cp/mv p/ destino em variável sem teste -L próximo"})
   275	        if SHASUM_C_RE.search(ln):
   276	            ctx = "\n".join(lines[max(0, i - 4):min(len(lines), i + 3)])
   277	            if not SET_EQ_NEAR_RE.search(ctx):
   278	                findings.append({"rule": "R6", "sev": "ADVISORY", "line": i,
   279	                                 "msg": "shasum -c sem asserção de conjunto (set-equality)"})
   280	    findings.extend(_heredoc_findings(lines))
   281	    if HARNESS_NAME_RE.search(rel) and CALLER_GUARD_MARK not in body:
   282	        findings.append({"rule": "R10", "sev": "ADVISORY", "line": 1,
   283	                         "msg": "harness sem a regressão do repositório chamador"})
   284	    # R8 só na superfície de binding assinado (.claude/plans/): exec-bit
   285	    # em ferramenta de scripts/local/ é legítimo (invocada diretamente).
   286	    if git_mode == "100755" and rel.startswith(".claude/plans/"):
   287	        findings.append({"rule": "R8", "sev": "BLOCKING", "line": 0,
   288	                         "msg": "exec-bit no índice git (modo 100755)"})
   289	    return findings
