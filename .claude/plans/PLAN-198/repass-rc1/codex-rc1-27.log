     1	#!/usr/bin/env python3
     2	"""Validate ceo-restore archive members and extract the accepted ones.
     3	
     4	``<tarball>`` checks every member (exit 2 on the first refused one);
     5	``<tarball> <stage-dir>`` also writes ONLY the accepted members there, so the
     6	preview and the apply of ceo-restore.sh share one rule and one extraction.
     7	
     8	The archive must parse to its end: tarfile stops listing members, with no
     9	error, at a truncated or invalid header, so the member list must end on an
    10	end-of-archive (all-zero) block and the compressed stream must read cleanly
    11	to its end.  Two members with the same name are refused, and so are the key
    12	files ``audit/audit-key`` and ``audit/.salt`` in any letter case (the default
    13	macOS disk, APFS, ignores case).  Every sparse member is refused, an
    14	AppleDouble one included, before anything is written.
    15	
    16	macOS tar writes an AppleDouble member ``._<name>`` (extended-attribute
    17	metadata) before each entry that carries extended attributes.  It is SKIPPED
    18	-- checked, never written -- only when it is a regular file whose companion
    19	(same directory, basename without ``._``; the companion of ``._.`` is the
    20	directory itself) is an accepted member.  Every other ``._`` member is refused.
    21	"""
    22	from __future__ import annotations
    23	
    24	import os
    25	import shutil
    26	import sys
    27	import tarfile
    28	import zlib
    29	from typing import Iterable, List, Optional, Tuple
    30	
    31	_APPLEDOUBLE_PREFIX = "._"
    32	_KEY_FILES = ("audit/audit-key", "audit/.salt")
    33	_CHUNK = 1 << 16
    34	
    35	
    36	def _normalized(name: str) -> str:
    37	    """Return an archive-relative name or raise for an alias/traversal."""
    38	    if name == ".":
    39	        return ""
    40	    if name.startswith("./"):
    41	        name = name[2:]
    42	    if not name or name.startswith("/") or "//" in name:
    43	        raise ValueError("unsafe path")
    44	    parts = name.split("/")
    45	    if any(part in ("", ".", "..") for part in parts):
    46	        raise ValueError("unsafe path")
    47	    return name.rstrip("/")
    48	
    49	
    50	def _allowed(name: str) -> bool:
    51	    if name in ("agent-metrics.md", "MANIFEST.txt"):
    52	        return True
    53	    return name in ("audit", "memory", "plans") or any(
    54	        name.startswith(prefix) for prefix in ("audit/", "memory/", "plans/")
    55	    )
    56	
    57	
    58	def _appledouble_companion(name: str) -> Optional[str]:
    59	    """Return the companion of an AppleDouble name, None for any other name.
    60	
    61	    Raises ValueError when the basename carries the prefix but cannot name a
    62	    companion (``._`` alone, ``._..``).
    63	    """
    64	    head, _, base = name.rpartition("/")
    65	    if not base.startswith(_APPLEDOUBLE_PREFIX):
    66	        return None
    67	    target = base[len(_APPLEDOUBLE_PREFIX):]
    68	    if target == ".":
    69	        return head
    70	    if target in ("", ".."):
    71	        raise ValueError("no companion")
    72	    return head + "/" + target if head else target
    73	
