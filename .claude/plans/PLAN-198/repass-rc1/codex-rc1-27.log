    75	def validate(members: Iterable[tarfile.TarInfo]) -> List[tarfile.TarInfo]:
    76	    """Reject every non-data member and every name outside the restore layout.
    77	
    78	    Returns the members to extract, in archive order.  AppleDouble members
    79	    that pass the companion rule are left out of the result.
    80	    """
    81	    accepted: List[tarfile.TarInfo] = []
    82	    accepted_names = set()
    83	    seen = set()
    84	    appledouble: List[Tuple[tarfile.TarInfo, str]] = []
    85	    for member in members:
    86	        try:
    87	            name = _normalized(member.name)
    88	        except ValueError:
    89	            raise ValueError("refused path: {0}".format(member.name))
    90	        if name in seen:
    91	            raise ValueError("refused duplicate path: {0}".format(member.name))
    92	        seen.add(name)
    93	        if member.issparse():
    94	            raise ValueError("refused sparse member: {0}".format(member.name))
    95	        try:
    96	            companion = _appledouble_companion(name) if name else None
    97	        except ValueError:
    98	            raise ValueError("refused AppleDouble name: {0}".format(member.name))
    99	        if companion is not None:
   100	            if not member.isfile():
   101	                raise ValueError("refused member type: {0}".format(member.name))
   102	            appledouble.append((member, companion))
   103	            continue
   104	        if not name:
   105	            if member.isdir():
   106	                accepted.append(member)
   107	                accepted_names.add(name)
   108	                continue
   109	            raise ValueError("refused member type: {0}".format(member.name))
   110	        if not _allowed(name):
   111	            raise ValueError("refused path: {0}".format(member.name))
   112	        if not (member.isfile() or member.isdir()):
   113	            raise ValueError("refused member type: {0}".format(member.name))
   114	        if name.casefold() in _KEY_FILES:
   115	            raise ValueError("refused path: {0}".format(member.name))
   116	        accepted.append(member)
   117	        accepted_names.add(name)
   118	    for member, companion in appledouble:
   119	        if companion not in accepted_names:
   120	            raise ValueError("refused path: {0}".format(member.name))
   121	    return accepted
