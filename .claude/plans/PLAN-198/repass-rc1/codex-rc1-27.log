   145	def discover(root: str) -> List[str]:
   146	    """Candidatos por propriedade de conteúdo (os.walk — vê dirs ocultos,
   147	    ao contrário de glob.glob; achado do debate r1)."""
   148	    found: List[str] = []
   149	    roots = [os.path.join(root, r) for r in DISCOVERY_ROOTS]
   150	    for base in roots:
   151	        if not os.path.isdir(base):
   152	            continue
   153	        for dirpath, _dirnames, filenames in os.walk(base):
   154	            for fn in filenames:
   155	                if not fn.endswith(".sh"):
   156	                    continue
   157	                p = os.path.join(dirpath, fn)
   158	                try:
   159	                    with open(p, errors="replace") as fh:
   160	                        body = fh.read()
   161	                except OSError:
   162	                    found.append(p)  # ilegível = candidato (fail-closed)
   163	                    continue
   164	                if SHEBANG_RE.match(body) and CEREMONY_OPS_RE.search(body):
   165	                    found.append(p)
   166	    for rel in EXPLICIT_FILES:
   167	        p = os.path.join(root, rel)
   168	        if os.path.isfile(p):
   169	            found.append(p)
   170	    return sorted(set(found))
