   165	    if hook_type not in _REQUIRED_FIELDS:
   166	        return f"type: unknown hook type {json.dumps(hook_type)[:80]}"
   167	    for field in _REQUIRED_FIELDS[hook_type]:
   168	        if not isinstance(hook.get(field), str):
   169	            return f"{field}: expected string"
   170	    return ""
