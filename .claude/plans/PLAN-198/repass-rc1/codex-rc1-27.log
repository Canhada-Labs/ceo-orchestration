   211	def _expands_command(line: str) -> bool:
   212	    """Crase ou `$(` que o shell executaria (paridade de contrabarras respeitada)."""
   213	    i = 0
   214	    while i < len(line):
   215	        if line[i] == "\\":
   216	            i += 2
   217	            continue
   218	        if line[i] == "`" or line.startswith("$(", i):
   219	            return True
   220	        i += 1
   221	    return False
