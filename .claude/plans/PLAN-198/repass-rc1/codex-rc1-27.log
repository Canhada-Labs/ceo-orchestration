   173	def _heredoc_openers(line: str) -> List[tuple]:
   174	    """``(delimitador, tira_tabs, expande)`` de cada heredoc aberto nesta linha de
   175	    código. Anda a linha com o estado de aspas: `<<` numa string, num comentário, numa
   176	    conta `$(( ))` ou num here-string `<<<` não abre heredoc."""
   177	    found: List[tuple] = []
   178	    quote = ""
   179	    i = 0
   180	    while i < len(line):
   181	        ch = line[i]
   182	        if quote:
   183	            if ch == "\\" and quote == '"':
   184	                i += 2
   185	                continue
   186	            if ch == quote:
   187	                quote = ""
   188	            i += 1
   189	        elif ch in "'\"":
   190	            quote = ch
   191	            i += 1
   192	        elif ch == "\\":
   193	            i += 2
   194	        elif ch == "#" and (i == 0 or line[i - 1] in " \t;|&("):
   195	            break
   196	        elif line.startswith("<<<", i):
   197	            i += 3
   198	        elif line.startswith("<<", i) and line.count("((", 0, i) <= line.count("))", 0, i):
   199	            m = HEREDOC_OPEN_RE.match(line, i)
   200	            if m is None:
   201	                i += 2
   202	                continue
   203	            word = m.group(2) or m.group(3) or m.group(5)
   204	            found.append((word, m.group(1) == "-", not (m.group(2) or m.group(3) or m.group(4))))
   205	            i = m.end()
   206	        else:
   207	            i += 1
   208	    return found
