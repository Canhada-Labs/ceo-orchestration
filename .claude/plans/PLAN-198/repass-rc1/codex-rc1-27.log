   224	def _heredoc_findings(lines: List[str]) -> List[dict]:
   225	    """R9, um achado por linha do corpo. Ponto cego declarado: string de várias linhas
   226	    com `<<` dentro desalinha o estado de aspas (resíduo vira waiver, como os demais)."""
   227	    findings: List[dict] = []
   228	    pending: List[tuple] = []
   229	    for i, ln in enumerate(lines, 1):
   230	        if pending:
   231	            word, strip_tabs, expands = pending[0]
   232	            if (ln.lstrip("\t") if strip_tabs else ln) == word:
   233	                pending.pop(0)
   234	            elif expands and _expands_command(ln):
   235	                findings.append({"rule": "R9", "sev": "BLOCKING", "line": i,
   236	                                 "msg": "crase ou $( executa dentro de heredoc sem aspas "
   237	                                        "(delimitador %s)" % word})
   238	            continue
   239	        pending.extend(_heredoc_openers(ln))
   240	    return findings
