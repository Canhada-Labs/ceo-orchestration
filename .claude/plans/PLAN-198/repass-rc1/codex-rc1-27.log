   341	        # fronteira fail-open — um BrokenPipeError/encoding error aqui não
   342	        # pode abortar o lint depois de um unlock válido.
   343	        print(f"ceremony-lint: UNLOCK usado sha={sha[:16]} motivo={reason!r}",
   344	              file=sys.stderr)
