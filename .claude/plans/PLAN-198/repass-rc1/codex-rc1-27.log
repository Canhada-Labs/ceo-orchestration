   121	def _sha256(path: str) -> str:
   122	    h = hashlib.sha256()
   123	    with open(path, "rb") as fh:
   124	        for chunk in iter(lambda: fh.read(65536), b""):
   125	            h.update(chunk)
   126	    return h.hexdigest()
