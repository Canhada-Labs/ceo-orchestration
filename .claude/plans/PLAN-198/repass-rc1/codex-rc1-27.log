   123	
   124	def complete_members(archive: tarfile.TarFile) -> List[tarfile.TarInfo]:
   125	    """Return every member, or raise unless the archive parsed to its end.
   126	
   127	    The member walk must stop on a full all-zero block (the end-of-archive
   128	    marker) and the rest of the compressed stream must decompress with a
   129	    valid checksum; otherwise members after the cut would vanish silently.
   130	    """
   131	    stream = archive.fileobj
   132	    try:
   133	        members = archive.getmembers()
   134	        stream.seek(archive.offset)
   135	        block = stream.read(tarfile.BLOCKSIZE)
   136	        while stream.read(_CHUNK):
   137	            pass
   138	    except (EOFError, OSError, tarfile.ReadError, zlib.error) as exc:
   139	        raise ValueError("refused truncated or corrupt archive: {0}".format(exc))
   140	    if len(block) != tarfile.BLOCKSIZE or block.count(b"\0") != tarfile.BLOCKSIZE:
   141	        raise ValueError("refused truncated or corrupt archive: no end-of-archive "
   142	                         "block at byte {0}".format(archive.offset))
   143	    return members
   144	
   145	
   146	def extract(archive: tarfile.TarFile, members: Iterable[tarfile.TarInfo],
   147	            stage: str) -> None:
   148	    """Write the given (already validated) members under ``stage``."""
   149	    nofollow = getattr(os, "O_NOFOLLOW", 0)
   150	    for member in members:
   151	        name = _normalized(member.name)
   152	        if not name:
   153	            continue
   154	        path = os.path.join(stage, *name.split("/"))
   155	        if member.isdir():
   156	            os.makedirs(path, exist_ok=True)
   157	            continue
   158	        parent = os.path.dirname(path)
   159	        if parent:
   160	            os.makedirs(parent, exist_ok=True)
   161	        source = archive.extractfile(member)
   162	        if source is None:
   163	            raise ValueError("refused member type: {0}".format(member.name))
   164	        # O_EXCL: a name that lands on a file already written (two members
   165	        # whose names differ only in letter case, on the default macOS disk,
   166	        # APFS) is refused, never merged into the earlier file with the
   167	        # earlier mode.
   168	        try:
   169	            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
   170	                         member.mode & 0o777)
   171	        except FileExistsError:
   172	            source.close()
   173	            raise ValueError("refused duplicate path: {0}".format(member.name))
   174	        with os.fdopen(fd, "wb") as target, source:
   175	            shutil.copyfileobj(source, target)
   176	        os.utime(path, (member.mtime, member.mtime))
   177	
   178	
   179	def main(argv: List[str]) -> int:
   180	    if len(argv) not in (2, 3):
   181	        print("usage: _restore_archive.py <tarball> [<stage-dir>]", file=sys.stderr)
   182	        return 2
   183	    stage = argv[2] if len(argv) == 3 else None
   184	    if stage is not None and (os.path.islink(stage) or not os.path.isdir(stage)):
   185	        print("fatal: stage must be a real directory", file=sys.stderr)
   186	        return 2
   187	    try:
   188	        with tarfile.open(argv[1], "r:gz") as archive:
   189	            members = validate(complete_members(archive))
   190	            if stage is not None:
   191	                extract(archive, members, stage)
   192	    except (EOFError, OSError, OverflowError, tarfile.TarError, ValueError,
   193	            zlib.error) as exc:
   194	        print("fatal: archive {0}".format(exc), file=sys.stderr)
   195	        return 2
   196	    return 0
   197	
   198	
