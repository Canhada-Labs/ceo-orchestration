   349	def main(argv: Optional[List[str]] = None) -> int:
   350	    ap = argparse.ArgumentParser(prog="check-ceremony-script")
   351	    ap.add_argument("--root", default=REPO_ROOT,
   352	                    help="raiz do repo (testes usam tmp dir)")
   353	    ap.add_argument("--waivers", default=None,
   354	                    help="path do JSON de waivers (default: ao lado do lint)")
   355	    ap.add_argument("--floor", type=int, default=None,
   356	                    help=f"piso do conjunto RASTREADO descoberto (default {DEFAULT_FLOOR})")
   357	    ap.add_argument("--json", action="store_true")
   358	    ap.add_argument("--list", action="store_true",
   359	                    help="só imprime os arquivos descobertos (um por linha)")
   360	    ap.add_argument("--print-waiver-template", action="store_true",
   361	                    help="emite entradas de waiver p/ os arquivos hoje em BLOCKING")
   362	    args = ap.parse_args(argv)
