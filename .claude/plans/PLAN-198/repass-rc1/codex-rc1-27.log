   129	def _git_tracked_modes(root: str) -> Dict[str, str]:
   130	    try:
   131	        out = subprocess.run(
   132	            ["git", "-C", root, "ls-files", "--stage"],
   133	            capture_output=True, text=True, timeout=30, check=False,
   134	        ).stdout
   135	    except Exception:
   136	        return {}
   137	    modes: Dict[str, str] = {}
   138	    for line in out.splitlines():
   139	        parts = line.split(None, 3)
   140	        if len(parts) == 4:
   141	            modes[parts[3]] = parts[0]
   142	    return modes
