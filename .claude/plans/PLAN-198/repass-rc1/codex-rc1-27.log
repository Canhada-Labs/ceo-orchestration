   172	
   173	def _hook_problem(hook_rel: str) -> str:
   174	    """'missing', 'not_exec' or ''. A stat that fails for any other reason than
   175	    absence raises: it is input this gate cannot consume (main() names it, exit 2)."""
   176	    full = REPO_ROOT / hook_rel
   177	    try:
   178	        mode = os.stat(full).st_mode
   179	    except (FileNotFoundError, NotADirectoryError):
   180	        return "missing"
   181	    if not stat.S_ISREG(mode):
   182	        return "missing"
   183	    return "" if os.access(full, os.X_OK) else "not_exec"
   184	
   185	
   186	def main() -> int:
   187	    seen: Set[Tuple[str, str]] = set()
   188	    missing: List[str] = []
   189	    not_exec: List[str] = []
   190	
   191	    for settings_path in SETTINGS_FILES:
   192	        for hook_rel in _iter_hook_paths(settings_path):
   193	            key = (settings_path.name, hook_rel)
   194	            if key in seen:
   195	                continue
   196	            seen.add(key)
   197	            try:
   198	                problem = _hook_problem(hook_rel)
   199	            except (OSError, ValueError) as exc:
   200	                print(f"::error::cannot stat hook file {hook_rel} ({settings_path.name}): "
   201	                      f"{type(exc).__name__}: {exc}", file=sys.stderr)
   202	                return 2
   203	            if problem == "missing":
   204	                missing.append(f"{settings_path.name}: {hook_rel}")
   205	            elif problem == "not_exec":
   206	                not_exec.append(f"{settings_path.name}: {hook_rel}")
   207	
   208	    if missing or not_exec:
   209	        if missing:
   210	            print("MISSING hook files:")
   211	            for m in missing:
   212	                print(f"  - {m}")
   213	        if not_exec:
   214	            print("NOT EXECUTABLE hook files:")
   215	            for n in not_exec:
   216	                print(f"  - {n}")
   217	        print()
   218	        print("Run: chmod +x <file>")
   219	        return 1
   220	
   221	    if not seen:
   222	        print("WARN: no hook references found in settings — possible parse drift", file=sys.stderr)
   223	
   224	    print(f"OK: {len(seen)} active hook reference(s) across "
   225	          f"{sum(1 for s in SETTINGS_FILES if s.is_file())} settings file(s) "
   226	          f"are present and executable")
   227	    return 0
   228	
   229	
   230	if __name__ == "__main__":
   231	    sys.exit(main())

