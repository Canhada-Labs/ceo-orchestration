   364	    root = os.path.abspath(args.root)
   365	    try:
   366	        files = discover(root)
   367	    except Exception as exc:  # infra do próprio lint
   368	        print(f"ceremony-lint: INFRA error na descoberta: {exc}", file=sys.stderr)
   369	        return 3
   370	
   371	    modes = _git_tracked_modes(root)
   372	    rels = {f: os.path.relpath(f, root) for f in files}
   373	    tracked = [f for f in files if rels[f] in modes]
   374	
   375	    if args.list:
   376	        for f in files:
   377	            print(rels[f])
   378	        return 0
   379	
   380	    waivers_path = args.waivers or (
   381	        DEFAULT_WAIVERS if root == REPO_ROOT
   382	        else os.path.join(root, ".claude", "scripts", "ceremony-lint-waivers.json")
   383	    )
   384	    waived_shas = set()
   385	    waiver_entries: List[dict] = []
   386	    if os.path.isfile(waivers_path):
   387	        try:
   388	            waiver_entries = json.load(open(waivers_path))
   389	            waived_shas = {w["sha256"] for w in waiver_entries
   390	                           if w.get("sha256") and w.get("reason") and w.get("date")}
   391	        except Exception as exc:
   392	            print(f"ceremony-lint: waivers ilegíveis ({exc}) — input fail-closed, "
   393	                  "nenhum waiver aplicado", file=sys.stderr)
   394	
   395	    unlock_sha = (os.environ.get("CEO_CEREMONY_LINT_UNLOCK") or "").strip().lower()
   396	    unlock_reason = (os.environ.get("CEO_CEREMONY_LINT_UNLOCK_REASON") or "").strip()
   397	
   398	    report: List[dict] = []
   399	    blocking_live = 0
   400	    advisory_counts: Dict[str, int] = {}
   401	    for f in files:
   402	        sha = _sha256(f)
   403	        findings = lint_file(f, rels[f], modes.get(rels[f]))
   404	        waived = sha in waived_shas
   405	        if not waived and unlock_sha and sha == unlock_sha:
   406	            if unlock_reason:
   407	                waived = True
   408	                _emit_unlock_audit(sha, unlock_reason)
   409	            else:
   410	                print("ceremony-lint: CEO_CEREMONY_LINT_UNLOCK sem "
   411	                      "CEO_CEREMONY_LINT_UNLOCK_REASON — bloqueio MANTIDO",
   412	                      file=sys.stderr)
   413	        is_tracked = rels[f] in modes
   414	        n_block = sum(1 for x in findings if x["sev"] == "BLOCKING")
   415	        for x in findings:
   416	            if x["sev"] == "ADVISORY":
   417	                advisory_counts[x["rule"]] = advisory_counts.get(x["rule"], 0) + 1
   418	        # O gate conta SÓ arquivos rastreados: o CI clona o repo e nunca
   419	        # vê untracked/gitignored (ponto cego DECLARADO no catálogo —
   420	        # reportado no relatório, nunca fingido como coberto).
   421	        if n_block and not waived and is_tracked:
   422	            blocking_live += n_block
   423	        report.append({"file": rels[f], "sha256": sha, "tracked": rels[f] in modes,
   424	                       "waived": waived, "findings": findings})
   425	
   426	    floor = args.floor if args.floor is not None else DEFAULT_FLOOR
   427	    floor_ok = len(tracked) >= floor
   428	
   429	    if args.print_waiver_template:
   430	        tmpl = [{"sha256": r["sha256"], "path_hint": r["file"],
   431	                 "reason": "PREENCHER", "date": "PREENCHER"}
   432	                for r in report
   433	                if any(x["sev"] == "BLOCKING" for x in r["findings"])
   434	                and not r["waived"]]
   435	        print(json.dumps(tmpl, indent=1, ensure_ascii=False))
   436	        return 0
   437	
   438	    result = {
   439	        "discovered_total": len(files),
   440	        "discovered_tracked": len(tracked),
   441	        "floor": floor,
   442	        "floor_ok": floor_ok,
   443	        "blocking_unwaived": blocking_live,
   444	        "advisory_rates": advisory_counts,
   445	        "waivers_active": len(waived_shas),
   446	        "self_limitation": SELF_LIMITATION,
   447	        "files": report,
   448	    }
   449	    if args.json:
   450	        print(json.dumps(result, indent=1, ensure_ascii=False))
   451	    else:
   452	        print(f"ceremony-lint: {len(files)} descobertos "
