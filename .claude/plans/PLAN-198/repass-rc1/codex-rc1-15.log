-
-_GROK_TURN_ENDED_SOURCE_ENUM = frozenset({
-    "stop", "subagent_stop", "other",
-})
-
-_GROK_TURN_ENDED_ALLOWLIST = _CODEX_AUDIT_ENVELOPE | frozenset({
