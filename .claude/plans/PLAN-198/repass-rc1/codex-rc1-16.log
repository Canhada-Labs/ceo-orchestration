-def is_audit_stream_verbose() -> bool:
-    """ADR-123 §4 — EXACT MATCH ``CEO_AUDIT_STREAM_VERBOSE=1`` only."""
-    return os.environ.get(_VERBOSE_STREAM_ENV) == _VERBOSE_STREAM_ARMED_VALUE
