{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CfDKQskimwiPJabY1oLfuK","type":"tool_result","content":"90\t\n91\t    def test_check_canonical_edit_fail_open(self):\n92\t        \"\"\"check_canonical_edit: fail-OPEN on infra, fail-CLOSED on INPUT.\n93\t\n94\t        NARROWED by the PLAN-162 W2 patch (finding #5b). This test used to\n95\t        assert a blanket \"never block on any malformed stdin\", which\n96\t        predates the PLAN-152 C4 doctrine correction now codified in\n97\t        CLAUDE.md §4: hooks fail OPEN on INFRASTRUCTURE (missing file,\n98\t        import failure, timeout) but a security matcher fails CLOSED on\n99\t        INPUT it cannot parse. The blanket rule made this file a contract\n100\t        pin on the very posture #5b reverses, so it is narrowed in the\n101\t        SAME patch (the C7 precedent) — for THIS hook only. The other\n102\t        five hooks keep the unmodified assertion above/below.\n103\t\n104\t        What is unchanged and still asserted for every payload: exit 0,\n105\t        never a crash, never a zero-emit on a governance event.\n106\t\n107\t        The split, measured rather than assumed:\n108\t          * a payload the adapter cannot parse at all (``garbage``) sets\n109\t            ``event.parse_error`` -> BLOCK with the #5b reason code;\n110\t          * payloads that PARSE but carry no usable target (``empty``,\n111\t            ``json_missing_fields``, ``null_tool_input``) are not INPUT\n112\t            failures -> still allow.\n113\t        An EXCEPTION out of ``read_event`` remains fail-OPEN and is pinned\n114\t        separately by ``Finding5FailurePostureTest.test_5a_pin_read_event_\n115\t        exception_still_allows``.\n116\t        \"\"\"\n117\t        parse_error_labels = {\"garbage\"}\n118\t        for label, payload in MALFORMED_PAYLOADS:\n119\t            with self.subTest(payload=label):\n120\t                if label not in parse_error_labels:\n121\t                    self._assert_fail_open(\"check_canonical_edit\", label, payload)\n122\t                    continue\n123\t                exit_code, stdout = _run_hook(\"check_canonical_edit\", payload)\n124\t                self.assertEqual(exit_code, 0, f\"stdout={stdout!r}\")\n125\t                text = stdout.decode(\"utf-8\", errors=\"replace\").strip()\n126\t                self.assertTrue(text, \"zero-emit on a governance event\")\n127\t                parsed = json.loads(text)\n128\t                self.assertEqual(\n129\t                    parsed.get(\"decision\"), \"block\", f\"stdout={text!r}\"\n130\t                )\n131\t                self.assertIn(\n132\t                    \"canonical_edit_payload_parse_error\",\n133\t                    parsed.get(\"reason\", \"\"),\n134\t                    f\"stdout={text!r}\",\n135\t                )\n136\t\n137\t    def test_check_plan_edit_fail_open(self):\n138\t        for label, payload in MALFORMED_PAYLOADS:\n139\t            with self.subTest(payload=label):"}]},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"9df42af0-e9eb-4530-b1fc-d65db5f7a499","timestamp":"2026-11-15T10:56:35.201Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/tests/test_fail_open_contract.py","content":"\n    def test_check_canonical_edit_fail_open(self):\n        \"\"\"check_canonical_edit: fail-OPEN on infra, fail-CLOSED on INPUT.\n\n        NARROWED by the PLAN-162 W2 patch (finding #5b). This test used to\n        assert a blanket \"never block on any malformed stdin\", which\n        predates the PLAN-152 C4 doctrine correction now codified in\n        CLAUDE.md §4: hooks fail OPEN on INFRASTRUCTURE (missing file,\n        import failure, timeout) but a security matcher fails CLOSED on\n        INPUT it cannot parse. The blanket rule made this file a contract\n        pin on the very posture #5b reverses, so it is narrowed in the\n        SAME patch (the C7 precedent) — for THIS hook only. The other\n        five hooks keep the unmodified assertion above/below.\n\n        What is unchanged and still asserted for every payload: exit 0,\n        never a crash, never a zero-emit on a governance event.\n\n        The split, measured rather than assumed:\n          * a payload the adapter cannot parse at all (``garbage``) sets\n            ``event.parse_error`` -> BLOCK with the #5b reason code;\n          * payloads that PARSE but carry no usable target (``empty``,\n            ``json_missing_fields``, ``null_tool_input``) are not INPUT\n            failures -> still allow.\n        An EXCEPTION out of ``read_event`` remains fail-OPEN and is pinned\n        separately by ``Finding5FailurePostureTest.test_5a_pin_read_event_\n        exception_still_allows``.\n        \"\"\"\n        parse_error_labels = {\"garbage\"}\n        for label, payload in MALFORMED_PAYLOADS:\n            with self.subTest(payload=label):\n                if label not in parse_error_labels:\n                    self._assert_fail_open(\"check_canonical_edit\", label, payload)\n                    continue\n                exit_code, stdout = _run_hook(\"check_canonical_edit\", payload)\n                self.assertEqual(exit_code, 0, f\"stdout={stdout!r}\")\n                text = stdout.decode(\"utf-8\", errors=\"replace\").strip()\n                self.assertTrue(text, \"zero-emit on a governance event\")\n                parsed = json.loads(text)\n                self.assertEqual(\n                    parsed.get(\"decision\"), \"block\", f\"stdout={text!r}\"\n                )\n                self.assertIn(\n                    \"canonical_edit_payload_parse_error\",\n                    parsed.get(\"reason\", \"\"),\n                    f\"stdout={text!r}\",\n                )\n\n    def test_check_plan_edit_fail_open(self):\n        for label, payload in MALFORMED_PAYLOADS:\n            with self.subTest(payload=label):","numLines":50,"startLine":90,"totalLines":160}},"tool_result_meta":[{"id":"toolu_01CfDKQskimwiPJabY1oLfuK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
