{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4awHcZ84CzKjTHBXKF7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SZVATJkc71imKEfLVVJcKh","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/decisions.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14246,"cache_read_input_tokens":105659,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14246},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"bcf2af7b-c34b-4466-be8f-732566d2407a","timestamp":"2026-11-15T10:51:13.728Z","request_id":"req_011Ch4awHEyaRRNotXpejyHa","wire_tool_inputs":{"toolu_01SZVATJkc71imKEfLVVJcKh":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/decisions.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SZVATJkc71imKEfLVVJcKh","type":"tool_result","content":"1\t\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _emit_unlock_audit(target_rel: str, unlock_reason: str) -> None:\n5\t    \"\"\"Best-effort audit emission for sentinel env-override grants.\n6\t\n7\t    Session 75 Codex Finding 8 closure (extracted helper for PLAN-064\n8\t    Option D Tier-1/Tier-2 DRY): docstring promised\n9\t    `veto_triggered(reason_code=sentinel_unlock_used)` event when the\n10\t    env-var override path grants a canonical edit. Emission failures\n11\t    never block (advisory).\n12\t    \"\"\"\n13\t    try:\n14\t        from _lib import audit_emit as _audit_emit_unlock\n15\t        _audit_emit_unlock.emit_veto_triggered(\n16\t            hook=\"check_canonical_edit\",\n17\t            reason_code=\"sentinel_unlock_used\",\n18\t            reason_preview=(\n19\t                f\"sentinel env-override granted edit to {target_rel}; \"\n20\t                f\"reason={unlock_reason!r}\"\n21\t            ),\n22\t            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n23\t            caller=os.environ.get(\"CLAUDE_AGENT_NAME\", \"ceo\"),\n24\t            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n25\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n26\t        )\n27\t    except Exception:\n28\t        pass  # advisory; emission failure never blocks\n29\t\n30\t\n31\tdef decide(\n32\t    *,\n33\t    file_path: str,\n34\t    repo_root: Path,\n35\t) -> str:\n36\t    \"\"\"Pure decision function.\n37\t\n38\t    Returns the JSON payload to write to stdout.\n39\t    \"\"\"\n40\t    # PLAN162_FIX_S2R2 — per-decision state, so an in-process caller\n41\t    # (``check_pair_rail``, the tests) never inherits a previous event's\n42\t    # unlock diagnosis.\n43\t    _reset_unlock_trust_diag()\n44\t\n45\t    if not file_path:\n46\t        return _emit_allow()\n47\t\n48\t    if not _is_canonical(file_path, repo_root):\n49\t        return _emit_allow()\n50\t\n51\t    # Confirmed canonical. Re-derive the repo-relative form for sentinel\n52\t    # matching via the SAME dual-anchor resolution as _is_canonical\n53\t    # (PLAN160_FIX_D), so the path is paired with the rel that classified\n54\t    # it (a repo_root-anchored canonical path would otherwise fault the\n55\t    # historical CWD-anchored resolve and route a clean sentinel-block\n56\t    # through the finding-C fault branch).\n57\t    rel = _canonical_rel(file_path, repo_root)\n58\t    if rel is None:\n59\t        # PLAN160_FIX_C (finding C): fail-CLOSED. ``_is_canonical`` (guard\n60\t        # above) returned True, yet no anchoring yields a canonical rel\n61\t        # HERE — only a same-process TOCTOU between those two resolves can\n62\t        # reach this. The historical code fail-OPENED via\n63\t        # ``return _emit_allow()`` on the resolve fault; a confirmed-canonical\n64\t        # path MUST block (PLAN-045 F-01-07). Dead in same-process terms;\n65\t        # defense-in-depth.\n66\t        return _emit_block(\n67\t            reason=(\n68\t                \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — a \"\n69\t                \"confirmed-canonical path could not be resolved repo-relative \"\n70\t                \"for sentinel matching (same-process TOCTOU). PLAN-045 \"\n71\t                \"F-01-07 / PLAN-160 finding C fail-closed.\"\n72\t            )\n73\t        )\n74\t\n75\t    sentinels = _find_sentinels(repo_root)\n76\t    for sentinel in sentinels:\n77\t        # PLAN162_FIX_1 (C2) — wall-clock deadline, checked at the TOP of\n78\t        # the sentinel loop and fail-CLOSED. Never \"allow because we ran\n79\t        # out of time\", and never \"stop checking sentinels\" (a cap would\n80\t        # drop the highest-numbered pack, i.e. the ceremony the Owner just\n81\t        # signed — self-DoS with the signature in hand).\n82\t        if _wall_budget_expired():\n83\t            return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n84\t        if _sentinel_grants_path(sentinel, rel):\n85\t            # PLAN-106 Wave C — persona coverage emit at canonical-edit\n86\t            # sentinel-approved allow path.\n87\t            _emit_persona_coverage_synthesized(rel_path=rel)\n88\t            return _emit_allow(\n89\t                system_message=(\n90\t                    f\"CANONICAL-EDIT: allowed via sentinel \"\n91\t                    f\"{sentinel.relative_to(repo_root)}\"\n92\t                )\n93\t            )\n94\t\n95\t    # PLAN162_FIX_1 (Codex P1 fold) — the budget can run out DURING the\n96\t    # last sentinel's verification, after the final top-of-loop poll. Both\n97\t    # outcomes block, but only this one names the cause and carries the\n98\t    # recovery route; the generic block below would tell the Owner to\n99\t    # declare a path that IS already declared.\n100\t    if _wall_budget_expired():\n101\t        return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n102\t\n103\t    return _emit_block(\n104\t        reason=(\n105\t            f\"CANONICAL-EDIT-BLOCKED: '{rel}' is a canonical governance \"\n106\t            \"path. Edits require an Owner-signed sentinel at \"\n107\t            \".claude/plans/PLAN-NNN/architect/round-N/approved.md with \"\n108\t            f\"this path declared in the Scope: block. See ADR-010.\"\n109\t            # PLAN162_FIX_S2R2 (P1-3): when an unlock window IS armed and\n110\t            # the trust rail is what refused, say so and name the value.\n111\t            + _unlock_trust_hint()\n112\t        )\n113\t    )\n114\t\n115\t\n116\tdef _candidate_is_granted(path_str: str, repo_root: Path, sentinels) -> bool:\n117\t    \"\"\"PLAN160_FIX_A helper — pure grant predicate for one candidate.\n118\t\n119\t    True iff the (assumed-canonical) ``path_str`` resolves repo-relative\n120\t    AND some sentinel in ``sentinels`` grants that repo-relative path. A\n121\t    resolve fault on a canonical path is NOT a grant → returns False, so\n122\t    the caller treats the candidate as the offender and blocks\n123\t    (fail-CLOSED, mirroring finding C's decide() contract).\n124\t\n125\t    Pure: NO side effects (does not emit persona coverage or audit) — those\n126\t    stay once-per-event concerns owned by ``decide()``. Uses the SAME\n127\t    ``_canonical_rel`` anchoring as ``_is_canonical`` and ``decide()``\n128\t    (PLAN160_FIX_D), so grant is checked against the exact rel that\n129\t    classified the candidate canonical; a candidate with no canonical rel\n130\t    is conservatively treated as ungranted (→ offender → block).\n131\t    \"\"\"\n132\t    rel = _canonical_rel(path_str, repo_root)\n133\t    if rel is None:\n134\t        return False\n135\t    for sentinel in sentinels:\n136\t        if _sentinel_grants_path(sentinel, rel):\n137\t            return True\n138\t    return False\n139\t\n140\t\n141\tdef _safe_sentinel_count(repo_root: Path) -> int:\n142\t    \"\"\"Best-effort sentinel count for the veto-audit breadcrumb.\n143\t\n144\t    PLAN160_FIX_A (codex pair-rail HIGH#2): the audit breadcrumb must never\n145\t    let a ``_find_sentinels`` fault (a malformed sentinel dir, an OSError\n146\t    walking the tree) propagate out of ``main()`` and produce a ZERO-emit\n147\t    hook on a governance event. Returns 0 on any fault — the count is\n148\t    forensic only; the block/allow decision is already made.\n149\t    \"\"\"\n150\t    try:\n151\t        return len(_find_sentinels(repo_root))\n152\t    except Exception:\n153\t        return 0\n154\t\n155\t\n156\tdef _block_reason_code(reason: str) -> str:\n157\t    \"\"\"Which ``reason_code`` the CHAIN gets for a block decision.\n158\t\n159\t    PLAN162_FIX_1B (r8 P2). ``_emit_block`` already names the class in the\n160\t    DECISION text, but the audit breadcrumb hard-coded\n161\t    ``canonical_edit_unsigned`` for every block — so the wall-deadline\n162\t    fail-CLOSED (and the pre-existing over-cap / scan-fault blocks) landed\n163\t    in the HMAC chain labelled as an unsigned edit: indistinguishable from\n164\t    a legitimate missing-sentinel block, and therefore UNCOUNTABLE for the\n165\t    ADR-110-AMEND-2 §3 censorship RATE. ``wave-readonly-monitor.py``\n166\t    already lists ``canonical_edit_hook_fault`` in\n167\t    ``_LAYER_3A_REASON_CODES``: a consumer with zero producers.\n168\t\n169\t    Closed 2-value derivation, read off the decision this hook itself\n170\t    built — never off attacker-shaped input.\n171\t    \"\"\"\n172\t    return (\n173\t        \"canonical_edit_hook_fault\"\n174\t        if \"canonical_edit_hook_fault\" in (reason or \"\")\n175\t        else \"canonical_edit_unsigned\"\n176\t    )\n177\t\n178\t\n179\tdef _audit_block(\n180\t    rel: str,\n181\t    sentinels_count: int,\n182\t    reason_code: str = \"canonical_edit_unsigned\",\n183\t) -> None:\n184\t    \"\"\"Best-effort emit of veto_triggered event. Never raises.\n185\t\n186\t    ``reason_code`` defaults to the historical value, so every existing\n187\t    caller is byte-identical. NO new ACTION is invented — ``veto_triggered``\n188\t    stays the registered action, same precedent as\n189\t    ``_audit_registry_unreadable``'s ``session_roots_registry_unreadable``.\n190\t    \"\"\"\n191\t    try:\n192\t        from _lib import audit_emit\n193\t        if reason_code == \"canonical_edit_unsigned\":\n194\t            _preview = (\n195\t                f\"blocked edit to {rel}; {sentinels_count} sentinel(s) checked, \"\n196\t                \"none grant this path\"\n197\t            )\n198\t        else:\n199\t            _preview = (\n200\t                f\"blocked edit to {rel}; fail-CLOSED before the sentinel sweep \"\n201\t                f\"could complete ({sentinels_count} sentinel(s) on disk)\"\n202\t            )\n203\t        audit_emit.emit_veto_triggered(\n204\t            hook=\"check_canonical_edit\",\n205\t            reason_code=reason_code,\n206\t            reason_preview=_preview,\n207\t            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n208\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n209\t        )\n210\t    except Exception:\n211\t        return\n212\t\n213\t__all__ = ['_emit_unlock_audit', 'decide', '_candidate_is_granted', '_safe_sentinel_count', '_block_reason_code', '_audit_block']\n214\t"}]},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"9a69f180-f47d-48f1-a8aa-87a1a4321d9d","timestamp":"2026-11-15T10:51:13.745Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/decisions.py","content":"\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\nfrom __future__ import annotations\n\ndef _emit_unlock_audit(target_rel: str, unlock_reason: str) -> None:\n    \"\"\"Best-effort audit emission for sentinel env-override grants.\n\n    Session 75 Codex Finding 8 closure (extracted helper for PLAN-064\n    Option D Tier-1/Tier-2 DRY): docstring promised\n    `veto_triggered(reason_code=sentinel_unlock_used)` event when the\n    env-var override path grants a canonical edit. Emission failures\n    never block (advisory).\n    \"\"\"\n    try:\n        from _lib import audit_emit as _audit_emit_unlock\n        _audit_emit_unlock.emit_veto_triggered(\n            hook=\"check_canonical_edit\",\n            reason_code=\"sentinel_unlock_used\",\n            reason_preview=(\n                f\"sentinel env-override granted edit to {target_rel}; \"\n                f\"reason={unlock_reason!r}\"\n            ),\n            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n            caller=os.environ.get(\"CLAUDE_AGENT_NAME\", \"ceo\"),\n            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:\n        pass  # advisory; emission failure never blocks\n\n\ndef decide(\n    *,\n    file_path: str,\n    repo_root: Path,\n) -> str:\n    \"\"\"Pure decision function.\n\n    Returns the JSON payload to write to stdout.\n    \"\"\"\n    # PLAN162_FIX_S2R2 — per-decision state, so an in-process caller\n    # (``check_pair_rail``, the tests) never inherits a previous event's\n    # unlock diagnosis.\n    _reset_unlock_trust_diag()\n\n    if not file_path:\n        return _emit_allow()\n\n    if not _is_canonical(file_path, repo_root):\n        return _emit_allow()\n\n    # Confirmed canonical. Re-derive the repo-relative form for sentinel\n    # matching via the SAME dual-anchor resolution as _is_canonical\n    # (PLAN160_FIX_D), so the path is paired with the rel that classified\n    # it (a repo_root-anchored canonical path would otherwise fault the\n    # historical CWD-anchored resolve and route a clean sentinel-block\n    # through the finding-C fault branch).\n    rel = _canonical_rel(file_path, repo_root)\n    if rel is None:\n        # PLAN160_FIX_C (finding C): fail-CLOSED. ``_is_canonical`` (guard\n        # above) returned True, yet no anchoring yields a canonical rel\n        # HERE — only a same-process TOCTOU between those two resolves can\n        # reach this. The historical code fail-OPENED via\n        # ``return _emit_allow()`` on the resolve fault; a confirmed-canonical\n        # path MUST block (PLAN-045 F-01-07). Dead in same-process terms;\n        # defense-in-depth.\n        return _emit_block(\n            reason=(\n                \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — a \"\n                \"confirmed-canonical path could not be resolved repo-relative \"\n                \"for sentinel matching (same-process TOCTOU). PLAN-045 \"\n                \"F-01-07 / PLAN-160 finding C fail-closed.\"\n            )\n        )\n\n    sentinels = _find_sentinels(repo_root)\n    for sentinel in sentinels:\n        # PLAN162_FIX_1 (C2) — wall-clock deadline, checked at the TOP of\n        # the sentinel loop and fail-CLOSED. Never \"allow because we ran\n        # out of time\", and never \"stop checking sentinels\" (a cap would\n        # drop the highest-numbered pack, i.e. the ceremony the Owner just\n        # signed — self-DoS with the signature in hand).\n        if _wall_budget_expired():\n            return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n        if _sentinel_grants_path(sentinel, rel):\n            # PLAN-106 Wave C — persona coverage emit at canonical-edit\n            # sentinel-approved allow path.\n            _emit_persona_coverage_synthesized(rel_path=rel)\n            return _emit_allow(\n                system_message=(\n                    f\"CANONICAL-EDIT: allowed via sentinel \"\n                    f\"{sentinel.relative_to(repo_root)}\"\n                )\n            )\n\n    # PLAN162_FIX_1 (Codex P1 fold) — the budget can run out DURING the\n    # last sentinel's verification, after the final top-of-loop poll. Both\n    # outcomes block, but only this one names the cause and carries the\n    # recovery route; the generic block below would tell the Owner to\n    # declare a path that IS already declared.\n    if _wall_budget_expired():\n        return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n\n    return _emit_block(\n        reason=(\n            f\"CANONICAL-EDIT-BLOCKED: '{rel}' is a canonical governance \"\n            \"path. Edits require an Owner-signed sentinel at \"\n            \".claude/plans/PLAN-NNN/architect/round-N/approved.md with \"\n            f\"this path declared in the Scope: block. See ADR-010.\"\n            # PLAN162_FIX_S2R2 (P1-3): when an unlock window IS armed and\n            # the trust rail is what refused, say so and name the value.\n            + _unlock_trust_hint()\n        )\n    )\n\n\ndef _candidate_is_granted(path_str: str, repo_root: Path, sentinels) -> bool:\n    \"\"\"PLAN160_FIX_A helper — pure grant predicate for one candidate.\n\n    True iff the (assumed-canonical) ``path_str`` resolves repo-relative\n    AND some sentinel in ``sentinels`` grants that repo-relative path. A\n    resolve fault on a canonical path is NOT a grant → returns False, so\n    the caller treats the candidate as the offender and blocks\n    (fail-CLOSED, mirroring finding C's decide() contract).\n\n    Pure: NO side effects (does not emit persona coverage or audit) — those\n    stay once-per-event concerns owned by ``decide()``. Uses the SAME\n    ``_canonical_rel`` anchoring as ``_is_canonical`` and ``decide()``\n    (PLAN160_FIX_D), so grant is checked against the exact rel that\n    classified the candidate canonical; a candidate with no canonical rel\n    is conservatively treated as ungranted (→ offender → block).\n    \"\"\"\n    rel = _canonical_rel(path_str, repo_root)\n    if rel is None:\n        return False\n    for sentinel in sentinels:\n        if _sentinel_grants_path(sentinel, rel):\n            return True\n    return False\n\n\ndef _safe_sentinel_count(repo_root: Path) -> int:\n    \"\"\"Best-effort sentinel count for the veto-audit breadcrumb.\n\n    PLAN160_FIX_A (codex pair-rail HIGH#2): the audit breadcrumb must never\n    let a ``_find_sentinels`` fault (a malformed sentinel dir, an OSError\n    walking the tree) propagate out of ``main()`` and produce a ZERO-emit\n    hook on a governance event. Returns 0 on any fault — the count is\n    forensic only; the block/allow decision is already made.\n    \"\"\"\n    try:\n        return len(_find_sentinels(repo_root))\n    except Exception:\n        return 0\n\n\ndef _block_reason_code(reason: str) -> str:\n    \"\"\"Which ``reason_code`` the CHAIN gets for a block decision.\n\n    PLAN162_FIX_1B (r8 P2). ``_emit_block`` already names the class in the\n    DECISION text, but the audit breadcrumb hard-coded\n    ``canonical_edit_unsigned`` for every block — so the wall-deadline\n    fail-CLOSED (and the pre-existing over-cap / scan-fault blocks) landed\n    in the HMAC chain labelled as an unsigned edit: indistinguishable from\n    a legitimate missing-sentinel block, and therefore UNCOUNTABLE for the\n    ADR-110-AMEND-2 §3 censorship RATE. ``wave-readonly-monitor.py``\n    already lists ``canonical_edit_hook_fault`` in\n    ``_LAYER_3A_REASON_CODES``: a consumer with zero producers.\n\n    Closed 2-value derivation, read off the decision this hook itself\n    built — never off attacker-shaped input.\n    \"\"\"\n    return (\n        \"canonical_edit_hook_fault\"\n        if \"canonical_edit_hook_fault\" in (reason or \"\")\n        else \"canonical_edit_unsigned\"\n    )\n\n\ndef _audit_block(\n    rel: str,\n    sentinels_count: int,\n    reason_code: str = \"canonical_edit_unsigned\",\n) -> None:\n    \"\"\"Best-effort emit of veto_triggered event. Never raises.\n\n    ``reason_code`` defaults to the historical value, so every existing\n    caller is byte-identical. NO new ACTION is invented — ``veto_triggered``\n    stays the registered action, same precedent as\n    ``_audit_registry_unreadable``'s ``session_roots_registry_unreadable``.\n    \"\"\"\n    try:\n        from _lib import audit_emit\n        if reason_code == \"canonical_edit_unsigned\":\n            _preview = (\n                f\"blocked edit to {rel}; {sentinels_count} sentinel(s) checked, \"\n                \"none grant this path\"\n            )\n        else:\n            _preview = (\n                f\"blocked edit to {rel}; fail-CLOSED before the sentinel sweep \"\n                f\"could complete ({sentinels_count} sentinel(s) on disk)\"\n            )\n        audit_emit.emit_veto_triggered(\n            hook=\"check_canonical_edit\",\n            reason_code=reason_code,\n            reason_preview=_preview,\n            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n        )\n    except Exception:\n        return\n\n__all__ = ['_emit_unlock_audit', 'decide', '_candidate_is_granted', '_safe_sentinel_count', '_block_reason_code', '_audit_block']\n","numLines":214,"startLine":1,"totalLines":214}},"tool_result_meta":[{"id":"toolu_01SZVATJkc71imKEfLVVJcKh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4awHcZ84CzKjTHBXKF7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01F6c9e2vjgGwN4QVUqmKG9e","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/session_roots.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14246,"cache_read_input_tokens":105659,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14246},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"fc263cd0-e4a2-4b0f-8ac0-6e6799da7206","timestamp":"2026-11-15T10:51:15.270Z","request_id":"req_011Ch4awHEyaRRNotXpejyHa","wire_tool_inputs":{"toolu_01F6c9e2vjgGwN4QVUqmKG9e":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/session_roots.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F6c9e2vjgGwN4QVUqmKG9e","type":"tool_result","content":"1\t\"\"\"Session workspace registry and external write protection.\n2\t\n3\tFunctions are bound to the owning hook namespace by ``bind``. This keeps\n4\tits injectable dependencies and per-import state on the public hook.\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_session_roots_registry_path', '_session_roots_partition_external', '_session_roots_guard', '_audit_registry_unreadable', '_audit_session_root_block')\n9\t\n10\t\n11\tdef _session_roots_registry_path(repo_root: Path) -> Path:\n12\t    \"\"\"Location of the session-roots registry written by the B1 observer.\"\"\"\n13\t    return repo_root / \".claude\" / \"state\" / \"session-roots.json\"\n14\t\n15\t\n16\t\n17\tdef _session_roots_partition_external(\n18\t    candidate_paths: List[str],\n19\t    repo_root: Path,\n20\t) -> Tuple[Optional[str], List[Tuple[str, str]]]:\n21\t    \"\"\"Partition event write-targets into repo-internal vs external.\n22\t\n23\t    Shared canonicalization core for ``_session_roots_guard``: used by BOTH\n24\t    the active-guard path (registry parsed, roots registered for this\n25\t    session) AND the corrupt-registry fail-CLOSED branch (FXγ / C3), so the\n26\t    two call sites agree byte-for-byte on what counts as an EXTERNAL write.\n27\t    A single source of truth here is a cross-state safeguard: it stops the\n28\t    corrupt-branch and the active-path external-detection from drifting apart\n29\t    and disagreeing on the same tool-input.\n30\t\n31\t    Returns ``(uncanon_reason, external)``:\n32\t      * ``uncanon_reason`` is a fail-CLOSED block-reason string when ANY\n33\t        candidate cannot be canonicalized (not a str, empty, embedded NUL,\n34\t        or ``os.path.realpath`` raised). A path that cannot be proven\n35\t        repo-internal must not be waved through while a session-roots\n36\t        security condition is in force. ``external`` is ``[]`` in that case.\n37\t      * otherwise ``uncanon_reason`` is ``None`` and ``external`` lists the\n38\t        ``(original, realpath)`` pairs that resolve OUTSIDE ``repo_root``\n39\t        (repo-internal candidates are governed by the canonical stack above\n40\t        and are dropped here). If ``repo_root`` itself cannot be\n41\t        canonicalized, NO candidate can be proven internal → every candidate\n42\t        is treated as external (fail-CLOSED on an unknowable boundary).\n43\t\n44\t    Pure: no emission, no raises out (realpath failures are caught and\n45\t    converted to the fail-CLOSED ``uncanon_reason`` return VALUE).\n46\t    \"\"\"\n47\t    try:\n48\t        repo_rp = os.path.realpath(str(repo_root))  # type: Optional[str]\n49\t    except Exception:\n50\t        repo_rp = None\n51\t\n52\t    external = []  # type: List[Tuple[str, str]]\n53\t    for cand in candidate_paths:\n54\t        # NUL/empty/non-str rejection is EXPLICIT (mirrors the control-char\n55\t        # rejection in _parse_scope_paths_from_text): since bpo-33721\n56\t        # (Py 3.8) os.path.realpath swallows the embedded-NUL ValueError and\n57\t        # returns the tainted string un-resolved, so the except branch below\n58\t        # never sees it — yet a NUL-bearing path is exactly the \"cannot be\n59\t        # canonicalized\" input class this matcher fail-CLOSES.\n60\t        if not isinstance(cand, str) or not cand or \"\\x00\" in cand:\n61\t            return (_SESSION_ROOTS_UNCANON_EMPTY, [])\n62\t        try:\n63\t            rp = os.path.realpath(cand)\n64\t        except Exception:\n65\t            return (\n66\t                \"SESSION-ROOTS-WRITE-BLOCKED: session_root_path_uncanonicalizable \"\n67\t                f\"— write-target path {cand!r} cannot be canonicalized \"\n68\t                \"(os.path.realpath raised) while session-registered workspace \"\n69\t                \"roots are active. Security-matcher input → fail-closed \"\n70\t                \"(CLAUDE.md §4; PLAN-163 T3.1 / ADR-183).\",\n71\t                [],\n72\t            )\n73\t        if repo_rp is not None and (\n74\t            rp == repo_rp or rp.startswith(repo_rp + os.sep)\n75\t        ):\n76\t            continue  # repo-internal → governed by the canonical stack above\n77\t        external.append((cand, rp))\n78\t    return (None, external)\n79\t\n80\t\n81\t\n82\tdef _session_roots_guard(\n83\t    candidate_paths: List[str],\n84\t    repo_root: Path,\n85\t    session_id: str,\n86\t    env=None,\n87\t) -> Optional[str]:\n88\t    \"\"\"Pure deny predicate for writes under session-registered roots.\n89\t\n90\t    Returns a block-reason string (→ deny) or ``None`` (→ allow). The DENY\n91\t    path is PURE in the ``_candidate_is_granted`` sense: no emission side\n92\t    effects — the deny audit breadcrumb is a once-per-event concern owned\n93\t    by ``main()``. The ONE carve-out is the corrupt / unreadable /\n94\t    unknown-schema registry branch: a PRESENT-but-unparseable registry is a\n95\t    security-matcher INPUT-parse failure (FXγ / C3), so it fails CLOSED for\n96\t    external writes (deny) while allowing repo-internal writes, and it\n97\t    additionally fires a best-effort tamper audit event (H5 observability,\n98\t    see below) so a registry-rewrite attack is both blocked and visible.\n99\t    ``env`` defaults to ``os.environ`` (injectable for tests).\n100\t\n101\t    Deny returns are VALUES, never raises: an unexpected raise out of this\n102\t    function is a hook bug (INFRA) and the ``main()`` call site fail-OPENs\n103\t    it with a breadcrumb, per the CLAUDE.md §4 split.\n104\t    \"\"\"\n105\t    src_env = env if env is not None else os.environ\n106\t\n107\t    # ---- Load registry (absent OR infra-read-error → silent allow;\n108\t    # ---- present-but-unparseable → fail-CLOSED for external writes) ----\n109\t    registry_path = _session_roots_registry_path(repo_root)\n110\t    try:\n111\t        if not registry_path.is_file():\n112\t            return None\n113\t    except OSError:\n114\t        return None\n115\t    # C3 (codex/grok R4+R5): read raw BYTES in a SEPARATE try — an OSError here\n116\t    # (PermissionError, IsADirectory, transient IO) is an INFRASTRUCTURE read\n117\t    # failure, NOT tampering, so it fails OPEN (allow), same as an ABSENT file.\n118\t    # Folding it into the parse `except Exception` below turned an infra read\n119\t    # error into a fail-CLOSED external-write DENY — a self-DoS. Reading BYTES\n120\t    # (not text) keeps the utf-8 DECODE inside the fail-closed parse block:\n121\t    # non-utf-8 bytes raise UnicodeDecodeError (IS-A ValueError, NOT OSError),\n122\t    # which is PRESENT-but-unparseable security-matcher input and MUST\n123\t    # fail-CLOSED — an earlier `read_text(encoding=...)` let that escape to the\n124\t    # caller's infra catch-all and wrongly ALLOW a binary registry overwrite\n125\t    # (R5). Only an OSError (bytes not readable at all) is INFRA -> allow.\n126\t    try:\n127\t        raw_bytes = registry_path.read_bytes()\n128\t    except OSError:\n129\t        return None\n130\t    try:\n131\t        data = json.loads(raw_bytes.decode(\"utf-8\"))\n132\t        if not isinstance(data, dict):\n133\t            raise ValueError(\"registry root is not an object\")\n134\t        if data.get(\"schema\") != _SESSION_ROOTS_SCHEMA:\n135\t            raise ValueError(\"unknown registry schema\")\n136\t        sessions = data.get(\"sessions\")\n137\t        if not isinstance(sessions, dict):\n138\t            raise ValueError(\"registry 'sessions' is not an object\")\n139\t    except Exception as exc:  # registry PRESENT + readable but unparseable\n140\t        print(\n141\t            \"[check_canonical_edit] session-roots registry unreadable \"\n142\t            f\"({type(exc).__name__}); present-but-unparseable security-matcher \"\n143\t            \"input → fail-CLOSED for external writes; repo-internal writes stay \"\n144\t            f\"governed by the canonical stack. registry={registry_path}\",\n145\t            file=sys.stderr,\n146\t        )\n147\t        # FXγ (C3) — DOCTRINE CORRECTION. A registry that EXISTS but cannot be\n148\t        # parsed (corrupt JSON, unknown schema-version, malformed `sessions`)\n149\t        # is PRESENT-but-unparseable security-matcher input, NOT an\n150\t        # ABSENT-file INFRA condition, so per CLAUDE.md §4 it fails CLOSED —\n151\t        # content the guard cannot parse is blocked, never waved through. The\n152\t        # deny is SCOPED to writes we cannot prove repo-internal (the new\n153\t        # surface an added root could have opened); repo-internal writes stay\n154\t        # governed by the canonical stack above (unaffected). Registry ABSENT\n155\t        # (handled earlier) remains an allow — the observer may simply not\n156\t        # have run.\n157\t        #\n158\t        # H5 observability is preserved and now UNCONDITIONAL: whether or not\n159\t        # this event carries an external write, the corruption is recorded in\n160\t        # the HMAC audit chain so a registry-rewrite attack leaves a forensic\n161\t        # trace. Emitted BEFORE the partition so even the allow (repo-internal\n162\t        # only) branch records the tamper. Best-effort; never raises.\n163\t        _audit_registry_unreadable(registry_path, type(exc).__name__)\n164\t        uncanon_reason, external = _session_roots_partition_external(\n165\t            candidate_paths, repo_root\n166\t        )\n167\t        if uncanon_reason is not None or external:\n168\t            # At least one write-target cannot be proven repo-internal while\n169\t            # the registry — the very state that tells us whether a root was\n170\t            # added — is unparseable. The write boundary is unknowable →\n171\t            # deny fail-CLOSED until the registry is repaired.\n172\t            return (\n173\t                \"SESSION-ROOTS-WRITE-BLOCKED: session_roots_registry_unreadable \"\n174\t                \"— the session-roots registry \"\n175\t                \"(.claude/state/session-roots.json) is PRESENT but could not be \"\n176\t                \"parsed (corrupt JSON, unknown schema-version, or a malformed \"\n177\t                \"'sessions' object). A present-but-unparseable security-matcher \"\n178\t                \"input cannot prove this write stays inside the project root, \"\n179\t                \"so writes OUTSIDE the repo are denied fail-closed (CLAUDE.md \"\n180\t                \"§4) until the registry is repaired or removed. Repo-internal \"\n181\t                \"writes remain governed by the canonical stack; the corruption \"\n182\t                \"is recorded in the HMAC audit chain. PLAN-163 T3.1 / ADR-183; \"\n183\t                \"H5.\"\n184\t            )\n185\t        return None  # all writes provably repo-internal → canonical stack\n186\t\n187\t    sid = (session_id or \"\").strip()\n188\t    # M1 (PLAN-163 T3.1 / ADR-183) — an ABSENT/empty session_id while the\n189\t    # registry holds registered sessions is a security-matcher input the\n190\t    # guard cannot bind to a session, yet roots DO exist → the write\n191\t    # boundary is unknowable → fail-CLOSED (CLAUDE.md §4). Denying here\n192\t    # means clearing CLAUDE_SESSION_ID cannot silently neutralize the\n193\t    # guard. Only EXTERNAL writes are denied (repo-internal writes stay\n194\t    # governed by the canonical stack above); the deny is emitted below,\n195\t    # after the fail-CLOSED input resolution, once ``external`` is known.\n196\t    sid_missing_with_registry = (not sid) and bool(sessions)\n197\t    if sid_missing_with_registry:\n198\t        roots = []  # boundary unknowable; external writes denied below\n199\t    else:\n200\t        sess = sessions.get(sid)\n201\t        if not isinstance(sess, dict):\n202\t            return None  # no roots registered for THIS session\n203\t        roots = sess.get(\"roots\")\n204\t        if not isinstance(roots, list) or not roots:\n205\t            return None\n206\t\n207\t    # ---- Guard is ACTIVE for this session. Resolve inputs fail-CLOSED ----\n208\t    # Allowlist: CEO_SESSION_ROOTS_ALLOW, os.pathsep-separated directory\n209\t    # list, compared by realpath.\n210\t    allow_rps: Set[str] = set()\n211\t    for tok in (src_env.get(_SESSION_ROOTS_ALLOW_ENV) or \"\").split(os.pathsep):\n212\t        tok = tok.strip()\n213\t        if not tok:\n214\t            continue\n215\t        try:\n216\t            allow_rps.add(os.path.realpath(tok))\n217\t        except (OSError, ValueError):\n218\t            continue  # a broken allowlist token allows nothing\n219\t\n220\t    # Resolve inputs + partition repo-internal vs external through the SHARED\n221\t    # core (also used by the corrupt-registry FXγ branch above) so the two\n222\t    # sites cannot drift on what \"external\" means. Uncanonicalizable input →\n223\t    # fail-CLOSED; repo-internal candidates are governed by the canonical\n224\t    # stack above and are dropped.\n225\t    uncanon_reason, external = _session_roots_partition_external(\n226\t        candidate_paths, repo_root\n227\t    )\n228\t    if uncanon_reason is not None:\n229\t        return uncanon_reason\n230\t    if not external:\n231\t        return None\n232\t\n233\t    if sid_missing_with_registry:\n234\t        # M1 fail-CLOSED: session identity is absent but the registry is\n235\t        # non-empty and this event has external write targets → deny.\n236\t        return (\n237\t            \"SESSION-ROOTS-WRITE-BLOCKED: session_id_missing — this \"\n238\t            \"canonical-edit event carries no session_id (absent/empty) \"\n239\t            \"while the session-roots registry holds registered workspace \"\n240\t            \"roots, so the write cannot be bound to a session and the \"\n241\t            \"boundary is unknowable. Writes outside the project root are \"\n242\t            \"denied fail-closed so that clearing CLAUDE_SESSION_ID cannot \"\n243\t            \"neutralize the guard (CLAUDE.md §4; PLAN-163 T3.1 / ADR-183).\"\n244\t        )\n245\t\n246\t    for entry in roots:\n247\t        directory = entry.get(\"directory\") if isinstance(entry, dict) else None\n248\t        if (\n249\t            not isinstance(entry, dict)\n250\t            or entry.get(\"unparseable\")\n251\t            or not isinstance(directory, str)\n252\t            or not directory\n253\t            or \"\\x00\" in directory\n254\t            or not os.path.isabs(directory)\n255\t        ):\n256\t            # A root WAS registered for this session but its boundary is\n257\t            # unknowable (observer marked it unparseable, the entry is\n258\t            # structurally malformed, or — M2 — its `directory` is not an\n259\t            # ABSOLUTE path: a relative value would be silently resolved\n260\t            # against the process CWD by os.path.realpath below and\n261\t            # mis-scope the boundary, so it is rejected in the same\n262\t            # fail-CLOSED class as unparseable). Like a corrupt whole-registry\n263\t            # (present-but-unparseable → fail-CLOSED for external writes), here\n264\t            # we positively know the session's write\n265\t            # surface grew and cannot bound it → every non-repo write is\n266\t            # denied until the entry is repaired (fail-CLOSED in the\n267\t            # consumer, PLAN-163 T3.1).\n268\t            return (\n269\t                \"SESSION-ROOTS-WRITE-BLOCKED: session_root_unparseable — this \"\n270\t                \"session has a registered workspace root whose directory could \"\n271\t                \"not be parsed (entry marked unparseable or malformed in \"\n272\t                \".claude/state/session-roots.json), so the session's write \"\n273\t                \"boundary is unknowable. Writes outside the project root are \"\n274\t                \"denied fail-closed until the registry entry is repaired \"\n275\t                \"(PLAN-163 T3.1 / ADR-183).\"\n276\t            )\n277\t        try:\n278\t            root_rp = os.path.realpath(directory)\n279\t        except Exception:\n280\t            return (\n281\t                \"SESSION-ROOTS-WRITE-BLOCKED: session_root_unparseable — a \"\n282\t                \"registered workspace root for this session cannot be \"\n283\t                \"canonicalized (os.path.realpath raised); the session's write \"\n284\t                \"boundary is unknowable. Writes outside the project root are \"\n285\t                \"denied fail-closed (PLAN-163 T3.1 / ADR-183).\"\n286\t            )\n287\t        if root_rp in allow_rps:\n288\t            continue  # Owner explicitly allowlisted this root\n289\t        for cand, rp in external:\n290\t            if rp == root_rp or rp.startswith(root_rp + os.sep):\n291\t                return (\n292\t                    \"SESSION-ROOTS-WRITE-BLOCKED: session_root_write_denied — \"\n293\t                    f\"write target '{cand}' resolves to '{rp}', inside the \"\n294\t                    f\"session-registered workspace root '{root_rp}' \"\n295\t                    f\"(source={entry.get('source') or 'unknown'}). \"\n296\t                    \"DirectoryAdded (CC 2.1.220) is notification-only and \"\n297\t                    \"post-facto, so added roots are writable-by-default at \"\n298\t                    \"the permission layer; this framework denies such writes \"\n299\t                    \"by default. To allow, add the root's realpath to \"\n300\t                    f\"{_SESSION_ROOTS_ALLOW_ENV} (os.pathsep-separated) and \"\n301\t                    \"retry. PLAN-163 T3.1 / ADR-183.\"\n302\t                )\n303\t    return None\n304\t\n305\t\n306\t\n307\tdef _audit_registry_unreadable(registry_path: Path, exc_name: str) -> None:\n308\t    \"\"\"Best-effort tamper-observability emit for a corrupt / unreadable /\n309\t    unknown-schema session-roots registry (H5).\n310\t\n311\t    The guard fails CLOSED for external writes on this condition (FXγ / C3:\n312\t    a present-but-unparseable registry is a security-matcher INPUT-parse\n313\t    failure, not an ABSENT-file INFRA allow) while allowing repo-internal\n314\t    writes. This emit runs UNCONDITIONALLY — before the external/internal\n315\t    partition — so that even the repo-internal allow path records the\n316\t    corruption: an adversary corrupting or truncating the repo-internal,\n317\t    agent-writable ``.claude/state/session-roots.json`` is both BLOCKED (for\n318\t    the external write it opened) and OBSERVABLE in the HMAC-chained audit\n319\t    log. Reuses the already-registered ``veto_triggered`` action (NO new\n320\t    action invented — see ADR-183 §Residuals) with a distinct ``reason_code``.\n321\t    hasattr-guarded; never raises; no-value-echo — the breadcrumb carries the\n322\t    registry PATH and the exception CLASS name only, never registry bytes or\n323\t    tool-input content.\n324\t    \"\"\"\n325\t    try:\n326\t        from _lib import audit_emit\n327\t        if not hasattr(audit_emit, \"emit_veto_triggered\"):\n328\t            return\n329\t        audit_emit.emit_veto_triggered(\n330\t            hook=\"check_canonical_edit\",\n331\t            reason_code=\"session_roots_registry_unreadable\",\n332\t            reason_preview=(\n333\t                \"session-roots registry unreadable/corrupt/unknown-schema; \"\n334\t                \"fail-CLOSED for external writes (FXγ) + tamper recorded; \"\n335\t                f\"exc={exc_name}; registry={registry_path}\"\n336\t            ),\n337\t            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n338\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n339\t        )\n340\t    except Exception:\n341\t        return\n342\t\n343\t\n344\t\n345\tdef _audit_session_root_block(target: str) -> None:\n346\t    \"\"\"Best-effort veto_triggered emit for a session-roots deny.\n347\t\n348\t    Mirrors ``_audit_block``: never raises; no-value-echo (the breadcrumb\n349\t    carries the target PATH only, never tool-input content).\n350\t    \"\"\"\n351\t    try:\n352\t        from _lib import audit_emit\n353\t        audit_emit.emit_veto_triggered(\n354\t            hook=\"check_canonical_edit\",\n355\t            reason_code=\"session_root_write_denied\",\n356\t            reason_preview=(\n357\t                f\"blocked write under session-registered root; target={target}\"\n358\t            ),\n359\t            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n360\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n361\t        )\n362\t    except Exception:\n363\t        return\n364\t"}]},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"0f519755-f2b9-4e44-a77a-d0ce6aee0bfc","timestamp":"2026-11-15T10:51:15.291Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/session_roots.py","content":"\"\"\"Session workspace registry and external write protection.\n\nFunctions are bound to the owning hook namespace by ``bind``. This keeps\nits injectable dependencies and per-import state on the public hook.\n\"\"\"\nfrom __future__ import annotations\n\n__all__ = ('_session_roots_registry_path', '_session_roots_partition_external', '_session_roots_guard', '_audit_registry_unreadable', '_audit_session_root_block')\n\n\ndef _session_roots_registry_path(repo_root: Path) -> Path:\n    \"\"\"Location of the session-roots registry written by the B1 observer.\"\"\"\n    return repo_root / \".claude\" / \"state\" / \"session-roots.json\"\n\n\n\ndef _session_roots_partition_external(\n    candidate_paths: List[str],\n    repo_root: Path,\n) -> Tuple[Optional[str], List[Tuple[str, str]]]:\n    \"\"\"Partition event write-targets into repo-internal vs external.\n\n    Shared canonicalization core for ``_session_roots_guard``: used by BOTH\n    the active-guard path (registry parsed, roots registered for this\n    session) AND the corrupt-registry fail-CLOSED branch (FXγ / C3), so the\n    two call sites agree byte-for-byte on what counts as an EXTERNAL write.\n    A single source of truth here is a cross-state safeguard: it stops the\n    corrupt-branch and the active-path external-detection from drifting apart\n    and disagreeing on the same tool-input.\n\n    Returns ``(uncanon_reason, external)``:\n      * ``uncanon_reason`` is a fail-CLOSED block-reason string when ANY\n        candidate cannot be canonicalized (not a str, empty, embedded NUL,\n        or ``os.path.realpath`` raised). A path that cannot be proven\n        repo-internal must not be waved through while a session-roots\n        security condition is in force. ``external`` is ``[]`` in that case.\n      * otherwise ``uncanon_reason`` is ``None`` and ``external`` lists the\n        ``(original, realpath)`` pairs that resolve OUTSIDE ``repo_root``\n        (repo-internal candidates are governed by the canonical stack above\n        and are dropped here). If ``repo_root`` itself cannot be\n        canonicalized, NO candidate can be proven internal → every candidate\n        is treated as external (fail-CLOSED on an unknowable boundary).\n\n    Pure: no emission, no raises out (realpath failures are caught and\n    converted to the fail-CLOSED ``uncanon_reason`` return VALUE).\n    \"\"\"\n    try:\n        repo_rp = os.path.realpath(str(repo_root))  # type: Optional[str]\n    except Exception:\n        repo_rp = None\n\n    external = []  # type: List[Tuple[str, str]]\n    for cand in candidate_paths:\n        # NUL/empty/non-str rejection is EXPLICIT (mirrors the control-char\n        # rejection in _parse_scope_paths_from_text): since bpo-33721\n        # (Py 3.8) os.path.realpath swallows the embedded-NUL ValueError and\n        # returns the tainted string un-resolved, so the except branch below\n        # never sees it — yet a NUL-bearing path is exactly the \"cannot be\n        # canonicalized\" input class this matcher fail-CLOSES.\n        if not isinstance(cand, str) or not cand or \"\\x00\" in cand:\n            return (_SESSION_ROOTS_UNCANON_EMPTY, [])\n        try:\n            rp = os.path.realpath(cand)\n        except Exception:\n            return (\n                \"SESSION-ROOTS-WRITE-BLOCKED: session_root_path_uncanonicalizable \"\n                f\"— write-target path {cand!r} cannot be canonicalized \"\n                \"(os.path.realpath raised) while session-registered workspace \"\n                \"roots are active. Security-matcher input → fail-closed \"\n                \"(CLAUDE.md §4; PLAN-163 T3.1 / ADR-183).\",\n                [],\n            )\n        if repo_rp is not None and (\n            rp == repo_rp or rp.startswith(repo_rp + os.sep)\n        ):\n            continue  # repo-internal → governed by the canonical stack above\n        external.append((cand, rp))\n    return (None, external)\n\n\n\ndef _session_roots_guard(\n    candidate_paths: List[str],\n    repo_root: Path,\n    session_id: str,\n    env=None,\n) -> Optional[str]:\n    \"\"\"Pure deny predicate for writes under session-registered roots.\n\n    Returns a block-reason string (→ deny) or ``None`` (→ allow). The DENY\n    path is PURE in the ``_candidate_is_granted`` sense: no emission side\n    effects — the deny audit breadcrumb is a once-per-event concern owned\n    by ``main()``. The ONE carve-out is the corrupt / unreadable /\n    unknown-schema registry branch: a PRESENT-but-unparseable registry is a\n    security-matcher INPUT-parse failure (FXγ / C3), so it fails CLOSED for\n    external writes (deny) while allowing repo-internal writes, and it\n    additionally fires a best-effort tamper audit event (H5 observability,\n    see below) so a registry-rewrite attack is both blocked and visible.\n    ``env`` defaults to ``os.environ`` (injectable for tests).\n\n    Deny returns are VALUES, never raises: an unexpected raise out of this\n    function is a hook bug (INFRA) and the ``main()`` call site fail-OPENs\n    it with a breadcrumb, per the CLAUDE.md §4 split.\n    \"\"\"\n    src_env = env if env is not None else os.environ\n\n    # ---- Load registry (absent OR infra-read-error → silent allow;\n    # ---- present-but-unparseable → fail-CLOSED for external writes) ----\n    registry_path = _session_roots_registry_path(repo_root)\n    try:\n        if not registry_path.is_file():\n            return None\n    except OSError:\n        return None\n    # C3 (codex/grok R4+R5): read raw BYTES in a SEPARATE try — an OSError here\n    # (PermissionError, IsADirectory, transient IO) is an INFRASTRUCTURE read\n    # failure, NOT tampering, so it fails OPEN (allow), same as an ABSENT file.\n    # Folding it into the parse `except Exception` below turned an infra read\n    # error into a fail-CLOSED external-write DENY — a self-DoS. Reading BYTES\n    # (not text) keeps the utf-8 DECODE inside the fail-closed parse block:\n    # non-utf-8 bytes raise UnicodeDecodeError (IS-A ValueError, NOT OSError),\n    # which is PRESENT-but-unparseable security-matcher input and MUST\n    # fail-CLOSED — an earlier `read_text(encoding=...)` let that escape to the\n    # caller's infra catch-all and wrongly ALLOW a binary registry overwrite\n    # (R5). Only an OSError (bytes not readable at all) is INFRA -> allow.\n    try:\n        raw_bytes = registry_path.read_bytes()\n    except OSError:\n        return None\n    try:\n        data = json.loads(raw_bytes.decode(\"utf-8\"))\n        if not isinstance(data, dict):\n            raise ValueError(\"registry root is not an object\")\n        if data.get(\"schema\") != _SESSION_ROOTS_SCHEMA:\n            raise ValueError(\"unknown registry schema\")\n        sessions = data.get(\"sessions\")\n        if not isinstance(sessions, dict):\n            raise ValueError(\"registry 'sessions' is not an object\")\n    except Exception as exc:  # registry PRESENT + readable but unparseable\n        print(\n            \"[check_canonical_edit] session-roots registry unreadable \"\n            f\"({type(exc).__name__}); present-but-unparseable security-matcher \"\n            \"input → fail-CLOSED for external writes; repo-internal writes stay \"\n            f\"governed by the canonical stack. registry={registry_path}\",\n            file=sys.stderr,\n        )\n        # FXγ (C3) — DOCTRINE CORRECTION. A registry that EXISTS but cannot be\n        # parsed (corrupt JSON, unknown schema-version, malformed `sessions`)\n        # is PRESENT-but-unparseable security-matcher input, NOT an\n        # ABSENT-file INFRA condition, so per CLAUDE.md §4 it fails CLOSED —\n        # content the guard cannot parse is blocked, never waved through. The\n        # deny is SCOPED to writes we cannot prove repo-internal (the new\n        # surface an added root could have opened); repo-internal writes stay\n        # governed by the canonical stack above (unaffected). Registry ABSENT\n        # (handled earlier) remains an allow — the observer may simply not\n        # have run.\n        #\n        # H5 observability is preserved and now UNCONDITIONAL: whether or not\n        # this event carries an external write, the corruption is recorded in\n        # the HMAC audit chain so a registry-rewrite attack leaves a forensic\n        # trace. Emitted BEFORE the partition so even the allow (repo-internal\n        # only) branch records the tamper. Best-effort; never raises.\n        _audit_registry_unreadable(registry_path, type(exc).__name__)\n        uncanon_reason, external = _session_roots_partition_external(\n            candidate_paths, repo_root\n        )\n        if uncanon_reason is not None or external:\n            # At least one write-target cannot be proven repo-internal while\n            # the registry — the very state that tells us whether a root was\n            # added — is unparseable. The write boundary is unknowable →\n            # deny fail-CLOSED until the registry is repaired.\n            return (\n                \"SESSION-ROOTS-WRITE-BLOCKED: session_roots_registry_unreadable \"\n                \"— the session-roots registry \"\n                \"(.claude/state/session-roots.json) is PRESENT but could not be \"\n                \"parsed (corrupt JSON, unknown schema-version, or a malformed \"\n                \"'sessions' object). A present-but-unparseable security-matcher \"\n                \"input cannot prove this write stays inside the project root, \"\n                \"so writes OUTSIDE the repo are denied fail-closed (CLAUDE.md \"\n                \"§4) until the registry is repaired or removed. Repo-internal \"\n                \"writes remain governed by the canonical stack; the corruption \"\n                \"is recorded in the HMAC audit chain. PLAN-163 T3.1 / ADR-183; \"\n                \"H5.\"\n            )\n        return None  # all writes provably repo-internal → canonical stack\n\n    sid = (session_id or \"\").strip()\n    # M1 (PLAN-163 T3.1 / ADR-183) — an ABSENT/empty session_id while the\n    # registry holds registered sessions is a security-matcher input the\n    # guard cannot bind to a session, yet roots DO exist → the write\n    # boundary is unknowable → fail-CLOSED (CLAUDE.md §4). Denying here\n    # means clearing CLAUDE_SESSION_ID cannot silently neutralize the\n    # guard. Only EXTERNAL writes are denied (repo-internal writes stay\n    # governed by the canonical stack above); the deny is emitted below,\n    # after the fail-CLOSED input resolution, once ``external`` is known.\n    sid_missing_with_registry = (not sid) and bool(sessions)\n    if sid_missing_with_registry:\n        roots = []  # boundary unknowable; external writes denied below\n    else:\n        sess = sessions.get(sid)\n        if not isinstance(sess, dict):\n            return None  # no roots registered for THIS session\n        roots = sess.get(\"roots\")\n        if not isinstance(roots, list) or not roots:\n            return None\n\n    # ---- Guard is ACTIVE for this session. Resolve inputs fail-CLOSED ----\n    # Allowlist: CEO_SESSION_ROOTS_ALLOW, os.pathsep-separated directory\n    # list, compared by realpath.\n    allow_rps: Set[str] = set()\n    for tok in (src_env.get(_SESSION_ROOTS_ALLOW_ENV) or \"\").split(os.pathsep):\n        tok = tok.strip()\n        if not tok:\n            continue\n        try:\n            allow_rps.add(os.path.realpath(tok))\n        except (OSError, ValueError):\n            continue  # a broken allowlist token allows nothing\n\n    # Resolve inputs + partition repo-internal vs external through the SHARED\n    # core (also used by the corrupt-registry FXγ branch above) so the two\n    # sites cannot drift on what \"external\" means. Uncanonicalizable input →\n    # fail-CLOSED; repo-internal candidates are governed by the canonical\n    # stack above and are dropped.\n    uncanon_reason, external = _session_roots_partition_external(\n        candidate_paths, repo_root\n    )\n    if uncanon_reason is not None:\n        return uncanon_reason\n    if not external:\n        return None\n\n    if sid_missing_with_registry:\n        # M1 fail-CLOSED: session identity is absent but the registry is\n        # non-empty and this event has external write targets → deny.\n        return (\n            \"SESSION-ROOTS-WRITE-BLOCKED: session_id_missing — this \"\n            \"canonical-edit event carries no session_id (absent/empty) \"\n            \"while the session-roots registry holds registered workspace \"\n            \"roots, so the write cannot be bound to a session and the \"\n            \"boundary is unknowable. Writes outside the project root are \"\n            \"denied fail-closed so that clearing CLAUDE_SESSION_ID cannot \"\n            \"neutralize the guard (CLAUDE.md §4; PLAN-163 T3.1 / ADR-183).\"\n        )\n\n    for entry in roots:\n        directory = entry.get(\"directory\") if isinstance(entry, dict) else None\n        if (\n            not isinstance(entry, dict)\n            or entry.get(\"unparseable\")\n            or not isinstance(directory, str)\n            or not directory\n            or \"\\x00\" in directory\n            or not os.path.isabs(directory)\n        ):\n            # A root WAS registered for this session but its boundary is\n            # unknowable (observer marked it unparseable, the entry is\n            # structurally malformed, or — M2 — its `directory` is not an\n            # ABSOLUTE path: a relative value would be silently resolved\n            # against the process CWD by os.path.realpath below and\n            # mis-scope the boundary, so it is rejected in the same\n            # fail-CLOSED class as unparseable). Like a corrupt whole-registry\n            # (present-but-unparseable → fail-CLOSED for external writes), here\n            # we positively know the session's write\n            # surface grew and cannot bound it → every non-repo write is\n            # denied until the entry is repaired (fail-CLOSED in the\n            # consumer, PLAN-163 T3.1).\n            return (\n                \"SESSION-ROOTS-WRITE-BLOCKED: session_root_unparseable — this \"\n                \"session has a registered workspace root whose directory could \"\n                \"not be parsed (entry marked unparseable or malformed in \"\n                \".claude/state/session-roots.json), so the session's write \"\n                \"boundary is unknowable. Writes outside the project root are \"\n                \"denied fail-closed until the registry entry is repaired \"\n                \"(PLAN-163 T3.1 / ADR-183).\"\n            )\n        try:\n            root_rp = os.path.realpath(directory)\n        except Exception:\n            return (\n                \"SESSION-ROOTS-WRITE-BLOCKED: session_root_unparseable — a \"\n                \"registered workspace root for this session cannot be \"\n                \"canonicalized (os.path.realpath raised); the session's write \"\n                \"boundary is unknowable. Writes outside the project root are \"\n                \"denied fail-closed (PLAN-163 T3.1 / ADR-183).\"\n            )\n        if root_rp in allow_rps:\n            continue  # Owner explicitly allowlisted this root\n        for cand, rp in external:\n            if rp == root_rp or rp.startswith(root_rp + os.sep):\n                return (\n                    \"SESSION-ROOTS-WRITE-BLOCKED: session_root_write_denied — \"\n                    f\"write target '{cand}' resolves to '{rp}', inside the \"\n                    f\"session-registered workspace root '{root_rp}' \"\n                    f\"(source={entry.get('source') or 'unknown'}). \"\n                    \"DirectoryAdded (CC 2.1.220) is notification-only and \"\n                    \"post-facto, so added roots are writable-by-default at \"\n                    \"the permission layer; this framework denies such writes \"\n                    \"by default. To allow, add the root's realpath to \"\n                    f\"{_SESSION_ROOTS_ALLOW_ENV} (os.pathsep-separated) and \"\n                    \"retry. PLAN-163 T3.1 / ADR-183.\"\n                )\n    return None\n\n\n\ndef _audit_registry_unreadable(registry_path: Path, exc_name: str) -> None:\n    \"\"\"Best-effort tamper-observability emit for a corrupt / unreadable /\n    unknown-schema session-roots registry (H5).\n\n    The guard fails CLOSED for external writes on this condition (FXγ / C3:\n    a present-but-unparseable registry is a security-matcher INPUT-parse\n    failure, not an ABSENT-file INFRA allow) while allowing repo-internal\n    writes. This emit runs UNCONDITIONALLY — before the external/internal\n    partition — so that even the repo-internal allow path records the\n    corruption: an adversary corrupting or truncating the repo-internal,\n    agent-writable ``.claude/state/session-roots.json`` is both BLOCKED (for\n    the external write it opened) and OBSERVABLE in the HMAC-chained audit\n    log. Reuses the already-registered ``veto_triggered`` action (NO new\n    action invented — see ADR-183 §Residuals) with a distinct ``reason_code``.\n    hasattr-guarded; never raises; no-value-echo — the breadcrumb carries the\n    registry PATH and the exception CLASS name only, never registry bytes or\n    tool-input content.\n    \"\"\"\n    try:\n        from _lib import audit_emit\n        if not hasattr(audit_emit, \"emit_veto_triggered\"):\n            return\n        audit_emit.emit_veto_triggered(\n            hook=\"check_canonical_edit\",\n            reason_code=\"session_roots_registry_unreadable\",\n            reason_preview=(\n                \"session-roots registry unreadable/corrupt/unknown-schema; \"\n                \"fail-CLOSED for external writes (FXγ) + tamper recorded; \"\n                f\"exc={exc_name}; registry={registry_path}\"\n            ),\n            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n        )\n    except Exception:\n        return\n\n\n\ndef _audit_session_root_block(target: str) -> None:\n    \"\"\"Best-effort veto_triggered emit for a session-roots deny.\n\n    Mirrors ``_audit_block``: never raises; no-value-echo (the breadcrumb\n    carries the target PATH only, never tool-input content).\n    \"\"\"\n    try:\n        from _lib import audit_emit\n        audit_emit.emit_veto_triggered(\n            hook=\"check_canonical_edit\",\n            reason_code=\"session_root_write_denied\",\n            reason_preview=(\n                f\"blocked write under session-registered root; target={target}\"\n            ),\n            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n        )\n    except Exception:\n        return\n","numLines":364,"startLine":1,"totalLines":364}},"tool_result_meta":[{"id":"toolu_01F6c9e2vjgGwN4QVUqmKG9e","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
