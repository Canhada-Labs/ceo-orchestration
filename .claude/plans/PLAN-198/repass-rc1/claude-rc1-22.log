{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XRccGovTpHdst4rAM8xDe4","type":"tool_result","content":"1\t\"\"\"Tests for check_canonical_edit.py — sentinel-gated canonical edits.\n2\t\n3\tSprint 5 Phase 7 (ADR-010). Verifies:\n4\t1. Non-canonical paths pass silently\n5\t2. Canonical paths without sentinel are blocked\n6\t3. Canonical paths with valid sentinel are allowed\n7\t4. Sentinel without Approved-By is rejected\n8\t5. Sentinel that doesn't list the path in Scope: is rejected\n9\t\"\"\"\n10\t\n11\tfrom __future__ import annotations\n12\t\n13\timport json\n14\timport os\n15\timport shutil\n16\timport subprocess\n17\timport sys\n18\timport unittest\n19\tfrom unittest import mock\n20\tfrom pathlib import Path\n21\t\n22\t_HOOKS_DIR = Path(__file__).resolve().parent.parent\n23\tsys.path.insert(0, str(_HOOKS_DIR.parent / \"scripts\" / \"tests\"))\n24\t\n25\tfrom _lib.testing import TestEnvContext  # noqa: E402\n26\tfrom _subprocess_helpers import run_in_process_group  # noqa: E402\n27\t\n28\t_HOOK = _HOOKS_DIR / \"check_canonical_edit.py\"\n29\t\n30\t\n31\tclass CheckCanonicalEditTest(TestEnvContext):\n32\t\n33\t    def test_missing_canonical_component_blocks_with_integrity_reason(self):\n34\t        isolated_hook = self.project_dir / \"check_canonical_edit.py\"\n35\t        shutil.copyfile(_HOOK, isolated_hook)\n36\t        env = dict(os.environ)\n37\t        env.pop(\"PYTHONPATH\", None)\n38\t        result = run_in_process_group(\n39\t            [sys.executable, str(isolated_hook)], timeout=10,\n40\t            input=json.dumps({\"tool_input\": {\"file_path\": \".claude/team.md\"}}),\n41\t            capture_output=True, text=True, env=env, cwd=str(self.project_dir),\n42\t        )\n43\t        self.assertEqual(result.returncode, 0, result.stderr)\n44\t        decision = json.loads(result.stdout)\n45\t        self.assertEqual(decision[\"decision\"], \"block\", result.stderr)\n46\t        self.assertIn(\"canonical_edit integrity\", decision[\"reason\"])\n47\t        self.assertIn(\"component import unavailable\", result.stderr)\n48\t\n49\t    def _invoke(self, payload: dict) -> tuple[int, str, str]:\n50\t        \"\"\"Run the hook as subprocess, returning (rc, stdout, stderr).\n51\t\n52\t        PLAN-045 Wave 1 P0-01: the hook now requires a detached `.asc`\n53\t        GPG signature alongside every sentinel OR an explicit\n54\t        ``CEO_SENTINEL_UNLOCK`` + ``CEO_SENTINEL_UNLOCK_ACK`` env pair\n55\t        (the documented interim dual-auth bypass per ADR-010 amendment).\n56\t        These tests create PLAINTEXT sentinels — they exercise the\n57\t        Approved-By + Scope plaintext path only, not GPG — so we set\n58\t        the bypass env by default. Tests that need to exercise the GPG\n59\t        verification explicitly should override these env vars.\n60\t        \"\"\"\n61\t        env = {**os.environ}\n62\t        # PLAN-086 Wave I.1 (ADR-119) tightened the env-override regex to\n63\t        # ^(ADR-\\d{3,4}|PLAN-\\d{3})-[a-z0-9-]{3,100}$. Older \"PLAN-TEST\"\n64\t        # value fails the new pattern; use a compliant test fixture slug.\n65\t        env.setdefault(\"CEO_SENTINEL_UNLOCK\", \"PLAN-091-test-fixture\")\n66\t        env.setdefault(\"CEO_SENTINEL_UNLOCK_ACK\", \"I-ACCEPT\")\n67\t        proc = subprocess.run(\n68\t            [sys.executable, str(_HOOK)],\n69\t            input=json.dumps(payload),\n70\t            capture_output=True,\n71\t            text=True,\n72\t            timeout=10,\n73\t            env=env,\n74\t        )\n75\t        return proc.returncode, proc.stdout, proc.stderr\n76\t\n77\t    def _make_repo_layout(self) -> Path:\n78\t        \"\"\"Set up a minimal repo layout under self.project_dir.\"\"\"\n79\t        # Create canonical files\n80\t        (self.project_dir / \".claude\").mkdir(exist_ok=True)"}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"4bc034db-3aa7-4d92-baec-ae970d31b68f","timestamp":"2026-11-13T18:04:07.190Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/tests/test_check_canonical_edit.py","content":"\"\"\"Tests for check_canonical_edit.py — sentinel-gated canonical edits.\n\nSprint 5 Phase 7 (ADR-010). Verifies:\n1. Non-canonical paths pass silently\n2. Canonical paths without sentinel are blocked\n3. Canonical paths with valid sentinel are allowed\n4. Sentinel without Approved-By is rejected\n5. Sentinel that doesn't list the path in Scope: is rejected\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport unittest\nfrom unittest import mock\nfrom pathlib import Path\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nsys.path.insert(0, str(_HOOKS_DIR.parent / \"scripts\" / \"tests\"))\n\nfrom _lib.testing import TestEnvContext  # noqa: E402\nfrom _subprocess_helpers import run_in_process_group  # noqa: E402\n\n_HOOK = _HOOKS_DIR / \"check_canonical_edit.py\"\n\n\nclass CheckCanonicalEditTest(TestEnvContext):\n\n    def test_missing_canonical_component_blocks_with_integrity_reason(self):\n        isolated_hook = self.project_dir / \"check_canonical_edit.py\"\n        shutil.copyfile(_HOOK, isolated_hook)\n        env = dict(os.environ)\n        env.pop(\"PYTHONPATH\", None)\n        result = run_in_process_group(\n            [sys.executable, str(isolated_hook)], timeout=10,\n            input=json.dumps({\"tool_input\": {\"file_path\": \".claude/team.md\"}}),\n            capture_output=True, text=True, env=env, cwd=str(self.project_dir),\n        )\n        self.assertEqual(result.returncode, 0, result.stderr)\n        decision = json.loads(result.stdout)\n        self.assertEqual(decision[\"decision\"], \"block\", result.stderr)\n        self.assertIn(\"canonical_edit integrity\", decision[\"reason\"])\n        self.assertIn(\"component import unavailable\", result.stderr)\n\n    def _invoke(self, payload: dict) -> tuple[int, str, str]:\n        \"\"\"Run the hook as subprocess, returning (rc, stdout, stderr).\n\n        PLAN-045 Wave 1 P0-01: the hook now requires a detached `.asc`\n        GPG signature alongside every sentinel OR an explicit\n        ``CEO_SENTINEL_UNLOCK`` + ``CEO_SENTINEL_UNLOCK_ACK`` env pair\n        (the documented interim dual-auth bypass per ADR-010 amendment).\n        These tests create PLAINTEXT sentinels — they exercise the\n        Approved-By + Scope plaintext path only, not GPG — so we set\n        the bypass env by default. Tests that need to exercise the GPG\n        verification explicitly should override these env vars.\n        \"\"\"\n        env = {**os.environ}\n        # PLAN-086 Wave I.1 (ADR-119) tightened the env-override regex to\n        # ^(ADR-\\d{3,4}|PLAN-\\d{3})-[a-z0-9-]{3,100}$. Older \"PLAN-TEST\"\n        # value fails the new pattern; use a compliant test fixture slug.\n        env.setdefault(\"CEO_SENTINEL_UNLOCK\", \"PLAN-091-test-fixture\")\n        env.setdefault(\"CEO_SENTINEL_UNLOCK_ACK\", \"I-ACCEPT\")\n        proc = subprocess.run(\n            [sys.executable, str(_HOOK)],\n            input=json.dumps(payload),\n            capture_output=True,\n            text=True,\n            timeout=10,\n            env=env,\n        )\n        return proc.returncode, proc.stdout, proc.stderr\n\n    def _make_repo_layout(self) -> Path:\n        \"\"\"Set up a minimal repo layout under self.project_dir.\"\"\"\n        # Create canonical files\n        (self.project_dir / \".claude\").mkdir(exist_ok=True)","numLines":80,"startLine":1,"totalLines":462}},"tool_result_meta":[{"id":"toolu_01XRccGovTpHdst4rAM8xDe4","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
