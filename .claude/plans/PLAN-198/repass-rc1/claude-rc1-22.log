{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018DQh1iTj1uBUf9Rdcn15UR","type":"tool_result","content":"276\t# ---------------------------------------------------------------------------\n277\t\n278\t# Fallback prefix set — mirror of check_canonical_edit._CANONICAL_PREFIXES.\n279\t# Used ONLY if the real predicate cannot be imported. Coarser (first-segment\n280\t# prefix) — it over-triggers review, which is the safe direction (a missed\n281\t# L3 touch is the danger; an extra review is not).\n282\t_FALLBACK_CANONICAL_PREFIXES = frozenset(\n283\t    {\".claude\", \".github\", \"scripts\", \"SPEC\", \"PROTOCOL.md\"}\n284\t)\n285\t\n286\t\n287\tdef _import_is_canonical():  # type: ignore[no-untyped-def]\n288\t    \"\"\"Import check_canonical_edit._is_canonical, or None on failure.\"\"\"\n289\t    try:\n290\t        import check_canonical_edit as _cce  # type: ignore\n291\t        fn = getattr(_cce, \"_is_canonical\", None)\n292\t        return fn if callable(fn) else None\n293\t    except Exception:\n294\t        return None\n295\t\n296\t\n297\tdef _is_l3_path(rel_path: str, repo_root: Path, is_canonical) -> bool:\n298\t    \"\"\"True if rel_path is an L3/canonical governed path.\n299\t\n300\t    Primary: check_canonical_edit._is_canonical (source of truth — the same\n301\t    predicate the edit-time guard uses; its guard set is a superset covering\n302\t    hooks/kernel/plans/ADRs/workflows). Fallback: first-segment prefix match.\n303\t    \"\"\"\n304\t    if is_canonical is not None:\n305\t        try:\n306\t            return bool(is_canonical(str(repo_root / rel_path), repo_root))\n307\t        except Exception:\n308\t            pass\n309\t    first_seg = rel_path.replace(os.sep, \"/\").split(\"/\", 1)[0]\n310\t    return first_seg in _FALLBACK_CANONICAL_PREFIXES\n311\t\n312\t\n313\tdef _git_changed_paths(repo_root: Path) -> List[str]:\n314\t    \"\"\"Repo-relative paths changed in the working tree (tracked diff vs HEAD\n315\t    + untracked). Empty on any git failure (fail-open).\"\"\""}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"11d63c64-c328-4e0f-af85-34b0ecb34186","timestamp":"2026-11-13T18:08:40.231Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/check_codex_stop_review.py","content":"# ---------------------------------------------------------------------------\n\n# Fallback prefix set — mirror of check_canonical_edit._CANONICAL_PREFIXES.\n# Used ONLY if the real predicate cannot be imported. Coarser (first-segment\n# prefix) — it over-triggers review, which is the safe direction (a missed\n# L3 touch is the danger; an extra review is not).\n_FALLBACK_CANONICAL_PREFIXES = frozenset(\n    {\".claude\", \".github\", \"scripts\", \"SPEC\", \"PROTOCOL.md\"}\n)\n\n\ndef _import_is_canonical():  # type: ignore[no-untyped-def]\n    \"\"\"Import check_canonical_edit._is_canonical, or None on failure.\"\"\"\n    try:\n        import check_canonical_edit as _cce  # type: ignore\n        fn = getattr(_cce, \"_is_canonical\", None)\n        return fn if callable(fn) else None\n    except Exception:\n        return None\n\n\ndef _is_l3_path(rel_path: str, repo_root: Path, is_canonical) -> bool:\n    \"\"\"True if rel_path is an L3/canonical governed path.\n\n    Primary: check_canonical_edit._is_canonical (source of truth — the same\n    predicate the edit-time guard uses; its guard set is a superset covering\n    hooks/kernel/plans/ADRs/workflows). Fallback: first-segment prefix match.\n    \"\"\"\n    if is_canonical is not None:\n        try:\n            return bool(is_canonical(str(repo_root / rel_path), repo_root))\n        except Exception:\n            pass\n    first_seg = rel_path.replace(os.sep, \"/\").split(\"/\", 1)[0]\n    return first_seg in _FALLBACK_CANONICAL_PREFIXES\n\n\ndef _git_changed_paths(repo_root: Path) -> List[str]:\n    \"\"\"Repo-relative paths changed in the working tree (tracked diff vs HEAD\n    + untracked). Empty on any git failure (fail-open).\"\"\"","numLines":40,"startLine":276,"totalLines":736}},"tool_result_meta":[{"id":"toolu_018DQh1iTj1uBUf9Rdcn15UR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
