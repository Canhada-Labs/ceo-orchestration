ayload is None:\n232\t        _emit_decision({})\n233\t        return 0\n234\t\n235\t    tool_name = (payload.get(\"tool_name\") or \"\").strip()\n236\t    tool_input = payload.get(\"tool_input\") or {}\n237\t    session_id = (payload.get(\"session_id\") or \"\").strip()\n238\t    if not isinstance(tool_input, dict):\n239\t        _emit_decision({})\n240\t        return 0\n241\t\n242\t    if tool_name != \"Bash\" or not _looks_like_swarm_dispatch(tool_input):\n243\t        _emit_decision({})\n244\t        return 0\n245\t\n246\t    try:\n247\t        class_tier = _resolve_class_tier()\n248\t        project_path = _resolve_project_path()\n249\t        if project_path is None:\n250\t            _breadcrumb(\"project scope unavailable; no cost envelope evaluated or spend recorded\")\n251\t            _emit_decision({})\n252\t            return 0\n253\t        user_id = _resolve_user_id()\n254\t        env = CostEnvelope(\n255\t            project_path=project_path,\n256\t            user_id=user_id,\n257\t            class_tier=class_tier,\n258\t        )\n259\t        estimate = _resolve_estimate_cents()\n260\t        plan_id = os.environ.get(\"CEO_PLAN_ID\")\n261\t        # Codex R2 iter-2 P0 #2 fold — atomic check+add. Single FileLock\n262\t        # acquire covers read of current spend + breach decision +\n263\t        # conditional write. Eliminates the prior split-phase TOCTOU\n264\t        # window where two concurrent dispatches could both pass\n265\t        # would_breach() and then overshoot the cap on record_spend().\n266\t        breached, cap, current = env.check_and_record(int(estimate), plan_id=plan_id)\n267\t    except Exception as e:\n268\t        _breadcrumb(f\"envelope eval exception (fail-OPEN): {e!r}\")\n269\t        _emit_decision({})\n270\t        return 0\n271\t\n272\t    if not breached:\n273\t        # Allow path — check_and_record has already persisted the spend\n274\t        # atomically under the same lock. Nothing more to do.\n275\t        