{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NBnNYLboC99X84PKW2","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01PGuBF3FmUV4TZCUqV1vwSj","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/check_canonical_edit.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":61978,"cache_read_input_tokens":4473,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":61978},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"26371534-bc8d-40b7-bd3d-4579149fe261","timestamp":"2026-11-13T18:02:16.317Z","request_id":"req_011Ch1NBn7ut36T4PCZ7WkJA","wire_tool_inputs":{"toolu_01PGuBF3FmUV4TZCUqV1vwSj":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/check_canonical_edit.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PGuBF3FmUV4TZCUqV1vwSj","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"PreToolUse hook: gate canonical-path edits on Owner-signed sentinel.\n3\t\n4\tSprint 5 Phase 7 (ADR-010). Blocks Edit / Write / MultiEdit calls\n5\tagainst canonical governance paths unless an Owner-signed sentinel\n6\tfile (`approved.md`) exists in the same Architect bundle directory\n7\twith a valid `Approved-By:` line and the target path declared in its\n8\t`Scope:` block.\n9\t\n10\t## Wire-up\n11\t\n12\tRegistered in `.claude/settings.json` PreToolUse Edit/Write/MultiEdit:\n13\t\n14\t    {\n15\t      \"matcher\": \"Edit|Write|MultiEdit\",\n16\t      \"hooks\": [\n17\t        {\n18\t          \"type\": \"command\",\n19\t          \"command\": \"bash \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\\\" check_canonical_edit.py\",\n20\t          \"timeout\": 5,\n21\t          \"statusMessage\": \"Checking canonical-path sentinel...\"\n22\t        }\n23\t      ]\n24\t    }\n25\t\n26\t## Decision logic\n27\t\n28\t1. Parse `tool_input.file_path` from the payload.\n29\t2. If path is NOT in the canonical guard list → allow silently.\n30\t3. If path IS canonical:\n31\t   a. Look for any sibling `.claude/plans/PLAN-NNN/architect/round-N/approved.md`\n32\t      that lists this path under its `Scope:` block.\n33\t   b. If sentinel exists + `Approved-By:` line valid → allow.\n34\t   c. Otherwise → block with a clear reason.\n35\t\n36\t## Fail-open contract\n37\t\n38\tAny internal exception → allow. The hook never blocks the user on its\n39\town bug. (The canonical edit is allowed; the canonical path is still\n40\tgoverned by CODEOWNERS / branch protection on the merge side.)\n41\t\"\"\"\n42\t\n43\tfrom __future__ import annotations\n44\t\n45\timport fnmatch\n46\timport json\n47\timport os\n48\timport hashlib  # PLAN-094 Wave C — sha256 in cache key\n49\timport re\n50\timport subprocess  # PLAN162_FIX_S2 — session-anchor proof via git\n51\timport sys\n52\timport time  # PLAN162_FIX_1 — per-invocation wall-clock budget\n53\tfrom pathlib import Path\n54\tfrom typing import Dict, List, Optional, Set, Tuple  # PLAN-094 Wave C\n55\t\n56\t# Make the local _lib importable\n57\t_HOOKS_DIR = Path(__file__).resolve().parent\n58\tif str(_HOOKS_DIR) not in sys.path:\n59\t    sys.path.insert(0, str(_HOOKS_DIR))\n60\t\n61\t# PLAN-045 Wave 1 P0-01 — GPG sentinel verification.\n62\ttry:\n63\t    from _lib import gpg_verify as _gpg_verify\n64\texcept Exception:  # pragma: no cover\n65\t    _gpg_verify = None  # type: ignore[assignment]\n66\t\n67\t# PLAN-089 Wave C.4 — sentinel signer registry (ADR-121).\n68\t# Behavior-preserving migration: if YAML registry resolves the signer\n69\t# via _lib.sentinel_signers, that result wins; otherwise the legacy\n70\t# `.claude/sentinel-signers.txt` allowlist is consulted (existing\n71\t# PLAN-045 path). Both wires fail-CLOSED on import failure.\n72\ttry:\n73\t    from _lib import sentinel_signers as _sentinel_signers  # type: ignore[import]\n74\texcept Exception:  # pragma: no cover\n75\t    _sentinel_signers = None  # type: ignore[assignment]\n76\t\n77\t_SENTINEL_SIGNERS_REGISTRY_YAML = (\n78\t    Path(__file__).resolve().parent.parent.parent\n79\t    / \".claude\" / \"security\" / \"sentinel-signers-registry.yaml\"\n80\t)\n81\t\n82\t# PLAN-089 Wave C.4 — R2 Codex iter-1 Q5+Q7 fold: _BOOTSTRAP_REGISTRY_SHA256\n83\t# pin per ADR-121 §5. Pre-GENESIS this is None and registry parse failure\n84\t# falls back to legacy `.txt` (avoids Wave C.6 transition brick).\n85\t# Post-GENESIS the Wave C.6 ceremony rotates this constant via KERNEL\n86\t# HARD-DENY ceremony (CEO_KERNEL_OVERRIDE=PLAN-089-WAVE-C-SENTINEL-\n87\t# ROTATION-GENESIS) to the SHA256 of the finalized YAML. When set:\n88\t#   - Registry hash mismatch → fail-CLOSED (tamper-detect)\n89\t#   - Registry parse failure → fail-CLOSED (post-GENESIS no-fallback)\n90\t_BOOTSTRAP_REGISTRY_SHA256: Optional[str] = None  # placeholder pre-GENESIS\n91\t\n92\t# PLAN-045 Wave 1 P0-01 — signer allowlist for sentinel .asc signatures.\n93\t_SENTINEL_SIGNERS_FILE = (\n94\t    Path(__file__).resolve().parent.parent.parent\n95\t    / \".claude\" / \"sentinel-signers.txt\"\n96\t)\n97\t\n98\t\n99\t# Canonical paths (relative to repo root) — ADR-010 v1.1 (Sprint 9\n100\t# amendment adds conftest.py + new-hook + lessons-related scripts).\n101\t# fnmatch.fnmatch is used; `*` is treated as a single segment matcher\n102\t# below by walking the path components manually. `**` matches zero or\n103\t# more segments (used for the Sprint 9 conftest entry).\n104\t#\n105\t# PLAN-019 Phase 2 Wave 2A (P1-SEC-A) expansion: full governance surface.\n106\t# Every path listed here is sentinel-gated (editable via Owner-signed\n107\t# sentinel). The arbitration-kernel subset (hook source files enforcing\n108\t# THIS guard, _lib/policy.py, _lib/redact.py, _lib/audit_emit.py, and\n109\t# .claude/policies/*.yaml) is ALSO covered by the stricter HARD-DENY\n110\t# hook `check_arbitration_kernel.py` — that hook has no sentinel escape\n111\t# and requires `CEO_KERNEL_OVERRIDE` with an audit-logged reason. The\n112\t# overlap is intentional defense-in-depth: if the arbitration hook is\n113\t# disabled by misconfiguration, this sentinel guard still blocks the\n114\t# edits (and vice versa).\n115\t# Canonical governance surfaces: `.claude/skills/**/SKILL.md` and\n116\t# `.claude/commands/**` stay sentinel-guarded. These tokens are also the\n117\t# command/skill-hook map generator's source-scanning contract.\n118\ttry:\n119\t    from _lib.canonical_edit import guards as _canonical_guard_definitions\n120\t    for _guard_name in _canonical_guard_definitions.__all__:\n121\t        globals()[_guard_name] = getattr(_canonical_guard_definitions, _guard_name)\n122\t    del _guard_name, _canonical_guard_definitions\n123\texcept Exception:\n124\t    _CANONICAL_GUARDS = []\n125\t    _SKILL_CONTENT_RE = re.compile(r\"^$\")\n126\t    _SKILL_LOADED_RE = re.compile(r\"^$\")\n127\t    _VALID_BLOCKED_TOOLS = frozenset()\n128\t\n129\t# Set ONCE per invocation by ``main()`` from the parsed event, and reset\n130\t# in its ``finally`` so a value can never leak into a later in-process\n131\t# caller. Helpers deep in the call graph (``_emit_unlock_audit`` has no\n132\t# event in scope) read it through ``_blocked_tool_field()``.\n133\t_CURRENT_TOOL_NAME = \"\"\n134\t\n135\t\n136\t# Blocked-tool validation and skill-content checks are bound below.\n137\t\n138\t\n139\t# PLAN-025 F-perf-004 fast-path — precomputed set of top-level path\n140\t# segments that every _CANONICAL_GUARDS entry starts with. Any path NOT\n141\t# starting with one of these prefixes is non-canonical in O(1) without\n142\t# running fnmatch 30+ times. Preserves semantics — every guard pattern\n143\t# starts with one of these prefixes by construction.\n144\t_CANONICAL_PREFIXES = frozenset({\n145\t    \".claude\", \".github\", \"scripts\", \"SPEC\", \"PROTOCOL.md\",\n146\t    # PLAN-155 Wave 3b (SENT-CX-E) — first-segment prefixes for the Codex\n147\t    # kill-switch surface. Without these three the fast-path bail-out in\n148\t    # `_is_canonical` returns False BEFORE the new `_CANONICAL_GUARDS`\n149\t    # entries are ever consulted (the guard would be dead — the S254\n150\t    # dead-gate class). Every kill-switch guard pattern starts with one of\n151\t    # these by construction (`.codex/*`, `requirements.toml`, `AGENTS.md`).\n152\t    \".codex\", \"requirements.toml\", \"AGENTS.md\",\n153\t    # PLAN-156 Wave 3 (SENT-GK-E) — the same dead-guard class as `.codex`\n154\t    # above, twice over (pair-rail R4 + R14). `_is_canonical()` bails out\n155\t    # BEFORE any glob matching unless the path's first segment is in this\n156\t    # set, so adding the `.grok/**` and `templates/settings/*` patterns to\n157\t    # _CANONICAL_GUARDS without adding their first segments HERE would\n158\t    # leave both guards INERT — unsentineled edits sailing straight through\n159\t    # a list that LOOKS like it protects them. The S254 dead-gate class,\n160\t    # and the reason this pair of edits can never be split across waves.\n161\t    \".grok\", \"templates\",\n162\t})\n163\t\n164\t\n165\t# PLAN160_FIX_A / PLAN160_FIX_C / PLAN160_FIX_D — upper bound on candidates\n166\t# classified per multi-candidate event, resolve-fault fail-closed in decide(),\n167\t# and relative-path canonical resolution against repo_root.\n168\t# event. Beyond this the event is fail-CLOSED (blocked) rather than risk an\n169\t# unexamined canonical candidate riding through past a truncated scan. Real\n170\t# apply_patch / MCP bulk events carry a handful of paths; this is a DoS-shape\n171\t# backstop, not a normal-path limit.\n172\t_PLAN160_MAX_CANDIDATES = 512\n173\t\n174\t\n175\t# PLAN162_FIX_CASEFOLD (PLAN-162 consensus S1, P0 — BOTH rails).\n176\t#\n177\t# ``_match_segments`` matches with ``fnmatch.fnmatchcase`` (exact case)\n178\t# and ``_CANONICAL_PREFIXES`` is an exact-case frozenset. On a\n179\t# case-INSENSITIVE filesystem — APFS, the default on this repo's\n180\t# platform — ``.claude/settings.JSON`` IS ``.claude/settings.json``, and\n181\t# writing through the variant OVERWRITES the guarded file. Measured on\n182\t# HEAD: `.claude/settings.JSON`, `.claude/hooks/_lib/audit_emit.PY` and\n183\t# `.CLAUDE/settings.json` all classified NON-canonical AND non-kernel,\n184\t# reaching files the threat model assumes unreachable.\n185\t#\n186\t# Both halves must fold or the guard only LOOKS fixed: the prefix\n187\t# fast-path bails out in O(1) BEFORE any glob runs, so folding the glob\n188\t# matcher alone would leave `.CLAUDE/...` inert — the dead-gate class\n189\t# this file was already bitten by twice (the `.codex` and `.grok` prefix\n190\t# omissions).\n191\t#\n192\t# ``str.lower`` — not ``str.casefold`` — deliberately: casefold expands\n193\t# 'ß'→'ss', changing segment LENGTH and hence what a glob matches. The\n194\t# exploited class is ASCII case variance, which ``lower()`` covers\n195\t# exactly; identical inputs always fold identically, so the\n196\t# normalization can only ADD matches (over-classify = the safe\n197\t# direction), never remove one.\n198\t#\n199\t# Precomputed at import: the hot path pays one ``str.lower()`` per\n200\t# classification instead of one per (segment x pattern).\n201\t_CANONICAL_GUARDS_FOLDED = [pat.lower() for pat in _CANONICAL_GUARDS]\n202\t_CANONICAL_PREFIXES_FOLDED = frozenset(\n203\t    prefix.lower() for prefix in _CANONICAL_PREFIXES\n204\t)\n205\t\n206\t\n207\t# ---------------------------------------------------------------------------\n208\t# PLAN162_FIX_2: depth-independent discovery now lives in canonical_edit.paths.\n209\t# PLAN-094 Wave C — sentinel verification session cache (R-041)\n210\t# ---------------------------------------------------------------------------\n211\t# Module-scope ONLY (NEVER file-backed; PLAN-094 §3 Wave C C.1).\n212\t# Process death = cache loss (eliminates R5 stale-cache-survives-crash).\n213\t# Composite key — Codex iter-1 P0 fold: target_rel included so cache value\n214\t# (grant decision dependent on target_rel) is correct on hit; sha256_full\n215\t# transitively covers signer changes via .asc bytes (signer rotation\n216\t# window risk acknowledged + accepted trade-off per design draft §8).\n217\t\n218\t_SENTINEL_CACHE_FORMAT_VERSION = 2  # bumped at iter-1 P0 fix (target_rel added)\n219\t_SENTINEL_VERIFY_CACHE: Dict[\n220\t    Tuple[str, int, int, int, str, str, int], bool\n221\t] = {}\n222\t_SENTINEL_CACHE_HITS = 0\n223\t_SENTINEL_CACHE_MISSES = 0\n224\t\n225\t# PLAN162_FIX_1 (PLAN-162 findings #1 + #10, consensus C1 + C2 + C3 + S8).\n226\t#\n227\t# ## The defect (#1, re-diagnosed in debate: AMPLIFICATION, not latency)\n228\t#\n229\t# The cache above folds ``target_rel`` into its key, but\n230\t# ``_gpg_verify.verify_detached`` never RECEIVES a target — signature\n231\t# validity is target-INDEPENDENT. So the same sentinel was\n232\t# cryptographically re-verified once per distinct target: a subprocess\n233\t# count of O(candidates x sentinels). Measured in debate, gpg-agent\n234\t# healthy: 1 GPG ~ 17 ms, but a 20-path ceremony pack cost **4.16 s of a\n235\t# 5 s hook budget** with 0 cache hits and 320 misses (40 paths: 4.23 s).\n236\t#\n237\t# ## The fix — two caches, not one\n238\t#\n239\t#   * ``_SIG_VERIFY_CACHE`` — the SIGNATURE rail, keyed on the signing\n240\t#     MATERIAL and NOT on the target. 320 subprocesses collapse to 16.\n241\t#   * ``_GRANT_CACHE`` — the SCOPE rail, target-keyed and cheap. This is\n242\t#     the SAME object as ``_SENTINEL_VERIFY_CACHE`` (an alias, not a\n243\t#     copy): the PLAN-094 key shape and counters are pinned by\n244\t#     ``test_sentinel_session_cache.py`` and stay byte-compatible.\n245\t#\n246\t# ## Why the signature rail must run FIRST (this is finding #10)\n247\t#\n248\t# #10 observed that the grant key hashes only ``approved.md``'s bytes, so\n249\t# mutating the ``.asc`` / signer allowlist / ADR-121 registry left a\n250\t# stale ``True`` riding the cache in-process. Rather than smuggle a\n251\t# digest of three more files into a key shape other tests pin, the\n252\t# signature rail is consulted BEFORE the grant fast-path and keys on\n253\t# those bytes itself. A revocation in any of the three now invalidates\n254\t# the decision even when ``approved.md`` is byte-identical — closing the\n255\t# \"signer rotation window\" that PLAN-094 §8 had consciously accepted.\n256\t_SIG_CACHE_FORMAT_VERSION = 1\n257\t_SIG_VERIFY_CACHE: Dict[tuple, bool] = {}\n258\t_GRANT_CACHE = _SENTINEL_VERIFY_CACHE  # alias — same dict object\n259\t\n260\t# ---------------------------------------------------------------------------\n261\t# PLAN162_FIX_1 — per-invocation wall-clock budget (consensus C2 + C3 + S8)\n262\t# ---------------------------------------------------------------------------\n263\t# C2 REMOVED the sentinel cap from the design: ``_find_sentinels`` returns\n264\t# SORTED, so the highest-numbered pack — the ceremony the Owner just\n265\t# signed — is exactly the sentinel a cap would drop. Self-DoS with the\n266\t# signature in hand, and it does not even fix a hung gpg (one hang costs\n267\t# the full timeout at cap=1). What replaces it is a global wall-clock\n268\t# deadline per INVOCATION, checked at the top of the sentinel loops.\n269\t#\n270\t# C3: the budget is a MODULE CONSTANT, never read from settings.json at\n271\t# runtime — the budget lives in the file this hook guards (circular), and\n272\t# parsing JSON on the hot path would worsen the very path being\n273\t# optimized. Drift against the registered timeout is a STATIC test\n274\t# instead (the shape verify-counts.sh already uses):\n275\t# ``test_1_repro_wall_deadline_constant_has_slack_under_registration``.\n276\t# 4.0 s under the registered 5 s leaves ~1 s to emit the decision.\n277\t#\n278\t# S8: the clock is an injectable module-level seam (``_now``). Without\n279\t# it the red-first test's only options were a multi-second real sleep\n280\t# (a documented flake class in this repo) or no deterministic coverage\n281\t# of the slow path at all. This is a requirement OF the fix.\n282\t#\n283\t# ORDER IS NOT NEGOTIABLE (C3): the deadline and the cache partition ship\n284\t# in the SAME patch under the SAME marker. A deadline without the\n285\t# partition fires on the 4.16 s measured above and denies the ceremony\n286\t# itself.\n287\t_HOOK_WALL_BUDGET_S = 4.0\n288\t_now = time.monotonic\n289\t_WALL_DEADLINE_AT = None  # type: Optional[float]\n290\t_WALL_BUDGET_EXHAUSTED = False\n291\t\n292\t\n293\tdef _start_wall_budget() -> None:\n294\t    \"\"\"Arm the per-invocation wall-clock deadline (called once by main).\"\"\"\n295\t    global _WALL_DEADLINE_AT, _WALL_BUDGET_EXHAUSTED\n296\t    _WALL_BUDGET_EXHAUSTED = False\n297\t    _WALL_DEADLINE_AT = _now() + _HOOK_WALL_BUDGET_S\n298\t\n299\t\n300\tdef _reset_wall_budget() -> None:\n301\t    \"\"\"Disarm the deadline.\n302\t\n303\t    Called from ``main()``'s ``finally`` so a module-scope deadline can\n304\t    never leak into a LATER in-process caller (the test suite drives\n305\t    ``decide()`` directly in the same process; a stale expired deadline\n306\t    would fail those closed for no reason).\n307\t    \"\"\"\n308\t    global _WALL_DEADLINE_AT, _WALL_BUDGET_EXHAUSTED\n309\t    _WALL_DEADLINE_AT = None\n310\t    _WALL_BUDGET_EXHAUSTED = False\n311\t\n312\t\n313\tdef _mark_wall_budget_exhausted() -> None:\n314\t    \"\"\"Latch the budget as spent (see ``_gpg_verify_timeout``).\n315\t\n316\t    Set when a signature verification is REFUSED for want of budget. The\n317\t    clock has not necessarily elapsed yet, but the invocation can no\n318\t    longer reach a verdict, so every subsequent poll must report expiry —\n319\t    otherwise the loop runs to its end and the operator is handed the\n320\t    generic \"declare this path in Scope\" block, which misdiagnoses a\n321\t    budget fault as a missing sentinel and omits the recovery route.\n322\t    \"\"\"\n323\t    global _WALL_BUDGET_EXHAUSTED\n324\t    _WALL_BUDGET_EXHAUSTED = True\n325\t\n326\t\n327\tdef _wall_budget_expired() -> bool:\n328\t    \"\"\"True once the armed invocation budget has elapsed (or is spent).\n329\t\n330\t    Disarmed (``None``) => never expired, so direct ``decide()`` callers\n331\t    outside a hook invocation are unaffected.\n332\t    \"\"\"\n333\t    if _WALL_DEADLINE_AT is None:\n334\t        return False\n335\t    if _WALL_BUDGET_EXHAUSTED:\n336\t        return True\n337\t    return _now() > _WALL_DEADLINE_AT\n338\t\n339\t\n340\t# ---------------------------------------------------------------------------\n341\t# PLAN162_FIX_1 — the gpg subprocess is bounded by the REMAINING budget\n342\t# ---------------------------------------------------------------------------\n343\t# Codex pair-rail P1 (S292) against this patch, staged:\n344\t#\n345\t#   \"Bound GPG verification by the remaining hook budget. When gpg or\n346\t#   gpg-agent stalls, this call can block for 15 seconds although the\n347\t#   hook is registered for 5 seconds and the new internal deadline is 4\n348\t#   seconds. Because the deadline is checked only between sentinel\n349\t#   iterations, the harness can kill the process before it emits the\n350\t#   intended fail-closed decision, recreating the silent fail-open that\n351\t#   ADR-164-AMEND-1 §3 explicitly says the patch prevents.\"\n352\t#\n353\t# The deadline above is POLLED: read at the top of the sentinel loops, it\n354\t# can only bound work that happens BETWEEN iterations. One\n355\t# ``verify_detached`` at the library default (``timeout=15.0``,\n356\t# ``_lib/gpg_verify.py``) is 3x the entire registration — the poll never\n357\t# gets its turn, the harness kills a hook that has emitted NOTHING, and\n358\t# \"no decision\" is indistinguishable from allow. ADR-164-AMEND-1 §3 D2\n359\t# already states the intended behaviour (\"per-verify subprocess timeout\n360\t# bounded by remaining budget\"); this is the code that makes the text\n361\t# true.\n362\t#\n363\t# Two constants, both about EMITTING rather than about gpg:\n364\t#\n365\t#   * ``_GPG_EMIT_MARGIN_S`` — wall time reserved AFTER gpg returns so the\n366\t#     rest of the decision plus the JSON emit still fit inside the\n367\t#     internal deadline. A verification bounded to land exactly ON the\n368\t#     deadline would merely have moved the kill.\n369\t#   * ``_GPG_MIN_SPAWN_S`` — the floor below which spawning is pointless:\n370\t#     a fork we cannot afford to wait out cannot tell \"bad signature\"\n371\t#     from \"slow agent\", so it must not start at all.\n372\t#\n373\t# Their sum must stay well under ``_HOOK_WALL_BUDGET_S``, or the FIRST\n374\t# sentinel of a fresh invocation could never be verified — self-DoS with\n375\t# the Owner's signature in hand, the C3 class. Pinned by\n376\t# ``test_control_gpg_bound_constants_leave_room_for_a_first_verify``.\n377\t_GPG_VERIFY_TIMEOUT_CAP_S = 15.0  # the historical _lib.gpg_verify default\n378\t_GPG_EMIT_MARGIN_S = 0.5\n379\t_GPG_MIN_SPAWN_S = 0.5\n380\t\n381\t\n382\tdef _gpg_verify_timeout() -> Optional[float]:\n383\t    \"\"\"Subprocess timeout for ONE detached-signature verification.\n384\t\n385\t    ``None`` means DO NOT SPAWN — what is left of the invocation budget\n386\t    cannot cover both a meaningful verification and the emit that has to\n387\t    follow it. Callers translate that into the fail-CLOSED wall-deadline\n388\t    block, never into an allow and never into a silent zero-emit.\n389\t\n390\t    With the budget disarmed (direct ``decide()`` callers, importers such\n391\t    as ``check_pair_rail``) the historical cap is returned unchanged:\n392\t    this narrows the hook-invocation path only.\n393\t    \"\"\"\n394\t    if _WALL_DEADLINE_AT is None:\n395\t        return _GPG_VERIFY_TIMEOUT_CAP_S\n396\t    usable = (_WALL_DEADLINE_AT - _now()) - _GPG_EMIT_MARGIN_S\n397\t    if usable < _GPG_MIN_SPAWN_S:\n398\t        return None\n399\t    return min(_GPG_VERIFY_TIMEOUT_CAP_S, usable)\n400\t\n401\t\n402\t_WALL_DEADLINE_BLOCK_REASON = (\n403\t    \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — the hook's \"\n404\t    \"per-invocation wall-clock budget ({0}s) elapsed before authorization \"\n405\t    \"for this canonical path could be established. A security matcher that \"\n406\t    \"cannot finish deciding does NOT allow (PLAN-045 F-01-07 posture; \"\n407\t    \"PLAN-162 consensus C2). Recovery: re-issue the edit, or use the \"\n408\t    \"documented CEO_SENTINEL_UNLOCK / CEO_KERNEL_OVERRIDE ceremony.\"\n409\t).format(_HOOK_WALL_BUDGET_S)\n410\t\n411\t\n412\t# ---------------------------------------------------------------------------\n413\t# PLAN162_FIX_S2 — the sentinel SET is a trust anchor (consensus S2)\n414\t# ---------------------------------------------------------------------------\n415\t# ``.claude/plans/PLAN-*/**/approved.md`` is guarded by NEITHER rail, and\n416\t# under an Owner ``CEO_SENTINEL_UNLOCK`` window the GPG rail is skipped\n417\t# entirely — so an ``approved.md`` the AGENT writes mid-window GRANTS.\n418\t# That is a bypass of AUTHORIZATION, not merely a DoS on the gate's cost.\n419\t#\n420\t# The first mitigation drafted for this (\"tracked in git OR pre-existing\")\n421\t# was DEFEATED by the pair-rail in one command: inside the window the\n422\t# agent writes the file and runs an ordinary ``git add``; ``ls-files\n423\t# --error-unmatch`` then calls it TRACKED, and a HEAD-based check would\n424\t# accept an agent-authored COMMIT just the same. **Git state is a\n425\t# statement about the index, not about who authorized the file.**\n426\t#\n427\t# The trust anchor is therefore SESSION START: under ``env_override``,\n428\t# accept only a sentinel that already existed in the tree at the commit\n429\t# the Owner names in ``CEO_SESSION_ANCHOR_SHA``. The anchor is an ENV\n430\t# var, which is exactly the same trust primitive the unlock itself rests\n431\t# on (a sub-agent cannot set env in the parent shell) — so requiring it\n432\t# adds no new assumption. No anchor => no proof => no grant.\n433\t#\n434\t# ## PLAN162_FIX_S2R2 — what the codex round-2 pair-rail corrected\n435\t#\n436\t# The first draft of this rail proved only that the sentinel PATH existed\n437\t# at the anchor, then parsed the CURRENT bytes. Codex defeated it in one\n438\t# move (P1-1): inside a legitimate window, take any pre-existing\n439\t# unguarded ``approved.md``, keep its ``Approved-By:`` line, ADD a target\n440\t# to ``Scope:`` — path-existence still holds, GPG is skipped, and the\n441\t# hook authorizes off attacker-modified bytes. **A trust decision must be\n442\t# made on the ANCHORED bytes, not on bytes that merely live at an\n443\t# anchored path.** ``git cat-file blob`` now supplies the text that is\n444\t# parsed; what is on disk is never consulted on this path.\n445\t#\n446\t# Two more round-2 corrections ride the same fold:\n447\t#\n448\t#   * P1-2 — the git subprocess is bounded by the REMAINING wall budget\n449\t#     (``_git_anchor_timeout``), exactly as the gpg spawn already is. A\n450\t#     5 s probe inside a 4 s budget lets the harness kill the process\n451\t#     before it emits the intended BLOCK, which is the zero-emit\n452\t#     fail-open this whole patch exists to remove.\n453\t#   * P1-3 — a fail-closed gate with no recovery route is a brick. The\n454\t#     anchor alone bricks the ONE use ADR-119 names for the unlock\n455\t#     (\"ceremony authoring where the .asc is being signed in parallel\"):\n456\t#     a freshly authored sentinel predates nothing. So the Owner may\n457\t#     instead PIN the sentinel's content hash\n458\t#     (``CEO_SENTINEL_UNLOCK_SHA256``, space/comma-separated for several).\n459\t#     It rests on the same trust primitive as the unlock itself — env a\n460\t#     sub-agent cannot set in the parent shell — and it is strictly\n461\t#     stronger than the anchor: it binds CONTENT, not a path. Reading the\n462\t#     value gains an attacker nothing (sha256 preimage), and it works in\n463\t#     a non-git tree, where the anchor cannot.\n464\t#\n465\t# ## RESIDUAL — read before ratifying\n466\t#\n467\t# The ANCHOR rail arms only when the project is a git work tree (``.git``\n468\t# present); otherwise no anchor proof exists and the legacy accept\n469\t# stands. Consequence: ``rm -rf .git`` disarms the anchor half. Named\n470\t# here rather than buried. The digest-pin half is unaffected by it — it\n471\t# is the git-free proof form the first draft said \"is a separate\n472\t# decision\", and this is that decision.\n473\t#\n474\t# DECIDED, not overlooked: in a NON-git tree a digest pin does not make\n475\t# the unpinned sentinels stricter — a pin-miss falls through to the\n476\t# residual accept there, exactly as it falls through to the anchor rail\n477\t# in a git tree. Making the pin authoritative in a non-git tree would\n478\t# mean \"pin one file, reject every other sentinel in the pack\" in the\n479\t# one tree shape that has no second proof form: the C3 self-DoS class,\n480\t# traded for a tightening that only bites where the legacy accept\n481\t# already applies.\n482\t#\n483\t# Landing this CHANGES a documented operator contract (ADR-119,\n484\t# SPEC/v1/sentinel-format.schema.md, docs/FAQ.md, the READMEs): an\n485\t# unlock window now needs a THIRD value. Those surfaces are updated in\n486\t# this same patch, and ``_unlock_trust_hint`` teaches both forms in the\n487\t# block reason itself — a required value that only exists in the diff is\n488\t# the lockout P1-3 named. Owner ratification: ADR-164-AMEND-1.\n489\t_SESSION_ANCHOR_ENV = \"CEO_SESSION_ANCHOR_SHA\"\n490\t_UNLOCK_DIGEST_ENV = \"CEO_SENTINEL_UNLOCK_SHA256\"\n491\t_ANCHOR_SHA_RE = re.compile(r\"^[0-9a-fA-F]{7,64}$\")\n492\t_SHA256_RE = re.compile(r\"^[0-9a-fA-F]{64}$\")\n493\t_GIT_ANCHOR_TIMEOUT_CAP_S = 5.0\n494\t# (repo_root, anchor, rel) -> anchored text, or None for \"proven absent\".\n495\t# A key is absent from the map when no VERDICT was reached (budget\n496\t# refusal, git fault) — errors are never memoized, same contract as\n497\t# ``_SIG_VERIFY_CACHE``.\n498\t_ANCHOR_BLOB_CACHE = {}  # type: Dict[tuple, Optional[str]]\n499\t\n500\t# Why the unlock rail refused, for the block reason. First refusal wins;\n501\t# reset per ``decide()`` call.\n502\t_UNLOCK_TRUST_DIAG = None  # type: Optional[str]\n503\t\n504\t\n505\t# Sentinel decision and audit functions are bound below.\n506\t\n507\t\n508\t# ---------------------------------------------------------------------------\n509\t# PLAN-163 T3.1 — session-roots write-guard (DirectoryAdded consumer)\n510\t# ---------------------------------------------------------------------------\n511\t# CC 2.1.220 ships `DirectoryAdded` as a NOTIFICATION-ONLY, POST-facto hook\n512\t# event: `decision: block` is structurally ignored, and by the time the\n513\t# event dispatches the permission/sandbox surface ALREADY includes the new\n514\t# directory (full reads+writes for the rest of the session). The observer\n515\t# half (`check_directory_added.py`, PLAN-163 T3.1 thread B1) records every\n516\t# added root into `.claude/state/session-roots.json`; THIS extension is the\n517\t# enforcement half: on the existing Edit|Write|MultiEdit PreToolUse guard,\n518\t# a write whose realpath resolves INSIDE a session-registered root that is\n519\t# not explicitly allowlisted is DENIED. Deliberately an EXTENSION of\n520\t# check_canonical_edit.py (the write-path guard already wired for this\n521\t# matcher family) — NOT a new hook file (ADR-183; hook-count contract\n522\t# T6.4: only the B1 observer + the Notification telemetry hook are new\n523\t# files).\n524\t#\n525\t# Registry schema (written by check_directory_added.py):\n526\t#     {\"schema\": 1,\n527\t#      \"sessions\": {<session_id>: {\"roots\": [\n528\t#          {\"directory\": <abs>, \"source\": <str>, \"ts\": <str>,\n529\t#           \"unparseable\": true?}, ...]}}}\n530\t#\n531\t# Failure contract (CLAUDE.md §4):\n532\t#   - Registry ABSENT → allow silently (the registry only exists if the\n533\t#     observer ran; absence is the normal no-DirectoryAdded state, not a\n534\t#     fault).\n535\t#   - Registry PRESENT but unparseable (corrupt JSON / unknown schema /\n536\t#     malformed `sessions`) → INPUT-parse failure of a security matcher,\n537\t#     NOT an ABSENT-file INFRA condition → fail-CLOSED for writes that\n538\t#     cannot be proven repo-internal (FXγ / C3, doctrine correction). The\n539\t#     deny is SCOPED to external writes — the new surface an added root\n540\t#     could have opened — while repo-internal writes stay governed by the\n541\t#     canonical stack above (unaffected). A stderr breadcrumb AND a\n542\t#     best-effort tamper audit event fire UNCONDITIONALLY (reason_code=\n543\t#     session_roots_registry_unreadable, on the already-registered\n544\t#     `veto_triggered` action) so corrupting/truncating the registry is both\n545\t#     BLOCKED (for the external write it opened) and HMAC-observable (H5).\n546\t#   - Root entry `unparseable: true` (or structurally malformed — a root\n547\t#     was recorded but its boundary is unknowable, INCLUDING a `directory`\n548\t#     that is not an ABSOLUTE path: a relative value would resolve against\n549\t#     the process CWD and silently mis-scope the boundary, M2) →\n550\t#     fail-CLOSED: every non-repo-internal write in that session is denied.\n551\t#   - Event carries NO session_id (absent/empty) while the registry holds\n552\t#     registered sessions → fail-CLOSED (M1): the write cannot be bound to\n553\t#     a session, yet roots exist, so the boundary is unknowable; external\n554\t#     writes are denied so that clearing CLAUDE_SESSION_ID cannot\n555\t#     neutralize the guard (CLAUDE.md §4).\n556\t#   - Tool-call path that cannot be canonicalized while the guard is\n557\t#     active → DENY (security-matcher input, fail-CLOSED).\n558\t#   - Candidates whose realpath resolves INSIDE the repo root are exempt:\n559\t#     they are governed by the canonical-guard stack above; this guard\n560\t#     scopes exclusively to the NEW write surface DirectoryAdded opened.\n561\t#     The realpath comparison makes the exemption symlink-safe (a repo\n562\t#     path symlinked out to a registered root still resolves external →\n563\t#     still gated).\n564\t#\n565\t# KNOWN RESIDUAL (documented, not closable here):\n566\t#   1. Roots granted via LAUNCH-time `--add-dir` never fire DirectoryAdded\n567\t#      (CC 2.1.220 registry blind spot), so they never reach the registry\n568\t#      and this guard cannot see them. Partial mitigation is the\n569\t#      SessionStart roots snapshot (T3.1 B1).\n570\t#   2. REGISTRY-REWRITE BYPASS (H5), NARROWED by FXγ. The registry\n571\t#      (.claude/state/session-roots.json) is repo-INTERNAL, so writes to it\n572\t#      are EXEMPT from this guard (repo-internal candidates are governed by\n573\t#      the canonical stack above, not here) AND it is agent-writable. FXγ\n574\t#      closes the CORRUPTION half of this bypass: corrupting/truncating the\n575\t#      registry no longer silently allows external writes — a\n576\t#      present-but-unparseable registry now fails CLOSED for them (above).\n577\t#      The residual that REMAINS is the EMPTY-but-VALID overwrite: writing\n578\t#      `{\"schema\":1,\"sessions\":{}}` parses cleanly and legitimately means\n579\t#      \"no registered sessions\" → allow, so an agent can still neutralize\n580\t#      the guard that way. (The corruption signal is deliberately reserved\n581\t#      for unparseable/unknown-schema; an empty valid registry is not\n582\t#      corruption.) This guard remains a BEST-EFFORT, confused/\n583\t#      non-adversarial-deputy control, NOT a hard security boundary: it\n584\t#      stops the accidental / notification-blind write that DirectoryAdded\n585\t#      opens (S283); it does not stop an adversary who rewrites the registry\n586\t#      to an empty-valid state. Even for that residual, mitigation is\n587\t#      OBSERVABILITY layered with prevention: the corrupt-registry path\n588\t#      emits a tamper audit event AND denies the external write, so a\n589\t#      corruption-based rewrite is both blocked and visible in the HMAC\n590\t#      audit chain. The read-path residual — read access under an added root\n591\t#      remains wholly undiscovered by this write-path guard — is unchanged.\n592\t#      Never sold as prevention. See ADR-183 §Residuals.\n593\t\n594\t_SESSION_ROOTS_SCHEMA = 1\n595\t_SESSION_ROOTS_ALLOW_ENV = \"CEO_SESSION_ROOTS_ALLOW\"\n596\t\n597\t\n598\t_SESSION_ROOTS_UNCANON_EMPTY = (\n599\t    \"SESSION-ROOTS-WRITE-BLOCKED: session_root_path_uncanonicalizable \"\n600\t    \"— a write-target path in this event is empty, not a string, or \"\n601\t    \"carries an embedded NUL while session-registered workspace \"\n602\t    \"roots are active; a path the guard cannot canonicalize cannot \"\n603\t    \"be proven outside the registered roots. Security-matcher \"\n604\t    \"input → fail-closed (CLAUDE.md §4; PLAN-163 T3.1 / ADR-183).\"\n605\t)\n606\t\n607\t\n608\t# Adapter/CLI/hook entry implementations (including _session_roots_guard) are bound below.\n609\t\n610\t\n611\t# Bind extracted implementations to this facade's globals. Existing callers can\n612\t# still patch dependencies here, and each import owns its caches and counters.\n613\t# PLAN162_FIX_3 PLAN162_FIX_4 PLAN162_FIX_5B PLAN162_FIX_7 PLAN162_FIX_9:\n614\t# guardfiles, scope containment, parse_error fail-closed, local file-URI\n615\t# normalization, and blocked_tool forensics live in canonical_edit/*.\n616\t_COMPONENT_IMPORT_ERROR = None\n617\t_COMPONENT_IMPORT_IS_INTEGRITY_FAILURE = False\n618\ttry:\n619\t    from _lib.canonical_edit import bind as _bind_canonical_edit\n620\t    _bind_canonical_edit(globals())\n621\t    del _bind_canonical_edit\n622\texcept Exception as _component_exc:  # partial install / infrastructure failure\n623\t    _COMPONENT_IMPORT_ERROR = type(_component_exc).__name__\n624\t    _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE = isinstance(_component_exc, ImportError)\n625\t\n626\t    def _emit_block(reason: str) -> str:\n627\t        return json.dumps({\"decision\": \"block\", \"reason\": reason})\n628\t\n629\t    def _emit_allow() -> str:\n630\t        return \"{}\"\n631\t\n632\t    def main() -> int:\n633\t        print(\"check_canonical_edit: component import unavailable (\" +\n634\t              str(_COMPONENT_IMPORT_ERROR) + \")\", file=sys.stderr)\n635\t        if _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE:\n636\t            print(_emit_block(\"CANONICAL-EDIT-BLOCKED: canonical_edit integrity \"\n637\t                              \"failure: component import unavailable.\"))\n638\t            return 0\n639\t        print(_emit_allow())\n640\t        return 0\n641\t\n642\t\n643\tif __name__ == \"__main__\":\n644\t    # PLAN-156-FOLLOWUP F5 — oracle CLI mode is gated on an EXPLICIT argv\n645\t    # sentinel so hook invocations (argv always empty: `_python-hook.sh`\n646\t    # execs `$FOUND_PY $HOOK_SCRIPT \"$@\"` with no extra args from\n647\t    # settings.json) can never reach it. Any other argv shape falls\n648\t    # through to the unchanged hook entry.\n649\t    if len(sys.argv) >= 2 and sys.argv[1] == \"--is-canonical\":\n650\t        sys.exit(_cli_is_canonical(sys.argv[2:]))\n651\t    sys.exit(main())\n652\t"}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"88c1e965-f137-4a30-ab04-a7cb21014cca","timestamp":"2026-11-13T18:02:16.619Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/check_canonical_edit.py","content":"#!/usr/bin/env python3\n\"\"\"PreToolUse hook: gate canonical-path edits on Owner-signed sentinel.\n\nSprint 5 Phase 7 (ADR-010). Blocks Edit / Write / MultiEdit calls\nagainst canonical governance paths unless an Owner-signed sentinel\nfile (`approved.md`) exists in the same Architect bundle directory\nwith a valid `Approved-By:` line and the target path declared in its\n`Scope:` block.\n\n## Wire-up\n\nRegistered in `.claude/settings.json` PreToolUse Edit/Write/MultiEdit:\n\n    {\n      \"matcher\": \"Edit|Write|MultiEdit\",\n      \"hooks\": [\n        {\n          \"type\": \"command\",\n          \"command\": \"bash \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\\\" check_canonical_edit.py\",\n          \"timeout\": 5,\n          \"statusMessage\": \"Checking canonical-path sentinel...\"\n        }\n      ]\n    }\n\n## Decision logic\n\n1. Parse `tool_input.file_path` from the payload.\n2. If path is NOT in the canonical guard list → allow silently.\n3. If path IS canonical:\n   a. Look for any sibling `.claude/plans/PLAN-NNN/architect/round-N/approved.md`\n      that lists this path under its `Scope:` block.\n   b. If sentinel exists + `Approved-By:` line valid → allow.\n   c. Otherwise → block with a clear reason.\n\n## Fail-open contract\n\nAny internal exception → allow. The hook never blocks the user on its\nown bug. (The canonical edit is allowed; the canonical path is still\ngoverned by CODEOWNERS / branch protection on the merge side.)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport json\nimport os\nimport hashlib  # PLAN-094 Wave C — sha256 in cache key\nimport re\nimport subprocess  # PLAN162_FIX_S2 — session-anchor proof via git\nimport sys\nimport time  # PLAN162_FIX_1 — per-invocation wall-clock budget\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Set, Tuple  # PLAN-094 Wave C\n\n# Make the local _lib importable\n_HOOKS_DIR = Path(__file__).resolve().parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\n# PLAN-045 Wave 1 P0-01 — GPG sentinel verification.\ntry:\n    from _lib import gpg_verify as _gpg_verify\nexcept Exception:  # pragma: no cover\n    _gpg_verify = None  # type: ignore[assignment]\n\n# PLAN-089 Wave C.4 — sentinel signer registry (ADR-121).\n# Behavior-preserving migration: if YAML registry resolves the signer\n# via _lib.sentinel_signers, that result wins; otherwise the legacy\n# `.claude/sentinel-signers.txt` allowlist is consulted (existing\n# PLAN-045 path). Both wires fail-CLOSED on import failure.\ntry:\n    from _lib import sentinel_signers as _sentinel_signers  # type: ignore[import]\nexcept Exception:  # pragma: no cover\n    _sentinel_signers = None  # type: ignore[assignment]\n\n_SENTINEL_SIGNERS_REGISTRY_YAML = (\n    Path(__file__).resolve().parent.parent.parent\n    / \".claude\" / \"security\" / \"sentinel-signers-registry.yaml\"\n)\n\n# PLAN-089 Wave C.4 — R2 Codex iter-1 Q5+Q7 fold: _BOOTSTRAP_REGISTRY_SHA256\n# pin per ADR-121 §5. Pre-GENESIS this is None and registry parse failure\n# falls back to legacy `.txt` (avoids Wave C.6 transition brick).\n# Post-GENESIS the Wave C.6 ceremony rotates this constant via KERNEL\n# HARD-DENY ceremony (CEO_KERNEL_OVERRIDE=PLAN-089-WAVE-C-SENTINEL-\n# ROTATION-GENESIS) to the SHA256 of the finalized YAML. When set:\n#   - Registry hash mismatch → fail-CLOSED (tamper-detect)\n#   - Registry parse failure → fail-CLOSED (post-GENESIS no-fallback)\n_BOOTSTRAP_REGISTRY_SHA256: Optional[str] = None  # placeholder pre-GENESIS\n\n# PLAN-045 Wave 1 P0-01 — signer allowlist for sentinel .asc signatures.\n_SENTINEL_SIGNERS_FILE = (\n    Path(__file__).resolve().parent.parent.parent\n    / \".claude\" / \"sentinel-signers.txt\"\n)\n\n\n# Canonical paths (relative to repo root) — ADR-010 v1.1 (Sprint 9\n# amendment adds conftest.py + new-hook + lessons-related scripts).\n# fnmatch.fnmatch is used; `*` is treated as a single segment matcher\n# below by walking the path components manually. `**` matches zero or\n# more segments (used for the Sprint 9 conftest entry).\n#\n# PLAN-019 Phase 2 Wave 2A (P1-SEC-A) expansion: full governance surface.\n# Every path listed here is sentinel-gated (editable via Owner-signed\n# sentinel). The arbitration-kernel subset (hook source files enforcing\n# THIS guard, _lib/policy.py, _lib/redact.py, _lib/audit_emit.py, and\n# .claude/policies/*.yaml) is ALSO covered by the stricter HARD-DENY\n# hook `check_arbitration_kernel.py` — that hook has no sentinel escape\n# and requires `CEO_KERNEL_OVERRIDE` with an audit-logged reason. The\n# overlap is intentional defense-in-depth: if the arbitration hook is\n# disabled by misconfiguration, this sentinel guard still blocks the\n# edits (and vice versa).\n# Canonical governance surfaces: `.claude/skills/**/SKILL.md` and\n# `.claude/commands/**` stay sentinel-guarded. These tokens are also the\n# command/skill-hook map generator's source-scanning contract.\ntry:\n    from _lib.canonical_edit import guards as _canonical_guard_definitions\n    for _guard_name in _canonical_guard_definitions.__all__:\n        globals()[_guard_name] = getattr(_canonical_guard_definitions, _guard_name)\n    del _guard_name, _canonical_guard_definitions\nexcept Exception:\n    _CANONICAL_GUARDS = []\n    _SKILL_CONTENT_RE = re.compile(r\"^$\")\n    _SKILL_LOADED_RE = re.compile(r\"^$\")\n    _VALID_BLOCKED_TOOLS = frozenset()\n\n# Set ONCE per invocation by ``main()`` from the parsed event, and reset\n# in its ``finally`` so a value can never leak into a later in-process\n# caller. Helpers deep in the call graph (``_emit_unlock_audit`` has no\n# event in scope) read it through ``_blocked_tool_field()``.\n_CURRENT_TOOL_NAME = \"\"\n\n\n# Blocked-tool validation and skill-content checks are bound below.\n\n\n# PLAN-025 F-perf-004 fast-path — precomputed set of top-level path\n# segments that every _CANONICAL_GUARDS entry starts with. Any path NOT\n# starting with one of these prefixes is non-canonical in O(1) without\n# running fnmatch 30+ times. Preserves semantics — every guard pattern\n# starts with one of these prefixes by construction.\n_CANONICAL_PREFIXES = frozenset({\n    \".claude\", \".github\", \"scripts\", \"SPEC\", \"PROTOCOL.md\",\n    # PLAN-155 Wave 3b (SENT-CX-E) — first-segment prefixes for the Codex\n    # kill-switch surface. Without these three the fast-path bail-out in\n    # `_is_canonical` returns False BEFORE the new `_CANONICAL_GUARDS`\n    # entries are ever consulted (the guard would be dead — the S254\n    # dead-gate class). Every kill-switch guard pattern starts with one of\n    # these by construction (`.codex/*`, `requirements.toml`, `AGENTS.md`).\n    \".codex\", \"requirements.toml\", \"AGENTS.md\",\n    # PLAN-156 Wave 3 (SENT-GK-E) — the same dead-guard class as `.codex`\n    # above, twice over (pair-rail R4 + R14). `_is_canonical()` bails out\n    # BEFORE any glob matching unless the path's first segment is in this\n    # set, so adding the `.grok/**` and `templates/settings/*` patterns to\n    # _CANONICAL_GUARDS without adding their first segments HERE would\n    # leave both guards INERT — unsentineled edits sailing straight through\n    # a list that LOOKS like it protects them. The S254 dead-gate class,\n    # and the reason this pair of edits can never be split across waves.\n    \".grok\", \"templates\",\n})\n\n\n# PLAN160_FIX_A / PLAN160_FIX_C / PLAN160_FIX_D — upper bound on candidates\n# classified per multi-candidate event, resolve-fault fail-closed in decide(),\n# and relative-path canonical resolution against repo_root.\n# event. Beyond this the event is fail-CLOSED (blocked) rather than risk an\n# unexamined canonical candidate riding through past a truncated scan. Real\n# apply_patch / MCP bulk events carry a handful of paths; this is a DoS-shape\n# backstop, not a normal-path limit.\n_PLAN160_MAX_CANDIDATES = 512\n\n\n# PLAN162_FIX_CASEFOLD (PLAN-162 consensus S1, P0 — BOTH rails).\n#\n# ``_match_segments`` matches with ``fnmatch.fnmatchcase`` (exact case)\n# and ``_CANONICAL_PREFIXES`` is an exact-case frozenset. On a\n# case-INSENSITIVE filesystem — APFS, the default on this repo's\n# platform — ``.claude/settings.JSON`` IS ``.claude/settings.json``, and\n# writing through the variant OVERWRITES the guarded file. Measured on\n# HEAD: `.claude/settings.JSON`, `.claude/hooks/_lib/audit_emit.PY` and\n# `.CLAUDE/settings.json` all classified NON-canonical AND non-kernel,\n# reaching files the threat model assumes unreachable.\n#\n# Both halves must fold or the guard only LOOKS fixed: the prefix\n# fast-path bails out in O(1) BEFORE any glob runs, so folding the glob\n# matcher alone would leave `.CLAUDE/...` inert — the dead-gate class\n# this file was already bitten by twice (the `.codex` and `.grok` prefix\n# omissions).\n#\n# ``str.lower`` — not ``str.casefold`` — deliberately: casefold expands\n# 'ß'→'ss', changing segment LENGTH and hence what a glob matches. The\n# exploited class is ASCII case variance, which ``lower()`` covers\n# exactly; identical inputs always fold identically, so the\n# normalization can only ADD matches (over-classify = the safe\n# direction), never remove one.\n#\n# Precomputed at import: the hot path pays one ``str.lower()`` per\n# classification instead of one per (segment x pattern).\n_CANONICAL_GUARDS_FOLDED = [pat.lower() for pat in _CANONICAL_GUARDS]\n_CANONICAL_PREFIXES_FOLDED = frozenset(\n    prefix.lower() for prefix in _CANONICAL_PREFIXES\n)\n\n\n# ---------------------------------------------------------------------------\n# PLAN162_FIX_2: depth-independent discovery now lives in canonical_edit.paths.\n# PLAN-094 Wave C — sentinel verification session cache (R-041)\n# ---------------------------------------------------------------------------\n# Module-scope ONLY (NEVER file-backed; PLAN-094 §3 Wave C C.1).\n# Process death = cache loss (eliminates R5 stale-cache-survives-crash).\n# Composite key — Codex iter-1 P0 fold: target_rel included so cache value\n# (grant decision dependent on target_rel) is correct on hit; sha256_full\n# transitively covers signer changes via .asc bytes (signer rotation\n# window risk acknowledged + accepted trade-off per design draft §8).\n\n_SENTINEL_CACHE_FORMAT_VERSION = 2  # bumped at iter-1 P0 fix (target_rel added)\n_SENTINEL_VERIFY_CACHE: Dict[\n    Tuple[str, int, int, int, str, str, int], bool\n] = {}\n_SENTINEL_CACHE_HITS = 0\n_SENTINEL_CACHE_MISSES = 0\n\n# PLAN162_FIX_1 (PLAN-162 findings #1 + #10, consensus C1 + C2 + C3 + S8).\n#\n# ## The defect (#1, re-diagnosed in debate: AMPLIFICATION, not latency)\n#\n# The cache above folds ``target_rel`` into its key, but\n# ``_gpg_verify.verify_detached`` never RECEIVES a target — signature\n# validity is target-INDEPENDENT. So the same sentinel was\n# cryptographically re-verified once per distinct target: a subprocess\n# count of O(candidates x sentinels). Measured in debate, gpg-agent\n# healthy: 1 GPG ~ 17 ms, but a 20-path ceremony pack cost **4.16 s of a\n# 5 s hook budget** with 0 cache hits and 320 misses (40 paths: 4.23 s).\n#\n# ## The fix — two caches, not one\n#\n#   * ``_SIG_VERIFY_CACHE`` — the SIGNATURE rail, keyed on the signing\n#     MATERIAL and NOT on the target. 320 subprocesses collapse to 16.\n#   * ``_GRANT_CACHE`` — the SCOPE rail, target-keyed and cheap. This is\n#     the SAME object as ``_SENTINEL_VERIFY_CACHE`` (an alias, not a\n#     copy): the PLAN-094 key shape and counters are pinned by\n#     ``test_sentinel_session_cache.py`` and stay byte-compatible.\n#\n# ## Why the signature rail must run FIRST (this is finding #10)\n#\n# #10 observed that the grant key hashes only ``approved.md``'s bytes, so\n# mutating the ``.asc`` / signer allowlist / ADR-121 registry left a\n# stale ``True`` riding the cache in-process. Rather than smuggle a\n# digest of three more files into a key shape other tests pin, the\n# signature rail is consulted BEFORE the grant fast-path and keys on\n# those bytes itself. A revocation in any of the three now invalidates\n# the decision even when ``approved.md`` is byte-identical — closing the\n# \"signer rotation window\" that PLAN-094 §8 had consciously accepted.\n_SIG_CACHE_FORMAT_VERSION = 1\n_SIG_VERIFY_CACHE: Dict[tuple, bool] = {}\n_GRANT_CACHE = _SENTINEL_VERIFY_CACHE  # alias — same dict object\n\n# ---------------------------------------------------------------------------\n# PLAN162_FIX_1 — per-invocation wall-clock budget (consensus C2 + C3 + S8)\n# ---------------------------------------------------------------------------\n# C2 REMOVED the sentinel cap from the design: ``_find_sentinels`` returns\n# SORTED, so the highest-numbered pack — the ceremony the Owner just\n# signed — is exactly the sentinel a cap would drop. Self-DoS with the\n# signature in hand, and it does not even fix a hung gpg (one hang costs\n# the full timeout at cap=1). What replaces it is a global wall-clock\n# deadline per INVOCATION, checked at the top of the sentinel loops.\n#\n# C3: the budget is a MODULE CONSTANT, never read from settings.json at\n# runtime — the budget lives in the file this hook guards (circular), and\n# parsing JSON on the hot path would worsen the very path being\n# optimized. Drift against the registered timeout is a STATIC test\n# instead (the shape verify-counts.sh already uses):\n# ``test_1_repro_wall_deadline_constant_has_slack_under_registration``.\n# 4.0 s under the registered 5 s leaves ~1 s to emit the decision.\n#\n# S8: the clock is an injectable module-level seam (``_now``). Without\n# it the red-first test's only options were a multi-second real sleep\n# (a documented flake class in this repo) or no deterministic coverage\n# of the slow path at all. This is a requirement OF the fix.\n#\n# ORDER IS NOT NEGOTIABLE (C3): the deadline and the cache partition ship\n# in the SAME patch under the SAME marker. A deadline without the\n# partition fires on the 4.16 s measured above and denies the ceremony\n# itself.\n_HOOK_WALL_BUDGET_S = 4.0\n_now = time.monotonic\n_WALL_DEADLINE_AT = None  # type: Optional[float]\n_WALL_BUDGET_EXHAUSTED = False\n\n\ndef _start_wall_budget() -> None:\n    \"\"\"Arm the per-invocation wall-clock deadline (called once by main).\"\"\"\n    global _WALL_DEADLINE_AT, _WALL_BUDGET_EXHAUSTED\n    _WALL_BUDGET_EXHAUSTED = False\n    _WALL_DEADLINE_AT = _now() + _HOOK_WALL_BUDGET_S\n\n\ndef _reset_wall_budget() -> None:\n    \"\"\"Disarm the deadline.\n\n    Called from ``main()``'s ``finally`` so a module-scope deadline can\n    never leak into a LATER in-process caller (the test suite drives\n    ``decide()`` directly in the same process; a stale expired deadline\n    would fail those closed for no reason).\n    \"\"\"\n    global _WALL_DEADLINE_AT, _WALL_BUDGET_EXHAUSTED\n    _WALL_DEADLINE_AT = None\n    _WALL_BUDGET_EXHAUSTED = False\n\n\ndef _mark_wall_budget_exhausted() -> None:\n    \"\"\"Latch the budget as spent (see ``_gpg_verify_timeout``).\n\n    Set when a signature verification is REFUSED for want of budget. The\n    clock has not necessarily elapsed yet, but the invocation can no\n    longer reach a verdict, so every subsequent poll must report expiry —\n    otherwise the loop runs to its end and the operator is handed the\n    generic \"declare this path in Scope\" block, which misdiagnoses a\n    budget fault as a missing sentinel and omits the recovery route.\n    \"\"\"\n    global _WALL_BUDGET_EXHAUSTED\n    _WALL_BUDGET_EXHAUSTED = True\n\n\ndef _wall_budget_expired() -> bool:\n    \"\"\"True once the armed invocation budget has elapsed (or is spent).\n\n    Disarmed (``None``) => never expired, so direct ``decide()`` callers\n    outside a hook invocation are unaffected.\n    \"\"\"\n    if _WALL_DEADLINE_AT is None:\n        return False\n    if _WALL_BUDGET_EXHAUSTED:\n        return True\n    return _now() > _WALL_DEADLINE_AT\n\n\n# ---------------------------------------------------------------------------\n# PLAN162_FIX_1 — the gpg subprocess is bounded by the REMAINING budget\n# ---------------------------------------------------------------------------\n# Codex pair-rail P1 (S292) against this patch, staged:\n#\n#   \"Bound GPG verification by the remaining hook budget. When gpg or\n#   gpg-agent stalls, this call can block for 15 seconds although the\n#   hook is registered for 5 seconds and the new internal deadline is 4\n#   seconds. Because the deadline is checked only between sentinel\n#   iterations, the harness can kill the process before it emits the\n#   intended fail-closed decision, recreating the silent fail-open that\n#   ADR-164-AMEND-1 §3 explicitly says the patch prevents.\"\n#\n# The deadline above is POLLED: read at the top of the sentinel loops, it\n# can only bound work that happens BETWEEN iterations. One\n# ``verify_detached`` at the library default (``timeout=15.0``,\n# ``_lib/gpg_verify.py``) is 3x the entire registration — the poll never\n# gets its turn, the harness kills a hook that has emitted NOTHING, and\n# \"no decision\" is indistinguishable from allow. ADR-164-AMEND-1 §3 D2\n# already states the intended behaviour (\"per-verify subprocess timeout\n# bounded by remaining budget\"); this is the code that makes the text\n# true.\n#\n# Two constants, both about EMITTING rather than about gpg:\n#\n#   * ``_GPG_EMIT_MARGIN_S`` — wall time reserved AFTER gpg returns so the\n#     rest of the decision plus the JSON emit still fit inside the\n#     internal deadline. A verification bounded to land exactly ON the\n#     deadline would merely have moved the kill.\n#   * ``_GPG_MIN_SPAWN_S`` — the floor below which spawning is pointless:\n#     a fork we cannot afford to wait out cannot tell \"bad signature\"\n#     from \"slow agent\", so it must not start at all.\n#\n# Their sum must stay well under ``_HOOK_WALL_BUDGET_S``, or the FIRST\n# sentinel of a fresh invocation could never be verified — self-DoS with\n# the Owner's signature in hand, the C3 class. Pinned by\n# ``test_control_gpg_bound_constants_leave_room_for_a_first_verify``.\n_GPG_VERIFY_TIMEOUT_CAP_S = 15.0  # the historical _lib.gpg_verify default\n_GPG_EMIT_MARGIN_S = 0.5\n_GPG_MIN_SPAWN_S = 0.5\n\n\ndef _gpg_verify_timeout() -> Optional[float]:\n    \"\"\"Subprocess timeout for ONE detached-signature verification.\n\n    ``None`` means DO NOT SPAWN — what is left of the invocation budget\n    cannot cover both a meaningful verification and the emit that has to\n    follow it. Callers translate that into the fail-CLOSED wall-deadline\n    block, never into an allow and never into a silent zero-emit.\n\n    With the budget disarmed (direct ``decide()`` callers, importers such\n    as ``check_pair_rail``) the historical cap is returned unchanged:\n    this narrows the hook-invocation path only.\n    \"\"\"\n    if _WALL_DEADLINE_AT is None:\n        return _GPG_VERIFY_TIMEOUT_CAP_S\n    usable = (_WALL_DEADLINE_AT - _now()) - _GPG_EMIT_MARGIN_S\n    if usable < _GPG_MIN_SPAWN_S:\n        return None\n    return min(_GPG_VERIFY_TIMEOUT_CAP_S, usable)\n\n\n_WALL_DEADLINE_BLOCK_REASON = (\n    \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — the hook's \"\n    \"per-invocation wall-clock budget ({0}s) elapsed before authorization \"\n    \"for this canonical path could be established. A security matcher that \"\n    \"cannot finish deciding does NOT allow (PLAN-045 F-01-07 posture; \"\n    \"PLAN-162 consensus C2). Recovery: re-issue the edit, or use the \"\n    \"documented CEO_SENTINEL_UNLOCK / CEO_KERNEL_OVERRIDE ceremony.\"\n).format(_HOOK_WALL_BUDGET_S)\n\n\n# ---------------------------------------------------------------------------\n# PLAN162_FIX_S2 — the sentinel SET is a trust anchor (consensus S2)\n# ---------------------------------------------------------------------------\n# ``.claude/plans/PLAN-*/**/approved.md`` is guarded by NEITHER rail, and\n# under an Owner ``CEO_SENTINEL_UNLOCK`` window the GPG rail is skipped\n# entirely — so an ``approved.md`` the AGENT writes mid-window GRANTS.\n# That is a bypass of AUTHORIZATION, not merely a DoS on the gate's cost.\n#\n# The first mitigation drafted for this (\"tracked in git OR pre-existing\")\n# was DEFEATED by the pair-rail in one command: inside the window the\n# agent writes the file and runs an ordinary ``git add``; ``ls-files\n# --error-unmatch`` then calls it TRACKED, and a HEAD-based check would\n# accept an agent-authored COMMIT just the same. **Git state is a\n# statement about the index, not about who authorized the file.**\n#\n# The trust anchor is therefore SESSION START: under ``env_override``,\n# accept only a sentinel that already existed in the tree at the commit\n# the Owner names in ``CEO_SESSION_ANCHOR_SHA``. The anchor is an ENV\n# var, which is exactly the same trust primitive the unlock itself rests\n# on (a sub-agent cannot set env in the parent shell) — so requiring it\n# adds no new assumption. No anchor => no proof => no grant.\n#\n# ## PLAN162_FIX_S2R2 — what the codex round-2 pair-rail corrected\n#\n# The first draft of this rail proved only that the sentinel PATH existed\n# at the anchor, then parsed the CURRENT bytes. Codex defeated it in one\n# move (P1-1): inside a legitimate window, take any pre-existing\n# unguarded ``approved.md``, keep its ``Approved-By:`` line, ADD a target\n# to ``Scope:`` — path-existence still holds, GPG is skipped, and the\n# hook authorizes off attacker-modified bytes. **A trust decision must be\n# made on the ANCHORED bytes, not on bytes that merely live at an\n# anchored path.** ``git cat-file blob`` now supplies the text that is\n# parsed; what is on disk is never consulted on this path.\n#\n# Two more round-2 corrections ride the same fold:\n#\n#   * P1-2 — the git subprocess is bounded by the REMAINING wall budget\n#     (``_git_anchor_timeout``), exactly as the gpg spawn already is. A\n#     5 s probe inside a 4 s budget lets the harness kill the process\n#     before it emits the intended BLOCK, which is the zero-emit\n#     fail-open this whole patch exists to remove.\n#   * P1-3 — a fail-closed gate with no recovery route is a brick. The\n#     anchor alone bricks the ONE use ADR-119 names for the unlock\n#     (\"ceremony authoring where the .asc is being signed in parallel\"):\n#     a freshly authored sentinel predates nothing. So the Owner may\n#     instead PIN the sentinel's content hash\n#     (``CEO_SENTINEL_UNLOCK_SHA256``, space/comma-separated for several).\n#     It rests on the same trust primitive as the unlock itself — env a\n#     sub-agent cannot set in the parent shell — and it is strictly\n#     stronger than the anchor: it binds CONTENT, not a path. Reading the\n#     value gains an attacker nothing (sha256 preimage), and it works in\n#     a non-git tree, where the anchor cannot.\n#\n# ## RESIDUAL — read before ratifying\n#\n# The ANCHOR rail arms only when the project is a git work tree (``.git``\n# present); otherwise no anchor proof exists and the legacy accept\n# stands. Consequence: ``rm -rf .git`` disarms the anchor half. Named\n# here rather than buried. The digest-pin half is unaffected by it — it\n# is the git-free proof form the first draft said \"is a separate\n# decision\", and this is that decision.\n#\n# DECIDED, not overlooked: in a NON-git tree a digest pin does not make\n# the unpinned sentinels stricter — a pin-miss falls through to the\n# residual accept there, exactly as it falls through to the anchor rail\n# in a git tree. Making the pin authoritative in a non-git tree would\n# mean \"pin one file, reject every other sentinel in the pack\" in the\n# one tree shape that has no second proof form: the C3 self-DoS class,\n# traded for a tightening that only bites where the legacy accept\n# already applies.\n#\n# Landing this CHANGES a documented operator contract (ADR-119,\n# SPEC/v1/sentinel-format.schema.md, docs/FAQ.md, the READMEs): an\n# unlock window now needs a THIRD value. Those surfaces are updated in\n# this same patch, and ``_unlock_trust_hint`` teaches both forms in the\n# block reason itself — a required value that only exists in the diff is\n# the lockout P1-3 named. Owner ratification: ADR-164-AMEND-1.\n_SESSION_ANCHOR_ENV = \"CEO_SESSION_ANCHOR_SHA\"\n_UNLOCK_DIGEST_ENV = \"CEO_SENTINEL_UNLOCK_SHA256\"\n_ANCHOR_SHA_RE = re.compile(r\"^[0-9a-fA-F]{7,64}$\")\n_SHA256_RE = re.compile(r\"^[0-9a-fA-F]{64}$\")\n_GIT_ANCHOR_TIMEOUT_CAP_S = 5.0\n# (repo_root, anchor, rel) -> anchored text, or None for \"proven absent\".\n# A key is absent from the map when no VERDICT was reached (budget\n# refusal, git fault) — errors are never memoized, same contract as\n# ``_SIG_VERIFY_CACHE``.\n_ANCHOR_BLOB_CACHE = {}  # type: Dict[tuple, Optional[str]]\n\n# Why the unlock rail refused, for the block reason. First refusal wins;\n# reset per ``decide()`` call.\n_UNLOCK_TRUST_DIAG = None  # type: Optional[str]\n\n\n# Sentinel decision and audit functions are bound below.\n\n\n# ---------------------------------------------------------------------------\n# PLAN-163 T3.1 — session-roots write-guard (DirectoryAdded consumer)\n# ---------------------------------------------------------------------------\n# CC 2.1.220 ships `DirectoryAdded` as a NOTIFICATION-ONLY, POST-facto hook\n# event: `decision: block` is structurally ignored, and by the time the\n# event dispatches the permission/sandbox surface ALREADY includes the new\n# directory (full reads+writes for the rest of the session). The observer\n# half (`check_directory_added.py`, PLAN-163 T3.1 thread B1) records every\n# added root into `.claude/state/session-roots.json`; THIS extension is the\n# enforcement half: on the existing Edit|Write|MultiEdit PreToolUse guard,\n# a write whose realpath resolves INSIDE a session-registered root that is\n# not explicitly allowlisted is DENIED. Deliberately an EXTENSION of\n# check_canonical_edit.py (the write-path guard already wired for this\n# matcher family) — NOT a new hook file (ADR-183; hook-count contract\n# T6.4: only the B1 observer + the Notification telemetry hook are new\n# files).\n#\n# Registry schema (written by check_directory_added.py):\n#     {\"schema\": 1,\n#      \"sessions\": {<session_id>: {\"roots\": [\n#          {\"directory\": <abs>, \"source\": <str>, \"ts\": <str>,\n#           \"unparseable\": true?}, ...]}}}\n#\n# Failure contract (CLAUDE.md §4):\n#   - Registry ABSENT → allow silently (the registry only exists if the\n#     observer ran; absence is the normal no-DirectoryAdded state, not a\n#     fault).\n#   - Registry PRESENT but unparseable (corrupt JSON / unknown schema /\n#     malformed `sessions`) → INPUT-parse failure of a security matcher,\n#     NOT an ABSENT-file INFRA condition → fail-CLOSED for writes that\n#     cannot be proven repo-internal (FXγ / C3, doctrine correction). The\n#     deny is SCOPED to external writes — the new surface an added root\n#     could have opened — while repo-internal writes stay governed by the\n#     canonical stack above (unaffected). A stderr breadcrumb AND a\n#     best-effort tamper audit event fire UNCONDITIONALLY (reason_code=\n#     session_roots_registry_unreadable, on the already-registered\n#     `veto_triggered` action) so corrupting/truncating the registry is both\n#     BLOCKED (for the external write it opened) and HMAC-observable (H5).\n#   - Root entry `unparseable: true` (or structurally malformed — a root\n#     was recorded but its boundary is unknowable, INCLUDING a `directory`\n#     that is not an ABSOLUTE path: a relative value would resolve against\n#     the process CWD and silently mis-scope the boundary, M2) →\n#     fail-CLOSED: every non-repo-internal write in that session is denied.\n#   - Event carries NO session_id (absent/empty) while the registry holds\n#     registered sessions → fail-CLOSED (M1): the write cannot be bound to\n#     a session, yet roots exist, so the boundary is unknowable; external\n#     writes are denied so that clearing CLAUDE_SESSION_ID cannot\n#     neutralize the guard (CLAUDE.md §4).\n#   - Tool-call path that cannot be canonicalized while the guard is\n#     active → DENY (security-matcher input, fail-CLOSED).\n#   - Candidates whose realpath resolves INSIDE the repo root are exempt:\n#     they are governed by the canonical-guard stack above; this guard\n#     scopes exclusively to the NEW write surface DirectoryAdded opened.\n#     The realpath comparison makes the exemption symlink-safe (a repo\n#     path symlinked out to a registered root still resolves external →\n#     still gated).\n#\n# KNOWN RESIDUAL (documented, not closable here):\n#   1. Roots granted via LAUNCH-time `--add-dir` never fire DirectoryAdded\n#      (CC 2.1.220 registry blind spot), so they never reach the registry\n#      and this guard cannot see them. Partial mitigation is the\n#      SessionStart roots snapshot (T3.1 B1).\n#   2. REGISTRY-REWRITE BYPASS (H5), NARROWED by FXγ. The registry\n#      (.claude/state/session-roots.json) is repo-INTERNAL, so writes to it\n#      are EXEMPT from this guard (repo-internal candidates are governed by\n#      the canonical stack above, not here) AND it is agent-writable. FXγ\n#      closes the CORRUPTION half of this bypass: corrupting/truncating the\n#      registry no longer silently allows external writes — a\n#      present-but-unparseable registry now fails CLOSED for them (above).\n#      The residual that REMAINS is the EMPTY-but-VALID overwrite: writing\n#      `{\"schema\":1,\"sessions\":{}}` parses cleanly and legitimately means\n#      \"no registered sessions\" → allow, so an agent can still neutralize\n#      the guard that way. (The corruption signal is deliberately reserved\n#      for unparseable/unknown-schema; an empty valid registry is not\n#      corruption.) This guard remains a BEST-EFFORT, confused/\n#      non-adversarial-deputy control, NOT a hard security boundary: it\n#      stops the accidental / notification-blind write that DirectoryAdded\n#      opens (S283); it does not stop an adversary who rewrites the registry\n#      to an empty-valid state. Even for that residual, mitigation is\n#      OBSERVABILITY layered with prevention: the corrupt-registry path\n#      emits a tamper audit event AND denies the external write, so a\n#      corruption-based rewrite is both blocked and visible in the HMAC\n#      audit chain. The read-path residual — read access under an added root\n#      remains wholly undiscovered by this write-path guard — is unchanged.\n#      Never sold as prevention. See ADR-183 §Residuals.\n\n_SESSION_ROOTS_SCHEMA = 1\n_SESSION_ROOTS_ALLOW_ENV = \"CEO_SESSION_ROOTS_ALLOW\"\n\n\n_SESSION_ROOTS_UNCANON_EMPTY = (\n    \"SESSION-ROOTS-WRITE-BLOCKED: session_root_path_uncanonicalizable \"\n    \"— a write-target path in this event is empty, not a string, or \"\n    \"carries an embedded NUL while session-registered workspace \"\n    \"roots are active; a path the guard cannot canonicalize cannot \"\n    \"be proven outside the registered roots. Security-matcher \"\n    \"input → fail-closed (CLAUDE.md §4; PLAN-163 T3.1 / ADR-183).\"\n)\n\n\n# Adapter/CLI/hook entry implementations (including _session_roots_guard) are bound below.\n\n\n# Bind extracted implementations to this facade's globals. Existing callers can\n# still patch dependencies here, and each import owns its caches and counters.\n# PLAN162_FIX_3 PLAN162_FIX_4 PLAN162_FIX_5B PLAN162_FIX_7 PLAN162_FIX_9:\n# guardfiles, scope containment, parse_error fail-closed, local file-URI\n# normalization, and blocked_tool forensics live in canonical_edit/*.\n_COMPONENT_IMPORT_ERROR = None\n_COMPONENT_IMPORT_IS_INTEGRITY_FAILURE = False\ntry:\n    from _lib.canonical_edit import bind as _bind_canonical_edit\n    _bind_canonical_edit(globals())\n    del _bind_canonical_edit\nexcept Exception as _component_exc:  # partial install / infrastructure failure\n    _COMPONENT_IMPORT_ERROR = type(_component_exc).__name__\n    _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE = isinstance(_component_exc, ImportError)\n\n    def _emit_block(reason: str) -> str:\n        return json.dumps({\"decision\": \"block\", \"reason\": reason})\n\n    def _emit_allow() -> str:\n        return \"{}\"\n\n    def main() -> int:\n        print(\"check_canonical_edit: component import unavailable (\" +\n              str(_COMPONENT_IMPORT_ERROR) + \")\", file=sys.stderr)\n        if _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE:\n            print(_emit_block(\"CANONICAL-EDIT-BLOCKED: canonical_edit integrity \"\n                              \"failure: component import unavailable.\"))\n            return 0\n        print(_emit_allow())\n        return 0\n\n\nif __name__ == \"__main__\":\n    # PLAN-156-FOLLOWUP F5 — oracle CLI mode is gated on an EXPLICIT argv\n    # sentinel so hook invocations (argv always empty: `_python-hook.sh`\n    # execs `$FOUND_PY $HOOK_SCRIPT \"$@\"` with no extra args from\n    # settings.json) can never reach it. Any other argv shape falls\n    # through to the unchanged hook entry.\n    if len(sys.argv) >= 2 and sys.argv[1] == \"--is-canonical\":\n        sys.exit(_cli_is_canonical(sys.argv[2:]))\n    sys.exit(main())\n","numLines":652,"startLine":1,"totalLines":652}},"tool_result_meta":[{"id":"toolu_01PGuBF3FmUV4TZCUqV1vwSj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
