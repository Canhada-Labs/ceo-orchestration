{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NCrJDuqo5eUxXBXJgx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MAXwJa7L9wPuTypvc6eAMX","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/entry.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11590,"cache_read_input_tokens":82305,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11590},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"1a25b33e-6870-46ec-b288-3ce1bd2176a7","timestamp":"2026-11-13T18:02:34.717Z","request_id":"req_011Ch1NCr2bnzMtZ68eESRLa","wire_tool_inputs":{"toolu_01MAXwJa7L9wPuTypvc6eAMX":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/entry.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MAXwJa7L9wPuTypvc6eAMX","type":"tool_result","content":"1\t\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _emit_legacy_decision_json(out: str, adapter, event=None) -> None:\n5\t    \"\"\"Emit a pre-built legacy (Claude-shaped) decision JSON string through\n6\t    the resolved host adapter (PLAN-155 Wave 1 dispatch seam, debate A1).\n7\t\n8\t    ``decide()`` returns pre-built JSON strings for the legacy contract.\n9\t    Under the default/claude adapter the string is written RAW + newline —\n10\t    byte-identical to the pre-seam hook. Under any other host adapter the\n11\t    string is parsed back into a neutral ``Decision`` and re-emitted via\n12\t    the adapter's ``emit_decision`` WITH the parsed NormalizedEvent\n13\t    (host egress shape is EXPLICIT-only: a host-wire event stamps\n14\t    ``raw_payload['ceo_host_wire']`` and the codex adapter emits\n15\t    ``hookSpecificOutput.permissionDecision``), so a deny reaches the\n16\t    host in the shape its wire enforces (a raw Claude-shaped line is\n17\t    foreign JSON on the codex wire → silent fail-open → the S254\n18\t    dead-gate class).\n19\t    \"\"\"\n20\t    adapter_basename = (getattr(adapter, \"__name__\", \"\") or \"\").rsplit(\".\", 1)[-1]\n21\t    if adapter_basename == \"claude\":\n22\t        sys.stdout.write(out + \"\\n\")\n23\t        return\n24\t    from _lib import contract as _contract  # noqa: PLC0415\n25\t    parsed = json.loads(out)\n26\t    adapter.emit_decision(\n27\t        _contract.Decision(\n28\t            allow=(parsed.get(\"decision\") != \"block\"),\n29\t            reason=parsed.get(\"reason\"),\n30\t            system_message=parsed.get(\"systemMessage\"),\n31\t            message=parsed.get(\"message\"),\n32\t        ),\n33\t        event=event,\n34\t    )\n35\t\n36\t\n37\tdef _adapter_emit(adapter, decision, event=None) -> None:\n38\t    \"\"\"Emit a neutral ``Decision`` through the resolved host adapter.\n39\t\n40\t    Claude path: the historical two-arg call — byte-identical output\n41\t    (``claude.py:emit_decision`` does not take ``event=``). Any other\n42\t    resolved adapter (codex host mode, ``_FailClosedAdapter``) receives\n43\t    the parsed NormalizedEvent so the egress shape follows the wire that\n44\t    produced it and the debate-A2 coherence override can fire.\n45\t    \"\"\"\n46\t    adapter_basename = (getattr(adapter, \"__name__\", \"\") or \"\").rsplit(\".\", 1)[-1]\n47\t    if adapter_basename == \"claude\":\n48\t        adapter.emit_decision(decision)\n49\t        return\n50\t    adapter.emit_decision(decision, event=event)\n51\t\n52\t\n53\tdef _cli_is_canonical(args: List[str]) -> int:\n54\t    \"\"\"PLAN-156-FOLLOWUP F5 (debate C2(b)) — read-only canonical-path\n55\t    classification ORACLE.\n56\t\n57\t    Single-source-of-truth CLI so shell consumers (the grok/codex pre-push\n58\t    review gates) classify paths with the SAME ``_is_canonical`` predicate\n59\t    the edit-time guard and the Stop-review recorder use — re-implementing\n60\t    the guard glob list in bash IS the drift class F5 fixes.\n61\t\n62\t    Usage:\n63\t        python3 check_canonical_edit.py --is-canonical <path>...\n64\t        python3 check_canonical_edit.py --is-canonical -   # paths on stdin,\n65\t                                                           # one per line\n66\t                                                           # (ARG_MAX-safe)\n67\t\n68\t    Output: one line per input path, ``<path>\\\\t<0|1>`` (1 = canonical),\n69\t    in input order. Exit 0 on successful classification of every path.\n70\t    Exit 2 when no path argument/stdin is supplied (consumers must treat\n71\t    ANY nonzero exit as oracle failure and fall back fail-CLOSED to their\n72\t    coarse over-triggering classifier).\n73\t\n74\t    Contract notes:\n75\t    - Pure read-only classification. NO hook semantics run in this mode:\n76\t      no event parse, no adapter, no sentinel lookup, no emission on the\n77\t      hook wire. The hook entry (``main()``) is byte-identical when the\n78\t      script is invoked as a hook (argv empty — ``_python-hook.sh`` passes\n79\t      no arguments).\n80\t    - Repo root resolves exactly like the hook path does\n81\t      (``CLAUDE_PROJECT_DIR`` or cwd — see ``main()``), so oracle and hook\n82\t      can never disagree on anchoring.\n83\t    - Per-path classification fault → that path is reported ``1``\n84\t      (canonical). Over-triggering review on an unclassifiable path is the\n85\t      safe direction (fail-CLOSED); under-triggering would let an\n86\t      unreviewed L3 touch through. ``_is_canonical`` itself already\n87\t      returns False for paths outside the repo root — that is the\n88\t      oracle's own semantics, not a fault.\n89\t    \"\"\"\n90\t    repo_root = Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n91\t    paths: List[str] = list(args)\n92\t    if paths == [\"-\"]:\n93\t        paths = [ln.rstrip(\"\\n\") for ln in sys.stdin.read().splitlines()]\n94\t        paths = [p for p in paths if p]\n95\t    if not paths:\n96\t        sys.stderr.write(\n97\t            \"usage: check_canonical_edit.py --is-canonical <path>... | -\\n\"\n98\t        )\n99\t        return 2\n100\t    out_lines: List[str] = []\n101\t    for raw in paths:\n102\t        try:\n103\t            flag = 1 if _is_canonical(raw, repo_root) else 0\n104\t        except Exception:\n105\t            # Fail-CLOSED per path: unclassifiable → treat as canonical\n106\t            # (over-trigger review, never under-trigger).\n107\t            flag = 1\n108\t        out_lines.append(\"%s\\t%d\" % (raw, flag))\n109\t    sys.stdout.write(\"\\n\".join(out_lines) + \"\\n\")\n110\t    return 0\n111\t\n112\t\n113\tdef main() -> int:\n114\t    \"\"\"Hook entry point.\n115\t\n116\t    PLAN162_FIX_1 / PLAN162_FIX_9 wrapper: arms the per-invocation\n117\t    wall-clock deadline (consensus C2/C3/S8) around the real entry point\n118\t    and clears BOTH pieces of invocation-scoped module state in a\n119\t    ``finally``. Without the reset, a module-scope deadline (or a stale\n120\t    tool name) armed by one in-process invocation would leak into the\n121\t    next caller in the same process — the test suite drives ``decide()``\n122\t    and ``main()`` in-process, and an expired leftover deadline would\n123\t    fail those closed for no reason at all.\n124\t    \"\"\"\n125\t    global _CURRENT_TOOL_NAME\n126\t    if _COMPONENT_IMPORT_ERROR is not None:\n127\t        print(\"check_canonical_edit: component import unavailable (\" +\n128\t              _COMPONENT_IMPORT_ERROR + \")\", file=sys.stderr)\n129\t        if _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE:\n130\t            print(_emit_block(\"CANONICAL-EDIT-BLOCKED: canonical_edit integrity \"\n131\t                              \"failure: component import unavailable.\"))\n132\t            return 0\n133\t        print(_emit_allow())\n134\t        return 0\n135\t    _start_wall_budget()\n136\t    try:\n137\t        return _main_guarded()\n138\t    finally:\n139\t        _reset_wall_budget()\n140\t        _CURRENT_TOOL_NAME = \"\"\n141\t\n142\t\n143\tdef _main_guarded() -> int:\n144\t    \"\"\"Hook entry point.\n145\t\n146\t    PLAN-006 Phase 1 migration (ADR-014): uses Adapter Layer\n147\t    `read_event()` / `emit_decision()`. Byte-identical output.\n148\t\n149\t    PLAN-155 Wave 1 (debate A1, ratified seam option b): the adapter is\n150\t    resolved ONCE per invocation through the shared seam\n151\t    ``_lib.adapters.resolve()``. Under ``CEO_HOOK_ADAPTER`` unset/\"claude\"\n152\t    the seam returns the claude adapter module and every downstream byte\n153\t    is identical to the pre-seam hook (the regression bar). The debate-A2\n154\t    coherence gate (explicitly-set-but-unresolvable ``CEO_HOOK_ADAPTER``\n155\t    → INPUT class per PLAN-152 C4) lives INSIDE ``resolve()``, which\n156\t    fails CLOSED by returning a ``_FailClosedAdapter`` whose egress\n157\t    ALWAYS denies in BOTH harness vocabularies (top-level\n158\t    ``decision: block`` + ``hookSpecificOutput.permissionDecision:\n159\t    deny``) with a stderr + audit breadcrumb — never a silent fallback\n160\t    to the claude adapter. Non-claude adapters additionally receive the\n161\t    parsed event at egress (``_adapter_emit``) so the host wire shape\n162\t    and the coherence override are event-driven, never latched.\n163\t    \"\"\"\n164\t    from _lib import adapters as _adapters  # noqa: E402\n165\t    from _lib import contract as _contract  # noqa: E402\n166\t\n167\t    _adapter = _adapters.resolve()\n168\t\n169\t    try:\n170\t        event = _adapter.read_event(phase=\"PreToolUse\")\n171\t    except Exception:\n172\t        _adapter.emit_decision(_contract.allow())\n173\t        return 0\n174\t\n175\t    if event.parse_error:\n176\t        # PLAN162_FIX_5B (finding #5b, consensus C4). HEAD emitted a bare\n177\t        # ALLOW here. ``parse_error`` is, by name and by construction, the\n178\t        # signal that the PAYLOAD did not parse — INPUT, not\n179\t        # infrastructure — and CLAUDE.md §4 is literal about that split:\n180\t        # fail-open on INFRASTRUCTURE, fail-CLOSED on INPUT. The sibling\n181\t        # kernel hook already implements this exact form; THIS hook was\n182\t        # the drift.\n183\t        #\n184\t        # The council justified the old posture by citing \"the ADR-010\n185\t        # fail-open contract\". That citation is FALSE: ADR-010 contains\n186\t        # zero occurrences of any failure-posture text. The only such text\n187\t        # is this hook's own module docstring, so citing it as the ADR\n188\t        # that authorizes it is circular.\n189\t        #\n190\t        # 5a (``read_event`` RAISING, above) stays fail-OPEN — that IS a\n191\t        # genuine infrastructure failure, and the kernel sibling is\n192\t        # fail-open identically there.\n193\t        _emit_legacy_decision_json(\n194\t            _emit_block(\n195\t                reason=(\n196\t                    \"CANONICAL-EDIT-BLOCKED: canonical_edit_payload_parse_error \"\n197\t                    \"— the PreToolUse payload could not be parsed, so this \"\n198\t                    \"edit-class event cannot be proven non-canonical. \"\n199\t                    \"Security-matcher INPUT failure → fail-closed \"\n200\t                    \"(CLAUDE.md §4; PLAN-162 finding #5b). Re-issue the tool \"\n201\t                    \"call with a well-formed payload.\"\n202\t                )\n203\t            ),\n204\t            _adapter,\n205\t            event,\n206\t        )\n207\t        return 0\n208\t\n209\t    # PLAN-065 Layer A (S81-tris gap closure, 2026-05-04):\n210\t    # When tool_name is mcp__*, the adapter's `event.file_path` field\n211\t    # may be empty (custom MCP tools don't use the standard\n212\t    # Edit/Write/MultiEdit `file_path` key). Inspect tool_input directly\n213\t    # for write-shape parameters and resolve all candidate paths.\n214\t    # Each candidate is gated independently; if ANY candidate is\n215\t    # canonical without sentinel coverage, block.\n216\t    tool_name = (event.tool_name or \"\").strip()\n217\t    # PLAN162_FIX_9 — publish the EVENT's tool name (validated at read\n218\t    # time, not here) for the four audit sites that record ``blocked_tool``.\n219\t    global _CURRENT_TOOL_NAME\n220\t    _CURRENT_TOOL_NAME = tool_name\n221\t    candidate_paths: List[str] = []\n222\t    if event.file_path:\n223\t        candidate_paths.append(event.file_path)\n224\t    if tool_name.startswith(\"mcp__\"):\n225\t        candidate_paths.extend(\n226\t            _extract_mcp_target_paths(event.tool_input or {})\n227\t        )\n228\t    # PLAN-155 Wave 1 (S265 pair-rail P1#3): a codex apply_patch can touch\n229\t    # MULTIPLE files; the host adapter surfaces every path (incl. rename\n230\t    # targets) as tool_input['apply_patch_paths']. Gate them ALL — a\n231\t    # benign first op must not smuggle a later op into a guarded path.\n232\t    # Absent under Claude Code (key never present → byte-identical).\n233\t    if isinstance(event.tool_input, dict):\n234\t        for _pp in event.tool_input.get(\"apply_patch_paths\") or []:\n235\t            if isinstance(_pp, str) and _pp and _pp not in candidate_paths:\n236\t                candidate_paths.append(_pp)\n237\t\n238\t    if not candidate_paths:\n239\t        _adapter_emit(_adapter, _contract.allow(), event)\n240\t        return 0\n241\t\n242\t    # Use the first canonical path for legacy file_path-keyed downstream\n243\t    # logic, but iterate all candidates for canonical detection.\n244\t    file_path = candidate_paths[0]\n245\t\n246\t    repo_root = Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n247\t\n248\t    # Layer A: gate a multi-candidate event using the MOST RESTRICTIVE\n249\t    # canonical candidate. Historically mcp__*-only; PLAN-155 extends the\n250\t    # scan to any multi-candidate event (apply_patch multi-file, S265\n251\t    # P1#3). Single-candidate events (every Claude Code Edit/Write) skip\n252\t    # this block entirely — byte-identical fast path.\n253\t    #\n254\t    # PLAN160_FIX_A (finding A — multi-candidate gate bypass): the prior\n255\t    # loop ``break``-ed at the FIRST canonical candidate and gated ONLY\n256\t    # that path via decide(). A multi-file MCP event whose first canonical\n257\t    # candidate was sentinel-GRANTED let every LATER canonical candidate\n258\t    # ride through UNGATED. The fix scans ALL candidates and selects the\n259\t    # OFFENDING candidate (canonical + ungranted) if any —\n260\t    # most-restrictive-wins — so decide() is still invoked at most ONCE\n261\t    # (emit-once: decide() fires _emit_persona_coverage_synthesized on the\n262\t    # allow path; a per-candidate decide() would double-emit).\n263\t    #\n264\t    # ``_forced_out``: a pre-built decision that BYPASSES decide(). Set for\n265\t    # the two fail-CLOSED cases that must NOT be re-routed through decide()\n266\t    # — over-cap, and any scan fault (classification OR sentinel discovery).\n267\t    # Routing a classification-fault candidate through decide() would\n268\t    # re-raise inside decide(), and the outer handler below would then\n269\t    # fail-classify it as non-canonical and ALLOW (the V-A hole the codex\n270\t    # pair-rail REJECTed). ``_find_sentinels`` is loaded LAZILY, only once a\n271\t    # canonical candidate is seen, and the whole scan is wrapped so a\n272\t    # sentinel-discovery fault fail-CLOSES with an emit instead of\n273\t    # propagating out of main() (zero-emit hole).\n274\t    _multi = tool_name.startswith(\"mcp__\") or len(candidate_paths) > 1\n275\t    _forced_out = None\n276\t    if _multi:\n277\t        try:\n278\t            if len(candidate_paths) > _PLAN160_MAX_CANDIDATES:\n279\t                # Fail-CLOSED: more candidates than we will classify —\n280\t                # cannot prove every canonical candidate is granted, so\n281\t                # block the whole event rather than truncate the scan and\n282\t                # risk an unexamined offender beyond the cap.\n283\t                _forced_out = _emit_block(\n284\t                    reason=(\n285\t                        \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — \"\n286\t                        f\"multi-candidate event carries {len(candidate_paths)} \"\n287\t                        f\"paths (> cap {_PLAN160_MAX_CANDIDATES}); cannot clear \"\n288\t                        \"all — fail-closed. PLAN-160 finding A.\"\n289\t                    )\n290\t                )\n291\t            else:\n292\t                sentinels = None  # lazy: only load once a canonical candidate exists\n293\t                first_canonical = None\n294\t                offender = None\n295\t                for candidate in candidate_paths:\n296\t                    # PLAN162_FIX_1 (C2) — the second sentinel-loop site.\n297\t                    # Fail-CLOSED on an elapsed budget: a multi-candidate\n298\t                    # event we could not finish clearing is exactly the\n299\t                    # event that must not ride through.\n300\t                    if _wall_budget_expired():\n301\t                        _forced_out = _emit_block(\n302\t                            reason=_WALL_DEADLINE_BLOCK_REASON\n303\t                        )\n304\t                        break\n305\t                    if not _is_canonical(candidate, repo_root):\n306\t                        continue\n307\t                    if first_canonical is None:\n308\t                        first_canonical = candidate\n309\t                    if sentinels is None:\n310\t                        sentinels = _find_sentinels(repo_root)\n311\t                    if not _candidate_is_granted(candidate, repo_root, sentinels):\n312\t                        offender = candidate\n313\t                        break\n314\t                # decide() runs ONCE: on the offender (→ block naming it) if\n315\t                # any, else the first canonical candidate (→ sentinel allow +\n316\t                # persona coverage), else candidate_paths[0] (non-canonical →\n317\t                # allow).\n318\t                file_path = offender or first_canonical or file_path\n319\t        except Exception as _scan_exc:\n320\t            # Classification OR sentinel-discovery fault on a MULTI-candidate\n321\t            # event → fail-CLOSED with an emit. We are on a multi-file event\n322\t            # we could not fully clear; a re-route through decide() would\n323\t            # re-raise on the unclassifiable path and the outer handler would\n324\t            # ALLOW it (V-A). Blocking here is the only safe outcome.\n325\t            print(\n326\t                f\"[check_canonical_edit] SCAN FAULT: \"\n327\t                f\"{type(_scan_exc).__name__}: {_scan_exc}\",\n328\t                file=sys.stderr,\n329\t            )\n330\t            _forced_out = _emit_block(\n331\t                reason=(\n332\t                    \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — \"\n333\t                    f\"multi-candidate scan fault ({type(_scan_exc).__name__}); \"\n334\t                    \"fail-closed. PLAN-160 finding A.\"\n335\t                )\n336\t            )\n337\t\n338\t    if _forced_out is not None:\n339\t        # Pre-built fail-closed decision (over-cap or scan fault). Emit\n340\t        # through the same legacy seam + best-effort veto audit as a normal\n341\t        # block, BYPASSING decide() — routing a scan-fault path through\n342\t        # decide() would re-raise and the outer handler would fail-OPEN\n343\t        # (the V-A hole the codex pair-rail REJECTed).\n344\t        _fparsed = json.loads(_forced_out)\n345\t        if _fparsed.get(\"decision\") == \"block\":\n346\t            # Forensic breadcrumb only. On over-cap / scan-fault the specific\n347\t            # offending candidate is unknown or unreachable, so we record the\n348\t            # event's FIRST candidate (not necessarily the offender); the\n349\t            # fail-CLOSED decision itself is correct regardless.\n350\t            _audit_block(\n351\t                candidate_paths[0] if candidate_paths else file_path,\n352\t                _safe_sentinel_count(repo_root),\n353\t                reason_code=_block_reason_code(_fparsed.get(\"reason\", \"\")),\n354\t            )\n355\t        _emit_legacy_decision_json(_forced_out, _adapter, event)\n356\t        return 0\n357\t\n358\t    # Single-candidate hot path (and the all-canonical-granted multi path)\n359\t    # reaches decide() here. SECURITY INVARIANT: this call is NOT wrapped by\n360\t    # the multi-candidate fail-CLOSED scan above, so its safety relies on\n361\t    # ``_is_canonical`` / ``_repo_rels`` being TOTAL (never raising on str\n362\t    # input — guaranteed by their broad ``except Exception``, PLAN160_FIX_D,\n363\t    # and fenced by the totality unit tests). If a future refactor\n364\t    # reintroduces a raise in classification, the outer handler below\n365\t    # re-classifies and could fail-OPEN a single-candidate canonical edit —\n366\t    # keep the totality tests as the regression fence.\n367\t    try:\n368\t        out = decide(file_path=file_path, repo_root=repo_root)\n369\t    except Exception as e:\n370\t        # PLAN-045 Wave 1 F-01-07: fail-CLOSED for canonical paths.\n371\t        # Previously any exception fell through to allow; now an edit\n372\t        # targeting a confirmed canonical path blocks with\n373\t        # ``canonical_edit_hook_fault``. Non-canonical edits keep the\n374\t        # fail-open contract so a hook bug doesn't brick the session\n375\t        # on benign writes.\n376\t        print(\n377\t            f\"[check_canonical_edit] FATAL: {type(e).__name__}: {e}\",\n378\t            file=sys.stderr,\n379\t        )\n380\t        try:\n381\t            is_canonical = _is_canonical(file_path, repo_root)\n382\t        except Exception:\n383\t            is_canonical = False\n384\t        if is_canonical:\n385\t            _emit_legacy_decision_json(\n386\t                _emit_block(\n387\t                    reason=(\n388\t                        \"CANONICAL-EDIT-BLOCKED: hook fault on canonical \"\n389\t                        f\"path; {type(e).__name__}: {e}. PLAN-045 F-01-07.\"\n390\t                    )\n391\t                ),\n392\t                _adapter,\n393\t                event,\n394\t            )\n395\t            return 0\n396\t        _adapter_emit(_adapter, _contract.allow(), event)\n397\t        return 0\n398\t\n399\t    # On block, emit veto event (best-effort)\n400\t    parsed = json.loads(out)\n401\t    if parsed.get(\"decision\") == \"block\":\n402\t        try:\n403\t            rel = str(Path(file_path).resolve().relative_to(repo_root.resolve())).replace(os.sep, \"/\")\n404\t        except Exception:\n405\t            rel = file_path\n406\t        _audit_block(\n407\t            rel,\n408\t            _safe_sentinel_count(repo_root),\n409\t            reason_code=_block_reason_code(parsed.get(\"reason\", \"\")),\n410\t        )\n411\t\n412\t    # PLAN-163 T3.1 — session-roots write-guard (DirectoryAdded consumer).\n413\t    # Runs AFTER the existing project-relative checks and ONLY on a\n414\t    # would-allow event, so it never relaxes the sentinel gate — it can\n415\t    # only ADD a deny. Checks EVERY candidate path of the event (the\n416\t    # multi-candidate list built above), by absolute realpath, against the\n417\t    # session-registered roots in .claude/state/session-roots.json.\n418\t    if parsed.get(\"decision\") != \"block\":\n419\t        try:\n420\t            _sr_sid = (\n421\t                (getattr(event, \"session_id\", \"\") or \"\").strip()\n422\t                or (os.environ.get(\"CLAUDE_SESSION_ID\") or \"\").strip()\n423\t            )\n424\t            _sr_reason = _session_roots_guard(\n425\t                candidate_paths, repo_root, _sr_sid\n426\t            )\n427\t        except Exception as _sr_exc:\n428\t            # An unexpected raise here is a hook bug (INFRA) → fail-open\n429\t            # with a breadcrumb; every INPUT-shaped failure inside the\n430\t            # guard already returns a deny VALUE instead of raising.\n431\t            print(\n432\t                \"[check_canonical_edit] session-roots guard fault: \"\n433\t                f\"{type(_sr_exc).__name__}: {_sr_exc}\",\n434\t                file=sys.stderr,\n435\t            )\n436\t            _sr_reason = None\n437\t        if _sr_reason is not None:\n438\t            _audit_session_root_block(\n439\t                candidate_paths[0] if candidate_paths else file_path\n440\t            )\n441\t            _emit_legacy_decision_json(\n442\t                _emit_block(_sr_reason), _adapter, event\n443\t            )\n444\t            return 0\n445\t\n446\t    # PLAN-133 A2 — invisible-unicode guard at SKILL.md authoring. Only on a\n447\t    # would-allow canonical SKILL.md edit (so we never relax the sentinel gate;\n448\t    # we can only ADD a fail-CLOSED block). Reads the staged tool_input content,\n449\t    # not disk. Default-OFF (CEO_UNICODE_HARDBLOCK=1). Fail-open.\n450\t    if parsed.get(\"decision\") != \"block\" and (\n451\t        file_path.endswith(\"/SKILL.md\") or file_path.endswith(\"SKILL.md\")\n452\t    ):\n453\t        try:\n454\t            new_content = getattr(event, \"new_content\", None) or _staged_content(event)\n455\t        except Exception:  # pragma: no cover - fail-open\n456\t            new_content = None\n457\t        if new_content:\n458\t            _uni = _scan_skill_content_unicode(\n459\t                new_content, surface=\"skill_write\"\n460\t            )\n461\t            if _uni is not None:\n462\t                _adapter_emit(_adapter, _contract.block(_uni), event)\n463\t                return 0\n464\t\n465\t    # `decide()` returns pre-built JSON strings for the legacy contract;\n466\t    # under the default/claude adapter the seam helper writes it directly\n467\t    # + newline (byte identity preserved); other host adapters re-shape it\n468\t    # on the parsed event's wire.\n469\t    _emit_legacy_decision_json(out, _adapter, event)\n470\t    return 0\n471\t\n472\t__all__ = ['_emit_legacy_decision_json', '_adapter_emit', '_cli_is_canonical', 'main', '_main_guarded']\n473\t"}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"84c575ae-5b7f-4ddf-bb05-107c276db6d8","timestamp":"2026-11-13T18:02:34.730Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/entry.py","content":"\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\nfrom __future__ import annotations\n\ndef _emit_legacy_decision_json(out: str, adapter, event=None) -> None:\n    \"\"\"Emit a pre-built legacy (Claude-shaped) decision JSON string through\n    the resolved host adapter (PLAN-155 Wave 1 dispatch seam, debate A1).\n\n    ``decide()`` returns pre-built JSON strings for the legacy contract.\n    Under the default/claude adapter the string is written RAW + newline —\n    byte-identical to the pre-seam hook. Under any other host adapter the\n    string is parsed back into a neutral ``Decision`` and re-emitted via\n    the adapter's ``emit_decision`` WITH the parsed NormalizedEvent\n    (host egress shape is EXPLICIT-only: a host-wire event stamps\n    ``raw_payload['ceo_host_wire']`` and the codex adapter emits\n    ``hookSpecificOutput.permissionDecision``), so a deny reaches the\n    host in the shape its wire enforces (a raw Claude-shaped line is\n    foreign JSON on the codex wire → silent fail-open → the S254\n    dead-gate class).\n    \"\"\"\n    adapter_basename = (getattr(adapter, \"__name__\", \"\") or \"\").rsplit(\".\", 1)[-1]\n    if adapter_basename == \"claude\":\n        sys.stdout.write(out + \"\\n\")\n        return\n    from _lib import contract as _contract  # noqa: PLC0415\n    parsed = json.loads(out)\n    adapter.emit_decision(\n        _contract.Decision(\n            allow=(parsed.get(\"decision\") != \"block\"),\n            reason=parsed.get(\"reason\"),\n            system_message=parsed.get(\"systemMessage\"),\n            message=parsed.get(\"message\"),\n        ),\n        event=event,\n    )\n\n\ndef _adapter_emit(adapter, decision, event=None) -> None:\n    \"\"\"Emit a neutral ``Decision`` through the resolved host adapter.\n\n    Claude path: the historical two-arg call — byte-identical output\n    (``claude.py:emit_decision`` does not take ``event=``). Any other\n    resolved adapter (codex host mode, ``_FailClosedAdapter``) receives\n    the parsed NormalizedEvent so the egress shape follows the wire that\n    produced it and the debate-A2 coherence override can fire.\n    \"\"\"\n    adapter_basename = (getattr(adapter, \"__name__\", \"\") or \"\").rsplit(\".\", 1)[-1]\n    if adapter_basename == \"claude\":\n        adapter.emit_decision(decision)\n        return\n    adapter.emit_decision(decision, event=event)\n\n\ndef _cli_is_canonical(args: List[str]) -> int:\n    \"\"\"PLAN-156-FOLLOWUP F5 (debate C2(b)) — read-only canonical-path\n    classification ORACLE.\n\n    Single-source-of-truth CLI so shell consumers (the grok/codex pre-push\n    review gates) classify paths with the SAME ``_is_canonical`` predicate\n    the edit-time guard and the Stop-review recorder use — re-implementing\n    the guard glob list in bash IS the drift class F5 fixes.\n\n    Usage:\n        python3 check_canonical_edit.py --is-canonical <path>...\n        python3 check_canonical_edit.py --is-canonical -   # paths on stdin,\n                                                           # one per line\n                                                           # (ARG_MAX-safe)\n\n    Output: one line per input path, ``<path>\\\\t<0|1>`` (1 = canonical),\n    in input order. Exit 0 on successful classification of every path.\n    Exit 2 when no path argument/stdin is supplied (consumers must treat\n    ANY nonzero exit as oracle failure and fall back fail-CLOSED to their\n    coarse over-triggering classifier).\n\n    Contract notes:\n    - Pure read-only classification. NO hook semantics run in this mode:\n      no event parse, no adapter, no sentinel lookup, no emission on the\n      hook wire. The hook entry (``main()``) is byte-identical when the\n      script is invoked as a hook (argv empty — ``_python-hook.sh`` passes\n      no arguments).\n    - Repo root resolves exactly like the hook path does\n      (``CLAUDE_PROJECT_DIR`` or cwd — see ``main()``), so oracle and hook\n      can never disagree on anchoring.\n    - Per-path classification fault → that path is reported ``1``\n      (canonical). Over-triggering review on an unclassifiable path is the\n      safe direction (fail-CLOSED); under-triggering would let an\n      unreviewed L3 touch through. ``_is_canonical`` itself already\n      returns False for paths outside the repo root — that is the\n      oracle's own semantics, not a fault.\n    \"\"\"\n    repo_root = Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n    paths: List[str] = list(args)\n    if paths == [\"-\"]:\n        paths = [ln.rstrip(\"\\n\") for ln in sys.stdin.read().splitlines()]\n        paths = [p for p in paths if p]\n    if not paths:\n        sys.stderr.write(\n            \"usage: check_canonical_edit.py --is-canonical <path>... | -\\n\"\n        )\n        return 2\n    out_lines: List[str] = []\n    for raw in paths:\n        try:\n            flag = 1 if _is_canonical(raw, repo_root) else 0\n        except Exception:\n            # Fail-CLOSED per path: unclassifiable → treat as canonical\n            # (over-trigger review, never under-trigger).\n            flag = 1\n        out_lines.append(\"%s\\t%d\" % (raw, flag))\n    sys.stdout.write(\"\\n\".join(out_lines) + \"\\n\")\n    return 0\n\n\ndef main() -> int:\n    \"\"\"Hook entry point.\n\n    PLAN162_FIX_1 / PLAN162_FIX_9 wrapper: arms the per-invocation\n    wall-clock deadline (consensus C2/C3/S8) around the real entry point\n    and clears BOTH pieces of invocation-scoped module state in a\n    ``finally``. Without the reset, a module-scope deadline (or a stale\n    tool name) armed by one in-process invocation would leak into the\n    next caller in the same process — the test suite drives ``decide()``\n    and ``main()`` in-process, and an expired leftover deadline would\n    fail those closed for no reason at all.\n    \"\"\"\n    global _CURRENT_TOOL_NAME\n    if _COMPONENT_IMPORT_ERROR is not None:\n        print(\"check_canonical_edit: component import unavailable (\" +\n              _COMPONENT_IMPORT_ERROR + \")\", file=sys.stderr)\n        if _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE:\n            print(_emit_block(\"CANONICAL-EDIT-BLOCKED: canonical_edit integrity \"\n                              \"failure: component import unavailable.\"))\n            return 0\n        print(_emit_allow())\n        return 0\n    _start_wall_budget()\n    try:\n        return _main_guarded()\n    finally:\n        _reset_wall_budget()\n        _CURRENT_TOOL_NAME = \"\"\n\n\ndef _main_guarded() -> int:\n    \"\"\"Hook entry point.\n\n    PLAN-006 Phase 1 migration (ADR-014): uses Adapter Layer\n    `read_event()` / `emit_decision()`. Byte-identical output.\n\n    PLAN-155 Wave 1 (debate A1, ratified seam option b): the adapter is\n    resolved ONCE per invocation through the shared seam\n    ``_lib.adapters.resolve()``. Under ``CEO_HOOK_ADAPTER`` unset/\"claude\"\n    the seam returns the claude adapter module and every downstream byte\n    is identical to the pre-seam hook (the regression bar). The debate-A2\n    coherence gate (explicitly-set-but-unresolvable ``CEO_HOOK_ADAPTER``\n    → INPUT class per PLAN-152 C4) lives INSIDE ``resolve()``, which\n    fails CLOSED by returning a ``_FailClosedAdapter`` whose egress\n    ALWAYS denies in BOTH harness vocabularies (top-level\n    ``decision: block`` + ``hookSpecificOutput.permissionDecision:\n    deny``) with a stderr + audit breadcrumb — never a silent fallback\n    to the claude adapter. Non-claude adapters additionally receive the\n    parsed event at egress (``_adapter_emit``) so the host wire shape\n    and the coherence override are event-driven, never latched.\n    \"\"\"\n    from _lib import adapters as _adapters  # noqa: E402\n    from _lib import contract as _contract  # noqa: E402\n\n    _adapter = _adapters.resolve()\n\n    try:\n        event = _adapter.read_event(phase=\"PreToolUse\")\n    except Exception:\n        _adapter.emit_decision(_contract.allow())\n        return 0\n\n    if event.parse_error:\n        # PLAN162_FIX_5B (finding #5b, consensus C4). HEAD emitted a bare\n        # ALLOW here. ``parse_error`` is, by name and by construction, the\n        # signal that the PAYLOAD did not parse — INPUT, not\n        # infrastructure — and CLAUDE.md §4 is literal about that split:\n        # fail-open on INFRASTRUCTURE, fail-CLOSED on INPUT. The sibling\n        # kernel hook already implements this exact form; THIS hook was\n        # the drift.\n        #\n        # The council justified the old posture by citing \"the ADR-010\n        # fail-open contract\". That citation is FALSE: ADR-010 contains\n        # zero occurrences of any failure-posture text. The only such text\n        # is this hook's own module docstring, so citing it as the ADR\n        # that authorizes it is circular.\n        #\n        # 5a (``read_event`` RAISING, above) stays fail-OPEN — that IS a\n        # genuine infrastructure failure, and the kernel sibling is\n        # fail-open identically there.\n        _emit_legacy_decision_json(\n            _emit_block(\n                reason=(\n                    \"CANONICAL-EDIT-BLOCKED: canonical_edit_payload_parse_error \"\n                    \"— the PreToolUse payload could not be parsed, so this \"\n                    \"edit-class event cannot be proven non-canonical. \"\n                    \"Security-matcher INPUT failure → fail-closed \"\n                    \"(CLAUDE.md §4; PLAN-162 finding #5b). Re-issue the tool \"\n                    \"call with a well-formed payload.\"\n                )\n            ),\n            _adapter,\n            event,\n        )\n        return 0\n\n    # PLAN-065 Layer A (S81-tris gap closure, 2026-05-04):\n    # When tool_name is mcp__*, the adapter's `event.file_path` field\n    # may be empty (custom MCP tools don't use the standard\n    # Edit/Write/MultiEdit `file_path` key). Inspect tool_input directly\n    # for write-shape parameters and resolve all candidate paths.\n    # Each candidate is gated independently; if ANY candidate is\n    # canonical without sentinel coverage, block.\n    tool_name = (event.tool_name or \"\").strip()\n    # PLAN162_FIX_9 — publish the EVENT's tool name (validated at read\n    # time, not here) for the four audit sites that record ``blocked_tool``.\n    global _CURRENT_TOOL_NAME\n    _CURRENT_TOOL_NAME = tool_name\n    candidate_paths: List[str] = []\n    if event.file_path:\n        candidate_paths.append(event.file_path)\n    if tool_name.startswith(\"mcp__\"):\n        candidate_paths.extend(\n            _extract_mcp_target_paths(event.tool_input or {})\n        )\n    # PLAN-155 Wave 1 (S265 pair-rail P1#3): a codex apply_patch can touch\n    # MULTIPLE files; the host adapter surfaces every path (incl. rename\n    # targets) as tool_input['apply_patch_paths']. Gate them ALL — a\n    # benign first op must not smuggle a later op into a guarded path.\n    # Absent under Claude Code (key never present → byte-identical).\n    if isinstance(event.tool_input, dict):\n        for _pp in event.tool_input.get(\"apply_patch_paths\") or []:\n            if isinstance(_pp, str) and _pp and _pp not in candidate_paths:\n                candidate_paths.append(_pp)\n\n    if not candidate_paths:\n        _adapter_emit(_adapter, _contract.allow(), event)\n        return 0\n\n    # Use the first canonical path for legacy file_path-keyed downstream\n    # logic, but iterate all candidates for canonical detection.\n    file_path = candidate_paths[0]\n\n    repo_root = Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n\n    # Layer A: gate a multi-candidate event using the MOST RESTRICTIVE\n    # canonical candidate. Historically mcp__*-only; PLAN-155 extends the\n    # scan to any multi-candidate event (apply_patch multi-file, S265\n    # P1#3). Single-candidate events (every Claude Code Edit/Write) skip\n    # this block entirely — byte-identical fast path.\n    #\n    # PLAN160_FIX_A (finding A — multi-candidate gate bypass): the prior\n    # loop ``break``-ed at the FIRST canonical candidate and gated ONLY\n    # that path via decide(). A multi-file MCP event whose first canonical\n    # candidate was sentinel-GRANTED let every LATER canonical candidate\n    # ride through UNGATED. The fix scans ALL candidates and selects the\n    # OFFENDING candidate (canonical + ungranted) if any —\n    # most-restrictive-wins — so decide() is still invoked at most ONCE\n    # (emit-once: decide() fires _emit_persona_coverage_synthesized on the\n    # allow path; a per-candidate decide() would double-emit).\n    #\n    # ``_forced_out``: a pre-built decision that BYPASSES decide(). Set for\n    # the two fail-CLOSED cases that must NOT be re-routed through decide()\n    # — over-cap, and any scan fault (classification OR sentinel discovery).\n    # Routing a classification-fault candidate through decide() would\n    # re-raise inside decide(), and the outer handler below would then\n    # fail-classify it as non-canonical and ALLOW (the V-A hole the codex\n    # pair-rail REJECTed). ``_find_sentinels`` is loaded LAZILY, only once a\n    # canonical candidate is seen, and the whole scan is wrapped so a\n    # sentinel-discovery fault fail-CLOSES with an emit instead of\n    # propagating out of main() (zero-emit hole).\n    _multi = tool_name.startswith(\"mcp__\") or len(candidate_paths) > 1\n    _forced_out = None\n    if _multi:\n        try:\n            if len(candidate_paths) > _PLAN160_MAX_CANDIDATES:\n                # Fail-CLOSED: more candidates than we will classify —\n                # cannot prove every canonical candidate is granted, so\n                # block the whole event rather than truncate the scan and\n                # risk an unexamined offender beyond the cap.\n                _forced_out = _emit_block(\n                    reason=(\n                        \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — \"\n                        f\"multi-candidate event carries {len(candidate_paths)} \"\n                        f\"paths (> cap {_PLAN160_MAX_CANDIDATES}); cannot clear \"\n                        \"all — fail-closed. PLAN-160 finding A.\"\n                    )\n                )\n            else:\n                sentinels = None  # lazy: only load once a canonical candidate exists\n                first_canonical = None\n                offender = None\n                for candidate in candidate_paths:\n                    # PLAN162_FIX_1 (C2) — the second sentinel-loop site.\n                    # Fail-CLOSED on an elapsed budget: a multi-candidate\n                    # event we could not finish clearing is exactly the\n                    # event that must not ride through.\n                    if _wall_budget_expired():\n                        _forced_out = _emit_block(\n                            reason=_WALL_DEADLINE_BLOCK_REASON\n                        )\n                        break\n                    if not _is_canonical(candidate, repo_root):\n                        continue\n                    if first_canonical is None:\n                        first_canonical = candidate\n                    if sentinels is None:\n                        sentinels = _find_sentinels(repo_root)\n                    if not _candidate_is_granted(candidate, repo_root, sentinels):\n                        offender = candidate\n                        break\n                # decide() runs ONCE: on the offender (→ block naming it) if\n                # any, else the first canonical candidate (→ sentinel allow +\n                # persona coverage), else candidate_paths[0] (non-canonical →\n                # allow).\n                file_path = offender or first_canonical or file_path\n        except Exception as _scan_exc:\n            # Classification OR sentinel-discovery fault on a MULTI-candidate\n            # event → fail-CLOSED with an emit. We are on a multi-file event\n            # we could not fully clear; a re-route through decide() would\n            # re-raise on the unclassifiable path and the outer handler would\n            # ALLOW it (V-A). Blocking here is the only safe outcome.\n            print(\n                f\"[check_canonical_edit] SCAN FAULT: \"\n                f\"{type(_scan_exc).__name__}: {_scan_exc}\",\n                file=sys.stderr,\n            )\n            _forced_out = _emit_block(\n                reason=(\n                    \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — \"\n                    f\"multi-candidate scan fault ({type(_scan_exc).__name__}); \"\n                    \"fail-closed. PLAN-160 finding A.\"\n                )\n            )\n\n    if _forced_out is not None:\n        # Pre-built fail-closed decision (over-cap or scan fault). Emit\n        # through the same legacy seam + best-effort veto audit as a normal\n        # block, BYPASSING decide() — routing a scan-fault path through\n        # decide() would re-raise and the outer handler would fail-OPEN\n        # (the V-A hole the codex pair-rail REJECTed).\n        _fparsed = json.loads(_forced_out)\n        if _fparsed.get(\"decision\") == \"block\":\n            # Forensic breadcrumb only. On over-cap / scan-fault the specific\n            # offending candidate is unknown or unreachable, so we record the\n            # event's FIRST candidate (not necessarily the offender); the\n            # fail-CLOSED decision itself is correct regardless.\n            _audit_block(\n                candidate_paths[0] if candidate_paths else file_path,\n                _safe_sentinel_count(repo_root),\n                reason_code=_block_reason_code(_fparsed.get(\"reason\", \"\")),\n            )\n        _emit_legacy_decision_json(_forced_out, _adapter, event)\n        return 0\n\n    # Single-candidate hot path (and the all-canonical-granted multi path)\n    # reaches decide() here. SECURITY INVARIANT: this call is NOT wrapped by\n    # the multi-candidate fail-CLOSED scan above, so its safety relies on\n    # ``_is_canonical`` / ``_repo_rels`` being TOTAL (never raising on str\n    # input — guaranteed by their broad ``except Exception``, PLAN160_FIX_D,\n    # and fenced by the totality unit tests). If a future refactor\n    # reintroduces a raise in classification, the outer handler below\n    # re-classifies and could fail-OPEN a single-candidate canonical edit —\n    # keep the totality tests as the regression fence.\n    try:\n        out = decide(file_path=file_path, repo_root=repo_root)\n    except Exception as e:\n        # PLAN-045 Wave 1 F-01-07: fail-CLOSED for canonical paths.\n        # Previously any exception fell through to allow; now an edit\n        # targeting a confirmed canonical path blocks with\n        # ``canonical_edit_hook_fault``. Non-canonical edits keep the\n        # fail-open contract so a hook bug doesn't brick the session\n        # on benign writes.\n        print(\n            f\"[check_canonical_edit] FATAL: {type(e).__name__}: {e}\",\n            file=sys.stderr,\n        )\n        try:\n            is_canonical = _is_canonical(file_path, repo_root)\n        except Exception:\n            is_canonical = False\n        if is_canonical:\n            _emit_legacy_decision_json(\n                _emit_block(\n                    reason=(\n                        \"CANONICAL-EDIT-BLOCKED: hook fault on canonical \"\n                        f\"path; {type(e).__name__}: {e}. PLAN-045 F-01-07.\"\n                    )\n                ),\n                _adapter,\n                event,\n            )\n            return 0\n        _adapter_emit(_adapter, _contract.allow(), event)\n        return 0\n\n    # On block, emit veto event (best-effort)\n    parsed = json.loads(out)\n    if parsed.get(\"decision\") == \"block\":\n        try:\n            rel = str(Path(file_path).resolve().relative_to(repo_root.resolve())).replace(os.sep, \"/\")\n        except Exception:\n            rel = file_path\n        _audit_block(\n            rel,\n            _safe_sentinel_count(repo_root),\n            reason_code=_block_reason_code(parsed.get(\"reason\", \"\")),\n        )\n\n    # PLAN-163 T3.1 — session-roots write-guard (DirectoryAdded consumer).\n    # Runs AFTER the existing project-relative checks and ONLY on a\n    # would-allow event, so it never relaxes the sentinel gate — it can\n    # only ADD a deny. Checks EVERY candidate path of the event (the\n    # multi-candidate list built above), by absolute realpath, against the\n    # session-registered roots in .claude/state/session-roots.json.\n    if parsed.get(\"decision\") != \"block\":\n        try:\n            _sr_sid = (\n                (getattr(event, \"session_id\", \"\") or \"\").strip()\n                or (os.environ.get(\"CLAUDE_SESSION_ID\") or \"\").strip()\n            )\n            _sr_reason = _session_roots_guard(\n                candidate_paths, repo_root, _sr_sid\n            )\n        except Exception as _sr_exc:\n            # An unexpected raise here is a hook bug (INFRA) → fail-open\n            # with a breadcrumb; every INPUT-shaped failure inside the\n            # guard already returns a deny VALUE instead of raising.\n            print(\n                \"[check_canonical_edit] session-roots guard fault: \"\n                f\"{type(_sr_exc).__name__}: {_sr_exc}\",\n                file=sys.stderr,\n            )\n            _sr_reason = None\n        if _sr_reason is not None:\n            _audit_session_root_block(\n                candidate_paths[0] if candidate_paths else file_path\n            )\n            _emit_legacy_decision_json(\n                _emit_block(_sr_reason), _adapter, event\n            )\n            return 0\n\n    # PLAN-133 A2 — invisible-unicode guard at SKILL.md authoring. Only on a\n    # would-allow canonical SKILL.md edit (so we never relax the sentinel gate;\n    # we can only ADD a fail-CLOSED block). Reads the staged tool_input content,\n    # not disk. Default-OFF (CEO_UNICODE_HARDBLOCK=1). Fail-open.\n    if parsed.get(\"decision\") != \"block\" and (\n        file_path.endswith(\"/SKILL.md\") or file_path.endswith(\"SKILL.md\")\n    ):\n        try:\n            new_content = getattr(event, \"new_content\", None) or _staged_content(event)\n        except Exception:  # pragma: no cover - fail-open\n            new_content = None\n        if new_content:\n            _uni = _scan_skill_content_unicode(\n                new_content, surface=\"skill_write\"\n            )\n            if _uni is not None:\n                _adapter_emit(_adapter, _contract.block(_uni), event)\n                return 0\n\n    # `decide()` returns pre-built JSON strings for the legacy contract;\n    # under the default/claude adapter the seam helper writes it directly\n    # + newline (byte identity preserved); other host adapters re-shape it\n    # on the parsed event's wire.\n    _emit_legacy_decision_json(out, _adapter, event)\n    return 0\n\n__all__ = ['_emit_legacy_decision_json', '_adapter_emit', '_cli_is_canonical', 'main', '_main_guarded']\n","numLines":473,"startLine":1,"totalLines":473}},"tool_result_meta":[{"id":"toolu_01MAXwJa7L9wPuTypvc6eAMX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NCrJDuqo5eUxXBXJgx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HpWKZaRuC3T7wBmdN2mXkV","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/paths.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11590,"cache_read_input_tokens":82305,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11590},"output_tokens":2,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"7b4762bd-9ccb-4129-bc00-45e961078372","timestamp":"2026-11-13T18:02:35.676Z","request_id":"req_011Ch1NCr2bnzMtZ68eESRLa","wire_tool_inputs":{"toolu_01HpWKZaRuC3T7wBmdN2mXkV":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/paths.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HpWKZaRuC3T7wBmdN2mXkV","type":"tool_result","content":"1\t\"\"\"Canonical target normalization, matching and sentinel discovery.\n2\t\n3\tFunctions are bound to the owning hook namespace by ``bind``. This keeps\n4\tits injectable dependencies and per-import state on the public hook.\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_normalize_candidate_value', '_extract_mcp_target_paths', '_repo_rels', '_matches_canonical_guard', '_canonical_rel', '_is_canonical', '_fnmatch_segments', '_match_segments', '_find_sentinels')\n9\t\n10\t\n11\tdef _normalize_candidate_value(value: str) -> str:\n12\t    \"\"\"PLAN162_FIX_7 (finding #7) — turn a ``file://`` URI into a path.\n13\t\n14\t    ``uri`` is one of ``_MCP_WRITE_PATH_KEYS``, but HEAD handed the value\n15\t    to ``Path()`` verbatim: ``file:///repo/.claude/settings.json`` became\n16\t    a RELATIVE path whose first segment is ``file:``, resolved against the\n17\t    process CWD, landed outside the repo root and classified\n18\t    NON-canonical — so the edit sailed through ungated even though the\n19\t    MCP server would write the guarded file.\n20\t\n21\t    Normalizing in ONE place (the single function that builds candidates)\n22\t    was the form both debate lanes accepted; the alternative — treating an\n23\t    un-interpretable value as fail-CLOSED — is left to the callers, which\n24\t    already fail-CLOSE on a candidate they cannot classify.\n25\t\n26\t    Only LOCAL file URIs are rewritten (empty or ``localhost`` authority).\n27\t    A ``file://remote-host/...`` URI is NOT a local path and is returned\n28\t    untouched, as is any value with a different scheme. A percent-escape\n29\t    that decodes to an embedded NUL is likewise returned untouched — a\n30\t    path the OS cannot open is not made more gate-able by decoding it.\n31\t    \"\"\"\n32\t    if len(value) < 7 or value[:7].lower() != \"file://\":\n33\t        return value\n34\t    try:\n35\t        from urllib.parse import unquote, urlsplit  # noqa: PLC0415\n36\t        parts = urlsplit(value)\n37\t        if parts.scheme.lower() != \"file\":\n38\t            return value\n39\t        if (parts.netloc or \"\").lower() not in (\"\", \"localhost\"):\n40\t            return value  # remote authority: not a local filesystem path\n41\t        decoded = unquote(parts.path)\n42\t        if not decoded or \"\\x00\" in decoded:\n43\t            return value\n44\t        return decoded\n45\t    except Exception:\n46\t        return value\n47\t\n48\t\n49\t\n50\tdef _extract_mcp_target_paths(tool_input: dict) -> List[str]:\n51\t    \"\"\"Best-effort extraction of canonical-edit candidate paths from MCP\n52\t    tool input. Returns a list of string paths whose canonical status\n53\t    will be checked. Non-string / non-path-shaped values are ignored.\n54\t\n55\t    PLAN-065 Layer A — closes S81-tris gap. Custom MCP tools previously\n56\t    bypassed `check_canonical_edit.py` because their tool_name does not\n57\t    match the legacy `Edit|Write|MultiEdit` matcher. Settings.json now\n58\t    routes `mcp__.*` here too; this function maps the heterogeneous\n59\t    MCP tool input shapes to a flat list of candidate paths.\n60\t    \"\"\"\n61\t    if not isinstance(tool_input, dict):\n62\t        return []\n63\t    paths: List[str] = []\n64\t    for key in _MCP_WRITE_PATH_KEYS:\n65\t        value = tool_input.get(key)\n66\t        if isinstance(value, str) and value:\n67\t            # Length cap defense (Sec MF-7 mirror): reject pathological\n68\t            # input early. Real MCP paths are <4 KiB; absurdly long\n69\t            # values are likely adversarial. The cap is applied to the\n70\t            # RAW value (PLAN162_FIX_7 normalization can only shorten it).\n71\t            if len(value) <= 4096:\n72\t                paths.append(_normalize_candidate_value(value))\n73\t        elif isinstance(value, list):\n74\t            for item in value:\n75\t                if isinstance(item, str) and item and len(item) <= 4096:\n76\t                    paths.append(_normalize_candidate_value(item))\n77\t    return paths\n78\t\n79\t\n80\t\n81\tdef _repo_rels(path_str: str, repo_root: Path) -> List[str]:\n82\t    \"\"\"All repo-relative POSIX forms of ``path_str`` (0, 1, or 2 entries).\n83\t\n84\t    PLAN160_FIX_D (finding D — relative-path classification bypass,\n85\t    most-restrictive-wins): a RELATIVE path is resolved against BOTH the\n86\t    process CWD (historical anchoring) AND ``repo_root``. A canonical file\n87\t    addressed by a relative ``path_str`` from a CWD outside the repo\n88\t    previously resolved outside ``repo_root`` → ``relative_to`` raised →\n89\t    treated non-canonical → the unsigned edit sailed through ungated.\n90\t    Yielding the repo_root-anchored form too closes that bypass. Absolute\n91\t    paths yield ONLY the CWD-form (``repo_root / p`` discards ``repo_root``\n92\t    when ``p`` is absolute), so classification AND per-call resolve cost\n93\t    stay byte-identical on the Edit/Write hot path. Returned in anchoring\n94\t    order (CWD-form first) so callers pick the historical rel when both\n95\t    land inside the repo (the CWD==repo_root common case → one entry).\n96\t\n97\t    TOTAL by construction (PLAN-160 finding-A blocker, codex + security\n98\t    pair-rail): every resolve is caught with a BROAD ``except Exception``.\n99\t    ``Path.resolve()`` raises ``RuntimeError`` — NOT ``ValueError``/``OSError``\n100\t    — on a symlink loop; if that propagated, ``_is_canonical`` would raise,\n101\t    and a raising candidate in the multi-candidate scan would route through\n102\t    ``decide()`` and the outer handler would fail-OPEN (allow) the whole\n103\t    event — a gate-bypass strictly worse than HEAD. An unresolvable path is\n104\t    simply non-canonical here (its write fails at the OS anyway); the other\n105\t    candidates in a multi-candidate event are still scanned and gated.\n106\t    \"\"\"\n107\t    p = Path(path_str)\n108\t    try:\n109\t        root_resolved = repo_root.resolve()\n110\t    except Exception:\n111\t        return []\n112\t    anchorings = [p]\n113\t    if not p.is_absolute():\n114\t        anchorings.append(repo_root / p)\n115\t    rels: List[str] = []\n116\t    for cand in anchorings:\n117\t        try:\n118\t            rels.append(\n119\t                str(cand.resolve().relative_to(root_resolved)).replace(os.sep, \"/\")\n120\t            )\n121\t        except Exception:\n122\t            continue\n123\t    return rels\n124\t\n125\t\n126\t\n127\tdef _matches_canonical_guard(rel_str: str) -> bool:\n128\t    \"\"\"True if a repo-relative POSIX path matches a canonical guard pattern.\n129\t\n130\t    Split out of ``_is_canonical`` (PLAN160_FIX_D) so the identical\n131\t    fast-path prefix check + glob loop runs against each candidate path\n132\t    anchoring without duplication. PLAN-025 F-perf-004 fast-path preserved.\n133\t\n134\t    PLAN162_FIX_CASEFOLD: the rel and the patterns are compared\n135\t    case-INSENSITIVELY (see the module note above) — on APFS the case\n136\t    variant addresses the very same inode.\n137\t    \"\"\"\n138\t    rel_folded = rel_str.lower()\n139\t    # Fast path: check the first path segment against known prefixes.\n140\t    first_seg = rel_folded.split(\"/\", 1)[0]\n141\t    if first_seg not in _CANONICAL_PREFIXES_FOLDED:\n142\t        return False\n143\t    for pattern in _CANONICAL_GUARDS_FOLDED:\n144\t        if _fnmatch_segments(rel_folded, pattern):\n145\t            return True\n146\t    return False\n147\t\n148\t\n149\t\n150\tdef _canonical_rel(path_str: str, repo_root: Path) -> Optional[str]:\n151\t    \"\"\"The repo-relative form of ``path_str`` that matches a canonical\n152\t    guard, or ``None`` if no anchoring is canonical.\n153\t\n154\t    PLAN160_FIX_D: single source of truth for canonicality AND the\n155\t    repo-relative form used downstream (decide() sentinel matching,\n156\t    ``_candidate_is_granted``), so a canonical path is ALWAYS paired with\n157\t    the exact rel that classified it — the CWD-anchored ``decide()`` resolve\n158\t    could otherwise raise on a repo_root-anchored canonical path and route a\n159\t    clean sentinel-block through finding C's fault branch instead.\n160\t    \"\"\"\n161\t    for rel_str in _repo_rels(path_str, repo_root):\n162\t        if _matches_canonical_guard(rel_str):\n163\t            return rel_str\n164\t    return None\n165\t\n166\t\n167\t\n168\tdef _is_canonical(path_str: str, repo_root: Path) -> bool:\n169\t    \"\"\"True if path_str matches one of the canonical guard patterns.\n170\t\n171\t    Thin wrapper over ``_canonical_rel`` (PLAN160_FIX_D). NOTE: this is a\n172\t    SHARED predicate (hook Layer-A, the ``--is-canonical`` CLI oracle, and\n173\t    ``_candidate_is_granted``); the finding-D change WIDENS classification\n174\t    (relative paths from a foreign CWD now classify canonical → more\n175\t    blocks), never narrows it — see the ADR.\n176\t    \"\"\"\n177\t    return _canonical_rel(path_str, repo_root) is not None\n178\t\n179\t\n180\t\n181\tdef _fnmatch_segments(path: str, pattern: str) -> bool:\n182\t    \"\"\"Segment-wise glob matcher.\n183\t\n184\t    - ``*`` matches exactly one path segment (any non-slash content).\n185\t    - ``**`` matches zero or more path segments (Sprint 9 amendment).\n186\t    - Literal segments must match exactly.\n187\t    \"\"\"\n188\t    p_parts = path.split(\"/\")\n189\t    pat_parts = pattern.split(\"/\")\n190\t    return _match_segments(p_parts, pat_parts)\n191\t\n192\t\n193\t\n194\tdef _match_segments(p_parts: List[str], pat_parts: List[str]) -> bool:\n195\t    \"\"\"Recursive glob with ``**`` zero-or-more support.\n196\t\n197\t    Per-segment patterns support full fnmatch semantics (so\n198\t    patterns like *.py, *.yaml, or ADR-*.md match one\n199\t    segment with a wildcard stem). ** still means zero-or-more\n200\t    segments.\n201\t    \"\"\"\n202\t    if not pat_parts:\n203\t        return not p_parts\n204\t    head, rest = pat_parts[0], pat_parts[1:]\n205\t    if head == \"**\":\n206\t        # Zero-or-more: try consuming 0..len(p_parts) segments\n207\t        for i in range(len(p_parts) + 1):\n208\t            if _match_segments(p_parts[i:], rest):\n209\t                return True\n210\t        return False\n211\t    if not p_parts:\n212\t        return False\n213\t    # Bare-* is equivalent to fnmatch \"*\", but we keep the explicit\n214\t    # branch for readability. fnmatch.fnmatchcase does case-sensitive\n215\t    # glob on a single segment (no \"/\" traversal).\n216\t    if head == \"*\" or fnmatch.fnmatchcase(p_parts[0], head):\n217\t        return _match_segments(p_parts[1:], rest)\n218\t    return False\n219\t\n220\t\n221\t\n222\tdef _find_sentinels(repo_root: Path) -> List[Path]:\n223\t    \"\"\"Find all valid Architect sentinel files in the repo.\n224\t\n225\t    PLAN-045 Wave 1 F-01-04: reject any sentinel that is a symlink or\n226\t    whose immediate parent directory is a symlink. Mirrors the\n227\t    ``_validate_skill_reference`` hardening pattern (ADR-051 sub-check\n228\t    5). Silently drops symlinked entries — an attacker who plants\n229\t    ``PLAN-EVIL/architect/round-1/approved.md -> /tmp/evil`` no longer\n230\t    gets their sentinel considered.\n231\t    \"\"\"\n232\t    base = repo_root / \".claude\" / \"plans\"\n233\t    if not base.is_dir():\n234\t        return []\n235\t    # PLAN-085 Wave E.1 — explicit pattern union + grandfather allowlist\n236\t    # (R1 Sec-3). NO catch-all wildcard. Novel architect/* subdirs not\n237\t    # listed below are treated as ORPHAN, NOT TRUSTED.\n238\t    _PATTERNS = (\n239\t        \"PLAN-*/architect/round-*/approved.md\",\n240\t        \"PLAN-*/architect/wave-0a/approved.md\",      # PLAN-083 grandfather\n241\t        \"PLAN-*/architect/wave-0b/approved.md\",      # PLAN-083 grandfather\n242\t        \"PLAN-*/architect/wave-1-2/approved.md\",     # PLAN-083 grandfather\n243\t        \"PLAN-*/architect/wave-minus-1/approved.md\", # PLAN-083 grandfather\n244\t        \"PLAN-*/staging/review/approved.md\",         # PLAN-083 grandfather\n245\t        \"PLAN-*/approved.md\",                        # plan-root sentinels\n246\t        \"PLAN-*/wave-*-approved.md\",                 # S109 wave-N-approved.md\n247\t        \"PLAN-*/approved-amendment-*.md\",            # E.5 amendment files\n248\t        \"PLAN-*/audit-v2/architect/round-*/approved.md\",  # PLAN-044 audit-v2 historical\n249\t    )\n250\t    seen: set = set()\n251\t    candidates: list = []\n252\t    for pat in _PATTERNS:\n253\t        for c in sorted(base.glob(pat)):\n254\t            if c not in seen:\n255\t                seen.add(c)\n256\t                candidates.append(c)\n257\t    # PLAN162_FIX_2 (PLAN-162 finding #2, consensus C9) — the symlink\n258\t    # rejection must be DEPTH-INDEPENDENT.\n259\t    #\n260\t    # HEAD checked exactly three levels (``p``, ``p.parent``,\n261\t    # ``p.parent.parent``), hard-coded to the depth of\n262\t    # ``PLAN-*/architect/round-*/approved.md``. The ``PLAN-*`` segment one\n263\t    # level further up was never checked, so\n264\t    # ``.claude/plans/PLAN-EVIL -> /tmp/evil`` smuggled a foreign\n265\t    # ``architect/round-1/approved.md`` into the TRUSTED sentinel set —\n266\t    # every intermediate directory is a real directory INSIDE the link\n267\t    # target, so all three checks passed.\n268\t    #\n269\t    # \"Cover the real depth of the patterns\" was rejected in debate: it\n270\t    # re-couples the guard to the pattern list, and the next 6-segment\n271\t    # pattern silently reopens the hole (the dead-gate class this file has\n272\t    # already suffered twice). Instead we do both depth-free checks:\n273\t    #\n274\t    #   (a) walk EVERY segment from ``p`` up to (excluding) ``base``,\n275\t    #       rejecting any symlinked component; and\n276\t    #   (b) assert ``realpath(p)`` stays under ``realpath(base)``, which\n277\t    #       also catches a symlink that resolves out of the tree without a\n278\t    #       symlinked component we happen to walk.\n279\t    #\n280\t    # RESIDUAL, deliberately not closed here: a symlink at ``base`` itself\n281\t    # (``.claude/plans``) satisfies both forms — (a) excludes base and (b)\n282\t    # resolves base through the same link. Named in the W1 instrument;\n283\t    # pinning today's behaviour there would pin a bypass.\n284\t    try:\n285\t        base_rp = os.path.realpath(str(base))\n286\t    except Exception:\n287\t        return []\n288\t    safe: List[Path] = []\n289\t    for p in candidates:\n290\t        try:\n291\t            # (a) depth-free ancestor walk: p, then every directory above\n292\t            # it, up to but not including `base`. A bound of 64 hops is a\n293\t            # runaway guard, never a semantic limit (real sentinels sit 2-4\n294\t            # levels under base).\n295\t            node = p\n296\t            contained = False\n297\t            for _hop in range(64):\n298\t                if node.is_symlink():\n299\t                    break\n300\t                parent = node.parent\n301\t                if parent == node:  # walked past the filesystem root\n302\t                    break\n303\t                if parent == base:\n304\t                    contained = True\n305\t                    break\n306\t                node = parent\n307\t            if not contained:\n308\t                continue\n309\t            # (b) realpath containment — independent of how many segments\n310\t            # the pattern happens to have.\n311\t            p_rp = os.path.realpath(str(p))\n312\t            if not p_rp.startswith(base_rp + os.sep):\n313\t                continue\n314\t        except OSError:\n315\t            continue\n316\t        safe.append(p)\n317\t    return safe\n318\t"}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"e042bf44-01ad-4145-861f-f3d06da59234","timestamp":"2026-11-13T18:02:35.690Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/paths.py","content":"\"\"\"Canonical target normalization, matching and sentinel discovery.\n\nFunctions are bound to the owning hook namespace by ``bind``. This keeps\nits injectable dependencies and per-import state on the public hook.\n\"\"\"\nfrom __future__ import annotations\n\n__all__ = ('_normalize_candidate_value', '_extract_mcp_target_paths', '_repo_rels', '_matches_canonical_guard', '_canonical_rel', '_is_canonical', '_fnmatch_segments', '_match_segments', '_find_sentinels')\n\n\ndef _normalize_candidate_value(value: str) -> str:\n    \"\"\"PLAN162_FIX_7 (finding #7) — turn a ``file://`` URI into a path.\n\n    ``uri`` is one of ``_MCP_WRITE_PATH_KEYS``, but HEAD handed the value\n    to ``Path()`` verbatim: ``file:///repo/.claude/settings.json`` became\n    a RELATIVE path whose first segment is ``file:``, resolved against the\n    process CWD, landed outside the repo root and classified\n    NON-canonical — so the edit sailed through ungated even though the\n    MCP server would write the guarded file.\n\n    Normalizing in ONE place (the single function that builds candidates)\n    was the form both debate lanes accepted; the alternative — treating an\n    un-interpretable value as fail-CLOSED — is left to the callers, which\n    already fail-CLOSE on a candidate they cannot classify.\n\n    Only LOCAL file URIs are rewritten (empty or ``localhost`` authority).\n    A ``file://remote-host/...`` URI is NOT a local path and is returned\n    untouched, as is any value with a different scheme. A percent-escape\n    that decodes to an embedded NUL is likewise returned untouched — a\n    path the OS cannot open is not made more gate-able by decoding it.\n    \"\"\"\n    if len(value) < 7 or value[:7].lower() != \"file://\":\n        return value\n    try:\n        from urllib.parse import unquote, urlsplit  # noqa: PLC0415\n        parts = urlsplit(value)\n        if parts.scheme.lower() != \"file\":\n            return value\n        if (parts.netloc or \"\").lower() not in (\"\", \"localhost\"):\n            return value  # remote authority: not a local filesystem path\n        decoded = unquote(parts.path)\n        if not decoded or \"\\x00\" in decoded:\n            return value\n        return decoded\n    except Exception:\n        return value\n\n\n\ndef _extract_mcp_target_paths(tool_input: dict) -> List[str]:\n    \"\"\"Best-effort extraction of canonical-edit candidate paths from MCP\n    tool input. Returns a list of string paths whose canonical status\n    will be checked. Non-string / non-path-shaped values are ignored.\n\n    PLAN-065 Layer A — closes S81-tris gap. Custom MCP tools previously\n    bypassed `check_canonical_edit.py` because their tool_name does not\n    match the legacy `Edit|Write|MultiEdit` matcher. Settings.json now\n    routes `mcp__.*` here too; this function maps the heterogeneous\n    MCP tool input shapes to a flat list of candidate paths.\n    \"\"\"\n    if not isinstance(tool_input, dict):\n        return []\n    paths: List[str] = []\n    for key in _MCP_WRITE_PATH_KEYS:\n        value = tool_input.get(key)\n        if isinstance(value, str) and value:\n            # Length cap defense (Sec MF-7 mirror): reject pathological\n            # input early. Real MCP paths are <4 KiB; absurdly long\n            # values are likely adversarial. The cap is applied to the\n            # RAW value (PLAN162_FIX_7 normalization can only shorten it).\n            if len(value) <= 4096:\n                paths.append(_normalize_candidate_value(value))\n        elif isinstance(value, list):\n            for item in value:\n                if isinstance(item, str) and item and len(item) <= 4096:\n                    paths.append(_normalize_candidate_value(item))\n    return paths\n\n\n\ndef _repo_rels(path_str: str, repo_root: Path) -> List[str]:\n    \"\"\"All repo-relative POSIX forms of ``path_str`` (0, 1, or 2 entries).\n\n    PLAN160_FIX_D (finding D — relative-path classification bypass,\n    most-restrictive-wins): a RELATIVE path is resolved against BOTH the\n    process CWD (historical anchoring) AND ``repo_root``. A canonical file\n    addressed by a relative ``path_str`` from a CWD outside the repo\n    previously resolved outside ``repo_root`` → ``relative_to`` raised →\n    treated non-canonical → the unsigned edit sailed through ungated.\n    Yielding the repo_root-anchored form too closes that bypass. Absolute\n    paths yield ONLY the CWD-form (``repo_root / p`` discards ``repo_root``\n    when ``p`` is absolute), so classification AND per-call resolve cost\n    stay byte-identical on the Edit/Write hot path. Returned in anchoring\n    order (CWD-form first) so callers pick the historical rel when both\n    land inside the repo (the CWD==repo_root common case → one entry).\n\n    TOTAL by construction (PLAN-160 finding-A blocker, codex + security\n    pair-rail): every resolve is caught with a BROAD ``except Exception``.\n    ``Path.resolve()`` raises ``RuntimeError`` — NOT ``ValueError``/``OSError``\n    — on a symlink loop; if that propagated, ``_is_canonical`` would raise,\n    and a raising candidate in the multi-candidate scan would route through\n    ``decide()`` and the outer handler would fail-OPEN (allow) the whole\n    event — a gate-bypass strictly worse than HEAD. An unresolvable path is\n    simply non-canonical here (its write fails at the OS anyway); the other\n    candidates in a multi-candidate event are still scanned and gated.\n    \"\"\"\n    p = Path(path_str)\n    try:\n        root_resolved = repo_root.resolve()\n    except Exception:\n        return []\n    anchorings = [p]\n    if not p.is_absolute():\n        anchorings.append(repo_root / p)\n    rels: List[str] = []\n    for cand in anchorings:\n        try:\n            rels.append(\n                str(cand.resolve().relative_to(root_resolved)).replace(os.sep, \"/\")\n            )\n        except Exception:\n            continue\n    return rels\n\n\n\ndef _matches_canonical_guard(rel_str: str) -> bool:\n    \"\"\"True if a repo-relative POSIX path matches a canonical guard pattern.\n\n    Split out of ``_is_canonical`` (PLAN160_FIX_D) so the identical\n    fast-path prefix check + glob loop runs against each candidate path\n    anchoring without duplication. PLAN-025 F-perf-004 fast-path preserved.\n\n    PLAN162_FIX_CASEFOLD: the rel and the patterns are compared\n    case-INSENSITIVELY (see the module note above) — on APFS the case\n    variant addresses the very same inode.\n    \"\"\"\n    rel_folded = rel_str.lower()\n    # Fast path: check the first path segment against known prefixes.\n    first_seg = rel_folded.split(\"/\", 1)[0]\n    if first_seg not in _CANONICAL_PREFIXES_FOLDED:\n        return False\n    for pattern in _CANONICAL_GUARDS_FOLDED:\n        if _fnmatch_segments(rel_folded, pattern):\n            return True\n    return False\n\n\n\ndef _canonical_rel(path_str: str, repo_root: Path) -> Optional[str]:\n    \"\"\"The repo-relative form of ``path_str`` that matches a canonical\n    guard, or ``None`` if no anchoring is canonical.\n\n    PLAN160_FIX_D: single source of truth for canonicality AND the\n    repo-relative form used downstream (decide() sentinel matching,\n    ``_candidate_is_granted``), so a canonical path is ALWAYS paired with\n    the exact rel that classified it — the CWD-anchored ``decide()`` resolve\n    could otherwise raise on a repo_root-anchored canonical path and route a\n    clean sentinel-block through finding C's fault branch instead.\n    \"\"\"\n    for rel_str in _repo_rels(path_str, repo_root):\n        if _matches_canonical_guard(rel_str):\n            return rel_str\n    return None\n\n\n\ndef _is_canonical(path_str: str, repo_root: Path) -> bool:\n    \"\"\"True if path_str matches one of the canonical guard patterns.\n\n    Thin wrapper over ``_canonical_rel`` (PLAN160_FIX_D). NOTE: this is a\n    SHARED predicate (hook Layer-A, the ``--is-canonical`` CLI oracle, and\n    ``_candidate_is_granted``); the finding-D change WIDENS classification\n    (relative paths from a foreign CWD now classify canonical → more\n    blocks), never narrows it — see the ADR.\n    \"\"\"\n    return _canonical_rel(path_str, repo_root) is not None\n\n\n\ndef _fnmatch_segments(path: str, pattern: str) -> bool:\n    \"\"\"Segment-wise glob matcher.\n\n    - ``*`` matches exactly one path segment (any non-slash content).\n    - ``**`` matches zero or more path segments (Sprint 9 amendment).\n    - Literal segments must match exactly.\n    \"\"\"\n    p_parts = path.split(\"/\")\n    pat_parts = pattern.split(\"/\")\n    return _match_segments(p_parts, pat_parts)\n\n\n\ndef _match_segments(p_parts: List[str], pat_parts: List[str]) -> bool:\n    \"\"\"Recursive glob with ``**`` zero-or-more support.\n\n    Per-segment patterns support full fnmatch semantics (so\n    patterns like *.py, *.yaml, or ADR-*.md match one\n    segment with a wildcard stem). ** still means zero-or-more\n    segments.\n    \"\"\"\n    if not pat_parts:\n        return not p_parts\n    head, rest = pat_parts[0], pat_parts[1:]\n    if head == \"**\":\n        # Zero-or-more: try consuming 0..len(p_parts) segments\n        for i in range(len(p_parts) + 1):\n            if _match_segments(p_parts[i:], rest):\n                return True\n        return False\n    if not p_parts:\n        return False\n    # Bare-* is equivalent to fnmatch \"*\", but we keep the explicit\n    # branch for readability. fnmatch.fnmatchcase does case-sensitive\n    # glob on a single segment (no \"/\" traversal).\n    if head == \"*\" or fnmatch.fnmatchcase(p_parts[0], head):\n        return _match_segments(p_parts[1:], rest)\n    return False\n\n\n\ndef _find_sentinels(repo_root: Path) -> List[Path]:\n    \"\"\"Find all valid Architect sentinel files in the repo.\n\n    PLAN-045 Wave 1 F-01-04: reject any sentinel that is a symlink or\n    whose immediate parent directory is a symlink. Mirrors the\n    ``_validate_skill_reference`` hardening pattern (ADR-051 sub-check\n    5). Silently drops symlinked entries — an attacker who plants\n    ``PLAN-EVIL/architect/round-1/approved.md -> /tmp/evil`` no longer\n    gets their sentinel considered.\n    \"\"\"\n    base = repo_root / \".claude\" / \"plans\"\n    if not base.is_dir():\n        return []\n    # PLAN-085 Wave E.1 — explicit pattern union + grandfather allowlist\n    # (R1 Sec-3). NO catch-all wildcard. Novel architect/* subdirs not\n    # listed below are treated as ORPHAN, NOT TRUSTED.\n    _PATTERNS = (\n        \"PLAN-*/architect/round-*/approved.md\",\n        \"PLAN-*/architect/wave-0a/approved.md\",      # PLAN-083 grandfather\n        \"PLAN-*/architect/wave-0b/approved.md\",      # PLAN-083 grandfather\n        \"PLAN-*/architect/wave-1-2/approved.md\",     # PLAN-083 grandfather\n        \"PLAN-*/architect/wave-minus-1/approved.md\", # PLAN-083 grandfather\n        \"PLAN-*/staging/review/approved.md\",         # PLAN-083 grandfather\n        \"PLAN-*/approved.md\",                        # plan-root sentinels\n        \"PLAN-*/wave-*-approved.md\",                 # S109 wave-N-approved.md\n        \"PLAN-*/approved-amendment-*.md\",            # E.5 amendment files\n        \"PLAN-*/audit-v2/architect/round-*/approved.md\",  # PLAN-044 audit-v2 historical\n    )\n    seen: set = set()\n    candidates: list = []\n    for pat in _PATTERNS:\n        for c in sorted(base.glob(pat)):\n            if c not in seen:\n                seen.add(c)\n                candidates.append(c)\n    # PLAN162_FIX_2 (PLAN-162 finding #2, consensus C9) — the symlink\n    # rejection must be DEPTH-INDEPENDENT.\n    #\n    # HEAD checked exactly three levels (``p``, ``p.parent``,\n    # ``p.parent.parent``), hard-coded to the depth of\n    # ``PLAN-*/architect/round-*/approved.md``. The ``PLAN-*`` segment one\n    # level further up was never checked, so\n    # ``.claude/plans/PLAN-EVIL -> /tmp/evil`` smuggled a foreign\n    # ``architect/round-1/approved.md`` into the TRUSTED sentinel set —\n    # every intermediate directory is a real directory INSIDE the link\n    # target, so all three checks passed.\n    #\n    # \"Cover the real depth of the patterns\" was rejected in debate: it\n    # re-couples the guard to the pattern list, and the next 6-segment\n    # pattern silently reopens the hole (the dead-gate class this file has\n    # already suffered twice). Instead we do both depth-free checks:\n    #\n    #   (a) walk EVERY segment from ``p`` up to (excluding) ``base``,\n    #       rejecting any symlinked component; and\n    #   (b) assert ``realpath(p)`` stays under ``realpath(base)``, which\n    #       also catches a symlink that resolves out of the tree without a\n    #       symlinked component we happen to walk.\n    #\n    # RESIDUAL, deliberately not closed here: a symlink at ``base`` itself\n    # (``.claude/plans``) satisfies both forms — (a) excludes base and (b)\n    # resolves base through the same link. Named in the W1 instrument;\n    # pinning today's behaviour there would pin a bypass.\n    try:\n        base_rp = os.path.realpath(str(base))\n    except Exception:\n        return []\n    safe: List[Path] = []\n    for p in candidates:\n        try:\n            # (a) depth-free ancestor walk: p, then every directory above\n            # it, up to but not including `base`. A bound of 64 hops is a\n            # runaway guard, never a semantic limit (real sentinels sit 2-4\n            # levels under base).\n            node = p\n            contained = False\n            for _hop in range(64):\n                if node.is_symlink():\n                    break\n                parent = node.parent\n                if parent == node:  # walked past the filesystem root\n                    break\n                if parent == base:\n                    contained = True\n                    break\n                node = parent\n            if not contained:\n                continue\n            # (b) realpath containment — independent of how many segments\n            # the pattern happens to have.\n            p_rp = os.path.realpath(str(p))\n            if not p_rp.startswith(base_rp + os.sep):\n                continue\n        except OSError:\n            continue\n        safe.append(p)\n    return safe\n","numLines":318,"startLine":1,"totalLines":318}},"tool_result_meta":[{"id":"toolu_01HpWKZaRuC3T7wBmdN2mXkV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
