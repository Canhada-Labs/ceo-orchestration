not isinstance(data, dict):\n120\t        return None\n121\t    return data\n122\t\n123\t\n124\tdef _emit_decision(decision: Dict[str, Any]) -> None:\n125\t    sys.stdout.write(json.dumps(decision, ensure_ascii=False) + \"\\n\")\n126\t\n127\t\n128\tdef _breadcrumb(msg: str) -> None:\n129\t    try:\n130\t        sys.stderr.write(f\"[check_cost_envelope] {msg}\\n\")\n131\t    except Exception:\n132\t        pass\n133\t\n134\t\n135\tdef _looks_like_swarm_dispatch(tool_input: Dict[str, Any]) -> bool:\n136\t    \"\"\"P1 #1 fold — require BOTH CEO_SWARM=1 AND a real swarm signature\n137\t    in the command body. Either alone is NOT enough.\n138\t\n139\t    Prevents false-positive enforcement on every Bash invocation in a\n140\t    session that happens to have CEO_SWARM=1 in env (e.g. `git status`).\n141\t    \"\"\"\n142\t    if os.environ.get(\"CEO_SWARM\") != \"1\":\n143\t        return False\n144\t    cmd = tool_input.get(\"command\")\n145\t    if not isinstance(cmd, str) or not cmd:\n146\t        return False\n147\t    for sig in _SWARM_COMMAND_SIGNATURES:\n148\t        if sig in cmd:\n149\t            return True\n150\t    return False\n151\t\n152\t\n153\tdef _resolve_estimate_cents() -> int:\n154\t    raw = os.environ.get(\"CEO_SWARM_ESTIMATED_SPAWN_CENTS\")\n155\t    if raw is None:\n156\t        # P0 #1 fold — fallback to legacy var for back-compat.\n157\t        raw = os.environ.get(\"CEO_SWARM_ESTIMATE_CENTS\")\n158\t    if raw is None:\n159\t        return _DEFAULT_ESTIMATE_CENTS\n160\t    try:\n161\t        n = int(raw.strip())\n162\t        return n if n > 0 else _DEFAULT_ESTIMATE_CENTS\n163\t    except (ValueError, AttributeError):\n164\t        return _DEFAULT_ESTIMATE_CENTS\n165\t\n166\t\n167\tdef _resolve_class_tier() -> str:\n168\t    raw = (os.environ.get(\"CEO_SWARM_CLASS\") or \"vibecoder\").strip()\n169\t    if raw in (\"vibecoder\", \"CTO\", \"team\"):\n170\t        return raw\n171\t    return \"vibecoder\"\n172\t\n173\t\n174\tdef _resolve_user_id() 