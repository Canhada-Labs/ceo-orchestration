{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TZgJQTNbeL4NeHJeNQ4qiv","type":"tool_result","content":"1\t\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _validated_tool_name(tool_name) -> str:\n5\t    \"\"\"Closed-enum / shape validation for an event-derived tool name.\"\"\"\n6\t    raw = tool_name.strip() if isinstance(tool_name, str) else \"\"\n7\t    if raw in _EDIT_CLASS_TOOLS:\n8\t        return raw\n9\t    if _MCP_TOOL_NAME_RE.match(raw):\n10\t        return raw\n11\t    return _BLOCKED_TOOL_UNKNOWN\n12\t\n13\t\n14\tdef _blocked_tool_field() -> str:\n15\t    \"\"\"The validated ``blocked_tool`` value for this invocation.\"\"\"\n16\t    return _validated_tool_name(_CURRENT_TOOL_NAME)\n17\t\n18\t\n19\tdef _emit_allow(system_message: Optional[str] = None) -> str:\n20\t    # Claude Code hook schema: top-level \"allow\" is NOT valid.\n21\t    # Emit empty {} or {\"systemMessage\": ...}.\n22\t    out: dict = {}\n23\t    if system_message:\n24\t        out[\"systemMessage\"] = system_message\n25\t    return json.dumps(out, ensure_ascii=False)\n26\t\n27\t\n28\tdef _emit_persona_coverage_synthesized(rel_path: str) -> None:\n29\t    \"\"\"PLAN-106 Wave C — emit persona_coverage_synthesized at sentinel-approved\n30\t    canonical-edit allow path.\n31\t\n32\t    Attribution policy:\n33\t      archetype = env CEO_ACTIVE_ARCHETYPE if in closed-enum, else\n34\t                  \"code-reviewer\" (canonical-edit sentinel chain is\n35\t                  the code-review surface per ADR-010).\n36\t      task_type = \"review\" (sentinel approval is a review act).\n37\t      cell_id   = sha256[:8](archetype + \":\" + task_type)\n38\t      source    = \"canonical_edit\"\n39\t\n40\t    Best-effort; fail-open on any exception. Bypass via\n41\t    ``CEO_PERSONA_COVERAGE_EMIT=0``.\n42\t    \"\"\"\n43\t    env = os.environ\n44\t    if (env.get(\"CEO_PERSONA_COVERAGE_EMIT\") or \"\").strip() == \"0\":\n45\t        return\n46\t    try:\n47\t        import hashlib as _hl\n48\t        import unicodedata as _uc\n49\t        from _lib import audit_emit as _audit_emit_pc  # noqa: E402\n50\t\n51\t        # Closed enum check (mirrors audit_emit:_PERSONA_COVERAGE_ARCHETYPES).\n52\t        archetypes_ok = {\n53\t            \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n54\t            \"threat-detection-engineer\",\n55\t        }\n56\t        raw = (env.get(\"CEO_ACTIVE_ARCHETYPE\") or \"\").strip().lower()\n57\t        # NFKC fold to defeat full-width injection in env var\n58\t        raw = _uc.normalize(\"NFKC\", raw)\n59\t        archetype = raw if raw in archetypes_ok else \"code-reviewer\"\n60\t        task_type = \"review\"\n61\t        cell_input = f\"{archetype}:{task_type}\".encode(\"utf-8\")\n62\t        cell_id = _hl.sha256(cell_input).hexdigest()[:8]\n63\t\n64\t        _audit_emit_pc.emit_generic(\n65\t            \"persona_coverage_synthesized\",\n66\t            archetype=archetype,\n67\t            task_type=task_type,\n68\t            cell_id=cell_id,\n69\t            source=\"canonical_edit\",\n70\t        )\n71\t    except Exception:  # noqa: BLE001 — fail-open, never block edit\n72\t        return\n73\t\n74\t\n75\tdef _emit_block(reason: str) -> str:\n76\t    return json.dumps(\n77\t        {\"decision\": \"block\", \"reason\": reason}, ensure_ascii=False\n78\t    )\n79\t\n80\t\n81\tdef _scan_skill_content_unicode(content: str, *, surface: str, env=None):\n82\t    \"\"\"PLAN-133 A2 — pure invisible-unicode guard for SKILL.md content.\n83\t\n84\t    ``surface`` is the closed-enum origin (\"skill_write\" | \"skill_read\"). Default-OFF;\n85\t    emits invisible_unicode_blocked on both advisory + enforced paths. Returns a\n86\t    block-reason string when enforced AND a detection fires, else None. Fail-open.\n87\t    \"\"\"\n88\t    try:\n89\t        from _lib import spec_context_sanitizer as _scs  # noqa: E402\n90\t    except Exception:  # pragma: no cover - fail-open\n91\t        return None\n92\t    try:\n93\t        if not content:\n94\t            return None\n95\t        src_env = env if env is not None else os.environ\n96\t        if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n97\t            enforce = False\n98\t        else:\n99\t            enforce = (src_env.get(\"CEO_UNICODE_HARDBLOCK\") or \"\").strip() == \"1\"\n100\t            # Prefer the trusted_env snapshot when available (mirror A1/§5b).\n101\t            try:\n102\t                from _lib import trusted_env as _te  # noqa: E402\n103\t                _snap = _te.get_trusted(\"CEO_UNICODE_HARDBLOCK\")\n104\t                if _snap is not None:\n105\t                    enforce = (_snap or \"\").strip() == \"1\"\n106\t            except Exception:  # pragma: no cover\n107\t                pass\n108\t\n109\t        result = _scs.sanitize(content)\n110\t        count = _scs.invisible_unicode_count(result)\n111\t        if count <= 0:\n112\t            return None\n113\t        unicode_class = _scs.classify_invisible_unicode(result)\n114\t\n115\t        try:\n116\t            from _lib import audit_emit as _ae  # noqa: E402\n117\t            _ae.emit_generic(\n118\t                \"invisible_unicode_blocked\",\n119\t                surface=surface,\n120\t                unicode_class=unicode_class,\n121\t                char_count=int(count),\n122\t                enforced=1 if enforce else 0,\n123\t            )\n124\t        except Exception:  # pragma: no cover - fail-open\n125\t            pass\n126\t\n127\t        if not enforce:\n128\t            return None\n129\t        return (\n130\t            \"CANONICAL-EDIT-BLOCKED: invisible_unicode_blocked: this SKILL.md \"\n131\t            f\"content contains {count} invisible/smuggling character(s) \"\n132\t            f\"(class={unicode_class}). Skill content is loaded into the model as \"\n133\t            \"trusted instructions; hidden control/bidi/Tag-block characters are \"\n134\t            \"rejected fail-CLOSED. Remove them. To run advisory-only, unset \"\n135\t            \"CEO_UNICODE_HARDBLOCK.\"\n136\t        )\n137\t    except Exception:  # pragma: no cover - fail-open invariant\n138\t        return None\n139\t\n140\t\n141\tdef _staged_content(event) -> Optional[str]:\n142\t    \"\"\"PLAN-133 A2 — best-effort extraction of the NEW SKILL.md content from a\n143\t    staged Edit/Write/MultiEdit ``tool_input``.\n144\t\n145\t    At PreToolUse the new content is in the tool_input, NOT yet on disk. Reads the\n146\t    standard adapter keys (Write ``content``; Edit ``new_string``; MultiEdit\n147\t    ``edits[].new_string`` concatenated). Returns None when nothing can be extracted\n148\t    (fail-OPEN — the caller then never blocks). Never raises.\n149\t    \"\"\"\n150\t    try:\n151\t        tool_input = getattr(event, \"tool_input\", None) or {}\n152\t        if not isinstance(tool_input, dict):\n153\t            return None\n154\t        # Write tool — full file content.\n155\t        content = tool_input.get(\"content\")\n156\t        if isinstance(content, str) and content:\n157\t            return content\n158\t        # Edit tool — single replacement string.\n159\t        new_string = tool_input.get(\"new_string\")\n160\t        if isinstance(new_string, str) and new_string:\n161\t            return new_string\n162\t        # MultiEdit tool — concatenate per-edit new strings.\n163\t        edits = tool_input.get(\"edits\")\n164\t        if isinstance(edits, list):\n165\t            parts: List[str] = []\n166\t            for ed in edits:\n167\t                if isinstance(ed, dict):\n168\t                    ns = ed.get(\"new_string\")\n169\t                    if isinstance(ns, str) and ns:\n170\t                        parts.append(ns)\n171\t            if parts:\n172\t                return \"\\n\".join(parts)\n173\t    except Exception:  # pragma: no cover - fail-open\n174\t        return None\n175\t    return None\n176\t\n177\t__all__ = ['_validated_tool_name', '_blocked_tool_field', '_emit_allow', '_emit_persona_coverage_synthesized', '_emit_block', '_scan_skill_content_unicode', '_staged_content']\n178\t"}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"6220dac1-007c-467a-80e8-260dea220254","timestamp":"2026-11-13T18:05:01.542Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/utility.py","content":"\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\nfrom __future__ import annotations\n\ndef _validated_tool_name(tool_name) -> str:\n    \"\"\"Closed-enum / shape validation for an event-derived tool name.\"\"\"\n    raw = tool_name.strip() if isinstance(tool_name, str) else \"\"\n    if raw in _EDIT_CLASS_TOOLS:\n        return raw\n    if _MCP_TOOL_NAME_RE.match(raw):\n        return raw\n    return _BLOCKED_TOOL_UNKNOWN\n\n\ndef _blocked_tool_field() -> str:\n    \"\"\"The validated ``blocked_tool`` value for this invocation.\"\"\"\n    return _validated_tool_name(_CURRENT_TOOL_NAME)\n\n\ndef _emit_allow(system_message: Optional[str] = None) -> str:\n    # Claude Code hook schema: top-level \"allow\" is NOT valid.\n    # Emit empty {} or {\"systemMessage\": ...}.\n    out: dict = {}\n    if system_message:\n        out[\"systemMessage\"] = system_message\n    return json.dumps(out, ensure_ascii=False)\n\n\ndef _emit_persona_coverage_synthesized(rel_path: str) -> None:\n    \"\"\"PLAN-106 Wave C — emit persona_coverage_synthesized at sentinel-approved\n    canonical-edit allow path.\n\n    Attribution policy:\n      archetype = env CEO_ACTIVE_ARCHETYPE if in closed-enum, else\n                  \"code-reviewer\" (canonical-edit sentinel chain is\n                  the code-review surface per ADR-010).\n      task_type = \"review\" (sentinel approval is a review act).\n      cell_id   = sha256[:8](archetype + \":\" + task_type)\n      source    = \"canonical_edit\"\n\n    Best-effort; fail-open on any exception. Bypass via\n    ``CEO_PERSONA_COVERAGE_EMIT=0``.\n    \"\"\"\n    env = os.environ\n    if (env.get(\"CEO_PERSONA_COVERAGE_EMIT\") or \"\").strip() == \"0\":\n        return\n    try:\n        import hashlib as _hl\n        import unicodedata as _uc\n        from _lib import audit_emit as _audit_emit_pc  # noqa: E402\n\n        # Closed enum check (mirrors audit_emit:_PERSONA_COVERAGE_ARCHETYPES).\n        archetypes_ok = {\n            \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n            \"threat-detection-engineer\",\n        }\n        raw = (env.get(\"CEO_ACTIVE_ARCHETYPE\") or \"\").strip().lower()\n        # NFKC fold to defeat full-width injection in env var\n        raw = _uc.normalize(\"NFKC\", raw)\n        archetype = raw if raw in archetypes_ok else \"code-reviewer\"\n        task_type = \"review\"\n        cell_input = f\"{archetype}:{task_type}\".encode(\"utf-8\")\n        cell_id = _hl.sha256(cell_input).hexdigest()[:8]\n\n        _audit_emit_pc.emit_generic(\n            \"persona_coverage_synthesized\",\n            archetype=archetype,\n            task_type=task_type,\n            cell_id=cell_id,\n            source=\"canonical_edit\",\n        )\n    except Exception:  # noqa: BLE001 — fail-open, never block edit\n        return\n\n\ndef _emit_block(reason: str) -> str:\n    return json.dumps(\n        {\"decision\": \"block\", \"reason\": reason}, ensure_ascii=False\n    )\n\n\ndef _scan_skill_content_unicode(content: str, *, surface: str, env=None):\n    \"\"\"PLAN-133 A2 — pure invisible-unicode guard for SKILL.md content.\n\n    ``surface`` is the closed-enum origin (\"skill_write\" | \"skill_read\"). Default-OFF;\n    emits invisible_unicode_blocked on both advisory + enforced paths. Returns a\n    block-reason string when enforced AND a detection fires, else None. Fail-open.\n    \"\"\"\n    try:\n        from _lib import spec_context_sanitizer as _scs  # noqa: E402\n    except Exception:  # pragma: no cover - fail-open\n        return None\n    try:\n        if not content:\n            return None\n        src_env = env if env is not None else os.environ\n        if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n            enforce = False\n        else:\n            enforce = (src_env.get(\"CEO_UNICODE_HARDBLOCK\") or \"\").strip() == \"1\"\n            # Prefer the trusted_env snapshot when available (mirror A1/§5b).\n            try:\n                from _lib import trusted_env as _te  # noqa: E402\n                _snap = _te.get_trusted(\"CEO_UNICODE_HARDBLOCK\")\n                if _snap is not None:\n                    enforce = (_snap or \"\").strip() == \"1\"\n            except Exception:  # pragma: no cover\n                pass\n\n        result = _scs.sanitize(content)\n        count = _scs.invisible_unicode_count(result)\n        if count <= 0:\n            return None\n        unicode_class = _scs.classify_invisible_unicode(result)\n\n        try:\n            from _lib import audit_emit as _ae  # noqa: E402\n            _ae.emit_generic(\n                \"invisible_unicode_blocked\",\n                surface=surface,\n                unicode_class=unicode_class,\n                char_count=int(count),\n                enforced=1 if enforce else 0,\n            )\n        except Exception:  # pragma: no cover - fail-open\n            pass\n\n        if not enforce:\n            return None\n        return (\n            \"CANONICAL-EDIT-BLOCKED: invisible_unicode_blocked: this SKILL.md \"\n            f\"content contains {count} invisible/smuggling character(s) \"\n            f\"(class={unicode_class}). Skill content is loaded into the model as \"\n            \"trusted instructions; hidden control/bidi/Tag-block characters are \"\n            \"rejected fail-CLOSED. Remove them. To run advisory-only, unset \"\n            \"CEO_UNICODE_HARDBLOCK.\"\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return None\n\n\ndef _staged_content(event) -> Optional[str]:\n    \"\"\"PLAN-133 A2 — best-effort extraction of the NEW SKILL.md content from a\n    staged Edit/Write/MultiEdit ``tool_input``.\n\n    At PreToolUse the new content is in the tool_input, NOT yet on disk. Reads the\n    standard adapter keys (Write ``content``; Edit ``new_string``; MultiEdit\n    ``edits[].new_string`` concatenated). Returns None when nothing can be extracted\n    (fail-OPEN — the caller then never blocks). Never raises.\n    \"\"\"\n    try:\n        tool_input = getattr(event, \"tool_input\", None) or {}\n        if not isinstance(tool_input, dict):\n            return None\n        # Write tool — full file content.\n        content = tool_input.get(\"content\")\n        if isinstance(content, str) and content:\n            return content\n        # Edit tool — single replacement string.\n        new_string = tool_input.get(\"new_string\")\n        if isinstance(new_string, str) and new_string:\n            return new_string\n        # MultiEdit tool — concatenate per-edit new strings.\n        edits = tool_input.get(\"edits\")\n        if isinstance(edits, list):\n            parts: List[str] = []\n            for ed in edits:\n                if isinstance(ed, dict):\n                    ns = ed.get(\"new_string\")\n                    if isinstance(ns, str) and ns:\n                        parts.append(ns)\n            if parts:\n                return \"\\n\".join(parts)\n    except Exception:  # pragma: no cover - fail-open\n        return None\n    return None\n\n__all__ = ['_validated_tool_name', '_blocked_tool_field', '_emit_allow', '_emit_persona_coverage_synthesized', '_emit_block', '_scan_skill_content_unicode', '_staged_content']\n","numLines":178,"startLine":1,"totalLines":178}},"tool_result_meta":[{"id":"toolu_01TZgJQTNbeL4NeHJeNQ4qiv","permission_decisio