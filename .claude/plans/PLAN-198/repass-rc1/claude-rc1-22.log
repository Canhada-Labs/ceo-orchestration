{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NzfGvAxJEUw7CQGTgn6sHj","type":"tool_result","content":"1\t\"\"\"Behavior across the canonical hook's extracted component boundaries.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport builtins\n5\timport importlib.util\n6\timport io\n7\timport json\n8\tfrom contextlib import redirect_stderr, redirect_stdout\n9\tfrom pathlib import Path\n10\tfrom unittest import mock\n11\t\n12\tfrom _lib.testing import TestEnvContext\n13\t\n14\t\n15\t_HOOK = Path(__file__).resolve().parents[1] / \"check_canonical_edit.py\"\n16\t\n17\t\n18\tdef _load(name):\n19\t    spec = importlib.util.spec_from_file_location(name, _HOOK)\n20\t    module = importlib.util.module_from_spec(spec)\n21\t    spec.loader.exec_module(module)\n22\t    return module\n23\t\n24\t\n25\tclass TestComponentCompatibility(TestEnvContext):\n26\t    def test_guard_changes_affect_only_the_owning_import(self):\n27\t        first = _load(\"canonical_components_first\")\n28\t        second = _load(\"canonical_components_second\")\n29\t        target = str(self.project_dir / \"local.cfg\")\n30\t        with mock.patch.object(first, \"_CANONICAL_GUARDS_FOLDED\", [\"local.cfg\"]), \\\n31\t                mock.patch.object(first, \"_CANONICAL_PREFIXES_FOLDED\", {\"local.cfg\"}):\n32\t            blocked = json.loads(first.decide(file_path=target, repo_root=self.project_dir))\n33\t            allowed = json.loads(second.decide(file_path=target, repo_root=self.project_dir))\n34\t        self.assertEqual(blocked[\"decision\"], \"block\")\n35\t        self.assertIn(\"local.cfg\", blocked[\"reason\"])\n36\t        self.assertEqual(allowed, {})\n37\t\n38\t    def test_signature_cache_uses_live_dependencies_and_stays_per_import(self):\n39\t        first = _load(\"canonical_cache_first\")\n40\t        second = _load(\"canonical_cache_second\")\n41\t        sentinel = self.project_dir / \"approved.md\"\n42\t        key = (\"same-sentinel\",)\n43\t        with mock.patch.object(first, \"_compute_sig_cache_key\", return_value=key), \\\n44\t                mock.patch.object(second, \"_compute_sig_cache_key\", return_value=key), \\\n45\t                mock.patch.object(first, \"_verify_signature_rail\", return_value=True) as accept, \\\n46\t                mock.patch.object(second, \"_verify_signature_rail\", return_value=False) as reject:\n47\t            self.assertTrue(first._signature_rail_ok(sentinel))\n48\t            self.assertTrue(first._signature_rail_ok(sentinel))\n49\t            self.assertFalse(second._signature_rail_ok(sentinel))\n50\t        self.assertEqual(first._SIG_VERIFY_CACHE, {key: True})\n51\t        self.assertEqual(second._SIG_VERIFY_CACHE, {key: False})\n52\t        accept.assert_called_once_with(sentinel)\n53\t        reject.assert_called_once_with(sentinel)\n54\t\n55\t    def test_missing_component_blocks_and_emits_integrity_breadcrumb(self):\n56\t        original_import = builtins.__import__\n57\t\n58\t        def unavailable(name, *args, **kwargs):\n59\t            if name == \"_lib.canonical_edit\":\n60\t                raise ImportError(\"component unavailable\")\n61\t            return original_import(name, *args, **kwargs)\n62\t\n63\t        with mock.patch(\"builtins.__import__\", side_effect=unavailable):\n64\t            module = _load(\"canonical_component_missing\")\n65\t        output, errors = io.StringIO(), io.StringIO()\n66\t        with redirect_stdout(output), redirect_stderr(errors):\n67\t            self.assertEqual(module.main(), 0)\n68\t        decision = json.loads(output.getvalue())\n69\t        self.assertEqual(decision[\"decision\"], \"block\")\n70\t        self.assertIn(\"canonical_edit integrity\", decision[\"reason\"])\n71\t        self.assertIn(\"component import unavailable (ImportError)\", errors.getvalue())\n72\t"}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"4a6a562e-a438-464a-a92c-0ba538c39772","timestamp":"2026-11-13T18:04:05.335Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/tests/test_canonical_edit_modules.py","content":"\"\"\"Behavior across the canonical hook's extracted component boundaries.\"\"\"\nfrom __future__ import annotations\n\nimport builtins\nimport importlib.util\nimport io\nimport json\nfrom contextlib import redirect_stderr, redirect_stdout\nfrom pathlib import Path\nfrom unittest import mock\n\nfrom _lib.testing import TestEnvContext\n\n\n_HOOK = Path(__file__).resolve().parents[1] / \"check_canonical_edit.py\"\n\n\ndef _load(name):\n    spec = importlib.util.spec_from_file_location(name, _HOOK)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\nclass TestComponentCompatibility(TestEnvContext):\n    def test_guard_changes_affect_only_the_owning_import(self):\n        first = _load(\"canonical_components_first\")\n        second = _load(\"canonical_components_second\")\n        target = str(self.project_dir / \"local.cfg\")\n        with mock.patch.object(first, \"_CANONICAL_GUARDS_FOLDED\", [\"local.cfg\"]), \\\n                mock.patch.object(first, \"_CANONICAL_PREFIXES_FOLDED\", {\"local.cfg\"}):\n            blocked = json.loads(first.decide(file_path=target, repo_root=self.project_dir))\n            allowed = json.loads(second.decide(file_path=target, repo_root=self.project_dir))\n        self.assertEqual(blocked[\"decision\"], \"block\")\n        self.assertIn(\"local.cfg\", blocked[\"reason\"])\n        self.assertEqual(allowed, {})\n\n    def test_signature_cache_uses_live_dependencies_and_stays_per_import(self):\n        first = _load(\"canonical_cache_first\")\n        second = _load(\"canonical_cache_second\")\n        sentinel = self.project_dir / \"approved.md\"\n        key = (\"same-sentinel\",)\n        with mock.patch.object(first, \"_compute_sig_cache_key\", return_value=key), \\\n                mock.patch.object(second, \"_compute_sig_cache_key\", return_value=key), \\\n                mock.patch.object(first, \"_verify_signature_rail\", return_value=True) as accept, \\\n                mock.patch.object(second, \"_verify_signature_rail\", return_value=False) as reject:\n            self.assertTrue(first._signature_rail_ok(sentinel))\n            self.assertTrue(first._signature_rail_ok(sentinel))\n            self.assertFalse(second._signature_rail_ok(sentinel))\n        self.assertEqual(first._SIG_VERIFY_CACHE, {key: True})\n        self.assertEqual(second._SIG_VERIFY_CACHE, {key: False})\n        accept.assert_called_once_with(sentinel)\n        reject.assert_called_once_with(sentinel)\n\n    def test_missing_component_blocks_and_emits_integrity_breadcrumb(self):\n        original_import = builtins.__import__\n\n        def unavailable(name, *args, **kwargs):\n            if name == \"_lib.canonical_edit\":\n                raise ImportError(\"component unavailable\")\n            return original_import(name, *args, **kwargs)\n\n        with mock.patch(\"builtins.__import__\", side_effect=unavailable):\n            module = _load(\"canonical_component_missing\")\n        output, errors = io.StringIO(), io.StringIO()\n        with redirect_stdout(output), redirect_stderr(errors):\n            self.assertEqual(module.main(), 0)\n        decision = json.loads(output.getvalue())\n        self.assertEqual(decision[\"decision\"], \"block\")\n        self.assertIn(\"canonical_edit integrity\", decision[\"reason\"])\n        self.assertIn(\"component import unavailable (ImportError)\", errors.getvalue())\n","numLines":72,"startLine":1,"totalLines":72}},"tool_result_meta":[{"id":"toolu_01NzfGvAxJEUw7CQGTgn6sHj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
