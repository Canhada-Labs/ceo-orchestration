{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4auDfs6kwvZASwzZEg6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016nHDx6VcXtKwA7tgU8Cphj","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/paths.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12333,"cache_read_input_tokens":82253,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12333},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"87a01cb6-33f0-4f9b-96ab-19ac5ceedbdc","timestamp":"2026-11-15T10:50:59.012Z","request_id":"req_011Ch4auDUDPRKRJXUzp48M6","wire_tool_inputs":{"toolu_016nHDx6VcXtKwA7tgU8Cphj":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/paths.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016nHDx6VcXtKwA7tgU8Cphj","type":"tool_result","content":"1\t\"\"\"Canonical target normalization, matching and sentinel discovery.\n2\t\n3\tFunctions are bound to the owning hook namespace by ``bind``. This keeps\n4\tits injectable dependencies and per-import state on the public hook.\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_normalize_candidate_value', '_extract_mcp_target_paths', '_repo_rels', '_matches_canonical_guard', '_canonical_rel', '_is_canonical', '_fnmatch_segments', '_match_segments', '_find_sentinels')\n9\t\n10\t\n11\tdef _normalize_candidate_value(value: str) -> str:\n12\t    \"\"\"PLAN162_FIX_7 (finding #7) — turn a ``file://`` URI into a path.\n13\t\n14\t    ``uri`` is one of ``_MCP_WRITE_PATH_KEYS``, but HEAD handed the value\n15\t    to ``Path()`` verbatim: ``file:///repo/.claude/settings.json`` became\n16\t    a RELATIVE path whose first segment is ``file:``, resolved against the\n17\t    process CWD, landed outside the repo root and classified\n18\t    NON-canonical — so the edit sailed through ungated even though the\n19\t    MCP server would write the guarded file.\n20\t\n21\t    Normalizing in ONE place (the single function that builds candidates)\n22\t    was the form both debate lanes accepted; the alternative — treating an\n23\t    un-interpretable value as fail-CLOSED — is left to the callers, which\n24\t    already fail-CLOSE on a candidate they cannot classify.\n25\t\n26\t    Only LOCAL file URIs are rewritten (empty or ``localhost`` authority).\n27\t    A ``file://remote-host/...`` URI is NOT a local path and is returned\n28\t    untouched, as is any value with a different scheme. A percent-escape\n29\t    that decodes to an embedded NUL is likewise returned untouched — a\n30\t    path the OS cannot open is not made more gate-able by decoding it.\n31\t    \"\"\"\n32\t    if len(value) < 7 or value[:7].lower() != \"file://\":\n33\t        return value\n34\t    try:\n35\t        from urllib.parse import unquote, urlsplit  # noqa: PLC0415\n36\t        parts = urlsplit(value)\n37\t        if parts.scheme.lower() != \"file\":\n38\t            return value\n39\t        if (parts.netloc or \"\").lower() not in (\"\", \"localhost\"):\n40\t            return value  # remote authority: not a local filesystem path\n41\t        decoded = unquote(parts.path)\n42\t        if not decoded or \"\\x00\" in decoded:\n43\t            return value\n44\t        return decoded\n45\t    except Exception:\n46\t        return value\n47\t\n48\t\n49\t\n50\tdef _extract_mcp_target_paths(tool_input: dict) -> List[str]:\n51\t    \"\"\"Best-effort extraction of canonical-edit candidate paths from MCP\n52\t    tool input. Returns a list of string paths whose canonical status\n53\t    will be checked. Non-string / non-path-shaped values are ignored.\n54\t\n55\t    PLAN-065 Layer A — closes S81-tris gap. Custom MCP tools previously\n56\t    bypassed `check_canonical_edit.py` because their tool_name does not\n57\t    match the legacy `Edit|Write|MultiEdit` matcher. Settings.json now\n58\t    routes `mcp__.*` here too; this function maps the heterogeneous\n59\t    MCP tool input shapes to a flat list of candidate paths.\n60\t    \"\"\"\n61\t    if not isinstance(tool_input, dict):\n62\t        return []\n63\t    paths: List[str] = []\n64\t    for key in _MCP_WRITE_PATH_KEYS:\n65\t        value = tool_input.get(key)\n66\t        if isinstance(value, str) and value:\n67\t            # Length cap defense (Sec MF-7 mirror): reject pathological\n68\t            # input early. Real MCP paths are <4 KiB; absurdly long\n69\t            # values are likely adversarial. The cap is applied to the\n70\t            # RAW value (PLAN162_FIX_7 normalization can only shorten it).\n71\t            if len(value) <= 4096:\n72\t                paths.append(_normalize_candidate_value(value))\n73\t        elif isinstance(value, list):\n74\t            for item in value:\n75\t                if isinstance(item, str) and item and len(item) <= 4096:\n76\t                    paths.append(_normalize_candidate_value(item))\n77\t    return paths\n78\t\n79\t\n80\t\n81\tdef _repo_rels(path_str: str, repo_root: Path) -> List[str]:\n82\t    \"\"\"All repo-relative POSIX forms of ``path_str`` (0, 1, or 2 entries).\n83\t\n84\t    PLAN160_FIX_D (finding D — relative-path classification bypass,\n85\t    most-restrictive-wins): a RELATIVE path is resolved against BOTH the\n86\t    process CWD (historical anchoring) AND ``repo_root``. A canonical file\n87\t    addressed by a relative ``path_str`` from a CWD outside the repo\n88\t    previously resolved outside ``repo_root`` → ``relative_to`` raised →\n89\t    treated non-canonical → the unsigned edit sailed through ungated.\n90\t    Yielding the repo_root-anchored form too closes that bypass. Absolute\n91\t    paths yield ONLY the CWD-form (``repo_root / p`` discards ``repo_root``\n92\t    when ``p`` is absolute), so classification AND per-call resolve cost\n93\t    stay byte-identical on the Edit/Write hot path. Returned in anchoring\n94\t    order (CWD-form first) so callers pick the historical rel when both\n95\t    land inside the repo (the CWD==repo_root common case → one entry).\n96\t\n97\t    TOTAL by construction (PLAN-160 finding-A blocker, codex + security\n98\t    pair-rail): every resolve is caught with a BROAD ``except Exception``.\n99\t    ``Path.resolve()`` raises ``RuntimeError`` — NOT ``ValueError``/``OSError``\n100\t    — on a symlink loop; if that propagated, ``_is_canonical`` would raise,\n101\t    and a raising candidate in the multi-candidate scan would route through\n102\t    ``decide()`` and the outer handler would fail-OPEN (allow) the whole\n103\t    event — a gate-bypass strictly worse than HEAD. An unresolvable path is\n104\t    simply non-canonical here (its write fails at the OS anyway); the other\n105\t    candidates in a multi-candidate event are still scanned and gated.\n106\t    \"\"\"\n107\t    p = Path(path_str)\n108\t    try:\n109\t        root_resolved = repo_root.resolve()\n110\t    except Exception:\n111\t        return []\n112\t    anchorings = [p]\n113\t    if not p.is_absolute():\n114\t        anchorings.append(repo_root / p)\n115\t    rels: List[str] = []\n116\t    for cand in anchorings:\n117\t        try:\n118\t            rels.append(\n119\t                str(cand.resolve().relative_to(root_resolved)).replace(os.sep, \"/\")\n120\t            )\n121\t        except Exception:\n122\t            continue\n123\t    return rels\n124\t\n125\t\n126\t\n127\tdef _matches_canonical_guard(rel_str: str) -> bool:\n128\t    \"\"\"True if a repo-relative POSIX path matches a canonical guard pattern.\n129\t\n130\t    Split out of ``_is_canonical`` (PLAN160_FIX_D) so the identical\n131\t    fast-path prefix check + glob loop runs against each candidate path\n132\t    anchoring without duplication. PLAN-025 F-perf-004 fast-path preserved.\n133\t\n134\t    PLAN162_FIX_CASEFOLD: the rel and the patterns are compared\n135\t    case-INSENSITIVELY (see the module note above) — on APFS the case\n136\t    variant addresses the very same inode.\n137\t    \"\"\"\n138\t    rel_folded = rel_str.lower()\n139\t    # Fast path: check the first path segment against known prefixes.\n140\t    first_seg = rel_folded.split(\"/\", 1)[0]\n141\t    if first_seg not in _CANONICAL_PREFIXES_FOLDED:\n142\t        return False\n143\t    for pattern in _CANONICAL_GUARDS_FOLDED:\n144\t        if _fnmatch_segments(rel_folded, pattern):\n145\t            return True\n146\t    return False\n147\t\n148\t\n149\t\n150\tdef _canonical_rel(path_str: str, repo_root: Path) -> Optional[str]:\n151\t    \"\"\"The repo-relative form of ``path_str`` that matches a canonical\n152\t    guard, or ``None`` if no anchoring is canonical.\n153\t\n154\t    PLAN160_FIX_D: single source of truth for canonicality AND the\n155\t    repo-relative form used downstream (decide() sentinel matching,\n156\t    ``_candidate_is_granted``), so a canonical path is ALWAYS paired with\n157\t    the exact rel that classified it — the CWD-anchored ``decide()`` resolve\n158\t    could otherwise raise on a repo_root-anchored canonical path and route a\n159\t    clean sentinel-block through finding C's fault branch instead.\n160\t    \"\"\"\n161\t    for rel_str in _repo_rels(path_str, repo_root):\n162\t        if _matches_canonical_guard(rel_str):\n163\t            return rel_str\n164\t    return None\n165\t\n166\t\n167\t\n168\tdef _is_canonical(path_str: str, repo_root: Path) -> bool:\n169\t    \"\"\"True if path_str matches one of the canonical guard patterns.\n170\t\n171\t    Thin wrapper over ``_canonical_rel`` (PLAN160_FIX_D). NOTE: this is a\n172\t    SHARED predicate (hook Layer-A, the ``--is-canonical`` CLI oracle, and\n173\t    ``_candidate_is_granted``); the finding-D change WIDENS classification\n174\t    (relative paths from a foreign CWD now classify canonical → more\n175\t    blocks), never narrows it — see the ADR.\n176\t    \"\"\"\n177\t    return _canonical_rel(path_str, repo_root) is not None\n178\t\n179\t\n180\t\n181\tdef _fnmatch_segments(path: str, pattern: str) -> bool:\n182\t    \"\"\"Segment-wise glob matcher.\n183\t\n184\t    - ``*`` matches exactly one path segment (any non-slash content).\n185\t    - ``**`` matches zero or more path segments (Sprint 9 amendment).\n186\t    - Literal segments must match exactly.\n187\t    \"\"\"\n188\t    p_parts = path.split(\"/\")\n189\t    pat_parts = pattern.split(\"/\")\n190\t    return _match_segments(p_parts, pat_parts)\n191\t\n192\t\n193\t\n194\tdef _match_segments(p_parts: List[str], pat_parts: List[str]) -> bool:\n195\t    \"\"\"Recursive glob with ``**`` zero-or-more support.\n196\t\n197\t    Per-segment patterns support full fnmatch semantics (so\n198\t    patterns like *.py, *.yaml, or ADR-*.md match one\n199\t    segment with a wildcard stem). ** still means zero-or-more\n200\t    segments.\n201\t    \"\"\"\n202\t    if not pat_parts:\n203\t        return not p_parts\n204\t    head, rest = pat_parts[0], pat_parts[1:]\n205\t    if head == \"**\":\n206\t        # Zero-or-more: try consuming 0..len(p_parts) segments\n207\t        for i in range(len(p_parts) + 1):\n208\t            if _match_segments(p_parts[i:], rest):\n209\t                return True\n210\t        return False\n211\t    if not p_parts:\n212\t        return False\n213\t    # Bare-* is equivalent to fnmatch \"*\", but we keep the explicit\n214\t    # branch for readability. fnmatch.fnmatchcase does case-sensitive\n215\t    # glob on a single segment (no \"/\" traversal).\n216\t    if head == \"*\" or fnmatch.fnmatchcase(p_parts[0], head):\n217\t        return _match_segments(p_parts[1:], rest)\n218\t    return False\n219\t\n220\t\n221\t\n222\tdef _find_sentinels(repo_root: Path) -> List[Path]:\n223\t    \"\"\"Find all valid Architect sentinel files in the repo.\n224\t\n225\t    PLAN-045 Wave 1 F-01-04: reject any sentinel that is a symlink or\n226\t    whose immediate parent directory is a symlink. Mirrors the\n227\t    ``_validate_skill_reference`` hardening pattern (ADR-051 sub-check\n228\t    5). Silently drops symlinked entries — an attacker who plants\n229\t    ``PLAN-EVIL/architect/round-1/approved.md -> /tmp/evil`` no longer\n230\t    gets their sentinel considered.\n231\t    \"\"\"\n232\t    base = repo_root / \".claude\" / \"plans\"\n233\t    if not base.is_dir():\n234\t        return []\n235\t    # PLAN-085 Wave E.1 — explicit pattern union + grandfather allowlist\n236\t    # (R1 Sec-3). NO catch-all wildcard. Novel architect/* subdirs not\n237\t    # listed below are treated as ORPHAN, NOT TRUSTED.\n238\t    _PATTERNS = (\n239\t        \"PLAN-*/architect/round-*/approved.md\",\n240\t        \"PLAN-*/architect/wave-0a/approved.md\",      # PLAN-083 grandfather\n241\t        \"PLAN-*/architect/wave-0b/approved.md\",      # PLAN-083 grandfather\n242\t        \"PLAN-*/architect/wave-1-2/approved.md\",     # PLAN-083 grandfather\n243\t        \"PLAN-*/architect/wave-minus-1/approved.md\", # PLAN-083 grandfather\n244\t        \"PLAN-*/staging/review/approved.md\",         # PLAN-083 grandfather\n245\t        \"PLAN-*/approved.md\",                        # plan-root sentinels\n246\t        \"PLAN-*/wave-*-approved.md\",                 # S109 wave-N-approved.md\n247\t        \"PLAN-*/approved-amendment-*.md\",            # E.5 amendment files\n248\t        \"PLAN-*/audit-v2/architect/round-*/approved.md\",  # PLAN-044 audit-v2 historical\n249\t    )\n250\t    seen: set = set()\n251\t    candidates: list = []\n252\t    for pat in _PATTERNS:\n253\t        for c in sorted(base.glob(pat)):\n254\t            if c not in seen:\n255\t                seen.add(c)\n256\t                candidates.append(c)\n257\t    # PLAN162_FIX_2 (PLAN-162 finding #2, consensus C9) — the symlink\n258\t    # rejection must be DEPTH-INDEPENDENT.\n259\t    #\n260\t    # HEAD checked exactly three levels (``p``, ``p.parent``,\n261\t    # ``p.parent.parent``), hard-coded to the depth of\n262\t    # ``PLAN-*/architect/round-*/approved.md``. The ``PLAN-*`` segment one\n263\t    # level further up was never checked, so\n264\t    # ``.claude/plans/PLAN-EVIL -> /tmp/evil`` smuggled a foreign\n265\t    # ``architect/round-1/approved.md`` into the TRUSTED sentinel set —\n266\t    # every intermediate directory is a real directory INSIDE the link\n267\t    # target, so all three checks passed.\n268\t    #\n269\t    # \"Cover the real depth of the patterns\" was rejected in debate: it\n270\t    # re-couples the guard to the pattern list, and the next 6-segment\n271\t    # pattern silently reopens the hole (the dead-gate class this file has\n272\t    # already suffered twice). Instead we do both depth-free checks:\n273\t    #\n274\t    #   (a) walk EVERY segment from ``p`` up to (excluding) ``base``,\n275\t    #       rejecting any symlinked component; and\n276\t    #   (b) assert ``realpath(p)`` stays under ``realpath(base)``, which\n277\t    #       also catches a symlink that resolves out of the tree without a\n278\t    #       symlinked component we happen to walk.\n279\t    #\n280\t    # RESIDUAL, deliberately not closed here: a symlink at ``base`` itself\n281\t    # (``.claude/plans``) satisfies both forms — (a) excludes base and (b)\n282\t    # resolves base through the same link. Named in the W1 instrument;\n283\t    # pinning today's behaviour there would pin a bypass.\n284\t    try:\n285\t        base_rp = os.path.realpath(str(base))\n286\t    except Exception:\n287\t        return []\n288\t    safe: List[Path] = []\n289\t    for p in candidates:\n290\t        try:\n291\t            # (a) depth-free ancestor walk: p, then every directory above\n292\t            # it, up to but not including `base`. A bound of 64 hops is a\n293\t            # runaway guard, never a semantic limit (real sentinels sit 2-4\n294\t            # levels under base).\n295\t            node = p\n296\t            contained = False\n297\t            for _hop in range(64):\n298\t                if node.is_symlink():\n299\t                    break\n300\t                parent = node.parent\n301\t                if parent == node:  # walked past the filesystem root\n302\t                    break\n303\t                if parent == base:\n304\t                    contained = True\n305\t                    break\n306\t                node = parent\n307\t            if not contained:\n308\t                continue\n309\t            # (b) realpath containment — independent of how many segments\n310\t            # the pattern happens to have.\n311\t            p_rp = os.path.realpath(str(p))\n312\t            if not p_rp.startswith(base_rp + os.sep):\n313\t                continue\n314\t        except OSError:\n315\t            continue\n316\t        safe.append(p)\n317\t    return safe\n318\t"}]},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"acdcf306-cf1b-4856-9ee2-6b47432a1221","timestamp":"2026-11-15T10:50:59.031Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/paths.py","content":"\"\"\"Canonical target normalization, matching and sentinel discovery.\n\nFunctions are bound to the owning hook namespace by ``bind``. This keeps\nits injectable dependencies and per-import state on the public hook.\n\"\"\"\nfrom __future__ import annotations\n\n__all__ = ('_normalize_candidate_value', '_extract_mcp_target_paths', '_repo_rels', '_matches_canonical_guard', '_canonical_rel', '_is_canonical', '_fnmatch_segments', '_match_segments', '_find_sentinels')\n\n\ndef _normalize_candidate_value(value: str) -> str:\n    \"\"\"PLAN162_FIX_7 (finding #7) — turn a ``file://`` URI into a path.\n\n    ``uri`` is one of ``_MCP_WRITE_PATH_KEYS``, but HEAD handed the value\n    to ``Path()`` verbatim: ``file:///repo/.claude/settings.json`` became\n    a RELATIVE path whose first segment is ``file:``, resolved against the\n    process CWD, landed outside the repo root and classified\n    NON-canonical — so the edit sailed through ungated even though the\n    MCP server would write the guarded file.\n\n    Normalizing in ONE place (the single function that builds candidates)\n    was the form both debate lanes accepted; the alternative — treating an\n    un-interpretable value as fail-CLOSED — is left to the callers, which\n    already fail-CLOSE on a candidate they cannot classify.\n\n    Only LOCAL file URIs are rewritten (empty or ``localhost`` authority).\n    A ``file://remote-host/...`` URI is NOT a local path and is returned\n    untouched, as is any value with a different scheme. A percent-escape\n    that decodes to an embedded NUL is likewise returned untouched — a\n    path the OS cannot open is not made more gate-able by decoding it.\n    \"\"\"\n    if len(value) < 7 or value[:7].lower() != \"file://\":\n        return value\n    try:\n        from urllib.parse import unquote, urlsplit  # noqa: PLC0415\n        parts = urlsplit(value)\n        if parts.scheme.lower() != \"file\":\n            return value\n        if (parts.netloc or \"\").lower() not in (\"\", \"localhost\"):\n            return value  # remote authority: not a local filesystem path\n        decoded = unquote(parts.path)\n        if not decoded or \"\\x00\" in decoded:\n            return value\n        return decoded\n    except Exception:\n        return value\n\n\n\ndef _extract_mcp_target_paths(tool_input: dict) -> List[str]:\n    \"\"\"Best-effort extraction of canonical-edit candidate paths from MCP\n    tool input. Returns a list of string paths whose canonical status\n    will be checked. Non-string / non-path-shaped values are ignored.\n\n    PLAN-065 Layer A — closes S81-tris gap. Custom MCP tools previously\n    bypassed `check_canonical_edit.py` because their tool_name does not\n    match the legacy `Edit|Write|MultiEdit` matcher. Settings.json now\n    routes `mcp__.*` here too; this function maps the heterogeneous\n    MCP tool input shapes to a flat list of candidate paths.\n    \"\"\"\n    if not isinstance(tool_input, dict):\n        return []\n    paths: List[str] = []\n    for key in _MCP_WRITE_PATH_KEYS:\n        value = tool_input.get(key)\n        if isinstance(value, str) and value:\n            # Length cap defense (Sec MF-7 mirror): reject pathological\n            # input early. Real MCP paths are <4 KiB; absurdly long\n            # values are likely adversarial. The cap is applied to the\n            # RAW value (PLAN162_FIX_7 normalization can only shorten it).\n            if len(value) <= 4096:\n                paths.append(_normalize_candidate_value(value))\n        elif isinstance(value, list):\n            for item in value:\n                if isinstance(item, str) and item and len(item) <= 4096:\n                    paths.append(_normalize_candidate_value(item))\n    return paths\n\n\n\ndef _repo_rels(path_str: str, repo_root: Path) -> List[str]:\n    \"\"\"All repo-relative POSIX forms of ``path_str`` (0, 1, or 2 entries).\n\n    PLAN160_FIX_D (finding D — relative-path classification bypass,\n    most-restrictive-wins): a RELATIVE path is resolved against BOTH the\n    process CWD (historical anchoring) AND ``repo_root``. A canonical file\n    addressed by a relative ``path_str`` from a CWD outside the repo\n    previously resolved outside ``repo_root`` → ``relative_to`` raised →\n    treated non-canonical → the unsigned edit sailed through ungated.\n    Yielding the repo_root-anchored form too closes that bypass. Absolute\n    paths yield ONLY the CWD-form (``repo_root / p`` discards ``repo_root``\n    when ``p`` is absolute), so classification AND per-call resolve cost\n    stay byte-identical on the Edit/Write hot path. Returned in anchoring\n    order (CWD-form first) so callers pick the historical rel when both\n    land inside the repo (the CWD==repo_root common case → one entry).\n\n    TOTAL by construction (PLAN-160 finding-A blocker, codex + security\n    pair-rail): every resolve is caught with a BROAD ``except Exception``.\n    ``Path.resolve()`` raises ``RuntimeError`` — NOT ``ValueError``/``OSError``\n    — on a symlink loop; if that propagated, ``_is_canonical`` would raise,\n    and a raising candidate in the multi-candidate scan would route through\n    ``decide()`` and the outer handler would fail-OPEN (allow) the whole\n    event — a gate-bypass strictly worse than HEAD. An unresolvable path is\n    simply non-canonical here (its write fails at the OS anyway); the other\n    candidates in a multi-candidate event are still scanned and gated.\n    \"\"\"\n    p = Path(path_str)\n    try:\n        root_resolved = repo_root.resolve()\n    except Exception:\n        return []\n    anchorings = [p]\n    if not p.is_absolute():\n        anchorings.append(repo_root / p)\n    rels: List[str] = []\n    for cand in anchorings:\n        try:\n            rels.append(\n                str(cand.resolve().relative_to(root_resolved)).replace(os.sep, \"/\")\n            )\n        except Exception:\n            continue\n    return rels\n\n\n\ndef _matches_canonical_guard(rel_str: str) -> bool:\n    \"\"\"True if a repo-relative POSIX path matches a canonical guard pattern.\n\n    Split out of ``_is_canonical`` (PLAN160_FIX_D) so the identical\n    fast-path prefix check + glob loop runs against each candidate path\n    anchoring without duplication. PLAN-025 F-perf-004 fast-path preserved.\n\n    PLAN162_FIX_CASEFOLD: the rel and the patterns are compared\n    case-INSENSITIVELY (see the module note above) — on APFS the case\n    variant addresses the very same inode.\n    \"\"\"\n    rel_folded = rel_str.lower()\n    # Fast path: check the first path segment against known prefixes.\n    first_seg = rel_folded.split(\"/\", 1)[0]\n    if first_seg not in _CANONICAL_PREFIXES_FOLDED:\n        return False\n    for pattern in _CANONICAL_GUARDS_FOLDED:\n        if _fnmatch_segments(rel_folded, pattern):\n            return True\n    return False\n\n\n\ndef _canonical_rel(path_str: str, repo_root: Path) -> Optional[str]:\n    \"\"\"The repo-relative form of ``path_str`` that matches a canonical\n    guard, or ``None`` if no anchoring is canonical.\n\n    PLAN160_FIX_D: single source of truth for canonicality AND the\n    repo-relative form used downstream (decide() sentinel matching,\n    ``_candidate_is_granted``), so a canonical path is ALWAYS paired with\n    the exact rel that classified it — the CWD-anchored ``decide()`` resolve\n    could otherwise raise on a repo_root-anchored canonical path and route a\n    clean sentinel-block through finding C's fault branch instead.\n    \"\"\"\n    for rel_str in _repo_rels(path_str, repo_root):\n        if _matches_canonical_guard(rel_str):\n            return rel_str\n    return None\n\n\n\ndef _is_canonical(path_str: str, repo_root: Path) -> bool:\n    \"\"\"True if path_str matches one of the canonical guard patterns.\n\n    Thin wrapper over ``_canonical_rel`` (PLAN160_FIX_D). NOTE: this is a\n    SHARED predicate (hook Layer-A, the ``--is-canonical`` CLI oracle, and\n    ``_candidate_is_granted``); the finding-D change WIDENS classification\n    (relative paths from a foreign CWD now classify canonical → more\n    blocks), never narrows it — see the ADR.\n    \"\"\"\n    return _canonical_rel(path_str, repo_root) is not None\n\n\n\ndef _fnmatch_segments(path: str, pattern: str) -> bool:\n    \"\"\"Segment-wise glob matcher.\n\n    - ``*`` matches exactly one path segment (any non-slash content).\n    - ``**`` matches zero or more path segments (Sprint 9 amendment).\n    - Literal segments must match exactly.\n    \"\"\"\n    p_parts = path.split(\"/\")\n    pat_parts = pattern.split(\"/\")\n    return _match_segments(p_parts, pat_parts)\n\n\n\ndef _match_segments(p_parts: List[str], pat_parts: List[str]) -> bool:\n    \"\"\"Recursive glob with ``**`` zero-or-more support.\n\n    Per-segment patterns support full fnmatch semantics (so\n    patterns like *.py, *.yaml, or ADR-*.md match one\n    segment with a wildcard stem). ** still means zero-or-more\n    segments.\n    \"\"\"\n    if not pat_parts:\n        return not p_parts\n    head, rest = pat_parts[0], pat_parts[1:]\n    if head == \"**\":\n        # Zero-or-more: try consuming 0..len(p_parts) segments\n        for i in range(len(p_parts) + 1):\n            if _match_segments(p_parts[i:], rest):\n                return True\n        return False\n    if not p_parts:\n        return False\n    # Bare-* is equivalent to fnmatch \"*\", but we keep the explicit\n    # branch for readability. fnmatch.fnmatchcase does case-sensitive\n    # glob on a single segment (no \"/\" traversal).\n    if head == \"*\" or fnmatch.fnmatchcase(p_parts[0], head):\n        return _match_segments(p_parts[1:], rest)\n    return False\n\n\n\ndef _find_sentinels(repo_root: Path) -> List[Path]:\n    \"\"\"Find all valid Architect sentinel files in the repo.\n\n    PLAN-045 Wave 1 F-01-04: reject any sentinel that is a symlink or\n    whose immediate parent directory is a symlink. Mirrors the\n    ``_validate_skill_reference`` hardening pattern (ADR-051 sub-check\n    5). Silently drops symlinked entries — an attacker who plants\n    ``PLAN-EVIL/architect/round-1/approved.md -> /tmp/evil`` no longer\n    gets their sentinel considered.\n    \"\"\"\n    base = repo_root / \".claude\" / \"plans\"\n    if not base.is_dir():\n        return []\n    # PLAN-085 Wave E.1 — explicit pattern union + grandfather allowlist\n    # (R1 Sec-3). NO catch-all wildcard. Novel architect/* subdirs not\n    # listed below are treated as ORPHAN, NOT TRUSTED.\n    _PATTERNS = (\n        \"PLAN-*/architect/round-*/approved.md\",\n        \"PLAN-*/architect/wave-0a/approved.md\",      # PLAN-083 grandfather\n        \"PLAN-*/architect/wave-0b/approved.md\",      # PLAN-083 grandfather\n        \"PLAN-*/architect/wave-1-2/approved.md\",     # PLAN-083 grandfather\n        \"PLAN-*/architect/wave-minus-1/approved.md\", # PLAN-083 grandfather\n        \"PLAN-*/staging/review/approved.md\",         # PLAN-083 grandfather\n        \"PLAN-*/approved.md\",                        # plan-root sentinels\n        \"PLAN-*/wave-*-approved.md\",                 # S109 wave-N-approved.md\n        \"PLAN-*/approved-amendment-*.md\",            # E.5 amendment files\n        \"PLAN-*/audit-v2/architect/round-*/approved.md\",  # PLAN-044 audit-v2 historical\n    )\n    seen: set = set()\n    candidates: list = []\n    for pat in _PATTERNS:\n        for c in sorted(base.glob(pat)):\n            if c not in seen:\n                seen.add(c)\n                candidates.append(c)\n    # PLAN162_FIX_2 (PLAN-162 finding #2, consensus C9) — the symlink\n    # rejection must be DEPTH-INDEPENDENT.\n    #\n    # HEAD checked exactly three levels (``p``, ``p.parent``,\n    # ``p.parent.parent``), hard-coded to the depth of\n    # ``PLAN-*/architect/round-*/approved.md``. The ``PLAN-*`` segment one\n    # level further up was never checked, so\n    # ``.claude/plans/PLAN-EVIL -> /tmp/evil`` smuggled a foreign\n    # ``architect/round-1/approved.md`` into the TRUSTED sentinel set —\n    # every intermediate directory is a real directory INSIDE the link\n    # target, so all three checks passed.\n    #\n    # \"Cover the real depth of the patterns\" was rejected in debate: it\n    # re-couples the guard to the pattern list, and the next 6-segment\n    # pattern silently reopens the hole (the dead-gate class this file has\n    # already suffered twice). Instead we do both depth-free checks:\n    #\n    #   (a) walk EVERY segment from ``p`` up to (excluding) ``base``,\n    #       rejecting any symlinked component; and\n    #   (b) assert ``realpath(p)`` stays under ``realpath(base)``, which\n    #       also catches a symlink that resolves out of the tree without a\n    #       symlinked component we happen to walk.\n    #\n    # RESIDUAL, deliberately not closed here: a symlink at ``base`` itself\n    # (``.claude/plans``) satisfies both forms — (a) excludes base and (b)\n    # resolves base through the same link. Named in the W1 instrument;\n    # pinning today's behaviour there would pin a bypass.\n    try:\n        base_rp = os.path.realpath(str(base))\n    except Exception:\n        return []\n    safe: List[Path] = []\n    for p in candidates:\n        try:\n            # (a) depth-free ancestor walk: p, then every directory above\n            # it, up to but not including `base`. A bound of 64 hops is a\n            # runaway guard, never a semantic limit (real sentinels sit 2-4\n            # levels under base).\n            node = p\n            contained = False\n            for _hop in range(64):\n                if node.is_symlink():\n                    break\n                parent = node.parent\n                if parent == node:  # walked past the filesystem root\n                    break\n                if parent == base:\n                    contained = True\n                    break\n                node = parent\n            if not contained:\n                continue\n            # (b) realpath containment — independent of how many segments\n            # the pattern happens to have.\n            p_rp = os.path.realpath(str(p))\n            if not p_rp.startswith(base_rp + os.sep):\n                continue\n        except OSError:\n            continue\n        safe.append(p)\n    return safe\n","numLines":318,"startLine":1,"totalLines":318}},"tool_result_meta":[{"id":"toolu_016nHDx6VcXtKwA7tgU8Cphj","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
