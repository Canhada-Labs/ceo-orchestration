{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PW9gayvafY7rRLMckaPnhU","type":"tool_result","content":"1\t\"\"\"Sentinel scope, signature caches and unlock provenance.\n2\t\n3\tFunctions are bound to the owning hook namespace by ``bind``. This keeps\n4\tits injectable dependencies and per-import state on the public hook.\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_parse_scope_paths_from_text', '_sentinel_cache_disabled', '_compute_sentinel_cache_key', '_file_digest', '_compute_sig_cache_key', 'sentinel_cache_stats', '_signature_rail_ok', '_repo_root_for_sentinels', '_reset_unlock_trust_diag', '_note_unlock_trust_diag', '_git_anchor_timeout', '_anchored_blob_text', '_pinned_sentinel_digests', '_unlock_trusted_text', '_unlock_trust_hint', '_sentinel_grants_path')\n9\t\n10\t\n11\tdef _parse_scope_paths_from_text(scope_text: str) -> \"Set[str]\":\n12\t    \"\"\"Extract declared canonical paths from a Scope block.\n13\t\n14\t    PLAN-064 Option D — extracted helper used by both Tier-1 (marker\n15\t    region) and Tier-2 (legacy `_SCOPE_HEADER_RE`) parser paths.\n16\t\n17\t    The Scope block extends from the `Scope` header line to the first\n18\t    top-level continuation header (Effective:, Plans:, Rationale,\n19\t    Authorization source:, Anchor commit:, a re-encountered\n20\t    `Approved-By:`) or markdown horizontal rule (---, ***, ___) or\n21\t    end-of-text. Sub-headers within Scope (lines ending with `:` that\n22\t    are NOT in the terminator set) are silently skipped.\n23\t    \"\"\"\n24\t    import os as _os\n25\t    declared_paths: Set[str] = set()\n26\t    scope_header = _SCOPE_HEADER_RE.search(scope_text)\n27\t    if not scope_header:\n28\t        return declared_paths\n29\t    post = scope_text[scope_header.end():]\n30\t    for line in post.splitlines():\n31\t        if _SCOPE_TERMINATOR_RE.match(line) or _SCOPE_HR_RE.match(line):\n32\t            break\n33\t        m = re.match(r\"\\s*-\\s*(\\S+)\", line)\n34\t        if not m:\n35\t            # Blank line or sub-header (e.g. \"Hook code (PLAN-052):\") —\n36\t            # keep collecting; only the explicit terminators stop us.\n37\t            continue\n38\t        raw = m.group(1)\n39\t        # PLAN-024 F-sec-003 P1 fix: reject any control-char in scope\n40\t        # entries (bidi, null, ANSI escape, etc.) before normalization.\n41\t        if any(ord(c) < 0x20 for c in raw):\n42\t            continue\n43\t        # Normalize `./foo/bar` -> `foo/bar` and strip any ending\n44\t        # separator so sentinel-declared paths match target_rel\n45\t        # resolution consistently.\n46\t        normalized = _os.path.normpath(raw).replace(_os.sep, \"/\")\n47\t        if normalized == \".\":\n48\t            continue\n49\t        declared_paths.add(normalized)\n50\t    return declared_paths\n51\t\n52\t\n53\t\n54\tdef _sentinel_cache_disabled() -> bool:\n55\t    \"\"\"Kill-switch CEO_SENTINEL_SESSION_CACHE_DISABLED=1 bypasses cache.\"\"\"\n56\t    return os.environ.get(\"CEO_SENTINEL_SESSION_CACHE_DISABLED\", \"\") == \"1\"\n57\t\n58\t\n59\t\n60\tdef _compute_sentinel_cache_key(\n61\t    sentinel_path: Path,\n62\t    target_rel: str = \"\",\n63\t) -> Optional[Tuple[str, int, int, int, str, str, int]]:\n64\t    \"\"\"Return composite key or None on stat/read failure (don't cache errors).\n65\t\n66\t    iter-1 P0 fix: target_rel included so cache value (grant decision\n67\t    dependent on target_rel) is correct on hit.\n68\t    \"\"\"\n69\t    try:\n70\t        st = sentinel_path.stat()\n71\t        content = sentinel_path.read_bytes()\n72\t    except OSError:\n73\t        return None\n74\t    return (\n75\t        str(sentinel_path),\n76\t        st.st_ino,\n77\t        st.st_mtime_ns,\n78\t        st.st_size,\n79\t        hashlib.sha256(content).hexdigest(),\n80\t        target_rel,\n81\t        _SENTINEL_CACHE_FORMAT_VERSION,\n82\t    )\n83\t\n84\t\n85\t\n86\tdef _file_digest(path: Optional[Path]) -> str:\n87\t    \"\"\"sha256 of a file's bytes, or a stable marker when unreadable.\n88\t\n89\t    PLAN162_FIX_1 helper. ``\"-\"`` distinguishes \"no such file\" from any\n90\t    real digest, so a signer allowlist APPEARING (or vanishing) changes\n91\t    the signature cache key just like editing it does.\n92\t    \"\"\"\n93\t    if path is None:\n94\t        return \"-\"\n95\t    try:\n96\t        return hashlib.sha256(path.read_bytes()).hexdigest()\n97\t    except OSError:\n98\t        return \"-\"\n99\t\n100\t\n101\t\n102\tdef _compute_sig_cache_key(sentinel_path: Path) -> Optional[tuple]:\n103\t    \"\"\"Target-FREE key over everything the SIGNATURE decision depends on.\n104\t\n105\t    PLAN162_FIX_1 (#1 partition + #10 staleness). Covers the sentinel's\n106\t    own identity/bytes AND the three signing-material inputs — the\n107\t    detached ``.asc``, the legacy signer allowlist, and the ADR-121 YAML\n108\t    registry — plus the PATH of the latter two (they are module-level\n109\t    seams; a different file is a different decision).\n110\t\n111\t    Returns ``None`` on stat/read failure of the sentinel itself, which\n112\t    means \"do not cache\" — errors are never memoized.\n113\t    \"\"\"\n114\t    try:\n115\t        st = sentinel_path.stat()\n116\t        content = sentinel_path.read_bytes()\n117\t    except OSError:\n118\t        return None\n119\t    sig_path = sentinel_path.with_name(sentinel_path.name + \".asc\")\n120\t    return (\n121\t        str(sentinel_path),\n122\t        st.st_ino,\n123\t        st.st_mtime_ns,\n124\t        st.st_size,\n125\t        hashlib.sha256(content).hexdigest(),\n126\t        _file_digest(sig_path),\n127\t        str(_SENTINEL_SIGNERS_FILE),\n128\t        _file_digest(_SENTINEL_SIGNERS_FILE),\n129\t        str(_SENTINEL_SIGNERS_REGISTRY_YAML),\n130\t        _file_digest(_SENTINEL_SIGNERS_REGISTRY_YAML),\n131\t        _SIG_CACHE_FORMAT_VERSION,\n132\t    )\n133\t\n134\t\n135\t\n136\tdef sentinel_cache_stats() -> Dict[str, int]:\n137\t    \"\"\"Return session-scoped cache counters (skill_cache_stats sibling).\"\"\"\n138\t    return {\n139\t        \"hit_count\": _SENTINEL_CACHE_HITS,\n140\t        \"miss_count\": _SENTINEL_CACHE_MISSES,\n141\t        \"size\": len(_SENTINEL_VERIFY_CACHE),\n142\t    }\n143\t\n144\t\n145\t\n146\tdef _signature_rail_ok(sentinel_path: Path) -> bool:\n147\t    \"\"\"``_verify_signature_rail`` behind the target-FREE signature cache.\n148\t\n149\t    PLAN162_FIX_1: this is the O(sentinels) rail. The caller's grant\n150\t    lookup stays O(sentinels x targets) but is pure string work.\n151\t    \"\"\"\n152\t    if _sentinel_cache_disabled():\n153\t        return _verify_signature_rail(sentinel_path)\n154\t    sig_key = _compute_sig_cache_key(sentinel_path)\n155\t    if sig_key is None:\n156\t        return _verify_signature_rail(sentinel_path)\n157\t    cached = _SIG_VERIFY_CACHE.get(sig_key)\n158\t    if cached is not None:\n159\t        return cached\n160\t    result = _verify_signature_rail(sentinel_path)\n161\t    if _WALL_BUDGET_EXHAUSTED:\n162\t        # PLAN162_FIX_1 (Codex P1 fold): a budget REFUSAL is not a verdict\n163\t        # on this sentinel — memoizing it would poison the signature cache\n164\t        # for the rest of the process with a `False` no gpg ever produced.\n165\t        # Same contract as the `sig_key is None` path above: errors and\n166\t        # non-verdicts are never cached.\n167\t        return result\n168\t    _SIG_VERIFY_CACHE[sig_key] = result\n169\t    return result\n170\t\n171\t\n172\t\n173\tdef _repo_root_for_sentinels() -> Path:\n174\t    \"\"\"Repo root, resolved exactly as ``main()`` resolves it.\"\"\"\n175\t    return Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n176\t\n177\t\n178\t\n179\tdef _reset_unlock_trust_diag() -> None:\n180\t    global _UNLOCK_TRUST_DIAG\n181\t    _UNLOCK_TRUST_DIAG = None\n182\t\n183\t\n184\t\n185\tdef _note_unlock_trust_diag(code: str) -> None:\n186\t    global _UNLOCK_TRUST_DIAG\n187\t    if _UNLOCK_TRUST_DIAG is None:\n188\t        _UNLOCK_TRUST_DIAG = code\n189\t\n190\t\n191\t\n192\tdef _git_anchor_timeout() -> Optional[float]:\n193\t    \"\"\"Subprocess timeout for ONE ``git cat-file`` anchor probe.\n194\t\n195\t    PLAN162_FIX_S2R2 (codex P1-2). Same shape and the same two constants\n196\t    as ``_gpg_verify_timeout``: the probe must finish AND leave room to\n197\t    emit. ``None`` means DO NOT SPAWN — callers translate that into\n198\t    fail-CLOSED plus a latched budget, never into an allow and never into\n199\t    a fork the harness kills mid-flight.\n200\t    \"\"\"\n201\t    if _WALL_DEADLINE_AT is None:\n202\t        return _GIT_ANCHOR_TIMEOUT_CAP_S\n203\t    usable = (_WALL_DEADLINE_AT - _now()) - _GPG_EMIT_MARGIN_S\n204\t    if usable < _GPG_MIN_SPAWN_S:\n205\t        return None\n206\t    return min(_GIT_ANCHOR_TIMEOUT_CAP_S, usable)\n207\t\n208\t\n209\t\n210\tdef _anchored_blob_text(repo_root: Path, anchor: str, rel: str) -> Optional[str]:\n211\t    \"\"\"Text of ``rel`` AS OF ``anchor``, or ``None`` when unprovable.\"\"\"\n212\t    cache_key = (str(repo_root), anchor, rel)\n213\t    if cache_key in _ANCHOR_BLOB_CACHE:\n214\t        return _ANCHOR_BLOB_CACHE[cache_key]\n215\t    timeout = _git_anchor_timeout()\n216\t    if timeout is None:\n217\t        # P1-2: refuse the spawn and latch, so the caller's next deadline\n218\t        # poll produces the fail-closed wall-deadline block instead of a\n219\t        # harness kill. NOT memoized — a budget refusal is not a verdict.\n220\t        _mark_wall_budget_exhausted()\n221\t        return None\n222\t    try:\n223\t        proc = subprocess.run(\n224\t            [\"git\", \"-C\", str(repo_root), \"cat-file\", \"blob\",\n225\t             \"{0}:{1}\".format(anchor, rel)],\n226\t            stdout=subprocess.PIPE,\n227\t            stderr=subprocess.DEVNULL,\n228\t            timeout=timeout,\n229\t        )\n230\t    except Exception:\n231\t        # git missing / hung / unusable: the work tree says the proof\n232\t        # mechanism SHOULD exist, so an unusable one is fail-CLOSED.\n233\t        return None\n234\t    if proc.returncode != 0:\n235\t        _ANCHOR_BLOB_CACHE[cache_key] = None\n236\t        return None\n237\t    try:\n238\t        text = proc.stdout.decode(\"utf-8\")\n239\t    except Exception:\n240\t        _ANCHOR_BLOB_CACHE[cache_key] = None\n241\t        return None\n242\t    _ANCHOR_BLOB_CACHE[cache_key] = text\n243\t    return text\n244\t\n245\t\n246\t\n247\tdef _pinned_sentinel_digests(src_env) -> Tuple[Set[str], bool]:\n248\t    \"\"\"``(digests, malformed)`` from ``CEO_SENTINEL_UNLOCK_SHA256``.\n249\t\n250\t    Empty + not-malformed means \"the Owner pinned nothing\" (rail B\n251\t    decides). ANY unparseable token makes the whole value malformed:\n252\t    a typo'd trust input is never silently narrowed to the tokens that\n253\t    happened to parse.\n254\t    \"\"\"\n255\t    raw = (src_env.get(_UNLOCK_DIGEST_ENV) or \"\").strip()\n256\t    if not raw:\n257\t        return (set(), False)\n258\t    tokens = [t for t in re.split(r\"[,\\s]+\", raw) if t]\n259\t    digests = set()  # type: Set[str]\n260\t    for token in tokens:\n261\t        if not _SHA256_RE.match(token):\n262\t            return (set(), True)\n263\t        digests.add(token.lower())\n264\t    return (digests, not digests)\n265\t\n266\t\n267\t\n268\tdef _unlock_trusted_text(sentinel_path: Path, env=None) -> Tuple[bool, Optional[str]]:\n269\t    \"\"\"``(authorized, text_to_parse)`` for ONE sentinel under an unlock.\n270\t\n271\t    PLAN162_FIX_S2 / PLAN162_FIX_S2R2. Consulted ONLY on the\n272\t    ``env_override`` path, where the GPG rail is skipped entirely and the\n273\t    only thing separating an Owner-signed sentinel from one the AGENT\n274\t    just wrote is provenance.\n275\t\n276\t    ``text_to_parse`` is ``None`` for \"parse what is on disk\" — returned\n277\t    only by the two paths where disk bytes ARE the authorized bytes: an\n278\t    Owner-pinned digest (which covers exactly those bytes) and the\n279\t    non-git residual.\n280\t    \"\"\"\n281\t    src_env = env if env is not None else os.environ\n282\t    repo_root = _repo_root_for_sentinels()\n283\t\n284\t    # ---- Rail A: the Owner pinned this sentinel's CONTENT (P1-3) ----\n285\t    pinned, malformed = _pinned_sentinel_digests(src_env)\n286\t    if malformed:\n287\t        _note_unlock_trust_diag(\"digest_malformed\")\n288\t        return (False, None)\n289\t    if pinned:\n290\t        try:\n291\t            raw = sentinel_path.read_bytes()\n292\t        except OSError:\n293\t            _note_unlock_trust_diag(\"sentinel_unreadable\")\n294\t            return (False, None)\n295\t        if hashlib.sha256(raw).hexdigest() in pinned:\n296\t            try:\n297\t                return (True, raw.decode(\"utf-8\"))\n298\t            except Exception:\n299\t                _note_unlock_trust_diag(\"sentinel_undecodable\")\n300\t                return (False, None)\n301\t        # A pin that does not cover THIS sentinel is not a verdict on the\n302\t        # others: fall through to the anchor rail, or the pack's\n303\t        # pre-existing sentinels would be self-DoS'd by pinning one file.\n304\t        _note_unlock_trust_diag(\"digest_mismatch\")\n305\t\n306\t    # ---- Rail B: the sentinel predates the session (anchored bytes) ----\n307\t    try:\n308\t        is_git = (repo_root / \".git\").exists()\n309\t    except OSError:\n310\t        is_git = False\n311\t    if not is_git:\n312\t        return (True, None)  # documented residual: no anchor mechanism\n313\t    anchor = (src_env.get(_SESSION_ANCHOR_ENV) or \"\").strip()\n314\t    if not _ANCHOR_SHA_RE.match(anchor):\n315\t        _note_unlock_trust_diag(\"anchor_missing\" if not anchor else \"anchor_malformed\")\n316\t        return (False, None)\n317\t    try:\n318\t        rel = str(sentinel_path.relative_to(repo_root)).replace(os.sep, \"/\")\n319\t    except ValueError:\n320\t        # A sentinel outside the repo root can never be anchored.\n321\t        _note_unlock_trust_diag(\"sentinel_outside_repo\")\n322\t        return (False, None)\n323\t    text = _anchored_blob_text(repo_root, anchor, rel)\n324\t    if text is None:\n325\t        _note_unlock_trust_diag(\"not_anchored\")\n326\t        return (False, None)\n327\t    # P1-1: the ANCHORED bytes are the authorization, not the bytes an\n328\t    # in-window writer left at that path.\n329\t    return (True, text)\n330\t\n331\t\n332\t\n333\tdef _unlock_trust_hint() -> str:\n334\t    \"\"\"Teaching suffix for a block an armed unlock window could not lift.\n335\t\n336\t    PLAN162_FIX_S2R2 (codex P1-3). Without this, the operator whose\n337\t    recovery route just started failing closed reads \"declare the path in\n338\t    the Scope: block\" about a path that IS declared, and has no way to\n339\t    learn which value is missing. Empty string when the unlock rail was\n340\t    never the reason.\n341\t    \"\"\"\n342\t    if _UNLOCK_TRUST_DIAG is None:\n343\t        return \"\"\n344\t    return (\n345\t        \"\\n\\nUNLOCK WINDOW ARMED, NO TRUSTED SENTINEL ({diag}). Inside a \"\n346\t        \"CEO_SENTINEL_UNLOCK window the GPG rail is skipped, so a sentinel \"\n347\t        \"must prove it was not written by the agent, by ONE of:\\n\"\n348\t        \"  (a) predating the session — export {anchor}=<sha of a commit \"\n349\t        \"taken BEFORE this agent session started>; capture it in your own \"\n350\t        \"shell (`git rev-parse HEAD`) before launching, never after;\\n\"\n351\t        \"  (b) Owner-pinned content — export {digest}=<sha256 of the \"\n352\t        \"approved.md>, e.g. `shasum -a 256 <approved.md> | cut -d' ' -f1` \"\n353\t        \"(space- or comma-separate several).\\n\"\n354\t        \"See ADR-119 Invariant 5.\"\n355\t    ).format(\n356\t        diag=_UNLOCK_TRUST_DIAG,\n357\t        anchor=_SESSION_ANCHOR_ENV,\n358\t        digest=_UNLOCK_DIGEST_ENV,\n359\t    )\n360\t\n361\t\n362\t\n363\tdef _sentinel_grants_path(sentinel_path: Path, target_rel: str) -> bool:\n364\t    \"\"\"Check whether a sentinel file grants the given target path.\n365\t\n366\t    PLAN-045 Wave 1 P0-01: verification is now two-tiered:\n367\t\n368\t    1. **Plaintext ``Approved-By:`` line** — existing fast check (visual\n369\t       Owner signoff marker).\n370\t    2. **Detached GPG signature** at ``<sentinel>.asc`` — verified\n371\t       against ``.claude/sentinel-signers.txt`` allowlist via\n372\t       ``_lib.gpg_verify.verify_detached``. Fail-CLOSED on: missing\n373\t       .asc, bad signature, signer fpr not in allowlist, empty\n374\t       allowlist.\n375\t\n376\t    **Environment bypass (interim, per ADR-010 amendment)**: setting\n377\t    ``CEO_SENTINEL_UNLOCK=<plan-id>`` + ``CEO_SENTINEL_UNLOCK_ACK=I-ACCEPT``\n378\t    in the parent shell short-circuits the .asc requirement. This is a\n379\t    dual-auth mechanism mirroring the arbitration-kernel escape hatch;\n380\t    a sub-agent cannot forge the env vars. The override is logged via\n381\t    ``veto_triggered(reason_code=sentinel_unlock_used)``.\n382\t\n383\t    The sentinel must contain:\n384\t    1. A valid ``Approved-By: @<handle> <commit-sha>`` line\n385\t    2. A ``Scope:`` block listing the target path (one bullet per line)\n386\t    3. A sibling ``<sentinel>.asc`` detached GPG signature (unless env\n387\t       override is set)\n388\t    \"\"\"\n389\t    # PLAN-094 Wave C — session cache fast-path before expensive GPG verify.\n390\t    # Cache key (iter-1 P0 fix): (path, inode, mtime_ns, file_size, sha256_full,\n391\t    # target_rel, fmt_version). Cache value: granted (bool). env_override path\n392\t    # bypasses cache (CEO_SENTINEL_UNLOCK semantic: must re-verify).\n393\t    global _SENTINEL_CACHE_HITS, _SENTINEL_CACHE_MISSES\n394\t\n395\t    # PLAN-045 Wave 1 P0-01: env-override (CEO_SENTINEL_UNLOCK) detection.\n396\t    env = os.environ\n397\t    unlock_reason = (env.get(\"CEO_SENTINEL_UNLOCK\") or \"\").strip()\n398\t    unlock_ack = (env.get(\"CEO_SENTINEL_UNLOCK_ACK\") or \"\").strip()\n399\t    env_override = bool(\n400\t        unlock_reason\n401\t        and unlock_ack == \"I-ACCEPT\"\n402\t        and re.match(r'^(ADR-\\d{3,4}|PLAN-\\d{3})-[a-z0-9-]{3,100}$', unlock_reason)  # PLAN-086 Wave I.1 — ADR-119 tightening\n403\t    )\n404\t\n405\t    # PLAN162_FIX_1 — SIGNATURE RAIL FIRST, and it is target-FREE.\n406\t    #\n407\t    # Two reasons the order changed (both are the fix):\n408\t    #   * #1 — verifying once per SENTINEL instead of once per\n409\t    #     (sentinel x target) is the whole amplification collapse; and\n410\t    #   * #10 — the target-keyed grant cache below hashes only\n411\t    #     approved.md, so a mutated .asc / allowlist / registry would ride\n412\t    #     a stale True if the grant fast-path ran first. Consulting the\n413\t    #     material-keyed rail up front makes a revocation land immediately.\n414\t    _trusted_text = None  # type: Optional[str]\n415\t    if not env_override:\n416\t        if not _signature_rail_ok(sentinel_path):\n417\t            return False\n418\t    else:\n419\t        # PLAN162_FIX_S2 — inside an unlock window the GPG rail is skipped\n420\t        # entirely, so the only thing separating an Owner-signed sentinel\n421\t        # from one the AGENT just wrote is provenance. See the module note\n422\t        # above for the two proof forms and the residual.\n423\t        _authorized, _trusted_text = _unlock_trusted_text(sentinel_path, env=env)\n424\t        if not _authorized:\n425\t            return False\n426\t\n427\t    # PLAN-094 Wave C — session cache fast-path (now scope-only).\n428\t    # Cache key (iter-1 P0 fix): (path, inode, mtime_ns, file_size, sha256_full,\n429\t    # target_rel, fmt_version). Cache value: granted (bool). env_override path\n430\t    # bypasses cache (CEO_SENTINEL_UNLOCK semantic: must re-verify).\n431\t    _cache_key = None\n432\t    if not _sentinel_cache_disabled() and not env_override:\n433\t        _cache_key = _compute_sentinel_cache_key(sentinel_path, target_rel)\n434\t        if _cache_key is not None:\n435\t            _cached = _SENTINEL_VERIFY_CACHE.get(_cache_key)\n436\t            if _cached is not None:\n437\t                _SENTINEL_CACHE_HITS += 1\n438\t                return _cached\n439\t            _SENTINEL_CACHE_MISSES += 1\n440\t\n441\t    # PLAN162_FIX_S2R2 (codex P1-1): under an unlock window the bytes that\n442\t    # decide are the ANCHORED bytes, never whatever an in-window writer\n443\t    # left at that path. ``None`` means \"disk bytes ARE the authorized\n444\t    # bytes\" (Owner-pinned digest, or the non-git residual).\n445\t    if _trusted_text is not None:\n446\t        text = _trusted_text\n447\t    else:\n448\t        try:\n449\t            text = sentinel_path.read_text(encoding=\"utf-8\")\n450\t        except OSError:\n451\t            return False\n452\t\n453\t    # Check plaintext signature marker first (cheap).\n454\t    if not _APPROVED_BY_RE.search(text):\n455\t        return False\n456\t\n457\t    # Parse Scope: block.\n458\t    #\n459\t    # PLAN-064 Option D (DIM-13 closure, 2026-05-04) — tier-prioritized\n460\t    # parser:\n461\t    #   Tier 1: if HTML-comment markers <!-- BEGIN SIGNED SCOPE --> /\n462\t    #           <!-- END SIGNED SCOPE --> are present, parse Scope: ONLY\n463\t    #           from text between those markers. Lifecycle text outside\n464\t    #           the markers is ignored for grant decisions; it is\n465\t    #           documentation. The GPG `.asc` continues to cover the\n466\t    #           whole file (any tamper breaks the signature).\n467\t    #   Tier 2: if markers absent (legacy 44 sentinels at 2026-05-04),\n468\t    #           fall back to existing _SCOPE_HEADER_RE parser path\n469\t    #           below. No env flag — auto-detected.\n470\t    #\n471\t    # PLAN-044 audit-v2 C6-P0-04 (Tier 2 fallback) — supports two\n472\t    # on-disk formats:\n473\t    #\n474\t    # Format A (PLAN-050 round-17 era — single contiguous bullet list):\n475\t    #\n476\t    #     Scope:\n477\t    #       - .claude/path/one.md\n478\t    #       - .claude/path/two.md\n479\t    #\n480\t    # Format B (Session 67 mega-sentinel — categorized with sub-headers\n481\t    # and blank lines between groups):\n482\t    #\n483\t    #     Scope (24 canonical paths):\n484\t    #\n485\t    #     ADR canonical promotions (9 files, all from staging):\n486\t    #     - .claude/adr/ADR-083-...\n487\t    #     - .claude/adr/ADR-084-...\n488\t    #\n489\t    #     Hook code (PLAN-052):\n490\t    #     - .claude/hooks/_lib/foo.py (new)\n491\t    #     - .claude/hooks/check_bar.py (new)\n492\t    #\n493\t    # The Scope block extends from the `Scope` header line to the first\n494\t    # top-level continuation header (`Effective:`, `Plans:`, `Rationale`,\n495\t    # `Authorization source:`, `Anchor commit:`, a re-encountered\n496\t    # `Approved-By:`) or markdown horizontal rule (`---`, `***`, `___`)\n497\t    # or end-of-file. Sub-headers within Scope (lines ending with `:`\n498\t    # that are NOT in the terminator set) are silently skipped.\n499\t\n500\t    # ---- PLAN162_FIX_4 (finding #4, consensus C5 — narrowed) ----\n501\t    #\n502\t    # The original council proposal (\"parse ONLY inside the markers\")\n503\t    # would have bricked 31% of live sentinels: 5 of 16 carry no BEGIN\n504\t    # marker, including the two most recent ceremonies. What ships is\n505\t    # three narrow rules instead:\n506\t    #\n507\t    #   1. A BEGIN marker with no well-formed PAIR must NEVER silently\n508\t    #      downgrade to the Tier-2 whole-file parser. The code already\n509\t    #      fail-CLOSES on that exact principle for a marker region with an\n510\t    #      unparseable INTERIOR; a BEGIN with a missing/malformed END did\n511\t    #      the opposite, which is the containment loss #4 reported —\n512\t    #      Scope bullets OUTSIDE the Owner's intended region were honored.\n513\t    #   2. Oversize (> _SCOPE_MARKER_CAP_BYTES) REJECTS fail-closed\n514\t    #      rather than downgrading to Tier-2. Blast measured ~zero (the\n515\t    #      largest live sentinel is 6,801 B = 10.4% of the cap).\n516\t    #   3. The END marker terminates a Tier-2 Scope block (added to\n517\t    #      _SCOPE_TERMINATOR_RE), so a bullet placed AFTER an END in a\n518\t    #      marker-less file is no longer collected.\n519\t    #\n520\t    # CHARS-vs-BYTES, decided explicitly (C5 required a decision): the cap\n521\t    # is named in BYTES, so it is now measured in BYTES. HEAD compared\n522\t    # len(text) in CHARACTERS, which for a non-ASCII sentinel understated\n523\t    # the real size. Since oversize is now a REJECT (rule 2) rather than a\n524\t    # silent downgrade, the stricter of the two readings is also the\n525\t    # safer one.\n526\t    declared_paths: Set[str] = set()\n527\t    try:\n528\t        _text_bytes = len(text.encode(\"utf-8\", \"surrogatepass\"))\n529\t    except Exception:  # pragma: no cover - defensive\n530\t        _text_bytes = len(text)\n531\t    if _text_bytes > _SCOPE_MARKER_CAP_BYTES:\n532\t        # Rule 2 — fail-CLOSED. An oversize sentinel is not parsed by\n533\t        # EITHER tier; it is rejected.\n534\t        return False\n535\t    if _BEGIN_MARKER_RE.search(text):\n536\t        marker_match = _SCOPE_MARKER_RE.search(text)\n537\t        if marker_match is None:\n538\t            # Rule 1 — a BEGIN marker is an explicit (if broken) Owner\n539\t            # intent signal. Never Tier-2 behind its back.\n540\t            return False\n541\t        scope_region = marker_match.group(1)\n542\t        declared_paths = _parse_scope_paths_from_text(scope_region)\n543\t        # If markers present but no scope paths extracted (malformed\n544\t        # interior), fail-CLOSED rather than silently fall through\n545\t        # to Tier 2 — markers are an explicit Owner intent signal.\n546\t        if not declared_paths:\n547\t            return False\n548\t        granted = target_rel in declared_paths\n549\t        if granted and env_override:\n550\t            _emit_unlock_audit(target_rel, unlock_reason)\n551\t        # PLAN-094-FOLLOWUP Wave C-tier1 — store Tier-1 grant decision\n552\t        # in cache (parity with Tier-2 store path below). env_override\n553\t        # path is NOT cached (mirrors Tier-2 invariant).\n554\t        if (\n555\t            _cache_key is not None\n556\t            and not env_override\n557\t            and not _sentinel_cache_disabled()\n558\t        ):\n559\t            _SENTINEL_VERIFY_CACHE[_cache_key] = granted\n560\t        return granted\n561\t\n562\t    # Tier 2 — legacy _SCOPE_HEADER_RE parser (no markers in file).\n563\t    declared_paths = _parse_scope_paths_from_text(text)\n564\t    if not declared_paths:\n565\t        return False\n566\t\n567\t    granted = target_rel in declared_paths\n568\t    if granted and env_override:\n569\t        _emit_unlock_audit(target_rel, unlock_reason)\n570\t\n571\t    # PLAN-094 Wave C — store result into module-scope cache (NEVER file-backed).\n572\t    # env_override path is NOT cached (semantic: unlock env must always re-verify\n573\t    # to honor freshly-regenerated .asc files even when bytes are unchanged).\n574\t    if (\n575\t        _cache_key is not None\n576\t        and not env_override\n577\t        and not _sentinel_cache_disabled()\n578\t    ):\n579\t        _SENTINEL_VERIFY_CACHE[_cache_key] = granted\n580\t\n581\t    return granted\n582\t"}]},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"31e1e063-8b3b-417c-a174-b6223adb5923","timestamp":"2026-11-15T10:51:08.960Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/canonical_edit/sentinels.py","content":"\"\"\"Sentinel scope, signature caches and unlock provenance.\n\nFunctions are bound to the owning hook namespace by ``bind``. This keeps\nits injectable dependencies and per-import state on the public hook.\n\"\"\"\nfrom __future__ import annotations\n\n__all__ = ('_parse_scope_paths_from_text', '_sentinel_cache_disabled', '_compute_sentinel_cache_key', '_file_digest', '_compute_sig_cache_key', 'sentinel_cache_stats', '_signature_rail_ok', '_repo_root_for_sentinels', '_reset_unlock_trust_diag', '_note_unlock_trust_diag', '_git_anchor_timeout', '_anchored_blob_text', '_pinned_sentinel_digests', '_unlock_trusted_text', '_unlock_trust_hint', '_sentinel_grants_path')\n\n\ndef _parse_scope_paths_from_text(scope_text: str) -> \"Set[str]\":\n    \"\"\"Extract declared canonical paths from a Scope block.\n\n    PLAN-064 Option D — extracted helper used by both Tier-1 (marker\n    region) and Tier-2 (legacy `_SCOPE_HEADER_RE`) parser paths.\n\n    The Scope block extends from the `Scope` header line to the first\n    top-level continuation header (Effective:, Plans:, Rationale,\n    Authorization source:, Anchor commit:, a re-encountered\n    `Approved-By:`) or markdown horizontal rule (---, ***, ___) or\n    end-of-text. Sub-headers within Scope (lines ending with `:` that\n    are NOT in the terminator set) are silently skipped.\n    \"\"\"\n    import os as _os\n    declared_paths: Set[str] = set()\n    scope_header = _SCOPE_HEADER_RE.search(scope_text)\n    if not scope_header:\n        return declared_paths\n    post = scope_text[scope_header.end():]\n    for line in post.splitlines():\n        if _SCOPE_TERMINATOR_RE.match(line) or _SCOPE_HR_RE.match(line):\n            break\n        m = re.match(r\"\\s*-\\s*(\\S+)\", line)\n        if not m:\n            # Blank line or sub-header (e.g. \"Hook code (PLAN-052):\") —\n            # keep collecting; only the explicit terminators stop us.\n            continue\n        raw = m.group(1)\n        # PLAN-024 F-sec-003 P1 fix: reject any control-char in scope\n        # entries (bidi, null, ANSI escape, etc.) before normalization.\n        if any(ord(c) < 0x20 for c in raw):\n            continue\n        # Normalize `./foo/bar` -> `foo/bar` and strip any ending\n        # separator so sentinel-declared paths match target_rel\n        # resolution consistently.\n        normalized = _os.path.normpath(raw).replace(_os.sep, \"/\")\n        if normalized == \".\":\n            continue\n        declared_paths.add(normalized)\n    return declared_paths\n\n\n\ndef _sentinel_cache_disabled() -> bool:\n    \"\"\"Kill-switch CEO_SENTINEL_SESSION_CACHE_DISABLED=1 bypasses cache.\"\"\"\n    return os.environ.get(\"CEO_SENTINEL_SESSION_CACHE_DISABLED\", \"\") == \"1\"\n\n\n\ndef _compute_sentinel_cache_key(\n    sentinel_path: Path,\n    target_rel: str = \"\",\n) -> Optional[Tuple[str, int, int, int, str, str, int]]:\n    \"\"\"Return composite key or None on stat/read failure (don't cache errors).\n\n    iter-1 P0 fix: target_rel included so cache value (grant decision\n    dependent on target_rel) is correct on hit.\n    \"\"\"\n    try:\n        st = sentinel_path.stat()\n        content = sentinel_path.read_bytes()\n    except OSError:\n        return None\n    return (\n        str(sentinel_path),\n        st.st_ino,\n        st.st_mtime_ns,\n        st.st_size,\n        hashlib.sha256(content).hexdigest(),\n        target_rel,\n        _SENTINEL_CACHE_FORMAT_VERSION,\n    )\n\n\n\ndef _file_digest(path: Optional[Path]) -> str:\n    \"\"\"sha256 of a file's bytes, or a stable marker when unreadable.\n\n    PLAN162_FIX_1 helper. ``\"-\"`` distinguishes \"no such file\" from any\n    real digest, so a signer allowlist APPEARING (or vanishing) changes\n    the signature cache key just like editing it does.\n    \"\"\"\n    if path is None:\n        return \"-\"\n    try:\n        return hashlib.sha256(path.read_bytes()).hexdigest()\n    except OSError:\n        return \"-\"\n\n\n\ndef _compute_sig_cache_key(sentinel_path: Path) -> Optional[tuple]:\n    \"\"\"Target-FREE key over everything the SIGNATURE decision depends on.\n\n    PLAN162_FIX_1 (#1 partition + #10 staleness). Covers the sentinel's\n    own identity/bytes AND the three signing-material inputs — the\n    detached ``.asc``, the legacy signer allowlist, and the ADR-121 YAML\n    registry — plus the PATH of the latter two (they are module-level\n    seams; a different file is a different decision).\n\n    Returns ``None`` on stat/read failure of the sentinel itself, which\n    means \"do not cache\" — errors are never memoized.\n    \"\"\"\n    try:\n        st = sentinel_path.stat()\n        content = sentinel_path.read_bytes()\n    except OSError:\n        return None\n    sig_path = sentinel_path.with_name(sentinel_path.name + \".asc\")\n    return (\n        str(sentinel_path),\n        st.st_ino,\n        st.st_mtime_ns,\n        st.st_size,\n        hashlib.sha256(content).hexdigest(),\n        _file_digest(sig_path),\n        str(_SENTINEL_SIGNERS_FILE),\n        _file_digest(_SENTINEL_SIGNERS_FILE),\n        str(_SENTINEL_SIGNERS_REGISTRY_YAML),\n        _file_digest(_SENTINEL_SIGNERS_REGISTRY_YAML),\n        _SIG_CACHE_FORMAT_VERSION,\n    )\n\n\n\ndef sentinel_cache_stats() -> Dict[str, int]:\n    \"\"\"Return session-scoped cache counters (skill_cache_stats sibling).\"\"\"\n    return {\n        \"hit_count\": _SENTINEL_CACHE_HITS,\n        \"miss_count\": _SENTINEL_CACHE_MISSES,\n        \"size\": len(_SENTINEL_VERIFY_CACHE),\n    }\n\n\n\ndef _signature_rail_ok(sentinel_path: Path) -> bool:\n    \"\"\"``_verify_signature_rail`` behind the target-FREE signature cache.\n\n    PLAN162_FIX_1: this is the O(sentinels) rail. The caller's grant\n    lookup stays O(sentinels x targets) but is pure string work.\n    \"\"\"\n    if _sentinel_cache_disabled():\n        return _verify_signature_rail(sentinel_path)\n    sig_key = _compute_sig_cache_key(sentinel_path)\n    if sig_key is None:\n        return _verify_signature_rail(sentinel_path)\n    cached = _SIG_VERIFY_CACHE.get(sig_key)\n    if cached is not None:\n        return cached\n    result = _verify_signature_rail(sentinel_path)\n    if _WALL_BUDGET_EXHAUSTED:\n        # PLAN162_FIX_1 (Codex P1 fold): a budget REFUSAL is not a verdict\n        # on this sentinel — memoizing it would poison the signature cache\n        # for the rest of the process with a `False` no gpg ever produced.\n        # Same contract as the `sig_key is None` path above: errors and\n        # non-verdicts are never cached.\n        return result\n    _SIG_VERIFY_CACHE[sig_key] = result\n    return result\n\n\n\ndef _repo_root_for_sentinels() -> Path:\n    \"\"\"Repo root, resolved exactly as ``main()`` resolves it.\"\"\"\n    return Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n\n\n\ndef _reset_unlock_trust_diag() -> None:\n    global _UNLOCK_TRUST_DIAG\n    _UNLOCK_TRUST_DIAG = None\n\n\n\ndef _note_unlock_trust_diag(code: str) -> None:\n    global _UNLOCK_TRUST_DIAG\n    if _UNLOCK_TRUST_DIAG is None:\n        _UNLOCK_TRUST_DIAG = code\n\n\n\ndef _git_anchor_timeout() -> Optional[float]:\n    \"\"\"Subprocess timeout for ONE ``git cat-file`` anchor probe.\n\n    PLAN162_FIX_S2R2 (codex P1-2). Same shape and the same two constants\n    as ``_gpg_verify_timeout``: the probe must finish AND leave room to\n    emit. ``None`` means DO NOT SPAWN — callers translate that into\n    fail-CLOSED plus a latched budget, never into an allow and never into\n    a fork the harness kills mid-flight.\n    \"\"\"\n    if _WALL_DEADLINE_AT is None:\n        return _GIT_ANCHOR_TIMEOUT_CAP_S\n    usable = (_WALL_DEADLINE_AT - _now()) - _GPG_EMIT_MARGIN_S\n    if usable < _GPG_MIN_SPAWN_S:\n        return None\n    return min(_GIT_ANCHOR_TIMEOUT_CAP_S, usable)\n\n\n\ndef _anchored_blob_text(repo_root: Path, anchor: str, rel: str) -> Optional[str]:\n    \"\"\"Text of ``rel`` AS OF ``anchor``, or ``None`` when unprovable.\"\"\"\n    cache_key = (str(repo_root), anchor, rel)\n    if cache_key in _ANCHOR_BLOB_CACHE:\n        return _ANCHOR_BLOB_CACHE[cache_key]\n    timeout = _git_anchor_timeout()\n    if timeout is None:\n        # P1-2: refuse the spawn and latch, so the caller's next deadline\n        # poll produces the fail-closed wall-deadline block instead of a\n        # harness kill. NOT memoized — a budget refusal is not a verdict.\n        _mark_wall_budget_exhausted()\n        return None\n    try:\n        proc = subprocess.run(\n            [\"git\", \"-C\", str(repo_root), \"cat-file\", \"blob\",\n             \"{0}:{1}\".format(anchor, rel)],\n            stdout=subprocess.PIPE,\n            stderr=subprocess.DEVNULL,\n            timeout=timeout,\n        )\n    except Exception:\n        # git missing / hung / unusable: the work tree says the proof\n        # mechanism SHOULD exist, so an unusable one is fail-CLOSED.\n        return None\n    if proc.returncode != 0:\n        _ANCHOR_BLOB_CACHE[cache_key] = None\n        return None\n    try:\n        text = proc.stdout.decode(\"utf-8\")\n    except Exception:\n        _ANCHOR_BLOB_CACHE[cache_key] = None\n        return None\n    _ANCHOR_BLOB_CACHE[cache_key] = text\n    return text\n\n\n\ndef _pinned_sentinel_digests(src_env) -> Tuple[Set[str], bool]:\n    \"\"\"``(digests, malformed)`` from ``CEO_SENTINEL_UNLOCK_SHA256``.\n\n    Empty + not-malformed means \"the Owner pinned nothing\" (rail B\n    decides). ANY unparseable token makes the whole value malformed:\n    a typo'd trust input is never silently narrowed to the tokens that\n    happened to parse.\n    \"\"\"\n    raw = (src_env.get(_UNLOCK_DIGEST_ENV) or \"\").strip()\n    if not raw:\n        return (set(), False)\n    tokens = [t for t in re.split(r\"[,\\s]+\", raw) if t]\n    digests = set()  # type: Set[str]\n    for token in tokens:\n        if not _SHA256_RE.match(token):\n            return (set(), True)\n        digests.add(token.lower())\n    return (digests, not digests)\n\n\n\ndef _unlock_trusted_text(sentinel_path: Path, env=None) -> Tuple[bool, Optional[str]]:\n    \"\"\"``(authorized, text_to_parse)`` for ONE sentinel under an unlock.\n\n    PLAN162_FIX_S2 / PLAN162_FIX_S2R2. Consulted ONLY on the\n    ``env_override`` path, where the GPG rail is skipped entirely and the\n    only thing separating an Owner-signed sentinel from one the AGENT\n    just wrote is provenance.\n\n    ``text_to_parse`` is ``None`` for \"parse what is on disk\" — returned\n    only by the two paths where disk bytes ARE the authorized bytes: an\n    Owner-pinned digest (which covers exactly those bytes) and the\n    non-git residual.\n    \"\"\"\n    src_env = env if env is not None else os.environ\n    repo_root = _repo_root_for_sentinels()\n\n    # ---- Rail A: the Owner pinned this sentinel's CONTENT (P1-3) ----\n    pinned, malformed = _pinned_sentinel_digests(src_env)\n    if malformed:\n        _note_unlock_trust_diag(\"digest_malformed\")\n        return (False, None)\n    if pinned:\n        try:\n            raw = sentinel_path.read_bytes()\n        except OSError:\n            _note_unlock_trust_diag(\"sentinel_unreadable\")\n            return (False, None)\n        if hashlib.sha256(raw).hexdigest() in pinned:\n            try:\n                return (True, raw.decode(\"utf-8\"))\n            except Exception:\n                _note_unlock_trust_diag(\"sentinel_undecodable\")\n                return (False, None)\n        # A pin that does not cover THIS sentinel is not a verdict on the\n        # others: fall through to the anchor rail, or the pack's\n        # pre-existing sentinels would be self-DoS'd by pinning one file.\n        _note_unlock_trust_diag(\"digest_mismatch\")\n\n    # ---- Rail B: the sentinel predates the session (anchored bytes) ----\n    try:\n        is_git = (repo_root / \".git\").exists()\n    except OSError:\n        is_git = False\n    if not is_git:\n        return (True, None)  # documented residual: no anchor mechanism\n    anchor = (src_env.get(_SESSION_ANCHOR_ENV) or \"\").strip()\n    if not _ANCHOR_SHA_RE.match(anchor):\n        _note_unlock_trust_diag(\"anchor_missing\" if not anchor else \"anchor_malformed\")\n        return (False, None)\n    try:\n        rel = str(sentinel_path.relative_to(repo_root)).replace(os.sep, \"/\")\n    except ValueError:\n        # A sentinel outside the repo root can never be anchored.\n        _note_unlock_trust_diag(\"sentinel_outside_repo\")\n        return (False, None)\n    text = _anchored_blob_text(repo_root, anchor, rel)\n    if text is None:\n        _note_unlock_trust_diag(\"not_anchored\")\n        return (False, None)\n    # P1-1: the ANCHORED bytes are the authorization, not the bytes an\n    # in-window writer left at that path.\n    return (True, text)\n\n\n\ndef _unlock_trust_hint() -> str:\n    \"\"\"Teaching suffix for a block an armed unlock window could not lift.\n\n    PLAN162_FIX_S2R2 (codex P1-3). Without this, the operator whose\n    recovery route just started failing closed reads \"declare the path in\n    the Scope: block\" about a path that IS declared, and has no way to\n    learn which value is missing. Empty string when the unlock rail was\n    never the reason.\n    \"\"\"\n    if _UNLOCK_TRUST_DIAG is None:\n        return \"\"\n    return (\n        \"\\n\\nUNLOCK WINDOW ARMED, NO TRUSTED SENTINEL ({diag}). Inside a \"\n        \"CEO_SENTINEL_UNLOCK window the GPG rail is skipped, so a sentinel \"\n        \"must prove it was not written by the agent, by ONE of:\\n\"\n        \"  (a) predating the session — export {anchor}=<sha of a commit \"\n        \"taken BEFORE this agent session started>; capture it in your own \"\n        \"shell (`git rev-parse HEAD`) before launching, never after;\\n\"\n        \"  (b) Owner-pinned content — export {digest}=<sha256 of the \"\n        \"approved.md>, e.g. `shasum -a 256 <approved.md> | cut -d' ' -f1` \"\n        \"(space- or comma-separate several).\\n\"\n        \"See ADR-119 Invariant 5.\"\n    ).format(\n        diag=_UNLOCK_TRUST_DIAG,\n        anchor=_SESSION_ANCHOR_ENV,\n        digest=_UNLOCK_DIGEST_ENV,\n    )\n\n\n\ndef _sentinel_grants_path(sentinel_path: Path, target_rel: str) -> bool:\n    \"\"\"Check whether a sentinel file grants the given target path.\n\n    PLAN-045 Wave 1 P0-01: verification is now two-tiered:\n\n    1. **Plaintext ``Approved-By:`` line** — existing fast check (visual\n       Owner signoff marker).\n    2. **Detached GPG signature** at ``<sentinel>.asc`` — verified\n       against ``.claude/sentinel-signers.txt`` allowlist via\n       ``_lib.gpg_verify.verify_detached``. Fail-CLOSED on: missing\n       .asc, bad signature, signer fpr not in allowlist, empty\n       allowlist.\n\n    **Environment bypass (interim, per ADR-010 amendment)**: setting\n    ``CEO_SENTINEL_UNLOCK=<plan-id>`` + ``CEO_SENTINEL_UNLOCK_ACK=I-ACCEPT``\n    in the parent shell short-circuits the .asc requirement. This is a\n    dual-auth mechanism mirroring the arbitration-kernel escape hatch;\n    a sub-agent cannot forge the env vars. The override is logged via\n    ``veto_triggered(reason_code=sentinel_unlock_used)``.\n\n    The sentinel must contain:\n    1. A valid ``Approved-By: @<handle> <commit-sha>`` line\n    2. A ``Scope:`` block listing the target path (one bullet per line)\n    3. A sibling ``<sentinel>.asc`` detached GPG signature (unless env\n       override is set)\n    \"\"\"\n    # PLAN-094 Wave C — session cache fast-path before expensive GPG verify.\n    # Cache key (iter-1 P0 fix): (path, inode, mtime_ns, file_size, sha256_full,\n    # target_rel, fmt_version). Cache value: granted (bool). env_override path\n    # bypasses cache (CEO_SENTINEL_UNLOCK semantic: must re-verify).\n    global _SENTINEL_CACHE_HITS, _SENTINEL_CACHE_MISSES\n\n    # PLAN-045 Wave 1 P0-01: env-override (CEO_SENTINEL_UNLOCK) detection.\n    env = os.environ\n    unlock_reason = (env.get(\"CEO_SENTINEL_UNLOCK\") or \"\").strip()\n    unlock_ack = (env.get(\"CEO_SENTINEL_UNLOCK_ACK\") or \"\").strip()\n    env_override = bool(\n        unlock_reason\n        and unlock_ack == \"I-ACCEPT\"\n        and re.match(r'^(ADR-\\d{3,4}|PLAN-\\d{3})-[a-z0-9-]{3,100}$', unlock_reason)  # PLAN-086 Wave I.1 — ADR-119 tightening\n    )\n\n    # PLAN162_FIX_1 — SIGNATURE RAIL FIRST, and it is target-FREE.\n    #\n    # Two reasons the order changed (both are the fix):\n    #   * #1 — verifying once per SENTINEL instead of once per\n    #     (sentinel x target) is the whole amplification collapse; and\n    #   * #10 — the target-keyed grant cache below hashes only\n    #     approved.md, so a mutated .asc / allowlist / registry would ride\n    #     a stale True if the grant fast-path ran first. Consulting the\n    #     material-keyed rail up front makes a revocation land immediately.\n    _trusted_text = None  # type: Optional[str]\n    if not env_override:\n        if not _signature_rail_ok(sentinel_path):\n            return False\n    else:\n        # PLAN162_FIX_S2 — inside an unlock window the GPG rail is skipped\n        # entirely, so the only thing separating an Owner-signed sentinel\n        # from one the AGENT just wrote is provenance. See the module note\n        # above for the two proof forms and the residual.\n        _authorized, _trusted_text = _unlock_trusted_text(sentinel_path, env=env)\n        if not _authorized:\n            return False\n\n    # PLAN-094 Wave C — session cache fast-path (now scope-only).\n    # Cache key (iter-1 P0 fix): (path, inode, mtime_ns, file_size, sha256_full,\n    # target_rel, fmt_version). Cache value: granted (bool). env_override path\n    # bypasses cache (CEO_SENTINEL_UNLOCK semantic: must re-verify).\n    _cache_key = None\n    if not _sentinel_cache_disabled() and not env_override:\n        _cache_key = _compute_sentinel_cache_key(sentinel_path, target_rel)\n        if _cache_key is not None:\n            _cached = _SENTINEL_VERIFY_CACHE.get(_cache_key)\n            if _cached is not None:\n                _SENTINEL_CACHE_HITS += 1\n                return _cached\n            _SENTINEL_CACHE_MISSES += 1\n\n    # PLAN162_FIX_S2R2 (codex P1-1): under an unlock window the bytes that\n    # decide are the ANCHORED bytes, never whatever an in-window writer\n    # left at that path. ``None`` means \"disk bytes ARE the authorized\n    # bytes\" (Owner-pinned digest, or the non-git residual).\n    if _trusted_text is not None:\n        text = _trusted_text\n    else:\n        try:\n            text = sentinel_path.read_text(encoding=\"utf-8\")\n        except OSError:\n            return False\n\n    # Check plaintext signature marker first (cheap).\n    if not _APPROVED_BY_RE.search(text):\n        return False\n\n    # Parse Scope: block.\n    #\n    # PLAN-064 Option D (DIM-13 closure, 2026-05-04) — tier-prioritized\n    # parser:\n    #   Tier 1: if HTML-comment markers <!-- BEGIN SIGNED SCOPE --> /\n    #           <!-- END SIGNED SCOPE --> are present, parse Scope: ONLY\n    #           from text between those markers. Lifecycle text outside\n    #           the markers is ignored for grant decisions; it is\n    #           documentation. The GPG `.asc` continues to cover the\n    #           whole file (any tamper breaks the signature).\n    #   Tier 2: if markers absent (legacy 44 sentinels at 2026-05-04),\n    #           fall back to existing _SCOPE_HEADER_RE parser path\n    #           below. No env flag — auto-detected.\n    #\n    # PLAN-044 audit-v2 C6-P0-04 (Tier 2 fallback) — supports two\n    # on-disk formats:\n    #\n    # Format A (PLAN-050 round-17 era — single contiguous bullet list):\n    #\n    #     Scope:\n    #       - .claude/path/one.md\n    #       - .claude/path/two.md\n    #\n    # Format B (Session 67 mega-sentinel — categorized with sub-headers\n    # and blank lines between groups):\n    #\n    #     Scope (24 canonical paths):\n    #\n    #     ADR canonical promotions (9 files, all from staging):\n    #     - .claude/adr/ADR-083-...\n    #     - .claude/adr/ADR-084-...\n    #\n    #     Hook code (PLAN-052):\n    #     - .claude/hooks/_lib/foo.py (new)\n    #     - .claude/hooks/check_bar.py (new)\n    #\n    # The Scope block extends from the `Scope` header line to the first\n    # top-level continuation header (`Effective:`, `Plans:`, `Rationale`,\n    # `Authorization source:`, `Anchor commit:`, a re-encountered\n    # `Approved-By:`) or markdown horizontal rule (`---`, `***`, `___`)\n    # or end-of-file. Sub-headers within Scope (lines ending with `:`\n    # that are NOT in the terminator set) are silently skipped.\n\n    # ---- PLAN162_FIX_4 (finding #4, consensus C5 — narrowed) ----\n    #\n    # The original council proposal (\"parse ONLY inside the markers\")\n    # would have bricked 31% of live sentinels: 5 of 16 carry no BEGIN\n    # marker, including the two most recent ceremonies. What ships is\n    # three narrow rules instead:\n    #\n    #   1. A BEGIN marker with no well-formed PAIR must NEVER silently\n    #      downgrade to the Tier-2 whole-file parser. The code already\n    #      fail-CLOSES on that exact principle for a marker region with an\n    #      unparseable INTERIOR; a BEGIN with a missing/malformed END did\n    #      the opposite, which is the containment loss #4 reported —\n    #      Scope bullets OUTSIDE the Owner's intended region were honored.\n    #   2. Oversize (> _SCOPE_MARKER_CAP_BYTES) REJECTS fail-closed\n    #      rather than downgrading to Tier-2. Blast measured ~zero (the\n    #      largest live sentinel is 6,801 B = 10.4% of the cap).\n    #   3. The END marker terminates a Tier-2 Scope block (added to\n    #      _SCOPE_TERMINATOR_RE), so a bullet placed AFTER an END in a\n    #      marker-less file is no longer collected.\n    #\n    # CHARS-vs-BYTES, decided explicitly (C5 required a decision): the cap\n    # is named in BYTES, so it is now measured in BYTES. HEAD compared\n    # len(text) in CHARACTERS, which for a non-ASCII sentinel understated\n    # the real size. Since oversize is now a REJECT (rule 2) rather than a\n    # silent downgrade, the stricter of the two readings is also the\n    # safer one.\n    declared_paths: Set[str] = set()\n    try:\n        _text_bytes = len(text.encode(\"utf-8\", \"surrogatepass\"))\n    except Exception:  # pragma: no cover - defensive\n        _text_bytes = len(text)\n    if _text_bytes > _SCOPE_MARKER_CAP_BYTES:\n        # Rule 2 — fail-CLOSED. An oversize sentinel is not parsed by\n        # EITHER tier; it is rejected.\n        return False\n    if _BEGIN_MARKER_RE.search(text):\n        marker_match = _SCOPE_MARKER_RE.search(text)\n        if marker_match is None:\n            # Rule 1 — a BEGIN marker is an explicit (if broken) Owner\n            # intent signal. Never Tier-2 behind its back.\n            return False\n        scope_region = marker_match.group(1)\n        declared_paths = _parse_scope_paths_from_text(scope_region)\n        # If markers present but no scope paths extracted (malformed\n        # interior), fail-CLOSED rather than silently fall through\n        # to Tier 2 — markers are an explicit Owner intent signal.\n        if not declared_paths:\n            return False\n        granted = target_rel in declared_paths\n        if granted and env_override:\n            _emit_unlock_audit(target_rel, unlock_reason)\n        # PLAN-094-FOLLOWUP Wave C-tier1 — store Tier-1 grant decision\n        # in cache (parity with Tier-2 store path below). env_override\n        # path is NOT cached (mirrors Tier-2 invariant).\n        if (\n            _cache_key is not None\n            and not env_override\n            and not _sentinel_cache_disabled()\n        ):\n            _SENTINEL_VERIFY_CACHE[_cache_key] = granted\n        return granted\n\n    # Tier 2 — legacy _SCOPE_HEADER_RE parser (no markers in file).\n    declared_paths = _parse_scope_paths_from_text(text)\n    if not declared_paths:\n        return False\n\n    granted = target_rel in declared_paths\n    if granted and env_override:\n        _emit_unlock_audit(target_rel, unlock_reason)\n\n    # PLAN-094 Wave C — store result into module-scope cache (NEVER file-backed).\n    # env_override path is NOT cached (semantic: unlock env must always re-verify\n    # to honor freshly-regenerated .asc files even when bytes are unchanged).\n    if (\n        _cache_key is not None\n        and not env_override\n        and not _sentinel_cache_disabled()\n    ):\n        _SENTINEL_VERIFY_CACHE[_cache_key] = granted\n\n    return granted\n","numLines":582,"startLine":1,"totalLines":582}},"tool_result_meta":[{"id":"toolu_01PW9gayvafY7rRLMckaPnhU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
