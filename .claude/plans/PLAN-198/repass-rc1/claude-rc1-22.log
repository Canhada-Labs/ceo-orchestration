{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RK89JKPdCFuKN1A7ZR5tfe","type":"tool_result","content":"320\t            worst = rail_status\n321\t    return worst, _sanitize_for_recs(\"; \".join(parts)), detail\n322\t\n323\t\n324\t# === PLAN-153 Wave E item 1 wire — static harness-config gate at boot ======\n325\t# The E1 gate (`.claude/hooks/check_harness_config.py`, ADR-173) lands via\n326\t# the SENT-E canonical ceremony (staged under PLAN-153/staged/wave-E until\n327\t# signed). This Tier-S check invokes it as a subprocess ONLY when the file\n328\t# exists — pre-landing, boot stays green with an explicit \"not installed\"\n329\t# summary. Contract assumed: CLI run with no args from REPO_ROOT, stdin\n330\t# closed, exit 0 == pass / non-zero == fail (the same contract validate.yml\n331\t# will consume). Fail-open on infra: timeout → yellow + a\n332\t# `ceo_boot_check_skipped` audit event (never a session block); spawn error\n333\t# → yellow. Local static check — no network, CEO_SOTA_DISABLE n/a.\n334\t\n335\tHARNESS_CONFIG_GATE_DEFAULT = (\n336\t    REPO_ROOT / \".claude\" / \"hooks\" / \"check_harness_config.py\"\n337\t)\n338\tHARNESS_CONFIG_GATE_TIMEOUT_S_DEFAULT = 2.5\n339\t\n340\t\n341\tdef _harness_config_gate_path() -> Path:\n342\t    \"\"\"Resolve the E1 gate script path (env override for tests).\"\"\"\n343\t    override = os.environ.get(\"CEO_HARNESS_CONFIG_GATE\", \"\")\n344\t    if override:\n345\t        return Path(override)\n346\t    return HARNESS_CONFIG_GATE_DEFAULT\n347\t\n348\t\n349\tdef _harness_config_gate_timeout_s() -> float:\n350\t    \"\"\"Subprocess timeout for the E1 gate, clamped to [0.1, 10.0]s.\"\"\"\n351\t    raw = os.environ.get(\"CEO_HARNESS_CONFIG_GATE_TIMEOUT_S\", \"\")\n352\t    if raw:\n353\t        try:\n354\t            return max(0.1, min(10.0, float(raw)))\n355\t        except (TypeError, ValueError):\n356\t            pass\n357\t    return HARNESS_CONFIG_GATE_TIMEOUT_S_DEFAULT\n358\t\n359\t\n360\tdef check_harness_config_gate() -> Tuple[str, str, Any]:\n361\t    \"\"\"PLAN-153 Wave E item 1 — 23rd Tier-S check: harness-config gate.\n362\t\n363\t    File-existence guarded: green \"not installed\" until the SENT-E ceremony\n364\t    lands `check_harness_config.py` canonical. Once present: subprocess run,\n365\t    rc 0 → green, rc != 0 → red carrying the first sanitized output line,\n366\t    timeout → yellow (skipped, `ceo_boot_check_skipped` emitted), spawn\n367\t    error → yellow. ADVISORY — never blocks the session.\n368\t    \"\"\"\n369\t    gate = _harness_config_gate_path()\n370\t    if not gate.is_file():\n371\t        return (\n372\t            \"green\",\n373\t            \"harness-config gate not installed (PLAN-153 E1 staged; skipping)\",\n374\t            {\"installed\": False},\n375\t        )\n376\t    timeout_s = _harness_config_gate_timeout_s()\n377\t    try:\n378\t        proc = subprocess.run(\n379\t            [sys.executable, str(gate)],\n380\t            capture_output=True,\n381\t            text=True,\n382\t            timeout=timeout_s,\n383\t            cwd=str(REPO_ROOT),\n384\t            stdin=subprocess.DEVNULL,\n385\t        )\n386\t    except subprocess.TimeoutExpired:\n387\t        _emit_ceo_boot_check_skipped_safe(\n388\t            check_name=\"harness_config_gate\",\n389\t            timeout_ms=int(timeout_s * 1000),\n390\t        )\n391\t        return (\n392\t            \"yellow\",\n393\t            f\"harness-config gate timeout >{timeout_s:.1f}s (skipped, fail-open)\",\n394\t            {\"installed\": True, \"timeout\": True},\n395\t        )\n396\t    except OSError as exc:\n397\t        return (\n398\t            \"yellow\",\n399\t            f\"harness-config gate spawn error: {type(exc).__name__}\","}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"c0a04707-7c75-477b-9fa1-9a699e762cea","timestamp":"2026-11-13T18:06:52.842Z","tool_use_result":{"type":"text","file":{"filePath"