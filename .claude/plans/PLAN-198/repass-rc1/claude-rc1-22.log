\"\"\n933\t    try:\n934\t        from _lib import claude_md_excludes as excludes\n935\t    except Exception:\n936\t        return _warn(\"root_instruction_load\", \"runtime\", \"root_load_unobservable (classifier unavailable)\")\n937\t\n938\t    paths = None\n939\t    source = \"no complete observed path list\"\n940\t    if evidence_path is not None:\n941\t        try:\n942\t            snapshot = json.loads(\n943\t                evidence_path.read_text(encoding=\"utf-8\"),\n944\t                object_pairs_hook=_strict_pairs,\n945\t                parse_constant=_refuse_constant,\n946\t            )\n947\t            if isinstance(snapshot, dict) and snapshot.get(\"complete\") is True:\n948\t                paths = snapshot.get(\"loaded_instruction_paths\")\n949\t                source = \"operator-supplied snapshot; completeness unverified\"\n950\t            else:\n951\t                source = \"incomplete or malformed path list\"\n952\t        except (OSError, ValueError, RecursionError):\n953\t            source = \"unreadable or invalid path list\"\n954\t    try:\n955\t        state = excludes.root_instruction_load_state(paths, repo_root)\n956\t    except Exception:\n957\t        state = excludes.LOAD_STATE_UNOBSERVABLE\n958\t        source = \"classifier unavailable\"\n959\t    if state in (excludes.LOAD_STATE_LOADED, excludes.LOAD_STATE_ABSENT):\n960\t        state = f\"snapshot reports {state}\"\n961\t    return _warn(\"root_instruction_load\", \"runtime\", f\"{state} ({source})\")\n962\t\n963\t\n964\tdef main(argv: Optional[List[str]] = None) -> int:\n965\t    parser = argparse.ArgumentParser(\n966\t        prog=\"check_harness_config.py\",\n967\t        description=\"Harness-config gate: runtime-resolution model, \"\n968\t        \"inline-secret scan, deny baseline, no-op annotation, and \"\n969\t        \"behavioral positive-control replay (PLAN-153 Wave E / ADR-173).\",\n970\t    )\n971\t    parser.add_argument(\"--repo-root\", type=Path, default=None)\n972\t    parser.add_argument(\n973\t        \"--settings\",\n974\t        action=\"append\",\n975\t        type=Path,\n976\t        default=None,\n977\t        help=\"settings file(s) to scan (default: dogfood + template)\",\n978\t    )\n979\t    parser.add_argument(\"--fixtures-dir\", type=Path, default=None)\n980\t    parser.add_argument(\"--noop-allowlist\", type=Path, default=None)\n981\t    parser.add_argument(\n982\t        \"--instruction-load-evidence\", type=Path, default=None,\n983\t        help=\"JSON snapshot of a complete observed instruction-path list; \"\n984\t             \"without it root loading is unobservable\",\n985\t    )\n986\t    parser.add_argument(\n987\t        \"--static\", action=\"store_true\", help=\"run only the static checks\"\n988\t    )\n989\t    parser.add_argument(\n990\t        \"--replay\", action=\"store_true\", help=\"run only the behavioral replay\"\n991\t    )\n992\t    parser.add_argument(\n993\t        \"--no-exec-bit\",\n994\t        action=\"store_true\",\n995\t        help=\"skip delegation to check-active-hooks-executable.py\",\n996\t    )\n997\t    args = parser.parse_args(argv)\n998\t\n999\t    repo_root = (args.repo_root or _default_repo_root()).resolve()\n1000\t    do_static = args.static or not args.replay\n1001\t    do_replay = args.replay or not args.static\n1002\t\n1003\t    if args.settings:\n1004\t        settings_paths = [p if p.is_absolute() else repo_root / p for p in args.settings]\n1005\t    else:\n1006\t        settings_paths = [repo_root / rel for rel in DEFAULT_SETTINGS_REL]\n1007\t\n1008\t    findings: List[Finding] = []\n1009\t    try:\n1010\t        if do_static:\n1011\t            findings.extend(\n1012\t                run_static(\n1013\t                    repo_root,\n1014\t                    settings_paths,\n1015\t                    noop_allowlist_path=args.noop_allowlist,\n1016\t                    include_exec_bit=not args.no_exec_bit,\n1017\t                )\n1018\t            )\n1019\t    except ValueError as exc:\n1020\t        print(f\"::error::{exc}\", file=sys.stderr)\n1021\t        return 2\n1022\t\n1023\t    if do_replay:\n1024\t        findings.extend(run_replay(repo_root, args.fixtures_dir))\n1025\t\n1026\t    # Runtime evidence is optional and independent of settings/glob findings.\n1027\t    # Never promote a static exclusion pattern into a claim about what loaded.\n1028\t    if do_static or args.instruction_load_evidence is not None:\n1029\t        findings.append(check_root_instruction_load(repo_root, args.instruction_load_evidence))\n1030\t\n1031\t    _print_findings(findings)\n1032\t    reds = [f for f in findings if f.severity == \"RED\"]\n1033\t    if reds:\n1034\t        print(f\"\\nFAIL: {len(reds)} RED finding(s) \"\n1035\t              f\"({len(findings) - len(reds)} warning(s))\")\n1036\t        return 1\n1037\t    print(\n1038\t        f\"OK: harness-config gate green \"\n1039\t        f\"(static={'yes' if do_static else 'no'}, \"\n1040\t        f\"replay={'yes' if do_replay else 'no'}, \"\n1041\t        f\"{len(findings)} warning(s))\"\n1042\t    )\n1043\t    return 0\n1044\t\n1045\t\n1046\tif __name__ == \"__main__\":\n1047\t    sys.exit(main())\n1048\t"}]},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"0b895b77-c663-433f-a9d5-7fb3b17bb108","timestamp":"2026-11-15T10:55:00.769Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_harness_config.py","content":"                        \"replay\",\n                        loc,\n                        \"planted violation was NOT blocked \"\n                        f\"(decision={json.dumps(decision)[:160]}) — DEAD or \"\n                        \"fail-open rail\",\n                    )\n                )\n    finally:\n        shutil.rmtree(str(scratch), ignore_errors=True)\n    return findings\n\n\n# ---------------------------------------------------------------------------\n# CLI\n# ---------------------------------------------------------------------------\n\ndef _default_repo_root() -> Path:\n    env = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n    if env:\n        return Path(env).resolve()\n    # landed location: .claude/hooks/check_harness_config.py → repo root 2 up\n    candidate = _THIS_DIR.parent.parent\n    if (candidate / \".claude\").is_dir():\n        return candidate\n    return Path.cwd()\n\n\ndef _print_findings(findings: List[Finding]) -> None:\n    for f in findings:\n        print(f\"[{f.severity}] {f.check_id} @ {f.location}\\n    {f.message}\")\n\n\ndef check_root_instruction_load(\n    repo_root: Path, evidence_path: Optional[Path] = None,\n) -> Finding:\n    \"\"\"Report a real runtime lookup, with explicit evidence provenance.\n\n    ``evidence_path`` is an operator-supplied JSON snapshot shaped as\n    ``{\"complete\": true, \"loaded_instruction_paths\": [absolute paths...]}``.\n    A partial, malformed or unavailable snapshot cannot prove root absence.\n    The caller supplies the list; this gate does not claim to instrument\n    Claude Code's instruction loader or authenticate the snapshot's producer.\n    \"\"\"\n    try:\n        from _lib import claude_md_excludes as excludes\n    except Exception:\n        return _warn(\"root_instruction_load\", \"runtime\", \"root_load_unobservable (classifier unavailable)\")\n\n    paths = None\n    source = \"no complete observed path list\"\n    if evidence_path is not None:\n        try:\n            snapshot = json.loads(\n                evidence_path.read_text(encoding=\"utf-8\"),\n                object_pairs_hook=_strict_pairs,\n                parse_constant=_refuse_constant,\n            )\n            if isinstance(snapshot, dict) and snapshot.get(\"complete\") is True:\n                paths = snapshot.get(\"loaded_instruction_paths\")\n                source = \"operator-supplied snapshot; completeness unverified\"\n            else:\n                source = \"incomplete or malformed path list\"\n        except (OSError, ValueError, RecursionError):\n            source = \"unreadable or invalid path list\"\n    try:\n        state = excludes.root_instruction_load_state(paths, repo_root)\n    except Exception:\n        state = excludes.LOAD_STATE_UNOBSERVABLE\n        source = \"classifier unavailable\"\n    if state in (excludes.LOAD_STATE_LOADED, excludes.LOAD_STATE_ABSENT):\n        state = f\"snapshot reports {state}\"\n    return _warn(\"root_instruction_load\", \"runtime\", f\"{state} ({source})\")\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = argparse.ArgumentParser(\n        prog=\"check_harness_config.py\",\n        description=\"Harness-config gate: runtime-resolution model, \"\n        \"inline-secret scan, deny baseline, no-op annotation, and \"\n        \"behavioral positive-control replay (PLAN-153 Wave E / ADR-173).\",\n    )\n    parser.add_argument(\"--repo-root\", type=Path, default=None)\n    parser.add_argument(\n        \"--settings\",\n        action=\"append\",\n        type=Path,\n        default=None,\n        help=\"settings file(s) to scan (default: dogfood + template)\",\n    )\n    parser.add_argument(\"--fixtures-dir\", type=Path, default=None)\n    parser.add_argument(\"--noop-allowlist\", type=Path, default=None)\n    parser.add_argument(\n        \"--instruction-load-evidence\", type=Path, default=None,\n        help=\"JSON snapshot of a complete observed instruction-path list; \"\n             \"without it root loading is unobservable\",\n    )\n    parser.add_argument(\n        \"--static\", action=\"store_true\", help=\"run only the static checks\"\n    )\n    parser.add_argument(\n        \"--replay\", action=\"store_true\", help=\"run only the behavioral replay\"\n    )\n    parser.add_argument(\n        \"--no-exec-bit\",\n        action=\"store_true\",\n        help=\"skip delegation to check-active-hooks-executable.py\",\n    )\n    args = parser.parse_args(argv)\n\n    repo_root = (args.repo_root or _default_repo_root()).resolve()\n    do_static = args.static or not args.replay\n    do_replay = args.replay or not args.static\n\n    if args.settings:\n        settings_paths = [p if p.is_absolute() else repo_root / p for p in args.settings]\n    else:\n        settings_paths = [repo_root / rel for rel in DEFAULT_SETTINGS_REL]\n\n    findings: List[Finding] = []\n    try:\n        if do_static:\n            findings.extend(\n                run_static(\n                    repo_root,\n                    settings_paths,\n                    noop_allowlist_path=args.noop_allowlist,\n                    include_exec_bit=not args.no_exec_bit,\n                )\n            )\n    except ValueError as exc:\n        print(f\"::error::{exc}\", file=sys.stderr)\n        return 2\n\n    if do_replay:\n        findings.extend(run_replay(repo_root, args.fixtures_dir))\n\n    # Runtime evidence is optional and independent of settings/glob findings.\n    # Never promote a static exclusion pattern into a claim about what loaded.\n    if do_static or args.instruction_load_evidence is not None:\n        findings.append(check_root_instruction_load(repo_root, args.instruction_load_evidence))\n\n    _print_findings(findings)\n    reds = [f for f in findings if f.severity == \"RED\"]\n    if reds:\n        print(f\"\\nFAIL: {len(reds)} RED finding(s) \"\n              f\"({len(findings) - len(reds)} warning(s))\")\n        return 1\n    print(\n        f\"OK: harness-config gate green \"\n        f\"(static={'yes' if do_static else 'no'}, \"\n        f\"replay={'yes' if do_replay else 'no'}, \"\n        f\"{len(findings)} warning(s))\"\n    )\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":159,"startLine":890,"totalLines":1048}},"tool_result_meta":[{"id":"toolu_01KaqszoiAuMnNBVhudiLoTp","permission_decision":{"decision":"accept","source":"config","reason_