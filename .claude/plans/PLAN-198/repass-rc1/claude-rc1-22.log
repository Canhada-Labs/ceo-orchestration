{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012VtAdd7GgCZqKCoFeH3jWP","type":"tool_result","content":"1\t\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _emit_unlock_audit(target_rel: str, unlock_reason: str) -> None:\n5\t    \"\"\"Best-effort audit emission for sentinel env-override grants.\n6\t\n7\t    Session 75 Codex Finding 8 closure (extracted helper for PLAN-064\n8\t    Option D Tier-1/Tier-2 DRY): docstring promised\n9\t    `veto_triggered(reason_code=sentinel_unlock_used)` event when the\n10\t    env-var override path grants a canonical edit. Emission failures\n11\t    never block (advisory).\n12\t    \"\"\"\n13\t    try:\n14\t        from _lib import audit_emit as _audit_emit_unlock\n15\t        _audit_emit_unlock.emit_veto_triggered(\n16\t            hook=\"check_canonical_edit\",\n17\t            reason_code=\"sentinel_unlock_used\",\n18\t            reason_preview=(\n19\t                f\"sentinel env-override granted edit to {target_rel}; \"\n20\t                f\"reason={unlock_reason!r}\"\n21\t            ),\n22\t            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n23\t            caller=os.environ.get(\"CLAUDE_AGENT_NAME\", \"ceo\"),\n24\t            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n25\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n26\t        )\n27\t    except Exception:\n28\t        pass  # advisory; emission failure never blocks\n29\t\n30\t\n31\tdef decide(\n32\t    *,\n33\t    file_path: str,\n34\t    repo_root: Path,\n35\t) -> str:\n36\t    \"\"\"Pure decision function.\n37\t\n38\t    Returns the JSON payload to write to stdout.\n39\t    \"\"\"\n40\t    # PLAN162_FIX_S2R2 — per-decision state, so an in-process caller\n41\t    # (``check_pair_rail``, the tests) never inherits a previous event's\n42\t    # unlock diagnosis.\n43\t    _reset_unlock_trust_diag()\n44\t\n45\t    if not file_path:\n46\t        return _emit_allow()\n47\t\n48\t    if not _is_canonical(file_path, repo_root):\n49\t        return _emit_allow()\n50\t\n51\t    # Confirmed canonical. Re-derive the repo-relative form for sentinel\n52\t    # matching via the SAME dual-anchor resolution as _is_canonical\n53\t    # (PLAN160_FIX_D), so the path is paired with the rel that classified\n54\t    # it (a repo_root-anchored canonical path would otherwise fault the\n55\t    # historical CWD-anchored resolve and route a clean sentinel-block\n56\t    # through the finding-C fault branch).\n57\t    rel = _canonical_rel(file_path, repo_root)\n58\t    if rel is None:\n59\t        # PLAN160_FIX_C (finding C): fail-CLOSED. ``_is_canonical`` (guard\n60\t        # above) returned True, yet no anchoring yields a canonical rel\n61\t        # HERE — only a same-process TOCTOU between those two resolves can\n62\t        # reach this. The historical code fail-OPENED via\n63\t        # ``return _emit_allow()`` on the resolve fault; a confirmed-canonical\n64\t        # path MUST block (PLAN-045 F-01-07). Dead in same-process terms;\n65\t        # defense-in-depth.\n66\t        return _emit_block(\n67\t            reason=(\n68\t                \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — a \"\n69\t                \"confirmed-canonical path could not be resolved repo-relative \"\n70\t                \"for sentinel matching (same-process TOCTOU). PLAN-045 \"\n71\t                \"F-01-07 / PLAN-160 finding C fail-closed.\"\n72\t            )\n73\t        )\n74\t\n75\t    sentinels = _find_sentinels(repo_root)\n76\t    for sentinel in sentinels:\n77\t        # PLAN162_FIX_1 (C2) — wall-clock deadline, checked at the TOP of\n78\t        # the sentinel loop and fail-CLOSED. Never \"allow because we ran\n79\t        # out of time\", and never \"stop checking sentinels\" (a cap would\n80\t        # drop the highest-numbered pack, i.e. the ceremony the Owner just\n81\t        # signed — self-DoS with the signature in hand).\n82\t        if _wall_budget_expired():\n83\t            return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n84\t        if _sentinel_grants_path(sentinel, rel):\n85\t            # PLAN-106 Wave C — persona coverage emit at canonical-edit\n86\t            # sentinel-approved allow path.\n87\t            _emit_persona_coverage_synthesized(rel_path=rel)\n88\t            return _emit_allow(\n89\t                system_message=(\n90\t                    f\"CANONICAL-EDIT: allowed via sentinel \"\n91\t                    f\"{sentinel.relative_to(repo_root)}\"\n92\t                )\n93\t            )\n94\t\n95\t    # PLAN162_FIX_1 (Codex P1 fold) — the budget can run out DURING the\n96\t    # last sentinel's verification, after the final top-of-loop poll. Both\n97\t    # outcomes block, but only this one names the cause and carries the\n98\t    # recovery route; the generic block below would tell the Owner to\n99\t    # declare a path that IS already declared.\n100\t    if _wall_budget_expired():\n101\t        return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n102\t\n103\t    return _emit_block(\n104\t        reason=(\n105\t            f\"CANONICAL-EDIT-BLOCKED: '{rel}' is a canonical governance \"\n106\t            \"path. Edits require an Owner-signed sentinel at \"\n107\t            \".claude/plans/PLAN-NNN/architect/round-N/approved.md with \"\n108\t            f\"this path declared in the Scope: block. See ADR-010.\"\n109\t            # PLAN162_FIX_S2R2 (P1-3): when an unlock window IS armed and\n110\t            # the trust rail is what refused, say so and name the value.\n111\t            + _unlock_trust_hint()\n112\t        )\n113\t    )\n114\t\n115\t\n116\tdef _candidate_is_granted(path_str: str, repo_root: Path, sentinels) -> bool:\n117\t    \"\"\"PLAN160_FIX_A helper — pure grant predicate for one candidate.\n118\t\n119\t    True iff the (assumed-canonical) ``path_str`` resolves repo-relative\n120\t    AND some sentinel in ``sentinels`` grants that repo-relative path. A\n121\t    resolve fault on a canonical path is NOT a grant → returns False, so\n122\t    the caller treats the candidate as the offender and blocks\n123\t    (fail-CLOSED, mirroring finding C's decide() contract).\n124\t\n125\t    Pure: NO side effects (does not emit persona coverage or audit) — those\n126\t    stay once-per-event concerns owned by ``decide()``. Uses the SAME\n127\t    ``_canonical_rel`` anchoring as ``_is_canonical`` and ``decide()``\n128\t    (PLAN160_FIX_D), so grant is checked against the exact rel that\n129\t    classified the candidate canonical; a candidate with no canonical rel\n130\t    is conservatively treated as ungranted (→ offender → block).\n131\t    \"\"\"\n132\t    rel = _canonical_rel(path_str, repo_root)\n133\t    if rel is None:\n134\t        return False\n135\t    for sentinel in sentinels:\n136\t        if _sentinel_grants_path(sentinel, rel):\n137\t            return True\n138\t    return False\n139\t\n140\t\n141\tdef _safe_sentinel_count(repo_root: Path) -> int:\n142\t    \"\"\"Best-effort sentinel count for the veto-audit breadcrumb.\n143\t\n144\t    PLAN160_FIX_A (codex pair-rail HIGH#2): the audit breadcrumb must never\n145\t    let a ``_find_sentinels`` fault (a malformed sentinel dir, an OSError\n146\t    walking the tree) propagate out of ``main()`` and produce a ZERO-emit\n147\t    hook on a governance event. Returns 0 on any fault — the count is\n148\t    forensic only; the block/allow decision is already made.\n149\t    \"\"\"\n150\t    try:\n151\t        return len(_find_sentinels(repo_root))\n152\t    except Exception:\n153\t        return 0\n154\t\n155\t\n156\tdef _block_reason_code(reason: str) -> str:\n157\t    \"\"\"Which ``reason_code`` the CHAIN gets for a block decision.\n158\t\n159\t    PLAN162_FIX_1B (r8 P2). ``_emit_block`` already names the class in the\n160\t    DECISION text, but the audit breadcrumb hard-coded\n161\t    ``canonical_edit_unsigned`` for every block — so the wall-deadline\n162\t    fail-CLOSED (and the pre-existing over-cap / scan-fault blocks) landed\n163\t    in the HMAC chain labelled as an unsigned edit: indistinguishable from\n164\t    a legitimate missing-sentinel block, and therefore UNCOUNTABLE for the\n165\t    ADR-110-AMEND-2 §3 censorship RATE. ``wave-readonly-monitor.py``\n166\t    already lists ``canonical_edit_hook_fault`` in\n167\t    ``_LAYER_3A_REASON_CODES``: a consumer with zero producers.\n168\t\n169\t    Closed 2-value derivation, read off the decision this hook itself\n170\t    built — never off attacker-shaped input.\n171\t    \"\"\"\n172\t    return (\n173\t        \"canonical_edit_hook_fault\"\n174\t        if \"canonical_edit_hook_fault\" in (reason or \"\")\n175\t        else \"canonical_edit_unsigned\"\n176\t    )\n177\t\n178\t\n179\tdef _audit_block(\n180\t    rel: str,\n181\t    sentinels_count: int,\n182\t    reason_code: str = \"canonical_edit_unsigned\",\n183\t) -> None:\n184\t    \"\"\"Best-effort emit of veto_triggered event. Never raises.\n185\t\n186\t    ``reason_code`` defaults to the historical value, so every existing\n187\t    caller is byte-identical. NO new ACTION is invented — ``veto_triggered``\n188\t    stays the registered action, same precedent as\n189\t    ``_audit_registry_unreadable``'s ``session_roots_registry_unreadable``.\n190\t    \"\"\"\n191\t    try:\n192\t        from _lib import audit_emit\n193\t        if reason_code == \"canonical_edit_unsigned\":\n194\t            _preview = (\n195\t                f\"blocked edit to {rel}; {sentinels_count} sentinel(s) checked, \"\n196\t                \"none grant this path\"\n197\t            )\n198\t        else:\n199\t            _preview = (\n200\t                f\"blocked edit to {rel}; fail-CLOSED before the sentinel sweep \"\n201\t                f\"could complete ({sentinels_count} sentinel(s) on disk)\"\n202\t            )\n203\t        audit_emit.emit_veto_triggered(\n204\t            hook=\"check_canonical_edit\",\n205\t            reason_code=reason_code,\n206\t            reason_preview=_preview,\n207\t            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n208\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n209\t        )\n210\t    except Exception:\n211\t        return\n212\t\n213\t__all__ = ['_emit_unlock_audit', 'decide', '_candidate_is_granted', '_safe_sentinel_count', '_block_reason_code', '_audit_block']\n214\t"}]},"parent_tool_use_id":null,"session_id":"046a4659-3b58-4aa1-afb8-7e9a6b625253","uuid":"0657fd12-570f-4ec7-bcc4-632e28e13708","timestamp":"2026-11-13T18:05:03.349Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/decisions.py","content":"\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\nfrom __future__ import annotations\n\ndef _emit_unlock_audit(target_rel: str, unlock_reason: str) -> None:\n    \"\"\"Best-effort audit emission for sentinel env-override grants.\n\n    Session 75 Codex Finding 8 closure (extracted helper for PLAN-064\n    Option D Tier-1/Tier-2 DRY): docstring promised\n    `veto_triggered(reason_code=sentinel_unlock_used)` event when the\n    env-var override path grants a canonical edit. Emission failures\n    never block (advisory).\n    \"\"\"\n    try:\n        from _lib import audit_emit as _audit_emit_unlock\n        _audit_emit_unlock.emit_veto_triggered(\n            hook=\"check_canonical_edit\",\n            reason_code=\"sentinel_unlock_used\",\n            reason_preview=(\n                f\"sentinel env-override granted edit to {target_rel}; \"\n                f\"reason={unlock_reason!r}\"\n            ),\n            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n            caller=os.environ.get(\"CLAUDE_AGENT_NAME\", \"ceo\"),\n            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:\n        pass  # advisory; emission failure never blocks\n\n\ndef decide(\n    *,\n    file_path: str,\n    repo_root: Path,\n) -> str:\n    \"\"\"Pure decision function.\n\n    Returns the JSON payload to write to stdout.\n    \"\"\"\n    # PLAN162_FIX_S2R2 — per-decision state, so an in-process caller\n    # (``check_pair_rail``, the tests) never inherits a previous event's\n    # unlock diagnosis.\n    _reset_unlock_trust_diag()\n\n    if not file_path:\n        return _emit_allow()\n\n    if not _is_canonical(file_path, repo_root):\n        return _emit_allow()\n\n    # Confirmed canonical. Re-derive the repo-relative form for sentinel\n    # matching via the SAME dual-anchor resolution as _is_canonical\n    # (PLAN160_FIX_D), so the path is paired with the rel that classified\n    # it (a repo_root-anchored canonical path would otherwise fault the\n    # historical CWD-anchored resolve and route a clean sentinel-block\n    # through the finding-C fault branch).\n    rel = _canonical_rel(file_path, repo_root)\n    if rel is None:\n        # PLAN160_FIX_C (finding C): fail-CLOSED. ``_is_canonical`` (guard\n        # above) returned True, yet no anchoring yields a canonical rel\n        # HERE — only a same-process TOCTOU between those two resolves can\n        # reach this. The historical code fail-OPENED via\n        # ``return _emit_allow()`` on the resolve fault; a confirmed-canonical\n        # path MUST block (PLAN-045 F-01-07). Dead in same-process terms;\n        # defense-in-depth.\n        return _emit_block(\n            reason=(\n                \"CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — a \"\n                \"confirmed-canonical path could not be resolved repo-relative \"\n                \"for sentinel matching (same-process TOCTOU). PLAN-045 \"\n                \"F-01-07 / PLAN-160 finding C fail-closed.\"\n            )\n        )\n\n    sentinels = _find_sentinels(repo_root)\n    for sentinel in sentinels:\n        # PLAN162_FIX_1 (C2) — wall-clock deadline, checked at the TOP of\n        # the sentinel loop and fail-CLOSED. Never \"allow because we ran\n        # out of time\", and never \"stop checking sentinels\" (a cap would\n        # drop the highest-numbered pack, i.e. the ceremony the Owner just\n        # signed — self-DoS with the signature in hand).\n        if _wall_budget_expired():\n            return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n        if _sentinel_grants_path(sentinel, rel):\n            # PLAN-106 Wave C — persona coverage emit at canonical-edit\n            # sentinel-approved allow path.\n            _emit_persona_coverage_synthesized(rel_path=rel)\n            return _emit_allow(\n                system_message=(\n                    f\"CANONICAL-EDIT: allowed via sentinel \"\n                    f\"{sentinel.relative_to(repo_root)}\"\n                )\n            )\n\n    # PLAN162_FIX_1 (Codex P1 fold) — the budget can run out DURING the\n    # last sentinel's verification, after the final top-of-loop poll. Both\n    # outcomes block, but only this one names the cause and carries the\n    # recovery route; the generic block below would tell the Owner to\n    # declare a path that IS already declared.\n    if _wall_budget_expired():\n        return _emit_block(reason=_WALL_DEADLINE_BLOCK_REASON)\n\n    return _emit_block(\n        reason=(\n            f\"CANONICAL-EDIT-BLOCKED: '{rel}' is a canonical governance \"\n            \"path. Edits require an Owner-signed sentinel at \"\n            \".claude/plans/PLAN-NNN/architect/round-N/approved.md with \"\n            f\"this path declared in the Scope: block. See ADR-010.\"\n            # PLAN162_FIX_S2R2 (P1-3): when an unlock window IS armed and\n            # the trust rail is what refused, say so and name the value.\n            + _unlock_trust_hint()\n        )\n    )\n\n\ndef _candidate_is_granted(path_str: str, repo_root: Path, sentinels) -> bool:\n    \"\"\"PLAN160_FIX_A helper — pure grant predicate for one candidate.\n\n    True iff the (assumed-canonical) ``path_str`` resolves repo-relative\n    AND some sentinel in ``sentinels`` grants that repo-relative path. A\n    resolve fault on a canonical path is NOT a grant → returns False, so\n    the caller treats the candidate as the offender and blocks\n    (fail-CLOSED, mirroring finding C's decide() contract).\n\n    Pure: NO side effects (does not emit persona coverage or audit) — those\n    stay once-per-event concerns owned by ``decide()``. Uses the SAME\n    ``_canonical_rel`` anchoring as ``_is_canonical`` and ``decide()``\n    (PLAN160_FIX_D), so grant is checked against the exact rel that\n    classified the candidate canonical; a candidate with no canonical rel\n    is conservatively treated as ungranted (→ offender → block).\n    \"\"\"\n    rel = _canonical_rel(path_str, repo_root)\n    if rel is None:\n        return False\n    for sentinel in sentinels:\n        if _sentinel_grants_path(sentinel, rel):\n            return True\n    return False\n\n\ndef _safe_sentinel_count(repo_root: Path) -> int:\n    \"\"\"Best-effort sentinel count for the veto-audit breadcrumb.\n\n    PLAN160_FIX_A (codex pair-rail HIGH#2): the audit breadcrumb must never\n    let a ``_find_sentinels`` fault (a malformed sentinel dir, an OSError\n    walking the tree) propagate out of ``main()`` and produce a ZERO-emit\n    hook on a governance event. Returns 0 on any fault — the count is\n    forensic only; the block/allow decision is already made.\n    \"\"\"\n    try:\n        return len(_find_sentinels(repo_root))\n    except Exception:\n        return 0\n\n\ndef _block_reason_code(reason: str) -> str:\n    \"\"\"Which ``reason_code`` the CHAIN gets for a block decision.\n\n    PLAN162_FIX_1B (r8 P2). ``_emit_block`` already names the class in the\n    DECISION text, but the audit breadcrumb hard-coded\n    ``canonical_edit_unsigned`` for every block — so the wall-deadline\n    fail-CLOSED (and the pre-existing over-cap / scan-fault blocks) landed\n    in the HMAC chain labelled as an unsigned edit: indistinguishable from\n    a legitimate missing-sentinel block, and therefore UNCOUNTABLE for the\n    ADR-110-AMEND-2 §3 censorship RATE. ``wave-readonly-monitor.py``\n    already lists ``canonical_edit_hook_fault`` in\n    ``_LAYER_3A_REASON_CODES``: a consumer with zero producers.\n\n    Closed 2-value derivation, read off the decision this hook itself\n    built — never off attacker-shaped input.\n    \"\"\"\n    return (\n        \"canonical_edit_hook_fault\"\n        if \"canonical_edit_hook_fault\" in (reason or \"\")\n        else \"canonical_edit_unsigned\"\n    )\n\n\ndef _audit_block(\n    rel: str,\n    sentinels_count: int,\n    reason_code: str = \"canonical_edit_unsigned\",\n) -> None:\n    \"\"\"Best-effort emit of veto_triggered event. Never raises.\n\n    ``reason_code`` defaults to the historical value, so every existing\n    caller is byte-identical. NO new ACTION is invented — ``veto_triggered``\n    stays the registered action, same precedent as\n    ``_audit_registry_unreadable``'s ``session_roots_registry_unreadable``.\n    \"\"\"\n    try:\n        from _lib import audit_emit\n        if reason_code == \"canonical_edit_unsigned\":\n            _preview = (\n                f\"blocked edit to {rel}; {sentinels_count} sentinel(s) checked, \"\n                \"none grant this path\"\n            )\n        else:\n            _preview = (\n                f\"blocked edit to {rel}; fail-CLOSED before the sentinel sweep \"\n                f\"could complete ({sentinels_count} sentinel(s) on disk)\"\n            )\n        audit_emit.emit_veto_triggered(\n            hook=\"check_canonical_edit\",\n            reason_code=reason_code,\n            reason_preview=_preview,\n            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n        )\n    except Exception:\n        return\n\n__all__ = ['_emit_unlock_audit', 'decide', '_candidate_is_granted', '_safe_sentinel_count', '_block_reason_code', '_audit_block']\n","numLines":214,"startLine":1,"totalLines":214}},"tool_result_meta":[{"id":"toolu_012VtAdd7GgCZqKCoFeH3jWP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
