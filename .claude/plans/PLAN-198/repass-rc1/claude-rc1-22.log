{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cnmy1mMn5x3ercaE6TD3K7","type":"tool_result","content":"1\t\"\"\"Read-only canonical scope and GPG gates for a future ceremony packet.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport ast\n6\timport fnmatch\n7\timport hashlib\n8\timport re\n9\timport shutil\n10\timport subprocess\n11\tfrom pathlib import Path, PurePosixPath\n12\tfrom typing import Iterable, Mapping, Optional\n13\t\n14\t_FPR = re.compile(r\"^[A-F0-9]{40}$\")\n15\t_SCOPE_LINE = re.compile(r\"^\\s{2,}-\\s+(.+?)\\s*$\")\n16\t_APPROVAL = re.compile(r\"^Approved-By:\\s+@\\S+\\s+[a-fA-F0-9]{40}\\s*$\", re.M)\n17\t\n18\t\n19\tdef _safe_rel(path: str) -> str:\n20\t    \"\"\"Reject all ambiguous paths instead of normalising them into scope.\"\"\"\n21\t    if not isinstance(path, str) or not path or \"\\\\\" in path or \"\\x00\" in path:\n22\t        raise ValueError(\"unsafe_path\")\n23\t    p = PurePosixPath(path)\n24\t    if p.is_absolute() or any(part in (\".\", \"..\") for part in path.split(\"/\")):\n25\t        raise ValueError(\"unsafe_path\")\n26\t    if p.as_posix() != path or path.startswith(\"~\"):\n27\t        raise ValueError(\"unsafe_path\")\n28\t    return path\n29\t\n30\t\n31\tdef _fnmatch_segments(path: str, pattern: str) -> bool:\n32\t    \"\"\"Mirror canonical_edit.paths._fnmatch_segments without its hook-bound globals.\"\"\"\n33\t    parts, patterns = path.split(\"/\"), pattern.split(\"/\")\n34\t    if not patterns:\n35\t        return not parts\n36\t    head, rest = patterns[0], patterns[1:]\n37\t    if head == \"**\":\n38\t        return any(_match_parts(parts[i:], rest) for i in range(len(parts) + 1))\n39\t    return _match_parts(parts, patterns)\n40\t\n41\t\n42\tdef _match_parts(parts: list, patterns: list) -> bool:\n43\t    if not patterns:\n44\t        return not parts\n45\t    if patterns[0] == \"**\":\n46\t        return any(_match_parts(parts[i:], patterns[1:]) for i in range(len(parts) + 1))\n47\t    return bool(parts) and fnmatch.fnmatchcase(parts[0], patterns[0]) and _match_parts(parts[1:], patterns[1:])\n48\t\n49\t\n50\tdef _canonical_patterns(repo_root: Path) -> tuple[str, ...]:\n51\t    \"\"\"Read the actual guard policy as AST literals; never execute hook code.\"\"\"\n52\t    policy = repo_root / \".claude/hooks/check_canonical_edit.py\"\n53\t    source = ast.parse(policy.read_text(encoding=\"utf-8\"))\n54\t    for node in source.body:\n55\t        if isinstance(node, ast.Assign) and any(\n56\t            isinstance(t, ast.Name) and t.id == \"_CANONICAL_GUARDS\" for t in node.targets\n57\t        ):\n58\t            patterns = ast.literal_eval(node.value)\n59\t            if not isinstance(patterns, list) or not all(isinstance(x, str) for x in patterns):\n60\t                break\n61\t            return tuple(patterns)\n62\t    raise ValueError(\"canonical_guard_policy_unavailable\")\n63\t\n64\t\n65\tdef collect_modified_canonical_paths(\n66\t    repo_root: Path, modified_paths: Iterable[str], *, canonical_patterns: Optional[Iterable[str]] = None\n67\t) -> tuple[str, ...]:\n68\t    \"\"\"Collect guarded paths using the hook's segment-matching semantics.\n69\t\n70\t    Caller supplies modified paths from a trusted diff; this helper never\n71\t    invents a diff or assumes a cached list. Unsafe paths fail the packet.\n72\t    \"\"\"\n73\t    patterns = tuple(canonical_patterns) if canonical_patterns is not None else _canonical_patterns(Path(repo_root))\n74\t    if not patterns or not all(isinstance(p, str) and p for p in patterns):\n75\t        raise ValueError(\"empty_or_invalid_canonical_policy\")\n76\t    paths = (_safe_rel(p) for p in modified_paths)\n77\t    return tuple(sorted({p for p in paths if any(_fnmatch_segments(p.lower(), pat.lower()) for pat in patterns)}))\n78\t\n79\t\n80\tdef _parse_scope(text: str) -> tuple[str, ...]:\n81\t    in_scope = False\n82\t    seen_scope = False\n83\t    scope = []\n84\t    for line in text.splitlines():\n85\t        if line.strip() == \"Scope:\":\n86\t            if seen_scope:\n87\t                raise ValueError(\"duplicate_scope\")\n88\t            seen_scope = True\n89\t            in_scope = True\n90\t            continue\n91\t        if in_scope:\n92\t            match = _SCOPE_LINE.fullmatch(line)\n93\t            if match:\n94\t                scope.append(_safe_rel(match.group(1)))\n95\t            elif line.strip():\n96\t                in_scope = False\n97\t    if not scope or len(set(scope)) != len(scope):\n98\t        raise ValueError(\"missing_or_duplicate_scope\")\n99\t    return tuple(sorted(scope))\n100\t\n101\t\n102\tdef validate_sentinel_pack(\n103\t    repo_root: Path,\n104\t    sentinel_file: Path,\n105\t    modified_paths: Iterable[str],\n106\t    *,\n107\t    expected_sha256: Optional[Mapping[str, str]] = None,\n108\t    canonical_patterns: Optional[Iterable[str]] = None,\n109\t) -> dict:\n110\t    \"\"\"Check exact scope and optional *fresh* SHA-256 pins; never approve.\n111\t\n112\t    ``expected_sha256`` pins must cover every modified canonical path, or\n113\t    are omitted altogether. Content pins are remeasured from disk on each\n114\t    call. Syntactic validity does not imply that the Owner signed anything.\n115\t    \"\"\"\n116\t    result = {\"valid\": False, \"reason\": \"\", \"canonical_paths\": (), \"sha256\": {}}\n117\t    try:\n118\t        root = Path(repo_root).resolve(strict=True)\n119\t        sentinel = Path(sentinel_file)\n120\t        if sentinel.is_symlink() or not sentinel.is_file():\n121\t            raise ValueError(\"sentinel_missing_or_symlink\")\n122\t        text = sentinel.read_text(encoding=\"utf-8\")\n123\t        if len(_APPROVAL.findall(text)) != 1:\n124\t            raise ValueError(\"approved_by_missing_or_ambiguous\")\n125\t        actual = collect_modified_canonical_paths(root, modified_paths, canonical_patterns=canonical_patterns)\n126\t        result[\"canonical_paths\"] = actual\n127\t        if _parse_scope(text) != actual:\n128\t            raise ValueError(\"scope_diff_mismatch\")\n129\t        if expected_sha256 is not None:\n130\t            if set(expected_sha256) != set(actual):\n131\t                raise ValueError(\"sha256_pin_scope_mismatch\")\n132\t            for rel in actual:\n133\t                target = root / rel\n134\t                if target.is_symlink() or not target.is_file() or not target.resolve().is_relative_to(root):\n135\t                    raise ValueError(\"canonical_file_missing_or_symlink\")\n136\t                digest = hashlib.sha256(target.read_bytes()).hexdigest()\n137\t                result[\"sha256\"][rel] = digest\n138\t                if not isinstance(expected_sha256[rel], str) or digest != expected_sha256[rel].lower():\n139\t                    raise ValueError(\"sha256_pin_mismatch\")\n140\t        result.update(valid=True, reason=\"\")\n141\t    except (ValueError, OSError, UnicodeError, SyntaxError) as exc:\n142\t        result[\"reason\"] = str(exc) if isinstance(exc, ValueError) else type(exc).__name__\n143\t    return result\n144\t\n145\t\n146\tdef verify_detached_signatures(\n147\t    signed_file: Path,\n148\t    signature_file: Path,\n149\t    *,\n150\t    keyring_home: Path,\n151\t    allowed_fingerprints: Iterable[str],\n152\t    timeout: float = 15.0,\n153\t) -> dict:\n154\t    \"\"\"Verify detached bytes with GPG and an explicit isolated keyring.\n155\t\n156\t    Reject unknown signers even when GPG reports ``GOODSIG``. No trust on\n157\t    first use, personal GNUPGHOME, network retrieval or signing commands.\n158\t    \"\"\"\n159\t    result = {\"valid\": False, \"fingerprint\": \"\", \"reason\": \"\"}\n160\t    try:\n161\t        home = Path(keyring_home)\n162\t        signed = Path(signed_file)\n163\t        sig = Path(signature_file)\n164\t        if not home.is_absolute() or home.is_symlink() or not home.is_dir():\n165\t            raise ValueError(\"explicit_keyring_required\")\n166\t        if any(p.is_symlink() or not p.is_file() for p in (signed, sig)):\n167\t            raise ValueError(\"signed_file_or_signature_missing\")\n168\t        permitted = {str(fp).replace(\" \", \"\").upper() for fp in allowed_fingerprints}\n169\t        if not permitted or not all(_FPR.fullmatch(fp) for fp in permitted):\n170\t            raise ValueError(\"invalid_or_empty_fingerprint_allowlist\")\n171\t        binary = shutil.which(\"gpg\") or shutil.which(\"gpg2\")\n172\t        if binary is None:\n173\t            raise ValueError(\"gpg_missing\")\n174\t        command = [binary, \"--no-options\", \"--no-autostart\", \"--homedir\", str(home), \"--batch\", \"--no-tty\", \"--no-auto-key-retrieve\", \"--status-fd\", \"1\", \"--verify\", str(sig), str(signed)]\n175\t        process = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)\n176\t        if process.returncode:\n177\t            raise ValueError(\"gpg_invalid_signature\")\n178\t        good = False\n179\t        candidates = set()\n180\t        for line in process.stdout.splitlines():\n181\t            if line.startswith(\"[GNUPG:] GOODSIG \"):\n182\t                good = True\n183\t            elif line.startswith(\"[GNUPG:] VALIDSIG \"):\n184\t                fields = line.split()\n185\t                if len(fields) >= 3:\n186\t                    candidates.add(fields[2].upper())\n187\t                    if len(fields) >= 12:\n188\t                        candidates.add(fields[-1].upper())  # primary key, if signing subkey\n189\t        if not good or not candidates:\n190\t            raise ValueError(\"gpg_signature_status_incomplete\")\n191\t        matches = sorted(fp for fp in candidates if _FPR.fullmatch(fp) and fp in permitted)\n192\t        if not matches:\n193\t            raise ValueError(\"signer_not_allowlisted\")\n194\t        result.update(valid=True, fingerprint=matches[0], reason=\"\")\n195\t    except (ValueError, OSError, subprocess.TimeoutExpired) as exc:\n196\t        result[\"reason\"] = str(exc) if isinstance(exc, ValueError) else type(exc).__name__\n197\t    return result\n198\t"}]},"parent_tool_use_id":null,"session_id":"8ffba9d0-306f-451d-aea8-6cdde6b6d537","uuid":"5b6bae28-078a-4620-8f4a-52d06b30077e","timestamp":"2026-11-15T10:53:32.756Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_ceremony_toolkit/preflight.py","content":"\"\"\"Read-only canonical scope and GPG gates for a future ceremony packet.\"\"\"\n\nfrom __future__ import annotations\n\nimport ast\nimport fnmatch\nimport hashlib\nimport re\nimport shutil\nimport subprocess\nfrom pathlib import Path, PurePosixPath\nfrom typing import Iterable, Mapping, Optional\n\n_FPR = re.compile(r\"^[A-F0-9]{40}$\")\n_SCOPE_LINE = re.compile(r\"^\\s{2,}-\\s+(.+?)\\s*$\")\n_APPROVAL = re.compile(r\"^Approved-By:\\s+@\\S+\\s+[a-fA-F0-9]{40}\\s*$\", re.M)\n\n\ndef _safe_rel(path: str) -> str:\n    \"\"\"Reject all ambiguous paths instead of normalising them into scope.\"\"\"\n    if not isinstance(path, str) or not path or \"\\\\\" in path or \"\\x00\" in path:\n        raise ValueError(\"unsafe_path\")\n    p = PurePosixPath(path)\n    if p.is_absolute() or any(part in (\".\", \"..\") for part in path.split(\"/\")):\n        raise ValueError(\"unsafe_path\")\n    if p.as_posix() != path or path.startswith(\"~\"):\n        raise ValueError(\"unsafe_path\")\n    return path\n\n\ndef _fnmatch_segments(path: str, pattern: str) -> bool:\n    \"\"\"Mirror canonical_edit.paths._fnmatch_segments without its hook-bound globals.\"\"\"\n    parts, patterns = path.split(\"/\"), pattern.split(\"/\")\n    if not patterns:\n        return not parts\n    head, rest = patterns[0], patterns[1:]\n    if head == \"**\":\n        return any(_match_parts(parts[i:], rest) for i in range(len(parts) + 1))\n    return _match_parts(parts, patterns)\n\n\ndef _match_parts(parts: list, patterns: list) -> bool:\n    if not patterns:\n        return not parts\n    if patterns[0] == \"**\":\n        return any(_match_parts(parts[i:], patterns[1:]) for i in range(len(parts) + 1))\n    return bool(parts) and fnmatch.fnmatchcase(parts[0], patterns[0]) and _match_parts(parts[1:], patterns[1:])\n\n\ndef _canonical_patterns(repo_root: Path) -> tuple[str, ...]:\n    \"\"\"Read the actual guard policy as AST literals; never execute hook code.\"\"\"\n    policy = repo_root / \".claude/hooks/check_canonical_edit.py\"\n    source = ast.parse(policy.read_text(encoding=\"utf-8\"))\n    for node in source.body:\n        if isinstance(node, ast.Assign) and any(\n            isinstance(t, ast.Name) and t.id == \"_CANONICAL_GUARDS\" for t in node.targets\n        ):\n            patterns = ast.literal_eval(node.value)\n            if not isinstance(patterns, list) or not all(isinstance(x, str) for x in patterns):\n                break\n            return tuple(patterns)\n    raise ValueError(\"canonical_guard_policy_unavailable\")\n\n\ndef collect_modified_canonical_paths(\n    repo_root: Path, modified_paths: Iterable[str], *, canonical_patterns: Optional[Iterable[str]] = None\n) -> tuple[str, ...]:\n    \"\"\"Collect guarded paths using the hook's segment-matching semantics.\n\n    Caller supplies modified paths from a trusted diff; this helper never\n    invents a diff or assumes a cached list. Unsafe paths fail the packet.\n    \"\"\"\n    patterns = tuple(canonical_patterns) if canonical_patterns is not None else _canonical_patterns(Path(repo_root))\n    if not patterns or not all(isinstance(p, str) and p for p in patterns):\n        raise ValueError(\"empty_or_invalid_canonical_policy\")\n    paths = (_safe_rel(p) for p in modified_paths)\n    return tuple(sorted({p for p in paths if any(_fnmatch_segments(p.lower(), pat.lower()) for pat in patterns)}))\n\n\ndef _parse_scope(text: str) -> tuple[str, ...]:\n    in_scope = False\n    seen_scope = False\n    scope = []\n    for line in text.splitlines():\n        if line.strip() == \"Scope:\":\n            if seen_scope:\n                raise ValueError(\"duplicate_scope\")\n            seen_scope = True\n            in_scope = True\n            continue\n        if in_scope:\n            match = _SCOPE_LINE.fullmatch(line)\n            if match:\n                scope.append(_safe_rel(match.group(1)))\n            elif line.strip():\n                in_scope = False\n    if not scope or len(set(scope)) != len(scope):\n        raise ValueError(\"missing_or_duplicate_scope\")\n    return tuple(sorted(scope))\n\n\ndef validate_sentinel_pack(\n    repo_root: Path,\n    sentinel_file: Path,\n    modified_paths: Iterable[str],\n    *,\n    expected_sha256: Optional[Mapping[str, str]] = None,\n    canonical_patterns: Optional[Iterable[str]] = None,\n) -> dict:\n    \"\"\"Check exact scope and optional *fresh* SHA-256 pins; never approve.\n\n    ``expected_sha256`` pins must cover every modified canonical path, or\n    are omitted altogether. Content pins are remeasured from disk on each\n    call. Syntactic validity does not imply that the Owner signed anything.\n    \"\"\"\n    result = {\"valid\": False, \"reason\": \"\", \"canonical_paths\": (), \"sha256\": {}}\n    try:\n        root = Path(repo_root).resolve(strict=True)\n        sentinel = Path(sentinel_file)\n        if sentinel.is_symlink() or not sentinel.is_file():\n            raise ValueError(\"sentinel_missing_or_symlink\")\n        text = sentinel.read_text(encoding=\"utf-8\")\n        if len(_APPROVAL.findall(text)) != 1:\n            raise ValueError(\"approved_by_missing_or_ambiguous\")\n        actual = collect_modified_canonical_paths(root, modified_paths, canonical_patterns=canonical_patterns)\n        result[\"canonical_paths\"] = actual\n        if _parse_scope(text) != actual:\n            raise ValueError(\"scope_diff_mismatch\")\n        if expected_sha256 is not None:\n            if set(expected_sha256) != set(actual):\n                raise ValueError(\"sha256_pin_scope_mismatch\")\n            for rel in actual:\n                target = root / rel\n                if target.is_symlink() or not target.is_file() or not target.resolve().is_relative_to(root):\n                    raise ValueError(\"canonical_file_missing_or_symlink\")\n                digest = hashlib.sha256(target.read_bytes()).hexdigest()\n                result[\"sha256\"][rel] = digest\n                if not isinstance(expected_sha256[rel], str) or digest != expected_sha256[rel].lower():\n                    raise ValueError(\"sha256_pin_mismatch\")\n        result.update(valid=True, reason=\"\")\n    except (ValueError, OSError, UnicodeError, SyntaxError) as exc:\n        result[\"reason\"] = str(exc) if isinstance(exc, ValueError) else type(exc).__name__\n    return result\n\n\ndef verify_detached_signatures(\n    signed_file: Path,\n    signature_file: Path,\n    *,\n    keyring_home: Path,\n    allowed_fingerprints: Iterable[str],\n    timeout: float = 15.0,\n) -> dict:\n    \"\"\"Verify detached bytes with GPG and an explicit isolated keyring.\n\n    Reject unknown signers even when GPG reports ``GOODSIG``. No trust on\n    first use, personal GNUPGHOME, network retrieval or signing commands.\n    \"\"\"\n    result = {\"valid\": False, \"fingerprint\": \"\", \"reason\": \"\"}\n    try:\n        home = Path(keyring_home)\n        signed = Path(signed_file)\n        sig = Path(signature_file)\n        if not home.is_absolute() or home.is_symlink() or not home.is_dir():\n            raise ValueError(\"explicit_keyring_required\")\n        if any(p.is_symlink() or not p.is_file() for p in (signed, sig)):\n            raise ValueError(\"signed_file_or_signature_missing\")\n        permitted = {str(fp).replace(\" \", \"\").upper() for fp in allowed_fingerprints}\n        if not permitted or not all(_FPR.fullmatch(fp) for fp in permitted):\n            raise ValueError(\"invalid_or_empty_fingerprint_allowlist\")\n        binary = shutil.which(\"gpg\") or shutil.which(\"gpg2\")\n        if binary is None:\n            raise ValueError(\"gpg_missing\")\n        command = [binary, \"--no-options\", \"--no-autostart\", \"--homedir\", str(home), \"--batch\", \"--no-tty\", \"--no-auto-key-retrieve\", \"--status-fd\", \"1\", \"--verify\", str(sig), str(signed)]\n        process = subprocess.run(command, capture_output=True, text=True, timeout=timeout, check=False)\n        if process.returncode:\n            raise ValueError(\"gpg_invalid_signature\")\n        good = False\n        candidates = set()\n        for line in process.stdout.splitlines():\n            if line.startswith(\"[GNUPG:] GOODSIG \"):\n                good = True\n            elif line.startswith(\"[GNUPG:] VALIDSIG \"):\n                fields = line.split()\n                if len(fields) >= 3:\n                    candidates.add(fields[2].upper())\n                    if len(fields) >= 12:\n                        candidates.add(fields[-1].upper())  # primary key, if signing subkey\n        if not good or not candidates:\n            raise ValueError(\"gpg_signature_status_incomplete\")\n        matches = sorted(fp for fp in candidates if _FPR.fullmatch(fp) and fp in permitted)\n        if not matches:\n            raise ValueError(\"signer_not_allowlisted\")\n        result.update(valid=True, fingerprint=matches[0], reason=\"\")\n    except (ValueError, OSError, subprocess.TimeoutExpired) as exc:\n        result[\"reason\"] = str(exc) if isinstance(exc, ValueError) else type(exc).__name__\n    return result\n","numLines":198,"startLine":1,"totalLines":198}},"tool_result_meta":[{"id":"toolu_01Cnmy1mMn5x3ercaE6TD3K7","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
