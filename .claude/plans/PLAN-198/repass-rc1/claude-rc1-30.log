{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EbnQ3BKRhYp4xdX1o9jSbt","type":"tool_result","content":"1\t# Implementation section: globals belong to the lessons facade.\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\t__all__ = ['_candidates_dir', 'candidate_content_sha256', '_validate_candidate_fields', '_load_injection_scanner', '_scan_candidate_fail_closed', '_write_candidate', '_load_candidate', 'list_candidates', 'add_candidate', '_chain_created_at', '_quarantine_candidate', 'approve_candidate', 'expire_pending_candidates', 'pending_expiry_warning_count', 'count_pending_expiring']\n6\t\n7\tdef _candidates_dir(base_dir: Optional[str] = None) -> Path:\n8\t    \"\"\"Candidate namespace, SIBLING to live lessons.\n9\t\n10\t    Deliberately a subdirectory: ``list_lessons`` iterates only the\n11\t    top level and skips non-``.json`` entries, so legacy readers\n12\t    (get_top_k / build_index / prune-lessons / lesson_ranker) can never\n13\t    surface a candidate — approved or not — through the unverified path.\n14\t    \"\"\"\n15\t    return _lessons_dir(base_dir) / \"candidates\"\n16\t\n17\t\n18\tdef candidate_content_sha256(trigger: str, advisory_text: str) -> str:\n19\t    \"\"\"A6 content hash: ``sha256(trigger + \"\\\\n\" + advisory_text)``.\n20\t\n21\t    The ``\"\\\\n\"`` separator is deliberate (the consensus text says\n22\t    ``sha256(trigger + advisory_text)``): both fields exclude newlines\n23\t    by bounded vocabulary, so the separator makes the concatenation\n24\t    boundary unambiguous — no (trigger, text) pair can collide with a\n25\t    shifted split of another pair.\n26\t    \"\"\"\n27\t    raw = f\"{trigger}\\n{advisory_text}\"\n28\t    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n29\t\n30\t\n31\tdef _validate_candidate_fields(\n32\t    trigger: Any,\n33\t    advisory_text: Any,\n34\t    scope_tags: Any,\n35\t) -> Optional[str]:\n36\t    \"\"\"Bounded-vocabulary validation (A5). Returns a reason code or None.\n37\t\n38\t    Closed reason codes (metadata-only; safe for audit fields and\n39\t    breadcrumbs): trigger_invalid, text_type, text_empty, text_too_long,\n40\t    text_backtick, text_newline, text_control_char, tags_type,\n41\t    tags_too_many, tag_invalid.\n42\t    \"\"\"\n43\t    if not isinstance(trigger, str) or not _CANDIDATE_TOKEN_RE.match(trigger):\n44\t        return \"trigger_invalid\"\n45\t    if not isinstance(advisory_text, str):\n46\t        return \"text_type\"\n47\t    if not advisory_text.strip():\n48\t        return \"text_empty\"\n49\t    if len(advisory_text) > CANDIDATE_TEXT_MAX_CHARS:\n50\t        return \"text_too_long\"\n51\t    if \"`\" in advisory_text:\n52\t        return \"text_backtick\"\n53\t    if \"\\n\" in advisory_text or \"\\r\" in advisory_text:\n54\t        return \"text_newline\"\n55\t    if any(ord(ch) < 32 or ord(ch) == 127 for ch in advisory_text):\n56\t        return \"text_control_char\"\n57\t    if not isinstance(scope_tags, (list, tuple)):\n58\t        return \"tags_type\"\n59\t    if len(scope_tags) > _MAX_CANDIDATE_TAGS:\n60\t        return \"tags_too_many\"\n61\t    for tag in scope_tags:\n62\t        if not isinstance(tag, str) or not _CANDIDATE_TOKEN_RE.match(tag):\n63\t            return \"tag_invalid\"\n64\t    return None\n65\t\n66\t\n67\tdef _load_injection_scanner() -> Any:\n68\t    \"\"\"Load the sibling ``scan-injection.py`` corpus module. RAISES on\n69\t    any failure — the caller's fail-CLOSED posture depends on it (A4).\n70\t\n71\t    The module is registered in ``sys.modules`` BEFORE exec: on Python\n72\t    3.9, dataclass processing under ``from __future__ import\n73\t    annotations`` resolves ``cls.__module__`` through ``sys.modules``\n74\t    and hard-fails for anonymous spec-loaded modules (the advisory\n75\t    ``_scan_lesson_for_injection`` path above silently swallowed this\n76\t    same failure — here it would wrongly quarantine every candidate as\n77\t    ``scanner_unavailable``).\n78\t    \"\"\"\n79\t    import importlib.util as _iutil\n80\t    module_name = \"scan_injection_for_candidates\"\n81\t    cached = sys.modules.get(module_name)\n82\t    if cached is not None and hasattr(cached, \"scan_text\"):\n83\t        return cached\n84\t    spec = _iutil.spec_from_file_location(\n85\t        module_name,\n86\t        Path(__file__).resolve().parent / \"scan-injection.py\",\n87\t    )\n88\t    if spec is None or spec.loader is None:\n89\t        raise ImportError(\"scan-injection.py not loadable\")\n90\t    mod = _iutil.module_from_spec(spec)\n91\t    sys.modules[module_name] = mod\n92\t    try:\n93\t        spec.loader.exec_module(mod)\n94\t    except BaseException:\n95\t        sys.modules.pop(module_name, None)\n96\t        raise\n97\t    if not hasattr(mod, \"scan_text\"):\n98\t        sys.modules.pop(module_name, None)\n99\t        raise ImportError(\"scan-injection.py exposes no scan_text\")\n100\t    return mod\n101\t\n102\t\n103\tdef _scan_candidate_fail_closed(text_blob: str) -> Tuple[bool, str]:\n104\t    \"\"\"Fail-CLOSED injection scan for the promotion boundary (A4).\n105\t\n106\t    Contrast with ``_scan_lesson_for_injection`` above, which is\n107\t    ADVISORY fail-open and acceptable only for the legacy raw-write /\n108\t    telemetry side. Here — per the C4/``_e3`` precedent — content the\n109\t    scanner cannot examine is refused, not waved through:\n110\t"}]},"parent_tool_use_id":null,"session_id":"7d0a8a2c-572f-4c52-9f2d-9f32350c1173","uuid":"25bd2f8c-5ac1-4a68-b9b3-295d9f9c2b4f","timestamp":"2026-11-13T18:36:55.523Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_lessons_parts/candidates.py","content":"# Implementation section: globals belong to the lessons facade.\n\nfrom __future__ import annotations\n\n__all__ = ['_candidates_dir', 'candidate_content_sha256', '_validate_candidate_fields', '_load_injection_scanner', '_scan_candidate_fail_closed', '_write_candidate', '_load_candidate', 'list_candidates', 'add_candidate', '_chain_created_at', '_quarantine_candidate', 'approve_candidate', 'expire_pending_candidates', 'pending_expiry_warning_count', 'count_pending_expiring']\n\ndef _candidates_dir(base_dir: Optional[str] = None) -> Path:\n    \"\"\"Candidate namespace, SIBLING to live lessons.\n\n    Deliberately a subdirectory: ``list_lessons`` iterates only the\n    top level and skips non-``.json`` entries, so legacy readers\n    (get_top_k / build_index / prune-lessons / lesson_ranker) can never\n    surface a candidate — approved or not — through the unverified path.\n    \"\"\"\n    return _lessons_dir(base_dir) / \"candidates\"\n\n\ndef candidate_content_sha256(trigger: str, advisory_text: str) -> str:\n    \"\"\"A6 content hash: ``sha256(trigger + \"\\\\n\" + advisory_text)``.\n\n    The ``\"\\\\n\"`` separator is deliberate (the consensus text says\n    ``sha256(trigger + advisory_text)``): both fields exclude newlines\n    by bounded vocabulary, so the separator makes the concatenation\n    boundary unambiguous — no (trigger, text) pair can collide with a\n    shifted split of another pair.\n    \"\"\"\n    raw = f\"{trigger}\\n{advisory_text}\"\n    return hashlib.sha256(raw.encode(\"utf-8\")).hexdigest()\n\n\ndef _validate_candidate_fields(\n    trigger: Any,\n    advisory_text: Any,\n    scope_tags: Any,\n) -> Optional[str]:\n    \"\"\"Bounded-vocabulary validation (A5). Returns a reason code or None.\n\n    Closed reason codes (metadata-only; safe for audit fields and\n    breadcrumbs): trigger_invalid, text_type, text_empty, text_too_long,\n    text_backtick, text_newline, text_control_char, tags_type,\n    tags_too_many, tag_invalid.\n    \"\"\"\n    if not isinstance(trigger, str) or not _CANDIDATE_TOKEN_RE.match(trigger):\n        return \"trigger_invalid\"\n    if not isinstance(advisory_text, str):\n        return \"text_type\"\n    if not advisory_text.strip():\n        return \"text_empty\"\n    if len(advisory_text) > CANDIDATE_TEXT_MAX_CHARS:\n        return \"text_too_long\"\n    if \"`\" in advisory_text:\n        return \"text_backtick\"\n    if \"\\n\" in advisory_text or \"\\r\" in advisory_text:\n        return \"text_newline\"\n    if any(ord(ch) < 32 or ord(ch) == 127 for ch in advisory_text):\n        return \"text_control_char\"\n    if not isinstance(scope_tags, (list, tuple)):\n        return \"tags_type\"\n    if len(scope_tags) > _MAX_CANDIDATE_TAGS:\n        return \"tags_too_many\"\n    for tag in scope_tags:\n        if not isinstance(tag, str) or not _CANDIDATE_TOKEN_RE.match(tag):\n            return \"tag_invalid\"\n    return None\n\n\ndef _load_injection_scanner() -> Any:\n    \"\"\"Load the sibling ``scan-injection.py`` corpus module. RAISES on\n    any failure — the caller's fail-CLOSED posture depends on it (A4).\n\n    The module is registered in ``sys.modules`` BEFORE exec: on Python\n    3.9, dataclass processing under ``from __future__ import\n    annotations`` resolves ``cls.__module__`` through ``sys.modules``\n    and hard-fails for anonymous spec-loaded modules (the advisory\n    ``_scan_lesson_for_injection`` path above silently swallowed this\n    same failure — here it would wrongly quarantine every candidate as\n    ``scanner_unavailable``).\n    \"\"\"\n    import importlib.util as _iutil\n    module_name = \"scan_injection_for_candidates\"\n    cached = sys.modules.get(module_name)\n    if cached is not None and hasattr(cached, \"scan_text\"):\n        return cached\n    spec = _iutil.spec_from_file_location(\n        module_name,\n        Path(__file__).resolve().parent / \"scan-injection.py\",\n    )\n    if spec is None or spec.loader is None:\n        raise ImportError(\"scan-injection.py not loadable\")\n    mod = _iutil.module_from_spec(spec)\n    sys.modules[module_name] = mod\n    try:\n        spec.loader.exec_module(mod)\n    except BaseException:\n        sys.modules.pop(module_name, None)\n        raise\n    if not hasattr(mod, \"scan_text\"):\n        sys.modules.pop(module_name, None)\n        raise ImportError(\"scan-injection.py exposes no scan_text\")\n    return mod\n\n\ndef _scan_candidate_fail_closed(text_blob: str) -> Tuple[bool, str]:\n    \"\"\"Fail-CLOSED injection scan for the promotion boundary (A4).\n\n    Contrast with ``_scan_lesson_for_injection`` above, which is\n    ADVISORY fail-open and acceptable only for the legacy raw-write /\n    telemetry side. Here — per the C4/``_e3`` precedent — content the\n    scanner cannot examine is refused, not waved through:\n","numLines":110,"startLine":1,"totalLines":564}},"tool_result_meta":[{"id":"toolu_01EbnQ3BKRhYp4xdX1o9jSbt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
