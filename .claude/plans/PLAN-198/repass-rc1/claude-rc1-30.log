{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0167U5o7diK6dzNNApfELW5N","type":"tool_result","content":"1590\t}\n1591\t\n1592\tinstall_scripts_selective() {\n1593\t  echo \"\"\n1594\t  echo \"==> Installing scripts (top-level only, tests/ excluded)\"\n1595\t  _state_record_op \"install_scripts\" \"selective\"\n1596\t  # PLAN-085 Wave A.1 (F-A-QA-0001-c7f21a3e): *.yaml extension added to\n1597\t  # the glob so policy/config YAMLs co-located with scripts/ ship to\n1598\t  # adopters. Without this, files like smart-loading-cap-table.yaml\n1599\t  # (pre-Wave-A.2 location) were silently dropped, breaking the\n1600\t  # first-run-wizard.py crash chain documented in PLAN-084 Wave C.4.\n1601\t  # Post-A.2 the cap-table lives in .claude/policies/, but keeping\n1602\t  # *.yaml in the script glob is the right default for any future\n1603\t  # YAML siblings in .claude/scripts/ (and is the install convention\n1604\t  # we should have shipped from day 1).\n1605\t  local f base\n1606\t  for f in \"$SOURCE_DIR/.claude/scripts/\"*.sh \\\n1607\t           \"$SOURCE_DIR/.claude/scripts/\"*.py \\\n1608\t           \"$SOURCE_DIR/.claude/scripts/\"*.yaml; do\n1609\t    [[ -f \"$f\" ]] || continue\n1610\t    base=\"$( basename \"$f\" )\"\n1611\t    install_one \".claude/scripts/$base\"\n1612\t  done\n1613\t}\n1614\t\n1615\t# PLAN-085 Wave A.3 — install tier-policy.json + .sigchain from\n1616\t# templates/.claude/ to adopter .claude/. Files exist in templates/\n1617\t# (TLA+ ADJ-007 ledger) but were never installed because no install_one\n1618\t# call referenced them. They are required for canonical-guard tier\n1619\t# enforcement at adopter sites.\n1620\tinstall_tier_policy() {\n1621\t  echo \"\"\n1622\t  echo \"==> Installing tier-policy (templates/.claude/tier-policy.json + .sigchain)\"\n1623\t  _state_record_op \"install_tier_policy\" \".claude/tier-policy.json\"\n1624\t  # Rows from the SHARED list the global pre-flight also reads, so these two\n1625\t  # 