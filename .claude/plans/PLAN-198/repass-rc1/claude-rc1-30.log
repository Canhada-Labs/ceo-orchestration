{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012mAHDyjQpLkKj2XsMP2cn1","type":"tool_result","content":"1518\t}\n1519\t\n1520\tinstall_lib_selective() {\n1521\t  echo \"\"\n1522\t  echo \"==> Installing hooks/_lib (runtime only — tests/, test_isolation.py, testing.py excluded)\"\n1523\t  local e base preexisting\n1524\t  for e in \"$SOURCE_DIR/.claude/hooks/_lib/\"*; do\n1525\t    [[ -e \"$e\" ]] || continue\n1526\t    base=\"$( basename \"$e\" )\"\n1527\t    # PLAN-161 U2 (CF-7): route through the ONE canonical framework-internal\n1528\t    # exclusion predicate (scripts/_framework_manifest_set.sh) so install and\n1529\t    # upgrade can never drift apart again. Behavior identical to the previous\n1530\t    # literal case; the fallback case below only serves a partial checkout\n1531\t    # where the helper file was absent at source time (fail-open parity).\n1532\t    if command -v _framework_path_excluded >/dev/null 2>&1; then\n1533\t      if _framework_path_excluded \".claude/hooks/_lib/$base\"; then continue; fi\n1534\t    else\n1535\t      case \"$base\" in\n1536\t        tests|test_isolation.py|testing.py|__pycache__) continue ;;\n1537\t      esac\n1538\t    fi\n1539\t    preexisting=0\n1540\t    [[ -e \"$TARGET/.claude/hooks/_lib/$base\" || -L \"$TARGET/.claude/hooks/_lib/$base\" ]] && preexisting=1\n1541\t    install_one \".claude/hooks/_lib/$base\"\n1542\t    # PLAN-161 U2 (codex r1 F7): only a directory we JUST copied is pruned —\n1543\t    # a pre-existing (EXISTS-skipped) adopter dir is left untouched, link\n1544\t    # mode installs a symlink (the prune helper refuses symlink roots), and\n1545\t    # dry-run copies nothing.\n1546\t    if [[ \"$DRY_RUN\" -eq 0 && \"$MODE\" != \"link\" && \"$preexisting\" -eq 0 && -d \"$e\" && ! -L \"$e\" ]]; then\n1547\t      _prune_pycache_under \"$TARGET/.claude/hooks/_lib/$base\"\n1548\t    fi\n1549\t  done"}]},"parent_tool_use_id":null,"session_id":"7d0a8a2c-572f-4c52-9f2d-9f32350c1173","uui