{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ES2hH5t2z39M946Rzekn6d","type":"tool_result","content":"1\t\"\"\"status context-budget declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport json\n7\timport os\n8\timport re\n9\timport sys\n10\tfrom pathlib import Path\n11\tfrom typing import Any, Dict, List, Optional, Tuple\n12\t\n13\tfrom .compaction import ENV_AUTO_COMPACT_THRESHOLD\n14\tfrom .summarization import ENV_SUMMARIZE_OLDEST\n15\tfrom .middle_out import ENV_MIDDLE_OUT_DEGRADE\n16\t\n17\t__all__ = ('PROBE_VERDICT_KEEP', 'PROBE_VERDICT_REMOVE_PENDING', 'PROBE_STATUS', 'PROBE_STATUS_NOTE', 'probe_status', 'scan_tool_loops', '_render_human', '_render_loops_human')\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# PLAN-179 W3 item US11 — declared probe status (orphan-probe debt ledger)\n21\t# ---------------------------------------------------------------------------\n22\t#\n23\t# \"An orphan probe that stays is debt that LOOKS like coverage.\" The three\n24\t# PLAN-133 Wave D decision probes above (D1/D2/D5) are complete, tested, and\n25\t# CALLED BY NOBODY. Silence is the failure mode: a reader sees a `--*-decision`\n26\t# flag plus a test class and concludes the behaviour is wired.\n27\t#\n28\t# This block makes the state EXPLICIT and machine-readable. It is descriptive\n29\t# only — it changes no behaviour, gates nothing, and is rendered in `--json`,\n30\t# in the human report, and standalone via `--probe-status`.\n31\t#\n32\t# Every \"measured\" field below was established by grep/count on 2026-08-18 and\n33\t# is reproducible; the commands are recorded in\n34\t# `.claude/plans/PLAN-179/orphan-probe-decision.md`. `observed_emits` counted\n35\t# 0 of each action across 7972 parsed audit-log events.\n36\t\n37\t# Closed verdict enum, so a reader (or a future gate) can branch on it.\n38\tPROBE_VERDICT_KEEP = \"keep_exported_policy\"   # no in-repo consumer is possible\n39\tPROBE_VERDICT_REMOVE_PENDING = \"remove_pending_test_codeletion\"\n40\t\n41\tPROBE_STATUS = (\n42\t    {\n43\t        \"probe\": \"D1\",\n44\t        \"subject\": \"proactive auto-compaction policy (hysteresis)\",\n45\t        \"entrypoints\": (\"decide_compaction\", \"--compact-decision\"),\n46\t        \"env_flag\": ENV_AUTO_COMPACT_THRESHOLD,\n47\t        \"audit_actions\": (\n48\t            \"context_auto_compacted\",\n49\t            \"context_auto_compact_suppressed\",\n50\t        ),\n51\t        \"canonical_emit_landed\": True,\n52\t        \"emitters_in_repo\": 0,\n53\t        \"observed_emits\": 0,\n54\t        \"verdict\": PROBE_VERDICT_KEEP,\n55\t        \"consumer\": (\n56\t            \"a HOST LOOP that owns its own context-management step (an adopter \"\n57\t            \"API/SDK harness). It does not exist here and cannot: Claude Code \"\n58\t            \"owns compaction, and the pinned hook schema gives PreCompact NO \"\n59\t            \"hookSpecificOutput arm, so a hook may observe or block a \"\n60\t            \"compaction but never drive one.\"\n61\t        ),\n62\t        \"why_not_removed\": (\n63\t            \"the canonical half IS landed (audit_emit + SPEC v1 + the golden \"\n64\t            \"audit registry). Deleting the decision half here would orphan a \"\n65\t            \"canonical surface that only an Owner-GPG ceremony may touch.\"\n66\t        ),\n67\t        \"removal_scope\": (\n68\t            \"Owner-GPG ceremony: .claude/hooks/_lib/audit_emit.py, \"\n69\t            \"SPEC/v1/audit-log.schema.md, .claude/data/audit-registry.golden.txt, \"\n70\t            \"this block, and the matching tests.\"\n71\t        ),\n72\t    },\n73\t    {\n74\t        \"probe\": \"D2\",\n75\t        \"subject\": \"summarize oldest verbose subagent outputs (protect last N)\",\n76\t        \"entrypoints\": (\"decide_summarization\", \"--summarize-decision\"),\n77\t        \"env_flag\": ENV_SUMMARIZE_OLDEST,\n78\t        \"audit_actions\": (\n79\t            \"subagent_output_summarized\",\n80\t            \"subagent_output_summarize_skipped\",\n81\t        ),\n82\t        \"canonical_emit_landed\": False,\n83\t        \"emitters_in_repo\": 0,\n84\t        \"observed_emits\": 0,\n85\t        \"verdict\": PROBE_VERDICT_REMOVE_PENDING,\n86\t        \"consumer\": (\n87\t            \"none, and none is buildable here: D2 requires a cheap-tier MODEL \"\n88\t            \"call to produce the digest, and this framework's in-path code is \"\n89\t            \"stdlib-only and no-network by construction.\"\n90\t        ),\n91\t        \"why_not_removed\": (\n92\t            \"the deletion must remove the probe AND its test in the SAME \"\n93\t            \"change; the test file was outside the authoring agent's file \"\n94\t            \"assignment. Removing the probe alone would turn a green suite red \"\n95\t            \"— strictly worse than the declared debt.\"\n96\t        ),\n97\t        \"removal_scope\": (\n98\t            \"non-canonical, no ceremony: the D2 block in this file, the \"\n99\t            \"--summarize-decision / --output-sizes / --output-sizes-file CLI \"\n100\t            \"surface, and class TestSummarizationPolicy in \"\n101\t            \".claude/scripts/tests/test_context_budget.py.\"\n102\t        ),\n103\t    },\n104\t    {\n105\t        \"probe\": \"D5\",\n106\t        \"subject\": \"middle-out degradation ladder on context overflow\",\n107\t        \"entrypoints\": (\n108\t            \"decide_middle_out_degradation\",\n109\t            \"apply_middle_out_degradation\",\n110\t            \"--middle-out-decision\",\n111\t        ),\n112\t        \"env_flag\": ENV_MIDDLE_OUT_DEGRADE,\n113\t        \"audit_actions\": (\n114\t            \"context_middle_out_degraded\",\n115\t            \"context_middle_out_degrade_failed\",\n116\t        ),\n117\t        \"canonical_emit_landed\": True,\n118\t        \"emitters_in_repo\": 0,\n119\t        \"observed_emits\": 0,\n120\t        \"verdict\": PROBE_VERDICT_KEEP,\n121\t        \"consumer\": (\n122\t            \"the same absent HOST LOOP as D1 — the component that assembles \"\n123\t            \"the context and discovers the overflow. Claude Code assembles its \"\n124\t            \"own context; this framework never sees the message list.\"\n125\t        ),\n126\t        \"why_not_removed\": (\n127\t            \"identical to D1: the canonical emit half is landed, so removal is \"\n128\t            \"a ceremony, not a script edit.\"\n129\t        ),\n130\t        \"removal_scope\": (\n131\t            \"Owner-GPG ceremony: .claude/hooks/_lib/audit_emit.py, \"\n132\t            \"SPEC/v1/audit-log.schema.md, .claude/data/audit-registry.golden.txt, \"\n133\t            \"this block, and the matching tests.\"\n134\t        ),\n135\t    },\n136\t)\n137\t\n138\t# One line per probe, rendered in the human report so the debt is visible to a\n139\t# reader who never opens the JSON.\n140\tPROBE_STATUS_NOTE = (\n141\t    \"Decision probes D1/D2/D5 in this CLI have ZERO callers and have never \"\n142\t    \"fired — they are reference policy, NOT coverage. Verdicts, consumers and \"\n143\t    \"removal scope: probe_status() / --probe-status (PLAN-179 W3 US11).\"\n144\t)\n145\t\n146\t\n147\tdef probe_status() -> List[Dict[str, Any]]:\n148\t    \"\"\"Return the declared D1/D2/D5 probe-status records (fresh, mutable).\n149\t\n150\t    Descriptive only. Tuples are converted to lists so the result is\n151\t    JSON-serialisable and a caller mutating it cannot corrupt the module\n152\t    constant.\n153\t    \"\"\"\n154\t    out: List[Dict[str, Any]] = []\n155\t    for rec in PROBE_STATUS:\n156\t        item: Dict[str, Any] = {}\n157\t        for key, value in rec.items():\n158\t            item[key] = list(value) if isinstance(value, tuple) else value\n159\t        out.append(item)\n160\t    return out\n161\t\n162\t\n163\t# ---------------------------------------------------------------------------\n164\t# Optional P3 fold-in: tool-loop scan (ECC ecc-context-monitor idea)\n165\t# ---------------------------------------------------------------------------\n166\t\n167\t\n168\tdef scan_tool_loops(\n169\t    audit_log: Path, min_run: int = 3,\n170\t) -> Dict[str, Any]:\n171\t    \"\"\"Flag runs of N identical *consecutive* tool-calls in an audit-log.\n172\t\n173\t    Reads a JSONL audit-log read-only; for each line, derives a tool key from\n174\t    ``tool_name`` (fallback ``action``). A run of ``>= min_run`` identical\n175\t    consecutive keys is flagged (an agent stuck in a tool loop). Advisory:\n176\t    tolerant of malformed lines, never blocks, never echoes payload content.\n177\t    Returns ``{loops: [...], lines_scanned, error?}``.\n178\t    \"\"\"\n179\t    text = _read_text(audit_log)\n180\t    if text is None:\n181\t        return {\"loops\": [], \"lines_scanned\": 0, \"error\": \"unreadable\"}\n182\t\n183\t    keys: List[str] = []\n184\t    scanned = 0\n185\t    for line in text.splitlines():\n186\t        line = line.strip()\n187\t        if not line:\n188\t            continue\n189\t        scanned += 1\n190\t        try:\n191\t            obj = json.loads(line)\n192\t        except (json.JSONDecodeError, ValueError):\n193\t            # Malformed line breaks the consecutive run (use a sentinel).\n194\t            keys.append(\"\\x00malformed\")\n195\t            continue\n196\t        if not isinstance(obj, dict):\n197\t            keys.append(\"\\x00malformed\")\n198\t            continue\n199\t        key = obj.get(\"tool_name\") or obj.get(\"action\") or \"\\x00unknown\"\n200\t        keys.append(str(key))\n201\t\n202\t    loops: List[Dict[str, Any]] = []\n203\t    i = 0\n204\t    n = len(keys)\n205\t    while i < n:\n206\t        j = i\n207\t        while j < n and keys[j] == keys[i]:\n208\t            j += 1\n209\t        run_len = j - i\n210\t        key = keys[i]\n211\t        if run_len >= min_run and not key.startswith(\"\\x00\"):\n212\t            loops.append({\n213\t                \"tool\": key,\n214\t                \"consecutive_count\": run_len,\n215\t                \"start_index\": i,\n216\t                \"message\": (\n217\t                    \"{n} consecutive '{tool}' calls (>= {m}) — possible tool \"\n218\t                    \"loop\".format(n=run_len, tool=key, m=min_run)\n219\t                ),\n220\t            })\n221\t        i = j\n222\t\n223\t    return {\"loops\": loops, \"lines_scanned\": scanned}\n224\t\n225\t\n226\t# ---------------------------------------------------------------------------\n227\t# Rendering\n228\t# ---------------------------------------------------------------------------\n229\t\n230\t\n231\tdef _render_human(report: Dict[str, Any], top: int) -> str:\n232\t    lines: List[str] = []\n233\t    lines.append(\"# context-budget report\")\n234\t    lines.append(\"# heuristic: {}\".format(report[\"heuristic\"]))\n235\t    lines.append(\n236\t        \"# grand total: ~{} est tokens across the always-loaded surface\".format(\n237\t            report[\"grand_total_est_tokens\"],\n238\t        )\n239\t    )\n240\t    lines.append(\"\")\n241\t    lines.append(\"## per-category\")\n242\t    lines.append(\"  {:<12} {:>6} {:>8} {:>10}\".format(\n243\t        \"category\", \"files\", \"lines\", \"est_tok\"))\n244\t    for c in report[\"categories\"]:\n245\t        if c[\"category\"] == CAT_MCP:\n246\t            extra = \"servers={}\".format(c.get(\"server_count\", 0))\n247\t            if c.get(\"over_subscribed\"):\n248\t                extra += \" OVER-SUBSCRIBED\"\n249\t            lines.append(\"  {:<12} {:>6} {:>8} {:>10}  {}\".format(\n250\t                c[\"category\"], c[\"file_count\"], \"-\", \"-\", extra))\n251\t        else:\n252\t            lines.append(\"  {:<12} {:>6} {:>8} {:>10}\".format(\n253\t                c[\"category\"], c[\"file_count\"], c[\"total_lines\"], c[\"est_tokens\"]))\n254\t    lines.append(\"\")\n255\t\n256\t    lines.append(\"## top {} reduction candidates (by est tokens)\".format(top))\n257\t    if not report[\"top_candidates\"]:\n258\t        lines.append(\"  (none — no files inventoried)\")\n259\t    else:\n260\t        for e in report[\"top_candidates\"]:\n261\t            lines.append(\"  ~{:>7} tok  {:>5}L  [{}]  {}\".format(\n262\t                e[\"est_tokens\"], e[\"lines\"], e[\"category\"], e[\"path\"]))\n263\t    lines.append(\"\")\n264\t\n265\t    # PLAN-153 Wave C item 5 — top-3 savings opportunities.\n266\t    savings = report.get(\"savings_top3\", [])\n267\t    lines.append(\"## top-3 savings opportunities (progressive disclosure)\")\n268\t    if not savings:\n269\t        lines.append(\n270\t            \"  (none — no un-split SKILL.md over {} lines)\".format(\n271\t                THRESHOLD_SKILL_LINES))\n272\t    else:\n273\t        for s in savings:\n274\t            lines.append(\n275\t                \"  {}. {} — {}L, ~{} est tok; potential saving ~{} est tok \"\n276\t                \"per activation\".format(\n277\t                    s[\"rank\"], s[\"path\"], s[\"lines\"], s[\"est_tokens\"],\n278\t                    s[\"est_saving_tokens\"]))\n279\t            lines.append(\"     why ranked: {}\".format(s[\"reason\"]))\n280\t            lines.append(\"     mechanism: {}\".format(s[\"mechanism\"]))\n281\t            if s.get(\"caveat\"):\n282\t                lines.append(\"     caveat: {}\".format(s[\"caveat\"]))\n283\t    lines.append(\"\")\n284\t\n285\t    lines.append(\"## flags ({} total)\".format(report[\"flag_count\"]))\n286\t    if not report[\"flags\"]:\n287\t        lines.append(\"  OK: no heavy-file / bloat / over-subscription flags.\")\n288\t    else:\n289\t        for f in report[\"flags\"]:\n290\t            lines.append(\"  [{}] {}\".format(f[\"kind\"], f.get(\"path\", f[\"category\"])))\n291\t            lines.append(\"      {}\".format(f[\"message\"]))\n292\t    lines.append(\"\")\n293\t\n294\t    # PLAN-179 W3 US11 — declared probe status (debt, not coverage).\n295\t    probes = report.get(\"probe_status\", [])\n296\t    if probes:\n297\t        lines.append(\"## decision-probe status (D1/D2/D5 — reference policy, \"\n298\t                     \"NOT wired)\")\n299\t        for p in probes:\n300\t            lines.append(\"  [{}] {} — verdict={}\".format(\n301\t                p.get(\"probe\"), p.get(\"subject\"), p.get(\"verdict\")))\n302\t            lines.append(\"      emitters in repo: {} | observed emits: {} | \"\n303\t                         \"canonical emit landed: {}\".format(\n304\t                             p.get(\"emitters_in_repo\"),\n305\t                             p.get(\"observed_emits\"),\n306\t                             p.get(\"canonical_emit_landed\"),\n307\t                         ))\n308\t            lines.append(\"      missing consumer: {}\".format(p.get(\"consumer\")))\n309\t        lines.append(\"\")\n310\t\n311\t    lines.append(\"## honesty notes\")\n312\t    for note in report.get(\"notes\", []):\n313\t        lines.append(\"  - {}\".format(note))\n314\t    if not report.get(\"scanner_available\", True):\n315\t        lines.append(\n316\t            \"  - DEGRADED: _lib/injection_patterns unavailable — displayed \"\n317\t            \"identifiers fell back to the charset allowlist only.\")\n318\t    lines.append(\"\")\n319\t    lines.append(\"# advisory only — this tool never blocks and never writes \"\n320\t                 \"outside stdout.\")\n321\t    return \"\\n\".join(lines)\n322\t\n323\t\n324\tdef _render_loops_human(result: Dict[str, Any]) -> str:\n325\t    lines: List[str] = []\n326\t    lines.append(\"# tool-loop scan\")\n327\t    lines.append(\"# lines scanned: {}\".format(result.get(\"lines_scanned\", 0)))\n328\t    if result.get(\"error\"):\n329\t        lines.append(\"# error: {}\".format(result[\"error\"]))\n330\t    loops = result.get(\"loops\", [])\n331\t    if not loops:\n332\t        lines.append(\"  OK: no tool loops detected.\")\n333\t    else:\n334\t        for lp in loops:\n335\t            lines.append(\"  [tool_loop] {}\".format(lp[\"message\"]))\n336\t    lines.append(\"\")\n337\t    lines.append(\"# advisory only.\")\n338\t    return \"\\n\".join(lines)\n339\t\n340\t\n341\t# ---------------------------------------------------------------------------\n342\t# CLI\n343\t# ---------------------------------------------------------------------------\n344\t\n345\t\n346\t"}]},"parent_tool_use_id":null,"session_id":"7d0a8a2c-572f-4c52-9f2d-9f32350c1173","uuid":"e5a37809-6898-424d-8e5d-acdcfef073a3","timestamp":"2026-11-13T18:36:09.834Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_context_budget_parts/status.py","content":"\"\"\"status context-budget declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nfrom .compaction import ENV_AUTO_COMPACT_THRESHOLD\nfrom .summarization import ENV_SUMMARIZE_OLDEST\nfrom .middle_out import ENV_MIDDLE_OUT_DEGRADE\n\n__all__ = ('PROBE_VERDICT_KEEP', 'PROBE_VERDICT_REMOVE_PENDING', 'PROBE_STATUS', 'PROBE_STATUS_NOTE', 'probe_status', 'scan_tool_loops', '_render_human', '_render_loops_human')\n\n# ---------------------------------------------------------------------------\n# PLAN-179 W3 item US11 — declared probe status (orphan-probe debt ledger)\n# ---------------------------------------------------------------------------\n#\n# \"An orphan probe that stays is debt that LOOKS like coverage.\" The three\n# PLAN-133 Wave D decision probes above (D1/D2/D5) are complete, tested, and\n# CALLED BY NOBODY. Silence is the failure mode: a reader sees a `--*-decision`\n# flag plus a test class and concludes the behaviour is wired.\n#\n# This block makes the state EXPLICIT and machine-readable. It is descriptive\n# only — it changes no behaviour, gates nothing, and is rendered in `--json`,\n# in the human report, and standalone via `--probe-status`.\n#\n# Every \"measured\" field below was established by grep/count on 2026-08-18 and\n# is reproducible; the commands are recorded in\n# `.claude/plans/PLAN-179/orphan-probe-decision.md`. `observed_emits` counted\n# 0 of each action across 7972 parsed audit-log events.\n\n# Closed verdict enum, so a reader (or a future gate) can branch on it.\nPROBE_VERDICT_KEEP = \"keep_exported_policy\"   # no in-repo consumer is possible\nPROBE_VERDICT_REMOVE_PENDING = \"remove_pending_test_codeletion\"\n\nPROBE_STATUS = (\n    {\n        \"probe\": \"D1\",\n        \"subject\": \"proactive auto-compaction policy (hysteresis)\",\n        \"entrypoints\": (\"decide_compaction\", \"--compact-decision\"),\n        \"env_flag\": ENV_AUTO_COMPACT_THRESHOLD,\n        \"audit_actions\": (\n            \"context_auto_compacted\",\n            \"context_auto_compact_suppressed\",\n        ),\n        \"canonical_emit_landed\": True,\n        \"emitters_in_repo\": 0,\n        \"observed_emits\": 0,\n        \"verdict\": PROBE_VERDICT_KEEP,\n        \"consumer\": (\n            \"a HOST LOOP that owns its own context-management step (an adopter \"\n            \"API/SDK harness). It does not exist here and cannot: Claude Code \"\n            \"owns compaction, and the pinned hook schema gives PreCompact NO \"\n            \"hookSpecificOutput arm, so a hook may observe or block a \"\n            \"compaction but never drive one.\"\n        ),\n        \"why_not_removed\": (\n            \"the canonical half IS landed (audit_emit + SPEC v1 + the golden \"\n            \"audit registry). Deleting the decision half here would orphan a \"\n            \"canonical surface that only an Owner-GPG ceremony may touch.\"\n        ),\n        \"removal_scope\": (\n            \"Owner-GPG ceremony: .claude/hooks/_lib/audit_emit.py, \"\n            \"SPEC/v1/audit-log.schema.md, .claude/data/audit-registry.golden.txt, \"\n            \"this block, and the matching tests.\"\n        ),\n    },\n    {\n        \"probe\": \"D2\",\n        \"subject\": \"summarize oldest verbose subagent outputs (protect last N)\",\n        \"entrypoints\": (\"decide_summarization\", \"--summarize-decision\"),\n        \"env_flag\": ENV_SUMMARIZE_OLDEST,\n        \"audit_actions\": (\n            \"subagent_output_summarized\",\n            \"subagent_output_summarize_skipped\",\n        ),\n        \"canonical_emit_landed\": False,\n        \"emitters_in_repo\": 0,\n        \"observed_emits\": 0,\n        \"verdict\": PROBE_VERDICT_REMOVE_PENDING,\n        \"consumer\": (\n            \"none, and none is buildable here: D2 requires a cheap-tier MODEL \"\n            \"call to produce the digest, and this framework's in-path code is \"\n            \"stdlib-only and no-network by construction.\"\n        ),\n        \"why_not_removed\": (\n            \"the deletion must remove the probe AND its test in the SAME \"\n            \"change; the test file was outside the authoring agent's file \"\n            \"assignment. Removing the probe alone would turn a green suite red \"\n            \"— strictly worse than the declared debt.\"\n        ),\n        \"removal_scope\": (\n            \"non-canonical, no ceremony: the D2 block in this file, the \"\n            \"--summarize-decision / --output-sizes / --output-sizes-file CLI \"\n            \"surface, and class TestSummarizationPolicy in \"\n            \".claude/scripts/tests/test_context_budget.py.\"\n        ),\n    },\n    {\n        \"probe\": \"D5\",\n        \"subject\": \"middle-out degradation ladder on context overflow\",\n        \"entrypoints\": (\n            \"decide_middle_out_degradation\",\n            \"apply_middle_out_degradation\",\n            \"--middle-out-decision\",\n        ),\n        \"env_flag\": ENV_MIDDLE_OUT_DEGRADE,\n        \"audit_actions\": (\n            \"context_middle_out_degraded\",\n            \"context_middle_out_degrade_failed\",\n        ),\n        \"canonical_emit_landed\": True,\n        \"emitters_in_repo\": 0,\n        \"observed_emits\": 0,\n        \"verdict\": PROBE_VERDICT_KEEP,\n        \"consumer\": (\n            \"the same absent HOST LOOP as D1 — the component that assembles \"\n            \"the context and discovers the overflow. Claude Code assembles its \"\n            \"own context; this framework never sees the message list.\"\n        ),\n        \"why_not_removed\": (\n            \"identical to D1: the canonical emit half is landed, so removal is \"\n            \"a ceremony, not a script edit.\"\n        ),\n        \"removal_scope\": (\n            \"Owner-GPG ceremony: .claude/hooks/_lib/audit_emit.py, \"\n            \"SPEC/v1/audit-log.schema.md, .claude/data/audit-registry.golden.txt, \"\n            \"this block, and the matching tests.\"\n        ),\n    },\n)\n\n# One line per probe, rendered in the human report so the debt is visible to a\n# reader who never opens the JSON.\nPROBE_STATUS_NOTE = (\n    \"Decision probes D1/D2/D5 in this CLI have ZERO callers and have never \"\n    \"fired — they are reference policy, NOT coverage. Verdicts, consumers and \"\n    \"removal scope: probe_status() / --probe-status (PLAN-179 W3 US11).\"\n)\n\n\ndef probe_status() -> List[Dict[str, Any]]:\n    \"\"\"Return the declared D1/D2/D5 probe-status records (fresh, mutable).\n\n    Descriptive only. Tuples are converted to lists so the result is\n    JSON-serialisable and a caller mutating it cannot corrupt the module\n    constant.\n    \"\"\"\n    out: List[Dict[str, Any]] = []\n    for rec in PROBE_STATUS:\n        item: Dict[str, Any] = {}\n        for key, value in rec.items():\n            item[key] = list(value) if isinstance(value, tuple) else value\n        out.append(item)\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Optional P3 fold-in: tool-loop scan (ECC ecc-context-monitor idea)\n# ---------------------------------------------------------------------------\n\n\ndef scan_tool_loops(\n    audit_log: Path, min_run: int = 3,\n) -> Dict[str, Any]:\n    \"\"\"Flag runs of N identical *consecutive* tool-calls in an audit-log.\n\n    Reads a JSONL audit-log read-only; for each line, derives a tool key from\n    ``tool_name`` (fallback ``action``). A run of ``>= min_run`` identical\n    consecutive keys is flagged (an agent stuck in a tool loop). Advisory:\n    tolerant of malformed lines, never blocks, never echoes payload content.\n    Returns ``{loops: [...], lines_scanned, error?}``.\n    \"\"\"\n    text = _read_text(audit_log)\n    if text is None:\n        return {\"loops\": [], \"lines_scanned\": 0, \"error\": \"unreadable\"}\n\n    keys: List[str] = []\n    scanned = 0\n    for line in text.splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        scanned += 1\n        try:\n            obj = json.loads(line)\n        except (json.JSONDecodeError, ValueError):\n            # Malformed line breaks the consecutive run (use a sentinel).\n            keys.append(\"\\x00malformed\")\n            continue\n        if not isinstance(obj, dict):\n            keys.append(\"\\x00malformed\")\n            continue\n        key = obj.get(\"tool_name\") or obj.get(\"action\") or \"\\x00unknown\"\n        keys.append(str(key))\n\n    loops: List[Dict[str, Any]] = []\n    i = 0\n    n = len(keys)\n    while i < n:\n        j = i\n        while j < n and keys[j] == keys[i]:\n            j += 1\n        run_len = j - i\n        key = keys[i]\n        if run_len >= min_run and not key.startswith(\"\\x00\"):\n            loops.append({\n                \"tool\": key,\n                \"consecutive_count\": run_len,\n                \"start_index\": i,\n                \"message\": (\n                    \"{n} consecutive '{tool}' calls (>= {m}) — possible tool \"\n                    \"loop\".format(n=run_len, tool=key, m=min_run)\n                ),\n            })\n        i = j\n\n    return {\"loops\": loops, \"lines_scanned\": scanned}\n\n\n# ---------------------------------------------------------------------------\n# Rendering\n# ---------------------------------------------------------------------------\n\n\ndef _render_human(report: Dict[str, Any], top: int) -> str:\n    lines: List[str] = []\n    lines.append(\"# context-budget report\")\n    lines.append(\"# heuristic: {}\".format(report[\"heuristic\"]))\n    lines.append(\n        \"# grand total: ~{} est tokens across the always-loaded surface\".format(\n            report[\"grand_total_est_tokens\"],\n        )\n    )\n    lines.append(\"\")\n    lines.append(\"## per-category\")\n    lines.append(\"  {:<12} {:>6} {:>8} {:>10}\".format(\n        \"category\", \"files\", \"lines\", \"est_tok\"))\n    for c in report[\"categories\"]:\n        if c[\"category\"] == CAT_MCP:\n            extra = \"servers={}\".format(c.get(\"server_count\", 0))\n            if c.get(\"over_subscribed\"):\n                extra += \" OVER-SUBSCRIBED\"\n            lines.append(\"  {:<12} {:>6} {:>8} {:>10}  {}\".format(\n                c[\"category\"], c[\"file_count\"], \"-\", \"-\", extra))\n        else:\n            lines.append(\"  {:<12} {:>6} {:>8} {:>10}\".format(\n                c[\"category\"], c[\"file_count\"], c[\"total_lines\"], c[\"est_tokens\"]))\n    lines.append(\"\")\n\n    lines.append(\"## top {} reduction candidates (by est tokens)\".format(top))\n    if not report[\"top_candidates\"]:\n        lines.append(\"  (none — no files inventoried)\")\n    else:\n        for e in report[\"top_candidates\"]:\n            lines.append(\"  ~{:>7} tok  {:>5}L  [{}]  {}\".format(\n                e[\"est_tokens\"], e[\"lines\"], e[\"category\"], e[\"path\"]))\n    lines.append(\"\")\n\n    # PLAN-153 Wave C item 5 — top-3 savings opportunities.\n    savings = report.get(\"savings_top3\", [])\n    lines.append(\"## top-3 savings opportunities (progressive disclosure)\")\n    if not savings:\n        lines.append(\n            \"  (none — no un-split SKILL.md over {} lines)\".format(\n                THRESHOLD_SKILL_LINES))\n    else:\n        for s in savings:\n            lines.append(\n                \"  {}. {} — {}L, ~{} est tok; potential saving ~{} est tok \"\n                \"per activation\".format(\n                    s[\"rank\"], s[\"path\"], s[\"lines\"], s[\"est_tokens\"],\n                    s[\"est_saving_tokens\"]))\n            lines.append(\"     why ranked: {}\".format(s[\"reason\"]))\n            lines.append(\"     mechanism: {}\".format(s[\"mechanism\"]))\n            if s.get(\"caveat\"):\n                lines.append(\"     caveat: {}\".format(s[\"caveat\"]))\n    lines.append(\"\")\n\n    lines.append(\"## flags ({} total)\".format(report[\"flag_count\"]))\n    if not report[\"flags\"]:\n        lines.append(\"  OK: no heavy-file / bloat / over-subscription flags.\")\n    else:\n        for f in report[\"flags\"]:\n            lines.append(\"  [{}] {}\".format(f[\"kind\"], f.get(\"path\", f[\"category\"])))\n            lines.append(\"      {}\".format(f[\"message\"]))\n    lines.append(\"\")\n\n    # PLAN-179 W3 US11 — declared probe status (debt, not coverage).\n    probes = report.get(\"probe_status\", [])\n    if probes:\n        lines.append(\"## decision-probe status (D1/D2/D5 — reference policy, \"\n                     \"NOT wired)\")\n        for p in probes:\n            lines.append(\"  [{}] {} — verdict={}\".format(\n                p.get(\"probe\"), p.get(\"subject\"), p.get(\"verdict\")))\n            lines.append(\"      emitters in repo: {} | observed emits: {} | \"\n                         \"canonical emit landed: {}\".format(\n                             p.get(\"emitters_in_repo\"),\n                             p.get(\"observed_emits\"),\n                             p.get(\"canonical_emit_landed\"),\n                         ))\n            lines.append(\"      missing consumer: {}\".format(p.get(\"consumer\")))\n        lines.append(\"\")\n\n    lines.append(\"## honesty notes\")\n    for note in report.get(\"notes\", []):\n        lines.append(\"  - {}\".format(note))\n    if not report.get(\"scanner_available\", True):\n        lines.append(\n            \"  - DEGRADED: _lib/injection_patterns unavailable — displayed \"\n            \"identifiers fell back to the charset allowlist only.\")\n    lines.append(\"\")\n    lines.append(\"# advisory only — this tool never blocks and never writes \"\n                 \"outside stdout.\")\n    return \"\\n\".join(lines)\n\n\ndef _render_loops_human(result: Dict[str, Any]) -> str:\n    lines: List[str] = []\n    lines.append(\"# tool-loop scan\")\n    lines.append(\"# lines scanned: {}\".format(result.get(\"lines_scanned\", 0)))\n    if result.get(\"error\"):\n        lines.append(\"# error: {}\".format(result[\"error\"]))\n    loops = result.get(\"loops\", [])\n    if not loops:\n        lines.append(\"  OK: no tool loops detected.\")\n    else:\n        for lp in loops:\n            lines.append(\"  [tool_loop] {}\".format(lp[\"message\"]))\n    lines.append(\"\")\n    lines.append(\"# advisory only.\")\n    return \"\\n\".join(lines)\n\n\n# ---------------------------------------------------------------------------\n# CLI\n# ---------------------------------------------------------------------------\n\n\n","numLines":346,"startLine":1,"totalLines":346}},"tool_result_meta":[{"id":"toolu_01ES2hH5t2z39M946Rzekn6d","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
