{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VqvUu4JUS5j44fB9X5inWi","type":"tool_result","content":"119\tclass MiddleOutPolicy:\n120\t    \"\"\"Config for the middle-out degradation ladder.\n121\t\n122\t    Stateless by design — the host owns the message list and applies the plan.\n123\t    This object only holds the three knobs + the (constant) ladder.\n124\t    \"\"\"\n125\t\n126\t    def __init__(\n127\t        self,\n128\t        keep_floor_pct: int,\n129\t        protect_last: int,\n130\t        min_msg_tokens: int,\n131\t    ) -> None:\n132\t        # Clamp to sane, fail-open values (never raise on a bad number). The\n133\t        # keep-floor is a percent in [1, 100] (0 would allow dropping a whole\n134\t        # message — middle-out always keeps SOMETHING, so floor is >= 1).\n135\t        floor = _clamp_pct(keep_floor_pct, DEFAULT_MIDDLE_OUT_KEEP_FLOOR_PCT)\n136\t        self.keep_floor_pct = floor if floor >= 1 else 1\n137\t        self.protect_last = _clamp_nonneg_int(\n138\t            protect_last, DEFAULT_MIDDLE_OUT_PROTECT_LAST)\n139\t        self.min_msg_tokens = _clamp_nonneg_int(\n140\t            min_msg_tokens, DEFAULT_MIDDLE_OUT_MIN_MSG_TOKENS)\n141\t\n142\t\n143\tdef load_middle_out_policy_from_env(\n144\t    env: Optional[Dict[str, str]] = None,\n145\t) -> Optional[MiddleOutPolicy]:\n146\t    \"\"\"Build a MiddleOutPolicy from env, or None when the feature is OFF.\n147\t\n148\t    OFF (returns None) unless `CEO_MIDDLE_OUT_DEGRADE` is set to an int in\n149\t    (0, 100] (the per-message keep-floor percent). Other knobs fall back to\n150\t    documented defaults when unset/invalid. Fail-open: never raises.\n151\t    \"\"\"\n152\t    floor = _env_int(ENV_MIDDLE_OUT_DEGRADE, env)\n153\t    if floor is None or floor <= 0 or floor > 100:\n154\t        return None  # default-OFF\n155\t    protect = _env_int(ENV_MIDDLE_OUT_PROTECT_LAST, env)\n156\t    min_tokens = _env_int(ENV_MIDDLE_OUT_MIN_MSG_TOKENS, env)\n157\t    return MiddleOutPolicy(\n158\t        keep_floor_pct=floor,\n159\t        protect_last=protect if protect is not None else DEFAULT_MIDDLE_OUT_PROTECT_LAST,\n160\t        min_msg_tokens=min_tokens if min_tokens is not None else DEFAULT_MIDDLE_OUT_MIN_MSG_TOKENS,\n161\t    )\n162\t\n163\t"}]},"parent_tool_use_id":null,"session_id":"41de4d4a-eac6-4470-9814-67ae2b53d60e","uuid":"21208c0e-de30-422f-9274-c5c1e4027f0e","timestamp":"2026-11-15T11:29:12.027Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_context_budget_parts/middle_out.py","content":"class MiddleOutPolicy:\n    \"\"\"Config for the middle-out degradation ladder.\n\n    Stateless by design — the host owns the message list and applies the plan.\n    This object only holds the three knobs + the (constant) ladder.\n    \"\"\"\n\n    def __init__(\n        self,\n        keep_floor_pct: int,\n        protect_last: int,\n        min_msg_tokens: int,\n    ) -> None:\n        # Clamp to sane, fail-open values (never raise on a bad number). The\n        # keep-floor is a percent in [1, 100] (0 would allow dropping a whole\n        # message — middle-out always keeps SOMETHING, so floor is >= 1).\n        floor = _clamp_pct(keep_floor_pct, DEFAULT_MIDDLE_OUT_KEEP_FLOOR_PCT)\n        self.keep_floor_pct = floor if floor >= 1 else 1\n        self.protect_last = _clamp_nonneg_int(\n            protect_last, DEFAULT_MIDDLE_OUT_PROTECT_LAST)\n        self.min_msg_tokens = _clamp_nonneg_int(\n            min_msg_tokens, DEFAULT_MIDDLE_OUT_MIN_MSG_TOKENS)\n\n\ndef load_middle_out_policy_from_env(\n    env: Optional[Dict[str, str]] = None,\n) -> Optional[MiddleOutPolicy]:\n    \"\"\"Build a MiddleOutPolicy from env, or None when the feature is OFF.\n\n    OFF (returns None) unless `CEO_MIDDLE_OUT_DEGRADE` is set to an int in\n    (0, 100] (the per-message keep-floor percent). Other knobs fall back to\n    documented defaults when unset/invalid. Fail-open: never raises.\n    \"\"\"\n    floor = _env_int(ENV_MIDDLE_OUT_DEGRADE, env)\n    if floor is None or floor <= 0 or floor > 100:\n        return None  # default-OFF\n    protect = _env_int(ENV_MIDDLE_OUT_PROTECT_LAST, env)\n    min_tokens = _env_int(ENV_MIDDLE_OUT_MIN_MSG_TOKENS, env)\n    return MiddleOutPolicy(\n        keep_floor_pct=floor,\n        protect_last=protect if protect is not None else DEFAULT_MIDDLE_OUT_PROTECT_LAST,\n        min_msg_tokens=min_tokens if min_tokens is not None else DEFAULT_MIDDLE_OUT_MIN_MSG_TOKENS,\n    )\n\n","numLines":45,"startLine":119,"totalLines":562}},"tool_result_meta":[{"id":"toolu_01VqvUu4JUS5j44fB9X5inWi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
