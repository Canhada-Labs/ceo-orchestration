{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1QwZNQzz2qsKysY4reM","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_019AEsud9AHg5FmNxsvKwbv1","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/local/_release_bump_sites.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2134,"cache_read_input_tokens":169051,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2134},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"7d0a8a2c-572f-4c52-9f2d-9f32350c1173","uuid":"af31fdb8-018d-4d64-93f2-ea95bd737bb1","timestamp":"2026-11-13T18:38:27.793Z","request_id":"req_011Ch1QwZ9HDxiFCVjQ7DqNS","wire_tool_inputs":{"toolu_019AEsud9AHg5FmNxsvKwbv1":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/local/_release_bump_sites.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019AEsud9AHg5FmNxsvKwbv1","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t# ============================================================================\n3\t# _release_bump_sites.py — the ONE source of truth for the release version\n4\t# sites, and the only writer of them.\n5\t#\n6\t# Why a module and not a heredoc. Until PLAN-166/W0 this table lived inside\n7\t# `release.sh` as a `python3 - <<'PY'` heredoc. That had two costs that both\n8\t# showed up in the v1.3.0-rc.1 re-pass:\n9\t#\n10\t#   1. the site list existed TWICE — once in the heredoc (the writer) and once\n11\t#      in the driver's `VERSION_FILES` array (the dry-run restore list). A list\n12\t#      that must match another list by hand does not stay matched; a restore\n13\t#      list shorter than the write list leaves debris (the S273 class).\n14\t#   2. it was untestable. `--today` could not be pinned, so the D+1\n15\t#      non-idempotence (F2) could not be exercised by a test.\n16\t#\n17\t# Both are closed here: the driver DERIVES its restore list from\n18\t# `print-sites --include-generated`, and `--today` is a REQUIRED parameter with\n19\t# NO DEFAULT (a parameter that changes the verdict never has a default —\n20\t# frozen-evidence lesson).\n21\t#\n22\t# Idempotence contract (F2). A `last-reviewed:` stamp asserts \"this document\n23\t# was re-read FOR THIS RELEASE\". Re-dating it without re-reading is a false\n24\t# claim on a surface that a signed tag then covers. So the stamp sites\n25\t# skip the ENTIRE line — neither date nor version — when the version already\n26\t# on the stamp is the target. `--restamp` is the named, explicit route for a\n27\t# real re-review.\n28\t#\n29\t# The two stamp oracles (do not collapse them). `npm/README.md` is watched by\n30\t# verify-counts' VERSION_SITES; SBOM.md / SECURITY.md / VERSIONING.md are\n31\t# watched ONLY by check-canonical-doc-freshness.py. Both oracles decide on the\n32\t# VERSION in the stamp, never on the date — which is what makes freezing the\n33\t# date safe.\n34\t#\n35\t# The support window (kinds \"minor\"/\"prev_minor\" — v1.3.0 re-pass, F-sites).\n36\t# verify-counts' VERSION_SITES also watches \"Current MINOR (vX.Y.x)\" and\n37\t# \"Previous MINOR (vX.Y.x)\" in SECURITY.md and VERSIONING.md (S293). Those\n38\t# sites were OUTSIDE this table at birth, so the next MINOR bump would write\n39\t# everything else, then DIE at the driver's own verify-counts call with a\n40\t# half-written tree (outside --dry-run there is no restore trap). The rule the\n41\t# oracle enforces is mechanical — Current = the target's minor, Previous = the\n42\t# minor immediately before it — so this writer derives both from --target and\n43\t# the \"ONE source of truth\" claim above stays true. The single non-derivable\n44\t# case, an X.0.0 target, is SKIPPED loudly and never guessed: the oracle\n45\t# cannot value-check it either (it derives prev=\"\" at X.0), and a MAJOR\n46\t# support-window transition is release-train judgment, not sed.\n47\t# ============================================================================\n48\t\"\"\"Release version-site table + writer (stdlib only, Python >= 3.9).\"\"\"\n49\t\n50\tfrom __future__ import annotations\n51\t\n52\timport argparse\n53\timport os\n54\timport re\n55\timport sys\n56\tfrom typing import Callable, List, Optional, Sequence, Tuple\n57\t\n58\tSEMVER = r\"\\d+\\.\\d+\\.\\d+\"\n59\tSTAMP_RX = r\"(last-reviewed: )(\\d{4}-\\d{2}-\\d{2})( +v)(\" + SEMVER + r\")\"\n60\tDATE_RX = re.compile(r\"\\A\\d{4}-\\d{2}-\\d{2}\\Z\")\n61\t\n62\t# Kinds:\n63\t#   \"plain\"      — literal regex substitution, no stamp semantics.\n64\t#   \"stamp\"      — \"last-reviewed: <date> v<version>\"; skipped wholesale when\n65\t#                  the version already equals the target (unless --restamp).\n66\t#   \"minor\"      — support-window site carrying the TARGET's minor (vX.Y.x).\n67\t#   \"prev_minor\" — support-window site carrying the minor immediately BEFORE\n68\t#                  the target; not derivable at X.0.0 (skipped loudly there).\n69\tPLAIN = \"plain\"\n70\tSTAMP = \"stamp\"\n71\tMINOR = \"minor\"\n72\tPREV_MINOR = \"prev_minor\"\n73\t\n74\t# (path, kind, pattern) — patterns anchored exactly as their oracle checks\n75\t# them, so historical version mentions elsewhere in the file are never touched.\n76\t_SITES: List[Tuple[str, str, str]] = [\n77\t    (\"VERSION\", PLAIN, r\"\\A\\s*\" + SEMVER + r\"\\s*\\Z\"),\n78\t    # PLAN-169 W2.6 (ledger E.1/F.7/A.0.4): the install-state marker is the\n79\t    # surface check-framework-updates.sh reads MARKER-FIRST — a bump that\n80\t    # skips it leaves every adopter's updater reporting behind-minor\n81\t    # forever. Joins _SITES with its oracle mirror in verify-counts\n82\t    # VERSION_SITES (no census numeral here: the F6 guard forbids\n83\t    # site-count claims in comments, ordinals included).\n84\t    (\".claude/.framework-version\", PLAIN, r\"\\A\\s*\" + SEMVER + r\"\\s*\\Z\"),\n85\t    (\"npm/package.json\", PLAIN, r'(\"version\"\\s*:\\s*\")' + SEMVER + r'(\")'),\n86\t    (\"pyproject.toml\", PLAIN, r'(?m)^(version\\s*=\\s*\")' + SEMVER + r'(\")'),\n87\t    # The upgrade instructions resolve the latest RC tag during the hold and\n88\t    # use the GA tag afterwards. One pattern owns both version stems, so a\n89\t    # bump cannot leave either route on a prior train.\n90\t    (\"INSTALL.md\", PLAIN, r\"((?:--pin |git tag --list ['\\\"]?)v)\" + SEMVER),\n91\t    (\n92\t        \"docs/ARCHITECTURE.md\",\n93\t        PLAIN,\n94\t        r\"(currently\\s+v)\" + SEMVER + r\"(, aligned with the repo)\",\n95\t    ),\n96\t    # README.md and CLAUDE.md are deliberately NOT rows here: neither is a\n97\t    # version site. `VERSION=` never existed in either (verify-counts dropped\n98\t    # its dead rules for both in S291 — `git log -S 'VERSION='` finds no\n99\t    # commit that added one — and the release checklist states the same). A\n100\t    # writer row for a site no oracle watches would be that dead rule\n101\t    # reintroduced on the WRITE side: the day someone adds a `VERSION=` line\n102\t    # to README.md, the bump would rewrite a file every other surface\n103\t    # declares out of scope.\n104\t    (\"SBOM.md\", PLAIN, r\"(\\*\\*Version:\\*\\* `)\" + SEMVER + r\"(`)\"),\n105\t    # --- the support window (oracle: verify-counts VERSION_SITES modes\n106\t    #     \"minor\"/\"prev_minor\", S293). Patterns anchored exactly as the\n107\t    #     oracle's — SECURITY.md bolds the label, VERSIONING.md does not. ---\n108\t    (\"SECURITY.md\", MINOR, r\"(\\*\\*Current MINOR\\*\\* \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n109\t    (\"VERSIONING.md\", MINOR, r\"(Current MINOR \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n110\t    (\"SECURITY.md\", PREV_MINOR, r\"(\\*\\*Previous MINOR\\*\\* \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n111\t    (\"VERSIONING.md\", PREV_MINOR, r\"(Previous MINOR \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n112\t    # --- the review stamps (idempotence-critical; the table IS the census,\n113\t    #     a numeral here would be a mirror that drifts) ---\n114\t    (\"npm/README.md\", STAMP, STAMP_RX),\n115\t    (\"SBOM.md\", STAMP, STAMP_RX),\n116\t    (\"SECURITY.md\", STAMP, STAMP_RX),\n117\t    (\"VERSIONING.md\", STAMP, STAMP_RX),\n118\t]\n119\t\n120\t# Written by the bump PHASE but not by this module: `build-plugin.py\n121\t# --write-manifests` regenerates them from VERSION. They belong in any\n122\t# derived restore/guard list, which is why they are exported here instead of\n123\t# being re-typed by every caller (the duplicated-list failure this module\n124\t# exists to kill).\n125\tGENERATED_BY_BUMP: List[str] = [\n126\t    \".claude-plugin/plugin.json\",\n127\t    \".claude-plugin/marketplace.json\",\n128\t]\n129\t\n130\t\n131\tdef site_paths(include_generated: bool = False) -> List[str]:\n132\t    \"\"\"Every path this module may write, de-duplicated, in table order.\"\"\"\n133\t    out: List[str] = []\n134\t    for path, _kind, _rx in _SITES:\n135\t        if path not in out:\n136\t            out.append(path)\n137\t    if include_generated:\n138\t        for path in GENERATED_BY_BUMP:\n139\t            if path not in out:\n140\t                out.append(path)\n141\t    return out\n142\t\n143\t\n144\tdef _plain_replacement(pattern: str, target: str) -> str:\n145\t    \"\"\"Replacement string for a PLAIN site, rebuilt from its group count.\"\"\"\n146\t    if pattern.startswith(r\"\\A\"):  # the bare VERSION file\n147\t        return target + \"\\n\"\n148\t    groups = re.compile(pattern).groups\n149\t    if groups == 0:\n150\t        return target\n151\t    if groups == 1:\n152\t        return r\"\\g<1>\" + target\n153\t    return r\"\\g<1>\" + target + r\"\\g<2>\"\n154\t\n155\t\n156\tdef _stamp_replacer(\n157\t    target: str, today: str, restamp: bool\n158\t) -> Callable[[\"re.Match\"], str]:\n159\t    def _repl(m: \"re.Match\") -> str:\n160\t        if not restamp and m.group(4) == target:\n161\t            # Defense in depth: the whole line is left byte-identical. Both\n162\t            # stamp oracles read the VERSION, so freezing the date costs\n163\t            # nothing and re-dating without re-reading would be a false claim.\n164\t            return m.group(0)\n165\t        return m.group(1) + today + m.group(3) + target\n166\t\n167\t    return _repl\n168\t\n169\t\n170\tdef bump(\n171\t    target: str,\n172\t    today: str,\n173\t    *,\n174\t    restamp: bool = False,\n175\t    root: Optional[str] = None,\n176\t    out=None,\n177\t) -> int:\n178\t    \"\"\"Rewrite every version site to `target`. Returns files CHANGED.\"\"\"\n179\t    if not DATE_RX.match(today):\n180\t        raise ValueError(\"--today must be YYYY-MM-DD, got %r\" % (today,))\n181\t    if not re.match(r\"\\A\" + SEMVER + r\"\\Z\", target):\n182\t        raise ValueError(\"--target must be a bare semver, got %r\" % (target,))\n183\t    stream = out if out is not None else sys.stdout\n184\t    base = root or os.getcwd()\n185\t    # Support-window derivation, BEFORE any byte is written: whether every\n186\t    # site is writable is decided up front, never discovered mid-loop with a\n187\t    # half-bumped tree behind it.\n188\t    _maj, _min = (int(x) for x in target.split(\".\")[:2])\n189\t    minor_target = \"%d.%d\" % (_maj, _min)\n190\t    prev_minor = \"%d.%d\" % (_maj, _min - 1) if _min > 0 else None\n191\t    changed = 0\n192\t    for path, kind, pattern in _SITES:\n193\t        if kind == PREV_MINOR and prev_minor is None:\n194\t            # X.0.0: Previous MINOR is not derivable from the target, and the\n195\t            # oracle skips value-checking it there too (prev=\"\" at X.0). Never\n196\t            # guess a support-window promise — leave it and say so, loudly.\n197\t            print(\n198\t                \"  !!   %s: Previous MINOR left untouched — not derivable \"\n199\t                \"from %s (X.0.0); the support window needs release-train \"\n200\t                \"judgment here\" % (path, target),\n201\t                file=stream,\n202\t            )\n203\t            continue\n204\t        full = os.path.join(base, path)\n205\t        try:\n206\t            with open(full, encoding=\"utf-8\") as fh:\n207\t                src = fh.read()\n208\t        except OSError:\n209\t            print(\"  --   %s absent, skipped\" % path, file=stream)\n210\t            continue\n211\t        written = target\n212\t        if kind == STAMP:\n213\t            new, n = re.subn(pattern, _stamp_replacer(target, today, restamp), src)\n214\t            label = \"review stamp\"\n215\t        elif kind == MINOR:\n216\t            written = minor_target\n217\t            new, n = re.subn(pattern, r\"\\g<1>\" + written + r\"\\g<2>\", src)\n218\t            label = \"support-window (Current MINOR) site\"\n219\t        elif kind == PREV_MINOR:\n220\t            written = prev_minor\n221\t            new, n = re.subn(pattern, r\"\\g<1>\" + written + r\"\\g<2>\", src)\n222\t            label = \"support-window (Previous MINOR) site\"\n223\t        else:\n224\t            new, n = re.subn(pattern, _plain_replacement(pattern, target), src)\n225\t            label = \"version site\"\n226\t        if n == 0:\n227\t            print(\n228\t                \"  --   %s: no %s found (ok if unwatched)\" % (path, label),\n229\t                file=stream,\n230\t            )\n231\t            continue\n232\t        if new == src:\n233\t            print(\n234\t                \"  --   %s: %s already at %s (line untouched)\"\n235\t                % (path, label, written),\n236\t                file=stream,\n237\t            )\n238\t            continue\n239\t        with open(full, \"w\", encoding=\"utf-8\") as fh:\n240\t            fh.write(new)\n241\t        changed += 1\n242\t        print(\n243\t            \"  ok   %s (%d %s%s -> %s)\"\n244\t            % (path, n, label, \"\" if n == 1 else \"s\", written),\n245\t            file=stream,\n246\t        )\n247\t    return changed\n248\t\n249\t\n250\tdef main(argv: Optional[Sequence[str]] = None) -> int:\n251\t    parser = argparse.ArgumentParser(\n252\t        prog=\"_release_bump_sites.py\",\n253\t        description=\"Release version-site table + writer (single source).\",\n254\t    )\n255\t    sub = parser.add_subparsers(dest=\"cmd\")\n256\t\n257\t    p_list = sub.add_parser(\n258\t        \"print-sites\",\n259\t        help=\"print every path the bump may write, one per line\",\n260\t    )\n261\t    p_list.add_argument(\n262\t        \"--include-generated\",\n263\t        action=\"store_true\",\n264\t        help=\"also print the plugin manifests regenerated by build-plugin.py\",\n265\t    )\n266\t\n267\t    p_bump = sub.add_parser(\"bump\", help=\"rewrite the version sites\")\n268\t    # NO DEFAULT, BY CONTRACT. `--today` decides whether a signed\n269\t    # \"last-reviewed\" claim moves; a parameter that changes the verdict is\n270\t    # never defaulted (frozen-evidence lesson).\n271\t    p_bump.add_argument(\"--today\", required=True, help=\"YYYY-MM-DD (required)\")\n272\t    p_bump.add_argument(\"--target\", required=True, help=\"bare semver, e.g. 1.3.0\")\n273\t    p_bump.add_argument(\n274\t        \"--restamp\",\n275\t        action=\"store_true\",\n276\t        help=\"force the review stamps to move even at the same version\",\n277\t    )\n278\t    p_bump.add_argument(\"--root\", default=None, help=\"repo root (default: cwd)\")\n279\t\n280\t    args = parser.parse_args(argv)\n281\t    if args.cmd == \"print-sites\":\n282\t        for path in site_paths(include_generated=args.include_generated):\n283\t            print(path)\n284\t        return 0\n285\t    if args.cmd == \"bump\":\n286\t        try:\n287\t            bump(\n288\t                args.target,\n289\t                args.today,\n290\t                restamp=args.restamp,\n291\t                root=args.root,\n292\t            )\n293\t        except ValueError as exc:\n294\t            print(\"FAIL: %s\" % exc, file=sys.stderr)\n295\t            return 2\n296\t        return 0\n297\t    parser.print_usage(sys.stderr)\n298\t    return 2\n299\t\n300\t\n301\tif __name__ == \"__main__\":\n302\t    sys.exit(main())\n303\t"}]},"parent_tool_use_id":null,"session_id":"7d0a8a2c-572f-4c52-9f2d-9f32350c1173","uuid":"1dd84989-087e-484a-a8cf-07272edb6191","timestamp":"2026-11-13T18:38:27.824Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/local/_release_bump_sites.py","content":"#!/usr/bin/env python3\n# ============================================================================\n# _release_bump_sites.py — the ONE source of truth for the release version\n# sites, and the only writer of them.\n#\n# Why a module and not a heredoc. Until PLAN-166/W0 this table lived inside\n# `release.sh` as a `python3 - <<'PY'` heredoc. That had two costs that both\n# showed up in the v1.3.0-rc.1 re-pass:\n#\n#   1. the site list existed TWICE — once in the heredoc (the writer) and once\n#      in the driver's `VERSION_FILES` array (the dry-run restore list). A list\n#      that must match another list by hand does not stay matched; a restore\n#      list shorter than the write list leaves debris (the S273 class).\n#   2. it was untestable. `--today` could not be pinned, so the D+1\n#      non-idempotence (F2) could not be exercised by a test.\n#\n# Both are closed here: the driver DERIVES its restore list from\n# `print-sites --include-generated`, and `--today` is a REQUIRED parameter with\n# NO DEFAULT (a parameter that changes the verdict never has a default —\n# frozen-evidence lesson).\n#\n# Idempotence contract (F2). A `last-reviewed:` stamp asserts \"this document\n# was re-read FOR THIS RELEASE\". Re-dating it without re-reading is a false\n# claim on a surface that a signed tag then covers. So the stamp sites\n# skip the ENTIRE line — neither date nor version — when the version already\n# on the stamp is the target. `--restamp` is the named, explicit route for a\n# real re-review.\n#\n# The two stamp oracles (do not collapse them). `npm/README.md` is watched by\n# verify-counts' VERSION_SITES; SBOM.md / SECURITY.md / VERSIONING.md are\n# watched ONLY by check-canonical-doc-freshness.py. Both oracles decide on the\n# VERSION in the stamp, never on the date — which is what makes freezing the\n# date safe.\n#\n# The support window (kinds \"minor\"/\"prev_minor\" — v1.3.0 re-pass, F-sites).\n# verify-counts' VERSION_SITES also watches \"Current MINOR (vX.Y.x)\" and\n# \"Previous MINOR (vX.Y.x)\" in SECURITY.md and VERSIONING.md (S293). Those\n# sites were OUTSIDE this table at birth, so the next MINOR bump would write\n# everything else, then DIE at the driver's own verify-counts call with a\n# half-written tree (outside --dry-run there is no restore trap). The rule the\n# oracle enforces is mechanical — Current = the target's minor, Previous = the\n# minor immediately before it — so this writer derives both from --target and\n# the \"ONE source of truth\" claim above stays true. The single non-derivable\n# case, an X.0.0 target, is SKIPPED loudly and never guessed: the oracle\n# cannot value-check it either (it derives prev=\"\" at X.0), and a MAJOR\n# support-window transition is release-train judgment, not sed.\n# ============================================================================\n\"\"\"Release version-site table + writer (stdlib only, Python >= 3.9).\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport os\nimport re\nimport sys\nfrom typing import Callable, List, Optional, Sequence, Tuple\n\nSEMVER = r\"\\d+\\.\\d+\\.\\d+\"\nSTAMP_RX = r\"(last-reviewed: )(\\d{4}-\\d{2}-\\d{2})( +v)(\" + SEMVER + r\")\"\nDATE_RX = re.compile(r\"\\A\\d{4}-\\d{2}-\\d{2}\\Z\")\n\n# Kinds:\n#   \"plain\"      — literal regex substitution, no stamp semantics.\n#   \"stamp\"      — \"last-reviewed: <date> v<version>\"; skipped wholesale when\n#                  the version already equals the target (unless --restamp).\n#   \"minor\"      — support-window site carrying the TARGET's minor (vX.Y.x).\n#   \"prev_minor\" — support-window site carrying the minor immediately BEFORE\n#                  the target; not derivable at X.0.0 (skipped loudly there).\nPLAIN = \"plain\"\nSTAMP = \"stamp\"\nMINOR = \"minor\"\nPREV_MINOR = \"prev_minor\"\n\n# (path, kind, pattern) — patterns anchored exactly as their oracle checks\n# them, so historical version mentions elsewhere in the file are never touched.\n_SITES: List[Tuple[str, str, str]] = [\n    (\"VERSION\", PLAIN, r\"\\A\\s*\" + SEMVER + r\"\\s*\\Z\"),\n    # PLAN-169 W2.6 (ledger E.1/F.7/A.0.4): the install-state marker is the\n    # surface check-framework-updates.sh reads MARKER-FIRST — a bump that\n    # skips it leaves every adopter's updater reporting behind-minor\n    # forever. Joins _SITES with its oracle mirror in verify-counts\n    # VERSION_SITES (no census numeral here: the F6 guard forbids\n    # site-count claims in comments, ordinals included).\n    (\".claude/.framework-version\", PLAIN, r\"\\A\\s*\" + SEMVER + r\"\\s*\\Z\"),\n    (\"npm/package.json\", PLAIN, r'(\"version\"\\s*:\\s*\")' + SEMVER + r'(\")'),\n    (\"pyproject.toml\", PLAIN, r'(?m)^(version\\s*=\\s*\")' + SEMVER + r'(\")'),\n    # The upgrade instructions resolve the latest RC tag during the hold and\n    # use the GA tag afterwards. One pattern owns both version stems, so a\n    # bump cannot leave either route on a prior train.\n    (\"INSTALL.md\", PLAIN, r\"((?:--pin |git tag --list ['\\\"]?)v)\" + SEMVER),\n    (\n        \"docs/ARCHITECTURE.md\",\n        PLAIN,\n        r\"(currently\\s+v)\" + SEMVER + r\"(, aligned with the repo)\",\n    ),\n    # README.md and CLAUDE.md are deliberately NOT rows here: neither is a\n    # version site. `VERSION=` never existed in either (verify-counts dropped\n    # its dead rules for both in S291 — `git log -S 'VERSION='` finds no\n    # commit that added one — and the release checklist states the same). A\n    # writer row for a site no oracle watches would be that dead rule\n    # reintroduced on the WRITE side: the day someone adds a `VERSION=` line\n    # to README.md, the bump would rewrite a file every other surface\n    # declares out of scope.\n    (\"SBOM.md\", PLAIN, r\"(\\*\\*Version:\\*\\* `)\" + SEMVER + r\"(`)\"),\n    # --- the support window (oracle: verify-counts VERSION_SITES modes\n    #     \"minor\"/\"prev_minor\", S293). Patterns anchored exactly as the\n    #     oracle's — SECURITY.md bolds the label, VERSIONING.md does not. ---\n    (\"SECURITY.md\", MINOR, r\"(\\*\\*Current MINOR\\*\\* \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n    (\"VERSIONING.md\", MINOR, r\"(Current MINOR \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n    (\"SECURITY.md\", PREV_MINOR, r\"(\\*\\*Previous MINOR\\*\\* \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n    (\"VERSIONING.md\", PREV_MINOR, r\"(Previous MINOR \\(`v)\\d+\\.\\d+(\\.x`\\))\"),\n    # --- the review stamps (idempotence-critical; the table IS the census,\n    #     a numeral here would be a mirror that drifts) ---\n    (\"npm/README.md\", STAMP, STAMP_RX),\n    (\"SBOM.md\", STAMP, STAMP_RX),\n    (\"SECURITY.md\", STAMP, STAMP_RX),\n    (\"VERSIONING.md\", STAMP, STAMP_RX),\n]\n\n# Written by the bump PHASE but not by this module: `build-plugin.py\n# --write-manifests` regenerates them from VERSION. They belong in any\n# derived restore/guard list, which is why they are exported here instead of\n# being re-typed by every caller (the duplicated-list failure this module\n# exists to kill).\nGENERATED_BY_BUMP: List[str] = [\n    \".claude-plugin/plugin.json\",\n    \".claude-plugin/marketplace.json\",\n]\n\n\ndef site_paths(include_generated: bool = False) -> List[str]:\n    \"\"\"Every path this module may write, de-duplicated, in table order.\"\"\"\n    out: List[str] = []\n    for path, _kind, _rx in _SITES:\n        if path not in out:\n            out.append(path)\n    if include_generated:\n        for path in GENERATED_BY_BUMP:\n            if path not in out:\n                out.append(path)\n    return out\n\n\ndef _plain_replacement(pattern: str, target: str) -> str:\n    \"\"\"Replacement string for a PLAIN site, rebuilt from its group count.\"\"\"\n    if pattern.startswith(r\"\\A\"):  # the bare VERSION file\n        return target + \"\\n\"\n    groups = re.compile(pattern).groups\n    if groups == 0:\n        return target\n    if groups == 1:\n        return r\"\\g<1>\" + target\n    return r\"\\g<1>\" + target + r\"\\g<2>\"\n\n\ndef _stamp_replacer(\n    target: str, today: str, restamp: bool\n) -> Callable[[\"re.Match\"], str]:\n    def _repl(m: \"re.Match\") -> str:\n        if not restamp and m.group(4) == target:\n            # Defense in depth: the whole line is left byte-identical. Both\n            # stamp oracles read the VERSION, so freezing the date costs\n            # nothing and re-dating without re-reading would be a false claim.\n            return m.group(0)\n        return m.group(1) + today + m.group(3) + target\n\n    return _repl\n\n\ndef bump(\n    target: str,\n    today: str,\n    *,\n    restamp: bool = False,\n    root: Optional[str] = None,\n    out=None,\n) -> int:\n    \"\"\"Rewrite every version site to `target`. Returns files CHANGED.\"\"\"\n    if not DATE_RX.match(today):\n        raise ValueError(\"--today must be YYYY-MM-DD, got %r\" % (today,))\n    if not re.match(r\"\\A\" + SEMVER + r\"\\Z\", target):\n        raise ValueError(\"--target must be a bare semver, got %r\" % (target,))\n    stream = out if out is not None else sys.stdout\n    base = root or os.getcwd()\n    # Support-window derivation, BEFORE any byte is written: whether every\n    # site is writable is decided up front, never discovered mid-loop with a\n    # half-bumped tree behind it.\n    _maj, _min = (int(x) for x in target.split(\".\")[:2])\n    minor_target = \"%d.%d\" % (_maj, _min)\n    prev_minor = \"%d.%d\" % (_maj, _min - 1) if _min > 0 else None\n    changed = 0\n    for path, kind, pattern in _SITES:\n        if kind == PREV_MINOR and prev_minor is None:\n            # X.0.0: Previous MINOR is not derivable from the target, and the\n            # oracle skips value-checking it there too (prev=\"\" at X.0). Never\n            # guess a support-window promise — leave it and say so, loudly.\n            print(\n                \"  !!   %s: Previous MINOR left untouched — not derivable \"\n                \"from %s (X.0.0); the support window needs release-train \"\n                \"judgment here\" % (path, target),\n                file=stream,\n            )\n            continue\n        full = os.path.join(base, path)\n        try:\n            with open(full, encoding=\"utf-8\") as fh:\n                src = fh.read()\n        except OSError:\n            print(\"  --   %s absent, skipped\" % path, file=stream)\n            continue\n        written = target\n        if kind == STAMP:\n            new, n = re.subn(pattern, _stamp_replacer(target, today, restamp), src)\n            label = \"review stamp\"\n        elif kind == MINOR:\n            written = minor_target\n            new, n = re.subn(pattern, r\"\\g<1>\" + written + r\"\\g<2>\", src)\n            label = \"support-window (Current MINOR) site\"\n        elif kind == PREV_MINOR:\n            written = prev_minor\n            new, n = re.subn(pattern, r\"\\g<1>\" + written + r\"\\g<2>\", src)\n            label = \"support-window (Previous MINOR) site\"\n        else:\n            new, n = re.subn(pattern, _plain_replacement(pattern, target), src)\n            label = \"version site\"\n        if n == 0:\n            print(\n                \"  --   %s: no %s found (ok if unwatched)\" % (path, label),\n                file=stream,\n            )\n            continue\n        if new == src:\n            print(\n                \"  --   %s: %s already at %s (line untouched)\"\n                % (path, label, written),\n                file=stream,\n            )\n            continue\n        with open(full, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(new)\n        changed += 1\n        print(\n            \"  ok   %s (%d %s%s -> %s)\"\n            % (path, n, label, \"\" if n == 1 else \"s\", written),\n            file=stream,\n        )\n    return changed\n\n\ndef main(argv: Optional[Sequence[str]] = None) -> int:\n    parser = argparse.ArgumentParser(\n        prog=\"_release_bump_sites.py\",\n        description=\"Release version-site table + writer (single source).\",\n    )\n    sub = parser.add_subparsers(dest=\"cmd\")\n\n    p_list = sub.add_parser(\n        \"print-sites\",\n        help=\"print every path the bump may write, one per line\",\n    )\n    p_list.add_argument(\n        \"--include-generated\",\n        action=\"store_true\",\n        help=\"also print the plugin manifests regenerated by build-plugin.py\",\n    )\n\n    p_bump = sub.add_parser(\"bump\", help=\"rewrite the version sites\")\n    # NO DEFAULT, BY CONTRACT. `--today` decides whether a signed\n    # \"last-reviewed\" claim moves; a parameter that changes the verdict is\n    # never defaulted (frozen-evidence lesson).\n    p_bump.add_argument(\"--today\", required=True, help=\"YYYY-MM-DD (required)\")\n    p_bump.add_argument(\"--target\", required=True, help=\"bare semver, e.g. 1.3.0\")\n    p_bump.add_argument(\n        \"--restamp\",\n        action=\"store_true\",\n        help=\"force the review stamps to move even at the same version\",\n    )\n    p_bump.add_argument(\"--root\", default=None, help=\"repo root (default: cwd)\")\n\n    args = parser.parse_args(argv)\n    if args.cmd == \"print-sites\":\n        for path in site_paths(include_generated=args.include_generated):\n            print(path)\n        return 0\n    if args.cmd == \"bump\":\n        try:\n            bump(\n                args.target,\n                args.today,\n                restamp=args.restamp,\n                root=args.root,\n            )\n        except ValueError as exc:\n            print(\"FAIL: %s\" % exc, file=sys.stderr)\n            return 2\n        return 0\n    parser.print_usage(sys.stderr)\n    return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":303,"startLine":1,"totalLines":303}},"tool_result_meta":[{"id":"toolu_019AEsud9AHg5FmNxsvKwbv1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
