{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017k1YUXE392PiVeazw597rz","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"generate-available-models.py — availableModels mirror GENERATED from ADR-149.\n3\t\n4\tPLAN-135 W1 unit s1 (HARVEST-REPORT S1; ADR-149 Amendment 1 §A1.2).\n5\t\n6\tSingle source: the machine-parseable ``AVAILABLE_MODELS_WORKING_SET`` block\n7\tinside ``.claude/adr/ADR-149-model-id-allowlist.md``. This script:\n8\t\n9\t- **generate mode** (default): emits the ``{\"availableModels\": [...]}`` JSON\n10\t  fragment derived from the ADR block, preserving ADR order (the tuple order\n11\t  is normative — byte-deterministic generation).\n12\t- **--check mode**: resolves the live settings (project ``.claude/settings.json``\n13\t  plus ``.claude/settings.local.json`` overlay, mimicking the documented\n14\t  harness merge semantics: ``availableModels`` arrays merge+dedupe across\n15\t  layers; ``fallbackModel`` does NOT merge — highest-precedence layer wins\n16\t  wholesale) and diffs them against the ADR:\n17\t    * ``availableModels`` absent  -> graceful note, exit 0 (pre-ceremony state)\n18\t    * ``availableModels`` present -> must equal the generated list exactly\n19\t    * ``fallbackModel``  absent  -> graceful note (pre-ceremony state)\n20\t    * ``fallbackModel``  present -> chain length 1..3, every member inside\n21\t      the working set (ADR-149 Amendment 1 clause (a))\n22\t\n23\tPre-amendment tolerance: when the live ADR does not yet carry Amendment 1\n24\t(the amendment ships STAGED and lands only at the Owner ceremony), the\n25\tparser falls back to the base ``VETO_FLOOR_ALLOWED`` block members and\n26\tprints a loud stderr note — the script runs green on the unamended tree.\n27\t\n28\tExit codes: 0 = OK / graceful-absent; 1 = drift or clause violation;\n29\t2 = infrastructure (ADR or settings file unreadable, no parseable block).\n30\t\n31\tAdvisory + read-only: never writes any file. Stdlib-only. Python >= 3.9.\n32\t\"\"\"\n33\t\n34\tfrom __future__ import annotations\n35\t\n36\timport argparse\n37\timport json\n38\timport re\n39\timport sys\n40\tfrom pathlib import Path\n41\tfrom typing import List, Optional, Tuple\n42\t\n43\tREPO_ROOT = Path(__file__).resolve().parents[2]\n44\tDEFAULT_ADR = REPO_ROOT / \".claude\" / \"adr\" / \"ADR-149-model-id-allowlist.md\"\n45\tDEFAULT_SETTINGS = REPO_ROOT / \".claude\" / \"settings.json\"\n46\t\n47\tsys.path.insert(0, str(REPO_ROOT / \".claude\" / \"hooks\"))\n48\ttry:\n49\t    from _lib.model_currency import availability_entries  # noqa: E402\n50\texcept ImportError:\n51\t    availability_entries = lambda ids: list(ids)  # type: ignore[assignment]\n52\t\n53\tWORKING_SET_TOKEN = \"AVAILABLE_MODELS_WORKING_SET\"\n54\tMODEL_FAMILY_POLICY = 'MODEL_FAMILY_POLICY = \"semantic-families-v1\"'\n55\t_POLICY_FENCE_RE = re.compile(\n56\t    r\"```python\\s*\\n(?:(?!```)[\\s\\S])*?^MODEL_FAMILY_POLICY = \\\"semantic-families-v1\\\"\\s*$\",\n57\t    re.MULTILINE,\n58\t)\n59\tVETO_FLOOR_TOKEN = \"VETO_FLOOR_ALLOWED\"\n60\tFALLBACK_CHAIN_MAX = 3  # documented harness cap (model-config: \"capped at three\")\n61\t\n62\t# Model-id / alias shape: claude-opus-4-8, claude-fable-5, sonnet, opus[1m], ...\n63\t_ID_RE = re.compile(r'\"([A-Za-z0-9][A-Za-z0-9._\\[\\]-]*)\"')\n64\t\n65\t\n66\tdef _extract_block_ids(adr_text: str, token: str) -> Optional[List[str]]:\n67\t    \"\"\"Return the quoted ids inside the ``token = (...)`` / ``{...}`` block.\n68\t\n69\t    Tolerant of frozenset({...}) and tuple (...) literals, comments, and\n70\t    trailing commas. Returns None when the token is absent; [] only when the\n71\t    block exists but carries no quoted ids (treated as infra error upstream).\n72\t    \"\"\"\n73\t    idx = adr_text.find(token)\n74\t    if idx < 0:\n75\t        return None\n76\t    # Find the first opening bracket after the token, then scan to its match.\n77\t    open_idx = -1\n78\t    open_ch = \"\"\n79\t    for i in range(idx, min(len(adr_text), idx + 200)):\n80\t        if adr_text[i] in \"({\":\n81\t            open_idx = i\n82\t            open_ch = adr_text[i]\n83\t            break\n84\t    if open_idx < 0:\n85\t        return []\n86\t    close_ch = \")\" if open_ch == \"(\" else \"}\"\n87\t    depth = 0\n88\t    end_idx = -1\n89\t    for i in range(open_idx, len(adr_text)):\n90\t        ch = adr_text[i]\n91\t        if ch == open_ch:\n92\t            depth += 1\n93\t        elif ch == close_ch:\n94\t            depth -= 1\n95\t            if depth == 0:\n96\t                end_idx = i\n97\t                break\n98\t    if end_idx < 0:\n99\t        return []\n100\t    block = adr_text[open_idx : end_idx + 1]\n101\t    seen = set()\n102\t    ids: List[str] = []\n103\t    for match in _ID_RE.finditer(block):\n104\t        mid = match.group(1)\n105\t        if mid not in seen:\n106\t            seen.add(mid)\n107\t            ids.append(mid)\n108\t    return ids\n109\t\n110\t\n111\tdef parse_working_set(adr_path: Path) -> Tuple[List[str], str]:\n112\t    \"\"\"Parse the ADR; return (ids, source) where source is the block used.\"\"\"\n113\t    try:\n114\t        text = adr_path.read_text(encoding=\"utf-8\")\n115\t    except OSError as exc:\n116\t        raise RuntimeError(\"cannot read ADR at {}: {}\".format(adr_path, exc))\n117\t    ids = _extract_block_ids(text, WORKING_SET_TOKEN)\n118\t    if ids:\n119\t        if _POLICY_FENCE_RE.search(text):\n120\t            return availability_entries(ids), WORKING_SET_TOKEN\n121\t        return ids, WORKING_SET_TOKEN\n122\t    fallback = _extract_block_ids(text, VETO_FLOOR_TOKEN)\n123\t    if fallback:\n124\t        sys.stderr.write(\n125\t            \"[generate-available-models] NOTE: ADR-149 Amendment 1 \"\n126\t            \"({}) not found in {} — falling back to the base {} members \"\n127\t            \"(pre-amendment state; the working-set block lands at the \"\n128\t            \"PLAN-135 W1 Owner ceremony).\\n\".format(\n129\t                WORKING_SET_TOKEN, adr_path, VETO_FLOOR_TOKEN\n130\t            )\n131\t        )\n132\t        return fallback, VETO_FLOOR_TOKEN\n133\t    raise RuntimeError(\n134\t        \"no parseable {} or {} block in {}\".format(\n135\t            WORKING_SET_TOKEN, VETO_FLOOR_TOKEN, adr_path\n136\t        )\n137\t    )\n138\t\n139\t\n140\tdef _load_json(path: Path) -> dict:\n141\t    try:\n142\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n143\t    except OSError as exc:\n144\t        raise RuntimeError(\"cannot read settings at {}: {}\".format(path, exc))\n145\t    except ValueError as exc:\n146\t        raise RuntimeError(\"settings file {} is not valid JSON: {}\".format(path, exc))\n147\t\n148\t\n149\tdef resolve_settings(settings_path: Path) -> Tuple[Optional[List[str]], Optional[List[str]]]:\n150\t    \"\"\"Resolve (availableModels, fallbackModel) across project + local layers.\n151\t\n152\t    Mimics the documented harness semantics for the two repo-scope layers:\n153\t    - availableModels: arrays MERGE + dedupe (project order first, then any\n154\t      local additions) — a local layer can only ADD, which --check flags.\n155\t    - fallbackModel: NO merge — the highest-precedence layer that defines it\n156\t      supplies the entire chain (local wins over project).\n157\t    User-level and managed layers are outside repo scope (honest boundary,\n158\t    ADR-149 Amendment 1 §A1.4).\n159\t    \"\"\"\n160\t    project = _load_json(settings_path)\n161\t    local_path = settings_path.with_name(\"settings.local.json\")\n162\t    local = _load_json(local_path) if local_path.exists() else {}\n163\t\n164\t    def _as_list(value: object) -> Optional[List[str]]:\n165\t        if value is None:\n166\t            return None\n167\t        if isinstance(value, str):\n168\t            return [value]\n169\t        if isinstance(value, list):\n170\t            return [str(v) for v in value]\n171\t        return None\n172\t\n173\t    avail_project = _as_list(project.get(\"availableModels\"))\n174\t    avail_local = _as_list(local.get(\"availableModels\"))\n175\t    if avail_project is None and avail_local is None:\n176\t        available: Optional[List[str]] = None\n177\t    else:\n178\t        merged: List[str] = []\n179\t        for layer in (avail_project or [], avail_local or []):\n180\t            for mid in layer:\n181\t                if mid not in merged:\n182\t                    merged.append(mid)\n183\t        available = merged\n184\t\n185\t    fallback = _as_list(local.get(\"fallbackModel\"))\n186\t    if fallback is None:\n187\t        fallback = _as_list(project.get(\"fallbackModel\"))\n188\t    return available, fallback\n189\t\n190\t\n191\tdef run_check(working_set: List[str], settings_path: Path) -> int:\n192\t    available, fallback = resolve_settings(settings_path)\n193\t    failures: List[str] = []\n194\t\n195\t    if available is None:\n196\t        print(\n197\t            \"CHECK availableModels: key absent in resolved settings \"\n198\t            \"(pre-ceremony state) — OK\"\n199\t        )\n200\t    elif available == working_set:\n201\t        print(\n202\t            \"CHECK availableModels: MATCH ({} ids, ADR order preserved)\".format(\n203\t                len(available)\n204\t            )\n205\t        )\n206\t    else:\n207\t        failures.append(\n208\t            \"availableModels drift:\\n  ADR-149  : {}\\n  resolved : {}\".format(\n209\t                json.dumps(working_set), json.dumps(available)\n210\t            )\n211\t        )\n212\t\n213\t    if fallback is None:\n214\t        print(\n215\t            \"CHECK fallbackModel: key absent in resolved settings \"\n216\t            \"(pre-ceremony state) — OK\"\n217\t        )\n218\t    else:\n219\t        if not 1 <= len(fallback) <= FALLBACK_CHAIN_MAX:\n220\t            failures.append(\n221\t                \"fallbackModel chain length {} outside 1..{}: {}\".format(\n222\t                    len(fallback), FALLBACK_CHAIN_MAX, json.dumps(fallback)\n223\t                )\n224\t            )\n225\t        escapees = [m for m in fallback if m not in working_set]\n226\t        if escapees:\n227\t            failures.append(\n228\t                \"fallbackModel escapes the working set (clause (a) \"\n229\t                \"violation): {}\".format(json.dumps(escapees))\n230\t            )\n231\t        if not failures:\n232\t            print(\n233\t                \"CHECK fallbackModel: chain {} inside working set, \"\n234\t                \"length {} <= {}\".format(\n235\t                    json.dumps(fallback), len(fallback), FALLBACK_CHAIN_MAX\n236\t                )\n237\t            )\n238\t\n239\t    for failure in failures:\n240\t        sys.stderr.write(\"[generate-available-models] FAIL: {}\\n\".format(failure))\n241\t    return 1 if failures else 0\n242\t\n243\t\n244\tdef main(argv: Optional[List[str]] = None) -> int:\n245\t    parser = argparse.ArgumentParser(\n246\t        description=\"Emit (or --check) the availableModels fragment \"\n247\t        \"generated from ADR-149.\"\n248\t    )\n249\t    parser.add_argument(\n250\t        \"--adr\",\n251\t        type=Path,\n252\t        default=DEFAULT_ADR,\n253\t        help=\"ADR-149 path (default: live repo copy)\",\n254\t    )\n255\t    parser.add_argument(\n256\t        \"--settings\",\n257\t        type=Path,\n258\t        default=DEFAULT_SETTINGS,\n259\t        help=\"settings.json to diff in --check mode \"\n260\t        \"(a sibling settings.local.json is overlaid when present)\",\n261\t    )\n262\t    parser.add_argument(\n263\t        \"--check\",\n264\t        action=\"store_true\",\n265\t        help=\"diff resolved settings against the ADR instead of emitting JSON\",\n266\t    )\n267\t    args = parser.parse_args(argv)\n268\t\n269\t    try:\n270\t        working_set, source = parse_working_set(args.adr)\n271\t    except RuntimeError as exc:\n272\t        sys.stderr.write(\"[generate-available-models] ERROR: {}\\n\".format(exc))\n273\t        return 2\n274\t\n275\t    if args.check:\n276\t        try:\n277\t            return run_check(working_set, args.settings)\n278\t        except RuntimeError as exc:\n279\t            sys.stderr.write(\"[generate-available-models] ERROR: {}\\n\".format(exc))\n280\t            return 2\n281\t\n282\t    fragment = {\"availableModels\": working_set}\n283\t    print(json.dumps(fragment, indent=2))\n284\t    if source == WORKING_SET_TOKEN:\n285\t        sys.stderr.write(\n286\t            \"[generate-available-models] source: ADR-149 Amendment 1 \"\n287\t            \"{} ({} ids)\\n\".format(WORKING_SET_TOKEN, len(working_set))\n288\t        )\n289\t    return 0\n290\t\n291\t\n292\tif __name__ == \"__main__\":\n293\t    sys.exit(main())\n294\t"}]},"parent_tool_use_id":null,"session_id":"41de4d4a-eac6-4470-9814-67ae2b53d60e","uuid":"c7c7abf4-67cc-4406-bdab-cb0bc6e0f661","timestamp":"2026-11-15T11:29:47.729Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/scripts/generate-available-models.py","content":"#!/usr/bin/env python3\n\"\"\"generate-available-models.py — availableModels mirror GENERATED from ADR-149.\n\nPLAN-135 W1 unit s1 (HARVEST-REPORT S1; ADR-149 Amendment 1 §A1.2).\n\nSingle source: the machine-parseable ``AVAILABLE_MODELS_WORKING_SET`` block\ninside ``.claude/adr/ADR-149-model-id-allowlist.md``. This script:\n\n- **generate mode** (default): emits the ``{\"availableModels\": [...]}`` JSON\n  fragment derived from the ADR block, preserving ADR order (the tuple order\n  is normative — byte-deterministic generation).\n- **--check mode**: resolves the live settings (project ``.claude/settings.json``\n  plus ``.claude/settings.local.json`` overlay, mimicking the documented\n  harness merge semantics: ``availableModels`` arrays merge+dedupe across\n  layers; ``fallbackModel`` does NOT merge — highest-precedence layer wins\n  wholesale) and diffs them against the ADR:\n    * ``availableModels`` absent  -> graceful note, exit 0 (pre-ceremony state)\n    * ``availableModels`` present -> must equal the generated list exactly\n    * ``fallbackModel``  absent  -> graceful note (pre-ceremony state)\n    * ``fallbackModel``  present -> chain length 1..3, every member inside\n      the working set (ADR-149 Amendment 1 clause (a))\n\nPre-amendment tolerance: when the live ADR does not yet carry Amendment 1\n(the amendment ships STAGED and lands only at the Owner ceremony), the\nparser falls back to the base ``VETO_FLOOR_ALLOWED`` block members and\nprints a loud stderr note — the script runs green on the unamended tree.\n\nExit codes: 0 = OK / graceful-absent; 1 = drift or clause violation;\n2 = infrastructure (ADR or settings file unreadable, no parseable block).\n\nAdvisory + read-only: never writes any file. Stdlib-only. Python >= 3.9.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import List, Optional, Tuple\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nDEFAULT_ADR = REPO_ROOT / \".claude\" / \"adr\" / \"ADR-149-model-id-allowlist.md\"\nDEFAULT_SETTINGS = REPO_ROOT / \".claude\" / \"settings.json\"\n\nsys.path.insert(0, str(REPO_ROOT / \".claude\" / \"hooks\"))\ntry:\n    from _lib.model_currency import availability_entries  # noqa: E402\nexcept ImportError:\n    availability_entries = lambda ids: list(ids)  # type: ignore[assignment]\n\nWORKING_SET_TOKEN = \"AVAILABLE_MODELS_WORKING_SET\"\nMODEL_FAMILY_POLICY = 'MODEL_FAMILY_POLICY = \"semantic-families-v1\"'\n_POLICY_FENCE_RE = re.compile(\n    r\"```python\\s*\\n(?:(?!```)[\\s\\S])*?^MODEL_FAMILY_POLICY = \\\"semantic-families-v1\\\"\\s*$\",\n    re.MULTILINE,\n)\nVETO_FLOOR_TOKEN = \"VETO_FLOOR_ALLOWED\"\nFALLBACK_CHAIN_MAX = 3  # documented harness cap (model-config: \"capped at three\")\n\n# Model-id / alias shape: claude-opus-4-8, claude-fable-5, sonnet, opus[1m], ...\n_ID_RE = re.compile(r'\"([A-Za-z0-9][A-Za-z0-9._\\[\\]-]*)\"')\n\n\ndef _extract_block_ids(adr_text: str, token: str) -> Optional[List[str]]:\n    \"\"\"Return the quoted ids inside the ``token = (...)`` / ``{...}`` block.\n\n    Tolerant of frozenset({...}) and tuple (...) literals, comments, and\n    trailing commas. Returns None when the token is absent; [] only when the\n    block exists but carries no quoted ids (treated as infra error upstream).\n    \"\"\"\n    idx = adr_text.find(token)\n    if idx < 0:\n        return None\n    # Find the first opening bracket after the token, then scan to its match.\n    open_idx = -1\n    open_ch = \"\"\n    for i in range(idx, min(len(adr_text), idx + 200)):\n        if adr_text[i] in \"({\":\n            open_idx = i\n            open_ch = adr_text[i]\n            break\n    if open_idx < 0:\n        return []\n    close_ch = \")\" if open_ch == \"(\" else \"}\"\n    depth = 0\n    end_idx = -1\n    for i in range(open_idx, len(adr_text)):\n        ch = adr_text[i]\n        if ch == open_ch:\n            depth += 1\n        elif ch == close_ch:\n            depth -= 1\n            if depth == 0:\n                end_idx = i\n                break\n    if end_idx < 0:\n        return []\n    block = adr_text[open_idx : end_idx + 1]\n    seen = set()\n    ids: List[str] = []\n    for match in _ID_RE.finditer(block):\n        mid = match.group(1)\n        if mid not in seen:\n            seen.add(mid)\n            ids.append(mid)\n    return ids\n\n\ndef parse_working_set(adr_path: Path) -> Tuple[List[str], str]:\n    \"\"\"Parse the ADR; return (ids, source) where source is the block used.\"\"\"\n    try:\n        text = adr_path.read_text(encoding=\"utf-8\")\n    except OSError as exc:\n        raise RuntimeError(\"cannot read ADR at {}: {}\".format(adr_path, exc))\n    ids = _extract_block_ids(text, WORKING_SET_TOKEN)\n    if ids:\n        if _POLICY_FENCE_RE.search(text):\n            return availability_entries(ids), WORKING_SET_TOKEN\n        return ids, WORKING_SET_TOKEN\n    fallback = _extract_block_ids(text, VETO_FLOOR_TOKEN)\n    if fallback:\n        sys.stderr.write(\n            \"[generate-available-models] NOTE: ADR-149 Amendment 1 \"\n            \"({}) not found in {} — falling back to the base {} members \"\n            \"(pre-amendment state; the working-set block lands at the \"\n            \"PLAN-135 W1 Owner ceremony).\\n\".format(\n                WORKING_SET_TOKEN, adr_path, VETO_FLOOR_TOKEN\n            )\n        )\n        return fallback, VETO_FLOOR_TOKEN\n    raise RuntimeError(\n        \"no parseable {} or {} block in {}\".format(\n            WORKING_SET_TOKEN, VETO_FLOOR_TOKEN, adr_path\n        )\n    )\n\n\ndef _load_json(path: Path) -> dict:\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except OSError as exc:\n        raise RuntimeError(\"cannot read settings at {}: {}\".format(path, exc))\n    except ValueError as exc:\n        raise RuntimeError(\"settings file {} is not valid JSON: {}\".format(path, exc))\n\n\ndef resolve_settings(settings_path: Path) -> Tuple[Optional[List[str]], Optional[List[str]]]:\n    \"\"\"Resolve (availableModels, fallbackModel) across project + local layers.\n\n    Mimics the documented harness semantics for the two repo-scope layers:\n    - availableModels: arrays MERGE + dedupe (project order first, then any\n      local additions) — a local layer can only ADD, which --check flags.\n    - fallbackModel: NO merge — the highest-precedence layer that defines it\n      supplies the entire chain (local wins over project).\n    User-level and managed layers are outside repo scope (honest boundary,\n    ADR-149 Amendment 1 §A1.4).\n    \"\"\"\n    project = _load_json(settings_path)\n    local_path = settings_path.with_name(\"settings.local.json\")\n    local = _load_json(local_path) if local_path.exists() else {}\n\n    def _as_list(value: object) -> Optional[List[str]]:\n        if value is None:\n            return None\n        if isinstance(value, str):\n            return [value]\n        if isinstance(value, list):\n            return [str(v) for v in value]\n        return None\n\n    avail_project = _as_list(project.get(\"availableModels\"))\n    avail_local = _as_list(local.get(\"availableModels\"))\n    if avail_project is None and avail_local is None:\n        available: Optional[List[str]] = None\n    else:\n        merged: List[str] = []\n        for layer in (avail_project or [], avail_local or []):\n            for mid in layer:\n                if mid not in merged:\n                    merged.append(mid)\n        available = merged\n\n    fallback = _as_list(local.get(\"fallbackModel\"))\n    if fallback is None:\n        fallback = _as_list(project.get(\"fallbackModel\"))\n    return available, fallback\n\n\ndef run_check(working_set: List[str], settings_path: Path) -> int:\n    available, fallback = resolve_settings(settings_path)\n    failures: List[str] = []\n\n    if available is None:\n        print(\n            \"CHECK availableModels: key absent in resolved settings \"\n            \"(pre-ceremony state) — OK\"\n        )\n    elif available == working_set:\n        print(\n            \"CHECK availableModels: MATCH ({} ids, ADR order preserved)\".format(\n                len(available)\n            )\n        )\n    else:\n        failures.append(\n            \"availableModels drift:\\n  ADR-149  : {}\\n  resolved : {}\".format(\n                json.dumps(working_set), json.dumps(available)\n            )\n        )\n\n    if fallback is None:\n        print(\n            \"CHECK fallbackModel: key absent in resolved settings \"\n            \"(pre-ceremony state) — OK\"\n        )\n    else:\n        if not 1 <= len(fallback) <= FALLBACK_CHAIN_MAX:\n            failures.append(\n                \"fallbackModel chain length {} outside 1..{}: {}\".format(\n                    len(fallback), FALLBACK_CHAIN_MAX, json.dumps(fallback)\n                )\n            )\n        escapees = [m for m in fallback if m not in working_set]\n        if escapees:\n            failures.append(\n                \"fallbackModel escapes the working set (clause (a) \"\n                \"violation): {}\".format(json.dumps(escapees))\n            )\n        if not failures:\n            print(\n                \"CHECK fallbackModel: chain {} inside working set, \"\n                \"length {} <= {}\".format(\n                    json.dumps(fallback), len(fallback), FALLBACK_CHAIN_MAX\n                )\n            )\n\n    for failure in failures:\n        sys.stderr.write(\"[generate-available-models] FAIL: {}\\n\".format(failure))\n    return 1 if failures else 0\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = argparse.ArgumentParser(\n        description=\"Emit (or --check) the availableModels fragment \"\n        \"generated from ADR-149.\"\n    )\n    parser.add_argument(\n        \"--adr\",\n        type=Path,\n        default=DEFAULT_ADR,\n        help=\"ADR-149 path (default: live repo copy)\",\n    )\n    parser.add_argument(\n        \"--settings\",\n        type=Path,\n        default=DEFAULT_SETTINGS,\n        help=\"settings.json to diff in --check mode \"\n        \"(a sibling settings.local.json is overlaid when present)\",\n    )\n    parser.add_argument(\n        \"--check\",\n        action=\"store_true\",\n        help=\"diff resolved settings against the ADR instead of emitting JSON\",\n    )\n    args = parser.parse_args(argv)\n\n    try:\n        working_set, source = parse_working_set(args.adr)\n    except RuntimeError as exc:\n        sys.stderr.write(\"[generate-available-models] ERROR: {}\\n\".format(exc))\n        return 2\n\n    if args.check:\n        try:\n            return run_check(working_set, args.settings)\n        except RuntimeError as exc:\n            sys.stderr.write(\"[generate-available-models] ERROR: {}\\n\".format(exc))\n            return 2\n\n    fragment = {\"availableModels\": working_set}\n    print(json.dumps(fragment, indent=2))\n    if source == WORKING_SET_TOKEN:\n        sys.stderr.write(\n            \"[generate-available-models] source: ADR-149 Amendment 1 \"\n            \"{} ({} ids)\\n\".format(WORKING_SET_TOKEN, len(working_set))\n        )\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":294,"startLine":1,"totalLines":294}},"tool_result_meta":[{"id":"toolu_017k1YUXE392PiVeazw597rz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
