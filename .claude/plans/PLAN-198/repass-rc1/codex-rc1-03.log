+        if any(ord(c) < 0x20 or 0x7f <= ord(c) <= 0x9f for c in norm):
+            return None
+        # Defensive: JSON-meta chars
+        if any(c in '{}[]:,"\\' for c in norm):
+            return None
+        return norm
+    except Exception:  # pragma: no cover (defensive — extraction never throws)
+        return None
