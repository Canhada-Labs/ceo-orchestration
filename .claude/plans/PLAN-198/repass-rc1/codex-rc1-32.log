   567	def _direction(from_tier: str, to_tier: str) -> str:
   568	    """Return ``"promote"``, ``"demote"``, or ``"hold"``."""
   569	    if from_tier == to_tier:
   570	        return "hold"
   571	    if _tier_rank(to_tier) > _tier_rank(from_tier):
   572	        return "promote"
   573	    return "demote"
