   535	def _tier_rank(model_id: str) -> int:
   536	    """Ordinal tier rank (higher = more capable). Used to direction-sign.
   537	
   538	    Unknown IDs rank -1 (never selected over a known ID).
   539	    """
   540	    # PLAN-169 W2.10 F2: the gen-5 fleet was MISSING here, so every
   541	    # current-fleet id ranked -1 (unknown) and _direction(opus-5 ->
   542	    # sonnet-4-6) signed as "promote" — a two-step demote sailing past the
   543	    # demote gate. Ladder is tier-major (haiku < sonnet < opus < fable),
   544	    # generation-minor within a tier; dated and bare haiku ids are the
   545	    # same model. Class cure (single authority + parity oracle) is the
   546	    # W4.3 deliverable — this is the data fix that stops the inversion.
   547	    order = {
   548	        "claude-haiku-4-5-[REDACTED:rg]": 1,
   549	        "claude-haiku-4-5": 1,
   550	        "claude-sonnet-4-6": 2,
   551	        "claude-sonnet-5": 3,
   552	        "claude-opus-4-8": 4,
   553	        "claude-opus-5": 5,
   554	        "claude-opus-5-fast": 5,  # fast mode: same model, premium rate
   555	        # ADR-149 Amendment 3 (S357): Opus 5.5 sits strictly between Opus 5
   556	        # and Fable 5 (tier-major ladder, renumbered, never tied: a tie with
   557	        # Opus 5 would sign opus-5 -> opus-5-5 as "demote", a tie with
   558	        # Fable 5 would sign opus-5-5 -> fable-5 as "demote", and a rank
   559	        # above Fable would sign fable-5 -> opus-5-5 as "promote").
   560	        "claude-opus-5-5": 6,
   561	        "claude-fable-5": 7,  # ADR-149 flagship (Mythos-class, above Opus)
   562	        "claude-fable-5-1": 8,  # ADR-149 Amendment 2 (S338): Fable 5.1, above Fable 5
   563	    }
   564	    return order.get(model_id, -1)
