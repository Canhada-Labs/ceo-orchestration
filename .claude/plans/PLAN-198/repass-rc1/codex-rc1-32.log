#!/usr/bin/env python3
"""List subprocess-test debt and reject sites absent from the checked-in ratchet."""
from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from _subprocess_census import KINDS, load_baseline, new_findings, scan_tree


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[2])
    parser.add_argument("--baseline", type=Path, default=Path(__file__).with_name("subprocess-test-baseline.json"))
    parser.add_argument("--kind", choices=(*KINDS, "all"), default="all")
    parser.add_argument("--list", action="store_true", help="emit all current findings as JSON")
    args = parser.parse_args(argv)
    try:
        findings = [f for f in scan_tree(args.root) if args.kind in ("all", f.kind)]
        additions = new_findings(findings, load_baseline(args.baseline))
    except (OSError, UnicodeError, SyntaxError, ValueError) as exc:
        print(f"subprocess census: {type(exc).__name__}: {exc}", file=sys.stderr)
        return 2
    if args.list:
        print(json.dumps([f._asdict() for f in findings], indent=2))
    for finding in additions:
        print(f"NEW {finding.kind} {finding.path}:{finding.line} {finding.scope}", file=sys.stderr)
    if not args.list:
        print(f"subprocess census: {len(findings)} existing sites; {len(additions)} new sites")
    return 1 if additions else 0


if __name__ == "__main__":
    raise SystemExit(main())
"""Anchored model-family currency rules for PLAN-176."""
from __future__ import annotations

import re
from typing import Iterable, Optional

_RETIRED = frozenset({"claude-opus-4-1"})
_LEGACY_WORKING = frozenset({"claude-fable-5", "claude-fable-5-1"})
_LEGACY_FLOOR = frozenset({"claude-fable-5"})
_TAIL = r"(?:[.-][0-9]+)*(?:-[a-z][a-z0-9]*)*"
_ALLOWED = re.compile(
    r"^(?:claude-(?:opus|sonnet|haiku)-[4-9]" + _TAIL
    + r"|gpt-[5-9]" + _TAIL + r"|o[3-9]" + _TAIL
    + r"|gemini-[2-9]" + _TAIL + r"|grok-[3-9]" + _TAIL + r")$"
)
_FLOOR = re.compile(r"^(?:claude-opus-[4-9]" + _TAIL + r"|gpt-[5-9]" + _TAIL + r"|o[3-9]" + _TAIL + r")$")
_PREFIXES = tuple(
    ["claude-%s-%d" % (family, major) for family in ("opus", "sonnet", "haiku") for major in range(4, 10)]
    + ["gpt-%d" % major for major in range(5, 10)]
    + ["o%d" % major for major in range(3, 10)]
    + ["gemini-%d" % major for major in range(2, 10)]
    + ["grok-%d" % major for major in range(3, 10)]
)


def _explicit(name: str, models: Optional[Iterable[str]]) -> bool:
    return models is not None and name in frozenset(models)


def availability_entries(explicit_models: Iterable[str]) -> list:
    """Stable explicit IDs followed by native major-version availability prefixes."""
    out = []
    for model in list(explicit_models) + list(_PREFIXES):
        if model not in out:
            out.append(model)
    return out


def is_allowed_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:
    """Accept approved semantic families or an explicit legacy working ID."""
    return isinstance(name, str) and name not in _RETIRED and (
        bool(_ALLOWED.fullmatch(name)) or _explicit(name, explicit_models)
        or (explicit_models is None and name in _LEGACY_WORKING)
    )


def is_veto_floor_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:
    """Accept VETO-capable families or an explicit legacy floor ID."""
    return isinstance(name, str) and name not in _RETIRED and (
        bool(_FLOOR.fullmatch(name)) or _explicit(name, explicit_models)
        or (explicit_models is None and name in _LEGACY_FLOOR)
    )


def main(argv: Optional[list] = None) -> int:
    """Exit 0 for an admitted model, 1 for rejection, 2 for invalid usage."""
    import sys

    args = list(sys.argv[1:] if argv is None else argv)
    veto = args[:1] == ["--veto"]
    if veto:
        args = args[1:]
    if len(args) != 1:
        return 2
    predicate = is_veto_floor_model if veto else is_allowed_model
    return 0 if predicate(args[0]) else 1


if __name__ == "__main__":
    raise SystemExit(main())
"""Stable semantic-version policy for locally resolved CLI packages."""

from __future__ import annotations

import json
import re
from pathlib import Path
from typing import Iterable, Optional, Tuple


CODEX_VERSION_FLOOR = "0.160.0"
_SEMVER_RE = re.compile(r"^v?([0-9]+)\.([0-9]+)\.([0-9]+)$")


def parse_semver(value: object) -> Optional[Tuple[int, int, int]]:
    """Parse a stable ``major.minor.patch`` version; reject prereleases."""
    if not isinstance(value, str):
        return None
    match = _SEMVER_RE.fullmatch(value.strip())
    if match is None:
        return None
    return tuple(int(part) for part in match.groups())


def compare_semver(candidate: object, floor: object) -> Optional[int]:
    """Compare stable versions: positive when candidate is newer, else None."""
    parsed_candidate = parse_semver(candidate)
    parsed_floor = parse_semver(floor)
    if parsed_candidate is None or parsed_floor is None:
        return None
    return (parsed_candidate > parsed_floor) - (parsed_candidate < parsed_floor)


def compatible_package_version(
    payload: Path, launcher: Optional[Path], manifest_version: object = None,
    floor: str = CODEX_VERSION_FLOOR,
) -> Optional[str]:
    """Return a qualified stable version meeting floor and optional manifest.

    This is currency evidence only: callers must not describe it as a hash
    attestation of the executable bytes.
    """
    for package_file in _package_files((payload, launcher)):
        version = _qualified_package_version(package_file)
        comparison = compare_semver(version, floor)
        manifest_comparison = (
            1 if manifest_version is None else compare_semver(version, manifest_version)
        )
        if comparison is not None and comparison >= 0 and manifest_comparison is not None and manifest_comparison > 0:
            return version
    return None


def qualified_package_version(payload: Path, launcher: Optional[Path]) -> Optional[str]:
    """Return stable version from a nearby qualified package, if present."""
    for package_file in _package_files((payload, launcher)):
        version = _qualified_package_version(package_file)
        if version is not None:
            return version
    return None


def _package_files(paths: Iterable[Optional[Path]]) -> Iterable[Path]:
    seen = set()
    for path in paths:
        if path is None:
            continue
        try:
            path = path.resolve()
        except OSError:
            pass
        for parent in (path.parent, *path.parents):
            package_file = parent / "package.json"
            if package_file not in seen:
                seen.add(package_file)
                yield package_file


def _qualified_package_version(package_file: Path) -> Optional[str]:
    try:
        data = json.loads(package_file.read_text(encoding="utf-8"))
    except (OSError, ValueError, RecursionError):
        return None
    if not isinstance(data, dict) or data.get("name") != "@openai/codex":
        return None
    version = data.get("version")
    return version if parse_semver(version) is not None else None

