   670	def _load_filelock_classes() -> Tuple[Any, Any]:
   671	    """Late-import FileLock / FileLockTimeout via package or spec path.
   672	
   673	    Returns ``(FileLock, FileLockTimeout)`` tuple. Raises ImportError
   674	    if neither import route works.
   675	    """
   676	    try:
   677	        from _lib.filelock import FileLock, FileLockTimeout  # type: ignore
   678	        return FileLock, FileLockTimeout
   679	    except ImportError:
   680	        pass
   681	
   682	    import importlib.util
   683	    repo_root = Path(__file__).resolve().parent.parent.parent
   684	    spec_path = repo_root / "hooks" / "_lib" / "filelock.py"
   685	    spec = importlib.util.spec_from_file_location(
   686	        "_filelock_ext", str(spec_path)
   687	    )
   688	    if spec is None or spec.loader is None:
   689	        raise ImportError("filelock not available")
   690	    flmod = importlib.util.module_from_spec(spec)
   691	    spec.loader.exec_module(flmod)  # type: ignore[attr-defined]
   692	    return flmod.FileLock, flmod.FileLockTimeout  # type: ignore[attr-defined]
