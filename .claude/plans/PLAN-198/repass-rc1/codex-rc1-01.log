@dataclass
class Decision:
    """Typed result of the governance check."""

    allow: bool
    reason: Optional[str] = None

    def to_json(self) -> str:
        if self.allow:
            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow
        return json.dumps(
            {"decision": "block", "reason": self.reason or ""},
            ensure_ascii=False,
