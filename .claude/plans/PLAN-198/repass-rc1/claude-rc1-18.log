rn enriched\n330\t\n331\t        old_fm = _fm.parse_frontmatter(current)\n332\t        new_fm = _fm.parse_frontmatter(new_content)\n333\t\n334\t        old_status = str(old_fm.get(\"status\", \"\")).strip()\n335\t        new_status = str(new_fm.get(\"status\", \"\")).strip()\n336\t        derived[\"old_status\"] = old_status\n337\t        derived[\"new_status\"] = new_status\n338\t        derived[\"status_changed\"] = bool(\n339\t            old_status and new_status and old_status != new_status"}]},"parent_tool_use_id":null,"session_id":"99e4484c-9fd2-48bc-96cb-ca1217c6fa39","uuid":"f733a625-411e-42c0-ad1d-05dd20217a5c","timestamp":"2026-11-15T10:34:23.669Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/policy_preprocessors.py","content":"    except (OSError, UnicodeDecodeError):\n        return \"\"\n\n\ndef plan_edit_preprocess(event: Dict[str, Any],\n                         *, read_current=None) -> Dict[str, Any]:\n    \"\"\"Enrich ``event`` with ``_derived_plan`` fields.\n\n    Optional ``read_current`` param lets tests inject a fake file reader.\n    When ``None``, reads the real filesystem (matches .py hook behavior).\n    \"\"\"\n    enriched = dict(event) if isinstance(event, dict) else {}\n    derived = _plan_defaults()\n    reader = read_current if read_current is not None else _read_plan_file\n    try:\n        tool_input = event.get(\"tool_input\") if isinstance(event, dict) else None\n        if not isinstance(tool_input, dict):\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n        file_path = str(tool_input.get(\"file_path\") or \"\")\n        old_string = str(tool_input.get(\"old_string\") or \"\")\n        new_string = str(tool_input.get(\"new_string\") or \"\")\n        replace_all = bool(tool_input.get(\"replace_all\") or False)\n\n        # Scope guard.\n        if not _plan_paths.is_plan_path(file_path):\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n        derived[\"is_plan_file\"] = True\n        derived[\"plan_id\"] = _plan_paths.plan_id_from_path(file_path)\n\n        current = reader(file_path)\n        if not current:\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n\n        new_content = _apply_edit(current, old_string, new_string, replace_all)\n        if new_content == current:\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n\n        old_fm = _fm.parse_frontmatter(current)\n        new_fm = _fm.parse_frontmatter(new_content)\n\n        old_status = str(old_fm.get(\"status\", \"\")).strip()\n        new_status = str(new_fm.get(\"status\", \"\")).strip()\n        derived[\"old_status\"] = old_status\n        derived[\"new_status\"] = new_status\n        derived[\"status_changed\"] = bool(\n            old_status and new_status and old_status != new_status","numLines":50,"startLine":290,"totalLines":460}},"tool_result_meta":[{"id":"toolu_01MpFdME8dEhSYr6y2DfEPHt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
