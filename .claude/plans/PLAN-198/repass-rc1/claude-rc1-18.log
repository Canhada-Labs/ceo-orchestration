{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016DL2q8TavF53unJhdgSAqH","type":"tool_result","content":"1\t\"\"\"Extracted policy declarations: loading.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _estimate_size(value: Any) -> int:\n5\t    \"\"\"Best-effort recursive sizeof for the post-parse structure.\"\"\"\n6\t    seen: set = set()\n7\t\n8\t    def walk(v: Any) -> int:\n9\t        \"\"\"Recursive sizeof walker — bounds total parsed-structure memory.\n10\t\n11\t        Returns an estimated byte count for ``v`` summed across any\n12\t        contained dicts / lists / strings. Uses ``id(v)`` in the ``seen``\n13\t        set to short-circuit self-referential cycles (policy docs\n14\t        shouldn't have cycles post-alias-rejection, but the defensive\n15\t        check costs nothing). Falls back to ``sys.getsizeof(v)`` on\n16\t        non-container types; returns 0 on access errors.\n17\t        \"\"\"\n18\t        try:\n19\t            vid = id(v)\n20\t            if vid in seen:\n21\t                return 0\n22\t            seen.add(vid)\n23\t        except TypeError:  # pragma: no cover\n24\t            pass\n25\t        size = sys.getsizeof(v)\n26\t        if isinstance(v, dict):\n27\t            for k, vv in v.items():\n28\t                size += walk(k) + walk(vv)\n29\t        elif isinstance(v, (list, tuple, set, frozenset)):\n30\t            for item in v:\n31\t                size += walk(item)\n32\t        return size\n33\t\n34\t    return walk(value)\n35\t\n36\t\n37\tdef _load_read_raw(path: Path) -> \"tuple[str, str]\":\n38\t    \"\"\"PLAN-023 CLOSEOUT (DYN-REFACTOR-2) helper 1/4.\n39\t\n40\t    Stat + size cap + read bytes + BOM reject + UTF-8 decode.\n41\t    Returns (text, policy_id_hint); raises PolicyLoadError on any\n42\t    failure (preserving error_kind byte-identity per\n43\t    test_policy_golden_error_kinds.py).\n44\t    \"\"\"\n45\t    policy_id_hint = path.stem\n46\t    if policy_id_hint.endswith(\".policy\"):\n47\t        policy_id_hint = policy_id_hint[: -len(\".policy\")]\n48\t\n49\t    try:\n50\t        stat = path.stat()\n51\t    except OSError as e:\n52\t        raise PolicyLoadError(\n53\t            \"parse_error\",\n54\t            f\"cannot stat policy file: {e}\",\n55\t            policy_id_hint,\n56\t        )\n57\t    if stat.st_size > _LIMIT_FILE_BYTES:\n58\t        raise PolicyLoadError(\n59\t            \"size_limit\",\n60\t            f\"file size {stat.st_size} exceeds {_LIMIT_FILE_BYTES}\",\n61\t            policy_id_hint,\n62\t        )\n63\t\n64\t    try:\n65\t        with open(path, \"rb\") as f:\n66\t            raw = f.read()\n67\t    except OSError as e:\n68\t        raise PolicyLoadError(\n69\t            \"parse_error\",\n70\t            f\"cannot read policy file: {e}\",\n71\t            policy_id_hint,\n72\t        )\n73\t    if raw.startswith(b\"\\xef\\xbb\\xbf\"):\n74\t        raise PolicyLoadError(\n75\t            \"parse_error\",\n76\t            \"UTF-8 BOM not allowed\",\n77\t            policy_id_hint,\n78\t        )\n79\t    try:\n80\t        text = raw.decode(\"utf-8\")\n81\t    except UnicodeDecodeError as e:\n82\t        raise PolicyLoadError(\n83\t            \"parse_error\",\n84\t            f\"UTF-8 decode error: {e}\",\n85\t            policy_id_hint,\n86\t        )\n87\t    return text, policy_id_hint\n88\t\n89\t\n90\tdef _load_parse_and_audit(text: str, policy_id_hint: str) -> Dict[str, Any]:\n91\t    \"\"\"PLAN-023 CLOSEOUT (DYN-REFACTOR-2) helper 2/4.\n92\t\n93\t    Parse the YAML subset + post-parse size audit. Returns the parsed\n94\t    dict or raises PolicyLoadError with byte-identical error_kind.\n95\t    \"\"\"\n96\t    deadline = time.monotonic() + (_LIMIT_PARSE_CPU_MS / 1000.0)\n97\t    parser = _YamlParser(text, cpu_deadline_monotonic=deadline,\n98\t                         policy_id_hint=policy_id_hint)\n99\t    data = parser.parse_document()\n100\t    if not isinstance(data, dict):\n101\t        raise PolicyLoadError(\n102\t            \"parse_error\",\n103\t            \"top-level must be a mapping\",\n104\t            policy_id_hint,\n105\t        )\n106\t    if _estimate_size(data) > _LIMIT_TOTAL_EXPAND_BYTES:\n107\t        raise PolicyLoadError(\n108\t            \"size_limit\",\n109\t            f\"post-parse size exceeds {_LIMIT_TOTAL_EXPAND_BYTES} bytes\",\n110\t            policy_id_hint,\n111\t        )\n112\t    return data\n113\t\n114\t\n115\tdef load(path: Path) -> Policy:\n116\t    \"\"\"Parse + validate + compile a policy file.\n117\t\n118\t    Raises :class:`PolicyLoadError` on any SPEC §5 violation.\n119\t\n120\t    PLAN-023 CLOSEOUT decomposition: delegates to helpers\n121\t    ``_load_read_raw`` (I/O + decode) and ``_load_parse_and_audit``\n122\t    (YAML + size audit). Byte-identity preserved against\n123\t    ``test_policy_golden_error_kinds.py`` 18-case golden suite.\n124\t    \"\"\"\n125\t    path = Path(path)\n126\t    text, policy_id_hint = _load_read_raw(path)\n127\t    data = _load_parse_and_audit(text, policy_id_hint)\n128\t\n129\t    # --- top-level schema validation ---\n130\t    for key in _TOP_LEVEL_REQUIRED:\n131\t        if key not in data:\n132\t            raise PolicyLoadError(\n133\t                \"parse_error\",\n134\t                f\"missing required top-level key {key!r}\",\n135\t                policy_id_hint,\n136\t            )\n137\t    schema_version = data[\"schema\"]\n138\t    if schema_version != \"policy-dsl/v1\":\n139\t        raise PolicyLoadError(\n140\t            \"schema_version_mismatch\",\n141\t            f\"schema must be 'policy-dsl/v1', got {schema_version!r}\",\n142\t            policy_id_hint,\n143\t        )\n144\t    policy_id = data[\"id\"]\n145\t    if not isinstance(policy_id, str) or not policy_id:\n146\t        raise PolicyLoadError(\"parse_error\", \"'id' must be a non-empty string\",\n147\t                              policy_id_hint)\n148\t    description = data[\"description\"]\n149\t    if not isinstance(description, str):\n150\t        raise PolicyLoadError(\"parse_error\", \"'description' must be a string\",\n151\t                              policy_id)\n152\t    if len(description) > 200:\n153\t        raise PolicyLoadError(\"size_limit\",\n154\t                              \"description exceeds 200 chars\",\n155\t                              policy_id)\n156\t    kind = data[\"kind\"]\n157\t    if not isinstance(kind, str) or kind not in _KIND_ENUM:\n158\t        raise PolicyLoadError(\"parse_error\",\n159\t                              f\"kind must be one of {sorted(_KIND_ENUM)}, got {kind!r}\",\n160\t                              policy_id)\n161\t    defaults = data[\"defaults\"]\n162\t    if not isinstance(defaults, dict) or \"decision\" not in defaults:\n163\t        raise PolicyLoadError(\"parse_error\",\n164\t                              \"'defaults' must be a mapping with 'decision'\",\n165\t                              policy_id)\n166\t    dd = defaults[\"decision\"]\n167\t    if not isinstance(dd, str) or dd not in _DECISION_ENUM:\n168\t        raise PolicyLoadError(\"parse_error\",\n169\t                              f\"defaults.decision must be allow|block, got {defaults['decision']!r}\",\n170\t                              policy_id)\n171\t    rules_raw = data[\"rules\"]\n172\t    if not isinstance(rules_raw, list):\n173\t        raise PolicyLoadError(\"parse_error\", \"'rules' must be a list\", policy_id)\n174\t    error_model = data[\"error_model\"]\n175\t    if not isinstance(error_model, dict) or \"reasons\" not in error_model:\n176\t        raise PolicyLoadError(\"parse_error\",\n177\t                              \"'error_model' must be a mapping with 'reasons'\",\n178\t                              policy_id)\n179\t    reasons_raw = error_model[\"reasons\"]\n180\t    if not isinstance(reasons_raw, dict):\n181\t        raise PolicyLoadError(\"parse_error\",\n182\t                              \"'error_model.reasons' must be a mapping\",\n183\t                              policy_id)\n184\t    error_reasons: Dict[str, str] = {}\n185\t    for k, v in reasons_raw.items():\n186\t        if not isinstance(k, str) or not isinstance(v, str):\n187\t            raise PolicyLoadError(\"parse_error\",\n188\t                                  \"error_model.reasons entries must be string→string\",\n189\t                                  policy_id)\n190\t        error_reasons[k] = v\n191\t\n192\t    # --- compile rules ---\n193\t    compiled: List[CompiledRule] = []\n194\t    seen_ids: set = set()\n195\t    for idx, rule_raw in enumerate(rules_raw):\n196\t        if not isinstance(rule_raw, dict):\n197\t            raise PolicyLoadError(\"parse_error\",\n198\t                                  f\"rule[{idx}] must be a mapping\",\n199\t                                  policy_id)\n200\t        rid = rule_raw.get(\"id\")\n201\t        if not isinstance(rid, str) or not rid:\n202\t            raise PolicyLoadError(\"parse_error\",\n203\t                                  f\"rule[{idx}] missing 'id'\",\n204\t                                  policy_id)\n205\t        if rid in seen_ids:\n206\t            raise PolicyLoadError(\"parse_error\",\n207\t                                  f\"duplicate rule id {rid!r}\",\n208\t                                  policy_id)\n209\t        seen_ids.add(rid)\n210\t        decision = rule_raw.get(\"decision\")\n211\t        if not isinstance(decision, str) or decision not in _DECISION_ENUM:\n212\t            raise PolicyLoadError(\"parse_error\",\n213\t                                  f\"rule {rid!r} decision must be allow|block\",\n214\t                                  policy_id)\n215\t        reason = rule_raw.get(\"reason\")\n216\t        if decision == \"block\":\n217\t            if not isinstance(reason, str) or not reason:\n218\t                raise PolicyLoadError(\"parse_error\",\n219\t                                      f\"rule {rid!r} decision=block requires 'reason'\",\n220\t                                      policy_id)\n221\t            if reason not in error_reasons:\n222\t                raise PolicyLoadError(\"parse_error\",\n223\t                                      f\"rule {rid!r} reason {reason!r} not in error_model.reasons\",\n224\t                                      policy_id)\n225\t        pred_raw = rule_raw.get(\"predicate\")\n226\t        if pred_raw is None:\n227\t            raise PolicyLoadError(\"predicate_missing\",\n228\t                                  f\"rule {rid!r} missing 'predicate'\",\n229\t                                  policy_id)\n230\t        predicate = _compile_predicate(pred_raw, policy_id,\n231\t                                       path=f\"rules[{idx}].predicate\")\n232\t        desc = rule_raw.get(\"description\", \"\")\n233\t        if not isinstance(desc, str):\n234\t            desc = str(desc) if desc is not None else \"\"\n235\t        if len(desc) > 200:\n236\t            raise PolicyLoadError(\"size_limit\",\n237\t                                  f\"rule {rid!r} description exceeds 200 chars\",\n238\t                                  policy_id)\n239\t        status = rule_raw.get(\"status\")\n240\t        if status is not None and not isinstance(status, str):\n241\t            status = None\n242\t        compiled.append(CompiledRule(\n243\t            rule_id=rid,\n244\t            description=desc,\n245\t            decision=decision,\n246\t            reason=reason if decision == \"block\" else None,\n247\t            predicate=predicate,\n248\t            status=status,\n249\t        ))\n250\t\n251\t    # Cross-check id field matches filename hint (advisory — mismatch is NOT\n252\t    # an error per SPEC; fixture naming convention only).\n253\t    _ = policy_id_hint  # retained for diagnostics.\n254\t\n255\t    return Policy(\n256\t        policy_id=policy_id,\n257\t        schema_version=schema_version,\n258\t        description=description,\n259\t        kind=kind,\n260\t        defaults=defaults,\n261\t        rules=compiled,\n262\t        error_reasons=error_reasons,\n263\t    )\n264\t\n265\t\n266\t__all__ = [\n267\t    \"Policy\",\n268\t    \"CompiledRule\",\n269\t    \"PolicyLoadError\",\n270\t    \"load\",\n271\t]\n272\t"}]},"parent_tool_use_id":null,"session_id":"99e4484c-9fd2-48bc-96cb-ca1217c6fa39","uuid":"b82c84a7-254d-4138-99db-3a04b3efbc70","timestamp":"2026-11-15T10:30:30.862Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_policy_parts/loading.py","content":"\"\"\"Extracted policy declarations: loading.\"\"\"\nfrom __future__ import annotations\n\ndef _estimate_size(value: Any) -> int:\n    \"\"\"Best-effort recursive sizeof for the post-parse structure.\"\"\"\n    seen: set = set()\n\n    def walk(v: Any) -> int:\n        \"\"\"Recursive sizeof walker — bounds total parsed-structure memory.\n\n        Returns an estimated byte count for ``v`` summed across any\n        contained dicts / lists / strings. Uses ``id(v)`` in the ``seen``\n        set to short-circuit self-referential cycles (policy docs\n        shouldn't have cycles post-alias-rejection, but the defensive\n        check costs nothing). Falls back to ``sys.getsizeof(v)`` on\n        non-container types; returns 0 on access errors.\n        \"\"\"\n        try:\n            vid = id(v)\n            if vid in seen:\n                return 0\n            seen.add(vid)\n        except TypeError:  # pragma: no cover\n            pass\n        size = sys.getsizeof(v)\n        if isinstance(v, dict):\n            for k, vv in v.items():\n                size += walk(k) + walk(vv)\n        elif isinstance(v, (list, tuple, set, frozenset)):\n            for item in v:\n                size += walk(item)\n        return size\n\n    return walk(value)\n\n\ndef _load_read_raw(path: Path) -> \"tuple[str, str]\":\n    \"\"\"PLAN-023 CLOSEOUT (DYN-REFACTOR-2) helper 1/4.\n\n    Stat + size cap + read bytes + BOM reject + UTF-8 decode.\n    Returns (text, policy_id_hint); raises PolicyLoadError on any\n    failure (preserving error_kind byte-identity per\n    test_policy_golden_error_kinds.py).\n    \"\"\"\n    policy_id_hint = path.stem\n    if policy_id_hint.endswith(\".policy\"):\n        policy_id_hint = policy_id_hint[: -len(\".policy\")]\n\n    try:\n        stat = path.stat()\n    except OSError as e:\n        raise PolicyLoadError(\n            \"parse_error\",\n            f\"cannot stat policy file: {e}\",\n            policy_id_hint,\n        )\n    if stat.st_size > _LIMIT_FILE_BYTES:\n        raise PolicyLoadError(\n            \"size_limit\",\n            f\"file size {stat.st_size} exceeds {_LIMIT_FILE_BYTES}\",\n            policy_id_hint,\n        )\n\n    try:\n        with open(path, \"rb\") as f:\n            raw = f.read()\n    except OSError as e:\n        raise PolicyLoadError(\n            \"parse_error\",\n            f\"cannot read policy file: {e}\",\n            policy_id_hint,\n        )\n    if raw.startswith(b\"\\xef\\xbb\\xbf\"):\n        raise PolicyLoadError(\n            \"parse_error\",\n            \"UTF-8 BOM not allowed\",\n            policy_id_hint,\n        )\n    try:\n        text = raw.decode(\"utf-8\")\n    except UnicodeDecodeError as e:\n        raise PolicyLoadError(\n            \"parse_error\",\n            f\"UTF-8 decode error: {e}\",\n            policy_id_hint,\n        )\n    return text, policy_id_hint\n\n\ndef _load_parse_and_audit(text: str, policy_id_hint: str) -> Dict[str, Any]:\n    \"\"\"PLAN-023 CLOSEOUT (DYN-REFACTOR-2) helper 2/4.\n\n    Parse the YAML subset + post-parse size audit. Returns the parsed\n    dict or raises PolicyLoadError with byte-identical error_kind.\n    \"\"\"\n    deadline = time.monotonic() + (_LIMIT_PARSE_CPU_MS / 1000.0)\n    parser = _YamlParser(text, cpu_deadline_monotonic=deadline,\n                         policy_id_hint=policy_id_hint)\n    data = parser.parse_document()\n    if not isinstance(data, dict):\n        raise PolicyLoadError(\n            \"parse_error\",\n            \"top-level must be a mapping\",\n            policy_id_hint,\n        )\n    if _estimate_size(data) > _LIMIT_TOTAL_EXPAND_BYTES:\n        raise PolicyLoadError(\n            \"size_limit\",\n            f\"post-parse size exceeds {_LIMIT_TOTAL_EXPAND_BYTES} bytes\",\n            policy_id_hint,\n        )\n    return data\n\n\ndef load(path: Path) -> Policy:\n    \"\"\"Parse + validate + compile a policy file.\n\n    Raises :class:`PolicyLoadError` on any SPEC §5 violation.\n\n    PLAN-023 CLOSEOUT decomposition: delegates to helpers\n    ``_load_read_raw`` (I/O + decode) and ``_load_parse_and_audit``\n    (YAML + size audit). Byte-identity preserved against\n    ``test_policy_golden_error_kinds.py`` 18-case golden suite.\n    \"\"\"\n    path = Path(path)\n    text, policy_id_hint = _load_read_raw(path)\n    data = _load_parse_and_audit(text, policy_id_hint)\n\n    # --- top-level schema validation ---\n    for key in _TOP_LEVEL_REQUIRED:\n        if key not in data:\n            raise PolicyLoadError(\n                \"parse_error\",\n                f\"missing required top-level key {key!r}\",\n                policy_id_hint,\n            )\n    schema_version = data[\"schema\"]\n    if schema_version != \"policy-dsl/v1\":\n        raise PolicyLoadError(\n            \"schema_version_mismatch\",\n            f\"schema must be 'policy-dsl/v1', got {schema_version!r}\",\n            policy_id_hint,\n        )\n    policy_id = data[\"id\"]\n    if not isinstance(policy_id, str) or not policy_id:\n        raise PolicyLoadError(\"parse_error\", \"'id' must be a non-empty string\",\n                              policy_id_hint)\n    description = data[\"description\"]\n    if not isinstance(description, str):\n        raise PolicyLoadError(\"parse_error\", \"'description' must be a string\",\n                              policy_id)\n    if len(description) > 200:\n        raise PolicyLoadError(\"size_limit\",\n                              \"description exceeds 200 chars\",\n                              policy_id)\n    kind = data[\"kind\"]\n    if not isinstance(kind, str) or kind not in _KIND_ENUM:\n        raise PolicyLoadError(\"parse_error\",\n                              f\"kind must be one of {sorted(_KIND_ENUM)}, got {kind!r}\",\n                              policy_id)\n    defaults = data[\"defaults\"]\n    if not isinstance(defaults, dict) or \"decision\" not in defaults:\n        raise PolicyLoadError(\"parse_error\",\n                              \"'defaults' must be a mapping with 'decision'\",\n                              policy_id)\n    dd = defaults[\"decision\"]\n    if not isinstance(dd, str) or dd not in _DECISION_ENUM:\n        raise PolicyLoadError(\"parse_error\",\n                              f\"defaults.decision must be allow|block, got {defaults['decision']!r}\",\n                              policy_id)\n    rules_raw = data[\"rules\"]\n    if not isinstance(rules_raw, list):\n        raise PolicyLoadError(\"parse_error\", \"'rules' must be a list\", policy_id)\n    error_model = data[\"error_model\"]\n    if not isinstance(error_model, dict) or \"reasons\" not in error_model:\n        raise PolicyLoadError(\"parse_error\",\n                              \"'error_model' must be a mapping with 'reasons'\",\n                              policy_id)\n    reasons_raw = error_model[\"reasons\"]\n    if not isinstance(reasons_raw, dict):\n        raise PolicyLoadError(\"parse_error\",\n                              \"'error_model.reasons' must be a mapping\",\n                              policy_id)\n    error_reasons: Dict[str, str] = {}\n    for k, v in reasons_raw.items():\n        if not isinstance(k, str) or not isinstance(v, str):\n            raise PolicyLoadError(\"parse_error\",\n                                  \"error_model.reasons entries must be string→string\",\n                                  policy_id)\n        error_reasons[k] = v\n\n    # --- compile rules ---\n    compiled: List[CompiledRule] = []\n    seen_ids: set = set()\n    for idx, rule_raw in enumerate(rules_raw):\n        if not isinstance(rule_raw, dict):\n            raise PolicyLoadError(\"parse_error\",\n                                  f\"rule[{idx}] must be a mapping\",\n                                  policy_id)\n        rid = rule_raw.get(\"id\")\n        if not isinstance(rid, str) or not rid:\n            raise PolicyLoadError(\"parse_error\",\n                                  f\"rule[{idx}] missing 'id'\",\n                                  policy_id)\n        if rid in seen_ids:\n            raise PolicyLoadError(\"parse_error\",\n                                  f\"duplicate rule id {rid!r}\",\n                                  policy_id)\n        seen_ids.add(rid)\n        decision = rule_raw.get(\"decision\")\n        if not isinstance(decision, str) or decision not in _DECISION_ENUM:\n            raise PolicyLoadError(\"parse_error\",\n                                  f\"rule {rid!r} decision must be allow|block\",\n                                  policy_id)\n        reason = rule_raw.get(\"reason\")\n        if decision == \"block\":\n            if not isinstance(reason, str) or not reason:\n                raise PolicyLoadError(\"parse_error\",\n                                      f\"rule {rid!r} decision=block requires 'reason'\",\n                                      policy_id)\n            if reason not in error_reasons:\n                raise PolicyLoadError(\"parse_error\",\n                                      f\"rule {rid!r} reason {reason!r} not in error_model.reasons\",\n                                      policy_id)\n        pred_raw = rule_raw.get(\"predicate\")\n        if pred_raw is None:\n            raise PolicyLoadError(\"predicate_missing\",\n                                  f\"rule {rid!r} missing 'predicate'\",\n                                  policy_id)\n        predicate = _compile_predicate(pred_raw, policy_id,\n                                       path=f\"rules[{idx}].predicate\")\n        desc = rule_raw.get(\"description\", \"\")\n        if not isinstance(desc, str):\n            desc = str(desc) if desc is not None else \"\"\n        if len(desc) > 200:\n            raise PolicyLoadError(\"size_limit\",\n                                  f\"rule {rid!r} description exceeds 200 chars\",\n                                  policy_id)\n        status = rule_raw.get(\"status\")\n        if status is not None and not isinstance(status, str):\n            status = None\n        compiled.append(CompiledRule(\n            rule_id=rid,\n            description=desc,\n            decision=decision,\n            reason=reason if decision == \"block\" else None,\n            predicate=predicate,\n            status=status,\n        ))\n\n    # Cross-check id field matches filename hint (advisory — mismatch is NOT\n    # an error per SPEC; fixture naming convention only).\n    _ = policy_id_hint  # retained for diagnostics.\n\n    return Policy(\n        policy_id=policy_id,\n        schema_version=schema_version,\n        description=description,\n        kind=kind,\n        defaults=defaults,\n        rules=compiled,\n        error_reasons=error_reasons,\n    )\n\n\n__all__ = [\n    \"Policy\",\n    \"CompiledRule\",\n    \"PolicyLoadError\",\n    \"load\",\n]\n","numLines":272,"startLine":1,"totalLines":272}},"tool_result_meta":[{"id":"toolu_016DL2q8TavF53unJhdgSAqH","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
