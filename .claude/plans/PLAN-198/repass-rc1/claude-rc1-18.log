{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Av3R7PpuHMuTjnUuZZpZKZ","type":"tool_result","content":"1\t\"\"\"Declarations extracted from federation.server; loaded by the facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tclass _HandlerWrite:\n5\t    def _dispatch_write(self, method: str) -> None:\n6\t        \"\"\"ADR-135-AMEND-1 §2.2 11-gate chain for write endpoints.\"\"\"\n7\t        if _fed_scopes is None:\n8\t            # Partial install — scopes module absent. Fail-CLOSED.\n9\t            self._emit_write_blocked()\n10\t            self._send_405()\n11\t            return\n12\t\n13\t        raw_path = self.path or \"\"\n14\t        path = raw_path.split(\"?\", 1)[0].split(\"#\", 1)[0]\n15\t\n16\t        # Gate #2 — resolve peer (also refreshes peer list per R-IT-B).\n17\t        peer = self._resolve_peer()\n18\t        if peer is None:\n19\t            self._emit_connection_rejected(\"peer_unresolved\")\n20\t            self._send_status(401, \"unauthorized\")\n21\t            return\n22\t\n23\t        peers_extra = getattr(self.server, \"federation_peers_extra\", {}) or {}\n24\t        extra = peers_extra.get(peer.peer_id, {}) if peers_extra else {}\n25\t        peer_row = {\n26\t            \"peer_id\": peer.peer_id,\n27\t            \"peer_id_spki_fingerprint\": extra.get(\n28\t                \"peer_id_spki_fingerprint\", \"\"\n29\t            ),\n30\t            \"peer_id_cert_fingerprint\": peer.peer_id_cert_fingerprint,\n31\t            \"scopes\": list(extra.get(\"scopes\", [])),\n32\t            \"audit_event_push_allowlist\": list(\n33\t                extra.get(\"audit_event_push_allowlist\", [])\n34\t            ),\n35\t            \"revoked\": bool(extra.get(\"revoked\", peer.revoked)),\n36\t        }\n37\t\n38\t        # GATE #3a — non-mutating timestamp-window preflight (R-SE-a).\n39\t        pf_reason = self._replay_freshness_preflight(peer)\n40\t        if pf_reason is not None:\n41\t            _safe_emit(\n42\t                \"federation_connection_replay_suspected\",\n43\t                peer_id=peer.peer_id[:64],\n44\t                reason=pf_reason[:64],\n45\t                client_ip=self._client_ip(),\n46\t            )\n47\t            self._send_status(401, \"hmac_or_replay\")\n48\t            return\n49\t\n50\t        # GATE #3b — body read (capped).\n51\t        body = self._read_body_capped(max_bytes=1024 * 1024)\n52\t        if body is None:\n53\t            self._send_status(413, \"payload_too_large\")\n54\t            return\n55\t\n56\t        # GATE #3c — HMAC signature verify (needs body, no mutation).\n57\t        sig_reason = self._verify_signature_only(peer, body)\n58\t        if sig_reason is not None:\n59\t            _safe_emit(\n60\t                \"federation_connection_replay_suspected\",\n61\t                peer_id=peer.peer_id[:64],\n62\t                reason=sig_reason[:64],\n63\t                client_ip=self._client_ip(),\n64\t            )\n65\t            self._send_status(401, \"hmac_or_replay\")\n66\t            return\n67\t\n68\t        # GATE #3d — MUTATING nonce commit (ONLY after HMAC passes).\n69\t        nonce_reason = self._commit_nonce(peer)\n70\t        if nonce_reason is not None:\n71\t            _safe_emit(\n72\t                \"federation_connection_replay_suspected\",\n73\t                peer_id=peer.peer_id[:64],\n74\t                reason=nonce_reason[:64],\n75\t                client_ip=self._client_ip(),\n76\t            )\n77\t            self._send_status(401, \"hmac_or_replay\")\n78\t            return\n79\t\n80\t        # GATE #4 — method + path → scope.\n81\t        required_scope = _fed_scopes.route_required_scope(method, path)\n82\t        if required_scope is None:\n83\t            self._emit_write_blocked()\n84\t            self._send_405()\n85\t            return\n86\t\n87\t        # GATE #5 — X-CEO-Federation-Scope header presence + match.\n88\t        if not _fed_scopes.validate_scope_header(self.headers, required_scope):\n89\t            self._emit_scope_denied(peer.peer_id, path, required_scope, peer_row)\n90\t            self._send_status(400, \"scope_header\")\n91\t            return\n92\t\n93\t        # GATE #6 — peer's scopes list grants the required scope.\n94\t        if not _fed_scopes.peer_has_scope(peer_row, required_scope):\n95\t            self._emit_write_endpoint_denied(\n96\t                peer.peer_id, path, gate_failed=6, reason_code=\"write_unauthorized\",\n97\t            )\n98\t            self._send_status(403, \"scope\")\n99\t            return\n100\t\n101\t        # GATE #7 — peer not revoked (reloaded list per P0-1).\n102\t        if peer_row.get(\"revoked\") is True:\n103\t            self._emit_write_endpoint_denied(\n104\t                peer.peer_id, path, gate_failed=7, reason_code=\"peer_revoked\",\n105\t            )\n106\t            self._send_status(403, \"revoked\")\n107\t            return\n108\t\n109\t        # GATE #8 — write-enable sentinel valid (also enforced at 0a).\n110\t        if not self._write_enable_sentinel_valid():\n111\t            self._emit_write_disabled_sentinel_invalid(\"gpg_verify_failed\")\n112\t            self._send_status(503, \"write_disabled\")\n113\t            return\n114\t\n115\t        # GATE #9 — rate-limit (REAL — Wave E; default-DENY on exception).\n116\t        ok, rl_reason = self._rate_limit_check(method, path, self.headers, peer_row)\n117\t        if not ok:\n118\t            self._emit_write_endpoint_denied(\n119\t                peer.peer_id, path, gate_failed=9,\n120\t                reason_code=(rl_reason or \"rate_limited\")[:32],\n121\t            )\n122\t            self._send_status(429, \"rate_limited\")\n123\t            return\n124\t\n125\t        # GATE #10a — CLAIM + VERIFY (destructive routes; BEFORE handler).\n126\t        cosign_inflight_paths = None\n127\t        if _fed_scopes.is_destructive_route(method, path):\n128\t            ok, reason, cosign_inflight_paths = self._verify_owner_cosign_claim(\n129\t                method, path,\n130\t            )\n131\t            if not ok:\n132\t                self._emit_write_endpoint_denied(\n133\t                    peer.peer_id, path, gate_failed=10,\n134\t                    reason_code=\"destructive_unauthz:{0}\".format(reason[:12]),\n135\t                )\n136\t                self._send_status(403, \"owner_cosign\")\n137\t                return\n138\t\n139\t        # GATE #11 — handler executes.\n140\t        # PLAN-112-FOLLOWUP P0 #1 + P1 #2 (Codex BLOCK): pass the\n141\t        # SERVER-CONFIGURED state paths route-specifically so a non-default\n142\t        # config mutates the RIGHT trust-root file (peers.yaml) and the\n143\t        # tamper check inspects the SAME audit-log the handler appends to.\n144\t        # Without this the handlers fall back to PEERS_FILE_DEFAULT /\n145\t        # their own audit-log resolution and the revocation-propagation +\n146\t        # T1565 claims become false.\n147\t        handler = self._route_handler(method, path)\n148\t        if handler is None:\n149\t            self._send_405()\n150\t            return\n151\t        handler_kwargs = self._handler_state_kwargs(path)\n152\t        try:\n153\t            status, reason, response_body = handler.handle(\n154\t                peer_row, self.headers, body, **handler_kwargs\n155\t            )\n156\t        except Exception as exc:\n157\t            sys.stderr.write(\n158\t                \"[federation.dispatch] handler crashed: {0}: {1}\\n\".format(\n159\t                    type(exc).__name__, str(exc)[:200]\n160\t                )\n161\t            )\n162\t            self._send_status(500, \"handler_crash\")\n163\t            return\n164\t\n165\t        # GATE #10b — CONSUME (AFTER handler success only).\n166\t        if cosign_inflight_paths is not None and status < 400:\n167\t            self._consume_owner_cosign_sentinel(cosign_inflight_paths)\n168\t\n169\t        # POST-handler T1565 — audit-chain tamper detection (W4). We walk\n170\t        # the SAME canonical audit-log the push handler just appended to\n171\t        # (handler_kwargs[\"audit_log_path\"]) so the check is guaranteed to\n172\t        # inspect the freshly-written record — F-7.10 critical detection\n173\t        # must be REACHABLE, not merely plumbed.\n174\t        if status < 400 and path in (\n175\t            \"/federation/audit-event\", \"/federation/audit-event/batch\",\n176\t        ):\n177\t            self._maybe_check_audit_chain(\n178\t                peer.peer_id, path, handler_kwargs.get(\"audit_log_path\"),\n179\t            )\n180\t\n181\t        self._send_response_bytes(status, response_body)\n182\t\n183\t    def _resolve_audit_log_path(self) -> Optional[Path]:\n184\t        \"\"\"Return the ONE canonical audit-log path (P0 #1).\n185\t\n186\t        Precedence: server-config ``audit_log_path`` → the audit handler's\n187\t        own resolver (``CEO_AUDIT_LOG_PATH`` / platform default), so the\n188\t        write handlers + the T1565 tamper check ALWAYS agree on the path.\n189\t        \"\"\"\n190\t        cfg = getattr(self.server, \"federation_config\", None)\n191\t        path = getattr(self.server, \"federation_audit_log_path\", None)\n192\t        if path is None and cfg is not None:\n193\t            path = getattr(cfg, \"audit_log_path\", None)\n194\t        if path is not None:\n195\t            return Path(path)\n196\t        # Mirror the handler's resolver so both sides land on the same file.\n197\t        try:\n198\t            try:\n199\t                from .handlers import audit_event_push as _aep  # type: ignore\n200\t            except ImportError:\n201\t                import importlib\n202\t                _aep = importlib.import_module(\n203\t                    \"_lib.federation.handlers.audit_event_push\"\n204\t                )\n205\t            resolver = getattr(_aep, \"_resolve_audit_log_path\", None)\n206\t            if resolver is not None:\n207\t                return Path(resolver())\n208\t        except Exception:\n209\t            pass\n210\t        return None\n211\t\n212\t    def _handler_state_kwargs(self, path: str) -> Dict[str, Any]:\n213\t        \"\"\"Route-specific server-state kwargs for the gate-#11 handler.\n214\t\n215\t        P1 #2: peer_register/peer_revoke get the configured ``peers_path``\n216\t        (NOT PEERS_FILE_DEFAULT). P0 #1: audit-event push/batch get the ONE\n217\t        canonical ``audit_log_path``. Only paths that the target handler's\n218\t        ``handle(...)`` accepts are passed (kwargs are route-matched).\n219\t        \"\"\"\n220\t        cfg = getattr(self.server, \"federation_config\", None)\n221\t        if path in (\"/federation/peer-register\", \"/federation/peer-revoke\"):\n222\t            peers_path = getattr(self.server, \"federation_peers_path\", None)\n223\t            if peers_path is None and cfg is not None:\n224\t                peers_path = getattr(cfg, \"peers_path\", None)\n225\t            if peers_path is not None:\n226\t                return {\"peers_path\": Path(peers_path)}\n227\t            return {}\n228\t        if path in (\n229\t            \"/federation/audit-event\", \"/federation/audit-event/batch\",\n230\t        ):\n231\t            log_path = self._resolve_audit_log_path()\n232\t            if log_path is not None:\n233\t                return {\"audit_log_path\": log_path}\n234\t            return {}\n235\t        return {}\n236\t\n237\t    def _route_handler(self, method: str, path: str):\n238\t        \"\"\"Map (method, path) → handler module.\"\"\"\n239\t        key = (method.upper(), path)\n240\t        if key == (\"POST\", \"/federation/peer-register\"):\n241\t            return _h_peer_register\n242\t        if key == (\"POST\", \"/federation/audit-event\"):\n243\t            return _h_audit_event_push\n244\t        if key == (\"POST\", \"/federation/audit-event/batch\"):\n245\t            return _h_audit_event_batch\n246\t        if key == (\"POST\", \"/federation/peer-revoke\"):\n247\t            return _h_peer_revoke\n248\t        return None\n249\t\n250\t    # -- Gate #8 — write-enable sentinel verify ------------------------\n251\t\n252\t    def _write_enable_sentinel_valid(self) -> bool:\n253\t        \"\"\"Gate #8 / Layer 0b — verify the write-enable sentinel pair.\n254\t\n255\t        Fail-CLOSED on any error. No caching (ADR-121 §6 v1.x no-cache).\n256\t        \"\"\"\n257\t        cfg = getattr(self.server, \"federation_config\", None)\n258\t        signed_path = getattr(self.server, \"write_enabled_sentinel\", None)\n259\t        if signed_path is None and cfg is not None:\n260\t            signed_path = getattr(cfg, \"write_enabled_sentinel\", None)\n261\t        if signed_path is None:\n262\t            signed_path = Path(\".claude/data/federation/write-enabled.md\")\n263\t        signed_path = Path(signed_path)\n264\t\n265\t        sig_path = getattr(self.server, \"write_enabled_sentinel_asc\", None)\n266\t        if sig_path is None and cfg is not None:\n267\t            sig_path = getattr(cfg, \"write_enabled_sentinel_asc\", None)\n268\t        if sig_path is None:\n269\t            sig_path = Path(str(signed_path) + \".asc\")\n270\t        sig_path = Path(sig_path)\n271\t\n272\t        if not signed_path.exists() or not sig_path.exists():\n273\t            return False\n274\t\n275\t        try:\n276\t            owner_fpr = getattr(self.server, \"owner_fpr\", OWNER_GPG_FPR)\n277\t            registry_path = getattr(self.server, \"signer_registry_path\", None)\n278\t            if registry_path is None and cfg is not None:\n279\t                registry_path = getattr(cfg, \"signer_registry_path\", None)\n280\t            ok, _reason = verify_enable_sentinel_pair(\n281\t                signed_path,\n282\t                sig_path,\n283\t                [owner_fpr],\n284\t                signer_registry_path=registry_path,\n285\t            )\n286\t        except Exception:\n287\t            return False\n288\t        return bool(ok)\n289\t\n290\t    # -- Gate #10 — Owner co-sign claim / consume (split TOCTOU) --------\n291\t\n292\t    def _verify_owner_cosign_claim(\n293\t        self, method: str, path: str,\n294\t    ) -> Tuple[bool, str, Optional[Tuple[Path, Path, Path, Path, str]]]:\n295\t        \"\"\"Gate #10a — CLAIM + VERIFY per-request Owner-co-sign sentinel.\"\"\"\n296\t        sigref = \"\"\n297\t        for k, v in self.headers.items():\n298\t            if isinstance(k, str) and k.lower() == \"x-ceo-owner-sigref\":\n299\t                sigref = str(v) if isinstance(v, str) else \"\"\n300\t                break\n301\t        if not sigref:\n302\t            return False, \"missing_header:x_ceo_owner_sigref\", None\n303\t        if not re.match(r\"^[A-Za-z0-9_-]{1,64}$\", sigref):\n304\t            return False, \"sigref_charset\", None\n305\t\n306\t        cfg = getattr(self.server, \"federation_config\", None)\n307\t        base = getattr(self.server, \"federation_sentinels_dir\", None)\n308\t        if base is None and cfg is not None:\n309\t            base = getattr(cfg, \"federation_sentinels_dir\", None)\n310\t        if base is None:\n311\t            base = Path(\".claude/data/federation/sentinels\")\n312\t        base_dir = Path(base) / sigref\n313\t        md_path = base_dir / \"approval.md\"\n314\t        asc_path = base_dir / \"approval.md.asc\"\n315\t\n316\t        if not md_path.exists() or not asc_path.exists():\n317\t            return False, \"sentinel_not_found\", None\n318\t\n319\t        md_inflight = md_path.with_suffix(md_path.suffix + \".inflight\")\n320\t        try:\n321\t            os.rename(str(md_path), str(md_inflight))\n322\t        except OSError:\n323\t            return False, \"sentinel_inflight_collision\", None\n324\t\n325\t        asc_inflight = asc_path.with_suffix(asc_path.suffix + \".inflight\")\n326\t        try:\n327\t            os.rename(str(asc_path), str(asc_inflight))\n328\t        except OSError:\n329\t            try:\n330\t                os.rename(str(md_inflight), str(md_path))\n331\t            except OSError:\n332\t                pass\n333\t            return False, \"sentinel_asc_claim_failed\", None\n334\t\n335\t        # PLAN-112-FOLLOWUP P2 #4 (Codex BLOCK): every failure path AFTER\n336\t        # both files are renamed to .inflight (verify failure, read failure,\n337\t        # missing signed_at, TTL expiry, unexpected exception) must REVERT\n338\t        # the .inflight pair to its original names — best-effort — so the\n339\t        # sentinel is NOT left stuck. The sentinel was NOT consumed (verify\n340\t        # failed), so reverting is correct: it restores the recoverable\n341\t        # pre-claim state. The 5-min reaper (REMAINING) is the backstop for\n342\t        # the residual crash-between-rename window only.\n343\t        def _revert_inflight() -> None:\n344\t            try:\n345\t                if md_inflight.exists() and not md_path.exists():\n346\t                    os.rename(str(md_inflight), str(md_path))\n347\t            except OSError:\n348\t                pass\n349\t            try:\n350\t                if asc_inflight.exists() and not asc_path.exists():\n351\t                    os.rename(str(asc_inflight), str(asc_path))\n352\t            except OSError:\n353\t                pass\n354\t\n355\t        try:\n356\t            owner_fpr = getattr(self.server, \"owner_fpr\", OWNER_GPG_FPR)\n357\t            registry_path = getattr(self.server, \"signer_registry_path\", None)\n358\t            if registry_path is None and cfg is not None:\n359\t                registry_path = getattr(cfg, \"signer_registry_path\", None)\n360\t            ok, reason = verify_enable_sentinel_pair(\n361\t                md_inflight, asc_inflight, [owner_fpr],\n362\t                signer_registry_path=registry_path,\n363\t            )\n364\t            if not ok:\n365\t                _revert_inflight()\n366\t                return False, \"verify_failed:{0}\".format(reason[:64]), None\n367\t            try:\n368\t                md_text = md_inflight.read_text(encoding=\"utf-8\")\n369\t            except OSError as exc:\n370\t                _revert_inflight()\n371\t                return False, \"read_md_failed:{0}\".format(\n372\t                    exc.errno or \"unknown\",\n373\t                ), None\n374\t            signed_at = self._parse_signed_at(md_text)\n375\t            if signed_at is None:\n376\t                _revert_inflight()\n377\t                return False, \"missing_signed_at\", None\n378\t            age_seconds = time.time() - signed_at\n379\t            if age_seconds > 24 * 3600:\n380\t                _revert_inflight()\n381\t                return False, \"ttl_expired:{0:.0f}s\".format(age_seconds), None\n382\t        except Exception as exc:\n383\t            _revert_inflight()\n384\t            return False, \"verify_call_failed:{0}\".format(\n385\t                type(exc).__name__,\n386\t            ), None\n387\t\n388\t        return True, \"verified\", (\n389\t            md_path, asc_path, md_inflight, asc_inflight, sigref,\n390\t        )\n391\t\n392\t    def _consume_owner_cosign_sentinel(\n393\t        self,\n394\t        inflight_paths: Tuple[Path, Path, Path, Path, str],\n395\t    ) -> None:\n396\t        \"\"\"Gate #10b — CONSUME the verified .inflight sentinel pair.\"\"\"\n397\t        md_path, asc_path, md_inflight, asc_inflight, sigref = inflight_paths\n398\t        consumed_md = md_path.with_suffix(\n399\t            md_path.suffix + \".consumed-{0}\".format(sigref)\n400\t        )\n401\t        consumed_asc = asc_path.with_suffix(\n402\t            asc_path.suffix + \".consumed-{0}\".format(sigref)\n403\t        )\n404\t        try:\n405\t            os.rename(str(md_inflight), str(consumed_md))\n406\t        except OSError:\n407\t            return\n408\t        try:\n409\t            os.rename(str(asc_inflight), str(consumed_asc))\n410\t        except OSError:\n411\t            pass\n412\t\n413\t    def _parse_signed_at(self, md_text: str) -> Optional[float]:\n414\t        \"\"\"Parse a ``signed_at: <iso-8601>`` line from cleartext .md.\"\"\"\n415\t        for line in md_text.splitlines():\n416\t            line = line.strip()\n417\t            if not line.startswith(\"signed_at:\"):\n418\t                continue\n419\t            ts_raw = line.split(\":\", 1)[1].strip().strip('\"').strip(\"'\")\n420\t            if ts_raw.endswith(\"Z\"):\n421\t                ts_raw = ts_raw[:-1] + \"+00:00\"\n422\t            try:\n423\t                dt = _dt.datetime.fromisoformat(ts_raw)\n424\t                return dt.timestamp()\n425\t            except (ValueError, TypeError):\n426\t                return None\n427\t        return None\n428\t\n429\t    # -- Gate #9 — REAL rate-limit (Wave E; PLAN-112-FOLLOWUP W4) -------\n430\t\n431\t"}]},"parent_tool_use_id":null,"session_id":"f36400ef-26f6-4b31-b68a-075981f68fdb","uuid":"bcfa78f4-845c-4535-9e12-61296c66ba49","timestamp":"2026-11-13T17:37:34.751Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/federation/_server_parts/handler_write.py","content":"\"\"\"Declarations extracted from federation.server; loaded by the facade.\"\"\"\nfrom __future__ import annotations\n\nclass _HandlerWrite:\n    def _dispatch_write(self, method: str) -> None:\n        \"\"\"ADR-135-AMEND-1 §2.2 11-gate chain for write endpoints.\"\"\"\n        if _fed_scopes is None:\n            # Partial install — scopes module absent. Fail-CLOSED.\n            self._emit_write_blocked()\n            self._send_405()\n            return\n\n        raw_path = self.path or \"\"\n        path = raw_path.split(\"?\", 1)[0].split(\"#\", 1)[0]\n\n        # Gate #2 — resolve peer (also refreshes peer list per R-IT-B).\n        peer = self._resolve_peer()\n        if peer is None:\n            self._emit_connection_rejected(\"peer_unresolved\")\n            self._send_status(401, \"unauthorized\")\n            return\n\n        peers_extra = getattr(self.server, \"federation_peers_extra\", {}) or {}\n        extra = peers_extra.get(peer.peer_id, {}) if peers_extra else {}\n        peer_row = {\n            \"peer_id\": peer.peer_id,\n            \"peer_id_spki_fingerprint\": extra.get(\n                \"peer_id_spki_fingerprint\", \"\"\n            ),\n            \"peer_id_cert_fingerprint\": peer.peer_id_cert_fingerprint,\n            \"scopes\": list(extra.get(\"scopes\", [])),\n            \"audit_event_push_allowlist\": list(\n                extra.get(\"audit_event_push_allowlist\", [])\n            ),\n            \"revoked\": bool(extra.get(\"revoked\", peer.revoked)),\n        }\n\n        # GATE #3a — non-mutating timestamp-window preflight (R-SE-a).\n        pf_reason = self._replay_freshness_preflight(peer)\n        if pf_reason is not None:\n            _safe_emit(\n                \"federation_connection_replay_suspected\",\n                peer_id=peer.peer_id[:64],\n                reason=pf_reason[:64],\n                client_ip=self._client_ip(),\n            )\n            self._send_status(401, \"hmac_or_replay\")\n            return\n\n        # GATE #3b — body read (capped).\n        body = self._read_body_capped(max_bytes=1024 * 1024)\n        if body is None:\n            self._send_status(413, \"payload_too_large\")\n            return\n\n        # GATE #3c — HMAC signature verify (needs body, no mutation).\n        sig_reason = self._verify_signature_only(peer, body)\n        if sig_reason is not None:\n            _safe_emit(\n                \"federation_connection_replay_suspected\",\n                peer_id=peer.peer_id[:64],\n                reason=sig_reason[:64],\n                client_ip=self._client_ip(),\n            )\n            self._send_status(401, \"hmac_or_replay\")\n            return\n\n        # GATE #3d — MUTATING nonce commit (ONLY after HMAC passes).\n        nonce_reason = self._commit_nonce(peer)\n        if nonce_reason is not None:\n            _safe_emit(\n                \"federation_connection_replay_suspected\",\n                peer_id=peer.peer_id[:64],\n                reason=nonce_reason[:64],\n                client_ip=self._client_ip(),\n            )\n            self._send_status(401, \"hmac_or_replay\")\n            return\n\n        # GATE #4 — method + path → scope.\n        required_scope = _fed_scopes.route_required_scope(method, path)\n        if required_scope is None:\n            self._emit_write_blocked()\n            self._send_405()\n            return\n\n        # GATE #5 — X-CEO-Federation-Scope header presence + match.\n        if not _fed_scopes.validate_scope_header(self.headers, required_scope):\n            self._emit_scope_denied(peer.peer_id, path, required_scope, peer_row)\n            self._send_status(400, \"scope_header\")\n            return\n\n        # GATE #6 — peer's scopes list grants the required scope.\n        if not _fed_scopes.peer_has_scope(peer_row, required_scope):\n            self._emit_write_endpoint_denied(\n                peer.peer_id, path, gate_failed=6, reason_code=\"write_unauthorized\",\n            )\n            self._send_status(403, \"scope\")\n            return\n\n        # GATE #7 — peer not revoked (reloaded list per P0-1).\n        if peer_row.get(\"revoked\") is True:\n            self._emit_write_endpoint_denied(\n                peer.peer_id, path, gate_failed=7, reason_code=\"peer_revoked\",\n            )\n            self._send_status(403, \"revoked\")\n            return\n\n        # GATE #8 — write-enable sentinel valid (also enforced at 0a).\n        if not self._write_enable_sentinel_valid():\n            self._emit_write_disabled_sentinel_invalid(\"gpg_verify_failed\")\n            self._send_status(503, \"write_disabled\")\n            return\n\n        # GATE #9 — rate-limit (REAL — Wave E; default-DENY on exception).\n        ok, rl_reason = self._rate_limit_check(method, path, self.headers, peer_row)\n        if not ok:\n            self._emit_write_endpoint_denied(\n                peer.peer_id, path, gate_failed=9,\n                reason_code=(rl_reason or \"rate_limited\")[:32],\n            )\n            self._send_status(429, \"rate_limited\")\n            return\n\n        # GATE #10a — CLAIM + VERIFY (destructive routes; BEFORE handler).\n        cosign_inflight_paths = None\n        if _fed_scopes.is_destructive_route(method, path):\n            ok, reason, cosign_inflight_paths = self._verify_owner_cosign_claim(\n                method, path,\n            )\n            if not ok:\n                self._emit_write_endpoint_denied(\n                    peer.peer_id, path, gate_failed=10,\n                    reason_code=\"destructive_unauthz:{0}\".format(reason[:12]),\n                )\n                self._send_status(403, \"owner_cosign\")\n                return\n\n        # GATE #11 — handler executes.\n        # PLAN-112-FOLLOWUP P0 #1 + P1 #2 (Codex BLOCK): pass the\n        # SERVER-CONFIGURED state paths route-specifically so a non-default\n        # config mutates the RIGHT trust-root file (peers.yaml) and the\n        # tamper check inspects the SAME audit-log the handler appends to.\n        # Without this the handlers fall back to PEERS_FILE_DEFAULT /\n        # their own audit-log resolution and the revocation-propagation +\n        # T1565 claims become false.\n        handler = self._route_handler(method, path)\n        if handler is None:\n            self._send_405()\n            return\n        handler_kwargs = self._handler_state_kwargs(path)\n        try:\n            status, reason, response_body = handler.handle(\n                peer_row, self.headers, body, **handler_kwargs\n            )\n        except Exception as exc:\n            sys.stderr.write(\n                \"[federation.dispatch] handler crashed: {0}: {1}\\n\".format(\n                    type(exc).__name__, str(exc)[:200]\n                )\n            )\n            self._send_status(500, \"handler_crash\")\n            return\n\n        # GATE #10b — CONSUME (AFTER handler success only).\n        if cosign_inflight_paths is not None and status < 400:\n            self._consume_owner_cosign_sentinel(cosign_inflight_paths)\n\n        # POST-handler T1565 — audit-chain tamper detection (W4). We walk\n        # the SAME canonical audit-log the push handler just appended to\n        # (handler_kwargs[\"audit_log_path\"]) so the check is guaranteed to\n        # inspect the freshly-written record — F-7.10 critical detection\n        # must be REACHABLE, not merely plumbed.\n        if status < 400 and path in (\n            \"/federation/audit-event\", \"/federation/audit-event/batch\",\n        ):\n            self._maybe_check_audit_chain(\n                peer.peer_id, path, handler_kwargs.get(\"audit_log_path\"),\n            )\n\n        self._send_response_bytes(status, response_body)\n\n    def _resolve_audit_log_path(self) -> Optional[Path]:\n        \"\"\"Return the ONE canonical audit-log path (P0 #1).\n\n        Precedence: server-config ``audit_log_path`` → the audit handler's\n        own resolver (``CEO_AUDIT_LOG_PATH`` / platform default), so the\n        write handlers + the T1565 tamper check ALWAYS agree on the path.\n        \"\"\"\n        cfg = getattr(self.server, \"federation_config\", None)\n        path = getattr(self.server, \"federation_audit_log_path\", None)\n        if path is None and cfg is not None:\n            path = getattr(cfg, \"audit_log_path\", None)\n        if path is not None:\n            return Path(path)\n        # Mirror the handler's resolver so both sides land on the same file.\n        try:\n            try:\n                from .handlers import audit_event_push as _aep  # type: ignore\n            except ImportError:\n                import importlib\n                _aep = importlib.import_module(\n                    \"_lib.federation.handlers.audit_event_push\"\n                )\n            resolver = getattr(_aep, \"_resolve_audit_log_path\", None)\n            if resolver is not None:\n                return Path(resolver())\n        except Exception:\n            pass\n        return None\n\n    def _handler_state_kwargs(self, path: str) -> Dict[str, Any]:\n        \"\"\"Route-specific server-state kwargs for the gate-#11 handler.\n\n        P1 #2: peer_register/peer_revoke get the configured ``peers_path``\n        (NOT PEERS_FILE_DEFAULT). P0 #1: audit-event push/batch get the ONE\n        canonical ``audit_log_path``. Only paths that the target handler's\n        ``handle(...)`` accepts are passed (kwargs are route-matched).\n        \"\"\"\n        cfg = getattr(self.server, \"federation_config\", None)\n        if path in (\"/federation/peer-register\", \"/federation/peer-revoke\"):\n            peers_path = getattr(self.server, \"federation_peers_path\", None)\n            if peers_path is None and cfg is not None:\n                peers_path = getattr(cfg, \"peers_path\", None)\n            if peers_path is not None:\n                return {\"peers_path\": Path(peers_path)}\n            return {}\n        if path in (\n            \"/federation/audit-event\", \"/federation/audit-event/batch\",\n        ):\n            log_path = self._resolve_audit_log_path()\n            if log_path is not None:\n                return {\"audit_log_path\": log_path}\n            return {}\n        return {}\n\n    def _route_handler(self, method: str, path: str):\n        \"\"\"Map (method, path) → handler module.\"\"\"\n        key = (method.upper(), path)\n        if key == (\"POST\", \"/federation/peer-register\"):\n            return _h_peer_register\n        if key == (\"POST\", \"/federation/audit-event\"):\n            return _h_audit_event_push\n        if key == (\"POST\", \"/federation/audit-event/batch\"):\n            return _h_audit_event_batch\n        if key == (\"POST\", \"/federation/peer-revoke\"):\n            return _h_peer_revoke\n        return None\n\n    # -- Gate #8 — write-enable sentinel verify ------------------------\n\n    def _write_enable_sentinel_valid(self) -> bool:\n        \"\"\"Gate #8 / Layer 0b — verify the write-enable sentinel pair.\n\n        Fail-CLOSED on any error. No caching (ADR-121 §6 v1.x no-cache).\n        \"\"\"\n        cfg = getattr(self.server, \"federation_config\", None)\n        signed_path = getattr(self.server, \"write_enabled_sentinel\", None)\n        if signed_path is None and cfg is not None:\n            signed_path = getattr(cfg, \"write_enabled_sentinel\", None)\n        if signed_path is None:\n            signed_path = Path(\".claude/data/federation/write-enabled.md\")\n        signed_path = Path(signed_path)\n\n        sig_path = getattr(self.server, \"write_enabled_sentinel_asc\", None)\n        if sig_path is None and cfg is not None:\n            sig_path = getattr(cfg, \"write_enabled_sentinel_asc\", None)\n        if sig_path is None:\n            sig_path = Path(str(signed_path) + \".asc\")\n        sig_path = Path(sig_path)\n\n        if not signed_path.exists() or not sig_path.exists():\n            return False\n\n        try:\n            owner_fpr = getattr(self.server, \"owner_fpr\", OWNER_GPG_FPR)\n            registry_path = getattr(self.server, \"signer_registry_path\", None)\n            if registry_path is None and cfg is not None:\n                registry_path = getattr(cfg, \"signer_registry_path\", None)\n            ok, _reason = verify_enable_sentinel_pair(\n                signed_path,\n                sig_path,\n                [owner_fpr],\n                signer_registry_path=registry_path,\n            )\n        except Exception:\n            return False\n        return bool(ok)\n\n    # -- Gate #10 — Owner co-sign claim / consume (split TOCTOU) --------\n\n    def _verify_owner_cosign_claim(\n        self, method: str, path: str,\n    ) -> Tuple[bool, str, Optional[Tuple[Path, Path, Path, Path, str]]]:\n        \"\"\"Gate #10a — CLAIM + VERIFY per-request Owner-co-sign sentinel.\"\"\"\n        sigref = \"\"\n        for k, v in self.headers.items():\n            if isinstance(k, str) and k.lower() == \"x-ceo-owner-sigref\":\n                sigref = str(v) if isinstance(v, str) else \"\"\n                break\n        if not sigref:\n            return False, \"missing_header:x_ceo_owner_sigref\", None\n        if not re.match(r\"^[A-Za-z0-9_-]{1,64}$\", sigref):\n            return False, \"sigref_charset\", None\n\n        cfg = getattr(self.server, \"federation_config\", None)\n        base = getattr(self.server, \"federation_sentinels_dir\", None)\n        if base is None and cfg is not None:\n            base = getattr(cfg, \"federation_sentinels_dir\", None)\n        if base is None:\n            base = Path(\".claude/data/federation/sentinels\")\n        base_dir = Path(base) / sigref\n        md_path = base_dir / \"approval.md\"\n        asc_path = base_dir / \"approval.md.asc\"\n\n        if not md_path.exists() or not asc_path.exists():\n            return False, \"sentinel_not_found\", None\n\n        md_inflight = md_path.with_suffix(md_path.suffix + \".inflight\")\n        try:\n            os.rename(str(md_path), str(md_inflight))\n        except OSError:\n            return False, \"sentinel_inflight_collision\", None\n\n        asc_inflight = asc_path.with_suffix(asc_path.suffix + \".inflight\")\n        try:\n            os.rename(str(asc_path), str(asc_inflight))\n        except OSError:\n            try:\n                os.rename(str(md_inflight), str(md_path))\n            except OSError:\n                pass\n            return False, \"sentinel_asc_claim_failed\", None\n\n        # PLAN-112-FOLLOWUP P2 #4 (Codex BLOCK): every failure path AFTER\n        # both files are renamed to .inflight (verify failure, read failure,\n        # missing signed_at, TTL expiry, unexpected exception) must REVERT\n        # the .inflight pair to its original names — best-effort — so the\n        # sentinel is NOT left stuck. The sentinel was NOT consumed (verify\n        # failed), so reverting is correct: it restores the recoverable\n        # pre-claim state. The 5-min reaper (REMAINING) is the backstop for\n        # the residual crash-between-rename window only.\n        def _revert_inflight() -> None:\n            try:\n                if md_inflight.exists() and not md_path.exists():\n                    os.rename(str(md_inflight), str(md_path))\n            except OSError:\n                pass\n            try:\n                if asc_inflight.exists() and not asc_path.exists():\n                    os.rename(str(asc_inflight), str(asc_path))\n            except OSError:\n                pass\n\n        try:\n            owner_fpr = getattr(self.server, \"owner_fpr\", OWNER_GPG_FPR)\n            registry_path = getattr(self.server, \"signer_registry_path\", None)\n            if registry_path is None and cfg is not None:\n                registry_path = getattr(cfg, \"signer_registry_path\", None)\n            ok, reason = verify_enable_sentinel_pair(\n                md_inflight, asc_inflight, [owner_fpr],\n                signer_registry_path=registry_path,\n            )\n            if not ok:\n                _revert_inflight()\n                return False, \"verify_failed:{0}\".format(reason[:64]), None\n            try:\n                md_text = md_inflight.read_text(encoding=\"utf-8\")\n            except OSError as exc:\n                _revert_inflight()\n                return False, \"read_md_failed:{0}\".format(\n                    exc.errno or \"unknown\",\n                ), None\n            signed_at = self._parse_signed_at(md_text)\n            if signed_at is None:\n                _revert_inflight()\n                return False, \"missing_signed_at\", None\n            age_seconds = time.time() - signed_at\n            if age_seconds > 24 * 3600:\n                _revert_inflight()\n                return False, \"ttl_expired:{0:.0f}s\".format(age_seconds), None\n        except Exception as exc:\n            _revert_inflight()\n            return False, \"verify_call_failed:{0}\".format(\n                type(exc).__name__,\n            ), None\n\n        return True, \"verified\", (\n            md_path, asc_path, md_inflight, asc_inflight, sigref,\n        )\n\n    def _consume_owner_cosign_sentinel(\n        self,\n        inflight_paths: Tuple[Path, Path, Path, Path, str],\n    ) -> None:\n        \"\"\"Gate #10b — CONSUME the verified .inflight sentinel pair.\"\"\"\n        md_path, asc_path, md_inflight, asc_inflight, sigref = inflight_paths\n        consumed_md = md_path.with_suffix(\n            md_path.suffix + \".consumed-{0}\".format(sigref)\n        )\n        consumed_asc = asc_path.with_suffix(\n            asc_path.suffix + \".consumed-{0}\".format(sigref)\n        )\n        try:\n            os.rename(str(md_inflight), str(consumed_md))\n        except OSError:\n            return\n        try:\n            os.rename(str(asc_inflight), str(consumed_asc))\n        except OSError:\n            pass\n\n    def _parse_signed_at(self, md_text: str) -> Optional[float]:\n        \"\"\"Parse a ``signed_at: <iso-8601>`` line from cleartext .md.\"\"\"\n        for line in md_text.splitlines():\n            line = line.strip()\n            if not line.startswith(\"signed_at:\"):\n                continue\n            ts_raw = line.split(\":\", 1)[1].strip().strip('\"').strip(\"'\")\n            if ts_raw.endswith(\"Z\"):\n                ts_raw = ts_raw[:-1] + \"+00:00\"\n            try:\n                dt = _dt.datetime.fromisoformat(ts_raw)\n                return dt.timestamp()\n            except (ValueError, TypeError):\n                return None\n        return None\n\n    # -- Gate #9 — REAL rate-limit (Wave E; PLAN-112-FOLLOWUP W4) -------\n\n","numLines":431,"startLine":1,"totalLines":431}},"tool_result_meta":[{"id":"toolu_01Av3R7PpuHMuTjnUuZZpZKZ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
