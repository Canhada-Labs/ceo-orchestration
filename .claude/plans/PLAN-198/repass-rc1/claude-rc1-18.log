{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018qtGvnyZiGzLo9XjiBMXFS","type":"tool_result","content":"470\t# _snippet calls must NOT re-enter the redaction sweep. Hooks execute as\n471\t# single-threaded subprocesses, so a module global is race-free here.\n472\t_IN_SNIPPET_REDACT = False\n473\t\n474\t\n475\tdef _snippet(text: str, start: int, end: int) -> str:\n476\t    \"\"\"Short surrounding snippet for the audit preview, honoring the\n477\t    ``Match.snippet`` \"redacted / preview-safe\" contract (PLAN-152\n478\t    error-handling-02).\n479\t\n480\t    Two masking layers:\n481\t    1. THIS match's span is replaced by ``[MASKED:n]``.\n482\t    2. The surrounding context is swept with the module's own family\n483\t       finders + entropy step and every hit is ``[REDACTED:FAMILY]``-ed\n484\t       (Codex pair-rail P1: an ADJACENT secret inside the snippet radius\n485\t       previously leaked in cleartext context).\n486\t    Fail-safe: if the context sweep raises, the snippet degrades to the\n487\t    bare mask — never the raw context.\n488\t    \"\"\"\n489\t    global _IN_SNIPPET_REDACT\n490\t    s = max(0, start - _SNIPPET_RADIUS)\n491\t    e = min(len(text), end + _SNIPPET_RADIUS)\n492\t    masked = \"[MASKED:%d]\" % max(0, end - start)\n493\t    chunk = text[s:start] + masked + text[end:e]\n494\t    if not _IN_SNIPPET_REDACT:\n495\t        _IN_SNIPPET_REDACT = True\n496\t        try:\n497\t            others: List[Match] = []\n498\t            for finder in (\n499\t                _find_api_key_matches, _find_jwt_matches,\n500\t                _find_bearer_matches, _find_cpf_cnpj_matches,\n501\t                _find_rg_matches, _find_cnh_matches,\n502\t                _find_pis_pasep_matches, _find_passport_br_matches,\n503\t                _find_iban_br_matches, _find_credit_card_matches,\n504\t                _find_email_matches,\n505\t            ):\n506\t                others.extend(finder(chunk))\n507\t            others.extend(_find_entropy_matches(chunk, others))\n508\t            chunk = _apply_redactions(chunk, others)\n509\t        except Exception:\n510\t            chunk = masked\n511\t        finally:\n512\t            _IN_SNIPPET_REDACT = False\n513\t    chunk = chunk.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n514\t    return chunk.strip()[:200]\n515\t\n516\t\n517\tdef _find_api_key_matches(text: str) -> List[Match]:\n518\t    out: List[Match] = []\n519\t    for regex in _API_KEY_RE:\n520\t        for m in regex.finditer(text):\n521\t            out.append(\n522\t                Match(\n523\t                    family=\"api_key\",\n524\t                    start=m.start(),\n525\t                    end=m.end(),\n526\t                    snippet=_snippet(text, m.start(), m.end()),\n527\t                )\n528\t            )\n529\t    return out"}]},"parent_tool_use_id":null,"session_id":"f36400ef-26f6-4b31-b68a-075981f68fdb","uuid":"6cd8387f-bd36-428c-807a-c5710ac6a925","timestamp":"2026-11-13T17:40:44.091Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/pii_patterns.py","content":"# _snippet calls must NOT re-enter the redaction sweep. Hooks execute as\n# single-threaded subprocesses, so a module global is race-free here.\n_IN_SNIPPET_REDACT = False\n\n\ndef _snippet(text: str, start: int, end: int) -> str:\n    \"\"\"Short surrounding snippet for the audit preview, honoring the\n    ``Match.snippet`` \"redacted / preview-safe\" contract (PLAN-152\n    error-handling-02).\n\n    Two masking layers:\n    1. THIS match's span is replaced by ``[MASKED:n]``.\n    2. The surrounding context is swept with the module's own family\n       finders + entropy step and every hit is ``[REDACTED:FAMILY]``-ed\n       (Codex pair-rail P1: an ADJACENT secret inside the snippet radius\n       previously leaked in cleartext context).\n    Fail-safe: if the context sweep raises, the snippet degrades to the\n    bare mask — never the raw context.\n    \"\"\"\n    global _IN_SNIPPET_REDACT\n    s = max(0, start - _SNIPPET_RADIUS)\n    e = min(len(text), end + _SNIPPET_RADIUS)\n    masked = \"[MASKED:%d]\" % max(0, end - start)\n    chunk = text[s:start] + masked + text[end:e]\n    if not _IN_SNIPPET_REDACT:\n        _IN_SNIPPET_REDACT = True\n        try:\n            others: List[Match] = []\n            for finder in (\n                _find_api_key_matches, _find_jwt_matches,\n                _find_bearer_matches, _find_cpf_cnpj_matches,\n                _find_rg_matches, _find_cnh_matches,\n                _find_pis_pasep_matches, _find_passport_br_matches,\n                _find_iban_br_matches, _find_credit_card_matches,\n                _find_email_matches,\n            ):\n                others.extend(finder(chunk))\n            others.extend(_find_entropy_matches(chunk, others))\n            chunk = _apply_redactions(chunk, others)\n        except Exception:\n            chunk = masked\n        finally:\n            _IN_SNIPPET_REDACT = False\n    chunk = chunk.replace(\"\\n\", \" \").replace(\"\\r\", \" \")\n    return chunk.strip()[:200]\n\n\ndef _find_api_key_matches(text: str) -> List[Match]:\n    out: List[Match] = []\n    for regex in _API_KEY_RE:\n        for m in regex.finditer(text):\n            out.append(\n                Match(\n                    family=\"api_key\",\n                    start=m.start(),\n                    end=m.end(),\n                    snippet=_snippet(text, m.start(), m.end()),\n                )\n            )\n    return out","numLines":60,"startLine":470,"totalLines":898}},"tool_result_meta":[{"id":"toolu_018qtGvnyZiGzLo9XjiBMXFS","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
