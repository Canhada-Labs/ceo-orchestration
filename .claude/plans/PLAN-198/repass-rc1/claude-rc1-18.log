{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kp5JMDyu534Un7iLM7ceAw","type":"tool_result","content":"30\t\n31\tAdvisory + read-only: never writes any file. Stdlib-only. Python >= 3.9.\n32\t\"\"\"\n33\t\n34\tfrom __future__ import annotations\n35\t\n36\timport argparse\n37\timport json\n38\timport re\n39\timport sys\n40\tfrom pathlib import Path\n41\tfrom typing import List, Optional, Tuple\n42\t\n43\tREPO_ROOT = Path(__file__).resolve().parents[2]\n44\tDEFAULT_ADR = REPO_ROOT / \".claude\" / \"adr\" / \"ADR-149-model-id-allowlist.md\"\n45\tDEFAULT_SETTINGS = REPO_ROOT / \".claude\" / \"settings.json\"\n46\t\n47\tsys.path.insert(0, str(REPO_ROOT / \".claude\" / \"hooks\"))\n48\ttry:\n49\t    from _lib.model_currency import availability_entries  # noqa: E402\n50\texcept ImportError:\n51\t    availability_entries = lambda ids: list(ids)  # type: ignore[assignment]\n52\t\n53\tWORKING_SET_TOKEN = \"AVAILABLE_MODELS_WORKING_SET\"\n54\tMODEL_FAMILY_POLICY = 'MODEL_FAMILY_POLICY = \"semantic-families-v1\"'\n55\t_POLICY_FENCE_RE = re.compile(\n56\t    r\"```python\\s*\\n(?:(?!```)[\\s\\S])*?^MODEL_FAMILY_POLICY = \\\"semantic-families-v1\\\"\\s*$\",\n57\t    re.MULTILINE,\n58\t)\n59\tVETO_FLOOR_TOKEN = \"VETO_FLOOR_ALLOWED\"\n60\tFALLBACK_CHAIN_MAX = 3  # documented harness cap (model-config: \"capped at three\")\n61\t\n62\t# Model-id / alias shape: claude-opus-4-8, claude-fable-5, sonnet, opus[1m], ...\n63\t_ID_RE = re.compile(r'\"([A-Za-z0-9][A-Za-z0-9._\\[\\]-]*)\"')\n64\t\n65\t\n66\tdef _extract_block_ids(adr_text: str, token: str) -> Optional[List[str]]:\n67\t    \"\"\"Return the quoted ids inside the ``token = (...)`` / ``{...}`` block.\n68\t\n69\t    Tolerant of frozenset({...}) and tuple (...) literals, comments, and\n70\t    trailing commas. Returns None when the token is absent; [] only when the\n71\t    block exists but carries no quoted ids (treated as infra error upstream).\n72\t    \"\"\"\n73\t    idx = adr_text.find(token)\n74\t    if idx < 0:\n75\t        return None\n76\t    # Find the first opening bracket after the token, then scan to its match.\n77\t    open_idx = -1\n78\t    open_ch = \"\"\n79\t    for i in range(idx, min(len(adr_text), idx + 200)):\n80\t        if adr_text[i] in \"({\":\n81\t            open_idx = i\n82\t            open_ch = adr_text[i]\n83\t            break\n84\t    if open_idx < 0:\n85\t        return []\n86\t    close_ch = \")\" if open_ch == \"(\" else \"}\"\n87\t    depth = 0\n88\t    end_idx = -1\n89\t    for i in range(open_idx, len(adr_text)):\n90\t        ch = adr_text[i]\n91\t        if ch == open_ch:\n92\t            depth += 1\n93\t        elif ch == close_ch:\n94\t            depth -= 1\n95\t            if depth == 0:\n96\t                end_idx = i\n97\t                break\n98\t    if end_idx < 0:\n99\t        return []\n100\t    block = adr_text[open_idx : end_idx + 1]\n101\t    seen = set()\n102\t    ids: List[str] = []\n103\t    for match in _ID_RE.finditer(block):\n104\t        mid = match.group(1)\n105\t        if mid not in seen:\n106\t            seen.add(mid)\n107\t            ids.append(mid)\n108\t    return ids\n109\t\n110\t\n111\tdef parse_working_set(adr_path: Path) -> Tuple[List[str], str]:\n112\t    \"\"\"Parse the ADR; return (ids, source) where source is the block used.\"\"\"\n113\t    try:\n114\t        text = adr_path.read_text(encoding=\"utf-8\")\n115\t    except OSError as exc:\n116\t        raise RuntimeError(\"cannot read ADR at {}: {}\".format(adr_path, exc))\n117\t    ids = _extract_block_ids(text, WORKING_SET_TOKEN)\n118\t    if ids:\n119\t        if _POLICY_FENCE_RE.search(text):\n120\t            return availability_entries(ids), WORKING_SET_TOKEN\n121\t        return ids, WORKING_SET_TOKEN\n122\t    fallback = _extract_block_ids(text, VETO_FLOOR_TOKEN)\n123\t    if fallback:\n124\t        sys.stderr.write(\n125\t            \"[generate-available-models] NOTE: ADR-149 Amendment 1 \"\n126\t            \"({}) not found in {} — falling back to the base {} members \"\n127\t            \"(pre-amendment state; the working-set block lands at the \"\n128\t            \"PLAN-135 W1 Owner ceremony).\\n\".format(\n129\t                WORKING_SET_TOKEN, adr_path, VETO_FLOOR_TOKEN\n130\t            )\n131\t        )\n132\t        return fallback, VETO_FLOOR_TOKEN\n133\t    raise RuntimeError(\n134\t        \"no parseable {} or {} block in {}\".format(\n135\t            WORKING_SET_TOKEN, VETO_FLOOR_TOKEN, adr_path\n136\t        )\n137\t    )\n138\t\n139\t\n140\tdef _load_json(path: Path) -> dict:\n141\t    try:\n142\t        return json.loads(path.read_text(encoding=\"utf-8\"))\n143\t    except OSError as exc:\n144\t        raise RuntimeError(\"cannot read settings at {}: {}\".format(path, exc))\n145\t    except ValueError as exc:\n146\t        raise RuntimeError(\"settings file {} is not valid JSON: {}\".format(path, exc))\n147\t\n148\t\n149\tdef resolve_settings(settings_path: Path) -> Tuple[Optional[List[str]], Optional[List[str]]]:\n150\t    \"\"\"Resolve (availableModels, fallbackModel) across project + local layers.\n151\t\n152\t    Mimics the documented harness semantics for the two repo-scope layers:\n153\t    - availableModels: arrays MERGE + dedupe (project order first, then any\n154\t      local additions) — a local layer can only ADD, which --check flags.\n155\t    - fallbackModel: NO merge — the highest-precedence layer that defines it\n156\t      supplies the entire chain (local wins over project).\n157\t    User-level and managed layers are outside repo scope (honest boundary,\n158\t    ADR-149 Amendment 1 §A1.4).\n159\t    \"\"\""}]},"parent_tool_use_id":null,"session_id":"99e4484c-9fd2-48bc-96cb-ca1217c6fa39","uuid":"336e990d-80d3-4656-854d-08956fe21ed2","timestamp":"2026-11-15T10:33:50.551Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/scripts/generate-available-models.py","content":"\nAdvisory + read-only: never writes any file. Stdlib-only. Python >= 3.9.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import List, Optional, Tuple\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nDEFAULT_ADR = REPO_ROOT / \".claude\" / \"adr\" / \"ADR-149-model-id-allowlist.md\"\nDEFAULT_SETTINGS = REPO_ROOT / \".claude\" / \"settings.json\"\n\nsys.path.insert(0, str(REPO_ROOT / \".claude\" / \"hooks\"))\ntry:\n    from _lib.model_currency import availability_entries  # noqa: E402\nexcept ImportError:\n    availability_entries = lambda ids: list(ids)  # type: ignore[assignment]\n\nWORKING_SET_TOKEN = \"AVAILABLE_MODELS_WORKING_SET\"\nMODEL_FAMILY_POLICY = 'MODEL_FAMILY_POLICY = \"semantic-families-v1\"'\n_POLICY_FENCE_RE = re.compile(\n    r\"```python\\s*\\n(?:(?!```)[\\s\\S])*?^MODEL_FAMILY_POLICY = \\\"semantic-families-v1\\\"\\s*$\",\n    re.MULTILINE,\n)\nVETO_FLOOR_TOKEN = \"VETO_FLOOR_ALLOWED\"\nFALLBACK_CHAIN_MAX = 3  # documented harness cap (model-config: \"capped at three\")\n\n# Model-id / alias shape: claude-opus-4-8, claude-fable-5, sonnet, opus[1m], ...\n_ID_RE = re.compile(r'\"([A-Za-z0-9][A-Za-z0-9._\\[\\]-]*)\"')\n\n\ndef _extract_block_ids(adr_text: str, token: str) -> Optional[List[str]]:\n    \"\"\"Return the quoted ids inside the ``token = (...)`` / ``{...}`` block.\n\n    Tolerant of frozenset({...}) and tuple (...) literals, comments, and\n    trailing commas. Returns None when the token is absent; [] only when the\n    block exists but carries no quoted ids (treated as infra error upstream).\n    \"\"\"\n    idx = adr_text.find(token)\n    if idx < 0:\n        return None\n    # Find the first opening bracket after the token, then scan to its match.\n    open_idx = -1\n    open_ch = \"\"\n    for i in range(idx, min(len(adr_text), idx + 200)):\n        if adr_text[i] in \"({\":\n            open_idx = i\n            open_ch = adr_text[i]\n            break\n    if open_idx < 0:\n        return []\n    close_ch = \")\" if open_ch == \"(\" else \"}\"\n    depth = 0\n    end_idx = -1\n    for i in range(open_idx, len(adr_text)):\n        ch = adr_text[i]\n        if ch == open_ch:\n            depth += 1\n        elif ch == close_ch:\n            depth -= 1\n            if depth == 0:\n                end_idx = i\n                break\n    if end_idx < 0:\n        return []\n    block = adr_text[open_idx : end_idx + 1]\n    seen = set()\n    ids: List[str] = []\n    for match in _ID_RE.finditer(block):\n        mid = match.group(1)\n        if mid not in seen:\n            seen.add(mid)\n            ids.append(mid)\n    return ids\n\n\ndef parse_working_set(adr_path: Path) -> Tuple[List[str], str]:\n    \"\"\"Parse the ADR; return (ids, source) where source is the block used.\"\"\"\n    try:\n        text = adr_path.read_text(encoding=\"utf-8\")\n    except OSError as exc:\n        raise RuntimeError(\"cannot read ADR at {}: {}\".format(adr_path, exc))\n    ids = _extract_block_ids(text, WORKING_SET_TOKEN)\n    if ids:\n        if _POLICY_FENCE_RE.search(text):\n            return availability_entries(ids), WORKING_SET_TOKEN\n        return ids, WORKING_SET_TOKEN\n    fallback = _extract_block_ids(text, VETO_FLOOR_TOKEN)\n    if fallback:\n        sys.stderr.write(\n            \"[generate-available-models] NOTE: ADR-149 Amendment 1 \"\n            \"({}) not found in {} — falling back to the base {} members \"\n            \"(pre-amendment state; the working-set block lands at the \"\n            \"PLAN-135 W1 Owner ceremony).\\n\".format(\n                WORKING_SET_TOKEN, adr_path, VETO_FLOOR_TOKEN\n            )\n        )\n        return fallback, VETO_FLOOR_TOKEN\n    raise RuntimeError(\n        \"no parseable {} or {} block in {}\".format(\n            WORKING_SET_TOKEN, VETO_FLOOR_TOKEN, adr_path\n        )\n    )\n\n\ndef _load_json(path: Path) -> dict:\n    try:\n        return json.loads(path.read_text(encoding=\"utf-8\"))\n    except OSError as exc:\n        raise RuntimeError(\"cannot read settings at {}: {}\".format(path, exc))\n    except ValueError as exc:\n        raise RuntimeError(\"settings file {} is not valid JSON: {}\".format(path, exc))\n\n\ndef resolve_settings(settings_path: Path) -> Tuple[Optional[List[str]], Optional[List[str]]]:\n    \"\"\"Resolve (availableModels, fallbackModel) across project + local layers.\n\n    Mimics the documented harness semantics for the two repo-scope layers:\n    - availableModels: arrays MERGE + dedupe (project order first, then any\n      local additions) — a local layer can only ADD, which --check flags.\n    - fallbackModel: NO merge — the highest-precedence layer that defines it\n      supplies the entire chain (local wins over project).\n    User-level and managed layers are outside repo scope (honest boundary,\n    ADR-149 Amendment 1 §A1.4).\n    \"\"\"","numLines":130,"startLine":30,"totalLines":294}},"tool_result_meta":[{"id":"toolu_01Kp5JMDyu534Un7iLM7ceAw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4Zbi8GgYCteJ8Byj1p3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01XzxdSiDUbCHJLBgCYhaBBv","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/templates/settings/settings.base.json","offset":620,"limit":30},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5104,"cache_read_input_tokens":158707,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5104},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"99e4484c-9fd2-48bc-96cb-ca1217c6fa39","uuid":"4870e94f-acab-47bb-b9da-13f552940d47","timestamp":"2026-11-15T10:33:52.634Z","request_id":"req_011Ch4Zbhw7X9hwpwHViLNMs","wire_tool_inputs":{"toolu_01XzxdSiDUbCHJLBgCYhaBBv":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/templates/settings/settings.base.json","offset":620,"limit":30}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XzxdSiDUbCHJLBgCYhaBBv","type":"tool_result","content":"620\t  \"env\": {\n621\t    \"CEO_QUIET_MODE\": \"1\",\n622\t    \"CLAUDE_CODE_SUBAGENT_MODEL\": \"inherit\",\n623\t    \"CLAUDE_CODE_SUBPROCESS_ENV_SCRUB\": \"1\",\n624\t    \"BASH_MAX_TIMEOUT_MS\": \"600000\",\n625\t    \"CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR\": \"1\",\n626\t    \"ENABLE_TOOL_SEARCH\": \"auto\"\n627\t  },\n628\t  \"_model_pin_comment\": \"PLAN-163 T1.1 contingency (ADR-181 §Contingency) — session-default pin. CC 2.1.220 honors the top-level settings key \\\"model\\\" (zod: E.string().optional(); describe \\\"Override the default model used by Claude Code\\\"; source at 2.1.220 binary offset [REDACTED:rg], sha256 8addc857..., between \\\"permissions\\\" and \\\"fallbackModel\\\"). Pinned to claude-opus-5-5 since ADR-149 Amendment 3 (S357; Claude Opus 5.5 needs Claude Code >= 2.1.280). ADR-181 first pinned claude-opus-5 so that adding claude-sonnet-5 to availableModels could not silently flip the session default to the 2.1.220 sonnet-5 tier-default (enforceAvailableModels stops redirecting once sonnet-5 is allowed); claude-opus-5 stays the fallbackModel. ADOPTER NOTE: a fresh install therefore inherits claude-opus-5-5 as the session default (Opus 5.5 pricing $4/$20 per MTok). If that is not desired for your workload, override the value here (e.g. \\\"claude-sonnet-5\\\" or your tier default) or set env ANTHROPIC_MODEL / pass CLI --model per-session; the pinned value must be one that availableModels below admits: Claude Code replaces a pin the allowlist does not admit with the default model at startup (with a warning), and admits an id that extends an allowed entry by a - segment. scripts/upgrade.sh is stricter: it writes a new framework pin into an existing install only when that pin is an EXACT entry of its availableModels, and warns otherwise. Keep this key mirrored with .claude/settings.json in the framework repo (SessionDefaultPinTest).\",\n629\t  \"model\": \"claude-opus-5-5\",\n630\t  \"availableModels\": [\n631\t    \"claude-opus-4-8\",\n632\t    \"claude-fable-5\",\n633\t    \"claude-sonnet-4-6\",\n634\t    \"claude-haiku-4-5\",\n635\t    \"claude-opus-5\",\n636\t    \"claude-sonnet-5\",\n637\t    \"claude-fable-5-1\",\n638\t    \"claude-opus-5-5\"\n639\t  ],\n640\t  \"fallbackModel\": [\n641\t    \"claude-opus-5\"\n642\t  ],\n643\t  \"_effort_level_comment\": \"PLAN-193 / ADR-149 Amendment 3 (Owner decisions S357: OQ-1 = xhigh, OQ-7 = new install + opt-in, OQ-8 = the pin migration writes high). Top-level effortLevel: in PROJECT settings it applies to every model the session uses and outranks a level a developer saved with /effort (Claude Code keeps those per model under modelSettings in user settings); a level set in .claude/settings.local.json outranks this file. Claude Opus 5.5 (the model pin above) runs at its default MEDIUM effort when no level is set, a default that an organization default effort replaces when the session runs the organization default model; Opus 5 and Fable 5 default to high. A maxEffortLevel caps any level, this one included. The key takes low, medium, high or xhigh; max is not one of its values, and Claude Code before 2.1.111 has no xhigh (this release needs 2.1.280, SUPPORT.md). New installs ship xhigh. On an existing install scripts/upgrade.sh writes xhigh only when you pass --adopt-setting effortLevel; when it moves the shipped pin claude-opus-5 to claude-opus-5-5 in a file that sets no level it writes high, the Opus 5 default; it never overwrites a value you set. Lower or delete the key to trade depth for cost and latency.\",\n644\t  \"effortLevel\": \"xhigh\",\n645\t  \"_posture_keys_comment\": \"PLAN-163 T5.3/OQ5 — fail-closed posture keys (CC >=2.1.220). Key (1) permissions.defaultMode ships LIVE below (see _default_mode_arbitration_comment); the REMAINING keys ship COMMENTED for adopters. Dogfood status (2026-08-03): the framework repo enables workflowSizeGuideline and the sandbox keys; disableAutoMode was REMOVED from the dogfood settings by Owner decision (ceremony [SENT-PLAN165]) — beyond the documented no-mid-session-escalation effect it also strips 'auto' from the operator's native shift+tab mode cycle, and choosing the session mode is the operator's call, not the framework's. Adopters may still opt in. To adopt, add the keys literally: (2) top-level \\\"disableAutoMode\\\": \\\"disable\\\" — string enum whose sole value is 'disable' (the 2.1.220 schema rejects a boolean and SKIPS THE WHOLE settings file on mismatch — S286 live-fire); prevents automatic permission-mode escalation mid-session. (3) top-level \\\"workflowSizeGuideline\\\": <per your workflow scale; advisory sizing guideline for Workflow-tool fan-outs>. (4) \\\"sandbox\\\": { \\\"network\\\": { \\\"strictAllowlist\\\": true } } — tightens allowedDomains matching to the strict form. (5) \\\"sandbox\\\": { \\\"filesystem\\\": { \\\"disabled\\\": false } } — keeps filesystem confinement armed when the sandbox is enabled (true would fail-OPEN the FS layer). All keys are independent and additive; rollback is deleting the key. NEW-EVENT hook registrations (DirectoryAdded/Notification) are deliberately NOT in this template yet — T3.4 version-floor feature gate (upgrade.sh, default OFF), ADR-183 residual (e); this template stays at 45 registrations until the floor probe is recorded. This block is documentation only — underscore-prefixed keys are ignored by the harness.\",\n646\t  \"_default_mode_arbitration_comment\": \"PLAN-163 T3.5/T5.3 ARBITRATION (CEO S284, ADR-183): permissions.defaultMode='manual' is a LIVE key in this template, not a commented posture option. Rationale: install.sh copies this file verbatim on a fresh install, and the U1 post-install oracle (test_upgrade_settings_migration.py TestU1TemplateParity) asserts the template already carries the T5.4 NEW baseline (defaultMode='manual', the 2.1.2xx rename of the ask-first permission mode — every non-allowlisted tool call prompts) — a commented-only defaultMode would red U1 and ship fresh installs on the OLD 'default' posture. Rollback: delete the defaultMode key (single-line revert; no hook consumes it — harness-level only).\",\n647\t  \"_night_mode_deny_surface_comment\": \"PLAN-165 P1-corrected (D2 + round-2 findings NM-01/NM-03 + codex CX-1) — under defaultMode=acceptEdits a tool Edit/Write is auto-accepted, so every file that can DECIDE the next session's posture is deny-listed: (1) .claude/settings.local.json, the per-machine overlay (gitignored) that decides the NEXT session's permission posture; (2) .claude/state/night-mode.json, the night-mode marker/snapshot whose prev_value is restored into the overlay by night-mode off — a posture write BY PROXY (NM-01); (3) .claude/scripts/night-mode.py, the single sanctioned writer itself (NM-03). HONEST SCOPE (CX-1): per-TOOL deny entries close only the Edit/Write rail; the Bash rail is closed by _CANONICAL_GUARDS in check_canonical_edit.py (all three paths listed) + kernel-tier listing of the two state files. The script writes as a PROCESS, never via the Edit/Write tools, so the deny costs no legitimate path. The Write() twins were REMOVED in S292: the current harness (>=2.1.216) does NOT consult Write(path) rules in its file-permission check (the CLI emits an active warning for such rules) and the Edit(path) entries cover ALL file-editing tools — the same class PLAN-161 C1 removed from the credential-read baseline; the old-CLI residual documented there is now accepted for the posture files too, with the real defense on the _CANONICAL_GUARDS/kernel rails (CX-1). Mirrors .claude/settings.json in the framework repo (dogfood parity) — the three entries are byte-identical in both files.\",\n648\t  \"permissions\": {\n649\t    \"defaultMode\": \"manual\","}]},"parent_tool_use_id":null,"session_id":"99e4484c-9fd2-48bc-96cb-ca1217c6fa39","uuid":"a99baa27-1c12-45db-9ea5-597cf5ebca74","timestamp":"2026-11-15T10:33:52.652Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/templates/settings/settings.base.json","content":"  \"env\": {\n    \"CEO_QUIET_MODE\": \"1\",\n    \"CLAUDE_CODE_SUBAGENT_MODEL\": \"inherit\",\n    \"CLAUDE_CODE_SUBPROCESS_ENV_SCRUB\": \"1\",\n    \"BASH_MAX_TIMEOUT_MS\": \"600000\",\n    \"CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR\": \"1\",\n    \"ENABLE_TOOL_SEARCH\": \"auto\"\n  },\n  \"_model_pin_comment\": \"PLAN-163 T1.1 contingency (ADR-181 §Contingency) — session-default pin. CC 2.1.220 honors the top-level settings key \\\"model\\\" (zod: E.string().optional(); describe \\\"Override the default model used by Claude Code\\\"; source at 2.1.220 binary offset [REDACTED:rg], sha256 8addc857..., between \\\"permissions\\\" and \\\"fallbackModel\\\"). Pinned to claude-opus-5-5 since ADR-149 Amendment 3 (S357; Claude Opus 5.5 needs Claude Code >= 2.1.280). ADR-181 first pinned claude-opus-5 so that adding claude-sonnet-5 to availableModels could not silently flip the session default to the 2.1.220 sonnet-5 tier-default (enforceAvailableModels stops redirecting once sonnet-5 is allowed); claude-opus-5 stays the fallbackModel. ADOPTER NOTE: a fresh install therefore inherits claude-opus-5-5 as the session default (Opus 5.5 pricing $4/$20 per MTok). If that is not desired for your workload, override the value here (e.g. \\\"claude-sonnet-5\\\" or your tier default) or set env ANTHROPIC_MODEL / pass CLI --model per-session; the pinned value must be one that availableModels below admits: Claude Code replaces a pin the allowlist does not admit with the default model at startup (with a warning), and admits an id that extends an allowed entry by a - segment. scripts/upgrade.sh is stricter: it writes a new framework pin into an existing install only when that pin is an EXACT entry of its availableModels, and warns otherwise. Keep this key mirrored with .claude/settings.json in the framework repo (SessionDefaultPinTest).\",\n  \"model\": \"claude-opus-5-5\",\n  \"availableModels\": [\n    \"claude-opus-4-8\",\n    \"claude-fable-5\",\n    \"claude-sonnet-4-6\",\n    \"claude-haiku-4-5\",\n    \"claude-opus-5\",\n    \"claude-sonnet-5\",\n    \"claude-fable-5-1\",\n    \"claude-opus-5-5\"\n  ],\n  \"fallbackModel\": [\n    \"claude-opus-5\"\n  ],\n  \"_effort_level_comment\": \"PLAN-193 / ADR-149 Amendment 3 (Owner decisions S357: OQ-1 = xhigh, OQ-7 = new install + opt-in, OQ-8 = the pin migration writes high). Top-level effortLevel: in PROJECT settings it applies to every model the session uses and outranks a level a developer saved with /effort (Claude Code keeps those per model under modelSettings in user settings); a level set in .claude/settings.local.json outranks this file. Claude Opus 5.5 (the model pin above) runs at its default MEDIUM effort when no level is set, a default that an organization default effort replaces when the session runs the organization default model; Opus 5 and Fable 5 default to high. A maxEffortLevel caps any level, this one included. The key takes low, medium, high or xhigh; max is not one of its values, and Claude Code before 2.1.111 has no xhigh (this release needs 2.1.280, SUPPORT.md). New installs ship xhigh. On an existing install scripts/upgrade.sh writes xhigh only when you pass --adopt-setting effortLevel; when it moves the shipped pin claude-opus-5 to claude-opus-5-5 in a file that sets no level it writes high, the Opus 5 default; it never overwrites a value you set. Lower or delete the key to trade depth for cost and latency.\",\n  \"effortLevel\": \"xhigh\",\n  \"_posture_keys_comment\": \"PLAN-163 T5.3/OQ5 — fail-closed posture keys (CC >=2.1.220). Key (1) permissions.defaultMode ships LIVE below (see _default_mode_arbitration_comment); the REMAINING keys ship COMMENTED for adopters. Dogfood status (2026-08-03): the framework repo enables workflowSizeGuideline and the sandbox keys; disableAutoMode was REMOVED from the dogfood settings by Owner decision (ceremony [SENT-PLAN165]) — beyond the documented no-mid-session-escalation effect it also strips 'auto' from the operator's native shift+tab mode cycle, and choosing the session mode is the operator's call, not the framework's. Adopters may still opt in. To adopt, add the keys literally: (2) top-level \\\"disableAutoMode\\\": \\\"disable\\\" — string enum whose sole value is 'disable' (the 2.1.220 schema rejects a boolean and SKIPS THE WHOLE settings file on mismatch — S286 live-fire); prevents automatic permission-mode escalation mid-session. (3) top-level \\\"workflowSizeGuideline\\\": <per your workflow scale; advisory sizing guideline for Workflow-tool fan-outs>. (4) \\\"sandbox\\\": { \\\"network\\\": { \\\"strictAllowlist\\\": true } } — tightens allowedDomains matching to the strict form. (5) \\\"sandbox\\\": { \\\"filesystem\\\": { \\\"disabled\\\": false } } — keeps filesystem confinement armed when the sandbox is enabled (true would fail-OPEN the FS layer). All keys are independent and additive; rollback is deleting the key. NEW-EVENT hook registrations (DirectoryAdded/Notification) are deliberately NOT in this template yet — T3.4 version-floor feature gate (upgrade.sh, default OFF), ADR-183 residual (e); this template stays at 45 registrations until the floor probe is recorded. This block is documentation only — underscore-prefixed keys are ignored by the harness.\",\n  \"_default_mode_arbitration_comment\": \"PLAN-163 T3.5/T5.3 ARBITRATION (CEO S284, ADR-183): permissions.defaultMode='manual' is a LIVE key in this template, not a commented posture option. Rationale: install.sh copies this file verbatim on a fresh install, and the U1 post-install oracle (test_upgrade_settings_migration.py TestU1TemplateParity) asserts the template already carries the T5.4 NEW baseline (defaultMode='manual', the 2.1.2xx rename of the ask-first permission mode — every non-allowlisted tool call prompts) — a commented-only defaultMode would red U1 and ship fresh installs on the OLD 'default' posture. Rollback: delete the defaultMode key (single-line revert; no hook consumes it — harness-level only).\",\n  \"_night_mode_deny_surface_comment\": \"PLAN-165 P1-corrected (D2 + round-2 findings NM-01/NM-03 + codex CX-1) — under defaultMode=acceptEdits a tool Edit/Write is auto-accepted, so every file that can DECIDE the next session's posture is deny-listed: (1) .claude/settings.local.json, the per-machine overlay (gitignored) that decides the NEXT session's permission posture; (2) .claude/state/night-mode.json, the night-mode marker/snapshot whose prev_value is restored into the overlay by night-mode off — a posture write BY PROXY (NM-01); (3) .claude/scripts/night-mode.py, the single sanctioned writer itself (NM-03). HONEST SCOPE (CX-1): per-TOOL deny entries close only the Edit/Write rail; the Bash rail is closed by _CANONICAL_GUARDS in check_canonical_edit.py (all three paths listed) + kernel-tier listing of the two state files. The script writes as a PROCESS, never via the Edit/Write tools, so the deny costs no legitimate path. The Write() twins were REMOVED in S292: the current harness (>=2.1.216) does NOT consult Write(path) rules in its file-permission check (the CLI emits an active warning for such rules) and the Edit(path) entries cover ALL file-editing tools — the same class PLAN-161 C1 removed from the credential-read baseline; the old-CLI residual documented there is now accepted for the posture files too, with the real defense on the _CANONICAL_GUARDS/kernel rails (CX-1). Mirrors .claude/settings.json in the framework repo (dogfood parity) — the three entries are byte-identical in both files.\",\n  \"permissions\": {\n    \"defaultMode\": \"manual\",","numLines":30,"startLine":620,"totalLines":783}},"tool_result_meta":[{"id":"toolu_01XzxdSiDUbCHJLBgCYhaBBv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
