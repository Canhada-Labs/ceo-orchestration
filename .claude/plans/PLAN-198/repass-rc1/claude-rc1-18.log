path\",","numLines":60,"startLine":1,"totalLines":420}},"tool_result_meta":[{"id":"toolu_01Cc5ibAXyFHA19eygjUt8rm","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
