{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wvr5ZjQTUBTe9LaKGYMziX","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"policy_dispatch — dispatcher for policy-as-code hooks (PLAN-014 A.3).\n3\t\n4\tLoads a YAML policy via :func:`_lib.policy.load` and evaluates against a\n5\ttool-call event on stdin. Output is a single JSON decision line on stdout\n6\tper the hook-io contract.\n7\t\n8\tFail-mode follows SPEC/v1/policy-dsl.schema.md §7 + ADR-045 §Fail-mode:\n9\t\n10\t- ``CEO_POLICY_ENGINE_DISABLE=1`` → short-circuit to allow + breadcrumb\n11\t  via ``policy_error(disabled_by_env)`` (logged but tolerated since it is\n12\t  not in the SPEC §5 closed enum → falls back to ``parse_error`` in the\n13\t  emitter). Optionally delegates to a legacy ``.py`` hook at\n14\t  ``$CEO_POLICY_LEGACY_HOOK_PATH`` if set.\n15\t- Load failure → emit ``policy_error(error_kind)``; delegate to\n16\t  ``$CEO_POLICY_LEGACY_HOOK_PATH`` if set (dual-path window). Otherwise\n17\t  fail-CLOSED for security-surface hooks (block with\n18\t  ``policy_engine_unavailable``).\n19\t\n20\tInvocation::\n21\t\n22\t    policy_dispatch.py --policy bash-safety\n23\t\n24\tThe policy file is resolved as::\n25\t\n26\t    $CLAUDE_PROJECT_DIR/.claude/policies/<name>.policy.yaml\n27\t\n28\tor overridden by ``$CEO_POLICY_FILE`` (absolute path).\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\timport argparse\n34\timport json\n35\timport os\n36\timport subprocess\n37\timport sys\n38\tfrom pathlib import Path\n39\tfrom typing import Any, Dict\n40\t\n41\t_HOOKS_DIR = Path(__file__).resolve().parent\n42\tif str(_HOOKS_DIR) not in sys.path:\n43\t    sys.path.insert(0, str(_HOOKS_DIR))\n44\t\n45\ttry:\n46\t    from _lib import policy as _policy  # noqa: E402\n47\texcept Exception as e:  # pragma: no cover\n48\t    _policy = None  # type: ignore\n49\t    _IMPORT_EXC = e\n50\telse:\n51\t    _IMPORT_EXC = None\n52\t\n53\ttry:\n54\t    from _lib import audit_emit as _audit_emit  # noqa: E402\n55\texcept Exception:  # pragma: no cover\n56\t    _audit_emit = None  # type: ignore\n57\t\n58\t\n59\tdef _emit_error(policy_id: str, error_kind: str, detail: str) -> None:\n60\t    if _audit_emit is None:\n61\t        return\n62\t    try:\n63\t        _audit_emit.emit_policy_error(\n64\t            policy_id=policy_id,\n65\t            error_kind=error_kind,\n66\t            detail=detail,\n67\t        )\n68\t    except Exception:  # pragma: no cover\n69\t        pass\n70\t\n71\t\n72\tdef _resolve_policy_path(name: str) -> Path:\n73\t    override = os.environ.get(\"CEO_POLICY_FILE\")\n74\t    if override:\n75\t        return Path(override)\n76\t    project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n77\t    return Path(project_dir) / \".claude\" / \"policies\" / f\"{name}.policy.yaml\"\n78\t\n79\t\n80\tdef _delegate_to_legacy(event_text: str) -> int:\n81\t    \"\"\"Re-invoke the legacy Python hook if available. Returns exit code.\"\"\"\n82\t    legacy = os.environ.get(\"CEO_POLICY_LEGACY_HOOK_PATH\")\n83\t    if not legacy:\n84\t        return -1\n85\t    legacy_path = Path(legacy)\n86\t    if not legacy_path.is_file():\n87\t        return -1\n88\t    try:\n89\t        proc = subprocess.run(\n90\t            [sys.executable, str(legacy_path)],\n91\t            input=event_text,\n92\t            capture_output=True,\n93\t            text=True,\n94\t            timeout=5.0,\n95\t        )\n96\t        sys.stdout.write(proc.stdout)\n97\t        sys.stderr.write(proc.stderr)\n98\t        return proc.returncode\n99\t    except Exception:\n100\t        return -1\n101\t\n102\t\n103\tdef _fail_closed(policy_id: str, reason: str) -> None:\n104\t    sys.stdout.write(json.dumps({\n105\t        \"decision\": \"block\",\n106\t        \"reason\": reason,\n107\t    }, ensure_ascii=False) + \"\\n\")\n108\t\n109\t\n110\tdef _allow() -> None:\n111\t    sys.stdout.write(json.dumps({\"decision\": \"allow\"},\n112\t                                ensure_ascii=False) + \"\\n\")\n113\t\n114\t\n115\tdef main(argv: list) -> int:\n116\t    parser = argparse.ArgumentParser(prog=\"policy_dispatch\")\n117\t    parser.add_argument(\"--policy\", required=True,\n118\t                        help=\"Policy slug (filename base without .policy.yaml)\")\n119\t    args = parser.parse_args(argv)\n120\t\n121\t    event_text = sys.stdin.read() or \"{}\"\n122\t    try:\n123\t        event: Dict[str, Any] = json.loads(event_text)\n124\t    except json.JSONDecodeError:\n125\t        event = {}\n126\t\n127\t    # Kill-switch escape hatch (SPEC §7.4).\n128\t    if os.environ.get(\"CEO_POLICY_ENGINE_DISABLE\") == \"1\":\n129\t        _emit_error(args.policy, \"parse_error\", \"disabled_by_env\")\n130\t        rc = _delegate_to_legacy(event_text)\n131\t        if rc >= 0:\n132\t            return rc\n133\t        _allow()\n134\t        return 0\n135\t\n136\t    if _policy is None:\n137\t        _emit_error(args.policy, \"import_failure\", str(_IMPORT_EXC))\n138\t        rc = _delegate_to_legacy(event_text)\n139\t        if rc >= 0:\n140\t            return rc\n141\t        _fail_closed(args.policy, \"policy_engine_unavailable\")\n142\t        return 0\n143\t\n144\t    policy_path = _resolve_policy_path(args.policy)\n145\t    try:\n146\t        policy_obj = _policy.load(policy_path)\n147\t    except _policy.PolicyLoadError as e:\n148\t        _emit_error(e.policy_id or args.policy, e.error_kind, e.detail)\n149\t        rc = _delegate_to_legacy(event_text)\n150\t        if rc >= 0:\n151\t            return rc\n152\t        _fail_closed(args.policy, \"policy_engine_unavailable\")\n153\t        return 0\n154\t    except Exception as e:  # pragma: no cover\n155\t        _emit_error(args.policy, \"parse_error\", f\"unexpected: {e}\")\n156\t        rc = _delegate_to_legacy(event_text)\n157\t        if rc >= 0:\n158\t            return rc\n159\t        _fail_closed(args.policy, \"policy_engine_unavailable\")\n160\t        return 0"}]},"parent_tool_use_id":null,"session_id":"f36400ef-26f6-4b31-b68a-075981f68fdb","uuid":"77c53262-2554-4f2b-85ed-29237e9f7552","timestamp":"2026-11-13T17:38:32.426Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/policy_dispatch.py","content":"#!/usr/bin/env python3\n\"\"\"policy_dispatch — dispatcher for policy-as-code hooks (PLAN-014 A.3).\n\nLoads a YAML policy via :func:`_lib.policy.load` and evaluates against a\ntool-call event on stdin. Output is a single JSON decision line on stdout\nper the hook-io contract.\n\nFail-mode follows SPEC/v1/policy-dsl.schema.md §7 + ADR-045 §Fail-mode:\n\n- ``CEO_POLICY_ENGINE_DISABLE=1`` → short-circuit to allow + breadcrumb\n  via ``policy_error(disabled_by_env)`` (logged but tolerated since it is\n  not in the SPEC §5 closed enum → falls back to ``parse_error`` in the\n  emitter). Optionally delegates to a legacy ``.py`` hook at\n  ``$CEO_POLICY_LEGACY_HOOK_PATH`` if set.\n- Load failure → emit ``policy_error(error_kind)``; delegate to\n  ``$CEO_POLICY_LEGACY_HOOK_PATH`` if set (dual-path window). Otherwise\n  fail-CLOSED for security-surface hooks (block with\n  ``policy_engine_unavailable``).\n\nInvocation::\n\n    policy_dispatch.py --policy bash-safety\n\nThe policy file is resolved as::\n\n    $CLAUDE_PROJECT_DIR/.claude/policies/<name>.policy.yaml\n\nor overridden by ``$CEO_POLICY_FILE`` (absolute path).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict\n\n_HOOKS_DIR = Path(__file__).resolve().parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\ntry:\n    from _lib import policy as _policy  # noqa: E402\nexcept Exception as e:  # pragma: no cover\n    _policy = None  # type: ignore\n    _IMPORT_EXC = e\nelse:\n    _IMPORT_EXC = None\n\ntry:\n    from _lib import audit_emit as _audit_emit  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _audit_emit = None  # type: ignore\n\n\ndef _emit_error(policy_id: str, error_kind: str, detail: str) -> None:\n    if _audit_emit is None:\n        return\n    try:\n        _audit_emit.emit_policy_error(\n            policy_id=policy_id,\n            error_kind=error_kind,\n            detail=detail,\n        )\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _resolve_policy_path(name: str) -> Path:\n    override = os.environ.get(\"CEO_POLICY_FILE\")\n    if override:\n        return Path(override)\n    project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n    return Path(project_dir) / \".claude\" / \"policies\" / f\"{name}.policy.yaml\"\n\n\ndef _delegate_to_legacy(event_text: str) -> int:\n    \"\"\"Re-invoke the legacy Python hook if available. Returns exit code.\"\"\"\n    legacy = os.environ.get(\"CEO_POLICY_LEGACY_HOOK_PATH\")\n    if not legacy:\n        return -1\n    legacy_path = Path(legacy)\n    if not legacy_path.is_file():\n        return -1\n    try:\n        proc = subprocess.run(\n            [sys.executable, str(legacy_path)],\n            input=event_text,\n            capture_output=True,\n            text=True,\n            timeout=5.0,\n        )\n        sys.stdout.write(proc.stdout)\n        sys.stderr.write(proc.stderr)\n        return proc.returncode\n    except Exception:\n        return -1\n\n\ndef _fail_closed(policy_id: str, reason: str) -> None:\n    sys.stdout.write(json.dumps({\n        \"decision\": \"block\",\n        \"reason\": reason,\n    }, ensure_ascii=False) + \"\\n\")\n\n\ndef _allow() -> None:\n    sys.stdout.write(json.dumps({\"decision\": \"allow\"},\n                                ensure_ascii=False) + \"\\n\")\n\n\ndef main(argv: list) -> int:\n    parser = argparse.ArgumentParser(prog=\"policy_dispatch\")\n    parser.add_argument(\"--policy\", required=True,\n                        help=\"Policy slug (filename base without .policy.yaml)\")\n    args = parser.parse_args(argv)\n\n    event_text = sys.stdin.read() or \"{}\"\n    try:\n        event: Dict[str, Any] = json.loads(event_text)\n    except json.JSONDecodeError:\n        event = {}\n\n    # Kill-switch escape hatch (SPEC §7.4).\n    if os.environ.get(\"CEO_POLICY_ENGINE_DISABLE\") == \"1\":\n        _emit_error(args.policy, \"parse_error\", \"disabled_by_env\")\n        rc = _delegate_to_legacy(event_text)\n        if rc >= 0:\n            return rc\n        _allow()\n        return 0\n\n    if _policy is None:\n        _emit_error(args.policy, \"import_failure\", str(_IMPORT_EXC))\n        rc = _delegate_to_legacy(event_text)\n        if rc >= 0:\n            return rc\n        _fail_closed(args.policy, \"policy_engine_unavailable\")\n        return 0\n\n    policy_path = _resolve_policy_path(args.policy)\n    try:\n        policy_obj = _policy.load(policy_path)\n    except _policy.PolicyLoadError as e:\n        _emit_error(e.policy_id or args.policy, e.error_kind, e.detail)\n        rc = _delegate_to_legacy(event_text)\n        if rc >= 0:\n            return rc\n        _fail_closed(args.policy, \"policy_engine_unavailable\")\n        return 0\n    except Exception as e:  # pragma: no cover\n        _emit_error(args.policy, \"parse_error\", f\"unexpected: {e}\")\n        rc = _delegate_to_legacy(event_text)\n        if rc >= 0:\n            return rc\n        _fail_closed(args.policy, \"policy_engine_unavailable\")\n        return 0","numLines":160,"startLine":1,"totalLines":169}},"tool_result_meta":[{"id":"toolu_01Wvr5ZjQTUBTe9LaKGYMziX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
