{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AmZGgM4qedPy13G1riGPDF","type":"tool_result","content":"1\t\"\"\"Declarations extracted from federation.server; loaded by the facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tclass FederationServer:\n5\t    \"\"\"Top-level orchestrator for the federation server.\"\"\"\n6\t\n7\t    def __init__(\n8\t        self,\n9\t        config: FederationConfig,\n10\t        audit_fetch: Optional[Callable[[Optional[str]], List[Dict[str, Any]]]] = None,\n11\t        now: Optional[_dt.datetime] = None,\n12\t    ) -> None:\n13\t        self.config = config\n14\t        self._audit_fetch = audit_fetch\n15\t        self._now = now or _dt.datetime.now(_dt.timezone.utc)\n16\t        self._httpd: Optional[http.server.HTTPServer] = None\n17\t        self._reload_thread: Optional[threading.Thread] = None\n18\t        self._reload_stop = threading.Event()\n19\t\n20\t    # -- Pre-start invariants ------------------------------------------\n21\t\n22\t    def _check_kill_switch(self) -> None:\n23\t        v = os.environ.get(FEDERATION_KILL_SWITCH_ENV, \"0\").strip()\n24\t        if v not in (\"1\", \"true\", \"TRUE\"):\n25\t            raise FederationStartError(\n26\t                \"kill-switch {0} not set; refusing to start\".format(\n27\t                    FEDERATION_KILL_SWITCH_ENV\n28\t                )\n29\t            )\n30\t\n31\t    def _check_enable_sentinel(self) -> None:\n32\t        cfg = self.config\n33\t        ok, reason = verify_enable_sentinel_pair(\n34\t            cfg.enabled_sentinel,\n35\t            cfg.enabled_sentinel_asc,\n36\t            [OWNER_GPG_FPR],\n37\t            signer_registry_path=cfg.signer_registry_path,\n38\t            now=self._now,\n39\t        )\n40\t        if not ok:\n41\t            _safe_emit(\n42\t                \"federation_enable_sentinel_invalid\",\n43\t                sentinel_kind=\"enable\",\n44\t                reason=reason[:96],\n45\t            )\n46\t            raise FederationStartError(\n47\t                \"enable sentinel invalid: {0}\".format(reason)\n48\t            )\n49\t\n50\t    def _check_lan_sentinel_if_required(self) -> None:\n51\t        cfg = self.config\n52\t        is_loopback, resolved = resolve_bind_is_loopback(cfg.bind_host)\n53\t        if is_loopback:\n54\t            return\n55\t        ok, reason = verify_enable_sentinel_pair(\n56\t            cfg.lan_enabled_sentinel,\n57\t            cfg.lan_enabled_sentinel_asc,\n58\t            [OWNER_GPG_FPR],\n59\t            signer_registry_path=cfg.signer_registry_path,\n60\t            now=self._now,\n61\t        )\n62\t        if not ok:\n63\t            _safe_emit(\n64\t                \"federation_lan_bind_denied\",\n65\t                bind_host=cfg.bind_host[:64],\n66\t                resolved_ip=resolved[:64],\n67\t                reason=reason[:96],\n68\t            )\n69\t            raise FederationStartError(\n70\t                \"LAN bind denied: {0}\".format(reason)\n71\t            )\n72\t\n73\t    def _load_peers_or_raise(self) -> Dict[str, PeerRecord]:\n74\t        try:\n75\t            peers = load_peers(self.config.peers_path)\n76\t        except FileNotFoundError:\n77\t            _safe_emit(\n78\t                \"federation_connection_rejected\",\n79\t                reason=\"peers_yaml_missing\",\n80\t                peer_id_cert_fingerprint=\"\",\n81\t                client_ip=\"\",\n82\t            )\n83\t            raise FederationStartError(\n84\t                \"peers.yaml missing at {0}\".format(self.config.peers_path)\n85\t            )\n86\t        except PeerHasNoFingerprintError as e:\n87\t            _safe_emit(\n88\t                \"federation_peer_invalid_no_fingerprint\",\n89\t                peer_id=(getattr(e, \"peer_id\", \"\") or \"\")[:64],\n90\t                source_path=str(self.config.peers_path)[:128],\n91\t            )\n92\t            raise FederationStartError(\n93\t                \"peers.yaml no-fingerprint invariant: {0}\".format(e)\n94\t            )\n95\t        except PeersFileError as e:\n96\t            _safe_emit(\n97\t                \"federation_connection_rejected\",\n98\t                reason=\"peers_yaml_parse_error\",\n99\t                peer_id_cert_fingerprint=\"\",\n100\t                client_ip=\"\",\n101\t            )\n102\t            raise FederationStartError(\n103\t                \"peers.yaml parse error: {0}\".format(e)\n104\t            )\n105\t\n106\t        now = self._now\n107\t        for peer in peers.values():\n108\t            days_left = (peer.not_valid_after - now).days\n109\t            if days_left <= CERT_EXPIRY_WARN_DAYS:\n110\t                _safe_emit(\n111\t                    \"federation_cert_expiry_warned\",\n112\t                    peer_id=peer.peer_id[:64],\n113\t                    days_remaining=int(days_left),\n114\t                )\n115\t            if days_left < 0:\n116\t                _safe_emit(\n117\t                    \"federation_cert_revoked\",\n118\t                    peer_id=peer.peer_id[:64],\n119\t                    reason=\"expired\",\n120\t                )\n121\t        return peers\n122\t\n123\t    # -- Lifecycle -----------------------------------------------------\n124\t\n125\t    def _start_reload_thread(self, httpd: Any) -> None:\n126\t        \"\"\"P0-1 — start a low-frequency poll thread so revocation\n127\t        propagates in <60s even with zero traffic.\"\"\"\n128\t        def _poll() -> None:\n129\t            while not self._reload_stop.is_set():\n130\t                # Poll every 5s; debounce inside _maybe_reload_peers means\n131\t                # an unchanged file is a cheap stat+hash, not a re-parse.\n132\t                self._reload_stop.wait(5.0)\n133\t                if self._reload_stop.is_set():\n134\t                    break\n135\t                try:\n136\t                    _maybe_reload_peers(httpd)\n137\t                except Exception:\n138\t                    pass\n139\t                try:\n140\t                    _reap_orphaned_inflight(\n141\t                        getattr(httpd, \"federation_sentinels_dir\", None)\n142\t                    )\n143\t                except Exception:\n144\t                    pass\n145\t        t = threading.Thread(\n146\t            target=_poll, name=\"federation-peer-reload\", daemon=True,\n147\t        )\n148\t        self._reload_thread = t\n149\t        t.start()\n150\t\n151\t    def serve_forever(self) -> None:\n152\t        \"\"\"Start the server and serve until ``shutdown()`` is called.\"\"\"\n153\t        self._check_kill_switch()\n154\t        self._check_enable_sentinel()\n155\t        self._check_lan_sentinel_if_required()\n156\t        peers = self._load_peers_or_raise()\n157\t        cfg = self.config\n158\t\n159\t        ctx = build_ssl_context(cfg.cert_file, cfg.key_file, cfg.ca_file)\n160\t\n161\t        try:\n162\t            with open(cfg.cert_file, \"r\", encoding=\"utf-8\") as fh:\n163\t                pem = fh.read()\n164\t            server_fpr = compute_cert_fingerprint(pem)\n165\t        except OSError:\n166\t            server_fpr = \"\"\n167\t\n168\t        bind_family = socket.AF_INET\n169\t        try:\n170\t            if ipaddress.ip_address(cfg.bind_host).version == 6:\n171\t                bind_family = socket.AF_INET6\n172\t        except ValueError:\n173\t            pass\n174\t\n175\t        httpd = _ThreadingHTTPSServer(\n176\t            (cfg.bind_host, cfg.bind_port),\n177\t            _FederationHandler,\n178\t            address_family=bind_family,\n179\t        )\n180\t        httpd.socket = ctx.wrap_socket(httpd.socket, server_side=True)\n181\t\n182\t        httpd.federation_config = cfg  # type: ignore[attr-defined]\n183\t        httpd.federation_peers = peers  # type: ignore[attr-defined]\n184\t        httpd.federation_peers_path = cfg.peers_path  # type: ignore[attr-defined]\n185\t        httpd.federation_peers_e