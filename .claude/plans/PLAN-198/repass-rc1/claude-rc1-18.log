{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018d6uc1gKNpfK2m7JvdT7z2","type":"tool_result","content":"1\t\"\"\"Declarations extracted from federation.server; loaded by the facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tclass _HandlerRead:\n5\t    def _rate_limit_check(\n6\t        self,\n7\t        method: str,\n8\t        path: str,\n9\t        headers,\n10\t        peer_row: dict,\n11\t    ) -> Tuple[bool, Optional[str]]:\n12\t        \"\"\"Gate #9 — token-bucket + circuit-breaker + backpressure.\n13\t\n14\t        DEFAULT-DENY on any exception (R-SE-b: no gate fails OPEN). Bridges\n15\t        the dispatcher seam signature ``(method, path, headers, peer_row)``\n16\t        to ``rate_limit.py``'s ``(peer_id, route, ip_prefix, *, now=)``.\n17\t        Emits ``federation_message_storm_detected`` (breaker trip) +\n18\t        ``federation_audit_log_backpressure`` from inside rate_limit.py via\n19\t        the C-4-fixed _safe_emit fallback.\n20\t        \"\"\"\n21\t        rl = _load_rate_limit()\n22\t        if rl is None:\n23\t            # Partial install — no limiter. Fail-CLOSED (deny).\n24\t            return False, \"rate_limit:module_missing\"\n25\t        try:\n26\t            peer_id = str(peer_row.get(\"peer_id\", \"\"))\n27\t            route = path\n28\t            ip_prefix = self._ip_prefix()\n29\t            now_fn = getattr(self.server, \"federation_clock\", None)\n30\t            now = now_fn() if callable(now_fn) else None\n31\t\n32\t            # 1. Backpressure (T1499 latency overload).\n33\t            ok_bp, _info = rl.check_backpressure(now=now)\n34\t            if not ok_bp:\n35\t                return False, \"audit_log_backpressure\"\n36\t\n37\t            # 2. Circuit-breaker — already-tripped / trip-on-this-check.\n38\t            ok_cb, cb_reason = rl.check_circuit_breaker(peer_id, route, now=now)\n39\t            if not ok_cb:\n40\t                return False, (cb_reason or \"circuit_breaker\")[:32]\n41\t\n42\t            # 3. Token bucket.\n43\t            ok_rl, rl_reason = rl.check_rate_limit(\n44\t                peer_id, route, ip_prefix, now=now,\n45\t            )\n46\t            if not ok_rl:\n47\t                # Advance breaker window so a sustained storm trips it.\n48\t                rl.record_hit(peer_id, route, ip_prefix, now=now)\n49\t                return False, (rl_reason or \"rate_limit\")[:32]\n50\t            return True, None\n51\t        except Exception as exc:\n52\t            sys.stderr.write(\n53\t                \"[federation.dispatch] rate_limit raised {0}; \"\n54\t                \"DEFAULT-DENY\\n\".format(type(exc).__name__)\n55\t            )\n56\t            return False, \"rate_limit:exception\"\n57\t\n58\t    def _maybe_check_audit_chain(\n59\t        self, peer_id: str, path: str,\n60\t        audit_log_path: Optional[Path] = None,\n61\t    ) -> None:\n62\t        \"\"\"POST-handler T1565 — bounded audit-chain tamper walk (W4).\n63\t\n64\t        P0 #1 (Codex BLOCK): the path is the SAME canonical audit-log the\n65\t        push handler just appended to (passed from the dispatcher). We\n66\t        fall back to ``_resolve_audit_log_path()`` so the check still runs\n67\t        even if the caller didn't thread it through — it must NEVER be a\n68\t        no-op just because ``self.server.federation_audit_log_path`` is\n69\t        unset (the prior bug).\n70\t        \"\"\"\n71\t        ace = _load_audit_chain_ext()\n72\t        if ace is None:\n73\t            return\n74\t        log_path = audit_log_path or self._resolve_audit_log_path()\n75\t        if log_path is None:\n76\t            return\n77\t        try:\n78\t            ok, _info = ace.check_chain(Path(log_path), max_events=500)\n79\t            # check_chain itself emits federation_tamper_detected on break\n80\t            # via its own _safe_emit (also C-4-fixed). Nothing to do here\n81\t            # on the happy path.\n82\t            _ = ok\n83\t        except Exception:\n84\t            pass\n85\t\n86\t    # -- Wave D emit shims (canonical F.2 vocabulary) ------------------\n87\t\n88\t    def _emit_scope_denied(\n89\t        self,\n90\t        peer_id: str,\n91\t        route: str,\n92\t        required_scope: str,\n93\t        peer_row: Mapping[str, Any],\n94\t    ) -> None:\n95\t        scopes_list = peer_row.get(\"scopes\", []) if peer_row else []\n96\t        if not isinstance(scopes_list, (list, tuple)):\n97\t            scopes_list = []\n98\t        _safe_emit(\n99\t            \"federation_scope_denied\",\n100\t            peer_id=peer_id[:64],\n101\t            route=route[:64],\n102\t            required_scope=required_scope[:32],\n103\t            peer_scopes_count=int(len(scopes_list)),\n104\t        )\n105\t\n106\t    def _emit_write_endpoint_denied(\n107\t        self,\n108\t        peer_id: str,\n109\t        route: str,\n110\t        *,\n111\t        gate_failed: int,\n112\t        reason_code: str,\n113\t    ) -> None:\n114\t        _safe_emit(\n115\t            \"federation_write_endpoint_denied\",\n116\t            peer_id=peer_id[:64],\n117\t            route=route[:64],\n118\t            gate_failed=int(gate_failed),\n119\t            reason_code=reason_code[:32],\n120\t        )\n121\t\n122\t    def _emit_write_disabled_sentinel_invalid(\n123\t        self,\n124\t        reason_code: str = \"gpg_verify_failed\",\n125\t    ) -> None:\n126\t        sentinel_path = str(getattr(\n127\t            self.server,\n128\t            \"write_enabled_sentinel\",\n129\t            \".claude/data/federation/write-enabled.md\",\n130\t        ))\n131\t        _safe_emit(\n132\t            \"federation_write_disabled_sentinel_invalid\",\n133\t            reason_code=reason_code[:32],\n134\t            sentinel_path=sentinel_path[:128],\n135\t        )\n136\t\n137\t    # -- Body / response helpers (Wave D) ------------------------------\n138\t\n139\t    def _read_body_capped(self, max_bytes: int) -> Optional[bytes]:\n140\t        \"\"\"Read request body with a hard cap. Returns None on overflow.\"\"\"\n141\t        cl_header = self.headers.get(\"Content-Length\", \"\")\n142\t        try:\n143\t            content_length = int(cl_header) if cl_header else 0\n144\t        except (TypeError, ValueError):\n145\t            return None\n146\t        if content_length > max_bytes:\n147\t            return None\n148\t        if content_length <= 0:\n149\t            return b\"\"\n150\t        try:\n151\t            return self.rfile.read(content_length)\n152\t        except (OSError, ValueError):\n153\t            return None\n154\t\n155\t    def _send_status(self, status: int, reason: str) -> None:\n156\t        body = json.dumps({\"error\": reason}).encode(\"utf-8\")\n157\t        self.send_response(status)\n158\t        self.send_header(\"Content-Type\", \"application/json\")\n159\t        self.send_header(\"Content-Length\", str(len(body)))\n160\t        self.send_header(\"Connection\", \"close\")\n161\t        self.end_headers()\n162\t        self.wfile.write(body)\n163\t\n164\t    def _send_response_bytes(self, status: int, body: bytes) -> None:\n165\t        self.send_response(status)\n166\t        self.send_header(\"Content-Type\", \"application/json\")\n167\t        self.send_header(\"Content-Length\", str(len(body)))\n168\t        self.send_header(\"Connection\", \"close\")\n169\t        self.end_headers()\n170\t        if body:\n171\t            self.wfile.write(body)\n172\t\n173\t    # -- Dispatch (read path) -------------------------------------------\n174\t\n175\t    def do_GET(self) -> None:  # noqa: N802\n176\t        if self.command not in ALLOWED_HTTP_METHODS:\n177\t            self._emit_write_blocked()\n178\t            self._send_405()\n179\t            return\n180\t\n181\t        peer = self._lookup_peer_record()\n182\t        if peer is None:\n183\t            self._emit_connection_rejected(\"peer_unknown_or_revoked\")\n184\t            self._send_403()\n185\t            return\n186\t\n187\t        body = b\"\"\n188\t        cl = self.headers.get(\"Content-Length\")\n189\t        if cl and cl.isdigit():\n190\t            try:\n191\t                body = self.rfile.read(min(int(cl), 4096))\n192\t            except OSError:\n193\t                body = b\"\"\n194\t\n195\t        replay_reason = self._verify_replay_and_signature(peer, body)\n196\t        if replay_reason is not None:\n197\t            _safe_emit(\n198\t                \"federation_connection_replay_suspected\",\n199\t                peer_id=peer.peer_id[:64],\n200\t                reason=replay_reason[:64],\n201\t                client_ip=self._client_ip(),\n202\t            )\n203\t            self._send_401(replay_reason)\n204\t            return\n205\t\n206\t        self._emit_connection_accepted(peer.peer_id)\n207\t\n208\t        if self.path == \"/federation/identity\":\n209\t            self._handle_identity()\n210\t        elif self.path == \"/federation/status\":\n211\t            self._handle_status()\n212\t        elif self.path.startswith(\"/federation/audit-summary\"):\n213\t            self._handle_audit_summary(peer)\n214\t        else:\n215\t            self._send_404()\n216\t\n217\t    # -- Endpoints ------------------------------------------------------\n218\t\n219\t    def _handle_identity(self) -> None:\n220\t        server_fpr = getattr(self.server, \"federation_server_fingerprint\", \"\")\n221\t        payload = {\"peer_id_cert_fingerprint\": server_fpr}\n222\t        self._send_json(200, payload)\n223\t\n224\t    def _handle_status(self) -> None:\n225\t        peer = self._lookup_peer_record()\n226\t        peer_id = peer.peer_id if peer else \"\"\n227\t        started_at = getattr(self.server, \"federation_started_at\", 0.0)\n228\t        uptime_s = max(0, int(time.time() - started_at)) if started_at else 0\n229\t        last_events_digest = getattr(self.server, \"federation_status_digest\", \"\")\n230\t        last_events_count = getattr(self.server, \"federation_status_count\", 0)\n231\t        payload = {\n232\t            \"peer_id\": peer_id,\n233\t            \"uptime_seconds\": uptime_s,\n234\t            \"last_event_opaque_sha256\": last_events_digest,\n235\t            \"last_event_count\": int(last_events_count),\n236\t        }\n237\t        self._send_json(200, payload)\n238\t\n239\t    def _handle_audit_summary(self, peer: PeerRecord) -> None:\n240\t        rl = getattr(self.server, \"federation_rate_limiter\", None)\n241\t        if rl is not None and not rl.allow(\n242\t            peer.peer_id_cert_fingerprint, self._client_ip(),\n243\t        ):\n244\t            self._send_429()\n245\t            return\n246\t\n247\t        fetch: Optional[Callable[[Optional[str]], List[Dict[str, Any]]]] = (\n248\t            getattr(self.server, \"federation_audit_fetch\", None)\n249\t        )\n250\t        since = \"\"\n251\t        if \"?\" in self.path:\n252\t            qs = self.path.split(\"?\", 1)[1]\n253\t            for kv in qs.split(\"&\"):\n254\t                if kv.startswith(\"since=\"):\n255\t                    since = kv.split(\"=\", 1)[1][:64]\n256\t                    break\n257\t\n258\t        events: List[Dict[str, Any]] = []\n259\t        if fetch is not None:\n260\t            try:\n261\t                events = fetch(since or None) or []\n262\t            except Exception:\n263\t                events = []\n264\t\n265\t        events = _apply_redaction_pipeline(events)\n266\t        payload = {\"events\": events, \"count\": len(events)}\n267\t        self._send_json(200, payload)\n268\t\n269\t    # -- Response helpers ------------------------------------------------\n270\t\n271\t    def _send_json(self, code: int, payload: Dict[str, Any]) -> None:\n272\t        body = json.dumps(payload, ensure_ascii=False, sort_keys=True).encode(\"utf-8\")\n273\t        self.send_response(code)\n274\t        self.send_header(\"Content-Type\", \"application/json\")\n275\t        self.send_header(\"Content-Length\", str(len(body)))\n276\t        self.send_header(\"Connection\", \"close\")\n277\t        self.end_headers()\n278\t        self.wfile.write(body)\n279\t\n280\t    def _send_403(self) -> None:\n281\t        body = b'{\"error\":\"forbidden\"}'\n282\t        self.send_response(403)\n283\t        self.send_header(\"Content-Type\", \"application/json\")\n284\t        self.send_header(\"Content-Length\", str(len(body)))\n285\t        self.end_headers()\n286\t        self.wfile.write(body)\n287\t\n288\t    def _send_401(self, reason: str) -> None:\n289\t        body = json.dumps(\n290\t            {\"error\": \"unauthorized\", \"reason\": reason[:64]},\n291\t            ensure_ascii=False,\n292\t        ).encode(\"utf-8\")\n293\t        self.send_response(401)\n294\t        self.send_header(\"Content-Type\", \"application/json\")\n295\t        self.send_header(\"Content-Length\", str(len(body)))\n296\t        self.end_headers()\n297\t        self.wfile.write(body)\n298\t\n299\t    def _send_404(self) -> None:\n300\t        body = b'{\"error\":\"not_found\"}'\n301\t        self.send_response(404)\n302\t        self.send_header(\"Content-Type\", \"application/json\")\n303\t        self.send_header(\"Content-Length\", str(len(body)))\n304\t        self.end_headers()\n305\t        self.wfile.write(body)\n306\t\n307\t    def _send_429(self) -> None:\n308\t        body = b'{\"error\":\"rate_limited\"}'\n309\t        self.send_response(429)\n310\t        self.send_header(\"Content-Type\", \"application/json\")\n311\t        self.send_header(\"Retry-After\", \"60\")\n312\t        self.send_header(\"Content-Length\", str(len(body)))\n313\t        self.end_headers()\n314\t        self.wfile.write(body)\n315\t\n316\t\n317\t# AC6 fail-CLOSED contract.\n318\t"}]},"parent_tool_use_id":null,"session_id":"f36400ef-26f6-4b31-b68a-075981f68fdb","uuid":"fba62b11-ed88-4874-b6c8-3717b51842ca","timestamp":"2026-11-13T17:37:35.745Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/federation/_server_parts/handler_read.py","content":"\"\"\"Declarations extracted from federation.server; loaded by the facade.\"\"\"\nfrom __future__ import annotations\n\nclass _HandlerRead:\n    def _rate_limit_check(\n        self,\n        method: str,\n        path: str,\n        headers,\n        peer_row: dict,\n    ) -> Tuple[bool, Optional[str]]:\n        \"\"\"Gate #9 — token-bucket + circuit-breaker + backpressure.\n\n        DEFAULT-DENY on any exception (R-SE-b: no gate fails OPEN). Bridges\n        the dispatcher seam signature ``(method, path, headers, peer_row)``\n        to ``rate_limit.py``'s ``(peer_id, route, ip_prefix, *, now=)``.\n        Emits ``federation_message_storm_detected`` (breaker trip) +\n        ``federation_audit_log_backpressure`` from inside rate_limit.py via\n        the C-4-fixed _safe_emit fallback.\n        \"\"\"\n        rl = _load_rate_limit()\n        if rl is None:\n            # Partial install — no limiter. Fail-CLOSED (deny).\n            return False, \"rate_limit:module_missing\"\n        try:\n            peer_id = str(peer_row.get(\"peer_id\", \"\"))\n            route = path\n            ip_prefix = self._ip_prefix()\n            now_fn = getattr(self.server, \"federation_clock\", None)\n            now = now_fn() if callable(now_fn) else None\n\n            # 1. Backpressure (T1499 latency overload).\n            ok_bp, _info = rl.check_backpressure(now=now)\n            if not ok_bp:\n                return False, \"audit_log_backpressure\"\n\n            # 2. Circuit-breaker — already-tripped / trip-on-this-check.\n            ok_cb, cb_reason = rl.check_circuit_breaker(peer_id, route, now=now)\n            if not ok_cb:\n                return False, (cb_reason or \"circuit_breaker\")[:32]\n\n            # 3. Token bucket.\n            ok_rl, rl_reason = rl.check_rate_limit(\n                peer_id, route, ip_prefix, now=now,\n            )\n            if not ok_rl:\n                # Advance breaker window so a sustained storm trips it.\n                rl.record_hit(peer_id, route, ip_prefix, now=now)\n                return False, (rl_reason or \"rate_limit\")[:32]\n            return True, None\n        except Exception as exc:\n            sys.stderr.write(\n                \"[federation.dispatch] rate_limit raised {0}; \"\n                \"DEFAULT-DENY\\n\".format(type(exc).__name__)\n            )\n            return False, \"rate_limit:exception\"\n\n    def _maybe_check_audit_chain(\n        self, peer_id: str, path: str,\n        audit_log_path: Optional[Path] = None,\n    ) -> None:\n        \"\"\"POST-handler T1565 — bounded audit-chain tamper walk (W4).\n\n        P0 #1 (Codex BLOCK): the path is the SAME canonical audit-log the\n        push handler just appended to (passed from the dispatcher). We\n        fall back to ``_resolve_audit_log_path()`` so the check still runs\n        even if the caller didn't thread it through — it must NEVER be a\n        no-op just because ``self.server.federation_audit_log_path`` is\n        unset (the prior bug).\n        \"\"\"\n        ace = _load_audit_chain_ext()\n        if ace is None:\n            return\n        log_path = audit_log_path or self._resolve_audit_log_path()\n        if log_path is None:\n            return\n        try:\n            ok, _info = ace.check_chain(Path(log_path), max_events=500)\n            # check_chain itself emits federation_tamper_detected on break\n            # via its own _safe_emit (also C-4-fixed). Nothing to do here\n            # on the happy path.\n            _ = ok\n        except Exception:\n            pass\n\n    # -- Wave D emit shims (canonical F.2 vocabulary) ------------------\n\n    def _emit_scope_denied(\n        self,\n        peer_id: str,\n        route: str,\n        required_scope: str,\n        peer_row: Mapping[str, Any],\n    ) -> None:\n        scopes_list = peer_row.get(\"scopes\", []) if peer_row else []\n        if not isinstance(scopes_list, (list, tuple)):\n            scopes_list = []\n        _safe_emit(\n            \"federation_scope_denied\",\n            peer_id=peer_id[:64],\n            route=route[:64],\n            required_scope=required_scope[:32],\n            peer_scopes_count=int(len(scopes_list)),\n        )\n\n    def _emit_write_endpoint_denied(\n        self,\n        peer_id: str,\n        route: str,\n        *,\n        gate_failed: int,\n        reason_code: str,\n    ) -> None:\n        _safe_emit(\n            \"federation_write_endpoint_denied\",\n            peer_id=peer_id[:64],\n            route=route[:64],\n            gate_failed=int(gate_failed),\n            reason_code=reason_code[:32],\n        )\n\n    def _emit_write_disabled_sentinel_invalid(\n        self,\n        reason_code: str = \"gpg_verify_failed\",\n    ) -> None:\n        sentinel_path = str(getattr(\n            self.server,\n            \"write_enabled_sentinel\",\n            \".claude/data/federation/write-enabled.md\",\n        ))\n        _safe_emit(\n            \"federation_write_disabled_sentinel_invalid\",\n            reason_code=reason_code[:32],\n            sentinel_path=sentinel_path[:128],\n        )\n\n    # -- Body / response helpers (Wave D) ------------------------------\n\n    def _read_body_capped(self, max_bytes: int) -> Optional[bytes]:\n        \"\"\"Read request body with a hard cap. Returns None on overflow.\"\"\"\n        cl_header = self.headers.get(\"Content-Length\", \"\")\n        try:\n            content_length = int(cl_header) if cl_header else 0\n        except (TypeError, ValueError):\n            return None\n        if content_length > max_bytes:\n            return None\n        if content_length <= 0:\n            return b\"\"\n        try:\n            return self.rfile.read(content_length)\n        except (OSError, ValueError):\n            return None\n\n    def _send_status(self, status: int, reason: str) -> None:\n        body = json.dumps({\"error\": reason}).encode(\"utf-8\")\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.send_header(\"Connection\", \"close\")\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _send_response_bytes(self, status: int, body: bytes) -> None:\n        self.send_response(status)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.send_header(\"Connection\", \"close\")\n        self.end_headers()\n        if body:\n            self.wfile.write(body)\n\n    # -- Dispatch (read path) -------------------------------------------\n\n    def do_GET(self) -> None:  # noqa: N802\n        if self.command not in ALLOWED_HTTP_METHODS:\n            self._emit_write_blocked()\n            self._send_405()\n            return\n\n        peer = self._lookup_peer_record()\n        if peer is None:\n            self._emit_connection_rejected(\"peer_unknown_or_revoked\")\n            self._send_403()\n            return\n\n        body = b\"\"\n        cl = self.headers.get(\"Content-Length\")\n        if cl and cl.isdigit():\n            try:\n                body = self.rfile.read(min(int(cl), 4096))\n            except OSError:\n                body = b\"\"\n\n        replay_reason = self._verify_replay_and_signature(peer, body)\n        if replay_reason is not None:\n            _safe_emit(\n                \"federation_connection_replay_suspected\",\n                peer_id=peer.peer_id[:64],\n                reason=replay_reason[:64],\n                client_ip=self._client_ip(),\n            )\n            self._send_401(replay_reason)\n            return\n\n        self._emit_connection_accepted(peer.peer_id)\n\n        if self.path == \"/federation/identity\":\n            self._handle_identity()\n        elif self.path == \"/federation/status\":\n            self._handle_status()\n        elif self.path.startswith(\"/federation/audit-summary\"):\n            self._handle_audit_summary(peer)\n        else:\n            self._send_404()\n\n    # -- Endpoints ------------------------------------------------------\n\n    def _handle_identity(self) -> None:\n        server_fpr = getattr(self.server, \"federation_server_fingerprint\", \"\")\n        payload = {\"peer_id_cert_fingerprint\": server_fpr}\n        self._send_json(200, payload)\n\n    def _handle_status(self) -> None:\n        peer = self._lookup_peer_record()\n        peer_id = peer.peer_id if peer else \"\"\n        started_at = getattr(self.server, \"federation_started_at\", 0.0)\n        uptime_s = max(0, int(time.time() - started_at)) if started_at else 0\n        last_events_digest = getattr(self.server, \"federation_status_digest\", \"\")\n        last_events_count = getattr(self.server, \"federation_status_count\", 0)\n        payload = {\n            \"peer_id\": peer_id,\n            \"uptime_seconds\": uptime_s,\n            \"last_event_opaque_sha256\": last_events_digest,\n            \"last_event_count\": int(last_events_count),\n        }\n        self._send_json(200, payload)\n\n    def _handle_audit_summary(self, peer: PeerRecord) -> None:\n        rl = getattr(self.server, \"federation_rate_limiter\", None)\n        if rl is not None and not rl.allow(\n            peer.peer_id_cert_fingerprint, self._client_ip(),\n        ):\n            self._send_429()\n            return\n\n        fetch: Optional[Callable[[Optional[str]], List[Dict[str, Any]]]] = (\n            getattr(self.server, \"federation_audit_fetch\", None)\n        )\n        since = \"\"\n        if \"?\" in self.path:\n            qs = self.path.split(\"?\", 1)[1]\n            for kv in qs.split(\"&\"):\n                if kv.startswith(\"since=\"):\n                    since = kv.split(\"=\", 1)[1][:64]\n                    break\n\n        events: List[Dict[str, Any]] = []\n        if fetch is not None:\n            try:\n                events = fetch(since or None) or []\n            except Exception:\n                events = []\n\n        events = _apply_redaction_pipeline(events)\n        payload = {\"events\": events, \"count\": len(events)}\n        self._send_json(200, payload)\n\n    # -- Response helpers ------------------------------------------------\n\n    def _send_json(self, code: int, payload: Dict[str, Any]) -> None:\n        body = json.dumps(payload, ensure_ascii=False, sort_keys=True).encode(\"utf-8\")\n        self.send_response(code)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.send_header(\"Connection\", \"close\")\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _send_403(self) -> None:\n        body = b'{\"error\":\"forbidden\"}'\n        self.send_response(403)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _send_401(self, reason: str) -> None:\n        body = json.dumps(\n            {\"error\": \"unauthorized\", \"reason\": reason[:64]},\n            ensure_ascii=False,\n        ).encode(\"utf-8\")\n        self.send_response(401)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _send_404(self) -> None:\n        body = b'{\"error\":\"not_found\"}'\n        self.send_response(404)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def _send_429(self) -> None:\n        body = b'{\"error\":\"rate_limited\"}'\n        self.send_response(429)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Retry-After\", \"60\")\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n\n# AC6 fail-CLOSED contract.\n","numLines":318,"startLine":1,"totalLines":318}},"tool_result_meta":[{"id":"toolu_018d6uc1gKNpfK2m7JvdT7z2","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
