{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H8dfk42UpcMyJ8L5gNiruk","type":"tool_result","content":"680\t\n681\tALL_PATTERNS: List[SecretPattern] = SECRETS + PII\n682\t\n683\t\n684\t# ---------------------------------------------------------------------------\n685\t# Scan API — ReDoS-guarded\n686\t# ---------------------------------------------------------------------------\n687\t\n688\t\n689\tclass ScanBudgetExceeded(Exception):\n690\t    \"\"\"Raised when ITIMER wall-clock budget is hit during scan().\"\"\"\n691\t\n692\t\n693\tdef _install_itimer_guard(budget_seconds: float) -> Optional[object]:\n694\t    \"\"\"Install SIGALRM ITIMER guard. Returns previous handler or None if unsupported.\n695\t\n696\t    Safe no-op on Windows (signal.setitimer raises AttributeError).\n697\t\n698\t    IMPORTANT ADVISORY (F-7.3-redos-itimer): On platforms without SIGALRM\n699\t    (Windows; some embedded Python runtimes), the ReDoS time-budget guard is\n700\t    NOT active. A pathologically-crafted input could cause unbounded scan time.\n701\t    Callers on such platforms should apply an external timeout or restrict\n702\t    input size to the DoS-safe pre-truncation limit.\n703\t    \"\"\"\n704\t    if not hasattr(signal, \"setitimer\"):\n705\t        # Emit an advisory breadcrumb so the absence of the guard is observable.\n706\t        # We use the stdlib logging module (no external deps) at DEBUG level so\n707\t        # the message appears in verbose runs but does not pollute normal output.\n708\t        _logger.debug(\n709\t            \"secret_patterns: ITIMER/SIGALRM unavailable on this platform \"\n710\t            \"(Windows or embedded runtime). ReDoS budget guard is inactive. \"\n711\t            \"Input size truncation via caller-side cap is the effective defense. \"\n712\t            \"breadcrumb=secret_scan_no_itimer_guard platform=%s\",\n713\t            __import__(\"sys\").platform,\n714\t        )\n715\t        return None\n716\t\n717\t    def _handler(signum, frame) -> None:\n718\t        raise ScanBudgetExceeded(\"scan() exceeded ITIMER budget\")\n719\t\n720\t    prev = signal.signal(signal.SIGALRM, _handler)\n721\t    signal.setitimer(signal.ITIMER_REAL, budget_seconds)\n722\t    return prev\n723\t\n724\t\n725\tdef _clear_itimer_guard(prev_handler: Optional[object]) -> None:\n726\t    if not hasattr(signal, \"setitimer\"):\n727\t        return\n728\t    signal.setitimer(signal.ITIMER_REAL, 0.0)  # disarm\n729\t    if prev_handler is not None:\n730\t        signal.signal(signal.SIGALRM, prev_handler)\n731\t\n732\t\n733\t# ---------------------------------------------------------------------------\n734\t# Two detection frames, ONE offset frame (the caller's original text)\n735\t# ---------------------------------------------------------------------------\n736\t#\n737\t# scan() matches every pattern in two frames and unions the findings:\n738\t#   (a) the ORIGINAL text, as written.\n739\t#   (b) the NFKC view (full-width, ligature, compatibility-homoglyph\n740\t#       evasion). Its spans are mapped BACK to original offsets through the\n741\t#       segment map below, so a finding never indexes a normalized string.\n742\t# Redaction then cuts the ORIGINAL text only: every character outside a\n743\t# finding is returned byte-identical. No normalized character can reach the\n744\t# output (full-width JSON punctuation stays full-width, confusables stay\n745\t# visible to a reviewer, and NFKC growth cannot inflate the output).\n746\t#\n747\t# Segment map. The original is cut BEFORE every ASCII character and before\n748\t# every character of _SAFE_CUT below; a segment is one such cut character\n749\t# (or the text start) plus the run of other characters after it, and is\n750\t# NFKC-normalized on its own. Segments NFKC leaves unchanged map 1:1 like\n751\t# the ASCII between them, so CJK, kana or Hangul prose around a full-width\n752\t# secret is never swallowed. A cut before an ASCII character ``a`` is\n753\t# composition-safe because NFKC(s) = compose(reorder(decompose_K(s))):\n754\t#   1. decompose_K works per character and every ASCII character decomposes\n755\t#      to itself, so decompose_K(x + a + y) = decompose_K(x) + a +\n756\t#      decompose_K(y).\n757\t#   2. Canonical reordering only swaps adjacent characters whose combining\n758\t#      class is > 0; every ASCII character has class 0, so nothing moves\n759\t#      across ``a``.\n760\t#   3. Canonical composition joins a character C to the LAST starter L before\n761\t#      it only if no starter sits between them. ``a`` is a starter, so nothing\n762\t#      after it composes with anything before it; ``a`` itself joins L only if\n763\t#      it is the SECOND element of a primary composite, and no ASCII character\n764\t#      is (the second elements are combining marks plus a few non-ASCII\n765\t#      starters such as Hangul V/T jamo).\n766\t# Hence NFKC(x + a + y) == NFKC(x) + NFKC(a + y) for every ASCII ``a``. The\n767\t# same three steps hold for any character ``c`` whose NFKD starts with a\n768\t# starter (class 0) that is never the second element of a primary\n769\t# composite: step 1 is per character, step 2 cannot cross that starter and\n770\t# step 3 cannot join it (or anything after it) to the left. _SAFE_CUT lists\n771\t# such characters explicitly; each one is checked against that derived\n772\t# property and against every character that can combine (composition\n773\t# firsts, class != 0, NFKC-changing) on the supported Unicode versions.\n774\t# Both claims are tested in test_secret_patterns.py, and the map is ALSO\n775\t# checked at runtime: if the segment images do not concatenate to\n776\t# NFKC(text) the map fails CLOSED to ONE segment spanning the whole text, so\n777\t# an NFKC-frame finding then redacts the whole text instead of leaking.\n778\t#\n779\t# Precision (\"peel\"): when a segment starts with a cut character ``s`` whose\n780\t# NFKD is ONE character and the segment's image starts with NFKC(s), ``s``\n781\t# composed with nothing after it (a primary composite differs from its first\n782\t# element), and by the same three steps NFKC(s + R) == NFKC(s) + NFKC(R);\n783\t# the segment is then split into [s][R], so a JSON quote, '=' or space right\n784\t# before a decomposed or ligature secret is not swallowed. NFKC(R) is\n785\t# computed on its own and goes through the same runtime concatenation check.\n786\t#\n787\t# A normalized finding maps to the UNION of the original segments it\n788\t# touches. Over-redaction is acceptable; leaking is not.\n789\t\n790\t# Non-ASCII characters before which a cut is also composition-safe (see the\n791\t# derived property above). Deliberately absent: U+302A-302F (combining\n792\t# ideographic tone marks), U+3099-309C (kana voicing marks, combining and\n793\t# spacing), U+FF9E/U+FF9F (half-width voicing marks, NFKD -> U+3099/309A),\n794\t# half-width Hangul and the Hangul V/T jamo U+1160-11FF (they compose onto a\n795\t# preceding L jamo or LV syllable).\n796\t_SAFE_CUT = (\n797\t    \"\\u3000-\\u3029\\u3030-\\u303f\"  # CJK symbols and punctuation\n798\t    \"\\u3041-\\u3096\\u309d-\\u309f\"  # hiragana letters, iteration marks\n799\t    \"\\u30a0-\\u30ff\"               # katakana letters, middle dot, prolonged mark\n800\t    \"\\u3400-\\u4dbf\\u4e00-\\u9fff\"  # CJK unified ideographs (+ extension A)\n801\t    \"\\uac00-\\ud7a3\"               # Hangul syllables\n802\t    \"\\uff01-\\uff5e\"               # full-width ASCII forms\n803\t)\n804\t# ``seg``: an optional _SAFE_CUT head + a run of characters that are neither\n805\t# ASCII nor _SAFE_CUT (an ASCII head is taken by the caller). ``run``: a run\n806\t# of _SAFE_CUT characters, each its own cut, minus the last one when a\n807\t# ``seg`` tail follows (that one heads the next ``seg``).\n808\t_SEGMENT_RE = re.compile(\n809\t    \"(?P<head>[{s}])?(?P<tail>[^\\\\x00-\\\\x7f{s}]+)|(?P<run>[{s}]+(?![^\\\\x00-\\\\x7f{s}]))\"\n810\t    .format(s=_SAFE_CUT)\n811\t)\n812\t\n813\t\n814\tdef _nfkc(s: str) -> str:\n815\t    return unicodedata.normalize(\"NFKC\", s)\n816\t\n817\t\n818\t_Segment = Tuple[int, int, int, int]  # (orig_start, orig_end, norm_start, norm_end)\n819\t\n820\t\n821\tdef _nfkc_segments(\n822\t    text: str,\n823\t    normalized: str,\n824\t    nfkc: Callable[[str], str] = _nfkc,\n825\t) -> List[_Segment]:\n826\t    \"\"\"Sorted, disjoint segments of ``text`` whose NFKC image differs.\n827\t\n828\t    The rest maps 1:1. Fails CLOSED to ONE whole-text segment when the images\n829\t    do not concatenate to ``normalized``; ``nfkc`` is injectable for a test.\n830\t    \"\"\"\n831\t    segments: List[_Segment] = []\n832\t    pieces: List[str] = []\n833\t    memo: Dict[str, str] = {}  # NFKC is a pure function of the segment\n834\t    pos = npos = 0\n835\t\n836\t    def image_of(s: str) -> str:\n837\t        image = memo.get(s)\n838\t        if image is None:\n839\t            image = memo[s] = nfkc(s)\n840\t        return image\n841\t\n842\t    def emit(start: int, end: int, image: str) -> None:\n843\t        nonlocal pos, npos\n844\t        if image == text[start:end]:\n845\t            return  # unchanged: maps 1:1, like the ASCII between segments\n846\t        pieces.append(text[pos:start])\n847\t        npos += start - pos\n848\t        pieces.append(image)\n849\t        segments.append((start, end, npos, npos + len(image)))\n850\t        npos += len(image)\n851\t        pos = end\n852\t    for m in _SEGMENT_RE.finditer(text):\n853\t        start, end = m.span()\n854\t        if m.group(\"run\") is not None:\n855\t            if image_of(m.group(\"run\")) != m.group(\"run\"):\n856\t                for i in range(start, end):  # every character is a cut\n857\t                    emit(i, i + 1, image_of(text[i]))\n858\t            continue\n859\t        if m.group(\"head\") is None and start > 0:\n860\t            start -= 1  # the ASCII head (a _SAFE_CUT head is in the match)\n861\t        head = text[start]\n862\t        image = image_of(text[start:end])\n863\t        if (start < m.start(\"tail\") and len(unicodedata.normalize(\"NFKD\", head)) == 1\n864\t                and image.startswith(image_of(head))):\n865\t            emit(start, start + 1, image_of(head))  # peel: head composed with nothing\n866\t            start, image = start + 1, image_of(text[start + 1:end])\n867\t        emit(start, end, image)\n868\t    if \"\".join(pieces) + text[pos:] != normalized:\n869\t        return [(0, len(text), 0, len(normalized))]\n870\t    return segments\n871\t\n872\t\n873\tdef _original_span(\n874\t    segments: List[_Segment],\n875\t    norm_starts: List[int],\n876\t    text_len: int,\n877\t    start: int,\n878\t    end: int,\n879\t) -> Tuple[int, int]:\n880\t    \"\"\"Original span covering every segment that normalized [start, end) touches.\"\"\"\n881\t\n882\t    def char_range(q: int) -> Tuple[int, int]:\n883\t        i = bisect.bisect_right(norm_starts, q) - 1\n884\t        if i < 0:\n885\t            return q, q + 1\n886\t        o_start, o_end, _n_start, n_end = segments[i]\n887\t        if q < n_end:\n888\t            return o_start, o_end\n889\t        return q - n_end + o_end, q - n_end + o_end + 1\n890\t\n891\t    lo = char_range(start)[0]\n892\t    hi = char_range(max(end - 1, start))[1]\n893\t    return min(lo, text_len), min(hi, text_len)\n894\t\n895\t\n896\tdef _map_to_original(text: str, normalized: str, findings: List[Finding]) -> List[Finding]:\n897\t    \"\"\"Re-express NFKC-frame findings in ``text`` offsets (over-covering).\"\"\"\n898\t    segments = _nfkc_segments(text, normalized)\n899\t    norm_starts = [seg[2] for seg in segments]\n900\t    mapped: List[Finding] = []\n901\t    for f in findings:\n902\t        lo, hi = _original_span(segments, norm_starts, len(text), f.start, f.end)\n903\t        mapped.append(f._replace(start=lo, end=hi))\n904\t    return mapped\n905\t\n906\t\n907\tdef _scan_frame(\n908\t    frame: str,\n909\t    patterns: List[SecretPattern],\n910\t    budget_seconds: float,\n911\t    findings: List[Finding],\n912\t) -> None:\n913\t    \"\"\"Append every validated match in ``frame`` to ``findings``.\"\"\"\n914\t    prev = _install_itimer_guard(budget_seconds)\n915\t    try:\n916\t        for p in patterns:\n917\t            for m in p.regex.finditer(frame):\n918\t                if p.validator is not None:\n919\t                    try:\n920\t                        if not p.validator(m.group(0)):\n921\t                            continue\n922\t                    except Exception:\n923\t                        # Validator crash → treat as false-positive (fail-open)\n924\t                        continue\n925\t                findings.append(Finding(\n926\t                    family_id=p.family_id,\n927\t                    category=p.category,\n928\t                    start=m.start(),\n929\t                    end=m.end(),\n930\t                    redaction_label=p.redaction_label,\n931\t                ))\n932\t    finally:\n933\t        _clear_itimer_guard(prev)\n934\t\n935\t\n936\tdef _merge_same_family(findings: List[Finding]) -> List[Finding]:\n937\t    \"\"\"One Finding per family per overlapping cluster, with the union span.\n938\t\n939\t    The two frames report the same secret twice when their spans differ;\n940\t    merging keeps ``len(findings)`` a per-secret count. Different families\n941\t    never merge.\n942\t    \"\"\"\n943\t    merged: List[Finding] = []\n944\t    last: Dict[str, int] = {}\n945\t    for f in sorted(findings, key=lambda x: (x.family_id, x.start, x.end)):\n946\t        i = last.get(f.family_id)\n947\t        if i is not None and f.start < merged[i].end:\n948\t            merged[i] = merged[i]._replace(end=max(merged[i].end, f.end))\n949\t        else:\n950\t            last[f.family_id] = len(merged)\n951\t            merged.append(f)\n952\t    merged.sort(key=lambda f: (f.start, f.family_id, f.end))\n953\t    return merged\n954\t\n955\t\n956\tdef scan(\n957\t    text: str,\n958\t    *,\n959\t    patterns: Optional[List[SecretPattern]] = None,\n960\t    budget_seconds: float = 0.5,\n961\t    normalize_unicode: bool = True,\n962\t) -> List[Finding]:\n963\t    \"\"\"Scan text for matches against the catalog. ReDoS-guarded.\n964\t\n965\t    Matches the historical frame -- the NFKC view when ``normalize_unicode``\n966\t    is on, else ``text`` -- and, when that view differs from ``text``, also\n967\t    ``text`` itself, and returns the union. Every offset indexes ``text``:\n968\t    NFKC-frame spans are mapped back through the segment map (they may\n969\t    over-cover, never under-cover).\n970\t\n971\t    Args:\n972\t        text: input to scan (str; bytes must be decoded by caller).\n973\t        patterns: which patterns to apply. Default = ALL_PATTERNS.\n974\t        budget_seconds: ITIMER wall-clock budget. Default 0.5s.\n975\t        normalize_unicode: also match the NFKC view (full-width / ligature /\n976\t            compatibility-homoglyph evasion). Default True.\n977\t\n978\t    Returns:\n979\t        Findings (empty if clean), one per family per overlapping cluster,\n980\t        ordered by (start, family_id, end).\n981\t\n982\t    Raises:\n983\t        ScanBudgetExceeded: as the historical scan did\n984\t            (callers fail open per security-engineer #2; the hook wrapper\n985\t            audit-emits `breadcrumb=secret_scan_timeout` and returns allow).\n986\t    \"\"\"\n987\t    if patterns is None:\n988\t        patterns = ALL_PATTERNS\n989\t    view = unicodedata.normalize(\"NFKC\", text) if normalize_unicode else text\n990\t    findings: List[Finding] = []\n991\t    _scan_frame(view, patterns, budget_seconds, findings)  # historical frame\n992\t    if view == text:\n993\t        return _merge_same_family(findings)\n994\t    if findings:\n995\t        findings = _map_to_original(text, view, findings)\n996\t    try:\n997\t        _scan_frame(text, patterns, budget_seconds, findings)\n998\t    except ScanBudgetExceeded:\n999\t        _logger.debug(\"secret_patterns: scan budget exceeded\")\n1000\t    return _merge_same_family(findings)\n1001\t\n1002\t\n1003\tdef _merged_runs(findings: List[Finding], text_len: int) -> List[Tuple[int, int, str]]:\n1004\t    \"\"\"Union of the finding spans as (start, end, label) runs, clamped to the text.\n1005\t\n1006\t    Overlapping and adjacent spans are merged before splicing. A merged run\n1007\t    carries the label of its leftmost (then longest) finding. Empty spans\n1008\t    are dropped.\n1009\t    \"\"\"\n1010\t    runs: List[Tuple[int, int, str]] = []\n1011\t    for f in sorted(findings, key=lambda x: (x.start, -x.end)):\n1012\t        start = min(max(f.start, 0), text_len)\n1013\t        end = min(max(f.end, start), text_len)\n1014\t        if end == start:\n1015\t            continue\n1016\t        if runs and start <= runs[-1][1]:\n1017\t            run_start, run_end, label = runs[-1]\n1018\t            runs[-1] = (run_start, max(run_end, end), label)\n1019\t        else:\n1020\t            runs.append((start, end, f.redaction_label))\n1021\t    return runs\n1022\t\n1023\t\n1024\tdef redact(text: str, findings: List[Finding]) -> str:\n1025\t    \"\"\"Replace the merged finding spans of ``text`` with their labels.\n1026\t\n1027\t    ``findings`` MUST come from ``scan()`` on this same ``text``: their\n1028\t    offsets index it directly (scan() already maps NFKC-frame matches back\n1029\t    to the original). Overlapping and adjacent spans are merged first; every\n1030\t    character outside the merged spans is returned byte-identical, so the\n1031\t    output grows only by (label length - span length) per merged run.\n1032\t\n1033\t    Pure function: no SIGALRM, no re-scan, never raises on Finding input.\n1034\t    Offsets outside the text are clamped to it; findings computed on a\n1035\t    DIFFERENT text are a caller error this function cannot detect.\n1036\t    \"\"\"\n1037\t    if not findings:\n1038\t        return text\n1039\t    parts: List[str] = []\n1040\t    pos = 0\n1041\t    for start, end, label in _merged_runs(findings, len(text)):\n1042\t        parts.append(text[pos:start])\n1043\t        parts.append(label)\n1044\t        pos = end\n1045\t    parts.append(text[pos:])\n1046\t    return \"\".join(parts)\n1047\t\n1048\t\n1049\tdef scan_and_redact(\n1050\t    text: str,\n1051\t    *,\n1052\t    patterns: Optional[List[SecretPattern]] = None,\n1053\t    budget_seconds: float = 0.5,\n1054\t    normalize_unicode: bool = True,\n1055\t) -> Tuple[str, List[Finding]]:\n1056\t    \"\"\"Scan + redact the SAME text. Returns (redacted_text, findings).\n1057\t\n1058\t    The redacted text is ``text`` with only the merged finding spans\n1059\t    replaced (see ``redact``); no normalization reaches the output.\n1060\t    \"\"\"\n1061\t    findings = scan(\n1062\t        text,\n1063\t        patterns=patterns,\n1064\t        budget_seconds=budget_seconds,\n1065\t        normalize_unicode=normalize_unicode,\n1066\t    )\n1067\t    return redact(text, findings), findings\n1068\t\n1069\t\n1070\tdef family_ids() -> List[str]:\n1071\t    \"\"\"Return all catalog family_id values. For audit-log inventory.\"\"\"\n1072\t    return [p.family_id for p in ALL_PATTERNS]\n1073\t\n1074\t\n1075\t# ---------------------------------------------------------------------------\n1076\t# Unified pattern registry (F-7.4-drift single source of truth)\n1077\t# ---------------------------------------------------------------------------\n1078\t#\n1079\t# These constants expose structured subsets of ALL_PATTERNS so downstream\n1080\t# libraries (pii_patterns, redact, codex_egress_redact) and their tests can\n1081\t# import the canonical catalog instead of re-defining the same sets.\n1082\t#\n1083\t# Usage (e.g. in test_redact_secrets_parity.py):\n1084\t#\n1085\t#   from _lib.secret_patterns import LGPD_FAMILY_IDS, CLOUD_KMS_FAMILY_IDS\n1086\t#   assert \"br_cpf\" in LGPD_FAMILY_IDS\n1087\t\n1088\t\n1089\tdef _family_ids_by_owasp(owasp_class: str) -> Tuple[str, ...]:\n1090\t    \"\"\"Return a sorted tuple of family_ids filtered by owasp_class.\"\"\"\n1091\t    return tuple(sorted(p.family_id for p in ALL_PATTERNS if p.owasp_class == owasp_class))\n1092\t\n1093\t\n1094\tdef _family_ids_by_category(category: str) -> Tuple[str, ...]:\n1095\t    \"\"\"Return a sorted tuple of family_ids filtered by category.\"\"\"\n1096\t    return tuple(sorted(p.family_id for p in ALL_PATTERNS if p.category == category))\n1097\t\n1098\t\n1099\t#: Frozenset of all canonical family_id values (single source of truth)."}]},"parent_tool_use_id":null,"session_id":"99e4484c-9fd2-48bc-96cb-ca1217c6fa39","uuid":"12853520-d703-42a2-a04d-6b0d74641d22","timestamp":"2026-11-15T10:31:29.272Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/secret_patterns.py","content":"\nALL_PATTERNS: List[SecretPattern] = SECRETS + PII\n\n\n# ---------------------------------------------------------------------------\n# Scan API — ReDoS-guarded\n# ---------------------------------------------------------------------------\n\n\nclass ScanBudgetExceeded(Exception):\n    \"\"\"Raised when ITIMER wall-clock budget is hit during scan().\"\"\"\n\n\ndef _install_itimer_guard(budget_seconds: float) -> Optional[object]:\n    \"\"\"Install SIGALRM ITIMER guard. Returns previous handler or None if unsupported.\n\n    Safe no-op on Windows (signal.setitimer raises AttributeError).\n\n    IMPORTANT ADVISORY (F-7.3-redos-itimer): On platforms without SIGALRM\n    (Windows; some embedded Python runtimes), the ReDoS time-budget guard is\n    NOT active. A pathologically-crafted input could cause unbounded scan time.\n    Callers on such platforms should apply an external timeout or restrict\n    input size to the DoS-safe pre-truncation limit.\n    \"\"\"\n    if not hasattr(signal, \"setitimer\"):\n        # Emit an advisory breadcrumb so the absence of the guard is observable.\n        # We use the stdlib logging module (no external deps) at DEBUG level so\n        # the message appears in verbose runs but does not pollute normal output.\n        _logger.debug(\n            \"secret_patterns: ITIMER/SIGALRM unavailable on this platform \"\n            \"(Windows or embedded runtime). ReDoS budget guard is inactive. \"\n            \"Input size truncation via caller-side cap is the effective defense. \"\n            \"breadcrumb=secret_scan_no_itimer_guard platform=%s\",\n            __import__(\"sys\").platform,\n        )\n        return None\n\n    def _handler(signum, frame) -> None:\n        raise ScanBudgetExceeded(\"scan() exceeded ITIMER budget\")\n\n    prev = signal.signal(signal.SIGALRM, _handler)\n    signal.setitimer(signal.ITIMER_REAL, budget_seconds)\n    return prev\n\n\ndef _clear_itimer_guard(prev_handler: Optional[object]) -> None:\n    if not hasattr(signal, \"setitimer\"):\n        return\n    signal.setitimer(signal.ITIMER_REAL, 0.0)  # disarm\n    if prev_handler is not None:\n        signal.signal(signal.SIGALRM, prev_handler)\n\n\n# ---------------------------------------------------------------------------\n# Two detection frames, ONE offset frame (the caller's original text)\n# ---------------------------------------------------------------------------\n#\n# scan() matches every pattern in two frames and unions the findings:\n#   (a) the ORIGINAL text, as written.\n#   (b) the NFKC view (full-width, ligature, compatibility-homoglyph\n#       evasion). Its spans are mapped BACK to original offsets through the\n#       segment map below, so a finding never indexes a normalized string.\n# Redaction then cuts the ORIGINAL text only: every character outside a\n# finding is returned byte-identical. No normalized character can reach the\n# output (full-width JSON punctuation stays full-width, confusables stay\n# visible to a reviewer, and NFKC growth cannot inflate the output).\n#\n# Segment map. The original is cut BEFORE every ASCII character and before\n# every character of _SAFE_CUT below; a segment is one such cut character\n# (or the text start) plus the run of other characters after it, and is\n# NFKC-normalized on its own. Segments NFKC leaves unchanged map 1:1 like\n# the ASCII between them, so CJK, kana or Hangul prose around a full-width\n# secret is never swallowed. A cut before an ASCII character ``a`` is\n# composition-safe because NFKC(s) = compose(reorder(decompose_K(s))):\n#   1. decompose_K works per character and every ASCII character decomposes\n#      to itself, so decompose_K(x + a + y) = decompose_K(x) + a +\n#      decompose_K(y).\n#   2. Canonical reordering only swaps adjacent characters whose combining\n#      class is > 0; every ASCII character has class 0, so nothing moves\n#      across ``a``.\n#   3. Canonical composition joins a character C to the LAST starter L before\n#      it only if no starter sits between them. ``a`` is a starter, so nothing\n#      after it composes with anything before it; ``a`` itself joins L only if\n#      it is the SECOND element of a primary composite, and no ASCII character\n#      is (the second elements are combining marks plus a few non-ASCII\n#      starters such as Hangul V/T jamo).\n# Hence NFKC(x + a + y) == NFKC(x) + NFKC(a + y) for every ASCII ``a``. The\n# same three steps hold for any character ``c`` whose NFKD starts with a\n# starter (class 0) that is never the second element of a primary\n# composite: step 1 is per character, step 2 cannot cross that starter and\n# step 3 cannot join it (or anything after it) to the left. _SAFE_CUT lists\n# such characters explicitly; each one is checked against that derived\n# property and against every character that can combine (composition\n# firsts, class != 0, NFKC-changing) on the supported Unicode versions.\n# Both claims are tested in test_secret_patterns.py, and the map is ALSO\n# checked at runtime: if the segment images do not concatenate to\n# NFKC(text) the map fails CLOSED to ONE segment spanning the whole text, so\n# an NFKC-frame finding then redacts the whole text instead of leaking.\n#\n# Precision (\"peel\"): when a segment starts with a cut character ``s`` whose\n# NFKD is ONE character and the segment's image starts with NFKC(s), ``s``\n# composed with nothing after it (a primary composite differs from its first\n# element), and by the same three steps NFKC(s + R) == NFKC(s) + NFKC(R);\n# the segment is then split into [s][R], so a JSON quote, '=' or space right\n# before a decomposed or ligature secret is not swallowed. NFKC(R) is\n# computed on its own and goes through the same runtime concatenation check.\n#\n# A normalized finding maps to the UNION of the original segments it\n# touches. Over-redaction is acceptable; leaking is not.\n\n# Non-ASCII characters before which a cut is also composition-safe (see the\n# derived property above). Deliberately absent: U+302A-302F (combining\n# ideographic tone marks), U+3099-309C (kana voicing marks, combining and\n# spacing), U+FF9E/U+FF9F (half-width voicing marks, NFKD -> U+3099/309A),\n# half-width Hangul and the Hangul V/T jamo U+1160-11FF (they compose onto a\n# preceding L jamo or LV syllable).\n_SAFE_CUT = (\n    \"\\u3000-\\u3029\\u3030-\\u303f\"  # CJK symbols and punctuation\n    \"\\u3041-\\u3096\\u309d-\\u309f\"  # hiragana letters, iteration marks\n    \"\\u30a0-\\u30ff\"               # katakana letters, middle dot, prolonged mark\n    \"\\u3400-\\u4dbf\\u4e00-\\u9fff\"  # CJK unified ideographs (+ extension A)\n    \"\\uac00-\\ud7a3\"               # Hangul syllables\n    \"\\uff01-\\uff5e\"               # full-width ASCII forms\n)\n# ``seg``: an optional _SAFE_CUT head + a run of characters that are neither\n# ASCII nor _SAFE_CUT (an ASCII head is taken by the caller). ``run``: a run\n# of _SAFE_CUT characters, each its own cut, minus the last one when a\n# ``seg`` tail follows (that one heads the next ``seg``).\n_SEGMENT_RE = re.compile(\n    \"(?P<head>[{s}])?(?P<tail>[^\\\\x00-\\\\x7f{s}]+)|(?P<run>[{s}]+(?![^\\\\x00-\\\\x7f{s}]))\"\n    .format(s=_SAFE_CUT)\n)\n\n\ndef _nfkc(s: str) -> str:\n    return unicodedata.normalize(\"NFKC\", s)\n\n\n_Segment = Tuple[int, int, int, int]  # (orig_start, orig_end, norm_start, norm_end)\n\n\ndef _nfkc_segments(\n    text: str,\n    normalized: str,\n    nfkc: Callable[[str], str] = _nfkc,\n) -> List[_Segment]:\n    \"\"\"Sorted, disjoint segments of ``text`` whose NFKC image differs.\n\n    The rest maps 1:1. Fails CLOSED to ONE whole-text segment when the images\n    do not concatenate to ``normalized``; ``nfkc`` is injectable for a test.\n    \"\"\"\n    segments: List[_Segment] = []\n    pieces: List[str] = []\n    memo: Dict[str, str] = {}  # NFKC is a pure function of the segment\n    pos = npos = 0\n\n    def image_of(s: str) -> str:\n        image = memo.get(s)\n        if image is None:\n            image = memo[s] = nfkc(s)\n        return image\n\n    def emit(start: int, end: int, image: str) -> None:\n        nonlocal pos, npos\n        if image == text[start:end]:\n            return  # unchanged: maps 1:1, like the ASCII between segments\n        pieces.append(text[pos:start])\n        npos += start - pos\n        pieces.append(image)\n        segments.append((start, end, npos, npos + len(image)))\n        npos += len(image)\n        pos = end\n    for m in _SEGMENT_RE.finditer(text):\n        start, end = m.span()\n        if m.group(\"run\") is not None:\n            if image_of(m.group(\"run\")) != m.group(\"run\"):\n                for i in range(start, end):  # every character is a cut\n                    emit(i, i + 1, image_of(text[i]))\n            continue\n        if m.group(\"head\") is None and start > 0:\n            start -= 1  # the ASCII head (a _SAFE_CUT head is in the match)\n        head = text[start]\n        image = image_of(text[start:end])\n        if (start < m.start(\"tail\") and len(unicodedata.normalize(\"NFKD\", head)) == 1\n                and image.startswith(image_of(head))):\n            emit(start, start + 1, image_of(head))  # peel: head composed with nothing\n            start, image = start + 1, image_of(text[start + 1:end])\n        emit(start, end, image)\n    if \"\".join(pieces) + text[pos:] != normalized:\n        return [(0, len(text), 0, len(normalized))]\n    return segments\n\n\ndef _original_span(\n    segments: List[_Segment],\n    norm_starts: List[int],\n    text_len: int,\n    start: int,\n    end: int,\n) -> Tuple[int, int]:\n    \"\"\"Original span covering every segment that normalized [start, end) touches.\"\"\"\n\n    def char_range(q: int) -> Tuple[int, int]:\n        i = bisect.bisect_right(norm_starts, q) - 1\n        if i < 0:\n            return q, q + 1\n        o_start, o_end, _n_start, n_end = segments[i]\n        if q < n_end:\n            return o_start, o_end\n        return q - n_end + o_end, q - n_end + o_end + 1\n\n    lo = char_range(start)[0]\n    hi = char_range(max(end - 1, start))[1]\n    return min(lo, text_len), min(hi, text_len)\n\n\ndef _map_to_original(text: str, normalized: str, findings: List[Finding]) -> List[Finding]:\n    \"\"\"Re-express NFKC-frame findings in ``text`` offsets (over-covering).\"\"\"\n    segments = _nfkc_segments(text, normalized)\n    norm_starts = [seg[2] for seg in segments]\n    mapped: List[Finding] = []\n    for f in findings:\n        lo, hi = _original_span(segments, norm_starts, len(text), f.start, f.end)\n        mapped.append(f._replace(start=lo, end=hi))\n    return mapped\n\n\ndef _scan_frame(\n    frame: str,\n    patterns: List[SecretPattern],\n    budget_seconds: float,\n    findings: List[Finding],\n) -> None:\n    \"\"\"Append every validated match in ``frame`` to ``findings``.\"\"\"\n    prev = _install_itimer_guard(budget_seconds)\n    try:\n        for p in patterns:\n            for m in p.regex.finditer(frame):\n                if p.validator is not None:\n                    try:\n                        if not p.validator(m.group(0)):\n                            continue\n                    except Exception:\n                        # Validator crash → treat as false-positive (fail-open)\n                        continue\n                findings.append(Finding(\n                    family_id=p.family_id,\n                    category=p.category,\n                    start=m.start(),\n                    end=m.end(),\n                    redaction_label=p.redaction_label,\n                ))\n    finally:\n        _clear_itimer_guard(prev)\n\n\ndef _merge_same_family(findings: List[Finding]) -> List[Finding]:\n    \"\"\"One Finding per family per overlapping cluster, with the union span.\n\n    The two frames report the same secret twice when their spans differ;\n    merging keeps ``len(findings)`` a per-secret count. Different families\n    never merge.\n    \"\"\"\n    merged: List[Finding] = []\n    last: Dict[str, int] = {}\n    for f in sorted(findings, key=lambda x: (x.family_id, x.start, x.end)):\n        i = last.get(f.family_id)\n        if i is not None and f.start < merged[i].end:\n            merged[i] = merged[i]._replace(end=max(merged[i].end, f.end))\n        else:\n            last[f.family_id] = len(merged)\n            merged.append(f)\n    merged.sort(key=lambda f: (f.start, f.family_id, f.end))\n    return merged\n\n\ndef scan(\n    text: str,\n    *,\n    patterns: Optional[List[SecretPattern]] = None,\n    budget_seconds: float = 0.5,\n    normalize_unicode: bool = True,\n) -> List[Finding]:\n    \"\"\"Scan text for matches against the catalog. ReDoS-guarded.\n\n    Matches the historical frame -- the NFKC view when ``normalize_unicode``\n    is on, else ``text`` -- and, when that view differs from ``text``, also\n    ``text`` itself, and returns the union. Every offset indexes ``text``:\n    NFKC-frame spans are mapped back through the segment map (they may\n    over-cover, never under-cover).\n\n    Args:\n        text: input to scan (str; bytes must be decoded by caller).\n        patterns: which patterns to apply. Default = ALL_PATTERNS.\n        budget_seconds: ITIMER wall-clock budget. Default 0.5s.\n        normalize_unicode: also match the NFKC view (full-width / ligature /\n            compatibility-homoglyph evasion). Default True.\n\n    Returns:\n        Findings (empty if clean), one per family per overlapping cluster,\n        ordered by (start, family_id, end).\n\n    Raises:\n        ScanBudgetExceeded: as the historical scan did\n            (callers fail open per security-engineer #2; the hook wrapper\n            audit-emits `breadcrumb=secret_scan_timeout` and returns allow).\n    \"\"\"\n    if patterns is None:\n        patterns = ALL_PATTERNS\n    view = unicodedata.normalize(\"NFKC\", text) if normalize_unicode else text\n    findings: List[Finding] = []\n    _scan_frame(view, patterns, budget_seconds, findings)  # historical frame\n    if view == text:\n        return _merge_same_family(findings)\n    if findings:\n        findings = _map_to_original(text, view, findings)\n    try:\n        _scan_frame(text, patterns, budget_seconds, findings)\n    except ScanBudgetExceeded:\n        _logger.debug(\"secret_patterns: scan budget exceeded\")\n    return _merge_same_family(findings)\n\n\ndef _merged_runs(findings: List[Finding], text_len: int) -> List[Tuple[int, int, str]]:\n    \"\"\"Union of the finding spans as (start, end, label) runs, clamped to the text.\n\n    Overlapping and adjacent spans are merged before splicing. A merged run\n    carries the label of its leftmost (then longest) finding. Empty spans\n    are dropped.\n    \"\"\"\n    runs: List[Tuple[int, int, str]] = []\n    for f in sorted(findings, key=lambda x: (x.start, -x.end)):\n        start = min(max(f.start, 0), text_len)\n        end = min(max(f.end, start), text_len)\n        if end == start:\n            continue\n        if runs and start <= runs[-1][1]:\n            run_start, run_end, label = runs[-1]\n            runs[-1] = (run_start, max(run_end, end), label)\n        else:\n            runs.append((start, end, f.redaction_label))\n    return runs\n\n\ndef redact(text: str, findings: List[Finding]) -> str:\n    \"\"\"Replace the merged finding spans of ``text`` with their labels.\n\n    ``findings`` MUST come from ``scan()`` on this same ``text``: their\n    offsets index it directly (scan() already maps NFKC-frame matches back\n    to the original). Overlapping and adjacent spans are merged first; every\n    character outside the merged spans is returned byte-identical, so the\n    output grows only by (label length - span length) per merged run.\n\n    Pure function: no SIGALRM, no re-scan, never raises on Finding input.\n    Offsets outside the text are clamped to it; findings computed on a\n    DIFFERENT text are a caller error this function cannot detect.\n    \"\"\"\n    if not findings:\n        return text\n    parts: List[str] = []\n    pos = 0\n    for start, end, label in _merged_runs(findings, len(text)):\n        parts.append(text[pos:start])\n        parts.append(label)\n        pos = end\n    parts.append(text[pos:])\n    return \"\".join(parts)\n\n\ndef scan_and_redact(\n    text: str,\n    *,\n    patterns: Optional[List[SecretPattern]] = None,\n    budget_seconds: float = 0.5,\n    normalize_unicode: bool = True,\n) -> Tuple[str, List[Finding]]:\n    \"\"\"Scan + redact the SAME text. Returns (redacted_text, findings).\n\n    The redacted text is ``text`` with only the merged finding spans\n    replaced (see ``redact``); no normalization reaches the output.\n    \"\"\"\n    findings = scan(\n        text,\n        patterns=patterns,\n        budget_seconds=budget_seconds,\n        normalize_unicode=normalize_unicode,\n    )\n    return redact(text, findings), findings\n\n\ndef family_ids() -> List[str]:\n    \"\"\"Return all catalog family_id values. For audit-log inventory.\"\"\"\n    return [p.family_id for p in ALL_PATTERNS]\n\n\n# ---------------------------------------------------------------------------\n# Unified pattern registry (F-7.4-drift single source of truth)\n# ---------------------------------------------------------------------------\n#\n# These constants expose structured subsets of ALL_PATTERNS so downstream\n# libraries (pii_patterns, redact, codex_egress_redact) and their tests can\n# import the canonical catalog instead of re-defining the same sets.\n#\n# Usage (e.g. in test_redact_secrets_parity.py):\n#\n#   from _lib.secret_patterns import LGPD_FAMILY_IDS, CLOUD_KMS_FAMILY_IDS\n#   assert \"br_cpf\" in LGPD_FAMILY_IDS\n\n\ndef _family_ids_by_owasp(owasp_class: str) -> Tuple[str, ...]:\n    \"\"\"Return a sorted tuple of family_ids filtered by owasp_class.\"\"\"\n    return tuple(sorted(p.family_id for p in ALL_PATTERNS if p.owasp_class == owasp_class))\n\n\ndef _family_ids_by_category(category: str) -> Tuple[str, ...]:\n    \"\"\"Return a sorted tuple of family_ids filtered by category.\"\"\"\n    return tuple(sorted(p.family_id for p in ALL_PATTERNS if p.category == category))\n\n\n#: Frozenset of all canonical family_id values (single source of truth).","numLines":420,"startLine":680,"totalLines":1167}},"tool_result_meta":[{"id":"toolu_01H8dfk42UpcMyJ8L5gNiruk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
