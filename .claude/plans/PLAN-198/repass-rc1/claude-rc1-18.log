{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VejGHbrV63h9H75xCi78qv","type":"tool_result","content":"1\t\"\"\"Declarations extracted from federation.server; loaded by the facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tclass _HandlerAuth:\n5\t    \"\"\"Per-request handler. Wired by :class:`FederationServer`.\"\"\"\n6\t\n7\t    server_version = \"CEOFederation/1.0\"\n8\t    sys_version = \"\"  # don't leak Python version\n9\t\n10\t    # AC16 — fail-fast timeout per request.\n11\t    timeout = HANDSHAKE_TIMEOUT_SECONDS\n12\t\n13\t    def log_message(self, format: str, *args: Any) -> None:  # noqa: A002\n14\t        return  # silent — audit-log is the canonical record\n15\t\n16\t    # AC15 mechanical method allowlist. PLAN-112-FOLLOWUP W1: POST is\n17\t    # admitted ONLY when write-mode is active (Layer 0a env AND Layer 0b\n18\t    # sentinel). When write-mode is OFF, the module constant\n19\t    # ALLOWED_HTTP_METHODS = (\"GET\",) is the effective set and POST → 405.\n20\t    def parse_request(self) -> bool:\n21\t        ok = http.server.BaseHTTPRequestHandler.parse_request(self)\n22\t        if not ok:\n23\t            return ok\n24\t        method = (self.command or \"\").upper()\n25\t        if method in ALLOWED_HTTP_METHODS:\n26\t            return True\n27\t        # Non-GET. POST is conditionally allowed when write-mode active.\n28\t        if method == \"POST\" and self._write_mode_active():\n29\t            return True\n30\t        self._emit_write_blocked()\n31\t        self._send_405()\n32\t        return False\n33\t\n34\t    # -- Write-mode activation gates (PLAN-112-FOLLOWUP W1) -------------\n35\t\n36\t    def _write_mode_active(self) -> bool:\n37\t        \"\"\"Layer 0a AND Layer 0b — write-mode is reachable.\n38\t\n39\t        Default-OFF (AC1/AC7): BOTH the env switch (Layer 0a) AND the\n40\t        write-enable sentinel (Layer 0b / Gate #8) must pass. Either OFF\n41\t        → False → POST stays 405. Fail-CLOSED on any error.\n42\t        \"\"\"\n43\t        try:\n44\t            if not write_mode_enabled_from_env():\n45\t                return False\n46\t            return self._write_enable_sentinel_valid()\n47\t        except Exception:\n48\t            return False\n49\t\n50\t    def _emit_write_blocked(self) -> None:\n51\t        # AC15 — every non-allowed method-allowlist violation emits.\n52\t        peer_fpr = self._lookup_peer_fpr()\n53\t        correlation = self.headers.get(CORRELATION_ID_HEADER, \"\") or \"\"\n54\t        _safe_emit(\n55\t            \"federation_write_attempt_blocked\",\n56\t            method=str(self.command)[:16] if self.command else \"\",\n57\t            path=str(self.path)[:128] if self.path else \"\",\n58\t            peer_id_cert_fingerprint=peer_fpr,\n59\t            client_ip=self._client_ip(),\n60\t            fed_correlation_id=correlation[:64],\n61\t        )\n62\t\n63\t    def _send_405(self) -> None:\n64\t        self.send_response(405)\n65\t        # Advertise POST only when write-mode is active.\n66\t        allow = \"GET, POST\" if self._write_mode_active() else \"GET\"\n67\t        self.send_header(\"Allow\", allow)\n68\t        self.send_header(\"Content-Type\", \"application/json\")\n69\t        self.send_header(\"Connection\", \"close\")\n70\t        body = b'{\"error\":\"method_not_allowed\"}'\n71\t        self.send_header(\"Content-Length\", str(len(body)))\n72\t        self.end_headers()\n73\t        self.wfile.write(body)\n74\t\n75\t    def do_POST(self) -> None:  # noqa: N802 — base-class convention\n76\t        # PLAN-112-FOLLOWUP W1/W2 — when write-mode is OFF, behave exactly\n77\t        # as before (emit blocked + 405). When ON, run the 11-gate\n78\t        # dispatcher.\n79\t        if not self._write_mode_active():\n80\t            self._emit_write_blocked()\n81\t            self._send_405()\n82\t            return\n83\t        self._dispatch_write(method=\"POST\")\n84\t\n85\t    def do_PUT(self) -> None:  # noqa: N802\n86\t        self._emit_write_blocked()\n87\t        self._send_405()\n88\t\n89\t    def do_PATCH(self) -> None:  # noqa: N802\n90\t        self._emit_write_blocked()\n91\t        self._send_405()\n92\t\n93\t    def do_DELETE(self) -> None:  # noqa: N802\n94\t        self._emit_write_blocked()\n95\t        self._send_405()\n96\t\n97\t    def do_OPTIONS(self) -> None:  # noqa: N802\n98\t        self._emit_write_blocked()\n99\t        self._send_405()\n100\t\n101\t    def do_HEAD(self) -> None:  # noqa: N802\n102\t        self._emit_write_blocked()\n103\t        self._send_405()\n104\t\n105\t    # -- Common helpers --------------------------------------------------\n106\t\n107\t    def _client_ip(self) -> str:\n108\t        try:\n109\t            return self.client_address[0] if self.client_address else \"\"\n110\t        except (AttributeError, IndexError):\n111\t            return \"\"\n112\t\n113\t    def _ip_prefix(self) -> str:\n114\t        \"\"\"Return a /24 (v4) or /48 (v6) prefix of the client IP.\n115\t\n116\t        Used as the rate-limit discriminator (LLM06/GDPR — never log the\n117\t        full client IP). Best-effort; empty on any error.\n118\t        \"\"\"\n119\t        ip = self._client_ip()\n120\t        if not ip:\n121\t            return \"\"\n122\t        try:\n123\t            addr = ipaddress.ip_address(ip)\n124\t        except ValueError:\n125\t            return \"\"\n126\t        try:\n127\t            if addr.version == 4:\n128\t                net = ipaddress.ip_network(ip + \"/24\", strict=False)\n129\t            else:\n130\t                net = ipaddress.ip_network(ip + \"/48\", strict=False)\n131\t            return str(net.network_address)\n132\t        except ValueError:\n133\t            return \"\"\n134\t\n135\t    def _lookup_peer_fpr(self) -> str:\n136\t        try:\n137\t            der = self.connection.getpeercert(True)  # type: ignore[union-attr]\n138\t        except (AttributeError, ssl.SSLError):\n139\t            return \"\"\n140\t        if not der:\n141\t            return \"\"\n142\t        return hashlib.sha256(der).hexdigest()\n143\t\n144\t    def _presented_cert_pem_bytes(self) -> bytes:\n145\t        try:\n146\t            der = self.connection.getpeercert(True)  # type: ignore[union-attr]\n147\t        except (AttributeError, ssl.SSLError):\n148\t            return b\"\"\n149\t        if not der:\n150\t            return b\"\"\n151\t        try:\n152\t            return ssl.DER_cert_to_PEM_cert(der).encode(\"ascii\")\n153\t        except (TypeError, ValueError, UnicodeEncodeError):\n154\t            return b\"\"\n155\t\n156\t    def _lookup_peer_record(self) -> Optional[PeerRecord]:\n157\t        # PLAN-112-FOLLOWUP W3/R-IT-B: refresh the peer list before SPKI\n158\t        # match so a revocation propagates at the connection-accept layer\n159\t        # too (not only Gate #7).\n160\t        try:\n161\t            _maybe_reload_peers(self.server)\n162\t        except Exception:\n163\t            pass  # reload is best-effort; fail-open on infra only\n164\t        peers = getattr(self.server, \"federation_peers\", {})\n165\t        peers_extra = getattr(self.server, \"federation_peers_extra\", {}) or {}\n166\t        if not peers:\n167\t            return None\n168\t\n169\t        presented_der_fpr = self._lookup_peer_fpr()\n170\t        if not presented_der_fpr:\n171\t            return None\n172\t\n173\t        presented_pem = self._presented_cert_pem_bytes()\n174\t        presented_spki_fpr = \"\"\n175\t        spki_compute_attempted = False\n176\t        spki_compute_error: Optional[str] = None\n177\t\n178\t        for peer in peers.values():\n179\t            if peer.revoked:\n180\t                continue\n181\t            extra = peers_extra.get(peer.peer_id, {}) if peers_extra else {}\n182\t            spki_from_record = peer.peer_id_spki_fingerprint\n183\t            spki_from_extra = extra.get(\"peer_id_spki_fingerprint\", \"\") if isinstance(extra, dict) else \"\"\n184\t            effective_spki = spki_from_record or spki_from_extra or \"\"\n185\t            peer_row = {\n186\t                \"peer_id\": peer.peer_id,\n187\t                \"peer_id_spki_fingerprint\": effective_spki,\n188\t                \"peer_id_cert_fingerprint\": peer.peer_id_cert_fingerprint,\n189\t            }\n190\t            try:\n191\t                pin_type, pin_value = select_pin_for_peer(peer_row)\n192\t            except PinSelectionError:\n193\t                self._emit_peer_invalid_no_fingerprint(peer.peer_id)\n194\t                continue\n195\t\n196\t            if pin_type == \"spki\":\n197\t                if not spki_compute_attempted:\n198\t                    spki_compute_attempted = True\n199\t                    if presented_pem:\n200\t                        try:\n201\t                            presented_spki_fpr = compute_spki_fingerprint(\n202\t                                presented_pem\n203\t                            )\n204\t                        except (ImportError, ValueError, TypeError) as exc:\n205\t                            spki_compute_error = (\n206\t                                \"{0}:{1}\".format(\n207\t                                    type(exc).__name__, str(exc)[:64]\n208\t                                )\n209\t                            )\n210\t                            presented_spki_fpr = \"\"\n211\t                if not presented_spki_fpr:\n212\t                    self._emit_spki_fingerprint_mismatch(\n213\t                        peer.peer_id,\n214\t                        reason=\"presented_spki_compute_failed:{0}\".format(\n215\t                            spki_compute_error or \"no_pem\"\n216\t                        ),\n217\t                    )\n218\t                    continue\n219\t                if compare_fingerprints(presented_spki_fpr, pin_value):\n220\t                    return peer\n221\t                self._emit_spki_fingerprint_mismatch(\n222\t                    peer.peer_id, reason=\"spki_mismatch\"\n223\t                )\n224\t                continue\n225\t\n226\t            if compare_fingerprints(presented_der_fpr, pin_value):\n227\t                self._emit_pin_legacy_used(peer.peer_id)\n228\t                return peer\n229\t            continue\n230\t\n231\t        return None\n232\t\n233\t    def _resolve_peer(self) -> Optional[PeerRecord]:\n234\t        \"\"\"Public alias for :meth:`_lookup_peer_record` (Wave D contract).\"\"\"\n235\t        return self._lookup_peer_record()\n236\t\n237\t    # Wave C audit emit wrappers.\n238\t    def _emit_spki_fingerprint_mismatch(\n239\t        self, peer_id: str, reason: str = \"spki_mismatch\",\n240\t    ) -> None:\n241\t        presented_fpr = self._lookup_peer_fpr() or \"\"\n242\t        _safe_emit(\n243\t            \"federation_spki_fingerprint_mismatch\",\n244\t            peer_id=peer_id[:64],\n245\t            expected_prefix=\"\",\n246\t            presented_prefix=presented_fpr[:16],\n247\t            route=str(self.path or \"\")[:64],\n248\t        )\n249\t\n250\t    def _emit_pin_legacy_used(self, peer_id: str) -> None:\n251\t        der_fpr = self._lookup_peer_fpr() or \"\"\n252\t        _safe_emit(\n253\t            \"federation_pin_legacy_used\",\n254\t            peer_id=peer_id[:64],\n255\t            route=str(self.path or \"\")[:64],\n256\t            der_fingerprint_prefix=der_fpr[:16],\n257\t        )\n258\t\n259\t    def _emit_peer_invalid_no_fingerprint(self, peer_id: str) -> None:\n260\t        source_path = str(getattr(\n261\t            getattr(self, \"server\", None),\n262\t            \"federation_peers_path\",\n263\t            \".claude/data/federation/peers.yaml\",\n264\t        ))\n265\t        _safe_emit(\n266\t            \"federation_peer_invalid_no_fingerprint\",\n267\t            peer_id=peer_id[:64],\n268\t            source_path=source_path[:128],\n269\t        )\n270\t\n271\t    def _emit_connection_rejected(self, reason: str) -> None:\n272\t        _safe_emit(\n273\t            \"federation_connection_rejected\",\n274\t            peer_id_cert_fingerprint=self._lookup_peer_fpr(),\n275\t            client_ip=self._client_ip(),\n276\t            reason=reason[:64],\n277\t        )\n278\t\n279\t    def _emit_connection_accepted(self, peer_id: str) -> None:\n280\t        correlation = self.headers.get(CORRELATION_ID_HEADER, \"\") or \"\"\n281\t        _safe_emit(\n282\t            \"federation_connection_accepted\",\n283\t            peer_id=peer_id[:64],\n284\t            client_ip=self._client_ip(),\n285\t            fed_correlation_id=correlation[:64],\n286\t        )\n287\t\n288\t    # -- Replay + signature verification (AC13) -------------------------\n289\t\n290\t    def _replay_freshness_preflight(\n291\t        self, peer: PeerRecord,\n292\t    ) -> Optional[str]:\n293\t        \"\"\"R-SE-a Gate #3a — NON-mutating timestamp-window preflight.\n294\t\n295\t        Runs BEFORE the body read. Returns None if fresh, else a reason.\n296\t        Does NOT touch the nonce ring (no state mutation) so an unauth /\n297\t        replayed peer cannot poison the ring before HMAC verification.\n298\t        \"\"\"\n299\t        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n300\t        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n301\t        sig = self.headers.get(\"X-CEO-Federation-Signature\", \"\")\n302\t        if not (nonce and ts and sig):\n303\t            return \"missing_replay_headers\"\n304\t        try:\n305\t            parsed = parse_rfc3339_utc(ts)\n306\t        except ValueError:\n307\t            return \"malformed_timestamp\"\n308\t        skew = abs(parsed.timestamp() - time.time())\n309\t        if skew > MAX_CLOCK_SKEW_SECONDS:\n310\t            return \"clock_skew\"\n311\t        return None\n312\t\n313\t    def _verify_signature_only(\n314\t        self, peer: PeerRecord, body: bytes,\n315\t    ) -> Optional[str]:\n316\t        \"\"\"R-SE-a Gate #3c — HMAC signature verify (needs body). No mutation.\"\"\"\n317\t        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n318\t        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n319\t        sig = self.headers.get(\"X-CEO-Federation-Signature\", \"\")\n320\t        try:\n321\t            from .replay import verify_signature  # type: ignore[import]\n322\t        except ImportError:\n323\t            from replay import verify_signature  # type: ignore[no-redef]\n324\t        ok = verify_signature(\n325\t            self.command or \"\", self.path or \"\", ts, nonce, body,\n326\t            peer.hmac_secret_hex, sig,\n327\t        )\n328\t        return None if ok else \"signature_invalid\"\n329\t\n330\t    def _commit_nonce(self, peer: PeerRecord) -> Optional[str]:\n331\t        \"\"\"R-SE-a Gate #3d — MUTATING nonce commit. Runs ONLY after HMAC.\"\"\"\n332\t        replay = getattr(self.server, \"federation_replay_cache\", None)\n333\t        if replay is None:\n334\t            return \"replay_cache_missing\"\n335\t        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n336\t        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n337\t        decision: ReplayDecision = replay.check_and_record(peer.peer_id, nonce, ts)\n338\t        return None if decision.accepted else decision.reason\n339\t\n340\t    def _verify_replay_and_signature(\n341\t        self, peer: PeerRecord, body: bytes,\n342\t    ) -> Optional[str]:\n343\t        \"\"\"Legacy combined check (read path, GET). Kept for do_GET.\"\"\"\n344\t        replay = getattr(self.server, \"federation_replay_cache\", None)\n345\t        if replay is None:\n346\t            return \"replay_cache_missing\"\n347\t        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n348\t        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n349\t        sig = self.headers.get(\"X-CEO-Federation-Signature\", \"\")\n350\t        if not (nonce and ts and sig):\n351\t            return \"missing_replay_headers\"\n352\t        decision: ReplayDecision = replay.check_and_record(peer.peer_id, nonce, ts)\n353\t        if not decision.accepted:\n354\t            return decision.reason\n355\t        try:\n356\t            from .replay import verify_signature  # type: ignore[import]\n357\t        except ImportError:\n358\t            from replay import verify_signature  # type: ignore[no-redef]\n359\t        ok = verify_signature(\n360\t            self.command or \"\", self.path or \"\", ts, nonce, body,\n361\t            peer.hmac_secret_hex, sig,\n362\t        )\n363\t        if not ok:\n364\t            return \"signature_invalid\"\n365\t        return None\n366\t\n367\t    # ===================================================================\n368\t    # Wave D 11-gate write dispatcher (PLAN-112-FOLLOWUP W2/W3/W4/W6b)\n369\t    # ===================================================================\n370\t\n371\t"}]},"parent_tool_use_id":null,"session_id":"99e4484c-9fd2-48bc-96cb-ca1217c6fa39","uuid":"b81cb9cc-1a43-458f-bcb4-c6eec25f4814","timestamp":"2026-11-15T10:30:58.600Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/federation/_server_parts/handler_auth.py","content":"\"\"\"Declarations extracted from federation.server; loaded by the facade.\"\"\"\nfrom __future__ import annotations\n\nclass _HandlerAuth:\n    \"\"\"Per-request handler. Wired by :class:`FederationServer`.\"\"\"\n\n    server_version = \"CEOFederation/1.0\"\n    sys_version = \"\"  # don't leak Python version\n\n    # AC16 — fail-fast timeout per request.\n    timeout = HANDSHAKE_TIMEOUT_SECONDS\n\n    def log_message(self, format: str, *args: Any) -> None:  # noqa: A002\n        return  # silent — audit-log is the canonical record\n\n    # AC15 mechanical method allowlist. PLAN-112-FOLLOWUP W1: POST is\n    # admitted ONLY when write-mode is active (Layer 0a env AND Layer 0b\n    # sentinel). When write-mode is OFF, the module constant\n    # ALLOWED_HTTP_METHODS = (\"GET\",) is the effective set and POST → 405.\n    def parse_request(self) -> bool:\n        ok = http.server.BaseHTTPRequestHandler.parse_request(self)\n        if not ok:\n            return ok\n        method = (self.command or \"\").upper()\n        if method in ALLOWED_HTTP_METHODS:\n            return True\n        # Non-GET. POST is conditionally allowed when write-mode active.\n        if method == \"POST\" and self._write_mode_active():\n            return True\n        self._emit_write_blocked()\n        self._send_405()\n        return False\n\n    # -- Write-mode activation gates (PLAN-112-FOLLOWUP W1) -------------\n\n    def _write_mode_active(self) -> bool:\n        \"\"\"Layer 0a AND Layer 0b — write-mode is reachable.\n\n        Default-OFF (AC1/AC7): BOTH the env switch (Layer 0a) AND the\n        write-enable sentinel (Layer 0b / Gate #8) must pass. Either OFF\n        → False → POST stays 405. Fail-CLOSED on any error.\n        \"\"\"\n        try:\n            if not write_mode_enabled_from_env():\n                return False\n            return self._write_enable_sentinel_valid()\n        except Exception:\n            return False\n\n    def _emit_write_blocked(self) -> None:\n        # AC15 — every non-allowed method-allowlist violation emits.\n        peer_fpr = self._lookup_peer_fpr()\n        correlation = self.headers.get(CORRELATION_ID_HEADER, \"\") or \"\"\n        _safe_emit(\n            \"federation_write_attempt_blocked\",\n            method=str(self.command)[:16] if self.command else \"\",\n            path=str(self.path)[:128] if self.path else \"\",\n            peer_id_cert_fingerprint=peer_fpr,\n            client_ip=self._client_ip(),\n            fed_correlation_id=correlation[:64],\n        )\n\n    def _send_405(self) -> None:\n        self.send_response(405)\n        # Advertise POST only when write-mode is active.\n        allow = \"GET, POST\" if self._write_mode_active() else \"GET\"\n        self.send_header(\"Allow\", allow)\n        self.send_header(\"Content-Type\", \"application/json\")\n        self.send_header(\"Connection\", \"close\")\n        body = b'{\"error\":\"method_not_allowed\"}'\n        self.send_header(\"Content-Length\", str(len(body)))\n        self.end_headers()\n        self.wfile.write(body)\n\n    def do_POST(self) -> None:  # noqa: N802 — base-class convention\n        # PLAN-112-FOLLOWUP W1/W2 — when write-mode is OFF, behave exactly\n        # as before (emit blocked + 405). When ON, run the 11-gate\n        # dispatcher.\n        if not self._write_mode_active():\n            self._emit_write_blocked()\n            self._send_405()\n            return\n        self._dispatch_write(method=\"POST\")\n\n    def do_PUT(self) -> None:  # noqa: N802\n        self._emit_write_blocked()\n        self._send_405()\n\n    def do_PATCH(self) -> None:  # noqa: N802\n        self._emit_write_blocked()\n        self._send_405()\n\n    def do_DELETE(self) -> None:  # noqa: N802\n        self._emit_write_blocked()\n        self._send_405()\n\n    def do_OPTIONS(self) -> None:  # noqa: N802\n        self._emit_write_blocked()\n        self._send_405()\n\n    def do_HEAD(self) -> None:  # noqa: N802\n        self._emit_write_blocked()\n        self._send_405()\n\n    # -- Common helpers --------------------------------------------------\n\n    def _client_ip(self) -> str:\n        try:\n            return self.client_address[0] if self.client_address else \"\"\n        except (AttributeError, IndexError):\n            return \"\"\n\n    def _ip_prefix(self) -> str:\n        \"\"\"Return a /24 (v4) or /48 (v6) prefix of the client IP.\n\n        Used as the rate-limit discriminator (LLM06/GDPR — never log the\n        full client IP). Best-effort; empty on any error.\n        \"\"\"\n        ip = self._client_ip()\n        if not ip:\n            return \"\"\n        try:\n            addr = ipaddress.ip_address(ip)\n        except ValueError:\n            return \"\"\n        try:\n            if addr.version == 4:\n                net = ipaddress.ip_network(ip + \"/24\", strict=False)\n            else:\n                net = ipaddress.ip_network(ip + \"/48\", strict=False)\n            return str(net.network_address)\n        except ValueError:\n            return \"\"\n\n    def _lookup_peer_fpr(self) -> str:\n        try:\n            der = self.connection.getpeercert(True)  # type: ignore[union-attr]\n        except (AttributeError, ssl.SSLError):\n            return \"\"\n        if not der:\n            return \"\"\n        return hashlib.sha256(der).hexdigest()\n\n    def _presented_cert_pem_bytes(self) -> bytes:\n        try:\n            der = self.connection.getpeercert(True)  # type: ignore[union-attr]\n        except (AttributeError, ssl.SSLError):\n            return b\"\"\n        if not der:\n            return b\"\"\n        try:\n            return ssl.DER_cert_to_PEM_cert(der).encode(\"ascii\")\n        except (TypeError, ValueError, UnicodeEncodeError):\n            return b\"\"\n\n    def _lookup_peer_record(self) -> Optional[PeerRecord]:\n        # PLAN-112-FOLLOWUP W3/R-IT-B: refresh the peer list before SPKI\n        # match so a revocation propagates at the connection-accept layer\n        # too (not only Gate #7).\n        try:\n            _maybe_reload_peers(self.server)\n        except Exception:\n            pass  # reload is best-effort; fail-open on infra only\n        peers = getattr(self.server, \"federation_peers\", {})\n        peers_extra = getattr(self.server, \"federation_peers_extra\", {}) or {}\n        if not peers:\n            return None\n\n        presented_der_fpr = self._lookup_peer_fpr()\n        if not presented_der_fpr:\n            return None\n\n        presented_pem = self._presented_cert_pem_bytes()\n        presented_spki_fpr = \"\"\n        spki_compute_attempted = False\n        spki_compute_error: Optional[str] = None\n\n        for peer in peers.values():\n            if peer.revoked:\n                continue\n            extra = peers_extra.get(peer.peer_id, {}) if peers_extra else {}\n            spki_from_record = peer.peer_id_spki_fingerprint\n            spki_from_extra = extra.get(\"peer_id_spki_fingerprint\", \"\") if isinstance(extra, dict) else \"\"\n            effective_spki = spki_from_record or spki_from_extra or \"\"\n            peer_row = {\n                \"peer_id\": peer.peer_id,\n                \"peer_id_spki_fingerprint\": effective_spki,\n                \"peer_id_cert_fingerprint\": peer.peer_id_cert_fingerprint,\n            }\n            try:\n                pin_type, pin_value = select_pin_for_peer(peer_row)\n            except PinSelectionError:\n                self._emit_peer_invalid_no_fingerprint(peer.peer_id)\n                continue\n\n            if pin_type == \"spki\":\n                if not spki_compute_attempted:\n                    spki_compute_attempted = True\n                    if presented_pem:\n                        try:\n                            presented_spki_fpr = compute_spki_fingerprint(\n                                presented_pem\n                            )\n                        except (ImportError, ValueError, TypeError) as exc:\n                            spki_compute_error = (\n                                \"{0}:{1}\".format(\n                                    type(exc).__name__, str(exc)[:64]\n                                )\n                            )\n                            presented_spki_fpr = \"\"\n                if not presented_spki_fpr:\n                    self._emit_spki_fingerprint_mismatch(\n                        peer.peer_id,\n                        reason=\"presented_spki_compute_failed:{0}\".format(\n                            spki_compute_error or \"no_pem\"\n                        ),\n                    )\n                    continue\n                if compare_fingerprints(presented_spki_fpr, pin_value):\n                    return peer\n                self._emit_spki_fingerprint_mismatch(\n                    peer.peer_id, reason=\"spki_mismatch\"\n                )\n                continue\n\n            if compare_fingerprints(presented_der_fpr, pin_value):\n                self._emit_pin_legacy_used(peer.peer_id)\n                return peer\n            continue\n\n        return None\n\n    def _resolve_peer(self) -> Optional[PeerRecord]:\n        \"\"\"Public alias for :meth:`_lookup_peer_record` (Wave D contract).\"\"\"\n        return self._lookup_peer_record()\n\n    # Wave C audit emit wrappers.\n    def _emit_spki_fingerprint_mismatch(\n        self, peer_id: str, reason: str = \"spki_mismatch\",\n    ) -> None:\n        presented_fpr = self._lookup_peer_fpr() or \"\"\n        _safe_emit(\n            \"federation_spki_fingerprint_mismatch\",\n            peer_id=peer_id[:64],\n            expected_prefix=\"\",\n            presented_prefix=presented_fpr[:16],\n            route=str(self.path or \"\")[:64],\n        )\n\n    def _emit_pin_legacy_used(self, peer_id: str) -> None:\n        der_fpr = self._lookup_peer_fpr() or \"\"\n        _safe_emit(\n            \"federation_pin_legacy_used\",\n            peer_id=peer_id[:64],\n            route=str(self.path or \"\")[:64],\n            der_fingerprint_prefix=der_fpr[:16],\n        )\n\n    def _emit_peer_invalid_no_fingerprint(self, peer_id: str) -> None:\n        source_path = str(getattr(\n            getattr(self, \"server\", None),\n            \"federation_peers_path\",\n            \".claude/data/federation/peers.yaml\",\n        ))\n        _safe_emit(\n            \"federation_peer_invalid_no_fingerprint\",\n            peer_id=peer_id[:64],\n            source_path=source_path[:128],\n        )\n\n    def _emit_connection_rejected(self, reason: str) -> None:\n        _safe_emit(\n            \"federation_connection_rejected\",\n            peer_id_cert_fingerprint=self._lookup_peer_fpr(),\n            client_ip=self._client_ip(),\n            reason=reason[:64],\n        )\n\n    def _emit_connection_accepted(self, peer_id: str) -> None:\n        correlation = self.headers.get(CORRELATION_ID_HEADER, \"\") or \"\"\n        _safe_emit(\n            \"federation_connection_accepted\",\n            peer_id=peer_id[:64],\n            client_ip=self._client_ip(),\n            fed_correlation_id=correlation[:64],\n        )\n\n    # -- Replay + signature verification (AC13) -------------------------\n\n    def _replay_freshness_preflight(\n        self, peer: PeerRecord,\n    ) -> Optional[str]:\n        \"\"\"R-SE-a Gate #3a — NON-mutating timestamp-window preflight.\n\n        Runs BEFORE the body read. Returns None if fresh, else a reason.\n        Does NOT touch the nonce ring (no state mutation) so an unauth /\n        replayed peer cannot poison the ring before HMAC verification.\n        \"\"\"\n        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n        sig = self.headers.get(\"X-CEO-Federation-Signature\", \"\")\n        if not (nonce and ts and sig):\n            return \"missing_replay_headers\"\n        try:\n            parsed = parse_rfc3339_utc(ts)\n        except ValueError:\n            return \"malformed_timestamp\"\n        skew = abs(parsed.timestamp() - time.time())\n        if skew > MAX_CLOCK_SKEW_SECONDS:\n            return \"clock_skew\"\n        return None\n\n    def _verify_signature_only(\n        self, peer: PeerRecord, body: bytes,\n    ) -> Optional[str]:\n        \"\"\"R-SE-a Gate #3c — HMAC signature verify (needs body). No mutation.\"\"\"\n        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n        sig = self.headers.get(\"X-CEO-Federation-Signature\", \"\")\n        try:\n            from .replay import verify_signature  # type: ignore[import]\n        except ImportError:\n            from replay import verify_signature  # type: ignore[no-redef]\n        ok = verify_signature(\n            self.command or \"\", self.path or \"\", ts, nonce, body,\n            peer.hmac_secret_hex, sig,\n        )\n        return None if ok else \"signature_invalid\"\n\n    def _commit_nonce(self, peer: PeerRecord) -> Optional[str]:\n        \"\"\"R-SE-a Gate #3d — MUTATING nonce commit. Runs ONLY after HMAC.\"\"\"\n        replay = getattr(self.server, \"federation_replay_cache\", None)\n        if replay is None:\n            return \"replay_cache_missing\"\n        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n        decision: ReplayDecision = replay.check_and_record(peer.peer_id, nonce, ts)\n        return None if decision.accepted else decision.reason\n\n    def _verify_replay_and_signature(\n        self, peer: PeerRecord, body: bytes,\n    ) -> Optional[str]:\n        \"\"\"Legacy combined check (read path, GET). Kept for do_GET.\"\"\"\n        replay = getattr(self.server, \"federation_replay_cache\", None)\n        if replay is None:\n            return \"replay_cache_missing\"\n        nonce = self.headers.get(\"X-CEO-Federation-Nonce\", \"\")\n        ts = self.headers.get(\"X-CEO-Federation-Timestamp\", \"\")\n        sig = self.headers.get(\"X-CEO-Federation-Signature\", \"\")\n        if not (nonce and ts and sig):\n            return \"missing_replay_headers\"\n        decision: ReplayDecision = replay.check_and_record(peer.peer_id, nonce, ts)\n        if not decision.accepted:\n            return decision.reason\n        try:\n            from .replay import verify_signature  # type: ignore[import]\n        except ImportError:\n            from replay import verify_signature  # type: ignore[no-redef]\n        ok = verify_signature(\n            self.command or \"\", self.path or \"\", ts, nonce, body,\n            peer.hmac_secret_hex, sig,\n        )\n        if not ok:\n            return \"signature_invalid\"\n        return None\n\n    # ===================================================================\n    # Wave D 11-gate write dispatcher (PLAN-112-FOLLOWUP W2/W3/W4/W6b)\n    # ===================================================================\n\n","numLines":371,"startLine":1,"totalLines":371}},"tool_result_meta":[{"id":"toolu_01VejGHbrV63h9H75xCi78qv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
