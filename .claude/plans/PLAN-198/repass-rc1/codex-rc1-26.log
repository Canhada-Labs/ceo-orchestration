-
-    def __init__(self, name: str, status: str, summary: str, duration_ms: float, detail: Any = None):
-        self.name = name
-        self.status = status  # green/yellow/red/timeout/error
-        self.summary = summary
-        self.duration_ms = duration_ms
-        self.detail = detail
