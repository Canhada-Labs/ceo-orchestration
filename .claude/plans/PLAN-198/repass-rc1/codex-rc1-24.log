    82	    now = set((after.get("refs") or "").splitlines())
    83	    out.extend("ref sumiu ou mudou: %s" % line for line in sorted(was - now))
    84	    out.extend("ref nova ou mudada: %s" % line for line in sorted(now - was))
    85	    return out
