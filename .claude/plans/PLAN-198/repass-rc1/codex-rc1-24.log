    49	
    50	def _git(repo: str, args: List[str], ok_codes: tuple = (0,)) -> "subprocess.CompletedProcess[str]":
    51	    # `-C` só para leitura; o ambiente que reaponta o repositório não pode decidir a
    52	    # resposta: o harness pergunta pelo REPO que nomeou.
    53	    env = {k: v for k, v in os.environ.items() if k not in ("GIT_DIR", "GIT_WORK_TREE")}
    54	    try:
    55	        proc = subprocess.run(["git", "-C", repo] + args, capture_output=True, text=True,
    56	                              timeout=_TIMEOUT_S, env=env, check=False)
    57	    except (OSError, subprocess.SubprocessError) as exc:
    58	        raise GuardError("git %s: %s" % (args[0], type(exc).__name__)) from None
    59	    if proc.returncode not in ok_codes:
    60	        raise GuardError("git %s saiu com rc %d" % (args[0], proc.returncode))
