    62	
    63	
    64	def snapshot(repo: str) -> Dict[str, str]:
    65	    """HEAD resolvido, para onde ele aponta (``""`` = destacado) e todas as refs."""
    66	    head = _git(repo, ["rev-parse", "--verify", "-q", "HEAD"], ok_codes=(0, 1)).stdout.strip()
    67	    symbolic = _git(repo, ["symbolic-ref", "-q", "HEAD"], ok_codes=(0, 1)).stdout.strip()
    68	    refs = _git(repo, ["for-each-ref", "--format=%(refname) %(objectname)"]).stdout
    69	    return {"head": head, "symbolic_ref": symbolic, "refs": refs}
