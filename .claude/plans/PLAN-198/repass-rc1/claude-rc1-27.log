{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SXfng61aj2ANr8T3EFc5RT","type":"tool_result","content":"1\t\"\"\"Extracted cost-transcripts implementation: pricing.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport glob\n6\timport json\n7\timport os\n8\timport re\n9\timport sys\n10\timport time\n11\tfrom dataclasses import dataclass, field\n12\tfrom datetime import datetime, timedelta, timezone\n13\tfrom pathlib import Path\n14\tfrom typing import Any, Dict, List, Optional, Tuple\n15\t\n16\t#: Embedded fallback / correction source. Report 05-finops-routing.md §1.2 +\n17\t#: §1.4 (S339, measured 2026-08-03..2026-09-02). Sonnet 5 at the\n18\t#: Owner-ratified 2026-09-01 intro rate (CLAUDE.md commit e47bf5d).\n19\t#: ADR-149 Amendment 3 (S357): claude-opus-5-5 at $4/$20 (pricing page\n20\t#: fetched 2026-09-22).\n21\t_EMBEDDED_PRICING: Dict[str, Dict[str, float]] = {\n22\t    \"claude-fable-5-1\": {\"input_per_mtok\": 10.00, \"output_per_mtok\": 50.00},\n23\t    \"claude-fable-5\": {\"input_per_mtok\": 10.00, \"output_per_mtok\": 50.00},\n24\t    \"claude-opus-5-5\": {\"input_per_mtok\": 4.00, \"output_per_mtok\": 20.00},\n25\t    \"claude-opus-5\": {\"input_per_mtok\": 5.00, \"output_per_mtok\": 25.00},\n26\t    \"claude-opus-4-8\": {\"input_per_mtok\": 5.00, \"output_per_mtok\": 25.00},\n27\t    \"claude-sonnet-5\": {\"input_per_mtok\": 2.00, \"output_per_mtok\": 10.00},\n28\t    \"claude-sonnet-4-6\": {\"input_per_mtok\": 3.00, \"output_per_mtok\": 15.00},\n29\t    \"claude-haiku-4-5\": {\"input_per_mtok\": 1.00, \"output_per_mtok\": 5.00},\n30\t}\n31\t\n32\t#: Applied ONLY on top of a successfully-parsed DEFAULT --pricing path\n33\t#: (never on an explicit caller-supplied path), and ONLY where the\n34\t#: parsed row differs from the value below. An entry that matches the\n35\t#: file is reported as a no-op, never as a correction. See module\n36\t#: docstring.\n37\t_RATIFIED_OVERRIDES_FOR_DEFAULT_TABLE: Dict[str, Dict[str, float]] = {\n38\t    \"claude-sonnet-5\": {\"input_per_mtok\": 2.00, \"output_per_mtok\": 10.00},\n39\t}\n40\t\n41\t#: docs/provider-pricing.md lines ~130-153 (\"Cache-tier multipliers\"):\n42\t#: fresh input 1.00x, cache write 5m 1.25x, cache write 1h 2.00x, cache\n43\t#: read 0.10x (base input rate) — EXCEPT the per-model entries below:\n44\t#: claude-fable-5-1 at 0.025x (pricing page 2026-09-01, ADR-149\n45\t#: Amendment 2) and claude-opus-5-5 at 0.05x (pricing page 2026-09-22,\n46\t#: ADR-149 Amendment 3). The pricing page also prices Mythos 5.1 cache\n47\t#: hits at 0.025x; that model is outside the ADR-149 working set and\n48\t#: carries no entry. Mirrors budget-summary.py's\n49\t#: _CACHE_READ_MULTIPLIER_OVERRIDES exactly (bound by\n50\t#: test_model_fleet_presence.py since S357).\n51\t_CACHE_READ_MULTIPLIER_DEFAULT: float = 0.10\n52\t_CACHE_READ_MULTIPLIER_OVERRIDES: Dict[str, float] = {\n53\t    \"claude-fable-5-1\": 0.025,\n54\t    \"claude-opus-5-5\": 0.05,\n55\t}\n56\t_CACHE_WRITE_5M_MULTIPLIER: float = 1.25\n57\t_CACHE_WRITE_1H_MULTIPLIER: float = 2.00\n58\t\n59\t_MODEL_SUFFIX_RE = re.compile(r\"\\[[^\\[\\]]*\\]$\")\n60\t\n61\t\n62\tdef _cache_read_multiplier(model_id: str) -> float:\n63\t    return _CACHE_READ_MULTIPLIER_OVERRIDES.get(model_id, _CACHE_READ_MULTIPLIER_DEFAULT)\n64\t\n65\t\n66\tdef _cache_read_exceptions_text() -> str:\n67\t    \"\"\"Per-model cache-read exceptions rendered FROM the override table\n68\t    (ADR-149 Amendment 3, S357: the help text is derived, never re-listed).\"\"\"\n69\t    return \", \".join(\n70\t        \"%gx for %s\" % (mult, model_id)\n71\t        for model_id, mult in sorted(_CACHE_READ_MULTIPLIER_OVERRIDES.items())\n72\t    )\n73\t\n74\t\n75\tdef normalize_model_id(raw: Optional[str]) -> Optional[str]:\n76\t    \"\"\"Strip a trailing context-window suffix (e.g. ``[1m]``). No guessing.\"\"\"\n77\t    if not isinstance(raw, str) or not raw.strip():\n78\t        return None\n79\t    return _MODEL_SUFFIX_RE.sub(\"\", raw.strip())\n80\t\n81\t\n82\tdef _safe_text(value: Any, limit: int = 80) -> str:\n83\t    \"\"\"Untrusted text (a transcript or sidecar field) made safe to PRINT.\n84\t\n85\t    Every non-printable character -- an ESC, a newline, a bidi override --\n86\t    becomes ``?``, so a forged ``ROUTING INVARIANT ... GREEN`` line or a\n87\t    terminal escape cannot ride in on a model id, a session id, a label or\n88\t    an archetype name. It is applied where the text ENTERS the instrument\n89\t    (``_extract_record`` for every transcript-derived string, the routing\n90\t    reader for every sidecar-derived one), so every renderer downstream --\n91\t    the CLI table, the JSON report, the two callers' blocks -- inherits it\n92\t    and a new print site cannot forget it.\n93\t    \"\"\"\n94\t    return \"\".join(c if c.isprintable() else \"?\" for c in str(value))[:limit]\n95\t\n96\t\n97\tdef _parse_cost_table_yaml(text: str) -> Dict[str, Dict[str, float]]:\n98\t    \"\"\"Minimal parser for the ``models:`` block of cost-table.yaml's mini-YAML\n99\t    subset (top-level scalars + one level of 2-space-indented nested dicts —\n100\t    see that file's own header comment). Extracts ONLY the two numeric\n101\t    fields this instrument needs; anything else (``tier``, ``source_url``,\n102\t    ...) is ignored. Never raises — a malformed file just yields {}.\n103\t    \"\"\"\n104\t    models: Dict[str, Dict[str, float]] = {}\n105\t    in_models = False\n106\t    current: Optional[str] = None\n107\t    for raw_line in text.splitlines():\n108\t        if not raw_line.strip():\n109\t            continue\n110\t        stripped = raw_line.strip()\n111\t        if stripped.startswith(\"#\"):\n112\t            continue\n113\t        if not raw_line.startswith(\" \") and not raw_line.startswith(\"\\t\"):\n114\t            in_models = raw_line.rstrip() == \"models:\"\n115\t            current = None\n116\t            continue\n117\t        if not in_models:\n118\t            continue\n119\t        indent = len(raw_line) - len(raw_line.lstrip(\" \"))\n120\t        if indent == 2 and stripped.endswith(\":\"):\n121\t            current = stripped[:-1].strip()\n122\t            models.setdefault(current, {})\n123\t            continue\n124\t        if indent >= 4 and current is not None:\n125\t            field_txt = stripped\n126\t            if \"#\" in field_txt:\n127\t                field_txt = field_txt.split(\"#\", 1)[0].rstrip()\n128\t            if \":\" not in field_txt:\n129\t                continue\n130\t            key, _, val = field_txt.partition(\":\")\n131\t            key = key.strip()\n132\t            val = val.strip()\n133\t            if key in (\"input_per_mtok\", \"output_per_mtok\"):\n134\t                try:\n135\t                    models[current][key] = float(val)\n136\t                except ValueError:\n137\t                    continue\n138\t    return models\n139\t\n140\t\n141\t@dataclass\n142\tclass PricingResult:\n143\t    table: Dict[str, Dict[str, float]]\n144\t    source: str  # human-readable description for --help / report footer\n145\t    used_fallback: bool\n146\t\n147\t\n148\tdef _override_is_a_no_op(\n149\t    current: Optional[Dict[str, float]], override: Dict[str, float]\n150\t) -> bool:\n151\t    \"\"\"True when the parsed row ALREADY carries every ratified value.\n152\t\n153\t    Guards the one thing an unconditional overwrite cannot express: the\n154\t    difference between a stale file that WAS corrected and a file that\n155\t    was already right. Missing row / wrong type => not a no-op, so the\n156\t    override still lands.\n157\t    \"\"\"\n158\t    if not isinstance(current, dict):\n159\t        return False\n160\t    for key, value in override.items():\n161\t        have = current.get(key)\n162\t        if isinstance(have, bool) or not isinstance(have, (int, float)):\n163\t            return False\n164\t        if abs(float(have) - float(value)) > 1e-9:\n165\t            return False\n166\t    return True\n167\t\n168\t\n169\tdef load_pricing(pricing_arg: Optional[str]) -> PricingResult:\n170\t    \"\"\"Resolve the active {model_id: {input_per_mtok, output_per_mtok}}\n171\t    table per the contract in the module docstring.\"\"\"\n172\t    is_default_path = pricing_arg is None\n173\t    path = Path(pricing_arg) if pricing_arg else (_SCRIPT_DIR / \"cost-table.yaml\")\n174\t\n175\t    text: Optional[str] = None\n176\t    if path.is_file():\n177\t        try:\n178\t            text = path.read_text(encoding=\"utf-8\")\n179\t        except OSError:\n180\t            text = None\n181\t\n182\t    parsed: Dict[str, Dict[str, float]] = _parse_cost_table_yaml(text) if text else {}\n183\t    complete_rows = {\n184\t        mid: row\n185\t        for mid, row in parsed.items()\n186\t        if \"input_per_mtok\" in row and \"output_per_mtok\" in row\n187\t    }\n188\t\n189\t    if not complete_rows:\n190\t        return PricingResult(\n191\t            table=dict(_EMBEDDED_PRICING),\n192\t            source=(\n193\t                \"embedded (report 05-finops-routing.md \\xa71.4; %s could not \"\n194\t                \"be parsed / had no complete models: rows)\" % path\n195\t            ),\n196\t            used_fallback=True,\n197\t        )\n198\t\n199\t    table = dict(complete_rows)\n200\t    source = \"parsed from %s\" % path\n201\t    if is_default_path:\n202\t        # Conditional by construction: an override that merely restates\n203\t        # what the file already says is NOT a correction. Reporting it as\n204\t        # one prints a fix that fixed nothing, and applying it anyway\n205\t        # would silently mask a legitimate refresh of the table.\n206\t        applied: List[str] = []\n207\t        noop: List[str] = []\n208\t        for mid in sorted(_RATIFIED_OVERRIDES_FOR_DEFAULT_TABLE):\n209\t            override = _RATIFIED_OVERRIDES_FOR_DEFAULT_TABLE[mid]\n210\t            if _override_is_a_no_op(table.get(mid), override):\n211\t                noop.append(mid)\n212\t                continue\n213\t            table[mid] = dict(override)\n214\t            applied.append(\n215\t                \"%s -> $%g/$%g\"\n216\t                % (\n217\t                    mid,\n218\t                    override[\"input_per_mtok\"],\n219\t                    override[\"output_per_mtok\"],\n220\t                )\n221\t            )\n222\t        if applied:\n223\t            source += (\n224\t                \" + ratified correction (%s; 2026-09-01, CLAUDE.md \"\n225\t                \"e47bf5d)\" % \", \".join(applied)\n226\t            )\n227\t        if noop:\n228\t            source += (\n229\t                \" + ratified correction NOT needed for %s (the file \"\n230\t                \"already carries the ratified rate)\" % \", \".join(noop)\n231\t            )\n232\t    return PricingResult(table=table, source=source, used_fallback=False)\n233\t\n234\t\n235\t# ---------------------------------------------------------------------------\n236\t# Transcript discovery + parsing\n237\t# ---------------------------------------------------------------------------\n238\t\n239\t\n240\t"}]},"parent_tool_use_id":null,"session_id":"7c0bb90c-7d31-4674-a599-70c9f0a2963d","uuid":"aa75f170-d2d5-439e-9f36-e4601dba448f","timestamp":"2026-11-15T11:17:53.532Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_cost_transcripts_parts/pricing.py","content":"\"\"\"Extracted cost-transcripts implementation: pricing.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport glob\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n#: Embedded fallback / correction source. Report 05-finops-routing.md §1.2 +\n#: §1.4 (S339, measured 2026-08-03..2026-09-02). Sonnet 5 at the\n#: Owner-ratified 2026-09-01 intro rate (CLAUDE.md commit e47bf5d).\n#: ADR-149 Amendment 3 (S357): claude-opus-5-5 at $4/$20 (pricing page\n#: fetched 2026-09-22).\n_EMBEDDED_PRICING: Dict[str, Dict[str, float]] = {\n    \"claude-fable-5-1\": {\"input_per_mtok\": 10.00, \"output_per_mtok\": 50.00},\n    \"claude-fable-5\": {\"input_per_mtok\": 10.00, \"output_per_mtok\": 50.00},\n    \"claude-opus-5-5\": {\"input_per_mtok\": 4.00, \"output_per_mtok\": 20.00},\n    \"claude-opus-5\": {\"input_per_mtok\": 5.00, \"output_per_mtok\": 25.00},\n    \"claude-opus-4-8\": {\"input_per_mtok\": 5.00, \"output_per_mtok\": 25.00},\n    \"claude-sonnet-5\": {\"input_per_mtok\": 2.00, \"output_per_mtok\": 10.00},\n    \"claude-sonnet-4-6\": {\"input_per_mtok\": 3.00, \"output_per_mtok\": 15.00},\n    \"claude-haiku-4-5\": {\"input_per_mtok\": 1.00, \"output_per_mtok\": 5.00},\n}\n\n#: Applied ONLY on top of a successfully-parsed DEFAULT --pricing path\n#: (never on an explicit caller-supplied path), and ONLY where the\n#: parsed row differs from the value below. An entry that matches the\n#: file is reported as a no-op, never as a correction. See module\n#: docstring.\n_RATIFIED_OVERRIDES_FOR_DEFAULT_TABLE: Dict[str, Dict[str, float]] = {\n    \"claude-sonnet-5\": {\"input_per_mtok\": 2.00, \"output_per_mtok\": 10.00},\n}\n\n#: docs/provider-pricing.md lines ~130-153 (\"Cache-tier multipliers\"):\n#: fresh input 1.00x, cache write 5m 1.25x, cache write 1h 2.00x, cache\n#: read 0.10x (base input rate) — EXCEPT the per-model entries below:\n#: claude-fable-5-1 at 0.025x (pricing page 2026-09-01, ADR-149\n#: Amendment 2) and claude-opus-5-5 at 0.05x (pricing page 2026-09-22,\n#: ADR-149 Amendment 3). The pricing page also prices Mythos 5.1 cache\n#: hits at 0.025x; that model is outside the ADR-149 working set and\n#: carries no entry. Mirrors budget-summary.py's\n#: _CACHE_READ_MULTIPLIER_OVERRIDES exactly (bound by\n#: test_model_fleet_presence.py since S357).\n_CACHE_READ_MULTIPLIER_DEFAULT: float = 0.10\n_CACHE_READ_MULTIPLIER_OVERRIDES: Dict[str, float] = {\n    \"claude-fable-5-1\": 0.025,\n    \"claude-opus-5-5\": 0.05,\n}\n_CACHE_WRITE_5M_MULTIPLIER: float = 1.25\n_CACHE_WRITE_1H_MULTIPLIER: float = 2.00\n\n_MODEL_SUFFIX_RE = re.compile(r\"\\[[^\\[\\]]*\\]$\")\n\n\ndef _cache_read_multiplier(model_id: str) -> float:\n    return _CACHE_READ_MULTIPLIER_OVERRIDES.get(model_id, _CACHE_READ_MULTIPLIER_DEFAULT)\n\n\ndef _cache_read_exceptions_text() -> str:\n    \"\"\"Per-model cache-read exceptions rendered FROM the override table\n    (ADR-149 Amendment 3, S357: the help text is derived, never re-listed).\"\"\"\n    return \", \".join(\n        \"%gx for %s\" % (mult, model_id)\n        for model_id, mult in sorted(_CACHE_READ_MULTIPLIER_OVERRIDES.items())\n    )\n\n\ndef normalize_model_id(raw: Optional[str]) -> Optional[str]:\n    \"\"\"Strip a trailing context-window suffix (e.g. ``[1m]``). No guessing.\"\"\"\n    if not isinstance(raw, str) or not raw.strip():\n        return None\n    return _MODEL_SUFFIX_RE.sub(\"\", raw.strip())\n\n\ndef _safe_text(value: Any, limit: int = 80) -> str:\n    \"\"\"Untrusted text (a transcript or sidecar field) made safe to PRINT.\n\n    Every non-printable character -- an ESC, a newline, a bidi override --\n    becomes ``?``, so a forged ``ROUTING INVARIANT ... GREEN`` line or a\n    terminal escape cannot ride in on a model id, a session id, a label or\n    an archetype name. It is applied where the text ENTERS the instrument\n    (``_extract_record`` for every transcript-derived string, the routing\n    reader for every sidecar-derived one), so every renderer downstream --\n    the CLI table, the JSON report, the two callers' blocks -- inherits it\n    and a new print site cannot forget it.\n    \"\"\"\n    return \"\".join(c if c.isprintable() else \"?\" for c in str(value))[:limit]\n\n\ndef _parse_cost_table_yaml(text: str) -> Dict[str, Dict[str, float]]:\n    \"\"\"Minimal parser for the ``models:`` block of cost-table.yaml's mini-YAML\n    subset (top-level scalars + one level of 2-space-indented nested dicts —\n    see that file's own header comment). Extracts ONLY the two numeric\n    fields this instrument needs; anything else (``tier``, ``source_url``,\n    ...) is ignored. Never raises — a malformed file just yields {}.\n    \"\"\"\n    models: Dict[str, Dict[str, float]] = {}\n    in_models = False\n    current: Optional[str] = None\n    for raw_line in text.splitlines():\n        if not raw_line.strip():\n            continue\n        stripped = raw_line.strip()\n        if stripped.startswith(\"#\"):\n            continue\n        if not raw_line.startswith(\" \") and not raw_line.startswith(\"\\t\"):\n            in_models = raw_line.rstrip() == \"models:\"\n            current = None\n            continue\n        if not in_models:\n            continue\n        indent = len(raw_line) - len(raw_line.lstrip(\" \"))\n        if indent == 2 and stripped.endswith(\":\"):\n            current = stripped[:-1].strip()\n            models.setdefault(current, {})\n            continue\n        if indent >= 4 and current is not None:\n            field_txt = stripped\n            if \"#\" in field_txt:\n                field_txt = field_txt.split(\"#\", 1)[0].rstrip()\n            if \":\" not in field_txt:\n                continue\n            key, _, val = field_txt.partition(\":\")\n            key = key.strip()\n            val = val.strip()\n            if key in (\"input_per_mtok\", \"output_per_mtok\"):\n                try:\n                    models[current][key] = float(val)\n                except ValueError:\n                    continue\n    return models\n\n\n@dataclass\nclass PricingResult:\n    table: Dict[str, Dict[str, float]]\n    source: str  # human-readable description for --help / report footer\n    used_fallback: bool\n\n\ndef _override_is_a_no_op(\n    current: Optional[Dict[str, float]], override: Dict[str, float]\n) -> bool:\n    \"\"\"True when the parsed row ALREADY carries every ratified value.\n\n    Guards the one thing an unconditional overwrite cannot express: the\n    difference between a stale file that WAS corrected and a file that\n    was already right. Missing row / wrong type => not a no-op, so the\n    override still lands.\n    \"\"\"\n    if not isinstance(current, dict):\n        return False\n    for key, value in override.items():\n        have = current.get(key)\n        if isinstance(have, bool) or not isinstance(have, (int, float)):\n            return False\n        if abs(float(have) - float(value)) > 1e-9:\n            return False\n    return True\n\n\ndef load_pricing(pricing_arg: Optional[str]) -> PricingResult:\n    \"\"\"Resolve the active {model_id: {input_per_mtok, output_per_mtok}}\n    table per the contract in the module docstring.\"\"\"\n    is_default_path = pricing_arg is None\n    path = Path(pricing_arg) if pricing_arg else (_SCRIPT_DIR / \"cost-table.yaml\")\n\n    text: Optional[str] = None\n    if path.is_file():\n        try:\n            text = path.read_text(encoding=\"utf-8\")\n        except OSError:\n            text = None\n\n    parsed: Dict[str, Dict[str, float]] = _parse_cost_table_yaml(text) if text else {}\n    complete_rows = {\n        mid: row\n        for mid, row in parsed.items()\n        if \"input_per_mtok\" in row and \"output_per_mtok\" in row\n    }\n\n    if not complete_rows:\n        return PricingResult(\n            table=dict(_EMBEDDED_PRICING),\n            source=(\n                \"embedded (report 05-finops-routing.md \\xa71.4; %s could not \"\n                \"be parsed / had no complete models: rows)\" % path\n            ),\n            used_fallback=True,\n        )\n\n    table = dict(complete_rows)\n    source = \"parsed from %s\" % path\n    if is_default_path:\n        # Conditional by construction: an override that merely restates\n        # what the file already says is NOT a correction. Reporting it as\n        # one prints a fix that fixed nothing, and applying it anyway\n        # would silently mask a legitimate refresh of the table.\n        applied: List[str] = []\n        noop: List[str] = []\n        for mid in sorted(_RATIFIED_OVERRIDES_FOR_DEFAULT_TABLE):\n            override = _RATIFIED_OVERRIDES_FOR_DEFAULT_TABLE[mid]\n            if _override_is_a_no_op(table.get(mid), override):\n                noop.append(mid)\n                continue\n            table[mid] = dict(override)\n            applied.append(\n                \"%s -> $%g/$%g\"\n                % (\n                    mid,\n                    override[\"input_per_mtok\"],\n                    override[\"output_per_mtok\"],\n                )\n            )\n        if applied:\n            source += (\n                \" + ratified correction (%s; 2026-09-01, CLAUDE.md \"\n                \"e47bf5d)\" % \", \".join(applied)\n            )\n        if noop:\n            source += (\n                \" + ratified correction NOT needed for %s (the file \"\n                \"already carries the ratified rate)\" % \", \".join(noop)\n            )\n    return PricingResult(table=table, source=source, used_fallback=False)\n\n\n# ---------------------------------------------------------------------------\n# Transcript discovery + parsing\n# ---------------------------------------------------------------------------\n\n\n","numLines":240,"startLine":1,"totalLines":240}},"tool_result_meta":[{"id":"toolu_01SXfng61aj2ANr8T3EFc5RT","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
