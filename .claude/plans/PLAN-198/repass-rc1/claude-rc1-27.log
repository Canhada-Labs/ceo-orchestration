{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1Pw6ASFB5ArZ93zkzMx","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SHLLqnZXYDdDhnFLNo8bv8","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_cost_transcripts_parts/routing_helpers.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":11906,"cache_read_input_tokens":87682,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11906},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"383b699d-3190-4c1b-a4de-9afabb13d7c6","uuid":"8edcb16b-0a2e-4b78-922e-ea0b67d27192","timestamp":"2026-11-13T18:25:30.069Z","request_id":"req_011Ch1Pw5w3icofw35DFMfwm","wire_tool_inputs":{"toolu_01SHLLqnZXYDdDhnFLNo8bv8":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_cost_transcripts_parts/routing_helpers.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SHLLqnZXYDdDhnFLNo8bv8","type":"tool_result","content":"1\t\"\"\"Extracted cost-transcripts implementation: routing_helpers.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport glob\n6\timport json\n7\timport os\n8\timport re\n9\timport sys\n10\timport time\n11\tfrom dataclasses import dataclass, field\n12\tfrom datetime import datetime, timedelta, timezone\n13\tfrom pathlib import Path\n14\tfrom typing import Any, Dict, List, Optional, Tuple\n15\t\n16\t_GROUP_KEYS = {\n17\t    \"model\": lambda p: p.rec.model,\n18\t    \"role\": lambda p: p.rec.role,\n19\t    \"session\": lambda p: p.rec.session_id,\n20\t    \"day\": lambda p: p.rec.ts.strftime(\"%Y-%m-%d\"),\n21\t}\n22\t\n23\t#: How the ORDERED dimensions of a multi-dimension `--by` are joined into\n24\t#: ONE bucket label. Rail r1 [P2]: assuming the separator is absent from\n25\t#: every dimension's value space is an ASSERTION, not a guarantee -- a\n26\t#: session id carrying it would merge two distinct tuples into one\n27\t#: bucket. Each component is ESCAPED first, so the label is injective\n28\t#: whatever the corpus contains.\n29\t_BY_SEPARATOR = \" | \"\n30\t\n31\t\n32\tdef _escape_dim_value(v: Any) -> str:\n33\t    \"\"\"Make one dimension value safe to join with `_BY_SEPARATOR`.\n34\t\n35\t    Backslash first, then the pipe: after this, a literal `|` inside a\n36\t    value can never be read as the joiner, so distinct tuples keep\n37\t    distinct labels (the mapping is injective, not merely usually\n38\t    unambiguous).\n39\t    \"\"\"\n40\t    return str(v).replace(\"\\\\\", \"\\\\\\\\\").replace(\"|\", \"\\\\|\")\n41\t\n42\t\n43\tdef _split_by(by: Any) -> List[str]:\n44\t    \"\"\"The ONE grammar for `--by`: an ORDERED, comma-separated dimension list.\n45\t\n46\t    The flag, ``transcript_rollup()`` and ``aggregate()`` all parse through\n47\t    this function, so a second grafia of the grammar cannot appear (the\n48\t    D1-D4 defect class of CLAUDE.md section 5). The ORDER given is the\n49\t    GROUPING order. Raises ``ValueError`` with a NAMED reason; ``main()``\n50\t    turns that into an rc-2 refusal instead of quietly grouping by\n51\t    something else.\n52\t    \"\"\"\n53\t    raw = by if isinstance(by, str) else \",\".join(str(d) for d in by)\n54\t    valid = \", \".join(sorted(_GROUP_KEYS))\n55\t    if not raw.strip():\n56\t        raise ValueError(\"empty --by value; expected one or more of: %s\" % valid)\n57\t    out: List[str] = []\n58\t    for d in [part.strip() for part in raw.split(\",\")]:\n59\t        if not d:\n60\t            raise ValueError(\n61\t                \"empty dimension in --by %r (stray comma); expected one or \"\n62\t                \"more of: %s\" % (raw, valid)\n63\t            )\n64\t        if d not in _GROUP_KEYS:\n65\t            raise ValueError(\n66\t                \"unknown breakdown dimension: %r; expected one or more of: \"\n67\t                \"%s\" % (d, valid)\n68\t            )\n69\t        if d in out:\n70\t            raise ValueError(\"duplicated dimension %r in --by %r\" % (d, raw))\n71\t        out.append(d)\n72\t    return out\n73\t\n74\t\n75\tdef _group_key_fn(dims: List[str]) -> Any:\n76\t    \"\"\"Bucket key for an ORDERED dimension list, `_BY_SEPARATOR`-joined.\n77\t\n78\t    One dimension keeps the bare value it always had (so a `--by model`\n79\t    report is byte-identical to the pre-`--until` one); two or more are\n80\t    ESCAPED and joined in the order the caller asked for.\n81\t    \"\"\"\n82\t    fns = [_GROUP_KEYS[d] for d in dims]\n83\t    if len(fns) == 1:\n84\t        return fns[0]\n85\t    return lambda p: _BY_SEPARATOR.join(_escape_dim_value(fn(p)) for fn in fns)\n86\t\n87\t\n88\t_TOKEN_CLASSES = (\n89\t    \"input_tokens\",\n90\t    \"output_tokens\",\n91\t    \"cache_read_tokens\",\n92\t    \"cache_write_5m\",\n93\t    \"cache_write_1h\",\n94\t)\n95\t\n96\t\n97\tdef _bucket_totals() -> Dict[str, float]:\n98\t    return {\n99\t        \"turns\": 0,\n100\t        \"input_tokens\": 0,\n101\t        \"output_tokens\": 0,\n102\t        \"cache_read_tokens\": 0,\n103\t        \"cache_write_5m\": 0,\n104\t        \"cache_write_1h\": 0,\n105\t        \"usd\": 0.0,\n106\t    }\n107\t\n108\t\n109\tdef aggregate(priced: List[Priced], by: str) -> Tuple[Dict[str, float], Dict[str, Dict[str, float]], Dict[str, Dict[str, float]]]:\n110\t    \"\"\"Returns (grand_total, role_totals, by-dimension totals).\"\"\"\n111\t    grand = _bucket_totals()\n112\t    role_totals: Dict[str, Dict[str, float]] = {}\n113\t    group_totals: Dict[str, Dict[str, float]] = {}\n114\t    key_fn = _group_key_fn(_split_by(by))\n115\t\n116\t    for p in priced:\n117\t        for d in (grand, role_totals.setdefault(p.rec.role, _bucket_totals()), group_totals.setdefault(key_fn(p), _bucket_totals())):\n118\t            d[\"turns\"] += 1\n119\t            for cls in _TOKEN_CLASSES:\n120\t                d[cls] += getattr(p.rec, cls)\n121\t            d[\"usd\"] += p.cost_usd\n122\t\n123\t    return grand, role_totals, group_totals\n124\t\n125\t\n126\t# ---------------------------------------------------------------------------\n127\t# Routing invariant (PLAN-186 AC-13) -- contract in the module docstring\n128\t# ---------------------------------------------------------------------------\n129\t\n130\t#: Verdicts, worst first. The order IS the precedence: a violation is never\n131\t#: masked by an incomplete read, and an incomplete read is never reported\n132\t#: as \"nothing to compare\".\n133\tROUTING_VERDICTS = (\"RED\", \"INCONCLUSIVE\", \"VACUOUS\", \"GREEN\")\n134\t\n135\t#: `--assert-routing` exit codes (rc 2 stays the argument-error code).\n136\tROUTING_RC_GREEN = 0\n137\tROUTING_RC_RED = 1\n138\tROUTING_RC_NOT_PROVEN = 3\n139\t\n140\t#: Declarations that make NO routing claim at the call site.\n141\t_NO_CLAIM_DECLARATIONS = frozenset({\"\", \"inherit\"})\n142\t\n143\t#: A spawn sidecar is a few hundred bytes. Anything bigger is not one, and\n144\t#: is refused rather than parsed.\n145\t_SIDECAR_MAX_BYTES = 65536\n146\t\n147\t#: The harness pseudo-model stamped on turns that never reached a model\n148\t#: (errors, rate-limit walls). Zero tokens by construction.\n149\t_SYNTHETIC_MODEL = \"<synthetic>\"\n150\t\n151\t_FAMILY_RE = re.compile(r\"^claude-(?:\\d+-)*([a-z]+)(?:-|$)\")\n152\t_DATED_SUFFIX_RE = re.compile(r\"-\\d{8}\")\n153\t_DECLARED_ID_RE = re.compile(r\"^claude-[a-z0-9][a-z0-9._-]*$\")\n154\t\n155\t#: What the human/JSON report cites so the pre-registration cannot drift\n156\t#: away from the code that enforces it.\n157\tROUTING_PREREG_POINTER = (\n158\t    \"death criteria K-A1..K-A3 and K-B1..K-B2 are pre-registered in the \"\n159\t    \"module docstring of ceo-cost-transcripts.py\"\n160\t)\n161\t\n162\t\n163\tdef model_family(model_id: Any) -> Optional[str]:\n164\t    \"\"\"Family token of a model id: ``claude-opus-5-5`` -> ``opus``,\n165\t    ``claude-haiku-4-5-[REDACTED:rg]`` -> ``haiku``, ``claude-3-5-haiku-x`` ->\n166\t    ``haiku``. ``None`` when the id does not parse.\"\"\"\n167\t    if not isinstance(model_id, str):\n168\t        return None\n169\t    m = _FAMILY_RE.match(model_id.strip().lower())\n170\t    return m.group(1) if m else None\n171\t\n172\t\n173\tdef _floor_source() -> Optional[Tuple[frozenset, frozenset]]:\n174\t    \"\"\"(VETO_FLOOR_ROLES, VETO_FLOOR_ALLOWED), imported at CALL time from\n175\t    the repo's own ``_lib.agent_frontmatter`` -- the Owner-signed source,\n176\t    never a copy. ``None`` (and the verdict says so) when it cannot be\n177\t    read: a floor predicate that silently skipped itself would be a\n178\t    vacuous GREEN.\"\"\"\n179\t    try:\n180\t        from _lib import agent_frontmatter as _af\n181\t\n182\t        roles = frozenset(str(r) for r in _af.VETO_FLOOR_ROLES)\n183\t        allowed = frozenset(str(m).strip().lower() for m in _af.VETO_FLOOR_ALLOWED)\n184\t    except Exception:\n185\t        return None\n186\t    if not roles or not allowed:\n187\t        return None\n188\t    return roles, allowed\n189\t\n190\t\n191\tdef known_families(floor: Optional[Tuple[frozenset, frozenset]] = None) -> frozenset:\n192\t    \"\"\"The alias vocabulary, DERIVED from the fleet tables (the pricing\n193\t    table and the floor allowlist): a family the fleet does not name is an\n194\t    unclassified declaration, not a guess.\"\"\"\n195\t    out = set()\n196\t    sources: List[str] = list(_EMBEDDED_PRICING)\n197\t    if floor is not None:\n198\t        sources.extend(floor[1])\n199\t    for mid in sources:\n200\t        fam = model_family(mid)\n201\t        if fam:\n202\t            out.add(fam)\n203\t    return frozenset(out)\n204\t\n205\t\n206\tdef classify_declared(raw: Any, families: frozenset) -> Tuple[str, str]:\n207\t    \"\"\"(kind, value) for a sidecar ``model`` value.\n208\t\n209\t    kind is ``none`` (no claim), ``alias`` (a family token), ``id`` (a full\n210\t    model id, compared exactly) or ``unclassified`` (cannot be compared;\n211\t    named, never guessed). A trailing context-window suffix (``[1m]``) is\n212\t    stripped exactly as it is for served ids.\n213\t    \"\"\"\n214\t    if raw is None:\n215\t        return \"none\", \"\"\n216\t    if not isinstance(raw, str):\n217\t        return \"unclassified\", repr(raw)[:40]\n218\t    d = _MODEL_SUFFIX_RE.sub(\"\", raw.strip()).strip().lower()\n219\t    if d in _NO_CLAIM_DECLARATIONS:\n220\t        return \"none\", d\n221\t    if d in families:\n222\t        return \"alias\", d\n223\t    if _DECLARED_ID_RE.match(d):\n224\t        return \"id\", d\n225\t    return \"unclassified\", d[:40]\n226\t\n227\t\n228\tdef declaration_matches(kind: str, declared: str, served: str) -> bool:\n229\t    \"\"\"One served model id against one classified declaration.\"\"\"\n230\t    s = served.strip().lower()\n231\t    if kind == \"alias\":\n232\t        return model_family(s) == declared\n233\t    if kind == \"id\":\n234\t        if s == declared:\n235\t            return True\n236\t        return s.startswith(declared) and _DATED_SUFFIX_RE.fullmatch(\n237\t            s[len(declared):]\n238\t        ) is not None\n239\t    return False\n240\t\n241\t\n242\tdef _discover_sidecars(project_dir: Path) -> List[str]:\n243\t    return sorted(\n244\t        glob.glob(\n245\t            str(project_dir / \"*\" / \"subagents\" / \"**\" / \"agent-*.meta.json\"),\n246\t            recursive=True,\n247\t        )\n248\t    )\n249\t\n250\t\n251\tdef _inside(path: str, root_real: str) -> bool:\n252\t    \"\"\"True when `path` is a regular, non-symlink file whose real location\n253\t    stays inside the corpus root. A link inside the corpus that points at\n254\t    another agent's transcript would mis-attribute a model; one that points\n255\t    outside would read a file the corpus never owned.\"\"\"\n256\t    if os.path.islink(path):\n257\t        return False\n258\t    real = os.path.realpath(path)\n259\t    return real == root_real or real.startswith(root_real + os.sep)\n260\t\n261\t\n262\tdef _read_sidecar(path: str) -> Optional[Dict[str, Any]]:\n263\t    try:\n264\t        if os.stat(path).st_size > _SIDECAR_MAX_BYTES:\n265\t            return None\n266\t        with open(path, \"rb\") as f:\n267\t            obj = json.loads(f.read())\n268\t    except (OSError, ValueError, RecursionError):\n269\t        return None\n270\t    return obj if isinstance(obj, dict) else None\n271\t\n272\t\n273\tdef _archetype(side: Dict[str, Any]) -> str:\n274\t    for key in (\"customAgentType\", \"agentType\"):\n275\t        v = side.get(key)\n276\t        if isinstance(v, str) and v:\n277\t            return v\n278\t    return \"\"\n279\t\n280\t\n281\tdef _label(side: Dict[str, Any], sidecar_path: str) -> str:\n282\t    for key in (\"description\", \"name\"):\n283\t        v = side.get(key)\n284\t        if isinstance(v, str) and v.strip():\n285\t            return _safe_text(\" \".join(v.split()))\n286\t    return _safe_text(os.path.basename(sidecar_path)[: -len(\".meta.json\")])\n287\t\n288\t\n289\tdef _in_window(\n290\t    ts: datetime, cutoff: Optional[datetime], until: Optional[datetime]\n291\t) -> bool:\n292\t    return (cutoff is None or ts >= cutoff) and (until is None or ts <= until)\n293\t\n294\t\n295\tdef _unplaced_or_inside(\n296\t    stamps: List[Optional[datetime]],\n297\t    cutoff: Optional[datetime],\n298\t    until: Optional[datetime],\n299\t) -> int:\n300\t    \"\"\"How many of these record timestamps can still matter to the window:\n301\t    those with no valid timestamp (no temporal position at all) and those\n302\t    inside it. A record with a valid timestamp OUTSIDE the window leaves\n303\t    before it can count as anything.\"\"\"\n304\t    return sum(1 for t in stamps if t is None or _in_window(t, cutoff, until))\n305\t\n306\t\n307\tdef _served_models(\n308\t    transcript: str,\n309\t    project_dir: Path,\n310\t    cutoff: Optional[datetime],\n311\t    until: Optional[datetime],\n312\t    tally: Dict[str, int],\n313\t) -> Optional[Dict[str, int]]:\n314\t    \"\"\"{served model id: turns} for ONE spawn transcript.\n315\t\n316\t    ``{}`` means no REAL served turn exists (no assistant turn at all, or\n317\t    only ``<synthetic>`` ones); ``None`` means assistant turns exist but\n318\t    every one is outside the window.\n319\t\n320\t    Goes through ``scan_files()`` and ``dedup()`` -- the cost report's own\n321\t    reader -- so a message whose streamed chunks disagree about the model\n322\t    resolves to the TERMINAL chunk's model exactly as it does for cost, and\n323\t    there is no second grafia of either. The served model is a fact of the\n324\t    TURN, not of its token bill, so the read is ``usage_optional``: a turn\n325\t    the cost report drops (``usage`` null, absent or empty) is still read\n326\t    here, and one that cannot be read at all is counted, never silent --\n327\t    but only if it can matter to THIS window: a record with a valid\n328\t    timestamp outside it leaves before anything about it is counted.\n329\t    ``tally`` accumulates the reader's incompleteness counters and the\n330\t    message groups whose chunks disagree about the model. A disagreeing\n331\t    group whose terminal chunk can be elected from complete information\n332\t    (every chunk carries ``output_tokens``) is only counted\n333\t    (``chunk_model_splits``, informational); one that has a chunk WITHOUT\n334\t    ``output_tokens`` cannot be elected: it is counted in\n335\t    ``chunk_terminal_unprovable`` (the verdict is INCONCLUSIVE) and EXCLUDED\n336\t    from the returned models, so its guessed terminal can never produce a\n337\t    violation.\n338\t    \"\"\"\n339\t    counters = ScanCounters()\n340\t    recs = scan_files(\n341\t        [Path(transcript)], \"subagent\", project_dir, counters, usage_optional=True\n342\t    )\n343\t    tally[\"incomplete_reads\"] += (\n344\t        counters.corrupted_lines\n345\t        + counters.missing_timestamp\n346\t        + counters.unreadable_files\n347\t        + counters.missing_usage_keys\n348\t        + counters.assistant_without_usage\n349\t        + _unplaced_or_inside(counters.unreadable_assistant_ts, cutoff, until)\n350\t    )\n351\t    if not recs:\n352\t        return {}\n353\t    if cutoff is not None:\n354\t        recs = [r for r in recs if r.ts >= cutoff]\n355\t    if until is not None:\n356\t        recs = [r for r in recs if r.ts <= until]\n357\t    groups: Dict[str, List[UsageRecord]] = {}\n358\t    for r in recs:\n359\t        groups.setdefault(r.key, []).append(r)\n360\t    unprovable = set()\n361\t    for key, chunks in groups.items():\n362\t        if len({c.model for c in chunks}) > 1:\n363\t            tally[\"chunk_model_splits\"] += 1\n364\t            if not all(c.has_usage for c in chunks):\n365\t                tally[\"chunk_terminal_unprovable\"] += 1\n366\t                unprovable.add(key)\n367\t    if unprovable:\n368\t        # A group whose terminal chunk cannot be proven is NOT evidence: the\n369\t        # model `dedup()` would elect for it is a guess, so it may neither\n370\t        # raise a violation (a MISMATCH, a FLOOR_BREACH) nor vouch for the\n371\t        # routing. It leaves the comparison and the verdict is INCONCLUSIVE\n372\t        # (``chunk_terminal_unprovable``); a violation can still win, but\n373\t        # only from ANOTHER group whose terminal is proven.\n374\t        recs = [r for r in recs if r.key not in unprovable]\n375\t        if not recs:\n376\t            return {}\n377\t    deduped, _dropped = dedup(recs)\n378\t    if not deduped:\n379\t        return None\n380\t    served: Dict[str, int] = {}\n381\t    for r in deduped:\n382\t        if r.model == _SYNTHETIC_MODEL:\n383\t            tally[\"synthetic_turns_ignored\"] += 1\n384\t            continue\n385\t        if r.model.startswith(\"(unresolved:\"):\n386\t            tally[\"served_unresolved\"] += 1\n387\t            continue\n388\t        served[r.model.lower()] = served.get(r.model.lower(), 0) + 1\n389\t    return served\n390\t\n391\t\n392\tdef _placement(\n393\t    transcript: str,\n394\t    project_dir: Path,\n395\t    cutoff: Optional[datetime],\n396\t    until: Optional[datetime],\n397\t) -> str:\n398\t    \"\"\"Where a spawn sits relative to the window, from its transcript alone:\n399\t    ``in`` (some assistant turn is inside), ``out`` (turns exist, none\n400\t    inside), ``none`` (no assistant turn at all) or ``unplaceable`` (nothing\n401\t    inside AND the read was incomplete, so a torn line may be the in-window\n402\t    turn -- fail closed). Read with throwaway counters: whether the spawn\n403\t    matters to this window is decided here, before anything about it can\n404\t    gate the verdict.\"\"\"\n405\t    counters = ScanCounters()\n406\t    recs = scan_files(\n407\t        [Path(transcript)], \"subagent\", project_dir, counters, usage_optional=True\n408\t    )\n409\t    for r in recs:\n410\t        if _in_window(r.ts, cutoff, until):\n411\t            return \"in\"\n412\t    stamped = [t for t in counters.unreadable_assistant_ts if t is not None]\n413\t    if any(_in_window(t, cutoff, until) for t in stamped):\n414\t        return \"in\"\n415\t    dirty = (\n416\t        counters.corrupted_lines\n417\t        + counters.missing_timestamp\n418\t        + counters.unreadable_files\n419\t        + (len(counters.unreadable_assistant_ts) - len(stamped))\n420\t    )\n421\t    if dirty:\n422\t        return \"unplaceable\"\n423\t    return \"out\" if (recs or stamped) else \"none\"\n424\t\n425\t\n426\t"}]},"parent_tool_use_id":null,"session_id":"383b699d-3190-4c1b-a4de-9afabb13d7c6","uuid":"4f67ef0f-2a42-458d-9a54-1638c7d6754a","timestamp":"2026-11-13T18:25:30.092Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_cost_transcripts_parts/routing_helpers.py","content":"\"\"\"Extracted cost-transcripts implementation: routing_helpers.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport glob\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n_GROUP_KEYS = {\n    \"model\": lambda p: p.rec.model,\n    \"role\": lambda p: p.rec.role,\n    \"session\": lambda p: p.rec.session_id,\n    \"day\": lambda p: p.rec.ts.strftime(\"%Y-%m-%d\"),\n}\n\n#: How the ORDERED dimensions of a multi-dimension `--by` are joined into\n#: ONE bucket label. Rail r1 [P2]: assuming the separator is absent from\n#: every dimension's value space is an ASSERTION, not a guarantee -- a\n#: session id carrying it would merge two distinct tuples into one\n#: bucket. Each component is ESCAPED first, so the label is injective\n#: whatever the corpus contains.\n_BY_SEPARATOR = \" | \"\n\n\ndef _escape_dim_value(v: Any) -> str:\n    \"\"\"Make one dimension value safe to join with `_BY_SEPARATOR`.\n\n    Backslash first, then the pipe: after this, a literal `|` inside a\n    value can never be read as the joiner, so distinct tuples keep\n    distinct labels (the mapping is injective, not merely usually\n    unambiguous).\n    \"\"\"\n    return str(v).replace(\"\\\\\", \"\\\\\\\\\").replace(\"|\", \"\\\\|\")\n\n\ndef _split_by(by: Any) -> List[str]:\n    \"\"\"The ONE grammar for `--by`: an ORDERED, comma-separated dimension list.\n\n    The flag, ``transcript_rollup()`` and ``aggregate()`` all parse through\n    this function, so a second grafia of the grammar cannot appear (the\n    D1-D4 defect class of CLAUDE.md section 5). The ORDER given is the\n    GROUPING order. Raises ``ValueError`` with a NAMED reason; ``main()``\n    turns that into an rc-2 refusal instead of quietly grouping by\n    something else.\n    \"\"\"\n    raw = by if isinstance(by, str) else \",\".join(str(d) for d in by)\n    valid = \", \".join(sorted(_GROUP_KEYS))\n    if not raw.strip():\n        raise ValueError(\"empty --by value; expected one or more of: %s\" % valid)\n    out: List[str] = []\n    for d in [part.strip() for part in raw.split(\",\")]:\n        if not d:\n            raise ValueError(\n                \"empty dimension in --by %r (stray comma); expected one or \"\n                \"more of: %s\" % (raw, valid)\n            )\n        if d not in _GROUP_KEYS:\n            raise ValueError(\n                \"unknown breakdown dimension: %r; expected one or more of: \"\n                \"%s\" % (d, valid)\n            )\n        if d in out:\n            raise ValueError(\"duplicated dimension %r in --by %r\" % (d, raw))\n        out.append(d)\n    return out\n\n\ndef _group_key_fn(dims: List[str]) -> Any:\n    \"\"\"Bucket key for an ORDERED dimension list, `_BY_SEPARATOR`-joined.\n\n    One dimension keeps the bare value it always had (so a `--by model`\n    report is byte-identical to the pre-`--until` one); two or more are\n    ESCAPED and joined in the order the caller asked for.\n    \"\"\"\n    fns = [_GROUP_KEYS[d] for d in dims]\n    if len(fns) == 1:\n        return fns[0]\n    return lambda p: _BY_SEPARATOR.join(_escape_dim_value(fn(p)) for fn in fns)\n\n\n_TOKEN_CLASSES = (\n    \"input_tokens\",\n    \"output_tokens\",\n    \"cache_read_tokens\",\n    \"cache_write_5m\",\n    \"cache_write_1h\",\n)\n\n\ndef _bucket_totals() -> Dict[str, float]:\n    return {\n        \"turns\": 0,\n        \"input_tokens\": 0,\n        \"output_tokens\": 0,\n        \"cache_read_tokens\": 0,\n        \"cache_write_5m\": 0,\n        \"cache_write_1h\": 0,\n        \"usd\": 0.0,\n    }\n\n\ndef aggregate(priced: List[Priced], by: str) -> Tuple[Dict[str, float], Dict[str, Dict[str, float]], Dict[str, Dict[str, float]]]:\n    \"\"\"Returns (grand_total, role_totals, by-dimension totals).\"\"\"\n    grand = _bucket_totals()\n    role_totals: Dict[str, Dict[str, float]] = {}\n    group_totals: Dict[str, Dict[str, float]] = {}\n    key_fn = _group_key_fn(_split_by(by))\n\n    for p in priced:\n        for d in (grand, role_totals.setdefault(p.rec.role, _bucket_totals()), group_totals.setdefault(key_fn(p), _bucket_totals())):\n            d[\"turns\"] += 1\n            for cls in _TOKEN_CLASSES:\n                d[cls] += getattr(p.rec, cls)\n            d[\"usd\"] += p.cost_usd\n\n    return grand, role_totals, group_totals\n\n\n# ---------------------------------------------------------------------------\n# Routing invariant (PLAN-186 AC-13) -- contract in the module docstring\n# ---------------------------------------------------------------------------\n\n#: Verdicts, worst first. The order IS the precedence: a violation is never\n#: masked by an incomplete read, and an incomplete read is never reported\n#: as \"nothing to compare\".\nROUTING_VERDICTS = (\"RED\", \"INCONCLUSIVE\", \"VACUOUS\", \"GREEN\")\n\n#: `--assert-routing` exit codes (rc 2 stays the argument-error code).\nROUTING_RC_GREEN = 0\nROUTING_RC_RED = 1\nROUTING_RC_NOT_PROVEN = 3\n\n#: Declarations that make NO routing claim at the call site.\n_NO_CLAIM_DECLARATIONS = frozenset({\"\", \"inherit\"})\n\n#: A spawn sidecar is a few hundred bytes. Anything bigger is not one, and\n#: is refused rather than parsed.\n_SIDECAR_MAX_BYTES = 65536\n\n#: The harness pseudo-model stamped on turns that never reached a model\n#: (errors, rate-limit walls). Zero tokens by construction.\n_SYNTHETIC_MODEL = \"<synthetic>\"\n\n_FAMILY_RE = re.compile(r\"^claude-(?:\\d+-)*([a-z]+)(?:-|$)\")\n_DATED_SUFFIX_RE = re.compile(r\"-\\d{8}\")\n_DECLARED_ID_RE = re.compile(r\"^claude-[a-z0-9][a-z0-9._-]*$\")\n\n#: What the human/JSON report cites so the pre-registration cannot drift\n#: away from the code that enforces it.\nROUTING_PREREG_POINTER = (\n    \"death criteria K-A1..K-A3 and K-B1..K-B2 are pre-registered in the \"\n    \"module docstring of ceo-cost-transcripts.py\"\n)\n\n\ndef model_family(model_id: Any) -> Optional[str]:\n    \"\"\"Family token of a model id: ``claude-opus-5-5`` -> ``opus``,\n    ``claude-haiku-4-5-[REDACTED:rg]`` -> ``haiku``, ``claude-3-5-haiku-x`` ->\n    ``haiku``. ``None`` when the id does not parse.\"\"\"\n    if not isinstance(model_id, str):\n        return None\n    m = _FAMILY_RE.match(model_id.strip().lower())\n    return m.group(1) if m else None\n\n\ndef _floor_source() -> Optional[Tuple[frozenset, frozenset]]:\n    \"\"\"(VETO_FLOOR_ROLES, VETO_FLOOR_ALLOWED), imported at CALL time from\n    the repo's own ``_lib.agent_frontmatter`` -- the Owner-signed source,\n    never a copy. ``None`` (and the verdict says so) when it cannot be\n    read: a floor predicate that silently skipped itself would be a\n    vacuous GREEN.\"\"\"\n    try:\n        from _lib import agent_frontmatter as _af\n\n        roles = frozenset(str(r) for r in _af.VETO_FLOOR_ROLES)\n        allowed = frozenset(str(m).strip().lower() for m in _af.VETO_FLOOR_ALLOWED)\n    except Exception:\n        return None\n    if not roles or not allowed:\n        return None\n    return roles, allowed\n\n\ndef known_families(floor: Optional[Tuple[frozenset, frozenset]] = None) -> frozenset:\n    \"\"\"The alias vocabulary, DERIVED from the fleet tables (the pricing\n    table and the floor allowlist): a family the fleet does not name is an\n    unclassified declaration, not a guess.\"\"\"\n    out = set()\n    sources: List[str] = list(_EMBEDDED_PRICING)\n    if floor is not None:\n        sources.extend(floor[1])\n    for mid in sources:\n        fam = model_family(mid)\n        if fam:\n            out.add(fam)\n    return frozenset(out)\n\n\ndef classify_declared(raw: Any, families: frozenset) -> Tuple[str, str]:\n    \"\"\"(kind, value) for a sidecar ``model`` value.\n\n    kind is ``none`` (no claim), ``alias`` (a family token), ``id`` (a full\n    model id, compared exactly) or ``unclassified`` (cannot be compared;\n    named, never guessed). A trailing context-window suffix (``[1m]``) is\n    stripped exactly as it is for served ids.\n    \"\"\"\n    if raw is None:\n        return \"none\", \"\"\n    if not isinstance(raw, str):\n        return \"unclassified\", repr(raw)[:40]\n    d = _MODEL_SUFFIX_RE.sub(\"\", raw.strip()).strip().lower()\n    if d in _NO_CLAIM_DECLARATIONS:\n        return \"none\", d\n    if d in families:\n        return \"alias\", d\n    if _DECLARED_ID_RE.match(d):\n        return \"id\", d\n    return \"unclassified\", d[:40]\n\n\ndef declaration_matches(kind: str, declared: str, served: str) -> bool:\n    \"\"\"One served model id against one classified declaration.\"\"\"\n    s = served.strip().lower()\n    if kind == \"alias\":\n        return model_family(s) == declared\n    if kind == \"id\":\n        if s == declared:\n            return True\n        return s.startswith(declared) and _DATED_SUFFIX_RE.fullmatch(\n            s[len(declared):]\n        ) is not None\n    return False\n\n\ndef _discover_sidecars(project_dir: Path) -> List[str]:\n    return sorted(\n        glob.glob(\n            str(project_dir / \"*\" / \"subagents\" / \"**\" / \"agent-*.meta.json\"),\n            recursive=True,\n        )\n    )\n\n\ndef _inside(path: str, root_real: str) -> bool:\n    \"\"\"True when `path` is a regular, non-symlink file whose real location\n    stays inside the corpus root. A link inside the corpus that points at\n    another agent's transcript would mis-attribute a model; one that points\n    outside would read a file the corpus never owned.\"\"\"\n    if os.path.islink(path):\n        return False\n    real = os.path.realpath(path)\n    return real == root_real or real.startswith(root_real + os.sep)\n\n\ndef _read_sidecar(path: str) -> Optional[Dict[str, Any]]:\n    try:\n        if os.stat(path).st_size > _SIDECAR_MAX_BYTES:\n            return None\n        with open(path, \"rb\") as f:\n            obj = json.loads(f.read())\n    except (OSError, ValueError, RecursionError):\n        return None\n    return obj if isinstance(obj, dict) else None\n\n\ndef _archetype(side: Dict[str, Any]) -> str:\n    for key in (\"customAgentType\", \"agentType\"):\n        v = side.get(key)\n        if isinstance(v, str) and v:\n            return v\n    return \"\"\n\n\ndef _label(side: Dict[str, Any], sidecar_path: str) -> str:\n    for key in (\"description\", \"name\"):\n        v = side.get(key)\n        if isinstance(v, str) and v.strip():\n            return _safe_text(\" \".join(v.split()))\n    return _safe_text(os.path.basename(sidecar_path)[: -len(\".meta.json\")])\n\n\ndef _in_window(\n    ts: datetime, cutoff: Optional[datetime], until: Optional[datetime]\n) -> bool:\n    return (cutoff is None or ts >= cutoff) and (until is None or ts <= until)\n\n\ndef _unplaced_or_inside(\n    stamps: List[Optional[datetime]],\n    cutoff: Optional[datetime],\n    until: Optional[datetime],\n) -> int:\n    \"\"\"How many of these record timestamps can still matter to the window:\n    those with no valid timestamp (no temporal position at all) and those\n    inside it. A record with a valid timestamp OUTSIDE the window leaves\n    before it can count as anything.\"\"\"\n    return sum(1 for t in stamps if t is None or _in_window(t, cutoff, until))\n\n\ndef _served_models(\n    transcript: str,\n    project_dir: Path,\n    cutoff: Optional[datetime],\n    until: Optional[datetime],\n    tally: Dict[str, int],\n) -> Optional[Dict[str, int]]:\n    \"\"\"{served model id: turns} for ONE spawn transcript.\n\n    ``{}`` means no REAL served turn exists (no assistant turn at all, or\n    only ``<synthetic>`` ones); ``None`` means assistant turns exist but\n    every one is outside the window.\n\n    Goes through ``scan_files()`` and ``dedup()`` -- the cost report's own\n    reader -- so a message whose streamed chunks disagree about the model\n    resolves to the TERMINAL chunk's model exactly as it does for cost, and\n    there is no second grafia of either. The served model is a fact of the\n    TURN, not of its token bill, so the read is ``usage_optional``: a turn\n    the cost report drops (``usage`` null, absent or empty) is still read\n    here, and one that cannot be read at all is counted, never silent --\n    but only if it can matter to THIS window: a record with a valid\n    timestamp outside it leaves before anything about it is counted.\n    ``tally`` accumulates the reader's incompleteness counters and the\n    message groups whose chunks disagree about the model. A disagreeing\n    group whose terminal chunk can be elected from complete information\n    (every chunk carries ``output_tokens``) is only counted\n    (``chunk_model_splits``, informational); one that has a chunk WITHOUT\n    ``output_tokens`` cannot be elected: it is counted in\n    ``chunk_terminal_unprovable`` (the verdict is INCONCLUSIVE) and EXCLUDED\n    from the returned models, so its guessed terminal can never produce a\n    violation.\n    \"\"\"\n    counters = ScanCounters()\n    recs = scan_files(\n        [Path(transcript)], \"subagent\", project_dir, counters, usage_optional=True\n    )\n    tally[\"incomplete_reads\"] += (\n        counters.corrupted_lines\n        + counters.missing_timestamp\n        + counters.unreadable_files\n        + counters.missing_usage_keys\n        + counters.assistant_without_usage\n        + _unplaced_or_inside(counters.unreadable_assistant_ts, cutoff, until)\n    )\n    if not recs:\n        return {}\n    if cutoff is not None:\n        recs = [r for r in recs if r.ts >= cutoff]\n    if until is not None:\n        recs = [r for r in recs if r.ts <= until]\n    groups: Dict[str, List[UsageRecord]] = {}\n    for r in recs:\n        groups.setdefault(r.key, []).append(r)\n    unprovable = set()\n    for key, chunks in groups.items():\n        if len({c.model for c in chunks}) > 1:\n            tally[\"chunk_model_splits\"] += 1\n            if not all(c.has_usage for c in chunks):\n                tally[\"chunk_terminal_unprovable\"] += 1\n                unprovable.add(key)\n    if unprovable:\n        # A group whose terminal chunk cannot be proven is NOT evidence: the\n        # model `dedup()` would elect for it is a guess, so it may neither\n        # raise a violation (a MISMATCH, a FLOOR_BREACH) nor vouch for the\n        # routing. It leaves the comparison and the verdict is INCONCLUSIVE\n        # (``chunk_terminal_unprovable``); a violation can still win, but\n        # only from ANOTHER group whose terminal is proven.\n        recs = [r for r in recs if r.key not in unprovable]\n        if not recs:\n            return {}\n    deduped, _dropped = dedup(recs)\n    if not deduped:\n        return None\n    served: Dict[str, int] = {}\n    for r in deduped:\n        if r.model == _SYNTHETIC_MODEL:\n            tally[\"synthetic_turns_ignored\"] += 1\n            continue\n        if r.model.startswith(\"(unresolved:\"):\n            tally[\"served_unresolved\"] += 1\n            continue\n        served[r.model.lower()] = served.get(r.model.lower(), 0) + 1\n    return served\n\n\ndef _placement(\n    transcript: str,\n    project_dir: Path,\n    cutoff: Optional[datetime],\n    until: Optional[datetime],\n) -> str:\n    \"\"\"Where a spawn sits relative to the window, from its transcript alone:\n    ``in`` (some assistant turn is inside), ``out`` (turns exist, none\n    inside), ``none`` (no assistant turn at all) or ``unplaceable`` (nothing\n    inside AND the read was incomplete, so a torn line may be the in-window\n    turn -- fail closed). Read with throwaway counters: whether the spawn\n    matters to this window is decided here, before anything about it can\n    gate the verdict.\"\"\"\n    counters = ScanCounters()\n    recs = scan_files(\n        [Path(transcript)], \"subagent\", project_dir, counters, usage_optional=True\n    )\n    for r in recs:\n        if _in_window(r.ts, cutoff, until):\n            return \"in\"\n    stamped = [t for t in counters.unreadable_assistant_ts if t is not None]\n    if any(_in_window(t, cutoff, until) for t in stamped):\n        return \"in\"\n    dirty = (\n        counters.corrupted_lines\n        + counters.missing_timestamp\n        + counters.unreadable_files\n        + (len(counters.unreadable_assistant_ts) - len(stamped))\n    )\n    if dirty:\n        return \"unplaceable\"\n    return \"out\" if (recs or stamped) else \"none\"\n\n\n","numLines":426,"startLine":1,"totalLines":426}},"tool_result_meta":[{"id":"toolu_01SHLLqnZXYDdDhnFLNo8bv8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
