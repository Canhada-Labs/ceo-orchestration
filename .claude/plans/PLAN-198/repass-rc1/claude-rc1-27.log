{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RhWjGpWmQCxiUTBZC33Kud","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Validate ceo-restore archive members and extract the accepted ones.\n3\t\n4\t``<tarball>`` checks every member (exit 2 on the first refused one);\n5\t``<tarball> <stage-dir>`` also writes ONLY the accepted members there, so the\n6\tpreview and the apply of ceo-restore.sh share one rule and one extraction.\n7\t\n8\tThe archive must parse to its end: tarfile stops listing members, with no\n9\terror, at a truncated or invalid header, so the member list must end on an\n10\tend-of-archive (all-zero) block and the compressed stream must read cleanly\n11\tto its end.  Two members with the same name are refused, and so are the key\n12\tfiles ``audit/audit-key`` and ``audit/.salt`` in any letter case (the default\n13\tmacOS disk, APFS, ignores case).  Every sparse member is refused, an\n14\tAppleDouble one included, before anything is written.\n15\t\n16\tmacOS tar writes an AppleDouble member ``._<name>`` (extended-attribute\n17\tmetadata) before each entry that carries extended attributes.  It is SKIPPED\n18\t-- checked, never written -- only when it is a regular file whose companion\n19\t(same directory, basename without ``._``; the companion of ``._.`` is the\n20\tdirectory itself) is an accepted member.  Every other ``._`` member is refused.\n21\t\"\"\"\n22\tfrom __future__ import annotations\n23\t\n24\timport os\n25\timport shutil\n26\timport sys\n27\timport tarfile\n28\timport zlib\n29\tfrom typing import Iterable, List, Optional, Tuple\n30\t\n31\t_APPLEDOUBLE_PREFIX = \"._\"\n32\t_KEY_FILES = (\"audit/audit-key\", \"audit/.salt\")\n33\t_CHUNK = 1 << 16\n34\t\n35\t\n36\tdef _normalized(name: str) -> str:\n37\t    \"\"\"Return an archive-relative name or raise for an alias/traversal.\"\"\"\n38\t    if name == \".\":\n39\t        return \"\"\n40\t    if name.startswith(\"./\"):\n41\t        name = name[2:]\n42\t    if not name or name.startswith(\"/\") or \"//\" in name:\n43\t        raise ValueError(\"unsafe path\")\n44\t    parts = name.split(\"/\")\n45\t    if any(part in (\"\", \".\", \"..\") for part in parts):\n46\t        raise ValueError(\"unsafe path\")\n47\t    return name.rstrip(\"/\")\n48\t\n49\t\n50\tdef _allowed(name: str) -> bool:\n51\t    if name in (\"agent-metrics.md\", \"MANIFEST.txt\"):\n52\t        return True\n53\t    return name in (\"audit\", \"memory\", \"plans\") or any(\n54\t        name.startswith(prefix) for prefix in (\"audit/\", \"memory/\", \"plans/\")\n55\t    )\n56\t\n57\t\n58\tdef _appledouble_companion(name: str) -> Optional[str]:\n59\t    \"\"\"Return the companion of an AppleDouble name, None for any other name.\n60\t\n61\t    Raises ValueError when the basename carries the prefix but cannot name a\n62\t    companion (``._`` alone, ``._..``).\n63\t    \"\"\"\n64\t    head, _, base = name.rpartition(\"/\")\n65\t    if not base.startswith(_APPLEDOUBLE_PREFIX):\n66\t        return None\n67\t    target = base[len(_APPLEDOUBLE_PREFIX):]\n68\t    if target == \".\":\n69\t        return head\n70\t    if target in (\"\", \"..\"):\n71\t        raise ValueError(\"no companion\")\n72\t    return head + \"/\" + target if head else target\n73\t\n74\t\n75\tdef validate(members: Iterable[tarfile.TarInfo]) -> List[tarfile.TarInfo]:\n76\t    \"\"\"Reject every non-data member and every name outside the restore layout.\n77\t\n78\t    Returns the members to extract, in archive order.  AppleDouble members\n79\t    that pass the companion rule are left out of the result.\n80\t    \"\"\"\n81\t    accepted: List[tarfile.TarInfo] = []\n82\t    accepted_names = set()\n83\t    seen = set()\n84\t    appledouble: List[Tuple[tarfile.TarInfo, str]] = []\n85\t    for member in members:\n86\t        try:\n87\t            name = _normalized(member.name)\n88\t        except ValueError:\n89\t            raise ValueError(\"refused path: {0}\".format(member.name))\n90\t        if name in seen:\n91\t            raise ValueError(\"refused duplicate path: {0}\".format(member.name))\n92\t        seen.add(name)\n93\t        if member.issparse():\n94\t            raise ValueError(\"refused sparse member: {0}\".format(member.name))\n95\t        try:\n96\t            companion = _appledouble_companion(name) if name else None\n97\t        except ValueError:\n98\t            raise ValueError(\"refused AppleDouble name: {0}\".format(member.name))\n99\t        if companion is not None:\n100\t            if not member.isfile():\n101\t                raise ValueError(\"refused member type: {0}\".format(member.name))\n102\t            appledouble.append((member, companion))\n103\t            continue\n104\t        if not name:\n105\t            if member.isdir():\n106\t                accepted.append(member)\n107\t                accepted_names.add(name)\n108\t                continue\n109\t            raise ValueError(\"refused member type: {0}\".format(member.name))\n110\t        if not _allowed(name):\n111\t            raise ValueError(\"refused path: {0}\".format(member.name))\n112\t        if not (member.isfile() or member.isdir()):\n113\t            raise ValueError(\"refused member type: {0}\".format(member.name))\n114\t        if name.casefold() in _KEY_FILES:\n115\t            raise ValueError(\"refused path: {0}\".format(member.name))\n116\t        accepted.append(member)\n117\t        accepted_names.add(name)\n118\t    for member, companion in appledouble:\n119\t        if companion not in accepted_names:\n120\t            raise ValueError(\"refused path: {0}\".format(member.name))\n121\t    return accepted\n122\t\n123\t\n124\tdef complete_members(archive: tarfile.TarFile) -> List[tarfile.TarInfo]:\n125\t    \"\"\"Return every member, or raise unless the archive parsed to its end.\n126\t\n127\t    The member walk must stop on a full all-zero block (the end-of-archive\n128\t    marker) and the rest of the compressed stream must decompress with a\n129\t    valid checksum; otherwise members after the cut would vanish silently.\n130\t    \"\"\"\n131\t    stream = archive.fileobj\n132\t    try:\n133\t        members = archive.getmembers()\n134\t        stream.seek(archive.offset)\n135\t        block = stream.read(tarfile.BLOCKSIZE)\n136\t        while stream.read(_CHUNK):\n137\t            pass\n138\t    except (EOFError, OSError, tarfile.ReadError, zlib.error) as exc:\n139\t        raise ValueError(\"refused truncated or corrupt archive: {0}\".format(exc))\n140\t    if len(block) != tarfile.BLOCKSIZE or block.count(b\"\\0\") != tarfile.BLOCKSIZE:\n141\t        raise ValueError(\"refused truncated or corrupt archive: no end-of-archive \"\n142\t                         \"block at byte {0}\".format(archive.offset))\n143\t    return members\n144\t\n145\t\n146\tdef extract(archive: tarfile.TarFile, members: Iterable[tarfile.TarInfo],\n147\t            stage: str) -> None:\n148\t    \"\"\"Write the given (already validated) members under ``stage``.\"\"\"\n149\t    nofollow = getattr(os, \"O_NOFOLLOW\", 0)\n150\t    for member in members:\n151\t        name = _normalized(member.name)\n152\t        if not name:\n153\t            continue\n154\t        path = os.path.join(stage, *name.split(\"/\"))\n155\t        if member.isdir():\n156\t            os.makedirs(path, exist_ok=True)\n157\t            continue\n158\t        parent = os.path.dirname(path)\n159\t        if parent:\n160\t            os.makedirs(parent, exist_ok=True)\n161\t        source = archive.extractfile(member)\n162\t        if source is None:\n163\t            raise ValueError(\"refused member type: {0}\".format(member.name))\n164\t        # O_EXCL: a name that lands on a file already written (two members\n165\t        # whose names differ only in letter case, on the default macOS disk,\n166\t        # APFS) is refused, never merged into the earlier file with the\n167\t        # earlier mode.\n168\t        try:\n169\t            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,\n170\t                         member.mode & 0o777)\n171\t        except FileExistsError:\n172\t            source.close()\n173\t            raise ValueError(\"refused duplicate path: {0}\".format(member.name))\n174\t        with os.fdopen(fd, \"wb\") as target, source:\n175\t            shutil.copyfileobj(source, target)\n176\t        os.utime(path, (member.mtime, member.mtime))\n177\t\n178\t\n179\tdef main(argv: List[str]) -> int:\n180\t    if len(argv) not in (2, 3):\n181\t        print(\"usage: _restore_archive.py <tarball> [<stage-dir>]\", file=sys.stderr)\n182\t        return 2\n183\t    stage = argv[2] if len(argv) == 3 else None\n184\t    if stage is not None and (os.path.islink(stage) or not os.path.isdir(stage)):\n185\t        print(\"fatal: stage must be a real directory\", file=sys.stderr)\n186\t        return 2\n187\t    try:\n188\t        with tarfile.open(argv[1], \"r:gz\") as archive:\n189\t            members = validate(complete_members(archive))\n190\t            if stage is not None:\n191\t                extract(archive, members, stage)\n192\t    except (EOFError, OSError, OverflowError, tarfile.TarError, ValueError,\n193\t            zlib.error) as exc:\n194\t        print(\"fatal: archive {0}\".format(exc), file=sys.stderr)\n195\t        return 2\n196\t    return 0\n197\t\n198\t\n199\tif __name__ == \"__main__\":\n200\t    raise SystemExit(main(sys.argv))\n201\t"}]},"parent_tool_use_id":null,"session_id":"383b699d-3190-4c1b-a4de-9afabb13d7c6","uuid":"e9337d52-cd67-4d7e-ab8b-566e38c46159","timestamp":"2026-11-13T18:25:55.436Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/_restore_archive.py","content":"#!/usr/bin/env python3\n\"\"\"Validate ceo-restore archive members and extract the accepted ones.\n\n``<tarball>`` checks every member (exit 2 on the first refused one);\n``<tarball> <stage-dir>`` also writes ONLY the accepted members there, so the\npreview and the apply of ceo-restore.sh share one rule and one extraction.\n\nThe archive must parse to its end: tarfile stops listing members, with no\nerror, at a truncated or invalid header, so the member list must end on an\nend-of-archive (all-zero) block and the compressed stream must read cleanly\nto its end.  Two members with the same name are refused, and so are the key\nfiles ``audit/audit-key`` and ``audit/.salt`` in any letter case (the default\nmacOS disk, APFS, ignores case).  Every sparse member is refused, an\nAppleDouble one included, before anything is written.\n\nmacOS tar writes an AppleDouble member ``._<name>`` (extended-attribute\nmetadata) before each entry that carries extended attributes.  It is SKIPPED\n-- checked, never written -- only when it is a regular file whose companion\n(same directory, basename without ``._``; the companion of ``._.`` is the\ndirectory itself) is an accepted member.  Every other ``._`` member is refused.\n\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport shutil\nimport sys\nimport tarfile\nimport zlib\nfrom typing import Iterable, List, Optional, Tuple\n\n_APPLEDOUBLE_PREFIX = \"._\"\n_KEY_FILES = (\"audit/audit-key\", \"audit/.salt\")\n_CHUNK = 1 << 16\n\n\ndef _normalized(name: str) -> str:\n    \"\"\"Return an archive-relative name or raise for an alias/traversal.\"\"\"\n    if name == \".\":\n        return \"\"\n    if name.startswith(\"./\"):\n        name = name[2:]\n    if not name or name.startswith(\"/\") or \"//\" in name:\n        raise ValueError(\"unsafe path\")\n    parts = name.split(\"/\")\n    if any(part in (\"\", \".\", \"..\") for part in parts):\n        raise ValueError(\"unsafe path\")\n    return name.rstrip(\"/\")\n\n\ndef _allowed(name: str) -> bool:\n    if name in (\"agent-metrics.md\", \"MANIFEST.txt\"):\n        return True\n    return name in (\"audit\", \"memory\", \"plans\") or any(\n        name.startswith(prefix) for prefix in (\"audit/\", \"memory/\", \"plans/\")\n    )\n\n\ndef _appledouble_companion(name: str) -> Optional[str]:\n    \"\"\"Return the companion of an AppleDouble name, None for any other name.\n\n    Raises ValueError when the basename carries the prefix but cannot name a\n    companion (``._`` alone, ``._..``).\n    \"\"\"\n    head, _, base = name.rpartition(\"/\")\n    if not base.startswith(_APPLEDOUBLE_PREFIX):\n        return None\n    target = base[len(_APPLEDOUBLE_PREFIX):]\n    if target == \".\":\n        return head\n    if target in (\"\", \"..\"):\n        raise ValueError(\"no companion\")\n    return head + \"/\" + target if head else target\n\n\ndef validate(members: Iterable[tarfile.TarInfo]) -> List[tarfile.TarInfo]:\n    \"\"\"Reject every non-data member and every name outside the restore layout.\n\n    Returns the members to extract, in archive order.  AppleDouble members\n    that pass the companion rule are left out of the result.\n    \"\"\"\n    accepted: List[tarfile.TarInfo] = []\n    accepted_names = set()\n    seen = set()\n    appledouble: List[Tuple[tarfile.TarInfo, str]] = []\n    for member in members:\n        try:\n            name = _normalized(member.name)\n        except ValueError:\n            raise ValueError(\"refused path: {0}\".format(member.name))\n        if name in seen:\n            raise ValueError(\"refused duplicate path: {0}\".format(member.name))\n        seen.add(name)\n        if member.issparse():\n            raise ValueError(\"refused sparse member: {0}\".format(member.name))\n        try:\n            companion = _appledouble_companion(name) if name else None\n        except ValueError:\n            raise ValueError(\"refused AppleDouble name: {0}\".format(member.name))\n        if companion is not None:\n            if not member.isfile():\n                raise ValueError(\"refused member type: {0}\".format(member.name))\n            appledouble.append((member, companion))\n            continue\n        if not name:\n            if member.isdir():\n                accepted.append(member)\n                accepted_names.add(name)\n                continue\n            raise ValueError(\"refused member type: {0}\".format(member.name))\n        if not _allowed(name):\n            raise ValueError(\"refused path: {0}\".format(member.name))\n        if not (member.isfile() or member.isdir()):\n            raise ValueError(\"refused member type: {0}\".format(member.name))\n        if name.casefold() in _KEY_FILES:\n            raise ValueError(\"refused path: {0}\".format(member.name))\n        accepted.append(member)\n        accepted_names.add(name)\n    for member, companion in appledouble:\n        if companion not in accepted_names:\n            raise ValueError(\"refused path: {0}\".format(member.name))\n    return accepted\n\n\ndef complete_members(archive: tarfile.TarFile) -> List[tarfile.TarInfo]:\n    \"\"\"Return every member, or raise unless the archive parsed to its end.\n\n    The member walk must stop on a full all-zero block (the end-of-archive\n    marker) and the rest of the compressed stream must decompress with a\n    valid checksum; otherwise members after the cut would vanish silently.\n    \"\"\"\n    stream = archive.fileobj\n    try:\n        members = archive.getmembers()\n        stream.seek(archive.offset)\n        block = stream.read(tarfile.BLOCKSIZE)\n        while stream.read(_CHUNK):\n            pass\n    except (EOFError, OSError, tarfile.ReadError, zlib.error) as exc:\n        raise ValueError(\"refused truncated or corrupt archive: {0}\".format(exc))\n    if len(block) != tarfile.BLOCKSIZE or block.count(b\"\\0\") != tarfile.BLOCKSIZE:\n        raise ValueError(\"refused truncated or corrupt archive: no end-of-archive \"\n                         \"block at byte {0}\".format(archive.offset))\n    return members\n\n\ndef extract(archive: tarfile.TarFile, members: Iterable[tarfile.TarInfo],\n            stage: str) -> None:\n    \"\"\"Write the given (already validated) members under ``stage``.\"\"\"\n    nofollow = getattr(os, \"O_NOFOLLOW\", 0)\n    for member in members:\n        name = _normalized(member.name)\n        if not name:\n            continue\n        path = os.path.join(stage, *name.split(\"/\"))\n        if member.isdir():\n            os.makedirs(path, exist_ok=True)\n            continue\n        parent = os.path.dirname(path)\n        if parent:\n            os.makedirs(parent, exist_ok=True)\n        source = archive.extractfile(member)\n        if source is None:\n            raise ValueError(\"refused member type: {0}\".format(member.name))\n        # O_EXCL: a name that lands on a file already written (two members\n        # whose names differ only in letter case, on the default macOS disk,\n        # APFS) is refused, never merged into the earlier file with the\n        # earlier mode.\n        try:\n            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,\n                         member.mode & 0o777)\n        except FileExistsError:\n            source.close()\n            raise ValueError(\"refused duplicate path: {0}\".format(member.name))\n        with os.fdopen(fd, \"wb\") as target, source:\n            shutil.copyfileobj(source, target)\n        os.utime(path, (member.mtime, member.mtime))\n\n\ndef main(argv: List[str]) -> int:\n    if len(argv) not in (2, 3):\n        print(\"usage: _restore_archive.py <tarball> [<stage-dir>]\", file=sys.stderr)\n        return 2\n    stage = argv[2] if len(argv) == 3 else None\n    if stage is not None and (os.path.islink(stage) or not os.path.isdir(stage)):\n        print(\"fatal: stage must be a real directory\", file=sys.stderr)\n        return 2\n    try:\n        with tarfile.open(argv[1], \"r:gz\") as archive:\n            members = validate(complete_members(archive))\n            if stage is not None:\n                extract(archive, members, stage)\n    except (EOFError, OSError, OverflowError, tarfile.TarError, ValueError,\n            zlib.error) as exc:\n        print(\"fatal: archive {0}\".format(exc), file=sys.stderr)\n        return 2\n    return 0\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main(sys.argv))\n","numLines":201,"startLine":1,"totalLines":201}},"tool_result_meta":[{"id":"toolu_01RhWjGpWmQCxiUTBZC33Kud","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
