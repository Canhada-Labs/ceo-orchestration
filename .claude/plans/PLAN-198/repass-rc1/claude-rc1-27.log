{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ViGCWX4QA7p3QPWWRk7Ut6","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom copy import deepcopy\n4\tfrom importlib import import_module\n5\tfrom types import FunctionType\n6\tfrom typing import Any, Dict, Tuple\n7\t\n8\tdef install(namespace: Dict[str, Any], modules: Tuple[str, ...]) -> None:\n9\t    declarations = {}\n10\t    for name in modules:\n11\t        module = import_module(f\"{__name__}.{name}\")\n12\t        declarations.update({key: getattr(module, key) for key in module.__all__})\n13\t        namespace.setdefault(\"__annotations__\", {}).update(getattr(module, \"__annotations__\", {}))\n14\t    namespace.update(deepcopy(declarations))\n15\t    for name, original in declarations.items():\n16\t        if not isinstance(original, FunctionType):\n17\t            continue\n18\t        bound = FunctionType(original.__code__, namespace, original.__name__, original.__defaults__, original.__closure__)\n19\t        bound.__kwdefaults__ = deepcopy(original.__kwdefaults__)\n20\t        bound.__annotations__ = dict(original.__annotations__)\n21\t        bound.__dict__.update(original.__dict__)\n22\t        bound.__qualname__ = original.__qualname__\n23\t        bound.__module__ = namespace[\"__name__\"]\n24\t        namespace[name] = bound\n25\t"}]},"parent_tool_use_id":null,"session_id":"383b699d-3190-4c1b-a4de-9afabb13d7c6","uuid":"6c39df9a-600b-4444-a48f-3b60aa85d6d2","timestamp":"2026-11-13T18:33:55.047Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/__init__.py","content":"from __future__ import annotations\n\nfrom copy import deepcopy\nfrom importlib import import_module\nfrom types import FunctionType\nfrom typing import Any, Dict, Tuple\n\ndef install(namespace: Dict[str, Any], modules: Tuple[str, ...]) -> None:\n    declarations = {}\n    for name in modules:\n        module = import_module(f\"{__name__}.{name}\")\n        declarations.update({key: getattr(module, key) for key in module.__all__})\n        namespace.setdefault(\"__annotations__\", {}).update(getattr(module, \"__annotations__\", {}))\n    namespace.update(deepcopy(declarations))\n    for name, original in declarations.items():\n        if not isinstance(original, FunctionType):\n            continue\n        bound = FunctionType(original.__code__, namespace, original.__name__, original.__defaults__, original.__closure__)\n        bound.__kwdefaults__ = deepcopy(original.__kwdefaults__)\n        bound.__annotations__ = dict(original.__annotations__)\n        bound.__dict__.update(original.__dict__)\n        bound.__qualname__ = original.__qualname__\n        bound.__module__ = namespace[\"__name__\"]\n        namespace[name] = bound\n","numLines":25,"startLine":1,"totalLines":25}},"tool_result_meta":[{"id":"toolu_01ViGCWX4QA7p3QPWWRk7Ut6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
