{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TWPMYiqTk3KVmHnFbRh4rD","type":"tool_result","content":"1\t\"\"\"Extracted cost-transcripts implementation: routing.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport glob\n6\timport json\n7\timport os\n8\timport re\n9\timport sys\n10\timport time\n11\tfrom dataclasses import dataclass, field\n12\tfrom datetime import datetime, timedelta, timezone\n13\tfrom pathlib import Path\n14\tfrom typing import Any, Dict, List, Optional, Tuple\n15\t\n16\tdef routing_invariant(\n17\t    project_dir: Any,\n18\t    cutoff: Optional[datetime] = None,\n19\t    until: Optional[datetime] = None,\n20\t) -> Dict[str, Any]:\n21\t    \"\"\"Assert, over the spawn sidecars + transcripts under `project_dir`,\n22\t    that served == declared and that VETO archetypes were served inside the\n23\t    floor. Pure read; returns the verdict as JSON-safe data.\"\"\"\n24\t    project_dir = Path(project_dir)\n25\t    root_real = os.path.realpath(str(project_dir))\n26\t    floor = _floor_source()\n27\t    families = known_families(floor)\n28\t    veto_roles = floor[0] if floor else frozenset()\n29\t    veto_allowed = floor[1] if floor else frozenset()\n30\t\n31\t    counts: Dict[str, int] = {\n32\t        \"sidecars\": 0,\n33\t        \"declared\": 0,\n34\t        \"undeclared\": 0,\n35\t        \"unclassified\": 0,\n36\t        \"compared_spawns\": 0,\n37\t        \"declared_compared\": 0,\n38\t        \"floor_checked\": 0,\n39\t        \"no_served\": 0,\n40\t        \"out_of_window\": 0,\n41\t        \"unreadable_sidecars\": 0,\n42\t        \"refused_paths\": 0,\n43\t        \"incomplete_reads\": 0,\n44\t        \"served_unresolved\": 0,\n45\t        \"synthetic_turns_ignored\": 0,\n46\t        \"chunk_model_splits\": 0,\n47\t        \"chunk_terminal_unprovable\": 0,\n48\t    }\n49\t    violations: List[Dict[str, Any]] = []\n50\t    alias_resolutions: Dict[str, Dict[str, int]] = {}\n51\t    unclassified_samples: List[str] = []\n52\t\n53\t    def gates_the_window(transcript: str) -> bool:\n54\t        \"\"\"A sidecar the check cannot trust (unreadable, refused, or a\n55\t        declaration it cannot classify) may gate THIS window only if its\n56\t        spawn has a turn in it. A stale one from outside the window is\n57\t        counted where it belongs and never reaches the verdict.\"\"\"\n58\t        if not os.path.exists(transcript):\n59\t            counts[\"no_served\"] += 1\n60\t            return False\n61\t        if not _inside(transcript, root_real):\n62\t            return True\n63\t        where = _placement(transcript, project_dir, cutoff, until)\n64\t        if where == \"out\":\n65\t            counts[\"out_of_window\"] += 1\n66\t            return False\n67\t        if where == \"none\":\n68\t            counts[\"no_served\"] += 1\n69\t            return False\n70\t        return True\n71\t\n72\t    for sc in _discover_sidecars(project_dir):\n73\t        counts[\"sidecars\"] += 1\n74\t        transcript = sc[: -len(\".meta.json\")] + \".jsonl\"\n75\t        sidecar_inside = _inside(sc, root_real)\n76\t        side = _read_sidecar(sc) if sidecar_inside else None\n77\t        if side is None:\n78\t            if gates_the_window(transcript):\n79\t                counts[\"unreadable_sidecars\" if sidecar_inside else \"refused_paths\"] += 1\n80\t            continue\n81\t        kind, declared = classify_declared(side.get(\"model\"), families)\n82\t        archetype = _archetype(side)\n83\t        is_veto = archetype in veto_roles\n84\t        if kind == \"none\":\n85\t            counts[\"undeclared\"] += 1\n86\t        elif kind == \"unclassified\":\n87\t            if not gates_the_window(transcript):\n88\t                continue\n89\t            counts[\"unclassified\"] += 1\n90\t            if len(unclassified_samples) < 5:\n91\t                unclassified_samples.append(_safe_text(declared, 40))\n92\t        else:\n93\t            counts[\"declared\"] += 1\n94\t        needs_served = kind in (\"alias\", \"id\") or is_veto\n95\t        if not needs_served:\n96\t            continue\n97\t\n98\t        if not os.path.exists(transcript):\n99\t            counts[\"no_served\"] += 1\n100\t            continue\n101\t        if not _inside(transcript, root_real):\n102\t            counts[\"refused_paths\"] += 1\n103\t            continue\n104\t        served = _served_models(transcript, project_dir, cutoff, until, counts)\n105\t        if served is None:\n106\t            counts[\"out_of_window\"] += 1\n107\t            continue\n108\t        if not served:\n109\t            counts[\"no_served\"] += 1\n110\t            continue\n111\t\n112\t        # ONE count per spawn that reached a comparison, whatever number of\n113\t        # predicates it fed (a declared VETO spawn feeds both).\n114\t        counts[\"compared_spawns\"] += 1\n115\t        kinds: List[str] = []\n116\t        if kind in (\"alias\", \"id\"):\n117\t            counts[\"declared_compared\"] += 1\n118\t            ok = [m for m in served if declaration_matches(kind, declared, m)]\n119\t            if not ok:\n120\t                kinds.append(\"MISMATCH\")\n121\t            elif len(ok) != len(served):\n122\t                kinds.append(\"MIXED\")\n123\t            if kind == \"alias\":\n124\t                bucket = alias_resolutions.setdefault(declared, {})\n125\t                for m in served:\n126\t                    shown = _safe_text(m)\n127\t                    bucket[shown] = bucket.get(shown, 0) + 1\n128\t        if is_veto:\n129\t            counts[\"floor_checked\"] += 1\n130\t            if any(m not in veto_allowed for m in served):\n131\t                kinds.append(\"FLOOR_BREACH\")\n132\t        if kinds:\n133\t            rel = os.path.relpath(sc, str(project_dir))\n134\t            violations.append(\n135\t                {\n136\t                    \"label\": _label(side, sc),\n137\t                    \"rail\": \"workflow\" if \"workflows\" in Path(rel).parts else \"native\",\n138\t                    \"archetype\": _safe_text(archetype),\n139\t                    \"declared\": declared if kind in (\"alias\", \"id\") else \"\",\n140\t                    \"kinds\": kinds,\n141\t                    \"served\": dict(\n142\t                        sorted((_safe_text(m), n) for m, n in served.items())\n143\t                    ),\n144\t                    \"sidecar\": _safe_text(rel, 300),\n145\t                }\n146\t            )\n147\t\n148\t    incomplete: List[str] = []\n149\t    for key, text in (\n150\t        (\"unclassified\", \"unclassified declaration(s)\"),\n151\t        (\"unreadable_sidecars\", \"unreadable sidecar(s)\"),\n152\t        (\"refused_paths\", \"path(s) refused (symlink or outside the corpus)\"),\n153\t        (\"incomplete_reads\", \"transcript line(s) torn, undated or unreadable\"),\n154\t        (\"served_unresolved\", \"served turn(s) without a model id\"),\n155\t        (\n156\t            \"chunk_terminal_unprovable\",\n157\t            \"message group(s) whose chunks disagree about the model and whose \"\n158\t            \"terminal chunk cannot be proven (a chunk without usage)\",\n159\t        ),\n160\t    ):\n161\t        if counts[key]:\n162\t            incomplete.append(\"%d %s\" % (counts[key], text))\n163\t    if floor is None:\n164\t        incomplete.append(\"VETO floor source unreadable (floor predicate not evaluated)\")\n165\t\n166\t    comparable = counts[\"compared_spawns\"]\n167\t    if violations:\n168\t        verdict = \"RED\"\n169\t        by_kind: Dict[str, int] = {}\n170\t        for v in violations:\n171\t            for k in v[\"kinds\"]:\n172\t                by_kind[k] = by_kind.get(k, 0) + 1\n173\t        reason = \"%d spawn(s) violate the invariant (%s) of %d compared\" % (\n174\t            len(violations),\n175\t            \", \".join(\"%d %s\" % (n, k) for k, n in sorted(by_kind.items())),\n176\t            comparable,\n177\t        )\n178\t    elif incomplete:\n179\t        verdict = \"INCONCLUSIVE\"\n180\t        reason = \"the check is incomplete: \" + \"; \".join(incomplete)\n181\t    elif comparable == 0:\n182\t        verdict = \"VACUOUS\"\n183\t        reason = (\n184\t            \"nothing was compared: no spawn with a declared model (or VETO \"\n185\t            \"archetype) and a served model in the window\"\n186\t        )\n187\t    else:\n188\t        verdict = \"GREEN\"\n189\t        reason = (\n190\t            \"%d spawn(s) compared: %d declared spawn(s) served == declared, \"\n191\t            \"%d VETO spawn(s) served inside the floor\"\n192\t            % (comparable, counts[\"declared_compared\"], counts[\"floor_checked\"])\n193\t        )\n194\t\n195\t    return {\n196\t        \"verdict\": verdict,\n197\t        \"reason\": reason,\n198\t        \"counts\": counts,\n199\t        \"violations\": violations[:200],\n200\t        \"violations_omitted\": max(0, len(violations) - 200),\n201\t        \"alias_resolutions\": {\n202\t            a: dict(sorted(r.items())) for a, r in sorted(alias_resolutions.items())\n203\t        },\n204\t        \"unclassified_samples\": unclassified_samples,\n205\t        \"floor\": (\n206\t            {\"roles\": sorted(veto_roles), \"allowed\": sorted(veto_allowed)}\n207\t            if floor\n208\t            else None\n209\t        ),\n210\t        \"prereg\": ROUTING_PREREG_POINTER,\n211\t    }\n212\t\n213\t\n214\tdef routing_invariant_safe(\n215\t    project_dir: Any,\n216\t    cutoff: Optional[datetime] = None,\n217\t    until: Optional[datetime] = None,\n218\t) -> Dict[str, Any]:\n219\t    \"\"\"`routing_invariant()` that can never break the cost report AND can\n220\t    never turn its own failure into a pass: an internal error is an\n221\t    INCONCLUSIVE verdict that names the exception class.\"\"\"\n222\t    try:\n223\t        return routing_invariant(project_dir, cutoff=cutoff, until=until)\n224\t    except Exception as exc:  # pragma: no cover - fail-soft envelope\n225\t        return {\n226\t            \"verdict\": \"INCONCLUSIVE\",\n227\t            \"reason\": \"routing check failed: %s\" % type(exc).__name__,\n228\t            \"counts\": {},\n229\t            \"violations\": [],\n230\t            \"violations_omitted\": 0,\n231\t            \"alias_resolutions\": {},\n232\t            \"unclassified_samples\": [],\n233\t            \"floor\": None,\n234\t            \"prereg\": ROUTING_PREREG_POINTER,\n235\t        }\n236\t\n237\t\n238\tdef routing_rc(routing: Dict[str, Any]) -> int:\n239\t    \"\"\"`--assert-routing` exit code for a verdict.\"\"\"\n240\t    verdict = routing.get(\"verdict\")\n241\t    if verdict == \"GREEN\":\n242\t        return ROUTING_RC_GREEN\n243\t    if verdict == \"RED\":\n244\t        return ROUTING_RC_RED\n245\t    return ROUTING_RC_NOT_PROVEN\n246\t\n247\t\n248\tdef _routing_lines(routing: Optional[Dict[str, Any]], limit: int = 20) -> List[str]:\n249\t    \"\"\"The routing verdict as report lines (ASCII), shared by every\n250\t    renderer so the CLI and the two callers' blocks cannot disagree.\"\"\"\n251\t    if not routing:\n252\t        return []\n253\t    c = routing.get(\"counts\") or {}\n254\t    out: List[str] = [\n255\t        \"ROUTING INVARIANT (PLAN-186 AC-13): %s - %s\"\n256\t        % (routing.get(\"verdict\"), routing.get(\"reason\"))\n257\t    ]\n258\t    out.append(\n259\t        \"  sidecars=%d declared=%d undeclared=%d unclassified=%d | compared=%d \"\n260\t        \"(declared=%d floor=%d) | no_served=%d out_of_window=%d \"\n261\t        \"synthetic_turns_ignored=%d chunk_model_splits=%d \"\n262\t        \"chunk_terminal_unprovable=%d\"\n263\t        % (\n264\t            c.get(\"sidecars\", 0),\n265\t            c.get(\"declared\", 0),\n266\t            c.get(\"undeclared\", 0),\n267\t            c.get(\"unclassified\", 0),\n268\t            c.get(\"compared_spawns\", 0),\n269\t            c.get(\"declared_compared\", 0),\n270\t            c.get(\"floor_checked\", 0),\n271\t            c.get(\"no_served\", 0),\n272\t            c.get(\"out_of_window\", 0),\n273\t            c.get(\"synthetic_turns_ignored\", 0),\n274\t            c.get(\"chunk_model_splits\", 0),\n275\t            c.get(\"chunk_terminal_unprovable\", 0),\n276\t        )\n277\t    )\n278\t    viol = routing.get(\"violations\") or []\n279\t    for v in viol[:limit]:\n280\t        out.append(\n281\t            \"  VIOLATION [%s] %s label=%r archetype=%s declared=%s served=%s\"\n282\t            % (\n283\t                \"+\".join(v.get(\"kinds\", [])),\n284\t                v.get(\"rail\"),\n285\t                v.get(\"label\"),\n286\t                v.get(\"archetype\") or \"-\",\n287\t                v.get(\"declared\") or \"-\",\n288\t                \",\".join(\n289\t                    \"%s x%d\" % (m, n) for m, n in sorted((v.get(\"served\") or {}).items())\n290\t                ),\n291\t            )\n292\t        )\n293\t    hidden = max(0, len(viol) - limit) + int(routing.get(\"violations_omitted\") or 0)\n294\t    if hidden:\n295\t        out.append(\"  ... (+%d violation(s) omitted; --json lists them)\" % hidden)\n296\t    res = routing.get(\"alias_resolutions\") or {}\n297\t    if res:\n298\t        out.append(\n299\t            \"  alias -> served (observed, informational, never judged): \"\n300\t            + \"; \".join(\n301\t                \"%s: %s\"\n302\t                % (a, \", \".join(\"%s x%d\" % (m, n) for m, n in sorted(r.items())))\n303\t                for a, r in sorted(res.items())\n304\t            )\n305\t        )\n306\t    return out\n307\t\n308\t\n309\t# ---------------------------------------------------------------------------\n310\t# Programmatic API (PLAN-186 W0, AC-1b)\n311\t# ---------------------------------------------------------------------------\n312\t#\n313\t# `ceo-cost.py` and `budget-summary.py` consume THIS surface, never the\n314\t# CLI's stdout. Everything below the `transcript_rollup` line exists so\n315\t# the two callers share one root resolver, one collector and one\n316\t# renderer — a second grafia of any of them is the exact shape of the\n317\t# D1-D4 defect class (CLAUDE.md §5).\n318\t\n319\t#: Env override for the transcripts corpus root. Flag > env > the shared\n320\t#: `_lib.runtime_paths` resolver. Tests MUST set this (or pass the flag):\n321\t#: nothing here may read the real ~/.claude/projects/<slug> corpus.\n322\t"}]},"parent_tool_use_id":null,"session_id":"383b699d-3190-4c1b-a4de-9afabb13d7c6","uuid":"845aa529-2003-49df-98da-26abf41d805b","timestamp":"2026-11-13T18:25:42.341Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_cost_transcripts_parts/routing.py","content":"\"\"\"Extracted cost-transcripts implementation: routing.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport glob\nimport json\nimport os\nimport re\nimport sys\nimport time\nfrom dataclasses import dataclass, field\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\ndef routing_invariant(\n    project_dir: Any,\n    cutoff: Optional[datetime] = None,\n    until: Optional[datetime] = None,\n) -> Dict[str, Any]:\n    \"\"\"Assert, over the spawn sidecars + transcripts under `project_dir`,\n    that served == declared and that VETO archetypes were served inside the\n    floor. Pure read; returns the verdict as JSON-safe data.\"\"\"\n    project_dir = Path(project_dir)\n    root_real = os.path.realpath(str(project_dir))\n    floor = _floor_source()\n    families = known_families(floor)\n    veto_roles = floor[0] if floor else frozenset()\n    veto_allowed = floor[1] if floor else frozenset()\n\n    counts: Dict[str, int] = {\n        \"sidecars\": 0,\n        \"declared\": 0,\n        \"undeclared\": 0,\n        \"unclassified\": 0,\n        \"compared_spawns\": 0,\n        \"declared_compared\": 0,\n        \"floor_checked\": 0,\n        \"no_served\": 0,\n        \"out_of_window\": 0,\n        \"unreadable_sidecars\": 0,\n        \"refused_paths\": 0,\n        \"incomplete_reads\": 0,\n        \"served_unresolved\": 0,\n        \"synthetic_turns_ignored\": 0,\n        \"chunk_model_splits\": 0,\n        \"chunk_terminal_unprovable\": 0,\n    }\n    violations: List[Dict[str, Any]] = []\n    alias_resolutions: Dict[str, Dict[str, int]] = {}\n    unclassified_samples: List[str] = []\n\n    def gates_the_window(transcript: str) -> bool:\n        \"\"\"A sidecar the check cannot trust (unreadable, refused, or a\n        declaration it cannot classify) may gate THIS window only if its\n        spawn has a turn in it. A stale one from outside the window is\n        counted where it belongs and never reaches the verdict.\"\"\"\n        if not os.path.exists(transcript):\n            counts[\"no_served\"] += 1\n            return False\n        if not _inside(transcript, root_real):\n            return True\n        where = _placement(transcript, project_dir, cutoff, until)\n        if where == \"out\":\n            counts[\"out_of_window\"] += 1\n            return False\n        if where == \"none\":\n            counts[\"no_served\"] += 1\n            return False\n        return True\n\n    for sc in _discover_sidecars(project_dir):\n        counts[\"sidecars\"] += 1\n        transcript = sc[: -len(\".meta.json\")] + \".jsonl\"\n        sidecar_inside = _inside(sc, root_real)\n        side = _read_sidecar(sc) if sidecar_inside else None\n        if side is None:\n            if gates_the_window(transcript):\n                counts[\"unreadable_sidecars\" if sidecar_inside else \"refused_paths\"] += 1\n            continue\n        kind, declared = classify_declared(side.get(\"model\"), families)\n        archetype = _archetype(side)\n        is_veto = archetype in veto_roles\n        if kind == \"none\":\n            counts[\"undeclared\"] += 1\n        elif kind == \"unclassified\":\n            if not gates_the_window(transcript):\n                continue\n            counts[\"unclassified\"] += 1\n            if len(unclassified_samples) < 5:\n                unclassified_samples.append(_safe_text(declared, 40))\n        else:\n            counts[\"declared\"] += 1\n        needs_served = kind in (\"alias\", \"id\") or is_veto\n        if not needs_served:\n            continue\n\n        if not os.path.exists(transcript):\n            counts[\"no_served\"] += 1\n            continue\n        if not _inside(transcript, root_real):\n            counts[\"refused_paths\"] += 1\n            continue\n        served = _served_models(transcript, project_dir, cutoff, until, counts)\n        if served is None:\n            counts[\"out_of_window\"] += 1\n            continue\n        if not served:\n            counts[\"no_served\"] += 1\n            continue\n\n        # ONE count per spawn that reached a comparison, whatever number of\n        # predicates it fed (a declared VETO spawn feeds both).\n        counts[\"compared_spawns\"] += 1\n        kinds: List[str] = []\n        if kind in (\"alias\", \"id\"):\n            counts[\"declared_compared\"] += 1\n            ok = [m for m in served if declaration_matches(kind, declared, m)]\n            if not ok:\n                kinds.append(\"MISMATCH\")\n            elif len(ok) != len(served):\n                kinds.append(\"MIXED\")\n            if kind == \"alias\":\n                bucket = alias_resolutions.setdefault(declared, {})\n                for m in served:\n                    shown = _safe_text(m)\n                    bucket[shown] = bucket.get(shown, 0) + 1\n        if is_veto:\n            counts[\"floor_checked\"] += 1\n            if any(m not in veto_allowed for m in served):\n                kinds.append(\"FLOOR_BREACH\")\n        if kinds:\n            rel = os.path.relpath(sc, str(project_dir))\n            violations.append(\n                {\n                    \"label\": _label(side, sc),\n                    \"rail\": \"workflow\" if \"workflows\" in Path(rel).parts else \"native\",\n                    \"archetype\": _safe_text(archetype),\n                    \"declared\": declared if kind in (\"alias\", \"id\") else \"\",\n                    \"kinds\": kinds,\n                    \"served\": dict(\n                        sorted((_safe_text(m), n) for m, n in served.items())\n                    ),\n                    \"sidecar\": _safe_text(rel, 300),\n                }\n            )\n\n    incomplete: List[str] = []\n    for key, text in (\n        (\"unclassified\", \"unclassified declaration(s)\"),\n        (\"unreadable_sidecars\", \"unreadable sidecar(s)\"),\n        (\"refused_paths\", \"path(s) refused (symlink or outside the corpus)\"),\n        (\"incomplete_reads\", \"transcript line(s) torn, undated or unreadable\"),\n        (\"served_unresolved\", \"served turn(s) without a model id\"),\n        (\n            \"chunk_terminal_unprovable\",\n            \"message group(s) whose chunks disagree about the model and whose \"\n            \"terminal chunk cannot be proven (a chunk without usage)\",\n        ),\n    ):\n        if counts[key]:\n            incomplete.append(\"%d %s\" % (counts[key], text))\n    if floor is None:\n        incomplete.append(\"VETO floor source unreadable (floor predicate not evaluated)\")\n\n    comparable = counts[\"compared_spawns\"]\n    if violations:\n        verdict = \"RED\"\n        by_kind: Dict[str, int] = {}\n        for v in violations:\n            for k in v[\"kinds\"]:\n                by_kind[k] = by_kind.get(k, 0) + 1\n        reason = \"%d spawn(s) violate the invariant (%s) of %d compared\" % (\n            len(violations),\n            \", \".join(\"%d %s\" % (n, k) for k, n in sorted(by_kind.items())),\n            comparable,\n        )\n    elif incomplete:\n        verdict = \"INCONCLUSIVE\"\n        reason = \"the check is incomplete: \" + \"; \".join(incomplete)\n    elif comparable == 0:\n        verdict = \"VACUOUS\"\n        reason = (\n            \"nothing was compared: no spawn with a declared model (or VETO \"\n            \"archetype) and a served model in the window\"\n        )\n    else:\n        verdict = \"GREEN\"\n        reason = (\n            \"%d spawn(s) compared: %d declared spawn(s) served == declared, \"\n            \"%d VETO spawn(s) served inside the floor\"\n            % (comparable, counts[\"declared_compared\"], counts[\"floor_checked\"])\n        )\n\n    return {\n        \"verdict\": verdict,\n        \"reason\": reason,\n        \"counts\": counts,\n        \"violations\": violations[:200],\n        \"violations_omitted\": max(0, len(violations) - 200),\n        \"alias_resolutions\": {\n            a: dict(sorted(r.items())) for a, r in sorted(alias_resolutions.items())\n        },\n        \"unclassified_samples\": unclassified_samples,\n        \"floor\": (\n            {\"roles\": sorted(veto_roles), \"allowed\": sorted(veto_allowed)}\n            if floor\n            else None\n        ),\n        \"prereg\": ROUTING_PREREG_POINTER,\n    }\n\n\ndef routing_invariant_safe(\n    project_dir: Any,\n    cutoff: Optional[datetime] = None,\n    until: Optional[datetime] = None,\n) -> Dict[str, Any]:\n    \"\"\"`routing_invariant()` that can never break the cost report AND can\n    never turn its own failure into a pass: an internal error is an\n    INCONCLUSIVE verdict that names the exception class.\"\"\"\n    try:\n        return routing_invariant(project_dir, cutoff=cutoff, until=until)\n    except Exception as exc:  # pragma: no cover - fail-soft envelope\n        return {\n            \"verdict\": \"INCONCLUSIVE\",\n            \"reason\": \"routing check failed: %s\" % type(exc).__name__,\n            \"counts\": {},\n            \"violations\": [],\n            \"violations_omitted\": 0,\n            \"alias_resolutions\": {},\n            \"unclassified_samples\": [],\n            \"floor\": None,\n            \"prereg\": ROUTING_PREREG_POINTER,\n        }\n\n\ndef routing_rc(routing: Dict[str, Any]) -> int:\n    \"\"\"`--assert-routing` exit code for a verdict.\"\"\"\n    verdict = routing.get(\"verdict\")\n    if verdict == \"GREEN\":\n        return ROUTING_RC_GREEN\n    if verdict == \"RED\":\n        return ROUTING_RC_RED\n    return ROUTING_RC_NOT_PROVEN\n\n\ndef _routing_lines(routing: Optional[Dict[str, Any]], limit: int = 20) -> List[str]:\n    \"\"\"The routing verdict as report lines (ASCII), shared by every\n    renderer so the CLI and the two callers' blocks cannot disagree.\"\"\"\n    if not routing:\n        return []\n    c = routing.get(\"counts\") or {}\n    out: List[str] = [\n        \"ROUTING INVARIANT (PLAN-186 AC-13): %s - %s\"\n        % (routing.get(\"verdict\"), routing.get(\"reason\"))\n    ]\n    out.append(\n        \"  sidecars=%d declared=%d undeclared=%d unclassified=%d | compared=%d \"\n        \"(declared=%d floor=%d) | no_served=%d out_of_window=%d \"\n        \"synthetic_turns_ignored=%d chunk_model_splits=%d \"\n        \"chunk_terminal_unprovable=%d\"\n        % (\n            c.get(\"sidecars\", 0),\n            c.get(\"declared\", 0),\n            c.get(\"undeclared\", 0),\n            c.get(\"unclassified\", 0),\n            c.get(\"compared_spawns\", 0),\n            c.get(\"declared_compared\", 0),\n            c.get(\"floor_checked\", 0),\n            c.get(\"no_served\", 0),\n            c.get(\"out_of_window\", 0),\n            c.get(\"synthetic_turns_ignored\", 0),\n            c.get(\"chunk_model_splits\", 0),\n            c.get(\"chunk_terminal_unprovable\", 0),\n        )\n    )\n    viol = routing.get(\"violations\") or []\n    for v in viol[:limit]:\n        out.append(\n            \"  VIOLATION [%s] %s label=%r archetype=%s declared=%s served=%s\"\n            % (\n                \"+\".join(v.get(\"kinds\", [])),\n                v.get(\"rail\"),\n                v.get(\"label\"),\n                v.get(\"archetype\") or \"-\",\n                v.get(\"declared\") or \"-\",\n                \",\".join(\n                    \"%s x%d\" % (m, n) for m, n in sorted((v.get(\"served\") or {}).items())\n                ),\n            )\n        )\n    hidden = max(0, len(viol) - limit) + int(routing.get(\"violations_omitted\") or 0)\n    if hidden:\n        out.append(\"  ... (+%d violation(s) omitted; --json lists them)\" % hidden)\n    res = routing.get(\"alias_resolutions\") or {}\n    if res:\n        out.append(\n            \"  alias -> served (observed, informational, never judged): \"\n            + \"; \".join(\n                \"%s: %s\"\n                % (a, \", \".join(\"%s x%d\" % (m, n) for m, n in sorted(r.items())))\n                for a, r in sorted(res.items())\n            )\n        )\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Programmatic API (PLAN-186 W0, AC-1b)\n# ---------------------------------------------------------------------------\n#\n# `ceo-cost.py` and `budget-summary.py` consume THIS surface, never the\n# CLI's stdout. Everything below the `transcript_rollup` line exists so\n# the two callers share one root resolver, one collector and one\n# renderer — a second grafia of any of them is the exact shape of the\n# D1-D4 defect class (CLAUDE.md §5).\n\n#: Env override for the transcripts corpus root. Flag > env > the shared\n#: `_lib.runtime_paths` resolver. Tests MUST set this (or pass the flag):\n#: nothing here may read the real ~/.claude/projects/<slug> corpus.\n","numLines":322,"startLine":1,"totalLines":322}},"tool_result_meta":[{"id":"toolu_01TWPMYiqTk3KVmHnFbRh4rD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
