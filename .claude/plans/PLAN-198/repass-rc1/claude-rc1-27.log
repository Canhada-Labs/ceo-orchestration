exists():\n82\t        return \"yellow\", \"validate-governance missing\", None\n83\t    try:\n84\t        proc = subprocess.run(\n85\t            [\"bash\", str(script), \"--fast\", \"--json\"],\n86\t            capture_output=True, text=True, timeout=1.8, cwd=str(REPO_ROOT),\n87\t        )\n88\t    except subprocess.TimeoutExpired:\n89\t        return \"red\", \"validate timeout (fast)\", None\n90\t    rc = proc.returncode\n91\t    try:\n92\t        payload = json.loads(proc.stdout) if proc.stdout else {}\n93\t    except (json.JSONDecodeError, ValueError):\n94\t        payload = {}\n95\t    errors = payload.get(\"errors\", []) if isinstance(payload, dict) else []\n96\t    warnings = payload.get(\"warnings\", []) if isinstance(payload, dict) else []\n97\t    n_err = len(errors) if isinstance(errors, list) else 0\n98\t    n_warn = len(warnings) if isinstance(warnings, list) else 0\n99\t    # rc != 0 is the red truth (Codex 6th-option catch).\n100\t    if rc != 0:\n101\t        status = \"red\"\n102\t        summary = f\"fast fail: {n_err} error(s)\"\n103\t    elif n_warn:\n104\t        status = \"yellow\"\n105\t        summary = f\"fast pass, {n_warn} warn(s)\"\n106\t    else:\n107\t        status = \"green\"\n108\t        summary = \"fast pass\"\n109\t    return status, summary, {\"rc\": rc, \"errors\": n_err, \"warnings\": n_warn, \"profile\": \"fast\"}\n110\t\n111\t# Declarations live beside the reusable hook library so the installer carries\n112\t# them recursively. They execute in this facade dictionary: private symbols,\n113\t# mutable state, and monkeypatch seams retain their historical identity.\n114\tfrom _lib._ceo_boot_parts import install as _install_ceo_boot_parts  # noqa: E402\n115\t\n116\t_install_ceo_boot_parts(globals())\n117\tdel _install_ceo_boot_parts\n118\t\n119\t\n120\tdef check_tier_a_spec_version_drift() -> Tuple[str, str, Any]:\n121\t    \"\"\"VERSION major vs latest SPEC/v* major agreement — red on drift.\n122\t\n123\t    Lesson validation r