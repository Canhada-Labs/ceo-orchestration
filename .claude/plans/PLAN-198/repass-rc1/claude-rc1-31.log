o not \"\n446\t                    \"re-pin it\".format(version))\n447\t        cmds.append(\"python3 .claude/hooks/check_pair_rail.py --verify-codex-pin\")\n448\t        return cmds\n449\t    in_repo = (repo / \".claude\" / \"scripts\" / \"re-pin-codex.py\").is_file()\n450\t    tool, err = _load_repin_tool()\n451\t    mold: Optional[Dict[str, Any]] = None\n452\t    existing = _existing_pack_for(tool, repo, version) if tool is not None else None\n453\t    stale = _stale_pack_reason(tool, repo, existing) if existing is not None else None\n454\t    if existing is not None and stale is not None:\n455\t        # C-R2M-07: its ceremony would die at its own drift guard (\"remonte o\n456\t        # pack\"), and the generator refuses a second pack for the version.\n457\t        cmds.append(\"the existing pack {} for {} is STALE: {} — its ceremony dies at its \"\n458\t                    \"drift guard; remove {} and run this check again for the generator \"\n459\t                    \"command (re-pin-codex.py refuses a second pack for the same \"\n460\t                    \"version)\".format(posixpath.dirname(existing), version, stale,\n461\t                                      posixpath.dirname(existing)))\n462\t    elif existing is not None:\n463\t        # A pack that already pins this version is signed and applied, never\n464\t        # regenerated (C-R1-CL-08): the generator would refuse a second pack\n465\t        # for the same version, and cloning by hand would duplicate it.\n466\t        cmds.append(\"apply the existing pack {}: its codex-cli-pin-manifest.json.new already \"\n467\t                    \"pins {} — Owner ceremony: bash {} --dry-run, then the same without \"\n468\t                    \"--dry-run (ADR-182); do not generate another pack\".format(\n469\t                        posixpath.dirname(existing), version, existing))\n470\t    elif tool is None:\n471\t        cmds.append(\"re-pin {} via the ADR-182 pin ceremony (the mold check is unavailable: \"\n