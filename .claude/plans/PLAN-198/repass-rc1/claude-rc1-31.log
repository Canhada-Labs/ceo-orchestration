{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4eSvg9xyFLFiU3eMVSt","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DPcrs6VSQ5zXZczqwdhV6R","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_night_mode_parts/helpers.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":13612,"cache_read_input_tokens":103730,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":13612},"output_tokens":7,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"613e580a-b626-4aa0-966c-6b7a50b955be","uuid":"dda78abf-d339-4870-83b1-39ccceac12cf","timestamp":"2026-11-15T11:37:25.108Z","request_id":"req_011Ch4eSvUVnjWBZKbRPztuF","wire_tool_inputs":{"toolu_01DPcrs6VSQ5zXZczqwdhV6R":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_night_mode_parts/helpers.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DPcrs6VSQ5zXZczqwdhV6R","type":"tool_result","content":"1\t\"\"\"Extracted night-mode helpers declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t__all__ = ('settings_local_path', 'marker_path', 'lock_path', '_import_filelock', '_load_json_fail_closed', '_fsync_dir', '_atomic_write_json', '_read_back_matches', '_refuse_if_ci', '_hostname', '_utc_now_iso', '_marker_age_str', '_bounded_repr', '_LINE_BREAKS', '_ONE_LINE_TABLE', '_one_line', '_invalid_bounded_string', '_validate_marker', '_SUMMARY_TOKEN_SAFE', '_summary_token', '_summary', '_emit_audit', '_seam_widens_to', '_self_path_diagnostic', '_check_self_path', '_validate_root')\n5\t\n6\tdef settings_local_path(root: Path) -> Path:\n7\t    \"\"\"The per-machine, gitignored settings overlay.\"\"\"\n8\t    return root / \".claude\" / \"settings.local.json\"\n9\t\n10\t\n11\tdef marker_path(root: Path) -> Path:\n12\t    \"\"\"Single marker+snapshot file (W0 T0.7: same tree as the settings).\"\"\"\n13\t    return root / \".claude\" / \"state\" / \"night-mode.json\"\n14\t\n15\t\n16\tdef lock_path(root: Path) -> Path:\n17\t    \"\"\"Sibling lock file guarding the whole mutation sequence.\"\"\"\n18\t    return root / \".claude\" / \"state\" / \"night-mode.lock\"\n19\t\n20\t\n21\tdef _import_filelock() -> Any:\n22\t    \"\"\"Import `_lib.filelock` from THIS script's repo (not --project-root).\"\"\"\n23\t    hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n24\t    if hooks_dir not in sys.path:\n25\t        sys.path.insert(0, hooks_dir)\n26\t    from _lib.filelock import FileLock  # noqa: E402\n27\t\n28\t    return FileLock\n29\t\n30\t\n31\t# --------------------------------------------------------------------------- #\n32\t# JSON IO — fail-closed reads, atomic verified writes.\n33\t# --------------------------------------------------------------------------- #\n34\tdef _load_json_fail_closed(path: Path, what: str) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:\n35\t    \"\"\"Load *path* as a JSON object.\n36\t\n37\t    Returns (doc, None) on success, (None, None) when the file is absent,\n38\t    and (None, diagnostic) when the file exists but cannot be parsed as a\n39\t    JSON object — the caller MUST treat that as fail-closed (exit 2, no\n40\t    write). Contract item 6.\n41\t    \"\"\"\n42\t    if not path.exists():\n43\t        return None, None\n44\t    try:\n45\t        raw = path.read_text(encoding=\"utf-8\")\n46\t    except (OSError, UnicodeDecodeError) as exc:\n47\t        return None, f\"{what} at {path} is unreadable ({exc.__class__.__name__}: {exc})\"\n48\t    try:\n49\t        doc = json.loads(raw)\n50\t    except ValueError as exc:\n51\t        return None, (\n52\t            f\"{what} at {path} is not valid JSON ({exc}). \"\n53\t            f\"Refusing to rewrite or 'fix' it (fail-closed on input) — \"\n54\t            f\"repair it by hand, then re-run.\"\n55\t        )\n56\t    if not isinstance(doc, dict):\n57\t        return None, (\n58\t            f\"{what} at {path} parses but is not a JSON object \"\n59\t            f\"(top-level {type(doc).__name__}). Refusing to merge (fail-closed).\"\n60\t        )\n61\t    return doc, None\n62\t\n63\t\n64\tdef _fsync_dir(path: Path) -> None:\n65\t    \"\"\"NM-09 — best-effort parent-directory fsync.\n66\t\n67\t    `os.replace`/`os.unlink` mutate the DIRECTORY; fsyncing only the file\n68\t    fd leaves the rename itself lose-able on power loss (the torn-state\n69\t    class contract item 2 cites, S286). Durability here is best-effort:\n70\t    any failure is swallowed — it must never break the operation.\n71\t    \"\"\"\n72\t    fd = -1\n73\t    try:\n74\t        fd = os.open(str(path), os.O_RDONLY)\n75\t        os.fsync(fd)\n76\t    except OSError:\n77\t        pass\n78\t    finally:\n79\t        if fd >= 0:\n80\t            try:\n81\t                os.close(fd)\n82\t            except OSError:\n83\t                pass\n84\t\n85\t\n86\tdef _atomic_write_json(target: Path, doc: Dict[str, Any]) -> None:\n87\t    \"\"\"Write *doc* atomically: tempfile in the SAME dir, fsync, os.replace.\n88\t\n89\t    Never truncates in place (contract item 2 — a torn settings file makes\n90\t    the harness skip the whole file, the S286 failure class). Preserves the\n91\t    permission bits of a pre-existing target; new files keep mkstemp's 0600.\n92\t    Raises OSError to the caller on failure (nothing partially replaced).\n93\t    \"\"\"\n94\t    target.parent.mkdir(parents=True, exist_ok=True)\n95\t    payload = json.dumps(doc, indent=2, ensure_ascii=False, sort_keys=False) + \"\\n\"\n96\t    prev_mode: Optional[int] = None\n97\t    if target.exists():\n98\t        try:\n99\t            prev_mode = stat.S_IMODE(target.stat().st_mode)\n100\t        except OSError:\n101\t            prev_mode = None\n102\t    fd, tmp_name = tempfile.mkstemp(\n103\t        prefix=target.name + \".\", suffix=\".tmp\", dir=str(target.parent)\n104\t    )\n105\t    try:\n106\t        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n107\t            fh.write(payload)\n108\t            fh.flush()\n109\t            os.fsync(fh.fileno())\n110\t        if prev_mode is not None:\n111\t            os.chmod(tmp_name, prev_mode)\n112\t        os.replace(tmp_name, target)\n113\t        _fsync_dir(target.parent)  # NM-09: make the rename durable\n114\t    except BaseException:\n115\t        try:\n116\t            os.unlink(tmp_name)\n117\t        except OSError:\n118\t            pass\n119\t        raise\n120\t\n121\t\n122\tdef _read_back_matches(target: Path, expected: Dict[str, Any]) -> bool:\n123\t    \"\"\"Contract item 3: reopen + re-parse *target*; True iff it equals\n124\t    *expected* structurally. Any read/parse failure counts as mismatch.\"\"\"\n125\t    try:\n126\t        got = json.loads(target.read_text(encoding=\"utf-8\"))\n127\t    except (OSError, ValueError, UnicodeDecodeError):\n128\t        return False\n129\t    return got == expected\n130\t\n131\t\n132\t# --------------------------------------------------------------------------- #\n133\t# Guards\n134\t# --------------------------------------------------------------------------- #\n135\tdef _refuse_if_ci() -> Optional[int]:\n136\t    \"\"\"PLAN-165 AC-11 — no autonomy toggling in CI / headless runners.\n137\t\n138\t    Fail-closed on PRESENCE of the `CI` env var (even empty): a runner that\n139\t    sets `CI=` is still a runner. Returns exit code 2 when refusing.\n140\t    \"\"\"\n141\t    if \"CI\" in os.environ:\n142\t        sys.stderr.write(\n143\t            \"night-mode: refusing to toggle autonomy posture — the CI \"\n144\t            \"environment variable is set (PLAN-165 non-goal: no autonomy \"\n145\t            \"on CI/headless runners; AC-11).\\n\"\n146\t        )\n147\t        return 2\n148\t    return None\n149\t\n150\t\n151\tdef _hostname() -> str:\n152\t    try:\n153\t        return socket.gethostname()\n154\t    except OSError:\n155\t        return \"unknown-host\"\n156\t\n157\t\n158\tdef _utc_now_iso() -> str:\n159\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n160\t\n161\t\n162\tdef _marker_age_str(ts: str) -> str:\n163\t    \"\"\"Human age of the marker timestamp; degrades to 'unknown age'.\"\"\"\n164\t    try:\n165\t        then = datetime.strptime(ts, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n166\t    except (ValueError, TypeError):\n167\t        return \"unknown age\"\n168\t    seconds = (datetime.now(timezone.utc) - then).total_seconds()\n169\t    if seconds < 0:\n170\t        return \"clock skew (marker in the future)\"\n171\t    if seconds < 90:\n172\t        return f\"{int(seconds)}s\"\n173\t    if seconds < 5400:\n174\t        return f\"{seconds / 60.0:.0f}m\"\n175\t    return f\"{seconds / 3600.0:.1f}h\"\n176\t\n177\t\n178\tdef _bounded_repr(value: Any, limit: int = 200) -> str:\n179\t    \"\"\"`repr(value)`, truncated to *limit* characters.\n180\t\n181\t    Every echo of a marker field goes through here: the marker is\n182\t    UNTRUSTED input (gitignored, unguarded, agent-writable), so a planted\n183\t    document may carry a megabyte-long string. Diagnostics must be loud\n184\t    about what they rejected AND bounded.\n185\t    \"\"\"\n186\t    try:\n187\t        text = repr(value)\n188\t    except Exception:  # noqa: BLE001 — a diagnostic must never raise\n189\t        return \"<unrepresentable>\"\n190\t    if len(text) > limit:\n191\t        return \"{0}...<truncated {1} chars>\".format(text[:limit], len(text) - limit)\n192\t    return text\n193\t\n194\t\n195\t# Every character Python's own `str.splitlines()` treats as a line boundary,\n196\t# plus TAB. NF-05/NF-06 (round-4): `status` renders a LINE-ORIENTED record\n197\t# (`marker:`, `reconciliation:` …) that the Owner and log parsers read one\n198\t# line at a time, and the marker + overlay it echoes are gitignored,\n199\t# agent-writable documents. A single planted line break forges a whole extra\n200\t# record — including a fake `reconciliation:` verdict that lands BEFORE the\n201\t# true one. The exotic members (VT, FF, FS, GS, RS, NEL, LS, PS) are here\n202\t# because `str.splitlines()` splits on them too: a consumer that splits\n203\t# would see two records even where a raw terminal shows one. Written as\n204\t# ESCAPES on purpose — a literal U+2028 in the source is invisible.\n205\t_LINE_BREAKS = \"\\n\\r\\v\\f\\x1c\\x1d\\x1e\\x85\\u2028\\u2029\\t\"\n206\t_ONE_LINE_TABLE = {ord(ch): \" \" for ch in _LINE_BREAKS}\n207\t\n208\t\n209\tdef _one_line(text: Any) -> str:\n210\t    \"\"\"Collapse every line-boundary character (and TAB) to a single space.\n211\t\n212\t    Applied to whole rendered lines, so no field a future edit echoes into\n213\t    `status` can forge an extra record even if that echo forgets\n214\t    `_bounded_repr` (NF-06 defense in depth — the class, not the instance).\n215\t    \"\"\"\n216\t    if not isinstance(text, str):\n217\t        text = str(text)\n218\t    return text.translate(_ONE_LINE_TABLE)\n219\t\n220\t\n221\tdef _invalid_bounded_string(value: Any, field: str, limit: int) -> Optional[str]:\n222\t    \"\"\"Diagnostic if *value* is not a bounded, control-char-free string.\n223\t\n224\t    NF-06 (round-4): `ts` and `hostname` were the two marker fields\n225\t    `_validate_marker` never looked at, and `status` printed both RAW. A\n226\t    planted `hostname` therefore injected arbitrary lines into the status\n227\t    report — including a forged `reconciliation:` verdict rendered ABOVE the\n228\t    real one. Both fields are Owner-facing decoration; a control character\n229\t    in either is evidence of tampering, so it fails CLOSED like every other\n230\t    field of the document.\n231\t    \"\"\"\n232\t    if not isinstance(value, str):\n233\t        return \"field {0!r} is {1}, expected a JSON string\".format(\n234\t            field, _bounded_repr(value)\n235\t        )\n236\t    if not value:\n237\t        return \"field {0!r} is an empty string\".format(field)\n238\t    if len(value) > limit:\n239\t        return \"field {0!r} is {1} chars long, over the {2}-char bound\".format(\n240\t            field, len(value), limit\n241\t        )\n242\t    bad = [ch for ch in value if ch in _LINE_BREAKS or ord(ch) < 0x20 or ord(ch) == 0x7F]\n243\t    if bad:\n244\t        return (\n245\t            \"field {0!r} contains control character(s) {1} — a marker field \"\n246\t            \"night-mode wrote can never carry one, and this field is echoed \"\n247\t            \"on a line-oriented surface (NF-06)\".format(\n248\t                field, _bounded_repr(\"\".join(sorted(set(bad))))\n249\t            )\n250\t        )\n251\t    return None\n252\t\n253\t\n254\t# --------------------------------------------------------------------------- #\n255\t# NF-03 — whole-document marker validation (fail-CLOSED on input).\n256\t# --------------------------------------------------------------------------- #\n257\tdef _validate_marker(doc: Any) -> Optional[str]:\n258\t    \"\"\"Validate the marker as a WHOLE DOCUMENT; None means healthy.\n259\t\n260\t    Returns a diagnostic naming the offending field otherwise. The caller\n261\t    MUST treat any diagnostic as fail-CLOSED (exit 2, marker left in place,\n262\t    nothing acted on) — contract item 6.\n263\t\n264\t    Round-2 validated `prev_value` ALONE. Every other field\n265\t    (`prev_present`, `created_file`, `mode_written`, `version`) was still\n266\t    trusted from the same untrusted document, and that was exploitable\n267\t    (NF-03): a planted `created_file=true` + `prev_present=false` made\n268\t    `off` `os.unlink` an overlay night-mode did NOT create — silent data\n269\t    loss on an exit-0 `result=applied` path. Per-field validation alone is\n270\t    still not enough: the CONSISTENCY rule (`created_file=True` implies\n271\t    `prev_present=False` — night-mode creates the overlay only when there\n272\t    was no overlay, hence no prior value) is what makes the unlink branch\n273\t    safe to reach at all.\n274\t    \"\"\"\n275\t    if not isinstance(doc, dict):\n276\t        return \"marker is not a JSON object (top-level {0})\".format(\n277\t            type(doc).__name__\n278\t        )\n279\t\n280\t    version = doc.get(\"version\")\n281\t    # `isinstance(version, bool)` first: in Python `True == 1`, so a planted\n282\t    # `\"version\": true` would otherwise pass an `== MARKER_VERSION` check.\n283\t    if isinstance(version, bool) or version != MARKER_VERSION:\n284\t        return (\n285\t            \"field 'version' is {0}, expected {1!r} — this marker was not \"\n286\t            \"written by this build of night-mode\".format(\n287\t                _bounded_repr(version), MARKER_VERSION\n288\t            )\n289\t        )\n290\t\n291\t    mode_written = doc.get(\"mode_written\")\n292\t    if mode_written != NIGHT_MODE:\n293\t        return (\n294\t            \"field 'mode_written' is {0}, expected {1!r} — night-mode only \"\n295\t            \"ever writes {1!r}\".format(_bounded_repr(mode_written), NIGHT_MODE)\n296\t        )\n297\t\n298\t    for field in (\"prev_present\", \"created_file\"):\n299\t        if field not in doc:\n300\t            return \"field {0!r} is missing\".format(field)\n301\t        if not isinstance(doc[field], bool):\n302\t            return \"field {0!r} is {1}, expected a JSON boolean\".format(\n303\t                field, _bounded_repr(doc[field])\n304\t            )\n305\t\n306\t    prev_present = doc[\"prev_present\"]\n307\t    prev_value = doc.get(\"prev_value\")\n308\t    if prev_present:\n309\t        if not (isinstance(prev_value, str) and prev_value in _RESTORABLE_MODES):\n310\t            return (\n311\t                \"field 'prev_value' is {0}, which is not a string in the \"\n312\t                \"closed set of restorable modes {1} (derived from the harness \"\n313\t                \"--permission-mode enum minus 'bypassPermissions' and {2!r}; \"\n314\t                \"NM-01 / NF-01 / NF-02)\".format(\n315\t                    _bounded_repr(prev_value),\n316\t                    sorted(_RESTORABLE_MODES),\n317\t                    NIGHT_MODE,\n318\t                )\n319\t            )\n320\t    elif prev_value is not None:\n321\t        return (\n322\t            \"field 'prev_value' is {0} while 'prev_present' is false — a \"\n323\t            \"healthy marker records prev_value=null when there was no prior \"\n324\t            \"override\".format(_bounded_repr(prev_value))\n325\t        )\n326\t\n327\t    if doc[\"created_file\"] and prev_present:\n328\t        return (\n329\t            \"fields 'created_file'=true and 'prev_present'=true are mutually \"\n330\t            \"inconsistent — night-mode creates the overlay only when there \"\n331\t            \"was no overlay, hence no prior value. Honoring this pair would \"\n332\t            \"unlink a file night-mode did not create (NF-03)\"\n333\t        )\n334\t\n335\t    # NF-06 (round-4): `ts` and `hostname` completed the WHOLE-document\n336\t    # promise this helper's name makes. Round-3 checked neither — they are\n337\t    # \"only decoration\", but decoration is exactly what `status` PRINTS, and\n338\t    # `status` renders a line-oriented report. A planted `hostname` forged\n339\t    # arbitrary lines there, including a fake `reconciliation:` verdict\n340\t    # rendered ABOVE the true one. Bounds: `ts` is night-mode's own\n341\t    # `%Y-%m-%dT%H:%M:%SZ` (20 chars; 32 leaves room for a future\n342\t    # fractional-seconds format), `hostname` the DNS maximum of 253.\n343\t    for field, limit in ((\"ts\", 32), (\"hostname\", 253)):\n344\t        if field not in doc:\n345\t            return \"field {0!r} is missing\".format(field)\n346\t        bad = _invalid_bounded_string(doc[field], field, limit)\n347\t        if bad is not None:\n348\t            return bad\n349\t    return None\n350\t\n351\t\n352\t# --------------------------------------------------------------------------- #\n353\t# Observability — NM-05: one machine-readable line on EVERY terminating path.\n354\t# --------------------------------------------------------------------------- #\n355\t_SUMMARY_TOKEN_SAFE = frozenset(\n356\t    \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-\"\n357\t)\n358\t\n359\t\n360\tdef _summary_token(value: Any, limit: int = 32) -> str:\n361\t    \"\"\"Coerce *value* into ONE safe token for the key=value summary line.\n362\t\n363\t    Some summary values originate in the untrusted marker. A planted\n364\t    `prev_value` carrying a space would forge an extra field in the\n365\t    machine-readable record, and one carrying a newline would forge an\n366\t    extra LINE. Unsafe characters collapse to '_'; the result is bounded\n367\t    and never empty.\n368\t    \"\"\"\n369\t    text = value if isinstance(value, str) else str(value)\n370\t    text = \"\".join(ch if ch in _SUMMARY_TOKEN_SAFE else \"_\" for ch in text)\n371\t    if not text:\n372\t        return \"none\"\n373\t    return text[:limit]\n374\t\n375\t\n376\tdef _summary(mode: str, previous_mode: str, result: str) -> None:\n377\t    \"\"\"Print the NM-05 one-line summary (stdout, stable key=value shape).\n378\t\n379\t    `result` is one of: applied | noop | refused | failed. Use 'none' for\n380\t    a value that is unknown or not applicable on that path. This is the\n381\t    OPERATOR-facing record; its forensic sibling is `_emit_audit` below,\n382\t    and the two are written as a PAIR on every terminating path (the `ast`\n383\t    oracle in the test suite pins the pair — NF-04/NF-07).\n384\t\n385\t    Every value is passed through `_summary_token` — the record must stay\n386\t    one parseable line even when a value came from the untrusted marker.\n387\t    \"\"\"\n388\t    print(\n389\t        \"night-mode-event mode={0} previous_mode={1} result={2}\".format(\n390\t            _summary_token(mode), _summary_token(previous_mode),\n391\t            _summary_token(result),\n392\t        )\n393\t    )\n394\t\n395\t\n396\t# --------------------------------------------------------------------------- #\n397\t# Audit — NF-07: the forensic `night_mode_toggled` row, one per terminating\n398\t# path, written as the sibling of every `_summary` call.\n399\t# --------------------------------------------------------------------------- #\n400\tdef _emit_audit(mode: str, previous_mode: str, result: str) -> None:\n401\t    \"\"\"Best-effort night_mode_toggled emit (P2, NM-05). NEVER raises,\n402\t    NEVER blocks the toggle.\n403\t\n404\t    Only the P2-allowlisted fields travel: mode, previous_mode, result,\n405\t    hostname_hash (= sha256(hostname)[:12]). Never a file path, never\n406\t    file content, never the raw hostname. Pass \"other\" explicitly when a\n407\t    value is unknown at the terminating path — the typed wrapper coerces\n408\t    any off-enum value to \"other\" anyway (never echoed).\n409\t\n410\t    Why this exists (NF-07, round-3 review): the overlay is written by a\n411\t    PROCESS, not by a tool, so no PostToolUse observer covers it. Without\n412\t    this row the highest-forensic-value event PLAN-165 produces — a\n413\t    posture flip that outlives the session — leaves nothing on the\n414\t    HMAC-chained log, and AC-7 is falsifiable. The action is registered\n415\t    (`_KNOWN_ACTIONS`, typed wrapper, scrub branch, SPEC row) by the\n416\t    `610d9ec` sentinel ceremony; this call is the other half of that\n417\t    ceremony's atomicity contract (registration commit, then this emit in\n418\t    the W1-land commit — never an unregistered emit at any HEAD).\n419\t\n420\t    Fail-open by construction: `_lib.audit_emit` is imported INSIDE the\n421\t    try, so a missing/broken hooks tree degrades to \"no forensic row\",\n422\t    never to a failed toggle. Repo doctrine is fail-closed on INPUT and\n423\t    fail-open on INFRASTRUCTURE — an audit sink is infrastructure.\n424\t    \"\"\"\n425\t    try:\n426\t        hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n427\t        if hooks_dir not in sys.path:\n428\t            sys.path.insert(0, hooks_dir)\n429\t        from _lib import audit_emit  # noqa: E402\n430\t\n431\t        audit_emit.emit_night_mode_toggled(\n432\t            mode=mode,\n433\t            previous_mode=previous_mode,\n434\t            result=result,\n435\t            hostname_hash=hashlib.sha256(\n436\t                _hostname().encode(\"utf-8\")\n437\t            ).hexdigest()[:12],\n438\t        )\n439\t    except Exception:  # noqa: BLE001 — observability must never block\n440\t        pass\n441\t\n442\t\n443\tdef _seam_widens_to(root: Path) -> bool:\n444\t    \"\"\"NM-04 hardening (S290 review, the S284 'TEST_MODE-is-a-bypass'\n445\t    class): the test seam is NO LONGER a general confinement bypass.\n446\t\n447\t    Even with `CEO_NIGHT_MODE_TEST_SEAM` set, the widened target must\n448\t    resolve UNDER the system temp directory — which is all the test\n449\t    suite ever needs (every test root is an isolated tmp tree). A seam\n450\t    that reopened arbitrary-path writes (\"arm acceptEdits in ANY repo on\n451\t    the machine\") was the exact primitive NM-04 exists to remove; a\n452\t    tmp-tree write escalates nothing (a tmp repo's sessions belong to\n453\t    whoever created it).\n454\t    \"\"\"\n455\t    if not os.environ.get(_TEST_SEAM_ENV):\n456\t        return False\n457\t    try:\n458\t        tmp = Path(tempfile.gettempdir()).resolve()\n459\t        resolved = root.resolve()\n460\t    except OSError:\n461\t        return False\n462\t    return resolved == tmp or tmp in resolved.parents\n463\t\n464\t\n465\tdef _self_path_diagnostic(anchored: Path, real: Path) -> Optional[str]:\n466\t    \"\"\"NF-08b — refuse to run as anything but the canonical toggle.\n467\t\n468\t    PURE (no filesystem access): both paths arrive already resolved, so the\n469\t    comparison is testable without a real installation — the S285 shape, a\n470\t    fail-closed validator must be drivable outside the thing it validates.\n471\t\n472\t    ``real``     the file that will actually execute, symlinks resolved.\n473\t    ``anchored`` the path it was INVOKED as, with ancestors resolved but the\n474\t                 FINAL component left alone.\n475\t\n476\t    Two refusals, one per member of the class the S292 r2 review opened:\n477\t\n478\t    1. ``real`` is not at ``<its repo>/.claude/scripts/night-mode.py`` — a\n479\t       RENAMED or RELOCATED copy. Measured: `cp night-mode.py\n480\t       .claude/scripts/nm2.py && python3 .claude/scripts/nm2.py on` armed the\n481\t       posture, because `REPO_ROOT` is derived positionally (`parents[2]`)\n482\t       and a copy two levels deep lands on the real repo root. No rule about\n483\t       `ln` would have caught this one.\n484\t\n485\t    2. ``anchored != real`` — the final component is a LINK, i.e. an ALIAS.\n486\t       Measured: `ln -s <repo>/.claude/scripts/night-mode.py /tmp/nm &&\n487\t       python3 /tmp/nm on` printed `result=applied` and wrote the overlay,\n488\t       because `Path(__file__).resolve()` follows the link back home while\n489\t       the command line names nothing a matcher can recognise.\n490\t\n491\t    Why the ancestors are resolved SEPARATELY: `/tmp` is a symlink to\n492\t    `/private/tmp` on this platform, and plenty of operators keep repos under\n493\t    a symlinked directory. Comparing raw `__file__` against the resolved form\n494\t    would lock every one of them out of their own toggle — a fail-closed gate\n495\t    landing on the useless side. Only the FINAL component being a link is an\n496\t    alias; an ancestor link is just a path spelling.\n497\t    \"\"\"\n498\t    try:\n499\t        expected = real.parents[2].joinpath(*_CANONICAL_SELF_PARTS)\n500\t    except IndexError:\n501\t        # Fewer than three ancestors — cannot be an installed layout at all.\n502\t        return (\n503\t            f\"this script is running from {real} , which is too shallow to be \"\n504\t            \"an installed project layout; refusing (NF-08b).\"\n505\t        )\n506\t    canonical = \"/\".join(_CANONICAL_SELF_PARTS)\n507\t    if real != expected:\n508\t        return (\n509\t            f\"this script is running as {real} , which is not \"\n510\t            f\"{canonical} of the repository it resolves into ({expected}); \"\n511\t            \"refusing (NF-08b). A renamed or relocated copy of the posture \"\n512\t            \"toggle still writes the REAL repository's overlay, so it is a \"\n513\t            \"second entry point around the OQ1-redo boundary. Run the \"\n514\t            f\"canonical file instead: `! python3 {canonical} on|off|status`.\"\n515\t        )\n516\t    if anchored != real:\n517\t        return (\n518\t            f\"this script was invoked as {anchored} , an ALIAS of \"\n519\t            f\"{real} ; refusing (NF-08b). Arming or disarming the autonomy \"\n520\t            \"posture is a HUMAN action (PLAN-165 OQ1-redo, Owner-ratified \"\n521\t            \"2026-08-03), and a link is a second entry point that arms it \"\n522\t            \"without ever naming the guarded path. Run the canonical file \"\n523\t            f\"instead: `! python3 {canonical} on|off|status`.\"\n524\t        )\n525\t    return None\n526\t\n527\t\n528\tdef _check_self_path() -> Optional[str]:\n529\t    \"\"\"Resolve THIS script's own paths, then apply `_self_path_diagnostic`.\n530\t\n531\t    Fail-CLOSED on a resolution error: a symlink loop raises `RuntimeError`\n532\t    on some platforms and `OSError` on others, and a guard that cannot\n533\t    determine what it is running as must refuse, not shrug. (The S277 pair\n534\t    rail found exactly this class — an uncaught symlink-loop `RuntimeError`\n535\t    — fail-OPEN in an earlier draft of a different guard in this repo.)\n536\t    \"\"\"\n537\t    try:\n538\t        real = _INVOKED_SELF.resolve()\n539\t        anchored = _INVOKED_SELF.parent.resolve() / _INVOKED_SELF.name\n540\t    except (OSError, RuntimeError) as exc:\n541\t        return (\n542\t            \"cannot resolve this script's own path \"\n543\t            f\"({exc.__class__.__name__}: {exc}); refusing (NF-08b).\"\n544\t        )\n545\t    return _self_path_diagnostic(anchored, real)\n546\t\n547\t\n548\tdef _validate_root(root: Path) -> Optional[str]:\n549\t    \"\"\"NM-04 — confine --project-root; returns a diagnostic or None.\n550\t\n551\t    Unconfined, `--project-root` is an arbitrary-path posture-write\n552\t    primitive: any Bash-capable agent could arm `acceptEdits` in ANY repo\n553\t    on the machine, including targets without the P1 deny rule. Reject\n554\t    (fail-closed) any target that is not this repository's root or under\n555\t    it. The test seam (`CEO_NIGHT_MODE_TEST_SEAM`) widens the confinement\n556\t    ONLY to targets under the system temp directory (`_seam_widens_to`)\n557\t    — never to arbitrary paths. In ALL cases the target must already look\n558\t    like an installed project (`.claude/settings.json` present) —\n559\t    night-mode never bootstraps a posture into a bare tree.\n560\t    \"\"\"\n561\t    if root != REPO_ROOT and REPO_ROOT not in root.parents:\n562\t        if not _seam_widens_to(root):\n563\t            return (\n564\t                f\"--project-root {root} is outside this repository \"\n565\t                f\"({REPO_ROOT}); refusing (NM-04 confinement — the toggle \"\n566\t                f\"only manages THIS repo's overlay). {_TEST_SEAM_ENV} widens \"\n567\t                \"confinement only to isolated trees under the system temp \"\n568\t                \"directory, never to arbitrary paths.\"\n569\t            )\n570\t    if not (root / \".claude\" / \"settings.json\").is_file():\n571\t        return (\n572\t            f\"target {root} does not contain .claude/settings.json — not an \"\n573\t            \"installed project; refusing to write a posture overlay there \"\n574\t            \"(NM-04).\"\n575\t        )\n576\t    return None\n577\t\n578\t\n579\t# --------------------------------------------------------------------------- #\n580\t# on\n581\t# --------------------------------------------------------------------------- #\n582\t"}]},"parent_tool_use_id":null,"session_id":"613e580a-b626-4aa0-966c-6b7a50b955be","uuid":"63cd8d7f-5a6e-4af6-be40-4d22c9469e30","timestamp":"2026-11-15T11:37:25.346Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_night_mode_parts/helpers.py","content":"\"\"\"Extracted night-mode helpers declarations.\"\"\"\nfrom __future__ import annotations\n\n__all__ = ('settings_local_path', 'marker_path', 'lock_path', '_import_filelock', '_load_json_fail_closed', '_fsync_dir', '_atomic_write_json', '_read_back_matches', '_refuse_if_ci', '_hostname', '_utc_now_iso', '_marker_age_str', '_bounded_repr', '_LINE_BREAKS', '_ONE_LINE_TABLE', '_one_line', '_invalid_bounded_string', '_validate_marker', '_SUMMARY_TOKEN_SAFE', '_summary_token', '_summary', '_emit_audit', '_seam_widens_to', '_self_path_diagnostic', '_check_self_path', '_validate_root')\n\ndef settings_local_path(root: Path) -> Path:\n    \"\"\"The per-machine, gitignored settings overlay.\"\"\"\n    return root / \".claude\" / \"settings.local.json\"\n\n\ndef marker_path(root: Path) -> Path:\n    \"\"\"Single marker+snapshot file (W0 T0.7: same tree as the settings).\"\"\"\n    return root / \".claude\" / \"state\" / \"night-mode.json\"\n\n\ndef lock_path(root: Path) -> Path:\n    \"\"\"Sibling lock file guarding the whole mutation sequence.\"\"\"\n    return root / \".claude\" / \"state\" / \"night-mode.lock\"\n\n\ndef _import_filelock() -> Any:\n    \"\"\"Import `_lib.filelock` from THIS script's repo (not --project-root).\"\"\"\n    hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n    if hooks_dir not in sys.path:\n        sys.path.insert(0, hooks_dir)\n    from _lib.filelock import FileLock  # noqa: E402\n\n    return FileLock\n\n\n# --------------------------------------------------------------------------- #\n# JSON IO — fail-closed reads, atomic verified writes.\n# --------------------------------------------------------------------------- #\ndef _load_json_fail_closed(path: Path, what: str) -> Tuple[Optional[Dict[str, Any]], Optional[str]]:\n    \"\"\"Load *path* as a JSON object.\n\n    Returns (doc, None) on success, (None, None) when the file is absent,\n    and (None, diagnostic) when the file exists but cannot be parsed as a\n    JSON object — the caller MUST treat that as fail-closed (exit 2, no\n    write). Contract item 6.\n    \"\"\"\n    if not path.exists():\n        return None, None\n    try:\n        raw = path.read_text(encoding=\"utf-8\")\n    except (OSError, UnicodeDecodeError) as exc:\n        return None, f\"{what} at {path} is unreadable ({exc.__class__.__name__}: {exc})\"\n    try:\n        doc = json.loads(raw)\n    except ValueError as exc:\n        return None, (\n            f\"{what} at {path} is not valid JSON ({exc}). \"\n            f\"Refusing to rewrite or 'fix' it (fail-closed on input) — \"\n            f\"repair it by hand, then re-run.\"\n        )\n    if not isinstance(doc, dict):\n        return None, (\n            f\"{what} at {path} parses but is not a JSON object \"\n            f\"(top-level {type(doc).__name__}). Refusing to merge (fail-closed).\"\n        )\n    return doc, None\n\n\ndef _fsync_dir(path: Path) -> None:\n    \"\"\"NM-09 — best-effort parent-directory fsync.\n\n    `os.replace`/`os.unlink` mutate the DIRECTORY; fsyncing only the file\n    fd leaves the rename itself lose-able on power loss (the torn-state\n    class contract item 2 cites, S286). Durability here is best-effort:\n    any failure is swallowed — it must never break the operation.\n    \"\"\"\n    fd = -1\n    try:\n        fd = os.open(str(path), os.O_RDONLY)\n        os.fsync(fd)\n    except OSError:\n        pass\n    finally:\n        if fd >= 0:\n            try:\n                os.close(fd)\n            except OSError:\n                pass\n\n\ndef _atomic_write_json(target: Path, doc: Dict[str, Any]) -> None:\n    \"\"\"Write *doc* atomically: tempfile in the SAME dir, fsync, os.replace.\n\n    Never truncates in place (contract item 2 — a torn settings file makes\n    the harness skip the whole file, the S286 failure class). Preserves the\n    permission bits of a pre-existing target; new files keep mkstemp's 0600.\n    Raises OSError to the caller on failure (nothing partially replaced).\n    \"\"\"\n    target.parent.mkdir(parents=True, exist_ok=True)\n    payload = json.dumps(doc, indent=2, ensure_ascii=False, sort_keys=False) + \"\\n\"\n    prev_mode: Optional[int] = None\n    if target.exists():\n        try:\n            prev_mode = stat.S_IMODE(target.stat().st_mode)\n        except OSError:\n            prev_mode = None\n    fd, tmp_name = tempfile.mkstemp(\n        prefix=target.name + \".\", suffix=\".tmp\", dir=str(target.parent)\n    )\n    try:\n        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n            fh.write(payload)\n            fh.flush()\n            os.fsync(fh.fileno())\n        if prev_mode is not None:\n            os.chmod(tmp_name, prev_mode)\n        os.replace(tmp_name, target)\n        _fsync_dir(target.parent)  # NM-09: make the rename durable\n    except BaseException:\n        try:\n            os.unlink(tmp_name)\n        except OSError:\n            pass\n        raise\n\n\ndef _read_back_matches(target: Path, expected: Dict[str, Any]) -> bool:\n    \"\"\"Contract item 3: reopen + re-parse *target*; True iff it equals\n    *expected* structurally. Any read/parse failure counts as mismatch.\"\"\"\n    try:\n        got = json.loads(target.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError, UnicodeDecodeError):\n        return False\n    return got == expected\n\n\n# --------------------------------------------------------------------------- #\n# Guards\n# --------------------------------------------------------------------------- #\ndef _refuse_if_ci() -> Optional[int]:\n    \"\"\"PLAN-165 AC-11 — no autonomy toggling in CI / headless runners.\n\n    Fail-closed on PRESENCE of the `CI` env var (even empty): a runner that\n    sets `CI=` is still a runner. Returns exit code 2 when refusing.\n    \"\"\"\n    if \"CI\" in os.environ:\n        sys.stderr.write(\n            \"night-mode: refusing to toggle autonomy posture — the CI \"\n            \"environment variable is set (PLAN-165 non-goal: no autonomy \"\n            \"on CI/headless runners; AC-11).\\n\"\n        )\n        return 2\n    return None\n\n\ndef _hostname() -> str:\n    try:\n        return socket.gethostname()\n    except OSError:\n        return \"unknown-host\"\n\n\ndef _utc_now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef _marker_age_str(ts: str) -> str:\n    \"\"\"Human age of the marker timestamp; degrades to 'unknown age'.\"\"\"\n    try:\n        then = datetime.strptime(ts, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except (ValueError, TypeError):\n        return \"unknown age\"\n    seconds = (datetime.now(timezone.utc) - then).total_seconds()\n    if seconds < 0:\n        return \"clock skew (marker in the future)\"\n    if seconds < 90:\n        return f\"{int(seconds)}s\"\n    if seconds < 5400:\n        return f\"{seconds / 60.0:.0f}m\"\n    return f\"{seconds / 3600.0:.1f}h\"\n\n\ndef _bounded_repr(value: Any, limit: int = 200) -> str:\n    \"\"\"`repr(value)`, truncated to *limit* characters.\n\n    Every echo of a marker field goes through here: the marker is\n    UNTRUSTED input (gitignored, unguarded, agent-writable), so a planted\n    document may carry a megabyte-long string. Diagnostics must be loud\n    about what they rejected AND bounded.\n    \"\"\"\n    try:\n        text = repr(value)\n    except Exception:  # noqa: BLE001 — a diagnostic must never raise\n        return \"<unrepresentable>\"\n    if len(text) > limit:\n        return \"{0}...<truncated {1} chars>\".format(text[:limit], len(text) - limit)\n    return text\n\n\n# Every character Python's own `str.splitlines()` treats as a line boundary,\n# plus TAB. NF-05/NF-06 (round-4): `status` renders a LINE-ORIENTED record\n# (`marker:`, `reconciliation:` …) that the Owner and log parsers read one\n# line at a time, and the marker + overlay it echoes are gitignored,\n# agent-writable documents. A single planted line break forges a whole extra\n# record — including a fake `reconciliation:` verdict that lands BEFORE the\n# true one. The exotic members (VT, FF, FS, GS, RS, NEL, LS, PS) are here\n# because `str.splitlines()` splits on them too: a consumer that splits\n# would see two records even where a raw terminal shows one. Written as\n# ESCAPES on purpose — a literal U+2028 in the source is invisible.\n_LINE_BREAKS = \"\\n\\r\\v\\f\\x1c\\x1d\\x1e\\x85\\u2028\\u2029\\t\"\n_ONE_LINE_TABLE = {ord(ch): \" \" for ch in _LINE_BREAKS}\n\n\ndef _one_line(text: Any) -> str:\n    \"\"\"Collapse every line-boundary character (and TAB) to a single space.\n\n    Applied to whole rendered lines, so no field a future edit echoes into\n    `status` can forge an extra record even if that echo forgets\n    `_bounded_repr` (NF-06 defense in depth — the class, not the instance).\n    \"\"\"\n    if not isinstance(text, str):\n        text = str(text)\n    return text.translate(_ONE_LINE_TABLE)\n\n\ndef _invalid_bounded_string(value: Any, field: str, limit: int) -> Optional[str]:\n    \"\"\"Diagnostic if *value* is not a bounded, control-char-free string.\n\n    NF-06 (round-4): `ts` and `hostname` were the two marker fields\n    `_validate_marker` never looked at, and `status` printed both RAW. A\n    planted `hostname` therefore injected arbitrary lines into the status\n    report — including a forged `reconciliation:` verdict rendered ABOVE the\n    real one. Both fields are Owner-facing decoration; a control character\n    in either is evidence of tampering, so it fails CLOSED like every other\n    field of the document.\n    \"\"\"\n    if not isinstance(value, str):\n        return \"field {0!r} is {1}, expected a JSON string\".format(\n            field, _bounded_repr(value)\n        )\n    if not value:\n        return \"field {0!r} is an empty string\".format(field)\n    if len(value) > limit:\n        return \"field {0!r} is {1} chars long, over the {2}-char bound\".format(\n            field, len(value), limit\n        )\n    bad = [ch for ch in value if ch in _LINE_BREAKS or ord(ch) < 0x20 or ord(ch) == 0x7F]\n    if bad:\n        return (\n            \"field {0!r} contains control character(s) {1} — a marker field \"\n            \"night-mode wrote can never carry one, and this field is echoed \"\n            \"on a line-oriented surface (NF-06)\".format(\n                field, _bounded_repr(\"\".join(sorted(set(bad))))\n            )\n        )\n    return None\n\n\n# --------------------------------------------------------------------------- #\n# NF-03 — whole-document marker validation (fail-CLOSED on input).\n# --------------------------------------------------------------------------- #\ndef _validate_marker(doc: Any) -> Optional[str]:\n    \"\"\"Validate the marker as a WHOLE DOCUMENT; None means healthy.\n\n    Returns a diagnostic naming the offending field otherwise. The caller\n    MUST treat any diagnostic as fail-CLOSED (exit 2, marker left in place,\n    nothing acted on) — contract item 6.\n\n    Round-2 validated `prev_value` ALONE. Every other field\n    (`prev_present`, `created_file`, `mode_written`, `version`) was still\n    trusted from the same untrusted document, and that was exploitable\n    (NF-03): a planted `created_file=true` + `prev_present=false` made\n    `off` `os.unlink` an overlay night-mode did NOT create — silent data\n    loss on an exit-0 `result=applied` path. Per-field validation alone is\n    still not enough: the CONSISTENCY rule (`created_file=True` implies\n    `prev_present=False` — night-mode creates the overlay only when there\n    was no overlay, hence no prior value) is what makes the unlink branch\n    safe to reach at all.\n    \"\"\"\n    if not isinstance(doc, dict):\n        return \"marker is not a JSON object (top-level {0})\".format(\n            type(doc).__name__\n        )\n\n    version = doc.get(\"version\")\n    # `isinstance(version, bool)` first: in Python `True == 1`, so a planted\n    # `\"version\": true` would otherwise pass an `== MARKER_VERSION` check.\n    if isinstance(version, bool) or version != MARKER_VERSION:\n        return (\n            \"field 'version' is {0}, expected {1!r} — this marker was not \"\n            \"written by this build of night-mode\".format(\n                _bounded_repr(version), MARKER_VERSION\n            )\n        )\n\n    mode_written = doc.get(\"mode_written\")\n    if mode_written != NIGHT_MODE:\n        return (\n            \"field 'mode_written' is {0}, expected {1!r} — night-mode only \"\n            \"ever writes {1!r}\".format(_bounded_repr(mode_written), NIGHT_MODE)\n        )\n\n    for field in (\"prev_present\", \"created_file\"):\n        if field not in doc:\n            return \"field {0!r} is missing\".format(field)\n        if not isinstance(doc[field], bool):\n            return \"field {0!r} is {1}, expected a JSON boolean\".format(\n                field, _bounded_repr(doc[field])\n            )\n\n    prev_present = doc[\"prev_present\"]\n    prev_value = doc.get(\"prev_value\")\n    if prev_present:\n        if not (isinstance(prev_value, str) and prev_value in _RESTORABLE_MODES):\n            return (\n                \"field 'prev_value' is {0}, which is not a string in the \"\n                \"closed set of restorable modes {1} (derived from the harness \"\n                \"--permission-mode enum minus 'bypassPermissions' and {2!r}; \"\n                \"NM-01 / NF-01 / NF-02)\".format(\n                    _bounded_repr(prev_value),\n                    sorted(_RESTORABLE_MODES),\n                    NIGHT_MODE,\n                )\n            )\n    elif prev_value is not None:\n        return (\n            \"field 'prev_value' is {0} while 'prev_present' is false — a \"\n            \"healthy marker records prev_value=null when there was no prior \"\n            \"override\".format(_bounded_repr(prev_value))\n        )\n\n    if doc[\"created_file\"] and prev_present:\n        return (\n            \"fields 'created_file'=true and 'prev_present'=true are mutually \"\n            \"inconsistent — night-mode creates the overlay only when there \"\n            \"was no overlay, hence no prior value. Honoring this pair would \"\n            \"unlink a file night-mode did not create (NF-03)\"\n        )\n\n    # NF-06 (round-4): `ts` and `hostname` completed the WHOLE-document\n    # promise this helper's name makes. Round-3 checked neither — they are\n    # \"only decoration\", but decoration is exactly what `status` PRINTS, and\n    # `status` renders a line-oriented report. A planted `hostname` forged\n    # arbitrary lines there, including a fake `reconciliation:` verdict\n    # rendered ABOVE the true one. Bounds: `ts` is night-mode's own\n    # `%Y-%m-%dT%H:%M:%SZ` (20 chars; 32 leaves room for a future\n    # fractional-seconds format), `hostname` the DNS maximum of 253.\n    for field, limit in ((\"ts\", 32), (\"hostname\", 253)):\n        if field not in doc:\n            return \"field {0!r} is missing\".format(field)\n        bad = _invalid_bounded_string(doc[field], field, limit)\n        if bad is not None:\n            return bad\n    return None\n\n\n# --------------------------------------------------------------------------- #\n# Observability — NM-05: one machine-readable line on EVERY terminating path.\n# --------------------------------------------------------------------------- #\n_SUMMARY_TOKEN_SAFE = frozenset(\n    \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.:-\"\n)\n\n\ndef _summary_token(value: Any, limit: int = 32) -> str:\n    \"\"\"Coerce *value* into ONE safe token for the key=value summary line.\n\n    Some summary values originate in the untrusted marker. A planted\n    `prev_value` carrying a space would forge an extra field in the\n    machine-readable record, and one carrying a newline would forge an\n    extra LINE. Unsafe characters collapse to '_'; the result is bounded\n    and never empty.\n    \"\"\"\n    text = value if isinstance(value, str) else str(value)\n    text = \"\".join(ch if ch in _SUMMARY_TOKEN_SAFE else \"_\" for ch in text)\n    if not text:\n        return \"none\"\n    return text[:limit]\n\n\ndef _summary(mode: str, previous_mode: str, result: str) -> None:\n    \"\"\"Print the NM-05 one-line summary (stdout, stable key=value shape).\n\n    `result` is one of: applied | noop | refused | failed. Use 'none' for\n    a value that is unknown or not applicable on that path. This is the\n    OPERATOR-facing record; its forensic sibling is `_emit_audit` below,\n    and the two are written as a PAIR on every terminating path (the `ast`\n    oracle in the test suite pins the pair — NF-04/NF-07).\n\n    Every value is passed through `_summary_token` — the record must stay\n    one parseable line even when a value came from the untrusted marker.\n    \"\"\"\n    print(\n        \"night-mode-event mode={0} previous_mode={1} result={2}\".format(\n            _summary_token(mode), _summary_token(previous_mode),\n            _summary_token(result),\n        )\n    )\n\n\n# --------------------------------------------------------------------------- #\n# Audit — NF-07: the forensic `night_mode_toggled` row, one per terminating\n# path, written as the sibling of every `_summary` call.\n# --------------------------------------------------------------------------- #\ndef _emit_audit(mode: str, previous_mode: str, result: str) -> None:\n    \"\"\"Best-effort night_mode_toggled emit (P2, NM-05). NEVER raises,\n    NEVER blocks the toggle.\n\n    Only the P2-allowlisted fields travel: mode, previous_mode, result,\n    hostname_hash (= sha256(hostname)[:12]). Never a file path, never\n    file content, never the raw hostname. Pass \"other\" explicitly when a\n    value is unknown at the terminating path — the typed wrapper coerces\n    any off-enum value to \"other\" anyway (never echoed).\n\n    Why this exists (NF-07, round-3 review): the overlay is written by a\n    PROCESS, not by a tool, so no PostToolUse observer covers it. Without\n    this row the highest-forensic-value event PLAN-165 produces — a\n    posture flip that outlives the session — leaves nothing on the\n    HMAC-chained log, and AC-7 is falsifiable. The action is registered\n    (`_KNOWN_ACTIONS`, typed wrapper, scrub branch, SPEC row) by the\n    `610d9ec` sentinel ceremony; this call is the other half of that\n    ceremony's atomicity contract (registration commit, then this emit in\n    the W1-land commit — never an unregistered emit at any HEAD).\n\n    Fail-open by construction: `_lib.audit_emit` is imported INSIDE the\n    try, so a missing/broken hooks tree degrades to \"no forensic row\",\n    never to a failed toggle. Repo doctrine is fail-closed on INPUT and\n    fail-open on INFRASTRUCTURE — an audit sink is infrastructure.\n    \"\"\"\n    try:\n        hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n        if hooks_dir not in sys.path:\n            sys.path.insert(0, hooks_dir)\n        from _lib import audit_emit  # noqa: E402\n\n        audit_emit.emit_night_mode_toggled(\n            mode=mode,\n            previous_mode=previous_mode,\n            result=result,\n            hostname_hash=hashlib.sha256(\n                _hostname().encode(\"utf-8\")\n            ).hexdigest()[:12],\n        )\n    except Exception:  # noqa: BLE001 — observability must never block\n        pass\n\n\ndef _seam_widens_to(root: Path) -> bool:\n    \"\"\"NM-04 hardening (S290 review, the S284 'TEST_MODE-is-a-bypass'\n    class): the test seam is NO LONGER a general confinement bypass.\n\n    Even with `CEO_NIGHT_MODE_TEST_SEAM` set, the widened target must\n    resolve UNDER the system temp directory — which is all the test\n    suite ever needs (every test root is an isolated tmp tree). A seam\n    that reopened arbitrary-path writes (\"arm acceptEdits in ANY repo on\n    the machine\") was the exact primitive NM-04 exists to remove; a\n    tmp-tree write escalates nothing (a tmp repo's sessions belong to\n    whoever created it).\n    \"\"\"\n    if not os.environ.get(_TEST_SEAM_ENV):\n        return False\n    try:\n        tmp = Path(tempfile.gettempdir()).resolve()\n        resolved = root.resolve()\n    except OSError:\n        return False\n    return resolved == tmp or tmp in resolved.parents\n\n\ndef _self_path_diagnostic(anchored: Path, real: Path) -> Optional[str]:\n    \"\"\"NF-08b — refuse to run as anything but the canonical toggle.\n\n    PURE (no filesystem access): both paths arrive already resolved, so the\n    comparison is testable without a real installation — the S285 shape, a\n    fail-closed validator must be drivable outside the thing it validates.\n\n    ``real``     the file that will actually execute, symlinks resolved.\n    ``anchored`` the path it was INVOKED as, with ancestors resolved but the\n                 FINAL component left alone.\n\n    Two refusals, one per member of the class the S292 r2 review opened:\n\n    1. ``real`` is not at ``<its repo>/.claude/scripts/night-mode.py`` — a\n       RENAMED or RELOCATED copy. Measured: `cp night-mode.py\n       .claude/scripts/nm2.py && python3 .claude/scripts/nm2.py on` armed the\n       posture, because `REPO_ROOT` is derived positionally (`parents[2]`)\n       and a copy two levels deep lands on the real repo root. No rule about\n       `ln` would have caught this one.\n\n    2. ``anchored != real`` — the final component is a LINK, i.e. an ALIAS.\n       Measured: `ln -s <repo>/.claude/scripts/night-mode.py /tmp/nm &&\n       python3 /tmp/nm on` printed `result=applied` and wrote the overlay,\n       because `Path(__file__).resolve()` follows the link back home while\n       the command line names nothing a matcher can recognise.\n\n    Why the ancestors are resolved SEPARATELY: `/tmp` is a symlink to\n    `/private/tmp` on this platform, and plenty of operators keep repos under\n    a symlinked directory. Comparing raw `__file__` against the resolved form\n    would lock every one of them out of their own toggle — a fail-closed gate\n    landing on the useless side. Only the FINAL component being a link is an\n    alias; an ancestor link is just a path spelling.\n    \"\"\"\n    try:\n        expected = real.parents[2].joinpath(*_CANONICAL_SELF_PARTS)\n    except IndexError:\n        # Fewer than three ancestors — cannot be an installed layout at all.\n        return (\n            f\"this script is running from {real} , which is too shallow to be \"\n            \"an installed project layout; refusing (NF-08b).\"\n        )\n    canonical = \"/\".join(_CANONICAL_SELF_PARTS)\n    if real != expected:\n        return (\n            f\"this script is running as {real} , which is not \"\n            f\"{canonical} of the repository it resolves into ({expected}); \"\n            \"refusing (NF-08b). A renamed or relocated copy of the posture \"\n            \"toggle still writes the REAL repository's overlay, so it is a \"\n            \"second entry point around the OQ1-redo boundary. Run the \"\n            f\"canonical file instead: `! python3 {canonical} on|off|status`.\"\n        )\n    if anchored != real:\n        return (\n            f\"this script was invoked as {anchored} , an ALIAS of \"\n            f\"{real} ; refusing (NF-08b). Arming or disarming the autonomy \"\n            \"posture is a HUMAN action (PLAN-165 OQ1-redo, Owner-ratified \"\n            \"2026-08-03), and a link is a second entry point that arms it \"\n            \"without ever naming the guarded path. Run the canonical file \"\n            f\"instead: `! python3 {canonical} on|off|status`.\"\n        )\n    return None\n\n\ndef _check_self_path() -> Optional[str]:\n    \"\"\"Resolve THIS script's own paths, then apply `_self_path_diagnostic`.\n\n    Fail-CLOSED on a resolution error: a symlink loop raises `RuntimeError`\n    on some platforms and `OSError` on others, and a guard that cannot\n    determine what it is running as must refuse, not shrug. (The S277 pair\n    rail found exactly this class — an uncaught symlink-loop `RuntimeError`\n    — fail-OPEN in an earlier draft of a different guard in this repo.)\n    \"\"\"\n    try:\n        real = _INVOKED_SELF.resolve()\n        anchored = _INVOKED_SELF.parent.resolve() / _INVOKED_SELF.name\n    except (OSError, RuntimeError) as exc:\n        return (\n            \"cannot resolve this script's own path \"\n            f\"({exc.__class__.__name__}: {exc}); refusing (NF-08b).\"\n        )\n    return _self_path_diagnostic(anchored, real)\n\n\ndef _validate_root(root: Path) -> Optional[str]:\n    \"\"\"NM-04 — confine --project-root; returns a diagnostic or None.\n\n    Unconfined, `--project-root` is an arbitrary-path posture-write\n    primitive: any Bash-capable agent could arm `acceptEdits` in ANY repo\n    on the machine, including targets without the P1 deny rule. Reject\n    (fail-closed) any target that is not this repository's root or under\n    it. The test seam (`CEO_NIGHT_MODE_TEST_SEAM`) widens the confinement\n    ONLY to targets under the system temp directory (`_seam_widens_to`)\n    — never to arbitrary paths. In ALL cases the target must already look\n    like an installed project (`.claude/settings.json` present) —\n    night-mode never bootstraps a posture into a bare tree.\n    \"\"\"\n    if root != REPO_ROOT and REPO_ROOT not in root.parents:\n        if not _seam_widens_to(root):\n            return (\n                f\"--project-root {root} is outside this repository \"\n                f\"({REPO_ROOT}); refusing (NM-04 confinement — the toggle \"\n                f\"only manages THIS repo's overlay). {_TEST_SEAM_ENV} widens \"\n                \"confinement only to isolated trees under the system temp \"\n                \"directory, never to arbitrary paths.\"\n            )\n    if not (root / \".claude\" / \"settings.json\").is_file():\n        return (\n            f\"target {root} does not contain .claude/settings.json — not an \"\n            \"installed project; refusing to write a posture overlay there \"\n            \"(NM-04).\"\n        )\n    return None\n\n\n# --------------------------------------------------------------------------- #\n# on\n# --------------------------------------------------------------------------- #\n","numLines":582,"startLine":1,"totalLines":582}},"tool_result_meta":[{"id":"toolu_01DPcrs6VSQ5zXZczqwdhV6R","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
