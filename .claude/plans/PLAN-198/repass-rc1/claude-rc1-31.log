{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1RQ5oUHMtsyCDp2nJWF","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017X7oZU8Tz1rBfqEb79x34y","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_night_mode_parts/toggles.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12014,"cache_read_input_tokens":119505,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12014},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"4e0cc364-80e9-432f-8fee-77cee84da142","uuid":"b86552c2-38ef-469b-86c1-1db1adfc5a15","timestamp":"2026-11-13T18:44:23.522Z","request_id":"req_011Ch1RQ5bKrY1UNGR6Wb6Bb","wire_tool_inputs":{"toolu_017X7oZU8Tz1rBfqEb79x34y":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_night_mode_parts/toggles.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017X7oZU8Tz1rBfqEb79x34y","type":"tool_result","content":"1\t\"\"\"Extracted night-mode toggles declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t__all__ = ('cmd_on', 'cmd_off', 'cmd_off_discard_snapshot')\n5\t\n6\tdef cmd_on(root: Path) -> int:\n7\t    refused = _refuse_if_ci()\n8\t    if refused is not None:\n9\t        _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"refused\")\n10\t        _emit_audit(NIGHT_MODE, \"other\", \"refused\")\n11\t        return refused\n12\t\n13\t    FileLock = _import_filelock()\n14\t    with FileLock(str(lock_path(root))):\n15\t        marker_file = marker_path(root)\n16\t        if marker_file.exists():\n17\t            # Contract items 4 + 7: marker is CREATE-ONLY; a second `on`\n18\t            # must not re-snapshot the value night-mode itself wrote.\n19\t            print(\n20\t                \"night-mode: already ON (marker present at \"\n21\t                f\"{marker_file}) — no-op. Run 'status' to reconcile.\"\n22\t            )\n23\t            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"noop\")\n24\t            _emit_audit(NIGHT_MODE, \"other\", \"noop\")\n25\t            return 0\n26\t\n27\t        settings_file = settings_local_path(root)\n28\t        doc, diag = _load_json_fail_closed(settings_file, \"settings.local.json\")\n29\t        if diag is not None:\n30\t            sys.stderr.write(f\"night-mode: {diag}\\n\")\n31\t            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"refused\")\n32\t            _emit_audit(NIGHT_MODE, \"other\", \"refused\")\n33\t            return 2\n34\t        created_file = doc is None\n35\t        if doc is None:\n36\t            doc = {}\n37\t\n38\t        permissions = doc.get(\"permissions\")\n39\t        if permissions is not None and not isinstance(permissions, dict):\n40\t            sys.stderr.write(\n41\t                f\"night-mode: 'permissions' in {settings_file} is not an \"\n42\t                f\"object (got {type(permissions).__name__}); refusing to \"\n43\t                \"merge (fail-closed on input).\\n\"\n44\t            )\n45\t            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"refused\")\n46\t            _emit_audit(NIGHT_MODE, \"other\", \"refused\")\n47\t            return 2\n48\t\n49\t        prev_present = isinstance(permissions, dict) and \"defaultMode\" in permissions\n50\t        prev_value = permissions[\"defaultMode\"] if prev_present else None\n51\t        if prev_present and prev_value == NIGHT_MODE:\n52\t            # NM-02 (round-2 security review): the overlay already carries\n53\t            # night-mode's OWN value while no marker exists — the AC-5\n54\t            # crash/desync end-state (settings armed, marker lost) or a\n55\t            # hand-arm. Snapshotting it would make the weak posture\n56\t            # permanent: `off` would \"restore\" acceptEdits forever.\n57\t            # night-mode NEVER snapshots its own value — normalize to\n58\t            # \"no prior override\" so `off` falls back to the project\n59\t            # layer's ratified posture.\n60\t            sys.stderr.write(\n61\t                \"night-mode: note — desync detected and normalized: the \"\n62\t                f\"local overlay already had defaultMode={NIGHT_MODE!r} with \"\n63\t                \"no marker (crash between writes, or a hand edit). \"\n64\t                \"Recording 'no prior override' so 'off' restores the \"\n65\t                \"project posture instead of re-freezing acceptEdits.\\n\"\n66\t            )\n67\t            prev_present = False\n68\t            prev_value = None\n69\t\n70\t        # NF-02 note: `on` records the overlay's REAL prior value, including\n71\t        # one that `off` will later refuse to restore (a hand-set\n72\t        # `bypassPermissions`, or a mode outside this build's enum).\n73\t        # Snapshotting the truth is correct; deciding RESTORABILITY is\n74\t        # `off`'s closed-set gate, and `off --discard-snapshot` is the\n75\t        # documented exit when that gate refuses. `on` never silently\n76\t        # rewrites what it found.\n77\t\n78\t        # Deep-merge ONLY permissions.defaultMode — every unrelated\n79\t        # top-level key and every unrelated permissions subkey survives.\n80\t        new_doc = copy.deepcopy(doc)\n81\t        new_permissions = dict(new_doc.get(\"permissions\") or {})\n82\t        new_permissions[\"defaultMode\"] = NIGHT_MODE\n83\t        new_doc[\"permissions\"] = new_permissions\n84\t\n85\t        # Ordering (contract item 5): settings FIRST, marker second.\n86\t        try:\n87\t            _atomic_write_json(settings_file, new_doc)\n88\t        except OSError as exc:\n89\t            sys.stderr.write(\n90\t                f\"night-mode: failed to write {settings_file} \"\n91\t                f\"({exc.__class__.__name__}: {exc}); nothing changed.\\n\"\n92\t            )\n93\t            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"failed\")\n94\t            _emit_audit(NIGHT_MODE, \"other\", \"failed\")\n95\t            return 1\n96\t        if not _read_back_matches(settings_file, new_doc):\n97\t            # Contract item 3: verified-write failure — do NOT write the\n98\t            # marker; the operator sees a hard failure, not a torn state.\n99\t            sys.stderr.write(\n100\t                f\"night-mode: read-back of {settings_file} does not match \"\n101\t                \"what was written — settings may be torn; marker NOT \"\n102\t                \"created. Inspect the file before retrying.\\n\"\n103\t            )\n104\t            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"failed\")\n105\t            _emit_audit(NIGHT_MODE, \"other\", \"failed\")\n106\t            return 1\n107\t\n108\t        marker = {\n109\t            \"version\": MARKER_VERSION,\n110\t            \"mode_written\": NIGHT_MODE,\n111\t            \"prev_present\": prev_present,\n112\t            \"prev_value\": prev_value,\n113\t            \"created_file\": created_file,\n114\t            \"ts\": _utc_now_iso(),\n115\t            \"hostname\": _hostname(),\n116\t        }\n117\t        previous = prev_value if prev_present else \"absent\"\n118\t        try:\n119\t            _atomic_write_json(marker_file, marker)\n120\t        except OSError as exc:\n121\t            sys.stderr.write(\n122\t                f\"night-mode: settings written but marker write failed \"\n123\t                f\"({exc.__class__.__name__}: {exc}). Run 'status' — it will \"\n124\t                \"report the disagreement; re-run 'on' after fixing.\\n\"\n125\t            )\n126\t            _summary(mode=NIGHT_MODE, previous_mode=str(previous), result=\"failed\")\n127\t            _emit_audit(NIGHT_MODE, str(previous), \"failed\")\n128\t            return 1\n129\t        if not _read_back_matches(marker_file, marker):\n130\t            sys.stderr.write(\n131\t                f\"night-mode: read-back of {marker_file} does not match; \"\n132\t                \"marker may be torn. Run 'status' to reconcile.\\n\"\n133\t            )\n134\t            _summary(mode=NIGHT_MODE, previous_mode=str(previous), result=\"failed\")\n135\t            _emit_audit(NIGHT_MODE, str(previous), \"failed\")\n136\t            return 1\n137\t\n138\t        print(\n139\t            \"night-mode: ON — next session starts with \"\n140\t            \"permissions.defaultMode={0!r} (local overlay). Previous local \"\n141\t            \"value: {1}. Disarm with: night-mode off\".format(\n142\t                NIGHT_MODE,\n143\t                # NF-05 (round-4): `previous` is the overlay's RAW\n144\t                # defaultMode — untrusted input from a gitignored,\n145\t                # agent-writable document, echoed here on a LINE-ORIENTED\n146\t                # surface. Interpolated bare, a value carrying '\\n' made\n147\t                # ONE `on` invocation emit TWO 'night-mode-event ' rows (the\n148\t                # forged one claiming result=applied), and a 200k-char value\n149\t                # emitted 200k bytes of stdout. `_bounded_repr` escapes the\n150\t                # newline (repr) AND bounds the length — the same treatment\n151\t                # every other untrusted echo in this file already got.\n152\t                _bounded_repr(previous),\n153\t            )\n154\t        )\n155\t        # The two records LAST, as a pair, on every terminating path of\n156\t        # on/off (structural rule, asserted by the `ast` oracle in the test\n157\t        # suite — NF-04/NF-07): operator-facing summary, then the forensic\n158\t        # `night_mode_toggled` row. A path that returns without both leaves\n159\t        # a posture flip only half-witnessed.\n160\t        _summary(mode=NIGHT_MODE, previous_mode=str(previous), result=\"applied\")\n161\t        _emit_audit(NIGHT_MODE, str(previous), \"applied\")\n162\t        return 0\n163\t\n164\t\n165\t# --------------------------------------------------------------------------- #\n166\t# off\n167\t# --------------------------------------------------------------------------- #\n168\tdef cmd_off(root: Path) -> int:\n169\t    refused = _refuse_if_ci()\n170\t    if refused is not None:\n171\t        _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n172\t        _emit_audit(\"other\", \"other\", \"refused\")\n173\t        return refused\n174\t\n175\t    FileLock = _import_filelock()\n176\t    with FileLock(str(lock_path(root))):\n177\t        marker_file = marker_path(root)\n178\t        if not marker_file.exists():\n179\t            # Contract item 7: idempotent no-op.\n180\t            print(\"night-mode: already OFF (no marker) — no-op.\")\n181\t            _summary(mode=\"none\", previous_mode=\"none\", result=\"noop\")\n182\t            _emit_audit(\"other\", \"other\", \"noop\")\n183\t            return 0\n184\t\n185\t        marker, diag = _load_json_fail_closed(marker_file, \"night-mode marker\")\n186\t        if diag is not None or marker is None:\n187\t            sys.stderr.write(\n188\t                f\"night-mode: {diag or 'marker unreadable'}\\n\"\n189\t                \"night-mode: refusing to guess restore state (fail-closed). \"\n190\t                f\"Inspect the marker and the settings overlay by hand. \"\n191\t                f\"{_DISCARD_HINT}\\n\"\n192\t            )\n193\t            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n194\t            _emit_audit(\"other\", \"other\", \"refused\")\n195\t            return 2\n196\t\n197\t        # NF-03: validate the WHOLE document BEFORE any field is acted on.\n198\t        # Round-2 gated only `prev_value`; `prev_present`, `created_file`,\n199\t        # `mode_written` and `version` were still trusted from the same\n200\t        # untrusted document, and the unlink branch below is reachable from\n201\t        # `created_file` alone. One helper, all fields, plus the\n202\t        # created_file/prev_present consistency rule. Fail-CLOSED: the\n203\t        # marker stays in place as evidence and NOTHING is written.\n204\t        invalid = _validate_marker(marker)\n205\t        if invalid is not None:\n206\t            sys.stderr.write(\n207\t                \"night-mode: REFUSING to restore — the marker at \"\n208\t                f\"{marker_file} is not a healthy night-mode marker: \"\n209\t                f\"{invalid}. Whole-document validation is fail-CLOSED \"\n210\t                \"(NM-01 / NF-01 / NF-02 / NF-03): no field of a rejected \"\n211\t                \"marker is acted on, the settings overlay is untouched, and \"\n212\t                f\"the marker is left in place as evidence. {_DISCARD_HINT}\\n\"\n213\t            )\n214\t            # The marker is rejected, so NOTHING in it — mode_written\n215\t            # included — is echoed into the machine-readable record.\n216\t            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n217\t            _emit_audit(\"other\", \"other\", \"refused\")\n218\t            return 2\n219\t\n220\t        # Every field below is now schema-validated: `mode_written` is\n221\t        # NIGHT_MODE, both booleans are real booleans, `prev_value` is\n222\t        # either None or a string in _RESTORABLE_MODES, and\n223\t        # created_file=True implies prev_present=False.\n224\t        prev_present = marker[\"prev_present\"]\n225\t        prev_value = marker.get(\"prev_value\")\n226\t        created_file = marker[\"created_file\"]\n227\t        mode_written = marker.get(\"mode_written\")\n228\t\n229\t        if prev_present and prev_value == NIGHT_MODE:\n230\t            # NF-01, belt and braces. `_RESTORABLE_MODES` already excludes\n231\t            # NIGHT_MODE, so `_validate_marker` rejects this marker above and\n232\t            # this branch is unreachable TODAY. It stays because the failure\n233\t            # it prevents is the worst one in the script: restoring\n234\t            # night-mode's own value re-arms `acceptEdits` in the overlay AND\n235\t            # removes the marker, leaving the posture armed with nothing to\n236\t            # disarm it. If a future change ever loosens the set, the\n237\t            # symmetric normalization — same rule cmd_on applies on the way\n238\t            # in — still turns a self-referential snapshot into \"remove the\n239\t            # override\" instead of \"re-arm forever\". Exercised directly by\n240\t            # the test suite with a loosened set.\n241\t            sys.stderr.write(\n242\t                \"night-mode: note — the snapshot's prev_value is night-mode's \"\n243\t                f\"own {NIGHT_MODE!r}, which a healthy marker can never carry \"\n244\t                \"(cmd_on normalizes it away). Treating it as 'no prior \"\n245\t                \"override' and REMOVING the local override instead of \"\n246\t                \"re-arming the weak posture (NF-01).\\n\"\n247\t            )\n248\t            prev_present = False\n249\t            prev_value = None\n250\t\n251\t        settings_file = settings_local_path(root)\n252\t        doc, diag = _load_json_fail_closed(settings_file, \"settings.local.json\")\n253\t        if diag is not None:\n254\t            sys.stderr.write(\n255\t                f\"night-mode: {diag}\\n\"\n256\t                \"night-mode: marker left in place (restore not performed). \"\n257\t                \"Repair the overlay JSON by hand first — \"\n258\t                \"'off --discard-snapshot' also refuses to rewrite an overlay \"\n259\t                \"it cannot parse.\\n\"\n260\t            )\n261\t            _summary(mode=\"none\", previous_mode=str(mode_written), result=\"refused\")\n262\t            _emit_audit(\"other\", str(mode_written), \"refused\")\n263\t            return 2\n264\t\n265\t        overlay_absent = doc is None\n266\t        if overlay_absent:\n267\t            # Overlay vanished since `on` (hand cleanup). Nothing to restore;\n268\t            # removing the marker completes the off.\n269\t            #\n270\t            # NF-09 (round-3 review): this route writes NOTHING, so it must\n271\t            # not claim it did. It used to fall through to the shared tail\n272\t            # and report \"restored to 'plan' (snapshot)\" with\n273\t            # `result=applied` — a restore that never happened, on both\n274\t            # records. The truth is that the local layer carries no\n275\t            # defaultMode at all and the next session resolves the PROJECT\n276\t            # layer, so `restored` is \"absent\" and the outcome is `noop`.\n277\t            # The stderr warning corrected an attentive human; the\n278\t            # structured record — the thing a parser reads, and after NF-07\n279\t            # the thing that gets HMAC-signed — stayed wrong.\n280\t            sys.stderr.write(\n281\t                f\"night-mode: warning — {settings_file} is gone; nothing to \"\n282\t                \"restore. Removing marker.\\n\"\n283\t            )\n284\t        else:\n285\t            permissions = doc.get(\"permissions\")\n286\t            if permissions is not None and not isinstance(permissions, dict):\n287\t                sys.stderr.write(\n288\t                    f\"night-mode: 'permissions' in {settings_file} is not an \"\n289\t                    \"object; refusing to restore (fail-closed). Marker left \"\n290\t                    \"in place. Repair the overlay by hand first — \"\n291\t                    \"'off --discard-snapshot' also refuses a 'permissions' \"\n292\t                    \"value it cannot merge.\\n\"\n293\t                )\n294\t                _summary(\n295\t                    mode=\"none\", previous_mode=str(mode_written), result=\"refused\"\n296\t                )\n297\t                _emit_audit(\"other\", str(mode_written), \"refused\")\n298\t                return 2\n299\t\n300\t            current = (permissions or {}).get(\"defaultMode\")\n301\t            if current != mode_written:\n302\t                sys.stderr.write(\n303\t                    \"night-mode: warning — current local defaultMode \"\n304\t                    f\"({current!r}) differs from what night-mode wrote \"\n305\t                    f\"({mode_written!r}); restoring the snapshot anyway.\\n\"\n306\t                )\n307\t\n308\t            new_doc = copy.deepcopy(doc)\n309\t            new_permissions = dict(new_doc.get(\"permissions\") or {})\n310\t            if prev_present:\n311\t                new_permissions[\"defaultMode\"] = prev_value\n312\t            else:\n313\t                new_permissions.pop(\"defaultMode\", None)\n314\t            if new_permissions:\n315\t                new_doc[\"permissions\"] = new_permissions\n316\t            else:\n317\t                # Drop an empty permissions {} rather than leaving litter.\n318\t                new_doc.pop(\"permissions\", None)\n319\t\n320\t            # Ordering (contract item 5, inverse): settings FIRST,\n321\t            # marker removal second.\n322\t            night_mode_own_doc = {\"permissions\": {\"defaultMode\": mode_written}}\n323\t            if created_file and not new_doc and doc == night_mode_own_doc:\n324\t                # `on` created the file and nothing else ever landed in it:\n325\t                # restoring means removing it entirely. Reachable ONLY after\n326\t                # `_validate_marker` proved created_file is a real boolean\n327\t                # AND that created_file=True implies prev_present=False\n328\t                # (NF-03) — an unvalidated `created_file` made this branch\n329\t                # unlink an overlay night-mode never created.\n330\t                #\n331\t                # NF-03 residual, bounded here: no marker field can prove\n332\t                # the file did not pre-exist (that fact lives ONLY in the\n333\t                # marker), so the destructive branch additionally requires\n334\t                # the overlay's CURRENT content to be, in full, exactly what\n335\t                # `on` writes when it creates the file. A forged\n336\t                # `created_file` can therefore only ever delete a document\n337\t                # night-mode itself would have written byte-for-byte;\n338\t                # anything the Owner actually put in the overlay takes the\n339\t                # non-destructive rewrite branch below instead.\n340\t                try:\n341\t                    os.unlink(settings_file)\n342\t                except OSError as exc:\n343\t                    sys.stderr.write(\n344\t                        f\"night-mode: failed to remove {settings_file} \"\n345\t                        f\"({exc.__class__.__name__}: {exc}); marker left in \"\n346\t                        \"place.\\n\"\n347\t                    )\n348\t                    _summary(\n349\t                        mode=\"none\",\n350\t                        previous_mode=str(mode_written),\n351\t                        result=\"failed\",\n352\t                    )\n353\t                    _emit_audit(\"other\", str(mode_written), \"failed\")\n354\t                    return 1\n355\t                _fsync_dir(settings_file.parent)  # NM-09: durable unlink\n356\t            else:\n357\t                try:\n358\t                    _atomic_write_json(settings_file, new_doc)\n359\t                except OSError as exc:\n360\t                    sys.stderr.write(\n361\t                        f\"night-mode: failed to write {settings_file} \"\n362\t                        f\"({exc.__class__.__name__}: {exc}); marker left in \"\n363\t                        \"place.\\n\"\n364\t                    )\n365\t                    _summary(\n366\t                        mode=\"none\",\n367\t                        previous_mode=str(mode_written),\n368\t                        result=\"failed\",\n369\t                    )\n370\t                    _emit_audit(\"other\", str(mode_written), \"failed\")\n371\t                    return 1\n372\t                if not _read_back_matches(settings_file, new_doc):\n373\t                    sys.stderr.write(\n374\t                        f\"night-mode: read-back of {settings_file} does not \"\n375\t                        \"match the restored document — marker left in place \"\n376\t                        \"so 'status' keeps reporting the disagreement.\\n\"\n377\t                    )\n378\t                    _summary(\n379\t                        mode=\"none\",\n380\t                        previous_mode=str(mode_written),\n381\t                        result=\"failed\",\n382\t                    )\n383\t                    _emit_audit(\"other\", str(mode_written), \"failed\")\n384\t                    return 1\n385\t\n386\t        if overlay_absent or not prev_present:\n387\t            # NF-09: \"absent\" on BOTH routes that leave the local layer\n388\t            # without a defaultMode — the snapshot said there was no prior\n389\t            # override, or the overlay holding it had already been removed\n390\t            # by hand. Neither restored a value, so neither may name one.\n391\t            restored = \"absent\"\n392\t        else:\n393\t            restored = prev_value\n394\t        # NF-09: the overlay-gone route writes no settings file at all, so\n395\t        # its outcome is a no-op, not an `applied`. The marker removal that\n396\t        # still happens below is state cleanup, not a posture write.\n397\t        outcome = \"noop\" if overlay_absent else \"applied\"\n398\t        try:\n399\t            os.unlink(marker_file)\n400\t        except OSError as exc:\n401\t            sys.stderr.write(\n402\t                f\"night-mode: settings restored but marker removal failed \"\n403\t                f\"({exc.__class__.__name__}: {exc}); re-run 'off'.\\n\"\n404\t            )\n405\t            _summary(\n406\t                mode=str(restored), previous_mode=str(mode_written), result=\"failed\"\n407\t            )\n408\t            _emit_audit(str(restored), str(mode_written), \"failed\")\n409\t            return 1\n410\t        _fsync_dir(marker_file.parent)  # NM-09: durable unlink\n411\t\n412\t        if overlay_absent:\n413\t            # NF-09: nothing was written on this route. Say that, and say\n414\t            # what governs the next session instead of naming a snapshot\n415\t            # value that was never put anywhere.\n416\t            print(\n417\t                \"night-mode: OFF — nothing to restore: the local overlay \"\n418\t                \"was already gone, so no file was written; the marker is \"\n419\t                \"removed. Next session resolves the project layer's \"\n420\t                \"ratified posture.\"\n421\t            )\n422\t        elif prev_present:\n423\t            # NM-11: name the restored value's relation to the project\n424\t            # layer — a restored local value still OVERRIDES the project\n425\t            # posture; do not claim ratification that did not happen.\n426\t            print(\n427\t                f\"night-mode: OFF — local overlay defaultMode restored to \"\n428\t                f\"{restored!r} (snapshot). Note: that local value still \"\n429\t                \"overrides the project layer's posture for the next session.\"\n430\t            )\n431\t        else:\n432\t            print(\n433\t                \"night-mode: OFF — local overlay defaultMode override \"\n434\t                f\"removed (snapshot: {restored}). Next session resolves the \"\n435\t                \"project layer's ratified posture.\"\n436\t            )\n437\t        # Both records LAST, as a pair (NF-04/NF-07 — see cmd_on).\n438\t        _summary(\n439\t            mode=str(restored), previous_mode=str(mode_written), result=outcome\n440\t        )\n441\t        _emit_audit(str(restored), str(mode_written), outcome)\n442\t        return 0\n443\t\n444\t\n445\t# --------------------------------------------------------------------------- #\n446\t# off --discard-snapshot  (NF-02 recovery)\n447\t# --------------------------------------------------------------------------- #\n448\tdef cmd_off_discard_snapshot(root: Path) -> int:\n449\t    \"\"\"NF-02 — the sanctioned exit from EVERY fail-closed `off` refusal.\n450\t\n451\t    Removes the local `permissions.defaultMode` override AND the marker\n452\t    WITHOUT honoring `prev_value` (or any other marker field), printing\n453\t    exactly what it discarded. Every refusal diagnostic points here: a\n454\t    fail-closed gate must never strand the operator with the posture armed\n455\t    and no way to disarm it short of hand-editing two gitignored files —\n456\t    which is precisely how the round-3 review found the old closed set\n457\t    landing on the PERMISSIVE side (NF-02).\n458\t\n459\t    Deliberate asymmetries with plain `off`:\n460\t\n461\t    - a MISSING marker is NOT a no-op here. The armed-without-marker\n462\t      end-state (crash between the two writes, hand edit, or the NF-01\n463\t      tamper) is exactly what needs recovering, so the override is stripped\n464\t      anyway.\n465\t    - the overlay file is NEVER unlinked, whatever `created_file` claims:\n466\t      discard removes ONE KEY, never a file. It refuses to act on any\n467\t      marker field, so it cannot inherit the NF-03 data-loss path.\n468\t    - a malformed overlay is still fail-CLOSED. Discard rewrites the\n469\t      overlay, and rewriting JSON it cannot parse would destroy the\n470\t      Owner's other settings (contract item 6).\n471\t    \"\"\"\n472\t    refused = _refuse_if_ci()\n473\t    if refused is not None:\n474\t        _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n475\t        _emit_audit(\"other\", \"other\", \"refused\")\n476\t        return refused\n477\t\n478\t    FileLock = _import_filelock()\n479\t    with FileLock(str(lock_path(root))):\n480\t        marker_file = marker_path(root)\n481\t        marker, marker_diag = _load_json_fail_closed(\n482\t            marker_file, \"night-mode marker\"\n483\t        )\n484\t        # Loud, BOUNDED forensic echo — throwing the snapshot away is the\n485\t        # whole point of the flag, so the operator must see what was thrown.\n486\t        if marker is not None:\n487\t            print(\n488\t                \"night-mode: DISCARDING the snapshot at {0} — version={1} \"\n489\t                \"mode_written={2} prev_present={3} prev_value={4} \"\n490\t                \"created_file={5} ts={6} hostname={7}\".format(\n491\t                    marker_file,\n492\t                    _bounded_repr(marker.get(\"version\")),\n493\t                    _bounded_repr(marker.get(\"mode_written\")),\n494\t                    _bounded_repr(marker.get(\"prev_present\")),\n495\t                    _bounded_repr(marker.get(\"prev_value\")),\n496\t                    _bounded_repr(marker.get(\"created_file\")),\n497\t                    _bounded_repr(marker.get(\"ts\")),\n498\t                    _bounded_repr(marker.get(\"hostname\")),\n499\t                )\n500\t            )\n501\t            print(\n502\t                \"night-mode: that prev_value is NOT being restored — the \"\n503\t                \"local defaultMode override is being REMOVED instead.\"\n504\t            )\n505\t        elif marker_diag is not None:\n506\t            print(\n507\t                f\"night-mode: DISCARDING an UNPARSEABLE marker at \"\n508\t                f\"{marker_file} — {marker_diag}\"\n509\t            )\n510\t        else:\n511\t            print(\n512\t                f\"night-mode: no marker at {marker_file} — discarding the \"\n513\t                \"local defaultMode override anyway (armed-without-marker \"\n514\t                \"recovery; plain 'off' is a no-op in this state).\"\n515\t            )\n516\t\n517\t        settings_file = settings_local_path(root)\n518\t        doc, diag = _load_json_fail_closed(settings_file, \"settings.local.json\")\n519\t        if diag is not None:\n520\t            sys.stderr.write(\n521\t                f\"night-mode: {diag}\\n\"\n522\t                \"night-mode: --discard-snapshot still refuses to rewrite an \"\n523\t                \"overlay it cannot parse (fail-closed on input) — repair the \"\n524\t                \"JSON by hand, then re-run. Marker left in place.\\n\"\n525\t            )\n526\t            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n527\t            _emit_audit(\"other\", \"other\", \"refused\")\n528\t            return 2\n529\t\n530\t        removed: Any = \"absent\"\n531\t        if doc is None:\n532\t            sys.stderr.write(\n533\t                f\"night-mode: warning — {settings_file} is absent; there is \"\n534\t                \"no override to strip.\\n\"\n535\t            )\n536\t        else:\n537\t            permissions = doc.get(\"permissions\")\n538\t            if permissions is not None and not isinstance(permissions, dict):\n539\t                sys.stderr.write(\n540\t                    f\"night-mode: 'permissions' in {settings_file} is not an \"\n541\t                    f\"object (got {type(permissions).__name__}); refusing to \"\n542\t                    \"rewrite it (fail-closed). Repair it by hand, then \"\n543\t                    \"re-run. Marker left in place.\\n\"\n544\t                )\n545\t                _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n546\t                _emit_audit(\"other\", \"other\", \"refused\")\n547\t                return 2\n548\t            removed = (permissions or {}).get(\"defaultMode\", \"absent\")\n549\t\n550\t            new_doc = copy.deepcopy(doc)\n551\t            new_permissions = dict(new_doc.get(\"permissions\") or {})\n552\t            new_permissions.pop(\"defaultMode\", None)\n553\t            if new_permissions:\n554\t                new_doc[\"permissions\"] = new_permissions\n555\t            else:\n556\t                new_doc.pop(\"permissions\", None)\n557\t\n558\t            # Ordering (contract item 5): settings FIRST, marker second.\n559\t            try:\n560\t                _atomic_write_json(settings_file, new_doc)\n561\t            except OSError as exc:\n562\t                sys.stderr.write(\n563\t                    f\"night-mode: failed to write {settings_file} \"\n564\t                    f\"({exc.__class__.__name__}: {exc}); marker left in \"\n565\t                    \"place.\\n\"\n566\t                )\n567\t                _summary(mode=\"none\", previous_mode=\"none\", result=\"failed\")\n568\t                _emit_audit(\"other\", \"other\", \"failed\")\n569\t                return 1\n570\t            if not _read_back_matches(settings_file, new_doc):\n571\t                sys.stderr.write(\n572\t                    f\"night-mode: read-back of {settings_file} does not match \"\n573\t                    \"the stripped document — marker left in place so 'status' \"\n574\t                    \"keeps reporting the disagreement.\\n\"\n575\t                )\n576\t                _summary(mode=\"none\", previous_mode=\"none\", result=\"failed\")\n577\t                _emit_audit(\"other\", \"other\", \"failed\")\n578\t                return 1\n579\t\n580\t        if marker_file.exists():\n581\t            try:\n582\t                os.unlink(marker_file)\n583\t            except OSError as exc:\n584\t                sys.stderr.write(\n585\t                    f\"night-mode: override stripped but marker removal failed \"\n586\t                    f\"({exc.__class__.__name__}: {exc}); re-run \"\n587\t                    \"'off --discard-snapshot'.\\n\"\n588\t                )\n589\t                _summary(mode=\"none\", previous_mode=\"none\", result=\"failed\")\n590\t                _emit_audit(\"other\", \"other\", \"failed\")\n591\t                return 1\n592\t            _fsync_dir(marker_file.parent)  # NM-09: durable unlink\n593\t\n594\t        print(\n595\t            \"night-mode: OFF (snapshot DISCARDED) — local overlay \"\n596\t            f\"defaultMode override removed (it was \"\n597\t            f\"{_bounded_repr(removed)}), marker deleted, prev_value NOT \"\n598\t            \"restored. The next session resolves the project layer's \"\n599\t            \"ratified posture.\"\n600\t        )\n601\t        # Both records LAST, as a pair (NF-04/NF-07 — see cmd_on).\n602\t        _summary(mode=\"none\", previous_mode=\"none\", result=\"applied\")\n603\t        _emit_audit(\"other\", \"other\", \"applied\")\n604\t        return 0\n605\t\n606\t\n607\t# --------------------------------------------------------------------------- #\n608\t# status\n609\t# --------------------------------------------------------------------------- #\n610\t"}]},"parent_tool_use_id":null,"session_id":"4e0cc364-80e9-432f-8fee-77cee84da142","uuid":"dc5f3d65-54a4-4da7-a8cb-dbca8c7fe7dc","timestamp":"2026-11-13T18:44:23.783Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_night_mode_parts/toggles.py","content":"\"\"\"Extracted night-mode toggles declarations.\"\"\"\nfrom __future__ import annotations\n\n__all__ = ('cmd_on', 'cmd_off', 'cmd_off_discard_snapshot')\n\ndef cmd_on(root: Path) -> int:\n    refused = _refuse_if_ci()\n    if refused is not None:\n        _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"refused\")\n        _emit_audit(NIGHT_MODE, \"other\", \"refused\")\n        return refused\n\n    FileLock = _import_filelock()\n    with FileLock(str(lock_path(root))):\n        marker_file = marker_path(root)\n        if marker_file.exists():\n            # Contract items 4 + 7: marker is CREATE-ONLY; a second `on`\n            # must not re-snapshot the value night-mode itself wrote.\n            print(\n                \"night-mode: already ON (marker present at \"\n                f\"{marker_file}) — no-op. Run 'status' to reconcile.\"\n            )\n            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"noop\")\n            _emit_audit(NIGHT_MODE, \"other\", \"noop\")\n            return 0\n\n        settings_file = settings_local_path(root)\n        doc, diag = _load_json_fail_closed(settings_file, \"settings.local.json\")\n        if diag is not None:\n            sys.stderr.write(f\"night-mode: {diag}\\n\")\n            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"refused\")\n            _emit_audit(NIGHT_MODE, \"other\", \"refused\")\n            return 2\n        created_file = doc is None\n        if doc is None:\n            doc = {}\n\n        permissions = doc.get(\"permissions\")\n        if permissions is not None and not isinstance(permissions, dict):\n            sys.stderr.write(\n                f\"night-mode: 'permissions' in {settings_file} is not an \"\n                f\"object (got {type(permissions).__name__}); refusing to \"\n                \"merge (fail-closed on input).\\n\"\n            )\n            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"refused\")\n            _emit_audit(NIGHT_MODE, \"other\", \"refused\")\n            return 2\n\n        prev_present = isinstance(permissions, dict) and \"defaultMode\" in permissions\n        prev_value = permissions[\"defaultMode\"] if prev_present else None\n        if prev_present and prev_value == NIGHT_MODE:\n            # NM-02 (round-2 security review): the overlay already carries\n            # night-mode's OWN value while no marker exists — the AC-5\n            # crash/desync end-state (settings armed, marker lost) or a\n            # hand-arm. Snapshotting it would make the weak posture\n            # permanent: `off` would \"restore\" acceptEdits forever.\n            # night-mode NEVER snapshots its own value — normalize to\n            # \"no prior override\" so `off` falls back to the project\n            # layer's ratified posture.\n            sys.stderr.write(\n                \"night-mode: note — desync detected and normalized: the \"\n                f\"local overlay already had defaultMode={NIGHT_MODE!r} with \"\n                \"no marker (crash between writes, or a hand edit). \"\n                \"Recording 'no prior override' so 'off' restores the \"\n                \"project posture instead of re-freezing acceptEdits.\\n\"\n            )\n            prev_present = False\n            prev_value = None\n\n        # NF-02 note: `on` records the overlay's REAL prior value, including\n        # one that `off` will later refuse to restore (a hand-set\n        # `bypassPermissions`, or a mode outside this build's enum).\n        # Snapshotting the truth is correct; deciding RESTORABILITY is\n        # `off`'s closed-set gate, and `off --discard-snapshot` is the\n        # documented exit when that gate refuses. `on` never silently\n        # rewrites what it found.\n\n        # Deep-merge ONLY permissions.defaultMode — every unrelated\n        # top-level key and every unrelated permissions subkey survives.\n        new_doc = copy.deepcopy(doc)\n        new_permissions = dict(new_doc.get(\"permissions\") or {})\n        new_permissions[\"defaultMode\"] = NIGHT_MODE\n        new_doc[\"permissions\"] = new_permissions\n\n        # Ordering (contract item 5): settings FIRST, marker second.\n        try:\n            _atomic_write_json(settings_file, new_doc)\n        except OSError as exc:\n            sys.stderr.write(\n                f\"night-mode: failed to write {settings_file} \"\n                f\"({exc.__class__.__name__}: {exc}); nothing changed.\\n\"\n            )\n            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"failed\")\n            _emit_audit(NIGHT_MODE, \"other\", \"failed\")\n            return 1\n        if not _read_back_matches(settings_file, new_doc):\n            # Contract item 3: verified-write failure — do NOT write the\n            # marker; the operator sees a hard failure, not a torn state.\n            sys.stderr.write(\n                f\"night-mode: read-back of {settings_file} does not match \"\n                \"what was written — settings may be torn; marker NOT \"\n                \"created. Inspect the file before retrying.\\n\"\n            )\n            _summary(mode=NIGHT_MODE, previous_mode=\"none\", result=\"failed\")\n            _emit_audit(NIGHT_MODE, \"other\", \"failed\")\n            return 1\n\n        marker = {\n            \"version\": MARKER_VERSION,\n            \"mode_written\": NIGHT_MODE,\n            \"prev_present\": prev_present,\n            \"prev_value\": prev_value,\n            \"created_file\": created_file,\n            \"ts\": _utc_now_iso(),\n            \"hostname\": _hostname(),\n        }\n        previous = prev_value if prev_present else \"absent\"\n        try:\n            _atomic_write_json(marker_file, marker)\n        except OSError as exc:\n            sys.stderr.write(\n                f\"night-mode: settings written but marker write failed \"\n                f\"({exc.__class__.__name__}: {exc}). Run 'status' — it will \"\n                \"report the disagreement; re-run 'on' after fixing.\\n\"\n            )\n            _summary(mode=NIGHT_MODE, previous_mode=str(previous), result=\"failed\")\n            _emit_audit(NIGHT_MODE, str(previous), \"failed\")\n            return 1\n        if not _read_back_matches(marker_file, marker):\n            sys.stderr.write(\n                f\"night-mode: read-back of {marker_file} does not match; \"\n                \"marker may be torn. Run 'status' to reconcile.\\n\"\n            )\n            _summary(mode=NIGHT_MODE, previous_mode=str(previous), result=\"failed\")\n            _emit_audit(NIGHT_MODE, str(previous), \"failed\")\n            return 1\n\n        print(\n            \"night-mode: ON — next session starts with \"\n            \"permissions.defaultMode={0!r} (local overlay). Previous local \"\n            \"value: {1}. Disarm with: night-mode off\".format(\n                NIGHT_MODE,\n                # NF-05 (round-4): `previous` is the overlay's RAW\n                # defaultMode — untrusted input from a gitignored,\n                # agent-writable document, echoed here on a LINE-ORIENTED\n                # surface. Interpolated bare, a value carrying '\\n' made\n                # ONE `on` invocation emit TWO 'night-mode-event ' rows (the\n                # forged one claiming result=applied), and a 200k-char value\n                # emitted 200k bytes of stdout. `_bounded_repr` escapes the\n                # newline (repr) AND bounds the length — the same treatment\n                # every other untrusted echo in this file already got.\n                _bounded_repr(previous),\n            )\n        )\n        # The two records LAST, as a pair, on every terminating path of\n        # on/off (structural rule, asserted by the `ast` oracle in the test\n        # suite — NF-04/NF-07): operator-facing summary, then the forensic\n        # `night_mode_toggled` row. A path that returns without both leaves\n        # a posture flip only half-witnessed.\n        _summary(mode=NIGHT_MODE, previous_mode=str(previous), result=\"applied\")\n        _emit_audit(NIGHT_MODE, str(previous), \"applied\")\n        return 0\n\n\n# --------------------------------------------------------------------------- #\n# off\n# --------------------------------------------------------------------------- #\ndef cmd_off(root: Path) -> int:\n    refused = _refuse_if_ci()\n    if refused is not None:\n        _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n        _emit_audit(\"other\", \"other\", \"refused\")\n        return refused\n\n    FileLock = _import_filelock()\n    with FileLock(str(lock_path(root))):\n        marker_file = marker_path(root)\n        if not marker_file.exists():\n            # Contract item 7: idempotent no-op.\n            print(\"night-mode: already OFF (no marker) — no-op.\")\n            _summary(mode=\"none\", previous_mode=\"none\", result=\"noop\")\n            _emit_audit(\"other\", \"other\", \"noop\")\n            return 0\n\n        marker, diag = _load_json_fail_closed(marker_file, \"night-mode marker\")\n        if diag is not None or marker is None:\n            sys.stderr.write(\n                f\"night-mode: {diag or 'marker unreadable'}\\n\"\n                \"night-mode: refusing to guess restore state (fail-closed). \"\n                f\"Inspect the marker and the settings overlay by hand. \"\n                f\"{_DISCARD_HINT}\\n\"\n            )\n            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n            _emit_audit(\"other\", \"other\", \"refused\")\n            return 2\n\n        # NF-03: validate the WHOLE document BEFORE any field is acted on.\n        # Round-2 gated only `prev_value`; `prev_present`, `created_file`,\n        # `mode_written` and `version` were still trusted from the same\n        # untrusted document, and the unlink branch below is reachable from\n        # `created_file` alone. One helper, all fields, plus the\n        # created_file/prev_present consistency rule. Fail-CLOSED: the\n        # marker stays in place as evidence and NOTHING is written.\n        invalid = _validate_marker(marker)\n        if invalid is not None:\n            sys.stderr.write(\n                \"night-mode: REFUSING to restore — the marker at \"\n                f\"{marker_file} is not a healthy night-mode marker: \"\n                f\"{invalid}. Whole-document validation is fail-CLOSED \"\n                \"(NM-01 / NF-01 / NF-02 / NF-03): no field of a rejected \"\n                \"marker is acted on, the settings overlay is untouched, and \"\n                f\"the marker is left in place as evidence. {_DISCARD_HINT}\\n\"\n            )\n            # The marker is rejected, so NOTHING in it — mode_written\n            # included — is echoed into the machine-readable record.\n            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n            _emit_audit(\"other\", \"other\", \"refused\")\n            return 2\n\n        # Every field below is now schema-validated: `mode_written` is\n        # NIGHT_MODE, both booleans are real booleans, `prev_value` is\n        # either None or a string in _RESTORABLE_MODES, and\n        # created_file=True implies prev_present=False.\n        prev_present = marker[\"prev_present\"]\n        prev_value = marker.get(\"prev_value\")\n        created_file = marker[\"created_file\"]\n        mode_written = marker.get(\"mode_written\")\n\n        if prev_present and prev_value == NIGHT_MODE:\n            # NF-01, belt and braces. `_RESTORABLE_MODES` already excludes\n            # NIGHT_MODE, so `_validate_marker` rejects this marker above and\n            # this branch is unreachable TODAY. It stays because the failure\n            # it prevents is the worst one in the script: restoring\n            # night-mode's own value re-arms `acceptEdits` in the overlay AND\n            # removes the marker, leaving the posture armed with nothing to\n            # disarm it. If a future change ever loosens the set, the\n            # symmetric normalization — same rule cmd_on applies on the way\n            # in — still turns a self-referential snapshot into \"remove the\n            # override\" instead of \"re-arm forever\". Exercised directly by\n            # the test suite with a loosened set.\n            sys.stderr.write(\n                \"night-mode: note — the snapshot's prev_value is night-mode's \"\n                f\"own {NIGHT_MODE!r}, which a healthy marker can never carry \"\n                \"(cmd_on normalizes it away). Treating it as 'no prior \"\n                \"override' and REMOVING the local override instead of \"\n                \"re-arming the weak posture (NF-01).\\n\"\n            )\n            prev_present = False\n            prev_value = None\n\n        settings_file = settings_local_path(root)\n        doc, diag = _load_json_fail_closed(settings_file, \"settings.local.json\")\n        if diag is not None:\n            sys.stderr.write(\n                f\"night-mode: {diag}\\n\"\n                \"night-mode: marker left in place (restore not performed). \"\n                \"Repair the overlay JSON by hand first — \"\n                \"'off --discard-snapshot' also refuses to rewrite an overlay \"\n                \"it cannot parse.\\n\"\n            )\n            _summary(mode=\"none\", previous_mode=str(mode_written), result=\"refused\")\n            _emit_audit(\"other\", str(mode_written), \"refused\")\n            return 2\n\n        overlay_absent = doc is None\n        if overlay_absent:\n            # Overlay vanished since `on` (hand cleanup). Nothing to restore;\n            # removing the marker completes the off.\n            #\n            # NF-09 (round-3 review): this route writes NOTHING, so it must\n            # not claim it did. It used to fall through to the shared tail\n            # and report \"restored to 'plan' (snapshot)\" with\n            # `result=applied` — a restore that never happened, on both\n            # records. The truth is that the local layer carries no\n            # defaultMode at all and the next session resolves the PROJECT\n            # layer, so `restored` is \"absent\" and the outcome is `noop`.\n            # The stderr warning corrected an attentive human; the\n            # structured record — the thing a parser reads, and after NF-07\n            # the thing that gets HMAC-signed — stayed wrong.\n            sys.stderr.write(\n                f\"night-mode: warning — {settings_file} is gone; nothing to \"\n                \"restore. Removing marker.\\n\"\n            )\n        else:\n            permissions = doc.get(\"permissions\")\n            if permissions is not None and not isinstance(permissions, dict):\n                sys.stderr.write(\n                    f\"night-mode: 'permissions' in {settings_file} is not an \"\n                    \"object; refusing to restore (fail-closed). Marker left \"\n                    \"in place. Repair the overlay by hand first — \"\n                    \"'off --discard-snapshot' also refuses a 'permissions' \"\n                    \"value it cannot merge.\\n\"\n                )\n                _summary(\n                    mode=\"none\", previous_mode=str(mode_written), result=\"refused\"\n                )\n                _emit_audit(\"other\", str(mode_written), \"refused\")\n                return 2\n\n            current = (permissions or {}).get(\"defaultMode\")\n            if current != mode_written:\n                sys.stderr.write(\n                    \"night-mode: warning — current local defaultMode \"\n                    f\"({current!r}) differs from what night-mode wrote \"\n                    f\"({mode_written!r}); restoring the snapshot anyway.\\n\"\n                )\n\n            new_doc = copy.deepcopy(doc)\n            new_permissions = dict(new_doc.get(\"permissions\") or {})\n            if prev_present:\n                new_permissions[\"defaultMode\"] = prev_value\n            else:\n                new_permissions.pop(\"defaultMode\", None)\n            if new_permissions:\n                new_doc[\"permissions\"] = new_permissions\n            else:\n                # Drop an empty permissions {} rather than leaving litter.\n                new_doc.pop(\"permissions\", None)\n\n            # Ordering (contract item 5, inverse): settings FIRST,\n            # marker removal second.\n            night_mode_own_doc = {\"permissions\": {\"defaultMode\": mode_written}}\n            if created_file and not new_doc and doc == night_mode_own_doc:\n                # `on` created the file and nothing else ever landed in it:\n                # restoring means removing it entirely. Reachable ONLY after\n                # `_validate_marker` proved created_file is a real boolean\n                # AND that created_file=True implies prev_present=False\n                # (NF-03) — an unvalidated `created_file` made this branch\n                # unlink an overlay night-mode never created.\n                #\n                # NF-03 residual, bounded here: no marker field can prove\n                # the file did not pre-exist (that fact lives ONLY in the\n                # marker), so the destructive branch additionally requires\n                # the overlay's CURRENT content to be, in full, exactly what\n                # `on` writes when it creates the file. A forged\n                # `created_file` can therefore only ever delete a document\n                # night-mode itself would have written byte-for-byte;\n                # anything the Owner actually put in the overlay takes the\n                # non-destructive rewrite branch below instead.\n                try:\n                    os.unlink(settings_file)\n                except OSError as exc:\n                    sys.stderr.write(\n                        f\"night-mode: failed to remove {settings_file} \"\n                        f\"({exc.__class__.__name__}: {exc}); marker left in \"\n                        \"place.\\n\"\n                    )\n                    _summary(\n                        mode=\"none\",\n                        previous_mode=str(mode_written),\n                        result=\"failed\",\n                    )\n                    _emit_audit(\"other\", str(mode_written), \"failed\")\n                    return 1\n                _fsync_dir(settings_file.parent)  # NM-09: durable unlink\n            else:\n                try:\n                    _atomic_write_json(settings_file, new_doc)\n                except OSError as exc:\n                    sys.stderr.write(\n                        f\"night-mode: failed to write {settings_file} \"\n                        f\"({exc.__class__.__name__}: {exc}); marker left in \"\n                        \"place.\\n\"\n                    )\n                    _summary(\n                        mode=\"none\",\n                        previous_mode=str(mode_written),\n                        result=\"failed\",\n                    )\n                    _emit_audit(\"other\", str(mode_written), \"failed\")\n                    return 1\n                if not _read_back_matches(settings_file, new_doc):\n                    sys.stderr.write(\n                        f\"night-mode: read-back of {settings_file} does not \"\n                        \"match the restored document — marker left in place \"\n                        \"so 'status' keeps reporting the disagreement.\\n\"\n                    )\n                    _summary(\n                        mode=\"none\",\n                        previous_mode=str(mode_written),\n                        result=\"failed\",\n                    )\n                    _emit_audit(\"other\", str(mode_written), \"failed\")\n                    return 1\n\n        if overlay_absent or not prev_present:\n            # NF-09: \"absent\" on BOTH routes that leave the local layer\n            # without a defaultMode — the snapshot said there was no prior\n            # override, or the overlay holding it had already been removed\n            # by hand. Neither restored a value, so neither may name one.\n            restored = \"absent\"\n        else:\n            restored = prev_value\n        # NF-09: the overlay-gone route writes no settings file at all, so\n        # its outcome is a no-op, not an `applied`. The marker removal that\n        # still happens below is state cleanup, not a posture write.\n        outcome = \"noop\" if overlay_absent else \"applied\"\n        try:\n            os.unlink(marker_file)\n        except OSError as exc:\n            sys.stderr.write(\n                f\"night-mode: settings restored but marker removal failed \"\n                f\"({exc.__class__.__name__}: {exc}); re-run 'off'.\\n\"\n            )\n            _summary(\n                mode=str(restored), previous_mode=str(mode_written), result=\"failed\"\n            )\n            _emit_audit(str(restored), str(mode_written), \"failed\")\n            return 1\n        _fsync_dir(marker_file.parent)  # NM-09: durable unlink\n\n        if overlay_absent:\n            # NF-09: nothing was written on this route. Say that, and say\n            # what governs the next session instead of naming a snapshot\n            # value that was never put anywhere.\n            print(\n                \"night-mode: OFF — nothing to restore: the local overlay \"\n                \"was already gone, so no file was written; the marker is \"\n                \"removed. Next session resolves the project layer's \"\n                \"ratified posture.\"\n            )\n        elif prev_present:\n            # NM-11: name the restored value's relation to the project\n            # layer — a restored local value still OVERRIDES the project\n            # posture; do not claim ratification that did not happen.\n            print(\n                f\"night-mode: OFF — local overlay defaultMode restored to \"\n                f\"{restored!r} (snapshot). Note: that local value still \"\n                \"overrides the project layer's posture for the next session.\"\n            )\n        else:\n            print(\n                \"night-mode: OFF — local overlay defaultMode override \"\n                f\"removed (snapshot: {restored}). Next session resolves the \"\n                \"project layer's ratified posture.\"\n            )\n        # Both records LAST, as a pair (NF-04/NF-07 — see cmd_on).\n        _summary(\n            mode=str(restored), previous_mode=str(mode_written), result=outcome\n        )\n        _emit_audit(str(restored), str(mode_written), outcome)\n        return 0\n\n\n# --------------------------------------------------------------------------- #\n# off --discard-snapshot  (NF-02 recovery)\n# --------------------------------------------------------------------------- #\ndef cmd_off_discard_snapshot(root: Path) -> int:\n    \"\"\"NF-02 — the sanctioned exit from EVERY fail-closed `off` refusal.\n\n    Removes the local `permissions.defaultMode` override AND the marker\n    WITHOUT honoring `prev_value` (or any other marker field), printing\n    exactly what it discarded. Every refusal diagnostic points here: a\n    fail-closed gate must never strand the operator with the posture armed\n    and no way to disarm it short of hand-editing two gitignored files —\n    which is precisely how the round-3 review found the old closed set\n    landing on the PERMISSIVE side (NF-02).\n\n    Deliberate asymmetries with plain `off`:\n\n    - a MISSING marker is NOT a no-op here. The armed-without-marker\n      end-state (crash between the two writes, hand edit, or the NF-01\n      tamper) is exactly what needs recovering, so the override is stripped\n      anyway.\n    - the overlay file is NEVER unlinked, whatever `created_file` claims:\n      discard removes ONE KEY, never a file. It refuses to act on any\n      marker field, so it cannot inherit the NF-03 data-loss path.\n    - a malformed overlay is still fail-CLOSED. Discard rewrites the\n      overlay, and rewriting JSON it cannot parse would destroy the\n      Owner's other settings (contract item 6).\n    \"\"\"\n    refused = _refuse_if_ci()\n    if refused is not None:\n        _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n        _emit_audit(\"other\", \"other\", \"refused\")\n        return refused\n\n    FileLock = _import_filelock()\n    with FileLock(str(lock_path(root))):\n        marker_file = marker_path(root)\n        marker, marker_diag = _load_json_fail_closed(\n            marker_file, \"night-mode marker\"\n        )\n        # Loud, BOUNDED forensic echo — throwing the snapshot away is the\n        # whole point of the flag, so the operator must see what was thrown.\n        if marker is not None:\n            print(\n                \"night-mode: DISCARDING the snapshot at {0} — version={1} \"\n                \"mode_written={2} prev_present={3} prev_value={4} \"\n                \"created_file={5} ts={6} hostname={7}\".format(\n                    marker_file,\n                    _bounded_repr(marker.get(\"version\")),\n                    _bounded_repr(marker.get(\"mode_written\")),\n                    _bounded_repr(marker.get(\"prev_present\")),\n                    _bounded_repr(marker.get(\"prev_value\")),\n                    _bounded_repr(marker.get(\"created_file\")),\n                    _bounded_repr(marker.get(\"ts\")),\n                    _bounded_repr(marker.get(\"hostname\")),\n                )\n            )\n            print(\n                \"night-mode: that prev_value is NOT being restored — the \"\n                \"local defaultMode override is being REMOVED instead.\"\n            )\n        elif marker_diag is not None:\n            print(\n                f\"night-mode: DISCARDING an UNPARSEABLE marker at \"\n                f\"{marker_file} — {marker_diag}\"\n            )\n        else:\n            print(\n                f\"night-mode: no marker at {marker_file} — discarding the \"\n                \"local defaultMode override anyway (armed-without-marker \"\n                \"recovery; plain 'off' is a no-op in this state).\"\n            )\n\n        settings_file = settings_local_path(root)\n        doc, diag = _load_json_fail_closed(settings_file, \"settings.local.json\")\n        if diag is not None:\n            sys.stderr.write(\n                f\"night-mode: {diag}\\n\"\n                \"night-mode: --discard-snapshot still refuses to rewrite an \"\n                \"overlay it cannot parse (fail-closed on input) — repair the \"\n                \"JSON by hand, then re-run. Marker left in place.\\n\"\n            )\n            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n            _emit_audit(\"other\", \"other\", \"refused\")\n            return 2\n\n        removed: Any = \"absent\"\n        if doc is None:\n            sys.stderr.write(\n                f\"night-mode: warning — {settings_file} is absent; there is \"\n                \"no override to strip.\\n\"\n            )\n        else:\n            permissions = doc.get(\"permissions\")\n            if permissions is not None and not isinstance(permissions, dict):\n                sys.stderr.write(\n                    f\"night-mode: 'permissions' in {settings_file} is not an \"\n                    f\"object (got {type(permissions).__name__}); refusing to \"\n                    \"rewrite it (fail-closed). Repair it by hand, then \"\n                    \"re-run. Marker left in place.\\n\"\n                )\n                _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n                _emit_audit(\"other\", \"other\", \"refused\")\n                return 2\n            removed = (permissions or {}).get(\"defaultMode\", \"absent\")\n\n            new_doc = copy.deepcopy(doc)\n            new_permissions = dict(new_doc.get(\"permissions\") or {})\n            new_permissions.pop(\"defaultMode\", None)\n            if new_permissions:\n                new_doc[\"permissions\"] = new_permissions\n            else:\n                new_doc.pop(\"permissions\", None)\n\n            # Ordering (contract item 5): settings FIRST, marker second.\n            try:\n                _atomic_write_json(settings_file, new_doc)\n            except OSError as exc:\n                sys.stderr.write(\n                    f\"night-mode: failed to write {settings_file} \"\n                    f\"({exc.__class__.__name__}: {exc}); marker left in \"\n                    \"place.\\n\"\n                )\n                _summary(mode=\"none\", previous_mode=\"none\", result=\"failed\")\n                _emit_audit(\"other\", \"other\", \"failed\")\n                return 1\n            if not _read_back_matches(settings_file, new_doc):\n                sys.stderr.write(\n                    f\"night-mode: read-back of {settings_file} does not match \"\n                    \"the stripped document — marker left in place so 'status' \"\n                    \"keeps reporting the disagreement.\\n\"\n                )\n                _summary(mode=\"none\", previous_mode=\"none\", result=\"failed\")\n                _emit_audit(\"other\", \"other\", \"failed\")\n                return 1\n\n        if marker_file.exists():\n            try:\n                os.unlink(marker_file)\n            except OSError as exc:\n                sys.stderr.write(\n                    f\"night-mode: override stripped but marker removal failed \"\n                    f\"({exc.__class__.__name__}: {exc}); re-run \"\n                    \"'off --discard-snapshot'.\\n\"\n                )\n                _summary(mode=\"none\", previous_mode=\"none\", result=\"failed\")\n                _emit_audit(\"other\", \"other\", \"failed\")\n                return 1\n            _fsync_dir(marker_file.parent)  # NM-09: durable unlink\n\n        print(\n            \"night-mode: OFF (snapshot DISCARDED) — local overlay \"\n            f\"defaultMode override removed (it was \"\n            f\"{_bounded_repr(removed)}), marker deleted, prev_value NOT \"\n            \"restored. The next session resolves the project layer's \"\n            \"ratified posture.\"\n        )\n        # Both records LAST, as a pair (NF-04/NF-07 — see cmd_on).\n        _summary(mode=\"none\", previous_mode=\"none\", result=\"applied\")\n        _emit_audit(\"other\", \"other\", \"applied\")\n        return 0\n\n\n# --------------------------------------------------------------------------- #\n# status\n# --------------------------------------------------------------------------- #\n","numLines":610,"startLine":1,"totalLines":610}},"tool_result_meta":[{"id":"toolu_017X7oZU8Tz1rBfqEb79x34y","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
