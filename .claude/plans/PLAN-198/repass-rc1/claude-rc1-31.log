44\t    idx_p99 = int((iterations - 1) * 99 / 100.0)\n45\t    if idx_p95 == idx_p99:\n46\t        return {\n47\t            \"schema\": \"profile-opus-4-7.v1\",\n48\t            \"mode\": \"hook_latency\",\n49\t            \"measured_at\": measured_at,\n50\t            \"error\": (\n51\t                \"percentile_indices_collapsed: iterations=%d puts p95 and \"\n52\t                \"p99 on the same order statistic (index %d); minimum is 22, \"\n53\t                \"gate standard is 200 (ADR-163)\" % (iterations, idx_p95)\n54\t            ),\n55\t            \"p95_ceiling_ms\": p95_ceiling_ms,\n56\t            \"p99_ceiling_ms\": p99_ceiling_ms,\n57\t            \"passed\": False,\n58\t        }\n59\t    for required in (agent_spawn, anti_overhead, output_secrets):\n60\t        if not required.is_file():\n61\t            return {\n62\t                \"schema\": \"profile-opus-4-7.v1\",\n63\t                \"mode\": \"hook_latency\",\n64\t                \"measured_at\": measured_at,\n65\t                \"error\": f\"hook not found: {required}\",\n66\t                \"passed\": False,\n67\t            }\n68\t    # --- second-key wiring (ADR-163 Amendment PLAN-169 S328) ---------------\n69\t    # The whole relative machinery — reference sampling AND the wall self-cap\n70\t    # — is gated on the new flags, so a run without them is byte-identical to\n71\t    # today (report keys AND exit code), which is the back-compat contract.\n72\t    second_key = bool(exec_reference or relative_advisory or relative_k_source)\n73\t    relative_warnings: List[str] = []\n74\t    k_by_entry: Dict[str, float] = {}\n75\t    if relative_k_source:\n76\t        k_by_entry, relative_warnings = _load_relative_k_source(relative_k_source)\n77\t        if not exec_reference and k_by_entry:\n78\t            relative_warnings.append(\n79\t                \"relative_k_source_ignored: --relative-k-source needs \"\n80\t                \"--exec-reference (no reference measured, so rel_ok is \"\n81\t                \"undefined); every entry stays on phase 1\"\n82\t            )\n83\t            k_by_entry = {}\n84\t    ref_plan = _ref_schedule(iterations, _REF_SAMPLES_PER_ENTRY) if exec_reference else []\n85\t    t_gate_start = time.perf_counter()\n86\t    wall_deadline_s = _WALL_BUDGET_SAFETY_FRACTION * float(wall_budget_seconds)\n87\t    wall_exceeded = False\n88\t    def _wall_blown() -> bool:\n89\t        if not second_key:\n90\t            return False"}]},"parent_tool_use_id":null,"session_id":"4e0cc364-80e9-432f-8fee-77cee84da142","uuid":"9165f3a7-972f-44ae-926f-743726d45786","timestamp":"2026-11-13T18:47:40.644Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_profile_opus_parts/latency.py","content":"\"\"\"Extracted implementation: latency.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\n\ndef run_hook_latency(\n    repo_root: Path,\n    iterations: int = 200,\n    p95_ceiling_ms: float = 180.0,\n    p99_ceiling_ms: float = 160.0,\n    p99_advisory: bool = False,\n    exec_reference: bool = False,\n    relative_advisory: bool = False,\n    relative_k_source: Optional[str] = None,\n    wall_budget_seconds: float = 420.0,\n    strict_relative: bool = False,\n    sampler: Optional[Callable[[str, str, int], float]] = None,\n) -> Dict[str, Any]:\n    \"\"\"Profile hook latency; full contract in hook_latency_docs.\"\"\"\n    hooks_dir = repo_root / \".claude\" / \"hooks\"\n    agent_spawn = hooks_dir / \"check_agent_spawn.py\"\n    anti_overhead = hooks_dir / \"check_anti_ceo_overhead.py\"\n    output_secrets = hooks_dir / \"check_output_secrets.py\"\n    measured_at = datetime