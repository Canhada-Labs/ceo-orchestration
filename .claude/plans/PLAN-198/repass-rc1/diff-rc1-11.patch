+                    # traceback (more subprocess calls at N=200 raise the
+                    # cumulative odds of one stall on a contended runner).
+                    try:
+                        seed_res = subprocess.run(
+                            [sys.executable, str(anti_overhead)],
+                            input=_latency_pre_payload(tool_use_id),
+                            capture_output=True,
+                            env=env,
+                            cwd=str(repo_root),
+                            timeout=10,
+                        )
