+                try:
+                    res = subprocess.run(
+                        [sys.executable, str(entry["hook"])],
+                        input=payload,
+                        capture_output=True,
+                        env=env,
+                        cwd=str(repo_root),
+                        timeout=10,
+                    )
+                    if res.returncode != 0:
