+            env["CEO_AUDIT_LOG_DIR"] = str(entry_tmp / "audit")
+            env.update(entry["env_set"])
+            (entry_tmp / "home").mkdir(parents=True, exist_ok=True)
+            (entry_tmp / "audit").mkdir(parents=True, exist_ok=True)
