{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R5Fc42nTEhk2wvNABzd2n2","type":"tool_result","content":"1\t\"\"\"Extracted ceo-boot declarations executed by the facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t\n5\t\n6\tdef _render_lessons_section_safe(\n7\t    lessons_mod: Any = _UNSET,\n8\t    validator_mod: Any = _UNSET,\n9\t    *,\n10\t    now_fn: Any = None,\n11\t) -> str:\n12\t    \"\"\"Render the fenced past-lessons section (default full mode only).\n13\t\n14\t    Returns \"\" whenever there is nothing to safely render. NEVER raises —\n15\t    an exception anywhere degrades to \"\" (boot must never break). The\n16\t    `lessons_mod` / `validator_mod` parameters are test seams; production\n17\t    callers use the defaults (defensive loaders).\n18\t    \"\"\"\n19\t    try:\n20\t        enabled, disabled_switch = _lessons_boot_rail_state()\n21\t        if not enabled:\n22\t            if disabled_switch:\n23\t                _emit_learning_rail_disabled_safe(disabled_switch)\n24\t            return \"\"\n25\t\n26\t        mod = _load_lessons_module() if lessons_mod is _UNSET else lessons_mod\n27\t        if mod is None:\n28\t            sys.stderr.write(\n29\t                \"# ceo-boot lessons: lessons module unavailable \"\n30\t                \"(render skipped, fail-open)\\n\"\n31\t            )\n32\t            return \"\"\n33\t        fetch_fn = getattr(mod, \"get_boot_lessons_verified\", None)\n34\t        if not callable(fetch_fn):\n35\t            # Pre-B2 landing / partial install — render nothing, fail-open.\n36\t            sys.stderr.write(\n37\t                \"# ceo-boot lessons: lessons.get_boot_lessons_verified \"\n38\t                \"unavailable (render skipped, fail-open)\\n\"\n39\t            )\n40\t            return \"\"\n41\t\n42\t        project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or str(REPO_ROOT)\n43\t        try:\n44\t            try:\n45\t                raw_lessons = fetch_fn(projec