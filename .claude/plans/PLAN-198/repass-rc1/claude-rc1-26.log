{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017rdjFpgjVaupcJMDG2mXMa","type":"tool_result","content":"1\t\"\"\"Testes do lint de vacuidade + cura do caso vivo (PLAN-178 W-C Lote A, C3).\n2\t\n3\tDuas pernas da cura, ambas com positive control (consenso r1 must-fix\n4\t10; codex pos-debate P1/AC-6):\n5\t\n6\tR1 (lint): fixture com check deliberadamente vacuoso TEM de ser\n7\treprovada; fixture com waiver/indirecao TEM de passar; parse error e\n8\tfail-loud.\n9\t\n10\tR2 (caso vivo): ``check_tier_a_spec_version_drift`` era o exemplar da\n11\tclasse S287 \"registered-vacuous\" (lia VERSION e SPEC e nunca\n12\tcomparava). A regressao aqui e FUNCIONAL, nao estrutural: extrai a\n13\tfuncao do ceo-boot.py real via AST, executa com REPO_ROOT stubbado e\n14\texige red no drift / green no match — se alguem reverter a cura, o\n15\tteste de drift volta a receber green e FALHA.\n16\t\"\"\"\n17\tfrom __future__ import annotations\n18\t\n19\timport ast\n20\timport importlib.util\n21\timport pathlib\n22\timport subprocess\n23\timport sys\n24\tfrom typing import Any, Tuple\n25\t\n26\tREPO = pathlib.Path(__file__).resolve().parents[3]\n27\tLINT = REPO / \".claude\" / \"scripts\" / \"check-vacuous-checks.py\"\n28\tCEO_BOOT = REPO / \".claude\" / \"scripts\" / \"ceo-boot.py\"\n29\t\n30\t\n31\tdef _load_lint():\n32\t    spec = importlib.util.spec_from_file_location(\"vacuous_lint\", LINT)\n33\t    mod = importlib.util.module_from_spec(spec)\n34\t    spec.loader.exec_module(mod)  # type: ignore[union-attr]\n35\t    return mod\n36\t\n37\t\n38\t# ---------------------------------------------------------------- R1: lint\n39\t\n40\tdef test_positive_control_flags_deliberately_vacuous_check(tmp_path):\n41\t    fixture = tmp_path / \"fake_boot.py\"\n42\t    fixture.write_text(\n43\t        'def check_always_green():\\n'\n44\t        '    \"\"\"decorativo de proposito (fixture do positive control).\"\"\"\\n'\n45\t        '    return (\"green\", \"sempre\", None)\\n'\n46\t    )\n47\t    mod = _load_lint()\n48\t    code, flagged = mod.scan_file(str(fixture))\n49\t    assert code == 1, \"lint DEVE reprovar o check vacuoso da fixture\"\n50\t    assert any(\"check_always_green\" in f for f in flagged)\n51\t\n52\t\n53\tdef test_discriminating_check_passes(tmp_path):\n54\t    fixture = tmp_path / \"fake_boot.py\"\n55\t    fixture.write_text(\n56\t        'def check_real(v):\\n'\n57\t        '    if v > 2:\\n'\n58\t        '        return (\"red\", \"drift\", v)\\n'\n59\t        '    return (\"green\", \"ok\", v)\\n'\n60\t    )\n61\t    mod = _load_lint()\n62\t    code, flagged = mod.scan_file(str(fixture))\n63\t    assert code == 0 and not flagged\n64\t\n65\t\n66\tdef test_waiver_is_honored(tmp_path):\n67\t    fixture = tmp_path / \"fake_boot.py\"\n68\t    fixture.write_text(\n69\t        '# CEO-INFORMATIONAL-ONLY: contador informativo, sem limiar\\n'\n70\t        'def check_counter():\\n'\n71\t        '    return (\"green\", \"n=3\", 3)\\n'\n72\t    )\n73\t    mod = _load_lint()\n74\t    code, flagged = mod.scan_file(str(fixture))\n75\t    assert code == 0 and not flagged\n76\t\n77\t\n78\tdef test_distractor_literals_do_not_count_as_discrimination(tmp_path):\n79\t    \"\"\"codex Lote-A P2-2: literal de status em docstring/dict/branch\n80\t    morto NAO pode salvar um check sempre-verde.\"\"\"\n81\t    fixture = tmp_path / \"fake_boot.py\"\n82\t    fixture.write_text(\n83\t        'def check_distractor():\\n'\n84\t        '    \"\"\"No drift retornaria \"red\" — mas nunca retorna.\"\"\"\\n'\n85\t        '    labels = {\"green\": 1, \"red\": 2}\\n'\n86\t        '    return (\"green\", \"always\", labels)\\n'\n87\t    )\n88\t    mod = _load_lint()\n89\t    code, flagged = mod.scan_file(str(fixture))\n90\t    assert code == 1, \"distrator em docstring/dict passou como discriminacao\"\n91\t    assert any(\"check_distractor\" in f for f in flagged)\n92\t\n93\t\n94\tdef test_nested_helper_return_does_not_count(tmp_path):\n95\t    \"\"\"codex r2 P2-3: return de helper ANINHADO nao salva o pai.\"\"\"\n96\t    fixture = tmp_path / \"fake_boot.py\"\n97\t    fixture.write_text(\n98\t        'def check_with_nested():\\n'\n99\t        '    def _helper():\\n'\n100\t        '        return (\"red\", \"inner\", None)\\n'\n101\t        '    _helper()\\n'\n102\t        '    return (\"green\", \"always\", None)\\n'\n103\t    )\n104\t    mod = _load_lint()\n105\t    code, flagged = mod.scan_file(str(fixture))\n106\t    assert code == 1 and any(\"check_with_nested\" in f for f in flagged)\n107\t\n108\t\n109\tdef test_dead_branch_return_does_not_count(tmp_path):\n110\t    \"\"\"codex r2 P2-3: `if False: return red` e branch morto.\"\"\"\n111\t    fixture = tmp_path / \"fake_boot.py\"\n112\t    fixture.write_text(\n113\t        'def check_dead_branch():\\n'\n114\t        '    if False:\\n'\n115\t        '        return (\"red\", \"unreachable\", None)\\n'\n116\t        '    return (\"green\", \"always\", None)\\n'\n117\t    )\n118\t    mod = _load_lint()\n119\t    code, flagged = mod.scan_file(str(fixture))\n120\t    assert code == 1 and any(\"check_dead_branch\" in f for f in flagged)\n121\t\n122\t\n123\tdef test_waiver_in_docstring_does_not_waive(tmp_path):\n124\t    \"\"\"codex r2 P2-4: mencao em docstring/string NAO e waiver.\"\"\"\n125\t    fixture = tmp_path / \"fake_boot.py\"\n126\t    fixture.write_text(\n127\t        'def check_sneaky():\\n'\n128\t        '    \"\"\"Not a CEO-INFORMATIONAL-ONLY check, honest.\"\"\"\\n'\n129\t        '    return (\"green\", \"always\", None)\\n'\n130\t    )\n131\t    mod = _load_lint()\n132\t    code, flagged = mod.scan_file(str(fixture))\n133\t    assert code == 1 and any(\"check_sneaky\" in f for f in flagged)\n134\t\n135\t\n136\tdef test_waiver_requires_nonempty_reason(tmp_path):\n137\t    fixture = tmp_path / \"fake_boot.py\"\n138\t    fixture.write_text(\n139\t        '# CEO-INFORMATIONAL-ONLY:\\n'\n140\t        'def check_no_reason():\\n'\n141\t        '    return (\"green\", \"always\", None)\\n'\n142\t    )\n143\t    mod = _load_lint()\n144\t    code, flagged = mod.scan_file(str(fixture))\n145\t    assert code == 1, \"waiver sem razao nao pode waivar\"\n146\t\n147\t\n148\tdef test_indirect_status_is_skipped_not_flagged(tmp_path):\n149\t    fixture = tmp_path / \"fake_boot.py\"\n150\t    fixture.write_text(\n151\t        'def _helper(v):\\n'\n152\t        '    return (\"red\" if v else \"green\", \"x\", v)\\n'\n153\t        'def check_delegating(v):\\n'\n154\t        '    status, summary = _helper(v)[0], _helper(v)[1]\\n'\n155\t        '    return status, summary, v\\n'\n156\t    )\n157\t    mod = _load_lint()\n158\t    code, flagged = mod.scan_file(str(fixture))\n159\t    assert code == 0 and not flagged\n160\t\n161\t\n162\tdef test_parse_error_is_loud(tmp_path):\n163\t    fixture = tmp_path / \"broken.py\"\n164\t    fixture.write_text(\"def check_(:\\n\")\n165\t    mod = _load_lint()\n166\t    code, flagged = mod.scan_file(str(fixture))\n167\t    assert code == 2 and any(\"PARSE-ERROR\" in f for f in flagged)\n168\t\n169\t\n170\tdef test_cli_clean_on_real_ceo_boot():\n171\t    \"\"\"O ceo-boot.py REAL fica limpo: cura + waivers completos.\n172\t\n173\t    Este e o teto do C3 — se um check novo nascer vacuoso sem waiver,\n174\t    este teste (e o lint no CI, quando wirado) ficam vermelhos.\n175\t    \"\"\"\n176\t    proc = subprocess.run(\n177\t        [sys.executable, str(LINT), str(CEO_BOOT)],\n178\t        capture_output=True, text=True, timeout=60,\n179\t    )\n180\t    assert \"INPUTS:\" in proc.stdout, proc.stderr\n181\t    assert proc.returncode == 0, (\n182\t        \"check_* vacuoso sem waiver em ceo-boot.py:\\n\" + proc.stdout\n183\t    )\n184\t\n185\t\n186\t# ------------------------------------------------- R2: caso vivo (funcional)\n187\t\n188\tdef _extract_spec_drift_fn(repo_root: pathlib.Path):\n189\t    \"\"\"Extrai check_tier_a_spec_version_drift do ceo-boot.py real e a\n190\t    executa num namespace com REPO_ROOT stubbado (sem importar o script\n191\t    inteiro — top-level do ceo-boot tem efeitos de sessao).\"\"\"\n192\t    src = CEO_BOOT.read_text(encoding=\"utf-8\")\n193\t    tree = ast.parse(src)\n194\t    fn = next(\n195\t        node for node in ast.walk(tree)\n196\t        if isinstance(node, ast.FunctionDef)\n197\t        and node.name == \"check_tier_a_spec_version_drift\"\n198\t    )\n199\t    segment = ast.get_source_segment(src, fn)\n200\t    ns: dict = {\"REPO_ROOT\": repo_root, \"Tuple\": Tuple, \"Any\": Any,\n201\t                \"subprocess\": subprocess}\n202\t    exec(compile(segment, str(CEO_BOOT), \"exec\"), ns)  # noqa: S102\n203\t    return ns[\"check_tier_a_spec_version_drift\"]\n204\t\n205\t\n206\tdef _seed_fw(tmp_path: pathlib.Path, version: str,\n207\t             delivered: bool = True) -> None:\n208\t    (tmp_path / \".claude\").mkdir(parents=True, exist_ok=True)\n209\t    (tmp_path / \".claude\" / \".framework-version\").write_text(version + \"\\n\")\n210\t    if delivered:\n211\t        # registro de entrega (ADR-155-AMEND-1): baseline manifest com\n212\t        # record do marker => proveniencia verificada\n213\t        (tmp_path / \".claude\" / \".install-manifest.sha256\").write_text(\n214\t            \"0\" * 64 + \"  .claude/.framework-version\\n\"\n215\t        )\n216\t\n217\t\n218\tdef test_bug_178_spec_version_drift_red_on_major_mismatch(tmp_path):\n219\t    _seed_fw(tmp_path, \"2.0.0\")\n220\t    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n221\t    fn = _extract_spec_drift_fn(tmp_path)\n222\t    status, summary, detail = fn()\n223\t    assert status == \"red\", (\n224\t        \"REGRESSAO S287: framework major 2 vs SPEC v1 tem de dar red; \"\n225\t        \"recebeu %r (%s) — a cura do PLAN-178 C3 foi revertida?\"\n226\t        % (status, summary)\n227\t    )\n228\t    assert detail[\"repo_version\"] == \"2.0.0\"\n229\t\n230\t\n231\tdef test_bug_178_spec_version_drift_green_on_match(tmp_path):\n232\t    _seed_fw(tmp_path, \"1.3.0\")\n233\t    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n234\t    fn = _extract_spec_drift_fn(tmp_path)\n235\t    status, _summary, detail = fn()\n236\t    assert status == \"green\"\n237\t    assert detail[\"spec_versions\"] == [\"v1\"]\n238\t\n239\t\n240\tdef test_bug_178_spec_version_drift_yellow_on_garbage(tmp_path):\n241\t    _seed_fw(tmp_path, \"not-a-version\")\n242\t    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n243\t    fn = _extract_spec_drift_fn(tmp_path)\n244\t    status, _summary, _detail = fn()\n245\t    assert status == \"yellow\"\n246\t\n247\t\n248\tdef test_bug_178_adopter_own_version_never_reds(tmp_path):\n249\t    \"\"\"codex Lote-A P2-1: adopter com VERSION proprio (app 2.0.0) e SEM\n250\t    .framework-version atribuivel NAO pode dar red — o root VERSION\n251\t    nao e do framework (ADR-155-AMEND-1 §2).\"\"\"\n252\t    (tmp_path / \"VERSION\").write_text(\"2.0.0\\n\")  # versao do APP\n253\t    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n254\t    fn = _extract_spec_drift_fn(tmp_path)\n255\t    status, summary, _detail = fn()\n256\t    assert status == \"green\", (\n257\t        \"false-red de adopter: %r (%s)\" % (status, summary)\n258\t    )\n259\t    assert \"not attributable\" in summary\n260\t\n261\t\n262\tdef test_bug_178_adopter_with_framework_version_compares_it(tmp_path):\n263\t    \"\"\"Adopter app 9.9.9 + .framework-version 1.3.0 + SPEC/v1 => green\n264\t    (compara o FRAMEWORK, ignora o VERSION do app).\"\"\"\n265\t    (tmp_path / \"VERSION\").write_text(\"9.9.9\\n\")\n266\t    _seed_fw(tmp_path, \"1.3.0\")\n267\t    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n268\t    fn = _extract_spec_drift_fn(tmp_path)\n269\t    status, _summary, detail = fn()\n270\t    assert status == \"green\"\n271\t    assert detail[\"repo_version\"] == \"1.3.0\"\n272\t\n273\t\n274\tdef test_bug_178_unverified_marker_mismatch_is_yellow_not_red(tmp_path):\n275\t    \"\"\"codex r2 P2-1 (ADR-155-AMEND-1 §5): marker SEM registro de\n276\t    entrega e SEM git-tracking nao sustenta red — mismatch vira yellow\n277\t    'drift suspected'.\"\"\"\n278\t    _seed_fw(tmp_path, \"2.0.0\", delivered=False)\n279\t    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n280\t    fn = _extract_spec_drift_fn(tmp_path)\n281\t    status, summary, detail = fn()\n282\t    assert status == \"yellow\", (\n283\t        \"marker nao-atribuivel deu %r (%s) — red exige proveniencia\"\n284\t        % (status, summary)\n285\t    )\n286\t    assert \"suspected\" in summary\n287\t    assert detail[\"provenance_verified\"] is False\n288\t\n289\t\n290\tdef test_bug_178_delivered_marker_mismatch_is_red(tmp_path):\n291\t    \"\"\"Com registro de entrega, o mesmo mismatch E red (o caminho red\n292\t    continua alcancavel — a cura da vacuidade nao regrediu).\"\"\"\n293\t    _seed_fw(tmp_path, \"2.0.0\", delivered=True)\n294\t    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n295\t    fn = _extract_spec_drift_fn(tmp_path)\n296\t    status, _summary, detail = fn()\n297\t    assert status == \"red\"\n298\t    assert detail[\"provenance_verified\"] is True\n299\t\n300\t\n301\tdef test_dead_symbol_lesson_render_safe_is_gone():\n302\t    \"\"\"C4: o simbolo morto nao volta ao arquivo vivo (a referencia\n303\t    correta e _validate_boot_lesson).\"\"\"\n304\t    src = CEO_BOOT.read_text(encoding=\"utf-8\")\n305\t    assert \"_lesson_render_safe\" not in src\n306\t    assert \"_validate_boot_lesson\" in src\n307\t"}]},"parent_tool_use_id":null,"session_id":"0e2c1f70-53aa-4703-b5b7-cf3bec7d6ad2","uuid":"8963cddc-195b-4300-a149-7432e7905acc","timestamp":"2026-11-15T11:12:03.777Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/scripts/tests/test_check_vacuous_checks.py","content":"\"\"\"Testes do lint de vacuidade + cura do caso vivo (PLAN-178 W-C Lote A, C3).\n\nDuas pernas da cura, ambas com positive control (consenso r1 must-fix\n10; codex pos-debate P1/AC-6):\n\nR1 (lint): fixture com check deliberadamente vacuoso TEM de ser\nreprovada; fixture com waiver/indirecao TEM de passar; parse error e\nfail-loud.\n\nR2 (caso vivo): ``check_tier_a_spec_version_drift`` era o exemplar da\nclasse S287 \"registered-vacuous\" (lia VERSION e SPEC e nunca\ncomparava). A regressao aqui e FUNCIONAL, nao estrutural: extrai a\nfuncao do ceo-boot.py real via AST, executa com REPO_ROOT stubbado e\nexige red no drift / green no match — se alguem reverter a cura, o\nteste de drift volta a receber green e FALHA.\n\"\"\"\nfrom __future__ import annotations\n\nimport ast\nimport importlib.util\nimport pathlib\nimport subprocess\nimport sys\nfrom typing import Any, Tuple\n\nREPO = pathlib.Path(__file__).resolve().parents[3]\nLINT = REPO / \".claude\" / \"scripts\" / \"check-vacuous-checks.py\"\nCEO_BOOT = REPO / \".claude\" / \"scripts\" / \"ceo-boot.py\"\n\n\ndef _load_lint():\n    spec = importlib.util.spec_from_file_location(\"vacuous_lint\", LINT)\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)  # type: ignore[union-attr]\n    return mod\n\n\n# ---------------------------------------------------------------- R1: lint\n\ndef test_positive_control_flags_deliberately_vacuous_check(tmp_path):\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        'def check_always_green():\\n'\n        '    \"\"\"decorativo de proposito (fixture do positive control).\"\"\"\\n'\n        '    return (\"green\", \"sempre\", None)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 1, \"lint DEVE reprovar o check vacuoso da fixture\"\n    assert any(\"check_always_green\" in f for f in flagged)\n\n\ndef test_discriminating_check_passes(tmp_path):\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        'def check_real(v):\\n'\n        '    if v > 2:\\n'\n        '        return (\"red\", \"drift\", v)\\n'\n        '    return (\"green\", \"ok\", v)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 0 and not flagged\n\n\ndef test_waiver_is_honored(tmp_path):\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        '# CEO-INFORMATIONAL-ONLY: contador informativo, sem limiar\\n'\n        'def check_counter():\\n'\n        '    return (\"green\", \"n=3\", 3)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 0 and not flagged\n\n\ndef test_distractor_literals_do_not_count_as_discrimination(tmp_path):\n    \"\"\"codex Lote-A P2-2: literal de status em docstring/dict/branch\n    morto NAO pode salvar um check sempre-verde.\"\"\"\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        'def check_distractor():\\n'\n        '    \"\"\"No drift retornaria \"red\" — mas nunca retorna.\"\"\"\\n'\n        '    labels = {\"green\": 1, \"red\": 2}\\n'\n        '    return (\"green\", \"always\", labels)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 1, \"distrator em docstring/dict passou como discriminacao\"\n    assert any(\"check_distractor\" in f for f in flagged)\n\n\ndef test_nested_helper_return_does_not_count(tmp_path):\n    \"\"\"codex r2 P2-3: return de helper ANINHADO nao salva o pai.\"\"\"\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        'def check_with_nested():\\n'\n        '    def _helper():\\n'\n        '        return (\"red\", \"inner\", None)\\n'\n        '    _helper()\\n'\n        '    return (\"green\", \"always\", None)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 1 and any(\"check_with_nested\" in f for f in flagged)\n\n\ndef test_dead_branch_return_does_not_count(tmp_path):\n    \"\"\"codex r2 P2-3: `if False: return red` e branch morto.\"\"\"\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        'def check_dead_branch():\\n'\n        '    if False:\\n'\n        '        return (\"red\", \"unreachable\", None)\\n'\n        '    return (\"green\", \"always\", None)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 1 and any(\"check_dead_branch\" in f for f in flagged)\n\n\ndef test_waiver_in_docstring_does_not_waive(tmp_path):\n    \"\"\"codex r2 P2-4: mencao em docstring/string NAO e waiver.\"\"\"\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        'def check_sneaky():\\n'\n        '    \"\"\"Not a CEO-INFORMATIONAL-ONLY check, honest.\"\"\"\\n'\n        '    return (\"green\", \"always\", None)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 1 and any(\"check_sneaky\" in f for f in flagged)\n\n\ndef test_waiver_requires_nonempty_reason(tmp_path):\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        '# CEO-INFORMATIONAL-ONLY:\\n'\n        'def check_no_reason():\\n'\n        '    return (\"green\", \"always\", None)\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 1, \"waiver sem razao nao pode waivar\"\n\n\ndef test_indirect_status_is_skipped_not_flagged(tmp_path):\n    fixture = tmp_path / \"fake_boot.py\"\n    fixture.write_text(\n        'def _helper(v):\\n'\n        '    return (\"red\" if v else \"green\", \"x\", v)\\n'\n        'def check_delegating(v):\\n'\n        '    status, summary = _helper(v)[0], _helper(v)[1]\\n'\n        '    return status, summary, v\\n'\n    )\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 0 and not flagged\n\n\ndef test_parse_error_is_loud(tmp_path):\n    fixture = tmp_path / \"broken.py\"\n    fixture.write_text(\"def check_(:\\n\")\n    mod = _load_lint()\n    code, flagged = mod.scan_file(str(fixture))\n    assert code == 2 and any(\"PARSE-ERROR\" in f for f in flagged)\n\n\ndef test_cli_clean_on_real_ceo_boot():\n    \"\"\"O ceo-boot.py REAL fica limpo: cura + waivers completos.\n\n    Este e o teto do C3 — se um check novo nascer vacuoso sem waiver,\n    este teste (e o lint no CI, quando wirado) ficam vermelhos.\n    \"\"\"\n    proc = subprocess.run(\n        [sys.executable, str(LINT), str(CEO_BOOT)],\n        capture_output=True, text=True, timeout=60,\n    )\n    assert \"INPUTS:\" in proc.stdout, proc.stderr\n    assert proc.returncode == 0, (\n        \"check_* vacuoso sem waiver em ceo-boot.py:\\n\" + proc.stdout\n    )\n\n\n# ------------------------------------------------- R2: caso vivo (funcional)\n\ndef _extract_spec_drift_fn(repo_root: pathlib.Path):\n    \"\"\"Extrai check_tier_a_spec_version_drift do ceo-boot.py real e a\n    executa num namespace com REPO_ROOT stubbado (sem importar o script\n    inteiro — top-level do ceo-boot tem efeitos de sessao).\"\"\"\n    src = CEO_BOOT.read_text(encoding=\"utf-8\")\n    tree = ast.parse(src)\n    fn = next(\n        node for node in ast.walk(tree)\n        if isinstance(node, ast.FunctionDef)\n        and node.name == \"check_tier_a_spec_version_drift\"\n    )\n    segment = ast.get_source_segment(src, fn)\n    ns: dict = {\"REPO_ROOT\": repo_root, \"Tuple\": Tuple, \"Any\": Any,\n                \"subprocess\": subprocess}\n    exec(compile(segment, str(CEO_BOOT), \"exec\"), ns)  # noqa: S102\n    return ns[\"check_tier_a_spec_version_drift\"]\n\n\ndef _seed_fw(tmp_path: pathlib.Path, version: str,\n             delivered: bool = True) -> None:\n    (tmp_path / \".claude\").mkdir(parents=True, exist_ok=True)\n    (tmp_path / \".claude\" / \".framework-version\").write_text(version + \"\\n\")\n    if delivered:\n        # registro de entrega (ADR-155-AMEND-1): baseline manifest com\n        # record do marker => proveniencia verificada\n        (tmp_path / \".claude\" / \".install-manifest.sha256\").write_text(\n            \"0\" * 64 + \"  .claude/.framework-version\\n\"\n        )\n\n\ndef test_bug_178_spec_version_drift_red_on_major_mismatch(tmp_path):\n    _seed_fw(tmp_path, \"2.0.0\")\n    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n    fn = _extract_spec_drift_fn(tmp_path)\n    status, summary, detail = fn()\n    assert status == \"red\", (\n        \"REGRESSAO S287: framework major 2 vs SPEC v1 tem de dar red; \"\n        \"recebeu %r (%s) — a cura do PLAN-178 C3 foi revertida?\"\n        % (status, summary)\n    )\n    assert detail[\"repo_version\"] == \"2.0.0\"\n\n\ndef test_bug_178_spec_version_drift_green_on_match(tmp_path):\n    _seed_fw(tmp_path, \"1.3.0\")\n    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n    fn = _extract_spec_drift_fn(tmp_path)\n    status, _summary, detail = fn()\n    assert status == \"green\"\n    assert detail[\"spec_versions\"] == [\"v1\"]\n\n\ndef test_bug_178_spec_version_drift_yellow_on_garbage(tmp_path):\n    _seed_fw(tmp_path, \"not-a-version\")\n    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n    fn = _extract_spec_drift_fn(tmp_path)\n    status, _summary, _detail = fn()\n    assert status == \"yellow\"\n\n\ndef test_bug_178_adopter_own_version_never_reds(tmp_path):\n    \"\"\"codex Lote-A P2-1: adopter com VERSION proprio (app 2.0.0) e SEM\n    .framework-version atribuivel NAO pode dar red — o root VERSION\n    nao e do framework (ADR-155-AMEND-1 §2).\"\"\"\n    (tmp_path / \"VERSION\").write_text(\"2.0.0\\n\")  # versao do APP\n    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n    fn = _extract_spec_drift_fn(tmp_path)\n    status, summary, _detail = fn()\n    assert status == \"green\", (\n        \"false-red de adopter: %r (%s)\" % (status, summary)\n    )\n    assert \"not attributable\" in summary\n\n\ndef test_bug_178_adopter_with_framework_version_compares_it(tmp_path):\n    \"\"\"Adopter app 9.9.9 + .framework-version 1.3.0 + SPEC/v1 => green\n    (compara o FRAMEWORK, ignora o VERSION do app).\"\"\"\n    (tmp_path / \"VERSION\").write_text(\"9.9.9\\n\")\n    _seed_fw(tmp_path, \"1.3.0\")\n    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n    fn = _extract_spec_drift_fn(tmp_path)\n    status, _summary, detail = fn()\n    assert status == \"green\"\n    assert detail[\"repo_version\"] == \"1.3.0\"\n\n\ndef test_bug_178_unverified_marker_mismatch_is_yellow_not_red(tmp_path):\n    \"\"\"codex r2 P2-1 (ADR-155-AMEND-1 §5): marker SEM registro de\n    entrega e SEM git-tracking nao sustenta red — mismatch vira yellow\n    'drift suspected'.\"\"\"\n    _seed_fw(tmp_path, \"2.0.0\", delivered=False)\n    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n    fn = _extract_spec_drift_fn(tmp_path)\n    status, summary, detail = fn()\n    assert status == \"yellow\", (\n        \"marker nao-atribuivel deu %r (%s) — red exige proveniencia\"\n        % (status, summary)\n    )\n    assert \"suspected\" in summary\n    assert detail[\"provenance_verified\"] is False\n\n\ndef test_bug_178_delivered_marker_mismatch_is_red(tmp_path):\n    \"\"\"Com registro de entrega, o mesmo mismatch E red (o caminho red\n    continua alcancavel — a cura da vacuidade nao regrediu).\"\"\"\n    _seed_fw(tmp_path, \"2.0.0\", delivered=True)\n    (tmp_path / \"SPEC\" / \"v1\").mkdir(parents=True)\n    fn = _extract_spec_drift_fn(tmp_path)\n    status, _summary, detail = fn()\n    assert status == \"red\"\n    assert detail[\"provenance_verified\"] is True\n\n\ndef test_dead_symbol_lesson_render_safe_is_gone():\n    \"\"\"C4: o simbolo morto nao volta ao arquivo vivo (a referencia\n    correta e _validate_boot_lesson).\"\"\"\n    src = CEO_BOOT.read_text(encoding=\"utf-8\")\n    assert \"_lesson_render_safe\" not in src\n    assert \"_validate_boot_lesson\" in src\n","numLines":307,"startLine":1,"totalLines":307}},"tool_result_meta":[{"id":"toolu_017rdjFpgjVaupcJMDG2mXMa","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
