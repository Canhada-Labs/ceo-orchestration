{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DkNLemuc7Bwkf362XFaVFD","type":"tool_result","content":"1\t\"\"\"Extracted ceo-boot declarations executed by the facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t\n5\t\n6\tdef check_tier_a_spec_version_drift() -> Tuple[str, str, Any]:\n7\t    \"\"\"VERSION major vs latest SPEC/v* major agreement — red on drift.\n8\t\n9\t    Cured in PLAN-178 W-C Lote A (C3): the original body read both\n10\t    inputs and never compared them — every reachable path returned\n11\t    green (the S287-class \"registered-vacuous\" case documented in\n12\t    memory feedback-check-tier-a-spec-version-drift-vacuous and in the\n13\t    W0 coverage table). Invariant now enforced: the MAJOR of the\n14\t    FRAMEWORK version must equal the highest SPEC/v<N> directory major.\n15\t\n16\t    Ownership-aware source (codex Lote-A P2-1): the root ``VERSION``\n17\t    in an ADOPTER repo is the adopter app's version (ADR-155-AMEND-1\n18\t    §2) — comparing it to the shipped SPEC would false-red. The\n19\t    framework version is ``.claude/.framework-version`` (written by\n20\t    install/upgrade; present in the dogfood checkout too). Without\n21\t    that file no drift claim is possible — informational green, never\n22\t    red on unattributable input.\n23\t\n24\t    Provenance (codex r2 P2-1, ADR-155-AMEND-1 §5): existence is not\n25\t    authority. The marker only supports a RED verdict when its\n26\t    delivery is verifiable: (a) the baseline manifest\n27\t    ``.claude/.install-manifest.sha256`` carries a record for it\n28\t    (adopter install/upgrade path), or (b) the marker is git-tracked\n29\t    in this checkout (framework/dogfood path). Unverified marker +\n30\t    mismatch => yellow (drift SUSPECTED), never red — and never a\n31\t    silent green either.\n32\t    \"\"\"\n33\t    fw_file = REPO_ROOT / \".claude\" / \".framework-version\"\n34\t    if not fw_file.exists():\n35\t        return \"green\", \"no .framework-version (drift not attributable)\", None\n36\t    try:\n37\t        repo_v = fw_file.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n38\t    except OSError:\n39\t        return \"yellow\", \".framework-version unreadable\", None\n40\t    provenance_ok = False\n41\t    manifest = REPO_ROOT / \".claude\" / \".install-manifest.sha256\"\n42\t    try:\n43\t        if manifest.exists() and \".claude/.framework-version\" in manifest.read_text(\n44\t                encoding=\"utf-8\", errors=\"replace\"):\n45\t            provenance_ok = True\n46\t    except OSError:\n47\t        pass\n48\t    if not provenance_ok:\n49\t        try:\n50\t            provenance_ok = subprocess.run(\n51\t                [\"git\", \"-C\", str(REPO_ROOT), \"ls-files\", \"--error-unmatch\",\n52\t                 \".claude/.framework-version\"],\n53\t                capture_output=True, timeout=2,\n54\t            ).returncode == 0\n55\t        except (OSError, subprocess.SubprocessError):\n56\t            provenance_ok = False\n57\t    spec_root = REPO_ROOT / \"SPEC\"\n58\t    if not spec_root.exists():\n59\t        return \"green\", f\"repo {repo_v}, no SPEC dir\", repo_v\n60\t    spec_majors = []\n61\t    for p in spec_root.iterdir():\n62\t        if p.is_dir() and p.name.startswith(\"v\"):\n63\t            try:\n64\t                spec_majors.append(int(p.name[1:]))\n65\t            except ValueError:\n66\t                return \"yellow\", f\"unparseable SPEC dir {p.name}\", None\n67\t    if not spec_majors:\n68\t        return \"green\", f\"repo {repo_v}, no SPEC versions\", repo_v\n69\t    try:\n70\t        repo_major = int(repo_v.split(\".\", 1)[0])\n71\t    except ValueError:\n72\t        return \"yellow\", f\"unparseable .framework-version {repo_v}\", None\n73\t    latest_spec = max(spec_majors)\n74\t    detail = {\"repo_version\": repo_v,\n75\t              \"spec_versions\": [\"v%d\" % m for m in sorted(spec_majors)],\n76\t              \"provenance_verified\": provenance_ok}\n77\t    if repo_major != latest_spec:\n78\t        if provenance_ok:\n79\t            return \"red\", (\n80\t                f\"drift: framework major {repo_major} vs SPEC v{latest_spec}\"\n81\t            ), detail\n82\t        return \"yellow\", (\n83\t            f\"drift suspected: marker {repo_major} vs SPEC v{latest_spec} \"\n84\t            \"(provenance unverified — ADR-155-AMEND-1 §5)\"\n85\t        ), detail\n86\t    return \"green\", f\"framework {repo_v} ~ spec v{latest_spec}\", detail\n87\t\n88\t\n89\tdef check_tier_a_npm_version_match() -> Tuple[str, str, Any]:\n90\t    \"\"\"package.json version vs VERSION file (Codex S79 P1 finding).\"\"\"\n91\t    version_file = REPO_ROOT / \"VERSION\"\n92\t    pkg_file = REPO_ROOT / \"package.json\"\n93\t    if not version_file.exists() or not pkg_file.exists():\n94\t        return \"green\", \"no npm artifacts\", None\n95\t    try:\n96\t        repo_v = version_file.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n97\t        pkg = json.loads(pkg_file.read_text(encoding=\"utf-8\", errors=\"replace\"))\n98\t    except (OSError, json.JSONDecodeError):\n99\t        return \"yellow\", \"parse error\", None\n100\t    pkg_v = pkg.get(\"version\", \"\")\n101\t    if pkg_v == repo_v:\n102\t        return \"green\", f\"match {repo_v}\", {\"version\": repo_v}\n103\t    return \"red\", f\"drift: VERSION={repo_v} package.json={pkg_v}\", {\n104\t        \"repo_version\": repo_v, \"pkg_version\": pkg_v,\n105\t    }\n106\t\n107\t\n108\tdef check_tier_a_waivers_count() -> Tuple[str, str, Any]:\n109\t    \"\"\"Aggregate waivers/*.md count (rc-hold + cosmetic + audit).\"\"\"\n110\t    waivers_dir = REPO_ROOT / \"waivers\"\n111\t    if not waivers_dir.exists():\n112\t        return \"green\", \"no waivers dir\", 0\n113\t    waivers = list(waivers_dir.glob(\"*.md\"))\n114\t    n = len(waivers)\n115\t    status = \"yellow\" if n > 5 else \"green\"\n116\t    return status, f\"{n} waivers\", n\n117\t\n118\t\n119\t# CEO-INFORMATIONAL-ONLY: tracker de slots reservados, sem limiar (PLAN-178 C3)\n120\tdef check_tier_a_adrs_recent_status() -> Tuple[str, str, Any]:\n121\t    \"\"\"ADR-098..104 status tracker (PLAN-065 reserved slots — drift detector).\"\"\"\n122\t    adr_dir = REPO_ROOT / \".claude\" / \"adr\"\n123\t    statuses: Dict[str, str] = {}\n124\t    for adr_num in range(98, 105):\n125\t        matches = list(adr_dir.glob(f\"ADR-{adr_num:03d}-*.md\"))\n126\t        if not matches:\n127\t            statuses[f\"ADR-{adr_num:03d}\"] = \"missing\"\n128\t            continue\n129\t        try:\n130\t            text = matches[0].read_text(encoding=\"utf-8\", errors=\"replace\")\n131\t        except OSError:\n132\t            statuses[f\"ADR-{adr_num:03d}\"] = \"unreadable\"\n133\t            continue\n134\t        m = re.search(r\"^status:\\s*([a-zA-Z\\-]+)\\s*$\", text, re.MULTILINE)\n135\t        statuses[f\"ADR-{adr_num:03d}\"] = m.group(1).lower() if m else \"unknown\"\n136\t    accepted = sum(1 for v in statuses.values() if v == \"accepted\")\n137\t    return \"green\", f\"{accepted}/{len(statuses)} accepted\", statuses\n138\t\n139\t\n140\t# CEO-INFORMATIONAL-ONLY: auto-observacao de cache, sem limiar (PLAN-178 C3)\n141\tdef check_tier_a_cache_hit_rate_24h() -> Tuple[str, str, Any]:\n142\t    \"\"\"ceo_boot_emitted cache_hit ratio over 24h (self-observation).\"\"\"\n143\t    total = 0\n144\t    hits = 0\n145\t    for ev in _iter_audit_events_since(24):\n146\t        if ev.get(\"action\") != \"ceo_boot_emitted\":\n147\t            continue\n148\t        total += 1\n149\t        if ev.get(\"cache_hit\"):\n150\t            hits += 1\n151\t    if total == 0:\n152\t        return \"green\", \"no boots/24h\", 0\n153\t    ratio = hits / total\n154\t    return \"green\", f\"{hits}/{total} = {ratio:.0%} cache-hit\", {\n155\t        \"hits\": hits, \"total\": total, \"ratio\": ratio,\n156\t    }\n157\t\n158\t\n159\tdef check_tier_a_hook_test_baseline_age() -> Tuple[str, str, Any]:\n160\t    \"\"\"Age of cached hook-test baseline file (S81 cache convention).\"\"\"\n161\t    cache = REPO_ROOT / \".claude\" / \"cache\" / \"hook-tests.json\"\n162\t    if not cache.exists():\n163\t        return \"yellow\", \"no cached baseline\", None\n164\t    try:\n165\t        st = cache.stat()\n166\t    except OSError:\n167\t        return \"yellow\", \"stat failed\", None\n168\t    age_h = (time.time() - st.st_mtime) / 3600.0\n169\t    status = \"green\" if age_h < 168 else \"yellow\"  # 7d window\n170\t    return status, f\"{age_h:.1f}h old\", {\"age_hours\": age_h}\n171\t\n172\t\n173\tdef check_tier_a_sentinel_signers_tracked() -> Tuple[str, str, Any]:\n174\t    \"\"\"sentinel-signers.txt presence + git-tracked status.\"\"\"\n175\t    candidates = [\n176\t        REPO_ROOT / \".claude\" / \"state\" / \"sentinel-signers.txt\",\n177\t        REPO_ROOT / \"sentinel-signers.txt\",\n178\t    ]\n179\t    found: Optional[Path] = None\n180\t    for c in candidates:\n181\t        if c.exists():\n182\t            found = c\n183\t            break\n184\t    if found is None:\n185\t        return \"yellow\", \"sentinel-signers.txt missing\", None\n186\t    try:\n187\t        proc = subprocess.run(\n188\t            [\"git\", \"-C\", str(REPO_ROOT), \"ls-files\", \"--error-unmatch\", str(found.relative_to(REPO_ROOT))],\n189\t            capture_output=True, text=True, timeout=1.5,\n190\t        )\n191\t        tracked = (proc.returncode == 0)\n192\t    except (subprocess.TimeoutExpired, FileNotFoundError, ValueError):\n193\t        return \"yellow\", \"git unavailable\", None\n194\t    return (\"green\" if tracked else \"yellow\",\n195\t            f\"present, tracked={tracked}\",\n196\t            {\"path\": str(found.relative_to(REPO_ROOT)), \"tracked\": tracked})\n197\t\n198\t\n199\tdef check_tier_a_gitignore_state_excluded() -> Tuple[str, str, Any]:\n200\t    \"\"\".gitignore covers state/ dir (LRU cache + sentinels safety).\"\"\"\n201\t    gi = REPO_ROOT / \".gitignore\"\n202\t    if not gi.exists():\n203\t        return \"yellow\", \".gitignore missing\", None\n204\t    try:\n205\t        text = gi.read_text(encoding=\"utf-8\", errors=\"replace\")\n206\t    except OSError:\n207\t        return \"yellow\", \".gitignore unreadable\", None\n208\t    # Match leading patterns: state/, .claude/state/, /state, etc.\n209\t    has_state = bool(re.search(r\"(?m)^\\s*\\.?/?(?:\\.claude/)?state/\", text))\n210\t    return (\"green\" if has_state else \"yellow\",\n211\t            f\"state/ excluded={has_state}\",\n212\t            {\"covered\": has_state})\n213\t\n214\t\n215\tdef check_main_checkout_state() -> Tuple[str, str, Any]:\n216\t    \"\"\"Item 14 (c) of the 1.4.4 backlog: the main checkout off its default branch.\n217\t\n218\t    Twice in S363 an agent moved HEAD in the main checkout while the `main` ref and the\n219\t    tree stayed intact (`git switch -c` from a heredoc; a failed `cd` before `git\n220\t    checkout`), so nothing else showed it, and the risk is the Owner pulling and signing\n221\t    on the wrong branch. Yellow, never red: a branch can be on purpose, and only the\n222\t    reflog tells. A linked worktree is a shadow, so it is out of scope. Read-only.\n223\t    \"\"\"\n224\t    def _git(*args: str) -> \"subprocess.CompletedProcess[str]\":\n225\t        return subprocess.run([\"git\", \"-C\", str(REPO_ROOT)] + list(args),\n226\t                              capture_output=True, text=True, timeout=0.8, check=False)\n227\t\n228\t    try:\n229\t        dirs = _git(\"rev-parse\", \"--git-dir\", \"--git-common-dir\")\n230\t        if dirs.returncode != 0:\n231\t            return \"green\", \"not a git checkout\", None\n232\t        git_dir, common_dir = dirs.stdout.split(\"\\n\")[:2]\n233\t        if os.path.realpath(REPO_ROOT / git_dir) != os.path.realpath(REPO_ROOT / common_dir):\n234\t            return \"green\", \"linked worktree (out of scope)\", {\"linked_worktree\": True}\n235\t        head = _git(\"symbolic-ref\", \"-q\", \"HEAD\")\n236\t        origin = _git(\"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\")\n237\t    except (OSError, ValueError, subprocess.SubprocessError):\n238\t        return \"yellow\", \"git did not answer about the checkout\", None\n239\t    prefix = \"refs/remotes/origin/\"\n240\t    default = origin.stdout.strip()\n241\t    default = default[len(prefix):] if default.startswith(prefix) else \"main\"\n242\t    read_first = \"read `git reflog -n 20` before any work\"\n243\t    if head.returncode != 0:\n244\t        return \"yellow\", f\"main checkout has a DETACHED HEAD: {read_first}\", {\"detached\": True}\n245\t    branch = head.stdout.strip()\n246\t    branch = branch[len(\"refs/heads/\"):] if branch.startswith(\"refs/heads/\") else branch\n247\t    if branch != default:\n248\t        shown = branch if re.fullmatch(r\"[A-Za-z0-9._/-]{1,80}\", branch) else \"(unprintable)\"\n249\t        return (\"yellow\", f\"main checkout is on {shown}, not {default}: {read_first}\",\n250\t                {\"detached\": False, \"branch\": shown, \"default\": default})\n251\t    return \"green\", f\"main checkout on {default}\", {\"detached\": False, \"default\": default}\n252\t\n253\t\n254\t# PLAN-176 W3a — 11th Tier-A check, advisory + offline: per ACTIVE lane of the W0a\n255\t# detector (in-process; `--state --json` has no working set) the trio instalado /\n256\t# fixado (ADR-149) / upstream (W0b cache, READ, never fetched). Never red; failures\n257\t# and adopter trees (no ADR-149) degrade to «sem dado». The cache is EXTERNAL: bounded\n258\t# read, only grammar ids (<= SHOW_MAX) inside «externo, …», the rest only counted.\n259\t# W0b reader contract: {\"lanes\": {\"<lane>\": {\"models\": [ids]}}}; age = file mtime.\n260\t# Lane missing from the cache = «sem dado»; lane present but malformed = yellow.\n261\t_MC_ADR_REL = (\".claude\", \"adr\", \"ADR-149-model-id-allowlist.md\")\n262\t_MC_DETECTOR_REL = (\".claude\", \"scripts\", \"check-model-currency.py\")\n263\t_MC_EXPECTED_REL = (\".claude\", \"data\", \"model-currency-expected-reds.txt\")\n264\t_MC_CACHE_REL = (\".claude\", \"data\", \"model-currency-upstream-cache.json\")\n265\tMODEL_CURRENCY_CACHE_MAX_BYTES = 64 * 1024\n266\tMODEL_CURRENCY_SHOW_MAX_IDS = 3\n267\tMODEL_CURRENCY_STALE_HOURS = 96  # K-3 of PLAN-176 §4\n268\t_MC_ID_RE = re.compile(r\"[a-z0-9]+(?:[.-][a-z0-9]+){0,7}\\Z\")\n269\t_MC_NO_DATA = {\n270\t    \"absent\": \"sem dado (cache ausente; idade n/d)\",\n271\t    \"stale\": \"sem dado (cache com {age} > %d h)\" % MODEL_CURRENCY_STALE_HOURS,\n272\t    \"oversize\": \"sem dado (cache acima de %d bytes: leitura truncada, conteúdo \"\n273\t                \"descartado; idade {age})\" % MODEL_CURRENCY_CACHE_MAX_BYTES,\n274\t    \"malformed\": \"sem dado (cache malformado; idade {age})\",\n275\t    \"no_lane\": \"sem dado (cache sem a raia; idade {age})\",\n276\t}\n277\t\n278\t\n279\tdef _mc_id_ok(value: Any) -> bool:\n280\t    return isinstance(value, str) and len(value) <= 48 and bool(_MC_ID_RE.match(value))\n281\t\n282\t\n283\tdef _mc_lane(det: Any, model_id: str) -> Optional[str]:\n284\t    try:\n285\t        return det.family_of(model_id)[0]\n286\t    except Exception:  # noqa: BLE001 — unmodelled family = no lane\n287\t        return None\n288\t\n289\t\n290\tdef _mc_read_upstream(root: Path) -> Dict[str, Any]:\n291\t    import stat as _stat\n292\t    path = root.joinpath(*_MC_CACHE_REL)\n293\t    try:\n294\t        st = os.stat(path)\n295\t    except OSError:\n296\t        return {\"state\": \"absent\", \"age\": \"n/d\"}\n297\t    age_h = max(0.0, time.time() - st.st_mtime) / 3600.0\n298\t    out: Dict[str, Any] = {\"state\": \"malformed\", \"age\": \"%.1f h\" % age_h}\n299\t    if age_h > MODEL_CURRENCY_STALE_HOURS:\n300\t        out[\"state\"] = \"stale\"\n301\t    elif _stat.S_ISREG(st.st_mode):  # a FIFO would block the boot on open()\n302\t        try:\n303\t            with open(path, \"rb\") as fh:\n304\t                raw = fh.read(MODEL_CURRENCY_CACHE_MAX_BYTES + 1)\n305\t            if len(raw) > MODEL_CURRENCY_CACHE_MAX_BYTES:\n306\t                out[\"state\"] = \"oversize\"\n307\t            else:\n308\t                lanes = json.loads(raw.decode(\"utf-8\")).get(\"lanes\")\n309\t                if isinstance(lanes, dict):\n310\t                    out.update(state=\"ok\", lanes=lanes)\n311\t        except (OSError, UnicodeDecodeError, ValueError, AttributeError):\n312\t            pass\n313\t    return out\n314\t\n315\t\n316\tdef _mc_upstream_cell(det: Any, up: Dict[str, Any], lane: str,\n317\t                      pinned: List[str]) -> Tuple[str, List[str], str]:\n318\t    entry = (up.get(\"lanes\") or {}).get(lane)\n319\t    models = entry.get(\"models\") if isinstance(entry, dict) else None\n320\t    key = up[\"state\"]\n321\t    if key == \"ok\" and not isinstance(models, list):\n322\t        key = \"malformed\" if lane in up[\"lanes\"] else \"no_lane\"\n323\t    if key != \"ok\":\n324\t        return _MC_NO_DATA[key].format(age=up[\"age\"]), [], key\n325\t    valid = [m for m in models if _mc_id_ok(m) and _mc_lane(det, m) == lane]\n326\t    unique = list(dict.fromkeys(valid))\n327\t    novel = [m for m in unique if m not in pinned]\n328\t    shown = novel[:MODEL_CURRENCY_SHOW_MAX_IDS]\n329\t    more = \" (+%d truncados)\" % (len(novel) - len(shown)) if novel[len(shown):] else \"\"\n330\t    return (\"«externo, %s: %d ids; fora do fixado: %s%s; descartados=%d»\" % (\n331\t        up[\"age\"], len(unique), \", \".join(shown) or \"nenhum\", more,\n332\t        len(models) - len(valid))), novel, key\n333\t\n334\t\n335\tdef _mc_trio(root: Path) -> Tuple[str, str, Any]:\n336\t    try:\n337\t        settings = json.loads(root.joinpath(\".claude\", \"settings.json\").read_text(\n338\t            encoding=\"utf-8\"))\n339\t    except (OSError, ValueError):\n340\t        settings = {}\n341\t    settings = settings if isinstance(settings, dict) else {}\n342\t    raw = settings.get(\"model\")\n343\t    installed = raw if _mc_id_ok(raw) else None\n344\t    inst = installed or (\"sem dado\" if raw is None else \"valor não reconhecido\")\n345\t    det_path = root.joinpath(*_MC_DETECTOR_REL)\n346\t    if not root.joinpath(*_MC_ADR_REL).is_file() or not det_path.is_file():\n347\t        why = (\"ADR-149 ausente — árvore de adopter\"\n348\t               if not root.joinpath(*_MC_ADR_REL).is_file() else \"detector ausente\")\n349\t        return \"green\", \"model-currency: sem dado (%s); instalado=%s\" % (why, inst), None\n350\t    import importlib.util\n351\t    spec = importlib.util.spec_from_file_location(\"_ceo_boot_mc_detector\", str(det_path))\n352\t    det = importlib.util.module_from_spec(spec)\n353\t    spec.loader.exec_module(det)  # type: ignore[union-attr]\n354\t    try:\n355\t        report = det.scan(root, det.build_parser().parse_args([]))\n356\t        exp = root.joinpath(*_MC_EXPECTED_REL)\n357\t        drift = (det.compare_reds(report[\"red_ids\"], det.read_expected_reds(exp))\n358\t                 if exp.is_file() else None)\n359\t    except det.DetectorBroke as exc:\n360\t        why = _sanitize_for_recs(str(exc)).replace(\"|\", \"/\")[:120]\n361\t        return \"yellow\", \"model-currency: sem dado (detector recusou: %s)\" % why, None\n362\t    pinned_all = list(report[\"authorities\"][\"working_set\"])\n363\t    up = _mc_read_upstream(root)\n364\t    cells: List[str] = []\n365\t    lanes: Dict[str, Any] = {}\n366\t    for lane in report[\"active_lanes\"]:\n367\t        pinned = [m for m in pinned_all if _mc_lane(det, m) == lane]\n368\t        mine = installed if installed and _mc_lane(det, installed) == lane else None\n369\t        member = \"\" if mine is None else (\n370\t            \" (instalado ∈ fixado)\" if mine in pinned else \" (instalado FORA do fixado)\")\n371\t        cell, novel, key = _mc_upstream_cell(det, up, lane, pinned)\n372\t        cells.append(\"%s: instalado=%s · fixado=%d ids%s · upstream=%s\" % (\n373\t            lane, mine or \"nenhum nesta raia\", len(pinned), member, cell))\n374\t        lanes[lane] = {\"installed\": mine, \"novel\": novel[:MODEL_CURRENCY_SHOW_MAX_IDS],\n375\t                       \"upstream\": key}\n376\t    n_red = len(report[\"red_ids\"])\n377\t    reds = (\"vermelhos=%d (sem conjunto esperado)\" % n_red if drift is None else\n378\t            \"vermelhos=%d (fora do esperado: +%d/-%d)\" % (n_red, len(drift[0]), len(drift[1]))\n379\t            if drift[0] or drift[1] else \"vermelhos=%d (= esperado)\" % n_red)\n380\t    summary = \"model-currency: %s · availableModels %s · %s\" % (\n381\t        \" ; \".join(cells), \"= fixado\" if settings.get(\"availableModels\") == pinned_all\n382\t        else \"≠ fixado\", reds)\n383\t    detail = {\"lanes\": lanes, \"upstream\": up[\"state\"]}\n384\t    if (any(v[\"novel\"] or v[\"upstream\"] in (\"oversize\", \"malformed\") for v in lanes.values())\n385\t            or (drift is not None and (drift[0] or drift[1]))):\n386\t        return \"yellow\", summary, detail\n387\t    return \"green\", summary, detail\n388\t\n389\t\n390\tdef check_tier_a_model_currency() -> Tuple[str, str, Any]:\n391\t    \"\"\"PLAN-176 W3a advisory — never red, never raises (see block comment).\"\"\"\n392\t    try:\n393\t        return _mc_trio(REPO_ROOT)\n394\t    except Exception as exc:  # noqa: BLE001 — advisory floor: degrade, never break\n395\t        return \"yellow\", \"model-currency: sem dado (advisory falhou: %s)\" % (\n396\t            type(exc).__name__), None\n397\t\n398\t\n399\t# ---- Registry --------------------------------------------------------------\n400\t\n401\t\n402\tdef check_tier_policy_misrouting_24h() -> Tuple[str, str, Any]:\n403\t    \"\"\"16th Tier-S check — delegates to standalone hook module (PLAN-091 W2.1).\n404\t\n405\t    Lazy-imports ``.claude/hooks/check_tier_policy_misrouting_24h.py`` so\n406\t    that the standalone module can also be invoked as a CLI smoke-test\n407\t    (``python3 .claude/hooks/check_tier_policy_misrouting_24h.py``).\n408\t    Any import-time failure surfaces as a `yellow` status (fail-soft\n409\t    Tier-S contract); the dispatcher's outer try/except still wraps the\n410\t    inner call for additional defense-in-depth.\n411\t    \"\"\"\n412\t    try:\n413\t        hooks_dir = REPO_ROOT / \".claude\" / \"hooks\"\n414\t        if str(hooks_dir) not in sys.path:\n415\t            sys.path.insert(0, str(hooks_dir))\n416\t        from check_tier_policy_misrouting_24h import (  # type: ignore\n417\t            check_tier_policy_misrouting_24h as _impl,\n418\t        )\n419\t        return _impl()\n420\t    except Exception as exc:  # noqa: BLE001 (Tier-S fail-soft floor)\n421\t        return \"yellow\", f\"tier_policy_misrouting import error: {exc}\", None\n422\t\n423\t\n424\tdef check_cache_discipline_alerted() -> Tuple[str, str, Any]:\n425\t    \"\"\"17th Tier-S check — prompt-cache coverage detection (PLAN-093 Wave C.2).\n426\t\n427\t    Surfaces ``cache_discipline_alerted`` when prompt-cache coverage falls\n428\t    below 0.7 over the last 24h of audit-log events. Detection is heuristic:\n429\t    any audit row (``agent_spawn`` action) carrying a ``cache_coverage_bps``\n430\t    numeric field is averaged; rows without the field are ignored. Absent\n431\t    any datapoints, status is green with a \"no data\" summary (fail-soft\n432\t    Tier-S contract).\n433\t\n434\t    Field alignment (F-5-5.1-0624274e fix): audit_log.py emits the\n435\t    cache-coverage metric derived from usage_metadata cache_read /\n436\t    (cache_read + cache_creation + uncached); older code read the\n437\t    non-existent ``cache_hit_rate`` field, causing the gate to always\n438\t    return green/\"no data\". This fix aligns the reader to the emitted field.\n439\t    PLAN-118 WS-E (S181): the emitted field is now ``cache_coverage_bps``\n440\t    (integer basis-points); this reader reads it (÷10000) and falls back to\n441\t    the legacy ``cache_coverage`` float for events emitted before the fix.\n442\t\n443\t    Emits ``cache_discipline_alerted`` via ``emit_generic`` on yellow/red\n444\t    so downstream analytics can correlate with /ceo-boot runs. Action\n445\t    name is registered at ``audit_emit.py:440`` (PLAN-088 canonical).\n446\t    \"\"\"\n447\t    threshold = 0.70\n448\t    try:\n449\t        rates: List[float] = []\n450\t        for ev in _iter_audit_events_since(hours=24.0):\n451\t            # S239: skip synthetic governance-probe / benchmark spawns — they\n452\t            # carry cache_coverage_bps=0 by construction (no real cached LLM\n453\t            # call), so a probe-only 24h window would pin this gate to red (FP).\n454\t            if _is_test_pollution_event(ev):\n455\t                continue\n456\t            # PLAN-118 WS-E (S181): primary field is now ``cache_coverage_bps``\n457\t            # (integer basis-points, ratio × 10000) — the legacy float\n458\t            # ``cache_coverage`` was dropped because it broke the HMAC chain.\n459\t            # Read bps first, fall back to the legacy float for events emitted\n460\t            # before the fix (the 24h window straddles the transition; without\n461\t            # the fallback this Tier-S gate would go silently dead again —\n462\t            # the exact F-5-5.1-0624274e failure mode this check exists to avoid).\n463\t            v_bps = ev.get(\"cache_coverage_bps\")\n464\t            if isinstance(v_bps, int) and not isinstance(v_bps, bool) and 0 <= v_bps <= 10000:\n465\t                rates.append(v_bps / 10000.0)\n466\t                continue\n467\t            # F-5-5.1-0624274e: legacy float field (pre-PLAN-118 events).\n468\t            v = ev.get(\"cache_coverage\")\n469\t            if isinstance(v, (int, float)) and not isinstance(v, bool) and 0.0 <= float(v) <= 1.0:\n470\t                rates.append(float(v))\n471\t        if not rates:\n472\t            return \"green\", \"no cache_coverage datapoints\", {\"samples\": 0}\n473\t        avg = sum(rates) / len(rates)\n474\t        if avg < threshold:\n475\t            try:\n476\t                if _audit_emit is not None and hasattr(\n477\t                    _audit_emit, \"emit_cache_discipline_alerted\"\n478\t                ):\n479\t                    _audit_emit.emit_cache_discipline_alerted(\n480\t                        hit_rate_basis_points=max(\n481\t                            0, min(1000, int(round(avg * 1000)))\n482\t                        ),\n483\t                        floor_basis_points=max(\n484\t                            0, min(1000, int(round(threshold * 1000)))\n485\t                        ),\n486\t                        session_count_24h=len(rates),\n487\t                        below_floor=True,\n488\t                        opted_out=False,\n489\t                    )\n490\t            except Exception:  # noqa: BLE001 (Tier-S fail-soft)\n491\t                pass\n492\t            return \"red\", f\"cache_coverage {avg:.2f} < {threshold}\", {\n493\t                \"avg_rate\": avg,\n494\t                \"samples\": len(rates),\n495\t            }\n496\t        return \"green\", f\"cache_coverage {avg:.2f} ok\", {\n497\t            \"avg_rate\": avg,\n498\t            \"samples\": len(rates),\n499\t        }\n500\t    except Exception as exc:  # noqa: BLE001 (Tier-S fail-soft)\n501\t        return \"yellow\", f\"cache_discipline_alerted error: {exc}\", None\n502\t\n503\t\n504\t# PLAN-093 Wave C.5/C.6 canonical persona × task matrix.\n505\t#\n506\t# S127 cadence-amendment (Codex R2 thread `019e33a3` AMEND verdict\n507\t# `PHASE-1+2-WITH-(c)`): the 4×4 matrix is demoted from gate-eligible to\n508\t# permanent observability. RED authority moves to a future event-driven\n509\t# demand ledger (`PLAN-104-persona-demand-ledger`); see\n510\t# `PLAN-093-FOLLOWUP-cadence-amendment.md` for the full doctrine record.\n511\t_VETO_FLOOR_PERSONAS = (\n512\t    \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n513\t    \"threat-detection-engineer\",\n514\t)\n515\t_PERSONA_TASK_TYPES = (\"review\", \"vet\", \"test\", \"detect\")\n516\t_VETO_FLOOR_PERSONAS_LOWER = frozenset(p.lower() for p in _VETO_FLOOR_PERSONAS)\n517\t\n518\t# PLAN-112-FOLLOWUP-persona-routing-wire W4 — F-5.4-tasktype-pollution.\n519\t# `_score_persona_coverage` previously counted task_type from ANY audit\n520\t# event whose archetype matched a VETO-floor persona. Unrelated emitters\n521\t# (notably `model_routing_advised`, which carries archetype + a bogus\n522\t# task_type like `frontmatter`/`M`) inflated the denominator + skewed cells.\n523\t# Restrict contributing events to the GENUINE persona-dispatch actions:\n524\t#   - `persona_coverage_synthesized` (SPEC/v1/audit-log.schema.md:319 —\n525\t#     carries `archetype` + `task_type`, the only fields the scorer reads)\n526\t#   - `persona_demand_*` (the persona-demand ledger family; PLAN-104)\n527\t# NOTE: `persona_dispatch` does NOT exist and must not be referenced.\n528\t_PERSONA_DISPATCH_ACTION_PREFIXES = (\"persona_demand_\",)\n529\t_PERSONA_DISPATCH_ACTIONS = frozenset({\"persona_coverage_synthesized\"})\n530\t\n531\t\n532\tdef _is_persona_dispatch_event(ev: Dict[str, Any]) -> bool:\n533\t    \"\"\"True iff `ev` is a genuine persona-dispatch event (F-5.4 filter).\n534\t\n535\t    Defensive: a missing/non-str `action` -> False (excluded).\n536\t    \"\"\"\n537\t    action = ev.get(\"action\")\n538\t    if not isinstance(action, str):\n539\t        return False\n540\t    if action in _PERSONA_DISPATCH_ACTIONS:\n541\t        return True\n542\t    return any(action.startswith(p) for p in _PERSONA_DISPATCH_ACTION_PREFIXES)\n543\t\n544\t\n545\tdef _normalize_persona_role(ev: Dict[str, Any]) -> str:\n546\t    \"\"\"Case-folded canonical role extracted from any audit_log emission surface.\n547\t\n548\t    PLAN-093 Wave C.5 originally read only ``archetype`` / ``persona``. Codex\n549\t    R2 thread `019e33a3` AMEND #4: audit-log events emitted from\n550\t    ``audit_log.py`` carry the role on ``subagent_type`` (canonical) and\n551\t    ``dispatch_archetype_hint`` (resolved-from-prompt) — narrow read missed\n552\t    those surfaces. First non-empty match wins, case-folded.\n553\t    \"\"\"\n554\t    for field in (\"archetype\", \"persona\", \"subagent_type\",\n555\t                  \"dispatch_archetype_hint\"):\n556\t        val = ev.get(field)\n557\t        if isinstance(val, str) and val.strip():\n558\t            return val.strip().lower()\n559\t    return \"\"\n560\t"}]},"parent_tool_use_id":null,"session_id":"c17c3a51-6084-4d41-893b-9946240d9b73","uuid":"f7bd4247-f207-4600-86a6-c4564d03d528","timestamp":"2026-11-13T18:19:27.153Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_ceo_boot_parts/model_persona.py","content":"\"\"\"Extracted ceo-boot declarations executed by the facade.\"\"\"\nfrom __future__ import annotations\n\n\n\ndef check_tier_a_spec_version_drift() -> Tuple[str, str, Any]:\n    \"\"\"VERSION major vs latest SPEC/v* major agreement — red on drift.\n\n    Cured in PLAN-178 W-C Lote A (C3): the original body read both\n    inputs and never compared them — every reachable path returned\n    green (the S287-class \"registered-vacuous\" case documented in\n    memory feedback-check-tier-a-spec-version-drift-vacuous and in the\n    W0 coverage table). Invariant now enforced: the MAJOR of the\n    FRAMEWORK version must equal the highest SPEC/v<N> directory major.\n\n    Ownership-aware source (codex Lote-A P2-1): the root ``VERSION``\n    in an ADOPTER repo is the adopter app's version (ADR-155-AMEND-1\n    §2) — comparing it to the shipped SPEC would false-red. The\n    framework version is ``.claude/.framework-version`` (written by\n    install/upgrade; present in the dogfood checkout too). Without\n    that file no drift claim is possible — informational green, never\n    red on unattributable input.\n\n    Provenance (codex r2 P2-1, ADR-155-AMEND-1 §5): existence is not\n    authority. The marker only supports a RED verdict when its\n    delivery is verifiable: (a) the baseline manifest\n    ``.claude/.install-manifest.sha256`` carries a record for it\n    (adopter install/upgrade path), or (b) the marker is git-tracked\n    in this checkout (framework/dogfood path). Unverified marker +\n    mismatch => yellow (drift SUSPECTED), never red — and never a\n    silent green either.\n    \"\"\"\n    fw_file = REPO_ROOT / \".claude\" / \".framework-version\"\n    if not fw_file.exists():\n        return \"green\", \"no .framework-version (drift not attributable)\", None\n    try:\n        repo_v = fw_file.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n    except OSError:\n        return \"yellow\", \".framework-version unreadable\", None\n    provenance_ok = False\n    manifest = REPO_ROOT / \".claude\" / \".install-manifest.sha256\"\n    try:\n        if manifest.exists() and \".claude/.framework-version\" in manifest.read_text(\n                encoding=\"utf-8\", errors=\"replace\"):\n            provenance_ok = True\n    except OSError:\n        pass\n    if not provenance_ok:\n        try:\n            provenance_ok = subprocess.run(\n                [\"git\", \"-C\", str(REPO_ROOT), \"ls-files\", \"--error-unmatch\",\n                 \".claude/.framework-version\"],\n                capture_output=True, timeout=2,\n            ).returncode == 0\n        except (OSError, subprocess.SubprocessError):\n            provenance_ok = False\n    spec_root = REPO_ROOT / \"SPEC\"\n    if not spec_root.exists():\n        return \"green\", f\"repo {repo_v}, no SPEC dir\", repo_v\n    spec_majors = []\n    for p in spec_root.iterdir():\n        if p.is_dir() and p.name.startswith(\"v\"):\n            try:\n                spec_majors.append(int(p.name[1:]))\n            except ValueError:\n                return \"yellow\", f\"unparseable SPEC dir {p.name}\", None\n    if not spec_majors:\n        return \"green\", f\"repo {repo_v}, no SPEC versions\", repo_v\n    try:\n        repo_major = int(repo_v.split(\".\", 1)[0])\n    except ValueError:\n        return \"yellow\", f\"unparseable .framework-version {repo_v}\", None\n    latest_spec = max(spec_majors)\n    detail = {\"repo_version\": repo_v,\n              \"spec_versions\": [\"v%d\" % m for m in sorted(spec_majors)],\n              \"provenance_verified\": provenance_ok}\n    if repo_major != latest_spec:\n        if provenance_ok:\n            return \"red\", (\n                f\"drift: framework major {repo_major} vs SPEC v{latest_spec}\"\n            ), detail\n        return \"yellow\", (\n            f\"drift suspected: marker {repo_major} vs SPEC v{latest_spec} \"\n            \"(provenance unverified — ADR-155-AMEND-1 §5)\"\n        ), detail\n    return \"green\", f\"framework {repo_v} ~ spec v{latest_spec}\", detail\n\n\ndef check_tier_a_npm_version_match() -> Tuple[str, str, Any]:\n    \"\"\"package.json version vs VERSION file (Codex S79 P1 finding).\"\"\"\n    version_file = REPO_ROOT / \"VERSION\"\n    pkg_file = REPO_ROOT / \"package.json\"\n    if not version_file.exists() or not pkg_file.exists():\n        return \"green\", \"no npm artifacts\", None\n    try:\n        repo_v = version_file.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n        pkg = json.loads(pkg_file.read_text(encoding=\"utf-8\", errors=\"replace\"))\n    except (OSError, json.JSONDecodeError):\n        return \"yellow\", \"parse error\", None\n    pkg_v = pkg.get(\"version\", \"\")\n    if pkg_v == repo_v:\n        return \"green\", f\"match {repo_v}\", {\"version\": repo_v}\n    return \"red\", f\"drift: VERSION={repo_v} package.json={pkg_v}\", {\n        \"repo_version\": repo_v, \"pkg_version\": pkg_v,\n    }\n\n\ndef check_tier_a_waivers_count() -> Tuple[str, str, Any]:\n    \"\"\"Aggregate waivers/*.md count (rc-hold + cosmetic + audit).\"\"\"\n    waivers_dir = REPO_ROOT / \"waivers\"\n    if not waivers_dir.exists():\n        return \"green\", \"no waivers dir\", 0\n    waivers = list(waivers_dir.glob(\"*.md\"))\n    n = len(waivers)\n    status = \"yellow\" if n > 5 else \"green\"\n    return status, f\"{n} waivers\", n\n\n\n# CEO-INFORMATIONAL-ONLY: tracker de slots reservados, sem limiar (PLAN-178 C3)\ndef check_tier_a_adrs_recent_status() -> Tuple[str, str, Any]:\n    \"\"\"ADR-098..104 status tracker (PLAN-065 reserved slots — drift detector).\"\"\"\n    adr_dir = REPO_ROOT / \".claude\" / \"adr\"\n    statuses: Dict[str, str] = {}\n    for adr_num in range(98, 105):\n        matches = list(adr_dir.glob(f\"ADR-{adr_num:03d}-*.md\"))\n        if not matches:\n            statuses[f\"ADR-{adr_num:03d}\"] = \"missing\"\n            continue\n        try:\n            text = matches[0].read_text(encoding=\"utf-8\", errors=\"replace\")\n        except OSError:\n            statuses[f\"ADR-{adr_num:03d}\"] = \"unreadable\"\n            continue\n        m = re.search(r\"^status:\\s*([a-zA-Z\\-]+)\\s*$\", text, re.MULTILINE)\n        statuses[f\"ADR-{adr_num:03d}\"] = m.group(1).lower() if m else \"unknown\"\n    accepted = sum(1 for v in statuses.values() if v == \"accepted\")\n    return \"green\", f\"{accepted}/{len(statuses)} accepted\", statuses\n\n\n# CEO-INFORMATIONAL-ONLY: auto-observacao de cache, sem limiar (PLAN-178 C3)\ndef check_tier_a_cache_hit_rate_24h() -> Tuple[str, str, Any]:\n    \"\"\"ceo_boot_emitted cache_hit ratio over 24h (self-observation).\"\"\"\n    total = 0\n    hits = 0\n    for ev in _iter_audit_events_since(24):\n        if ev.get(\"action\") != \"ceo_boot_emitted\":\n            continue\n        total += 1\n        if ev.get(\"cache_hit\"):\n            hits += 1\n    if total == 0:\n        return \"green\", \"no boots/24h\", 0\n    ratio = hits / total\n    return \"green\", f\"{hits}/{total} = {ratio:.0%} cache-hit\", {\n        \"hits\": hits, \"total\": total, \"ratio\": ratio,\n    }\n\n\ndef check_tier_a_hook_test_baseline_age() -> Tuple[str, str, Any]:\n    \"\"\"Age of cached hook-test baseline file (S81 cache convention).\"\"\"\n    cache = REPO_ROOT / \".claude\" / \"cache\" / \"hook-tests.json\"\n    if not cache.exists():\n        return \"yellow\", \"no cached baseline\", None\n    try:\n        st = cache.stat()\n    except OSError:\n        return \"yellow\", \"stat failed\", None\n    age_h = (time.time() - st.st_mtime) / 3600.0\n    status = \"green\" if age_h < 168 else \"yellow\"  # 7d window\n    return status, f\"{age_h:.1f}h old\", {\"age_hours\": age_h}\n\n\ndef check_tier_a_sentinel_signers_tracked() -> Tuple[str, str, Any]:\n    \"\"\"sentinel-signers.txt presence + git-tracked status.\"\"\"\n    candidates = [\n        REPO_ROOT / \".claude\" / \"state\" / \"sentinel-signers.txt\",\n        REPO_ROOT / \"sentinel-signers.txt\",\n    ]\n    found: Optional[Path] = None\n    for c in candidates:\n        if c.exists():\n            found = c\n            break\n    if found is None:\n        return \"yellow\", \"sentinel-signers.txt missing\", None\n    try:\n        proc = subprocess.run(\n            [\"git\", \"-C\", str(REPO_ROOT), \"ls-files\", \"--error-unmatch\", str(found.relative_to(REPO_ROOT))],\n            capture_output=True, text=True, timeout=1.5,\n        )\n        tracked = (proc.returncode == 0)\n    except (subprocess.TimeoutExpired, FileNotFoundError, ValueError):\n        return \"yellow\", \"git unavailable\", None\n    return (\"green\" if tracked else \"yellow\",\n            f\"present, tracked={tracked}\",\n            {\"path\": str(found.relative_to(REPO_ROOT)), \"tracked\": tracked})\n\n\ndef check_tier_a_gitignore_state_excluded() -> Tuple[str, str, Any]:\n    \"\"\".gitignore covers state/ dir (LRU cache + sentinels safety).\"\"\"\n    gi = REPO_ROOT / \".gitignore\"\n    if not gi.exists():\n        return \"yellow\", \".gitignore missing\", None\n    try:\n        text = gi.read_text(encoding=\"utf-8\", errors=\"replace\")\n    except OSError:\n        return \"yellow\", \".gitignore unreadable\", None\n    # Match leading patterns: state/, .claude/state/, /state, etc.\n    has_state = bool(re.search(r\"(?m)^\\s*\\.?/?(?:\\.claude/)?state/\", text))\n    return (\"green\" if has_state else \"yellow\",\n            f\"state/ excluded={has_state}\",\n            {\"covered\": has_state})\n\n\ndef check_main_checkout_state() -> Tuple[str, str, Any]:\n    \"\"\"Item 14 (c) of the 1.4.4 backlog: the main checkout off its default branch.\n\n    Twice in S363 an agent moved HEAD in the main checkout while the `main` ref and the\n    tree stayed intact (`git switch -c` from a heredoc; a failed `cd` before `git\n    checkout`), so nothing else showed it, and the risk is the Owner pulling and signing\n    on the wrong branch. Yellow, never red: a branch can be on purpose, and only the\n    reflog tells. A linked worktree is a shadow, so it is out of scope. Read-only.\n    \"\"\"\n    def _git(*args: str) -> \"subprocess.CompletedProcess[str]\":\n        return subprocess.run([\"git\", \"-C\", str(REPO_ROOT)] + list(args),\n                              capture_output=True, text=True, timeout=0.8, check=False)\n\n    try:\n        dirs = _git(\"rev-parse\", \"--git-dir\", \"--git-common-dir\")\n        if dirs.returncode != 0:\n            return \"green\", \"not a git checkout\", None\n        git_dir, common_dir = dirs.stdout.split(\"\\n\")[:2]\n        if os.path.realpath(REPO_ROOT / git_dir) != os.path.realpath(REPO_ROOT / common_dir):\n            return \"green\", \"linked worktree (out of scope)\", {\"linked_worktree\": True}\n        head = _git(\"symbolic-ref\", \"-q\", \"HEAD\")\n        origin = _git(\"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\")\n    except (OSError, ValueError, subprocess.SubprocessError):\n        return \"yellow\", \"git did not answer about the checkout\", None\n    prefix = \"refs/remotes/origin/\"\n    default = origin.stdout.strip()\n    default = default[len(prefix):] if default.startswith(prefix) else \"main\"\n    read_first = \"read `git reflog -n 20` before any work\"\n    if head.returncode != 0:\n        return \"yellow\", f\"main checkout has a DETACHED HEAD: {read_first}\", {\"detached\": True}\n    branch = head.stdout.strip()\n    branch = branch[len(\"refs/heads/\"):] if branch.startswith(\"refs/heads/\") else branch\n    if branch != default:\n        shown = branch if re.fullmatch(r\"[A-Za-z0-9._/-]{1,80}\", branch) else \"(unprintable)\"\n        return (\"yellow\", f\"main checkout is on {shown}, not {default}: {read_first}\",\n                {\"detached\": False, \"branch\": shown, \"default\": default})\n    return \"green\", f\"main checkout on {default}\", {\"detached\": False, \"default\": default}\n\n\n# PLAN-176 W3a — 11th Tier-A check, advisory + offline: per ACTIVE lane of the W0a\n# detector (in-process; `--state --json` has no working set) the trio instalado /\n# fixado (ADR-149) / upstream (W0b cache, READ, never fetched). Never red; failures\n# and adopter trees (no ADR-149) degrade to «sem dado». The cache is EXTERNAL: bounded\n# read, only grammar ids (<= SHOW_MAX) inside «externo, …», the rest only counted.\n# W0b reader contract: {\"lanes\": {\"<lane>\": {\"models\": [ids]}}}; age = file mtime.\n# Lane missing from the cache = «sem dado»; lane present but malformed = yellow.\n_MC_ADR_REL = (\".claude\", \"adr\", \"ADR-149-model-id-allowlist.md\")\n_MC_DETECTOR_REL = (\".claude\", \"scripts\", \"check-model-currency.py\")\n_MC_EXPECTED_REL = (\".claude\", \"data\", \"model-currency-expected-reds.txt\")\n_MC_CACHE_REL = (\".claude\", \"data\", \"model-currency-upstream-cache.json\")\nMODEL_CURRENCY_CACHE_MAX_BYTES = 64 * 1024\nMODEL_CURRENCY_SHOW_MAX_IDS = 3\nMODEL_CURRENCY_STALE_HOURS = 96  # K-3 of PLAN-176 §4\n_MC_ID_RE = re.compile(r\"[a-z0-9]+(?:[.-][a-z0-9]+){0,7}\\Z\")\n_MC_NO_DATA = {\n    \"absent\": \"sem dado (cache ausente; idade n/d)\",\n    \"stale\": \"sem dado (cache com {age} > %d h)\" % MODEL_CURRENCY_STALE_HOURS,\n    \"oversize\": \"sem dado (cache acima de %d bytes: leitura truncada, conteúdo \"\n                \"descartado; idade {age})\" % MODEL_CURRENCY_CACHE_MAX_BYTES,\n    \"malformed\": \"sem dado (cache malformado; idade {age})\",\n    \"no_lane\": \"sem dado (cache sem a raia; idade {age})\",\n}\n\n\ndef _mc_id_ok(value: Any) -> bool:\n    return isinstance(value, str) and len(value) <= 48 and bool(_MC_ID_RE.match(value))\n\n\ndef _mc_lane(det: Any, model_id: str) -> Optional[str]:\n    try:\n        return det.family_of(model_id)[0]\n    except Exception:  # noqa: BLE001 — unmodelled family = no lane\n        return None\n\n\ndef _mc_read_upstream(root: Path) -> Dict[str, Any]:\n    import stat as _stat\n    path = root.joinpath(*_MC_CACHE_REL)\n    try:\n        st = os.stat(path)\n    except OSError:\n        return {\"state\": \"absent\", \"age\": \"n/d\"}\n    age_h = max(0.0, time.time() - st.st_mtime) / 3600.0\n    out: Dict[str, Any] = {\"state\": \"malformed\", \"age\": \"%.1f h\" % age_h}\n    if age_h > MODEL_CURRENCY_STALE_HOURS:\n        out[\"state\"] = \"stale\"\n    elif _stat.S_ISREG(st.st_mode):  # a FIFO would block the boot on open()\n        try:\n            with open(path, \"rb\") as fh:\n                raw = fh.read(MODEL_CURRENCY_CACHE_MAX_BYTES + 1)\n            if len(raw) > MODEL_CURRENCY_CACHE_MAX_BYTES:\n                out[\"state\"] = \"oversize\"\n            else:\n                lanes = json.loads(raw.decode(\"utf-8\")).get(\"lanes\")\n                if isinstance(lanes, dict):\n                    out.update(state=\"ok\", lanes=lanes)\n        except (OSError, UnicodeDecodeError, ValueError, AttributeError):\n            pass\n    return out\n\n\ndef _mc_upstream_cell(det: Any, up: Dict[str, Any], lane: str,\n                      pinned: List[str]) -> Tuple[str, List[str], str]:\n    entry = (up.get(\"lanes\") or {}).get(lane)\n    models = entry.get(\"models\") if isinstance(entry, dict) else None\n    key = up[\"state\"]\n    if key == \"ok\" and not isinstance(models, list):\n        key = \"malformed\" if lane in up[\"lanes\"] else \"no_lane\"\n    if key != \"ok\":\n        return _MC_NO_DATA[key].format(age=up[\"age\"]), [], key\n    valid = [m for m in models if _mc_id_ok(m) and _mc_lane(det, m) == lane]\n    unique = list(dict.fromkeys(valid))\n    novel = [m for m in unique if m not in pinned]\n    shown = novel[:MODEL_CURRENCY_SHOW_MAX_IDS]\n    more = \" (+%d truncados)\" % (len(novel) - len(shown)) if novel[len(shown):] else \"\"\n    return (\"«externo, %s: %d ids; fora do fixado: %s%s; descartados=%d»\" % (\n        up[\"age\"], len(unique), \", \".join(shown) or \"nenhum\", more,\n        len(models) - len(valid))), novel, key\n\n\ndef _mc_trio(root: Path) -> Tuple[str, str, Any]:\n    try:\n        settings = json.loads(root.joinpath(\".claude\", \"settings.json\").read_text(\n            encoding=\"utf-8\"))\n    except (OSError, ValueError):\n        settings = {}\n    settings = settings if isinstance(settings, dict) else {}\n    raw = settings.get(\"model\")\n    installed = raw if _mc_id_ok(raw) else None\n    inst = installed or (\"sem dado\" if raw is None else \"valor não reconhecido\")\n    det_path = root.joinpath(*_MC_DETECTOR_REL)\n    if not root.joinpath(*_MC_ADR_REL).is_file() or not det_path.is_file():\n        why = (\"ADR-149 ausente — árvore de adopter\"\n               if not root.joinpath(*_MC_ADR_REL).is_file() else \"detector ausente\")\n        return \"green\", \"model-currency: sem dado (%s); instalado=%s\" % (why, inst), None\n    import importlib.util\n    spec = importlib.util.spec_from_file_location(\"_ceo_boot_mc_detector\", str(det_path))\n    det = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(det)  # type: ignore[union-attr]\n    try:\n        report = det.scan(root, det.build_parser().parse_args([]))\n        exp = root.joinpath(*_MC_EXPECTED_REL)\n        drift = (det.compare_reds(report[\"red_ids\"], det.read_expected_reds(exp))\n                 if exp.is_file() else None)\n    except det.DetectorBroke as exc:\n        why = _sanitize_for_recs(str(exc)).replace(\"|\", \"/\")[:120]\n        return \"yellow\", \"model-currency: sem dado (detector recusou: %s)\" % why, None\n    pinned_all = list(report[\"authorities\"][\"working_set\"])\n    up = _mc_read_upstream(root)\n    cells: List[str] = []\n    lanes: Dict[str, Any] = {}\n    for lane in report[\"active_lanes\"]:\n        pinned = [m for m in pinned_all if _mc_lane(det, m) == lane]\n        mine = installed if installed and _mc_lane(det, installed) == lane else None\n        member = \"\" if mine is None else (\n            \" (instalado ∈ fixado)\" if mine in pinned else \" (instalado FORA do fixado)\")\n        cell, novel, key = _mc_upstream_cell(det, up, lane, pinned)\n        cells.append(\"%s: instalado=%s · fixado=%d ids%s · upstream=%s\" % (\n            lane, mine or \"nenhum nesta raia\", len(pinned), member, cell))\n        lanes[lane] = {\"installed\": mine, \"novel\": novel[:MODEL_CURRENCY_SHOW_MAX_IDS],\n                       \"upstream\": key}\n    n_red = len(report[\"red_ids\"])\n    reds = (\"vermelhos=%d (sem conjunto esperado)\" % n_red if drift is None else\n            \"vermelhos=%d (fora do esperado: +%d/-%d)\" % (n_red, len(drift[0]), len(drift[1]))\n            if drift[0] or drift[1] else \"vermelhos=%d (= esperado)\" % n_red)\n    summary = \"model-currency: %s · availableModels %s · %s\" % (\n        \" ; \".join(cells), \"= fixado\" if settings.get(\"availableModels\") == pinned_all\n        else \"≠ fixado\", reds)\n    detail = {\"lanes\": lanes, \"upstream\": up[\"state\"]}\n    if (any(v[\"novel\"] or v[\"upstream\"] in (\"oversize\", \"malformed\") for v in lanes.values())\n            or (drift is not None and (drift[0] or drift[1]))):\n        return \"yellow\", summary, detail\n    return \"green\", summary, detail\n\n\ndef check_tier_a_model_currency() -> Tuple[str, str, Any]:\n    \"\"\"PLAN-176 W3a advisory — never red, never raises (see block comment).\"\"\"\n    try:\n        return _mc_trio(REPO_ROOT)\n    except Exception as exc:  # noqa: BLE001 — advisory floor: degrade, never break\n        return \"yellow\", \"model-currency: sem dado (advisory falhou: %s)\" % (\n            type(exc).__name__), None\n\n\n# ---- Registry --------------------------------------------------------------\n\n\ndef check_tier_policy_misrouting_24h() -> Tuple[str, str, Any]:\n    \"\"\"16th Tier-S check — delegates to standalone hook module (PLAN-091 W2.1).\n\n    Lazy-imports ``.claude/hooks/check_tier_policy_misrouting_24h.py`` so\n    that the standalone module can also be invoked as a CLI smoke-test\n    (``python3 .claude/hooks/check_tier_policy_misrouting_24h.py``).\n    Any import-time failure surfaces as a `yellow` status (fail-soft\n    Tier-S contract); the dispatcher's outer try/except still wraps the\n    inner call for additional defense-in-depth.\n    \"\"\"\n    try:\n        hooks_dir = REPO_ROOT / \".claude\" / \"hooks\"\n        if str(hooks_dir) not in sys.path:\n            sys.path.insert(0, str(hooks_dir))\n        from check_tier_policy_misrouting_24h import (  # type: ignore\n            check_tier_policy_misrouting_24h as _impl,\n        )\n        return _impl()\n    except Exception as exc:  # noqa: BLE001 (Tier-S fail-soft floor)\n        return \"yellow\", f\"tier_policy_misrouting import error: {exc}\", None\n\n\ndef check_cache_discipline_alerted() -> Tuple[str, str, Any]:\n    \"\"\"17th Tier-S check — prompt-cache coverage detection (PLAN-093 Wave C.2).\n\n    Surfaces ``cache_discipline_alerted`` when prompt-cache coverage falls\n    below 0.7 over the last 24h of audit-log events. Detection is heuristic:\n    any audit row (``agent_spawn`` action) carrying a ``cache_coverage_bps``\n    numeric field is averaged; rows without the field are ignored. Absent\n    any datapoints, status is green with a \"no data\" summary (fail-soft\n    Tier-S contract).\n\n    Field alignment (F-5-5.1-0624274e fix): audit_log.py emits the\n    cache-coverage metric derived from usage_metadata cache_read /\n    (cache_read + cache_creation + uncached); older code read the\n    non-existent ``cache_hit_rate`` field, causing the gate to always\n    return green/\"no data\". This fix aligns the reader to the emitted field.\n    PLAN-118 WS-E (S181): the emitted field is now ``cache_coverage_bps``\n    (integer basis-points); this reader reads it (÷10000) and falls back to\n    the legacy ``cache_coverage`` float for events emitted before the fix.\n\n    Emits ``cache_discipline_alerted`` via ``emit_generic`` on yellow/red\n    so downstream analytics can correlate with /ceo-boot runs. Action\n    name is registered at ``audit_emit.py:440`` (PLAN-088 canonical).\n    \"\"\"\n    threshold = 0.70\n    try:\n        rates: List[float] = []\n        for ev in _iter_audit_events_since(hours=24.0):\n            # S239: skip synthetic governance-probe / benchmark spawns — they\n            # carry cache_coverage_bps=0 by construction (no real cached LLM\n            # call), so a probe-only 24h window would pin this gate to red (FP).\n            if _is_test_pollution_event(ev):\n                continue\n            # PLAN-118 WS-E (S181): primary field is now ``cache_coverage_bps``\n            # (integer basis-points, ratio × 10000) — the legacy float\n            # ``cache_coverage`` was dropped because it broke the HMAC chain.\n            # Read bps first, fall back to the legacy float for events emitted\n            # before the fix (the 24h window straddles the transition; without\n            # the fallback this Tier-S gate would go silently dead again —\n            # the exact F-5-5.1-0624274e failure mode this check exists to avoid).\n            v_bps = ev.get(\"cache_coverage_bps\")\n            if isinstance(v_bps, int) and not isinstance(v_bps, bool) and 0 <= v_bps <= 10000:\n                rates.append(v_bps / 10000.0)\n                continue\n            # F-5-5.1-0624274e: legacy float field (pre-PLAN-118 events).\n            v = ev.get(\"cache_coverage\")\n            if isinstance(v, (int, float)) and not isinstance(v, bool) and 0.0 <= float(v) <= 1.0:\n                rates.append(float(v))\n        if not rates:\n            return \"green\", \"no cache_coverage datapoints\", {\"samples\": 0}\n        avg = sum(rates) / len(rates)\n        if avg < threshold:\n            try:\n                if _audit_emit is not None and hasattr(\n                    _audit_emit, \"emit_cache_discipline_alerted\"\n                ):\n                    _audit_emit.emit_cache_discipline_alerted(\n                        hit_rate_basis_points=max(\n                            0, min(1000, int(round(avg * 1000)))\n                        ),\n                        floor_basis_points=max(\n                            0, min(1000, int(round(threshold * 1000)))\n                        ),\n                        session_count_24h=len(rates),\n                        below_floor=True,\n                        opted_out=False,\n                    )\n            except Exception:  # noqa: BLE001 (Tier-S fail-soft)\n                pass\n            return \"red\", f\"cache_coverage {avg:.2f} < {threshold}\", {\n                \"avg_rate\": avg,\n                \"samples\": len(rates),\n            }\n        return \"green\", f\"cache_coverage {avg:.2f} ok\", {\n            \"avg_rate\": avg,\n            \"samples\": len(rates),\n        }\n    except Exception as exc:  # noqa: BLE001 (Tier-S fail-soft)\n        return \"yellow\", f\"cache_discipline_alerted error: {exc}\", None\n\n\n# PLAN-093 Wave C.5/C.6 canonical persona × task matrix.\n#\n# S127 cadence-amendment (Codex R2 thread `019e33a3` AMEND verdict\n# `PHASE-1+2-WITH-(c)`): the 4×4 matrix is demoted from gate-eligible to\n# permanent observability. RED authority moves to a future event-driven\n# demand ledger (`PLAN-104-persona-demand-ledger`); see\n# `PLAN-093-FOLLOWUP-cadence-amendment.md` for the full doctrine record.\n_VETO_FLOOR_PERSONAS = (\n    \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n    \"threat-detection-engineer\",\n)\n_PERSONA_TASK_TYPES = (\"review\", \"vet\", \"test\", \"detect\")\n_VETO_FLOOR_PERSONAS_LOWER = frozenset(p.lower() for p in _VETO_FLOOR_PERSONAS)\n\n# PLAN-112-FOLLOWUP-persona-routing-wire W4 — F-5.4-tasktype-pollution.\n# `_score_persona_coverage` previously counted task_type from ANY audit\n# event whose archetype matched a VETO-floor persona. Unrelated emitters\n# (notably `model_routing_advised`, which carries archetype + a bogus\n# task_type like `frontmatter`/`M`) inflated the denominator + skewed cells.\n# Restrict contributing events to the GENUINE persona-dispatch actions:\n#   - `persona_coverage_synthesized` (SPEC/v1/audit-log.schema.md:319 —\n#     carries `archetype` + `task_type`, the only fields the scorer reads)\n#   - `persona_demand_*` (the persona-demand ledger family; PLAN-104)\n# NOTE: `persona_dispatch` does NOT exist and must not be referenced.\n_PERSONA_DISPATCH_ACTION_PREFIXES = (\"persona_demand_\",)\n_PERSONA_DISPATCH_ACTIONS = frozenset({\"persona_coverage_synthesized\"})\n\n\ndef _is_persona_dispatch_event(ev: Dict[str, Any]) -> bool:\n    \"\"\"True iff `ev` is a genuine persona-dispatch event (F-5.4 filter).\n\n    Defensive: a missing/non-str `action` -> False (excluded).\n    \"\"\"\n    action = ev.get(\"action\")\n    if not isinstance(action, str):\n        return False\n    if action in _PERSONA_DISPATCH_ACTIONS:\n        return True\n    return any(action.startswith(p) for p in _PERSONA_DISPATCH_ACTION_PREFIXES)\n\n\ndef _normalize_persona_role(ev: Dict[str, Any]) -> str:\n    \"\"\"Case-folded canonical role extracted from any audit_log emission surface.\n\n    PLAN-093 Wave C.5 originally read only ``archetype`` / ``persona``. Codex\n    R2 thread `019e33a3` AMEND #4: audit-log events emitted from\n    ``audit_log.py`` carry the role on ``subagent_type`` (canonical) and\n    ``dispatch_archetype_hint`` (resolved-from-prompt) — narrow read missed\n    those surfaces. First non-empty match wins, case-folded.\n    \"\"\"\n    for field in (\"archetype\", \"persona\", \"subagent_type\",\n                  \"dispatch_archetype_hint\"):\n        val = ev.get(field)\n        if isinstance(val, str) and val.strip():\n            return val.strip().lower()\n    return \"\"\n","numLines":560,"startLine":1,"totalLines":560}},"tool_result_meta":[{"id":"toolu_01DkNLemuc7Bwkf362XFaVFD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
