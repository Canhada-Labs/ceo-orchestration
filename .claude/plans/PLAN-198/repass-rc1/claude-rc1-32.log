{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018k2ivX3FJ82TYyzC4nDbBw","type":"tool_result","content":"380\t            \"v1.16.0-era verdicts that ship `commit_sha:` field. \"\n381\t            \"Mutually exclusive with --parent-sha; if both passed, \"\n382\t            \"--parent-sha wins.\"\n383\t        ),\n384\t    )\n385\t    parser.add_argument(\"--release-tag\", required=True)\n386\t    parser.add_argument(\"--max-age-hours\", type=int, default=24)\n387\t    parser.add_argument(\"--recompute-inputs-hash\", action=\"store_true\")\n388\t    parser.add_argument(\"--codex-cli-pin-file\", default=\"\")\n389\t    parser.add_argument(\"--codex-cli-binary-sha256-file\", default=\"\")\n390\t    parser.add_argument(\n391\t        \"--codex-pin-manifest-file\",\n392\t        default=\"\",\n393\t        help=(\n394\t            \"ADR-182 payload-pin manifest (codex-cli-pin-manifest.json). \"\n395\t            \"When passed, verdict.tool_versions.codex_target_triple + \"\n396\t            \".codex_payload_sha256 MUST match the manifest entry \"\n397\t            \"(fail-CLOSED — VERDICT_INVALID on any miss).\"\n398\t        ),\n399\t    )\n400\t    parser.add_argument(\"--inputs-hash-paths-file\", default=\"\")\n401\t    args = parser.parse_args(argv)\n402\t\n403\t    verdict_path = Path(args.verdict_file)\n404\t    repo_root = Path.cwd()\n405\t\n406\t    # Parse verdict. The TEXT is kept: the duplicate-key check below reads\n407\t    # the same bytes the parse consumed (a second read could disagree).\n408\t    try:\n409\t        verdict_text = verdict_path.read_bytes().decode(\"utf-8\")  # t10 P2: raw, keep CR\n410\t        verdict = parse_verdict_text(verdict_text)\n411\t    except FileNotFoundError as e:\n412\t        print(f\"INFRA: verdict file not found: {e}\", file=sys.stderr)\n413\t        return EXIT_INFRA_ERROR\n414\t    except OSError as e:\n415\t        print(f\"INFRA: verdict file unreadable: {e}\", file=sys.stderr)\n416\t        return EXIT_INFRA_ERROR\n417\t    except UnicodeDecodeError as e:\n418\t        # t10 P2: non-UTF-8 SIGNED CONTENT is input-invalid, not infra.\n419\t        print(f\"INVALID: verdict is not UTF-8: {e}\", file=sys.stderr)\n420\t        return EXIT_VERDICT_INVALID\n421\t    except ValueError as e:\n422\t        # t10 P2: a parse rejection of SIGNED CONTENT (absent/ambiguous\n423\t        # fence, forbidden bytes) is the promised input-invalid exit 3 —\n424\t        # routing it through INFRA let CEO_PAIR_RAIL_VERDICT_OPTIONAL=1\n425\t        # soften a rejection the contract says must stop the release.\n426\t        print(f\"INVALID: verdict content rejected: {e}\", file=sys.stderr)\n427\t        return EXIT_VERDICT_INVALID\n428\t\n429\t    # PLAN-177 W0.1 (P1-4): the DECISION gate. Until this block existed\n430\t    # the validator read pinning, TTL and signature presence but never the\n431\t    # verdict itself: a cross-model NO-GO returned OK / exit 0.\n432\t    #\n433\t    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on):\n434\t    # this step carries `continue-on-error` when\n435\t    # CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 (release.yml:689), so the gate HERE\n436\t    # is defence in depth; the rail that enforces in EVERY mode is\n437\t    # `.claude/scripts/local/_release_tag_guard.py delta`, invoked by a\n438\t    # step with no escape hatch. Neither may be dropped for the other.\n439\t    #\n440\t    # Fail-CLOSED on SHAPE as well as value (CF-1): the reader above\n441\t    # returns a dict for an empty `verdict:` line, so the type check\n442\t    # precedes the compare and a malformed decision exits 3 (INVALID),\n443\t    # never 1 (INFRA) -- which the transition mode is allowed to wave\n444\t    # through. Same precedent as the tool_versions dict check below.\n445\t    # PLAN-177 t2 (P1-a): SHAPE BEFORE VALUE. The counter below and the tag\n446\t    # guard's counter only agree on a canonical block; a non-canonical\n447\t    # top-level line is refused here rather than parsed by two grammars.\n448\t    # INVALID (3), never INFRA (1): the transition mode may wave INFRA\n449\t    # through, and this is a property of the SIGNED bytes, not of the runner.\n450\t    noncanonical = noncanonical_top_level_lines(verdict_text)\n451\t    if noncanonical:\n452\t        print(\n453\t            f\"INVALID: non-canonical top-level key syntax in the verdict \"\n454\t            f\"block: {noncanonical!r} -- a top-level line must be `name:` \"\n455\t            f\"with no whitespace before the colon; list items only INDENTED \"\n456\t            f\"under a bare key, never at the root. \"\n457\t            f\"The two release rails read this file with different \"\n458\t            f\"grammars, so `verdict : NO-GO` followed by `verdict: GO` \"\n459\t            f\"counts as two declarations here and one there; the shape is \"\n460\t            f\"refused instead of guessed.\",\n461\t            file=sys.stderr,\n462\t        )\n463\t        return EXIT_VERDICT_INVALID\n464\t\n465\t    decisions_declared = count_top_level_key(verdict_text, \"verdict\")\n466\t    if decisions_declared > 1:\n467\t        print(\n468\t            f\"INVALID: verdict decision declared more than once \"\n469\t            f\"(x{decisions_declared}) -- the reader is last-wins, so a \"\n470\t            f\"duplicated `verdict:` silently overrides the first; exactly \"\n471\t            f\"one is required.\",\n472\t            file=sys.stderr,\n473\t        )\n474\t        return EXIT_VERDICT_INVALID\n475\t    raw_decision = verdict.get(\"verdict\")\n476\t    if raw_decision is None:\n477\t        shown = \"<absent>\"\n478\t    elif not isinstance(raw_decision, str):\n479\t        shown = \"<non-string:%s>\" % type(raw_decision).__name__\n480\t    else:\n481\t        # ASCII-only trim (t5 P1): `GO<U+00A0>` must FAIL the exact-token\n482\t        # membership below, never be normalized into `GO`.\n483\t        shown = raw_decision.strip(\" \\t\")\n484\t    if shown not in ACCEPTED_DECISIONS:\n485\t        accepted = \"{%s}\" % \", \".join(ACCEPTED_DECISIONS)\n486\t        print(\n487\t            f\"INVALID: verdict decision '{shown}' not in {accepted} -- a \"\n488\t            f\"release requires an explicit authorizing decision from the \"\n489\t            f\"pair-rail. Exact match: no case folding, no substring rule \"\n490\t            f\"(NO-GO contains GO).\",\n491\t            file=sys.stderr,\n492\t        )\n493\t        return EXIT_VERDICT_INVALID\n494\t\n495\t    # R1 S-Sec-3: release_tag bind\n496\t    declared_tag = verdict.get(\"release_tag\", \"\").strip()\n497\t    if declared_tag != args.release_tag:\n498\t        print(\n499\t            f\"INVALID: verdict release_tag mismatch — \"\n500\t            f\"declared='{declared_tag}', argv='{args.release_tag}'\",\n501\t            file=sys.stderr,\n502\t        )\n503\t        return EXIT_VERDICT_INVALID\n504\t\n505\t    # parent_sha / commit_sha bind (S104 redesign — see docstring).\n506\t    # Precedence: --parent-sha (canonical, post-S104) wins. Falls back to\n507\t    # legacy --commit-sha for v1.16.0-era verdicts that still ship the old\n508\t    # field.\n509\t    if args.parent_sha:\n510\t        declared_parent = verdict.get(\"parent_sha\", \"\").strip()\n511\t        if not declared_parent:\n512\t            # New-style validation requested but verdict lacks the field.\n513\t            # Could be a stale verdict generated before the redesign. Fall\n514\t            # back to legacy commit_sha if available; else hard-fail.\n515\t            legacy_sha = verdict.get(\"commit_sha\", \"\").strip()\n516\t            if legacy_sha:\n517\t                print(\n518\t                    f\"ADVISORY: verdict ships legacy commit_sha \"\n519\t                    f\"(='{legacy_sha[:12]}'); --parent-sha bind skipped. \"\n520\t                    f\"Re-author verdict with parent_sha for full S104 \"\n521\t                    f\"bind enforcement.\",\n522\t                    file=sys.stderr,\n523\t                )\n524\t            else:\n525\t                print(\n526\t                    f\"INVALID: verdict missing parent_sha field \"\n527\t                    f\"(--parent-sha='{args.parent_sha[:12]}' requested bind)\",\n528\t                    file=sys.stderr,\n529\t                )\n530\t                return EXIT_VERDICT_INVALID\n531\t        elif declared_parent != args.parent_sha:\n532\t            print(\n533\t                f\"INVALID: verdict parent_sha mismatch — \"\n534\t                f\"declared='{declared_parent[:12]}', \"\n535\t                f\"argv='{args.parent_sha[:12]}'\",\n536\t                file=sys.stderr,\n537\t            )\n538\t            return EXIT_VERDICT_INVALID\n539\t    elif args.commit_sha:\n540\t        # Legacy path — only used when --parent-sha not passed (e.g.\n541\t        # bridging older release.yml invocations against new validator).\n542\t        declared_sha = verdict.get(\"commit_sha\", \"\").strip()\n543\t        if declared_sha != args.commit_sha:\n544\t            print(\n545\t                f\"INVALID: verdict commit_sha mismatch — \"\n546\t                f\"declared='{declared_sha[:12]}', argv='{args.commit_sha[:12]}'\",\n547\t                file=sys.stderr,\n548\t            )\n549\t            return EXIT_VERDICT_INVALID\n550\t\n551\t    # R1 S-QA-Unseen-2: VERDICT_EXPIRED distinct exit code\n552\t    generated_at = verdict.get(\"generated_at\", \"\")\n553\t    if generated_at:\n554\t        try:\n555\t            ts = datetime.fromisoformat(generated_at.rstrip(\"Z\"))\n556\t            if ts.tzinfo is None:\n557\t                ts = ts.replace(tzinfo=timezone.utc)\n558\t            now = datetime.now(timezone.utc)\n559\t            age_hours = (now - ts).total_seconds() / 3600.0\n560\t            if age_hours > args.max_age_hours:\n561\t                print(\n562\t                    f\"EXPIRED: verdict {age_hours:.1f}h old \"\n563\t                    f\"(max {args.max_age_hours}h)\",\n564\t                    file=sys.stderr,\n565\t                )\n566\t                return EXIT_VERDICT_EXPIRED\n567\t        except (TypeError, ValueError):\n568\t            print(f\"INFRA: unparseable generated_at: {generated_at!r}\", file=sys.stderr)\n569\t            return EXIT_INFRA_ERROR\n570\t\n571\t    # R1 S-Sec-4: inputs_hash recompute\n572\t    if args.recompute_inputs_hash and args.inputs_hash_paths_file:\n573\t        try:\n574\t            actual_hash = compute_inputs_hash(\n575\t                repo_root, Path(args.inputs_hash_paths_file)\n576\t            )\n577\t        except (FileNotFoundError, ValueError) as e:\n578\t            print(f\"INFRA: inputs_hash recompute failed: {e}\", file=sys.stderr)\n579\t            return EXIT_INFRA_ERROR\n580\t        declared_hash = verdict.get(\"inputs_hash\", \"\").strip()\n581\t        if declared_hash != actual_hash:\n582\t            print(\n583\t                f\"INVALID: inputs_hash mismatch — \"\n584\t                f\"declared='{declared_hash[:16]}', actual='{actual_hash[:16]}'\",\n585\t                file=sys.stderr,\n586\t            )\n587\t            return EXIT_VERDICT_INVALID\n588\t\n589\t    # R1 C5: Codex CLI pin enforcement\n590\t    if args.codex_cli_pin_file:\n591\t        try:\n592\t            min_v, max_v = parse_pin_range(Path(args.codex_cli_pin_file))\n593\t        except (OSError, ValueError) as exc:\n594\t            print(f\"INVALID: codex CLI pin range rejected: {exc}\", file=sys.stderr); return EXIT_VERDICT_INVALID\n595\t        if min_v:\n596\t            tool_versions = verdict.get(\"tool_versions\", {})\n597\t            if not isinstance(tool_versions, dict):\n598\t                # Codex iter-6 P1 fix — malformed tool_versions (scalar /\n599\t                # non-dict) previously bypassed both semver + binary-SHA\n600\t                # checks. Now hard-fail.\n601\t                print(\n602\t                    f\"INVALID: tool_versions field must be a dict, got \"\n603\t                    f\"{type(tool_versions).__name__}: {tool_versions!r}\",\n604\t                    file=sys.stderr,\n605\t                )\n606\t                return EXIT_VERDICT_INVALID\n607\t            cli_v = tool_versions.get(\"codex_cli\", \"\")\n608\t            comparison = cli_currency.compare_semver(cli_v, min_v)\n609\t            upper_comparison = cli_currency.compare_semver(cli_v, max_v) if max_v else None\n610\t            if (\n611\t                comparison is None\n612\t                or comparison < 0\n613\t                or (max_v is not None and (upper_comparison is None or upper_comparison >= 0))\n614\t            ):\n615\t                range_text = f\">={min_v}\" if max_v is None else f\">={min_v},<{max_v}\"\n616\t                print(\n617\t                    f\"INVALID: codex_cli version {cli_v!r} not in pin \"\n618\t                    f\"range {range_text}\",\n619\t                    file=sys.stderr,\n620\t                )\n621\t                return EXIT_VERDICT_INVALID\n622\t            if comparison > 0 and max_v is None:\n623\t                print(f\"INFO: codex_cli {cli_v} is newer than compatibility floor \"\n624\t                      f\">={min_v}; payload pin uses version-only compatibility\", file=sys.stderr)\n625\t\n626\t    # PLAN-081 Phase 6-bis / T-8: Codex CLI binary SHA-256 pin enforcement\n627\t    if args.codex_cli_binary_sha256_file:\n628\t        pin_path = Path(args.codex_cli_binary_sha256_file)\n629\t        if not pin_path.exists():\n630\t            # ADVISORY skip per Codex iter-1 P1 — missing pin file is a\n631\t            # rollout state (e.g. legacy verdicts pre-Phase-6-bis); do NOT\n632\t            # hard-fail. release.yml step 15 still gates on the codex_cli\n633\t            # semver pin (R1 C5) which is mandatory.\n634\t            print(\n635\t                f\"ADVISORY: codex-cli-binary-sha256-file not found at {pin_path}; \"\n636\t                f\"skipping T-8 binary-SHA pin check (semver pin still enforced)\",\n637\t                file=sys.stderr,\n638\t            )\n639\t            expected_sha = \"\"\n640\t        else:\n641\t            expected_sha = \"\"\n642\t            for line in pin_path.read_text().splitlines():\n643\t                line = line.split(\"#\", 1)[0].strip()\n644\t                if line:\n645\t                    expected_sha = line\n646\t                    break\n647\t        if expected_sha and len(expected_sha) == 64:\n648\t            tool_versions = verdict.get(\"tool_versions\", {})\n649\t            if not isinstance(tool_versions, dict):\n650\t                # Codex iter-7 P1 fix — scalar/non-dict tool_versions\n651\t                # previously silently skipped binary-SHA check (only the\n652\t                # semver pin path enforced dict shape). Hard-fail\n653\t                # consistently regardless of which pin is being checked.\n654\t                print(\n655\t                    f\"INVALID: tool_versions field must be a dict for binary-SHA \"\n656\t                    f\"check, got {type(tool_versions).__name__}: {tool_versions!r}\",\n657\t                    file=sys.stderr,\n658\t                )\n659\t                return EXIT_VERDICT_INVALID\n660\t            declared_binary_sha = tool_versions.get(\n661\t                \"codex_cli_binary_sha256\", \"\"\n662\t            ).strip()\n663\t            if not declared_binary_sha:\n664\t                # When the pin file exists + is non-empty, verdict\n665\t                # envelope MUST carry the binary SHA — missing field is\n666\t                # a regression / pre-rollout legacy state. Per Codex\n667\t                # iter-5 P1 finding, this is hard-fail when pin file\n668\t                # provides authoritative SHA.\n669\t                print(\n670\t                    f\"INVALID: codex-cli-binary-sha256-file pin '{pin_path}' \"\n671\t                    f\"exists + non-empty (sha='{expected_sha[:16]}'), but \"\n672\t                    f\"verdict envelope lacks tool_versions.codex_cli_binary_sha256\",\n673\t                    file=sys.stderr,\n674\t                )\n675\t                return EXIT_VERDICT_INVALID\n676\t            if declared_binary_sha != expected_sha:\n677\t                print(\n678\t                    f\"INVALID: codex_cli_binary_sha256 mismatch — \"\n679\t                    f\"declared='{declared_binary_sha[:16]}', \"\n680\t                    f\"pin='{expected_sha[:16]}'\",\n681\t                    file=sys.stderr,\n682\t                )\n683\t                return EXIT_VERDICT_INVALID\n684\t\n685\t    # ADR-182 (PLAN-163 T5.2): payload-pin manifest enforcement. The\n686\t    # verdict envelope carries the sha256 of the NATIVE codex payload\n687\t    # for the platform triple of the generating run (wire-shape defined\n688\t    # in ADR-182: scalar `tool_versions.codex_payload_sha256` + scalar\n689\t    # `tool_versions.codex_target_triple`); the validator compares it\n690\t    # against `payloads[<triple>].sha256` in the manifest. Fail-CLOSED\n691\t    # on everything except an unreadable manifest file (infra).\n692\t    if args.codex_pin_manifest_file:\n693\t        manifest_path = Path(args.codex_pin_manifest_file)\n694\t        try:\n695\t            manifest_raw = manifest_path.read_text(encoding=\"utf-8\")\n696\t        except OSError as e:\n697\t            print(\n698\t                f\"INFRA: codex-pin-manifest-file unreadable at \"\n699\t                f\"{manifest_path}: {e}\",\n700\t                file=sys.stderr,\n701\t            )\n702\t            return EXIT_INFRA_ERROR\n703\t        try:\n704\t            manifest = json.loads(manifest_raw)\n705\t        except ValueError as e:\n706\t            print(\n707\t                f\"INVALID: codex-pin-manifest-file is not valid JSON \"\n708\t                f\"({e}) — fail-CLOSED per ADR-182\",\n709\t                file=sys.stderr,\n710\t            )\n711\t            return EXIT_VERDICT_INVALID\n712\t        if (\n713\t            not isinstance(manifest, dict)\n714\t            or manifest.get(\"schema\") != 1\n715\t            or cli_currency.parse_semver(manifest.get(\"package_version\")) is None\n716\t            or not isinstance(manifest.get(\"payloads\"), dict)\n717\t        ):\n718\t            print(\n719\t                \"INVALID: codex-pin-manifest-file schema violation \"\n720\t                \"(expected schema=1 + stable package_version + payloads dict) — fail-CLOSED per ADR-182\",\n721\t                file=sys.stderr,\n722\t            )\n723\t            return EXIT_VERDICT_INVALID\n724\t        tool_versions = verdict.get(\"tool_versions\", {})\n725\t        if not isinstance(tool_versions, dict):\n726\t            print(\n727\t                f\"INVALID: tool_versions field must be a dict for \"\n728\t                f\"payload-pin check, got \"\n729\t                f\"{type(tool_versions).__name__}: {tool_versions!r}\",\n730\t                file=sys.stderr,\n731\t            )\n732\t            return EXIT_VERDICT_INVALID\n733\t        declared_triple = str(\n734\t            tool_versions.get(\"codex_target_triple\", \"\")\n735\t        ).strip()\n736\t        declared_payload_sha = str(\n737\t            tool_versions.get(\"codex_payload_sha256\", \"\")\n738\t        ).strip()\n739\t        if not declared_triple or not declared_payload_sha:\n740\t            print(\n741\t                \"INVALID: ADR-182 payload pin requested \"\n742\t                f\"(manifest='{manifest_path}') but verdict envelope \"\n743\t                \"lacks tool_versions.codex_target_triple and/or \"\n744\t                \"tool_versions.codex_payload_sha256\",\n745\t                file=sys.stderr,\n746\t            )\n747\t            return EXIT_VERDICT_INVALID\n748\t        if not re.fullmatch(r\"[0-9a-f]{64}\", declared_payload_sha):\n749\t            print(\"INVALID: verdict codex_payload_sha256 has malformed sha256 \"\n750\t                  \"— fail-CLOSED per ADR-182\", file=sys.stderr)\n751\t            return EXIT_VERDICT_INVALID\n752\t        entry = manifest[\"payloads\"].get(declared_triple)\n753\t        if not isinstance(entry, dict):\n754\t            print(\n755\t                f\"INVALID: targetTriple '{declared_triple}' absent from \"\n756\t                f\"codex-pin-manifest payloads — fail-CLOSED per ADR-182\",\n757\t                file=sys.stderr,\n758\t            )\n759\t            return EXIT_VERDICT_INVALID\n760\t        expected_payload_sha = str(entry.get(\"sha256\", \"\")).strip()\n761\t        if not re.match(r\"^[0-9a-f]{64}$\", expected_payload_sha):\n762\t            print(\n763\t                f\"INVALID: manifest entry for '{declared_triple}' has \"\n764\t                f\"malformed sha256 — fail-CLOSED per ADR-182\",\n765\t                file=sys.stderr,\n766\t            )\n767\t            return EXIT_VERDICT_INVALID\n768\t        package_version = manifest[\"package_version\"]\n769\t        cli_version = tool_versions.get(\"codex_cli\")\n770\t        version_comparison = cli_currency.compare_semver(cli_version, package_version)\n771\t        newer_floor = cli_currency.compare_semver(cli_version, cli_currency.CODEX_VERSION_FLOOR)\n772\t        exact_payload_pin = version_comparison in (None, 0) or newer_floor is None or newer_floor < 0\n773\t        if exact_payload_pin and declared_payload_sha != expected_payload_sha:\n774\t            print(\n775\t                f\"INVALID: codex_payload_sha256 mismatch for \"\n776\t                f\"'{declared_triple}' — \"\n777\t                f\"declared='{declared_payload_sha[:16]}', \"\n778\t                f\"pin='{expected_payload_sha[:16]}'\",\n779\t                file=sys.stderr,\n780\t            )\n781\t            return EXIT_VERDICT_INVALID\n782\t        if not exact_payload_pin:\n783\t            print(f\"INFO: codex_cli {cli_version} is newer than the payload manifest version; \"\n784\t                  \"payload sha is format-validated but not attested by this older manifest\", file=sys.stderr)\n785\t\n786\t    # GPG signature presence (verifies via separate `git verify-tag` in\n787\t    # release.yml; here we just assert the field is present + non-empty)\n788\t    sig = verdict.get(\"gpg_signature\", \"\")\n789\t    if not sig or sig.strip() == \"\":\n790\t        print(\"INVALID: gpg_signature field empty\", file=sys.stderr)\n791\t        return EXIT_VERDICT_INVALID\n792\t\n793\t    print(f\"OK: verdict {args.release_tag} valid\", file=sys.stdout)\n794\t    return EXIT_OK\n795\t\n796\t\n797\tif __name__ == \"__main__\":\n798\t    sys.exit(main())\n799\t"}]},"parent_tool_use_id":null,"session_id":"57bd0a0f-ef05-4951-aa49-b19ce0916105","uuid":"f811256c-6891-4bd1-988a-952431075bac","timestamp":"2026-11-15T11:37:42.240Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.github/scripts/validate-pair-rail-verdict.py","content":"            \"v1.16.0-era verdicts that ship `commit_sha:` field. \"\n            \"Mutually exclusive with --parent-sha; if both passed, \"\n            \"--parent-sha wins.\"\n        ),\n    )\n    parser.add_argument(\"--release-tag\", required=True)\n    parser.add_argument(\"--max-age-hours\", type=int, default=24)\n    parser.add_argument(\"--recompute-inputs-hash\", action=\"store_true\")\n    parser.add_argument(\"--codex-cli-pin-file\", default=\"\")\n    parser.add_argument(\"--codex-cli-binary-sha256-file\", default=\"\")\n    parser.add_argument(\n        \"--codex-pin-manifest-file\",\n        default=\"\",\n        help=(\n            \"ADR-182 payload-pin manifest (codex-cli-pin-manifest.json). \"\n            \"When passed, verdict.tool_versions.codex_target_triple + \"\n            \".codex_payload_sha256 MUST match the manifest entry \"\n            \"(fail-CLOSED — VERDICT_INVALID on any miss).\"\n        ),\n    )\n    parser.add_argument(\"--inputs-hash-paths-file\", default=\"\")\n    args = parser.parse_args(argv)\n\n    verdict_path = Path(args.verdict_file)\n    repo_root = Path.cwd()\n\n    # Parse verdict. The TEXT is kept: the duplicate-key check below reads\n    # the same bytes the parse consumed (a second read could disagree).\n    try:\n        verdict_text = verdict_path.read_bytes().decode(\"utf-8\")  # t10 P2: raw, keep CR\n        verdict = parse_verdict_text(verdict_text)\n    except FileNotFoundError as e:\n        print(f\"INFRA: verdict file not found: {e}\", file=sys.stderr)\n        return EXIT_INFRA_ERROR\n    except OSError as e:\n        print(f\"INFRA: verdict file unreadable: {e}\", file=sys.stderr)\n        return EXIT_INFRA_ERROR\n    except UnicodeDecodeError as e:\n        # t10 P2: non-UTF-8 SIGNED CONTENT is input-invalid, not infra.\n        print(f\"INVALID: verdict is not UTF-8: {e}\", file=sys.stderr)\n        return EXIT_VERDICT_INVALID\n    except ValueError as e:\n        # t10 P2: a parse rejection of SIGNED CONTENT (absent/ambiguous\n        # fence, forbidden bytes) is the promised input-invalid exit 3 —\n        # routing it through INFRA let CEO_PAIR_RAIL_VERDICT_OPTIONAL=1\n        # soften a rejection the contract says must stop the release.\n        print(f\"INVALID: verdict content rejected: {e}\", file=sys.stderr)\n        return EXIT_VERDICT_INVALID\n\n    # PLAN-177 W0.1 (P1-4): the DECISION gate. Until this block existed\n    # the validator read pinning, TTL and signature presence but never the\n    # verdict itself: a cross-model NO-GO returned OK / exit 0.\n    #\n    # CF-3 ASYMMETRY (stated in BOTH rails, where it can be acted on):\n    # this step carries `continue-on-error` when\n    # CEO_PAIR_RAIL_VERDICT_OPTIONAL=1 (release.yml:689), so the gate HERE\n    # is defence in depth; the rail that enforces in EVERY mode is\n    # `.claude/scripts/local/_release_tag_guard.py delta`, invoked by a\n    # step with no escape hatch. Neither may be dropped for the other.\n    #\n    # Fail-CLOSED on SHAPE as well as value (CF-1): the reader above\n    # returns a dict for an empty `verdict:` line, so the type check\n    # precedes the compare and a malformed decision exits 3 (INVALID),\n    # never 1 (INFRA) -- which the transition mode is allowed to wave\n    # through. Same precedent as the tool_versions dict check below.\n    # PLAN-177 t2 (P1-a): SHAPE BEFORE VALUE. The counter below and the tag\n    # guard's counter only agree on a canonical block; a non-canonical\n    # top-level line is refused here rather than parsed by two grammars.\n    # INVALID (3), never INFRA (1): the transition mode may wave INFRA\n    # through, and this is a property of the SIGNED bytes, not of the runner.\n    noncanonical = noncanonical_top_level_lines(verdict_text)\n    if noncanonical:\n        print(\n            f\"INVALID: non-canonical top-level key syntax in the verdict \"\n            f\"block: {noncanonical!r} -- a top-level line must be `name:` \"\n            f\"with no whitespace before the colon; list items only INDENTED \"\n            f\"under a bare key, never at the root. \"\n            f\"The two release rails read this file with different \"\n            f\"grammars, so `verdict : NO-GO` followed by `verdict: GO` \"\n            f\"counts as two declarations here and one there; the shape is \"\n            f\"refused instead of guessed.\",\n            file=sys.stderr,\n        )\n        return EXIT_VERDICT_INVALID\n\n    decisions_declared = count_top_level_key(verdict_text, \"verdict\")\n    if decisions_declared > 1:\n        print(\n            f\"INVALID: verdict decision declared more than once \"\n            f\"(x{decisions_declared}) -- the reader is last-wins, so a \"\n            f\"duplicated `verdict:` silently overrides the first; exactly \"\n            f\"one is required.\",\n            file=sys.stderr,\n        )\n        return EXIT_VERDICT_INVALID\n    raw_decision = verdict.get(\"verdict\")\n    if raw_decision is None:\n        shown = \"<absent>\"\n    elif not isinstance(raw_decision, str):\n        shown = \"<non-string:%s>\" % type(raw_decision).__name__\n    else:\n        # ASCII-only trim (t5 P1): `GO<U+00A0>` must FAIL the exact-token\n        # membership below, never be normalized into `GO`.\n        shown = raw_decision.strip(\" \\t\")\n    if shown not in ACCEPTED_DECISIONS:\n        accepted = \"{%s}\" % \", \".join(ACCEPTED_DECISIONS)\n        print(\n            f\"INVALID: verdict decision '{shown}' not in {accepted} -- a \"\n            f\"release requires an explicit authorizing decision from the \"\n            f\"pair-rail. Exact match: no case folding, no substring rule \"\n            f\"(NO-GO contains GO).\",\n            file=sys.stderr,\n        )\n        return EXIT_VERDICT_INVALID\n\n    # R1 S-Sec-3: release_tag bind\n    declared_tag = verdict.get(\"release_tag\", \"\").strip()\n    if declared_tag != args.release_tag:\n        print(\n            f\"INVALID: verdict release_tag mismatch — \"\n            f\"declared='{declared_tag}', argv='{args.release_tag}'\",\n            file=sys.stderr,\n        )\n        return EXIT_VERDICT_INVALID\n\n    # parent_sha / commit_sha bind (S104 redesign — see docstring).\n    # Precedence: --parent-sha (canonical, post-S104) wins. Falls back to\n    # legacy --commit-sha for v1.16.0-era verdicts that still ship the old\n    # field.\n    if args.parent_sha:\n        declared_parent = verdict.get(\"parent_sha\", \"\").strip()\n        if not declared_parent:\n            # New-style validation requested but verdict lacks the field.\n            # Could be a stale verdict generated before the redesign. Fall\n            # back to legacy commit_sha if available; else hard-fail.\n            legacy_sha = verdict.get(\"commit_sha\", \"\").strip()\n            if legacy_sha:\n                print(\n                    f\"ADVISORY: verdict ships legacy commit_sha \"\n                    f\"(='{legacy_sha[:12]}'); --parent-sha bind skipped. \"\n                    f\"Re-author verdict with parent_sha for full S104 \"\n                    f\"bind enforcement.\",\n                    file=sys.stderr,\n                )\n            else:\n                print(\n                    f\"INVALID: verdict missing parent_sha field \"\n                    f\"(--parent-sha='{args.parent_sha[:12]}' requested bind)\",\n                    file=sys.stderr,\n                )\n                return EXIT_VERDICT_INVALID\n        elif declared_parent != args.parent_sha:\n            print(\n                f\"INVALID: verdict parent_sha mismatch — \"\n                f\"declared='{declared_parent[:12]}', \"\n                f\"argv='{args.parent_sha[:12]}'\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n    elif args.commit_sha:\n        # Legacy path — only used when --parent-sha not passed (e.g.\n        # bridging older release.yml invocations against new validator).\n        declared_sha = verdict.get(\"commit_sha\", \"\").strip()\n        if declared_sha != args.commit_sha:\n            print(\n                f\"INVALID: verdict commit_sha mismatch — \"\n                f\"declared='{declared_sha[:12]}', argv='{args.commit_sha[:12]}'\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n\n    # R1 S-QA-Unseen-2: VERDICT_EXPIRED distinct exit code\n    generated_at = verdict.get(\"generated_at\", \"\")\n    if generated_at:\n        try:\n            ts = datetime.fromisoformat(generated_at.rstrip(\"Z\"))\n            if ts.tzinfo is None:\n                ts = ts.replace(tzinfo=timezone.utc)\n            now = datetime.now(timezone.utc)\n            age_hours = (now - ts).total_seconds() / 3600.0\n            if age_hours > args.max_age_hours:\n                print(\n                    f\"EXPIRED: verdict {age_hours:.1f}h old \"\n                    f\"(max {args.max_age_hours}h)\",\n                    file=sys.stderr,\n                )\n                return EXIT_VERDICT_EXPIRED\n        except (TypeError, ValueError):\n            print(f\"INFRA: unparseable generated_at: {generated_at!r}\", file=sys.stderr)\n            return EXIT_INFRA_ERROR\n\n    # R1 S-Sec-4: inputs_hash recompute\n    if args.recompute_inputs_hash and args.inputs_hash_paths_file:\n        try:\n            actual_hash = compute_inputs_hash(\n                repo_root, Path(args.inputs_hash_paths_file)\n            )\n        except (FileNotFoundError, ValueError) as e:\n            print(f\"INFRA: inputs_hash recompute failed: {e}\", file=sys.stderr)\n            return EXIT_INFRA_ERROR\n        declared_hash = verdict.get(\"inputs_hash\", \"\").strip()\n        if declared_hash != actual_hash:\n            print(\n                f\"INVALID: inputs_hash mismatch — \"\n                f\"declared='{declared_hash[:16]}', actual='{actual_hash[:16]}'\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n\n    # R1 C5: Codex CLI pin enforcement\n    if args.codex_cli_pin_file:\n        try:\n            min_v, max_v = parse_pin_range(Path(args.codex_cli_pin_file))\n        except (OSError, ValueError) as exc:\n            print(f\"INVALID: codex CLI pin range rejected: {exc}\", file=sys.stderr); return EXIT_VERDICT_INVALID\n        if min_v:\n            tool_versions = verdict.get(\"tool_versions\", {})\n            if not isinstance(tool_versions, dict):\n                # Codex iter-6 P1 fix — malformed tool_versions (scalar /\n                # non-dict) previously bypassed both semver + binary-SHA\n                # checks. Now hard-fail.\n                print(\n                    f\"INVALID: tool_versions field must be a dict, got \"\n                    f\"{type(tool_versions).__name__}: {tool_versions!r}\",\n                    file=sys.stderr,\n                )\n                return EXIT_VERDICT_INVALID\n            cli_v = tool_versions.get(\"codex_cli\", \"\")\n            comparison = cli_currency.compare_semver(cli_v, min_v)\n            upper_comparison = cli_currency.compare_semver(cli_v, max_v) if max_v else None\n            if (\n                comparison is None\n                or comparison < 0\n                or (max_v is not None and (upper_comparison is None or upper_comparison >= 0))\n            ):\n                range_text = f\">={min_v}\" if max_v is None else f\">={min_v},<{max_v}\"\n                print(\n                    f\"INVALID: codex_cli version {cli_v!r} not in pin \"\n                    f\"range {range_text}\",\n                    file=sys.stderr,\n                )\n                return EXIT_VERDICT_INVALID\n            if comparison > 0 and max_v is None:\n                print(f\"INFO: codex_cli {cli_v} is newer than compatibility floor \"\n                      f\">={min_v}; payload pin uses version-only compatibility\", file=sys.stderr)\n\n    # PLAN-081 Phase 6-bis / T-8: Codex CLI binary SHA-256 pin enforcement\n    if args.codex_cli_binary_sha256_file:\n        pin_path = Path(args.codex_cli_binary_sha256_file)\n        if not pin_path.exists():\n            # ADVISORY skip per Codex iter-1 P1 — missing pin file is a\n            # rollout state (e.g. legacy verdicts pre-Phase-6-bis); do NOT\n            # hard-fail. release.yml step 15 still gates on the codex_cli\n            # semver pin (R1 C5) which is mandatory.\n            print(\n                f\"ADVISORY: codex-cli-binary-sha256-file not found at {pin_path}; \"\n                f\"skipping T-8 binary-SHA pin check (semver pin still enforced)\",\n                file=sys.stderr,\n            )\n            expected_sha = \"\"\n        else:\n            expected_sha = \"\"\n            for line in pin_path.read_text().splitlines():\n                line = line.split(\"#\", 1)[0].strip()\n                if line:\n                    expected_sha = line\n                    break\n        if expected_sha and len(expected_sha) == 64:\n            tool_versions = verdict.get(\"tool_versions\", {})\n            if not isinstance(tool_versions, dict):\n                # Codex iter-7 P1 fix — scalar/non-dict tool_versions\n                # previously silently skipped binary-SHA check (only the\n                # semver pin path enforced dict shape). Hard-fail\n                # consistently regardless of which pin is being checked.\n                print(\n                    f\"INVALID: tool_versions field must be a dict for binary-SHA \"\n                    f\"check, got {type(tool_versions).__name__}: {tool_versions!r}\",\n                    file=sys.stderr,\n                )\n                return EXIT_VERDICT_INVALID\n            declared_binary_sha = tool_versions.get(\n                \"codex_cli_binary_sha256\", \"\"\n            ).strip()\n            if not declared_binary_sha:\n                # When the pin file exists + is non-empty, verdict\n                # envelope MUST carry the binary SHA — missing field is\n                # a regression / pre-rollout legacy state. Per Codex\n                # iter-5 P1 finding, this is hard-fail when pin file\n                # provides authoritative SHA.\n                print(\n                    f\"INVALID: codex-cli-binary-sha256-file pin '{pin_path}' \"\n                    f\"exists + non-empty (sha='{expected_sha[:16]}'), but \"\n                    f\"verdict envelope lacks tool_versions.codex_cli_binary_sha256\",\n                    file=sys.stderr,\n                )\n                return EXIT_VERDICT_INVALID\n            if declared_binary_sha != expected_sha:\n                print(\n                    f\"INVALID: codex_cli_binary_sha256 mismatch — \"\n                    f\"declared='{declared_binary_sha[:16]}', \"\n                    f\"pin='{expected_sha[:16]}'\",\n                    file=sys.stderr,\n                )\n                return EXIT_VERDICT_INVALID\n\n    # ADR-182 (PLAN-163 T5.2): payload-pin manifest enforcement. The\n    # verdict envelope carries the sha256 of the NATIVE codex payload\n    # for the platform triple of the generating run (wire-shape defined\n    # in ADR-182: scalar `tool_versions.codex_payload_sha256` + scalar\n    # `tool_versions.codex_target_triple`); the validator compares it\n    # against `payloads[<triple>].sha256` in the manifest. Fail-CLOSED\n    # on everything except an unreadable manifest file (infra).\n    if args.codex_pin_manifest_file:\n        manifest_path = Path(args.codex_pin_manifest_file)\n        try:\n            manifest_raw = manifest_path.read_text(encoding=\"utf-8\")\n        except OSError as e:\n            print(\n                f\"INFRA: codex-pin-manifest-file unreadable at \"\n                f\"{manifest_path}: {e}\",\n                file=sys.stderr,\n            )\n            return EXIT_INFRA_ERROR\n        try:\n            manifest = json.loads(manifest_raw)\n        except ValueError as e:\n            print(\n                f\"INVALID: codex-pin-manifest-file is not valid JSON \"\n                f\"({e}) — fail-CLOSED per ADR-182\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n        if (\n            not isinstance(manifest, dict)\n            or manifest.get(\"schema\") != 1\n            or cli_currency.parse_semver(manifest.get(\"package_version\")) is None\n            or not isinstance(manifest.get(\"payloads\"), dict)\n        ):\n            print(\n                \"INVALID: codex-pin-manifest-file schema violation \"\n                \"(expected schema=1 + stable package_version + payloads dict) — fail-CLOSED per ADR-182\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n        tool_versions = verdict.get(\"tool_versions\", {})\n        if not isinstance(tool_versions, dict):\n            print(\n                f\"INVALID: tool_versions field must be a dict for \"\n                f\"payload-pin check, got \"\n                f\"{type(tool_versions).__name__}: {tool_versions!r}\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n        declared_triple = str(\n            tool_versions.get(\"codex_target_triple\", \"\")\n        ).strip()\n        declared_payload_sha = str(\n            tool_versions.get(\"codex_payload_sha256\", \"\")\n        ).strip()\n        if not declared_triple or not declared_payload_sha:\n            print(\n                \"INVALID: ADR-182 payload pin requested \"\n                f\"(manifest='{manifest_path}') but verdict envelope \"\n                \"lacks tool_versions.codex_target_triple and/or \"\n                \"tool_versions.codex_payload_sha256\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n        if not re.fullmatch(r\"[0-9a-f]{64}\", declared_payload_sha):\n            print(\"INVALID: verdict codex_payload_sha256 has malformed sha256 \"\n                  \"— fail-CLOSED per ADR-182\", file=sys.stderr)\n            return EXIT_VERDICT_INVALID\n        entry = manifest[\"payloads\"].get(declared_triple)\n        if not isinstance(entry, dict):\n            print(\n                f\"INVALID: targetTriple '{declared_triple}' absent from \"\n                f\"codex-pin-manifest payloads — fail-CLOSED per ADR-182\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n        expected_payload_sha = str(entry.get(\"sha256\", \"\")).strip()\n        if not re.match(r\"^[0-9a-f]{64}$\", expected_payload_sha):\n            print(\n                f\"INVALID: manifest entry for '{declared_triple}' has \"\n                f\"malformed sha256 — fail-CLOSED per ADR-182\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n        package_version = manifest[\"package_version\"]\n        cli_version = tool_versions.get(\"codex_cli\")\n        version_comparison = cli_currency.compare_semver(cli_version, package_version)\n        newer_floor = cli_currency.compare_semver(cli_version, cli_currency.CODEX_VERSION_FLOOR)\n        exact_payload_pin = version_comparison in (None, 0) or newer_floor is None or newer_floor < 0\n        if exact_payload_pin and declared_payload_sha != expected_payload_sha:\n            print(\n                f\"INVALID: codex_payload_sha256 mismatch for \"\n                f\"'{declared_triple}' — \"\n                f\"declared='{declared_payload_sha[:16]}', \"\n                f\"pin='{expected_payload_sha[:16]}'\",\n                file=sys.stderr,\n            )\n            return EXIT_VERDICT_INVALID\n        if not exact_payload_pin:\n            print(f\"INFO: codex_cli {cli_version} is newer than the payload manifest version; \"\n                  \"payload sha is format-validated but not attested by this older manifest\", file=sys.stderr)\n\n    # GPG signature presence (verifies via separate `git verify-tag` in\n    # release.yml; here we just assert the field is present + non-empty)\n    sig = verdict.get(\"gpg_signature\", \"\")\n    if not sig or sig.strip() == \"\":\n        print(\"INVALID: gpg_signature field empty\", file=sys.stderr)\n        return EXIT_VERDICT_INVALID\n\n    print(f\"OK: verdict {args.release_tag} valid\", file=sys.stdout)\n    return EXIT_OK\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":420,"startLine":380,"totalLines":799}},"tool_result_meta":[{"id":"toolu_018k2ivX3FJ82TYyzC4nDbBw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
