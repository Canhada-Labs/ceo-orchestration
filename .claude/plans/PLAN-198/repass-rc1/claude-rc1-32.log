:tarball would ship %d framework-internal artifact(s):\" % len(bad))\n170\t    print(\"\\n\".join(bad[:40]))\n171\t    sys.exit(1)\n172\tprint(\"OK: packlist clean — %d files\" % len(paths))\n173\t'\n174\t\n175\t# -------------------------------- npm pack -----------------------------------\n176\techo \"==> Building tarball\"\n177\tTARBALL=\"$(cd \"$NPM_DIR\" && npm pack 2>/dev/null | tail -1)\"\n178\tTARBALL_PATH=\"$NPM_DIR/$TARBALL\"\n179\t\n180\tif [[ ! -f \"$TARBALL_PATH\" ]]; then\n181\t  echo \"::error::npm pack did not produce $TARBALL_PATH\" >&2\n182\t  exit 1\n183\tfi\n184\tTARBALL_SIZE_KB=$(( $(wc -c < \"$TARBALL_PATH\") / 1024 ))\n185\techo \"OK: tarball built — $TARBALL ($TARBALL_SIZE_KB KB)\"\n186\t\n187\t# -------------------------------- sha256 emission ----------------------------\n188\t# PLAN-019 DevOps-P2-3 — LOCAL build-integrity record.\n189\t#"}]},"parent_tool_use_id":null,"session_id":"3546c686-8b8a-4e60-b084-e75a583ed82f","uuid":"414f66f4-e63b-4ac5-9eff-bbd7edd0acbb","timestamp":"2026-11-13T18:46:29.068Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/scripts/install-npm.sh","content":")\nfor src in scripts templates .claude SPEC VERSION LICENSE README.md PROTOCOL.md; do\n  if [[ -e \"$ROOT/$src\" ]]; then\n    rsync -a --delete --delete-excluded \"${RSYNC_EXCLUDES[@]}\" \"$ROOT/$src\" \"$NPM_DIR/\"\n  fi\ndone\n\n# Sanity: install.sh present in staged bundle.\nif [[ ! -f \"$NPM_DIR/scripts/install.sh\" ]]; then\n  echo \"::error::staged bundle missing scripts/install.sh\" >&2\n  exit 1\nfi\n\n# Syntax-check the shim (mirror npm-publish.yml step).\nnode --check \"$NPM_DIR/bin/ceo-orch-init.js\"\necho \"OK: shim syntax\"\n\n# -------------------------------- packlist gate ------------------------------\n# PLAN-152 tarball-02 (local mirror of the validate.yml / npm-publish.yml\n# gates — Codex pair-rail: npm/ is gitignored and older stagers may have left\n# stale files; the rsync --delete-excluded above mirrors the staged roots, and\n# this gate asserts the WHOLE would-be packlist before npm pack).\necho \"==> Packlist gate\"\n( cd \"$NPM_DIR\" && npm pack --dry-run --json 2>/dev/null ) | python3 -c '\nimport json, re, sys\nd = json.load(sys.stdin)\n# This directory packs one package: npm 11 emits a list or direct record;\n# npm 12.2+ keys the record by package name.\nif isinstance(d, list):\n    o, = d\nelif \"files\" in d:\n    o = d\nelse:\n    o, = d.values()\npaths = [f[\"path\"] for f in o[\"files\"]]\npat = re.compile(r\"(^|/)(tests|fixtures)(/|$)|(^|/)eval/|(^|/)red-team-corpus/|(^|/)plans/PLAN-[0-9]|(^|/)_lib/(testing|test_isolation)\\.py$\")\nallow = (\".claude/policies/fixtures/\", \"templates/oidc-proxy/tests/\")\nbad = [p for p in paths if pat.search(p) and not p.startswith(allow)]\nif bad:\n    print(\"::error::tarball would ship %d framework-internal artifact(s):\" % len(bad))\n    print(\"\\n\".join(bad[:40]))\n    sys.exit(1)\nprint(\"OK: packlist clean — %d files\" % len(paths))\n'\n\n# -------------------------------- npm pack -----------------------------------\necho \"==> Building tarball\"\nTARBALL=\"$(cd \"$NPM_DIR\" && npm pack 2>/dev/null | tail -1)\"\nTARBALL_PATH=\"$NPM_DIR/$TARBALL\"\n\nif [[ ! -f \"$TARBALL_PATH\" ]]; then\n  echo \"::error::npm pack did not produce $TARBALL_PATH\" >&2\n  exit 1\nfi\nTARBALL_SIZE_KB=$(( $(wc -c < \"$TARBALL_PATH\") / 1024 ))\necho \"OK: tarball built — $TARBALL ($TARBALL_SIZE_KB KB)\"\n\n# -------------------------------- sha256 emission ----------------------------\n# PLAN-019 DevOps-P2-3 — LOCAL build-integrity record.\n#","numLines":60,"startLine":130,"totalLines":339}},"tool_result_meta":[{"id":"toolu_01SA67XumQYD9AevLhM21LFs","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
