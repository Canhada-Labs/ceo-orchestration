{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01267FGFBKX2x1wRBkPTZzVo","type":"tool_result","content":"588\tdef _decide_for_role(\n589\t    agent_slug: str,\n590\t    current_tier: str,\n591\t    aggregate: _Aggregate,\n592\t) -> _RoleDecision:\n593\t    \"\"\"Compute per-role winning tier + MIN n + MIN gap_pp across cells.\n594\t\n595\t    Gate ordering (first-match wins):\n596\t        1. No mapped task-types → ``hold`` with no_mapped_task_types.\n597\t        2. Any cell empty (no non-errored samples for ANY model) →\n598\t           ``hold`` with cell_all_errored.\n599\t        3. Cells disagree on best model → ``hold`` with mixed_cell_winners.\n600\t        4. n_min < MIN_N_PER_CELL → ``hold`` with statistical_power.\n601\t        5. Current tier absent from cell (no current-tier samples) →\n602\t           gap_pp cannot be computed → ``hold`` with unknown_model_id.\n603\t        6. gap_pp < MIN_GAP_PP → ``hold`` with statistical_power.\n604\t        7. Otherwise → recommended_tier = consensus-best.\n605\t    \"\"\"\n606\t    task_types = ROLE_TO_TASK_TYPES.get(agent_slug, [])\n607\t    if not task_types:\n608\t        return _RoleDecision(\n609\t            agent_slug=agent_slug,\n610\t            current_tier=current_tier,\n611\t            recommended_tier=current_tier,\n612\t            min_n_across_cells=0,\n613\t            min_gap_pp_across_cells=0.0,\n614\t            cells_considered=0,\n615\t            rejection_reason=REASON_STATISTICAL_POWER,\n616\t        )\n617\t\n618\t    winners: List[str] = []\n619\t    gaps: List[float] = []\n620\t    ns: List[int] = []\n621\t    for tt in task_types:\n622\t        best = _cell_best_model(aggregate, tt)\n623\t        if best is None:\n624\t            return _RoleDecision(\n625\t                agent_slug=agent_slug,\n626\t                current_tier=current_tier,\n627\t                recommended_tier=current_tier,\n628\t                min_n_across_cells=0,\n629\t                min_gap_pp_across_cells=0.0,\n630\t                cells_considered=len(task_types),\n631\t                rejection_reason=REASON_ALL_ERRORED,\n632\t            )\n633\t        best_model, best_rate, cell_n = best\n634\t        current_rate = _cell_current_tier_rate(\n635\t            aggregate, tt, current_tier\n636\t        )\n637\t        if current_rate is None:\n638\t            return _RoleDecision(\n639\t                agent_slug=agent_slug,\n640\t                current_tier=current_tier,\n641\t                recommended_tier=current_tier,\n642\t                min_n_across_cells=cell_n,\n643\t                min_gap_pp_across_cells=0.0,\n644\t                cells_considered=len(task_types),\n645\t                rejection_reason=REASON_UNKNOWN_MODEL,\n646\t            )\n647\t        gap_pp = (best_rate - current_rate) * 100.0\n648\t        winners.append(best_model)\n649\t        gaps.append(gap_pp)\n650\t        ns.append(cell_n)\n651\t\n652\t    if len(set(winners)) > 1:\n653\t        return _RoleDecision(\n654\t            agent_slug=agent_slug,\n655\t            current_tier=current_tier,\n656\t            recommended_tier=current_tier,\n657\t            min_n_across_cells=min(ns),\n658\t            min_gap_pp_across_cells=min(gaps),\n659\t            cells_considered=len(task_types),\n660\t            rejection_reason=REASON_MIXED_WINNERS,\n661\t        )\n662\t\n663\t    winner = winners[0]\n664\t    n_min = min(ns)\n665\t    gap_min = min(gaps)\n666\t\n667\t    if n_min < MIN_N_PER_CELL:\n668\t        return _RoleDecision(\n669\t            agent_slug=agent_slug,\n670\t            current_tier=current_tier,\n671\t            recommended_tier=current_tier,\n672\t            min_n_across_cells=n_min,\n673\t            min_gap_pp_across_cells=gap_min,\n674\t            cells_considered=len(task_types),\n675\t            rejection_reason=REASON_STATISTICAL_POWER,\n676\t        )\n677\t    if gap_min < MIN_GAP_PP:\n678\t        return _RoleDecision(\n679\t            agent_slug=agent_slug,\n680\t            current_tier=current_tier,\n681\t            recommended_tier=winner,\n682\t            min_n_across_cells=n_min,\n683\t            min_gap_pp_across_cells=gap_min,\n684\t            cells_considered=len(task_types),\n685\t            rejection_reason=REASON_STATISTICAL_POWER,\n686\t        )\n687\t    return _RoleDecision(\n688\t        agent_slug=agent_slug,\n689\t        current_tier=current_tier,\n690\t        recommended_tier=winner,\n691\t        min_n_across_cells=n_min,\n692\t        min_gap_pp_across_cells=gap_min,\n693\t        cells_considered=len(task_types),\n694\t    )\n695\t\n696\t\n697\t# ---------------------------------------------------------------------\n698\t# Cooldown + signing gates\n699\t# ---------------------------------------------------------------------\n700\t\n701\tdef _cooldown_ok(\n702\t    agent_slug: str,\n703\t    last_change_by_role: Dict[str, str],\n704\t    now: datetime,\n705\t    cooldown_days: int,\n706\t) -> bool:\n707\t    \"\"\"True iff no change within cooldown window. Genesis = always OK.\"\"\"\n708\t    iso = last_change_by_role.get(agent_slug)\n709\t    if iso is None or iso == \"\":\n710\t        return True\n711\t    prior = _parse_iso8601(iso)\n712\t    if prior is None:\n713\t        return True  # Malformed → fail-open to allow change.\n714\t    delta = now - prior\n715\t    return delta >= timedelta(days=cooldown_days)\n716\t\n717\t\n718\t# ---------------------------------------------------------------------\n719\t# Public API\n720\t# ---------------------------------------------------------------------\n721\t\n722\tdef learn(\n723\t    reports_dir: Path,\n724\t    policy: TierPolicyRecord,\n725\t    *,\n726\t    now: Optional[datetime] = None,\n727\t    cooldown_days: Optional[int] = None,"}]},"parent_tool_use_id":null,"session_id":"3546c686-8b8a-4e60-b084-e75a583ed82f","uuid":"4950bfa8-adbb-4b9e-8b88-356929bb9a54","timestamp":"2026-11-13T18:44:34.073Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/tier_policy_cli/learn.py","content":"def _decide_for_role(\n    agent_slug: str,\n    current_tier: str,\n    aggregate: _Aggregate,\n) -> _RoleDecision:\n    \"\"\"Compute per-role winning tier + MIN n + MIN gap_pp across cells.\n\n    Gate ordering (first-match wins):\n        1. No mapped task-types → ``hold`` with no_mapped_task_types.\n        2. Any cell empty (no non-errored samples for ANY model) →\n           ``hold`` with cell_all_errored.\n        3. Cells disagree on best model → ``hold`` with mixed_cell_winners.\n        4. n_min < MIN_N_PER_CELL → ``hold`` with statistical_power.\n        5. Current tier absent from cell (no current-tier samples) →\n           gap_pp cannot be computed → ``hold`` with unknown_model_id.\n        6. gap_pp < MIN_GAP_PP → ``hold`` with statistical_power.\n        7. Otherwise → recommended_tier = consensus-best.\n    \"\"\"\n    task_types = ROLE_TO_TASK_TYPES.get(agent_slug, [])\n    if not task_types:\n        return _RoleDecision(\n            agent_slug=agent_slug,\n            current_tier=current_tier,\n            recommended_tier=current_tier,\n            min_n_across_cells=0,\n            min_gap_pp_across_cells=0.0,\n            cells_considered=0,\n            rejection_reason=REASON_STATISTICAL_POWER,\n        )\n\n    winners: List[str] = []\n    gaps: List[float] = []\n    ns: List[int] = []\n    for tt in task_types:\n        best = _cell_best_model(aggregate, tt)\n        if best is None:\n            return _RoleDecision(\n                agent_slug=agent_slug,\n                current_tier=current_tier,\n                recommended_tier=current_tier,\n                min_n_across_cells=0,\n                min_gap_pp_across_cells=0.0,\n                cells_considered=len(task_types),\n                rejection_reason=REASON_ALL_ERRORED,\n            )\n        best_model, best_rate, cell_n = best\n        current_rate = _cell_current_tier_rate(\n            aggregate, tt, current_tier\n        )\n        if current_rate is None:\n            return _RoleDecision(\n                agent_slug=agent_slug,\n                current_tier=current_tier,\n                recommended_tier=current_tier,\n                min_n_across_cells=cell_n,\n                min_gap_pp_across_cells=0.0,\n                cells_considered=len(task_types),\n                rejection_reason=REASON_UNKNOWN_MODEL,\n            )\n        gap_pp = (best_rate - current_rate) * 100.0\n        winners.append(best_model)\n        gaps.append(gap_pp)\n        ns.append(cell_n)\n\n    if len(set(winners)) > 1:\n        return _RoleDecision(\n            agent_slug=agent_slug,\n            current_tier=current_tier,\n            recommended_tier=current_tier,\n            min_n_across_cells=min(ns),\n            min_gap_pp_across_cells=min(gaps),\n            cells_considered=len(task_types),\n            rejection_reason=REASON_MIXED_WINNERS,\n        )\n\n    winner = winners[0]\n    n_min = min(ns)\n    gap_min = min(gaps)\n\n    if n_min < MIN_N_PER_CELL:\n        return _RoleDecision(\n            agent_slug=agent_slug,\n            current_tier=current_tier,\n            recommended_tier=current_tier,\n            min_n_across_cells=n_min,\n            min_gap_pp_across_cells=gap_min,\n            cells_considered=len(task_types),\n            rejection_reason=REASON_STATISTICAL_POWER,\n        )\n    if gap_min < MIN_GAP_PP:\n        return _RoleDecision(\n            agent_slug=agent_slug,\n            current_tier=current_tier,\n            recommended_tier=winner,\n            min_n_across_cells=n_min,\n            min_gap_pp_across_cells=gap_min,\n            cells_considered=len(task_types),\n            rejection_reason=REASON_STATISTICAL_POWER,\n        )\n    return _RoleDecision(\n        agent_slug=agent_slug,\n        current_tier=current_tier,\n        recommended_tier=winner,\n        min_n_across_cells=n_min,\n        min_gap_pp_across_cells=gap_min,\n        cells_considered=len(task_types),\n    )\n\n\n# ---------------------------------------------------------------------\n# Cooldown + signing gates\n# ---------------------------------------------------------------------\n\ndef _cooldown_ok(\n    agent_slug: str,\n    last_change_by_role: Dict[str, str],\n    now: datetime,\n    cooldown_days: int,\n) -> bool:\n    \"\"\"True iff no change within cooldown window. Genesis = always OK.\"\"\"\n    iso = last_change_by_role.get(agent_slug)\n    if iso is None or iso == \"\":\n        return True\n    prior = _parse_iso8601(iso)\n    if prior is None:\n        return True  # Malformed → fail-open to allow change.\n    delta = now - prior\n    return delta >= timedelta(days=cooldown_days)\n\n\n# ---------------------------------------------------------------------\n# Public API\n# ---------------------------------------------------------------------\n\ndef learn(\n    reports_dir: Path,\n    policy: TierPolicyRecord,\n    *,\n    now: Optional[datetime] = None,\n    cooldown_days: Optional[int] = None,","numLines":140,"startLine":588,"totalLines":865}},"tool_result_meta":[{"id":"toolu_01267FGFBKX2x1wRBkPTZzVo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
