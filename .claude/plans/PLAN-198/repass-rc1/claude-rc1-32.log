{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JuChBBq9vbrL1hgwUPqPG4","type":"tool_result","content":"930\t\n931\t\n932\tdef _apply_promote(\n933\t    rec: Recommendation,\n934\t    policy: TierPolicyRecord,\n935\t    agents_dir: Path,\n936\t    sigchain_path: Path,\n937\t    *,\n938\t    cost_gate_usd: float,\n939\t    audit_log_path: Optional[Path],\n940\t    sentinel_path: Optional[Path],\n941\t    dry_run: bool,\n942\t    now: datetime,\n943\t) -> ApplyOutcome:\n944\t    \"\"\"Apply a promote rec under the 3-way cost gate (C-P0-4).\"\"\"\n945\t    delta = _project_monthly_cost_delta(\n946\t        rec.agent_slug,\n947\t        rec.current_tier,\n948\t        rec.recommended_tier,\n949\t        audit_log_path=audit_log_path,\n950\t        now=now,\n951\t    )\n952\t    if delta is None or delta > cost_gate_usd:\n953\t        # Convert floats to int cents: canonical_json forbids floats in\n954\t        # HMAC-covered fields; old projected_delta_usd + threshold_usd (float)\n955\t        # caused CanonicalJsonError + dropped events on every gated promote.\n956\t        projected_cents = (\n957\t            int(round(delta * 100)) if delta is not None else None\n958\t        )\n959\t        threshold_cents = int(round(cost_gate_usd * 100))\n960\t        _emit(\n961\t            ACTION_PROMOTE_COST_GATED,\n962\t            agent_slug=rec.agent_slug,\n963\t            from_tier=rec.current_tier,\n964\t            to_tier=rec.recommended_tier,\n965\t            projected_delta_usd_cents=projected_cents,\n966\t            threshold_usd_cents=threshold_cents,\n967\t        )\n968\t        _emit(\n969\t            ACTION_DEMOTE_REQUESTED,\n970\t            agent_slug=rec.agent_slug,\n971\t            from_tier=rec.current_tier,\n972\t            to_tier=rec.recommended_tier,\n973\t            owner_sign_cli=_owner_sign_cli(rec),\n974\t        )\n975\t        return ApplyOutcome(\n976\t            agent_slug=rec.agent_slug,\n977\t            outcome=\"cost_gated\",\n978\t            from_tier=rec.current_tier,\n979\t            to_tier=rec.recommended_tier,\n980\t            detail=\"delta={}\".format(delta),\n981\t        )\n982\t\n983\t    if dry_run:\n984\t        return ApplyOutcome(\n985\t            agent_slug=rec.agent_slug,\n986\t            outcome=\"skipped\",\n987\t            from_tier=rec.current_tier,\n988\t            to_tier=rec.recommended_tier,\n989\t            detail=\"dry_run\",\n990\t        )\n991\t\n992\t    adopter_path = agents_dir / \"{}.md\".format(rec.agent_slug)\n993\t    written = _write_agent_frontmatter(\n994\t        adopter_path, rec.recommended_tier,\n995\t        sentinel_path=sentinel_path,\n996\t    )\n997\t    if not written:\n998\t        return ApplyOutcome(\n999\t            agent_slug=rec.agent_slug,\n1000\t            outcome=\"error\",\n1001\t            from_tier=rec.current_tier,\n1002\t            to_tier=rec.recommended_tier,\n1003\t            detail=\"frontmatter_write_failed\",\n1004\t        )\n1005\t    prior_tip = policy.sigchain_tip_length\n1006\t    _append_sigchain_entry(\n1007\t        sigchain_path,\n1008\t        agent_slug=rec.agent_slug,\n1009\t        from_tier=rec.current_tier,\n1010\t        to_tier=rec.recommended_tier,\n1011\t        action=\"promote\",\n1012\t        author=\"framework-auto\",\n1013\t        sp_chain_id=\"SP-AUTO-{:08x}\".format(prior_tip + 1),\n1014\t        evidence_hmac=(\n1015\t            rec.evidence.tournament_report_hmacs[0]\n1016\t            if rec.evidence.tournament_report_hmacs\n1017\t            else \"0\" * 64\n1018\t        ),\n1019\t        prior_hash=\"0\" * 64,  # cli.py verify walks chain\n1020\t        chain_length=prior_tip + 1,\n1021\t        prior_commit_sha=_git_head_sha() or \"0\" * 40,\n1022\t    )\n1023\t    _emit(\n1024\t        ACTION_PROMOTE_APPLIED,\n1025\t        agent_slug=rec.agent_slug,\n1026\t        from_tier=rec.current_tier,\n1027\t        to_tier=rec.recommended_tier,\n1028\t        evidence_hmac=(\n1029\t            rec.evidence.tournament_report_hmacs[0]\n1030\t            if rec.evidence.tournament_report_hmacs\n1031\t            else None\n1032\t        ),\n1033\t    )\n1034\t    return ApplyOutcome(\n1035\t        agent_slug=rec.agent_slug,\n1036\t        outcome=\"applied\",\n1037\t        from_tier=rec.current_tier,\n1038\t        to_tier=rec.recommended_tier,\n1039\t    )\n1040\t\n1041\t\n1042\tdef _apply_demote(\n1043\t    rec: Recommendation,\n1044\t    adr_scaffold_dir: Path,\n1045\t) -> ApplyOutcome:\n1046\t    \"\"\"Emit demote request + ADR scaffold (no frontmatter mutation).\"\"\"\n1047\t    _emit(\n1048\t        ACTION_DEMOTE_REQUESTED,\n1049\t        agent_slug=rec.agent_slug,\n1050\t        from_tier=rec.current_tier,\n1051\t        to_tier=rec.recommended_tier,\n1052\t        owner_sign_cli=_owner_sign_cli(rec),\n1053\t    )\n1054\t    _emit_adr_amendment_scaffold(\n1055\t        rec.agent_slug,\n1056\t        rec.current_tier,\n1057\t        rec.recommended_tier,\n1058\t        {\n1059\t            \"n\": rec.evidence.n,\n1060\t            \"gap_pp\": rec.evidence.gap_pp,\n1061\t            \"runs_considered\": rec.evidence.runs_considered,\n1062\t        },\n1063\t        adr_scaffold_dir,\n1064\t    )\n1065\t    return ApplyOutcome(\n1066\t        agent_slug=rec.agent_slug,\n1067\t        outcome=\"demote_requested\",\n1068\t        from_tier=rec.current_tier,\n1069\t        to_tier=rec.recommended_tier,\n1070\t    )\n1071\t\n1072\t\n1073\tdef _owner_sign_cli(rec: Recommendation) -> str:\n1074\t    \"\"\"Canonical Owner-signature CLI string for a rec.\"\"\"\n1075\t    return (\n1076\t        \"ceo-tier-policy owner-sign \"\n1077\t        \"--agent {a} --from {f} --to {t} \"\n1078\t        \"--sp-chain-id SP-NNN-<hex>\"\n1079\t    ).format(\n1080\t        a=rec.agent_slug,\n1081\t        f=rec.current_tier,\n1082\t        t=rec.recommended_tier,\n1083\t    )\n1084\t\n1085\t\n1086\tdef _process_single_rec(\n1087\t    rec: Recommendation,\n1088\t    policy: TierPolicyRecord,\n1089\t    agents_dir: Path,\n1090\t    baseline_agents_dir: Path,\n1091\t    sigchain_path: Path,\n1092\t    adr_scaffold_dir: Path,\n1093\t    *,\n1094\t    cost_gate_usd: float,\n1095\t    audit_log_path: Optional[Path],\n1096\t    sentinel_path: Optional[Path],\n1097\t    dry_run: bool,\n1098\t    now: datetime,\n1099\t) -> ApplyOutcome:\n1100\t    \"\"\"Apply a single recommendation. See apply() docstring.\n1101\t\n1102\t    Dispatches to per-action helpers (``_reject_veto_floor``,\n1103\t    ``_reject_hold``, ``_check_adopter_override``, ``_apply_promote``,\n1104\t    ``_apply_demote``). Defense-in-depth VETO re-check runs first\n1105\t    (C-P0-3).\n1106\t    \"\"\"\n1107\t    if rec.agent_slug in VETO_HARDCODE_APPLY:\n1108\t        return _reject_veto_floor(rec)\n1109\t\n1110\t    if rec.action == \"hold\":\n1111\t        return _reject_hold(rec)\n1112\t\n1113\t    override = _check_adopter_override(\n1114\t        rec, agents_dir, baseline_agents_dir\n1115\t    )\n1116\t    if override is not None:\n1117\t        return override\n1118\t\n1119\t    if rec.action == \"promote\":\n1120\t        return _apply_promote(\n1121\t            rec, policy, agents_dir, sigchain_path,\n1122\t            cost_gate_usd=cost_gate_usd,\n1123\t            audit_log_path=audit_log_path,\n1124\t            sentinel_path=sentinel_path,\n1125\t            dry_run=dry_run,\n1126\t            now=now,\n1127\t        )\n1128\t\n1129\t    return _apply_demote(rec, adr_scaffold_dir)\n1130\t\n1131\t\n1132\tdef _git_head_sha() -> Optional[str]:\n1133\t    \"\"\"Return current git HEAD sha via subprocess, None on failure.\"\"\"\n1134\t    try:\n1135\t        import subprocess\n1136\t        result = subprocess.run(\n1137\t            [\"git\", \"rev-parse\", \"HEAD\"],\n1138\t            capture_output=True,\n1139\t            text=True,"}]},"parent_tool_use_id":null,"session_id":"3546c686-8b8a-4e60-b084-e75a583ed82f","uuid":"944555e9-f3a4-4814-9f89-a8524c45de81","timestamp":"2026-11-13T18:53:37.242Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/tier_policy_cli/apply.py","content":"\n\ndef _apply_promote(\n    rec: Recommendation,\n    policy: TierPolicyRecord,\n    agents_dir: Path,\n    sigchain_path: Path,\n    *,\n    cost_gate_usd: float,\n    audit_log_path: Optional[Path],\n    sentinel_path: Optional[Path],\n    dry_run: bool,\n    now: datetime,\n) -> ApplyOutcome:\n    \"\"\"Apply a promote rec under the 3-way cost gate (C-P0-4).\"\"\"\n    delta = _project_monthly_cost_delta(\n        rec.agent_slug,\n        rec.current_tier,\n        rec.recommended_tier,\n        audit_log_path=audit_log_path,\n        now=now,\n    )\n    if delta is None or delta > cost_gate_usd:\n        # Convert floats to int cents: canonical_json forbids floats in\n        # HMAC-covered fields; old projected_delta_usd + threshold_usd (float)\n        # caused CanonicalJsonError + dropped events on every gated promote.\n        projected_cents = (\n            int(round(delta * 100)) if delta is not None else None\n        )\n        threshold_cents = int(round(cost_gate_usd * 100))\n        _emit(\n            ACTION_PROMOTE_COST_GATED,\n            agent_slug=rec.agent_slug,\n            from_tier=rec.current_tier,\n            to_tier=rec.recommended_tier,\n            projected_delta_usd_cents=projected_cents,\n            threshold_usd_cents=threshold_cents,\n        )\n        _emit(\n            ACTION_DEMOTE_REQUESTED,\n            agent_slug=rec.agent_slug,\n            from_tier=rec.current_tier,\n            to_tier=rec.recommended_tier,\n            owner_sign_cli=_owner_sign_cli(rec),\n        )\n        return ApplyOutcome(\n            agent_slug=rec.agent_slug,\n            outcome=\"cost_gated\",\n            from_tier=rec.current_tier,\n            to_tier=rec.recommended_tier,\n            detail=\"delta={}\".format(delta),\n        )\n\n    if dry_run:\n        return ApplyOutcome(\n            agent_slug=rec.agent_slug,\n            outcome=\"skipped\",\n            from_tier=rec.current_tier,\n            to_tier=rec.recommended_tier,\n            detail=\"dry_run\",\n        )\n\n    adopter_path = agents_dir / \"{}.md\".format(rec.agent_slug)\n    written = _write_agent_frontmatter(\n        adopter_path, rec.recommended_tier,\n        sentinel_path=sentinel_path,\n    )\n    if not written:\n        return ApplyOutcome(\n            agent_slug=rec.agent_slug,\n            outcome=\"error\",\n            from_tier=rec.current_tier,\n            to_tier=rec.recommended_tier,\n            detail=\"frontmatter_write_failed\",\n        )\n    prior_tip = policy.sigchain_tip_length\n    _append_sigchain_entry(\n        sigchain_path,\n        agent_slug=rec.agent_slug,\n        from_tier=rec.current_tier,\n        to_tier=rec.recommended_tier,\n        action=\"promote\",\n        author=\"framework-auto\",\n        sp_chain_id=\"SP-AUTO-{:08x}\".format(prior_tip + 1),\n        evidence_hmac=(\n            rec.evidence.tournament_report_hmacs[0]\n            if rec.evidence.tournament_report_hmacs\n            else \"0\" * 64\n        ),\n        prior_hash=\"0\" * 64,  # cli.py verify walks chain\n        chain_length=prior_tip + 1,\n        prior_commit_sha=_git_head_sha() or \"0\" * 40,\n    )\n    _emit(\n        ACTION_PROMOTE_APPLIED,\n        agent_slug=rec.agent_slug,\n        from_tier=rec.current_tier,\n        to_tier=rec.recommended_tier,\n        evidence_hmac=(\n            rec.evidence.tournament_report_hmacs[0]\n            if rec.evidence.tournament_report_hmacs\n            else None\n        ),\n    )\n    return ApplyOutcome(\n        agent_slug=rec.agent_slug,\n        outcome=\"applied\",\n        from_tier=rec.current_tier,\n        to_tier=rec.recommended_tier,\n    )\n\n\ndef _apply_demote(\n    rec: Recommendation,\n    adr_scaffold_dir: Path,\n) -> ApplyOutcome:\n    \"\"\"Emit demote request + ADR scaffold (no frontmatter mutation).\"\"\"\n    _emit(\n        ACTION_DEMOTE_REQUESTED,\n        agent_slug=rec.agent_slug,\n        from_tier=rec.current_tier,\n        to_tier=rec.recommended_tier,\n        owner_sign_cli=_owner_sign_cli(rec),\n    )\n    _emit_adr_amendment_scaffold(\n        rec.agent_slug,\n        rec.current_tier,\n        rec.recommended_tier,\n        {\n            \"n\": rec.evidence.n,\n            \"gap_pp\": rec.evidence.gap_pp,\n            \"runs_considered\": rec.evidence.runs_considered,\n        },\n        adr_scaffold_dir,\n    )\n    return ApplyOutcome(\n        agent_slug=rec.agent_slug,\n        outcome=\"demote_requested\",\n        from_tier=rec.current_tier,\n        to_tier=rec.recommended_tier,\n    )\n\n\ndef _owner_sign_cli(rec: Recommendation) -> str:\n    \"\"\"Canonical Owner-signature CLI string for a rec.\"\"\"\n    return (\n        \"ceo-tier-policy owner-sign \"\n        \"--agent {a} --from {f} --to {t} \"\n        \"--sp-chain-id SP-NNN-<hex>\"\n    ).format(\n        a=rec.agent_slug,\n        f=rec.current_tier,\n        t=rec.recommended_tier,\n    )\n\n\ndef _process_single_rec(\n    rec: Recommendation,\n    policy: TierPolicyRecord,\n    agents_dir: Path,\n    baseline_agents_dir: Path,\n    sigchain_path: Path,\n    adr_scaffold_dir: Path,\n    *,\n    cost_gate_usd: float,\n    audit_log_path: Optional[Path],\n    sentinel_path: Optional[Path],\n    dry_run: bool,\n    now: datetime,\n) -> ApplyOutcome:\n    \"\"\"Apply a single recommendation. See apply() docstring.\n\n    Dispatches to per-action helpers (``_reject_veto_floor``,\n    ``_reject_hold``, ``_check_adopter_override``, ``_apply_promote``,\n    ``_apply_demote``). Defense-in-depth VETO re-check runs first\n    (C-P0-3).\n    \"\"\"\n    if rec.agent_slug in VETO_HARDCODE_APPLY:\n        return _reject_veto_floor(rec)\n\n    if rec.action == \"hold\":\n        return _reject_hold(rec)\n\n    override = _check_adopter_override(\n        rec, agents_dir, baseline_agents_dir\n    )\n    if override is not None:\n        return override\n\n    if rec.action == \"promote\":\n        return _apply_promote(\n            rec, policy, agents_dir, sigchain_path,\n            cost_gate_usd=cost_gate_usd,\n            audit_log_path=audit_log_path,\n            sentinel_path=sentinel_path,\n            dry_run=dry_run,\n            now=now,\n        )\n\n    return _apply_demote(rec, adr_scaffold_dir)\n\n\ndef _git_head_sha() -> Optional[str]:\n    \"\"\"Return current git HEAD sha via subprocess, None on failure.\"\"\"\n    try:\n        import subprocess\n        result = subprocess.run(\n            [\"git\", \"rev-parse\", \"HEAD\"],\n            capture_output=True,\n            text=True,","numLines":210,"startLine":930,"totalLines":1147}},"tool_result_meta":[{"id":"toolu_01JuChBBq9vbrL1hgwUPqPG4","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
