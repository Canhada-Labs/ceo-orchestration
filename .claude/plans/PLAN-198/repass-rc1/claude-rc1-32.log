{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y28MqAcHUEotcjHTwixmmp","type":"tool_result","content":"60\t- 1: infra error (file missing / unparseable / etc.); release.yml\n61\t     decides based on CEO_PAIR_RAIL_VERDICT_OPTIONAL.\n62\t- 2: VERDICT_EXPIRED — distinct from infra-error per R1 S-QA-Unseen-2.\n63\t     Release.yml can route this to a \"verdict regen\" branch.\n64\t- 3: VERDICT_INVALID — decision not authorizing (PLAN-177 W0.1) /\n65\t     non-canonical top-level key syntax, i.e. a spelling this reader and\n66\t     the local tag guard resolve differently (PLAN-177 t2) /\n67\t     release_tag mismatch / parent_sha mismatch / inputs_hash mismatch /\n68\t     pin mismatch / signature missing. Release MUST stop here.\n69\t\n70\tstdlib only. Python ≥3.9.\n71\t\"\"\"\n72\t\n73\tfrom __future__ import annotations\n74\t\n75\timport argparse\n76\timport hashlib\n77\timport json\n78\timport re\n79\timport subprocess\n80\timport sys\n81\tfrom datetime import datetime, timezone\n82\tfrom pathlib import Path\n83\tfrom typing import Any, Dict, List, Optional, Tuple\n84\t\n85\t_REPO_ROOT = Path(__file__).resolve().parents[2]\n86\t_HOOKS_DIR = _REPO_ROOT / \".claude\" / \"hooks\"\n87\tsys.path.insert(0, str(_HOOKS_DIR)) if str(_HOOKS_DIR) not in sys.path else None\n88\tfrom _lib import cli_currency  # noqa: E402\n89\t\n90\tEXIT_OK = 0\n91\tEXIT_INFRA_ERROR = 1\n92\tEXIT_VERDICT_EXPIRED = 2\n93\tEXIT_VERDICT_INVALID = 3\n94\t\n95\t# PLAN-177 W0.1 (P1-4). The decisions that AUTHORIZE a release. Every other\n96\t# value — NO-GO, absent, empty, malformed, or simply unknown — is\n97\t# non-authorizing and stops the release. Spelling is the template's\n98\t# (.claude/governance/pair-rail-verdict-template.md:\n99\t# `verdict: GO | NO-GO | GO-WITH-CONDITIONS`); membership is tested by EXACT\n100\t# equality on purpose — case folding or a substring/prefix rule would read\n101\t# NO-GO as authorizing because it CONTAINS GO.\n102\tACCEPTED_DECISIONS = (\"GO\", \"GO-WITH-CONDITIONS\")\n103\t\n104\t\n105\t# t8 P1 (root cause below the finding): Python \\s is Unicode-aware, so\n106\t# `\\s*` after the fence opener SWALLOWED a leading U+00A0 line before\n107\t# the shape classifier ever saw it. ASCII-only here, like every other\n108\t# trim in this reader.\n109\t_YAML_BLOCK_RE = re.compile(r\"```yaml[ \\t]*\\n(.*?)```\", re.DOTALL)  # legacy: superseded by _extract_single_yaml_block below\n110\t\n111\t# t9 P1 (both twins): ONE strict extractor for the signed yaml block.\n112\t#   * the artifact must contain EXACTLY ONE occurrence of the literal\n113\t#     ```yaml anywhere in the text — a second occurrence (even quoted\n114\t#     inside a four-backtick block) makes the authoritative block\n115\t#     ambiguous, so the artifact is rejected fail-closed;\n116\t#   * the opener must sit at line start, column 0, exactly three\n117\t#     backticks, closed by a line-start ``` — an unanchored search let a\n118\t#     quoted GO envelope inside a ````-fence shadow the real NO-GO one;\n119\t#   * the block must be free of every line separator except \\n and of\n120\t#     every control char except \\t: str.splitlines() also splits on\n121\t#     U+000B/000C/001C-001E/0085/2028/2029, so `GO<U+000B>#NO-GO`\n122\t#     parsed as the exact token GO on both rails (t9 P1 #2). CR included:\n123\t#     the generator only ever emits LF.\n124\t# Returns the block body, or None when the artifact is rejected.\n125\t_FORBIDDEN_CTRL_RE = re.compile(\n126\t    \"[\\u0000-\\u0008\\u000b-\\u001f\\u007f\\u0085\\u2028\\u2029]\"\n127\t)\n128\t\n129\t\n130\tdef _extract_single_yaml_block(text):\n131\t    if text.count(\"```yaml\") != 1:\n132\t        return None\n133\t    # t12 P1: the FIRST fence of the document must BE the canonical\n134\t    # yaml opener — a complete envelope quoted inside a four-backtick\n135\t    # block as the document's ONLY ```yaml occurrence passed the\n136\t    # count==1 gate and became authoritative while the real decision\n137\t    # sat in prose. Any fence-looking line BEFORE the opener rejects.\n138\t    _first_fence = re.search(r\"(?m)^`{3,}\", text)\n139\t    if _first_fence is not None and not text[\n140\t        _first_fence.start():\n141\t    ].startswith(\"```yaml\"):\n142\t        return None\n143\t    # t10 P1: the CLOSER must be canonical too — a bare ^``` matched\n144\t    # ANY line starting with three backticks, so ```not-a-closer\n145\t    # closed the body early and hid a later NO-GO.\n146\t    m = re.search(\n147\t        r\"(?m)^```yaml[ \\t]*\\n(.*?)^```[ \\t]*(?:\\n|\\Z)\",\n148\t        text,\n149\t        re.DOTALL,\n150\t    )\n151\t    if not m:\n152\t        return None\n153\t    body = m.group(1)\n154\t    if _FORBIDDEN_CTRL_RE.search(body):\n155\t        return None\n156\t    return body\n157\t\n158\t\n159\t\n160\tdef _strip_comment(raw: str) -> str:\n161\t    \"\"\"YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at\n162\t    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the\n163\t    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Truncating\n164\t    at every `#` authorized that value on both rails. Byte-for-byte twin of\n165\t    `_strip_yaml_comment` in _release_tag_guard.py.\n166\t    \"\"\"\n167\t    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()\n168\t    # silently converted `GO<U+00A0>` into the authorizing token `GO`.\n169\t    if raw.lstrip(\" \\t\").startswith(\"#\"):\n170\t        return \"\"\n171\t    i = 0\n172\t    while True:\n173\t        j = raw.find(\"#\", i)\n174\t        if j == -1:\n175\t            return raw.rstrip(\" \\t\")\n176\t        if j > 0 and raw[j - 1] in (\" \", \"\\t\"):\n177\t            return raw[:j].rstrip(\" \\t\")\n178\t        i = j + 1\n179\t\n180\t\n181\t# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.\n182\t# Two readers of the same signed file must not disagree about what a key\n183\t# IS: this validator counted `verdict : NO-GO` as a declaration of\n184\t# `verdict` (it strips the key), while the local tag guard's regex demanded\n185\t# the colon immediately after the name and skipped the line entirely. The\n186\t# valid-YAML pair\n187\t#\n188\t#     verdict : NO-GO\n189\t#     verdict: GO\n190\t#\n191\t# is therefore two declarations here and ONE (=GO) there — a last-wins\n192\t# override that the rail enforcing in every mode never saw.\n193\t#\n194\t# The semantics chosen for BOTH rails, and the reason: NON-CANONICAL\n195\t# top-level syntax is REJECTED, fail-closed. Trimming the key in both\n196\t# readers would also close the divergence, but it widens the grammar of a\n197\t# SIGNED artifact to shapes no author writes and no template emits — every\n198\t# new accepted spelling is another chance for the next reader to disagree.\n199\t# Refusing the shape is a smaller surface and is the one behaviour that\n200\t# cannot silently prefer a value. A top-level line is canonical iff it is\n201\t# `name:` with no whitespace before the colon; list items are legal\n202\t# ONLY indented under an active bare key (t8 P2: a root `- item` is\n203\t# rejected — the old comment said otherwise and misled operators).\n204\t_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r\"\\A[A-Za-z0-9_]+:(?:[ \\t]|\\Z)\")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping\n205\t\n206\t\n207\tdef noncanonical_top_level_lines(text: str) -> List[str]:\n208\t    \"\"\"Top-level lines of the yaml block that are not canonical declarations.\n209\t\n210\t    Byte-for-byte twin of `_noncanonical_top_level_lines` in\n211\t    `.claude/scripts/local/_release_tag_guard.py` (separate processes on\n212\t    separate machines; neither may import the other — keep them identical).\n213\t    Empty list == the block speaks the grammar both readers assume.\n214\t    \"\"\"\n215\t    body = _extract_single_yaml_block(text)\n216\t    if body is None:\n217\t        # Ambiguous/absent/forbidden-bytes block: the artifact as a WHOLE\n218\t        # is noncanonical — surface a synthetic offender so every caller\n219\t        # that gates on \"empty == canonical\" fails closed.\n220\t        return [\"<yaml block rejected: ambiguous fence, bad opener, or \"\n221\t                \"forbidden control/separator bytes>\"]\n222\t    bad: List[str] = []\n223\t    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an\n224\t    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.\n225\t    # Both None (before any key) and \"scalar\" reject — an orphan-indented\n226\t    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped\n227\t    # through the prev_scalar_decl=False initial state and resolved as GO,\n228\t    # and a root-level `- item` is malformed for this signed format (its\n229\t    # only lists are INDENTED under a bare key) yet was accepted outright.\n230\t    # After a SCALAR `key: value`, an indented non-comment line is a YAML\n231\t    # CONTINUATION that changes the scalar's value (`verdict: GO` +\n232\t    # `  NO-GO` == \"GO NO-GO\") — reject fail-closed (re-pass rc.4 t2 P1).\n233\t    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware\n234\t    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a\n235\t    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),\n236\t    # reopening the orphan-indentation class through the whitespace side.\n237\t    parent = None  # None | \"scalar\" | \"bare\"\n238\t    for raw in body.split(\"\\n\"):\n239\t        line = _strip_comment(raw)\n240\t        if not line.strip(\" \\t\"):\n241\t            continue\n242\t        if line[0] in (\" \", \"\\t\"):\n243\t            if parent != \"bare\":\n244\t                bad.append(line)\n245\t            continue\n246\t        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):\n247\t            _key, _, _val = line.partition(\":\")\n248\t            parent = \"scalar\" if _val.strip(\" \\t\") else \"bare\"\n249\t            continue\n250\t        bad.append(line)\n251\t        parent = None\n252\t    return bad\n253\t\n254\t\n255\tdef count_top_level_key(text: str, key: str) -> int:\n256\t    \"\"\"How many times `key:` is declared at the top level of the block.\n257\t\n258\t    Both readers of this signed file are LAST-WINS, so a second\n259\t    `verdict:` silently overrides the first: NO-GO followed by GO parses\n260\t    as GO. Callers require exactly one.\n261\t\n262\t    Only meaningful once `noncanonical_top_level_lines` is empty: this\n263\t    counter strips the key, so it sees `verdict : X` as a declaration and\n264\t    the twin counter in the tag guard does not. Callers run the shape\n265\t    check FIRST.\n266\t    \"\"\"\n267\t    _body = _extract_single_yaml_block(text)\n268\t    if _body is None:\n269\t        return 0\n270\t    seen = 0\n271\t    for raw in _body.split(\"\\n\"):\n272\t        line = _strip_comment(raw)\n273\t        if not line.strip() or line[0] in (\" \", \"\\t\"):\n274\t            continue\n275\t        if line.partition(\":\")[0].strip() == key:\n276\t            seen += 1\n277\t    return seen\n278\t\n279\t\n280\tdef parse_verdict_text(text: str) -> Dict[str, Any]:\n281\t    \"\"\"Parse YAML frontmatter from verdict TEXT. Returns dict.\"\"\"\n282\t    yaml_body = _extract_single_yaml_block(text)\n283\t    if yaml_body is None:\n284\t        raise ValueError(\n285\t            \"verdict yaml block rejected: absent, ambiguous fence, or \"\n286\t            \"forbidden control/separator bytes\"\n287\t        )\n288\t    # Inline minimal YAML parse (stdlib only)\n289\t    out: Dict[str, Any] = {}\n290\t    current_key: Optional[str] = None\n291\t    for raw in yaml_body.split(\"\\n\"):\n292\t        line = _strip_comment(raw)\n293\t        if not line.strip():\n294\t            continue\n295\t        if line[0] not in (\" \", \"\\t\"):\n296\t            if \":\" in line:\n297\t                k, _, v = line.partition(\":\")\n298\t                # ASCII-only value trim (t5 P1): a Unicode strip() would\n299\t                # normalize `GO<U+00A0>` into the exact authorizing token.\n300\t                v = v.strip(\" \\t\")\n301\t                if v:\n302\t                    out[k.strip(\" \\t\")] = v\n303\t                else:\n304\t                    out[k.strip(\" \\t\")] = {}\n305\t                    current_key = k.strip(\" \\t\")\n306\t        elif current_key and \":\" in line:\n307\t            sub_k, _, sub_v = line.partition(\":\")\n308\t            if isinstance(out[current_key], dict):\n309\t                out[current_key][sub_k.strip(\" \\t\")] = sub_v.strip(\" \\t\")\n310\t    return out\n311\t\n312\t\n313\tdef parse_verdict_file(path: Path) -> Dict[str, Any]:\n314\t    \"\"\"Path wrapper over parse_verdict_text (published entry point).\"\"\"\n315\t    if not path.exists():\n316\t        raise FileNotFoundError(f\"verdict file: {path}\")\n317\t    # t10 P2: raw bytes, NO universal-newline translation — read_text()\n318\t    # silently ate the CR that the grammar promises to reject.\n319\t    return parse_verdict_text(path.read_bytes().decode(\"utf-8\"))\n320\t\n321\t\n322\tdef compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:\n323\t    \"\"\"Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4).\"\"\"\n324\t    if not manifest_path.exists():\n325\t        raise FileNotFoundError(f\"manifest: {manifest_path}\")\n326\t    paths = []\n327\t    for line in manifest_path.read_text().splitlines():\n328\t        line = line.split(\"#\", 1)[0].strip()\n329\t        if line:\n330\t            paths.append(line)\n331\t    paths.sort()\n332\t    hashes = {}\n333\t    for p in paths:\n334\t        result = subprocess.run(\n335\t            [\"git\", \"hash-object\", p],\n336\t            capture_output=True, text=True, cwd=str(repo_root), timeout=10,\n337\t        )\n338\t        if result.returncode != 0:\n339\t            raise ValueError(f\"git hash-object failed for {p}: {result.stderr}\")\n340\t        hashes[p] = result.stdout.strip()\n341\t    canon = json.dumps(hashes, sort_keys=True, separators=(\",\", \":\"))\n342\t    return hashlib.sha256(canon.encode(\"utf-8\")).hexdigest()\n343\t\n344\t\n345\tdef parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:\n346\t    \"\"\"Parse a stable ``>=floor`` range with an optional legacy upper bound.\"\"\"\n347\t    if not pin_file.exists():\n348\t        return None, None\n349\t    for line in pin_file.read_text().splitlines():\n350\t        line = line.split(\"#\", 1)[0].strip()\n351\t        if not line:\n352\t            continue\n353\t        m = re.fullmatch(r\">=\\s*([^,\\s]+)(?:\\s*,\\s*<\\s*([^,\\s]+))?\", line)\n354\t        if m and cli_currency.parse_semver(m.group(1)) is not None:\n355\t            upper = m.group(2)\n356\t            if upper is None or cli_currency.parse_semver(upper) is not None:\n357\t                return m.group(1), upper\n358\t        raise ValueError(\"pin range must be >=MAJOR.MINOR.PATCH with optional < upper bound\")\n359\t    return None, None\n360\t\n361\t\n362\tdef main(argv: Optional[List[str]] = None) -> int:\n363\t    parser = argparse.ArgumentParser()\n364\t    parser.add_argument(\"--verdict-file\", required=True)\n365\t    parser.add_argument(\n366\t        \"--parent-sha\",\n367\t        default=\"\",\n368\t        help=(\n369\t            \"Expected verdict.parent_sha — the commit the verdict was \"\n370\t            \"generated against (parent of the verdict-file commit). \"\n371\t            \"Resolves the self-reference problem the legacy --commit-sha \"\n372\t            \"bind had with PLAN-081 v1.16.0 GA. Empty string = skip bind.\"\n373\t        ),\n374\t    )\n375\t    parser.add_argument(\n376\t        \"--commit-sha\",\n377\t        default=\"\",\n378\t        help=(\n379\t            \"DEPRECATED legacy bind. Retained for backward-compat with \""}]},"parent_tool_use_id":null,"session_id":"57bd0a0f-ef05-4951-aa49-b19ce0916105","uuid":"908ad93b-11dd-4a35-8f52-8f5bb61156e8","timestamp":"2026-11-15T11:37:19.150Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.github/scripts/validate-pair-rail-verdict.py","content":"- 1: infra error (file missing / unparseable / etc.); release.yml\n     decides based on CEO_PAIR_RAIL_VERDICT_OPTIONAL.\n- 2: VERDICT_EXPIRED — distinct from infra-error per R1 S-QA-Unseen-2.\n     Release.yml can route this to a \"verdict regen\" branch.\n- 3: VERDICT_INVALID — decision not authorizing (PLAN-177 W0.1) /\n     non-canonical top-level key syntax, i.e. a spelling this reader and\n     the local tag guard resolve differently (PLAN-177 t2) /\n     release_tag mismatch / parent_sha mismatch / inputs_hash mismatch /\n     pin mismatch / signature missing. Release MUST stop here.\n\nstdlib only. Python ≥3.9.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport re\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n_REPO_ROOT = Path(__file__).resolve().parents[2]\n_HOOKS_DIR = _REPO_ROOT / \".claude\" / \"hooks\"\nsys.path.insert(0, str(_HOOKS_DIR)) if str(_HOOKS_DIR) not in sys.path else None\nfrom _lib import cli_currency  # noqa: E402\n\nEXIT_OK = 0\nEXIT_INFRA_ERROR = 1\nEXIT_VERDICT_EXPIRED = 2\nEXIT_VERDICT_INVALID = 3\n\n# PLAN-177 W0.1 (P1-4). The decisions that AUTHORIZE a release. Every other\n# value — NO-GO, absent, empty, malformed, or simply unknown — is\n# non-authorizing and stops the release. Spelling is the template's\n# (.claude/governance/pair-rail-verdict-template.md:\n# `verdict: GO | NO-GO | GO-WITH-CONDITIONS`); membership is tested by EXACT\n# equality on purpose — case folding or a substring/prefix rule would read\n# NO-GO as authorizing because it CONTAINS GO.\nACCEPTED_DECISIONS = (\"GO\", \"GO-WITH-CONDITIONS\")\n\n\n# t8 P1 (root cause below the finding): Python \\s is Unicode-aware, so\n# `\\s*` after the fence opener SWALLOWED a leading U+00A0 line before\n# the shape classifier ever saw it. ASCII-only here, like every other\n# trim in this reader.\n_YAML_BLOCK_RE = re.compile(r\"```yaml[ \\t]*\\n(.*?)```\", re.DOTALL)  # legacy: superseded by _extract_single_yaml_block below\n\n# t9 P1 (both twins): ONE strict extractor for the signed yaml block.\n#   * the artifact must contain EXACTLY ONE occurrence of the literal\n#     ```yaml anywhere in the text — a second occurrence (even quoted\n#     inside a four-backtick block) makes the authoritative block\n#     ambiguous, so the artifact is rejected fail-closed;\n#   * the opener must sit at line start, column 0, exactly three\n#     backticks, closed by a line-start ``` — an unanchored search let a\n#     quoted GO envelope inside a ````-fence shadow the real NO-GO one;\n#   * the block must be free of every line separator except \\n and of\n#     every control char except \\t: str.splitlines() also splits on\n#     U+000B/000C/001C-001E/0085/2028/2029, so `GO<U+000B>#NO-GO`\n#     parsed as the exact token GO on both rails (t9 P1 #2). CR included:\n#     the generator only ever emits LF.\n# Returns the block body, or None when the artifact is rejected.\n_FORBIDDEN_CTRL_RE = re.compile(\n    \"[\\u0000-\\u0008\\u000b-\\u001f\\u007f\\u0085\\u2028\\u2029]\"\n)\n\n\ndef _extract_single_yaml_block(text):\n    if text.count(\"```yaml\") != 1:\n        return None\n    # t12 P1: the FIRST fence of the document must BE the canonical\n    # yaml opener — a complete envelope quoted inside a four-backtick\n    # block as the document's ONLY ```yaml occurrence passed the\n    # count==1 gate and became authoritative while the real decision\n    # sat in prose. Any fence-looking line BEFORE the opener rejects.\n    _first_fence = re.search(r\"(?m)^`{3,}\", text)\n    if _first_fence is not None and not text[\n        _first_fence.start():\n    ].startswith(\"```yaml\"):\n        return None\n    # t10 P1: the CLOSER must be canonical too — a bare ^``` matched\n    # ANY line starting with three backticks, so ```not-a-closer\n    # closed the body early and hid a later NO-GO.\n    m = re.search(\n        r\"(?m)^```yaml[ \\t]*\\n(.*?)^```[ \\t]*(?:\\n|\\Z)\",\n        text,\n        re.DOTALL,\n    )\n    if not m:\n        return None\n    body = m.group(1)\n    if _FORBIDDEN_CTRL_RE.search(body):\n        return None\n    return body\n\n\n\ndef _strip_comment(raw: str) -> str:\n    \"\"\"YAML comment rule (re-pass rc.4 t3 P1): `#` starts a comment ONLY at\n    line start or when PRECEDED by whitespace — `verdict: GO#NO-GO` is the\n    single unknown VALUE `GO#NO-GO`, never `GO` plus a comment. Truncating\n    at every `#` authorized that value on both rails. Byte-for-byte twin of\n    `_strip_yaml_comment` in _release_tag_guard.py.\n    \"\"\"\n    # ASCII-only trims (re-pass rc.4 t5 P1): Unicode-aware strip()/rstrip()\n    # silently converted `GO<U+00A0>` into the authorizing token `GO`.\n    if raw.lstrip(\" \\t\").startswith(\"#\"):\n        return \"\"\n    i = 0\n    while True:\n        j = raw.find(\"#\", i)\n        if j == -1:\n            return raw.rstrip(\" \\t\")\n        if j > 0 and raw[j - 1] in (\" \", \"\\t\"):\n            return raw[:j].rstrip(\" \\t\")\n        i = j + 1\n\n\n# PLAN-177 t2 (re-pass rc.4 P1-a). The CANONICAL top-level declaration.\n# Two readers of the same signed file must not disagree about what a key\n# IS: this validator counted `verdict : NO-GO` as a declaration of\n# `verdict` (it strips the key), while the local tag guard's regex demanded\n# the colon immediately after the name and skipped the line entirely. The\n# valid-YAML pair\n#\n#     verdict : NO-GO\n#     verdict: GO\n#\n# is therefore two declarations here and ONE (=GO) there — a last-wins\n# override that the rail enforcing in every mode never saw.\n#\n# The semantics chosen for BOTH rails, and the reason: NON-CANONICAL\n# top-level syntax is REJECTED, fail-closed. Trimming the key in both\n# readers would also close the divergence, but it widens the grammar of a\n# SIGNED artifact to shapes no author writes and no template emits — every\n# new accepted spelling is another chance for the next reader to disagree.\n# Refusing the shape is a smaller surface and is the one behaviour that\n# cannot silently prefer a value. A top-level line is canonical iff it is\n# `name:` with no whitespace before the colon; list items are legal\n# ONLY indented under an active bare key (t8 P2: a root `- item` is\n# rejected — the old comment said otherwise and misled operators).\n_CANONICAL_TOP_LEVEL_KEY_RE = re.compile(r\"\\A[A-Za-z0-9_]+:(?:[ \\t]|\\Z)\")  # t5 P1: separator required — `verdict:GO` is NOT a YAML mapping\n\n\ndef noncanonical_top_level_lines(text: str) -> List[str]:\n    \"\"\"Top-level lines of the yaml block that are not canonical declarations.\n\n    Byte-for-byte twin of `_noncanonical_top_level_lines` in\n    `.claude/scripts/local/_release_tag_guard.py` (separate processes on\n    separate machines; neither may import the other — keep them identical).\n    Empty list == the block speaks the grammar both readers assume.\n    \"\"\"\n    body = _extract_single_yaml_block(text)\n    if body is None:\n        # Ambiguous/absent/forbidden-bytes block: the artifact as a WHOLE\n        # is noncanonical — surface a synthetic offender so every caller\n        # that gates on \"empty == canonical\" fails closed.\n        return [\"<yaml block rejected: ambiguous fence, bad opener, or \"\n                \"forbidden control/separator bytes>\"]\n    bad: List[str] = []\n    # Parent state closes the line whitelist (re-pass rc.4 t7 P1): an\n    # indented line is legitimate ONLY under an ACTIVE bare `key:` parent.\n    # Both None (before any key) and \"scalar\" reject — an orphan-indented\n    # FIRST line (`  verdict: NO-GO` then `verdict: GO`) previously slipped\n    # through the prev_scalar_decl=False initial state and resolved as GO,\n    # and a root-level `- item` is malformed for this signed format (its\n    # only lists are INDENTED under a bare key) yet was accepted outright.\n    # After a SCALAR `key: value`, an indented non-comment line is a YAML\n    # CONTINUATION that changes the scalar's value (`verdict: GO` +\n    # `  NO-GO` == \"GO NO-GO\") — reject fail-closed (re-pass rc.4 t2 P1).\n    # t8 P1: ASCII-only trims in the SHAPE classifier too — a Unicode-aware\n    # strip() treats a lone U+00A0 as a blank line and a U+00A0 VALUE as a\n    # bare parent (`padding: <NBSP>` + orphan-indented `verdict:` line),\n    # reopening the orphan-indentation class through the whitespace side.\n    parent = None  # None | \"scalar\" | \"bare\"\n    for raw in body.split(\"\\n\"):\n        line = _strip_comment(raw)\n        if not line.strip(\" \\t\"):\n            continue\n        if line[0] in (\" \", \"\\t\"):\n            if parent != \"bare\":\n                bad.append(line)\n            continue\n        if _CANONICAL_TOP_LEVEL_KEY_RE.match(line):\n            _key, _, _val = line.partition(\":\")\n            parent = \"scalar\" if _val.strip(\" \\t\") else \"bare\"\n            continue\n        bad.append(line)\n        parent = None\n    return bad\n\n\ndef count_top_level_key(text: str, key: str) -> int:\n    \"\"\"How many times `key:` is declared at the top level of the block.\n\n    Both readers of this signed file are LAST-WINS, so a second\n    `verdict:` silently overrides the first: NO-GO followed by GO parses\n    as GO. Callers require exactly one.\n\n    Only meaningful once `noncanonical_top_level_lines` is empty: this\n    counter strips the key, so it sees `verdict : X` as a declaration and\n    the twin counter in the tag guard does not. Callers run the shape\n    check FIRST.\n    \"\"\"\n    _body = _extract_single_yaml_block(text)\n    if _body is None:\n        return 0\n    seen = 0\n    for raw in _body.split(\"\\n\"):\n        line = _strip_comment(raw)\n        if not line.strip() or line[0] in (\" \", \"\\t\"):\n            continue\n        if line.partition(\":\")[0].strip() == key:\n            seen += 1\n    return seen\n\n\ndef parse_verdict_text(text: str) -> Dict[str, Any]:\n    \"\"\"Parse YAML frontmatter from verdict TEXT. Returns dict.\"\"\"\n    yaml_body = _extract_single_yaml_block(text)\n    if yaml_body is None:\n        raise ValueError(\n            \"verdict yaml block rejected: absent, ambiguous fence, or \"\n            \"forbidden control/separator bytes\"\n        )\n    # Inline minimal YAML parse (stdlib only)\n    out: Dict[str, Any] = {}\n    current_key: Optional[str] = None\n    for raw in yaml_body.split(\"\\n\"):\n        line = _strip_comment(raw)\n        if not line.strip():\n            continue\n        if line[0] not in (\" \", \"\\t\"):\n            if \":\" in line:\n                k, _, v = line.partition(\":\")\n                # ASCII-only value trim (t5 P1): a Unicode strip() would\n                # normalize `GO<U+00A0>` into the exact authorizing token.\n                v = v.strip(\" \\t\")\n                if v:\n                    out[k.strip(\" \\t\")] = v\n                else:\n                    out[k.strip(\" \\t\")] = {}\n                    current_key = k.strip(\" \\t\")\n        elif current_key and \":\" in line:\n            sub_k, _, sub_v = line.partition(\":\")\n            if isinstance(out[current_key], dict):\n                out[current_key][sub_k.strip(\" \\t\")] = sub_v.strip(\" \\t\")\n    return out\n\n\ndef parse_verdict_file(path: Path) -> Dict[str, Any]:\n    \"\"\"Path wrapper over parse_verdict_text (published entry point).\"\"\"\n    if not path.exists():\n        raise FileNotFoundError(f\"verdict file: {path}\")\n    # t10 P2: raw bytes, NO universal-newline translation — read_text()\n    # silently ate the CR that the grammar promises to reject.\n    return parse_verdict_text(path.read_bytes().decode(\"utf-8\"))\n\n\ndef compute_inputs_hash(repo_root: Path, manifest_path: Path) -> str:\n    \"\"\"Compute inputs_hash via git hash-object + canonical_json (R1 S-Sec-4).\"\"\"\n    if not manifest_path.exists():\n        raise FileNotFoundError(f\"manifest: {manifest_path}\")\n    paths = []\n    for line in manifest_path.read_text().splitlines():\n        line = line.split(\"#\", 1)[0].strip()\n        if line:\n            paths.append(line)\n    paths.sort()\n    hashes = {}\n    for p in paths:\n        result = subprocess.run(\n            [\"git\", \"hash-object\", p],\n            capture_output=True, text=True, cwd=str(repo_root), timeout=10,\n        )\n        if result.returncode != 0:\n            raise ValueError(f\"git hash-object failed for {p}: {result.stderr}\")\n        hashes[p] = result.stdout.strip()\n    canon = json.dumps(hashes, sort_keys=True, separators=(\",\", \":\"))\n    return hashlib.sha256(canon.encode(\"utf-8\")).hexdigest()\n\n\ndef parse_pin_range(pin_file: Path) -> Tuple[Optional[str], Optional[str]]:\n    \"\"\"Parse a stable ``>=floor`` range with an optional legacy upper bound.\"\"\"\n    if not pin_file.exists():\n        return None, None\n    for line in pin_file.read_text().splitlines():\n        line = line.split(\"#\", 1)[0].strip()\n        if not line:\n            continue\n        m = re.fullmatch(r\">=\\s*([^,\\s]+)(?:\\s*,\\s*<\\s*([^,\\s]+))?\", line)\n        if m and cli_currency.parse_semver(m.group(1)) is not None:\n            upper = m.group(2)\n            if upper is None or cli_currency.parse_semver(upper) is not None:\n                return m.group(1), upper\n        raise ValueError(\"pin range must be >=MAJOR.MINOR.PATCH with optional < upper bound\")\n    return None, None\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--verdict-file\", required=True)\n    parser.add_argument(\n        \"--parent-sha\",\n        default=\"\",\n        help=(\n            \"Expected verdict.parent_sha — the commit the verdict was \"\n            \"generated against (parent of the verdict-file commit). \"\n            \"Resolves the self-reference problem the legacy --commit-sha \"\n            \"bind had with PLAN-081 v1.16.0 GA. Empty string = skip bind.\"\n        ),\n    )\n    parser.add_argument(\n        \"--commit-sha\",\n        default=\"\",\n        help=(\n            \"DEPRECATED legacy bind. Retained for backward-compat with \"","numLines":320,"startLine":60,"totalLines":799}},"tool_result_meta":[{"id":"toolu_01Y28MqAcHUEotcjHTwixmmp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
