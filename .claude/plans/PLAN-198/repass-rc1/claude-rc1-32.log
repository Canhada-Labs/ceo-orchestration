S da W1, com a 3.9 no `Ceo`) sem\n        # abrir janela de falso-verde, porque o nightly cobre 3.10/3.11\n        # todos os dias.\n        python-version: >-\n          ${{ fromJSON(github.event_name == 'push'\n              && '[\"3.9\",\"3.12\"]'","numLines":50,"startLine":1630,"totalLines":1787}},"tool_result_meta":[{"id":"toolu_01JyXopP611Z4q2zzVmDKSmi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
