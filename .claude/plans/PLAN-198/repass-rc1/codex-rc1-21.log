     1	#!/usr/bin/env python3
     2	"""Parser-aware destructive Bash safety hook facade.
     3	
     4	The executable declarations live in installable `_lib` fragments so that the
     5	installer copies them with the `.claude/hooks` library. Each fragment is compiled into
     6	this module's namespace: private names, dataclasses, mutable state and calls
     7	through monkeypatched globals therefore retain the historical behavior.
     8	
     9	# Source-surface compatibility marker: def _rewrite_git_push_force is loaded
    10	# into this facade from ``_bash_safety_parts.rewrite_citation``.
    11	# Historical staged-test loaders also select this entry point by these names:
    12	# def _apply_destructive_citation_gate — implementation in rewrite_citation.py.
    13	# def _apply_fact_gate — implementation in fact_canonical.py.
    14	"""
    15	from __future__ import annotations
    16	
    17	from pathlib import Path
    18	from typing import Tuple
    19	
    20	_PARTS: Tuple[str, ...] = (
    21	    "normalization", "rewrite_citation", "fact_state", "fact_canonical",
    22	    "posture_tables", "posture_parser", "posture_scan", "decisions_cli",
    23	)
    24	
    25	
    26	def _install_parts() -> None:
    27	    """Execute ordered, inspectable source fragments in this namespace.
    28	
    29	    The fragments contain ordinary Python declarations, not proxy exports.
    30	    Compiling them once with this dictionary preserves historical lookup of
    31	    helpers and constants through the facade, including test monkeypatches.
    32	    Their own filenames stay in code objects for ``inspect.getsource``.
    33	    """
    34	    namespace = globals()
    35	    parts_dir = Path(__file__).resolve().parent / "_lib" / "_bash_safety_parts"
    36	    for part_name in _PARTS:
    37	        part_path = parts_dir / (part_name + ".py")
    38	        source = part_path.read_text(encoding="utf-8")
    39	        exec(compile(source, str(part_path), "exec"), namespace, namespace)
    40	
    41	
    42	_install_parts()

