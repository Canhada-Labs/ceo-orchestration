-    Fail-open: a write failure never blocks the tool decision path."""
-    import os as _os
-    try:
-        state_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
-    except OSError:
-        pass
-    tmp = state_path.with_suffix(state_path.suffix + ".tmp")
