                    # are the same destructive class, so they are citation-
                    # gatable (main() applies the gate off this tag).
                    return Decision(allow=False, reason=reason, destructive=True)
            continue
        if not tokens:
            continue
        for check in (
            _check_rm_rf,
            _check_git_reset_hard,
            _check_git_push_force,
        ):
            reason = check(tokens)
            if reason:
