   234	    # cache filename, and the interpreter path still resolves. No version
   235	    # recheck needed on hot path.
   236	    FOUND_PY="$_cached_py"
   237	  fi
   238	fi
   239	
   240	# ---- Cache miss: full probe + repopulate ----
   241	if [ -z "$FOUND_PY" ]; then
   242	  # PLAN-023 Phase F (F-perf-001): run the baseline Python≥3.9 gate ONLY
   243	  # in the cache-miss branch. The gate's `python3 -c ...` spawn is ~15-20ms
   244	  # that cache-hit paths no longer pay. The gate still fires on every
   245	  # first-time or PATH-changed invocation, which is the only time a new
   246	  # interpreter could appear.
   247	  _py_version_check
   248	
   249	  for candidate in "${CANDIDATES[@]}"; do
   250	    if command -v "$candidate" >/dev/null 2>&1; then
   251	      read -r py_major py_minor <<< "$(parse_version "$candidate")"
   252	      if [ -n "${py_major:-}" ] && version_ok "$py_major" "$py_minor"; then
   253	        FOUND_PY="$candidate"
   254	        break
   255	      fi
   256	    fi
   257	  done
   258	
   259	  # Cache the result for next invocation (atomic write via mv).
   260	  if [ -n "$FOUND_PY" ]; then
.claude/settings.json:50:    "_credentials_comment": "PLAN-153 wave-backlog (Anthropic ADOPT sweep 2026-07) — Claude Code >=2.1.187 sandbox.credentials, schema verified against the 2.1.202 binary (files[].mode is literal 'deny'; envVars[].mode is 'deny'|'mask'; allowPlaintextInject optional, defaults false). Denies sandboxed Bash commands access to credential FILES (the subprocess-read class the permissions.deny Read() rail explicitly cannot cover — see _deny_baseline_comment) and unsets secret ENV VARS for sandboxed commands. INERT until sandbox.enabled=true (same flip discipline as the rest of this block). Honest limits: (1) this rail is HARNESS-side fail-open — the 2.1.202 loader drops an invalid entry or the whole block with a warning ('no credential protection is applied until it is fixed'), so the hook-side fail-CLOSED credential-leak guard in check_bash_safety.py remains the primary rail and this is defense-in-depth; (2) files paths resolve like sandbox.filesystem.* (absolute, ~ expanded, or relative to the project root) with NO glob support — the .env entries cover the repo ROOT only; subdir dotenv reads stay owned by the Read() deny rail + contamination CI; (3) envVars deliberately EXCLUDES GH_TOKEN/GITHUB_TOKEN/ANTHROPIC_API_KEY/OPENAI_API_KEY because gh, the `claude -p` eval harnesses, and the codex pair-rail all run through sandboxed Bash and may legitimately consume them — tighten only after an Owner-run probe (WATCH in docs/substrate-adopt-2026-07.md); (4) 'mask' mode (sentinel-in-sandbox + proxy inject on egress) is deliberately unused: it rests on egress-proxy TLS assumptions we have not probed; allowPlaintextInject stays explicit false.",
