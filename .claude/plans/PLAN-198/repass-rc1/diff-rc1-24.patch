-        a["fail"] += int(e.get("fail_count", 0))
-        a["claims"] += int(e.get("claim_count", 0))
-
-    fpr = (fail_count / claim_count) if claim_count else None
-
-    return {
-        "event_count": total,
-        "claim_count": claim_count,
-        "pass_count": pass_count,
-        "fail_count": fail_count,
