-        else:
-            try:
-                when = datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ").replace(
-                    tzinfo=timezone.utc
-                )
-            except ValueError:
-                continue
-            if when < cutoff:
-                continue
-            day_key = when.strftime("%Y-%m-%d")
-        histogram[day_key] += 1
