-    if as_csv and isinstance(result, list) and result and isinstance(result[0], dict):
-        buf = io.StringIO()
-        fieldnames = sorted({k for e in result for k in e.keys()})
-        writer = csv.DictWriter(buf, fieldnames=fieldnames, extrasaction="ignore")
-        writer.writeheader()
-        for e in result:
-            writer.writerow(e)
-        return buf.getvalue()
