-    per_lesson: Dict[str, Dict[str, Any]] = defaultdict(
-        lambda: {"hit_count": 0, "miss_count": 0,
-                 "last_outcome_at": "",
-                 "inference_modes": {}, "archetype": ""}
-    )
-
-    for e in entries:
-        if e.get("action") != "lesson_outcome":
-            continue
-        if e.get("consumer", "benchmark") != consumer_filter:
