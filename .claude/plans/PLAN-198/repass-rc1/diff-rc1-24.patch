-            g["total"] += int(cnt)
-            g["events"] += 1
-
-        agent = e.get("agent_name", "") or "(unnamed)"
-        a = per_agent.setdefault(agent, {"events": 0, "pass": 0, "fail": 0, "claims": 0})
-        a["events"] += 1
