{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0141ZCau2dhqPAQaoAJ8vQvr","type":"tool_result","content":"60\tprecedent: policy-relevant constants are frozen at source so a kernel-\n61\toverride on this file is forensically visible in diffs.\n62\t\n63\t## Stdlib-only (ADR-002)\n64\t\n65\tUses ``pathlib`` and ``_lib.frontmatter``. No YAML library.\n66\t\"\"\"\n67\t\n68\tfrom __future__ import annotations\n69\t\n70\timport sys\n71\tfrom pathlib import Path\n72\tfrom typing import Dict, FrozenSet, Iterable, List, Optional, Tuple\n73\t\n74\t_HOOKS_DIR = Path(__file__).resolve().parent.parent\n75\tif str(_HOOKS_DIR) not in sys.path:\n76\t    sys.path.insert(0, str(_HOOKS_DIR))\n77\t\n78\tfrom _lib.frontmatter import parse_frontmatter  # noqa: E402\n79\ttry:\n80\t    from _lib import model_currency as _model_currency  # noqa: E402\n81\texcept ImportError:\n82\t    _model_currency = None  # type: ignore[assignment]\n83\t\n84\t__all__ = [\n85\t    \"VETO_FLOOR_ROLES\",\n86\t    \"VETO_FLOOR_MODEL\",\n87\t    \"VETO_FLOOR_ALLOWED\",\n88\t    \"AgentFrontmatterError\",\n89\t    \"parse_agent_file\",\n90\t    \"resolve_agent_file\",\n91\t    \"check_veto_floor_for_role\",\n92\t    \"validate_veto_floor_models\",\n93\t]\n94\t\n95\t\n96\t# Hardcoded VETO floor (defense-in-depth; matches PLAN-043 pattern).\n97\t# Mutating these requires a kernel-override edit to this file — which\n98\t# leaves a diff in git history that any reviewer can detect. Without\n99\t# this frozen baseline, the floor would depend entirely on the\n100\t# ``.claude/agents/*.md`` files being correct, which F-01-03\n101\t# demonstrated is an insufficient invariant.\n102\t#\n103\t# History:\n104\t# - Wave 0 ADJ-B3 BLOCKER 6 (S90): pre-registered 4 VETO-adjacent slugs\n105\t#   without agent files. ROLLED BACK per S90 fork-b Codex MCP gate\n106\t#   P0-01: keeping extra slugs here without their agent files caused\n107\t#   check_agent_spawn.py to fail-close on ``file_missing`` for every\n108\t#   dispatch that mentioned those archetype names in description/prompt\n109\t#   — blocking legitimate Wave 1c authoring work.\n110\t# - Wave 1c (S93): the 3 security-domain VETO-adjacent slugs (incident-\n111\t#   commander, identity-trust-architect, threat-detection-engineer) are\n112\t#   added HERE atomically with their corresponding ``.claude/agents/\n113\t#   <slug>.md`` files in a single GPG sentinel commit, satisfying both\n114\t#   halves of the S90 P0-01 invariant. The 4th slug from the original\n115\t#   Wave 0 set (``llm-finops-architect``) is EXCLUDED from this\n116\t#   frozenset per the Wave 1c VETO-floor matrix and ADR-052 amendment:\n117\t#   cost governance is operational doctrine + mechanical enforcement\n118\t#   (ADR-064), NOT a sub-domain trust boundary that justifies a\n119\t#   dedicated VETO authority. The agent file ships with\n120\t#   ``veto_floor: false`` to make the exclusion explicit + bidirectionally\n121\t#   verifiable via ``test_veto_floor_bijection.py``.\n122\tVETO_FLOOR_ROLES: FrozenSet[str] = frozenset({\n123\t    \"code-reviewer\",\n124\t    \"security-engineer\",\n125\t    \"incident-commander\",          # PLAN-074 Wave 1c — incident-management VETO-floor (sev-N escalation)\n126\t    \"identity-trust-architect\",    # PLAN-074 Wave 1c — identity/trust VETO-floor (ADR-052 amendment)\n127\t    \"threat-detection-engineer\",   # PLAN-074 Wave 1c — SIEM/ATT&CK VETO-floor (security domain)\n128\t})\n129\t\n130\tVETO_FLOOR_MODEL: str = \"claude-opus-4-8\"\n131\t\n132\t# ADR-149 (PLAN-134 W0, E1-F1): Owner-signed allowlist of model IDs that\n133\t# satisfy the VETO floor. Replaces the exact-equality pin so a\n134\t# generation bump becomes a one-site data change. ADDITIVE by doctrine:\n135\t# the previous flagship stays valid during migration (intentional N-1\n136\t# tolerance window). ``VETO_FLOOR_MODEL`` is retained unchanged as the\n137\t# legacy preferred-pin constant for existing importers + tests; the\n138\t# enforcement comparison below uses MEMBERSHIP in this set.\n139\tVETO_FLOOR_ALLOWED: FrozenSet[str] = frozenset({\n140\t    \"claude-opus-4-8\",\n141\t    \"claude-fable-5\",\n142\t    \"claude-opus-5\",\n143\t    \"claude-opus-5-5\",\n144\t})\n145\t\n146\t\n147\tclass AgentFrontmatterError(RuntimeError):\n148\t    \"\"\"Raised on unrecoverable parse errors (bad path, unreadable file).\n149\t\n150\t    Recoverable conditions (missing ``model:`` field, wrong model,\n151\t    missing file for a given role) return structured violations from\n152\t    ``validate_veto_floor_models`` rather than raising.\n153\t    \"\"\"\n154\t\n155\t\n156\tdef resolve_agent_file(agent_name: str, agents_dir: Path) -> Path:\n157\t    \"\"\"Return ``<agents_dir>/<agent_name>.md``.\n158\t\n159\t    Does NOT verify the file exists — callers decide whether a missing\n160\t    file is a violation (e.g. spawn-time check should treat missing\n161\t    VETO-role file as fail-CLOSED).\n162\t    \"\"\"\n163\t    if not agent_name or \"/\" in agent_name or \"..\" in agent_name:\n164\t        raise AgentFrontmatterError(\n165\t            f\"invalid agent name: {agent_name!r}\"\n166\t        )\n167\t    return agents_dir / f\"{agent_name}.md\"\n168\t\n169\t\n170\tdef parse_agent_file(\n171\t    path: Path,\n172\t) -> Dict[str, str]:\n173\t    \"\"\"Parse ``.claude/agents/<name>.md`` and return its frontmatter.\n174\t\n175\t    Reads the file, delegates to ``_lib.frontmatter.parse_frontmatter``,\n176\t    and returns the ``Dict[str, str]`` key/value map. Returns an empty\n177\t    dict if the file has no frontmatter or is unreadable.\n178\t\n179\t    Symlink rejection: if the target file (or its parent directory) is\n180\t    a symlink, parsing refuses and returns an empty dict with\n181\t    ``__symlink_rejected__: 1`` marker for the caller. The check mirrors\n182\t    the pattern in ``_lib.gpg_verify.load_allowlist`` and the sentinel\n183\t    symlink-reject requirement (PLAN-044 F-01-04).\n184\t    \"\"\"\n185\t    try:\n186\t        if path.is_symlink():\n187\t            return {\"__symlink_rejected__\": \"leaf\"}\n188\t        if path.parent.is_symlink():\n189\t            return {\"__symlink_rejected__\": \"parent\"}\n190\t        if not path.is_file():\n191\t            return {}\n192\t        raw = path.read_text(encoding=\"utf-8\")\n193\t    except OSError:\n194\t        return {}\n195\t    metadata, _body = parse_frontmatter(raw)\n196\t    return metadata\n197\t\n198\t\n199\tdef check_veto_floor_for_role(\n200\t    role: str,\n201\t    agents_dir: Path,\n202\t    *,\n203\t    veto_roles: Optional[Iterable[str]] = None,\n204\t    expected_model: Optional[str] = None,\n205\t) -> Tuple[bool, str]:\n206\t    \"\"\"Validate one VETO role's agent frontmatter.\n207\t\n208\t    Returns ``(ok, reason)``:\n209\t\n210\t    - ``(True, \"\")`` — role is in the VETO floor AND frontmatter\n211\t      ``model:`` is in the allowed set (``VETO_FLOOR_ALLOWED`` by\n212\t      default; exactly ``{expected_model}`` when the kwarg is passed).\n213\t    - ``(True, \"not_veto_role\")`` — role is NOT in the VETO floor; no\n214\t      constraint applies. Caller treats as pass-through.\n215\t    - ``(False, \"<reason>\")`` — violation. Reasons:\n216\t\n217\t      - ``file_missing`` — ``<agents_dir>/<role>.md`` not present\n218\t      - ``file_symlink_rejected`` / ``parent_symlink_rejected``\n219\t      - ``frontmatter_missing`` — file has no ``---`` block or is empty\n220\t      - ``model_field_missing`` — frontmatter parses but ``model:`` absent\n221\t      - ``model_mismatch:<actual>`` — frontmatter has ``model: X`` but X\n222\t        ∉ the allowed set (``X`` is echoed unredacted; callers MUST\n223\t        audit this string for forensics; reason-string shape is\n224\t        UNCHANGED from the pre-ADR-149 equality implementation)\n225\t\n226\t    The ``veto_roles`` / ``expected_model`` kwargs exist for testing\n227\t    only — production code path uses the frozen defaults above. Passing\n228\t    override values does NOT disable the floor; it replaces it with the\n229\t    provided set for scoped validation (``expected_model`` narrows the\n230\t    allowlist to exactly that single ID).\n231\t    \"\"\"\n232\t    roles = frozenset(veto_roles) if veto_roles is not None else VETO_FLOOR_ROLES\n233\t    allowed = (\n234\t        frozenset({expected_model})\n235\t        if expected_model is not None\n236\t        else VETO_FLOOR_ALLOWED\n237\t    )\n238\t    if role not in roles:\n239\t        return True, \"not_veto_role\"\n240\t    try:\n241\t        path = resolve_agent_file(role, agents_dir)\n242\t    except AgentFrontmatterError:\n243\t        return False, \"invalid_role_name\"\n244\t    metadata = parse_agent_file(path)\n245\t    if metadata.get(\"__symlink_rejected__\") == \"leaf\":\n246\t        return False, \"file_symlink_rejected\"\n247\t    if metadata.get(\"__symlink_rejected__\") == \"parent\":\n248\t        return False, \"parent_symlink_rejected\"\n249\t    if not path.is_file():\n250\t        return False, \"file_missing\"\n251\t    if not metadata:\n252\t        return False, \"frontmatter_missing\"\n253\t    actual = metadata.get(\"model\", \"\").strip()\n254\t    if not actual:\n255\t        return False, \"model_field_missing\"\n256\t    if expected_model is not None:\n257\t        model_ok = actual == expected_model\n258\t    elif _model_currency is not None:\n259\t        model_ok = _model_currency.is_veto_floor_model(actual) or actual in allowed\n260\t    else:\n261\t        model_ok = actual in allowed\n262\t    if not model_ok:\n263\t        return False, f\"model_mismatch:{actual}\"\n264\t    return True, \"\"\n265\t\n266\t\n267\tdef validate_veto_floor_models(\n268\t    agents_dir: Path,\n269\t    *,\n270\t    veto_roles: Optional[Iterable[str]] = None,\n271\t    expected_model: Optional[str] = None,\n272\t) -> Tuple[bool, List[str]]:\n273\t    \"\"\"Check every VETO-floor role's agent file in one call.\n274\t\n275\t    Iterates through ``veto_roles`` (default ``VETO_FLOOR_ROLES``) and\n276\t    runs ``check_veto_floor_for_role`` on each. Aggregates violations\n277\t    into a list of ``\"<role>: <reason>\"`` strings.\n278\t\n279\t    Returns ``(ok, violations)``:\n280\t\n281\t    - ``(True, [])`` if every role's frontmatter complies.\n282\t    - ``(False, [...])`` with one or more lines describing the first\n283\t      violation per role. Callers can emit each line as a separate\n284\t      ``veto_triggered`` audit event.\n285\t\n286\t    Use at: (a) framework install-time smoke test, (b) CI validation,\n287\t    (c) hook-driven spawn gate (``check_agent_spawn.py``). The\n288\t    function is side-effect-free; the caller decides block-vs-log.\n289\t    \"\"\""}]},"parent_tool_use_id":null,"session_id":"e7b3e450-1c4f-493e-92a7-7354e7f74aff","uuid":"377ddebc-a0d3-4cc9-8b1f-56f83737f80b","timestamp":"2026-11-13T17:03:41.287Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_frontmatter.py","content":"precedent: policy-relevant constants are frozen at source so a kernel-\noverride on this file is forensically visible in diffs.\n\n## Stdlib-only (ADR-002)\n\nUses ``pathlib`` and ``_lib.frontmatter``. No YAML library.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\nfrom typing import Dict, FrozenSet, Iterable, List, Optional, Tuple\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\nfrom _lib.frontmatter import parse_frontmatter  # noqa: E402\ntry:\n    from _lib import model_currency as _model_currency  # noqa: E402\nexcept ImportError:\n    _model_currency = None  # type: ignore[assignment]\n\n__all__ = [\n    \"VETO_FLOOR_ROLES\",\n    \"VETO_FLOOR_MODEL\",\n    \"VETO_FLOOR_ALLOWED\",\n    \"AgentFrontmatterError\",\n    \"parse_agent_file\",\n    \"resolve_agent_file\",\n    \"check_veto_floor_for_role\",\n    \"validate_veto_floor_models\",\n]\n\n\n# Hardcoded VETO floor (defense-in-depth; matches PLAN-043 pattern).\n# Mutating these requires a kernel-override edit to this file — which\n# leaves a diff in git history that any reviewer can detect. Without\n# this frozen baseline, the floor would depend entirely on the\n# ``.claude/agents/*.md`` files being correct, which F-01-03\n# demonstrated is an insufficient invariant.\n#\n# History:\n# - Wave 0 ADJ-B3 BLOCKER 6 (S90): pre-registered 4 VETO-adjacent slugs\n#   without agent files. ROLLED BACK per S90 fork-b Codex MCP gate\n#   P0-01: keeping extra slugs here without their agent files caused\n#   check_agent_spawn.py to fail-close on ``file_missing`` for every\n#   dispatch that mentioned those archetype names in description/prompt\n#   — blocking legitimate Wave 1c authoring work.\n# - Wave 1c (S93): the 3 security-domain VETO-adjacent slugs (incident-\n#   commander, identity-trust-architect, threat-detection-engineer) are\n#   added HERE atomically with their corresponding ``.claude/agents/\n#   <slug>.md`` files in a single GPG sentinel commit, satisfying both\n#   halves of the S90 P0-01 invariant. The 4th slug from the original\n#   Wave 0 set (``llm-finops-architect``) is EXCLUDED from this\n#   frozenset per the Wave 1c VETO-floor matrix and ADR-052 amendment:\n#   cost governance is operational doctrine + mechanical enforcement\n#   (ADR-064), NOT a sub-domain trust boundary that justifies a\n#   dedicated VETO authority. The agent file ships with\n#   ``veto_floor: false`` to make the exclusion explicit + bidirectionally\n#   verifiable via ``test_veto_floor_bijection.py``.\nVETO_FLOOR_ROLES: FrozenSet[str] = frozenset({\n    \"code-reviewer\",\n    \"security-engineer\",\n    \"incident-commander\",          # PLAN-074 Wave 1c — incident-management VETO-floor (sev-N escalation)\n    \"identity-trust-architect\",    # PLAN-074 Wave 1c — identity/trust VETO-floor (ADR-052 amendment)\n    \"threat-detection-engineer\",   # PLAN-074 Wave 1c — SIEM/ATT&CK VETO-floor (security domain)\n})\n\nVETO_FLOOR_MODEL: str = \"claude-opus-4-8\"\n\n# ADR-149 (PLAN-134 W0, E1-F1): Owner-signed allowlist of model IDs that\n# satisfy the VETO floor. Replaces the exact-equality pin so a\n# generation bump becomes a one-site data change. ADDITIVE by doctrine:\n# the previous flagship stays valid during migration (intentional N-1\n# tolerance window). ``VETO_FLOOR_MODEL`` is retained unchanged as the\n# legacy preferred-pin constant for existing importers + tests; the\n# enforcement comparison below uses MEMBERSHIP in this set.\nVETO_FLOOR_ALLOWED: FrozenSet[str] = frozenset({\n    \"claude-opus-4-8\",\n    \"claude-fable-5\",\n    \"claude-opus-5\",\n    \"claude-opus-5-5\",\n})\n\n\nclass AgentFrontmatterError(RuntimeError):\n    \"\"\"Raised on unrecoverable parse errors (bad path, unreadable file).\n\n    Recoverable conditions (missing ``model:`` field, wrong model,\n    missing file for a given role) return structured violations from\n    ``validate_veto_floor_models`` rather than raising.\n    \"\"\"\n\n\ndef resolve_agent_file(agent_name: str, agents_dir: Path) -> Path:\n    \"\"\"Return ``<agents_dir>/<agent_name>.md``.\n\n    Does NOT verify the file exists — callers decide whether a missing\n    file is a violation (e.g. spawn-time check should treat missing\n    VETO-role file as fail-CLOSED).\n    \"\"\"\n    if not agent_name or \"/\" in agent_name or \"..\" in agent_name:\n        raise AgentFrontmatterError(\n            f\"invalid agent name: {agent_name!r}\"\n        )\n    return agents_dir / f\"{agent_name}.md\"\n\n\ndef parse_agent_file(\n    path: Path,\n) -> Dict[str, str]:\n    \"\"\"Parse ``.claude/agents/<name>.md`` and return its frontmatter.\n\n    Reads the file, delegates to ``_lib.frontmatter.parse_frontmatter``,\n    and returns the ``Dict[str, str]`` key/value map. Returns an empty\n    dict if the file has no frontmatter or is unreadable.\n\n    Symlink rejection: if the target file (or its parent directory) is\n    a symlink, parsing refuses and returns an empty dict with\n    ``__symlink_rejected__: 1`` marker for the caller. The check mirrors\n    the pattern in ``_lib.gpg_verify.load_allowlist`` and the sentinel\n    symlink-reject requirement (PLAN-044 F-01-04).\n    \"\"\"\n    try:\n        if path.is_symlink():\n            return {\"__symlink_rejected__\": \"leaf\"}\n        if path.parent.is_symlink():\n            return {\"__symlink_rejected__\": \"parent\"}\n        if not path.is_file():\n            return {}\n        raw = path.read_text(encoding=\"utf-8\")\n    except OSError:\n        return {}\n    metadata, _body = parse_frontmatter(raw)\n    return metadata\n\n\ndef check_veto_floor_for_role(\n    role: str,\n    agents_dir: Path,\n    *,\n    veto_roles: Optional[Iterable[str]] = None,\n    expected_model: Optional[str] = None,\n) -> Tuple[bool, str]:\n    \"\"\"Validate one VETO role's agent frontmatter.\n\n    Returns ``(ok, reason)``:\n\n    - ``(True, \"\")`` — role is in the VETO floor AND frontmatter\n      ``model:`` is in the allowed set (``VETO_FLOOR_ALLOWED`` by\n      default; exactly ``{expected_model}`` when the kwarg is passed).\n    - ``(True, \"not_veto_role\")`` — role is NOT in the VETO floor; no\n      constraint applies. Caller treats as pass-through.\n    - ``(False, \"<reason>\")`` — violation. Reasons:\n\n      - ``file_missing`` — ``<agents_dir>/<role>.md`` not present\n      - ``file_symlink_rejected`` / ``parent_symlink_rejected``\n      - ``frontmatter_missing`` — file has no ``---`` block or is empty\n      - ``model_field_missing`` — frontmatter parses but ``model:`` absent\n      - ``model_mismatch:<actual>`` — frontmatter has ``model: X`` but X\n        ∉ the allowed set (``X`` is echoed unredacted; callers MUST\n        audit this string for forensics; reason-string shape is\n        UNCHANGED from the pre-ADR-149 equality implementation)\n\n    The ``veto_roles`` / ``expected_model`` kwargs exist for testing\n    only — production code path uses the frozen defaults above. Passing\n    override values does NOT disable the floor; it replaces it with the\n    provided set for scoped validation (``expected_model`` narrows the\n    allowlist to exactly that single ID).\n    \"\"\"\n    roles = frozenset(veto_roles) if veto_roles is not None else VETO_FLOOR_ROLES\n    allowed = (\n        frozenset({expected_model})\n        if expected_model is not None\n        else VETO_FLOOR_ALLOWED\n    )\n    if role not in roles:\n        return True, \"not_veto_role\"\n    try:\n        path = resolve_agent_file(role, agents_dir)\n    except AgentFrontmatterError:\n        return False, \"invalid_role_name\"\n    metadata = parse_agent_file(path)\n    if metadata.get(\"__symlink_rejected__\") == \"leaf\":\n        return False, \"file_symlink_rejected\"\n    if metadata.get(\"__symlink_rejected__\") == \"parent\":\n        return False, \"parent_symlink_rejected\"\n    if not path.is_file():\n        return False, \"file_missing\"\n    if not metadata:\n        return False, \"frontmatter_missing\"\n    actual = metadata.get(\"model\", \"\").strip()\n    if not actual:\n        return False, \"model_field_missing\"\n    if expected_model is not None:\n        model_ok = actual == expected_model\n    elif _model_currency is not None:\n        model_ok = _model_currency.is_veto_floor_model(actual) or actual in allowed\n    else:\n        model_ok = actual in allowed\n    if not model_ok:\n        return False, f\"model_mismatch:{actual}\"\n    return True, \"\"\n\n\ndef validate_veto_floor_models(\n    agents_dir: Path,\n    *,\n    veto_roles: Optional[Iterable[str]] = None,\n    expected_model: Optional[str] = None,\n) -> Tuple[bool, List[str]]:\n    \"\"\"Check every VETO-floor role's agent file in one call.\n\n    Iterates through ``veto_roles`` (default ``VETO_FLOOR_ROLES``) and\n    runs ``check_veto_floor_for_role`` on each. Aggregates violations\n    into a list of ``\"<role>: <reason>\"`` strings.\n\n    Returns ``(ok, violations)``:\n\n    - ``(True, [])`` if every role's frontmatter complies.\n    - ``(False, [...])`` with one or more lines describing the first\n      violation per role. Callers can emit each line as a separate\n      ``veto_triggered`` audit event.\n\n    Use at: (a) framework install-time smoke test, (b) CI validation,\n    (c) hook-driven spawn gate (``check_agent_spawn.py``). The\n    function is side-effect-free; the caller decides block-vs-log.\n    \"\"\"","numLines":230,"startLine":60,"totalLines":301}},"tool_result_meta":[{"id":"toolu_0141ZCau2dhqPAQaoAJ8vQvr","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
