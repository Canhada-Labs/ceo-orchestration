{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4WmuRqwJGV29jqTATmL","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018kqUwGy917SraYoaqdabWz","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_agent_spawn.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1986,"cache_read_input_tokens":127861,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1986},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6cb4051e-a398-43c8-941a-d1137bf30aab","uuid":"9cfaeade-b9ed-40c8-932c-869b575786ae","timestamp":"2026-11-15T09:56:40.319Z","request_id":"req_011Ch4WmuFBremZmNNRJREGb","wire_tool_inputs":{"toolu_018kqUwGy917SraYoaqdabWz":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_agent_spawn.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018kqUwGy917SraYoaqdabWz","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Governance Hook: named agents MUST include ## SKILL CONTENT.\n3\t\n4\tRegistered in `.claude/settings.json` under `hooks.PreToolUse.Agent`.\n5\tRuns via the `_python-hook.sh` shim (A.4) for Python version resolution.\n6\t\n7\tPort of `.claude/hooks/check-agent-spawn.sh` with:\n8\t- stdlib-only (no jq dependency)\n9\t- unit-testable (logic is in `decide()`, not tangled with stdin/stdout)\n10\t- fail-open on any internal error (never blocks the user on infrastructure bug)\n11\t\n12\t## Two detection strategies\n13\t\n14\t1. The agent's `description` field contains a team member name, extracted\n15\t   dynamically from team.md / frontend-team.md / domains/*/team-personas.md.\n16\t2. The prompt contains a persona header (`PERSONA:`, `## AGENT PROFILE`,\n17\t   `## PERSONA`) — self-describing spawn.\n18\t\n19\tIf either strategy matches, the prompt MUST contain `## SKILL CONTENT`.\n20\tWithout it, the spawn is blocked as a generic agent wearing a name tag.\n21\t\n22\tThe extracted agent_spawn.skill_reference helpers also validate references to\n23\tSKILL.md files under .claude/skills; this hook still guards that skill surface.\n24\t\n25\t## Output contract\n26\t\n27\tWrites a single-line JSON decision to stdout:\n28\t\n29\t    {\"decision\":\"allow\"}\n30\t    {\"decision\":\"block\",\"reason\":\"GOVERNANCE: ...\"}\n31\t\n32\tExit code is 0 in both cases — Claude Code reads the decision from stdout,\n33\tnot the exit code. Internal errors (bad stdin, missing team files, etc.)\n34\tare logged to stderr and the spawn is allowed (fail-open).\n35\t\"\"\"\n36\t\n37\tfrom __future__ import annotations\n38\t\n39\timport hashlib\n40\timport json\n41\timport os\n42\timport re\n43\timport sys\n44\timport unicodedata\n45\tfrom dataclasses import dataclass\n46\tfrom pathlib import Path\n47\tfrom typing import Any, Dict, List, Optional, Tuple\n48\t\n49\t# Make the _lib package importable — hooks live in .claude/hooks/ and\n50\t# _lib is a sibling package; delegated skill-reference guards cover .claude/skills/**/SKILL.md.\n51\t_HOOKS_DIR = Path(__file__).resolve().parent\n52\tif str(_HOOKS_DIR) not in sys.path:\n53\t    sys.path.insert(0, str(_HOOKS_DIR))\n54\t\n55\tfrom _lib import contract as _contract  # noqa: E402\n56\tfrom _lib.adapters import claude as _claude_adapter  # noqa: E402\n57\tfrom _lib import team as _team  # noqa: E402\n58\tfrom _lib import redact as _redact  # noqa: E402  (PLAN-020 Phase 2: skill-ref scan)\n59\t\n60\t# PLAN-106 Wave G.1 — sub-agent N-of-M aggregator with partial-drop emit.\n61\t# Re-exported below as `aggregate_subagent_findings` so coordinator-side\n62\t# callers (swarm coordinator, future debate consensus aggregator) can\n63\t# `from check_agent_spawn import aggregate_subagent_findings` without\n64\t# poking into `_lib`. Closes AC10 grep contract.\n65\tfrom _lib import subagent_dispatch as _subagent_dispatch  # noqa: E402\n66\t\n67\t# PLAN-045 Wave 1 P0-03 — VETO floor runtime validator.\n68\ttry:\n69\t    from _lib import agent_frontmatter as _agent_frontmatter\n70\texcept Exception:  # pragma: no cover\n71\t    _agent_frontmatter = None  # type: ignore[assignment]\n72\t\n73\t# Optional: emit veto_triggered to event stream v2 (fail-open)\n74\ttry:\n75\t    # PLAN-094 Wave E — lazy-import dispatch shim closes AC9c spawn-hook regression\n76\t    from _lib import audit_emit_dispatch as _audit_emit  # noqa: E402\n77\t    _AUDIT_EMIT_AVAILABLE = True\n78\texcept Exception:  # pragma: no cover\n79\t    _AUDIT_EMIT_AVAILABLE = False\n80\t\n81\t# PLAN-092 Wave A.4 — cookbook-advisor pattern matcher (fail-open import).\n82\ttry:\n83\t    from _lib import cookbook_patterns as _cookbook_patterns  # noqa: E402\n84\t    _COOKBOOK_PATTERNS_AVAILABLE = True\n85\texcept Exception:  # pragma: no cover\n86\t    _COOKBOOK_PATTERNS_AVAILABLE = False\n87\t\n88\t# PLAN-112-FOLLOWUP-persona-routing-wire W1 — persona_routing matrix\n89\t# consult (fail-open import). The god-mode (persona × primitive) routing\n90\t# matrix declares AUTO-05 (\"model_routing_advised\") ENFORCING per\n91\t# ADR-118-AMEND-1, but check_agent_spawn never consulted it — the policy\n92\t# was dead at runtime. This wire makes the matrix observable/auditable.\n93\t# CONSULT + AUDIT ONLY — the BLOCK is DEFERRED (the hook payload exposes\n94\t# no requested-model signal; see plan §2/§3). NEVER read\n95\t# `_PRIMITIVE_DEFAULT_MODE` directly — get_mode() encapsulates the\n96\t# kill-switch demotion.\n97\ttry:\n98\t    from _lib import persona_routing as _persona_routing  # noqa: E402\n99\texcept Exception:  # pragma: no cover - fail-open\n100\t    _persona_routing = None  # type: ignore[assignment]\n101\t\n102\t# PLAN-113 WIRE-DEADMOD — SEC-P0-01 spec-context sanitizer (ADR-089).\n103\t# Sanitizes the ## SPEC CONTEXT block payload in spawn prompts before allow.\n104\t# ADVISORY telemetry only: sanitize result is emitted via emit_generic so\n105\t# sentinel violations / truncation are visible in the audit log. Never blocks.\n106\t# Fail-open: missing module → _SPEC_CTX_SANITIZER_AVAILABLE = False.\n107\ttry:\n108\t    from _lib import spec_context_sanitizer as _spec_ctx_sanitizer  # noqa: E402\n109\t    _SPEC_CTX_SANITIZER_AVAILABLE = True\n110\texcept Exception:  # pragma: no cover - fail-open\n111\t    _spec_ctx_sanitizer = None  # type: ignore[assignment]\n112\t    _SPEC_CTX_SANITIZER_AVAILABLE = False\n113\t\n114\t# PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n115\t# Classifies the spawn action type and emits a spawn_confidence_advisory event\n116\t# so that recommender / receipt formatter surfaces have a hook-level signal.\n117\t# ADVISORY only — never blocks. Fail-open.\n118\ttry:\n119\t    from _lib import confidence_labels as _confidence_labels  # noqa: E402\n120\t    _CONFIDENCE_LABELS_AVAILABLE = True\n121\texcept Exception:  # pragma: no cover - fail-open\n122\t    _confidence_labels = None  # type: ignore[assignment]\n123\t    _CONFIDENCE_LABELS_AVAILABLE = False\n124\t\n125\t# Components bind to the facade to preserve patched globals and isolated state.\n126\tdef _load_spawn_part(name):\n127\t    try:\n128\t        from _lib._audit_emit_parts import install\n129\t        install(globals(), (name,), package=\"_lib.agent_spawn\")\n130\t    except Exception as exc:\n131\t        if __name__ != \"__main__\":\n132\t            raise\n133\t        print(f\"[check_agent_spawn] FATAL: {type(exc).__name__}: {exc}\", file=sys.stderr)\n134\t        print(json.dumps({}))\n135\t        sys.exit(0)\n136\t\n137\t_load_spawn_part(\"model_routing\")\n138\t_load_spawn_part(\"advisories\")\n139\t_load_spawn_part(\"prompt_rules\")\n140\t\n141\t@dataclass\n142\tclass Decision:\n143\t    \"\"\"Typed result of the governance check.\"\"\"\n144\t\n145\t    allow: bool\n146\t    reason: Optional[str] = None\n147\t\n148\t    def to_json(self) -> str:\n149\t        if self.allow:\n150\t            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow\n151\t        return json.dumps(\n152\t            {\"decision\": \"block\", \"reason\": self.reason or \"\"},\n153\t            ensure_ascii=False,\n154\t        )\n155\t\n156\t\n157\t\n158\tdef _emit_cookbook_pattern_advisory(\n159\t    *,\n160\t    description: str,\n161\t    prompt: str,\n162\t    env=None,\n163\t) -> None:\n164\t    \"\"\"PLAN-092 Wave A.4 (W3.2 SEMI-11) — emit cookbook_pattern_advised\n165\t    when a spawn prompt matches one of 4 Anthropic Cookbook pattern\n166\t    trigger taxonomies (COOK-P1..P4).\n167\t\n168\t    Advisory ONLY — UX hint. NEVER blocks, NEVER mutates tool_input.\n169\t    Rate-cap via PLAN-088 global _plan088_rate_admit in audit_emit.\n170\t    Kill-switch: CEO_COOKBOOK_ADVISOR_ENABLED=0. Privacy invariant:\n171\t    3 fields max (no raw prompt persisted — AC3b).\n172\t\n173\t    Audit-emit signature mapping (PLAN-090 W3.2 canonical contract):\n174\t      pattern_id (COOK-P*)   -> top_pattern_keys\n175\t      trigger_class (string) -> task_signature (enum-constrained \"other\")\n176\t      bucket (high/med/low)  -> pattern_count (3/2/1)\n177\t\n178\t    NEVER raises.\n179\t    \"\"\"\n180\t    try:\n181\t        src_env = env if env is not None else os.environ\n182\t        if not _COOKBOOK_PATTERNS_AVAILABLE:\n183\t            return\n184\t        if not _AUDIT_EMIT_AVAILABLE:\n185\t            return\n186\t        # Kill-switch\n187\t        try:\n188\t            if hasattr(_cookbook_patterns, \"kill_switch_enabled\"):\n189\t                if not _cookbook_patterns.kill_switch_enabled():\n190\t                    return\n191\t            else:\n192\t                val = (src_env.get(\"CEO_COOKBOOK_ADVISOR_ENABLED\") or \"1\").strip()\n193\t                if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n194\t                    return\n195\t        except Exception:  # pragma: no cover\n196\t            return\n197\t        # Concat description + prompt, cap at 8KiB\n198\t        text = ((description or \"\") + \"\\n\" + (prompt or \"\"))[: 8 * 1024]\n199\t        if not text.strip():\n200\t            return\n201\t        # Match (first-hit canonical order COOK-P1 -> P4)\n202\t        try:\n203\t            result = _cookbook_patterns.match_pattern(text)\n204\t        except Exception:  # pragma: no cover\n205\t            return\n206\t        if result is None:\n207\t            return\n208\t        pattern_id, trigger_class, bucket = result\n209\t        if not hasattr(_audit_emit, \"emit_cookbook_pattern_advised\"):\n210\t            return\n211\t        # Map semantic -> canonical signature\n212\t        bucket_to_count = {\"high\": 3, \"medium\": 2, \"low\": 1}\n213\t        try:\n214\t            _audit_emit.emit_cookbook_pattern_advised(\n215\t                task_signature=\"other\",\n216\t                top_pattern_keys=str(pattern_id)[:128],\n217\t                pattern_count=bucket_to_count.get(str(bucket), 1),\n218\t            )\n219\t        except Exception:  # pragma: no cover\n220\t            return\n221\t    except Exception:  # pragma: no cover - fail-open invariant\n222\t        return\n223\t\n224\t\n225\t# ---------------------------------------------------------------------------\n226\t# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [END]\n227\t# ---------------------------------------------------------------------------\n228\t\n229\tdef decide(\n230\t    *,\n231\t    description: str,\n232\t    prompt: str,\n233\t    names_regex,\n234\t    env: Optional[dict] = None,\n235\t    subagent_type: str = \"\",\n236\t) -> Decision:\n237\t    \"\"\"Pure decision function — no I/O, trivially unit-testable.\n238\t\n239\t    Args:\n240\t        description: The Agent tool's `description` field.\n241\t        prompt: The Agent tool's `prompt` field.\n242\t        names_regex: A compiled regex matching team member names, or None\n243\t            if no team files were found (degrades to header-only detection).\n244\t        env: Environment-var dict (defaults to os.environ). Used to read\n245\t            CEO_ARCHITECT_ACTIVE for the recursion guard (Sprint 5 ADR-010).\n246\t        subagent_type: Agent tool ``subagent_type`` field (PLAN-078 Wave 1\n247\t            telemetry). Used to identify archetype for model-routing\n248\t            advisory emit; never affects the allow/block decision.\n249\t\n250\t    Returns:\n251\t        Decision(allow=True) if the spawn is fine.\n252\t        Decision(allow=False, reason=...) if governance requires blocking.\n253\t    \"\"\"\n254\t    src_env = env if env is not None else os.environ\n255\t\n256\t    # PLAN-133 E3 — resolve session id once for the spawn-rails (depth/overlap).\n257\t    _e3_session_id = _resolve_session_id_from_env(src_env)\n258\t\n259\t    # PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n260\t    # payload (advisory telemetry; never blocks). Runs early so sentinel\n261\t    # violations are logged before any governance decision. Fail-open.\n262\t    _sanitize_spec_context_advisory(prompt or \"\", env=src_env)\n263\t\n264\t    # PLAN-133 A2 (Goose-harvest) — fail-CLOSED invisible-unicode guard.\n265\t    # Default-OFF (CEO_UNICODE_HARDBLOCK=1 enforces); when enforced, a spawn\n266\t    # prompt carrying control / bidi / zero-width / U+E0000-E007F Tag-block\n267\t    # chars is BLOCKED here, BEFORE any LLM/debate/governance review. The\n268\t    # breadcrumb (invisible_unicode_blocked) is emitted on both the advisory\n269\t    # and enforced paths so the measure-first denominator is real. Fail-open.\n270\t    _uni_block = _enforce_spec_context_unicode(prompt or \"\", env=src_env)\n271\t    if _uni_block is not None:\n272\t        return Decision(allow=False, reason=_uni_block)\n273\t\n274\t    # Session 75 Codex Finding 4 closure: scan spawn prompt for\n275\t    # leaked secrets when Owner-opted-in via CEO_SPAWN_SECRET_SCAN=1.\n276\t    # Default OFF; without the env var, _validate_spawn_prompt_has_no_secrets\n277\t    # short-circuits to ok=True so legacy spawns are unaffected.\n278\t    _scan_ok, _scan_code, _scan_detail = _validate_spawn_prompt_has_no_secrets(prompt)\n279\t    if not _scan_ok:\n280\t        return Decision(\n281\t            allow=False,\n282\t            reason=(\n283\t                f\"SPAWN-SECRET-BLOCKED: {_scan_code} ({_scan_detail}). \"\n284\t                \"To bypass once: unset CEO_SPAWN_SECRET_SCAN.\"\n285\t            ),\n286\t        )\n287\t\n288\t    # PLAN-045 Wave 1 P0-03 — VETO floor runtime check.\n289\t    # If the spawn targets a VETO-floor role (code-reviewer,\n290\t    # security-engineer), verify the agent frontmatter still binds\n291\t    # them to Opus. Closes F-01-03 demotion-via-frontmatter attack.\n292\t    # Skipped when the validator lib is missing (defense-in-depth\n293\t    # fail-open; arbitration kernel still blocks agents/*.md edits).\n294\t    if _agent_frontmatter is not None:\n295\t        agents_dir = Path(\n296\t            src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n297\t        ) / \".claude\" / \"agents\"\n298\t        haystack_lower = \" \".join([\n299\t            (description or \"\").lower(), (prompt or \"\").lower()\n300\t        ])\n301\t        for _role in sorted(_agent_frontmatter.VETO_FLOOR_ROLES):\n302\t            if _role.lower() not in haystack_lower:\n303\t                continue\n304\t            ok, reason = _agent_frontmatter.check_veto_floor_for_role(\n305\t                _role, agents_dir\n306\t            )\n307\t            if not ok and reason != \"not_veto_role\":\n308\t                return Decision(\n309\t                    allow=False,\n310\t                    reason=(\n311\t                        f\"GOVERNANCE: veto_floor_demoted: role={_role} \"\n312\t                        f\"reason={reason}. The VETO floor requires \"\n313\t                        \"security-engineer and code-reviewer to bind to a \"\n314\t                        \"member of VETO_FLOOR_ALLOWED (agent_frontmatter.py) \"\n315\t                        \"- the enforcement is set membership, not one id. \"\n316\t                        \"See ADR-052 + PLAN-045 Wave 1 P0-03; PLAN-169 W2.10 D2.\"\n317\t                    ),\n318\t                )\n319\t\n320\t    # PLAN-078 Wave 1 — model routing advisory telemetry (advisory-only).\n321\t    # Runs AFTER VETO-floor enforcement so the hard-block path remains\n322\t    # authoritative. Emits `model_routing_advised` event when a spawn\n323\t    # archetype is identifiable. NEVER mutates tool_input. NEVER blocks.\n324\t    # Bypass: `CEO_MODEL_ROUTING=0`.\n325\t    _emit_model_routing_advisory(\n326\t        description=description or \"\",\n327\t        prompt=prompt or \"\",\n328\t        subagent_type=subagent_type or \"\",\n329\t        env=src_env,\n330\t        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n331\t    )\n332\t\n333\t    # PLAN-112-FOLLOWUP-persona-routing-wire W1 — god-mode matrix consult.\n334\t    # Runs AFTER the VETO-floor hard-block (above) so it never masks it.\n335\t    # CONSULT + AUDIT ONLY — emits model_routing_enforced /\n336\t    # model_routing_eval_error; NEVER blocks (block deferred, see W3 above).\n337\t    # Mode is read off authoritative subagent_type only.\n338\t    _consult_model_routing_mode(\n339\t        description=description or \"\",\n340\t        prompt=prompt or \"\",\n341\t        subagent_type=subagent_type or \"\",\n342\t        env=src_env,\n343\t        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n344\t    )\n345\t\n346\t    # PLAN-091 Wave A.4 (W3.1) — MCP routing advisory.\n347\t    # Maps archetype → mcp_routing task_class; resolver emits\n348\t    # `mcp_route_advised` (PLAN-086 Wave D). Bypass: CEO_MCP_ROUTING_HOOK=0.\n349\t    _emit_mcp_routing_advisory(\n350\t        description=description or \"\",\n351\t        prompt=prompt or \"\",\n352\t        subagent_type=subagent_type or \"\",\n353\t        env=src_env,\n354\t    )\n355\t\n356\t    # PLAN-091 Wave A.5 (W3.3) — specialization promotion heuristic.\n357\t    # When general-purpose spawn matches a specialist hint, emit\n358\t    # `specialization_promoted` advisory. NEVER auto-spawns.\n359\t    # Bypass: CEO_PROMOTION_HEURISTIC=0.\n360\t    _emit_promotion_advisory(\n361\t        description=description or \"\",\n362\t        prompt=prompt or \"\",\n363\t        subagent_type=subagent_type or \"\",\n364\t        env=src_env,\n365\t    )\n366\t\n367\t    # PLAN-092 Wave A.4 (W3.2 SEMI-11) — cookbook-advisor pattern hint.\n368\t    # Matches spawn against 4 Anthropic Cookbook patterns (COOK-P1..P4);\n369\t    # emits `cookbook_pattern_advised` advisory. Kill-switch:\n370\t    # CEO_COOKBOOK_ADVISOR_ENABLED=0. NEVER mutates tool_input.\n371\t    _emit_cookbook_pattern_advisory(\n372\t        description=description or \"\",\n373\t        prompt=prompt or \"\",\n374\t        env=src_env,\n375\t    )\n376\t\n377\t    # PLAN-098 Wave C.2 (ADR-132) — GOAP advisory-only invariant.\n378\t    # PLAN-105 Wave A.6 — capture intent for deferred-emit at allow-return.\n379\t    _goap_intent_plan_id: Optional[str] = None\n380\t    _goap_intent_action_id: Optional[str] = None\n381\t    if _GOAP_PLAN_ID_RE.search(prompt or \"\"):\n382\t        owner_confirmed_env = (src_env.get(\"CEO_GOAP_CONFIRMED\") or \"\").strip() == \"1\"\n383\t        has_goap_confirm_block = bool(_GOAP_CONFIRM_HEADER_RE.search(prompt or \"\"))\n384\t        if not (owner_confirmed_env and has_goap_confirm_block):\n385\t            preview = (description or \"\")[:80]\n386\t            missing: List[str] = []\n387\t            if not owner_confirmed_env:\n388\t                missing.append(\"CEO_GOAP_CONFIRMED=1 env\")\n389\t            if not has_goap_confirm_block:\n390\t                missing.append(\"## GOAP CONFIRM block\")\n391\t            return Decision(\n392\t                allow=False,\n393\t                reason=(\n394\t                    \"GOVERNANCE: goap_advisory_without_owner_confirm: \"\n395\t                    f\"spawn references a GOAP plan (description={preview!r}) \"\n396\t                    f\"but lacks: {', '.join(missing)}. The GOAP planner is \"\n397\t                    \"advisory-only - the Owner must physically confirm each \"\n398\t                    \"action before spawn. See ADR-132 Decision Part 2.\"\n399\t                ),\n400\t            )\n401\t        # PLAN-105 Wave A.6 — GOAP gates passed; record intent for deferred emit.\n402\t        _pid_m = _GOAP_PLAN_ID_VALUE_RE.search(prompt or \"\")\n403\t        _aid_m = _GOAP_ACTION_ID_VALUE_RE.search(prompt or \"\")\n404\t        if _pid_m is not None:\n405\t            _goap_intent_plan_id = _pid_m.group(1).strip()[:32]\n406\t            if _aid_m is not None:\n407\t                _goap_intent_action_id = _aid_m.group(1).strip()[:64]\n408\t\n409\t    # Recursion guard (ADR-010): block Architect-spawning-Architect.\n410\t    architect_active = (src_env.get(\"CEO_ARCHITECT_ACTIVE\") or \"\").strip()\n411\t    if architect_active == \"1\":\n412\t        haystack = \" \".join([description or \"\", prompt or \"\"])\n413\t        if _ARCHITECT_NAME_RE.search(haystack):\n414\t            return Decision(\n415\t                allow=False,\n416\t                reason=(\n417\t                    \"ARCHITECT-RECURSION: a spawn naming 'Agent Architect' \"\n418\t                    \"was detected while CEO_ARCHITECT_ACTIVE=1. The Agent \"\n419\t                    \"Architect must not spawn another instance of itself \"\n420\t                    \"within the same session. See ADR-010.\"\n421\t                ),\n422\t            )\n423\t\n424\t    # PLAN-020 Phase 3 — /effort scope clause (QA must-fix #7): /effort\n425\t    # hints are CEO-only. Spawn prompts MUST NOT include them.\n426\t    if _has_effort_token(prompt or \"\"):\n427\t        return Decision(\n428\t            allow=False,\n429\t            reason=(\n430\t                \"GOVERNANCE: spawn prompt contains a `/effort` token. \"\n431\t                \"Effort hints are CEO-only — sub-agents inherit Anthropic \"\n432\t                \"default thinking budget. Strip /effort from the prompt \"\n433\t                \"before retrying. See PLAN-020 §4 Phase 3 scope clause.\"\n434\t            ),\n435\t        )\n436\t\n437\t    desc_matched_name = False\n438\t    if names_regex is not None and description:\n439\t        if names_regex.search(description):\n440\t            desc_matched_name = True\n441\t\n442\t    prompt_has_persona = False\n443\t    if prompt and _PERSONA_HEADER_RE.search(prompt):\n444\t        prompt_has_persona = True\n445\t\n446\t    is_named_spawn = desc_matched_name or prompt_has_persona\n447\t\n448\t    # PLAN-133 E3 — per-spawn tool scoping + depth/overlap rails. ADVISORY by\n449\t    # default (emit-only, enforced=0); BLOCKS only under the per-rail env flag\n450\t    # (CEO_SPAWN_TOOL_SCOPE / CEO_SPAWN_DEPTH_GUARD / CEO_SPAWN_OVERLAP_GUARD).\n451\t    # Runs AFTER the VETO-floor + A2 unicode hard-blocks so those remain\n452\t    # authoritative; runs BEFORE the SKILL CONTENT accept-path so an\n453\t    # out-of-scope / depth-2 / clobbering spawn is rejected even when otherwise\n454\t    # well-formed. Fail-open (returns None on any infra error).\n455\t    _e3_hit = _enforce_spawn_rails(\n456\t        prompt=prompt or \"\",\n457\t        is_named_spawn=is_named_spawn,\n458\t        env=src_env,\n459\t        session_id=_e3_session_id,\n460\t    )\n461\t    if _e3_hit is not None:\n462\t        _e3_code, _e3_detail = _e3_hit\n463\t        return Decision(\n464\t            allow=False,\n465\t            reason=(\n466\t                f\"GOVERNANCE: {_e3_code}: {_e3_detail}. \"\n467\t                \"The spawn violates a PLAN-133 E3 rail (per-spawn tool \"\n468\t                \"allow-list / depth-over-one fence / FILE ASSIGNMENT overlap) \"\n469\t                \"or the ADR-191 FILE ASSIGNMENT grammar (PLAN-178 C1). \"\n470\t                \"Fix for a grammar block: regenerate the prompt via \"\n471\t                \".claude/scripts/inject-agent-context.sh (it always emits \"\n472\t                \"the block). If the block is UNPARSEABLE, REPLACE or \"\n473\t                \"remove the malformed block (the classifier aggregates \"\n474\t                \"ALL blocks — appending a valid one cannot clear an \"\n475\t                \"invalid token's taint); appending `## FILE ASSIGNMENT` \"\n476\t                \"with `- CAN edit: <concrete paths>` or the explicit \"\n477\t                \"read-only form `- CAN edit: NONE-READ-ONLY` works only \"\n478\t                \"for the ABSENT state. Recovery route: \"\n479\t                \"CEO_SOTA_DISABLE=1 forces advisory. See PLAN-133 §E E3 + \"\n480\t                \"ADR-191.\"\n481\t            ),\n482\t        )\n483\t\n484\t    # PLAN-113 WIRE-DEADMOD — confidence_labels advisory (PLAN-083 Wave 1.10).\n485\t    # Emits spawn_confidence_advisory so recommender / receipt formatter have\n486\t    # a hook-level signal. Advisory only — never blocks. Fail-open.\n487\t    _action_type = \"canonical_edit\" if is_named_spawn else \"bash_execute\"\n488\t    _emit_spawn_confidence_advisory(\n489\t        action_type=_action_type,\n490\t        is_named_spawn=is_named_spawn,\n491\t        env=src_env,\n492\t    )\n493\t\n494\t    if not is_named_spawn:\n495\t        # Generic research / simple tasks — no governance requirement.\n496\t        _emit_goap_deferred_outcome(\n497\t            _goap_intent_plan_id, _goap_intent_action_id, src_env\n498\t        )\n499\t        return Decision(allow=True)\n500\t\n501\t    # PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.\n502\t    # NAMED spawns only (scoped here, after the generic early-return, so\n503\t    # unmatched/generic spawns see zero behavior change). Runs BEFORE the\n504\t    # SKILL REFERENCE / SKILL CONTENT accept-paths so an untrusted-content\n505\t    # spawn missing the block is rejected even when otherwise well-formed.\n506\t    # Input fail-CLOSED (matched + missing block => BLOCK); infra fail-OPEN\n507\t    # inside _enforce_prompt_defense. Kill-switches documented at the gate.\n508\t    _pd_hit = _enforce_prompt_defense(\n509\t        description=description or \"\",\n510\t        prompt=prompt or \"\",\n511\t        env=src_env,\n512\t    )\n513\t    if _pd_hit is not None:\n514\t        _pd_code, _pd_detail = _pd_hit\n515\t        return Decision(\n516\t            allow=False,\n517\t            reason=(\n518\t                f\"GOVERNANCE: {_pd_code}: {_pd_detail}. This NAMED spawn's \"\n519\t                \"task indicates contact with untrusted content (WebFetch/\"\n520\t                \"WebSearch/scrape/imported/upstream/third-party), but the \"\n521\t                \"prompt has no `## PROMPT DEFENSE` section with >= 6 bullet \"\n522\t                \"lines. Fix: regenerate the prompt via \"\n523\t                \".claude/scripts/inject-agent-context.sh (it emits the block \"\n524\t                \"unconditionally), or append the 6-bullet anti-injection \"\n525\t                \"block verbatim. See PLAN-153 Wave E item 7 / ADR-175.\"\n526\t            ),\n527\t        )\n528\t\n529\t    # PLAN-020 Phase 2 — Reference path (ADR-051). If `## SKILL REFERENCE`\n530\t    # marker is present, validate strictly (fail-CLOSED). Reference path\n531\t    # opt-in via env var; default ON per Q1 Owner answer.\n532\t    if _is_enabled(\"CEO_SKILL_REFERENCE_MODE\", ENABLE_SKILL_REFERENCE_MODE, src_env):\n533\t        if _SKILL_REFERENCE_HEADER_RE.search(prompt or \"\"):\n534\t            ok, reason_code, detail = _validate_skill_reference(prompt or \"\")\n535\t            if ok:\n536\t                _emit_goap_deferred_outcome(\n537\t                    _goap_intent_plan_id, _goap_intent_action_id, src_env\n538\t                )\n539\t                # PLAN-106 Wave C — persona coverage emit at allow path.\n540\t                _emit_persona_coverage_synthesized(\n541\t                    subagent_type=subagent_type,\n542\t                    description=description,\n543\t                    prompt=prompt,\n544\t                    source=\"dispatch\",\n545\t                    env=src_env,\n546\t                )\n547\t                return Decision(allow=True)\n548\t            preview = (description or \"\")[:80]\n549\t            return Decision(\n550\t                allow=False,\n551\t                reason=(\n552\t                    f\"GOVERNANCE: {reason_code}: {detail}. \"\n553\t                    f\"Spawn rejected (description={preview!r}). \"\n554\t                    \"See ADR-051 §Synchronous validation for sub-check details.\"\n555\t                ),\n556\t            )\n557\t\n558\t    # Named spawn: require real SKILL CONTENT section (P1-SEC-B: bypass-resistant).\n559\t    if _has_skill_content(prompt or \"\"):\n560\t        _emit_goap_deferred_outcome(\n561\t            _goap_intent_plan_id, _goap_intent_action_id, src_env\n562\t        )\n563\t        # PLAN-106 Wave C — persona coverage emit at allow path.\n564\t        _emit_persona_coverage_synthesized(\n565\t            subagent_type=subagent_type,\n566\t            description=description,\n567\t            prompt=prompt,\n568\t            source=\"dispatch\",\n569\t            env=src_env,\n570\t        )\n571\t        return Decision(allow=True)\n572\t\n573\t    # Build a helpful block reason pointing at the injector script.\n574\t    preview = (description or \"\")[:80]\n575\t    reason = (\n576\t        \"GOVERNANCE: Agent spawn detected as NAMED \"\n577\t        f\"(description='{preview}'), but prompt has no {_SKILL_CONTENT_MARKER} \"\n578\t        \"section. Read the agent's skill file and include its full content \"\n579\t        \"in the prompt before spawning. Use \"\n580\t        \".claude/scripts/inject-agent-context.sh <AgentName> <task> to \"\n581\t        \"generate a compliant prompt.\"\n582\t    )\n583\t    return Decision(allow=False, reason=reason)\n584\t\n585\t\n586\t_load_spawn_part(\"outcome_telemetry\")\n587\t\n588\tdef _classify_block_reason(reason: str) -> str:\n589\t    \"\"\"Map a Decision.reason string to a stable audit reason_code.\n590\t\n591\t    Defaults to ``unknown_block`` when no marker matches — visibility\n592\t    on a marker drift is preferable to silent misclassification.\n593\t    \"\"\"\n594\t    if not reason:\n595\t        return \"unknown_block\"\n596\t    for needle, code in _BLOCK_REASON_MARKERS:\n597\t        if needle in reason:\n598\t            if code == \"__REFERENCE_PREFIX__\":\n599\t                # Embedded reason_code form: \"GOVERNANCE: <code>: <detail>\".\n600\t                # Skill-reference path emits codes like reference_hash_mismatch,\n601\t                # reference_unsafe_path, etc. (constants at\n602\t                # check_agent_spawn.py:188 REASON_REFERENCE_*).\n603\t                head = reason[len(\"GOVERNANCE: \"):]\n604\t                colon = head.find(\":\")\n605\t                return head[:colon] if colon > 0 else \"reference_invalid\"\n606\t            return code\n607\t    return \"unknown_block\"\n608\t\n609\tdef _to_contract_decision(d: \"Decision\") -> _contract.Decision:\n610\t    if d.allow:\n611\t        return _contract.allow()\n612\t    return _contract.block(d.reason or \"\")\n613\t\n614\t\n615\t_load_spawn_part(\"entrypoint\")\n616\t\n617\t\n618\t# PLAN-106 Wave G.1 — public re-export. Coordinator callers use:\n619\t#     from check_agent_spawn import aggregate_subagent_findings\n620\t# which proxies to `_lib.subagent_dispatch.aggregate_findings`. Doing\n621\t# the re-export at this module level satisfies the grep contract AC10\n622\t# (\"emit_subagent_findings_partial_drop ≥1 hit outside _lib/audit_emit\n623\t# and tests/\") because the helper transitively names the emit symbol\n624\t# in its docstring + raises the call site to the hook module surface.\n625\tdef aggregate_subagent_findings(*args, **kwargs):\n626\t    \"\"\"Wrap `_lib.subagent_dispatch.aggregate_findings`.\n627\t\n628\t    Emits `emit_subagent_findings_partial_drop` on shortfall via the\n629\t    inner aggregator. See `_lib/subagent_dispatch.py` for the full\n630\t    contract. Re-exported here so future coordinator code can call\n631\t    `from check_agent_spawn import aggregate_subagent_findings` and the\n632\t    grep contract (AC10) finds a hit at the hook-module surface\n633\t    without dragging the dispatch logic into this 1700-LoC file.\n634\t    \"\"\"\n635\t    return _subagent_dispatch.aggregate_findings(*args, **kwargs)\n636\t\n637\t\n638\t# Keep every extracted function on the historical module's globals so callers\n639\t# can patch its seams and each import retains independent invocation state.\n640\t_SPAWN_COMPONENT_IMPORT_ERROR = None\n641\ttry:\n642\t    # Surface guard: .claude/skills/** and SKILL.md (via _lib/agent_spawn/skill_reference.py)\n643\t    from _lib.agent_spawn import bind as _bind_spawn_components\n644\t    _bind_spawn_components(globals())\n645\t    del _bind_spawn_components\n646\texcept Exception as _spawn_component_exc:\n647\t    _SPAWN_COMPONENT_IMPORT_ERROR = type(_spawn_component_exc).__name__\n648\t\n649\t\n650\tif __name__ == \"__main__\":\n651\t    sys.exit(main())\n652\t"}]},"parent_tool_use_id":null,"session_id":"6cb4051e-a398-43c8-941a-d1137bf30aab","uuid":"1984a6db-1ca6-47ec-a1b3-7a9221eea837","timestamp":"2026-11-15T09:56:40.598Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_agent_spawn.py","content":"#!/usr/bin/env python3\n\"\"\"Governance Hook: named agents MUST include ## SKILL CONTENT.\n\nRegistered in `.claude/settings.json` under `hooks.PreToolUse.Agent`.\nRuns via the `_python-hook.sh` shim (A.4) for Python version resolution.\n\nPort of `.claude/hooks/check-agent-spawn.sh` with:\n- stdlib-only (no jq dependency)\n- unit-testable (logic is in `decide()`, not tangled with stdin/stdout)\n- fail-open on any internal error (never blocks the user on infrastructure bug)\n\n## Two detection strategies\n\n1. The agent's `description` field contains a team member name, extracted\n   dynamically from team.md / frontend-team.md / domains/*/team-personas.md.\n2. The prompt contains a persona header (`PERSONA:`, `## AGENT PROFILE`,\n   `## PERSONA`) — self-describing spawn.\n\nIf either strategy matches, the prompt MUST contain `## SKILL CONTENT`.\nWithout it, the spawn is blocked as a generic agent wearing a name tag.\n\nThe extracted agent_spawn.skill_reference helpers also validate references to\nSKILL.md files under .claude/skills; this hook still guards that skill surface.\n\n## Output contract\n\nWrites a single-line JSON decision to stdout:\n\n    {\"decision\":\"allow\"}\n    {\"decision\":\"block\",\"reason\":\"GOVERNANCE: ...\"}\n\nExit code is 0 in both cases — Claude Code reads the decision from stdout,\nnot the exit code. Internal errors (bad stdin, missing team files, etc.)\nare logged to stderr and the spawn is allowed (fail-open).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nimport unicodedata\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n# Make the _lib package importable — hooks live in .claude/hooks/ and\n# _lib is a sibling package; delegated skill-reference guards cover .claude/skills/**/SKILL.md.\n_HOOKS_DIR = Path(__file__).resolve().parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\nfrom _lib import contract as _contract  # noqa: E402\nfrom _lib.adapters import claude as _claude_adapter  # noqa: E402\nfrom _lib import team as _team  # noqa: E402\nfrom _lib import redact as _redact  # noqa: E402  (PLAN-020 Phase 2: skill-ref scan)\n\n# PLAN-106 Wave G.1 — sub-agent N-of-M aggregator with partial-drop emit.\n# Re-exported below as `aggregate_subagent_findings` so coordinator-side\n# callers (swarm coordinator, future debate consensus aggregator) can\n# `from check_agent_spawn import aggregate_subagent_findings` without\n# poking into `_lib`. Closes AC10 grep contract.\nfrom _lib import subagent_dispatch as _subagent_dispatch  # noqa: E402\n\n# PLAN-045 Wave 1 P0-03 — VETO floor runtime validator.\ntry:\n    from _lib import agent_frontmatter as _agent_frontmatter\nexcept Exception:  # pragma: no cover\n    _agent_frontmatter = None  # type: ignore[assignment]\n\n# Optional: emit veto_triggered to event stream v2 (fail-open)\ntry:\n    # PLAN-094 Wave E — lazy-import dispatch shim closes AC9c spawn-hook regression\n    from _lib import audit_emit_dispatch as _audit_emit  # noqa: E402\n    _AUDIT_EMIT_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _AUDIT_EMIT_AVAILABLE = False\n\n# PLAN-092 Wave A.4 — cookbook-advisor pattern matcher (fail-open import).\ntry:\n    from _lib import cookbook_patterns as _cookbook_patterns  # noqa: E402\n    _COOKBOOK_PATTERNS_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _COOKBOOK_PATTERNS_AVAILABLE = False\n\n# PLAN-112-FOLLOWUP-persona-routing-wire W1 — persona_routing matrix\n# consult (fail-open import). The god-mode (persona × primitive) routing\n# matrix declares AUTO-05 (\"model_routing_advised\") ENFORCING per\n# ADR-118-AMEND-1, but check_agent_spawn never consulted it — the policy\n# was dead at runtime. This wire makes the matrix observable/auditable.\n# CONSULT + AUDIT ONLY — the BLOCK is DEFERRED (the hook payload exposes\n# no requested-model signal; see plan §2/§3). NEVER read\n# `_PRIMITIVE_DEFAULT_MODE` directly — get_mode() encapsulates the\n# kill-switch demotion.\ntry:\n    from _lib import persona_routing as _persona_routing  # noqa: E402\nexcept Exception:  # pragma: no cover - fail-open\n    _persona_routing = None  # type: ignore[assignment]\n\n# PLAN-113 WIRE-DEADMOD — SEC-P0-01 spec-context sanitizer (ADR-089).\n# Sanitizes the ## SPEC CONTEXT block payload in spawn prompts before allow.\n# ADVISORY telemetry only: sanitize result is emitted via emit_generic so\n# sentinel violations / truncation are visible in the audit log. Never blocks.\n# Fail-open: missing module → _SPEC_CTX_SANITIZER_AVAILABLE = False.\ntry:\n    from _lib import spec_context_sanitizer as _spec_ctx_sanitizer  # noqa: E402\n    _SPEC_CTX_SANITIZER_AVAILABLE = True\nexcept Exception:  # pragma: no cover - fail-open\n    _spec_ctx_sanitizer = None  # type: ignore[assignment]\n    _SPEC_CTX_SANITIZER_AVAILABLE = False\n\n# PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n# Classifies the spawn action type and emits a spawn_confidence_advisory event\n# so that recommender / receipt formatter surfaces have a hook-level signal.\n# ADVISORY only — never blocks. Fail-open.\ntry:\n    from _lib import confidence_labels as _confidence_labels  # noqa: E402\n    _CONFIDENCE_LABELS_AVAILABLE = True\nexcept Exception:  # pragma: no cover - fail-open\n    _confidence_labels = None  # type: ignore[assignment]\n    _CONFIDENCE_LABELS_AVAILABLE = False\n\n# Components bind to the facade to preserve patched globals and isolated state.\ndef _load_spawn_part(name):\n    try:\n        from _lib._audit_emit_parts import install\n        install(globals(), (name,), package=\"_lib.agent_spawn\")\n    except Exception as exc:\n        if __name__ != \"__main__\":\n            raise\n        print(f\"[check_agent_spawn] FATAL: {type(exc).__name__}: {exc}\", file=sys.stderr)\n        print(json.dumps({}))\n        sys.exit(0)\n\n_load_spawn_part(\"model_routing\")\n_load_spawn_part(\"advisories\")\n_load_spawn_part(\"prompt_rules\")\n\n@dataclass\nclass Decision:\n    \"\"\"Typed result of the governance check.\"\"\"\n\n    allow: bool\n    reason: Optional[str] = None\n\n    def to_json(self) -> str:\n        if self.allow:\n            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow\n        return json.dumps(\n            {\"decision\": \"block\", \"reason\": self.reason or \"\"},\n            ensure_ascii=False,\n        )\n\n\n\ndef _emit_cookbook_pattern_advisory(\n    *,\n    description: str,\n    prompt: str,\n    env=None,\n) -> None:\n    \"\"\"PLAN-092 Wave A.4 (W3.2 SEMI-11) — emit cookbook_pattern_advised\n    when a spawn prompt matches one of 4 Anthropic Cookbook pattern\n    trigger taxonomies (COOK-P1..P4).\n\n    Advisory ONLY — UX hint. NEVER blocks, NEVER mutates tool_input.\n    Rate-cap via PLAN-088 global _plan088_rate_admit in audit_emit.\n    Kill-switch: CEO_COOKBOOK_ADVISOR_ENABLED=0. Privacy invariant:\n    3 fields max (no raw prompt persisted — AC3b).\n\n    Audit-emit signature mapping (PLAN-090 W3.2 canonical contract):\n      pattern_id (COOK-P*)   -> top_pattern_keys\n      trigger_class (string) -> task_signature (enum-constrained \"other\")\n      bucket (high/med/low)  -> pattern_count (3/2/1)\n\n    NEVER raises.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if not _COOKBOOK_PATTERNS_AVAILABLE:\n            return\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        # Kill-switch\n        try:\n            if hasattr(_cookbook_patterns, \"kill_switch_enabled\"):\n                if not _cookbook_patterns.kill_switch_enabled():\n                    return\n            else:\n                val = (src_env.get(\"CEO_COOKBOOK_ADVISOR_ENABLED\") or \"1\").strip()\n                if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n                    return\n        except Exception:  # pragma: no cover\n            return\n        # Concat description + prompt, cap at 8KiB\n        text = ((description or \"\") + \"\\n\" + (prompt or \"\"))[: 8 * 1024]\n        if not text.strip():\n            return\n        # Match (first-hit canonical order COOK-P1 -> P4)\n        try:\n            result = _cookbook_patterns.match_pattern(text)\n        except Exception:  # pragma: no cover\n            return\n        if result is None:\n            return\n        pattern_id, trigger_class, bucket = result\n        if not hasattr(_audit_emit, \"emit_cookbook_pattern_advised\"):\n            return\n        # Map semantic -> canonical signature\n        bucket_to_count = {\"high\": 3, \"medium\": 2, \"low\": 1}\n        try:\n            _audit_emit.emit_cookbook_pattern_advised(\n                task_signature=\"other\",\n                top_pattern_keys=str(pattern_id)[:128],\n                pattern_count=bucket_to_count.get(str(bucket), 1),\n            )\n        except Exception:  # pragma: no cover\n            return\n    except Exception:  # pragma: no cover - fail-open invariant\n        return\n\n\n# ---------------------------------------------------------------------------\n# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [END]\n# ---------------------------------------------------------------------------\n\ndef decide(\n    *,\n    description: str,\n    prompt: str,\n    names_regex,\n    env: Optional[dict] = None,\n    subagent_type: str = \"\",\n) -> Decision:\n    \"\"\"Pure decision function — no I/O, trivially unit-testable.\n\n    Args:\n        description: The Agent tool's `description` field.\n        prompt: The Agent tool's `prompt` field.\n        names_regex: A compiled regex matching team member names, or None\n            if no team files were found (degrades to header-only detection).\n        env: Environment-var dict (defaults to os.environ). Used to read\n            CEO_ARCHITECT_ACTIVE for the recursion guard (Sprint 5 ADR-010).\n        subagent_type: Agent tool ``subagent_type`` field (PLAN-078 Wave 1\n            telemetry). Used to identify archetype for model-routing\n            advisory emit; never affects the allow/block decision.\n\n    Returns:\n        Decision(allow=True) if the spawn is fine.\n        Decision(allow=False, reason=...) if governance requires blocking.\n    \"\"\"\n    src_env = env if env is not None else os.environ\n\n    # PLAN-133 E3 — resolve session id once for the spawn-rails (depth/overlap).\n    _e3_session_id = _resolve_session_id_from_env(src_env)\n\n    # PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n    # payload (advisory telemetry; never blocks). Runs early so sentinel\n    # violations are logged before any governance decision. Fail-open.\n    _sanitize_spec_context_advisory(prompt or \"\", env=src_env)\n\n    # PLAN-133 A2 (Goose-harvest) — fail-CLOSED invisible-unicode guard.\n    # Default-OFF (CEO_UNICODE_HARDBLOCK=1 enforces); when enforced, a spawn\n    # prompt carrying control / bidi / zero-width / U+E0000-E007F Tag-block\n    # chars is BLOCKED here, BEFORE any LLM/debate/governance review. The\n    # breadcrumb (invisible_unicode_blocked) is emitted on both the advisory\n    # and enforced paths so the measure-first denominator is real. Fail-open.\n    _uni_block = _enforce_spec_context_unicode(prompt or \"\", env=src_env)\n    if _uni_block is not None:\n        return Decision(allow=False, reason=_uni_block)\n\n    # Session 75 Codex Finding 4 closure: scan spawn prompt for\n    # leaked secrets when Owner-opted-in via CEO_SPAWN_SECRET_SCAN=1.\n    # Default OFF; without the env var, _validate_spawn_prompt_has_no_secrets\n    # short-circuits to ok=True so legacy spawns are unaffected.\n    _scan_ok, _scan_code, _scan_detail = _validate_spawn_prompt_has_no_secrets(prompt)\n    if not _scan_ok:\n        return Decision(\n            allow=False,\n            reason=(\n                f\"SPAWN-SECRET-BLOCKED: {_scan_code} ({_scan_detail}). \"\n                \"To bypass once: unset CEO_SPAWN_SECRET_SCAN.\"\n            ),\n        )\n\n    # PLAN-045 Wave 1 P0-03 — VETO floor runtime check.\n    # If the spawn targets a VETO-floor role (code-reviewer,\n    # security-engineer), verify the agent frontmatter still binds\n    # them to Opus. Closes F-01-03 demotion-via-frontmatter attack.\n    # Skipped when the validator lib is missing (defense-in-depth\n    # fail-open; arbitration kernel still blocks agents/*.md edits).\n    if _agent_frontmatter is not None:\n        agents_dir = Path(\n            src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        ) / \".claude\" / \"agents\"\n        haystack_lower = \" \".join([\n            (description or \"\").lower(), (prompt or \"\").lower()\n        ])\n        for _role in sorted(_agent_frontmatter.VETO_FLOOR_ROLES):\n            if _role.lower() not in haystack_lower:\n                continue\n            ok, reason = _agent_frontmatter.check_veto_floor_for_role(\n                _role, agents_dir\n            )\n            if not ok and reason != \"not_veto_role\":\n                return Decision(\n                    allow=False,\n                    reason=(\n                        f\"GOVERNANCE: veto_floor_demoted: role={_role} \"\n                        f\"reason={reason}. The VETO floor requires \"\n                        \"security-engineer and code-reviewer to bind to a \"\n                        \"member of VETO_FLOOR_ALLOWED (agent_frontmatter.py) \"\n                        \"- the enforcement is set membership, not one id. \"\n                        \"See ADR-052 + PLAN-045 Wave 1 P0-03; PLAN-169 W2.10 D2.\"\n                    ),\n                )\n\n    # PLAN-078 Wave 1 — model routing advisory telemetry (advisory-only).\n    # Runs AFTER VETO-floor enforcement so the hard-block path remains\n    # authoritative. Emits `model_routing_advised` event when a spawn\n    # archetype is identifiable. NEVER mutates tool_input. NEVER blocks.\n    # Bypass: `CEO_MODEL_ROUTING=0`.\n    _emit_model_routing_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n    )\n\n    # PLAN-112-FOLLOWUP-persona-routing-wire W1 — god-mode matrix consult.\n    # Runs AFTER the VETO-floor hard-block (above) so it never masks it.\n    # CONSULT + AUDIT ONLY — emits model_routing_enforced /\n    # model_routing_eval_error; NEVER blocks (block deferred, see W3 above).\n    # Mode is read off authoritative subagent_type only.\n    _consult_model_routing_mode(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n    )\n\n    # PLAN-091 Wave A.4 (W3.1) — MCP routing advisory.\n    # Maps archetype → mcp_routing task_class; resolver emits\n    # `mcp_route_advised` (PLAN-086 Wave D). Bypass: CEO_MCP_ROUTING_HOOK=0.\n    _emit_mcp_routing_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n    )\n\n    # PLAN-091 Wave A.5 (W3.3) — specialization promotion heuristic.\n    # When general-purpose spawn matches a specialist hint, emit\n    # `specialization_promoted` advisory. NEVER auto-spawns.\n    # Bypass: CEO_PROMOTION_HEURISTIC=0.\n    _emit_promotion_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n    )\n\n    # PLAN-092 Wave A.4 (W3.2 SEMI-11) — cookbook-advisor pattern hint.\n    # Matches spawn against 4 Anthropic Cookbook patterns (COOK-P1..P4);\n    # emits `cookbook_pattern_advised` advisory. Kill-switch:\n    # CEO_COOKBOOK_ADVISOR_ENABLED=0. NEVER mutates tool_input.\n    _emit_cookbook_pattern_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        env=src_env,\n    )\n\n    # PLAN-098 Wave C.2 (ADR-132) — GOAP advisory-only invariant.\n    # PLAN-105 Wave A.6 — capture intent for deferred-emit at allow-return.\n    _goap_intent_plan_id: Optional[str] = None\n    _goap_intent_action_id: Optional[str] = None\n    if _GOAP_PLAN_ID_RE.search(prompt or \"\"):\n        owner_confirmed_env = (src_env.get(\"CEO_GOAP_CONFIRMED\") or \"\").strip() == \"1\"\n        has_goap_confirm_block = bool(_GOAP_CONFIRM_HEADER_RE.search(prompt or \"\"))\n        if not (owner_confirmed_env and has_goap_confirm_block):\n            preview = (description or \"\")[:80]\n            missing: List[str] = []\n            if not owner_confirmed_env:\n                missing.append(\"CEO_GOAP_CONFIRMED=1 env\")\n            if not has_goap_confirm_block:\n                missing.append(\"## GOAP CONFIRM block\")\n            return Decision(\n                allow=False,\n                reason=(\n                    \"GOVERNANCE: goap_advisory_without_owner_confirm: \"\n                    f\"spawn references a GOAP plan (description={preview!r}) \"\n                    f\"but lacks: {', '.join(missing)}. The GOAP planner is \"\n                    \"advisory-only - the Owner must physically confirm each \"\n                    \"action before spawn. See ADR-132 Decision Part 2.\"\n                ),\n            )\n        # PLAN-105 Wave A.6 — GOAP gates passed; record intent for deferred emit.\n        _pid_m = _GOAP_PLAN_ID_VALUE_RE.search(prompt or \"\")\n        _aid_m = _GOAP_ACTION_ID_VALUE_RE.search(prompt or \"\")\n        if _pid_m is not None:\n            _goap_intent_plan_id = _pid_m.group(1).strip()[:32]\n            if _aid_m is not None:\n                _goap_intent_action_id = _aid_m.group(1).strip()[:64]\n\n    # Recursion guard (ADR-010): block Architect-spawning-Architect.\n    architect_active = (src_env.get(\"CEO_ARCHITECT_ACTIVE\") or \"\").strip()\n    if architect_active == \"1\":\n        haystack = \" \".join([description or \"\", prompt or \"\"])\n        if _ARCHITECT_NAME_RE.search(haystack):\n            return Decision(\n                allow=False,\n                reason=(\n                    \"ARCHITECT-RECURSION: a spawn naming 'Agent Architect' \"\n                    \"was detected while CEO_ARCHITECT_ACTIVE=1. The Agent \"\n                    \"Architect must not spawn another instance of itself \"\n                    \"within the same session. See ADR-010.\"\n                ),\n            )\n\n    # PLAN-020 Phase 3 — /effort scope clause (QA must-fix #7): /effort\n    # hints are CEO-only. Spawn prompts MUST NOT include them.\n    if _has_effort_token(prompt or \"\"):\n        return Decision(\n            allow=False,\n            reason=(\n                \"GOVERNANCE: spawn prompt contains a `/effort` token. \"\n                \"Effort hints are CEO-only — sub-agents inherit Anthropic \"\n                \"default thinking budget. Strip /effort from the prompt \"\n                \"before retrying. See PLAN-020 §4 Phase 3 scope clause.\"\n            ),\n        )\n\n    desc_matched_name = False\n    if names_regex is not None and description:\n        if names_regex.search(description):\n            desc_matched_name = True\n\n    prompt_has_persona = False\n    if prompt and _PERSONA_HEADER_RE.search(prompt):\n        prompt_has_persona = True\n\n    is_named_spawn = desc_matched_name or prompt_has_persona\n\n    # PLAN-133 E3 — per-spawn tool scoping + depth/overlap rails. ADVISORY by\n    # default (emit-only, enforced=0); BLOCKS only under the per-rail env flag\n    # (CEO_SPAWN_TOOL_SCOPE / CEO_SPAWN_DEPTH_GUARD / CEO_SPAWN_OVERLAP_GUARD).\n    # Runs AFTER the VETO-floor + A2 unicode hard-blocks so those remain\n    # authoritative; runs BEFORE the SKILL CONTENT accept-path so an\n    # out-of-scope / depth-2 / clobbering spawn is rejected even when otherwise\n    # well-formed. Fail-open (returns None on any infra error).\n    _e3_hit = _enforce_spawn_rails(\n        prompt=prompt or \"\",\n        is_named_spawn=is_named_spawn,\n        env=src_env,\n        session_id=_e3_session_id,\n    )\n    if _e3_hit is not None:\n        _e3_code, _e3_detail = _e3_hit\n        return Decision(\n            allow=False,\n            reason=(\n                f\"GOVERNANCE: {_e3_code}: {_e3_detail}. \"\n                \"The spawn violates a PLAN-133 E3 rail (per-spawn tool \"\n                \"allow-list / depth-over-one fence / FILE ASSIGNMENT overlap) \"\n                \"or the ADR-191 FILE ASSIGNMENT grammar (PLAN-178 C1). \"\n                \"Fix for a grammar block: regenerate the prompt via \"\n                \".claude/scripts/inject-agent-context.sh (it always emits \"\n                \"the block). If the block is UNPARSEABLE, REPLACE or \"\n                \"remove the malformed block (the classifier aggregates \"\n                \"ALL blocks — appending a valid one cannot clear an \"\n                \"invalid token's taint); appending `## FILE ASSIGNMENT` \"\n                \"with `- CAN edit: <concrete paths>` or the explicit \"\n                \"read-only form `- CAN edit: NONE-READ-ONLY` works only \"\n                \"for the ABSENT state. Recovery route: \"\n                \"CEO_SOTA_DISABLE=1 forces advisory. See PLAN-133 §E E3 + \"\n                \"ADR-191.\"\n            ),\n        )\n\n    # PLAN-113 WIRE-DEADMOD — confidence_labels advisory (PLAN-083 Wave 1.10).\n    # Emits spawn_confidence_advisory so recommender / receipt formatter have\n    # a hook-level signal. Advisory only — never blocks. Fail-open.\n    _action_type = \"canonical_edit\" if is_named_spawn else \"bash_execute\"\n    _emit_spawn_confidence_advisory(\n        action_type=_action_type,\n        is_named_spawn=is_named_spawn,\n        env=src_env,\n    )\n\n    if not is_named_spawn:\n        # Generic research / simple tasks — no governance requirement.\n        _emit_goap_deferred_outcome(\n            _goap_intent_plan_id, _goap_intent_action_id, src_env\n        )\n        return Decision(allow=True)\n\n    # PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.\n    # NAMED spawns only (scoped here, after the generic early-return, so\n    # unmatched/generic spawns see zero behavior change). Runs BEFORE the\n    # SKILL REFERENCE / SKILL CONTENT accept-paths so an untrusted-content\n    # spawn missing the block is rejected even when otherwise well-formed.\n    # Input fail-CLOSED (matched + missing block => BLOCK); infra fail-OPEN\n    # inside _enforce_prompt_defense. Kill-switches documented at the gate.\n    _pd_hit = _enforce_prompt_defense(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        env=src_env,\n    )\n    if _pd_hit is not None:\n        _pd_code, _pd_detail = _pd_hit\n        return Decision(\n            allow=False,\n            reason=(\n                f\"GOVERNANCE: {_pd_code}: {_pd_detail}. This NAMED spawn's \"\n                \"task indicates contact with untrusted content (WebFetch/\"\n                \"WebSearch/scrape/imported/upstream/third-party), but the \"\n                \"prompt has no `## PROMPT DEFENSE` section with >= 6 bullet \"\n                \"lines. Fix: regenerate the prompt via \"\n                \".claude/scripts/inject-agent-context.sh (it emits the block \"\n                \"unconditionally), or append the 6-bullet anti-injection \"\n                \"block verbatim. See PLAN-153 Wave E item 7 / ADR-175.\"\n            ),\n        )\n\n    # PLAN-020 Phase 2 — Reference path (ADR-051). If `## SKILL REFERENCE`\n    # marker is present, validate strictly (fail-CLOSED). Reference path\n    # opt-in via env var; default ON per Q1 Owner answer.\n    if _is_enabled(\"CEO_SKILL_REFERENCE_MODE\", ENABLE_SKILL_REFERENCE_MODE, src_env):\n        if _SKILL_REFERENCE_HEADER_RE.search(prompt or \"\"):\n            ok, reason_code, detail = _validate_skill_reference(prompt or \"\")\n            if ok:\n                _emit_goap_deferred_outcome(\n                    _goap_intent_plan_id, _goap_intent_action_id, src_env\n                )\n                # PLAN-106 Wave C — persona coverage emit at allow path.\n                _emit_persona_coverage_synthesized(\n                    subagent_type=subagent_type,\n                    description=description,\n                    prompt=prompt,\n                    source=\"dispatch\",\n                    env=src_env,\n                )\n                return Decision(allow=True)\n            preview = (description or \"\")[:80]\n            return Decision(\n                allow=False,\n                reason=(\n                    f\"GOVERNANCE: {reason_code}: {detail}. \"\n                    f\"Spawn rejected (description={preview!r}). \"\n                    \"See ADR-051 §Synchronous validation for sub-check details.\"\n                ),\n            )\n\n    # Named spawn: require real SKILL CONTENT section (P1-SEC-B: bypass-resistant).\n    if _has_skill_content(prompt or \"\"):\n        _emit_goap_deferred_outcome(\n            _goap_intent_plan_id, _goap_intent_action_id, src_env\n        )\n        # PLAN-106 Wave C — persona coverage emit at allow path.\n        _emit_persona_coverage_synthesized(\n            subagent_type=subagent_type,\n            description=description,\n            prompt=prompt,\n            source=\"dispatch\",\n            env=src_env,\n        )\n        return Decision(allow=True)\n\n    # Build a helpful block reason pointing at the injector script.\n    preview = (description or \"\")[:80]\n    reason = (\n        \"GOVERNANCE: Agent spawn detected as NAMED \"\n        f\"(description='{preview}'), but prompt has no {_SKILL_CONTENT_MARKER} \"\n        \"section. Read the agent's skill file and include its full content \"\n        \"in the prompt before spawning. Use \"\n        \".claude/scripts/inject-agent-context.sh <AgentName> <task> to \"\n        \"generate a compliant prompt.\"\n    )\n    return Decision(allow=False, reason=reason)\n\n\n_load_spawn_part(\"outcome_telemetry\")\n\ndef _classify_block_reason(reason: str) -> str:\n    \"\"\"Map a Decision.reason string to a stable audit reason_code.\n\n    Defaults to ``unknown_block`` when no marker matches — visibility\n    on a marker drift is preferable to silent misclassification.\n    \"\"\"\n    if not reason:\n        return \"unknown_block\"\n    for needle, code in _BLOCK_REASON_MARKERS:\n        if needle in reason:\n            if code == \"__REFERENCE_PREFIX__\":\n                # Embedded reason_code form: \"GOVERNANCE: <code>: <detail>\".\n                # Skill-reference path emits codes like reference_hash_mismatch,\n                # reference_unsafe_path, etc. (constants at\n                # check_agent_spawn.py:188 REASON_REFERENCE_*).\n                head = reason[len(\"GOVERNANCE: \"):]\n                colon = head.find(\":\")\n                return head[:colon] if colon > 0 else \"reference_invalid\"\n            return code\n    return \"unknown_block\"\n\ndef _to_contract_decision(d: \"Decision\") -> _contract.Decision:\n    if d.allow:\n        return _contract.allow()\n    return _contract.block(d.reason or \"\")\n\n\n_load_spawn_part(\"entrypoint\")\n\n\n# PLAN-106 Wave G.1 — public re-export. Coordinator callers use:\n#     from check_agent_spawn import aggregate_subagent_findings\n# which proxies to `_lib.subagent_dispatch.aggregate_findings`. Doing\n# the re-export at this module level satisfies the grep contract AC10\n# (\"emit_subagent_findings_partial_drop ≥1 hit outside _lib/audit_emit\n# and tests/\") because the helper transitively names the emit symbol\n# in its docstring + raises the call site to the hook module surface.\ndef aggregate_subagent_findings(*args, **kwargs):\n    \"\"\"Wrap `_lib.subagent_dispatch.aggregate_findings`.\n\n    Emits `emit_subagent_findings_partial_drop` on shortfall via the\n    inner aggregator. See `_lib/subagent_dispatch.py` for the full\n    contract. Re-exported here so future coordinator code can call\n    `from check_agent_spawn import aggregate_subagent_findings` and the\n    grep contract (AC10) finds a hit at the hook-module surface\n    without dragging the dispatch logic into this 1700-LoC file.\n    \"\"\"\n    return _subagent_dispatch.aggregate_findings(*args, **kwargs)\n\n\n# Keep every extracted function on the historical module's globals so callers\n# can patch its seams and each import retains independent invocation state.\n_SPAWN_COMPONENT_IMPORT_ERROR = None\ntry:\n    # Surface guard: .claude/skills/** and SKILL.md (via _lib/agent_spawn/skill_reference.py)\n    from _lib.agent_spawn import bind as _bind_spawn_components\n    _bind_spawn_components(globals())\n    del _bind_spawn_components\nexcept Exception as _spawn_component_exc:\n    _SPAWN_COMPONENT_IMPORT_ERROR = type(_spawn_component_exc).__name__\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":652,"startLine":1,"totalLines":652}},"tool_result_meta":[{"id":"toolu_018kqUwGy917SraYoaqdabWz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
