{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018QH64dSWGymW1XmFSaseLh","type":"tool_result","content":"1315\t# because the global pre-flight has to answer BEFORE the first thing that\n1316\t# touches the target — and that thing is `mkdir -p \"$TARGET/.claude\"`, which\n1317\t# runs well above this point.\n1318\t\n1319\tinstall_one() {\n1320\t  local rel_path=\"$1\"\n1321\t  local src=\"$SOURCE_DIR/$rel_path\"\n1322\t  local dst=\"$TARGET/$rel_path\"\n1323\t\n1324\t  # PLAN-166 F3 (ADR-155-AMEND-1): delivery signal for the caller — 1 only\n1325\t  # when THIS call actually wrote the destination (COPIED/LINKED). An\n1326\t  # EXISTS-skip, a missing source and a dry-run all leave it 0.\n1327\t  INSTALL_ONE_WROTE=0\n1328\t\n1329\t  if [[ ! -e \"$src\" ]]; then\n1330\t    echo \"    SKIP (source missing): $rel_path\"\n1331\t    return\n1332\t  fi\n1333\t\n1334\t  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n1335\t    if [[ -e \"$dst\" || -L \"$dst\" ]]; then\n1336\t      echo \"    (dry-run) EXISTS (would skip): $rel_path\"\n1337\t    elif [[ \"$MODE\" == \"link\" ]]; then\n1338\t      echo \"    (dry-run) would LINK: $rel_path\"\n1339\t    else\n1340\t      echo \"    (dry-run) would COPY: $rel_path\"\n1341\t    fi\n1342\t    return\n1343\t  fi\n1344\t\n1345\t  _assert_no_symlink_parents \"$rel_path\"\n1346\t  mkdir -p \"$( dirname \"$dst\" )\"\n1347\t\n1348\t  if [[ -e \"$dst\" || -L \"$dst\" ]]; then\n1349\t    echo \"    EXISTS (skipping): $rel_path\"\n1350\t    return\n1351\t  fi\n1352\t\n1353\t  if [[ \"$MODE\" == \"link\" ]]; then\n1354\t    ln -s \"$src\" \"$dst\"\n1355\t    INSTALL_ONE_WROTE=1\n1356\t    # V5 (repass-r2 part-a): remember every link THIS run created. The\n1357\t    # manifest writer exports the exact set as FMS_LINK_PATHS, so the\n1358\t    # generator never allow-all serializes a pre-existing adopter symlink\n1359\t    # (EXISTS-skipped above, hence NOT in this list) as a LINK delivery.\n1360\t    _CREATED_LINK_RELPATHS=\"${_CREATED_LINK_RELPATHS:-}\n1361\t$rel_path\"\n1362\t    echo \"    LINKED: $rel_path\"\n1363\t  else\n1364\t    if [[ -d \"$src\" ]]; then\n1365\t      cp -R \"$src\" \"$dst\"\n1366\t    else\n1367\t      cp \"$src\" \"$dst\"\n1368\t    fi\n1369\t    INSTALL_ONE_WROTE=1\n1370\t    echo \"    COPIED: $rel_path\"\n1371\t  fi\n1372\t}\n1373\t\n1374\tinstall_template() {\n1375\t  local src_rel=\"$1\"\n1376\t  local dst_rel=\"$2\"\n1377\t  local src=\"$SOURCE_DIR/$src_rel\"\n1378\t  local dst=\"$TARGET/$dst_rel\"\n1379\t\n1380\t  if [[ ! -f \"$src\" ]]; then\n1381\t    echo \"    SKIP (template missing): $src_rel\"\n1382\t    return\n1383\t  fi\n1384\t\n1385\t  # PLAN-185 W1 (writer 1/6) — ahead of the `-e` test, which follows symlinks.\n1386\t  # The dry-run branch consults the SAME predicate: its \"would COPY\" line is\n1387\t  # what the adopter decides on, and over a dangling link it was a lie.\n1388\t  if _dst_refuses \"$dst_rel\"; then\n1389\t    return\n1390\t  fi\n1391\t\n1392\t  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n1393\t    if [[ -e \"$dst\" ]]; then\n1394\t      echo \"    (dry-run) EXISTS (would skip template): $dst_rel\"\n1395\t    else\n1396\t      echo \"    (dry-run) would COPY template: $src_rel -> $dst_rel\"\n1397\t    fi\n1398\t    return\n1399\t  fi\n1400\t\n1401\t  if [[ -e \"$dst\" ]]; then\n1402\t    echo \"    EXISTS (skipping template): $dst_rel\"\n1403\t    return\n1404\t  fi\n1405\t\n1406\t  mkdir -p \"$( dirname \"$dst\" )\"\n1407\t  cp \"$src\" \"$dst\"\n1408\t  echo \"    COPIED template: $src_rel -> $dst_rel\"\n1409\t}\n1410\t\n1411\thas_profile() {\n1412\t  local p=\"$1\"\n1413\t  for part in \"${PROFILE_PARTS[@]}\"; do\n1414\t    if [[ \"$part\" == \"$p\" ]]; then\n1415\t      return 0\n1416\t    fi\n1417\t  done\n1418\t  return 1\n1419\t}\n1420\t\n1421\t# ---- 1. Team rosters (always installed — these are templates with placeholders) ----\n1422\t\n1423\t_state_record_op \"install_team_rosters\" \".claude/team.md + .claude/frontend-team.md\"\n1424\tinstall_one \".claude/team.md\"\n1425\tinstall_one \".claude/frontend-team.md\"\n1426\t\n1427\t# ---- 2. Core skills (always installed if 'core' in profile) ----\n1428\t\n1429\tif has_profile \"core\"; then\n1430\t  echo \"\"\n1431\t  echo \"==> Installing core skills\"\n1432\t  _state_record_op \"install_skills\" \"core\"\n1433\t  install_one \".claude/skills/core\"\n1434\tfi\n1435\t\n1436\t# ---- 3. Frontend skills (installed if 'frontend' in profile) ----\n1437\t\n1438\tif has_profile \"frontend\"; then\n1439\t  echo \"\"\n1440\t  echo \"==> Installing frontend skills\"\n1441\t  _state_record_op \"install_skills\" \"frontend\"\n1442\t  install_one \".claude/skills/frontend\"\n1443\tfi\n1444\t\n1445\t# ---- 4. Domain skills (installed per domain name in profile) ----\n1446\t\n1447\tfor part in \"${PROFILE_PARTS[@]}\"; do\n1448\t  if [[ \"$part\" != \"core\" && \"$part\" != \"frontend\" ]]; then\n1449\t    DOMAIN_SRC=\"$SOURCE_DIR/.claude/skills/domains/$part\"\n1450\t    if [[ ! -d \"$DOMAIN_SRC\" ]]; then\n1451\t      echo \"\"\n1452\t      echo \"    WARNING: domain '$part' not found at $DOMAIN_SRC — skipping\"\n1453\t      continue\n1454\t    fi\n1455\t    echo \"\"\n1456\t    echo \"==> Installing domain: $part\"\n1457\t    _state_record_op \"install_skills\" \"domain:$part\"\n1458\t    install_one \".claude/skills/domains/$part\"\n1459\t  fi\n1460\tdone\n1461\t\n1462\t# ---- 5. Protocol enforcement (hooks, scripts, catalogs — always installed) ----\n1463\t#\n1464\t# NOTE (PLAN-003 Phase 0 I-4): hooks/ and scripts/ are installed\n1465\t# SELECTIVELY — only top-level files + hooks/_lib/ are shipped to\n1466\t# targets. Framework-internal directories excluded:\n1467\t#\n1468\t#   .claude/hooks/tests/      — 89 unit tests for the framework itself\n1469\t#   .claude/hooks/legacy/     — Sprint 1 bash fallbacks (removed in\n1470\t#                                Sprint 3 Item C once invariants met)\n1471\t#   .claude/scripts/tests/    — 74 unit tests for audit-query,\n1472\t#                                run-skill-benchmark, check-tier-boundaries\n1473\t#\n1474\t# Rationale: targets don't need our tests or fallbacks — they add ~100\n1475\t# files of bloat. Target installs should only carry the ACTIVE runtime\n1476\t# surface: _lib/, _python-hook.sh, active Python hooks, and active\n1477\t# scripts. New hooks added at the top level (e.g. check_bash_safety.py\n1478\t# in I-5a) are picked up automatically by the *.py/*.sh glob below.\n1479\t\n1480\t# PLAN-120-FOLLOWUP WS-D (E4-F1/E4-F2) — install _lib/ SELECTIVELY. A flat\n1481\t# `install_one .claude/hooks/_lib` does cp -R (or a whole-tree symlink),\n1482\t# which drags the framework's OWN test harness into the adopter runtime:\n1483\t# _lib/tests/ (emits real audit events with no session redirect — no\n1484\t# conftest ships) + test_isolation.py / testing.py (both `import pytest`\n1485\t# at module top). We iterate the top-level _lib entries and skip exactly\n1486\t# those three names; everything else (all runtime *.py + the runtime\n1487\t# subdirs adapters/ estimation/ federation/ mcp/ otel/ tier_policy/ +\n1488\t# __init__.py) ships. New runtime modules are picked up automatically by\n1489\t# the glob, matching the install_scripts_selective convention.\n1490\t# PLAN-161 U2 (codex r1 F7): prune nested __pycache__/ dirs + *.pyc files\n1491\t# under a freshly-copied destination directory. The exclusion predicate above\n1492\t# screens only TOP-LEVEL _lib entries; a permitted SUBDIRECTORY (e.g.\n1493\t# _lib/adapters) is cp -R'd wholesale, dragging nested __pycache__ dirs and\n1494\t# .pyc files the predicate declares globally excluded. Per-file delete +\n1495\t# rmdir only — NEVER rm -rf. Refuses to operate through a symlink root\n1496\t# (link-mode dst is a symlink into the SOURCE tree). Fail-open: every step\n1497\t# is guarded; never changes the install exit status.\n1498\t_prune_pycache_under() {\n1499\t  local _pp_root=\"$1\" _pp_d _pp_f\n1500\t  [[ -d \"$_pp_root\" && ! -L \"$_pp_root\" ]] || return 0\n1501\t  # 1) *.pyc files anywhere under the copied destination (find without -L:\n1502\t  #    symlinks are never followed).\n1503\t  while IFS= read -r _pp_f; do\n1504\t    [[ -n \"$_pp_f\" ]] || continue\n1505\t    rm -f \"$_pp_f\" 2>/dev/null || true\n1506\t  done < <( find \"$_pp_root\" -type f -name '*.pyc' -print 2>/dev/null )\n1507\t  # 2) __pycache__ dirs, deepest first (-depth): delete their files one by\n1508\t  #    one, then rmdir. A dir still holding anything unexpected simply stays.\n1509\t  while IFS= read -r _pp_d; do\n1510\t    [[ -n \"$_pp_d\" && -d \"$_pp_d\" && ! -L \"$_pp_d\" ]] || continue\n1511\t    while IFS= read -r _pp_f; do\n1512\t      [[ -n \"$_pp_f\" ]] || continue\n1513\t      rm -f \"$_pp_f\" 2>/dev/null || true\n1514\t    done < <( find \"$_pp_d\" \\( -type f -o -type l \\) -print 2>/dev/null )\n1515\t    rmdir \"$_pp_d\" 2>/dev/null || true\n1516\t  done < <( find \"$_pp_root\" -depth -type d -name '__pycache__' -print 2>/dev/null )\n1517\t  return 0\n1518\t}\n1519\t\n1520\tinstall_lib_selective() {\n1521\t  echo \"\"\n1522\t  echo \"==> Installing hooks/_lib (runtime only — tests/, test_isolation.py, testing.py excluded)\"\n1523\t  local e base preexisting\n1524\t  for e in \"$SOURCE_DIR/.claude/hooks/_lib/\"*; do\n1525\t    [[ -e \"$e\" ]] || continue\n1526\t    base=\"$( basename \"$e\" )\"\n1527\t    # PLAN-161 U2 (CF-7): route through the ONE canonical framework-internal\n1528\t    # exclusion predicate (scripts/_framework_manifest_set.sh) so install and\n1529\t    # upgrade can never drift apart again. Behavior identical to the previous\n1530\t    # literal case; the fallback case below only serves a partial checkout\n1531\t    # where the helper file was absent at source time (fail-open parity).\n1532\t    if command -v _framework_path_excluded >/dev/null 2>&1; then\n1533\t      if _framework_path_excluded \".claude/hooks/_lib/$base\"; then continue; fi\n1534\t    else\n1535\t      case \"$base\" in\n1536\t        tests|test_isolation.py|testing.py|__pycache__) continue ;;\n1537\t      esac\n1538\t    fi\n1539\t    preexisting=0\n1540\t    [[ -e \"$TARGET/.claude/hooks/_lib/$base\" || -L \"$TARGET/.claude/hooks/_lib/$base\" ]] && preexisting=1\n1541\t    install_one \".claude/hooks/_lib/$base\"\n1542\t    # PLAN-161 U2 (codex r1 F7): only a directory we JUST copied is pruned —\n1543\t    # a pre-existing (EXISTS-skipped) adopter dir is left untouched, link\n1544\t    # mode installs a symlink (the prune helper refuses symlink roots), and\n1545\t    # dry-run copies nothing.\n1546\t    if [[ \"$DRY_RUN\" -eq 0 && \"$MODE\" != \"link\" && \"$preexisting\" -eq 0 && -d \"$e\" && ! -L \"$e\" ]]; then\n1547\t      _prune_pycache_under \"$TARGET/.claude/hooks/_lib/$base\"\n1548\t    fi\n1549\t  done\n1550\t}\n1551\t\n1552\tinstall_hooks_selective() {\n1553\t  echo \"\"\n1554\t  echo \"==> Installing hooks (top-level + _lib/, tests/ + legacy/ excluded)\"\n1555\t  _state_record_op \"install_hooks\" \"selective (top-level + _lib)\"\n1556\t  install_lib_selective\n1557\t  local f base\n1558\t  for f in \"$SOURCE_DIR/.claude/hooks/\"*.sh \"$SOURCE_DIR/.claude/hooks/\"*.py; do\n1559\t    [[ -f \"$f\" ]] || continue\n1560\t    base=\"$( basename \"$f\" )\"\n1561\t    install_one \".claude/hooks/$base\"\n1562\t  done\n1563\t}\n1564\t\n1565\t# WS4-dispatcher-fn: E6-F5 fix — copy .claude/dispatcher/ (validate-governance.sh REQUIRES it)\n1566\tinstall_dispatcher() {\n1567\t  local src=\"$SOURCE_DIR/.claude/dispatcher\"\n1568\t  local dst=\"$TARGET/.claude/dispatcher\"\n1569\t  if [[ ! -d \"$src\" ]]; then\n1570\t    echo \"    SKIP: .claude/dispatcher/ absent in source\" >&2\n1571\t    return 0\n1572\t  fi\n1573\t  echo \"\"\n1574\t  echo \"==> Installing dispatcher (.claude/dispatcher/ — E6-F5 validate-governance gate)\"\n1575\t  _state_record_op \"install_dispatcher\" \".claude/dispatcher\"\n1576\t  local f\n1577\t  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n1578\t    for f in routing-matrix.yaml routing-matrix-loader.py disable_predicate_eval.py; do\n1579\t      [[ -f \"$src/$f\" ]] && echo \"    (dry-run) would COPY: .claude/dispatcher/$f\"\n1580\t    done\n1581\t    return 0\n1582\t  fi\n1583\t  mkdir -p \"$dst\"\n1584\t  for f in routing-matrix.yaml routing-matrix-loader.py disable_predicate_eval.py; do\n1585\t    if [[ -f \"$src/$f\" ]]; then\n1586\t      cp \"$src/$f\" \"$dst/$f\"\n1587\t      echo \"    COPIED: .claude/dispatcher/$f\"\n1588\t    fi\n1589\t  done\n1590\t}\n1591\t\n1592\tinstall_scripts_selective() {\n1593\t  echo \"\"\n1594\t  echo \"==> Installing scripts (top-level only, tests/ excluded)\"\n1595\t  _state_record_op \"install_scripts\" \"selective\"\n1596\t  # PLAN-085 Wave A.1 (F-A-QA-0001-c7f21a3e): *.yaml extension added to\n1597\t  # the glob so policy/config YAMLs co-located with scripts/ ship to\n1598\t  # adopters. Without this, files like smart-loading-cap-table.yaml\n1599\t  # (pre-Wave-A.2 location) were silently dropped, breaking the\n1600\t  # first-run-wizard.py crash chain documented in PLAN-084 Wave C.4.\n1601\t  # Post-A.2 the cap-table lives in .claude/policies/, but keeping\n1602\t  # *.yaml in the script glob is the right default for any future\n1603\t  # YAML siblings in .claude/scripts/ (and is the install convention\n1604\t  # we should have shipped from day 1)."}]},"parent_tool_use_id":null,"session_id":"e7b3e450-1c4f-493e-92a7-7354e7f74aff","uuid":"5bf29b3b-e088-47fc-a683-47c5f13b95db","timestamp":"2026-11-13T17:05:11.478Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/scripts/install.sh","content":"# because the global pre-flight has to answer BEFORE the first thing that\n# touches the target — and that thing is `mkdir -p \"$TARGET/.claude\"`, which\n# runs well above this point.\n\ninstall_one() {\n  local rel_path=\"$1\"\n  local src=\"$SOURCE_DIR/$rel_path\"\n  local dst=\"$TARGET/$rel_path\"\n\n  # PLAN-166 F3 (ADR-155-AMEND-1): delivery signal for the caller — 1 only\n  # when THIS call actually wrote the destination (COPIED/LINKED). An\n  # EXISTS-skip, a missing source and a dry-run all leave it 0.\n  INSTALL_ONE_WROTE=0\n\n  if [[ ! -e \"$src\" ]]; then\n    echo \"    SKIP (source missing): $rel_path\"\n    return\n  fi\n\n  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n    if [[ -e \"$dst\" || -L \"$dst\" ]]; then\n      echo \"    (dry-run) EXISTS (would skip): $rel_path\"\n    elif [[ \"$MODE\" == \"link\" ]]; then\n      echo \"    (dry-run) would LINK: $rel_path\"\n    else\n      echo \"    (dry-run) would COPY: $rel_path\"\n    fi\n    return\n  fi\n\n  _assert_no_symlink_parents \"$rel_path\"\n  mkdir -p \"$( dirname \"$dst\" )\"\n\n  if [[ -e \"$dst\" || -L \"$dst\" ]]; then\n    echo \"    EXISTS (skipping): $rel_path\"\n    return\n  fi\n\n  if [[ \"$MODE\" == \"link\" ]]; then\n    ln -s \"$src\" \"$dst\"\n    INSTALL_ONE_WROTE=1\n    # V5 (repass-r2 part-a): remember every link THIS run created. The\n    # manifest writer exports the exact set as FMS_LINK_PATHS, so the\n    # generator never allow-all serializes a pre-existing adopter symlink\n    # (EXISTS-skipped above, hence NOT in this list) as a LINK delivery.\n    _CREATED_LINK_RELPATHS=\"${_CREATED_LINK_RELPATHS:-}\n$rel_path\"\n    echo \"    LINKED: $rel_path\"\n  else\n    if [[ -d \"$src\" ]]; then\n      cp -R \"$src\" \"$dst\"\n    else\n      cp \"$src\" \"$dst\"\n    fi\n    INSTALL_ONE_WROTE=1\n    echo \"    COPIED: $rel_path\"\n  fi\n}\n\ninstall_template() {\n  local src_rel=\"$1\"\n  local dst_rel=\"$2\"\n  local src=\"$SOURCE_DIR/$src_rel\"\n  local dst=\"$TARGET/$dst_rel\"\n\n  if [[ ! -f \"$src\" ]]; then\n    echo \"    SKIP (template missing): $src_rel\"\n    return\n  fi\n\n  # PLAN-185 W1 (writer 1/6) — ahead of the `-e` test, which follows symlinks.\n  # The dry-run branch consults the SAME predicate: its \"would COPY\" line is\n  # what the adopter decides on, and over a dangling link it was a lie.\n  if _dst_refuses \"$dst_rel\"; then\n    return\n  fi\n\n  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n    if [[ -e \"$dst\" ]]; then\n      echo \"    (dry-run) EXISTS (would skip template): $dst_rel\"\n    else\n      echo \"    (dry-run) would COPY template: $src_rel -> $dst_rel\"\n    fi\n    return\n  fi\n\n  if [[ -e \"$dst\" ]]; then\n    echo \"    EXISTS (skipping template): $dst_rel\"\n    return\n  fi\n\n  mkdir -p \"$( dirname \"$dst\" )\"\n  cp \"$src\" \"$dst\"\n  echo \"    COPIED template: $src_rel -> $dst_rel\"\n}\n\nhas_profile() {\n  local p=\"$1\"\n  for part in \"${PROFILE_PARTS[@]}\"; do\n    if [[ \"$part\" == \"$p\" ]]; then\n      return 0\n    fi\n  done\n  return 1\n}\n\n# ---- 1. Team rosters (always installed — these are templates with placeholders) ----\n\n_state_record_op \"install_team_rosters\" \".claude/team.md + .claude/frontend-team.md\"\ninstall_one \".claude/team.md\"\ninstall_one \".claude/frontend-team.md\"\n\n# ---- 2. Core skills (always installed if 'core' in profile) ----\n\nif has_profile \"core\"; then\n  echo \"\"\n  echo \"==> Installing core skills\"\n  _state_record_op \"install_skills\" \"core\"\n  install_one \".claude/skills/core\"\nfi\n\n# ---- 3. Frontend skills (installed if 'frontend' in profile) ----\n\nif has_profile \"frontend\"; then\n  echo \"\"\n  echo \"==> Installing frontend skills\"\n  _state_record_op \"install_skills\" \"frontend\"\n  install_one \".claude/skills/frontend\"\nfi\n\n# ---- 4. Domain skills (installed per domain name in profile) ----\n\nfor part in \"${PROFILE_PARTS[@]}\"; do\n  if [[ \"$part\" != \"core\" && \"$part\" != \"frontend\" ]]; then\n    DOMAIN_SRC=\"$SOURCE_DIR/.claude/skills/domains/$part\"\n    if [[ ! -d \"$DOMAIN_SRC\" ]]; then\n      echo \"\"\n      echo \"    WARNING: domain '$part' not found at $DOMAIN_SRC — skipping\"\n      continue\n    fi\n    echo \"\"\n    echo \"==> Installing domain: $part\"\n    _state_record_op \"install_skills\" \"domain:$part\"\n    install_one \".claude/skills/domains/$part\"\n  fi\ndone\n\n# ---- 5. Protocol enforcement (hooks, scripts, catalogs — always installed) ----\n#\n# NOTE (PLAN-003 Phase 0 I-4): hooks/ and scripts/ are installed\n# SELECTIVELY — only top-level files + hooks/_lib/ are shipped to\n# targets. Framework-internal directories excluded:\n#\n#   .claude/hooks/tests/      — 89 unit tests for the framework itself\n#   .claude/hooks/legacy/     — Sprint 1 bash fallbacks (removed in\n#                                Sprint 3 Item C once invariants met)\n#   .claude/scripts/tests/    — 74 unit tests for audit-query,\n#                                run-skill-benchmark, check-tier-boundaries\n#\n# Rationale: targets don't need our tests or fallbacks — they add ~100\n# files of bloat. Target installs should only carry the ACTIVE runtime\n# surface: _lib/, _python-hook.sh, active Python hooks, and active\n# scripts. New hooks added at the top level (e.g. check_bash_safety.py\n# in I-5a) are picked up automatically by the *.py/*.sh glob below.\n\n# PLAN-120-FOLLOWUP WS-D (E4-F1/E4-F2) — install _lib/ SELECTIVELY. A flat\n# `install_one .claude/hooks/_lib` does cp -R (or a whole-tree symlink),\n# which drags the framework's OWN test harness into the adopter runtime:\n# _lib/tests/ (emits real audit events with no session redirect — no\n# conftest ships) + test_isolation.py / testing.py (both `import pytest`\n# at module top). We iterate the top-level _lib entries and skip exactly\n# those three names; everything else (all runtime *.py + the runtime\n# subdirs adapters/ estimation/ federation/ mcp/ otel/ tier_policy/ +\n# __init__.py) ships. New runtime modules are picked up automatically by\n# the glob, matching the install_scripts_selective convention.\n# PLAN-161 U2 (codex r1 F7): prune nested __pycache__/ dirs + *.pyc files\n# under a freshly-copied destination directory. The exclusion predicate above\n# screens only TOP-LEVEL _lib entries; a permitted SUBDIRECTORY (e.g.\n# _lib/adapters) is cp -R'd wholesale, dragging nested __pycache__ dirs and\n# .pyc files the predicate declares globally excluded. Per-file delete +\n# rmdir only — NEVER rm -rf. Refuses to operate through a symlink root\n# (link-mode dst is a symlink into the SOURCE tree). Fail-open: every step\n# is guarded; never changes the install exit status.\n_prune_pycache_under() {\n  local _pp_root=\"$1\" _pp_d _pp_f\n  [[ -d \"$_pp_root\" && ! -L \"$_pp_root\" ]] || return 0\n  # 1) *.pyc files anywhere under the copied destination (find without -L:\n  #    symlinks are never followed).\n  while IFS= read -r _pp_f; do\n    [[ -n \"$_pp_f\" ]] || continue\n    rm -f \"$_pp_f\" 2>/dev/null || true\n  done < <( find \"$_pp_root\" -type f -name '*.pyc' -print 2>/dev/null )\n  # 2) __pycache__ dirs, deepest first (-depth): delete their files one by\n  #    one, then rmdir. A dir still holding anything unexpected simply stays.\n  while IFS= read -r _pp_d; do\n    [[ -n \"$_pp_d\" && -d \"$_pp_d\" && ! -L \"$_pp_d\" ]] || continue\n    while IFS= read -r _pp_f; do\n      [[ -n \"$_pp_f\" ]] || continue\n      rm -f \"$_pp_f\" 2>/dev/null || true\n    done < <( find \"$_pp_d\" \\( -type f -o -type l \\) -print 2>/dev/null )\n    rmdir \"$_pp_d\" 2>/dev/null || true\n  done < <( find \"$_pp_root\" -depth -type d -name '__pycache__' -print 2>/dev/null )\n  return 0\n}\n\ninstall_lib_selective() {\n  echo \"\"\n  echo \"==> Installing hooks/_lib (runtime only — tests/, test_isolation.py, testing.py excluded)\"\n  local e base preexisting\n  for e in \"$SOURCE_DIR/.claude/hooks/_lib/\"*; do\n    [[ -e \"$e\" ]] || continue\n    base=\"$( basename \"$e\" )\"\n    # PLAN-161 U2 (CF-7): route through the ONE canonical framework-internal\n    # exclusion predicate (scripts/_framework_manifest_set.sh) so install and\n    # upgrade can never drift apart again. Behavior identical to the previous\n    # literal case; the fallback case below only serves a partial checkout\n    # where the helper file was absent at source time (fail-open parity).\n    if command -v _framework_path_excluded >/dev/null 2>&1; then\n      if _framework_path_excluded \".claude/hooks/_lib/$base\"; then continue; fi\n    else\n      case \"$base\" in\n        tests|test_isolation.py|testing.py|__pycache__) continue ;;\n      esac\n    fi\n    preexisting=0\n    [[ -e \"$TARGET/.claude/hooks/_lib/$base\" || -L \"$TARGET/.claude/hooks/_lib/$base\" ]] && preexisting=1\n    install_one \".claude/hooks/_lib/$base\"\n    # PLAN-161 U2 (codex r1 F7): only a directory we JUST copied is pruned —\n    # a pre-existing (EXISTS-skipped) adopter dir is left untouched, link\n    # mode installs a symlink (the prune helper refuses symlink roots), and\n    # dry-run copies nothing.\n    if [[ \"$DRY_RUN\" -eq 0 && \"$MODE\" != \"link\" && \"$preexisting\" -eq 0 && -d \"$e\" && ! -L \"$e\" ]]; then\n      _prune_pycache_under \"$TARGET/.claude/hooks/_lib/$base\"\n    fi\n  done\n}\n\ninstall_hooks_selective() {\n  echo \"\"\n  echo \"==> Installing hooks (top-level + _lib/, tests/ + legacy/ excluded)\"\n  _state_record_op \"install_hooks\" \"selective (top-level + _lib)\"\n  install_lib_selective\n  local f base\n  for f in \"$SOURCE_DIR/.claude/hooks/\"*.sh \"$SOURCE_DIR/.claude/hooks/\"*.py; do\n    [[ -f \"$f\" ]] || continue\n    base=\"$( basename \"$f\" )\"\n    install_one \".claude/hooks/$base\"\n  done\n}\n\n# WS4-dispatcher-fn: E6-F5 fix — copy .claude/dispatcher/ (validate-governance.sh REQUIRES it)\ninstall_dispatcher() {\n  local src=\"$SOURCE_DIR/.claude/dispatcher\"\n  local dst=\"$TARGET/.claude/dispatcher\"\n  if [[ ! -d \"$src\" ]]; then\n    echo \"    SKIP: .claude/dispatcher/ absent in source\" >&2\n    return 0\n  fi\n  echo \"\"\n  echo \"==> Installing dispatcher (.claude/dispatcher/ — E6-F5 validate-governance gate)\"\n  _state_record_op \"install_dispatcher\" \".claude/dispatcher\"\n  local f\n  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n    for f in routing-