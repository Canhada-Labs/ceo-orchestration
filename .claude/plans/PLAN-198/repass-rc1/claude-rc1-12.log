{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WJdUN8YpWETPFPVAcVUm84","type":"tool_result","content":"1\t\"\"\"Shared detector constants.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport ast\n7\timport hashlib\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\timport time\n13\timport unicodedata\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom pathlib import Path\n17\tfrom typing import Any, Dict, FrozenSet, Iterable, List, Optional, Tuple\n18\t\n19\tSCHEMA_VERSION = \"reality-ledger-finding.v1\"\n20\t\n21\tDEFAULT_DETECTOR_TIMEOUT_MS = 120000  # PLAN-107 S145 raised 5000->15000ms; PLAN-112-FOLLOWUP S158 raised 15000->120000ms — the AST-walk of the further-grown hooks+scripts tree now takes ~50s isolated and ~60s under full-suite load (measured), exceeding the old 15s cap consistently. 120s gives ~2x CI-hardware margin. Advisory detector; the cap only bounds completion. Honest accommodation of codebase growth, not a logic change.\n22\tSUITE_LATENCY_BUDGET_S = 30.0  # informational p95 budget per spec\n23\t\n24\t# Severities (ordering matters for filtering)\n25\t_SEVERITIES = (\"low\", \"medium\", \"high\")\n26\t_SEVERITY_ORDER = {\"low\": 0, \"medium\": 1, \"high\": 2}\n27\t\n28\t# Detector registry — slug -> human label + default severity\n29\tDETECTOR_REGISTRY: Dict[str, Dict[str, Any]] = {\n30\t    \"runtime_read_missing\": {\"severity\": \"medium\"},\n31\t    \"installable_claim_drift\": {\"severity\": \"high\"},\n32\t    \"model_assignment_divergence\": {\"severity\": \"medium\"},\n33\t    \"enforcement_commit_unpopulated\": {\"severity\": \"low\"},\n34\t    \"audit_action_phantom\": {\"severity\": \"medium\"},\n35\t    # PLAN-078 Wave 2 — estimate-drift detector. Severity is computed\n36\t    # per-finding by drift factor (low <1.5×, medium 1.5-2×, high >2×);\n37\t    # registry value is the default fallback when severity is unset.\n38\t    \"estimate_drift\": {\"severity\": \"medium\"},\n39\t}\n40\t\n41\t# Anti-self-referential exclusion globs (post Round 1 R-SEC3).\n42\tSELF_EXCLUDE_BASENAMES = frozenset({\n43\t    \"task-route.py\",\n44\t    \"reality-ledger.py\",\n45\t})\n46\tSELF_EXCLUDE_PATH_FRAGMENTS = (\n47\t    \"owner-ceremony/archive/\",\n48\t    \"/owner-ceremony/archive/\",\n49\t    # PLAN-112-FOLLOWUP S158 — exclude plan `staging/` dirs from the scan.\n50\t    # They hold DRAFT mirrors of production code/docs (ready-to-apply\n51\t    # packages), NOT production claims, and the ~30 staging `.md` files\n52\t    # were inflating the `.md` detectors' scan (md_roots includes `.claude`)\n53\t    # past the detector timeout. Drafts must not be scanned as reality.\n54\t    \"/staging/\",\n55\t    \"/_reality_ledger_parts/\",\n56\t)\n57\t\n58\t# Audit emission allowlist (Sec MF-3 contract; extended in Phase 5 KERNEL).\n59\t_REALITY_LEDGER_FINDING_ALLOWLIST: FrozenSet[str] = frozenset({\n60\t    \"action\", \"ts\", \"detector\", \"severity\",\n61\t    # confidence_bps: int basis-points (0..1000); replaces old float \"confidence\"\n62\t    # which caused CanonicalJsonError in the HMAC-covered canonical_json encoder.\n63\t    \"confidence_bps\",\n64\t    \"claim_source_sha256\", \"finding_count_in_run\",\n65\t})\n66\t\n67\t# Markdown-only field set (MUST be excluded from JSON/JSONL).\n68\t_MARKDOWN_ONLY_FIELDS: FrozenSet[str] = frozenset({\"claim_source_path\"})\n69\t\n70\t# Env-var prefix convention enforced by detector #1: only names matching\n71\t# this prefix family are surfaced as documented env-vars. Avoids the\n72\t# combinatorial false-positive set of every UPPER_SNAKE backtick token in\n73\t# planning docs (`_KNOWN_ACTIONS`, `VETO_HARDCODE`, `STDOUT`, etc).\n74\t_ENV_PREFIX_RE = re.compile(\n75\t    r\"^(\"\n76\t    r\"CEO_|CLAUDE_|ANTHROPIC_|\"\n77\t    r\"GITHUB_|GH_|\"\n78\t    r\"OTEL_|OTEL_EXPORTER_|\"\n79\t    r\"NPM_|\"\n80\t    r\"AWS_|GCP_|GOOGLE_|\"\n81\t    r\"DATABASE_|DB_|\"\n82\t    r\"OPENAI_|\"\n83\t    r\"COVERALLS_|CODECOV_|\"\n84\t    r\"SENTRY_|\"\n85\t    r\"PYTHONPATH$|PATH$|HOME$\"\n86\t    r\")\"\n87\t)\n88\t\n89\t# Doc-side regex: env var names appearing as `$VAR`, `VAR=value`, or\n90\t# inside backticks. Min 5 chars (e.g. `CEO_X`) to prevent matching the\n91\t# bare prefix `CEO_` (4 chars). Convention floor `_ENV_PREFIX_RE`\n92\t# additionally requires at least 1 char after the prefix underscore.\n93\t# Body of the env-var name: starts upper, ≥4 chars, ends in a non-underscore.\n94\t# Prevents `ANTHROPIC_` (trailing underscore = a prefix mention, not a name).\n95\t_ENV_NAME_BODY = r\"[A-Z][A-Z0-9_]{2,62}[A-Z0-9]\"\n96\t_BACKTICK_ENV_RE = re.compile(r\"`(\" + _ENV_NAME_BODY + r\")`\")\n97\t_SHELL_ASSIGN_RE = re.compile(r\"\\b(\" + _ENV_NAME_BODY + r\")=[^\\s]\")\n98\t_DOLLAR_VAR_RE = re.compile(r\"\\$(\" + _ENV_NAME_BODY + r\")\\b\")\n99\t\n100\t# ADR Status field forms supported.\n101\t_ADR_STATUS_RE = re.compile(\n102\t    r\"^(?:>\\s*)?\\*{0,2}Status:?\\*{0,2}\\s*[:\\-]?\\s*(.+?)\\s*$\",\n103\t    re.MULTILINE,\n104\t)\n105\t# Many ADRs use \"**Status:** ACCEPTED ...\" or \"> **Status:** ...\"\n106\t_ADR_ENFORCEMENT_HEADER_RE = re.compile(\n107\t    r\"^##\\s+Enforcement\\s+commit\\s*$\",\n108\t    re.MULTILINE | re.IGNORECASE,\n109\t)\n110\t_ENFORCEMENT_SHA_RE = re.compile(r\"`([0-9a-f]{7,40})`\")\n111\t_ENFORCEMENT_PLACEHOLDER_RE = re.compile(\n112\t    r\"\\((?:populated\\s+on\\s+flip|pending|TBD|to\\s+be\\s+populated|_pending_)\",\n113\t    re.IGNORECASE,\n114\t)\n115\t\n116\t# Detector #6 — emit_<action> regex inside python source.\n117\t_EMIT_CALL_RE = re.compile(\n118\t    r\"\\bemit_generic\\s*\\(\\s*action\\s*=\\s*[\\\"']([a-z][a-z0-9_]*)[\\\"']\"\n119\t)\n120\t_EMIT_NAMED_RE = re.compile(\n121\t    r\"\\baudit_emit\\s*\\.\\s*emit_([a-z][a-z0-9_]*)\\s*\\(\"\n122\t)\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# File walking utilities (deterministic, exclusion-aware)\n127\t# 