{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q7Nth8bPaHcLd2GFrNCoBx","type":"tool_result","content":"1\t\"\"\"Skill-reference parsing, path validation and content integrity.\n2\t\n3\tBound to the public hook namespace by this package at import time.\n4\t\"\"\"\n5\tfrom __future__ import annotations\n6\t\n7\t__all__ = (\n8\t    '_is_enabled',\n9\t    '_has_valid_frontmatter_with_name',\n10\t    '_skill_ref_parse_sentinel',\n11\t    '_skill_ref_resolve_path',\n12\t    '_skill_ref_validate_unicode',\n13\t    '_skill_ref_read_bounded',\n14\t    '_skill_ref_validate_frontmatter',\n15\t    '_skill_ref_validate_hash_and_redact',\n16\t    '_validate_skill_reference',\n17\t    '_has_skill_reference',\n18\t)\n19\t\n20\t\n21\tdef _is_enabled(env_var: str, default: bool, env: Optional[dict] = None) -> bool:\n22\t    \"\"\"Live read of an env-var toggle with a module default fallback.\n23\t\n24\t    Allows runtime opt-out via env (`CEO_SKILL_REFERENCE_MODE=0`,\n25\t    `CEO_NATIVE_SUBAGENTS=0`) without restarting Claude Code.\n26\t    `CEO_SOTA_DISABLE=1` is the master kill — overrides everything.\n27\t    \"\"\"\n28\t    src_env = env if env is not None else os.environ\n29\t    if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n30\t        return False\n31\t    raw = (src_env.get(env_var) or \"\").strip()\n32\t    if raw == \"\":\n33\t        return default\n34\t    return raw not in (\"0\", \"false\", \"FALSE\", \"False\", \"no\", \"off\")\n35\t\n36\t\n37\t\n38\tdef _has_valid_frontmatter_with_name(text: str) -> bool:\n39\t    \"\"\"Stdlib-only frontmatter parser (no PyYAML).\n40\t"}]},"parent_tool_use_id":null,"session_id":"e7b3e450-1c4f-493e-92a7-7354e7f74aff","uuid":"783b82d5-2efb-49f5-88a8-c758c061a03c","timestamp":"2026-11-13T17:06:55.355Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/skill_reference.py","content":"\"\"\"Skill-reference parsing, path validation and content integrity.\n\nBound to the public hook namespace by this package at import time.\n\"\"\"\nfrom __future__ import annotations\n\n__all__ = (\n    '_is_enabled',\n    '_has_valid_frontmatter_with_name',\n    '_skill_ref_parse_sentinel',\n    '_skill_ref_resolve_path',\n    '_skill_ref_validate_unicode',\n    '_skill_ref_read_bounded',\n    '_skill_ref_validate_frontmatter',\n    '_skill_ref_validate_hash_and_redact',\n    '_validate_skill_reference',\n    '_has_skill_reference',\n)\n\n\ndef _is_enabled(env_var: str, default: bool, env: Optional[dict] = None) -> bool:\n    \"\"\"Live read of an env-var toggle with a module default fallback.\n\n    Allows runtime opt-out via env (`CEO_SKILL_REFERENCE_MODE=0`,\n    `CEO_NATIVE_SUBAGENTS=0`) without restarting Claude Code.\n    `CEO_SOTA_DISABLE=1` is the master kill — overrides everything.\n    \"\"\"\n    src_env = env if env is not None else os.environ\n    if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n        return False\n    raw = (src_env.get(env_var) or \"\").strip()\n    if raw == \"\":\n        return default\n    return raw not in (\"0\", \"false\", \"FALSE\", \"False\", \"no\", \"off\")\n\n\n\ndef _has_valid_frontmatter_with_name(text: str) -> bool:\n    \"\"\"Stdlib-only frontmatter parser (no PyYAML).\n","numLines":40,"startLine":1,"totalLines":320}},"tool_result_meta":[{"id":"toolu_01Q7Nth8bPaHcLd2GFrNCoBx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
