{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01465B613vJDQEa8isSPJG7b","type":"tool_result","content":"1\t\"\"\"Anchored model-family currency rules for PLAN-176.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport re\n5\tfrom typing import Iterable, Optional\n6\t\n7\t_RETIRED = frozenset({\"claude-opus-4-1\"})\n8\t_LEGACY_WORKING = frozenset({\"claude-fable-5\", \"claude-fable-5-1\"})\n9\t_LEGACY_FLOOR = frozenset({\"claude-fable-5\"})\n10\t_TAIL = r\"(?:[.-][0-9]+)*(?:-[a-z][a-z0-9]*)*\"\n11\t_ALLOWED = re.compile(\n12\t    r\"^(?:claude-(?:opus|sonnet|haiku)-[4-9]\" + _TAIL\n13\t    + r\"|gpt-[5-9]\" + _TAIL + r\"|o[3-9]\" + _TAIL\n14\t    + r\"|gemini-[2-9]\" + _TAIL + r\"|grok-[3-9]\" + _TAIL + r\")$\"\n15\t)\n16\t_FLOOR = re.compile(r\"^(?:claude-opus-[4-9]\" + _TAIL + r\"|gpt-[5-9]\" + _TAIL + r\"|o[3-9]\" + _TAIL + r\")$\")\n17\t_PREFIXES = tuple(\n18\t    [\"claude-%s-%d\" % (family, major) for family in (\"opus\", \"sonnet\", \"haiku\") for major in range(4, 10)]\n19\t    + [\"gpt-%d\" % major for major in range(5, 10)]\n20\t    + [\"o%d\" % major for major in range(3, 10)]\n21\t    + [\"gemini-%d\" % major for major in range(2, 10)]\n22\t    + [\"grok-%d\" % major for major in range(3, 10)]\n23\t)\n24\t\n25\t\n26\tdef _explicit(name: str, models: Optional[Iterable[str]]) -> bool:\n27\t    return models is not None and name in frozenset(models)\n28\t\n29\t\n30\tdef availability_entries(explicit_models: Iterable[str]) -> list:\n31\t    \"\"\"Stable explicit IDs followed by native major-version availability prefixes.\"\"\"\n32\t    out = []\n33\t    for model in list(explicit_models) + list(_PREFIXES):\n34\t        if model not in out:\n35\t            out.append(model)\n36\t    return out\n37\t\n38\t\n39\tdef is_allowed_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:\n40\t    \"\"\"Accept approved semantic families or an explicit legacy working ID.\"\"\"\n41\t    return isinstance(name, str) and name not in _RETIRED and (\n42\t        bool(_ALLOWED.fullmatch(name)) or _explicit(name, explicit_models)\n43\t        or (explicit_models is None and name in _LEGACY_WORKING)\n44\t    )\n45\t\n46\t\n47\tdef is_veto_floor_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:\n48\t    \"\"\"Accept VETO-capable families or an explicit legacy floor ID.\"\"\"\n49\t    return isinstance(name, str) and name not in _RETIRED and (\n50\t        bool(_FLOOR.fullmatch(name)) or _explicit(name, explicit_models)\n51\t        or (explicit_models is None and name in _LEGACY_FLOOR)\n52\t    )\n53\t\n54\t\n55\tdef main(argv: Optional[list] = None) -> int:\n56\t    \"\"\"Exit 0 for an admitted model, 1 for rejection, 2 for invalid usage.\"\"\"\n57\t    import sys\n58\t\n59\t    args = list(sys.argv[1:] if argv is None else argv)\n60\t    veto = args[:1] == [\"--veto\"]\n61\t    if veto:\n62\t        args = args[1:]\n63\t    if len(args) != 1:\n64\t        return 2\n65\t    predicate = is_veto_floor_model if veto else is_allowed_model\n66\t    return 0 if predicate(args[0]) else 1\n67\t\n68\t\n69\tif __name__ == \"__main__\":\n70\t    raise SystemExit(main())\n71\t"}]},"parent_tool_use_id":null,"session_id":"e7b3e450-1c4f-493e-92a7-7354e7f74aff","uuid":"e13425f8-7aa6-46ff-aa9e-e92cf54bfcac","timestamp":"2026-11-13T17:03:50.784Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/model_currency.py","content":"\"\"\"Anchored model-family currency rules for PLAN-176.\"\"\"\nfrom __future__ import annotations\n\nimport re\nfrom typing import Iterable, Optional\n\n_RETIRED = frozenset({\"claude-opus-4-1\"})\n_LEGACY_WORKING = frozenset({\"claude-fable-5\", \"claude-fable-5-1\"})\n_LEGACY_FLOOR = frozenset({\"claude-fable-5\"})\n_TAIL = r\"(?:[.-][0-9]+)*(?:-[a-z][a-z0-9]*)*\"\n_ALLOWED = re.compile(\n    r\"^(?:claude-(?:opus|sonnet|haiku)-[4-9]\" + _TAIL\n    + r\"|gpt-[5-9]\" + _TAIL + r\"|o[3-9]\" + _TAIL\n    + r\"|gemini-[2-9]\" + _TAIL + r\"|grok-[3-9]\" + _TAIL + r\")$\"\n)\n_FLOOR = re.compile(r\"^(?:claude-opus-[4-9]\" + _TAIL + r\"|gpt-[5-9]\" + _TAIL + r\"|o[3-9]\" + _TAIL + r\")$\")\n_PREFIXES = tuple(\n    [\"claude-%s-%d\" % (family, major) for family in (\"opus\", \"sonnet\", \"haiku\") for major in range(4, 10)]\n    + [\"gpt-%d\" % major for major in range(5, 10)]\n    + [\"o%d\" % major for major in range(3, 10)]\n    + [\"gemini-%d\" % major for major in range(2, 10)]\n    + [\"grok-%d\" % major for major in range(3, 10)]\n)\n\n\ndef _explicit(name: str, models: Optional[Iterable[str]]) -> bool:\n    return models is not None and name in frozenset(models)\n\n\ndef availability_entries(explicit_models: Iterable[str]) -> list:\n    \"\"\"Stable explicit IDs followed by native major-version availability prefixes.\"\"\"\n    out = []\n    for model in list(explicit_models) + list(_PREFIXES):\n        if model not in out:\n            out.append(model)\n    return out\n\n\ndef is_allowed_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:\n    \"\"\"Accept approved semantic families or an explicit legacy working ID.\"\"\"\n    return isinstance(name, str) and name not in _RETIRED and (\n        bool(_ALLOWED.fullmatch(name)) or _explicit(name, explicit_models)\n        or (explicit_models is None and name in _LEGACY_WORKING)\n    )\n\n\ndef is_veto_floor_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:\n    \"\"\"Accept VETO-capable families or an explicit legacy floor ID.\"\"\"\n    return isinstance(name, str) and name not in _RETIRED and (\n        bool(_FLOOR.fullmatch(name)) or _explicit(name, explicit_models)\n        or (explicit_models is None and name in _LEGACY_FLOOR)\n    )\n\n\ndef main(argv: Optional[list] = None) -> int:\n    \"\"\"Exit 0 for an admitted model, 1 for rejection, 2 for invalid usage.\"\"\"\n    import sys\n\n    args = list(sys.argv[1:] if argv is None else argv)\n    veto = args[:1] == [\"--veto\"]\n    if veto:\n        args = args[1:]\n    if len(args) != 1:\n        return 2\n    predicate = is_veto_floor_model if veto else is_allowed_model\n    return 0 if predicate(args[0]) else 1\n\n\nif __name__ == \"__main__\":\n    raise SystemExit(main())\n","numLines":71,"startLine":1,"totalLines":71}},"tool_result_meta":[{"id":"toolu_01465B613vJDQEa8isSPJG7b","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
