{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1MJVNvwEQN9XmpeYcUQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013EeU26cVTVCjedafq8Xd7G","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_log_parts/rotation_storage.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10036,"cache_read_input_tokens":111962,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10036},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"c7fc138b-9921-410e-bfea-817459d90452","timestamp":"2026-11-13T17:50:40.186Z","request_id":"req_011Ch1MJVA2bcRD1KkpQQJjC","wire_tool_inputs":{"toolu_013EeU26cVTVCjedafq8Xd7G":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_log_parts/rotation_storage.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013EeU26cVTVCjedafq8Xd7G","type":"tool_result","content":"1\t\"\"\"Rotation, safe storage, and append declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef rotate_if_needed(log_path: Path, threshold_bytes: int) -> Optional[Path]:\n5\t    \"\"\"Rename log_path to a monthly rotated file if it exceeds the threshold.\n6\t\n7\t    Must be called UNDER the lock so no concurrent writer can race.\n8\t\n9\t    PLAN-045 Wave 2 P0-08: delegates to ``_lib.audit_rotation.rotate_if_needed``\n10\t    so both write paths (this ``append_entry`` + ``_lib.audit_emit._write_event``)\n11\t    share identical rotation semantics. Preserves the existing call\n12\t    signature for backwards compatibility.\n13\t\n14\t    PLAN-044 audit-v2 C6-P0-02 fix (Wave B): on successful rotation,\n15\t    invoke ``audit_hmac.reset_chain_on_rotation()`` so the HMAC chain\n16\t    starts a fresh genesis on the new log file. Without this, rotated\n17\t    logs continue chain from the previous final hmac into the new\n18\t    file's genesis row, which `audit-verify-chain.py` cannot validate\n19\t    (genesis is by definition prev_hmac=GENESIS_PREV; a non-genesis\n20\t    prev_hmac after rotation looks like silent tamper). Pattern was\n21\t    already correct in ``_lib.audit_emit._write_event`` — Wave B brings\n22\t    ``audit_log.py`` to parity.\n23\t\n24\t    Returns the rotated path if rotation happened, None otherwise.\n25\t    \"\"\"\n26\t    try:\n27\t        from _lib.audit_rotation import rotate_if_needed as _shared_rotate\n28\t    except ImportError:\n29\t        # Defensive: if the shared primitive isn't available (partial\n30\t        # install), fall back to the inlined legacy implementation so\n31\t        # rotation still works in the classic path.\n32\t        rotated = _legacy_rotate_inline(log_path, threshold_bytes)\n33\t    else:\n34\t        rotated = _shared_rotate(log_path, threshold_bytes, now_month_slug())\n35\t\n36\t    # PLAN-044 audit-v2 C6-P0-02 — reset the per-process HMAC chain\n37\t    # state so the next entry written to the fresh log file is a\n38\t    # GENESIS_PREV-rooted row. Best-effort: missing _lib.audit_hmac\n39\t    # is non-fatal (older installs); chain integrity tests will catch\n40\t    # any rotated row that violates the genesis rule.\n41\t    if rotated is not None:\n42\t        try:\n43\t            from _lib import audit_hmac as _audit_hmac\n44\t            if hasattr(_audit_hmac, \"reset_chain_on_rotation\"):\n45\t                _audit_hmac.reset_chain_on_rotation()\n46\t        except Exception:\n47\t            pass\n48\t    return rotated\n49\t\n50\t\n51\tdef _legacy_rotate_inline(\n52\t    log_path: Path, threshold_bytes: int\n53\t) -> Optional[Path]:\n54\t    \"\"\"Fallback rotation for the rare case ``_lib.audit_rotation`` is missing.\n55\t\n56\t    Kept in-line so a half-installed framework still rotates. Mirrors\n57\t    the behavior of the shared primitive byte-for-byte.\n58\t    \"\"\"\n59\t    try:\n60\t        if not log_path.is_file():\n61\t            return None\n62\t        size = log_path.stat().st_size\n63\t        if size <= threshold_bytes:\n64\t            return None\n65\t    except OSError:\n66\t        return None\n67\t\n68\t    month = now_month_slug()\n69\t    base = log_path.parent / f\"{log_path.stem}-{month}.jsonl\"\n70\t    candidate = base\n71\t    counter = 1\n72\t    while candidate.exists():\n73\t        candidate = log_path.parent / f\"{log_path.stem}-{month}-{counter}.jsonl\"\n74\t        counter += 1\n75\t        if counter > 1000:\n76\t            return None\n77\t\n78\t    try:\n79\t        os.replace(str(log_path), str(candidate))\n80\t    except OSError:\n81\t        return None\n82\t    return candidate\n83\t\n84\t\n85\t# -----------------------------------------------------------------------------\n86\t# Error breadcrumb\n87\t# -----------------------------------------------------------------------------\n88\t\n89\t\n90\tdef write_breadcrumb(err_path: Path, message: str) -> None:\n91\t    \"\"\"Best-effort write to the errors log. Never raises.\"\"\"\n92\t    try:\n93\t        err_path.parent.mkdir(parents=True, exist_ok=True)\n94\t        ts = now_iso_utc()\n95\t        with open(err_path, \"a\", encoding=\"utf-8\") as f:\n96\t            f.write(f\"[{ts}] {message}\\n\")\n97\t    except OSError:\n98\t        # Last-resort: stderr\n99\t        try:\n100\t            sys.stderr.write(f\"[audit-log] breadcrumb write failed: {message}\\n\")\n101\t        except Exception:  # pragma: no cover\n102\t            pass\n103\t\n104\t\n105\t# -----------------------------------------------------------------------------\n106\t# PLAN-045 F-01-06 — symlink + ownership defense\n107\t# -----------------------------------------------------------------------------\n108\t\n109\t\n110\tdef _is_safe_audit_path(\n111\t    path: Path, expected_uid: int\n112\t) -> Tuple[bool, str]:\n113\t    \"\"\"Check audit path for symlink + ownership safety.\n114\t\n115\t    Returns ``(True, \"\")`` if safe (nonexistent OR real file/dir owned\n116\t    by ``expected_uid``). Returns ``(False, reason)`` if unsafe\n117\t    (symlink OR owner mismatch).\n118\t\n119\t    Uses ``os.lstat`` (not ``stat``) so symlinks themselves are\n120\t    inspected rather than their targets. Never raises.\n121\t\n122\t    ## Threat model\n123\t\n124\t    1. **Symlink redirection.** An attacker with write access to\n125\t       ``$HOME/.claude/projects/`` creates\n126\t       ``ceo-orchestration -> /tmp/evil``. Every append goes to\n127\t       attacker-controlled path, defeats tamper-evident audit trail.\n128\t    2. **UID squatting.** Another user's process creates the audit\n129\t       directory. Hook runs as current user → fails to open for\n130\t       append (EACCES) OR leaks sensitive data into foreign-owned\n131\t       file if perms are too permissive.\n132\t\n133\t    Both are refused before any write. The caller logs a breadcrumb\n134\t    to the /tmp fallback path and returns silently (fail-open on\n135\t    session; forensic trail preserved).\n136\t    \"\"\"\n137\t    try:\n138\t        st = path.lstat()\n139\t    except FileNotFoundError:\n140\t        # Nonexistent is safe — the normal first-write path.\n141\t        return (True, \"\")\n142\t    except OSError as e:\n143\t        return (False, f\"lstat_error:{e.__class__.__name__}\")\n144\t    if stat.S_ISLNK(st.st_mode):\n145\t        return (False, \"symlink_rejected\")\n146\t    if st.st_uid != expected_uid:\n147\t        return (\n148\t            False,\n149\t            f\"uid_mismatch:owner={st.st_uid} proc={expected_uid}\",\n150\t        )\n151\t    return (True, \"\")\n152\t\n153\t\n154\tdef _fallback_security_breadcrumb(message: str) -> None:\n155\t    \"\"\"Breadcrumb to ``/tmp`` fallback when primary audit dir is unsafe.\n156\t\n157\t    Mirrors ``_lib.audit_emit._fallback_log_path`` pattern. Never\n158\t    raises. Writes under the current user's namespaced filename so\n159\t    multi-user systems don't clobber each other.\n160\t    \"\"\"\n161\t    try:\n162\t        try:\n163\t            user = getpass.getuser() or \"unknown\"\n164\t        except Exception:\n165\t            user = os.environ.get(\"USER\") or \"unknown\"\n166\t        user = \"\".join(\n167\t            c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\")\n168\t        )\n169\t        fallback = Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n170\t        ts = now_iso_utc()\n171\t        with open(fallback, \"a\", encoding=\"utf-8\") as f:\n172\t            f.write(f\"[{ts}] audit-log security: {message}\\n\")\n173\t    except Exception:\n174\t        pass\n175\t\n176\t\n177\t# -----------------------------------------------------------------------------\n178\t# Append entry under lock\n179\t# -----------------------------------------------------------------------------\n180\t\n181\t\n182\tdef append_entry(\n183\t    entry: Dict[str, Any],\n184\t    *,\n185\t    paths: Dict[str, Path],\n186\t    threshold_bytes: int,\n187\t) -> None:\n188\t    \"\"\"Append a single JSONL line under the lock, rotating if needed.\n189\t\n190\t    Any failure is logged to the errors breadcrumb and swallowed (fail-open).\n191\t\n192\t    PLAN-045 F-01-06: pre-write symlink + ownership check on audit dir\n193\t    and audit log file. On violation, breadcrumb to /tmp fallback +\n194\t    return silently (fail-open on session; entry dropped but forensic\n195\t    trail preserved via fallback + upstream audit_emit).\n196\t    \"\"\"\n197\t    # F-01-06 symlink + uid defense BEFORE any mkdir/write.\n198\t    # Rationale: an attacker who plants a symlink in the audit dir can\n199\t    # redirect writes. Ownership mismatch indicates another user's\n200\t    # process created the path. Both warrant refusal + breadcrumb.\n201\t    expected_uid = os.geteuid()\n202\t    ok, reason = _is_safe_audit_path(paths[\"dir\"], expected_uid)\n203\t    if not ok:\n204\t        _fallback_security_breadcrumb(\n205\t            f\"audit dir unsafe: {paths['dir']} ({reason})\"\n206\t        )\n207\t        return\n208\t    ok, reason = _is_safe_audit_path(paths[\"log\"], expected_uid)\n209\t    if not ok:\n210\t        _fallback_security_breadcrumb(\n211\t            f\"audit log unsafe: {paths['log']} ({reason})\"\n212\t        )\n213\t        return\n214\t    # Ensure dir exists with restrictive perms\n215\t    # PLAN-024 F-sec-001 P1 fix: mkdir(mode=0o700) closes TOCTOU micro-window\n216\t    # between mkdir() and os.chmod() where same-UID attacker could win a race.\n217\t    try:\n218\t        paths[\"dir\"].mkdir(parents=True, exist_ok=True, mode=0o700)\n219\t        # Belt-and-braces: retighten in case dir pre-existed with looser perms\n220\t        try:\n221\t            os.chmod(paths[\"dir\"], 0o700)\n222\t        except OSError:\n223\t            pass\n224\t    except OSError as e:\n225\t        write_breadcrumb(paths[\"err\"], f\"cannot create audit dir: {e}\")\n226\t        return\n227\t\n228\t    # PLAN-085 Wave B.3 — inline HMAC computation closes the two-writer\n229\t    # chain gap (F-C1-001 / T0-line-168 transition_violation root cause).\n230\t    # 100% of agent_spawn events now carry hmac field per ADR-055.\n231\t    # Reuses _lib/audit_hmac primitives; fail-OPEN per CLAUDE.md §5.\n232\t    # PLAN-194 (rc.1 condition 67): key, predecessor, HMAC, append and sidecar\n233\t    # share ONE FileLock (as in audit_emit/drain); read before it, a writer in\n234\t    # between forked the chain. Only the stateless import stays outside.\n235\t    entry.setdefault(\"hmac\", None)\n236\t    entry.setdefault(\"hmac_error\", None)\n237\t    _audit_hmac = None\n238\t    try:\n239\t        from _lib import audit_hmac as _audit_hmac\n240\t    except Exception as _b3_ie:\n241\t        entry[\"hmac\"] = None\n242\t        entry[\"hmac_error\"] = type(_b3_ie).__name__\n243\t\n244\t    line = \"\"\n245\t\n246\t    try:\n247\t        with FileLock(paths[\"lock\"], timeout=2.5):\n248\t            # Rotate inside the lock so writers can't race past a rename\n249\t            rotated_to = rotate_if_needed(paths[\"log\"], threshold_bytes)\n250\t            # ADR-055-AMEND-2 marker as line 1 BEFORE our HMAC reads the predecessor;\n251\t            # no marker on disk => never sign over a last-hmac that may name it.\n252\t            marker_ok = rotated_to is None or _emit_rotation_marker_under_lock(\n253\t                paths[\"log\"], rotated_to, paths[\"err\"])\n254\t            _b3_hmac_digest_bytes = None\n255\t            if _audit_hmac is not None and not marker_ok:\n256\t                entry[\"hmac\"] = None\n257\t                entry[\"hmac_error\"] = \"chain_reset_marker_missing\"\n258\t            elif _audit_hmac is not None:\n259\t                try:\n260\t                    if not _audit_hmac.is_disabled():\n261\t                        _b3_key = _audit_hmac.get_or_create_key()\n262\t                        _b3_prev = _audit_hmac.read_prev_hmac()  # WITH the lock held\n263\t                        _b3_hmac_digest_bytes = _audit_hmac.compute_entry_hmac(\n264\t                            _b3_key, _b3_prev,\n265\t                            {k: v for k, v in entry.items()\n266\t                             if k not in (\"hmac\", \"hmac_error\")},\n267\t                        )\n268\t                        entry[\"hmac\"] = _audit_hmac.hex_digest(_b3_hmac_digest_bytes)\n269\t                except Exception as _b3_he:\n270\t                    _b3_hmac_digest_bytes = None\n271\t                    entry[\"hmac\"] = None\n272\t                    entry[\"hmac_error\"] = type(_b3_he).__name__\n273\t            # Serialize AFTER the hmac field is final (still under the lock).\n274\t            line = json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n275\t            try:\n276\t                # PLAN-024 F-sec-002 P1 fix: os.open with mode=0o600 sets perms\n277\t                # at create-time, closing the default-umask window between\n278\t                # open() and os.chmod().\n279\t                fd = os.open(\n280\t                    paths[\"log\"],\n281\t                    os.O_WRONLY | os.O_CREAT | os.O_APPEND,\n282\t                    0o600,\n283\t                )\n284\t                with os.fdopen(fd, \"a\", encoding=\"utf-8\") as f:\n285\t                    f.write(line + \"\\n\")\n286\t                    # PLAN-025 F-obs-002: flush + fsync so the append survives\n287\t                    # process/OS crash. Audit is source-of-truth for governance;\n288\t                    # silent loss after write() but before OS flush = forensic gap.\n289\t                    # Cost: one syscall per spawn (~200us). Tolerable vs the\n290\t                    # governance invariant \"every spawn is recorded\".\n291\t                    f.flush()\n292\t                    try:\n293\t                        os.fsync(f.fileno())\n294\t                    except (OSError, AttributeError):\n295\t                        # AttributeError on platforms without fsync; OSError on\n296\t                        # read-only fds or closed streams. Both acceptable — the\n297\t                        # write already succeeded; fsync is best-effort durability.\n298\t                        pass\n299\t                # Belt-and-braces: retighten in case file pre-existed looser\n300\t                try:\n301\t                    os.chmod(paths[\"log\"], 0o600)\n302\t                except OSError:\n303\t                    pass\n304\t                # PLAN-085 Wave B.3 — update last-hmac sidecar within lock\n305\t                # so the next writer reads the correct prev_hmac. Best-effort.\n306\t                if _b3_hmac_digest_bytes is not None and _audit_hmac is not None:\n307\t                    try:\n308\t                        _audit_hmac.write_last_hmac(_b3_hmac_digest_bytes)\n309\t                    except Exception:\n310\t                        pass\n311\t            except OSError as e:\n312\t                write_breadcrumb(paths[\"err\"], f\"append failed: {e}  line={line[:200]}\")\n313\t    except FileLockTimeout:\n314\t        # Fail-open: entry dropped (never chained), session never blocked;\n315\t        # the HMAC only exists under the lock, so the breadcrumb lacks it.\n316\t        line = line or json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n317\t        write_breadcrumb(\n318\t            paths[\"err\"],\n319\t            f\"lock timeout (stale?)  would-log={line[:200]}\",\n320\t        )\n321\t    except Exception as e:  # pragma: no cover\n322\t        write_breadcrumb(paths[\"err\"], f\"unexpected error: {e}\")\n323\t\n324\t\n325\tdef _emit_rotation_marker_under_lock(\n326\t    log_path: Path, rotated_to: Path, err_path: Path\n327\t) -> bool:\n328\t    \"\"\"ADR-055-AMEND-2 marker (emitter/drain helper) after OUR rotation, lock held. True =\n329\t    marker on disk or chain off; False = no marker on disk (when its append failed, last-hmac\n330\t    already names it), so the caller signs nothing over it.\"\"\"\n331\t    try:\n332\t        from _lib import audit_hmac as _ah\n333\t        if _ah.is_disabled():\n334\t            return True\n335\t        from _lib import audit_emit as _ae\n336\t        if _ae._emit_chain_reset_marker_under_lock(\n337\t                log=log_path, previous_archive_path=str(rotated_to),\n338\t                rotation_trigger=\"size_threshold\") is not None:\n339\t            return True\n340\t        why = \"helper returned None\"\n341\t    except Exception as e:\n342\t        why = f\"{type(e).__name__}: {e}\"\n343\t    write_breadcrumb(err_path, f\"chain_reset_marker not written ({why}); \"\n344\t                     \"this agent_spawn line is left unchained\")\n345\t    return False\n346\t\n347\t\n348\t# -----------------------------------------------------------------------------\n349\t# PLAN-155 Wave 4 — Codex host-wire audit-chain path (SENT-CX-B / ADR-161)\n350\t# -----------------------------------------------------------------------------\n351\t#\n352\t# Under OpenAI Codex (CEO_HOOK_ADAPTER=codex) the same audit_log.py hook is\n353\t# registered on the PostToolUse `*` matcher (templates/codex/hooks.json) and,\n354\t# via the headless `scripts/codex-exec-wrapper.sh`, is fed synthesized\n355\t# SessionStart/Stop bracket envelopes. The codex path reads the codex host\n356\t# wire through the codex adapter and appends metadata-only records to the SAME\n357\t# HMAC chain via `_lib.audit_emit` (the single-writer emitter that verify_chain\n358\t# validates). Two NEW registered actions keep the per-tool append and the\n359\t# turn-level backstop COUNTABLE separately (PLAN-155 Wave 4-A / Wave 4-B):\n360\t#\n361\t#   PostToolUse (any tool)  -> emit_codex_tool_recorded   (per-tool append, A)\n362\t#   Stop / SubagentStop     -> emit_codex_turn_ended      (turn backstop, B)\n363\t#   SessionStart            -> emit_session_start          (boot bracket; only\n364\t#                              reached via the wrapper — production codex\n365\t#                              routes SessionStart to SessionStart.py, so there\n366\t#                              is no double-count)\n367\t#\n368\t# The claude (default) path below is UNCHANGED and byte-identical when\n369\t# CEO_HOOK_ADAPTER is unset/`claude`. Completeness residual (named, ADR-161 +\n370\t# degradation page): partial shell interception means a per-tool row may be\n371\t# absent — absence is not evidence of absence of activity. verify_chain() and\n372\t# the HMAC chain shape are untouched; this path only appends.\n373\t\n374\t# Closed tool-name enum mirror of _lib.audit_emit._CODEX_TOOL_RECORDED_TOOL_NAME_ENUM.\n375\t# The codex adapter has already aliased apply_patch -> Write/Edit and\n376\t# spawn_agent -> Task before we see the event; here we only fold mcp__* down to\n377\t# `mcp_other` (MF-SEC-1) and leave the emitter to coerce any residual miss to\n378\t# `other`.\n379\t"}]},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"d5f9c3cd-7407-400e-8dfe-ef1a114b3839","timestamp":"2026-11-13T17:50:40.202Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_log_parts/rotation_storage.py","content":"\"\"\"Rotation, safe storage, and append declarations.\"\"\"\nfrom __future__ import annotations\n\ndef rotate_if_needed(log_path: Path, threshold_bytes: int) -> Optional[Path]:\n    \"\"\"Rename log_path to a monthly rotated file if it exceeds the threshold.\n\n    Must be called UNDER the lock so no concurrent writer can race.\n\n    PLAN-045 Wave 2 P0-08: delegates to ``_lib.audit_rotation.rotate_if_needed``\n    so both write paths (this ``append_entry`` + ``_lib.audit_emit._write_event``)\n    share identical rotation semantics. Preserves the existing call\n    signature for backwards compatibility.\n\n    PLAN-044 audit-v2 C6-P0-02 fix (Wave B): on successful rotation,\n    invoke ``audit_hmac.reset_chain_on_rotation()`` so the HMAC chain\n    starts a fresh genesis on the new log file. Without this, rotated\n    logs continue chain from the previous final hmac into the new\n    file's genesis row, which `audit-verify-chain.py` cannot validate\n    (genesis is by definition prev_hmac=GENESIS_PREV; a non-genesis\n    prev_hmac after rotation looks like silent tamper). Pattern was\n    already correct in ``_lib.audit_emit._write_event`` — Wave B brings\n    ``audit_log.py`` to parity.\n\n    Returns the rotated path if rotation happened, None otherwise.\n    \"\"\"\n    try:\n        from _lib.audit_rotation import rotate_if_needed as _shared_rotate\n    except ImportError:\n        # Defensive: if the shared primitive isn't available (partial\n        # install), fall back to the inlined legacy implementation so\n        # rotation still works in the classic path.\n        rotated = _legacy_rotate_inline(log_path, threshold_bytes)\n    else:\n        rotated = _shared_rotate(log_path, threshold_bytes, now_month_slug())\n\n    # PLAN-044 audit-v2 C6-P0-02 — reset the per-process HMAC chain\n    # state so the next entry written to the fresh log file is a\n    # GENESIS_PREV-rooted row. Best-effort: missing _lib.audit_hmac\n    # is non-fatal (older installs); chain integrity tests will catch\n    # any rotated row that violates the genesis rule.\n    if rotated is not None:\n        try:\n            from _lib import audit_hmac as _audit_hmac\n            if hasattr(_audit_hmac, \"reset_chain_on_rotation\"):\n                _audit_hmac.reset_chain_on_rotation()\n        except Exception:\n            pass\n    return rotated\n\n\ndef _legacy_rotate_inline(\n    log_path: Path, threshold_bytes: int\n) -> Optional[Path]:\n    \"\"\"Fallback rotation for the rare case ``_lib.audit_rotation`` is missing.\n\n    Kept in-line so a half-installed framework still rotates. Mirrors\n    the behavior of the shared primitive byte-for-byte.\n    \"\"\"\n    try:\n        if not log_path.is_file():\n            return None\n        size = log_path.stat().st_size\n        if size <= threshold_bytes:\n            return None\n    except OSError:\n        return None\n\n    month = now_month_slug()\n    base = log_path.parent / f\"{log_path.stem}-{month}.jsonl\"\n    candidate = base\n    counter = 1\n    while candidate.exists():\n        candidate = log_path.parent / f\"{log_path.stem}-{month}-{counter}.jsonl\"\n        counter += 1\n        if counter > 1000:\n            return None\n\n    try:\n        os.replace(str(log_path), str(candidate))\n    except OSError:\n        return None\n    return candidate\n\n\n# -----------------------------------------------------------------------------\n# Error breadcrumb\n# -----------------------------------------------------------------------------\n\n\ndef write_breadcrumb(err_path: Path, message: str) -> None:\n    \"\"\"Best-effort write to the errors log. Never raises.\"\"\"\n    try:\n        err_path.parent.mkdir(parents=True, exist_ok=True)\n        ts = now_iso_utc()\n        with open(err_path, \"a\", encoding=\"utf-8\") as f:\n            f.write(f\"[{ts}] {message}\\n\")\n    except OSError:\n        # Last-resort: stderr\n        try:\n            sys.stderr.write(f\"[audit-log] breadcrumb write failed: {message}\\n\")\n        except Exception:  # pragma: no cover\n            pass\n\n\n# -----------------------------------------------------------------------------\n# PLAN-045 F-01-06 — symlink + ownership defense\n# -----------------------------------------------------------------------------\n\n\ndef _is_safe_audit_path(\n    path: Path, expected_uid: int\n) -> Tuple[bool, str]:\n    \"\"\"Check audit path for symlink + ownership safety.\n\n    Returns ``(True, \"\")`` if safe (nonexistent OR real file/dir owned\n    by ``expected_uid``). Returns ``(False, reason)`` if unsafe\n    (symlink OR owner mismatch).\n\n    Uses ``os.lstat`` (not ``stat``) so symlinks themselves are\n    inspected rather than their targets. Never raises.\n\n    ## Threat model\n\n    1. **Symlink redirection.** An attacker with write access to\n       ``$HOME/.claude/projects/`` creates\n       ``ceo-orchestration -> /tmp/evil``. Every append goes to\n       attacker-controlled path, defeats tamper-evident audit trail.\n    2. **UID squatting.** Another user's process creates the audit\n       directory. Hook runs as current user → fails to open for\n       append (EACCES) OR leaks sensitive data into foreign-owned\n       file if perms are too permissive.\n\n    Both are refused before any write. The caller logs a breadcrumb\n    to the /tmp fallback path and returns silently (fail-open on\n    session; forensic trail preserved).\n    \"\"\"\n    try:\n        st = path.lstat()\n    except FileNotFoundError:\n        # Nonexistent is safe — the normal first-write path.\n        return (True, \"\")\n    except OSError as e:\n        return (False, f\"lstat_error:{e.__class__.__name__}\")\n    if stat.S_ISLNK(st.st_mode):\n        return (False, \"symlink_rejected\")\n    if st.st_uid != expected_uid:\n        return (\n            False,\n            f\"uid_mismatch:owner={st.st_uid} proc={expected_uid}\",\n        )\n    return (True, \"\")\n\n\ndef _fallback_security_breadcrumb(message: str) -> None:\n    \"\"\"Breadcrumb to ``/tmp`` fallback when primary audit dir is unsafe.\n\n    Mirrors ``_lib.audit_emit._fallback_log_path`` pattern. Never\n    raises. Writes under the current user's namespaced filename so\n    multi-user systems don't clobber each other.\n    \"\"\"\n    try:\n        try:\n            user = getpass.getuser() or \"unknown\"\n        except Exception:\n            user = os.environ.get(\"USER\") or \"unknown\"\n        user = \"\".join(\n            c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\")\n        )\n        fallback = Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n        ts = now_iso_utc()\n        with open(fallback, \"a\", encoding=\"utf-8\") as f:\n            f.write(f\"[{ts}] audit-log security: {message}\\n\")\n    except Exception:\n        pass\n\n\n# -----------------------------------------------------------------------------\n# Append entry under lock\n# -----------------------------------------------------------------------------\n\n\ndef append_entry(\n    entry: Dict[str, Any],\n    *,\n    paths: Dict[str, Path],\n    threshold_bytes: int,\n) -> None:\n    \"\"\"Append a single JSONL line under the lock, rotating if needed.\n\n    Any failure is logged to the errors breadcrumb and swallowed (fail-open).\n\n    PLAN-045 F-01-06: pre-write symlink + ownership check on audit dir\n    and audit log file. On violation, breadcrumb to /tmp fallback +\n    return silently (fail-open on session; entry dropped but forensic\n    trail preserved via fallback + upstream audit_emit).\n    \"\"\"\n    # F-01-06 symlink + uid defense BEFORE any mkdir/write.\n    # Rationale: an attacker who plants a symlink in the audit dir can\n    # redirect writes. Ownership mismatch indicates another user's\n    # process created the path. Both warrant refusal + breadcrumb.\n    expected_uid = os.geteuid()\n    ok, reason = _is_safe_audit_path(paths[\"dir\"], expected_uid)\n    if not ok:\n        _fallback_security_breadcrumb(\n            f\"audit dir unsafe: {paths['dir']} ({reason})\"\n        )\n        return\n    ok, reason = _is_safe_audit_path(paths[\"log\"], expected_uid)\n    if not ok:\n        _fallback_security_breadcrumb(\n            f\"audit log unsafe: {paths['log']} ({reason})\"\n        )\n        return\n    # Ensure dir exists with restrictive perms\n    # PLAN-024 F-sec-001 P1 fix: mkdir(mode=0o700) closes TOCTOU micro-window\n    # between mkdir() and os.chmod() where same-UID attacker could win a race.\n    try:\n        paths[\"dir\"].mkdir(parents=True, exist_ok=True, mode=0o700)\n        # Belt-and-braces: retighten in case dir pre-existed with looser perms\n        try:\n            os.chmod(paths[\"dir\"], 0o700)\n        except OSError:\n            pass\n    except OSError as e:\n        write_breadcrumb(paths[\"err\"], f\"cannot create audit dir: {e}\")\n        return\n\n    # PLAN-085 Wave B.3 — inline HMAC computation closes the two-writer\n    # chain gap (F-C1-001 / T0-line-168 transition_violation root cause).\n    # 100% of agent_spawn events now carry hmac field per ADR-055.\n    # Reuses _lib/audit_hmac primitives; fail-OPEN per CLAUDE.md §5.\n    # PLAN-194 (rc.1 condition 67): key, predecessor, HMAC, append and sidecar\n    # share ONE FileLock (as in audit_emit/drain); read before it, a writer in\n    # between forked the chain. Only the stateless import stays outside.\n    entry.setdefault(\"hmac\", None)\n    entry.setdefault(\"hmac_error\", None)\n    _audit_hmac = None\n    try:\n        from _lib import audit_hmac as _audit_hmac\n    except Exception as _b3_ie:\n        entry[\"hmac\"] = None\n        entry[\"hmac_error\"] = type(_b3_ie).__name__\n\n    line = \"\"\n\n    try:\n        with FileLock(paths[\"lock\"], timeout=2.5):\n            # Rotate inside the lock so writers can't race past a rename\n            rotated_to = rotate_if_needed(paths[\"log\"], threshold_bytes)\n            # ADR-055-AMEND-2 marker as line 1 BEFORE our HMAC reads the predecessor;\n            # no marker on disk => never sign over a last-hmac that may name it.\n            marker_ok = rotated_to is None or _emit_rotation_marker_under_lock(\n                paths[\"log\"], rotated_to, paths[\"err\"])\n            _b3_hmac_digest_bytes = None\n            if _audit_hmac is not None and not marker_ok:\n                entry[\"hmac\"] = None\n                entry[\"hmac_error\"] = \"chain_reset_marker_missing\"\n            elif _audit_hmac is not None:\n                try:\n                    if not _audit_hmac.is_disabled():\n                        _b3_key = _audit_hmac.get_or_create_key()\n                        _b3_prev = _audit_hmac.read_prev_hmac()  # WITH the lock held\n                        _b3_hmac_digest_bytes = _audit_hmac.compute_entry_hmac(\n                            _b3_key, _b3_prev,\n                            {k: v for k, v in entry.items()\n                             if k not in (\"hmac\", \"hmac_error\")},\n                        )\n                        entry[\"hmac\"] = _audit_hmac.hex_digest(_b3_hmac_digest_bytes)\n                except Exception as _b3_he:\n                    _b3_hmac_digest_bytes = None\n                    entry[\"hmac\"] = None\n                    entry[\"hmac_error\"] = type(_b3_he).__name__\n            # Serialize AFTER the hmac field is final (still under the lock).\n            line = json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n            try:\n                # PLAN-024 F-sec-002 P1 fix: os.open with mode=0o600 sets perms\n                # at create-time, closing the default-umask window between\n                # open() and os.chmod().\n                fd = os.open(\n                    paths[\"log\"],\n                    os.O_WRONLY | os.O_CREAT | os.O_APPEND,\n                    0o600,\n                )\n                with os.fdopen(fd, \"a\", encoding=\"utf-8\") as f:\n                    f.write(line + \"\\n\")\n                    # PLAN-025 F-obs-002: flush + fsync so the append survives\n                    # process/OS crash. Audit is source-of-truth for governance;\n                    # silent loss after write() but before OS flush = forensic gap.\n                    # Cost: one syscall per spawn (~200us). Tolerable vs the\n                    # governance invariant \"every spawn is recorded\".\n                    f.flush()\n                    try:\n                        os.fsync(f.fileno())\n                    except (OSError, AttributeError):\n                        # AttributeError on platforms without fsync; OSError on\n                        # read-only fds or closed streams. Both acceptable — the\n                        # write already succeeded; fsync is best-effort durability.\n                        pass\n                # Belt-and-braces: retighten in case file pre-existed looser\n                try:\n                    os.chmod(paths[\"log\"], 0o600)\n                except OSError:\n                    pass\n                # PLAN-085 Wave B.3 — update last-hmac sidecar within lock\n                # so the next writer reads the correct prev_hmac. Best-effort.\n                if _b3_hmac_digest_bytes is not None and _audit_hmac is not None:\n                    try:\n                        _audit_hmac.write_last_hmac(_b3_hmac_digest_bytes)\n                    except Exception:\n                        pass\n            except OSError as e:\n                write_breadcrumb(paths[\"err\"], f\"append failed: {e}  line={line[:200]}\")\n    except FileLockTimeout:\n        # Fail-open: entry dropped (never chained), session never blocked;\n        # the HMAC only exists under the lock, so the breadcrumb lacks it.\n        line = line or json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n        write_breadcrumb(\n            paths[\"err\"],\n            f\"lock timeout (stale?)  would-log={line[:200]}\",\n        )\n    except Exception as e:  # pragma: no cover\n        write_breadcrumb(paths[\"err\"], f\"unexpected error: {e}\")\n\n\ndef _emit_rotation_marker_under_lock(\n    log_path: Path, rotated_to: Path, err_path: Path\n) -> bool:\n    \"\"\"ADR-055-AMEND-2 marker (emitter/drain helper) after OUR rotation, lock held. True =\n    marker on disk or chain off; False = no marker on disk (when its append failed, last-hmac\n    already names it), so the caller signs nothing over it.\"\"\"\n    try:\n        from _lib import audit_hmac as _ah\n        if _ah.is_disabled():\n            return True\n        from _lib import audit_emit as _ae\n        if _ae._emit_chain_reset_marker_under_lock(\n                log=log_path, previous_archive_path=str(rotated_to),\n                rotation_trigger=\"size_threshold\") is not None:\n            return True\n        why = \"helper returned None\"\n    except Exception as e:\n        why = f\"{type(e).__name__}: {e}\"\n    write_breadcrumb(err_path, f\"chain_reset_marker not written ({why}); \"\n                     \"this agent_spawn line is left unchained\")\n    return False\n\n\n# -----------------------------------------------------------------------------\n# PLAN-155 Wave 4 — Codex host-wire audit-chain path (SENT-CX-B / ADR-161)\n# -----------------------------------------------------------------------------\n#\n# Under OpenAI Codex (CEO_HOOK_ADAPTER=codex) the same audit_log.py hook is\n# registered on the PostToolUse `*` matcher (templates/codex/hooks.json) and,\n# via the headless `scripts/codex-exec-wrapper.sh`, is fed synthesized\n# SessionStart/Stop bracket envelopes. The codex path reads the codex host\n# wire through the codex adapter and appends metadata-only records to the SAME\n# HMAC chain via `_lib.audit_emit` (the single-writer emitter that verify_chain\n# validates). Two NEW registered actions keep the per-tool append and the\n# turn-level backstop COUNTABLE separately (PLAN-155 Wave 4-A / Wave 4-B):\n#\n#   PostToolUse (any tool)  -> emit_codex_tool_recorded   (per-tool append, A)\n#   Stop / SubagentStop     -> emit_codex_turn_ended      (turn backstop, B)\n#   SessionStart            -> emit_session_start          (boot bracket; only\n#                              reached via the wrapper — production codex\n#                              routes SessionStart to SessionStart.py, so there\n#                              is no double-count)\n#\n# The claude (default) path below is UNCHANGED and byte-identical when\n# CEO_HOOK_ADAPTER is unset/`claude`. Completeness residual (named, ADR-161 +\n# degradation page): partial shell interception means a per-tool row may be\n# absent — absence is not evidence of absence of activity. verify_chain() and\n# the HMAC chain shape are untouched; this path only appends.\n\n# Closed tool-name enum mirror of _lib.audit_emit._CODEX_TOOL_RECORDED_TOOL_NAME_ENUM.\n# The codex adapter has already aliased apply_patch -> Write/Edit and\n# spawn_agent -> Task before we see the event; here we only fold mcp__* down to\n# `mcp_other` (MF-SEC-1) and leave the emitter to coerce any residual miss to\n# `other`.\n","numLines":379,"startLine":1,"totalLines":379}},"tool_result_meta":[{"id":"toolu_013EeU26cVTVCjedafq8Xd7G","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1MJVNvwEQN9XmpeYcUQ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EwQHuXcqUsDRvJL3AjY28i","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_log_parts/entries_usage.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10036,"cache_read_input_tokens":111962,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10036},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"8bb53a28-3ca1-4129-9dde-c8714c447ed8","timestamp":"2026-11-13T17:50:41.832Z","request_id":"req_011Ch1MJVA2bcRD1KkpQQJjC","wire_tool_inputs":{"toolu_01EwQHuXcqUsDRvJL3AjY28i":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_log_parts/entries_usage.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EwQHuXcqUsDRvJL3AjY28i","type":"tool_result","content":"1\t\"\"\"Audit-entry construction and usage metadata declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef build_entry(\n5\t    *,\n6\t    event: \"_contract.NormalizedEvent | _payload.HookPayload\",\n7\t    project_dir: str,\n8\t    hook_duration_ms: int,\n9\t) -> Optional[Dict[str, Any]]:\n10\t    \"\"\"Construct a JSONL row from a NormalizedEvent (or legacy HookPayload).\n11\t\n12\t    Accepts either type for backward compatibility with older tests.\n13\t    Returns None if the event indicates a non-Agent tool (defensive — the\n14\t    matcher should already filter to Agent).\n15\t    \"\"\"\n16\t    tool_name = getattr(event, \"tool_name\", \"\")\n17\t    if tool_name and tool_name not in (\"Agent\", \"unknown\"):\n18\t        return None\n19\t\n20\t    description = getattr(event, \"description\", \"\") or \"\"\n21\t    prompt = getattr(event, \"prompt\", \"\") or \"\"\n22\t    session_id = getattr(event, \"session_id\", \"\") or \"\"\n23\t    subagent_type = getattr(event, \"subagent_type\", \"\") or \"\"\n24\t    tool_response = getattr(event, \"tool_response\", {}) or {}\n25\t\n26\t    desc_preview = _redact.redact_secrets(description)\n27\t    desc_hash = _redact.hash_description(description)\n28\t    # PLAN-079: pass subagent_type for Path D archetype-mapping fallback.\n29\t    skill = extract_skill(prompt, subagent_type)\n30\t\n31\t    # PLAN-006 Phase 5b (ADR-016): extract token counts from tool_response.\n32\t    # Always emit the keys (even if None) so consumers can distinguish\n33\t    # \"post-ADR-016 emitter with unknown shape\" from \"pre-ADR-016 emitter\".\n34\t    tin, tout = _tokens.extract_tokens(tool_response)\n35\t    ttotal = _tokens.total_tokens(tool_response)\n36\t\n37\t    # PLAN-020 Phase 0 item 1: capture Anthropic usage_metadata for cache\n38\t    # coverage analysis. Additive v2.7 fields. Null-safe for emitters that\n39\t    # don't provide usage_metadata (legacy + non-Anthropic adapters).\n40\t    usage_metadata = _extract_usage_metadata(tool_response)\n41\t    # PLAN-118 WS-E (S181): the derived ratio is a FLOAT, which\n42\t    # ``canonical_json.encode()`` forbids in HMAC-covered payloads\n43\t    # (``CanonicalJsonError`` → fail-open ``hmac:null`` → chain one-way-rule\n44\t    # break → whole-chain ``tamper``). Encode as integer basis-points\n45\t    # (ratio × 10000, clamped 0..10000) BEFORE it reaches the entry dict.\n46\t    # Mirrors the S164 ``hit_rate`` → ``hit_rate_bps`` class fix; closes the\n47\t    # last live float-in-HMAC leak (the agent_spawn observer path that the\n48\t    # S164 emit_* introspection guard never covered).\n49\t    cache_coverage = _compute_cache_coverage(usage_metadata)\n50\t    cache_coverage_bps = (\n51\t        max(0, min(10000, int(round(cache_coverage * 10000))))\n52\t        if cache_coverage is not None\n53\t        else None\n54\t    )\n55\t\n56\t    # PLAN-020 Phase 1: dual-rail discriminator. Detect from prompt\n57\t    # structure (## SKILL REFERENCE = native rail; ## SKILL CONTENT =\n58\t    # custom inline rail) OR from subagent_type matching canonical-5.\n59\t    rail = _detect_rail(prompt, subagent_type)\n60\t\n61\t    # PLAN-021 ADR-052: model discriminator. Captured from Anthropic\n62\t    # API response when present. Null-safe for non-Anthropic adapters.\n63\t    # PLAN-044 audit-v2 C3-P0-01 (Wave B): fall back to ADR-052\n64\t    # role-to-model policy when tool_response.model is null (default\n65\t    # behavior of Task tool response shape at v1.11.0).\n66\t    model = _extract_model(tool_response, subagent_type=subagent_type)\n67\t\n68\t    # PLAN-044 audit-v2 C3-P0-08 (Wave B): archetype + dispatch_mode\n69\t    # fields. Audit-telemetry.py per-archetype rollups depend on these\n70\t    # being non-null. ADR-082 per-archetype dispatch claim was undone\n71\t    # at v1.11.0 because no emitter wrote them. Wave B closes the gap.\n72\t    archetype = subagent_type if (\n73\t        isinstance(subagent_type, str) and subagent_type\n74\t    ) else None\n75\t    dispatch_mode = _resolve_dispatch_mode(subagent_type or \"\", rail)\n76\t\n77\t    # PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2): capture dispatch_archetype_hint\n78\t    # from the IN-PROMPT marker emitted by inject-agent-context.sh:\n79\t    #   `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n80\t    # The marker propagates cross-process via the recorded `prompt` payload —\n81\t    # env vars do NOT survive the inject-agent-context.sh subprocess → Agent\n82\t    # tool dispatch → audit hook subprocess chain (Codex iter 2 finding).\n83\t    #\n84\t    # Validated via the same NFKC + ≤64 char + charset `^[a-z][a-z0-9-]*$` +\n85\t    # control/JSON-meta rejection contract as `_lib.audit_emit._validate_dispatch_archetype_hint`.\n86\t    # On rejection (or marker absent): returns None (fail-open). The field is\n87\t    # always emitted in the audit row — null when no hint is set/validated,\n88\t    # validated string otherwise.\n89\t    dispatch_archetype_hint = _extract_dispatch_archetype_hint(prompt)\n90\t\n91\t    entry: Dict[str, Any] = {\n92\t        \"ts\": now_iso_utc(),\n93\t        \"action\": \"agent_spawn\",\n94\t        \"session_id\": session_id,\n95\t        \"project\": project_dir,\n96\t        \"tool\": tool_name or \"Agent\",\n97\t        \"subagent_type\": subagent_type,\n98\t        \"desc_preview\": desc_preview,\n99\t        \"desc_hash\": desc_hash,\n100\t        \"skill\": skill,\n101\t        \"has_profile\": has_profile(prompt),\n102\t        \"has_file_assignment\": has_file_assignment(prompt),\n103\t        \"prompt_len_bucket\": bucket_prompt_length(len(prompt)),\n104\t        \"response_kind\": _payload.response_kind(tool_response),\n105\t        \"hook_duration_ms\": int(hook_duration_ms),\n106\t        # Tokens (ADR-016): optional nullable, always-present.\n107\t        \"tokens_in\": tin,\n108\t        \"tokens_out\": tout,\n109\t        \"tokens_total\": ttotal,\n110\t        # PLAN-020 v2.7 additions (ADDITIVE — older consumers ignore).\n111\t        \"usage_metadata\": usage_metadata,\n112\t        # PLAN-118 WS-E (S181): integer basis-points (ratio × 10000) — the\n113\t        # legacy float ``cache_coverage`` field is REMOVED (it caused\n114\t        # CanonicalJsonError + fail-open hmac:null on every real spawn).\n115\t        \"cache_coverage_bps\": cache_coverage_bps,\n116\t        \"rail\": rail,\n117\t        # PLAN-021 v2.8 addition (ADDITIVE — ADR-052 multi-model).\n118\t        \"model\": model,\n119\t        # PLAN-044 audit-v2 v2.14 additions (Wave B C3-P0-08).\n120\t        \"archetype\": archetype,\n121\t        \"dispatch_mode\": dispatch_mode,\n122\t        # PLAN-080 Phase 1 v2.24 addition (M2-C3 + M2-CDX-1) —\n123\t        # dispatch_archetype_hint captured pre-ADR-082-mitigation.\n124\t        # Validated via _lib.audit_emit redaction contract.\n125\t        # Always-present (null when env unset or validation rejected).\n126\t        \"dispatch_archetype_hint\": dispatch_archetype_hint,\n127\t    }\n128\t    return entry\n129\t\n130\t\n131\t# -----------------------------------------------------------------------------\n132\t# PLAN-020 v2.7 cache-header capture helpers (Phase 0 item 1)\n133\t# -----------------------------------------------------------------------------\n134\t\n135\t# Canonical-5 archetypes that ship with native subagent files (ADR-050).\n136\t# Rail discrimination: archetype is \"native\" IFF its name matches AND\n137\t# subagent_type is non-empty. Else \"custom\" if classic spawn signal is\n138\t# present. Else null (legacy / unknown).\n139\t_CANONICAL_5 = frozenset({\n140\t    \"code-reviewer\",\n141\t    \"security-engineer\",\n142\t    \"qa-architect\",\n143\t    \"performance-engineer\",\n144\t    \"devops\",\n145\t})\n146\t\n147\t# Native rail spawn-prompt sentinel (additive ADR-051; co-exists with\n148\t# the legacy \"## SKILL CONTENT\" inline sentinel).\n149\t_SKILL_REFERENCE_RE = re.compile(\n150\t    r\"^##\\s+SKILL\\s+REFERENCE\\s*$\", re.MULTILINE\n151\t)\n152\t_SKILL_CONTENT_RE = re.compile(\n153\t    r\"^##\\s+SKILL\\s+CONTENT\\s*$\", re.MULTILINE\n154\t)\n155\t\n156\t\n157\tdef _extract_usage_metadata(tool_response: Any) -> Optional[Dict[str, Any]]:\n158\t    \"\"\"Extract Anthropic usage_metadata from a tool_response payload.\n159\t\n160\t    Returns a dict with `cache_creation_input_tokens`,\n161\t    `cache_read_input_tokens`, `uncached_input_tokens`, `output_tokens`,\n162\t    `thinking_tokens` — each int or None. Returns None if the payload\n163\t    has no `usage_metadata` field at all (legacy / non-Anthropic).\n164\t\n165\t    Defensive: never raises; returns None on any unexpected shape.\n166\t    \"\"\"\n167\t    if not isinstance(tool_response, dict):\n168\t        return None\n169\t    usage = tool_response.get(\"usage_metadata\")\n170\t    if not isinstance(usage, dict):\n171\t        # Some emitters may put it under \"usage\" or in nested response.\n172\t        usage = tool_response.get(\"usage\")\n173\t        if not isinstance(usage, dict):\n174\t            return None\n175\t\n176\t    def _coerce_int(value: Any) -> Optional[int]:\n177\t        if isinstance(value, bool):\n178\t            return None\n179\t        if isinstance(value, int):\n180\t            return value\n181\t        if isinstance(value, str) and value.isdigit():\n182\t            return int(value)\n183\t        return None\n184\t\n185\t    return {\n186\t        \"cache_creation_input_tokens\": _coerce_int(\n187\t            usage.get(\"cache_creation_input_tokens\")\n188\t        ),\n189\t        \"cache_read_input_tokens\": _coerce_int(\n190\t            usage.get(\"cache_read_input_tokens\")\n191\t        ),\n192\t        \"uncached_input_tokens\": _coerce_int(usage.get(\"uncached_input_tokens\")),\n193\t        \"output_tokens\": _coerce_int(usage.get(\"output_tokens\")),\n194\t        \"thinking_tokens\": _coerce_int(usage.get(\"thinking_tokens\")),\n195\t    }\n196\t\n197\t\n198\tdef _compute_cache_coverage(\n199\t    usage_metadata: Optional[Dict[str, Any]],\n200\t) -> Optional[float]:\n201\t    \"\"\"Derived metric: cache_read / (cache_read + cache_creation + uncached).\n202\t\n203\t    Returns None if the inputs are missing or the denominator is zero\n204\t    (defensive against synthetic / mocked payloads).\n205\t    \"\"\"\n206\t    if not usage_metadata:\n207\t        return None\n208\t    cache_read = usage_metadata.get(\"cache_read_input_tokens\") or 0\n209\t    cache_creation = usage_metadata.get(\"cache_creation_input_tokens\") or 0\n210\t    uncached = usage_metadata.get(\"uncached_input_tokens\") or 0\n211\t    denom = cache_read + cache_creation + uncached\n212\t    if denom <= 0:\n213\t        return None\n214\t    return round(cache_read / denom, 4)\n215\t\n216\t\n217\t# PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — in-prompt hint marker pattern.\n218\t# inject-agent-context.sh emits this marker once near the top of every spawn\n219\t# prompt; audit_log.py extracts the slug at PostToolUse audit time. The\n220\t# regex captures the slug into group 1 and validates the charset inline.\n221\t_DISPATCH_HINT_MARKER_RE = re.compile(\n222\t    r\"<!--\\s*ceo-dispatch-archetype-hint:\\s*([a-z][a-z0-9-]{0,63})\\s*-->\",\n223\t    re.IGNORECASE,\n224\t)\n225\t\n226\t\n227\tdef _extract_dispatch_archetype_hint(prompt: str) -> Optional[str]:\n228\t    \"\"\"PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — extract validated hint.\n229\t\n230\t    Searches `prompt` for the in-prompt marker:\n231\t      `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n232\t\n233\t    Falls back to `CEO_DISPATCH_ARCHETYPE_HINT` env var ONLY if the marker\n234\t    is absent (advisory path; env vars do not reliably propagate across the\n235\t    /spawn subprocess → Agent tool dispatch → audit hook subprocess chain\n236\t    per Codex Phase 1 iter 2 finding).\n237\t\n238\t    Validation contract (mirrors `_lib.audit_emit._validate_dispatch_archetype_hint`):\n239\t      1. NFKC normalize\n240\t      2. Length ≤ 64 chars post-NFKC\n241\t      3. Charset `^[a-z][a-z0-9-]*$` (lowercase prefix; hyphens + digits)\n242\t      4. Reject control bytes (0x00-0x1f, 0x7f-0x9f), null, JSON-meta `{}[]:\",\\\\`\n243\t\n244\t    On rejection: return None (fail-open per audit hook contract; never blocks).\n245\t    On marker absent + env unset: return None.\n246\t    On accept: return normalized lowercase slug.\n247\t    \"\"\"\n248\t    raw: Optional[str] = None\n249\t    # Primary path: in-prompt marker\n250\t    if isinstance(prompt, str) and prompt:\n251\t        m = _DISPATCH_HINT_MARKER_RE.search(prompt)\n252\t        if m:\n253\t            raw = m.group(1)\n254\t    # Fallback path: env var (advisory; may be set by future direct callers)\n255\t    if not raw:\n256\t        raw = os.environ.get(\"CEO_DISPATCH_ARCHETYPE_HINT\")\n257\t    if not raw:\n258\t        return None\n259\t    # Defensive try/except — must NEVER throw under fail-open contract.\n260\t    try:\n261\t        # NFKC normalize then lowercase (regex was case-insensitive)\n262\t        norm = unicodedata.normalize(\"NFKC\", raw).lower()\n263\t        # Length cap (post-NFKC)\n264\t        if len(norm) > 64 or len(norm) == 0:\n265\t            return None\n266\t        # Charset: ^[a-z][a-z0-9-]*$\n267\t        if not re.match(r\"^[a-z][a-z0-9-]*$\", norm):\n268\t            return None\n269\t        # Defensive: reject if any control byte slipped through\n270\t        if any(ord(c) < 0x20 or 0x7f <= ord(c) <= 0x9f for c in norm):\n271\t            return None\n272\t        # Defensive: JSON-meta chars\n273\t        if any(c in '{}[]:,\"\\\\' for c in norm):\n274\t            return None\n275\t        return norm\n276\t    except Exception:  # pragma: no cover (defensive — extraction never throws)\n277\t        return None\n278\t\n279\t\n280\tdef _extract_model(\n281\t    tool_response: Any,\n282\t    subagent_type: Optional[str] = None,\n283\t) -> Optional[str]:\n284\t    \"\"\"PLAN-021 ADR-052: extract Claude model ID from tool_response.\n285\t\n286\t    Anthropic API responses include a `model` field (e.g. \"claude-fable-5\",\n287\t    \"claude-opus-5\", \"claude-haiku-4-5\"; older gens appear in replay). Some adapters nest\n288\t    it under `response.model` or `content.model`. Returns the string if\n289\t    found, else falls back to ADR-052 role-to-model policy table when\n290\t    `subagent_type` is supplied; otherwise None.\n291\t\n292\t    Canonical IDs (PLAN-169 W2.10 D1 — current fleet; the table below is\n293\t    the authority, this prose only illustrates):\n294\t      - claude-fable-5 / claude-opus-5 → orchestrator + critical VETOs\n295\t      - claude-sonnet-5                → mid-complexity workers\n296\t      - claude-haiku-4-5               → high-frequency fan-out\n297\t\n298\t    PLAN-044 audit-v2 C3-P0-01 fix (Wave B): the Task tool response\n299\t    shape from Claude Code's hook payload omits the `model` field on\n300\t    100% of agent_spawn events (verified at audit time: 199/199 events\n301\t    had `model: null`). Without an authoritative observation, the\n302\t    fallback uses the ADR-052 policy table — adopters reading the\n303\t    audit-log get a *policy-derived* model identity, not an\n304\t    *observation-derived* one. The two diverge only when an adopter\n305\t    overrides ADR-052 (then the audit-log over-reports the policy\n306\t    model rather than the actual model — known limitation; downstream\n307\t    cost reports re-resolve via subagent_type when present).\n308\t    \"\"\"\n309\t    if isinstance(tool_response, dict):\n310\t        # Direct top-level (most Anthropic SDK shapes)\n311\t        model = tool_response.get(\"model\")\n312\t        if isinstance(model, str) and model:\n313\t            return model\n314\t        # Nested under \"response\" (some adapter shapes)\n315\t        resp = tool_response.get(\"response\")\n316\t        if isinstance(resp, dict):\n317\t            m = resp.get(\"model\")\n318\t            if isinstance(m, str) and m:\n319\t                return m\n320\t        # Nested under \"usage_metadata\" sibling-content\n321\t        usage = tool_response.get(\"usage_metadata\")\n322\t        if isinstance(usage, dict):\n323\t            m = usage.get(\"model\")\n324\t            if isinstance(m, str) and m:\n325\t                return m\n326\t\n327\t    # Wave B fallback — ADR-052 role-to-model policy table.\n328\t    if isinstance(subagent_type, str) and subagent_type:\n329\t        policy_model = _ADR_052_ROLE_TO_MODEL.get(subagent_type)\n330\t        if policy_model:\n331\t            return policy_model\n332\t    return None\n333\t\n334\t\n335\t# PLAN-044 audit-v2 C3-P0-01 — ADR-052 §Role-to-model distribution table.\n336\t# Used as fallback when tool_response.model is null (which happens on 100%\n337\t# of Task-dispatched spawns at v1.11.0). Pinned to canonical IDs from\n338\t# ADR-052; if an adopter overrides ADR-052 they should also override\n339\t# this table OR pre-populate tool_response.model upstream.\n340\t# PLAN-163 T1.4 (ADR-181, OQ1=b + OQ2=migrate-now): ROUTING refresh only —\n341\t# Opus-tier fallbacks move claude-opus-4-8 -> claude-opus-5 and the advisory\n342\t# (Sonnet) tier moves claude-sonnet-4-6 -> claude-sonnet-5. This table is a\n343\t# routing-policy fallback, NOT a pricing surface (grok F11): historical\n344\t# pricing/replay tables keep the old ids. Every value MUST stay inside the\n345\t# ADR-149 AVAILABLE_MODELS_WORKING_SET (tied by\n346\t# test_adr149_validator_parity.py).\n347\t_ADR_052_ROLE_TO_MODEL: Dict[str, str] = {\n348\t    # Canonical-5 VETO archetypes — Opus floor per ADR-052 + ADR-080\n349\t    \"code-reviewer\": \"claude-opus-5\",\n350\t    \"security-engineer\": \"claude-opus-5\",\n351\t    \"qa-architect\": \"claude-sonnet-5\",\n352\t    \"performance-engineer\": \"claude-sonnet-5\",\n353\t    # PLAN-169 W2.10 F8: bare id — the dated pin is not in availableModels\n354\t    # and interacts badly with enforceAvailableModels.\n355\t    \"devops\": \"claude-haiku-4-5\",\n356\t    # Mitigated rail — general-purpose dispatch inherits CEO model.\n357\t    # Default-CEO is Opus-tier unless CEO_MODEL_DOWNSHIFT is honored.\n358\t    # ADR-149 Amendment 3 (S357): follows the session-default pin, now\n359\t    # claude-opus-5-5. A POLICY value, not an observation: when the Task\n360\t    # response carries no model (the common case, see _extract_model) the\n361\t    # audit log records this row even if a per-call model or alias served\n362\t    # the spawn.\n363\t    \"general-purpose\": \"claude-opus-5-5\",\n364\t    # Probe / specialty archetypes\n365\t    \"growth-engineer\": \"claude-sonnet-5\",\n366\t    \"billing-engineer\": \"claude-sonnet-5\",\n367\t    \"compliance-specialist\": \"claude-sonnet-5\",\n368\t    \"chaos-engineer\": \"claude-sonnet-5\",\n369\t    \"data-engineer\": \"claude-sonnet-5\",\n370\t    \"real-time-systems-engineer\": \"claude-sonnet-5\",\n371\t    \"refactoring-lead\": \"claude-sonnet-5\",\n372\t    \"vp-engineering\": \"claude-opus-5\",\n373\t    \"vp-product\": \"claude-sonnet-5\",\n374\t    \"vp-operations\": \"claude-sonnet-5\",\n375\t    # PLAN-074 Wave 1c provenance — see docs/PLAN-086-adr-052-role-extension.md\n376\t    # 4 VETO-floor archetypes added per PLAN-086 Wave B (R-019 ROLE_TO_MODEL ext).\n377\t    # ADR-052 §Veto-floor expansion (lines 186-210) names these as VETO-floor;\n378\t    # llm-finops-architect carries Opus floor for cost-ceiling integrity (see\n379\t    # docs §2 §Why llm-finops-architect). ADR-052 bytes NOT mutated (anti-churn).\n380\t    \"incident-commander\": \"claude-opus-5\",\n381\t    \"identity-trust-architect\": \"claude-opus-5\",\n382\t    \"threat-detection-engineer\": \"claude-opus-5\",\n383\t    \"llm-finops-architect\": \"claude-opus-5\",\n384\t}\n385\t\n386\t\n387\tdef _resolve_dispatch_mode(\n388\t    subagent_type: str,\n389\t    rail: Optional[str],\n390\t) -> Optional[str]:\n391\t    \"\"\"PLAN-044 audit-v2 C3-P0-08 — Wave B: derive dispatch_mode field.\n392\t\n393\t    Maps (subagent_type, rail) → \"native\" | \"mitigated\" per the\n394\t    PLAN-061 / ADR-082 dispatch policy:\n395\t\n396\t      - canonical-5 native rail → \"native\" (full tool grant per\n397\t        ADR-052 floor; H4 anomaly does NOT apply because empirically\n398\t        only `code-reviewer` is reliable; PLAN-061 default-on routes\n399\t        the other 4 via mitigated).\n400\t      - any non-canonical archetype → \"mitigated\" (general-purpose\n401\t        with persona injected via `## SKILL CONTENT`).\n402\t      - rail=None or unknown → None (legacy / pre-PLAN-061).\n403\t\n404\t    See ADR-082 §Routing decision and `inject-agent-context.sh` for\n405\t    the live override matrix (CEO_DISPATCHER_MODE,\n406\t    CEO_MITIGATION_DISABLE).\n407\t    \"\"\"\n408\t    if not isinstance(subagent_type, str):\n409\t        return None\n410\t    # Canonical-5 native rail — only code-reviewer routes natively\n411\t    # by default per PLAN-061 / ADR-082. Other 4 are mitigated.\n412\t    if subagent_type == \"code-reviewer\" and rail == \"native\":\n413\t        return \"native\"\n414\t    if subagent_type in _CANONICAL_5 and rail == \"custom\":\n415\t        # Older inline ## SKILL CONTENT prompt — pre-PLAN-061 spawn.\n416\t        return \"native_legacy\"\n417\t    if rail is None:\n418\t        return None\n419\t    # Default mitigated rail for non-canonical-5 + non-cr canonicals\n420\t    # under PLAN-061 default-on.\n421\t    return \"mitigated\"\n422\t\n423\t\n424\tdef _detect_rail(prompt: str, subagent_type: str) -> Optional[str]:\n425\t    \"\"\"Detect spawn dispatch rail (native vs custom) from prompt + subagent.\n426\t\n427\t    Heuristic order:\n428\t    1. If subagent_type matches a canonical-5 archetype name AND the\n429\t       prompt has `## SKILL REFERENCE` sentinel → \"native\".\n430\t    2. Else if prompt has `## SKILL CONTENT` (legacy inline) → \"custom\".\n431\t    3. Else if prompt has `## SKILL REFERENCE` only → \"native\"\n432\t       (subagent_type may be empty for some adapters).\n433\t    4. Else None (unknown / pre-PLAN-020 / non-spawn event).\n434\t    \"\"\"\n435\t    if not isinstance(prompt, str):\n436\t        return None\n437\t    has_reference = bool(_SKILL_REFERENCE_RE.search(prompt))\n438\t    has_content = bool(_SKILL_CONTENT_RE.search(prompt))\n439\t    is_canonical = (\n440\t        isinstance(subagent_type, str) and subagent_type in _CANONICAL_5\n441\t    )\n442\t\n443\t    if is_canonical and has_reference:\n444\t        return \"native\"\n445\t    if has_content:\n446\t        return \"custom\"\n447\t    if has_reference:\n448\t        return \"native\"\n449\t    return None\n450\t\n451\t\n452\t# -----------------------------------------------------------------------------\n453\t# Rotation\n454\t# -----------------------------------------------------------------------------\n455\t\n456\t\n457\t"}]},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"580c01cc-69d7-44cf-8294-921afd591997","timestamp":"2026-11-13T17:50:41.837Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_log_parts/entries_usage.py","content":"\"\"\"Audit-entry construction and usage metadata declarations.\"\"\"\nfrom __future__ import annotations\n\ndef build_entry(\n    *,\n    event: \"_contract.NormalizedEvent | _payload.HookPayload\",\n    project_dir: str,\n    hook_duration_ms: int,\n) -> Optional[Dict[str, Any]]:\n    \"\"\"Construct a JSONL row from a NormalizedEvent (or legacy HookPayload).\n\n    Accepts either type for backward compatibility with older tests.\n    Returns None if the event indicates a non-Agent tool (defensive — the\n    matcher should already filter to Agent).\n    \"\"\"\n    tool_name = getattr(event, \"tool_name\", \"\")\n    if tool_name and tool_name not in (\"Agent\", \"unknown\"):\n        return None\n\n    description = getattr(event, \"description\", \"\") or \"\"\n    prompt = getattr(event, \"prompt\", \"\") or \"\"\n    session_id = getattr(event, \"session_id\", \"\") or \"\"\n    subagent_type = getattr(event, \"subagent_type\", \"\") or \"\"\n    tool_response = getattr(event, \"tool_response\", {}) or {}\n\n    desc_preview = _redact.redact_secrets(description)\n    desc_hash = _redact.hash_description(description)\n    # PLAN-079: pass subagent_type for Path D archetype-mapping fallback.\n    skill = extract_skill(prompt, subagent_type)\n\n    # PLAN-006 Phase 5b (ADR-016): extract token counts from tool_response.\n    # Always emit the keys (even if None) so consumers can distinguish\n    # \"post-ADR-016 emitter with unknown shape\" from \"pre-ADR-016 emitter\".\n    tin, tout = _tokens.extract_tokens(tool_response)\n    ttotal = _tokens.total_tokens(tool_response)\n\n    # PLAN-020 Phase 0 item 1: capture Anthropic usage_metadata for cache\n    # coverage analysis. Additive v2.7 fields. Null-safe for emitters that\n    # don't provide usage_metadata (legacy + non-Anthropic adapters).\n    usage_metadata = _extract_usage_metadata(tool_response)\n    # PLAN-118 WS-E (S181): the derived ratio is a FLOAT, which\n    # ``canonical_json.encode()`` forbids in HMAC-covered payloads\n    # (``CanonicalJsonError`` → fail-open ``hmac:null`` → chain one-way-rule\n    # break → whole-chain ``tamper``). Encode as integer basis-points\n    # (ratio × 10000, clamped 0..10000) BEFORE it reaches the entry dict.\n    # Mirrors the S164 ``hit_rate`` → ``hit_rate_bps`` class fix; closes the\n    # last live float-in-HMAC leak (the agent_spawn observer path that the\n    # S164 emit_* introspection guard never covered).\n    cache_coverage = _compute_cache_coverage(usage_metadata)\n    cache_coverage_bps = (\n        max(0, min(10000, int(round(cache_coverage * 10000))))\n        if cache_coverage is not None\n        else None\n    )\n\n    # PLAN-020 Phase 1: dual-rail discriminator. Detect from prompt\n    # structure (## SKILL REFERENCE = native rail; ## SKILL CONTENT =\n    # custom inline rail) OR from subagent_type matching canonical-5.\n    rail = _detect_rail(prompt, subagent_type)\n\n    # PLAN-021 ADR-052: model discriminator. Captured from Anthropic\n    # API response when present. Null-safe for non-Anthropic adapters.\n    # PLAN-044 audit-v2 C3-P0-01 (Wave B): fall back to ADR-052\n    # role-to-model policy when tool_response.model is null (default\n    # behavior of Task tool response shape at v1.11.0).\n    model = _extract_model(tool_response, subagent_type=subagent_type)\n\n    # PLAN-044 audit-v2 C3-P0-08 (Wave B): archetype + dispatch_mode\n    # fields. Audit-telemetry.py per-archetype rollups depend on these\n    # being non-null. ADR-082 per-archetype dispatch claim was undone\n    # at v1.11.0 because no emitter wrote them. Wave B closes the gap.\n    archetype = subagent_type if (\n        isinstance(subagent_type, str) and subagent_type\n    ) else None\n    dispatch_mode = _resolve_dispatch_mode(subagent_type or \"\", rail)\n\n    # PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2): capture dispatch_archetype_hint\n    # from the IN-PROMPT marker emitted by inject-agent-context.sh:\n    #   `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n    # The marker propagates cross-process via the recorded `prompt` payload —\n    # env vars do NOT survive the inject-agent-context.sh subprocess → Agent\n    # tool dispatch → audit hook subprocess chain (Codex iter 2 finding).\n    #\n    # Validated via the same NFKC + ≤64 char + charset `^[a-z][a-z0-9-]*$` +\n    # control/JSON-meta rejection contract as `_lib.audit_emit._validate_dispatch_archetype_hint`.\n    # On rejection (or marker absent): returns None (fail-open). The field is\n    # always emitted in the audit row — null when no hint is set/validated,\n    # validated string otherwise.\n    dispatch_archetype_hint = _extract_dispatch_archetype_hint(prompt)\n\n    entry: Dict[str, Any] = {\n        \"ts\": now_iso_utc(),\n        \"action\": \"agent_spawn\",\n        \"session_id\": session_id,\n        \"project\": project_dir,\n        \"tool\": tool_name or \"Agent\",\n        \"subagent_type\": subagent_type,\n        \"desc_preview\": desc_preview,\n        \"desc_hash\": desc_hash,\n        \"skill\": skill,\n        \"has_profile\": has_profile(prompt),\n        \"has_file_assignment\": has_file_assignment(prompt),\n        \"prompt_len_bucket\": bucket_prompt_length(len(prompt)),\n        \"response_kind\": _payload.response_kind(tool_response),\n        \"hook_duration_ms\": int(hook_duration_ms),\n        # Tokens (ADR-016): optional nullable, always-present.\n        \"tokens_in\": tin,\n        \"tokens_out\": tout,\n        \"tokens_total\": ttotal,\n        # PLAN-020 v2.7 additions (ADDITIVE — older consumers ignore).\n        \"usage_metadata\": usage_metadata,\n        # PLAN-118 WS-E (S181): integer basis-points (ratio × 10000) — the\n        # legacy float ``cache_coverage`` field is REMOVED (it caused\n        # CanonicalJsonError + fail-open hmac:null on every real spawn).\n        \"cache_coverage_bps\": cache_coverage_bps,\n        \"rail\": rail,\n        # PLAN-021 v2.8 addition (ADDITIVE — ADR-052 multi-model).\n        \"model\": model,\n        # PLAN-044 audit-v2 v2.14 additions (Wave B C3-P0-08).\n        \"archetype\": archetype,\n        \"dispatch_mode\": dispatch_mode,\n        # PLAN-080 Phase 1 v2.24 addition (M2-C3 + M2-CDX-1) —\n        # dispatch_archetype_hint captured pre-ADR-082-mitigation.\n        # Validated via _lib.audit_emit redaction contract.\n        # Always-present (null when env unset or validation rejected).\n        \"dispatch_archetype_hint\": dispatch_archetype_hint,\n    }\n    return entry\n\n\n# -----------------------------------------------------------------------------\n# PLAN-020 v2.7 cache-header capture helpers (Phase 0 item 1)\n# -----------------------------------------------------------------------------\n\n# Canonical-5 archetypes that ship with native subagent files (ADR-050).\n# Rail discrimination: archetype is \"native\" IFF its name matches AND\n# subagent_type is non-empty. Else \"custom\" if classic spawn signal is\n# present. Else null (legacy / unknown).\n_CANONICAL_5 = frozenset({\n    \"code-reviewer\",\n    \"security-engineer\",\n    \"qa-architect\",\n    \"performance-engineer\",\n    \"devops\",\n})\n\n# Native rail spawn-prompt sentinel (additive ADR-051; co-exists with\n# the legacy \"## SKILL CONTENT\" inline sentinel).\n_SKILL_REFERENCE_RE = re.compile(\n    r\"^##\\s+SKILL\\s+REFERENCE\\s*$\", re.MULTILINE\n)\n_SKILL_CONTENT_RE = re.compile(\n    r\"^##\\s+SKILL\\s+CONTENT\\s*$\", re.MULTILINE\n)\n\n\ndef _extract_usage_metadata(tool_response: Any) -> Optional[Dict[str, Any]]:\n    \"\"\"Extract Anthropic usage_metadata from a tool_response payload.\n\n    Returns a dict with `cache_creation_input_tokens`,\n    `cache_read_input_tokens`, `uncached_input_tokens`, `output_tokens`,\n    `thinking_tokens` — each int or None. Returns None if the payload\n    has no `usage_metadata` field at all (legacy / non-Anthropic).\n\n    Defensive: never raises; returns None on any unexpected shape.\n    \"\"\"\n    if not isinstance(tool_response, dict):\n        return None\n    usage = tool_response.get(\"usage_metadata\")\n    if not isinstance(usage, dict):\n        # Some emitters may put it under \"usage\" or in nested response.\n        usage = tool_response.get(\"usage\")\n        if not isinstance(usage, dict):\n            return None\n\n    def _coerce_int(value: Any) -> Optional[int]:\n        if isinstance(value, bool):\n            return None\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str) and value.isdigit():\n            return int(value)\n        return None\n\n    return {\n        \"cache_creation_input_tokens\": _coerce_int(\n            usage.get(\"cache_creation_input_tokens\")\n        ),\n        \"cache_read_input_tokens\": _coerce_int(\n            usage.get(\"cache_read_input_tokens\")\n        ),\n        \"uncached_input_tokens\": _coerce_int(usage.get(\"uncached_input_tokens\")),\n        \"output_tokens\": _coerce_int(usage.get(\"output_tokens\")),\n        \"thinking_tokens\": _coerce_int(usage.get(\"thinking_tokens\")),\n    }\n\n\ndef _compute_cache_coverage(\n    usage_metadata: Optional[Dict[str, Any]],\n) -> Optional[float]:\n    \"\"\"Derived metric: cache_read / (cache_read + cache_creation + uncached).\n\n    Returns None if the inputs are missing or the denominator is zero\n    (defensive against synthetic / mocked payloads).\n    \"\"\"\n    if not usage_metadata:\n        return None\n    cache_read = usage_metadata.get(\"cache_read_input_tokens\") or 0\n    cache_creation = usage_metadata.get(\"cache_creation_input_tokens\") or 0\n    uncached = usage_metadata.get(\"uncached_input_tokens\") or 0\n    denom = cache_read + cache_creation + uncached\n    if denom <= 0:\n        return None\n    return round(cache_read / denom, 4)\n\n\n# PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — in-prompt hint marker pattern.\n# inject-agent-context.sh emits this marker once near the top of every spawn\n# prompt; audit_log.py extracts the slug at PostToolUse audit time. The\n# regex captures the slug into group 1 and validates the charset inline.\n_DISPATCH_HINT_MARKER_RE = re.compile(\n    r\"<!--\\s*ceo-dispatch-archetype-hint:\\s*([a-z][a-z0-9-]{0,63})\\s*-->\",\n    re.IGNORECASE,\n)\n\n\ndef _extract_dispatch_archetype_hint(prompt: str) -> Optional[str]:\n    \"\"\"PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — extract validated hint.\n\n    Searches `prompt` for the in-prompt marker:\n      `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n\n    Falls back to `CEO_DISPATCH_ARCHETYPE_HINT` env var ONLY if the marker\n    is absent (advisory path; env vars do not reliably propagate across the\n    /spawn subprocess → Agent tool dispatch → audit hook subprocess chain\n    per Codex Phase 1 iter 2 finding).\n\n    Validation contract (mirrors `_lib.audit_emit._validate_dispatch_archetype_hint`):\n      1. NFKC normalize\n      2. Length ≤ 64 chars post-NFKC\n      3. Charset `^[a-z][a-z0-9-]*$` (lowercase prefix; hyphens + digits)\n      4. Reject control bytes (0x00-0x1f, 0x7f-0x9f), null, JSON-meta `{}[]:\",\\\\`\n\n    On rejection: return None (fail-open per audit hook contract; never blocks).\n    On marker absent + env unset: return None.\n    On accept: return normalized lowercase slug.\n    \"\"\"\n    raw: Optional[str] = None\n    # Primary path: in-prompt marker\n    if isinstance(prompt, str) and prompt:\n        m = _DISPATCH_HINT_MARKER_RE.search(prompt)\n        if m:\n            raw = m.group(1)\n    # Fallback path: env var (advisory; may be set by future direct callers)\n    if not raw:\n        raw = os.environ.get(\"CEO_DISPATCH_ARCHETYPE_HINT\")\n    if not raw:\n        return None\n    # Defensive try/except — must NEVER throw under fail-open contract.\n    try:\n        # NFKC normalize then lowercase (regex was case-insensitive)\n        norm = unicodedata.normalize(\"NFKC\", raw).lower()\n        # Length cap (post-NFKC)\n        if len(norm) > 64 or len(norm) == 0:\n            return None\n        # Charset: ^[a-z][a-z0-9-]*$\n        if not re.match(r\"^[a-z][a-z0-9-]*$\", norm):\n            return None\n        # Defensive: reject if any control byte slipped through\n        if any(ord(c) < 0x20 or 0x7f <= ord(c) <= 0x9f for c in norm):\n            return None\n        # Defensive: JSON-meta chars\n        if any(c in '{}[]:,\"\\\\' for c in norm):\n            return None\n        return norm\n    except Exception:  # pragma: no cover (defensive — extraction never throws)\n        return None\n\n\ndef _extract_model(\n    tool_response: Any,\n    subagent_type: Optional[str] = None,\n) -> Optional[str]:\n    \"\"\"PLAN-021 ADR-052: extract Claude model ID from tool_response.\n\n    Anthropic API responses include a `model` field (e.g. \"claude-fable-5\",\n    \"claude-opus-5\", \"claude-haiku-4-5\"; older gens appear in replay). Some adapters nest\n    it under `response.model` or `content.model`. Returns the string if\n    found, else falls back to ADR-052 role-to-model policy table when\n    `subagent_type` is supplied; otherwise None.\n\n    Canonical IDs (PLAN-169 W2.10 D1 — current fleet; the table below is\n    the authority, this prose only illustrates):\n      - claude-fable-5 / claude-opus-5 → orchestrator + critical VETOs\n      - claude-sonnet-5                → mid-complexity workers\n      - claude-haiku-4-5               → high-frequency fan-out\n\n    PLAN-044 audit-v2 C3-P0-01 fix (Wave B): the Task tool response\n    shape from Claude Code's hook payload omits the `model` field on\n    100% of agent_spawn events (verified at audit time: 199/199 events\n    had `model: null`). Without an authoritative observation, the\n    fallback uses the ADR-052 policy table — adopters reading the\n    audit-log get a *policy-derived* model identity, not an\n    *observation-derived* one. The two diverge only when an adopter\n    overrides ADR-052 (then the audit-log over-reports the policy\n    model rather than the actual model — known limitation; downstream\n    cost reports re-resolve via subagent_type when present).\n    \"\"\"\n    if isinstance(tool_response, dict):\n        # Direct top-level (most Anthropic SDK shapes)\n        model = tool_response.get(\"model\")\n        if isinstance(model, str) and model:\n            return model\n        # Nested under \"response\" (some adapter shapes)\n        resp = tool_response.get(\"response\")\n        if isinstance(resp, dict):\n            m = resp.get(\"model\")\n            if isinstance(m, str) and m:\n                return m\n        # Nested under \"usage_metadata\" sibling-content\n        usage = tool_response.get(\"usage_metadata\")\n        if isinstance(usage, dict):\n            m = usage.get(\"model\")\n            if isinstance(m, str) and m:\n                return m\n\n    # Wave B fallback — ADR-052 role-to-model policy table.\n    if isinstance(subagent_type, str) and subagent_type:\n        policy_model = _ADR_052_ROLE_TO_MODEL.get(subagent_type)\n        if policy_model:\n            return policy_model\n    return None\n\n\n# PLAN-044 audit-v2 C3-P0-01 — ADR-052 §Role-to-model distribution table.\n# Used as fallback when tool_response.model is null (which happens on 100%\n# of Task-dispatched spawns at v1.11.0). Pinned to canonical IDs from\n# ADR-052; if an adopter overrides ADR-052 they should also override\n# this table OR pre-populate tool_response.model upstream.\n# PLAN-163 T1.4 (ADR-181, OQ1=b + OQ2=migrate-now): ROUTING refresh only —\n# Opus-tier fallbacks move claude-opus-4-8 -> claude-opus-5 and the advisory\n# (Sonnet) tier moves claude-sonnet-4-6 -> claude-sonnet-5. This table is a\n# routing-policy fallback, NOT a pricing surface (grok F11): historical\n# pricing/replay tables keep the old ids. Every value MUST stay inside the\n# ADR-149 AVAILABLE_MODELS_WORKING_SET (tied by\n# test_adr149_validator_parity.py).\n_ADR_052_ROLE_TO_MODEL: Dict[str, str] = {\n    # Canonical-5 VETO archetypes — Opus floor per ADR-052 + ADR-080\n    \"code-reviewer\": \"claude-opus-5\",\n    \"security-engineer\": \"claude-opus-5\",\n    \"qa-architect\": \"claude-sonnet-5\",\n    \"performance-engineer\": \"claude-sonnet-5\",\n    # PLAN-169 W2.10 F8: bare id — the dated pin is not in availableModels\n    # and interacts badly with enforceAvailableModels.\n    \"devops\": \"claude-haiku-4-5\",\n    # Mitigated rail — general-purpose dispatch inherits CEO model.\n    # Default-CEO is Opus-tier unless CEO_MODEL_DOWNSHIFT is honored.\n    # ADR-149 Amendment 3 (S357): follows the session-default pin, now\n    # claude-opus-5-5. A POLICY value, not an observation: when the Task\n    # response carries no model (the common case, see _extract_model) the\n    # audit log records this row even if a per-call model or alias served\n    # the spawn.\n    \"general-purpose\": \"claude-opus-5-5\",\n    # Probe / specialty archetypes\n    \"growth-engineer\": \"claude-sonnet-5\",\n    \"billing-engineer\": \"claude-sonnet-5\",\n    \"compliance-specialist\": \"claude-sonnet-5\",\n    \"chaos-engineer\": \"claude-sonnet-5\",\n    \"data-engineer\": \"claude-sonnet-5\",\n    \"real-time-systems-engineer\": \"claude-sonnet-5\",\n    \"refactoring-lead\": \"claude-sonnet-5\",\n    \"vp-engineering\": \"claude-opus-5\",\n    \"vp-product\": \"claude-sonnet-5\",\n    \"vp-operations\": \"claude-sonnet-5\",\n    # PLAN-074 Wave 1c provenance — see docs/PLAN-086-adr-052-role-extension.md\n    # 4 VETO-floor archetypes added per PLAN-086 Wave B (R-019 ROLE_TO_MODEL ext).\n    # ADR-052 §Veto-floor expansion (lines 186-210) names these as VETO-floor;\n    # llm-finops-architect carries Opus floor for cost-ceiling integrity (see\n    # docs §2 §Why llm-finops-architect). ADR-052 bytes NOT mutated (anti-churn).\n    \"incident-commander\": \"claude-opus-5\",\n    \"identity-trust-architect\": \"claude-opus-5\",\n    \"threat-detection-engineer\": \"claude-opus-5\",\n    \"llm-finops-architect\": \"claude-opus-5\",\n}\n\n\ndef _resolve_dispatch_mode(\n    subagent_type: str,\n    rail: Optional[str],\n) -> Optional[str]:\n    \"\"\"PLAN-044 audit-v2 C3-P0-08 — Wave B: derive dispatch_mode field.\n\n    Maps (subagent_type, rail) → \"native\" | \"mitigated\" per the\n    PLAN-061 / ADR-082 dispatch policy:\n\n      - canonical-5 native rail → \"native\" (full tool grant per\n        ADR-052 floor; H4 anomaly does NOT apply because empirically\n        only `code-reviewer` is reliable; PLAN-061 default-on routes\n        the other 4 via mitigated).\n      - any non-canonical archetype → \"mitigated\" (general-purpose\n        with persona injected via `## SKILL CONTENT`).\n      - rail=None or unknown → None (legacy / pre-PLAN-061).\n\n    See ADR-082 §Routing decision and `inject-agent-context.sh` for\n    the live override matrix (CEO_DISPATCHER_MODE,\n    CEO_MITIGATION_DISABLE).\n    \"\"\"\n    if not isinstance(subagent_type, str):\n        return None\n    # Canonical-5 native rail — only code-reviewer routes natively\n    # by default per PLAN-061 / ADR-082. Other 4 are mitigated.\n    if subagent_type == \"code-reviewer\" and rail == \"native\":\n        return \"native\"\n    if subagent_type in _CANONICAL_5 and rail == \"custom\":\n        # Older inline ## SKILL CONTENT prompt — pre-PLAN-061 spawn.\n        return \"native_legacy\"\n    if rail is None:\n        return None\n    # Default mitigated rail for non-canonical-5 + non-cr canonicals\n    # under PLAN-061 default-on.\n    return \"mitigated\"\n\n\ndef _detect_rail(prompt: str, subagent_type: str) -> Optional[str]:\n    \"\"\"Detect spawn dispatch rail (native vs custom) from prompt + subagent.\n\n    Heuristic order:\n    1. If subagent_type matches a canonical-5 archetype name AND the\n       prompt has `## SKILL REFERENCE` sentinel → \"native\".\n    2. Else if prompt has `## SKILL CONTENT` (legacy inline) → \"custom\".\n    3. Else if prompt has `## SKILL REFERENCE` only → \"native\"\n       (subagent_type may be empty for some adapters).\n    4. Else None (unknown / pre-PLAN-020 / non-spawn event).\n    \"\"\"\n    if not isinstance(prompt, str):\n        return None\n    has_reference = bool(_SKILL_REFERENCE_RE.search(prompt))\n    has_content = bool(_SKILL_CONTENT_RE.search(prompt))\n    is_canonical = (\n        isinstance(subagent_type, str) and subagent_type in _CANONICAL_5\n    )\n\n    if is_canonical and has_reference:\n        return \"native\"\n    if has_content:\n        return \"custom\"\n    if has_reference:\n        return \"native\"\n    return None\n\n\n# -----------------------------------------------------------------------------\n# Rotation\n# -----------------------------------------------------------------------------\n\n\n","numLines":457,"startLine":1,"totalLines":457}},"tool_result_meta":[{"id":"toolu_01EwQHuXcqUsDRvJL3AjY28i","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
