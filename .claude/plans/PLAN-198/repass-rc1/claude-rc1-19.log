{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1MSm8h6Wa3R7RmigBna","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MxjPg5qAxsUEYCZVyM2L4J","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_spool_writer_parts/drain.py","offset":60,"limit":560},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":14080,"cache_read_input_tokens":185793,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":14080},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"b3808448-2c84-462e-9a23-e78bedff1e2a","timestamp":"2026-11-13T17:52:33.283Z","request_id":"req_011Ch1MSktJHpikQV8DJ2DW2","wire_tool_inputs":{"toolu_01MxjPg5qAxsUEYCZVyM2L4J":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_spool_writer_parts/drain.py","offset":60,"limit":560}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MxjPg5qAxsUEYCZVyM2L4J","type":"tool_result","content":"60\t# Combined with Wave A cache: per-emit 580us -> 425us (-27%). AC-C1 strict\n61\t# <=360us NOT hit alone; Wave C.1 RELAX path engaged (200->300ms test\n62\t# budget) with ubuntu projection ~255ms still well under.\n63\tDRAIN_TRIGGER_SIZE = 100\n64\tDRAIN_TRIGGER_MTIME_MS = 100\n65\tSTALE_SPOOL_TTL_DAYS = 7\n66\tSPOOL_LOCK_TIMEOUT = 2.5\n67\t\n68\t\n69\t__all__ = (\n70\t    '_phase4_build_batch',\n71\t    '_phase5_append_canonical',\n72\t    '_phase5_split_and_cleanup',\n73\t    '_journal_compact_drained',\n74\t)\n75\t\n76\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n77\tdef _phase4_build_batch(\n78\t    deduped: List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]],\n79\t    drain_epoch: str,\n80\t    in_recovery: bool,\n81\t    stats: DrainStats,\n82\t    starting_processed: int = 0,\n83\t) -> Tuple[List[bytes], List[_DrainingFile], Dict[str, Set[int]], Optional[bytes], List[Tuple[str, int]]]:\n84\t    \"\"\"Compute HMAC chain; produce canonical-log batch lines.\n85\t\n86\t    Returns (batch_line_bytes, fully_consumed_files,\n87\t    per_file_consumed_indices, last_hmac_bytes, drained_record_ids_by_pid).\n88\t\n89\t    iter2-P0-1: per_file_consumed is now Dict[str, Set[int]] (body indices,\n90\t    not a prefix-count). Phase 5 splits the remainder using the COMPLEMENT\n91\t    of the set — out-of-order index consumption (e.g. clock-skew rollback\n92\t    where a LATER body index sorts ahead of an EARLIER one and is cut by\n93\t    K_MAX) no longer trashes unprocessed earlier lines.\n94\t\n95\t    iter2-P1-1: idempotent-skip branch now ALSO appends (record_id, pid)\n96\t    to drained_ids and marks the index consumed — without this, the matching\n97\t    journal `commit` envelope stays as commit_no_drained forever (phantom\n98\t    inflight count in AC10).\n99\t\n100\t    iter2-P2-1: canonical output honors the SOURCE file's drain_epoch\n101\t    (src_file.drain_epoch) — important for forensic correlation when an\n102\t    in-recovery drain re-emits entries from a prior-cycle .draining file.\n103\t\n104\t    iter3-P0-1: K_MAX counts TOTAL PROCESSED entries (appended + idempotent\n105\t    skipped + intentionally consumed via tamper/duplicate paths), NOT just\n106\t    appended. Without this, repeated partial-crash cycles where each crash\n107\t    leaves K_MAX entries in .draining and the next drain hits all K_MAX as\n108\t    skipped + processes K_MAX fresh can accumulate >K_TAIL_WINDOW processed\n109\t    entries per cycle → entries fall out of the skip-guard tail window on\n110\t    a subsequent crash cycle → re-appended duplicates in canonical log.\n111\t    Capping TOTAL processed bounds disk-write + idempotent work per drain\n112\t    cycle so window-overflow cannot occur.\n113\t\n114\t    Honors K_MAX cap; remaining un-consumed entries are left for the next\n115\t    drain cycle via Phase 5 atomic split.\n116\t    \"\"\"\n117\t    log_path = _canonical_log_path()\n118\t\n119\t    # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.1 — Path B variant 1 hoist.\n120\t    # Probe rotation BEFORE reading canonical tail (and therefore before\n121\t    # computing prev_hmac), so this batch always anchors against the\n122\t    # CURRENT canonical file (post-rotation if applicable).\n123\t    #\n124\t    # Prior bug: Phase 4 read prev_hmac from the about-to-rotate file;\n125\t    # Phase 5 detected rotation but batch_lines were already HMAC-chained\n126\t    # against the old chain → verifier (resets at file boundary per\n127\t    # ADR-055 §2) saw STATUS_TAMPER at line 1 of the new file.\n128\t    # Per F-7.7 (PLAN-112 wave-c-bundles/C10) + D3 confirmation.\n129\t    # Fail-open: any rotation exception is breadcrumbed and the read\n130\t    # proceeds against whatever log path is current.\n131\t    try:\n132\t        from _lib import audit_emit as _audit_emit_lazy\n133\t        from _lib import audit_hmac as _audit_hmac_lazy\n134\t        # PLAN-143 item-2 (audit-errors-02): guard the rotation probe.\n135\t        # Under test/shim wiring the lazily-imported object can be an\n136\t        # _EmitCapture double that lacks _rotate_if_needed_safe; calling\n137\t        # it raised AttributeError into the fail-open except below, which\n138\t        # breadcrumbed cosmetic audit-log.errors noise and silently\n139\t        # skipped the probe. getattr-guard -> no attribute means \"no\n140\t        # rotation\" (None), taking the same intended branch without noise.\n141\t        _rotate_probe = getattr(\n142\t            _audit_emit_lazy, \"_rotate_if_needed_safe\", None\n143\t        )\n144\t        rotated_to_phase4 = (\n145\t            _rotate_probe(log_path) if callable(_rotate_probe) else None\n146\t        )\n147\t        if rotated_to_phase4 is not None and not _audit_hmac_lazy.is_disabled():\n148\t            try:\n149\t                _audit_hmac_lazy.reset_chain_on_rotation()\n150\t            except Exception as re:\n151\t                _breadcrumb(\n152\t                    f\"phase4 rotation HMAC reset failed: \"\n153\t                    f\"{type(re).__name__}: {re}\"\n154\t                )\n155\t            # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — emit\n156\t            # chain_reset_marker as line 1 of new file + manifest. Fail-open\n157\t            # (marker absence → verifier legacy mode, not tamper signal).\n158\t            try:\n159\t                _audit_emit_lazy._emit_chain_reset_marker_under_lock(\n160\t                    log=log_path,\n161\t                    previous_archive_path=str(rotated_to_phase4),\n162\t                    rotation_trigger=\"size_threshold\",\n163\t                )\n164\t            except Exception as me:\n165\t                _breadcrumb(\n166\t                    f\"phase4 chain_reset_marker emit failed: \"\n167\t                    f\"{type(me).__name__}: {me}\"\n168\t                )\n169\t    except Exception as e:\n170\t        # Fail-open: rotation probe never blocks the canonical read.\n171\t        _breadcrumb(f\"phase4 rotation probe failed: {type(e).__name__}: {e}\")\n172\t\n173\t    # AFTER rotation probe: read tail from (now-current) file.\n174\t    prev_hmac, tail_entries = _read_canonical_tail(log_path, K_TAIL_WINDOW)\n175\t    drain_sha_set: set = set()\n176\t    for e in tail_entries:\n177\t        ds = e.get(\"_drain_sha256\")\n178\t        if isinstance(ds, str) and len(ds) == 64:\n179\t            drain_sha_set.add(ds)\n180\t\n181\t    if _HMAC_AVAILABLE and _audit_hmac is not None and prev_hmac is None:\n182\t        # Empty log + HMAC available → genesis (which is correct\n183\t        # post-rotation since the new file is empty).\n184\t        prev_hmac = _audit_hmac.GENESIS_PREV\n185\t\n186\t    batch_lines: List[bytes] = []\n187\t    # iter2-P0-1: set-of-indices, not prefix-count.\n188\t    per_file_consumed: Dict[str, Set[int]] = {}\n189\t    drained_ids: List[Tuple[str, int]] = []  # P1-3: (record_id, pid)\n190\t    last_hmac: Optional[bytes] = prev_hmac\n191\t\n192\t    def _mark(path_str: str, idx: int) -> None:\n193\t        per_file_consumed.setdefault(path_str, set()).add(idx)\n194\t\n195\t    # iter3-P0-1: cap on TOTAL processed (appended + idempotent_skipped +\n196\t    # tamper-consumed); breaking on appended-only allowed cumulative\n197\t    # processed > K_TAIL_WINDOW across recovery cycles → window overflow.\n198\t    # iter4-P2-2: `starting_processed` carries duplicate-cleanup count from\n199\t    # Phase 3 so combined Phase-3 + Phase-4 work ≤ K_MAX per drain cycle.\n200\t    processed = starting_processed\n201\t    for key, entry, src_file, body_idx in deduped:\n202\t        if processed >= K_MAX:\n203\t            break\n204\t        path_key = str(src_file.path)\n205\t\n206\t        # P1-3: pull record_id off the spool entry BEFORE stripping internal\n207\t        # fields so we can emit op:\"drained\" with the matching id.\n208\t        rec_id = entry.get(\"record_id\")\n209\t\n210\t        entry_clean = {\n211\t            k: v for k, v in entry.items()\n212\t            if not (isinstance(k, str) and k.startswith(\"_drain_\"))\n213\t            and k != \"hmac\" and k != \"hmac_error\"\n214\t        }\n215\t        try:\n216\t            sha = _sha256_of_canonical_json(entry_clean)\n217\t        except Exception as e:\n218\t            _breadcrumb(f\"sha compute failed: {type(e).__name__}: {e}\")\n219\t            # Treat unencodable entry like a tamper — skip + count\n220\t            stats.partial_lines_discarded += 1\n221\t            _mark(path_key, body_idx)\n222\t            # iter3-P0-1: tamper-consumed counts toward K_MAX budget\n223\t            processed += 1\n224\t            continue\n225\t\n226\t        if sha in drain_sha_set:\n227\t            stats.skipped_idempotent += 1\n228\t            severity = \"INFORMATIONAL\" if in_recovery else \"ALARM\"\n229\t            _forensic(\"audit_spool_unexpected_skip\", {\n230\t                \"drain_epoch\": drain_epoch,\n231\t                \"spool_uuid\": key[2],\n232\t                \"ordinal_within_file\": key[3],\n233\t                \"skipped_sha256\": sha,\n234\t                \"drain_in_recovery_mode\": in_recovery,\n235\t                \"severity\": severity,\n236\t            })\n237\t            _mark(path_key, body_idx)\n238\t            # iter2-P1-1: also commit drained_id so the journal compactor\n239\t            # emits op:\"drained\" for this record. Without this, the matching\n240\t            # `commit` envelope stays as commit_no_drained forever in the\n241\t            # journal (AC10 phantom inflight). The canonical batch line was\n242\t            # already appended on the prior crashed drain — this entry is\n243\t            # \"drained\" from the journal's perspective even though we are\n244\t            # not re-appending the bytes this cycle.\n245\t            if isinstance(rec_id, str) and rec_id:\n246\t                drained_ids.append((rec_id, src_file.pid))\n247\t            # iter3-P0-1: idempotent-skip counts toward K_MAX budget so\n248\t            # window-overflow on multi-crash cycles is structurally\n249\t            # impossible (processed ≤ K_MAX < K_TAIL_WINDOW).\n250\t            processed += 1\n251\t            continue\n252\t\n253\t        chained = dict(entry_clean)\n254\t        chained[\"_drain_sha256\"] = sha\n255\t        # iter2-P2-1: honor source file's drain_epoch for forensic\n256\t        # correlation (this entry was first staged in that cycle).\n257\t        chained[\"_drain_epoch\"] = src_file.drain_epoch\n258\t\n259\t        if (_HMAC_AVAILABLE and _audit_hmac is not None\n260\t                and not _audit_hmac.is_disabled()):\n261\t            try:\n262\t                key_bytes = _audit_hmac.get_or_create_key()\n263\t                digest = _audit_hmac.compute_entry_hmac(\n264\t                    key_bytes,\n265\t                    last_hmac if last_hmac is not None else _audit_hmac.GENESIS_PREV,\n266\t                    chained,\n267\t                )\n268\t                chained[\"hmac\"] = digest.hex()\n269\t                last_hmac = digest\n270\t            except _audit_hmac.AuditProducerPathPollutionError as ppe:\n271\t                # PLAN-118 AC-B4 chokepoint 4 / recursion-safety case 5 —\n272\t                # the spool fast-path (audit_emit._write_event line 1760)\n273\t                # appends to spool BEFORE local HMAC computation; the\n274\t                # HMAC is then computed HERE at drain time. On\n275\t                # canonical-resolution mismatch at drain: refuse to\n276\t                # compute HMAC for the batch entry; normalize the entry\n277\t                # to hmac:null + closed-enum hmac_error BEFORE the entry\n278\t                # is appended to the chain (so polluted HMACs never enter\n279\t                # the chain at all). Emit AC-B5 breadcrumb with\n280\t                # chokepoint=spool_drain (safe — the typed emitter's own\n281\t                # _write_event call will also trigger this same\n282\t                # exception and recurse-fail-OPEN through the same\n283\t                # channel; the breadcrumb's purpose is exactly that\n284\t                # forensic signal).\n285\t                chained[\"hmac\"] = None\n286\t                chained[\"hmac_error\"] = \"producer_path_pollution_detected\"\n287\t                _breadcrumb(\n288\t                    f\"hmac_error: producer_path_pollution_detected \"\n289\t                    f\"(chokepoint=spool_drain): {ppe}\"\n290\t                )\n291\t                # Parse the exception payload for the AC-B5 breadcrumb.\n292\t                try:\n293\t                    _msg = str(ppe)\n294\t                    _rc = \"audit_emit_path_pollution\"\n295\t                    _psp = \"[REDACTED:rg]\"\n296\t                    _ecp = \"[REDACTED:rg]\"\n297\t                    _valid_rcs = (\n298\t                        \"audit_emit_path_pollution\",\n299\t                        \"canonical_json_path_pollution\",\n300\t                        \"audit_hmac_path_pollution\",\n301\t                    )\n302\t                    for _tok in _msg.split():\n303\t                        if _tok.startswith(\"reason_code=\"):\n304\t                            _cand = _tok.split(\"=\", 1)[1]\n305\t                            if _cand in _valid_rcs:\n306\t                                _rc = _cand\n307\t                        elif _tok.startswith(\"path_sha256_prefix=\"):\n308\t                            _cand = _tok.split(\"=\", 1)[1]\n309\t                            if len(_cand) == 8 and all(c in \"0123456789abcdef\" for c in _cand):\n310\t                                _psp = _cand\n311\t                        elif _tok.startswith(\"expected_canonical_prefix=\"):\n312\t                            _cand = _tok.split(\"=\", 1)[1]\n313\t                            if len(_cand) == 8 and all(c in \"0123456789abcdef\" for c in _cand):\n314\t                                _ecp = _cand\n315\t                    # Lazy-import the typed emitter to avoid circular import\n316\t                    # at module load (spool_writer is imported from audit_emit).\n317\t                    from _lib import audit_emit as _audit_emit\n318\t                    _audit_emit.emit_audit_producer_path_pollution_detected(\n319\t                        chokepoint=\"spool_drain\",\n320\t                        reason_code=_rc,\n321\t                        path_sha256_prefix=_psp,\n322\t                        expected_canonical_prefix=_ecp,\n323\t                    )\n324\t                except Exception as _be:  # pragma: no cover\n325\t                    _breadcrumb(\n326\t                        f\"AC-B5 spool_drain breadcrumb emit failed: \"\n327\t                        f\"{type(_be).__name__}: {_be}\"\n328\t                    )\n329\t            except Exception as e:\n330\t                chained[\"hmac\"] = None\n331\t                chained[\"hmac_error\"] = f\"{type(e).__name__}: {e}\"\n332\t                _breadcrumb(f\"hmac compute failed: {type(e).__name__}: {e}\")\n333\t\n334\t        try:\n335\t            line = json.dumps(\n336\t                chained, separators=(\",\", \":\"), ensure_ascii=False,\n337\t            ).encode(\"utf-8\") + b\"\\n\"\n338\t        except (TypeError, ValueError) as e:\n339\t            _breadcrumb(f\"phase4 encode failed: {type(e).__name__}: {e}\")\n340\t            _mark(path_key, body_idx)\n341\t            # iter3-P0-1: encode-failure consumed counts toward K_MAX.\n342\t            processed += 1\n343\t            continue\n344\t        batch_lines.append(line)\n345\t        _mark(path_key, body_idx)\n346\t        # P1-3: track for op:\"drained\" envelope emission\n347\t        if isinstance(rec_id, str) and rec_id:\n348\t            drained_ids.append((rec_id, src_file.pid))\n349\t        # iter3-P0-1: append counts toward K_MAX (was: `appended += 1`).\n350\t        processed += 1\n351\t\n352\t    fully_consumed: List[_DrainingFile] = []\n353\t    return batch_lines, fully_consumed, per_file_consumed, last_hmac, drained_ids\n354\t\n355\t\n356\t# ---------------------------------------------------------------------------\n357\t# Phase 5 — atomic append + split + cleanup\n358\t# ---------------------------------------------------------------------------\n359\t\n360\t\n361\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n362\tdef _phase5_append_canonical(\n363\t    batch_lines: List[bytes], last_hmac: Optional[bytes]\n364\t) -> int:\n365\t    \"\"\"Append batch to canonical log; single fsync; update sidecar cache.\n366\t\n367\t    iter2-P2-3: chain_length sidecar increment counts HMAC-bearing lines\n368\t    only — entries that failed HMAC compute (hmac=null + hmac_error set)\n369\t    don't extend the chain even though their bytes are appended. The\n370\t    sidecar is a cache for chain-verify performance; counting null-hmac\n371\t    lines would diverge from the true HMAC chain length.\n372\t    \"\"\"\n373\t    if not batch_lines:\n374\t        return 0\n375\t    log_path = _canonical_log_path()\n376\t    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n377\t\n378\t    # PLAN-094-FOLLOWUP Wave A.3-rotation — probe rotation BEFORE the\n379\t    # canonical append so spool-drained writes never accumulate past the\n380\t    # configured threshold. Lazy-import audit_emit (circular dep at\n381\t    # module load time) + audit_hmac for chain reset.\n382\t    try:\n383\t        from _lib import audit_emit as _audit_emit_lazy\n384\t        from _lib import audit_hmac as _audit_hmac_lazy\n385\t        # PLAN-143 item-2 (audit-errors-02): guard the rotation probe — a\n386\t        # capture-shim object may lack _rotate_if_needed_safe (see the\n387\t        # phase-4 probe above). getattr-guard -> missing attribute means\n388\t        # \"no rotation\" (None), no AttributeError into the fail-open path.\n389\t        _rotate_probe = getattr(\n390\t            _audit_emit_lazy, \"_rotate_if_needed_safe\", None\n391\t        )\n392\t        rotated_to = (\n393\t            _rotate_probe(log_path) if callable(_rotate_probe) else None\n394\t        )\n395\t        if rotated_to is not None and not _audit_hmac_lazy.is_disabled():\n396\t            try:\n397\t                _audit_hmac_lazy.reset_chain_on_rotation()\n398\t                # Reset last_hmac so this batch re-anchors at genesis.\n399\t                last_hmac = None\n400\t            except Exception as re:\n401\t                _breadcrumb(\n402\t                    f\"phase5 rotation HMAC reset failed: \"\n403\t                    f\"{type(re).__name__}: {re}\"\n404\t                )\n405\t    except Exception as e:\n406\t        # Fail-open: rotation probe never blocks the canonical append.\n407\t        _breadcrumb(f\"phase5 rotation probe failed: {type(e).__name__}: {e}\")\n408\t\n409\t    payload = b\"\".join(batch_lines)\n410\t    fd = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)\n411\t    try:\n412\t        os.write(fd, payload)\n413\t        os.fsync(fd)\n414\t    finally:\n415\t        os.close(fd)\n416\t\n417\t    if (_HMAC_AVAILABLE and _audit_hmac is not None\n418\t            and not _audit_hmac.is_disabled()\n419\t            and last_hmac is not None\n420\t            and len(last_hmac) == _audit_hmac.HMAC_BYTES):\n421\t        try:\n422\t            _audit_hmac.write_last_hmac(last_hmac)\n423\t        except Exception as e:\n424\t            _breadcrumb(f\"write_last_hmac failed: {type(e).__name__}: {e}\")\n425\t        # iter2-P2-3: count HMAC-bearing lines only.\n426\t        hmac_bearing = 0\n427\t        for line in batch_lines:\n428\t            try:\n429\t                obj = json.loads(line.rstrip(b\"\\n\").decode(\"utf-8\"))\n430\t            except (json.JSONDecodeError, UnicodeDecodeError):\n431\t                continue\n432\t            if not isinstance(obj, dict):\n433\t                continue\n434\t            hx = obj.get(\"hmac\")\n435\t            if isinstance(hx, str) and len(hx) == 64:\n436\t                hmac_bearing += 1\n437\t        try:\n438\t            current = _audit_hmac.read_chain_length()\n439\t            _audit_hmac.write_chain_length(current + hmac_bearing)\n440\t        except Exception as e:\n441\t            _breadcrumb(f\"chain_length update failed: {type(e).__name__}: {e}\")\n442\t    return len(batch_lines)\n443\t\n444\t\n445\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n446\tdef _phase5_split_and_cleanup(\n447\t    files: List[_DrainingFile],\n448\t    per_file_consumed: Dict[str, Set[int]],\n449\t    drain_epoch: str,\n450\t    stats: DrainStats,\n451\t) -> None:\n452\t    \"\"\"For each draining file: unlink if fully consumed; else atomic-split.\n453\t\n454\t    iter2-P0-1: per_file_consumed is a Set[int] of body INDICES. The\n455\t    remainder file is built from the COMPLEMENT (all body indices NOT in\n456\t    the set). This correctly handles out-of-order index consumption (e.g.\n457\t    wall_ns clock-skew rollback where a later body index sorts BEFORE an\n458\t    earlier one and is cut by K_MAX) — prefix-based cleanup would have\n459\t    discarded unprocessed earlier lines.\n460\t\n461\t    iter2-P0-3: SKIP any _DrainingFile whose .quarantined flag is set —\n462\t    the file is already renamed to .malformed.<epoch>; trying to split\n463\t    or unlink the original path would either fail (ENOENT) or, worse,\n464\t    re-sweep the renamed quarantined file on a subsequent drain.\n465\t\n466\t    iter2-P1-3: when splitting, mint a NEW drain_epoch for the destination\n467\t    so dst path != src path. This closes the `.split.tmp` two-step window\n468\t    (old code reused src epoch → dst==src → os.rename(src,dst) no-op AND\n469\t    the temp suffix dance remained). Now: tmp → fsync → rename(tmp,\n470\t    new_dst) atomic; unlink(src). Single window if rename succeeds.\n471\t\n472\t    P2-4: header is written VERBATIM from file.header_raw — no JSON\n473\t    re-encode (preserves byte identity of _spool_uuid sentinel chain).\n474\t    \"\"\"\n475\t    for f in files:\n476\t        # iter2-P0-3: skip quarantined files — original path doesn't exist\n477\t        # at .draining.<epoch> anymore; it was renamed to .malformed.<epoch>.\n478\t        if f.quarantined:\n479\t            continue\n480\t        path_key = str(f.path)\n481\t        if f.header is None and not f.body_lines:\n482\t            # Already empty (no body) — just unlink the (header-only) file.\n483\t            try:\n484\t                if f.path.exists():\n485\t                    os.unlink(str(f.path))\n486\t            except OSError:\n487\t                pass\n488\t            continue\n489\t        consumed_set = per_file_consumed.get(path_key, set())\n490\t        total = len(f.body_lines)\n491\t        # iter2-P0-1: fully consumed iff every body index is in the set.\n492\t        if total == 0 or all(i in consumed_set for i in range(total)):\n493\t            try:\n494\t                os.unlink(str(f.path))\n495\t                stats.files_consumed_fully += 1\n496\t            except OSError as e:\n497\t                _breadcrumb(f\"phase5 unlink failed: {type(e).__name__}: {e}\")\n498\t            continue\n499\t\n500\t        # iter2-P1-3: mint a NEW epoch for the split destination so\n501\t        # dst_path differs from src_path; this collapses the prior\n502\t        # two-step `.split.tmp` rename dance into a single rename+unlink.\n503\t        new_epoch = secrets.token_hex(4)\n504\t        tmp_token = secrets.token_hex(4)\n505\t        # tmp is a sibling .tmp.<token> for atomic create+rename within same dir\n506\t        tmp_path = f.path.with_name(f.path.name + _TMP_SUFFIX_TOKEN + tmp_token)\n507\t        try:\n508\t            # P2-4: verbatim header bytes — no JSON re-encode\n509\t            header_line = f.header_raw if f.header_raw else (\n510\t                json.dumps(\n511\t                    f.header, separators=(\",\", \":\"), ensure_ascii=False,\n512\t                ).encode(\"utf-8\") + b\"\\n\"\n513\t            )\n514\t            # iter2-P0-1: rebuild remainder using COMPLEMENT of consumed_set\n515\t            # (NOT a prefix slice). Empty lines are preserved as empty bytes\n516\t            # in body_lines and re-emitted with the newline separator below.\n517\t            remainder_lines = [\n518\t                f.body_lines[i] for i in range(total) if i not in consumed_set\n519\t            ]\n520\t            body_remainder = b\"\\n\".join(remainder_lines)\n521\t            if body_remainder and not body_remainder.endswith(b\"\\n\"):\n522\t                body_remainder += b\"\\n\"\n523\t            fd = os.open(\n524\t                str(tmp_path),\n525\t                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_TRUNC,\n526\t                0o600,\n527\t            )\n528\t            try:\n529\t                os.write(fd, header_line)\n530\t                if body_remainder:\n531\t                    os.write(fd, body_remainder)\n532\t                os.fsync(fd)\n533\t            finally:\n534\t                os.close(fd)\n535\t            # iter2-P1-3: dst is .draining.<new_epoch> — distinct from src.\n536\t            dst_path = _draining_path(_spool_path(f.pid), new_epoch)\n537\t            # Single atomic rename + unlink source. If rename fails, the\n538\t            # tmp file is cleaned up in the except branch.\n539\t            os.rename(str(tmp_path), str(dst_path))\n540\t            try:\n541\t                os.unlink(str(f.path))\n542\t            except OSError as e:  # pragma: no cover\n543\t                # Source gone (race / already cleaned); rename succeeded so\n544\t                # the remainder file is correctly in place.\n545\t                _breadcrumb(\n546\t                    f\"phase5 src unlink after split failed: \"\n547\t                    f\"{type(e).__name__}: {e}\"\n548\t                )\n549\t            stats.files_split_remainder += 1\n550\t        except OSError as e:\n551\t            _breadcrumb(f\"phase5 split failed: {type(e).__name__}: {e}\")\n552\t            try:\n553\t                if tmp_path.exists():\n554\t                    os.unlink(str(tmp_path))\n555\t            except OSError:\n556\t                pass\n557\t\n558\t\n559\t# ---------------------------------------------------------------------------\n560\t# Journal post-drain compaction\n561\t# ---------------------------------------------------------------------------\n562\t\n563\t\n564\tdef _journal_compact_drained(\n565\t    pid: int,\n566\t    drained_record_ids: Iterable[str],\n567\t    drain_epoch: str,\n568\t) -> None:\n569\t    \"\"\"Append op=drained envelopes; rewrite journal dropping fully-completed triples.\n570\t\n571\t    P1-3: emits op:\"drained\" envelopes with the actual record_id so\n572\t    session-start reconciliation can distinguish recovered from inflight.\n573\t    \"\"\"\n574\t    drained_set = {r for r in drained_record_ids if isinstance(r, str) and r}\n575\t    if not drained_set:\n576\t        return\n577\t    # Flush any pending in-memory journal envelopes for this PID FIRST so\n578\t    # the compaction read sees a consistent on-disk view.\n579\t    _flush_journal_buffer(pid)\n580\t    journal = _journal_path(pid)\n581\t    if not journal.exists():\n582\t        return\n583\t    # 1) Append drained envelopes via the buffer (then flush)\n584\t    for rid in drained_set:\n585\t        _write_journal_envelope(\n586\t            pid, rid, \"\", -1, \"\", \"drained\", drain_epoch=drain_epoch,\n587\t        )\n588\t    _flush_journal_buffer(pid)\n589\t    # 2) Rewrite journal under per-PID journal flock dropping rows whose\n590\t    # record_id is in drained_set (begin/commit/drained triples collapse).\n591\t    try:\n592\t        with FileLock(_journal_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT):\n593\t            with journal.open(\"r\", encoding=\"utf-8\") as f:\n594\t                keep_lines: List[str] = []\n595\t                for raw in f:\n596\t                    stripped = raw.strip()\n597\t                    if not stripped:\n598\t                        continue\n599\t                    try:\n600\t                        env = json.loads(stripped)\n601\t                    except json.JSONDecodeError:\n602\t                        keep_lines.append(raw)\n603\t                        continue\n604\t                    if (isinstance(env, dict)\n605\t                            and env.get(\"record_id\") in drained_set):\n606\t                        continue\n607\t                    keep_lines.append(raw)\n608\t            tmp = journal.with_name(journal.name + \".compact.tmp\")\n609\t            with tmp.open(\"w\", encoding=\"utf-8\") as f:\n610\t                f.writelines(keep_lines)\n611\t                f.flush()\n612\t                os.fsync(f.fileno())\n613\t            os.replace(str(tmp), str(journal))\n614\t    except FileLockTimeout:\n615\t        _breadcrumb(f\"journal compact flock timeout pid={pid}\")\n616\t    except OSError as e:\n617\t        _breadcrumb(f\"journal compact failed: {type(e).__name__}: {e}\")\n618\t\n619\t"}]},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"6140ad91-193d-41ae-b7b9-11336b9c23d8","timestamp":"2026-11-13T17:52:33.545Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_spool_writer_parts/drain.py","content":"# Combined with Wave A cache: per-emit 580us -> 425us (-27%). AC-C1 strict\n# <=360us NOT hit alone; Wave C.1 RELAX path engaged (200->300ms test\n# budget) with ubuntu projection ~255ms still well under.\nDRAIN_TRIGGER_SIZE = 100\nDRAIN_TRIGGER_MTIME_MS = 100\nSTALE_SPOOL_TTL_DAYS = 7\nSPOOL_LOCK_TIMEOUT = 2.5\n\n\n__all__ = (\n    '_phase4_build_batch',\n    '_phase5_append_canonical',\n    '_phase5_split_and_cleanup',\n    '_journal_compact_drained',\n)\n\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef _phase4_build_batch(\n    deduped: List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]],\n    drain_epoch: str,\n    in_recovery: bool,\n    stats: DrainStats,\n    starting_processed: int = 0,\n) -> Tuple[List[bytes], List[_DrainingFile], Dict[str, Set[int]], Optional[bytes], List[Tuple[str, int]]]:\n    \"\"\"Compute HMAC chain; produce canonical-log batch lines.\n\n    Returns (batch_line_bytes, fully_consumed_files,\n    per_file_consumed_indices, last_hmac_bytes, drained_record_ids_by_pid).\n\n    iter2-P0-1: per_file_consumed is now Dict[str, Set[int]] (body indices,\n    not a prefix-count). Phase 5 splits the remainder using the COMPLEMENT\n    of the set — out-of-order index consumption (e.g. clock-skew rollback\n    where a LATER body index sorts ahead of an EARLIER one and is cut by\n    K_MAX) no longer trashes unprocessed earlier lines.\n\n    iter2-P1-1: idempotent-skip branch now ALSO appends (record_id, pid)\n    to drained_ids and marks the index consumed — without this, the matching\n    journal `commit` envelope stays as commit_no_drained forever (phantom\n    inflight count in AC10).\n\n    iter2-P2-1: canonical output honors the SOURCE file's drain_epoch\n    (src_file.drain_epoch) — important for forensic correlation when an\n    in-recovery drain re-emits entries from a prior-cycle .draining file.\n\n    iter3-P0-1: K_MAX counts TOTAL PROCESSED entries (appended + idempotent\n    skipped + intentionally consumed via tamper/duplicate paths), NOT just\n    appended. Without this, repeated partial-crash cycles where each crash\n    leaves K_MAX entries in .draining and the next drain hits all K_MAX as\n    skipped + processes K_MAX fresh can accumulate >K_TAIL_WINDOW processed\n    entries per cycle → entries fall out of the skip-guard tail window on\n    a subsequent crash cycle → re-appended duplicates in canonical log.\n    Capping TOTAL processed bounds disk-write + idempotent work per drain\n    cycle so window-overflow cannot occur.\n\n    Honors K_MAX cap; remaining un-consumed entries are left for the next\n    drain cycle via Phase 5 atomic split.\n    \"\"\"\n    log_path = _canonical_log_path()\n\n    # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.1 — Path B variant 1 hoist.\n    # Probe rotation BEFORE reading canonical tail (and therefore before\n    # computing prev_hmac), so this batch always anchors against the\n    # CURRENT canonical file (post-rotation if applicable).\n    #\n    # Prior bug: Phase 4 read prev_hmac from the about-to-rotate file;\n    # Phase 5 detected rotation but batch_lines were already HMAC-chained\n    # against the old chain → verifier (resets at file boundary per\n    # ADR-055 §2) saw STATUS_TAMPER at line 1 of the new file.\n    # Per F-7.7 (PLAN-112 wave-c-bundles/C10) + D3 confirmation.\n    # Fail-open: any rotation exception is breadcrumbed and the read\n    # proceeds against whatever log path is current.\n    try:\n        from _lib import audit_emit as _audit_emit_lazy\n        from _lib import audit_hmac as _audit_hmac_lazy\n        # PLAN-143 item-2 (audit-errors-02): guard the rotation probe.\n        # Under test/shim wiring the lazily-imported object can be an\n        # _EmitCapture double that lacks _rotate_if_needed_safe; calling\n        # it raised AttributeError into the fail-open except below, which\n        # breadcrumbed cosmetic audit-log.errors noise and silently\n        # skipped the probe. getattr-guard -> no attribute means \"no\n        # rotation\" (None), taking the same intended branch without noise.\n        _rotate_probe = getattr(\n            _audit_emit_lazy, \"_rotate_if_needed_safe\", None\n        )\n        rotated_to_phase4 = (\n            _rotate_probe(log_path) if callable(_rotate_probe) else None\n        )\n        if rotated_to_phase4 is not None and not _audit_hmac_lazy.is_disabled():\n            try:\n                _audit_hmac_lazy.reset_chain_on_rotation()\n            except Exception as re:\n                _breadcrumb(\n                    f\"phase4 rotation HMAC reset failed: \"\n                    f\"{type(re).__name__}: {re}\"\n                )\n            # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — emit\n            # chain_reset_marker as line 1 of new file + manifest. Fail-open\n            # (marker absence → verifier legacy mode, not tamper signal).\n            try:\n                _audit_emit_lazy._emit_chain_reset_marker_under_lock(\n                    log=log_path,\n                    previous_archive_path=str(rotated_to_phase4),\n                    rotation_trigger=\"size_threshold\",\n                )\n            except Exception as me:\n                _breadcrumb(\n                    f\"phase4 chain_reset_marker emit failed: \"\n                    f\"{type(me).__name__}: {me}\"\n                )\n    except Exception as e:\n        # Fail-open: rotation probe never blocks the canonical read.\n        _breadcrumb(f\"phase4 rotation probe failed: {type(e).__name__}: {e}\")\n\n    # AFTER rotation probe: read tail from (now-current) file.\n    prev_hmac, tail_entries = _read_canonical_tail(log_path, K_TAIL_WINDOW)\n    drain_sha_set: set = set()\n    for e in tail_entries:\n        ds = e.get(\"_drain_sha256\")\n        if isinstance(ds, str) and len(ds) == 64:\n            drain_sha_set.add(ds)\n\n    if _HMAC_AVAILABLE and _audit_hmac is not None and prev_hmac is None:\n        # Empty log + HMAC available → genesis (which is correct\n        # post-rotation since the new file is empty).\n        prev_hmac = _audit_hmac.GENESIS_PREV\n\n    batch_lines: List[bytes] = []\n    # iter2-P0-1: set-of-indices, not prefix-count.\n    per_file_consumed: Dict[str, Set[int]] = {}\n    drained_ids: List[Tuple[str, int]] = []  # P1-3: (record_id, pid)\n    last_hmac: Optional[bytes] = prev_hmac\n\n    def _mark(path_str: str, idx: int) -> None:\n        per_file_consumed.setdefault(path_str, set()).add(idx)\n\n    # iter3-P0-1: cap on TOTAL processed (appended + idempotent_skipped +\n    # tamper-consumed); breaking on appended-only allowed cumulative\n    # processed > K_TAIL_WINDOW across recovery cycles → window overflow.\n    # iter4-P2-2: `starting_processed` carries duplicate-cleanup count from\n    # Phase 3 so combined Phase-3 + Phase-4 work ≤ K_MAX per drain cycle.\n    processed = starting_processed\n    for key, entry, src_file, body_idx in deduped:\n        if processed >= K_MAX:\n            break\n        path_key = str(src_file.path)\n\n        # P1-3: pull record_id off the spool entry BEFORE stripping internal\n        # fields so we can emit op:\"drained\" with the matching id.\n        rec_id = entry.get(\"record_id\")\n\n        entry_clean = {\n            k: v for k, v in entry.items()\n            if not (isinstance(k, str) and k.startswith(\"_drain_\"))\n            and k != \"hmac\" and k != \"hmac_error\"\n        }\n        try:\n            sha = _sha256_of_canonical_json(entry_clean)\n        except Exception as e:\n            _breadcrumb(f\"sha compute failed: {type(e).__name__}: {e}\")\n            # Treat unencodable entry like a tamper — skip + count\n            stats.partial_lines_discarded += 1\n            _mark(path_key, body_idx)\n            # iter3-P0-1: tamper-consumed counts toward K_MAX budget\n            processed += 1\n            continue\n\n        if sha in drain_sha_set:\n            stats.skipped_idempotent += 1\n            severity = \"INFORMATIONAL\" if in_recovery else \"ALARM\"\n            _forensic(\"audit_spool_unexpected_skip\", {\n                \"drain_epoch\": drain_epoch,\n                \"spool_uuid\": key[2],\n                \"ordinal_within_file\": key[3],\n                \"skipped_sha256\": sha,\n                \"drain_in_recovery_mode\": in_recovery,\n                \"severity\": severity,\n            })\n            _mark(path_key, body_idx)\n            # iter2-P1-1: also commit drained_id so the journal compactor\n            # emits op:\"drained\" for this record. Without this, the matching\n            # `commit` envelope stays as commit_no_drained forever in the\n            # journal (AC10 phantom inflight). The canonical batch line was\n            # already appended on the prior crashed drain — this entry is\n            # \"drained\" from the journal's perspective even though we are\n            # not re-appending the bytes this cycle.\n            if isinstance(rec_id, str) and rec_id:\n                drained_ids.append((rec_id, src_file.pid))\n            # iter3-P0-1: idempotent-skip counts toward K_MAX budget so\n            # window-overflow on multi-crash cycles is structurally\n            # impossible (processed ≤ K_MAX < K_TAIL_WINDOW).\n            processed += 1\n            continue\n\n        chained = dict(entry_clean)\n        chained[\"_drain_sha256\"] = sha\n        # iter2-P2-1: honor source file's drain_epoch for forensic\n        # correlation (this entry was first staged in that cycle).\n        chained[\"_drain_epoch\"] = src_file.drain_epoch\n\n        if (_HMAC_AVAILABLE and _audit_hmac is not None\n                and not _audit_hmac.is_disabled()):\n            try:\n                key_bytes = _audit_hmac.get_or_create_key()\n                digest = _audit_hmac.compute_entry_hmac(\n                    key_bytes,\n                    last_hmac if last_hmac is not None else _audit_hmac.GENESIS_PREV,\n                    chained,\n                )\n                chained[\"hmac\"] = digest.hex()\n                last_hmac = digest\n            except _audit_hmac.AuditProducerPathPollutionError as ppe:\n                # PLAN-118 AC-B4 chokepoint 4 / recursion-safety case 5 —\n                # the spool fast-path (audit_emit._write_event line 1760)\n                # appends to spool BEFORE local HMAC computation; the\n                # HMAC is then computed HERE at drain time. On\n                # canonical-resolution mismatch at drain: refuse to\n                # compute HMAC for the batch entry; normalize the entry\n                # to hmac:null + closed-enum hmac_error BEFORE the entry\n                # is appended to the chain (so polluted HMACs never enter\n                # the chain at all). Emit AC-B5 breadcrumb with\n                # chokepoint=spool_drain (safe — the typed emitter's own\n                # _write_event call will also trigger this same\n                # exception and recurse-fail-OPEN through the same\n                # channel; the breadcrumb's purpose is exactly that\n                # forensic signal).\n                chained[\"hmac\"] = None\n                chained[\"hmac_error\"] = \"producer_path_pollution_detected\"\n                _breadcrumb(\n                    f\"hmac_error: producer_path_pollution_detected \"\n                    f\"(chokepoint=spool_drain): {ppe}\"\n                )\n                # Parse the exception payload for the AC-B5 breadcrumb.\n                try:\n                    _msg = str(ppe)\n                    _rc = \"audit_emit_path_pollution\"\n                    _psp = \"[REDACTED:rg]\"\n                    _ecp = \"[REDACTED:rg]\"\n                    _valid_rcs = (\n                        \"audit_emit_path_pollution\",\n                        \"canonical_json_path_pollution\",\n                        \"audit_hmac_path_pollution\",\n                    )\n                    for _tok in _msg.split():\n                        if _tok.startswith(\"reason_code=\"):\n                            _cand = _tok.split(\"=\", 1)[1]\n                            if _cand in _valid_rcs:\n                                _rc = _cand\n                        elif _tok.startswith(\"path_sha256_prefix=\"):\n                            _cand = _tok.split(\"=\", 1)[1]\n                            if len(_cand) == 8 and all(c in \"0123456789abcdef\" for c in _cand):\n                                _psp = _cand\n                        elif _tok.startswith(\"expected_canonical_prefix=\"):\n                            _cand = _tok.split(\"=\", 1)[1]\n                            if len(_cand) == 8 and all(c in \"0123456789abcdef\" for c in _cand):\n                                _ecp = _cand\n                    # Lazy-import the typed emitter to avoid circular import\n                    # at module load (spool_writer is imported from audit_emit).\n                    from _lib import audit_emit as _audit_emit\n                    _audit_emit.emit_audit_producer_path_pollution_detected(\n                        chokepoint=\"spool_drain\",\n                        reason_code=_rc,\n                        path_sha256_prefix=_psp,\n                        expected_canonical_prefix=_ecp,\n                    )\n                except Exception as _be:  # pragma: no cover\n                    _breadcrumb(\n                        f\"AC-B5 spool_drain breadcrumb emit failed: \"\n                        f\"{type(_be).__name__}: {_be}\"\n                    )\n            except Exception as e:\n                chained[\"hmac\"] = None\n                chained[\"hmac_error\"] = f\"{type(e).__name__}: {e}\"\n                _breadcrumb(f\"hmac compute failed: {type(e).__name__}: {e}\")\n\n        try:\n            line = json.dumps(\n                chained, separators=(\",\", \":\"), ensure_ascii=False,\n            ).encode(\"utf-8\") + b\"\\n\"\n        except (TypeError, ValueError) as e:\n            _breadcrumb(f\"phase4 encode failed: {type(e).__name__}: {e}\")\n            _mark(path_key, body_idx)\n            # iter3-P0-1: encode-failure consumed counts toward K_MAX.\n            processed += 1\n            continue\n        batch_lines.append(line)\n        _mark(path_key, body_idx)\n        # P1-3: track for op:\"drained\" envelope emission\n        if isinstance(rec_id, str) and rec_id:\n            drained_ids.append((rec_id, src_file.pid))\n        # iter3-P0-1: append counts toward K_MAX (was: `appended += 1`).\n        processed += 1\n\n    fully_consumed: List[_DrainingFile] = []\n    return batch_lines, fully_consumed, per_file_consumed, last_hmac, drained_ids\n\n\n# ---------------------------------------------------------------------------\n# Phase 5 — atomic append + split + cleanup\n# ---------------------------------------------------------------------------\n\n\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef _phase5_append_canonical(\n    batch_lines: List[bytes], last_hmac: Optional[bytes]\n) -> int:\n    \"\"\"Append batch to canonical log; single fsync; update sidecar cache.\n\n    iter2-P2-3: chain_length sidecar increment counts HMAC-bearing lines\n    only — entries that failed HMAC compute (hmac=null + hmac_error set)\n    don't extend the chain even though their bytes are appended. The\n    sidecar is a cache for chain-verify performance; counting null-hmac\n    lines would diverge from the true HMAC chain length.\n    \"\"\"\n    if not batch_lines:\n        return 0\n    log_path = _canonical_log_path()\n    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n\n    # PLAN-094-FOLLOWUP Wave A.3-rotation — probe rotation BEFORE the\n    # canonical append so spool-drained writes never accumulate past the\n    # configured threshold. Lazy-import audit_emit (circular dep at\n    # module load time) + audit_hmac for chain reset.\n    try:\n        from _lib import audit_emit as _audit_emit_lazy\n        from _lib import audit_hmac as _audit_hmac_lazy\n        # PLAN-143 item-2 (audit-errors-02): guard the rotation probe — a\n        # capture-shim object may lack _rotate_if_needed_safe (see the\n        # phase-4 probe above). getattr-guard -> missing attribute means\n        # \"no rotation\" (None), no AttributeError into the fail-open path.\n        _rotate_probe = getattr(\n            _audit_emit_lazy, \"_rotate_if_needed_safe\", None\n        )\n        rotated_to = (\n            _rotate_probe(log_path) if callable(_rotate_probe) else None\n        )\n        if rotated_to is not None and not _audit_hmac_lazy.is_disabled():\n            try:\n                _audit_hmac_lazy.reset_chain_on_rotation()\n                # Reset last_hmac so this batch re-anchors at genesis.\n                last_hmac = None\n            except Exception as re:\n                _breadcrumb(\n                    f\"phase5 rotation HMAC reset failed: \"\n                    f\"{type(re).__name__}: {re}\"\n                )\n    except Exception as e:\n        # Fail-open: rotation probe never blocks the canonical append.\n        _breadcrumb(f\"phase5 rotation probe failed: {type(e).__name__}: {e}\")\n\n    payload = b\"\".join(batch_lines)\n    fd = os.open(str(log_path), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)\n    try:\n        os.write(fd, payload)\n        os.fsync(fd)\n    finally:\n        os.close(fd)\n\n    if (_HMAC_AVAILABLE and _audit_hmac is not None\n            and not _audit_hmac.is_disabled()\n            and last_hmac is not None\n            and len(last_hmac) == _audit_hmac.HMAC_BYTES):\n        try:\n            _audit_hmac.write_last_hmac(last_hmac)\n        except Exception as e:\n            _breadcrumb(f\"write_last_hmac failed: {type(e).__name__}: {e}\")\n        # iter2-P2-3: count HMAC-bearing lines only.\n        hmac_bearing = 0\n        for line in batch_lines:\n            try:\n                obj = json.loads(line.rstrip(b\"\\n\").decode(\"utf-8\"))\n            except (json.JSONDecodeError, UnicodeDecodeError):\n                continue\n            if not isinstance(obj, dict):\n                continue\n            hx = obj.get(\"hmac\")\n            if isinstance(hx, str) and len(hx) == 64:\n                hmac_bearing += 1\n        try:\n            current = _audit_hmac.read_chain_length()\n            _audit_hmac.write_chain_length(current + hmac_bearing)\n        except Exception as e:\n            _breadcrumb(f\"chain_length update failed: {type(e).__name__}: {e}\")\n    return len(batch_lines)\n\n\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef _phase5_split_and_cleanup(\n    files: List[_DrainingFile],\n    per_file_consumed: Dict[str, Set[int]],\n    drain_epoch: str,\n    stats: DrainStats,\n) -> None:\n    \"\"\"For each draining file: unlink if fully consumed; else atomic-split.\n\n    iter2-P0-1: per_file_consumed is a Set[int] of body INDICES. The\n    remainder file is built from the COMPLEMENT (all body indices NOT in\n    the set). This correctly handles out-of-order index consumption (e.g.\n    wall_ns clock-skew rollback where a later body index sorts BEFORE an\n    earlier one and is cut by K_MAX) — prefix-based cleanup would have\n    discarded unprocessed earlier lines.\n\n    iter2-P0-3: SKIP any _DrainingFile whose .quarantined flag is set —\n    the file is already renamed to .malformed.<epoch>; trying to split\n    or unlink the original path would either fail (ENOENT) or, worse,\n    re-sweep the renamed quarantined file on a subsequent drain.\n\n    iter2-P1-3: when splitting, mint a NEW drain_epoch for the destination\n    so dst path != src path. This closes the `.split.tmp` two-step window\n    (old code reused src epoch → dst==src → os.rename(src,dst) no-op AND\n    the temp suffix dance remained). Now: tmp → fsync → rename(tmp,\n    new_dst) atomic; unlink(src). Single window if rename succeeds.\n\n    P2-4: header is written VERBATIM from file.header_raw — no JSON\n    re-encode (preserves byte identity of _spool_uuid sentinel chain).\n    \"\"\"\n    for f in files:\n        # iter2-P0-3: skip quarantined files — original path doesn't exist\n        # at .draining.<epoch> anymore; it was renamed to .malformed.<epoch>.\n        if f.quarantined:\n            continue\n        path_key = str(f.path)\n        if f.header is None and not f.body_lines:\n            # Already empty (no body) — just unlink the (header-only) file.\n            try:\n                if f.path.exists():\n                    os.unlink(str(f.path))\n            except OSError:\n                pass\n            continue\n        consumed_set = per_file_consumed.get(path_key, set())\n        total = len(f.body_lines)\n        # iter2-P0-1: fully consumed iff every body index is in the set.\n        if total == 0 or all(i in consumed_set for i in range(total)):\n            try:\n                os.unlink(str(f.path))\n                stats.files_consumed_fully += 1\n            except OSError as e:\n                _breadcrumb(f\"phase5 unlink failed: {type(e).__name__}: {e}\")\n            continue\n\n        # iter2-P1-3: mint a NEW epoch for the split destination so\n        # dst_path differs from src_path; this collapses the prior\n        # two-step `.split.tmp` rename dance into a single rename+unlink.\n        new_epoch = secrets.token_hex(4)\n        tmp_token = secrets.token_hex(4)\n        # tmp is a sibling .tmp.<token> for atomic create+rename within same dir\n        tmp_path = f.path.with_name(f.path.name + _TMP_SUFFIX_TOKEN + tmp_token)\n        try:\n            # P2-4: verbatim header bytes — no JSON re-encode\n            header_line = f.header_raw if f.header_raw else (\n                json.dumps(\n                    f.header, separators=(\",\", \":\"), ensure_ascii=False,\n                ).encode(\"utf-8\") + b\"\\n\"\n            )\n            # iter2-P0-1: rebuild remainder using COMPLEMENT of consumed_set\n            # (NOT a prefix slice). Empty lines are preserved as empty bytes\n            # in body_lines and re-emitted with the newline separator below.\n            remainder_lines = [\n                f.body_lines[i] for i in range(total) if i not in consumed_set\n            ]\n            body_remainder = b\"\\n\".join(remainder_lines)\n            if body_remainder and not body_remainder.endswith(b\"\\n\"):\n                body_remainder += b\"\\n\"\n            fd = os.open(\n                str(tmp_path),\n                os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_TRUNC,\n                0o600,\n            )\n            try:\n                os.write(fd, header_line)\n                if body_remainder:\n                    os.write(fd, body_remainder)\n                os.fsync(fd)\n            finally:\n                os.close(fd)\n            # iter2-P1-3: dst is .draining.<new_epoch> — distinct from src.\n            dst_path = _draining_path(_spool_path(f.pid), new_epoch)\n            # Single atomic rename + unlink source. If rename fails, the\n            # tmp file is cleaned up in the except branch.\n            os.rename(str(tmp_path), str(dst_path))\n            try:\n                os.unlink(str(f.path))\n            except OSError as e:  # pragma: no cover\n                # Source gone (race / already cleaned); rename succeeded so\n                # the remainder file is correctly in place.\n                _breadcrumb(\n                    f\"phase5 src unlink after split failed: \"\n                    f\"{type(e).__name__}: {e}\"\n                )\n            stats.files_split_remainder += 1\n        except OSError as e:\n            _breadcrumb(f\"phase5 split failed: {type(e).__name__}: {e}\")\n            try:\n                if tmp_path.exists():\n                    os.unlink(str(tmp_path))\n            except OSError:\n                pass\n\n\n# ---------------------------------------------------------------------------\n# Journal post-drain compaction\n# ---------------------------------------------------------------------------\n\n\ndef _journal_compact_drained(\n    pid: int,\n    drained_record_ids: Iterable[str],\n    drain_epoch: str,\n) -> None:\n    \"\"\"Append op=drained envelopes; rewrite journal dropping fully-completed triples.\n\n    P1-3: emits op:\"drained\" envelopes with the actual record_id so\n    session-start reconciliation can distinguish recovered from inflight.\n    \"\"\"\n    drained_set = {r for r in drained_record_ids if isinstance(r, str) and r}\n    if not drained_set:\n        return\n    # Flush any pending in-memory journal envelopes for this PID FIRST so\n    # the compaction read sees a consistent on-disk view.\n    _flush_journal_buffer(pid)\n    journal = _journal_path(pid)\n    if not journal.exists():\n        return\n    # 1) Append drained envelopes via the buffer (then flush)\n    for rid in drained_set:\n        _write_journal_envelope(\n            pid, rid, \"\", -1, \"\", \"drained\", drain_epoch=drain_epoch,\n        )\n    _flush_journal_buffer(pid)\n    # 2) Rewrite journal under per-PID journal flock dropping rows whose\n    # record_id is in drained_set (begin/commit/drained triples collapse).\n    try:\n        with FileLock(_journal_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT):\n            with journal.open(\"r\", encoding=\"utf-8\") as f:\n                keep_lines: List[str] = []\n                for raw in f:\n                    stripped = raw.strip()\n                    if not stripped:\n                        continue\n                    try:\n                        env = json.loads(stripped)\n                    except json.JSONDecodeError:\n                        keep_lines.append(raw)\n                        continue\n                    if (isinstance(env, dict)\n                            and env.get(\"record_id\") in drained_set):\n                        continue\n                    keep_lines.append(raw)\n            tmp = journal.with_name(journal.name + \".compact.tmp\")\n            with tmp.open(\"w\", encoding=\"utf-8\") as f:\n                f.writelines(keep_lines)\n                f.flush()\n                os.fsync(f.fileno())\n            os.replace(str(tmp), str(journal))\n    except FileLockTimeout:\n        _breadcrumb(f\"journal compact flock timeout pid={pid}\")\n    except OSError as e:\n        _breadcrumb(f\"journal compact failed: {type(e).__name__}: {e}\")\n\n","numLines":560,"startLine":60,"totalLines":623}},"tool_result_meta":[{"id":"toolu_01MxjPg5qAxsUEYCZVyM2L4J","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
