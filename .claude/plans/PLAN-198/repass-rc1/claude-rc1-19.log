{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018FZkcWUwTCxM3Ce2KtkDWa","type":"tool_result","content":"1\t\"\"\"Host adapter and hook entry-point declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _codex_tool_enum(tool_name: str) -> str:\n5\t    \"\"\"Map a normalized codex tool name to the closed audit enum. Never raises.\"\"\"\n6\t    if not isinstance(tool_name, str) or not tool_name:\n7\t        return \"other\"\n8\t    if tool_name.startswith(\"mcp__\"):\n9\t        return \"mcp_other\"\n10\t    return tool_name\n11\t\n12\t\n13\tdef _codex_audit_main(t0: float) -> int:\n14\t    \"\"\"Codex host-wire audit append (PLAN-155 Wave 4). Exits 0 on every path.\n15\t\n16\t    Reads the codex host envelope via the codex adapter and appends the\n17\t    matching metadata-only action to the shared HMAC chain through\n18\t    `_lib.audit_emit`. Fail-open per SPEC/v1 §4 — the audit hook is\n19\t    observability, not an enforcement gate, so an unresolved adapter / parse\n20\t    error / import failure breadcrumbs and returns 0 (the completeness bound is\n21\t    already the named residual; a security matcher would fail CLOSED instead,\n22\t    but this is not one).\n23\t    \"\"\"\n24\t    try:\n25\t        from _lib.adapters import codex as _codex_adapter\n26\t        from _lib import audit_emit as _audit_emit\n27\t    except Exception as e:  # pragma: no cover — infrastructure import failure\n28\t        try:\n29\t            write_breadcrumb(\n30\t                audit_paths()[\"err\"],\n31\t                f\"codex audit import failed (fail-open): {type(e).__name__}\",\n32\t            )\n33\t        except Exception:\n34\t            pass\n35\t        return 0\n36\t\n37\t    try:\n38\t        event = _codex_adapter.read_post_event()\n39\t    except Exception as e:  # pragma: no cover — adapter never raises by contract\n40\t        write_breadcrumb(\n41\t            audit_paths()[\"err\"],\n42\t            f\"codex read_post_event raised (fail-open): {type(e).__name__}\",\n43\t        )\n44\t        return 0\n45\t\n46\t    if getattr(event, \"parse_error\", None):\n47\t        write_breadcrumb(\n48\t            audit_paths()[\"err\"],\n49\t            f\"codex stdin parse error: {event.parse_error}\",\n50\t        )\n51\t        return 0\n52\t\n53\t    # The codex wire's event name WINS over the phase arg (host adapter sets\n54\t    # NormalizedEvent.phase = hook_event_name). raw_payload carries the raw\n55\t    # codex scalars (stop_hook_active, etc.).\n56\t    hook_event = str(getattr(event, \"phase\", \"\") or \"\")\n57\t    raw_payload = getattr(event, \"raw_payload\", {}) or {}\n58\t    session_id = str(getattr(event, \"session_id\", \"\") or \"\")\n59\t    project_dir = str(getattr(event, \"project\", \"\") or \"\") or (\n60\t        os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n61\t    )\n62\t\n63\t    try:\n64\t        if hook_event == \"PostToolUse\":\n65\t            tool_enum = _codex_tool_enum(str(getattr(event, \"tool_name\", \"\") or \"\"))\n66\t            _audit_emit.emit_codex_tool_recorded(\n67\t                session_id=session_id,\n68\t                tool_name_enum=tool_enum,\n69\t                hook_event_name=\"PostToolUse\",\n70\t                project=project_dir,\n71\t            )\n72\t        elif hook_event in (\"Stop\", \"SubagentStop\"):\n73\t            # source: derive from the event, unless the headless wrapper\n74\t            # overrode it (CEO_CODEX_TURN_SOURCE) to mark a wrapper bracket.\n75\t            derived = \"subagent_stop\" if hook_event == \"SubagentStop\" else \"stop\"\n76\t            source = os.environ.get(\"CEO_CODEX_TURN_SOURCE\") or derived\n77\t            stop_active = bool(raw_payload.get(\"stop_hook_active\"))\n78\t            _audit_emit.emit_codex_turn_ended(\n79\t                session_id=session_id,\n80\t                source=source,\n81\t                stop_hook_active=stop_active,\n82\t                project=project_dir,\n83\t            )\n84\t        elif hook_event == \"SessionStart\":\n85\t            # Boot bracket — only reached when the wrapper pipes a SessionStart\n86\t            # envelope here (production routes SessionStart -> SessionStart.py).\n87\t            emit_ss = getattr(_audit_emit, \"emit_session_start\", None)\n88\t            if emit_ss is not None:\n89\t                emit_ss(session_id=session_id, project=project_dir)\n90\t        # else: UserPromptSubmit / SubagentStart / PreToolUse are not this\n91\t        # hook's job under codex — return 0 (no append).\n92\t    except Exception as e:  # pragma: no cover — emit is fail-open by contract\n93\t        write_breadcrumb(\n94\t            audit_paths()[\"err\"],\n95\t            f\"codex audit emit failed (fail-open): {type(e).__name__}\",\n96\t        )\n97\t    return 0\n98\t\n99\t\n100\tdef _grok_tool_enum(tool_name: str) -> str:\n101\t    \"\"\"Map a normalized grok tool name to the closed audit enum. Never raises.\n102\t\n103\t    The grok adapter has already aliased run_terminal_command -> Bash,\n104\t    search_replace -> Edit, spawn_subagent -> Task, etc. before we see the\n105\t    event; here we only fold mcp__* down to `mcp_other` (MF-SEC-1) and leave\n106\t    the emitter to coerce any residual miss to `other`.\n107\t    \"\"\"\n108\t    if not isinstance(tool_name, str) or not tool_name:\n109\t        return \"other\"\n110\t    if tool_name.startswith(\"mcp__\"):\n111\t        return \"mcp_other\"\n112\t    return tool_name\n113\t\n114\t\n115\tdef _grok_audit_main(t0: float) -> int:\n116\t    \"\"\"Grok host-wire audit append (PLAN-156 Wave 4). Exits 0 on every path.\n117\t\n118\t    Mirror of `_codex_audit_main`: reads the grok host envelope via the grok\n119\t    adapter and appends the matching metadata-only action to the shared HMAC\n120\t    chain through `_lib.audit_emit`. Fail-open per SPEC/v1 §4 — the audit hook\n121\t    is observability, not enforcement, so an unresolved adapter / parse error\n122\t    / import failure breadcrumbs and returns 0.\n123\t\n124\t    Grok specifics: PostToolUse is passive (a deny cannot block), but the\n125\t    append still lands. SessionEnd is unreliable in headless runs, so\n126\t    turn-ended accounting hangs off Stop / SubagentStop (completeness caveat,\n127\t    ADR-162).\n128\t    \"\"\"\n129\t    try:\n130\t        from _lib.adapters import grok as _grok_adapter\n131\t        from _lib import audit_emit as _audit_emit\n132\t    except Exception as e:  # pragma: no cover — infrastructure import failure\n133\t        try:\n134\t            write_breadcrumb(\n135\t                audit_paths()[\"err\"],\n136\t                f\"grok audit import failed (fail-open): {type(e).__name__}\",\n137\t            )\n138\t        except Exception:\n139\t            pass\n140\t        return 0\n141\t\n142\t    try:\n143\t        event = _grok_adapter.read_post_event()\n144\t    except Exception as e:  # pragma: no cover — adapter never raises by contract\n145\t        write_breadcrumb(\n146\t            audit_paths()[\"err\"],\n147\t            f\"grok read_post_event raised (fail-open): {type(e).__name__}\",\n148\t        )\n149\t        return 0\n150\t\n151\t    if getattr(event, \"parse_error\", None):\n152\t        write_breadcrumb(\n153\t            audit_paths()[\"err\"],\n154\t            f\"grok stdin parse error: {event.parse_error}\",\n155\t        )\n156\t        return 0\n157\t\n158\t    hook_event = str(getattr(event, \"phase\", \"\") or \"\")\n159\t    session_id = str(getattr(event, \"session_id\", \"\") or \"\")\n160\t    project_dir = str(getattr(event, \"project\", \"\") or \"\") or (\n161\t        os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n162\t    )\n163\t\n164\t    try:\n165\t        if hook_event == \"PostToolUse\":\n166\t            tool_enum = _grok_tool_enum(str(getattr(event, \"tool_name\", \"\") or \"\"))\n167\t            _audit_emit.emit_grok_tool_recorded(\n168\t                session_id=session_id,\n169\t                tool_name_enum=tool_enum,\n170\t                hook_event_name=\"PostToolUse\",\n171\t                project=project_dir,\n172\t            )\n173\t        elif hook_event in (\"Stop\", \"SubagentStop\"):\n174\t            derived = \"subagent_stop\" if hook_event == \"SubagentStop\" else \"stop\"\n175\t            source = os.environ.get(\"CEO_GROK_TURN_SOURCE\") or derived\n176\t            _audit_emit.emit_grok_turn_ended(\n177\t                session_id=session_id,\n178\t                source=source,\n179\t                project=project_dir,\n180\t            )\n181\t        # else: SessionStart / UserPromptSubmit / SubagentStart / PreToolUse\n182\t        # are not this hook's job under grok — return 0 (no append).\n183\t    except Exception as e:  # pragma: no cover — emit is fail-open by contract\n184\t        write_breadcrumb(\n185\t            audit_paths()[\"err\"],\n186\t            f\"grok audit emit failed (fail-open): {type(e).__name__}\",\n187\t        )\n188\t    return 0\n189\t\n190\t\n191\t# -----------------------------------------------------------------------------\n192\t# Main entry point\n193\t# -----------------------------------------------------------------------------\n194\t\n195\t\n196\tdef main() -> int:\n197\t    \"\"\"PostToolUse hook entry point.\n198\t\n199\t    PLAN-006 Phase 1 final migration (ADR-014): uses\n200\t    `claude_adapter.read_post_event()` with explicit PostToolUse phase\n201\t    (R-SB1 fix). Reads stdin, extracts fields, redacts, writes one\n202\t    JSONL line to the audit log under lock. Silent on stdout. Exits 0\n203\t    on all paths (fail-open governance contract).\n204\t\n205\t    PLAN-155 Wave 4: under CEO_HOOK_ADAPTER=codex the codex host-wire path\n206\t    (`_codex_audit_main`) handles the append via `_lib.audit_emit`; the claude\n207\t    path below is byte-identical when the env var is unset/`claude`.\n208\t    \"\"\"\n209\t    t0 = time.monotonic()\n210\t    _adapter = os.environ.get(\"CEO_HOOK_ADAPTER\")\n211\t    if _adapter == \"codex\":\n212\t        return _codex_audit_main(t0)\n213\t    if _adapter == \"grok\":\n214\t        return _grok_audit_main(t0)\n215\t    try:\n216\t        event = _claude_adapter.read_post_event()\n217\t        if event.parse_error:\n218\t            paths = audit_paths()\n219\t            write_breadcrumb(\n220\t                paths[\"err\"],\n221\t                f\"stdin parse error: {event.parse_error}\",\n222\t            )\n223\t            return 0\n224\t\n225\t        # Filter: only care about Agent spawns\n226\t        if event.tool_name and event.tool_name not in (\"Agent\", \"unknown\"):\n227\t            return 0\n228\t\n229\t        project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n230\t        try:\n231\t            project_dir = str(Path(project_dir).resolve())\n232\t        except OSError:\n233\t            pass\n234\t\n235\t        duration_ms = int((time.monotonic() - t0) * 1000)\n236\t        entry = build_entry(\n237\t            event=event, project_dir=project_dir, hook_duration_ms=duration_ms\n238\t        )\n239\t        if entry is None:\n240\t            return 0\n241\t\n242\t        paths = audit_paths()\n243\t        append_entry(\n244\t            entry,\n245\t            paths=paths,\n246\t            threshold_bytes=rotate_threshold(),\n247\t        )\n248\t        return 0\n249\t    except Exception as e:  # pragma: no cover — catastrophic\n250\t        try:\n251\t            paths = audit_paths()\n252\t            write_breadcrumb(paths[\"err\"], f\"fatal: {e.__class__.__name__}: {e}\")\n253\t        except Exception:\n254\t            pass\n255\t        return 0\n256\t\n257\t\n258\tif __name__ == \"__main__\":\n259\t    sys.exit(main())\n260\t"}]},"parent_tool_use_id":null,"session_id":"f14aefec-dd31-41ef-96b5-86b1c0aa1232","uuid":"65b9886f-402f-4fc3-8721-ccd4668991cb","timestamp":"2026-11-15T10:42:33.884Z","tool_use_