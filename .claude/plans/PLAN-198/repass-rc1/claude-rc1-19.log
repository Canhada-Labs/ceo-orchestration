{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01N7Sk5r6Y3BhPiZpk15jH7Y","type":"tool_result","content":"1\t# PLAN-094 Wave A — spool_writer (canonical promotion of spool_writer_DRAFT.py)\n2\t\"\"\"_lib/spool_writer.py — durable spool + drain-on-next-invoke (PLAN-094 Wave A).\n3\t\n4\tImplements ADR-055-AMEND-1: 5-phase atomic drain protocol, 4-tuple total\n5\torder across concurrent producers, K_MAX/K_TAIL_WINDOW idempotent skip,\n6\tcanonical-tail prev_hmac reconstruction, per-PID spool + per-PID journal,\n7\tatomic split-and-delete for K_MAX deferral, header/body uuid sentinel.\n8\t\n9\tStdlib-only (ADR-002). Fail-open invariant — never raise to caller; any\n10\tinfra failure emits a breadcrumb and returns safely.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport atexit\n16\timport hashlib\n17\timport json\n18\timport os\n19\timport re\n20\timport secrets\n21\timport signal\n22\timport sys\n23\timport time\n24\timport uuid\n25\tfrom dataclasses import dataclass, field\n26\tfrom pathlib import Path\n27\tfrom typing import Any, Callable, Dict, Iterable, List, Optional, Set, Tuple\n28\t\n29\t_HOOKS_DIR = Path(__file__).resolve().parent.parent\n30\tif str(_HOOKS_DIR) not in sys.path:\n31\t    sys.path.insert(0, str(_HOOKS_DIR))\n32\t\n33\tfrom _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\n34\tfrom _lib import runtime_paths as _runtime_paths  # noqa: E402  # PLAN-182 W1 single resolver (ADR-001 S318)\n35\t\n36\ttry:\n37\t    from _lib import audit_hmac as _audit_hmac  # noqa: E402\n38\t    _HMAC_AVAILABLE = True\n39\texcept Exception:  # pragma: no cover\n40\t    _audit_hmac = None  # type: ignore[assignment]\n41\t    _HMAC_AVAILABLE = False\n42\t\n43\ttry:\n44\t    from _lib import canonical_json as _canonical_json  # noqa: E402\n45\texcept Exception:  # pragma: no cover\n46\t    _canonical_json = None  # type: ignore[assignment]\n47\t\n48\t\n49\t# ---------------------------------------------------------------------------\n50\t# Constants (ADR-055-AMEND-1 §3 wave A spec)\n51\t# ---------------------------------------------------------------------------\n52\t\n53\tK_MAX = 100\n54\tK_TAIL_WINDOW = 200\n55\tSPOOL_HEADER_VERSION = 1\n56\t# PLAN-111 Wave B-alt4 (debate consensus + cProfile data-driven): trigger\n57\t# raised 50 -> 100. Halves drain cascade count (40 -> 20 across 5-trial\n58\t# emit_pair benchmark, confirmed by cprofile-post-b-darwin.txt). Per-trial\n59\t# wall-clock 174ms -> 170ms (-2%); cumulative drain_now cumtime 364ms -> 307ms.\n60\t# Combined with Wave A cache: per-emit 580us -> 425us (-27%). AC-C1 strict\n61\t# <=360us NOT hit alone; Wave C.1 RELAX path engaged (200->300ms test\n62\t# budget) with ubuntu projection ~255ms still well under.\n63\tDRAIN_TRIGGER_SIZE = 100\n64\tDRAIN_TRIGGER_MTIME_MS = 100\n65\tSTALE_SPOOL_TTL_DAYS = 7\n66\tSPOOL_LOCK_TIMEOUT = 2.5\n67\t\n68\t\n69\t__all__ = (\n70\t    '_own_spool_stale_past_trigger',\n71\t    'drain_now',\n72\t    'reconcile_journal_at_session_start',\n73\t    '_journal_rec_dict',\n74\t    '_atexit_drain',\n75\t    '_signal_drain_handler',\n76\t    'install_exit_handlers',\n77\t    '_reset_for_test',\n78\t)\n79\t\n80\tdef _own_spool_stale_past_trigger(pid: int) -> bool:\n81\t    \"\"\"True iff our own spool's mtime age exceeds DRAIN_TRIGGER_MTIME_MS.\n82\t\n83\t    (ADR-055-AMEND-3) SEC veto-floor MF-1 gate. When an opportunistic\n84\t    (force=False) drain yields the canonical lock AND our own spool is already\n85\t    stale past the staleness trigger, the lock holder is not keeping up — that\n86\t    is genuine drain starvation (a wedged/contended holder), distinct from\n87\t    benign single-winner contention (a fresh spool). OSError-safe: a missing or\n88\t    unreadable spool returns False (fail-quiet, never raises).\n89\t    \"\"\"\n90\t    try:\n91\t        st = _spool_path(pid).stat()\n92\t    except OSError:\n93\t        return False\n94\t    if st.st_size == 0:\n95\t        return False\n96\t    age_ms = (time.time() - st.st_mtime) * 1000.0\n97\t    return age_ms > DRAIN_TRIGGER_MTIME_MS\n98\t\n99\t\n100\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n101\tdef drain_now(*, force: bool = False) -> DrainStats:\n102\t    \"\"\"Execute 5-phase atomic drain. Bounded ≤K_MAX entries per call.\n103\t\n104\t    Fail-open invariant — any error sets stats.ok=False and is captured in\n105\t    stats.error. NEVER raises to caller.\n106\t    \"\"\"\n107\t    stats = DrainStats()\n108\t    if is_sync_mode() and not force:\n109\t        return stats\n110\t    try:\n111\t        if not force and not should_drain():\n112\t            return stats\n113\t\n114\t        drain_epoch = secrets.token_hex(4)\n115\t        stats.drain_epoch = drain_epoch\n116\t        state_dir = _state_dir()\n117\t        our_pid = os.getpid()\n118\t        log_path = _canonical_log_path()\n119\t        log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n120\t        lock_path = _canonical_log_lock()\n121\t\n122\t        # P1-2: flush any buffered journal envelopes BEFORE drain begins so\n123\t        # the journal reflects all begin/commit events up to this point\n124\t        # (op:\"drained\" envelopes are appended after canonical append).\n125\t        _flush_journal_buffer(our_pid)\n126\t\n127\t        # Phase 1 — canonical lock (deadlock-free; writers hold only their\n128\t        # own per-PID flocks, never the canonical lock).\n129\t        #\n130\t        # (ADR-055-AMEND-3) — opportunistic/forced split. A FORCED\n131\t        # drain (recovery / exit-handler / session-start) must complete, so it\n132\t        # blocks up to SPOOL_LOCK_TIMEOUT and a timeout there is anomalous. An\n133\t        # OPPORTUNISTIC drain (force=False, the per-emit hot path) is\n134\t        # best-effort: the lock holder plus the loser's own later drain cover\n135\t        # its events, so it acquires NON-BLOCKING (timeout=0 — a clean one-shot\n136\t        # try-lock, one flock(LOCK_NB) with no sleep) and yields silently on\n137\t        # contention instead of blocking the hook subprocess for 2.5s.\n138\t        canonical_timeout = SPOOL_LOCK_TIMEOUT if force else 0.0\n139\t        try:\n140\t            with FileLock(lock_path, timeout=canonical_timeout):\n141\t                files, in_recovery = _phase2_sweep_and_rename(\n142\t                    state_dir, drain_epoch, our_pid,\n143\t                )\n144\t                stats.in_recovery_mode = in_recovery\n145\t\n146\t                valid_files: List[_DrainingFile] = []\n147\t                for f in files:\n148\t                    if _phase2_validate_header(f, drain_epoch):\n149\t                        # PLAN-119 WS-D1 — refuse _origin:\"test\" spool ONLY when\n150\t                        # the canonical destination IS the live chain; applied\n151\t                        # AFTER header validation and BEFORE phase 3, so test\n152\t                        # entries never reach batch_lines / the canonical append.\n153\t                        if _should_quarantine_test_origin(f, log_path):\n154\t                            _quarantine_test_origin(f, drain_epoch)\n155\t                            stats.test_origin_quarantined += 1\n156\t                        else:\n157\t                            valid_files.append(f)\n158\t                    else:\n159\t                        stats.quarantined_files += 1\n160\t\n161\t                # iter2-P0-1 + iter4-P2-2: phase 3 returns\n162\t                # (deduped, Dict[str, Set[int]], duplicate_consumed_count)\n163\t                deduped, partial_consumed, dup_consumed = (\n164\t                    _phase3_collect_and_sort(\n165\t                        valid_files, drain_epoch, stats,\n166\t                    )\n167\t                )\n168\t\n169\t                # P0-2 + P1-3 + iter2-P0-1: phase 4 returns\n170\t                # (batch_lines, _, per_file_consumed_set, last_hmac, ids)\n171\t                # iter4-P2-2: pass dup_consumed as starting_processed so\n172\t                # combined Phase-3 + Phase-4 work bounded by K_MAX.\n173\t                (batch_lines, _, per_file_consumed, last_hmac,\n174\t                 drained_ids) = _phase4_build_batch(\n175\t                    deduped, drain_epoch, in_recovery, stats,\n176\t                    starting_processed=dup_consumed,\n177\t                )\n178\t\n179\t                # iter2-P0-1: merge partial/duplicate-rejection consumed\n180\t                # indices (Set[int] union) into the Phase-4 per-file map so\n181\t                # Phase 5 split honors the COMPLEMENT for remainder lines.\n182\t                for path_key, idx_set in partial_consumed.items():\n183\t                    if path_key in per_file_consumed:\n184\t                        per_file_consumed[path_key] |= idx_set\n185\t                    else:\n186\t                        per_file_consumed[path_key] = set(idx_set)\n187\t\n188\t                stats.appended = _phase5_append_canonical(batch_lines, last_hmac)\n189\t\n190\t                # P1-3: emit op:\"drained\" envelopes grouped by pid + flush.\n191\t                drained_by_pid: Dict[int, List[str]] = {}\n192\t                for rec_id, pid in drained_ids:\n193\t                    drained_by_pid.setdefault(pid, []).append(rec_id)\n194\t                for pid, ids in drained_by_pid.items():\n195\t                    _journal_compact_drained(pid, ids, drain_epoch)\n196\t\n197\t                _phase5_split_and_cleanup(\n198\t                    valid_files, per_file_consumed, drain_epoch, stats,\n199\t                )\n200\t\n201\t                # P1-2: drain-boundary journal flush for our own PID\n202\t                _flush_journal_buffer(our_pid)\n203\t        except FileLockTimeout:\n204\t            if force:\n205\t                # Forced drain could not complete — genuinely anomalous.\n206\t                stats.ok = False\n207\t                stats.error = \"canonical_lock_timeout\"\n208\t                _breadcrumb(\"drain canonical lock timeout\")\n209\t            else:\n210\t                # Opportunistic yield — expected under concurrency, NOT an\n211\t                # error. Another drainer holds the lock; its global sweep plus\n212\t                # our own later drain cover our events, so ok stays True.\n213\t                stats.contended_skip = True\n214\t                # SEC veto-floor MF-1 (ADR-052): keep a genuinely wedged holder\n215\t                # observable. Emit a DISTINCT, gated breadcrumb ONLY when our\n216\t                # own spool is already stale past the staleness trigger (holder\n217\t                # not keeping up = real starvation). Benign single-winner\n218\t                # contention (fresh spool) stays silent, so the existing\n219\t                # audit-log.errors line-count detectors (ceo-diagnose.py /\n220\t                # status.py) still surface a wedge without the benign volume.\n221\t                if _own_spool_stale_past_trigger(our_pid):\n222\t                    _breadcrumb(\n223\t                        \"drain canonical lock STARVED: own spool stale past \"\n224\t                        \"trigger while opportunistic drain yielded\"\n225\t                    )\n226\t            return stats\n227\t    except Exception as e:\n228\t        stats.ok = False\n229\t        stats.error = f\"{type(e).__name__}: {e}\"\n230\t        _breadcrumb(f\"drain_now unexpected: {type(e).__name__}: {e}\")\n231\t    return stats\n232\t\n233\t\n234\t# ---------------------------------------------------------------------------\n235\t# Session-start reconciliation\n236\t# ---------------------------------------------------------------------------\n237\t\n238\t\n239\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n240\tdef reconcile_journal_at_session_start() -> JournalReconciliation:\n241\t    \"\"\"Walk audit-pending.*.journal entries; classify counts; emit forensic.\n242\t\n243\t    Returns the JournalReconciliation populated with counts. Emits\n244\t    audit_flush_dropped_count via wired forensic callback (caller in\n245\t    audit_emit wires the callback before invoking this).\n246\t    \"\"\"\n247\t    rec = JournalReconciliation()\n248\t    state_dir = _state_dir()\n249\t    try:\n250\t        if not state_dir.exists():\n251\t            _forensic(\"audit_flush_dropped_count\", _journal_rec_dict(rec))\n252\t            return rec\n253\t        names = sorted(os.listdir(str(state_dir)))\n254\t    except OSError:\n255\t        _forensic(\"audit_flush_dropped_count\", _journal_rec_dict(rec))\n256\t        return rec\n257\t\n258\t    by_record: Dict[str, Dict[str, bool]] = {}\n259\t    for name in names:\n260\t        if not name.startswith(_JOURNAL_PREFIX + \".\"):\n261\t            continue\n262\t        if not name.endswith(\".journal\"):\n263\t            continue\n264\t        if name == _aggregate_journal_path().name:\n265\t            continue\n266\t        # Parse <pid> from \"audit-pending.<pid>.journal\"\n267\t        rest = name[len(_JOURNAL_PREFIX) + 1:]\n268\t        pid_str = rest[:-len(\".journal\")]\n269\t        try:\n270\t            pid = int(pid_str)\n271\t        except ValueError:\n272\t            continue\n273\t        if pid == os.getpid():\n274\t            continue\n275\t        if _is_alive_pid(pid):\n276\t            continue\n277\t        path = state_dir / name\n278\t        try:\n279\t            with path.open(\"r\", encoding=\"utf-8\") as f:\n280\t                for raw in f:\n281\t                    stripped = raw.strip()\n282\t                    if not stripped:\n283\t                        continue\n284\t                    try:\n285\t                        env = json.loads(stripped)\n286\t                    except json.JSONDecodeError:\n287\t                        continue\n288\t                    if not isinstance(env, dict):\n289\t                        continue\n290\t                    rid = env.get(\"record_id\")\n291\t                    op = env.get(\"op\")\n292\t                    if not isinstance(rid, str) or not isinstance(op, str):\n293\t                        continue\n294\t                    slot = by_record.setdefault(\n295\t                        rid, {\"begin\": False, \"commit\": False, \"drained\": False},\n296\t                    )\n297\t                    if op in slot:\n298\t                        slot[op] = True\n299\t        except OSError:\n300\t            continue\n301\t\n302\t    for rid, ops in by_record.items():\n303\t        if ops[\"begin\"] and not ops[\"commit\"]:\n304\t            rec.begin_no_commit += 1\n305\t        elif ops[\"commit\"] and not ops[\"drained\"]:\n306\t            rec.commit_no_drained += 1\n307\t        elif ops[\"commit\"] and ops[\"drained\"]:\n308\t            rec.recovered += 1\n309\t\n310\t    # Trigger a recovery drain to sweep commit_no_drained envelopes.\n311\t    if rec.commit_no_drained > 0:\n312\t        recov = drain_now(force=True)\n313\t        if recov.ok:\n314\t            # iter2-P1-2: canonical-append-before-unlink crash recovery\n315\t            # produces mostly `skipped_idempotent` (the entries are already\n316\t            # in the canonical log; next drain reads same bytes from\n317\t            # .draining, sees them in K_TAIL_WINDOW, skips). Sum both\n318\t            # counters so AC10 reports actual recovery count, not just the\n319\t            # rare appended-on-recovery subset.\n320\t            rec.recovered += recov.appended + recov.skipped_idempotent\n321\t            # iter3-P2-1: surface intentionally_deleted (duplicate-tuple\n322\t            # rejections during recovery) into the reconciliation counter\n323\t            # so the audit_flush_dropped_count emit carries it.\n324\t            rec.intentionally_deleted += recov.intentionally_deleted\n325\t\n326\t    _forensic(\"audit_flush_dropped_count\", _journal_rec_dict(rec))\n327\t    return rec\n328\t\n329\t\n330\tdef _journal_rec_dict(rec: JournalReconciliation) -> Dict[str, Any]:\n331\t    return {\n332\t        \"begin_no_commit\": rec.begin_no_commit,\n333\t        \"commit_no_drained\": rec.commit_no_drained,\n334\t        \"recovered\": rec.recovered,\n335\t        \"truly_lost\": rec.truly_lost,\n336\t        \"tamper_rejected\": rec.tamper_rejected,\n337\t        \"intentionally_deleted\": rec.intentionally_deleted,\n338\t    }\n339\t\n340\t\n341\t# ---------------------------------------------------------------------------\n342\t# Exit handlers\n343\t# ---------------------------------------------------------------------------\n344\t\n345\t\n346\tdef _atexit_drain() -> None:\n347\t    \"\"\"Best-effort exit drain, except while a hook deadline is armed.\"\"\"\n348\t    if _exit_deadline_active():\n349\t        _record_exit_deadline_skip(\"atexit\")\n350\t        return\n351\t    try:\n352\t        drain_now(force=True)\n353\t    except Exception:\n354\t        pass\n355\t    try:\n356\t        _flush_journal_buffer(os.getpid())\n357\t    except Exception:\n358\t        pass\n359\t\n360\t\n361\tdef _signal_drain_handler(signum: int, frame: Any) -> None:\n362\t    \"\"\"Drain when safe, then preserve the previous signal disposition.\"\"\"\n363\t    if _IN_SPOOL_APPEND:\n364\t        _breadcrumb(f\"signal {signum} arrived during spool_append; bail\")\n365\t    elif _exit_deadline_active():\n366\t        _record_exit_deadline_skip(f\"signal-{signum}\")\n367\t    else:\n368\t        try:\n369\t            drain_now(force=True)\n370\t        except Exception:\n371\t            pass\n372\t        try:\n373\t            _flush_journal_buffer(os.getpid())\n374\t        except Exception:\n375\t            pass\n376\t    if signum == signal.SIGTERM:\n377\t        prev = _PREV_SIGTERM_HANDLER\n378\t    elif signum == signal.SIGINT:\n379\t        prev = _PREV_SIGINT_HANDLER\n380\t    else:\n381\t        prev = signal.SIG_DFL\n382\t    if prev is signal.SIG_IGN:\n383\t        try:\n384\t            signal.signal(signum, signal.SIG_IGN)\n385\t        except (ValueError, OSError):  # pragma: no cover\n386\t            pass\n387\t        return\n388\t    if callable(prev):\n389\t        try:\n390\t            signal.signal(signum, prev)\n391\t        except (ValueError, OSError):  # pragma: no cover\n392\t            pass\n393\t        try:\n394\t            prev(signum, frame)\n395\t        except Exception:  # pragma: no cover\n396\t            pass\n397\t        return\n398\t    try:\n399\t        signal.signal(signum, signal.SIG_DFL)\n400\t    except (ValueError, OSError):  # pragma: no cover\n401\t        pass\n402\t    try:\n403\t        os.kill(os.getpid(), signum)\n404\t    except OSError:  # pragma: no cover\n405\t        pass\n406\t\n407\t\n408\tdef install_exit_handlers() -> None:\n409\t    \"\"\"Register atexit + SIGTERM/SIGINT drain handlers (idempotent one-shot).\"\"\"\n410\t    global _EXIT_HANDLER_INSTALLED\n411\t    global _PREV_SIGTERM_HANDLER, _PREV_SIGINT_HANDLER\n412\t    if _EXIT_HANDLER_INSTALLED:\n413\t        return\n414\t    try:\n415\t        atexit.register(_atexit_drain)\n416\t    except Exception as e:  # pragma: no cover\n417\t        _breadcrumb(f\"atexit register failed: {type(e).__name__}: {e}\")\n418\t    try:\n419\t        _PREV_SIGTERM_HANDLER = signal.signal(\n420\t            signal.SIGTERM, _signal_drain_handler,\n421\t        )\n422\t        if _PREV_SIGTERM_HANDLER is _signal_drain_handler:\n423\t            _PREV_SIGTERM_HANDLER = signal.SIG_DFL\n424\t    except (ValueError, OSError) as e:\n425\t        # Signal handlers only work on main thread; in worker threads\n426\t        # signal.signal raises ValueError. Fail-open.\n427\t        _breadcrumb(f\"SIGTERM install skipped: {type(e).__name__}: {e}\")\n428\t    try:\n429\t        _PREV_SIGINT_HANDLER = signal.signal(\n430\t            signal.SIGINT, _signal_drain_handler,\n431\t        )\n432\t        if _PREV_SIGINT_HANDLER is _signal_drain_handler:\n433\t            _PREV_SIGINT_HANDLER = signal.SIG_DFL\n434\t    except (ValueError, OSError) as e:\n435\t        _breadcrumb(f\"SIGINT install skipped: {type(e).__name__}: {e}\")\n436\t    _EXIT_HANDLER_INSTALLED = True\n437\t\n438\t\n439\t# ---------------------------------------------------------------------------\n440\t# Test helpers (NOT public API — prefixed _; harness uses these)\n441\t# ---------------------------------------------------------------------------\n442\t\n443\t\n444\tdef _reset_for_test() -> None:\n445\t    \"\"\"Clear all in-process spool state (caches + handler latch + buffer).\"\"\"\n446\t    global _EXIT_HANDLER_INSTALLED, _IN_FORENSIC_EMIT, _IN_SPOOL_APPEND\n447\t    global _PREV_SIGTERM_HANDLER, _PREV_SIGINT_HANDLER\n448\t    global _EXIT_DEADLINE_MONOTONIC\n449\t    if _EXIT_HANDLER_INSTALLED:\n450\t        for signum, previous in (\n451\t            (signal.SIGTERM, _PREV_SIGTERM_HANDLER),\n452\t            (signal.SIGINT, _PREV_SIGINT_HANDLER),\n453\t        ):\n454\t            if previous is None:\n455\t                continue\n456\t            try:\n457\t                if signal.getsignal(signum) is _signal_drain_handler:\n458\t                    signal.signal(signum, previous)\n459\t            except (ValueError, OSError):  # pragma: no cover\n460\t                pass\n461\t    _SPOOL_HEADER_CACHE.clear()\n462\t    _ORDINAL_COUNTER.clear()\n463\t    _JOURNAL_BUFFER.clear()\n464\t    _EXIT_HANDLER_INSTALLED = False\n465\t    _PREV_SIGTERM_HANDLER = None\n466\t    _PREV_SIGINT_HANDLER = None\n467\t    _EXIT_DEADLINE_MONOTONIC = None\n468\t    _IN_FORENSIC_EMIT = False\n469\t    _IN_SPOOL_APPEND = False\n470\t"}]},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"932c5287-1e1a-43bd-9f0b-f5cc0314e57f","timestamp":"2026-11-13T17:50:03.761Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_spool_writer_parts/lifecycle.py","content":"# PLAN-094 Wave A — spool_writer (canonical promotion of spool_writer_DRAFT.py)\n\"\"\"_lib/spool_writer.py — durable spool + drain-on-next-invoke (PLAN-094 Wave A).\n\nImplements ADR-055-AMEND-1: 5-phase atomic drain protocol, 4-tuple total\norder across concurrent producers, K_MAX/K_TAIL_WINDOW idempotent skip,\ncanonical-tail prev_hmac reconstruction, per-PID spool + per-PID journal,\natomic split-and-delete for K_MAX deferral, header/body uuid sentinel.\n\nStdlib-only (ADR-002). Fail-open invariant — never raise to caller; any\ninfra failure emits a breadcrumb and returns safely.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport atexit\nimport hashlib\nimport json\nimport os\nimport re\nimport secrets\nimport signal\nimport sys\nimport time\nimport uuid\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, Iterable, List, Optional, Set, Tuple\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\nfrom _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\nfrom _lib import runtime_paths as _runtime_paths  # noqa: E402  # PLAN-182 W1 single resolver (ADR-001 S318)\n\ntry:\n    from _lib import audit_hmac as _audit_hmac  # noqa: E402\n    _HMAC_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _audit_hmac = None  # type: ignore[assignment]\n    _HMAC_AVAILABLE = False\n\ntry:\n    from _lib import canonical_json as _canonical_json  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _canonical_json = None  # type: ignore[assignment]\n\n\n# ---------------------------------------------------------------------------\n# Constants (ADR-055-AMEND-1 §3 wave A spec)\n# ---------------------------------------------------------------------------\n\nK_MAX = 100\nK_TAIL_WINDOW = 200\nSPOOL_HEADER_VERSION = 1\n# PLAN-111 Wave B-alt4 (debate consensus + cProfile data-driven): trigger\n# raised 50 -> 100. Halves drain cascade count (40 -> 20 across 5-trial\n# emit_pair benchmark, confirmed by cprofile-post-b-darwin.txt). Per-trial\n# wall-clock 174ms -> 170ms (-2%); cumulative drain_now cumtime 364ms -> 307ms.\n# Combined with Wave A cache: per-emit 580us -> 425us (-27%). AC-C1 strict\n# <=360us NOT hit alone; Wave C.1 RELAX path engaged (200->300ms test\n# budget) with ubuntu projection ~255ms still well under.\nDRAIN_TRIGGER_SIZE = 100\nDRAIN_TRIGGER_MTIME_MS = 100\nSTALE_SPOOL_TTL_DAYS = 7\nSPOOL_LOCK_TIMEOUT = 2.5\n\n\n__all__ = (\n    '_own_spool_stale_past_trigger',\n    'drain_now',\n    'reconcile_journal_at_session_start',\n    '_journal_rec_dict',\n    '_atexit_drain',\n    '_signal_drain_handler',\n    'install_exit_handlers',\n    '_reset_for_test',\n)\n\ndef _own_spool_stale_past_trigger(pid: int) -> bool:\n    \"\"\"True iff our own spool's mtime age exceeds DRAIN_TRIGGER_MTIME_MS.\n\n    (ADR-055-AMEND-3) SEC veto-floor MF-1 gate. When an opportunistic\n    (force=False) drain yields the canonical lock AND our own spool is already\n    stale past the staleness trigger, the lock holder is not keeping up — that\n    is genuine drain starvation (a wedged/contended holder), distinct from\n    benign single-winner contention (a fresh spool). OSError-safe: a missing or\n    unreadable spool returns False (fail-quiet, never raises).\n    \"\"\"\n    try:\n        st = _spool_path(pid).stat()\n    except OSError:\n        return False\n    if st.st_size == 0:\n        return False\n    age_ms = (time.time() - st.st_mtime) * 1000.0\n    return age_ms > DRAIN_TRIGGER_MTIME_MS\n\n\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef drain_now(*, force: bool = False) -> DrainStats:\n    \"\"\"Execute 5-phase atomic drain. Bounded ≤K_MAX entries per call.\n\n    Fail-open invariant — any error sets stats.ok=False and is captured in\n    stats.error. NEVER raises to caller.\n    \"\"\"\n    stats = DrainStats()\n    if is_sync_mode() and not force:\n        return stats\n    try:\n        if not force and not should_drain():\n            return stats\n\n        drain_epoch = secrets.token_hex(4)\n        stats.drain_epoch = drain_epoch\n        state_dir = _state_dir()\n        our_pid = os.getpid()\n        log_path = _canonical_log_path()\n        log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n        lock_path = _canonical_log_lock()\n\n        # P1-2: flush any buffered journal envelopes BEFORE drain begins so\n        # the journal reflects all begin/commit events up to this point\n        # (op:\"drained\" envelopes are appended after canonical append).\n        _flush_journal_buffer(our_pid)\n\n        # Phase 1 — canonical lock (deadlock-free; writers hold only their\n        # own per-PID flocks, never the canonical lock).\n        #\n        # (ADR-055-AMEND-3) — opportunistic/forced split. A FORCED\n        # drain (recovery / exit-handler / session-start) must complete, so it\n        # blocks up to SPOOL_LOCK_TIMEOUT and a timeout there is anomalous. An\n        # OPPORTUNISTIC drain (force=False, the per-emit hot path) is\n        # best-effort: the lock holder plus the loser's own later drain cover\n        # its events, so it acquires NON-BLOCKING (timeout=0 — a clean one-shot\n        # try-lock, one flock(LOCK_NB) with no sleep) and yields silently on\n        # contention instead of blocking the hook subprocess for 2.5s.\n        canonical_timeout = SPOOL_LOCK_TIMEOUT if force else 0.0\n        try:\n            with FileLock(lock_path, timeout=canonical_timeout):\n                files, in_recovery = _phase2_sweep_and_rename(\n                    state_dir, drain_epoch, our_pid,\n                )\n                stats.in_recovery_mode = in_recovery\n\n                valid_files: List[_DrainingFile] = []\n                for f in files:\n                    if _phase2_validate_header(f, drain_epoch):\n                        # PLAN-119 WS-D1 — refuse _origin:\"test\" spool ONLY when\n                        # the canonical destination IS the live chain; applied\n                        # AFTER header validation and BEFORE phase 3, so test\n                        # entries never reach batch_lines / the canonical append.\n                        if _should_quarantine_test_origin(f, log_path):\n                            _quarantine_test_origin(f, drain_epoch)\n                            stats.test_origin_quarantined += 1\n                        else:\n                            valid_files.append(f)\n                    else:\n                        stats.quarantined_files += 1\n\n                # iter2-P0-1 + iter4-P2-2: phase 3 returns\n                # (deduped, Dict[str, Set[int]], duplicate_consumed_count)\n                deduped, partial_consumed, dup_consumed = (\n                    _phase3_collect_and_sort(\n                        valid_files, drain_epoch, stats,\n                    )\n                )\n\n                # P0-2 + P1-3 + iter2-P0-1: phase 4 returns\n                # (batch_lines, _, per_file_consumed_set, last_hmac, ids)\n                # iter4-P2-2: pass dup_consumed as starting_processed so\n                # combined Phase-3 + Phase-4 work bounded by K_MAX.\n                (batch_lines, _, per_file_consumed, last_hmac,\n                 drained_ids) = _phase4_build_batch(\n                    deduped, drain_epoch, in_recovery, stats,\n                    starting_processed=dup_consumed,\n                )\n\n                # iter2-P0-1: merge partial/duplicate-rejection consumed\n                # indices (Set[int] union) into the Phase-4 per-file map so\n                # Phase 5 split honors the COMPLEMENT for remainder lines.\n                for path_key, idx_set in partial_consumed.items():\n                    if path_key in per_file_consumed:\n                        per_file_consumed[path_key] |= idx_set\n                    else:\n                        per_file_consumed[path_key] = set(idx_set)\n\n                stats.appended = _phase5_append_canonical(batch_lines, last_hmac)\n\n                # P1-3: emit op:\"drained\" envelopes grouped by pid + flush.\n                drained_by_pid: Dict[int, List[str]] = {}\n                for rec_id, pid in drained_ids:\n                    drained_by_pid.setdefault(pid, []).append(rec_id)\n                for pid, ids in drained_by_pid.items():\n                    _journal_compact_drained(pid, ids, drain_epoch)\n\n                _phase5_split_and_cleanup(\n                    valid_files, per_file_consumed, drain_epoch, stats,\n                )\n\n                # P1-2: drain-boundary journal flush for our own PID\n                _flush_journal_buffer(our_pid)\n        except FileLockTimeout:\n            if force:\n                # Forced drain could not complete — genuinely anomalous.\n                stats.ok = False\n                stats.error = \"canonical_lock_timeout\"\n                _breadcrumb(\"drain canonical lock timeout\")\n            else:\n                # Opportunistic yield — expected under concurrency, NOT an\n                # error. Another drainer holds the lock; its global sweep plus\n                # our own later drain cover our events, so ok stays True.\n                stats.contended_skip = True\n                # SEC veto-floor MF-1 (ADR-052): keep a genuinely wedged holder\n                # observable. Emit a DISTINCT, gated breadcrumb ONLY when our\n                # own spool is already stale past the staleness trigger (holder\n                # not keeping up = real starvation). Benign single-winner\n                # contention (fresh spool) stays silent, so the existing\n                # audit-log.errors line-count detectors (ceo-diagnose.py /\n                # status.py) still surface a wedge without the benign volume.\n                if _own_spool_stale_past_trigger(our_pid):\n                    _breadcrumb(\n                        \"drain canonical lock STARVED: own spool stale past \"\n                        \"trigger while opportunistic drain yielded\"\n                    )\n            return stats\n    except Exception as e:\n        stats.ok = False\n        stats.error = f\"{type(e).__name__}: {e}\"\n        _breadcrumb(f\"drain_now unexpected: {type(e).__name__}: {e}\")\n    return stats\n\n\n# ---------------------------------------------------------------------------\n# Session-start reconciliation\n# ---------------------------------------------------------------------------\n\n\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef reconcile_journal_at_session_start() -> JournalReconciliation:\n    \"\"\"Walk audit-pending.*.journal entries; classify counts; emit forensic.\n\n    Returns the JournalReconciliation populated with counts. Emits\n    audit_flush_dropped_count via wired forensic callback (caller in\n    audit_emit wires the callback before invoking this).\n    \"\"\"\n    rec = JournalReconciliation()\n    state_dir = _state_dir()\n    try:\n        if not state_dir.exists():\n            _forensic(\"audit_flush_dropped_count\", _journal_rec_dict(rec))\n            return rec\n        names = sorted(os.listdir(str(state_dir)))\n    except OSError:\n        _forensic(\"audit_flush_dropped_count\", _journal_rec_dict(rec))\n        return rec\n\n    by_record: Dict[str, Dict[str, bool]] = {}\n    for name in names:\n        if not name.startswith(_JOURNAL_PREFIX + \".\"):\n            continue\n        if not name.endswith(\".journal\"):\n            continue\n        if name == _aggregate_journal_path().name:\n            continue\n        # Parse <pid> from \"audit-pending.<pid>.journal\"\n        rest = name[len(_JOURNAL_PREFIX) + 1:]\n        pid_str = rest[:-len(\".journal\")]\n        try:\n            pid = int(pid_str)\n        except ValueError:\n            continue\n        if pid == os.getpid():\n            continue\n        if _is_alive_pid(pid):\n            continue\n        path = state_dir / name\n        try:\n            with path.open(\"r\", encoding=\"utf-8\") as f:\n                for raw in f:\n                    stripped = raw.strip()\n                    if not stripped:\n                        continue\n                    try:\n                        env = json.loads(stripped)\n                    except json.JSONDecodeError:\n                        continue\n                    if not isinstance(env, dict):\n                        continue\n                    rid = env.get(\"record_id\")\n                    op = env.get(\"op\")\n                    if not isinstance(rid, str) or not isinstance(op, str):\n                        continue\n                    slot = by_record.setdefault(\n                        rid, {\"begin\": False, \"commit\": False, \"drained\": False},\n                    )\n                    if op in slot:\n                        slot[op] = True\n        except OSError:\n            continue\n\n    for rid, ops in by_record.items():\n        if ops[\"begin\"] and not ops[\"commit\"]:\n            rec.begin_no_commit += 1\n        elif ops[\"commit\"] and not ops[\"drained\"]:\n            rec.commit_no_drained += 1\n        elif ops[\"commit\"] and ops[\"drained\"]:\n            rec.recovered += 1\n\n    # Trigger a recovery drain to sweep commit_no_drained envelopes.\n    if rec.commit_no_drained > 0:\n        recov = drain_now(force=True)\n        if recov.ok:\n            # iter2-P1-2: canonical-append-before-unlink crash recovery\n            # produces mostly `skipped_idempotent` (the entries are already\n            # in the canonical log; next drain reads same bytes from\n            # .draining, sees them in K_TAIL_WINDOW, skips). Sum both\n            # counters so AC10 reports actual recovery count, not just the\n            # rare appended-on-recovery subset.\n            rec.recovered += recov.appended + recov.skipped_idempotent\n            # iter3-P2-1: surface intentionally_deleted (duplicate-tuple\n            # rejections during recovery) into the reconciliation counter\n            # so the audit_flush_dropped_count emit carries it.\n            rec.intentionally_deleted += recov.intentionally_deleted\n\n    _forensic(\"audit_flush_dropped_count\", _journal_rec_dict(rec))\n    return rec\n\n\ndef _journal_rec_dict(rec: JournalReconciliation) -> Dict[str, Any]:\n    return {\n        \"begin_no_commit\": rec.begin_no_commit,\n        \"commit_no_drained\": rec.commit_no_drained,\n        \"recovered\": rec.recovered,\n        \"truly_lost\": rec.truly_lost,\n        \"tamper_rejected\": rec.tamper_rejected,\n        \"intentionally_deleted\": rec.intentionally_deleted,\n    }\n\n\n# ---------------------------------------------------------------------------\n# Exit handlers\n# ---------------------------------------------------------------------------\n\n\ndef _atexit_drain() -> None:\n    \"\"\"Best-effort exit drain, except while a hook deadline is armed.\"\"\"\n    if _exit_deadline_active():\n        _record_exit_deadline_skip(\"atexit\")\n        return\n    try:\n        drain_now(force=True)\n    except Exception:\n        pass\n    try:\n        _flush_journal_buffer(os.getpid())\n    except Exception:\n        pass\n\n\ndef _signal_drain_handler(signum: int, frame: Any) -> None:\n    \"\"\"Drain when safe, then preserve the previous signal disposition.\"\"\"\n    if _IN_SPOOL_APPEND:\n        _breadcrumb(f\"signal {signum} arrived during spool_append; bail\")\n    elif _exit_deadline_active():\n        _record_exit_deadline_skip(f\"signal-{signum}\")\n    else:\n        try:\n            drain_now(force=True)\n        except Exception:\n            pass\n        try:\n            _flush_journal_buffer(os.getpid())\n        except Exception:\n            pass\n    if signum == signal.SIGTERM:\n        prev = _PREV_SIGTERM_HANDLER\n    elif signum == signal.SIGINT:\n        prev = _PREV_SIGINT_HANDLER\n    else:\n        prev = signal.SIG_DFL\n    if prev is signal.SIG_IGN:\n        try:\n            signal.signal(signum, signal.SIG_IGN)\n        except (ValueError, OSError):  # pragma: no cover\n            pass\n        return\n    if callable(prev):\n        try:\n            signal.signal(signum, prev)\n        except (ValueError, OSError):  # pragma: no cover\n            pass\n        try:\n            prev(signum, frame)\n        except Exception:  # pragma: no cover\n            pass\n        return\n    try:\n        signal.signal(signum, signal.SIG_DFL)\n    except (ValueError, OSError):  # pragma: no cover\n        pass\n    try:\n        os.kill(os.getpid(), signum)\n    except OSError:  # pragma: no cover\n        pass\n\n\ndef install_exit_handlers() -> None:\n    \"\"\"Register atexit + SIGTERM/SIGINT drain handlers (idempotent one-shot).\"\"\"\n    global _EXIT_HANDLER_INSTALLED\n    global _PREV_SIGTERM_HANDLER, _PREV_SIGINT_HANDLER\n    if _EXIT_HANDLER_INSTALLED:\n        return\n    try:\n        atexit.register(_atexit_drain)\n    except Exception as e:  # pragma: no cover\n        _breadcrumb(f\"atexit register failed: {type(e).__name__}: {e}\")\n    try:\n        _PREV_SIGTERM_HANDLER = signal.signal(\n            signal.SIGTERM, _signal_drain_handler,\n        )\n        if _PREV_SIGTERM_HANDLER is _signal_drain_handler:\n            _PREV_SIGTERM_HANDLER = signal.SIG_DFL\n    except (ValueError, OSError) as e:\n        # Signal handlers only work on main thread; in worker threads\n        # signal.signal raises ValueError. Fail-open.\n        _breadcrumb(f\"SIGTERM install skipped: {type(e).__name__}: {e}\")\n    try:\n        _PREV_SIGINT_HANDLER = signal.signal(\n            signal.SIGINT, _signal_drain_handler,\n        )\n        if _PREV_SIGINT_HANDLER is _signal_drain_handler:\n            _PREV_SIGINT_HANDLER = signal.SIG_DFL\n    except (ValueError, OSError) as e:\n        _breadcrumb(f\"SIGINT install skipped: {type(e).__name__}: {e}\")\n    _EXIT_HANDLER_INSTALLED = True\n\n\n# ---------------------------------------------------------------------------\n# Test helpers (NOT public API — prefixed _; harness uses these)\n# ---------------------------------------------------------------------------\n\n\ndef _reset_for_test() -> None:\n    \"\"\"Clear all in-process spool state (caches + handler latch + buffer).\"\"\"\n    global _EXIT_HANDLER_INSTALLED, _IN_FORENSIC_EMIT, _IN_SPOOL_APPEND\n    global _PREV_SIGTERM_HANDLER, _PREV_SIGINT_HANDLER\n    global _EXIT_DEADLINE_MONOTONIC\n    if _EXIT_HANDLER_INSTALLED:\n        for signum, previous in (\n            (signal.SIGTERM, _PREV_SIGTERM_HANDLER),\n            (signal.SIGINT, _PREV_SIGINT_HANDLER),\n        ):\n            if previous is None:\n                continue\n            try:\n                if signal.getsignal(signum) is _signal_drain_handler:\n                    signal.signal(signum, previous)\n            except (ValueError, OSError):  # pragma: no cover\n                pass\n    _SPOOL_HEADER_CACHE.clear()\n    _ORDINAL_COUNTER.clear()\n    _JOURNAL_BUFFER.clear()\n    _EXIT_HANDLER_INSTALLED = False\n    _PREV_SIGTERM_HANDLER = None\n    _PREV_SIGINT_HANDLER = None\n    _EXIT_DEADLINE_MONOTONIC = None\n    _IN_FORENSIC_EMIT = False\n    _IN_SPOOL_APPEND = False\n","numLines":470,"startLine":1,"totalLines":470}},"tool_result_meta":[{"id":"toolu_01N7Sk5r6Y3BhPiZpk15jH7Y","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
