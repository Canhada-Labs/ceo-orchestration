{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YRwccQaJUxhTSnQaxPPVyK","type":"tool_result","content":"1\t# PLAN-094 Wave A — spool_writer (canonical promotion of spool_writer_DRAFT.py)\n2\t\"\"\"_lib/spool_writer.py — durable spool + drain-on-next-invoke (PLAN-094 Wave A).\n3\t\n4\tImplements ADR-055-AMEND-1: 5-phase atomic drain protocol, 4-tuple total\n5\torder across concurrent producers, K_MAX/K_TAIL_WINDOW idempotent skip,\n6\tcanonical-tail prev_hmac reconstruction, per-PID spool + per-PID journal,\n7\tatomic split-and-delete for K_MAX deferral, header/body uuid sentinel.\n8\t\n9\tStdlib-only (ADR-002). Fail-open invariant — never raise to caller; any\n10\tinfra failure emits a breadcrumb and returns safely.\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\timport atexit\n16\timport hashlib\n17\timport json\n18\timport os\n19\timport re\n20\timport secrets\n21\timport signal\n22\timport sys\n23\timport time\n24\timport uuid\n25\tfrom dataclasses import dataclass, field\n26\tfrom pathlib import Path\n27\tfrom typing import Any, Callable, Dict, Iterable, List, Optional, Set, Tuple\n28\t\n29\t_HOOKS_DIR = Path(__file__).resolve().parent.parent\n30\tif str(_HOOKS_DIR) not in sys.path:\n31\t    sys.path.insert(0, str(_HOOKS_DIR))\n32\t\n33\tfrom _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\n34\tfrom _lib import runtime_paths as _runtime_paths  # noqa: E402  # PLAN-182 W1 single resolver (ADR-001 S318)\n35\t\n36\ttry:\n37\t    from _lib import audit_hmac as _audit_hmac  # noqa: E402\n38\t    _HMAC_AVAILABLE = True\n39\texcept Exception:  # pragma: no cover\n40\t    _audit_hmac = None  # type: ignore[assignment]\n41\t    _HMAC_AVAILABLE = False\n42\t\n43\ttry:\n44\t    from _lib import canonical_json as _canonical_json  # noqa: E402\n45\texcept Exception:  # pragma: no cover\n46\t    _canonical_json = None  # type: ignore[assignment]\n47\t\n48\t\n49\t# ---------------------------------------------------------------------------\n50\t# Constants (ADR-055-AMEND-1 §3 wave A spec)\n51\t# ---------------------------------------------------------------------------\n52\t\n53\tK_MAX = 100\n54\tK_TAIL_WINDOW = 200\n55\tSPOOL_HEADER_VERSION = 1\n56\t# PLAN-111 Wave B-alt4 (debate consensus + cProfile data-driven): trigger\n57\t# raised 50 -> 100. Halves drain cascade count (40 -> 20 across 5-trial\n58\t# emit_pair benchmark, confirmed by cprofile-post-b-darwin.txt). Per-trial\n59\t# wall-clock 174ms -> 170ms (-2%); cumulative drain_now cumtime 364ms -> 307ms.\n60\t# Combined with Wave A cache: per-emit 580us -> 425us (-27%). AC-C1 strict\n61\t# <=360us NOT hit alone; Wave C.1 RELAX path engaged (200->300ms test\n62\t# budget) with ubuntu projection ~255ms still well under.\n63\tDRAIN_TRIGGER_SIZE = 100\n64\tDRAIN_TRIGGER_MTIME_MS = 100\n65\tSTALE_SPOOL_TTL_DAYS = 7\n66\tSPOOL_LOCK_TIMEOUT = 2.5\n67\t\n68\t\n69\t__all__ = (\n70\t    'should_drain',\n71\t    '_read_canonical_tail',\n72\t    '_DrainingFile',\n73\t    '_is_alive_pid',\n74\t    '_parse_spool_pid',\n75\t    '_phase2_sweep_and_rename',\n76\t    '_quarantine',\n77\t    '_should_quarantine_test_origin',\n78\t    '_quarantine_test_origin',\n79\t    '_phase2_validate_header',\n80\t    '_phase3_collect_and_sort',\n81\t)\n82\t\n83\tdef should_drain() -> bool:\n84\t    \"\"\"Return True if current spool meets event-count or staleness trigger.\n85\t\n86\t    P2-1: event-count trigger uses an actual newline-count over the spool\n87\t    body (capped at DRAIN_TRIGGER_SIZE + 2 to keep the probe cheap), NOT\n88\t    a byte-size proxy. Header is 1 line; we trigger when body lines >=\n89\t    DRAIN_TRIGGER_SIZE.\n90\t    \"\"\"\n91\t    try:\n92\t        pid = os.getpid()\n93\t        p = _spool_path(pid)\n94\t        if not p.exists():\n95\t            return False\n96\t        st = p.stat()\n97\t        if st.st_size == 0:\n98\t            return False\n99\t        # Staleness trigger first (cheap)\n100\t        age_ms = (time.time() - st.st_mtime) * 1000.0\n101\t        if age_ms > DRAIN_TRIGGER_MTIME_MS:\n102\t            return True\n103\t        # P2-1: honest newline count, capped at DRAIN_TRIGGER_SIZE + 2\n104\t        # (1 for header + 1 to early-exit once we cross the threshold).\n105\t        cap = DRAIN_TRIGGER_SIZE + 2\n106\t        count = 0\n107\t        try:\n108\t            with p.open(\"rb\") as f:\n109\t                while count < cap:\n110\t                    chunk = f.read(8192)\n111\t                    if not chunk:\n112\t                        break\n113\t                    count += chunk.count(b\"\\n\")\n114\t                    if count >= cap:\n115\t                        break\n116\t        except OSError:\n117\t            return False\n118\t        # Body lines = count - 1 (header is line 1). Trigger when\n119\t        # body_lines >= DRAIN_TRIGGER_SIZE → count >= DRAIN_TRIGGER_SIZE+1.\n120\t        return count >= (DRAIN_TRIGGER_SIZE + 1)\n121\t    except Exception:\n122\t        return False\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# Tail read of canonical log (Phase 4 prev_hmac + _drain_sha256 set)\n127\t# ---------------------------------------------------------------------------\n128\t\n129\t\n130\tdef _read_canonical_tail(\n131\t    log_path: Path, k_lines: int\n132\t) -> Tuple[Optional[bytes], List[Dict[str, Any]]]:\n133\t    \"\"\"Return (prev_hmac_bytes_or_None, last_k_entries) from canonical log.\n134\t\n135\t    Reads up to k_lines from EOF using a backward chunked scan. Returns the\n136\t    last entry's hmac (raw bytes) plus the parsed dicts for the last K\n137\t    well-formed JSON lines. Empty / missing log → (None, []).\n138\t    \"\"\"\n139\t    if not log_path.exists():\n140\t        return None, []\n141\t    try:\n142\t        size = log_path.stat().st_size\n143\t    except OSError:\n144\t        return None, []\n145\t    if size == 0:\n146\t        return None, []\n147\t\n148\t    chunk = 8192\n149\t    buf = b\"\"\n150\t    lines: List[bytes] = []\n151\t    try:\n152\t        with log_path.open(\"rb\") as f:\n153\t            pos = size\n154\t            while pos > 0 and len(lines) <= k_lines:\n155\t                read = min(chunk, pos)\n156\t                pos -= read\n157\t                f.seek(pos)\n158\t                buf = f.read(read) + buf\n159\t                parts = buf.split(b\"\\n\")\n160\t                # First element may be a partial fragment until we read\n161\t                # further; keep it in buf, take the tail-complete lines.\n162\t                buf = parts[0]\n163\t                # parts[1:] are complete lines (after the first newline).\n164\t                # Reverse so we accumulate newest-first.\n165\t                for ln in reversed(parts[1:]):\n166\t                    if ln:\n167\t                        lines.append(ln)\n168\t                    if len(lines) >= k_lines:\n169\t                        break\n170\t            if pos == 0 and buf:\n171\t                if len(lines) < k_lines:\n172\t                    lines.append(buf)\n173\t    except OSError as e:\n174\t        _breadcrumb(f\"canonical tail read failed: {type(e).__name__}: {e}\")\n175\t        return None, []\n176\t\n177\t    # lines is newest-first; reverse to chronological order\n178\t    lines.reverse()\n179\t    entries: List[Dict[str, Any]] = []\n180\t    for raw in lines[-k_lines:]:\n181\t        try:\n182\t            obj = json.loads(raw.decode(\"utf-8\"))\n183\t            if isinstance(obj, dict):\n184\t                entries.append(obj)\n185\t        except (json.JSONDecodeError, UnicodeDecodeError):\n186\t            continue\n187\t\n188\t    prev_hmac: Optional[bytes] = None\n189\t    for obj in reversed(entries):\n190\t        hx = obj.get(\"hmac\")\n191\t        if isinstance(hx, str) and len(hx) == 64:\n192\t            try:\n193\t                prev_hmac = bytes.fromhex(hx)\n194\t                break\n195\t            except ValueError:\n196\t                continue\n197\t    return prev_hmac, entries\n198\t\n199\t\n200\t# ---------------------------------------------------------------------------\n201\t# Phase 2 — sweep + atomic rename + header validation\n202\t# ---------------------------------------------------------------------------\n203\t\n204\t\n205\t@dataclass(eq=False)\n206\tclass _DrainingFile:\n207\t    \"\"\"One file under drain in the current cycle.\n208\t\n209\t    P0-2: declared eq=False so default object identity hash applies —\n210\t    instances are usable as Dict keys without TypeError. (We still key\n211\t    per_file_consumed on str(path) per Option B in the review for\n212\t    clarity; the eq=False guard is defense-in-depth.)\n213\t\n214\t    P2-4: header_raw stores the verbatim bytes (incl. trailing newline)\n215\t    of the header line, so Phase 5 atomic-split writes the byte-identical\n216\t    header to the new .draining.<new_epoch> file (no re-encode drift).\n217\t\n218\t    iter2-P0-3: `quarantined` flag — set by `_quarantine()` after mid-file\n219\t    tamper rename so Phase 5 cleanup SKIPS the entry (the file is already\n220\t    moved aside as .malformed.<epoch>; trying to split would touch a\n221\t    non-existent path or re-sweep the quarantined file).\n222\t    \"\"\"\n223\t\n224\t    path: Path\n225\t    pid: int\n226\t    drain_epoch: str\n227\t    header: Optional[Dict[str, Any]] = None\n228\t    header_raw: bytes = b\"\"\n229\t    body_lines: List[bytes] = field(default_factory=list)\n230\t    consumed_count: int = 0\n231\t    quarantined: bool = False\n232\t\n233\t\n234\tdef _is_alive_pid(pid: int) -> bool:\n235\t    \"\"\"Return True if a process with PID is alive in current namespace.\"\"\"\n236\t    if pid <= 0:\n237\t        return False\n238\t    try:\n239\t        os.kill(pid, 0)\n240\t    except ProcessLookupError:\n241\t        return False\n242\t    except PermissionError:\n243\t        return True\n244\t    except OSError:\n245\t        return False\n246\t    return True\n247\t\n248\t\n249\tdef _parse_spool_pid(name: str) -> Optional[int]:\n250\t    \"\"\"Extract PID from audit-spool.<pid>.* filename forms.\"\"\"\n251\t    if not name.startswith(_SPOOL_PREFIX + \".\"):\n252\t        return None\n253\t    rest = name[len(_SPOOL_PREFIX) + 1:]\n254\t    pid_str, _, _ = rest.partition(\".\")\n255\t    try:\n256\t        return int(pid_str)\n257\t    except ValueError:\n258\t        return None\n259\t\n260\t\n261\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n262\tdef _phase2_sweep_and_rename(\n263\t    state_dir: Path, drain_epoch: str, our_pid: int\n264\t) -> Tuple[List[_DrainingFile], bool]:\n265\t    \"\"\"Sweep state dir for spool/draining files; atomic-rename into batch.\n266\t\n267\t    Returns (list of draining files to process, in_recovery_mode_flag).\n268\t    in_recovery_mode is True iff any pre-existing .draining.* was swept\n269\t    (severity branching for unexpected_skip — ADR-055-AMEND-1 Phase 4).\n270\t    \"\"\"\n271\t    files: List[_DrainingFile] = []\n272\t    in_recovery = False\n273\t\n274\t    try:\n275\t        names = sorted(os.listdir(str(state_dir)))\n276\t    except OSError:\n277\t        return [], False\n278\t\n279\t    # 1) Pre-existing .draining.* — these are stale from prior crashed drains\n280\t    # iter3-P2-2: wire STALE_SPOOL_TTL_DAYS into the sweep. A .draining file\n281\t    # owned by a dead PID (or even a live one) whose mtime is older than\n282\t    # the TTL is forensically interesting — emit an audit_spool_stale_recovered\n283\t    # advisory BEFORE processing so SOC has trace of the long-deferred\n284\t    # recovery. Processing still proceeds; the TTL is advisory-only.\n285\t    stale_ttl_ns = STALE_SPOOL_TTL_DAYS * 86400 * 1_000_000_000\n286\t    now_ns = time.time_ns()\n287\t    for name in names:\n288\t        if _DRAINING_SUFFIX_TOKEN not in name:\n289\t            continue\n290\t        if not name.startswith(_SPOOL_PREFIX + \".\"):\n291\t            continue\n292\t        pid = _parse_spool_pid(name)\n293\t        if pid is None:\n294\t            continue\n295\t        # Parse the existing drain_epoch from the suffix; merge in as-is.\n296\t        try:\n297\t            old_epoch = name.rsplit(_DRAINING_SUFFIX_TOKEN, 1)[1]\n298\t        except IndexError:\n299\t            old_epoch = drain_epoch\n300\t        full_path = state_dir / name\n301\t        # iter3-P2-2: stale-recovery advisory if age > TTL.\n302\t        try:\n303\t            st_mtime_ns = full_path.stat().st_mtime_ns\n304\t            file_age_ns = now_ns - st_mtime_ns\n305\t            if file_age_ns > stale_ttl_ns:\n306\t                file_age_hours = file_age_ns // (3600 * 1_000_000_000)\n307\t                _forensic(\"audit_spool_stale_recovered\", {\n308\t                    \"original_pid\": pid,\n309\t                    \"file_age_hours\": int(file_age_hours),\n310\t                    \"stale_ttl_days\": STALE_SPOOL_TTL_DAYS,\n311\t                    \"drain_epoch\": drain_epoch,\n312\t                    \"prior_drain_epoch\": old_epoch,\n313\t                })\n314\t        except OSError:\n315\t            pass\n316\t        files.append(_DrainingFile(\n317\t            path=full_path, pid=pid, drain_epoch=old_epoch,\n318\t        ))\n319\t        in_recovery = True\n320\t\n321\t    # 2) Active spool files — atomically rename to .draining.<drain_epoch>.\n322\t    #    Skip our own active spool (we hold it open for writes); also skip\n323\t    #    spools of live PIDs other than ours when force-drain is not set —\n324\t    #    let the owning process drain them. (Conservative: live-PID spools\n325\t    #    of OTHER processes will be reaped on next aggregate sweep.)\n326\t    for name in names:\n327\t        if not name.startswith(_SPOOL_PREFIX + \".\"):\n328\t            continue\n329\t        if not name.endswith(\".jsonl\"):\n330\t            continue\n331\t        pid = _parse_spool_pid(name)\n332\t        if pid is None:\n333\t            continue\n334\t        src = state_dir / name\n335\t        try:\n336\t            src_stat = src.stat()\n337\t        except OSError:\n338\t            continue\n339\t        if src_stat.st_size == 0:\n340\t            continue\n341\t        # Only rename our own spool OR clearly-dead PID spools. Live-PID\n342\t        # spools belong to peers — leave them for their own drain trigger\n343\t        # to avoid stealing in-flight writes (writer flock would block us\n344\t        # anyway; explicit check is the cheap path).\n345\t        if pid != our_pid and _is_alive_pid(pid):\n346\t            continue\n347\t        # iter4-P2-1: stale-recovery advisory ALSO covers active spool files\n348\t        # whose owning PID is dead AND mtime is older than TTL (ADR-055-\n349\t        # AMEND-1 §A.4.5 covers both .draining.* AND orphaned active\n350\t        # spools). Emit BEFORE the rename so SOC trace carries the\n351\t        # forensic correlation between the orphan and the drain epoch.\n352\t        if pid != our_pid:\n353\t            try:\n354\t                file_age_ns = now_ns - src_stat.st_mtime_ns\n355\t                if file_age_ns > stale_ttl_ns:\n356\t                    file_age_hours = file_age_ns // (3600 * 1_000_000_000)\n357\t                    _forensic(\"audit_spool_stale_recovered\", {\n358\t                        \"original_pid\": pid,\n359\t                        \"file_age_hours\": int(file_age_hours),\n360\t                        \"stale_ttl_days\": STALE_SPOOL_TTL_DAYS,\n361\t                        \"drain_epoch\": drain_epoch,\n362\t                        \"source\": \"active_spool_orphan\",\n363\t                    })\n364\t            except OSError:\n365\t                pass\n366\t        # P0-1: use _draining_path helper (was: missing dot before draining)\n367\t        dst = _draining_path(src, drain_epoch)\n368\t        # iter3-P1-2: acquire the per-PID spool flock around rename so a\n369\t        # concurrent writer mid-spool_append in the same PID (e.g. signal-\n370\t        # handler-triggered drain racing the writer's own fd) is forced to\n371\t        # complete before we steal the file. Writers hold the flock for\n372\t        # ~10µs per emit; a short timeout (0.5s) is sufficient. If we time\n373\t        # out, we skip this PID this cycle — the spool gets picked up at\n374\t        # next drain trigger. Either path is correctness-preserving.\n375\t        try:\n376\t            with FileLock(_spool_flock_path(pid), timeout=0.5):\n377\t                # Re-check existence under lock (writer may have unlinked\n378\t                # during contention, or another concurrent drain in our PID\n379\t                # could have renamed it first).\n380\t                try:\n381\t                    if not src.exists() or src.stat().st_size == 0:\n382\t                        continue\n383\t                except OSError:\n384\t                    continue\n385\t                try:\n386\t                    os.rename(str(src), str(dst))\n387\t                except OSError as e:\n388\t                    _breadcrumb(\n389\t                        f\"phase2 rename failed for {name}: \"\n390\t                        f\"{type(e).__name__}: {e}\"\n391\t                    )\n392\t                    continue\n393\t        except FileLockTimeout:\n394\t            # Writer is mid-append on this spool; defer to next drain\n395\t            # cycle. The spool size/mtime trigger will catch it.\n396\t            _breadcrumb(\n397\t                f\"phase2 spool flock timeout pid={pid} (writer mid-append)\"\n398\t            )\n399\t            continue\n400\t        files.append(_DrainingFile(\n401\t            path=dst, pid=pid, drain_epoch=drain_epoch,\n402\t        ))\n403\t        # If the renamed-away spool belonged to our pid, reset our header\n404\t        # cache so subsequent spool_append mints a fresh _spool_uuid.\n405\t        if pid == our_pid:\n406\t            _SPOOL_HEADER_CACHE.pop(pid, None)\n407\t            _ORDINAL_COUNTER.pop(pid, None)\n408\t\n409\t    return files, in_recovery\n410\t\n411\t\n412\tdef _quarantine(\n413\t    file: _DrainingFile, mismatch_kind: str, drain_epoch: str\n414\t) -> None:\n415\t    \"\"\"Rename a malformed/tampered spool to .malformed.<drain_epoch>; emit.\n416\t\n417\t    iter2-P0-3: sets `file.quarantined = True` so Phase 5 cleanup skips the\n418\t    entry (the source .draining.<epoch> no longer exists at its original\n419\t    path — trying to split or unlink would either fail or, worse, re-sweep\n420\t    the renamed .malformed.<epoch> file on a subsequent drain.\n421\t    \"\"\"\n422\t    try:\n423\t        new_name = file.path.name.replace(\n424\t            _DRAINING_SUFFIX_TOKEN[1:] + file.drain_epoch,\n425\t            _MALFORMED_SUFFIX_TOKEN[1:] + drain_epoch,\n426\t            1,\n427\t        )\n428\t        new_path = file.path.with_name(new_name)\n429\t        os.rename(str(file.path), str(new_path))\n430\t    except OSError as e:\n431\t        _breadcrumb(f\"quarantine rename failed: {type(e).__name__}: {e}\")\n432\t    # iter2-P0-3: latch quarantined flag for Phase 5 cleanup skip.\n433\t    file.quarantined = True\n434\t    _forensic(\"audit_spool_tamper_detected\", {\n435\t        \"mismatch_kind\": mismatch_kind,\n436\t        \"spool_pid\": file.pid,\n437\t        \"drain_epoch\": drain_epoch,\n438\t    })\n439\t\n440\t\n441\tdef _should_quarantine_test_origin(\n442\t    file: \"_DrainingFile\", canonical_log_path: Path\n443\t) -> bool:\n444\t    \"\"\"PLAN-119 WS-D1 — True iff this spool is ``_origin:\"test\"`` AND the\n445\t    canonical drain destination IS the live chain.\n446\t\n447\t    Conjunction-gated (Codex R2 P0-1): a redirected pytest/session tmp dir is\n448\t    NOT the live chain, so a ``\"test\"`` spool drains NORMALLY there (isolated\n449\t    drain-behavior tests keep working). Fail-SAFE to NO quarantine (Codex R3\n450\t    P1-1) when the live-log snapshot is absent/unreadable — never risk dropping a\n451\t    real event. Legacy spool with no ``_origin`` (or ``_origin:\"live\"``) is never\n452\t    quarantined.\n453\t    \"\"\"\n454\t    header = file.header\n455\t    if not isinstance(header, dict) or header.get(\"_origin\") != \"test\":\n456\t        return False\n457\t    snapshot = os.environ.get(_LIVE_LOG_SNAPSHOT_VAR)\n458\t    if not snapshot:\n459\t        return False  # cannot confirm destination is live → drain normally\n460\t    try:\n461\t        return Path(canonical_log_path).resolve() == Path(snapshot).resolve()\n462\t    except (OSError, ValueError):\n463\t        return False\n464\t\n465\t\n466\tdef _quarantine_test_origin(file: \"_DrainingFile\", drain_epoch: str) -> None:\n467\t    \"\"\"PLAN-119 WS-D1 — rename an ``_origin:\"test\"`` spool out of the drain path\n468\t    so its entries never reach the live canonical append.\n469\t\n470\t    Breadcrumb-only — no new audit action (the canonical ``_KNOWN_ACTIONS`` is a\n471\t    kernel-HARD-DENY surface; the rename + the ``DrainStats`` counter are the\n472\t    durable trace). Mirrors ``_quarantine``'s rename discipline (latches\n473\t    ``file.quarantined`` so Phase 5 cleanup skips the moved file).\n474\t    \"\"\"\n475\t    try:\n476\t        new_name = file.path.name.replace(\n477\t            _DRAINING_SUFFIX_TOKEN[1:] + file.drain_epoch,\n478\t            _TEST_ORIGIN_SUFFIX_TOKEN[1:] + drain_epoch,\n479\t            1,\n480\t        )\n481\t        new_path = file.path.with_name(new_name)\n482\t        os.rename(str(file.path), str(new_path))\n483\t    except OSError as e:\n484\t        _breadcrumb(\n485\t            f\"test-origin quarantine rename failed: {type(e).__name__}: {e}\"\n486\t        )\n487\t    file.quarantined = True\n488\t    # Codex P1 — compact the quarantined spool's journal records so session-start\n489\t    # reconciliation does NOT later count them as inflight/lost and emit a spurious\n490\t    # ``audit_flush_dropped_count``. A deliberate test-origin quarantine is a\n491\t    # COMPLETION (the entries are intentionally not drained to the live chain),\n492\t    # not a real-event loss. ``file.body_lines`` is populated by Phase 2.\n493\t    try:\n494\t        rec_ids = []\n495\t        for raw in (file.body_lines or []):\n496\t            try:\n497\t                entry = json.loads(raw.decode(\"utf-8\"))\n498\t            except (json.JSONDecodeError, UnicodeDecodeError):\n499\t                continue\n500\t            rid = entry.get(\"record_id\") if isinstance(entry, dict) else None\n501\t            if isinstance(rid, str) and rid:\n502\t                rec_ids.append(rid)\n503\t        if rec_ids:\n504\t            _journal_compact_drained(file.pid, rec_ids, drain_epoch)\n505\t    except Exception as e:  # pragma: no cover — journal hygiene, never blocks\n506\t        _breadcrumb(\n507\t            f\"test-origin journal compaction failed: {type(e).__name__}: {e}\"\n508\t        )\n509\t    _breadcrumb(\n510\t        f\"test-origin spool refused at live-chain drain: pid={file.pid} \"\n511\t        f\"epoch={drain_epoch}\"\n512\t    )\n513\t\n514\t\n515\tdef _phase2_validate_header(\n516\t    file: _DrainingFile, drain_epoch: str\n517\t) -> bool:\n518\t    \"\"\"Read header + first body line; validate body[0].spool_uuid sentinel.\n519\t\n520\t    Returns True iff header is well-formed AND header._spool_uuid matches\n521\t    body[0].spool_uuid (when body is non-empty). Quarantines on mismatch.\n522\t    Loads body_lines into file as a side effect.\n523\t    \"\"\"\n524\t    try:\n525\t        raw_lines = file.path.read_bytes().split(b\"\\n\")\n526\t    except OSError as e:\n527\t        _breadcrumb(f\"phase2 read failed: {type(e).__name__}: {e}\")\n528\t        return False\n529\t\n530\t    # Strip trailing empty fragment from final newline\n531\t    if raw_lines and raw_lines[-1] == b\"\":\n532\t        raw_lines = raw_lines[:-1]\n533\t\n534\t    if not raw_lines:\n535\t        # Empty file; nothing to do — caller treats as fully-consumed\n536\t        file.header = None\n537\t        file.body_lines = []\n538\t        return True\n539\t\n540\t    # Parse header\n541\t    try:\n542\t        header = json.loads(raw_lines[0].decode(\"utf-8\"))\n543\t    except (json.JSONDecodeError, UnicodeDecodeError):\n544\t        _quarantine(file, \"malformed_spool_header\", drain_epoch)\n545\t        return False\n546\t    # iter5-P1: use the shared strict predicate (same one used by\n547\t    # _ensure_spool_header for writer-side reuse) so writer and drainer\n548\t    # validation are byte-equivalent.\n549\t    if not _validate_spool_header_strict(header):\n550\t        _quarantine(file, \"malformed_spool_header\", drain_epoch)\n551\t        return False\n552\t\n553\t    file.header = header\n554\t    # P2-4: verbatim header bytes for Phase 5 atomic split\n555\t    file.header_raw = raw_lines[0] + b\"\\n\"\n556\t    file.body_lines = raw_lines[1:]\n557\t\n558\t    if not file.body_lines:\n559\t        return True\n560\t\n561\t    # body[0] sentinel\n562\t    body0_raw = file.body_lines[0]\n563\t    try:\n564\t        body0 = json.loads(body0_raw.decode(\"utf-8\"))\n565\t    except (json.JSONDecodeError, UnicodeDecodeError):\n566\t        # body[0] malformed → if it's the ONLY body line, treat as partial-\n567\t        # line crash (Phase 3 discard). Otherwise quarantine (mid-file\n568\t        # malformed is suspicious).\n569\t        if len(file.body_lines) == 1:\n570\t            return True\n571\t        _quarantine(file, \"malformed_spool_header\", drain_epoch)\n572\t        return False\n573\t    # PLAN-094-FOLLOWUP bug fix: extract spool_uuid from validated header\n574\t    # (was UnboundLocalError NameError — refactor regression from\n575\t    # _validate_spool_header_strict extraction; caught by Wave A.7r.1 test).\n576\t    spool_uuid = header[\"_spool_uuid\"]\n577\t    if not isinstance(body0, dict) or body0.get(\"spool_uuid\") != spool_uuid:\n578\t        _quarantine(file, \"header_body_uuid_mismatch\", drain_epoch)\n579\t        return False\n580\t    return True\n581\t\n582\t\n583\t# ---------------------------------------------------------------------------\n584\t# Phase 3 — sort + 4-tuple uniqueness\n585\t# ---------------------------------------------------------------------------\n586\t\n587\t\n588\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n589\tdef _phase3_collect_and_sort(\n590\t    files: List[_DrainingFile], drain_epoch: str, stats: DrainStats,\n591\t) -> Tuple[\n592\t    List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]],\n593\t    Dict[str, Set[int]],\n594\t    int,\n595\t]:\n596\t    \"\"\"Parse body lines from each draining file; sort by 4-tuple; de-dup.\n597\t\n598\t    Returns (deduped, partial_discard_consumed_indices_by_path,\n599\t    duplicate_consumed_count).\n600\t\n601\t    iter4-P2-2: returns the count of duplicate-tuple entries marked\n602\t    consumed in this cycle so Phase 4 can carry it as the starting\n603\t    `processed` value. Without this, a duplicate storm (e.g. corrupted\n604\t    spool with N identical 4-tuples) consumes/deletes more than K_MAX\n605\t    entries in one drain cycle, softening the K_MAX hard-cap perf\n606\t    contract (correctness preserved — duplicates ARE discarded).\n607\t\n608\t    iter2-P0-1: partial-discard tracking is now a Set[int] of body indices\n609\t    (not a prefix-count). Phase 5 splits the file using the COMPLEMENT of\n610\t    the set, so out-of-order index consumption (later index handled before\n611\t    earlier index) is safe.\n612\t\n613\t    iter2-P0-2: duplicate 4-tuple is marked CONSUMED (added to the per-file\n614\t    set) so Phase 5 cleanup actually removes it from disk; without this,\n615\t    the rejected entry survives split → re-detected as duplicate forever\n616\t    (livelock). audit_spool_intentionally_deleted advisory emits.\n617\t\n618\t    iter2-P2-2: per-file ordinal monotonicity check — within each spool\n619\t    file, `ordinal_within_file` of entry N+1 must be > entry N (the writer\n620\t    issues strictly-monotonic ordinals via _next_ordinal()). Violation →\n621\t    quarantine source with mismatch_kind=\"ordinal_monotonicity_violation\".\n622\t\n623\t    Tamper / malformed handling:\n624\t    - JSON-parse fail on the LAST line of a file → partial-line discard\n625\t      (writer SIGKILL mid-write); emit audit_spool_partial_line_discarded\n626\t    - JSON-parse fail on any OTHER line → tamper; quarantine the file and\n627\t      drop ALL its remaining unconsumed body entries.\n628\t    - Duplicate full 4-tuple → reject with audit_spool_duplicate_tuple_rejected;\n629\t      mark consumed (iter2-P0-2).\n630\t    - Ordinal monotonicity violation → quarantine (iter2-P2-2).\n631\t    \"\"\"\n632\t    collected: List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]] = []\n633\t    partial_consumed: Dict[str, Set[int]] = {}\n634\t\n635\t    def _mark(path_str: str, idx: int) -> None:\n636\t        partial_consumed.setdefault(path_str, set()).add(idx)\n637\t\n638\t    for f in files:\n639\t        if not f.body_lines:\n640\t            continue\n641\t        last_idx = len(f.body_lines) - 1\n642\t        path_key = str(f.path)\n643\t        # iter2-P2-2: per-file ordinal monotonicity tracking.\n644\t        prev_ordinal: Optional[int] = None\n645\t        for idx, raw in enumerate(f.body_lines):\n646\t            if not raw:\n647\t                # Empty line (double-newline) — discard silently but mark\n648\t                # consumed so Phase 5 doesn't perpetually re-split it.\n649\t                _mark(path_key, idx)\n650\t                continue\n651\t            try:\n652\t                obj = json.loads(raw.decode(\"utf-8\"))\n653\t            except (json.JSONDecodeError, UnicodeDecodeError):\n654\t                if idx == last_idx:\n655\t                    stats.partial_lines_discarded += 1\n656\t                    _forensic(\"audit_spool_partial_line_discarded\", {\n657\t                        \"spool_pid\": f.pid,\n658\t                        \"drain_epoch\": drain_epoch,\n659\t                        \"body_index\": idx,\n660\t                    })\n661\t                    # iter2-P0-1: mark this index consumed so Phase 5\n662\t                    # split treats the partial line as handled.\n663\t                    _mark(path_key, idx)\n664\t                    continue\n665\t                # Mid-file malformed — quarantine file and stop collecting\n666\t                # from it (subsequent entries are suspect)\n667\t                _quarantine(f, \"malformed_spool_header\", drain_epoch)\n668\t                stats.quarantined_files += 1\n669\t                # Drop any entries already collected from this file:\n670\t                collected = [c for c in collected if c[2] is not f]\n671\t                partial_consumed.pop(path_key, None)\n672\t                break\n673\t            if not isinstance(obj, dict):\n674\t                if idx == last_idx:\n675\t                    stats.partial_lines_discarded += 1\n676\t                    _mark(path_key, idx)  # iter2-P0-1\n677\t                    continue\n678\t                _quarantine(f, \"malformed_spool_header\", drain_epoch)\n679\t                stats.quarantined_files += 1\n680\t                collected = [c for c in collected if c[2] is not f]\n681\t                partial_consumed.pop(path_key, None)\n682\t                break\n683\t            try:\n684\t                wall_ns = int(obj[\"wall_ns\"])\n685\t                pid = int(obj[\"pid\"])\n686\t                spool_uuid = str(obj[\"spool_uuid\"])\n687\t                ordinal = int(obj[\"ordinal_within_file\"])\n688\t            except (KeyError, TypeError, ValueError):\n689\t                # Missing 4-tuple field — treat as tamper (would also break\n690\t                # HMAC since spool_uuid participates in canonical_json)\n691\t                _quarantine(f, \"malformed_spool_header\", drain_epoch)\n692\t                stats.quarantined_files += 1\n693\t                collected = [c for c in collected if c[2] is not f]\n694\t                partial_consumed.pop(path_key, None)\n695\t                break\n696\t            # iter2-P2-2: per-file ordinal monotonicity (strictly increasing).\n697\t            if prev_ordinal is not None and ordinal <= prev_ordinal:\n698\t                _quarantine(f, \"ordinal_monotonicity_violation\", drain_epoch)\n699\t                stats.quarantined_files += 1\n700\t                collected = [c for c in collected if c[2] is not f]\n701\t                partial_consumed.pop(path_key, None)\n702\t                break\n703\t            prev_ordinal = ordinal\n704\t            key = (wall_ns, pid, spool_uuid, ordinal)\n705\t            collected.append((key, obj, f, idx))\n706\t\n707\t    collected.sort(key=lambda x: x[0])\n708\t\n709\t    deduped: List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]] = []\n710\t    seen: set = set()\n711\t    # iter4-P2-2: bound duplicate-cleanup to K_MAX so a storm can't exceed\n712\t    # the per-cycle perf cap. Unmarked duplicates survive split → next\n713\t    # drain re-detects → bounded amortization (correctness preserved; no\n714\t    # canonical append happens for duplicates either way).\n715\t    duplicate_consumed = 0\n716\t    for key, obj, f, idx in collected:\n717\t        if key in seen:\n718\t            if duplicate_consumed >= K_MAX:\n719\t                # Still record the forensic so SOC sees the rejection,\n720\t                # but DO NOT _mark() consumed (defer to next cycle).\n721\t                stats.rejected_duplicate_tuple += 1\n722\t                _forensic(\"audit_spool_duplicate_tuple_rejected\", {\n723\t                    \"wall_ns\": key[0],\n724\t                    \"pid\": key[1],\n725\t                    \"spool_uuid\": key[2],\n726\t                    \"ordinal_within_file\": key[3],\n727\t                    \"drain_epoch\": drain_epoch,\n728\t                    \"deferred_to_next_cycle\": True,\n729\t                })\n730\t                continue\n731\t            stats.rejected_duplicate_tuple += 1\n732\t            _forensic(\"audit_spool_duplicate_tuple_rejected\", {\n733\t                \"wall_ns\": key[0],\n734\t                \"pid\": key[1],\n735\t                \"spool_uuid\": key[2],\n736\t                \"ordinal_within_file\": key[3],\n737\t                \"drain_epoch\": drain_epoch,\n738\t            })\n739\t            # iter2-P0-2: mark the duplicate's body index CONSUMED so Phase 5\n740\t            # actually removes it from disk (otherwise the rejected entry\n741\t            # survives split → re-detected forever = livelock). Emit a\n742\t            # paired advisory so SOC has trace of the silent deletion.\n743\t            _mark(str(f.path), idx)\n744\t            # iter3-P2-1: surface count into DrainStats for AC10 visibility\n745\t            # (JournalReconciliation aggregates this at session-start).\n746\t            stats.intentionally_deleted += 1\n747\t            duplicate_consumed += 1\n748\t            _forensic(\"audit_spool_intentionally_deleted\", {\n749\t                \"reason\": \"duplicate_tuple\",\n750\t                \"spool_pid\": key[1],\n751\t                \"spool_uuid\": key[2],\n752\t                \"ordinal_within_file\": key[3],\n753\t                \"drain_epoch\": drain_epoch,\n754\t            })\n755\t            continue\n756\t        seen.add(key)\n757\t        deduped.append((key, obj, f, idx))\n758\t    return deduped, partial_consumed, duplicate_consumed\n759\t\n760\t\n761\t# ---------------------------------------------------------------------------\n762\t# Phase 4 — idempotent chain reconstruction\n763\t# ---------------------------------------------------------------------------\n764\t"}]},"parent_tool_use_id":null,"session_id":"0b7193d9-2764-4133-b585-5164ec8d2baf","uuid":"c6058c8c-250d-488c-b586-0facdaf1cf68","timestamp":"2026-11-13T17:52:26.379Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_spool_writer_parts/prepare.py","content":"# PLAN-094 Wave A — spool_writer (canonical promotion of spool_writer_DRAFT.py)\n\"\"\"_lib/spool_writer.py — durable spool + drain-on-next-invoke (PLAN-094 Wave A).\n\nImplements ADR-055-AMEND-1: 5-phase atomic drain protocol, 4-tuple total\norder across concurrent producers, K_MAX/K_TAIL_WINDOW idempotent skip,\ncanonical-tail prev_hmac reconstruction, per-PID spool + per-PID journal,\natomic split-and-delete for K_MAX deferral, header/body uuid sentinel.\n\nStdlib-only (ADR-002). Fail-open invariant — never raise to caller; any\ninfra failure emits a breadcrumb and returns safely.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport atexit\nimport hashlib\nimport json\nimport os\nimport re\nimport secrets\nimport signal\nimport sys\nimport time\nimport uuid\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, Iterable, List, Optional, Set, Tuple\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\nfrom _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\nfrom _lib import runtime_paths as _runtime_paths  # noqa: E402  # PLAN-182 W1 single resolver (ADR-001 S318)\n\ntry:\n    from _lib import audit_hmac as _audit_hmac  # noqa: E402\n    _HMAC_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _audit_hmac = None  # type: ignore[assignment]\n    _HMAC_AVAILABLE = False\n\ntry:\n    from _lib import canonical_json as _canonical_json  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _canonical_json = None  # type: ignore[assignment]\n\n\n# ---------------------------------------------------------------------------\n# Constants (ADR-055-AMEND-1 §3 wave A spec)\n# ---------------------------------------------------------------------------\n\nK_MAX = 100\nK_TAIL_WINDOW = 200\nSPOOL_HEADER_VERSION = 1\n# PLAN-111 Wave B-alt4 (debate consensus + cProfile data-driven): trigger\n# raised 50 -> 100. Halves drain cascade count (40 -> 20 across 5-trial\n# emit_pair benchmark, confirmed by cprofile-post-b-darwin.txt). Per-trial\n# wall-clock 174ms -> 170ms (-2%); cumulative drain_now cumtime 364ms -> 307ms.\n# Combined with Wave A cache: per-emit 580us -> 425us (-27%). AC-C1 strict\n# <=360us NOT hit alone; Wave C.1 RELAX path engaged (200->300ms test\n# budget) with ubuntu projection ~255ms still well under.\nDRAIN_TRIGGER_SIZE = 100\nDRAIN_TRIGGER_MTIME_MS = 100\nSTALE_SPOOL_TTL_DAYS = 7\nSPOOL_LOCK_TIMEOUT = 2.5\n\n\n__all__ = (\n    'should_drain',\n    '_read_canonical_tail',\n    '_DrainingFile',\n    '_is_alive_pid',\n    '_parse_spool_pid',\n    '_phase2_sweep_and_rename',\n    '_quarantine',\n    '_should_quarantine_test_origin',\n    '_quarantine_test_origin',\n    '_phase2_validate_header',\n    '_phase3_collect_and_sort',\n)\n\ndef should_drain() -> bool:\n    \"\"\"Return True if current spool meets event-count or staleness trigger.\n\n    P2-1: event-count trigger uses an actual newline-count over the spool\n    body (capped at DRAIN_TRIGGER_SIZE + 2 to keep the probe cheap), NOT\n    a byte-size proxy. Header is 1 line; we trigger when body lines >=\n    DRAIN_TRIGGER_SIZE.\n    \"\"\"\n    try:\n        pid = os.getpid()\n        p = _spool_path(pid)\n        if not p.exists():\n            return False\n        st = p.stat()\n        if st.st_size == 0:\n            return False\n        # Staleness trigger first (cheap)\n        age_ms = (time.time() - st.st_mtime) * 1000.0\n        if age_ms > DRAIN_TRIGGER_MTIME_MS:\n            return True\n        # P2-1: honest newline count, capped at DRAIN_TRIGGER_SIZE + 2\n        # (1 for header + 1 to early-exit once we cross the threshold).\n        cap = DRAIN_TRIGGER_SIZE + 2\n        count = 0\n        try:\n            with p.open(\"rb\") as f:\n                while count < cap:\n                    chunk = f.read(8192)\n                    if not chunk:\n                        break\n                    count += chunk.count(b\"\\n\")\n                    if count >= cap:\n                        break\n        except OSError:\n            return False\n        # Body lines = count - 1 (header is line 1). Trigger when\n        # body_lines >= DRAIN_TRIGGER_SIZE → count >= DRAIN_TRIGGER_SIZE+1.\n        return count >= (DRAIN_TRIGGER_SIZE + 1)\n    except Exception:\n        return False\n\n\n# ---------------------------------------------------------------------------\n# Tail read of canonical log (Phase 4 prev_hmac + _drain_sha256 set)\n# ---------------------------------------------------------------------------\n\n\ndef _read_canonical_tail(\n    log_path: Path, k_lines: int\n) -> Tuple[Optional[bytes], List[Dict[str, Any]]]:\n    \"\"\"Return (prev_hmac_bytes_or_None, last_k_entries) from canonical log.\n\n    Reads up to k_lines from EOF using a backward chunked scan. Returns the\n    last entry's hmac (raw bytes) plus the parsed dicts for the last K\n    well-formed JSON lines. Empty / missing log → (None, []).\n    \"\"\"\n    if not log_path.exists():\n        return None, []\n    try:\n        size = log_path.stat().st_size\n    except OSError:\n        return None, []\n    if size == 0:\n        return None, []\n\n    chunk = 8192\n    buf = b\"\"\n    lines: List[bytes] = []\n    try:\n        with log_path.open(\"rb\") as f:\n            pos = size\n            while pos > 0 and len(lines) <= k_lines:\n                read = min(chunk, pos)\n                pos -= read\n                f.seek(pos)\n                buf = f.read(read) + buf\n                parts = buf.split(b\"\\n\")\n                # First element may be a partial fragment until we read\n                # further; keep it in buf, take the tail-complete lines.\n                buf = parts[0]\n                # parts[1:] are complete lines (after the first newline).\n                # Reverse so we accumulate newest-first.\n                for ln in reversed(parts[1:]):\n                    if ln:\n                        lines.append(ln)\n                    if len(lines) >= k_lines:\n                        break\n            if pos == 0 and buf:\n                if len(lines) < k_lines:\n                    lines.append(buf)\n    except OSError as e:\n        _breadcrumb(f\"canonical tail read failed: {type(e).__name__}: {e}\")\n        return None, []\n\n    # lines is newest-first; reverse to chronological order\n    lines.reverse()\n    entries: List[Dict[str, Any]] = []\n    for raw in lines[-k_lines:]:\n        try:\n            obj = json.loads(raw.decode(\"utf-8\"))\n            if isinstance(obj, dict):\n                entries.append(obj)\n        except (json.JSONDecodeError, UnicodeDecodeError):\n            continue\n\n    prev_hmac: Optional[bytes] = None\n    for obj in reversed(entries):\n        hx = obj.get(\"hmac\")\n        if isinstance(hx, str) and len(hx) == 64:\n            try:\n                prev_hmac = bytes.fromhex(hx)\n                break\n            except ValueError:\n                continue\n    return prev_hmac, entries\n\n\n# ---------------------------------------------------------------------------\n# Phase 2 — sweep + atomic rename + header validation\n# ---------------------------------------------------------------------------\n\n\n@dataclass(eq=False)\nclass _DrainingFile:\n    \"\"\"One file under drain in the current cycle.\n\n    P0-2: declared eq=False so default object identity hash applies —\n    instances are usable as Dict keys without TypeError. (We still key\n    per_file_consumed on str(path) per Option B in the review for\n    clarity; the eq=False guard is defense-in-depth.)\n\n    P2-4: header_raw stores the verbatim bytes (incl. trailing newline)\n    of the header line, so Phase 5 atomic-split writes the byte-identical\n    header to the new .draining.<new_epoch> file (no re-encode drift).\n\n    iter2-P0-3: `quarantined` flag — set by `_quarantine()` after mid-file\n    tamper rename so Phase 5 cleanup SKIPS the entry (the file is already\n    moved aside as .malformed.<epoch>; trying to split would touch a\n    non-existent path or re-sweep the quarantined file).\n    \"\"\"\n\n    path: Path\n    pid: int\n    drain_epoch: str\n    header: Optional[Dict[str, Any]] = None\n    header_raw: bytes = b\"\"\n    body_lines: List[bytes] = field(default_factory=list)\n    consumed_count: int = 0\n    quarantined: bool = False\n\n\ndef _is_alive_pid(pid: int) -> bool:\n    \"\"\"Return True if a process with PID is alive in current namespace.\"\"\"\n    if pid <= 0:\n        return False\n    try:\n        os.kill(pid, 0)\n    except ProcessLookupError:\n        return False\n    except PermissionError:\n        return True\n    except OSError:\n        return False\n    return True\n\n\ndef _parse_spool_pid(name: str) -> Optional[int]:\n    \"\"\"Extract PID from audit-spool.<pid>.* filename forms.\"\"\"\n    if not name.startswith(_SPOOL_PREFIX + \".\"):\n        return None\n    rest = name[len(_SPOOL_PREFIX) + 1:]\n    pid_str, _, _ = rest.partition(\".\")\n    try:\n        return int(pid_str)\n    except ValueError:\n        return None\n\n\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef _phase2_sweep_and_rename(\n    state_dir: Path, drain_epoch: str, our_pid: int\n) -> Tuple[List[_DrainingFile], bool]:\n    \"\"\"Sweep state dir for spool/draining files; atomic-rename into batch.\n\n    Returns (list of draining files to process, in_recovery_mode_flag).\n    in_recovery_mode is True iff any pre-existing .draining.* was swept\n    (severity branching for unexpected_skip — ADR-055-AMEND-1 Phase 4).\n    \"\"\"\n    files: List[_DrainingFile] = []\n    in_recovery = False\n\n    try:\n        names = sorted(os.listdir(str(state_dir)))\n    except OSError:\n        return [], False\n\n    # 1) Pre-existing .draining.* — these are stale from prior crashed drains\n    # iter3-P2-2: wire STALE_SPOOL_TTL_DAYS into the sweep. A .draining file\n    # owned by a dead PID (or even a live one) whose mtime is older than\n    # the TTL is forensically interesting — emit an audit_spool_stale_recovered\n    # advisory BEFORE processing so SOC has trace of the long-deferred\n    # recovery. Processing still proceeds; the TTL is advisory-only.\n    stale_ttl_ns = STALE_SPOOL_TTL_DAYS * 86400 * 1_000_000_000\n    now_ns = time.time_ns()\n    for name in names:\n        if _DRAINING_SUFFIX_TOKEN not in name:\n            continue\n        if not name.startswith(_SPOOL_PREFIX + \".\"):\n            continue\n        pid = _parse_spool_pid(name)\n        if pid is None:\n            continue\n        # Parse the existing drain_epoch from the suffix; merge in as-is.\n        try:\n            old_epoch = name.rsplit(_DRAINING_SUFFIX_TOKEN, 1)[1]\n        except IndexError:\n            old_epoch = drain_epoch\n        full_path = state_dir / name\n        # iter3-P2-2: stale-recovery advisory if age > TTL.\n        try:\n            st_mtime_ns = full_path.stat().st_mtime_ns\n            file_age_ns = now_ns - st_mtime_ns\n            if file_age_ns > stale_ttl_ns:\n                file_age_hours = file_age_ns // (3600 * 1_000_000_000)\n                _forensic(\"audit_spool_stale_recovered\", {\n                    \"original_pid\": pid,\n                    \"file_age_hours\": int(file_age_hours),\n                    \"stale_ttl_days\": STALE_SPOOL_TTL_DAYS,\n                    \"drain_epoch\": drain_epoch,\n                    \"prior_drain_epoch\": old_epoch,\n                })\n        except OSError:\n            pass\n        files.append(_DrainingFile(\n            path=full_path, pid=pid, drain_epoch=old_epoch,\n        ))\n        in_recovery = True\n\n    # 2) Active spool files — atomically rename to .draining.<drain_epoch>.\n    #    Skip our own active spool (we hold it open for writes); also skip\n    #    spools of live PIDs other than ours when force-drain is not set —\n    #    let the owning process drain them. (Conservative: live-PID spools\n    #    of OTHER processes will be reaped on next aggregate sweep.)\n    for name in names:\n        if not name.startswith(_SPOOL_PREFIX + \".\"):\n            continue\n        if not name.endswith(\".jsonl\"):\n            continue\n        pid = _parse_spool_pid(name)\n        if pid is None:\n            continue\n        src = state_dir / name\n        try:\n            src_stat = src.stat()\n        except OSError:\n            continue\n        if src_stat.st_size == 0:\n            continue\n        # Only rename our own spool OR clearly-dead PID spools. Live-PID\n        # spools belong to peers — leave them for their own drain trigger\n        # to avoid stealing in-flight writes (writer flock would block us\n        # anyway; explicit check is the cheap path).\n        if pid != our_pid and _is_alive_pid(pid):\n            continue\n        # iter4-P2-1: stale-recovery advisory ALSO covers active spool files\n        # whose owning PID is dead AND mtime is older than TTL (ADR-055-\n        # AMEND-1 §A.4.5 covers both .draining.* AND orphaned active\n        # spools). Emit BEFORE the rename so SOC trace carries the\n        # forensic correlation between the orphan and the drain epoch.\n        if pid != our_pid:\n            try:\n                file_age_ns = now_ns - src_stat.st_mtime_ns\n                if file_age_ns > stale_ttl_ns:\n                    file_age_hours = file_age_ns // (3600 * 1_000_000_000)\n                    _forensic(\"audit_spool_stale_recovered\", {\n                        \"original_pid\": pid,\n                        \"file_age_hours\": int(file_age_hours),\n                        \"stale_ttl_days\": STALE_SPOOL_TTL_DAYS,\n                        \"drain_epoch\": drain_epoch,\n                        \"source\": \"active_spool_orphan\",\n                    })\n            except OSError:\n                pass\n        # P0-1: use _draining_path helper (was: missing dot before draining)\n        dst = _draining_path(src, drain_epoch)\n        # iter3-P1-2: acquire the per-PID spool flock around rename so a\n        # concurrent writer mid-spool_append in the same PID (e.g. signal-\n        # handler-triggered drain racing the writer's own fd) is forced to\n        # complete before we steal the file. Writers hold the flock for\n        # ~10µs per emit; a short timeout (0.5s) is sufficient. If we time\n        # out, we skip this PID this cycle — the spool gets picked up at\n        # next drain trigger. Either path is correctness-preserving.\n        try:\n            with FileLock(_spool_flock_path(pid), timeout=0.5):\n                # Re-check existence under lock (writer may have unlinked\n                # during contention, or another concurrent drain in our PID\n                # could have renamed it first).\n                try:\n                    if not src.exists() or src.stat().st_size == 0:\n                        continue\n                except OSError:\n                    continue\n                try:\n                    os.rename(str(src), str(dst))\n                except OSError as e:\n                    _breadcrumb(\n                        f\"phase2 rename failed for {name}: \"\n                        f\"{type(e).__name__}: {e}\"\n                    )\n                    continue\n        except FileLockTimeout:\n            # Writer is mid-append on this spool; defer to next drain\n            # cycle. The spool size/mtime trigger will catch it.\n            _breadcrumb(\n                f\"phase2 spool flock timeout pid={pid} (writer mid-append)\"\n            )\n            continue\n        files.append(_DrainingFile(\n            path=dst, pid=pid, drain_epoch=drain_epoch,\n        ))\n        # If the renamed-away spool belonged to our pid, reset our header\n        # cache so subsequent spool_append mints a fresh _spool_uuid.\n        if pid == our_pid:\n            _SPOOL_HEADER_CACHE.pop(pid, None)\n            _ORDINAL_COUNTER.pop(pid, None)\n\n    return files, in_recovery\n\n\ndef _quarantine(\n    file: _DrainingFile, mismatch_kind: str, drain_epoch: str\n) -> None:\n    \"\"\"Rename a malformed/tampered spool to .malformed.<drain_epoch>; emit.\n\n    iter2-P0-3: sets `file.quarantined = True` so Phase 5 cleanup skips the\n    entry (the source .draining.<epoch> no longer exists at its original\n    path — trying to split or unlink would either fail or, worse, re-sweep\n    the renamed .malformed.<epoch> file on a subsequent drain.\n    \"\"\"\n    try:\n        new_name = file.path.name.replace(\n            _DRAINING_SUFFIX_TOKEN[1:] + file.drain_epoch,\n            _MALFORMED_SUFFIX_TOKEN[1:] + drain_epoch,\n            1,\n        )\n        new_path = file.path.with_name(new_name)\n        os.rename(str(file.path), str(new_path))\n    except OSError as e:\n        _breadcrumb(f\"quarantine rename failed: {type(e).__name__}: {e}\")\n    # iter2-P0-3: latch quarantined flag for Phase 5 cleanup skip.\n    file.quarantined = True\n    _forensic(\"audit_spool_tamper_detected\", {\n        \"mismatch_kind\": mismatch_kind,\n        \"spool_pid\": file.pid,\n        \"drain_epoch\": drain_epoch,\n    })\n\n\ndef _should_quarantine_test_origin(\n    file: \"_DrainingFile\", canonical_log_path: Path\n) -> bool:\n    \"\"\"PLAN-119 WS-D1 — True iff this spool is ``_origin:\"test\"`` AND the\n    canonical drain destination IS the live chain.\n\n    Conjunction-gated (Codex R2 P0-1): a redirected pytest/session tmp dir is\n    NOT the live chain, so a ``\"test\"`` spool drains NORMALLY there (isolated\n    drain-behavior tests keep working). Fail-SAFE to NO quarantine (Codex R3\n    P1-1) when the live-log snapshot is absent/unreadable — never risk dropping a\n    real event. Legacy spool with no ``_origin`` (or ``_origin:\"live\"``) is never\n    quarantined.\n    \"\"\"\n    header = file.header\n    if not isinstance(header, dict) or header.get(\"_origin\") != \"test\":\n        return False\n    snapshot = os.environ.get(_LIVE_LOG_SNAPSHOT_VAR)\n    if not snapshot:\n        return False  # cannot confirm destination is live → drain normally\n    try:\n        return Path(canonical_log_path).resolve() == Path(snapshot).resolve()\n    except (OSError, ValueError):\n        return False\n\n\ndef _quarantine_test_origin(file: \"_DrainingFile\", drain_epoch: str) -> None:\n    \"\"\"PLAN-119 WS-D1 — rename an ``_origin:\"test\"`` spool out of the drain path\n    so its entries never reach the live canonical append.\n\n    Breadcrumb-only — no new audit action (the canonical ``_KNOWN_ACTIONS`` is a\n    kernel-HARD-DENY surface; the rename + the ``DrainStats`` counter are the\n    durable trace). Mirrors ``_quarantine``'s rename discipline (latches\n    ``file.quarantined`` so Phase 5 cleanup skips the moved file).\n    \"\"\"\n    try:\n        new_name = file.path.name.replace(\n            _DRAINING_SUFFIX_TOKEN[1:] + file.drain_epoch,\n            _TEST_ORIGIN_SUFFIX_TOKEN[1:] + drain_epoch,\n            1,\n        )\n        new_path = file.path.with_name(new_name)\n        os.rename(str(file.path), str(new_path))\n    except OSError as e:\n        _breadcrumb(\n            f\"test-origin quarantine rename failed: {type(e).__name__}: {e}\"\n        )\n    file.quarantined = True\n    # Codex P1 — compact the quarantined spool's journal records so session-start\n    # reconciliation does NOT later count them as inflight/lost and emit a spurious\n    # ``audit_flush_dropped_count``. A deliberate test-origin quarantine is a\n    # COMPLETION (the entries are intentionally not drained to the live chain),\n    # not a real-event loss. ``file.body_lines`` is populated by Phase 2.\n    try:\n        rec_ids = []\n        for raw in (file.body_lines or []):\n            try:\n                entry = json.loads(raw.decode(\"utf-8\"))\n            except (json.JSONDecodeError, UnicodeDecodeError):\n                continue\n            rid = entry.get(\"record_id\") if isinstance(entry, dict) else None\n            if isinstance(rid, str) and rid:\n                rec_ids.append(rid)\n        if rec_ids:\n            _journal_compact_drained(file.pid, rec_ids, drain_epoch)\n    except Exception as e:  # pragma: no cover — journal hygiene, never blocks\n        _breadcrumb(\n            f\"test-origin journal compaction failed: {type(e).__name__}: {e}\"\n        )\n    _breadcrumb(\n        f\"test-origin spool refused at live-chain drain: pid={file.pid} \"\n        f\"epoch={drain_epoch}\"\n    )\n\n\ndef _phase2_validate_header(\n    file: _DrainingFile, drain_epoch: str\n) -> bool:\n    \"\"\"Read header + first body line; validate body[0].spool_uuid sentinel.\n\n    Returns True iff header is well-formed AND header._spool_uuid matches\n    body[0].spool_uuid (when body is non-empty). Quarantines on mismatch.\n    Loads body_lines into file as a side effect.\n    \"\"\"\n    try:\n        raw_lines = file.path.read_bytes().split(b\"\\n\")\n    except OSError as e:\n        _breadcrumb(f\"phase2 read failed: {type(e).__name__}: {e}\")\n        return False\n\n    # Strip trailing empty fragment from final newline\n    if raw_lines and raw_lines[-1] == b\"\":\n        raw_lines = raw_lines[:-1]\n\n    if not raw_lines:\n        # Empty file; nothing to do — caller treats as fully-consumed\n        file.header = None\n        file.body_lines = []\n        return True\n\n    # Parse header\n    try:\n        header = json.loads(raw_lines[0].decode(\"utf-8\"))\n    except (json.JSONDecodeError, UnicodeDecodeError):\n        _quarantine(file, \"malformed_spool_header\", drain_epoch)\n        return False\n    # iter5-P1: use the shared strict predicate (same one used by\n    # _ensure_spool_header for writer-side reuse) so writer and drainer\n    # validation are byte-equivalent.\n    if not _validate_spool_header_strict(header):\n        _quarantine(file, \"malformed_spool_header\", drain_epoch)\n        return False\n\n    file.header = header\n    # P2-4: verbatim header bytes for Phase 5 atomic split\n    file.header_raw = raw_lines[0] + b\"\\n\"\n    file.body_lines = raw_lines[1:]\n\n    if not file.body_lines:\n        return True\n\n    # body[0] sentinel\n    body0_raw = file.body_lines[0]\n    try:\n        body0 = json.loads(body0_raw.decode(\"utf-8\"))\n    except (json.JSONDecodeError, UnicodeDecodeError):\n        # body[0] malformed → if it's the ONLY body line, treat as partial-\n        # line crash (Phase 3 discard). Otherwise quarantine (mid-file\n        # malformed is suspicious).\n        if len(file.body_lines) == 1:\n            return True\n        _quarantine(file, \"malformed_spool_header\", drain_epoch)\n        return False\n    # PLAN-094-FOLLOWUP bug fix: extract spool_uuid from validated header\n    # (was UnboundLocalError NameError — refactor regression from\n    # _validate_spool_header_strict extraction; caught by Wave A.7r.1 test).\n    spool_uuid = header[\"_spool_uuid\"]\n    if not isinstance(body0, dict) or body0.get(\"spool_uuid\") != spool_uuid:\n        _quarantine(file, \"header_body_uuid_mismatch\", drain_epoch)\n        return False\n    return True\n\n\n# ---------------------------------------------------------------------------\n# Phase 3 — sort + 4-tuple uniqueness\n# ---------------------------------------------------------------------------\n\n\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef _phase3_collect_and_sort(\n    files: List[_DrainingFile], drain_epoch: str, stats: DrainStats,\n) -> Tuple[\n    List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]],\n    Dict[str, Set[int]],\n    int,\n]:\n    \"\"\"Parse body lines from each draining file; sort by 4-tuple; de-dup.\n\n    Returns (deduped, partial_discard_consumed_indices_by_path,\n    duplicate_consumed_count).\n\n    iter4-P2-2: returns the count of duplicate-tuple entries marked\n    consumed in this cycle so Phase 4 can carry it as the starting\n    `processed` value. Without this, a duplicate storm (e.g. corrupted\n    spool with N identical 4-tuples) consumes/deletes more than K_MAX\n    entries in one drain cycle, softening the K_MAX hard-cap perf\n    contract (correctness preserved — duplicates ARE discarded).\n\n    iter2-P0-1: partial-discard tracking is now a Set[int] of body indices\n    (not a prefix-count). Phase 5 splits the file using the COMPLEMENT of\n    the set, so out-of-order index consumption (later index handled before\n    earlier index) is safe.\n\n    iter2-P0-2: duplicate 4-tuple is marked CONSUMED (added to the per-file\n    set) so Phase 5 cleanup actually removes it from disk; without this,\n    the rejected entry survives split → re-detected as duplicate forever\n    (livelock). audit_spool_intentionally_deleted advisory emits.\n\n    iter2-P2-2: per-file ordinal monotonicity check — within each spool\n    file, `ordinal_within_file` of entry N+1 must be > entry N (the writer\n    issues strictly-monotonic ordinals via _next_ordinal()). Violation →\n    quarantine source with mismatch_kind=\"ordinal_monotonicity_violation\".\n\n    Tamper / malformed handling:\n    - JSON-parse fail on the LAST line of a file → partial-line discard\n      (writer SIGKILL mid-write); emit audit_spool_partial_line_discarded\n    - JSON-parse fail on any OTHER line → tamper; quarantine the file and\n      drop ALL its remaining unconsumed body entries.\n    - Duplicate full 4-tuple → reject with audit_spool_duplicate_tuple_rejected;\n      mark consumed (iter2-P0-2).\n    - Ordinal monotonicity violation → quarantine (iter2-P2-2).\n    \"\"\"\n    collected: List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]] = []\n    partial_consumed: Dict[str, Set[int]] = {}\n\n    def _mark(path_str: str, idx: int) -> None:\n        partial_consumed.setdefault(path_str, set()).add(idx)\n\n    for f in files:\n        if not f.body_lines:\n            continue\n        last_idx = len(f.body_lines) - 1\n        path_key = str(f.path)\n        # iter2-P2-2: per-file ordinal monotonicity tracking.\n        prev_ordinal: Optional[int] = None\n        for idx, raw in enumerate(f.body_lines):\n            if not raw:\n                # Empty line (double-newline) — discard silently but mark\n                # consumed so Phase 5 doesn't perpetually re-split it.\n                _mark(path_key, idx)\n                continue\n            try:\n                obj = json.loads(raw.decode(\"utf-8\"))\n            except (json.JSONDecodeError, UnicodeDecodeError):\n                if idx == last_idx:\n                    stats.partial_lines_discarded += 1\n                    _forensic(\"audit_spool_partial_line_discarded\", {\n                        \"spool_pid\": f.pid,\n                        \"drain_epoch\": drain_epoch,\n                        \"body_index\": idx,\n                    })\n                    # iter2-P0-1: mark this index consumed so Phase 5\n                    # split treats the partial line as handled.\n                    _mark(path_key, idx)\n                    continue\n                # Mid-file malformed — quarantine file and stop collecting\n                # from it (subsequent entries are suspect)\n                _quarantine(f, \"malformed_spool_header\", drain_epoch)\n                stats.quarantined_files += 1\n                # Drop any entries already collected from this file:\n                collected = [c for c in collected if c[2] is not f]\n                partial_consumed.pop(path_key, None)\n                break\n            if not isinstance(obj, dict):\n                if idx == last_idx:\n                    stats.partial_lines_discarded += 1\n                    _mark(path_key, idx)  # iter2-P0-1\n                    continue\n                _quarantine(f, \"malformed_spool_header\", drain_epoch)\n                stats.quarantined_files += 1\n                collected = [c for c in collected if c[2] is not f]\n                partial_consumed.pop(path_key, None)\n                break\n            try:\n                wall_ns = int(obj[\"wall_ns\"])\n                pid = int(obj[\"pid\"])\n                spool_uuid = str(obj[\"spool_uuid\"])\n                ordinal = int(obj[\"ordinal_within_file\"])\n            except (KeyError, TypeError, ValueError):\n                # Missing 4-tuple field — treat as tamper (would also break\n                # HMAC since spool_uuid participates in canonical_json)\n                _quarantine(f, \"malformed_spool_header\", drain_epoch)\n                stats.quarantined_files += 1\n                collected = [c for c in collected if c[2] is not f]\n                partial_consumed.pop(path_key, None)\n                break\n            # iter2-P2-2: per-file ordinal monotonicity (strictly increasing).\n            if prev_ordinal is not None and ordinal <= prev_ordinal:\n                _quarantine(f, \"ordinal_monotonicity_violation\", drain_epoch)\n                stats.quarantined_files += 1\n                collected = [c for c in collected if c[2] is not f]\n                partial_consumed.pop(path_key, None)\n                break\n            prev_ordinal = ordinal\n            key = (wall_ns, pid, spool_uuid, ordinal)\n            collected.append((key, obj, f, idx))\n\n    collected.sort(key=lambda x: x[0])\n\n    deduped: List[Tuple[Tuple[int, int, str, int], Dict[str, Any], _DrainingFile, int]] = []\n    seen: set = set()\n    # iter4-P2-2: bound duplicate-cleanup to K_MAX so a storm can't exceed\n    # the per-cycle perf cap. Unmarked duplicates survive split → next\n    # drain re-detects → bounded amortization (correctness preserved; no\n    # canonical append happens for duplicates either way).\n    duplicate_consumed = 0\n    for key, obj, f, idx in collected:\n        if key in seen:\n            if duplicate_consumed >= K_MAX:\n                # Still record the forensic so SOC sees the rejection,\n                # but DO NOT _mark() consumed (defer to next cycle).\n                stats.rejected_duplicate_tuple += 1\n                _forensic(\"audit_spool_duplicate_tuple_rejected\", {\n                    \"wall_ns\": key[0],\n                    \"pid\": key[1],\n                    \"spool_uuid\": key[2],\n                    \"ordinal_within_file\": key[3],\n                    \"drain_epoch\": drain_epoch,\n                    \"deferred_to_next_cycle\": True,\n                })\n                continue\n            stats.rejected_duplicate_tuple += 1\n            _forensic(\"audit_spool_duplicate_tuple_rejected\", {\n                \"wall_ns\": key[0],\n                \"pid\": key[1],\n                \"spool_uuid\": key[2],\n                \"ordinal_within_file\": key[3],\n                \"drain_epoch\": drain_epoch,\n            })\n            # iter2-P0-2: mark the duplicate's body index CONSUMED so Phase 5\n            # actually removes it from disk (otherwise the rejected entry\n            # survives split → re-detected forever = livelock). Emit a\n            # paired advisory so SOC has trace of the silent deletion.\n            _mark(str(f.path), idx)\n            # iter3-P2-1: surface count into DrainStats for AC10 visibility\n            # (JournalReconciliation aggregates this at session-start).\n            stats.intentionally_deleted += 1\n            duplicate_consumed += 1\n            _forensic(\"audit_spool_intentionally_deleted\", {\n                \"reason\": \"duplicate_tuple\",\n                \"spool_pid\": key[1],\n                \"spool_uuid\": key[2],\n                \"ordinal_within_file\": key[3],\n                \"drain_epoch\": drain_epoch,\n            })\n            continue\n        seen.add(key)\n        deduped.append((key, obj, f, idx))\n    return deduped, partial_consumed, duplicate_consumed\n\n\n# ---------------------------------------------------------------------------\n# Phase 4 — idempotent chain reconstruction\n# ---------------------------------------------------------------------------\n","numLines":764,"startLine":1,"totalLines":764}},"tool_result_meta":[{"id":"toolu_01YRwccQaJUxhTSnQaxPPVyK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
