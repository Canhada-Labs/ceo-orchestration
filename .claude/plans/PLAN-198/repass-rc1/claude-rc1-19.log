{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CJGccnGpD9h7BSeUzMuX4d","type":"tool_result","content":"1\t\"\"\"_lib/spool_writer.py — durable spool + drain-on-next-invoke (PLAN-094 Wave A).\n2\t\n3\tImplements ADR-055-AMEND-1: 5-phase atomic drain protocol, 4-tuple total\n4\torder across concurrent producers, K_MAX/K_TAIL_WINDOW idempotent skip,\n5\tcanonical-tail prev_hmac reconstruction, per-PID spool + per-PID journal,\n6\tatomic split-and-delete for K_MAX deferral, header/body uuid sentinel.\n7\t\n8\tStdlib-only (ADR-002). Fail-open invariant — never raise to caller; any\n9\tinfra failure emits a breadcrumb and returns safely.\n10\t\"\"\"\n11\tfrom __future__ import annotations\n12\timport atexit\n13\timport hashlib\n14\timport json\n15\timport os\n16\timport re\n17\timport secrets\n18\timport signal\n19\timport sys\n20\timport time\n21\timport uuid\n22\tfrom dataclasses import dataclass, field\n23\tfrom pathlib import Path\n24\tfrom typing import Any, Callable, Dict, Iterable, List, Optional, Set, Tuple\n25\t_HOOKS_DIR = Path(__file__).resolve().parent.parent\n26\tif str(_HOOKS_DIR) not in sys.path:\n27\t    sys.path.insert(0, str(_HOOKS_DIR))\n28\tfrom _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\n29\tfrom _lib import runtime_paths as _runtime_paths  # noqa: E402  # PLAN-182 W1 single resolver (ADR-001 S318)\n30\ttry:\n31\t    from _lib import audit_hmac as _audit_hmac  # noqa: E402\n32\t    _HMAC_AVAILABLE = True\n33\texcept Exception:  # pragma: no cover\n34\t    _audit_hmac = None  # type: ignore[assignment]\n35\t    _HMAC_AVAILABLE = False\n36\ttry:\n37\t    from _lib import canonical_json as _canonical_json  # noqa: E402\n38\texcept Exception:  # pragma: no cover\n39\t    _canonical_json = None  # type: ignore[assignment]\n40\tK_MAX = 100\n41\tK_TAIL_WINDOW = 200\n42\tSPOOL_HEADER_VERSION = 1\n43\tDRAIN_TRIGGER_SIZE = 100\n44\tDRAIN_TRIGGER_MTIME_MS = 100\n45\tSTALE_SPOOL_TTL_DAYS = 7\n46\tSPOOL_LOCK_TIMEOUT = 2.5\n47\t_SPOOL_PREFIX = \"audit-spool\"\n48\t_JOURNAL_PREFIX = \"audit-pending\"\n49\t_DRAINING_SUFFIX_TOKEN = \".draining.\"\n50\t_MALFORMED_SUFFIX_TOKEN = \".malformed.\"\n51\t_QUARANTINED_SUFFIX_TOKEN = \".quarantined.\"\n52\t_TMP_SUFFIX_TOKEN = \".tmp.\"\n53\t_TEST_ORIGIN_SUFFIX_TOKEN = \".test-origin.\"\n54\t_LIVE_LOG_SNAPSHOT_VAR = \"CEO_AUDIT_LIVE_LOG_PATH_SNAPSHOT\"\n55\t_SPOOL_UUID_HEX_LEN = 16   # secrets.token_hex(8) -> 16 hex chars\n56\t_DRAIN_EPOCH_HEX_LEN = 8   # secrets.token_hex(4) -> 8 hex chars\n57\t@dataclass\n58\tclass DrainStats:\n59\t    \"\"\"Summary of a single drain_now() invocation.\n60\t\n61\t    iter3-P2-1: `intentionally_deleted` counts entries silently removed from\n62\t    spool during drain (duplicate-tuple rejection — paired with the\n63\t    audit_spool_intentionally_deleted forensic emit). Surfaced into\n64\t    JournalReconciliation.intentionally_deleted for AC10 visibility.\n65\t    \"\"\"\n66\t    appended: int = 0\n67\t    skipped_idempotent: int = 0\n68\t    rejected_duplicate_tuple: int = 0\n69\t    intentionally_deleted: int = 0\n70\t    quarantined_files: int = 0\n71\t    test_origin_quarantined: int = 0\n72\t    partial_lines_discarded: int = 0\n73\t    files_consumed_fully: int = 0\n74\t    files_split_remainder: int = 0\n75\t    in_recovery_mode: bool = False\n76\t    drain_epoch: Optional[str] = None\n77\t    ok: bool = True\n78\t    error: Optional[str] = None\n79\t    contended_skip: bool = False\n80\t@dataclass\n81\tclass JournalReconciliation:\n82\t    \"\"\"Counters emitted to audit_flush_dropped_count at session-start.\"\"\"\n83\t\n84\t    begin_no_commit: int = 0\n85\t    commit_no_drained: int = 0\n86\t    recovered: int = 0\n87\t    truly_lost: int = 0\n88\t    tamper_rejected: int = 0\n89\t    intentionally_deleted: int = 0\n90\t\n91\t\n92\t# ---------------------------------------------------------------------------\n93\t# Path helpers — mirror audit_emit conventions\n94\t# ---------------------------------------------------------------------------\n95\t\n96\t\n97\t# PLAN-111 Wave A — single-slot cache for _project_dir_from_env + _state_dir.\n98\t# Keyed on env-tuple (CEO_AUDIT_LOG_DIR, HOME); replace-on-miss; explicit\n99\t# reset via _reset_caches_for_test() bound to TestEnvContext.setUp/tearDown.\n100\t# Single-threaded contract: concurrent os.environ mutation = UB; future\n101\t# threading plans must add per-thread cache or thread-local env snapshot.\n102\t# Debate Round 1: SA-K1 (single-slot), SA-K7 (single-threaded), SA-K10\n103\t# (permission re-assertion on cache MISS), AC-A2a (store-on-mkdir-success\n104\t# only; no cached-as-unusable Path).\n105\t_PROJECT_DIR_CACHE: \"Optional[Tuple[Tuple[Optional[str], Optional[str]], Path]]\" = None\n106\t_STATE_DIR_CACHE: \"Optional[Tuple[Tuple[Optional[str], Optional[str]], Path]]\" = None\n107\t\n108\t\n109\tdef _reset_caches_for_test() -> None:\n110\t    \"\"\"Clear _project_dir_from_env + _state_dir caches.\n111\t    PLAN-111 Wave A.5: bound to TestEnvContext.setUp/tearDown to avoid\n112\t    cross-test leakage when CEO_AUDIT_LOG_DIR or HOME mutate. Also bound\n113\t    via unittest.addModuleCleanup in test_lifecycle_edge_cases.py for\n114\t    bare-TestCase classes that don't inherit TestEnvContext.\n115\t    PRODUCTION CODE MUST NOT CALL THIS — it's a test-only API. Calling\n116\t    mid-flight flushes the cache and re-pays the mkdir + lstat cost on\n117\t    next emit (correctness preserved; perf regressed for one call).\n118\t    \"\"\"\n119\t    global _PROJECT_DIR_CACHE, _STATE_DIR_CACHE\n120\t    _PROJECT_DIR_CACHE = None\n121\t    _STATE_DIR_CACHE = None\n122\t\n123\t\n124\tdef _project_dir_cache_key() -> Tuple[Optional[str], ...]:\n125\t    \"\"\"Cache key for the declared environment and conditional cwd inputs.\n126\t    PLAN-182 W1 cure: the Wave-A key was (CEO_AUDIT_LOG_DIR, HOME) — a\n127\t    process that switched project mid-run (CLAUDE_PROJECT_DIR / cwd /\n128\t    CLAUDE_PROJECT_DIR_NATIVE changed) kept being served the PREVIOUS\n129\t    project's dir from cache, so the cross-project leak survived any\n130\t    resolver cure. cwd participates when none of the directory candidates\n131\t    is absolute. A lower-priority absolute candidate can still mask the\n132\t    cwd dependency of a relative override; rc.1 condition 24 requires an\n133\t    absolute CEO_AUDIT_LOG_DIR and records the remaining cache limitation.\n134\t    \"\"\"\n135\t    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n136\t    env_home = os.environ.get(\"HOME\")\n137\t    env_native = os.environ.get(\"CLAUDE_PROJECT_DIR_NATIVE\")\n138\t    env_proj = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n139\t    cwd: Optional[str] = None\n140\t    # rail r15 P2-3: o cwd entra na chave quando NENHUM override absoluto\n141\t    # decide o dir — inclui o caso de um override RELATIVO, que\n142\t    # `project_dir()` resolve CONTRA o cwd. Sem isso, um processo longo\n143\t    # que muda de cwd com CLAUDE_PROJECT_DIR relativo continuaria servindo\n144\t    # o dir do projeto anterior (e pularia a invalidacao dos caches).\n145\t    def _abs(v):\n146\t        return bool(v) and os.path.isabs(v)\n147\t    if not (_abs(env_dir) or _abs(env_native) or _abs(env_proj)):\n148\t        cwd = os.getcwd()\n149\t    return (env_dir, env_home, env_native, env_proj, cwd)\n150\t\n151\t\n152\tdef _project_dir_from_env() -> Path:\n153\t    \"\"\"Return the audit project dir (BYTE-IDENTICAL to audit_emit._audit_dir).\n154\t    P1-5: must mirror audit_emit._audit_dir() exactly — CEO_AUDIT_LOG_DIR\n155\t    precedence, then the SAME single resolver (_lib/runtime_paths,\n156\t    PLAN-182 W1) audit_emit delegates to. CEO_AUDIT_LOG_PATH is the FILE\n157\t    path, not the dir path, so we do NOT derive the dir from it\n158\t    (audit_emit doesn't either).\n159\t    PLAN-111 Wave A cache, PLAN-182 W1 key: single-slot, keyed on\n160\t    _project_dir_cache_key() (all resolver inputs). Cache HIT skips\n161\t    re-construction of Path object. Cache MISS replaces the slot\n162\t    atomically.\n163\t    Single-threaded contract: concurrent os.environ mutation = UB.\n164\t    \"\"\"\n165\t    global _PROJECT_DIR_CACHE\n166\t    env_key = _project_dir_cache_key()\n167\t    cached = _PROJECT_DIR_CACHE\n168\t    if cached is not None and cached[0] == env_key:\n169\t        return cached[1]\n170\t    env_dir = env_key[0]\n171\t    if env_dir:\n172\t        p = Path(env_dir)\n173\t    else:\n174\t        p = _runtime_paths.runtime_state_dir()\n175\t    _PROJECT_DIR_CACHE = (env_key, p)\n176\t    return p\n177\t\n178\t\n179\tdef _invalidate_per_pid_caches_on_project_switch(old_dir: Path) -> None:\n180\t    \"\"\"Drop per-PID spool state when the resolved project changes.\n181\t    rail r13 P1-1 (cura) + rail r14 (cura da cura): o flush do buffer\n182\t    pendente e feito contra ``old_dir`` — o dir do projeto ANTERIOR, que\n183\t    o chamador ja tem em cache. A primeira versao chamava\n184\t    ``_flush_journal_buffer()``, que resolve o caminho por\n185\t    ``_state_dir()``: como o cache ainda nao tinha sido trocado, aquilo\n186\t    RE-ENTRAVA neste mesmo branch ate ``RecursionError`` e, pior,\n187\t    reescrevia o payload antigo sob o dir do projeto NOVO — a\n188\t    contaminacao cruzada que a invalidacao existe para impedir.\n189\t    Fail-open: qualquer erro no flush apenas descarta os caches.\n190\t    \"\"\"\n191\t    pid = os.getpid()\n192\t    buf = _JOURNAL_BUFFER.get(pid)\n193\t    if buf:\n194\t        try:\n195\t            target = old_dir / \"{0}.{1}.journal\".format(_JOURNAL_PREFIX, pid)\n196\t            with target.open(\"ab\") as fh:\n197\t                for line in buf:\n198\t                    fh.write(line)\n199\t                fh.flush()\n200\t                os.fsync(fh.fileno())\n201\t        except Exception:  # pragma: no cover — nunca bloqueia a troca\n202\t            pass\n203\t    _SPOOL_HEADER_CACHE.pop(pid, None)\n204\t    _ORDINAL_COUNTER.pop(pid, None)\n205\t    _JOURNAL_BUFFER.pop(pid, None)\n206\t\n207\t\n208\t# QDSAA-FUNCAO-LONGA: resolução segura combina isolamento de projeto, permissões e invalidação de cache.\n209\tdef _state_dir() -> Path:\n210\t    \"\"\"Return <audit_dir>/state/ ensuring parents exist (0700).\n211\t    P1-5: state dir is unconditionally a child of audit_emit._audit_dir();\n212\t    no CEO_PROJECT_STATE_DIR override (audit_emit doesn't expose one).\n213\t    PLAN-111 Wave A: single-slot cache keyed on (CEO_AUDIT_LOG_DIR, HOME).\n214\t    Cache HIT skips mkdir syscall + Path construction (saves ~17us/call x\n215\t    5.7x/emit cumulative ~= 100us/emit recovery).\n216\t    Cache MISS semantics (AC-A2a + SA-K10 permission re-assertion +\n217\t    PLAN-113 W4-SEC mode-mismatch self-heal):\n218\t      1. Resolve target Path (uses _project_dir_from_env cache implicitly).\n219\t      2. Attempt mkdir(parents=True, exist_ok=True, mode=0o700).\n220\t      3. If mkdir FAILS: breadcrumb + DO NOT cache (next call retries).\n221\t      4. If mkdir SUCCEEDS: validate via lstat() that dir is not a symlink,\n222\t         is owned by os.getuid(), and has mode 0o700.\n223\t         - symlink / wrong-owner mismatch: FAIL-CLOSED (raise) — we never\n224\t           chmod-and-trust an attacker-controlled or other-owned dir.\n225\t         - mode-only mismatch (e.g. a pre-existing state/ at 0o755 created\n226\t           by an older path; exist_ok=True does NOT relax perms): attempt\n227\t           SELF-HEAL via os.chmod(d, 0o700) then RE-lstat + re-validate the\n228\t           full invariant. If it is now a non-symlink, owned by os.getuid(),\n229\t           AND 0o700 → PROCEED (cache + return). Otherwise keep the SA-K10\n230\t           fail-CLOSED.\n231\t      5. Only if validation (incl. any self-heal) succeeds: cache the Path.\n232\t    Single-threaded contract: concurrent os.environ mutation = UB.\n233\t    \"\"\"\n234\t    global _STATE_DIR_CACHE\n235\t    # PLAN-182 W1: key covers ALL resolver inputs (see\n236\t    # _project_dir_cache_key) — a mid-process project switch must not be\n237\t    # served the previous project's state dir.\n238\t    env_key = _project_dir_cache_key()\n239\t    cached = _STATE_DIR_CACHE\n240\t    if cached is not None and cached[0] == env_key:\n241\t        return cached[1]\n242\t    # rail r13 P1-1: os caches POR PID (header/ordinal/journal) nao sao\n243\t    # cobertos pela chave acima. Num processo longo A -> B -> A, o header\n244\t    # de B seria reusado em A (UUID errado no corpo => o drain estrito\n245\t    # QUARENTENA o spool de A) e o journal bufferizado poderia ir para o\n246\t    # projeto errado. Uma transicao de projeto invalida os tres.\n247\t    if cached is not None and cached[0] != env_key:\n248\t        # passa o dir ANTIGO (cached[1]) — nunca re-resolve aqui.\n249\t        _invalidate_per_pid_caches_on_project_switch(cached[1])\n250\t    d = _project_dir_from_env() / \"state\"\n251\t    mkdir_ok = False\n252\t    try:\n253\t        d.mkdir(parents=True, exist_ok=True, mode=0o700)\n254\t        mkdir_ok = True\n255\t    except OSError as e:\n256\t        _breadcrumb(f\"_state_dir mkdir failed (no cache): \"\n257\t                    f\"{type(e).__name__}: {e}\")\n258\t    if mkdir_ok:\n259\t        try:\n260\t            import stat as _stat_mod\n261\t\n262\t            def _classify(st_mode: int, st_uid: int) -> \"Optional[str]\":\n263\t                \"\"\"Return a mismatch reason, or None when state/ is healthy.\"\"\"\n264\t                if _stat_mod.S_ISLNK(st_mode):\n265\t                    return f\"is_symlink: {d}\"\n266\t                if st_uid != os.getuid():\n267\t                    return f\"uid_mismatch: {st_uid} != {os.getuid()}\"\n268\t                if (st_mode & 0o777) != 0o700:\n269\t                    return f\"mode_mismatch: {oct(st_mode & 0o777)} != 0o700\"\n270\t                return None\n271\t            st = os.lstat(str(d))\n272\t            mismatch_reason: \"Optional[str]\" = _classify(st.st_mode, st.st_uid)\n273\t            if (mismatch_reason is not None\n274\t                    and not _stat_mod.S_ISLNK(st.st_mode)\n275\t                    and st.st_uid == os.getuid()):\n276\t                healed = False\n277\t                fd = None\n278\t                try:\n279\t                    fd = os.open(\n280\t                        str(d), os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY\n281\t                    )\n282\t                    os.fchmod(fd, 0o700)\n283\t                    fst = os.fstat(fd)\n284\t                    mismatch_reason = _classify(fst.st_mode, fst.st_uid)\n285\t                    if mismatch_reason is None:\n286\t                        st = fst\n287\t                        healed = True\n288\t                except OSError as e:\n289\t                    _breadcrumb(\n290\t                        f\"_state_dir self-heal (O_NOFOLLOW fchmod) failed \"\n291\t                        f\"(FAIL-CLOSED): {type(e).__name__}: {e}\"\n292\t                    )\n293\t                finally:\n294\t                    if fd is not None:\n295\t                        try:\n296\t                            os.close(fd)\n297\t                        except OSError:\n298\t                            pass\n299\t                if healed:\n300\t                    _breadcrumb(\n301\t                        f\"_state_dir mode self-healed to 0o700: {d}\"\n302\t                    )\n303\t            if mismatch_reason is not None:\n304\t                _breadcrumb(\n305\t                    f\"_state_dir SECURITY mismatch (FAIL-CLOSED): \"\n306\t                    f\"{mismatch_reason}\"\n307\t                )\n308\t                raise PermissionError(\n309\t                    f\"_state_dir permission re-assertion failed: \"\n310\t                    f\"{mismatch_reason}\"\n311\t                )\n312\t            _STATE_DIR_CACHE = (env_key, d)\n313\t        except PermissionError:\n314\t            raise\n315\t        except OSError as e:\n316\t            _breadcrumb(f\"_state_dir lstat failed (no cache): \"\n317\t                        f\"{type(e).__name__}: {e}\")\n318\t    return d\n319\tdef _canonical_log_path() -> Path:\n320\t    \"\"\"Mirror audit_emit._log_path() — canonical audit-log.jsonl.\"\"\"\n321\t    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n322\t    if env:\n323\t        return Path(env)\n324\t    return _project_dir_from_env() / \"audit-log.jsonl\"\n325\t\n326\t\n327\tdef _log_family_dir() -> Path:\n328\t    \"\"\"Dir the lock/errors sidecars must share with the LOG.\n329\t    PLAN-182 W1 rail r1 P1-2: mirrors audit_emit._log_family_dir()\n330\t    byte-for-byte — when CEO_AUDIT_LOG_PATH moves the log, EVERY writer\n331\t    of that log locks the moved parent (two writers on one HMAC log\n332\t    under different locks = interleaved appends).\n333\t    \"\"\"\n334\t    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n335\t    if env:\n336\t        return Path(env).resolve().parent\n337\t    return _project_dir_from_env()\n338\t\n339\t\n340\tdef _canonical_log_lock() -> Path:\n341\t    \"\"\"Mirror audit_emit._lock_path() — sibling .lock file.\"\"\"\n342\t    env = os.environ.get(\"CEO_AUDIT_LOG_LOCK\")\n343\t    if env:\n344\t        return Path(env)\n345\t    return _log_family_dir() / \"audit-log.lock\"\n346\tdef _errors_path() -> Path:\n347\t    \"\"\"Breadcrumb file for fail-open infra errors.\"\"\"\n348\t    env = os.environ.get(\"CEO_AUDIT_LOG_ERR\")\n349\t    if env:\n350\t        return Path(env)\n351\t    return _log_family_dir() / \"audit-log.errors\"\n352\t\n353\t\n354\tdef _spool_path(pid: int) -> Path:\n355\t    \"\"\"Active spool path for a given PID (header + body).\"\"\"\n356\t    return _state_dir() / f\"{_SPOOL_PREFIX}.{pid}.jsonl\"\n357\tdef _journal_path(pid: int) -> Path:\n358\t    \"\"\"Per-PID journal path.\"\"\"\n359\t    return _state_dir() / f\"{_JOURNAL_PREFIX}.{pid}.journal\"\n360\t\n361\t\n362\tdef _aggregate_journal_path() -> Path:\n363\t    \"\"\"Aggregate journal for swept dead-PID envelopes.\"\"\"\n364\t    return _state_dir() / f\"{_JOURNAL_PREFIX}.journal\"\n365\tdef _aggregate_journal_lock_path() -> Path:\n366\t    \"\"\"flock for aggregation sweep at session-start.\"\"\"\n367\t    return _state_dir() / f\"{_JOURNAL_PREFIX}.journal.aggregation.lock\"\n368\t\n369\t\n370\tdef _spool_flock_path(pid: int) -> Path:\n371\t    \"\"\"Per-PID spool flock sibling (NOT same fd as the spool file).\"\"\"\n372\t    return _state_dir() / f\"{_SPOOL_PREFIX}.{pid}.jsonl.lock\"\n373\tdef _journal_flock_path(pid: int) -> Path:\n374\t    \"\"\"Per-PID journal flock sibling.\"\"\"\n375\t    return _state_dir() / f\"{_JOURNAL_PREFIX}.{pid}.journal.lock\"\n376\t\n377\t\n378\t# P0-1: single helper for the .draining.<epoch> filename construction.\n379\t# Bug fix — old code did `f\"{spool_path}draining.{epoch}\"` (missing dot)\n380\t# producing audit-spool.<pid>.jsonldraining.<epoch>; glob sweep failed.\n381\tdef _draining_path(spool_path: Path, epoch: str) -> Path:\n382\t    \"\"\"audit-spool.<pid>.jsonl → audit-spool.<pid>.draining.<epoch>.\"\"\"\n383\t    stem = spool_path.stem  # 'audit-spool.<pid>' (strips trailing .jsonl)\n384\t    return spool_path.with_name(f\"{stem}.draining.{epoch}\")\n385\t_SPOOL_UUID_RE = re.compile(r\"^[0-9a-f]{16}$\")\n386\tdef _validate_spool_header_strict(header: Any) -> bool:\n387\t    \"\"\"Strict 4-field header invariant — same predicate used by Phase 2\n388\t    quarantine and `_ensure_spool_header` PID-reuse path.\n389\t\n390\t    iter5-P1 closure: factored out so writer-side reuse cannot accept a\n391\t    header that the drainer will later reject. Mismatch between writer\n392\t    and drainer validation = silent data loss for events appended after\n393\t    the lax reuse but before Phase 2 quarantine.\n394\t\n395\t    Returns True only when ALL of:\n396\t      - dict with `_spool_header: True`\n397\t      - `_spool_uuid: str` of length 16 and matching `^[0-9a-f]{16}$`\n398\t      - `_pid: int`\n399\t      - `_created_wall_ns: int`\n400\t      - `_created_monotonic_ns: int`\n401\t    \"\"\"\n402\t    if not isinstance(header, dict):\n403\t        return False\n404\t    if header.get(\"_spool_header\") is not True:\n405\t        return False\n406\t    spool_uuid = header.get(\"_spool_uuid\")\n407\t    if (not isinstance(spool_uuid, str)\n408\t            or len(spool_uuid) != _SPOOL_UUID_HEX_LEN\n409\t            or _SPOOL_UUID_RE.match(spool_uuid) is None):\n410\t        return False\n411\t    if not isinstance(header.get(\"_pid\"), int):\n412\t        return False\n413\t    if not isinstance(header.get(\"_created_wall_ns\"), int):\n414\t        return False\n415\t    if not isinstance(header.get(\"_created_monotonic_ns\"), int):\n416\t        return False\n417\t    return True\n418\tdef _recover_ordinal_counter(spool_path: Path) -> int:\n419\t    \"\"\"Return ordinal_within_file counter from existing spool body.\n420\t\n421\t    iter4-P1-1: replaces prior `\\n`-counting approach. A complete body\n422\t    line WITHOUT trailing `\\n` (writer fsync'd then crashed before\n423\t    terminator) was previously counted as zero entries → ordinal 0\n424\t    re-issued → Phase 3 monotonicity quarantine. Now: parse each line\n425\t    (terminated or not), return max(ordinal)+1. Returns 0 on missing/\n426\t    empty/header-only/no-valid-ordinals.\n427\t    \"\"\"\n428\t    try:\n429\t        with open(str(spool_path), \"rb\") as f:\n430\t            content = f.read()\n431\t    except OSError:\n432\t        return 0\n433\t    if b\"\\n\" not in content:\n434\t        return 0\n435\t    _header, body = content.split(b\"\\n\", 1)\n436\t    if not body:\n437\t        return 0\n438\t    max_ord = -1\n439\t    for line_bytes in body.split(b\"\\n\"):\n440\t        if not line_bytes.strip():\n441\t            continue\n442\t        try:\n443\t            entry = json.loads(line_bytes)\n444\t        except (json.JSONDecodeError, ValueError):\n445\t            continue\n446\t        if not isinstance(entry, dict):\n447\t            continue\n448\t        o = entry.get(\"ordinal_within_file\")\n449\t        if isinstance(o, int) and o > max_ord:\n450\t            max_ord = o\n451\t    return max_ord + 1 if max_ord >= 0 else 0\n452\tclass _SpoolHeaderUnrecoverable(OSError):\n453\t    \"\"\"Raised when an existing spool has an invalid header AND quarantine\n454\t    rename fails. Caller (`spool_append`) MUST abort fail-open — minting\n455\t    a fresh header over the still-present corrupt file would silently\n456\t    lose the new event (Phase 2 quarantines the whole file later).\n457\t    iter6-P1 closure.\n458\t    \"\"\"\n459\tdef _quarantine_corrupt_active_spool(spool_path: Path, pid: int) -> bool:\n460\t    \"\"\"Rename malformed-header active spool aside; forensic emit.\n461\t\n462\t    iter4-P1-2: caller MUST hold `_spool_flock_path(pid)`. We must NOT\n463\t    call drain_now() here (Phase 2 re-acquires this same flock →\n464\t    self-timeout). _forensic() has its own re-entry guard so the emit\n465\t    path won't recurse into spool_append.\n466\t\n467\t    iter6-P1: returns True on successful rename, False on rename failure.\n468\t    Caller MUST honor False by aborting the current append fail-open\n469\t    (NOT minting a fresh header over the still-present corrupt file —\n470\t    that would let new events land behind a header Phase 2 will quarantine).\n471\t    \"\"\"\n472\t    epoch = secrets.token_hex(4)\n473\t    corrupt_path = spool_path.with_name(\n474\t        f\"{spool_path.stem}.corrupt-header.{epoch}\"\n475\t    )\n476\t    try:\n477\t        os.rename(str(spool_path), str(corrupt_path))\n478\t    except OSError as e:\n479\t        _breadcrumb(\n480\t            f\"quarantine_corrupt_active_spool rename failed pid={pid}: \"\n481\t            f\"{type(e).__name__}: {e}\"\n482\t        )\n483\t        return False\n484\t    _forensic(\"audit_spool_tamper_detected\", {\n485\t        \"mismatch_kind\": \"malformed_active_spool_header\",\n486\t        \"spool_pid\": pid,\n487\t        \"corrupt_path\": str(corrupt_path),\n488\t        \"drain_epoch\": epoch,\n489\t    })\n490\t    return True\n491\tdef _breadcrumb(message: str) -> None:\n492\t    \"\"\"Append a one-line forensic crumb; NEVER raise.\"\"\"\n493\t    try:\n494\t        p = _errors_path()\n495\t        p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n496\t        ts = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n497\t        with p.open(\"a\", encoding=\"utf-8\") as f:\n498\t            f.write(f\"{ts} spool_writer: {message}\\n\")\n499\t    except Exception:  # pragma: no cover\n500\t        pass\n501\t\n502\t\n503\t# ---------------------------------------------------------------------------\n504\t# Kill-switch + exit-handler state\n505\t# ---------------------------------------------------------------------------\n506\t\n507\t\n508\tdef is_sync_mode() -> bool:\n509\t    \"\"\"CEO_AUDIT_SYNC_MODE=1 reverts to pre-Wave-A synchronous behavior.\"\"\"\n510\t    return os.environ.get(\"CEO_AUDIT_SYNC_MODE\", \"\") == \"1\"\n511\t_EXIT_HANDLER_INSTALLED = False\n512\t_PREV_SIGTERM_HANDLER: Any = None\n513\t_PREV_SIGINT_HANDLER: Any = None\n514\t_EXIT_DEADLINE_MONOTONIC: Optional[float] = None\n515\tdef set_exit_deadline(deadline_monotonic: Optional[float]) -> None:\n516\t    \"\"\"Arm no-drain exit context; hook entrypoints own the monotonic deadline.\"\"\"\n517\t    global _EXIT_DEADLINE_MONOTONIC\n518\t    if deadline_monotonic is None:\n519\t        _EXIT_DEADLINE_MONOTONIC = None\n520\t        return\n521\t    try:\n522\t        _EXIT_DEADLINE_MONOTONIC = float(deadline_monotonic)\n523\t    except (TypeError, ValueError):\n524\t        _EXIT_DEADLINE_MONOTONIC = None\n525\t        _breadcrumb(\"exit deadline ignored: invalid monotonic value\")\n526\t\n527\t\n528\tdef _exit_deadline_active() -> bool:\n529\t    \"\"\"Whether this process is running under a hook-owned deadline.\"\"\"\n530\t    return _EXIT_DEADLINE_MONOTONIC is not None or os.environ.get(\"CEO_HOOK_BOUNDED_EXIT\") == \"1\"\n531\tdef _record_exit_deadline_skip(source: str) -> None:\n532\t    _breadcrumb(f\"exit_deadline_skip source={source}\")\n533\t_SPOOL_HEADER_CACHE: Dict[int, Dict[str, Any]] = {}\n534\t_ORDINAL_COUNTER: Dict[int, int] = {}\n535\t_FORENSIC_EMIT: Optional[Callable[[str, Dict[str, Any]], None]] = None\n536\t_IN_FORENSIC_EMIT = False\n537\t_IN_SPOOL_APPEND = False\n538\t_LAST_APPEND_SUCCEEDED = True\n539\tdef last_append_succeeded() -> bool:\n540\t    \"\"\"Whether the last spool_append persisted durably.\"\"\"\n541\t    return _LAST_APPEND_SUCCEEDED\n542\t\n543\t# Per-PID journal buffer; flush at drain boundaries or every ten writes.\n544\t_JOURNAL_FLUSH_EVERY = 10\n545\t_JOURNAL_BUFFER: Dict[int, List[bytes]] = {}\n546\t\n547\t\n548\tdef set_forensic_emitter(emit_fn: Callable[[str, Dict[str, Any]], None]) -> None:\n549\t    \"\"\"Wire the forensic emit callback (called by audit_emit on import).\"\"\"\n550\t    global _FORENSIC_EMIT\n551\t    _FORENSIC_EMIT = emit_fn\n552\tdef _forensic(action: str, fields: Dict[str, Any]) -> None:\n553\t    \"\"\"Emit a forensic audit event via wired callback; swallow errors.\n554\t\n555\t    P1-4: recursion guard — if we're already inside a _forensic() emit,\n556\t    write a breadcrumb and return without re-entering spool_append.\n557\t    \"\"\"\n558\t    global _IN_FORENSIC_EMIT\n559\t    cb = _FORENSIC_EMIT\n560\t    if cb is None:\n561\t        return\n562\t    if _IN_FORENSIC_EMIT:\n563\t        _breadcrumb(f\"forensic re-entry blocked: {action}\")\n564\t        return\n565\t    _IN_FORENSIC_EMIT = True\n566\t    try:\n567\t        cb(action, fields)\n568\t    except Exception as e:  # pragma: no cover\n569\t        _breadcrumb(f\"forensic emit failed: {action}: {type(e).__name__}: {e}\")\n570\t    finally:\n571\t        _IN_FORENSIC_EMIT = False\n572\tdef _origin_for_new_spool() -> str:\n573\t    \"\"\"PLAN-119 WS-D1 — write-time origin stamp for a freshly-minted spool header.\n574\t\n575\t    Returns ``\"test\"`` when a test signal is present AT WRITE TIME\n576\t    (``CEO_TEST_HARNESS=1`` or ``PYTEST_CURRENT_TEST`` set), else ``\"live\"``.\n577\t    The writer knows the truth; the drainer cannot infer it later, so the stamp\n578\t    is minted ONCE per spool (header) and is sticky to that PID's file. A real\n579\t    session writes ``\"live\"`` and is never quarantined; legacy spool with no\n580\t    ``_origin`` defaults to ``\"live\"`` at drain time (fail-safe toward never\n581\t    dropping a real event).\n582\t    \"\"\"\n583\t    if (os.environ.get(\"CEO_TEST_HARNESS\") == \"1\"\n584\t            or os.environ.get(\"PYTEST_CURRENT_TEST\")):\n585\t        return \"test\"\n586\t    return \"live\"\n587\t\n588\tfrom _lib._spool_writer_parts import install as _install_parts\n589\t\n590\t_install_parts(globals(), (\"writer\", \"prepare\", \"drain\", \"lifecycle\"))\n591\t"}]},"parent_tool_use_id":null,"session_id":"f14aefec-dd31-41ef-96b5-86b1c0aa1232","uuid":"b74eb65f-e335-4c19-9287-c019470a0a76","timestamp":"2026-11-15T10:41:13.490Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/spool_writer.py","content":"\"\"\"_lib/spool_writer.py — durable spool + drain-on-next-invoke (PLAN-094 Wave A).\n\nImplements ADR-055-AMEND-1: 5-phase atomic drain protocol, 4-tuple total\norder across concurrent producers, K_MAX/K_TAIL_WINDOW idempotent skip,\ncanonical-tail prev_hmac reconstruction, per-PID spool + per-PID journal,\natomic split-and-delete for K_MAX deferral, header/body uuid sentinel.\n\nStdlib-only (ADR-002). Fail-open invariant — never raise to caller; any\ninfra failure emits a breadcrumb and returns safely.\n\"\"\"\nfrom __future__ import annotations\nimport atexit\nimport hashlib\nimport json\nimport os\nimport re\nimport secrets\nimport signal\nimport sys\nimport time\nimport uuid\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, Iterable, List, Optional, Set, Tuple\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\nfrom _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\nfrom _lib import runtime_paths as _runtime_paths  # noqa: E402  # PLAN-182 W1 single resolver (ADR-001 S318)\ntry:\n    from _lib import audit_hmac as _audit_hmac  # noqa: E402\n    _HMAC_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _audit_hmac = None  # type: ignore[assignment]\n    _HMAC_AVAILABLE = False\ntry:\n    from _lib import canonical_json as _canonical_json  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _canonical_json = None  # type: ignore[assignment]\nK_MAX = 100\nK_TAIL_WINDOW = 200\nSPOOL_HEADER_VERSION = 1\nDRAIN_TRIGGER_SIZE = 100\nDRAIN_TRIGGER_MTIME_MS = 100\nSTALE_SPOOL_TTL_DAYS = 7\nSPOOL_LOCK_TIMEOUT = 2.5\n_SPOOL_PREFIX = \"audit-spool\"\n_JOURNAL_PREFIX = \"audit-pending\"\n_DRAINING_SUFFIX_TOKEN = \".draining.\"\n_MALFORMED_SUFFIX_TOKEN = \".malformed.\"\n_QUARANTINED_SUFFIX_TOKEN = \".quarantined.\"\n_TMP_SUFFIX_TOKEN = \".tmp.\"\n_TEST_ORIGIN_SUFFIX_TOKEN = \".test-origin.\"\n_LIVE_LOG_SNAPSHOT_VAR = \"CEO_AUDIT_LIVE_LOG_PATH_SNAPSHOT\"\n_SPOOL_UUID_HEX_LEN = 16   # secrets.token_hex(8) -> 16 hex chars\n_DRAIN_EPOCH_HEX_LEN = 8   # secrets.token_hex(4) -> 8 hex chars\n@dataclass\nclass DrainStats:\n    \"\"\"Summary of a single drain_now() invocation.\n\n    iter3-P2-1: `intentionally_deleted` counts entries silently removed from\n    spool during drain (duplicate-tuple rejection — paired with the\n    audit_spool_intentionally_deleted forensic emit). Surfaced into\n    JournalReconciliation.intentionally_deleted for AC10 visibility.\n    \"\"\"\n    appended: int = 0\n    skipped_idempotent: int = 0\n    rejected_duplicate_tuple: int = 0\n    intentionally_deleted: int = 0\n    quarantined_files: int = 0\n    test_origin_quarantined: int = 0\n    partial_lines_discarded: int = 0\n    files_consumed_fully: int = 0\n    files_split_remainder: int = 0\n    in_recovery_mode: bool = False\n    drain_epoch: Optional[str] = None\n    ok: bool = True\n    error: Optional[str] = None\n    contended_skip: bool = False\n@dataclass\nclass JournalReconciliation:\n    \"\"\"Counters emitted to audit_flush_dropped_count at session-start.\"\"\"\n\n    begin_no_commit: int = 0\n    commit_no_drained: int = 0\n    recovered: int = 0\n    truly_lost: int = 0\n    tamper_rejected: int = 0\n    intentionally_deleted: int = 0\n\n\n# ---------------------------------------------------------------------------\n# Path helpers — mirror audit_emit conventions\n# ---------------------------------------------------------------------------\n\n\n# PLAN-111 Wave A — single-slot cache for _project_dir_from_env + _state_dir.\n# Keyed on env-tuple (CEO_AUDIT_LOG_DIR, HOME); replace-on-miss; explicit\n# reset via _reset_caches_for_test() bound to TestEnvContext.setUp/tearDown.\n# Single-threaded contract: concurrent os.environ mutation = UB; future\n# threading plans must add per-thread cache or thread-local env snapshot.\n# Debate Round 1: SA-K1 (single-slot), SA-K7 (single-threaded), SA-K10\n# (permission re-assertion on cache MISS), AC-A2a (store-on-mkdir-success\n# only; no cached-as-unusable Path).\n_PROJECT_DIR_CACHE: \"Optional[Tuple[Tuple[Optional[str], Optional[str]], Path]]\" = None\n_STATE_DIR_CACHE: \"Optional[Tuple[Tuple[Optional[str], Optional[str]], Path]]\" = None\n\n\ndef _reset_caches_for_test() -> None:\n    \"\"\"Clear _project_dir_from_env + _state_dir caches.\n    PLAN-111 Wave A.5: bound to TestEnvContext.setUp/tearDown to avoid\n    cross-test leakage when CEO_AUDIT_LOG_DIR or HOME mutate. Also bound\n    via unittest.addModuleCleanup in test_lifecycle_edge_cases.py for\n    bare-TestCase classes that don't inherit TestEnvContext.\n    PRODUCTION CODE MUST NOT CALL THIS — it's a test-only API. Calling\n    mid-flight flushes the cache and re-pays the mkdir + lstat cost on\n    next emit (correctness preserved; perf regressed for one call).\n    \"\"\"\n    global _PROJECT_DIR_CACHE, _STATE_DIR_CACHE\n    _PROJECT_DIR_CACHE = None\n    _STATE_DIR_CACHE = None\n\n\ndef _project_dir_cache_key() -> Tuple[Optional[str], ...]:\n    \"\"\"Cache key for the declared environment and conditional cwd inputs.\n    PLAN-182 W1 cure: the Wave-A key was (CEO_AUDIT_LOG_DIR, HOME) — a\n    process that switched project mid-run (CLAUDE_PROJECT_DIR / cwd /\n    CLAUDE_PROJECT_DIR_NATIVE changed) kept being served the PREVIOUS\n    project's dir from cache, so the cross-project leak survived any\n    resolver cure. cwd participates when none of the directory candidates\n    is absolute. A lower-priority absolute candidate can still mask the\n    cwd dependency of a relative override; rc.1 condition 24 requires an\n    absolute CEO_AUDIT_LOG_DIR and records the remaining cache limitation.\n    \"\"\"\n    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n    env_home = os.environ.get(\"HOME\")\n    env_native = os.environ.get(\"CLAUDE_PROJECT_DIR_NATIVE\")\n    env_proj = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n    cwd: Optional[str] = None\n    # rail r15 P2-3: o cwd entra na chave quando NENHUM override absoluto\n    # decide o dir — inclui o caso de um override RELATIVO, que\n    # `project_dir()` resolve CONTRA o cwd. Sem isso, um processo longo\n    # que muda de cwd com CLAUDE_PROJECT_DIR relativo continuaria servindo\n    # o dir do projeto anterior (e pularia a invalidacao dos caches).\n    def _abs(v):\n        return bool(v) and os.path.isabs(v)\n    if not (_abs(env_dir) or _abs(env_native) or _abs(env_proj)):\n        cwd = os.getcwd()\n    return (env_dir, env_home, env_native, env_proj, cwd)\n\n\ndef _project_dir_from_env() -> Path:\n    \"\"\"Return the audit project dir (BYTE-IDENTICAL to audit_emit._audit_dir).\n    P1-5: must mirror audit_emit._audit_dir() exactly — CEO_AUDIT_LOG_DIR\n    precedence, then the SAME single resolver (_lib/runtime_paths,\n    PLAN-182 W1) audit_emit delegates to. CEO_AUDIT_LOG_PATH is the FILE\n    path, not the dir path, so we do NOT derive the dir from it\n    (audit_emit doesn't either).\n    PLAN-111 Wave A cache, PLAN-182 W1 key: single-slot, keyed on\n    _project_dir_cache_key() (all resolver inputs). Cache HIT skips\n    re-construction of Path object. Cache MISS replaces the slot\n    atomically.\n    Single-threaded contract: concurrent os.environ mutation = UB.\n    \"\"\"\n    global _PROJECT_DIR_CACHE\n    env_key = _project_dir_cache_key()\n    cached = _PROJECT_DIR_CACHE\n    if cached is not None and cached[0] == env_key:\n        return cached[1]\n    env_dir = env_key[0]\n    if env_dir:\n        p = Path(env_dir)\n    else:\n        p = _runtime_paths.runtime_state_dir()\n    _PROJECT_DIR_CACHE = (env_key, p)\n    return p\n\n\ndef _invalidate_per_pid_caches_on_project_switch(old_dir: Path) -> None:\n    \"\"\"Drop per-PID spool state when the resolved project changes.\n    rail r13 P1-1 (cura) + rail r14 (cura da cura): o flush do buffer\n    pendente e feito contra ``old_dir`` — o dir do projeto ANTERIOR, que\n    o chamador ja tem em cache. A primeira versao chamava\n    ``_flush_journal_buffer()``, que resolve o caminho por\n    ``_state_dir()``: como o cache ainda nao tinha sido trocado, aquilo\n    RE-ENTRAVA neste mesmo branch ate ``RecursionError`` e, pior,\n    reescrevia o payload antigo sob o dir do projeto NOVO — a\n    contaminacao cruzada que a invalidacao existe para impedir.\n    Fail-open: qualquer erro no flush apenas descarta os caches.\n    \"\"\"\n    pid = os.getpid()\n    buf = _JOURNAL_BUFFER.get(pid)\n    if buf:\n        try:\n            target = old_dir / \"{0}.{1}.journal\".format(_JOURNAL_PREFIX, pid)\n            with target.open(\"ab\") as fh:\n                for line in buf:\n                    fh.write(line)\n                fh.flush()\n                os.fsync(fh.fileno())\n        except Exception:  # pragma: no cover — nunca bloqueia a troca\n            pass\n    _SPOOL_HEADER_CACHE.pop(pid, None)\n    _ORDINAL_COUNTER.pop(pid, None)\n    _JOURNAL_BUFFER.pop(pid, None)\n\n\n# QDSAA-FUNCAO-LONGA: resolução segura combina isolamento de projeto, permissões e invalidação de cache.\ndef _state_dir() -> Path:\n    \"\"\"Return <audit_dir>/state/ ensuring parents exist (0700).\n    P1-5: state dir is unconditionally a child of audit_emit._audit_dir();\n    no CEO_PROJECT_STATE_DIR override (audit_emit doesn't expose one).\n    PLAN-111 Wave A: single-slot cache keyed on (CEO_AUDIT_LOG_DIR, HOME).\n    Cache HIT skips mkdir syscall + Path construction (saves ~17us/call x\n    5.7x/emit cumulative ~= 100us/emit recovery).\n    Cache MISS semantics (AC-A2a + SA-K10 permission re-assertion +\n    PLAN-113 W4-SEC mode-mismatch self-heal):\n      1. Resolve target Path (uses _project_dir_from_env cache implicitly).\n      2. Attempt mkdir(parents=True, exist_ok=True, mode=0o700).\n      3. If mkdir FAILS: breadcrumb + DO NOT cache (next call retries).\n      4. If mkdir SUCCEEDS: validate via lstat() that dir is not a symlink,\n         is owned by os.getuid(), and has mode 0o700.\n         - symlink / wrong-owner mismatch: FAIL-CLOSED (raise) — we never\n           chmod-and-trust an attacker-controlled or other-owned dir.\n         - mode-only mismatch (e.g. a pre-existing state/ at 0o755 created\n           by an older path; exist_ok=True does NOT relax perms): attempt\n           SELF-HEAL via os.chmod(d, 0o700) then RE-lstat + re-validate the\n           full invariant. If it is now a non-symlink, owned by os.getuid(),\n           AND 0o700 → PROCEED (cache + return). Otherwise keep the SA-K10\n           fail-CLOSED.\n      5. Only if validation (incl. any self-heal) succeeds: cache the Path.\n    Single-threaded contract: concurrent os.environ mutation = UB.\n    \"\"\"\n    global _STATE_DIR_CACHE\n    # PLAN-182 W1: key covers ALL resolver inputs (see\n    # _project_dir_cache_key) — a mid-process project switch must not be\n    # served the previous project's state dir.\n    env_key = _project_dir_cache_key()\n    cached = _STATE_DIR_CACHE\n    if cached is not None and cached[0] == env_key:\n        return cached[1]\n    # rail r13 P1-1: os caches POR PID (header/ordinal/journal) nao sao\n    # cobertos pela chave acima. Num processo longo A -> B -> A, o header\n    # de B seria reusado em A (UUID errado no corpo => o drain estrito\n    # QUARENTENA o spool de A) e o journal bufferizado poderia ir para o\n    # projeto errado. Uma transicao de projeto invalida os tres.\n    if cached is not None and cached[0] != env_key:\n        # passa o dir ANTIGO (cached[1]) — nunca re-resolve aqui.\n        _invalidate_per_pid_caches_on_project_switch(cached[1])\n    d = _project_dir_from_env() / \"state\"\n    mkdir_ok = False\n    try:\n        d.mkdir(parents=True, exist_ok=True, mode=0o700)\n        mkdir_ok = True\n    except OSError as e:\n        _breadcrumb(f\"_state_dir mkdir failed (no cache): \"\n                    f\"{type(e).__name__}: {e}\")\n    if mkdir_ok:\n        try:\n            import stat as _stat_mod\n\n            def _classify(st_mode: int, st_uid: int) -> \"Optional[str]\":\n                \"\"\"Return a mismatch reason, or None when state/ is healthy.\"\"\"\n                if _stat_mod.S_ISLNK(st_mode):\n                    return f\"is_symlink: {d}\"\n                if st_uid != os.getuid():\n                    return f\"uid_mismatch: {st_uid} != {os.getuid()}\"\n                if (st_mode & 0o777) != 0o700:\n                    return f\"mode_mismatch: {oct(st_mode & 0o777)} != 0o700\"\n                return None\n            st = os.lstat(str(d))\n            mismatch_reason: \"Optional[str]\" = _classify(st.st_mode, st.st_uid)\n            if (mismatch_reason is not None\n                    and not _stat_mod.S_ISLNK(st.st_mode)\n                    and st.st_uid == os.getuid()):\n                healed = False\n                fd = None\n                try:\n                    fd = os.open(\n                        str(d), os.O_RDONLY | os.O_NOFOLLOW | os.O_DIRECTORY\n                    )\n                    os.fchmod(fd, 0o700)\n                    fst = os.fstat(fd)\n                    mismatch_reason = _classify(fst.st_mode, fst.st_uid)\n                    if mismatch_reason is None:\n                        st = fst\n                        healed = True\n                except OSError as e:\n                    _breadcrumb(\n                        f\"_state_dir self-heal (O_NOFOLLOW fchmod) failed \"\n                        f\"(FAIL-CLOSED): {type(e).__name__}: {e}\"\n                    )\n                finally:\n                    if fd is not None:\n                        try:\n                            os.close(fd)\n                        except OSError:\n                            pass\n                if healed:\n                    _breadcrumb(\n                        f\"_state_dir mode self-healed to 0o700: {d}\"\n                    )\n            if mismatch_reason is not None:\n                _breadcrumb(\n                    f\"_state_dir SECURITY mismatch (FAIL-CLOSED): \"\n                    f\"{mismatch_reason}\"\n                )\n                raise PermissionError(\n                    f\"_state_dir permission re-assertion failed: \"\n                    f\"{mismatch_reason}\"\n                )\n            _STATE_DIR_CACHE = (env_key, d)\n        except PermissionError:\n            raise\n        except OSError as e:\n            _breadcrumb(f\"_state_dir lstat failed (no cache): \"\n                        f\"{type(e).__name__}: {e}\")\n    return d\ndef _canonical_log_path() -> Path:\n    \"\"\"Mirror audit_emit._log_path() — canonical audit-log.jsonl.\"\"\"\n    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n    if env:\n        return Path(env)\n    return _project_dir_from_env() / \"audit-log.jsonl\"\n\n\ndef _log_family_dir() -> Path:\n    \"\"\"Dir the lock/errors sidecars must share with the LOG.\n    PLAN-182 W1 rail r1 P1-2: mirrors audit_emit._log_family_dir()\n    byte-for-byte — when CEO_AUDIT_LOG_PATH moves the log, EVERY writer\n    of that log locks the moved parent (two writers on one HMAC log\n    under different locks = interleaved appends).\n    \"\"\"\n    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n    if env:\n        return Path(env).resolve().parent\n    return _project_dir_from_env()\n\n\ndef _canonical_log_lock() -> Path:\n    \"\"\"Mirror audit_emit._lock_path() — sibling .lock file.\"\"\"\n    env = os.environ.get(\"CEO_AUDIT_LOG_LOCK\")\n    if env:\n        return Path(env)\n    return _log_family_dir() / \"audit-log.lock\"\ndef _errors_path() -> Path:\n    \"\"\"Breadcrumb file for fail-open infra errors.\"\"\"\n    env = os.environ.get(\"CEO_AUDIT_LOG_ERR\")\n    if env:\n        return Path(env)\n    return _log_family_dir() / \"audit-log.errors\"\n\n\ndef _spool_path(pid: int) -> Path:\n    \"\"\"Active spool path for a given PID (header + body).\"\"\"\n    return _state_dir() / f\"{_SPOOL_PREFIX}.{pid}.jsonl\"\ndef _journal_path(pid: int) -> Path:\n    \"\"\"Per-PID journal path.\"\"\"\n    return _state_dir() / f\"{_JOURNAL_PREFIX}.{pid}.journal\"\n\n\ndef _aggregate_journal_path() -> Path:\n    \"\"\"Aggregate journal for swept dead-PID envelopes.\"\"\"\n    return _state_dir() / f\"{_JOURNAL_PREFIX}.journal\"\ndef _aggregate_journal_lock_path() -> Path:\n    \"\"\"flock for aggregation sweep at session-start.\"\"\"\n    return _state_dir() / f\"{_JOURNAL_PREFIX}.journal.aggregation.lock\"\n\n\ndef _spool_flock_path(pid: int) -> Path:\n    \"\"\"Per-PID spool flock sibling (NOT same fd as the spool file).\"\"\"\n    return _state_dir() / f\"{_SPOOL_PREFIX}.{pid}.jsonl.lock\"\ndef _journal_flock_path(pid: int) -> Path:\n    \"\"\"Per-PID journal flock sibling.\"\"\"\n    return _state_dir() / f\"{_JOURNAL_PREFIX}.{pid}.journal.lock\"\n\n\n# P0-1: single helper for the .draining.<epoch> filename construction.\n# Bug fix — old code did `f\"{spool_path}draining.{epoch}\"` (missing dot)\n# producing audit-spool.<pid>.jsonldraining.<epoch>; glob sweep failed.\ndef _draining_path(spool_path: Path, epoch: str) -> Path:\n    \"\"\"audit-spool.<pid>.jsonl → audit-spool.<pid>.draining.<epoch>.\"\"\"\n    stem = spool_path.stem  # 'audit-spool.<pid>' (strips trailing .jsonl)\n    return spool_path.with_name(f\"{stem}.draining.{epoch}\")\n_SPOOL_UUID_RE = re.compile(r\"^[0-9a-f]{16}$\")\ndef _validate_spool_header_strict(header: Any) -> bool:\n    \"\"\"Strict 4-field header invariant — same predicate used by Phase 2\n    quarantine and `_ensure_spool_header` PID-reuse path.\n\n    iter5-P1 closure: factored out so writer-side reuse cannot accept a\n    header that the drainer will later reject. Mismatch between writer\n    and drainer validation = silent data loss for events appended after\n    the lax reuse but before Phase 2 quarantine.\n\n    Returns True only when ALL of:\n      - dict with `_spool_header: True`\n      - `_spool_uuid: str` of length 16 and matching `^[0-9a-f]{16}$`\n      - `_pid: int`\n      - `_created_wall_ns: int`\n      - `_created_monotonic_ns: int`\n    \"\"\"\n    if not isinstance(header, dict):\n        return False\n    if header.get(\"_spool_header\") is not True:\n        return False\n    spool_uuid = header.get(\"_spool_uuid\")\n    if (not isinstance(spool_uuid, str)\n            or len(spool_uuid) != _SPOOL_UUID_HEX_LEN\n            or _SPOOL_UUID_RE.match(spool_uuid) is None):\n        return False\n    if not isinstance(header.get(\"_pid\"), int):\n        return False\n    if not isinstance(header.get(\"_created_wall_ns\"), int):\n        return False\n    if not isinstance(header.get(\"_created_monotonic_ns\"), int):\n        return False\n    return True\ndef _recover_ordinal_counter(spool_path: Path) -> int:\n    \"\"\"Return ordinal_within_file counter from existing spool body.\n\n    iter4-P1-1: replaces prior `\\n`-counting approach. A complete body\n    line WITHOUT trailing `\\n` (writer fsync'd then crashed before\n    terminator) was previously counted as zero entries → ordinal 0\n    re-issued → Phase 3 monotonicity quarantine. Now: parse each line\n    (terminated or not), return max(ordinal)+1. Returns 0 on missing/\n    empty/header-only/no-valid-ordinals.\n    \"\"\"\n    try:\n        with open(str(spool_path), \"rb\") as f:\n            content = f.read()\n    except OSError:\n        return 0\n    if b\"\\n\" not in content:\n        return 0\n    _header, body = content.split(b\"\\n\", 1)\n    if not body:\n        return 0\n    max_ord = -1\n    for line_bytes in body.split(b\"\\n\"):\n        if not line_bytes.strip():\n            continue\n        try:\n            entry = json.loads(line_bytes)\n        except (json.JSONDecodeError, ValueError):\n            continue\n        if not isinstance(entry, dict):\n            continue\n        o = entry.get(\"ordinal_within_file\")\n        if isinstance(o, int) and o > max_ord:\n            max_ord = o\n    return max_ord + 1 if max_ord >= 0 else 0\nclass _SpoolHeaderUnrecoverable(OSError):\n    \"\"\"Raised when an existing spool has an invalid header AND quarantine\n    rename fails. Caller (`spool_append`) MUST abort fail-open — minting\n    a fresh header over the still-present corrupt file would silently\n    lose the new event (Phase 2 quarantines the whole file later).\n    iter6-P1 closure.\n    \"\"\"\ndef _quarantine_corrupt_active_spool(spool_path: Path, pid: int) -> bool:\n    \"\"\"Rename malformed-header active spool aside; forensic emit.\n\n    iter4-P1-2: caller MUST hold `_spool_flock_path(pid)`. We must NOT\n    call drain_now() here (Phase 2 re-acquires this same flock →\n    self-timeout). _forensic() has its own re-entry guard so the emit\n    path won't recurse into spool_append.\n\n    iter6-P1: returns True on successful rename, False on rename failure.\n    Caller MUST honor False by aborting the current append fail-open\n    (NOT minting a fresh header over the still-present corrupt file —\n    that would let new events land behind a header Phase 2 will quarantine).\n    \"\"\"\n    epoch = secrets.token_hex(4)\n    corrupt_path = spool_path.with_name(\n        f\"{spool_path.stem}.corrupt-header.{epoch}\"\n    )\n    try:\n        os.rename(str(spool_path), str(corrupt_path))\n    except OSError as e:\n        _breadcrumb(\n            f\"quarantine_corrupt_active_spool rename failed pid={pid}: \"\n            f\"{type(e).__name__}: {e}\"\n        )\n        return False\n    _forensic(\"audit_spool_tamper_detected\", {\n        \"mismatch_kind\": \"malformed_active_spool_header\",\n        \"spool_pid\": pid,\n        \"corrupt_path\": str(corrupt_path),\n        \"drain_epoch\": epoch,\n    })\n    return True\ndef _breadcrumb(message: str) -> None:\n    \"\"\"Append a one-line forensic crumb; NEVER raise.\"\"\"\n    try:\n        p = _errors_path()\n        p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n        ts = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n        with p.open(\"a\", encoding=\"utf-8\") as f:\n            f.write(f\"{ts} spool_writer: {message}\\n\")\n    except Exception:  # pragma: no cover\n        pass\n\n\n# ---------------------------------------------------------------------------\n# Kill-switch + exit-handler state\n# ---------------------------------------------------------------------------\n\n\ndef is_sync_mode() -> bool:\n    \"\"\"CEO_AUDIT_SYNC_MODE=1 reverts to pre-Wave-A synchronous behavior.\"\"\"\n    return os.environ.get(\"CEO_AUDIT_SYNC_MODE\", \"\") == \"1\"\n_EXIT_HANDLER_INSTALLED = False\n_PREV_SIGTERM_HANDLER: Any = None\n_PREV_SIGINT_HANDLER: Any = None\n_EXIT_DEADLINE_MONOTONIC: Optional[float] = None\ndef set_exit_deadline(deadline_monotonic: Optional[float]) -> None:\n    \"\"\"Arm no-drain exit context; hook entrypoints own the monotonic deadline.\"\"\"\n    global _EXIT_DEADLINE_MONOTONIC\n    if deadline_monotonic is None:\n        _EXIT_DEADLINE_MONOTONIC = None\n        return\n    try:\n        _EXIT_DEADLINE_MONOTONIC = float(deadline_monotonic)\n    except (TypeError, ValueError):\n        _EXIT_DEADLINE_MONOTONIC = None\n        _breadcrumb(\"exit deadline ignored: invalid monotonic value\")\n\n\ndef _exit_deadline_active() -> bool:\n    \"\"\"Whether this process is running under a hook-owned deadline.\"\"\"\n    return _EXIT_DEADLINE_MONOTONIC is not None or os.environ.get(\"CEO_HOOK_BOUNDED_EXIT\") == \"1\"\ndef _record_exit_deadline_skip(source: str) -> None:\n    _breadcrumb(f\"exit_deadline_skip source={source}\")\n_SPOOL_HEADER_CACHE: Dict[int, Dict[str, Any]] = {}\n_ORDINAL_COUNTER: Dict[int, int] = {}\n_FORENSIC_EMIT: Optional[Callable[[str, Dict[str, Any]], None]] = None\n_IN_FORENSIC_EMIT = False\n_IN_SPOOL_APPEND = False\n_LAST_APPEND_SUCCEEDED = True\ndef last_append_succeeded() -> bool:\n    \"\"\"Whether the last spool_append persisted durably.\"\"\"\n    return _LAST_APPEND_SUCCEEDED\n\n# Per-PID journal buffer; flush at drain boundaries or every ten writes.\n_JOURNAL_FLUSH_EVERY = 10\n_JOURNAL_BUFFER: Dict[int, List[bytes]] = {}\n\n\ndef set_forensic_emitter(emit_fn: Callable[[str, Dict[str, Any]], None]) -> None:\n    \"\"\"Wire the forensic emit callback (called by audit_emit on import).\"\"\"\n    global _FORENSIC_EMIT\n    _FORENSIC_EMIT = emit_fn\ndef _forensic(action: str, fields: Dict[str, Any]) -> None:\n    \"\"\"Emit a forensic audit event via wired callback; swallow errors.\n\n    P1-4: recursion guard — if we're already inside a _forensic() emit,\n    write a breadcrumb and return without re-entering spool_append.\n    \"\"\"\n    global _IN_FORENSIC_EMIT\n    cb = _FORENSIC_EMIT\n    if cb is None:\n        return\n    if _IN_FORENSIC_EMIT:\n        _breadcrumb(f\"forensic re-entry blocked: {action}\")\n        return\n    _IN_FORENSIC_EMIT = True\n    try:\n        cb(action, fields)\n    except Exception as e:  # pragma: no cover\n        _breadcrumb(f\"forensic emit failed: {action}: {type(e).__name__}: {e}\")\n    finally:\n        _IN_FORENSIC_EMIT = False\ndef _origin_for_new_spool() -> str:\n    \"\"\"PLAN-119 WS-D1 — write-time origin stamp for a freshly-minted spool header.\n\n    Returns ``\"test\"`` when a test signal is present AT WRITE TIME\n    (``CEO_TEST_HARNESS=1`` or ``PYTEST_CURRENT_TEST`` set), else ``\"live\"``.\n    The writer knows the truth; the drainer cannot infer it later, so the stamp\n    is minted ONCE per spool (header) and is sticky to that PID's file. A real\n    session writes ``\"live\"`` and is never quarantined; legacy spool with no\n    ``_origin`` defaults to ``\"live\"`` at drain time (fail-safe toward never\n    dropping a real event).\n    \"\"\"\n    if (os.environ.get(\"CEO_TEST_HARNESS\") == \"1\"\n            or os.environ.get(\"PYTEST_CURRENT_TEST\")):\n        return \"test\"\n    return \"live\"\n\nfrom _lib._spool_writer_parts import install as _install_parts\n\n_install_parts(globals(), (\"writer\", \"prepare\", \"drain\", \"lifecycle\"))\n","numLines":591,"startLine":1,"totalLines":591}},"tool_result_meta":[{"id":"toolu_01CJGccnGpD9h7BSeUzMuX4d","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
