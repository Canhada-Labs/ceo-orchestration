    out: List[str] = []
    quote = ""
    escaped = False
    word_start = True
    commenting = False
    for ch in command:
        if commenting:
            if ch == "\n":
                out.append(ch)
                commenting = False
                word_start = True
            continue
        if escaped:
            out.append(ch)
            escaped = False
            word_start = False
            continue
        if ch == "\\" and quote != "'":
            out.append(ch)
            escaped = True
            continue
        if ch == quote:
            quote = ""
            out.append(ch)
            word_start = False
            continue
        if ch in ("'", '"') and not quote:
            quote = ch
            out.append(ch)
            word_start = False
            continue
        if ch == "#" and not quote and word_start:
            commenting = True
            continue
        out.append(ch)
        if not quote:
            word_start = ch.isspace() or ch in ";&|(){}<>"
