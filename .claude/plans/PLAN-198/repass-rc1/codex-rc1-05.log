    text = _prelex(command)
    shielded: List[str] = []
    quote = ""
    escaped = False
    for ch in text:
        if escaped:
            shielded.append(ch)
            escaped = False
        elif ch == "\\" and quote != "'":
            shielded.append(ch)
            escaped = True
        elif ch == quote:
            quote = ""
            shielded.append(ch)
        elif ch in ("'", '"') and not quote:
            quote = ch
            shielded.append(ch)
        else:
            shielded.append(_QUOTED_OPERATORS.get(ch, ch) if quote else ch)
