-> List[Tok]:\n162\t    \"\"\"Tokenise one logical line.\n163\t\n164\t    Raises Incomplete when more physical lines are needed, ParseError when the\n165\t    input cannot be modelled at all.  Never returns a best-effort result.\n166\t    \"\"\"\n167\t    toks: List[Tok] = []\n168\t    i = 0\n169\t    n = len(text)\n170\t    while i < n:\n171\t        c = text[i]\n172\t        if c in \" \\t\":\n173\t            i += 1\n174\t            continue\n175\t        if c == \"\\n\":\n176\t            toks.append(Tok(\"op\", \"\\n\"))\n177\t            i += 1\n178\t            continue\n179\t        if c == \"\\\\\" and i + 1 < n and text[i + 1] == \"\\n\":\n180\t            i += 2\n181\t            continue\n182\t        if c == \"\\\\\" and i + 1 >= n:\n183\t            raise Incomplete(\"trailing backslash\")\n184\t        if c == \"#\" and _at_word_boundary(text, i):\n185\t            k = text.find(\"\\n\", i)\n186\t            if k < 0:\n187\t                break\n188\t            i = k\n189\t            continue\n190\t        if text.startswith(\"[[\", i) and _at_word_boundary(text, i):\n191\t            toks.append(Tok(\"op\", \"[[\"))\n192\t            i += 2\n193\t            continue\n194\t        if text.startswith(\"]]\", i):\n195\t            toks.append(Tok(\"op\", \"]]\"))\n196\t            i += 2\n197\t            continue\n198\t        if (text.startswith(\"<(\", i) or text.startswith(\">(\", i)):\n199\t            # Process substitution is a single operand, not a subshell that the\n200\t            # block stack must balance.\n201\t            j, seg = _read_balanced(text, i + 1, \"(\", \")\")\n202\t            toks.append(Tok(\"op\", text[i] + \"(...)\"))\n203\t            i = j\n204\t            continue\n205\t        if text.startswith(\"((\", i) and _at_word_boundary(text, i):\n206\t            j, seg = _read_balanced(text, i + 1, \"(\", \")\")\n207\t            if j < n and text[j] == \")\":\n208\t                j += 1\n209\t            toks.append(Tok(\"op\", \"((...))\"))\n210\t            i = j\n211\t            continue\n212\t        matched = None\n213\t        for op in _OPERATORS:\n214\t            if text.startswith(op, i):\n215\t                matched = op\n216\t                break\n217\t        if matched is not None:\n218\t            toks.append(Tok(\"op\", matched))\n219\t            i += len(matched)\n220\t            continue\n221\t        word, i2, quoted = _read_word(text, i)\n222\t        if i2 == i:\n223\t            raise ParseError(\"lexer made no progress at offset %d\" % i)\n224\t        toks.append(Tok(\"word\", word, quoted))\n225\t        i = i2\n226\t    return toks\n227\t\n228\t\n229\t# --------------------------------------------------------------------------\n230\t# Logical lines (continuations joined, heredoc bodies removed)\n231\t# --------------------------------------------------------------------------\n232\t\n233\t_RE_HEREDOC_TAG = re.compile(r\"^['\\\"]?([A-Za-z_][A-Za-z0-9_]*)['\\\"]?$\")\n234\t\n235\t\n236\tclass LogicalLine(object):\n237\t    __slots__ = (\"lineno\", \"text\", \"toks\", \"scope\", \"indent\", \"pattern_upto\")\n238\t\n239\t    def __init__(self, lineno: int, text: str, toks: List[Tok]) -> None:\n240\t        self.lineno = lineno          # 1-based physical line where it starts\n241\t        self.text = text\n242\t        self.toks = toks\n243\t        self.scope: Tuple[int, ...] = ()\n244\t        self.indent = len(text) - len(text.lstrip(\" \\t\"))\n245\t        # Token index just past a `case` arm's `)`; everything before it is a\n246\t        # PATTERN, which matches but never writes.\n247\t        self.pattern_upto = 0\n248\t\n249\t    def snippet(self) -> str:\n250\t        return re.sub(r\"\\s+\", \" \", self.text).strip()[:200]\n251\t\n252\t\n253\tdef build_logical_lines(raw: str) -> List[LogicalLine]:\n254\t    \"\"\"Join continuations, drop heredoc bodies, lex every logical line.\n255\t\n256\t    Raises ParseError on anything unterminated.  A