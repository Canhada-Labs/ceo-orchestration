-def _pct_of_sorted(lst: List[float], p: float) -> float:
-    """Nearest-rank percentile of an ascending-sorted list (0.0 on empty)."""
-    if not lst:
-        return 0.0
-    idx = int((len(lst) - 1) * p / 100.0)
-    return lst[min(idx, len(lst) - 1)]
