-_BACKTICK_ENV_RE = re.compile(r"`(" + _ENV_NAME_BODY + r")`")
-_SHELL_ASSIGN_RE = re.compile(r"\b(" + _ENV_NAME_BODY + r")=[^\s]")
-_DOLLAR_VAR_RE = re.compile(r"\$(" + _ENV_NAME_BODY + r")\b")
-
