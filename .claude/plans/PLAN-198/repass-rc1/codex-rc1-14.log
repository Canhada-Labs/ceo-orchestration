    # so target_path_hash (12-hex sha256) is the ONLY path representation in the log
    # (replaces the old target_path_preview raw-path field; Sec MF-3 P1 fix).
    "benchmark_run",
    "breaker_closed",
    "breaker_opened",
    "budget_bypass_used",
    "budget_exceeded",
    "canonical_edit_attempted",
    "canonical_edit_blocked",
