-def _e3_clamp01(v):
-    """Coerce to 0/1 (enforced flag). Anything truthy-but-weird -> 0 (safe)."""
-    try:
-        return 1 if int(v) == 1 else 0
-    except (TypeError, ValueError):
-        return 0
