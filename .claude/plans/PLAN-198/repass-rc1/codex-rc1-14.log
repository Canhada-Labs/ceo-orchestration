-        "plan_id_hash": plan_id_hash,
-        "key_hash": key_hash,
-        "value_bytes": int(value_bytes),
-        "ttl_seconds": int(ttl_seconds) if ttl_seconds is not None else None,
-        "redaction_applied": bool(redaction_applied),
-        "session_id": session_id,
-        "project": project,
-    }
-    _write_event(event)
