{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017XnKJJc4NE7pLesRhcYcz4","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\tfrom ._shared import *\n3\tfrom _lib import cli_currency as _cli_currency\n4\t\n5\t_PRODUCTION_PROMOTED_BY_PLAN_091: bool = True\n6\t\n7\t_L3_PLUS_GLOB_PATTERNS: Tuple[str, ...] = (\n8\t    \".claude/hooks/_lib/*.py\",\n9\t    \".claude/hooks/_lib/**/*.py\",\n10\t    \".claude/hooks/check_*.py\",\n11\t    \".claude/hooks/audit_*.py\",\n12\t    \".claude/scripts/local/*\",\n13\t    \".claude/policies/*.yaml\",\n14\t    \".claude/policies/*.yml\",\n15\t    \"SPEC/v1/*.md\",\n16\t    \".github/workflows/*.yml\",\n17\t    \".github/workflows/*.yaml\",\n18\t    \"PROTOCOL.md\",\n19\t)\n20\t\n21\tdef _fnmatch_segments(path: str, pattern: str) -> bool:\n22\t    \"\"\"Segment-wise glob matcher with `*` (one segment) and `**` (zero+).\n23\t\n24\t    Stripped-down port of `check_canonical_edit._fnmatch_segments`.\n25\t    \"\"\"\n26\t    import fnmatch as _fn\n27\t\n28\t    p_parts = path.split(\"/\")\n29\t    pat_parts = pattern.split(\"/\")\n30\t\n31\t    def _match(p: List[str], pat: List[str]) -> bool:\n32\t        if not pat:\n33\t            return not p\n34\t        head, rest = pat[0], pat[1:]\n35\t        if head == \"**\":\n36\t            for i in range(len(p) + 1):\n37\t                if _match(p[i:], rest):\n38\t                    return True\n39\t            return False\n40\t        if not p:\n41\t            return False\n42\t        if head == \"*\" or _fn.fnmatchcase(p[0], head):\n43\t            return _match(p[1:], rest)\n44\t        return False\n45\t\n46\t    return _match(p_parts, pat_parts)\n47\t\n48\tdef _is_l3_plus_path(path_str: str, repo_root: Path) -> bool:\n49\t    \"\"\"True if path classifies as L3+ per the production heuristic.\"\"\"\n50\t    if not path_str:\n51\t        return False\n52\t    p = Path(path_str)\n53\t    try:\n54\t        rel_path = (\n55\t            p.resolve().relative_to(repo_root.resolve())\n56\t            if p.is_absolute()\n57\t            else Path(path_str)\n58\t        )\n59\t    except (ValueError, OSError):\n60\t        # Path outside repo or non-resolvable — not L3+.\n61\t        return False\n62\t    rel_str = str(rel_path).replace(os.sep, \"/\")\n63\t    for pattern in _L3_PLUS_GLOB_PATTERNS:\n64\t        if _fnmatch_segments(rel_str, pattern):\n65\t            return True\n66\t    return False\n67\t\n68\t_CODEX_PATCH_RE = re.compile(\n69\t    r\"^\\*\\*\\*\\s+(Update|Add|Delete|Move|Rename)\\s+File:?\\s+(.+?)\\s*$\",\n70\t    re.MULTILINE,\n71\t)\n72\t\n73\t_CODEX_MOVE_RE = re.compile(\n74\t    r\"^\\*\\*\\*\\s+(?:Move|Rename)\\s+to:?\\s+(.+?)\\s*$\",\n75\t    re.MULTILINE,\n76\t)\n77\t\n78\t_UNIFIED_DIFF_RE = re.compile(\n79\t    r\"^(?:---|\\+\\+\\+)\\s+(?:[ab]/)?(.+?)\\s*$\", re.MULTILINE,\n80\t)\n81\t\n82\t_JSON_PATCH_PATH_RE = re.compile(\n83\t    r'\"path\"\\s*:\\s*\"(/[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*)\"'\n84\t)\n85\t\n86\t_MAX_RESPONSE_BYTES = 4 * 1024 * 1024  # 4 MiB\n87\t\n88\t_MAX_RESPONSE_LINES = 200_000\n89\t\n90\t_MAX_OUTPUT_FILE_BYTES: int = 1 * 1024 * 1024  # 1 MiB\n91\t\n92\tdef _detect_write_shaped_patch(response_text: str) -> Optional[str]:\n93\t    \"\"\"Detect any write-shaped patch in a Codex review response.\n94\t\n95\t    Returns the matched grammar tag (`codex_apply_patch`, `unified_diff`,\n96\t    `codex_move`, `json_patch`) on first detection, or None if response\n97\t    is clean. Order is: Codex envelope → unified diff → JSON patch.\n98\t\n99\t    Defense:\n100\t    - Length cap (4 MiB) — pathological responses skipped (treated as\n101\t      clean by production heuristic; future revision should fail-CLOSED).\n102\t    - Line cap (200k) — bound regex iteration.\n103\t    - All regexes anchored with `^...$` (multiline) — no nested\n104\t      quantifiers susceptible to ReDoS.\n105\t    \"\"\"\n106\t    if not isinstance(response_text, str) or not response_text:\n107\t        return None\n108\t    if len(response_text) > _MAX_RESPONSE_BYTES:\n109\t        # Spike: treat oversize as clean (advisory). Production note:\n110\t        # ADR-110 PROPOSED Phase 1 should fail-CLOSED here.\n111\t        return None\n112\t    # Cap line count via early exit on findall-like inspection.\n113\t    line_count = response_text.count(\"\\n\")\n114\t    if line_count > _MAX_RESPONSE_LINES:\n115\t        return None\n116\t\n117\t    # Grammar 1a: Codex apply_patch envelope.\n118\t    if _CODEX_PATCH_RE.search(response_text) is not None:\n119\t        return \"codex_apply_patch\"\n120\t\n121\t    # Grammar 1b: Codex move directive.\n122\t    if _CODEX_MOVE_RE.search(response_text) is not None:\n123\t        return \"codex_move\"\n124\t\n125\t    # Grammar 2: Unified diff. Filter false positives from prose by\n126\t    # requiring the second-half marker to also exist (`---` AND `+++`).\n127\t    has_minus = re.search(r\"^---\\s+\", response_text, re.MULTILINE) is not None\n128\t    has_plus = re.search(r\"^\\+\\+\\+\\s+\", response_text, re.MULTILINE) is not None\n129\t    if has_minus and has_plus:\n130\t        return \"unified_diff\"\n131\t\n132\t    # Grammar 3: JSON Patch (RFC 6902). Two-pass:\n133\t    # (a) JSON-shape body — try strict json.loads.\n134\t    stripped = response_text.lstrip()\n135\t    if stripped.startswith((\"[\", \"{\")):\n136\t        try:\n137\t            parsed = json.loads(response_text)\n138\t        except (ValueError, TypeError):\n139\t            parsed = None\n140\t        if isinstance(parsed, list):\n141\t            for op in parsed:\n142\t                if (\n143\t                    isinstance(op, dict)\n144\t                    and isinstance(op.get(\"op\"), str)\n145\t                    and isinstance(op.get(\"path\"), str)\n146\t                    and op[\"path\"].startswith(\"/\")\n147\t                    and op[\"op\"] in {\"add\", \"remove\", \"replace\", \"move\", \"copy\"}\n148\t                ):\n149\t                    return \"json_patch\"\n150\t        elif isinstance(parsed, dict):\n151\t            # Single op object (uncommon but valid).\n152\t            if (\n153\t                isinstance(parsed.get(\"op\"), str)\n154\t                and isinstance(parsed.get(\"path\"), str)\n155\t                and parsed[\"path\"].startswith(\"/\")\n156\t                and parsed[\"op\"] in {\"add\", \"remove\", \"replace\", \"move\", \"copy\"}\n157\t            ):\n158\t                return \"json_patch\"\n159\t    # (b) Legacy regex fallback for embedded JSON-Patch fragments in\n160\t    # mixed prose.\n161\t    if (\n162\t        '\"op\"' in response_text\n163\t        and '\"path\"' in response_text\n164\t        and _JSON_PATCH_PATH_RE.search(response_text) is not None\n165\t    ):\n166\t        return \"json_patch\"\n167\t\n168\t    return None\n169\t\n170\tclass CodexUnavailable(Exception):\n171\t    \"\"\"Raised when Codex binary is missing or invoke fails non-recoverably.\"\"\"\n172\t\n173\tclass CodexTimeout(Exception):\n174\t    \"\"\"Raised when Codex exceeds the wall-clock cap (CEO_PAIR_RAIL_TIMEOUT_S).\"\"\"\n175\t\n176\tclass CodexMalformed(Exception):\n177\t    \"\"\"Raised when Codex stdout cannot be parsed as a valid review envelope.\"\"\"\n178\t\n179\tclass CodexPinMismatch(Exception):\n180\t    \"\"\"ADR-182 fail-CLOSED: payload-pin verification failed on a SECURITY\n181\t    input (targetTriple absent from the manifest, malformed manifest\n182\t    entry, or SHA-256 mismatch between the resolved native payload and\n183\t    its pinned entry). The consumer (`_decide`) maps this to\n184\t    `{decision: block}` — the unverified binary is never invoked and the\n185\t    L3+ write does not proceed under a silently-degraded rail.\"\"\"\n186\t\n187\t_PIN_MANIFEST_REL: Tuple[str, ...] = (\n188\t    \".claude\", \"governance\", \"codex-cli-pin-manifest.json\",\n189\t)\n190\t\n191\t_SHA256_HEX_RE = re.compile(r\"^[0-9a-f]{64}$\")\n192\t\n193\tdef _codex_target_triple() -> Optional[str]:\n194\t    \"\"\"Derive the launcher's targetTriple for this host, or None.\n195\t\n196\t    Mirrors `bin/codex.js` (`process.platform`/`process.arch` mapping,\n197\t    transcribed in PLAN-163 `probes/payload-sha-evidence.md`). Windows\n198\t    payloads carry a `.exe` suffix handled in `_resolve_codex_payload`.\n199\t\n200\t    H1 fail-CLOSED test seam: `CEO_PAIR_RAIL_TARGET_TRIPLE` overrides the\n201\t    derivation ONLY under the explicit `CEO_PAIR_RAIL_TEST_MODE=1` marker.\n202\t    On the LIVE path (no marker) the override is IGNORED and the triple is\n203\t    derived from the real host, so no CODEX-specific seam can point\n204\t    verification at a foreign per-triple manifest entry. The\n205\t    derived-or-overridden triple is still VERIFIED downstream — this seam\n206\t    never relaxes the sha comparison. (Scope, PLAN-163 DIM1: this \"no env\"\n207\t    claim covers CODEX-specific seams only; the manifest BASE follows the\n208\t    framework-wide `CLAUDE_PROJECT_DIR` anchor — see `_pin_manifest_path`.)\n209\t    \"\"\"\n210\t    if os.environ.get(\"CEO_PAIR_RAIL_TEST_MODE\") == \"1\":\n211\t        override = os.environ.get(\"CEO_PAIR_RAIL_TARGET_TRIPLE\")\n212\t        if override:\n213\t            return override\n214\t    try:\n215\t        import platform as _platform\n216\t        sysname = _platform.system()\n217\t        machine = _platform.machine().lower()\n218\t    except Exception:\n219\t        return None\n220\t    arm = machine in (\"arm64\", \"aarch64\")\n221\t    x64 = machine in (\"x86_64\", \"amd64\")\n222\t    if sysname == \"Darwin\":\n223\t        if arm:\n224\t            return \"aarch64-apple-darwin\"\n225\t        if x64:\n226\t            return \"x86_64-apple-darwin\"\n227\t    elif sysname == \"Linux\":\n228\t        if x64:\n229\t            return \"x86_64-unknown-linux-musl\"\n230\t        if arm:\n231\t            return \"aarch64-unknown-linux-musl\"\n232\t    elif sysname == \"Windows\":\n233\t        if x64:\n234\t            return \"x86_64-pc-windows-msvc\"\n235\t        if arm:\n236\t            return \"aarch64-pc-windows-msvc\"\n237\t    return None\n238\t\n239\tdef _pin_manifest_path() -> Path:\n240\t    \"\"\"Resolve the ADR-182 manifest path (test seam → repo default).\n241\t\n242\t    H1 fail-CLOSED: the `CEO_PAIR_RAIL_PIN_MANIFEST` override is a TEST\n243\t    seam honoured ONLY under `CEO_PAIR_RAIL_TEST_MODE=1`. On the LIVE path\n244\t    the override is IGNORED and the manifest base resolves under the\n245\t    framework-wide `CLAUDE_PROJECT_DIR` anchor. The seam never relaxes the\n246\t    sha comparison — a test manifest is still matched byte-for-byte against\n247\t    the resolved payload.\n248\t\n249\t    Scope (PLAN-163 DIM1): the guarantee \"no env redirects verification at\n250\t    an attacker-supplied manifest\" is scoped to CODEX-SPECIFIC seams. The\n251\t    base still follows `CLAUDE_PROJECT_DIR` — the framework-wide anchor\n252\t    every hook already trusts — so an attacker who can repoint that anchor\n253\t    has already compromised the entire tree, which is OUTSIDE this pin's\n254\t    threat model. The pin defends T-8 (a payload swap under an\n255\t    otherwise-intact environment), not a hostile framework anchor.\n256\t    \"\"\"\n257\t    if os.environ.get(\"CEO_PAIR_RAIL_TEST_MODE\") == \"1\":\n258\t        override = os.environ.get(\"CEO_PAIR_RAIL_PIN_MANIFEST\")\n259\t        if override:\n260\t            return Path(override)\n261\t    repo_root = Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n262\t    return repo_root.joinpath(*_PIN_MANIFEST_REL)\n263\t\n264\tclass CodexPinManifestMalformed(Exception):\n265\t    \"\"\"Fail-CLOSED signal (PLAN-163 C2 fix): the pin manifest is PRESENT\n266\t    but not parseable as a valid manifest — a broken-JSON body, non-utf8\n267\t    bytes, a top-level that is not an object / carries ``schema != 1``, or\n268\t    a ``payloads`` value that is not an object. Per the PLAN-152 debate-C4\n269\t    fail-CLOSED-on-input doctrine, content a security matcher cannot parse\n270\t    is BLOCKED, never waved through as an INFRA advisory. Distinct from a\n271\t    genuinely ABSENT / unreadable manifest (OSError — content not present),\n272\t    which stays INFRA -> fail-open. ``verify_codex_payload`` catches this\n273\t    and maps it to ``status='mismatch'`` (-> ``CodexPinMismatch`` -> BLOCK).\n274\t    \"\"\"\n275\t\n276\tdef _load_pin_manifest(path: Path) -> Optional[Dict[str, Any]]:\n277\t    \"\"\"Parse the pin manifest, separating the two failure CLASSES the\n278\t    fail-CLOSED-on-input doctrine (PLAN-152 debate C4) requires:\n279\t\n280\t    * Manifest ABSENT / unreadable — the content is NOT present. Any\n281\t      ``OSError`` from the read (``FileNotFoundError``, ``PermissionError``,\n282\t      ``IsADirectoryError``, ...) -> return ``None`` -> the caller\n283\t      classifies it INFRA -> fail-OPEN advisory (same doctrine as a missing\n284\t      binary).\n285\t    * Manifest PRESENT but NOT parseable as a valid manifest — a\n286\t      ``json.JSONDecodeError`` (subclass of ``ValueError``), non-utf8 bytes\n287\t      (``UnicodeDecodeError`` — also a ``ValueError``), a top-level that is\n288\t      not an object / has ``schema != 1``, or a non-object ``payloads`` ->\n289\t      raise ``CodexPinManifestMalformed`` -> the caller fail-CLOSES to\n290\t      ``status='mismatch'`` (BLOCK). A swapped / corrupt manifest must not\n291\t      silently degrade the rail to advisory (that silent degrade is the\n292\t      exact 0.144.1->0.144.6 no-gate-trip failure ADR-182 closes).\n293\t\n294\t    The two classes are NEVER conflated: an ``OSError`` is not a parse\n295\t    failure, and a parse failure is not an ``OSError``.\n296\t    \"\"\"\n297\t    try:\n298\t        raw = path.read_text(encoding=\"utf-8\")\n299\t    except OSError:\n300\t        # Content NOT present / unreadable -> INFRA -> advisory.\n301\t        return None\n302\t    except ValueError as e:\n303\t        # UnicodeDecodeError IS-A ValueError: the bytes ARE present but are\n304\t        # not decodable as utf-8 -> content-present-not-parseable ->\n305\t        # fail-CLOSED.\n306\t        raise CodexPinManifestMalformed(\n307\t            \"pin manifest not utf-8: \" + type(e).__name__\n308\t        )\n309\t    try:\n310\t        data = json.loads(raw)\n311\t    except Exception as e:\n312\t        # C2 (codex R4): the bytes ARE present (read_text OSError is handled\n313\t        # above as INFRA). ANY failure parsing present bytes — json.JSONDecodeError\n314\t        # (IS-A ValueError), or a non-ValueError parser failure such as\n315\t        # RecursionError on a deeply-nested payload — is present-but-unparseable\n316\t        # security-matcher input -> fail-CLOSED (CLAUDE.md §4). A narrow\n317\t        # `except ValueError` let RecursionError escape to the caller's broad\n318\t        # infra/advisory catch-all; catch-all here keeps the block.\n319\t        raise CodexPinManifestMalformed(\n320\t            \"pin manifest unparseable: \" + type(e).__name__\n321\t        )\n322\t    if not isinstance(data, dict) or data.get(\"schema\") != 1:\n323\t        raise CodexPinManifestMalformed(\n324\t            \"pin manifest top-level invalid (not an object or schema != 1)\"\n325\t        )\n326\t    if not isinstance(data.get(\"payloads\"), dict):\n327\t        raise CodexPinManifestMalformed(\n328\t            \"pin manifest 'payloads' is not an object\"\n329\t        )\n330\t    return data\n331\t\n332\tdef _sha256_file(path: Path) -> Optional[str]:\n333\t    \"\"\"SHA-256 hex of a file (chunked; payload is ~260 MB). None on IO error.\"\"\"\n334\t    import hashlib\n335\t    try:\n336\t        h = hashlib.sha256()\n337\t        with open(path, \"rb\") as f:\n338\t            for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n339\t                h.update(chunk)\n340\t        return h.hexdigest()\n341\t    except Exception:\n342\t        return None\n343\t\n344\tdef _resolve_codex_payload(\n345\t    launcher: Path, manifest_rel_path: str, triple: str\n346\t) -> Optional[Path]:\n347\t    \"\"\"Mirror the launcher's `findCodexExecutable()` payload resolution.\n348\t\n349\t    `launcher` is the `codex` entry found on $PATH (an npm symlink).\n350\t    Candidates, in launcher order:\n351\t      1. `require.resolve(\"@openai/codex-<platform>/package.json\")` —\n352\t         node walks `node_modules/` up from the launcher package dir;\n353\t         we walk the same ancestors joining `node_modules/<manifest\n354\t         entry path>` (the manifest `path` field IS the\n355\t         package-relative payload path, e.g.\n356\t         `@openai/codex-darwin-arm64/vendor/<triple>/bin/codex`).\n357\t      2. Launcher fallback `__dirname/../vendor/<triple>/bin/codex`\n358\t         (i.e. `<pkg_dir>/vendor/...`).\n359\t    Returns the first existing regular file, else None (INFRA).\n360\t    \"\"\"\n361\t    try:\n362\t        real = launcher.resolve()\n363\t    except (OSError, RuntimeError):\n364\t        return None\n365\t    pkg_dir = real.parent.parent  # <pkg>/bin/codex.js → <pkg>\n366\t    rel_parts = [p for p in manifest_rel_path.split(\"/\") if p]\n367\t    if not rel_parts:\n368\t        return None\n369\t    exe_suffix = \".exe\" if os.name == \"nt\" else \"\"\n370\t    candidates: List[Path] = []\n371\t    for anc in [pkg_dir] + list(pkg_dir.parents):\n372\t        candidates.append(anc.joinpath(\"node_modules\", *rel_parts))\n373\t    candidates.append(pkg_dir / \"vendor\" / triple / \"bin\" / \"codex\")\n374\t    for cand in candidates:\n375\t        if exe_suffix and cand.suffix != exe_suffix:\n376\t            cand = cand.with_name(cand.name + exe_suffix)\n377\t        try:\n378\t            if cand.is_file():\n379\t                return cand\n380\t        except OSError:\n381\t            continue\n382\t    return None\n383\t\n384\t# QDSAA-FUNCAO-LONGA: preserva numa transação a classificação fail-open/fail-closed do pin, detalhes forenses e contrato CLI.\n385\tdef verify_codex_payload(\n386\t    launcher: Optional[str] = None,\n387\t    *,\n388\t    payload_override: Optional[str] = None,\n389\t) -> Dict[str, Any]:\n390\t    \"\"\"ADR-182 verification kernel — shared by this hook's runtime\n391\t    verify-then-invoke path, `pair-rail-gate.sh` Gate 4 (via the\n392\t    `--verify-codex-pin` CLI below), and tests. NEVER raises.\n393\t\n394\t    Two ingress shapes, ONE verification (H1 fail-CLOSED single code\n395\t    path — no env is a sha-check bypass):\n396\t\n397\t      * ``payload_override`` set (the `CEO_PAIR_RAIL_CODEX_BIN` seam) —\n398\t        the override IS the native payload. Its sha256 is hashed\n399\t        DIRECTLY and compared against the manifest entry for the current\n400\t        triple. A set-but-missing / non-regular override is a fail-CLOSED\n401\t        ``mismatch`` (\"inexistente = BLOQUEIA\"), never a silent advisory\n402\t        degrade: a hostile override must not be able to relax the rail by\n403\t        pointing at a vanished path.\n404\t      * ``launcher`` given / discovered on $PATH — mirror the launcher's\n405\t        `findCodexExecutable()` to resolve the native payload, then hash\n406\t        + compare it.\n407\t\n408\t    In BOTH shapes the resolved payload's sha256 is compared against the\n409\t    per-triple pin-manifest entry. No env relaxes this comparison.\n410\t\n411\t    Returns a dict:\n412\t      status        — \"verified\" | \"mismatch\" | \"triple_missing\" | \"infra\"\n413\t      detail        — machine-readable slug for the specific arm\n414\t      path          — resolved native payload path (\"\" until resolved)\n415\t      sha256        — computed payload sha256 (\"\" until computed)\n416\t      expected_sha256 — manifest entry sha256 (\"\" if no entry)\n417\t      target_triple — derived/overridden triple (\"\" if underivable)\n418\t      manifest      — manifest path consulted\n419\t\n420\t    Classification contract (docstring §ADR-182): \"infra\" arms are\n421\t    fail-OPEN at the consumer; \"mismatch\"/\"triple_missing\" arms are\n422\t    fail-CLOSED (`CodexPinMismatch`). An underivable host triple is\n423\t    classified `triple_missing` — a host we cannot map cannot be\n424\t    verified, and unverifiable must not silently degrade to advisory.\n425\t    \"\"\"\n426\t    manifest_path = _pin_manifest_path()\n427\t    result: Dict[str, Any] = {\n428\t        \"status\": \"infra\",\n429\t        \"detail\": \"\",\n430\t        \"path\": \"\",\n431\t        \"sha256\": \"\",\n432\t        \"expected_sha256\": \"\",\n433\t        \"installed_version\": \"\",\n434\t        \"target_triple\": \"\",\n435\t        \"manifest\": str(manifest_path),\n436\t    }\n437\t    try:\n438\t        # Ingress-shape resolution of the LAUNCHER (needed only when no\n439\t        # direct payload override was supplied). The override path does\n440\t        # NOT resolve via a launcher — it is hashed directly below.\n441\t        launcher_path: Optional[Path] = None\n442\t        if payload_override is None:\n443\t            launcher_path = Path(launcher) if launcher else None\n444\t            if launcher_path is None:\n445\t                for entry_dir in os.environ.get(\"PATH\", \"\").split(os.pathsep):\n446\t                    candidate = Path(entry_dir) / \"codex\"\n447\t                    if candidate.exists() and os.access(candidate, os.X_OK):\n448\t                        launcher_path = candidate\n449\t                        break\n450\t            if launcher_path is None or not launcher_path.exists():\n451\t                result[\"detail\"] = \"launcher_not_found\"\n452\t                return result\n453\t\n454\t        triple = _codex_target_triple()\n455\t        if triple is None:\n456\t            result[\"status\"] = \"triple_missing\"\n457\t            result[\"detail\"] = \"target_triple_underivable\"\n458\t            return result\n459\t        result[\"target_triple\"] = triple\n460\t\n461\t        try:\n462\t            manifest = _load_pin_manifest(manifest_path)\n463\t        except CodexPinManifestMalformed:\n464\t            # PRESENT-but-unparseable manifest = INPUT-parse failure of a\n465\t            # security matcher -> fail-CLOSED (PLAN-152 debate C4). A\n466\t            # corrupt/swapped manifest must not silently degrade the rail\n467\t            # to advisory. status='mismatch' -> CodexPinMismatch -> BLOCK.\n468\t            result[\"status\"] = \"mismatch\"\n469\t            result[\"detail\"] = \"manifest_malformed\"\n470\t            return result\n471\t        if manifest is None:\n472\t            # ABSENT / unreadable (OSError) -> INFRA -> fail-OPEN advisory,\n473\t            # same doctrine as a missing binary.\n474\t            result[\"detail\"] = \"manifest_unreadable\"\n475\t            return result\n476\t\n477\t        entry = manifest[\"payloads\"].get(triple)\n478\t        if entry is None:\n479\t            currency_path = Path(payload_override) if payload_override else launcher_path\n480\t            if currency_path and _apply_currency_policy(\n481\t                currency_path, launcher_path, manifest, result\n482\t            ):\n483\t                return result\n484\t            result[\"status\"] = \"triple_missing\"\n485\t            result[\"detail\"] = \"triple_absent_from_manifest\"\n486\t            return result\n487\t        if not isinstance(entry, dict):\n488\t            result[\"status\"] = \"mismatch\"\n489\t            result[\"detail\"] = \"manifest_entry_malformed\"\n490\t            return result\n491\t        expected = entry.get(\"sha256\")\n492\t        rel_path = entry.get(\"path\")\n493\t        if (\n494\t            not isinstance(expected, str)\n495\t            or _SHA256_HEX_RE.match(expected) is None\n496\t            or not isinstance(rel_path, str)\n497\t            or not rel_path\n498\t        ):\n499\t            # Malformed SECURITY input inside the matcher → fail-CLOSED\n500\t            # (PLAN-152 debate C4 doctrine), never waved through.\n501\t            result[\"status\"] = \"mismatch\"\n502\t            result[\"detail\"] = \"manifest_entry_malformed\"\n503\t            return result\n504\t        result[\"expected_sha256\"] = expected\n505\t\n506\t        if payload_override is not None:\n507\t            # H1: the override is VERIFIED, never trusted un-hashed. A\n508\t            # set-but-absent / non-regular override is a fail-CLOSED\n509\t            # ``mismatch`` (BLOCK), NOT an INFRA advisory — a hostile\n510\t            # override must not degrade the rail by pointing at a vanished\n511\t            # path. The launcher indirection is skipped: the override IS\n512\t            # the payload we hash and compare.\n513\t            payload: Optional[Path] = Path(payload_override)\n514\t            try:\n515\t                is_regular = payload.is_file()\n516\t            except OSError:\n517\t                is_regular = False\n518\t            if not is_regular:\n519\t                result[\"status\"] = \"mismatch\"\n520\t                result[\"detail\"] = \"override_payload_missing\"\n521\t                return result\n522\t        else:\n523\t            payload = _resolve_codex_payload(launcher_path, rel_path, triple)\n524\t            if payload is None:\n525\t                # The launcher itself would throw \"Missing optional\n526\t                # dependency\" here — codex cannot run at all → INFRA.\n527\t                result[\"detail\"] = \"payload_not_resolved\"\n528\t                return result\n529\t        result[\"path\"] = str(payload)\n530\t\n531\t        actual = _sha256_file(payload)\n532\t        if actual is None:\n533\t            result[\"detail\"] = \"payload_unreadable\"\n534\t            return result\n535\t        result[\"sha256\"] = actual\n536\t\n537\t        if actual != expected:\n538\t            if _apply_currency_policy(payload, launcher_path, manifest, result):\n539\t                return result\n540\t            result[\"status\"] = \"mismatch\"\n541\t            result[\"detail\"] = \"payload_sha256_mismatch\"\n542\t            return result\n543\t\n544\t        result[\"status\"] = \"verified\"\n545\t        result[\"detail\"] = \"ok\"\n546\t        return result\n547\t    except Exception as e:  # defensive: kernel never raises\n548\t        result[\"status\"] = \"infra\"\n549\t        result[\"detail\"] = f\"unexpected:{type(e).__name__}\"\n550\t        return result\n551\t\n552\t\n553\tdef _apply_currency_policy(\n554\t    payload: Path, launcher: Optional[Path], manifest: Dict[str, Any], result: Dict[str, Any],\n555\t) -> bool:\n556\t    \"\"\"Record qualified version and apply only the explicitly allowed currency arm.\"\"\"\n557\t    installed = _cli_currency.qualified_package_version(payload, launcher)\n558\t    result[\"installed_version\"] = installed or \"\"\n559\t    if installed is None:\n560\t        return False\n561\t    manifest_version = manifest.get(\"package_version\")\n562\t    if _cli_currency.parse_semver(manifest_version) is None:\n563\t        result[\"status\"] = \"mismatch\"\n564\t        result[\"detail\"] = \"manifest_package_version_malformed\"\n565\t        return True\n566\t    if _cli_currency.compatible_package_version(payload, launcher, manifest_version):\n567\t        result[\"status\"] = \"compatible\"\n568\t        result[\"detail\"] = \"version_floor_only\"\n569\t        result[\"path\"] = str(payload)\n570\t        return True\n571\t    return False\n572\t\n573\t\n574\tdef _resolve_codex_bin() -> Optional[str]:\n575\t    \"\"\"Return verified or floor-compatible native payload; infra is None.\"\"\"\n576\t    override = os.environ.get(\"CEO_PAIR_RAIL_CODEX_BIN\")\n577\t    res = (\n578\t        verify_codex_payload(payload_override=override)\n579\t        if override\n580\t        else verify_codex_payload()\n581\t    )\n582\t    status = res.get(\"status\")\n583\t    if status in (\"verified\", \"compatible\"):\n584\t        return str(res.get(\"path\") or \"\") or None\n585\t    if status == \"infra\":\n586\t        return None\n587\t    raise CodexPinMismatch(\n588\t        f\"{status}:{res.get('detail')} triple={res.get('target_triple') or '?'} \"\n589\t        f\"payload_sha={str(res.get('sha256'))[:16] or '?'} \"\n590\t        f\"pin_sha={str(res.get('expected_sha256'))[:16] or '?'} \"\n591\t        f\"manifest={res.get('manifest')}\"\n592\t    )\n593\t\n594\tdef _build_codex_prompt(\n595\t    tool_name: str, file_path: str, proposed_content: str\n596\t) -> str:\n597\t    \"\"\"Build the read-only review prompt sent to Codex.\n598\t\n599\t    Production contract: prompt asks Codex to review for governance issues\n600\t    + return REVIEW-ONLY. ANY `*** Update File:` / unified diff /\n601\t    JSON-Patch in the response → automatic violation (regardless of\n602\t    intent — the hook contract is purely structural).\n603\t    \"\"\"\n604\t    # Truncate proposed_content for prompt size sanity. Phase 1 will\n605\t    # use chunked streaming; spike caps at 32 KiB.\n606\t    capped = proposed_content[:32 * 1024] if proposed_content else \"\"\n607\t    return (\n608\t        f\"PAIR-RAIL READ-ONLY REVIEW (PLAN-075 Phase 0A spike)\\n\\n\"\n609\t        f\"Tool: {tool_name}\\n\"\n610\t        f\"Target path: {file_path}\\n\\n\"\n611\t        \"You are a READ-ONLY reviewer. Do NOT emit any patch, diff, \"\n612\t        \"apply_patch envelope, or JSON-Patch op.\\n\"\n613\t        \"If you would change the file, describe the change in PROSE \"\n614\t        \"ONLY (no code-fenced patches, no `*** Update File:` lines, \"\n615\t        \"no `--- a/...` / `+++ b/...` markers).\\n\\n\"\n616\t        f\"Proposed content (truncated to 32 KiB):\\n```\\n{capped}\\n```\"\n617\t    )\n618\t\n619\t__all__ = (\n620\t    '_PRODUCTION_PROMOTED_BY_PLAN_091',\n621\t    '_L3_PLUS_GLOB_PATTERNS',\n622\t    '_fnmatch_segments',\n623\t    '_is_l3_plus_path',\n624\t    '_CODEX_PATCH_RE',\n625\t    '_CODEX_MOVE_RE',\n626\t    '_UNIFIED_DIFF_RE',\n627\t    '_JSON_PATCH_PATH_RE',\n628\t    '_MAX_RESPONSE_BYTES',\n629\t    '_MAX_RESPONSE_LINES',\n630\t    '_MAX_OUTPUT_FILE_BYTES',\n631\t    '_detect_write_shaped_patch',\n632\t    'CodexUnavailable',\n633\t    'CodexTimeout',\n634\t    'CodexMalformed',\n635\t    'CodexPinMismatch',\n636\t    '_PIN_MANIFEST_REL',\n637\t    '_SHA256_HEX_RE',\n638\t    '_codex_target_triple',\n639\t    '_pin_manifest_path',\n640\t    'CodexPinManifestMalformed',\n641\t    '_load_pin_manifest',\n642\t    '_sha256_file',\n643\t    '_resolve_codex_payload',\n644\t    '_apply_currency_policy',\n645\t    'verify_codex_payload',\n646\t    '_resolve_codex_bin',\n647\t    '_build_codex_prompt',\n648\t)\n649\t"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"9614983f-d530-46e7-aae8-b14a53cbcccb","timestamp":"2026-11-13T18:10:43.236Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_01.py","content":"from __future__ import annotations\nfrom ._shared import *\nfrom _lib import cli_currency as _cli_currency\n\n_PRODUCTION_PROMOTED_BY_PLAN_091: bool = True\n\n_L3_PLUS_GLOB_PATTERNS: Tuple[str, ...] = (\n    \".claude/hooks/_lib/*.py\",\n    \".claude/hooks/_lib/**/*.py\",\n    \".claude/hooks/check_*.py\",\n    \".claude/hooks/audit_*.py\",\n    \".claude/scripts/local/*\",\n    \".claude/policies/*.yaml\",\n    \".claude/policies/*.yml\",\n    \"SPEC/v1/*.md\",\n    \".github/workflows/*.yml\",\n    \".github/workflows/*.yaml\",\n    \"PROTOCOL.md\",\n)\n\ndef _fnmatch_segments(path: str, pattern: str) -> bool:\n    \"\"\"Segment-wise glob matcher with `*` (one segment) and `**` (zero+).\n\n    Stripped-down port of `check_canonical_edit._fnmatch_segments`.\n    \"\"\"\n    import fnmatch as _fn\n\n    p_parts = path.split(\"/\")\n    pat_parts = pattern.split(\"/\")\n\n    def _match(p: List[str], pat: List[str]) -> bool:\n        if not pat:\n            return not p\n        head, rest = pat[0], pat[1:]\n        if head == \"**\":\n            for i in range(len(p) + 1):\n                if _match(p[i:], rest):\n                    return True\n            return False\n        if not p:\n            return False\n        if head == \"*\" or _fn.fnmatchcase(p[0], head):\n            return _match(p[1:], rest)\n        return False\n\n    return _match(p_parts, pat_parts)\n\ndef _is_l3_plus_path(path_str: str, repo_root: Path) -> bool:\n    \"\"\"True if path classifies as L3+ per the production heuristic.\"\"\"\n    if not path_str:\n        return False\n    p = Path(path_str)\n    try:\n        rel_path = (\n            p.resolve().relative_to(repo_root.resolve())\n            if p.is_absolute()\n            else Path(path_str)\n        )\n    except (ValueError, OSError):\n        # Path outside repo or non-resolvable — not L3+.\n        return False\n    rel_str = str(rel_path).replace(os.sep, \"/\")\n    for pattern in _L3_PLUS_GLOB_PATTERNS:\n        if _fnmatch_segments(rel_str, pattern):\n            return True\n    return False\n\n_CODEX_PATCH_RE = re.compile(\n    r\"^\\*\\*\\*\\s+(Update|Add|Delete|Move|Rename)\\s+File:?\\s+(.+?)\\s*$\",\n    re.MULTILINE,\n)\n\n_CODEX_MOVE_RE = re.compile(\n    r\"^\\*\\*\\*\\s+(?:Move|Rename)\\s+to:?\\s+(.+?)\\s*$\",\n    re.MULTILINE,\n)\n\n_UNIFIED_DIFF_RE = re.compile(\n    r\"^(?:---|\\+\\+\\+)\\s+(?:[ab]/)?(.+?)\\s*$\", re.MULTILINE,\n)\n\n_JSON_PATCH_PATH_RE = re.compile(\n    r'\"path\"\\s*:\\s*\"(/[^\"\\\\]*(?:\\\\.[^\"\\\\]*)*)\"'\n)\n\n_MAX_RESPONSE_BYTES = 4 * 1024 * 1024  # 4 MiB\n\n_MAX_RESPONSE_LINES = 200_000\n\n_MAX_OUTPUT_FILE_BYTES: int = 1 * 1024 * 1024  # 1 MiB\n\ndef _detect_write_shaped_patch(response_text: str) -> Optional[str]:\n    \"\"\"Detect any write-shaped patch in a Codex review response.\n\n    Returns the matched grammar tag (`codex_apply_patch`, `unified_diff`,\n    `codex_move`, `json_patch`) on first detection, or None if response\n    is clean. Order is: Codex envelope → unified diff → JSON patch.\n\n    Defense:\n    - Length cap (4 MiB) — pathological responses skipped (treated as\n      clean by production heuristic; future revision should fail-CLOSED).\n    - Line cap (200k) — bound regex iteration.\n    - All regexes anchored with `^...$` (multiline) — no nested\n      quantifiers susceptible to ReDoS.\n    \"\"\"\n    if not isinstance(response_text, str) or not response_text:\n        return None\n    if len(response_text) > _MAX_RESPONSE_BYTES:\n        # Spike: treat oversize as clean (advisory). Production note:\n        # ADR-110 PROPOSED Phase 1 should fail-CLOSED here.\n        return None\n    # Cap line count via early exit on findall-like inspection.\n    line_count = response_text.count(\"\\n\")\n    if line_count > _MAX_RESPONSE_LINES:\n        return None\n\n    # Grammar 1a: Codex apply_patch envelope.\n    if _CODEX_PATCH_RE.search(response_text) is not None:\n        return \"codex_apply_patch\"\n\n    # Grammar 1b: Codex move directive.\n    if _CODEX_MOVE_RE.search(response_text) is not None:\n        return \"codex_move\"\n\n    # Grammar 2: Unified diff. Filter false positives from prose by\n    # requiring the second-half marker to also exist (`---` AND `+++`).\n    has_minus = re.search(r\"^---\\s+\", response_text, re.MULTILINE) is not None\n    has_plus = re.search(r\"^\\+\\+\\+\\s+\", response_text, re.MULTILINE) is not None\n    if has_minus and has_plus:\n        return \"unified_diff\"\n\n    # Grammar 3: JSON Patch (RFC 6902). Two-pass:\n    # (a) JSON-shape body — try strict json.loads.\n    stripped = response_text.lstrip()\n    if stripped.startswith((\"[\", \"{\")):\n        try:\n            parsed = json.loads(response_text)\n        except (ValueError, TypeError):\n            parsed = None\n        if isinstance(parsed, list):\n            for op in parsed:\n                if (\n                    isinstance(op, dict)\n                    and isinstance(op.get(\"op\"), str)\n                    and isinstance(op.get(\"path\"), str)\n                    and op[\"path\"].startswith(\"/\")\n                    and op[\"op\"] in {\"add\", \"remove\", \"replace\", \"move\", \"copy\"}\n                ):\n                    return \"json_patch\"\n        elif isinstance(parsed, dict):\n            # Single op object (uncommon but valid).\n            if (\n                isinstance(parsed.get(\"op\"), str)\n                and isinstance(parsed.get(\"path\"), str)\n                and parsed[\"path\"].startswith(\"/\")\n                and parsed[\"op\"] in {\"add\", \"remove\", \"replace\", \"move\", \"copy\"}\n            ):\n                return \"json_patch\"\n    # (b) Legacy regex fallback for embedded JSON-Patch fragments in\n    # mixed prose.\n    if (\n        '\"op\"' in response_text\n        and '\"path\"' in response_text\n        and _JSON_PATCH_PATH_RE.search(response_text) is not None\n    ):\n        return \"json_patch\"\n\n    return None\n\nclass CodexUnavailable(Exception):\n    \"\"\"Raised when Codex binary is missing or invoke fails non-recoverably.\"\"\"\n\nclass CodexTimeout(Exception):\n    \"\"\"Raised when Codex exceeds the wall-clock cap (CEO_PAIR_RAIL_TIMEOUT_S).\"\"\"\n\nclass CodexMalformed(Exception):\n    \"\"\"Raised when Codex stdout cannot be parsed as a valid review envelope.\"\"\"\n\nclass CodexPinMismatch(Exception):\n    \"\"\"ADR-182 fail-CLOSED: payload-pin verification failed on a SECURITY\n    input (targetTriple absent from the manifest, malformed manifest\n    entry, or SHA-256 mismatch between the resolved native payload and\n    its pinned entry). The consumer (`_decide`) maps this to\n    `{decision: block}` — the unverified binary is never invoked and the\n    L3+ write does not proceed under a silently-degraded rail.\"\"\"\n\n_PIN_MANIFEST_REL: Tuple[str, ...] = (\n    \".claude\", \"governance\", \"codex-cli-pin-manifest.json\",\n)\n\n_SHA256_HEX_RE = re.compile(r\"^[0-9a-f]{64}$\")\n\ndef _codex_target_triple() -> Optional[str]:\n    \"\"\"Derive the launcher's targetTriple for this host, or None.\n\n    Mirrors `bin/codex.js` (`process.platform`/`process.arch` mapping,\n    transcribed in PLAN-163 `probes/payload-sha-evidence.md`). Windows\n    payloads carry a `.exe` suffix handled in `_resolve_codex_payload`.\n\n    H1 fail-CLOSED test seam: `CEO_PAIR_RAIL_TARGET_TRIPLE` overrides the\n    derivation ONLY under the explicit `CEO_PAIR_RAIL_TEST_MODE=1` marker.\n    On the LIVE path (no marker) the override is IGNORED and the triple is\n    derived from the real host, so no CODEX-specific seam can point\n    verification at a foreign per-triple manifest entry. The\n    derived-or-overridden triple is still VERIFIED downstream — this seam\n    never relaxes the sha comparison. (Scope, PLAN-163 DIM1: this \"no env\"\n    claim covers CODEX-specific seams only; the manifest BASE follows the\n    framework-wide `CLAUDE_PROJECT_DIR` anchor — see `_pin_manifest_path`.)\n    \"\"\"\n    if os.environ.get(\"CEO_PAIR_RAIL_TEST_MODE\") == \"1\":\n        override = os.environ.get(\"CEO_PAIR_RAIL_TARGET_TRIPLE\")\n        if override:\n            return override\n    try:\n        import platform as _platform\n        sysname = _platform.system()\n        machine = _platform.machine().lower()\n    except Exception:\n        return None\n    arm = machine in (\"arm64\", \"aarch64\")\n    x64 = machine in (\"x86_64\", \"amd64\")\n    if sysname == \"Darwin\":\n        if arm:\n            return \"aarch64-apple-darwin\"\n        if x64:\n            return \"x86_64-apple-darwin\"\n    elif sysname == \"Linux\":\n        if x64:\n            return \"x86_64-unknown-linux-musl\"\n        if arm:\n            return \"aarch64-unknown-linux-musl\"\n    elif sysname == \"Windows\":\n        if x64:\n            return \"x86_64-pc-windows-msvc\"\n        if arm:\n            return \"aarch64-pc-windows-msvc\"\n    return None\n\ndef _pin_manifest_path() -> Path:\n    \"\"\"Resolve the ADR-182 manifest path (test seam → repo default).\n\n    H1 fail-CLOSED: the `CEO_PAIR_RAIL_PIN_MANIFEST` override is a TEST\n    seam honoured ONLY under `CEO_PAIR_RAIL_TEST_MODE=1`. On the LIVE path\n    the override is IGNORED and the manifest base resolves under the\n    framework-wide `CLAUDE_PROJECT_DIR` anchor. The seam never relaxes the\n    sha comparison — a test manifest is still matched byte-for-byte against\n    the resolved payload.\n\n    Scope (PLAN-163 DIM1): the guarantee \"no env redirects verification at\n    an attacker-supplied manifest\" is scoped to CODEX-SPECIFIC seams. The\n    base still follows `CLAUDE_PROJECT_DIR` — the framework-wide anchor\n    every hook already trusts — so an attacker who can repoint that anchor\n    has already compromised the entire tree, which is OUTSIDE this pin's\n    threat model. The pin defends T-8 (a payload swap under an\n    otherwise-intact environment), not a hostile framework anchor.\n    \"\"\"\n    if os.environ.get(\"CEO_PAIR_RAIL_TEST_MODE\") == \"1\":\n        override = os.environ.get(\"CEO_PAIR_RAIL_PIN_MANIFEST\")\n        if override:\n            return Path(override)\n    repo_root = Path(os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd())\n    return repo_root.joinpath(*_PIN_MANIFEST_REL)\n\nclass CodexPinManifestMalformed(Exception):\n    \"\"\"Fail-CLOSED signal (PLAN-163 C2 fix): the pin manifest is PRESENT\n    but not parseable as a valid manifest — a broken-JSON body, non-utf8\n    bytes, a top-level that is not an object / carries ``schema != 1``, or\n    a ``payloads`` value that is not an object. Per the PLAN-152 debate-C4\n    fail-CLOSED-on-input doctrine, content a security matcher cannot parse\n    is BLOCKED, never waved through as an INFRA advisory. Distinct from a\n    genuinely ABSENT / unreadable manifest (OSError — content not present),\n    which stays INFRA -> fail-open. ``verify_codex_payload`` catches this\n    and maps it to ``status='mismatch'`` (-> ``CodexPinMismatch`` -> BLOCK).\n    \"\"\"\n\ndef _load_pin_manifest(path: Path) -> Optional[Dict[str, Any]]:\n    \"\"\"Parse the pin manifest, separating the two failure CLASSES the\n    fail-CLOSED-on-input doctrine (PLAN-152 debate C4) requires:\n\n    * Manifest ABSENT / unreadable — the content is NOT present. Any\n      ``OSError`` from the read (``FileNotFoundError``, ``PermissionError``,\n      ``IsADirectoryError``, ...) -> return ``None`` -> the caller\n      classifies it INFRA -> fail-OPEN advisory (same doctrine as a missing\n      binary).\n    * Manifest PRESENT but NOT parseable as a valid manifest — a\n      ``json.JSONDecodeError`` (subclass of ``ValueError``), non-utf8 bytes\n      (``UnicodeDecodeError`` — also a ``ValueError``), a top-level that is\n      not an object / has ``schema != 1``, or a non-object ``payloads`` ->\n      raise ``CodexPinManifestMalformed`` -> the caller fail-CLOSES to\n      ``status='mismatch'`` (BLOCK). A swapped / corrupt manifest must not\n      silently degrade the rail to advisory (that silent degrade is the\n      exact 0.144.1->0.144.6 no-gate-trip failure ADR-182 closes).\n\n    The two classes are NEVER conflated: an ``OSError`` is not a parse\n    failure, and a parse failure is not an ``OSError``.\n    \"\"\"\n    try:\n        raw = path.read_text(encoding=\"utf-8\")\n    except OSError:\n        # Content NOT present / unreadable -> INFRA -> advisory.\n        return None\n    except ValueError as e:\n        # UnicodeDecodeError IS-A ValueError: the bytes ARE present but are\n        # not decodable as utf-8 -> content-present-not-parseable ->\n        # fail-CLOSED.\n        raise CodexPinManifestMalformed(\n            \"pin manifest not utf-8: \" + type(e).__name__\n        )\n    try:\n        data = json.loads(raw)\n    except Exception as e:\n        # C2 (codex R4): the bytes ARE present (read_text OSError is handled\n        # above as INFRA). ANY failure parsing present bytes — json.JSONDecodeError\n        # (IS-A ValueError), or a non-ValueError parser failure such as\n        # RecursionError on a deeply-nested payload — is present-but-unparseable\n        # security-matcher input -> fail-CLOSED (CLAUDE.md §4). A narrow\n        # `except ValueError` let RecursionError escape to the caller's broad\n        # infra/advisory catch-all; catch-all here keeps the block.\n        raise CodexPinManifestMalformed(\n            \"pin manifest unparseable: \" + type(e).__name__\n        )\n    if not isinstance(data, dict) or data.get(\"schema\") != 1:\n        raise CodexPinManifestMalformed(\n            \"pin manifest top-level invalid (not an object or schema != 1)\"\n        )\n    if not isinstance(data.get(\"payloads\"), dict):\n        raise CodexPinManifestMalformed(\n            \"pin manifest 'payloads' is not an object\"\n        )\n    return data\n\ndef _sha256_file(path: Path) -> Optional[str]:\n    \"\"\"SHA-256 hex of a file (chunked; payload is ~260 MB). None on IO error.\"\"\"\n    import hashlib\n    try:\n        h = hashlib.sha256()\n        with open(path, \"rb\") as f:\n            for chunk in iter(lambda: f.read(1024 * 1024), b\"\"):\n                h.update(chunk)\n        return h.hexdigest()\n    except Exception:\n        return None\n\ndef _resolve_codex_payload(\n    launcher: Path, manifest_rel_path: str, triple: str\n) -> Optional[Path]:\n    \"\"\"Mirror the launcher's `findCodexExecutable()` payload resolution.\n\n    `launcher` is the `codex` entry found on $PATH (an npm symlink).\n    Candidates, in launcher order:\n      1. `require.resolve(\"@openai/codex-<platform>/package.json\")` —\n         node walks `node_modules/` up from the launcher package dir;\n         we walk the same ancestors joining `node_modules/<manifest\n         entry path>` (the manifest `path` field IS the\n         package-relative payload path, e.g.\n         `@openai/codex-darwin-arm64/vendor/<triple>/bin/codex`).\n      2. Launcher fallback `__dirname/../vendor/<triple>/bin/codex`\n         (i.e. `<pkg_dir>/vendor/...`).\n    Returns the first existing regular file, else None (INFRA).\n    \"\"\"\n    try:\n        real = launcher.resolve()\n    except (OSError, RuntimeError):\n        return None\n    pkg_dir = real.parent.parent  # <pkg>/bin/codex.js → <pkg>\n    rel_parts = [p for p in manifest_rel_path.split(\"/\") if p]\n    if not rel_parts:\n        return None\n    exe_suffix = \".exe\" if os.name == \"nt\" else \"\"\n    candidates: List[Path] = []\n    for anc in [pkg_dir] + list(pkg_dir.parents):\n        candidates.append(anc.joinpath(\"node_modules\", *rel_parts))\n    candidates.append(pkg_dir / \"vendor\" / triple / \"bin\" / \"codex\")\n    for cand in candidates:\n        if exe_suffix and cand.suffix != exe_suffix:\n            cand = cand.with_name(cand.name + exe_suffix)\n        try:\n            if cand.is_file():\n                return cand\n        except OSError:\n            continue\n    return None\n\n# QDSAA-FUNCAO-LONGA: preserva numa transação a classificação fail-open/fail-closed do pin, detalhes forenses e contrato CLI.\ndef verify_codex_payload(\n    launcher: Optional[str] = None,\n    *,\n    payload_override: Optional[str] = None,\n) -> Dict[str, Any]:\n    \"\"\"ADR-182 verification kernel — shared by this hook's runtime\n    verify-then-invoke path, `pair-rail-gate.sh` Gate 4 (via the\n    `--verify-codex-pin` CLI below), and tests. NEVER raises.\n\n    Two ingress shapes, ONE verification (H1 fail-CLOSED single code\n    path — no env is a sha-check bypass):\n\n      * ``payload_override`` set (the `CEO_PAIR_RAIL_CODEX_BIN` seam) —\n        the override IS the native payload. Its sha256 is hashed\n        DIRECTLY and compared against the manifest entry for the current\n        triple. A set-but-missing / non-regular override is a fail-CLOSED\n        ``mismatch`` (\"inexistente = BLOQUEIA\"), never a silent advisory\n        degrade: a hostile override must not be able to relax the rail by\n        pointing at a vanished path.\n      * ``launcher`` given / discovered on $PATH — mirror the launcher's\n        `findCodexExecutable()` to resolve the native payload, then hash\n        + compare it.\n\n    In BOTH shapes the resolved payload's sha256 is compared against the\n    per-triple pin-manifest entry. No env relaxes this comparison.\n\n    Returns a dict:\n      status        — \"verified\" | \"mismatch\" | \"triple_missing\" | \"infra\"\n      detail        — machine-readable slug for the specific arm\n      path          — resolved native payload path (\"\" until resolved)\n      sha256        — computed payload sha256 (\"\" until computed)\n      expected_sha256 — manifest entry sha256 (\"\" if no entry)\n      target_triple — derived/overridden triple (\"\" if underivable)\n      manifest      — manifest path consulted\n\n    Classification contract (docstring §ADR-182): \"infra\" arms are\n    fail-OPEN at the consumer; \"mismatch\"/\"triple_missing\" arms are\n    fail-CLOSED (`CodexPinMismatch`). An underivable host triple is\n    classified `triple_missing` — a host we cannot map cannot be\n    verified, and unverifiable must not silently degrade to advisory.\n    \"\"\"\n    manifest_path = _pin_manifest_path()\n    result: Dict[str, Any] = {\n        \"status\": \"infra\",\n        \"detail\": \"\",\n        \"path\": \"\",\n        \"sha256\": \"\",\n        \"expected_sha256\": \"\",\n        \"installed_version\": \"\",\n        \"target_triple\": \"\",\n        \"manifest\": str(manifest_path),\n    }\n    try:\n        # Ingress-shape resolution of the LAUNCHER (needed only when no\n        # direct payload override was supplied). The override path does\n        # NOT resolve via a launcher — it is hashed directly below.\n        launcher_path: Optional[Path] = None\n        if payload_override is None:\n            launcher_path = Path(launcher) if launcher else None\n            if launcher_path is None:\n                for entry_dir in os.environ.get(\"PATH\", \"\").split(os.pathsep):\n                    candidate = Path(entry_dir) / \"codex\"\n                    if candidate.exists() and os.access(candidate, os.X_OK):\n                        launcher_path = candidate\n                        break\n            if launcher_path is None or not launcher_path.exists():\n                result[\"detail\"] = \"launcher_not_found\"\n                return result\n\n        triple = _codex_target_triple()\n        if triple is None:\n            result[\"status\"] = \"triple_missing\"\n            result[\"detail\"] = \"target_triple_underivable\"\n            return result\n        result[\"target_triple\"] = triple\n\n        try:\n            manifest = _load_pin_manifest(manifest_path)\n        except CodexPinManifestMalformed:\n            # PRESENT-but-unparseable manifest = INPUT-parse failure of a\n            # security matcher -> fail-CLOSED (PLAN-152 debate C4). A\n            # corrupt/swapped manifest must not silently degrade the rail\n            # to advisory. status='mismatch' -> CodexPinMismatch -> BLOCK.\n            result[\"status\"] = \"mismatch\"\n            result[\"detail\"] = \"manifest_malformed\"\n            return result\n        if manifest is None:\n            # ABSENT / unreadable (OSError) -> INFRA -> fail-OPEN advisory,\n            # same doctrine as a missing binary.\n            result[\"detail\"] = \"manifest_unreadable\"\n            return result\n\n        entry = manifest[\"payloads\"].get(triple)\n        if entry is None:\n            currency_path = Path(payload_override) if payload_override else launcher_path\n            if currency_path and _apply_currency_policy(\n                currency_path, launcher_path, manifest, result\n            ):\n                return result\n            result[\"status\"] = \"triple_missing\"\n            result[\"detail\"] = \"triple_absent_from_manifest\"\n            return result\n        if not isinstance(entry, dict):\n            result[\"status\"] = \"mismatch\"\n            result[\"detail\"] = \"manifest_entry_malformed\"\n            return result\n        expected = entry.get(\"sha256\")\n        rel_path = entry.get(\"path\")\n        if (\n            not isinstance(expected, str)\n            or _SHA256_HEX_RE.match(expected) is None\n            or not isinstance(rel_path, str)\n            or not rel_path\n        ):\n            # Malformed SECURITY input inside the matcher → fail-CLOSED\n            # (PLAN-152 debate C4 doctrine), never waved through.\n            result[\"status\"] = \"mismatch\"\n            result[\"detail\"] = \"manifest_entry_malformed\"\n            return result\n        result[\"expected_sha256\"] = expected\n\n        if payload_override is not None:\n            # H1: the override is VERIFIED, never trusted un-hashed. A\n            # set-but-absent / non-regular override is a fail-CLOSED\n            # ``mismatch`` (BLOCK), NOT an INFRA advisory — a hostile\n            # override must not degrade the rail by pointing at a vanished\n            # path. The launcher indirection is skipped: the override IS\n            # the payload we hash and compare.\n            payload: Optional[Path] = Path(payload_override)\n            try:\n                is_regular = payload.is_file()\n            except OSError:\n                is_regular = False\n            if not is_regular:\n                result[\"status\"] = \"mismatch\"\n                result[\"detail\"] = \"override_payload_missing\"\n                return result\n        else:\n            payload = _resolve_codex_payload(launcher_path, rel_path, triple)\n            if payload is None:\n                # The launcher itself would throw \"Missing optional\n                # dependency\" here — codex cannot run at all → INFRA.\n                result[\"detail\"] = \"payload_not_resolved\"\n                return result\n        result[\"path\"] = str(payload)\n\n        actual = _sha256_file(payload)\n        if actual is None:\n            result[\"detail\"] = \"payload_unreadable\"\n            return result\n        result[\"sha256\"] = actual\n\n        if actual != expected:\n            if _apply_currency_policy(payload, launcher_path, manifest, result):\n                return result\n            result[\"status\"] = \"mismatch\"\n            result[\"detail\"] = \"payload_sha256_mismatch\"\n            return result\n\n        result[\"status\"] = \"verified\"\n        result[\"detail\"] = \"ok\"\n        return result\n    except Exception as e:  # defensive: kernel never raises\n        result[\"status\"] = \"infra\"\n        result[\"detail\"] = f\"unexpected:{type(e).__name__}\"\n        return result\n\n\ndef _apply_currency_policy(\n    payload: Path, launcher: Optional[Path], manifest: Dict[str, Any], result: Dict[str, Any],\n) -> bool:\n    \"\"\"Record qualified version and apply only the explicitly allowed currency arm.\"\"\"\n    installed = _cli_currency.qualified_package_version(payload, launcher)\n    result[\"installed_version\"] = installed or \"\"\n    if installed is None:\n        return False\n    manifest_version = manifest.get(\"package_version\")\n    if _cli_currency.parse_semver(manifest_version) is None:\n        result[\"status\"] = \"mismatch\"\n        result[\"detail\"] = \"manifest_package_version_malformed\"\n        return True\n    if _cli_currency.compatible_package_version(payload, launcher, manifest_version):\n        result[\"status\"] = \"compatible\"\n        result[\"detail\"] = \"version_floor_only\"\n        result[\"path\"] = str(payload)\n        return True\n    return False\n\n\ndef _resolve_codex_bin() -> Optional[str]:\n    \"\"\"Return verified or floor-compatible native payload; infra is None.\"\"\"\n    override = os.environ.get(\"CEO_PAIR_RAIL_CODEX_BIN\")\n    res = (\n        verify_codex_payload(payload_override=override)\n        if override\n        else verify_codex_payload()\n    )\n    status = res.get(\"status\")\n    if status in (\"verified\", \"compatible\"):\n        return str(res.get(\"path\") or \"\") or None\n    if status == \"infra\":\n        return None\n    raise CodexPinMismatch(\n        f\"{status}:{res.get('detail')} triple={res.get('target_triple') or '?'} \"\n        f\"payload_sha={str(res.get('sha256'))[:16] or '?'} \"\n        f\"pin_sha={str(res.get('expected_sha256'))[:16] or '?'} \"\n        f\"manifest={res.get('manifest')}\"\n    )\n\ndef _build_codex_prompt(\n    tool_name: str, file_path: str, proposed_content: str\n) -> str:\n    \"\"\"Build the read-only review prompt sent to Codex.\n\n    Production contract: prompt asks Codex to review for governance issues\n    + return REVIEW-ONLY. ANY `*** Update File:` / unified diff /\n    JSON-Patch in the response → automatic violation (regardless of\n    intent — the hook contract is purely structural).\n    \"\"\"\n    # Truncate proposed_content for prompt size sanity. Phase 1 will\n    # use chunked streaming; spike caps at 32 KiB.\n    capped = proposed_content[:32 * 1024] if proposed_content else \"\"\n    return (\n        f\"PAIR-RAIL READ-ONLY REVIEW (PLAN-075 Phase 0A spike)\\n\\n\"\n        f\"Tool: {tool_name}\\n\"\n        f\"Target path: {file_path}\\n\\n\"\n        \"You are a READ-ONLY reviewer. Do NOT emit any patch, diff, \"\n        \"apply_patch envelope, or JSON-Patch op.\\n\"\n        \"If you would change the file, describe the change in PROSE \"\n        \"ONLY (no code-fenced patches, no `*** Update File:` lines, \"\n        \"no `--- a/...` / `+++ b/...` markers).\\n\\n\"\n        f\"Proposed content (truncated to 32 KiB):\\n```\\n{capped}\\n```\"\n    )\n\n__all__ = (\n    '_PRODUCTION_PROMOTED_BY_PLAN_091',\n    '_L3_PLUS_GLOB_PATTERNS',\n    '_fnmatch_segments',\n    '_is_l3_plus_path',\n    '_CODEX_PATCH_RE',\n    '_CODEX_MOVE_RE',\n    '_UNIFIED_DIFF_RE',\n    '_JSON_PATCH_PATH_RE',\n    '_MAX_RESPONSE_BYTES',\n    '_MAX_RESPONSE_LINES',\n    '_MAX_OUTPUT_FILE_BYTES',\n    '_detect_write_shaped_patch',\n    'CodexUnavailable',\n    'CodexTimeout',\n    'CodexMalformed',\n    'CodexPinMismatch',\n    '_PIN_MANIFEST_REL',\n    '_SHA256_HEX_RE',\n    '_codex_target_triple',\n    '_pin_manifest_path',\n    'CodexPinManifestMalformed',\n    '_load_pin_manifest',\n    '_sha256_file',\n    '_resolve_codex_payload',\n    '_apply_currency_policy',\n    'verify_codex_payload',\n    '_resolve_codex_bin',\n    '_build_codex_prompt',\n)\n","numLines":649,"startLine":1,"totalLines":649}},"tool_result_meta":[{"id":"toolu_017XnKJJc4NE7pLesRhcYcz4","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
