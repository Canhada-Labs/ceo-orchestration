c:\n        sys.stderr.write(\n            \"# check_precompact_continuity fail-open: %s\\n\" % str(exc)[:120]\n        )\n        print(\"{}\")\n","numLines":127,"startLine":1,"totalLines":127}},"tool_result_meta":[{"id":"toolu_01GNR7YqKfSeRLQWKpdLdgMk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
