{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UBabQNBzVGEaSwfKHFwPFN","type":"tool_result","content":"1\t\"\"\"Shared PLAN filename and path matching for lifecycle consumers.\n2\t\n3\tThe filename grammar is the authoritative PLAN-SCHEMA.md §1.4 pattern.\n4\tPaths are normalized before matching so hooks receive the same result from\n5\trelative, absolute, POSIX, and Windows-style tool payloads.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport re\n11\t\n12\t\n13\tPLAN_FILENAME_RE = re.compile(\n14\t    r\"^PLAN-[0-9]{3}(-FOLLOWUP)?-[a-z0-9]+(-[a-z0-9]+)*\\.md$\"\n15\t)\n16\t\n17\tdef is_plan_path(file_path: str) -> bool:\n18\t    \"\"\"Return whether ``file_path`` names a schema-valid plan file.\"\"\"\n19\t    if not file_path:\n20\t        return False\n21\t    parent, _, filename = str(file_path).replace(\"\\\\\", \"/\").rpartition(\"/\")\n22\t    in_plans = parent == \".claude/plans\" or parent.endswith(\"/.claude/plans\")\n23\t    return in_plans and PLAN_FILENAME_RE.fullmatch(filename) is not None\n24\t\n25\t\n26\tdef plan_id_from_path(file_path: str) -> str:\n27\t    \"\"\"Return ``PLAN-NNN`` from a schema-valid path, otherwise ``\"\"``.\"\"\"\n28\t    if not file_path:\n29\t        return \"\"\n30\t    normalized = str(file_path).replace(\"\\\\\", \"/\")\n31\t    filename = normalized.rsplit(\"/\", 1)[-1]\n32\t    if not PLAN_FILENAME_RE.fullmatch(filename):\n33\t        return \"\"\n34\t    return filename[:8]\n35\t\n36\t\n37\t__all__ = [\"PLAN_FILENAME_RE\", \"is_plan_path\", \"plan_id_from_path\"]\n38\t"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"e22a26a2-f6f2-466e-b39e-d56db87975a3","timestamp":"2026-11-13T18:12:02.949Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/plan_paths.py","content":"\"\"\"Shared PLAN filename and path matching for lifecycle consumers.\n\nThe filename grammar is the authoritative PLAN-SCHEMA.md §1.4 pattern.\nPaths are normalized before matching so hooks receive the same result from\nrelative, absolute, POSIX, and Windows-style tool payloads.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport re\n\n\nPLAN_FILENAME_RE = re.compile(\n    r\"^PLAN-[0-9]{3}(-FOLLOWUP)?-[a-z0-9]+(-[a-z0-9]+)*\\.md$\"\n)\n\ndef is_plan_path(file_path: str) -> bool:\n    \"\"\"Return whether ``file_path`` names a schema-valid plan file.\"\"\"\n    if not file_path:\n        return False\n    parent, _, filename = str(file_path).replace(\"\\\\\", \"/\").rpartition(\"/\")\n    in_plans = parent == \".claude/plans\" or parent.endswith(\"/.claude/plans\")\n    return in_plans and PLAN_FILENAME_RE.fullmatch(filename) is not None\n\n\ndef plan_id_from_path(file_path: str) -> str:\n    \"\"\"Return ``PLAN-NNN`` from a schema-valid path, otherwise ``\"\"``.\"\"\"\n    if not file_path:\n        return \"\"\n    normalized = str(file_path).replace(\"\\\\\", \"/\")\n    filename = normalized.rsplit(\"/\", 1)[-1]\n    if not PLAN_FILENAME_RE.fullmatch(filename):\n        return \"\"\n    return filename[:8]\n\n\n__all__ = [\"PLAN_FILENAME_RE\", \"is_plan_path\", \"plan_id_from_path\"]\n","numLines":38,"startLine":1,"totalLines":38}},"tool_result_meta":[{"id":"toolu_01UBabQNBzVGEaSwfKHFwPFN","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
