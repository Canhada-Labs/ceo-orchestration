{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Adt8cfSumvgVaTUtUbDEpN","type":"tool_result","content":"595\t        suffix = f\" +{len(strandeds) - 5} more\"\n596\t    return \"PLAN-LIFECYCLE-STRANDED: \" + \", \".join(parts) + suffix\n597\t\n598\t\n599\tdef decide(\n600\t    *,\n601\t    file_path: str,\n602\t    old_string: str,\n603\t    new_string: str,\n604\t    replace_all: bool,\n605\t    read_current=_read_current_plan,\n606\t) -> Decision:\n607\t    \"\"\"Pure decision function — IO injected via read_current for testing.\"\"\"\n608\t    # Scope guard: only run on plan files\n609\t    if not _is_plan_file(file_path):\n610\t        return Decision(allow=True)\n611\t\n612\t    # Read current file content\n613\t    current = read_current(file_path)\n614\t    if not current:\n615\t        # File doesn't exist yet (creation via Edit is unusual; fail-open)\n616\t        return Decision(allow=True)\n617\t\n618\t    # Compute post-edit content\n619\t    new_content = _apply_edit(current, old_string, new_string, replace_all)\n620\t    if new_content == current:\n621\t        # Edit doesn't actually modify the file (or old_string not found)\n622\t        return Decision(allow=True)\n623\t\n624\t    return _decide_on_buffers(current, new_content)\n625\t\n626\t\n627\tdef _decide_on_buffers(old_content: str, new_content: str) -> Decision:\n628\t    \"\"\"Common decision path once we have pre/post buffers.\n629\t\n630\t    Used by the Edit path (direct substitution), the Write path (full\n631\t    replacement) and the MultiEdit path (sequential application).\n632\t    \"\"\"\n633\t    if new_content == old_content:\n634\t        return Decision(allow=True)\n635\t\n636\t    old_fm = _fm.parse_frontmatter(old_content)\n637\t    new_fm = _fm.parse_frontmatter(new_content)\n638\t\n639\t    old_status = str(old_fm.get(\"status\", \"\")).strip()\n640\t    new_status = str(new_fm.get(\"status\", \"\")).strip()\n641\t\n642\t    # If status didn't change, nothing to check\n643\t    if old_status == new_status:\n644\t        return Decision(allow=True)\n645\t\n646\t    # Status changed — validate\n647\t    reason = _check_transition(old_status, new_status)\n648\t    if reason:\n649\t        return Decision(allow=False, reason=reason)\n650\t\n651\t    reason = _check_required_fields(old_status, new_status, new_fm, new_content)\n652\t    if reason:\n653\t        return Decision(allow=False, reason=reason)\n654\t\n655\t    return Decision(allow=True)\n656\t\n657\t\n658\tdef decide_write(\n659\t    *,\n660\t    file_path: str,\n661\t    content: str,\n662\t    read_current=_read_current_plan,\n663\t) -> Decision:\n664\t    \"\"\"Write-tool variant of decide().\n665\t\n666\t    PLAN-019 P1-SEC-E: `Write` has `content` instead of old/new strings.\n667\t    We synthesize an Edit where old_string = <entire existing content>\n668\t    (or empty for a new file) and new_string = <content>, then run the\n669\t    same transition + required-field checks.\n670\t\n671\t    If the Write creates a brand-new plan file, `current` is empty. The\n672\t    transition validation still runs: a new plan with `status: done` but\n673\t    no `completed_at` is blocked just like `draft → done` via Edit.\n674\t    \"\"\"\n675\t    if not _is_plan_file(file_path):\n676\t        return Decision(allow=True)\n677\t\n678\t    current = read_current(file_path) or \"\"\n679\t    new_content = content or \"\"\n680\t    if new_content == current:\n681\t        return Decision(allow=True)\n682\t\n683\t    # For brand-new plan files (current == \"\"), old_status is empty and\n684\t    # the transition validator treats any legal new status as OK (see\n685\t    # _check_transition \"new plan\" branch). Required-field checks still\n686\t    # fire, so a new plan written directly as done/without-completed_at\n687\t    # blocks correctly.\n688\t    return _decide_on_buffers(current, new_content)\n689\t\n690\t\n691\tdef decide_multiedit(\n692\t    *,\n693\t    file_path: str,\n694\t    edits: list,\n695\t    read_current=_read_current_plan,\n696\t) -> Decision:\n697\t    \"\"\"MultiEdit-tool variant of decide().\n698\t\n699\t    PLAN-019 P1-SEC-E: `MultiEdit.tool_input.edits` is an array of\n700\t    `{old_string, new_string, replace_all}` dicts. Apply sequentially\n701\t    to simulate what the tool will produce, then run the same checks.\n702\t    \"\"\"\n703\t    if not _is_plan_file(file_path):\n704\t        return Decision(allow=True)\n705\t\n706\t    current = read_current(file_path)\n707\t    if not current:\n708\t        return Decision(allow=True)\n709\t\n710\t    buf = current\n711\t    for e in (edits or []):\n712\t        if not isinstance(e, dict):\n713\t            continue\n714\t        old_s = str(e.get(\"old_string\") or \"\")\n715\t        new_s = str(e.get(\"new_string\") or \"\")\n716\t        replace_all = bool(e.get(\"replace_all\") or False)\n717\t        buf = _apply_edit(buf, old_s, new_s, replace_all)\n718\t\n719\t    return _decide_on_buffers(current, buf)\n720\t\n721\t\n722\tdef _to_contract_decision(d: \"Decision\") -> _contract.Decision:\n723\t    if d.allow:\n724\t        return _contract.allow()"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"671347c9-2bb8-41fd-939a-5d1eaf0ecef6","timestamp":"2026-11-13T18:15:27.275Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/check_plan_edit.py","content":"        suffix = f\" +{len(strandeds) - 5} more\"\n    return \"PLAN-LIFECYCLE-STRANDED: \" + \", \".join(parts) + suffix\n\n\ndef decide(\n    *,\n    file_path: str,\n    old_string: str,\n    new_string: str,\n    replace_all: bool,\n    read_current=_read_current_plan,\n) -> Decision:\n    \"\"\"Pure decision function — IO injected via read_current for testing.\"\"\"\n    # Scope guard: only run on plan files\n    if not _is_plan_file(file_path):\n        return Decision(allow=True)\n\n    # Read current file content\n    current = read_current(file_path)\n    if not current:\n        # File doesn't exist yet (creation via Edit is unusual; fail-open)\n        return Decision(allow=True)\n\n    # Compute post-edit content\n    new_content = _apply_edit(current, old_string, new_string, replace_all)\n    if new_content == current:\n        # Edit doesn't actually modify the file (or old_string not found)\n        return Decision(allow=True)\n\n    return _decide_on_buffers(current, new_content)\n\n\ndef _decide_on_buffers(old_content: str, new_content: str) -> Decision:\n    \"\"\"Common decision path once we have pre/post buffers.\n\n    Used by the Edit path (direct substitution), the Write path (full\n    replacement) and the MultiEdit path (sequential application).\n    \"\"\"\n    if new_content == old_content:\n        return Decision(allow=True)\n\n    old_fm = _fm.parse_frontmatter(old_content)\n    new_fm = _fm.parse_frontmatter(new_content)\n\n    old_status = str(old_fm.get(\"status\", \"\")).strip()\n    new_status = str(new_fm.get(\"status\", \"\")).strip()\n\n    # If status didn't change, nothing to check\n    if old_status == new_status:\n        return Decision(allow=True)\n\n    # Status changed — validate\n    reason = _check_transition(old_status, new_status)\n    if reason:\n        return Decision(allow=False, reason=reason)\n\n    reason = _check_required_fields(old_status, new_status, new_fm, new_content)\n    if reason:\n        return Decision(allow=False, reason=reason)\n\n    return Decision(allow=True)\n\n\ndef decide_write(\n    *,\n    file_path: str,\n    content: str,\n    read_current=_read_current_plan,\n) -> Decision:\n    \"\"\"Write-tool variant of decide().\n\n    PLAN-019 P1-SEC-E: `Write` has `content` instead of old/new strings.\n    We synthesize an Edit where old_string = <entire existing content>\n    (or empty for a new file) and new_string = <content>, then run the\n    same transition + required-field checks.\n\n    If the Write creates a brand-new plan file, `current` is empty. The\n    transition validation still runs: a new plan with `status: done` but\n    no `completed_at` is blocked just like `draft → done` via Edit.\n    \"\"\"\n    if not _is_plan_file(file_path):\n        return Decision(allow=True)\n\n    current = read_current(file_path) or \"\"\n    new_content = content or \"\"\n    if new_content == current:\n        return Decision(allow=True)\n\n    # For brand-new plan files (current == \"\"), old_status is empty and\n    # the transition validator treats any legal new status as OK (see\n    # _check_transition \"new plan\" branch). Required-field checks still\n    # fire, so a new plan written directly as done/without-completed_at\n    # blocks correctly.\n    return _decide_on_buffers(current, new_content)\n\n\ndef decide_multiedit(\n    *,\n    file_path: str,\n    edits: list,\n    read_current=_read_current_plan,\n) -> Decision:\n    \"\"\"MultiEdit-tool variant of decide().\n\n    PLAN-019 P1-SEC-E: `MultiEdit.tool_input.edits` is an array of\n    `{old_string, new_string, replace_all}` dicts. Apply sequentially\n    to simulate what the tool will produce, then run the same checks.\n    \"\"\"\n    if not _is_plan_file(file_path):\n        return Decision(allow=True)\n\n    current = read_current(file_path)\n    if not current:\n        return Decision(allow=True)\n\n    buf = current\n    for e in (edits or []):\n        if not isinstance(e, dict):\n            continue\n        old_s = str(e.get(\"old_string\") or \"\")\n        new_s = str(e.get(\"new_string\") or \"\")\n        replace_all = bool(e.get(\"replace_all\") or False)\n        buf = _apply_edit(buf, old_s, new_s, replace_all)\n\n    return _decide_on_buffers(current, buf)\n\n\ndef _to_contract_decision(d: \"Decision\") -> _contract.Decision:\n    if d.allow:\n        return _contract.allow()","numLines":130,"startLine":595,"totalLines":957}},"tool_result_meta":[{"id":"toolu_01Adt8cfSumvgVaTUtUbDEpN","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
