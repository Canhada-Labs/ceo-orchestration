{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P1ey5nqaAWeoZEmeUjTPGN","type":"tool_result","content":"505\t    Fail-open invariant: any per-plan exception is swallowed and the\n506\t    walk continues. A blanket exception on the directory walk returns\n507\t    an empty list. The hook NEVER blocks on stranded detection.\n508\t    \"\"\"\n509\t    if now_unix is None:\n510\t        now_unix = int(time.time())\n511\t\n512\t    results: List[StrandedPlan] = []\n513\t    if not plans_dir or not plans_dir.is_dir():\n514\t        return results\n515\t\n516\t    try:\n517\t        plan_files = sorted(plans_dir.glob(\"PLAN-*.md\"))\n518\t    except OSError:\n519\t        return results\n520\t\n521\t    for plan_file in plan_files:\n522\t        try:\n523\t            # Skip PLAN-SCHEMA.md / DEBATE-SCHEMA.md / etc.\n524\t            if not _is_plan_file(str(plan_file)):\n525\t                continue\n526\t\n527\t            text = plan_file.read_text(encoding=\"utf-8\")\n528\t            fm = _fm.parse_frontmatter(text)\n529\t            status = str(fm.get(\"status\", \"\")).strip()\n530\t            plan_id = _extract_plan_id(plan_file.name) or plan_file.stem\n531\t            file_path = str(plan_file)\n532\t\n533\t            if status == \"executing\":\n534\t                # Mode 8.2 — query last-commit timestamp, frontmatter\n535\t                # override wins for testability.\n536\t                fm_lc = fm.get(\"last_commit_at\", \"\")\n537\t                last_unix: Optional[int] = None\n538\t                if fm_lc:\n539\t                    last_unix = _parse_iso_date_to_unix(str(fm_lc))\n540\t                if last_unix is None:\n541\t                    last_unix = _git_last_commit_unix(plan_file, repo_root=repo_root)\n542\t                if last_unix is None:\n543\t                    # No data → cannot decide stranded; skip (fail-open).\n544\t                    continue"}]},"parent_tool_use_id":null,"session_id":"2a4f4d70-7bb8-4cdc-868c-8f5f354648e0","uuid":"4a934cff-67e7-4b22-83dd-c60b772f29f1","timestamp":"2026-11-15T11:01:27.980Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_plan_edit.py","content":"    Fail-open invariant: any per-plan exception is swallowed and the\n    walk continues. A blanket exception on the directory walk returns\n    an empty list. The hook NEVER blocks on stranded detection.\n    \"\"\"\n    if now_unix is None:\n        now_unix = int(time.time())\n\n    results: List[StrandedPlan] = []\n    if not plans_dir or not plans_dir.is_dir():\n        return results\n\n    try:\n        plan_files = sorted(plans_dir.glob(\"PLAN-*.md\"))\n    except OSError:\n        return results\n\n    for plan_file in plan_files:\n        try:\n            # Skip PLAN-SCHEMA.md / DEBATE-SCHEMA.md / etc.\n            if not _is_plan_file(str(plan_file)):\n                continue\n\n            text = plan_file.read_text(encoding=\"utf-8\")\n            fm = _fm.parse_frontmatter(text)\n            status = str(fm.get(\"status\", \"\")).strip()\n            plan_id = _extract_plan_id(plan_file.name) or plan_file.stem\n            file_path = str(plan_file)\n\n            if status == \"executing\":\n                # Mode 8.2 — query last-commit timestamp, frontmatter\n                # override wins for testability.\n                fm_lc = fm.get(\"last_commit_at\", \"\")\n                last_unix: Optional[int] = None\n                if fm_lc:\n                    last_unix = _parse_iso_date_to_unix(str(fm_lc))\n                if last_unix is None:\n                    last_unix = _git_last_commit_unix(plan_file, repo_root=repo_root)\n                if last_unix is None:\n                    # No data → cannot decide stranded; skip (fail-open).\n                    continue","numLines":40,"startLine":505,"totalLines":957}},"tool_result_meta":[{"id":"toolu_01P1ey5nqaAWeoZEmeUjTPGN","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
