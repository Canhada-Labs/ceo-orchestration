{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NuAtXAGM1R1wroWeeC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Ccw3zUbLwV2vfYrLGbsaRi","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_precompact_parts/snapshot_core.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18327,"cache_read_input_tokens":155054,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18327},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"0b7c01ba-f90a-4f98-9ce2-eba79fb8adf0","timestamp":"2026-11-13T18:11:40.307Z","request_id":"req_011Ch1NuAhcCrmm5fwt1WNFV","wire_tool_inputs":{"toolu_01Ccw3zUbLwV2vfYrLGbsaRi":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_precompact_parts/snapshot_core.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ccw3zUbLwV2vfYrLGbsaRi","type":"tool_result","content":"1\t\"\"\"Snapshot construction, plan discovery and persistence.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _breadcrumb(msg: str) -> None:\n5\t    sys.stderr.write(\"# check_precompact_continuity: %s\\n\" % msg[:160])\n6\t\n7\t\n8\tdef _sanitize_text(raw: str, clamp: int) -> str:\n9\t    \"\"\"Disk-sourced strings written into the snapshot are kept printable-ASCII\n10\t    + clamped — the snapshot blob is later read by the PostCompact half and a\n11\t    control char / newline could distort downstream rendering. Mirrors the\n12\t    closeout-guard ``_sanitize_path`` hardening (Codex S228 P0).\"\"\"\n13\t    cleaned = \"\".join(ch if 0x20 <= ord(ch) <= 0x7E else \"?\" for ch in raw)\n14\t    return cleaned[:clamp]\n15\t\n16\t\n17\tdef _git(\n18\t    args: List[str], cwd: str, timeout_s: float = 2.0, raw: bool = False\n19\t) -> str:\n20\t    \"\"\"stdout on success, '' on any failure (fail-open).\n21\t\n22\t    ``timeout_s`` (rail r2 P2-f): a caller under a shared wall deadline\n23\t    passes its REMAINING time — a fixed 2s here let a late call run past\n24\t    the hook budget. Existing call sites keep the historical default.\n25\t\n26\t    Rail r8 P2-b: um resto de budget ABAIXO do floor de subprocess não é\n27\t    budget útil — o antigo ``max(0.05, ...)`` ESTICAVA um resto de 10ms\n28\t    para 50ms e furava o wall deadline compartilhado. Sem budget, a\n29\t    resposta honesta é o fail-open imediato, nunca uma chamada tardia.\"\"\"\n30\t    if timeout_s < 0.05:\n31\t        return \"\"\n32\t    try:\n33\t        # Rail r10 P2-a: errors=\"replace\" — filename nao-UTF-8 (legal em\n34\t        # Linux) sob `-z` vem em bytes crus; o decode ESTRITO do text=True\n35\t        # levantava UnicodeDecodeError que NENHUM except aqui pegava e o\n36\t        # snapshot inteiro morria por causa do indice OPCIONAL. Com\n37\t        # replacement o path vira U+FFFD, nao casa shape nenhum e degrada\n38\t        # honesto.\n39\t        p = subprocess.run(\n40\t            [\"git\"] + args, cwd=cwd, capture_output=True, text=True,\n41\t            errors=\"replace\", timeout=timeout_s,\n42\t        )\n43\t        if p.returncode != 0:\n44\t            return \"\"\n45\t        # Rail r11 P2-c: em modo raw (-z) o strip do output INTEIRO\n46\t        # corromperia whitespace legitimo do primeiro/ultimo path — os\n47\t        # limites exatos ja vem dos NULs.\n48\t        return p.stdout if raw else p.stdout.strip()\n49\t    except (subprocess.TimeoutExpired, OSError):\n50\t        return \"\"\n51\t\n52\t\n53\tdef _resolve_project_root(cwd: str) -> str:\n54\t    \"\"\"Project ROOT for every path this hook derives (rail round-9 [P2]).\n55\t\n56\t    O ``cwd`` do hook-input segue o CwdChanged da sessão para\n57\t    subdiretórios; derivar `.claude/...` dele fragmenta o estado — o\n58\t    lookup de plano erra, e o marker de pressão ganha uma cópia por\n59\t    subdiretório, derrotando o contrato de histerese. A autoridade é o\n60\t    toplevel do git (lição feedback-guard-must-resolve-repo-by-git-toplevel);\n61\t    o fallback sobe até o ancestral mais próximo com `.claude/`, e falha\n62\t    de resolução mantém o cwd (degradado, nunca quebrado).\"\"\"\n63\t    # Walk-up PRIMEIRO (não git-first): o leitor do marker no PostCompact\n64\t    # tem contrato no-exec e só pode usar o walk-up — para escritor e\n65\t    # leitor concordarem em TODO caso decisivo, a regra primária dos dois\n66\t    # é idêntica. O git-toplevel fica como fallback para o caso sem\n67\t    # `.claude/` em ancestral algum (onde não há marker a re-armar).\n68\t    probe = os.path.realpath(cwd)\n69\t    while True:\n70\t        if os.path.isdir(os.path.join(probe, \".claude\")):\n71\t            return probe\n72\t        parent = os.path.dirname(probe)\n73\t        if parent == probe:\n74\t            break\n75\t        probe = parent\n76\t    top = _git([\"rev-parse\", \"--show-toplevel\"], cwd)\n77\t    if top and os.path.isdir(top):\n78\t        return os.path.realpath(top)\n79\t    return os.path.realpath(cwd)\n80\t\n81\t\n82\tdef _trigger_class(event: Dict[str, Any]) -> str:\n83\t    \"\"\"Map the harness PreCompact trigger to the closed enum.\n84\t\n85\t    The documented PreCompact hook input carries a ``trigger`` field with\n86\t    ``manual`` (user ran /compact) or ``auto`` (context-window threshold).\n87\t    Anything else (incl. a missing field on a future harness change) is\n88\t    ``other`` — the audit_emit scrub re-coerces too (defense in depth).\"\"\"\n89\t    val = event.get(\"trigger\")\n90\t    if val in (\"manual\", \"auto\"):\n91\t        return val\n92\t    return \"other\"\n93\t\n94\t\n95\tdef _resolve_plan_id(event: Dict[str, Any]) -> str:\n96\t    \"\"\"Derive PLAN-NNN from the audit log (NOT env — agent-spoofable).\n97\t\n98\t    Returns ``unknown`` on any derivation failure (fail-open; the snapshot is\n99\t    still written with what we have).\"\"\"\n100\t    try:\n101\t        from _lib import scratchpad_lib  # noqa: E402\n102\t    except Exception as exc:  # pragma: no cover — import guard\n103\t        _breadcrumb(\"scratchpad_lib import failed (%s)\" % str(exc)[:60])\n104\t        return \"unknown\"\n105\t    session_id = None\n106\t    sid = event.get(\"session_id\") or event.get(\"sessionId\")\n107\t    if isinstance(sid, str) and sid.strip():\n108\t        session_id = sid.strip()\n109\t    try:\n110\t        return scratchpad_lib.resolve_plan_id(session_id)\n111\t    except Exception as exc:\n112\t        _breadcrumb(\"plan_id derivation failed (%s)\" % str(exc)[:80])\n113\t        return \"unknown\"\n114\t\n115\t\n116\tdef _session_scope_id(event: Dict[str, Any]) -> Optional[str]:\n117\t    \"\"\"Session id usable as a WRITE SCOPE, or None (PLAN-179 W1 US3, r1-C1).\n118\t\n119\t    Delegates the shape validation + the provenance rule to\n120\t    ``scratchpad_lib.session_id_from_event``: the id must come from the HOOK\n121\t    INPUT. If that helper returns None — no id in the event, malformed shape,\n122\t    or an id that would have been sourced from ``CLAUDE_SESSION_ID`` (env is\n123\t    agent-spoofable, consensus M2) — we REFUSE the fallback rather than write\n124\t    under a scope an agent could have chosen. Import/derivation failure is\n125\t    infrastructure: breadcrumb + None (fail-open).\"\"\"\n126\t    try:\n127\t        from _lib import scratchpad_lib  # noqa: E402\n128\t    except Exception as exc:  # pragma: no cover — import guard\n129\t        _breadcrumb(\"scratchpad_lib import failed at session scope (%s)\" % str(exc)[:60])\n130\t        return None\n131\t    try:\n132\t        sid = scratchpad_lib.session_id_from_event(event)\n133\t    except Exception as exc:\n134\t        _breadcrumb(\"session scope derivation failed (%s)\" % str(exc)[:80])\n135\t        return None\n136\t    if isinstance(sid, str) and sid.strip():\n137\t        return sid.strip()\n138\t    # None here is a DECISION (env-sourced / absent / malformed), not an error.\n139\t    return None\n140\t\n141\t\n142\tdef _plan_file_for(plan_id: str, cwd: str) -> Optional[str]:\n143\t    \"\"\"Absolute path of the plan markdown file for ``plan_id``, or None.\n144\t\n145\t    Matches ``PLAN-NNN-*.md`` directly under ``.claude/plans/`` (PLAN-SCHEMA\n146\t    naming). Returns the first match in sorted order (deterministic).\"\"\"\n147\t    if not plan_id.startswith(\"PLAN-\"):\n148\t        return None\n149\t    pattern = os.path.join(cwd, \".claude\", \"plans\", plan_id + \"-*.md\")\n150\t    matches = sorted(glob.glob(pattern))\n151\t    return matches[0] if matches else None\n152\t\n153\t\n154\tdef _execution_unit(plan_path: Optional[str], cwd: str, deadline: float) -> Dict[str, Any]:\n155\t    \"\"\"First unchecked ``- [ ]`` checkbox in the plan file (the active unit).\n156\t\n157\t    Returns ``{}`` when no plan file / no unchecked unit / budget blown.\n158\t    Path is repo-relative + sanitized; label is sanitized + clamped. The\n159\t    snapshot records position only — never the plan body.\"\"\"\n160\t    if not plan_path:\n161\t        return {}\n162\t    try:\n163\t        rel = _sanitize_text(os.path.relpath(plan_path, cwd), _PATH_CLAMP)\n164\t    except (OSError, ValueError):\n165\t        rel = _sanitize_text(plan_path, _PATH_CLAMP)\n166\t    try:\n167\t        with open(plan_path, encoding=\"utf-8\", errors=\"replace\") as fh:\n168\t            for lineno, line in enumerate(fh, start=1):\n169\t                if time.monotonic() > deadline:\n170\t                    return {}\n171\t                stripped = line.lstrip()\n172\t                # Unchecked checkbox, tolerant of leading list whitespace.\n173\t                if stripped.startswith(\"- [ ]\"):\n174\t                    label = stripped[len(\"- [ ]\"):].strip()\n175\t                    return {\n176\t                        \"plan_path\": rel,\n177\t                        \"line\": lineno,\n178\t                        \"label\": _sanitize_text(label, _LABEL_CLAMP),\n179\t                    }\n180\t    except OSError as exc:\n181\t        _breadcrumb(\"plan file read failed (%s)\" % str(exc)[:60])\n182\t        return {\"plan_path\": rel}\n183\t    # All checkboxes checked (or none): record the file, no active unit.\n184\t    return {\"plan_path\": rel}\n185\t\n186\t\n187\tdef _last_tag_time(cwd: str, timeout_s: float = 2.0) -> float:\n188\t    # Rail r21 P2-c: o caller sob deadline compartilhado passa o RESTO —\n189\t    # o default fixo de 2.0s somado a fatia do indice estourava o\n190\t    # TIME_BUDGET_S de 2.5s do gate num repositorio lento.\n191\t    out = _git(\n192\t        [\n193\t            \"for-each-ref\",\n194\t            \"--sort=-creatordate\",\n195\t            \"--count=1\",\n196\t            \"--format=%(creatordate:unix)\",\n197\t            \"refs/tags\",\n198\t        ],\n199\t        cwd,\n200\t        timeout_s=timeout_s,\n201\t    )\n202\t    try:\n203\t        return float(out)\n204\t    except ValueError:\n205\t        return 0.0\n206\t\n207\t\n208\tdef _ceremony_flags(cwd: str, deadline: float) -> List[str]:\n209\t    \"\"\"Pending Owner-GPG ceremonies — executable finish-*.sh newer than the\n210\t    last tag (the closeout-guard's signal). Repo-relative, sanitized, sorted,\n211\t    bounded. These are POINTERS the operator must act on post-compaction.\"\"\"\n212\t    tag_time = _last_tag_time(cwd, timeout_s=deadline - time.monotonic())\n213\t    found = set()\n214\t    patterns = (\n215\t        os.path.join(cwd, \".claude\", \"plans\", \"PLAN-*\", \"staged\", \"**\", \"finish-*.sh\"),\n216\t        os.path.join(cwd, \"scripts\", \"local\", \"finish-*.sh\"),\n217\t    )\n218\t    for pattern in patterns:\n219\t        # Rail r22 P2-c: deadline ANTES de cada glob e iteracao LAZY —\n220\t        # glob.glob materializava a arvore inteira antes do primeiro\n221\t        # check interno e o 2o pattern rodava mesmo apos o break.\n222\t        if time.monotonic() > deadline:\n223\t            break\n224\t        for path in glob.iglob(pattern, recursive=True):\n225\t            if time.monotonic() > deadline:\n226\t                break\n227\t            try:\n228\t                if os.access(path, os.X_OK) and os.path.getmtime(path) > tag_time:\n229\t                    found.add(\n230\t                        _sanitize_text(os.path.relpath(path, cwd), _PATH_CLAMP)\n231\t                    )\n232\t            except OSError:\n233\t                continue\n234\t    return sorted(found)[:MAX_CEREMONY_FLAGS]\n235\t\n236\t\n237\tdef _hmac_chain_breadcrumb(deadline: Optional[float] = None) -> Dict[str, Any]:\n238\t    \"\"\"READ-ONLY snapshot of the HMAC-chain anchor: last-hmac hex PREFIX +\n239\t    chain-length counter.\n240\t\n241\t    Lock-respecting (audit_hmac readers MUST hold the audit filelock — we take\n242\t    a best-effort shared lock; on unavailability we still read, since these are\n243\t    advisory sidecars and a one-event race is harmless for a snapshot anchor).\n244\t    Returns ``{\"chain_length\": 0}`` on any failure (fail-open). Only the FIRST\n245\t    12 hex chars of the last-hmac are kept — enough to detect a post-compaction\n246\t    chain divergence, not enough to be a forgery oracle.\"\"\"\n247\t    out: Dict[str, Any] = {\"chain_length\": 0, \"last_hmac_prefix\": \"\"}\n248\t    try:\n249\t        from _lib import audit_hmac  # noqa: E402\n250\t    except Exception as exc:  # pragma: no cover — import guard\n251\t        _breadcrumb(\"audit_hmac import failed (%s)\" % str(exc)[:60])\n252\t        return out\n253\t    try:\n254\t        from _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\n255\t        _have_lock = True\n256\t    except Exception:  # pragma: no cover\n257\t        FileLock = None  # type: ignore[assignment]\n258\t        FileLockTimeout = Exception  # type: ignore[assignment, misc]\n259\t        _have_lock = False\n260\t\n261\t    def _read() -> None:\n262\t        try:\n263\t            out[\"chain_length\"] = int(audit_hmac.read_chain_length())\n264\t        except Exception:\n265\t            out[\"chain_length\"] = 0\n266\t        try:\n267\t            prev = audit_hmac.read_prev_hmac()\n268\t            out[\"last_hmac_prefix\"] = audit_hmac.hex_digest(prev)[:12]\n269\t        except Exception:\n270\t            out[\"last_hmac_prefix\"] = \"\"\n271\t\n272\t    # Rail r21 P2-c: a espera de lock respeita o deadline compartilhado —\n273\t    # sem resto de budget, leitura lockless direta (advisory sidecar; a\n274\t    # corrida de um evento e inofensiva, doutrina ja declarada acima).\n275\t    _lock_wait = 0.5\n276\t    if deadline is not None:\n277\t        _lock_wait = min(0.5, deadline - time.monotonic())\n278\t    if _have_lock and FileLock is not None and _lock_wait > 0:\n279\t        try:\n280\t            lock_path = audit_hmac.last_hmac_path().with_name(\"audit-log.lock\")\n281\t            with FileLock(lock_path, timeout=_lock_wait):\n282\t                _read()\n283\t            return out\n284\t        except FileLockTimeout:\n285\t            _breadcrumb(\"hmac sidecar lock timeout — lockless best-effort read\")\n286\t        except Exception as exc:\n287\t            _breadcrumb(\"hmac sidecar lock error (%s) — lockless read\" % str(exc)[:60])\n288\t    _read()\n289\t    return out\n290\t\n291\t\n292\tdef _emit_snapshot_event(\n293\t    trigger: str, plan_id: str, chain_length: int, snapshot_outcome: str\n294\t) -> None:\n295\t    \"\"\"Emit the closed-enum compaction_continuity_snapshot breadcrumb.\n296\t\n297\t    Carries ONLY closed enums + the chain_length counter — never the snapshot\n298\t    body. Import-guarded; any failure is swallowed (the hook NEVER blocks on\n299\t    audit infra). Mirrors the check_protocol_semver_cascade emit idiom.\"\"\"\n300\t    try:\n301\t        from _lib import audit_emit  # noqa: E402\n302\t    except Exception:\n303\t        return\n304\t    try:\n305\t        audit_emit.emit_generic(\n306\t            action=\"compaction_continuity_snapshot\",\n307\t            trigger=trigger,\n308\t            plan_id=plan_id,\n309\t            chain_length=chain_length,\n310\t            snapshot_outcome=snapshot_outcome,\n311\t        )\n312\t    except Exception as exc:  # pragma: no cover — belt-and-suspenders\n313\t        _breadcrumb(\"audit emit failed (%s)\" % str(exc)[:80])\n314\t\n315\t\n316\tdef _write_snapshot(\n317\t    plan_id: str, blob: Dict[str, Any], session_id: Optional[str] = None\n318\t) -> str:\n319\t    \"\"\"Persist the snapshot blob to the plan- or session-scoped scratchpad.\n320\t\n321\t    Returns the closed-enum snapshot_outcome:\n322\t\n323\t      - ``written`` — plan scope resolved, blob written under ``plan_id``;\n324\t      - ``written_session_scope`` — PLAN-179 W1 US3: no plan scope, but the\n325\t        hook input carried a usable session id, so the blob was written under\n326\t        the SESSION store (``scope_kind=\"session\"`` inside the blob; the\n327\t        ``plan_id`` field is left at ``unknown`` — emenda r1-C1 forbids\n328\t        overloading it, the store's plan-isolation invariant depends on it);\n329\t      - ``scratchpad_unavailable`` — a REAL unavailability: the scratchpad_lib\n330\t        import failed, or there is no scope we are allowed to write under\n331\t        (session id absent / malformed / env-sourced ⇒ refused, r1-C1). It no\n332\t        longer means \"the plan was not resolved\" — that case now WRITES;\n333\t      - ``error`` — serialization or the store write itself failed.\n334\t\n335\t    Secrets: the blob is handed to ``store.set`` as a ``str`` on BOTH paths so\n336\t    the store's ``redact_secrets`` pass actually runs (PLAN-179 amendment 8.3\n337\t    / debate C9 — the previous ``payload.encode(\"utf-8\")`` took the bytes\n338\t    branch, which ``state_store`` trusts verbatim, making the documented\n339\t    \"secrets-redacted\" claim false on the only path this hook used).\n340\t    ``set`` overwrites the prior snapshot in either scope.\"\"\"\n341\t    try:\n342\t        from _lib import scratchpad_lib  # noqa: E402\n343\t    except Exception as exc:\n344\t        _breadcrumb(\"scratchpad_lib import failed at write (%s)\" % str(exc)[:60])\n345\t        return \"scratchpad_unavailable\"\n346\t\n347\t    plan_scoped = plan_id != \"unknown\" and plan_id.startswith(\"PLAN-\")\n348\t    if not plan_scoped and not session_id:\n349\t        # No scope we may write under: the plan is unresolved AND the session\n350\t        # id was absent/malformed/env-sourced. The audit event still records\n351\t        # the attempt (PostCompact degrades to snapshot_found=False).\n352\t        _breadcrumb(\"no plan scope and no hook-input session id — write skipped\")\n353\t        return \"scratchpad_unavailable\"\n354\t\n355\t    # scope_kind travels INSIDE the blob (r1-C1) so the PostCompact half can\n356\t    # tell a session-scoped snapshot from a plan-scoped one without guessing.\n357\t    #\n358\t    # PLAN-179 W0/W1 cross-file pass — closes the \"recalled closed set\" defect:\n359\t    # this used to write the literal strings \"plan\"/\"session\". The enum's owner\n360\t    # is scratchpad_lib (SCOPE_KIND_PLAN / SCOPE_KIND_SESSION, validated by\n361\t    # stamp_scope_kind, which RAISES on an off-enum value). Stamping through the\n362\t    # library means a future rename cannot leave this writer emitting a value\n363\t    # the PostCompact reader no longer recognises\n364\t    # ([[feedback-closed-sets-must-be-derived-not-recalled]]).\n365\t    body = dict(blob)\n366\t    try:\n367\t        scope_kind = (\n368\t            scratchpad_lib.SCOPE_KIND_PLAN\n369\t            if plan_scoped\n370\t            else scratchpad_lib.SCOPE_KIND_SESSION\n371\t        )\n372\t        scratchpad_lib.stamp_scope_kind(body, scope_kind)\n373\t    except Exception as exc:\n374\t        # AttributeError = an adopter on a pre-PLAN-179 scratchpad_lib (the only\n375\t        # genuine cross-version case); ValueError = an off-enum scope_kind, which\n376\t        # would be a bug in THIS file. Either way the snapshot is still worth\n377\t        # writing, but it MUST carry the field the PostCompact reader keys on —\n378\t        # so fall back to the literal and say loudly that the library did not\n379\t        # own the enum on this run.\n380\t        _breadcrumb(\n381\t            \"scratchpad_lib scope-kind API unavailable/refused (%s) — \"\n382\t            \"stamping scope_kind inline; expected the library to own this enum\"\n383\t            % str(exc)[:60]\n384\t        )\n385\t        body[\"scope_kind\"] = \"plan\" if plan_scoped else \"session\"\n386\t    # Rail round-8 [P1]: redaction is a FIELD-level duty here, not a\n387\t    # store-level one. `state_store.set` runs `redact_secrets` over str\n388\t    # values, and its kv pattern (`token=\\S{1,2048}`) is JSON-blind: on a\n389\t    # serialized snapshot whose field ends in assignment-shaped text\n390\t    # (`deploy token=abc`) it consumes the closing quote/comma and stores\n391\t    # MALFORMED JSON — PostCompact parses nothing and the continuity cure\n392\t    # dies silently for exactly the secrets it must survive. So every str\n393\t    # field is redacted BEFORE serialization (max_chars=0, no truncation)\n394\t    # and the store receives BYTES — its documented \"caller owns the\n395\t    # content\" route (amendment 8.3's redaction CLAIM stays true; only the\n396\t    # layer that fulfils it moved). If the redactor is unavailable, fall\n397\t    # back to the old str path: the store's pass still guarantees nothing\n398\t    # unredacted lands on disk (the residual cost is the corruption this\n399\t    # cure removes — never a secret).\n400\t    try:\n401\t        from _lib.redact import redact_secrets as _redact_fn\n402\t    except Exception:\n403\t        _redact_fn = None\n404\t    if _redact_fn is not None:\n405\t        def _redact_tree(node):\n406\t            if isinstance(node, str):\n407\t                return _redact_fn(node, max_chars=0)\n408\t            if isinstance(node, dict):\n409\t                return {k: _redact_tree(v) for k, v in node.items()}\n410\t            if isinstance(node, list):\n411\t                return [_redact_tree(v) for v in node]\n412\t            return node\n413\t        try:\n414\t            body = _redact_tree(body)\n415\t        except Exception as exc:\n416\t            _breadcrumb(\"snapshot field redaction failed (%s)\" % str(exc)[:60])\n417\t            _redact_fn = None\n418\t\n419\t    try:\n420\t        payload = json.dumps(body, ensure_ascii=False, sort_keys=True)\n421\t    except (TypeError, ValueError) as exc:\n422\t        _breadcrumb(\"snapshot serialize failed (%s)\" % str(exc)[:60])\n423\t        return \"error\"\n424\t    store_value = (\n425\t        payload.encode(\"utf-8\") if _redact_fn is not None else payload\n426\t    )\n427\t\n428\t    try:\n429\t        if plan_scoped:\n430\t            with scratchpad_lib.open_scratchpad(plan_id=plan_id) as store:\n431\t                store.set(SCRATCHPAD_KEY, store_value)\n432\t            return \"written\"\n433\t        with scratchpad_lib.open_session_scratchpad(session_id) as store:\n434\t            # Explicit ttl (emenda r1-C2): session scopes are per-session and\n435\t            # would otherwise accumulate forever.\n436\t            #\n437\t            # PLAN-179 W0/W1 cross-file pass: routed through the library's\n438\t            # `set_session_value` rather than `store.set(..., ttl_seconds=...)`.\n439\t            # That helper is where r1-C2 made the positive TTL MECHANICAL — it\n440\t            # RAISES on a None/non-positive ttl instead of silently writing a\n441\t            # never-expiring row, which is precisely the accumulation bug the\n442\t            # amendment named. Calling store.set directly bypassed the guard the\n443\t            # library exists to provide.\n444\t            scratchpad_lib.set_session_value(\n445\t                store, SCRATCHPAD_KEY, store_value,\n446\t                ttl_seconds=SESSION_SNAPSHOT_TTL_S,\n447\t            )\n448\t        return \"written_session_scope\"\n449\t    except Exception as exc:\n450\t        _breadcrumb(\"scratchpad write failed (%s)\" % str(exc)[:80])\n451\t        return \"error\"\n452\t\n453\t\n454\tdef _gc_session_stores(deadline: float) -> None:\n455\t    \"\"\"Reclaim aged-out session-store FILES. Never affects the snapshot.\n456\t\n457\t    PLAN-179 rail finding C (round-1 REJECT): ``gc_orphan_session_stores`` had\n458\t    no production caller anywhere in the tree, so the W1 US3 session-scope\n459\t    fallback accumulated one ``session-<uuid>.sqlite`` (+ ``.lock`` / WAL /\n460\t    SHM) per unresolved-plan session with nothing to reclaim it — row TTL\n461\t    expiry cannot unlink a file. This is that caller.\n462\t\n463\t    Three properties, in the order they matter:\n464\t\n465\t    1. **Fail-OPEN, always.** Import failure, a missing symbol on a\n466\t       pre-PLAN-179 adopter, any exception out of the sweep: breadcrumb and\n467\t       return. The snapshot above it has already been written and its outcome\n468\t       is already on the wire — housekeeping may not retro-actively change it.\n469\t    2. **Cheap and bounded.** PreCompact fires at most once per compaction, so\n470\t       no extra throttle is invented here (a timestamp file would be a second\n471\t       piece of state to get wrong). The work is one directory listing plus at\n472\t       most ``MAX_GC_FILES_PER_RUN`` unlinks — the cap is the LIBRARY's, not\n473\t       a number recalled here\n474\t       ([[feedback-closed-sets-must-be-derived-not-recalled]]). The remaining\n475\t       budget is honoured: a run that already blew ``TIME_BUDGET_S`` skips the\n476\t       sweep rather than adding to the overrun.\n477\t    3. **TTL matched to what this hook WRITES.** ``ttl_seconds`` is passed\n478\t       explicitly as :data:`SESSION_SNAPSHOT_TTL_S` (7 days) because the\n479\t       library default is 72h, and a 72h mtime cutoff would unlink a store\n480\t       whose rows this hook wrote with a 7-day TTL — deleting a snapshot that\n481\t       is still live. The GC threshold must never be shorter than the write\n482\t       TTL it collects behind.\"\"\"\n483\t    if time.monotonic() > deadline:\n484\t        _breadcrumb(\"time budget spent — session-store GC skipped this run\")\n485\t        return\n486\t    try:\n487\t        from _lib import scratchpad_lib  # noqa: E402\n488\t    except Exception as exc:\n489\t        _breadcrumb(\"scratchpad_lib import failed at GC (%s)\" % str(exc)[:60])\n490\t        return\n491\t    gc = getattr(scratchpad_lib, \"gc_orphan_session_stores\", None)\n492\t    if gc is None:\n493\t        _breadcrumb(\n494\t            \"scratchpad_lib.gc_orphan_session_stores missing — this build \"\n495\t            \"predates PLAN-179 W1 US3; session-store GC skipped\"\n496\t        )\n497\t        return\n498\t    try:\n499\t        removed = gc(ttl_seconds=SESSION_SNAPSHOT_TTL_S)\n500\t    except Exception as exc:\n501\t        # The helper documents itself as fail-open, so an exception here is a\n502\t        # genuine surprise — still swallowed: this runs AFTER the snapshot.\n503\t        _breadcrumb(\"session-store GC failed (%s) — ignored\" % str(exc)[:80])\n504\t        return\n505\t    if removed:\n506\t        _breadcrumb(\"session-store GC unlinked %d aged-out file(s)\" % removed)\n507\t"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"a5e94a13-1ae6-45ef-b24f-e3e0b72a388d","timestamp":"2026-11-13T18:11:40.321Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_precompact_parts/snapshot_core.py","content":"\"\"\"Snapshot construction, plan discovery and persistence.\"\"\"\nfrom __future__ import annotations\n\ndef _breadcrumb(msg: str) -> None:\n    sys.stderr.write(\"# check_precompact_continuity: %s\\n\" % msg[:160])\n\n\ndef _sanitize_text(raw: str, clamp: int) -> str:\n    \"\"\"Disk-sourced strings written into the snapshot are kept printable-ASCII\n    + clamped — the snapshot blob is later read by the PostCompact half and a\n    control char / newline could distort downstream rendering. Mirrors the\n    closeout-guard ``_sanitize_path`` hardening (Codex S228 P0).\"\"\"\n    cleaned = \"\".join(ch if 0x20 <= ord(ch) <= 0x7E else \"?\" for ch in raw)\n    return cleaned[:clamp]\n\n\ndef _git(\n    args: List[str], cwd: str, timeout_s: float = 2.0, raw: bool = False\n) -> str:\n    \"\"\"stdout on success, '' on any failure (fail-open).\n\n    ``timeout_s`` (rail r2 P2-f): a caller under a shared wall deadline\n    passes its REMAINING time — a fixed 2s here let a late call run past\n    the hook budget. Existing call sites keep the historical default.\n\n    Rail r8 P2-b: um resto de budget ABAIXO do floor de subprocess não é\n    budget útil — o antigo ``max(0.05, ...)`` ESTICAVA um resto de 10ms\n    para 50ms e furava o wall deadline compartilhado. Sem budget, a\n    resposta honesta é o fail-open imediato, nunca uma chamada tardia.\"\"\"\n    if timeout_s < 0.05:\n        return \"\"\n    try:\n        # Rail r10 P2-a: errors=\"replace\" — filename nao-UTF-8 (legal em\n        # Linux) sob `-z` vem em bytes crus; o decode ESTRITO do text=True\n        # levantava UnicodeDecodeError que NENHUM except aqui pegava e o\n        # snapshot inteiro morria por causa do indice OPCIONAL. Com\n        # replacement o path vira U+FFFD, nao casa shape nenhum e degrada\n        # honesto.\n        p = subprocess.run(\n            [\"git\"] + args, cwd=cwd, capture_output=True, text=True,\n            errors=\"replace\", timeout=timeout_s,\n        )\n        if p.returncode != 0:\n            return \"\"\n        # Rail r11 P2-c: em modo raw (-z) o strip do output INTEIRO\n        # corromperia whitespace legitimo do primeiro/ultimo path — os\n        # limites exatos ja vem dos NULs.\n        return p.stdout if raw else p.stdout.strip()\n    except (subprocess.TimeoutExpired, OSError):\n        return \"\"\n\n\ndef _resolve_project_root(cwd: str) -> str:\n    \"\"\"Project ROOT for every path this hook derives (rail round-9 [P2]).\n\n    O ``cwd`` do hook-input segue o CwdChanged da sessão para\n    subdiretórios; derivar `.claude/...` dele fragmenta o estado — o\n    lookup de plano erra, e o marker de pressão ganha uma cópia por\n    subdiretório, derrotando o contrato de histerese. A autoridade é o\n    toplevel do git (lição feedback-guard-must-resolve-repo-by-git-toplevel);\n    o fallback sobe até o ancestral mais próximo com `.claude/`, e falha\n    de resolução mantém o cwd (degradado, nunca quebrado).\"\"\"\n    # Walk-up PRIMEIRO (não git-first): o leitor do marker no PostCompact\n    # tem contrato no-exec e só pode usar o walk-up — para escritor e\n    # leitor concordarem em TODO caso decisivo, a regra primária dos dois\n    # é idêntica. O git-toplevel fica como fallback para o caso sem\n    # `.claude/` em ancestral algum (onde não há marker a re-armar).\n    probe = os.path.realpath(cwd)\n    while True:\n        if os.path.isdir(os.path.join(probe, \".claude\")):\n            return probe\n        parent = os.path.dirname(probe)\n        if parent == probe:\n            break\n        probe = parent\n    top = _git([\"rev-parse\", \"--show-toplevel\"], cwd)\n    if top and os.path.isdir(top):\n        return os.path.realpath(top)\n    return os.path.realpath(cwd)\n\n\ndef _trigger_class(event: Dict[str, Any]) -> str:\n    \"\"\"Map the harness PreCompact trigger to the closed enum.\n\n    The documented PreCompact hook input carries a ``trigger`` field with\n    ``manual`` (user ran /compact) or ``auto`` (context-window threshold).\n    Anything else (incl. a missing field on a future harness change) is\n    ``other`` — the audit_emit scrub re-coerces too (defense in depth).\"\"\"\n    val = event.get(\"trigger\")\n    if val in (\"manual\", \"auto\"):\n        return val\n    return \"other\"\n\n\ndef _resolve_plan_id(event: Dict[str, Any]) -> str:\n    \"\"\"Derive PLAN-NNN from the audit log (NOT env — agent-spoofable).\n\n    Returns ``unknown`` on any derivation failure (fail-open; the snapshot is\n    still written with what we have).\"\"\"\n    try:\n        from _lib import scratchpad_lib  # noqa: E402\n    except Exception as exc:  # pragma: no cover — import guard\n        _breadcrumb(\"scratchpad_lib import failed (%s)\" % str(exc)[:60])\n        return \"unknown\"\n    session_id = None\n    sid = event.get(\"session_id\") or event.get(\"sessionId\")\n    if isinstance(sid, str) and sid.strip():\n        session_id = sid.strip()\n    try:\n        return scratchpad_lib.resolve_plan_id(session_id)\n    except Exception as exc:\n        _breadcrumb(\"plan_id derivation failed (%s)\" % str(exc)[:80])\n        return \"unknown\"\n\n\ndef _session_scope_id(event: Dict[str, Any]) -> Optional[str]:\n    \"\"\"Session id usable as a WRITE SCOPE, or None (PLAN-179 W1 US3, r1-C1).\n\n    Delegates the shape validation + the provenance rule to\n    ``scratchpad_lib.session_id_from_event``: the id must come from the HOOK\n    INPUT. If that helper returns None — no id in the event, malformed shape,\n    or an id that would have been sourced from ``CLAUDE_SESSION_ID`` (env is\n    agent-spoofable, consensus M2) — we REFUSE the fallback rather than write\n    under a scope an agent could have chosen. Import/derivation failure is\n    infrastructure: breadcrumb + None (fail-open).\"\"\"\n    try:\n        from _lib import scratchpad_lib  # noqa: E402\n    except Exception as exc:  # pragma: no cover — import guard\n        _breadcrumb(\"scratchpad_lib import failed at session scope (%s)\" % str(exc)[:60])\n        return None\n    try:\n        sid = scratchpad_lib.session_id_from_event(event)\n    except Exception as exc:\n        _breadcrumb(\"session scope derivation failed (%s)\" % str(exc)[:80])\n        return None\n    if isinstance(sid, str) and sid.strip():\n        return sid.strip()\n    # None here is a DECISION (env-sourced / absent / malformed), not an error.\n    return None\n\n\ndef _plan_file_for(plan_id: str, cwd: str) -> Optional[str]:\n    \"\"\"Absolute path of the plan markdown file for ``plan_id``, or None.\n\n    Matches ``PLAN-NNN-*.md`` directly under ``.claude/plans/`` (PLAN-SCHEMA\n    naming). Returns the first match in sorted order (deterministic).\"\"\"\n    if not plan_id.startswith(\"PLAN-\"):\n        return None\n    pattern = os.path.join(cwd, \".claude\", \"plans\", plan_id + \"-*.md\")\n    matches = sorted(glob.glob(pattern))\n    return matches[0] if matches else None\n\n\ndef _execution_unit(plan_path: Optional[str], cwd: str, deadline: float) -> Dict[str, Any]:\n    \"\"\"First unchecked ``- [ ]`` checkbox in the plan file (the active unit).\n\n    Returns ``{}`` when no plan file / no unchecked unit / budget blown.\n    Path is repo-relative + sanitized; label is sanitized + clamped. The\n    snapshot records position only — never the plan body.\"\"\"\n    if not plan_path:\n        return {}\n    try:\n        rel = _sanitize_text(os.path.relpath(plan_path, cwd), _PATH_CLAMP)\n    except (OSError, ValueError):\n        rel = _sanitize_text(plan_path, _PATH_CLAMP)\n    try:\n        with open(plan_path, encoding=\"utf-8\", errors=\"replace\") as fh:\n            for lineno, line in enumerate(fh, start=1):\n                if time.monotonic() > deadline:\n                    return {}\n                stripped = line.lstrip()\n                # Unchecked checkbox, tolerant of leading list whitespace.\n                if stripped.startswith(\"- [ ]\"):\n                    label = stripped[len(\"- [ ]\"):].strip()\n                    return {\n                        \"plan_path\": rel,\n                        \"line\": lineno,\n                        \"label\": _sanitize_text(label, _LABEL_CLAMP),\n                    }\n    except OSError as exc:\n        _breadcrumb(\"plan file read failed (%s)\" % str(exc)[:60])\n        return {\"plan_path\": rel}\n    # All checkboxes checked (or none): record the file, no active unit.\n    return {\"plan_path\": rel}\n\n\ndef _last_tag_time(cwd: str, timeout_s: float = 2.0) -> float:\n    # Rail r21 P2-c: o caller sob deadline compartilhado passa o RESTO —\n    # o default fixo de 2.0s somado a fatia do indice estourava o\n    # TIME_BUDGET_S de 2.5s do gate num repositorio lento.\n    out = _git(\n        [\n            \"for-each-ref\",\n            \"--sort=-creatordate\",\n            \"--count=1\",\n            \"--format=%(creatordate:unix)\",\n            \"refs/tags\",\n        ],\n        cwd,\n        timeout_s=timeout_s,\n    )\n    try:\n        return float(out)\n    except ValueError:\n        return 0.0\n\n\ndef _ceremony_flags(cwd: str, deadline: float) -> List[str]:\n    \"\"\"Pending Owner-GPG ceremonies — executable finish-*.sh newer than the\n    last tag (the closeout-guard's signal). Repo-relative, sanitized, sorted,\n    bounded. These are POINTERS the operator must act on post-compaction.\"\"\"\n    tag_time = _last_tag_time(cwd, timeout_s=deadline - time.monotonic())\n    found = set()\n    patterns = (\n        os.path.join(cwd, \".claude\", \"plans\", \"PLAN-*\", \"staged\", \"**\", \"finish-*.sh\"),\n        os.path.join(cwd, \"scripts\", \"local\", \"finish-*.sh\"),\n    )\n    for pattern in patterns:\n        # Rail r22 P2-c: deadline ANTES de cada glob e iteracao LAZY —\n        # glob.glob materializava a arvore inteira antes do primeiro\n        # check interno e o 2o pattern rodava mesmo apos o break.\n        if time.monotonic() > deadline:\n            break\n        for path in glob.iglob(pattern, recursive=True):\n            if time.monotonic() > deadline:\n                break\n            try:\n                if os.access(path, os.X_OK) and os.path.getmtime(path) > tag_time:\n                    found.add(\n                        _sanitize_text(os.path.relpath(path, cwd), _PATH_CLAMP)\n                    )\n            except OSError:\n                continue\n    return sorted(found)[:MAX_CEREMONY_FLAGS]\n\n\ndef _hmac_chain_breadcrumb(deadline: Optional[float] = None) -> Dict[str, Any]:\n    \"\"\"READ-ONLY snapshot of the HMAC-chain anchor: last-hmac hex PREFIX +\n    chain-length counter.\n\n    Lock-respecting (audit_hmac readers MUST hold the audit filelock — we take\n    a best-effort shared lock; on unavailability we still read, since these are\n    advisory sidecars and a one-event race is harmless for a snapshot anchor).\n    Returns ``{\"chain_length\": 0}`` on any failure (fail-open). Only the FIRST\n    12 hex chars of the last-hmac are kept — enough to detect a post-compaction\n    chain divergence, not enough to be a forgery oracle.\"\"\"\n    out: Dict[str, Any] = {\"chain_length\": 0, \"last_hmac_prefix\": \"\"}\n    try:\n        from _lib import audit_hmac  # noqa: E402\n    except Exception as exc:  # pragma: no cover — import guard\n        _breadcrumb(\"audit_hmac import failed (%s)\" % str(exc)[:60])\n        return out\n    try:\n        from _lib.filelock import FileLock, FileLockTimeout  # noqa: E402\n        _have_lock = True\n    except Exception:  # pragma: no cover\n        FileLock = None  # type: ignore[assignment]\n        FileLockTimeout = Exception  # type: ignore[assignment, misc]\n        _have_lock = False\n\n    def _read() -> None:\n        try:\n            out[\"chain_length\"] = int(audit_hmac.read_chain_length())\n        except Exception:\n            out[\"chain_length\"] = 0\n        try:\n            prev = audit_hmac.read_prev_hmac()\n            out[\"last_hmac_prefix\"] = audit_hmac.hex_digest(prev)[:12]\n        except Exception:\n            out[\"last_hmac_prefix\"] = \"\"\n\n    # Rail r21 P2-c: a espera de lock respeita o deadline compartilhado —\n    # sem resto de budget, leitura lockless direta (advisory sidecar; a\n    # corrida de um evento e inofensiva, doutrina ja declarada acima).\n    _lock_wait = 0.5\n    if deadline is not None:\n        _lock_wait = min(0.5, deadline - time.monotonic())\n    if _have_lock and FileLock is not None and _lock_wait > 0:\n        try:\n            lock_path = audit_hmac.last_hmac_path().with_name(\"audit-log.lock\")\n            with FileLock(lock_path, timeout=_lock_wait):\n                _read()\n            return out\n        except FileLockTimeout:\n            _breadcrumb(\"hmac sidecar lock timeout — lockless best-effort read\")\n        except Exception as exc:\n            _breadcrumb(\"hmac sidecar lock error (%s) — lockless read\" % str(exc)[:60])\n    _read()\n    return out\n\n\ndef _emit_snapshot_event(\n    trigger: str, plan_id: str, chain_length: int, snapshot_outcome: str\n) -> None:\n    \"\"\"Emit the closed-enum compaction_continuity_snapshot breadcrumb.\n\n    Carries ONLY closed enums + the chain_length counter — never the snapshot\n    body. Import-guarded; any failure is swallowed (the hook NEVER blocks on\n    audit infra). Mirrors the check_protocol_semver_cascade emit idiom.\"\"\"\n    try:\n        from _lib import audit_emit  # noqa: E402\n    except Exception:\n        return\n    try:\n        audit_emit.emit_generic(\n            action=\"compaction_continuity_snapshot\",\n            trigger=trigger,\n            plan_id=plan_id,\n            chain_length=chain_length,\n            snapshot_outcome=snapshot_outcome,\n        )\n    except Exception as exc:  # pragma: no cover — belt-and-suspenders\n        _breadcrumb(\"audit emit failed (%s)\" % str(exc)[:80])\n\n\ndef _write_snapshot(\n    plan_id: str, blob: Dict[str, Any], session_id: Optional[str] = None\n) -> str:\n    \"\"\"Persist the snapshot blob to the plan- or session-scoped scratchpad.\n\n    Returns the closed-enum snapshot_outcome:\n\n      - ``written`` — plan scope resolved, blob written under ``plan_id``;\n      - ``written_session_scope`` — PLAN-179 W1 US3: no plan scope, but the\n        hook input carried a usable session id, so the blob was written under\n        the SESSION store (``scope_kind=\"session\"`` inside the blob; the\n        ``plan_id`` field is left at ``unknown`` — emenda r1-C1 forbids\n        overloading it, the store's plan-isolation invariant depends on it);\n      - ``scratchpad_unavailable`` — a REAL unavailability: the scratchpad_lib\n        import failed, or there is no scope we are allowed to write under\n        (session id absent / malformed / env-sourced ⇒ refused, r1-C1). It no\n        longer means \"the plan was not resolved\" — that case now WRITES;\n      - ``error`` — serialization or the store write itself failed.\n\n    Secrets: the blob is handed to ``store.set`` as a ``str`` on BOTH paths so\n    the store's ``redact_secrets`` pass actually runs (PLAN-179 amendment 8.3\n    / debate C9 — the previous ``payload.encode(\"utf-8\")`` took the bytes\n    branch, which ``state_store`` trusts verbatim, making the documented\n    \"secrets-redacted\" claim false on the only path this hook used).\n    ``set`` overwrites the prior snapshot in either scope.\"\"\"\n    try:\n        from _lib import scratchpad_lib  # noqa: E402\n    except Exception as exc:\n        _breadcrumb(\"scratchpad_lib import failed at write (%s)\" % str(exc)[:60])\n        return \"scratchpad_unavailable\"\n\n    plan_scoped = plan_id != \"unknown\" and plan_id.startswith(\"PLAN-\")\n    if not plan_scoped and not session_id:\n        # No scope we may write under: the plan is unresolved AND the session\n        # id was absent/malformed/env-sourced. The audit event still records\n        # the attempt (PostCompact degrades to snapshot_found=False).\n        _breadcrumb(\"no plan scope and no hook-input session id — write skipped\")\n        return \"scratchpad_unavailable\"\n\n    # scope_kind travels INSIDE the blob (r1-C1) so the PostCompact half can\n    # tell a session-scoped snapshot from a plan-scoped one without guessing.\n    #\n    # PLAN-179 W0/W1 cross-file pass — closes the \"recalled closed set\" defect:\n    # this used to write the literal strings \"plan\"/\"session\". The enum's owner\n    # is scratchpad_lib (SCOPE_KIND_PLAN / SCOPE_KIND_SESSION, validated by\n    # stamp_scope_kind, which RAISES on an off-enum value). Stamping through the\n    # library means a future rename cannot leave this writer emitting a value\n    # the PostCompact reader no longer recognises\n    # ([[feedback-closed-sets-must-be-derived-not-recalled]]).\n    body = dict(blob)\n    try:\n        scope_kind = (\n            scratchpad_lib.SCOPE_KIND_PLAN\n            if plan_scoped\n            else scratchpad_lib.SCOPE_KIND_SESSION\n        )\n        scratchpad_lib.stamp_scope_kind(body, scope_kind)\n    except Exception as exc:\n        # AttributeError = an adopter on a pre-PLAN-179 scratchpad_lib (the only\n        # genuine cross-version case); ValueError = an off-enum scope_kind, which\n        # would be a bug in THIS file. Either way the snapshot is still worth\n        # writing, but it MUST carry the field the PostCompact reader keys on —\n        # so fall back to the literal and say loudly that the library did not\n        # own the enum on this run.\n        _breadcrumb(\n            \"scratchpad_lib scope-kind API unavailable/refused (%s) — \"\n            \"stamping scope_kind inline; expected the library to own this enum\"\n            % str(exc)[:60]\n        )\n        body[\"scope_kind\"] = \"plan\" if plan_scoped else \"session\"\n    # Rail round-8 [P1]: redaction is a FIELD-level duty here, not a\n    # store-level one. `state_store.set` runs `redact_secrets` over str\n    # values, and its kv pattern (`token=\\S{1,2048}`) is JSON-blind: on a\n    # serialized snapshot whose field ends in assignment-shaped text\n    # (`deploy token=abc`) it consumes the closing quote/comma and stores\n    # MALFORMED JSON — PostCompact parses nothing and the continuity cure\n    # dies silently for exactly the secrets it must survive. So every str\n    # field is redacted BEFORE serialization (max_chars=0, no truncation)\n    # and the store receives BYTES — its documented \"caller owns the\n    # content\" route (amendment 8.3's redaction CLAIM stays true; only the\n    # layer that fulfils it moved). If the redactor is unavailable, fall\n    # back to the old str path: the store's pass still guarantees nothing\n    # unredacted lands on disk (the residual cost is the corruption this\n    # cure removes — never a secret).\n    try:\n        from _lib.redact import redact_secrets as _redact_fn\n    except Exception:\n        _redact_fn = None\n    if _redact_fn is not None:\n        def _redact_tree(node):\n            if isinstance(node, str):\n                return _redact_fn(node, max_chars=0)\n            if isinstance(node, dict):\n                return {k: _redact_tree(v) for k, v in node.items()}\n            if isinstance(node, list):\n                return [_redact_tree(v) for v in node]\n            return node\n        try:\n            body = _redact_tree(body)\n        except Exception as exc:\n            _breadcrumb(\"snapshot field redaction failed (%s)\" % str(exc)[:60])\n            _redact_fn = None\n\n    try:\n        payload = json.dumps(body, ensure_ascii=False, sort_keys=True)\n    except (TypeError, ValueError) as exc:\n        _breadcrumb(\"snapshot serialize failed (%s)\" % str(exc)[:60])\n        return \"error\"\n    store_value = (\n        payload.encode(\"utf-8\") if _redact_fn is not None else payload\n    )\n\n    try:\n        if plan_scoped:\n            with scratchpad_lib.open_scratchpad(plan_id=plan_id) as store:\n                store.set(SCRATCHPAD_KEY, store_value)\n            return \"written\"\n        with scratchpad_lib.open_session_scratchpad(session_id) as store:\n            # Explicit ttl (emenda r1-C2): session scopes are per-session and\n            # would otherwise accumulate forever.\n            #\n            # PLAN-179 W0/W1 cross-file pass: routed through the library's\n            # `set_session_value` rather than `store.set(..., ttl_seconds=...)`.\n            # That helper is where r1-C2 made the positive TTL MECHANICAL — it\n            # RAISES on a None/non-positive ttl instead of silently writing a\n            # never-expiring row, which is precisely the accumulation bug the\n            # amendment named. Calling store.set directly bypassed the guard the\n            # library exists to provide.\n            scratchpad_lib.set_session_value(\n                store, SCRATCHPAD_KEY, store_value,\n                ttl_seconds=SESSION_SNAPSHOT_TTL_S,\n            )\n        return \"written_session_scope\"\n    except Exception as exc:\n        _breadcrumb(\"scratchpad write failed (%s)\" % str(exc)[:80])\n        return \"error\"\n\n\ndef _gc_session_stores(deadline: float) -> None:\n    \"\"\"Reclaim aged-out session-store FILES. Never affects the snapshot.\n\n    PLAN-179 rail finding C (round-1 REJECT): ``gc_orphan_session_stores`` had\n    no production caller anywhere in the tree, so the W1 US3 session-scope\n    fallback accumulated one ``session-<uuid>.sqlite`` (+ ``.lock`` / WAL /\n    SHM) per unresolved-plan session with nothing to reclaim it — row TTL\n    expiry cannot unlink a file. This is that caller.\n\n    Three properties, in the order they matter:\n\n    1. **Fail-OPEN, always.** Import failure, a missing symbol on a\n       pre-PLAN-179 adopter, any exception out of the sweep: breadcrumb and\n       return. The snapshot above it has already been written and its outcome\n       is already on the wire — housekeeping may not retro-actively change it.\n    2. **Cheap and bounded.** PreCompact fires at most once per compaction, so\n       no extra throttle is invented here (a timestamp file would be a second\n       piece of state to get wrong). The work is one directory listing plus at\n       most ``MAX_GC_FILES_PER_RUN`` unlinks — the cap is the LIBRARY's, not\n       a number recalled here\n       ([[feedback-closed-sets-must-be-derived-not-recalled]]). The remaining\n       budget is honoured: a run that already blew ``TIME_BUDGET_S`` skips the\n       sweep rather than adding to the overrun.\n    3. **TTL matched to what this hook WRITES.** ``ttl_seconds`` is passed\n       explicitly as :data:`SESSION_SNAPSHOT_TTL_S` (7 days) because the\n       library default is 72h, and a 72h mtime cutoff would unlink a store\n       whose rows this hook wrote with a 7-day TTL — deleting a snapshot that\n       is still live. The GC threshold must never be shorter than the write\n       TTL it collects behind.\"\"\"\n    if time.monotonic() > deadline:\n        _breadcrumb(\"time budget spent — session-store GC skipped this run\")\n        return\n    try:\n        from _lib import scratchpad_lib  # noqa: E402\n    except Exception as exc:\n        _breadcrumb(\"scratchpad_lib import failed at GC (%s)\" % str(exc)[:60])\n        return\n    gc = getattr(scratchpad_lib, \"gc_orphan_session_stores\", None)\n    if gc is None:\n        _breadcrumb(\n            \"scratchpad_lib.gc_orphan_session_stores missing — this build \"\n            \"predates PLAN-179 W1 US3; session-store GC skipped\"\n        )\n        return\n    try:\n        removed = gc(ttl_seconds=SESSION_SNAPSHOT_TTL_S)\n    except Exception as exc:\n        # The helper documents itself as fail-open, so an exception here is a\n        # genuine surprise — still swallowed: this runs AFTER the snapshot.\n        _breadcrumb(\"session-store GC failed (%s) — ignored\" % str(exc)[:80])\n        return\n    if removed:\n        _breadcrumb(\"session-store GC unlinked %d aged-out file(s)\" % removed)\n","numLines":507,"startLine":1,"totalLines":507}},"tool_result_meta":[{"id":"toolu_01Ccw3zUbLwV2vfYrLGbsaRi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
