{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QaobZEVJV7YCQEfvXCpD92","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\tfrom ._shared import *\n3\t\n4\tdef _resolve_codex_cli_shape():  # type: ignore[no-untyped-def]\n5\t    \"\"\"Resolve the NEW non-kernel `_lib.codex_cli_shape` module.\n6\t\n7\t    Mirrors the canonical-layout resolution used elsewhere: the\n8\t    `.claude/hooks/` dir that houses this file also houses `_lib/`. Returns\n9\t    the module or None (fail-OPEN — the caller treats None as\n10\t    CodexUnavailable, the ADR-106 fail-open path). NEVER raises.\n11\t    \"\"\"\n12\t    try:\n13\t        hooks_dir = Path(__file__).resolve().parent\n14\t        if str(hooks_dir) not in sys.path:\n15\t            sys.path.insert(0, str(hooks_dir))\n16\t        from _lib import codex_cli_shape as _shape  # type: ignore\n17\t        return _shape\n18\t    except Exception:\n19\t        return None\n20\t\n21\t# QDSAA-FUNCAO-LONGA: ciclo do subprocesso, arquivo seguro e limpeza permanecem atômicos para não abrir TOCTOU no payload.\n22\tdef _invoke_codex_review(\n23\t    tool_name: str,\n24\t    file_path: str,\n25\t    proposed_content: str,\n26\t    timeout_s: float,\n27\t) -> str:\n28\t    \"\"\"Invoke Codex review on codex-cli 0.139.0; return the REDACTED\n29\t    last-message file content (one structured JSON object) as a str.\n30\t\n31\t    PLAN-142: the verdict is obtained by having the CLI write ONLY the final\n32\t    agent message to a private output file (verified on 0.139: a one-line\n33\t    JSON object). ALL flag-shape lives in the NON-kernel\n34\t    ``_lib.codex_cli_shape`` helper (D2); this kernel function constructs NO\n35\t    argv literals.\n36\t\n37\t    Signature contract UNCHANGED for the consumer: returns a single str.\n38\t    But it is now the isolated last agent message (one structured object),\n39\t    ALREADY single-pass redacted (R-SEC-1 — redaction at the lowest-trust\n40\t    file-read site, before any json.loads in the consumer).\n41\t\n42\t    No env-fixture path (PLAN-163 FXα): the former\n43\t    `CEO_PAIR_RAIL_FIXTURE_RESPONSE` short-circuit was REMOVED from\n44\t    production. Pin verification via `_resolve_codex_bin()` is now\n45\t    UNCONDITIONAL — no env can preset a review or skip the ADR-182 sha\n46\t    gate. Tests inject a Codex review by mocking THIS function at the\n47\t    invoke boundary (`mock.patch.object(<mod>, \"_invoke_codex_review\",\n48\t    return_value=<review>)`); the sha gate is covered directly in\n49\t    `test_check_pair_rail_payload_pin.py`.\n50\t\n51\t    tmpfile TOCTOU hygiene (R-SEC-4 / R-VP-E): a private `mkdtemp(0o700)`\n52\t    dir per call; the output file is pre-created O_CREAT|O_EXCL|0o600 at an\n53\t    absolute path; after the run we REFUSE to read if it is a symlink / not\n54\t    a regular file / not owned by us; `finally:` unlink (output + schema) +\n55\t    rmdir on EVERY exit path (success, read error, timeout, exception).\n56\t\n57\t    Degradation matrix → CodexUnavailable / CodexTimeout / CodexMalformed\n58\t    (all map to ADVISORY in `_decide`), NEVER raise past the typed wall:\n59\t      helper/binary missing, spawn error, non-zero exit → CodexUnavailable;\n60\t      timeout → CodexTimeout; output file missing-after-exit-0 / symlink /\n61\t      non-regular / not-owned / empty / oversize → CodexMalformed.\n62\t\n63\t    ADR-182 (PLAN-163 T5.2) verify-then-invoke: `_resolve_codex_bin()`\n64\t    now returns the VERIFIED native payload path (sha256 checked against\n65\t    the pin manifest) and the subprocess argv below execs EXACTLY that\n66\t    path — the artifact that was hashed is the artifact that runs.\n67\t\n68\t    Raises:\n69\t        CodexUnavailable, CodexTimeout, CodexMalformed (all consumed as\n70\t        ADVISORY fail-open by `_decide`);\n71\t        CodexPinMismatch (ADR-182 fail-CLOSED — consumed as a BLOCK by\n72\t        `_decide`, never advisory).\n73\t    \"\"\"\n74\t    import os as _os  # local alias to avoid any chance of shadowing\n75\t    import stat as _stat\n76\t    import tempfile as _tempfile\n77\t\n78\t    # PLAN-163 FXα: the CEO_PAIR_RAIL_FIXTURE_RESPONSE short-circuit was\n79\t    # REMOVED from production entirely. Pin verification is now\n80\t    # UNCONDITIONAL — no env (test-mode or otherwise) injects a preset\n81\t    # review before _resolve_codex_bin(), so \"no env relaxes the sha\n82\t    # verification\" is literally true. Tests inject a Codex review by\n83\t    # mocking THIS function (_invoke_codex_review) at the invoke boundary,\n84\t    # never via env; the ADR-182 sha gate is exercised directly in\n85\t    # test_check_pair_rail_payload_pin.py.\n86\t\n87\t    # ADR-182: may raise CodexPinMismatch (fail-CLOSED) — deliberately\n88\t    # NOT caught here; `_decide` maps it to `{decision: block}`.\n89\t    codex_bin = _resolve_codex_bin()\n90\t    if codex_bin is None:\n91\t        raise CodexUnavailable(\n92\t            \"codex binary not on PATH (or ADR-182 pin verification \"\n93\t            \"hit an INFRA arm — see pair_rail_codex_unavailable audit)\"\n94\t        )\n95\t\n96\t    shape = _resolve_codex_cli_shape()\n97\t    if shape is None:\n98\t        # The single argv builder is gone/unimportable. Fail-OPEN to\n99\t        # ADVISORY rather than hand-roll a (possibly rejected) argv.\n100\t        raise CodexUnavailable(\"codex_cli_shape helper unavailable\")\n101\t\n102\t    prompt = _build_codex_prompt(tool_name, file_path, proposed_content)\n103\t    # PLAN-084 Wave 0.5 (ADR-114 + AC9 — Codex egress redaction symmetry).\n104\t    # proposed_content is raw FILE CONTENT being reviewed (potentially\n105\t    # secret-laden source). Redact the OUTGOING prompt BEFORE it leaves the\n106\t    # framework. This stays fail-CLOSED per ADR-114: a redactor-import\n107\t    # failure REFUSES to ship the prompt.\n108\t    try:\n109\t        from _lib import codex_egress_redact as _redact\n110\t        _egress_bytes = len(prompt.encode(\"utf-8\", \"replace\")) if isinstance(prompt, str) else 0\n111\t        prompt, _egress_findings = _redact.redact_outgoing_with_findings(prompt)\n112\t    except ImportError:\n113\t        # Fail-CLOSED per ADR-114: refuse to ship unredacted prompt to Codex.\n114\t        raise CodexUnavailable(\"codex_egress_redact unavailable — fail-CLOSED per ADR-114\")\n115\t    # PLAN-112-FOLLOWUP-codex-egress-proof-telemetry (F-7.9): positive-proof\n116\t    # emit on EVERY outbound redaction (empty allowed). Fail-OPEN — wraps ONLY\n117\t    # the emit; the redact above stays fail-CLOSED per ADR-114.\n118\t    try:\n119\t        from _lib import audit_emit as _ae\n120\t        _ae.emit_pair_rail_outgoing_redaction_applied(\n121\t            signal=\"outbound\",\n122\t            match_count=len(_egress_findings),\n123\t            bytes_scanned=_egress_bytes,\n124\t            callsite=\"check_pair_rail.py:_invoke_codex_review\",\n125\t            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n126\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n127\t        )\n128\t    except Exception:\n129\t        pass\n130\t\n131\t    # -----------------------------------------------------------------\n132\t    # tmpfile setup — we own the dir (0o700) and pre-create the output\n133\t    # file with O_EXCL|0o600 to win the symlink race; the CLI writes to it\n134\t    # by absolute path. A sibling schema file (written by US, not the\n135\t    # untrusted binary) carries the CLI-enforced verdict shape.\n136\t    # -----------------------------------------------------------------\n137\t    tmp_dir = _tempfile.mkdtemp(prefix=\"ceo_pairrail_\")\n138\t    try:\n139\t        _os.chmod(tmp_dir, 0o700)\n140\t    except OSError:\n141\t        pass  # mkdtemp already creates 0o700 on POSIX\n142\t    out_path = _os.path.join(tmp_dir, \"codex_last_message.json\")\n143\t    schema_path = _os.path.join(tmp_dir, \"codex_verdict_schema.json\")\n144\t\n145\t    def _cleanup() -> None:\n146\t        \"\"\"Unlink both tmpfiles + rmdir the dir; never raises.\"\"\"\n147\t        for _p in (out_path, schema_path):\n148\t            try:\n149\t                _os.unlink(_p)\n150\t            except OSError:\n151\t                pass\n152\t        try:\n153\t            _os.rmdir(tmp_dir)\n154\t        except OSError:\n155\t            pass\n156\t\n157\t    try:\n158\t        # Pre-create O_CREAT|O_EXCL|0o600 — if a symlink/file already sits\n159\t        # at out_path, O_EXCL fails and we treat it as unavailable.\n160\t        try:\n161\t            fd = _os.open(out_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n162\t            _os.close(fd)\n163\t        except FileNotFoundError:\n164\t            raise CodexUnavailable(\"tmpdir vanished before pre-create\")\n165\t        except FileExistsError:\n166\t            raise CodexUnavailable(\"tmpfile pre-create lost O_EXCL race\")\n167\t        except OSError as e:\n168\t            raise CodexUnavailable(f\"tmpfile pre-create failed: {type(e).__name__}\")\n169\t\n170\t        # Write the CLI-enforced verdict schema to our schema tmpfile\n171\t        # (PLAN-142 §3 [P1], R-SEC-2). Best-effort: if the helper cannot\n172\t        # serialize it, proceed WITHOUT enforcement (parser-side\n173\t        # parse_verdict_strict still validates the shape).\n174\t        schema_arg: Optional[str] = None\n175\t        try:\n176\t            schema_json = shape.verdict_output_schema_json()\n177\t            sfd = _os.open(schema_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n178\t            try:\n179\t                _os.write(sfd, schema_json.encode(\"utf-8\"))\n180\t            finally:\n181\t                _os.close(sfd)\n182\t            schema_arg = schema_path\n183\t        except Exception:\n184\t            schema_arg = None\n185\t\n186\t        # Build argv via the NON-kernel helper. The live-rail shape writes\n187\t        # the verdict to our output file and drops usage telemetry (R-SEC-5);\n188\t        # we pass only semantic intent — the helper owns flag names, the\n189\t        # model id, and the dead-flag migration.\n190\t        try:\n191\t            cli_args = shape.build_verdict_argv(\n192\t                prompt,\n193\t                output_file=out_path,\n194\t                schema_file=schema_arg,\n195\t            )\n196\t        except Exception as e:\n197\t            raise CodexUnavailable(\n198\t                f\"codex_cli_shape.build_verdict_argv failed: {type(e).__name__}\"\n199\t            )\n200\t        if not isinstance(cli_args, (list, tuple)) or not cli_args:\n201\t            raise CodexUnavailable(\"codex_cli_shape returned empty argv\")\n202\t\n203\t        # ADR-182 verify-then-invoke: `codex_bin` is the VERIFIED native\n204\t        # payload path returned by `_resolve_codex_bin()` (or the\n205\t        # test-only CEO_PAIR_RAIL_CODEX_BIN override). Invoking the\n206\t        # exact verified path — not `codex` re-resolved from $PATH —\n207\t        # closes the hash-launcher/execute-payload gap of the retired\n208\t        # codex-cli-binary-sha256.txt pin.\n209\t        cmd = [codex_bin] + list(cli_args)\n210\t\n211\t        # Invoke. The prompt is the trailing positional built by the helper;\n212\t        # close stdin via input=\"\" so the child never blocks on a pipe.\n213\t        try:\n214\t            proc = subprocess.run(\n215\t                cmd,\n216\t                input=\"\",\n217\t                capture_output=True,\n218\t                text=True,\n219\t                timeout=timeout_s,\n220\t                check=False,\n221\t            )\n222\t        except subprocess.TimeoutExpired:\n223\t            raise CodexTimeout(f\"codex invoke exceeded {timeout_s}s\")\n224\t        except (FileNotFoundError, PermissionError, OSError, ConnectionError) as e:\n225\t            raise CodexUnavailable(f\"codex invoke failed: {type(e).__name__}: {e}\")\n226\t        except ValueError as e:\n227\t            # UnicodeDecodeError IS-A ValueError; map to malformed so\n228\t            # `_decide` degrades to ADVISORY (preserve concrete name).\n229\t            raise CodexMalformed(f\"codex invoke {type(e).__name__}: {e}\")\n230\t\n231\t        # Post-subprocess audit breadcrumb (UNCHANGED behavior).\n232\t        try:\n233\t            from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n234\t            if hasattr(_ae, \"emit_generic\"):\n235\t                _ae.emit_generic(\"codex_invoke_dispatched\", exit_code=int(proc.returncode))\n236\t        except Exception:\n237\t            pass\n238\t\n239\t        if proc.returncode != 0:\n240\t            # Non-zero exit → unavailable (fail-OPEN). A present output file\n241\t            # after a non-zero exit is IGNORED (not read) and cleaned up.\n242\t            raise CodexUnavailable(\n243\t                f\"codex returned exit={proc.returncode}; stderr_head=\"\n244\t                f\"{(proc.stderr or '')[:240]!r}\"\n245\t            )\n246\t\n247\t        # -------------------------------------------------------------\n248\t        # Read back the output file with TOCTOU re-validation. Re-stat via\n249\t        # os.lstat (NOT following symlinks) and refuse anything that is not\n250\t        # a regular file we own.\n251\t        # -------------------------------------------------------------\n252\t        try:\n253\t            st = _os.lstat(out_path)\n254\t        except FileNotFoundError:\n255\t            raise CodexMalformed(\"codex last-message file missing after exit-0\")\n256\t        except OSError as e:\n257\t            raise CodexMalformed(f\"codex last-message lstat failed: {type(e).__name__}\")\n258\t\n259\t        if _stat.S_ISLNK(st.st_mode):\n260\t            raise CodexMalformed(\"codex last-message path is a symlink; refusing to read\")\n261\t        if not _stat.S_ISREG(st.st_mode):\n262\t            raise CodexMalformed(\"codex last-message path is not a regular file; refusing\")\n263\t        try:\n264\t            if st.st_uid != _os.getuid():\n265\t                raise CodexMalformed(\"codex last-message file not owned by us; refusing\")\n266\t        except AttributeError:\n267\t            # os.getuid absent (non-POSIX) — the 0o700 mkdtemp + O_EXCL\n268\t            # pre-create are the primary controls; skip the uid check.\n269\t            pass\n270\t        if st.st_size == 0:\n271\t            raise CodexMalformed(\"codex last-message file is empty\")\n272\t        if st.st_size > _MAX_OUTPUT_FILE_BYTES:\n273\t            raise CodexMalformed(\n274\t                f\"codex last-message oversize ({st.st_size} > {_MAX_OUTPUT_FILE_BYTES})\"\n275\t            )\n276\t\n277\t        # Open refusing to follow a symlink swapped in post-lstat.\n278\t        try:\n279\t            open_flags = _os.O_RDONLY\n280\t            if hasattr(_os, \"O_NOFOLLOW\"):\n281\t                open_flags |= _os.O_NOFOLLOW\n282\t            rfd = _os.open(out_path, open_flags)\n283\t        except OSError as e:\n284\t            raise CodexMalformed(f\"codex last-message open failed: {type(e).__name__}\")\n285\t        try:\n286\t            raw_bytes = _os.read(rfd, _MAX_OUTPUT_FILE_BYTES + 1)\n287\t        finally:\n288\t            try:\n289\t                _os.close(rfd)\n290\t            except OSError:\n291\t                pass\n292\t        if len(raw_bytes) > _MAX_OUTPUT_FILE_BYTES:\n293\t            raise CodexMalformed(\"codex last-message grew past cap during read\")\n294\t\n295\t        content = raw_bytes.decode(\"utf-8\", errors=\"replace\")\n296\t\n297\t        # -------------------------------------------------------------\n298\t        # SINGLE-PASS redact the FULL byte-string BEFORE returning (and\n299\t        # thus before any json.loads in the consumer). R-SEC-1. Ingress\n300\t        # redaction is fail-OPEN to ADVISORY (distinct from the ADR-114\n301\t        # fail-CLOSED *egress* contract above): if the redactor is\n302\t        # unavailable we refuse to hand un-redacted text to the parser and\n303\t        # degrade to ADVISORY via CodexMalformed.\n304\t        # -------------------------------------------------------------\n305\t        try:\n306\t            from _lib import codex_egress_redact as _redact  # noqa: F811\n307\t            redacted = _redact.redact(content)\n308\t        except Exception:\n309\t            raise CodexMalformed(\n310\t                \"codex_egress_redact unavailable on ingress; refusing raw parse\"\n311\t            )\n312\t        return redacted\n313\t    finally:\n314\t        _cleanup()\n315\t\n316\tdef _sentinel_grants_pair_rail_bypass(\n317\t    file_path: str, repo_root: Path\n318\t) -> bool:\n319\t    \"\"\"True if any Architect sentinel covers `file_path` in its scope.\n320\t\n321\t    Production: piggybacks on `check_canonical_edit._sentinel_grants_path`\n322\t    if that helper is importable. Otherwise returns False (no bypass).\n323\t    \"\"\"\n324\t    try:\n325\t        # Best-effort import; staging file should not depend on\n326\t        # production import path. Fail soft.\n327\t        hooks_dir = repo_root / \".claude\" / \"hooks\"\n328\t        if str(hooks_dir) not in sys.path:\n329\t            sys.path.insert(0, str(hooks_dir))\n330\t        try:\n331\t            import check_canonical_edit as _cce  # type: ignore\n332\t        except Exception:\n333\t            return False\n334\t        try:\n335\t            rel = (\n336\t                Path(file_path).resolve().relative_to(repo_root.resolve())\n337\t            )\n338\t        except (ValueError, OSError):\n339\t            return False\n340\t        rel_str = str(rel).replace(os.sep, \"/\")\n341\t        sentinels = _cce._find_sentinels(repo_root)  # type: ignore[attr-defined]\n342\t        for sentinel in sentinels:\n343\t            try:\n344\t                if _cce._sentinel_grants_path(sentinel, rel_str):  # type: ignore[attr-defined]\n345\t                    return True\n346\t            except Exception:\n347\t                continue\n348\t        return False\n349\t    except Exception:\n350\t        return False\n351\t\n352\t_AUDIT_REVIEW_PASSED = \"pair_rail_review_passed\"\n353\t\n354\t_AUDIT_CODEX_VIOLATION = \"pair_rail_codex_violation\"\n355\t\n356\t_AUDIT_CODEX_UNAVAILABLE = \"pair_rail_codex_unavailable\"\n357\t\n358\t_AUDIT_SENTINEL_BYPASS = \"pair_rail_sentinel_bypass\"\n359\t\n360\t_AUDIT_OUT_OF_SCOPE = \"pair_rail_out_of_scope\"\n361\t\n362\t_AUDIT_KILL_SWITCH = \"pair_rail_kill_switch_used\"\n363\t\n364\t_AUDIT_PIN_MISMATCH = \"pair_rail_codex_pin_mismatch\"\n365\t\n366\t_AUDIT_FATAL_FAILOPEN = \"pair_rail_fatal_failopen\"\n367\t\n368\tdef _emit_audit(action: str, **fields: Any) -> None:\n369\t    \"\"\"Best-effort audit. Production fallback: stderr breadcrumb when no audit sink configured.\n370\t\n371\t    Phase 1 wires through `_lib/audit_emit.emit_generic` after\n372\t    register-ceremony lands the action labels in `_KNOWN_ACTIONS`.\n373\t    \"\"\"\n374\t    # Test capture hook: env-controlled file sink for unit tests.\n375\t    sink = os.environ.get(\"CEO_PAIR_RAIL_AUDIT_SINK\")\n376\t    if sink:\n377\t        try:\n378\t            event = {\"action\": action, **fields}\n379\t            with open(sink, \"a\", encoding=\"utf-8\") as f:\n380\t                f.write(json.dumps(event, ensure_ascii=False) + \"\\n\")\n381\t        except Exception:\n382\t            pass  # advisory; never blocks\n383\t    # Stderr breadcrumb (spike — visible in test output).\n384\t    try:\n385\t        preview = \", \".join(\n386\t            f\"{k}={v!r}\" for k, v in list(fields.items())[:5]\n387\t        )\n388\t        sys.stderr.write(\n389\t            f\"[check_pair_rail SPIKE] {action} {preview}\\n\"\n390\t        )\n391\t    except Exception:\n392\t        pass\n393\t\n394\tdef _emit_codex_review_invoked(review_text: str, grammar: \"Optional[str]\") -> None:\n395\t    \"\"\"Emit codex_review_invoked for a completed Codex review (best-effort).\n396\t\n397\t    ``grammar`` is the write-shaped-patch verdict from ``_detect_write_shaped_patch``\n398\t    (``None`` == clean/passed; non-``None`` == a flagged violation/failed). We feed\n399\t    the review through the WS-3 driver (the single redaction source) so the raw\n400\t    text is hashed, never echoed, then route the redacted PhaseReview fields\n401\t    through ``optimizer._skeleton.safe_emit`` (silent until the action registers).\n402\t    \"\"\"\n403\t    try:\n404\t        repo_root = Path(__file__).resolve().parents[2]\n405\t        scripts_dir = str((repo_root / \".claude\" / \"scripts\").resolve())\n406\t        if scripts_dir not in sys.path:\n407\t            sys.path.insert(0, scripts_dir)\n408\t        from optimizer import codex_phase_gate as _pg  # type: ignore[import]\n409\t        from optimizer import _skeleton as _sk  # type: ignore[import]\n410\t\n411\t        # Map the already-obtained review into a driver result. We INJECT a\n412\t        # closure returning that result so review_phase does the verdict\n413\t        # classification + redaction (status, violation-count normalisation,\n414\t        # thread/summary hashing) — we never re-implement that boundary here.\n415\t        # The kill-switch is intentionally bypassed: we only reach this site\n416\t        # AFTER a real invocation completed, so we drive review_phase with\n417\t        # CEO_CODEX_REVIEW unset semantics via a direct injected result.\n418\t        verdict = \"block\" if grammar is not None else \"accept\"\n419\t        injected = {\n420\t            \"status\": verdict,\n421\t            \"summary\": review_text if isinstance(review_text, str) else \"\",\n422\t        }\n423\t        review = _pg.review_phase(\n424\t            0, \"\", codex_invoke=lambda _p, _m: injected,\n425\t        )\n426\t        # review_disabled_signal is NOT forwarded — it routes the disabled\n427\t        # sibling instead; forwarding a bool would break canonical-json/HMAC.\n428\t        _sk.safe_emit(\n429\t            \"codex_review_invoked\",\n430\t            repo_root=repo_root,\n431\t            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n432\t            phase_number=review.phase_number,\n433\t            review_status=review.review_status,\n434\t            summary_hash=review.summary_hash,\n435\t            thread_id_redacted=review.thread_id_redacted,\n436\t            codex_model=review.codex_model,\n437\t            duration_ms=review.duration_ms,\n438\t            violations_found_count=review.violations_found_count,\n439\t        )\n440\t    except Exception:\n441\t        # FAIL-CLOSED on the emit only — an audit-emit failure must NEVER block\n442\t        # or crash the Pair-Rail hook (ADR-005 never-blocks), and must NEVER\n443\t        # launder unredacted text (we simply emit nothing on any error).\n444\t        return\n445\t\n446\tdef _load_codex_adapter():  # type: ignore[no-untyped-def]\n447\t    \"\"\"Resolve `_lib.adapters.codex` (the structured-verdict parser).\n448\t\n449\t    Same canonical-layout resolution as the other `_lib` loaders. Returns\n450\t    the module or None (fail-OPEN — caller degrades to ADVISORY). NEVER\n451\t    raises.\n452\t    \"\"\"\n453\t    try:\n454\t        hooks_dir = Path(__file__).resolve().parent\n455\t        if str(hooks_dir) not in sys.path:\n456\t            sys.path.insert(0, str(hooks_dir))\n457\t        from _lib.adapters import codex as _codex  # type: ignore\n458\t        return _codex\n459\t    except Exception:\n460\t        return None\n461\t\n462\t_VALID_VERDICTS_LOCAL: Tuple[str, ...] = (\"PASS\", \"ADVISORY\", \"BLOCK\")\n463\t\n464\tdef _consume_codex_review(redacted_review: str) -> Tuple[str, Optional[str]]:\n465\t    \"\"\"Derive (verdict, secondary_patch_grammar) from a REDACTED review.\n466\t\n467\t    PRIMARY signal (D3): `parse_verdict_strict` — the verdict is accepted\n468\t    ONLY from a structured, schema-validated object (verdict ∈\n469\t    `_VALID_VERDICTS_LOCAL`). A forged free-text 'PASS' with no structured\n470\t    object → ADVISORY (fail-CLOSED-to-ADVISORY per R-SEC-2 / ADR-106).\n471\t\n472\t    SECONDARY signal (D3): `_detect_write_shaped_patch` runs on the SAME\n473\t    redacted text as defense-in-depth annotation ONLY — it never upgrades a\n474\t    verdict to a hard block; the structured verdict is authoritative.\n475\t\n476\t    Returns (verdict, patch_grammar) where verdict ∈ {\"PASS\",\"ADVISORY\",\n477\t    \"BLOCK\"} and patch_grammar is the `_detect_write_shaped_patch` tag (or\n478\t    None). NEVER raises.\n479\t    \"\"\"\n480\t    # Secondary defense-in-depth scan (advisory annotation only).\n481\t    try:\n482\t        patch_grammar = _detect_write_shaped_patch(redacted_review)\n483\t    except Exception:\n484\t        patch_grammar = None\n485\t\n486\t    codex = _load_codex_adapter()\n487\t    if codex is None:\n488\t        # Adapter unimportable — fail-CLOSED-to-ADVISORY (cannot validate a\n489\t        # structured verdict, so we do not trust one).\n490\t        return \"ADVISORY\", patch_grammar\n491\t\n492\t    # parse_verdict_strict is fail-CLOSED-to-ADVISORY and never raises, but\n493\t    # wrap defensively anyway and coerce any surprise to ADVISORY. We do NOT\n494\t    # fall back to the free-text patch scan as the verdict — it stays SECONDARY.\n495\t    try:\n496\t        envelope = codex.parse_verdict_strict(redacted_review)\n497\t        verdict = envelope.get(\"verdict\")\n498\t        if verdict not in _VALID_VERDICTS_LOCAL:\n499\t            return \"ADVISORY\", patch_grammar\n500\t        return str(verdict), patch_grammar\n501\t    except Exception:\n502\t        return \"ADVISORY\", patch_grammar\n503\t\n504\t_CURRENT_REVIEW_ID: str = \"\"\n505\t\n506\t__all__ = (\n507\t    '_resolve_codex_cli_shape',\n508\t    '_invoke_codex_review',\n509\t    '_sentinel_grants_pair_rail_bypass',\n510\t    '_AUDIT_REVIEW_PASSED',\n511\t    '_AUDIT_CODEX_VIOLATION',\n512\t    '_AUDIT_CODEX_UNAVAILABLE',\n513\t    '_AUDIT_SENTINEL_BYPASS',\n514\t    '_AUDIT_OUT_OF_SCOPE',\n515\t    '_AUDIT_KILL_SWITCH',\n516\t    '_AUDIT_PIN_MISMATCH',\n517\t    '_AUDIT_FATAL_FAILOPEN',\n518\t    '_emit_audit',\n519\t    '_emit_codex_review_invoked',\n520\t    '_load_codex_adapter',\n521\t    '_VALID_VERDICTS_LOCAL',\n522\t    '_consume_codex_review',\n523\t    '_CURRENT_REVIEW_ID',\n524\t)\n525\t"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"a72603d3-90df-4d34-acd2-78e68f62fd3c","timestamp":"2026-11-13T18:10:55.825Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_02.py","content":"from __future__ import annotations\nfrom ._shared import *\n\ndef _resolve_codex_cli_shape():  # type: ignore[no-untyped-def]\n    \"\"\"Resolve the NEW non-kernel `_lib.codex_cli_shape` module.\n\n    Mirrors the canonical-layout resolution used elsewhere: the\n    `.claude/hooks/` dir that houses this file also houses `_lib/`. Returns\n    the module or None (fail-OPEN — the caller treats None as\n    CodexUnavailable, the ADR-106 fail-open path). NEVER raises.\n    \"\"\"\n    try:\n        hooks_dir = Path(__file__).resolve().parent\n        if str(hooks_dir) not in sys.path:\n            sys.path.insert(0, str(hooks_dir))\n        from _lib import codex_cli_shape as _shape  # type: ignore\n        return _shape\n    except Exception:\n        return None\n\n# QDSAA-FUNCAO-LONGA: ciclo do subprocesso, arquivo seguro e limpeza permanecem atômicos para não abrir TOCTOU no payload.\ndef _invoke_codex_review(\n    tool_name: str,\n    file_path: str,\n    proposed_content: str,\n    timeout_s: float,\n) -> str:\n    \"\"\"Invoke Codex review on codex-cli 0.139.0; return the REDACTED\n    last-message file content (one structured JSON object) as a str.\n\n    PLAN-142: the verdict is obtained by having the CLI write ONLY the final\n    agent message to a private output file (verified on 0.139: a one-line\n    JSON object). ALL flag-shape lives in the NON-kernel\n    ``_lib.codex_cli_shape`` helper (D2); this kernel function constructs NO\n    argv literals.\n\n    Signature contract UNCHANGED for the consumer: returns a single str.\n    But it is now the isolated last agent message (one structured object),\n    ALREADY single-pass redacted (R-SEC-1 — redaction at the lowest-trust\n    file-read site, before any json.loads in the consumer).\n\n    No env-fixture path (PLAN-163 FXα): the former\n    `CEO_PAIR_RAIL_FIXTURE_RESPONSE` short-circuit was REMOVED from\n    production. Pin verification via `_resolve_codex_bin()` is now\n    UNCONDITIONAL — no env can preset a review or skip the ADR-182 sha\n    gate. Tests inject a Codex review by mocking THIS function at the\n    invoke boundary (`mock.patch.object(<mod>, \"_invoke_codex_review\",\n    return_value=<review>)`); the sha gate is covered directly in\n    `test_check_pair_rail_payload_pin.py`.\n\n    tmpfile TOCTOU hygiene (R-SEC-4 / R-VP-E): a private `mkdtemp(0o700)`\n    dir per call; the output file is pre-created O_CREAT|O_EXCL|0o600 at an\n    absolute path; after the run we REFUSE to read if it is a symlink / not\n    a regular file / not owned by us; `finally:` unlink (output + schema) +\n    rmdir on EVERY exit path (success, read error, timeout, exception).\n\n    Degradation matrix → CodexUnavailable / CodexTimeout / CodexMalformed\n    (all map to ADVISORY in `_decide`), NEVER raise past the typed wall:\n      helper/binary missing, spawn error, non-zero exit → CodexUnavailable;\n      timeout → CodexTimeout; output file missing-after-exit-0 / symlink /\n      non-regular / not-owned / empty / oversize → CodexMalformed.\n\n    ADR-182 (PLAN-163 T5.2) verify-then-invoke: `_resolve_codex_bin()`\n    now returns the VERIFIED native payload path (sha256 checked against\n    the pin manifest) and the subprocess argv below execs EXACTLY that\n    path — the artifact that was hashed is the artifact that runs.\n\n    Raises:\n        CodexUnavailable, CodexTimeout, CodexMalformed (all consumed as\n        ADVISORY fail-open by `_decide`);\n        CodexPinMismatch (ADR-182 fail-CLOSED — consumed as a BLOCK by\n        `_decide`, never advisory).\n    \"\"\"\n    import os as _os  # local alias to avoid any chance of shadowing\n    import stat as _stat\n    import tempfile as _tempfile\n\n    # PLAN-163 FXα: the CEO_PAIR_RAIL_FIXTURE_RESPONSE short-circuit was\n    # REMOVED from production entirely. Pin verification is now\n    # UNCONDITIONAL — no env (test-mode or otherwise) injects a preset\n    # review before _resolve_codex_bin(), so \"no env relaxes the sha\n    # verification\" is literally true. Tests inject a Codex review by\n    # mocking THIS function (_invoke_codex_review) at the invoke boundary,\n    # never via env; the ADR-182 sha gate is exercised directly in\n    # test_check_pair_rail_payload_pin.py.\n\n    # ADR-182: may raise CodexPinMismatch (fail-CLOSED) — deliberately\n    # NOT caught here; `_decide` maps it to `{decision: block}`.\n    codex_bin = _resolve_codex_bin()\n    if codex_bin is None:\n        raise CodexUnavailable(\n            \"codex binary not on PATH (or ADR-182 pin verification \"\n            \"hit an INFRA arm — see pair_rail_codex_unavailable audit)\"\n        )\n\n    shape = _resolve_codex_cli_shape()\n    if shape is None:\n        # The single argv builder is gone/unimportable. Fail-OPEN to\n        # ADVISORY rather than hand-roll a (possibly rejected) argv.\n        raise CodexUnavailable(\"codex_cli_shape helper unavailable\")\n\n    prompt = _build_codex_prompt(tool_name, file_path, proposed_content)\n    # PLAN-084 Wave 0.5 (ADR-114 + AC9 — Codex egress redaction symmetry).\n    # proposed_content is raw FILE CONTENT being reviewed (potentially\n    # secret-laden source). Redact the OUTGOING prompt BEFORE it leaves the\n    # framework. This stays fail-CLOSED per ADR-114: a redactor-import\n    # failure REFUSES to ship the prompt.\n    try:\n        from _lib import codex_egress_redact as _redact\n        _egress_bytes = len(prompt.encode(\"utf-8\", \"replace\")) if isinstance(prompt, str) else 0\n        prompt, _egress_findings = _redact.redact_outgoing_with_findings(prompt)\n    except ImportError:\n        # Fail-CLOSED per ADR-114: refuse to ship unredacted prompt to Codex.\n        raise CodexUnavailable(\"codex_egress_redact unavailable — fail-CLOSED per ADR-114\")\n    # PLAN-112-FOLLOWUP-codex-egress-proof-telemetry (F-7.9): positive-proof\n    # emit on EVERY outbound redaction (empty allowed). Fail-OPEN — wraps ONLY\n    # the emit; the redact above stays fail-CLOSED per ADR-114.\n    try:\n        from _lib import audit_emit as _ae\n        _ae.emit_pair_rail_outgoing_redaction_applied(\n            signal=\"outbound\",\n            match_count=len(_egress_findings),\n            bytes_scanned=_egress_bytes,\n            callsite=\"check_pair_rail.py:_invoke_codex_review\",\n            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:\n        pass\n\n    # -----------------------------------------------------------------\n    # tmpfile setup — we own the dir (0o700) and pre-create the output\n    # file with O_EXCL|0o600 to win the symlink race; the CLI writes to it\n    # by absolute path. A sibling schema file (written by US, not the\n    # untrusted binary) carries the CLI-enforced verdict shape.\n    # -----------------------------------------------------------------\n    tmp_dir = _tempfile.mkdtemp(prefix=\"ceo_pairrail_\")\n    try:\n        _os.chmod(tmp_dir, 0o700)\n    except OSError:\n        pass  # mkdtemp already creates 0o700 on POSIX\n    out_path = _os.path.join(tmp_dir, \"codex_last_message.json\")\n    schema_path = _os.path.join(tmp_dir, \"codex_verdict_schema.json\")\n\n    def _cleanup() -> None:\n        \"\"\"Unlink both tmpfiles + rmdir the dir; never raises.\"\"\"\n        for _p in (out_path, schema_path):\n            try:\n                _os.unlink(_p)\n            except OSError:\n                pass\n        try:\n            _os.rmdir(tmp_dir)\n        except OSError:\n            pass\n\n    try:\n        # Pre-create O_CREAT|O_EXCL|0o600 — if a symlink/file already sits\n        # at out_path, O_EXCL fails and we treat it as unavailable.\n        try:\n            fd = _os.open(out_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n            _os.close(fd)\n        except FileNotFoundError:\n            raise CodexUnavailable(\"tmpdir vanished before pre-create\")\n        except FileExistsError:\n            raise CodexUnavailable(\"tmpfile pre-create lost O_EXCL race\")\n        except OSError as e:\n            raise CodexUnavailable(f\"tmpfile pre-create failed: {type(e).__name__}\")\n\n        # Write the CLI-enforced verdict schema to our schema tmpfile\n        # (PLAN-142 §3 [P1], R-SEC-2). Best-effort: if the helper cannot\n        # serialize it, proceed WITHOUT enforcement (parser-side\n        # parse_verdict_strict still validates the shape).\n        schema_arg: Optional[str] = None\n        try:\n            schema_json = shape.verdict_output_schema_json()\n            sfd = _os.open(schema_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n            try:\n                _os.write(sfd, schema_json.encode(\"utf-8\"))\n            finally:\n                _os.close(sfd)\n            schema_arg = schema_path\n        except Exception:\n            schema_arg = None\n\n        # Build argv via the NON-kernel helper. The live-rail shape writes\n        # the verdict to our output file and drops usage telemetry (R-SEC-5);\n        # we pass only semantic intent — the helper owns flag names, the\n        # model id, and the dead-flag migration.\n        try:\n            cli_args = shape.build_verdict_argv(\n                prompt,\n                output_file=out_path,\n                schema_file=schema_arg,\n            )\n        except Exception as e:\n            raise CodexUnavailable(\n                f\"codex_cli_shape.build_verdict_argv failed: {type(e).__name__}\"\n            )\n        if not isinstance(cli_args, (list, tuple)) or not cli_args:\n            raise CodexUnavailable(\"codex_cli_shape returned empty argv\")\n\n        # ADR-182 verify-then-invoke: `codex_bin` is the VERIFIED native\n        # payload path returned by `_resolve_codex_bin()` (or the\n        # test-only CEO_PAIR_RAIL_CODEX_BIN override). Invoking the\n        # exact verified path — not `codex` re-resolved from $PATH —\n        # closes the hash-launcher/execute-payload gap of the retired\n        # codex-cli-binary-sha256.txt pin.\n        cmd = [codex_bin] + list(cli_args)\n\n        # Invoke. The prompt is the trailing positional built by the helper;\n        # close stdin via input=\"\" so the child never blocks on a pipe.\n        try:\n            proc = subprocess.run(\n                cmd,\n                input=\"\",\n                capture_output=True,\n                text=True,\n                timeout=timeout_s,\n                check=False,\n            )\n        except subprocess.TimeoutExpired:\n            raise CodexTimeout(f\"codex invoke exceeded {timeout_s}s\")\n        except (FileNotFoundError, PermissionError, OSError, ConnectionError) as e:\n            raise CodexUnavailable(f\"codex invoke failed: {type(e).__name__}: {e}\")\n        except ValueError as e:\n            # UnicodeDecodeError IS-A ValueError; map to malformed so\n            # `_decide` degrades to ADVISORY (preserve concrete name).\n            raise CodexMalformed(f\"codex invoke {type(e).__name__}: {e}\")\n\n        # Post-subprocess audit breadcrumb (UNCHANGED behavior).\n        try:\n            from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            if hasattr(_ae, \"emit_generic\"):\n                _ae.emit_generic(\"codex_invoke_dispatched\", exit_code=int(proc.returncode))\n        except Exception:\n            pass\n\n        if proc.returncode != 0:\n            # Non-zero exit → unavailable (fail-OPEN). A present output file\n            # after a non-zero exit is IGNORED (not read) and cleaned up.\n            raise CodexUnavailable(\n                f\"codex returned exit={proc.returncode}; stderr_head=\"\n                f\"{(proc.stderr or '')[:240]!r}\"\n            )\n\n        # -------------------------------------------------------------\n        # Read back the output file with TOCTOU re-validation. Re-stat via\n        # os.lstat (NOT following symlinks) and refuse anything that is not\n        # a regular file we own.\n        # -------------------------------------------------------------\n        try:\n            st = _os.lstat(out_path)\n        except FileNotFoundError:\n            raise CodexMalformed(\"codex last-message file missing after exit-0\")\n        except OSError as e:\n            raise CodexMalformed(f\"codex last-message lstat failed: {type(e).__name__}\")\n\n        if _stat.S_ISLNK(st.st_mode):\n            raise CodexMalformed(\"codex last-message path is a symlink; refusing to read\")\n        if not _stat.S_ISREG(st.st_mode):\n            raise CodexMalformed(\"codex last-message path is not a regular file; refusing\")\n        try:\n            if st.st_uid != _os.getuid():\n                raise CodexMalformed(\"codex last-message file not owned by us; refusing\")\n        except AttributeError:\n            # os.getuid absent (non-POSIX) — the 0o700 mkdtemp + O_EXCL\n            # pre-create are the primary controls; skip the uid check.\n            pass\n        if st.st_size == 0:\n            raise CodexMalformed(\"codex last-message file is empty\")\n        if st.st_size > _MAX_OUTPUT_FILE_BYTES:\n            raise CodexMalformed(\n                f\"codex last-message oversize ({st.st_size} > {_MAX_OUTPUT_FILE_BYTES})\"\n            )\n\n        # Open refusing to follow a symlink swapped in post-lstat.\n        try:\n            open_flags = _os.O_RDONLY\n            if hasattr(_os, \"O_NOFOLLOW\"):\n                open_flags |= _os.O_NOFOLLOW\n            rfd = _os.open(out_path, open_flags)\n        except OSError as e:\n            raise CodexMalformed(f\"codex last-message open failed: {type(e).__name__}\")\n        try:\n            raw_bytes = _os.read(rfd, _MAX_OUTPUT_FILE_BYTES + 1)\n        finally:\n            try:\n                _os.close(rfd)\n            except OSError:\n                pass\n        if len(raw_bytes) > _MAX_OUTPUT_FILE_BYTES:\n            raise CodexMalformed(\"codex last-message grew past cap during read\")\n\n        content = raw_bytes.decode(\"utf-8\", errors=\"replace\")\n\n        # -------------------------------------------------------------\n        # SINGLE-PASS redact the FULL byte-string BEFORE returning (and\n        # thus before any json.loads in the consumer). R-SEC-1. Ingress\n        # redaction is fail-OPEN to ADVISORY (distinct from the ADR-114\n        # fail-CLOSED *egress* contract above): if the redactor is\n        # unavailable we refuse to hand un-redacted text to the parser and\n        # degrade to ADVISORY via CodexMalformed.\n        # -------------------------------------------------------------\n        try:\n            from _lib import codex_egress_redact as _redact  # noqa: F811\n            redacted = _redact.redact(content)\n        except Exception:\n            raise CodexMalformed(\n                \"codex_egress_redact unavailable on ingress; refusing raw parse\"\n            )\n        return redacted\n    finally:\n        _cleanup()\n\ndef _sentinel_grants_pair_rail_bypass(\n    file_path: str, repo_root: Path\n) -> bool:\n    \"\"\"True if any Architect sentinel covers `file_path` in its scope.\n\n    Production: piggybacks on `check_canonical_edit._sentinel_grants_path`\n    if that helper is importable. Otherwise returns False (no bypass).\n    \"\"\"\n    try:\n        # Best-effort import; staging file should not depend on\n        # production import path. Fail soft.\n        hooks_dir = repo_root / \".claude\" / \"hooks\"\n        if str(hooks_dir) not in sys.path:\n            sys.path.insert(0, str(hooks_dir))\n        try:\n            import check_canonical_edit as _cce  # type: ignore\n        except Exception:\n            return False\n        try:\n            rel = (\n                Path(file_path).resolve().relative_to(repo_root.resolve())\n            )\n        except (ValueError, OSError):\n            return False\n        rel_str = str(rel).replace(os.sep, \"/\")\n        sentinels = _cce._find_sentinels(repo_root)  # type: ignore[attr-defined]\n        for sentinel in sentinels:\n            try:\n                if _cce._sentinel_grants_path(sentinel, rel_str):  # type: ignore[attr-defined]\n                    return True\n            except Exception:\n                continue\n        return False\n    except Exception:\n        return False\n\n_AUDIT_REVIEW_PASSED = \"pair_rail_review_passed\"\n\n_AUDIT_CODEX_VIOLATION = \"pair_rail_codex_violation\"\n\n_AUDIT_CODEX_UNAVAILABLE = \"pair_rail_codex_unavailable\"\n\n_AUDIT_SENTINEL_BYPASS = \"pair_rail_sentinel_bypass\"\n\n_AUDIT_OUT_OF_SCOPE = \"pair_rail_out_of_scope\"\n\n_AUDIT_KILL_SWITCH = \"pair_rail_kill_switch_used\"\n\n_AUDIT_PIN_MISMATCH = \"pair_rail_codex_pin_mismatch\"\n\n_AUDIT_FATAL_FAILOPEN = \"pair_rail_fatal_failopen\"\n\ndef _emit_audit(action: str, **fields: Any) -> None:\n    \"\"\"Best-effort audit. Production fallback: stderr breadcrumb when no audit sink configured.\n\n    Phase 1 wires through `_lib/audit_emit.emit_generic` after\n    register-ceremony lands the action labels in `_KNOWN_ACTIONS`.\n    \"\"\"\n    # Test capture hook: env-controlled file sink for unit tests.\n    sink = os.environ.get(\"CEO_PAIR_RAIL_AUDIT_SINK\")\n    if sink:\n        try:\n            event = {\"action\": action, **fields}\n            with open(sink, \"a\", encoding=\"utf-8\") as f:\n                f.write(json.dumps(event, ensure_ascii=False) + \"\\n\")\n        except Exception:\n            pass  # advisory; never blocks\n    # Stderr breadcrumb (spike — visible in test output).\n    try:\n        preview = \", \".join(\n            f\"{k}={v!r}\" for k, v in list(fields.items())[:5]\n        )\n        sys.stderr.write(\n            f\"[check_pair_rail SPIKE] {action} {preview}\\n\"\n        )\n    except Exception:\n        pass\n\ndef _emit_codex_review_invoked(review_text: str, grammar: \"Optional[str]\") -> None:\n    \"\"\"Emit codex_review_invoked for a completed Codex review (best-effort).\n\n    ``grammar`` is the write-shaped-patch verdict from ``_detect_write_shaped_patch``\n    (``None`` == clean/passed; non-``None`` == a flagged violation/failed). We feed\n    the review through the WS-3 driver (the single redaction source) so the raw\n    text is hashed, never echoed, then route the redacted PhaseReview fields\n    through ``optimizer._skeleton.safe_emit`` (silent until the action registers).\n    \"\"\"\n    try:\n        repo_root = Path(__file__).resolve().parents[2]\n        scripts_dir = str((repo_root / \".claude\" / \"scripts\").resolve())\n        if scripts_dir not in sys.path:\n            sys.path.insert(0, scripts_dir)\n        from optimizer import codex_phase_gate as _pg  # type: ignore[import]\n        from optimizer import _skeleton as _sk  # type: ignore[import]\n\n        # Map the already-obtained review into a driver result. We INJECT a\n        # closure returning that result so review_phase does the verdict\n        # classification + redaction (status, violation-count normalisation,\n        # thread/summary hashing) — we never re-implement that boundary here.\n        # The kill-switch is intentionally bypassed: we only reach this site\n        # AFTER a real invocation completed, so we drive review_phase with\n        # CEO_CODEX_REVIEW unset semantics via a direct injected result.\n        verdict = \"block\" if grammar is not None else \"accept\"\n        injected = {\n            \"status\": verdict,\n            \"summary\": review_text if isinstance(review_text, str) else \"\",\n        }\n        review = _pg.review_phase(\n            0, \"\", codex_invoke=lambda _p, _m: injected,\n        )\n        # review_disabled_signal is NOT forwarded — it routes the disabled\n        # sibling instead; forwarding a bool would break canonical-json/HMAC.\n        _sk.safe_emit(\n            \"codex_review_invoked\",\n            repo_root=repo_root,\n            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            phase_number=review.phase_number,\n            review_status=review.review_status,\n            summary_hash=review.summary_hash,\n            thread_id_redacted=review.thread_id_redacted,\n            codex_model=review.codex_model,\n            duration_ms=review.duration_ms,\n            violations_found_count=review.violations_found_count,\n        )\n    except Exception:\n        # FAIL-CLOSED on the emit only — an audit-emit failure must NEVER block\n        # or crash the Pair-Rail hook (ADR-005 never-blocks), and must NEVER\n        # launder unredacted text (we simply emit nothing on any error).\n        return\n\ndef _load_codex_adapter():  # type: ignore[no-untyped-def]\n    \"\"\"Resolve `_lib.adapters.codex` (the structured-verdict parser).\n\n    Same canonical-layout resolution as the other `_lib` loaders. Returns\n    the module or None (fail-OPEN — caller degrades to ADVISORY). NEVER\n    raises.\n    \"\"\"\n    try:\n        hooks_dir = Path(__file__).resolve().parent\n        if str(hooks_dir) not in sys.path:\n            sys.path.insert(0, str(hooks_dir))\n        from _lib.adapters import codex as _codex  # type: ignore\n        return _codex\n    except Exception:\n        return None\n\n_VALID_VERDICTS_LOCAL: Tuple[str, ...] = (\"PASS\", \"ADVISORY\", \"BLOCK\")\n\ndef _consume_codex_review(redacted_review: str) -> Tuple[str, Optional[str]]:\n    \"\"\"Derive (verdict, secondary_patch_grammar) from a REDACTED review.\n\n    PRIMARY signal (D3): `parse_verdict_strict` — the verdict is accepted\n    ONLY from a structured, schema-validated object (verdict ∈\n    `_VALID_VERDICTS_LOCAL`). A forged free-text 'PASS' with no structured\n    object → ADVISORY (fail-CLOSED-to-ADVISORY per R-SEC-2 / ADR-106).\n\n    SECONDARY signal (D3): `_detect_write_shaped_patch` runs on the SAME\n    redacted text as defense-in-depth annotation ONLY — it never upgrades a\n    verdict to a hard block; the structured verdict is authoritative.\n\n    Returns (verdict, patch_grammar) where verdict ∈ {\"PASS\",\"ADVISORY\",\n    \"BLOCK\"} and patch_grammar is the `_detect_write_shaped_patch` tag (or\n    None). NEVER raises.\n    \"\"\"\n    # Secondary defense-in-depth scan (advisory annotation only).\n    try:\n        patch_grammar = _detect_write_shaped_patch(redacted_review)\n    except Exception:\n        patch_grammar = None\n\n    codex = _load_codex_adapter()\n    if codex is None:\n        # Adapter unimportable — fail-CLOSED-to-ADVISORY (cannot validate a\n        # structured verdict, so we do not trust one).\n        return \"ADVISORY\", patch_grammar\n\n    # parse_verdict_strict is fail-CLOSED-to-ADVISORY and never raises, but\n    # wrap defensively anyway and coerce any surprise to ADVISORY. We do NOT\n    # fall back to the free-text patch scan as the verdict — it stays SECONDARY.\n    try:\n        envelope = codex.parse_verdict_strict(redacted_review)\n        verdict = envelope.get(\"verdict\")\n        if verdict not in _VALID_VERDICTS_LOCAL:\n            return \"ADVISORY\", patch_grammar\n        return str(verdict), patch_grammar\n    except Exception:\n        return \"ADVISORY\", patch_grammar\n\n_CURRENT_REVIEW_ID: str = \"\"\n\n__all__ = (\n    '_resolve_codex_cli_shape',\n    '_invoke_codex_review',\n    '_sentinel_grants_pair_rail_bypass',\n    '_AUDIT_REVIEW_PASSED',\n    '_AUDIT_CODEX_VIOLATION',\n    '_AUDIT_CODEX_UNAVAILABLE',\n    '_AUDIT_SENTINEL_BYPASS',\n    '_AUDIT_OUT_OF_SCOPE',\n    '_AUDIT_KILL_SWITCH',\n    '_AUDIT_PIN_MISMATCH',\n    '_AUDIT_FATAL_FAILOPEN',\n    '_emit_audit',\n    '_emit_codex_review_invoked',\n    '_load_codex_adapter',\n    '_VALID_VERDICTS_LOCAL',\n    '_consume_codex_review',\n    '_CURRENT_REVIEW_ID',\n)\n","numLines":525,"startLine":1,"totalLines":525}},"tool_result_meta":[{"id":"toolu_01QaobZEVJV7YCQEfvXCpD92","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NqcdxfEdqRgm4UMgRf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01K9C1VmdmQ58vbhAs1RHFJm","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_03.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12447,"cache_read_input_tokens":106297,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12447},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"70948574-10d8-44b5-80b1-81869bb9c4ba","timestamp":"2026-11-13T18:10:56.951Z","request_id":"req_011Ch1NqcRpGdA8CFSUatSCD","wire_tool_inputs":{"toolu_01K9C1VmdmQ58vbhAs1RHFJm":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_03.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K9C1VmdmQ58vbhAs1RHFJm","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\tfrom ._shared import *\n3\t\n4\t# QDSAA-FUNCAO-LONGA: ordem dos braços fail-open/fail-closed é contrato de segurança; fragmentar esconderia precedência.\n5\tdef _decide(\n6\t    *,\n7\t    tool_name: str,\n8\t    file_path: str,\n9\t    proposed_content: str,\n10\t    repo_root: Path,\n11\t    timeout_s: float,\n12\t    session_id: str = \"\",\n13\t) -> Dict[str, Any]:\n14\t    \"\"\"Pure decision returning a JSON-shape dict.\n15\t\n16\t    Returns:\n17\t        Dict with keys `decision` (allow|block) and optionally\n18\t        `reason` (block) or `systemMessage` (allow with note).\n19\t\n20\t    ``session_id`` (PLAN-161 C5, r3 F2): the hook payload's own session id,\n21\t    threaded from main() into the `pair_rail_review_expected` denominator\n22\t    emit below (and, via `_decide_with_matrix`, into `pair_rail_case`), so\n23\t    the /ceo-boot liveness classifier can correlate expected/outcome counts\n24\t    PER session.\n25\t    \"\"\"\n26\t    # Kill-switch.\n27\t    if os.environ.get(\"CEO_PAIR_RAIL_DISABLE\", \"\").strip() == \"1\":\n28\t        _emit_audit(\n29\t            _AUDIT_KILL_SWITCH,\n30\t            tool_name=tool_name, file_path=file_path,\n31\t        )\n32\t        return {}  # schema-compliant allow (Claude Code hook schema rejects top-level \"allow\")\n33\t\n34\t    # Out-of-scope: tool not in write set.\n35\t    write_tools = {\"Edit\", \"Write\", \"MultiEdit\", \"NotebookEdit\"}\n36\t    if tool_name not in write_tools:\n37\t        _emit_audit(\n38\t            _AUDIT_OUT_OF_SCOPE,\n39\t            tool_name=tool_name, reason=\"non_write_tool\",\n40\t        )\n41\t        return {}  # schema-compliant allow (Claude Code hook schema rejects top-level \"allow\")\n42\t\n43\t    # Out-of-scope: path not L3+.\n44\t    if not _is_l3_plus_path(file_path, repo_root):\n45\t        _emit_audit(\n46\t            _AUDIT_OUT_OF_SCOPE,\n47\t            tool_name=tool_name, file_path=file_path,\n48\t            reason=\"not_l3_plus\",\n49\t        )\n50\t        return {}  # schema-compliant allow (Claude Code hook schema rejects top-level \"allow\")\n51\t\n52\t    # Sentinel bypass — Owner-signed approval covers this path.\n53\t    if _sentinel_grants_pair_rail_bypass(file_path, repo_root):\n54\t        _emit_audit(\n55\t            _AUDIT_SENTINEL_BYPASS,\n56\t            tool_name=tool_name, file_path=file_path,\n57\t        )\n58\t        return {\n59\t            \"systemMessage\": (\n60\t                f\"PAIR-RAIL: bypass via Architect sentinel \"\n61\t                f\"({file_path})\"\n62\t            ),\n63\t        }\n64\t\n65\t    # PLAN-161 C5 (r3 F2 + r4 F1 + r4 F2, terminal fix r5 F2): the review\n66\t    # path is definitely ENTERED — the kill-switch, non-write-tool, not-L3+\n67\t    # and sentinel-bypass arms have ALL returned above. Generate the\n68\t    # per-invocation correlation id and emit the durable session-correlated\n69\t    # DENOMINATOR for the /ceo-boot `pair_rail` activity-conditioned\n70\t    # liveness row BEFORE the Codex invoke, so an expected-without-outcome\n71\t    # window (the S254 dead-rail class) becomes observable. r5 F2: the SAME\n72\t    # `review_id` is threaded (via the `_CURRENT_REVIEW_ID` slot) into this\n73\t    # invocation's `pair_rail_case` emit, so the /ceo-boot deficit pairs a\n74\t    # specific expected with its OWN case — bucketed COUNTING still let an\n75\t    # old completed case for the SAME (session, file) offset a later\n76\t    # expected whose hook died before its case emit. `file_path` stays\n77\t    # threaded so the emit carries the SAME `file_path_hash_prefix` as the\n78\t    # matching `pair_rail_case` (harmless secondary key + legacy fallback\n79\t    # for id-less pre-land events). Fail-OPEN + hasattr-guarded\n80\t    # (pre-ceremony audit_emit safe).\n81\t    global _CURRENT_REVIEW_ID\n82\t    review_id = os.urandom(8).hex()\n83\t    _CURRENT_REVIEW_ID = review_id\n84\t    # ADR-110-AMEND-2 §1.6 / §4(i): the EFFECTIVE post-clamp budget rides\n85\t    # both liveness emits. Without it a session exporting\n86\t    # CEO_PAIR_RAIL_TIMEOUT_S=5 produces a case F byte-indistinguishable\n87\t    # from a genuine Codex outage — the undocumented knob was stealthier\n88\t    # than the documented kill-switch (which emits its own loud event).\n89\t    _emit_pair_rail_review_expected(\n90\t        tool_name=tool_name, session_id=session_id, file_path=file_path,\n91\t        review_id=review_id, timeout_s=timeout_s,\n92\t    )\n93\t\n94\t    # Invoke Codex review. `_invoke_codex_review` now returns the REDACTED\n95\t    # last-message content (one structured JSON object).\n96\t    try:\n97\t        redacted_review = _invoke_codex_review(\n98\t            tool_name=tool_name,\n99\t            file_path=file_path,\n100\t            proposed_content=proposed_content,\n101\t            timeout_s=timeout_s,\n102\t        )\n103\t    except CodexPinMismatch as e:\n104\t        # ADR-182 fail-CLOSED arm — the ONLY hard-block this hook emits.\n105\t        # A payload that fails pin verification is a possible supply-\n106\t        # chain swap (T-8): it is never executed, and the L3+ write it\n107\t        # would have reviewed is blocked rather than silently degraded\n108\t        # to advisory. `_base_to_verdicts` classifies the block as Case\n109\t        # B (codex_verdict=BLOCK), pairing this invocation's\n110\t        # pair_rail_review_expected emit (no manufactured /ceo-boot\n111\t        # liveness deficit).\n112\t        _emit_audit(\n113\t            _AUDIT_PIN_MISMATCH,\n114\t            tool_name=tool_name, file_path=file_path,\n115\t            error=str(e)[:240],\n116\t        )\n117\t        return {\n118\t            \"decision\": \"block\",\n119\t            \"reason\": (\n120\t                \"PAIR-RAIL PIN (ADR-182): codex payload pin verification \"\n121\t                f\"failed — {e}. Fail-CLOSED: refusing to invoke an \"\n122\t                \"unverified codex binary and blocking this L3+ write. \"\n123\t                \"If the codex upgrade is legitimate, re-pin via the \"\n124\t                \"ADR-182 ceremony (codex-cli-pin-manifest.json).\"\n125\t            ),\n126\t        }\n127\t    except CodexUnavailable as e:\n128\t        _emit_audit(\n129\t            _AUDIT_CODEX_UNAVAILABLE,\n130\t            tool_name=tool_name, file_path=file_path,\n131\t            error=str(e),\n132\t        )\n133\t        # Substring \"Codex unavailable\" PRESERVED for _base_to_verdicts.\n134\t        return {\n135\t            \"systemMessage\": (\n136\t                f\"PAIR-RAIL: Codex unavailable ({e}); fail-OPEN \"\n137\t                \"advisory mode.\"\n138\t            ),\n139\t        }\n140\t    except CodexTimeout as e:\n141\t        _emit_audit(\n142\t            _AUDIT_CODEX_UNAVAILABLE,\n143\t            tool_name=tool_name, file_path=file_path,\n144\t            error=f\"timeout:{e}\",\n145\t        )\n146\t        # Substring \"Codex timeout\" PRESERVED for _base_to_verdicts.\n147\t        return {\n148\t            \"systemMessage\": (\n149\t                f\"PAIR-RAIL: Codex timeout ({e}); fail-OPEN.\"\n150\t            ),\n151\t        }\n152\t    except CodexMalformed as e:\n153\t        _emit_audit(\n154\t            _AUDIT_CODEX_UNAVAILABLE,\n155\t            tool_name=tool_name, file_path=file_path,\n156\t            error=f\"malformed:{e}\",\n157\t        )\n158\t        # Substring \"Codex malformed\" PRESERVED for _base_to_verdicts.\n159\t        return {\n160\t            \"systemMessage\": (\n161\t                f\"PAIR-RAIL: Codex malformed response ({e}); \"\n162\t                \"fail-OPEN.\"\n163\t            ),\n164\t        }\n165\t\n166\t    # PRIMARY: structured verdict (parse_verdict_strict, fail-CLOSED-to-\n167\t    # ADVISORY). SECONDARY: _detect_write_shaped_patch annotation (D3).\n168\t    verdict, patch_grammar = _consume_codex_review(redacted_review)\n169\t\n170\t    # PLAN-122 WS3 — record the completed Codex review (any verdict) as\n171\t    # codex_review_invoked (advisory; redacted PhaseReview; never blocks).\n172\t    # `grammar` keeps its historical meaning (write-shape tag). PLAN-142 V2\n173\t    # cross-model fold: a structured BLOCK with prose-only findings (no\n174\t    # write-shaped patch) has patch_grammar=None, which the WS3 driver would\n175\t    # otherwise map to 'accept' — under-reporting BLOCKs. Pass a synthetic\n176\t    # block tag so the telemetry agrees with the PRIMARY structured verdict.\n177\t    _emit_codex_review_invoked(\n178\t        redacted_review,\n179\t        patch_grammar or (\"structured_block\" if verdict == \"BLOCK\" else None),\n180\t    )\n181\t\n182\t    if verdict == \"BLOCK\":\n183\t        # Structured BLOCK from a schema-validated object. Per PLAN-092 /\n184\t        # ADR-127 SHADOW-strip the rail stays ADVISORY-ONLY at the\n185\t        # user-facing surface (no top-level block); the matrix wrapper owns\n186\t        # any block promotion via Case-B preconditions. The \"PAIR-RAIL-\n187\t        # ADVISORY\" + \"write-shaped\" substrings are PRESERVED so\n188\t        # _base_to_verdicts classifies this as Case B (codex_verdict=BLOCK).\n189\t        _emit_audit(\n190\t            _AUDIT_CODEX_VIOLATION,\n191\t            tool_name=tool_name, file_path=file_path,\n192\t            verdict=\"BLOCK\",\n193\t            grammar=(patch_grammar or \"\"),\n194\t            response_len=len(redacted_review),\n195\t        )\n196\t        return {\n197\t            \"systemMessage\": (\n198\t                \"PAIR-RAIL-ADVISORY: Codex returned a structured BLOCK \"\n199\t                \"verdict (advisory-only per ADR-127). A write-shaped \"\n200\t                f\"secondary signal ({patch_grammar or 'none'}) was \"\n201\t                f\"{'also ' if patch_grammar else 'not '}detected. See \"\n202\t                \"routing-matrix.md §threat-model.\"\n203\t            ),\n204\t        }\n205\t\n206\t    if patch_grammar is not None and verdict != \"BLOCK\":\n207\t        # Defense-in-depth ONLY: a write-shaped patch under a non-BLOCK\n208\t        # structured verdict. The structured verdict is authoritative (D3),\n209\t        # so we do NOT block; surface an advisory note + emit the violation\n210\t        # audit for forensic continuity. \"PAIR-RAIL-ADVISORY\" + \"write-shaped\"\n211\t        # keep the matrix Case-B classification stable.\n212\t        _emit_audit(\n213\t            _AUDIT_CODEX_VIOLATION,\n214\t            tool_name=tool_name, file_path=file_path,\n215\t            verdict=verdict,\n216\t            grammar=patch_grammar,\n217\t            response_len=len(redacted_review),\n218\t            note=\"secondary_writeshape_under_nonblock_verdict\",\n219\t        )\n220\t        return {\n221\t            \"systemMessage\": (\n222\t                \"PAIR-RAIL-ADVISORY: secondary defense-in-depth detected a \"\n223\t                f\"write-shaped patch ({patch_grammar}) under a non-BLOCK \"\n224\t                f\"structured verdict ({verdict}); advisory-only per ADR-127 \"\n225\t                \"+ D3 (structured verdict is authoritative).\"\n226\t            ),\n227\t        }\n228\t\n229\t    if verdict == \"ADVISORY\":\n230\t        # Parse miss / forged free-text / oversize / adapter-missing →\n231\t        # ADVISORY (fail-open). No \"review clean\" substring (NOT a clean\n232\t        # pass); no matrix Case-A. r6 F1: `_decide_with_matrix` pairs\n233\t        # this arm's `pair_rail_review_expected` by emitting a terminal\n234\t        # `pair_rail_case` (case=F, codex_verdict=ADVISORY) on its\n235\t        # matrix_case-is-None arm — an entered-and-answered review must\n236\t        # never register as a /ceo-boot S254 zero-case deficit.\n237\t        _emit_audit(\n238\t            _AUDIT_REVIEW_PASSED,\n239\t            tool_name=tool_name, file_path=file_path,\n240\t            verdict=\"ADVISORY\",\n241\t            response_len=len(redacted_review),\n242\t        )\n243\t        return {\n244\t            \"systemMessage\": (\n245\t                \"PAIR-RAIL: Codex verdict ADVISORY (no structured PASS/BLOCK \"\n246\t                \"parsed); fail-OPEN advisory mode.\"\n247\t            ),\n248\t        }\n249\t\n250\t    # verdict == \"PASS\" — structured clean review. \"review clean\" substring\n251\t    # PRESERVED for _base_to_verdicts Case-A classification.\n252\t    _emit_audit(\n253\t        _AUDIT_REVIEW_PASSED,\n254\t        tool_name=tool_name, file_path=file_path,\n255\t        verdict=\"PASS\",\n256\t        response_len=len(redacted_review),\n257\t    )\n258\t    return {\n259\t        \"systemMessage\": \"PAIR-RAIL: Codex review clean (structured PASS verdict).\",\n260\t    }\n261\t\n262\tdef _read_event_from_stdin() -> Optional[Dict[str, Any]]:\n263\t    \"\"\"Parse PreToolUse JSON envelope. Returns None on parse failure.\"\"\"\n264\t    try:\n265\t        raw = sys.stdin.read()\n266\t    except Exception:\n267\t        return None\n268\t    if not raw:\n269\t        return None\n270\t    try:\n271\t        return json.loads(raw)\n272\t    except (ValueError, TypeError):\n273\t        return None\n274\t\n275\tdef _extract_proposed_content(tool_input: Dict[str, Any]) -> str:\n276\t    \"\"\"Pull the proposed-write content from tool_input.\n277\t\n278\t    Edit       → `new_string`\n279\t    Write      → `content`\n280\t    MultiEdit  → concatenation of all `new_string` values\n281\t    NotebookEdit → `new_source`\n282\t    Fallback   → empty string (Codex review still proceeds with path-only context).\n283\t    \"\"\"\n284\t    if not isinstance(tool_input, dict):\n285\t        return \"\"\n286\t    if \"content\" in tool_input and isinstance(tool_input[\"content\"], str):\n287\t        return tool_input[\"content\"]\n288\t    if \"new_string\" in tool_input and isinstance(tool_input[\"new_string\"], str):\n289\t        return tool_input[\"new_string\"]\n290\t    if \"new_source\" in tool_input and isinstance(tool_input[\"new_source\"], str):\n291\t        return tool_input[\"new_source\"]\n292\t    edits = tool_input.get(\"edits\")\n293\t    if isinstance(edits, list):\n294\t        chunks: List[str] = []\n295\t        for e in edits:\n296\t            if isinstance(e, dict) and isinstance(e.get(\"new_string\"), str):\n297\t                chunks.append(e[\"new_string\"])\n298\t        if chunks:\n299\t            return \"\\n\".join(chunks)\n300\t    return \"\"\n301\t\n302\tdef main() -> int:\n303\t    \"\"\"Hook entry point — fail-OPEN on any uncaught exception.\"\"\"\n304\t    try:\n305\t        event = _read_event_from_stdin()\n306\t        if event is None:\n307\t            sys.stdout.write(json.dumps({}) + \"\\n\")  # schema-compliant allow\n308\t            return 0\n309\t        tool_name = str(event.get(\"tool_name\") or \"\")\n310\t        # PLAN-161 C5 (r3 F2): stop discarding the hook payload's session\n311\t        # id — thread it into pair_rail_review_expected AND pair_rail_case\n312\t        # so /ceo-boot can correlate expected/outcome counts per session.\n313\t        session_id = str(\n314\t            event.get(\"session_id\")\n315\t            or os.environ.get(\"CLAUDE_SESSION_ID\")\n316\t            or \"\"\n317\t        )\n318\t        tool_input = event.get(\"tool_input\") or {}\n319\t        if not isinstance(tool_input, dict):\n320\t            tool_input = {}\n321\t        file_path = str(tool_input.get(\"file_path\") or \"\")\n322\t        proposed = _extract_proposed_content(tool_input)\n323\t        repo_root = Path(\n324\t            os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n325\t        )\n326\t        try:\n327\t            timeout_s = float(\n328\t                os.environ.get(\"CEO_PAIR_RAIL_TIMEOUT_S\", \"180\")\n329\t            )\n330\t        except (TypeError, ValueError):\n331\t            timeout_s = 180.0\n332\t        if timeout_s <= 0 or timeout_s > 600:\n333\t            timeout_s = 180.0\n334\t\n335\t        # PLAN-081 Phase 3: route through the asymmetric VETO matrix\n336\t        # wrapper instead of the spike _decide() directly. The matrix\n337\t        # wrapper invokes _decide() internally + applies Cases A-F per\n338\t        # spec.md §11 + emits pair_rail_case per evaluation.\n339\t        decision = _decide_with_matrix(\n340\t            tool_name=tool_name,\n341\t            file_path=file_path,\n342\t            proposed_content=proposed,\n343\t            repo_root=repo_root,\n344\t            timeout_s=timeout_s,\n345\t            session_id=session_id,\n346\t        )\n347\t        sys.stdout.write(json.dumps(decision, ensure_ascii=False) + \"\\n\")\n348\t        return 0\n349\t    except Exception as e:\n350\t        # Fail-OPEN — never block the user on hook bug. U10 contract:\n351\t        # emit a structured breadcrumb so SPIKE-VERDICT.md can audit the\n352\t        # rate of catch-all firings (a high rate = a real bug masked by\n353\t        # fail-open, not a healthy contract). The stderr write is kept\n354\t        # for human visibility during the spike.\n355\t        try:\n356\t            # Codex MCP review F3 — keep the 240-char preview AND emit\n357\t            # stable `error_type` + `error_len` fields so SPIKE-VERDICT.md\n358\t            # sampling can group by exception class without parsing the\n359\t            # truncated preview.\n360\t            err_type = type(e).__name__\n361\t            err_str = str(e)\n362\t            _emit_audit(\n363\t                _AUDIT_FATAL_FAILOPEN,\n364\t                error_type=err_type,\n365\t                error_len=len(err_str),\n366\t                error=f\"{err_type}: {err_str}\"[:240],\n367\t            )\n368\t        except Exception:\n369\t            pass\n370\t        try:\n371\t            sys.stderr.write(\n372\t                f\"[check_pair_rail SPIKE] FATAL: {type(e).__name__}: {e}\\n\"\n373\t            )\n374\t        except Exception:\n375\t            pass\n376\t        sys.stdout.write(json.dumps({}) + \"\\n\")  # schema-compliant allow\n377\t        return 0\n378\t\n379\t_RUBRIC_CATALOGUE_CACHE: Optional[Dict[str, Dict[str, Any]]] = None\n380\t\n381\tdef _load_rubric_catalogue(repo_root: Path) -> Dict[str, Dict[str, Any]]:\n382\t    \"\"\"Load + cache the rubric violation catalogue.\n383\t\n384\t    Returns an empty dict if the catalogue cannot be loaded (fail-OPEN —\n385\t    Phase 3 hook MUST NOT block on missing catalogue; it just downgrades\n386\t    Case-B to advisory because the rubric_violation_id can never be\n387\t    validated against an empty catalogue).\n388\t    \"\"\"\n389\t    global _RUBRIC_CATALOGUE_CACHE\n390\t    if _RUBRIC_CATALOGUE_CACHE is not None:\n391\t        return _RUBRIC_CATALOGUE_CACHE\n392\t    catalogue_path = (\n393\t        repo_root / \".claude\" / \"policies\" / \"rubric-violation-catalogue.yaml\"\n394\t    )\n395\t    if not catalogue_path.exists():\n396\t        _RUBRIC_CATALOGUE_CACHE = {}\n397\t        return _RUBRIC_CATALOGUE_CACHE\n398\t    try:\n399\t        text = catalogue_path.read_text(encoding=\"utf-8\")\n400\t        # Inline minimal YAML parse for the `violations:` section.\n401\t        # Matches the routing-matrix-loader pattern (stdlib only).\n402\t        catalogue: Dict[str, Dict[str, Any]] = {}\n403\t        in_violations = False\n404\t        current: Optional[Dict[str, Any]] = None\n405\t        for raw_line in text.splitlines():\n406\t            line = raw_line.split(\"#\", 1)[0].rstrip() if \"#\" in raw_line else raw_line.rstrip()\n407\t            if not line.strip():\n408\t                continue\n409\t            if line.startswith(\"violations:\"):\n410\t                in_violations = True\n411\t                continue\n412\t            if not in_violations:\n413\t                continue\n414\t            # Detect new entry: '  - id: <slug>' at 2-space indent\n415\t            stripped = line.lstrip()\n416\t            indent = len(line) - len(stripped)\n417\t            if indent == 2 and stripped.startswith(\"- id:\"):\n418\t                if current is not None and \"id\" in current:\n419\t                    catalogue[current[\"id\"]] = current\n420\t                current = {}\n421\t                _, _, val = stripped.partition(\":\")\n422\t                current[\"id\"] = val.strip()\n423\t            elif indent == 4 and current is not None and \":\" in stripped:\n424\t                key, _, val = stripped.partition(\":\")\n425\t                current[key.strip()] = val.strip()\n426\t            elif indent < 2 and current is not None and \"id\" in current:\n427\t                # Section ended\n428\t                catalogue[current[\"id\"]] = current\n429\t                current = None\n430\t                in_violations = False\n431\t        if current is not None and \"id\" in current:\n432\t            catalogue[current[\"id\"]] = current\n433\t        _RUBRIC_CATALOGUE_CACHE = catalogue\n434\t        return catalogue\n435\t    except Exception:\n436\t        _RUBRIC_CATALOGUE_CACHE = {}\n437\t        return _RUBRIC_CATALOGUE_CACHE\n438\t\n439\tdef _validate_provider_pair(\n440\t    *,\n441\t    codex_verdict: str,\n442\t    rubric_violation_id: str,\n443\t    severity: str,\n444\t    file_line_cited: bool,\n445\t    repo_root: Path,\n446\t) -> Tuple[bool, str]:\n447\t    \"\"\"Validate Case-B preconditions per spec.md §11.\n448\t\n449\t    A Case-B verdict from Codex (BLOCK with PASS from Claude) must carry:\n450\t      - reproducible evidence (file:line OR command cited)\n451\t      - rubric_violation_id ∈ rubric-violation-catalogue.yaml\n452\t      - severity ∈ {P0, P1}\n453\t\n454\t    R1 S-CR-1 codifies: this function is a greenfield helper (NOT\n455\t    preserving any prior provider-pair grandfather entry). ADR-097 was\n456\t    \"Function-length advisory-permanent + 344-function grandfather list\"\n457\t    — NO LLM/dispatcher/pair-rail content per `head -1` audit.\n458\t\n459\t    Returns:\n460\t        (preconditions_met: bool, reason: str). Reason is \"ok\" when met;\n461\t        otherwise a slug naming the specific precondition that failed\n462\t        (downstream audit emit + reason_code).\n463\t    \"\"\"\n464\t    if codex_verdict != \"BLOCK\":\n465\t        # Not a Case-B candidate — vacuously \"met\" for the dispatcher\n466\t        return True, \"not_case_b\"\n467\t    if not file_line_cited:\n468\t        return False, \"missing_file_line\"\n469\t    if not rubric_violation_id or len(rubric_violation_id) > 64:\n470\t        return False, \"missing_or_invalid_rubric_id\"\n471\t    catalogue = _load_rubric_catalogue(repo_root)\n472\t    if not catalogue:\n473\t        return False, \"catalogue_not_loaded\"\n474\t    if rubric_violation_id not in catalogue:\n475\t        return False, \"rubric_id_not_in_catalogue\"\n476\t    if severity not in (\"P0\", \"P1\"):\n477\t        return False, \"invalid_severity\"\n478\t    return True, \"ok\"\n479\t\n480\tdef _compute_jaccard_bucket(claude_findings: List[str], codex_findings: List[str]) -> str:\n481\t    \"\"\"Bucket the Jaccard similarity for Case-E divergence detection.\n482\t\n483\t    Phase 3 uses bucketed similarity (NEVER raw float) per Sec MF-3\n484\t    `_PAIR_RAIL_CASE_EMIT_ALLOWLIST` (raw float would leak prompt\n485\t    content / response content via correlated audit-log readout).\n486\t\n487\t    Buckets per spec.md §11 R1.5-4 fix:\n488\t      - \"<=0.3\" → low similarity = high divergence → Case-E flag\n489\t      - \"0.3-0.5\"\n490\t      - \"0.5-0.8\"\n491\t      - \">0.8\" → high similarity = aligned reviews\n492\t    \"\"\"\n493\t    if not claude_findings and not codex_findings:\n494\t        return \">0.8\"  # both empty = perfectly aligned\n495\t    set_c = {f.strip().lower() for f in claude_findings if f.strip()}\n496\t    set_x = {f.strip().lower() for f in codex_findings if f.strip()}\n497\t    if not set_c and not set_x:\n498\t        return \">0.8\"\n499\t    inter = len(set_c & set_x)\n500\t    union = len(set_c | set_x)\n501\t    if union == 0:\n502\t        return \">0.8\"\n503\t    sim = inter / union\n504\t    if sim <= 0.3:\n505\t        return \"<=0.3\"\n506\t    if sim <= 0.5:\n507\t        return \"0.3-0.5\"\n508\t    if sim <= 0.8:\n509\t        return \"0.5-0.8\"\n510\t    return \">0.8\"\n511\t\n512\tdef _hash_file_path_prefix(file_path: str) -> str:\n513\t    \"\"\"Compute 16-hex SHA-256 prefix of file path (LLM06 side-channel guard).\"\"\"\n514\t    import hashlib\n515\t    if not file_path:\n516\t        return \"\"\n517\t    return hashlib.sha256(file_path.encode(\"utf-8\")).hexdigest()[:16]\n518\t\n519\tdef _resolve_human_triage_grace_h(severity: str) -> int:\n520\t    \"\"\"Return human-triage grace hours per R1 S-TDE-4.\n521\t\n522\t    P1 violations get a 24h grace window (env-overridable via\n523\t    CEO_PAIR_RAIL_HUMAN_TRIAGE_HOURS, clamped to [0, 24] per ADR-108\n524\t    + Codex iter 1 P1-2). P0 = 0h (immediate block).\n525\t    Outside-of-grace P1 closes-as-advisory.\n526\t\n527\t    Codex iter 1 P1-2 fix: env override is clamped to ``min(value, 24)``\n528\t    so an Owner setting `CEO_PAIR_RAIL_HUMAN_TRIAGE_HOURS=1000` cannot\n529\t    extend the grace beyond the ADR-108-mandated 24h ceiling. Lower\n530\t    bound stays 0 (allows mechanical-immediate-close override).\n531\t    \"\"\"\n532\t    if severity != \"P1\":\n533\t        return 0\n534\t    raw = os.environ.get(\"CEO_PAIR_RAIL_HUMAN_TRIAGE_HOURS\", \"24\")\n535\t    try:\n536\t        h = int(raw)\n537\t        # Clamp to [0, 24] per ADR-108 §Operational labeling protocol.\n538\t        return max(0, min(h, 24))\n539\t    except (TypeError, ValueError):\n540\t        return 24\n541\t\n542\t_TIMEOUT_MS_MAX = 6_000_000\n543\t\n544\tdef _timeout_ms(value_s: float) -> int:\n545\t    \"\"\"Convert an effective-budget in SECONDS to bounded integer ms.\n546\t\n547\t    Fail-safe: a non-numeric / NaN / infinite input yields 0 (the\n548\t    \"unknown budget\" sentinel) rather than raising into the emit\n549\t    wrappers' fail-open catch, which would drop the event.\n550\t    \"\"\"\n551\t    try:\n552\t        ms = int(float(value_s) * 1000)\n553\t    except (TypeError, ValueError, OverflowError):\n554\t        return 0\n555\t    return max(0, min(_TIMEOUT_MS_MAX, ms))\n556\t\n557\t__all__ = (\n558\t    '_decide',\n559\t    '_read_event_from_stdin',\n560\t    '_extract_proposed_content',\n561\t    'main',\n562\t    '_RUBRIC_CATALOGUE_CACHE',\n563\t    '_load_rubric_catalogue',\n564\t    '_validate_provider_pair',\n565\t    '_compute_jaccard_bucket',\n566\t    '_hash_file_path_prefix',\n567\t    '_resolve_human_triage_grace_h',\n568\t    '_TIMEOUT_MS_MAX',\n569\t    '_timeout_ms',\n570\t)\n571\t"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"4e6d98d6-e2df-4a0f-a18a-7763f4e691bf","timestamp":"2026-11-13T18:10:56.976Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_03.py","content":"from __future__ import annotations\nfrom ._shared import *\n\n# QDSAA-FUNCAO-LONGA: ordem dos braços fail-open/fail-closed é contrato de segurança; fragmentar esconderia precedência.\ndef _decide(\n    *,\n    tool_name: str,\n    file_path: str,\n    proposed_content: str,\n    repo_root: Path,\n    timeout_s: float,\n    session_id: str = \"\",\n) -> Dict[str, Any]:\n    \"\"\"Pure decision returning a JSON-shape dict.\n\n    Returns:\n        Dict with keys `decision` (allow|block) and optionally\n        `reason` (block) or `systemMessage` (allow with note).\n\n    ``session_id`` (PLAN-161 C5, r3 F2): the hook payload's own session id,\n    threaded from main() into the `pair_rail_review_expected` denominator\n    emit below (and, via `_decide_with_matrix`, into `pair_rail_case`), so\n    the /ceo-boot liveness classifier can correlate expected/outcome counts\n    PER session.\n    \"\"\"\n    # Kill-switch.\n    if os.environ.get(\"CEO_PAIR_RAIL_DISABLE\", \"\").strip() == \"1\":\n        _emit_audit(\n            _AUDIT_KILL_SWITCH,\n            tool_name=tool_name, file_path=file_path,\n        )\n        return {}  # schema-compliant allow (Claude Code hook schema rejects top-level \"allow\")\n\n    # Out-of-scope: tool not in write set.\n    write_tools = {\"Edit\", \"Write\", \"MultiEdit\", \"NotebookEdit\"}\n    if tool_name not in write_tools:\n        _emit_audit(\n            _AUDIT_OUT_OF_SCOPE,\n            tool_name=tool_name, reason=\"non_write_tool\",\n        )\n        return {}  # schema-compliant allow (Claude Code hook schema rejects top-level \"allow\")\n\n    # Out-of-scope: path not L3+.\n    if not _is_l3_plus_path(file_path, repo_root):\n        _emit_audit(\n            _AUDIT_OUT_OF_SCOPE,\n            tool_name=tool_name, file_path=file_path,\n            reason=\"not_l3_plus\",\n        )\n        return {}  # schema-compliant allow (Claude Code hook schema rejects top-level \"allow\")\n\n    # Sentinel bypass — Owner-signed approval covers this path.\n    if _sentinel_grants_pair_rail_bypass(file_path, repo_root):\n        _emit_audit(\n            _AUDIT_SENTINEL_BYPASS,\n            tool_name=tool_name, file_path=file_path,\n        )\n        return {\n            \"systemMessage\": (\n                f\"PAIR-RAIL: bypass via Architect sentinel \"\n                f\"({file_path})\"\n            ),\n        }\n\n    # PLAN-161 C5 (r3 F2 + r4 F1 + r4 F2, terminal fix r5 F2): the review\n    # path is definitely ENTERED — the kill-switch, non-write-tool, not-L3+\n    # and sentinel-bypass arms have ALL returned above. Generate the\n    # per-invocation correlation id and emit the durable session-correlated\n    # DENOMINATOR for the /ceo-boot `pair_rail` activity-conditioned\n    # liveness row BEFORE the Codex invoke, so an expected-without-outcome\n    # window (the S254 dead-rail class) becomes observable. r5 F2: the SAME\n    # `review_id` is threaded (via the `_CURRENT_REVIEW_ID` slot) into this\n    # invocation's `pair_rail_case` emit, so the /ceo-boot deficit pairs a\n    # specific expected with its OWN case — bucketed COUNTING still let an\n    # old completed case for the SAME (session, file) offset a later\n    # expected whose hook died before its case emit. `file_path` stays\n    # threaded so the emit carries the SAME `file_path_hash_prefix` as the\n    # matching `pair_rail_case` (harmless secondary key + legacy fallback\n    # for id-less pre-land events). Fail-OPEN + hasattr-guarded\n    # (pre-ceremony audit_emit safe).\n    global _CURRENT_REVIEW_ID\n    review_id = os.urandom(8).hex()\n    _CURRENT_REVIEW_ID = review_id\n    # ADR-110-AMEND-2 §1.6 / §4(i): the EFFECTIVE post-clamp budget rides\n    # both liveness emits. Without it a session exporting\n    # CEO_PAIR_RAIL_TIMEOUT_S=5 produces a case F byte-indistinguishable\n    # from a genuine Codex outage — the undocumented knob was stealthier\n    # than the documented kill-switch (which emits its own loud event).\n    _emit_pair_rail_review_expected(\n        tool_name=tool_name, session_id=session_id, file_path=file_path,\n        review_id=review_id, timeout_s=timeout_s,\n    )\n\n    # Invoke Codex review. `_invoke_codex_review` now returns the REDACTED\n    # last-message content (one structured JSON object).\n    try:\n        redacted_review = _invoke_codex_review(\n            tool_name=tool_name,\n            file_path=file_path,\n            proposed_content=proposed_content,\n            timeout_s=timeout_s,\n        )\n    except CodexPinMismatch as e:\n        # ADR-182 fail-CLOSED arm — the ONLY hard-block this hook emits.\n        # A payload that fails pin verification is a possible supply-\n        # chain swap (T-8): it is never executed, and the L3+ write it\n        # would have reviewed is blocked rather than silently degraded\n        # to advisory. `_base_to_verdicts` classifies the block as Case\n        # B (codex_verdict=BLOCK), pairing this invocation's\n        # pair_rail_review_expected emit (no manufactured /ceo-boot\n        # liveness deficit).\n        _emit_audit(\n            _AUDIT_PIN_MISMATCH,\n            tool_name=tool_name, file_path=file_path,\n            error=str(e)[:240],\n        )\n        return {\n            \"decision\": \"block\",\n            \"reason\": (\n                \"PAIR-RAIL PIN (ADR-182): codex payload pin verification \"\n                f\"failed — {e}. Fail-CLOSED: refusing to invoke an \"\n                \"unverified codex binary and blocking this L3+ write. \"\n                \"If the codex upgrade is legitimate, re-pin via the \"\n                \"ADR-182 ceremony (codex-cli-pin-manifest.json).\"\n            ),\n        }\n    except CodexUnavailable as e:\n        _emit_audit(\n            _AUDIT_CODEX_UNAVAILABLE,\n            tool_name=tool_name, file_path=file_path,\n            error=str(e),\n        )\n        # Substring \"Codex unavailable\" PRESERVED for _base_to_verdicts.\n        return {\n            \"systemMessage\": (\n                f\"PAIR-RAIL: Codex unavailable ({e}); fail-OPEN \"\n                \"advisory mode.\"\n            ),\n        }\n    except CodexTimeout as e:\n        _emit_audit(\n            _AUDIT_CODEX_UNAVAILABLE,\n            tool_name=tool_name, file_path=file_path,\n            error=f\"timeout:{e}\",\n        )\n        # Substring \"Codex timeout\" PRESERVED for _base_to_verdicts.\n        return {\n            \"systemMessage\": (\n                f\"PAIR-RAIL: Codex timeout ({e}); fail-OPEN.\"\n            ),\n        }\n    except CodexMalformed as e:\n        _emit_audit(\n            _AUDIT_CODEX_UNAVAILABLE,\n            tool_name=tool_name, file_path=file_path,\n            error=f\"malformed:{e}\",\n        )\n        # Substring \"Codex malformed\" PRESERVED for _base_to_verdicts.\n        return {\n            \"systemMessage\": (\n                f\"PAIR-RAIL: Codex malformed response ({e}); \"\n                \"fail-OPEN.\"\n            ),\n        }\n\n    # PRIMARY: structured verdict (parse_verdict_strict, fail-CLOSED-to-\n    # ADVISORY). SECONDARY: _detect_write_shaped_patch annotation (D3).\n    verdict, patch_grammar = _consume_codex_review(redacted_review)\n\n    # PLAN-122 WS3 — record the completed Codex review (any verdict) as\n    # codex_review_invoked (advisory; redacted PhaseReview; never blocks).\n    # `grammar` keeps its historical meaning (write-shape tag). PLAN-142 V2\n    # cross-model fold: a structured BLOCK with prose-only findings (no\n    # write-shaped patch) has patch_grammar=None, which the WS3 driver would\n    # otherwise map to 'accept' — under-reporting BLOCKs. Pass a synthetic\n    # block tag so the telemetry agrees with the PRIMARY structured verdict.\n    _emit_codex_review_invoked(\n        redacted_review,\n        patch_grammar or (\"structured_block\" if verdict == \"BLOCK\" else None),\n    )\n\n    if verdict == \"BLOCK\":\n        # Structured BLOCK from a schema-validated object. Per PLAN-092 /\n        # ADR-127 SHADOW-strip the rail stays ADVISORY-ONLY at the\n        # user-facing surface (no top-level block); the matrix wrapper owns\n        # any block promotion via Case-B preconditions. The \"PAIR-RAIL-\n        # ADVISORY\" + \"write-shaped\" substrings are PRESERVED so\n        # _base_to_verdicts classifies this as Case B (codex_verdict=BLOCK).\n        _emit_audit(\n            _AUDIT_CODEX_VIOLATION,\n            tool_name=tool_name, file_path=file_path,\n            verdict=\"BLOCK\",\n            grammar=(patch_grammar or \"\"),\n            response_len=len(redacted_review),\n        )\n        return {\n            \"systemMessage\": (\n                \"PAIR-RAIL-ADVISORY: Codex returned a structured BLOCK \"\n                \"verdict (advisory-only per ADR-127). A write-shaped \"\n                f\"secondary signal ({patch_grammar or 'none'}) was \"\n                f\"{'also ' if patch_grammar else 'not '}detected. See \"\n                \"routing-matrix.md §threat-model.\"\n            ),\n        }\n\n    if patch_grammar is not None and verdict != \"BLOCK\":\n        # Defense-in-depth ONLY: a write-shaped patch under a non-BLOCK\n        # structured verdict. The structured verdict is authoritative (D3),\n        # so we do NOT block; surface an advisory note + emit the violation\n        # audit for forensic continuity. \"PAIR-RAIL-ADVISORY\" + \"write-shaped\"\n        # keep the matrix Case-B classification stable.\n        _emit_audit(\n            _AUDIT_CODEX_VIOLATION,\n            tool_name=tool_name, file_path=file_path,\n            verdict=verdict,\n            grammar=patch_grammar,\n            response_len=len(redacted_review),\n            note=\"secondary_writeshape_under_nonblock_verdict\",\n        )\n        return {\n            \"systemMessage\": (\n                \"PAIR-RAIL-ADVISORY: secondary defense-in-depth detected a \"\n                f\"write-shaped patch ({patch_grammar}) under a non-BLOCK \"\n                f\"structured verdict ({verdict}); advisory-only per ADR-127 \"\n                \"+ D3 (structured verdict is authoritative).\"\n            ),\n        }\n\n    if verdict == \"ADVISORY\":\n        # Parse miss / forged free-text / oversize / adapter-missing →\n        # ADVISORY (fail-open). No \"review clean\" substring (NOT a clean\n        # pass); no matrix Case-A. r6 F1: `_decide_with_matrix` pairs\n        # this arm's `pair_rail_review_expected` by emitting a terminal\n        # `pair_rail_case` (case=F, codex_verdict=ADVISORY) on its\n        # matrix_case-is-None arm — an entered-and-answered review must\n        # never register as a /ceo-boot S254 zero-case deficit.\n        _emit_audit(\n            _AUDIT_REVIEW_PASSED,\n            tool_name=tool_name, file_path=file_path,\n            verdict=\"ADVISORY\",\n            response_len=len(redacted_review),\n        )\n        return {\n            \"systemMessage\": (\n                \"PAIR-RAIL: Codex verdict ADVISORY (no structured PASS/BLOCK \"\n                \"parsed); fail-OPEN advisory mode.\"\n            ),\n        }\n\n    # verdict == \"PASS\" — structured clean review. \"review clean\" substring\n    # PRESERVED for _base_to_verdicts Case-A classification.\n    _emit_audit(\n        _AUDIT_REVIEW_PASSED,\n        tool_name=tool_name, file_path=file_path,\n        verdict=\"PASS\",\n        response_len=len(redacted_review),\n    )\n    return {\n        \"systemMessage\": \"PAIR-RAIL: Codex review clean (structured PASS verdict).\",\n    }\n\ndef _read_event_from_stdin() -> Optional[Dict[str, Any]]:\n    \"\"\"Parse PreToolUse JSON envelope. Returns None on parse failure.\"\"\"\n    try:\n        raw = sys.stdin.read()\n    except Exception:\n        return None\n    if not raw:\n        return None\n    try:\n        return json.loads(raw)\n    except (ValueError, TypeError):\n        return None\n\ndef _extract_proposed_content(tool_input: Dict[str, Any]) -> str:\n    \"\"\"Pull the proposed-write content from tool_input.\n\n    Edit       → `new_string`\n    Write      → `content`\n    MultiEdit  → concatenation of all `new_string` values\n    NotebookEdit → `new_source`\n    Fallback   → empty string (Codex review still proceeds with path-only context).\n    \"\"\"\n    if not isinstance(tool_input, dict):\n        return \"\"\n    if \"content\" in tool_input and isinstance(tool_input[\"content\"], str):\n        return tool_input[\"content\"]\n    if \"new_string\" in tool_input and isinstance(tool_input[\"new_string\"], str):\n        return tool_input[\"new_string\"]\n    if \"new_source\" in tool_input and isinstance(tool_input[\"new_source\"], str):\n        return tool_input[\"new_source\"]\n    edits = tool_input.get(\"edits\")\n    if isinstance(edits, list):\n        chunks: List[str] = []\n        for e in edits:\n            if isinstance(e, dict) and isinstance(e.get(\"new_string\"), str):\n                chunks.append(e[\"new_string\"])\n        if chunks:\n            return \"\\n\".join(chunks)\n    return \"\"\n\ndef main() -> int:\n    \"\"\"Hook entry point — fail-OPEN on any uncaught exception.\"\"\"\n    try:\n        event = _read_event_from_stdin()\n        if event is None:\n            sys.stdout.write(json.dumps({}) + \"\\n\")  # schema-compliant allow\n            return 0\n        tool_name = str(event.get(\"tool_name\") or \"\")\n        # PLAN-161 C5 (r3 F2): stop discarding the hook payload's session\n        # id — thread it into pair_rail_review_expected AND pair_rail_case\n        # so /ceo-boot can correlate expected/outcome counts per session.\n        session_id = str(\n            event.get(\"session_id\")\n            or os.environ.get(\"CLAUDE_SESSION_ID\")\n            or \"\"\n        )\n        tool_input = event.get(\"tool_input\") or {}\n        if not isinstance(tool_input, dict):\n            tool_input = {}\n        file_path = str(tool_input.get(\"file_path\") or \"\")\n        proposed = _extract_proposed_content(tool_input)\n        repo_root = Path(\n            os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        )\n        try:\n            timeout_s = float(\n                os.environ.get(\"CEO_PAIR_RAIL_TIMEOUT_S\", \"180\")\n            )\n        except (TypeError, ValueError):\n            timeout_s = 180.0\n        if timeout_s <= 0 or timeout_s > 600:\n            timeout_s = 180.0\n\n        # PLAN-081 Phase 3: route through the asymmetric VETO matrix\n        # wrapper instead of the spike _decide() directly. The matrix\n        # wrapper invokes _decide() internally + applies Cases A-F per\n        # spec.md §11 + emits pair_rail_case per evaluation.\n        decision = _decide_with_matrix(\n            tool_name=tool_name,\n            file_path=file_path,\n            proposed_content=proposed,\n            repo_root=repo_root,\n            timeout_s=timeout_s,\n            session_id=session_id,\n        )\n        sys.stdout.write(json.dumps(decision, ensure_ascii=False) + \"\\n\")\n        return 0\n    except Exception as e:\n        # Fail-OPEN — never block the user on hook bug. U10 contract:\n        # emit a structured breadcrumb so SPIKE-VERDICT.md can audit the\n        # rate of catch-all firings (a high rate = a real bug masked by\n        # fail-open, not a healthy contract). The stderr write is kept\n        # for human visibility during the spike.\n        try:\n            # Codex MCP review F3 — keep the 240-char preview AND emit\n            # stable `error_type` + `error_len` fields so SPIKE-VERDICT.md\n            # sampling can group by exception class without parsing the\n            # truncated preview.\n            err_type = type(e).__name__\n            err_str = str(e)\n            _emit_audit(\n                _AUDIT_FATAL_FAILOPEN,\n                error_type=err_type,\n                error_len=len(err_str),\n                error=f\"{err_type}: {err_str}\"[:240],\n            )\n        except Exception:\n            pass\n        try:\n            sys.stderr.write(\n                f\"[check_pair_rail SPIKE] FATAL: {type(e).__name__}: {e}\\n\"\n            )\n        except Exception:\n            pass\n        sys.stdout.write(json.dumps({}) + \"\\n\")  # schema-compliant allow\n        return 0\n\n_RUBRIC_CATALOGUE_CACHE: Optional[Dict[str, Dict[str, Any]]] = None\n\ndef _load_rubric_catalogue(repo_root: Path) -> Dict[str, Dict[str, Any]]:\n    \"\"\"Load + cache the rubric violation catalogue.\n\n    Returns an empty dict if the catalogue cannot be loaded (fail-OPEN —\n    Phase 3 hook MUST NOT block on missing catalogue; it just downgrades\n    Case-B to advisory because the rubric_violation_id can never be\n    validated against an empty catalogue).\n    \"\"\"\n    global _RUBRIC_CATALOGUE_CACHE\n    if _RUBRIC_CATALOGUE_CACHE is not None:\n        return _RUBRIC_CATALOGUE_CACHE\n    catalogue_path = (\n        repo_root / \".claude\" / \"policies\" / \"rubric-violation-catalogue.yaml\"\n    )\n    if not catalogue_path.exists():\n        _RUBRIC_CATALOGUE_CACHE = {}\n        return _RUBRIC_CATALOGUE_CACHE\n    try:\n        text = catalogue_path.read_text(encoding=\"utf-8\")\n        # Inline minimal YAML parse for the `violations:` section.\n        # Matches the routing-matrix-loader pattern (stdlib only).\n        catalogue: Dict[str, Dict[str, Any]] = {}\n        in_violations = False\n        current: Optional[Dict[str, Any]] = None\n        for raw_line in text.splitlines():\n            line = raw_line.split(\"#\", 1)[0].rstrip() if \"#\" in raw_line else raw_line.rstrip()\n            if not line.strip():\n                continue\n            if line.startswith(\"violations:\"):\n                in_violations = True\n                continue\n            if not in_violations:\n                continue\n            # Detect new entry: '  - id: <slug>' at 2-space indent\n            stripped = line.lstrip()\n            indent = len(line) - len(stripped)\n            if indent == 2 and stripped.startswith(\"- id:\"):\n                if current is not None and \"id\" in current:\n                    catalogue[current[\"id\"]] = current\n                current = {}\n                _, _, val = stripped.partition(\":\")\n                current[\"id\"] = val.strip()\n            elif indent == 4 and current is not None and \":\" in stripped:\n                key, _, val = stripped.partition(\":\")\n                current[key.strip()] = val.strip()\n            elif indent < 2 and current is not None and \"id\" in current:\n                # Section ended\n                catalogue[current[\"id\"]] = current\n                current = None\n                in_violations = False\n        if current is not None and \"id\" in current:\n            catalogue[current[\"id\"]] = current\n        _RUBRIC_CATALOGUE_CACHE = catalogue\n        return catalogue\n    except Exception:\n        _RUBRIC_CATALOGUE_CACHE = {}\n        return _RUBRIC_CATALOGUE_CACHE\n\ndef _validate_provider_pair(\n    *,\n    codex_verdict: str,\n    rubric_violation_id: str,\n    severity: str,\n    file_line_cited: bool,\n    repo_root: Path,\n) -> Tuple[bool, str]:\n    \"\"\"Validate Case-B preconditions per spec.md §11.\n\n    A Case-B verdict from Codex (BLOCK with PASS from Claude) must carry:\n      - reproducible evidence (file:line OR command cited)\n      - rubric_violation_id ∈ rubric-violation-catalogue.yaml\n      - severity ∈ {P0, P1}\n\n    R1 S-CR-1 codifies: this function is a greenfield helper (NOT\n    preserving any prior provider-pair grandfather entry). ADR-097 was\n    \"Function-length advisory-permanent + 344-function grandfather list\"\n    — NO LLM/dispatcher/pair-rail content per `head -1` audit.\n\n    Returns:\n        (preconditions_met: bool, reason: str). Reason is \"ok\" when met;\n        otherwise a slug naming the specific precondition that failed\n        (downstream audit emit + reason_code).\n    \"\"\"\n    if codex_verdict != \"BLOCK\":\n        # Not a Case-B candidate — vacuously \"met\" for the dispatcher\n        return True, \"not_case_b\"\n    if not file_line_cited:\n        return False, \"missing_file_line\"\n    if not rubric_violation_id or len(rubric_violation_id) > 64:\n        return False, \"missing_or_invalid_rubric_id\"\n    catalogue = _load_rubric_catalogue(repo_root)\n    if not catalogue:\n        return False, \"catalogue_not_loaded\"\n    if rubric_violation_id not in catalogue:\n        return False, \"rubric_id_not_in_catalogue\"\n    if severity not in (\"P0\", \"P1\"):\n        return False, \"invalid_severity\"\n    return True, \"ok\"\n\ndef _compute_jaccard_bucket(claude_findings: List[str], codex_findings: List[str]) -> str:\n    \"\"\"Bucket the Jaccard similarity for Case-E divergence detection.\n\n    Phase 3 uses bucketed similarity (NEVER raw float) per Sec MF-3\n    `_PAIR_RAIL_CASE_EMIT_ALLOWLIST` (raw float would leak prompt\n    content / response content via correlated audit-log readout).\n\n    Buckets per spec.md §11 R1.5-4 fix:\n      - \"<=0.3\" → low similarity = high divergence → Case-E flag\n      - \"0.3-0.5\"\n      - \"0.5-0.8\"\n      - \">0.8\" → high similarity = aligned reviews\n    \"\"\"\n    if not claude_findings and not codex_findings:\n        return \">0.8\"  # both empty = perfectly aligned\n    set_c = {f.strip().lower() for f in claude_findings if f.strip()}\n    set_x = {f.strip().lower() for f in codex_findings if f.strip()}\n    if not set_c and not set_x:\n        return \">0.8\"\n    inter = len(set_c & set_x)\n    union = len(set_c | set_x)\n    if union == 0:\n        return \">0.8\"\n    sim = inter / union\n    if sim <= 0.3:\n        return \"<=0.3\"\n    if sim <= 0.5:\n        return \"0.3-0.5\"\n    if sim <= 0.8:\n        return \"0.5-0.8\"\n    return \">0.8\"\n\ndef _hash_file_path_prefix(file_path: str) -> str:\n    \"\"\"Compute 16-hex SHA-256 prefix of file path (LLM06 side-channel guard).\"\"\"\n    import hashlib\n    if not file_path:\n        return \"\"\n    return hashlib.sha256(file_path.encode(\"utf-8\")).hexdigest()[:16]\n\ndef _resolve_human_triage_grace_h(severity: str) -> int:\n    \"\"\"Return human-triage grace hours per R1 S-TDE-4.\n\n    P1 violations get a 24h grace window (env-overridable via\n    CEO_PAIR_RAIL_HUMAN_TRIAGE_HOURS, clamped to [0, 24] per ADR-108\n    + Codex iter 1 P1-2). P0 = 0h (immediate block).\n    Outside-of-grace P1 closes-as-advisory.\n\n    Codex iter 1 P1-2 fix: env override is clamped to ``min(value, 24)``\n    so an Owner setting `CEO_PAIR_RAIL_HUMAN_TRIAGE_HOURS=1000` cannot\n    extend the grace beyond the ADR-108-mandated 24h ceiling. Lower\n    bound stays 0 (allows mechanical-immediate-close override).\n    \"\"\"\n    if severity != \"P1\":\n        return 0\n    raw = os.environ.get(\"CEO_PAIR_RAIL_HUMAN_TRIAGE_HOURS\", \"24\")\n    try:\n        h = int(raw)\n        # Clamp to [0, 24] per ADR-108 §Operational labeling protocol.\n        return max(0, min(h, 24))\n    except (TypeError, ValueError):\n        return 24\n\n_TIMEOUT_MS_MAX = 6_000_000\n\ndef _timeout_ms(value_s: float) -> int:\n    \"\"\"Convert an effective-budget in SECONDS to bounded integer ms.\n\n    Fail-safe: a non-numeric / NaN / infinite input yields 0 (the\n    \"unknown budget\" sentinel) rather than raising into the emit\n    wrappers' fail-open catch, which would drop the event.\n    \"\"\"\n    try:\n        ms = int(float(value_s) * 1000)\n    except (TypeError, ValueError, OverflowError):\n        return 0\n    return max(0, min(_TIMEOUT_MS_MAX, ms))\n\n__all__ = (\n    '_decide',\n    '_read_event_from_stdin',\n    '_extract_proposed_content',\n    'main',\n    '_RUBRIC_CATALOGUE_CACHE',\n    '_load_rubric_catalogue',\n    '_validate_provider_pair',\n    '_compute_jaccard_bucket',\n    '_hash_file_path_prefix',\n    '_resolve_human_triage_grace_h',\n    '_TIMEOUT_MS_MAX',\n    '_timeout_ms',\n)\n","numLines":571,"startLine":1,"totalLines":571}},"tool_result_meta":[{"id":"toolu_01K9C1VmdmQ58vbhAs1RHFJm","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NqcdxfEdqRgm4UMgRf","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LHut6ZZ4CZUpbpbpcspoq1","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_04.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12447,"cache_read_input_tokens":106297,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12447},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"243fc57f-0510-4c36-9a96-fd10a9cff14d","timestamp":"2026-11-13T18:10:58.053Z","request_id":"req_011Ch1NqcRpGdA8CFSUatSCD","wire_tool_inputs":{"toolu_01LHut6ZZ4CZUpbpbpcspoq1":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_04.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LHut6ZZ4CZUpbpbpcspoq1","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\tfrom ._shared import *\n3\t\n4\t# QDSAA-FUNCAO-LONGA: evento forense completo mantém campos correlatos; separar normalização poderia publicar retrato parcial.\n5\tdef _emit_pair_rail_review_expected(\n6\t    *,\n7\t    tool_name: str,\n8\t    session_id: str = \"\",\n9\t    file_path: str = \"\",\n10\t    review_id: str = \"\",\n11\t    timeout_s: float = 0.0,\n12\t) -> None:\n13\t    \"\"\"Best-effort audit emit of pair_rail_review_expected. Fail-OPEN.\n14\t\n15\t    PLAN-161 C5 (r3 F2 + r4 F1): the durable session-correlated DENOMINATOR\n16\t    for the /ceo-boot `pair_rail` activity-conditioned liveness row. Called\n17\t    from `_decide()` only after the kill-switch / non-write-tool / not-L3+ /\n18\t    sentinel-bypass arms have all returned — i.e. a Codex review is\n19\t    definitely being ENTERED.\n20\t\n21\t    r5 F2: ``review_id`` is the per-invocation correlation id generated at\n22\t    review entry (`os.urandom(8).hex()`, 16-hex). The SAME id rides this\n23\t    emit AND the matching `pair_rail_case` emit of the same `_decide()`\n24\t    invocation, so the /ceo-boot deficit pairs invocation-exact — counting\n25\t    (even (session, file-hash)-bucketed) cannot pair a specific expected\n26\t    with its OWN case. Forwarded only when the resolved audit_emit's\n27\t    signature accepts it (``__kwdefaults__`` probe), so a version-skewed\n28\t    audit_emit degrades to the id-less legacy emit instead of a TypeError\n29\t    that would swallow the whole event (fail-open regression class).\n30\t\n31\t    r4 F2 (kept as the legacy fallback + harmless secondary key):\n32\t    ``file_path`` is hashed here with the SAME helper the\n33\t    `pair_rail_case` emit uses (`_hash_file_path_prefix` — 16-hex SHA-256\n34\t    prefix, raw path NEVER on the wire per LLM06) so id-less events can\n35\t    still pair per (session, file-hash) BUCKET.\n36\t\n37\t    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n38\t    budget for this invocation in SECONDS (resolved in `main()`, threaded\n39\t    through `_decide_with_matrix` → `_decide`). It exists so a case F\n40\t    caused by a sub-floor `CEO_PAIR_RAIL_TIMEOUT_S` export stops being\n41\t    indistinguishable from a genuine Codex outage (§4(i) residual — the\n42\t    quiet knob was stealthier than the documented kill-switch). It reaches\n43\t    the wire as the INTEGER-millisecond `timeout_ms` (see `_timeout_ms`:\n44\t    canonical_json forbids floats in HMAC-covered fields), forwarded under\n45\t    the SAME `__kwdefaults__` skew guard as `review_id`.\n46\t\n47\t    Import resolution mirrors `_emit_pair_rail_case` (staged-dir override →\n48\t    canonical layout → PYTHONPATH). hasattr-guarded: a pre-ceremony\n49\t    audit_emit without `emit_pair_rail_review_expected` is a silent no-op.\n50\t    Deliberately NO `CEO_PAIR_RAIL_AUDIT_SINK` write — the sink is the\n51\t    matrix tests' `pair_rail_case` capture surface and must not grow\n52\t    extra rows under their counts.\n53\t    \"\"\"\n54\t    _ae = None\n55\t    try:\n56\t        # Resolution 1: test-only staged-dir override.\n57\t        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n58\t        if staged_dir:\n59\t            staged_path = Path(staged_dir)\n60\t            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n61\t                if str(staged_path) not in sys.path:\n62\t                    sys.path.insert(0, str(staged_path))\n63\t                try:\n64\t                    from _lib import audit_emit as _ae  # type: ignore\n65\t                except Exception:\n66\t                    _ae = None\n67\t        # Resolution 2: canonical layout.\n68\t        if _ae is None:\n69\t            hooks_dir = Path(__file__).resolve().parent\n70\t            if str(hooks_dir) not in sys.path:\n71\t                sys.path.insert(0, str(hooks_dir))\n72\t            try:\n73\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n74\t            except Exception:\n75\t                _ae = None\n76\t        # Resolution 3: PYTHONPATH already configured.\n77\t        if _ae is None:\n78\t            try:\n79\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n80\t            except Exception:\n81\t                _ae = None\n82\t        if _ae is None or not hasattr(_ae, \"emit_pair_rail_review_expected\"):\n83\t            return\n84\t        _kwargs = {\n85\t            \"session_id\": session_id,\n86\t            \"tool_name\": tool_name,\n87\t            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n88\t        }\n89\t        # r5 F2 — forward review_id only when the resolved audit_emit\n90\t        # accepts it (kw-only param with default → visible in\n91\t        # __kwdefaults__). A version-skewed audit_emit thus degrades to\n92\t        # the id-less legacy emit instead of a TypeError swallowed by the\n93\t        # outer fail-open (which would drop the WHOLE event).\n94\t        _kwd = getattr(\n95\t            _ae.emit_pair_rail_review_expected, \"__kwdefaults__\", None\n96\t        ) or {}\n97\t        if \"review_id\" in _kwd:\n98\t            _kwargs[\"review_id\"] = review_id\n99\t        # ADR-110-AMEND-2 §1.6 — same skew guard: a pre-ceremony\n100\t        # audit_emit without `timeout_ms` degrades to the budget-less\n101\t        # legacy emit instead of a TypeError that would drop the WHOLE\n102\t        # denominator event (fail-open regression class).\n103\t        if \"timeout_ms\" in _kwd:\n104\t            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n105\t        _ae.emit_pair_rail_review_expected(**_kwargs)\n106\t    except Exception:\n107\t        pass  # fail-OPEN — never block on audit\n108\t\n109\t# QDSAA-FUNCAO-LONGA: emissão principal e sink derivam o mesmo caso, severidade e correlação antes de qualquer escrita.\n110\tdef _emit_pair_rail_case(\n111\t    *,\n112\t    case: str,\n113\t    claude_verdict: str,\n114\t    codex_verdict: str,\n115\t    tool_name: str,\n116\t    file_path: str,\n117\t    precondition_met: bool = False,\n118\t    rubric_violation_id: str = \"\",\n119\t    severity: str = \"\",\n120\t    jaccard_bucket: str = \"\",\n121\t    repo_root: Optional[Path] = None,\n122\t    session_id: str = \"\",\n123\t    review_id: str = \"\",\n124\t    timeout_s: float = 0.0,\n125\t) -> None:\n126\t    \"\"\"Best-effort audit emit of pair_rail_case. Fail-OPEN.\n127\t\n128\t    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n129\t    budget this invocation ran under, in SECONDS. A case F emitted under a\n130\t    sub-floor budget (`CEO_PAIR_RAIL_TIMEOUT_S=5`) and a case F from a\n131\t    genuine Codex outage were byte-identical before this field existed —\n132\t    §4(i). It reaches the wire as the INTEGER-millisecond `timeout_ms`\n133\t    (see `_timeout_ms`), forwarded under the SAME `__kwdefaults__` skew\n134\t    guard as `review_id`.\n135\t\n136\t    r5 F2: ``review_id`` is the per-invocation correlation id generated by\n137\t    `_decide()` at review entry and threaded here via `_decide_with_matrix`\n138\t    — identical on this case emit and its own `pair_rail_review_expected`.\n139\t    Forwarded only when the resolved audit_emit's signature accepts it\n140\t    (``__kwdefaults__`` probe): a version-skewed (pre-land) audit_emit\n141\t    degrades to the id-less legacy emit instead of raising TypeError into\n142\t    the outer fail-open catch, which would silently drop the whole case\n143\t    emit and MANUFACTURE a liveness deficit.\n144\t\n145\t    Import resolution order (first hit wins):\n146\t\n147\t    1. Test-only env override ``CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR``\n148\t       points at a directory containing ``_lib/audit_emit.py``. Used by\n149\t       the Phase 3 staging tests to load the staged audit_emit before\n150\t       the ceremony cp lands it canonical. Removed post-ceremony.\n151\t    2. Canonical layout: ``Path(__file__).resolve().parent`` (the\n152\t       canonical ``.claude/hooks/`` dir) contains ``_lib/audit_emit.py``.\n153\t       Standard production path post-ceremony.\n154\t    3. PYTHONPATH-discovered ``_lib.audit_emit`` (rare adopter\n155\t       scenario where the canonical hooks dir isn't this file's parent).\n156\t\n157\t    Any failure → return silently (fail-OPEN per ADR-106).\n158\t    \"\"\"\n159\t    _ae = None\n160\t    try:\n161\t        # Resolution 1: test-only staged-dir override.\n162\t        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n163\t        if staged_dir:\n164\t            staged_path = Path(staged_dir)\n165\t            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n166\t                if str(staged_path) not in sys.path:\n167\t                    sys.path.insert(0, str(staged_path))\n168\t                try:\n169\t                    from _lib import audit_emit as _ae  # type: ignore\n170\t                except Exception:\n171\t                    _ae = None\n172\t        # Resolution 2: canonical layout.\n173\t        if _ae is None:\n174\t            hooks_dir = Path(__file__).resolve().parent\n175\t            if str(hooks_dir) not in sys.path:\n176\t                sys.path.insert(0, str(hooks_dir))\n177\t            try:\n178\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n179\t            except Exception:\n180\t                _ae = None\n181\t        # Resolution 3: PYTHONPATH already configured.\n182\t        if _ae is None:\n183\t            try:\n184\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n185\t            except Exception:\n186\t                _ae = None\n187\t        # Defense-in-depth: ALSO breadcrumb to CEO_PAIR_RAIL_AUDIT_SINK\n188\t        # (the spike's per-test file sink). Used by Phase 3 matrix tests\n189\t        # to capture matrix decisions in the same JSONL surface as the\n190\t        # spike's `_emit_audit`. Production deployment relies on\n191\t        # audit_emit.emit_pair_rail_case being reachable; the sink\n192\t        # breadcrumb is a forensic continuity bridge for tests + adopters\n193\t        # without canonical audit-log writability.\n194\t        sink = os.environ.get(\"CEO_PAIR_RAIL_AUDIT_SINK\")\n195\t        if sink:\n196\t            try:\n197\t                with open(sink, \"a\", encoding=\"utf-8\") as f:\n198\t                    f.write(json.dumps({\n199\t                        \"action\": \"pair_rail_case\",\n200\t                        \"case\": case,\n201\t                        \"claude_verdict\": claude_verdict,\n202\t                        \"codex_verdict\": codex_verdict,\n203\t                        \"tool_name\": tool_name,\n204\t                        \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n205\t                        \"review_id\": review_id,\n206\t                        \"precondition_met\": precondition_met,\n207\t                        \"rubric_violation_id\": rubric_violation_id,\n208\t                        \"severity\": severity,\n209\t                        \"jaccard_similarity_bucket\": jaccard_bucket,\n210\t                        \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n211\t                        # ADR-110-AMEND-2 §1.6 — forensic parity with the\n212\t                        # signed row (same integer-ms encoding). The sink\n213\t                        # BYPASSES audit_emit, so the bound is applied\n214\t                        # here too — never write an unbounded caller\n215\t                        # value to a file.\n216\t                        \"timeout_ms\": _timeout_ms(timeout_s),\n217\t                    }, ensure_ascii=False) + \"\\n\")\n218\t            except Exception:\n219\t                pass\n220\t\n221\t        if _ae is None or not hasattr(_ae, \"emit_pair_rail_case\"):\n222\t            return\n223\t        _kwargs = {\n224\t            \"case\": case,\n225\t            \"claude_verdict\": claude_verdict,\n226\t            \"codex_verdict\": codex_verdict,\n227\t            \"tool_name\": tool_name,\n228\t            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n229\t            \"precondition_met\": precondition_met,\n230\t            \"rubric_violation_id\": rubric_violation_id,\n231\t            \"severity\": severity,\n232\t            \"jaccard_similarity_bucket\": jaccard_bucket,\n233\t            \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n234\t            # PLAN-161 C5 (r3 F2): the hook payload's session id, no longer\n235\t            # discarded — the typed default \"\" only remains for legacy\n236\t            # callers.\n237\t            \"session_id\": session_id,\n238\t        }\n239\t        # r5 F2 — forward review_id only when the resolved audit_emit\n240\t        # accepts it (see _emit_pair_rail_review_expected; same skew\n241\t        # guard — a TypeError here would silently DROP the case emit and\n242\t        # manufacture a /ceo-boot deficit, worse than an id-less emit).\n243\t        _kwd = getattr(\n244\t            _ae.emit_pair_rail_case, \"__kwdefaults__\", None\n245\t        ) or {}\n246\t        if \"review_id\" in _kwd:\n247\t            _kwargs[\"review_id\"] = review_id\n248\t        # ADR-110-AMEND-2 §1.6 — same skew guard: a version-skewed\n249\t        # audit_emit without `timeout_ms` degrades to the budget-less\n250\t        # legacy emit rather than raising a TypeError that would DROP the\n251\t        # case emit and manufacture a /ceo-boot liveness deficit.\n252\t        if \"timeout_ms\" in _kwd:\n253\t            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n254\t        _ae.emit_pair_rail_case(**_kwargs)\n255\t    except Exception:\n256\t        pass  # fail-OPEN — never block on audit\n257\t\n258\tdef _load_pair_rail_decide():  # type: ignore[no-untyped-def]\n259\t    \"\"\"Resolve the canonical pure decision module `_lib.pair_rail_decide`.\n260\t\n261\t    Mirrors `_emit_pair_rail_case`'s Resolution-2 (canonical layout):\n262\t    the `.claude/hooks/` dir that houses this file also houses `_lib/`.\n263\t    Returns the module or None (fail-OPEN — caller must tolerate None).\n264\t    \"\"\"\n265\t    try:\n266\t        hooks_dir = Path(__file__).resolve().parent\n267\t        if str(hooks_dir) not in sys.path:\n268\t            sys.path.insert(0, str(hooks_dir))\n269\t        from _lib import pair_rail_decide as _prd  # type: ignore\n270\t        return _prd\n271\t    except Exception:\n272\t        return None\n273\t\n274\tdef _base_to_verdicts(base: Dict[str, Any]) -> Tuple[str, str, str]:\n275\t    \"\"\"Translate the procedural `base` decision dict into the verdict\n276\t    triple `_lib.pair_rail_decide.detect_case()` consumes.\n277\t\n278\t    PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W1). PURE + fail-OPEN:\n279\t    any malformed input yields the no-case tuple `(\"\", \"\", \"\")` (which\n280\t    `detect_case()` maps to None → no matrix emit), never raises.\n281\t\n282\t    The substring contract is byte-identical to the LEGACY inline\n283\t    classification in `_decide_with_matrix` (verified against\n284\t    `_decide()` returns, source lines 595-679). Precedence MUST match\n285\t    the inline arm order: F (Codex fail) → B (write-shape/block) →\n286\t    A (review clean) → None (sentinel / kill-switch / out-of-scope).\n287\t\n288\t    Returns:\n289\t        (claude_verdict, codex_verdict, jaccard_bucket).\n290\t        claude_verdict is \"PASS\" for every reachable matrix case\n291\t        (Claude already passed to reach a PreToolUse write). Sentinel\n292\t        bypass + non-matrix short-circuits return (\"\", \"\", \"\").\n293\t    \"\"\"\n294\t    try:\n295\t        sysmsg = base.get(\"systemMessage\", \"\")\n296\t        if not isinstance(sysmsg, str):\n297\t            sysmsg = \"\"\n298\t        decision = base.get(\"decision\", \"allow\")\n299\t        # Arm 1 — Case F (Codex unavailable / timeout / malformed).\n300\t        if (\n301\t            \"Codex unavailable\" in sysmsg\n302\t            or \"Codex timeout\" in sysmsg\n303\t            or \"Codex malformed\" in sysmsg\n304\t        ):\n305\t            sysmsg_lower = sysmsg.lower()\n306\t            if \"malformed\" in sysmsg_lower:\n307\t                return \"PASS\", \"MALFORMED\", \"\"\n308\t            # timeout AND unavailable both coerce to TIMEOUT (schema-\n309\t            # compatible; precise reason stays in base[systemMessage]).\n310\t            return \"PASS\", \"TIMEOUT\", \"\"\n311\t        # Arm 2 — sentinel bypass is NOT a matrix case (no verdicts).\n312\t        if \"bypass via Architect sentinel\" in sysmsg:\n313\t            return \"\", \"\", \"\"\n314\t        # Arm 3 — Case B (write-shape advisory OR legacy block path).\n315\t        is_advisory_writeshape = (\n316\t            \"PAIR-RAIL-ADVISORY\" in sysmsg and \"write-shaped\" in sysmsg\n317\t        )\n318\t        if decision == \"block\" or is_advisory_writeshape:\n319\t            return \"PASS\", \"BLOCK\", \"\"\n320\t        # Arm 4 — Case A (clean review).\n321\t        if \"review clean\" in sysmsg:\n322\t            return \"PASS\", \"PASS\", \"\"\n323\t        # Arm 5 — non-matrix short-circuit (kill-switch / out-of-scope).\n324\t        return \"\", \"\", \"\"\n325\t    except Exception:\n326\t        # Fail-OPEN: derivation error → no-case tuple (detect_case → None).\n327\t        return \"\", \"\", \"\"\n328\t\n329\t# QDSAA-FUNCAO-LONGA: matriz assimétrica em ordem normativa preserva precedência do VETO e emissão do caso correspondente.\n330\tdef _decide_with_matrix(\n331\t    *,\n332\t    tool_name: str,\n333\t    file_path: str,\n334\t    proposed_content: str,\n335\t    repo_root: Path,\n336\t    timeout_s: float,\n337\t    session_id: str = \"\",\n338\t) -> Dict[str, Any]:\n339\t    \"\"\"Phase 3 asymmetric VETO matrix wrapper around `_decide()`.\n340\t\n341\t    Calls the canonical `_decide()` codepath to get the Phase 1 verdict\n342\t    (review-only semantics), then applies the Cases A-F matrix:\n343\t\n344\t      - canonical path returns ALLOW with no matrix-relevant signal → Case A\n345\t      - canonical path returns advisory write-shape (PLAN-092 Wave B\n346\t        SHADOW-strip per ADR-127) → validate Case-B preconditions:\n347\t          + preconditions met → Case B (advisory + audit)\n348\t          + preconditions NOT met → Case B' fail-OPEN (advisory)\n349\t      - canonical path returns ALLOW with `systemMessage` containing\n350\t        \"Codex unavailable\" / \"timeout\" / \"malformed\" → Case F (allow)\n351\t      - canonical path returns ALLOW with sentinel bypass → not a matrix case\n352\t        (already authorized by Owner sentinel)\n353\t\n354\t    Each matrix arm emits `pair_rail_case` with case + verdicts +\n355\t    preconditions + rubric metadata.\n356\t\n357\t    R1 S-Perf-3: matrix lookup uses O(1) dict (NOT linear scan); the\n358\t    ``_MATRIX_DECISIONS`` table below dispatches in constant time.\n359\t    \"\"\"\n360\t    # r5 F2 — reset the per-invocation correlation slot BEFORE _decide():\n361\t    # a stale id from a prior in-process invocation must never attach to\n362\t    # a case whose review path was not entered this time. _decide() sets\n363\t    # it (os.urandom(8).hex()) exactly when the review path is ENTERED,\n364\t    # in the same breath as the pair_rail_review_expected emit.\n365\t    global _CURRENT_REVIEW_ID\n366\t    _CURRENT_REVIEW_ID = \"\"\n367\t\n368\t    # Compute base decision via spike _decide()\n369\t    base = _decide(\n370\t        tool_name=tool_name,\n371\t        file_path=file_path,\n372\t        proposed_content=proposed_content,\n373\t        repo_root=repo_root,\n374\t        timeout_s=timeout_s,\n375\t        session_id=session_id,\n376\t    )\n377\t\n378\t    # r5 F2 — the id generated by THIS _decide() invocation (or \"\" when\n379\t    # the review path was never entered / kill-switch / out-of-scope /\n380\t    # sentinel arms returned early — those paths emit no case anyway).\n381\t    review_id = _CURRENT_REVIEW_ID\n382\t\n383\t    sysmsg = base.get(\"systemMessage\", \"\")\n384\t\n385\t    # PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W2): delegate the\n386\t    # verdict→case CLASSIFICATION to the canonical pure module\n387\t    # `_lib.pair_rail_decide.detect_case()`. The procedural shell\n388\t    # (Codex invoke, patch detect — both inside `_decide()` above), the\n389\t    # B'/precondition resolution, and every audit emit STAY INLINE.\n390\t    # `evaluate()` is DELIBERATELY NOT called: it would convert a\n391\t    # precondition-unmet Case B into B' (pair_rail_decide.py:197-204),\n392\t    # diverging from production's byte-identical `case=\"B\"` emit.\n393\t    #\n394\t    # Fail-OPEN: any error in verdict-derivation / classification / lib\n395\t    # import returns `base` (implicit allow), never raises.\n396\t    try:\n397\t        cv, xv, jb = _base_to_verdicts(base)\n398\t        _prd = _load_pair_rail_decide()\n399\t        matrix_case = (\n400\t            _prd.detect_case(claude_verdict=cv, codex_verdict=xv, jaccard_bucket=jb)\n401\t            if _prd is not None\n402\t            else None\n403\t        )\n404\t    except Exception:\n405\t        return base  # fail-OPEN — never block the user on a classifier bug\n406\t\n407\t    if matrix_case is None:\n408\t        # r6 F1 — discriminate on the invocation correlation id. A\n409\t        # non-empty `review_id` proves THIS _decide() invocation ENTERED\n410\t        # the review path (it emitted `pair_rail_review_expected`) and\n411\t        # returned a base decision that classifies to NO matrix case.\n412\t        # The only post-entry return that lands here is the ADVISORY\n413\t        # parse-miss arm (`_decide()` verdict==\"ADVISORY\": codex RAN and\n414\t        # ANSWERED, but the response parsed to no structured PASS/BLOCK\n415\t        # — `_base_to_verdicts` Arm 5 → detect_case None). Without a\n416\t        # case emit that expected review_id stays OUTSTANDING forever →\n417\t        # a FALSE /ceo-boot S254 deficit (\"hook died between the two\n418\t        # emits\") for a rail that actually answered. Emit the accounted\n419\t        # fail-open terminal case — case=F, codex_verdict=ADVISORY (both\n420\t        # already in the audit_emit closed enums; no schema change) —\n421\t        # carrying the SAME review_id so expected<->case pairs and the\n422\t        # row is LADDERED by its failopen bucket, exactly like the\n423\t        # sibling stop_review rail's parse-miss (`skipped_failopen`,\n424\t        # plan C5 r2 F2: unparseable is NEVER healthy). The deficit RED\n425\t        # stays reserved for an entered review with ZERO case emit (the\n426\t        # genuine S254 hook-death signal). An empty review_id = a\n427\t        # pre-review short-circuit (sentinel bypass / kill-switch /\n428\t        # out-of-scope / non-write tool) — byte-identical legacy\n429\t        # no-emit.\n430\t        if review_id:\n431\t            _emit_pair_rail_case(\n432\t                case=\"F\", claude_verdict=\"PASS\", codex_verdict=\"ADVISORY\",\n433\t                tool_name=tool_name, file_path=file_path,\n434\t                session_id=session_id, review_id=review_id,\n435\t                timeout_s=timeout_s,\n436\t            )\n437\t        return base\n438\t\n439\t    case_value = getattr(matrix_case, \"value\", matrix_case)\n440\t\n441\t    if case_value == \"F\":\n442\t        # Case F — fail-OPEN. The codex_verdict sub-discrimination\n443\t        # (MALFORMED vs TIMEOUT, with UNAVAILABLE coercing to TIMEOUT)\n444\t        # is carried by `_base_to_verdicts()` in `xv`; emit it verbatim.\n445\t        _emit_pair_rail_case(\n446\t            case=\"F\", claude_verdict=\"PASS\", codex_verdict=xv,\n447\t            tool_name=tool_name, file_path=file_path,\n448\t            session_id=session_id, review_id=review_id,\n449\t            timeout_s=timeout_s,\n450\t        )\n451\t        return base\n452\t\n453\t    if case_value == \"B\":\n454\t        # Procedural Case-B audit emit (advisory-only per ADR-127).\n455\t        # B'/precondition resolution stays INLINE (NOT via evaluate()).\n456\t        # precondition_met reflects whether substantive rubric evidence\n457\t        # was attached (False at Phase 3; True at Phase 4 corpus-replay).\n458\t        preconditions_met, reason_slug = _validate_provider_pair(\n459\t            codex_verdict=\"BLOCK\",\n460\t            rubric_violation_id=\"\",  # not extracted from procedural grammar\n461\t            severity=\"\",\n462\t            file_line_cited=False,\n463\t            repo_root=repo_root,\n464\t        )\n465\t        _emit_pair_rail_case(\n466\t            case=\"B\", claude_verdict=\"PASS\", codex_verdict=\"BLOCK\",\n467\t            tool_name=tool_name, file_path=file_path,\n468\t            precondition_met=preconditions_met,\n469\t            rubric_violation_id=\"\",\n470\t            severity=\"P0\",  # write-shape violation defaulted P0 procedural\n471\t            session_id=session_id, review_id=review_id,\n472\t            timeout_s=timeout_s,\n473\t        )\n474\t        # Advisory-only return — `base` already carries the advisory\n475\t        # systemMessage (Site 1). No `decision` key — schema treats\n476\t        # absence as implicit allow.\n477\t        return base\n478\t\n479\t    if case_value == \"A\":\n480\t        _emit_pair_rail_case(\n481\t            case=\"A\", claude_verdict=\"PASS\", codex_verdict=\"PASS\",\n482\t            tool_name=tool_name, file_path=file_path,\n483\t            session_id=session_id, review_id=review_id,\n484\t            timeout_s=timeout_s,\n485\t        )\n486\t        return base\n487\t\n488\t    # Defensive: any other detected case (C/D/E — confirmed unreachable\n489\t    # from the procedural `base`, plan §2a.2) → no emit, fail-OPEN allow.\n490\t    return base\n491\t\n492\tdef _verify_pin_cli(argv: List[str]) -> int:\n493\t    \"\"\"ADR-182 CLI entry — `check_pair_rail.py --verify-codex-pin\n494\t    [<launcher-path>]`. Shared verification surface for\n495\t    `pair-rail-gate.sh` Gate 4 and operator forensics: prints the\n496\t    `verify_codex_payload()` result as one JSON object.\n497\t\n498\t    Exit codes (gate.sh contract):\n499\t      0 — verified (payload sha256 matches the manifest entry)\n500\t      1 — fail-CLOSED arm (mismatch / triple_missing)\n501\t      3 — INFRA arm (manifest unreadable, launcher/payload missing, ...)\n502\t    \"\"\"\n503\t    launcher = argv[0] if argv else None\n504\t    res = verify_codex_payload(launcher)\n505\t    try:\n506\t        sys.stdout.write(json.dumps(res, ensure_ascii=False) + \"\\n\")\n507\t    except Exception:\n508\t        pass\n509\t    status = res.get(\"status\")\n510\t    if status in (\"verified\", \"compatible\"):\n511\t        return 0\n512\t    if status in (\"mismatch\", \"triple_missing\"):\n513\t        return 1\n514\t    return 3\n515\t\n516\t__all__ = (\n517\t    '_emit_pair_rail_review_expected',\n518\t    '_emit_pair_rail_case',\n519\t    '_load_pair_rail_decide',\n520\t    '_base_to_verdicts',\n521\t    '_decide_with_matrix',\n522\t    '_verify_pin_cli',\n523\t)\n524\t"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"695ed423-f22e-4974-ac0c-20175b5e4bc6","timestamp":"2026-11-13T18:10:58.078Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_04.py","content":"from __future__ import annotations\nfrom ._shared import *\n\n# QDSAA-FUNCAO-LONGA: evento forense completo mantém campos correlatos; separar normalização poderia publicar retrato parcial.\ndef _emit_pair_rail_review_expected(\n    *,\n    tool_name: str,\n    session_id: str = \"\",\n    file_path: str = \"\",\n    review_id: str = \"\",\n    timeout_s: float = 0.0,\n) -> None:\n    \"\"\"Best-effort audit emit of pair_rail_review_expected. Fail-OPEN.\n\n    PLAN-161 C5 (r3 F2 + r4 F1): the durable session-correlated DENOMINATOR\n    for the /ceo-boot `pair_rail` activity-conditioned liveness row. Called\n    from `_decide()` only after the kill-switch / non-write-tool / not-L3+ /\n    sentinel-bypass arms have all returned — i.e. a Codex review is\n    definitely being ENTERED.\n\n    r5 F2: ``review_id`` is the per-invocation correlation id generated at\n    review entry (`os.urandom(8).hex()`, 16-hex). The SAME id rides this\n    emit AND the matching `pair_rail_case` emit of the same `_decide()`\n    invocation, so the /ceo-boot deficit pairs invocation-exact — counting\n    (even (session, file-hash)-bucketed) cannot pair a specific expected\n    with its OWN case. Forwarded only when the resolved audit_emit's\n    signature accepts it (``__kwdefaults__`` probe), so a version-skewed\n    audit_emit degrades to the id-less legacy emit instead of a TypeError\n    that would swallow the whole event (fail-open regression class).\n\n    r4 F2 (kept as the legacy fallback + harmless secondary key):\n    ``file_path`` is hashed here with the SAME helper the\n    `pair_rail_case` emit uses (`_hash_file_path_prefix` — 16-hex SHA-256\n    prefix, raw path NEVER on the wire per LLM06) so id-less events can\n    still pair per (session, file-hash) BUCKET.\n\n    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n    budget for this invocation in SECONDS (resolved in `main()`, threaded\n    through `_decide_with_matrix` → `_decide`). It exists so a case F\n    caused by a sub-floor `CEO_PAIR_RAIL_TIMEOUT_S` export stops being\n    indistinguishable from a genuine Codex outage (§4(i) residual — the\n    quiet knob was stealthier than the documented kill-switch). It reaches\n    the wire as the INTEGER-millisecond `timeout_ms` (see `_timeout_ms`:\n    canonical_json forbids floats in HMAC-covered fields), forwarded under\n    the SAME `__kwdefaults__` skew guard as `review_id`.\n\n    Import resolution mirrors `_emit_pair_rail_case` (staged-dir override →\n    canonical layout → PYTHONPATH). hasattr-guarded: a pre-ceremony\n    audit_emit without `emit_pair_rail_review_expected` is a silent no-op.\n    Deliberately NO `CEO_PAIR_RAIL_AUDIT_SINK` write — the sink is the\n    matrix tests' `pair_rail_case` capture surface and must not grow\n    extra rows under their counts.\n    \"\"\"\n    _ae = None\n    try:\n        # Resolution 1: test-only staged-dir override.\n        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n        if staged_dir:\n            staged_path = Path(staged_dir)\n            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n                if str(staged_path) not in sys.path:\n                    sys.path.insert(0, str(staged_path))\n                try:\n                    from _lib import audit_emit as _ae  # type: ignore\n                except Exception:\n                    _ae = None\n        # Resolution 2: canonical layout.\n        if _ae is None:\n            hooks_dir = Path(__file__).resolve().parent\n            if str(hooks_dir) not in sys.path:\n                sys.path.insert(0, str(hooks_dir))\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        # Resolution 3: PYTHONPATH already configured.\n        if _ae is None:\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        if _ae is None or not hasattr(_ae, \"emit_pair_rail_review_expected\"):\n            return\n        _kwargs = {\n            \"session_id\": session_id,\n            \"tool_name\": tool_name,\n            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n        }\n        # r5 F2 — forward review_id only when the resolved audit_emit\n        # accepts it (kw-only param with default → visible in\n        # __kwdefaults__). A version-skewed audit_emit thus degrades to\n        # the id-less legacy emit instead of a TypeError swallowed by the\n        # outer fail-open (which would drop the WHOLE event).\n        _kwd = getattr(\n            _ae.emit_pair_rail_review_expected, \"__kwdefaults__\", None\n        ) or {}\n        if \"review_id\" in _kwd:\n            _kwargs[\"review_id\"] = review_id\n        # ADR-110-AMEND-2 §1.6 — same skew guard: a pre-ceremony\n        # audit_emit without `timeout_ms` degrades to the budget-less\n        # legacy emit instead of a TypeError that would drop the WHOLE\n        # denominator event (fail-open regression class).\n        if \"timeout_ms\" in _kwd:\n            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n        _ae.emit_pair_rail_review_expected(**_kwargs)\n    except Exception:\n        pass  # fail-OPEN — never block on audit\n\n# QDSAA-FUNCAO-LONGA: emissão principal e sink derivam o mesmo caso, severidade e correlação antes de qualquer escrita.\ndef _emit_pair_rail_case(\n    *,\n    case: str,\n    claude_verdict: str,\n    codex_verdict: str,\n    tool_name: str,\n    file_path: str,\n    precondition_met: bool = False,\n    rubric_violation_id: str = \"\",\n    severity: str = \"\",\n    jaccard_bucket: str = \"\",\n    repo_root: Optional[Path] = None,\n    session_id: str = \"\",\n    review_id: str = \"\",\n    timeout_s: float = 0.0,\n) -> None:\n    \"\"\"Best-effort audit emit of pair_rail_case. Fail-OPEN.\n\n    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n    budget this invocation ran under, in SECONDS. A case F emitted under a\n    sub-floor budget (`CEO_PAIR_RAIL_TIMEOUT_S=5`) and a case F from a\n    genuine Codex outage were byte-identical before this field existed —\n    §4(i). It reaches the wire as the INTEGER-millisecond `timeout_ms`\n    (see `_timeout_ms`), forwarded under the SAME `__kwdefaults__` skew\n    guard as `review_id`.\n\n    r5 F2: ``review_id`` is the per-invocation correlation id generated by\n    `_decide()` at review entry and threaded here via `_decide_with_matrix`\n    — identical on this case emit and its own `pair_rail_review_expected`.\n    Forwarded only when the resolved audit_emit's signature accepts it\n    (``__kwdefaults__`` probe): a version-skewed (pre-land) audit_emit\n    degrades to the id-less legacy emit instead of raising TypeError into\n    the outer fail-open catch, which would silently drop the whole case\n    emit and MANUFACTURE a liveness deficit.\n\n    Import resolution order (first hit wins):\n\n    1. Test-only env override ``CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR``\n       points at a directory containing ``_lib/audit_emit.py``. Used by\n       the Phase 3 staging tests to load the staged audit_emit before\n       the ceremony cp lands it canonical. Removed post-ceremony.\n    2. Canonical layout: ``Path(__file__).resolve().parent`` (the\n       canonical ``.claude/hooks/`` dir) contains ``_lib/audit_emit.py``.\n       Standard production path post-ceremony.\n    3. PYTHONPATH-discovered ``_lib.audit_emit`` (rare adopter\n       scenario where the canonical hooks dir isn't this file's parent).\n\n    Any failure → return silently (fail-OPEN per ADR-106).\n    \"\"\"\n    _ae = None\n    try:\n        # Resolution 1: test-only staged-dir override.\n        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n        if staged_dir:\n            staged_path = Path(staged_dir)\n            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n                if str(staged_path) not in sys.path:\n                    sys.path.insert(0, str(staged_path))\n                try:\n                    from _lib import audit_emit as _ae  # type: ignore\n                except Exception:\n                    _ae = None\n        # Resolution 2: canonical layout.\n        if _ae is None:\n            hooks_dir = Path(__file__).resolve().parent\n            if str(hooks_dir) not in sys.path:\n                sys.path.insert(0, str(hooks_dir))\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        # Resolution 3: PYTHONPATH already configured.\n        if _ae is None:\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        # Defense-in-depth: ALSO breadcrumb to CEO_PAIR_RAIL_AUDIT_SINK\n        # (the spike's per-test file sink). Used by Phase 3 matrix tests\n        # to capture matrix decisions in the same JSONL surface as the\n        # spike's `_emit_audit`. Production deployment relies on\n        # audit_emit.emit_pair_rail_case being reachable; the sink\n        # breadcrumb is a forensic continuity bridge for tests + adopters\n        # without canonical audit-log writability.\n        sink = os.environ.get(\"CEO_PAIR_RAIL_AUDIT_SINK\")\n        if sink:\n            try:\n                with open(sink, \"a\", encoding=\"utf-8\") as f:\n                    f.write(json.dumps({\n                        \"action\": \"pair_rail_case\",\n                        \"case\": case,\n                        \"claude_verdict\": claude_verdict,\n                        \"codex_verdict\": codex_verdict,\n                        \"tool_name\": tool_name,\n                        \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n                        \"review_id\": review_id,\n                        \"precondition_met\": precondition_met,\n                        \"rubric_violation_id\": rubric_violation_id,\n                        \"severity\": severity,\n                        \"jaccard_similarity_bucket\": jaccard_bucket,\n                        \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n                        # ADR-110-AMEND-2 §1.6 — forensic parity with the\n                        # signed row (same integer-ms encoding). The sink\n                        # BYPASSES audit_emit, so the bound is applied\n                        # here too — never write an unbounded caller\n                        # value to a file.\n                        \"timeout_ms\": _timeout_ms(timeout_s),\n                    }, ensure_ascii=False) + \"\\n\")\n            except Exception:\n                pass\n\n        if _ae is None or not hasattr(_ae, \"emit_pair_rail_case\"):\n            return\n        _kwargs = {\n            \"case\": case,\n            \"claude_verdict\": claude_verdict,\n            \"codex_verdict\": codex_verdict,\n            \"tool_name\": tool_name,\n            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n            \"precondition_met\": precondition_met,\n            \"rubric_violation_id\": rubric_violation_id,\n            \"severity\": severity,\n            \"jaccard_similarity_bucket\": jaccard_bucket,\n            \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n            # PLAN-161 C5 (r3 F2): the hook payload's session id, no longer\n            # discarded — the typed default \"\" only remains for legacy\n            # callers.\n            \"session_id\": session_id,\n        }\n        # r5 F2 — forward review_id only when the resolved audit_emit\n        # accepts it (see _emit_pair_rail_review_expected; same skew\n        # guard — a TypeError here would silently DROP the case emit and\n        # manufacture a /ceo-boot deficit, worse than an id-less emit).\n        _kwd = getattr(\n            _ae.emit_pair_rail_case, \"__kwdefaults__\", None\n        ) or {}\n        if \"review_id\" in _kwd:\n            _kwargs[\"review_id\"] = review_id\n        # ADR-110-AMEND-2 §1.6 — same skew guard: a version-skewed\n        # audit_emit without `timeout_ms` degrades to the budget-less\n        # legacy emit rather than raising a TypeError that would DROP the\n        # case emit and manufacture a /ceo-boot liveness deficit.\n        if \"timeout_ms\" in _kwd:\n            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n        _ae.emit_pair_rail_case(**_kwargs)\n    except Exception:\n        pass  # fail-OPEN — never block on audit\n\ndef _load_pair_rail_decide():  # type: ignore[no-untyped-def]\n    \"\"\"Resolve the canonical pure decision module `_lib.pair_rail_decide`.\n\n    Mirrors `_emit_pair_rail_case`'s Resolution-2 (canonical layout):\n    the `.claude/hooks/` dir that houses this file also houses `_lib/`.\n    Returns the module or None (fail-OPEN — caller must tolerate None).\n    \"\"\"\n    try:\n        hooks_dir = Path(__file__).resolve().parent\n        if str(hooks_dir) not in sys.path:\n            sys.path.insert(0, str(hooks_dir))\n        from _lib import pair_rail_decide as _prd  # type: ignore\n        return _prd\n    except Exception:\n        return None\n\ndef _base_to_verdicts(base: Dict[str, Any]) -> Tuple[str, str, str]:\n    \"\"\"Translate the procedural `base` decision dict into the verdict\n    triple `_lib.pair_rail_decide.detect_case()` consumes.\n\n    PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W1). PURE + fail-OPEN:\n    any malformed input yields the no-case tuple `(\"\", \"\", \"\")` (which\n    `detect_case()` maps to None → no matrix emit), never raises.\n\n    The substring contract is byte-identical to the LEGACY inline\n    classification in `_decide_with_matrix` (verified against\n    `_decide()` returns, source lines 595-679). Precedence MUST match\n    the inline arm order: F (Codex fail) → B (write-shape/block) →\n    A (review clean) → None (sentinel / kill-switch / out-of-scope).\n\n    Returns:\n        (claude_verdict, codex_verdict, jaccard_bucket).\n        claude_verdict is \"PASS\" for every reachable matrix case\n        (Claude already passed to reach a PreToolUse write). Sentinel\n        bypass + non-matrix short-circuits return (\"\", \"\", \"\").\n    \"\"\"\n    try:\n        sysmsg = base.get(\"systemMessage\", \"\")\n        if not isinstance(sysmsg, str):\n            sysmsg = \"\"\n        decision = base.get(\"decision\", \"allow\")\n        # Arm 1 — Case F (Codex unavailable / timeout / malformed).\n        if (\n            \"Codex unavailable\" in sysmsg\n            or \"Codex timeout\" in sysmsg\n            or \"Codex malformed\" in sysmsg\n        ):\n            sysmsg_lower = sysmsg.lower()\n            if \"malformed\" in sysmsg_lower:\n                return \"PASS\", \"MALFORMED\", \"\"\n            # timeout AND unavailable both coerce to TIMEOUT (schema-\n            # compatible; precise reason stays in base[systemMessage]).\n            return \"PASS\", \"TIMEOUT\", \"\"\n        # Arm 2 — sentinel bypass is NOT a matrix case (no verdicts).\n        if \"bypass via Architect sentinel\" in sysmsg:\n            return \"\", \"\", \"\"\n        # Arm 3 — Case B (write-shape advisory OR legacy block path).\n        is_advisory_writeshape = (\n            \"PAIR-RAIL-ADVISORY\" in sysmsg and \"write-shaped\" in sysmsg\n        )\n        if decision == \"block\" or is_advisory_writeshape:\n            return \"PASS\", \"BLOCK\", \"\"\n        # Arm 4 — Case A (clean review).\n        if \"review clean\" in sysmsg:\n            return \"PASS\", \"PASS\", \"\"\n        # Arm 5 — non-matrix short-circuit (kill-switch / out-of-scope).\n        return \"\", \"\", \"\"\n    except Exception:\n        # Fail-OPEN: derivation error → no-case tuple (detect_case → None).\n        return \"\", \"\", \"\"\n\n# QDSAA-FUNCAO-LONGA: matriz assimétrica em ordem normativa preserva precedência do VETO e emissão do caso correspondente.\ndef _decide_with_matrix(\n    *,\n    tool_name: str,\n    file_path: str,\n    proposed_content: str,\n    repo_root: Path,\n    timeout_s: float,\n    session_id: str = \"\",\n) -> Dict[str, Any]:\n    \"\"\"Phase 3 asymmetric VETO matrix wrapper around `_decide()`.\n\n    Calls the canonical `_decide()` codepath to get the Phase 1 verdict\n    (review-only semantics), then applies the Cases A-F matrix:\n\n      - canonical path returns ALLOW with no matrix-relevant signal → Case A\n      - canonical path returns advisory write-shape (PLAN-092 Wave B\n        SHADOW-strip per ADR-127) → validate Case-B preconditions:\n          + preconditions met → Case B (advisory + audit)\n          + preconditions NOT met → Case B' fail-OPEN (advisory)\n      - canonical path returns ALLOW with `systemMessage` containing\n        \"Codex unavailable\" / \"timeout\" / \"malformed\" → Case F (allow)\n      - canonical path returns ALLOW with sentinel bypass → not a matrix case\n        (already authorized by Owner sentinel)\n\n    Each matrix arm emits `pair_rail_case` with case + verdicts +\n    preconditions + rubric metadata.\n\n    R1 S-Perf-3: matrix lookup uses O(1) dict (NOT linear scan); the\n    ``_MATRIX_DECISIONS`` table below dispatches in constant time.\n    \"\"\"\n    # r5 F2 — reset the per-invocation correlation slot BEFORE _decide():\n    # a stale id from a prior in-process invocation must never attach to\n    # a case whose review path was not entered this time. _decide() sets\n    # it (os.urandom(8).hex()) exactly when the review path is ENTERED,\n    # in the same breath as the pair_rail_review_expected emit.\n    global _CURRENT_REVIEW_ID\n    _CURRENT_REVIEW_ID = \"\"\n\n    # Compute base decision via spike _decide()\n    base = _decide(\n        tool_name=tool_name,\n        file_path=file_path,\n        proposed_content=proposed_content,\n        repo_root=repo_root,\n        timeout_s=timeout_s,\n        session_id=session_id,\n    )\n\n    # r5 F2 — the id generated by THIS _decide() invocation (or \"\" when\n    # the review path was never entered / kill-switch / out-of-scope /\n    # sentinel arms returned early — those paths emit no case anyway).\n    review_id = _CURRENT_REVIEW_ID\n\n    sysmsg = base.get(\"systemMessage\", \"\")\n\n    # PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W2): delegate the\n    # verdict→case CLASSIFICATION to the canonical pure module\n    # `_lib.pair_rail_decide.detect_case()`. The procedural shell\n    # (Codex invoke, patch detect — both inside `_decide()` above), the\n    # B'/precondition resolution, and every audit emit STAY INLINE.\n    # `evaluate()` is DELIBERATELY NOT called: it would convert a\n    # precondition-unmet Case B into B' (pair_rail_decide.py:197-204),\n    # diverging from production's byte-identical `case=\"B\"` emit.\n    #\n    # Fail-OPEN: any error in verdict-derivation / classification / lib\n    # import returns `base` (implicit allow), never raises.\n    try:\n        cv, xv, jb = _base_to_verdicts(base)\n        _prd = _load_pair_rail_decide()\n        matrix_case = (\n            _prd.detect_case(claude_verdict=cv, codex_verdict=xv, jaccard_bucket=jb)\n            if _prd is not None\n            else None\n        )\n    except Exception:\n        return base  # fail-OPEN — never block the user on a classifier bug\n\n    if matrix_case is None:\n        # r6 F1 — discriminate on the invocation correlation id. A\n        # non-empty `review_id` proves THIS _decide() invocation ENTERED\n        # the review path (it emitted `pair_rail_review_expected`) and\n        # returned a base decision that classifies to NO matrix case.\n        # The only post-entry return that lands here is the ADVISORY\n        # parse-miss arm (`_decide()` verdict==\"ADVISORY\": codex RAN and\n        # ANSWERED, but the response parsed to no structured PASS/BLOCK\n        # — `_base_to_verdicts` Arm 5 → detect_case None). Without a\n        # case emit that expected review_id stays OUTSTANDING forever →\n        # a FALSE /ceo-boot S254 deficit (\"hook died between the two\n        # emits\") for a rail that actually answered. Emit the accounted\n        # fail-open terminal case — case=F, codex_verdict=ADVISORY (both\n        # already in the audit_emit closed enums; no schema change) —\n        # carrying the SAME review_id so expected<->case pairs and the\n        # row is LADDERED by its failopen bucket, exactly like the\n        # sibling stop_review rail's parse-miss (`skipped_failopen`,\n        # plan C5 r2 F2: unparseable is NEVER healthy). The deficit RED\n        # stays reserved for an entered review with ZERO case emit (the\n        # genuine S254 hook-death signal). An empty review_id = a\n        # pre-review short-circuit (sentinel bypass / kill-switch /\n        # out-of-scope / non-write tool) — byte-identical legacy\n        # no-emit.\n        if review_id:\n            _emit_pair_rail_case(\n                case=\"F\", claude_verdict=\"PASS\", codex_verdict=\"ADVISORY\",\n                tool_name=tool_name, file_path=file_path,\n                session_id=session_id, review_id=review_id,\n                timeout_s=timeout_s,\n            )\n        return base\n\n    case_value = getattr(matrix_case, \"value\", matrix_case)\n\n    if case_value == \"F\":\n        # Case F — fail-OPEN. The codex_verdict sub-discrimination\n        # (MALFORMED vs TIMEOUT, with UNAVAILABLE coercing to TIMEOUT)\n        # is carried by `_base_to_verdicts()` in `xv`; emit it verbatim.\n        _emit_pair_rail_case(\n            case=\"F\", claude_verdict=\"PASS\", codex_verdict=xv,\n            tool_name=tool_name, file_path=file_path,\n            session_id=session_id, review_id=review_id,\n            timeout_s=timeout_s,\n        )\n        return base\n\n    if case_value == \"B\":\n        # Procedural Case-B audit emit (advisory-only per ADR-127).\n        # B'/precondition resolution stays INLINE (NOT via evaluate()).\n        # precondition_met reflects whether substantive rubric evidence\n        # was attached (False at Phase 3; True at Phase 4 corpus-replay).\n        preconditions_met, reason_slug = _validate_provider_pair(\n            codex_verdict=\"BLOCK\",\n            rubric_violation_id=\"\",  # not extracted from procedural grammar\n            severity=\"\",\n            file_line_cited=False,\n            repo_root=repo_root,\n        )\n        _emit_pair_rail_case(\n            case=\"B\", claude_verdict=\"PASS\", codex_verdict=\"BLOCK\",\n            tool_name=tool_name, file_path=file_path,\n            precondition_met=preconditions_met,\n            rubric_violation_id=\"\",\n            severity=\"P0\",  # write-shape violation defaulted P0 procedural\n            session_id=session_id, review_id=review_id,\n            timeout_s=timeout_s,\n        )\n        # Advisory-only return — `base` already carries the advisory\n        # systemMessage (Site 1). No `decision` key — schema treats\n        # absence as implicit allow.\n        return base\n\n    if case_value == \"A\":\n        _emit_pair_rail_case(\n            case=\"A\", claude_verdict=\"PASS\", codex_verdict=\"PASS\",\n            tool_name=tool_name, file_path=file_path,\n            session_id=session_id, review_id=review_id,\n            timeout_s=timeout_s,\n        )\n        return base\n\n    # Defensive: any other detected case (C/D/E — confirmed unreachable\n    # from the procedural `base`, plan §2a.2) → no emit, fail-OPEN allow.\n    return base\n\ndef _verify_pin_cli(argv: List[str]) -> int:\n    \"\"\"ADR-182 CLI entry — `check_pair_rail.py --verify-codex-pin\n    [<launcher-path>]`. Shared verification surface for\n    `pair-rail-gate.sh` Gate 4 and operator forensics: prints the\n    `verify_codex_payload()` result as one JSON object.\n\n    Exit codes (gate.sh contract):\n      0 — verified (payload sha256 matches the manifest entry)\n      1 — fail-CLOSED arm (mismatch / triple_missing)\n      3 — INFRA arm (manifest unreadable, launcher/payload missing, ...)\n    \"\"\"\n    launcher = argv[0] if argv else None\n    res = verify_codex_payload(launcher)\n    try:\n        sys.stdout.write(json.dumps(res, ensure_ascii=False) + \"\\n\")\n    except Exception:\n        pass\n    status = res.get(\"status\")\n    if status in (\"verified\", \"compatible\"):\n        return 0\n    if status in (\"mismatch\", \"triple_missing\"):\n        return 1\n    return 3\n\n__all__ = (\n    '_emit_pair_rail_review_expected',\n    '_emit_pair_rail_case',\n    '_load_pair_rail_decide',\n    '_base_to_verdicts',\n    '_decide_with_matrix',\n    '_verify_pin_cli',\n)\n","numLines":524,"startLine":1,"totalLines":524}},"tool_result_meta":[{"id":"toolu_01LHut6ZZ4CZUpbpbpcspoq1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
