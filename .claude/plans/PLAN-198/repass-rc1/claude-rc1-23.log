{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YYwMeGDFFxyMQazfuxP9yb","type":"tool_result","content":"1\t\"\"\"PreCompact hook dispatch and command-line entry point.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef gate(event: Dict[str, Any], cwd: Optional[str] = None) -> Dict[str, Any]:\n5\t    \"\"\"Build + persist the snapshot; emit the closed-enum event. Always allows.\n6\t\n7\t    Returns ``{}`` (PreCompact hooks have no governance output channel — the\n8\t    snapshot is the side effect; PostCompact does the reinjection). This is\n9\t    also why the PLAN-179 W0 US2b progress guard is observe+notify: there is\n10\t    no value of the return that could stop the compaction.\"\"\"\n11\t    if os.environ.get(\"CEO_COMPACTION_CONTINUITY\", \"1\") == \"0\":\n12\t        return {}\n13\t    deadline = time.monotonic() + TIME_BUDGET_S\n14\t    # Rail round-9 [P2]: TODO path derivado daqui usa o ROOT do projeto,\n15\t    # não o cwd literal do hook-input (que segue CwdChanged) — um único\n16\t    # ponto de resolução cura a família inteira (plan lookup, ceremony\n17\t    # flags, marker de pressão, identidade do sidecar).\n18\t    cwd = _resolve_project_root(os.path.realpath(cwd or os.getcwd()))\n19\t    trigger = _trigger_class(event)\n20\t    plan_id = _resolve_plan_id(event)\n21\t    # PLAN-179 W1 US3 — resolved BEFORE the write so an unresolved plan falls\n22\t    # back to the session scope instead of dropping the snapshot on the floor.\n23\t    session_id = _session_scope_id(event)\n24\t    plan_path = _plan_file_for(plan_id, cwd)\n25\t    blob: Dict[str, Any] = {\n26\t        \"schema\": \"compaction-continuity/v1\",\n27\t        \"ts\": time.time(),\n28\t        \"trigger\": trigger,\n29\t        \"plan_id\": plan_id,\n30\t        \"execution_unit\": _execution_unit(plan_path, cwd, deadline),\n31\t        # PLAN-179 W2 US7 — the ledger INDEX: derived from commit PATHS\n32\t        # (never _resolve_plan_id), pointing at PLAN-NNN/LEDGER.md +\n33\t        # sections + last commit instead of copying state.\n34\t        \"ledger_index\": _ledger_index(cwd, deadline),\n35\t        \"ceremony_flags\": _ceremony_flags(cwd, deadline),\n36\t        \"hmac_chain\": _hmac_chain_breadcrumb(deadline),\n37\t    }\n38\t    chain_length = 0\n39\t    try:\n40\t        chain_length = int(blob[\"hmac_chain\"].get(\"chain_length\", 0))\n41\t    except (TypeError, ValueError, AttributeError):\n42\t        chain_length = 0\n43\t    outcome = _write_snapshot(plan_id, blob, session_id)\n44\t    _emit_snapshot_event(trigger, plan_id, chain_length, outcome)\n45\t    # PLAN-179 US2b-valve — advisory only, AFTER the snapshot + its\n46\t    # event: the valve must never delay or endanger the snapshot.\n47\t    _eta_advisory()\n48\t    # PLAN-179 W0 US2b — last, and only when the operator armed a floor: the\n49\t    # guard must never delay or endanger the snapshot above it.\n50\t    floor_tokens = _progress_floor_tokens()\n51\t    if floor_tokens is not None:\n52\t        used_tokens = _used_tokens_from_event(event)\n53\t        # PLAN-179 rail round-4 [P2]: the PreCompact input documented by the\n54\t        # harness carries NO token accounting, so `used_tokens` is None on\n55\t        # every real invocation and the guard was dead by construction — the\n56\t        # test only passed because it fed a shape production never sends. The\n57\t        # statusline sidecar DOES carry a measured `context_pct`, so fall back\n58\t        # to it. Order matters: the event stays PREFERRED (if a future harness\n59\t        # version ships accounting inline, that is the fresher number); the\n60\t        # sidecar is what makes the guard work TODAY.\n61\t        pct = _context_used_pct(event)\n62\t        if pct is None:\n63\t            # Identity of THIS invocation is passed in: the sidecar is shared\n64\t            # across projects (round-5 [P2]) and a value that belongs to\n65\t            # someone else must be refused, not consumed.\n66\t            pct = _context_pct_from_sidecar(session_id, cwd)\n67\t        if used_tokens is None and pct is None:\n68\t            _breadcrumb(\n69\t                \"%s is set but neither the hook input nor the statusline \"\n70\t                \"sidecar carries context accounting — progress guard skipped \"\n71\t                \"(no measurement is invented)\" % PROGRESS_FLOOR_ENV\n72\t            )\n73\t        else:\n74\t            # PLAN-179 W0/W1 cross-file pass: the guard now needs the repo root\n75\t            # (for should_emit_context_pressure's `<project>/.claude/state`\n76\t            # marker), the resolved plan_id (an allowlisted wire field) and the\n77\t            # context PERCENT (the wire's actual unit).\n78\t            # PLAN-179 rail finding A: also the TRUSTED session id (hook input\n79\t            # only — `_session_scope_id` refuses the env-sourced one), which\n80\t            # keys the hysteresis marker and attributes the wire row.\n81\t            # `pct` above, NOT a second `_context_used_pct(event)` call: the\n82\t            # sidecar fallback lives in that variable, and recomputing here\n83\t            # would silently drop back to the event-only value that production\n84\t            # never carries — re-introducing the dead instrument this round\n85\t            # exists to fix.\n86\t            _progress_guard(\n87\t                used_tokens,\n88\t                floor_tokens,\n89\t                pct,\n90\t                plan_id,\n91\t                cwd,\n92\t                session_id,\n93\t            )\n94\t    # PLAN-179 rail finding C (round-1 REJECT) — the PRODUCTION CALLER for the\n95\t    # session-store file GC. `set_session_value`'s TTL expires ROWS; nothing\n96\t    # removed the `session-<uuid>.sqlite` / `.lock` / `-wal` / `-shm` files, so\n97\t    # the W1 US3 fallback still grew one store per unresolved-plan session\n98\t    # forever while ADR-153 claimed file-level GC shipped with it.\n99\t    #\n100\t    # This hook is the natural site because it is what CREATES those stores.\n101\t    # Placed LAST, after the snapshot, the audit emit and the progress guard,\n102\t    # and fail-open inside `_gc_session_stores`: no snapshot outcome may depend\n103\t    # on housekeeping succeeding.\n104\t    _gc_session_stores(deadline)\n105\t    return {}\n106\t\n107\t\n108\tdef main() -> None:\n109\t    try:\n110\t        hook_input = json.loads(sys.stdin.read() or \"{}\")\n111\t        if not isinstance(hook_input, dict):\n112\t            raise ValueError(\"hook input is not a JSON object\")\n113\t    except Exception as exc:\n114\t        # PLAN-091 S116: parse error is infra → breadcrumb + schema-compliant allow.\n115\t        sys.stderr.write(\n116\t            \"# check_precompact_continuity fail-open (stdin): %s\\n\" % str(exc)[:120]\n117\t        )\n118\t        print(\"{}\")\n119\t        return\n120\t    try:\n121\t        print(json.dumps(gate(hook_input, hook_input.get(\"cwd\"))))\n122\t    except Exception as exc:\n123\t        sys.stderr.write(\n124\t            \"# check_precompact_continuity fail-open: %s\\n\" % str(exc)[:120]\n125\t        )\n126\t        print(\"{}\")\n127\t"}]},"parent_tool_use_id":null,"session_id":"fc9c9c7c-91b8-47f0-b9c1-9bd9dd6a514a","uuid":"8c8be059-6098-4ac2-a5b7-7987c29f1bf3","timestamp":"2026-11-13T18:11:42.008Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_precompact_parts/runtime.py","content":"\"\"\"PreCompact hook dispatch and command-line entry point.\"\"\"\nfrom __future__ import annotations\n\ndef gate(event: Dict[str, Any], cwd: Optional[str] = None) -> Dict[str, Any]:\n    \"\"\"Build + persist the snapshot; emit the closed-enum event. Always allows.\n\n    Returns ``{}`` (PreCompact hooks have no governance output channel — the\n    snapshot is the side effect; PostCompact does the reinjection). This is\n    also why the PLAN-179 W0 US2b progress guard is observe+notify: there is\n    no value of the return that could stop the compaction.\"\"\"\n    if os.environ.get(\"CEO_COMPACTION_CONTINUITY\", \"1\") == \"0\":\n        return {}\n    deadline = time.monotonic() + TIME_BUDGET_S\n    # Rail round-9 [P2]: TODO path derivado daqui usa o ROOT do projeto,\n    # não o cwd literal do hook-input (que segue CwdChanged) — um único\n    # ponto de resolução cura a família inteira (plan lookup, ceremony\n    # flags, marker de pressão, identidade do sidecar).\n    cwd = _resolve_project_root(os.path.realpath(cwd or os.getcwd()))\n    trigger = _trigger_class(event)\n    plan_id = _resolve_plan_id(event)\n    # PLAN-179 W1 US3 — resolved BEFORE the write so an unresolved plan falls\n    # back to the session scope instead of dropping the snapshot on the floor.\n    session_id = _session_scope_id(event)\n    plan_path = _plan_file_for(plan_id, cwd)\n    blob: Dict[str, Any] = {\n        \"schema\": \"compaction-continuity/v1\",\n        \"ts\": time.time(),\n        \"trigger\": trigger,\n        \"plan_id\": plan_id,\n        \"execution_unit\": _execution_unit(plan_path, cwd, deadline),\n        # PLAN-179 W2 US7 — the ledger INDEX: derived from commit PATHS\n        # (never _resolve_plan_id), pointing at PLAN-NNN/LEDGER.md +\n        # sections + last commit instead of copying state.\n        \"ledger_index\": _ledger_index(cwd, deadline),\n        \"ceremony_flags\": _ceremony_flags(cwd, deadline),\n        \"hmac_chain\": _hmac_chain_breadcrumb(deadline),\n    }\n    chain_length = 0\n    try:\n        chain_length = int(blob[\"hmac_chain\"].get(\"chain_length\", 0))\n    except (TypeError, ValueError, AttributeError):\n        chain_length = 0\n    outcome = _write_snapshot(plan_id, blob, session_id)\n    _emit_snapshot_event(trigger, plan_id, chain_length, outcome)\n    # PLAN-179 US2b-valve — advisory only, AFTER the snapshot + its\n    # event: the valve must never delay or endanger the snapshot.\n    _eta_advisory()\n    # PLAN-179 W0 US2b — last, and only when the operator armed a floor: the\n    # guard must never delay or endanger the snapshot above it.\n    floor_tokens = _progress_floor_tokens()\n    if floor_tokens is not None:\n        used_tokens = _used_tokens_from_event(event)\n        # PLAN-179 rail round-4 [P2]: the PreCompact input documented by the\n        # harness carries NO token accounting, so `used_tokens` is None on\n        # every real invocation and the guard was dead by construction — the\n        # test only passed because it fed a shape production never sends. The\n        # statusline sidecar DOES carry a measured `context_pct`, so fall back\n        # to it. Order matters: the event stays PREFERRED (if a future harness\n        # version ships accounting inline, that is the fresher number); the\n        # sidecar is what makes the guard work TODAY.\n        pct = _context_used_pct(event)\n        if pct is None:\n            # Identity of THIS invocation is passed in: the sidecar is shared\n            # across projects (round-5 [P2]) and a value that belongs to\n            # someone else must be refused, not consumed.\n            pct = _context_pct_from_sidecar(session_id, cwd)\n        if used_tokens is None and pct is None:\n            _breadcrumb(\n                \"%s is set but neither the hook input nor the statusline \"\n                \"sidecar carries context accounting — progress guard skipped \"\n                \"(no measurement is invented)\" % PROGRESS_FLOOR_ENV\n            )\n        else:\n            # PLAN-179 W0/W1 cross-file pass: the guard now needs the repo root\n            # (for should_emit_context_pressure's `<project>/.claude/state`\n            # marker), the resolved plan_id (an allowlisted wire field) and the\n            # context PERCENT (the wire's actual unit).\n            # PLAN-179 rail finding A: also the TRUSTED session id (hook input\n            # only — `_session_scope_id` refuses the env-sourced one), which\n            # keys the hysteresis marker and attributes the wire row.\n            # `pct` above, NOT a second `_context_used_pct(event)` call: the\n            # sidecar fallback lives in that variable, and recomputing here\n            # would silently drop back to the event-only value that production\n            # never carries — re-introducing the dead instrument this round\n            # exists to fix.\n            _progress_guard(\n                used_tokens,\n                floor_tokens,\n                pct,\n                plan_id,\n                cwd,\n                session_id,\n            )\n    # PLAN-179 rail finding C (round-1 REJECT) — the PRODUCTION CALLER for the\n    # session-store file GC. `set_session_value`'s TTL expires ROWS; nothing\n    # removed the `session-<uuid>.sqlite` / `.lock` / `-wal` / `-shm` files, so\n    # the W1 US3 fallback still grew one store per unresolved-plan session\n    # forever while ADR-153 claimed file-level GC shipped with it.\n    #\n    # This hook is the natural site because it is what CREATES those stores.\n    # Placed LAST, after the snapshot, the audit emit and the progress guard,\n    # and fail-open inside `_gc_session_stores`: no snapshot outcome may depend\n    # on housekeeping succeeding.\n    _gc_session_stores(deadline)\n    return {}\n\n\ndef main() -> None:\n    try:\n        hook_input = json.loads(sys.stdin.read() or \"{}\")\n        if not isinstance(hook_input, dict):\n            raise ValueError(\"hook input is not a JSON object\")\n    except Exception as exc:\n        # PLAN-091 S116: parse error is infra → breadcrumb + schema-compliant allow.\n        sys.stderr.write(\n            \"# check_precompact_continuity fail-open (stdin): %s\\n\" % str(exc)[:120]\n        )\n        print(\"{}\")\n        return\n    try:\n        print(json.dumps(gate(hook_input, hook_input.get(\"cwd\"))))\n    except Exception as exc:\n        sys.stderr.write(\n            \"# check_precompact_continuity fail-open: %s\\n\" % str(exc)[:120]\n        )\n        print(\"{}\")\n","numLines":127,"startLine":1,"totalLines":127}},"tool_result_meta":[{"id":"toolu_01YYwMeGDFFxyMQazfuxP9yb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
