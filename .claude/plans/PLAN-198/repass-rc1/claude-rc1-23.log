\t        from _lib import codex_egress_redact as _redact\n56\t        _egress_bytes = len(prompt.encode(\"utf-8\", \"replace\")) if isinstance(prompt, str) else 0\n57\t        prompt, _egress_findings = _redact.redact_outgoing_with_findings(prompt)\n58\t    except ImportError:\n59\t        raise CodexUnavailable(\"codex_egress_redact unavailable — fail-CLOSED per ADR-114\")\n60\t    try:\n61\t        from _lib import audit_emit as _ae\n62\t        _ae.emit_pair_rail_outgoing_redaction_applied(\n63\t            signal=\"outbound\",\n64\t            match_count=len(_egress_findings),\n65\t            bytes_scanned=_egress_bytes,\n66\t            callsite=\"check_pair_rail.py:_invoke_codex_review\",\n67\t            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n68\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n69\t        )\n70\t    except Exception:\n71\t        pass\n72\t\n73\t    tmp_dir = _tempfile.mkdtemp(prefix=\"ceo_pairrail_\")\n74\t    try:\n75\t        _os.chmod(tmp_dir, 0o700)\n76\t    except OSError:\n77\t        pass\n78\t    out_path = _os.path.join(tmp_dir, \"codex_last_message.json\")\n79\t    schema_path = _os.path.join(tmp_dir, \"codex_verdict_schema.json\")\n80\t\n81\t    def _cleanup() -> None:\n82\t        for _p in (out_path, schema_path):\n83\t            try:\n84\t                _os.unlink(_p)\n85\t            except OSError:\n86\t                pass\n87\t        try:\n88\t            _os.rmdir(tmp_dir)\n89\t        except OSError:\n90\t            pass\n91\t\n92\t    try:\n93\t        try:\n94\t            fd = _os.open(out_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n95\t            _os.close(fd)\n96\t        except FileNotFoundError:\n97\t            raise CodexUnavailable(\"tmpdir vanished before pre-create\")\n98\t        except FileExistsError:\n99\t            raise CodexUnavailable(\"tmpfile pre-create lost O_EXCL race\")\n100\t        except OSError as e:\n101\t            raise CodexUnavailable(f\"tmpfile pre-create failed: {type(e).__name__}\")\n102\t\n103\t        schema_arg: Optional[str] = None\n104\t        try:\n105\t            schema_json = shape.verdict_output_schema_json()\n106\t            sfd = _os.open(schema_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n107\t            try:\n108\t                _os.write(sfd, schema_json.encode(\"utf-8\"))\n109\t            finally:\n110\t                _os.close(sfd)\n111\t            schema_arg = schema_path\n112\t        except Exception:\n113\t            schema_arg = None\n114\t\n115\t        try:\n116\t            cli_args = shape.build_verdict_argv(\n117\t                prompt,\n118\t                output_file=out_path,\n119\t                schema_file=schema_arg,\n120\t            )\n121\t        except Exception as e:\n122\t            raise CodexUnavailable(\n123\t                f\"codex_cli_shape.build_verdict_argv failed: {type(e).__name__}\"\n124\t            )\n125\t        if not isinstance(cli_args, (list, tuple)) or not cli_args:\n126\t            raise CodexUnavailable(\"codex_cli_shape returned empty argv\")\n127\t\n128\t        cmd = [codex_bin] + list(cli_args)\n129\t\n130\t        try:\n131\t            proc = subprocess.run(\n132\t                cmd,\n133\t                input=\"\",\n134\t                capture_output=True,\n135\t                text=True,\n136\t                timeout=timeout_s,\n137\t                check=False,\n138\t            )\n139\t        except subprocess.TimeoutExpired:\n140\t            raise CodexTimeout(f\"codex invoke exceeded {timeout_s}s\")\n141\t        except (FileNotFoundError, PermissionError, OSError, ConnectionError) as e:\n142\t            raise CodexUnavailable(f\"codex invoke failed: {type(e).__name__}: {e}\")\n143\t        except ValueError as e:\n144\t            raise CodexMalformed(f\"codex invoke {type(e).__name__}: {e}\")\n145\t\n146\t        try:\n147\t            from _lib import audit_emit as _ae  # type: ignore 