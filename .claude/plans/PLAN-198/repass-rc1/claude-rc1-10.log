{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LN3SPGdoRWeCsYF5vDTTBT","type":"tool_result","content":"1\t\"\"\"Snapshot construction, plan discovery and persistence.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _breadcrumb(msg: str) -> None:\n5\t    sys.stderr.write(\"# check_precompact_continuity: %s\\n\" % msg[:160])\n6\t\n7\t\n8\tdef _sanitize_text(raw: str, clamp: int) -> str:\n9\t    \"\"\"Disk-sourced strings written into the snapshot are kept printable-ASCII\n10\t    + clamped — the snapshot blob is later read by the PostCompact half and a\n11\t    control char / newline could distort downstream rendering. Mirrors the\n12\t    closeout-guard ``_sanitize_path`` hardening (Codex S228 P0).\"\"\"\n13\t    cleaned = \"\".join(ch if 0x20 <= ord(ch) <= 0x7E else \"?\" for ch in raw)\n14\t    return cleaned[:clamp]\n15\t\n16\t\n17\tdef _git(\n18\t    args: List[str], cwd: str, timeout_s: float = 2.0, raw: bool = False\n19\t) -> str:\n20\t    \"\"\"stdout on success, '' on any failure (fail-open).\n21\t\n22\t    ``timeout_s`` (rail r2 P2-f): a caller under a shared wall deadline\n23\t    passes its REMAINING time — a fixed 2s here let a late call run past\n24\t    the hook budget. Existing call sites keep the historical default.\n25\t\n26\t    Rail r8 P2-b: um resto de budget ABAIXO do floor de subprocess não é\n27\t    budget útil — o antigo ``max(0.05, ...)`` ESTICAVA um resto de 10ms\n28\t    para 50ms e furava o wall deadline compartilhado. Sem budget, a\n29\t    resposta honesta é o fail-open imediato, nunca uma chamada tardia.\"\"\"\n30\t    if timeout_s < 0.05:\n31\t        return \"\"\n32\t    try:\n33\t        # Rail r10 P2-a: errors=\"replace\" — filename nao-UTF-8 (legal em\n34\t        # Linux) sob `-z` vem em bytes crus; o decode ESTRITO do text=True\n35\t        # levantava UnicodeDecodeError que NENHUM except aqui pegava e o\n36\t        # snapshot inteiro morria por causa do indice OPCIONAL. Com\n37\t        # replacement o path vira U+FFFD, nao casa shape nenhum e degrada\n38\t        # honesto.\n39\t        p = subprocess.run(\n40\t            [\"git\"] + args, cwd=cwd, capture_output=True, text=True,\n41\t            errors=\"replace\", timeout=timeout_s,\n42\t        )\n43\t        if p.returncode != 0:\n44\t            return \"\"\n45\t        # Rail r11 P2-c: em modo raw (-z) o strip do output INTEIRO\n46\t        # corromperia whitespace legitimo do primeiro/ultimo path — os\n47\t        # limites exatos ja vem dos NULs.\n48\t        return p.stdout if raw else p.stdout.strip()\n49\t    except (subprocess.TimeoutExpired, OSError):\n50\t        return \"\"\n51\t\n52\t\n53\tdef _resolve_project_root(cwd: str) -> str:\n54\t    \"\"\"Project ROOT for every path this hook derives (rail round-9 [P2]).\n55\t\n56\t    O ``cwd`` do hook-input segue o CwdChanged da sessão para\n57\t    subdiretórios; derivar `.claude/...` dele fragmenta o estado — o\n58\t    lookup de plano erra, e o marker de pressão ganha uma cópia por\n59\t    subdiretório, derrotando o contrato de histerese. A autoridade é o\n60\t    toplevel do git (lição feedback-guard-must-resolve-repo-by-git-toplevel);"}]},"parent_tool_use_id":null,"session_id":"9ca7201b-2727-4d3f-917e-3596d0754d58","uuid":"230a7ef2-deb0-48b1-9628-2eaec16b87df","timestamp":"2026-11-15T09:46:28.220Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_precompact_parts/snapshot_core.py","content":"\"\"\"Snapshot construction, plan discovery and persistence.\"\"\"\nfrom __future__ import annotations\n\ndef _breadcrumb(msg: str) -> None:\n    sys.stderr.write(\"# check_precompact_continuity: %s\\n\" % msg[:160])\n\n\ndef _sanitize_text(raw: str, clamp: int) -> str:\n    \"\"\"Disk-sourced strings written into the snapshot are kept printable-ASCII\n    + clamped — the snapshot blob is later read by the PostCompact half and a\n    control char / newline could distort downstream rendering. Mirrors the\n    closeout-guard ``_sanitize_path`` hardening (Codex S228 P0).\"\"\"\n    cleaned = \"\".join(ch if 0x20 <= ord(ch) <= 0x7E else \"?\" for ch in raw)\n    return cleaned[:clamp]\n\n\ndef _git(\n    args: List[str], cwd: str, timeout_s: float = 2.0, raw: bool = False\n) -> str:\n    \"\"\"stdout on success, '' on any failure (fail-open).\n\n    ``timeout_s`` (rail r2 P2-f): a caller under a shared wall deadline\n    passes its REMAINING time — a fixed 2s here let a late call run past\n    the hook budget. Existing call sites keep the historical default.\n\n    Rail r8 P2-b: um resto de budget ABAIXO do floor de subprocess não é\n    budget útil — o antigo ``max(0.05, ...)`` ESTICAVA um resto de 10ms\n    para 50ms e furava o wall deadline compartilhado. Sem budget, a\n    resposta honesta é o fail-open imediato, nunca uma chamada tardia.\"\"\"\n    if timeout_s < 0.05:\n        return \"\"\n    try:\n        # Rail r10 P2-a: errors=\"replace\" — filename nao-UTF-8 (legal em\n        # Linux) sob `-z` vem em bytes crus; o decode ESTRITO do text=True\n        # levantava UnicodeDecodeError que NENHUM except aqui pegava e o\n        # snapshot inteiro morria por causa do indice OPCIONAL. Com\n        # replacement o path vira U+FFFD, nao casa shape nenhum e degrada\n        # honesto.\n        p = subprocess.run(\n            [\"git\"] + args, cwd=cwd, capture_output=True, text=True,\n            errors=\"replace\", timeout=timeout_s,\n        )\n        if p.returncode != 0:\n            return \"\"\n        # Rail r11 P2-c: em modo raw (-z) o strip do output INTEIRO\n        # corromperia whitespace legitimo do primeiro/ultimo path — os\n        # limites exatos ja vem dos NULs.\n        return p.stdout if raw else p.stdout.strip()\n    except (subprocess.TimeoutExpired, OSError):\n        return \"\"\n\n\ndef _resolve_project_root(cwd: str) -> str:\n    \"\"\"Project ROOT for every path this hook derives (rail round-9 [P2]).\n\n    O ``cwd`` do hook-input segue o CwdChanged da sessão para\n    subdiretórios; derivar `.claude/...` dele fragmenta o estado — o\n    lookup de plano erra, e o marker de pressão ganha uma cópia por\n    subdiretório, derrotando o contrato de histerese. A autoridade é o\n    toplevel do git (lição feedback-guard-must-resolve-repo-by-git-toplevel);","numLines":60,"startLine":1,"totalLines":507}},"tool_result_meta":[{"id":"toolu_01LN3SPGdoRWeCsYF5vDTTBT","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
