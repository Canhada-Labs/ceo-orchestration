{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RoByRGVDjfikzd1pgwzpf8","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"PLAN-091 PRODUCTION pair-rail hook compatibility facade.\n3\t\n4\tImplementation is split into private declarations while this module owns all\n5\truntime globals. That preserves dynamic monkeypatch lookups by callers.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport json\n10\timport os\n11\timport re\n12\timport subprocess\n13\timport sys\n14\tfrom pathlib import Path\n15\tfrom typing import Any, Dict, List, Optional, Tuple\n16\t\n17\t_HOOKS_DIR = Path(__file__).resolve().parent\n18\tif str(_HOOKS_DIR) not in sys.path:\n19\t    sys.path.insert(0, str(_HOOKS_DIR))\n20\t\n21\tfrom _lib import cli_currency as _cli_currency  # noqa: F401\n22\tfrom _lib._pair_rail_parts import install as _install_parts\n23\t\n24\t_install_parts(globals(), ('part_01', 'part_02', 'part_03', 'part_04'))\n25\t\n26\t_PRODUCTION_PROMOTED_BY_PLAN_091: bool = True\n27\t\n28\t\n29\tdef _invoke_codex_review(\n30\t    tool_name: str,\n31\t    file_path: str,\n32\t    proposed_content: str,\n33\t    timeout_s: float,\n34\t) -> str:\n35\t    \"\"\"Invoke Codex review on codex-cli 0.139.0; return the REDACTED\n36\t    last-message file content (one structured JSON object) as a str.\n37\t    \"\"\"\n38\t    import os as _os\n39\t    import stat as _stat\n40\t    import tempfile as _tempfile\n41\t\n42\t    codex_bin = _resolve_codex_bin()\n43\t    if codex_bin is None:\n44\t        raise CodexUnavailable(\n45\t            \"codex binary not on PATH (or ADR-182 pin verification \"\n46\t            \"hit an INFRA arm — see pair_rail_codex_unavailable audit)\"\n47\t        )\n48\t\n49\t    shape = _resolve_codex_cli_shape()\n50\t    if shape is None:\n51\t        raise CodexUnavailable(\"codex_cli_shape helper unavailable\")\n52\t\n53\t    prompt = _build_codex_prompt(tool_name, file_path, proposed_content)\n54\t    try:\n55