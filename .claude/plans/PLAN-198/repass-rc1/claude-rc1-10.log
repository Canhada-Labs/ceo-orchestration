{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SdfJBaXcsjGJNZ5GBhmg56","type":"tool_result","content":"1\t\"\"\"Night-mode implementation declarations bound into the CLI facade.\n2\t\n3\tEach import constructs fresh functions with the facade's globals so tests and\n4\tcallers patching facade symbols continue to affect the implementation.\n5\t\"\"\"\n6\t\n7\tfrom __future__ import annotations\n8\t\n9\tfrom importlib import import_module\n10\tfrom types import FunctionType\n11\tfrom typing import Any, Dict, Tuple\n12\t\n13\t\n14\tdef install(namespace: Dict[str, Any], modules: Tuple[str, ...]) -> None:\n15\t    for module_name in modules:\n16\t        module = import_module(f\"{__name__}.{module_name}\")\n17\t        for name in module.__all__:\n18\t            original = getattr(module, name)\n19\t            if isinstance(original, FunctionType):\n20\t                bound = FunctionType(\n21\t                    original.__code__, namespace, original.__name__,\n22\t                    original.__defaults__, original.__closure__,\n23\t                )\n24\t                bound.__kwdefaults__ = dict(original.__kwdefaults__ or {})\n25\t                bound.__annotations__ = dict(original.__annotations__)\n26\t                bound.__dict__.update(original.__dict__)\n27\t                bound.__qualname__ = original.__qualname__\n28\t                bound.__module__ = namespace[\"__name__\"]\n29\t                namespace[name] = bound\n30\t            else:\n31\t                namespace[name] = original\n32\t"}]},"parent_tool_use_id":null,"session_id":"506ec16a-dc13-438e-b350-67d3c029ffa9","uuid":"b1c99211-ed44-4481-aeca-f0a3172421f6","timestamp":"2026-11-13T16:54:27.060Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_night_mode_parts/__init__.py","content":"\"\"\"Night-mode implementation declarations bound into the CLI facade.\n\nEach import constructs fresh functions with the facade's globals so tests and\ncallers patching facade symbols continue to affect the implementation.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom importlib import import_module\nfrom types import FunctionType\nfrom typing import Any, Dict, Tuple\n\n\ndef install(namespace: Dict[str, Any], modules: Tuple[str, ...]) -> None:\n    for module_name in modules:\n        module = import_module(f\"{__name__}.{module_name}\")\n        for name in module.__all__:\n            original = getattr(module, name)\n            if isinstance(original, FunctionType):\n                bound = FunctionType(\n                    original.__code__, namespace, original.__name__,\n                    original.__defaults__, original.__closure__,\n                )\n                bound.__kwdefaults__ = dict(original.__kwdefaults__ or {})\n                bound.__annotations__ = dict(original.__annotations__)\n                bound.__dict__.update(original.__dict__)\n                bound.__qualname__ = original.__qualname__\n                bound.__module__ = namespace[\"__name__\"]\n                namespace[name] = bound\n            else:\n                namespace[name] = original\n","numLines":32,"startLine":1,"totalLines":32}},"tool_result_meta":[{"id":"toolu_01SdfJBaXcsjGJNZ5GBhmg56","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
