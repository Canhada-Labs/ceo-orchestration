ble(f\"tmpfile pre-create failed: {type(e).__name__}\")\n102\t\n103\t        schema_arg: Optional[str] = None\n104\t        try:\n105\t            schema_json = shape.verdict_output_schema_json()\n106\t            sfd = _os.open(schema_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n107\t            try:\n108\t                _os.write(sfd, schema_json.encode(\"utf-8\"))\n109\t            finally:\n110\t                _os.close(sfd)\n111\t            schema_arg = schema_path\n112\t        except Exception:\n113\t            schema_arg = None\n114\t\n115\t        try:\n116\t            cli_args = shape.build_verdict_argv(\n117\t                prompt,\n118\t                output_file=out_path,\n119\t                schema_file=schema_arg,\n120\t            )\n121\t        except Exception as e:\n122\t            raise CodexUnavailable(\n123\t                f\"codex_cli_shape.build_verdict_argv failed: {type(e).__name__}\"\n124\t            )\n125\t        if not isinstance(cli_args, (list, tuple)) or not cli_args:\n126\t            raise CodexUnavailable(\"codex_cli_shape returned empty argv\")\n127\t\n128\t        cmd = [codex_bin] + list(cli_args)\n129\t\n130\t        try:\n131\t            proc = subprocess.run(\n132\t                cmd,\n133\t                input=\"\",\n134\t                capture_output=True,\n135\t                text=True,\n136\t                timeout=timeout_s,\n137\t                check=False,\n138\t            )\n139\t        except subprocess.TimeoutExpired:\n140\t            raise CodexTimeout(f\"codex invoke exceeded {timeout_s}s\")\n141\t        except (FileNotFoundError, PermissionError, OSError, ConnectionError) as e:\n142\t            raise CodexUnavailable(f\"codex invoke failed: {type(e).__name__}: {e}\")\n143\t        except ValueError as e:\n144\t            raise CodexMalformed(f\"codex invoke {type(e).__name__}: {e}\")\n145\t\n146\t        try:\n147\t            from _lib import audit_emit as _ae  # type: ignore 