{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PD75GuzDSvfkB4e5L7mdvJ","type":"tool_result","content":"1\t\"\"\"Policy-as-code engine — PLAN-014 Phase A.3.\n2\t\n3\tImplements SPEC/v1/policy-dsl.schema.md §3 Grammar + §4 Runtime Semantics\n4\t+ §5 Error Model + §6 Policy Identity.\n5\t\n6\tStdlib-only per ADR-002 (PyYAML FORBIDDEN). Hand-rolled YAML subset parser\n7\tper SPEC §3.1-§3.2 with all hard limits enforced (§3.3).\n8\t\n9\tPublic API:\n10\t\n11\t    from _lib.policy import load, Policy, PolicyLoadError\n12\t\n13\t    policy = load(Path(\".claude/policies/bash-safety.policy.yaml\"))\n14\t    decision = policy.decide({\"tool\": \"Bash\", \"tool_input\": {\"command\": \"ls\"}})\n15\t    # -> {\"decision\": \"allow\"}\n16\t\n17\tSee SPEC for normative semantics. This module is tested against the SPEC,\n18\tnot the reverse (public-api-design skill rule 1).\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\ttry:\n24\t    from _lib import redact as _redact  # noqa: E402\n25\texcept Exception:  # pragma: no cover\n26\t    _redact = None  # type: ignore\n27\t\n28\timport hashlib\n29\timport json\n30\timport os\n31\timport re\n32\timport sys\n33\timport threading\n34\timport time\n35\tfrom dataclasses import dataclass, field\n36\tfrom pathlib import Path\n37\tfrom typing import Any, Dict, List, Optional, Tuple\n38\t\n39\t_HOOKS_DIR = Path(__file__).resolve().parent.parent\n40\tif str(_HOOKS_DIR) not in sys.path:\n41\t    sys.path.insert(0, str(_HOOKS_DIR))\n42\t\n43\ttry:\n44\t    from _lib import audit_emit as _audit_emit  # noqa: E402\n45\texcept Exception:  # pragma: no cover\n46\t    _audit_emit = None  # type: ignore\n47\t\n48\t\n49\t# ---------------------------------------------------------------------------\n50\t# Limits (SPEC §3.3)\n51\t# ---------------------------------------------------------------------------\n52\t\n53\t_LIMIT_FILE_BYTES = 64 * 1024  # 64 KiB raw file size\n54\t_LIMIT_DEPTH = 8\n55\t_LIMIT_TOTAL_EXPAND_BYTES = 1024 * 1024  # 1 MiB post-parse\n56\t_LIMIT_KEY_COUNT = 2000\n57\t_LIMIT_SCALAR_LEN = 16 * 1024  # 16 KiB per-scalar\n58\t_LIMIT_PARSE_CPU_MS = 500.0  # wall-clock\n59\t_LIMIT_REGEX_PATTERN = 512\n60\t\n61\t\n62\t# Closed enum from SPEC §5.\n63\t_ERROR_KINDS = frozenset({\n64\t    \"parse_error\",\n65\t    \"predicate_missing\",\n66\t    \"import_failure\",\n67\t    \"depth_limit\",\n68\t    \"size_limit\",\n69\t    \"alias_rejected\",\n70\t    \"tag_rejected\",\n71\t    \"timeout\",\n72\t    \"field_missing\",\n73\t    \"regex_compile_error\",\n74\t    \"schema_version_mismatch\",\n75\t})\n76\t\n77\t\n78\t# Closed set of predicate forms per SPEC §3.5.\n79\t_PREDICATE_FORMS = frozenset({\n80\t    \"all\", \"any\", \"not\",\n81\t    \"eq\", \"neq\", \"in\", \"not_in\",\n82\t    \"regex\", \"starts_with\", \"ends_with\", \"contains\",\n83\t    \"length_le\", \"length_ge\", \"path_under\",\n84\t})\n85\t\n86\t\n87\t# Top-level required keys per SPEC §3.4.\n88\t_TOP_LEVEL_REQUIRED = (\"schema\", \"id\", \"description\", \"kind\", \"defaults\",\n89\t                       \"rules\", \"error_model\")\n90\t\n91\t_KIND_ENUM = frozenset({\"allow_list\", \"deny_list\", \"mixed\"})\n92\t_DECISION_ENUM = frozenset({\"allow\", \"block\"})\n93\t\n94\t\n95\t# ---------------------------------------------------------------------------\n96\t# Exceptions\n97\t# ---------------------------------------------------------------------------\n98\t\n99\t\n100\tclass PolicyLoadError(Exception):\n101\t    \"\"\"Raised when :func:`load` cannot build a valid Policy.\n102\t\n103\t    ``error_kind`` is a closed-enum value from SPEC §5. ``detail`` is\n104\t    free-text (may be surfaced in ``policy_error`` audit via redaction).\n105\t    \"\"\"\n106\t\n107\t    def __init__(self, error_kind: str, detail: str, policy_id: str = \"\"):\n108\t        if error_kind not in _ERROR_KINDS:\n109\t            # Defensive: reject unknown kinds at raise site so the enum\n110\t            # contract is enforced. Fall back to parse_error.\n111\t            error_kind = \"parse_error\"\n112\t        self.error_kind = error_kind\n113\t        if _redact is not None:\n114\t            try:\n115\t                self.detail = _redact.redact_secrets(detail, max_chars=200)\n116\t            except Exception:\n117\t                self.detail = (detail[:200] if detail else \"\")\n118\t        else:\n119\t            self.detail = (detail[:200] if detail else \"\")\n120\t        self.policy_id = policy_id\n121\t        super().__init__(f\"{error_kind}: {detail}\")\n122\t\n123\t\n124\t# The parser keeps its historical public/private class name while methods live\n125\t# in ordered mixins.  Their code executes with this facade as globals.\n126\t# Opt-out: CEO_POLICY_ENGINE_DISABLE=1 reverts to Python-hook fallback.\n127\tfrom _lib._policy_parts import install as _install_policy_parts\n128\t_install_policy_parts(globals())\n129\tdel _install_policy_parts\n130\t\n131\tclass _YamlParser(_YamlBlocksMixin, _YamlFlowsMixin, _YamlScalarsMixin):\n132\t    \"\"\"YAML subset parser assembled from bounded implementation mixins.\"\"\"\n133\t    _INT_RE = re.compile(r\"^-?\\d+$\")\n134\t    _DIRECTIVE_RE = re.compile(r\"^\\s*%(YAML|TAG)\\b\")\n135\t\n136\t    def __init__(self, text: str, cpu_deadline_monotonic: float,\n137\t                 policy_id_hint: str = \"\"):\n138\t        self._lines = text.splitlines()\n139\t        self._i = 0\n140\t        self._n = len(self._lines)\n141\t        self._deadline = cpu_deadline_monotonic\n142\t        self._key_count = 0\n143\t        self._policy_id_hint = policy_id_hint\n144\t"}]},"parent_tool_use_id":null,"session_id":"506ec16a-dc13-438e-b350-67d3c029ffa9","uuid":"77b6c3e7-aeeb-4184-9ee9-d723c0131612","timestamp":"2026-11-13T16:54:47.568Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/policy.py","content":"\"\"\"Policy-as-code engine — PLAN-014 Phase A.3.\n\nImplements SPEC/v1/policy-dsl.schema.md §3 Grammar + §4 Runtime Semantics\n+ §5 Error Model + §6 Policy Identity.\n\nStdlib-only per ADR-002 (PyYAML FORBIDDEN). Hand-rolled YAML subset parser\nper SPEC §3.1-§3.2 with all hard limits enforced (§3.3).\n\nPublic API:\n\n    from _lib.policy import load, Policy, PolicyLoadError\n\n    policy = load(Path(\".claude/policies/bash-safety.policy.yaml\"))\n    decision = policy.decide({\"tool\": \"Bash\", \"tool_input\": {\"command\": \"ls\"}})\n    # -> {\"decision\": \"allow\"}\n\nSee SPEC for normative semantics. This module is tested against the SPEC,\nnot the reverse (public-api-design skill rule 1).\n\"\"\"\n\nfrom __future__ import annotations\n\ntry:\n    from _lib import redact as _redact  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _redact = None  # type: ignore\n\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nimport threading\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\ntry:\n    from _lib import audit_emit as _audit_emit  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _audit_emit = None  # type: ignore\n\n\n# ---------------------------------------------------------------------------\n# Limits (SPEC §3.3)\n# ---------------------------------------------------------------------------\n\n_LIMIT_FILE_BYTES = 64 * 1024  # 64 KiB raw file size\n_LIMIT_DEPTH = 8\n_LIMIT_TOTAL_EXPAND_BYTES = 1024 * 1024  # 1 MiB post-parse\n_LIMIT_KEY_COUNT = 2000\n_LIMIT_SCALAR_LEN = 16 * 1024  # 16 KiB per-scalar\n_LIMIT_PARSE_CPU_MS = 500.0  # wall-clock\n_LIMIT_REGEX_PATTERN = 512\n\n\n# Closed enum from SPEC §5.\n_ERROR_KINDS = frozenset({\n    \"parse_error\",\n    \"predicate_missing\",\n    \"import_failure\",\n    \"depth_limit\",\n    \"size_limit\",\n    \"alias_rejected\",\n    \"tag_rejected\",\n    \"timeout\",\n    \"field_missing\",\n    \"regex_compile_error\",\n    \"schema_version_mismatch\",\n})\n\n\n# Closed set of predicate forms per SPEC §3.5.\n_PREDICATE_FORMS = frozenset({\n    \"all\", \"any\", \"not\",\n    \"eq\", \"neq\", \"in\", \"not_in\",\n    \"regex\", \"starts_with\", \"ends_with\", \"contains\",\n    \"length_le\", \"length_ge\", \"path_under\",\n})\n\n\n# Top-level required keys per SPEC §3.4.\n_TOP_LEVEL_REQUIRED = (\"schema\", \"id\", \"description\", \"kind\", \"defaults\",\n                       \"rules\", \"error_model\")\n\n_KIND_ENUM = frozenset({\"allow_list\", \"deny_list\", \"mixed\"})\n_DECISION_ENUM = frozenset({\"allow\", \"block\"})\n\n\n# ---------------------------------------------------------------------------\n# Exceptions\n# ---------------------------------------------------------------------------\n\n\nclass PolicyLoadError(Exception):\n    \"\"\"Raised when :func:`load` cannot build a valid Policy.\n\n    ``error_kind`` is a closed-enum value from SPEC §5. ``detail`` is\n    free-text (may be surfaced in ``policy_error`` audit via redaction).\n    \"\"\"\n\n    def __init__(self, error_kind: str, detail: str, policy_id: str = \"\"):\n        if error_kind not in _ERROR_KINDS:\n            # Defensive: reject unknown kinds at raise site so the enum\n            # contract is enforced. Fall back to parse_error.\n            error_kind = \"parse_error\"\n        self.error_kind = error_kind\n        if _redact is not None:\n            try:\n                self.detail = _redact.redact_secrets(detail, max_chars=200)\n            except Exception:\n                self.detail = (detail[:200] if detail else \"\")\n        else:\n            self.detail = (detail[:200] if detail else \"\")\n        self.policy_id = policy_id\n        super().__init__(f\"{error_kind}: {detail}\")\n\n\n# The parser keeps its historical public/private class name while methods live\n# in ordered mixins.  Their code executes with this facade as globals.\n# Opt-out: CEO_POLICY_ENGINE_DISABLE=1 reverts to Python-hook fallback.\nfrom _lib._policy_parts import install as _install_policy_parts\n_install_policy_parts(globals())\ndel _install_policy_parts\n\nclass _YamlParser(_YamlBlocksMixin, _YamlFlowsMixin, _YamlScalarsMixin):\n    \"\"\"YAML subset parser assembled from bounded implementation mixins.\"\"\"\n    _INT_RE = re.compile(r\"^-?\\d+$\")\n    _DIRECTIVE_RE = re.compile(r\"^\\s*%(YAML|TAG)\\b\")\n\n    def __init__(self, text: str, cpu_deadline_monotonic: float,\n                 policy_id_hint: str = \"\"):\n        self._lines = text.splitlines()\n        self._i = 0\n        self._n = len(self._lines)\n        self._deadline = cpu_deadline_monotonic\n        self._key_count = 0\n        self._policy_id_hint = policy_id_hint\n","numLines":144,"startLine":1,"totalLines":144}},"tool_result_meta":[{"id":"toolu_01PD75GuzDSvfkB4e5L7mdvJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1H3ZNeQm164qAnx6fax","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GmWGoPZPuL2DZeCx57NGF6","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/night-mode.py","offset":1,"limit":420},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4139,"cache_read_input_tokens":104233,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":4139},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"506ec16a-dc13-438e-b350-67d3c029ffa9","uuid":"d56cd827-3458-4e51-a86b-d6894ebc7eb0","timestamp":"2026-11-13T16:54:48.554Z","request_id":"req_011Ch1H3Z43bNGthHt386wW7","wire_tool_inputs":{"toolu_01GmWGoPZPuL2DZeCx57NGF6":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/night-mode.py","offset":1,"limit":420}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GmWGoPZPuL2DZeCx57NGF6","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"night-mode — Owner-invoked autonomy posture toggle (PLAN-165 W1 T1.1).\n3\t\n4\t`/night-mode on|off|status` flips the per-machine autonomy posture by\n5\tmerge-writing `permissions.defaultMode: \"acceptEdits\"` into the gitignored\n6\t`<project>/.claude/settings.local.json` overlay. The tracked\n7\t`.claude/settings.json` (fail-closed default: `defaultMode: \"manual\"` +\n8\t`disableAutoMode: \"disable\"`) is NEVER touched — settings are read at\n9\tsession start, so the toggle takes effect on the NEXT session\n10\t(\"arm before sleep, disarm in the morning\" semantics, PLAN-165 fact #5).\n11\t\n12\t## Design decisions carried in from the PLAN-165 v2 review\n13\t\n14\t- **D1 — no `bypassPermissions`, anywhere.** The only mode `on` ever\n15\t  writes is `acceptEdits`, and `off` restores only values from the\n16\t  closed set `_RESTORABLE_MODES` — which NEVER includes\n17\t  `bypassPermissions` (NM-01). `bypassPermissions` in ANY settings layer\n18\t  trips `TAMPER_PERMISSION_BYPASS` (`_lib/effective_config.py`) and turns\n19\t  `/ceo-boot` red by design; the honest escape valve is an explicit,\n20\t  ephemeral `claude --permission-mode bypassPermissions` session.\n21\t- **D2 — single-writer via ceremony prerequisite P1.** A deny rule for\n22\t  Edit/Write on `.claude/settings.local.json` (sentinel ceremony, blocks\n23\t  W1 landing) makes this script — a process write, not a tool write —\n24\t  the only writer of the overlay. This script does not and cannot\n25\t  enforce P1 itself; it relies on it for the escalation-ladder closure.\n26\t- **D3 — the boot banner derives from the resolver, not the marker.**\n27\t  The marker/snapshot file is decoration + restore-state only. `status`\n28\t  reconciles marker vs `_lib.effective_config.resolve_settings()` and\n29\t  REPORTS disagreement instead of picking a side.\n30\t\n31\t## State model (W0 decisions — fixed, do not revisit)\n32\t\n33\tMarker AND snapshot live in ONE file, `<project>/.claude/state/night-mode.json`\n34\t(gitignored via the `.claude/state/` entry), same filesystem as the\n35\tsettings overlay (atomicity; kills the slug-convention ambiguity, W0 T0.7):\n36\t\n37\t    {\"version\": 1, \"mode_written\": \"acceptEdits\", \"prev_present\": bool,\n38\t     \"prev_value\": null | <mode in _RESTORABLE_MODES>,\n39\t     \"created_file\": bool, \"ts\": \"...Z\", \"hostname\": \"...\"}\n40\t\n41\tThe file is gitignored, unguarded and agent-writable, so on the way IN\n42\t(`off`) it is UNTRUSTED input: `_validate_marker` checks the whole\n43\tdocument against that schema — including the consistency rule\n44\t`created_file=True implies prev_present=False` — before any field is\n45\tacted on (NF-03).\n46\t\n47\tThe snapshot is CREATE-ONLY (contract item 4): if the marker exists, `on`\n48\tis a no-op (exit 0). Without this, a second `on` would snapshot the value\n49\tnight-mode itself wrote and `off` would \"restore\" `acceptEdits` — a\n50\tpermanently weakened posture.\n51\t\n52\t## Write contract (PLAN-165 §Contrato de escrita — all items mandatory)\n53\t\n54\t1. `_lib.filelock.FileLock` around every whole mutation sequence.\n55\t2. Atomic writes only: tempfile in the SAME directory, flush + fsync,\n56\t   `os.replace`. Never a truncating in-place write — a torn/truncated\n57\t   settings file makes the harness skip the WHOLE file (S286 class).\n58\t3. Read-back after replace: reopen + re-parse; mismatch exits non-zero\n59\t   WITHOUT touching the marker.\n60\t4. Snapshot is create-only (above).\n61\t5. Defined ordering: `on` writes settings THEN marker; `off` restores\n62\t   settings THEN removes the marker. `status` reconciles and reports.\n63\t6. Malformed existing input is fail-CLOSED (exit 2, no write, clear\n64\t   diagnostic) — repo doctrine: fail-open on infra, fail-closed on input.\n65\t7. Double-`on` / double-`off` are no-ops that exit 0.\n66\t\n67\t## Non-goals with enforcement\n68\t\n69\tNo autonomy in CI: `on`/`off` REFUSE (exit 2) whenever the `CI` env var\n70\tis present (even empty — fail-closed on presence). `status` stays\n71\tavailable read-only. No tty gate (W0 T0.6: the Bash rail has no tty;\n72\tOwner presence is guaranteed by P1 + the CI refusal).\n73\t\n74\t## Audit (NM-05 / NF-07 — two records, one per terminating path)\n75\t\n76\tEvery `on`/`off` invocation leaves TWO records on EVERY terminating\n77\tpath, written as a pair, never one without the other:\n78\t\n79\t1. ONE machine-readable summary line on stdout (stable key=value shape) —\n80\t   the operator-facing record, unsigned and terminal-scoped:\n81\t\n82\t       night-mode-event mode=... previous_mode=... result=applied|noop|refused|failed\n83\t\n84\t2. ONE `night_mode_toggled` row on the HMAC-chained audit log, via\n85\t   `_emit_audit` -> `_lib.audit_emit.emit_night_mode_toggled` — the\n86\t   FORENSIC record PLAN-165 AC-7 requires. The overlay is written by a\n87\t   PROCESS, not by a tool, so no PostToolUse observer covers it: without\n88\t   this row a posture flip between sessions leaves no signed trace.\n89\t\n90\tThe action is REGISTERED (`_KNOWN_ACTIONS`, typed wrapper, deny-by-default\n91\tscrub branch, SPEC row — sentinel ceremony `610d9ec`), so the emit is\n92\tlive. Only the four allowlisted fields travel (`mode`, `previous_mode`,\n93\t`result`, `hostname_hash`); never a path, never file content, never the\n94\traw hostname. The emit is best-effort and NEVER raises: observability\n95\tmust not be able to block or fail the toggle.\n96\t\n97\t`status` emits NEITHER record — it is read-only, not a toggle.\n98\t\n99\t## Round-2 security hardening (see PLAN-165/architect/round-2/)\n100\t\n101\t- NM-01/NM-10 — `off` restores `prev_value` only if it is a string in\n102\t  the closed set `_RESTORABLE_MODES`; anything else (wrong type, unknown\n103\t  string, `bypassPermissions`) is fail-CLOSED exit 2 with the marker\n104\t  left in place. A tampered marker can no longer launder a value into\n105\t  the overlay through the Owner's own `off`.\n106\t- NM-02 — `on` never snapshots night-mode's own value: if the overlay\n107\t  already carries `acceptEdits` with no marker (crash/desync end-state),\n108\t  the snapshot is normalized to \"no prior override\" so `off` restores\n109\t  the project posture instead of freezing the weak one.\n110\t- NM-04 — `--project-root` is confined to this repository unless the\n111\t  test-only `CEO_NIGHT_MODE_TEST_SEAM` env var is set; the target must\n112\t  already contain `.claude/settings.json`.\n113\t- NM-09 — best-effort parent-directory fsync after `os.replace` and\n114\t  after overlay/marker unlink.\n115\t\n116\t## Round-3 security hardening (findings NF-01..NF-04)\n117\t\n118\t- NF-01 — `_RESTORABLE_MODES` excludes `NIGHT_MODE` itself. `cmd_on`'s\n119\t  desync normalization guarantees a healthy marker never carries\n120\t  night-mode's own value, so admitting it could only ever admit a\n121\t  TAMPERED value — and honoring it re-armed `acceptEdits` while REMOVING\n122\t  the marker, leaving the posture armed with every later `off` a forever\n123\t  no-op. `cmd_off` applies the same normalization symmetrically as a\n124\t  second layer.\n125\t- NF-02 — the restorable set is DERIVED from\n126\t  `_HARNESS_PERMISSION_MODES`, the CLI's real `--permission-mode` enum,\n127\t  instead of hand-listed: the hand-listed set carried a mode the harness\n128\t  does not have (`default`) and omitted one it does (`dontAsk`), so a\n129\t  legitimate `dontAsk` overlay was snapshotted by `on` and then refused\n130\t  by `off` FOREVER with `acceptEdits` left armed — fail-closed landing on\n131\t  the permissive side. `off --discard-snapshot` is the documented,\n132\t  non-restoring recovery from every fail-closed refusal, referenced in\n133\t  every refusal diagnostic.\n134\t- NF-03 — `_validate_marker` validates the marker as a WHOLE DOCUMENT\n135\t  before ANY field is acted on (version, mode_written, both booleans,\n136\t  prev_value, and the `created_file=True implies prev_present=False`\n137\t  consistency rule). Validating `prev_value` alone left the overlay\n138\t  `os.unlink` branch reachable from a planted `created_file` — silent\n139\t  data loss on an exit-0 `result=applied` path.\n140\t- NF-04 — the one-summary-per-terminating-path requirement (and the P2\n141\t  audit emit that lands beside it) is asserted STRUCTURALLY by an `ast`\n142\t  oracle in `tests/test_night_mode.py`, not just described in prose.\n143\t\n144\t## Round-4 security hardening (findings NF-05..NF-06)\n145\t\n146\tOne class, two surfaces: values from the two gitignored documents\n147\t(`settings.local.json`, `.claude/state/night-mode.json`) were echoed into\n148\tLINE-ORIENTED records without collapsing line breaks, so whoever can write\n149\teither file forges whole extra lines in records the Owner and parsers\n150\ttrust.\n151\t\n152\t- NF-05 — `cmd_on`'s success line interpolated `previous` (the overlay's\n153\t  RAW `permissions.defaultMode`) with neither `_bounded_repr` nor\n154\t  `_summary_token`, the only untrusted echo in the file that did. A `\\n`\n155\t  in that value made ONE `on` emit TWO `night-mode-event ` rows, the\n156\t  forged one claiming `result=applied`; a 200k-char value emitted 200k\n157\t  bytes. It now goes through `_bounded_repr` like every sibling.\n158\t- NF-06 — `cmd_status` never ran `_validate_marker` and printed\n159\t  `host=` / `ts=` raw, and `_validate_marker` never checked those two\n160\t  fields at all. So a planted `hostname` injected arbitrary status lines\n161\t  (a forged `reconciliation:` verdict landing BEFORE the true one), and\n162\t  `status` reported \"AGREE — night-mode ON\" for the very marker `off`\n163\t  refuses with exit 2 — the reporter blessing what the writer rejects.\n164\t  Now: `ts`/`hostname` are type-, length- and control-char-checked as part\n165\t  of the whole document (`_invalid_bounded_string`), `status` RUNS the\n166\t  validator and renders \"PRESENT but INVALID (<field>)\" with a DISAGREE\n167\t  verdict for a rejected marker, every untrusted echo is bounded, and the\n168\t  report is emitted through `_one_line` so no future field can forge a\n169\t  record.\n170\t\n171\t## Round-3 RE-REVIEW hardening (findings NF-07, NF-09)\n172\t\n173\t- NF-07 — the `night_mode_toggled` action was registered, SPEC'd and\n174\t  documented in signed surfaces, with ZERO production callers: a\n175\t  registered-and-empty action, and three published claims that were\n176\t  false. `_emit_audit` is now the sibling of every `_summary` call (see\n177\t  `## Audit` above), so the signed claim \"emitted on EVERY terminating\n178\t  path of on/off\" is true of this build. The `ast` oracle pins the PAIR,\n179\t  not just the summary — a later refactor that drops one of the two is a\n180\t  test failure, not a silent regression.\n181\t- NF-09 — `off` on the route where the overlay had ALREADY been removed\n182\t  by hand wrote nothing, then reported `restored to '<snapshot>'` with\n183\t  `result=applied` on both records. It now reports `absent` / `noop` and\n184\t  says plainly that nothing was restored. The bug was harmless while the\n185\t  record was only a stdout line; with NF-07 wired it would have put a\n186\t  false restore into the HMAC chain, which is why the two fixes belong in\n187\t  one commit.\n188\t\n189\t- NF-08b — the script refuses to run unless the file it was invoked as IS\n190\t  `<repo>/.claude/scripts/night-mode.py`. Round 2 of the cross-vendor\n191\t  review found that the Bash matcher guarding this toggle recognises\n192\t  SPELLINGS, and an alias exists to have a different one: `ln -s\n193\t  <repo>/.claude/scripts/night-mode.py /tmp/nm && python3 /tmp/nm on`\n194\t  armed the posture (measured, `result=applied`), because\n195\t  `Path(__file__).resolve()` follows the link back into the repository.\n196\t  Re-probing widened the class — a renamed copy inside the repo\n197\t  (`.claude/scripts/nm2.py`) armed it too, and no rule about `ln` would\n198\t  have caught that. The guard is here rather than in the hook because it\n199\t  holds however the alias was created and even if the hook never runs;\n200\t  the hook keeps the cheap half (denying `ln` on the toggle) as the\n201\t  earlier signal. An ancestor directory being a symlink is NOT an alias\n202\t  (`/tmp` -> `/private/tmp`), so ancestors are resolved separately.\n203\t\n204\tExit codes:\n205\t    0 — success or idempotent no-op\n206\t    1 — read-back mismatch / post-write verification failure\n207\t    2 — usage error, CI refusal, alias/relocated invocation (NF-08b),\n208\t        root confinement (NM-04), tampered or malformed marker (NM-01 /\n209\t        NF-01..NF-03 / NF-06), or malformed input (all fail-closed).\n210\t        Recover an armed posture from any of these with\n211\t        `off --discard-snapshot`.\n212\t\n213\tStdlib-only; Python >= 3.9.\n214\t\"\"\"\n215\t\n216\tfrom __future__ import annotations\n217\t\n218\timport argparse\n219\timport copy\n220\timport hashlib\n221\timport json\n222\timport os\n223\timport socket\n224\timport stat\n225\timport sys\n226\timport tempfile\n227\tfrom datetime import datetime, timezone\n228\tfrom pathlib import Path\n229\tfrom typing import Any, Dict, List, Optional, Tuple\n230\t\n231\tREPO_ROOT = Path(__file__).resolve().parents[2]\n232\t\n233\t# NF-08b — the path this script was INVOKED as, before any symlink is\n234\t# followed. Captured at import so it cannot depend on a later `os.chdir`;\n235\t# `absolute()` deliberately does NOT resolve links (that is the whole point —\n236\t# `REPO_ROOT` above already has the resolved form).\n237\t_INVOKED_SELF = Path(__file__).absolute()\n238\t\n239\t# The one relative location this script may legitimately be executed from.\n240\t_CANONICAL_SELF_PARTS = (\".claude\", \"scripts\", \"night-mode.py\")\n241\t\n242\t# The ONLY mode `on` ever writes (PLAN-165 D1 — bypassPermissions was cut\n243\t# in review; do not add a mode flag).\n244\tNIGHT_MODE = \"acceptEdits\"\n245\t\n246\t# The harness's REAL `--permission-mode` enum — verified against\n247\t# `claude --help` on the pinned CLI (2026-08-03). NF-02 (round-3 review):\n248\t# the restorable set below is DERIVED from this enum instead of being\n249\t# hand-listed, because a hand-listed set drifted BOTH ways at once — it\n250\t# carried `default` (never a harness mode) and OMITTED `dontAsk` (a legal\n251\t# one). The omission was the dangerous half: an Owner whose overlay\n252\t# legitimately carried `dontAsk` had it snapshotted by `on`, and then every\n253\t# `off` refused forever with `acceptEdits` left armed — a fail-closed gate\n254\t# landing on the PERMISSIVE side. If the CLI gains a mode, update THIS\n255\t# constant; the derivation and the diagnostics follow automatically.\n256\t_HARNESS_PERMISSION_MODES = frozenset(\n257\t    {\"acceptEdits\", \"auto\", \"bypassPermissions\", \"manual\", \"dontAsk\", \"plan\"}\n258\t)\n259\t\n260\t# NM-01 / NF-01 / NF-02 — closed set of modes `off` may restore. Derived,\n261\t# with exactly two exclusions, both load-bearing:\n262\t#\n263\t# - `bypassPermissions` (D1): present in ANY settings layer it trips\n264\t#   `TAMPER_PERMISSION_BYPASS` (`_lib/effective_config.py`) and turns\n265\t#   `/ceo-boot` red by design. night-mode must never be the thing that\n266\t#   writes it back — not even under the name \"restoring\".\n267\t# - `NIGHT_MODE` (`acceptEdits`, NF-01): cmd_on's desync normalization\n268\t#   guarantees that a HEALTHY marker never carries night-mode's own value\n269\t#   as `prev_value`. Admitting it to the set could therefore only ever\n270\t#   admit a TAMPERED value — and honoring it produces the worst end-state\n271\t#   this script has: `off` re-writes `acceptEdits` into the overlay,\n272\t#   REMOVES the marker, and exits 0, leaving the posture armed with no\n273\t#   marker, so every later `off` is a forever no-op.\n274\t#\n275\t# The marker is gitignored, unguarded, agent-writable state; a `prev_value`\n276\t# outside this set is evidence of tampering (or of a mode enum this build\n277\t# does not know), so restore fails CLOSED — with `off --discard-snapshot`\n278\t# as the documented, non-restoring way out (NF-02).\n279\t_RESTORABLE_MODES = _HARNESS_PERMISSION_MODES - {\"bypassPermissions\", NIGHT_MODE}\n280\t\n281\t# NF-02 — the sanctioned exit from EVERY fail-closed refusal in `off`. A\n282\t# refusal must never strand the operator with the posture armed and no way\n283\t# to disarm it short of hand-editing two gitignored files.\n284\t_DISCARD_HINT = (\n285\t    \"Recovery: 'night-mode off --discard-snapshot' removes the local \"\n286\t    \"defaultMode override AND the marker WITHOUT honoring prev_value, and \"\n287\t    \"prints exactly what it discarded.\"\n288\t)\n289\t\n290\t# NM-04 — test-only escape hatch for the --project-root confinement.\n291\t# Set ONLY by the test suite (isolated tmp trees under TestEnvContext).\n292\t_TEST_SEAM_ENV = \"CEO_NIGHT_MODE_TEST_SEAM\"\n293\t\n294\tMARKER_VERSION = 1\n295\t\n296\t_EPILOG = (\n297\t    \"Audit (NM-05/NF-07): every on/off invocation leaves TWO records on \"\n298\t    \"EVERY terminating path — one machine-readable summary line on stdout \"\n299\t    \"('night-mode-event mode=... previous_mode=... \"\n300\t    \"result=applied|noop|refused|failed') and one forensic \"\n301\t    \"'night_mode_toggled' row on the HMAC-chained audit log (registered \"\n302\t    \"action + typed wrapper, sentinel ceremony 610d9ec). Only mode, \"\n303\t    \"previous_mode, result and a hashed hostname travel — never a path, \"\n304\t    \"never file content, never the raw hostname; the emit is best-effort \"\n305\t    \"and never blocks the toggle. 'status' emits neither (read-only). \"\n306\t    \"Refuses on/off when the CI env var is set (PLAN-165 AC-11). \"\n307\t    \"Recovery (NF-02): 'off --discard-snapshot' is the sanctioned exit from \"\n308\t    \"every fail-closed refusal — it removes the local defaultMode override \"\n309\t    \"AND the marker WITHOUT honoring the snapshot's prev_value, printing \"\n310\t    \"exactly what it discarded, and it also disarms the \"\n311\t    \"armed-without-marker state where plain 'off' is a no-op. A refusal \"\n312\t    \"must never leave the posture armed with no way to disarm it. \"\n313\t    \"--project-root is a TEST-ONLY seam confined to this repository \"\n314\t    \"(NM-04); the test-only CEO_NIGHT_MODE_TEST_SEAM env var lifts the \"\n315\t    \"confinement for isolated test trees, and the target must already \"\n316\t    \"contain .claude/settings.json.\"\n317\t)\n318\t\n319\t\n320\t# --------------------------------------------------------------------------- #\n321\t# Path resolution — anchored in FUNCTIONS, not module-level literals, so a\n322\t# test's --project-root (or a patched env) cannot be defeated by an\n323\t# import-time constant (PLAN-165 T1.3 note).\n324\t# --------------------------------------------------------------------------- #\n325\t\n326\t# Bind extracted implementation to this module global namespace.\n327\t_hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n328\tif _hooks_dir not in sys.path:\n329\t    sys.path.insert(0, _hooks_dir)\n330\tfrom _lib._night_mode_parts import install as _install_parts\n331\t_install_parts(globals(), (\"helpers\", \"toggles\"))\n332\t\n333\tdef _local_layer(resolved: Dict[str, Any]) -> Dict[str, Any]:\n334\t    for layer in resolved.get(\"layers\", []):\n335\t        if isinstance(layer, dict) and layer.get(\"name\") == \"local\":\n336\t            return layer\n337\t    return {}\n338\t\n339\t\n340\tdef cmd_status(root: Path) -> int:\n341\t    \"\"\"Reconcile marker vs resolver and REPORT disagreement (D3 + contract 5).\n342\t\n343\t    Read-only; always exits 0. The posture line derives from\n344\t    `_lib.effective_config.resolve_settings()` — the same resolver the\n345\t    tamper tripwires use — never from the marker alone.\n346\t\n347\t    NF-06 (round-4): this command RUNS `_validate_marker` and renders its\n348\t    verdict. It used to print `host=` / `ts=` raw and reconcile a marker it\n349\t    never validated, so it reported \"AGREE — night-mode ON\" for the very\n350\t    document `off` refuses with exit 2 — status blessed what the writer\n351\t    rejects, and a planted `hostname` forged extra lines (a fake\n352\t    `reconciliation:` verdict landing BEFORE the true one). Now: every\n353\t    untrusted echo goes through `_bounded_repr`, an invalid marker reads\n354\t    \"PRESENT but INVALID (<field>)\" and can never reach an AGREE verdict,\n355\t    and every rendered line is collapsed with `_one_line` so no future echo\n356\t    can forge a record either.\n357\t    \"\"\"\n358\t    hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n359\t    if hooks_dir not in sys.path:\n360\t        sys.path.insert(0, hooks_dir)\n361\t    from _lib import effective_config  # noqa: E402\n362\t\n363\t    resolved = effective_config.resolve_settings(str(root))\n364\t    effective = resolved.get(\"effective\") or {}\n365\t    permissions = effective.get(\"permissions\")\n366\t    eff_mode = permissions.get(\"defaultMode\") if isinstance(permissions, dict) else None\n367\t    eff_layer = (resolved.get(\"sources\") or {}).get(\"permissions\", \"(none)\")\n368\t\n369\t    lines: List[str] = [\"## night-mode status\"]\n370\t    lines.append(\n371\t        \"effective permissions.defaultMode: {0} \"\n372\t        \"(layer: {1}; resolver: _lib.effective_config)\".format(\n373\t            # NF-06: bounded — the winning value can come from the overlay.\n374\t            _bounded_repr(eff_mode), eff_layer,\n375\t        )\n376\t    )\n377\t    if not resolved.get(\"ok\", True):\n378\t        lines.append(f\"resolver errors: {_bounded_repr(resolved.get('errors'))}\")\n379\t\n380\t    # What the LOCAL overlay itself says (the layer night-mode writes).\n381\t    local = _local_layer(resolved)\n382\t    local_data = local.get(\"data\") if isinstance(local.get(\"data\"), dict) else {}\n383\t    local_perms = local_data.get(\"permissions\")\n384\t    local_mode = local_perms.get(\"defaultMode\") if isinstance(local_perms, dict) else None\n385\t    lines.append(\n386\t        \"local overlay defaultMode: {0} (exists={1}, parse_ok={2})\".format(\n387\t            _bounded_repr(local_mode),\n388\t            bool(local.get(\"exists\")),\n389\t            bool(local.get(\"ok\")),\n390\t        )\n391\t    )\n392\t\n393\t    marker_file = marker_path(root)\n394\t    marker: Optional[Dict[str, Any]] = None\n395\t    marker_diag: Optional[str] = None\n396\t    marker_invalid: Optional[str] = None\n397\t    if marker_file.exists():\n398\t        marker, marker_diag = _load_json_fail_closed(marker_file, \"night-mode marker\")\n399\t\n400\t    if marker is not None:\n401\t        # NF-06: the SAME whole-document gate `off` applies. A marker status\n402\t        # blesses must be a marker the writer would accept.\n403\t        marker_invalid = _validate_marker(marker)\n404\t        lines.append(\n405\t            \"marker: {0} (age {1}, mode_written={2}, host={3}, ts={4})\".format(\n406\t                \"PRESENT\" if marker_invalid is None else \"PRESENT but INVALID\",\n407\t                _marker_age_str(str(marker.get(\"ts\"))),\n408\t                _bounded_repr(marker.get(\"mode_written\")),\n409\t                _bounded_repr(marker.get(\"hostname\")),\n410\t                _bounded_repr(marker.get(\"ts\")),\n411\t            )\n412\t        )\n413\t        if marker_invalid is not None:\n414\t            lines.append(f\"marker validation: {marker_invalid}\")\n415\t    elif marker_diag is not None:\n416\t        lines.append(f\"marker: PRESENT but unreadable — {marker_diag}\")\n417\t    else:\n418\t        lines.append(\"marker: absent (night-mode OFF)\")\n419\t\n420\t    # Reconciliation — report, never repair (contract item 5)."}]},"parent_tool_use_id":null,"session_id":"506ec16a-dc13-438e-b350-67d3c029ffa9","uuid":"df6ed9e3-216a-47a6-afaa-4caf6b957fb0","timestamp":"2026-11-13T16:54:48.587Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/night-mode.py","content":"#!/usr/bin/env python3\n\"\"\"night-mode — Owner-invoked autonomy posture toggle (PLAN-165 W1 T1.1).\n\n`/night-mode on|off|status` flips the per-machine autonomy posture by\nmerge-writing `permissions.defaultMode: \"acceptEdits\"` into the gitignored\n`<project>/.claude/settings.local.json` overlay. The tracked\n`.claude/settings.json` (fail-closed default: `defaultMode: \"manual\"` +\n`disableAutoMode: \"disable\"`) is NEVER touched — settings are read at\nsession start, so the toggle takes effect on the NEXT session\n(\"arm before sleep, disarm in the morning\" semantics, PLAN-165 fact #5).\n\n## Design decisions carried in from the PLAN-165 v2 review\n\n- **D1 — no `bypassPermissions`, anywhere.** The only mode `on` ever\n  writes is `acceptEdits`, and `off` restores only values from the\n  closed set `_RESTORABLE_MODES` — which NEVER includes\n  `bypassPermissions` (NM-01). `bypassPermissions` in ANY settings layer\n  trips `TAMPER_PERMISSION_BYPASS` (`_lib/effective_config.py`) and turns\n  `/ceo-boot` red by design; the honest escape valve is an explicit,\n  ephemeral `claude --permission-mode bypassPermissions` session.\n- **D2 — single-writer via ceremony prerequisite P1.** A deny rule for\n  Edit/Write on `.claude/settings.local.json` (sentinel ceremony, blocks\n  W1 landing) makes this script — a process write, not a tool write —\n  the only writer of the overlay. This script does not and cannot\n  enforce P1 itself; it relies on it for the escalation-ladder closure.\n- **D3 — the boot banner derives from the resolver, not the marker.**\n  The marker/snapshot file is decoration + restore-state only. `status`\n  reconciles marker vs `_lib.effective_config.resolve_settings()` and\n  REPORTS disagreement instead of picking a side.\n\n## State model (W0 decisions — fixed, do not revisit)\n\nMarker AND snapshot live in ONE file, `<project>/.claude/state/night-mode.json`\n(gitignored via the `.claude/state/` entry), same filesystem as the\nsettings overlay (atomicity; kills the slug-convention ambiguity, W0 T0.7):\n\n    {\"version\": 1, \"mode_written\": \"acceptEdits\", \"prev_present\": bool,\n     \"prev_value\": null | <mode in _RESTORABLE_MODES>,\n     \"created_file\": bool, \"ts\": \"...Z\", \"hostname\": \"...\"}\n\nThe file is gitignored, unguarded and agent-writable, so on the way IN\n(`off`) it is UNTRUSTED input: `_validate_marker` checks the whole\ndocument against that schema — including the consistency rule\n`created_file=True implies prev_present=False` — before any field is\nacted on (NF-03).\n\nThe snapshot is CREATE-ONLY (contract item 4): if the marker exists, `on`\nis a no-op (exit 0). Without this, a second `on` would snapshot the value\nnight-mode itself wrote and `off` would \"restore\" `acceptEdits` — a\npermanently weakened posture.\n\n## Write contract (PLAN-165 §Contrato de escrita — all items mandatory)\n\n1. `_lib.filelock.FileLock` around every whole mutation sequence.\n2. Atomic writes only: tempfile in the SAME directory, flush + fsync,\n   `os.replace`. Never a truncating in-place write — a torn/truncated\n   settings file makes the harness skip the WHOLE file (S286 class).\n3. Read-back after replace: reopen + re-parse; mismatch exits non-zero\n   WITHOUT touching the marker.\n4. Snapshot is create-only (above).\n5. Defined ordering: `on` writes settings THEN marker; `off` restores\n   settings THEN removes the marker. `status` reconciles and reports.\n6. Malformed existing input is fail-CLOSED (exit 2, no write, clear\n   diagnostic) — repo doctrine: fail-open on infra, fail-closed on input.\n7. Double-`on` / double-`off` are no-ops that exit 0.\n\n## Non-goals with enforcement\n\nNo autonomy in CI: `on`/`off` REFUSE (exit 2) whenever the `CI` env var\nis present (even empty — fail-closed on presence). `status` stays\navailable read-only. No tty gate (W0 T0.6: the Bash rail has no tty;\nOwner presence is guaranteed by P1 + the CI refusal).\n\n## Audit (NM-05 / NF-07 — two records, one per terminating path)\n\nEvery `on`/`off` invocation leaves TWO records on EVERY terminating\npath, written as a pair, never one without the other:\n\n1. ONE machine-readable summary line on stdout (stable key=value shape) —\n   the operator-facing record, unsigned and terminal-scoped:\n\n       night-mode-event mode=... previous_mode=... result=applied|noop|refused|failed\n\n2. ONE `night_mode_toggled` row on the HMAC-chained audit log, via\n   `_emit_audit` -> `_lib.audit_emit.emit_night_mode_toggled` — the\n   FORENSIC record PLAN-165 AC-7 requires. The overlay is written by a\n   PROCESS, not by a tool, so no PostToolUse observer covers it: without\n   this row a posture flip between sessions leaves no signed trace.\n\nThe action is REGISTERED (`_KNOWN_ACTIONS`, typed wrapper, deny-by-default\nscrub branch, SPEC row — sentinel ceremony `610d9ec`), so the emit is\nlive. Only the four allowlisted fields travel (`mode`, `previous_mode`,\n`result`, `hostname_hash`); never a path, never file content, never the\nraw hostname. The emit is best-effort and NEVER raises: observability\nmust not be able to block or fail the toggle.\n\n`status` emits NEITHER record — it is read-only, not a toggle.\n\n## Round-2 security hardening (see PLAN-165/architect/round-2/)\n\n- NM-01/NM-10 — `off` restores `prev_value` only if it is a string in\n  the closed set `_RESTORABLE_MODES`; anything else (wrong type, unknown\n  string, `bypassPermissions`) is fail-CLOSED exit 2 with the marker\n  left in place. A tampered marker can no longer launder a value into\n  the overlay through the Owner's own `off`.\n- NM-02 — `on` never snapshots night-mode's own value: if the overlay\n  already carries `acceptEdits` with no marker (crash/desync end-state),\n  the snapshot is normalized to \"no prior override\" so `off` restores\n  the project posture instead of freezing the weak one.\n- NM-04 — `--project-root` is confined to this repository unless the\n  test-only `CEO_NIGHT_MODE_TEST_SEAM` env var is set; the target must\n  already contain `.claude/settings.json`.\n- NM-09 — best-effort parent-directory fsync after `os.replace` and\n  after overlay/marker unlink.\n\n## Round-3 security hardening (findings NF-01..NF-04)\n\n- NF-01 — `_RESTORABLE_MODES` excludes `NIGHT_MODE` itself. `cmd_on`'s\n  desync normalization guarantees a healthy marker never carries\n  night-mode's own value, so admitting it could only ever admit a\n  TAMPERED value — and honoring it re-armed `acceptEdits` while REMOVING\n  the marker, leaving the posture armed with every later `off` a forever\n  no-op. `cmd_off` applies the same normalization symmetrically as a\n  second layer.\n- NF-02 — the restorable set is DERIVED from\n  `_HARNESS_PERMISSION_MODES`, the CLI's real `--permission-mode` enum,\n  instead of hand-listed: the hand-listed set carried a mode the harness\n  does not have (`default`) and omitted one it does (`dontAsk`), so a\n  legitimate `dontAsk` overlay was snapshotted by `on` and then refused\n  by `off` FOREVER with `acceptEdits` left armed — fail-closed landing on\n  the permissive side. `off --discard-snapshot` is the documented,\n  non-restoring recovery from every fail-closed refusal, referenced in\n  every refusal diagnostic.\n- NF-03 — `_validate_marker` validates the marker as a WHOLE DOCUMENT\n  before ANY field is acted on (version, mode_written, both booleans,\n  prev_value, and the `created_file=True implies prev_present=False`\n  consistency rule). Validating `prev_value` alone left the overlay\n  `os.unlink` branch reachable from a planted `created_file` — silent\n  data loss on an exit-0 `result=applied` path.\n- NF-04 — the one-summary-per-terminating-path requirement (and the P2\n  audit emit that lands beside it) is asserted STRUCTURALLY by an `ast`\n  oracle in `tests/test_night_mode.py`, not just described in prose.\n\n## Round-4 security hardening (findings NF-05..NF-06)\n\nOne class, two surfaces: values from the two gitignored documents\n(`settings.local.json`, `.claude/state/night-mode.json`) were echoed into\nLINE-ORIENTED records without collapsing line breaks, so whoever can write\neither file forges whole extra lines in records the Owner and parsers\ntrust.\n\n- NF-05 — `cmd_on`'s success line interpolated `previous` (the overlay's\n  RAW `permissions.defaultMode`) with neither `_bounded_repr` nor\n  `_summary_token`, the only untrusted echo in the file that did. A `\\n`\n  in that value made ONE `on` emit TWO `night-mode-event ` rows, the\n  forged one claiming `result=applied`; a 200k-char value emitted 200k\n  bytes. It now goes through `_bounded_repr` like every sibling.\n- NF-06 — `cmd_status` never ran `_validate_marker` and printed\n  `host=` / `ts=` raw, and `_validate_marker` never checked those two\n  fields at all. So a planted `hostname` injected arbitrary status lines\n  (a forged `reconciliation:` verdict landing BEFORE the true one), and\n  `status` reported \"AGREE — night-mode ON\" for the very marker `off`\n  refuses with exit 2 — the reporter blessing what the writer rejects.\n  Now: `ts`/`hostname` are type-, length- and control-char-checked as part\n  of the whole document (`_invalid_bounded_string`), `status` RUNS the\n  validator and renders \"PRESENT but INVALID (<field>)\" with a DISAGREE\n  verdict for a rejected marker, every untrusted echo is bounded, and the\n  report is emitted through `_one_line` so no future field can forge a\n  record.\n\n## Round-3 RE-REVIEW hardening (findings NF-07, NF-09)\n\n- NF-07 — the `night_mode_toggled` action was registered, SPEC'd and\n  documented in signed surfaces, with ZERO production callers: a\n  registered-and-empty action, and three published claims that were\n  false. `_emit_audit` is now the sibling of every `_summary` call (see\n  `## Audit` above), so the signed claim \"emitted on EVERY terminating\n  path of on/off\" is true of this build. The `ast` oracle pins the PAIR,\n  not just the summary — a later refactor that drops one of the two is a\n  test failure, not a silent regression.\n- NF-09 — `off` on the route where the overlay had ALREADY been removed\n  by hand wrote nothing, then reported `restored to '<snapshot>'` with\n  `result=applied` on both records. It now reports `absent` / `noop` and\n  says plainly that nothing was restored. The bug was harmless while the\n  record was only a stdout line; with NF-07 wired it would have put a\n  false restore into the HMAC chain, which is why the two fixes belong in\n  one commit.\n\n- NF-08b — the script refuses to run unless the file it was invoked as IS\n  `<repo>/.claude/scripts/night-mode.py`. Round 2 of the cross-vendor\n  review found that the Bash matcher guarding this toggle recognises\n  SPELLINGS, and an alias exists to have a different one: `ln -s\n  <repo>/.claude/scripts/night-mode.py /tmp/nm && python3 /tmp/nm on`\n  armed the posture (measured, `result=applied`), because\n  `Path(__file__).resolve()` follows the link back into the repository.\n  Re-probing widened the class — a renamed copy inside the repo\n  (`.claude/scripts/nm2.py`) armed it too, and no rule about `ln` would\n  have caught that. The guard is here rather than in the hook because it\n  holds however the alias was created and even if the hook never runs;\n  the hook keeps the cheap half (denying `ln` on the toggle) as the\n  earlier signal. An ancestor directory being a symlink is NOT an alias\n  (`/tmp` -> `/private/tmp`), so ancestors are resolved separately.\n\nExit codes:\n    0 — success or idempotent no-op\n    1 — read-back mismatch / post-write verification failure\n    2 — usage error, CI refusal, alias/relocated invocation (NF-08b),\n        root confinement (NM-04), tampered or malformed marker (NM-01 /\n        NF-01..NF-03 / NF-06), or malformed input (all fail-closed).\n        Recover an armed posture from any of these with\n        `off --discard-snapshot`.\n\nStdlib-only; Python >= 3.9.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport hashlib\nimport json\nimport os\nimport socket\nimport stat\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\n\n# NF-08b — the path this script was INVOKED as, before any symlink is\n# followed. Captured at import so it cannot depend on a later `os.chdir`;\n# `absolute()` deliberately does NOT resolve links (that is the whole point —\n# `REPO_ROOT` above already has the resolved form).\n_INVOKED_SELF = Path(__file__).absolute()\n\n# The one relative location this script may legitimately be executed from.\n_CANONICAL_SELF_PARTS = (\".claude\", \"scripts\", \"night-mode.py\")\n\n# The ONLY mode `on` ever writes (PLAN-165 D1 — bypassPermissions was cut\n# in review; do not add a mode flag).\nNIGHT_MODE = \"acceptEdits\"\n\n# The harness's REAL `--permission-mode` enum — verified against\n# `claude --help` on the pinned CLI (2026-08-03). NF-02 (round-3 review):\n# the restorable set below is DERIVED from this enum instead of being\n# hand-listed, because a hand-listed set drifted BOTH ways at once — it\n# carried `default` (never a harness mode) and OMITTED `dontAsk` (a legal\n# one). The omission was the dangerous half: an Owner whose overlay\n# legitimately carried `dontAsk` had it snapshotted by `on`, and then every\n# `off` refused forever with `acceptEdits` left armed — a fail-closed gate\n# landing on the PERMISSIVE side. If the CLI gains a mode, update THIS\n# constant; the derivation and the diagnostics follow automatically.\n_HARNESS_PERMISSION_MODES = frozenset(\n    {\"acceptEdits\", \"auto\", \"bypassPermissions\", \"manual\", \"dontAsk\", \"plan\"}\n)\n\n# NM-01 / NF-01 / NF-02 — closed set of modes `off` may restore. Derived,\n# with exactly two exclusions, both load-bearing:\n#\n# - `bypassPermissions` (D1): present in ANY settings layer it trips\n#   `TAMPER_PERMISSION_BYPASS` (`_lib/effective_config.py`) and turns\n#   `/ceo-boot` red by design. night-mode must never be the thing that\n#   writes it back — not even under the name \"restoring\".\n# - `NIGHT_MODE` (`acceptEdits`, NF-01): cmd_on's desync normalization\n#   guarantees that a HEALTHY marker never carries night-mode's own value\n#   as `prev_value`. Admitting it to the set could therefore only ever\n#   admit a TAMPERED value — and honoring it produces the worst end-state\n#   this script has: `off` re-writes `acceptEdits` into the overlay,\n#   REMOVES the marker, and exits 0, leaving the posture armed with no\n#   marker, so every later `off` is a forever no-op.\n#\n# The marker is gitignored, unguarded, agent-writable state; a `prev_value`\n# outside this set is evidence of tampering (or of a mode enum this build\n# does not know), so restore fails CLOSED — with `off --discard-snapshot`\n# as the documented, non-restoring way out (NF-02).\n_RESTORABLE_MODES = _HARNESS_PERMISSION_MODES - {\"bypassPermissions\", NIGHT_MODE}\n\n# NF-02 — the sanctioned exit from EVERY fail-closed refusal in `off`. A\n# refusal must never strand the operator with the posture armed and no way\n# to disarm it short of hand-editing two gitignored files.\n_DISCARD_HINT = (\n    \"Recovery: 'night-mode off --discard-snapshot' removes the local \"\n    \"defaultMode override AND the marker WITHOUT honoring prev_value, and \"\n    \"prints exactly what it discarded.\"\n)\n\n# NM-04 — test-only escape hatch for the --project-root confinement.\n# Set ONLY by the test suite (isolated tmp trees under TestEnvContext).\n_TEST_SEAM_ENV = \"CEO_NIGHT_MODE_TEST_SEAM\"\n\nMARKER_VERSION = 1\n\n_EPILOG = (\n    \"Audit (NM-05/NF-07): every on/off invocation leaves TWO records on \"\n    \"EVERY terminating path — one machine-readable summary line on stdout \"\n    \"('night-mode-event mode=... previous_mode=... \"\n    \"result=applied|noop|refused|failed') and one forensic \"\n    \"'night_mode_toggled' row on the HMAC-chained audit log (registered \"\n    \"action + typed wrapper, sentinel ceremony 610d9ec). Only mode, \"\n    \"previous_mode, result and a hashed hostname travel — never a path, \"\n    \"never file content, never the raw hostname; the emit is best-effort \"\n    \"and never blocks the toggle. 'status' emits neither (read-only). \"\n    \"Refuses on/off when the CI env var is set (PLAN-165 AC-11). \"\n    \"Recovery (NF-02): 'off --discard-snapshot' is the sanctioned exit from \"\n    \"every fail-closed refusal — it removes the local defaultMode override \"\n    \"AND the marker WITHOUT honoring the snapshot's prev_value, printing \"\n    \"exactly what it discarded, and it also disarms the \"\n    \"armed-without-marker state where plain 'off' is a no-op. A refusal \"\n    \"must never leave the posture armed with no way to disarm it. \"\n    \"--project-root is a TEST-ONLY seam confined to this repository \"\n    \"(NM-04); the test-only CEO_NIGHT_MODE_TEST_SEAM env var lifts the \"\n    \"confinement for isolated test trees, and the target must already \"\n    \"contain .claude/settings.json.\"\n)\n\n\n# --------------------------------------------------------------------------- #\n# Path resolution — anchored in FUNCTIONS, not module-level literals, so a\n# test's --project-root (or a patched env) cannot be defeated by an\n# import-time constant (PLAN-165 T1.3 note).\n# --------------------------------------------------------------------------- #\n\n# Bind extracted implementation to this module global namespace.\n_hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\nif _hooks_dir not in sys.path:\n    sys.path.insert(0, _hooks_dir)\nfrom _lib._night_mode_parts import install as _install_parts\n_install_parts(globals(), (\"helpers\", \"toggles\"))\n\ndef _local_layer(resolved: Dict[str, Any]) -> Dict[str, Any]:\n    for layer in resolved.get(\"layers\", []):\n        if isinstance(layer, dict) and layer.get(\"name\") == \"local\":\n            return layer\n    return {}\n\n\ndef cmd_status(root: Path) -> int:\n    \"\"\"Reconcile marker vs resolver and REPORT disagreement (D3 + contract 5).\n\n    Read-only; always exits 0. The posture line derives from\n    `_lib.effective_config.resolve_settings()` — the same resolver the\n    tamper tripwires use — never from the marker alone.\n\n    NF-06 (round-4): this command RUNS `_validate_marker` and renders its\n    verdict. It used to print `host=` / `ts=` raw and reconcile a marker it\n    never validated, so it reported \"AGREE — night-mode ON\" for the very\n    document `off` refuses with exit 2 — status blessed what the writer\n    rejects, and a planted `hostname` forged extra lines (a fake\n    `reconciliation:` verdict landing BEFORE the true one). Now: every\n    untrusted echo goes through `_bounded_repr`, an invalid marker reads\n    \"PRESENT but INVALID (<field>)\" and can never reach an AGREE verdict,\n    and every rendered line is collapsed with `_one_line` so no future echo\n    can forge a record either.\n    \"\"\"\n    hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n    if hooks_dir not in sys.path:\n        sys.path.insert(0, hooks_dir)\n    from _lib import effective_config  # noqa: E402\n\n    resolved = effective_config.resolve_settings(str(root))\n    effective = resolved.get(\"effective\") or {}\n    permissions = effective.get(\"permissions\")\n    eff_mode = permissions.get(\"defaultMode\") if isinstance(permissions, dict) else None\n    eff_layer = (resolved.get(\"sources\") or {}).get(\"permissions\", \"(none)\")\n\n    lines: List[str] = [\"## night-mode status\"]\n    lines.append(\n        \"effective permissions.defaultMode: {0} \"\n        \"(layer: {1}; resolver: _lib.effective_config)\".format(\n            # NF-06: bounded — the winning value can come from the overlay.\n            _bounded_repr(eff_mode), eff_layer,\n        )\n    )\n    if not resolved.get(\"ok\", True):\n        lines.append(f\"resolver errors: {_bounded_repr(resolved.get('errors'))}\")\n\n    # What the LOCAL overlay itself says (the layer night-mode writes).\n    local = _local_layer(resolved)\n    local_data = local.get(\"data\") if isinstance(local.get(\"data\"), dict) else {}\n    local_perms = local_data.get(\"permissions\")\n    local_mode = local_perms.get(\"defaultMode\") if isinstance(local_perms, dict) else None\n    lines.append(\n        \"local overlay defaultMode: {0} (exists={1}, parse_ok={2})\".format(\n            _bounded_repr(local_mode),\n            bool(local.get(\"exists\")),\n            bool(local.get(\"ok\")),\n        )\n    )\n\n    marker_file = marker_path(root)\n    marker: Optional[Dict[str, Any]] = None\n    marker_diag: Optional[str] = None\n    marker_invalid: Optional[str] = None\n    if marker_file.exists():\n        marker, marker_diag = _load_json_fail_closed(marker_file, \"night-mode marker\")\n\n    if marker is not None:\n        # NF-06: the SAME whole-document gate `off` applies. A marker status\n        # blesses must be a marker the writer would accept.\n        marker_invalid = _validate_marker(marker)\n        lines.append(\n            \"marker: {0} (age {1}, mode_written={2}, host={3}, ts={4})\".format(\n                \"PRESENT\" if marker_invalid is None else \"PRESENT but INVALID\",\n                _marker_age_str(str(marker.get(\"ts\"))),\n                _bounded_repr(marker.get(\"mode_written\")),\n                _bounded_repr(marker.get(\"hostname\")),\n                _bounded_repr(marker.get(\"ts\")),\n            )\n        )\n        if marker_invalid is not None:\n            lines.append(f\"marker validation: {marker_invalid}\")\n    elif marker_diag is not None:\n        lines.append(f\"marker: PRESENT but unreadable — {marker_diag}\")\n    else:\n        lines.append(\"marker: absent (night-mode OFF)\")\n\n    # Reconciliation — report, never repair (contract item 5).","numLines":420,"startLine":1,"totalLines":606}},"tool_result_meta":[{"id":"toolu_01GmWGoPZPuL2DZeCx57NGF6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
