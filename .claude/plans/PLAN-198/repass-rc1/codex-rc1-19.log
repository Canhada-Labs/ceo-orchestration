    83	def should_drain() -> bool:
    84	    """Return True if current spool meets event-count or staleness trigger.
    85	
    86	    P2-1: event-count trigger uses an actual newline-count over the spool
    87	    body (capped at DRAIN_TRIGGER_SIZE + 2 to keep the probe cheap), NOT
    88	    a byte-size proxy. Header is 1 line; we trigger when body lines >=
    89	    DRAIN_TRIGGER_SIZE.
    90	    """
