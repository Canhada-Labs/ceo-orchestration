   452	            (signal.SIGINT, _PREV_SIGINT_HANDLER),
   453	        ):
   454	            if previous is None:
   455	                continue
   456	            try:
   457	                if signal.getsignal(signum) is _signal_drain_handler:
   458	                    signal.signal(signum, previous)
   459	            except (ValueError, OSError):  # pragma: no cover
   460	                pass
   461	    _SPOOL_HEADER_CACHE.clear()
   462	    _ORDINAL_COUNTER.clear()
   463	    _JOURNAL_BUFFER.clear()
   464	    _EXIT_HANDLER_INSTALLED = False
