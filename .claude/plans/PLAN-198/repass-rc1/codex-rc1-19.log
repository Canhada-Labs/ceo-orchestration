   445	    """Clear all in-process spool state (caches + handler latch + buffer)."""
   446	    global _EXIT_HANDLER_INSTALLED, _IN_FORENSIC_EMIT, _IN_SPOOL_APPEND
   447	    global _PREV_SIGTERM_HANDLER, _PREV_SIGINT_HANDLER
   448	    global _EXIT_DEADLINE_MONOTONIC
   449	    if _EXIT_HANDLER_INSTALLED:
