   345	
   346	def _atexit_drain() -> None:
   347	    """Best-effort exit drain, except while a hook deadline is armed."""
   348	    if _exit_deadline_active():
   349	        _record_exit_deadline_skip("atexit")
   350	        return
   351	    try:
   352	        drain_now(force=True)
   353	    except Exception:
   354	        pass
   355	    try:
   356	        _flush_journal_buffer(os.getpid())
   357	    except Exception:
   358	        pass
   359	
   360	
   361	def _signal_drain_handler(signum: int, frame: Any) -> None:
   362	    """Drain when safe, then preserve the previous signal disposition."""
   363	    if _IN_SPOOL_APPEND:
   364	        _breadcrumb(f"signal {signum} arrived during spool_append; bail")
   365	    elif _exit_deadline_active():
   366	        _record_exit_deadline_skip(f"signal-{signum}")
   367	    else:
   368	        try:
   369	            drain_now(force=True)
   370	        except Exception:
   371	            pass
   372	        try:
   373	            _flush_journal_buffer(os.getpid())
   374	        except Exception:
   375	            pass
   376	    if signum == signal.SIGTERM:
   377	        prev = _PREV_SIGTERM_HANDLER
   378	    elif signum == signal.SIGINT:
   379	        prev = _PREV_SIGINT_HANDLER
   380	    else:
   381	        prev = signal.SIG_DFL
   382	    if prev is signal.SIG_IGN:
   383	        try:
   384	            signal.signal(signum, signal.SIG_IGN)
   385	        except (ValueError, OSError):  # pragma: no cover
   386	            pass
   387	        return
   388	    if callable(prev):
   389	        try:
   390	            signal.signal(signum, prev)
   391	        except (ValueError, OSError):  # pragma: no cover
   392	            pass
   393	        try:
   394	            prev(signum, frame)
   395	        except Exception:  # pragma: no cover
   396	            pass
   397	        return
   398	    try:
   399	        signal.signal(signum, signal.SIG_DFL)
   400	    except (ValueError, OSError):  # pragma: no cover
   401	        pass
   402	    try:
   403	        os.kill(os.getpid(), signum)
   404	    except OSError:  # pragma: no cover
   405	        pass
   406	
   407	
   408	def install_exit_handlers() -> None:
   409	    """Register atexit + SIGTERM/SIGINT drain handlers (idempotent one-shot)."""
   410	    global _EXIT_HANDLER_INSTALLED
   411	    global _PREV_SIGTERM_HANDLER, _PREV_SIGINT_HANDLER
   412	    if _EXIT_HANDLER_INSTALLED:
   413	        return
   414	    try:
   415	        atexit.register(_atexit_drain)
   416	    except Exception as e:  # pragma: no cover
   417	        _breadcrumb(f"atexit register failed: {type(e).__name__}: {e}")
   418	    try:
   419	        _PREV_SIGTERM_HANDLER = signal.signal(
   420	            signal.SIGTERM, _signal_drain_handler,
   421	        )
   422	        if _PREV_SIGTERM_HANDLER is _signal_drain_handler:
   423	            _PREV_SIGTERM_HANDLER = signal.SIG_DFL
   424	    except (ValueError, OSError) as e:
   425	        # Signal handlers only work on main thread; in worker threads
   426	        # signal.signal raises ValueError. Fail-open.
   427	        _breadcrumb(f"SIGTERM install skipped: {type(e).__name__}: {e}")
   428	    try:
   429	        _PREV_SIGINT_HANDLER = signal.signal(
   430	            signal.SIGINT, _signal_drain_handler,
   431	        )
   432	        if _PREV_SIGINT_HANDLER is _signal_drain_handler:
   433	            _PREV_SIGINT_HANDLER = signal.SIG_DFL
   434	    except (ValueError, OSError) as e:
   435	        _breadcrumb(f"SIGINT install skipped: {type(e).__name__}: {e}")
   436	    _EXIT_HANDLER_INSTALLED = True
