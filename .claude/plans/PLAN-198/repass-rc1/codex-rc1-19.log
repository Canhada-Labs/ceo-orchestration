     1	#!/usr/bin/env bash
     2	# _python-hook.sh — Python version resolver + hook invoker.
     3	#
     4	# Registered in .claude/settings.json as the entrypoint for every Python
     5	# hook (check_agent_spawn.py, audit_log.py). Resolves `python3.12` →
     6	# `python3.11` → `python3.10` → `python3` and refuses anything below 3.9.
     7	#
     8	# ## Why a shim?
     9	#
    10	# `python3` on a user's $PATH is not hermetic:
    11	# - asdf / pyenv resolution is shell-dependent
    12	# - macOS system Python is 3.9 on older machines
    13	# - ubuntu-22.04 runners default to 3.10
    14	# - ubuntu-24.04 runners default to 3.12
    15	# - minimal containers may ship Python 3.8 or none at all
    16	#
    17	# Letting Claude Code run `python3 ...` directly lets a mis-resolved PATH
    18	# silently pick a version that can't run the hooks. The shim is explicit:
    19	# it looks for the newest Python 3.x ≥ 3.9 and refuses to continue if no
    20	# compatible interpreter is found. The refusal message points at install
    21	# commands so the Owner can fix it in one step.
    22	#
    23	# ## Minimum Python version
    24	#
    25	# **3.9** — the macOS system Python on Big Sur / Monterey. This is a
    26	# concession to reality: the original PLAN-002 §11-bis Q1 targeted 3.10
    27	# as minimum, but local dogfooding on this repo runs on 3.9.6 and
    28	# installing 3.10+ globally is out of scope for a framework that wants
    29	# to be "clone and use". All hook Python code is written with
    30	# `from __future__ import annotations` + `typing.Optional/Union` and
    31	# avoids match statements, so 3.9 is fully workable.
    32	#
    33	# ## Usage
    34	#
    35	# In settings.json:
    36	#     "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\" check_agent_spawn.py"
    37	#
    38	# The shim forwards stdin/stdout/stderr and passes any trailing args
    39	# through to the Python interpreter.
    40	
    41	# F-CHAOS-5 (PLAN-019) + PLAN-023 Phase F (F-perf-001): explicit Python
    42	# version gate, gated to the cache-miss branch only.
    43	#
    44	# Framework requires Python >=3.9 (ADR-002). Earlier versions silently
    45	# lack stdlib features (from __future__ import annotations, etc.).
    46	#
    47	# Pre PLAN-023 Phase F: _py_version_check() ran unconditionally at shim
    48	# entry, spawning a `python3 -c "import sys..."` subprocess every single
    49	# invocation (~15-20ms). Cache-hit paths paid this cost even though the
    50	# cached interpreter had already been validated on its first resolution.
    51	#
    52	# Post PLAN-023 Phase F: the check is called ONLY from the cache-miss
    53	# branch below (after CANDIDATES-loop probing). The cache file persists
    54	# a validated interpreter absolute path; a cache-hit restore implicitly
    55	# re-validates by invoking the cached binary for the hook itself. If the
    56	# cached binary has been uninstalled between invocations, the subsequent
    57	# hook invocation fails loud with the OS-level "No such file" — cleaner
    58	# signal than a silent version re-probe.
    59	_py_version_check() {
    60	  local ver
    61	  ver=$(python3 -c "import sys; print(f\"{sys.version_info.major}.{sys.version_info.minor}\")" 2>/dev/null) || {
    62	    echo "ERROR: python3 not found or invocable. Framework requires Python >=3.9." >&2
    63	    exit 3
    64	  }
    65	  local major minor
    66	  major=${ver%.*}
    67	  minor=${ver#*.}
    68	  if [ "$major" -lt 3 ] || { [ "$major" -eq 3 ] && [ "$minor" -lt 9 ]; }; then
    69	    echo "ERROR: Python $ver detected; framework requires >=3.9 (ADR-002)." >&2
    70	    echo "       Upgrade via your package manager and retry." >&2
    71	    exit 3
    72	  fi
    73	}
    74	# NOTE: call is deferred to the cache-miss branch below (see
    75	# `_py_version_check` call site inside the CANDIDATES loop). Intentionally
    76	# no call here — Phase F perf optimization.
    77	
    78	# PLAN-025 F-perf-dead-code-1: the earlier `_extract_session_id()`
