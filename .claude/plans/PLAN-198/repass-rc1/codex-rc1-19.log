   239	# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.
   240	def reconcile_journal_at_session_start() -> JournalReconciliation:
   241	    """Walk audit-pending.*.journal entries; classify counts; emit forensic.
   242	
   243	    Returns the JournalReconciliation populated with counts. Emits
   244	    audit_flush_dropped_count via wired forensic callback (caller in
   245	    audit_emit wires the callback before invoking this).
   246	    """
   247	    rec = JournalReconciliation()
   248	    state_dir = _state_dir()
   249	    try:
   250	        if not state_dir.exists():
   251	            _forensic("audit_flush_dropped_count", _journal_rec_dict(rec))
   252	            return rec
   253	        names = sorted(os.listdir(str(state_dir)))
   254	    except OSError:
   255	        _forensic("audit_flush_dropped_count", _journal_rec_dict(rec))
   256	        return rec
   257	
   258	    by_record: Dict[str, Dict[str, bool]] = {}
   259	    for name in names:
   260	        if not name.startswith(_JOURNAL_PREFIX + "."):
   261	            continue
   262	        if not name.endswith(".journal"):
   263	            continue
   264	        if name == _aggregate_journal_path().name:
   265	            continue
   266	        # Parse <pid> from "audit-pending.<pid>.journal"
   267	        rest = name[len(_JOURNAL_PREFIX) + 1:]
   268	        pid_str = rest[:-len(".journal")]
   269	        try:
   270	            pid = int(pid_str)
   271	        except ValueError:
   272	            continue
   273	        if pid == os.getpid():
   274	            continue
   275	        if _is_alive_pid(pid):
   276	            continue
   277	        path = state_dir / name
   278	        try:
   279	            with path.open("r", encoding="utf-8") as f:
   280	                for raw in f:
   281	                    stripped = raw.strip()
   282	                    if not stripped:
   283	                        continue
   284	                    try:
   285	                        env = json.loads(stripped)
   286	                    except json.JSONDecodeError:
   287	                        continue
   288	                    if not isinstance(env, dict):
   289	                        continue
   290	                    rid = env.get("record_id")
   291	                    op = env.get("op")
   292	                    if not isinstance(rid, str) or not isinstance(op, str):
   293	                        continue
   294	                    slot = by_record.setdefault(
   295	                        rid, {"begin": False, "commit": False, "drained": False},
   296	                    )
   297	                    if op in slot:
   298	                        slot[op] = True
   299	        except OSError:
   300	            continue
   301	
   302	    for rid, ops in by_record.items():
   303	        if ops["begin"] and not ops["commit"]:
   304	            rec.begin_no_commit += 1
   305	        elif ops["commit"] and not ops["drained"]:
   306	            rec.commit_no_drained += 1
   307	        elif ops["commit"] and ops["drained"]:
   308	            rec.recovered += 1
   309	
   310	    # Trigger a recovery drain to sweep commit_no_drained envelopes.
   311	    if rec.commit_no_drained > 0:
   312	        recov = drain_now(force=True)
   313	        if recov.ok:
   314	            # iter2-P1-2: canonical-append-before-unlink crash recovery
   315	            # produces mostly `skipped_idempotent` (the entries are already
   316	            # in the canonical log; next drain reads same bytes from
   317	            # .draining, sees them in K_TAIL_WINDOW, skips). Sum both
   318	            # counters so AC10 reports actual recovery count, not just the
   319	            # rare appended-on-recovery subset.
   320	            rec.recovered += recov.appended + recov.skipped_idempotent
   321	            # iter3-P2-1: surface intentionally_deleted (duplicate-tuple
   322	            # rejections during recovery) into the reconciliation counter
   323	            # so the audit_flush_dropped_count emit carries it.
   324	            rec.intentionally_deleted += recov.intentionally_deleted
   325	
   326	    _forensic("audit_flush_dropped_count", _journal_rec_dict(rec))
   327	    return rec
   328	
   329	
   330	def _journal_rec_dict(rec: JournalReconciliation) -> Dict[str, Any]:
   331	    return {
   332	        "begin_no_commit": rec.begin_no_commit,
   333	        "commit_no_drained": rec.commit_no_drained,
   334	        "recovered": rec.recovered,
   335	        "truly_lost": rec.truly_lost,
   336	        "tamper_rejected": rec.tamper_rejected,
   337	        "intentionally_deleted": rec.intentionally_deleted,
   338	    }
