    92	        pid = os.getpid()
    93	        p = _spool_path(pid)
    94	        if not p.exists():
    95	            return False
    96	        st = p.stat()
    97	        if st.st_size == 0:
    98	            return False
    99	        # Staleness trigger first (cheap)
   100	        age_ms = (time.time() - st.st_mtime) * 1000.0
   101	        if age_ms > DRAIN_TRIGGER_MTIME_MS:
   102	            return True
   103	        # P2-1: honest newline count, capped at DRAIN_TRIGGER_SIZE + 2
   104	        # (1 for header + 1 to early-exit once we cross the threshold).
   105	        cap = DRAIN_TRIGGER_SIZE + 2
   106	        count = 0
   107	        try:
   108	            with p.open("rb") as f:
   109	                while count < cap:
   110	                    chunk = f.read(8192)
   111	                    if not chunk:
   112	                        break
   113	                    count += chunk.count(b"\n")
   114	                    if count >= cap:
   115	                        break
   116	        except OSError:
   117	            return False
   118	        # Body lines = count - 1 (header is line 1). Trigger when
   119	        # body_lines >= DRAIN_TRIGGER_SIZE → count >= DRAIN_TRIGGER_SIZE+1.
   120	        return count >= (DRAIN_TRIGGER_SIZE + 1)
   121	    except Exception:
   122	        return False
