   300	def _flush_journal_buffer(pid: int) -> None:
   301	    """Flush buffered journal envelopes for PID with a single fsync.
   302	
   303	    P1-2: invoked at drain boundary, signal handler, atexit, or when
   304	    buffer hits _JOURNAL_FLUSH_EVERY. Best-effort fail-open. Acquires
   305	    the per-PID journal flock around the append+fsync window.
