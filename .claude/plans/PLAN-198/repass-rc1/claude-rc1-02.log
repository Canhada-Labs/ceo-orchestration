_judge_hijack_suspected\",\n366\t    \"tournament_run_completed\",\n367\t    \"tournament_run_started\",\n368\t    \"tournament_task_scored\",\n369\t    \"trading_kill_switch_disabled\",\n370\t    \"trading_kill_switch_invoked\",\n371\t    \"trading_write_override_used\",\n372\t    \"value_dashboard_summarized\",\n373\t    \"verify_after_edit_finding\",\n374\t    \"veto_triggered\",\n375\t    \"wave_artifact_written\",\n376\t    \"wave_readonly_violation\",\n377\t}\n378\t\n379\tEVENT_SCHEMA_V2 = \"v2\"\n380\t\n381\t\n382\tdef iter_events(*args: Any, **kwargs: Any) -> Any:\n383\t    return _streaming.iter_events(*args, **kwargs)\n384\t\n385\t\n386\tdef emit_credential_rotation_due(\n387\t    provider: str,\n388\t    age_days: int,\n389\t    warn_threshold_days: int = 75,\n390\t    max_threshold_days: int = 90,\n391\t    session_id: str = \"\",\n392\t    project: str = \"\",\n393\t) -> None:\n394\t    \"\"\"Emit a credential_rotation_due event (ADR-040 §4).\n395\t\n396\t    Fired on every live call once the active API key is older than\n397\t    ``warn_threshold_days`` (default 75). The event does not block the\n398\t    call — it surfaces in the dashboard so the operator rotates before\n399\t    the 90-day hard cap. Credential value is NEVER in any field.\n400\t    \"\"\"\n401\t    event: Dict[str, Any] = {\n402\t        \"action\": \"credential_rotation_due\",\n403\t        \"provider\": provider,\n404\t        \"age_days\": int(age_days),\n405\t        \"warn_threshold_days\": int(warn_threshold_days),\n406\t        \"max_threshold_days\": int(max_threshold_days),\n407\t        \"session_id\": session_id,\n408\t        \"project\": project,\n409\t    }\n410\t    _write_event(event)\n411\t\n412\t\n413\tfrom _lib._audit_emit_parts import install as _install_parts\n414\t\n415\t_install_parts(\n416\t    globals(),\n417\t    (\n418\t        \"writer\",\n419\t        \"streaming\",\n420\t        \"boot_schemas\",\n421\t        \"optimizer\",\n422\t        \"federation_sc