{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BFnKfVDsxRZ2PFca1tcu6R","type":"tool_result","content":"1\t\"\"\"Audit persistence helpers bound into the audit_emit facade.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\t__all__ = (\n6\t    \"_FALLBACK_NOTIFIED\",\n7\t    \"_fallback_log_path\",\n8\t    \"_emit_fallback_banner_once\",\n9\t    \"_write_fallback\",\n10\t    \"_safe_target_ref_hash_field\",\n11\t    \"_accel_clamp_count\",\n12\t    \"_auto_compact_clamp_pct\",\n13\t    \"_e3_clamp01\",\n14\t    \"_e3_safe_path_hashes\",\n15\t    \"_safe_token_sha_field\",\n16\t    \"_federation_safe_path_hash\",\n17\t    \"_audit_dir\",\n18\t    \"_log_path\",\n19\t    \"_log_family_dir\",\n20\t    \"_lock_path\",\n21\t    \"_errors_path\",\n22\t    \"_utc_now_iso\",\n23\t    \"_breadcrumb\",\n24\t    \"_DEFAULT_ROTATE_AT_BYTES\",\n25\t    \"_rotate_threshold\",\n26\t    \"_now_month_slug\",\n27\t    \"_rotate_if_needed_safe\",\n28\t    \"_VALID_ROTATION_TRIGGERS\",\n29\t    \"_normalize_rotation_trigger\",\n30\t    \"_emit_chain_reset_marker_under_lock\",\n31\t    \"_write_event\",\n32\t    \"_preview\",\n33\t)\n34\t\n35\t_FALLBACK_NOTIFIED = False\n36\t\n37\t\n38\tdef _fallback_log_path() -> Path:\n39\t    \"\"\"Return the /tmp fallback audit path, user-scoped.\n40\t\n41\t    Env override: ``CEO_AUDIT_LOG_FALLBACK_PATH`` for tests.\n42\t    \"\"\"\n43\t    override = os.environ.get(\"CEO_AUDIT_LOG_FALLBACK_PATH\")\n44\t    if override:\n45\t        return Path(override)\n46\t    try:\n47\t        user = getpass.getuser() or \"unknown\"\n48\t    except Exception:  # pragma: no cover\n49\t        user = os.environ.get(\"USER\") or \"unknown\"\n50\t    user = \"\".join(c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\"))\n51\t    return Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n52\t\n53\t\n54\tdef _emit_fallback_banner_once(primary: Path, fallback: Path, err: str) -> None:\n55\t    \"\"\"Emit `::warning::` stderr banner once per session (F-CHAOS-1).\"\"\"\n56\t    global _FALLBACK_NOTIFIED\n57\t    if _FALLBACK_NOTIFIED:\n58\t        return\n59\t    _FALLBACK_NOTIFIED = True\n60\t    try:\n61\t        sys.stderr.write(\n62\t            f\"::warning::audit-log write failed ({err}); \"\n63\t            f\"falling back to {fallback}. \"\n64\t            f\"Investigate writability of {primary.parent}.\\n\"\n65\t        )\n66\t        sys.stderr.flush()\n67\t    except Exception:  # pragma: no cover\n68\t        pass\n69\t\n70\t\n71\tdef _write_fallback(event_line: str) -> bool:\n72\t    \"\"\"Append ``event_line`` to fallback path with 0o600. Never raises.\"\"\"\n73\t    try:\n74\t        fallback = _fallback_log_path()\n75\t        fallback.parent.mkdir(parents=True, exist_ok=True)\n76\t        with fallback.open(\"a\", encoding=\"utf-8\") as f:\n77\t            f.write(event_line)\n78\t            # PLAN-025 F-obs-002 — durability on fallback path too; if the\n79\t            # primary failed and we're writing fallback, crash-safety matters\n80\t            # MORE than on the happy path."}]},"parent_tool_use_id":null,"session_id":"2e57f479-9c5a-4eb5-b16f-bf776385516b","uuid":"5123872a-c69c-4c6b-8443-4d19a589f012","timestamp":"2026-11-13T16:21:36.802Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/writer.py","content":"\"\"\"Audit persistence helpers bound into the audit_emit facade.\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = (\n    \"_FALLBACK_NOTIFIED\",\n    \"_fallback_log_path\",\n    \"_emit_fallback_banner_once\",\n    \"_write_fallback\",\n    \"_safe_target_ref_hash_field\",\n    \"_accel_clamp_count\",\n    \"_auto_compact_clamp_pct\",\n    \"_e3_clamp01\",\n    \"_e3_safe_path_hashes\",\n    \"_safe_token_sha_field\",\n    \"_federation_safe_path_hash\",\n    \"_audit_dir\",\n    \"_log_path\",\n    \"_log_family_dir\",\n    \"_lock_path\",\n    \"_errors_path\",\n    \"_utc_now_iso\",\n    \"_breadcrumb\",\n    \"_DEFAULT_ROTATE_AT_BYTES\",\n    \"_rotate_threshold\",\n    \"_now_month_slug\",\n    \"_rotate_if_needed_safe\",\n    \"_VALID_ROTATION_TRIGGERS\",\n    \"_normalize_rotation_trigger\",\n    \"_emit_chain_reset_marker_under_lock\",\n    \"_write_event\",\n    \"_preview\",\n)\n\n_FALLBACK_NOTIFIED = False\n\n\ndef _fallback_log_path() -> Path:\n    \"\"\"Return the /tmp fallback audit path, user-scoped.\n\n    Env override: ``CEO_AUDIT_LOG_FALLBACK_PATH`` for tests.\n    \"\"\"\n    override = os.environ.get(\"CEO_AUDIT_LOG_FALLBACK_PATH\")\n    if override:\n        return Path(override)\n    try:\n        user = getpass.getuser() or \"unknown\"\n    except Exception:  # pragma: no cover\n        user = os.environ.get(\"USER\") or \"unknown\"\n    user = \"\".join(c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\"))\n    return Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n\n\ndef _emit_fallback_banner_once(primary: Path, fallback: Path, err: str) -> None:\n    \"\"\"Emit `::warning::` stderr banner once per session (F-CHAOS-1).\"\"\"\n    global _FALLBACK_NOTIFIED\n    if _FALLBACK_NOTIFIED:\n        return\n    _FALLBACK_NOTIFIED = True\n    try:\n        sys.stderr.write(\n            f\"::warning::audit-log write failed ({err}); \"\n            f\"falling back to {fallback}. \"\n            f\"Investigate writability of {primary.parent}.\\n\"\n        )\n        sys.stderr.flush()\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _write_fallback(event_line: str) -> bool:\n    \"\"\"Append ``event_line`` to fallback path with 0o600. Never raises.\"\"\"\n    try:\n        fallback = _fallback_log_path()\n        fallback.parent.mkdir(parents=True, exist_ok=True)\n        with fallback.open(\"a\", encoding=\"utf-8\") as f:\n            f.write(event_line)\n            # PLAN-025 F-obs-002 — durability on fallback path too; if the\n            # primary failed and we're writing fallback, crash-safety matters\n            # MORE than on the happy path.","numLines":80,"startLine":1,"totalLines":783}},"tool_result_meta":[{"id":"toolu_01BFnKfVDsxRZ2PFca1tcu6R","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
