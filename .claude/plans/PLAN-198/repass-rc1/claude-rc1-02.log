{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SEf8bcQM5hpGkMtMxAAMkK","type":"tool_result","content":"1\t\"\"\"Regressions for the audit-emitter facade's dynamic lookup contract.\n2\t\n3\tProducers import ``_lib.audit_emit`` and tests patch names on that module.\n4\tExtracted emitters must resolve those names at call time, just as functions\n5\tdefined in the original monolithic module did.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\timport sys\n11\tfrom pathlib import Path\n12\t\n13\tfrom _subprocess_helpers import run_in_process_group\n14\tfrom _lib import audit_emit\n15\t\n16\t\n17\tdef test_extracted_emitter_uses_facade_write_event(monkeypatch):\n18\t    \"\"\"The captured payload must reach the patched facade writer.\"\"\"\n19\t    written = []\n20\t    monkeypatch.setattr(audit_emit, \"_write_event\", written.append)\n21\t\n22\t    audit_emit.emit_debate_event(\n23\t        plan_id=\"PLAN-FACADE\",\n24\t        round_num=2,\n25\t        phase=\"agent-done\",\n26\t        agent=\"test-agent\",\n27\t    )\n28\t\n29\t    assert len(written) == 1\n30\t    assert written[0][\"action\"] == \"debate_event\"\n31\t    assert written[0][\"plan_id\"] == \"PLAN-FACADE\"\n32\t    assert written[0][\"round\"] == 2\n33\t\n34\t\n35\tdef test_extracted_emitter_uses_facade_generic_dispatch(monkeypatch):\n36\t    \"\"\"Typed wrappers must dispatch through the replaceable generic emitter.\"\"\"\n37\t    calls = []\n38\t\n39\t    def record(action, **fields):\n40\t        calls.append((action, fields))\n41\t\n42\t    monkeypatch.setattr(audit_emit, \"emit_generic\", record)\n43\t    audit_emit.emit_mcp_injection_finding(\n44\t        server_id=\"server-a\",\n45\t        mcp_tool_name=\"lookup\",\n46\t        source_kind=\"tool_result\",\n47\t        family_counts={\"role_preamble\": 1},\n48\t        match_count=1,\n49\t        bytes_scanned=42,\n50\t        severity=\"high\",\n51\t        snippet_preview=\"synthetic probe\",\n52\t    )\n53\t\n54\t    assert len(calls) == 1\n55\t    action, fields = calls[0]\n56\t    assert action == \"mcp_injection_finding\"\n57\t    assert fields[\"server_id\"] == \"server-a\"\n58\t    assert fields[\"family_counts\"] == {\"role_preamble\": 1}\n59\t    assert fields[\"bytes_scanned\"] == 42\n60\t\n61\t\n62\tdef test_extracted_emitter_uses_facade_private_helper(monkeypatch):\n63\t    \"\"\"Private helper substitution must change the emitted payload.\"\"\"\n64\t    written = []\n65\t    monkeypatch.setattr(audit_emit, \"_write_event\", written.append)\n66\t    monkeypatch.setattr(audit_emit, \"_preview\", lambda text: \"preview-from-facade\")\n67\t\n68\t    audit_emit.emit_veto_triggered(\n69\t        hook=\"check_bash_safety\",\n70\t        reason_code=\"synthetic_probe\",\n71\t        reason_preview=\"raw text\",\n72\t    )\n73\t\n74\t    assert len(written) == 1\n75\t    assert written[0][\"action\"] == \"veto_triggered\"\n76\t    assert written[0][\"reason_preview\"] == \"preview-from-facade\"\n77\t\n78\t\n79\tdef test_reload_keeps_extracted_emitters_bound_to_current_facade():\n80\t    \"\"\"Reload in a child process, avoiding module-global mutation in pytest.\"\"\"\n81\t    hooks_dir = Path(__file__).resolve().parents[1]\n82\t    script = \"\"\"\n83\timport importlib\n84\timport sys\n85\tsys.path.insert(0, sys.argv[1])\n86\tfrom _lib import audit_emit\n87\taudit_emit._KNOWN_ACTIONS.add('synthetic_facade_action')\n88\taudit_emit._PLAN088_RATE_STATE['synthetic_facade_action'] = (1.0, 5, 2)\n89\timportlib.reload(audit_emit)\n90\tassert 'synthetic_facade_action' not in audit_emit._KNOWN_ACTIONS\n91\tassert audit_emit._PLAN088_RATE_STATE == {}\n92\twritten = []\n93\taudit_emit._write_event = written.append\n94\taudit_emit.emit_plan_transition(\n95\t    plan_id='PLAN-FACADE', from_status='draft', to_status='reviewed',\n96\t    file_path='plans/PLAN-FACADE.md')\n97\tassert len(written) == 1, written\n98\tassert written[0]['action'] == 'plan_transition'\n99\tassert written[0]['file_path'] == 'plans/PLAN-FACADE.md'\n100\t\"\"\"\n101\t    result = run_in_process_group(\n102\t        [sys.executable, \"-c\", script, str(hooks_dir)],\n103\t        capture_output=True,\n104\t        text=True,\n105\t        timeout=15,\n106\t        check=False,\n107\t    )\n108\t    assert result.returncode == 0, result.stderr\n109\t"}]},"parent_tool_use_id":null,"session_id":"6578c450-61c9-4189-b7af-966fbe2564f1","uuid":"85534f00-0d25-46d4-8181-5979212aa56f","timestamp":"2026-11-15T09:08:41.452Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/tests/test_audit_emit_modular_facade.py","content":"\"\"\"Regressions for the audit-emitter facade's dynamic lookup contract.\n\nProducers import ``_lib.audit_emit`` and tests patch names on that module.\nExtracted emitters must resolve those names at call time, just as functions\ndefined in the original monolithic module did.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nfrom _subprocess_helpers import run_in_process_group\nfrom _lib import audit_emit\n\n\ndef test_extracted_emitter_uses_facade_write_event(monkeypatch):\n    \"\"\"The captured payload must reach the patched facade writer.\"\"\"\n    written = []\n    monkeypatch.setattr(audit_emit, \"_write_event\", written.append)\n\n    audit_emit.emit_debate_event(\n        plan_id=\"PLAN-FACADE\",\n        round_num=2,\n        phase=\"agent-done\",\n        agent=\"test-agent\",\n    )\n\n    assert len(written) == 1\n    assert written[0][\"action\"] == \"debate_event\"\n    assert written[0][\"plan_id\"] == \"PLAN-FACADE\"\n    assert written[0][\"round\"] == 2\n\n\ndef test_extracted_emitter_uses_facade_generic_dispatch(monkeypatch):\n    \"\"\"Typed wrappers must dispatch through the replaceable generic emitter.\"\"\"\n    calls = []\n\n    def record(action, **fields):\n        calls.append((action, fields))\n\n    monkeypatch.setattr(audit_emit, \"emit_generic\", record)\n    audit_emit.emit_mcp_injection_finding(\n        server_id=\"server-a\",\n        mcp_tool_name=\"lookup\",\n        source_kind=\"tool_result\",\n        family_counts={\"role_preamble\": 1},\n        match_count=1,\n        bytes_scanned=42,\n        severity=\"high\",\n        snippet_preview=\"synthetic probe\",\n    )\n\n    assert len(calls) == 1\n    action, fields = calls[0]\n    assert action == \"mcp_injection_finding\"\n    assert fields[\"server_id\"] == \"server-a\"\n    assert fields[\"family_counts\"] == {\"role_preamble\": 1}\n    assert fields[\"bytes_scanned\"] == 42\n\n\ndef test_extracted_emitter_uses_facade_private_helper(monkeypatch):\n    \"\"\"Private helper substitution must change the emitted payload.\"\"\"\n    written = []\n    monkeypatch.setattr(audit_emit, \"_write_event\", written.append)\n    monkeypatch.setattr(audit_emit, \"_preview\", lambda text: \"preview-from-facade\")\n\n    audit_emit.emit_veto_triggered(\n        hook=\"check_bash_safety\",\n        reason_code=\"synthetic_probe\",\n        reason_preview=\"raw text\",\n    )\n\n    assert len(written) == 1\n    assert written[0][\"action\"] == \"veto_triggered\"\n    assert written[0][\"reason_preview\"] == \"preview-from-facade\"\n\n\ndef test_reload_keeps_extracted_emitters_bound_to_current_facade():\n    \"\"\"Reload in a child process, avoiding module-global mutation in pytest.\"\"\"\n    hooks_dir = Path(__file__).resolve().parents[1]\n    script = \"\"\"\nimport importlib\nimport sys\nsys.path.insert(0, sys.argv[1])\nfrom _lib import audit_emit\naudit_emit._KNOWN_ACTIONS.add('synthetic_facade_action')\naudit_emit._PLAN088_RATE_STATE['synthetic_facade_action'] = (1.0, 5, 2)\nimportlib.reload(audit_emit)\nassert 'synthetic_facade_action' not in audit_emit._KNOWN_ACTIONS\nassert audit_emit._PLAN088_RATE_STATE == {}\nwritten = []\naudit_emit._write_event = written.append\naudit_emit.emit_plan_transition(\n    plan_id='PLAN-FACADE', from_status='draft', to_status='reviewed',\n    file_path='plans/PLAN-FACADE.md')\nassert len(written) == 1, written\nassert written[0]['action'] == 'plan_transition'\nassert written[0]['file_path'] == 'plans/PLAN-FACADE.md'\n\"\"\"\n    result = run_in_process_group(\n        [sys.executable, \"-c\", script, str(hooks_dir)],\n        capture_output=True,\n        text=True,\n        timeout=15,\n        check=False,\n    )\n    assert result.returncode == 0, result.stderr\n","numLines":109,"startLine":1,"totalLines":109}},"tool_result_meta":[{"id":"toolu_01SEf8bcQM5hpGkMtMxAAMkK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
