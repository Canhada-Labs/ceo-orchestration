-def _merge_task_desc_keywords(keywords, task_desc: str) -> List[str]:
-    """Extract ≥4-char words from task_desc; dedupe into keywords list."""
-    if not task_desc:
-        return keywords
-    import re as _re
-    extra = [
-        w.lower() for w in _re.findall(r"[A-Za-z][A-Za-z0-9_]*", task_desc)
-        if len(w) >= 4
-    ]
-    seen = set(keywords)
-    for w in extra:
-        if w not in seen:
-            keywords.append(w)
-            seen.add(w)
-    return keywords
