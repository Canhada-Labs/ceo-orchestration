+    run(["git", "checkout", "main"])
+    run(["git", "pull", "--ff-only", "origin", "main"])
+    previous = current_head()
+    run(["git", "merge", "--no-ff", "-S", "origin/" + TRACK, "-m",
+         "Merge pull request #7 from Canhada-Labs/" + TRACK])
