{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01R1kKdhdywpZrbcRnge3mZ5","type":"tool_result","content":"920\t\n921\t\n922\tdef check_root_instruction_load(\n923\t    repo_root: Path, evidence_path: Optional[Path] = None,\n924\t) -> Finding:\n925\t    \"\"\"Report a real runtime lookup, with explicit evidence provenance.\n926\t\n927\t    ``evidence_path`` is an operator-supplied JSON snapshot shaped as\n928\t    ``{\"complete\": true, \"loaded_instruction_paths\": [absolute paths...]}``.\n929\t    A partial, malformed or unavailable snapshot cannot prove root absence.\n930\t    The caller supplies the list; this gate does not claim to instrument\n931\t    Claude Code's instruction loader or authenticate the snapshot's producer.\n932\t    \"\"\"\n933\t    try:\n934\t        from _lib import claude_md_excludes as excludes\n935\t    except Exception:\n936\t        return _warn(\"root_instruction_load\", \"runtime\", \"root_load_unobservable (classifier unavailable)\")\n937\t\n938\t    paths = None\n939\t    source = \"no complete observed path list\"\n940\t    if evidence_path is not None:\n941\t        try:\n942\t            snapshot = json.loads(\n943\t                evidence_path.read_text(encoding=\"utf-8\"),\n944\t                object_pairs_hook=_strict_pairs,\n945\t                parse_constant=_refuse_constant,\n946\t            )\n947\t            if isinstance(snapshot, dict) and snapshot.get(\"complete\") is True:\n948\t                paths = snapshot.get(\"loaded_instruction_paths\")\n949\t                source = \"operator-supplied snapshot; completeness unverified\"\n950\t            else:\n951\t                source = \"incomplete or malformed path list\"\n952\t        except (OSError, ValueError, RecursionError):\n953\t            source = \"unreadable or invalid path list\"\n954\t    try:\n955\t        state = excludes.root_instruction_load_state(paths, repo_root)\n956\t    except Exception:\n957\t        state = excludes.LOAD_STATE_UNOBSERVABLE\n958\t        source = \"classifier unavailable\"\n959\t    if state in (excludes.LOAD_STATE_LOADED, excludes.LOAD_STATE_ABSENT):\n960\t        state = f\"snapshot reports {state}\"\n961\t    return _warn(\"root_instruction_load\", \"runtime\", f\"{state} ({source})\")\n962\t\n963\t\n964\tdef main(argv: Optional[List[str]] = None) -> int:\n965\t    parser = argparse.ArgumentParser(\n966\t        prog=\"check_harness_config.py\",\n967\t        description=\"Harness-config gate: runtime-resolution model, \"\n968\t        \"inline-secret scan, deny baseline, no-op annotation, and \"\n969\t        \"behavioral positive-control replay (PLAN-153 Wave E / ADR-173).\",\n970\t    )\n971\t    parser.add_argument(\"--repo-root\", type=Path, default=None)\n972\t    parser.add_argument(\n973\t        \"--settings\",\n974\t        action=\"append\",\n975\t        type=Path,\n976\t        default=None,\n977\t        help=\"settings file(s) to scan (default: dogfood + template)\",\n978\t    )\n979\t    parser.add_argument(\"--fixtures-dir\", type=Path, default=None)"}]},"parent_tool_use_id":null,"session_id":"6c392eab-1f45-41b4-827f-fcae27112528","uuid":"cd5a76df-43fc-4f04-bae2-7a3fa63ea1c5","timestamp":"2026-11-15T10:37:13.986Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_harness_config.py","content":"\n\ndef check_root_instruction_load(\n    repo_root: Path, evidence_path: Optional[Path] = None,\n) -> Finding:\n    \"\"\"Report a real runtime lookup, with explicit evidence provenance.\n\n    ``evidence_path`` is an operator-supplied JSON snapshot shaped as\n    ``{\"complete\": true, \"loaded_instruction_paths\": [absolute paths...]}``.\n    A partial, malformed or unavailable snapshot cannot prove root absence.\n    The caller supplies the list; this gate does not claim to instrument\n    Claude Code's instruction loader or authenticate the snapshot's producer.\n    \"\"\"\n    try:\n        from _lib import claude_md_excludes as excludes\n    except Exception:\n        return _warn(\"root_instruction_load\", \"runtime\", \"root_load_unobservable (classifier unavailable)\")\n\n    paths = None\n    source = \"no complete observed path list\"\n    if evidence_path is not None:\n        try:\n            snapshot = json.loads(\n                evidence_path.read_text(encoding=\"utf-8\"),\n                object_pairs_hook=_strict_pairs,\n                parse_constant=_refuse_constant,\n            )\n            if isinstance(snapshot, dict) and snapshot.get(\"complete\") is True:\n                paths = snapshot.get(\"loaded_instruction_paths\")\n                source = \"operator-supplied snapshot; completeness unverified\"\n            else:\n                source = \"incomplete or malformed path list\"\n        except (OSError, ValueError, RecursionError):\n            source = \"unreadable or invalid path list\"\n    try:\n        state = excludes.root_instruction_load_state(paths, repo_root)\n    except Exception:\n        state = excludes.LOAD_STATE_UNOBSERVABLE\n        source = \"classifier unavailable\"\n    if state in (excludes.LOAD_STATE_LOADED, excludes.LOAD_STATE_ABSENT):\n        state = f\"snapshot reports {state}\"\n    return _warn(\"root_instruction_load\", \"runtime\", f\"{state} ({source})\")\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = argparse.ArgumentParser(\n        prog=\"check_harness_config.py\",\n        description=\"Harness-config gate: runtime-resolution model, \"\n        \"inline-secret scan, deny baseline, no-op annotation, and \"\n        \"behavioral positive-control replay (PLAN-153 Wave E / ADR-173).\",\n    )\n    parser.add_argument(\"--repo-root\", type=Path, default=None)\n    parser.add_argument(\n        \"--settings\",\n        action=\"append\",\n        type=Path,\n        default=None,\n        help=\"settings file(s) to scan (default: dogfood + template)\",\n    )\n    parser.add_argument(\"--fixtures-dir\", type=Path, default=None)","numLines":60,"startLine":920,"totalLines":1048}},"tool_result_meta":[{"id":"toolu_01R1kKdhdywpZrbcRnge3mZ5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
