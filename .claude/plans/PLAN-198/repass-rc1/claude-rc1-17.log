        rows: Sequence[Dict[str, object]]) -> Dict[str, List[str]]:\n231\t    \"\"\"Which registered hook sources reference each surface.\n232\t\n233\t    Rule (over-approximating, stated in the doc): a hook guards a surface iff\n234\t    its source (including bound parts) under .claude/hooks/ contains '.claude/skills' or\n235\t    'SKILL.md' (skill surface) / '.claude/commands' (command surface).\"\"\"\n236\t    guards: Dict[str, List[str]] = {\"skills\": [], \"commands\": [], \"unresolved\": []}\n237\t    for label in sorted({str(r[\"hook\"]) for r in rows}):\n238\t        if label == \"(inline)\":\n239\t            continue\n240\t        src = repo / \".claude/hooks\" / label\n241\t        if not src.is_file():\n242\t            guards[\"unresolved\"].append(label)\n243\t            continue\n244\t        text = _hook_declaration_sources(repo, src)\n245\t        if \".claude/skills\" in text or \"SKILL.md\" in text:\n246\t            guards[\"skills\"].append(label)\n247\t        if \".claude/commands\" in text:\n248\t            guards[\"commands\"].append(label)\n249\t    return guards\n250\t\n251\t\n252\t# --------------------------------------------------------------------------\n253\t# Markdown assembly (deterministic — no timestamps)\n254\t# --------------------------------------------------------------------------"}]},"parent_tool_use_id":null,"session_id":"db09679d-5189-4158-a1d6-4bf6064c9841","uuid":"61021e27-e2d3-431a-bdfd-21861c746e25","timestamp":"2026-11-13T17:47:13.310Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/gen-command-skill-hook-map.py","content":"def _hook_declaration_sources(repo: Path, source: Path) -> str:\n    \"\"\"Include private declarations explicitly bound to this facade's globals.\n\n    Read AST only: importing a hook can register signal handlers or emit events.\n    Unused imports and ordinary dependencies do not constitute bound declarations.\n    \"\"\"\n    text = source.read_text(encoding=\"utf-8\")\n    if source.suffix != \".py\":\n        return text\n    tree = ast.parse(text, filename=str(source))\n    binders = {}\n    for node in ast.walk(tree):\n        if isinstance(node, ast.ImportFrom) and (node.module or \"\").startswith(\"_lib.\"):\n            for alias in node.names:\n                if alias.name in (\"bind\", \"install\"):\n                    binders[alias.asname or alias.name] = node.module\n    packages = set()\n    for node in ast.walk(tree):\n        if not isinstance(node, ast.Call) or not isinstance(node.func, ast.Name):\n            continue\n        if node.func.id not in binders or not node.args:\n            continue\n        namespace = node.args[0]\n        if isinstance(namespace, ast.Call) and isinstance(namespace.func, ast.Name) and namespace.func.id == \"globals\":\n            packages.add(binders[node.func.id])\n    sources = [text]\n    for package in sorted(packages):\n        directory = repo / \".claude/hooks\" / Path(*package.split(\".\"))\n        if not directory.is_dir():\n            raise FileNotFoundError(\"Missing bound hook declarations: %s\" % directory)\n        sources.extend(path.read_text(encoding=\"utf-8\") for path in sorted(directory.glob(\"*.py\")))\n    return \"\\n\".join(sources)\n\n\ndef surface_guards(repo: Path,\n                   rows: Sequence[Dict[str, object]]) -> Dict[str, List[str]]:\n    \"\"\"Which registered hook sources reference each surface.\n\n    Rule (over-approximating, stated in the doc): a hook guards a surface iff\n    its source (including bound parts) under .claude/hooks/ contains '.claude/skills' or\n    'SKILL.md' (skill surface) / '.claude/commands' (command surface).\"\"\"\n    guards: Dict[str, List[str]] = {\"skills\": [], \"commands\": [], \"unresolved\": []}\n    for label in sorted({str(r[\"hook\"]) for r in rows}):\n        if label == \"(inline)\":\n            continue\n        src = repo / \".claude/hooks\" / label\n        if not src.is_file():\n            guards[\"unresolved\"].append(label)\n            continue\n        text = _hook_declaration_sources(repo, src)\n        if \".claude/skills\" in text or \"SKILL.md\" in text:\n            guards[\"skills\"].append(label)\n        if \".claude/commands\" in text:\n            guards[\"commands\"].append(label)\n    return guards\n\n\n# --------------------------------------------------------------------------\n# Markdown assembly (deterministic — no timestamps)\n# --------------------------------------------------------------------------","numLines":60,"startLine":195,"totalLines":474}},"tool_result_meta":[{"id":"toolu_01DkqBYpLjDFkXEQm3sfsZv5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
