{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C6cqNebdjhMbJaaFkZvtbi","type":"tool_result","content":"876\tdef get_model_allowlist(project_dir: Optional[_PathLike] = None) -> List[str]:\n877\t    \"\"\"Parse the ADR-149 model-id allowlist from the live repo at runtime.\n878\t\n879\t    Root resolution: explicit ``project_dir`` arg, else ``CLAUDE_PROJECT_DIR``\n880\t    env, else this module's checkout root (``parents[3]``). Reads\n881\t    ``.claude/adr/ADR-149-model-id-allowlist.md`` and extracts the\n882\t    ``frozenset({...})`` members (single source — never a hardcoded mirror).\n883\t\n884\t    Fail-open: missing/unreadable/unparseable ADR → ``[]``; callers MUST\n885\t    treat an empty list as \"membership unknown\" (skip membership checks),\n886\t    never as \"everything forbidden\".\n887\t    \"\"\"\n888\t    try:\n889\t        root = _resolve_repo_root(project_dir)\n890\t        adr_path = root / \".claude\" / \"adr\" / \"ADR-149-model-id-allowlist.md\"\n891\t        if not adr_path.is_file():\n892\t            return []\n893\t        return _parse_allowlist_members(\n894\t            adr_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n895\t        )\n896\t    except Exception as exc:\n897\t        _breadcrumb(f\"get_model_allowlist degraded fail-open: {type(exc).__name__}\")\n898\t        return []\n899\t"}]},"parent_tool_use_id":null,"session_id":"6c392eab-1f45-41b4-827f-fcae27112528","uuid":"498dd12b-653d-4f82-a98e-eabf14e075f2","timestamp":"2026-11-15T10:36:34.381Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/effective_config.py","content":"def get_model_allowlist(project_dir: Optional[_PathLike] = None) -> List[str]:\n    \"\"\"Parse the ADR-149 model-id allowlist from the live repo at runtime.\n\n    Root resolution: explicit ``project_dir`` arg, else ``CLAUDE_PROJECT_DIR``\n    env, else this module's checkout root (``parents[3]``). Reads\n    ``.claude/adr/ADR-149-model-id-allowlist.md`` and extracts the\n    ``frozenset({...})`` members (single source — never a hardcoded mirror).\n\n    Fail-open: missing/unreadable/unparseable ADR → ``[]``; callers MUST\n    treat an empty list as \"membership unknown\" (skip membership checks),\n    never as \"everything forbidden\".\n    \"\"\"\n    try:\n        root = _resolve_repo_root(project_dir)\n        adr_path = root / \".claude\" / \"adr\" / \"ADR-149-model-id-allowlist.md\"\n        if not adr_path.is_file():\n            return []\n        return _parse_allowlist_members(\n            adr_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n        )\n    except Exception as exc:\n        _breadcrumb(f\"get_model_allowlist degraded fail-open: {type(exc).__name__}\")\n        return []\n","numLines":24,"startLine":876,"totalLines":899}},"tool_result_meta":[{"id":"toolu_01C6cqNebdjhMbJaaFkZvtbi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
