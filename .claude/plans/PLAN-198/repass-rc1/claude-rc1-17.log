{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01U7oCZjJdwhE1HvczQGGcrp","type":"tool_result","content":"690\t            ))\n691\t    except Exception:\n692\t        _breadcrumb(\"codex killswitch census degraded fail-open\")\n693\t        return\n694\t\n695\t\n696\tdef _resolve_repo_root(project_dir: Optional[_PathLike]) -> Path:\n697\t    if project_dir:\n698\t        return Path(_safe_str(project_dir))\n699\t    env_root = os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\").strip()\n700\t    if env_root:\n701\t        return Path(env_root)\n702\t    # <root>/.claude/hooks/_lib/effective_config.py → parents[3] = <root>\n703\t    return Path(__file__).resolve().parents[3]\n704\t\n705\t\n706\tdef _parse_allowlist_members(text: str) -> List[str]:\n707\t    \"\"\"Extract model ids from ADR-149, robustly.\n708\t\n709\t    Prefer the working-set tuple, then the legacy floor block.\n710\t    Quoted model IDs are order-preserving and de-duplicated.\n711\t    \"\"\"\n712\t    match = _WORKING_SET_RE.search(text) or _FROZENSET_RE.search(text)\n713\t    chunk = match.group(1) if match else text\n714\t    members = _MODEL_ID_DQ_RE.findall(chunk) + _MODEL_ID_SQ_RE.findall(chunk)\n715\t    if not members and match:\n716\t        members = _MODEL_ID_DQ_RE.findall(text) + _MODEL_ID_SQ_RE.findall(text)\n717\t    out: List[str] = []\n718\t    for member in members:\n719\t        if (\n720\t            member.startswith(\"claude-\")\n721\t            or _model_currency.is_allowed_model(member, ())\n722\t        ) and member not in out:\n723\t            out.append(member)\n724\t    return out\n725\t\n726\t\n727\t# ---------------------------------------------------------------------------\n728\t# Public API\n729\t# ---------------------------------------------------------------------------\n730\t\n731\tdef resolve_settings(project_dir: _PathLike) -> Dict[str, Any]:\n732\t    \"\"\"Resolve the layered Claude Code settings for ``project_dir``.\n733\t\n734\t    Returns (always — never raises)::\n735\t\n736\t        {\n737\t          \"project_dir\": str,\n738\t          \"layers\": [  # in LAYER_MERGE_ORDER: user, project, local, managed\n739\t            {\"name\": str, \"path\": str, \"exists\": bool, \"ok\": bool,\n740\t             \"data\": dict, \"error\": Optional[str]},\n741\t            ...\n742\t          ],\n743\t          \"effective\": dict,   # top-level-key merge, highest precedence wins\n744\t          \"sources\": {top_level_key: layer_name},\n745\t          \"ok\": bool,          # False iff any present layer failed to parse\n746\t          \"errors\": [str],     # one entry per failed layer\n747\t        }\n748\t\n749\t    A missing layer file is NOT an error (exists=False, ok=True, data={}).\n750\t    A corrupt layer degrades to data={} + ok=False + error, and the merge\n751\t    proceeds over the healthy layers (fail-open).\n752\t    \"\"\"\n753\t    try:\n754\t        pdir = Path(_safe_str(project_dir))\n755\t        layers = [_read_json_layer(name, path) for name, path in _layer_paths(pdir)]\n756\t        effective: Dict[str, Any] = {}\n757\t        sources: Dict[str, str] = {}\n758\t        errors: List[str] = []\n759\t        for layer in layers:\n760\t            if layer[\"error\"]:\n761\t                errors.append(f\"{layer['name']}: {layer['error']}\")\n762\t            if layer[\"ok\"] and isinstance(layer[\"data\"], dict):\n763\t                for key, value in layer[\"data\"].items():\n764\t                    effective[key] = value\n765\t                    sources[_safe_str(key)] = layer[\"name\"]\n766\t        return {\n767\t            \"project_dir\": str(pdir),\n768\t            \"layers\": layers,\n769\t            \"effective\": effective,\n770\t            \"sources\": sources,\n771\t            \"ok\": not errors,\n772\t            \"errors\": errors,\n773\t        }\n774\t    except Exception as exc:\n775\t        _breadcrumb(f\"resolve_settings degraded fail-open: {type(exc).__name__}\")\n776\t        return {\n777\t            \"project_dir\": _safe_str(project_dir),\n778\t            \"layers\": [],\n779\t            \"effective\": {},\n780\t            \"sources\": {},\n781\t            \"ok\": False,\n782\t            \"errors\": [f\"resolver_internal_error: {type(exc).__name__}\"],\n783\t        }\n784\t\n785\t\n786\tdef classify_tampering(\n787\t    resolved: Dict[str, Any],\n788\t    env_snapshot: Optional[Mapping[str, str]] = None,\n789\t) -> List[Dict[str, str]]:\n790\t    \"\"\"Classify tamper indicators in a ``resolve_settings`` result + env.\n791\t\n792\t    ``env_snapshot=None`` consults ``IMPORT_TIME_ENV_SNAPSHOT`` (the\n793\t    trusted import-time capture) — NEVER live ``os.environ``. Pass an\n794\t    explicit mapping (possibly ``{}``) to control the env surface.\n795\t\n796\t    Returns a list of closed-enum breadcrumb dicts (possibly empty)::\n797\t\n798\t        {\"class\": <TAMPER_* member>, \"layer\": <layer name|env|disk>,\n799\t         \"detail\": <capped str, secrets redacted>}\n800\t\n801\t    Deterministic ordering: layers in LAYER_MERGE_ORDER, then env, then\n802\t    disk census. NEVER raises — internal failure returns ``[]`` with a\n803\t    stderr breadcrumb (advisory fail-open).\n804\t    \"\"\"\n805\t    try:\n806\t        findings: List[Dict[str, str]] = []\n807\t        if not isinstance(resolved, dict):\n808\t            return findings\n809\t        layers = resolved.get(\"layers\")\n810\t        if not isinstance(layers, list):\n811\t            layers = []\n812\t        allowlist = get_model_allowlist(resolved.get(\"project_dir\") or None)\n813\t        for layer in layers:\n814\t            if not isinstance(layer, dict):\n815\t                continue\n816\t            data = layer.get(\"data\")\n817\t            if isinstance(data, dict) and data:\n818\t                _check_settings_layer(\n819\t                    _safe_str(layer.get(\"name\", \"unknown\")),\n820\t                    data, allowlist, findings, resolved.get(\"project_dir\"),\n821\t                )\n822\t        env = IMPORT_TIME_ENV_SNAPSHOT if env_snapshot is None else env_snapshot\n823\t        _check_env_mapping(env, LAYER_ENV, allowlist, findings)\n824\t        _check_hook_census(resolved, findings)\n825\t        # PLAN-155 Wave 3b (SENT-CX-E) — Codex kill-switch registration\n826\t        # census (no-op unless the codex harness is installed).\n827\t        _check_codex_killswitch_census(resolved, findings)\n828\t        return findings\n829\t    except Exception as exc:\n830\t        _breadcrumb(f\"classify_tampering degraded fail-open: {type(exc).__name__}\")\n831\t        return []\n832\t\n833\t\n834\tdef count_registered_hooks(settings_dict: Dict[str, Any]) -> int:\n835\t    \"\"\"Distinct ``*.py`` basenames in ONE settings dict's hooks{} commands.\n836\t\n837\t    Same counting rule as ``verify-counts.sh`` (\"registered hooks =\n838\t    distinct *.py script basenames appearing in settings.json hooks{}\n839\t    command lines\"). Garbage input → 0 (fail-open, typed).\n840\t    \"\"\"\n841\t    try:\n842\t        return len(_registered_hook_basenames(settings_dict))\n843\t    except Exception as exc:\n844\t        _breadcrumb(f\"count_registered_hooks degraded fail-open: {type(exc).__name__}\")\n845\t        return 0\n846\t\n847\t\n848\tdef count_effective_hooks(project_dir: _PathLike) -> int:\n849\t    \"\"\"Best-effort count of registered hooks that are EFFECTIVE on disk.\n850\t\n851\t    Scope: union of hook basenames registered in the project-owned layers\n852\t    (project + local — user/managed hooks resolve outside the project\n853\t    tree) that exist as readable files under ``<project_dir>/.claude/hooks/``.\n854\t    Compare with ``count_registered_hooks`` per layer to detect a silently\n855\t    degraded rail (a registered script missing on disk fails open = allow).\n856\t    NEVER raises — returns 0 on internal failure.\n857\t    \"\"\"\n858\t    try:\n859\t        resolved = resolve_settings(project_dir)\n860\t        registered = _census_registered_basenames(resolved)\n861\t        hooks_dir = Path(_safe_str(project_dir)) / \".claude\" / \"hooks\"\n862\t        return sum(1 for name in registered if _hook_on_disk(hooks_dir / name))\n863\t    except Exception as exc:\n864\t        _breadcrumb(f\"count_effective_hooks degraded fail-open: {type(exc).__name__}\")\n865\t        return 0\n866\t\n867\t\n868\tdef registered_hook_basenames(settings_dict: Dict[str, Any]) -> List[str]:\n869\t    \"\"\"Sorted distinct hook basenames in ONE settings dict (diagnostics).\"\"\"\n870\t    try:\n871\t        return sorted(_registered_hook_basenames(settings_dict))\n872\t    except Exception:\n873\t        return []\n874\t\n875\t\n876\tdef get_model_allowlist(project_dir: Optional[_PathLike] = None) -> List[str]:\n877\t    \"\"\"Parse the ADR-149 model-id allowlist from the live repo at runtime.\n878\t\n879\t    Root resolution: explicit ``project_dir`` arg, else ``CLAUDE_PROJECT_DIR``\n880\t    env, else this module's checkout root (``parents[3]``). Reads\n881\t    ``.claude/adr/ADR-149-model-id-allowlist.md`` and extracts the\n882\t    ``frozenset({...})`` members (single source — never a hardcoded mirror).\n883\t\n884\t    Fail-open: missing/unreadable/unparseable ADR → ``[]``; callers MUST\n885\t    treat an empty list as \"membership unknown\" (skip membership checks),\n886\t    never as \"everything forbidden\".\n887\t    \"\"\"\n888\t    try:\n889\t        root = _resolve_repo_root(project_dir)\n890\t        adr_path = root / \".claude\" / \"adr\" / \"ADR-149-model-id-allowlist.md\"\n891\t        if not adr_path.is_file():\n892\t            return []\n893\t        return _parse_allowlist_members(\n894\t            adr_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n895\t        )\n896\t    except Exception as exc:\n897\t        _breadcrumb(f\"get_model_allowlist degraded fail-open: {type(exc).__name__}\")\n898\t        return []\n8