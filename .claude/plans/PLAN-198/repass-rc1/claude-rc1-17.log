{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J5CTfifGoQ6ZAzeftjsYE6","type":"tool_result","content":"60\tfrom __future__ import annotations\n61\t\n62\timport json\n63\timport os\n64\timport sys\n65\tfrom typing import Any, Dict, List, Optional\n66\t\n67\t# Make the local `_lib` importable (matches existing hooks' idiom).\n68\t_HOOKS_DIR = os.path.dirname(os.path.realpath(__file__))\n69\tif _HOOKS_DIR not in sys.path:\n70\t    sys.path.insert(0, _HOOKS_DIR)\n71\t\n72\t# effective_config: the SHARED forbidden-keys single source (W1 S0). Import\n73\t# is guarded — if the resolver is unavailable (truncated install / partial\n74\t# checkout) the hook degrades to a pure allow (fail-open §5), never blocks.\n75\ttry:\n76\t    from _lib import effective_config as _eff  # noqa: E402\n77\t    _EFF_AVAILABLE = True\n78\texcept Exception:  # pragma: no cover — degrade to allow\n79\t    _eff = None  # type: ignore[assignment]\n80\t    _EFF_AVAILABLE = False\n81\t\n82\t# audit_emit: import-guarded. Unavailable → no audit, hook still decides.\n83\ttry:\n84\t    from _lib import audit_emit as _audit_emit  # noqa: E402\n85\t    _AUDIT_AVAILABLE = True\n86\texcept Exception:  # pragma: no cover\n87\t    _audit_emit = None  # type: ignore[assignment]\n88\t    _AUDIT_AVAILABLE = False\n89\t\n90\t\n91\t#: Settings-FILE layer surfaces H2 block-scopes (a ConfigChange IS a file\n92\t#: change). Mirrors _CONFIG_CHANGE_LAYERS in audit_emit. Process-``env`` and\n93\t#: ``disk`` (hook-census) findings are S3's surfaces and are filtered out\n94\t#: before any block decision — H2 never blocks on them.\n95\t_BLOCK_SCOPE_LAYERS = frozenset({\"user\", \"project\", \"local\", \"managed\"})\n96\t\n97\t#: The closed env/disk pseudo-layer names a finding may carry (filtered out).\n98\t_NON_FILE_LAYERS = frozenset({\"env\", \"disk\"})\n99\t\n100\t#: Audit-wire layer enum (settings layers + the safe sentinel). Mirrors\n101\t#: audit_emit._CONFIG_CHANGE_LAYERS.\n102\t_AUDIT_LAYERS = frozenset({\"user\", \"project\", \"local\", \"managed\", \"other\"})\n103\t\n104\t_REASON_CAP = 600\n105\t\n106\t\n107\tdef _breadcrumb(message: str) -> None:\n108\t    \"\"\"stderr breadcrumb for degraded / fail-open paths (closeout-guard precedent).\"\"\"\n109\t    try:\n110\t        sys.stderr.write(\"# check_config_change: %s\\n\" % str(message)[:200])\n111\t    except Exception:\n112\t        pass\n113\t\n114\t\n115\tdef _disabled() -> bool:\n116\t    return os.environ.get(\"CEO_CONFIG_CHANGE_GUARD\", \"1\").strip() == \"0\"\n117\t\n118\t\n119\tdef _coerce_layer(layer: Any) -> str:\n120\t    \"\"\"Coerce a finding layer to the audit-wire closed enum (sentinel ``other``).\"\"\"\n121\t    return layer if layer in _AUDIT_LAYERS else \"other\"\n122\t\n123\t\n124\tdef _resolve_cwd(hook_input: Dict[str, Any]) -> str:\n125\t    \"\"\"Project dir from the hook payload, else CLAUDE_PROJECT_DIR, else cwd.\"\"\"\n126\t    cwd = hook_input.get(\"cwd\")\n127\t    if isinstance(cwd, str) and cwd.strip():\n128\t        return cwd\n129\t    env_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\").strip()\n130\t    if env_dir:\n131\t        return env_dir\n132\t    return os.getcwd()\n133\t\n134\t\n135\tdef _settings_surface_findings(findings: List[Dict[str, str]]) -> List[Dict[str, str]]:\n136\t    \"\"\"Keep only findings scoped to a settings-FILE layer (drop env/disk).\n137\t\n138\t    H2 block-scopes the file surfaces a ConfigChange event represents; the\n139\t    process-``env`` snapshot and the on-disk hook census are S3's boot\n140\t    surfaces, not a settings-file change, so census/env findings are\n141\t    OBSERVE-ONLY here — never block-worthy.\n142\t    \"\"\"\n143\t    out: List[Dict[str, str]] = []\n144\t    for finding in findings:\n145\t        if not isinstance(finding, dict):\n146\t            continue\n147\t        layer = finding.get(\"layer\")\n148\t        if layer in _NON_FILE_LAYERS:\n149\t            continue\n150\t        out.append(finding)\n151\t    return out\n152\t\n153\t\n154\tdef _classify(cwd: str) -> List[Dict[str, str]]:\n155\t    \"\"\"Resolve + classify; never raises (resolver is fail-open by contract).\"\"\"\n156\t    if not _EFF_AVAILABLE or _eff is None:\n157\t        _breadcrumb(\"effective_config unavailable — degraded to allow (no scan)\")\n158\t        return []\n159\t    try:\n160\t        resolved = _eff.resolve_settings(cwd)\n161\t        # classify_tampering(resolved, None) consults the IMPORT-TIME env\n162\t        # snapshot (trusted_env pattern), NEVER live os.environ — a late-set\n163\t        # value injected mid-session cannot dodge the scan. We then filter\n164\t        # env/disk findings out of the BLOCK path below.\n165\t        return _eff.classify_tampering(resolved)\n166\t    except Exception as exc:  # pragma: no cover — resolver already fails open\n167\t        _breadcrumb(\"classify failed (%s) — degraded to allow\" % type(exc).__name__)\n168\t        return []\n169\t\n170\t\n171\tdef _emit_observed(layer: str, session_id: str, project: str) -> None:\n172\t    \"\"\"Audit the benign ALLOW path (one emit). Deny-by-default scrub branch.\n173\t\n174\t    No public typed wrapper (settings_tamper_detected precedent) — emit via\n175\t    emit_generic, which routes config_change_observed through its dedicated\n176\t    _scrub_ branch + _CONFIG_CHANGE_OBSERVED_ALLOWLIST. The ONLY caller field\n177\t    is the closed-enum ``layer``; the changed file's path/body and any\n178\t    settings value are NEVER passed.\n179\t    \"\"\"\n180\t    if not _AUDIT_AVAILABLE or _audit_emit is None:\n181\t        return\n182\t    try:\n183\t        _audit_emit.emit_generic(\n184\t            \"config_change_observed\",\n185\t            layer=_coerce_layer(layer),\n186\t            session_id=session_id,\n187\t            project=project,\n188\t        )\n189\t    except Exception as exc:  # pragma: no cover — emit never blocks the hook\n190\t        _breadcrumb(\"emit config_change_observed failed: %s\" % type(exc).__name__)\n191\t\n192\t\n193\tdef _emit_forbidden_key(\n194\t    tamper_class: str,\n195\t    layer: str,\n196\t    finding_count: int,\n197\t    session_id: str,\n198\t    project: str,\n199\t) -> None:\n200\t    \"\"\"Audit one forbidden-key tamper class on the BLOCK path.\n201\t\n202\t    ONE emit per (tamper_class) on the changed layer. Caller fields are the\n203\t    closed-enum ``tamper_class`` + ``layer`` + the integer ``finding_count``;\n204\t    the forbidden key's VALUE and the effective_config finding DETAIL are\n205\t    NEVER passed (the _scrub_ branch + allowlist would drop them anyway —\n206\t    belt and braces, the producer simply never sends them).\n207\t    \"\"\"\n208\t    if not _AUDIT_AVAILABLE or _audit_emit is None:\n209\t        return\n210\t    try:\n211\t        _audit_emit.emit_generic(\n212\t            \"config_change_forbidden_key\",\n213\t            tamper_class=str(tamper_class),\n214\t            layer=_coerce_layer(layer),\n215\t            finding_count=int(finding_count),\n216\t            session_id=session_id,\n217\t            project=project,\n218\t        )\n219\t    except Exception as exc:  # pragma: no cover\n220\t        _breadcrumb(\"emit config_change_forbidden_key failed: %s\" % type(exc).__name__)\n221\t\n222\t\n223\tdef _block_reason(forbidden: List[Dict[str, str]]) -> str:\n224\t    \"\"\"Build the advisory-block reason.\n225\t\n226\t    Names the tamper CLASS and the LAYER only — never the finding ``detail``\n227\t    (an attacker endpoint URL / off-allowlist model id / apiKeyHelper path /\n228\t    dangerously-flag value lives there; it is NEVER rendered into a\n229\t    decision-channel string the operator's terminal echoes).\n230\t    \"\"\"\n231\t    pairs = sorted({(f.get(\"class\", \"other\"), f.get(\"layer\", \"other\")) for f in forbidden})\n232\t    listed = \"; \".join(\"%s @ %s\" % (cls, layer) for cls, layer in pairs[:8])\n233\t    return (\n234\t        \"CONFIG-TAMPER: an out-of-band settings change introduced a forbidden \"\n235\t        \"key (S197 class). Forbidden-key tamper detected: %s. Review the \"\n236\t        \"settings layer named above and revert if you did not intend it; this \"\n237\t        \"is advisory — your edit is recorded but NOT auto-reverted. Coverage \"\n238\t        \"boundary: this guard is itself a hook (disarmed by disableAllHooks \"\n239\t        \"and blind to outside-harness edits); the /ceo-boot tripwires re-scan \"\n240\t        \"on the next boot.\" % (listed or \"unclassified\")\n241\t    )[:_REASON_CAP]\n242\t\n243\t\n244\tdef gate(hook_input: Dict[str, Any]) -> Dict[str, Any]:\n245\t    \"\"\"Pure decision function.\n246\t\n247\t    Returns ``{}`` (allow) on every benign / infra path, or\n248\t    ``{\"decision\": \"block\", \"reason\": ...}`` ONLY when a forbidden-key\n249\t    finding is scoped to a settings-file layer. Never raises.\n250\t    \"\"\"\n251\t    if _disabled():\n252\t        return {}\n253\t    cwd = _resolve_cwd(hook_input)\n254\t    session_id = \"\"\n255\t    sid = hook_input.get(\"session_id\")\n256\t    if isinstance(sid, str):\n257\t        session_id = sid[:64]\n258\t    project = \"\"\n259\t    proj = hook_input.get(\"project\")"}]},"parent_tool_use_id":null,"session_id":"6c392eab-1f45-41b4-827f-fcae27112528","uuid":"5fe0516c-867a-4a2a-923d-e1158b3ad71f","timestamp":"2026-11-15T10:33:02.766Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_config_change.py","content":"from __future__ import annotations\n\nimport json\nimport os\nimport sys\nfrom typing import Any, Dict, List, Optional\n\n# Make the local `_lib` importable (matches existing hooks' idiom).\n_HOOKS_DIR = os.path.dirname(os.path.realpath(__file__))\nif _HOOKS_DIR not in sys.path:\n    sys.path.insert(0, _HOOKS_DIR)\n\n# effective_config: the SHARED forbidden-keys single source (W1 S0). Import\n# is guarded — if the resolver is unavailable (truncated install / partial\n# checkout) the hook degrades to a pure allow (fail-open §5), never blocks.\ntry:\n    from _lib import effective_config as _eff  # noqa: E402\n    _EFF_AVAILABLE = True\nexcept Exception:  # pragma: no cover — degrade to allow\n    _eff = None  # type: ignore[assignment]\n    _EFF_AVAILABLE = False\n\n# audit_emit: import-guarded. Unavailable → no audit, hook still decides.\ntry:\n    from _lib import audit_emit as _audit_emit  # noqa: E402\n    _AUDIT_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _audit_emit = None  # type: ignore[assignment]\n    _AUDIT_AVAILABLE = False\n\n\n#: Settings-FILE layer surfaces H2 block-scopes (a ConfigChange IS a file\n#: change). Mirrors _CONFIG_CHANGE_LAYERS in audit_emit. Process-``env`` and\n#: ``disk`` (hook-census) findings are S3's surfaces and are filtered out\n#: before any block decision — H2 never blocks on them.\n_BLOCK_SCOPE_LAYERS = frozenset({\"user\", \"project\", \"local\", \"managed\"})\n\n#: The closed env/disk pseudo-layer names a finding may carry (filtered out).\n_NON_FILE_LAYERS = frozenset({\"env\", \"disk\"})\n\n#: Audit-wire layer enum (settings layers + the safe sentinel). Mirrors\n#: audit_emit._CONFIG_CHANGE_LAYERS.\n_AUDIT_LAYERS = frozenset({\"user\", \"project\", \"local\", \"managed\", \"other\"})\n\n_REASON_CAP = 600\n\n\ndef _breadcrumb(message: str) -> None:\n    \"\"\"stderr breadcrumb for degraded / fail-open paths (closeout-guard precedent).\"\"\"\n    try:\n        sys.stderr.write(\"# check_config_change: %s\\n\" % str(message)[:200])\n    except Exception:\n        pass\n\n\ndef _disabled() -> bool:\n    return os.environ.get(\"CEO_CONFIG_CHANGE_GUARD\", \"1\").strip() == \"0\"\n\n\ndef _coerce_layer(layer: Any) -> str:\n    \"\"\"Coerce a finding layer to the audit-wire closed enum (sentinel ``other``).\"\"\"\n    return layer if layer in _AUDIT_LAYERS else \"other\"\n\n\ndef _resolve_cwd(hook_input: Dict[str, Any]) -> str:\n    \"\"\"Project dir from the hook payload, else CLAUDE_PROJECT_DIR, else cwd.\"\"\"\n    cwd = hook_input.get(\"cwd\")\n    if isinstance(cwd, str) and cwd.strip():\n        return cwd\n    env_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\").strip()\n    if env_dir:\n        return env_dir\n    return os.getcwd()\n\n\ndef _settings_surface_findings(findings: List[Dict[str, str]]) -> List[Dict[str, str]]:\n    \"\"\"Keep only findings scoped to a settings-FILE layer (drop env/disk).\n\n    H2 block-scopes the file surfaces a ConfigChange event represents; the\n    process-``env`` snapshot and the on-disk hook census are S3's boot\n    surfaces, not a settings-file change, so census/env findings are\n    OBSERVE-ONLY here — never block-worthy.\n    \"\"\"\n    out: List[Dict[str, str]] = []\n    for finding in findings:\n        if not isinstance(finding, dict):\n            continue\n        layer = finding.get(\"layer\")\n        if layer in _NON_FILE_LAYERS:\n            continue\n        out.append(finding)\n    return out\n\n\ndef _classify(cwd: str) -> List[Dict[str, str]]:\n    \"\"\"Resolve + classify; never raises (resolver is fail-open by contract).\"\"\"\n    if not _EFF_AVAILABLE or _eff is None:\n        _breadcrumb(\"effective_config unavailable — degraded to allow (no scan)\")\n        return []\n    try:\n        resolved = _eff.resolve_settings(cwd)\n        # classify_tampering(resolved, None) consults the IMPORT-TIME env\n        # snapshot (trusted_env pattern), NEVER live os.environ — a late-set\n        # value injected mid-session cannot dodge the scan. We then filter\n        # env/disk findings out of the BLOCK path below.\n        return _eff.classify_tampering(resolved)\n    except Exception as exc:  # pragma: no cover — resolver already fails open\n        _breadcrumb(\"classify failed (%s) — degraded to allow\" % type(exc).__name__)\n        return []\n\n\ndef _emit_observed(layer: str, session_id: str, project: str) -> None:\n    \"\"\"Audit the benign ALLOW path (one emit). Deny-by-default scrub branch.\n\n    No public typed wrapper (settings_tamper_detected precedent) — emit via\n    emit_generic, which routes config_change_observed through its dedicated\n    _scrub_ branch + _CONFIG_CHANGE_OBSERVED_ALLOWLIST. The ONLY caller field\n    is the closed-enum ``layer``; the changed file's path/body and any\n    settings value are NEVER passed.\n    \"\"\"\n    if not _AUDIT_AVAILABLE or _audit_emit is None:\n        return\n    try:\n        _audit_emit.emit_generic(\n            \"config_change_observed\",\n            layer=_coerce_layer(layer),\n            session_id=session_id,\n            project=project,\n        )\n    except Exception as exc:  # pragma: no cover — emit never blocks the hook\n        _breadcrumb(\"emit config_change_observed failed: %s\" % type(exc).__name__)\n\n\ndef _emit_forbidden_key(\n    tamper_class: str,\n    layer: str,\n    finding_count: int,\n    session_id: str,\n    project: str,\n) -> None:\n    \"\"\"Audit one forbidden-key tamper class on the BLOCK path.\n\n    ONE emit per (tamper_class) on the changed layer. Caller fields are the\n    closed-enum ``tamper_class`` + ``layer`` + the integer ``finding_count``;\n    the forbidden key's VALUE and the effective_config finding DETAIL are\n    NEVER passed (the _scrub_ branch + allowlist would drop them anyway —\n    belt and braces, the producer simply never sends them).\n    \"\"\"\n    if not _AUDIT_AVAILABLE or _audit_emit is None:\n        return\n    try:\n        _audit_emit.emit_generic(\n            \"config_change_forbidden_key\",\n            tamper_class=str(tamper_class),\n            layer=_coerce_layer(layer),\n            finding_count=int(finding_count),\n            session_id=session_id,\n            project=project,\n        )\n    except Exception as exc:  # pragma: no cover\n        _breadcrumb(\"emit config_change_forbidden_key failed: %s\" % type(exc).__name__)\n\n\ndef _block_reason(forbidden: List[Dict[str, str]]) -> str:\n    \"\"\"Build the advisory-block reason.\n\n    Names the tamper CLASS and the LAYER only — never the finding ``detail``\n    (an attacker endpoint URL / off-allowlist model id / apiKeyHelper path /\n    dangerously-flag value lives there; it is NEVER rendered into a\n    decision-channel string the operator's terminal echoes).\n    \"\"\"\n    pairs = sorted({(f.get(\"class\", \"other\"), f.get(\"layer\", \"other\")) for f in forbidden})\n    listed = \"; \".join(\"%s @ %s\" % (cls, layer) for cls, layer in pairs[:8])\n    return (\n        \"CONFIG-TAMPER: an out-of-band settings change introduced a forbidden \"\n        \"key (S197 class). Forbidden-key tamper detected: %s. Review the \"\n        \"settings layer named above and revert if you did not intend it; this \"\n        \"is advisory — your edit is recorded but NOT auto-reverted. Coverage \"\n        \"boundary: this guard is itself a hook (disarmed by disableAllHooks \"\n        \"and blind to outside-harness edits); the /ceo-boot tripwires re-scan \"\n        \"on the next boot.\" % (listed or \"unclassified\")\n    )[:_REASON_CAP]\n\n\ndef gate(hook_input: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Pure decision function.\n\n    Returns ``{}`` (allow) on every benign / infra path, or\n    ``{\"decision\": \"block\", \"reason\": ...}`` ONLY when a forbidden-key\n    finding is scoped to a settings-file layer. Never raises.\n    \"\"\"\n    if _disabled():\n        return {}\n    cwd = _resolve_cwd(hook_input)\n    session_id = \"\"\n    sid = hook_input.get(\"session_id\")\n    if isinstance(sid, str):\n        session_id = sid[:64]\n    project = \"\"\n    proj = hook_input.get(\"project\")","numLines":200,"startLine":60,"totalLines":347}},"tool_result_meta":[{"id":"toolu_01J5CTfifGoQ6ZAzeftjsYE6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
