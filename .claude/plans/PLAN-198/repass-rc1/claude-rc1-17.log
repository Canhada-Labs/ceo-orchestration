{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1LfmDtW59NK9Tk3FBEo","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DKHTe2MYgz3yxD5N8XaLGe","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_python-hook.sh"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3841,"cache_read_input_tokens":226213,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3841},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"db09679d-5189-4158-a1d6-4bf6064c9841","uuid":"84eb2edc-ec79-46e2-9fc9-0a3f1943af3b","timestamp":"2026-11-13T17:42:34.395Z","request_id":"req_011Ch1LfkzVWzS97pGrAV43j","wire_tool_inputs":{"toolu_01DKHTe2MYgz3yxD5N8XaLGe":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_python-hook.sh"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DKHTe2MYgz3yxD5N8XaLGe","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# _python-hook.sh — Python version resolver + hook invoker.\n3\t#\n4\t# Registered in .claude/settings.json as the entrypoint for every Python\n5\t# hook (check_agent_spawn.py, audit_log.py). Resolves `python3.12` →\n6\t# `python3.11` → `python3.10` → `python3` and refuses anything below 3.9.\n7\t#\n8\t# ## Why a shim?\n9\t#\n10\t# `python3` on a user's $PATH is not hermetic:\n11\t# - asdf / pyenv resolution is shell-dependent\n12\t# - macOS system Python is 3.9 on older machines\n13\t# - ubuntu-22.04 runners default to 3.10\n14\t# - ubuntu-24.04 runners default to 3.12\n15\t# - minimal containers may ship Python 3.8 or none at all\n16\t#\n17\t# Letting Claude Code run `python3 ...` directly lets a mis-resolved PATH\n18\t# silently pick a version that can't run the hooks. The shim is explicit:\n19\t# it looks for the newest Python 3.x ≥ 3.9 and refuses to continue if no\n20\t# compatible interpreter is found. The refusal message points at install\n21\t# commands so the Owner can fix it in one step.\n22\t#\n23\t# ## Minimum Python version\n24\t#\n25\t# **3.9** — the macOS system Python on Big Sur / Monterey. This is a\n26\t# concession to reality: the original PLAN-002 §11-bis Q1 targeted 3.10\n27\t# as minimum, but local dogfooding on this repo runs on 3.9.6 and\n28\t# installing 3.10+ globally is out of scope for a framework that wants\n29\t# to be \"clone and use\". All hook Python code is written with\n30\t# `from __future__ import annotations` + `typing.Optional/Union` and\n31\t# avoids match statements, so 3.9 is fully workable.\n32\t#\n33\t# ## Usage\n34\t#\n35\t# In settings.json:\n36\t#     \"command\": \"bash \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\\\" check_agent_spawn.py\"\n37\t#\n38\t# The shim forwards stdin/stdout/stderr and passes any trailing args\n39\t# through to the Python interpreter.\n40\t\n41\t# F-CHAOS-5 (PLAN-019) + PLAN-023 Phase F (F-perf-001): explicit Python\n42\t# version gate, gated to the cache-miss branch only.\n43\t#\n44\t# Framework requires Python >=3.9 (ADR-002). Earlier versions silently\n45\t# lack stdlib features (from __future__ import annotations, etc.).\n46\t#\n47\t# Pre PLAN-023 Phase F: _py_version_check() ran unconditionally at shim\n48\t# entry, spawning a `python3 -c \"import sys...\"` subprocess every single\n49\t# invocation (~15-20ms). Cache-hit paths paid this cost even though the\n50\t# cached interpreter had already been validated on its first resolution.\n51\t#\n52\t# Post PLAN-023 Phase F: the check is called ONLY from the cache-miss\n53\t# branch below (after CANDIDATES-loop probing). The cache file persists\n54\t# a validated interpreter absolute path; a cache-hit restore implicitly\n55\t# re-validates by invoking the cached binary for the hook itself. If the\n56\t# cached binary has been uninstalled between invocations, the subsequent\n57\t# hook invocation fails loud with the OS-level \"No such file\" — cleaner\n58\t# signal than a silent version re-probe.\n59\t_py_version_check() {\n60\t  local ver\n61\t  ver=$(python3 -c \"import sys; print(f\\\"{sys.version_info.major}.{sys.version_info.minor}\\\")\" 2>/dev/null) || {\n62\t    echo \"ERROR: python3 not found or invocable. Framework requires Python >=3.9.\" >&2\n63\t    exit 3\n64\t  }\n65\t  local major minor\n66\t  major=${ver%.*}\n67\t  minor=${ver#*.}\n68\t  if [ \"$major\" -lt 3 ] || { [ \"$major\" -eq 3 ] && [ \"$minor\" -lt 9 ]; }; then\n69\t    echo \"ERROR: Python $ver detected; framework requires >=3.9 (ADR-002).\" >&2\n70\t    echo \"       Upgrade via your package manager and retry.\" >&2\n71\t    exit 3\n72\t  fi\n73\t}\n74\t# NOTE: call is deferred to the cache-miss branch below (see\n75\t# `_py_version_check` call site inside the CANDIDATES loop). Intentionally\n76\t# no call here — Phase F perf optimization.\n77\t\n78\t# PLAN-025 F-perf-dead-code-1: the earlier `_extract_session_id()`\n79\t# helper (P3-SEC-M PLAN-019) had no callers in production paths and\n80\t# was forking an extra `python3 -c` subprocess per invocation. Removed\n81\t# in Batch K to reduce shim overhead. If session_id breadcrumbs ever\n82\t# need to be extracted at shim level again, re-add with the Python\n83\t# JSON-parse call INSIDE the existing per-invocation python3 spawn\n84\t# (zero marginal cost) instead of a separate subprocess.\n85\t\n86\tset -euo pipefail\n87\t\n88\t# ---------------------------------------------------------------------------\n89\t# PLAN-156 Wave 2 (SENT-GK-A) — grok adapter AUTO-DETECT (pair-rail S269 P1 #1).\n90\t#\n91\t# THE CRITICAL single-surface fix. The grok harness arms the legacy-compat\n92\t# `.claude/settings.json`, whose hook commands do NOT carry\n93\t# `env CEO_HOOK_ADAPTER=grok` (they are the Claude-native registrations —\n94\t# adding it would break Claude Code, which shares the file). But grok delivers\n95\t# a camelCase wire (`hookEventName`/`toolName`) to those hooks, so without the\n96\t# adapter set they resolve to the CLAUDE adapter, which misparses the grok\n97\t# wire → empty tool_name → the matcher-shaped guards no-op → ENFORCEMENT\n98\t# SILENTLY FAILS (fail-open). The live-fire missed this because it set the env\n99\t# by hand; the codex pair-rail caught it.\n100\t#\n101\t# Grok injects `GROK_HOOK_EVENT` (+ GROK_SESSION_ID / GROK_WORKSPACE_ROOT) on\n102\t# EVERY hook it runs, and never sets CEO_HOOK_ADAPTER. So: if a grok runner\n103\t# var is present and the adapter is unset, we ARE under grok — select it. This\n104\t# is what makes the single-surface (`.claude/settings.json`) armed rail\n105\t# actually enforce under grok. An explicit CEO_HOOK_ADAPTER always wins (tests,\n106\t# codex, a deliberate override).\n107\tif [ -z \"${CEO_HOOK_ADAPTER:-}\" ] && [ -n \"${GROK_HOOK_EVENT:-}${GROK_SESSION_ID:-}\" ]; then\n108\t  export CEO_HOOK_ADAPTER=grok\n109\tfi\n110\t\n111\tMIN_MAJOR=3\n112\tMIN_MINOR=9\n113\t\n114\t# Preferred candidates, most-recent first.\n115\tCANDIDATES=(\n116\t  \"python3.13\"\n117\t  \"python3.12\"\n118\t  \"python3.11\"\n119\t  \"python3.10\"\n120\t  \"python3.9\"\n121\t  \"python3\"\n122\t)\n123\t\n124\t# PLAN-019 Perf-P2-002 — resolved-interpreter cache.\n125\t#\n126\t# Measured overhead pre-optimization: ~24ms p50 (on a box where only\n127\t# `python3` exists, 5 `command -v` failures + 1 spawn of `python -c\n128\t# \"import sys; print(...)\"` for version probe). Hot-path cost dominated\n129\t# by the version-probe subprocess.\n130\t#\n131\t# Optimization: cache the resolved interpreter path + PATH hash in a\n132\t# per-user tempfile. On cache-hit with matching PATH signature, skip the\n133\t# probing loop entirely. Cache invalidates automatically when the user's\n134\t# PATH changes (e.g. `brew install python@3.12`) so the freshest\n135\t# interpreter is picked up without manual eviction.\n136\t#\n137\t# Expected post-fix overhead: ~2ms (single `stat` + read of cache file).\n138\t#\n139\t# Security: cache file lives under $TMPDIR (or /tmp) with user-scoped\n140\t# path, so a rogue cache from another user cannot hijack. The cached\n141\t# path is only USED if the interpreter still exists + reports the same\n142\t# version. Fail-safe: cache miss falls back to the full probe.\n143\t_cache_dir() {\n144\t  local base=\"${TMPDIR:-/tmp}\"\n145\t  # Strip trailing slash for consistent path construction.\n146\t  base=\"${base%/}\"\n147\t  echo \"${base}/ceo-pyhook-$(id -u)\"\n148\t}\n149\t_path_hash() {\n150\t  # Fast-ish, deterministic hash of the current $PATH. Prefer shasum\n151\t  # (macOS); fall back to sha256sum (Linux); fall back to cksum (POSIX)\n152\t  # if neither is available (content differs but is still deterministic).\n153\t  if command -v shasum >/dev/null 2>&1; then\n154\t    printf '%s' \"$PATH\" | shasum -a 256 | cut -c1-16\n155\t  elif command -v sha256sum >/dev/null 2>&1; then\n156\t    printf '%s' \"$PATH\" | sha256sum | cut -c1-16\n157\t  else\n158\t    printf '%s' \"$PATH\" | cksum | cut -d' ' -f1\n159\t  fi\n160\t}\n161\t\n162\t# PLAN-152 security-01 — cache trust gate (TOCTOU / symlink hardening).\n163\t#\n164\t# The cached interpreter path is READ from $TMPDIR and later EXEC'd; under\n165\t# a shared /tmp another local user could pre-create the cache dir (or swap\n166\t# in a symlink) and plant an interpreter path of their choosing, and a\n167\t# symlinked cache DIR would additionally redirect the cache WRITE into an\n168\t# attacker-chosen location. Before any read or write we therefore require:\n169\t# the cache dir is a real directory (not a symlink) owned by the current\n170\t# uid, and the cache file (when present) is a regular non-symlink file\n171\t# owned by the current uid. Any failed check = cache miss (fall back to\n172\t# the full probe) — never a hard failure.\n173\t_owner_uid() {\n174\t  # GNU stat first (Linux); BSD stat fallback (macOS).\n175\t  stat -c '%u' \"$1\" 2>/dev/null || stat -f '%u' \"$1\" 2>/dev/null\n176\t}\n177\t_perm_bits() {\n178\t  # Octal permission bits (low bits only): GNU '%a' / BSD '%Lp'.\n179\t  stat -c '%a' \"$1\" 2>/dev/null || stat -f '%Lp' \"$1\" 2>/dev/null\n180\t}\n181\t_dir_mode_safe() {\n182\t  # PLAN-152 security-01 P2 (Codex R2): reject a group/other-writable\n183\t  # cache dir. A user-owned but world/group-writable dir lets another\n184\t  # local user swap the cache file between the trust check and the read\n185\t  # (TOCTOU), restoring the interpreter-hijack this gate closes.\n186\t  local m\n187\t  m=\"$(_perm_bits \"$1\")\" || return 1\n188\t  [ -n \"$m\" ] && [ \"$(( 0${m} & 022 ))\" -eq 0 ]\n189\t}\n190\t_cache_dir_trusted() {\n191\t  [ ! -L \"$_CACHE_DIR\" ] && [ -d \"$_CACHE_DIR\" ] \\\n192\t    && [ \"$(_owner_uid \"$_CACHE_DIR\")\" = \"$_CUR_UID\" ] \\\n193\t    && _dir_mode_safe \"$_CACHE_DIR\"\n194\t}\n195\t_cache_file_trusted() {\n196\t  [ ! -L \"$_CACHE_FILE\" ] && [ -f \"$_CACHE_FILE\" ] \\\n197\t    && [ \"$(_owner_uid \"$_CACHE_FILE\")\" = \"$_CUR_UID\" ]\n198\t}\n199\t\n200\tparse_version() {\n201\t  # Emit \"MAJOR MINOR\" from `python --version` output (e.g. \"Python 3.12.3\")\n202\t  local py=\"$1\"\n203\t  \"$py\" -c 'import sys; print(sys.version_info[0], sys.version_info[1])' 2>/dev/null\n204\t}\n205\t\n206\tversion_ok() {\n207\t  # Accepts \"MAJOR MINOR\"; returns 0 if ≥ MIN, else 1.\n208\t  local major=\"$1\" minor=\"$2\"\n209\t  if [ \"$major\" -lt \"$MIN_MAJOR\" ]; then\n210\t    return 1\n211\t  fi\n212\t  if [ \"$major\" -eq \"$MIN_MAJOR\" ] && [ \"$minor\" -lt \"$MIN_MINOR\" ]; then\n213\t    return 1\n214\t  fi\n215\t  return 0\n216\t}\n217\t\n218\t# ---- Cache lookup (fast path) ----\n219\tFOUND_PY=\"\"\n220\t_CUR_UID=\"$(id -u)\"\n221\t_CACHE_DIR=\"$(_cache_dir)\"\n222\t_PATH_SIG=\"$(_path_hash 2>/dev/null || echo \"nohash\")\"\n223\t_CACHE_FILE=\"${_CACHE_DIR}/resolved-py-${_PATH_SIG}\"\n224\t\n225\t# Honour CEO_PYHOOK_NO_CACHE=1 to force re-probe (useful for testing\n226\t# the fallback path or after installing a new interpreter mid-session).\n227\t# PLAN-152 security-01: the dir + file trust gates (ownership, no\n228\t# symlinks) run BEFORE the read — an untrusted cache is a cache MISS.\n229\tif [ \"${CEO_PYHOOK_NO_CACHE:-0}\" != \"1\" ] && _cache_dir_trusted \\\n230\t    && _cache_file_trusted && [ -r \"$_CACHE_FILE\" ]; then\n231\t  _cached_py=\"$(cat \"$_CACHE_FILE\" 2>/dev/null || echo \"\")\"\n232\t  if [ -n \"$_cached_py\" ] && command -v \"$_cached_py\" >/dev/null 2>&1; then\n233\t    # Trust the cache: PATH-hash changes would have produced a different\n234\t    # cache filename, and the interpreter path still resolves. No version\n235\t    # recheck needed on hot path.\n236\t    FOUND_PY=\"$_cached_py\"\n237\t  fi\n238\tfi\n239\t\n240\t# ---- Cache miss: full probe + repopulate ----\n241\tif [ -z \"$FOUND_PY\" ]; then\n242\t  # PLAN-023 Phase F (F-perf-001): run the baseline Python≥3.9 gate ONLY\n243\t  # in the cache-miss branch. The gate's `python3 -c ...` spawn is ~15-20ms\n244\t  # that cache-hit paths no longer pay. The gate still fires on every\n245\t  # first-time or PATH-changed invocation, which is the only time a new\n246\t  # interpreter could appear.\n247\t  _py_version_check\n248\t\n249\t  for candidate in \"${CANDIDATES[@]}\"; do\n250\t    if command -v \"$candidate\" >/dev/null 2>&1; then\n251\t      read -r py_major py_minor <<< \"$(parse_version \"$candidate\")\"\n252\t      if [ -n \"${py_major:-}\" ] && version_ok \"$py_major\" \"$py_minor\"; then\n253\t        FOUND_PY=\"$candidate\"\n254\t        break\n255\t      fi\n256\t    fi\n257\t  done\n258\t\n259\t  # Cache the result for next invocation (atomic write via mv).\n260\t  if [ -n \"$FOUND_PY\" ]; then\n261\t    # mkdir is idempotent + concurrent-safe (-p). Set 0700 so another\n262\t    # unix user on the host cannot read or replace the cache.\n263\t    # PLAN-152 security-01: never write through a symlinked or foreign-\n264\t    # owned cache dir (symlink-redirect write primitive).\n265\t    # Order matters (PLAN-152 security-01 P2): reject a symlinked dir\n266\t    # BEFORE chmod (never chmod an attacker's symlink target), then chmod\n267\t    # 0700 to normalize the mode under a loose umask, THEN the full trust\n268\t    # check (owner + non-symlink + no group/other write).\n269\t    if mkdir -p \"$_CACHE_DIR\" 2>/dev/null && [ ! -L \"$_CACHE_DIR\" ] \\\n270\t        && chmod 0700 \"$_CACHE_DIR\" 2>/dev/null && _cache_dir_trusted; then\n271\t      _tmp_cache=\"${_CACHE_FILE}.$$\"\n272\t      if printf '%s\\n' \"$FOUND_PY\" > \"$_tmp_cache\" 2>/dev/null; then\n273\t        mv -f \"$_tmp_cache\" \"$_CACHE_FILE\" 2>/dev/null || rm -f \"$_tmp_cache\" 2>/dev/null\n274\t      fi\n275\t    fi\n276\t  fi\n277\tfi\n278\t\n279\tif [ -z \"$FOUND_PY\" ]; then\n280\t  cat >&2 <<EOF\n281\t[_python-hook.sh] ERROR: No Python >= ${MIN_MAJOR}.${MIN_MINOR} found.\n282\tceo-orchestration hooks require Python ${MIN_MAJOR}.${MIN_MINOR}+. Install one:\n283\t\n284\t  macOS:   brew install python@3.12\n285\t  Ubuntu:  sudo apt install python3.12\n286\t  Fedora:  sudo dnf install python3.12\n287\t\n288\tAfter installing, restart your shell so the PATH picks up the new interpreter.\n289\tEOF\n290\t  # Fail-open: emit a permissive decision so the user session isn't bricked\n291\t  # if Python is missing. The governance hook degrades gracefully.\n292\t  echo '{}'  # schema-compliant allow\n293\t  exit 0\n294\tfi\n295\t\n296\t# First positional arg is the hook script name (relative to this dir).\n297\tHOOKS_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n298\tif [ $# -lt 1 ]; then\n299\t  echo \"[_python-hook.sh] ERROR: missing hook script name\" >&2\n300\t  echo '{}'  # schema-compliant allow\n301\t  exit 0\n302\tfi\n303\t\n304\tHOOK_SCRIPT=\"$HOOKS_DIR/$1\"\n305\tshift\n306\t\n307\tif [ ! -f \"$HOOK_SCRIPT\" ]; then\n308\t  echo \"[_python-hook.sh] ERROR: hook not found: $HOOK_SCRIPT\" >&2\n309\t  echo '{}'  # schema-compliant allow\n310\t  exit 0\n311\tfi\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# PLAN-156 Wave 2 (SENT-GK-A) — decision→exit chokepoint.\n315\t#\n316\t# ## Why the shim owns this\n317\t#\n318\t# Grok Build's PreToolUse contract (grok 0.2.93) and Codex's both key a\n319\t# deny on **exit 2** in addition to the stdout JSON (probes:\n320\t# PLAN-156/artifacts/characterization-grok-codex-S269.md). Before this\n321\t# block, deny-emit and process-exit were DECOUPLED: `write_decision` only\n322\t# wrote stdout and the shim `exec`'d the hook, so the hook's own exit 0\n323\t# became the process exit — a correct deny could still fail OPEN on a\n324\t# host that keys on the code. The mapping cannot live in Python (an\n325\t# interpreter crash / ImportError / signal never reaches Python), so it\n326\t# lives HERE: the single path every registered hook routes through.\n327\t#\n328\t# ## The rule: decision-derived, never exit-code-derived\n329\t#\n330\t#   emitted deny          -> exit 2   (a decision was made: enforce it)\n331\t#   emitted allow / {}    -> exit 0\n332\t#   crashed, NO decision  -> hook's own rc (fail-OPEN: the INFRASTRUCTURE\n333\t#                                     half of CLAUDE.md §4 — a missing\n334\t#                                     file, an ImportError, a timeout\n335\t#                                     must never block the user session)\n336\t#\n337\t# Reading the DECISION rather than the hook's exit code is what keeps\n338\t# those two apart: an input-class deny (a security matcher emitting a\n339\t# structured deny on a payload it cannot parse — the codex.py coherence\n340\t# gate pattern) exits 2, while a bare interpreter crash with no decision\n341\t# on stdout keeps its own (fail-open) code. A blanket \"nonzero -> deny\"\n342\t# remap would break the fail-open half and is explicitly NOT what this does.\n343\t#\n344\t# ## ADAPTER-AWARE: gated on CEO_HOOK_ADAPTER=grok (debate C14, per lacuna (h))\n345\t#\n346\t# The plan's Wave-2 conditional: \"UNCONDITIONAL mapping SAFE iff Wave-0\n347\t# lacuna (h) confirms exit 2 is INERT on Codex; if not, the mapping is\n348\t# adapter-aware.\" Lacuna (h) found exit 2 is NOT inert on Codex — it is an\n349\t# ACTIVE deny on PreToolUse (probe P9a). So the plan's own fork selects the\n350\t# adapter-aware branch: gate on grok, leave Claude/Codex byte-identical.\n351\t#\n352\t# This is not a weakening. On EVERY host the stdout JSON decision blocks on\n353\t# its own (grok P2, codex JSON-deny, claude JSON-block); the exit code is\n354\t# belt-and-suspenders. Remapping deny->2 on Codex/Claude would only change\n355\t# an observable exit code with no enforcement gain, while breaking every\n356\t# existing test that pins \"deny -> exit 0\" — a large blast radius for zero\n357\t# security benefit. The grok gate keeps the value (a future grok release\n358\t# that tightens the docs.x.ai \"deny REQUIRES exit 2\" rule is covered) where\n359\t# it belongs.\n360\t#\n361\t# R-SEC2 (unset adapter under grok → fail-open) is NOT solved by an\n362\t# unconditional EXIT map anyway: on grok a `block` with exit 2 STILL\n363\t# fail-opens (P5 — malformed output beats the exit code). It is solved by\n364\t# (1) the grok registration always setting CEO_HOOK_ADAPTER=grok — exactly\n365\t# as codex sets =codex — and (2) the CI test asserting every registration\n366\t# routes through this shim (hooks/tests/test_exit2_chokepoint.py). A named\n367\t# residual, identical in kind to the codex one.\n368\t#\n369\t# ## What this block does NOT do\n370\t#\n371\t# It does NOT rewrite the decision vocabulary here — the grok block->deny\n372\t# rewrite below (also grok-gated) is the ESSENTIAL fix, because grok\n373\t# fail-OPENs on `{\"decision\":\"block\"}` EVEN WITH exit 2 (probe P5). This\n374\t# exit map is the secondary half; the meta-test asserts BOTH.\n375\t#\n376\t# CEO_HOOK_EXIT_MAP=0 disables the mapping (escape hatch if a future grok\n377\t# release turns exit-2-hostile; the arming check surfaces the override).\n378\t\n379\t# The grok path has TWO halves with DIFFERENT disable semantics:\n380\t#   - vocabulary rewrite (block->deny): the ESSENTIAL grok fix — a `block`\n381\t#     fail-OPENs on grok (P4/P5). NOT disableable by CEO_HOOK_EXIT_MAP.\n382\t#   - exit-2 mapping (deny->exit 2): belt-and-suspenders. CEO_HOOK_EXIT_MAP=0\n383\t#     turns this off (a future grok release that makes exit-2 hostile).\n384\t# Both fire ONLY under CEO_HOOK_ADAPTER=grok on a BLOCKING event; every other\n385\t# path preserves the historical exec byte-for-byte (Claude/Codex unchanged).\n386\t_CEO_GROK_PATH=0\n387\tif [ \"${CEO_HOOK_ADAPTER:-}\" = \"grok\" ]; then\n388\t  _CEO_GROK_PATH=1\n389\tfi\n390\t\n391\t# Event source: under grok, GROK_HOOK_EVENT is the AUTHORITATIVE source (grok\n392\t# sets it). Pair-rail S269 finding #4: a generic\n393\t# `${CLAUDE_HOOK_EVENT:-${GROK_HOOK_EVENT:-…}}` precedence lets a stale/injected\n394\t# CLAUDE_HOOK_EVENT=post_tool_use mislabel a real grok pre_tool_use as passive\n395\t# and DISABLE the chokepoint (grok then fail-opens). Since this whole block is\n396\t# already gated on CEO_HOOK_ADAPTER=grok, read grok's own var first.\n397\t_CEO_EVENT=\"${GROK_HOOK_EVENT:-${CLAUDE_HOOK_EVENT:-${CODEX_HOOK_EVENT:-}}}\"\n398\t_CEO_BLOCKING_EVENT=1\n399\tcase \"$_CEO_EVENT\" in\n400\t  # Passive events (grok spells them snake_case). A passive hook can never\n401\t  # block on grok, so neither the rewrite nor the exit map should touch it.\n402\t  post_tool_use|post_tool_use_failure|session_start|session_end|\\\n403\t  notification|pre_compact|post_compact|subagent_start|subagent_stop|\\\n404\t  permission_denied|stop_failure|stop)\n405\t    _CEO_BLOCKING_EVENT=0\n406\t    ;;\n407\tesac\n408\t\n409\t# Registered hooks have invocation deadlines: exit must leave spool work pending.\n410\texport CEO_HOOK_BOUNDED_EXIT=1\n411\t\n412\tif [ \"$_CEO_GROK_PATH\" -eq 0 ] || [ \"$_CEO_BLOCKING_EVENT\" -eq 0 ]; then\n413\t  # Not the grok blocking path (Claude/Codex byte-identical to the historical\n414\t  # shim), or a passive grok event: preserve the historical exec (zero added\n415\t  # latency; exit = the hook's own).\n416\t  exec \"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\"\n417\tfi\n418\t\n419\t# Blocking event: capture stdout so the decision can drive the exit code.\n420\t# stderr passes through untouched (breadcrumbs stay visible to the host).\n421\t# `set -e` must not kill us on a nonzero hook exit — we inspect it.\n422\tset +e\n423\t_CEO_HOOK_STDOUT=\"$(\"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\")\"\n424\t_CEO_HOOK_RC=$?\n425\tset -e\n426\t\n427\t# --- grok vocabulary backstop (probe P5) ------------------------------------\n428\t#\n429\t# Hooks that route their egress through `_lib/adapters/resolve()` already\n430\t# emit `deny` under CEO_HOOK_ADAPTER=grok (grok.py:write_decision). But a\n431\t# LEGACY hook that hardcodes the Claude vocabulary — today\n432\t# `check_codex_filewrite.py`, which json.dumps `{\"decision\": \"block\"}`\n433\t# directly (lines 275/294/356) — would emit a word grok does not know.\n434\t# On grok that is malformed output = hook failure = **fail-OPEN, even\n435\t# with exit 2** (P5). Re-routing that hook through this shim (PLAN-156\n436\t# Wave 2 settings edit) gives it the exit mapping but NOT the vocabulary,\n437\t# so the shim translates here as well: one chokepoint owns BOTH halves,\n438\t# and any future hook that forgets the adapter seam degrades to a correct\n439\t# deny instead of a silent allow.\n440\t#\n441\t# We are guaranteed here to be on the grok blocking path. Rewrite block→deny\n442\t# with a WHITESPACE-TOLERANT regex (pair-rail S269 finding #3): the two\n443\t# fixed-string substitutions only matched json.dumps's exact spacing\n444\t# (`\"decision\": \"block\"` and `\"decision\":\"block\"`), so a hook emitting\n445\t# `\"decision\" : \"block\"` (space before the colon) would slip through and\n446\t# grok would fail-OPEN. `[[:space:]]*` around the colon covers any spacing.\n447\t# sed is one cheap subprocess on the (rare) blocking path — acceptable vs a\n448\t# silent-allow on an unusual-but-valid deny shape.\n449\tif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n450\t  _CEO_HOOK_STDOUT=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" \\\n451\t    | sed -E 's/\"decision\"[[:space:]]*:[[:space:]]*\"block\"/\"decision\": \"deny\"/g')\"\n452\tfi\n453\t\n454\t# NOTE (pair-rail R1 P1, S272): stdout is emitted AFTER the decision parse\n455\t# below, not here. On grok the JSON on stdout is the PRIMARY block; emitting a\n456\t# malformed deny-bearing payload first hands grok garbage (it fails open on it)\n457\t# and leaves only the secondary exit-2 rail — turning the belt-and-suspenders\n458\t# design into a single strap. The parse block decides, then emits: verbatim on\n459\t# every normal path, and a well-formed `{\"decision\":\"deny\"}` when the payload\n460\t# is unparseable BUT carries a deny token.\n461\t\n462\t# Exit-2 mapping (belt-and-suspenders; CEO_HOOK_EXIT_MAP=0 disables JUST this\n463\t# half, never the vocabulary rewrite above). After the rewrite the only deny\n464\t# vocabulary on stdout is grok's `deny` (or a codex-shaped permissionDecision\n465\t# from a legacy hook that also routed here).\n466\t#\n467\t# F6 (PLAN-156-FOLLOWUP, consensus C5 — security-VETO direction): the original\n468\t# mapping was an order-sensitive whole-stdout case glob\n469\t# (*'\"decision\"'*'\"deny\"'*), which mis-fires BOTH ways: an ALLOW payload whose\n470\t# other fields merely QUOTE a deny shape exited 2 (spurious block — the S270\n471\t# live-fire finding), and a first-occurrence variant would let a decoy nested\n472\t# `\"decision\":\"allow\"` mask a real top-level deny. Replaced with a STRUCTURAL\n473\t# parse of the TOP-LEVEL `decision` / `hookSpecificOutput.permissionDecision`\n474\t# via the already-resolved $FOUND_PY (one extra subprocess on the rare\n475\t# blocking path — cost accepted by the debate).\n476\t#\n477\t# Dual fail-direction semantics (NEVER \"nonzero -> deny\"):\n478\t#   parse OK      -> the FIELD governs: deny -> exit 2, anything else -> the\n479\t#                    hook's own rc below.\n480\t#   parse FAILURE -> deny token ('\"deny\"') present on stdout -> exit 2\n481\t#                    (fail-CLOSED: content the mapper cannot parse is never\n482\t#                    waved through when it may carry a real deny — the\n483\t#                    CLAUDE.md §4 INPUT half);\n484\t#                 -> no deny token -> the hook's own rc below (the\n485\t#                    INFRASTRUCTURE fail-open half, preserved: a crash or\n486\t#                    garbage with no decision never blocks the session).\n487\t# A crash with EMPTY stdout skips this block entirely -> hook rc (fail-open).\n488\tif [ \"${CEO_HOOK_EXIT_MAP:-1}\" = \"1\" ] && [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n489\t  _CEO_DECISION=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" | \"$FOUND_PY\" -c '\n490\timport json, sys\n491\t\n492\ttry:\n493\t    obj = json.load(sys.stdin)\n494\texcept Exception:\n495\t    print(\"__CEO_PARSE_FAILURE__\")\n496\t    raise SystemExit(0)\n497\tdecision = \"\"\n498\tif isinstance(obj, dict):\n499\t    d = obj.get(\"decision\")\n500\t    if isinstance(d, str):\n501\t        decision = d\n502\t    else:\n503\t        hso = obj.get(\"hookSpecificOutput\")\n504\t        if isinstance(hso, dict):\n505\t            pd = hso.get(\"permissionDecision\")\n506\t            if isinstance(pd, str):\n507\t                decision = pd\n508\tprint(decision)\n509\t' 2>/dev/null)\" || _CEO_DECISION=\"__CEO_PARSE_FAILURE__\"\n510\t  case \"$_CEO_DECISION\" in\n511\t    deny)\n512\t      # Structural top-level deny — emit the (valid) payload so the PRIMARY\n513\t      # stdout rail blocks, then enforce the secondary exit-2 rail.\n514\t      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n515\t      exit 2\n516\t      ;;\n517\t    __CEO_PARSE_FAILURE__)\n518\t      # Sentinel also covers the parser subprocess itself failing to spawn:\n519\t      # that infra failure degrades to the token scan, never to a silent allow\n520\t      # of a deny-bearing payload.\n521\t      case \"$_CEO_HOOK_STDOUT\" in\n522\t        *'\"deny\"'*)\n523\t          # Unparseable BUT deny-bearing: emitting the garbage would fail OPEN\n524\t          # on grok's primary rail. Emit a well-formed deny instead — both\n525\t          # rails now block. The original payload is preserved on stderr for\n526\t          # forensics (stderr never feeds the decision).\n527\t          printf '%s\\n' \"$_CEO_HOOK_STDOUT\" >&2\n528\t          printf '%s\\n' '{\"decision\": \"deny\", \"reason\": \"hook emitted an unparseable deny-bearing payload; blocked fail-CLOSED by _python-hook.sh (original payload on stderr)\"}'\n529\t          exit 2\n530\t          ;;\n531\t      esac\n532\t      # Unparseable and NO deny token: emit verbatim (a malformed allow is the\n533\t      # hook's own business) and fall through to its rc — INFRASTRUCTURE\n534\t      # fail-open half, preserved.\n535\t      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n536\t      ;;\n537\t    *)\n538\t      # Parsed, not a deny (allow / ask / absent) — emit verbatim.\n539\t      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n540\t      ;;\n541\t  esac\n542\telif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n543\t  # Exit-map disabled (CEO_HOOK_EXIT_MAP=0): the vocabulary rewrite above still\n544\t  # ran; emit the hook's stdout unchanged — the JSON rail is on its own.\n545\t  printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n546\tfi\n547\t\n548\texit \"$_CEO_HOOK_RC\"\n549\t"}]},"parent_tool_use_id":null,"session_id":"db09679d-5189-4158-a1d6-4bf6064c9841","uuid":"9104cbc3-e33c-459b-83e0-0b4b8953fa6e","timestamp":"2026-11-13T17:42:34.419Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_python-hook.sh","content":"#!/usr/bin/env bash\n# _python-hook.sh — Python version resolver + hook invoker.\n#\n# Registered in .claude/settings.json as the entrypoint for every Python\n# hook (check_agent_spawn.py, audit_log.py). Resolves `python3.12` →\n# `python3.11` → `python3.10` → `python3` and refuses anything below 3.9.\n#\n# ## Why a shim?\n#\n# `python3` on a user's $PATH is not hermetic:\n# - asdf / pyenv resolution is shell-dependent\n# - macOS system Python is 3.9 on older machines\n# - ubuntu-22.04 runners default to 3.10\n# - ubuntu-24.04 runners default to 3.12\n# - minimal containers may ship Python 3.8 or none at all\n#\n# Letting Claude Code run `python3 ...` directly lets a mis-resolved PATH\n# silently pick a version that can't run the hooks. The shim is explicit:\n# it looks for the newest Python 3.x ≥ 3.9 and refuses to continue if no\n# compatible interpreter is found. The refusal message points at install\n# commands so the Owner can fix it in one step.\n#\n# ## Minimum Python version\n#\n# **3.9** — the macOS system Python on Big Sur / Monterey. This is a\n# concession to reality: the original PLAN-002 §11-bis Q1 targeted 3.10\n# as minimum, but local dogfooding on this repo runs on 3.9.6 and\n# installing 3.10+ globally is out of scope for a framework that wants\n# to be \"clone and use\". All hook Python code is written with\n# `from __future__ import annotations` + `typing.Optional/Union` and\n# avoids match statements, so 3.9 is fully workable.\n#\n# ## Usage\n#\n# In settings.json:\n#     \"command\": \"bash \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\\\" check_agent_spawn.py\"\n#\n# The shim forwards stdin/stdout/stderr and passes any trailing args\n# through to the Python interpreter.\n\n# F-CHAOS-5 (PLAN-019) + PLAN-023 Phase F (F-perf-001): explicit Python\n# version gate, gated to the cache-miss branch only.\n#\n# Framework requires Python >=3.9 (ADR-002). Earlier versions silently\n# lack stdlib features (from __future__ import annotations, etc.).\n#\n# Pre PLAN-023 Phase F: _py_version_check() ran unconditionally at shim\n# entry, spawning a `python3 -c \"import sys...\"` subprocess every single\n# invocation (~15-20ms). Cache-hit paths paid this cost even though the\n# cached interpreter had already been validated on its first resolution.\n#\n# Post PLAN-023 Phase F: the check is called ONLY from the cache-miss\n# branch below (after CANDIDATES-loop probing). The cache file persists\n# a validated interpreter absolute path; a cache-hit restore implicitly\n# re-validates by invoking the cached binary for the hook itself. If the\n# cached binary has been uninstalled between invocations, the subsequent\n# hook invocation fails loud with the OS-level \"No such file\" — cleaner\n# signal than a silent version re-probe.\n_py_version_check() {\n  local ver\n  ver=$(python3 -c \"import sys; print(f\\\"{sys.version_info.major}.{sys.version_info.minor}\\\")\" 2>/dev/null) || {\n    echo \"ERROR: python3 not found or invocable. Framework requires Python >=3.9.\" >&2\n    exit 3\n  }\n  local major minor\n  major=${ver%.*}\n  minor=${ver#*.}\n  if [ \"$major\" -lt 3 ] || { [ \"$major\" -eq 3 ] && [ \"$minor\" -lt 9 ]; }; then\n    echo \"ERROR: Python $ver detected; framework requires >=3.9 (ADR-002).\" >&2\n    echo \"       Upgrade via your package manager and retry.\" >&2\n    exit 3\n  fi\n}\n# NOTE: call is deferred to the cache-miss branch below (see\n# `_py_version_check` call site inside the CANDIDATES loop). Intentionally\n# no call here — Phase F perf optimization.\n\n# PLAN-025 F-perf-dead-code-1: the earlier `_extract_session_id()`\n# helper (P3-SEC-M PLAN-019) had no callers in production paths and\n# was forking an extra `python3 -c` subprocess per invocation. Removed\n# in Batch K to reduce shim overhead. If session_id breadcrumbs ever\n# need to be extracted at shim level again, re-add with the Python\n# JSON-parse call INSIDE the existing per-invocation python3 spawn\n# (zero marginal cost) instead of a separate subprocess.\n\nset -euo pipefail\n\n# ---------------------------------------------------------------------------\n# PLAN-156 Wave 2 (SENT-GK-A) — grok adapter AUTO-DETECT (pair-rail S269 P1 #1).\n#\n# THE CRITICAL single-surface fix. The grok harness arms the legacy-compat\n# `.claude/settings.json`, whose hook commands do NOT carry\n# `env CEO_HOOK_ADAPTER=grok` (they are the Claude-native registrations —\n# adding it would break Claude Code, which shares the file). But grok delivers\n# a camelCase wire (`hookEventName`/`toolName`) to those hooks, so without the\n# adapter set they resolve to the CLAUDE adapter, which misparses the grok\n# wire → empty tool_name → the matcher-shaped guards no-op → ENFORCEMENT\n# SILENTLY FAILS (fail-open). The live-fire missed this because it set the env\n# by hand; the codex pair-rail caught it.\n#\n# Grok injects `GROK_HOOK_EVENT` (+ GROK_SESSION_ID / GROK_WORKSPACE_ROOT) on\n# EVERY hook it runs, and never sets CEO_HOOK_ADAPTER. So: if a grok runner\n# var is present and the adapter is unset, we ARE under grok — select it. This\n# is what makes the single-surface (`.claude/settings.json`) armed rail\n# actually enforce under grok. An explicit CEO_HOOK_ADAPTER always wins (tests,\n# codex, a deliberate override).\nif [ -z \"${CEO_HOOK_ADAPTER:-}\" ] && [ -n \"${GROK_HOOK_EVENT:-}${GROK_SESSION_ID:-}\" ]; then\n  export CEO_HOOK_ADAPTER=grok\nfi\n\nMIN_MAJOR=3\nMIN_MINOR=9\n\n# Preferred candidates, most-recent first.\nCANDIDATES=(\n  \"python3.13\"\n  \"python3.12\"\n  \"python3.11\"\n  \"python3.10\"\n  \"python3.9\"\n  \"python3\"\n)\n\n# PLAN-019 Perf-P2-002 — resolved-interpreter cache.\n#\n# Measured overhead pre-optimization: ~24ms p50 (on a box where only\n# `python3` exists, 5 `command -v` failures + 1 spawn of `python -c\n# \"import sys; print(...)\"` for version probe). Hot-path cost dominated\n# by the version-probe subprocess.\n#\n# Optimization: cache the resolved interpreter path + PATH hash in a\n# per-user tempfile. On cache-hit with matching PATH signature, skip the\n# probing loop entirely. Cache invalidates automatically when the user's\n# PATH changes (e.g. `brew install python@3.12`) so the freshest\n# interpreter is picked up without manual eviction.\n#\n# Expected post-fix overhead: ~2ms (single `stat` + read of cache file).\n#\n# Security: cache file lives under $TMPDIR (or /tmp) with user-scoped\n# path, so a rogue cache from another user cannot hijack. The cached\n# path is only USED if the interpreter still exists + reports the same\n# version. Fail-safe: cache miss falls back to the full probe.\n_cache_dir() {\n  local base=\"${TMPDIR:-/tmp}\"\n  # Strip trailing slash for consistent path construction.\n  base=\"${base%/}\"\n  echo \"${base}/ceo-pyhook-$(id -u)\"\n}\n_path_hash() {\n  # Fast-ish, deterministic hash of the current $PATH. Prefer shasum\n  # (macOS); fall back to sha256sum (Linux); fall back to cksum (POSIX)\n  # if neither is available (content differs but is still deterministic).\n  if command -v shasum >/dev/null 2>&1; then\n    printf '%s' \"$PATH\" | shasum -a 256 | cut -c1-16\n  elif command -v sha256sum >/dev/null 2>&1; then\n    printf '%s' \"$PATH\" | sha256sum | cut -c1-16\n  else\n    printf '%s' \"$PATH\" | cksum | cut -d' ' -f1\n  fi\n}\n\n# PLAN-152 security-01 — cache trust gate (TOCTOU / symlink hardening).\n#\n# The cached interpreter path is READ from $TMPDIR and later EXEC'd; under\n# a shared /tmp another local user could pre-create the cache dir (or swap\n# in a symlink) and plant an interpreter path of their choosing, and a\n# symlinked cache DIR would additionally redirect the cache WRITE into an\n# attacker-chosen location. Before any read or write we therefore require:\n# the cache dir is a real directory (not a symlink) owned by the current\n# uid, and the cache file (when present) is a regular non-symlink file\n# owned by the current uid. Any failed check = cache miss (fall back to\n# the full probe) — never a hard failure.\n_owner_uid() {\n  # GNU stat first (Linux); BSD stat fallback (macOS).\n  stat -c '%u' \"$1\" 2>/dev/null || stat -f '%u' \"$1\" 2>/dev/null\n}\n_perm_bits() {\n  # Octal permission bits (low bits only): GNU '%a' / BSD '%Lp'.\n  stat -c '%a' \"$1\" 2>/dev/null || stat -f '%Lp' \"$1\" 2>/dev/null\n}\n_dir_mode_safe() {\n  # PLAN-152 security-01 P2 (Codex R2): reject a group/other-writable\n  # cache dir. A user-owned but world/group-writable dir lets another\n  # local user swap the cache file between the trust check and the read\n  # (TOCTOU), restoring the interpreter-hijack this gate closes.\n  local m\n  m=\"$(_perm_bits \"$1\")\" || return 1\n  [ -n \"$m\" ] && [ \"$(( 0${m} & 022 ))\" -eq 0 ]\n}\n_cache_dir_trusted() {\n  [ ! -L \"$_CACHE_DIR\" ] && [ -d \"$_CACHE_DIR\" ] \\\n    && [ \"$(_owner_uid \"$_CACHE_DIR\")\" = \"$_CUR_UID\" ] \\\n    && _dir_mode_safe \"$_CACHE_DIR\"\n}\n_cache_file_trusted() {\n  [ ! -L \"$_CACHE_FILE\" ] && [ -f \"$_CACHE_FILE\" ] \\\n    && [ \"$(_owner_uid \"$_CACHE_FILE\")\" = \"$_CUR_UID\" ]\n}\n\nparse_version() {\n  # Emit \"MAJOR MINOR\" from `python --version` output (e.g. \"Python 3.12.3\")\n  local py=\"$1\"\n  \"$py\" -c 'import sys; print(sys.version_info[0], sys.version_info[1])' 2>/dev/null\n}\n\nversion_ok() {\n  # Accepts \"MAJOR MINOR\"; returns 0 if ≥ MIN, else 1.\n  local major=\"$1\" minor=\"$2\"\n  if [ \"$major\" -lt \"$MIN_MAJOR\" ]; then\n    return 1\n  fi\n  if [ \"$major\" -eq \"$MIN_MAJOR\" ] && [ \"$minor\" -lt \"$MIN_MINOR\" ]; then\n    return 1\n  fi\n  return 0\n}\n\n# ---- Cache lookup (fast path) ----\nFOUND_PY=\"\"\n_CUR_UID=\"$(id -u)\"\n_CACHE_DIR=\"$(_cache_dir)\"\n_PATH_SIG=\"$(_path_hash 2>/dev/null || echo \"nohash\")\"\n_CACHE_FILE=\"${_CACHE_DIR}/resolved-py-${_PATH_SIG}\"\n\n# Honour CEO_PYHOOK_NO_CACHE=1 to force re-probe (useful for testing\n# the fallback path or after installing a new interpreter mid-session).\n# PLAN-152 security-01: the dir + file trust gates (ownership, no\n# symlinks) run BEFORE the read — an untrusted cache is a cache MISS.\nif [ \"${CEO_PYHOOK_NO_CACHE:-0}\" != \"1\" ] && _cache_dir_trusted \\\n    && _cache_file_trusted && [ -r \"$_CACHE_FILE\" ]; then\n  _cached_py=\"$(cat \"$_CACHE_FILE\" 2>/dev/null || echo \"\")\"\n  if [ -n \"$_cached_py\" ] && command -v \"$_cached_py\" >/dev/null 2>&1; then\n    # Trust the cache: PATH-hash changes would have produced a different\n    # cache filename, and the interpreter path still resolves. No version\n    # recheck needed on hot path.\n    FOUND_PY=\"$_cached_py\"\n  fi\nfi\n\n# ---- Cache miss: full probe + repopulate ----\nif [ -z \"$FOUND_PY\" ]; then\n  # PLAN-023 Phase F (F-perf-001): run the baseline Python≥3.9 gate ONLY\n  # in the cache-miss branch. The gate's `python3 -c ...` spawn is ~15-20ms\n  # that cache-hit paths no longer pay. The gate still fires on every\n  # first-time or PATH-changed invocation, which is the only time a new\n  # interpreter could appear.\n  _py_version_check\n\n  for candidate in \"${CANDIDATES[@]}\"; do\n    if command -v \"$candidate\" >/dev/null 2>&1; then\n      read -r py_major py_minor <<< \"$(parse_version \"$candidate\")\"\n      if [ -n \"${py_major:-}\" ] && version_ok \"$py_major\" \"$py_minor\"; then\n        FOUND_PY=\"$candidate\"\n        break\n      fi\n    fi\n  done\n\n  # Cache the result for next invocation (atomic write via mv).\n  if [ -n \"$FOUND_PY\" ]; then\n    # mkdir is idempotent + concurrent-safe (-p). Set 0700 so another\n    # unix user on the host cannot read or replace the cache.\n    # PLAN-152 security-01: never write through a symlinked or foreign-\n    # owned cache dir (symlink-redirect write primitive).\n    # Order matters (PLAN-152 security-01 P2): reject a symlinked dir\n    # BEFORE chmod (never chmod an attacker's symlink target), then chmod\n    # 0700 to normalize the mode under a loose umask, THEN the full trust\n    # check (owner + non-symlink + no group/other write).\n    if mkdir -p \"$_CACHE_DIR\" 2>/dev/null && [ ! -L \"$_CACHE_DIR\" ] \\\n        && chmod 0700 \"$_CACHE_DIR\" 2>/dev/null && _cache_dir_trusted; then\n      _tmp_cache=\"${_CACHE_FILE}.$$\"\n      if printf '%s\\n' \"$FOUND_PY\" > \"$_tmp_cache\" 2>/dev/null; then\n        mv -f \"$_tmp_cache\" \"$_CACHE_FILE\" 2>/dev/null || rm -f \"$_tmp_cache\" 2>/dev/null\n      fi\n    fi\n  fi\nfi\n\nif [ -z \"$FOUND_PY\" ]; then\n  cat >&2 <<EOF\n[_python-hook.sh] ERROR: No Python >= ${MIN_MAJOR}.${MIN_MINOR} found.\nceo-orchestration hooks require Python ${MIN_MAJOR}.${MIN_MINOR}+. Install one:\n\n  macOS:   brew install python@3.12\n  Ubuntu:  sudo apt install python3.12\n  Fedora:  sudo dnf install python3.12\n\nAfter installing, restart your shell so the PATH picks up the new interpreter.\nEOF\n  # Fail-open: emit a permissive decision so the user session isn't bricked\n  # if Python is missing. The governance hook degrades gracefully.\n  echo '{}'  # schema-compliant allow\n  exit 0\nfi\n\n# First positional arg is the hook script name (relative to this dir).\nHOOKS_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\nif [ $# -lt 1 ]; then\n  echo \"[_python-hook.sh] ERROR: missing hook script name\" >&2\n  echo '{}'  # schema-compliant allow\n  exit 0\nfi\n\nHOOK_SCRIPT=\"$HOOKS_DIR/$1\"\nshift\n\nif [ ! -f \"$HOOK_SCRIPT\" ]; then\n  echo \"[_python-hook.sh] ERROR: hook not found: $HOOK_SCRIPT\" >&2\n  echo '{}'  # schema-compliant allow\n  exit 0\nfi\n\n# ---------------------------------------------------------------------------\n# PLAN-156 Wave 2 (SENT-GK-A) — decision→exit chokepoint.\n#\n# ## Why the shim owns this\n#\n# Grok Build's PreToolUse contract (grok 0.2.93) and Codex's both key a\n# deny on **exit 2** in addition to the stdout JSON (probes:\n# PLAN-156/artifacts/characterization-grok-codex-S269.md). Before this\n# block, deny-emit and process-exit were DECOUPLED: `write_decision` only\n# wrote stdout and the shim `exec`'d the hook, so the hook's own exit 0\n# became the process exit — a correct deny could still fail OPEN on a\n# host that keys on the code. The mapping cannot live in Python (an\n# interpreter crash / ImportError / signal never reaches Python), so it\n# lives HERE: the single path every registered hook routes through.\n#\n# ## The rule: decision-derived, never exit-code-derived\n#\n#   emitted deny          -> exit 2   (a decision was made: enforce it)\n#   emitted allow / {}    -> exit 0\n#   crashed, NO decision  -> hook's own rc (fail-OPEN: the INFRASTRUCTURE\n#                                     half of CLAUDE.md §4 — a missing\n#                                     file, an ImportError, a timeout\n#                                     must never block the user session)\n#\n# Reading the DECISION rather than the hook's exit code is what keeps\n# those two apart: an input-class deny (a security matcher emitting a\n# structured deny on a payload it cannot parse — the codex.py coherence\n# gate pattern) exits 2, while a bare interpreter crash with no decision\n# on stdout keeps its own (fail-open) code. A blanket \"nonzero -> deny\"\n# remap would break the fail-open half and is explicitly NOT what this does.\n#\n# ## ADAPTER-AWARE: gated on CEO_HOOK_ADAPTER=grok (debate C14, per lacuna (h))\n#\n# The plan's Wave-2 conditional: \"UNCONDITIONAL mapping SAFE iff Wave-0\n# lacuna (h) confirms exit 2 is INERT on Codex; if not, the mapping is\n# adapter-aware.\" Lacuna (h) found exit 2 is NOT inert on Codex — it is an\n# ACTIVE deny on PreToolUse (probe P9a). So the plan's own fork selects the\n# adapter-aware branch: gate on grok, leave Claude/Codex byte-identical.\n#\n# This is not a weakening. On EVERY host the stdout JSON decision blocks on\n# its own (grok P2, codex JSON-deny, claude JSON-block); the exit code is\n# belt-and-suspenders. Remapping deny->2 on Codex/Claude would only change\n# an observable exit code with no enforcement gain, while breaking every\n# existing test that pins \"deny -> exit 0\" — a large blast radius for zero\n# security benefit. The grok gate keeps the value (a future grok release\n# that tightens the docs.x.ai \"deny REQUIRES exit 2\" rule is covered) where\n# it belongs.\n#\n# R-SEC2 (unset adapter under grok → fail-open) is NOT solved by an\n# unconditional EXIT map anyway: on grok a `block` with exit 2 STILL\n# fail-opens (P5 — malformed output beats the exit code). It is solved by\n# (1) the grok registration always setting CEO_HOOK_ADAPTER=grok — exactly\n# as codex sets =codex — and (2) the CI test asserting every registration\n# routes through this shim (hooks/tests/test_exit2_chokepoint.py). A named\n# residual, identical in kind to the codex one.\n#\n# ## What this block does NOT do\n#\n# It does NOT rewrite the decision vocabulary here — the grok block->deny\n# rewrite below (also grok-gated) is the ESSENTIAL fix, because grok\n# fail-OPENs on `{\"decision\":\"block\"}` EVEN WITH exit 2 (probe P5). This\n# exit map is the secondary half; the meta-test asserts BOTH.\n#\n# CEO_HOOK_EXIT_MAP=0 disables the mapping (escape hatch if a future grok\n# release turns exit-2-hostile; the arming check surfaces the override).\n\n# The grok path has TWO halves with DIFFERENT disable semantics:\n#   - vocabulary rewrite (block->deny): the ESSENTIAL grok fix — a `block`\n#     fail-OPENs on grok (P4/P5). NOT disableable by CEO_HOOK_EXIT_MAP.\n#   - exit-2 mapping (deny->exit 2): belt-and-suspenders. CEO_HOOK_EXIT_MAP=0\n#     turns this off (a future grok release that makes exit-2 hostile).\n# Both fire ONLY under CEO_HOOK_ADAPTER=grok on a BLOCKING event; every other\n# path preserves the historical exec byte-for-byte (Claude/Codex unchanged).\n_CEO_GROK_PATH=0\nif [ \"${CEO_HOOK_ADAPTER:-}\" = \"grok\" ]; then\n  _CEO_GROK_PATH=1\nfi\n\n# Event source: under grok, GROK_HOOK_EVENT is the AUTHORITATIVE source (grok\n# sets it). Pair-rail S269 finding #4: a generic\n# `${CLAUDE_HOOK_EVENT:-${GROK_HOOK_EVENT:-…}}` precedence lets a stale/injected\n# CLAUDE_HOOK_EVENT=post_tool_use mislabel a real grok pre_tool_use as passive\n# and DISABLE the chokepoint (grok then fail-opens). Since this whole block is\n# already gated on CEO_HOOK_ADAPTER=grok, read grok's own var first.\n_CEO_EVENT=\"${GROK_HOOK_EVENT:-${CLAUDE_HOOK_EVENT:-${CODEX_HOOK_EVENT:-}}}\"\n_CEO_BLOCKING_EVENT=1\ncase \"$_CEO_EVENT\" in\n  # Passive events (grok spells them snake_case). A passive hook can never\n  # block on grok, so neither the rewrite nor the exit map should touch it.\n  post_tool_use|post_tool_use_failure|session_start|session_end|\\\n  notification|pre_compact|post_compact|subagent_start|subagent_stop|\\\n  permission_denied|stop_failure|stop)\n    _CEO_BLOCKING_EVENT=0\n    ;;\nesac\n\n# Registered hooks have invocation deadlines: exit must leave spool work pending.\nexport CEO_HOOK_BOUNDED_EXIT=1\n\nif [ \"$_CEO_GROK_PATH\" -eq 0 ] || [ \"$_CEO_BLOCKING_EVENT\" -eq 0 ]; then\n  # Not the grok blocking path (Claude/Codex byte-identical to the historical\n  # shim), or a passive grok event: preserve the historical exec (zero added\n  # latency; exit = the hook's own).\n  exec \"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\"\nfi\n\n# Blocking event: capture stdout so the decision can drive the exit code.\n# stderr passes through untouched (breadcrumbs stay visible to the host).\n# `set -e` must not kill us on a nonzero hook exit — we inspect it.\nset +e\n_CEO_HOOK_STDOUT=\"$(\"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\")\"\n_CEO_HOOK_RC=$?\nset -e\n\n# --- grok vocabulary backstop (probe P5) ------------------------------------\n#\n# Hooks that route their egress through `_lib/adapters/resolve()` already\n# emit `deny` under CEO_HOOK_ADAPTER=grok (grok.py:write_decision). But a\n# LEGACY hook that hardcodes the Claude vocabulary — today\n# `check_codex_filewrite.py`, which json.dumps `{\"decision\": \"block\"}`\n# directly (lines 275/294/356) — would emit a word grok does not know.\n# On grok that is malformed output = hook failure = **fail-OPEN, even\n# with exit 2** (P5). Re-routing that hook through this shim (PLAN-156\n# Wave 2 settings edit) gives it the exit mapping but NOT the vocabulary,\n# so the shim translates here as well: one chokepoint owns BOTH halves,\n# and any future hook that forgets the adapter seam degrades to a correct\n# deny instead of a silent allow.\n#\n# We are guaranteed here to be on the grok blocking path. Rewrite block→deny\n# with a WHITESPACE-TOLERANT regex (pair-rail S269 finding #3): the two\n# fixed-string substitutions only matched json.dumps's exact spacing\n# (`\"decision\": \"block\"` and `\"decision\":\"block\"`), so a hook emitting\n# `\"decision\" : \"block\"` (space before the colon) would slip through and\n# grok would fail-OPEN. `[[:space:]]*` around the colon covers any spacing.\n# sed is one cheap subprocess on the (rare) blocking path — acceptable vs a\n# silent-allow on an unusual-but-valid deny shape.\nif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n  _CEO_HOOK_STDOUT=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" \\\n    | sed -E 's/\"decision\"[[:space:]]*:[[:space:]]*\"block\"/\"decision\": \"deny\"/g')\"\nfi\n\n# NOTE (pair-rail R1 P1, S272): stdout is emitted AFTER the decision parse\n# below, not here. On grok the JSON on stdout is the PRIMARY block; emitting a\n# malformed deny-bearing payload first hands grok garbage (it fails open on it)\n# and leaves only the secondary exit-2 rail — turning the belt-and-suspenders\n# design into a single strap. The parse block decides, then emits: verbatim on\n# every normal path, and a well-formed `{\"decision\":\"deny\"}` when the payload\n# is unparseable BUT carries a deny token.\n\n# Exit-2 mapping (belt-and-suspenders; CEO_HOOK_EXIT_MAP=0 disables JUST this\n# half, never the vocabulary rewrite above). After the rewrite the only deny\n# vocabulary on stdout is grok's `deny` (or a codex-shaped permissionDecision\n# from a legacy hook that also routed here).\n#\n# F6 (PLAN-156-FOLLOWUP, consensus C5 — security-VETO direction): the original\n# mapping was an order-sensitive whole-stdout case glob\n# (*'\"decision\"'*'\"deny\"'*), which mis-fires BOTH ways: an ALLOW payload whose\n# other fields merely QUOTE a deny shape exited 2 (spurious block — the S270\n# live-fire finding), and a first-occurrence variant would let a decoy nested\n# `\"decision\":\"allow\"` mask a real top-level deny. Replaced with a STRUCTURAL\n# parse of the TOP-LEVEL `decision` / `hookSpecificOutput.permissionDecision`\n# via the already-resolved $FOUND_PY (one extra subprocess on the rare\n# blocking path — cost accepted by the debate).\n#\n# Dual fail-direction semantics (NEVER \"nonzero -> deny\"):\n#   parse OK      -> the FIELD governs: deny -> exit 2, anything else -> the\n#                    hook's own rc below.\n#   parse FAILURE -> deny token ('\"deny\"') present on stdout -> exit 2\n#                    (fail-CLOSED: content the mapper cannot parse is never\n#                    waved through when it may carry a real deny — the\n#                    CLAUDE.md §4 INPUT half);\n#                 -> no deny token -> the hook's own rc below (the\n#                    INFRASTRUCTURE fail-open half, preserved: a crash or\n#                    garbage with no decision never blocks the session).\n# A crash with EMPTY stdout skips this block entirely -> hook rc (fail-open).\nif [ \"${CEO_HOOK_EXIT_MAP:-1}\" = \"1\" ] && [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n  _CEO_DECISION=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" | \"$FOUND_PY\" -c '\nimport json, sys\n\ntry:\n    obj = json.load(sys.stdin)\nexcept Exception:\n    print(\"__CEO_PARSE_FAILURE__\")\n    raise SystemExit(0)\ndecision = \"\"\nif isinstance(obj, dict):\n    d = obj.get(\"decision\")\n    if isinstance(d, str):\n        decision = d\n    else:\n        hso = obj.get(\"hookSpecificOutput\")\n        if isinstance(hso, dict):\n            pd = hso.get(\"permissionDecision\")\n            if isinstance(pd, str):\n                decision = pd\nprint(decision)\n' 2>/dev/null)\" || _CEO_DECISION=\"__CEO_PARSE_FAILURE__\"\n  case \"$_CEO_DECISION\" in\n    deny)\n      # Structural top-level deny — emit the (valid) payload so the PRIMARY\n      # stdout rail blocks, then enforce the secondary exit-2 rail.\n      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n      exit 2\n      ;;\n    __CEO_PARSE_FAILURE__)\n      # Sentinel also covers the parser subprocess itself failing to spawn:\n      # that infra failure degrades to the token scan, never to a silent allow\n      # of a deny-bearing payload.\n      case \"$_CEO_HOOK_STDOUT\" in\n        *'\"deny\"'*)\n          # Unparseable BUT deny-bearing: emitting the garbage would fail OPEN\n          # on grok's primary rail. Emit a well-formed deny instead — both\n          # rails now block. The original payload is preserved on stderr for\n          # forensics (stderr never feeds the decision).\n          printf '%s\\n' \"$_CEO_HOOK_STDOUT\" >&2\n          printf '%s\\n' '{\"decision\": \"deny\", \"reason\": \"hook emitted an unparseable deny-bearing payload; blocked fail-CLOSED by _python-hook.sh (original payload on stderr)\"}'\n          exit 2\n          ;;\n      esac\n      # Unparseable and NO deny token: emit verbatim (a malformed allow is the\n      # hook's own business) and fall through to its rc — INFRASTRUCTURE\n      # fail-open half, preserved.\n      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n      ;;\n    *)\n      # Parsed, not a deny (allow / ask / absent) — emit verbatim.\n      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n      ;;\n  esac\nelif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n  # Exit-map disabled (CEO_HOOK_EXIT_MAP=0): the vocabulary rewrite above still\n  # ran; emit the hook's stdout unchanged — the JSON rail is on its own.\n  printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\nfi\n\nexit \"$_CEO_HOOK_RC\"\n","numLines":549,"startLine":1,"totalLines":549}},"tool_result_meta":[{"id":"toolu_01DKHTe2MYgz3yxD5N8XaLGe","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
