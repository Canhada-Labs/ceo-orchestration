{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012cqKgrC1crvrsZbthLvQyh","type":"tool_result","content":"1\t\"\"\"Components shared by the ``check_agent_spawn`` hook.\n2\t\n3\tThe package deliberately lives below ``_lib`` so hook inventory counters do\n4\tnot mistake its modules for independently registered hook entry points.\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\tfrom types import FunctionType\n9\t\n10\tfrom . import file_assignment, skill_reference\n11\t\n12\t\n13\tdef bind(namespace: dict) -> None:\n14\t    \"\"\"Preserve legacy mutable globals without copying state between calls.\"\"\"\n15\t    for component in (skill_reference, file_assignment):\n16\t        for name in component.__all__:\n17\t            original = getattr(component, name)\n18\t            if not isinstance(original, FunctionType):\n19\t                namespace[name] = original\n20\t                continue\n21\t            bound = FunctionType(\n22\t                original.__code__, namespace, original.__name__,\n23\t                original.__defaults__, original.__closure__,\n24\t            )\n25\t            bound.__kwdefaults__ = original.__kwdefaults__\n26\t            bound.__annotations__ = original.__annotations__.copy()\n27\t            bound.__dict__.update(original.__dict__)\n28\t            bound.__doc__ = original.__doc__\n29\t            bound.__qualname__ = original.__qualname__\n30\t            bound.__module__ = namespace[\"__name__\"]\n31\t            namespace[name] = bound\n32\t"}]},"parent_tool_use_id":null,"session_id":"59b5611e-09e0-46d4-995f-7512413afb4d","uuid":"f2a4f926-dcb3-480f-b966-a523f851eb9f","timestamp":"2026-11-13T17:14:10.386Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/__init__.py","content":"\"\"\"Components shared by the ``check_agent_spawn`` hook.\n\nThe package deliberately lives below ``_lib`` so hook inventory counters do\nnot mistake its modules for independently registered hook entry points.\n\"\"\"\nfrom __future__ import annotations\n\nfrom types import FunctionType\n\nfrom . import file_assignment, skill_reference\n\n\ndef bind(namespace: dict) -> None:\n    \"\"\"Preserve legacy mutable globals without copying state between calls.\"\"\"\n    for component in (skill_reference, file_assignment):\n        for name in component.__all__:\n            original = getattr(component, name)\n            if not isinstance(original, FunctionType):\n                namespace[name] = original\n                continue\n            bound = FunctionType(\n                original.__code__, namespace, original.__name__,\n                original.__defaults__, original.__closure__,\n            )\n            bound.__kwdefaults__ = original.__kwdefaults__\n            bound.__annotations__ = original.__annotations__.copy()\n            bound.__dict__.update(original.__dict__)\n            bound.__doc__ = original.__doc__\n            bound.__qualname__ = original.__qualname__\n            bound.__module__ = namespace[\"__name__\"]\n            namespace[name] = bound\n","numLines":32,"startLine":1,"totalLines":32}},"tool_result_meta":[{"id":"toolu_012cqKgrC1crvrsZbthLvQyh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
