{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019uJg2P9qXvKXGgreiWsbNw","type":"tool_result","content":"2200\t                min(len(path_hashes), 99)\n2201\t                if path_count is None else max(0, min(int(path_count), 99))\n2202\t            ),\n2203\t        )\n2204\t    except Exception:  # pragma: no cover - fail-open\n2205\t        return\n2206\t\n2207\t\n2208\t# ---------------------------------------------------------------------------\n2209\t# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [BEGIN]\n2210\t# ---------------------------------------------------------------------------\n2211\t# NAMED spawns whose task indicates contact with UNTRUSTED CONTENT (web\n2212\t# fetch/search, scraping, imported/upstream/third-party material) MUST carry\n2213\t# the 6-bullet `## PROMPT DEFENSE` anti-injection block that\n2214\t# `.claude/scripts/inject-agent-context.sh` now emits unconditionally.\n2215\t#\n2216\t# Failure semantics (CLAUDE.md §4 doctrine):\n2217\t#   - INPUT side is fail-CLOSED: heuristic matched + section missing/thin\n2218\t#     => BLOCK (precedent: check_bash_safety.py `_e3` parse gate + C4).\n2219\t#   - INFRASTRUCTURE side is fail-OPEN: any exception inside this gate\n2220\t#     => allow (never punish the session for our own bug).\n2221\t#\n2222\t# Detection is a CONSERVATIVE lowercase-substring keyword set scanned over\n2223\t# the sanitized (fence/comment-stripped) description + prompt. HONESTY —\n2224\t# documented false negatives, by design:\n2225\t#   - synonyms/other languages are missed (\"crawl\", \"harvest\", \"baixar\",\n2226\t#     \"read the vendor tarball\", ...);\n2227\t#   - obfuscated intents (base64, hyphenation, l33t) are missed;\n2228\t#   - keywords appearing ONLY inside fenced code blocks are masked by\n2229\t#     `_strip_fenced_and_comments` and therefore missed;\n2230\t#   - scan is capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes; mentions beyond\n2231\t#     the cap are missed.\n2232\t# The cheap mitigation for every miss-class is the same: the spawn template\n2233\t# emits the block UNCONDITIONALLY, so any template-generated prompt passes\n2234\t# regardless of heuristic reach. This gate exists to catch hand-rolled\n2235\t# prompts that bypass the template.\n2236\t#\n2237\t# Kill-switches (advisory demotion — event still emitted, spawn allowed):\n2238\t#   CEO_PROMPT_DEFENSE_GATE=0   per-gate opt-out\n2239\t#   CEO_SOTA_DISABLE=1          master kill (E3-rail precedent)\n2240\t_PROMPT_DEFENSE_HEADER_RE = re.compile(\n2241\t    r\"^##[ \\t]+PROMPT[ \\t]+DEFENSE[ \\t]*$\",\n2242\t    flags=re.MULTILINE,\n2243\t)\n2244\t# A bullet line: \"-\" or \"*\" + whitespace + at least one non-space char.\n2245\t_PROMPT_DEFENSE_BULLET_RE = re.compile(\n2246\t    r\"^[ \\t]*[-*][ \\t]+\\S\",\n2247\t    flags=re.MULTILINE,\n2248\t)\n2249\t_PROMPT_DEFENSE_MIN_BULLETS = 6\n2250\t_PROMPT_DEFENSE_SCAN_CAP = 256 * 1024  # bytes of sanitized text scanned\n2251\t# Closed, lowercase substring set. Ordering = report priority (first hit\n2252\t# wins; the matched token is the ONLY prompt-derived value that reaches the\n2253\t# audit log — closed-enum-safe, no prompt body echo).\n2254\t_UNTRUSTED_CONTENT_HINTS: Tuple[str, ...] = (\n2255\t    \"webfetch\",\n2256\t    \"websearch\",\n2257\t    \"web search\",\n2258\t    \"search the web\",\n2259\t    \"fetch the url\",\n2260\t    \"fetch url\",\n2261\t    \"fetch http\",\n2262\t    \"download from http\",\n2263\t    \"scrape\",\n2264\t    \"scraping\",\n2265\t    \"imported\",\n2266\t    \"upstream\",\n2267\t    \"third-party\",\n2268\t    \"third party\",\n2269\t    \"untrusted\",\n2270\t)\n2271\t\n2272\t\n2273\tdef _prompt_defense_required(\n2274\t    description: str, prompt_sanitized: str\n2275\t) -> Optional[str]:\n2276\t    \"\"\"Return the first matched untrusted-content hint, or None.\n2277\t\n2278\t    Pure. Never raises. Bounded scan over lowercase(description + sanitized\n2279\t    prompt) capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes.\n2280\t    \"\"\"\n2281\t    haystack = (\n2282\t        (description or \"\") + \"\\n\" + (prompt_sanitized or \"\")\n2283\t    )[:_PROMPT_DEFENSE_SCAN_CAP].lower()\n2284\t    for hint in _UNTRUSTED_CONTENT_HINTS:\n2285\t        if hint in haystack:\n2286\t            return hint\n2287\t    return None\n2288\t\n2289\t\n2290\tdef _has_prompt_defense_block(prompt_sanitized: str) -> bool:\n2291\t    \"\"\"True iff sanitized prompt has `## PROMPT DEFENSE` on its own line\n2292\t    with >= `_PROMPT_DEFENSE_MIN_BULLETS` bullet lines before the next\n2293\t    `##` heading / EOF. Fence/comment-masked headers do NOT count\n2294\t    (P1-SEC-B precedent — caller passes pre-sanitized text).\"\"\"\n2295\t    if not prompt_sanitized:\n2296\t        return False\n2297\t    m = _PROMPT_DEFENSE_HEADER_RE.search(prompt_sanitized)\n2298\t    if m is None:\n2299\t        return False\n2300\t    block_start = m.end()\n2301\t    nxt = _NEXT_H2_RE.search(prompt_sanitized, block_start)\n2302\t    block = prompt_sanitized[\n2303\t        block_start: nxt.start() if nxt else len(prompt_sanitized)\n2304\t    ]\n2305\t    bullets = len(_PROMPT_DEFENSE_BULLET_RE.findall(block))\n2306\t    return bullets >= _PROMPT_DEFENSE_MIN_BULLETS\n2307\t\n2308\t\n2309\tdef _emit_prompt_defense_event(\n2310\t    *, keyword: str, present: bool, enforced: bool\n2311\t) -> None:\n2312\t    \"\"\"Emit `spawn_prompt_defense_gate` telemetry. `keyword` is from the\n2313\t    closed `_UNTRUSTED_CONTENT_HINTS` enum — no prompt body ever persists.\n2314\t    Fail-open.\"\"\"\n2315\t    try:\n2316\t        if not _AUDIT_EMIT_AVAILABLE:\n2317\t            return\n2318\t        _audit_emit.emit_generic(\n2319\t            \"spawn_prompt_defense_gate\",\n2320\t            keyword=(keyword or \"\")[:32],\n2321\t            present=1 if present else 0,\n2322\t            enforced=1 if enforced else 0,\n2323\t        )\n2324\t    except Exception:  # pragma: no cover - fail-open\n2325\t        return\n2326\t\n2327\t\n2328\tdef _enforce_prompt_defense(\n2329\t    *,\n2330\t    description: str,\n2331\t    prompt: str,\n2332\t    env: Dict[str, str],\n2333\t) -> Optional[Tuple[str, str]]:\n2334\t    \"\"\"Evaluate the Prompt Defense Baseline gate for a NAMED spawn.\n2335\t\n2336\t    Returns (reason_code, detail) when the gate is ENFORCING and fires;\n2337\t    None otherwise. NEVER raises (infra fail-open); the block itself is\n2338\t    the input-side fail-CLOSED posture (matched + missing => BLOCK).\n2339\t    \"\"\"\n2340\t    try:\n2341\t        sanitized = _strip_fenced_and_comments(prompt or \"\")\n2342\t        keyword = _prompt_defense_required(description or \"\", sanitized)\n2343\t        if keyword is None:\n2344\t            return None  # no untrusted-content signal — out of scope\n2345\t        present = _has_prompt_defense_block(sanitized)\n2346\t        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n2347\t        raw = (env.get(\"CEO_PROMPT_DEFENSE_GATE\") or \"\").strip()\n2348\t        gate_off = raw in (\"0\", \"false\", \"False\", \"no\", \"off\")\n2349\t        enforced = (not master_off) and (not gate_off)\n2350\t        _emit_prompt_defense_event(\n2351\t            keyword=keyword, present=present, enforced=enforced\n2352\t        )\n2353\t        if present or not enforced:\n2354\t            return None\n2355\t        return (\n2356\t            \"spawn_prompt_defense_missing\",\n2357\t            f\"keyword={keyword} min_bullets={_PROMPT_DEFENSE_MIN_BULLETS}\",\n2358\t        )\n2359\t    except Exception:  # pragma: no cover - fail-open invariant\n2360\t        return None\n2361\t# ---------------------------------------------------------------------------\n2362\t# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [END]\n2363\t# ---------------------------------------------------------------------------\n2364\t\n2365\t\n2366\tdef decide(\n2367\t    *,\n2368\t    description: str,\n2369\t    prompt: str,"}]},"parent_tool_use_id":null,"session_id":"6c6b3523-70f9-4534-b265-459163374a50","uuid":"25fdf89d-a979-4b46-b76e-a250d52be41b","timestamp":"2026-11-15T10:10:13.025Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/check_agent_spawn.py","content":"                min(len(path_hashes), 99)\n                if path_count is None else max(0, min(int(path_count), 99))\n            ),\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\n# ---------------------------------------------------------------------------\n# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [BEGIN]\n# ---------------------------------------------------------------------------\n# NAMED spawns whose task indicates contact with UNTRUSTED CONTENT (web\n# fetch/search, scraping, imported/upstream/third-party material) MUST carry\n# the 6-bullet `## PROMPT DEFENSE` anti-injection block that\n# `.claude/scripts/inject-agent-context.sh` now emits unconditionally.\n#\n# Failure semantics (CLAUDE.md §4 doctrine):\n#   - INPUT side is fail-CLOSED: heuristic matched + section missing/thin\n#     => BLOCK (precedent: check_bash_safety.py `_e3` parse gate + C4).\n#   - INFRASTRUCTURE side is fail-OPEN: any exception inside this gate\n#     => allow (never punish the session for our own bug).\n#\n# Detection is a CONSERVATIVE lowercase-substring keyword set scanned over\n# the sanitized (fence/comment-stripped) description + prompt. HONESTY —\n# documented false negatives, by design:\n#   - synonyms/other languages are missed (\"crawl\", \"harvest\", \"baixar\",\n#     \"read the vendor tarball\", ...);\n#   - obfuscated intents (base64, hyphenation, l33t) are missed;\n#   - keywords appearing ONLY inside fenced code blocks are masked by\n#     `_strip_fenced_and_comments` and therefore missed;\n#   - scan is capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes; mentions beyond\n#     the cap are missed.\n# The cheap mitigation for every miss-class is the same: the spawn template\n# emits the block UNCONDITIONALLY, so any template-generated prompt passes\n# regardless of heuristic reach. This gate exists to catch hand-rolled\n# prompts that bypass the template.\n#\n# Kill-switches (advisory demotion — event still emitted, spawn allowed):\n#   CEO_PROMPT_DEFENSE_GATE=0   per-gate opt-out\n#   CEO_SOTA_DISABLE=1          master kill (E3-rail precedent)\n_PROMPT_DEFENSE_HEADER_RE = re.compile(\n    r\"^##[ \\t]+PROMPT[ \\t]+DEFENSE[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n# A bullet line: \"-\" or \"*\" + whitespace + at least one non-space char.\n_PROMPT_DEFENSE_BULLET_RE = re.compile(\n    r\"^[ \\t]*[-*][ \\t]+\\S\",\n    flags=re.MULTILINE,\n)\n_PROMPT_DEFENSE_MIN_BULLETS = 6\n_PROMPT_DEFENSE_SCAN_CAP = 256 * 1024  # bytes of sanitized text scanned\n# Closed, lowercase substring set. Ordering = report priority (first hit\n# wins; the matched token is the ONLY prompt-derived value that reaches the\n# audit log — closed-enum-safe, no prompt body echo).\n_UNTRUSTED_CONTENT_HINTS: Tuple[str, ...] = (\n    \"webfetch\",\n    \"websearch\",\n    \"web search\",\n    \"search the web\",\n    \"fetch the url\",\n    \"fetch url\",\n    \"fetch http\",\n    \"download from http\",\n    \"scrape\",\n    \"scraping\",\n    \"imported\",\n    \"upstream\",\n    \"third-party\",\n    \"third party\",\n    \"untrusted\",\n)\n\n\ndef _prompt_defense_required(\n    description: str, prompt_sanitized: str\n) -> Optional[str]:\n    \"\"\"Return the first matched untrusted-content hint, or None.\n\n    Pure. Never raises. Bounded scan over lowercase(description + sanitized\n    prompt) capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes.\n    \"\"\"\n    haystack = (\n        (description or \"\") + \"\\n\" + (prompt_sanitized or \"\")\n    )[:_PROMPT_DEFENSE_SCAN_CAP].lower()\n    for hint in _UNTRUSTED_CONTENT_HINTS:\n        if hint in haystack:\n            return hint\n    return None\n\n\ndef _has_prompt_defense_block(prompt_sanitized: str) -> bool:\n    \"\"\"True iff sanitized prompt has `## PROMPT DEFENSE` on its own line\n    with >= `_PROMPT_DEFENSE_MIN_BULLETS` bullet lines before the next\n    `##` heading / EOF. Fence/comment-masked headers do NOT count\n    (P1-SEC-B precedent — caller passes pre-sanitized text).\"\"\"\n    if not prompt_sanitized:\n        return False\n    m = _PROMPT_DEFENSE_HEADER_RE.search(prompt_sanitized)\n    if m is None:\n        return False\n    block_start = m.end()\n    nxt = _NEXT_H2_RE.search(prompt_sanitized, block_start)\n    block = prompt_sanitized[\n        block_start: nxt.start() if nxt else len(prompt_sanitized)\n    ]\n    bullets = len(_PROMPT_DEFENSE_BULLET_RE.findall(block))\n    return bullets >= _PROMPT_DEFENSE_MIN_BULLETS\n\n\ndef _emit_prompt_defense_event(\n    *, keyword: str, present: bool, enforced: bool\n) -> None:\n    \"\"\"Emit `spawn_prompt_defense_gate` telemetry. `keyword` is from the\n    closed `_UNTRUSTED_CONTENT_HINTS` enum — no prompt body ever persists.\n    Fail-open.\"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        _audit_emit.emit_generic(\n            \"spawn_prompt_defense_gate\",\n            keyword=(keyword or \"\")[:32],\n            present=1 if present else 0,\n            enforced=1 if enforced else 0,\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _enforce_prompt_defense(\n    *,\n    description: str,\n    prompt: str,\n    env: Dict[str, str],\n) -> Optional[Tuple[str, str]]:\n    \"\"\"Evaluate the Prompt Defense Baseline gate for a NAMED spawn.\n\n    Returns (reason_code, detail) when the gate is ENFORCING and fires;\n    None otherwise. NEVER raises (infra fail-open); the block itself is\n    the input-side fail-CLOSED posture (matched + missing => BLOCK).\n    \"\"\"\n    try:\n        sanitized = _strip_fenced_and_comments(prompt or \"\")\n        keyword = _prompt_defense_required(description or \"\", sanitized)\n        if keyword is None:\n            return None  # no untrusted-content signal — out of scope\n        present = _has_prompt_defense_block(sanitized)\n        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n        raw = (env.get(\"CEO_PROMPT_DEFENSE_GATE\") or \"\").strip()\n        gate_off = raw in (\"0\", \"false\", \"False\", \"no\", \"off\")\n        enforced = (not master_off) and (not gate_off)\n        _emit_prompt_defense_event(\n            keyword=keyword, present=present, enforced=enforced\n        )\n        if present or not enforced:\n            return None\n        return (\n            \"spawn_prompt_defense_missing\",\n            f\"keyword={keyword} min_bullets={_PROMPT_DEFENSE_MIN_BULLETS}\",\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return None\n# ---------------------------------------------------------------------------\n# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [END]\n# ---------------------------------------------------------------------------\n\n\ndef decide(\n    *,\n    description: str,\n    prompt: str,","numLines":170,"startLine":2200,"totalLines":3201}},"tool_result_meta":[{"id":"toolu_019uJg2P9qXvKXGgreiWsbNw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
