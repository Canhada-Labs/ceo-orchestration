issed.\n2232\t# The cheap mitigation for every miss-class is the same: the spawn template\n2233\t# emits the block UNCONDITIONALLY, so any template-generated prompt passes\n2234\t# regardless of heuristic reach. This gate exists to catch hand-rolled\n2235\t# prompts that bypass the template.\n2236\t#\n2237\t# Kill-switches (advisory demotion — event still emitted, spawn allowed):\n2238\t#   CEO_PROMPT_DEFENSE_GATE=0   per-gate opt-out\n2239\t#   CEO_SOTA_DISABLE=1          master kill (E3-rail precedent)\n2240\t_PROMPT_DEFENSE_HEADER_RE = re.compile(\n2241\t    r\"^##[ \\t]+PROMPT[ \\t]+DEFENSE[ \\t]*$\",\n2242\t    flags=re.MULTILINE,\n2243\t)\n2244\t# A bullet line: \"-\" or \"*\" + whitespace + at least one non-space char.\n2245\t_PROMPT_DEFENSE_BULLET_RE = re.compile(\n2246\t    r\"^[ \\t]*[-*][ \\t]+\\S\",\n2247\t    flags=re.MULTILINE,\n2248\t)\n2249\t_PROMPT_DEFENSE_MIN_BULLETS = 6\n2250\t_PROMPT_DEFENSE_SCAN_CAP = 256 * 1024  # bytes of sanitized text scanned\n2251\t# Closed, lowercase substring set. Ordering = report priority (first hit\n2252\t# wins; the matched token is the ONLY prompt-derived value that reaches the\n2253\t# audit log — closed-enum-safe, no prompt body echo).\n2254\t_UNTRUSTED_CONTENT_HINTS: Tuple[str, ...] = (\n2255\t    \"webfetch\",\n2256\t    \"websearch\",\n2257\t    \"web search\",\n2258\t    \"search the web\",\n2259\t    \"fetch the url\",\n2260\t    \"fetch url\",\n2261\t    \"fetch http\",\n2262\t    \"download from http\",\n2263\t    \"scrape\",\n2264\t    \"scraping\",\n2265\t    \"imported\",\n2266\t    \"upstream\",\n2267\t    \"third-party\",\n2268\t    \"third party\",\n2269\t    \"untrusted\",\n2270\t)\n2271\t\n2272\t\n2273\tdef _prompt_defense_required(\n2274\t    description: str, prompt_sanitized: str\n2275\t) -> Optional[str]:\n2276\t    \"\"\"Return the first matched untrusted-content hint, or None.\n2277\t\n2278\t    Pure. Never raises. Bounded scan over lowercase(description + sanitized\n2279\t    prompt) capped at