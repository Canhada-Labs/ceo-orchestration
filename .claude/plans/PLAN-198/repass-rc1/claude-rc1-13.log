{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4XoRxH7Q9agNQFEMFtw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_013ALhPwKiW6BJbXUqqC1cKb","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/check_agent_spawn.py","offset":1519,"limit":290},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10518,"cache_read_input_tokens":52250,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10518},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6c6b3523-70f9-4534-b265-459163374a50","uuid":"8f4ae412-eecb-4dd0-a69a-3ad0ed94ffbf","timestamp":"2026-11-15T10:10:06.977Z","request_id":"req_011Ch4XoRTmSnBD2hzTP7VQ8","wire_tool_inputs":{"toolu_013ALhPwKiW6BJbXUqqC1cKb":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/check_agent_spawn.py","offset":1519,"limit":290}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ALhPwKiW6BJbXUqqC1cKb","type":"tool_result","content":"1519\t# PLAN-133 E3 — Per-spawn tool scoping + depth/overlap rails.\n1520\t# ---------------------------------------------------------------------------\n1521\t# Ports the Goose recipe \"declared capability scope + one-level recursion +\n1522\t# file partition\" idea, re-implemented from scratch in stdlib (rite §2). All\n1523\t# three rails are ADVISORY by default (emit only) and become BLOCKING only\n1524\t# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n1525\t#\n1526\t# Rail 1 — Tool allow-list: a spawn profile MAY declare\n1527\t#     ## TOOL ALLOW-LIST\n1528\t#     - Read\n1529\t#     - Edit\n1530\t#     - Bash\n1531\t# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n1532\t# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n1533\t# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n1534\t#\n1535\t# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n1536\t# depth-2 spawn. The harness Agent payload has no native depth field, so we\n1537\t# read the advisory marker the CEO injects into a delegated prompt\n1538\t# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n1539\t# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n1540\t#\n1541\t# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n1542\t# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n1543\t# other spawns recorded in the audit log within a short concurrency window\n1544\t# (same session, same plan). Any shared concrete path = clobber risk.\n1545\t\n1546\t# --- Rail 1: tool allow-list ----------------------------------------------\n1547\t_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n1548\t    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n1549\t    flags=re.MULTILINE,\n1550\t)\n1551\t# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n1552\t_TOOL_BULLET_RE = re.compile(\n1553\t    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n1554\t    flags=re.MULTILINE,\n1555\t)\n1556\t# Canonical Claude Code tool names we recognize (closed set — anything not\n1557\t# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n1558\t# unknown token can never cause a false block).\n1559\t_KNOWN_TOOL_NAMES = frozenset({\n1560\t    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n1561\t    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n1562\t})\n1563\t# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n1564\t# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n1565\t# a profile that simply mentions a word does not trip the rail.\n1566\t_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n1567\t    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n1568\t              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n1569\t    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n1570\t    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n1571\t    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n1572\t    (\"websearch\", (\"search the web\", \"web search\")),\n1573\t)\n1574\t_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n1575\t\n1576\t# --- Rail 2: depth fence ---------------------------------------------------\n1577\t_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n1578\t    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n1579\t    flags=re.MULTILINE,\n1580\t)\n1581\t\n1582\t# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n1583\t# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n1584\t# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n1585\t# Markdown renderer/agent — recognizing them (instead of enumerating\n1586\t# taints) keeps the parser aligned with what the agent SEES.\n1587\t_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n1588\t    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n1589\t    flags=re.MULTILINE | re.IGNORECASE,\n1590\t)\n1591\t# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n1592\t# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n1593\t# make the line a CommonMark CODE BLOCK — example text, never a grant.\n1594\t_CAN_EDIT_LINE_RE = re.compile(\n1595\t    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n1596\t    flags=re.MULTILINE | re.IGNORECASE,\n1597\t)\n1598\t# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n1599\t# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n1600\t# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n1601\t# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n1602\t# match a CLOSED whitelist of recognized forms — anything else is a\n1603\t# visible grant/instruction the parser did not validate => taint.\n1604\t_FA_LIST_LINE_RE = re.compile(\n1605\t    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n1606\t    flags=re.MULTILINE,\n1607\t)\n1608\t_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n1609\t    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n1610\t    flags=re.IGNORECASE,\n1611\t)\n1612\t_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n1613\t    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n1614\t    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n1615\t    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n1616\t    r\"|FORBIDDEN\\b\"             # architect forbidden list\n1617\t    # canonical template escape-hatch prose — the FULL fixed phrase, so\n1618\t    # the prefix CONSUMES its own `edit` and the suffix rule below can\n1619\t    # ban any further edit-grant text (codex r34 P1)\n1620\t    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n1621\t    r\")\",\n1622\t    flags=re.IGNORECASE,\n1623\t)\n1624\t# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n1625\t# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n1626\t# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n1627\t# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n1628\t# authority). A token is a whitespace-delimited word stripped of edge\n1629\t# punctuation; tokens containing / or . are path-like and never match.\n1630\t_FA_AUTHORITY_WORDS = frozenset((\n1631\t    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n1632\t    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n1633\t))\n1634\t\n1635\t\n1636\tdef _fa_suffix_has_authority(suffix: str) -> bool:\n1637\t    \"\"\"True when the prose suffix carries a bare authority word.\"\"\"\n1638\t    for tok in suffix.split():\n1639\t        if \"/\" in tok or \".\" in tok:\n1640\t            continue  # path-like token — filename parts are not authority\n1641\t        if tok.strip(\";:,()[]{}'\\\"!?-\").lower() in _FA_AUTHORITY_WORDS:\n1642\t            return True\n1643\t    return False\n1644\t\n1645\t\n1646\tdef _fa_list_line_allowed(line: str) -> bool:\n1647\t    \"\"\"Closed whitelist for list lines inside a FILE ASSIGNMENT block.\n1648\t\n1649\t    Anchored semantics (codex r33+r34 P1): a PROSE form may not smuggle\n1650\t    ANY edit grant in its suffix — `- MAY read docs; MUST edit x` and\n1651\t    `- If you need permission: CAN edit: x` are tainted, not laundered.\n1652\t    Each prose prefix consumes its own `edit` (when it has one); any\n1653\t    FURTHER `edit` word after the matched prefix rejects the line.\n1654\t    \"\"\"\n1655\t    if _FA_ALLOWED_GRANT_LINE_RE.match(line):\n1656\t        return True\n1657\t    m = _FA_ALLOWED_PROSE_LINE_RE.match(line)\n1658\t    if m:\n1659\t        return not _fa_suffix_has_authority(line[m.end():])\n1660\t    return False\n1661\t_OVERLAP_LOOKBACK_S = 600          # 10-minute concurrency window\n1662\t_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n1663\t_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n1664\t\n1665\t\n1666\tdef _parse_tool_allowlist(prompt: str) -> Optional[frozenset]:\n1667\t    \"\"\"Return the declared lowercase tool allow-list, or None if no\n1668\t    `## TOOL ALLOW-LIST` block is present (= unrestricted, back-compat).\n1669\t\n1670\t    Pure. Never raises. Bounded to the block between its header and the next\n1671\t    `##` heading. Only KNOWN tool names are retained; unknown tokens dropped\n1672\t    (so a typo cannot create a phantom allow-list that blocks everything).\n1673\t    \"\"\"\n1674\t    if not prompt:\n1675\t        return None\n1676\t    sanitized = _strip_fenced_and_comments(prompt)\n1677\t    m = _TOOL_ALLOWLIST_HEADER_RE.search(sanitized)\n1678\t    if m is None:\n1679\t        return None\n1680\t    block_start = m.end()\n1681\t    nxt = _NEXT_H2_RE.search(sanitized, block_start)\n1682\t    block = sanitized[block_start: nxt.start() if nxt else len(sanitized)]\n1683\t    allowed = set()\n1684\t    for bm in _TOOL_BULLET_RE.finditer(block):\n1685\t        for tok in bm.group(1).replace(\",\", \" \").split():\n1686\t            t = tok.strip().lower()\n1687\t            if t in _KNOWN_TOOL_NAMES:\n1688\t                allowed.add(t)\n1689\t    # An empty-but-present block = \"deny all known tools\" (intentional).\n1690\t    return frozenset(allowed)\n1691\t\n1692\t\n1693\tdef _requested_tools(prompt: str) -> frozenset:\n1694\t    \"\"\"Heuristic set of KNOWN tools this spawn appears to request.\n1695\t\n1696\t    First-hit per family, bounded scan. Conservative (high-signal verbs only).\n1697\t    Pure; never raises.\n1698\t    \"\"\"\n1699\t    if not prompt:\n1700\t        return frozenset()\n1701\t    text = _strip_fenced_and_comments(prompt)[:_TOOL_SCAN_WINDOW].lower()\n1702\t    out = set()\n1703\t    for tool, hints in _TOOL_REQUEST_HINTS:\n1704\t        if any(h in text for h in hints):\n1705\t            out.add(tool)\n1706\t    return frozenset(out)\n1707\t\n1708\t\n1709\tdef _check_tool_scope(\n1710\t    prompt: str,\n1711\t) -> Optional[Tuple[str, str]]:\n1712\t    \"\"\"Rail 1. Return (reason_code, detail) if a requested tool is OUTSIDE\n1713\t    the declared allow-list, else None.\n1714\t\n1715\t    `detail` NEVER contains a path or the raw prompt — only the offending\n1716\t    tool NAME(s) (a closed-enum-safe value) + counts. No-value-echo safe.\n1717\t    \"\"\"\n1718\t    allow = _parse_tool_allowlist(prompt)\n1719\t    if allow is None:\n1720\t        return None  # no declared scope -> unrestricted (back-compat)\n1721\t    requested = _requested_tools(prompt)\n1722\t    out_of_scope = sorted(requested - allow)\n1723\t    if not out_of_scope:\n1724\t        return None\n1725\t    return (\n1726\t        \"spawn_tool_out_of_scope\",\n1727\t        f\"tools={','.join(out_of_scope)} declared={len(allow)}\",\n1728\t    )\n1729\t\n1730\t\n1731\tdef _spawn_depth(prompt: str, env: Dict[str, str]) -> int:\n1732\t    \"\"\"Best-effort current spawn depth. 0 = top-level CEO spawn.\n1733\t\n1734\t    Two independent signals, max() wins (fail-toward-detection):\n1735\t      - `## SUBAGENT-CONTEXT depth=N` marker in the prompt (CEO-injected when\n1736\t        delegating to a sub-agent that may itself coordinate).\n1737\t      - `CEO_SPAWN_DEPTH` env breadcrumb (harness/CEO-set).\n1738\t    Pure-ish (reads env dict only). Never raises.\n1739\t    \"\"\"\n1740\t    depth = 0\n1741\t    try:\n1742\t        m = _SUBAGENT_DEPTH_MARKER_RE.search(prompt or \"\")\n1743\t        if m:\n1744\t            depth = max(depth, int(m.group(1)))\n1745\t    except Exception:  # pragma: no cover - fail-open\n1746\t        pass\n1747\t    try:\n1748\t        raw = (env.get(\"CEO_SPAWN_DEPTH\") or \"\").strip()\n1749\t        if raw.isdigit():\n1750\t            depth = max(depth, int(raw))\n1751\t    except Exception:  # pragma: no cover - fail-open\n1752\t        pass\n1753\t    return depth\n1754\t\n1755\t\n1756\t# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n1757\t# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n1758\t# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n1759\t# ADR-191 cures): read-only intent must be spelled out with this token.\n1760\t_FA_READONLY_TOKEN = \"none-read-only\"\n1761\t\n1762\t# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n1763\t# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n1764\t# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n1765\t# CommonMark) would leak into classification and could satisfy the gate\n1766\t# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n1767\t# radius; the shared regex serves every other block parser unchanged).\n1768\t# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n1769\t# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n1770\t# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n1771\t# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n1772\t# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n1773\t# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n1774\t# Closer must be the SAME character, length >= opener (codex r37 P2:\n1775\t# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n1776\t# the fence char; closer = \\1 (full opener string) + \\2* (same char\n1777\t# only). A shorter/mismatched closer falls through to \\Z — masking to\n1778\t# EOF, the fail-CLOSED direction.\n1779\t_FA_FENCE_RE = re.compile(\n1780\t    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n1781\t    flags=re.MULTILINE | re.DOTALL,\n1782\t)\n1783\t\n1784\t# Telemetry marker hash for the explicit read-only declaration. DOMAIN-\n1785\t# SEPARATED from real path hashes (codex r1 P2, Lote B): hashing the bare\n1786\t# token collided with a legitimate concrete path `./none-read-only` (the\n1787\t# token check runs BEFORE ./-normalization, so that path survives as\n1788\t# concrete and would hash identically — under CEO_SPAWN_OVERLAP_GUARD=1 it\n1789\t# would false-block against every prior read-only spawn). NUL bytes cannot\n1790\t# appear in a real declared path, so this input is unreachable from\n1791\t# _path_hash(path) space.\n1792\t\n1793\t\n1794\tdef _classify_file_assignment(prompt: str) -> Tuple[str, frozenset]:\n1795\t    \"\"\"Classify the spawn's `## FILE ASSIGNMENT` declaration (PLAN-178 C1).\n1796\t\n1797\t    Returns ``(state, concrete_paths)`` with ``state`` in a closed enum:\n1798\t\n1799\t    - ``\"absent\"``      — no `## FILE ASSIGNMENT` header in the sanitized\n1800\t      prompt (fenced/comment content never counts — same masking rule as\n1801\t      every other block parser in this hook).\n1802\t    - ``\"concrete\"``    — >=1 concrete `CAN edit:` path AND zero dropped\n1803\t      tokens (codex r15 P1: `safe.py, src/**` must NOT classify concrete —\n1804\t      the agent still READS the wildcard grant while telemetry records\n1805\t      only the concrete path; any dropped token taints the whole\n1806\t      declaration to unparseable).\n1807\t    - ``\"readonly\"``    — explicit `CAN edit: NONE-READ-ONLY` and no\n1808\t      concrete path. Case-insensitive token match; conformant."}]},"parent_tool_use_id":null,"session_id":"6c6b3523-70f9-4534-b265-459163374a50","uuid":"816e6178-bbfe-4acf-9a25-42d396e58f9c","timestamp":"2026-11-15T10:10:07.013Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/check_agent_spawn.py","content":"# PLAN-133 E3 — Per-spawn tool scoping + depth/overlap rails.\n# ---------------------------------------------------------------------------\n# Ports the Goose recipe \"declared capability scope + one-level recursion +\n# file partition\" idea, re-implemented from scratch in stdlib (rite §2). All\n# three rails are ADVISORY by default (emit only) and become BLOCKING only\n# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n#\n# Rail 1 — Tool allow-list: a spawn profile MAY declare\n#     ## TOOL ALLOW-LIST\n#     - Read\n#     - Edit\n#     - Bash\n# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n#\n# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n# depth-2 spawn. The harness Agent payload has no native depth field, so we\n# read the advisory marker the CEO injects into a delegated prompt\n# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n#\n# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n# other spawns recorded in the audit log within a short concurrency window\n# (same session, same plan). Any shared concrete path = clobber risk.\n\n# --- Rail 1: tool allow-list ----------------------------------------------\n_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n_TOOL_BULLET_RE = re.compile(\n    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n    flags=re.MULTILINE,\n)\n# Canonical Claude Code tool names we recognize (closed set — anything not\n# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n# unknown token can never cause a false block).\n_KNOWN_TOOL_NAMES = frozenset({\n    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n})\n# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n# a profile that simply mentions a word does not trip the rail.\n_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n    (\"websearch\", (\"search the web\", \"web search\")),\n)\n_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n\n# --- Rail 2: depth fence ---------------------------------------------------\n_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n    flags=re.MULTILINE,\n)\n\n# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n# Markdown renderer/agent — recognizing them (instead of enumerating\n# taints) keeps the parser aligned with what the agent SEES.\n_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n    flags=re.MULTILINE | re.IGNORECASE,\n)\n# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n# make the line a CommonMark CODE BLOCK — example text, never a grant.\n_CAN_EDIT_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n    flags=re.MULTILINE | re.IGNORECASE,\n)\n# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n# match a CLOSED whitelist of recognized forms — anything else is a\n# visible grant/instruction the parser did not validate => taint.\n_FA_LIST_LINE_RE = re.compile(\n    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n    flags=re.MULTILINE,\n)\n_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n    flags=re.IGNORECASE,\n)\n_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n    r\"|FORBIDDEN\\b\"             # architect forbidden list\n    # canonical template escape-hatch prose — the FULL fixed phrase, so\n    # the prefix CONSUMES its own `edit` and the suffix rule below can\n    # ban any further edit-grant text (codex r34 P1)\n    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n    r\")\",\n    flags=re.IGNORECASE,\n)\n# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n# authority). A token is a whitespace-delimited word stripped of edge\n# punctuation; tokens containing / or . are path-like and never match.\n_FA_AUTHORITY_WORDS = frozenset((\n    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n))\n\n\ndef _fa_suffix_has_authority(suffix: str) -> bool:\n    \"\"\"True when the prose suffix carries a bare authority word.\"\"\"\n    for tok in suffix.split():\n        if \"/\" in tok or \".\" in tok:\n            continue  # path-like token — filename parts are not authority\n        if tok.strip(\";:,()[]{}'\\\"!?-\").lower() in _FA_AUTHORITY_WORDS:\n            return True\n    return False\n\n\ndef _fa_list_line_allowed(line: str) -> bool:\n    \"\"\"Closed whitelist for list lines inside a FILE ASSIGNMENT block.\n\n    Anchored semantics (codex r33+r34 P1): a PROSE form may not smuggle\n    ANY edit grant in its suffix — `- MAY read docs; MUST edit x` and\n    `- If you need permission: CAN edit: x` are tainted, not laundered.\n    Each prose prefix consumes its own `edit` (when it has one); any\n    FURTHER `edit` word after the matched prefix rejects the line.\n    \"\"\"\n    if _FA_ALLOWED_GRANT_LINE_RE.match(line):\n        return True\n    m = _FA_ALLOWED_PROSE_LINE_RE.match(line)\n    if m:\n        return not _fa_suffix_has_authority(line[m.end():])\n    return False\n_OVERLAP_LOOKBACK_S = 600          # 10-minute concurrency window\n_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n\n\ndef _parse_tool_allowlist(prompt: str) -> Optional[frozenset]:\n    \"\"\"Return the declared lowercase tool allow-list, or None if no\n    `## TOOL ALLOW-LIST` block is present (= unrestricted, back-compat).\n\n    Pure. Never raises. Bounded to the block between its header and the next\n    `##` heading. Only KNOWN tool names are retained; unknown tokens dropped\n    (so a typo cannot create a phantom allow-list that blocks everything).\n    \"\"\"\n    if not prompt:\n        return None\n    sanitized = _strip_fenced_and_comments(prompt)\n    m = _TOOL_ALLOWLIST_HEADER_RE.search(sanitized)\n    if m is None:\n        return None\n    block_start = m.end()\n    nxt = _NEXT_H2_RE.search(sanitized, block_start)\n    block = sanitized[block_start: nxt.start() if nxt else len(sanitized)]\n    allowed = set()\n    for bm in _TOOL_BULLET_RE.finditer(block):\n        for tok in bm.group(1).replace(\",\", \" \").split():\n            t = tok.strip().lower()\n            if t in _KNOWN_TOOL_NAMES:\n                allowed.add(t)\n    # An empty-but-present block = \"deny all known tools\" (intentional).\n    return frozenset(allowed)\n\n\ndef _requested_tools(prompt: str) -> frozenset:\n    \"\"\"Heuristic set of KNOWN tools this spawn appears to request.\n\n    First-hit per family, bounded scan. Conservative (high-signal verbs only).\n    Pure; never raises.\n    \"\"\"\n    if not prompt:\n        return frozenset()\n    text = _strip_fenced_and_comments(prompt)[:_TOOL_SCAN_WINDOW].lower()\n    out = set()\n    for tool, hints in _TOOL_REQUEST_HINTS:\n        if any(h in text for h in hints):\n            out.add(tool)\n    return frozenset(out)\n\n\ndef _check_tool_scope(\n    prompt: str,\n) -> Optional[Tuple[str, str]]:\n    \"\"\"Rail 1. Return (reason_code, detail) if a requested tool is OUTSIDE\n    the declared allow-list, else None.\n\n    `detail` NEVER contains a path or the raw prompt — only the offending\n    tool NAME(s) (a closed-enum-safe value) + counts. No-value-echo safe.\n    \"\"\"\n    allow = _parse_tool_allowlist(prompt)\n    if allow is None:\n        return None  # no declared scope -> unrestricted (back-compat)\n    requested = _requested_tools(prompt)\n    out_of_scope = sorted(requested - allow)\n    if not out_of_scope:\n        return None\n    return (\n        \"spawn_tool_out_of_scope\",\n        f\"tools={','.join(out_of_scope)} declared={len(allow)}\",\n    )\n\n\ndef _spawn_depth(prompt: str, env: Dict[str, str]) -> int:\n    \"\"\"Best-effort current spawn depth. 0 = top-level CEO spawn.\n\n    Two independent signals, max() wins (fail-toward-detection):\n      - `## SUBAGENT-CONTEXT depth=N` marker in the prompt (CEO-injected when\n        delegating to a sub-agent that may itself coordinate).\n      - `CEO_SPAWN_DEPTH` env breadcrumb (harness/CEO-set).\n    Pure-ish (reads env dict only). Never raises.\n    \"\"\"\n    depth = 0\n    try:\n        m = _SUBAGENT_DEPTH_MARKER_RE.search(prompt or \"\")\n        if m:\n            depth = max(depth, int(m.group(1)))\n    except Exception:  # pragma: no cover - fail-open\n        pass\n    try:\n        raw = (env.get(\"CEO_SPAWN_DEPTH\") or \"\").strip()\n        if raw.isdigit():\n            depth = max(depth, int(raw))\n    except Exception:  # pragma: no cover - fail-open\n        pass\n    return depth\n\n\n# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n# ADR-191 cures): read-only intent must be spelled out with this token.\n_FA_READONLY_TOKEN = \"none-read-only\"\n\n# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n# CommonMark) would leak into classification and could satisfy the gate\n# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n# radius; the shared regex serves every other block parser unchanged).\n# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n# Closer must be the SAME character, length >= opener (codex r37 P2:\n# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n# the fence char; closer = \\1 (full opener string) + \\2* (same char\n# only). A shorter/mismatched closer falls through to \\Z — masking to\n# EOF, the fail-CLOSED direction.\n_FA_FENCE_RE = re.compile(\n    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n    flags=re.MULTILINE | re.DOTALL,\n)\n\n# Telemetry marker hash for the explicit read-only declaration. DOMAIN-\n# SEPARATED from real path hashes (codex r1 P2, Lote B): hashing the bare\n# token collided with a legitimate concrete path `./none-read-only` (the\n# token check runs BEFORE ./-normalization, so that path survives as\n# concrete and would hash identically — under CEO_SPAWN_OVERLAP_GUARD=1 it\n# would false-block against every prior read-only spawn). NUL bytes cannot\n# appear in a real declared path, so this input is unreachable from\n# _path_hash(path) space.\n\n\ndef _classify_file_assignment(prompt: str) -> Tuple[str, frozenset]:\n    \"\"\"Classify the spawn's `## FILE ASSIGNMENT` declaration (PLAN-178 C1).\n\n    Returns ``(state, concrete_paths)`` with ``state`` in a closed enum:\n\n    - ``\"absent\"``      — no `## FILE ASSIGNMENT` header in the sanitized\n      prompt (fenced/comment content never counts — same masking rule as\n      every other block parser in this hook).\n    - ``\"concrete\"``    — >=1 concrete `CAN edit:` path AND zero dropped\n      tokens (codex r15 P1: `safe.py, src/**` must NOT classify concrete —\n      the agent still READS the wildcard grant while telemetry records\n      only the concrete path; any dropped token taints the whole\n      declaration to unparseable).\n    - ``\"readonly\"``    — explicit `CAN edit: NONE-READ-ONLY` and no\n      concrete path. Case-insensitive token match; conformant.","numLines":290,"startLine":1519,"totalLines":3201}},"tool_result_meta":[{"id":"toolu_013ALhPwKiW6BJbXUqqC1cKb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
