{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K2rZXcp39sZ6hDxT4DGirA","type":"tool_result","content":"1\t\"\"\"Ordered PreCompact declarations installed into the hook facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tfrom pathlib import Path\n5\tfrom typing import Any, Dict, Tuple\n6\t\n7\t_PARTS: Tuple[str, ...] = (\n8\t    \"snapshot_core\", \"pressure_sidecar\", \"ledger_index\", \"runtime\",\n9\t)\n10\t\n11\tdef install(namespace: Dict[str, Any]) -> None:\n12\t    \"\"\"Compile real declaration modules in the facade namespace and order.\"\"\"\n13\t    directory = Path(__file__).resolve().parent\n14\t    for name in _PARTS:\n15\t        path = directory / (name + \".py\")\n16\t        exec(compile(path.read_text(encoding=\"utf-8\"), str(path), \"exec\"), namespace, namespace)\n17\t"}]},"parent_tool_use_id":null,"session_id":"d2d92420-f411-43d4-a92d-0952266d7ce1","uuid":"51238a59-01eb-48fe-8c21-aa72b63c0bd0","timestamp":"2026-11-15T09:55:32.289Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_precompact_parts/__init__.py","content":"\"\"\"Ordered PreCompact declarations installed into the hook facade.\"\"\"\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any, Dict, Tuple\n\n_PARTS: Tuple[str, ...] = (\n    \"snapshot_core\", \"pressure_sidecar\", \"ledger_index\", \"runtime\",\n)\n\ndef install(namespace: Dict[str, Any]) -> None:\n    \"\"\"Compile real declaration modules in the facade namespace and order.\"\"\"\n    directory = Path(__file__).resolve().parent\n    for name in _PARTS:\n        path = directory / (name + \".py\")\n        exec(compile(path.read_text(encoding=\"utf-8\"), str(path), \"exec\"), namespace, namespace)\n","numLines":17,"startLine":1,"totalLines":17}},"tool_result_meta":[{"id":"toolu_01K2rZXcp39sZ6hDxT4DGirA","permission_decision":{"decision":"accept","