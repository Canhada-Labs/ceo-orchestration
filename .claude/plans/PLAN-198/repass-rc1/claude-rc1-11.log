open direction, ships to adopters, and contradicts none of the declared conditions. The only P1, the profiler's isolation missing CEO_AUDIT_LOG_PATH, appears to predate the move and goes to the annex rather than blocking."},"ttft_ms":49003,"type":"result","duration_ms":494693,"uuid":"652cf4a8-0bb4-4068-b22f-b7a169e8941c","ttft_stream_ms":4396,"time_to_request_ms":161,"first_content_frame_ms":4396,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"claude-opus-5-5":{"inputTokens":78,"outputTokens":43907,"cacheReadInputTokens":5899220,"cacheCreationInputTokens":184623,"webSearchRequests":0,"costUSD":3.53528,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":29865,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":184623,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"credential_expires_at":"2026-11-20T15:54:23.997Z"}
