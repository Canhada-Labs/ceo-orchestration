{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WWHo6yBdNWgTAQiU2c278z","type":"tool_result","content":"320\t\n321\t    # --- primary operations -----------------------------------------------\n322\t\n323\t    def set(\n324\t        self,\n325\t        key: str,\n326\t        value: Union[str, bytes],\n327\t        ttl_seconds: Optional[int] = None,\n328\t    ) -> None:\n329\t        \"\"\"Write a key/value pair with optional TTL.\n330\t\n331\t        Args:\n332\t            key: free-form string key. No length cap enforced at this layer;\n333\t                sqlite TEXT PK handles it.\n334\t            value: str (redacted before write) or bytes (stored as-is).\n335\t            ttl_seconds: None = no expiry; positive int = seconds from now.\n336\t\n337\t        Raises:\n338\t            StateStoreValueTooLarge: if value exceeds ``value_max_bytes``.\n339\t            ValueError: if ttl_seconds is negative or zero.\n340\t        \"\"\"\n341\t        self._ensure_open()\n342\t        assert self._conn is not None  # for type-checker\n343\t\n344\t        if ttl_seconds is not None and ttl_seconds <= 0:\n345\t            raise ValueError(f\"ttl_seconds must be positive, got {ttl_seconds}\")\n346\t\n347\t        # Redaction: strings go through the regex redactor; bytes are trusted.\n348\t        redacted = 0\n349\t        if isinstance(value, str):\n350\t            # Use max_chars=0 so full string survives — the cap below\n351\t            # still enforces size.\n352\t            redacted_text = _redact.redact_secrets(value, max_chars=0)\n353\t            if redacted_text != value:\n354\t                redacted = 1\n355\t            value_bytes = redacted_text.encode(\"utf-8\", errors=\"replace\")\n356\t        elif isinstance(value, (bytes, bytearray)):\n357\t            value_bytes = bytes(value)\n358\t        else:\n359\t            raise TypeError(f\"value must be str or bytes, got {type(value).__name__}\")\n360\t\n361\t        if len(value_bytes) > self.value_max_bytes:\n362\t            raise StateStoreValueTooLarge(\n363\t                f\"value is {len(value_bytes)} bytes, cap is {self.value_max_bytes}\"\n364\t            )\n365\t\n366\t        now = int(self._clock())\n367\t        expires_at: Optional[int] = None\n368\t        if ttl_seconds is not None:\n369\t            expires_at = now + int(ttl_seconds)"}]},"parent_tool_use_id":null,"session_id":"7f7338f3-f544-4c31-91bf-9348522f093d","uuid":"1bb91ea7-eaa7-4ea6-b327-e2f5f4d9ec45","timestamp":"2026-11-13T17:08:10.594Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/state_store.py","content":"\n    # --- primary operations -----------------------------------------------\n\n    def set(\n        self,\n        key: str,\n        value: Union[str, bytes],\n        ttl_seconds: Optional[int] = None,\n    ) -> None:\n        \"\"\"Write a key/value pair with optional TTL.\n\n        Args:\n            key: free-form string key. No length cap enforced at this layer;\n                sqlite TEXT PK handles it.\n            value: str (redacted before write) or bytes (stored as-is).\n            ttl_seconds: None = no expiry; positive int = seconds from now.\n\n        Raises:\n            StateStoreValueTooLarge: if value exceeds ``value_max_bytes``.\n            ValueError: if ttl_seconds is negative or zero.\n        \"\"\"\n        self._ensure_open()\n        assert self._conn is not None  # for type-checker\n\n        if ttl_seconds is not None and ttl_seconds <= 0:\n            raise ValueError(f\"ttl_seconds must be positive, got {ttl_seconds}\")\n\n        # Redaction: strings go through the regex redactor; bytes are trusted.\n        redacted = 0\n        if isinstance(value, str):\n            # Use max_chars=0 so full string survives — the cap below\n            # still enforces size.\n            redacted_text = _redact.redact_secrets(value, max_chars=0)\n            if redacted_text != value:\n                redacted = 1\n            value_bytes = redacted_text.encode(\"utf-8\", errors=\"replace\")\n        elif isinstance(value, (bytes, bytearray)):\n            value_bytes = bytes(value)\n        else:\n            raise TypeError(f\"value must be str or bytes, got {type(value).__name__}\")\n\n        if len(value_bytes) > self.value_max_bytes:\n            raise StateStoreValueTooLarge(\n                f\"value is {len(value_bytes)} bytes, cap is {self.value_max_bytes}\"\n            )\n\n        now = int(self._clock())\n        expires_at: Optional[int] = None\n        if ttl_seconds is not None:\n            expires_at = now + int(ttl_seconds)","numLines":50,"startLine":320,"totalLines":534}},"tool_result_meta":[{"id":"toolu_01WWHo6yBdNWgTAQiU2c278z","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
