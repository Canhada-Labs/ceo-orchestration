{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014LgudDfNzHkgX3YpxbHRu2","type":"tool_result","content":"1\t\"\"\"Reality ledger: findings.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport ast\n7\timport hashlib\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\timport time\n13\timport unicodedata\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom pathlib import Path\n17\tfrom typing import Any, Dict, FrozenSet, Iterable, List, Optional, Tuple\n18\t\n19\tfrom .constants import *  # shared declaration defaults\n20\t\n21\tdef _to_repo_rel(p: Path) -> str:\n22\t    try:\n23\t        return str(p.resolve().relative_to(_REPO_ROOT.resolve())).replace(os.sep, \"/\")\n24\t    except (ValueError, OSError):\n25\t        return str(p)\n26\t\n27\t\n28\tdef _sha256_of(s: str) -> str:\n29\t    return hashlib.sha256(s.encode(\"utf-8\", errors=\"replace\")).hexdigest()\n30\t\n31\t\n32\tdef _now_iso8601() -> str:\n33\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n34\t\n35\t\n36\tdef _redact(text: str) -> str:\n37\t    \"\"\"Pass through `_lib.redact.redact_secrets` without truncation.\n38\t\n39\t    Use max_chars=0 to disable preview truncation; rely on caller to\n40\t    bound the string length when needed.\n41\t    \"\"\"\n42\t    return redact_secrets(text or \"\", max_chars=0)\n43\t\n44\t\n45\tdef _build_finding(\n46\t    *,\n47\t    detector: str,\n48\t    severity: str,\n49\t    confidence: float,\n50\t    claim_source_path: str,\n51\t    expected_evidence: str,\n52\t    actual_evidence: str,\n53\t    advisory_action: str,\n54\t    extra: Optional[Dict[str, Any]] = None,\n55\t) -> Dict[str, Any]:\n56\t    \"\"\"Construct a finding dict with both render forms baked in.\n57\t\n58\t    `claim_source_path` is included for markdown only; JSON/JSONL\n59\t    renderers strip the field per Sec MF-3 contract.\n60\t    \"\"\"\n61\t    actual_redacted = _redact(actual_evidence)\n62\t    sha = _sha256_of(claim_source_path or \"\")\n63\t    # confidence_bps: integer basis-points (confidence × 1000, clamped 0..1000).\n64\t    # canonical_json forbids floats in HMAC-covered fields; the old \"confidence\"\n65\t    # float (0.0-1.0) caused CanonicalJsonError on every reality_ledger_finding\n66\t    # emit. Readers recover float via confidence_bps / 1000.\n67\t    confidence_bps = max(0, min(1000, int(round(float(confidence) * 1000))))\n68\t    return {\n69\t        \"schema_version\": SCHEMA_VERSION,\n70\t        \"finding_id\": str(uuid.uuid4()),\n71\t        \"detector\": detector,\n72\t        \"severity\": severity,\n73\t        \"confidence_bps\": confidence_bps,\n74\t        \"claim_source_path\": claim_source_path,\n75\t        \"claim_source_sha256\": sha,\n76\t        \"expected_evidence\": expected_evidence,\n77\t        \"actual_evidence_redacted\": actual_redacted,\n78\t        \"first_observed_at\": _now_iso8601(),\n79\t        \"advisory_action\": advisory_action,\n80\t        \"_extra\": extra or {},\n81\t    }\n82\t\n83\t\n84\tdef _strip_markdown_only(finding: Dict[str, Any]) -> Dict[str, Any]:\n85\t    \"\"\"Return a copy of finding without markdown-only fields (claim_source_path).\"\"\"\n86\t    return {k: v for k, v in finding.items() if k not in _MARKDOWN_ONLY_FIELDS}\n87\t\n88\t\n89\tdef render_finding_markdown(finding: Dict[str, Any]) -> str:\n90\t    lines: List[str] = []\n91\t    # confidence_bps (int 0..1000) — display as float for human readability.\n92\t    conf_display = finding.get(\"confidence_bps\", 0) / 1000\n93\t    lines.append(f\"### {finding['detector']}  ·  severity={finding['severity']}  ·  conf={conf_display:.3f}\")\n94\t    lines.append(\"\")\n95\t    lines.append(f\"- claim_source_path: `{finding['claim_source_path']}`\")\n96\t    lines.append(f\"- claim_source_sha256: `{finding['claim_source_sha256']}`\")\n97\t    lines.append(f\"- expected_evidence: `{finding['expected_evidence']}`\")\n98\t    lines.append(f\"- actual_evidence_redacted: `{finding['actual_evidence_redacted']}`\")\n99\t    lines.append(f\"- first_observed_at: `{finding['first_observed_at']}`\")\n100\t    lines.append(f\"- advisory_action: {finding['advisory_action']}\")\n101\t    lines.append(f\"- finding_id: `{finding['finding_id']}`\")\n102\t    return \"\\n\".join(lines)\n103\t\n104\t\n105\tdef render_findings_markdown(findings: List[Dict[str, Any]]) -> str:\n106\t    if not findings:\n107\t        return \"# reality-ledger — 0 findings\\n\\nNo divergence detected. (Advisory; never blocks.)\"\n108\t    counts: Dict[str, int] = {}\n109\t    for f in findings:\n110\t        counts[f[\"detector\"]] = counts.get(f[\"detector\"], 0) + 1\n111\t    lines = [f\"# reality-ledger — {len(findings)} finding(s)\", \"\"]\n112\t    lines.append(\"## Summary by detector\")\n113\t    for det in sorted(counts):\n114\t        lines.append(f\"- `{det}`: {counts[det]}\")\n115\t    lines.append(\"\")\n116\t    lines.append(\"## Findings\")\n117\t    for f in findings:\n118\t        lines.append(\"\")\n119\t        lines.append(render_finding_markdown(f))\n120\t    return \"\\n\".join(lines) + \"\\n\"\n121\t\n122\t\n123\tdef render_findings_json(findings: List[Dict[str, Any]]) -> str:\n124\t    \"\"\"JSON array with markdown-only fields excluded.\"\"\"\n125\t    safe = [_strip_markdown_only(f) for f in findings]\n126\t    # also drop _extra (caller-private debug payload) from JSON emission\n127\t    for s in safe:\n128\t        s.pop(\"_extra\", None)\n129\t    return json.dumps(safe, indent=2, sort_keys=True, ensure_ascii=False)\n130\t\n131\t\n132\tdef render_findings_jsonl(findings: List[Dict[str, Any]]) -> str:\n133\t    \"\"\"One JSON object per line, markdown-only fields excluded.\"\"\"\n134\t    out: List[str] = []\n135\t    for f in findings:\n136\t        s = _strip_markdown_only(f)\n137\t        s.pop(\"_extra\", None)\n138\t        out.append(json.dumps(s, sort_keys=True, ensure_ascii=False))\n1