os\n54\timport shutil\n55\timport subprocess\n56\timport sys\n57\timport tempfile\n58\timport time\n59\tfrom datetime import datetime, timezone\n60\tfrom pathlib import Path\n61\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n62\t\n63\t\n64\t# Declarations are cloned and functions execute against this facade's own\n65\t# globals; no imported module template is modified by facade monkeypatches.\n66\t_HOOKS_DIR = Path(__file__).resolve().parents[1] / \"hooks\"\n67\tif str(_HOOKS_DIR) not in sys.path:\n68\t    sys.path.insert(0, str(_HOOKS_DIR))\n69\t\n70\tfrom _lib._profile_opus_parts import install as _install_parts\n71\t\n72\t_install_parts(globals(), (\"smoke\", \"reference\", \"latency\", \"cli\"))\n73\t\n74\tif __name__ == \"__main__\":\n75\t    sys.exit(main())\n76\t"}]},"parent_tool_use_id":null,"session_id":"d2d92420-f411-43d4-a92d-0952266d7ce1","uuid":"3b1b46fb-09d5-49d7-99a4-189dfbc3c91f","timestamp":"2026-11-15T09:56:27.595Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/scripts/profile-opus-4-7.py","content":"#!/usr/bin/env python3\n\"\"\"profile-opus-4-7.py — Opus 4.7 framework optimization measurement tool.\n\nPLAN-020 Phase 0 item 6 + 8 deliverable. Stdlib-only.\n\nModes:\n\n- ``--smoke``: synthetic, no API, tokens mocked. CI-runnable. ≤30s budget.\n  Outputs JSON to stdout; exit 0 on success, 1 on internal error, 2 on\n  budget overrun.\n\n- ``--baseline``: full baseline capture (requires env to read audit log\n  + ANTHROPIC_API_KEY for live cache header probing — Phase 0 item 1\n  prerequisites). Outputs JSON + side-effects audit-log entries.\n  Reserved for next session post Owner sentinel for hook modifications.\n\n- ``--floor``: re-measure subprocess startup floor on this machine\n  (Phase 0 item 8). Cheap; ≤2s. Reports python3 -c 'pass' p50/p95/p99.\n\nWire-up: validate.yml step ``opus-4-7-profiler-smoke`` (deferred —\nneeds Owner se