--- /dev/null
+++ b/.claude/hooks/_lib/canonical_edit/utility.py
@@ -0,0 +1,177 @@
+"""Mechanically extracted canonical-edit declarations."""
+from __future__ import annotations
+
+def _validated_tool_name(tool_name) -> str:
+    """Closed-enum / shape validation for an event-derived tool name."""
+    raw = tool_name.strip() if isinstance(tool_name, str) else ""
+    if raw in _EDIT_CLASS_TOOLS:
+        return raw
+    if _MCP_TOOL_NAME_RE.match(raw):
+        return raw
+    return _BLOCKED_TOOL_UNKNOWN
+
+
+def _blocked_tool_field() -> str:
+    """The validated ``blocked_tool`` value for this invocation."""
+    return _validated_tool_name(_CURRENT_TOOL_NAME)
+
+
+def _emit_allow(system_message: Optional[str] = None) -> str:
+    # Claude Code hook schema: top-level "allow" is NOT valid.
+    # Emit empty {} or {"systemMessage": ...}.
+    out: dict = {}
+    if system_message:
+        out["systemMessage"] = system_message
+    return json.dumps(out, ensure_ascii=False)
+
+
+def _emit_persona_coverage_synthesized(rel_path: str) -> None:
+    """PLAN-106 Wave C — emit persona_coverage_synthesized at sentinel-approved
+    canonical-edit allow path.
+
+    Attribution policy:
+      archetype = env CEO_ACTIVE_ARCHETYPE if in closed-enum, else
+                  "code-reviewer" (canonical-edit sentinel chain is
+                  the code-review surface per ADR-010).
+      task_type = "review" (sentinel approval is a review act).
+      cell_id   = sha256[:8](archetype + ":" + task_type)
+      source    = "canonical_edit"
+
+    Best-effort; fail-open on any exception. Bypass via
+    ``CEO_PERSONA_COVERAGE_EMIT=0``.
+    """
+    env = os.environ
+    if (env.get("CEO_PERSONA_COVERAGE_EMIT") or "").strip() == "0":
+        return
+    try:
+        import hashlib as _hl
+        import unicodedata as _uc
+        from _lib import audit_emit as _audit_emit_pc  # noqa: E402
+
+        # Closed enum check (mirrors audit_emit:_PERSONA_COVERAGE_ARCHETYPES).
+        archetypes_ok = {
+            "code-reviewer", "security-engineer", "qa-architect",
+            "threat-detection-engineer",
+        }
+        raw = (env.get("CEO_ACTIVE_ARCHETYPE") or "").strip().lower()
+        # NFKC fold to defeat full-width injection in env var
+        raw = _uc.normalize("NFKC", raw)
+        archetype = raw if raw in archetypes_ok else "code-reviewer"
+        task_type = "review"
+        cell_input = f"{archetype}:{task_type}".encode("utf-8")
+        cell_id = _hl.sha256(cell_input).hexdigest()[:8]
+
+        _audit_emit_pc.emit_generic(
+            "persona_coverage_synthesized",
+            archetype=archetype,
+            task_type=task_type,
+            cell_id=cell_id,
+            source="canonical_edit",
+        )
+    except Exception:  # noqa: BLE001 — fail-open, never block edit
+        return
+
+
+def _emit_block(reason: str) -> str:
+    return json.dumps(
+        {"decision": "block", "reason": reason}, ensure_ascii=False
+    )
+
+
+def _scan_skill_content_unicode(content: str, *, surface: str, env=None):
+    """PLAN-133 A2 — pure invisible-unicode guard for SKILL.md content.
+
+    ``surface`` is the closed-enum origin ("skill_write" | "skill_read"). Default-OFF;
+    emits invisible_unicode_blocked on both advisory + enforced paths. Returns a
+    block-reason string when enforced AND a detection fires, else None. Fail-open.
+    """
+    try:
+        from _lib import spec_context_sanitizer as _scs  # noqa: E402
+    except Exception:  # pragma: no cover - fail-open
+        return None
+    try:
+        if not content:
+            return None
+        src_env = env if env is not None else os.environ
+        if (src_env.get("CEO_SOTA_DISABLE") or "").strip() == "1":
+            enforce = False
+        else:
+            enforce = (src_env.get("CEO_UNICODE_HARDBLOCK") or "").strip() == "1"
+            # Prefer the trusted_env snapshot when available (mirror A1/§5b).
+            try:
+                from _lib import trusted_env as _te  # noqa: E402
+                _snap = _te.get_trusted("CEO_UNICODE_HARDBLOCK")
+                if _snap is not None:
+                    enforce = (_snap or "").strip() == "1"
+            except Exception:  # pragma: no cover
+                pass
+
+        result = _scs.sanitize(content)
+        count = _scs.invisible_unicode_count(result)
+        if count <= 0:
+            return None
+        unicode_class = _scs.classify_invisible_unicode(result)
+
+        try:
+            from _lib import audit_emit as _ae  # noqa: E402
+            _ae.emit_generic(
+                "invisible_unicode_blocked",
+                surface=surface,
+                unicode_class=unicode_class,
+                char_count=int(count),
+                enforced=1 if enforce else 0,
+            )
+        except Exception:  # pragma: no cover - fail-open
+            pass
+
+        if not enforce:
+            return None
+        return (
+            "CANONICAL-EDIT-BLOCKED: invisible_unicode_blocked: this SKILL.md "
+            f"content contains {count} invisible/smuggling character(s) "
+            f"(class={unicode_class}). Skill content is loaded into the model as "
+            "trusted instructions; hidden control/bidi/Tag-block characters are "
+            "rejected fail-CLOSED. Remove them. To run advisory-only, unset "
+            "CEO_UNICODE_HARDBLOCK."
+        )
+    except Exception:  # pragma: no cover - fail-open invariant
+        return None
+
+
+def _staged_content(event) -> Optional[str]:
+    """PLAN-133 A2 — best-effort extraction of the NEW SKILL.md content from a
+    staged Edit/Write/MultiEdit ``tool_input``.
+
+    At PreToolUse the new content is in the tool_input, NOT yet on disk. Reads the
+    standard adapter keys (Write ``content``; Edit ``new_string``; MultiEdit
+    ``edits[].new_string`` concatenated). Returns None when nothing can be extracted
+    (fail-OPEN — the caller then never blocks). Never raises.
+    """
+    try:
+        tool_input = getattr(event, "tool_input", None) or {}
+        if not isinstance(tool_input, dict):
+            return None
+        # Write tool — full file content.
+        content = tool_input.get("content")
+        if isinstance(content, str) and content:
+            return content
+        # Edit tool — single replacement string.
+        new_string = tool_input.get("new_string")
+        if isinstance(new_string, str) and new_string:
+            return new_string
+        # MultiEdit tool — concatenate per-edit new strings.
+        edits = tool_input.get("edits")
+        if isinstance(edits, list):
+            parts: List[str] = []
+            for ed in edits:
+                if isinstance(ed, dict):
+                    ns = ed.get("new_string")
+                    if isinstance(ns, str) and ns:
+                        parts.append(ns)
+            if parts:
+                return "\n".join(parts)
+    except Exception:  # pragma: no cover - fail-open
+        return None
+    return None
+
+__all__ = ['_validated_tool_name', '_blocked_tool_field', '_emit_allow', '_emit_persona_coverage_synthesized', '_emit_block', '_scan_skill_content_unicode', '_staged_content']
diff --git a/.claude/hooks/_lib/claude_md_excludes.py b/.claude/hooks/_lib/claude_md_excludes.py
new file mode 100644
index 000000000000..5b54b17d2fa5
--- /dev/null
+++ b/.claude/hooks/_lib/claude_md_excludes.py
@@ -0,0 +1,95 @@
+"""Conservative checks for ``claudeMdExcludes`` and root instruction state.
+
+Claude Code applies ``claudeMdExcludes`` globs to absolute paths.  This module
+models path segments, including ``**`` as zero or more segments, rather than
+inferring safety from a pattern's spelling: a checkout can itself live below a
+staged-plan directory.  It does not claim full picomatch support (notably
+braces, extglobs and negation); those forms are conservatively treated as a
+possible root exclusion.
+
+``root_instruction_load_state`` accepts a *complete, observed* collection of
+loaded instruction paths.  It cannot infer an absent root from a static glob
+or from one incremental hook event; callers without such a collection receive
+``LOAD_STATE_UNOBSERVABLE``.
+"""
+
+from __future__ import annotations
+
+import fnmatch
+from pathlib import Path
+from typing import Any, Iterable, Optional, Union
+
+
+LOAD_STATE_LOADED = "root_loaded"
+LOAD_STATE_ABSENT = "root_absent"
+LOAD_STATE_UNOBSERVABLE = "root_load_unobservable"
+
+_PathLike = Union[str, "Path"]
+
+
+def _root_claude_md(project_dir: _PathLike) -> Path:
+    return (Path(project_dir) / "CLAUDE.md").resolve()
+
+
+def _has_unmodelled_syntax(pattern: str) -> bool:
+    return any(token in pattern for token in ("{", "}", "(", ")", "!"))
+
+
+def _segments_match(path: tuple, pattern: tuple) -> bool:
+    """Match ``*`` within one segment and ``**`` across zero or more."""
+    if not pattern:
+        return not path
+    head, tail = pattern[0], pattern[1:]
+    if head == "**":
+        return _segments_match(path, tail) or bool(path) and _segments_match(
+            path[1:], pattern
+        )
+    return bool(path) and fnmatch.fnmatchcase(path[0], head) and _segments_match(
+        path[1:], tail
+    )
+
+
+def root_claude_md_excluded(patterns: Any, project_dir: _PathLike) -> bool:
+    """Whether an effective excludes array matches the real root CLAUDE.md.
+
+    Non-list values are malformed settings, not evidence of an exclusion.
+    A relative ``CLAUDE.md`` does not match, matching the documented absolute
+    evaluation surface.  Unsupported glob syntax is flagged rather than
+    treated as harmless.
+    """
+    if not isinstance(patterns, (list, tuple)):
+        return False
+    root_path = tuple(_root_claude_md(project_dir).as_posix().split("/"))
+    for pattern in patterns:
+        if isinstance(pattern, str) and pattern:
+            normalized = pattern.replace("\\", "/")
+            if _has_unmodelled_syntax(normalized) or _segments_match(
+                root_path, tuple(normalized.split("/"))
+            ):
+                return True
+    return False
+
+
+def root_instruction_load_state(
+    loaded_instruction_paths: Optional[Iterable[Any]], project_dir: _PathLike,
+) -> str:
+    """Classify root loading from a complete observed path collection.
+
+    ``None``, a stream/iterator, malformed collections, or non-absolute
+    entries are explicitly unobservable.  All entries are validated before a
+    loaded result is returned, preventing a partial event stream from becoming
+    false proof that the root was loaded or skipped.
+    """
+    if not isinstance(loaded_instruction_paths, (list, tuple, set, frozenset)):
+        return LOAD_STATE_UNOBSERVABLE
+    root_path = _root_claude_md(project_dir)
+    root_loaded = False
+    for entry in loaded_instruction_paths:
+        if not isinstance(entry, (str, Path)):
+            return LOAD_STATE_UNOBSERVABLE
+        candidate = Path(entry)
+        if not candidate.is_absolute():
+            return LOAD_STATE_UNOBSERVABLE
+        if candidate.resolve() == root_path:
+            root_loaded = True
+    return LOAD_STATE_LOADED if root_loaded else LOAD_STATE_ABSENT
diff --git a/.claude/hooks/_lib/cli_currency.py b/.claude/hooks/_lib/cli_currency.py
new file mode 100644
index 000000000000..c5ed292f2bf5
--- /dev/null
+++ b/.claude/hooks/_lib/cli_currency.py
@@ -0,0 +1,87 @@
+"""Stable semantic-version policy for locally resolved CLI packages."""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import Iterable, Optional, Tuple
+
+
+CODEX_VERSION_FLOOR = "0.160.0"
+_SEMVER_RE = re.compile(r"^v?([0-9]+)\.([0-9]+)\.([0-9]+)$")
+
+
+def parse_semver(value: object) -> Optional[Tuple[int, int, int]]:
+    """Parse a stable ``major.minor.patch`` version; reject prereleases."""
+    if not isinstance(value, str):
+        return None
+    match = _SEMVER_RE.fullmatch(value.strip())
+    if match is None:
+        return None
+    return tuple(int(part) for part in match.groups())
+
+
+def compare_semver(candidate: object, floor: object) -> Optional[int]:
+    """Compare stable versions: positive when candidate is newer, else None."""
+    parsed_candidate = parse_semver(candidate)
+    parsed_floor = parse_semver(floor)
+    if parsed_candidate is None or parsed_floor is None:
+        return None
+    return (parsed_candidate > parsed_floor) - (parsed_candidate < parsed_floor)
+
+
+def compatible_package_version(
+    payload: Path, launcher: Optional[Path], manifest_version: object = None,
+    floor: str = CODEX_VERSION_FLOOR,
+) -> Optional[str]:
+    """Return a qualified stable version meeting floor and optional manifest.
+
+    This is currency evidence only: callers must not describe it as a hash
+    attestation of the executable bytes.
+    """
+    for package_file in _package_files((payload, launcher)):
+        version = _qualified_package_version(package_file)
+        comparison = compare_semver(version, floor)
+        manifest_comparison = (
+            1 if manifest_version is None else compare_semver(version, manifest_version)
+        )
+        if comparison is not None and comparison >= 0 and manifest_comparison is not None and manifest_comparison > 0:
+            return version
+    return None
+
+
+def qualified_package_version(payload: Path, launcher: Optional[Path]) -> Optional[str]:
+    """Return stable version from a nearby qualified package, if present."""
+    for package_file in _package_files((payload, launcher)):
+        version = _qualified_package_version(package_file)
+        if version is not None:
+            return version
+    return None
+
+
+def _package_files(paths: Iterable[Optional[Path]]) -> Iterable[Path]:
+    seen = set()
+    for path in paths:
+        if path is None:
+            continue
+        try:
+            path = path.resolve()
+        except OSError:
+            pass
+        for parent in (path.parent, *path.parents):
+            package_file = parent / "package.json"
+            if package_file not in seen:
+                seen.add(package_file)
+                yield package_file
+
+
+def _qualified_package_version(package_file: Path) -> Optional[str]:
+    try:
+        data = json.loads(package_file.read_text(encoding="utf-8"))
+    except (OSError, ValueError, RecursionError):
+        return None
+    if not isinstance(data, dict) or data.get("name") != "@openai/codex":
+        return None
