+    "pair_rail_phase_advanced":       "AML.T0050",   # W4.1 AUTO-07 — LLM Plugin Compromise dual-rail check
+    # PLAN-089 Wave C.5 — ATT&CK Enterprise bindings (R1 TDE P0 fold +
