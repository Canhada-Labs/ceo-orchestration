+    "codex_invoke_dispatched":        "AML.T0050",   # W1.4 SEMI-13 — LLM Plugin Compromise dual-rail
+    "tier_policy_misrouting_advised": "AML.T0048",   # W2.1 AUTO-04 — Governance bypass
