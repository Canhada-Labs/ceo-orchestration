+    "fpr_bps",            # int — observed FPR in basis points
+    "threshold_bps",      # int — drift threshold (200 = 2.0%)
+    "sample_n",           # int — events in window
+    "auto_demote_at",     # str ISO8601 — wall-clock when auto-demotion fires
+    "hmac",
+    "hmac_error",
+    "record_id",
