on block or allow.\n228\t        if _egress_emit_enabled():\n229\t            for _eclass, _edest in _classify_egress(command):\n230\t                _emit_egress_destination_event(_eclass, _edest)\n231\t        # PLAN-135 W2 H5 — when decide_command chose the corrective rewrite,\n232\t        # emit the bash_input_rewritten audit event with the before/after\n233\t        # hash PAIR BEFORE emitting the `ask` decision (mini-ADR-154 §2: the\n234\t        # audit records that the rail rewrote the input, so the downstream\n235\t        # audited command provably equals the executed/asked command). The\n236\t        # emit is fail-open (it never gates the decision).\n237\t        if decision.rewrite is not None:\n238\t            _emit_bash_input_rewritten_event(decision.rewrite)\n239\t        _adapter_emit(\n240\t            _adapter, _to_contract_decision(decision, event.tool_input), event\n241\t        )\n242\t        return 0\n243\t    except Exception as e:  # pragma: no cover\n244\t        print(\n245\t            f\"[check_bash_safety] FATAL: {e.__class__.__name__}: {e}\",\n246\t            file=sys.stderr,\n247\t        )\n248\t        _adapter_emit(_adapter, _contract.allow(), event)\n249\t        return 0\n250\t\n251\t\n252\tif __name__ == \"__main__\":\n253\t    sys.exit(main())\n254\t"}]},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"dfecec39-3964-40a4-a253-50bb5f45c3d0","timestamp":"2026-11-13T18:03:02.621Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_bash_safety_parts/decisions_cli.py","content":"\"\"\"Decision conversion, audit emitters, and hook entry point.\"\"\"\nfrom __future__ import annotations\n\ndef _emit_env_var_hijack_event(hijack_class: str) -> None:\n    \"\"\"Emit env_var_hijack_blocked(hijack_class). Fail-open (PLAN-133 A1).\n\n    The ONLY caller-supplied field is the closed-enum `hijack_c