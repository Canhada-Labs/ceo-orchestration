{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W3chg6XMNdYpdqGwtLptu7","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Parser-aware destructive Bash safety hook facade.\n3\t\n4\tThe executable declarations live in installable `_lib` fragments so that the\n5\tinstaller copies them with the `.claude/hooks` library. Each fragment is compiled into\n6\tthis module's namespace: private names, dataclasses, mutable state and calls\n7\tthrough monkeypatched globals therefore retain the historical behavior.\n8\t\n9\t# Source-surface compatibility marker: def _rewrite_git_push_force is loaded\n10\t# into this facade from ``_bash_safety_parts.rewrite_citation``.\n11\t# Historical staged-test loaders also select this entry point by these names:\n12\t# def _apply_destructive_citation_gate — implementation in rewrite_citation.py.\n13\t# def _apply_fact_gate — implementation in fact_canonical.py.\n14\t\"\"\"\n15\tfrom __future__ import annotations\n16\t\n17\tfrom pathlib import Path\n18\tfrom typing import Tuple\n19\t\n20\t_PARTS: Tuple[str, ...] = (\n21\t    \"normalization\", \"rewrite_citation\", \"fact_state\", \"fact_canonical\",\n22\t    \"posture_tables\", \"posture_parser\", \"posture_scan\", \"decisions_cli\",\n23\t)\n24\t\n25\t\n26\tdef _install_parts() -> None:\n27\t    \"\"\"Execute ordered, inspectable source fragments in this namespace.\n28\t\n29\t    The fragments contain ordinary Python declarations, not proxy exports.\n30\t    Compiling them once with this dictionary preserves historical lookup of\n31\t    helpers and constants through the facade, including test monkeypatches.\n32\t    Their own filenames stay in code objects for ``inspect.getsource``.\n33\t    \"\"\"\n34\t    namespace = globals()\n35\t    parts_dir = Path(__file__).resolve().parent / \"_lib\" / \"_bash_safety_parts\"\n36\t    for part_name in _PARTS:\n37\t        part_path = parts_dir / (part_name + \".py\")\n38\t        source = part_path.read_text(encoding=\"utf-8\")\n39\t        exec(compile(source, str(part_path), \"exec\"), namespace, namespace)\n40\t\n41\t\n42\t_install_parts()\n43\t"}]},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"c25b6baa-55ae-4668-84b6-aee63ef57b0c","timestamp":"2026-11-13T18:02:29.659Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/check_bash_safety.py","content":"#!/usr/bin/env python3\n\"\"\"Parser-aware destructive Bash safety hook facade.\n\nThe executable declarations live in installable `_lib` fragments so that the\ninstaller copies them with the `.claude/hooks` library. Each fragment is compiled into\nthis module's namespace: private names, dataclasses, mutable state and calls\nthrough monkeypatched globals therefore retain the historical behavior.\n\n# Source-surface compatibility marker: def _rewrite_git_push_force is loaded\n# into this facade from ``_bash_safety_parts.rewrite_citation``.\n# Historical staged-test loaders also select this entry point by these names:\n# def _apply_destructive_citation_gate — implementation in rewrite_citation.py.\n# def _apply_fact_gate — implementation in fact_canonical.py.\n\"\"\"\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Tuple\n\n_PARTS: Tuple[str, ...] = (\n    \"normalization\", \"rewrite_citation\", \"fact_state\", \"fact_canonical\",\n    \"posture_tables\", \"posture_parser\", \"posture_scan\", \"decisions_cli\",\n)\n\n\ndef _install_parts() -> None:\n    \"\"\"Execute ordered, inspectable source fragments in this namespace.\n\n    The fragments contain ordinary Python declarations, not proxy exports.\n    Compiling them once with this dictionary preserves historical lookup of\n    helpers and constants through the facade, including test monkeypatches.\n    Their own filenames stay in code objects for ``inspect.getsource``.\n    \"\"\"\n    namespace = globals()\n    parts_dir = Path(__file__).resolve().parent / \"_lib\" / \"_bash_safety_parts\"\n    for part_name in _PARTS:\n        part_path = parts_dir / (part_name + \".py\")\n        source = part_path.read_text(encoding=\"utf-8\")\n        exec(compile(source, str(part_path), \"exec\"), namespace, namespace)\n\n\n_install_parts()\n","numLines":43,"startLine":1,"totalLines":43}},"tool_result_meta":[{"id":"toolu_01W3chg6XMNdYpdqGwtLptu7","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
