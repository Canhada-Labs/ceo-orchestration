       )\n161\t            _adapter_emit(_adapter, _contract.allow(), event)\n162\t            return 0\n163\t\n164\t        command = event.command or \"\"\n165\t        if not command and isinstance(event.tool_input, dict):\n166\t            command = str(event.tool_input.get(\"command\") or \"\")\n167\t\n168\t        try:\n169\t            from _lib import bash_indirect_telemetry as _indirect_telemetry\n170\t            for _switch in (\"CEO_BASH_INDIRECT_GUARD\", \"CEO_BASH_INDIRECT_HEURISTICS\"):\n171\t                if _trusted_env.get_trusted(_switch) == \"0\":\n172\t                    _indirect_telemetry.disabled_once(_switch, event.session_id)\n173\t        except Exception:  # audit infrastructure must not change the verdict\n174\t            pass\n175\t\n176\t        decision = decide_command(command)\n177\t        # PLAN-154 fact gate precedes the PLAN-153 citation pilot for\n178\t        # destructive-class blocks. Both see the final decision.\n179\t        if not decision.allow and decision.destructive:\n180\t            _fact_transcript_path = _extract_transcript_path(_raw_stdin_text)\n181\t            decision, _fact_enforce_active = _apply_fact_gate(\n182\t                decision, command, _fact_transcript_path\n183\t            )\n184\t            if (\n185\t                not decision.allow\n186\t                and decision.destructive\n187\t                and not _fact_enforce_active\n188\t                and _destructive_citation_gate_enabled()\n189\t            ):\n190\t                decision = _apply_destructive_citation_gate(\n191\t                    decision, command, _fact_transcript_path\n192\t                )\n193\t        # <<< PLAN-154.F6 fact-gate END\n194\t        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n195\t        if not decision.allow and decision.reason_code and _audit_emit is not None:\n196\t            try:\n197\t                _audit_emit.emit_veto_triggered(\n198\t                    hook=\"check_bash_safety\