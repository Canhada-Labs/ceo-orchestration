{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XyG4M3yU9Hfqe2TzgYEAkX","type":"tool_result","content":"1\t\"\"\"Force-push rewrite and destructive citation checks.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t_FORCE_PUSH_REWRITE_CLASS = \"git_push_force_to_lease\"\n5\t\n6\t\n7\tdef _force_push_rewrite_enabled() -> bool:\n8\t    \"\"\"True iff the H5 force-push→lease rewrite is enabled (PILOT, default-OFF).\n9\t\n10\t    Enabled ONLY when CEO_BASH_FORCE_PUSH_REWRITE == \"1\" in the import-time\n11\t    trusted_env snapshot (NOT live os.environ — a late-set value cannot toggle\n12\t    the rewriter mid-op). Default-OFF restores the legacy force-push BLOCK as\n13\t    the shipped behavior (existing byte-identity fixtures unchanged); the\n14\t    rewrite is an opt-in pilot. When the snapshot is unavailable the rewrite\n15\t    stays DISABLED (fail to the legacy BLOCK — the most conservative state).\n16\t    Pure; never raises.\n17\t    \"\"\"\n18\t    if _trusted_env is None:  # pragma: no cover — import failure → default-OFF (block)\n19\t        return False\n20\t    try:\n21\t        raw = _trusted_env.get_trusted(_FORCE_PUSH_REWRITE_DISABLE_VAR)\n22\t    except Exception:  # pragma: no cover\n23\t        return False\n24\t    if raw is None:\n25\t        return False\n26\t    return str(raw).strip() == \"1\"\n27\t\n28\t\n29\tdef _sha256_hex(text: str) -> str:\n30\t    \"\"\"sha256 hex digest of ``text`` (utf-8). Pure; never raises.\"\"\"\n31\t    return hashlib.sha256(text.encode(\"utf-8\", \"surrogatepass\")).hexdigest()\n32\t\n33\t\n34\tdef _rewrite_git_push_force(command: str) -> Optional[Rewrite]:\n35\t    \"\"\"Build a `git push --force-with-lease` rewrite, or None to fall back.\n36\t\n37\t    Returns a :class:`Rewrite` ONLY for the pilot pattern — a command that\n38\t    is a SINGLE subcommand (no `&&`/`||`/`;`/`|`), whose normalized tokens\n39\t    are exactly ``git push ...`` carrying ``--force``/``-f`` (and NOT\n40\t    already ``--force-with-lease``). Anything else → None (caller BLOCKs;\n41\t    constraint (a)). The new command is rebuilt token-by-token from the\n42\t    normalized list and re-quoted with ``shlex.quote`` (constraint (c)),\n43\t    so a quoted/embedded ``--force`` literal in a different argv position\n44\t    can never be rewritten.\n45\t\n46\t    Pure function (no I/O). The before/after hashes let the audit event\n47\t    prove audited-cmd == executed-cmd (mini-ADR-154 §2).\n48\t    \"\"\"\n49\t    if not command or not command.strip():\n50\t        return None\n51\t    # Constraint (a)+(c): a COMPOUND command (multiple subcommands) is NOT\n52\t    # rewritten — reassembling a multi-subcommand line from a flat token\n53\t    # view is exactly the injection seam THREAT-MODEL-WORKSHEET §1 names\n54\t    # (`echo \"--force\" && git push -f`). Fall back to BLOCK.\n55\t    subcommands = _split_subcommands(command)\n56\t    if len(subcommands) != 1:\n57\t        return None\n58\t    raw_tokens = _tokenize(subcommands[0])\n59\t    if not raw_tokens:\n60\t        return None  # unparseable → BLOCK (fail-safe)\n61\t    tokens = _normalize_command_tokens(raw_tokens)\n62\t    if len(tokens) < 3 or tokens[0] != \"git\" or tokens[1] != \"push\":\n63\t        return None\n64\t    # The token-list view is the SAME the detector saw. Rewrite EXACTLY the\n65\t    # destructive flag tokens; leave every other token byte-for-byte. If a\n66\t    # `--force-with-lease` is already present we do not touch it.\n67\t    has_force_flag = False\n68\t    new_tokens: List[str] = []\n69\t    for t in tokens:\n70\t        if t == \"--force\" or t == \"-f\":\n71\t            has_force_flag = True\n72\t            new_tokens.append(\"--force-with-lease\")\n73\t        else:\n74\t            new_tokens.append(t)\n75\t    if not has_force_flag:\n76\t        return None  # nothing to rewrite (e.g. already --force-with-lease)\n77\t    # Reassemble with shlex.quote so the rewrite is shell-safe (constraint\n78\t    # (c) — re-quoting closes the round-trip seam). The normalization\n79\t    # already basenamed token[0] and stripped any sudo/escape prefix, which\n80\t    # is the SAME effective command the rail audited and the user intended;\n81\t    # the pilot deliberately does not try to preserve a `/usr/bin/git`\n82\t    # absolute path (it would re-open the path-normalization question).\n83\t    new_command = \" \".join(shlex.quote(tok) for tok in new_tokens)\n84\t    before = _sha256_hex(command)\n85\t    after = _sha256_hex(new_command)\n86\t    # Defense-in-depth: if the rewrite somehow did not change the command\n87\t    # (impossible given has_force_flag, but the audit invariant must hold),\n88\t    # fall back to BLOCK rather than emit a no-op `ask` (constraint (a)).\n89\t    if after == before or new_command == command:  # pragma: no cover\n90\t        return None\n91\t    reason = (\n92\t        \"REWRITTEN (asks before running): `git push --force` → \"\n93\t        \"`git push --force-with-lease`. The original `--force` overwrites \"\n94\t        \"remote commits unconditionally; `--force-with-lease` refuses if \"\n95\t        \"the remote advanced since your last fetch. Review the rewritten \"\n96\t        \"command and approve to proceed, or reject to cancel. \"\n97\t        f\"Rewritten command: {new_command}\"\n98\t    )\n99\t    return Rewrite(\n100\t        new_command=new_command,\n101\t        before_sha256=before,\n102\t        after_sha256=after,\n103\t        rewrite_class=_FORCE_PUSH_REWRITE_CLASS,\n104\t        reason=reason,\n105\t    )\n106\t\n107\t\n108\tdef _git_bypass_escape_hatch_active() -> bool:\n109\t    \"\"\"True iff the proven dual-auth git-bypass escape hatch is set (MF-E).\n110\t\n111\t    Reads BOTH env vars from the import-time trusted_env snapshot (NOT live\n112\t    os.environ): a value set AFTER process trust-anchor is ignored. Requires:\n113\t\n114\t      - ``CEO_GIT_BYPASS_ALLOW``       — non-empty, matches the ticket regex\n115\t        (``ADR-NNN[N]-slug`` | ``PLAN-NNN-slug``)\n116\t      - ``CEO_GIT_BYPASS_ALLOW_ACK``   — exactly ``I-ACCEPT``\n117\t\n118\t    Off-path (missing / wrong ACK / bad ticket) → False → the bypass stays\n119\t    BLOCKED. Pure function (snapshot read only); never raises.\n120\t    \"\"\""}]},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"60d1422f-862a-48a9-9b6e-5a7fe8c2dcf3","timestamp":"2026-11-13T18:06:47.038Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_bash_safety_parts/rewrite_citation.py","content":"\"\"\"Force-push rewrite and destructive citation checks.\"\"\"\nfrom __future__ import annotations\n\n_FORCE_PUSH_REWRITE_CLASS = \"git_push_force_to_lease\"\n\n\ndef _force_push_rewrite_enabled() -> bool:\n    \"\"\"True iff the H5 force-push→lease rewrite is enabled (PILOT, default-OFF).\n\n    Enabled ONLY when CEO_BASH_FORCE_PUSH_REWRITE == \"1\" in the import-time\n    trusted_env snapshot (NOT live os.environ — a late-set value cannot toggle\n    the rewriter mid-op). Default-OFF restores the legacy force-push BLOCK as\n    the shipped behavior (existing byte-identity fixtures unchanged); the\n    rewrite is an opt-in pilot. When the snapshot is unavailable the rewrite\n    stays DISABLED (fail to the legacy BLOCK — the most conservative state).\n    Pure; never raises.\n    \"\"\"\n    if _trusted_env is None:  # pragma: no cover — import failure → default-OFF (block)\n        return False\n    try:\n        raw = _trusted_env.get_trusted(_FORCE_PUSH_REWRITE_DISABLE_VAR)\n    except Exception:  # pragma: no cover\n        return False\n    if raw is None:\n        return False\n    return str(raw).strip() == \"1\"\n\n\ndef _sha256_hex(text: str) -> str:\n    \"\"\"sha256 hex digest of ``text`` (utf-8). Pure; never raises.\"\"\"\n    return hashlib.sha256(text.encode(\"utf-8\", \"surrogatepass\")).hexdigest()\n\n\ndef _rewrite_git_push_force(command: str) -> Optional[Rewrite]:\n    \"\"\"Build a `git push --force-with-lease` rewrite, or None to fall back.\n\n    Returns a :class:`Rewrite` ONLY for the pilot pattern — a command that\n    is a SINGLE subcommand (no `&&`/`||`/`;`/`|`), whose normalized tokens\n    are exactly ``git push ...`` carrying ``--force``/``-f`` (and NOT\n    already ``--force-with-lease``). Anything else → None (caller BLOCKs;\n    constraint (a)). The new command is rebuilt token-by-token from the\n    normalized list and re-quoted with ``shlex.quote`` (constraint (c)),\n    so a quoted/embedded ``--force`` literal in a different argv position\n    can never be rewritten.\n\n    Pure function (no I/O). The before/after hashes let the audit event\n    prove audited-cmd == executed-cmd (mini-ADR-154 §2).\n    \"\"\"\n    if not command or not command.strip():\n        return None\n    # Constraint (a)+(c): a COMPOUND command (multiple subcommands) is NOT\n    # rewritten — reassembling a multi-subcommand line from a flat token\n    # view is exactly the injection seam THREAT-MODEL-WORKSHEET §1 names\n    # (`echo \"--force\" && git push -f`). Fall back to BLOCK.\n    subcommands = _split_subcommands(command)\n    if len(subcommands) != 1:\n        return None\n    raw_tokens = _tokenize(subcommands[0])\n    if not raw_tokens:\n        return None  # unparseable → BLOCK (fail-safe)\n    tokens = _normalize_command_tokens(raw_tokens)\n    if len(tokens) < 3 or tokens[0] != \"git\" or tokens[1] != \"push\":\n        return None\n    # The token-list view is the SAME the detector saw. Rewrite EXACTLY the\n    # destructive flag tokens; leave every other token byte-for-byte. If a\n    # `--force-with-lease` is already present we do not touch it.\n    has_force_flag = False\n    new_tokens: List[str] = []\n    for t in tokens:\n        if t == \"--force\" or t == \"-f\":\n            has_force_flag = True\n            new_tokens.append(\"--force-with-lease\")\n        else:\n            new_tokens.append(t)\n    if not has_force_flag:\n        return None  # nothing to rewrite (e.g. already --force-with-lease)\n    # Reassemble with shlex.quote so the rewrite is shell-safe (constraint\n    # (c) — re-quoting closes the round-trip seam). The normalization\n    # already basenamed token[0] and stripped any sudo/escape prefix, which\n    # is the SAME effective command the rail audited and the user intended;\n    # the pilot deliberately does not try to preserve a `/usr/bin/git`\n    # absolute path (it would re-open the path-normalization question).\n    new_command = \" \".join(shlex.quote(tok) for tok in new_tokens)\n    before = _sha256_hex(command)\n    after = _sha256_hex(new_command)\n    # Defense-in-depth: if the rewrite somehow did not change the command\n    # (impossible given has_force_flag, but the audit invariant must hold),\n    # fall back to BLOCK rather than emit a no-op `ask` (constraint (a)).\n    if after == before or new_command == command:  # pragma: no cover\n        return None\n    reason = (\n        \"REWRITTEN (asks before running): `git push --force` → \"\n        \"`git push --force-with-lease`. The original `--force` overwrites \"\n        \"remote commits unconditionally; `--force-with-lease` refuses if \"\n        \"the remote advanced since your last fetch. Review the rewritten \"\n        \"command and approve to proceed, or reject to cancel. \"\n        f\"Rewritten command: {new_command}\"\n    )\n    return Rewrite(\n        new_command=new_command,\n        before_sha256=before,\n        after_sha256=after,\n        rewrite_class=_FORCE_PUSH_REWRITE_CLASS,\n        reason=reason,\n    )\n\n\ndef _git_bypass_escape_hatch_active() -> bool:\n    \"\"\"True iff the proven dual-auth git-bypass escape hatch is set (MF-E).\n\n    Reads BOTH env vars from the import-time trusted_env snapshot (NOT live\n    os.environ): a value set AFTER process trust-anchor is ignored. Requires:\n\n      - ``CEO_GIT_BYPASS_ALLOW``       — non-empty, matches the ticket regex\n        (``ADR-NNN[N]-slug`` | ``PLAN-NNN-slug``)\n      - ``CEO_GIT_BYPASS_ALLOW_ACK``   — exactly ``I-ACCEPT``\n\n    Off-path (missing / wrong ACK / bad ticket) → False → the bypass stays\n    BLOCKED. Pure function (snapshot read only); never raises.\n    \"\"\"","numLines":120,"startLine":1,"totalLines":590}},"tool_result_meta":[{"id":"toolu_01XyG4M3yU9Hfqe2TzgYEAkX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NXF4ge7kNmUk9Ee45Z","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BMuyDPnfVWa6ud4iV7wgTo","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_bash_safety_parts/rewrite_citation.py","offset":245,"limit":345},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1346,"cache_read_input_tokens":194541,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1346},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"711eb809-0119-4243-9631-b7f0b82523f7","timestamp":"2026-11-13T18:06:49.339Z","request_id":"req_011Ch1NXEmpvfs9YtUbE6TbE","wire_tool_inputs":{"toolu_01BMuyDPnfVWa6ud4iV7wgTo":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_bash_safety_parts/rewrite_citation.py","offset":245,"limit":345}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BMuyDPnfVWa6ud4iV7wgTo","type":"tool_result","content":"245\t        return None\n246\t    if match is None:\n247\t        return None\n248\t    if _git_bypass_escape_hatch_active():\n249\t        return (\"escape\", _git_bypass.FLAG_CLASS_ESCAPE_HATCH, match.reason)\n250\t    return (\"block\", match.flag_class, match.reason)\n251\t\n252\t\n253\tdef _check_credential_leak(command: str) -> Optional[tuple]:\n254\t    \"\"\"Sprint 12 / CRITICAL-2 (ADR-040): scan raw command for live keys.\n255\t    Fail-CLOSED on exception (intentional break from hook's fail-open).\"\"\"\n256\t    if not command:\n257\t        return None\n258\t    try:\n259\t        for provider, match, _off in _credentials.detect_keys(command):\n260\t            if _credentials.is_likely_real_key(match, command):\n261\t                return provider, _credentials.redacted_display(provider, match)\n262\t        return None\n263\t    except Exception as e:\n264\t        print(f\"[check_bash_safety] credential-scan failure; failing closed: \"\n265\t              f\"{e.__class__.__name__}\", file=sys.stderr)\n266\t        return \"unknown\", \"unknown:****\"\n267\t\n268\t\n269\t# >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (gate implementation)\n270\t# -----------------------------------------------------------------------------\n271\t# PLAN-153 Wave E item 5 / ADR-175 half 1 — destructive-Bash CITATION GATE\n272\t# -----------------------------------------------------------------------------\n273\t#\n274\t# When a command classifies as DESTRUCTIVE (rm -rf / git reset --hard /\n275\t# git push --force — Decision.destructive == True), the operator may supply\n276\t# a CITATION: the instruction that justifies the destructive op, quoted\n277\t# VERBATIM, via a leading shell env-assignment on the command itself:\n278\t#\n279\t#     CEO_DESTRUCTIVE_CITE='transcript:<verbatim instruction text>' rm -rf build/\n280\t#     CEO_DESTRUCTIVE_CITE='PLAN-153:<verbatim plan text>'          rm -rf build/\n281\t#\n282\t# Channel rationale: the assignment travels INSIDE `tool_input.command` — the\n283\t# one field this PreToolUse hook actually receives and can verify against the\n284\t# stdin payload (a separate env var would be invisible to the payload; a\n285\t# transcript-adjacent side file would be writable by the same actor issuing\n286\t# the command). `_normalize_command_tokens` strips leading assignments, so\n287\t# the citation prefix can never DE-classify the command (see the env-\n288\t# assignment normalization block above).\n289\t#\n290\t# VERIFICATION (bounded read):\n291\t#   * source `transcript` → the `transcript_path` field of the hook's OWN\n292\t#     stdin payload (Claude Code supplies it on every hook event). Hardening:\n293\t#     the resolved path must live under ~/.claude/ and end in `.jsonl` —\n294\t#     a payload pointing anywhere else fails verification (fail-CLOSED).\n295\t#     The cited text must appear verbatim (raw or JSON-escaped, since\n296\t#     transcripts are JSONL) within the LAST `_CITE_READ_CAP_BYTES` of the\n297\t#     file (recent instructions live at the tail; text beyond the bound\n298\t#     simply fails verification — the fail-closed direction).\n299\t#   * source `PLAN-NNN` → `$CLAUDE_PROJECT_DIR/.claude/plans/PLAN-NNN-*.md`\n300\t#     (PLAN-SCHEMA naming), same bounded read.\n301\t#\n302\t# FAIL-CLOSED (mirrors the `_e3` whole-command parse gate + the\n303\t# `_check_credential_leak` precedent, PLAN-152 debate C4): citation absent /\n304\t# malformed / too short / transcript unreadable / cited text not found ⇒ the\n305\t# destructive op stays BLOCKED with an actionable reason. Fail-OPEN is\n306\t# permitted ONLY on the audit-emit side (an emit failure never flips the\n307\t# decision).\n308\t#\n309\t# ACCEPTED citations are recorded into the HMAC audit chain via\n310\t# `_lib.audit_emit.emit_generic(\"veto_triggered\", ...)` (a passthrough-\n311\t# registered action; a NEW action name would require touching\n312\t# `_lib/audit_emit.py`'s _KNOWN_ACTIONS, outside this unit's scope — the\n313\t# `reason_code=destructive_citation_accepted` + `gate_outcome` fields\n314\t# disambiguate, following the git_hook_bypass_blocked/escape_hatch_used\n315\t# precedent of recording the AUTHORIZED path under the guard's action). The\n316\t# cited text passes `_lib.redact.redact_secrets` and lands in the\n317\t# `cited_instruction_data` field — the `_data` suffix marks it as inert DATA\n318\t# (quoted evidence), never instructions.\n319\t#\n320\t# SCOPE GUARD: the gate keys off `Decision.destructive` ONLY. Canonical-path\n321\t# writes, credential leaks, git hook-bypass and env-hijack blocks are NOT\n322\t# citation-gatable — no citation unlocks those.\n323\t#\n324\t# Pilot flag: CEO_DESTRUCTIVE_CITATION_GATE == \"1\" ENABLES the gate\n325\t# (default-OFF, mirroring the H5 force-push-rewrite pilot: a change that adds\n326\t# an allow path to a hard block ships opt-in until its ceremony + Codex round\n327\t# close). Read from the import-time trusted_env snapshot, NOT live os.environ.\n328\t\n329\t_DESTRUCTIVE_CITE_GATE_VAR = \"CEO_DESTRUCTIVE_CITATION_GATE\"\n330\t_DESTRUCTIVE_CITE_VAR = \"CEO_DESTRUCTIVE_CITE\"\n331\t_CITE_MIN_CHARS = 16                    # a real instruction, not a token\n332\t_CITE_READ_CAP_BYTES = 4 * 1024 * 1024  # bounded tail read (4 MiB)\n333\t_CITE_AUDIT_PREVIEW_CHARS = 400         # cap on cited text entering the chain\n334\t_CITE_PLAN_SOURCE_RE = re.compile(r\"^PLAN-\\d{3}$\")\n335\t_CITE_MAX_PLAN_FILES = 5                # bound the glob fan-out\n336\t\n337\t\n338\tdef _destructive_citation_gate_enabled() -> bool:\n339\t    \"\"\"True iff CEO_DESTRUCTIVE_CITATION_GATE == \"1\" in the trusted_env\n340\t    snapshot (default-OFF pilot). Snapshot unavailability ⇒ DISABLED (the\n341\t    most conservative state: the legacy hard BLOCK). Pure; never raises.\"\"\"\n342\t    if _trusted_env is None:  # pragma: no cover — import failure → default-OFF\n343\t        return False\n344\t    try:\n345\t        raw = _trusted_env.get_trusted(_DESTRUCTIVE_CITE_GATE_VAR)\n346\t    except Exception:  # pragma: no cover\n347\t        return False\n348\t    return (str(raw).strip() == \"1\") if raw is not None else False\n349\t\n350\t\n351\tdef _extract_destructive_citation(command: str) -> \"tuple\":\n352\t    \"\"\"Extract the CEO_DESTRUCTIVE_CITE citation from the command's leading\n353\t    env-assignment prefix.\n354\t\n355\t    Returns a 3-tuple ``(status, source, cited_text)``:\n356\t      * ``(\"absent\", \"\", \"\")``     — no citation assignment in the prefix\n357\t        (also the outcome when the whole command fails shlex — an\n358\t        unparseable command cannot carry a verifiable citation, and the\n359\t        caller's fail-closed handling keeps the op blocked).\n360\t      * ``(\"malformed\", detail, \"\")`` — assignment present but not of shape\n361\t        ``<source>:<verbatim text>`` with source ``transcript`` | ``PLAN-NNN``\n362\t        and text >= _CITE_MIN_CHARS.\n363\t      * ``(\"ok\", source, cited_text)`` — well-formed citation.\n364\t\n365\t    Only the LEADING assignment run is scanned (shell semantics: assignments\n366\t    after the first command word are arguments, not environment). Pure;\n367\t    never raises.\n368\t    \"\"\"\n369\t    if not command or not command.strip():\n370\t        return (\"absent\", \"\", \"\")\n371\t    try:\n372\t        tokens = shlex.split(command)\n373\t    except ValueError:\n374\t        return (\"absent\", \"\", \"\")\n375\t    value = None  # type: Optional[str]\n376\t    for tok in tokens:\n377\t        if not _ENV_ASSIGNMENT_RE.match(tok):\n378\t            break  # first non-assignment token ends the env prefix run\n379\t        name, _, rest = tok.partition(\"=\")\n380\t        if name == _DESTRUCTIVE_CITE_VAR:\n381\t            value = rest\n382\t            break\n383\t    if value is None:\n384\t        return (\"absent\", \"\", \"\")\n385\t    source, sep, cited = value.partition(\":\")\n386\t    if not sep:\n387\t        return (\n388\t            \"malformed\",\n389\t            \"missing ':' separator (expected '<source>:<verbatim text>')\",\n390\t            \"\",\n391\t        )\n392\t    source = source.strip()\n393\t    if source != \"transcript\" and not _CITE_PLAN_SOURCE_RE.match(source):\n394\t        return (\n395\t            \"malformed\",\n396\t            \"unknown source %r (expected 'transcript' or 'PLAN-NNN')\" % source,\n397\t            \"\",\n398\t        )\n399\t    if len(cited) < _CITE_MIN_CHARS:\n400\t        return (\n401\t            \"malformed\",\n402\t            \"cited text under %d chars — quote the justifying instruction \"\n403\t            \"verbatim, not a fragment\" % _CITE_MIN_CHARS,\n404\t            \"\",\n405\t        )\n406\t    return (\"ok\", source, cited)\n407\t\n408\t\n409\tdef _cite_bounded_tail_read(path: \"Path\") -> str:\n410\t    \"\"\"Read at most the LAST _CITE_READ_CAP_BYTES of ``path`` as utf-8\n411\t    (errors=replace). Raises OSError family on unreadable paths — the\n412\t    CALLER converts that to a fail-CLOSED block.\"\"\"\n413\t    import os as _os\n414\t    size = _os.path.getsize(str(path))\n415\t    with open(str(path), \"rb\") as fh:\n416\t        if size > _CITE_READ_CAP_BYTES:\n417\t            fh.seek(size - _CITE_READ_CAP_BYTES)\n418\t        data = fh.read(_CITE_READ_CAP_BYTES)\n419\t    return data.decode(\"utf-8\", \"replace\")\n420\t\n421\t\n422\tdef _cite_needles(cited_text: str) -> \"List[str]\":\n423\t    \"\"\"The raw cited text + its JSON-escaped form (transcripts are JSONL, so\n424\t    an instruction containing quotes/newlines is stored escaped).\"\"\"\n425\t    needles = [cited_text]\n426\t    try:\n427\t        escaped = json.dumps(cited_text, ensure_ascii=False)[1:-1]\n428\t        if escaped != cited_text:\n429\t            needles.append(escaped)\n430\t    except Exception:  # pragma: no cover — dumps on str cannot realistically fail\n431\t        pass\n432\t    return needles\n433\t\n434\t\n435\tdef _verify_destructive_citation(\n436\t    source: str,\n437\t    cited_text: str,\n438\t    transcript_path: str,\n439\t) -> \"tuple\":\n440\t    \"\"\"Verify ``cited_text`` appears verbatim in the source it points at.\n441\t\n442\t    Returns ``(ok, detail, source_class)`` where ``source_class`` is the\n443\t    closed enum ``\"transcript\"`` | ``\"plan\"`` (for the audit record) and\n444\t    ``detail`` is an actionable failure description on ``ok == False``.\n445\t\n446\t    FAIL-CLOSED BY CONSTRUCTION: every unexpected exception is caught and\n447\t    converted to ``(False, ...)`` — content the gate cannot verify is\n448\t    blocked, never waved through (the `_e3` / C4 precedent).\n449\t    \"\"\"\n450\t    import os as _os\n451\t    try:\n452\t        if source == \"transcript\":\n453\t            if not transcript_path:\n454\t                return (\n455\t                    False,\n456\t                    \"hook payload carried no transcript_path (cannot verify \"\n457\t                    \"a 'transcript:' citation in this session)\",\n458\t                    \"transcript\",\n459\t                )\n460\t            real = _os.path.realpath(transcript_path)\n461\t            claude_root = _os.path.realpath(\n462\t                _os.path.join(_os.path.expanduser(\"~\"), \".claude\")\n463\t            )\n464\t            if not real.startswith(claude_root + _os.sep):\n465\t                return (\n466\t                    False,\n467\t                    \"transcript_path resolves outside ~/.claude/ \"\n468\t                    \"(refusing to verify against an arbitrary file)\",\n469\t                    \"transcript\",\n470\t                )\n471\t            if not real.endswith(\".jsonl\"):\n472\t                return (\n473\t                    False,\n474\t                    \"transcript_path is not a .jsonl session transcript\",\n475\t                    \"transcript\",\n476\t                )\n477\t            if not _os.path.isfile(real):\n478\t                return (\n479\t                    False,\n480\t                    \"transcript file does not exist or is not a regular file\",\n481\t                    \"transcript\",\n482\t                )\n483\t            content = _cite_bounded_tail_read(Path(real))\n484\t            for needle in _cite_needles(cited_text):\n485\t                if needle in content:\n486\t                    return (True, \"\", \"transcript\")\n487\t            return (\n488\t                False,\n489\t                \"cited text not found in the session transcript (last %d \"\n490\t                \"bytes searched) — the citation must be VERBATIM\"\n491\t                % _CITE_READ_CAP_BYTES,\n492\t                \"transcript\",\n493\t            )\n494\t        # PLAN-NNN source. Codex pair-rail P2 (S261 landing): a plan file is\n495\t        # NOT a trusted citation source. Any agent can plant a line in a draft\n496\t        # `.claude/plans/PLAN-NNN-*.md` and then cite it to flip a destructive\n497\t        # command from BLOCK to ALLOW. Per the repo's fail-CLOSED rule for\n498\t        # security matchers, only the session TRANSCRIPT (append-only, written\n499\t        # by the harness, not plantable by the agent) is a trusted source for\n500\t        # authorizing a destructive op. Plan citations are rejected — cite the\n501\t        # instruction via the session transcript instead. (A future signed-\n502\t        # sentinel citation channel could reinstate a trusted file source.)\n503\t        return (\n504\t            False,\n505\t            \"plan-file citations are not a trusted source (an agent can plant \"\n506\t            \"a line in a draft plan) — cite the authorizing instruction via \"\n507\t            \"the session transcript instead\",\n508\t            \"plan\",\n509\t        )\n510\t    except Exception as e:\n511\t        # FAIL-CLOSED: unreadable source == unverifiable citation == block.\n512\t        return (\n513\t            False,\n514\t            \"citation source read failed (%s) — cannot verify, so the op \"\n515\t            \"stays blocked\" % e.__class__.__name__,\n516\t            \"transcript\" if source == \"transcript\" else \"plan\",\n517\t        )\n518\t\n519\t\n520\tdef _emit_destructive_citation_accepted(\n521\t    source_class: str, source: str, cited_text: str\n522\t) -> None:\n523\t    \"\"\"Record the ACCEPTED citation into the HMAC audit chain. Fail-open\n524\t    (an emit failure never flips the allow) — but NEVER writes the cited\n525\t    text unredacted: if the redactor is unavailable the text is withheld.\"\"\"\n526\t    if _audit_emit is None:\n527\t        return\n528\t    try:\n529\t        try:\n530\t            from _lib.redact import redact_secrets as _redact_secrets\n531\t            cited_data = _redact_secrets(\n532\t                cited_text, max_chars=_CITE_AUDIT_PREVIEW_CHARS\n533\t            )\n534\t        except Exception:\n535\t            cited_data = \"[REDACTION-UNAVAILABLE: cited text withheld]\"\n536\t        import os as _os\n537\t        _audit_emit.emit_generic(\n538\t            \"veto_triggered\",\n539\t            hook=\"check_bash_safety\",\n540\t            reason_code=\"destructive_citation_accepted\",\n541\t            reason_preview=(\n542\t                \"destructive Bash ALLOWED via verified citation \"\n543\t                \"(source=%s); see cited_instruction_data\" % source_class\n544\t            ),\n545\t            blocked_tool=\"Bash\",\n546\t            gate_outcome=\"allowed_with_citation\",\n547\t            cite_source_class=source_class,\n548\t            cite_source_label=source[:80],\n549\t            # DATA field (ADR-175): quoted evidence of the justifying\n550\t            # instruction — redacted, truncated, inert. Never instructions.\n551\t            cited_instruction_data=cited_data,\n552\t            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n553\t            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n554\t        )\n555\t    except Exception:  # pragma: no cover — fail-open on emit only\n556\t        pass\n557\t\n558\t\n559\tdef _emit_destructive_citation_rejected(detail: str) -> None:\n560\t    \"\"\"Record a citation verify-failure (the op was BLOCKED). Metadata only —\n561\t    the cited bytes are NOT persisted on the reject path. Fail-open.\"\"\"\n562\t    if _audit_emit is None:\n563\t        return\n564\t    try:\n565\t        _audit_emit.emit_veto_triggered(\n566\t            hook=\"check_bash_safety\",\n567\t            reason_code=\"destructive_citation_verify_failed\",\n568\t            reason_preview=detail[:200],\n569\t            blocked_tool=\"Bash\",\n570\t        )\n571\t    except Exception:  # pragma: no cover — fail-open on emit only\n572\t        pass\n573\t\n574\t\n575\tdef _extract_transcript_path(raw_stdin_text: str) -> str:\n576\t    \"\"\"Best-effort read of the top-level `transcript_path` field from the\n577\t    hook's raw stdin payload (the adapter's NormalizedEvent deliberately\n578\t    drops it — deny-by-default raw_payload — so we parse the buffered raw\n579\t    text ourselves). Returns \"\" on any parse issue; a missing path only\n580\t    ever FAILS a 'transcript:' citation (fail-closed), never allows.\"\"\"\n581\t    try:\n582\t        data = json.loads(raw_stdin_text)\n583\t        if isinstance(data, dict):\n584\t            tp = data.get(\"transcript_path\")\n585\t            if isinstance(tp, str):\n586\t                return tp\n587\t    except Exception:\n588\t        pass\n589\t    return \"\""}]},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"a3dcd6c4-0057-4eee-9c56-6d1f478254fa","timestamp":"2026-11-13T18:06:49.360Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_bash_safety_parts/rewrite_citation.py","content":"        return None\n    if match is None:\n        return None\n    if _git_bypass_escape_hatch_active():\n        return (\"escape\", _git_bypass.FLAG_CLASS_ESCAPE_HATCH, match.reason)\n    return (\"block\", match.flag_class, match.reason)\n\n\ndef _check_credential_leak(command: str) -> Optional[tuple]:\n    \"\"\"Sprint 12 / CRITICAL-2 (ADR-040): scan raw command for live keys.\n    Fail-CLOSED on exception (intentional break from hook's fail-open).\"\"\"\n    if not command:\n        return None\n    try:\n        for provider, match, _off in _credentials.detect_keys(command):\n            if _credentials.is_likely_real_key(match, command):\n                return provider, _credentials.redacted_display(provider, match)\n        return None\n    except Exception as e:\n        print(f\"[check_bash_safety] credential-scan failure; failing closed: \"\n              f\"{e.__class__.__name__}\", file=sys.stderr)\n        return \"unknown\", \"unknown:****\"\n\n\n# >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (gate implementation)\n# -----------------------------------------------------------------------------\n# PLAN-153 Wave E item 5 / ADR-175 half 1 — destructive-Bash CITATION GATE\n# -----------------------------------------------------------------------------\n#\n# When a command classifies as DESTRUCTIVE (rm -rf / git reset --hard /\n# git push --force — Decision.destructive == True), the operator may supply\n# a CITATION: the instruction that justifies the destructive op, quoted\n# VERBATIM, via a leading shell env-assignment on the command itself:\n#\n#     CEO_DESTRUCTIVE_CITE='transcript:<verbatim instruction text>' rm -rf build/\n#     CEO_DESTRUCTIVE_CITE='PLAN-153:<verbatim plan text>'          rm -rf build/\n#\n# Channel rationale: the assignment travels INSIDE `tool_input.command` — the\n# one field this PreToolUse hook actually receives and can verify against the\n# stdin payload (a separate env var would be invisible to the payload; a\n# transcript-adjacent side file would be writable by the same actor issuing\n# the command). `_normalize_command_tokens` strips leading assignments, so\n# the citation prefix can never DE-classify the command (see the env-\n# assignment normalization block above).\n#\n# VERIFICATION (bounded read):\n#   * source `transcript` → the `transcript_path` field of the hook's OWN\n#     stdin payload (Claude Code supplies it on every hook event). Hardening:\n#     the resolved path must live under ~/.claude/ and end in `.jsonl` —\n#     a payload pointing anywhere else fails verification (fail-CLOSED).\n#     The cited text must appear verbatim (raw or JSON-escaped, since\n#     transcripts are JSONL) within the LAST `_CITE_READ_CAP_BYTES` of the\n#     file (recent instructions live at the tail; text beyond the bound\n#     simply fails verification — the fail-closed direction).\n#   * source `PLAN-NNN` → `$CLAUDE_PROJECT_DIR/.claude/plans/PLAN-NNN-*.md`\n#     (PLAN-SCHEMA naming), same bounded read.\n#\n# FAIL-CLOSED (mirrors the `_e3` whole-command parse gate + the\n# `_check_credential_leak` precedent, PLAN-152 debate C4): citation absent /\n# malformed / too short / transcript unreadable / cited text not found ⇒ the\n# destructive op stays BLOCKED with an actionable reason. Fail-OPEN is\n# permitted ONLY on the audit-emit side (an emit failure never flips the\n# decision).\n#\n# ACCEPTED citations are recorded into the HMAC audit chain via\n# `_lib.audit_emit.emit_generic(\"veto_triggered\", ...)` (a passthrough-\n# registered action; a NEW action name would require touching\n# `_lib/audit_emit.py`'s _KNOWN_ACTIONS, outside this unit's scope — the\n# `reason_code=destructive_citation_accepted` + `gate_outcome` fields\n# disambiguate, following the git_hook_bypass_blocked/escape_hatch_used\n# precedent of recording the AUTHORIZED path under the guard's action). The\n# cited text passes `_lib.redact.redact_secrets` and lands in the\n# `cited_instruction_data` field — the `_data` suffix marks it as inert DATA\n# (quoted evidence), never instructions.\n#\n# SCOPE GUARD: the gate keys off `Decision.destructive` ONLY. Canonical-path\n# writes, credential leaks, git hook-bypass and env-hijack blocks are NOT\n# citation-gatable — no citation unlocks those.\n#\n# Pilot flag: CEO_DESTRUCTIVE_CITATION_GATE == \"1\" ENABLES the gate\n# (default-OFF, mirroring the H5 force-push-rewrite pilot: a change that adds\n# an allow path to a hard block ships opt-in until its ceremony + Codex round\n# close). Read from the import-time trusted_env snapshot, NOT live os.environ.\n\n_DESTRUCTIVE_CITE_GATE_VAR = \"CEO_DESTRUCTIVE_CITATION_GATE\"\n_DESTRUCTIVE_CITE_VAR = \"CEO_DESTRUCTIVE_CITE\"\n_CITE_MIN_CHARS = 16                    # a real instruction, not a token\n_CITE_READ_CAP_BYTES = 4 * 1024 * 1024  # bounded tail read (4 MiB)\n_CITE_AUDIT_PREVIEW_CHARS = 400         # cap on cited text entering the chain\n_CITE_PLAN_SOURCE_RE = re.compile(r\"^PLAN-\\d{3}$\")\n_CITE_MAX_PLAN_FILES = 5                # bound the glob fan-out\n\n\ndef _destructive_citation_gate_enabled() -> bool:\n    \"\"\"True iff CEO_DESTRUCTIVE_CITATION_GATE == \"1\" in the trusted_env\n    snapshot (default-OFF pilot). Snapshot unavailability ⇒ DISABLED (the\n    most conservative state: the legacy hard BLOCK). Pure; never raises.\"\"\"\n    if _trusted_env is None:  # pragma: no cover — import failure → default-OFF\n        return False\n    try:\n        raw = _trusted_env.get_trusted(_DESTRUCTIVE_CITE_GATE_VAR)\n    except Exception:  # pragma: no cover\n        return False\n    return (str(raw).strip() == \"1\") if raw is not None else False\n\n\ndef _extract_destructive_citation(command: str) -> \"tuple\":\n    \"\"\"Extract the CEO_DESTRUCTIVE_CITE citation from the command's leading\n    env-assignment prefix.\n\n    Returns a 3-tuple ``(status, source, cited_text)``:\n      * ``(\"absent\", \"\", \"\")``     — no citation assignment in the prefix\n        (also the outcome when the whole command fails shlex — an\n        unparseable command cannot carry a verifiable citation, and the\n        caller's fail-closed handling keeps the op blocked).\n      * ``(\"malformed\", detail, \"\")`` — assignment present but not of shape\n        ``<source>:<verbatim text>`` with source ``transcript`` | ``PLAN-NNN``\n        and text >= _CITE_MIN_CHARS.\n      * ``(\"ok\", source, cited_text)`` — well-formed citation.\n\n    Only the LEADING assignment run is scanned (shell semantics: assignments\n    after the first command word are arguments, not environment). Pure;\n    never raises.\n    \"\"\"\n    if not command or not command.strip():\n        return (\"absent\", \"\", \"\")\n    try:\n        tokens = shlex.split(command)\n    except ValueError:\n        return (\"absent\", \"\", \"\")\n    value = None  # type: Optional[str]\n    for tok in tokens:\n        if not _ENV_ASSIGNMENT_RE.match(tok):\n            break  # first non-assignment token ends the env prefix run\n        name, _, rest = tok.partition(\"=\")\n        if name == _DESTRUCTIVE_CITE_VAR:\n            value = rest\n            break\n    if value is None:\n        return (\"absent\", \"\", \"\")\n    source, sep, cited = value.partition(\":\")\n    if not sep:\n        return (\n            \"malformed\",\n            \"missing ':' separator (expected '<source>:<verbatim text>')\",\n            \"\",\n        )\n    source = source.strip()\n    if source != \"transcript\" and not _CITE_PLAN_SOURCE_RE.match(source):\n        return (\n            \"malformed\",\n            \"unknown source %r (expected 'transcript' or 'PLAN-NNN')\" % source,\n            \"\",\n        )\n    if len(cited) < _CITE_MIN_CHARS:\n        return (\n            \"malformed\",\n            \"cited text under %d chars — quote the justifying instruction \"\n            \"verbatim, not a fragment\" % _CITE_MIN_CHARS,\n            \"\",\n        )\n    return (\"ok\", source, cited)\n\n\ndef _cite_bounded_tail_read(path: \"Path\") -> str:\n    \"\"\"Read at most the LAST _CITE_READ_CAP_BYTES of ``path`` as utf-8\n    (errors=replace). Raises OSError family on unreadable paths — the\n    CALLER converts that to a fail-CLOSED block.\"\"\"\n    import os as _os\n    size = _os.path.getsize(str(path))\n    with open(str(path), \"rb\") as fh:\n        if size > _CITE_READ_CAP_BYTES:\n            fh.seek(size - _CITE_READ_CAP_BYTES)\n        data = fh.read(_CITE_READ_CAP_BYTES)\n    return data.decode(\"utf-8\", \"replace\")\n\n\ndef _cite_needles(cited_text: str) -> \"List[str]\":\n    \"\"\"The raw cited text + its JSON-escaped form (transcripts are JSONL, so\n    an instruction containing quotes/newlines is stored escaped).\"\"\"\n    needles = [cited_text]\n    try:\n        escaped = json.dumps(cited_text, ensure_ascii=False)[1:-1]\n        if escaped != cited_text:\n            needles.append(escaped)\n    except Exception:  # pragma: no cover — dumps on str cannot realistically fail\n        pass\n    return needles\n\n\ndef _verify_destructive_citation(\n    source: str,\n    cited_text: str,\n    transcript_path: str,\n) -> \"tuple\":\n    \"\"\"Verify ``cited_text`` appears verbatim in the source it points at.\n\n    Returns ``(ok, detail, source_class)`` where ``source_class`` is the\n    closed enum ``\"transcript\"`` | ``\"plan\"`` (for the audit record) and\n    ``detail`` is an actionable failure description on ``ok == False``.\n\n    FAIL-CLOSED BY CONSTRUCTION: every unexpected exception is caught and\n    converted to ``(False, ...)`` — content the gate cannot verify is\n    blocked, never waved through (the `_e3` / C4 precedent).\n    \"\"\"\n    import os as _os\n    try:\n        if source == \"transcript\":\n            if not transcript_path:\n                return (\n                    False,\n                    \"hook payload carried no transcript_path (cannot verify \"\n                    \"a 'transcript:' citation in this session)\",\n                    \"transcript\",\n                )\n            real = _os.path.realpath(transcript_path)\n            claude_root = _os.path.realpath(\n                _os.path.join(_os.path.expanduser(\"~\"), \".claude\")\n            )\n            if not real.startswith(claude_root + _os.sep):\n                return (\n                    False,\n                    \"transcript_path resolves outside ~/.claude/ \"\n                    \"(refusing to verify against an arbitrary file)\",\n                    \"transcript\",\n                )\n            if not real.endswith(\".jsonl\"):\n                return (\n                    False,\n                    \"transcript_path is not a .jsonl session transcript\",\n                    \"transcript\",\n                )\n            if not _os.path.isfile(real):\n                return (\n                    False,\n                    \"transcript file does not exist or is not a regular file\",\n                    \"transcript\",\n                )\n            content = _cite_bounded_tail_read(Path(real))\n            for needle in _cite_needles(cited_text):\n                if needle in content:\n                    return (True, \"\", \"transcript\")\n            return (\n                False,\n                \"cited text not found in the session transcript (last %d \"\n                \"bytes searched) — the citation must be VERBATIM\"\n                % _CITE_READ_CAP_BYTES,\n                \"transcript\",\n            )\n        # PLAN-NNN source. Codex pair-rail P2 (S261 landing): a plan file is\n        # NOT a trusted citation source. Any agent can plant a line in a draft\n        # `.claude/plans/PLAN-NNN-*.md` and then cite it to flip a destructive\n        # command from BLOCK to ALLOW. Per the repo's fail-CLOSED rule for\n        # security matchers, only the session TRANSCRIPT (append-only, written\n        # by the harness, not plantable by the agent) is a trusted source for\n        # authorizing a destructive op. Plan citations are rejected — cite the\n        # instruction via the session transcript instead. (A future signed-\n        # sentinel citation channel could reinstate a trusted file source.)\n        return (\n            False,\n            \"plan-file citations are not a trusted source (an agent can plant \"\n            \"a line in a draft plan) — cite the authorizing instruction via \"\n            \"the session transcript instead\",\n            \"plan\",\n        )\n    except Exception as e:\n        # FAIL-CLOSED: unreadable source == unverifiable citation == block.\n        return (\n            False,\n            \"citation source read failed (%s) — cannot verify, so the op \"\n            \"stays blocked\" % e.__class__.__name__,\n            \"transcript\" if source == \"transcript\" else \"plan\",\n        )\n\n\ndef _emit_destructive_citation_accepted(\n    source_class: str, source: str, cited_text: str\n) -> None:\n    \"\"\"Record the ACCEPTED citation into the HMAC audit chain. Fail-open\n    (an emit failure never flips the allow) — but NEVER writes the cited\n    text unredacted: if the redactor is unavailable the text is withheld.\"\"\"\n    if _audit_emit is None:\n        return\n    try:\n        try:\n            from _lib.redact import redact_secrets as _redact_secrets\n            cited_data = _redact_secrets(\n                cited_text, max_chars=_CITE_AUDIT_PREVIEW_CHARS\n            )\n        except Exception:\n            cited_data = \"[REDACTION-UNAVAILABLE: cited text withheld]\"\n        import os as _os\n        _audit_emit.emit_generic(\n            \"veto_triggered\",\n            hook=\"check_bash_safety\",\n            reason_code=\"destructive_citation_accepted\",\n            reason_preview=(\n                \"destructive Bash ALLOWED via verified citation \"\n                \"(source=%s); see cited_instruction_data\" % source_class\n            ),\n            blocked_tool=\"Bash\",\n            gate_outcome=\"allowed_with_citation\",\n            cite_source_class=source_class,\n            cite_source_label=source[:80],\n            # DATA field (ADR-175): quoted evidence of the justifying\n            # instruction — redacted, truncated, inert. Never instructions.\n            cited_instruction_data=cited_data,\n            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:  # pragma: no cover — fail-open on emit only\n        pass\n\n\ndef _emit_destructive_citation_rejected(detail: str) -> None:\n    \"\"\"Record a citation verify-failure (the op was BLOCKED). Metadata only —\n    the cited bytes are NOT persisted on the reject path. Fail-open.\"\"\"\n    if _audit_emit is None:\n        return\n    try:\n        _audit_emit.emit_veto_triggered(\n            hook=\"check_bash_safety\",\n            reason_code=\"destructive_citation_verify_failed\",\n            reason_preview=detail[:200],\n            blocked_tool=\"Bash\",\n        )\n    except Exception:  # pragma: no cover — fail-open on emit only\n        pass\n\n\ndef _extract_transcript_path(raw_stdin_text: str) -> str:\n    \"\"\"Best-effort read of the top-level `transcript_path` field from the\n    hook's raw stdin payload (the adapter's NormalizedEvent deliberately\n    drops it — deny-by-default raw_payload — so we parse the buffered raw\n    text ourselves). Returns \"\" on any parse issue; a missing path only\n    ever FAILS a 'transcript:' citation (fail-closed), never allows.\"\"\"\n    try:\n        data = json.loads(raw_stdin_text)\n        if isinstance(data, dict):\n            tp = data.get(\"transcript_path\")\n            if isinstance(tp, str):\n                return tp\n    except Exception:\n        pass\n    return \"\"","numLines":345,"startLine":245,"totalLines":590}},"tool_result_meta":[{"id":"toolu_01BMuyDPnfVWa6ud4iV7wgTo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
