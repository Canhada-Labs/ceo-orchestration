{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MiAtvVjGDWn38iZmbmtYLG","type":"tool_result","content":"1\t\"\"\"Fact-gate continuation and canonical-path checks.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _apply_fact_gate(\n5\t    decision: \"Decision\",\n6\t    command: str,\n7\t    transcript_path: str,\n8\t    now_fn=None,\n9\t) -> \"tuple\":\n10\t    \"\"\"Apply the PLAN-154 deny-once fact gate to a DESTRUCTIVE block.\n11\t\n12\t    Called from main() ONLY on the already-matched rare path\n13\t    (``not decision.allow and decision.destructive``). Returns\n14\t    ``(decision, enforce_active)`` — when ``enforce_active`` is True the\n15\t    caller must SKIP the ADR-175 pilot gate (deny-once owns the outcome).\n16\t\n17\t    ``now_fn`` is the injectable clock seam (A9; wall clock only as the\n18\t    default) — timestamps are used solely for record eviction ordering.\n19\t\n20\t    INFRASTRUCTURE exceptions return the incoming decision unchanged\n21\t    (which on this path is already a BLOCK) with ``enforce_active=False``;\n22\t    the INPUT side (citation verification) stays fail-CLOSED inside\n23\t    `_verify_destructive_citation`.\n24\t    \"\"\"\n25\t    try:\n26\t        enforce_enabled, source = _fact_gate_enforce_state()\n27\t        shadow_enabled = _fact_gate_shadow_enabled()\n28\t        if not enforce_enabled and not shadow_enabled:\n29\t            return (decision, False)  # structurally off — zero delta\n30\t        import os as _os\n31\t        import time as _time\n32\t        now = (now_fn or _time.time)()\n33\t        session_id = _os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n34\t        state_path = _fact_gate_state_path(session_id)\n35\t\n36\t        emit_activation = None  # type: Optional[bool]\n37\t        emit_disabled_breadcrumb = False\n38\t        cite_status = \"absent\"\n39\t        source_class = \"\"\n40\t        verify_detail = \"\"\n41\t        prior = False\n42\t        command_sha = \"\"\n43\t\n44\t        with _FactGateLock(state_path):\n45\t            state = _fact_gate_load(state_path)\n46\t            records = state.setdefault(\"records\", {})\n47\t            flags = state.setdefault(\"flags\", {})\n48\t\n49\t            # (e) lazy activation-change detection → governance event.\n50\t            last = state.get(\"enforce_state\")\n51\t            last_enabled = bool(last.get(\"enabled\")) if isinstance(last, dict) else False\n52\t            if last_enabled != enforce_enabled:\n53\t                emit_activation = enforce_enabled\n54\t            state[\"enforce_state\"] = {\"enabled\": enforce_enabled, \"source\": source}\n55\t\n56\t            # (A12) once-per-session disabled breadcrumb: an explicit env\n57\t            # emergency-off suppressed an otherwise-armed enforce flip.\n58\t            if (\n59\t                not enforce_enabled\n60\t                and source == \"env_emergency_off\"\n61\t                and not flags.get(\"disabled_breadcrumb\")\n62\t            ):\n63\t                emit_disabled_breadcrumb = True\n64\t                flags[\"disabled_breadcrumb\"] = True\n65\t\n66\t            normalized = _fact_gate_normalize(command)\n67\t            if normalized is None:\n68\t                # Unparseable command: no stable hash → never releasable\n69\t                # (fail-CLOSED). Persist the observed enforce state only.\n70\t                _fact_gate_save(state_path, state)\n71\t                if emit_activation is not None:\n72\t                    _emit_fact_gate_activation_changed(emit_activation, source)\n73\t                if emit_disabled_breadcrumb:\n74\t                    _emit_learning_rail_disabled(\"fact_gate\", _FACT_GATE_ENFORCE_VAR)\n75\t                return (decision, enforce_enabled)\n76\t\n77\t            command_sha = hashlib.sha256(\n78\t                normalized.encode(\"utf-8\")\n79\t            ).hexdigest()\n80\t            prior = command_sha in records\n81\t\n82\t            status, src_or_detail, cited = _extract_destructive_citation(command)\n83\t            if status in (\"absent\", \"malformed\"):\n84\t                cite_status = status\n85\t                verify_detail = src_or_detail\n86\t            else:\n87\t                cite_status = \"unverified\"\n88\t                # Verification I/O runs ONLY when release is possible:\n89\t                # well-formed citation AND a prior deny record (item 6c).\n90\t                if prior:\n91\t                    ok, verify_detail, source_class = _verify_destructive_citation(\n92\t                        src_or_detail, cited, transcript_path\n93\t                    )\n94\t                    cite_status = \"verified\" if ok else \"verify_failed\"\n95\t\n96\t            if enforce_enabled and cite_status == \"verified\":\n97\t                rec = records.get(command_sha)\n98\t                if not isinstance(rec, dict):  # pragma: no cover — prior implies dict\n99\t                    rec = {\"first_denied_s\": now, \"denials\": 0}\n100\t                rec[\"released\"] = True\n101\t                rec[\"releases\"] = int(rec.get(\"releases\", 0)) + 1\n102\t                records[command_sha] = rec\n103\t                _fact_gate_save(state_path, state)\n104\t            elif enforce_enabled or cite_status != \"verified\":\n105\t                # Deny (enforce) or would-deny (shadow): record the hash so\n106\t                # an exact retry can release / be measured.\n107\t                rec = records.get(command_sha)\n108\t                if not isinstance(rec, dict):\n109\t                    rec = {\"first_denied_s\": now, \"denials\": 0, \"released\": False}\n110\t                rec[\"denials\"] = int(rec.get(\"denials\", 0)) + 1\n111\t                records[command_sha] = rec\n112\t                _fact_gate_evict(records)\n113\t                _fact_gate_save(state_path, state)\n114\t            else:\n115\t                # shadow would-release: state unchanged beyond enforce_state.\n116\t                _fact_gate_save(state_path, state)\n117\t\n118\t        # --- emits + decision shaping happen OUTSIDE the lock ---------\n119\t        if emit_activation is not None:\n120\t            _emit_fact_gate_activation_changed(emit_activation, source)\n121\t        if emit_disabled_breadcrumb:\n122\t            _emit_learning_rail_disabled(\"fact_gate\", _FACT_GATE_ENFORCE_VAR)\n123\t\n124\t        if enforce_enabled:\n125\t            if cite_status == \"verified\":\n126\t                _fact_gate_emit(\n127\t                    \"fact_gate_released\",\n128\t                    gate_outcome=\"allowed_with_fact_gate_release\",\n129\t                    command_sha256=command_sha,\n130\t                    cite_status=cite_status,\n131\t                    prior_deny=True,\n132\t                    mode=\"enforce\",\n133\t                    source_class=source_class,\n134\t                    cited_text=cited,\n135\t                )\n136\t                return (Decision(allow=True), True)\n137\t            _fact_gate_emit(\n138\t                \"fact_gate_denied\",\n139\t                gate_outcome=\"blocked_deny_once\",\n140\t                command_sha256=command_sha,\n141\t                cite_status=cite_status,\n142\t                prior_deny=prior,\n143\t                mode=\"enforce\",\n144\t                source_class=source_class,\n145\t            )\n146\t            return (\n147\t                Decision(\n148\t                    allow=False,\n149\t                    reason=_fact_gate_deny_reason(\n150\t                        decision.reason, command_sha, cite_status, verify_detail\n151\t                    ),\n152\t                    destructive=True,\n153\t                ),\n154\t                True,\n155\t            )\n156\t\n157\t        # SHADOW: decision untouched; telemetry + dampened advisory only.\n158\t        would = \"release\" if cite_status == \"verified\" else \"deny\"\n159\t        _fact_gate_emit(\n160\t            \"fact_gate_shadow_release\" if would == \"release\" else \"fact_gate_shadow_deny\",\n161\t            gate_outcome=(\n162\t                \"shadow_would_release\" if would == \"release\" else \"shadow_would_deny\"\n163\t            ),\n164\t            command_sha256=command_sha,\n165\t            cite_status=cite_status,\n166\t            prior_deny=prior,\n167\t            mode=\"shadow\",\n168\t            source_class=source_class,\n169\t        )\n170\t        _fact_gate_shadow_advisory(command_sha, would, session_id)\n171\t        return (decision, False)\n172\t    except Exception as e:\n173\t        # INFRASTRUCTURE fail-open: never crash the hook; the incoming\n174\t        # decision (a BLOCK on this path) stands unchanged.\n175\t        try:\n176\t            print(\n177\t                \"[check_bash_safety] WARN: fact gate infrastructure error: %s\"\n178\t                % e.__class__.__name__,\n179\t                file=sys.stderr,\n180\t            )\n181\t        except Exception:  # pragma: no cover\n182\t            pass\n183\t        return (decision, False)\n184\t# <<< PLAN-154.F6 / ADR-160 fact-gate END\n185\t\n186\t\n187\t# -----------------------------------------------------------------------------\n188\t# PLAN-085 Wave E.3 — canonical-path Bash interceptor (heuristic v1)\n189\t# PLAN-089 Wave B  — canonical-path Bash interceptor (matrix v2, +6 matchers)\n190\t# -----------------------------------------------------------------------------\n191\t\n192\t# Write-shape operators (regex token patterns) the interceptor scans for.\n193\t# v1 is intentionally conservative; full robust parsing is deferred to\n194\t# PLAN-089 long-term per evolution roadmap.\n195\t_E3_WRITE_OPERATORS = ("}]},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"79a19436-a555-4749-8ef8-cb3e617c589c","timestamp":"2026-11-13T18:06:56.412Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_bash_safety_parts/fact_canonical.py","content":"\"\"\"Fact-gate continuation and canonical-path checks.\"\"\"\nfrom __future__ import annotations\n\ndef _apply_fact_gate(\n    decision: \"Decision\",\n    command: str,\n    transcript_path: str,\n    now_fn=None,\n) -> \"tuple\":\n    \"\"\"Apply the PLAN-154 deny-once fact gate to a DESTRUCTIVE block.\n\n    Called from main() ONLY on the already-matched rare path\n    (``not decision.allow and decision.destructive``). Returns\n    ``(decision, enforce_active)`` — when ``enforce_active`` is True the\n    caller must SKIP the ADR-175 pilot gate (deny-once owns the outcome).\n\n    ``now_fn`` is the injectable clock seam (A9; wall clock only as the\n    default) — timestamps are used solely for record eviction ordering.\n\n    INFRASTRUCTURE exceptions return the incoming decision unchanged\n    (which on this path is already a BLOCK) with ``enforce_active=False``;\n    the INPUT side (citation verification) stays fail-CLOSED inside\n    `_verify_destructive_citation`.\n    \"\"\"\n    try:\n        enforce_enabled, source = _fact_gate_enforce_state()\n        shadow_enabled = _fact_gate_shadow_enabled()\n        if not enforce_enabled and not shadow_enabled:\n            return (decision, False)  # structurally off — zero delta\n        import os as _os\n        import time as _time\n        now = (now_fn or _time.time)()\n        session_id = _os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n        state_path = _fact_gate_state_path(session_id)\n\n        emit_activation = None  # type: Optional[bool]\n        emit_disabled_breadcrumb = False\n        cite_status = \"absent\"\n        source_class = \"\"\n        verify_detail = \"\"\n        prior = False\n        command_sha = \"\"\n\n        with _FactGateLock(state_path):\n            state = _fact_gate_load(state_path)\n            records = state.setdefault(\"records\", {})\n            flags = state.setdefault(\"flags\", {})\n\n            # (e) lazy activation-change detection → governance event.\n            last = state.get(\"enforce_state\")\n            last_enabled = bool(last.get(\"enabled\")) if isinstance(last, dict) else False\n            if last_enabled != enforce_enabled:\n                emit_activation = enforce_enabled\n            state[\"enforce_state\"] = {\"enabled\": enforce_enabled, \"source\": source}\n\n            # (A12) once-per-session disabled breadcrumb: an explicit env\n            # emergency-off suppressed an otherwise-armed enforce flip.\n            if (\n                not enforce_enabled\n                and source == \"env_emergency_off\"\n                and not flags.get(\"disabled_breadcrumb\")\n            ):\n                emit_disabled_breadcrumb = True\n                flags[\"disabled_breadcrumb\"] = True\n\n            normalized = _fact_gate_normalize(command)\n            if normalized is None:\n                # Unparseable command: no stable hash → never releasable\n                # (fail-CLOSED). Persist the observed enforce state only.\n                _fact_gate_save(state_path, state)\n                if emit_activation is not None:\n                    _emit_fact_gate_activation_changed(emit_activation, source)\n                if emit_disabled_breadcrumb:\n                    _emit_learning_rail_disabled(\"fact_gate\", _FACT_GATE_ENFORCE_VAR)\n                return (decision, enforce_enabled)\n\n            command_sha = hashlib.sha256(\n                normalized.encode(\"utf-8\")\n            ).hexdigest()\n            prior = command_sha in records\n\n            status, src_or_detail, cited = _extract_destructive_citation(command)\n            if status in (\"absent\", \"malformed\"):\n                cite_status = status\n                verify_detail = src_or_detail\n            else:\n                cite_status = \"unverified\"\n                # Verification I/O runs