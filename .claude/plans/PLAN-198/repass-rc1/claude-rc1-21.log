{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JdyceGAMFwVcBxEmRWimCt","type":"tool_result","content":"1\t# coverage.py config — repo-root so local `coverage run` and CI share\n2\t# identical flags. Gate + thresholds documented in\n3\t# .github/workflows/coverage.yml (Session 33 Phase D Batch B +\n4\t# PLAN-045 Session 41 F-03-03).\n5\t#\n6\t# PLAN-112-FOLLOWUP-coverage-doctrine-reconcile (S157) / ADR-139:\n7\t# Hooks are tested via `subprocess.run([sys.executable, hook])`, so an\n8\t# in-process `coverage run` under-counts them (e.g. check_read_injection\n9\t# showed 0% despite 100%-passing tests). The fix is subprocess capture:\n10\t#   * parallel = True            -> each process writes its own data file\n11\t#   * COVERAGE_PROCESS_START env  -> points subprocesses at this rcfile\n12\t#   * a `coverage.process_startup()` .pth in site-packages (HOME-independent)\n13\t#   * `coverage combine` merges parent + subprocess data files\n14\t#   * relative_files + [paths]   -> fold tmp-tree hook copies back to source\n15\t# See coverage.yml for the wired CI steps.\n16\t\n17\t[run]\n18\tbranch = True\n19\tparallel = True\n20\trelative_files = True\n21\tsource =\n22\t    .claude/hooks\n23\t    .claude/scripts\n24\tomit =\n25\t    # Stale staging copies of hooks/scripts under plan dirs pollute the\n26\t    # denominator — they are historical snapshots, not live code.\n27\t    .claude/plans/*\n28\t\n29\t[paths]\n30\t# Fold throwaway hook/script copies (built under pytest tmp dirs and run\n31\t# from there) back onto the canonical source tree so subprocess coverage\n32\t# is attributed to the real file, not /tmp/.../test_x/.claude/hooks/<h>.py.\n33\thooks =\n34\t    .claude/hooks/\n35\t    */.claude/hooks/\n36\tscripts =\n37\t    .claude/scripts/\n38\t    */.claude/scripts/\n39\t\n40\t[report]\n41\tskip_empty = True\n42\t# precision = 2 gives branch percentages like \"72.45%\" instead of \"72%\".\n43\tprecision = 2\n44\t# exclude_lines keeps defensive `pragma: no cover` markers honoured.\n45\texclude_lines =\n46\t    pragma: no cover\n47\t    raise NotImplementedError\n48\t    if __name__ == .__main__.:\n49\t    if TYPE_CHECKING:\n50\t\n51\t[html]\n52\tdirectory = htmlcov\n53\t"}]},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"8a13cb00-190c-48a1-baaf-9200da7925ba","timestamp":"2026-11-13T18:08:07.238Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.coveragerc","content":"# coverage.py config — repo-root so local `coverage run` and CI share\n# identical flags. Gate + thresholds documented in\n# .github/workflows/coverage.yml (Session 33 Phase D Batch B +\n# PLAN-045 Session 41 F-03-03).\n#\n# PLAN-112-FOLLOWUP-coverage-doctrine-reconcile (S157) / ADR-139:\n# Hooks are tested via `subprocess.run([sys.executable, hook])`, so an\n# in-process `coverage run` under-counts them (e.g. check_read_injection\n# showed 0% despite 100%-passing tests). The fix is subprocess capture:\n#   * parallel = True            -> each process writes its own data file\n#   * COVERAGE_PROCESS_START env  -> points subprocesses at this rcfile\n#   * a `coverage.process_startup()` .pth in site-packages (HOME-independent)\n#   * `coverage combine` merges parent + subprocess data files\n#   * relative_files + [paths]   -> fold tmp-tree hook copies back to source\n# See coverage.yml for the wired CI steps.\n\n[run]\nbranch = True\nparallel = True\nrelative_files = True\nsource =\n    .claude/hooks\n    .claude/scripts\nomit =\n    # Stale staging copies of hooks/scripts under plan dirs pollute the\n    # denominator — they are historical snapshots, not live code.\n    .claude/plans/*\n\n[paths]\n# Fold throwaway hook/script copies (built under pytest tmp dirs and run\n# from there) back onto the canonical source tree so subprocess coverage\n# is attributed to the real file, not /tmp/.../test_x/.claude/hooks/<h>.py.\nhooks =\n    .claude/hooks/\n    */.claude/hooks/\nscripts =\n    .claude/scripts/\n    */.claude/scripts/\n\n[report]\nskip_empty = True\n# precision = 2 gives branch percentages like \"72.45%\" instead of \"72%\".\nprecision = 2\n# exclude_lines keeps defensive `pragma: no cover` markers honoured.\nexclude_lines =\n    pragma: no cover\n    raise NotImplementedError\n    if __name__ == .__main__.:\n    if TYPE_CHECKING:\n\n[html]\ndirectory = htmlcov\n","numLines":53,"startLine":1,"totalLines":53}},"tool_result_meta":[{"id":"toolu_01JdyceGAMFwVcBxEmRWimCt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
