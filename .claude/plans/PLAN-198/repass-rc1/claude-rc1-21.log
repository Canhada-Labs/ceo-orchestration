{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017z1gmVCTmkPH1uxHVq9bLJ","type":"tool_result","content":"1\t\"\"\"Decision conversion, audit emitters, and hook entry point.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _emit_env_var_hijack_event(hijack_class: str) -> None:\n5\t    \"\"\"Emit env_var_hijack_blocked(hijack_class). Fail-open (PLAN-133 A1).\n6\t\n7\t    The ONLY caller-supplied field is the closed-enum `hijack_class` — NEVER the\n8\t    variable NAME and NEVER the assigned VALUE (the value is the payload surface,\n9\t    MF analogous to git_hook_bypass MF-G). session_id / project are read from the\n10\t    live env (forensic envelope only; not a grant source). Emitted on BOTH an\n11\t    enforced block AND an advisory (default-OFF) detection.\n12\t    \"\"\"\n13\t    if _audit_emit is None:\n14\t        return\n15\t    try:\n16\t        import os as _os\n17\t        _audit_emit.emit_env_var_hijack_blocked(\n18\t            hijack_class=hijack_class,\n19\t            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n20\t            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n21\t        )\n22\t    except Exception:  # pragma: no cover\n23\t        pass\n24\t\n25\t\n26\tdef _emit_egress_destination_event(egress_class: str, destination: str) -> None:\n27\t    \"\"\"Emit egress_destination_detected(egress_class, destination). Fail-open.\n28\t\n29\t    `destination` is ALREADY host-only (egress_taxonomy reduces it); the audit\n30\t    emitter re-truncates defensively. The full URL / path / query / inline\n31\t    credential is NEVER passed here. When egress_class == 'pair_rail' the caller\n32\t    ALSO emits pair_rail_outgoing_redaction_applied (positive proof the outbound\n33\t    redactor ran on the sanctioned channel). session_id / project are forensic\n34\t    envelope only (not a grant source).\n35\t    \"\"\"\n36\t    if _audit_emit is None:\n37\t        return\n38\t    try:\n39\t        import 