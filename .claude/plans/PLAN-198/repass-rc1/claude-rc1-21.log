ency out of its own process is cheap honesty).\n195\t# ---------------------------------------------------------------------------\n196\t\n197\tdef _parse_args(argv: List[str]) -> Dict[str, Any]:\n198\t    opts: Dict[str, Any] = {\n199\t        \"repo\": None,\n200\t        \"schema_snapshot\": None,\n201\t        \"require_snapshot\": False,\n202\t        \"only\": [],\n203\t        \"skip_behavioral\": False,\n204\t        \"json\": False,\n205\t        \"verbose\": False,\n206\t    }\n207\t    i = 0\n208\t    while i < len(argv):\n209\t        a = argv[i]\n210\t        if a == \"--repo\" and i + 1 < len(argv):\n211\t            opts[\"repo\"] = argv[i + 1]\n212\t            i += 2\n213\t        elif a == \"--schema-snapshot\" and i + 1 < len(argv):\n214\t            opts[\"schema_snapshot\"] = argv[i + 1]\n215\t            i += 2\n216\t        elif a == \"--require-snapshot\":\n217\t            opts[\"require_snapshot\"] = True\n218\t            i += 1\n219\t        elif a == \"--only\" and i + 1 < len(argv):\n220\t            opts[\"only\"].append(argv[i + 1])\n221\t            i += 2\n222\t        elif a == \"--skip-behavioral\":\n223\t            opts[\"skip_behavioral\"] = True\n224\t            i += 1\n225\t        elif a == \"--json\":\n226\t            opts[\"json\"] = True\n227\t            i += 1\n228\t        elif a in (\"--verbose\", \"-v\"):\n229\t            opts[\"verbose\"] = True\n230\t            i += 1\n231\t        elif a in (\"--help\", \"-h\"):\n232\t            print(__doc__)\n233\t            raise SystemExit(0)\n234\t        else:\n235\t            print(\"check-hook-stdout-schema: unknown argument %r\" % a, file=sys.stderr)\n236\t            raise SystemExit(2)\n237\t    return opts\n238\t\n239\t"}]},"parent_tool_use_id":null,"session_id":"5e86bd57-c683-4f2c-b9eb-449a331f3f20","uuid":"e3f36700-cb0e-46e3-87e8-3c8df5837be7","timestamp":"2026-11-13T18:06:26.225Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm