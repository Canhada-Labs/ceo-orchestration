{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NwSP8nkRssfb9Lug67J2bx","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom typing import NamedTuple\n4\t\n5\tdef _personal_path_option_near_miss(\n6\t    parser: \"argparse.ArgumentParser\", token: str,\n7\t) -> bool:\n8\t    \"\"\"True when ``token`` is a PREFIX of a long option this parser knows.\n9\t\n10\t    Derived from the parser rather than from a list written here: a list\n11\t    of option names beside the options themselves is a second place to\n12\t    forget, and the next flag added would quietly leave this check\n13\t    behind. `_actions` is argparse's own registry of what it accepts.\n14\t\n15\t    `--` and `-` are excluded: the first is argparse's positional\n16\t    separator and a prefix of literally every long option.\n17\t    \"\"\"\n18\t    head = token.split(\"=\", 1)[0]\n19\t    if not head.startswith(\"--\") or head in (\"-\", \"--\"):\n20\t        return False\n21\t    known = [opt for action in parser._actions\n22\t             for opt in action.option_strings]\n23\t    if head in known:\n24\t        return False\n25\t    return any(opt.startswith(head) for opt in known)\n26\t\n27\t\n28\tdef _parse_args(argv: Optional[List[str]]) -> \"argparse.Namespace\":\n29\t    \"\"\"CLI surface. No argument changes what the DEFAULT run enforces.\n30\t\n31\t    Raises ``PersonalPathUsage`` for a token that is a prefix of a real\n32\t    option; `main` turns that into rc 2 with the token redacted, because\n33\t    a stray argument can BE an absolute home path and argparse's own\n34\t    usage error would print it verbatim.\n35\t    \"\"\"\n36\t    # `allow_abbrev=False` (pair-rail land round 1, P2). argparse accepts a\n37\t    # unique PREFIX of a long option by default, so `--emit-personal-path-row`\n38\t    # — one character short, and a plausible typo — silently selected\n39\t    # `--emit-personal-path-rows` and put the gate into its non-gating mode:\n40\t    # rows on stdout, rc 0, no verdict. A security matcher must not have a\n41\t    # spelling that turns it off, and abbreviation is a whole family of them.\n42\t    parser = _PersonalPathParser(\n43\t        prog=\"check_contamination.py\", allow_abbrev=False,\n44\t        description=\"Contamination gate: the term rule, plus the \"\n45\t                    \"personal-path rule over docs/ and .claude/plans/.\",\n46\t    )\n47\t    parser.add_argument(\n48\t        \"--root\", default=None,\n49\t        help=\"repository to scan (default: the checkout this file lives in)\",\n50\t    )\n51\t    parser.add_argument(\n52\t        \"--personal-path-allowlist\", default=None,\n53\t        help=\"allowlist for the personal-path rule (default: %s under the \"\n54\t             \"root). It must be a git-TRACKED file inside the root; \"\n55\t             \"anything else is read as EMPTY and waives nothing\"\n56\t             % _PERSONAL_PATH_ALLOWLIST_REL,\n57\t    )\n58\t    parser.add_argument(\n59\t        \"--emit-personal-path-rows\", action=\"store_true\",\n60\t        help=\"print an unreasoned allowlist row for every unwaived file; \"\n61\t             \"exit 0, 1 when the allowlist holds MALFORMED rows, or 2 \"\n62\t             \"when an input cannot be read (stdout stays rows-only in \"\n63\t             \"every case). The emitted reason is refused by the parser\",\n64\t    )\n65\t    parser.add_argument(\n66\t        \"--fail-on-stale\", action=\"store_true\",\n67\t        help=\"also fail when an allowlist row matches no file. OFF by \"\n68\t             \"default: the shipped allowlist names framework artifacts that \"\n69\t             \"an adopter checkout legitimately does not have\",\n70\t    )\n71\t    # `parse_known_args`, NOT `parse_args`: the module this rule joined ignored\n72\t    # argv ENTIRELY, and the delivered wrapper `check-contamination.sh` execs\n73\t    # it with \"$@\" — so a strict parser turns an argument that used to do\n74\t    # nothing into an rc-2 CI failure in an adopter checkout this repo cannot\n75\t    # grep. The tolerance is preserved; the SILENCE is not. An ignored token is\n76\t    # NAMED on stderr, because `--fail-on-stalee` quietly doing nothing is how\n77\t    # an operator reads a check that never ran as a check that passed. The exit\n78\t    # code is unchanged — naming it is the whole cure.\n79\t    args, unknown = parser.parse_known_args(argv)\n80\t    # A token that is a PREFIX of a known option is the abbreviation\n81\t    # argparse used to accept, and it is fail-CLOSED here rather than\n82\t    # ignored: an operator who typed nine tenths of `--emit-personal-path-\n83\t    # rows` MEANT that flag, and the tolerance above exists for arguments\n84\t    # this module never had, not for near-misses on the ones it has. It\n85\t    # is the same fail-closed reading the allowlist parser gives a row\n86\t    # it cannot match WHOLE: MALFORMED and named, never a line skipped\n87\t    # while the operator believes it took effect.\n88\t    if args.emit_personal_path_rows and args.fail_on_stale:\n89\t        # One asks for a VERDICT to be stricter, the other suppresses the\n90\t        # verdict entirely. Accepted together, `--fail-on-stale` was\n91\t        # silently ignored and the run returned 0 where it returned 1\n92\t        # without the emit flag (pair-rail round 2, P2). Two flags whose\n93\t        # combination has no honest meaning are a usage error, not a\n94\t        # precedence rule for the operator to memorise.\n95\t        raise PersonalPathUsage(\n96\t            \"--emit-personal-path-rows and --fail-on-stale contradict \"\n97\t            \"each other: one prints rows instead of a verdict, the other \"\n98\t            \"makes the verdict stricter\")\n99\t    near = [tok for tok in unknown\n100\t            if _personal_path_option_near_miss(parser, tok)]\n101\t    if near:\n102\t        raise PersonalPathUsage(\n103\t            \"unrecognised argument(s) %s — each is a PREFIX of a real \"\n104\t            \"option, which this gate refuses rather than guesses\"\n105\t            % \" \".join(_personal_path_safe(tok) for tok in near))\n106\t    if unknown:\n107\t        # The rule applies to this line too. A token can BE an absolute home\n108\t        # path (a stray positional, a mistyped `--root` value), and this NOTE\n109\t        # lands in the same public log as the findings — so the module runs its\n110\t        # own predicate over what it is about to echo. argparse-strict printed\n111\t        # the raw token in its usage error; ignoring it in silence printed\n112\t        # nothing at all. Naming it, redacted, is the only one of the three\n113\t        # that is both visible and safe.\n114\t        shown = [_personal_path_safe(tok) for tok in unknown]\n115\t        print(\n116\t            \"NOTE: ignoring unrecognised argument(s): %s\" % \" \".join(shown),\n117\t            file=sys.stderr,\n118\t        )\n119\t    # An EXPLICITLY EMPTY path option is a usage error, not \"not\n120\t    # given\". Reading it by truthiness downstream silently selected the\n121\t    # default: `--root \"\"` scanned the checkout this file lives in and\n122\t    # returned green (pair-rail round 4, P1).\n123\t    for flag, value in ((\"--root\", args.root),\n124\t                        (\"--personal-path-allowlist\",\n125\t                         args.personal_path_allowlist)):\n126\t        if value is not None and not str(value).strip():\n127\t            raise PersonalPathUsage(_PERSONAL_PATH_EMPTY_OPTION % flag)\n128\t    return args\n129\t\n130\t\n131\tdef scan(repo_root: Path) -> List[Path]:\n132\t    \"\"\"Scan the verified index; refuse inputs that cannot be proved readable.\"\"\"\n133\t    pattern = build_pattern(repo_root)\n134\t    return _find_term_violations(\n135\t        repo_root, pattern, FileWalker, _ALLOWLIST_EXACT, _ALLOWLIST_GLOBS,\n136\t        _SKIP_SUFFIXES, is_never_allowlisted, _personal_path_index_modes,\n137\t        PersonalPathUnreadable,\n138\t    )\n139\t\n140\t\n141\tdef main(argv: Optional[List[str]] = None) -> int:\n142\t    \"\"\"Resolve the CLI boundary before running both contamination rules.\"\"\"\n143\t    try:\n144\t        args = _parse_args(argv)\n145\t    except PersonalPathUsage as exc:\n146\t        # Fail-CLOSED on a CLI token this gate will not guess at.\n147\t        # The message is already redacted at the raise site: a\n148\t        # stray argument can BE an absolute home path, and this\n149\t        # line lands in the same public log as the findings.\n150\t        print(\"FATAL: %s\" % exc, file=sys.stderr)\n151\t        return 2\n152\t    try:\n153\t        repo_root = (\n154\t            Path(args.root).resolve() if args.root is not None\n155\t            else Path(__file__).resolve().parent.parent.parent\n156\t        )\n157\t    except Exception as exc:\n158\t        # A BOUNDARY, not a type list. `resolve()` raises\n159\t        # OSError for some failures and a bare RuntimeError for\n160\t        # a symlink LOOP on Python 3.9, so naming OSError alone\n161\t        # still left the traceback (pair-rail round 2, the same\n162\t        # shape twice in one file).\n163\t        # `resolve()` raises on a symlink LOOP, and it raised\n164\t        # BEFORE any guarded path: an rc-1 traceback carrying\n165\t        # the supplied path and this file's absolute location\n166\t        # (pair-rail round 2, P2). That path is chosen by\n167\t        # whoever runs the gate and can BE a home directory.\n168\t        print(\"FATAL: cannot resolve --root: %s\"\n169\t              % _personal_path_safe(_oserror_reason(exc)),\n170\t              file=sys.stderr)\n171\t        return 2\n172\t    try:\n173\t        is_repo = ((repo_root / \".git\").exists()\n174\t                   or (repo_root / \".git\").is_dir())\n175\t    except Exception as exc:\n176\t        # The boundary above ENDED before this test, so an\n177\t        # unsearchable resolved root raised PermissionError here\n178\t        # and the traceback carried the root -- chosen by whoever\n179\t        # runs the gate, and able to BE a home directory\n180\t        # (pair-rail round 3, P2).\n181\t        print(\"FATAL: cannot inspect --root: %s\"\n182\t              % _personal_path_safe(_oserror_reason(exc)),\n183\t              file=sys.stderr)\n184\t        return 2\n185\t    if not is_repo:\n186\t        # Not a git repo — exit 2\n187\t        print(\"FATAL: not inside a git repo\", file=sys.stderr)\n188\t        return 2\n189\t\n190\t    return _run_checks(repo_root, args)\n191\t\n192\t\n193\tdef _run_checks(repo_root: Path, args: argparse.Namespace) -> int:\n194\t    \"\"\"Preserve path diagnostics, then check and report the term inventory.\"\"\"\n195\t    allowlist_path = (\n196\t        Path(args.personal_path_allowlist)\n197\t        if args.personal_path_allowlist is not None\n198\t        else repo_root / _PERSONAL_PATH_ALLOWLIST_REL\n199\t    )\n200\t    if args.emit_personal_path_rows:\n201\t        # Rows ONLY: the term report would make the output\n202\t        # unpasteable, and this mode exists to be pasted.\n203\t        return report_personal_paths(\n204\t            repo_root, allowlist_path, emit_rows=True,\n205\t        )\n206\t\n207\t    # Preserve Rule 2's subject-specific diagnostic before the term scan.\n208\t    rc_paths = report_personal_paths(\n209\t        repo_root, allowlist_path, fail_on_stale=args.fail_on_stale,\n210\t    )\n211\t    if rc_paths == 2:\n212\t        return 2\n213\t    term_fatal = False\n214\t    violations: List[Path] = []\n215\t    try:\n216\t        violations = scan(repo_root)\n217\t    except PersonalPathUnreadable as exc:\n218\t        # Composed by scan() itself, with masked paths: say which proof failed. RULE 2\n219\t        # still runs below, as it does after a term hit, and rc stays 2.\n220\t        print(\"FATAL: %s\" % _personal_path_safe(str(exc)), file=sys.stderr)\n221\t        term_fatal = True\n222\t    except Exception as exc:\n223\t        # A BOUNDARY, not a list of exception types. The term\n224\t        # scan reads a file and COMPILES what is in it as a raw\n225\t        # regex, so its failure modes are open-ended: OSError,\n226\t        # UnicodeDecodeError and re.error were each named here\n227\t        # after a rail round found them, and round 2 then found\n228\t        # RecursionError (2000 open parens in a private term),\n229\t        # which escaped as an rc-1 traceback carrying the\n230\t        # absolute checkout path. Enumerating exception types is\n231\t        # the same shape as enumerating safe filenames, and it\n232\t        # failed the same way three times.\n233\t        #\n234\t        # Anything that stops this scan leaves the pattern\n235\t        # incomplete, and an incomplete pattern is an unverified\n236\t        # scan, not a clean one (CLAUDE.md section 4: a GATE\n237\t        # fails closed on input). The REASON, never `exc`: its\n238\t        # str() carries an ABSOLUTE filename or the offending\n239\t        # PATTERN, and on an operator machine both are a home\n240\t        # path. The message names no path of its own either,\n241\t        # because after this catch-all the failure is no longer\n242\t        # necessarily the terms file.\n243\t        if isinstance(exc, (OSError, UnicodeDecodeError, re.error)):\n244\t            # Known INPUT failures of the terms file: keep the\n245\t            # precision where there is precision to be had.\n246\t            print(\n247\t                \"FATAL: cannot read %s: %s\"\n248\t                % (_PRIVATE_TERMS_RELPATH,\n249\t                   _personal_path_safe(_oserror_reason(exc))),\n250\t                file=sys.stderr,\n251\t            )\n252\t        else:\n253\t            print(\n254\t                \"FATAL: the term scan did not complete: %s\"\n255\t                % _personal_path_safe(_oserror_reason(exc)),\n256\t                file=sys.stderr,\n257\t            )\n258\t        return 2\n259\t\n260\t    rc_terms = 2 if term_fatal else _report_terms(violations, repo_root)\n261\t    return max(rc_terms, rc_paths)\n262\t\n263\t\n264\tdef _report_terms(violations: List[Path], repo_root: Path) -> int:\n265\t    \"\"\"The term rule's report. NOT byte-identical to the pre-v4 output: paths go through `_personal_path_mask_rel`, the plan glob was corrected, and a Rule 2 note is appended (text lane, round 23, which found the old sentence still claiming otherwise). The SHAPE and the verdict are unchanged.\"\"\"\n266\t    if not violations:\n267\t        print(\"✓ No contamination outside allowed zones\")\n268\t        return 0\n269\t\n270\t    print(\"❌ Contamination found in the following files:\")\n271\t    for v in violations:\n272\t        rel = v.relative_to(repo_root)\n273\t        print(\"  - %s\" % _personal_path_mask_rel(rel.as_posix()))\n274\t    print(\"\")\n275\t    print(\"Allowed zones:\")\n276\t    print(\"  - LICENSE\")\n277\t    print(\"  - CHANGELOG.md\")\n278\t    print(\"  - .claude/skills/domains/**\")\n279\t    print(\"  - .claude/plans/* (the WHOLE plan tree, recursively — \"\n280\t          \"fnmatch `*` crosses `/`)\")\n281\t    print(\"      EXCEPT LEDGER.md / LEDGER-ARCHIVE.md at any depth under\")\n282\t    print(\"      .claude/plans/ — machine-appended, always scanned\")\n283\t    print(\"      (such a file is ALSO reported when it is not valid UTF-8:\")\n284\t    print(\"       unparseable input is blocked, not skipped)\")\n285\t    print(\"  - npm/** (NPM shim — uses owner handle in URLs)\")\n286\t    print(\"  - .github/workflows/validate.yml\")\n287\t    print(\"  - .github/CODEOWNERS (live config — Owner handle expected)\")\n288\t    print(\"  - .claude/scripts/check-contamination.sh\")\n289\t    print(\"  - scripts/contamination-terms.txt (private terms list — not delivered)\")\n290\t    print(\"  - .claude/scripts/tests/test_check_contamination.py (uses pattern as fixture)\")\n291\t    print(\"  - CLAUDE.md (framework master context — Owner path expected)\")\n292\t    print(\"  - RELEASE.md (release procedure — Owner path + canonical repo URL)\")\n293\t    print(\"  - SECURITY.md (vulnerability disclosure — Owner contact + canonical URL expected)\")\n294\t    print(\"  - docs/QUICKSTART.md (install instructions — canonical repo URL)\")\n295\t    print(\"  - docs/UPGRADE-PROCEDURE.md (upgrade playbook — canonical repo for gh CLI)\")\n296\t    print(\"  - docs/SLO-SLA.md (SLO doc — references named adopter for production data point)\")\n297\t    print(\"  - .claude/scripts/check-framework-updates.sh (tool — default upstream URL)\")\n298\t    print(\"  - templates/.github/workflows/* (copies of live CI files)\")\n299\t    print(\"\")\n300\t    print(\"NOTE: those zones exempt the TERM rule only. Absolute home\")\n301\t    print(\"paths under docs/ and .claude/plans/ are governed by the\")\n302\t    print(\"personal-path rule, which no zone above can waive.\")\n303\t    return 1\n304\t\n305\t\n306\t\n307\t"}]},"parent_tool_use_id":null,"session_id":"50141584-ed08-437c-bb91-f56d610ea253","uuid":"5ad006d7-99a4-4732-9f17-5587f84faef2","timestamp":"2026-11-13T18:35:48.137Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_contamination/cli_checks.py","content":"from __future__ import annotations\n\nfrom typing import NamedTuple\n\ndef _personal_path_option_near_miss(\n    parser: \"argparse.ArgumentParser\", token: str,\n) -> bool:\n    \"\"\"True when ``token`` is a PREFIX of a long option this parser knows.\n\n    Derived from the parser rather than from a list written here: a list\n    of option names beside the options themselves is a second place to\n    forget, and the next flag added would quietly leave this check\n    behind. `_actions` is argparse's own registry of what it accepts.\n\n    `--` and `-` are excluded: the first is argparse's positional\n    separator and a prefix of literally every long option.\n    \"\"\"\n    head = token.split(\"=\", 1)[0]\n    if not head.startswith(\"--\") or head in (\"-\", \"--\"):\n        return False\n    known = [opt for action in parser._actions\n             for opt in action.option_strings]\n    if head in known:\n        return False\n    return any(opt.startswith(head) for opt in known)\n\n\ndef _parse_args(argv: Optional[List[str]]) -> \"argparse.Namespace\":\n    \"\"\"CLI surface. No argument changes what the DEFAULT run enforces.\n\n    Raises ``PersonalPathUsage`` for a token that is a prefix of a real\n    option; `main` turns that into rc 2 with the token redacted, because\n    a stray argument can BE an absolute home path and argparse's own\n    usage error would print it verbatim.\n    \"\"\"\n    # `allow_abbrev=False` (pair-rail land round 1, P2). argparse accepts a\n    # unique PREFIX of a long option by default, so `--emit-personal-path-row`\n    # — one character short, and a plausible typo — silently selected\n    # `--emit-personal-path-rows` and put the gate into its non-gating mode:\n    # rows on stdout, rc 0, no verdict. A security matcher must not have a\n    # spelling that turns it off, and abbreviation is a whole family of them.\n    parser = _PersonalPathParser(\n        prog=\"check_contamination.py\", allow_abbrev=False,\n        description=\"Contamination gate: the term rule, plus the \"\n                    \"personal-path rule over docs/ and .claude/plans/.\",\n    )\n    parser.add_argument(\n        \"--root\", default=None,\n        help=\"repository to scan (default: the checkout this file lives in)\",\n    )\n    parser.add_argument(\n        \"--personal-path-allowlist\", default=None,\n        help=\"allowlist for the personal-path rule (default: %s under the \"\n             \"root). It must be a git-TRACKED file inside the root; \"\n             \"anything else is read as EMPTY and waives nothing\"\n             % _PERSONAL_PATH_ALLOWLIST_REL,\n    )\n    parser.add_argument(\n        \"--emit-personal-path-rows\", action=\"store_true\",\n        help=\"print an unreasoned allowlist row for every unwaived file; \"\n             \"exit 0, 1 when the allowlist holds MALFORMED rows, or 2 \"\n             \"when an input cannot be read (stdout stays rows-only in \"\n             \"every case). The emitted reason is refused by the parser\",\n    )\n    parser.add_argument(\n        \"--fail-on-stale\", action=\"store_true\",\n        help=\"also fail when an allowlist row matches no file. OFF by \"\n             \"default: the shipped allowlist names framework artifacts that \"\n             \"an adopter checkout legitimately does not have\",\n    )\n    # `parse_known_args`, NOT `parse_args`: the module this rule joined ignored\n    # argv ENTIRELY, and the delivered wrapper `check-contamination.sh` execs\n    # it with \"$@\" — so a strict parser turns an argument that used to do\n    # nothing into an rc-2 CI failure in an adopter checkout this repo cannot\n    # grep. The tolerance is preserved; the SILENCE is not. An ignored token is\n    # NAMED on stderr, because `--fail-on-stalee` quietly doing nothing is how\n    # an operator reads a check that never ran as a check that passed. The exit\n    # code is unchanged — naming it is the whole cure.\n    args, unknown = parser.parse_known_args(argv)\n    # A token that is a PREFIX of a known option is the abbreviation\n    # argparse used to accept, and it is fail-CLOSED here rather than\n    # ignored: an operator who typed nine tenths of `--emit-personal-path-\n    # rows` MEANT that flag, and the tolerance above exists for arguments\n    # this module never had, not for near-misses on the ones it has. It\n    # is the same fail-closed reading the allowlist parser gives a row\n    # it cannot match WHOLE: MALFORMED and named, never a line skipped\n    # while the operator believes it took effect.\n    if args.emit_personal_path_rows and args.fail_on_stale:\n        # One asks for a VERDICT to be stricter, the other suppresses the\n        # verdict entirely. Accepted together, `--fail-on-stale` was\n        # silently ignored and the run returned 0 where it returned 1\n        # without the emit flag (pair-rail round 2, P2). Two flags whose\n        # combination has no honest meaning are a usage error, not a\n        # precedence rule for the operator to memorise.\n        raise PersonalPathUsage(\n            \"--emit-personal-path-rows and --fail-on-stale contradict \"\n            \"each other: one prints rows instead of a verdict, the other \"\n            \"makes the verdict stricter\")\n    near = [tok for tok in unknown\n            if _personal_path_option_near_miss(parser, tok)]\n    if near:\n        raise PersonalPathUsage(\n            \"unrecognised argument(s) %s — each is a PREFIX of a real \"\n            \"option, which this gate refuses rather than guesses\"\n            % \" \".join(_personal_path_safe(tok) for tok in near))\n    if unknown:\n        # The rule applies to this line too. A token can BE an absolute home\n        # path (a stray positional, a mistyped `--root` value), and this NOTE\n        # lands in the same public log as the findings — so the module runs its\n        # own predicate over what it is about to echo. argparse-strict printed\n        # the raw token in its usage error; ignoring it in silence printed\n        # nothing at all. Naming it, redacted, is the only one of the three\n        # that is both visible and safe.\n        shown = [_personal_path_safe(tok) for tok in unknown]\n        print(\n            \"NOTE: ignoring unrecognised argument(s): %s\" % \" \".join(shown),\n            file=sys.stderr,\n        )\n    # An EXPLICITLY EMPTY path option is a usage error, not \"not\n    # given\". Reading it by truthiness downstream silently selected the\n    # default: `--root \"\"` scanned the checkout this file lives in and\n    # returned green (pair-rail round 4, P1).\n    for flag, value in ((\"--root\", args.root),\n                        (\"--personal-path-allowlist\",\n                         args.personal_path_allowlist)):\n        if value is not None and not str(value).strip():\n            raise PersonalPathUsage(_PERSONAL_PATH_EMPTY_OPTION % flag)\n    return args\n\n\ndef scan(repo_root: Path) -> List[Path]:\n    \"\"\"Scan the verified index; refuse inputs that cannot be proved readable.\"\"\"\n    pattern = build_pattern(repo_root)\n    return _find_term_violations(\n        repo_root, pattern, FileWalker, _ALLOWLIST_EXACT, _ALLOWLIST_GLOBS,\n        _SKIP_SUFFIXES, is_never_allowlisted, _personal_path_index_modes,\n        PersonalPathUnreadable,\n    )\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"Resolve the CLI boundary before running both contamination rules.\"\"\"\n    try:\n        args = _parse_args(argv)\n    except PersonalPathUsage as exc:\n        # Fail-CLOSED on a CLI token this gate will not guess at.\n        # The message is already redacted at the raise site: a\n        # stray argument can BE an absolute home path, and this\n        # line lands in the same public log as the findings.\n        print(\"FATAL: %s\" % exc, file=sys.stderr)\n        return 2\n    try:\n        repo_root = (\n            Path(args.root).resolve() if args.root is not None\n            else Path(__file__).resolve().parent.parent.parent\n        )\n    except Exception as exc:\n        # A BOUNDARY, not a type list. `resolve()` raises\n        # OSError for some failures and a bare RuntimeError for\n        # a symlink LOOP on Python 3.9, so naming OSError alone\n        # still left the traceback (pair-rail round 2, the same\n        # shape twice in one file).\n        # `resolve()` raises on a symlink LOOP, and it raised\n        # BEFORE any guarded path: an rc-1 traceback carrying\n        # the supplied path and this file's absolute location\n        # (pair-rail round 2, P2). That path is chosen by\n        # whoever runs the gate and can BE a home directory.\n        print(\"FATAL: cannot resolve --root: %s\"\n              % _personal_path_safe(_oserror_reason(exc)),\n              file=sys.stderr)\n        return 2\n    try:\n        is_repo = ((repo_root / \".git\").exists()\n                   or (repo_root / \".git\").is_dir())\n    except Exception as exc:\n        # The boundary above ENDED before this test, so an\n        # unsearchable resolved root raised PermissionError here\n        # and the traceback carried the root -- chosen by whoever\n        # runs the gate, and able to BE a home directory\n        # (pair-rail round 3, P2).\n        print(\"FATAL: cannot inspect --root: %s\"\n              % _personal_path_safe(_oserror_reason(exc)),\n              file=sys.stderr)\n        return 2\n    if not is_repo:\n        # Not a git repo — exit 2\n        print(\"FATAL: not inside a git repo\", file=sys.stderr)\n        return 2\n\n    return _run_checks(repo_root, args)\n\n\ndef _run_checks(repo_root: Path, args: argparse.Namespace) -> int:\n    \"\"\"Preserve path diagnostics, then check and report the term inventory.\"\"\"\n    allowlist_path = (\n        Path(args.personal_path_allowlist)\n        if args.personal_path_allowlist is not None\n        else repo_root / _PERSONAL_PATH_ALLOWLIST_REL\n    )\n    if args.emit_personal_path_rows:\n        # Rows ONLY: the term report would make the output\n        # unpasteable, and this mode exists to be pasted.\n        return report_personal_paths(\n            repo_root, allowlist_path, emit_rows=True,\n        )\n\n    # Preserve Rule 2's subject-specific diagnostic before the term scan.\n    rc_paths = report_personal_paths(\n        repo_root, allowlist_path, fail_on_stale=args.fail_on_stale,\n    )\n    if rc_paths == 2:\n        return 2\n    term_fatal = False\n    violations: List[Path] = []\n    try:\n        violations = scan(repo_root)\n    except PersonalPathUnreadable as exc:\n        # Composed by scan() itself, with masked paths: say which proof failed. RULE 2\n        # still runs below, as it does after a term hit, and rc stays 2.\n        print(\"FATAL: %s\" % _personal_path_safe(str(exc)), file=sys.stderr)\n        term_fatal = True\n    except Exception as exc:\n        # A BOUNDARY, not a list of exception types. The term\n        # scan reads a file and COMPILES what is in it as a raw\n        # regex, so its failure modes are open-ended: OSError,\n        # UnicodeDecodeError and re.error were each named here\n        # after a rail round found them, and round 2 then found\n        # RecursionError (2000 open parens in a private term),\n        # which escaped as an rc-1 traceback carrying the\n        # absolute checkout path. Enumerating exception types is\n        # the same shape as enumerating safe filenames, and it\n        # failed the same way three times.\n        #\n        # Anything that stops this scan leaves the pattern\n        # incomplete, and an incomplete pattern is an unverified\n        # scan, not a clean one (CLAUDE.md section 4: a GATE\n        # fails closed on input). The REASON, never `exc`: its\n        # str() carries an ABSOLUTE filename or the offending\n        # PATTERN, and on an operator machine both are a home\n        # path. The message names no path of its own either,\n        # because after this catch-all the failure is no longer\n        # necessarily the terms file.\n        if isinstance(exc, (OSError, UnicodeDecodeError, re.error)):\n            # Known INPUT failures of the terms file: keep the\n            # precision where there is precision to be had.\n            print(\n                \"FATAL: cannot read %s: %s\"\n                % (_PRIVATE_TERMS_RELPATH,\n                   _personal_path_safe(_oserror_reason(exc))),\n                file=sys.stderr,\n            )\n        else:\n            print(\n                \"FATAL: the term scan did not complete: %s\"\n                % _personal_path_safe(_oserror_reason(exc)),\n                file=sys.stderr,\n            )\n        return 2\n\n    rc_terms = 2 if term_fatal else _report_terms(violations, repo_root)\n    return max(rc_terms, rc_paths)\n\n\ndef _report_terms(violations: List[Path], repo_root: Path) -> int:\n    \"\"\"The term rule's report. NOT byte-identical to the pre-v4 output: paths go through `_personal_path_mask_rel`, the plan glob was corrected, and a Rule 2 note is appended (text lane, round 23, which found the old sentence still claiming otherwise). The SHAPE and the verdict are unchanged.\"\"\"\n    if not violations:\n        print(\"✓ No contamination outside allowed zones\")\n        return 0\n\n    print(\"❌ Contamination found in the following files:\")\n    for v in violations:\n        rel = v.relative_to(repo_root)\n        print(\"  - %s\" % _personal_path_mask_rel(rel.as_posix()))\n    print(\"\")\n    print(\"Allowed zones:\")\n    print(\"  - LICENSE\")\n    print(\"  - CHANGELOG.md\")\n    print(\"  - .claude/skills/domains/**\")\n    print(\"  - .claude/plans/* (the WHOLE plan tree, recursively — \"\n          \"fnmatch `*` crosses `/`)\")\n    print(\"      EXCEPT LEDGER.md / LEDGER-ARCHIVE.md at any depth under\")\n    print(\"      .claude/plans/ — machine-appended, always scanned\")\n    print(\"      (such a file is ALSO reported when it is not valid UTF-8:\")\n    print(\"       unparseable input is blocked, not skipped)\")\n    print(\"  - npm/** (NPM shim — uses owner handle in URLs)\")\n    print(\"  - .github/workflows/validate.yml\")\n    print(\"  - .github/CODEOWNERS (live config — Owner handle expected)\")\n    print(\"  - .claude/scripts/check-contamination.sh\")\n    print(\"  - scripts/contamination-terms.txt (private terms list — not delivered)\")\n    print(\"  - .claude/scripts/tests/test_check_contamination.py (uses pattern as fixture)\")\n    print(\"  - CLAUDE.md (framework master context — Owner path expected)\")\n    print(\"  - RELEASE.md (release procedure — Owner path + canonical repo URL)\")\n    print(\"  - SECURITY.md (vulnerability disclosure — Owner contact + canonical URL expected)\")\n    print(\"  - docs/QUICKSTART.md (install instructions — canonical repo URL)\")\n    print(\"  - docs/UPGRADE-PROCEDURE.md (upgrade playbook — canonical repo for gh CLI)\")\n    print(\"  - docs/SLO-SLA.md (SLO doc — references named adopter for production data point)\")\n    print(\"  - .claude/scripts/check-framework-updates.sh (tool — default upstream URL)\")\n    print(\"  - templates/.github/workflows/* (copies of live CI files)\")\n    print(\"\")\n    print(\"NOTE: those zones exempt the TERM rule only. Absolute home\")\n    print(\"paths under docs/ and .claude/plans/ are governed by the\")\n    print(\"personal-path rule, which no zone above can waive.\")\n    return 1\n\n\n\n","numLines":307,"startLine":1,"totalLines":307}},"tool_result_meta":[{"id":"toolu_01NwSP8nkRssfb9Lug67J2bx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
