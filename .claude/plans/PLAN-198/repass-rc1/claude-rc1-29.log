{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017shEdGEkWcsnq6iKr8zoa6","type":"tool_result","content":"1\t\"\"\"Shared file walker — iteration + allowlist for governance checks.\n2\t\n3\tSprint 3 Item E. Consolidates the divergent file-walking logic in\n4\t`check-tier-boundaries.py` (filesystem rglob) and `check-contamination.sh`\n5\t(git ls-files), exposing a single API:\n6\t\n7\t    walker = FileWalker(\n8\t        repo_root=Path(\".\"),\n9\t        mode=\"filesystem\" | \"git\",\n10\t        suffixes={\".md\", \".yaml\"},\n11\t        skip_subdir_names={\"benchmarks\"},\n12\t        path_allowlist_exact={\"LICENSE\"},\n13\t        path_allowlist_globs={\".claude/skills/domains/*\"},\n14\t        path_allowlist_tokens={\"frontend/frontend-data-layer/SKILL.md\"},\n15\t    )\n16\t    for path in walker.iter_files():\n17\t        ...\n18\t    if walker.is_allowlisted(path):\n19\t        ...\n20\t\n21\t## Design principles\n22\t\n23\t1. **stdlib only** — Python >= 3.9, no external deps.\n24\t2. **Fail-safe** — a git command failure does not crash the walker;\n25\t   the caller handles empty iteration.\n26\t3. **Unified allowlist** — three styles of allowlist entry (exact\n27\t   path, glob pattern, substring token) can be mixed. `is_allowlisted`\n28\t   returns True if ANY style matches.\n29\t4. **Mode-specific collection, mode-agnostic filtering** — the walker\n30\t   gathers candidate paths differently in git vs filesystem mode, but\n31\t   applies the same filtering pipeline.\n32\t\n33\t## Modes\n34\t\n35\t- `\"filesystem\"` — uses `Path.rglob()` starting from `repo_root`.\n36\t  Respects `suffixes` and `skip_subdir_names`. Used by tier-boundaries.\n37\t- `\"git\"` — runs `git ls-files -z` from `repo_root`. Returns all\n38\t  tracked files; `.gitignore` is honored by git itself. Used by\n39\t  contamination check.\n40\t\"\"\"\n41\t\n42\tfrom __future__ import annotations\n43\t\n44\timport fnmatch\n45\timport subprocess\n46\tfrom pathlib import Path\n47\tfrom typing import Iterable, Iterator, Optional, Set\n48\t\n49\t\n50\tclass FileWalker:\n51\t    \"\"\"Unified file iterator + allowlist applier.\"\"\"\n52\t\n53\t    def __init__(\n54\t        self,\n55\t        repo_root: Path,\n56\t        mode: str = \"filesystem\",\n57\t        suffixes: Optional[Set[str]] = None,\n58\t        skip_subdir_names: Optional[Set[str]] = None,\n59\t        path_allowlist_exact: Optional[Set[str]] = None,\n60\t        path_allowlist_globs: Optional[Set[str]] = None,\n61\t        path_allowlist_tokens: Optional[Set[str]] = None,\n62\t    ) -> None:\n63\t        if mode not in {\"filesystem\", \"git\"}:\n64\t            raise ValueError(f\"unknown walker mode: {mode!r}\")\n65\t        self.repo_root = repo_root.resolve()\n66\t        self.mode = mode\n67\t        self.suffixes = suffixes or set()\n68\t        self.skip_subdir_names = skip_subdir_names or set()\n69\t        self.path_allowlist_exact = path_allowlist_exact or set()\n70\t        self.path_allowlist_globs = path_allowlist_globs or set()\n71\t        self.path_allowlist_tokens = path_allowlist_tokens or set()\n72\t\n73\t    def iter_files(self) -> Iterator[Path]:\n74\t        \"\"\"Yield candidate file paths (absolute). Honors mode + filters.\"\"\"\n75\t        if self.mode == \"git\":\n76\t            yield from self._iter_git_tracked()\n77\t        else:\n78\t            yield from self._iter_filesystem()\n79\t\n80\t    def _iter_git_tracked(self) -> Iterator[Path]:\n81\t        \"\"\"Enumerate `git ls-files` output. Safe on missing git / bad repo.\"\"\"\n82\t        try:\n83\t            proc = subprocess.run(\n84\t                [\"git\", \"ls-files\", \"-z\"],\n85\t                cwd=str(self.repo_root),\n86\t                capture_output=True,\n87\t                check=False,\n88\t                timeout=30,\n89\t            )\n90\t        except (FileNotFoundError, subprocess.SubprocessError):\n91\t            return\n92\t        if proc.returncode != 0:\n93\t            return\n94\t        # -z emits NUL-separated paths\n95\t        raw = proc.stdout.decode(\"utf-8\", errors=\"replace\")\n96\t        for rel in raw.split(\"\\x00\"):\n97\t            if not rel:\n98\t                continue\n99\t            p = self.repo_root / rel\n100\t            if self.suffixes and p.suffix not in self.suffixes:\n101\t                continue\n102\t            yield p\n103\t\n104\t    def _iter_filesystem(self) -> Iterator[Path]:\n105\t        \"\"\"Walk repo_root via rglob. Skips subdirs in skip_subdir_names.\"\"\"\n106\t        for p in self.repo_root.rglob(\"*\"):\n107\t            if not p.is_file():\n108\t                continue\n109\t            if self.suffixes and p.suffix not in self.suffixes:\n110\t                continue\n111\t            # Skip if any ancestor directory name is in skip_subdir_names\n112\t            parts = set(p.relative_to(self.repo_root).parts[:-1])\n113\t            if self.skip_subdir_names and parts & self.skip_subdir_names:\n114\t                continue\n115\t            yield p\n116\t\n117\t    def is_allowlisted(self, path: Path) -> bool:\n118\t        \"\"\"Return True if `path` matches any allowlist style.\n119\t\n120\t        Supports:\n121\t        - exact relative path match\n122\t        - glob against relative path (fnmatch)\n123\t        - substring token anywhere in the absolute path string\n124\t        \"\"\"\n125\t        try:\n126\t            rel = str(path.relative_to(self.repo_root))\n127\t        except ValueError:\n128\t            rel = str(path)\n129\t\n130\t        if rel in self.path_allowlist_exact:\n131\t            return True\n132\t        for pattern in self.path_allowlist_globs:\n133\t            if fnmatch.fnmatch(rel, pattern):\n134\t                return True\n135\t        abs_str = str(path)\n136\t        for token in self.path_allowlist_tokens:\n137\t            if token in abs_str:\n138\t                return True\n139\t        return False\n140\t\n141\t    def iter_non_allowlisted(self) -> Iterable[Path]:\n142\t        \"\"\"Convenience: iterate files that are NOT allowlisted.\"\"\"\n143\t        for p in self.iter_files():\n144\t            if not self.is_allowlisted(p):\n145\t                yield p\n146\t"}]},"parent_tool_use_id":null,"session_id":"50141584-ed08-437c-bb91-f56d610ea253","uuid":"628f4bb2-d437-4eb7-a98d-c3ddb6e74646","timestamp":"2026-11-13T18:37:38.175Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/file_walker.py","content":"\"\"\"Shared file walker — iteration + allowlist for governance checks.\n\nSprint 3 Item E. Consolidates the divergent file-walking logic in\n`check-tier-boundaries.py` (filesystem rglob) and `check-contamination.sh`\n(git ls-files), exposing a single API:\n\n    walker = FileWalker(\n        repo_root=Path(\".\"),\n        mode=\"filesystem\" | \"git\",\n        suffixes={\".md\", \".yaml\"},\n        skip_subdir_names={\"benchmarks\"},\n        path_allowlist_exact={\"LICENSE\"},\n        path_allowlist_globs={\".claude/skills/domains/*\"},\n        path_allowlist_tokens={\"frontend/frontend-data-layer/SKILL.md\"},\n    )\n    for path in walker.iter_files():\n        ...\n    if walker.is_allowlisted(path):\n        ...\n\n## Design principles\n\n1. **stdlib only** — Python >= 3.9, no external deps.\n2. **Fail-safe** — a git command failure does not crash the walker;\n   the caller handles empty iteration.\n3. **Unified allowlist** — three styles of allowlist entry (exact\n   path, glob pattern, substring token) can be mixed. `is_allowlisted`\n   returns True if ANY style matches.\n4. **Mode-specific collection, mode-agnostic filtering** — the walker\n   gathers candidate paths differently in git vs filesystem mode, but\n   applies the same filtering pipeline.\n\n## Modes\n\n- `\"filesystem\"` — uses `Path.rglob()` starting from `repo_root`.\n  Respects `suffixes` and `skip_subdir_names`. Used by tier-boundaries.\n- `\"git\"` — runs `git ls-files -z` from `repo_root`. Returns all\n  tracked files; `.gitignore` is honored by git itself. Used by\n  contamination check.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport subprocess\nfrom pathlib import Path\nfrom typing import Iterable, Iterator, Optional, Set\n\n\nclass FileWalker:\n    \"\"\"Unified file iterator + allowlist applier.\"\"\"\n\n    def __init__(\n        self,\n        repo_root: Path,\n        mode: str = \"filesystem\",\n        suffixes: Optional[Set[str]] = None,\n        skip_subdir_names: Optional[Set[str]] = None,\n        path_allowlist_exact: Optional[Set[str]] = None,\n        path_allowlist_globs: Optional[Set[str]] = None,\n        path_allowlist_tokens: Optional[Set[str]] = None,\n    ) -> None:\n        if mode not in {\"filesystem\", \"git\"}:\n            raise ValueError(f\"unknown walker mode: {mode!r}\")\n        self.repo_root = repo_root.resolve()\n        self.mode = mode\n        self.suffixes = suffixes or set()\n        self.skip_subdir_names = skip_subdir_names or set()\n        self.path_allowlist_exact = path_allowlist_exact or set()\n        self.path_allowlist_globs = path_allowlist_globs or set()\n        self.path_allowlist_tokens = path_allowlist_tokens or set()\n\n    def iter_files(self) -> Iterator[Path]:\n        \"\"\"Yield candidate file paths (absolute). Honors mode + filters.\"\"\"\n        if self.mode == \"git\":\n            yield from self._iter_git_tracked()\n        else:\n            yield from self._iter_filesystem()\n\n    def _iter_git_tracked(self) -> Iterator[Path]:\n        \"\"\"Enumerate `git ls-files` output. Safe on missing git / bad repo.\"\"\"\n        try:\n            proc = subprocess.run(\n                [\"git\", \"ls-files\", \"-z\"],\n                cwd=str(self.repo_root),\n                capture_output=True,\n                check=False,\n                timeout=30,\n            )\n        except (FileNotFoundError, subprocess.SubprocessError):\n            return\n        if proc.returncode != 0:\n            return\n        # -z emits NUL-separated paths\n        raw = proc.stdout.decode(\"utf-8\", errors=\"replace\")\n        for rel in raw.split(\"\\x00\"):\n            if not rel:\n                continue\n            p = self.repo_root / rel\n            if self.suffixes and p.suffix not in self.suffixes:\n                continue\n            yield p\n\n    def _iter_filesystem(self) -> Iterator[Path]:\n        \"\"\"Walk repo_root via rglob. Skips subdirs in skip_subdir_names.\"\"\"\n        for p in self.repo_root.rglob(\"*\"):\n            if not p.is_file():\n                continue\n            if self.suffixes and p.suffix not in self.suffixes:\n                continue\n            # Skip if any ancestor directory name is in skip_subdir_names\n            parts = set(p.relative_to(self.repo_root).parts[:-1])\n            if self.skip_subdir_names and parts & self.skip_subdir_names:\n                continue\n            yield p\n\n    def is_allowlisted(self, path: Path) -> bool:\n        \"\"\"Return True if `path` matches any allowlist style.\n\n        Supports:\n        - exact relative path match\n        - glob against relative path (fnmatch)\n        - substring token anywhere in the absolute path string\n        \"\"\"\n        try:\n            rel = str(path.relative_to(self.repo_root))\n        except ValueError:\n            rel = str(path)\n\n        if rel in self.path_allowlist_exact:\n            return True\n        for pattern in self.path_allowlist_globs:\n            if fnmatch.fnmatch(rel, pattern):\n                return True\n        abs_str = str(path)\n        for token in self.path_allowlist_tokens:\n            if token in abs_str:\n                return True\n        return False\n\n    def iter_non_allowlisted(self) -> Iterable[Path]:\n        \"\"\"Convenience: iterate files that are NOT allowlisted.\"\"\"\n        for p in self.iter_files():\n            if not self.is_allowlisted(p):\n                yield p\n","numLines":146,"startLine":1,"totalLines":146}},"tool_result_meta":[{"id":"toolu_017shEdGEkWcsnq6iKr8zoa6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
