{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CDWsJ3GRAucrBe8dxegJh6","type":"tool_result","content":"1\t\"\"\"Implementation modules for :mod:`check_contamination`.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom types import FunctionType\n6\t\n7\t\n8\tdef bind_personal_paths(namespace: dict, component) -> None:\n9\t    \"\"\"Bind Rule 2 to the public facade's mutable global namespace.\n10\t\n11\t    Tests and downstream hooks patch ``check_contamination`` globals directly.\n12\t    Rebinding the extracted functions gives every lookup that same dictionary,\n13\t    rather than creating a stale copied set of collaborators in this package.\n14\t    \"\"\"\n15\t    for name in component.__all__:\n16\t        value = getattr(component, name)\n17\t        if isinstance(value, FunctionType):\n18\t            value = FunctionType(\n19\t                value.__code__, namespace, value.__name__, value.__defaults__,\n20\t                value.__closure__,\n21\t            )\n22\t            value.__kwdefaults__ = getattr(\n23\t                getattr(component, name), \"__kwdefaults__\", None)\n24\t            value.__annotations__ = getattr(\n25\t                getattr(component, name), \"__annotations__\", {}).copy()\n26\t            value.__doc__ = getattr(component, name).__doc__\n27\t            value.__module__ = namespace[\"__name__\"]\n28\t        namespace[name] = value\n29\t"}]},"parent_tool_use_id":null,"session_id":"50141584-ed08-437c-bb91-f56d610ea253","uuid":"e4b9ec81-ec62-432c-88f8-dfbc2c7a9685","timestamp":"2026-11-13T18:35:47.076Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_contamination/__init__.py","content":"\"\"\"Implementation modules for :mod:`check_contamination`.\"\"\"\n\nfrom __future__ import annotations\n\nfrom types import FunctionType\n\n\ndef bind_personal_paths(namespace: dict, component) -> None:\n    \"\"\"Bind Rule 2 to the public facade's mutable global namespace.\n\n    Tests and downstream hooks patch ``check_contamination`` globals directly.\n    Rebinding the extracted functions gives every lookup that same dictionary,\n    rather than creating a stale copied set of collaborators in this package.\n    \"\"\"\n    for name in component.__all__:\n        value = getattr(component, name)\n        if isinstance(value, FunctionType):\n            value = FunctionType(\n                value.__code__, namespace, value.__name__, value.__defaults__,\n                value.__closure__,\n            )\n            value.__kwdefaults__ = getattr(\n                getattr(component, name), \"__kwdefaults__\", None)\n            value.__annotations__ = getattr(\n                getattr(component, name), \"__annotations__\", {}).copy()\n            value.__doc__ = getattr(component, name).__doc__\n            value.__module__ = namespace[\"__name__\"]\n        namespace[name] = value\n","numLines":29,"startLine":1,"totalLines":29}},"tool_result_meta":[{"id":"toolu_01CDWsJ3GRAucrBe8dxegJh6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
