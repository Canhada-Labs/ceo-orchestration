ntries = []\n    for row in result.stdout.split(b\"\\0\"):\n        if not row:\n            continue\n        head, separator, raw_name = row.partition(b\"\\t\")\n        if not separator:\n            raise RuleOneInputError(\"malformed git index entry\")\n        try:\n            name = raw_name.decode(\"utf-8\")\n        except UnicodeDecodeError as exc:\n            raise RuleOneInputError(\n                \"a tracked Rule 1 path is not valid UTF-8\") from None\n        if \"\\ufffd\" in name:\n            raise RuleOneInputError(\"a tracked Rule 1 path is not valid UTF-8\")\n        mode = head.split(b\" \", 1)[0].decode(\"ascii\")\n        entries.append((mode, name.encode(\"utf-8\")))\n    return entries\n\n\ndef _read_regular(path: Path) -> bytes:\n    \"\"\"Read a regular blob without following a link swapped in after git.\"\"\"\n    fd = os.open(str(path), os.O_RDONLY | _NOFOLLOW | _NONBLOCK)\n    try:\n        if not stat.S_ISREG(os.fstat(fd).st_mode):\n            raise OSError(errno.EINVAL, \"tracked blob is not a regular file\")\n        chunks = []\n        while True:\n            block = os.read(fd, 1 << 20)\n            if not block:\n                return b\"\".join(chunks)\n            chunks.append(block)\n    finally:\n        os.close(fd)\n\n\ndef _blob(path: Path, mode: str) -> Optional[bytes]:\n    \"\"\"Read link payloads as payloads; never follow a tracked symlink.\"\"\"\n    if mode == \"120000\":\n        try:\n            return os.fsencode(os.readlink(path))\n        except OSError as exc:\n            raise RuleOneInputError(\n                \"cannot read a tracked symlink payload\") from exc\n    try:\n        return _read_regular(path)\n    except OSError as exc:\n        # A removed regular worktree file is permitted; an indexed symlink\n        # must still supply its literal target via readlink above.\n        if exc.errno == errno.ENOENT:\n            return None\n        if exc.errno == errno.ELOOP:\n            try:\n                return os.fsencode(os.readlink(path))\n            except OSError as link_error:\n                raise RuleOneInputError(\n                    \"cannot read a tracked symlink payload\") from link_error\n        raise RuleOneInputError(\"cannot read a tracked Rule 1 blob\") from exc\n\n\ndef scan_rule_one(\n    repo_root: Path,\n    pattern: Pattern[str],\n    allowlisted: Callable[[Path], bool],\n    never_allowlisted: Callable[[str], bool],\n    walked: Iterable[Path],\n    observed_modes: Mapping[str, str],\n) -> List[Path]:\n    \"\"\"Scan tracked Rule 1 blobs, with gitlinks as the sole mode exemption.\"\"\"\n    entries = _index(repo_root)\n    modes = {raw_name.decode(\"utf-8\"): mode for mode, raw_name in entries}\n    if modes != observed_modes:\n        raise RuleOneInputError(\"tracked index snapshots differ; the term scan has no verdict\")\n    seen = set()\n    for path in walked:\n        try:\n            name = path.relative_to(repo_root).as_posix()\n        except ValueError:\n            name = path.as_posix()\n        if name not in modes:\n            raise RuleOneInputError(\"walked path absent from the tracked index\")\n        seen.add(name)\n    if seen != set(modes):\n        raise RuleOneInputError(\"walk did not cover all tracked index entries\")\n    violations = []\n    for mode, raw_name in entries:\n        name = raw_name.decode(\"utf-8\")\n        if mode == _GITLINK_MODE:\n            continue\n        if mode not in _BLOB_MODES:\n            raise RuleOneInputError(\n                \"tracked Rule 1 entry has an unsupported mode\")\n        path = repo_root / name\n        if allowlisted(path) and not never_allowlisted(name):\n            continue\n        raw = _blob(path, mode)\n        if raw is None:\n            continue\n        try:\n            text = raw.decode(\"utf-8\")\n        except UnicodeDecodeError:\n            if never_allowlisted(name):\n                violations.append(path)\n            continue\n        if pattern.search(unicodedata.normalize(\"NFKC\", text)):\n            violations.append(path)\n    return violations\n","numLines":145,"startLine":1,"totalLines":145}},"tool_result_meta":[{"id":"toolu_018JeLkseH6671kKgYW2Tg5w","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
