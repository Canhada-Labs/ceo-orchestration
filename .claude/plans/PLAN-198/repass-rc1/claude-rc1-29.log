nd\n#   2 — fatal error (git not available, etc.)\n\nset -euo pipefail\n\nREPO_ROOT=\"$(cd \"$(dirname \"$0\")/../..\" && pwd)\"\n\nif ! command -v python3 >/dev/null 2>&1; then\n  echo \"FATAL: python3 not found\" >&2\n  exit 2\nfi\n\nexec python3 \"$REPO_ROOT/.claude/scripts/check_contamination.py\" \"$@\"\n","numLines":26,"startLine":1,"totalLines":26}},"tool_result_meta":[{"id":"toolu_01NxHQ1CT3PYRurFVHwp9pnk","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
