{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wf93C7Yh9FkqnBL9kFp31n","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom typing import NamedTuple\n4\t\n5\tdef report_personal_paths(\n6\t    repo_root: Path, allowlist_path: Path, fail_on_stale: bool = False,\n7\t    emit_rows: bool = False,\n8\t) -> int:\n9\t    \"\"\"Run the rule. 0 = clean, 1 = findings, 2 = unreadable input.\"\"\"\n10\t    allowlist: Dict[str, PersonalPathRow] = {}\n11\t    malformed: List[int] = []\n12\t    if not _personal_path_allowlist_is_tracked(\n13\t            repo_root, allowlist_path):\n14\t        # NOT fatal: an allowlist git cannot confirm is read as EMPTY,\n15\t        # exactly like an absent one, so every hit comes out unwaived.\n16\t        # The reason is PRINTED and not assumed — a gate that quietly\n17\t        # stops waiving looks identical to a gate that found nothing.\n18\t        # It goes to stderr under --emit-personal-path-rows, whose\n19\t        # stdout exists to be PASTED and must stay rows-only.\n20\t        print(\n21\t            \"• personal-path: %s is not tracked by git — reading it \"\n22\t            \"as EMPTY, so no row waives\"\n23\t            % _personal_path_display(allowlist_path, repo_root),\n24\t            file=(sys.stderr if emit_rows else sys.stdout),\n25\t        )\n26\t    else:\n27\t        try:\n28\t            allowlist, malformed = (\n29\t                load_personal_path_allowlist(allowlist_path))\n30\t        except PersonalPathUnreadable as exc:\n31\t            # The loader RAISES this -- for an allowlist that is a\n32\t            # directory or a device on disk, and for one git records as\n33\t            # a link -- and it is not an OSError, so it escaped the\n34\t            # tuple below as an rc-1 TRACEBACK whose frames name the\n35\t            # checkout (mechanism lane, round 10, A-P2-1; reproduced).\n36\t            # The comment on the tuple below is the post-mortem of the\n37\t            # identical bug with UnicodeDecodeError, one class earlier:\n38\t            # a fatal that is not NAMED here is a fatal that prints a\n39\t            # path. Same verdict as the scan's handler, rc 2, and the\n40\t            # message goes through the choke point because it is text\n41\t            # this module composed about a file it could not read.\n42\t            print(\n43\t                \"FATAL: cannot read %s: %s\"\n44\t                % (_personal_path_display(allowlist_path, repo_root),\n45\t                   _personal_path_safe(str(exc))),\n46\t                file=sys.stderr,\n47\t            )\n48\t            return 2\n49\t        except (OSError, UnicodeDecodeError, re.error) as exc:\n50\t            # Fail-CLOSED on INPUT, like the terms file: an allowlist\n51\t            # that exists and cannot be read — or cannot be DECODED —\n52\t            # leaves the rule unverified, not satisfied.\n53\t            # UnicodeDecodeError is NOT an OSError, so before it was\n54\t            # named here it escaped as a traceback (rc 1, absolute\n55\t            # checkout path in the frames) instead of this sanitised\n56\t            # rc 2.\n57\t            print(\n58\t                \"FATAL: cannot read %s: %s\"\n59\t                % (_personal_path_display(allowlist_path, repo_root),\n60\t                   _personal_path_safe(_oserror_reason(exc))),\n61\t                file=sys.stderr,\n62\t            )\n63\t            return 2\n64\t    if allowlist:\n65\t        # The REASON is the only text on a green run this module did not\n66\t        # compose, and v4.1 made it PRINTED: the waived inventory groups\n67\t        # 242 files under SEVEN human sentences. The redaction\n68\t        # choke point asks whether a string names a HOME DIRECTORY; it\n69\t        # cannot ask whether it names one of RULE 1's private terms,\n70\t        # because those are compiled from the repository root and the\n71\t        # choke point has none (text lane, round 12: leaving that open was\n72\t        # judged indefensible for a gate that ships).\n73\t        #\n74\t        # It does not need to. The reasons are read in ONE place, and that\n75\t        # place is called with `repo_root`. A row whose reason names a\n76\t        # private term is MALFORMED -- refused by row number, before any\n77\t        # printer sees it -- which is the same verdict a row naming a home\n78\t        # directory already gets, from the same file, for the same reason.\n79\t        # MEASURED on the shipped allowlist: 0 of 242 reasons match.\n80\t        try:\n81\t            terms = build_pattern(repo_root)\n82\t        except Exception as exc:\n83\t            # A BOUNDARY, not a type list -- the fifth time in this file.\n84\t            # Compiling a private-terms file is arbitrary regex work: 2 000\n85\t            # open parentheses raise `RecursionError`, which is not in any\n86\t            # of the three names this clause used to carry, and emit mode\n87\t            # RETURNS before `main()`'s catch-all -- so the traceback\n88\t            # escaped with rc 1 and the checkout path in its frames\n89\t            # (mechanism lane, round 14; this repository already has a\n90\t            # probe for that input).\n91\t            # Fail-CLOSED on INPUT, like every other unreadable input here:\n92\t            # a terms file that exists and cannot be read leaves the reasons\n93\t            # unverified, not verified.\n94\t            print(\n95\t                \"FATAL: cannot read %s: %s\"\n96\t                % (_PRIVATE_TERMS_RELPATH,\n97\t                   _personal_path_safe(_oserror_reason(exc))),\n98\t                file=sys.stderr,\n99\t            )\n100\t            return 2\n101\t        # BOTH readings, for the same reason the path predicate asks both:\n102\t        # a private term spelled with full-width characters passes a raw\n103\t        # search and is then printed into the waived inventory (mechanism\n104\t        # lane, round 14).\n105\t        offenders = [\n106\t            rel for rel in sorted(allowlist)\n107\t            if (terms.search(allowlist[rel].reason)\n108\t                or terms.search(unicodedata.normalize(\n109\t                    \"NFKC\", allowlist[rel].reason)))\n110\t        ]\n111\t        for rel in offenders:\n112\t            malformed.append(allowlist[rel].rowno)\n113\t            del allowlist[rel]\n114\t        malformed.sort()\n115\t    try:\n116\t        scan = scan_personal_paths(repo_root)\n117\t    except PersonalPathUnreadable as exc:\n118\t        print(\"FATAL: cannot read in-scope file %s\"\n119\t              % _personal_path_safe(str(exc)), file=sys.stderr)\n120\t        return 2\n121\t    except OSError as exc:\n122\t        # The ENUMERATION failed, not one file: the index query the walker\n123\t        # runs, or git itself. `PersonalPathUnreadable` names the first case\n124\t        # only, so this used to escape as an UNCAUGHT exception -- and an\n125\t        # uncaught exception prints a traceback whose FRAME lines carry the\n126\t        # absolute checkout path, which is the one string this rule exists to\n127\t        # keep out of the output (text lane, land round 1; reproduced by\n128\t        # injecting PermissionError into the walker before it was believed).\n129\t        # Same sanitised exit as every other fatal in this rule.\n130\t        print(\"FATAL: cannot enumerate in-scope files: %s\"\n131\t              % _personal_path_safe(\"%s: %s\" % (type(exc).__name__, exc)),\n132\t              file=sys.stderr)\n133\t        return 2\n134\t\n135\t    verdict = personal_path_verdict(scan, allowlist, malformed)\n136\t    # FIRST, and on EVERY run: the honoured set is the same statement\n137\t    # whether the verdict is green or red, and `--emit-personal-path-rows`\n138\t    # returns before a verdict is printed at all. Its stdout must stay\n139\t    # rows-only, so its copy goes to stderr.\n140\t    _print_personal_path_honoured(\n141\t        *_personal_path_honoured_rows(verdict.waived, allowlist),\n142\t        stream=(sys.stderr if emit_rows else sys.stdout))\n143\t\n144\t    if emit_rows:\n145\t        # MALFORMED rows are not suppressed by this mode. The rows on\n146\t        # stdout are computed AGAINST the waiver set, so a waiver set the\n147\t        # parser could not read whole makes the emission itself\n148\t        # unreliable — and returning 0 here told an operator who had just\n149\t        # seen rc 1 that the problem had gone away (pair-rail round 2,\n150\t        # P2). stdout stays rows-only; the reason goes to stderr.\n151\t        rc = _emit_personal_path_rows(scan, allowlist)\n152\t        if malformed:\n153\t            print(\n154\t                \"NOTE: %d malformed allowlist row(s) — the rows above \"\n155\t                \"were computed against a waiver set that does not parse; \"\n156\t                \"fix those rows and re-run\" % len(malformed),\n157\t                file=sys.stderr)\n158\t            return 1\n159\t        return rc\n160\t\n161\t    if verdict.stale:\n162\t        # Advisory by design: a row waives ONE path, so a row matching nothing\n163\t        # waives nothing. Fatal-by-default would turn every archived plan —\n164\t        # and every adopter checkout, which has none of these artifacts — red.\n165\t        print(\"• personal-path: %d allowlist row(s) match no file (stale)\"\n166\t              % len(verdict.stale))\n167\t\n168\t    if not (verdict.unwaived or verdict.malformed or verdict.mismatched):\n169\t        if fail_on_stale and verdict.stale:\n170\t            print(\"❌ personal-path: stale allowlist rows, with --fail-on-stale\")\n171\t            # MASKED here, because the printer no longer escapes: the\n172\t            # stale list is the one place that handed it raw rels.\n173\t            _print_personal_path_group(\n174\t                \"STALE\",\n175\t                [_personal_path_mask_rel(rel) for rel in verdict.stale])\n176\t            return 1\n177\t        print(\"✓ personal-path: no absolute home paths outside the allowlist \"\n178\t              \"under docs/ or .claude/plans/ (%d row(s) honoured, above)\"\n179\t              % len(verdict.waived))\n180\t        return 0\n181\t\n182\t    print(\"❌ personal-path: absolute home path(s) with no allowlist row\")\n183\t    rows: List[str] = []\n184\t    name_hits = False\n185\t    for hit in verdict.unwaived:\n186\t        for lineno in hit.lines:\n187\t            if lineno == _PERSONAL_PATH_NAME_LINE:\n188\t                name_hits = True\n189\t            rows.append(\"%s:%d\"\n190\t                        % (_personal_path_mask_rel(hit.rel), lineno))\n191\t    _print_personal_path_group(\"file:line\", rows)\n192\t    _print_personal_path_group(\n193\t        \"row sha256 no longer matches the file (re-read it, then record \"\n194\t        \"the new digest)\",\n195\t        [_personal_path_mask_rel(rel) for rel in verdict.mismatched],\n196\t    )\n197\t    _report_personal_path_eol_suspicion(scan, allowlist, verdict)\n198\t    if name_hits:\n199\t        print(\"    (`:0` = the PATH itself names a home directory. Rename\")\n200\t        print(\"     the file -- an allowlist row naming one is refused.)\")\n201\t    # Row NUMBERS, composed here: nothing of the file's content reaches\n202\t    # this list, which is why it needs no masking now that the printer\n203\t    # does none.\n204\t    _print_personal_path_group(\n205\t        \"MALFORMED allowlist rows (expected `<path> | sha256:<64 hex> | \"\n206\t        \"<reason>`)\",\n207\t        [\"row %d\" % rowno for rowno in verdict.malformed],\n208\t    )\n209\t    print(\"\")\n210\t    print(\"Cure, in order of preference:\")\n211\t    print(\"  1. remove the absolute path — a placeholder (/Users/<user>/, \"\n212\t          \"$HOME, ~) says the same thing;\")\n213\t    print(\"  2. if the file is a FROZEN artifact that must not be rewritten, \"\n214\t          \"add ONE row per file to\")\n215\t    print(\"     %s\" % _personal_path_display(allowlist_path, repo_root))\n216\t    print(\"     in the form `<path> | sha256:<64 hex> | <reason>`, and\")\n217\t    print(\"     COMMIT IT IN THE SAME CHANGE so the waiver is reviewable\")\n218\t    print(\"     — an allowlist git does not TRACK is read as empty. The\")\n219\t    print(\"     digest pins the row to the bytes you read: edit the file\")\n220\t    print(\"     and the waiver lapses, on purpose. Rows to start from,\")\n221\t    print(\"     digests already filled in:\")\n222\t    print(\"       python3 .claude/scripts/check_contamination.py \"\n223\t          \"--emit-personal-path-rows\")\n224\t    print(\"NOTHING is exempt by NAME, by SUFFIX or by SIGNATURE — not\")\n225\t    print(\"OWNER-*.sh, not *.asc, not approved.md. Every in-scope file is\")\n226\t    print(\"scanned the same way, and the ONLY waiver is a row pinned to\")\n227\t    print(\"the sha256 of the content it waives. A signed sentinel is\")\n228\t    print(\"waived by such a row like anything else: the signature freezes\")\n229\t    print(\"the bytes, so the digest cannot lapse behind your back.\")\n230\t    return 1\n231\t\n232\t\n233\t\n234\t"}]},"parent_tool_use_id":null,"session_id":"076885e0-c25e-454e-ad62-d3f5efd0e645","uuid":"ed1b9eb5-d899-4eff-b03a-fdaf93885b34","timestamp":"2026-11-15T11:28:31.159Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_contamination/personal_reporting.py","content":"from __future__ import annotations\n\nfrom typing import NamedTuple\n\ndef report_personal_paths(\n    repo_root: Path, allowlist_path: Path, fail_on_stale: bool = False,\n    emit_rows: bool = False,\n) -> int:\n    \"\"\"Run the rule. 0 = clean, 1 = findings, 2 = unreadable input.\"\"\"\n    allowlist: Dict[str, PersonalPathRow] = {}\n    malformed: List[int] = []\n    if not _personal_path_allowlist_is_tracked(\n            repo_root, allowlist_path):\n        # NOT fatal: an allowlist git cannot confirm is read as EMPTY,\n        # exactly like an absent one, so every hit comes out unwaived.\n        # The reason is PRINTED and not assumed — a gate that quietly\n        # stops waiving looks identical to a gate that found nothing.\n        # It goes to stderr under --emit-personal-path-rows, whose\n        # stdout exists to be PASTED and must stay rows-only.\n        print(\n            \"• personal-path: %s is not tracked by git — reading it \"\n            \"as EMPTY, so no row waives\"\n            % _personal_path_display(allowlist_path, repo_root),\n            file=(sys.stderr if emit_rows else sys.stdout),\n        )\n    else:\n        try:\n            allowlist, malformed = (\n                load_personal_path_allowlist(allowlist_path))\n        except PersonalPathUnreadable as exc:\n            # The loader RAISES this -- for an allowlist that is a\n            # directory or a device on disk, and for one git records as\n            # a link -- and it is not an OSError, so it escaped the\n            # tuple below as an rc-1 TRACEBACK whose frames name the\n            # checkout (mechanism lane, round 10, A-P2-1; reproduced).\n            # The comment on the tuple below is the post-mortem of the\n            # identical bug with UnicodeDecodeError, one class earlier:\n            # a fatal that is not NAMED here is a fatal that prints a\n            # path. Same verdict as the scan's handler, rc 2, and the\n            # message goes through the choke point because it is text\n            # this module composed about a file it could not read.\n            print(\n                \"FATAL: cannot read %s: %s\"\n                % (_personal_path_display(allowlist_path, repo_root),\n                   _personal_path_safe(str(exc))),\n                file=sys.stderr,\n            )\n            return 2\n        except (OSError, UnicodeDecodeError, re.error) as exc:\n            # Fail-CLOSED on INPUT, like the terms file: an allowlist\n            # that exists and cannot be read — or cannot be DECODED —\n            # leaves the rule unverified, not satisfied.\n            # UnicodeDecodeError is NOT an OSError, so before it was\n            # named here it escaped as a traceback (rc 1, absolute\n            # checkout path in the frames) instead of this sanitised\n            # rc 2.\n            print(\n                \"FATAL: cannot read %s: %s\"\n                % (_personal_path_display(allowlist_path, repo_root),\n                   _personal_path_safe(_oserror_reason(exc))),\n                file=sys.stderr,\n            )\n            return 2\n    if allowlist:\n        # The REASON is the only text on a green run this module did not\n        # compose, and v4.1 made it PRINTED: the waived inventory groups\n        # 242 files under SEVEN human sentences. The redaction\n        # choke point asks whether a string names a HOME DIRECTORY; it\n        # cannot ask whether it names one of RULE 1's private terms,\n        # because those are compiled from the repository root and the\n        # choke point has none (text lane, round 12: leaving that open was\n        # judged indefensible for a gate that ships).\n        #\n        # It does not need to. The reasons are read in ONE place, and that\n        # place is called with `repo_root`. A row whose reason names a\n        # private term is MALFORMED -- refused by row number, before any\n        # printer sees it -- which is the same verdict a row naming a home\n        # directory already gets, from the same file, for the same reason.\n        # MEASURED on the shipped allowlist: 0 of 242 reasons match.\n        try:\n            terms = build_pattern(repo_root)\n        except Exception as exc:\n            # A BOUNDARY, not a type list -- the fifth time in this file.\n            # Compiling a private-terms file is arbitrary regex work: 2 000\n            # open parentheses raise `RecursionError`, which is not in any\n            # of the three names this clause used to carry, and emit mode\n            # RETURNS before `main()`'s catch-all -- so the traceback\n            # escaped with rc 1 and the checkout path in its frames\n            # (mechanism lane, round 14; this repository already has a\n            # probe for that input).\n            # Fail-CLOSED on INPUT, like every other unreadable input here:\n            # a terms file that exists and cannot be read leaves the reasons\n            # unverified, not verified.\n            print(\n                \"FATAL: cannot read %s: %s\"\n                % (_PRIVATE_TERMS_RELPATH,\n                   _personal_path_safe(_oserror_reason(exc))),\n                file=sys.stderr,\n            )\n            return 2\n        # BOTH readings, for the same reason the path predicate asks both:\n        # a private term spelled with full-width characters passes a raw\n        # search and is then printed into the waived inventory (mechanism\n        # lane, round 14).\n        offenders = [\n            rel for rel in sorted(allowlist)\n            if (terms.search(allowlist[rel].reason)\n                or terms.search(unicodedata.normalize(\n                    \"NFKC\", allowlist[rel].reason)))\n        ]\n        for rel in offenders:\n            malformed.append(allowlist[rel].rowno)\n            del allowlist[rel]\n        malformed.sort()\n    try:\n        scan = scan_personal_paths(repo_root)\n    except PersonalPathUnreadable as exc:\n        print(\"FATAL: cannot read in-scope file %s\"\n              % _personal_path_safe(str(exc)), file=sys.stderr)\n        return 2\n    except OSError as exc:\n        # The ENUMERATION failed, not one file: the index query the walker\n        # runs, or git itself. `PersonalPathUnreadable` names the first case\n        # only, so this used to escape as an UNCAUGHT exception -- and an\n        # uncaught exception prints a traceback whose FRAME lines carry the\n        # absolute checkout path, which is the one string this rule exists to\n        # keep out of the output (text lane, land round 1; reproduced by\n        # injecting PermissionError into the walker before it was believed).\n        # Same sanitised exit as every other fatal in this rule.\n        print(\"FATAL: cannot enumerate in-scope files: %s\"\n              % _personal_path_safe(\"%s: %s\" % (type(exc).__name__, exc)),\n              file=sys.stderr)\n        return 2\n\n    verdict = personal_path_verdict(scan, allowlist, malformed)\n    # FIRST, and on EVERY run: the honoured set is the same statement\n    # whether the verdict is green or red, and `--emit-personal-path-rows`\n    # returns before a verdict is printed at all. Its stdout must stay\n    # rows-only, so its copy goes to stderr.\n    _print_personal_path_honoured(\n        *_personal_path_honoured_rows(verdict.waived, allowlist),\n        stream=(sys.stderr if emit_rows else sys.stdout))\n\n    if emit_rows:\n        # MALFORMED rows are not suppressed by this mode. The rows on\n        # stdout are computed AGAINST the waiver set, so a waiver set the\n        # parser could not read whole makes the emission itself\n        # unreliable — and returning 0 here told an operator who had just\n        # seen rc 1 that the problem had gone away (pair-rail round 2,\n        # P2). stdout stays rows-only; the reason goes to stderr.\n        rc = _emit_personal_path_rows(scan, allowlist)\n        if malformed:\n            print(\n                \"NOTE: %d malformed allowlist row(s) — the rows above \"\n                \"were computed against a waiver set that does not parse; \"\n                \"fix those rows and re-run\" % len(malformed),\n                file=sys.stderr)\n            return 1\n        return rc\n\n    if verdict.stale:\n        # Advisory by design: a row waives ONE path, so a row matching nothing\n        # waives nothing. Fatal-by-default would turn every archived plan —\n        # and every adopter checkout, which has none of these artifacts — red.\n        print(\"• personal-path: %d allowlist row(s) match no file (stale)\"\n              % len(verdict.stale))\n\n    if not (verdict.unwaived or verdict.malformed or verdict.mismatched):\n        if fail_on_stale and verdict.stale:\n            print(\"❌ personal-path: stale allowlist rows, with --fail-on-stale\")\n            # MASKED here, because the printer no longer escapes: the\n            # stale list is the one place that handed it raw rels.\n            _print_personal_path_group(\n                \"STALE\",\n                [_personal_path_mask_rel(rel) for rel in verdict.stale])\n            return 1\n        print(\"✓ personal-path: no absolute home paths outside the allowlist \"\n              \"under docs/ or .claude/plans/ (%d row(s) honoured, above)\"\n              % len(verdict.waived))\n        return 0\n\n    print(\"❌ personal-path: absolute home path(s) with no allowlist row\")\n    rows: List[str] = []\n    name_hits = False\n    for hit in verdict.unwaived:\n        for lineno in hit.lines:\n            if lineno == _PERSONAL_PATH_NAME_LINE:\n                name_hits = True\n            rows.append(\"%s:%d\"\n                        % (_personal_path_mask_rel(hit.rel), lineno))\n    _print_personal_path_group(\"file:line\", rows)\n    _print_personal_path_group(\n        \"row sha256 no longer matches the file (re-read it, then record \"\n        \"the new digest)\",\n        [_personal_path_mask_rel(rel) for rel in verdict.mismatched],\n    )\n    _report_personal_path_eol_suspicion(scan, allowlist, verdict)\n    if name_hits:\n        print(\"    (`:0` = the PATH itself names a home directory. Rename\")\n        print(\"     the file -- an allowlist row naming one is refused.)\")\n    # Row NUMBERS, composed here: nothing of the file's content reaches\n    # this list, which is why it needs no masking now that the printer\n    # does none.\n    _print_personal_path_group(\n        \"MALFORMED allowlist rows (expected `<path> | sha256:<64 hex> | \"\n        \"<reason>`)\",\n        [\"row %d\" % rowno for rowno in verdict.malformed],\n    )\n    print(\"\")\n    print(\"Cure, in order of preference:\")\n    print(\"  1. remove the absolute path — a placeholder (/Users/<user>/, \"\n          \"$HOME, ~) says the same thing;\")\n    print(\"  2. if the file is a FROZEN artifact that must not be rewritten, \"\n          \"add ONE row per file to\")\n    print(\"     %s\" % _personal_path_display(allowlist_path, repo_root))\n    print(\"     in the form `<path> | sha256:<64 hex> | <reason>`, and\")\n    print(\"     COMMIT IT IN THE SAME CHANGE so the waiver is reviewable\")\n    print(\"     — an allowlist git does not TRACK is read as empty. The\")\n    print(\"     digest pins the row to the bytes you read: edit the file\")\n    print(\"     and the waiver lapses, on purpose. Rows to start from,\")\n    print(\"     digests already filled in:\")\n    print(\"       python3 .claude/scripts/check_contamination.py \"\n          \"--emit-personal-path-rows\")\n    print(\"NOTHING is exempt by NAME, by SUFFIX or by SIGNATURE — not\")\n    print(\"OWNER-*.sh, not *.asc, not approved.md. Every in-scope file is\")\n    print(\"scanned the same way, and the ONLY waiver is a row pinned to\")\n    print(\"the sha256 of the content it waives. A signed sentinel is\")\n    print(\"waived by such a row like anything else: the signature freezes\")\n    print(\"the bytes, so the digest cannot lapse behind your back.\")\n    return 1\n\n\n\n","numLines":234,"startLine":1,"totalLines":234}},"tool_result_meta":[{"id":"toolu_01Wf93C7Yh9FkqnBL9kFp31n","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
