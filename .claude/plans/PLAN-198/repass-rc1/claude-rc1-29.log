{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VjsDz9fJzWVCyoeMH8KxoF","type":"tool_result","content":"1\t\"\"\"Installed CLIs must carry their split implementations in the core profile.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport os\n6\timport subprocess\n7\timport sys\n8\tfrom pathlib import Path\n9\tfrom unittest.mock import patch\n10\t\n11\tfrom _lib.testing import TestEnvContext\n12\tfrom _subprocess_helpers import run_in_process_group\n13\t\n14\t\n15\t_REPO = Path(__file__).resolve().parents[3]\n16\t_PACKAGES = (\"_audit_query\", \"_installer_write_safety\", \"_contamination\")\n17\t_SCRIPTS = (\n18\t    \"audit-query.py\", \"check-installer-write-safety.py\", \"check_contamination.py\",\n19\t)\n20\t\n21\t\n22\tclass TestInstalledScriptPackages(TestEnvContext):\n23\t    def test_core_install_runs_split_clis_without_source_tree(self) -> None:\n24\t        \"\"\"Inspect delivered files and execute each CLI from the destination.\"\"\"\n25\t        target = self.project_dir / \"installed-core\"\n26\t        target.mkdir()\n27\t        env = dict(os.environ)\n28\t        env.pop(\"PYTHONPATH\", None)\n29\t        env.update({\n30\t            \"HOME\": str(self.project_dir),\n31\t            \"CLAUDE_PROJECT_DIR\": str(target),\n32\t            \"CLAUDE_PROJECT_DIR_NATIVE\": \"\",\n33\t            \"CEO_AUDIT_LOG_DIR\": str(self.project_dir / \"audit\"),\n34\t        })\n35\t        with patch.dict(os.environ, env, clear=True):\n36\t            install = run_in_process_group(\n37\t                [\"bash\", str(_REPO / \"scripts/install.sh\"), str(target),\n38\t                 \"--profile\", \"core\"],\n39\t                cwd=str(_REPO), env=env, capture_output=True, text=True,\n40\t                timeout=120, check=False,\n41\t            )\n42\t        self.assertEqual(install.returncode, 0, install.stderr[-1000:])\n43\t\n44\t        for name in _PACKAGES:\n45\t            delivered = target / \".claude/hooks/_lib\" / name\n46\t            original = _REPO / \".claude/hooks/_lib\" / name\n47\t            self.assertTrue(delivered.is_dir(), name)\n48\t            original_modules = sorted(p.name for p in original.glob(\"*.py\"))\n49\t            delivered_modules = sorted(p.name for p in delivered.glob(\"*.py\"))\n50\t            self.assertTrue(original_modules, name)\n51\t            self.assertEqual(delivered_modules, original_modules, name)\n52\t\n53\t        for name in _SCRIPTS:\n54\t            script = target / \".claude/scripts\" / name\n55\t            self.assertTrue(script.is_file(), name)\n56\t            completed = run_in_process_group(\n57\t                [sys.executable, str(script), \"--help\"],\n58\t                cwd=str(target), env=env, capture_output=True, text=True,\n59\t                timeout=30, check=False,\n60\t            )\n61\t            self.assertEqual(\n62\t                completed.returncode, 0,\n63\t                f\"{name}: {completed.stderr[-1000:]}\",\n64\t            )\n65\t            self.assertIn(\"usage\", completed.stdout.lower(), name)\n66\t"}]},"parent_tool_use_id":null,"session_id":"076885e0-c25e-454e-ad62-d3f5efd0e645","uuid":"d5c51bdb-71c0-4d3e-bc26-8aaf75283577","timestamp":"2026-11-15T11:33:01.717Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/scripts/tests/test_installed_script_packages.py","content":"\"\"\"Installed CLIs must carry their split implementations in the core profile.\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom _lib.testing import TestEnvContext\nfrom _subprocess_helpers import run_in_process_group\n\n\n_REPO = Path(__file__).resolve().parents[3]\n_PACKAGES = (\"_audit_query\", \"_installer_write_safety\", \"_contamination\")\n_SCRIPTS = (\n    \"audit-query.py\", \"check-installer-write-safety.py\", \"check_contamination.py\",\n)\n\n\nclass TestInstalledScriptPackages(TestEnvContext):\n    def test_core_install_runs_split_clis_without_source_tree(self) -> None:\n        \"\"\"Inspect delivered files and execute each CLI from the destination.\"\"\"\n        target = self.project_dir / \"installed-core\"\n        target.mkdir()\n        env = dict(os.environ)\n        env.pop(\"PYTHONPATH\", None)\n        env.update({\n            \"HOME\": str(self.project_dir),\n            \"CLAUDE_PROJECT_DIR\": str(target),\n            \"CLAUDE_PROJECT_DIR_NATIVE\": \"\",\n            \"CEO_AUDIT_LOG_DIR\": str(self.project_dir / \"audit\"),\n        })\n        with patch.dict(os.environ, env, clear=True):\n            install = run_in_process_group(\n                [\"bash\", str(_REPO / \"scripts/install.sh\"), str(target),\n                 \"--profile\", \"core\"],\n                cwd=str(_REPO), env=env, capture_output=True, text=True,\n                timeout=120, check=False,\n            )\n        self.assertEqual(install.returncode, 0, install.stderr[-1000:])\n\n        for name in _PACKAGES:\n            delivered = target / \".claude/hooks/_lib\" / name\n            original = _REPO / \".claude/hooks/_lib\" / name\n            self.assertTrue(delivered.is_dir(), name)\n            original_modules = sorted(p.name for p in original.glob(\"*.py\"))\n            delivered_modules = sorted(p.name for p in delivered.glob(\"*.py\"))\n            self.assertTrue(original_modules, name)\n            self.assertEqual(delivered_modules, original_modules, name)\n\n        for name in _SCRIPTS:\n            script = target / \".claude/scripts\" / name\n            self.assertTrue(script.is_file(), name)\n            completed = run_in_process_group(\n                [sys.executable, str(script), \"--help\"],\n                cwd=str(target), env=env, capture_output=True, text=True,\n                timeout=30, check=False,\n            )\n            self.assertEqual(\n                completed.returncode, 0,\n                f\"{name}: {completed.stderr[-1000:]}\",\n            )\n            self.assertIn(\"usage\", completed.stdout.lower(), name)\n","numLines":66,"startLine":1,"totalLines":66}},"tool_result_meta":[{"id":"toolu_01VjsDz9fJzWVCyoeMH8KxoF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
