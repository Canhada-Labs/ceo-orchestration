{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1QnvCZ5MgbCwb64WMAH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01LRrMUDcPhSDxP5sWUq2Xqp","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_contamination/personal_path_policy.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15027,"cache_read_input_tokens":99988,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15027},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"50141584-ed08-437c-bb91-f56d610ea253","uuid":"358af302-de55-4218-af2f-62ff969da3a9","timestamp":"2026-11-13T18:36:32.273Z","request_id":"req_011Ch1Qnuz9SEzfST93aC1ys","wire_tool_inputs":{"toolu_01LRrMUDcPhSDxP5sWUq2Xqp":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_contamination/personal_path_policy.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LRrMUDcPhSDxP5sWUq2Xqp","type":"tool_result","content":"1\t\"\"\"Rule 2 waiver, verdict and presentation helpers.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tfrom .personal_path_rows import _emit_personal_path_rows, _personal_path_mask_owner\n5\t\n6\timport re\n7\tfrom typing import Dict, List, Tuple\n8\t\n9\t_PERSONAL_PATH_ROW_RE = re.compile(\n10\t    r\"^([^\\s|]+)\\s*\\|\\s*sha256:([0-9A-Fa-f]{64})\\s*\\|\\s*(\\S.*)$\")\n11\t\n12\t\n13\t#: How many ASCII letters or digits a written reason must carry, counted\n14\t#: after NFKC. Eight is a WORD, not a mark: no filler, no combining mark\n15\t#: and no invisible codepoint reaches it, whatever category a future\n16\t#: Unicode revision puts it in. MEASURED on the shipped allowlist before\n17\t#: choosing the number: the seven reasons carry 60 to 112 each.\n18\t_PERSONAL_PATH_REASON_MIN_INK = 8\n19\t\n20\t\n21\tdef _personal_path_reason_is_visible(reason: str) -> bool:\n22\t    r\"\"\"True when ``reason`` is a decision a reviewer can actually READ.\n23\t\n24\t    TWO POSITIVE conditions. Neither is a list of what is forbidden, and\n25\t    that is the whole point. The deny-list form of this predicate was\n26\t    defeated three rounds running, each time by a character one category\n27\t    further out: `Cf` zero-width and bidi (round 19), `Mn` combining\n28\t    marks (round 20), and then `Lo`/`So` fillers -- U+3164 HANGUL\n29\t    FILLER, U+115F, U+2800 BRAILLE PATTERN BLANK -- which \"carry ink\" by\n30\t    category and render as nothing (round 21). Enumerating categories\n31\t    cannot close a class whose next member has not been named yet.\n32\t    Asking what a written sentence HAS can.\n33\t\n34\t    * after NFKC, at least `_PERSONAL_PATH_REASON_MIN_INK` characters\n35\t      from `[A-Za-z0-9]`. ASCII only, and COUNTED rather than merely\n36\t      present: eight letters or digits is a word somebody typed. Every\n37\t      filler of every category contributes ZERO, so the whole family\n38\t      closes at once, including its unnamed members. NFKC runs first so\n39\t      a full-width or mathematical spelling counts as the word it is --\n40\t      the same folding the path predicate already asks for;\n41\t    * every character PRINTABLE, `str.isprintable()`. That is the\n42\t      stdlib's own answer rather than a category list of this module's:\n43\t      False for C0/C1 controls, for the format characters, for the\n44\t      separators other than a plain space, and for whatever a later\n45\t      Unicode revision adds to those. It keeps the round-19 finding\n46\t      closed -- `reviewed 2026<CR>HIDDEN` carries EIGHTEEN ASCII\n47\t      letters and digits, more than twice the threshold, and is still\n48\t      refused because it renders as a row overwritten in the terminal\n49\t      that shows it. That is the case which proves the two conditions\n50\t      are not redundant: ink alone would pass it. And it is done without\n51\t      this module owning a list of what is invisible.\n52\t\n53\t    `\\r` is excluded from the FILE-level class two hundred lines up and\n54\t    refused HERE, and that is not an inconsistency: there it is the\n55\t    terminator of a physical line the row loop counts, and here it is a\n56\t    character somebody put inside a written decision.\n57\t\n58\t    A row whose reason fails this is MALFORMED by row NUMBER, which is\n59\t    the address the operator can act on, and it waives nothing.\n60\t    \"\"\"\n61\t    if not reason.isprintable():\n62\t        return False\n63\t    folded = unicodedata.normalize(\"NFKC\", reason)\n64\t    ink = sum(\n65\t        1 for char in folded\n66\t        if (\"0\" <= char <= \"9\") or (\"A\" <= char <= \"Z\")\n67\t        or (\"a\" <= char <= \"z\")\n68\t    )\n69\t    return ink >= _PERSONAL_PATH_REASON_MIN_INK\n70\t\n71\t\n72\tdef _personal_path_allowlist_is_tracked(\n73\t    repo_root: Path, allowlist_path: Path,\n74\t) -> bool:\n75\t    \"\"\"True only when git CONFIRMS the allowlist is in the index.\n76\t\n77\t    Every waiver in this rule -- and there is exactly one kind, the\n78\t    content-pinned `<path> | sha256:<64 hex> | <reason>` row -- rests on\n79\t    ONE claim: the allowlist is a TRACKED file, so a waiver is something\n80\t    somebody COMMITTED and not something somebody left in a working tree.\n81\t    Nothing checked that claim. The parser asked `is_file()` and read the\n82\t    bytes; git was never consulted, in a rule that asks git every other\n83\t    question it has.\n84\t\n85\t    This used to say \"a reviewable DIFF\", and the r13 decision removed\n86\t    that premise: whether the file RENDERS in `git diff` is no longer a\n87\t    property this rule rests on, because four rail rounds showed it can\n88\t    be taken away by whoever controls the repository. What survives is\n89\t    the smaller, checkable claim above -- an untracked file is not a\n90\t    decision anybody recorded -- and the visibility of what was granted\n91\t    now comes from `_personal_path_honoured_rows`, which prints it.\n92\t\n93\t    MEASURED on the framework's own tree (cross-vendor lane, S344, P2):\n94\t    `git rm --cached` the allowlist and the file is still on disk, byte for\n95\t    byte, unknown to git -- and the gate still waived 242 files. A claim a\n96\t    security matcher does not check is not a\n97\t    control, it is a comment.\n98\t\n99\t    Fail-CLOSED, by the rule `_personal_path_assert_enumerable` already\n100\t    states: this is a GATE, not a hook, so an answer git cannot give is not\n101\t    a yes. Git missing, git timing out, git exiting non-zero, a path\n102\t    OUTSIDE the repository, a SYMLINK anywhere between the file and the\n103\t    root, an ancestor walk that ran out of budget, and an index mode that\n104\t    is not a regular blob all read as NOT tracked -- and an untracked\n105\t    allowlist is read as EMPTY, exactly like an absent one, so every hit\n106\t    is unwaived.\n107\t\n108\t    HONEST LIMIT, declared in the header: TRACKED is not COMMITTED. An\n109\t    uncommitted edit to a tracked allowlist still grants, because that edit\n110\t    IS a `git diff` -- the reviewable artifact the claim was always about --\n111\t    and refusing it would make \"add the row, run the gate, commit it in the\n112\t    same change\" impossible to do in that order.\n113\t    \"\"\"\n114\t    # A SYMLINK is not the file it points at. `resolve()` follows it, so an\n115\t    # UNTRACKED link aimed at a tracked file answered TRACKED and its rows\n116\t    # were then trusted — a waiver channel opened by a\n117\t    # `ln -s` nobody reviewed (pair-rail round 2, P1). Every component\n118\t    # between the repository and the file is asked, not just the last: a\n119\t    # linked PARENT directory redirects the path just as completely.\n120\t    #\n121\t    # ROUND 3 hardened this same block twice more, so it is written here\n122\t    # in its final form rather than patched again downstream: the budget\n123\t    # is a REFUSAL when exhausted (P1), and the catch is a BOUNDARY\n124\t    # because `resolve()` raises a bare RuntimeError for a symlink loop\n125\t    # on Python 3.9 (P2, both lanes).\n126\t    try:\n127\t        probe = allowlist_path\n128\t        root_real = repo_root.resolve()\n129\t        reached_root = False\n130\t        for _ in range(_PERSONAL_PATH_ANCESTOR_CAP):\n131\t            if probe.is_symlink():\n132\t                return False\n133\t            if probe.resolve() == root_real or probe.parent == probe:\n134\t                reached_root = True\n135\t                break\n136\t            probe = probe.parent\n137\t        if not reached_root:\n138\t            # The budget was EXHAUSTED, not satisfied. Falling through\n139\t            # here left the remaining ancestors unexamined, so an\n140\t            # allowlist deeper than the cap below an untracked link was\n141\t            # resolved THROUGH that link and git confirmed the TARGET\n142\t            # (pair-rail round 3, P1). A check that runs out of budget\n143\t            # is an unfinished check, and an unfinished check in a\n144\t            # security matcher is a no.\n145\t            return False\n146\t    except Exception:\n147\t        # A BOUNDARY, not a type list -- the fourth time in this file.\n148\t        # `Path.resolve()` raises a bare RuntimeError for a symlink LOOP\n149\t        # on Python 3.9, so `except OSError` let an rc-1 traceback\n150\t        # carrying the supplied absolute path escape from here\n151\t        # (pair-rail round 3, P2, both lanes).\n152\t        return False\n153\t    try:\n154\t        rel = allowlist_path.resolve().relative_to(\n155\t            repo_root.resolve()).as_posix()\n156\t    except Exception:\n157\t        # Outside the repository, so git is not its reviewer and nothing in\n158\t        # it can be a reviewable diff. `--personal-path-allowlist` still\n159\t        # NAMES the file in the report; it simply waives nothing.\n160\t        return False\n161\t    # `--` ends OPTION parsing; it does not make the operand LITERAL. An\n162\t    # allowlist path containing pathspec magic — `allow-*.txt`, or an\n163\t    # explicit `:(glob)` — matched OTHER tracked files, so an untracked\n164\t    # file answered TRACKED and its rows were then\n165\t    # trusted (pair-rail round 1, P1, both lanes; reproduced with a\n166\t    # nonexistent path literally named `*`). Two independent defences:\n167\t    # `:(literal)` magic, and a check that what came back is EXACTLY the\n168\t    # one path asked about — the second holds even where the first is\n169\t    # unsupported.\n170\t    try:\n171\t        proc = subprocess.run(\n172\t            [\"git\", \"ls-files\", \"-z\", \"--error-unmatch\",\n173\t             \"--\", \":(literal)\" + rel],\n174\t            cwd=str(repo_root), capture_output=True, check=False, timeout=30,\n175\t        )\n176\t    except (OSError, subprocess.SubprocessError):\n177\t        return False\n178\t    if proc.returncode != 0:\n179\t        return False\n180\t    listed = [name for name\n181\t              in proc.stdout.decode(\"utf-8\", errors=\"replace\").split(\"\\0\")\n182\t              if name]\n183\t    if listed != [rel]:\n184\t        return False\n185\t    # The INDEX MODE, not the filesystem. Under `core.symlinks=false`\n186\t    # git materialises a mode-120000 entry as a REGULAR FILE whose\n187\t    # content is the target string: `is_symlink()` above answers False\n188\t    # for a link, git confirms the NAME, and a link payload shaped like\n189\t    # a valid waiver row was parsed and GRANTED -- a leaking file got a\n190\t    # clean verdict (pair-rail round 3, P1, both lanes; reproduced on\n191\t    # disk). This is the round-1 lesson -- link status comes from the\n192\t    # index, never from the filesystem -- applied to the SECOND of the\n193\t    # two surfaces that needed it. Only a regular blob can be an\n194\t    # allowlist; 120000, the 160000 gitlink and any mode added later\n195\t    # are refused, so the answer does not depend on this checkout's\n196\t    # `core.symlinks` setting.\n197\t    try:\n198\t        mode = _personal_path_index_modes(repo_root).get(rel)\n199\t    except Exception:\n200\t        # A SECOND git call, with a second way to fail. It is outside\n201\t        # the caller's scan boundary, so an escape here was an rc-1\n202\t        # traceback instead of the documented empty-allowlist behaviour\n203\t        # (pair-rail round 4, P2, both lanes). An answer git cannot\n204\t        # give is not a yes -- the same rule as every branch above.\n205\t        return False\n206\t    return mode in (\"100644\", \"100755\")\n207\t\n208\t\n209\tdef personal_path_verdict(\n210\t    scan: PersonalPathScan,\n211\t    allowlist: Dict[str, \"PersonalPathRow\"],\n212\t    malformed: Optional[List[int]] = None,\n213\t) -> PersonalPathVerdict:\n214\t    \"\"\"Split ``scan`` against the allowlist. Kept pure so tests drive it.\n215\t\n216\t    There is ONE waiver -- a row pinned to the content's sha256 -- and a\n217\t    NAME hit short-circuits it: a path that names a home directory is\n218\t    unwaivable by a row and by anything a future version adds here,\n219\t    because the check sits above every branch that could forgive.\n220\t    Renaming the file is the only cure, which is what the report tells\n221\t    the reader.\n222\t\n223\t    A row that names the file but pins OTHER bytes does not waive and\n224\t    does not fall through to \"unwaived\" either: it is `mismatched`, its\n225\t    own category, because the operator action is to re-read the file and\n226\t    re-record the digest rather than to write a fresh decision. A hit\n227\t    with no digest at all (nothing readable to pin) can never match a\n228\t    row, which is the fail-closed default.\n229\t    \"\"\"\n230\t    unwaived: List[PersonalPathHit] = []\n231\t    waived: List[Tuple[str, str]] = []\n232\t    mismatched: List[str] = []\n233\t    for hit in scan.hits:\n234\t        if _PERSONAL_PATH_NAME_LINE in hit.lines:\n235\t            unwaived.append(hit)\n236\t            continue\n237\t        row = allowlist.get(hit.rel)\n238\t        if row is None:\n239\t            unwaived.append(hit)\n240\t            continue\n241\t        if hit.sha256 is None or row.sha256 != hit.sha256:\n242\t            mismatched.append(hit.rel)\n243\t            continue\n244\t        waived.append((hit.rel, row.reason))\n245\t    found = set(hit.rel for hit in scan.hits)\n246\t    stale = sorted(rel for rel in allowlist if rel not in found)\n247\t    return PersonalPathVerdict(\n248\t        unwaived=unwaived, waived=waived, stale=stale,\n249\t        malformed=list(malformed or []), mismatched=sorted(mismatched),\n250\t    )\n251\t\n252\t\n253\tdef _report_personal_path_eol_suspicion(\n254\t    scan: \"PersonalPathScan\", allowlist: Dict[str, \"PersonalPathRow\"],\n255\t    verdict: \"PersonalPathVerdict\",\n256\t) -> None:\n257\t    \"\"\"Name a mismatch that a checkout EOL filter explains.\n258\t\n259\t    A clone with `core.autocrlf=true` (or any other checkout EOL\n260\t    filter) hands the worktree CRLF where the committed blob holds LF.\n261\t    Every shipped digest was taken over the LF bytes, so on such a\n262\t    checkout every row mismatches at once and the gate is permanently\n263\t    red for a reason nothing in its output explains -- the operator\n264\t    looks for an edit that was never made (pair-rail round 3, P2).\n265\t\n266\t    It states WHAT was observed and not WHY: a deliberate CRLF edit\n267\t    produces the same evidence as a checkout filter, and the earlier\n268\t    wording asserted the filter (pair-rail round 4, P3).\n269\t\n270\t    NOTHING IS WAIVED HERE. Waiving on the normalised digest would\n271\t    forgive bytes the scan did not hash, which is the one thing this\n272\t    rule refuses to do; hashing canonical git content instead is the\n273\t    index-vs-worktree boundary this pack declares and does not cross.\n274\t    So the verdict is unchanged -- rc 1, the files still named -- and\n275\t    this adds one line saying which knob to turn.\n276\t    \"\"\"\n277\t    by_rel = dict((hit.rel, hit) for hit in scan.hits)\n278\t    suspect = [\n279\t        rel for rel in verdict.mismatched\n280\t        if by_rel.get(rel) is not None\n281\t        and by_rel[rel].sha256_lf is not None\n282\t        and allowlist.get(rel) is not None\n283\t        and allowlist[rel].sha256 == by_rel[rel].sha256_lf\n284\t    ]\n285\t    if not suspect:\n286\t        return\n287\t    print(\"    (%d of those differ from the recorded digest ONLY in \"\n288\t          \"line endings.\" % len(suspect))\n289\t    print(\"     That is what was observed, not why: a checkout EOL \"\n290\t          \"filter\")\n291\t    print(\"     (`core.autocrlf`) and a deliberate CRLF edit look the \"\n292\t          \"same here.\")\n293\t    print(\"     If it is the filter, `git config core.autocrlf input` \"\n294\t          \"or a\")\n295\t    print(\"     `* text=auto eol=lf` attribute restores the bytes the \"\n296\t          \"digests\")\n297\t    print(\"     were taken over. Nothing is waived on the folded \"\n298\t          \"digest.)\")\n299\t\n300\t\n301\tdef _print_personal_path_group(\n302\t    title: str, rows: List[str], cap: Optional[int] = None,\n303\t) -> None:\n304\t    \"\"\"Print at most `cap` rows, then say how many hid. LAYOUT ONLY.\n305\t\n306\t    `cap` defaults to `_PERSONAL_PATH_PRINT_CAP`, the FINDING cap: a\n307\t    red run names the first 20 and counts the rest, because the\n308\t    operator's next move is to open one of them.\n309\t\n310\t    It does NOT escape. That is the cure for a collision the r13 print\n311\t    made reachable (mechanism lane, round 23; reproduced): a path\n312\t    becomes text in `_personal_path_mask_rel`, which escapes it, and\n313\t    this printer used to escape it AGAIN. Escaping twice is injective on\n314\t    its own; escaping twice HERE and once in the honoured block is not,\n315\t    because the image of the double escape meets the image of the single\n316\t    one -- an unwaived `docs/x<LF>y.md` and a waived file literally named\n317\t    `docs/x\\x0ay.md` rendered as the same line in the same report.\n318\t\n319\t    So there is ONE boundary and every caller crosses it: a path is\n320\t    passed to this function already masked. `title` is composed by this\n321\t    module and is not a path, so it is printed as it is written.\n322\t    \"\"\"\n323\t    limit = _PERSONAL_PATH_PRINT_CAP if cap is None else cap\n324\t    if not rows:\n325\t        return\n326\t    print(\"  %s:\" % title)\n327\t    for row in rows[:limit]:\n328\t        print(\"    - %s\" % row)\n329\t    if len(rows) > limit:\n330\t        print(\"    ... and %d more\" % (len(rows) - limit))\n331\t\n332\t\n333\tdef _personal_path_display(path: Path, repo_root: Path) -> str:\n334\t    \"\"\"``path`` relative to the repo when inside it, else its absolute form.\n335\t\n336\t    The gate refuses to print a matched LINE; printing the absolute path of a\n337\t    file under the operator's home would put a home directory back into the\n338\t    output through the side door.\n339\t    \"\"\"\n340\t    try:\n341\t        # MASKED, not returned raw (pair-rail round 2, P2): an in-repo\n342\t        # override such as `docs/-Users-<name>-x/allow.txt` put the owner\n343\t        # segment into the untracked notice and into the remediation\n344\t        # text. Only the OUTSIDE-repo branch went through the boundary,\n345\t        # as if a path inside the repository could not name a person.\n346\t        return _personal_path_mask_rel(\n347\t            path.resolve().relative_to(repo_root).as_posix())\n348\t    except Exception:\n349\t        # OUTSIDE the repository — `--personal-path-allowlist ~/somewhere`.\n350\t        # `str(path)` here was the same leak by the same side door (rail round\n351\t        # cure-1, P2): the name is all a reader needs to know WHICH file the\n352\t        # gate could not use, and the directory is what must not be printed.\n353\t        return \"<outside the repository>/%s\" % _personal_path_safe(path.name)\n354\t\n355\t\n356\t#: C0, DEL and C1 — every byte a terminal or a CI log reads as a COMMAND\n357\t#: rather than as text. `\\n` is the one that matters most here: git allows a\n358\t#: newline in a tracked filename, which is why the scan enumerates with `-z`.\n359\tdef _personal_path_renders_as_itself(value: str) -> bool:\n360\t    \"\"\"True when no character of ``value`` needs escaping to be PRINTED.\n361\t\n362\t    `str.isprintable()`, asked of the whole string, and the claim is\n363\t    exactly the stdlib's: False for the control, format, surrogate,\n364\t    private-use, unassigned and non-space separator categories. It is\n365\t    NOT a promise that every character is visible -- U+2800 BRAILLE\n366\t    PATTERN BLANK and U+034F COMBINING GRAPHEME JOINER are printable and\n367\t    render as nothing. That is the right shape for what this predicate\n368\t    is FOR: escaping, so two different files cannot print as one line,\n369\t    and so nothing that rewrites a terminal reaches the log. Invisibility\n370\t    is refused where invisibility is the harm -- in the reason\n371\t    predicate, which counts ink rather than asking a category. This replaced the\n372\t    codepoint range `[\\x00-\\x1f\\x7f-\\x9f]`, which named C0, DEL and C1\n373\t    and stopped there -- so a tracked filename carrying U+202E\n374\t    RIGHT-TO-LEFT OVERRIDE went through the escaper UNCHANGED and printed\n375\t    raw into the honoured-row log, the one place a waiver is visible at\n376\t    all since the r13 decision (mechanism lane, round 22; reproduced).\n377\t\n378\t    The class was never \"C0 plus C1\". It is \"a character that does not\n379\t    render as itself\", and the standard library already answers that\n380\t    question for every category, including the ones a later Unicode\n381\t    revision adds: `Cc`, `Cf`, `Cs`, `Co`, `Cn`, `Zl`, `Zp` and the\n382\t    separators other than a plain space. One question, one authority,\n383\t    asked by both the escaper and the row emitter so they cannot drift --\n384\t    the same removal-not-enumeration move the reason predicate made one\n385\t    round earlier.\n386\t    \"\"\"\n387\t    return value.isprintable()\n388\t\n389\t#: The same class MINUS the three characters that are ordinary text in a\n390\t#: waiver list: `\\t`, `\\n`, and the `\\r` the row loop already counts as\n391\t#: part of its physical line. Everything else in C0/DEL/C1 is refused\n392\t#: there rather than escaped, because an escaped control is a DIFFERENT\n393\t#: string to the row grammar.\n394\t#:\n395\t#: The harm is DISPLAY, and the claim is deliberately no larger than\n396\t#: that: ESC, VT, FF and DEL rewrite how a row renders in the terminal\n397\t#: that shows it, so a row can say one thing to this parser and another\n398\t#: to its reader. An earlier note here ALSO said a NUL makes git render\n399\t#: the whole list as `Binary files ... differ`. That is not a rule git\n400\t#: has -- an explicit `diff` attribute forces a text diff despite a NUL\n401\t#: (round 21, B3; reproduced, numstat `-/-` becomes `2/0`) -- and this\n402\t#: rule no longer rests on how git renders anything: see\n403\t#: `_personal_path_honoured_rows`, which states what was granted instead\n404\t#: of hoping somebody reads a diff.\n405\t_PERSONAL_PATH_ALLOWLIST_CONTROL_RE = re.compile(\n406\t    \"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f-\\x9f]\")\n407\t\n408\t\n409\tdef _personal_path_escape_controls(value: str) -> str:\n410\t    r\"\"\"``value`` with every character that does not RENDER escaped.\n411\t\n412\t    `\\xNN` below U+0100, `\\uXXXX` below U+10000, `\\UXXXXXXXX` above it,\n413\t    so the escape is unambiguous at every width.\n414\t\n415\t    A tracked path may contain a NEWLINE, and this rule prints paths. Printed\n416\t    verbatim, `docs/ok<newline>::warning::forged.md` puts a line beginning\n417\t    `::warning::` into the log — a GitHub Actions WORKFLOW COMMAND, forged by\n418\t    a file in the pull request the gate is judging (mechanism lane, round 12;\n419\t    reproduced). ESC sequences reach the same output and can rewrite the\n420\t    waived inventory as it is rendered.\n421\t\n422\t    Escaping, not refusing: the operator still has to be able to SEE which\n423\t    path it is, and a refusal here would be a second, silent way for a file\n424\t    to escape the report.\n425\t\n426\t    INJECTIVE, and that took a second round to get right. Escaping only the\n427\t    controls made `docs/x<newline>y.md` and the literal four-character\n428\t    `docs/x\\x0ay.md` render IDENTICALLY (text lane, round 13; reproduced,\n429\t    COLLIDE: True) -- two different tracked files, one line in a report whose\n430\t    entire job is naming WHICH file leaked, and a hostile filename able to\n431\t    impersonate another one. The escape character is therefore escaped FIRST,\n432\t    which is the ordinary cure and the only one that keeps the mapping\n433\t    reversible: a backslash becomes two, then a control becomes `\\xNN`.\n434\t\n435\t    MEASURED on the shipped allowlist before this shipped: 0 of 242 waived\n436\t    paths, 0 of 242 reasons and 0 of 76 comment lines carry a control\n437\t    character or a backslash, so a green run prints exactly what it printed\n438\t    before.\n439\t    \"\"\"\n440\t    out: List[str] = []\n441\t    for char in value.replace(\"\\\\\", \"\\\\\\\\\"):\n442\t        if _personal_path_renders_as_itself(char):\n443\t            out.append(char)\n444\t        elif ord(char) < 0x100:\n445\t            out.append(\"\\\\x%02x\" % ord(char))\n446\t        elif ord(char) < 0x10000:\n447\t            out.append(\"\\\\u%04x\" % ord(char))\n448\t        else:\n449\t            out.append(\"\\\\U%08x\" % ord(char))\n450\t    return \"\".join(out)\n451\t\n452\t\n453\tdef _personal_path_hit_either(value: str) -> bool:\n454\t    \"\"\"True when the RAW string or its NFKC folding names a home directory.\n455\t\n456\t    Asking only the folded reading is a BYPASS, and it was live in three\n457\t    places: the allowlist ROW check, the comment check the round-10 cure\n458\t    added, and the redaction choke point below. NFKC turns a full-width\n459\t    owner segment into an ASCII one, and the ASCII one may be on the\n460\t    PLACEHOLDER list -- so `/Users/<full-width dev>/private`, a real and\n461\t    distinct directory, folded into `/Users/<user>/private` and answered\n462\t    False (text lane, round 12; measured raw=True nfkc=False).\n463\t\n464\t    Folding can only ever turn a person into a placeholder, never a\n465\t    placeholder into a person, so the raw reading is the one that must not\n466\t    be skipped. Both are asked; either is enough.\n467\t    \"\"\"\n468\t    if line_is_personal_path_hit(value):\n469\t        return True\n470\t    return line_is_personal_path_hit(unicodedata.normalize(\"NFKC\", value))\n471\t\n472\t\n473\tdef _personal_path_safe(value: str) -> str:\n474\t    \"\"\"``value``, unless it names a home directory — then a redaction.\n475\t\n476\t    The choke point for everything this rule PRINTS that it did not\n477\t    compose itself: a waiver reason written by a human, an allowlist path\n478\t    outside the repository, a CLI token it is about to name as ignored. Each\n479\t    of those was measured leaking in its own way; they are one shape, and the\n480\t    predicate that decides a FINDING is the same predicate that decides\n481\t    whether the gate may echo a string. A rule that redacts what it found and\n482\t    prints what it was handed is not a rule about leaks.\n483\t\n484\t    ONE deliberate exception, named here because this docstring used to\n485\t    claim there were none (text lane, round 19): the row offered by\n486\t    `--emit-personal-path-rows` is not prose, it is a line the PARSER has\n487\t    to read back, and the escaping this function does to stay injective --\n488\t    a backslash becomes two -- makes that line name a different path. That\n489\t    row is built from `hit.rel` under two explicit refusals instead (a path\n490\t    that names a home directory, and a path carrying a control character),\n491\t    which is the same containment reached without corrupting the key.\n492\t    \"\"\"\n493\t    if _personal_path_hit_either(value):\n494\t        return \"<redacted: names a home directory>\"\n495\t    # Everything that leaves this function goes into a log a human and a CI\n496\t    # runner both read. The redaction above answers \"may this be printed\";\n497\t    # this answers \"is what is printed still TEXT\" (mechanism lane, round 12).\n498\t    return _personal_path_escape_controls(value)\n499\t\n500\t\n501\t\n502\t\n503\tdef _personal_path_mask_rel(rel: str) -> str:\n504\t    \"\"\"``rel`` with every NON-PLACEHOLDER home-owner segment replaced.\n505\t\n506\t    A finding a reviewer cannot LOCATE is not a finding, and a PATH hit\n507\t    handed straight to `_personal_path_safe` comes back as the whole string\n508\t    redacted. So the owner segment -- the only part that is the leak -- is\n509\t    replaced and the rest of the path survives. `_personal_path_safe` still\n510\t    runs last and owns the verdict: if the masking missed a form, the whole\n511\t    string is redacted and the gate loses precision, never containment.\n512\t    \"\"\"\n513\t    masked = _PERSONAL_PATH_HOME_RE.sub(\n514\t        lambda m: _personal_path_mask_owner(m, \"/home/<redacted-owner>\"), rel)\n515\t    # No trailing `-` in the replacement: since the round-20 cure the\n516\t    # terminator is a LOOKAHEAD, so the separator is no longer consumed by\n517\t    # the match, and supplying it again rendered\n518\t    # `-Users-<redacted-owner>--project`. A mask has to follow the matcher\n519\t    # it masks (text lane of the battery, round 20).\n520\t    masked = _PERSONAL_PATH_SLUG_RE.sub(\n521\t        lambda m: _personal_path_mask_owner(m, \"-Users-<redacted-owner>\"),\n522\t        masked)\n523\t    return _personal_path_safe(masked)\n524\t\n525\t\n526\tdef _oserror_reason(exc: Exception) -> str:\n527\t    \"\"\"The REASON an OSError carries — never the path it names.\n528\t\n529\t    `str(OSError)` renders as `[Errno 13] Permission denied: <filename>`, and\n530\t    that filename is ABSOLUTE. Printing it on the fatal path puts a home\n531\t    directory back into the output through the same side door\n532\t    `_personal_path_display` closes three lines up: a gate that refuses to\n533\t    quote the leak it found must not leak while REFUSING to scan.\n534\t\n535\t    `strerror` is the reason with no path in it. When it is missing (an\n536\t    OSError raised without an errno, or a subclass carrying only args) the\n537\t    class name is the most that can be said without quoting a path — a vaguer\n538\t    message is a cheaper price than a second copy of the leak. BOTH rules of\n539\t    this module use it: the term rule terms-file fatal leaked the same way.\n540\t\n541\t    It also serves `UnicodeDecodeError` (no `strerror`, so: the class name),\n542\t    which is why the parameter is typed `Exception`. A decode failure on an\n543\t    INPUT file is fatal here, and its str() would quote the offending BYTES.\n544\t\n545\t    And `re.error`, which is the same shape one layer further in: a private\n546\t    term is compiled as a RAW REGEX, so a malformed one (`(?P</Users/<name>>)`)\n547\t    raises with the offending pattern inside the message — the home path\n548\t    the terms file exists to hide, printed by the machinery that hides it\n549\t    (pair-rail round 1, P1). Its class name is the bare word `error`, which\n550\t    says nothing, so this one case is named instead of classified.\n551\t    \"\"\"\n552\t    if isinstance(exc, re.error):\n553\t        return \"it contains an invalid regular expression\"\n554\t    strerror = getattr(exc, \"strerror\", None)\n555\t    if strerror:\n556\t        return str(strerror)\n557\t    return exc.__class__.__name__\n558\t\n559\t\n560\tdef _personal_path_honoured_rows(\n561\t    waived: List[Tuple[str, str]],\n562\t    allowlist: Dict[str, \"PersonalPathRow\"],\n563\t) -> Tuple[List[str], str]:\n564\t    \"\"\"The row set this run HONOURED, one line each, and a digest over it.\n565\t\n566\t    `<path> | sha256:<64 hex> | <reason>` -- the three fields of the row\n567\t    that granted, in the row's own grammar, sorted by path, UNCAPPED.\n568\t\n569\t    This replaced a counted, capped, reason-grouped inventory, and the\n570\t    reason is the four rounds that ended in the decision above it.\n571\t    Rounds 18 to 21 defended a PREMISE -- that a waiver is reviewable\n572\t    because a human can read the allowlist in `git diff` -- and each\n573\t    round found another way to make git render that file unreadable: a\n574\t    NUL in the bytes, a `-diff` attribute, a named binary driver, a\n575\t    driver named `unspecified`, `core.bigFileThreshold=1` with no\n576\t    attribute at all. Every cure for those decided by a NAME, which is\n577\t    the one thing this rule refuses to do anywhere else.\n578\t\n579\t    So the premise is gone, and with it the question. The gate asks git\n580\t    NOTHING about how the list renders. It states what it honoured on\n581\t    every run that reaches a VERDICT -- green, red, and on stderr under\n582\t    `--emit-personal-path-rows` -- and a reader who never opens a diff\n583\t    still sees the waiver that granted. A run that cannot READ its input\n584\t    returns 2 before any of this, and prints no set, because at that\n585\t    point there is no waiver set to state: an unreadable allowlist waives\n586\t    nothing, which is the fail-closed answer and not a silent one. Readability of the allowlist file in\n587\t    `git diff` is no longer a security property of this rule -- the\n588\t    sha256-pinned row is, and it is unchanged.\n589\t\n590\t    Only rows that actually waived a file appear. A row matching no file\n591\t    waives nothing and is reported as stale; a row whose digest no\n592\t    longer matches waives nothing and is reported as mismatched.\n593\t\n594\t    The DIGEST is over the canonical `<path>NUL<sha256>NUL<reason>` join\n595\t    of that set, in the same order, so two runs are comparable by one\n596\t    line. It is computed from the ROW values and not from the printed\n597\t    text: masking and escaping are display, and a digest that moved with\n598\t    the display would report a waiver change when only a rendering\n599\t    changed.\n600\t\n601\t    `allowlist[rel]` cannot miss: `personal_path_verdict` builds every\n602\t    pair in ``waived`` from a row it found in this same mapping. Paths\n603\t    and reasons go through the maskers on the way OUT, like every other\n604\t    printer here, because this report reaches a public CI log.\n605\t    \"\"\"\n606\t    canonical: List[str] = []\n607\t    rows: List[str] = []\n608\t    for rel, reason in sorted(waived):\n609\t        sha = allowlist[rel].sha256\n610\t        canonical.append(\"%s\\0%s\\0%s\" % (rel, sha, reason))\n611\t        rows.append(\n612\t            \"%s | sha256:%s | %s\"\n613\t            % (_personal_path_mask_rel(rel), sha,\n614\t               _personal_path_safe(reason)))\n615\t    digest = hashlib.sha256(\n616\t        \"\\n\".join(canonical).encode(\"utf-8\")).hexdigest()\n617\t    return rows, digest\n618\t\n619\t\n620\tdef _print_personal_path_honoured(\n621\t    rows: List[str], digest: str, stream,\n622\t) -> None:\n623\t    \"\"\"Print the honoured set. No cap: a cap is a place a waiver hides.\n624\t\n625\t    The old inventory was capped at 400 lines and said how many it hid,\n626\t    which is fine for a worklist and wrong for THIS: the hidden ones are\n627\t    exactly the ones nobody would see. The stream is a parameter because\n628\t    `--emit-personal-path-rows` owns stdout for rows meant to be pasted,\n629\t    so its copy goes to stderr.\n630\t    \"\"\"\n631\t    print(\"  honoured allowlist rows (%d, set sha256:%s):\"\n632\t          % (len(rows), digest), file=stream)\n633\t    for row in rows:\n634\t        print(\"    %s\" % row, file=stream)\n635\t\n636\t\n637\t\n638\t\n639\t\n640\t__all__ = [\n641\t    name for name, value in globals().items()\n642\t    if ((name.startswith(\"_\") and not name.startswith(\"__\"))\n643\t        or name.startswith(\"PersonalPath\") or name in (\n644\t            \"personal_path_verdict\", \"report_personal_paths\",\n645\t        ))\n646\t]\n647\t"}]},"parent_tool_use_id":null,"session_id":"50141584-ed08-437c-bb91-f56d610ea253","uuid":"b43454a8-a5b6-4ca7-bbc1-f65f0b6a3a49","timestamp":"2026-11-13T18:36:32.552Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_contamination/personal_path_policy.py","content":"\"\"\"Rule 2 waiver, verdict and presentation helpers.\"\"\"\nfrom __future__ import annotations\n\nfrom .personal_path_rows import _emit_personal_path_rows, _personal_path_mask_owner\n\nimport re\nfrom typing import Dict, List, Tuple\n\n_PERSONAL_PATH_ROW_RE = re.compile(\n    r\"^([^\\s|]+)\\s*\\|\\s*sha256:([0-9A-Fa-f]{64})\\s*\\|\\s*(\\S.*)$\")\n\n\n#: How many ASCII letters or digits a written reason must carry, counted\n#: after NFKC. Eight is a WORD, not a mark: no filler, no combining mark\n#: and no invisible codepoint reaches it, whatever category a future\n#: Unicode revision puts it in. MEASURED on the shipped allowlist before\n#: choosing the number: the seven reasons carry 60 to 112 each.\n_PERSONAL_PATH_REASON_MIN_INK = 8\n\n\ndef _personal_path_reason_is_visible(reason: str) -> bool:\n    r\"\"\"True when ``reason`` is a decision a reviewer can actually READ.\n\n    TWO POSITIVE conditions. Neither is a list of what is forbidden, and\n    that is the whole point. The deny-list form of this predicate was\n    defeated three rounds running, each time by a character one category\n    further out: `Cf` zero-width and bidi (round 19), `Mn` combining\n    marks (round 20), and then `Lo`/`So` fillers -- U+3164 HANGUL\n    FILLER, U+115F, U+2800 BRAILLE PATTERN BLANK -- which \"carry ink\" by\n    category and render as nothing (round 21). Enumerating categories\n    cannot close a class whose next member has not been named yet.\n    Asking what a written sentence HAS can.\n\n    * after NFKC, at least `_PERSONAL_PATH_REASON_MIN_INK` characters\n      from `[A-Za-z0-9]`. ASCII only, and COUNTED rather than merely\n      present: eight letters or digits is a word somebody typed. Every\n      filler of every category contributes ZERO, so the whole family\n      closes at once, including its unnamed members. NFKC runs first so\n      a full-width or mathematical spelling counts as the word it is --\n      the same folding the path predicate already asks for;\n    * every character PRINTABLE, `str.isprintable()`. That is the\n      stdlib's own answer rather than a category list of this module's:\n      False for C0/C1 controls, for the format characters, for the\n      separators other than a plain space, and for whatever a later\n      Unicode revision adds to those. It keeps the round-19 finding\n      closed -- `reviewed 2026<CR>HIDDEN` carries EIGHTEEN ASCII\n      letters and digits, more than twice the threshold, and is still\n      refused because it renders as a row overwritten in the terminal\n      that shows it. That is the case which proves the two conditions\n      are not redundant: ink alone would pass it. And it is done without\n      this module owning a list of what is invisible.\n\n    `\\r` is excluded from the FILE-level class two hundred lines up and\n    refused HERE, and that is not an inconsistency: there it is the\n    terminator of a physical line the row loop counts, and here it is a\n    character somebody put inside a written decision.\n\n    A row whose reason fails this is MALFORMED by row NUMBER, which is\n    the address the operator can act on, and it waives nothing.\n    \"\"\"\n    if not reason.isprintable():\n        return False\n    folded = unicodedata.normalize(\"NFKC\", reason)\n    ink = sum(\n        1 for char in folded\n        if (\"0\" <= char <= \"9\") or (\"A\" <= char <= \"Z\")\n        or (\"a\" <= char <= \"z\")\n    )\n    return ink >= _PERSONAL_PATH_REASON_MIN_INK\n\n\ndef _personal_path_allowlist_is_tracked(\n    repo_root: Path, allowlist_path: Path,\n) -> bool:\n    \"\"\"True only when git CONFIRMS the allowlist is in the index.\n\n    Every waiver in this rule -- and there is exactly one kind, the\n    content-pinned `<path> | sha256:<64 hex> | <reason>` row -- rests on\n    ONE claim: the allowlist is a TRACKED file, so a waiver is something\n    somebody COMMITTED and not something somebody left in a working tree.\n    Nothing checked that claim. The parser asked `is_file()` and read the\n    bytes; git was never consulted, in a rule that asks git every other\n    question it has.\n\n    This used to say \"a reviewable DIFF\", and the r13 decision removed\n    that premise: whether the file RENDERS in `git diff` is no longer a\n    property this rule rests on, because four rail rounds showed it can\n    be taken away by whoever controls the repository. What survives is\n    the smaller, checkable claim above -- an untracked file is not a\n    decision anybody recorded -- and the visibility of what was granted\n    now comes from `_personal_path_honoured_rows`, which prints it.\n\n    MEASURED on the framework's own tree (cross-vendor lane, S344, P2):\n    `git rm --cached` the allowlist and the file is still on disk, byte for\n    byte, unknown to git -- and the gate still waived 242 files. A claim a\n    security matcher does not check is not a\n    control, it is a comment.\n\n    Fail-CLOSED, by the rule `_personal_path_assert_enumerable` already\n    states: this is a GATE, not a hook, so an answer git cannot give is not\n    a yes. Git missing, git timing out, git exiting non-zero, a path\n    OUTSIDE the repository, a SYMLINK anywhere between the file and the\n    root, an ancestor walk that ran out of budget, and an index mode that\n    is not a regular blob all read as NOT tracked -- and an untracked\n    allowlist is read as EMPTY, exactly like an absent one, so every hit\n    is unwaived.\n\n    HONEST LIMIT, declared in the header: TRACKED is not COMMITTED. An\n    uncommitted edit to a tracked allowlist still grants, because that edit\n    IS a `git diff` -- the reviewable artifact the claim was always about --\n    and refusing it would make \"add the row, run the gate, commit it in the\n    same change\" impossible to do in that order.\n    \"\"\"\n    # A SYMLINK is not the file it points at. `resolve()` follows it, so an\n    # UNTRACKED link aimed at a tracked file answered TRACKED and its rows\n    # were then trusted — a waiver channel opened by a\n    # `ln -s` nobody reviewed (pair-rail round 2, P1). Every component\n    # between the repository and the file is asked, not just the last: a\n    # linked PARENT directory redirects the path just as completely.\n    #\n    # ROUND 3 hardened this same block twice more, so it is written here\n    # in its final form rather than patched again downstream: the budget\n    # is a REFUSAL when exhausted (P1), and the catch is a BOUNDARY\n    # because `resolve()` raises a bare RuntimeError for a symlink loop\n    # on Python 3.9 (P2, both lanes).\n    try:\n        probe = allowlist_path\n        root_real = repo_root.resolve()\n        reached_root = False\n        for _ in range(_PERSONAL_PATH_ANCESTOR_CAP):\n            if probe.is_symlink():\n                return False\n            if probe.resolve() == root_real or probe.parent == probe:\n                reached_root = True\n                break\n            probe = probe.parent\n        if not reached_root:\n            # The budget was EXHAUSTED, not satisfied. Falling through\n            # here left the remaining ancestors unexamined, so an\n            # allowlist deeper than the cap below an untracked link was\n            # resolved THROUGH that link and git confirmed the TARGET\n            # (pair-rail round 3, P1). A check that runs out of budget\n            # is an unfinished check, and an unfinished check in a\n            # security matcher is a no.\n            return False\n    except Exception:\n        # A BOUNDARY, not a type list -- the fourth time in this file.\n        # `Path.resolve()` raises a bare RuntimeError for a symlink LOOP\n        # on Python 3.9, so `except OSError` let an rc-1 traceback\n        # carrying the supplied absolute path escape from here\n        # (pair-rail round 3, P2, both lanes).\n        return False\n    try:\n        rel = allowlist_path.resolve().relative_to(\n            repo_root.resolve()).as_posix()\n    except Exception:\n        # Outside the repository, so git is not its reviewer and nothing in\n        # it can be a reviewable diff. `--personal-path-allowlist` still\n        # NAMES the file in the report; it simply waives nothing.\n        return False\n    # `--` ends OPTION parsing; it does not make the operand LITERAL. An\n    # allowlist path containing pathspec magic — `allow-*.txt`, or an\n    # explicit `:(glob)` — matched OTHER tracked files, so an untracked\n    # file answered TRACKED and its rows were then\n    # trusted (pair-rail round 1, P1, both lanes; reproduced with a\n    # nonexistent path literally named `*`). Two independent defences:\n    # `:(literal)` magic, and a check that what came back is EXACTLY the\n    # one path asked about — the second holds even where the first is\n    # unsupported.\n    try:\n        proc = subprocess.run(\n            [\"git\", \"ls-files\", \"-z\", \"--error-unmatch\",\n             \"--\", \":(literal)\" + rel],\n            cwd=str(repo_root), capture_output=True, check=False, timeout=30,\n        )\n    except (OSError, subprocess.SubprocessError):\n        return False\n    if proc.returncode != 0:\n        return False\n    listed = [name for name\n              in proc.stdout.decode(\"utf-8\", errors=\"replace\").split(\"\\0\")\n              if name]\n    if listed != [rel]:\n        return False\n    # The INDEX MODE, not the filesystem. Under `core.symlinks=false`\n    # git materialises a mode-120000 entry as a REGULAR FILE whose\n    # content is the target string: `is_symlink()` above answers False\n    # for a link, git confirms the NAME, and a link payload shaped like\n    # a valid waiver row was parsed and GRANTED -- a leaking file got a\n    # clean verdict (pair-rail round 3, P1, both lanes; reproduced on\n    # disk). This is the round-1 lesson -- link status comes from the\n    # index, never from the filesystem -- applied to the SECOND of the\n    # two surfaces that needed it. Only a regular blob can be an\n    # allowlist; 120000, the 160000 gitlink and any mode added later\n    # are refused, so the answer does not depend on this checkout's\n    # `core.symlinks` setting.\n    try:\n        mode = _personal_path_index_modes(repo_root).get(rel)\n    except Exception:\n        # A SECOND git call, with a second way to fail. It is outside\n        # the caller's scan boundary, so an escape here was an rc-1\n        # traceback instead of the documented empty-allowlist behaviour\n        # (pair-rail round 4, P2, both lanes). An answer git cannot\n        # give is not a yes -- the same rule as every branch above.\n        return False\n    return mode in (\"100644\", \"100755\")\n\n\ndef personal_path_verdict(\n    scan: PersonalPathScan,\n    allowlist: Dict[str, \"PersonalPathRow\"],\n    malformed: Optional[List[int]] = None,\n) -> PersonalPathVerdict:\n    \"\"\"Split ``scan`` against the allowlist. Kept pure so tests drive it.\n\n    There is ONE waiver -- a row pinned to the content's sha256 -- and a\n    NAME hit short-circuits it: a path that names a home directory is\n    unwaivable by a row and by anything a future version adds here,\n    because the check sits above every branch that could forgive.\n    Renaming the file is the only cure, which is what the report tells\n    the reader.\n\n    A row that names the file but pins OTHER bytes does not waive and\n    does not fall through to \"unwaived\" either: it is `mismatched`, its\n    own category, because the operator action is to re-read the file and\n    re-record the digest rather than to write a fresh decision. A hit\n    with no digest at all (nothing readable to pin) can never match a\n    row, which is the fail-closed default.\n    \"\"\"\n    unwaived: List[PersonalPathHit] = []\n    waived: List[Tuple[str, str]] = []\n    mismatched: List[str] = []\n    for hit in scan.hits:\n        if _PERSONAL_PATH_NAME_LINE in hit.lines:\n            unwaived.append(hit)\n            continue\n        row = allowlist.get(hit.rel)\n        if row is None:\n            unwaived.append(hit)\n            continue\n        if hit.sha256 is None or row.sha256 != hit.sha256:\n            mismatched.append(hit.rel)\n            continue\n        waived.append((hit.rel, row.reason))\n    found = set(hit.rel for hit in scan.hits)\n    stale = sorted(rel for rel in allowlist if rel not in found)\n    return PersonalPathVerdict(\n        unwaived=unwaived, waived=waived, stale=stale,\n        malformed=list(malformed or []), mismatched=sorted(mismatched),\n    )\n\n\ndef _report_personal_path_eol_suspicion(\n    scan: \"PersonalPathScan\", allowlist: Dict[str, \"PersonalPathRow\"],\n    verdict: \"PersonalPathVerdict\",\n) -> None:\n    \"\"\"Name a mismatch that a checkout EOL filter explains.\n\n    A clone with `core.autocrlf=true` (or any other checkout EOL\n    filter) hands the worktree CRLF where the committed blob holds LF.\n    Every shipped digest was taken over the LF bytes, so on such a\n    checkout every row mismatches at once and the gate is permanently\n    red for a reason nothing in its output explains -- the operator\n    looks for an edit that was never made (pair-rail round 3, P2).\n\n    It states WHAT was observed and not WHY: a deliberate CRLF edit\n    produces the same evidence as a checkout filter, and the earlier\n    wording asserted the filter (pair-rail round 4, P3).\n\n    NOTHING IS WAIVED HERE. Waiving on the normalised digest would\n    forgive bytes the scan did not hash, which is the one thing this\n    rule refuses to do; hashing canonical git content instead is the\n    index-vs-worktree boundary this pack declares and does not cross.\n    So the verdict is unchanged -- rc 1, the files still named -- and\n    this adds one line saying which knob to turn.\n    \"\"\"\n    by_rel = dict((hit.rel, hit) for hit in scan.hits)\n    suspect = [\n        rel for rel in verdict.mismatched\n        if by_rel.get(rel) is not None\n        and by_rel[rel].sha256_lf is not None\n        and allowlist.get(rel) is not None\n        and allowlist[rel].sha256 == by_rel[rel].sha256_lf\n    ]\n    if not suspect:\n        return\n    print(\"    (%d of those differ from the recorded digest ONLY in \"\n          \"line endings.\" % len(suspect))\n    print(\"     That is what was observed, not why: a checkout EOL \"\n          \"filter\")\n    print(\"     (`core.autocrlf`) and a deliberate CRLF edit look the \"\n          \"same here.\")\n    print(\"     If it is the filter, `git config core.autocrlf input` \"\n          \"or a\")\n    print(\"     `* text=auto eol=lf` attribute restores the bytes the \"\n          \"digests\")\n    print(\"     were taken over. Nothing is waived on the folded \"\n          \"digest.)\")\n\n\ndef _print_personal_path_group(\n    title: str, rows: List[str], cap: Optional[int] = None,\n) -> None:\n    \"\"\"Print at most `cap` rows, then say how many hid. LAYOUT ONLY.\n\n    `cap` defaults to `_PERSONAL_PATH_PRINT_CAP`, the FINDING cap: a\n    red run names the first 20 and counts the rest, because the\n    operator's next move is to open one of them.\n\n    It does NOT escape. That is the cure for a collision the r13 print\n    made reachable (mechanism lane, round 23; reproduced): a path\n    becomes text in `_personal_path_mask_rel`, which escapes it, and\n    this printer used to escape it AGAIN. Escaping twice is injective on\n    its own; escaping twice HERE and once in the honoured block is not,\n    because the image of the double escape meets the image of the single\n    one -- an unwaived `docs/x<LF>y.md` and a waived file literally named\n    `docs/x\\x0ay.md` rendered as the same line in the same report.\n\n    So there is ONE boundary and every caller crosses it: a path is\n    passed to this function already masked. `title` is composed by this\n    module and is not a path, so it is printed as it is written.\n    \"\"\"\n    limit = _PERSONAL_PATH_PRINT_CAP if cap is None else cap\n    if not rows:\n        return\n    print(\"  %s:\" % title)\n    for row in rows[:limit]:\n        print(\"    - %s\" % row)\n    if len(rows) > limit:\n        print(\"    ... and %d more\" % (len(rows) - limit))\n\n\ndef _personal_path_display(path: Path, repo_root: Path) -> str:\n    \"\"\"``path`` relative to the repo when inside it, else its absolute form.\n\n    The gate refuses to print a matched LINE; printing the absolute path of a\n    file under the operator's home would put a home directory back into the\n    output through the side door.\n    \"\"\"\n    try:\n        # MASKED, not returned raw (pair-rail round 2, P2): an in-repo\n        # override such as `docs/-Users-<name>-x/allow.txt` put the owner\n        # segment into the untracked notice and into the remediation\n        # text. Only the OUTSIDE-repo branch went through the boundary,\n        # as if a path inside the repository could not name a person.\n        return _personal_path_mask_rel(\n            path.resolve().relative_to(repo_root).as_posix())\n    except Exception:\n        # OUTSIDE the repository — `--personal-path-allowlist ~/somewhere`.\n        # `str(path)` here was the same leak by the same side door (rail round\n        # cure-1, P2): the name is all a reader needs to know WHICH file the\n        # gate could not use, and the directory is what must not be printed.\n        return \"<outside the repository>/%s\" % _personal_path_safe(path.name)\n\n\n#: C0, DEL and C1 — every byte a terminal or a CI log reads as a COMMAND\n#: rather than as text. `\\n` is the one that matters most here: git allows a\n#: newline in a tracked filename, which is why the scan enumerates with `-z`.\ndef _personal_path_renders_as_itself(value: str) -> bool:\n    \"\"\"True when no character of ``value`` needs escaping to be PRINTED.\n\n    `str.isprintable()`, asked of the whole string, and the claim is\n    exactly the stdlib's: False for the control, format, surrogate,\n    private-use, unassigned and non-space separator categories. It is\n    NOT a promise that every character is visible -- U+2800 BRAILLE\n    PATTERN BLANK and U+034F COMBINING GRAPHEME JOINER are printable and\n    render as nothing. That is the right shape for what this predicate\n    is FOR: escaping, so two different files cannot print as one line,\n    and so nothing that rewrites a terminal reaches the log. Invisibility\n    is refused where invisibility is the harm -- in the reason\n    predicate, which counts ink rather than asking a category. This replaced the\n    codepoint range `[\\x00-\\x1f\\x7f-\\x9f]`, which named C0, DEL and C1\n    and stopped there -- so a tracked filename carrying U+202E\n    RIGHT-TO-LEFT OVERRIDE went through the escaper UNCHANGED and printed\n    raw into the honoured-row log, the one place a waiver is visible at\n    all since the r13 decision (mechanism lane, round 22; reproduced).\n\n    The class was never \"C0 plus C1\". It is \"a character that does not\n    render as itself\", and the standard library already answers that\n    question for every category, including the ones a later Unicode\n    revision adds: `Cc`, `Cf`, `Cs`, `Co`, `Cn`, `Zl`, `Zp` and the\n    separators other than a plain space. One question, one authority,\n    asked by both the escaper and the row emitter so they cannot drift --\n    the same removal-not-enumeration move the reason predicate made one\n    round earlier.\n    \"\"\"\n    return value.isprintable()\n\n#: The same class MINUS the three characters that are ordinary text in a\n#: waiver list: `\\t`, `\\n`, and the `\\r` the row loop already counts as\n#: part of its physical line. Everything else in C0/DEL/C1 is refused\n#: there rather than escaped, because an escaped control is a DIFFERENT\n#: string to the row grammar.\n#:\n#: The harm is DISPLAY, and the claim is deliberately no larger than\n#: that: ESC, VT, FF and DEL rewrite how a row renders in the terminal\n#: that shows it, so a row can say one thing to this parser and another\n#: to its reader. An earlier note here ALSO said a NUL makes git render\n#: the whole list as `Binary files ... differ`. That is not a rule git\n#: has -- an explicit `diff` attribute forces a text diff despite a NUL\n#: (round 21, B3; reproduced, numstat `-/-` becomes `2/0`) -- and this\n#: rule no longer rests on how git renders anything: see\n#: `_personal_path_honoured_rows`, which states what was granted instead\n#: of hoping somebody reads a diff.\n_PERSONAL_PATH_ALLOWLIST_CONTROL_RE = re.compile(\n    \"[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f-\\x9f]\")\n\n\ndef _personal_path_escape_controls(value: str) -> str:\n    r\"\"\"``value`` with every character that does not RENDER escaped.\n\n    `\\xNN` below U+0100, `\\uXXXX` below U+10000, `\\UXXXXXXXX` above it,\n    so the escape is unambiguous at every width.\n\n    A tracked path may contain a NEWLINE, and this rule prints paths. Printed\n    verbatim, `docs/ok<newline>::warning::forged.md` puts a line beginning\n    `::warning::` into the log — a GitHub Actions WORKFLOW COMMAND, forged by\n    a file in the pull request the gate is judging (mechanism lane, round 12;\n    reproduced). ESC sequences reach the same output and can rewrite the\n    waived inventory as it is rendered.\n\n    Escaping, not refusing: the operator still has to be able to SEE which\n    path it is, and a refusal here would be a second, silent way for a file\n    to escape the report.\n\n    INJECTIVE, and that took a second round to get right. Escaping only the\n    controls made `docs/x<newline>y.md` and the literal four-character\n    `docs/x\\x0ay.md` render IDENTICALLY (text lane, round 13; reproduced,\n    COLLIDE: True) -- two different tracked files, one line in a report whose\n    entire job is naming WHICH file leaked, and a hostile filename able to\n    impersonate another one. The escape character is therefore escaped FIRST,\n    which is the ordinary cure and the only one that keeps the mapping\n    reversible: a backslash becomes two, then a control becomes `\\xNN`.\n\n    MEASURED on the shipped allowlist before this shipped: 0 of 242 waived\n    paths, 0 of 242 reasons and 0 of 76 comment lines carry a control\n    character or a backslash, so a green run prints exactly what it printed\n    before.\n    \"\"\"\n    out: List[str] = []\n    for char in value.replace(\"\\\\\", \"\\\\\\\\\"):\n        if _personal_path_renders_as_itself(char):\n            out.append(char)\n        elif ord(char) < 0x100:\n            out.append(\"\\\\x%02x\" % ord(char))\n        elif ord(char) < 0x10000:\n            out.append(\"\\\\u%04x\" % ord(char))\n        else:\n            out.append(\"\\\\U%08x\" % ord(char))\n    return \"\".join(out)\n\n\ndef _personal_path_hit_either(value: str) -> bool:\n    \"\"\"True when the RAW string or its NFKC folding names a home directory.\n\n    Asking only the folded reading is a BYPASS, and it was live in three\n    places: the allowlist ROW check, the comment check the round-10 cure\n    added, and the redaction choke point below. NFKC turns a full-width\n    owner segment into an ASCII one, and the ASCII one may be on the\n    PLACEHOLDER list -- so `/Users/<full-width dev>/private`, a real and\n    distinct directory, folded into `/Users/<user>/private` and answered\n    False (text lane, round 12; measured raw=True nfkc=False).\n\n    Folding can only ever turn a person into a placeholder, never a\n    placeholder into a person, so the raw reading is the one that must not\n    be skipped. Both are asked; either is enough.\n    \"\"\"\n    if line_is_personal_path_hit(value):\n        return True\n    return line_is_personal_path_hit(unicodedata.normalize(\"NFKC\", value))\n\n\ndef _personal_path_safe(value: str) -> str:\n    \"\"\"``value``, unless it names a home directory — then a redaction.\n\n    The choke point for everything this rule PRINTS that it did not\n    compose itself: a waiver reason written by a human, an allowlist path\n    outside the repository, a CLI token it is about to name as ignored. Each\n    of those was measured leaking in its own way; they are one shape, and the\n    predicate that decides a FINDING is the same predicate that decides\n    whether the gate may echo a string. A rule that redacts what it found and\n    prints what it was handed is not a rule about leaks.\n\n    ONE deliberate exception, named here because this docstring used to\n    claim there were none (text lane, round 19): the row offered by\n    `--emit-personal-path-rows` is not prose, it is a line the PARSER has\n    to read back, and the escaping this function does to stay injective --\n    a backslash becomes two -- makes that line name a different path. That\n    row is built from `hit.rel` under two explicit refusals instead (a path\n    that names a home directory, and a path carrying a control character),\n    which is the same containment reached without corrupting the key.\n    \"\"\"\n    if _personal_path_hit_either(value):\n        return \"<redacted: names a home directory>\"\n    # Everything that leaves this function goes into a log a human and a CI\n    # runner both read. The redaction above answers \"may this be printed\";\n    # this answers \"is what is printed still TEXT\" (mechanism lane, round 12).\n    return _personal_path_escape_controls(value)\n\n\n\n\ndef _personal_path_mask_rel(rel: str) -> str:\n    \"\"\"``rel`` with every NON-PLACEHOLDER home-owner segment replaced.\n\n    A finding a reviewer cannot LOCATE is not a finding, and a PATH hit\n    handed straight to `_personal_path_safe` comes back as the whole string\n    redacted. So the owner segment -- the only part that is the leak -- is\n    replaced and the rest of the path survives. `_personal_path_safe` still\n    runs last and owns the verdict: if the masking missed a form, the whole\n    string is redacted and the gate loses precision, never containment.\n    \"\"\"\n    masked = _PERSONAL_PATH_HOME_RE.sub(\n        lambda m: _personal_path_mask_owner(m, \"/home/<redacted-owner>\"), rel)\n    # No trailing `-` in the replacement: since the round-20 cure the\n    # terminator is a LOOKAHEAD, so the separator is no longer consumed by\n    # the match, and supplying it again rendered\n    # `-Users-<redacted-owner>--project`. A mask has to follow the matcher\n    # it masks (text lane of the battery, round 20).\n    masked = _PERSONAL_PATH_SLUG_RE.sub(\n        lambda m: _personal_path_mask_owner(m, \"-Users-<redacted-owner>\"),\n        masked)\n    return _personal_path_safe(masked)\n\n\ndef _oserror_reason(exc: Exception) -> str:\n    \"\"\"The REASON an OSError carries — never the path it names.\n\n    `str(OSError)` renders as `[Errno 13] Permission denied: <filename>`, and\n    that filename is ABSOLUTE. Printing it on the fatal path puts a home\n    directory back into the output through the same side door\n    `_personal_path_display` closes three lines up: a gate that refuses to\n    quote the leak it found must not leak while REFUSING to scan.\n\n    `strerror` is the reason with no path in it. When it is missing (an\n    OSError raised without an errno, or a subclass carrying only args) the\n    class name is the most that can be said without quoting a path — a vaguer\n    message is a cheaper price than a second copy of the leak. BOTH rules of\n    this module use it: the term rule terms-file fatal leaked the same way.\n\n    It also serves `UnicodeDecodeError` (no `strerror`, so: the class name),\n    which is why the parameter is typed `Exception`. A decode failure on an\n    INPUT file is fatal here, and its str() would quote the offending BYTES.\n\n    And `re.error`, which is the same shape one layer further in: a private\n    term is compiled as a RAW REGEX, so a malformed one (`(?P</Users/<name>>)`)\n    raises with the offending pattern inside the message — the home path\n    the terms file exists to hide, printed by the machinery that hides it\n    (pair-rail round 1, P1). Its class name is the bare word `error`, which\n    says nothing, so this one case is named instead of classified.\n    \"\"\"\n    if isinstance(exc, re.error):\n        return \"it contains an invalid regular expression\"\n    strerror = getattr(exc, \"strerror\", None)\n    if strerror:\n        return str(strerror)\n    return exc.__class__.__name__\n\n\ndef _personal_path_honoured_rows(\n    waived: List[Tuple[str, str]],\n    allowlist: Dict[str, \"PersonalPathRow\"],\n) -> Tuple[List[str], str]:\n    \"\"\"The row set this run HONOURED, one line each, and a digest over it.\n\n    `<path> | sha256:<64 hex> | <reason>` -- the three fields of the row\n    that granted, in the row's own grammar, sorted by path, UNCAPPED.\n\n    This replaced a counted, capped, reason-grouped inventory, and the\n    reason is the four rounds that ended in the decision above it.\n    Rounds 18 to 21 defended a PREMISE -- that a waiver is reviewable\n    because a human can read the allowlist in `git diff` -- and each\n    round found another way to make git render that file unreadable: a\n    NUL in the bytes, a `-diff` attribute, a named binary driver, a\n    driver named `unspecified`, `core.bigFileThreshold=1` with no\n    attribute at all. Every cure for those decided by a NAME, which is\n    the one thing this rule refuses to do anywhere else.\n\n    So the premise is gone, and with it the question. The gate asks git\n    NOTHING about how the list renders. It states what it honoured on\n    every run that reaches a VERDICT -- green, red, and on stderr under\n    `--emit-personal-path-rows` -- and a reader who never opens a diff\n    still sees the waiver that granted. A run that cannot READ its input\n    returns 2 before any of this, and prints no set, because at that\n    point there is no waiver set to state: an unreadable allowlist waives\n    nothing, which is the fail-closed answer and not a silent one. Readability of the allowlist file in\n    `git diff` is no longer a security property of this rule -- the\n    sha256-pinned row is, and it is unchanged.\n\n    Only rows that actually waived a file appear. A row matching no file\n    waives nothing and is reported as stale; a row whose digest no\n    longer matches waives nothing and is reported as mismatched.\n\n    The DIGEST is over the canonical `<path>NUL<sha256>NUL<reason>` join\n    of that set, in the same order, so two runs are comparable by one\n    line. It is computed from the ROW values and not from the printed\n    text: masking and escaping are display, and a digest that moved with\n    the display would report a waiver change when only a rendering\n    changed.\n\n    `allowlist[rel]` cannot miss: `personal_path_verdict` builds every\n    pair in ``waived`` from a row it found in this same mapping. Paths\n    and reasons go through the maskers on the way OUT, like every other\n    printer here, because this report reaches a public CI log.\n    \"\"\"\n    canonical: List[str] = []\n    rows: List[str] = []\n    for rel, reason in sorted(waived):\n        sha = allowlist[rel].sha256\n        canonical.append(\"%s\\0%s\\0%s\" % (rel, sha, reason))\n        rows.append(\n            \"%s | sha256:%s | %s\"\n            % (_personal_path_mask_rel(rel), sha,\n               _personal_path_safe(reason)))\n    digest = hashlib.sha256(\n        \"\\n\".join(canonical).encode(\"utf-8\")).hexdigest()\n    return rows, digest\n\n\ndef _print_personal_path_honoured(\n    rows: List[str], digest: str, stream,\n) -> None:\n    \"\"\"Print the honoured set. No cap: a cap is a place a waiver hides.\n\n    The old inventory was capped at 400 lines and said how many it hid,\n    which is fine for a worklist and wrong for THIS: the hidden ones are\n    exactly the ones nobody would see. The stream is a parameter because\n    `--emit-personal-path-rows` owns stdout for rows meant to be pasted,\n    so its copy goes to stderr.\n    \"\"\"\n    print(\"  honoured allowlist rows (%d, set sha256:%s):\"\n          % (len(rows), digest), file=stream)\n    for row in rows:\n        print(\"    %s\" % row, file=stream)\n\n\n\n\n\n__all__ = [\n    name for name, value in globals().items()\n    if ((name.startswith(\"_\") and not name.startswith(\"__\"))\n        or name.startswith(\"PersonalPath\") or name in (\n            \"personal_path_verdict\", \"report_personal_paths\",\n        ))\n]\n","numLines":647,"startLine":1,"totalLines":647}},"tool_result_meta":[{"id":"toolu_01LRrMUDcPhSDxP5sWUq2Xqp","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
