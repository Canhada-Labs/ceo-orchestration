_SPAWN_COMPONENT_IMPORT_ERROR = None
try:
    # Surface guard: .claude/skills/** and SKILL.md (via _lib/agent_spawn/skill_reference.py)
    from _lib.agent_spawn import bind as _bind_spawn_components
