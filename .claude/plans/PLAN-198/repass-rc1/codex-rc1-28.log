   198	def _walk_error(error: OSError) -> None:
   199	    raise error
   200	
   201	
   202	def scan_tree(root: Path) -> List[Finding]:
   203	    result = []
   204	    for relative in TEST_ROOTS:
   205	        start = root / relative
   206	        if not start.exists():
   207	            continue
   208	        for directory, folders, names in os.walk(start, onerror=_walk_error):
   209	            folders[:] = sorted(name for name in folders if name != "__pycache__")
   210	            for name in sorted(names):
   211	                if not name.endswith(".py"):
   212	                    continue
   213	                path = Path(directory) / name
   214	                relative_path = path.relative_to(root).as_posix()
   215	                # Only the implementation that owns session creation and
   216	                # cleanup is exempt. Imported test helpers remain in scope.
   217	                if relative_path == GROUP_HELPER:
   218	                    continue
   219	                if path.is_symlink():
   220	                    raise ValueError(f"symlink test source: {path.relative_to(root)}")
   221	                result.extend(scan_source(path.read_text(encoding="utf-8"), relative_path))
   222	    return sorted(result)
   223	
   224	
   225	def baseline_rows(findings: Iterable[Finding]) -> dict:
   226	    """Group by source file; row keys survive line-only edits, not new calls."""
   227	    rows: Dict[str, dict] = {kind: {} for kind in KINDS}
   228	    for finding in findings:
   229	        rows[finding.kind].setdefault(finding.path, []).append(f"{finding.scope}::{finding.fingerprint}")
   230	    return rows
   231	
   232	
   233	def new_findings(findings: Iterable[Finding], baseline: dict) -> List[Finding]:
   234	    return [
   235	        finding for finding in findings
   236	        if f"{finding.scope}::{finding.fingerprint}" not in baseline.get(finding.kind, {}).get(finding.path, [])
   237	    ]
   238	
   239	
   240	def load_baseline(path: Path) -> dict:
   241	    baseline = json.loads(path.read_text(encoding="utf-8"))
   242	    if not isinstance(baseline, dict) or set(baseline) != set(KINDS):
   243	        raise ValueError("baseline must contain both census kinds")
   244	    for paths in baseline.values():
   245	        if not isinstance(paths, dict):
   246	            raise ValueError("baseline kind must map paths to site lists")
   247	        for sites in paths.values():
   248	            if not isinstance(sites, list) or any(not isinstance(site, str) for site in sites):
   249	                raise ValueError("baseline sites must be strings")
   250	    return baseline
