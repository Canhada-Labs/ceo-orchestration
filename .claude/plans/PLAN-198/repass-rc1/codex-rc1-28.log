   175	def census_file(rel_path: str, raw: str,
   176	                corpus: Optional["Corpus"] = None,
   177	                model: Optional[FileModel] = None) -> List[Site]:
   178	    fm = model if model is not None else build_file_model(rel_path, raw)
   179	    if fm.unparseable:
   180	        return [Site(rel_path, 1, CLASS_PARSE, VERDICT_INDETERMINATE, R_PARSE,
   181	                     fm.unparseable, "", "<file>", "<file>")]
   182	
   183	    sites: List[Site] = []
   184	
   185	    for t in fm.tests:
   186	        if t.op not in _TEST_OPS_FOLLOW:
   187	            continue
   188	        verdict, form, detail = verdict_class_a(fm, t, corpus)
   189	        span = fm.func_at(t.line_idx)
   190	        sites.append(Site(rel_path, t.lineno, CLASS_SYMLINK, verdict, form,
   191	                          detail, span.name if span else "",
   192	                          fm.lines[t.line_idx].snippet(), t.canon))
   193	
   194	    # A test expression the model could not walk is a BLOCKING site, not a
   195	    # silent skip.  This is the half of the inversion the 4th pass missed:
   196	    # inverting the VERDICT rule while leaving DISCOVERY fail-open still lets
   197	    # an unmodelled form be invisible (rail R5-01).
   198	    for (line_idx, lineno, why, snippet) in fm.unmodelled_tests:
   199	        span = fm.func_at(line_idx)
   200	        sites.append(Site(rel_path, lineno, CLASS_SYMLINK,
   201	                          VERDICT_INDETERMINATE, R_TEST_UNMODELED, why,
   202	                          span.name if span else "", snippet, "<test>"))
   203	
   204	    for cmd in list(fm.commands) + list(fm.subst_commands):
   205	        body = [t for t in cmd.toks if t.kind == "word"]
   206	        while body and not body[0].quoted and body[0].text in _KEYWORDS:
   207	            body = body[1:]
   208	        stripped, ok = _strip_prefixes(body)
   209	        if not ok or not stripped:
   210	            continue
   211	        if stripped[0].quoted:
   212	            continue
   213	        # `/usr/bin/sed` runs sed.  Matching only the bare name meant a
   214	        # path-qualified invocation produced no class-B site (rail R5-02).
   215	        name = command_basename(canon_operand(stripped[0]))
   216	        if name not in _STREAM_EDITORS:
   217	            continue
   218	        probe = Command(stripped, cmd.line_idx, cmd.lineno, cmd.prev_op)
   219	        verdict, form, detail, ident = verdict_class_b(fm, probe, name)
   220	        span = fm.func_at(cmd.line_idx)
   221	        sites.append(Site(rel_path, cmd.lineno, CLASS_SED, verdict, form,
   222	                          detail, span.name if span else "",
   223	                          fm.lines[cmd.line_idx].snippet(),
   224	                          "%s:%s" % (name, ident)))
   225	
   226	    for (cmd, kind, watched) in fm.candidates:
   227	        verdict, form, detail = verdict_class_c(fm, cmd, kind, watched)
   228	        span = fm.func_at(cmd.line_idx)
   229	        head = _display_head(cmd)
   230	        operand = "%s:%s" % (head, ",".join(sorted(
   231	            set(canon_operand(t) for _r, t in watched if canon_operand(t))))[:60])
   232	        sites.append(Site(rel_path, cmd.lineno, CLASS_WRITE, verdict, form,
   233	                          detail, span.name if span else "",
   234	                          fm.lines[cmd.line_idx].snippet(), operand))
   235	
   236	    return sites
