   106	def verdict_class_c(fm: FileModel, cmd: Command, kind: str,
   107	                    watched: Sequence[Tuple[str, Tok]]) -> Tuple[str, str, str]:
   108	    """Is this candidate write proven safe?
   109	
   110	    Same theorem as class A — a non-dereferencing guard must dominate — but
   111	    reached from the WRITE rather than from a test.  That is what makes
   112	    discovery fail-closed: a write whose path no test ever pointed at produced
   113	    no class-A site, and before this class it therefore produced no site at
   114	    all.
   115	
   116	    The two roles are kept apart on purpose.  A PROVEN destination with no
   117	    guard is `desguardado` — the instrument knows it writes.  An operand of a
   118	    command the model cannot place is `indeterminado` — it may write, and "may"
   119	    is not "does".  Collapsing the two would report `diff -q "$a" "$b"` as a
   120	    write to `$a`.
   121	    """
   122	    head = "?"
   123	    if cmd.toks and cmd.toks[0].kind == "word":
   124	        head = command_basename(canon_operand(cmd.toks[0])) or "?"
   125	    if kind == "opaque":
   126	        # Opaque FLOORS the verdict at indeterminate; it does not CAP it.
   127	        # A destination the model did prove — a redirection on `bash ... >"$LOG"`
   128	        # — keeps the sharper `desguardado`, because collapsing every opaque
   129	        # command to "indeterminate" would discard a write the instrument
   130	        # actually knows about.  What opaque forbids is the other direction:
   131	        # a body this model never reads can never be proven safe.
   132	        for role, tok in watched:
   133	            canon = canon_operand(tok)
   134	            if not canon or role != "write":
   135	                continue
   136	            live, _rb = _guard_is_live(fm, cmd, canon)
   137	            if not live:
   138	                return (VERDICT_UNGUARDED, "",
   139	                        "%s writes %s with no dominating -L guard, and runs "
   140	                        "text this model never sees" % (head, canon))
   141	        return (VERDICT_INDETERMINATE, R_OPAQUE,
   142	                "%s runs text this model never sees" % head)
   143	
   144	    unproven_writes: List[str] = []
   145	    unproven_unknown: List[str] = []
   146	    stale: Optional[Tuple[str, int]] = None
   147	    for role, tok in watched:
   148	        canon = canon_operand(tok)
   149	        if not canon:
   150	            continue
   151	        live, rb = _guard_is_live(fm, cmd, canon)
   152	        if live:
   153	            continue
   154	        if rb is not None and stale is None:
   155	            stale = rb
   156	        (unproven_writes if role == "write" else unproven_unknown).append(canon)
   157	
   158	    if not unproven_writes and not unproven_unknown:
   159	        return (VERDICT_GUARDED, "a1-nofollow-test-dominates",
   160	                "every expanded operand is dominated by a proven -L guard")
   161	    if stale is not None:
   162	        first = (unproven_writes or unproven_unknown)[0]
   163	        return (VERDICT_INDETERMINATE, R_GUARD_STALE,
   164	                "a -L guard exists for %s but $%s is rebound at line %d before "
   165	                "this write" % (first, stale[0], fm.lines[stale[1]].lineno))
   166	    if unproven_writes:
   167	        return (VERDICT_UNGUARDED, "",
   168	                "%s writes %s with no dominating -L guard"
   169	                % (head, ", ".join(sorted(set(unproven_writes)))))
   170	    return (VERDICT_INDETERMINATE, R_CANDIDATE,
   171	            "%s is not proven read-only and may write %s"
   172	            % (head, ", ".join(sorted(set(unproven_unknown)))))
