"""AST inventory of direct subprocess test calls, with a content-based ratchet.

This is a static census, not proof of control-flow coverage: it recognises
imports/aliases, local command assignments and assertions in the same lexical
scope. Dynamic dispatch and timeout values hidden inside **kwargs require
manual inspection. Existing findings are debt, never an exemption for new sites.
"""
from __future__ import annotations

import ast
import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Dict, Iterable, List, NamedTuple, Optional


TEST_ROOTS = (
    ".claude/hooks/tests", ".claude/scripts/tests", ".claude/scripts/swarm/tests",
    "scripts/tests", "tests", "templates/oidc-proxy/tests",
)
KINDS = ("python-rc", "timeout-group")
SCOPE_TYPES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)
GROUP_HELPER = ".claude/scripts/tests/_subprocess_helpers.py"
# The fingerprint is persisted in the baseline, so it must not depend on the
# interpreter that computes it. Python 3.13 changed `ast.dump`'s DEFAULT output
# (new `show_empty=False` drops empty lists such as `keywords=[]`); passing
# `show_empty=True` restores the <=3.12 shape. Without it a baseline written on
# 3.9-3.12 reads as 95 "new" sites on 3.13/3.14 (S366, nightly py3.14 red).
# test_fu144_fingerprint_is_interpreter_stable pins golden digests on every
# matrix interpreter, so the next drift fails by name instead of as a ratchet.
_DUMP_OPTS = {"show_empty": True} if sys.version_info >= (3, 13) else {}


def call_digest(call: ast.Call) -> str:
    dump = ast.dump(call, include_attributes=False, **_DUMP_OPTS)
    return hashlib.sha256(dump.encode()).hexdigest()[:20]


class Finding(NamedTuple):
    kind: str
    path: str
    scope: str
    line: int
    fingerprint: str

    @property
    def key(self) -> str:
        return f"{self.path}::{self.scope}::{self.fingerprint}"


def _nodes(scope: ast.AST) -> Iterable[ast.AST]:
    """Walk this scope only; a sibling's assertions cannot discharge its debt."""
    yield scope
    for child in ast.iter_child_nodes(scope):
        if not isinstance(child, SCOPE_TYPES):
            yield from _nodes(child)


def _scopes(tree: ast.AST, prefix: str = "<module>") -> Iterable[tuple]:
    yield prefix, tree
    for node in _nodes(tree):
        for child in ast.iter_child_nodes(node):
            if isinstance(child, SCOPE_TYPES):
                yield from _scopes(child, f"{prefix}.{child.name}")


def _imports(nodes: Iterable[ast.AST], inherited: dict) -> dict:
    result = dict(inherited)
    for node in nodes:
        if isinstance(node, ast.Import):
            for alias in node.names:
                result[alias.asname or alias.name] = alias.name
        elif isinstance(node, ast.ImportFrom):
            for alias in node.names:
                result[alias.asname or alias.name] = f"{node.module}.{alias.name}"
    return result


def _name(node: ast.AST, aliases: dict) -> str:
    if isinstance(node, ast.Name):
        return aliases.get(node.id, node.id)
    if isinstance(node, ast.Attribute):
        return f"{_name(node.value, aliases)}.{node.attr}"
    return ""


def _assignments(nodes: list) -> list:
    result = []
    for node in nodes:
        if isinstance(node, ast.Assign):
            targets = node.targets
        elif isinstance(node, ast.AnnAssign):
            targets = [node.target]
        else:
            continue
        for target in targets:
            if isinstance(target, (ast.Name, ast.Attribute)):
                result.append((target, node.value, node.lineno))
    return result


def _python_command(node: Optional[ast.AST], aliases: dict, assignments: list, seen: tuple = ()) -> bool:
    if node is None:
        return False
    for part in ast.walk(node):
        if _name(part, aliases) == "sys.executable":
            return True
        if isinstance(part, ast.Name) and part.id not in seen:
            candidates = [
                (value, line) for target, value, line in assignments
                if isinstance(target, ast.Name) and target.id == part.id and line < part.lineno
            ]
            if candidates:
                value, _ = max(candidates, key=lambda item: item[1])
                if _python_command(value, aliases, assignments, seen + (part.id,)):
                    return True
    return False


def _result_name(call: ast.Call, parents: dict, aliases: dict) -> str:
    parent = parents.get(call)
    if isinstance(parent, ast.Assign) and len(parent.targets) == 1:
        return _name(parent.targets[0], aliases)
    if isinstance(parent, ast.AnnAssign):
        return _name(parent.target, aliases)
    if isinstance(parent, ast.withitem) and parent.optional_vars is not None:
        return _name(parent.optional_vars, aliases)
    return ""


def _assertions(nodes: list) -> Iterable[ast.AST]:
    for node in nodes:
        if isinstance(node, ast.Assert):
            yield node.test
        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
            if node.func.attr.startswith("assert"):
                for arg in node.args:
                    yield arg


def _checks_rc(call: ast.Call, nodes: list, parents: dict, aliases: dict, assignments: list) -> bool:
    result = _result_name(call, parents, aliases)
    reassigned = [
        line for target, _, line in assignments
        if result and _name(target, aliases) == result and line > call.lineno
    ]
    end = min(reassigned, default=float("inf"))
    for assertion in _assertions(nodes):
        for part in ast.walk(assertion):
            if not isinstance(part, ast.Attribute) or part.attr != "returncode":
                continue
            if part.value is call:
                return True
            if result and call.lineno <= part.lineno < end and _name(part.value, aliases) == result:
                return True
    return False


def _classify(call: ast.Call, nodes: list, parents: dict, aliases: dict, assignments: list) -> list:
    name = _name(call.func, aliases)
    subprocess_call = name in ("subprocess.run", "subprocess.Popen")
    kinds = []
    if subprocess_call:
        command = call.args[0] if call.args else next((k.value for k in call.keywords if k.arg == "args"), None)
        if _python_command(command, aliases, assignments) and not _checks_rc(call, nodes, parents, aliases, assignments):
            kinds.append("python-rc")
    communicate = isinstance(call.func, ast.Attribute) and call.func.attr == "communicate"
    timeout = any(k.arg == "timeout" for k in call.keywords) or (communicate and len(call.args) >= 2)
    if timeout and (subprocess_call or communicate):
        kinds.append("timeout-group")
    return kinds


def scan_source(source: str, path: str = "test_example.py") -> List[Finding]:
    tree = ast.parse(source, filename=path)
    parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}
    module_aliases = _imports(_nodes(tree), {})
    findings = []
    for scope, body in _scopes(tree):
        nodes = list(_nodes(body))
        aliases = _imports(nodes, module_aliases)
        assignments = _assignments(nodes)
        occurrences: Dict[str, int] = {}
        for call in (n for n in nodes if isinstance(n, ast.Call)):
            kinds = _classify(call, nodes, parents, aliases, assignments)
            if not kinds:
                continue
            digest = call_digest(call)
            occurrences[digest] = occurrences.get(digest, 0) + 1
            fingerprint = f"{digest}:{occurrences[digest]}"
            for kind in kinds:
                findings.append(Finding(kind, path, scope, call.lineno, fingerprint))
    return findings


def _walk_error(error: OSError) -> None:
    raise error


def scan_tree(root: Path) -> List[Finding]:
    result = []
    for relative in TEST_ROOTS:
        start = root / relative
        if not start.exists():
            continue
        for directory, folders, names in os.walk(start, onerror=_walk_error):
            folders[:] = sorted(name for name in folders if name != "__pycache__")
            for name in sorted(names):
                if not name.endswith(".py"):
                    continue
                path = Path(directory) / name
                relative_path = path.relative_to(root).as_posix()
                # Only the implementation that owns session creation and
                # cleanup is exempt. Imported test helpers remain in scope.
                if relative_path == GROUP_HELPER:
                    continue
                if path.is_symlink():
                    raise ValueError(f"symlink test source: {path.relative_to(root)}")
                result.extend(scan_source(path.read_text(encoding="utf-8"), relative_path))
    return sorted(result)


def baseline_rows(findings: Iterable[Finding]) -> dict:
    """Group by source file; row keys survive line-only edits, not new calls."""
    rows: Dict[str, dict] = {kind: {} for kind in KINDS}
    for finding in findings:
        rows[finding.kind].setdefault(finding.path, []).append(f"{finding.scope}::{finding.fingerprint}")
    return rows


def new_findings(findings: Iterable[Finding], baseline: dict) -> List[Finding]:
    return [
        finding for finding in findings
        if f"{finding.scope}::{finding.fingerprint}" not in baseline.get(finding.kind, {}).get(finding.path, [])
    ]


def load_baseline(path: Path) -> dict:
    baseline = json.loads(path.read_text(encoding="utf-8"))
    if not isinstance(baseline, dict) or set(baseline) != set(KINDS):
        raise ValueError("baseline must contain both census kinds")
    for paths in baseline.values():
        if not isinstance(paths, dict):
            raise ValueError("baseline kind must map paths to site lists")
        for sites in paths.values():
            if not isinstance(sites, list) or any(not isinstance(site, str) for site in sites):
                raise ValueError("baseline sites must be strings")
    return baseline
"""Stable semantic-version policy for locally resolved CLI packages."""

from __future__ import annotations

import json
import re
from pathlib import Path
from typing import Iterable, Optional, Tuple


CODEX_VERSION_FLOOR = "0.160.0"
_SEMVER_RE = re.compile(r"^v?([0-9]+)\.([0-9]+)\.([0-9]+)$")


def parse_semver(value: object) -> Optional[Tuple[int, int, int]]:
    """Parse a stable ``major.minor.patch`` version; reject prereleases."""
    if not isinstance(value, str):
        return None
    match = _SEMVER_RE.fullmatch(value.strip())
    if match is None:
        return None
    return tuple(int(part) for part in match.groups())


def compare_semver(candidate: object, floor: object) -> Optional[int]:
    """Compare stable versions: positive when candidate is newer, else None."""
    parsed_candidate = parse_semver(candidate)
    parsed_floor = parse_semver(floor)
    if parsed_candidate is None or parsed_floor is None:
        return None
    return (parsed_candidate > parsed_floor) - (parsed_candidate < parsed_floor)


def compatible_package_version(
    payload: Path, launcher: Optional[Path], manifest_version: object = None,
    floor: str = CODEX_VERSION_FLOOR,
) -> Optional[str]:
    """Return a qualified stable version meeting floor and optional manifest.

    This is currency evidence only: callers must not describe it as a hash
    attestation of the executable bytes.
    """
    for package_file in _package_files((payload, launcher)):
        version = _qualified_package_version(package_file)
        comparison = compare_semver(version, floor)
        manifest_comparison = (
            1 if manifest_version is None else compare_semver(version, manifest_version)
        )
        if comparison is not None and comparison >= 0 and manifest_comparison is not None and manifest_comparison > 0:
            return version
    return None


def qualified_package_version(payload: Path, launcher: Optional[Path]) -> Optional[str]:
    """Return stable version from a nearby qualified package, if present."""
    for package_file in _package_files((payload, launcher)):
        version = _qualified_package_version(package_file)
        if version is not None:
            return version
    return None


def _package_files(paths: Iterable[Optional[Path]]) -> Iterable[Path]:
    seen = set()
    for path in paths:
        if path is None:
            continue
        try:
            path = path.resolve()
        except OSError:
            pass
        for parent in (path.parent, *path.parents):
            package_file = parent / "package.json"
            if package_file not in seen:
                seen.add(package_file)
                yield package_file


def _qualified_package_version(package_file: Path) -> Optional[str]:
    try:
        data = json.loads(package_file.read_text(encoding="utf-8"))
    except (OSError, ValueError, RecursionError):
        return None
    if not isinstance(data, dict) or data.get("name") != "@openai/codex":
        return None
    version = data.get("version")
    return version if parse_semver(version) is not None else None
#!/usr/bin/env python3
"""check-substrate-watch.py — Claude Code + Agent-SDK substrate drift watch.

PLAN-135 W5 unit o8o11o12 (O12). The heroic manual changelog sweeps (S214,
S230, and THIS plan's 8-dimension research pass) became a permanent nightly
instrument: a small read-only checker that compares the substrate version this
framework was last RECONCILED against (`.claude/scripts/substrate-watch.json`
`last_seen`) with the version actually installed locally — and surfaces the
fetch-the-upstream-changelog step as a PENDING-OWNER recipe (agents stay
no-network under ADR-136-AMEND-1; the doc fetch costs no model tokens but is
the one network action, so it is Owner-run by design).

A newer upstream/installed version is NOT a defect: it is a prompt to re-run
verify-the-knob-routes before trusting an assumption baked against an older
surface (the S217/S228 silent-knob class). Detection only; never a BREAK.

Semantics:
  - `last_seen.version == "unknown"` OR `_meta.source_stale == true`
      -> status "stale-ledger" (advisory): the ledger has never been Owner
         -refreshed against the live changelog. ONE finding, disposition=defer.
  - a code-registered probe (selected by the component's `key`, see
    `_PROBE_ARGV`) resolves an installed version that differs from
    `last_seen.version` -> status "drift": ONE finding per component
    (disposition=fix-or-defer; claim names old vs installed).
  - everything matches and the ledger is fresh -> status "current".

Probing is OPT-IN (`--probe-installed`): by default the checker does NOT run
any version command (zero side effects, suitable for the read-only nightly
agent which then reports the ledger state + recipe). With `--probe-installed`
it runs each component's CODE-DEFINED read-only version probe — the argv is
hardcoded in `_PROBE_ARGV`, keyed on the component `key`; the ledger can NEVER
supply a command (Codex R2 P0) — with a short timeout and fail-soft.

Exit codes:
  0 — report mode (always), or --check with a fresh ledger + no drift,
      or infra fail-open (missing/corrupt ledger: advisory + exit 0)
  1 — --check only: ledger stale OR drift detected (a maintenance signal,
      not infra failure)
  2 — CLI usage error (argparse)

PLAN-155 Wave 0 (debate A12) extended coverage to the Codex HOST-harness
substrate: the `codex_harness` ledger entry watches the codex-cli release
feed AND the developers.openai.com/codex/{hooks,config-reference,rules} doc
pages; both codex-keyed components now carry a code-defined version probe
(`codex --version`), and a detected codex drift attaches the code-registered
fixture re-record runbook (`_DRIFT_RUNBOOKS`): bump the pin via the ADR-111
ceremony FIRST, then re-record the Wave-1 adapter fixtures.

Stdlib-only. Python >= 3.9. Read-only (never writes; --refresh only PRINTS
the recipe, it does not fetch). Emits NO audit events.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess  # nosec B404 — read-only version probes, opt-in, fail-soft
import sys
from typing import Any, Dict, List, Optional, Tuple

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
HOOKS_DIR = os.path.abspath(os.path.join(SCRIPT_DIR, "..", "hooks"))
if HOOKS_DIR not in sys.path:
    sys.path.insert(0, HOOKS_DIR)

from _lib import cli_currency  # noqa: E402

DEFAULT_LEDGER_PATH = os.path.join(SCRIPT_DIR, "substrate-watch.json")

_VERSION_RE = re.compile(r"(\d+\.\d+\.\d+(?:[-.][0-9A-Za-z.\-]+)?)")
_PROBE_TIMEOUT_S = 8.0

# Closed registry of version probes (PLAN-135 Codex R1/R2 P0). The full argv for
# each component — INCLUDING any `-e`/`-c` interpreter payload — is hardcoded HERE,
# keyed on the component's `key`. The ledger (and `--ledger <file>`) can only
# SELECT a key; it can NEVER supply the command. This closes the RCE class
# completely: an allowlist of argv[0] is insufficient because `python3`/`node`/
# `npx` are themselves arbitrary-code-execution vectors (`python3 -c <evil>`).
# Unknown key -> no probe. The ledger's descriptive `local_probe` (if present)
# is intentionally NOT executed; it is human documentation only.
_PROBE_ARGV: Dict[str, List[str]] = {
    "claude_code": ["claude", "--version"],
    "agent_sdk_ts": [
        "node", "-e",
        "console.log(require('@anthropic-ai/claude-agent-sdk/package.json').version)",
    ],
    "agent_sdk_py": [
        "python3", "-c",
        "import importlib.metadata as m; print(m.version('claude-agent-sdk'))",
    ],
    # PLAN-155 Wave 0 (debate A12): the Codex substrate is watched by TWO
    # ledger entries backed by the SAME read-only binary probe — `codex_cli`
    # (pair-rail reviewer flag-surface, PLAN-142 lineage; previously had no
    # probe registered) and `codex_harness` (Codex-as-HOST hooks/config/rules
    # schema surface, PLAN-155).
    "codex_cli": ["codex", "--version"],
    "codex_harness": ["codex", "--version"],
    # PLAN-178 W1.2-5c (codex S306 r5 P2 cure): the native per-agent usage
    # source is a shape OF the Claude Code harness — its installed version IS
    # the harness version, so a harness bump marks this component drifted and
    # triggers the promised native-shape re-fingerprint.
    "cc_native_usage": ["claude", "--version"],
}

# Code-registered drift runbooks (PLAN-155 Wave 0, debate A12). Same posture
# as _PROBE_ARGV (Codex R2 P0): the ledger can only SELECT a component key —
# it can NEVER supply alert/procedure text of its own. When a component with
# a registered runbook drifts, the runbook is attached to that report row
# (`runbook`) and printed in text mode, so the alert names the exact
# re-record procedure instead of a bare version delta.
_CODEX_FIXTURE_RUNBOOK = (
    "codex-cli drift — fixture re-record runbook (PLAN-155 debate A12): do "
    "NOT re-record fixtures against the new binary directly. (1) bump the "
    "pin FIRST via the ADR-182 pin ceremony (codex-cli-pin.txt semver range "
    "+ codex-cli-pin-manifest.json per-triple PAYLOAD sha256 — the retired "
    "codex-cli-binary-sha256.txt launcher hash is a tombstone); (2) THEN "
    "re-record the PLAN-155 Wave-1 "
    "host-adapter fixtures under .claude/hooks/tests/fixtures/adapters/codex/ "
    "(each fixture carries _meta.codex_cli_version; the pin-range test stays "
    "RED until fixtures are re-recorded or explicitly waived); (3) run the "
    "per-bump re-verification checklist in ADR-161 (hook envelope schema, "
    "PreToolUse interception surface, /hooks trust-hash keying, SubagentStart "
    "continue:false, Stop decision:block, execpolicy prefix_rule syntax)."
)
_DRIFT_RUNBOOKS: Dict[str, str] = {
    "codex_cli": _CODEX_FIXTURE_RUNBOOK,
    "codex_harness": _CODEX_FIXTURE_RUNBOOK,
}


def load_ledger(path: str) -> Optional[Dict[str, Any]]:
    """Read the substrate-watch ledger. None on any failure (fail-open)."""
    try:
        with open(path, "r", encoding="utf-8") as fh:
            data = json.load(fh)
        if not isinstance(data, dict):
            return None
        return data
    except (OSError, ValueError):
        return None


def _extract_version(text: str) -> Optional[str]:
    """First semver-ish token in `text` (e.g. 'claude 1.2.3 (...)' -> '1.2.3')."""
    match = _VERSION_RE.search(text or "")
    return match.group(1) if match else None


def _run_version_cmd(argv: List[str]) -> subprocess.CompletedProcess:
    """Execute a registered version probe (shell=False). Test seam — unit tests
    patch THIS symbol to script probe output without touching a real binary."""
    return subprocess.run(  # nosec B603 — fixed argv from _PROBE_ARGV (code-defined, NOT ledger-controlled)
        argv,
        shell=False,
        capture_output=True,
        text=True,
        timeout=_PROBE_TIMEOUT_S,
    )


def _probe_installed(key: str) -> Tuple[Optional[str], str]:
    """Resolve the installed version for component ``key`` via its code-defined
    probe in ``_PROBE_ARGV``. Returns (version|None, note).

    The command is NEVER taken from ledger data (Codex R2 P0) — only the key
    selects which hardcoded argv runs. Fail-soft: an unregistered key, missing
    binary, non-zero exit, timeout, or unparseable output all degrade to
    (None, <reason>) — never raises.
    """
    argv = _PROBE_ARGV.get(key)
    if not argv:
        return None, "no probe registered for component %r" % key
    try:
        proc = _run_version_cmd(argv)
    except (subprocess.TimeoutExpired, OSError) as exc:
        return None, "probe unavailable (%s)" % type(exc).__name__
    if proc.returncode != 0:
        return None, "probe exit %d (not installed?)" % proc.returncode
    version = _extract_version((proc.stdout or "") + " " + (proc.stderr or ""))
    if version is None:
        return None, "probe ran but no version token parsed"
    return version, "ok"


