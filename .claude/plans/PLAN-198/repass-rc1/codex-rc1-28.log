-def _worse(a: Optional[Tuple[str, str, str]],
-           b: Optional[Tuple[str, str, str]]) -> Optional[Tuple[str, str, str]]:
-    if a is None:
-        return b
-    if b is None:
-        return a
-    return a if _ORDER[a[0]] >= _ORDER[b[0]] else b
