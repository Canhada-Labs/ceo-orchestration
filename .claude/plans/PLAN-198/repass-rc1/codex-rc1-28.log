   239	def discover_shell_files(scan_root: Path, repo_root: Path) -> List[Path]:
   240	    out: List[Path] = []
   241	    if not scan_root.exists():
   242	        return out
   243	    for p in sorted(scan_root.rglob("*.sh")):
   244	        try:
   245	            rel = p.relative_to(repo_root).as_posix()
   246	        except ValueError:
   247	            rel = p.as_posix()
   248	        if any(rel.startswith(x) for x in EXCLUDED_REL_PREFIXES):
   249	            continue
   250	        out.append(p)
   251	    return out
