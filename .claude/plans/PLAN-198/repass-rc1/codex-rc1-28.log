    10	class Site(object):
    11	    __slots__ = ("rel_path", "lineno", "cls", "verdict", "form", "detail",
    12	                 "fn", "snippet", "operand", "ordinal")
    13	
    14	    def __init__(self, rel_path: str, lineno: int, cls: str, verdict: str,
    15	                 form: str, detail: str, fn: str, snippet: str,
    16	                 operand: str) -> None:
    17	        self.rel_path = rel_path
    18	        self.lineno = lineno
    19	        self.cls = cls
    20	        self.verdict = verdict
    21	        self.form = form
    22	        self.detail = detail
    23	        self.fn = fn
    24	        self.snippet = snippet
    25	        self.operand = operand
    26	        # Which of the identically-shaped sites in this file this one is.
    27	        # Without it, three byte-identical `[[ -e "$dst" ]]` guards in three
    28	        # functions collapse to ONE baseline entry and two of them go
    29	        # unrecorded — a silent hole in the ratchet.
    30	        self.ordinal = 0
    31	
    32	    @property
    33	    def blocking(self) -> bool:
    34	        return self.verdict in BLOCKING_VERDICTS
    35	
    36	    def fingerprint(self) -> str:
    37	        payload = "|".join([self.rel_path, self.cls, self.fn, self.operand,
    38	                            re.sub(r"\s+", " ", self.snippet).strip(),
    39	                            "#%d" % self.ordinal])
    40	        return hashlib.sha256(payload.encode("utf-8")).hexdigest()[:16]
    41	
    42	    def key(self) -> Tuple[str, str, str]:
    43	        return (self.rel_path, self.cls, self.fingerprint())
    44	
    45	    def to_json(self) -> Dict[str, object]:
    46	        return {
    47	            "path": self.rel_path,
    48	            "line": self.lineno,
    49	            "class": self.cls,
    50	            "verdict": self.verdict,
    51	            "form": self.form,
    52	            "detail": self.detail,
    53	            "function": self.fn,
    54	            "operand": self.operand,
    55	            "snippet": self.snippet,
    56	            "fingerprint": self.fingerprint(),
    57	            "blocking": self.blocking,
    58	        }
