   523	def _stale_pack_reason(tool: Any, repo: Path, mold_rel: str) -> Optional[str]:
   524	    """Why an existing constants-block pack can no longer be applied, or None.
   525	
   526	    That grammar records the sha256 of the live pin and manifest when the
   527	    pack was generated (``BASE_PIN_SHA256``/``BASE_MAN_SHA256``) and its
   528	    ceremony dies when either file changed since. A heredoc-grammar pack
   529	    records neither, and a mold this generator does not parse is not judged
   530	    (fail-open: the caller keeps the "apply the existing pack" advice).
   531	    """
   532	    try:
   533	        text = (repo / mold_rel).read_bytes().decode("utf-8")
   534	        parts = tool.parse_mold(text)
   535	    except Exception:  # noqa: BLE001 — infra/unparsed mold: not judged
   536	        return None
   537	    if parts.get("grammar") != getattr(tool, "GRAMMAR_CONSTANTS", None):
   538	        return None
   539	    consts = parts.get("consts") or {}
   540	    changed = []
   541	    for key, rel in (("BASE_PIN_SHA256", tool.PIN_REL), ("BASE_MAN_SHA256", tool.MANIFEST_REL)):
   542	        entry = consts.get(key)
   543	        if entry is None:
   544	            return None
   545	        try:
   546	            live = hashlib.sha256((repo / rel).read_bytes()).hexdigest()
   547	        except OSError:
