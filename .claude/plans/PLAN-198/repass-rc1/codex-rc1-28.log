-# A validation is only a proof when the class is anchored at BOTH ends.  With
-# `^` optional, `[[ "$v" =~ [A-Za-z]+$ ]]` accepted `|safe` — which still
-# carries the sed delimiter — as validated (rail R5-14).
-_RE_ANCHORED_CLASS = re.compile(r"^\^\[([^]]+)\][*+]?\$$")
