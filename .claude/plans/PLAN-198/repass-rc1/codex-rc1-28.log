    66	def _display_head(cmd: Command) -> str:
    67	    """The program name a reader would say this command calls.
    68	
    69	    Keywords, redirections and leading `VAR=value` assignments are not the
    70	    command, and letting them stand in for it put `LC_ALL=C` and `if` in the
    71	    operand field — which is part of the site FINGERPRINT.
    72	    """
    73	    body = [t for t in _strip_redirections(cmd.toks) if t.kind == "word"]
    74	    while body and not body[0].quoted and body[0].text in _KEYWORDS:
    75	        body = body[1:]
    76	    stripped, ok = _strip_prefixes(body)
    77	    if ok and stripped:
    78	        body = stripped
    79	    if not body or body[0].quoted:
    80	        return "?"
    81	    return command_basename(canon_operand(body[0])) or "?"
