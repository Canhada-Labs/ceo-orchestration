   254	def run_census(repo_root: Path,
   255	               scan_root: Path) -> Tuple[List[Site], List[Dict[str, object]]]:
   256	    """Census every discovered shell file, and REPORT the discovery itself.
   257	
   258	    The inventory is returned alongside the sites because a file that produced
   259	    no site is otherwise indistinguishable from a file discovery never reached
   260	    (rail R5-16).  `doctor.sh` producing zero sites is a claim about
   261	    `doctor.sh`; `doctor.sh` missing from the scan is a claim about the
   262	    instrument, and the output has to tell them apart.
   263	    """
   264	    sites: List[Site] = []
   265	    files: List[Dict[str, object]] = []
   266	    pending: List[Tuple[str, str]] = []
   267	    for p in discover_shell_files(scan_root, repo_root):
   268	        try:
   269	            rel = p.relative_to(repo_root).as_posix()
   270	        except ValueError:
   271	            rel = p.as_posix()
   272	        if p.is_symlink() or not p.is_file():
   273	            # Skipping silently would be a hole the size of one `ln -s`.
   274	            sites.append(Site(rel, 1, CLASS_PARSE, VERDICT_INDETERMINATE,
   275	                              R_UNREADABLE,
   276	                              "shell file is a symlink or not a regular file",
   277	                              "", "<file>", "<file>"))
   278	            files.append({"path": rel, "status": "symlink-or-not-regular",
   279	                          "sites": 1, "blocking": 1})
   280	            continue
   281	        try:
   282	            raw = p.read_text(encoding="utf-8")
   283	        except (OSError, UnicodeDecodeError) as exc:
   284	            # INPUT failure, not infrastructure: block, never skip.
   285	            sites.append(Site(rel, 1, CLASS_PARSE, VERDICT_INDETERMINATE,
   286	                              R_UNREADABLE, str(exc), "", "<file>", "<file>"))
   287	            files.append({"path": rel, "status": "unreadable",
   288	                          "sites": 1, "blocking": 1})
   289	            continue
   290	        pending.append((rel, raw))
   291	
   292	    # Phase 1: parse EVERY file before judging any of them, so a predicate
   293	    # defined in a shared library is visible to the writers that consult it.
   294	    corpus = Corpus()
   295	    models: List[Tuple[str, str, FileModel]] = []
   296	    for rel, raw in pending:
   297	        fm = build_file_model(rel, raw)
   298	        models.append((rel, raw, fm))
   299	        if not fm.unparseable:
   300	            corpus.add(fm)
   301	
   302	    # Phase 2: judge.
   303	    for rel, raw, fm in models:
   304	        found = census_file(rel, raw, corpus, fm)
   305	        status = "unparseable" if any(s.cls == CLASS_PARSE for s in found) \
   306	            else "scanned"
   307	        files.append({"path": rel, "status": status, "sites": len(found),
   308	                      "blocking": sum(1 for s in found if s.blocking)})
   309	        sites.extend(found)
   310	    files.sort(key=lambda f: str(f["path"]))
   311	    sites.sort(key=lambda s: (s.rel_path, s.lineno, s.cls))
   312	    counter: Dict[Tuple[str, str, str, str, str], int] = {}
   313	    for s in sites:
   314	        k = (s.rel_path, s.cls, s.fn, s.operand,
   315	             re.sub(r"\s+", " ", s.snippet).strip())
   316	        s.ordinal = counter.get(k, 0)
   317	        counter[k] = s.ordinal + 1
   318	    return sites, files
   319	
   320	
   321	# --------------------------------------------------------------------------
   322	# Baseline
   323	# --------------------------------------------------------------------------
   324	
   325	BASELINE_HEADER = """\
   326	# installer-write-safety-baseline.txt — PLAN-185 W0
   327	# (5th pass: inverted VERDICT rule + fail-CLOSED DISCOVERY)
   328	#
   329	# Every BLOCKING site (desguardado + indeterminado) the census currently finds.
   330	# A blocking site absent from this file fails the gate (exit 1); an entry here
   331	# that matches nothing also fails (rot). Removing a line is how a cure is
   332	# recorded — never how a finding is silenced.
   333	#
   334	# WHAT A LINE HERE MEANS, stated honestly. It is a RATCHET entry: this site is
   335	# known to the census, and no NEW one may appear without a decision. It is NOT
   336	# a per-site human review — there are hundreds of them, and claiming each was
   337	# read one by one would be false. `indeterminado` means "the matcher cannot
   338	# prove safety", which after the 5th pass is the default for every command not
   339	# proven read-only. Turning real sites into `guardado` is PLAN-185 W1/W2's job,
   340	# and the count going DOWN is how that work will show up here.
   341	#
   342	# Format: path:line:class:verdict:form-or-reason:fingerprint
   343	# Matching is on (path, class, fingerprint). The line number is informational:
   344	# it is refreshed on every run and drift alone is reported, never fatal.
   345	#
   346	# Regenerate ONLY with an explicit --write-baseline.
   347	"""
   348	
   349	
   350	def render_baseline(sites: Sequence[Site]) -> str:
   351	    rows = [s for s in sites if s.blocking]
   352	    lines = [BASELINE_HEADER]
   353	    for s in sorted(rows, key=lambda x: (x.rel_path, x.lineno, x.cls)):
   354	        lines.append("%s:%d:%s:%s:%s:%s\n" % (
   355	            s.rel_path, s.lineno, s.cls, s.verdict, s.form or "-",
   356	            s.fingerprint()))
   357	    return "".join(lines)
   358	
   359	
   360	def load_baseline(path: Path) -> Tuple[Dict[Tuple[str, str, str], Dict[str, str]],
   361	                                       List[str]]:
   362	    """Parse the baseline.  Malformed rows are RETURNED, never dropped.
   363	
   364	    A row this loader cannot read is a row that waives nothing and reports
   365	    nothing; swallowing it would let a corrupted baseline look healthy.
   366	    """
   367	    out: Dict[Tuple[str, str, str], Dict[str, str]] = {}
   368	    malformed: List[str] = []
   369	    if not path.exists():
   370	        return out, malformed
   371	    for raw in path.read_text(encoding="utf-8").splitlines():
   372	        line = raw.strip()
   373	        if not line or line.startswith("#"):
   374	            continue
   375	        parts = line.rsplit(":", 5)
   376	        if len(parts) != 6:
   377	            malformed.append(line[:120])
   378	            continue
   379	        rel, lineno, cls, verdict, form, fp = parts
   380	        out[(rel, cls, fp)] = {"line": lineno, "verdict": verdict, "form": form}
   381	    return out, malformed
   382	
   383	
   384	# --------------------------------------------------------------------------
   385	# Rendering
   386	# --------------------------------------------------------------------------
   387	
   388	
   389	def render_rules(scan_root: str) -> str:
   390	    buf = []
   391	    buf.append("check-installer-write-safety.py — INVERTED rule + FAIL-CLOSED "
   392	               "DISCOVERY (PLAN-185 W0, 5th pass)")
   393	    buf.append("")
   394	    buf.append("Corpus: %s/**/*.sh  (excluding %s)"
   395	               % (scan_root, ", ".join(EXCLUDED_REL_PREFIXES)))
   396	    buf.append("")
   397	    buf.append("DISCOVERY (what becomes a site at all):")
   398	    buf.append("  A command is PROVEN read-only only if its name is below and")
   399	    buf.append("  it opens no file for output.  Every other command whose")
   400	    buf.append("  operands or redirections contain an expansion is a candidate")
   401	    buf.append("  write.  An unmodelled test expression, an unparseable file,")
   402	    buf.append("  and eval/source/exec are sites too — never omissions.")
   403	    buf.append("")
   404	    buf.append("  proven read-only: %s" % " ".join(sorted(PROVEN_READONLY)))
   405	    buf.append("")
   406	    buf.append("  write-capable, classified by OPTION not by name: %s"
   407	               % " ".join(sorted(set(_OUTPUT_MODE_OPT)
   408	                                 | set(_OUTPUT_MODE_LAST)
   409	                                 | set(_INPLACE_FLAGS)
   410	                                 | _WRITERS_LAST | _WRITERS_ALL)))
   411	    buf.append("")
   412	    buf.append("Safety is a THEOREM, proven only by one of these forms:")
   413	    buf.append("")
   414	    for fid, desc in ALLOWLIST:
   415	        buf.append("  %s" % fid)
   416	        for chunk in _wrap(desc, 68):
   417	            buf.append("      %s" % chunk)
   418	    buf.append("")
   419	    buf.append("Everything else is `indeterminado`, which BLOCKS. Reason codes:")
   420	    for code, why in (
   421	            (R_PARSE, "the file's quotes/heredocs/block stack do not balance"),
   422	            (R_UNREADABLE, "the file could not be read or decoded"),
   423	            (R_OCCURRENCE, "the tested path reaches a command we do not model"),
   424	            (R_GUARD_NOT_DOM, "a -L guard exists but does not dominate the write"),
   425	            (R_SCRIPT_DYNAMIC, "the sed/awk script is not a literal"),
   426	            (R_SCRIPT_UNPARSED, "the sed/awk script uses a construct we do not model"),
   427	            (R_CMD_SUBST, "an unproven command substitution sits inside it"),
   428	            (R_AWK_EXPANSION, "an awk PROGRAM interpolates a shell value"),
   429	            (R_ESCAPE_UNPROVEN, "the value is escaped on some paths only"),
   430	            (R_GUARD_STALE, "a -L guard exists but the value was rebound after it"),
   431	            (R_PRED_AMBIGUOUS, "a guard predicate is defined 0 or >1 times"),
   432	            (R_PRED_ARG_UNBOUND, "a guard predicate never saw the destination"),
   433	            (R_TEST_UNMODELED, "a test expression the model cannot walk"),
   434	            (R_CANDIDATE, "a command not proven read-only touches an expansion"),
   435	            (R_OPAQUE, "eval/source/exec runs text this model never sees")):
   436	        buf.append("  %-24s %s" % (code, why))
   437	    buf.append("")
   438	    buf.append("Reachability analysis is deliberately ABSENT: an argument about")
   439	    buf.append("control flow can only make a site more dangerous, never safe, and")
   440	    buf.append("the threat model covers the RESOLVED symlink as well as the")
   441	    buf.append("dangling one, so the branch taken never decided safety.")
   442	    buf.append("")
   443	    buf.append("Exit codes: 0 = baseline holds; 1 = drift (new blocking site, dead")
   444	    buf.append("baseline entry, or --strict with any indeterminate); 2 = ZERO sites")
   445	    buf.append("found, which FAILS by design (broken search, not a clean corpus).")
   446	    return "\n".join(buf)
   447	
   448	
   449	def _wrap(text: str, width: int) -> List[str]:
   450	    words = text.split()
   451	    out: List[str] = []
   452	    cur: List[str] = []
   453	    for w in words:
   454	        if cur and sum(len(x) + 1 for x in cur) + len(w) > width:
   455	            out.append(" ".join(cur))
   456	            cur = []
   457	        cur.append(w)
   458	    if cur:
   459	        out.append(" ".join(cur))
   460	    return out
   461	
   462	
   463	def render_files(files: Sequence[Dict[str, object]]) -> str:
   464	    """Every file discovery reached, whether or not it produced a site."""
   465	    buf = ["discovered shell files: %d" % len(files)]
   466	    for f in files:
   467	        buf.append("  %-22s %4d site(s) %4d blocking  %s"
   468	                   % (f["status"], f["sites"], f["blocking"], f["path"]))
   469	    return "\n".join(buf)
   470	
   471	
   472	def render_table(sites: Sequence[Site]) -> str:
   473	    buf = []
   474	    by_verdict: Dict[str, int] = {}
   475	    by_class: Dict[Tuple[str, str], int] = {}
   476	    for s in sites:
   477	        by_verdict[s.verdict] = by_verdict.get(s.verdict, 0) + 1
   478	        k = (s.cls, s.verdict)
   479	        by_class[k] = by_class.get(k, 0) + 1
   480	    buf.append("instrument: sha256=%s" % instrument_sha256())
   481	    buf.append("sites: %d" % len(sites))
   482	    for v in (VERDICT_UNGUARDED, VERDICT_INDETERMINATE, VERDICT_GUARDED, VERDICT_NA):
   483	        buf.append("  %-16s %d" % (v, by_verdict.get(v, 0)))
   484	    buf.append("  %-16s %d" % ("BLOCKING",
   485	                               sum(1 for s in sites if s.blocking)))
   486	    buf.append("")
   487	    buf.append("class x verdict:")
   488	    for k in sorted(by_class):
   489	        buf.append("  %-16s %-16s %d" % (k[0], k[1], by_class[k]))
   490	    return "\n".join(buf)
   491	
