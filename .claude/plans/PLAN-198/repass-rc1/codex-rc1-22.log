   289	# Fail-open com VOZ: se a extração falhar, cai num conjunto mínimo E o
   290	# summary declara que está em fallback. Um degradê silencioso reproduziria o
   291	# defeito que esta função existe para curar.
   292	_SENTINEL_PATTERNS_FALLBACK = (
   293	    "PLAN-*/architect/round-*/approved.md",
   294	    "PLAN-*/approved.md",
   295	    "PLAN-*/wave-*-approved.md",
   296	    "PLAN-*/approved-amendment-*.md",
   297	)
