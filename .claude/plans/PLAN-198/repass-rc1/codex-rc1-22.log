   964	def main(argv: Optional[List[str]] = None) -> int:
   965	    parser = argparse.ArgumentParser(
   966	        prog="check_harness_config.py",
   967	        description="Harness-config gate: runtime-resolution model, "
   968	        "inline-secret scan, deny baseline, no-op annotation, and "
   969	        "behavioral positive-control replay (PLAN-153 Wave E / ADR-173).",
   970	    )
   971	    parser.add_argument("--repo-root", type=Path, default=None)
   972	    parser.add_argument(
   973	        "--settings",
   974	        action="append",
   975	        type=Path,
   976	        default=None,
   977	        help="settings file(s) to scan (default: dogfood + template)",
   978	    )
   979	    parser.add_argument("--fixtures-dir", type=Path, default=None)
   980	    parser.add_argument("--noop-allowlist", type=Path, default=None)
   981	    parser.add_argument(
   982	        "--instruction-load-evidence", type=Path, default=None,
   983	        help="JSON snapshot of a complete observed instruction-path list; "
   984	             "without it root loading is unobservable",
   985	    )
   986	    parser.add_argument(
   987	        "--static", action="store_true", help="run only the static checks"
   988	    )
   989	    parser.add_argument(
   990	        "--replay", action="store_true", help="run only the behavioral replay"
   991	    )
   992	    parser.add_argument(
   993	        "--no-exec-bit",
   994	        action="store_true",
   995	        help="skip delegation to check-active-hooks-executable.py",
   996	    )
   997	    args = parser.parse_args(argv)
   998	
   999	    repo_root = (args.repo_root or _default_repo_root()).resolve()
  1000	    do_static = args.static or not args.replay
  1001	    do_replay = args.replay or not args.static
  1002	
  1003	    if args.settings:
  1004	        settings_paths = [p if p.is_absolute() else repo_root / p for p in args.settings]
  1005	    else:
  1006	        settings_paths = [repo_root / rel for rel in DEFAULT_SETTINGS_REL]
  1007	
  1008	    findings: List[Finding] = []
  1009	    try:
  1010	        if do_static:
  1011	            findings.extend(
  1012	                run_static(
  1013	                    repo_root,
  1014	                    settings_paths,
  1015	                    noop_allowlist_path=args.noop_allowlist,
  1016	                    include_exec_bit=not args.no_exec_bit,
  1017	                )
  1018	            )
  1019	    except ValueError as exc:
  1020	        print(f"::error::{exc}", file=sys.stderr)
  1021	        return 2
  1022	
  1023	    if do_replay:
  1024	        findings.extend(run_replay(repo_root, args.fixtures_dir))
  1025	
  1026	    # Runtime evidence is optional and independent of settings/glob findings.
  1027	    # Never promote a static exclusion pattern into a claim about what loaded.
  1028	    if do_static or args.instruction_load_evidence is not None:
  1029	        findings.append(check_root_instruction_load(repo_root, args.instruction_load_evidence))
  1030	
  1031	    _print_findings(findings)
  1032	    reds = [f for f in findings if f.severity == "RED"]
  1033	    if reds:
  1034	        print(f"\nFAIL: {len(reds)} RED finding(s) "
  1035	              f"({len(findings) - len(reds)} warning(s))")
  1036	        return 1
  1037	    print(
  1038	        f"OK: harness-config gate green "
  1039	        f"(static={'yes' if do_static else 'no'}, "
  1040	        f"replay={'yes' if do_replay else 'no'}, "
  1041	        f"{len(findings)} warning(s))"
  1042	    )
  1043	    return 0
  1044	
