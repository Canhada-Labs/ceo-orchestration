    31	def _fnmatch_segments(path: str, pattern: str) -> bool:
    32	    """Mirror canonical_edit.paths._fnmatch_segments without its hook-bound globals."""
    33	    parts, patterns = path.split("/"), pattern.split("/")
    34	    if not patterns:
    35	        return not parts
    36	    head, rest = patterns[0], patterns[1:]
    37	    if head == "**":
    38	        return any(_match_parts(parts[i:], rest) for i in range(len(parts) + 1))
    39	    return _match_parts(parts, patterns)
