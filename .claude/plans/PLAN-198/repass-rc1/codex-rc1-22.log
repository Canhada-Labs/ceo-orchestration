   906	def _default_repo_root() -> Path:
   907	    env = os.environ.get("CLAUDE_PROJECT_DIR")
   908	    if env:
   909	        return Path(env).resolve()
   910	    # landed location: .claude/hooks/check_harness_config.py → repo root 2 up
   911	    candidate = _THIS_DIR.parent.parent
   912	    if (candidate / ".claude").is_dir():
   913	        return candidate
   914	    return Path.cwd()
