   619	def run_static(
   620	    repo_root: Path,
   621	    settings_paths: List[Path],
   622	    *,
   623	    noop_allowlist_path: Optional[Path] = None,
   624	    include_exec_bit: bool = True,
   625	) -> List[Finding]:
   626	    findings: List[Finding] = []
   627	    allowlist = load_noop_allowlist(repo_root, noop_allowlist_path)
   628	
   629	    for settings_path in settings_paths:
   630	        if not settings_path.is_file():
   631	            findings.append(
   632	                _warn("settings", str(settings_path), "settings file not present — skipped")
   633	            )
   634	            continue
   635	        data = load_settings(settings_path)  # ValueError propagates → exit 2
   636	        src = settings_path.name
   637	
   638	        for event_name, idx, entry, hook in iter_hook_entries(data):
   639	            command = hook.get("command", "") or ""
   640	            location = f"{src}:hooks.{event_name}[{idx}]"
   641	            cmd_findings, is_noop = analyze_hook_command(
   642	                command, repo_root, location=location
   643	            )
   644	            if cmd_findings and _entry_has_resolution_waiver(entry):
   645	                findings.extend(
   646	                    _warn(f.check_id, f.location, f"[waived {RESOLUTION_WAIVER_MARKER}] {f.message}")
   647	                    for f in cmd_findings
   648	                )
   649	            else:
   650	                findings.extend(cmd_findings)
   651	            if is_noop and not is_noop_allowlisted(command, entry, allowlist):
   652	                findings.append(
   653	                    _red(
   654	                        "noop_hook",
   655	                        location,
   656	                        "hook command is a constant emitter (no-op rail) and "
   657	                        f"is not annotated: add {NOOP_MARKER} to the entry's "
   658	                        f"_comment or a line to {NOOP_ALLOWLIST_REL}",
   659	                    )
   660	                )
   880	                        "replay",
   881	                        loc,
   882	                        f"no parseable decision on stdout (rc={proc.returncode}; the "
   883	                        "whole stdout must be ONE JSON value) — rail NOT certified alive",
   884	                    )
   885	                )
   886	                continue
   887	            if not _is_block_shaped(decision):
   888	                findings.append(
   889	                    _red(
   890	                        "replay",
   891	                        loc,
   892	                        "planted violation was NOT blocked "
   893	                        f"(decision={json.dumps(decision)[:160]}) — DEAD or "
   894	                        "fail-open rail",
   895	                    )
   896	                )
   897	    finally:
   898	        shutil.rmtree(str(scratch), ignore_errors=True)
   899	    return findings
