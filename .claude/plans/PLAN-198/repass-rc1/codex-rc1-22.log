"""Bind canonical-edit components to the legacy hook's public namespace.

The hook exposes mutable globals, counters and injectable functions. A normal
re-export would give implementations a different globals dictionary, breaking
both callers that patch those seams and independent imports of the hook. Bind
the compiled functions once at import time instead of copying mutable state or
synchronizing it around calls. Source locations and signatures remain intact.
"""
from __future__ import annotations

from types import FunctionType

from . import paths, sentinels, signature_rail, session_roots, utility, decisions, entry


def bind(namespace: dict) -> None:
    """Install implementations with the owning hook's globals and identity."""
    for component in (paths, sentinels, signature_rail, session_roots, utility, decisions, entry):
        for name in component.__all__:
            original = getattr(component, name)
            bound = FunctionType(
                original.__code__, namespace, original.__name__,
                original.__defaults__, original.__closure__,
            )
            bound.__kwdefaults__ = original.__kwdefaults__
            bound.__annotations__ = original.__annotations__.copy()
            bound.__dict__.update(original.__dict__)
            bound.__doc__ = original.__doc__
            bound.__qualname__ = original.__qualname__
            bound.__module__ = namespace["__name__"]
            namespace[name] = bound
)


# Adapter/CLI/hook entry implementations (including _session_roots_guard) are bound below.


# Bind extracted implementations to this facade's globals. Existing callers can
# still patch dependencies here, and each import owns its caches and counters.
# PLAN162_FIX_3 PLAN162_FIX_4 PLAN162_FIX_5B PLAN162_FIX_7 PLAN162_FIX_9:
# guardfiles, scope containment, parse_error fail-closed, local file-URI
# normalization, and blocked_tool forensics live in canonical_edit/*.
_COMPONENT_IMPORT_ERROR = None
_COMPONENT_IMPORT_IS_INTEGRITY_FAILURE = False
try:
    from _lib.canonical_edit import bind as _bind_canonical_edit
    _bind_canonical_edit(globals())
    del _bind_canonical_edit
except Exception as _component_exc:  # partial install / infrastructure failure
    _COMPONENT_IMPORT_ERROR = type(_component_exc).__name__
    _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE = isinstance(_component_exc, ImportError)

    def _emit_block(reason: str) -> str:
        return json.dumps({"decision": "block", "reason": reason})

    def _emit_allow() -> str:
        return "{}"

    def main() -> int:
        print("check_canonical_edit: component import unavailable (" +
              str(_COMPONENT_IMPORT_ERROR) + ")", file=sys.stderr)
        if _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE:
            print(_emit_block("CANONICAL-EDIT-BLOCKED: canonical_edit integrity "
                              "failure: component import unavailable."))
            return 0
        print(_emit_allow())
        return 0


