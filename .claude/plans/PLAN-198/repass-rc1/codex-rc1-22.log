+    del _guard_name, _canonical_guard_definitions
+except Exception:
+    _CANONICAL_GUARDS = []
+    _SKILL_CONTENT_RE = re.compile(r"^$")
+    _SKILL_LOADED_RE = re.compile(r"^$")
+    _VALID_BLOCKED_TOOLS = frozenset()
 
