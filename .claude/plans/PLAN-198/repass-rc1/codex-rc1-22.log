   300	def _sentinel_patterns() -> Tuple[Tuple[str, ...], bool]:
   301	    """(padrões, derived) — `derived=False` sinaliza fallback."""
   302	    import ast
   303	
   304	    src_path = REPO_ROOT / ".claude" / "hooks" / "check_canonical_edit.py"
   305	    try:
   306	        tree = ast.parse(src_path.read_text(encoding="utf-8"))
   307	    except Exception:
   308	        return _SENTINEL_PATTERNS_FALLBACK, False
   309	    for node in ast.walk(tree):
   310	        if not isinstance(node, ast.Assign):
   311	            continue
   312	        names = [t.id for t in node.targets if isinstance(t, ast.Name)]
   313	        if "_PATTERNS" not in names:
   314	            continue
   315	        try:
   316	            value = ast.literal_eval(node.value)
   317	        except Exception:
   318	            continue
   319	        pats = tuple(
   320	            p for p in value
   321	            if isinstance(p, str) and p.startswith("PLAN-")
   322	        )
   323	        if pats:
   324	            return pats, True
   325	    return _SENTINEL_PATTERNS_FALLBACK, False
