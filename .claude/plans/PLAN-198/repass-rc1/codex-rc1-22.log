   922	def check_root_instruction_load(
   923	    repo_root: Path, evidence_path: Optional[Path] = None,
   924	) -> Finding:
   925	    """Report a real runtime lookup, with explicit evidence provenance.
   926	
   927	    ``evidence_path`` is an operator-supplied JSON snapshot shaped as
   928	    ``{"complete": true, "loaded_instruction_paths": [absolute paths...]}``.
   929	    A partial, malformed or unavailable snapshot cannot prove root absence.
   930	    The caller supplies the list; this gate does not claim to instrument
   931	    Claude Code's instruction loader or authenticate the snapshot's producer.
   932	    """
   933	    try:
   934	        from _lib import claude_md_excludes as excludes
   935	    except Exception:
   936	        return _warn("root_instruction_load", "runtime", "root_load_unobservable (classifier unavailable)")
   937	
   938	    paths = None
   939	    source = "no complete observed path list"
   940	    if evidence_path is not None:
   941	        try:
   942	            snapshot = json.loads(
   943	                evidence_path.read_text(encoding="utf-8"),
   944	                object_pairs_hook=_strict_pairs,
   945	                parse_constant=_refuse_constant,
   946	            )
   947	            if isinstance(snapshot, dict) and snapshot.get("complete") is True:
   948	                paths = snapshot.get("loaded_instruction_paths")
   949	                source = "operator-supplied snapshot; completeness unverified"
   950	            else:
   951	                source = "incomplete or malformed path list"
   952	        except (OSError, ValueError, RecursionError):
   953	            source = "unreadable or invalid path list"
   954	    try:
   955	        state = excludes.root_instruction_load_state(paths, repo_root)
   956	    except Exception:
   957	        state = excludes.LOAD_STATE_UNOBSERVABLE
   958	        source = "classifier unavailable"
   959	    if state in (excludes.LOAD_STATE_LOADED, excludes.LOAD_STATE_ABSENT):
   960	        state = f"snapshot reports {state}"
   961	    return _warn("root_instruction_load", "runtime", f"{state} ({source})")
   962	
