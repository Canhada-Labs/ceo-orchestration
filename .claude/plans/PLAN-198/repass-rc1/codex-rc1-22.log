   163	
   164	def ensure_state_dir(path: Optional[Path] = None,
   165	                     tighten: bool = True) -> Path:
   166	    """Create (if needed) and best-effort TIGHTEN the state dir to 0700.
   167	
   168	    rail r2 F: the native slug dir often pre-exists 0755 (the harness
   169	    creates it for memory/transcripts); ``mkdir(mode=0o700,
   170	    exist_ok=True)`` does NOT change an existing dir mode, so the W1
   171	    modes invariant needs an explicit, central self-heal (the
   172	    ``spool_writer._state_dir`` precedent). Never raises: creators stay
   173	    fail-open; on any error the caller proceeds with the path as-is.
   174	
   175	    rail r5 hardening:
   176	    - ``tighten=False`` (callers pass it when ANY env override selected
   177	      the directory): only mkdir, NEVER chmod — a deliberately-0750
   178	      compliance/vault dir chosen by the operator keeps its mode.
   179	    - symlink guard: a user-owned symlinked state dir is left untouched
   180	      (path-based chmod would FOLLOW the link and change the target);
   181	      mirrors the spool_writer O_NOFOLLOW discipline at the cheap end.
   182	    """
   183	    d = path if path is not None else runtime_state_dir()
   184	    try:
   185	        d.mkdir(parents=True, exist_ok=True, mode=0o700)
   186	        if not tighten:
   187	            return d
   188	        st = os.lstat(str(d))
   189	        if stat_mod.S_ISLNK(st.st_mode):
   190	            return d
   191	        if (st.st_mode & 0o777) != 0o700 and st.st_uid == os.getuid():
   192	            os.chmod(str(d), 0o700)
   193	    except OSError:
   194	        pass
   195	    return d
