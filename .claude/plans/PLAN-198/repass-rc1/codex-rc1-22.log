   328	def check_sentinels_pending_gpg() -> Tuple[str, str, Any]:
   329	    """Count GPG-pending sentinels post-cutoff.
   330	
   331	    Codex S82 P2 fix: previous impl scanned ALL historical sentinels with no
   332	    date cutoff → 30+ pending entries every boot from PLAN-030/031/039 round-1
   333	    pre-enforcement era. Now applies SENTINEL_CUTOFF_EPOCH (2026-04-22) to
   334	    skip legacy. Also Codex S82 P2 sorted glob for CR-N7 stable ordering.
   335	    """
   336	    pending: List[str] = []
   337	    plans_dir = REPO_ROOT / ".claude" / "plans"
   338	    patterns, derived = _sentinel_patterns()
   339	    for pat in patterns:
   340	        for approved in sorted(plans_dir.glob(pat)):
   341	            try:
   342	                mtime = approved.stat().st_mtime
   343	            except OSError:
   344	                continue
   345	            if mtime < SENTINEL_CUTOFF_EPOCH:
   346	                continue  # pre-enforcement legacy
   347	            # S321: o `.asc` acompanha o ARQUIVO, não um `approved.md` fixo
   348	            # no diretório. A forma antiga (`parent / "approved.md.asc"`)
   349	            # só funcionava para o padrão `.../approved.md` e teria dado
   350	            # falso-pendente para `wave-*-approved.md`.
   351	            if not approved.with_name(approved.name + ".asc").exists():
   352	                rel = str(approved.relative_to(REPO_ROOT))
   353	                if rel not in pending:
