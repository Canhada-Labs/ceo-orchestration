    65	def collect_modified_canonical_paths(
    66	    repo_root: Path, modified_paths: Iterable[str], *, canonical_patterns: Optional[Iterable[str]] = None
    67	) -> tuple[str, ...]:
    68	    """Collect guarded paths using the hook's segment-matching semantics.
    69	
    70	    Caller supplies modified paths from a trusted diff; this helper never
    71	    invents a diff or assumes a cached list. Unsafe paths fail the packet.
    72	    """
    73	    patterns = tuple(canonical_patterns) if canonical_patterns is not None else _canonical_patterns(Path(repo_root))
    74	    if not patterns or not all(isinstance(p, str) and p for p in patterns):
    75	        raise ValueError("empty_or_invalid_canonical_policy")
    76	    paths = (_safe_rel(p) for p in modified_paths)
    77	    return tuple(sorted({p for p in paths if any(_fnmatch_segments(p.lower(), pat.lower()) for pat in patterns)}))
