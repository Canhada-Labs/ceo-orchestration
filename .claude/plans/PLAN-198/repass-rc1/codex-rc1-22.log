     1	"""Bind canonical-edit components to the legacy hook's public namespace.
     2	
     3	The hook exposes mutable globals, counters and injectable functions. A normal
     4	re-export would give implementations a different globals dictionary, breaking
     5	both callers that patch those seams and independent imports of the hook. Bind
     6	the compiled functions once at import time instead of copying mutable state or
     7	synchronizing it around calls. Source locations and signatures remain intact.
     8	"""
     9	from __future__ import annotations
    10	
    11	from types import FunctionType
    12	
    13	from . import paths, sentinels, signature_rail, session_roots, utility, decisions, entry
    14	
    15	
    16	def bind(namespace: dict) -> None:
    17	    """Install implementations with the owning hook's globals and identity."""
    18	    for component in (paths, sentinels, signature_rail, session_roots, utility, decisions, entry):
    19	        for name in component.__all__:
    20	            original = getattr(component, name)
    21	            bound = FunctionType(
    22	                original.__code__, namespace, original.__name__,
    23	                original.__defaults__, original.__closure__,
    24	            )
    25	            bound.__kwdefaults__ = original.__kwdefaults__
    26	            bound.__annotations__ = original.__annotations__.copy()
    27	            bound.__dict__.update(original.__dict__)
    28	            bound.__doc__ = original.__doc__
    29	            bound.__qualname__ = original.__qualname__
    30	            bound.__module__ = namespace["__name__"]
    31	            namespace[name] = bound

