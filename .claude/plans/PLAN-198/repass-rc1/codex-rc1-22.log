   153	) -> dict:
   154	    """Verify detached bytes with GPG and an explicit isolated keyring.
   155	
   156	    Reject unknown signers even when GPG reports ``GOODSIG``. No trust on
   157	    first use, personal GNUPGHOME, network retrieval or signing commands.
   158	    """
