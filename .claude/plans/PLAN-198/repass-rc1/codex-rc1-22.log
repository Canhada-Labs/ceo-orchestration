   160	    ("check_agent_spawn.py", "agent_spawn_named_no_skill_content.json"),
   540	            _red("deny_baseline", f"{source}.permissions", "permissions is not an object")
   541	        )
   542	        return findings
   543	    deny = perms.get("deny", [])
