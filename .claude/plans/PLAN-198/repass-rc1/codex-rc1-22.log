   278	# S8: the clock is an injectable module-level seam (``_now``). Without
   279	# it the red-first test's only options were a multi-second real sleep
   280	# (a documented flake class in this repo) or no deterministic coverage
   281	# of the slow path at all. This is a requirement OF the fix.
   282	#
   283	# ORDER IS NOT NEGOTIABLE (C3): the deadline and the cache partition ship
   284	# in the SAME patch under the SAME marker. A deadline without the
   285	# partition fires on the 4.16 s measured above and denies the ceremony
   286	# itself.
   287	_HOOK_WALL_BUDGET_S = 4.0
   288	_now = time.monotonic
   289	_WALL_DEADLINE_AT = None  # type: Optional[float]
   290	_WALL_BUDGET_EXHAUSTED = False
   291	
   292	
   293	def _start_wall_budget() -> None:
   294	    """Arm the per-invocation wall-clock deadline (called once by main)."""
   295	    global _WALL_DEADLINE_AT, _WALL_BUDGET_EXHAUSTED
   296	    _WALL_BUDGET_EXHAUSTED = False
   297	    _WALL_DEADLINE_AT = _now() + _HOOK_WALL_BUDGET_S
   298	
   299	
   300	def _reset_wall_budget() -> None:
   301	    """Disarm the deadline.
   302	
   303	    Called from ``main()``'s ``finally`` so a module-scope deadline can
   304	    never leak into a LATER in-process caller (the test suite drives
   305	    ``decide()`` directly in the same process; a stale expired deadline
   306	    would fail those closed for no reason).
   307	    """
   308	    global _WALL_DEADLINE_AT, _WALL_BUDGET_EXHAUSTED
   309	    _WALL_DEADLINE_AT = None
   310	    _WALL_BUDGET_EXHAUSTED = False
   311	
   312	
   313	def _mark_wall_budget_exhausted() -> None:
   314	    """Latch the budget as spent (see ``_gpg_verify_timeout``).
   315	
   316	    Set when a signature verification is REFUSED for want of budget. The
   317	    clock has not necessarily elapsed yet, but the invocation can no
   318	    longer reach a verdict, so every subsequent poll must report expiry —
   319	    otherwise the loop runs to its end and the operator is handed the
   320	    generic "declare this path in Scope" block, which misdiagnoses a
   321	    budget fault as a missing sentinel and omits the recovery route.
   322	    """
   323	    global _WALL_BUDGET_EXHAUSTED
   324	    _WALL_BUDGET_EXHAUSTED = True
   325	
   326	
   327	def _wall_budget_expired() -> bool:
   328	    """True once the armed invocation budget has elapsed (or is spent).
   329	
   330	    Disarmed (``None``) => never expired, so direct ``decide()`` callers
   331	    outside a hook invocation are unaffected.
   332	    """
   333	    if _WALL_DEADLINE_AT is None:
   334	        return False
   335	    if _WALL_BUDGET_EXHAUSTED:
   336	        return True
   337	    return _now() > _WALL_DEADLINE_AT
   338	
   339	
   340	# ---------------------------------------------------------------------------
   341	# PLAN162_FIX_1 — the gpg subprocess is bounded by the REMAINING budget
   342	# ---------------------------------------------------------------------------
   343	# Codex pair-rail P1 (S292) against this patch, staged:
   344	#
   345	#   "Bound GPG verification by the remaining hook budget. When gpg or
   346	#   gpg-agent stalls, this call can block for 15 seconds although the
   347	#   hook is registered for 5 seconds and the new internal deadline is 4
   348	#   seconds. Because the deadline is checked only between sentinel
   349	#   iterations, the harness can kill the process before it emits the
   350	#   intended fail-closed decision, recreating the silent fail-open that
   351	#   ADR-164-AMEND-1 §3 explicitly says the patch prevents."
   352	#
   353	# The deadline above is POLLED: read at the top of the sentinel loops, it
   354	# can only bound work that happens BETWEEN iterations. One
   355	# ``verify_detached`` at the library default (``timeout=15.0``,
   356	# ``_lib/gpg_verify.py``) is 3x the entire registration — the poll never
   357	# gets its turn, the harness kills a hook that has emitted NOTHING, and
   358	# "no decision" is indistinguishable from allow. ADR-164-AMEND-1 §3 D2
   359	# already states the intended behaviour ("per-verify subprocess timeout
   360	# bounded by remaining budget"); this is the code that makes the text
   361	# true.
   362	#
   363	# Two constants, both about EMITTING rather than about gpg:
   364	#
   365	#   * ``_GPG_EMIT_MARGIN_S`` — wall time reserved AFTER gpg returns so the
   366	#     rest of the decision plus the JSON emit still fit inside the
   367	#     internal deadline. A verification bounded to land exactly ON the
   368	#     deadline would merely have moved the kill.
   369	#   * ``_GPG_MIN_SPAWN_S`` — the floor below which spawning is pointless:
   370	#     a fork we cannot afford to wait out cannot tell "bad signature"
   371	#     from "slow agent", so it must not start at all.
   372	#
   373	# Their sum must stay well under ``_HOOK_WALL_BUDGET_S``, or the FIRST
   374	# sentinel of a fresh invocation could never be verified — self-DoS with
   375	# the Owner's signature in hand, the C3 class. Pinned by
   376	# ``test_control_gpg_bound_constants_leave_room_for_a_first_verify``.
   377	_GPG_VERIFY_TIMEOUT_CAP_S = 15.0  # the historical _lib.gpg_verify default
   378	_GPG_EMIT_MARGIN_S = 0.5
   379	_GPG_MIN_SPAWN_S = 0.5
   380	
   381	
   382	def _gpg_verify_timeout() -> Optional[float]:
   383	    """Subprocess timeout for ONE detached-signature verification.
   384	
   385	    ``None`` means DO NOT SPAWN — what is left of the invocation budget
   386	    cannot cover both a meaningful verification and the emit that has to
   387	    follow it. Callers translate that into the fail-CLOSED wall-deadline
   388	    block, never into an allow and never into a silent zero-emit.
   389	
   390	    With the budget disarmed (direct ``decide()`` callers, importers such
   391	    as ``check_pair_rail``) the historical cap is returned unchanged:
   392	    this narrows the hook-invocation path only.
   393	    """
   394	    if _WALL_DEADLINE_AT is None:
   395	        return _GPG_VERIFY_TIMEOUT_CAP_S
   396	    usable = (_WALL_DEADLINE_AT - _now()) - _GPG_EMIT_MARGIN_S
   397	    if usable < _GPG_MIN_SPAWN_S:
   398	        return None
   399	    return min(_GPG_VERIFY_TIMEOUT_CAP_S, usable)
   400	
   401	
   402	_WALL_DEADLINE_BLOCK_REASON = (
   403	    "CANONICAL-EDIT-BLOCKED: canonical_edit_hook_fault — the hook's "
   404	    "per-invocation wall-clock budget ({0}s) elapsed before authorization "
   405	    "for this canonical path could be established. A security matcher that "
   406	    "cannot finish deciding does NOT allow (PLAN-045 F-01-07 posture; "
   407	    "PLAN-162 consensus C2). Recovery: re-issue the edit, or use the "
   408	    "documented CEO_SENTINEL_UNLOCK / CEO_KERNEL_OVERRIDE ceremony."
   409	).format(_HOOK_WALL_BUDGET_S)
