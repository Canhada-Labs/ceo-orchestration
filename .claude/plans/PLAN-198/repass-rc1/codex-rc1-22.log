   565	
   566	def run_exec_bit_gate(repo_root: Path) -> List[Finding]:
   567	    """Delegate to .claude/scripts/check-active-hooks-executable.py.
   568	
   569	    That script remains the single owner of the exists+exec-bit sweep
   570	    (Session 75 Codex Finding 9). We import it by file path (its name is
   571	    not import-safe) and call its main() with output captured.
   572	    """
   573	    script = repo_root / ".claude" / "scripts" / "check-active-hooks-executable.py"
   574	    if not script.is_file():
   575	        return [
   576	            _warn(
   577	                "exec_bit",
   578	                str(script),
   579	                "check-active-hooks-executable.py not found — exec-bit "
   580	                "sub-check skipped (degraded)",
   581	            )
   582	        ]
   583	    buf = io.StringIO()
   584	    try:
   585	        import importlib.util
   586	
   587	        spec = importlib.util.spec_from_file_location(
   588	            "ceo_check_active_hooks_executable", str(script)
   589	        )
   590	        if spec is None or spec.loader is None:
   591	            raise ImportError("spec_from_file_location returned None")
   592	        mod = importlib.util.module_from_spec(spec)
   593	        with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
   594	            spec.loader.exec_module(mod)
   595	            try:
   596	                rc = int(mod.main())
   597	            except SystemExit as exc:  # its parser exits 2 on parse failure
   598	                rc = int(exc.code or 0)
   599	    except Exception as exc:
   600	        return [
   601	            _red(
   602	                "exec_bit",
   603	                str(script),
   604	                f"exec-bit gate raised {type(exc).__name__}: {exc} — fail-CLOSED | {buf.getvalue().strip()}",
   605	            )
   606	        ]
   607	    if rc != 0:
   608	        detail = " | ".join(
   609	            line.strip() for line in buf.getvalue().splitlines() if line.strip()
   610	        )
   611	        return [_red("exec_bit", str(script), f"exec-bit gate rc={rc}: {detail}")]
   612	    return []
