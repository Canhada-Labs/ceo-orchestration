   167	            raise ValueError("signed_file_or_signature_missing")
   168	        permitted = {str(fp).replace(" ", "").upper() for fp in allowed_fingerprints}
   169	        if not permitted or not all(_FPR.fullmatch(fp) for fp in permitted):
   170	            raise ValueError("invalid_or_empty_fingerprint_allowlist")
