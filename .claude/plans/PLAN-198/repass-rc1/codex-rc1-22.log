  1046	if __name__ == "__main__":
  1047	    sys.exit(main())
     1	"""Conservative checks for ``claudeMdExcludes`` and root instruction state.
     2	
     3	Claude Code applies ``claudeMdExcludes`` globs to absolute paths.  This module
     4	models path segments, including ``**`` as zero or more segments, rather than
     5	inferring safety from a pattern's spelling: a checkout can itself live below a
     6	staged-plan directory.  It does not claim full picomatch support (notably
     7	braces, extglobs and negation); those forms are conservatively treated as a
     8	possible root exclusion.
     9	
    10	``root_instruction_load_state`` accepts a *complete, observed* collection of
    11	loaded instruction paths.  It cannot infer an absent root from a static glob
    12	or from one incremental hook event; callers without such a collection receive
    13	``LOAD_STATE_UNOBSERVABLE``.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import fnmatch
    19	from pathlib import Path
    20	from typing import Any, Iterable, Optional, Union
    21	
    22	
    23	LOAD_STATE_LOADED = "root_loaded"
    24	LOAD_STATE_ABSENT = "root_absent"
    25	LOAD_STATE_UNOBSERVABLE = "root_load_unobservable"
    26	
    27	_PathLike = Union[str, "Path"]
    28	
    29	
    30	def _root_claude_md(project_dir: _PathLike) -> Path:
    31	    return (Path(project_dir) / "CLAUDE.md").resolve()
    32	
    33	
    34	def _has_unmodelled_syntax(pattern: str) -> bool:
    35	    return any(token in pattern for token in ("{", "}", "(", ")", "!"))
    36	
    37	
    38	def _segments_match(path: tuple, pattern: tuple) -> bool:
    39	    """Match ``*`` within one segment and ``**`` across zero or more."""
    40	    if not pattern:
    41	        return not path
    42	    head, tail = pattern[0], pattern[1:]
    43	    if head == "**":
    44	        return _segments_match(path, tail) or bool(path) and _segments_match(
    45	            path[1:], pattern
    46	        )
    47	    return bool(path) and fnmatch.fnmatchcase(path[0], head) and _segments_match(
    48	        path[1:], tail
    49	    )
    50	
    51	
    52	def root_claude_md_excluded(patterns: Any, project_dir: _PathLike) -> bool:
    53	    """Whether an effective excludes array matches the real root CLAUDE.md.
    54	
    55	    Non-list values are malformed settings, not evidence of an exclusion.
    56	    A relative ``CLAUDE.md`` does not match, matching the documented absolute
    57	    evaluation surface.  Unsupported glob syntax is flagged rather than
    58	    treated as harmless.
    59	    """
    60	    if not isinstance(patterns, (list, tuple)):
    61	        return False
    62	    root_path = tuple(_root_claude_md(project_dir).as_posix().split("/"))
    63	    for pattern in patterns:
    64	        if isinstance(pattern, str) and pattern:
    65	            normalized = pattern.replace("\\", "/")
    66	            if _has_unmodelled_syntax(normalized) or _segments_match(
    67	                root_path, tuple(normalized.split("/"))
    68	            ):
    69	                return True
    70	    return False
    71	
    72	
    73	def root_instruction_load_state(
    74	    loaded_instruction_paths: Optional[Iterable[Any]], project_dir: _PathLike,
    75	) -> str:
    76	    """Classify root loading from a complete observed path collection.
    77	
    78	    ``None``, a stream/iterator, malformed collections, or non-absolute
    79	    entries are explicitly unobservable.  All entries are validated before a
    80	    loaded result is returned, preventing a partial event stream from becoming
    81	    false proof that the root was loaded or skipped.
    82	    """
    83	    if not isinstance(loaded_instruction_paths, (list, tuple, set, frozenset)):
    84	        return LOAD_STATE_UNOBSERVABLE
    85	    root_path = _root_claude_md(project_dir)
    86	    root_loaded = False
    87	    for entry in loaded_instruction_paths:
    88	        if not isinstance(entry, (str, Path)):
    89	            return LOAD_STATE_UNOBSERVABLE
    90	        candidate = Path(entry)
    91	        if not candidate.is_absolute():
    92	            return LOAD_STATE_UNOBSERVABLE
    93	        if candidate.resolve() == root_path:
    94	            root_loaded = True
    95	    return LOAD_STATE_LOADED if root_loaded else LOAD_STATE_ABSENT

