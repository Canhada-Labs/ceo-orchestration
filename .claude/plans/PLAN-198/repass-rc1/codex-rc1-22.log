    42	def _match_parts(parts: list, patterns: list) -> bool:
    43	    if not patterns:
    44	        return not parts
    45	    if patterns[0] == "**":
    46	        return any(_match_parts(parts[i:], patterns[1:]) for i in range(len(parts) + 1))
    47	    return bool(parts) and fnmatch.fnmatchcase(parts[0], patterns[0]) and _match_parts(parts[1:], patterns[1:])
