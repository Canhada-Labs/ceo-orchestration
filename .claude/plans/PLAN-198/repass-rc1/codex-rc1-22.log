    88	__all__ = [
    89	    "project_dir",
    90	    "project_slug",
    91	    "runtime_state_dir",
    92	    "legacy_state_dir",
    93	    "LEGACY_PROJECT_LITERAL",
    94	]
    95	
    96	# The literal the family grew for four months (PLAN-182 W0: 587 files).
    97	# Exists ONLY so migration/W2 custody tooling has one named handle on
    98	# the historical location. Runtime resolution NEVER falls back to it.
    99	LEGACY_PROJECT_LITERAL = "ceo-orchestration"
   100	
   101	
   102	def project_dir() -> Path:
   103	    """Return the project's absolute path (the slug input).
   104	
   105	    ``CLAUDE_PROJECT_DIR`` (set by the harness for hooks and most
   106	    tool invocations) wins; ``os.getcwd()`` is the fallback for CLIs
   107	    invoked from the repo root. Absolutized, NOT realpath'd (see
   108	    module docstring §Symlink honesty).
   109	    """
   110	    env = os.environ.get("CLAUDE_PROJECT_DIR")
   111	    if env:
   112	        return Path(os.path.abspath(env))
   113	    return Path(os.path.abspath(os.getcwd()))
   114	
   115	
   116	def project_slug(path: Optional[Union["os.PathLike[str]", str]] = None) -> str:
   117	    """Native path-based slug: absolute path with ``/`` → ``-``.
   118	
   119	    ``/Users/<user>/my-repo`` → ``-Users-<user>-my-repo``. Dots, underscores and
   120	    pre-existing dashes are preserved (the ADR-001 amendment normalizes
   121	    ONLY the separator; the current harness does the same). This kills
   122	    the cured defect class (two checkouts sharing a BASENAME never
   123	    collide) but is NOT fully injective: paths differing only in
   124	    dash-vs-slash positions (``/srv/a-b/c`` vs ``/srv/a/b-c``) share a
   125	    slug — the SAME residual the native harness derivation has for its
   126	    memory/transcript dirs (rail r2 C, declared; diverging from the
   127	    native derivation would break co-location, an ADR-001 S318 Owner
   128	    decision).
   129	    """
   130	    p = Path(os.path.abspath(os.fspath(path))) if path is not None else project_dir()
   131	    return str(p).replace(os.sep, "-")
   132	
   133	
   134	def _home() -> Path:
   135	    home = os.environ.get("HOME")
   136	    return Path(home) if home else Path.home()
   137	
   138	
   139	def runtime_state_dir(
   140	    project: Optional[Union["os.PathLike[str]", str]] = None,
   141	) -> Path:
   142	    """Return the per-project runtime state base dir (family root).
   143	
   144	    Precedence: ``CLAUDE_PROJECT_DIR_NATIVE`` (whole-dir override) →
   145	    ``$HOME/.claude/projects/<project_slug(project)>``. ``project`` (S326,
   146	    CLI ``--project``) replaces only the slug INPUT; ``None`` keeps the
   147	    ``CLAUDE_PROJECT_DIR`` / cwd derivation. Callers create it with
   148	    mode ``0o700`` (creation stays at the call sites that already own
   149	    mkdir + permission-validation semantics, e.g. ``spool_writer``).
   150	
   151	    Deliberately uncached — the work is two ``os.environ.get``, an
   152	    optional ``getcwd`` and one ``str.replace``. Callers that cache MUST key
   153	    on every input that can change the result
   154	    (``CLAUDE_PROJECT_DIR_NATIVE``, ``CLAUDE_PROJECT_DIR``, ``HOME``,
   155	    and cwd when ``CLAUDE_PROJECT_DIR`` is unset) — the PLAN-182 W1
   156	    spool cache cure.
   157	    """
   158	    native = os.environ.get("CLAUDE_PROJECT_DIR_NATIVE")
   159	    if native:
   160	        return Path(native)
   161	    return _home() / ".claude" / "projects" / project_slug(project)
