   172	        if binary is None:
   173	            raise ValueError("gpg_missing")
   174	        command = [binary, "--no-options", "--no-autostart", "--homedir", str(home), "--batch", "--no-tty", "--no-auto-key-retrieve", "--status-fd", "1", "--verify", str(sig), str(signed)]
