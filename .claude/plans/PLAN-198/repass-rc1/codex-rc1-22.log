    19	def _safe_rel(path: str) -> str:
    20	    """Reject all ambiguous paths instead of normalising them into scope."""
    21	    if not isinstance(path, str) or not path or "\\" in path or "\x00" in path:
    22	        raise ValueError("unsafe_path")
    23	    p = PurePosixPath(path)
    24	    if p.is_absolute() or any(part in (".", "..") for part in path.split("/")):
    25	        raise ValueError("unsafe_path")
    26	    if p.as_posix() != path or path.startswith("~"):
    27	        raise ValueError("unsafe_path")
    28	    return path
