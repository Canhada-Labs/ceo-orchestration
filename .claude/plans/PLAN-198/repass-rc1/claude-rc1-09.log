{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y1KzBbGTC82CbaPatnF3eF","type":"tool_result","content":"1\t\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\timport re\n4\t\n5\t_CANONICAL_GUARDS = [\n6\t    \".claude/team.md\",\n7\t    \".claude/frontend-team.md\",\n8\t    \".claude/pitfalls-catalog.yaml\",\n9\t    # SKILL.md under any tier\n10\t    \".claude/skills/core/*/SKILL.md\",\n11\t    \".claude/skills/frontend/*/SKILL.md\",\n12\t    # PLAN-074 Wave 0 ADJ-A5: replace fixed 4-segment glob with\n13\t    # recursive ** to cover sub-namespaces (e.g. game-development/<engine>).\n14\t    \".claude/skills/domains/**/SKILL.md\",\n15\t    # Domain-level governance files\n16\t    \".claude/skills/domains/*/team-personas.md\",\n17\t    \".claude/skills/domains/*/pitfalls.yaml\",\n18\t    # Sprint 9 (PLAN-009 A22 / A14) — defense-in-depth for confidence gate\n19\t    \".claude/**/conftest.py\",\n20\t    \".claude/hooks/check_confidence_gate.py\",\n21\t    \".claude/scripts/lessons.py\",\n22\t    \".claude/scripts/prune-lessons.py\",\n23\t    \".claude/scripts/lesson-restore.py\",\n24\t    \".claude/scripts/lesson_ranker.py\",\n25\t    # ---- PLAN-019 P1-SEC-A expansion: full governance surface ----\n26\t    # Hook source files (all PreToolUse / PostToolUse Python hooks).\n27\t    # An agent that can edit these can disable governance. Sentinel-gated\n28\t    # so Owner-signed ADRs can still land architectural changes.\n29\t    \".claude/hooks/*.py\",\n30\t    \".claude/hooks/_python-hook.sh\",\n31\t    # Hook shared library (_lib/*) — governance utilities.\n32\t    \".claude/hooks/_lib/*.py\",\n33\t    \".claude/hooks/_lib/adapters/*.py\",\n34\t    \".claude/hooks/_lib/**/*.py\",\n35\t    # Policy-as-code (ADR-045) — policies + fixtures.\n36\t    \".claude/policies/*.yaml\",\n37\t    \".claude/policies/*.yml\",\n38\t    \".claude/policies/fixtures/*.jsonl\",\n39\t    # PLAN-080 Phase 0b — JSON Schema for squad-bundle frontmatter validation\n40\t    # (M2-CDX-4 closure). Guarded so squad-bundle authoring contract cannot\n41\t    # be silently weakened. KERNEL-HARD-DENY since check_canonical_edit.py\n42\t    # itself is in _KERNEL_PATHS — extending its guard list requires both\n43\t    # CEO_KERNEL_OVERRIDE=PLAN-080-PHASE-0B-SCHEMA-GUARD-EXTENSION AND\n44\t    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the sentinel.\n45\t    \".claude/policies/schemas/*.json\",\n46\t    # PLAN-081 Phase 2 — Pair-Rail dispatcher canonical surface. The\n47\t    # routing-matrix.yaml carries the per-archetype coder/reviewer\n48\t    # decisions consumed by inject-agent-context.sh --pair-mode and\n49\t    # check_pair_rail.py (Phase 3 asymmetric VETO matrix arms). Mutation\n50\t    # of this YAML or the loader/predicate-eval would mis-route Pair-Rail\n51\t    # dispatches (T-4 archetype-spoofing in CROSS-LLM-THREAT-MODEL.md).\n52\t    # Sentinel-gated edits only — KERNEL-HARD-DENY since this guard list\n53\t    # itself is in _KERNEL_PATHS — extending requires\n54\t    # CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-2-DISPATCHER-GUARD-EXTENSION\n55\t    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n56\t    \".claude/dispatcher/*.py\",\n57\t    \".claude/dispatcher/*.yaml\",\n58\t    \".claude/dispatcher/*.yml\",\n59\t    \".claude/dispatcher/**/*.py\",\n60\t    # Settings file — matcher/hook registration."}]},"parent_tool_use_id":null,"session_id":"a75fce92-96ca-4d13-a29e-d655897f3e0a","uuid":"1301bfd8-3ef2-4a72-81cc-ecdeb7ae5e3c","timestamp":"2026-11-13T16:57:38.994Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/guards.py","content":"\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\nfrom __future__ import annotations\nimport re\n\n_CANONICAL_GUARDS = [\n    \".claude/team.md\",\n    \".claude/frontend-team.md\",\n    \".claude/pitfalls-catal