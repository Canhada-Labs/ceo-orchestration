{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019YP1Xjc3EgmE2GDXU1QqF9","type":"tool_result","content":"200\t  the hook keeps the cheap half (denying `ln` on the toggle) as the\n201\t  earlier signal. An ancestor directory being a symlink is NOT an alias\n202\t  (`/tmp` -> `/private/tmp`), so ancestors are resolved separately.\n203\t\n204\tExit codes:\n205\t    0 — success or idempotent no-op\n206\t    1 — read-back mismatch / post-write verification failure\n207\t    2 — usage error, CI refusal, alias/relocated invocation (NF-08b),\n208\t        root confinement (NM-04), tampered or malformed marker (NM-01 /\n209\t        NF-01..NF-03 / NF-06), or malformed input (all fail-closed).\n210\t        Recover an armed posture from any of these with\n211\t        `off --discard-snapshot`.\n212\t\n213\tStdlib-only; Python >= 3.9.\n214\t\"\"\"\n215\t\n216\tfrom __future__ import annotations\n217\t\n218\timport argparse\n219\timport copy\n220\timport hashlib\n221\timport json\n222\timport os\n223\timport socket\n224\timport stat\n225\timport sys\n226\timport tempfile\n227\tfrom datetime import datetime, timezone\n228\tfrom pathlib import Path\n229\tfrom typing import Any, Dict, List, Optional, Tuple\n230\t\n231\tREPO_ROOT = Path(__file__).resolve().parents[2]\n232\t\n233\t# NF-08b — the path this script was INVOKED as, before any symlink is\n234\t# followed. Captured at import so it cannot depend on a later `os.chdir`;\n235\t# `absolute()` deliberately does NOT resolve links (that is the whole point —\n236\t# `REPO_ROOT` above already has the resolved form).\n237\t_INVOKED_SELF = Path(__file__).absolute()\n238\t\n239\t# The one relative location this script may legitimately be executed from.\n240\t_CANONICAL_SELF_PARTS = (\".claude\", \"scripts\", \"night-mode.py\")\n241\t\n242\t# The ONLY mode `on` ever writes (PLAN-165 D1 — bypassPermissions was cut\n243\t# in review; do not add a mode flag).\n244\tNIGHT_MODE = \"acceptEdits\"\n245\t\n246\t# The harness's REAL `--permission-mode` enum — verified against\n247\t# `claude --help` on the pinned CLI (2026-08-03). NF-02 (round-3 review):\n248\t# the restorable set below is DERIVED from this enum instead of being\n249\t# hand-listed, because a hand-listed set drifted BOTH ways at once — it\n250\t# carried `default` (never a harness mode) and OMITTED `dontAsk` (a legal\n251\t# one). The omission was the dangerous half: an Owner whose overlay\n252\t# legitimately carried `dontAsk` had it snapshotted by `on`, and then every\n253\t# `off` refused forever with `acceptEdits` left armed — a fail-closed gate\n254\t# landing on the PERMISSIVE side. If the CLI gains a mode, update THIS\n255\t# constant; the derivation and the diagnostics follow automatically.\n256\t_HARNESS_PERMISSION_MODES = frozenset(\n257\t    {\"acceptEdits\", \"auto\", \"bypassPermissions\", \"manual\", \"dontAsk\", \"plan\"}\n258\t)\n259\t\n260\t# NM-01 / NF-01 / NF-02 — closed set of modes `off` may restore. Derived,\n261\t# with exactly two exclusions, both load-bearing:\n262\t#\n263\t# - `bypassPermissions` (D1): present in ANY settings layer it trips\n264\t#   `TAMPER_PERMISSION_BYPASS` (`_lib/effective_config.py`) and turns\n265\t#   `/ceo-boot` red by design. night-mode must never be the thing that\n266\t#   writes it back — not even under the name \"restoring\".\n267\t# - `NIGHT_MODE` (`acceptEdits`, NF-01): cmd_on's desync normalization\n268\t#   guarantees that a HEALTHY marker never carries night-mode's own value\n269\t#   as `prev_value`. Admitting it to the set could therefore only ever\n270\t#   admit a TAMPERED value — and honoring it produces the worst end-state\n271\t#   this script has: `off` re-writes `acceptEdits` into the overlay,\n272\t#   REMOVES the marker, and exits 0, leaving the posture armed with no\n273\t#   marker, so every later `off` is a forever no-op.\n274\t#\n275\t# The marker is gitignored, unguarded, agent-writable state; a `prev_value`\n276\t# outside this set is evidence of tampering (or of a mode enum this build\n277\t# does not know), so restore fails CLOSED — with `off --discard-snapshot`\n278\t# as the documented, non-restoring way out (NF-02).\n279\t_RESTORABLE_MODES = _HARNESS_PERMISSION_MODES - {\"bypassPermissions\", NIGHT_MODE}\n280\t\n281\t# NF-02 — the sanctioned exit from EVERY fail-closed refusal in `off`. A\n282\t# refusal must never strand the operator with the posture armed and no way\n283\t# to disarm it short of hand-editing two gitignored files.\n284\t_DISCARD_HINT = (\n285\t    \"Recovery: 'night-mode off --discard-snapshot' removes the local \"\n286\t    \"defaultMode override AND the marker WITHOUT honoring prev_value, and \"\n287\t    \"prints exactly what it discarded.\"\n288\t)\n289\t\n290\t# NM-04 — test-only escape hatch for the --project-root confinement.\n291\t# Set ONLY by the test suite (isolated tmp trees under TestEnvContext).\n292\t_TEST_SEAM_ENV = \"CEO_NIGHT_MODE_TEST_SEAM\"\n293\t\n294\tMARKER_VERSION = 1\n295\t\n296\t_EPILOG = (\n297\t    \"Audit (NM-05/NF-07): every on/off invocation leaves TWO records on \"\n298\t    \"EVERY terminating path — one machine-readable summary line on stdout \"\n299\t    \"('night-mode-event mode=... previous_mode=... \"\n300\t    \"result=applied|noop|refused|failed') and one forensic \"\n301\t    \"'night_mode_toggled' row on the HMAC-chained audit log (registered \"\n302\t    \"action + typed wrapper, sentinel ceremony 610d9ec). Only mode, \"\n303\t    \"previous_mode, result and a hashed hostname travel — never a path, \"\n304\t    \"never file content, never the raw hostname; the emit is best-effort \"\n305\t    \"and never blocks the toggle. 'status' emits neither (read-only). \"\n306\t    \"Refuses on/off when the CI env var is set (PLAN-165 AC-11). \"\n307\t    \"Recovery (NF-02): 'off --discard-snapshot' is the sanctioned exit from \"\n308\t    \"every fail-closed refusal — it removes the local defaultMode override \"\n309\t    \"AND the marker WITHOUT honoring the snapshot's prev_value, printing \"\n310\t    \"exactly what it discarded, and it also disarms the \"\n311\t    \"armed-without-marker state where plain 'off' is a no-op. A refusal \"\n312\t    \"must never leave the posture armed with no way to disarm it. \"\n313\t    \"--project-root is a TEST-ONLY seam confined to this repository \"\n314\t    \"(NM-04); the test-only CEO_NIGHT_MODE_TEST_SEAM env var lifts the \"\n315\t    \"confinement for isolated test trees, and the target must already \"\n316\t    \"contain .claude/settings.json.\"\n317\t)\n318\t\n319\t\n320\t# --------------------------------------------------------------------------- #\n321\t# Path resolution — anchored in FUNCTIONS, not module-level literals, so a\n322\t# test's --project-root (or a patched env) cannot be defeated by an\n323\t# import-time constant (PLAN-165 T1.3 note).\n324\t# --------------------------------------------------------------------------- #\n325\t\n326\t# Bind extracted implementation to this module global namespace.\n327\t_hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n328\tif _hooks_dir not in sys.path:\n329\t    sys.path.insert(0, _hooks_dir)\n330\tfrom _lib._night_mode_parts import install as _install_parts\n331\t_install_parts(globals(), (\"helpers\", \"toggles\"))\n332\t\n333\tdef _local_layer(resolved: Dict[str, Any]) -> Dict[str, Any]:\n334\t    for layer in resolved.get(\"layers\", []):\n335\t        if isinstance(layer, dict) and layer.get(\"name\") == \"local\":\n336\t            return layer\n337\t    return {}\n338\t\n339\t\n340\tdef cmd_status(root: Path) -> int:\n341\t    \"\"\"Reconcile marker vs resolver and REPORT disagreement (D3 + contract 5).\n342\t\n343\t    Read-only; always exits 0. The posture line derives from\n344\t    `_lib.effective_config.resolve_settings()` — the same resolver the\n345\t    tamper tripwires use — never from the marker alone.\n346\t\n347\t    NF-06 (round-4): this command RUNS `_validate_marker` and renders its\n348\t    verdict. It used to print `host=` / `ts=` raw and reconcile a marker it\n349\t    never validated, so it reported \"AGREE — night-mode ON\" for the very\n350\t    document `off` refuses with exit 2 — status blessed what the writer\n351\t    rejects, and a planted `hostname` forged extra lines (a fake\n352\t    `reconciliation:` verdict landing BEFORE the true one). Now: every\n353\t    untrusted echo goes through `_bounded_repr`, an invalid marker reads\n354\t    \"PRESENT but INVALID (<field>)\" and can never reach an AGREE verdict,\n355\t    and every rendered line is collapsed with `_one_line` so no future echo\n356\t    can forge a record either.\n357\t    \"\"\"\n358\t    hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n359\t    if hooks_dir not in sys.path:\n360\t        sys.path.insert(0, hooks_dir)\n361\t    from _lib import effective_config  # noqa: E402\n362\t\n363\t    resolved = effective_config.resolve_settings(str(root))\n364\t    effective = resolved.get(\"effective\") or {}\n365\t    permissions = effective.get(\"permissions\")\n366\t    eff_mode = permissions.get(\"defaultMode\") if isinstance(permissions, dict) else None\n367\t    eff_layer = (resolved.get(\"sources\") or {}).get(\"permissions\", \"(none)\")\n368\t\n369\t    lines: List[str] = [\"## night-mode status\"]\n370\t    lines.append(\n371\t        \"effective permissions.defaultMode: {0} \"\n372\t        \"(layer: {1}; resolver: _lib.effective_config)\".format(\n373\t            # NF-06: bounded — the winning value can come from the overlay.\n374\t            _bounded_repr(eff_mode), eff_layer,\n375\t        )\n376\t    )\n377\t    if not resolved.get(\"ok\", True):\n378\t        lines.append(f\"resolver errors: {_bounded_repr(resolved.get('errors'))}\")\n379\t\n380\t    # What the LOCAL overlay itself says (the layer night-mode writes).\n381\t    local = _local_layer(resolved)\n382\t    local_data = local.get(\"data\") if isinstance(local.get(\"data\"), dict) else {}\n383\t    local_perms = local_data.get(\"permissions\")\n384\t    local_mode = local_perms.get(\"defaultMode\") if isinstance(local_perms, dict) else None\n385\t    lines.append(\n386\t        \"local overlay defaultMode: {0} (exists={1}, parse_ok={2})\".format(\n387\t            _bounded_repr(local_mode),\n388\t            bool(local.get(\"exists\")),\n389\t            bool(local.get(\"ok\")),\n390\t        )\n391\t    )\n392\t\n393\t    marker_file = marker_path(root)\n394\t    marker: Optional[Dict[str, Any]] = None\n395\t    marker_diag: Optional[str] = None\n396\t    marker_invalid: Optional[str] = None\n397\t    if marker_file.exists():\n398\t        marker, marker_diag = _load_json_fail_closed(marker_file, \"night-mode marker\")\n399\t\n400\t    if marker is not None:\n401\t        # NF-06: the SAME whole-document gate `off` applies. A marker status\n402\t        # blesses must be a marker the writer would accept.\n403\t        marker_invalid = _validate_marker(marker)\n404\t        lines.append(\n405\t            \"marker: {0} (age {1}, mode_written={2}, host={3}, ts={4})\".format(\n406\t                \"PRESENT\" if marker_invalid is None else \"PRESENT but INVALID\",\n407\t                _marker_age_str(str(marker.get(\"ts\"))),\n408\t                _bounded_repr(marker.get(\"mode_written\")),\n409\t                _bounded_repr(marker.get(\"hostname\")),\n410\t                _bounded_repr(marker.get(\"ts\")),\n411\t            )\n412\t        )\n413\t        if marker_invalid is not None:\n414\t            lines.append(f\"marker validation: {marker_invalid}\")\n415\t    elif marker_diag is not None:\n416\t        lines.append(f\"marker: PRESENT but unreadable — {marker_diag}\")\n417\t    else:\n418\t        lines.append(\"marker: absent (night-mode OFF)\")\n419\t\n420\t    # Reconciliation — report, never repair (contract item 5).\n421\t    if marker is not None and marker_invalid is not None:\n422\t        # NF-06: an INVALID marker reconciles nothing. Reporting AGREE here\n423\t        # (round-3 behavior) told the Owner \"night-mode ON\" about a document\n424\t        # `off` refuses with exit 2 — and the posture the overlay carries is\n425\t        # then unexplained by any trustworthy record.\n426\t        verdict = (\n427\t            \"DISAGREE — the marker is PRESENT but INVALID ({0}); it is not a \"\n428\t            \"document night-mode wrote, so night-mode state cannot be \"\n429\t            \"reconciled from it. 'off' refuses this marker (exit 2); recover \"\n430\t            \"with 'off --discard-snapshot'.\".format(marker_invalid)\n431\t        )\n432\t    elif marker is not None:\n433\t        if local_mode == marker.get(\"mode_written\"):\n434\t            verdict = \"AGREE — marker and local overlay match (night-mode ON)\"\n435\t        else:\n436\t            verdict = (\n437\t                \"DISAGREE — marker says night-mode wrote \"\n438\t                \"{0} but the local overlay has {1} (crash between writes, or \"\n439\t                \"hand edit). Reconcile by hand, then 'off' or 'on'.\".format(\n440\t                    _bounded_repr(marker.get(\"mode_written\")),\n441\t                    _bounded_repr(local_mode),\n442\t                )\n443\t            )\n444\t    elif marker_diag is not None:\n445\t        verdict = (\n446\t            \"DISAGREE — marker exists but cannot be parsed; treat night-mode \"\n447\t            \"state as unknown and reconcile by hand.\"\n448\t        )\n449\t    else:\n450\t        if local_mode is None:\n451\t            verdict = \"AGREE — no marker and the local overlay sets no defaultMode (night-mode OFF)\"\n452\t        elif local_mode == NIGHT_MODE:\n453\t            # AC-5 crash class: settings armed but the marker never landed\n454\t            # (crash between the two writes) — or a hand-arm. Either way\n455\t            # night-mode did not record it; report, never repair.\n456\t            verdict = (\n457\t                f\"DISAGREE — no marker, but the local overlay is armed with \"\n458\t                f\"defaultMode={NIGHT_MODE!r} (crash between settings and \"\n459\t                \"marker writes, or a hand edit). night-mode did not record \"\n460\t                \"this; reconcile by hand.\"\n461\t            )\n462\t        else:\n463\t            verdict = (\n464\t                \"AGREE — night-mode OFF; note: the local overlay hand-sets \"\n465\t                \"defaultMode={0} outside night-mode's management (posture \"\n466\t                \"visibility is the /ceo-boot banner's job).\".format(\n467\t                    _bounded_repr(local_mode)\n468\t                )\n469\t            )\n470\t    lines.append(f\"reconciliation: {verdict}\")\n471\t\n472\t    # NF-06: one rendered line per record, enforced at the single point where\n473\t    # the report is emitted. Every untrusted value above is already bounded +\n474\t    # repr-escaped; this is the structural backstop, so a future field echoed\n475\t    # without `_bounded_repr` still cannot forge a second `reconciliation:`\n476\t    # (or `marker:`) line.\n477\t    print(\"\\n\".join(_one_line(line) for line in lines))\n478\t    return 0\n479\t\n480\t\n481\t# --------------------------------------------------------------------------- #\n482\t# CLI\n483\t# --------------------------------------------------------------------------- #\n484\tdef main(argv: Optional[List[str]] = None) -> int:\n485\t    parser = argparse.ArgumentParser(\n486\t        prog=\"night-mode\",\n487\t        description=(\n488\t            \"Toggle the per-machine autonomy posture \"\n489\t            \"(permissions.defaultMode=acceptEdits in .claude/settings.local.json) \"\n490\t            \"for the NEXT session. PLAN-165.\"\n491\t        ),\n492\t        epilog=_EPILOG,\n493\t    )\n494\t    parser.add_argument(\n495\t        \"command\",\n496\t        choices=(\"on\", \"off\", \"status\"),\n497\t        help=\"on: arm acceptEdits for the next session; off: restore the \"\n498\t             \"snapshot; status: reconcile marker vs resolved settings\",\n499\t    )\n500\t    parser.add_argument(\n501\t        \"--discard-snapshot\",\n502\t        dest=\"discard_snapshot\",\n503\t        action=\"store_true\",\n504\t        help=\"with 'off' ONLY — recovery from a fail-closed refusal: remove \"\n505\t             \"the local defaultMode override AND the marker WITHOUT honoring \"\n506\t             \"the snapshot's prev_value, printing exactly what was \"\n507\t             \"discarded. Also disarms the armed-without-marker state, where \"\n508\t             \"plain 'off' is a no-op (NF-02).\",\n509\t    )\n510\t    parser.add_argument(\n511\t        \"--project-root\",\n512\t        dest=\"project_root\",\n513\t        default=None,\n514\t        help=argparse.SUPPRESS,  # test seam only\n515\t    )\n516\t    args = parser.parse_args(argv)\n517\t\n518\t    self_diag = _check_self_path()\n519\t    if self_diag is not None:\n520\t        # NF-08b: BEFORE any other dispatch, including the root confinement —\n521\t        # a script running from an alias has no business resolving a target.\n522\t        # `status` is refused too, matching `_e4`'s scope decision: the SCRIPT\n523\t        # is the surface, and a read-only carve-out would key a PERMISSIVE\n524\t        # branch off argv parsing.\n525\t        sys.stderr.write(f\"night-mode: {self_diag}\\n\")\n526\t        if args.command in (\"on\", \"off\"):\n527\t            # A refusal is a terminating path of on/off (NM-05/NF-07), so it\n528\t            # leaves BOTH records. The audit emit resolves through REPO_ROOT,\n529\t            # i.e. the REAL repository the alias points into — which is\n530\t            # exactly where the attempt should be recorded.\n531\t            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n532\t            _emit_audit(\"other\", \"other\", \"refused\")\n533\t        return 2\n534\t\n535\t    if args.discard_snapshot and args.command != \"off\":\n536\t        sys.stderr.write(\n537\t            \"night-mode: --discard-snapshot is only valid with 'off' (got \"\n538\t            f\"{args.command!r}); it is the recovery path for a refused \"\n539\t            \"restore, not a mode of arming or reporting.\\n\"\n540\t        )\n541\t        if args.command == \"on\":\n542\t            # Pre-dispatch refusals are terminating paths of on/off too —\n543\t            # the SPEC row says EVERY one leaves a `night_mode_toggled`\n544\t            # record, so the pair travels here as well (NF-07).\n545\t            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n546\t            _emit_audit(\"other\", \"other\", \"refused\")\n547\t        return 2\n548\t\n549\t    root = Path(args.project_root).resolve() if args.project_root else REPO_ROOT\n550\t\n551\t    diag = _validate_root(root)\n552\t    if diag is not None:\n553\t        # NM-04: fail-closed on an unconfined target, BEFORE any dispatch.\n554\t        sys.stderr.write(f\"night-mode: {diag}\\n\")\n555\t        if args.command in (\"on\", \"off\"):\n556\t            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n557\t            _emit_audit(\"other\", \"other\", \"refused\")\n558\t        return 2\n559\t\n560\t    try:\n561\t        if args.command == \"on\":\n562\t            return cmd_on(root)\n563\t        if args.command == \"off\":\n564\t            if args.discard_snapshot:\n565\t                return cmd_off_discard_snapshot(root)\n566\t            return cmd_off(root)\n567\t        return cmd_status(root)\n568\t    except Exception as exc:  # noqa: BLE001 — CLI must exit, not traceback\n569\t        sys.stderr.write(\n570\t            f\"night-mode: internal error ({exc.__class__.__name__}: {exc})\\n\"\n571\t        )\n572\t        if args.command in (\"on\", \"off\"):\n573\t            # NM-05/NF-07: even the catch-all leaves BOTH records.\n574\t            #\n575\t            # Lock contention is a REFUSAL, not a failure: nothing was\n576\t            # attempted, another holder owns the mutation sequence, and this\n577\t            # path exits 2 — which the ceremony's result table maps to\n578\t            # `refused` (`failed` is reserved for exit 1, \"a write was\n579\t            # attempted and lost\"). NF-11(b) flagged the old blanket\n580\t            # `failed` as diverging from that table. ONE `result` feeds BOTH\n581\t            # records, so the operator-facing line and the signed row can\n582\t            # never disagree about the same invocation (the NF-09 lesson).\n583\t            #\n584\t            # Classifying must not itself be able to raise: the import sits\n585\t            # in its own try, and an unimportable `_lib` degrades to\n586\t            # `failed` — the conservative value, since a build that cannot\n587\t            # import its own lock is not refusing, it is broken.\n588\t            result = \"failed\"\n589\t            try:\n590\t                hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n591\t                if hooks_dir not in sys.path:\n592\t                    sys.path.insert(0, hooks_dir)\n593\t                from _lib.filelock import FileLockTimeout  # noqa: E402\n594\t\n595\t                if isinstance(exc, FileLockTimeout):\n596\t                    result = \"refused\"\n597\t            except Exception:  # noqa: BLE001 — classification is best-effort\n598\t                pass\n599\t            _summary(mode=\"none\", previous_mode=\"none\", result=result)\n600\t            _emit_audit(\"other\", \"other\", result)\n601\t        return 2\n602\t\n603\t\n604\tif __name__ == \"__main__\":\n605\t    sys.exit(main())\n606\t"}]},"parent_tool_use_id":null,"session_id":"a75fce92-96ca-4d13-a29e-d655897f3e0a","uuid":"2ad3c38c-e4a9-4664-b603-9097f0e937de","timestamp":"2026-11-13T16:56:40.923Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/night-mode.py","content":"  the hook keeps the cheap half (denying `ln` on the toggle) as the\n  earlier signal. An ancestor directory being a symlink is NOT an alias\n  (`/tmp` -> `/private/tmp`), so ancestors are resolved separately.\n\nExit codes:\n    0 — success or idempotent no-op\n    1 — read-back mismatch / post-write verification failure\n    2 — usage error, CI refusal, alias/relocated invocation (NF-08b),\n        root confinement (NM-04), tampered or malformed marker (NM-01 /\n        NF-01..NF-03 / NF-06), or malformed input (all fail-closed).\n        Recover an armed posture from any of these with\n        `off --discard-snapshot`.\n\nStdlib-only; Python >= 3.9.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport copy\nimport hashlib\nimport json\nimport os\nimport socket\nimport stat\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\n\n# NF-08b — the path this script was INVOKED as, before any symlink is\n# followed. Captured at import so it cannot depend on a later `os.chdir`;\n# `absolute()` deliberately does NOT resolve links (that is the whole point —\n# `REPO_ROOT` above already has the resolved form).\n_INVOKED_SELF = Path(__file__).absolute()\n\n# The one relative location this script may legitimately be executed from.\n_CANONICAL_SELF_PARTS = (\".claude\", \"scripts\", \"night-mode.py\")\n\n# The ONLY mode `on` ever writes (PLAN-165 D1 — bypassPermissions was cut\n# in review; do not add a mode flag).\nNIGHT_MODE = \"acceptEdits\"\n\n# The harness's REAL `--permission-mode` enum — verified against\n# `claude --help` on the pinned CLI (2026-08-03). NF-02 (round-3 review):\n# the restorable set below is DERIVED from this enum instead of being\n# hand-listed, because a hand-listed set drifted BOTH ways at once — it\n# carried `default` (never a harness mode) and OMITTED `dontAsk` (a legal\n# one). The omission was the dangerous half: an Owner whose overlay\n# legitimately carried `dontAsk` had it snapshotted by `on`, and then every\n# `off` refused forever with `acceptEdits` left armed — a fail-closed gate\n# landing on the PERMISSIVE side. If the CLI gains a mode, update THIS\n# constant; the derivation and the diagnostics follow automatically.\n_HARNESS_PERMISSION_MODES = frozenset(\n    {\"acceptEdits\", \"auto\", \"bypassPermissions\", \"manual\", \"dontAsk\", \"plan\"}\n)\n\n# NM-01 / NF-01 / NF-02 — closed set of modes `off` may restore. Derived,\n# with exactly two exclusions, both load-bearing:\n#\n# - `bypassPermissions` (D1): present in ANY settings layer it trips\n#   `TAMPER_PERMISSION_BYPASS` (`_lib/effective_config.py`) and turns\n#   `/ceo-boot` red by design. night-mode must never be the thing that\n#   writes it back — not even under the name \"restoring\".\n# - `NIGHT_MODE` (`acceptEdits`, NF-01): cmd_on's desync normalization\n#   guarantees that a HEALTHY marker never carries night-mode's own value\n#   as `prev_value`. Admitting it to the set could therefore only ever\n#   admit a TAMPERED value — and honoring it produces the worst end-state\n#   this script has: `off` re-writes `acceptEdits` into the overlay,\n#   REMOVES the marker, and exits 0, leaving the posture armed with no\n#   marker, so every later `off` is a forever no-op.\n#\n# The marker is gitignored, unguarded, agent-writable state; a `prev_value`\n# outside this set is evidence of tampering (or of a mode enum this build\n# does not know), so restore fails CLOSED — with `off --discard-snapshot`\n# as the documented, non-restoring way out (NF-02).\n_RESTORABLE_MODES = _HARNESS_PERMISSION_MODES - {\"bypassPermissions\", NIGHT_MODE}\n\n# NF-02 — the sanctioned exit from EVERY fail-closed refusal in `off`. A\n# refusal must never strand the operator with the posture armed and no way\n# to disarm it short of hand-editing two gitignored files.\n_DISCARD_HINT = (\n    \"Recovery: 'night-mode off --discard-snapshot' removes the local \"\n    \"defaultMode override AND the marker WITHOUT honoring prev_value, and \"\n    \"prints exactly what it discarded.\"\n)\n\n# NM-04 — test-only escape hatch for the --project-root confinement.\n# Set ONLY by the test suite (isolated tmp trees under TestEnvContext).\n_TEST_SEAM_ENV = \"CEO_NIGHT_MODE_TEST_SEAM\"\n\nMARKER_VERSION = 1\n\n_EPILOG = (\n    \"Audit (NM-05/NF-07): every on/off invocation leaves TWO records on \"\n    \"EVERY terminating path — one machine-readable summary line on stdout \"\n    \"('night-mode-event mode=... previous_mode=... \"\n    \"result=applied|noop|refused|failed') and one forensic \"\n    \"'night_mode_toggled' row on the HMAC-chained audit log (registered \"\n    \"action + typed wrapper, sentinel ceremony 610d9ec). Only mode, \"\n    \"previous_mode, result and a hashed hostname travel — never a path, \"\n    \"never file content, never the raw hostname; the emit is best-effort \"\n    \"and never blocks the toggle. 'status' emits neither (read-only). \"\n    \"Refuses on/off when the CI env var is set (PLAN-165 AC-11). \"\n    \"Recovery (NF-02): 'off --discard-snapshot' is the sanctioned exit from \"\n    \"every fail-closed refusal — it removes the local defaultMode override \"\n    \"AND the marker WITHOUT honoring the snapshot's prev_value, printing \"\n    \"exactly what it discarded, and it also disarms the \"\n    \"armed-without-marker state where plain 'off' is a no-op. A refusal \"\n    \"must never leave the posture armed with no way to disarm it. \"\n    \"--project-root is a TEST-ONLY seam confined to this repository \"\n    \"(NM-04); the test-only CEO_NIGHT_MODE_TEST_SEAM env var lifts the \"\n    \"confinement for isolated test trees, and the target must already \"\n    \"contain .claude/settings.json.\"\n)\n\n\n# --------------------------------------------------------------------------- #\n# Path resolution — anchored in FUNCTIONS, not module-level literals, so a\n# test's --project-root (or a patched env) cannot be defeated by an\n# import-time constant (PLAN-165 T1.3 note).\n# --------------------------------------------------------------------------- #\n\n# Bind extracted implementation to this module global namespace.\n_hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\nif _hooks_dir not in sys.path:\n    sys.path.insert(0, _hooks_dir)\nfrom _lib._night_mode_parts import install as _install_parts\n_install_parts(globals(), (\"helpers\", \"toggles\"))\n\ndef _local_layer(resolved: Dict[str, Any]) -> Dict[str, Any]:\n    for layer in resolved.get(\"layers\", []):\n        if isinstance(layer, dict) and layer.get(\"name\") == \"local\":\n            return layer\n    return {}\n\n\ndef cmd_status(root: Path) -> int:\n    \"\"\"Reconcile marker vs resolver and REPORT disagreement (D3 + contract 5).\n\n    Read-only; always exits 0. The posture line derives from\n    `_lib.effective_config.resolve_settings()` — the same resolver the\n    tamper tripwires use — never from the marker alone.\n\n    NF-06 (round-4): this command RUNS `_validate_marker` and renders its\n    verdict. It used to print `host=` / `ts=` raw and reconcile a marker it\n    never validated, so it reported \"AGREE — night-mode ON\" for the very\n    document `off` refuses with exit 2 — status blessed what the writer\n    rejects, and a planted `hostname` forged extra lines (a fake\n    `reconciliation:` verdict landing BEFORE the true one). Now: every\n    untrusted echo goes through `_bounded_repr`, an invalid marker reads\n    \"PRESENT but INVALID (<field>)\" and can never reach an AGREE verdict,\n    and every rendered line is collapsed with `_one_line` so no future echo\n    can forge a record either.\n    \"\"\"\n    hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n    if hooks_dir not in sys.path:\n        sys.path.insert(0, hooks_dir)\n    from _lib import effective_config  # noqa: E402\n\n    resolved = effective_config.resolve_settings(str(root))\n    effective = resolved.get(\"effective\") or {}\n    permissions = effective.get(\"permissions\")\n    eff_mode = permissions.get(\"defaultMode\") if isinstance(permissions, dict) else None\n    eff_layer = (resolved.get(\"sources\") or {}).get(\"permissions\", \"(none)\")\n\n    lines: List[str] = [\"## night-mode status\"]\n    lines.append(\n        \"effective permissions.defaultMode: {0} \"\n        \"(layer: {1}; resolver: _lib.effective_config)\".format(\n            # NF-06: bounded — the winning value can come from the overlay.\n            _bounded_repr(eff_mode), eff_layer,\n        )\n    )\n    if not resolved.get(\"ok\", True):\n        lines.append(f\"resolver errors: {_bounded_repr(resolved.get('errors'))}\")\n\n    # What the LOCAL overlay itself says (the layer night-mode writes).\n    local = _local_layer(resolved)\n    local_data = local.get(\"data\") if isinstance(local.get(\"data\"), dict) else {}\n    local_perms = local_data.get(\"permissions\")\n    local_mode = local_perms.get(\"defaultMode\") if isinstance(local_perms, dict) else None\n    lines.append(\n        \"local overlay defaultMode: {0} (exists={1}, parse_ok={2})\".format(\n            _bounded_repr(local_mode),\n            bool(local.get(\"exists\")),\n            bool(local.get(\"ok\")),\n        )\n    )\n\n    marker_file = marker_path(root)\n    marker: Optional[Dict[str, Any]] = None\n    marker_diag: Optional[str] = None\n    marker_invalid: Optional[str] = None\n    if marker_file.exists():\n        marker, marker_diag = _load_json_fail_closed(marker_file, \"night-mode marker\")\n\n    if marker is not None:\n        # NF-06: the SAME whole-document gate `off` applies. A marker status\n        # blesses must be a marker the writer would accept.\n        marker_invalid = _validate_marker(marker)\n        lines.append(\n            \"marker: {0} (age {1}, mode_written={2}, host={3}, ts={4})\".format(\n                \"PRESENT\" if marker_invalid is None else \"PRESENT but INVALID\",\n                _marker_age_str(str(marker.get(\"ts\"))),\n                _bounded_repr(marker.get(\"mode_written\")),\n                _bounded_repr(marker.get(\"hostname\")),\n                _bounded_repr(marker.get(\"ts\")),\n            )\n        )\n        if marker_invalid is not None:\n            lines.append(f\"marker validation: {marker_invalid}\")\n    elif marker_diag is not None:\n        lines.append(f\"marker: PRESENT but unreadable — {marker_diag}\")\n    else:\n        lines.append(\"marker: absent (night-mode OFF)\")\n\n    # Reconciliation — report, never repair (contract item 5).\n    if marker is not None and marker_invalid is not None:\n        # NF-06: an INVALID marker reconciles nothing. Reporting AGREE here\n        # (round-3 behavior) told the Owner \"night-mode ON\" about a document\n        # `off` refuses with exit 2 — and the posture the overlay carries is\n        # then unexplained by any trustworthy record.\n        verdict = (\n            \"DISAGREE — the marker is PRESENT but INVALID ({0}); it is not a \"\n            \"document night-mode wrote, so night-mode state cannot be \"\n            \"reconciled from it. 'off' refuses this marker (exit 2); recover \"\n            \"with 'off --discard-snapshot'.\".format(marker_invalid)\n        )\n    elif marker is not None:\n        if local_mode == marker.get(\"mode_written\"):\n            verdict = \"AGREE — marker and local overlay match (night-mode ON)\"\n        else:\n            verdict = (\n                \"DISAGREE — marker says night-mode wrote \"\n                \"{0} but the local overlay has {1} (crash between writes, or \"\n                \"hand edit). Reconcile by hand, then 'off' or 'on'.\".format(\n                    _bounded_repr(marker.get(\"mode_written\")),\n                    _bounded_repr(local_mode),\n                )\n            )\n    elif marker_diag is not None:\n        verdict = (\n            \"DISAGREE — marker exists but cannot be parsed; treat night-mode \"\n            \"state as unknown and reconcile by hand.\"\n        )\n    else:\n        if local_mode is None:\n            verdict = \"AGREE — no marker and the local overlay sets no defaultMode (night-mode OFF)\"\n        elif local_mode == NIGHT_MODE:\n            # AC-5 crash class: settings armed but the marker never landed\n            # (crash between the two writes) — or a hand-arm. Either way\n            # night-mode did not record it; report, never repair.\n            verdict = (\n                f\"DISAGREE — no marker, but the local overlay is armed with \"\n                f\"defaultMode={NIGHT_MODE!r} (crash between settings and \"\n                \"marker writes, or a hand edit). night-mode did not record \"\n                \"this; reconcile by hand.\"\n            )\n        else:\n            verdict = (\n                \"AGREE — night-mode OFF; note: the local overlay hand-sets \"\n                \"defaultMode={0} outside night-mode's management (posture \"\n                \"visibility is the /ceo-boot banner's job).\".format(\n                    _bounded_repr(local_mode)\n                )\n            )\n    lines.append(f\"reconciliation: {verdict}\")\n\n    # NF-06: one rendered line per record, enforced at the single point where\n    # the report is emitted. Every untrusted value above is already bounded +\n    # repr-escaped; this is the structural backstop, so a future field echoed\n    # without `_bounded_repr` still cannot forge a second `reconciliation:`\n    # (or `marker:`) line.\n    print(\"\\n\".join(_one_line(line) for line in lines))\n    return 0\n\n\n# --------------------------------------------------------------------------- #\n# CLI\n# --------------------------------------------------------------------------- #\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = argparse.ArgumentParser(\n        prog=\"night-mode\",\n        description=(\n            \"Toggle the per-machine autonomy posture \"\n            \"(permissions.defaultMode=acceptEdits in .claude/settings.local.json) \"\n            \"for the NEXT session. PLAN-165.\"\n        ),\n        epilog=_EPILOG,\n    )\n    parser.add_argument(\n        \"command\",\n        choices=(\"on\", \"off\", \"status\"),\n        help=\"on: arm acceptEdits for the next session; off: restore the \"\n             \"snapshot; status: reconcile marker vs resolved settings\",\n    )\n    parser.add_argument(\n        \"--discard-snapshot\",\n        dest=\"discard_snapshot\",\n        action=\"store_true\",\n        help=\"with 'off' ONLY — recovery from a fail-closed refusal: remove \"\n             \"the local defaultMode override AND the marker WITHOUT honoring \"\n             \"the snapshot's prev_value, printing exactly what was \"\n             \"discarded. Also disarms the armed-without-marker state, where \"\n             \"plain 'off' is a no-op (NF-02).\",\n    )\n    parser.add_argument(\n        \"--project-root\",\n        dest=\"project_root\",\n        default=None,\n        help=argparse.SUPPRESS,  # test seam only\n    )\n    args = parser.parse_args(argv)\n\n    self_diag = _check_self_path()\n    if self_diag is not None:\n        # NF-08b: BEFORE any other dispatch, including the root confinement —\n        # a script running from an alias has no business resolving a target.\n        # `status` is refused too, matching `_e4`'s scope decision: the SCRIPT\n        # is the surface, and a read-only carve-out would key a PERMISSIVE\n        # branch off argv parsing.\n        sys.stderr.write(f\"night-mode: {self_diag}\\n\")\n        if args.command in (\"on\", \"off\"):\n            # A refusal is a terminating path of on/off (NM-05/NF-07), so it\n            # leaves BOTH records. The audit emit resolves through REPO_ROOT,\n            # i.e. the REAL repository the alias points into — which is\n            # exactly where the attempt should be recorded.\n            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n            _emit_audit(\"other\", \"other\", \"refused\")\n        return 2\n\n    if args.discard_snapshot and args.command != \"off\":\n        sys.stderr.write(\n            \"night-mode: --discard-snapshot is only valid with 'off' (got \"\n            f\"{args.command!r}); it is the recovery path for a refused \"\n            \"restore, not a mode of arming or reporting.\\n\"\n        )\n        if args.command == \"on\":\n            # Pre-dispatch refusals are terminating paths of on/off too —\n            # the SPEC row says EVERY one leaves a `night_mode_toggled`\n            # record, so the pair travels here as well (NF-07).\n            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n            _emit_audit(\"other\", \"other\", \"refused\")\n        return 2\n\n    root = Path(args.project_root).resolve() if args.project_root else REPO_ROOT\n\n    diag = _validate_root(root)\n    if diag is not None:\n        # NM-04: fail-closed on an unconfined target, BEFORE any dispatch.\n        sys.stderr.write(f\"night-mode: {diag}\\n\")\n        if args.command in (\"on\", \"off\"):\n            _summary(mode=\"none\", previous_mode=\"none\", result=\"refused\")\n            _emit_audit(\"other\", \"other\", \"refused\")\n        return 2\n\n    try:\n        if args.command == \"on\":\n            return cmd_on(root)\n        if args.command == \"off\":\n            if args.discard_snapshot:\n                return cmd_off_discard_snapshot(root)\n            return cmd_off(root)\n        return cmd_status(root)\n    except Exception as exc:  # noqa: BLE001 — CLI must exit, not traceback\n        sys.stderr.write(\n            f\"night-mode: internal error ({exc.__class__.__name__}: {exc})\\n\"\n        )\n        if args.command in (\"on\", \"off\"):\n            # NM-05/NF-07: even the catch-all leaves BOTH records.\n            #\n            # Lock contention is a REFUSAL, not a failure: nothing was\n            # attempted, another holder owns the mutation sequence, and this\n            # path exits 2 — which the ceremony's result table maps to\n            # `refused` (`failed` is reserved for exit 1, \"a write was\n            # attempted and lost\"). NF-11(b) flagged the old blanket\n            # `failed` as diverging from that table. ONE `result` feeds BOTH\n            # records, so the operator-facing line and the signed row can\n            # never disagree about the same invocation (the NF-09 lesson).\n            #\n            # Classifying must not itself be able to raise: the import sits\n            # in its own try, and an unimportable `_lib` degrades to\n            # `failed` — the conservative value, since a build that cannot\n            # import its own lock is not refusing, it is broken.\n            result = \"failed\"\n            try:\n                hooks_dir = str(REPO_ROOT / \".claude\" / \"hooks\")\n                if hooks_dir not in sys.path:\n                    sys.path.insert(0, hooks_dir)\n                from _lib.filelock import FileLockTimeout  # noqa: E402\n\n                if isinstance(exc, FileLockTimeout):\n                    result = \"refused\"\n            except Exception:  # noqa: BLE001 — classification is best-effort\n                pass\n            _summary(mode=\"none\", previous_mode=\"none\", result=result)\n            _emit_audit(\"other\", \"other\", result)\n        return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":407,"startLine":200,"totalLines":606}},"tool_result_meta":[{"id":"toolu_019YP1Xjc3EgmE2GDXU1QqF9","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
