-        try:
-            parsed = parse_rfc3339_utc(ts)
-        except ValueError:
-            return "malformed_timestamp"
-        skew = abs(parsed.timestamp() - time.time())
-        if skew > MAX_CLOCK_SKEW_SECONDS:
-            return "clock_skew"
-        return None
