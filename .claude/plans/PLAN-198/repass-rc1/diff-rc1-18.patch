-                i = k_end
-            while i < n and raw[i] in " \t":
-                i += 1
-            if i >= n or raw[i] != ":":
-                raise PolicyLoadError(
-                    "parse_error",
-                    f"flow mapping missing ':' at line {self._i}",
-                    self._policy_id_hint,
-                )
-            i += 1
-            while i < n and raw[i] in " \t":
-                i += 1
-            if i < n and raw[i] == "{":
