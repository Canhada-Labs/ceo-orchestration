-            from .replay import verify_signature  # type: ignore[import]
-        except ImportError:
-            from replay import verify_signature  # type: ignore[no-redef]
-        ok = verify_signature(
-            self.command or "", self.path or "", ts, nonce, body,
-            peer.hmac_secret_hex, sig,
