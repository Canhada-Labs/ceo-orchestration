-    def _parse_flow_sequence(self, raw: str) -> List[Any]:
-        assert raw[0] == "["
-        out: List[Any] = []
-        i = 1
-        n = len(raw)
-        while i < n:
-            while i < n and raw[i] in " \t":
-                i += 1
-            if i < n and raw[i] == "]":
-                tail = raw[i + 1:].strip()
