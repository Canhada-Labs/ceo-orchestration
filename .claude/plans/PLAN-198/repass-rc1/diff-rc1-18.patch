-                        _, j = self._consume_double_quoted(raw, j, line_no=self._i)
-                        continue
-                    if c == "'":
-                        _, j = self._consume_single_quoted(raw, j, line_no=self._i)
-                        continue
-                    if c == "{":
-                        depth_f += 1
-                    elif c == "}":
-                        depth_f -= 1
-                    j += 1
-                inner = raw[i:j]
-                value = self._parse_flow_mapping(inner)
-                i = j
-            elif i < n and raw[i] == "[":
-                depth_f = 1
-                j = i + 1
-                while j < n and depth_f > 0:
-                    c = raw[j]
-                    if c == '"':
-                        _, j = self._consume_double_quoted(raw, j, line_no=self._i)
-                        continue
-                    if c == "'":
-                        _, j = self._consume_single_quoted(raw, j, line_no=self._i)
-                        continue
-                    if c == "[":
-                        depth_f += 1
-                    elif c == "]":
