   131	def scan(repo_root: Path) -> List[Path]:
   132	    """Scan the verified index; refuse inputs that cannot be proved readable."""
   133	    pattern = build_pattern(repo_root)
   134	    return _find_term_violations(
   135	        repo_root, pattern, FileWalker, _ALLOWLIST_EXACT, _ALLOWLIST_GLOBS,
   136	        _SKIP_SUFFIXES, is_never_allowlisted, _personal_path_index_modes,
   137	        PersonalPathUnreadable,
   138	    )
