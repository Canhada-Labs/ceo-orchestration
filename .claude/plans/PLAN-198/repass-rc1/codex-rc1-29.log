-    match = _PERSONAL_PATH_UNDECODABLE_RE.search(rel)
-    if match is None:
-        return False
-    if in_personal_path_scope(rel):
-        return True
-    head = rel[:match.start()]
-    return any(len(head) < len(prefix) and prefix.startswith(head)
-               for prefix in _PERSONAL_PATH_SCOPE)
