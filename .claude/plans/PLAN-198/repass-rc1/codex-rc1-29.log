   141	def main(argv: Optional[List[str]] = None) -> int:
   142	    """Resolve the CLI boundary before running both contamination rules."""
   143	    try:
   144	        args = _parse_args(argv)
   145	    except PersonalPathUsage as exc:
   146	        # Fail-CLOSED on a CLI token this gate will not guess at.
   147	        # The message is already redacted at the raise site: a
   148	        # stray argument can BE an absolute home path, and this
   149	        # line lands in the same public log as the findings.
   150	        print("FATAL: %s" % exc, file=sys.stderr)
   151	        return 2
   152	    try:
   153	        repo_root = (
   154	            Path(args.root).resolve() if args.root is not None
   155	            else Path(__file__).resolve().parent.parent.parent
   156	        )
   157	    except Exception as exc:
   158	        # A BOUNDARY, not a type list. `resolve()` raises
   159	        # OSError for some failures and a bare RuntimeError for
   160	        # a symlink LOOP on Python 3.9, so naming OSError alone
   161	        # still left the traceback (pair-rail round 2, the same
   162	        # shape twice in one file).
   163	        # `resolve()` raises on a symlink LOOP, and it raised
   164	        # BEFORE any guarded path: an rc-1 traceback carrying
   165	        # the supplied path and this file's absolute location
   166	        # (pair-rail round 2, P2). That path is chosen by
   167	        # whoever runs the gate and can BE a home directory.
   168	        print("FATAL: cannot resolve --root: %s"
   169	              % _personal_path_safe(_oserror_reason(exc)),
   170	              file=sys.stderr)
   171	        return 2
   172	    try:
   173	        is_repo = ((repo_root / ".git").exists()
   174	                   or (repo_root / ".git").is_dir())
   175	    except Exception as exc:
   176	        # The boundary above ENDED before this test, so an
   177	        # unsearchable resolved root raised PermissionError here
   178	        # and the traceback carried the root -- chosen by whoever
   179	        # runs the gate, and able to BE a home directory
   180	        # (pair-rail round 3, P2).
   181	        print("FATAL: cannot inspect --root: %s"
   182	              % _personal_path_safe(_oserror_reason(exc)),
   183	              file=sys.stderr)
   184	        return 2
   185	    if not is_repo:
   186	        # Not a git repo — exit 2
   187	        print("FATAL: not inside a git repo", file=sys.stderr)
   188	        return 2
   189	
   190	    return _run_checks(repo_root, args)
   191	
   192	
   193	def _run_checks(repo_root: Path, args: argparse.Namespace) -> int:
   194	    """Preserve path diagnostics, then check and report the term inventory."""
   195	    allowlist_path = (
   196	        Path(args.personal_path_allowlist)
   197	        if args.personal_path_allowlist is not None
   198	        else repo_root / _PERSONAL_PATH_ALLOWLIST_REL
   199	    )
   200	    if args.emit_personal_path_rows:
   201	        # Rows ONLY: the term report would make the output
   202	        # unpasteable, and this mode exists to be pasted.
   203	        return report_personal_paths(
   204	            repo_root, allowlist_path, emit_rows=True,
   205	        )
   206	
   207	    # Preserve Rule 2's subject-specific diagnostic before the term scan.
   208	    rc_paths = report_personal_paths(
   209	        repo_root, allowlist_path, fail_on_stale=args.fail_on_stale,
   210	    )
   211	    if rc_paths == 2:
   212	        return 2
   213	    term_fatal = False
   214	    violations: List[Path] = []
   215	    try:
   216	        violations = scan(repo_root)
   217	    except PersonalPathUnreadable as exc:
   218	        # Composed by scan() itself, with masked paths: say which proof failed. RULE 2
   219	        # still runs below, as it does after a term hit, and rc stays 2.
   220	        print("FATAL: %s" % _personal_path_safe(str(exc)), file=sys.stderr)
   221	        term_fatal = True
   222	    except Exception as exc:
   223	        # A BOUNDARY, not a list of exception types. The term
   224	        # scan reads a file and COMPILES what is in it as a raw
   225	        # regex, so its failure modes are open-ended: OSError,
   226	        # UnicodeDecodeError and re.error were each named here
   227	        # after a rail round found them, and round 2 then found
   228	        # RecursionError (2000 open parens in a private term),
   229	        # which escaped as an rc-1 traceback carrying the
   230	        # absolute checkout path. Enumerating exception types is
   231	        # the same shape as enumerating safe filenames, and it
   232	        # failed the same way three times.
   233	        #
   234	        # Anything that stops this scan leaves the pattern
   235	        # incomplete, and an incomplete pattern is an unverified
   236	        # scan, not a clean one (CLAUDE.md section 4: a GATE
   237	        # fails closed on input). The REASON, never `exc`: its
   238	        # str() carries an ABSOLUTE filename or the offending
   239	        # PATTERN, and on an operator machine both are a home
   240	        # path. The message names no path of its own either,
   241	        # because after this catch-all the failure is no longer
   242	        # necessarily the terms file.
   243	        if isinstance(exc, (OSError, UnicodeDecodeError, re.error)):
   244	            # Known INPUT failures of the terms file: keep the
   245	            # precision where there is precision to be had.
   246	            print(
   247	                "FATAL: cannot read %s: %s"
   248	                % (_PRIVATE_TERMS_RELPATH,
   249	                   _personal_path_safe(_oserror_reason(exc))),
   250	                file=sys.stderr,
   251	            )
   252	        else:
   253	            print(
   254	                "FATAL: the term scan did not complete: %s"
   255	                % _personal_path_safe(_oserror_reason(exc)),
   256	                file=sys.stderr,
   257	            )
   258	        return 2
   259	
   260	    rc_terms = 2 if term_fatal else _report_terms(violations, repo_root)
   261	    return max(rc_terms, rc_paths)
   262	
   263	
   264	def _report_terms(violations: List[Path], repo_root: Path) -> int:
   265	    """The term rule's report. NOT byte-identical to the pre-v4 output: paths go through `_personal_path_mask_rel`, the plan glob was corrected, and a Rule 2 note is appended (text lane, round 23, which found the old sentence still claiming otherwise). The SHAPE and the verdict are unchanged."""
   266	    if not violations:
   267	        print("✓ No contamination outside allowed zones")
   268	        return 0
   269	
   270	    print("❌ Contamination found in the following files:")
   271	    for v in violations:
   272	        rel = v.relative_to(repo_root)
   273	        print("  - %s" % _personal_path_mask_rel(rel.as_posix()))
   274	    print("")
   275	    print("Allowed zones:")
   276	    print("  - LICENSE")
   277	    print("  - CHANGELOG.md")
   278	    print("  - .claude/skills/domains/**")
   279	    print("  - .claude/plans/* (the WHOLE plan tree, recursively — "
   280	          "fnmatch `*` crosses `/`)")
   281	    print("      EXCEPT LEDGER.md / LEDGER-ARCHIVE.md at any depth under")
   282	    print("      .claude/plans/ — machine-appended, always scanned")
   283	    print("      (such a file is ALSO reported when it is not valid UTF-8:")
   284	    print("       unparseable input is blocked, not skipped)")
   285	    print("  - npm/** (NPM shim — uses owner handle in URLs)")
   286	    print("  - .github/workflows/validate.yml")
   287	    print("  - .github/CODEOWNERS (live config — Owner handle expected)")
   288	    print("  - .claude/scripts/check-contamination.sh")
