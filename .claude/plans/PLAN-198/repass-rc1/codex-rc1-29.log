   183	    malformed: List[int] = []
   184	    # ONE read, through the SAME no-follow helper the subject files go
   185	    # through. `is_file()` then `read_text()` was a check and a use of
   186	    # two different inodes: trackedness validated the name, and this
   187	    # re-opened it, so replacing the validated file with a symlink in
   188	    # the gap delivered a crafted untracked row to the waiver
   189	    # (pair-rail round 4, P1). A LINK is refused rather than followed,
   190	    # and a present-but-special inode is fatal, not "absent" -- the
   191	    # helper answers all three questions in one syscall.
   192	    blob = _personal_path_read_nofollow(path)
   193	    if blob is None:
   194	        # ABSENT, exactly as `is_file()` answered before: an allowlist
   195	        # that is not there waives nothing and is not an error. Every
   196	        # OTHER failure -- unreadable, undecodable, a special inode --
   197	        # PROPAGATES, because a file that exists and cannot be read
   198	        # WHOLE must not read as waiving nothing quietly.
   199	        return entries, malformed
   200	    if blob.is_symlink:
   201	        raise PersonalPathUnreadable(
   202	            "the allowlist is a SYMLINK; a link is a claim about "
   203	            "another file, not a reviewable waiver list")
   204	    seen_twice = set()
   205	    # `split("\n")`, NOT `splitlines()` -- the same cure, for the same
   206	    # reason, as `_personal_path_hit_lines` three hundred lines up.
   207	    # `splitlines()` breaks on a bare CR, `\v`, `\f`, `\x1c`-`\x1e`,
   208	    # U+2028 and U+2029; git counts LINES by LF. A tracked file holding
   209	    #     `# reviewed<CR>docs/leak.md | sha256:<64 hex> | reason`
   210	    # is ONE insertion in the diff a human reviews, and `splitlines()`
   211	    # read it as a comment PLUS a granted waiver -- reproduced, rc 0 with
   212	    # the leak waived (mechanism lane, round 13). A waiver a reviewer
   213	    # cannot see ends the only claim a waiver makes.
   214	    # Counted the way git counts, the whole physical line is one row, it
   215	    # starts with `#`, and there is no waiver to grant. A row carrying a
   216	    # stray separator inside it then fails `_PERSONAL_PATH_ROW_RE` and is
   217	    # MALFORMED by number, which is what ambiguous input gets here.
   218	    decoded = blob.raw.decode("utf-8")
   219	    # A control byte in a waiver list makes the row say one thing to
   220	    # this parser and another to whoever reads it, so the FILE is
   221	    # refused. Round 18 found it as a NUL: a row appended with a NUL
   222	    # inside its reason waived a real hit at rc 0 while the 320-row diff
   223	    # rendered as one binary line.
   224	    #
   225	    # What this comment used to add -- that ONE NUL inside git's first
   226	    # 8000 bytes makes `git diff` print `Binary files ... differ` for the
   227	    # WHOLE file -- is NOT a rule git has: an explicit `diff` attribute
   228	    # forces a text diff despite the NUL (round 21, B3; reproduced,
   229	    # numstat `-/-` becomes `2/0`). The claim is withdrawn here as it was
   230	    # withdrawn two hundred lines above, and the refusal stays for the
   231	    # harm that IS a property of the bytes: display.
   232	    #
   233	    # The refusal is over the FILE, not the row: the blindness is the
   234	    # file's, and a list whose other rows a reviewer cannot read either
   235	    # is not a list this rule may consult. It names the row NUMBER and
   236	    # the CODEPOINT -- never the content, which is the same discipline
   237	    # every other refusal in this parser keeps.
   238	    # An INTERIOR carriage return, which the class above deliberately does
   239	    # not carry. `\s*` in the row grammar CONSUMES it, so
   240	    # `<path> | sha256:<hex> | <CR># reviewed` reached the reason predicate
   241	    # as `# reviewed`, waived at rc 0, and git emitted the CR raw -- the
   242	    # row renders overwritten in the terminal that reviews it (text lane,
   243	    # round 20; reproduced). The predicate can only judge what the grammar
   244	    # hands it, so the question is asked HERE, where the physical row still
   245	    # exists. A row ENDING in CR is untouched: that is the CRLF checkout
   246	    # this parser has always accepted, and it is the only reason `\r` is
   247	    # outside the class above.
   248	    for rowno, raw in enumerate(decoded.split("\n"), 1):
   249	        if "\r" in raw.rstrip("\r"):
   250	            raise PersonalPathUnreadable(
   251	                "the allowlist carries a carriage return INSIDE row %d "
   252	                "(not as its line ending); git emits it raw and the row "
   253	                "renders overwritten, so NONE of the rows waives anything "
   254	                "(remove it, then re-run)" % rowno)
   255	    control = _PERSONAL_PATH_ALLOWLIST_CONTROL_RE.search(decoded)
   256	    if control is not None:
   257	        raise PersonalPathUnreadable(
   258	            "the allowlist carries the control character U+%04X on row "
   259	            "%d; a control character rewrites how the row DISPLAYS in "
   260	            "the terminal that renders it, so the row can say one thing "
   261	            "to this parser and another to its reader -- NONE of them "
   262	            "waives anything (remove the character, then re-run)"
   263	            % (ord(control.group(0)),
   264	               decoded.count("\n", 0, control.start()) + 1))
   265	    for rowno, raw in enumerate(decoded.split("\n"), 1):
   266	        line = raw.strip()
   267	        if not line:
   268	            continue
   269	        if line.startswith("#"):
   270	            # A COMMENT is not a waiver, and until round 10 that meant
   271	            # nothing read it at all: this file lives OUTSIDE both
   272	            # `_PERSONAL_PATH_SCOPE` prefixes, so the rule never scans
   273	            # it, and the parser skipped `#` lines before any predicate.
   274	            # `archived from /Users/<name>/...` written one line above
   275	            # the row it explains was therefore the one place in this
   276	            # repository where a home path was examined by NOTHING
   277	            # (mechanism lane, round 10, A-P2-2).
   278	            # Same refusal a ROW naming a home directory gets, for the
   279	            # same reason -- the waiver file is subject to the rule it
   280	            # waives -- and it is reported by ROW NUMBER, so the fix is
   281	            # the line the operator is already looking at. MEASURED on
   282	            # the shipped allowlist before choosing this: 76 comment
   283	            # lines, 0 of them malformed under this predicate.
   284	            if _personal_path_hit_either(line):
   285	                malformed.append(rowno)
   286	            continue
   287	        match = _PERSONAL_PATH_ROW_RE.match(line)
   288	        if match is None:
   289	            # Includes every row that carries no `sha256:<64 hex>` field:
   290	            # a v3-shaped row, a truncated digest, a digest with a
   291	            # non-hex character -- and, since the signer directive was
   292	            # deleted with the rule waiver it fed, a leftover
   293	            # `signer-fingerprint: <40 hex>` line from a v4.0 allowlist.
   294	            # A row the parser cannot read WHOLE waives nothing and says
   295	            # so (rc 1): an adopter upgrading is told which lines to
   296	            # delete rather than having them silently ignored.
   297	            malformed.append(rowno)
   298	            continue
   299	        rel = match.group(1)
   300	        sha = match.group(2).lower()
   301	        reason = match.group(3)
   302	        if (
   303	            reason == _PERSONAL_PATH_UNREASONED
   304	            # A reason a reviewer cannot SEE is not a written decision:
   305	            # zero-width and bidirectional characters satisfied `\S`
   306	            # (mechanism lane, round 19; reproduced, rc 0 with the leak
   307	            # waived). MALFORMED by number, like every other row this
   308	            # parser cannot read.
   309	            or not _personal_path_reason_is_visible(reason)
   310	            or rel.startswith("/")
   311	            or ".." in rel.split("/")
   312	            # A row that itself names a home directory would be printed back
   313	            # on a GREEN run (the reason is echoed grouped). Refused at the
   314	            # source, so no printer ever sees it: the waiver file is subject
   315	            # to the rule it waives, which is what makes it reviewable.
   316	            or _personal_path_hit_either(line)
   317	        ):
   318	            malformed.append(rowno)
   319	            continue
   320	        if rel in entries or rel in seen_twice:
   321	            malformed.append(rowno)
   322	            seen_twice.add(rel)
   323	            entries.pop(rel, None)
   324	            continue
   325	        entries[rel] = PersonalPathRow(
   326	            sha256=sha, reason=reason, rowno=rowno)
   327	    return entries, malformed
