   334	class PersonalPathBlob(NamedTuple):
   335	    """The bytes git stores for a tracked entry, and whether it is a link.
   336	
   337	    The link fact travels WITH the bytes because it is decided inside the
   338	    same `try` that read them. Asking the filesystem a second time is how
   339	    two pair-rail findings in a row were built (round cure-2, P1+P2): a
   340	    decision taken outside the boundary that is supposed to contain it.
   341	    """
   342	
   343	    raw: bytes
   344	    is_symlink: bool
