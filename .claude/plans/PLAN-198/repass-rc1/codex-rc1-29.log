     3	from typing import NamedTuple
     4	
     5	def _personal_path_option_near_miss(
     6	    parser: "argparse.ArgumentParser", token: str,
     7	) -> bool:
     8	    """True when ``token`` is a PREFIX of a long option this parser knows.
     9	
    10	    Derived from the parser rather than from a list written here: a list
    11	    of option names beside the options themselves is a second place to
    12	    forget, and the next flag added would quietly leave this check
    13	    behind. `_actions` is argparse's own registry of what it accepts.
    14	
    15	    `--` and `-` are excluded: the first is argparse's positional
    16	    separator and a prefix of literally every long option.
    17	    """
    18	    head = token.split("=", 1)[0]
    19	    if not head.startswith("--") or head in ("-", "--"):
    20	        return False
    21	    known = [opt for action in parser._actions
    22	             for opt in action.option_strings]
    23	    if head in known:
    24	        return False
    25	    return any(opt.startswith(head) for opt in known)
    26	
    27	
    28	def _parse_args(argv: Optional[List[str]]) -> "argparse.Namespace":
    29	    """CLI surface. No argument changes what the DEFAULT run enforces.
    30	
    31	    Raises ``PersonalPathUsage`` for a token that is a prefix of a real
    32	    option; `main` turns that into rc 2 with the token redacted, because
    33	    a stray argument can BE an absolute home path and argparse's own
    34	    usage error would print it verbatim.
    35	    """
    36	    # `allow_abbrev=False` (pair-rail land round 1, P2). argparse accepts a
    37	    # unique PREFIX of a long option by default, so `--emit-personal-path-row`
    38	    # — one character short, and a plausible typo — silently selected
    39	    # `--emit-personal-path-rows` and put the gate into its non-gating mode:
    40	    # rows on stdout, rc 0, no verdict. A security matcher must not have a
    41	    # spelling that turns it off, and abbreviation is a whole family of them.
    42	    parser = _PersonalPathParser(
    43	        prog="check_contamination.py", allow_abbrev=False,
    44	        description="Contamination gate: the term rule, plus the "
    45	                    "personal-path rule over docs/ and .claude/plans/.",
    46	    )
    47	    parser.add_argument(
    48	        "--root", default=None,
    49	        help="repository to scan (default: the checkout this file lives in)",
    50	    )
    51	    parser.add_argument(
    52	        "--personal-path-allowlist", default=None,
    53	        help="allowlist for the personal-path rule (default: %s under the "
    54	             "root). It must be a git-TRACKED file inside the root; "
    55	             "anything else is read as EMPTY and waives nothing"
    56	             % _PERSONAL_PATH_ALLOWLIST_REL,
    57	    )
    58	    parser.add_argument(
    59	        "--emit-personal-path-rows", action="store_true",
    60	        help="print an unreasoned allowlist row for every unwaived file; "
    61	             "exit 0, 1 when the allowlist holds MALFORMED rows, or 2 "
    62	             "when an input cannot be read (stdout stays rows-only in "
    63	             "every case). The emitted reason is refused by the parser",
    64	    )
    65	    parser.add_argument(
    66	        "--fail-on-stale", action="store_true",
    67	        help="also fail when an allowlist row matches no file. OFF by "
    68	             "default: the shipped allowlist names framework artifacts that "
    69	             "an adopter checkout legitimately does not have",
    70	    )
    71	    # `parse_known_args`, NOT `parse_args`: the module this rule joined ignored
    72	    # argv ENTIRELY, and the delivered wrapper `check-contamination.sh` execs
    73	    # it with "$@" — so a strict parser turns an argument that used to do
    74	    # nothing into an rc-2 CI failure in an adopter checkout this repo cannot
    75	    # grep. The tolerance is preserved; the SILENCE is not. An ignored token is
    76	    # NAMED on stderr, because `--fail-on-stalee` quietly doing nothing is how
    77	    # an operator reads a check that never ran as a check that passed. The exit
    78	    # code is unchanged — naming it is the whole cure.
    79	    args, unknown = parser.parse_known_args(argv)
    80	    # A token that is a PREFIX of a known option is the abbreviation
    81	    # argparse used to accept, and it is fail-CLOSED here rather than
    82	    # ignored: an operator who typed nine tenths of `--emit-personal-path-
    83	    # rows` MEANT that flag, and the tolerance above exists for arguments
    84	    # this module never had, not for near-misses on the ones it has. It
    85	    # is the same fail-closed reading the allowlist parser gives a row
    86	    # it cannot match WHOLE: MALFORMED and named, never a line skipped
    87	    # while the operator believes it took effect.
    88	    if args.emit_personal_path_rows and args.fail_on_stale:
    89	        # One asks for a VERDICT to be stricter, the other suppresses the
    90	        # verdict entirely. Accepted together, `--fail-on-stale` was
    91	        # silently ignored and the run returned 0 where it returned 1
    92	        # without the emit flag (pair-rail round 2, P2). Two flags whose
    93	        # combination has no honest meaning are a usage error, not a
    94	        # precedence rule for the operator to memorise.
    95	        raise PersonalPathUsage(
    96	            "--emit-personal-path-rows and --fail-on-stale contradict "
    97	            "each other: one prints rows instead of a verdict, the other "
    98	            "makes the verdict stricter")
    99	    near = [tok for tok in unknown
   100	            if _personal_path_option_near_miss(parser, tok)]
   101	    if near:
   102	        raise PersonalPathUsage(
   103	            "unrecognised argument(s) %s — each is a PREFIX of a real "
   104	            "option, which this gate refuses rather than guesses"
   105	            % " ".join(_personal_path_safe(tok) for tok in near))
   106	    if unknown:
   107	        # The rule applies to this line too. A token can BE an absolute home
   108	        # path (a stray positional, a mistyped `--root` value), and this NOTE
   109	        # lands in the same public log as the findings — so the module runs its
   110	        # own predicate over what it is about to echo. argparse-strict printed
   111	        # the raw token in its usage error; ignoring it in silence printed
   112	        # nothing at all. Naming it, redacted, is the only one of the three
   113	        # that is both visible and safe.
   114	        shown = [_personal_path_safe(tok) for tok in unknown]
   115	        print(
   116	            "NOTE: ignoring unrecognised argument(s): %s" % " ".join(shown),
   117	            file=sys.stderr,
   118	        )
   119	    # An EXPLICITLY EMPTY path option is a usage error, not "not
   120	    # given". Reading it by truthiness downstream silently selected the
   121	    # default: `--root ""` scanned the checkout this file lives in and
   122	    # returned green (pair-rail round 4, P1).
   123	    for flag, value in (("--root", args.root),
   124	                        ("--personal-path-allowlist",
   125	                         args.personal_path_allowlist)):
   126	        if value is not None and not str(value).strip():
   127	            raise PersonalPathUsage(_PERSONAL_PATH_EMPTY_OPTION % flag)
   128	    return args
   129	
