{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SuuK1PkJwAqScAKyS3SQh8","type":"tool_result","content":"1\t\"\"\"Guard for the KERNEL-DECOMPOSITION rows of ``_KERNEL_PATHS``.\n2\t\n3\tThe v1.4.4 train (merge 888e9e6c) moved the code of seven kernel facades\n4\tinto helper packages below ``_lib/``, and put ``_lib/plan_paths.py`` in\n5\tplace of the plan-path regexes it removed from ``check_plan_edit.py`` and\n6\t``policy_preprocessors.py``. Kernel files now call ``model_currency.py``\n7\t(the VETO-floor predicate) as part of their VETO-floor check. Kernel code\n8\talso calls ``cli_currency.py``, ``bash_indirect_guard.py`` and\n9\t``bash_indirect_telemetry.py``, each added by the train, and the kernel\n10\t``adapters/__init__.py`` loads the live-adapter package\n11\t``_lib/adapters/live`` (present since v1.0.0). ``_KERNEL_PATHS`` has a\n12\trow for each of these. This guard checks:\n13\t\n14\t1. For every package directory strictly below ``_lib/`` (a directory with\n15\t   an ``__init__.py``) that a kernel source reaches, every ``.py`` module\n16\t   in it, recursively, is kernel. A kernel source is a ``.py`` file under\n17\t   ``.claude/hooks`` or ``.claude/dispatcher``, outside any ``tests/``\n18\t   directory, that is itself kernel. It reaches a package by an import\n19\t   statement (lazy or top-level, absolute or relative) or by a run of\n20\t   string literals in a ``/`` chain that, joined to the source's directory\n21\t   or to ``.claude/hooks``, names the package directory\n22\t   (``<expr> / \"_lib\" / \"<pkg>\"``, the exec-by-path form). The packages\n23\t   are derived from the code on every run, so a package reached this way\n24\t   later needs its row before this test is green.\n25\t2. The detector still finds every package in ``_KNOWN_BACKING_PACKAGES``\n26\t   (positive control), so check 1 cannot pass by finding nothing.\n27\t3. Each module in ``_FLAT_KERNEL_BACKERS`` is kernel and is still imported\n28\t   by a kernel source.\n29\t\"\"\"\n30\tfrom __future__ import annotations\n31\t\n32\timport ast\n33\timport functools\n34\timport sys\n35\tfrom pathlib import Path\n36\tfrom typing import Dict, List, Optional, Set\n37\t\n38\tREPO_ROOT = Path(__file__).resolve().parents[3]\n39\t_HOOKS = REPO_ROOT / \".claude\" / \"hooks\"\n40\tif str(_HOOKS) not in sys.path:\n41\t    sys.path.insert(0, str(_HOOKS))\n42\t\n43\tfrom _lib.testing import TestEnvContext  # noqa: E402\n44\tfrom check_arbitration_kernel import _is_kernel_path  # noqa: E402\n45\t\n46\t# Trees that hold kernel Python sources.\n47\t_SCAN_TREES = (\".claude/hooks\", \".claude/dispatcher\")\n48\t_SKIP_PARTS = frozenset({\"tests\", \"__pycache__\"})\n49\t\n50\t# POSITIVE control: packages the detector must keep finding, or it has\n51\t# gone blind (green by vacuum). The seven of the v1.4.4 split, plus the\n52\t# live-adapter transport package.\n53\t_KNOWN_BACKING_PACKAGES = frozenset({\n54\t    \".claude/hooks/_lib/canonical_edit\",  # check_canonical_edit.py (import)\n55\t    \".claude/hooks/_lib/agent_spawn\",  # check_agent_spawn.py (import)\n56\t    \".claude/hooks/_lib/_policy_parts\",  # _lib/policy.py (import)\n57\t    \".claude/hooks/_lib/_audit_emit_parts\",  # _lib/audit_emit.py (import)\n58\t    \".claude/hooks/_lib/_pair_rail_parts\",  # check_pair_rail.py (import)\n59\t    \".claude/hooks/_lib/_audit_log_parts\",  # audit_log.py (exec by path)\n60\t    \".claude/hooks/_lib/_bash_safety_parts\",  # check_bash_safety.py (exec)\n61\t    \".claude/hooks/_lib/adapters/live\",  # adapters/__init__.py (lazy import)\n62\t})\n63\t\n64\t# These five flat modules each have their own row.\n65\t_FLAT_KERNEL_BACKERS = (\n66\t    \".claude/hooks/_lib/model_currency.py\",  # is_veto_floor_model()\n67\t    \".claude/hooks/_lib/cli_currency.py\",  # Codex payload-pin currency arm\n68\t    \".claude/hooks/_lib/plan_paths.py\",  # is_plan_path(), plan_id_from_path()\n69\t    \".claude/hooks/_lib/bash_indirect_guard.py\",  # indirect-command matcher\n70\t    \".claude/hooks/_lib/bash_indirect_telemetry.py\",  # disabled-rail record\n71\t)\n72\t\n73\t\n74\tdef _rel(path: Path, root: Path) -> str:\n75\t    return path.relative_to(root).as_posix()\n76\t\n77\t\n78\tdef _sources(root: Path) -> List[Path]:\n79\t    out: List[Path] = []\n80\t    for tree in _SCAN_TREES:\n81\t        base = root / tree\n82\t        if not base.is_dir():\n83\t            continue\n84\t        for path in sorted(base.rglob(\"*.py\")):\n85\t            if not _SKIP_PARTS.intersection(path.relative_to(base).parts[:-1]):\n86\t                out.append(path)\n87\t    return out\n88\t\n89\t\n90\tdef _resolve(dotted: str, base: Path) -> List[Path]:\n91\t    \"\"\"Files executed by importing ``dotted`` from ``base`` (package inits too).\"\"\"\n92\t    found: List[Path] = []\n93\t    cur = base\n94\t    parts = dotted.split(\".\")\n95\t    for index, part in enumerate(parts):\n96\t        if (cur / part / \"__init__.py\").is_file():\n97\t            cur = cur / part\n98\t            found.append(cur / \"__init__.py\")\n99\t        elif index == len(parts) - 1 and (cur / (part + \".py\")).is_file():\n100\t            found.append(cur / (part + \".py\"))\n101\t        else:\n102\t            return []\n103\t    return found\n104\t\n105\t\n106\tdef _import_targets(tree: ast.AST, path: Path, hooks: Path) -> Set[Path]:\n107\t    package: Optional[List[str]] = None\n108\t    if hooks in path.parents:\n109\t        package = list(path.parent.relative_to(hooks).parts)\n110\t    out: Set[Path] = set()\n111\t    for node in ast.walk(tree):\n112\t        names: List[str] = []\n113\t        bases = (hooks, path.parent)\n114\t        if isinstance(node, ast.Import):\n115\t            names = [alias.name for alias in node.names]\n116\t        elif isinstance(node, ast.ImportFrom):\n117\t            module = node.module or \"\"\n118\t            if node.level:\n119\t                if package is None or node.level - 1 > len(package):\n120\t                    continue\n121\t                head = package[: len(package) - (node.level - 1)]\n122\t                module = \".\".join(head + ([module] if module else []))\n123\t                bases = (hooks,)\n124\t            if module:\n125\t                names = [module] + [module + \".\" + a.name for a in node.names]\n126\t        for name in names:\n127\t            for base in bases:\n128\t                hit = _resolve(name, base)\n129\t                if hit:\n130\t                    out.update(hit)\n131\t                    break\n132\t    return out\n133\t\n134\t\n135\tdef _path_runs(node: ast.BinOp) -> List[List[str]]:\n136\t    \"\"\"Maximal runs of string operands in an ``a / \"x\" / \"y\"`` chain.\"\"\"\n137\t    items: List[Optional[str]] = []\n138\t    cur: ast.AST = node\n139\t    while isinstance(cur, ast.BinOp) and isinstance(cur.op, ast.Div):\n140\t        right = cur.right\n141\t        is_str = isinstance(right, ast.Constant) and isinstance(right.value, str)\n142\t        items.insert(0, right.value if is_str else None)\n143\t        cur = cur.left\n144\t    runs: List[List[str]] = [[]]\n145\t    for item in items:\n146\t        if item is None:\n147\t            runs.append([])\n148\t        else:\n149\t            runs[-1].extend(seg for seg in item.split(\"/\") if seg)\n150\t    return [run for run in runs if run]\n151\t\n152\t\n153\tdef _backing_packages(root: Path) -> Dict[str, Set[str]]:\n154\t    \"\"\"``{package dir below _lib: {kernel sources that reach it}}``.\"\"\"\n155\t    hooks = root / \".claude\" / \"hooks\"\n156\t    lib = hooks / \"_lib\"\n157\t    backing: Dict[str, Set[str]] = {}\n158\t    for path in _sources(root):\n159\t        if not _is_kernel_path(str(path), root):\n160\t            continue\n161\t        tree = ast.parse(path.read_text(encoding=\"utf-8\"), str(path))\n162\t        dirs = {target.parent for target in _import_targets(tree, path, hooks)}\n163\t        for node in ast.walk(tree):\n164\t            if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):\n165\t                for run in _path_runs(node):\n166\t                    dirs.update((path.parent.joinpath(*run), hooks.joinpath(*run)))\n167\t        for directory in dirs:\n168\t            if lib in directory.parents and (directory / \"__init__.py\").is_file():\n169\t                backing.setdefault(_rel(directory, root), set()).add(_rel(path, root))\n170\t    return backing\n171\t\n172\t\n173\tdef _members(root: Path, package: str) -> List[Path]:\n174\t    \"\"\"Python modules of a package, recursively (data files are not code).\"\"\"\n175\t    return [\n176\t        p for p in sorted((root / package).rglob(\"*.py\"))\n177\t        if \"__pycache__\" not in p.parts\n178\t    ]\n179\t\n180\t\n181\tdef _uncovered(root: Path, backing: Dict[str, Set[str]]) -> List[str]:\n182\t    out: List[str] = []\n183\t    for package in sorted(backing):\n184\t        for member in _members(root, package):\n185\t            rel = _rel(member, root)\n186\t            if not _is_kernel_path(str(member), root):\n187\t                out.append(\"%s  (reached from %s)\" % (\n188\t                    rel, \", \".join(sorted(backing[package]))))\n189\t    return out\n190\t\n191\t\n192\t@functools.lru_cache(maxsize=1)\n193\tdef _real_backing() -> Dict[str, Set[str]]:\n194\t    return _backing_packages(REPO_ROOT)\n195\t\n196\t\n197\tclass KernelDecompositionCoverageTest(TestEnvContext):\n198\t\n199\t    def test_known_backing_packages_are_still_detected(self) -> None:\n200\t        missing = sorted(_KNOWN_BACKING_PACKAGES - set(_real_backing()))\n201\t        self.assertEqual(missing, [], \"detector lost a known backing package \"\n202\t                         \"(a guard that finds nothing passes by vacuum)\")\n203\t\n204\t    def test_every_backing_package_is_kernel_in_full(self) -> None:\n205\t        uncovered = _uncovered(REPO_ROOT, _real_backing())\n206\t        self.assertEqual(uncovered, [], \"\\n\".join(\n207\t            [\"kernel code lives in files the kernel rail does not guard; add \"\n208\t             \"'<pkg>/**/*' to _KERNEL_PATHS:\"]\n209\t            + uncovered))\n210\t\n211\t    def test_flat_kernel_backers_are_kernel_and_still_imported(self) -> None:\n212\t        importers: Set[str] = set()\n213\t        hooks = REPO_ROOT / \".claude\" / \"hooks\"\n214\t        for path in _sources(REPO_ROOT):\n215\t            if _is_kernel_path(str(path), REPO_ROOT):\n216\t                tree = ast.parse(path.read_text(encoding=\"utf-8\"), str(path))\n217\t                importers.update(_rel(t, REPO_ROOT)\n218\t                                 for t in _import_targets(tree, path, hooks))\n219\t        for rel in _FLAT_KERNEL_BACKERS:\n220\t            with self.subTest(module=rel):\n221\t                self.assertTrue(_is_kernel_path(str(REPO_ROOT / rel), REPO_ROOT))\n222\t                self.assertIn(rel, importers, \"no kernel source imports it \"\n223\t                              \"any more; revisit its _KERNEL_PATHS row and \"\n224\t                              \"_FLAT_KERNEL_BACKERS\")\n225\t\n226\t    def test_detector_catches_import_and_exec_forms(self) -> None:\n227\t        # Synthetic tree: a kernel-named facade reaching one package by\n228\t        # import and one by exec-by-path; neither package has a kernel row.\n229\t        root = self.project_dir\n230\t        self.write_project_file(\".claude/hooks/check_canonical_edit.py\", (\n231\t            \"from pathlib import Path\\n\"\n232\t            \"def _late():\\n\"\n233\t            \"    from _lib.fake_pkg import mod  # lazy import form\\n\"\n234\t            \"_PARTS = Path(__file__).resolve().parent / '_lib' / 'fake_exec'\\n\"\n235\t        ))\n236\t        for rel in (\"_lib/__init__.py\", \"_lib/fake_pkg/__init__.py\",\n237\t                    \"_lib/fake_pkg/mod.py\", \"_lib/fake_exec/__init__.py\",\n238\t                    \"_lib/fake_exec/part.py\", \"_lib/unrelated/__init__.py\"):\n239\t            self.write_project_file(\".claude/hooks/\" + rel, \"X = 1\\n\")\n240\t        backing = _backing_packages(root)\n241\t        self.assertEqual(sorted(backing), [\".claude/hooks/_lib/fake_exec\",\n242\t                                           \".claude/hooks/_lib/fake_pkg\"])\n243\t        uncovered = [line.split()[0] for line in _uncovered(root, backing)]\n244\t        self.assertEqual(uncovered, [\n245\t            \".claude/hooks/_lib/fake_exec/__init__.py\",\n246\t            \".claude/hooks/_lib/fake_exec/part.py\",\n247\t            \".claude/hooks/_lib/fake_pkg/__init__.py\",\n248\t            \".claude/hooks/_lib/fake_pkg/mod.py\",\n249\t        ])\n250\t\n251\t\n252\tif __name__ == \"__main__\":  # pragma: no cover\n253\t    import unittest\n254\t\n255\t    unittest.main()\n256\t"}]},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"627d7fe8-5ed3-4c69-bb05-d7c55b457b73","timestamp":"2026-11-13T17:54:25.664Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/tests/test_kernel_decomposition_coverage.py","content":"\"\"\"Guard for the KERNEL-DECOMPOSITION rows of ``_KERNEL_PATHS``.\n\nThe v1.4.4 train (merge 888e9e6c) moved the code of seven kernel facades\ninto helper packages below ``_lib/``, and put ``_lib/plan_paths.py`` in\nplace of the plan-path regexes it removed from ``check_plan_edit.py`` and\n``policy_preprocessors.py``. Kernel files now call ``model_currency.py``\n(the VETO-floor predicate) as part of their VETO-floor check. Kernel code\nalso calls ``cli_currency.py``, ``bash_indirect_guard.py`` and\n``bash_indirect_telemetry.py``, each added by the train, and the kernel\n``adapters/__init__.py`` loads the live-adapter package\n``_lib/adapters/live`` (present since v1.0.0). ``_KERNEL_PATHS`` has a\nrow for each of these. This guard checks:\n\n1. For every package directory strictly below ``_lib/`` (a directory with\n   an ``__init__.py``) that a kernel source reaches, every ``.py`` module\n   in it, recursively, is kernel. A kernel source is a ``.py`` file under\n   ``.claude/hooks`` or ``.claude/dispatcher``, outside any ``tests/``\n   directory, that is itself kernel. It reaches a package by an import\n   statement (lazy or top-level, absolute or relative) or by a run of\n   string literals in a ``/`` chain that, joined to the source's directory\n   or to ``.claude/hooks``, names the package directory\n   (``<expr> / \"_lib\" / \"<pkg>\"``, the exec-by-path form). The packages\n   are derived from the code on every run, so a package reached this way\n   later needs its row before this test is green.\n2. The detector still finds every package in ``_KNOWN_BACKING_PACKAGES``\n   (positive control), so check 1 cannot pass by finding nothing.\n3. Each module in ``_FLAT_KERNEL_BACKERS`` is kernel and is still imported\n   by a kernel source.\n\"\"\"\nfrom __future__ import annotations\n\nimport ast\nimport functools\nimport sys\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Set\n\nREPO_ROOT = Path(__file__).resolve().parents[3]\n_HOOKS = REPO_ROOT / \".claude\" / \"hooks\"\nif str(_HOOKS) not in sys.path:\n    sys.path.insert(0, str(_HOOKS))\n\nfrom _lib.testing import TestEnvContext  # noqa: E402\nfrom check_arbitration_kernel import _is_kernel_path  # noqa: E402\n\n# Trees that hold kernel Python sources.\n_SCAN_TREES = (\".claude/hooks\", \".claude/dispatcher\")\n_SKIP_PARTS = frozenset({\"tests\", \"__pycache__\"})\n\n# POSITIVE control: packages the detector must keep finding, or it has\n# gone blind (green by vacuum). The seven of the v1.4.4 split, plus the\n# live-adapter transport package.\n_KNOWN_BACKING_PACKAGES = frozenset({\n    \".claude/hooks/_lib/canonical_edit\",  # check_canonical_edit.py (import)\n    \".claude/hooks/_lib/agent_spawn\",  # check_agent_spawn.py (import)\n    \".claude/hooks/_lib/_policy_parts\",  # _lib/policy.py (import)\n    \".claude/hooks/_lib/_audit_emit_parts\",  # _lib/audit_emit.py (import)\n    \".claude/hooks/_lib/_pair_rail_parts\",  # check_pair_rail.py (import)\n    \".claude/hooks/_lib/_audit_log_parts\",  # audit_log.py (exec by path)\n    \".claude/hooks/_lib/_bash_safety_parts\",  # check_bash_safety.py (exec)\n    \".claude/hooks/_lib/adapters/live\",  # adapters/__init__.py (lazy import)\n})\n\n# These five flat modules each have their own row.\n_FLAT_KERNEL_BACKERS = (\n    \".claude/hooks/_lib/model_currency.py\",  # is_veto_floor_model()\n    \".claude/hooks/_lib/cli_currency.py\",  # Codex payload-pin currency arm\n    \".claude/hooks/_lib/plan_paths.py\",  # is_plan_path(), plan_id_from_path()\n    \".claude/hooks/_lib/bash_indirect_guard.py\",  # indirect-command matcher\n    \".claude/hooks/_lib/bash_indirect_telemetry.py\",  # disabled-rail record\n)\n\n\ndef _rel(path: Path, root: Path) -> str:\n    return path.relative_to(root).as_posix()\n\n\ndef _sources(root: Path) -> List[Path]:\n    out: List[Path] = []\n    for tree in _SCAN_TREES:\n        base = root / tree\n        if not base.is_dir():\n            continue\n        for path in sorted(base.rglob(\"*.py\")):\n            if not _SKIP_PARTS.intersection(path.relative_to(base).parts[:-1]):\n                out.append(path)\n    return out\n\n\ndef _resolve(dotted: str, base: Path) -> List[Path]:\n    \"\"\"Files executed by importing ``dotted`` from ``base`` (package inits too).\"\"\"\n    found: List[Path] = []\n    cur = base\n    parts = dotted.split(\".\")\n    for index, part in enumerate(parts):\n        if (cur / part / \"__init__.py\").is_file():\n            cur = cur / part\n            found.append(cur / \"__init__.py\")\n        elif index == len(parts) - 1 and (cur / (part + \".py\")).is_file():\n            found.append(cur / (part + \".py\"))\n        else:\n            return []\n    return found\n\n\ndef _import_targets(tree: ast.AST, path: Path, hooks: Path) -> Set[Path]:\n    package: Optional[List[str]] = None\n    if hooks in path.parents:\n        package = list(path.parent.relative_to(hooks).parts)\n    out: Set[Path] = set()\n    for node in ast.walk(tree):\n        names: List[str] = []\n        bases = (hooks, path.parent)\n        if isinstance(node, ast.Import):\n            names = [alias.name for alias in node.names]\n        elif isinstance(node, ast.ImportFrom):\n            module = node.module or \"\"\n            if node.level:\n                if package is None or node.level - 1 > len(package):\n                    continue\n                head = package[: len(package) - (node.level - 1)]\n                module = \".\".join(head + ([module] if module else []))\n                bases = (hooks,)\n            if module:\n                names = [module] + [module + \".\" + a.name for a in node.names]\n        for name in names:\n            for base in bases:\n                hit = _resolve(name, base)\n                if hit:\n                    out.update(hit)\n                    break\n    return out\n\n\ndef _path_runs(node: ast.BinOp) -> List[List[str]]:\n    \"\"\"Maximal runs of string operands in an ``a / \"x\" / \"y\"`` chain.\"\"\"\n    items: List[Optional[str]] = []\n    cur: ast.AST = node\n    while isinstance(cur, ast.BinOp) and isinstance(cur.op, ast.Div):\n        right = cur.right\n        is_str = isinstance(right, ast.Constant) and isinstance(right.value, str)\n        items.insert(0, right.value if is_str else None)\n        cur = cur.left\n    runs: List[List[str]] = [[]]\n    for item in items:\n        if item is None:\n            runs.append([])\n        else:\n            runs[-1].extend(seg for seg in item.split(\"/\") if seg)\n    return [run for run in runs if run]\n\n\ndef _backing_packages(root: Path) -> Dict[str, Set[str]]:\n    \"\"\"``{package dir below _lib: {kernel sources that reach it}}``.\"\"\"\n    hooks = root / \".claude\" / \"hooks\"\n    lib = hooks / \"_lib\"\n    backing: Dict[str, Set[str]] = {}\n    for path in _sources(root):\n        if not _is_kernel_path(str(path), root):\n            continue\n        tree = ast.parse(path.read_text(encoding=\"utf-8\"), str(path))\n        dirs = {target.parent for target in _import_targets(tree, path, hooks)}\n        for node in ast.walk(tree):\n            if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):\n                for run in _path_runs(node):\n                    dirs.update((path.parent.joinpath(*run), hooks.joinpath(*run)))\n        for directory in dirs:\n            if lib in directory.parents and (directory / \"__init__.py\").is_file():\n                backing.setdefault(_rel(directory, root), set()).add(_rel(path, root))\n    return backing\n\n\ndef _members(root: Path, package: str) -> List[Path]:\n    \"\"\"Python modules of a package, recursively (data files are not code).\"\"\"\n    return [\n        p for p in sorted((root / package).rglob(\"*.py\"))\n        if \"__pycache__\" not in p.parts\n    ]\n\n\ndef _uncovered(root: Path, backing: Dict[str, Set[str]]) -> List[str]:\n    out: List[str] = []\n    for package in sorted(backing):\n        for member in _members(root, package):\n            rel = _rel(member, root)\n            if not _is_kernel_path(str(member), root):\n                out.append(\"%s  (reached from %s)\" % (\n                    rel, \", \".join(sorted(backing[package]))))\n    return out\n\n\n@functools.lru_cache(maxsize=1)\ndef _real_backing() -> Dict[str, Set[str]]:\n    return _backing_packages(REPO_ROOT)\n\n\nclass KernelDecompositionCoverageTest(TestEnvContext):\n\n    def test_known_backing_packages_are_still_detected(self) -> None:\n        missing = sorted(_KNOWN_BACKING_PACKAGES - set(_real_backing()))\n        self.assertEqual(missing, [], \"detector lost a known backing package \"\n                         \"(a guard that finds nothing passes by vacuum)\")\n\n    def test_every_backing_package_is_kernel_in_full(self) -> None:\n        uncovered = _uncovered(REPO_ROOT, _real_backing())\n        self.assertEqual(uncovered, [], \"\\n\".join(\n            [\"kernel code lives in files the kernel rail does not guard; add \"\n             \"'<pkg>/**/*' to _KERNEL_PATHS:\"]\n            + uncovered))\n\n    def test_flat_kernel_backers_are_kernel_and_still_imported(self) -> None:\n        importers: Set[str] = set()\n        hooks = REPO_ROOT / \".claude\" / \"hooks\"\n        for path in _sources(REPO_ROOT):\n            if _is_kernel_path(str(path), REPO_ROOT):\n                tree = ast.parse(path.read_text(encoding=\"utf-8\"), str(path))\n                importers.update(_rel(t, REPO_ROOT)\n                                 for t in _import_targets(tree, path, hooks))\n        for rel in _FLAT_KERNEL_BACKERS:\n            with self.subTest(module=rel):\n                self.assertTrue(_is_kernel_path(str(REPO_ROOT / rel), REPO_ROOT))\n                self.assertIn(rel, importers, \"no kernel source imports it \"\n                              \"any more; revisit its _KERNEL_PATHS row and \"\n                              \"_FLAT_KERNEL_BACKERS\")\n\n    def test_detector_catches_import_and_exec_forms(self) -> None:\n        # Synthetic tree: a kernel-named facade reaching one package by\n        # import and one by exec-by-path; neither package has a kernel row.\n        root = self.project_dir\n        self.write_project_file(\".claude/hooks/check_canonical_edit.py\", (\n            \"from pathlib import Path\\n\"\n            \"def _late():\\n\"\n            \"    from _lib.fake_pkg import mod  # lazy import form\\n\"\n            \"_PARTS = Path(__file__).resolve().parent / '_lib' / 'fake_exec'\\n\"\n        ))\n        for rel in (\"_lib/__init__.py\", \"_lib/fake_pkg/__init__.py\",\n                    \"_lib/fake_pkg/mod.py\", \"_lib/fake_exec/__init__.py\",\n                    \"_lib/fake_exec/part.py\", \"_lib/unrelated/__init__.py\"):\n            self.write_project_file(\".claude/hooks/\" + rel, \"X = 1\\n\")\n        backing = _backing_packages(root)\n        self.assertEqual(sorted(backing), [\".claude/hooks/_lib/fake_exec\",\n                                           \".claude/hooks/_lib/fake_pkg\"])\n        uncovered = [line.split()[0] for line in _uncovered(root, backing)]\n        self.assertEqual(uncovered, [\n            \".claude/hooks/_lib/fake_exec/__init__.py\",\n            \".claude/hooks/_lib/fake_exec/part.py\",\n            \".claude/hooks/_lib/fake_pkg/__init__.py\",\n            \".claude/hooks/_lib/fake_pkg/mod.py\",\n        ])\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    import unittest\n\n    unittest.main()\n","numLines":256,"startLine":1,"totalLines":256}},"tool_result_meta":[{"id":"toolu_01SuuK1PkJwAqScAKyS3SQh8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
