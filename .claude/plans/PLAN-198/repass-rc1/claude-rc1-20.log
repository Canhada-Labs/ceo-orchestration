{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EJ8tF3KQfW8Gs6B8rJ46A5","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport re\n4\t\n5\t__all__ = ('_strip_fenced_and_comments', '_has_skill_content', '_has_skill_content_sanitized', 'ENABLE_NATIVE_SUBAGENTS', 'ENABLE_SKILL_REFERENCE_MODE', '_SKILL_REFERENCE_HEADER_RE', '_SKILL_REFERENCE_LINE_RE', '_SKILL_REFERENCE_MAX_BYTES', '_SKILL_REFERENCE_MIN_BODY_BYTES', 'REASON_REFERENCE_MISSING', 'REASON_REFERENCE_UNSAFE_PATH', 'REASON_REFERENCE_HASH_MISMATCH', 'REASON_REFERENCE_SYMLINK_REFUSED', 'REASON_REFERENCE_TOO_LARGE', 'REASON_REFERENCE_REDACTION_HIT', 'REASON_REFERENCE_WRONG_FILENAME', 'REASON_REFERENCE_MISSING_FRONTMATTER', 'REASON_REFERENCE_BYTE_FLOOR_UNDERFLOW', 'REASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH', 'REASON_REFERENCE_OUTSIDE_SKILLS_ROOT', 'REASON_MISSING_SKILL_CONTENT', '_SECRET_TOKENS_IN_OUTPUT', '_EFFORT_TOKEN_RE', '_has_effort_token', '_SPAWN_SECRET_PATTERNS', '_inject_terse_marker', '_validate_spawn_prompt_has_no_secrets', '_ARCHITECT_NAME_RE', '_TOOL_ALLOWLIST_HEADER_RE', '_TOOL_BULLET_RE', '_KNOWN_TOOL_NAMES', '_TOOL_REQUEST_HINTS', '_TOOL_SCAN_WINDOW', '_SUBAGENT_DEPTH_MARKER_RE', '_FILE_ASSIGNMENT_HEADER_RE', '_CAN_EDIT_LINE_RE', '_FA_LIST_LINE_RE', '_FA_ALLOWED_GRANT_LINE_RE', '_FA_ALLOWED_PROSE_LINE_RE', '_FA_AUTHORITY_WORDS', '_OVERLAP_MAX_PATHS', '_OVERLAP_TAIL_LINES', '_FA_READONLY_TOKEN', '_FA_FENCE_RE', '_PROMPT_DEFENSE_HEADER_RE', '_PROMPT_DEFENSE_BULLET_RE', '_PROMPT_DEFENSE_MIN_BULLETS', '_PROMPT_DEFENSE_SCAN_CAP', '_UNTRUSTED_CONTENT_HINTS', '_prompt_defense_required', '_has_prompt_defense_block', '_emit_prompt_defense_event', '_enforce_prompt_defense')\n6\t\n7\tdef _strip_fenced_and_comments(text: str) -> str:\n8\t    \"\"\"Return a version of ``text`` with HTML comments removed and\n9\t    fenced-code-block content masked so marker/body searches cannot\n10\t    match inside them (P1-SEC-B bypass hardening).\"\"\"\n11\t    stripped = _HTML_COMMENT_RE.sub(\"\", text)\n12\t    out_parts = []\n13\t    in_fence = False\n14\t    for line in stripped.splitlines(keepends=True):\n15\t        if _CODE_FENCE_RE.match(line):\n16\t            in_fence = not in_fence\n17\t            out_parts.append(line)\n18\t            continue\n19\t        if in_fence:\n20\t            out_parts.append(\"\".join(\n21\t                \"\\n\" if c == \"\\n\" else \" \" for c in line\n22\t            ))\n23\t        else:\n24\t            out_parts.append(line)\n25\t    return \"\".join(out_parts)\n26\t\n27\t\n28\tdef _has_skill_content(prompt: str) -> bool:\n29\t    \"\"\"True iff ``prompt`` contains a real `## SKILL CONTENT` section.\n30\t\n31\t    Enforces four bypass-resistant checks (P1-SEC-B):\n32\t    1. Marker on own line (not inline narrative).\n33\t    2. Marker NOT inside HTML comment.\n34\t    3. Marker NOT inside fenced code block.\n35\t    4. >=_SKILL_CONTENT_MIN_BYTES non-ws bytes between marker and next ##.\n36\t    \"\"\"\n37\t    if not prompt:\n38\t        return False\n39\t    return _has_skill_content_sanitized(_strip_fenced_and_comments(prompt))\n40\t\n41\t\n42\tdef _has_skill_content_sanitized(sanitized: str) -> bool:\n43\t    \"\"\"Shared ``## SKILL CONTENT`` check against already-sanitized text.\n44\t\n45\t    PLAN-023 Phase F (F-perf-003) — split out so ``decide`` and other\n46\t    callers can share a single ``_strip_fenced_and_comments`` pass\n47\t    rather than re-stripping inside each sub-check.\n48\t    \"\"\"\n49\t    match = _SKILL_CONTENT_MARKER_RE.search(sanitized)\n50\t    if match is None:\n51\t        return False\n52\t    body_start = match.end()\n53\t    next_heading = _NEXT_H2_RE.search(sanitized, body_start)\n54\t    body_end = next_heading.start() if next_heading else len(sanitized)\n55\t    body = sanitized[body_start:body_end]\n56\t    non_ws_bytes = sum(1 for c in body if not c.isspace())\n57\t    return non_ws_bytes >= _SKILL_CONTENT_MIN_BYTES\n58\t\n59\t\n60\t# =============================================================================\n61\t# PLAN-020 Phase 2 — `## SKILL REFERENCE` additive sentinel (ADR-051)\n62\t# =============================================================================\n63\t#\n64\t# Parallel accept-path. Does NOT replace `_has_skill_content`. Hardened\n65\t# against 14 attack classes documented in ADR-051 §Threat model.\n66\t#\n67\t# Hook recognition order in decide():\n68\t#   1. If prompt has `## SKILL REFERENCE` → strict validation, fail-CLOSED.\n69\t#   2. Else if prompt has `## SKILL CONTENT` → inline path (existing P1-SEC-B).\n70\t#   3. Else block with the legacy `missing_skill_content` reason.\n71\t\n72\t# Module-level toggles (Phase revert = single-line flip to False).\n73\tENABLE_NATIVE_SUBAGENTS = True\n74\tENABLE_SKILL_REFERENCE_MODE = True\n75\t\n76\t# Reference sentinel header — must be on own line, not inside fences.\n77\t_SKILL_REFERENCE_HEADER_RE = re.compile(\n78\t    r\"^##[ \\t]+SKILL[ \\t]+REFERENCE[ \\t]*$\",\n79\t    flags=re.MULTILINE,\n80\t)\n81\t\n82\t# Reference body line: `@<path> sha256=<64-hex>`. Path may be relative.\n83\t_SKILL_REFERENCE_LINE_RE = re.compile(\n84\t    r\"^@(?P<path>\\S+)[ \\t]+sha256=(?P<hash>[0-9a-f]{64})\\b\",\n85\t    flags=re.MULTILINE,\n86\t)\n87\t\n88\t# Caps + thresholds (ADR-051 §Synchronous validation).\n89\t_SKILL_REFERENCE_MAX_BYTES = 1_048_576  # 1 MiB DoS cap\n90\t_SKILL_REFERENCE_MIN_BODY_BYTES = 512   # distinct from inline 256 floor\n91\t\n92\t# 12 telemetry reason codes (ADR-051 §Telemetry reason codes).\n93\tREASON_REFERENCE_MISSING = \"reference_missing\"\n94\tREASON_REFERENCE_UNSAFE_PATH = \"reference_unsafe_path\"\n95\tREASON_REFERENCE_HASH_MISMATCH = \"reference_hash_mismatch\"\n96\tREASON_REFERENCE_SYMLINK_REFUSED = \"reference_symlink_refused\"\n97\tREASON_REFERENCE_TOO_LARGE = \"reference_too_large\"\n98\tREASON_REFERENCE_REDACTION_HIT = \"reference_redaction_hit\"\n99\tREASON_REFERENCE_WRONG_FILENAME = \"reference_wrong_filename\"\n100\tREASON_REFERENCE_MISSING_FRONTMATTER = \"reference_missing_frontmatter\"\n101\tREASON_REFERENCE_BYTE_FLOOR_UNDERFLOW = \"reference_byte_floor_underflow\"\n102\tREASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH = (\n103\t    \"reference_unicode_normalization_mismatch\"\n104\t)\n105\tREASON_REFERENCE_OUTSIDE_SKILLS_ROOT = \"reference_outside_skills_root\"\n106\tREASON_MISSING_SKILL_CONTENT = \"missing_skill_content\"  # legacy/inline\n107\t\n108\t# Session 32 BUGFIX — _lib.redact.redact_secrets whitespace-collapses\n109\t# always; equality check with original text is not a valid \"secret\n110\t# detected\" signal. Instead we look for specific replacement tokens\n111\t# that `_redact._PATTERNS` inserts when a secret matches.\n112\t_SECRET_TOKENS_IN_OUTPUT = frozenset({\n113\t    \"[JWT]\",\n114\t    \"[API_KEY]\",\n115\t    \"[GITHUB_PAT]\",\n116\t    \"[AWS_KEY]\",\n117\t    \"[TOKEN]\",\n118\t    \"[URL_WITH_CREDS]\",\n119\t    \"[HEX_SECRET]\",\n120\t    \"[REDACTED]\",\n121\t    \"[SLACK_BOT]\",\n122\t    \"[STRIPE_KEY]\",\n123\t    \"[GOOGLE_REFRESH]\",\n124\t    # PLAN-024 F-hooks-001 P0 fix: redact.py replaces the PEM header\n125\t    # with \"[SSH_PRIVATE_KEY_HEADER]\" — matching raw \"-----BEGIN\" will\n126\t    # never fire after redaction. Check the replacement token instead.\n127\t    \"[SSH_PRIVATE_KEY_HEADER]\",\n128\t})\n129\t\n130\t\n131\t# =============================================================================\n132\t# PLAN-020 Phase 3 — `/effort` token rejection in spawn prompts\n133\t# =============================================================================\n134\t#\n135\t# `/effort` hints (low/default/high/max + `ultrathink` keyword) are\n136\t# CEO-only. They MUST NOT appear in spawn prompts (sub-agents inherit\n137\t# their thinking budget from Anthropic defaults). PLAN-020 §4 Phase 3\n138\t# §scope clause (QA must-fix #7).\n139\t\n140\t_EFFORT_TOKEN_RE = re.compile(\n141\t    r\"(?:^|[^\\w/])/effort(?:[ \\t]+(?:low|default|high|max))?\\b\",\n142\t    flags=re.IGNORECASE,\n143\t)\n144\t\n145\t\n146\tdef _has_effort_token(prompt: str) -> bool:\n147\t    \"\"\"True iff prompt contains a `/effort [tier]` slash-command token.\"\"\"\n148\t    if not prompt:\n149\t        return False\n150\t    sanitized = _strip_fenced_and_comments(prompt)\n151\t    return bool(_EFFORT_TOKEN_RE.search(sanitized))\n152\t\n153\t\n154\t# ---------------------------------------------------------------------------\n155\t# PLAN-045 F-10-04 — spawn-prompt secret-scan pre-dispatch\n156\t# ---------------------------------------------------------------------------\n157\t# Spawn prompts are the #1 vector for accidentally shipping secrets into a\n158\t# sub-agent's context. A CEO that copy-pastes a `.env` into a task prompt\n159\t# or builds a prompt that interpolates an env var leaks the secret to\n160\t# whatever model the sub-agent uses AND to the audit log (spawn prompts\n161\t# are recorded for governance).\n162\t#\n163\t# Reject spawns whose prompt contains any of 6 high-signal secret shapes.\n164\t# Each shape is a narrow regex to avoid false-positives on docs / test\n165\t# fixtures (prefix-bound + entropy-adjacent). Audit emits\n166\t# `veto_triggered(reason_code=spawn_prompt_contains_secret)` on reject.\n167\t#\n168\t# Kill-switch: `CEO_SPAWN_SECRET_SCAN=0` for the rare case where a prompt\n169\t# legitimately contains a long opaque id that trips the scan; Owner-only\n170\t# escape logged via veto_triggered(reason_code=spawn_secret_scan_bypassed).\n171\t_SPAWN_SECRET_PATTERNS: List[Tuple[str, re.Pattern[str]]] = [\n172\t    # AWS access key ID (AKIA prefix, 16 uppercase alnum after).\n173\t    (\"aws_access_key_id\", re.compile(r\"\\bAKIA[0-9A-Z]{16}\\b\")),\n174\t    # Generic AWS secret access key.\n175\t    (\n176\t        \"aws_secret_access_key\",\n177\t        re.compile(\n178\t            r\"\\b(?:aws[_-]?secret[_-]?access[_-]?key)\\b\\s*[:=]\\s*\"\n179\t            r\"[\\\"\\']?[A-Za-z0-9/+=]{40}[\\\"\\']?\",\n180\t            re.IGNORECASE,\n181\t        ),\n182\t    ),\n183\t    # Stripe live/test secret key.\n184\t    (\"stripe_secret_key\", re.compile(r\"\\bsk_(?:live|test)_[0-9A-Za-z]{24,}\\b\")),\n185\t    # GitHub personal access token.\n186\t    (\"github_pat\", re.compile(r\"\\bghp_[0-9A-Za-z]{36,}\\b\")),\n187\t    # OpenAI API key.\n188\t    (\"openai_api_key\", re.compile(r\"\\bsk-[A-Za-z0-9]{48,}\\b\")),\n189\t    # PEM private key preamble.\n190\t    (\n191\t        \"pem_private_key\",\n192\t        re.compile(\n193\t            r\"-----BEGIN (?:RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----\"\n194\t        ),\n195\t    ),\n196\t]\n197\t\n198\t\n199\tdef _inject_terse_marker(prompt: str, subagent_type: str) -> str:\n200\t    \"\"\"Inject ## TERSE-MODE marker per PLAN-047 Phase 2.\"\"\"\n201\t    if os.environ.get(\"CEO_TERSE_MODE\", \"0\") != \"1\":\n202\t        return prompt\n203\t    veto_roles = {\"code-reviewer\", \"security-engineer\", \"qa-architect\", \"compliance-specialist\"}\n204\t    if (subagent_type or \"\") in veto_roles:\n205\t        return prompt + \"\\n\\n## TERSE-MODE-DISABLED — VETO role requires full-prose rationale.\\n\"\n206\t    return prompt + \"\\n\\n## TERSE-MODE — fragments OK in exploratory flows; never truncate code or numbers.\\n\"\n207\t\n208\tdef _validate_spawn_prompt_has_no_secrets(\n209\t    prompt: str,\n210\t) -> Tuple[bool, Optional[str], Optional[str]]:\n211\t    \"\"\"Return (ok, reason_code, detail) — ok=False means BLOCK spawn.\n212\t\n213\t    Short-circuits with ok=True when `CEO_SPAWN_SECRET_SCAN=0` is set\n214\t    (Owner bypass; any non-\"0\" value enforces).\n215\t    \"\"\"\n216\t    # Session 75 Codex Finding 4 closure (Owner D4 staged rollout):\n217\t    # default OFF, opt-in via CEO_SPAWN_SECRET_SCAN=1. Without the env\n218\t    # var (or with =0), function returns ok=True without scanning. Soak\n219\t    # protocol: ≥3 sessions of opt-in usage with FPR<1%% before any\n220\t    # default flip ADR. Until then, this is a wire-only landing.\n221\t    if os.environ.get(\"CEO_SPAWN_SECRET_SCAN\", \"0\") != \"1\":\n222\t        return True, None, None\n223\t    if not prompt:\n224\t        return True, None, None\n225\t    for family, pattern in _SPAWN_SECRET_PATTERNS:\n226\t        m = pattern.search(prompt)\n227\t        if m:\n228\t            return (\n229\t                False,\n230\t                \"spawn_prompt_contains_secret\",\n231\t                f\"family={family} prompt_len={len(prompt)}\",\n232\t            )\n233\t    return True, None, None\n234\t\n235\t\n236\t# Sprint 5 Phase 7 (ADR-010) — Architect recursion guard.\n237\t# When CEO_ARCHITECT_ACTIVE=1 is in the env, any spawn whose\n238\t# description/prompt names \"Agent Architect\" is BLOCKED. Prevents\n239\t# meta-agent recursion (Architect-spawning-Architect).\n240\t_ARCHITECT_NAME_RE = re.compile(\n241\t    r\"\\bAgent\\s+Architect\\b\",\n242\t    flags=re.IGNORECASE,\n243\t)\n244\t\n245\t\n246\t# ---------------------------------------------------------------------------\n247\t# PLAN-133 E3 — Per-spawn tool scoping + depth/overlap rails.\n248\t# ---------------------------------------------------------------------------\n249\t# Ports the Goose recipe \"declared capability scope + one-level recursion +\n250\t# file partition\" idea, re-implemented from scratch in stdlib (rite §2). All\n251\t# three rails are ADVISORY by default (emit only) and become BLOCKING only\n252\t# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n253\t#\n254\t# Rail 1 — Tool allow-list: a spawn profile MAY declare\n255\t#     ## TOOL ALLOW-LIST\n256\t#     - Read\n257\t#     - Edit\n258\t#     - Bash\n259\t# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n260\t# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n261\t# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n262\t#\n263\t# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n264\t# depth-2 spawn. The harness Agent payload has no native depth field, so we\n265\t# read the advisory marker the CEO injects into a delegated prompt\n266\t# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n267\t# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n268\t#\n269\t# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n270\t# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n271\t# other spawns recorded in the audit log within a short concurrency window\n272\t# (same session, same plan). Any shared concrete path = clobber risk.\n273\t\n274\t# --- Rail 1: tool allow-list ----------------------------------------------\n275\t_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n276\t    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n277\t    flags=re.MULTILINE,\n278\t)\n279\t# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n280\t_TOOL_BULLET_RE = re.compile(\n281\t    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n282\t    flags=re.MULTILINE,\n283\t)\n284\t# Canonical Claude Code tool names we recognize (closed set — anything not\n285\t# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n286\t# unknown token can never cause a false block).\n287\t_KNOWN_TOOL_NAMES = frozenset({\n288\t    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n289\t    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n290\t})\n291\t# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n292\t# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n293\t# a profile that simply mentions a word does not trip the rail.\n294\t_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n295\t    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n296\t              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n297\t    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n298\t    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n299\t    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n300\t    (\"websearch\", (\"search the web\", \"web search\")),\n301\t)\n302\t_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n303\t\n304\t# --- Rail 2: depth fence ---------------------------------------------------\n305\t_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n306\t    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n307\t    flags=re.MULTILINE,\n308\t)\n309\t\n310\t# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n311\t# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n312\t# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n313\t# Markdown renderer/agent — recognizing them (instead of enumerating\n314\t# taints) keeps the parser aligned with what the agent SEES.\n315\t_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n316\t    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n317\t    flags=re.MULTILINE | re.IGNORECASE,\n318\t)\n319\t# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n320\t# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n321\t# make the line a CommonMark CODE BLOCK — example text, never a grant.\n322\t_CAN_EDIT_LINE_RE = re.compile(\n323\t    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n324\t    flags=re.MULTILINE | re.IGNORECASE,\n325\t)\n326\t# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n327\t# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n328\t# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n329\t# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n330\t# match a CLOSED whitelist of recognized forms — anything else is a\n331\t# visible grant/instruction the parser did not validate => taint.\n332\t_FA_LIST_LINE_RE = re.compile(\n333\t    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n334\t    flags=re.MULTILINE,\n335\t)\n336\t_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n337\t    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n338\t    flags=re.IGNORECASE,\n339\t)\n340\t_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n341\t    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n342\t    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n343\t    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n344\t    r\"|FORBIDDEN\\b\"             # architect forbidden list\n345\t    # canonical template escape-hatch prose — the FULL fixed phrase, so\n346\t    # the prefix CONSUMES its own `edit` and the suffix rule below can\n347\t    # ban any further edit-grant text (codex r34 P1)\n348\t    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n349\t    r\")\",\n350\t    flags=re.IGNORECASE,\n351\t)\n352\t# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n353\t# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n354\t# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n355\t# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n356\t# authority). A token is a whitespace-delimited word stripped of edge\n357\t# punctuation; tokens containing / or . are path-like and never match.\n358\t_FA_AUTHORITY_WORDS = frozenset((\n359\t    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n360\t    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n361\t))\n362\t\n363\t\n364\t# _OVERLAP_LOOKBACK_S is re-exported from agent_spawn.file_assignment below.\n365\t_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n366\t_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n367\t\n368\t\n369\t# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n370\t# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n371\t# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n372\t# ADR-191 cures): read-only intent must be spelled out with this token.\n373\t_FA_READONLY_TOKEN = \"none-read-only\"\n374\t\n375\t# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n376\t# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n377\t# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n378\t# CommonMark) would leak into classification and could satisfy the gate\n379\t# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n380\t# radius; the shared regex serves every other block parser unchanged).\n381\t# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n382\t# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n383\t# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n384\t# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n385\t# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n386\t# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n387\t# Closer must be the SAME character, length >= opener (codex r37 P2:\n388\t# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n389\t# the fence char; closer = \\1 (full opener string) + \\2* (same char\n390\t# only). A shorter/mismatched closer falls through to \\Z — masking to\n391\t# EOF, the fail-CLOSED direction.\n392\t_FA_FENCE_RE = re.compile(\n393\t    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n394\t    flags=re.MULTILINE | re.DOTALL,\n395\t)\n396\t\n397\t# Telemetry marker hash for the explicit read-only declaration. DOMAIN-\n398\t# SEPARATED from real path hashes (codex r1 P2, Lote B): hashing the bare\n399\t# token collided with a legitimate concrete path `./none-read-only` (the\n400\t# token check runs BEFORE ./-normalization, so that path survives as\n401\t# concrete and would hash identically — under CEO_SPAWN_OVERLAP_GUARD=1 it\n402\t# would false-block against every prior read-only spawn). NUL bytes cannot\n403\t# appear in a real declared path, so this input is unreachable from\n404\t# _path_hash(path) space.\n405\t\n406\t\n407\t# ---------------------------------------------------------------------------\n408\t# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [BEGIN]\n409\t# ---------------------------------------------------------------------------\n410\t# NAMED spawns whose task indicates contact with UNTRUSTED CONTENT (web\n411\t# fetch/search, scraping, imported/upstream/third-party material) MUST carry\n412\t# the 6-bullet `## PROMPT DEFENSE` anti-injection block that\n413\t# `.claude/scripts/inject-agent-context.sh` now emits unconditionally.\n414\t#\n415\t# Failure semantics (CLAUDE.md §4 doctrine):\n416\t#   - INPUT side is fail-CLOSED: heuristic matched + section missing/thin\n417\t#     => BLOCK (precedent: check_bash_safety.py `_e3` parse gate + C4).\n418\t#   - INFRASTRUCTURE side is fail-OPEN: any exception inside this gate\n419\t#     => allow (never punish the session for our own bug).\n420\t#\n421\t# Detection is a CONSERVATIVE lowercase-substring keyword set scanned over\n422\t# the sanitized (fence/comment-stripped) description + prompt. HONESTY —\n423\t# documented false negatives, by design:\n424\t#   - synonyms/other languages are missed (\"crawl\", \"harvest\", \"baixar\",\n425\t#     \"read the vendor tarball\", ...);\n426\t#   - obfuscated intents (base64, hyphenation, l33t) are missed;\n427\t#   - keywords appearing ONLY inside fenced code blocks are masked by\n428\t#     `_strip_fenced_and_comments` and therefore missed;\n429\t#   - scan is capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes; mentions beyond\n430\t#     the cap are missed.\n431\t# The cheap mitigation for every miss-class is the same: the spawn template\n432\t# emits the block UNCONDITIONALLY, so any template-generated prompt passes\n433\t# regardless of heuristic reach. This gate exists to catch hand-rolled\n434\t# prompts that bypass the template.\n435\t#\n436\t# Kill-switches (advisory demotion — event still emitted, spawn allowed):\n437\t#   CEO_PROMPT_DEFENSE_GATE=0   per-gate opt-out\n438\t#   CEO_SOTA_DISABLE=1          master kill (E3-rail precedent)\n439\t_PROMPT_DEFENSE_HEADER_RE = re.compile(\n440\t    r\"^##[ \\t]+PROMPT[ \\t]+DEFENSE[ \\t]*$\",\n441\t    flags=re.MULTILINE,\n442\t)\n443\t# A bullet line: \"-\" or \"*\" + whitespace + at least one non-space char.\n444\t_PROMPT_DEFENSE_BULLET_RE = re.compile(\n445\t    r\"^[ \\t]*[-*][ \\t]+\\S\",\n446\t    flags=re.MULTILINE,\n447\t)\n448\t_PROMPT_DEFENSE_MIN_BULLETS = 6\n449\t_PROMPT_DEFENSE_SCAN_CAP = 256 * 1024  # bytes of sanitized text scanned\n450\t# Closed, lowercase substring set. Ordering = report priority (first hit\n451\t# wins; the matched token is the ONLY prompt-derived value that reaches the\n452\t# audit log — closed-enum-safe, no prompt body echo).\n453\t_UNTRUSTED_CONTENT_HINTS: Tuple[str, ...] = (\n454\t    \"webfetch\",\n455\t    \"websearch\",\n456\t    \"web search\",\n457\t    \"search the web\",\n458\t    \"fetch the url\",\n459\t    \"fetch url\",\n460\t    \"fetch http\",\n461\t    \"download from http\",\n462\t    \"scrape\",\n463\t    \"scraping\",\n464\t    \"imported\",\n465\t    \"upstream\",\n466\t    \"third-party\",\n467\t    \"third party\",\n468\t    \"untrusted\",\n469\t)\n470\t\n471\t\n472\tdef _prompt_defense_required(\n473\t    description: str, prompt_sanitized: str\n474\t) -> Optional[str]:\n475\t    \"\"\"Return the first matched untrusted-content hint, or None.\n476\t\n477\t    Pure. Never raises. Bounded scan over lowercase(description + sanitized\n478\t    prompt) capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes.\n479\t    \"\"\"\n480\t    haystack = (\n481\t        (description or \"\") + \"\\n\" + (prompt_sanitized or \"\")\n482\t    )[:_PROMPT_DEFENSE_SCAN_CAP].lower()\n483\t    for hint in _UNTRUSTED_CONTENT_HINTS:\n484\t        if hint in haystack:\n485\t            return hint\n486\t    return None\n487\t\n488\t\n489\tdef _has_prompt_defense_block(prompt_sanitized: str) -> bool:\n490\t    \"\"\"True iff sanitized prompt has `## PROMPT DEFENSE` on its own line\n491\t    with >= `_PROMPT_DEFENSE_MIN_BULLETS` bullet lines before the next\n492\t    `##` heading / EOF. Fence/comment-masked headers do NOT count\n493\t    (P1-SEC-B precedent — caller passes pre-sanitized text).\"\"\"\n494\t    if not prompt_sanitized:\n495\t        return False\n496\t    m = _PROMPT_DEFENSE_HEADER_RE.search(prompt_sanitized)\n497\t    if m is None:\n498\t        return False\n499\t    block_start = m.end()\n500\t    nxt = _NEXT_H2_RE.search(prompt_sanitized, block_start)\n501\t    block = prompt_sanitized[\n502\t        block_start: nxt.start() if nxt else len(prompt_sanitized)\n503\t    ]\n504\t    bullets = len(_PROMPT_DEFENSE_BULLET_RE.findall(block))\n505\t    return bullets >= _PROMPT_DEFENSE_MIN_BULLETS\n506\t\n507\t\n508\tdef _emit_prompt_defense_event(\n509\t    *, keyword: str, present: bool, enforced: bool\n510\t) -> None:\n511\t    \"\"\"Emit `spawn_prompt_defense_gate` telemetry. `keyword` is from the\n512\t    closed `_UNTRUSTED_CONTENT_HINTS` enum — no prompt body ever persists.\n513\t    Fail-open.\"\"\"\n514\t    try:\n515\t        if not _AUDIT_EMIT_AVAILABLE:\n516\t            return\n517\t        _audit_emit.emit_generic(\n518\t            \"spawn_prompt_defense_gate\",\n519\t            keyword=(keyword or \"\")[:32],\n520\t            present=1 if present else 0,\n521\t            enforced=1 if enforced else 0,\n522\t        )\n523\t    except Exception:  # pragma: no cover - fail-open\n524\t        return\n525\t\n526\t\n527\tdef _enforce_prompt_defense(\n528\t    *,\n529\t    description: str,\n530\t    prompt: str,\n531\t    env: Dict[str, str],\n532\t) -> Optional[Tuple[str, str]]:\n533\t    \"\"\"Evaluate the Prompt Defense Baseline gate for a NAMED spawn.\n534\t\n535\t    Returns (reason_code, detail) when the gate is ENFORCING and fires;\n536\t    None otherwise. NEVER raises (infra fail-open); the block itself is\n537\t    the input-side fail-CLOSED posture (matched + missing => BLOCK).\n538\t    \"\"\"\n539\t    try:\n540\t        sanitized = _strip_fenced_and_comments(prompt or \"\")\n541\t        keyword = _prompt_defense_required(description or \"\", sanitized)\n542\t        if keyword is None:\n543\t            return None  # no untrusted-content signal — out of scope\n544\t        present = _has_prompt_defense_block(sanitized)\n545\t        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n546\t        raw = (env.get(\"CEO_PROMPT_DEFENSE_GATE\") or \"\").strip()\n547\t        gate_off = raw in (\"0\", \"false\", \"False\", \"no\", \"off\")\n548\t        enforced = (not master_off) and (not gate_off)\n549\t        _emit_prompt_defense_event(\n550\t            keyword=keyword, present=present, enforced=enforced\n551\t        )\n552\t        if present or not enforced:\n553\t            return None\n554\t        return (\n555\t            \"spawn_prompt_defense_missing\",\n556\t            f\"keyword={keyword} min_bullets={_PROMPT_DEFENSE_MIN_BULLETS}\",\n557\t        )\n558\t    except Exception:  # pragma: no cover - fail-open invariant\n559\t        return None\n560\t"}]},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"694f468d-176d-4b70-b06a-d9cb321228d8","timestamp":"2026-11-15T10:41:24.904Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/prompt_rules.py","content":"from __future__ import annotations\n\nimport re\n\n__all__ = ('_strip_fenced_and_comments', '_has_skill_content', '_has_skill_content_sanitized', 'ENABLE_NATIVE_SUBAGENTS', 'ENABLE_SKILL_REFERENCE_MODE', '_SKILL_REFERENCE_HEADER_RE', '_SKILL_REFERENCE_LINE_RE', '_SKILL_REFERENCE_MAX_BYTES', '_SKILL_REFERENCE_MIN_BODY_BYTES', 'REASON_REFERENCE_MISSING', 'REASON_REFERENCE_UNSAFE_PATH', 'REASON_REFERENCE_HASH_MISMATCH', 'REASON_REFERENCE_SYMLINK_REFUSED', 'REASON_REFERENCE_TOO_LARGE', 'REASON_REFERENCE_REDACTION_HIT', 'REASON_REFERENCE_WRONG_FILENAME', 'REASON_REFERENCE_MISSING_FRONTMATTER', 'REASON_REFERENCE_BYTE_FLOOR_UNDERFLOW', 'REASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH', 'REASON_REFERENCE_OUTSIDE_SKILLS_ROOT', 'REASON_MISSING_SKILL_CONTENT', '_SECRET_TOKENS_IN_OUTPUT', '_EFFORT_TOKEN_RE', '_has_effort_token', '_SPAWN_SECRET_PATTERNS', '_inject_terse_marker', '_validate_spawn_prompt_has_no_secrets', '_ARCHITECT_NAME_RE', '_TOOL_ALLOWLIST_HEADER_RE', '_TOOL_BULLET_RE', '_KNOWN_TOOL_NAMES', '_TOOL_REQUEST_HINTS', '_TOOL_SCAN_WINDOW', '_SUBAGENT_DEPTH_MARKER_RE', '_FILE_ASSIGNMENT_HEADER_RE', '_CAN_EDIT_LINE_RE', '_FA_LIST_LINE_RE', '_FA_ALLOWED_GRANT_LINE_RE', '_FA_ALLOWED_PROSE_LINE_RE', '_FA_AUTHORITY_WORDS', '_OVERLAP_MAX_PATHS', '_OVERLAP_TAIL_LINES', '_FA_READONLY_TOKEN', '_FA_FENCE_RE', '_PROMPT_DEFENSE_HEADER_RE', '_PROMPT_DEFENSE_BULLET_RE', '_PROMPT_DEFENSE_MIN_BULLETS', '_PROMPT_DEFENSE_SCAN_CAP', '_UNTRUSTED_CONTENT_HINTS', '_prompt_defense_required', '_has_prompt_defense_block', '_emit_prompt_defense_event', '_enforce_prompt_defense')\n\ndef _strip_fenced_and_comments(text: str) -> str:\n    \"\"\"Return a version of ``text`` with HTML comments removed and\n    fenced-code-block content masked so marker/body searches cannot\n    match inside them (P1-SEC-B bypass hardening).\"\"\"\n    stripped = _HTML_COMMENT_RE.sub(\"\", text)\n    out_parts = []\n    in_fence = False\n    for line in stripped.splitlines(keepends=True):\n        if _CODE_FENCE_RE.match(line):\n            in_fence = not in_fence\n            out_parts.append(line)\n            continue\n        if in_fence:\n            out_parts.append(\"\".join(\n                \"\\n\" if c == \"\\n\" else \" \" for c in line\n            ))\n        else:\n            out_parts.append(line)\n    return \"\".join(out_parts)\n\n\ndef _has_skill_content(prompt: str) -> bool:\n    \"\"\"True iff ``prompt`` contains a real `## SKILL CONTENT` section.\n\n    Enforces four bypass-resistant checks (P1-SEC-B):\n    1. Marker on own line (not inline narrative).\n    2. Marker NOT inside HTML comment.\n    3. Marker NOT inside fenced code block.\n    4. >=_SKILL_CONTENT_MIN_BYTES non-ws bytes between marker and next ##.\n    \"\"\"\n    if not prompt:\n        return False\n    return _has_skill_content_sanitized(_strip_fenced_and_comments(prompt))\n\n\ndef _has_skill_content_sanitized(sanitized: str) -> bool:\n    \"\"\"Shared ``## SKILL CONTENT`` check against already-sanitized text.\n\n    PLAN-023 Phase F (F-perf-003) — split out so ``decide`` and other\n    callers can share a single ``_strip_fenced_and_comments`` pass\n    rather than re-stripping inside each sub-check.\n    \"\"\"\n    match = _SKILL_CONTENT_MARKER_RE.search(sanitized)\n    if match is None:\n        return False\n    body_start = match.end()\n    next_heading = _NEXT_H2_RE.search(sanitized, body_start)\n    body_end = next_heading.start() if next_heading else len(sanitized)\n    body = sanitized[body_start:body_end]\n    non_ws_bytes = sum(1 for c in body if not c.isspace())\n    return non_ws_bytes >= _SKILL_CONTENT_MIN_BYTES\n\n\n# =============================================================================\n# PLAN-020 Phase 2 — `## SKILL REFERENCE` additive sentinel (ADR-051)\n# =============================================================================\n#\n# Parallel accept-path. Does NOT replace `_has_skill_content`. Hardened\n# against 14 attack classes documented in ADR-051 §Threat model.\n#\n# Hook recognition order in decide():\n#   1. If prompt has `## SKILL REFERENCE` → strict validation, fail-CLOSED.\n#   2. Else if prompt has `## SKILL CONTENT` → inline path (existing P1-SEC-B).\n#   3. Else block with the legacy `missing_skill_content` reason.\n\n# Module-level toggles (Phase revert = single-line flip to False).\nENABLE_NATIVE_SUBAGENTS = True\nENABLE_SKILL_REFERENCE_MODE = True\n\n# Reference sentinel header — must be on own line, not inside fences.\n_SKILL_REFERENCE_HEADER_RE = re.compile(\n    r\"^##[ \\t]+SKILL[ \\t]+REFERENCE[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n\n# Reference body line: `@<path> sha256=<64-hex>`. Path may be relative.\n_SKILL_REFERENCE_LINE_RE = re.compile(\n    r\"^@(?P<path>\\S+)[ \\t]+sha256=(?P<hash>[0-9a-f]{64})\\b\",\n    flags=re.MULTILINE,\n)\n\n# Caps + thresholds (ADR-051 §Synchronous validation).\n_SKILL_REFERENCE_MAX_BYTES = 1_048_576  # 1 MiB DoS cap\n_SKILL_REFERENCE_MIN_BODY_BYTES = 512   # distinct from inline 256 floor\n\n# 12 telemetry reason codes (ADR-051 §Telemetry reason codes).\nREASON_REFERENCE_MISSING = \"reference_missing\"\nREASON_REFERENCE_UNSAFE_PATH = \"reference_unsafe_path\"\nREASON_REFERENCE_HASH_MISMATCH = \"reference_hash_mismatch\"\nREASON_REFERENCE_SYMLINK_REFUSED = \"reference_symlink_refused\"\nREASON_REFERENCE_TOO_LARGE = \"reference_too_large\"\nREASON_REFERENCE_REDACTION_HIT = \"reference_redaction_hit\"\nREASON_REFERENCE_WRONG_FILENAME = \"reference_wrong_filename\"\nREASON_REFERENCE_MISSING_FRONTMATTER = \"reference_missing_frontmatter\"\nREASON_REFERENCE_BYTE_FLOOR_UNDERFLOW = \"reference_byte_floor_underflow\"\nREASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH = (\n    \"reference_unicode_normalization_mismatch\"\n)\nREASON_REFERENCE_OUTSIDE_SKILLS_ROOT = \"reference_outside_skills_root\"\nREASON_MISSING_SKILL_CONTENT = \"missing_skill_content\"  # legacy/inline\n\n# Session 32 BUGFIX — _lib.redact.redact_secrets whitespace-collapses\n# always; equality check with original text is not a valid \"secret\n# detected\" signal. Instead we look for specific replacement tokens\n# that `_redact._PATTERNS` inserts when a secret matches.\n_SECRET_TOKENS_IN_OUTPUT = frozenset({\n    \"[JWT]\",\n    \"[API_KEY]\",\n    \"[GITHUB_PAT]\",\n    \"[AWS_KEY]\",\n    \"[TOKEN]\",\n    \"[URL_WITH_CREDS]\",\n    \"[HEX_SECRET]\",\n    \"[REDACTED]\",\n    \"[SLACK_BOT]\",\n    \"[STRIPE_KEY]\",\n    \"[GOOGLE_REFRESH]\",\n    # PLAN-024 F-hooks-001 P0 fix: redact.py replaces the PEM header\n    # with \"[SSH_PRIVATE_KEY_HEADER]\" — matching raw \"-----BEGIN\" will\n    # never fire after redaction. Check the replacement token instead.\n    \"[SSH_PRIVATE_KEY_HEADER]\",\n})\n\n\n# =============================================================================\n# PLAN-020 Phase 3 — `/effort` token rejection in spawn prompts\n# =============================================================================\n#\n# `/effort` hints (low/default/high/max + `ultrathink` keyword) are\n# CEO-only. They MUST NOT appear in spawn prompts (sub-agents inherit\n# their thinking budget from Anthropic defaults). PLAN-020 §4 Phase 3\n# §scope clause (QA must-fix #7).\n\n_EFFORT_TOKEN_RE = re.compile(\n    r\"(?:^|[^\\w/])/effort(?:[ \\t]+(?:low|default|high|max))?\\b\",\n    flags=re.IGNORECASE,\n)\n\n\ndef _has_effort_token(prompt: str) -> bool:\n    \"\"\"True iff prompt contains a `/effort [tier]` slash-command token.\"\"\"\n    if not prompt:\n        return False\n    sanitized = _strip_fenced_and_comments(prompt)\n    return bool(_EFFORT_TOKEN_RE.search(sanitized))\n\n\n# ---------------------------------------------------------------------------\n# PLAN-045 F-10-04 — spawn-prompt secret-scan pre-dispatch\n# ---------------------------------------------------------------------------\n# Spawn prompts are the #1 vector for accidentally shipping secrets into a\n# sub-agent's context. A CEO that copy-pastes a `.env` into a task prompt\n# or builds a prompt that interpolates an env var leaks the secret to\n# whatever model the sub-agent uses AND to the audit log (spawn prompts\n# are recorded for governance).\n#\n# Reject spawns whose prompt contains any of 6 high-signal secret shapes.\n# Each shape is a narrow regex to avoid false-positives on docs / test\n# fixtures (prefix-bound + entropy-adjacent). Audit emits\n# `veto_triggered(reason_code=spawn_prompt_contains_secret)` on reject.\n#\n# Kill-switch: `CEO_SPAWN_SECRET_SCAN=0` for the rare case where a prompt\n# legitimately contains a long opaque id that trips the scan; Owner-only\n# escape logged via veto_triggered(reason_code=spawn_secret_scan_bypassed).\n_SPAWN_SECRET_PATTERNS: List[Tuple[str, re.Pattern[str]]] = [\n    # AWS access key ID (AKIA prefix, 16 uppercase alnum after).\n    (\"aws_access_key_id\", re.compile(r\"\\bAKIA[0-9A-Z]{16}\\b\")),\n    # Generic AWS secret access key.\n    (\n        \"aws_secret_access_key\",\n        re.compile(\n            r\"\\b(?:aws[_-]?secret[_-]?access[_-]?key)\\b\\s*[:=]\\s*\"\n            r\"[\\\"\\']?[A-Za-z0-9/+=]{40}[\\\"\\']?\",\n            re.IGNORECASE,\n        ),\n    ),\n    # Stripe live/test secret key.\n    (\"stripe_secret_key\", re.compile(r\"\\bsk_(?:live|test)_[0-9A-Za-z]{24,}\\b\")),\n    # GitHub personal access token.\n    (\"github_pat\", re.compile(r\"\\bghp_[0-9A-Za-z]{36,}\\b\")),\n    # OpenAI API key.\n    (\"openai_api_key\", re.compile(r\"\\bsk-[A-Za-z0-9]{48,}\\b\")),\n    # PEM private key preamble.\n    (\n        \"pem_private_key\",\n        re.compile(\n            r\"-----BEGIN (?:RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----\"\n        ),\n    ),\n]\n\n\ndef _inject_terse_marker(prompt: str, subagent_type: str) -> str:\n    \"\"\"Inject ## TERSE-MODE marker per PLAN-047 Phase 2.\"\"\"\n    if os.environ.get(\"CEO_TERSE_MODE\", \"0\") != \"1\":\n        return prompt\n    veto_roles = {\"code-reviewer\", \"security-engineer\", \"qa-architect\", \"compliance-specialist\"}\n    if (subagent_type or \"\") in veto_roles:\n        return prompt + \"\\n\\n## TERSE-MODE-DISABLED — VETO role requires full-prose rationale.\\n\"\n    return prompt + \"\\n\\n## TERSE-MODE — fragments OK in exploratory flows; never truncate code or numbers.\\n\"\n\ndef _validate_spawn_prompt_has_no_secrets(\n    prompt: str,\n) -> Tuple[bool, Optional[str], Optional[str]]:\n    \"\"\"Return (ok, reason_code, detail) — ok=False means BLOCK spawn.\n\n    Short-circuits with ok=True when `CEO_SPAWN_SECRET_SCAN=0` is set\n    (Owner bypass; any non-\"0\" value enforces).\n    \"\"\"\n    # Session 75 Codex Finding 4 closure (Owner D4 staged rollout):\n    # default OFF, opt-in via CEO_SPAWN_SECRET_SCAN=1. Without the env\n    # var (or with =0), function returns ok=True without scanning. Soak\n    # protocol: ≥3 sessions of opt-in usage with FPR<1%% before any\n    # default flip ADR. Until then, this is a wire-only landing.\n    if os.environ.get(\"CEO_SPAWN_SECRET_SCAN\", \"0\") != \"1\":\n        return True, None, None\n    if not prompt:\n        return True, None, None\n    for family, pattern in _SPAWN_SECRET_PATTERNS:\n        m = pattern.search(prompt)\n        if m:\n            return (\n                False,\n                \"spawn_prompt_contains_secret\",\n                f\"family={family} prompt_len={len(prompt)}\",\n            )\n    return True, None, None\n\n\n# Sprint 5 Phase 7 (ADR-010) — Architect recursion guard.\n# When CEO_ARCHITECT_ACTIVE=1 is in the env, any spawn whose\n# description/prompt names \"Agent Architect\" is BLOCKED. Prevents\n# meta-agent recursion (Architect-spawning-Architect).\n_ARCHITECT_NAME_RE = re.compile(\n    r\"\\bAgent\\s+Architect\\b\",\n    flags=re.IGNORECASE,\n)\n\n\n# ---------------------------------------------------------------------------\n# PLAN-133 E3 — Per-spawn tool scoping + depth/overlap rails.\n# ---------------------------------------------------------------------------\n# Ports the Goose recipe \"declared capability scope + one-level recursion +\n# file partition\" idea, re-implemented from scratch in stdlib (rite §2). All\n# three rails are ADVISORY by default (emit only) and become BLOCKING only\n# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n#\n# Rail 1 — Tool allow-list: a spawn profile MAY declare\n#     ## TOOL ALLOW-LIST\n#     - Read\n#     - Edit\n#     - Bash\n# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n#\n# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n# depth-2 spawn. The harness Agent payload has no native depth field, so we\n# read the advisory marker the CEO injects into a delegated prompt\n# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n#\n# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n# other spawns recorded in the audit log within a short concurrency window\n# (same session, same plan). Any shared concrete path = clobber risk.\n\n# --- Rail 1: tool allow-list ----------------------------------------------\n_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n_TOOL_BULLET_RE = re.compile(\n    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n    flags=re.MULTILINE,\n)\n# Canonical Claude Code tool names we recognize (closed set — anything not\n# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n# unknown token can never cause a false block).\n_KNOWN_TOOL_NAMES = frozenset({\n    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n})\n# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n# a profile that simply mentions a word does not trip the rail.\n_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n    (\"websearch\", (\"search the web\", \"web search\")),\n)\n_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n\n# --- Rail 2: depth fence ---------------------------------------------------\n_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n    flags=re.MULTILINE,\n)\n\n# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n# Markdown renderer/agent — recognizing them (instead of enumerating\n# taints) keeps the parser aligned with what the agent SEES.\n_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n    flags=re.MULTILINE | re.IGNORECASE,\n)\n# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n# make the line a CommonMark CODE BLOCK — example text, never a grant.\n_CAN_EDIT_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n    flags=re.MULTILINE | re.IGNORECASE,\n)\n# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n# match a CLOSED whitelist of recognized forms — anything else is a\n# visible grant/instruction the parser did not validate => taint.\n_FA_LIST_LINE_RE = re.compile(\n    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n    flags=re.MULTILINE,\n)\n_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n    flags=re.IGNORECASE,\n)\n_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n    r\"|FORBIDDEN\\b\"             # architect forbidden list\n    # canonical template escape-hatch prose — the FULL fixed phrase, so\n    # the prefix CONSUMES its own `edit` and the suffix rule below can\n    # ban any further edit-grant text (codex r34 P1)\n    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n    r\")\",\n    flags=re.IGNORECASE,\n)\n# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n# authority). A token is a whitespace-delimited word stripped of edge\n# punctuation; tokens containing / or . are path-like and never match.\n_FA_AUTHORITY_WORDS = frozenset((\n    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n))\n\n\n# _OVERLAP_LOOKBACK_S is re-exported from agent_spawn.file_assignment below.\n_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n\n\n# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n# ADR-191 cures): read-only intent must be spelled out with this token.\n_FA_READONLY_TOKEN = \"none-read-only\"\n\n# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n# CommonMark) would leak into classification and could satisfy the gate\n# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n# radius; the shared regex serves every other block parser unchanged).\n# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n# Closer must be the SAME character, length >= opener (codex r37 P2:\n# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n# the fence char; closer = \\1 (full opener string) + \\2* (same char\n# only). A shorter/mismatched closer falls through to \\Z — masking to\n# EOF, the fail-CLOSED direction.\n_FA_FENCE_RE = re.compile(\n    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n    flags=re.MULTILINE | re.DOTALL,\n)\n\n# Telemetry marker hash for the explicit read-only declaration. DOMAIN-\n# SEPARATED from real path hashes (codex r1 P2, Lote B): hashing the bare\n# token collided with a legitimate concrete path `./none-read-only` (the\n# token check runs BEFORE ./-normalization, so that path survives as\n# concrete and would hash identically — under CEO_SPAWN_OVERLAP_GUARD=1 it\n# would false-block against every prior read-only spawn). NUL bytes cannot\n# appear in a real declared path, so this input is unreachable from\n# _path_hash(path) space.\n\n\n# ---------------------------------------------------------------------------\n# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [BEGIN]\n# ---------------------------------------------------------------------------\n# NAMED spawns whose task indicates contact with UNTRUSTED CONTENT (web\n# fetch/search, scraping, imported/upstream/third-party material) MUST carry\n# the 6-bullet `## PROMPT DEFENSE` anti-injection block that\n# `.claude/scripts/inject-agent-context.sh` now emits unconditionally.\n#\n# Failure semantics (CLAUDE.md §4 doctrine):\n#   - INPUT side is fail-CLOSED: heuristic matched + section missing/thin\n#     => BLOCK (precedent: check_bash_safety.py `_e3` parse gate + C4).\n#   - INFRASTRUCTURE side is fail-OPEN: any exception inside this gate\n#     => allow (never punish the session for our own bug).\n#\n# Detection is a CONSERVATIVE lowercase-substring keyword set scanned over\n# the sanitized (fence/comment-stripped) description + prompt. HONESTY —\n# documented false negatives, by design:\n#   - synonyms/other languages are missed (\"crawl\", \"harvest\", \"baixar\",\n#     \"read the vendor tarball\", ...);\n#   - obfuscated intents (base64, hyphenation, l33t) are missed;\n#   - keywords appearing ONLY inside fenced code blocks are masked by\n#     `_strip_fenced_and_comments` and therefore missed;\n#   - scan is capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes; mentions beyond\n#     the cap are missed.\n# The cheap mitigation for every miss-class is the same: the spawn template\n# emits the block UNCONDITIONALLY, so any template-generated prompt passes\n# regardless of heuristic reach. This gate exists to catch hand-rolled\n# prompts that bypass the template.\n#\n# Kill-switches (advisory demotion — event still emitted, spawn allowed):\n#   CEO_PROMPT_DEFENSE_GATE=0   per-gate opt-out\n#   CEO_SOTA_DISABLE=1          master kill (E3-rail precedent)\n_PROMPT_DEFENSE_HEADER_RE = re.compile(\n    r\"^##[ \\t]+PROMPT[ \\t]+DEFENSE[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n# A bullet line: \"-\" or \"*\" + whitespace + at least one non-space char.\n_PROMPT_DEFENSE_BULLET_RE = re.compile(\n    r\"^[ \\t]*[-*][ \\t]+\\S\",\n    flags=re.MULTILINE,\n)\n_PROMPT_DEFENSE_MIN_BULLETS = 6\n_PROMPT_DEFENSE_SCAN_CAP = 256 * 1024  # bytes of sanitized text scanned\n# Closed, lowercase substring set. Ordering = report priority (first hit\n# wins; the matched token is the ONLY prompt-derived value that reaches the\n# audit log — closed-enum-safe, no prompt body echo).\n_UNTRUSTED_CONTENT_HINTS: Tuple[str, ...] = (\n    \"webfetch\",\n    \"websearch\",\n    \"web search\",\n    \"search the web\",\n    \"fetch the url\",\n    \"fetch url\",\n    \"fetch http\",\n    \"download from http\",\n    \"scrape\",\n    \"scraping\",\n    \"imported\",\n    \"upstream\",\n    \"third-party\",\n    \"third party\",\n    \"untrusted\",\n)\n\n\ndef _prompt_defense_required(\n    description: str, prompt_sanitized: str\n) -> Optional[str]:\n    \"\"\"Return the first matched untrusted-content hint, or None.\n\n    Pure. Never raises. Bounded scan over lowercase(description + sanitized\n    prompt) capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes.\n    \"\"\"\n    haystack = (\n        (description or \"\") + \"\\n\" + (prompt_sanitized or \"\")\n    )[:_PROMPT_DEFENSE_SCAN_CAP].lower()\n    for hint in _UNTRUSTED_CONTENT_HINTS:\n        if hint in haystack:\n            return hint\n    return None\n\n\ndef _has_prompt_defense_block(prompt_sanitized: str) -> bool:\n    \"\"\"True iff sanitized prompt has `## PROMPT DEFENSE` on its own line\n    with >= `_PROMPT_DEFENSE_MIN_BULLETS` bullet lines before the next\n    `##` heading / EOF. Fence/comment-masked headers do NOT count\n    (P1-SEC-B precedent — caller passes pre-sanitized text).\"\"\"\n    if not prompt_sanitized:\n        return False\n    m = _PROMPT_DEFENSE_HEADER_RE.search(prompt_sanitized)\n    if m is None:\n        return False\n    block_start = m.end()\n    nxt = _NEXT_H2_RE.search(prompt_sanitized, block_start)\n    block = prompt_sanitized[\n        block_start: nxt.start() if nxt else len(prompt_sanitized)\n    ]\n    bullets = len(_PROMPT_DEFENSE_BULLET_RE.findall(block))\n    return bullets >= _PROMPT_DEFENSE_MIN_BULLETS\n\n\ndef _emit_prompt_defense_event(\n    *, keyword: str, present: bool, enforced: bool\n) -> None:\n    \"\"\"Emit `spawn_prompt_defense_gate` telemetry. `keyword` is from the\n    closed `_UNTRUSTED_CONTENT_HINTS` enum — no prompt body ever persists.\n    Fail-open.\"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        _audit_emit.emit_generic(\n            \"spawn_prompt_defense_gate\",\n            keyword=(keyword or \"\")[:32],\n            present=1 if present else 0,\n            enforced=1 if enforced else 0,\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _enforce_prompt_defense(\n    *,\n    description: str,\n    prompt: str,\n    env: Dict[str, str],\n) -> Optional[Tuple[str, str]]:\n    \"\"\"Evaluate the Prompt Defense Baseline gate for a NAMED spawn.\n\n    Returns (reason_code, detail) when the gate is ENFORCING and fires;\n    None otherwise. NEVER raises (infra fail-open); the block itself is\n    the input-side fail-CLOSED posture (matched + missing => BLOCK).\n    \"\"\"\n    try:\n        sanitized = _strip_fenced_and_comments(prompt or \"\")\n        keyword = _prompt_defense_required(description or \"\", sanitized)\n        if keyword is None:\n            return None  # no untrusted-content signal — out of scope\n        present = _has_prompt_defense_block(sanitized)\n        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n        raw = (env.get(\"CEO_PROMPT_DEFENSE_GATE\") or \"\").strip()\n        gate_off = raw in (\"0\", \"false\", \"False\", \"no\", \"off\")\n        enforced = (not master_off) and (not gate_off)\n        _emit_prompt_defense_event(\n            keyword=keyword, present=present, enforced=enforced\n        )\n        if present or not enforced:\n            return None\n        return (\n            \"spawn_prompt_defense_missing\",\n            f\"keyword={keyword} min_bullets={_PROMPT_DEFENSE_MIN_BULLETS}\",\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return None\n","numLines":560,"startLine":1,"totalLines":560}},"tool_result_meta":[{"id":"toolu_01EJ8tF3KQfW8Gs6B8rJ46A5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
