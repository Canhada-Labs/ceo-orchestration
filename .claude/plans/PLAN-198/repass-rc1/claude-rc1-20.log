{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0159ZLcjdej15EDMf2Ue4dRc","type":"tool_result","content":"1\t\"\"\"Skill-reference parsing, path validation and content integrity.\n2\t\n3\tBound to the public hook namespace by this package at import time.\n4\t\"\"\"\n5\tfrom __future__ import annotations\n6\t\n7\t__all__ = (\n8\t    '_is_enabled',\n9\t    '_has_valid_frontmatter_with_name',\n10\t    '_skill_ref_parse_sentinel',\n11\t    '_skill_ref_resolve_path',\n12\t    '_skill_ref_validate_unicode',\n13\t    '_skill_ref_read_bounded',\n14\t    '_skill_ref_validate_frontmatter',\n15\t    '_skill_ref_validate_hash_and_redact',\n16\t    '_validate_skill_reference',\n17\t    '_has_skill_reference',\n18\t)\n19\t\n20\t\n21\tdef _is_enabled(env_var: str, default: bool, env: Optional[dict] = None) -> bool:\n22\t    \"\"\"Live read of an env-var toggle with a module default fallback.\n23\t\n24\t    Allows runtime opt-out via env (`CEO_SKILL_REFERENCE_MODE=0`,\n25\t    `CEO_NATIVE_SUBAGENTS=0`) without restarting Claude Code.\n26\t    `CEO_SOTA_DISABLE=1` is the master kill — overrides everything.\n27\t    \"\"\"\n28\t    src_env = env if env is not None else os.environ\n29\t    if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n30\t        return False\n31\t    raw = (src_env.get(env_var) or \"\").strip()\n32\t    if raw == \"\":\n33\t        return default\n34\t    return raw not in (\"0\", \"false\", \"FALSE\", \"False\", \"no\", \"off\")\n35\t\n36\t\n37\t\n38\tdef _has_valid_frontmatter_with_name(text: str) -> bool:\n39\t    \"\"\"Stdlib-only frontmatter parser (no PyYAML).\n40\t\n41\t    Returns True iff the file starts with `---` on first line, has a\n42\t    closing `---` line, and has at least one `name: <value>` line.\n43\t    \"\"\"\n44\t    if not text.startswith(\"---\\n\") and not text.startswith(\"---\\r\\n\"):\n45\t        return False\n46\t    body_start = 4 if text.startswith(\"---\\n\") else 5\n47\t    closing = text.find(\"\\n---\", body_start)\n48\t    if closing == -1:\n49\t        return False\n50\t    fm_block = text[body_start:closing]\n51\t    return bool(re.search(r\"^name:\\s*\\S+\", fm_block, flags=re.MULTILINE))\n52\t\n53\t\n54\t\n55\tdef _skill_ref_parse_sentinel(\n56\t    sanitized: str,\n57\t) -> Tuple[Optional[Tuple[bool, Optional[str], Optional[str]]], Optional[str], Optional[str]]:\n58\t    \"\"\"Sub-checks 1-2: locate `## SKILL REFERENCE` header + body.\n59\t\n60\t    Returns ``(error_tuple, raw_path, expected_hash)``. On failure,\n61\t    ``error_tuple`` is populated and the other fields are None.\n62\t    \"\"\"\n63\t    if not _SKILL_REFERENCE_HEADER_RE.search(sanitized):\n64\t        return (\n65\t            (False, REASON_REFERENCE_MISSING, \"no `## SKILL REFERENCE` header\"),\n66\t            None,\n67\t            None,\n68\t        )\n69\t    body_match = _SKILL_REFERENCE_LINE_RE.search(sanitized)\n70\t    if not body_match:\n71\t        return (\n72\t            (\n73\t                False,\n74\t                REASON_REFERENCE_MISSING,\n75\t                \"header found but no `@<path> sha256=<hex>` body\",\n76\t            ),\n77\t            None,\n78\t            None,\n79\t        )\n80\t    return None, body_match.group(\"path\"), body_match.group(\"hash\").lower()\n81\t\n82\t\n83\t\n84\tdef _skill_ref_resolve_path(\n85\t    raw_path: str,\n86\t    repo_root: Path,\n87\t) -> Tuple[Optional[Tuple[bool, Optional[str], Optional[str]]], Optional[Path], Optional[Path]]:\n88\t    \"\"\"Sub-checks 3-5: resolve path, confirm under skills root, filename = SKILL.md, not symlink.\n89\t\n90\t    Returns ``(error_tuple, candidate, resolved)``. On failure, the\n91\t    latter two are None.\n92\t    \"\"\"\n93\t    skills_root = (repo_root / \".claude\" / \"skills\").resolve()\n94\t    candidate = Path(raw_path)\n95\t    if not candidate.is_absolute():\n96\t        candidate = repo_root / raw_path\n97\t    try:\n98\t        resolved = candidate.resolve(strict=True)\n99\t    except (FileNotFoundError, OSError) as exc:\n100\t        return (\n101\t            (False, REASON_REFERENCE_MISSING, f\"resolve failed: {exc}\"),\n102\t            None,\n103\t            None,\n104\t        )\n105\t    try:\n106\t        resolved.relative_to(skills_root)\n107\t    except ValueError:\n108\t        return (\n109\t            (\n110\t                False,\n111\t                REASON_REFERENCE_OUTSIDE_SKILLS_ROOT,\n112\t                f\"{resolved} not under {skills_root}\",\n113\t            ),\n114\t            None,\n115\t            None,\n116\t        )\n117\t    if resolved.name != \"SKILL.md\":\n118\t        return (\n119\t            (\n120\t                False,\n121\t                REASON_REFERENCE_WRONG_FILENAME,\n122\t                f\"filename is {resolved.name!r}, expected 'SKILL.md'\",\n123\t            ),\n124\t            None,\n125\t            None,\n126\t        )\n127\t    if candidate.is_symlink():\n128\t        return (\n129\t            (\n130\t                False,\n131\t                REASON_REFERENCE_SYMLINK_REFUSED,\n132\t                f\"{candidate} is a symlink\",\n133\t            ),\n134\t            None,\n135\t            None,\n136\t        )\n137\t    return None, candidate, resolved\n138\t\n139\t\n140\t\n141\tdef _skill_ref_validate_unicode(\n142\t    candidate: Path,\n143\t) -> Optional[Tuple[bool, Optional[str], Optional[str]]]:\n144\t    \"\"\"Sub-check 6: NFC unicode normalization. Returns error_tuple or None.\"\"\"\n145\t    raw_str = str(candidate)\n146\t    nfc_str = unicodedata.normalize(\"NFC\", raw_str)\n147\t    if nfc_str != raw_str:\n148\t        return (\n149\t            False,\n150\t            REASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH,\n151\t            \"path not NFC-normalized\",\n152\t        )\n153\t    return None\n154\t\n155\t\n156\t\n157\tdef _skill_ref_read_bounded(\n158\t    resolved: Path,\n159\t) -> Tuple[Optional[Tuple[bool, Optional[str], Optional[str]]], Optional[bytes], Optional[str]]:\n160\t    \"\"\"Sub-checks 7-8: size cap + body floor on non-ws bytes.\n161\t\n162\t    Returns ``(error_tuple, content_bytes, decoded_text)``.\n163\t    \"\"\"\n164\t    try:\n165\t        size = resolved.stat().st_size\n166\t    except OSError as exc:\n167\t        return (\n168\t            (False, REASON_REFERENCE_MISSING, f\"stat failed: {exc}\"),\n169\t            None,\n170\t            None,\n171\t        )\n172\t    if size > _SKILL_REFERENCE_MAX_BYTES:\n173\t        return (\n174\t            (\n175\t                False,\n176\t                REASON_REFERENCE_TOO_LARGE,\n177\t                f\"{size} bytes > {_SKILL_REFERENCE_MAX_BYTES} cap\",\n178\t            ),\n179\t            None,\n180\t            None,\n181\t        )\n182\t    try:\n183\t        content_bytes = resolved.read_bytes()\n184\t    except OSError as exc:\n185\t        return (\n186\t            (False, REASON_REFERENCE_MISSING, f\"read failed: {exc}\"),\n187\t            None,\n188\t            None,\n189\t        )\n190\t    try:\n191\t        text = content_bytes.decode(\"utf-8\")\n192\t    except UnicodeDecodeError as exc:\n193\t        return (\n194\t            (False, REASON_REFERENCE_MISSING_FRONTMATTER, f\"decode: {exc}\"),\n195\t            None,\n196\t            None,\n197\t        )\n198\t    non_ws = sum(1 for c in text if not c.isspace())\n199\t    if non_ws < _SKILL_REFERENCE_MIN_BODY_BYTES:\n200\t        return (\n201\t            (\n202\t                False,\n203\t                REASON_REFERENCE_BYTE_FLOOR_UNDERFLOW,\n204\t                f\"{non_ws} non-ws bytes < {_SKILL_REFERENCE_MIN_BODY_BYTES} floor\",\n205\t            ),\n206\t            None,\n207\t            None,\n208\t        )\n209\t    return None, content_bytes, text\n210\t\n211\t\n212\t\n213\tdef _skill_ref_validate_frontmatter(\n214\t    text: str,\n215\t) -> Optional[Tuple[bool, Optional[str], Optional[str]]]:\n216\t    \"\"\"Sub-check 9: YAML frontmatter parseable + has `name:` key.\"\"\"\n217\t    if not _has_valid_frontmatter_with_name(text):\n218\t        return (\n219\t            False,\n220\t            REASON_REFERENCE_MISSING_FRONTMATTER,\n221\t            \"missing or malformed YAML frontmatter / no `name:` key\",\n222\t        )\n223\t    return None\n224\t\n225\t\n226\t\n227\tdef _skill_ref_validate_hash_and_redact(\n228\t    content_bytes: bytes,\n229\t    text: str,\n230\t    expected_hash: str,\n231\t) -> Optional[Tuple[bool, Optional[str], Optional[str]]]:\n232\t    \"\"\"Sub-checks 10-11: SHA-256 match + redaction scan.\n233\t\n234\t    Per PLAN-025 F-perf-006: SHA-256 on reference-mode skill content\n235\t    costs ~1ms for a 5KB skill per invocation. Acceptable at current\n236\t    spawn volumes.\n237\t\n238\t    Per Session 32 bugfix: `_redact.redact_secrets` whitespace-collapses\n239\t    output, so direct string compare would always mismatch. Instead\n240\t    we check for the specific secret-indicator tokens that only appear\n241\t    when a pattern matched.\n242\t    \"\"\"\n243\t    actual_hash = hashlib.sha256(content_bytes).hexdigest()\n244\t    if actual_hash != expected_hash:\n245\t        return (\n246\t            False,\n247\t            REASON_REFERENCE_HASH_MISMATCH,\n248\t            f\"expected {expected_hash[:8]}..., got {actual_hash[:8]}...\",\n249\t        )\n250\t    redacted = _redact.redact_secrets(text)\n251\t    if any(tok in redacted for tok in _SECRET_TOKENS_IN_OUTPUT):\n252\t        return (\n253\t            False,\n254\t            REASON_REFERENCE_REDACTION_HIT,\n255\t            \"secret pattern detected in skill content\",\n256\t        )\n257\t    return None\n258\t\n259\t\n260\t\n261\tdef _validate_skill_reference(\n262\t    prompt: str,\n263\t    repo_root: Optional[Path] = None,\n264\t) -> Tuple[bool, Optional[str], Optional[str]]:\n265\t    \"\"\"Validate `## SKILL REFERENCE` sentinel via 11 synchronous sub-checks.\n266\t\n267\t    Refactored (PLAN-050 Phase 1b F-02-03-e) into 6 named helpers for\n268\t    readability + per-check test coverage. Same contract: fail-CLOSED\n269\t    on any failure, sub-check order preserved from ADR-051 §Synchronous\n270\t    validation (sub-check 11 = redaction scan added Session 32;\n271\t    PLAN-024 F-hooks-003 doc drift close).\n272\t    \"\"\"\n273\t    if not prompt or not isinstance(prompt, str):\n274\t        return False, REASON_REFERENCE_MISSING, \"empty prompt\"\n275\t\n276\t    sanitized = _strip_fenced_and_comments(prompt)\n277\t\n278\t    err, raw_path, expected_hash = _skill_ref_parse_sentinel(sanitized)\n279\t    if err:\n280\t        return err\n281\t\n282\t    if repo_root is None:\n283\t        repo_root = Path(\n284\t            os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n285\t        )\n286\t\n287\t    err, candidate, resolved = _skill_ref_resolve_path(raw_path, repo_root)\n288\t    if err:\n289\t        return err\n290\t\n291\t    err = _skill_ref_validate_unicode(candidate)\n292\t    if err:\n293\t        return err\n294\t\n295\t    err, content_bytes, text = _skill_ref_read_bounded(resolved)\n296\t    if err:\n297\t        return err\n298\t\n299\t    err = _skill_ref_validate_frontmatter(text)\n300\t    if err:\n301\t        return err\n302\t\n303\t    err = _skill_ref_validate_hash_and_redact(\n304\t        content_bytes, text, expected_hash\n305\t    )\n306\t    if err:\n307\t        return err\n308\t\n309\t    return True, None, None\n310\t\n311\t\n312\t\n313\tdef _has_skill_reference(\n314\t    prompt: str,\n315\t    repo_root: Optional[Path] = None,\n316\t) -> bool:\n317\t    \"\"\"Backward-compat wrapper: True iff reference passes all sub-checks.\"\"\"\n318\t    ok, _, _ = _validate_skill_reference(prompt, repo_root=repo_root)\n319\t    return ok\n320\t"}]},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"5eaa225b-572a-4b8b-8809-919655d9e1cd","timestamp":"2026-11-15T10:41:26.012Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/skill_reference.py","content":"\"\"\"Skill-reference parsing, path validation and content integrity.\n\nBound to the public hook namespace by this package at import time.\n\"\"\"\nfrom __future__ import annotations\n\n__all__ = (\n    '_is_enabled',\n    '_has_valid_frontmatter_with_name',\n    '_skill_ref_parse_sentinel',\n    '_skill_ref_resolve_path',\n    '_skill_ref_validate_unicode',\n    '_skill_ref_read_bounded',\n    '_skill_ref_validate_frontmatter',\n    '_skill_ref_validate_hash_and_redact',\n    '_validate_skill_reference',\n    '_has_skill_reference',\n)\n\n\ndef _is_enabled(env_var: str, default: bool, env: Optional[dict] = None) -> bool:\n    \"\"\"Live read of an env-var toggle with a module default fallback.\n\n    Allows runtime opt-out via env (`CEO_SKILL_REFERENCE_MODE=0`,\n    `CEO_NATIVE_SUBAGENTS=0`) without restarting Claude Code.\n    `CEO_SOTA_DISABLE=1` is the master kill — overrides everything.\n    \"\"\"\n    src_env = env if env is not None else os.environ\n    if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n        return False\n    raw = (src_env.get(env_var) or \"\").strip()\n    if raw == \"\":\n        return default\n    return raw not in (\"0\", \"false\", \"FALSE\", \"False\", \"no\", \"off\")\n\n\n\ndef _has_valid_frontmatter_with_name(text: str) -> bool:\n    \"\"\"Stdlib-only frontmatter parser (no PyYAML).\n\n    Returns True iff the file starts with `---` on first line, has a\n    closing `---` line, and has at least one `name: <value>` line.\n    \"\"\"\n    if not text.startswith(\"---\\n\") and not text.startswith(\"---\\r\\n\"):\n        return False\n    body_start = 4 if text.startswith(\"---\\n\") else 5\n    closing = text.find(\"\\n---\", body_start)\n    if closing == -1:\n        return False\n    fm_block = text[body_start:closing]\n    return bool(re.search(r\"^name:\\s*\\S+\", fm_block, flags=re.MULTILINE))\n\n\n\ndef _skill_ref_parse_sentinel(\n    sanitized: str,\n) -> Tuple[Optional[Tuple[bool, Optional[str], Optional[str]]], Optional[str], Optional[str]]:\n    \"\"\"Sub-checks 1-2: locate `## SKILL REFERENCE` header + body.\n\n    Returns ``(error_tuple, raw_path, expected_hash)``. On failure,\n    ``error_tuple`` is populated and the other fields are None.\n    \"\"\"\n    if not _SKILL_REFERENCE_HEADER_RE.search(sanitized):\n        return (\n            (False, REASON_REFERENCE_MISSING, \"no `## SKILL REFERENCE` header\"),\n            None,\n            None,\n        )\n    body_match = _SKILL_REFERENCE_LINE_RE.search(sanitized)\n    if not body_match:\n        return (\n            (\n                False,\n                REASON_REFERENCE_MISSING,\n                \"header found but no `@<path> sha256=<hex>` body\",\n            ),\n            None,\n            None,\n        )\n    return None, body_match.group(\"path\"), body_match.group(\"hash\").lower()\n\n\n\ndef _skill_ref_resolve_path(\n    raw_path: str,\n    repo_root: Path,\n) -> Tuple[Optional[Tuple[bool, Optional[str], Optional[str]]], Optional[Path], Optional[Path]]:\n    \"\"\"Sub-checks 3-5: resolve path, confirm under skills root, filename = SKILL.md, not symlink.\n\n    Returns ``(error_tuple, candidate, resolved)``. On failure, the\n    latter two are None.\n    \"\"\"\n    skills_root = (repo_root / \".claude\" / \"skills\").resolve()\n    candidate = Path(raw_path)\n    if not candidate.is_absolute():\n        candidate = repo_root / raw_path\n    try:\n        resolved = candidate.resolve(strict=True)\n    except (FileNotFoundError, OSError) as exc:\n        return (\n            (False, REASON_REFERENCE_MISSING, f\"resolve failed: {exc}\"),\n            None,\n            None,\n        )\n    try:\n        resolved.relative_to(skills_root)\n    except ValueError:\n        return (\n            (\n                False,\n                REASON_REFERENCE_OUTSIDE_SKILLS_ROOT,\n                f\"{resolved} not under {skills_root}\",\n            ),\n            None,\n            None,\n        )\n    if resolved.name != \"SKILL.md\":\n        return (\n            (\n                False,\n                REASON_REFERENCE_WRONG_FILENAME,\n                f\"filename is {resolved.name!r}, expected 'SKILL.md'\",\n            ),\n            None,\n            None,\n        )\n    if candidate.is_symlink():\n        return (\n            (\n                False,\n                REASON_REFERENCE_SYMLINK_REFUSED,\n                f\"{candidate} is a symlink\",\n            ),\n            None,\n            None,\n        )\n    return None, candidate, resolved\n\n\n\ndef _skill_ref_validate_unicode(\n    candidate: Path,\n) -> Optional[Tuple[bool, Optional[str], Optional[str]]]:\n    \"\"\"Sub-check 6: NFC unicode normalization. Returns error_tuple or None.\"\"\"\n    raw_str = str(candidate)\n    nfc_str = unicodedata.normalize(\"NFC\", raw_str)\n    if nfc_str != raw_str:\n        return (\n            False,\n            REASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH,\n            \"path not NFC-normalized\",\n        )\n    return None\n\n\n\ndef _skill_ref_read_bounded(\n    resolved: Path,\n) -> Tuple[Optional[Tuple[bool, Optional[str], Optional[str]]], Optional[bytes], Optional[str]]:\n    \"\"\"Sub-checks 7-8: size cap + body floor on non-ws bytes.\n\n    Returns ``(error_tuple, content_bytes, decoded_text)``.\n    \"\"\"\n    try:\n        size = resolved.stat().st_size\n    except OSError as exc:\n        return (\n            (False, REASON_REFERENCE_MISSING, f\"stat failed: {exc}\"),\n            None,\n            None,\n        )\n    if size > _SKILL_REFERENCE_MAX_BYTES:\n        return (\n            (\n                False,\n                REASON_REFERENCE_TOO_LARGE,\n                f\"{size} bytes > {_SKILL_REFERENCE_MAX_BYTES} cap\",\n            ),\n            None,\n            None,\n        )\n    try:\n        content_bytes = resolved.read_bytes()\n    except OSError as exc:\n        return (\n            (False, REASON_REFERENCE_MISSING, f\"read failed: {exc}\"),\n            None,\n            None,\n        )\n    try:\n        text = content_bytes.decode(\"utf-8\")\n    except UnicodeDecodeError as exc:\n        return (\n            (False, REASON_REFERENCE_MISSING_FRONTMATTER, f\"decode: {exc}\"),\n            None,\n            None,\n        )\n    non_ws = sum(1 for c in text if not c.isspace())\n    if non_ws < _SKILL_REFERENCE_MIN_BODY_BYTES:\n        return (\n            (\n                False,\n                REASON_REFERENCE_BYTE_FLOOR_UNDERFLOW,\n                f\"{non_ws} non-ws bytes < {_SKILL_REFERENCE_MIN_BODY_BYTES} floor\",\n            ),\n            None,\n            None,\n        )\n    return None, content_bytes, text\n\n\n\ndef _skill_ref_validate_frontmatter(\n    text: str,\n) -> Optional[Tuple[bool, Optional[str], Optional[str]]]:\n    \"\"\"Sub-check 9: YAML frontmatter parseable + has `name:` key.\"\"\"\n    if not _has_valid_frontmatter_with_name(text):\n        return (\n            False,\n            REASON_REFERENCE_MISSING_FRONTMATTER,\n            \"missing or malformed YAML frontmatter / no `name:` key\",\n        )\n    return None\n\n\n\ndef _skill_ref_validate_hash_and_redact(\n    content_bytes: bytes,\n    text: str,\n    expected_hash: str,\n) -> Optional[Tuple[bool, Optional[str], Optional[str]]]:\n    \"\"\"Sub-checks 10-11: SHA-256 match + redaction scan.\n\n    Per PLAN-025 F-perf-006: SHA-256 on reference-mode skill content\n    costs ~1ms for a 5KB skill per invocation. Acceptable at current\n    spawn volumes.\n\n    Per Session 32 bugfix: `_redact.redact_secrets` whitespace-collapses\n    output, so direct string compare would always mismatch. Instead\n    we check for the specific secret-indicator tokens that only appear\n    when a pattern matched.\n    \"\"\"\n    actual_hash = hashlib.sha256(content_bytes).hexdigest()\n    if actual_hash != expected_hash:\n        return (\n            False,\n            REASON_REFERENCE_HASH_MISMATCH,\n            f\"expected {expected_hash[:8]}..., got {actual_hash[:8]}...\",\n        )\n    redacted = _redact.redact_secrets(text)\n    if any(tok in redacted for tok in _SECRET_TOKENS_IN_OUTPUT):\n        return (\n            False,\n            REASON_REFERENCE_REDACTION_HIT,\n            \"secret pattern detected in skill content\",\n        )\n    return None\n\n\n\ndef _validate_skill_reference(\n    prompt: str,\n    repo_root: Optional[Path] = None,\n) -> Tuple[bool, Optional[str], Optional[str]]:\n    \"\"\"Validate `## SKILL REFERENCE` sentinel via 11 synchronous sub-checks.\n\n    Refactored (PLAN-050 Phase 1b F-02-03-e) into 6 named helpers for\n    readability + per-check test coverage. Same contract: fail-CLOSED\n    on any failure, sub-check order preserved from ADR-051 §Synchronous\n    validation (sub-check 11 = redaction scan added Session 32;\n    PLAN-024 F-hooks-003 doc drift close).\n    \"\"\"\n    if not prompt or not isinstance(prompt, str):\n        return False, REASON_REFERENCE_MISSING, \"empty prompt\"\n\n    sanitized = _strip_fenced_and_comments(prompt)\n\n    err, raw_path, expected_hash = _skill_ref_parse_sentinel(sanitized)\n    if err:\n        return err\n\n    if repo_root is None:\n        repo_root = Path(\n            os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        )\n\n    err, candidate, resolved = _skill_ref_resolve_path(raw_path, repo_root)\n    if err:\n        return err\n\n    err = _skill_ref_validate_unicode(candidate)\n    if err:\n        return err\n\n    err, content_bytes, text = _skill_ref_read_bounded(resolved)\n    if err:\n        return err\n\n    err = _skill_ref_validate_frontmatter(text)\n    if err:\n        return err\n\n    err = _skill_ref_validate_hash_and_redact(\n        content_bytes, text, expected_hash\n    )\n    if err:\n        return err\n\n    return True, None, None\n\n\n\ndef _has_skill_reference(\n    prompt: str,\n    repo_root: Optional[Path] = None,\n) -> bool:\n    \"\"\"Backward-compat wrapper: True iff reference passes all sub-checks.\"\"\"\n    ok, _, _ = _validate_skill_reference(prompt, repo_root=repo_root)\n    return ok\n","numLines":320,"startLine":1,"totalLines":320}},"tool_result_meta":[{"id":"toolu_0159ZLcjdej15EDMf2Ue4dRc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4aBmhHMvVswVM4Emqi7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017trKodHePwLt8fuN8beAs7","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/file_assignment.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1626,"cache_read_input_tokens":75696,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1626},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"ae43435c-f0a3-4611-a30f-c6cfc51e6724","timestamp":"2026-11-15T10:41:27.210Z","request_id":"req_011Ch4aBmTtoiFLW1arKk2LX","wire_tool_inputs":{"toolu_017trKodHePwLt8fuN8beAs7":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/file_assignment.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017trKodHePwLt8fuN8beAs7","type":"tool_result","content":"1\t\"\"\"Spawn tool scope, depth and file-assignment enforcement.\n2\t\n3\tBound to the public hook namespace by this package at import time.\n4\t\"\"\"\n5\tfrom __future__ import annotations\n6\t\n7\t_OVERLAP_LOOKBACK_S = 600          # 10-minute concurrency window\n8\t\n9\t__all__ = (\n10\t    '_OVERLAP_LOOKBACK_S',\n11\t    '_fa_suffix_has_authority',\n12\t    '_fa_list_line_allowed',\n13\t    '_parse_tool_allowlist',\n14\t    '_requested_tools',\n15\t    '_check_tool_scope',\n16\t    '_spawn_depth',\n17\t    '_classify_file_assignment',\n18\t    '_parse_file_assignment',\n19\t    '_path_hash',\n20\t    '_recent_file_assignments',\n21\t    '_enforce_spawn_rails',\n22\t    '_emit_tool_scope_violation',\n23\t    '_emit_depth_or_overlap',\n24\t    '_emit_file_assignment_recorded',\n25\t)\n26\t\n27\t\n28\tdef _fa_suffix_has_authority(suffix: str) -> bool:\n29\t    \"\"\"True when the prose suffix carries a bare authority word.\"\"\"\n30\t    for tok in suffix.split():\n31\t        if \"/\" in tok or \".\" in tok:\n32\t            continue  # path-like token — filename parts are not authority\n33\t        if tok.strip(\";:,()[]{}'\\\"!?-\").lower() in _FA_AUTHORITY_WORDS:\n34\t            return True\n35\t    return False\n36\t\n37\t\n38\t\n39\tdef _fa_list_line_allowed(line: str) -> bool:\n40\t    \"\"\"Closed whitelist for list lines inside a FILE ASSIGNMENT block.\n41\t\n42\t    Anchored semantics (codex r33+r34 P1): a PROSE form may not smuggle\n43\t    ANY edit grant in its suffix — `- MAY read docs; MUST edit x` and\n44\t    `- If you need permission: CAN edit: x` are tainted, not laundered.\n45\t    Each prose prefix consumes its own `edit` (when it has one); any\n46\t    FURTHER `edit` word after the matched prefix rejects the line.\n47\t    \"\"\"\n48\t    if _FA_ALLOWED_GRANT_LINE_RE.match(line):\n49\t        return True\n50\t    m = _FA_ALLOWED_PROSE_LINE_RE.match(line)\n51\t    if m:\n52\t        return not _fa_suffix_has_authority(line[m.end():])\n53\t    return False\n54\t\n55\t\n56\t\n57\tdef _parse_tool_allowlist(prompt: str) -> Optional[frozenset]:\n58\t    \"\"\"Return the declared lowercase tool allow-list, or None if no\n59\t    `## TOOL ALLOW-LIST` block is present (= unrestricted, back-compat).\n60\t\n61\t    Pure. Never raises. Bounded to the block between its header and the next\n62\t    `##` heading. Only KNOWN tool names are retained; unknown tokens dropped\n63\t    (so a typo cannot create a phantom allow-list that blocks everything).\n64\t    \"\"\"\n65\t    if not prompt:\n66\t        return None\n67\t    sanitized = _strip_fenced_and_comments(prompt)\n68\t    m = _TOOL_ALLOWLIST_HEADER_RE.search(sanitized)\n69\t    if m is None:\n70\t        return None\n71\t    block_start = m.end()\n72\t    nxt = _NEXT_H2_RE.search(sanitized, block_start)\n73\t    block = sanitized[block_start: nxt.start() if nxt else len(sanitized)]\n74\t    allowed = set()\n75\t    for bm in _TOOL_BULLET_RE.finditer(block):\n76\t        for tok in bm.group(1).replace(\",\", \" \").split():\n77\t            t = tok.strip().lower()\n78\t            if t in _KNOWN_TOOL_NAMES:\n79\t                allowed.add(t)\n80\t    # An empty-but-present block = \"deny all known tools\" (intentional).\n81\t    return frozenset(allowed)\n82\t\n83\t\n84\t\n85\tdef _requested_tools(prompt: str) -> frozenset:\n86\t    \"\"\"Heuristic set of KNOWN tools this spawn appears to request.\n87\t\n88\t    First-hit per family, bounded scan. Conservative (high-signal verbs only).\n89\t    Pure; never raises.\n90\t    \"\"\"\n91\t    if not prompt:\n92\t        return frozenset()\n93\t    text = _strip_fenced_and_comments(prompt)[:_TOOL_SCAN_WINDOW].lower()\n94\t    out = set()\n95\t    for tool, hints in _TOOL_REQUEST_HINTS:\n96\t        if any(h in text for h in hints):\n97\t            out.add(tool)\n98\t    return frozenset(out)\n99\t\n100\t\n101\t\n102\tdef _check_tool_scope(\n103\t    prompt: str,\n104\t) -> Optional[Tuple[str, str]]:\n105\t    \"\"\"Rail 1. Return (reason_code, detail) if a requested tool is OUTSIDE\n106\t    the declared allow-list, else None.\n107\t\n108\t    `detail` NEVER contains a path or the raw prompt — only the offending\n109\t    tool NAME(s) (a closed-enum-safe value) + counts. No-value-echo safe.\n110\t    \"\"\"\n111\t    allow = _parse_tool_allowlist(prompt)\n112\t    if allow is None:\n113\t        return None  # no declared scope -> unrestricted (back-compat)\n114\t    requested = _requested_tools(prompt)\n115\t    out_of_scope = sorted(requested - allow)\n116\t    if not out_of_scope:\n117\t        return None\n118\t    return (\n119\t        \"spawn_tool_out_of_scope\",\n120\t        f\"tools={','.join(out_of_scope)} declared={len(allow)}\",\n121\t    )\n122\t\n123\t\n124\t\n125\tdef _spawn_depth(prompt: str, env: Dict[str, str]) -> int:\n126\t    \"\"\"Best-effort current spawn depth. 0 = top-level CEO spawn.\n127\t\n128\t    Two independent signals, max() wins (fail-toward-detection):\n129\t      - `## SUBAGENT-CONTEXT depth=N` marker in the prompt (CEO-injected when\n130\t        delegating to a sub-agent that may itself coordinate).\n131\t      - `CEO_SPAWN_DEPTH` env breadcrumb (harness/CEO-set).\n132\t    Pure-ish (reads env dict only). Never raises.\n133\t    \"\"\"\n134\t    depth = 0\n135\t    try:\n136\t        m = _SUBAGENT_DEPTH_MARKER_RE.search(prompt or \"\")\n137\t        if m:\n138\t            depth = max(depth, int(m.group(1)))\n139\t    except Exception:  # pragma: no cover - fail-open\n140\t        pass\n141\t    try:\n142\t        raw = (env.get(\"CEO_SPAWN_DEPTH\") or \"\").strip()\n143\t        if raw.isdigit():\n144\t            depth = max(depth, int(raw))\n145\t    except Exception:  # pragma: no cover - fail-open\n146\t        pass\n147\t    return depth\n148\t\n149\t\n150\t\n151\tdef _classify_file_assignment(prompt: str) -> Tuple[str, frozenset]:\n152\t    \"\"\"Classify the spawn's `## FILE ASSIGNMENT` declaration (PLAN-178 C1).\n153\t\n154\t    Returns ``(state, concrete_paths)`` with ``state`` in a closed enum:\n155\t\n156\t    - ``\"absent\"``      — no `## FILE ASSIGNMENT` header in the sanitized\n157\t      prompt (fenced/comment content never counts — same masking rule as\n158\t      every other block parser in this hook).\n159\t    - ``\"concrete\"``    — >=1 concrete `CAN edit:` path AND zero dropped\n160\t      tokens (codex r15 P1: `safe.py, src/**` must NOT classify concrete —\n161\t      the agent still READS the wildcard grant while telemetry records\n162\t      only the concrete path; any dropped token taints the whole\n163\t      declaration to unparseable).\n164\t    - ``\"readonly\"``    — explicit `CAN edit: NONE-READ-ONLY` and no\n165\t      concrete path. Case-insensitive token match; conformant.\n166\t    - ``\"unparseable\"`` — header(s) present but no concrete path and no\n167\t      explicit read-only token (wildcard-only / placeholder-only / empty\n168\t      block). Named rejection under enforce (ADR-191 §1, B nice-4).\n169\t\n170\t    ALL `## FILE ASSIGNMENT` blocks in the prompt are aggregated (codex\n171\t    r2 P1, Lote B): the canonical generator emits an unconditional block\n172\t    and documented caller flows (/spawn, /debate) APPEND their own\n173\t    concrete block afterwards — reading only the first block would hide\n174\t    the writer's paths from overlap telemetry AND enforcement. Union of\n175\t    concrete paths wins over a read-only declaration in any block.\n176\t\n177\t    Pure. Never raises. Bounded to _OVERLAP_MAX_PATHS.\n178\t    \"\"\"\n179\t    if not prompt:\n180\t        return (\"absent\", frozenset())\n181\t    # CommonMark-correct fence mask FIRST (raw prompt), THEN the shared\n182\t    # comment/fence stripper — order matters: the shared toggle-masker\n183\t    # mis-parses length/type-mismatched fences (codex r35 P1).\n184\t    sanitized = _FA_FENCE_RE.sub(\"\", prompt)\n185\t    sanitized = _strip_fenced_and_comments(sanitized)\n186\t    # Unclosed HTML comment extends to EOF (codex r39 P2): the shared\n187\t    # stripper removes only CLOSED <!-- --> pairs — an unclosed opener\n188\t    # would leave commented-out content visible to this classifier.\n189\t    _oc = sanitized.find(\"<!--\")\n190\t    if _oc != -1 and \"-->\" not in sanitized[_oc:]:\n191\t        sanitized = sanitized[:_oc]\n192\t    headers = list(_FILE_ASSIGNMENT_HEADER_RE.finditer(sanitized))\n193\t    # Block bound recognizes 0-3-space-indented H2 too (codex r33 P2) —\n194\t    # otherwise an indented `## TASK` leaves task bullets INSIDE the\n195\t    # assignment parser. Local to this classifier.\n196\t    _fa_next_h2 = re.compile(r\"^[ ]{0,3}##[ \\t]\", flags=re.MULTILINE)\n197\t    if not headers:\n198\t        return (\"absent\", frozenset())\n199\t    paths = set()\n200\t    readonly_declared = False\n201\t    invalid_seen = False\n202\t    for m in headers:\n203\t        block_start = m.end()\n204\t        nxt = _fa_next_h2.search(sanitized, block_start)\n205\t        block = sanitized[\n206\t            block_start: nxt.start() if nxt else len(sanitized)\n207\t        ]\n208\t        block_had_line = False\n209\t        for list_line in _FA_LIST_LINE_RE.finditer(block):\n210\t            if not _fa_list_line_allowed(list_line.group(0)):\n211\t                # Structural rule (codex r25→r32): an unrecognized list\n212\t                # line inside the block is authority/instruction the\n213\t                # parser did not validate — taint, whatever its phrasing.\n214\t                invalid_seen = True\n215\t        for lm in _CAN_EDIT_LINE_RE.finditer(block):\n216\t            block_had_line = True\n217\t            for raw in lm.group(1).split(\",\"):\n218\t                p = raw.strip().strip(\"`\").strip()\n219\t                if not p:\n220\t                    continue\n221\t                if p.lower() == _FA_READONLY_TOKEN:\n222\t                    # Explicit read-only form — never a concrete path,\n223\t                    # never a hashable overlap participant (guaranteed by\n224\t                    # this branch running BEFORE the concrete-path add).\n225\t                    readonly_declared = True\n226\t                    continue\n227\t                # Drop placeholders + wildcards (cannot prove a clobber).\n228\t                # Angle brackets included (codex r1 P2): a scaffold literal\n229\t                # like `CAN edit: <concrete paths>` must classify\n230\t                # unparseable, not concrete — especially since the hook's\n231\t                # own block message shows that exact scaffold string.\n232\t                # Every drop marks the declaration TAINTED (codex r14 P1):\n233\t                # an earlier NONE-READ-ONLY must not hide a later wildcard\n234\t                # grant the agent still READS in its prompt.\n235\t                # ALL glob/expansion syntax rejected ANYWHERE in the\n236\t                # token (codex r19 P1): `src/?.py`, `src/[ab].py` and\n237\t                # `src/{a,b}.py` are multi-file grants the agent reads\n238\t                # while telemetry hashes only literal tokens (brace forms\n239\t                # additionally split into bogus comma paths upstream).\n240\t                if any(ch in p for ch in \"*?[]{}<>\") or p.lower() in (\n241\t                    \"none\", \"n/a\", \"tbd\",\n242\t                ):\n243\t                    invalid_seen = True\n244\t                    continue\n245\t                # Codex r9 P2: filesystem paths cannot carry NUL/control\n246\t                # chars — a crafted value could otherwise classify as\n247\t                # concrete AND hash into the domain-separated read-only\n248\t                # telemetry marker (which is NUL-framed precisely so real\n249\t                # paths can never reach it). Reject, do not sanitize.\n250\t                # Broad prose (\"all files\", \"any path\") and shell-\n251\t                # expansion forms (\"$HOME/...\") are NOT concrete paths\n252\t                # (codex r31 P1): a concrete grant in this grammar has no\n253\t                # spaces and no `$` — declared in ADR-191 §2.1.\n254\t                if any(ch.isspace() for ch in p) or \"$\" in p:\n255\t                    invalid_seen = True\n256\t                    continue\n257\t                # Unicode line/paragraph separators included (codex r28\n258\t                # P1): U+0085 NEL, U+2028 LS, U+2029 PS present injected\n259\t                # prompt STRUCTURE to the agent while hashing as one path\n260\t                # — and CEO_UNICODE_HARDBLOCK may be unset.\n261\t                if any(\n262\t                    ord(ch) < 32\n263\t                    or ch in (\"\\x7f\", \"\\u0085\", \"\\u2028\", \"\\u2029\")\n264\t                    for ch in p\n265\t                ):\n266\t                    invalid_seen = True\n267\t                    continue\n268\t                # Normalize: strip a leading ./, collapse; POSIX paths are\n269\t                # case-sensitive so keep case, normalize separators only.\n270\t                p = p.lstrip(\"./\").replace(\"\\\\\", \"/\")\n271\t                if not p:\n272\t                    # Codex r3 P1: `...` / `./` normalize to \"\" — an empty\n273\t                    # \"path\" must never make the declaration concrete (it\n274\t                    # would record path_count=1 and hide a would-block\n275\t                    # input from the advisory window).\n276\t                    invalid_seen = True\n277\t                    continue\n278\t                # Cap STORED paths without stopping the scan (codex r16\n279\t                # P1). Exceeding the cap TAINTS the declaration (codex r31\n280\t                # P2): silently dropping path 65+ would hide granted\n281\t                # authority from the overlap guard — an assignment that\n282\t                # large is a partition smell anyway.\n283\t                if len(paths) < _OVERLAP_MAX_PATHS:\n284\t                    paths.add(p)\n285\t                else:\n286\t                    invalid_seen = True\n287\t        if not block_had_line:\n288\t            # Codex r23 P1: an appended block with ZERO parseable\n289\t            # `CAN edit:` lines (`- MAY edit: ...`, misspellings, empty)\n290\t            # is a write grant the agent READS but the parser never saw —\n291\t            # it must taint the declaration, not vanish behind an earlier\n292\t            # read-only block.\n293\t            invalid_seen = True\n294\t    if paths and not invalid_seen:\n295\t        return (\"concrete\", frozenset(paths))\n296\t    if readonly_declared and not paths and not invalid_seen:\n297\t        return (\"readonly\", frozenset())\n298\t    # ANY dropped token taints the WHOLE declaration (codex r14+r15 P1):\n299\t    # a readonly token or a valid path must not launder a wildcard/\n300\t    # placeholder/control-char grant past the enforce gate — the agent\n301\t    # still READ that grant in its prompt. Mixed declarations classify\n302\t    # unparseable; concrete paths are still returned for overlap\n303\t    # telemetry (recording them costs nothing and keeps the collision\n304\t    # detector informed even on a tainted spawn).\n305\t    return (\"unparseable\", frozenset(paths))\n306\t\n307\t\n308\t\n309\tdef _parse_file_assignment(prompt: str) -> frozenset:\n310\t    \"\"\"Return the set of concrete `CAN edit:` paths declared in the spawn's\n311\t    `## FILE ASSIGNMENT` block. Empty set if none.\n312\t\n313\t    Back-compat thin wrapper over :func:`_classify_file_assignment` (the\n314\t    single scanner since PLAN-178 C1 — one grammar, two consumers).\n315\t    \"\"\"\n316\t    return _classify_file_assignment(prompt)[1]\n317\t\n318\t\n319\t\n320\tdef _path_hash(p: str) -> str:\n321\t    \"\"\"12-hex sha256 prefix of a path. The ONLY path representation that\n322\t    enters the audit log (no raw path body ever persists — Sec MF-3).\"\"\"\n323\t    return hashlib.sha256(p.encode(\"utf-8\", \"replace\")).hexdigest()[:12]\n324\t\n325\t\n326\t\n327\tdef _recent_file_assignments(\n328\t    env: Dict[str, str],\n329\t    session_id: str,\n330\t    max_age_s: int = _OVERLAP_LOOKBACK_S,\n331\t) -> frozenset:\n332\t    \"\"\"Tail the audit log for `CAN edit:` path-HASHES emitted by OTHER spawns\n333\t    in this session within the window. Returns a set of 12-hex path hashes.\n334\t\n335\t    Reads only `spawn_file_assignment_recorded` advisory rows (emitted at the\n336\t    allow-path of a prior spawn — see 4d). Bounded tail. Never raises; returns\n337\t    empty set on any error (fail-open -> no overlap detected -> allow).\n338\t    \"\"\"\n339\t    try:\n340\t        log_path = _audit_log_path()\n341\t        if log_path is None or not log_path.exists():\n342\t            return frozenset()\n343\t        import json as _json\n344\t        import time as _time\n345\t        with log_path.open(\"r\", encoding=\"utf-8\") as f:\n346\t            try:\n347\t                f.seek(0, 2)\n348\t                size = f.tell()\n349\t                read_back = min(size, _OVERLAP_TAIL_LINES * 2048)\n350\t                start = max(0, size - read_back)\n351\t                f.seek(start, 0)\n352\t                if start > 0:\n353\t                    f.readline()\n354\t                tail = f.readlines()\n355\t            except OSError:\n356\t                tail = f.readlines()[-_OVERLAP_TAIL_LINES:]\n357\t        now = _time.time()\n358\t        seen = set()\n359\t        for line in reversed(tail):\n360\t            try:\n361\t                ev = _json.loads(line)\n362\t            except Exception:\n363\t                continue\n364\t            if ev.get(\"action\") != \"spawn_file_assignment_recorded\":\n365\t                continue\n366\t            if session_id and ev.get(\"session_id\") != session_id:\n367\t                continue\n368\t            ts_f = _parse_event_ts(ev.get(\"ts\"))\n369\t            if ts_f is None or (now - ts_f) > max_age_s:\n370\t                continue\n371\t            ph = ev.get(\"path_hashes\")\n372\t            if isinstance(ph, str):\n373\t                for h in ph.split(\",\"):\n374\t                    h = h.strip()\n375\t                    if h:\n376\t                        seen.add(h)\n377\t        return frozenset(seen)\n378\t    except Exception:  # pragma: no cover - fail-open\n379\t        return frozenset()\n380\t\n381\t\n382\t\n383\tdef _enforce_spawn_rails(\n384\t    *,\n385\t    prompt: str,\n386\t    is_named_spawn: bool,\n387\t    env: Dict[str, str],\n388\t    session_id: str,\n389\t) -> Optional[Tuple[str, str]]:\n390\t    \"\"\"PLAN-133 E3 rails + PLAN-178 C1 FILE ASSIGNMENT grammar. Returns\n391\t    (reason_code, detail) when a rail is in ENFORCING mode (its flag=1)\n392\t    AND fires; else None.\n393\t\n394\t    In ADVISORY mode (flag unset/0) each rail still EMITS its closed-enum\n395\t    event with enforced=0 (measure-first) and returns None (allow).\n396\t\n397\t    NEVER raises. Each rail independently flagged (CEO_SPAWN_TOOL_SCOPE /\n398\t    CEO_SPAWN_DEPTH_GUARD / CEO_SPAWN_OVERLAP_GUARD /\n399\t    CEO_SPAWN_FILE_ASSIGNMENT_REQUIRED); CEO_SOTA_DISABLE=1 forces\n400\t    advisory for ALL of them — that master kill is the named, tested\n401\t    recovery route for the grammar gate (ADR-186 pattern).\n402\t    \"\"\"\n403\t    try:\n404\t        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n405\t\n406\t        def _flag(name: str) -> bool:\n407\t            if master_off:\n408\t                return False\n409\t            return (env.get(name) or \"\").strip() == \"1\"\n410\t\n411\t        # --- Rail 1: tool scope (applies to ANY spawn that declares a list) -\n412\t        scope_hit = _check_tool_scope(prompt)\n413\t        if scope_hit is not None:\n414\t            code, detail = scope_hit\n415\t            enforced = _flag(\"CEO_SPAWN_TOOL_SCOPE\")\n416\t            _emit_tool_scope_violation(detail=detail, enforced=enforced)\n417\t            if enforced:\n418\t                return (code, detail)\n419\t\n420\t        # Rails 2 + 3 only matter for NAMED spawns (a generic research task\n421\t        # neither recurses into named delegation nor partitions files).\n422\t        if is_named_spawn:\n423\t            # --- Rail 2: depth fence ---------------------------------------\n424\t            depth = _spawn_depth(prompt, env)\n425\t            if depth >= 1:\n426\t                enforced = _flag(\"CEO_SPAWN_DEPTH_GUARD\")\n427\t                _emit_depth_or_overlap(\n428\t                    rail=\"depth\", enforced=enforced, count=depth,\n429\t                )\n430\t                if enforced:\n431\t                    return (\n432\t                        \"spawn_depth_over_one\",\n433\t                        f\"depth={depth}\",\n434\t                    )\n435\t\n436\t            # --- Rail 3: FILE ASSIGNMENT (grammar + overlap) ---------------\n437\t            # PLAN-178 C1 / ADR-191: the block is part of the spawn\n438\t            # acceptance contract. EVERY named spawn records an event now —\n439\t            # path_count=0 on absent/readonly/unparseable — so omission is\n440\t            # visible to the advisory window AND the session's collision\n441\t            # detector no longer goes blind on it (R-SEC1 cure; the old emit\n442\t            # lived inside the concrete-paths branch only). Absent/\n443\t            # unparseable block ONLY under CEO_SPAWN_FILE_ASSIGNMENT_REQUIRED\n444\t            # =1 (measure-first flip, same doctrine as C5); CEO_SOTA_DISABLE\n445\t            # =1 forces advisory — the TESTED recovery route (ADR-186\n446\t            # pattern).\n447\t            fa_state, mine = _classify_file_assignment(prompt)\n448\t            # Overlap intersection runs for ANY declared concrete path —\n449\t            # including a TAINTED declaration's paths (codex r16 P1: with\n450\t            # only the overlap guard armed, `owned.py, src/**` must still\n451\t            # trip the clash on owned.py; the grammar gate may be advisory\n452\t            # in that window). BRANCH ON STATE for the grammar gate itself\n453\t            # (codex r15 P1: never on `mine`).\n454\t            my_hashes = {_path_hash(p) for p in mine} if mine else set()\n455\t            if my_hashes:\n456\t                others = _recent_file_assignments(env, session_id)\n457\t                clobber = my_hashes & others\n458\t                if clobber:\n459\t                    enforced = _flag(\"CEO_SPAWN_OVERLAP_GUARD\")\n460\t                    _emit_depth_or_overlap(\n461\t                        rail=\"overlap\", enforced=enforced, count=len(clobber),\n462\t                    )\n463\t                    if enforced:\n464\t                        return (\n465\t                            \"spawn_file_assignment_overlap\",\n466\t                            f\"overlap_count={len(clobber)}\",\n467\t                        )\n468\t            if fa_state in (\"absent\", \"unparseable\"):\n469\t                enforced = _flag(\"CEO_SPAWN_FILE_ASSIGNMENT_REQUIRED\")\n470\t                if enforced:\n471\t                    # No reservation for a spawn that never dispatches\n472\t                    # (codex r16 P2): recording hashes here would leave a\n473\t                    # 10-minute phantom that falsely rejects the corrected\n474\t                    # RETRY under the overlap guard. The block itself is\n475\t                    # the audit trail (veto_triggered carries the code).\n476\t                    return (\n477\t                        (\n478\t                            \"spawn_file_assignment_missing\"\n479\t                            if fa_state == \"absent\"\n480\t                            else \"spawn_file_assignment_unparseable\"\n481\t                        ),\n482\t                        \"fa_state=%s\" % fa_state,\n483\t                    )\n484\t            # Advisory record for every DISPATCHING named spawn.\n485\t            # Telemetry discriminator (allowlist-safe — no new fields):\n486\t            # concrete records its hashes with the real count; readonly\n487\t            # records the NUL-framed constant marker; absent records an\n488\t            # empty set; a tainted-but-advisory declaration records its\n489\t            # concrete hashes. Everything except concrete records\n490\t            # path_count=0 — the would-block signal the AC-2b advisory\n491\t            # window counts.\n492\t            if fa_state == \"concrete\":\n493\t                _emit_file_assignment_recorded(my_hashes, session_id)\n494\t            else:\n495\t                marker = (\n496\t                    {_path_hash(\"\\x00fa-readonly-marker\\x00\")}\n497\t                    if fa_state == \"readonly\" else my_hashes\n498\t                )\n499\t                _emit_file_assignment_recorded(\n500\t                    marker, session_id, path_count=0,\n501\t                )\n502\t        return None\n503\t    except Exception:  # pragma: no cover - fail-open invariant\n504\t        return None\n505\t\n506\t\n507\t\n508\tdef _emit_tool_scope_violation(*, detail: str, enforced: bool) -> None:\n509\t    \"\"\"Emit `spawn_tool_scope_violation` (closed-enum). No-value-echo:\n510\t    `detail` carries only tool NAMES + counts (no path / prompt body).\"\"\"\n511\t    try:\n512\t        if not _AUDIT_EMIT_AVAILABLE:\n513\t            return\n514\t        _audit_emit.emit_generic(\n515\t            \"spawn_tool_scope_violation\",\n516\t            rail=\"tool_scope\",\n517\t            enforced=1 if enforced else 0,\n518\t            detail=(detail or \"\")[:96],\n519\t        )\n520\t    except Exception:  # pragma: no cover - fail-open\n521\t        return\n522\t\n523\t\n524\t\n525\tdef _emit_depth_or_overlap(*, rail: str, enforced: bool, count: int) -> None:\n526\t    \"\"\"Emit `spawn_depth_or_overlap_blocked` (closed-enum). `rail` is a\n527\t    closed enum (depth|overlap); `count` is a bounded int. No path / prompt.\"\"\"\n528\t    try:\n529\t        if not _AUDIT_EMIT_AVAILABLE:\n530\t            return\n531\t        _audit_emit.emit_generic(\n532\t            \"spawn_depth_or_overlap_blocked\",\n533\t            rail=(rail if rail in (\"depth\", \"overlap\") else \"other\"),\n534\t            enforced=1 if enforced else 0,\n535\t            count=count,\n536\t        )\n537\t    except Exception:  # pragma: no cover - fail-open\n538\t        return\n539\t\n540\t\n541\t\n542\tdef _emit_file_assignment_recorded(\n543\t    path_hashes: set,\n544\t    session_id: str,\n545\t    path_count: Optional[int] = None,\n546\t) -> None:\n547\t    \"\"\"Advisory: record THIS spawn's CAN-edit path HASHES so a later\n548\t    concurrent spawn can detect an overlap. Only 12-hex hashes persist.\n549\t\n550\t    ``path_count`` override (PLAN-178 C1): the readonly-declaration path\n551\t    records the constant token hash for telemetry attribution but MUST\n552\t    report path_count=0 — it declares zero writable paths. Default keeps\n553\t    the historical len() semantics for concrete assignments.\n554\t    \"\"\"\n555\t    try:\n556\t        if not _AUDIT_EMIT_AVAILABLE:\n557\t            return\n558\t        joined = \",\".join(sorted(path_hashes))[:512]\n559\t        _audit_emit.emit_generic(\n560\t            \"spawn_file_assignment_recorded\",\n561\t            session_id=(session_id or \"\")[:64],\n562\t            path_hashes=joined,\n563\t            path_count=(\n564\t                min(len(path_hashes), 99)\n565\t                if path_count is None else max(0, min(int(path_count), 99))\n566\t            ),\n567\t        )\n568\t    except Exception:  # pragma: no cover - fail-open\n569\t        return\n570\t"}]},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"4702b399-7cb0-488b-b56b-f5744b8ad0e3","timestamp":"2026-11-15T10:41:27.242Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/file_assignment.py","content":"\"\"\"Spawn tool scope, depth and file-assignment enforcement.\n\nBound to the public hook namespace by this package at import time.\n\"\"\"\nfrom __future__ import annotations\n\n_OVERLAP_LOOKBACK_S = 600          # 10-minute concurrency window\n\n__all__ = (\n    '_OVERLAP_LOOKBACK_S',\n    '_fa_suffix_has_authority',\n    '_fa_list_line_allowed',\n    '_parse_tool_allowlist',\n    '_requested_tools',\n    '_check_tool_scope',\n    '_spawn_depth',\n    '_classify_file_assignment',\n    '_parse_file_assignment',\n    '_path_hash',\n    '_recent_file_assignments',\n    '_enforce_spawn_rails',\n    '_emit_tool_scope_violation',\n    '_emit_depth_or_overlap',\n    '_emit_file_assignment_recorded',\n)\n\n\ndef _fa_suffix_has_authority(suffix: str) -> bool:\n    \"\"\"True when the prose suffix carries a bare authority word.\"\"\"\n    for tok in suffix.split():\n        if \"/\" in tok or \".\" in tok:\n            continue  # path-like token — filename parts are not authority\n        if tok.strip(\";:,()[]{}'\\\"!?-\").lower() in _FA_AUTHORITY_WORDS:\n            return True\n    return False\n\n\n\ndef _fa_list_line_allowed(line: str) -> bool:\n    \"\"\"Closed whitelist for list lines inside a FILE ASSIGNMENT block.\n\n    Anchored semantics (codex r33+r34 P1): a PROSE form may not smuggle\n    ANY edit grant in its suffix — `- MAY read docs; MUST edit x` and\n    `- If you need permission: CAN edit: x` are tainted, not laundered.\n    Each prose prefix consumes its own `edit` (when it has one); any\n    FURTHER `edit` word after the matched prefix rejects the line.\n    \"\"\"\n    if _FA_ALLOWED_GRANT_LINE_RE.match(line):\n        return True\n    m = _FA_ALLOWED_PROSE_LINE_RE.match(line)\n    if m:\n        return not _fa_suffix_has_authority(line[m.end():])\n    return False\n\n\n\ndef _parse_tool_allowlist(prompt: str) -> Optional[frozenset]:\n    \"\"\"Return the declared lowercase tool allow-list, or None if no\n    `## TOOL ALLOW-LIST` block is present (= unrestricted, back-compat).\n\n    Pure. Never raises. Bounded to the block between its header and the next\n    `##` heading. Only KNOWN tool names are retained; unknown tokens dropped\n    (so a typo cannot create a phantom allow-list that blocks everything).\n    \"\"\"\n    if not prompt:\n        return None\n    sanitized = _strip_fenced_and_comments(prompt)\n    m = _TOOL_ALLOWLIST_HEADER_RE.search(sanitized)\n    if m is None:\n        return None\n    block_start = m.end()\n    nxt = _NEXT_H2_RE.search(sanitized, block_start)\n    block = sanitized[block_start: nxt.start() if nxt else len(sanitized)]\n    allowed = set()\n    for bm in _TOOL_BULLET_RE.finditer(block):\n        for tok in bm.group(1).replace(\",\", \" \").split():\n            t = tok.strip().lower()\n            if t in _KNOWN_TOOL_NAMES:\n                allowed.add(t)\n    # An empty-but-present block = \"deny all known tools\" (intentional).\n    return frozenset(allowed)\n\n\n\ndef _requested_tools(prompt: str) -> frozenset:\n    \"\"\"Heuristic set of KNOWN tools this spawn appears to request.\n\n    First-hit per family, bounded scan. Conservative (high-signal verbs only).\n    Pure; never raises.\n    \"\"\"\n    if not prompt:\n        return frozenset()\n    text = _strip_fenced_and_comments(prompt)[:_TOOL_SCAN_WINDOW].lower()\n    out = set()\n    for tool, hints in _TOOL_REQUEST_HINTS:\n        if any(h in text for h in hints):\n            out.add(tool)\n    return frozenset(out)\n\n\n\ndef _check_tool_scope(\n    prompt: str,\n) -> Optional[Tuple[str, str]]:\n    \"\"\"Rail 1. Return (reason_code, detail) if a requested tool is OUTSIDE\n    the declared allow-list, else None.\n\n    `detail` NEVER contains a path or the raw prompt — only the offending\n    tool NAME(s) (a closed-enum-safe value) + counts. No-value-echo safe.\n    \"\"\"\n    allow = _parse_tool_allowlist(prompt)\n    if allow is None:\n        return None  # no declared scope -> unrestricted (back-compat)\n    requested = _requested_tools(prompt)\n    out_of_scope = sorted(requested - allow)\n    if not out_of_scope:\n        return None\n    return (\n        \"spawn_tool_out_of_scope\",\n        f\"tools={','.join(out_of_scope)} declared={len(allow)}\",\n    )\n\n\n\ndef _spawn_depth(prompt: str, env: Dict[str, str]) -> int:\n    \"\"\"Best-effort current spawn depth. 0 = top-level CEO spawn.\n\n    Two independent signals, max() wins (fail-toward-detection):\n      - `## SUBAGENT-CONTEXT depth=N` marker in the prompt (CEO-injected when\n        delegating to a sub-agent that may itself coordinate).\n      - `CEO_SPAWN_DEPTH` env breadcrumb (harness/CEO-set).\n    Pure-ish (reads env dict only). Never raises.\n    \"\"\"\n    depth = 0\n    try:\n        m = _SUBAGENT_DEPTH_MARKER_RE.search(prompt or \"\")\n        if m:\n            depth = max(depth, int(m.group(1)))\n    except Exception:  # pragma: no cover - fail-open\n        pass\n    try:\n        raw = (env.get(\"CEO_SPAWN_DEPTH\") or \"\").strip()\n        if raw.isdigit():\n            depth = max(depth, int(raw))\n    except Exception:  # pragma: no cover - fail-open\n        pass\n    return depth\n\n\n\ndef _classify_file_assignment(prompt: str) -> Tuple[str, frozenset]:\n    \"\"\"Classify the spawn's `## FILE ASSIGNMENT` declaration (PLAN-178 C1).\n\n    Returns ``(state, concrete_paths)`` with ``state`` in a closed enum:\n\n    - ``\"absent\"``      — no `## FILE ASSIGNMENT` header in the sanitized\n      prompt (fenced/comment content never counts — same masking rule as\n      every other block parser in this hook).\n    - ``\"concrete\"``    — >=1 concrete `CAN edit:` path AND zero dropped\n      tokens (codex r15 P1: `safe.py, src/**` must NOT classify concrete —\n      the agent still READS the wildcard grant while telemetry records\n      only the concrete path; any dropped token taints the whole\n      declaration to unparseable).\n    - ``\"readonly\"``    — explicit `CAN edit: NONE-READ-ONLY` and no\n      concrete path. Case-insensitive token match; conformant.\n    - ``\"unparseable\"`` — header(s) present but no concrete path and no\n      explicit read-only token (wildcard-only / placeholder-only / empty\n      block). Named rejection under enforce (ADR-191 §1, B nice-4).\n\n    ALL `## FILE ASSIGNMENT` blocks in the prompt are aggregated (codex\n    r2 P1, Lote B): the canonical generator emits an unconditional block\n    and documented caller flows (/spawn, /debate) APPEND their own\n    concrete block afterwards — reading only the first block would hide\n    the writer's paths from overlap telemetry AND enforcement. Union of\n    concrete paths wins over a read-only declaration in any block.\n\n    Pure. Never raises. Bounded to _OVERLAP_MAX_PATHS.\n    \"\"\"\n    if not prompt:\n        return (\"absent\", frozenset())\n    # CommonMark-correct fence mask FIRST (raw prompt), THEN the shared\n    # comment/fence stripper — order matters: the shared toggle-masker\n    # mis-parses length/type-mismatched fences (codex r35 P1).\n    sanitized = _FA_FENCE_RE.sub(\"\", prompt)\n    sanitized = _strip_fenced_and_comments(sanitized)\n    # Unclosed HTML comment extends to EOF (codex r39 P2): the shared\n    # stripper removes only CLOSED <!-- --> pairs — an unclosed opener\n    # would leave commented-out content visible to this classifier.\n    _oc = sanitized.find(\"<!--\")\n    if _oc != -1 and \"-->\" not in sanitized[_oc:]:\n        sanitized = sanitized[:_oc]\n    headers = list(_FILE_ASSIGNMENT_HEADER_RE.finditer(sanitized))\n    # Block bound recognizes 0-3-space-indented H2 too (codex r33 P2) —\n    # otherwise an indented `## TASK` leaves task bullets INSIDE the\n    # assignment parser. Local to this classifier.\n    _fa_next_h2 = re.compile(r\"^[ ]{0,3}##[ \\t]\", flags=re.MULTILINE)\n    if not headers:\n        return (\"absent\", frozenset())\n    paths = set()\n    readonly_declared = False\n    invalid_seen = False\n    for m in headers:\n        block_start = m.end()\n        nxt = _fa_next_h2.search(sanitized, block_start)\n        block = sanitized[\n            block_start: nxt.start() if nxt else len(sanitized)\n        ]\n        block_had_line = False\n        for list_line in _FA_LIST_LINE_RE.finditer(block):\n            if not _fa_list_line_allowed(list_line.group(0)):\n                # Structural rule (codex r25→r32): an unrecognized list\n                # line inside the block is authority/instruction the\n                # parser did not validate — taint, whatever its phrasing.\n                invalid_seen = True\n        for lm in _CAN_EDIT_LINE_RE.finditer(block):\n            block_had_line = True\n            for raw in lm.group(1).split(\",\"):\n                p = raw.strip().strip(\"`\").strip()\n                if not p:\n                    continue\n                if p.lower() == _FA_READONLY_TOKEN:\n                    # Explicit read-only form — never a concrete path,\n                    # never a hashable overlap participant (guaranteed by\n                    # this branch running BEFORE the concrete-path add).\n                    readonly_declared = True\n                    continue\n                # Drop placeholders + wildcards (cannot prove a clobber).\n                # Angle brackets included (codex r1 P2): a scaffold literal\n                # like `CAN edit: <concrete paths>` must classify\n                # unparseable, not concrete — especially since the hook's\n                # own block message shows that exact scaffold string.\n                # Every drop marks the declaration TAINTED (codex r14 P1):\n                # an earlier NONE-READ-ONLY must not hide a later wildcard\n                # grant the agent still READS in its prompt.\n                # ALL glob/expansion syntax rejected ANYWHERE in the\n                # token (codex r19 P1): `src/?.py`, `src/[ab].py` and\n                # `src/{a,b}.py` are multi-file grants the agent reads\n                # while telemetry hashes only literal tokens (brace forms\n                # additionally split into bogus comma paths upstream).\n                if any(ch in p for ch in \"*?[]{}<>\") or p.lower() in (\n                    \"none\", \"n/a\", \"tbd\",\n                ):\n                    invalid_seen = True\n                    continue\n                # Codex r9 P2: filesystem paths cannot carry NUL/control\n                # chars — a crafted value could otherwise classify as\n                # concrete AND hash into the domain-separated read-only\n                # telemetry marker (which is NUL-framed precisely so real\n                # paths can never reach it). Reject, do not sanitize.\n                # Broad prose (\"all files\", \"any path\") and shell-\n                # expansion forms (\"$HOME/...\") are NOT concrete paths\n                # (codex r31 P1): a concrete grant in this grammar has no\n                # spaces and no `$` — declared in ADR-191 §2.1.\n                if any(ch.isspace() for ch in p) or \"$\" in p:\n                    invalid_seen = True\n                    continue\n                # Unicode line/paragraph separators included (codex r28\n                # P1): U+0085 NEL, U+2028 LS, U+2029 PS present injected\n                # prompt STRUCTURE to the agent while hashing as one path\n                # — and CEO_UNICODE_HARDBLOCK may be unset.\n                if any(\n                    ord(ch) < 32\n                    or ch in (\"\\x7f\", \"\\u0085\", \"\\u2028\", \"\\u2029\")\n                    for ch in p\n                ):\n                    invalid_seen = True\n                    continue\n                # Normalize: strip a leading ./, collapse; POSIX paths are\n                # case-sensitive so keep case, normalize separators only.\n                p = p.lstrip(\"./\").replace(\"\\\\\", \"/\")\n                if not p:\n                    # Codex r3 P1: `...` / `./` normalize to \"\" — an empty\n                    # \"path\" must never make the declaration concrete (it\n                    # would record path_count=1 and hide a would-block\n                    # input from the advisory window).\n                    invalid_seen = True\n                    continue\n                # Cap STORED paths without stopping the scan (codex r16\n                # P1). Exceeding the cap TAINTS the declaration (codex r31\n                # P2): silently dropping path 65+ would hide granted\n                # authority from the overlap guard — an assignment that\n                # large is a partition smell anyway.\n                if len(paths) < _OVERLAP_MAX_PATHS:\n                    paths.add(p)\n                else:\n                    invalid_seen = True\n        if not block_had_line:\n            # Codex r23 P1: an appended block with ZERO parseable\n            # `CAN edit:` lines (`- MAY edit: ...`, misspellings, empty)\n            # is a write grant the agent READS but the parser never saw —\n            # it must taint the declaration, not vanish behind an earlier\n            # read-only block.\n            invalid_seen = True\n    if paths and not invalid_seen:\n        return (\"concrete\", frozenset(paths))\n    if readonly_declared and not paths and not invalid_seen:\n        return (\"readonly\", frozenset())\n    # ANY dropped token taints the WHOLE declaration (codex r14+r15 P1):\n    # a readonly token or a valid path must not launder a wildcard/\n    # placeholder/control-char grant past the enforce gate — the agent\n    # still READ that grant in its prompt. Mixed declarations classify\n    # unparseable; concrete paths are still returned for overlap\n    # telemetry (recording them costs nothing and keeps the collision\n    # detector informed even on a tainted spawn).\n    return (\"unparseable\", frozenset(paths))\n\n\n\ndef _parse_file_assignment(prompt: str) -> frozenset:\n    \"\"\"Return the set of concrete `CAN edit:` paths declared in the spawn's\n    `## FILE ASSIGNMENT` block. Empty set if none.\n\n    Back-compat thin wrapper over :func:`_classify_file_assignment` (the\n    single scanner since PLAN-178 C1 — one grammar, two consumers).\n    \"\"\"\n    return _classify_file_assignment(prompt)[1]\n\n\n\ndef _path_hash(p: str) -> str:\n    \"\"\"12-hex sha256 prefix of a path. The ONLY path representation that\n    enters the audit log (no raw path body ever persists — Sec MF-3).\"\"\"\n    return hashlib.sha256(p.encode(\"utf-8\", \"replace\")).hexdigest()[:12]\n\n\n\ndef _recent_file_assignments(\n    env: Dict[str, str],\n    session_id: str,\n    max_age_s: int = _OVERLAP_LOOKBACK_S,\n) -> frozenset:\n    \"\"\"Tail the audit log for `CAN edit:` path-HASHES emitted by OTHER spawns\n    in this session within the window. Returns a set of 12-hex path hashes.\n\n    Reads only `spawn_file_assignment_recorded` advisory rows (emitted at the\n    allow-path of a prior spawn — see 4d). Bounded tail. Never raises; returns\n    empty set on any error (fail-open -> no overlap detected -> allow).\n    \"\"\"\n    try:\n        log_path = _audit_log_path()\n        if log_path is None or not log_path.exists():\n            return frozenset()\n        import json as _json\n        import time as _time\n        with log_path.open(\"r\", encoding=\"utf-8\") as f:\n            try:\n                f.seek(0, 2)\n                size = f.tell()\n                read_back = min(size, _OVERLAP_TAIL_LINES * 2048)\n                start = max(0, size - read_back)\n                f.seek(start, 0)\n                if start > 0:\n                    f.readline()\n                tail = f.readlines()\n            except OSError:\n                tail = f.readlines()[-_OVERLAP_TAIL_LINES:]\n        now = _time.time()\n        seen = set()\n        for line in reversed(tail):\n            try:\n                ev = _json.loads(line)\n            except Exception:\n                continue\n            if ev.get(\"action\") != \"spawn_file_assignment_recorded\":\n                continue\n            if session_id and ev.get(\"session_id\") != session_id:\n                continue\n            ts_f = _parse_event_ts(ev.get(\"ts\"))\n            if ts_f is None or (now - ts_f) > max_age_s:\n                continue\n            ph = ev.get(\"path_hashes\")\n            if isinstance(ph, str):\n                for h in ph.split(\",\"):\n                    h = h.strip()\n                    if h:\n                        seen.add(h)\n        return frozenset(seen)\n    except Exception:  # pragma: no cover - fail-open\n        return frozenset()\n\n\n\ndef _enforce_spawn_rails(\n    *,\n    prompt: str,\n    is_named_spawn: bool,\n    env: Dict[str, str],\n    session_id: str,\n) -> Optional[Tuple[str, str]]:\n    \"\"\"PLAN-133 E3 rails + PLAN-178 C1 FILE ASSIGNMENT grammar. Returns\n    (reason_code, detail) when a rail is in ENFORCING mode (its flag=1)\n    AND fires; else None.\n\n    In ADVISORY mode (flag unset/0) each rail still EMITS its closed-enum\n    event with enforced=0 (measure-first) and returns None (allow).\n\n    NEVER raises. Each rail independently flagged (CEO_SPAWN_TOOL_SCOPE /\n    CEO_SPAWN_DEPTH_GUARD / CEO_SPAWN_OVERLAP_GUARD /\n    CEO_SPAWN_FILE_ASSIGNMENT_REQUIRED); CEO_SOTA_DISABLE=1 forces\n    advisory for ALL of them — that master kill is the named, tested\n    recovery route for the grammar gate (ADR-186 pattern).\n    \"\"\"\n    try:\n        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n\n        def _flag(name: str) -> bool:\n            if master_off:\n                return False\n            return (env.get(name) or \"\").strip() == \"1\"\n\n        # --- Rail 1: tool scope (applies to ANY spawn that declares a list) -\n        scope_hit = _check_tool_scope(prompt)\n        if scope_hit is not None:\n            code, detail = scope_hit\n            enforced = _flag(\"CEO_SPAWN_TOOL_SCOPE\")\n            _emit_tool_scope_violation(detail=detail, enforced=enforced)\n            if enforced:\n                return (code, detail)\n\n        # Rails 2 + 3 only matter for NAMED spawns (a generic research task\n        # neither recurses into named delegation nor partitions files).\n        if is_named_spawn:\n            # --- Rail 2: depth fence ---------------------------------------\n            depth = _spawn_depth(prompt, env)\n            if depth >= 1:\n                enforced = _flag(\"CEO_SPAWN_DEPTH_GUARD\")\n                _emit_depth_or_overlap(\n                    rail=\"depth\", enforced=enforced, count=depth,\n                )\n                if enforced:\n                    return (\n                        \"spawn_depth_over_one\",\n                        f\"depth={depth}\",\n                    )\n\n            # --- Rail 3: FILE ASSIGNMENT (grammar + overlap) ---------------\n            # PLAN-178 C1 / ADR-191: the block is part of the spawn\n            # acceptance contract. EVERY named spawn records an event now —\n            # path_count=0 on absent/readonly/unparseable — so omission is\n            # visible to the advisory window AND the session's collision\n            # detector no longer goes blind on it (R-SEC1 cure; the old emit\n            # lived inside the concrete-paths branch only). Absent/\n            # unparseable block ONLY under CEO_SPAWN_FILE_ASSIGNMENT_REQUIRED\n            # =1 (measure-first flip, same doctrine as C5); CEO_SOTA_DISABLE\n            # =1 forces advisory — the TESTED recovery route (ADR-186\n            # pattern).\n            fa_state, mine = _classify_file_assignment(prompt)\n            # Overlap intersection runs for ANY declared concrete path —\n            # including a TAINTED declaration's paths (codex r16 P1: with\n            # only the overlap guard armed, `owned.py, src/**` must still\n            # trip the clash on owned.py; the grammar gate may be advisory\n            # in that window). BRANCH ON STATE for the grammar gate itself\n            # (codex r15 P1: never on `mine`).\n            my_hashes = {_path_hash(p) for p in mine} if mine else set()\n            if my_hashes:\n                others = _recent_file_assignments(env, session_id)\n                clobber = my_hashes & others\n                if clobber:\n                    enforced = _flag(\"CEO_SPAWN_OVERLAP_GUARD\")\n                    _emit_depth_or_overlap(\n                        rail=\"overlap\", enforced=enforced, count=len(clobber),\n                    )\n                    if enforced:\n                        return (\n                            \"spawn_file_assignment_overlap\",\n                            f\"overlap_count={len(clobber)}\",\n                        )\n            if fa_state in (\"absent\", \"unparseable\"):\n                enforced = _flag(\"CEO_SPAWN_FILE_ASSIGNMENT_REQUIRED\")\n                if enforced:\n                    # No reservation for a spawn that never dispatches\n                    # (codex r16 P2): recording hashes here would leave a\n                    # 10-minute phantom that falsely rejects the corrected\n                    # RETRY under the overlap guard. The block itself is\n                    # the audit trail (veto_triggered carries the code).\n                    return (\n                        (\n                            \"spawn_file_assignment_missing\"\n                            if fa_state == \"absent\"\n                            else \"spawn_file_assignment_unparseable\"\n                        ),\n                        \"fa_state=%s\" % fa_state,\n                    )\n            # Advisory record for every DISPATCHING named spawn.\n            # Telemetry discriminator (allowlist-safe — no new fields):\n            # concrete records its hashes with the real count; readonly\n            # records the NUL-framed constant marker; absent records an\n            # empty set; a tainted-but-advisory declaration records its\n            # concrete hashes. Everything except concrete records\n            # path_count=0 — the would-block signal the AC-2b advisory\n            # window counts.\n            if fa_state == \"concrete\":\n                _emit_file_assignment_recorded(my_hashes, session_id)\n            else:\n                marker = (\n                    {_path_hash(\"\\x00fa-readonly-marker\\x00\")}\n                    if fa_state == \"readonly\" else my_hashes\n                )\n                _emit_file_assignment_recorded(\n                    marker, session_id, path_count=0,\n                )\n        return None\n    except Exception:  # pragma: no cover - fail-open invariant\n        return None\n\n\n\ndef _emit_tool_scope_violation(*, detail: str, enforced: bool) -> None:\n    \"\"\"Emit `spawn_tool_scope_violation` (closed-enum). No-value-echo:\n    `detail` carries only tool NAMES + counts (no path / prompt body).\"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        _audit_emit.emit_generic(\n            \"spawn_tool_scope_violation\",\n            rail=\"tool_scope\",\n            enforced=1 if enforced else 0,\n            detail=(detail or \"\")[:96],\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\n\ndef _emit_depth_or_overlap(*, rail: str, enforced: bool, count: int) -> None:\n    \"\"\"Emit `spawn_depth_or_overlap_blocked` (closed-enum). `rail` is a\n    closed enum (depth|overlap); `count` is a bounded int. No path / prompt.\"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        _audit_emit.emit_generic(\n            \"spawn_depth_or_overlap_blocked\",\n            rail=(rail if rail in (\"depth\", \"overlap\") else \"other\"),\n            enforced=1 if enforced else 0,\n            count=count,\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\n\ndef _emit_file_assignment_recorded(\n    path_hashes: set,\n    session_id: str,\n    path_count: Optional[int] = None,\n) -> None:\n    \"\"\"Advisory: record THIS spawn's CAN-edit path HASHES so a later\n    concurrent spawn can detect an overlap. Only 12-hex hashes persist.\n\n    ``path_count`` override (PLAN-178 C1): the readonly-declaration path\n    records the constant token hash for telemetry attribution but MUST\n    report path_count=0 — it declares zero writable paths. Default keeps\n    the historical len() semantics for concrete assignments.\n    \"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        joined = \",\".join(sorted(path_hashes))[:512]\n        _audit_emit.emit_generic(\n            \"spawn_file_assignment_recorded\",\n            session_id=(session_id or \"\")[:64],\n            path_hashes=joined,\n            path_count=(\n                min(len(path_hashes), 99)\n                if path_count is None else max(0, min(int(path_count), 99))\n            ),\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n","numLines":570,"startLine":1,"totalLines":570}},"tool_result_meta":[{"id":"toolu_017trKodHePwLt8fuN8beAs7","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
