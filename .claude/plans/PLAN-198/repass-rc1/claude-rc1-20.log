{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ez34LbsoHRDFpy89dFYXr6","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\t__all__ = ('_TASK_ROUTE_MODULE', '_TASK_ROUTE_LOAD_FAILED', '_FRONTMATTER_MODEL_CACHE', '_FRONTMATTER_CACHE_MAX', '_resolve_task_route', '_read_archetype_model_frontmatter', '_extract_archetype_from_payload', '_emit_model_routing_advisory')\n4\t\n5\t# ---------------------------------------------------------------------------\n6\t# PLAN-078 Wave 1 — Model routing telemetry (advisory-emit-only)\n7\t# ---------------------------------------------------------------------------\n8\t# Telemetry-only: hook contract (`_lib/contract.py:112-127`) supports only\n9\t# allow/block/systemMessage. NO `tool_input` mutation. This block exists to\n10\t# observe sub-agent spawn → recommended model deltas so the CEO can hand-edit\n11\t# `.claude/agents/<archetype>.md` frontmatter (manual remediation path). The\n12\t# hard-enforcement leg is the existing VETO-floor check at\n13\t# check_veto_floor_for_role() which runs BEFORE this advisory.\n14\t#\n15\t# Hot-path requirement: p95 ≤ 20ms. Achieved via:\n16\t#   - module-level cache of task_route module + classify reference\n17\t#   - module-level cache of frontmatter parser\n18\t#   - frontmatter cache by-archetype (LRU dict, capped 64 entries) — agents\n19\t#     dir is small + rarely changes mid-session, so cache invalidation is\n20\t#     not required (next session re-imports module).\n21\t#\n22\t# Bypass: env var `CEO_MODEL_ROUTING=0` short-circuits to a no-op.\n23\t# Fail-open: any exception during advisory emit is swallowed (logged to\n24\t# breadcrumb if available) so the spawn is NEVER blocked by a routing bug.\n25\t\n26\t# Lazy task_route module reference — populated on first call. Cached.\n27\t_TASK_ROUTE_MODULE: Optional[Any] = None\n28\t_TASK_ROUTE_LOAD_FAILED: bool = False\n29\t\n30\t# In-memory cache: archetype -> (model: Optional[str], confidence: float).\n31\t# Cleared at module init only (process-scoped).\n32\t_FRONTMATTER_MODEL_CACHE: Dict[str, Tuple[Optional[str], float]] = {}\n33\t_FRONTMATTER_CACHE_MAX = 64\n34\t\n35\t\n36\tdef _resolve_task_route():\n37\t    \"\"\"Best-effort import of `.claude/scripts/task-route.py` as a module.\n38\t\n39\t    Returns the module on success, None on failure. Never raises.\n40\t    Cached after first call (positive or negative).\n41\t\n42\t    Resolution order:\n43\t      1. ``CLAUDE_PROJECT_DIR`` env var (test-friendly + adopter-respectful)\n44\t      2. Walk up from `_HOOKS_DIR` looking for a `.claude/scripts/task-route.py`\n45\t    \"\"\"\n46\t    global _TASK_ROUTE_MODULE, _TASK_ROUTE_LOAD_FAILED\n47\t    if _TASK_ROUTE_MODULE is not None or _TASK_ROUTE_LOAD_FAILED:\n48\t        return _TASK_ROUTE_MODULE\n49\t    try:\n50\t        import importlib.util as _ilutil\n51\t        candidates = []\n52\t        env_root = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n53\t        if env_root:\n54\t            candidates.append(\n55\t                Path(env_root) / \".claude\" / \"scripts\" / \"task-route.py\"\n56\t            )\n57\t        # Walk up from _HOOKS_DIR (stable in normal install)\n58\t        candidates.append(\n59\t            _HOOKS_DIR.parent.parent / \".claude\" / \"scripts\" / \"task-route.py\"\n60\t        )\n61\t        # Walk up from this file's location (helps when the hook itself is\n62\t        # staged under .claude/plans/PLAN-NNN/staging/...; rare but useful\n63\t        # for in-tree pytest runs that exercise the staged copy).\n64\t        cur = Path(__file__).resolve().parent\n65\t        for _ in range(8):\n66\t            if cur == cur.parent:\n67\t                break\n68\t            cand = cur / \".claude\" / \"scripts\" / \"task-route.py\"\n69\t            if cand.is_file():\n70\t                candidates.append(cand)\n71\t                break\n72\t            cur = cur.parent\n73\t        tr_path = next((c for c in candidates if c.is_file()), None)\n74\t        if tr_path is None:\n75\t            _TASK_ROUTE_LOAD_FAILED = True\n76\t            return None\n77\t        spec = _ilutil.spec_from_file_location(\"task_route\", tr_path)\n78\t        if spec is None or spec.loader is None:\n79\t            _TASK_ROUTE_LOAD_FAILED = True\n80\t            return None\n81\t        mod = _ilutil.module_from_spec(spec)\n82\t        spec.loader.exec_module(mod)\n83\t        _TASK_ROUTE_MODULE = mod\n84\t        return mod\n85\t    except Exception:  # pragma: no cover - fail-open\n86\t        _TASK_ROUTE_LOAD_FAILED = True\n87\t        return None\n88\t\n89\t\n90\tdef _read_archetype_model_frontmatter(\n91\t    archetype: str,\n92\t    agents_dir: Path,\n93\t) -> Tuple[Optional[str], float]:\n94\t    \"\"\"Read `model:` field from `<agents_dir>/<archetype>.md`.\n95\t\n96\t    Returns (model, confidence). When frontmatter present + model field\n97\t    set, confidence is 1.0 (authoritative). When file missing or no\n98\t    model field, confidence is 0.0 (caller will fall back to classify).\n99\t    Cached by archetype to avoid re-reading on repeat spawns.\n100\t    \"\"\"\n101\t    cached = _FRONTMATTER_MODEL_CACHE.get(archetype)\n102\t    if cached is not None:\n103\t        return cached\n104\t    result: Tuple[Optional[str], float] = (None, 0.0)\n105\t    try:\n106\t        if _agent_frontmatter is None:\n107\t            pass\n108\t        else:\n109\t            path = _agent_frontmatter.resolve_agent_file(archetype, agents_dir)\n110\t            if path.is_file():\n111\t                metadata = _agent_frontmatter.parse_agent_file(path)\n112\t                model = metadata.get(\"model\", \"\").strip() if metadata else \"\"\n113\t                if model:\n114\t                    result = (model, 1.0)\n115\t    except Exception:  # pragma: no cover - fail-open\n116\t        result = (None, 0.0)\n117\t    # Bounded LRU-ish cache (simple FIFO eviction at cap).\n118\t    if len(_FRONTMATTER_MODEL_CACHE) >= _FRONTMATTER_CACHE_MAX:\n119\t        try:\n120\t            _FRONTMATTER_MODEL_CACHE.pop(next(iter(_FRONTMATTER_MODEL_CACHE)))\n121\t        except StopIteration:  # pragma: no cover\n122\t            pass\n123\t    _FRONTMATTER_MODEL_CACHE[archetype] = result\n124\t    return result\n125\t\n126\t\n127\tdef _extract_archetype_from_payload(\n128\t    description: str,\n129\t    prompt: str,\n130\t    subagent_type: str,\n131\t) -> str:\n132\t    \"\"\"Best-effort archetype detection from spawn payload.\n133\t\n134\t    Order: ``subagent_type`` (Agent tool input) → first persona header\n135\t    line → empty string. Returns archetype slug or empty string.\n136\t    \"\"\"\n137\t    if subagent_type:\n138\t        return subagent_type.strip().lower()\n139\t    # Try to find archetype from persona header in prompt\n140\t    if prompt:\n141\t        m = re.search(\n142\t            r\"(?:archetype|role|persona):\\s*([a-z][a-z0-9_-]+)\",\n143\t            prompt,\n144\t            flags=re.IGNORECASE,\n145\t        )\n146\t        if m:\n147\t            return m.group(1).strip().lower()\n148\t    return \"\"\n149\t\n150\t\n151\tdef _emit_model_routing_advisory(\n152\t    *,\n153\t    description: str,\n154\t    prompt: str,\n155\t    subagent_type: str,\n156\t    env: Optional[Dict[str, str]] = None,\n157\t    project_dir: Optional[str] = None,\n158\t) -> None:\n159\t    \"\"\"Emit a `model_routing_advised` advisory event for this spawn.\n160\t\n161\t    PLAN-078 Wave 1. Telemetry-only — this function:\n162\t      - reads archetype from spawn payload\n163\t      - reads `.claude/agents/<archetype>.md` frontmatter `model:` if set\n164\t      - else calls `task_route.classify()` for a recommendation\n165\t      - emits via audit_emit (deny-by-default 6-field allowlist)\n166\t\n167\t    NEVER raises. Bypass via `CEO_MODEL_ROUTING=0`.\n168\t    \"\"\"\n169\t    try:\n170\t        src_env = env if env is not None else os.environ\n171\t        if (src_env.get(\"CEO_MODEL_ROUTING\") or \"\").strip() == \"0\":\n172\t            return  # bypass\n173\t        if not _AUDIT_EMIT_AVAILABLE:\n174\t            return  # audit emit unavailable; nothing to do\n175\t\n176\t        archetype = _extract_archetype_from_payload(\n177\t            description or \"\", prompt or \"\", subagent_type or \"\"\n178\t        )\n179\t        if not archetype:\n180\t            return  # generic spawn — no archetype to route\n181\t\n182\t        # Path A: agent frontmatter declared model -> authoritative.\n183\t        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n184\t        agents_dir = Path(proj) / \".claude\" / \"agents\"\n185\t        fm_model, fm_conf = _read_archetype_model_frontmatter(\n186\t            archetype, agents_dir\n187\t        )\n188\t\n189\t        if fm_model:\n190\t            model_recommended = fm_model\n191\t            confidence = fm_conf\n192\t            applied_or_skipped = \"skipped_classify_frontmatter_authoritative\"\n193\t            override_reason = \"frontmatter_model_present\"\n194\t            task_type = \"frontmatter\"\n195\t        else:\n196\t            # Path B: in-process classify.\n197\t            tr = _resolve_task_route()\n198\t            if tr is None or not hasattr(tr, \"classify\"):\n199\t                # Fail-open: no recommendation available, advisory skipped.\n200\t                return\n201\t            try:\n202\t                desc_text = (description or \"\")[:8 * 1024]  # cap to 8KiB\n203\t                result = tr.classify(desc_text, [])\n204\t            except Exception:\n205\t                # classify() raised — fail-open with breadcrumb attempt.\n206\t                _emit_advisory_safe(\n207\t                    archetype=archetype,\n208\t                    task_type=\"classify_error\",\n209\t                    model_recommended=\"\",\n210\t                    confidence=0.0,\n211\t                    applied_or_skipped=\"skipped_classify_exception\",\n212\t                    override_reason=\"classify_raised\",\n213\t                )\n214\t                return\n215\t            classification = (\n216\t                result.get(\"classification\") if isinstance(result, dict) else \"\"\n217\t            ) or \"\"\n218\t            # Conservative mapping: classify() returns S/M/L/XL classification —\n219\t            # not a model directly. Telemetry records the classification +\n220\t            # leaves model_recommended empty so PLAN-079 can decide the mapping.\n221\t            model_recommended = \"\"\n222\t            confidence = 0.7 if classification else 0.0\n223\t            applied_or_skipped = (\n224\t                \"advisory_only_no_recommendation\"\n225\t                if not classification\n226\t                else \"advisory_only_classification_emitted\"\n227\t            )\n228\t            override_reason = \"\"\n229\t            task_type = classification or \"unclassified\"\n230\t\n231\t        _emit_advisory_safe(\n232\t            archetype=archetype,\n233\t            task_type=task_type,\n234\t            model_recommended=model_recommended,\n235\t            confidence=float(confidence),\n236\t            applied_or_skipped=applied_or_skipped,\n237\t            override_reason=override_reason,\n238\t        )\n239\t    except Exception:  # pragma: no cover - fail-open invariant\n240\t        return\n241\t"}]},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"310c3692-35c4-4793-9e65-87d083de2549","timestamp":"2026-11-15T10:42:09.226Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/model_routing.py","content":"from __future__ import annotations\n\n__all__ = ('_TASK_ROUTE_MODULE', '_TASK_ROUTE_LOAD_FAILED', '_FRONTMATTER_MODEL_CACHE', '_FRONTMATTER_CACHE_MAX', '_resolve_task_route', '_read_archetype_model_frontmatter', '_extract_archetype_from_payload', '_emit_model_routing_advisory')\n\n# ---------------------------------------------------------------------------\n# PLAN-078 Wave 1 — Model routing telemetry (advisory-emit-only)\n# ---------------------------------------------------------------------------\n# Telemetry-only: hook contract (`_lib/contract.py:112-127`) supports only\n# allow/block/systemMessage. NO `tool_input` mutation. This block exists to\n# observe sub-agent spawn → recommended model deltas so the CEO can hand-edit\n# `.claude/agents/<archetype>.md` frontmatter (manual remediation path). The\n# hard-enforcement leg is the existing VETO-floor check at\n# check_veto_floor_for_role() which runs BEFORE this advisory.\n#\n# Hot-path requirement: p95 ≤ 20ms. Achieved via:\n#   - module-level cache of task_route module + classify reference\n#   - module-level cache of frontmatter parser\n#   - frontmatter cache by-archetype (LRU dict, capped 64 entries) — agents\n#     dir is small + rarely changes mid-session, so cache invalidation is\n#     not required (next session re-imports module).\n#\n# Bypass: env var `CEO_MODEL_ROUTING=0` short-circuits to a no-op.\n# Fail-open: any exception during advisory emit is swallowed (logged to\n# breadcrumb if available) so the spawn is NEVER blocked by a routing bug.\n\n# Lazy task_route module reference — populated on first call. Cached.\n_TASK_ROUTE_MODULE: Optional[Any] = None\n_TASK_ROUTE_LOAD_FAILED: bool = False\n\n# In-memory cache: archetype -> (model: Optional[str], confidence: float).\n# Cleared at module init only (process-scoped).\n_FRONTMATTER_MODEL_CACHE: Dict[str, Tuple[Optional[str], float]] = {}\n_FRONTMATTER_CACHE_MAX = 64\n\n\ndef _resolve_task_route():\n    \"\"\"Best-effort import of `.claude/scripts/task-route.py` as a module.\n\n    Returns the module on success, None on failure. Never raises.\n    Cached after first call (positive or negative).\n\n    Resolution order:\n      1. ``CLAUDE_PROJECT_DIR`` env var (test-friendly + adopter-respectful)\n      2. Walk up from `_HOOKS_DIR` looking for a `.claude/scripts/task-route.py`\n    \"\"\"\n    global _TASK_ROUTE_MODULE, _TASK_ROUTE_LOAD_FAILED\n    if _TASK_ROUTE_MODULE is not None or _TASK_ROUTE_LOAD_FAILED:\n        return _TASK_ROUTE_MODULE\n    try:\n        import importlib.util as _ilutil\n        candidates = []\n        env_root = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n        if env_root:\n            candidates.append(\n                Path(env_root) / \".claude\" / \"scripts\" / \"task-route.py\"\n            )\n        # Walk up from _HOOKS_DIR (stable in normal install)\n        candidates.append(\n            _HOOKS_DIR.parent.parent / \".claude\" / \"scripts\" / \"task-route.py\"\n        )\n        # Walk up from this file's location (helps when the hook itself is\n        # staged under .claude/plans/PLAN-NNN/staging/...; rare but useful\n        # for in-tree pytest runs that exercise the staged copy).\n        cur = Path(__file__).resolve().parent\n        for _ in range(8):\n            if cur == cur.parent:\n                break\n            cand = cur / \".claude\" / \"scripts\" / \"task-route.py\"\n            if cand.is_file():\n                candidates.append(cand)\n                break\n            cur = cur.parent\n        tr_path = next((c for c in candidates if c.is_file()), None)\n        if tr_path is None:\n            _TASK_ROUTE_LOAD_FAILED = True\n            return None\n        spec = _ilutil.spec_from_file_location(\"task_route\", tr_path)\n        if spec is None or spec.loader is None:\n            _TASK_ROUTE_LOAD_FAILED = True\n            return None\n        mod = _ilutil.module_from_spec(spec)\n        spec.loader.exec_module(mod)\n        _TASK_ROUTE_MODULE = mod\n        return mod\n    except Exception:  # pragma: no cover - fail-open\n        _TASK_ROUTE_LOAD_FAILED = True\n        return None\n\n\ndef _read_archetype_model_frontmatter(\n    archetype: str,\n    agents_dir: Path,\n) -> Tuple[Optional[str], float]:\n    \"\"\"Read `model:` field from `<agents_dir>/<archetype>.md`.\n\n    Returns (model, confidence). When frontmatter present + model field\n    set, confidence is 1.0 (authoritative). When file missing or no\n    model field, confidence is 0.0 (caller will fall back to classify).\n    Cached by archetype to avoid re-reading on repeat spawns.\n    \"\"\"\n    cached = _FRONTMATTER_MODEL_CACHE.get(archetype)\n    if cached is not None:\n        return cached\n    result: Tuple[Optional[str], float] = (None, 0.0)\n    try:\n        if _agent_frontmatter is None:\n            pass\n        else:\n            path = _agent_frontmatter.resolve_agent_file(archetype, agents_dir)\n            if path.is_file():\n                metadata = _agent_frontmatter.parse_agent_file(path)\n                model = metadata.get(\"model\", \"\").strip() if metadata else \"\"\n                if model:\n                    result = (model, 1.0)\n    except Exception:  # pragma: no cover - fail-open\n        result = (None, 0.0)\n    # Bounded LRU-ish cache (simple FIFO eviction at cap).\n    if len(_FRONTMATTER_MODEL_CACHE) >= _FRONTMATTER_CACHE_MAX:\n        try:\n            _FRONTMATTER_MODEL_CACHE.pop(next(iter(_FRONTMATTER_MODEL_CACHE)))\n        except StopIteration:  # pragma: no cover\n            pass\n    _FRONTMATTER_MODEL_CACHE[archetype] = result\n    return result\n\n\ndef _extract_archetype_from_payload(\n    description: str,\n    prompt: str,\n    subagent_type: str,\n) -> str:\n    \"\"\"Best-effort archetype detection from spawn payload.\n\n    Order: ``subagent_type`` (Agent tool input) → first persona header\n    line → empty string. Returns archetype slug or empty string.\n    \"\"\"\n    if subagent_type:\n        return subagent_type.strip().lower()\n    # Try to find archetype from persona header in prompt\n    if prompt:\n        m = re.search(\n            r\"(?:archetype|role|persona):\\s*([a-z][a-z0-9_-]+)\",\n            prompt,\n            flags=re.IGNORECASE,\n        )\n        if m:\n            return m.group(1).strip().lower()\n    return \"\"\n\n\ndef _emit_model_routing_advisory(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n    project_dir: Optional[str] = None,\n) -> None:\n    \"\"\"Emit a `model_routing_advised` advisory event for this spawn.\n\n    PLAN-078 Wave 1. Telemetry-only — this function:\n      - reads archetype from spawn payload\n      - reads `.claude/agents/<archetype>.md` frontmatter `model:` if set\n      - else calls `task_route.classify()` for a recommendation\n      - emits via audit_emit (deny-by-default 6-field allowlist)\n\n    NEVER raises. Bypass via `CEO_MODEL_ROUTING=0`.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if (src_env.get(\"CEO_MODEL_ROUTING\") or \"\").strip() == \"0\":\n            return  # bypass\n        if not _AUDIT_EMIT_AVAILABLE:\n            return  # audit emit unavailable; nothing to do\n\n        archetype = _extract_archetype_from_payload(\n            description or \"\", prompt or \"\", subagent_type or \"\"\n        )\n        if not archetype:\n            return  # generic spawn — no archetype to route\n\n        # Path A: agent frontmatter declared model -> authoritative.\n        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        agents_dir = Path(proj) / \".claude\" / \"agents\"\n        fm_model, fm_conf = _read_archetype_model_frontmatter(\n            archetype, agents_dir\n        )\n\n        if fm_model:\n            model_recommended = fm_model\n            confidence = fm_conf\n            applied_or_skipped = \"skipped_classify_frontmatter_authoritative\"\n            override_reason = \"frontmatter_model_present\"\n            task_type = \"frontmatter\"\n        else:\n            # Path B: in-process classify.\n            tr = _resolve_task_route()\n            if tr is None or not hasattr(tr, \"classify\"):\n                # Fail-open: no recommendation available, advisory skipped.\n                return\n            try:\n                desc_text = (description or \"\")[:8 * 1024]  # cap to 8KiB\n                result = tr.classify(desc_text, [])\n            except Exception:\n                # classify() raised — fail-open with breadcrumb attempt.\n                _emit_advisory_safe(\n                    archetype=archetype,\n                    task_type=\"classify_error\",\n                    model_recommended=\"\",\n                    confidence=0.0,\n                    applied_or_skipped=\"skipped_classify_exception\",\n                    override_reason=\"classify_raised\",\n                )\n                return\n            classification = (\n                result.get(\"classification\") if isinstance(result, dict) else \"\"\n            ) or \"\"\n            # Conservative mapping: classify() returns S/M/L/XL classification —\n            # not a model directly. Telemetry records the classification +\n            # leaves model_recommended empty so PLAN-079 can decide the mapping.\n            model_recommended = \"\"\n            confidence = 0.7 if classification else 0.0\n            applied_or_skipped = (\n                \"advisory_only_no_recommendation\"\n                if not classification\n                else \"advisory_only_classification_emitted\"\n            )\n            override_reason = \"\"\n            task_type = classification or \"unclassified\"\n\n        _emit_advisory_safe(\n            archetype=archetype,\n            task_type=task_type,\n            model_recommended=model_recommended,\n            confidence=float(confidence),\n            applied_or_skipped=applied_or_skipped,\n            override_reason=override_reason,\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return\n","numLines":241,"startLine":1,"totalLines":241}},"tool_result_meta":[{"id":"toolu_01Ez34LbsoHRDFpy89dFYXr6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch4aF6DaoQV3AuNmafSRE","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JkoBeoFQH3TqUbMgbRceKG","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/advisories.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12115,"cache_read_input_tokens":106551,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12115},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"40338bc2-cc97-4f06-a91a-aaf4218b58c4","timestamp":"2026-11-15T10:42:10.849Z","request_id":"req_011Ch4aF5yx7sWDVAFETkFG2","wire_tool_inputs":{"toolu_01JkoBeoFQH3TqUbMgbRceKG":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/advisories.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JkoBeoFQH3TqUbMgbRceKG","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport re\n4\t\n5\t__all__ = ('_consult_model_routing_mode', '_MCP_ARCHETYPE_TASK_CLASS_HINTS', '_PROMOTION_ARCHETYPE_HINTS', '_emit_mcp_routing_advisory', '_emit_promotion_advisory', '_emit_advisory_safe', '_PERSONA_HEADER_RE', '_SKILL_CONTENT_MARKER', '_SKILL_CONTENT_MIN_BYTES', '_SKILL_CONTENT_MARKER_RE', '_NEXT_H2_RE', '_CODE_FENCE_RE', '_HTML_COMMENT_RE', '_SPEC_CONTEXT_HEADER_RE', '_sanitize_spec_context_advisory', '_enforce_spec_context_unicode', '_unicode_hardblock_enforced', '_emit_spawn_confidence_advisory')\n6\t\n7\t# ---------------------------------------------------------------------------\n8\t# PLAN-112-FOLLOWUP-persona-routing-wire W1+W2+W3 — god-mode matrix consult.\n9\t# ---------------------------------------------------------------------------\n10\t# Consult ALL THREE persona_routing APIs (AC1):\n11\t# `get_mode(archetype, \"AUTO-05\")` (recorded mode label) +\n12\t# `is_enforcing(archetype, \"AUTO-05\")` (authoritative effective-enforcing\n13\t# boolean that drives `decision`) + `is_killswitch_active()` (records the\n14\t# kill-switch state) and EMIT the resulting mode as forensic telemetry\n15\t# (`model_routing_enforced`). This closes the F-1.2 dead-policy (the\n16\t# AUTO-05 enforcing cell was never read at runtime).\n17\t#\n18\t# W3 — DEFERRED BLOCK + FLIP DOCTRINE:\n19\t#   The actual model-tier BLOCK is DEFERRED. A \"model mismatch -> block\"\n20\t#   predicate needs the dispatched/requested model, but the Agent hook\n21\t#   payload exposes only description/prompt/subagent_type/run_in_background\n22\t#   (SPEC/v1/hook-io.schema.md). `metadata.get(\"model\")` (read in\n23\t#   `_read_archetype_model_frontmatter`) is the AGENT FRONTMATTER model, NOT\n24\t#   a spawn-requested model. With no requested-model input, a block would be\n25\t#   theater. When the harness exposes the dispatched model to PreToolUse, the\n26\t#   violation predicate becomes a 1-liner: fm_model present AND requested\n27\t#   present AND differing.\n28\t#   The future enable of that block is governed by OBSERVED-VIOLATION VOLUME\n29\t#   + a false-positive-rate threshold, NOT by elapsed calendar days\n30\t#   (ADR-095 / [[feedback-no-calendar-gates-ai-workflow]]). Recorded here as\n31\t#   the flip doctrine for a future ADR-118-AMEND-2.\n32\t#\n33\t# SECURITY INVARIANTS:\n34\t#   - Mode is read off the AUTHORITATIVE `subagent_type`-derived archetype\n35\t#     ONLY — NEVER the prompt-regex archetype (attacker-controllable; a\n36\t#     spoofed archetype must not flip the recorded mode). CWE-400/spoofing.\n37\t#   - Fail-OPEN: import/get_mode failure -> emit `model_routing_eval_error`\n38\t#     and return; NEVER raise in the hook hot path (CLAUDE.md §5).\n39\t#   - Kill-switch precedence: get_mode() already demotes an enforcing cell\n40\t#     to advisory under `CEO_GODMODE_ENFORCING=0`; we record the demoted\n41\t#     mode (advisory) so the audit reflects effective policy.\n42\tdef _consult_model_routing_mode(\n43\t    *,\n44\t    description: str,\n45\t    prompt: str,\n46\t    subagent_type: str,\n47\t    env: Optional[Dict[str, str]] = None,\n48\t    project_dir: Optional[str] = None,\n49\t) -> None:\n50\t    \"\"\"Consult the god-mode routing matrix + emit forensic telemetry.\n51\t\n52\t    CONSULT + AUDIT ONLY. NEVER blocks, NEVER mutates tool_input, NEVER\n53\t    raises. Consults all THREE persona_routing APIs (AC1): `get_mode`\n54\t    (recorded mode label), `is_enforcing` (authoritative effective-\n55\t    enforcing boolean that drives `decision`), and `is_killswitch_active`.\n56\t    Emits `model_routing_enforced` (mode/recommended_model/\n57\t    killswitch_armed/decision) on success, `model_routing_eval_error`\n58\t    (decision=eval_error) on any infra failure (fail-open).\n59\t    \"\"\"\n60\t    try:\n61\t        src_env = env if env is not None else os.environ\n62\t        if not _AUDIT_EMIT_AVAILABLE:\n63\t            return  # nothing to audit against; consult is observability-only\n64\t\n65\t        # AUTHORITATIVE source ONLY — subagent_type. A prompt-regex archetype\n66\t        # is attacker-controllable and must not flip the recorded mode.\n67\t        archetype = (subagent_type or \"\").strip().lower()\n68\t        if not archetype:\n69\t            return  # no authoritative archetype -> no mode to record\n70\t\n71\t        session_id = src_env.get(\"CLAUDE_SESSION_ID\", \"\") or \"\"\n72\t        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n73\t\n74\t        # Fail-OPEN guard around the matrix consult.\n75\t        try:\n76\t            if _persona_routing is None:\n77\t                raise RuntimeError(\"persona_routing import unavailable\")\n78\t            # NEVER read _PRIMITIVE_DEFAULT_MODE directly — get_mode /\n79\t            # is_enforcing honor the kill-switch demotion internally.\n80\t            # All THREE persona_routing APIs are consulted (AC1):\n81\t            #   - get_mode      -> the effective (possibly demoted) mode label\n82\t            #                      recorded verbatim in the emit\n83\t            #   - is_enforcing  -> the AUTHORITATIVE effective-enforcing boolean\n84\t            #                      that drives `decision` (kill-switch already\n85\t            #                      folded in: returns False when demoted)\n86\t            #   - is_killswitch_active -> records whether the kill-switch armed\n87\t            mode = _persona_routing.get_mode(archetype, \"AUTO-05\")\n88\t            is_enforcing = bool(\n89\t                _persona_routing.is_enforcing(archetype, \"AUTO-05\")\n90\t            )\n91\t            killswitch_armed = bool(_persona_routing.is_killswitch_active())\n92\t        except Exception:  # noqa: BLE001 — fail-open per CLAUDE.md §5\n93\t            try:\n94\t                _audit_emit.emit_generic(\n95\t                    \"model_routing_eval_error\",\n96\t                    archetype=archetype[:64],\n97\t                    reason_code=\"persona_routing_eval_failed\",\n98\t                    decision=\"eval_error\",\n99\t                    session_id=session_id,\n100\t                    project=str(proj)[:256],\n101\t                )\n102\t            except Exception:  # noqa: BLE001\n103\t                pass\n104\t            return\n105\t\n106\t        # recommended_model: best-effort authoritative agent-frontmatter\n107\t        # model for this archetype (NOT a spawn-requested model). \"\" when\n108\t        # absent. Reuses the cached frontmatter reader.\n109\t        recommended_model = \"\"\n110\t        try:\n111\t            agents_dir = Path(proj) / \".claude\" / \"agents\"\n112\t            fm_model, _conf = _read_archetype_model_frontmatter(\n113\t                archetype, agents_dir\n114\t            )\n115\t            recommended_model = (fm_model or \"\")[:64]\n116\t        except Exception:  # noqa: BLE001 — telemetry enrichment is optional\n117\t            recommended_model = \"\"\n118\t\n119\t        # decision enum: enforce_telemetry | advisory | eval_error.\n120\t        # NO `block` value — block deferred (§2.4). Derived from the\n121\t        # AUTHORITATIVE is_enforcing() boolean (NOT a re-derivation from\n122\t        # the `mode` string), so the kill-switch demotion already folded\n123\t        # into is_enforcing() drives the decision. `mode` (possibly\n124\t        # demoted to \"advisory\" by get_mode) is still recorded verbatim.\n125\t        decision = \"enforce_telemetry\" if is_enforcing else \"advisory\"\n126\t\n127\t        try:\n128\t            _audit_emit.emit_generic(\n129\t                \"model_routing_enforced\",\n130\t                archetype=archetype[:64],\n131\t                mode=str(mode)[:16],\n132\t                recommended_model=recommended_model,\n133\t                killswitch_armed=killswitch_armed,\n134\t                decision=decision,\n135\t                session_id=session_id,\n136\t                project=str(proj)[:256],\n137\t            )\n138\t        except Exception:  # noqa: BLE001 — fail-open\n139\t            return\n140\t    except Exception:  # pragma: no cover — fail-open invariant\n141\t        return\n142\t\n143\t\n144\t# PLAN-091 Wave A.4 (W3.1) — archetype → mcp_routing task_class heuristic.\n145\t#\n146\t# Maps the spawn's archetype to one of the 4 task_class strings declared in\n147\t# `_lib/mcp_routing._ROUTING_TABLE`. mcp_routing.resolve() emits its own\n148\t# `mcp_route_advised` advisory (PLAN-086 Wave D) — the spawn-hook wire only\n149\t# needs to trigger the resolver at the right callsite. NO mapping fallthrough\n150\t# = NO emit (advisory-only; avoid noise on every spawn).\n151\t_MCP_ARCHETYPE_TASK_CLASS_HINTS: Tuple[Tuple[Tuple[str, ...], str], ...] = (\n152\t    # ORDER MATTERS — first match wins. More-specific archetype slugs\n153\t    # (finops/seo/crypto) come BEFORE the bare \"architect\" pattern so\n154\t    # composite slugs like \"llm-finops-architect\" or \"crypto-research-\n155\t    # analyst\" route to the more specific MCP server bundle.\n156\t    ((\"finops\", \"cost\", \"budget\"), \"finops\"),\n157\t    ((\"seo\", \"ahrefs\", \"similarweb\"), \"seo_research\"),\n158\t    ((\"crypto\", \"lunarcrush\", \"blockchain\"), \"crypto_research\"),\n159\t    ((\"architect\", \"arch-\"), \"arch\"),\n160\t)\n161\t\n162\t\n163\t# PLAN-091 Wave A.5 (W3.3) — archetype-hint patterns triggering a\n164\t# `specialization_promoted` advisory when subagent_type == general-purpose.\n165\t# Match is FIRST-HIT, not exhaustive — keeps emit volume bounded. Hints\n166\t# are lowercase substring matches on (description + prompt).\n167\t_PROMOTION_ARCHETYPE_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n168\t    (\"performance-engineer\",\n169\t     (\"latency\", \"p95\", \"p99\", \"profile\", \"memory leak\", \"throughput\",\n170\t      \"gc tuning\", \"hot path\")),\n171\t    (\"security-engineer\",\n172\t     (\"jwt\", \"oauth\", \"authentication\", \"vulnerability\", \"owasp\",\n173\t      \"xss\", \"sql injection\", \"csrf\", \"rate limiting\")),\n174\t    (\"qa-architect\",\n175\t     (\"test strategy\", \"mutation testing\", \"flake\", \"regression\",\n176\t      \"property-based\", \"fuzz\", \"contract test\")),\n177\t    (\"code-reviewer\",\n178\t     (\"merge gate\", \"code review\", \"veto\", \"review checklist\")),\n179\t    (\"incident-commander\",\n180\t     (\"incident commander\", \"severity classification\", \"all-clear\",\n181\t      \"paging policy\", \"post-incident review\")),\n182\t    (\"identity-trust-architect\",\n183\t     (\"token rotation\", \"session lifecycle\", \"rbac\", \"abac\",\n184\t      \"service-to-service trust\", \"mtls\")),\n185\t    (\"threat-detection-engineer\",\n186\t     (\"mitre att&ck\", \"siem rule\", \"detection rule\", \"alert deduplication\",\n187\t      \"purple team\", \"threat hunting\")),\n188\t    (\"devops\",\n189\t     (\"github actions\", \"sha-pin\", \"ci/cd pipeline\", \"rollback strategy\",\n190\t      \"secret rotation\")),\n191\t)\n192\t\n193\t\n194\tdef _emit_mcp_routing_advisory(\n195\t    *,\n196\t    description: str,\n197\t    prompt: str,\n198\t    subagent_type: str,\n199\t    env: Optional[Dict[str, str]] = None,\n200\t) -> None:\n201\t    \"\"\"PLAN-091 Wave A.4 (W3.1) — emit `mcp_route_advised` for this spawn.\n202\t\n203\t    Derives task_class from the spawn's archetype via the\n204\t    ``_MCP_ARCHETYPE_TASK_CLASS_HINTS`` table, then delegates to\n205\t    ``_lib/mcp_routing.resolve()`` which performs its own emit (per\n206\t    PLAN-086 Wave D). Bypass: ``CEO_MCP_ROUTING_HOOK=0`` (parallel to\n207\t    PLAN-078 model-routing bypass; per-server kill switches live inside\n208\t    mcp_routing.resolve()).\n209\t\n210\t    NEVER raises. Advisory-only — never mutates tool_input, never blocks.\n211\t    \"\"\"\n212\t    try:\n213\t        src_env = env if env is not None else os.environ\n214\t        if (src_env.get(\"CEO_MCP_ROUTING_HOOK\") or \"\").strip() == \"0\":\n215\t            return\n216\t        archetype = _extract_archetype_from_payload(\n217\t            description or \"\", prompt or \"\", subagent_type or \"\"\n218\t        )\n219\t        if not archetype:\n220\t            return\n221\t        archetype_lc = archetype.lower()\n222\t        task_class: Optional[str] = None\n223\t        for hints, mapped in _MCP_ARCHETYPE_TASK_CLASS_HINTS:\n224\t            if any(h in archetype_lc for h in hints):\n225\t                task_class = mapped\n226\t                break\n227\t        if task_class is None:\n228\t            return  # no mapping; emit volume stays bounded\n229\t        try:\n230\t            from _lib import mcp_routing as _mcpr  # type: ignore\n231\t            _mcpr.resolve(task_class)  # resolver fires advisory emit\n232\t        except Exception:  # pragma: no cover - fail-open\n233\t            return\n234\t    except Exception:  # pragma: no cover - fail-open\n235\t        return\n236\t\n237\t\n238\tdef _emit_promotion_advisory(\n239\t    *,\n240\t    description: str,\n241\t    prompt: str,\n242\t    subagent_type: str,\n243\t    env: Optional[Dict[str, str]] = None,\n244\t) -> None:\n245\t    \"\"\"PLAN-091 Wave A.5 (W3.3) — emit `specialization_promoted` when a\n246\t    ``general-purpose`` spawn matches a specialist archetype heuristic.\n247\t\n248\t    Advisory ONLY — does NOT auto-spawn the suggested specialist. Records\n249\t    the suggestion in audit log so PLAN-094+ can promote SEMI to AUTO once\n250\t    confidence is established. Bypass: ``CEO_PROMOTION_HEURISTIC=0``.\n251\t\n252\t    First-hit match wins (bounded emit volume). NEVER raises.\n253\t    \"\"\"\n254\t    try:\n255\t        src_env = env if env is not None else os.environ\n256\t        if (src_env.get(\"CEO_PROMOTION_HEURISTIC\") or \"\").strip() == \"0\":\n257\t            return\n258\t        if (subagent_type or \"\").strip().lower() != \"general-purpose\":\n259\t            return\n260\t        if not _AUDIT_EMIT_AVAILABLE:\n261\t            return\n262\t        text = ((description or \"\") + \"\\n\" + (prompt or \"\")).lower()\n263\t        text = text[: 8 * 1024]  # 8KiB cap on hint-scan window\n264\t        for suggested, hints in _PROMOTION_ARCHETYPE_HINTS:\n265\t            for hint in hints:\n266\t                if hint in text:\n267\t                    try:\n268\t                        # PLAN-088 R2 iter-2 STRICKEN specialization_promoted\n269\t                        # as separate action; routed via mcp_route_advised\n270\t                        # with signal_source discriminator per audit_emit.py\n271\t                        # 5099-5105 contract.\n272\t                        _audit_emit.emit_generic(\n273\t                            \"mcp_route_advised\",\n274\t                            session_id=\"\",\n275\t                            task_class=\"promotion\",\n276\t                            suggested_servers=suggested[:64],\n277\t                            kill_switch_overrides=\"\",\n278\t                            signal_source=\"specialization_promoted\",\n279\t                        )\n280\t                    except Exception:  # pragma: no cover - fail-open\n281\t                        pass\n282\t                    return  # first-hit wins\n283\t    except Exception:  # pragma: no cover - fail-open\n284\t        return\n285\t\n286\t\n287\tdef _emit_advisory_safe(\n288\t    *,\n289\t    archetype: str,\n290\t    task_type: str,\n291\t    model_recommended: str,\n292\t    confidence: float,\n293\t    applied_or_skipped: str,\n294\t    override_reason: str,\n295\t) -> None:\n296\t    \"\"\"Wrapper around audit_emit.emit_generic for `model_routing_advised`.\n297\t\n298\t    Allowlist enforced by audit_emit dispatcher (defense-in-depth). Caller\n299\t    only fills the 6 contract fields; ts/session/project added by emit_generic.\n300\t\n301\t    Codex W1+W2 fix-pack #2: ``confidence`` (float 0..1) is converted at\n302\t    emission time to ``confidence_basis_points`` (int 0..1000) — floats\n303\t    are forbidden in HMAC-covered fields (canonical_json invariant). The\n304\t    in-process API surface still accepts ``confidence: float`` for\n305\t    ergonomic continuity; conversion is colocated with the emit call.\n306\t    \"\"\"\n307\t    try:\n308\t        if not _AUDIT_EMIT_AVAILABLE:\n309\t            return\n310\t        # Convert float confidence -> int basis-points. NaN / out-of-range\n311\t        # collapse to 0 (lower clamp in audit_emit emitter).\n312\t        try:\n313\t            conf_f = float(confidence)\n314\t        except (TypeError, ValueError):\n315\t            conf_f = 0.0\n316\t        if conf_f != conf_f or conf_f in (float(\"inf\"), float(\"-inf\")):\n317\t            conf_f = 0.0\n318\t        if conf_f < 0.0:\n319\t            conf_f = 0.0\n320\t        if conf_f > 1.0:\n321\t            conf_f = 1.0\n322\t        confidence_bp = int(round(conf_f * 1000.0))\n323\t        # Length-bound caller strings (defense-in-depth on adopter drift).\n324\t        _audit_emit.emit_generic(\n325\t            \"model_routing_advised\",\n326\t            archetype=(archetype or \"\")[:64],\n327\t            task_type=(task_type or \"\")[:32],\n328\t            model_recommended=(model_recommended or \"\")[:64],\n329\t            confidence_basis_points=confidence_bp,\n330\t            applied_or_skipped=(applied_or_skipped or \"\")[:64],\n331\t            override_reason=(override_reason or \"\")[:128],\n332\t        )\n333\t    except Exception:  # pragma: no cover - fail-open\n334\t        return\n335\t\n336\t\n337\t# Persona header patterns — must appear at the START of a line.\n338\t_PERSONA_HEADER_RE = re.compile(\n339\t    r\"^(?:PERSONA:|## AGENT PROFILE|## PERSONA)\",\n340\t    flags=re.MULTILINE,\n341\t)\n342\t\n343\t# Governance requirement: named spawns must include this literal section.\n344\t_SKILL_CONTENT_MARKER = \"## SKILL CONTENT\"\n345\t\n346\t# PLAN-019 Phase 2B P1-SEC-B — minimum body size (non-whitespace bytes)\n347\t# required between `## SKILL CONTENT` and the next `##` heading / EOF for\n348\t# the marker to count as a real skill-content section. Rejects empty-body,\n349\t# stub-only, or single-line \"see file X\" shells.\n350\t_SKILL_CONTENT_MIN_BYTES = 256\n351\t\n352\t# Regex to find the marker ON ITS OWN LINE (ignoring trailing whitespace).\n353\t_SKILL_CONTENT_MARKER_RE = re.compile(\n354\t    r\"^## SKILL CONTENT[ \\t]*$\",\n355\t    flags=re.MULTILINE,\n356\t)\n357\t\n358\t# Regex to find the next `##`-level heading (to bound the body extraction).\n359\t_NEXT_H2_RE = re.compile(r\"^##[ \\t]\", flags=re.MULTILINE)\n360\t\n361\t# Code-fence markers (``` or ~~~ with optional language tag).\n362\t_CODE_FENCE_RE = re.compile(r\"^(?:```|~~~)\", flags=re.MULTILINE)\n363\t\n364\t# HTML comment pair — non-greedy across lines.\n365\t_HTML_COMMENT_RE = re.compile(r\"<!--.*?-->\", flags=re.DOTALL)\n366\t\n367\t# Regex to extract ## SPEC CONTEXT block content (between its header and next\n368\t# ## heading or EOF). Used by _sanitize_spec_context_advisory() below.\n369\t_SPEC_CONTEXT_HEADER_RE = re.compile(\n370\t    r\"^##[ \\t]+SPEC[ \\t]+CONTEXT[ \\t]*$\",\n371\t    flags=re.MULTILINE,\n372\t)\n373\t\n374\t\n375\tdef _sanitize_spec_context_advisory(prompt: str, env=None) -> None:\n376\t    \"\"\"PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n377\t    payload and emit telemetry advisory.\n378\t\n379\t    Extracts the ## SPEC CONTEXT block from the spawn prompt, runs it\n380\t    through spec_context_sanitizer.sanitize(), and emits a\n381\t    `spec_context_sanitized` audit-emit event so sentinel violations,\n382\t    truncation, and control-char counts are observable.\n383\t\n384\t    ADVISORY ONLY — never blocks the spawn. Fail-open on any exception.\n385\t    Kill-switch: CEO_SPEC_CTX_SANITIZER_ENABLED=0.\n386\t    \"\"\"\n387\t    try:\n388\t        if not _SPEC_CTX_SANITIZER_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n389\t            return\n390\t        src_env = env if env is not None else os.environ\n391\t        val = (src_env.get(\"CEO_SPEC_CTX_SANITIZER_ENABLED\") or \"1\").strip()\n392\t        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n393\t            return\n394\t        if not prompt:\n395\t            return\n396\t        # Extract ## SPEC CONTEXT block content\n397\t        m = _SPEC_CONTEXT_HEADER_RE.search(prompt)\n398\t        if m is None:\n399\t            return  # no SPEC CONTEXT block — nothing to sanitize\n400\t        block_start = m.end()\n401\t        next_h2 = _NEXT_H2_RE.search(prompt, block_start)\n402\t        block_end = next_h2.start() if next_h2 else len(prompt)\n403\t        spec_payload = prompt[block_start:block_end]\n404\t\n405\t        result = _spec_ctx_sanitizer.sanitize(spec_payload)\n406\t\n407\t        # Emit telemetry (advisory only; sentinel violations logged for CEO)\n408\t        try:\n409\t            _audit_emit.emit_generic(\n410\t                \"spec_context_sanitized\",\n411\t                original_bytes=result.original_bytes,\n412\t                cleaned_bytes=result.cleaned_bytes,\n413\t                truncated=1 if result.truncated else 0,\n414\t                sentinel_violations=len(result.sentinel_violations),\n415\t                control_chars_stripped=result.control_chars_stripped,\n416\t                bidi_zw_chars_stripped=result.bidi_zw_chars_stripped,\n417\t                # PLAN-133 A2 — surface the Tag-block count too (allowlisted in\n418\t                # audit_emit §7d). Harmless if the SanitizeResult lacks the field\n419\t                # (getattr default 0) so this stays import-order tolerant.\n420\t                tag_chars_stripped=getattr(result, \"tag_chars_stripped\", 0),\n421\t                header_escape_count=result.header_escape_count,\n422\t            )\n423\t        except Exception:  # pragma: no cover - fail-open\n424\t            pass\n425\t    except Exception:  # pragma: no cover - fail-open\n426\t        return\n427\t\n428\t\n429\tdef _enforce_spec_context_unicode(prompt: str, env=None):\n430\t    \"\"\"PLAN-133 A2 — fail-CLOSED invisible-unicode guard on the spawn prompt.\n431\t\n432\t    Scans the WHOLE spawn prompt (not just the ## SPEC CONTEXT block — an attacker\n433\t    can smuggle Tag-block/bidi chars anywhere in the named-spawn body) for invisible\n434\t    /smuggling unicode (control / bidi / zero-width / U+E0000-E007F Tag-block).\n435\t\n436\t    Default-OFF (doctrine #1): the BLOCK fires only when CEO_UNICODE_HARDBLOCK=='1'\n437\t    in the import-time trusted_env snapshot. Otherwise advisory — the breadcrumb is\n438\t    emitted with enforced=0 (measure-first) and None is returned (no block).\n439\t\n440\t    Returns a block-reason string when enforced AND a detection fires, else None.\n441\t    Fail-OPEN on any infra exception (never blocks the session on a scanner bug).\n442\t    Master kill: CEO_SOTA_DISABLE=1 forces advisory.\n443\t    \"\"\"\n444\t    try:\n445\t        if not _SPEC_CTX_SANITIZER_AVAILABLE:\n446\t            return None\n447\t        src_env = env if env is not None else os.environ\n448\t        if not prompt:\n449\t            return None\n450\t        # Default-OFF flag, read from the trusted_env snapshot when available so a\n451\t        # late-set value can't toggle enforcement mid-process. Master kill wins.\n452\t        if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n453\t            enforce = False\n454\t        else:\n455\t            enforce = _unicode_hardblock_enforced(src_env)\n456\t\n457\t        result = _spec_ctx_sanitizer.sanitize(prompt)\n458\t        count = _spec_ctx_sanitizer.invisible_unicode_count(result)\n459\t        if count <= 0:\n460\t            return None  # clean — nothing to do\n461\t\n462\t        unicode_class = _spec_ctx_sanitizer.classify_invisible_unicode(result)\n463\t\n464\t        # Emit the closed-enum breadcrumb on BOTH advisory and enforced paths\n465\t        # (the denominator must be real from day one — no 0/0/0 trap).\n466\t        if _AUDIT_EMIT_AVAILABLE:\n467\t            try:\n468\t                _audit_emit.emit_generic(\n469\t                    \"invisible_unicode_blocked\",\n470\t                    surface=\"spawn\",\n471\t                    unicode_class=unicode_class,\n472\t                    char_count=int(count),\n473\t                    enforced=1 if enforce else 0,\n474\t                )\n475\t            except Exception:  # pragma: no cover - fail-open\n476\t                pass\n477\t\n478\t        if not enforce:\n479\t            return None  # advisory only\n480\t\n481\t        return (\n482\t            \"GOVERNANCE: invisible_unicode_blocked: the spawn prompt contains \"\n483\t            f\"{count} invisible/smuggling character(s) (class={unicode_class}: \"\n484\t            \"control / bidi / zero-width / Unicode-Tags-block). These are \"\n485\t            \"removed by the sanitizer and rejected fail-CLOSED before review. \"\n486\t            \"Remove the hidden characters and re-spawn. To run advisory-only, \"\n487\t            \"unset CEO_UNICODE_HARDBLOCK.\"\n488\t        )\n489\t    except Exception:  # pragma: no cover - fail-open invariant\n490\t        return None\n491\t\n492\t\n493\tdef _unicode_hardblock_enforced(src_env) -> bool:\n494\t    \"\"\"True iff CEO_UNICODE_HARDBLOCK=='1' (PLAN-133 A2). Prefers the trusted_env\n495\t    snapshot; falls back to the passed env dict. Pure; never raises.\"\"\"\n496\t    try:\n497\t        from _lib import trusted_env as _te  # noqa: E402\n498\t        val = _te.get_trusted(\"CEO_UNICODE_HARDBLOCK\")\n499\t        if val is not None:\n500\t            return (val or \"\").strip() == \"1\"\n501\t    except Exception:  # pragma: no cover\n502\t        pass\n503\t    return (src_env.get(\"CEO_UNICODE_HARDBLOCK\") or \"\").strip() == \"1\"\n504\t\n505\t\n506\tdef _emit_spawn_confidence_advisory(\n507\t    *,\n508\t    action_type: str,\n509\t    is_named_spawn: bool,\n510\t    env=None,\n511\t) -> None:\n512\t    \"\"\"PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n513\t\n514\t    Classifies the spawn as an action and emits `spawn_confidence_advisory`\n515\t    so recommender / receipt formatter surfaces have a hook-level confidence\n516\t    signal for governance dashboards.\n517\t\n518\t    ADVISORY ONLY — never blocks. Fail-open on any exception.\n519\t    Kill-switch: CEO_SPAWN_CONFIDENCE_ENABLED=0.\n520\t    \"\"\"\n521\t    try:\n522\t        if not _CONFIDENCE_LABELS_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n523\t            return\n524\t        src_env = env if env is not None else os.environ\n525\t        val = (src_env.get(\"CEO_SPAWN_CONFIDENCE_ENABLED\") or \"1\").strip()\n526\t        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n527\t            return\n528\t\n529\t        ctx = {\"canonical\": False}\n530\t        conf = _confidence_labels.classify(action_type, ctx)\n531\t        marker = _confidence_labels.as_emoji_free_marker(conf)\n532\t\n533\t        try:\n534\t            _audit_emit.emit_generic(\n535\t                \"spawn_confidence_advisory\",\n536\t                action_type=(action_type or \"\")[:32],\n537\t                confidence_level=(conf.level or \"\")[:32],\n538\t                confidence_marker=(marker or \"\")[:32],\n539\t                reason_code=(conf.reason_code or \"\")[:64],\n540\t                is_named_spawn=1 if is_named_spawn else 0,\n541\t            )\n542\t        except Exception:  # pragma: no cover - fail-open\n543\t            pass\n544\t    except Exception:  # pragma: no cover - fail-open\n545\t        return\n546\t"}]},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"2ce628a4-7f4b-4e3c-9748-d9012728a204","timestamp":"2026-11-15T10:42:10.867Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/agent_spawn/advisories.py","content":"from __future__ import annotations\n\nimport re\n\n__all__ = ('_consult_model_routing_mode', '_MCP_ARCHETYPE_TASK_CLASS_HINTS', '_PROMOTION_ARCHETYPE_HINTS', '_emit_mcp_routing_advisory', '_emit_promotion_advisory', '_emit_advisory_safe', '_PERSONA_HEADER_RE', '_SKILL_CONTENT_MARKER', '_SKILL_CONTENT_MIN_BYTES', '_SKILL_CONTENT_MARKER_RE', '_NEXT_H2_RE', '_CODE_FENCE_RE', '_HTML_COMMENT_RE', '_SPEC_CONTEXT_HEADER_RE', '_sanitize_spec_context_advisory', '_enforce_spec_context_unicode', '_unicode_hardblock_enforced', '_emit_spawn_confidence_advisory')\n\n# ---------------------------------------------------------------------------\n# PLAN-112-FOLLOWUP-persona-routing-wire W1+W2+W3 — god-mode matrix consult.\n# ---------------------------------------------------------------------------\n# Consult ALL THREE persona_routing APIs (AC1):\n# `get_mode(archetype, \"AUTO-05\")` (recorded mode label) +\n# `is_enforcing(archetype, \"AUTO-05\")` (authoritative effective-enforcing\n# boolean that drives `decision`) + `is_killswitch_active()` (records the\n# kill-switch state) and EMIT the resulting mode as forensic telemetry\n# (`model_routing_enforced`). This closes the F-1.2 dead-policy (the\n# AUTO-05 enforcing cell was never read at runtime).\n#\n# W3 — DEFERRED BLOCK + FLIP DOCTRINE:\n#   The actual model-tier BLOCK is DEFERRED. A \"model mismatch -> block\"\n#   predicate needs the dispatched/requested model, but the Agent hook\n#   payload exposes only description/prompt/subagent_type/run_in_background\n#   (SPEC/v1/hook-io.schema.md). `metadata.get(\"model\")` (read in\n#   `_read_archetype_model_frontmatter`) is the AGENT FRONTMATTER model, NOT\n#   a spawn-requested model. With no requested-model input, a block would be\n#   theater. When the harness exposes the dispatched model to PreToolUse, the\n#   violation predicate becomes a 1-liner: fm_model present AND requested\n#   present AND differing.\n#   The future enable of that block is governed by OBSERVED-VIOLATION VOLUME\n#   + a false-positive-rate threshold, NOT by elapsed calendar days\n#   (ADR-095 / [[feedback-no-calendar-gates-ai-workflow]]). Recorded here as\n#   the flip doctrine for a future ADR-118-AMEND-2.\n#\n# SECURITY INVARIANTS:\n#   - Mode is read off the AUTHORITATIVE `subagent_type`-derived archetype\n#     ONLY — NEVER the prompt-regex archetype (attacker-controllable; a\n#     spoofed archetype must not flip the recorded mode). CWE-400/spoofing.\n#   - Fail-OPEN: import/get_mode failure -> emit `model_routing_eval_error`\n#     and return; NEVER raise in the hook hot path (CLAUDE.md §5).\n#   - Kill-switch precedence: get_mode() already demotes an enforcing cell\n#     to advisory under `CEO_GODMODE_ENFORCING=0`; we record the demoted\n#     mode (advisory) so the audit reflects effective policy.\ndef _consult_model_routing_mode(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n    project_dir: Optional[str] = None,\n) -> None:\n    \"\"\"Consult the god-mode routing matrix + emit forensic telemetry.\n\n    CONSULT + AUDIT ONLY. NEVER blocks, NEVER mutates tool_input, NEVER\n    raises. Consults all THREE persona_routing APIs (AC1): `get_mode`\n    (recorded mode label), `is_enforcing` (authoritative effective-\n    enforcing boolean that drives `decision`), and `is_killswitch_active`.\n    Emits `model_routing_enforced` (mode/recommended_model/\n    killswitch_armed/decision) on success, `model_routing_eval_error`\n    (decision=eval_error) on any infra failure (fail-open).\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if not _AUDIT_EMIT_AVAILABLE:\n            return  # nothing to audit against; consult is observability-only\n\n        # AUTHORITATIVE source ONLY — subagent_type. A prompt-regex archetype\n        # is attacker-controllable and must not flip the recorded mode.\n        archetype = (subagent_type or \"\").strip().lower()\n        if not archetype:\n            return  # no authoritative archetype -> no mode to record\n\n        session_id = src_env.get(\"CLAUDE_SESSION_ID\", \"\") or \"\"\n        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n\n        # Fail-OPEN guard around the matrix consult.\n        try:\n            if _persona_routing is None:\n                raise RuntimeError(\"persona_routing import unavailable\")\n            # NEVER read _PRIMITIVE_DEFAULT_MODE directly — get_mode /\n            # is_enforcing honor the kill-switch demotion internally.\n            # All THREE persona_routing APIs are consulted (AC1):\n            #   - get_mode      -> the effective (possibly demoted) mode label\n            #                      recorded verbatim in the emit\n            #   - is_enforcing  -> the AUTHORITATIVE effective-enforcing boolean\n            #                      that drives `decision` (kill-switch already\n            #                      folded in: returns False when demoted)\n            #   - is_killswitch_active -> records whether the kill-switch armed\n            mode = _persona_routing.get_mode(archetype, \"AUTO-05\")\n            is_enforcing = bool(\n                _persona_routing.is_enforcing(archetype, \"AUTO-05\")\n            )\n            killswitch_armed = bool(_persona_routing.is_killswitch_active())\n        except Exception:  # noqa: BLE001 — fail-open per CLAUDE.md §5\n            try:\n                _audit_emit.emit_generic(\n                    \"model_routing_eval_error\",\n                    archetype=archetype[:64],\n                    reason_code=\"persona_routing_eval_failed\",\n                    decision=\"eval_error\",\n                    session_id=session_id,\n                    project=str(proj)[:256],\n                )\n            except Exception:  # noqa: BLE001\n                pass\n            return\n\n        # recommended_model: best-effort authoritative agent-frontmatter\n        # model for this archetype (NOT a spawn-requested model). \"\" when\n        # absent. Reuses the cached frontmatter reader.\n        recommended_model = \"\"\n        try:\n            agents_dir = Path(proj) / \".claude\" / \"agents\"\n            fm_model, _conf = _read_archetype_model_frontmatter(\n                archetype, agents_dir\n            )\n            recommended_model = (fm_model or \"\")[:64]\n        except Exception:  # noqa: BLE001 — telemetry enrichment is optional\n            recommended_model = \"\"\n\n        # decision enum: enforce_telemetry | advisory | eval_error.\n        # NO `block` value — block deferred (§2.4). Derived from the\n        # AUTHORITATIVE is_enforcing() boolean (NOT a re-derivation from\n        # the `mode` string), so the kill-switch demotion already folded\n        # into is_enforcing() drives the decision. `mode` (possibly\n        # demoted to \"advisory\" by get_mode) is still recorded verbatim.\n        decision = \"enforce_telemetry\" if is_enforcing else \"advisory\"\n\n        try:\n            _audit_emit.emit_generic(\n                \"model_routing_enforced\",\n                archetype=archetype[:64],\n                mode=str(mode)[:16],\n                recommended_model=recommended_model,\n                killswitch_armed=killswitch_armed,\n                decision=decision,\n                session_id=session_id,\n                project=str(proj)[:256],\n            )\n        except Exception:  # noqa: BLE001 — fail-open\n            return\n    except Exception:  # pragma: no cover — fail-open invariant\n        return\n\n\n# PLAN-091 Wave A.4 (W3.1) — archetype → mcp_routing task_class heuristic.\n#\n# Maps the spawn's archetype to one of the 4 task_class strings declared in\n# `_lib/mcp_routing._ROUTING_TABLE`. mcp_routing.resolve() emits its own\n# `mcp_route_advised` advisory (PLAN-086 Wave D) — the spawn-hook wire only\n# needs to trigger the resolver at the right callsite. NO mapping fallthrough\n# = NO emit (advisory-only; avoid noise on every spawn).\n_MCP_ARCHETYPE_TASK_CLASS_HINTS: Tuple[Tuple[Tuple[str, ...], str], ...] = (\n    # ORDER MATTERS — first match wins. More-specific archetype slugs\n    # (finops/seo/crypto) come BEFORE the bare \"architect\" pattern so\n    # composite slugs like \"llm-finops-architect\" or \"crypto-research-\n    # analyst\" route to the more specific MCP server bundle.\n    ((\"finops\", \"cost\", \"budget\"), \"finops\"),\n    ((\"seo\", \"ahrefs\", \"similarweb\"), \"seo_research\"),\n    ((\"crypto\", \"lunarcrush\", \"blockchain\"), \"crypto_research\"),\n    ((\"architect\", \"arch-\"), \"arch\"),\n)\n\n\n# PLAN-091 Wave A.5 (W3.3) — archetype-hint patterns triggering a\n# `specialization_promoted` advisory when subagent_type == general-purpose.\n# Match is FIRST-HIT, not exhaustive — keeps emit volume bounded. Hints\n# are lowercase substring matches on (description + prompt).\n_PROMOTION_ARCHETYPE_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n    (\"performance-engineer\",\n     (\"latency\", \"p95\", \"p99\", \"profile\", \"memory leak\", \"throughput\",\n      \"gc tuning\", \"hot path\")),\n    (\"security-engineer\",\n     (\"jwt\", \"oauth\", \"authentication\", \"vulnerability\", \"owasp\",\n      \"xss\", \"sql injection\", \"csrf\", \"rate limiting\")),\n    (\"qa-architect\",\n     (\"test strategy\", \"mutation testing\", \"flake\", \"regression\",\n      \"property-based\", \"fuzz\", \"contract test\")),\n    (\"code-reviewer\",\n     (\"merge gate\", \"code review\", \"veto\", \"review checklist\")),\n    (\"incident-commander\",\n     (\"incident commander\", \"severity classification\", \"all-clear\",\n      \"paging policy\", \"post-incident review\")),\n    (\"identity-trust-architect\",\n     (\"token rotation\", \"session lifecycle\", \"rbac\", \"abac\",\n      \"service-to-service trust\", \"mtls\")),\n    (\"threat-detection-engineer\",\n     (\"mitre att&ck\", \"siem rule\", \"detection rule\", \"alert deduplication\",\n      \"purple team\", \"threat hunting\")),\n    (\"devops\",\n     (\"github actions\", \"sha-pin\", \"ci/cd pipeline\", \"rollback strategy\",\n      \"secret rotation\")),\n)\n\n\ndef _emit_mcp_routing_advisory(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n) -> None:\n    \"\"\"PLAN-091 Wave A.4 (W3.1) — emit `mcp_route_advised` for this spawn.\n\n    Derives task_class from the spawn's archetype via the\n    ``_MCP_ARCHETYPE_TASK_CLASS_HINTS`` table, then delegates to\n    ``_lib/mcp_routing.resolve()`` which performs its own emit (per\n    PLAN-086 Wave D). Bypass: ``CEO_MCP_ROUTING_HOOK=0`` (parallel to\n    PLAN-078 model-routing bypass; per-server kill switches live inside\n    mcp_routing.resolve()).\n\n    NEVER raises. Advisory-only — never mutates tool_input, never blocks.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if (src_env.get(\"CEO_MCP_ROUTING_HOOK\") or \"\").strip() == \"0\":\n            return\n        archetype = _extract_archetype_from_payload(\n            description or \"\", prompt or \"\", subagent_type or \"\"\n        )\n        if not archetype:\n            return\n        archetype_lc = archetype.lower()\n        task_class: Optional[str] = None\n        for hints, mapped in _MCP_ARCHETYPE_TASK_CLASS_HINTS:\n            if any(h in archetype_lc for h in hints):\n                task_class = mapped\n                break\n        if task_class is None:\n            return  # no mapping; emit volume stays bounded\n        try:\n            from _lib import mcp_routing as _mcpr  # type: ignore\n            _mcpr.resolve(task_class)  # resolver fires advisory emit\n        except Exception:  # pragma: no cover - fail-open\n            return\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _emit_promotion_advisory(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n) -> None:\n    \"\"\"PLAN-091 Wave A.5 (W3.3) — emit `specialization_promoted` when a\n    ``general-purpose`` spawn matches a specialist archetype heuristic.\n\n    Advisory ONLY — does NOT auto-spawn the suggested specialist. Records\n    the suggestion in audit log so PLAN-094+ can promote SEMI to AUTO once\n    confidence is established. Bypass: ``CEO_PROMOTION_HEURISTIC=0``.\n\n    First-hit match wins (bounded emit volume). NEVER raises.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if (src_env.get(\"CEO_PROMOTION_HEURISTIC\") or \"\").strip() == \"0\":\n            return\n        if (subagent_type or \"\").strip().lower() != \"general-purpose\":\n            return\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        text = ((description or \"\") + \"\\n\" + (prompt or \"\")).lower()\n        text = text[: 8 * 1024]  # 8KiB cap on hint-scan window\n        for suggested, hints in _PROMOTION_ARCHETYPE_HINTS:\n            for hint in hints:\n                if hint in text:\n                    try:\n                        # PLAN-088 R2 iter-2 STRICKEN specialization_promoted\n                        # as separate action; routed via mcp_route_advised\n                        # with signal_source discriminator per audit_emit.py\n                        # 5099-5105 contract.\n                        _audit_emit.emit_generic(\n                            \"mcp_route_advised\",\n                            session_id=\"\",\n                            task_class=\"promotion\",\n                            suggested_servers=suggested[:64],\n                            kill_switch_overrides=\"\",\n                            signal_source=\"specialization_promoted\",\n                        )\n                    except Exception:  # pragma: no cover - fail-open\n                        pass\n                    return  # first-hit wins\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _emit_advisory_safe(\n    *,\n    archetype: str,\n    task_type: str,\n    model_recommended: str,\n    confidence: float,\n    applied_or_skipped: str,\n    override_reason: str,\n) -> None:\n    \"\"\"Wrapper around audit_emit.emit_generic for `model_routing_advised`.\n\n    Allowlist enforced by audit_emit dispatcher (defense-in-depth). Caller\n    only fills the 6 contract fields; ts/session/project added by emit_generic.\n\n    Codex W1+W2 fix-pack #2: ``confidence`` (float 0..1) is converted at\n    emission time to ``confidence_basis_points`` (int 0..1000) — floats\n    are forbidden in HMAC-covered fields (canonical_json invariant). The\n    in-process API surface still accepts ``confidence: float`` for\n    ergonomic continuity; conversion is colocated with the emit call.\n    \"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        # Convert float confidence -> int basis-points. NaN / out-of-range\n        # collapse to 0 (lower clamp in audit_emit emitter).\n        try:\n            conf_f = float(confidence)\n        except (TypeError, ValueError):\n            conf_f = 0.0\n        if conf_f != conf_f or conf_f in (float(\"inf\"), float(\"-inf\")):\n            conf_f = 0.0\n        if conf_f < 0.0:\n            conf_f = 0.0\n        if conf_f > 1.0:\n            conf_f = 1.0\n        confidence_bp = int(round(conf_f * 1000.0))\n        # Length-bound caller strings (defense-in-depth on adopter drift).\n        _audit_emit.emit_generic(\n            \"model_routing_advised\",\n            archetype=(archetype or \"\")[:64],\n            task_type=(task_type or \"\")[:32],\n            model_recommended=(model_recommended or \"\")[:64],\n            confidence_basis_points=confidence_bp,\n            applied_or_skipped=(applied_or_skipped or \"\")[:64],\n            override_reason=(override_reason or \"\")[:128],\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\n# Persona header patterns — must appear at the START of a line.\n_PERSONA_HEADER_RE = re.compile(\n    r\"^(?:PERSONA:|## AGENT PROFILE|## PERSONA)\",\n    flags=re.MULTILINE,\n)\n\n# Governance requirement: named spawns must include this literal section.\n_SKILL_CONTENT_MARKER = \"## SKILL CONTENT\"\n\n# PLAN-019 Phase 2B P1-SEC-B — minimum body size (non-whitespace bytes)\n# required between `## SKILL CONTENT` and the next `##` heading / EOF for\n# the marker to count as a real skill-content section. Rejects empty-body,\n# stub-only, or single-line \"see file X\" shells.\n_SKILL_CONTENT_MIN_BYTES = 256\n\n# Regex to find the marker ON ITS OWN LINE (ignoring trailing whitespace).\n_SKILL_CONTENT_MARKER_RE = re.compile(\n    r\"^## SKILL CONTENT[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n\n# Regex to find the next `##`-level heading (to bound the body extraction).\n_NEXT_H2_RE = re.compile(r\"^##[ \\t]\", flags=re.MULTILINE)\n\n# Code-fence markers (``` or ~~~ with optional language tag).\n_CODE_FENCE_RE = re.compile(r\"^(?:```|~~~)\", flags=re.MULTILINE)\n\n# HTML comment pair — non-greedy across lines.\n_HTML_COMMENT_RE = re.compile(r\"<!--.*?-->\", flags=re.DOTALL)\n\n# Regex to extract ## SPEC CONTEXT block content (between its header and next\n# ## heading or EOF). Used by _sanitize_spec_context_advisory() below.\n_SPEC_CONTEXT_HEADER_RE = re.compile(\n    r\"^##[ \\t]+SPEC[ \\t]+CONTEXT[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n\n\ndef _sanitize_spec_context_advisory(prompt: str, env=None) -> None:\n    \"\"\"PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n    payload and emit telemetry advisory.\n\n    Extracts the ## SPEC CONTEXT block from the spawn prompt, runs it\n    through spec_context_sanitizer.sanitize(), and emits a\n    `spec_context_sanitized` audit-emit event so sentinel violations,\n    truncation, and control-char counts are observable.\n\n    ADVISORY ONLY — never blocks the spawn. Fail-open on any exception.\n    Kill-switch: CEO_SPEC_CTX_SANITIZER_ENABLED=0.\n    \"\"\"\n    try:\n        if not _SPEC_CTX_SANITIZER_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n            return\n        src_env = env if env is not None else os.environ\n        val = (src_env.get(\"CEO_SPEC_CTX_SANITIZER_ENABLED\") or \"1\").strip()\n        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n            return\n        if not prompt:\n            return\n        # Extract ## SPEC CONTEXT block content\n        m = _SPEC_CONTEXT_HEADER_RE.search(prompt)\n        if m is None:\n            return  # no SPEC CONTEXT block — nothing to sanitize\n        block_start = m.end()\n        next_h2 = _NEXT_H2_RE.search(prompt, block_start)\n        block_end = next_h2.start() if next_h2 else len(prompt)\n        spec_payload = prompt[block_start:block_end]\n\n        result = _spec_ctx_sanitizer.sanitize(spec_payload)\n\n        # Emit telemetry (advisory only; sentinel violations logged for CEO)\n        try:\n            _audit_emit.emit_generic(\n                \"spec_context_sanitized\",\n                original_bytes=result.original_bytes,\n                cleaned_bytes=result.cleaned_bytes,\n                truncated=1 if result.truncated else 0,\n                sentinel_violations=len(result.sentinel_violations),\n                control_chars_stripped=result.control_chars_stripped,\n                bidi_zw_chars_stripped=result.bidi_zw_chars_stripped,\n                # PLAN-133 A2 — surface the Tag-block count too (allowlisted in\n                # audit_emit §7d). Harmless if the SanitizeResult lacks the field\n                # (getattr default 0) so this stays import-order tolerant.\n                tag_chars_stripped=getattr(result, \"tag_chars_stripped\", 0),\n                header_escape_count=result.header_escape_count,\n            )\n        except Exception:  # pragma: no cover - fail-open\n            pass\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _enforce_spec_context_unicode(prompt: str, env=None):\n    \"\"\"PLAN-133 A2 — fail-CLOSED invisible-unicode guard on the spawn prompt.\n\n    Scans the WHOLE spawn prompt (not just the ## SPEC CONTEXT block — an attacker\n    can smuggle Tag-block/bidi chars anywhere in the named-spawn body) for invisible\n    /smuggling unicode (control / bidi / zero-width / U+E0000-E007F Tag-block).\n\n    Default-OFF (doctrine #1): the BLOCK fires only when CEO_UNICODE_HARDBLOCK=='1'\n    in the import-time trusted_env snapshot. Otherwise advisory — the breadcrumb is\n    emitted with enforced=0 (measure-first) and None is returned (no block).\n\n    Returns a block-reason string when enforced AND a detection fires, else None.\n    Fail-OPEN on any infra exception (never blocks the session on a scanner bug).\n    Master kill: CEO_SOTA_DISABLE=1 forces advisory.\n    \"\"\"\n    try:\n        if not _SPEC_CTX_SANITIZER_AVAILABLE:\n            return None\n        src_env = env if env is not None else os.environ\n        if not prompt:\n            return None\n        # Default-OFF flag, read from the trusted_env snapshot when available so a\n        # late-set value can't toggle enforcement mid-process. Master kill wins.\n        if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n            enforce = False\n        else:\n            enforce = _unicode_hardblock_enforced(src_env)\n\n        result = _spec_ctx_sanitizer.sanitize(prompt)\n        count = _spec_ctx_sanitizer.invisible_unicode_count(result)\n        if count <= 0:\n            return None  # clean — nothing to do\n\n        unicode_class = _spec_ctx_sanitizer.classify_invisible_unicode(result)\n\n        # Emit the closed-enum breadcrumb on BOTH advisory and enforced paths\n        # (the denominator must be real from day one — no 0/0/0 trap).\n        if _AUDIT_EMIT_AVAILABLE:\n            try:\n                _audit_emit.emit_generic(\n                    \"invisible_unicode_blocked\",\n                    surface=\"spawn\",\n                    unicode_class=unicode_class,\n                    char_count=int(count),\n                    enforced=1 if enforce else 0,\n                )\n            except Exception:  # pragma: no cover - fail-open\n                pass\n\n        if not enforce:\n            return None  # advisory only\n\n        return (\n            \"GOVERNANCE: invisible_unicode_blocked: the spawn prompt contains \"\n            f\"{count} invisible/smuggling character(s) (class={unicode_class}: \"\n            \"control / bidi / zero-width / Unicode-Tags-block). These are \"\n            \"removed by the sanitizer and rejected fail-CLOSED before review. \"\n            \"Remove the hidden characters and re-spawn. To run advisory-only, \"\n            \"unset CEO_UNICODE_HARDBLOCK.\"\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return None\n\n\ndef _unicode_hardblock_enforced(src_env) -> bool:\n    \"\"\"True iff CEO_UNICODE_HARDBLOCK=='1' (PLAN-133 A2). Prefers the trusted_env\n    snapshot; falls back to the passed env dict. Pure; never raises.\"\"\"\n    try:\n        from _lib import trusted_env as _te  # noqa: E402\n        val = _te.get_trusted(\"CEO_UNICODE_HARDBLOCK\")\n        if val is not None:\n            return (val or \"\").strip() == \"1\"\n    except Exception:  # pragma: no cover\n        pass\n    return (src_env.get(\"CEO_UNICODE_HARDBLOCK\") or \"\").strip() == \"1\"\n\n\ndef _emit_spawn_confidence_advisory(\n    *,\n    action_type: str,\n    is_named_spawn: bool,\n    env=None,\n) -> None:\n    \"\"\"PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n\n    Classifies the spawn as an action and emits `spawn_confidence_advisory`\n    so recommender / receipt formatter surfaces have a hook-level confidence\n    signal for governance dashboards.\n\n    ADVISORY ONLY — never blocks. Fail-open on any exception.\n    Kill-switch: CEO_SPAWN_CONFIDENCE_ENABLED=0.\n    \"\"\"\n    try:\n        if not _CONFIDENCE_LABELS_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n            return\n        src_env = env if env is not None else os.environ\n        val = (src_env.get(\"CEO_SPAWN_CONFIDENCE_ENABLED\") or \"1\").strip()\n        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n            return\n\n        ctx = {\"canonical\": False}\n        conf = _confidence_labels.classify(action_type, ctx)\n        marker = _confidence_labels.as_emoji_free_marker(conf)\n\n        try:\n            _audit_emit.emit_generic(\n                \"spawn_confidence_advisory\",\n                action_type=(action_type or \"\")[:32],\n                confidence_level=(conf.level or \"\")[:32],\n                confidence_marker=(marker or \"\")[:32],\n                reason_code=(conf.reason_code or \"\")[:64],\n                is_named_spawn=1 if is_named_spawn else 0,\n            )\n        except Exception:  # pragma: no cover - fail-open\n            pass\n    except Exception:  # pragma: no cover - fail-open\n        return\n","numLines":546,"startLine":1,"totalLines":546}},"tool_result_meta":[{"id":"toolu_01JkoBeoFQH3TqUbMgbRceKG","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
