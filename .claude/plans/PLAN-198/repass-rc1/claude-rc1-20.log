{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012EGJQL3dqCkwekruUoR5Vr","type":"tool_result","content":"60\tif the hook cannot determine whether the path is a kernel file, it\n61\ttreats it as potentially-kernel and blocks with a synthetic reason.\n62\tThe only exception is a catastrophic Python exception (e.g. ImportError\n63\ton the adapter itself) — that still emits allow, because the sandbox\n64\tcannot function at all if the adapter is broken (you cannot recover\n65\tfrom a broken hook runtime via a blocking hook that depends on it).\n66\t\n67\tTests verify the fail-closed posture (block on missing file_path when\n68\tthe tool is Edit|Write|MultiEdit).\n69\t\"\"\"\n70\t\n71\tfrom __future__ import annotations\n72\t\n73\timport fnmatch\n74\timport hashlib\n75\timport json\n76\timport os\n77\timport re\n78\timport sys\n79\tfrom pathlib import Path\n80\tfrom typing import List, Optional\n81\t\n82\t_HOOKS_DIR = Path(__file__).resolve().parent\n83\tif str(_HOOKS_DIR) not in sys.path:\n84\t    sys.path.insert(0, str(_HOOKS_DIR))\n85\t\n86\t\n87\t# Arbitration kernel — full governance-enforcement surface.\n88\t# Each pattern uses the same segment-glob rules as _CANONICAL_GUARDS in\n89\t# check_canonical_edit.py: `*` matches a single segment, `**` matches\n90\t# zero or more segments. See _fnmatch_segments below.\n91\t_KERNEL_PATHS: List[str] = [\n92\t    # The four governance hooks (edit-gating surface).\n93\t    \".claude/hooks/check_agent_spawn.py\",\n94\t    \".claude/hooks/check_canonical_edit.py\",\n95\t    \".claude/hooks/check_plan_edit.py\",\n96\t    \".claude/hooks/check_arbitration_kernel.py\",\n97\t    # Skill-patch sentinel — same tier of power as the canonical guard.\n98\t    \".claude/hooks/check_skill_patch_sentinel.py\",\n99\t    # Hook library primitives that back the above hooks.\n100\t    \".claude/hooks/_lib/contract.py\",\n101\t    \".claude/hooks/_lib/policy.py\",\n102\t    \".claude/hooks/_lib/policy_preprocessors.py\",\n103\t    \".claude/hooks/_lib/redact.py\",\n104\t    \".claude/hooks/_lib/pii_patterns.py\",\n105\t    \".claude/hooks/_lib/audit_emit.py\",\n106\t    \".claude/hooks/_lib/adapters/claude.py\",\n107\t    # The policy-as-code declarative surface — drives policy_dispatch.py.\n108\t    \".claude/policies/*.yaml\",\n109\t    \".claude/policies/*.yml\",\n110\t    \".claude/policies/fixtures/*.jsonl\",\n111\t    # The policy_dispatch dispatcher itself.\n112\t    \".claude/hooks/policy_dispatch.py\",\n113\t    # PLAN-045 Wave 1 P0-03 — native-subagent frontmatter under kernel.\n114\t    # ``.claude/agents/*.md`` carries the ``model:`` field read by\n115\t    # Claude Code's native subagent dispatcher. F-01-03 documented the\n116\t    # demotion-via-frontmatter attack: an agent that edits\n117\t    # ``security-engineer.md`` can silently route the VETO role to\n118\t    # Haiku. Adding this glob to the kernel HARD-DENY list means\n119\t    # frontmatter mutations require ``CEO_KERNEL_OVERRIDE + ACK``\n120\t    # (which a sub-agent cannot forge).\n121\t    \".claude/agents/*.md\",\n122\t    # PLAN-085 Wave E.2 — ADR-116 13-entry kernel-extension (S111).\n123\t    # Closes F-C2-008 single-edit catastrophic chain. Each entry maps to\n124\t    # >=1 of the 4 attack vectors per ADR-116 §2. PLAN-089 will revisit\n125\t    # the 22 deferred R-026 paths via a separate ADR.\n126\t    #\n127\t    # Attack-vector coverage per entry:\n128\t    # (1) settings.json     -> hook configuration disable (vector 1 + 2)\n129\t    # (2) _python-hook.sh   -> hook runtime swap (vector 1)\n130\t    # (3) gpg_verify.py     -> sentinel signature bypass (vector 2)\n131\t    # (4) audit_hmac.py     -> chain-integrity bypass (vector 3)\n132\t    # (5) secret_patterns   -> secret-scan bypass (vector 1)\n133\t    # (6) injection_patterns-> injection-scan bypass (vector 1)\n134\t    # (7) output_scan       -> egress-scan bypass (vector 4)\n135\t    # (8) codex_egress_redact-> Codex egress redactor (vector 4)\n136\t    # (9) dispatcher/**     -> Pair-Rail VETO matrix (vector 4)\n137\t    # (10-11) release.yml + validate.yml -> CI gate bypass (vector 2)\n138\t    # (12) sentinel-signers.txt -> allowlist injection (vector 2)\n139\t    # (13) trusted_env.py   -> ADR-040-AMEND-2 Layer 1 trust-root (vector 1)\n140\t    \".claude/settings.json\",\n141\t    \".claude/hooks/_python-hook.sh\",\n142\t    \".claude/hooks/_lib/gpg_verify.py\",\n143\t    \".claude/hooks/_lib/audit_hmac.py\",\n144\t    \".claude/hooks/_lib/secret_patterns.py\",\n145\t    \".claude/hooks/_lib/injection_patterns.py\",\n146\t    \".claude/hooks/_lib/output_scan.py\",\n147\t    \".claude/hooks/_lib/codex_egress_redact.py\",\n148\t    \".claude/dispatcher/**/*\",\n149\t    \".github/workflows/release.yml\",\n150\t    \".github/workflows/validate.yml\",\n151\t    \".claude/sentinel-signers.txt\",\n152\t    # M8 — sentinel_signers.py is the ADR-121 YAML signer-registry\n153\t    # loader consumed by check_canonical_edit.py's dual-rail signer check\n154\t    # (is_valid_signer / load_registry). It is identity-trust + KERNEL-HARD-DENY-\n155\t    # enforcer tier (same as sentinel-signers.txt and gpg_verify.py): an agent\n156\t    # that can edit it can forge the signer-validity decision and grant itself\n157\t    # canonical-edit authority. The canonical-edit sentinel guard already covers\n158\t    # it via `.claude/hooks/_lib/*.py`, but that rail is sentinel-UNLOCKABLE;\n159\t    # the kernel rail (no sentinel escape) must guard it too. Fail-CLOSED-only\n160\t    # gap closure.\n161\t    \".claude/hooks/_lib/sentinel_signers.py\",\n162\t    \".claude/hooks/_lib/trusted_env.py\",\n163\t    # PLAN-089 Wave A.4 — ADR-116-AMEND-1 kernel-extension-v2 START\n164\t    # ADR-116-AMEND-1 (PLAN-089) — extends ADR-116 §4 enumeration; each\n165\t    # entry scored against ADR-116 §4 criteria (>=2 of: tier-0-governance,\n166\t    # audit-integrity, identity-trust, kernel-overrider-self-reference,\n167\t    # KERNEL HARD-DENY enforcer). Rationale: PLAN-089/kernel-extension-\n168\t    # v2-enumeration.md. Honest deferrals (15%) documented in the same file.\n169\t    \".claude/hooks/_lib/mcp/canonical_guard.py\",\n170\t    \".claude/hooks/_lib/mcp/bearer_replay.py\",\n171\t    \".claude/hooks/_lib/credentials.py\",\n172\t    \".claude/hooks/_lib/canonical_json.py\",\n173\t    \".claude/hooks/_lib/audit_rotation.py\",\n174\t    \".claude/hooks/_lib/replay_redact.py\",\n175\t    \".claude/hooks/_lib/injection_salt.py\",\n176\t    \".claude/hooks/_lib/mcp_injection_scan.py\",\n177\t    \".claude/hooks/_lib/spec_context_sanitizer.py\",\n178\t    \".claude/hooks/_lib/state_store.py\",\n179\t    \".claude/hooks/_lib/filelock.py\",\n180\t    \".claude/hooks/_lib/adapters/codex.py\",\n181\t    # PLAN-156 Wave 2 (SENT-GK-A): the grok host adapter is enrolled in\n182\t    # the SAME kernel-guarded wave that registers it. _KERNEL_PATHS\n183\t    # enumerates adapter modules INDIVIDUALLY (not by glob), so without\n184\t    # this row a later edit to the new enforcement adapter would be only\n185\t    # sentinel-gated — an asymmetry vs claude.py/codex.py that a future\n186\t    # edit could exploit (pair-rail R4/R5). grok.py owns the block→deny\n187\t    # egress normalization that IS enforcement on that host.\n188\t    \".claude/hooks/_lib/adapters/grok.py\",\n189\t    \".claude/hooks/_lib/adapters/_constants.py\",\n190\t    \".claude/hooks/_lib/__init__.py\",\n191\t    \".claude/hooks/_lib/adapters/__init__.py\",\n192\t    \".claude/hooks/_lib/mcp/__init__.py\",\n193\t    \".claude/hooks/_lib/tier_policy/loader.py\",\n194\t    \".claude/hooks/_lib/tier_policy/__init__.py\",\n195\t    \".claude/hooks/_lib/tier_policy/_constants.py\",\n196\t    \".claude/hooks/_lib/tier_policy/_agent_frontmatter.py\",\n197\t    \".claude/hooks/_lib/tier_policy/_types.py\",\n198\t    \".claude/hooks/_lib/agent_frontmatter.py\",\n199\t    \".claude/hooks/_lib/model_routing.py\",\n200\t    \".claude/hooks/_lib/mcp_routing.py\",\n201\t    \".claude/hooks/_lib/pair_rail_decide.py\",\n202\t    \".claude/hooks/_lib/escalation_signals.py\",\n203\t    \".claude/hooks/check_pair_rail.py\",\n204\t    \".claude/hooks/check_bash_safety.py\",\n205\t    \".claude/hooks/check_bash_canonical_forensic.py\",\n206\t    \".claude/hooks/check_codex_filewrite.py\",\n207\t    \".claude/hooks/check_codex_response.py\",\n208\t    \".claude/hooks/check_skill_bootstrap_post.py\",\n209\t    \".claude/hooks/check_skill_reference_read.py\",\n210\t    \".claude/hooks/check_read_injection.py\",\n211\t    \".claude/hooks/check_webfetch_injection.py\",\n212\t    \".claude/hooks/check_output_secrets.py\",\n213\t    \".claude/hooks/check_output_safety.py\",\n214\t    \".claude/hooks/check_mcp_response.py\",\n215\t    \".claude/hooks/check_tier_policy.py\",\n216\t    \".claude/hooks/check_tier_policy_misrouting_24h.py\",\n217\t    \".claude/hooks/check_subagent_fabrication.py\",\n218\t    \".claude/hooks/check_confidence_gate.py\",\n219\t    \".claude/hooks/check_anti_ceo_overhead.py\",\n220\t    \".claude/hooks/check_scratchpad_access.py\",\n221\t    \".claude/hooks/check_budget.py\",\n222\t    \".claude/hooks/check_fluency_nudge.py\",\n223\t    \".claude/hooks/audit_log.py\",\n224\t    \".claude/hooks/SessionStart.py\",\n225\t    \".claude/hooks/SessionEnd.py\",\n226\t    \".claude/hooks/Stop.py\",\n227\t    \".claude/hooks/UserPromptSubmit.py\",\n228\t    \".claude/hooks/emit_architect_outcome.py\",\n229\t    \".claude/tier-policy.json\",\n230\t    \".claude/tier-policy.json.sigchain\",\n231\t    \".claude/governance/governance-waivers.yaml\",\n232\t    \".claude/governance/codex-cli-pin.txt\",\n233\t    \".claude/governance/codex-cli-binary-sha256.txt\",\n234\t    # PLAN-163 T5.2 (ADR-182): the payload-pin manifest replaces the\n235\t    # launcher-hash pin above (now a comment-only tombstone, kept\n236\t    # guarded). The manifest is the runtime verify-then-invoke trust\n237\t    # root for check_pair_rail.py AND the release.yml step-15 payload\n238\t    # gate — enrolled in the SAME wave that creates it, so the new pin\n239\t    # meets an already-guarded path, not a surprise (PLAN-156 SENT-GK-0\n240\t    # precedent).\n241\t    \".claude/governance/codex-cli-pin-manifest.json\",\n242\t    # PLAN-156 W0b (SENT-GK-0): the grok pin pair, enrolled in the same\n243\t    # guarded step that creates it (debate C12) so the Wave-4 registry\n244\t    # edit meets an already-guarded pin, not a surprise. The binary-SHA\n245\t    # file is the real supply-chain gate for a proprietary rolling 0.x.\n246\t    \".claude/governance/grok-cli-pin.txt\",\n247\t    \".claude/governance/grok-cli-binary-sha256.txt\",\n248\t    \".claude/governance/pair-rail-inputs-hash-manifest.txt\",\n249\t    \".claude/governance/pair-rail-verdict-template.md\",\n250\t    \".claude/governance/function-length-grandfather.yaml\",\n251\t    \".claude/governance/audit_tokens_allowlist.json\",\n252\t    \".github/CODEOWNERS\",\n253\t    \".github/workflows/mutation-gate.yml\",\n254\t    \".github/workflows/coverage.yml\",\n255\t    \".github/workflows/actionlint.yml\",\n256\t    # PLAN-089 Wave A.4 — ADR-116-AMEND-1 kernel-extension-v2 END\n257\t    # PLAN-099 Wave E.1 — ADR-129 / ADR-135 federation paths (6 entries).\n258\t    # Federation enable + LAN sentinel pairs + peer registry must be\n259\t    # kernel-guarded so a sub-agent cannot forge an enable / bypass\n260\t    # the LAN gate by overwriting peers.yaml. The trailing glob covers\n261\t    # the dir-root semantic (plan §3 Wave E.1 entry #1) — any future\n262\t    # file added under .claude/data/federation/ inherits kernel-guard.\n263\t    \".claude/data/federation/peers.yaml\",\n264\t    \".claude/data/federation/enabled.md\",\n265\t    \".claude/data/federation/enabled.md.asc\",\n266\t    \".claude/data/federation/lan-enabled.md\",\n267\t    \".claude/data/federation/lan-enabled.md.asc\",\n268\t    \".claude/data/federation/**/*\",\n269\t    # PLAN-165 p1-corrected (NM-01/CX-1): machine-local posture STATE.\n270\t    # The overlay decides the NEXT session's permission mode and the\n271\t    # marker's prev_value is restored into it by night-mode off —\n272\t    # posture-write by proxy. No ceremony ever tool-edits these\n273\t    # (night-mode.py writes them as a process), so they sit at kernel\n274\t    # tier: no sentinel can grant a tool write. The WRITER script is\n275\t    # deliberately canonical-tier only (future ceremonies must be able\n276\t    # to evolve it under sentinel).\n277\t    \".claude/settings.local.json\",\n278\t    \".claude/state/night-mode.json\",\n279\t    # PLAN162_FIX_3 (PLAN-162 findings #3 + #8, consensus C10) — the two\n280\t    # files the guards themselves TRUST, previously guarded by NEITHER\n281\t    # rail (verified on HEAD: canonical=False, kernel=False for both):\n282\t    #\n283\t    #   1. the ADR-121 sentinel signer REGISTRY — the identity root\n284\t    #      `check_canonical_edit._sentinel_grants_path` consults on the\n285\t    #      dual signer rail. Unguarded, an ordinary Edit silently disarms\n286\t    #      half the signer check, asymmetric with the legacy\n287\t    #      `.claude/sentinel-signers.txt` which HAS been kernel-guarded\n288\t    #      since ADR-116.\n289\t    #   2. the policy hash-pin drift MANIFEST — it pins the policy files\n290\t    #      that are themselves guarded; leaving the pinner rewritable\n291\t    #      makes the pin decorative (\"pin the pinner\").\n292\t    #\n293\t    # Both are KERNEL tier (no sentinel escape) precisely because a\n294\t    # sentinel that grants an edit to the signer registry could authorize\n295\t    # its own future signer. Deliberately NOT paired with an\n296\t    # \"absence ⇒ fail-closed\" inversion (C10): that would need a\n297\t    # definition of \"expected\" which is itself editable, and would make\n298\t    # DELETING a file the way to choose the posture.\n299\t    \".claude/security/sentinel-signers-registry.yaml\",\n300\t    \".claude/policies/.drift-manifest.json\",\n301\t    # KERNEL-DECOMPOSITION (v1.4.4 train, merge 888e9e6c). These rows\n302\t    # cover the code the v1.4.4 split moved out of seven kernel facades,\n303\t    # the plan-path predicate the train put in place of regexes in two\n304\t    # kernel files, and the modules listed below that kernel code calls.\n305\t    #   - Seven facades moved their code into helper packages. One recursive\n306\t    #     row per package makes that code HARD-DENY again, as it was inside\n307\t    #     the facades in v1.4.2, and a file added there later is HARD-DENY\n308\t    #     too (the federation-dir precedent above).\n309\t    \".claude/hooks/_lib/canonical_edit/**/*\",  # check_canonical_edit.py\n310\t    \".claude/hooks/_lib/agent_spawn/**/*\",  # check_agent_spawn.py\n311\t    \".claude/hooks/_lib/_policy_parts/**/*\",  # _lib/policy.py\n312\t    \".claude/hooks/_lib/_audit_emit_parts/**/*\",  # _lib/audit_emit.py\n313\t    \".claude/hooks/_lib/_audit_log_parts/**/*\",  # audit_log.py\n314\t    \".claude/hooks/_lib/_bash_safety_parts/**/*\",  # check_bash_safety.py\n315\t    \".claude/hooks/_lib/_pair_rail_parts/**/*\",  # check_pair_rail.py\n316\t    #   - Five flat modules that kernel code calls:\n317\t    #     plan_paths.py — the plan-path predicate (is_plan_path,\n318\t    #       plan_id_from_path) that replaces the plan-path regexes the train\n319\t    #       removed from check_plan_edit.py and policy_preprocessors.py; it\n320\t    #       is HARD-DENY again, as those regexes were in v1.4.2;\n321\t    #     model_currency.py — is_veto_floor_model(), the VETO-floor predicate\n322\t    #       that kernel files now call as part of their VETO-floor check\n323\t    #       (the F-01-03 demotion check above rides on it);\n324\t    #     cli_currency.py, bash_indirect_guard.py, bash_indirect_telemetry.py\n325\t    #       — each added by this train and called by kernel code:\n326\t    #       cli_currency.py is the Codex payload-pin currency arm, which\n327\t    #       decides whether a payload SHA mismatch is accepted as\n328\t    #       \"compatible\" (called by the pair-rail code; ADR-182 trust root);\n329\t    #       bash_indirect_guard.py is the indirect-command BLOCK matcher and\n330\t    #       bash_indirect_telemetry.py the disabled-rail telemetry, both\n331\t    #       called by the bash-safety parts.\n332\t    \".claude/hooks/_lib/model_currency.py\",\n333\t    \".claude/hooks/_lib/cli_currency.py\",\n334\t    \".claude/hooks/_lib/plan_paths.py\",\n335\t    \".claude/hooks/_lib/bash_indirect_guard.py\",\n336\t    \".claude/hooks/_lib/bash_indirect_telemetry.py\",\n337\t    #   - adapters/live/ — the live-adapter transport package, present since\n338\t    #     v1.0.0 and enrolled now because the kernel adapters/__init__.py\n339\t    #     loads it; its siblings above are already kernel.\n340\t    \".claude/hooks/_lib/adapters/live/**/*\",\n341\t    # tests/test_kernel_decomposition_coverage.py checks that each package\n342\t    # below _lib/ that a kernel source reaches by an import statement or\n343\t    # by a / chain of string literals (resolved against the source's\n344\t    # directory or .claude/hooks) is kernel in full, and that each of the\n345\t    # five flat modules above is kernel and still imported by a kernel\n346\t    # source.\n347\t]\n348\t\n349\t\n350\tdef _emit_allow(system_message: Optional[str] = None) -> str:\n351\t    # Claude Code hook schema: top-level \"allow\" is NOT valid.\n352\t    # Emit empty {} or {\"systemMessage\": ...}.\n353\t    out: dict = {}\n354\t    if system_message:\n355\t        out[\"systemMessage\"] = system_message\n356\t    return json.dumps(out, ensure_ascii=False)\n357\t\n358\t\n359\tdef _emit_block(reason: str) -> str:\n360\t    return json.dumps(\n361\t        {\"decision\": \"block\", \"reason\": reason}, ensure_ascii=False\n362\t    )\n363\t\n364\t\n365\tdef _fnmatch_segments(path: str, pattern: str) -> bool:\n366\t    \"\"\"Segment-wise glob (copy of check_canonical_edit helper).\n367\t\n368\t    - `*` matches exactly one segment.\n369\t    - `**` matches zero or more segments.\n370\t    \"\"\"\n371\t    p_parts = path.split(\"/\")\n372\t    pat_parts = pattern.split(\"/\")\n373\t    return _match_segments(p_parts, pat_parts)\n374\t\n375\t\n376\tdef _match_segments(p_parts: List[str], pat_parts: List[str]) -> bool:\n377\t    if not pat_parts:\n378\t        return not p_parts\n379\t    head, rest = pat_parts[0], pat_parts[1:]\n380\t    if head == \"**\":\n381\t        for i in range(len(p_parts) + 1):\n382\t            if _match_segments(p_parts[i:], rest):\n383\t                return True\n384\t        return False\n385\t    if not p_parts:\n386\t        return False\n387\t    if head == \"*\" or fnmatch.fnmatchcase(p_parts[0], head):\n388\t        return _match_segments(p_parts[1:], rest)\n389\t    return False\n390\t\n391\t\n392\t# PLAN162_FIX_CASEFOLD (PLAN-162 consensus S1, P0 — BOTH rails).\n393\t#\n394\t# ``_match_segments`` matches with ``fnmatch.fnmatchcase``, i.e. exact\n395\t# case. On a case-INSENSITIVE filesystem — APFS, the default on this\n396\t# repo's platform — ``.claude/settings.JSON`` IS ``.claude/settings.json``:\n397\t# a write through the case variant OVERWRITES the guarded file, yet the\n398\t# variant classified non-kernel and sailed past the HARD-DENY the whole\n399\t# threat model assumes unreachable. Measured on HEAD:\n400\t#\n401\t#     .claude/settings.JSON             canonical=False  kernel=False\n402\t#     .claude/hooks/_lib/audit_emit.PY  canonical=False  kernel=False\n403\t#     .claude/sentinel-signers.TXT      canonical=False  kernel=False\n404\t#\n405\t# The fix normalizes BOTH the candidate rel and the guard patterns to\n406\t# lower case before matching. Over-classifying is the SAFE direction\n407\t# here (a false kernel-classification costs an override ceremony; a\n408\t# false non-classification is a silent bypass of the strictest rail).\n409\t#\n410\t# ``str.lower`` — not ``str.casefold`` — deliberately: casefold expands\n411\t# 'ß'→'ss', changing segment LENGTH and therefore what a glob matches.\n412\t# The exploited class is ASCII case variance, which ``lower()`` covers\n413\t# exactly, and identical inputs always fold identically, so the\n414\t# normalization can only ever ADD matches, never remove one.\n415\t#\n416\t# Precomputed at import so the hot path pays one ``str.lower()`` per\n417\t# classification rather than one per (segment x pattern).\n418\t_KERNEL_PATHS_FOLDED: List[str] = [pat.lower() for pat in _KERNEL_PATHS]\n419\t\n420\t\n421\tdef _is_kernel_path(path_str: str, repo_root: Path) -> bool:\n422\t    \"\"\"True if path_str resolves inside the kernel HARD-DENY list.\"\"\"\n423\t    if not path_str:\n424\t        return False\n425\t    p = Path(path_str)\n426\t    try:\n427\t        rel = str(p.resolve().relative_to(repo_root.resolve())).replace(\n428\t            os.sep, \"/\"\n429\t        )\n430\t    except (ValueError, OSError):\n431\t        # Path outside repo root → cannot be a kernel path by definition.\n432\t        return False\n433\t    # PLAN162_FIX_CASEFOLD — see the module note above.\n434\t    rel_folded = rel.lower()\n435\t    for pattern in _KERNEL_PATHS_FOLDED:\n436\t        if _fnmatch_segments(rel_folded, pattern):\n437\t            return True\n438\t    return False\n439\t\n440\t\n441\t_ACK_TOKEN = \"I-ACCEPT\"\n442\t_REASON_RE = re.compile(r\"^[A-Za-z0-9._\\-]{1,120}$\")\n443\t\n444\t\n445\tdef _override_granted(env: dict) -> bool:\n446\t    \"\"\"True only when BOTH env vars are set correctly.\n447\t\n448\t    `CEO_KERNEL_OVERRIDE` must be a non-empty reason slug matching\n449\t    `[A-Za-z0-9._-]{1,120}`. `CEO_KERNEL_OVERRIDE_ACK` must equal the\n450\t    literal ACK token `I-ACCEPT`. Both must be present — the ACK alone\n451\t    (or a reason alone) does not grant override. This prevents\n452\t    accidental pastes from elsewhere from enabling the bypass.\n453\t    \"\"\"\n454\t    reason = (env.get(\"CEO_KERNEL_OVERRIDE\") or \"\").strip()\n455\t    ack = (env.get(\"CEO_KERNEL_OVERRIDE_ACK\") or \"\").strip()\n456\t    if not reason or not ack:\n457\t        return False\n458\t    if ack != _ACK_TOKEN:\n459\t        return False\n460\t    if not _REASON_RE.match(reason):\n461\t        return False\n462\t    return True\n463\t\n464\t\n465\t# --- PLAN-169 W3-K (ledger E.2) — honest grant-path audit ----------------\n466\t#\n467\t# The pre-W3-K callsite passed the free-text override REASON as ``plan_id``\n468\t# and a repo-relative PATH (silently truncated at 64 chars) as\n469\t# ``ceremony_sha`` — a field SPEC/v1/audit-log.schema.md:415 names a\n470\t# ceremony sha. Neither value was ever rejected: ``kernel_extension_landed``\n471\t# rides ``_EMIT_GENERIC_PASSTHROUGH`` (audit_emit.py:1751), so the kwargs\n472\t# survive the deny-by-default scrub verbatim. The event LANDED — with a\n473\t# path in a digest field and a reason slug in a plan field.\n474\t\n475\t_EDIT_TOOLS = frozenset({\"Edit\", \"Write\", \"MultiEdit\"})\n476\t_PLAN_ID_RE = re.compile(r\"^PLAN-[0-9]{3,}$\")\n477\t_PLAN_ID_UNKNOWN = \"unknown\"\n478\t\n479\t"}]},"parent_tool_use_id":null,"session_id":"14f8936b-5675-4847-b1ea-653419bb8f68","uuid":"8212b9fc-be04-4c76-97d0-a3a76a44d1d8","timestamp":"2026-11-15T10:42:43.164Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/check_arbitration_kernel.py","content":"if the hook cannot determine whether the path is a kernel file, it\ntreats it as potentially-kernel and blocks with a synthetic reason.\nThe only exception is a catastrophic Python exception (e.g. ImportError\non the adapter itself) — that still emits allow, because the sandbox\ncannot function at all if the adapter is broken (you cannot recover\nfrom a broken hook runtime via a blocking hook that depends on it).\n\nTests verify the fail-closed posture (block on missing file_path when\nthe tool is Edit|Write|MultiEdit).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import List, Optional\n\n_HOOKS_DIR = Path(__file__).resolve().parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\n\n# Arbitration kernel — full governance-enforcement surface.\n# Each pattern uses the same segment-glob rules as _CANONICAL_GUARDS in\n# check_canonical_edit.py: `*` matches a single segment, `**` matches\n# zero or more segments. See _fnmatch_segments below.\n_KERNEL_PATHS: List[str] = [\n    # The four governance hooks (edit-gating surface).\n    \".claude/hooks/check_agent_spawn.py\",\n    \".claude/hooks/check_canonical_edit.py\",\n    \".claude/hooks/check_plan_edit.py\",\n    \".claude/hooks/check_arbitration_kernel.py\",\n    # Skill-patch sentinel — same tier of power as the canonical guard.\n    \".claude/hooks/check_skill_patch_sentinel.py\",\n    # Hook library primitives that back the above hooks.\n    \".claude/hooks/_lib/contract.py\",\n    \".claude/hooks/_lib/policy.py\",\n    \".claude/hooks/_lib/policy_preprocessors.py\",\n    \".claude/hooks/_lib/redact.py\",\n    \".claude/hooks/_lib/pii_patterns.py\",\n    \".claude/hooks/_lib/audit_emit.py\",\n    \".claude/hooks/_lib/adapters/claude.py\",\n    # The policy-as-code declarative surface — drives policy_dispatch.py.\n    \".claude/policies/*.yaml\",\n    \".claude/policies/*.yml\",\n    \".claude/policies/fixtures/*.jsonl\",\n    # The policy_dispatch dispatcher itself.\n    \".claude/hooks/policy_dispatch.py\",\n    # PLAN-045 Wave 1 P0-03 — native-subagent frontmatter under kernel.\n    # ``.claude/agents/*.md`` carries the ``model:`` field read by\n    # Claude Code's native subagent dispatcher. F-01-03 documented the\n    # demotion-via-frontmatter attack: an agent that edits\n    # ``security-engineer.md`` can silently route the VETO role to\n    # Haiku. Adding this glob to the kernel HARD-DENY list means\n    # frontmatter mutations require ``CEO_KERNEL_OVERRIDE + ACK``\n    # (which a sub-agent cannot forge).\n    \".claude/agents/*.md\",\n    # PLAN-085 Wave E.2 — ADR-116 13-entry kernel-extension (S111).\n    # Closes F-C2-008 single-edit catastrophic chain. Each entry maps to\n    # >=1 of the 4 attack vectors per ADR-116 §2. PLAN-089 will revisit\n    # the 22 deferred R-026 paths via a separate ADR.\n    #\n    # Attack-vector coverage per entry:\n    # (1) settings.json     -> hook configuration disable (vector 1 + 2)\n    # (2) _python-hook.sh   -> hook runtime swap (vector 1)\n    # (3) gpg_verify.py     -> sentinel signature bypass (vector 2)\n    # (4) audit_hmac.py     -> chain-integrity bypass (vector 3)\n    # (5) secret_patterns   -> secret-scan bypass (vector 1)\n    # (6) injection_patterns-> injection-scan bypass (vector 1)\n    # (7) output_scan       -> egress-scan bypass (vector 4)\n    # (8) codex_egress_redact-> Codex egress redactor (vector 4)\n    # (9) dispatcher/**     -> Pair-Rail VETO matrix (vector 4)\n    # (10-11) release.yml + validate.yml -> CI gate bypass (vector 2)\n    # (12) sentinel-signers.txt -> allowlist injection (vector 2)\n    # (13) trusted_env.py   -> ADR-040-AMEND-2 Layer 1 trust-root (vector 1)\n    \".claude/settings.json\",\n    \".claude/hooks/_python-hook.sh\",\n    \".claude/hooks/_lib/gpg_verify.py\",\n    \".claude/hooks/_lib/audit_hmac.py\",\n    \".claude/hooks/_lib/secret_patterns.py\",\n    \".claude/hooks/_lib/injection_patterns.py\",\n    \".claude/hooks/_lib/output_scan.py\",\n    \".claude/hooks/_lib/codex_egress_redact.py\",\n    \".claude/dispatcher/**/*\",\n    \".github/workflows/release.yml\",\n    \".github/workflows/validate.yml\",\n    \".claude/sentinel-signers.txt\",\n    # M8 — sentinel_signers.py is the ADR-121 YAML signer-registry\n    # loader consumed by check_canonical_edit.py's dual-rail signer check\n    # (is_valid_signer / load_registry). It is identity-trust + KERNEL-HARD-DENY-\n    # enforcer tier (same as sentinel-signers.txt and gpg_verify.py): an agent\n    # that can edit it can forge the signer-validity decision and grant itself\n    # canonical-edit authority. The canonical-edit sentinel guard already covers\n    # it via `.claude/hooks/_lib/*.py`, but that rail is sentinel-UNLOCKABLE;\n    # the kernel rail (no sentinel escape) must guard it too. Fail-CLOSED-only\n    # gap closure.\n    \".claude/hooks/_lib/sentinel_signers.py\",\n    \".claude/hooks/_lib/trusted_env.py\",\n    # PLAN-089 Wave A.4 — ADR-116-AMEND-1 kernel-extension-v2 START\n    # ADR-116-AMEND-1 (PLAN-089) — extends ADR-116 §4 enumeration; each\n    # entry scored against ADR-116 §4 criteria (>=2 of: tier-0-governance,\n    # audit-integrity, identity-trust, kernel-overrider-self-reference,\n    # KERNEL HARD-DENY enforcer). Rationale: PLAN-089/kernel-extension-\n    # v2-enumeration.md. Honest deferrals (15%) documented in the same file.\n    \".claude/hooks/_lib/mcp/canonical_guard.py\",\n    \".claude/hooks/_lib/mcp/bearer_replay.py\",\n    \".claude/hooks/_lib/credentials.py\",\n    \".claude/hooks/_lib/canonical_json.py\",\n    \".claude/hooks/_lib/audit_rotation.py\",\n    \".claude/hooks/_lib/replay_redact.py\",\n    \".claude/hooks/_lib/injection_salt.py\",\n    \".claude/hooks/_lib/mcp_injection_scan.py\",\n    \".claude/hooks/_lib/spec_context_sanitizer.py\",\n    \".claude/hooks/_lib/state_store.py\",\n    \".claude/hooks/_lib/filelock.py\",\n    \".claude/hooks/_lib/adapters/codex.py\",\n    # PLAN-156 Wave 2 (SENT-GK-A): the grok host adapter is enrolled in\n    # the SAME kernel-guarded wave that registers it. _KERNEL_PATHS\n    # enumerates adapter modules INDIVIDUALLY (not by glob), so without\n    # this row a later edit to the new enforcement adapter would be only\n    # sentinel-gated — an asymmetry vs claude.py/codex.py that a future\n    # edit could exploit (pair-rail R4/R5). grok.py owns the block→deny\n    # egress normalization that IS enforcement on that host.\n    \".claude/hooks/_lib/adapters/grok.py\",\n    \".claude/hooks/_lib/adapters/_constants.py\",\n    \".claude/hooks/_lib/__init__.py\",\n    \".claude/hooks/_lib/adapters/__init__.py\",\n    \".claude/hooks/_lib/mcp/__init__.py\",\n    \".claude/hooks/_lib/tier_policy/loader.py\",\n    \".claude/hooks/_lib/tier_policy/__init__.py\",\n    \".claude/hooks/_lib/tier_policy/_constants.py\",\n    \".claude/hooks/_lib/tier_policy/_agent_frontmatter.py\",\n    \".claude/hooks/_lib/tier_policy/_types.py\",\n    \".claude/hooks/_lib/agent_frontmatter.py\",\n    \".claude/hooks/_lib/model_routing.py\",\n    \".claude/hooks/_lib/mcp_routing.py\",\n    \".claude/hooks/_lib/pair_rail_decide.py\",\n    \".claude/hooks/_lib/escalation_signals.py\",\n    \".claude/hooks/check_pair_rail.py\",\n    \".claude/hooks/check_bash_safety.py\",\n    \".claude/hooks/check_bash_canonical_forensic.py\",\n    \".claude/hooks/check_codex_filewrite.py\",\n    \".claude/hooks/check_codex_response.py\",\n    \".claude/hooks/check_skill_bootstrap_post.py\",\n    \".claude/hooks/check_skill_reference_read.py\",\n    \".claude/hooks/check_read_injection.py\",\n    \".claude/hooks/check_webfetch_injection.py\",\n    \".claude/hooks/check_output_secrets.py\",\n    \".claude/hooks/check_output_safety.py\",\n    \".claude/hooks/check_mcp_response.py\",\n    \".claude/hooks/check_tier_policy.py\",\n    \".claude/hooks/check_tier_policy_misrouting_24h.py\",\n    \".claude/hooks/check_subagent_fabrication.py\",\n    \".claude/hooks/check_confidence_gate.py\",\n    \".claude/hooks/check_anti_ceo_overhead.py\",\n    \".claude/hooks/check_scratchpad_access.py\",\n    \".claude/hooks/check_budget.py\",\n    \".claude/hooks/check_fluency_nudge.py\",\n    \".claude/hooks/audit_log.py\",\n    \".claude/hooks/SessionStart.py\",\n    \".claude/hooks/SessionEnd.py\",\n    \".claude/hooks/Stop.py\",\n    \".claude/hooks/UserPromptSubmit.py\",\n    \".claude/hooks/emit_architect_outcome.py\",\n    \".claude/tier-policy.json\",\n    \".claude/tier-policy.json.sigchain\",\n    \".claude/governance/governance-waivers.yaml\",\n    \".claude/governance/codex-cli-pin.txt\",\n    \".claude/governance/codex-cli-binary-sha256.txt\",\n    # PLAN-163 T5.2 (ADR-182): the payload-pin manifest replaces the\n    # launcher-hash pin above (now a comment-only tombstone, kept\n    # guarded). The manifest is the runtime verify-then-invoke trust\n    # root for check_pair_rail.py AND the release.yml step-15 payload\n    # gate — enrolled in the SAME wave that creates it, so the new pin\n    # meets an already-guarded path, not a surprise (PLAN-156 SENT-GK-0\n    # precedent).\n    \".claude/governance/codex-cli-pin-manifest.json\",\n    # PLAN-156 W0b (SENT-GK-0): the grok pin pair, enrolled in the same\n    # guarded step that creates it (debate C12) so the Wave-4 registry\n    # edit meets an already-guarded pin, not a surprise. The binary-SHA\n    # file is the real supply-chain gate for a proprietary rolling 0.x.\n    \".claude/governance/grok-cli-pin.txt\",\n    \".claude/governance/grok-cli-binary-sha256.txt\",\n    \".claude/governance/pair-rail-inputs-hash-manifest.txt\",\n    \".claude/governance/pair-rail-verdict-template.md\",\n    \".claude/governance/function-length-grandfather.yaml\",\n    \".claude/governance/audit_tokens_allowlist.json\",\n    \".github/CODEOWNERS\",\n    \".github/workflows/mutation-gate.yml\",\n    \".github/workflows/coverage.yml\",\n    \".github/workflows/actionlint.yml\",\n    # PLAN-089 Wave A.4 — ADR-116-AMEND-1 kernel-extension-v2 END\n    # PLAN-099 Wave E.1 — ADR-129 / ADR-135 federation paths (6 entries).\n    # Federation enable + LAN sentinel pairs + peer registry must be\n    # kernel-guarded so a sub-agent cannot forge an enable / bypass\n    # the LAN gate by overwriting peers.yaml. The trailing glob covers\n    # the dir-root semantic (plan §3 Wave E.1 entry #1) — any future\n    # file added under .claude/data/federation/ inherits kernel-guard.\n    \".claude/data/federation/peers.yaml\",\n    \".claude/data/federation/enabled.md\",\n    \".claude/data/federation/enabled.md.asc\",\n    \".claude/data/federation/lan-enabled.md\",\n    \".claude/data/federation/lan-enabled.md.asc\",\n    \".claude/data/federation/**/*\",\n    # PLAN-165 p1-corrected (NM-01/CX-1): machine-local posture STATE.\n    # The overlay decides the NEXT session's permission mode and the\n    # marker's prev_value is restored into it by night-mode off —\n    # posture-write by proxy. No ceremony ever tool-edits these\n    # (night-mode.py writes them as a process), so they sit at kernel\n    # tier: no sentinel can grant a tool write. The WRITER script is\n    # deliberately canonical-tier only (future ceremonies must be able\n    # to evolve it under sentinel).\n    \".claude/settings.local.json\",\n    \".claude/state/night-mode.json\",\n    # PLAN162_FIX_3 (PLAN-162 findings #3 + #8, consensus C10) — the two\n    # files the guards themselves TRUST, previously guarded by NEITHER\n    # rail (verified on HEAD: canonical=False, kernel=False for both):\n    #\n    #   1. the ADR-121 sentinel signer REGISTRY — the identity root\n    #      `check_canonical_edit._sentinel_grants_path` consults on the\n    #      dual signer rail. Unguarded, an ordinary Edit silently disarms\n    #      half the signer check, asymmetric with the legacy\n    #      `.claude/sentinel-signers.txt` which HAS been kernel-guarded\n    #      since ADR-116.\n    #   2. the policy hash-pin drift MANIFEST — it pins the policy files\n    #      that are themselves guarded; leaving the pinner rewritable\n    #      makes the pin decorative (\"pin the pinner\").\n    #\n    # Both are KERNEL tier (no sentinel escape) precisely because a\n    # sentinel that grants an edit to the signer registry could authorize\n    # its own future signer. Deliberately NOT paired with an\n    # \"absence ⇒ fail-closed\" inversion (C10): that would need a\n    # definition of \"expected\" which is itself editable, and would make\n    # DELETING a file the way to choose the posture.\n    \".claude/security/sentinel-signers-registry.yaml\",\n    \".claude/policies/.drift-manifest.json\",\n    # KERNEL-DECOMPOSITION (v1.4.4 train, merge 888e9e6c). These rows\n    # cover the code the v1.4.4 split moved out of seven kernel facades,\n    # the plan-path predicate the train put in place of regexes in two\n    # kernel files, and the modules listed below that kernel code calls.\n    #   - Seven facades moved their code into helper packages. One recursive\n    #     row per package makes that code HARD-DENY again, as it was inside\n    #     the facades in v1.4.2, and a file added there later is HARD-DENY\n    #     too (the federation-dir precedent above).\n    \".claude/hooks/_lib/canonical_edit/**/*\",  # check_canonical_edit.py\n    \".claude/hooks/_lib/agent_spawn/**/*\",  # check_agent_spawn.py\n    \".claude/hooks/_lib/_policy_parts/**/*\",  # _lib/policy.py\n    \".claude/hooks/_lib/_audit_emit_parts/**/*\",  # _lib/audit_emit.py\n    \".claude/hooks/_lib/_audit_log_parts/**/*\",  # audit_log.py\n    \".claude/hooks/_lib/_bash_safety_parts/**/*\",  # check_bash_safety.py\n    \".claude/hooks/_lib/_pair_rail_parts/**/*\",  # check_pair_rail.py\n    #   - Five flat modules that kernel code calls:\n    #     plan_paths.py — the plan-path predicate (is_plan_path,\n    #       plan_id_from_path) that replaces the plan-path regexes the train\n    #       removed from check_plan_edit.py and policy_preprocessors.py; it\n    #       is HARD-DENY again, as those regexes were in v1.4.2;\n    #     model_currency.py — is_veto_floor_model(), the VETO-floor predicate\n    #       that kernel files now call as part of their VETO-floor check\n    #       (the F-01-03 demotion check above rides on it);\n    #     cli_currency.py, bash_indirect_guard.py, bash_indirect_telemetry.py\n    #       — each added by this train and called by kernel code:\n    #       cli_currency.py is the Codex payload-pin currency arm, which\n    #       decides whether a payload SHA mismatch is accepted as\n    #       \"compatible\" (called by the pair-rail code; ADR-182 trust root);\n    #       bash_indirect_guard.py is the indirect-command BLOCK matcher and\n    #       bash_indirect_telemetry.py the disabled-rail telemetry, both\n    #       called by the bash-safety parts.\n    \".claude/hooks/_lib/model_currency.py\",\n    \".claude/hooks/_lib/cli_currency.py\",\n    \".claude/hooks/_lib/plan_paths.py\",\n    \".claude/hooks/_lib/bash_indirect_guard.py\",\n    \".claude/hooks/_lib/bash_indirect_telemetry.py\",\n    #   - adapters/live/ — the live-adapter transport package, present since\n    #     v1.0.0 and enrolled now because the kernel adapters/__init__.py\n    #     loads it; its siblings above are already kernel.\n    \".claude/hooks/_lib/adapters/live/**/*\",\n    # tests/test_kernel_decomposition_coverage.py checks that each package\n    # below _lib/ that a kernel source reaches by an import statement or\n    # by a / chain of string literals (resolved against the source's\n    # directory or .claude/hooks) is kernel in full, and that each of the\n    # five flat modules above is kernel and still imported by a kernel\n    # source.\n]\n\n\ndef _emit_allow(system_message: Optional[str] = None) -> str:\n    # Claude Code hook schema: top-level \"allow\" is NOT valid.\n    # Emit empty {} or {\"systemMessage\": ...}.\n    out: dict = {}\n    if system_message:\n        out[\"systemMessage\"] = system_message\n    return json.dumps(out, ensure_ascii=False)\n\n\ndef _emit_block(reason: str) -> str:\n    return json.dumps(\n        {\"decision\": \"block\", \"reason\": reason}, ensure_ascii=False\n    )\n\n\ndef _fnmatch_segments(path: str, pattern: str) -> bool:\n    \"\"\"Segment-wise glob (copy of check_canonical_edit helper).\n\n    - `*` matches exactly one segment.\n    - `**` matches zero or more segments.\n    \"\"\"\n    p_parts = path.split(\"/\")\n    pat_parts = pattern.split(\"/\")\n    return _match_segments(p_parts, pat_parts)\n\n\ndef _match_segments(p_parts: List[str], pat_parts: List[str]) -> bool:\n    if not pat_parts:\n        return not p_parts\n    head, rest = pat_parts[0], pat_parts[1:]\n    if head == \"**\":\n        for i in range(len(p_parts) + 1):\n            if _match_segments(p_parts[i:], rest):\n                return True\n        return False\n    if not p_parts:\n        return False\n    if head == \"*\" or fnmatch.fnmatchcase(p_parts[0], head):\n        return _match_segments(p_parts[1:], rest)\n    return False\n\n\n# PLAN162_FIX_CASEFOLD (PLAN-162 consensus S1, P0 — BOTH rails).\n#\n# ``_match_segments`` matches with ``fnmatch.fnmatchcase``, i.e. exact\n# case. On a case-INSENSITIVE filesystem — APFS, the default on this\n# repo's platform — ``.claude/settings.JSON`` IS ``.claude/settings.json``:\n# a write through the case variant OVERWRITES the guarded file, yet the\n# variant classified non-kernel and sailed past the HARD-DENY the whole\n# threat model assumes unreachable. Measured on HEAD:\n#\n#     .claude/settings.JSON             canonical=False  kernel=False\n#     .claude/hooks/_lib/audit_emit.PY  canonical=False  kernel=False\n#     .claude/sentinel-signers.TXT      canonical=False  kernel=False\n#\n# The fix normalizes BOTH the candidate rel and the guard patterns to\n# lower case before matching. Over-classifying is the SAFE direction\n# here (a false kernel-classification costs an override ceremony; a\n# false non-classification is a silent bypass of the strictest rail).\n#\n# ``str.lower`` — not ``str.casefold`` — deliberately: casefold expands\n# 'ß'→'ss', changing segment LENGTH and therefore what a glob matches.\n# The exploited class is ASCII case variance, which ``lower()`` covers\n# exactly, and identical inputs always fold identically, so the\n# normalization can only ever ADD matches, never remove one.\n#\n# Precomputed at import so the hot path pays one ``str.lower()`` per\n# classification rather than one per (segment x pattern).\n_KERNEL_PATHS_FOLDED: List[str] = [pat.lower() for pat in _KERNEL_PATHS]\n\n\ndef _is_kernel_path(path_str: str, repo_root: Path) -> bool:\n    \"\"\"True if path_str resolves inside the kernel HARD-DENY list.\"\"\"\n    if not path_str:\n        return False\n    p = Path(path_str)\n    try:\n        rel = str(p.resolve().relative_to(repo_root.resolve())).replace(\n            os.sep, \"/\"\n        )\n    except (ValueError, OSError):\n        # Path outside repo root → cannot be a kernel path by definition.\n        return False\n    # PLAN162_FIX_CASEFOLD — see the module note above.\n    rel_folded = rel.lower()\n    for pattern in _KERNEL_PATHS_FOLDED:\n        if _fnmatch_segments(rel_folded, pattern):\n            return True\n    return False\n\n\n_ACK_TOKEN = \"I-ACCEPT\"\n_REASON_RE = re.compile(r\"^[A-Za-z0-9._\\-]{1,120}$\")\n\n\ndef _override_granted(env: dict) -> bool:\n    \"\"\"True only when BOTH env vars are set correctly.\n\n    `CEO_KERNEL_OVERRIDE` must be a non-empty reason slug matching\n    `[A-Za-z0-9._-]{1,120}`. `CEO_KERNEL_OVERRIDE_ACK` must equal the\n    literal ACK token `I-ACCEPT`. Both must be present — the ACK alone\n    (or a reason alone) does not grant override. This prevents\n    accidental pastes from elsewhere from enabling the bypass.\n    \"\"\"\n    reason = (env.get(\"CEO_KERNEL_OVERRIDE\") or \"\").strip()\n    ack = (env.get(\"CEO_KERNEL_OVERRIDE_ACK\") or \"\").strip()\n    if not reason or not ack:\n        return False\n    if ack != _ACK_TOKEN:\n        return False\n    if not _REASON_RE.match(reason):\n        return False\n    return True\n\n\n# --- PLAN-169 W3-K (ledger E.2) — honest grant-path audit ----------------\n#\n# The pre-W3-K callsite passed the free-text override REASON as ``plan_id``\n# and a repo-relative PATH (silently truncated at 64 chars) as\n# ``ceremony_sha`` — a field SPEC/v1/audit-log.schema.md:415 names a\n# ceremony sha. Neither value was ever rejected: ``kernel_extension_landed``\n# rides ``_EMIT_GENERIC_PASSTHROUGH`` (audit_emit.py:1751), so the kwargs\n# survive the deny-by-default scrub verbatim. The event LANDED — with a\n# path in a digest field and a reason slug in a plan field.\n\n_EDIT_TOOLS = frozenset({\"Edit\", \"Write\", \"MultiEdit\"})\n_PLAN_ID_RE = re.compile(r\"^PLAN-[0-9]{3,}$\")\n_PLAN_ID_UNKNOWN = \"unknown\"\n\n","numLines":420,"startLine":60,"totalLines":900}},"tool_result_meta":[{"id":"toolu_012EGJQL3dqCkwekruUoR5Vr","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
