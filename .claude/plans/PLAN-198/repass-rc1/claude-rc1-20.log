ike\",\n        (\"CLAUDE.md\",),\n        \"Governance: the three-strike rule (PROTOCOL.md) — a core gate of the \"\n        \"Plan -> Debate -> Execute machine.\",\n    ),\n    (\n        \"tamper-evident-audit\",\n        \"tamper-evident\",\n        (\"CLAUDE.md\",),\n        \"The tamper-evident audit log is the central auditability claim of the \"\n        \"framework.\",\n    ),\n    (\n        \"plan-debate-execute\",\n        \"Plan → Debate → Execute\",\n        (\"CLAUDE.md\", \"PROTOCOL.md\"),\n        \"Cross-file invariant: the governance gating ceremony name must stay \"","numLines":80,"startLine":60,"totalLines":386}},"tool_result_meta":[{"id":"toolu_015XoZ2NBahxQZJDZodXvhea","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
