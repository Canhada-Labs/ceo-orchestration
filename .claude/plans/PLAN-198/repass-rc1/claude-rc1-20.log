{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1MJJcmdmq4UyE4xzeCZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DuPijfkqq8CzFiYZmJms8r","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/prompt_rules.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7520,"cache_read_input_tokens":94146,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7520},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"ba112bb0-0629-41c7-8399-f5570b69c2d3","timestamp":"2026-11-13T17:50:42.332Z","request_id":"req_011Ch1MJJCUd6esELXmBo84f","wire_tool_inputs":{"toolu_01DuPijfkqq8CzFiYZmJms8r":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/prompt_rules.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DuPijfkqq8CzFiYZmJms8r","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport re\n4\t\n5\t__all__ = ('_strip_fenced_and_comments', '_has_skill_content', '_has_skill_content_sanitized', 'ENABLE_NATIVE_SUBAGENTS', 'ENABLE_SKILL_REFERENCE_MODE', '_SKILL_REFERENCE_HEADER_RE', '_SKILL_REFERENCE_LINE_RE', '_SKILL_REFERENCE_MAX_BYTES', '_SKILL_REFERENCE_MIN_BODY_BYTES', 'REASON_REFERENCE_MISSING', 'REASON_REFERENCE_UNSAFE_PATH', 'REASON_REFERENCE_HASH_MISMATCH', 'REASON_REFERENCE_SYMLINK_REFUSED', 'REASON_REFERENCE_TOO_LARGE', 'REASON_REFERENCE_REDACTION_HIT', 'REASON_REFERENCE_WRONG_FILENAME', 'REASON_REFERENCE_MISSING_FRONTMATTER', 'REASON_REFERENCE_BYTE_FLOOR_UNDERFLOW', 'REASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH', 'REASON_REFERENCE_OUTSIDE_SKILLS_ROOT', 'REASON_MISSING_SKILL_CONTENT', '_SECRET_TOKENS_IN_OUTPUT', '_EFFORT_TOKEN_RE', '_has_effort_token', '_SPAWN_SECRET_PATTERNS', '_inject_terse_marker', '_validate_spawn_prompt_has_no_secrets', '_ARCHITECT_NAME_RE', '_TOOL_ALLOWLIST_HEADER_RE', '_TOOL_BULLET_RE', '_KNOWN_TOOL_NAMES', '_TOOL_REQUEST_HINTS', '_TOOL_SCAN_WINDOW', '_SUBAGENT_DEPTH_MARKER_RE', '_FILE_ASSIGNMENT_HEADER_RE', '_CAN_EDIT_LINE_RE', '_FA_LIST_LINE_RE', '_FA_ALLOWED_GRANT_LINE_RE', '_FA_ALLOWED_PROSE_LINE_RE', '_FA_AUTHORITY_WORDS', '_OVERLAP_MAX_PATHS', '_OVERLAP_TAIL_LINES', '_FA_READONLY_TOKEN', '_FA_FENCE_RE', '_PROMPT_DEFENSE_HEADER_RE', '_PROMPT_DEFENSE_BULLET_RE', '_PROMPT_DEFENSE_MIN_BULLETS', '_PROMPT_DEFENSE_SCAN_CAP', '_UNTRUSTED_CONTENT_HINTS', '_prompt_defense_required', '_has_prompt_defense_block', '_emit_prompt_defense_event', '_enforce_prompt_defense')\n6\t\n7\tdef _strip_fenced_and_comments(text: str) -> str:\n8\t    \"\"\"Return a version of ``text`` with HTML comments removed and\n9\t    fenced-code-block content masked so marker/body searches cannot\n10\t    match inside them (P1-SEC-B bypass hardening).\"\"\"\n11\t    stripped = _HTML_COMMENT_RE.sub(\"\", text)\n12\t    out_parts = []\n13\t    in_fence = False\n14\t    for line in stripped.splitlines(keepends=True):\n15\t        if _CODE_FENCE_RE.match(line):\n16\t            in_fence = not in_fence\n17\t            out_parts.append(line)\n18\t            continue\n19\t        if in_fence:\n20\t            out_parts.append(\"\".join(\n21\t                \"\\n\" if c == \"\\n\" else \" \" for c in line\n22\t            ))\n23\t        else:\n24\t            out_parts.append(line)\n25\t    return \"\".join(out_parts)\n26\t\n27\t\n28\tdef _has_skill_content(prompt: str) -> bool:\n29\t    \"\"\"True iff ``prompt`` contains a real `## SKILL CONTENT` section.\n30\t\n31\t    Enforces four bypass-resistant checks (P1-SEC-B):\n32\t    1. Marker on own line (not inline narrative).\n33\t    2. Marker NOT inside HTML comment.\n34\t    3. Marker NOT inside fenced code block.\n35\t    4. >=_SKILL_CONTENT_MIN_BYTES non-ws bytes between marker and next ##.\n36\t    \"\"\"\n37\t    if not prompt:\n38\t        return False\n39\t    return _has_skill_content_sanitized(_strip_fenced_and_comments(prompt))\n40\t\n41\t\n42\tdef _has_skill_content_sanitized(sanitized: str) -> bool:\n43\t    \"\"\"Shared ``## SKILL CONTENT`` check against already-sanitized text.\n44\t\n45\t    PLAN-023 Phase F (F-perf-003) — split out so ``decide`` and other\n46\t    callers can share a single ``_strip_fenced_and_comments`` pass\n47\t    rather than re-stripping inside each sub-check.\n48\t    \"\"\"\n49\t    match = _SKILL_CONTENT_MARKER_RE.search(sanitized)\n50\t    if match is None:\n51\t        return False\n52\t    body_start = match.end()\n53\t    next_heading = _NEXT_H2_RE.search(sanitized, body_start)\n54\t    body_end = next_heading.start() if next_heading else len(sanitized)\n55\t    body = sanitized[body_start:body_end]\n56\t    non_ws_bytes = sum(1 for c in body if not c.isspace())\n57\t    return non_ws_bytes >= _SKILL_CONTENT_MIN_BYTES\n58\t\n59\t\n60\t# =============================================================================\n61\t# PLAN-020 Phase 2 — `## SKILL REFERENCE` additive sentinel (ADR-051)\n62\t# =============================================================================\n63\t#\n64\t# Parallel accept-path. Does NOT replace `_has_skill_content`. Hardened\n65\t# against 14 attack classes documented in ADR-051 §Threat model.\n66\t#\n67\t# Hook recognition order in decide():\n68\t#   1. If prompt has `## SKILL REFERENCE` → strict validation, fail-CLOSED.\n69\t#   2. Else if prompt has `## SKILL CONTENT` → inline path (existing P1-SEC-B).\n70\t#   3. Else block with the legacy `missing_skill_content` reason.\n71\t\n72\t# Module-level toggles (Phase revert = single-line flip to False).\n73\tENABLE_NATIVE_SUBAGENTS = True\n74\tENABLE_SKILL_REFERENCE_MODE = True\n75\t\n76\t# Reference sentinel header — must be on own line, not inside fences.\n77\t_SKILL_REFERENCE_HEADER_RE = re.compile(\n78\t    r\"^##[ \\t]+SKILL[ \\t]+REFERENCE[ \\t]*$\",\n79\t    flags=re.MULTILINE,\n80\t)\n81\t\n82\t# Reference body line: `@<path> sha256=<64-hex>`. Path may be relative.\n83\t_SKILL_REFERENCE_LINE_RE = re.compile(\n84\t    r\"^@(?P<path>\\S+)[ \\t]+sha256=(?P<hash>[0-9a-f]{64})\\b\",\n85\t    flags=re.MULTILINE,\n86\t)\n87\t\n88\t# Caps + thresholds (ADR-051 §Synchronous validation).\n89\t_SKILL_REFERENCE_MAX_BYTES = 1_048_576  # 1 MiB DoS cap\n90\t_SKILL_REFERENCE_MIN_BODY_BYTES = 512   # distinct from inline 256 floor\n91\t\n92\t# 12 telemetry reason codes (ADR-051 §Telemetry reason codes).\n93\tREASON_REFERENCE_MISSING = \"reference_missing\"\n94\tREASON_REFERENCE_UNSAFE_PATH = \"reference_unsafe_path\"\n95\tREASON_REFERENCE_HASH_MISMATCH = \"reference_hash_mismatch\"\n96\tREASON_REFERENCE_SYMLINK_REFUSED = \"reference_symlink_refused\"\n97\tREASON_REFERENCE_TOO_LARGE = \"reference_too_large\"\n98\tREASON_REFERENCE_REDACTION_HIT = \"reference_redaction_hit\"\n99\tREASON_REFERENCE_WRONG_FILENAME = \"reference_wrong_filename\"\n100\tREASON_REFERENCE_MISSING_FRONTMATTER = \"reference_missing_frontmatter\"\n101\tREASON_REFERENCE_BYTE_FLOOR_UNDERFLOW = \"reference_byte_floor_underflow\"\n102\tREASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH = (\n103\t    \"reference_unicode_normalization_mismatch\"\n104\t)\n105\tREASON_REFERENCE_OUTSIDE_SKILLS_ROOT = \"reference_outside_skills_root\"\n106\tREASON_MISSING_SKILL_CONTENT = \"missing_skill_content\"  # legacy/inline\n107\t\n108\t# Session 32 BUGFIX — _lib.redact.redact_secrets whitespace-collapses\n109\t# always; equality check with original text is not a valid \"secret\n110\t# detected\" signal. Instead we look for specific replacement tokens\n111\t# that `_redact._PATTERNS` inserts when a secret matches.\n112\t_SECRET_TOKENS_IN_OUTPUT = frozenset({\n113\t    \"[JWT]\",\n114\t    \"[API_KEY]\",\n115\t    \"[GITHUB_PAT]\",\n116\t    \"[AWS_KEY]\",\n117\t    \"[TOKEN]\",\n118\t    \"[URL_WITH_CREDS]\",\n119\t    \"[HEX_SECRET]\",\n120\t    \"[REDACTED]\",\n121\t    \"[SLACK_BOT]\",\n122\t    \"[STRIPE_KEY]\",\n123\t    \"[GOOGLE_REFRESH]\",\n124\t    # PLAN-024 F-hooks-001 P0 fix: redact.py replaces the PEM header\n125\t    # with \"[SSH_PRIVATE_KEY_HEADER]\" — matching raw \"-----BEGIN\" will\n126\t    # never fire after redaction. Check the replacement token instead.\n127\t    \"[SSH_PRIVATE_KEY_HEADER]\",\n128\t})\n129\t\n130\t\n131\t# =============================================================================\n132\t# PLAN-020 Phase 3 — `/effort` token rejection in spawn prompts\n133\t# =============================================================================\n134\t#\n135\t# `/effort` hints (low/default/high/max + `ultrathink` keyword) are\n136\t# CEO-only. They MUST NOT appear in spawn prompts (sub-agents inherit\n137\t# their thinking budget from Anthropic defaults). PLAN-020 §4 Phase 3\n138\t# §scope clause (QA must-fix #7).\n139\t\n140\t_EFFORT_TOKEN_RE = re.compile(\n141\t    r\"(?:^|[^\\w/])/effort(?:[ \\t]+(?:low|default|high|max))?\\b\",\n142\t    flags=re.IGNORECASE,\n143\t)\n144\t\n145\t\n146\tdef _has_effort_token(prompt: str) -> bool:\n147\t    \"\"\"True iff prompt contains a `/effort [tier]` slash-command token.\"\"\"\n148\t    if not prompt:\n149\t        return False\n150\t    sanitized = _strip_fenced_and_comments(prompt)\n151\t    return bool(_EFFORT_TOKEN_RE.search(sanitized))\n152\t\n153\t\n154\t# ---------------------------------------------------------------------------\n155\t# PLAN-045 F-10-04 — spawn-prompt secret-scan pre-dispatch\n156\t# ---------------------------------------------------------------------------\n157\t# Spawn prompts are the #1 vector for accidentally shipping secrets into a\n158\t# sub-agent's context. A CEO that copy-pastes a `.env` into a task prompt\n159\t# or builds a prompt that interpolates an env var leaks the secret to\n160\t# whatever model the sub-agent uses AND to the audit log (spawn prompts\n161\t# are recorded for governance).\n162\t#\n163\t# Reject spawns whose prompt contains any of 6 high-signal secret shapes.\n164\t# Each shape is a narrow regex to avoid false-positives on docs / test\n165\t# fixtures (prefix-bound + entropy-adjacent). Audit emits\n166\t# `veto_triggered(reason_code=spawn_prompt_contains_secret)` on reject.\n167\t#\n168\t# Kill-switch: `CEO_SPAWN_SECRET_SCAN=0` for the rare case where a prompt\n169\t# legitimately contains a long opaque id that trips the scan; Owner-only\n170\t# escape logged via veto_triggered(reason_code=spawn_secret_scan_bypassed).\n171\t_SPAWN_SECRET_PATTERNS: List[Tuple[str, re.Pattern[str]]] = [\n172\t    # AWS access key ID (AKIA prefix, 16 uppercase alnum after).\n173\t    (\"aws_access_key_id\", re.compile(r\"\\bAKIA[0-9A-Z]{16}\\b\")),\n174\t    # Generic AWS secret access key.\n175\t    (\n176\t        \"aws_secret_access_key\",\n177\t        re.compile(\n178\t            r\"\\b(?:aws[_-]?secret[_-]?access[_-]?key)\\b\\s*[:=]\\s*\"\n179\t            r\"[\\\"\\']?[A-Za-z0-9/+=]{40}[\\\"\\']?\",\n180\t            re.IGNORECASE,\n181\t        ),\n182\t    ),\n183\t    # Stripe live/test secret key.\n184\t    (\"stripe_secret_key\", re.compile(r\"\\bsk_(?:live|test)_[0-9A-Za-z]{24,}\\b\")),\n185\t    # GitHub personal access token.\n186\t    (\"github_pat\", re.compile(r\"\\bghp_[0-9A-Za-z]{36,}\\b\")),\n187\t    # OpenAI API key.\n188\t    (\"openai_api_key\", re.compile(r\"\\bsk-[A-Za-z0-9]{48,}\\b\")),\n189\t    # PEM private key preamble.\n190\t    (\n191\t        \"pem_private_key\",\n192\t        re.compile(\n193\t            r\"-----BEGIN (?:RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----\"\n194\t        ),\n195\t    ),\n196\t]\n197\t\n198\t\n199\tdef _inject_terse_marker(prompt: str, subagent_type: str) -> str:\n200\t    \"\"\"Inject ## TERSE-MODE marker per PLAN-047 Phase 2.\"\"\"\n201\t    if os.environ.get(\"CEO_TERSE_MODE\", \"0\") != \"1\":\n202\t        return prompt\n203\t    veto_roles = {\"code-reviewer\", \"security-engineer\", \"qa-architect\", \"compliance-specialist\"}\n204\t    if (subagent_type or \"\") in veto_roles:\n205\t        return prompt + \"\\n\\n## TERSE-MODE-DISABLED — VETO role requires full-prose rationale.\\n\"\n206\t    return prompt + \"\\n\\n## TERSE-MODE — fragments OK in exploratory flows; never truncate code or numbers.\\n\"\n207\t\n208\tdef _validate_spawn_prompt_has_no_secrets(\n209\t    prompt: str,\n210\t) -> Tuple[bool, Optional[str], Optional[str]]:\n211\t    \"\"\"Return (ok, reason_code, detail) — ok=False means BLOCK spawn.\n212\t\n213\t    Short-circuits with ok=True when `CEO_SPAWN_SECRET_SCAN=0` is set\n214\t    (Owner bypass; any non-\"0\" value enforces).\n215\t    \"\"\"\n216\t    # Session 75 Codex Finding 4 closure (Owner D4 staged rollout):\n217\t    # default OFF, opt-in via CEO_SPAWN_SECRET_SCAN=1. Without the env\n218\t    # var (or with =0), function returns ok=True without scanning. Soak\n219\t    # protocol: ≥3 sessions of opt-in usage with FPR<1%% before any\n220\t    # default flip ADR. Until then, this is a wire-only landing.\n221\t    if os.environ.get(\"CEO_SPAWN_SECRET_SCAN\", \"0\") != \"1\":\n222\t        return True, None, None\n223\t    if not prompt:\n224\t        return True, None, None\n225\t    for family, pattern in _SPAWN_SECRET_PATTERNS:\n226\t        m = pattern.search(prompt)\n227\t        if m:\n228\t            return (\n229\t                False,\n230\t                \"spawn_prompt_contains_secret\",\n231\t                f\"family={family} prompt_len={len(prompt)}\",\n232\t            )\n233\t    return True, None, None\n234\t\n235\t\n236\t# Sprint 5 Phase 7 (ADR-010) — Architect recursion guard.\n237\t# When CEO_ARCHITECT_ACTIVE=1 is in the env, any spawn whose\n238\t# description/prompt names \"Agent Architect\" is BLOCKED. Prevents\n239\t# meta-agent recursion (Architect-spawning-Architect).\n240\t_ARCHITECT_NAME_RE = re.compile(\n241\t    r\"\\bAgent\\s+Architect\\b\",\n242\t    flags=re.IGNORECASE,\n243\t)\n244\t\n245\t\n246\t# ---------------------------------------------------------------------------\n247\t# PLAN-133 E3 — Per-spawn tool scoping + depth/overlap rails.\n248\t# ---------------------------------------------------------------------------\n249\t# Ports the Goose recipe \"declared capability scope + one-level recursion +\n250\t# file partition\" idea, re-implemented from scratch in stdlib (rite §2). All\n251\t# three rails are ADVISORY by default (emit only) and become BLOCKING only\n252\t# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n253\t#\n254\t# Rail 1 — Tool allow-list: a spawn profile MAY declare\n255\t#     ## TOOL ALLOW-LIST\n256\t#     - Read\n257\t#     - Edit\n258\t#     - Bash\n259\t# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n260\t# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n261\t# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n262\t#\n263\t# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n264\t# depth-2 spawn. The harness Agent payload has no native depth field, so we\n265\t# read the advisory marker the CEO injects into a delegated prompt\n266\t# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n267\t# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n268\t#\n269\t# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n270\t# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n271\t# other spawns recorded in the audit log within a short concurrency window\n272\t# (same session, same plan). Any shared concrete path = clobber risk.\n273\t\n274\t# --- Rail 1: tool allow-list ----------------------------------------------\n275\t_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n276\t    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n277\t    flags=re.MULTILINE,\n278\t)\n279\t# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n280\t_TOOL_BULLET_RE = re.compile(\n281\t    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n282\t    flags=re.MULTILINE,\n283\t)\n284\t# Canonical Claude Code tool names we recognize (closed set — anything not\n285\t# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n286\t# unknown token can never cause a false block).\n287\t_KNOWN_TOOL_NAMES = frozenset({\n288\t    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n289\t    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n290\t})\n291\t# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n292\t# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n293\t# a profile that simply mentions a word does not trip the rail.\n294\t_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n295\t    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n296\t              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n297\t    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n298\t    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n299\t    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n300\t    (\"websearch\", (\"search the web\", \"web search\")),\n301\t)\n302\t_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n303\t\n304\t# --- Rail 2: depth fence ---------------------------------------------------\n305\t_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n306\t    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n307\t    flags=re.MULTILINE,\n308\t)\n309\t\n310\t# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n311\t# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n312\t# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n313\t# Markdown renderer/agent — recognizing them (instead of enumerating\n314\t# taints) keeps the parser aligned with what the agent SEES.\n315\t_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n316\t    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n317\t    flags=re.MULTILINE | re.IGNORECASE,\n318\t)\n319\t# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n320\t# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n321\t# make the line a CommonMark CODE BLOCK — example text, never a grant.\n322\t_CAN_EDIT_LINE_RE = re.compile(\n323\t    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n324\t    flags=re.MULTILINE | re.IGNORECASE,\n325\t)\n326\t# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n327\t# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n328\t# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n329\t# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n330\t# match a CLOSED whitelist of recognized forms — anything else is a\n331\t# visible grant/instruction the parser did not validate => taint.\n332\t_FA_LIST_LINE_RE = re.compile(\n333\t    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n334\t    flags=re.MULTILINE,\n335\t)\n336\t_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n337\t    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n338\t    flags=re.IGNORECASE,\n339\t)\n340\t_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n341\t    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n342\t    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n343\t    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n344\t    r\"|FORBIDDEN\\b\"             # architect forbidden list\n345\t    # canonical template escape-hatch prose — the FULL fixed phrase, so\n346\t    # the prefix CONSUMES its own `edit` and the suffix rule below can\n347\t    # ban any further edit-grant text (codex r34 P1)\n348\t    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n349\t    r\")\",\n350\t    flags=re.IGNORECASE,\n351\t)\n352\t# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n353\t# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n354\t# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n355\t# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n356\t# authority). A token is a whitespace-delimited word stripped of edge\n357\t# punctuation; tokens containing / or . are path-like and never match.\n358\t_FA_AUTHORITY_WORDS = frozenset((\n359\t    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n360\t    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n361\t))\n362\t\n363\t\n364\t# _OVERLAP_LOOKBACK_S is re-exported from agent_spawn.file_assignment below.\n365\t_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n366\t_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n367\t\n368\t\n369\t# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n370\t# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n371\t# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n372\t# ADR-191 cures): read-only intent must be spelled out with this token.\n373\t_FA_READONLY_TOKEN = \"none-read-only\"\n374\t\n375\t# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n376\t# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n377\t# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n378\t# CommonMark) would leak into classification and could satisfy the gate\n379\t# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n380\t# radius; the shared regex serves every other block parser unchanged).\n381\t# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n382\t# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n383\t# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n384\t# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n385\t# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n386\t# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n387\t# Closer must be the SAME character, length >= opener (codex r37 P2:\n388\t# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n389\t# the fence char; closer = \\1 (full opener string) + \\2* (same char\n390\t# only). A shorter/mismatched closer falls through to \\Z — masking to\n391\t# EOF, the fail-CLOSED direction.\n392\t_FA_FENCE_RE = re.compile(\n393\t    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n394\t    flags=re.MULTILINE | re.DOTALL,\n395\t)\n396\t\n397\t# Telemetry marker hash for the explicit read-only declaration. DOMAIN-\n398\t# SEPARATED from real path hashes (codex r1 P2, Lote B): hashing the bare\n399\t# token collided with a legitimate concrete path `./none-read-only` (the\n400\t# token check runs BEFORE ./-normalization, so that path survives as\n401\t# concrete and would hash identically — under CEO_SPAWN_OVERLAP_GUARD=1 it\n402\t# would false-block against every prior read-only spawn). NUL bytes cannot\n403\t# appear in a real declared path, so this input is unreachable from\n404\t# _path_hash(path) space.\n405\t\n406\t\n407\t# ---------------------------------------------------------------------------\n408\t# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [BEGIN]\n409\t# ---------------------------------------------------------------------------\n410\t# NAMED spawns whose task indicates contact with UNTRUSTED CONTENT (web\n411\t# fetch/search, scraping, imported/upstream/third-party material) MUST carry\n412\t# the 6-bullet `## PROMPT DEFENSE` anti-injection block that\n413\t# `.claude/scripts/inject-agent-context.sh` now emits unconditionally.\n414\t#\n415\t# Failure semantics (CLAUDE.md §4 doctrine):\n416\t#   - INPUT side is fail-CLOSED: heuristic matched + section missing/thin\n417\t#     => BLOCK (precedent: check_bash_safety.py `_e3` parse gate + C4).\n418\t#   - INFRASTRUCTURE side is fail-OPEN: any exception inside this gate\n419\t#     => allow (never punish the session for our own bug).\n420\t#\n421\t# Detection is a CONSERVATIVE lowercase-substring keyword set scanned over\n422\t# the sanitized (fence/comment-stripped) description + prompt. HONESTY —\n423\t# documented false negatives, by design:\n424\t#   - synonyms/other languages are missed (\"crawl\", \"harvest\", \"baixar\",\n425\t#     \"read the vendor tarball\", ...);\n426\t#   - obfuscated intents (base64, hyphenation, l33t) are missed;\n427\t#   - keywords appearing ONLY inside fenced code blocks are masked by\n428\t#     `_strip_fenced_and_comments` and therefore missed;\n429\t#   - scan is capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes; mentions beyond\n430\t#     the cap are missed.\n431\t# The cheap mitigation for every miss-class is the same: the spawn template\n432\t# emits the block UNCONDITIONALLY, so any template-generated prompt passes\n433\t# regardless of heuristic reach. This gate exists to catch hand-rolled\n434\t# prompts that bypass the template.\n435\t#\n436\t# Kill-switches (advisory demotion — event still emitted, spawn allowed):\n437\t#   CEO_PROMPT_DEFENSE_GATE=0   per-gate opt-out\n438\t#   CEO_SOTA_DISABLE=1          master kill (E3-rail precedent)\n439\t_PROMPT_DEFENSE_HEADER_RE = re.compile(\n440\t    r\"^##[ \\t]+PROMPT[ \\t]+DEFENSE[ \\t]*$\",\n441\t    flags=re.MULTILINE,\n442\t)\n443\t# A bullet line: \"-\" or \"*\" + whitespace + at least one non-space char.\n444\t_PROMPT_DEFENSE_BULLET_RE = re.compile(\n445\t    r\"^[ \\t]*[-*][ \\t]+\\S\",\n446\t    flags=re.MULTILINE,\n447\t)\n448\t_PROMPT_DEFENSE_MIN_BULLETS = 6\n449\t_PROMPT_DEFENSE_SCAN_CAP = 256 * 1024  # bytes of sanitized text scanned\n450\t# Closed, lowercase substring set. Ordering = report priority (first hit\n451\t# wins; the matched token is the ONLY prompt-derived value that reaches the\n452\t# audit log — closed-enum-safe, no prompt body echo).\n453\t_UNTRUSTED_CONTENT_HINTS: Tuple[str, ...] = (\n454\t    \"webfetch\",\n455\t    \"websearch\",\n456\t    \"web search\",\n457\t    \"search the web\",\n458\t    \"fetch the url\",\n459\t    \"fetch url\",\n460\t    \"fetch http\",\n461\t    \"download from http\",\n462\t    \"scrape\",\n463\t    \"scraping\",\n464\t    \"imported\",\n465\t    \"upstream\",\n466\t    \"third-party\",\n467\t    \"third party\",\n468\t    \"untrusted\",\n469\t)\n470\t\n471\t\n472\tdef _prompt_defense_required(\n473\t    description: str, prompt_sanitized: str\n474\t) -> Optional[str]:\n475\t    \"\"\"Return the first matched untrusted-content hint, or None.\n476\t\n477\t    Pure. Never raises. Bounded scan over lowercase(description + sanitized\n478\t    prompt) capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes.\n479\t    \"\"\"\n480\t    haystack = (\n481\t        (description or \"\") + \"\\n\" + (prompt_sanitized or \"\")\n482\t    )[:_PROMPT_DEFENSE_SCAN_CAP].lower()\n483\t    for hint in _UNTRUSTED_CONTENT_HINTS:\n484\t        if hint in haystack:\n485\t            return hint\n486\t    return None\n487\t\n488\t\n489\tdef _has_prompt_defense_block(prompt_sanitized: str) -> bool:\n490\t    \"\"\"True iff sanitized prompt has `## PROMPT DEFENSE` on its own line\n491\t    with >= `_PROMPT_DEFENSE_MIN_BULLETS` bullet lines before the next\n492\t    `##` heading / EOF. Fence/comment-masked headers do NOT count\n493\t    (P1-SEC-B precedent — caller passes pre-sanitized text).\"\"\"\n494\t    if not prompt_sanitized:\n495\t        return False\n496\t    m = _PROMPT_DEFENSE_HEADER_RE.search(prompt_sanitized)\n497\t    if m is None:\n498\t        return False\n499\t    block_start = m.end()\n500\t    nxt = _NEXT_H2_RE.search(prompt_sanitized, block_start)\n501\t    block = prompt_sanitized[\n502\t        block_start: nxt.start() if nxt else len(prompt_sanitized)\n503\t    ]\n504\t    bullets = len(_PROMPT_DEFENSE_BULLET_RE.findall(block))\n505\t    return bullets >= _PROMPT_DEFENSE_MIN_BULLETS\n506\t\n507\t\n508\tdef _emit_prompt_defense_event(\n509\t    *, keyword: str, present: bool, enforced: bool\n510\t) -> None:\n511\t    \"\"\"Emit `spawn_prompt_defense_gate` telemetry. `keyword` is from the\n512\t    closed `_UNTRUSTED_CONTENT_HINTS` enum — no prompt body ever persists.\n513\t    Fail-open.\"\"\"\n514\t    try:\n515\t        if not _AUDIT_EMIT_AVAILABLE:\n516\t            return\n517\t        _audit_emit.emit_generic(\n518\t            \"spawn_prompt_defense_gate\",\n519\t            keyword=(keyword or \"\")[:32],\n520\t            present=1 if present else 0,\n521\t            enforced=1 if enforced else 0,\n522\t        )\n523\t    except Exception:  # pragma: no cover - fail-open\n524\t        return\n525\t\n526\t\n527\tdef _enforce_prompt_defense(\n528\t    *,\n529\t    description: str,\n530\t    prompt: str,\n531\t    env: Dict[str, str],\n532\t) -> Optional[Tuple[str, str]]:\n533\t    \"\"\"Evaluate the Prompt Defense Baseline gate for a NAMED spawn.\n534\t\n535\t    Returns (reason_code, detail) when the gate is ENFORCING and fires;\n536\t    None otherwise. NEVER raises (infra fail-open); the block itself is\n537\t    the input-side fail-CLOSED posture (matched + missing => BLOCK).\n538\t    \"\"\"\n539\t    try:\n540\t        sanitized = _strip_fenced_and_comments(prompt or \"\")\n541\t        keyword = _prompt_defense_required(description or \"\", sanitized)\n542\t        if keyword is None:\n543\t            return None  # no untrusted-content signal — out of scope\n544\t        present = _has_prompt_defense_block(sanitized)\n545\t        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n546\t        raw = (env.get(\"CEO_PROMPT_DEFENSE_GATE\") or \"\").strip()\n547\t        gate_off = raw in (\"0\", \"false\", \"False\", \"no\", \"off\")\n548\t        enforced = (not master_off) and (not gate_off)\n549\t        _emit_prompt_defense_event(\n550\t            keyword=keyword, present=present, enforced=enforced\n551\t        )\n552\t        if present or not enforced:\n553\t            return None\n554\t        return (\n555\t            \"spawn_prompt_defense_missing\",\n556\t            f\"keyword={keyword} min_bullets={_PROMPT_DEFENSE_MIN_BULLETS}\",\n557\t        )\n558\t    except Exception:  # pragma: no cover - fail-open invariant\n559\t        return None\n560\t"}]},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"71109ce0-d921-4e09-856d-a55b681e5ca1","timestamp":"2026-11-13T17:50:42.563Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/prompt_rules.py","content":"from __future__ import annotations\n\nimport re\n\n__all__ = ('_strip_fenced_and_comments', '_has_skill_content', '_has_skill_content_sanitized', 'ENABLE_NATIVE_SUBAGENTS', 'ENABLE_SKILL_REFERENCE_MODE', '_SKILL_REFERENCE_HEADER_RE', '_SKILL_REFERENCE_LINE_RE', '_SKILL_REFERENCE_MAX_BYTES', '_SKILL_REFERENCE_MIN_BODY_BYTES', 'REASON_REFERENCE_MISSING', 'REASON_REFERENCE_UNSAFE_PATH', 'REASON_REFERENCE_HASH_MISMATCH', 'REASON_REFERENCE_SYMLINK_REFUSED', 'REASON_REFERENCE_TOO_LARGE', 'REASON_REFERENCE_REDACTION_HIT', 'REASON_REFERENCE_WRONG_FILENAME', 'REASON_REFERENCE_MISSING_FRONTMATTER', 'REASON_REFERENCE_BYTE_FLOOR_UNDERFLOW', 'REASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH', 'REASON_REFERENCE_OUTSIDE_SKILLS_ROOT', 'REASON_MISSING_SKILL_CONTENT', '_SECRET_TOKENS_IN_OUTPUT', '_EFFORT_TOKEN_RE', '_has_effort_token', '_SPAWN_SECRET_PATTERNS', '_inject_terse_marker', '_validate_spawn_prompt_has_no_secrets', '_ARCHITECT_NAME_RE', '_TOOL_ALLOWLIST_HEADER_RE', '_TOOL_BULLET_RE', '_KNOWN_TOOL_NAMES', '_TOOL_REQUEST_HINTS', '_TOOL_SCAN_WINDOW', '_SUBAGENT_DEPTH_MARKER_RE', '_FILE_ASSIGNMENT_HEADER_RE', '_CAN_EDIT_LINE_RE', '_FA_LIST_LINE_RE', '_FA_ALLOWED_GRANT_LINE_RE', '_FA_ALLOWED_PROSE_LINE_RE', '_FA_AUTHORITY_WORDS', '_OVERLAP_MAX_PATHS', '_OVERLAP_TAIL_LINES', '_FA_READONLY_TOKEN', '_FA_FENCE_RE', '_PROMPT_DEFENSE_HEADER_RE', '_PROMPT_DEFENSE_BULLET_RE', '_PROMPT_DEFENSE_MIN_BULLETS', '_PROMPT_DEFENSE_SCAN_CAP', '_UNTRUSTED_CONTENT_HINTS', '_prompt_defense_required', '_has_prompt_defense_block', '_emit_prompt_defense_event', '_enforce_prompt_defense')\n\ndef _strip_fenced_and_comments(text: str) -> str:\n    \"\"\"Return a version of ``text`` with HTML comments removed and\n    fenced-code-block content masked so marker/body searches cannot\n    match inside them (P1-SEC-B bypass hardening).\"\"\"\n    stripped = _HTML_COMMENT_RE.sub(\"\", text)\n    out_parts = []\n    in_fence = False\n    for line in stripped.splitlines(keepends=True):\n        if _CODE_FENCE_RE.match(line):\n            in_fence = not in_fence\n            out_parts.append(line)\n            continue\n        if in_fence:\n            out_parts.append(\"\".join(\n                \"\\n\" if c == \"\\n\" else \" \" for c in line\n            ))\n        else:\n            out_parts.append(line)\n    return \"\".join(out_parts)\n\n\ndef _has_skill_content(prompt: str) -> bool:\n    \"\"\"True iff ``prompt`` contains a real `## SKILL CONTENT` section.\n\n    Enforces four bypass-resistant checks (P1-SEC-B):\n    1. Marker on own line (not inline narrative).\n    2. Marker NOT inside HTML comment.\n    3. Marker NOT inside fenced code block.\n    4. >=_SKILL_CONTENT_MIN_BYTES non-ws bytes between marker and next ##.\n    \"\"\"\n    if not prompt:\n        return False\n    return _has_skill_content_sanitized(_strip_fenced_and_comments(prompt))\n\n\ndef _has_skill_content_sanitized(sanitized: str) -> bool:\n    \"\"\"Shared ``## SKILL CONTENT`` check against already-sanitized text.\n\n    PLAN-023 Phase F (F-perf-003) — split out so ``decide`` and other\n    callers can share a single ``_strip_fenced_and_comments`` pass\n    rather than re-stripping inside each sub-check.\n    \"\"\"\n    match = _SKILL_CONTENT_MARKER_RE.search(sanitized)\n    if match is None:\n        return False\n    body_start = match.end()\n    next_heading = _NEXT_H2_RE.search(sanitized, body_start)\n    body_end = next_heading.start() if next_heading else len(sanitized)\n    body = sanitized[body_start:body_end]\n    non_ws_bytes = sum(1 for c in body if not c.isspace())\n    return non_ws_bytes >= _SKILL_CONTENT_MIN_BYTES\n\n\n# =============================================================================\n# PLAN-020 Phase 2 — `## SKILL REFERENCE` additive sentinel (ADR-051)\n# =============================================================================\n#\n# Parallel accept-path. Does NOT replace `_has_skill_content`. Hardened\n# against 14 attack classes documented in ADR-051 §Threat model.\n#\n# Hook recognition order in decide():\n#   1. If prompt has `## SKILL REFERENCE` → strict validation, fail-CLOSED.\n#   2. Else if prompt has `## SKILL CONTENT` → inline path (existing P1-SEC-B).\n#   3. Else block with the legacy `missing_skill_content` reason.\n\n# Module-level toggles (Phase revert = single-line flip to False).\nENABLE_NATIVE_SUBAGENTS = True\nENABLE_SKILL_REFERENCE_MODE = True\n\n# Reference sentinel header — must be on own line, not inside fences.\n_SKILL_REFERENCE_HEADER_RE = re.compile(\n    r\"^##[ \\t]+SKILL[ \\t]+REFERENCE[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n\n# Reference body line: `@<path> sha256=<64-hex>`. Path may be relative.\n_SKILL_REFERENCE_LINE_RE = re.compile(\n    r\"^@(?P<path>\\S+)[ \\t]+sha256=(?P<hash>[0-9a-f]{64})\\b\",\n    flags=re.MULTILINE,\n)\n\n# Caps + thresholds (ADR-051 §Synchronous validation).\n_SKILL_REFERENCE_MAX_BYTES = 1_048_576  # 1 MiB DoS cap\n_SKILL_REFERENCE_MIN_BODY_BYTES = 512   # distinct from inline 256 floor\n\n# 12 telemetry reason codes (ADR-051 §Telemetry reason codes).\nREASON_REFERENCE_MISSING = \"reference_missing\"\nREASON_REFERENCE_UNSAFE_PATH = \"reference_unsafe_path\"\nREASON_REFERENCE_HASH_MISMATCH = \"reference_hash_mismatch\"\nREASON_REFERENCE_SYMLINK_REFUSED = \"reference_symlink_refused\"\nREASON_REFERENCE_TOO_LARGE = \"reference_too_large\"\nREASON_REFERENCE_REDACTION_HIT = \"reference_redaction_hit\"\nREASON_REFERENCE_WRONG_FILENAME = \"reference_wrong_filename\"\nREASON_REFERENCE_MISSING_FRONTMATTER = \"reference_missing_frontmatter\"\nREASON_REFERENCE_BYTE_FLOOR_UNDERFLOW = \"reference_byte_floor_underflow\"\nREASON_REFERENCE_UNICODE_NORMALIZATION_MISMATCH = (\n    \"reference_unicode_normalization_mismatch\"\n)\nREASON_REFERENCE_OUTSIDE_SKILLS_ROOT = \"reference_outside_skills_root\"\nREASON_MISSING_SKILL_CONTENT = \"missing_skill_content\"  # legacy/inline\n\n# Session 32 BUGFIX — _lib.redact.redact_secrets whitespace-collapses\n# always; equality check with original text is not a valid \"secret\n# detected\" signal. Instead we look for specific replacement tokens\n# that `_redact._PATTERNS` inserts when a secret matches.\n_SECRET_TOKENS_IN_OUTPUT = frozenset({\n    \"[JWT]\",\n    \"[API_KEY]\",\n    \"[GITHUB_PAT]\",\n    \"[AWS_KEY]\",\n    \"[TOKEN]\",\n    \"[URL_WITH_CREDS]\",\n    \"[HEX_SECRET]\",\n    \"[REDACTED]\",\n    \"[SLACK_BOT]\",\n    \"[STRIPE_KEY]\",\n    \"[GOOGLE_REFRESH]\",\n    # PLAN-024 F-hooks-001 P0 fix: redact.py replaces the PEM header\n    # with \"[SSH_PRIVATE_KEY_HEADER]\" — matching raw \"-----BEGIN\" will\n    # never fire after redaction. Check the replacement token instead.\n    \"[SSH_PRIVATE_KEY_HEADER]\",\n})\n\n\n# =============================================================================\n# PLAN-020 Phase 3 — `/effort` token rejection in spawn prompts\n# =============================================================================\n#\n# `/effort` hints (low/default/high/max + `ultrathink` keyword) are\n# CEO-only. They MUST NOT appear in spawn prompts (sub-agents inherit\n# their thinking budget from Anthropic defaults). PLAN-020 §4 Phase 3\n# §scope clause (QA must-fix #7).\n\n_EFFORT_TOKEN_RE = re.compile(\n    r\"(?:^|[^\\w/])/effort(?:[ \\t]+(?:low|default|high|max))?\\b\",\n    flags=re.IGNORECASE,\n)\n\n\ndef _has_effort_token(prompt: str) -> bool:\n    \"\"\"True iff prompt contains a `/effort [tier]` slash-command token.\"\"\"\n    if not prompt:\n        return False\n    sanitized = _strip_fenced_and_comments(prompt)\n    return bool(_EFFORT_TOKEN_RE.search(sanitized))\n\n\n# ---------------------------------------------------------------------------\n# PLAN-045 F-10-04 — spawn-prompt secret-scan pre-dispatch\n# ---------------------------------------------------------------------------\n# Spawn prompts are the #1 vector for accidentally shipping secrets into a\n# sub-agent's context. A CEO that copy-pastes a `.env` into a task prompt\n# or builds a prompt that interpolates an env var leaks the secret to\n# whatever model the sub-agent uses AND to the audit log (spawn prompts\n# are recorded for governance).\n#\n# Reject spawns whose prompt contains any of 6 high-signal secret shapes.\n# Each shape is a narrow regex to avoid false-positives on docs / test\n# fixtures (prefix-bound + entropy-adjacent). Audit emits\n# `veto_triggered(reason_code=spawn_prompt_contains_secret)` on reject.\n#\n# Kill-switch: `CEO_SPAWN_SECRET_SCAN=0` for the rare case where a prompt\n# legitimately contains a long opaque id that trips the scan; Owner-only\n# escape logged via veto_triggered(reason_code=spawn_secret_scan_bypassed).\n_SPAWN_SECRET_PATTERNS: List[Tuple[str, re.Pattern[str]]] = [\n    # AWS access key ID (AKIA prefix, 16 uppercase alnum after).\n    (\"aws_access_key_id\", re.compile(r\"\\bAKIA[0-9A-Z]{16}\\b\")),\n    # Generic AWS secret access key.\n    (\n        \"aws_secret_access_key\",\n        re.compile(\n            r\"\\b(?:aws[_-]?secret[_-]?access[_-]?key)\\b\\s*[:=]\\s*\"\n            r\"[\\\"\\']?[A-Za-z0-9/+=]{40}[\\\"\\']?\",\n            re.IGNORECASE,\n        ),\n    ),\n    # Stripe live/test secret key.\n    (\"stripe_secret_key\", re.compile(r\"\\bsk_(?:live|test)_[0-9A-Za-z]{24,}\\b\")),\n    # GitHub personal access token.\n    (\"github_pat\", re.compile(r\"\\bghp_[0-9A-Za-z]{36,}\\b\")),\n    # OpenAI API key.\n    (\"openai_api_key\", re.compile(r\"\\bsk-[A-Za-z0-9]{48,}\\b\")),\n    # PEM private key preamble.\n    (\n        \"pem_private_key\",\n        re.compile(\n            r\"-----BEGIN (?:RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----\"\n        ),\n    ),\n]\n\n\ndef _inject_terse_marker(prompt: str, subagent_type: str) -> str:\n    \"\"\"Inject ## TERSE-MODE marker per PLAN-047 Phase 2.\"\"\"\n    if os.environ.get(\"CEO_TERSE_MODE\", \"0\") != \"1\":\n        return prompt\n    veto_roles = {\"code-reviewer\", \"security-engineer\", \"qa-architect\", \"compliance-specialist\"}\n    if (subagent_type or \"\") in veto_roles:\n        return prompt + \"\\n\\n## TERSE-MODE-DISABLED — VETO role requires full-prose rationale.\\n\"\n    return prompt + \"\\n\\n## TERSE-MODE — fragments OK in exploratory flows; never truncate code or numbers.\\n\"\n\ndef _validate_spawn_prompt_has_no_secrets(\n    prompt: str,\n) -> Tuple[bool, Optional[str], Optional[str]]:\n    \"\"\"Return (ok, reason_code, detail) — ok=False means BLOCK spawn.\n\n    Short-circuits with ok=True when `CEO_SPAWN_SECRET_SCAN=0` is set\n    (Owner bypass; any non-\"0\" value enforces).\n    \"\"\"\n    # Session 75 Codex Finding 4 closure (Owner D4 staged rollout):\n    # default OFF, opt-in via CEO_SPAWN_SECRET_SCAN=1. Without the env\n    # var (or with =0), function returns ok=True without scanning. Soak\n    # protocol: ≥3 sessions of opt-in usage with FPR<1%% before any\n    # default flip ADR. Until then, this is a wire-only landing.\n    if os.environ.get(\"CEO_SPAWN_SECRET_SCAN\", \"0\") != \"1\":\n        return True, None, None\n    if not prompt:\n        return True, None, None\n    for family, pattern in _SPAWN_SECRET_PATTERNS:\n        m = pattern.search(prompt)\n        if m:\n            return (\n                False,\n                \"spawn_prompt_contains_secret\",\n                f\"family={family} prompt_len={len(prompt)}\",\n            )\n    return True, None, None\n\n\n# Sprint 5 Phase 7 (ADR-010) — Architect recursion guard.\n# When CEO_ARCHITECT_ACTIVE=1 is in the env, any spawn whose\n# description/prompt names \"Agent Architect\" is BLOCKED. Prevents\n# meta-agent recursion (Architect-spawning-Architect).\n_ARCHITECT_NAME_RE = re.compile(\n    r\"\\bAgent\\s+Architect\\b\",\n    flags=re.IGNORECASE,\n)\n\n\n# ---------------------------------------------------------------------------\n# PLAN-133 E3 — Per-spawn tool scoping + depth/overlap rails.\n# ---------------------------------------------------------------------------\n# Ports the Goose recipe \"declared capability scope + one-level recursion +\n# file partition\" idea, re-implemented from scratch in stdlib (rite §2). All\n# three rails are ADVISORY by default (emit only) and become BLOCKING only\n# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n#\n# Rail 1 — Tool allow-list: a spawn profile MAY declare\n#     ## TOOL ALLOW-LIST\n#     - Read\n#     - Edit\n#     - Bash\n# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n#\n# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n# depth-2 spawn. The harness Agent payload has no native depth field, so we\n# read the advisory marker the CEO injects into a delegated prompt\n# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n#\n# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n# other spawns recorded in the audit log within a short concurrency window\n# (same session, same plan). Any shared concrete path = clobber risk.\n\n# --- Rail 1: tool allow-list ----------------------------------------------\n_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n_TOOL_BULLET_RE = re.compile(\n    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n    flags=re.MULTILINE,\n)\n# Canonical Claude Code tool names we recognize (closed set — anything not\n# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n# unknown token can never cause a false block).\n_KNOWN_TOOL_NAMES = frozenset({\n    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n})\n# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n# a profile that simply mentions a word does not trip the rail.\n_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n    (\"websearch\", (\"search the web\", \"web search\")),\n)\n_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n\n# --- Rail 2: depth fence ---------------------------------------------------\n_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n    flags=re.MULTILINE,\n)\n\n# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n# Markdown renderer/agent — recognizing them (instead of enumerating\n# taints) keeps the parser aligned with what the agent SEES.\n_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n    flags=re.MULTILINE | re.IGNORECASE,\n)\n# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n# make the line a CommonMark CODE BLOCK — example text, never a grant.\n_CAN_EDIT_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n    flags=re.MULTILINE | re.IGNORECASE,\n)\n# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n# match a CLOSED whitelist of recognized forms — anything else is a\n# visible grant/instruction the parser did not validate => taint.\n_FA_LIST_LINE_RE = re.compile(\n    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n    flags=re.MULTILINE,\n)\n_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n    flags=re.IGNORECASE,\n)\n_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n    r\"|FORBIDDEN\\b\"             # architect forbidden list\n    # canonical template escape-hatch prose — the FULL fixed phrase, so\n    # the prefix CONSUMES its own `edit` and the suffix rule below can\n    # ban any further edit-grant text (codex r34 P1)\n    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n    r\")\",\n    flags=re.IGNORECASE,\n)\n# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n# authority). A token is a whitespace-delimited word stripped of edge\n# punctuation; tokens containing / or . are path-like and never match.\n_FA_AUTHORITY_WORDS = frozenset((\n    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n))\n\n\n# _OVERLAP_LOOKBACK_S is re-exported from agent_spawn.file_assignment below.\n_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n\n\n# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n# ADR-191 cures): read-only intent must be spelled out with this token.\n_FA_READONLY_TOKEN = \"none-read-only\"\n\n# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n# CommonMark) would leak into classification and could satisfy the gate\n# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n# radius; the shared regex serves every other block parser unchanged).\n# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n# Closer must be the SAME character, length >= opener (codex r37 P2:\n# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n# the fence char; closer = \\1 (full opener string) + \\2* (same char\n# only). A shorter/mismatched closer falls through to \\Z — masking to\n# EOF, the fail-CLOSED direction.\n_FA_FENCE_RE = re.compile(\n    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n    flags=re.MULTILINE | re.DOTALL,\n)\n\n# Telemetry marker hash for the explicit read-only declaration. DOMAIN-\n# SEPARATED from real path hashes (codex r1 P2, Lote B): hashing the bare\n# token collided with a legitimate concrete path `./none-read-only` (the\n# token check runs BEFORE ./-normalization, so that path survives as\n# concrete and would hash identically — under CEO_SPAWN_OVERLAP_GUARD=1 it\n# would false-block against every prior read-only spawn). NUL bytes cannot\n# appear in a real declared path, so this input is unreachable from\n# _path_hash(path) space.\n\n\n# ---------------------------------------------------------------------------\n# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [BEGIN]\n# ---------------------------------------------------------------------------\n# NAMED spawns whose task indicates contact with UNTRUSTED CONTENT (web\n# fetch/search, scraping, imported/upstream/third-party material) MUST carry\n# the 6-bullet `## PROMPT DEFENSE` anti-injection block that\n# `.claude/scripts/inject-agent-context.sh` now emits unconditionally.\n#\n# Failure semantics (CLAUDE.md §4 doctrine):\n#   - INPUT side is fail-CLOSED: heuristic matched + section missing/thin\n#     => BLOCK (precedent: check_bash_safety.py `_e3` parse gate + C4).\n#   - INFRASTRUCTURE side is fail-OPEN: any exception inside this gate\n#     => allow (never punish the session for our own bug).\n#\n# Detection is a CONSERVATIVE lowercase-substring keyword set scanned over\n# the sanitized (fence/comment-stripped) description + prompt. HONESTY —\n# documented false negatives, by design:\n#   - synonyms/other languages are missed (\"crawl\", \"harvest\", \"baixar\",\n#     \"read the vendor tarball\", ...);\n#   - obfuscated intents (base64, hyphenation, l33t) are missed;\n#   - keywords appearing ONLY inside fenced code blocks are masked by\n#     `_strip_fenced_and_comments` and therefore missed;\n#   - scan is capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes; mentions beyond\n#     the cap are missed.\n# The cheap mitigation for every miss-class is the same: the spawn template\n# emits the block UNCONDITIONALLY, so any template-generated prompt passes\n# regardless of heuristic reach. This gate exists to catch hand-rolled\n# prompts that bypass the template.\n#\n# Kill-switches (advisory demotion — event still emitted, spawn allowed):\n#   CEO_PROMPT_DEFENSE_GATE=0   per-gate opt-out\n#   CEO_SOTA_DISABLE=1          master kill (E3-rail precedent)\n_PROMPT_DEFENSE_HEADER_RE = re.compile(\n    r\"^##[ \\t]+PROMPT[ \\t]+DEFENSE[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n# A bullet line: \"-\" or \"*\" + whitespace + at least one non-space char.\n_PROMPT_DEFENSE_BULLET_RE = re.compile(\n    r\"^[ \\t]*[-*][ \\t]+\\S\",\n    flags=re.MULTILINE,\n)\n_PROMPT_DEFENSE_MIN_BULLETS = 6\n_PROMPT_DEFENSE_SCAN_CAP = 256 * 1024  # bytes of sanitized text scanned\n# Closed, lowercase substring set. Ordering = report priority (first hit\n# wins; the matched token is the ONLY prompt-derived value that reaches the\n# audit log — closed-enum-safe, no prompt body echo).\n_UNTRUSTED_CONTENT_HINTS: Tuple[str, ...] = (\n    \"webfetch\",\n    \"websearch\",\n    \"web search\",\n    \"search the web\",\n    \"fetch the url\",\n    \"fetch url\",\n    \"fetch http\",\n    \"download from http\",\n    \"scrape\",\n    \"scraping\",\n    \"imported\",\n    \"upstream\",\n    \"third-party\",\n    \"third party\",\n    \"untrusted\",\n)\n\n\ndef _prompt_defense_required(\n    description: str, prompt_sanitized: str\n) -> Optional[str]:\n    \"\"\"Return the first matched untrusted-content hint, or None.\n\n    Pure. Never raises. Bounded scan over lowercase(description + sanitized\n    prompt) capped at `_PROMPT_DEFENSE_SCAN_CAP` bytes.\n    \"\"\"\n    haystack = (\n        (description or \"\") + \"\\n\" + (prompt_sanitized or \"\")\n    )[:_PROMPT_DEFENSE_SCAN_CAP].lower()\n    for hint in _UNTRUSTED_CONTENT_HINTS:\n        if hint in haystack:\n            return hint\n    return None\n\n\ndef _has_prompt_defense_block(prompt_sanitized: str) -> bool:\n    \"\"\"True iff sanitized prompt has `## PROMPT DEFENSE` on its own line\n    with >= `_PROMPT_DEFENSE_MIN_BULLETS` bullet lines before the next\n    `##` heading / EOF. Fence/comment-masked headers do NOT count\n    (P1-SEC-B precedent — caller passes pre-sanitized text).\"\"\"\n    if not prompt_sanitized:\n        return False\n    m = _PROMPT_DEFENSE_HEADER_RE.search(prompt_sanitized)\n    if m is None:\n        return False\n    block_start = m.end()\n    nxt = _NEXT_H2_RE.search(prompt_sanitized, block_start)\n    block = prompt_sanitized[\n        block_start: nxt.start() if nxt else len(prompt_sanitized)\n    ]\n    bullets = len(_PROMPT_DEFENSE_BULLET_RE.findall(block))\n    return bullets >= _PROMPT_DEFENSE_MIN_BULLETS\n\n\ndef _emit_prompt_defense_event(\n    *, keyword: str, present: bool, enforced: bool\n) -> None:\n    \"\"\"Emit `spawn_prompt_defense_gate` telemetry. `keyword` is from the\n    closed `_UNTRUSTED_CONTENT_HINTS` enum — no prompt body ever persists.\n    Fail-open.\"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        _audit_emit.emit_generic(\n            \"spawn_prompt_defense_gate\",\n            keyword=(keyword or \"\")[:32],\n            present=1 if present else 0,\n            enforced=1 if enforced else 0,\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _enforce_prompt_defense(\n    *,\n    description: str,\n    prompt: str,\n    env: Dict[str, str],\n) -> Optional[Tuple[str, str]]:\n    \"\"\"Evaluate the Prompt Defense Baseline gate for a NAMED spawn.\n\n    Returns (reason_code, detail) when the gate is ENFORCING and fires;\n    None otherwise. NEVER raises (infra fail-open); the block itself is\n    the input-side fail-CLOSED posture (matched + missing => BLOCK).\n    \"\"\"\n    try:\n        sanitized = _strip_fenced_and_comments(prompt or \"\")\n        keyword = _prompt_defense_required(description or \"\", sanitized)\n        if keyword is None:\n            return None  # no untrusted-content signal — out of scope\n        present = _has_prompt_defense_block(sanitized)\n        master_off = (env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\"\n        raw = (env.get(\"CEO_PROMPT_DEFENSE_GATE\") or \"\").strip()\n        gate_off = raw in (\"0\", \"false\", \"False\", \"no\", \"off\")\n        enforced = (not master_off) and (not gate_off)\n        _emit_prompt_defense_event(\n            keyword=keyword, present=present, enforced=enforced\n        )\n        if present or not enforced:\n            return None\n        return (\n            \"spawn_prompt_defense_missing\",\n            f\"keyword={keyword} min_bullets={_PROMPT_DEFENSE_MIN_BULLETS}\",\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return None\n","numLines":560,"startLine":1,"totalLines":560}},"tool_result_meta":[{"id":"toolu_01DuPijfkqq8CzFiYZmJms8r","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1MJJcmdmq4UyE4xzeCZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BvReek19kt4nJPeF8yYzEC","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/advisories.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7520,"cache_read_input_tokens":94146,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7520},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"55dfad48-4e81-44fa-83f0-754d21d6ea96","timestamp":"2026-11-13T17:50:44.023Z","request_id":"req_011Ch1MJJCUd6esELXmBo84f","wire_tool_inputs":{"toolu_01BvReek19kt4nJPeF8yYzEC":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/advisories.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BvReek19kt4nJPeF8yYzEC","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport re\n4\t\n5\t__all__ = ('_consult_model_routing_mode', '_MCP_ARCHETYPE_TASK_CLASS_HINTS', '_PROMOTION_ARCHETYPE_HINTS', '_emit_mcp_routing_advisory', '_emit_promotion_advisory', '_emit_advisory_safe', '_PERSONA_HEADER_RE', '_SKILL_CONTENT_MARKER', '_SKILL_CONTENT_MIN_BYTES', '_SKILL_CONTENT_MARKER_RE', '_NEXT_H2_RE', '_CODE_FENCE_RE', '_HTML_COMMENT_RE', '_SPEC_CONTEXT_HEADER_RE', '_sanitize_spec_context_advisory', '_enforce_spec_context_unicode', '_unicode_hardblock_enforced', '_emit_spawn_confidence_advisory')\n6\t\n7\t# ---------------------------------------------------------------------------\n8\t# PLAN-112-FOLLOWUP-persona-routing-wire W1+W2+W3 — god-mode matrix consult.\n9\t# ---------------------------------------------------------------------------\n10\t# Consult ALL THREE persona_routing APIs (AC1):\n11\t# `get_mode(archetype, \"AUTO-05\")` (recorded mode label) +\n12\t# `is_enforcing(archetype, \"AUTO-05\")` (authoritative effective-enforcing\n13\t# boolean that drives `decision`) + `is_killswitch_active()` (records the\n14\t# kill-switch state) and EMIT the resulting mode as forensic telemetry\n15\t# (`model_routing_enforced`). This closes the F-1.2 dead-policy (the\n16\t# AUTO-05 enforcing cell was never read at runtime).\n17\t#\n18\t# W3 — DEFERRED BLOCK + FLIP DOCTRINE:\n19\t#   The actual model-tier BLOCK is DEFERRED. A \"model mismatch -> block\"\n20\t#   predicate needs the dispatched/requested model, but the Agent hook\n21\t#   payload exposes only description/prompt/subagent_type/run_in_background\n22\t#   (SPEC/v1/hook-io.schema.md). `metadata.get(\"model\")` (read in\n23\t#   `_read_archetype_model_frontmatter`) is the AGENT FRONTMATTER model, NOT\n24\t#   a spawn-requested model. With no requested-model input, a block would be\n25\t#   theater. When the harness exposes the dispatched model to PreToolUse, the\n26\t#   violation predicate becomes a 1-liner: fm_model present AND requested\n27\t#   present AND differing.\n28\t#   The future enable of that block is governed by OBSERVED-VIOLATION VOLUME\n29\t#   + a false-positive-rate threshold, NOT by elapsed calendar days\n30\t#   (ADR-095 / [[feedback-no-calendar-gates-ai-workflow]]). Recorded here as\n31\t#   the flip doctrine for a future ADR-118-AMEND-2.\n32\t#\n33\t# SECURITY INVARIANTS:\n34\t#   - Mode is read off the AUTHORITATIVE `subagent_type`-derived archetype\n35\t#     ONLY — NEVER the prompt-regex archetype (attacker-controllable; a\n36\t#     spoofed archetype must not flip the recorded mode). CWE-400/spoofing.\n37\t#   - Fail-OPEN: import/get_mode failure -> emit `model_routing_eval_error`\n38\t#     and return; NEVER raise in the hook hot path (CLAUDE.md §5).\n39\t#   - Kill-switch precedence: get_mode() already demotes an enforcing cell\n40\t#     to advisory under `CEO_GODMODE_ENFORCING=0`; we record the demoted\n41\t#     mode (advisory) so the audit reflects effective policy.\n42\tdef _consult_model_routing_mode(\n43\t    *,\n44\t    description: str,\n45\t    prompt: str,\n46\t    subagent_type: str,\n47\t    env: Optional[Dict[str, str]] = None,\n48\t    project_dir: Optional[str] = None,\n49\t) -> None:\n50\t    \"\"\"Consult the god-mode routing matrix + emit forensic telemetry.\n51\t\n52\t    CONSULT + AUDIT ONLY. NEVER blocks, NEVER mutates tool_input, NEVER\n53\t    raises. Consults all THREE persona_routing APIs (AC1): `get_mode`\n54\t    (recorded mode label), `is_enforcing` (authoritative effective-\n55\t    enforcing boolean that drives `decision`), and `is_killswitch_active`.\n56\t    Emits `model_routing_enforced` (mode/recommended_model/\n57\t    killswitch_armed/decision) on success, `model_routing_eval_error`\n58\t    (decision=eval_error) on any infra failure (fail-open).\n59\t    \"\"\"\n60\t    try:\n61\t        src_env = env if env is not None else os.environ\n62\t        if not _AUDIT_EMIT_AVAILABLE:\n63\t            return  # nothing to audit against; consult is observability-only\n64\t\n65\t        # AUTHORITATIVE source ONLY — subagent_type. A prompt-regex archetype\n66\t        # is attacker-controllable and must not flip the recorded mode.\n67\t        archetype = (subagent_type or \"\").strip().lower()\n68\t        if not archetype:\n69\t            return  # no authoritative archetype -> no mode to record\n70\t\n71\t        session_id = src_env.get(\"CLAUDE_SESSION_ID\", \"\") or \"\"\n72\t        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n73\t\n74\t        # Fail-OPEN guard around the matrix consult.\n75\t        try:\n76\t            if _persona_routing is None:\n77\t                raise RuntimeError(\"persona_routing import unavailable\")\n78\t            # NEVER read _PRIMITIVE_DEFAULT_MODE directly — get_mode /\n79\t            # is_enforcing honor the kill-switch demotion internally.\n80\t            # All THREE persona_routing APIs are consulted (AC1):\n81\t            #   - get_mode      -> the effective (possibly demoted) mode label\n82\t            #                      recorded verbatim in the emit\n83\t            #   - is_enforcing  -> the AUTHORITATIVE effective-enforcing boolean\n84\t            #                      that drives `decision` (kill-switch already\n85\t            #                      folded in: returns False when demoted)\n86\t            #   - is_killswitch_active -> records whether the kill-switch armed\n87\t            mode = _persona_routing.get_mode(archetype, \"AUTO-05\")\n88\t            is_enforcing = bool(\n89\t                _persona_routing.is_enforcing(archetype, \"AUTO-05\")\n90\t            )\n91\t            killswitch_armed = bool(_persona_routing.is_killswitch_active())\n92\t        except Exception:  # noqa: BLE001 — fail-open per CLAUDE.md §5\n93\t            try:\n94\t                _audit_emit.emit_generic(\n95\t                    \"model_routing_eval_error\",\n96\t                    archetype=archetype[:64],\n97\t                    reason_code=\"persona_routing_eval_failed\",\n98\t                    decision=\"eval_error\",\n99\t                    session_id=session_id,\n100\t                    project=str(proj)[:256],\n101\t                )\n102\t            except Exception:  # noqa: BLE001\n103\t                pass\n104\t            return\n105\t\n106\t        # recommended_model: best-effort authoritative agent-frontmatter\n107\t        # model for this archetype (NOT a spawn-requested model). \"\" when\n108\t        # absent. Reuses the cached frontmatter reader.\n109\t        recommended_model = \"\"\n110\t        try:\n111\t            agents_dir = Path(proj) / \".claude\" / \"agents\"\n112\t            fm_model, _conf = _read_archetype_model_frontmatter(\n113\t                archetype, agents_dir\n114\t            )\n115\t            recommended_model = (fm_model or \"\")[:64]\n116\t        except Exception:  # noqa: BLE001 — telemetry enrichment is optional\n117\t            recommended_model = \"\"\n118\t\n119\t        # decision enum: enforce_telemetry | advisory | eval_error.\n120\t        # NO `block` value — block deferred (§2.4). Derived from the\n121\t        # AUTHORITATIVE is_enforcing() boolean (NOT a re-derivation from\n122\t        # the `mode` string), so the kill-switch demotion already folded\n123\t        # into is_enforcing() drives the decision. `mode` (possibly\n124\t        # demoted to \"advisory\" by get_mode) is still recorded verbatim.\n125\t        decision = \"enforce_telemetry\" if is_enforcing else \"advisory\"\n126\t\n127\t        try:\n128\t            _audit_emit.emit_generic(\n129\t                \"model_routing_enforced\",\n130\t                archetype=archetype[:64],\n131\t                mode=str(mode)[:16],\n132\t                recommended_model=recommended_model,\n133\t                killswitch_armed=killswitch_armed,\n134\t                decision=decision,\n135\t                session_id=session_id,\n136\t                project=str(proj)[:256],\n137\t            )\n138\t        except Exception:  # noqa: BLE001 — fail-open\n139\t            return\n140\t    except Exception:  # pragma: no cover — fail-open invariant\n141\t        return\n142\t\n143\t\n144\t# PLAN-091 Wave A.4 (W3.1) — archetype → mcp_routing task_class heuristic.\n145\t#\n146\t# Maps the spawn's archetype to one of the 4 task_class strings declared in\n147\t# `_lib/mcp_routing._ROUTING_TABLE`. mcp_routing.resolve() emits its own\n148\t# `mcp_route_advised` advisory (PLAN-086 Wave D) — the spawn-hook wire only\n149\t# needs to trigger the resolver at the right callsite. NO mapping fallthrough\n150\t# = NO emit (advisory-only; avoid noise on every spawn).\n151\t_MCP_ARCHETYPE_TASK_CLASS_HINTS: Tuple[Tuple[Tuple[str, ...], str], ...] = (\n152\t    # ORDER MATTERS — first match wins. More-specific archetype slugs\n153\t    # (finops/seo/crypto) come BEFORE the bare \"architect\" pattern so\n154\t    # composite slugs like \"llm-finops-architect\" or \"crypto-research-\n155\t    # analyst\" route to the more specific MCP server bundle.\n156\t    ((\"finops\", \"cost\", \"budget\"), \"finops\"),\n157\t    ((\"seo\", \"ahrefs\", \"similarweb\"), \"seo_research\"),\n158\t    ((\"crypto\", \"lunarcrush\", \"blockchain\"), \"crypto_research\"),\n159\t    ((\"architect\", \"arch-\"), \"arch\"),\n160\t)\n161\t\n162\t\n163\t# PLAN-091 Wave A.5 (W3.3) — archetype-hint patterns triggering a\n164\t# `specialization_promoted` advisory when subagent_type == general-purpose.\n165\t# Match is FIRST-HIT, not exhaustive — keeps emit volume bounded. Hints\n166\t# are lowercase substring matches on (description + prompt).\n167\t_PROMOTION_ARCHETYPE_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n168\t    (\"performance-engineer\",\n169\t     (\"latency\", \"p95\", \"p99\", \"profile\", \"memory leak\", \"throughput\",\n170\t      \"gc tuning\", \"hot path\")),\n171\t    (\"security-engineer\",\n172\t     (\"jwt\", \"oauth\", \"authentication\", \"vulnerability\", \"owasp\",\n173\t      \"xss\", \"sql injection\", \"csrf\", \"rate limiting\")),\n174\t    (\"qa-architect\",\n175\t     (\"test strategy\", \"mutation testing\", \"flake\", \"regression\",\n176\t      \"property-based\", \"fuzz\", \"contract test\")),\n177\t    (\"code-reviewer\",\n178\t     (\"merge gate\", \"code review\", \"veto\", \"review checklist\")),\n179\t    (\"incident-commander\",\n180\t     (\"incident commander\", \"severity classification\", \"all-clear\",\n181\t      \"paging policy\", \"post-incident review\")),\n182\t    (\"identity-trust-architect\",\n183\t     (\"token rotation\", \"session lifecycle\", \"rbac\", \"abac\",\n184\t      \"service-to-service trust\", \"mtls\")),\n185\t    (\"threat-detection-engineer\",\n186\t     (\"mitre att&ck\", \"siem rule\", \"detection rule\", \"alert deduplication\",\n187\t      \"purple team\", \"threat hunting\")),\n188\t    (\"devops\",\n189\t     (\"github actions\", \"sha-pin\", \"ci/cd pipeline\", \"rollback strategy\",\n190\t      \"secret rotation\")),\n191\t)\n192\t\n193\t\n194\tdef _emit_mcp_routing_advisory(\n195\t    *,\n196\t    description: str,\n197\t    prompt: str,\n198\t    subagent_type: str,\n199\t    env: Optional[Dict[str, str]] = None,\n200\t) -> None:\n201\t    \"\"\"PLAN-091 Wave A.4 (W3.1) — emit `mcp_route_advised` for this spawn.\n202\t\n203\t    Derives task_class from the spawn's archetype via the\n204\t    ``_MCP_ARCHETYPE_TASK_CLASS_HINTS`` table, then delegates to\n205\t    ``_lib/mcp_routing.resolve()`` which performs its own emit (per\n206\t    PLAN-086 Wave D). Bypass: ``CEO_MCP_ROUTING_HOOK=0`` (parallel to\n207\t    PLAN-078 model-routing bypass; per-server kill switches live inside\n208\t    mcp_routing.resolve()).\n209\t\n210\t    NEVER raises. Advisory-only — never mutates tool_input, never blocks.\n211\t    \"\"\"\n212\t    try:\n213\t        src_env = env if env is not None else os.environ\n214\t        if (src_env.get(\"CEO_MCP_ROUTING_HOOK\") or \"\").strip() == \"0\":\n215\t            return\n216\t        archetype = _extract_archetype_from_payload(\n217\t            description or \"\", prompt or \"\", subagent_type or \"\"\n218\t        )\n219\t        if not archetype:\n220\t            return\n221\t        archetype_lc = archetype.lower()\n222\t        task_class: Optional[str] = None\n223\t        for hints, mapped in _MCP_ARCHETYPE_TASK_CLASS_HINTS:\n224\t            if any(h in archetype_lc for h in hints):\n225\t                task_class = mapped\n226\t                break\n227\t        if task_class is None:\n228\t            return  # no mapping; emit volume stays bounded\n229\t        try:\n230\t            from _lib import mcp_routing as _mcpr  # type: ignore\n231\t            _mcpr.resolve(task_class)  # resolver fires advisory emit\n232\t        except Exception:  # pragma: no cover - fail-open\n233\t            return\n234\t    except Exception:  # pragma: no cover - fail-open\n235\t        return\n236\t\n237\t\n238\tdef _emit_promotion_advisory(\n239\t    *,\n240\t    description: str,\n241\t    prompt: str,\n242\t    subagent_type: str,\n243\t    env: Optional[Dict[str, str]] = None,\n244\t) -> None:\n245\t    \"\"\"PLAN-091 Wave A.5 (W3.3) — emit `specialization_promoted` when a\n246\t    ``general-purpose`` spawn matches a specialist archetype heuristic.\n247\t\n248\t    Advisory ONLY — does NOT auto-spawn the suggested specialist. Records\n249\t    the suggestion in audit log so PLAN-094+ can promote SEMI to AUTO once\n250\t    confidence is established. Bypass: ``CEO_PROMOTION_HEURISTIC=0``.\n251\t\n252\t    First-hit match wins (bounded emit volume). NEVER raises.\n253\t    \"\"\"\n254\t    try:\n255\t        src_env = env if env is not None else os.environ\n256\t        if (src_env.get(\"CEO_PROMOTION_HEURISTIC\") or \"\").strip() == \"0\":\n257\t            return\n258\t        if (subagent_type or \"\").strip().lower() != \"general-purpose\":\n259\t            return\n260\t        if not _AUDIT_EMIT_AVAILABLE:\n261\t            return\n262\t        text = ((description or \"\") + \"\\n\" + (prompt or \"\")).lower()\n263\t        text = text[: 8 * 1024]  # 8KiB cap on hint-scan window\n264\t        for suggested, hints in _PROMOTION_ARCHETYPE_HINTS:\n265\t            for hint in hints:\n266\t                if hint in text:\n267\t                    try:\n268\t                        # PLAN-088 R2 iter-2 STRICKEN specialization_promoted\n269\t                        # as separate action; routed via mcp_route_advised\n270\t                        # with signal_source discriminator per audit_emit.py\n271\t                        # 5099-5105 contract.\n272\t                        _audit_emit.emit_generic(\n273\t                            \"mcp_route_advised\",\n274\t                            session_id=\"\",\n275\t                            task_class=\"promotion\",\n276\t                            suggested_servers=suggested[:64],\n277\t                            kill_switch_overrides=\"\",\n278\t                            signal_source=\"specialization_promoted\",\n279\t                        )\n280\t                    except Exception:  # pragma: no cover - fail-open\n281\t                        pass\n282\t                    return  # first-hit wins\n283\t    except Exception:  # pragma: no cover - fail-open\n284\t        return\n285\t\n286\t\n287\tdef _emit_advisory_safe(\n288\t    *,\n289\t    archetype: str,\n290\t    task_type: str,\n291\t    model_recommended: str,\n292\t    confidence: float,\n293\t    applied_or_skipped: str,\n294\t    override_reason: str,\n295\t) -> None:\n296\t    \"\"\"Wrapper around audit_emit.emit_generic for `model_routing_advised`.\n297\t\n298\t    Allowlist enforced by audit_emit dispatcher (defense-in-depth). Caller\n299\t    only fills the 6 contract fields; ts/session/project added by emit_generic.\n300\t\n301\t    Codex W1+W2 fix-pack #2: ``confidence`` (float 0..1) is converted at\n302\t    emission time to ``confidence_basis_points`` (int 0..1000) — floats\n303\t    are forbidden in HMAC-covered fields (canonical_json invariant). The\n304\t    in-process API surface still accepts ``confidence: float`` for\n305\t    ergonomic continuity; conversion is colocated with the emit call.\n306\t    \"\"\"\n307\t    try:\n308\t        if not _AUDIT_EMIT_AVAILABLE:\n309\t            return\n310\t        # Convert float confidence -> int basis-points. NaN / out-of-range\n311\t        # collapse to 0 (lower clamp in audit_emit emitter).\n312\t        try:\n313\t            conf_f = float(confidence)\n314\t        except (TypeError, ValueError):\n315\t            conf_f = 0.0\n316\t        if conf_f != conf_f or conf_f in (float(\"inf\"), float(\"-inf\")):\n317\t            conf_f = 0.0\n318\t        if conf_f < 0.0:\n319\t            conf_f = 0.0\n320\t        if conf_f > 1.0:\n321\t            conf_f = 1.0\n322\t        confidence_bp = int(round(conf_f * 1000.0))\n323\t        # Length-bound caller strings (defense-in-depth on adopter drift).\n324\t        _audit_emit.emit_generic(\n325\t            \"model_routing_advised\",\n326\t            archetype=(archetype or \"\")[:64],\n327\t            task_type=(task_type or \"\")[:32],\n328\t            model_recommended=(model_recommended or \"\")[:64],\n329\t            confidence_basis_points=confidence_bp,\n330\t            applied_or_skipped=(applied_or_skipped or \"\")[:64],\n331\t            override_reason=(override_reason or \"\")[:128],\n332\t        )\n333\t    except Exception:  # pragma: no cover - fail-open\n334\t        return\n335\t\n336\t\n337\t# Persona header patterns — must appear at the START of a line.\n338\t_PERSONA_HEADER_RE = re.compile(\n339\t    r\"^(?:PERSONA:|## AGENT PROFILE|## PERSONA)\",\n340\t    flags=re.MULTILINE,\n341\t)\n342\t\n343\t# Governance requirement: named spawns must include this literal section.\n344\t_SKILL_CONTENT_MARKER = \"## SKILL CONTENT\"\n345\t\n346\t# PLAN-019 Phase 2B P1-SEC-B — minimum body size (non-whitespace bytes)\n347\t# required between `## SKILL CONTENT` and the next `##` heading / EOF for\n348\t# the marker to count as a real skill-content section. Rejects empty-body,\n349\t# stub-only, or single-line \"see file X\" shells.\n350\t_SKILL_CONTENT_MIN_BYTES = 256\n351\t\n352\t# Regex to find the marker ON ITS OWN LINE (ignoring trailing whitespace).\n353\t_SKILL_CONTENT_MARKER_RE = re.compile(\n354\t    r\"^## SKILL CONTENT[ \\t]*$\",\n355\t    flags=re.MULTILINE,\n356\t)\n357\t\n358\t# Regex to find the next `##`-level heading (to bound the body extraction).\n359\t_NEXT_H2_RE = re.compile(r\"^##[ \\t]\", flags=re.MULTILINE)\n360\t\n361\t# Code-fence markers (``` or ~~~ with optional language tag).\n362\t_CODE_FENCE_RE = re.compile(r\"^(?:```|~~~)\", flags=re.MULTILINE)\n363\t\n364\t# HTML comment pair — non-greedy across lines.\n365\t_HTML_COMMENT_RE = re.compile(r\"<!--.*?-->\", flags=re.DOTALL)\n366\t\n367\t# Regex to extract ## SPEC CONTEXT block content (between its header and next\n368\t# ## heading or EOF). Used by _sanitize_spec_context_advisory() below.\n369\t_SPEC_CONTEXT_HEADER_RE = re.compile(\n370\t    r\"^##[ \\t]+SPEC[ \\t]+CONTEXT[ \\t]*$\",\n371\t    flags=re.MULTILINE,\n372\t)\n373\t\n374\t\n375\tdef _sanitize_spec_context_advisory(prompt: str, env=None) -> None:\n376\t    \"\"\"PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n377\t    payload and emit telemetry advisory.\n378\t\n379\t    Extracts the ## SPEC CONTEXT block from the spawn prompt, runs it\n380\t    through spec_context_sanitizer.sanitize(), and emits a\n381\t    `spec_context_sanitized` audit-emit event so sentinel violations,\n382\t    truncation, and control-char counts are observable.\n383\t\n384\t    ADVISORY ONLY — never blocks the spawn. Fail-open on any exception.\n385\t    Kill-switch: CEO_SPEC_CTX_SANITIZER_ENABLED=0.\n386\t    \"\"\"\n387\t    try:\n388\t        if not _SPEC_CTX_SANITIZER_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n389\t            return\n390\t        src_env = env if env is not None else os.environ\n391\t        val = (src_env.get(\"CEO_SPEC_CTX_SANITIZER_ENABLED\") or \"1\").strip()\n392\t        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n393\t            return\n394\t        if not prompt:\n395\t            return\n396\t        # Extract ## SPEC CONTEXT block content\n397\t        m = _SPEC_CONTEXT_HEADER_RE.search(prompt)\n398\t        if m is None:\n399\t            return  # no SPEC CONTEXT block — nothing to sanitize\n400\t        block_start = m.end()\n401\t        next_h2 = _NEXT_H2_RE.search(prompt, block_start)\n402\t        block_end = next_h2.start() if next_h2 else len(prompt)\n403\t        spec_payload = prompt[block_start:block_end]\n404\t\n405\t        result = _spec_ctx_sanitizer.sanitize(spec_payload)\n406\t\n407\t        # Emit telemetry (advisory only; sentinel violations logged for CEO)\n408\t        try:\n409\t            _audit_emit.emit_generic(\n410\t                \"spec_context_sanitized\",\n411\t                original_bytes=result.original_bytes,\n412\t                cleaned_bytes=result.cleaned_bytes,\n413\t                truncated=1 if result.truncated else 0,\n414\t                sentinel_violations=len(result.sentinel_violations),\n415\t                control_chars_stripped=result.control_chars_stripped,\n416\t                bidi_zw_chars_stripped=result.bidi_zw_chars_stripped,\n417\t                # PLAN-133 A2 — surface the Tag-block count too (allowlisted in\n418\t                # audit_emit §7d). Harmless if the SanitizeResult lacks the field\n419\t                # (getattr default 0) so this stays import-order tolerant.\n420\t                tag_chars_stripped=getattr(result, \"tag_chars_stripped\", 0),\n421\t                header_escape_count=result.header_escape_count,\n422\t            )\n423\t        except Exception:  # pragma: no cover - fail-open\n424\t            pass\n425\t    except Exception:  # pragma: no cover - fail-open\n426\t        return\n427\t\n428\t\n429\tdef _enforce_spec_context_unicode(prompt: str, env=None):\n430\t    \"\"\"PLAN-133 A2 — fail-CLOSED invisible-unicode guard on the spawn prompt.\n431\t\n432\t    Scans the WHOLE spawn prompt (not just the ## SPEC CONTEXT block — an attacker\n433\t    can smuggle Tag-block/bidi chars anywhere in the named-spawn body) for invisible\n434\t    /smuggling unicode (control / bidi / zero-width / U+E0000-E007F Tag-block).\n435\t\n436\t    Default-OFF (doctrine #1): the BLOCK fires only when CEO_UNICODE_HARDBLOCK=='1'\n437\t    in the import-time trusted_env snapshot. Otherwise advisory — the breadcrumb is\n438\t    emitted with enforced=0 (measure-first) and None is returned (no block).\n439\t\n440\t    Returns a block-reason string when enforced AND a detection fires, else None.\n441\t    Fail-OPEN on any infra exception (never blocks the session on a scanner bug).\n442\t    Master kill: CEO_SOTA_DISABLE=1 forces advisory.\n443\t    \"\"\"\n444\t    try:\n445\t        if not _SPEC_CTX_SANITIZER_AVAILABLE:\n446\t            return None\n447\t        src_env = env if env is not None else os.environ\n448\t        if not prompt:\n449\t            return None\n450\t        # Default-OFF flag, read from the trusted_env snapshot when available so a\n451\t        # late-set value can't toggle enforcement mid-process. Master kill wins.\n452\t        if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n453\t            enforce = False\n454\t        else:\n455\t            enforce = _unicode_hardblock_enforced(src_env)\n456\t\n457\t        result = _spec_ctx_sanitizer.sanitize(prompt)\n458\t        count = _spec_ctx_sanitizer.invisible_unicode_count(result)\n459\t        if count <= 0:\n460\t            return None  # clean — nothing to do\n461\t\n462\t        unicode_class = _spec_ctx_sanitizer.classify_invisible_unicode(result)\n463\t\n464\t        # Emit the closed-enum breadcrumb on BOTH advisory and enforced paths\n465\t        # (the denominator must be real from day one — no 0/0/0 trap).\n466\t        if _AUDIT_EMIT_AVAILABLE:\n467\t            try:\n468\t                _audit_emit.emit_generic(\n469\t                    \"invisible_unicode_blocked\",\n470\t                    surface=\"spawn\",\n471\t                    unicode_class=unicode_class,\n472\t                    char_count=int(count),\n473\t                    enforced=1 if enforce else 0,\n474\t                )\n475\t            except Exception:  # pragma: no cover - fail-open\n476\t                pass\n477\t\n478\t        if not enforce:\n479\t            return None  # advisory only\n480\t\n481\t        return (\n482\t            \"GOVERNANCE: invisible_unicode_blocked: the spawn prompt contains \"\n483\t            f\"{count} invisible/smuggling character(s) (class={unicode_class}: \"\n484\t            \"control / bidi / zero-width / Unicode-Tags-block). These are \"\n485\t            \"removed by the sanitizer and rejected fail-CLOSED before review. \"\n486\t            \"Remove the hidden characters and re-spawn. To run advisory-only, \"\n487\t            \"unset CEO_UNICODE_HARDBLOCK.\"\n488\t        )\n489\t    except Exception:  # pragma: no cover - fail-open invariant\n490\t        return None\n491\t\n492\t\n493\tdef _unicode_hardblock_enforced(src_env) -> bool:\n494\t    \"\"\"True iff CEO_UNICODE_HARDBLOCK=='1' (PLAN-133 A2). Prefers the trusted_env\n495\t    snapshot; falls back to the passed env dict. Pure; never raises.\"\"\"\n496\t    try:\n497\t        from _lib import trusted_env as _te  # noqa: E402\n498\t        val = _te.get_trusted(\"CEO_UNICODE_HARDBLOCK\")\n499\t        if val is not None:\n500\t            return (val or \"\").strip() == \"1\"\n501\t    except Exception:  # pragma: no cover\n502\t        pass\n503\t    return (src_env.get(\"CEO_UNICODE_HARDBLOCK\") or \"\").strip() == \"1\"\n504\t\n505\t\n506\tdef _emit_spawn_confidence_advisory(\n507\t    *,\n508\t    action_type: str,\n509\t    is_named_spawn: bool,\n510\t    env=None,\n511\t) -> None:\n512\t    \"\"\"PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n513\t\n514\t    Classifies the spawn as an action and emits `spawn_confidence_advisory`\n515\t    so recommender / receipt formatter surfaces have a hook-level confidence\n516\t    signal for governance dashboards.\n517\t\n518\t    ADVISORY ONLY — never blocks. Fail-open on any exception.\n519\t    Kill-switch: CEO_SPAWN_CONFIDENCE_ENABLED=0.\n520\t    \"\"\"\n521\t    try:\n522\t        if not _CONFIDENCE_LABELS_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n523\t            return\n524\t        src_env = env if env is not None else os.environ\n525\t        val = (src_env.get(\"CEO_SPAWN_CONFIDENCE_ENABLED\") or \"1\").strip()\n526\t        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n527\t            return\n528\t\n529\t        ctx = {\"canonical\": False}\n530\t        conf = _confidence_labels.classify(action_type, ctx)\n531\t        marker = _confidence_labels.as_emoji_free_marker(conf)\n532\t\n533\t        try:\n534\t            _audit_emit.emit_generic(\n535\t                \"spawn_confidence_advisory\",\n536\t                action_type=(action_type or \"\")[:32],\n537\t                confidence_level=(conf.level or \"\")[:32],\n538\t                confidence_marker=(marker or \"\")[:32],\n539\t                reason_code=(conf.reason_code or \"\")[:64],\n540\t                is_named_spawn=1 if is_named_spawn else 0,\n541\t            )\n542\t        except Exception:  # pragma: no cover - fail-open\n543\t            pass\n544\t    except Exception:  # pragma: no cover - fail-open\n545\t        return\n546\t"}]},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"074beecb-0755-4dd4-a575-498e742856f0","timestamp":"2026-11-13T17:50:44.041Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/advisories.py","content":"from __future__ import annotations\n\nimport re\n\n__all__ = ('_consult_model_routing_mode', '_MCP_ARCHETYPE_TASK_CLASS_HINTS', '_PROMOTION_ARCHETYPE_HINTS', '_emit_mcp_routing_advisory', '_emit_promotion_advisory', '_emit_advisory_safe', '_PERSONA_HEADER_RE', '_SKILL_CONTENT_MARKER', '_SKILL_CONTENT_MIN_BYTES', '_SKILL_CONTENT_MARKER_RE', '_NEXT_H2_RE', '_CODE_FENCE_RE', '_HTML_COMMENT_RE', '_SPEC_CONTEXT_HEADER_RE', '_sanitize_spec_context_advisory', '_enforce_spec_context_unicode', '_unicode_hardblock_enforced', '_emit_spawn_confidence_advisory')\n\n# ---------------------------------------------------------------------------\n# PLAN-112-FOLLOWUP-persona-routing-wire W1+W2+W3 — god-mode matrix consult.\n# ---------------------------------------------------------------------------\n# Consult ALL THREE persona_routing APIs (AC1):\n# `get_mode(archetype, \"AUTO-05\")` (recorded mode label) +\n# `is_enforcing(archetype, \"AUTO-05\")` (authoritative effective-enforcing\n# boolean that drives `decision`) + `is_killswitch_active()` (records the\n# kill-switch state) and EMIT the resulting mode as forensic telemetry\n# (`model_routing_enforced`). This closes the F-1.2 dead-policy (the\n# AUTO-05 enforcing cell was never read at runtime).\n#\n# W3 — DEFERRED BLOCK + FLIP DOCTRINE:\n#   The actual model-tier BLOCK is DEFERRED. A \"model mismatch -> block\"\n#   predicate needs the dispatched/requested model, but the Agent hook\n#   payload exposes only description/prompt/subagent_type/run_in_background\n#   (SPEC/v1/hook-io.schema.md). `metadata.get(\"model\")` (read in\n#   `_read_archetype_model_frontmatter`) is the AGENT FRONTMATTER model, NOT\n#   a spawn-requested model. With no requested-model input, a block would be\n#   theater. When the harness exposes the dispatched model to PreToolUse, the\n#   violation predicate becomes a 1-liner: fm_model present AND requested\n#   present AND differing.\n#   The future enable of that block is governed by OBSERVED-VIOLATION VOLUME\n#   + a false-positive-rate threshold, NOT by elapsed calendar days\n#   (ADR-095 / [[feedback-no-calendar-gates-ai-workflow]]). Recorded here as\n#   the flip doctrine for a future ADR-118-AMEND-2.\n#\n# SECURITY INVARIANTS:\n#   - Mode is read off the AUTHORITATIVE `subagent_type`-derived archetype\n#     ONLY — NEVER the prompt-regex archetype (attacker-controllable; a\n#     spoofed archetype must not flip the recorded mode). CWE-400/spoofing.\n#   - Fail-OPEN: import/get_mode failure -> emit `model_routing_eval_error`\n#     and return; NEVER raise in the hook hot path (CLAUDE.md §5).\n#   - Kill-switch precedence: get_mode() already demotes an enforcing cell\n#     to advisory under `CEO_GODMODE_ENFORCING=0`; we record the demoted\n#     mode (advisory) so the audit reflects effective policy.\ndef _consult_model_routing_mode(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n    project_dir: Optional[str] = None,\n) -> None:\n    \"\"\"Consult the god-mode routing matrix + emit forensic telemetry.\n\n    CONSULT + AUDIT ONLY. NEVER blocks, NEVER mutates tool_input, NEVER\n    raises. Consults all THREE persona_routing APIs (AC1): `get_mode`\n    (recorded mode label), `is_enforcing` (authoritative effective-\n    enforcing boolean that drives `decision`), and `is_killswitch_active`.\n    Emits `model_routing_enforced` (mode/recommended_model/\n    killswitch_armed/decision) on success, `model_routing_eval_error`\n    (decision=eval_error) on any infra failure (fail-open).\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if not _AUDIT_EMIT_AVAILABLE:\n            return  # nothing to audit against; consult is observability-only\n\n        # AUTHORITATIVE source ONLY — subagent_type. A prompt-regex archetype\n        # is attacker-controllable and must not flip the recorded mode.\n        archetype = (subagent_type or \"\").strip().lower()\n        if not archetype:\n            return  # no authoritative archetype -> no mode to record\n\n        session_id = src_env.get(\"CLAUDE_SESSION_ID\", \"\") or \"\"\n        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n\n        # Fail-OPEN guard around the matrix consult.\n        try:\n            if _persona_routing is None:\n                raise RuntimeError(\"persona_routing import unavailable\")\n            # NEVER read _PRIMITIVE_DEFAULT_MODE directly — get_mode /\n            # is_enforcing honor the kill-switch demotion internally.\n            # All THREE persona_routing APIs are consulted (AC1):\n            #   - get_mode      -> the effective (possibly demoted) mode label\n            #                      recorded verbatim in the emit\n            #   - is_enforcing  -> the AUTHORITATIVE effective-enforcing boolean\n            #                      that drives `decision` (kill-switch already\n            #                      folded in: returns False when demoted)\n            #   - is_killswitch_active -> records whether the kill-switch armed\n            mode = _persona_routing.get_mode(archetype, \"AUTO-05\")\n            is_enforcing = bool(\n                _persona_routing.is_enforcing(archetype, \"AUTO-05\")\n            )\n            killswitch_armed = bool(_persona_routing.is_killswitch_active())\n        except Exception:  # noqa: BLE001 — fail-open per CLAUDE.md §5\n            try:\n                _audit_emit.emit_generic(\n                    \"model_routing_eval_error\",\n                    archetype=archetype[:64],\n                    reason_code=\"persona_routing_eval_failed\",\n                    decision=\"eval_error\",\n                    session_id=session_id,\n                    project=str(proj)[:256],\n                )\n            except Exception:  # noqa: BLE001\n                pass\n            return\n\n        # recommended_model: best-effort authoritative agent-frontmatter\n        # model for this archetype (NOT a spawn-requested model). \"\" when\n        # absent. Reuses the cached frontmatter reader.\n        recommended_model = \"\"\n        try:\n            agents_dir = Path(proj) / \".claude\" / \"agents\"\n            fm_model, _conf = _read_archetype_model_frontmatter(\n                archetype, agents_dir\n            )\n            recommended_model = (fm_model or \"\")[:64]\n        except Exception:  # noqa: BLE001 — telemetry enrichment is optional\n            recommended_model = \"\"\n\n        # decision enum: enforce_telemetry | advisory | eval_error.\n        # NO `block` value — block deferred (§2.4). Derived from the\n        # AUTHORITATIVE is_enforcing() boolean (NOT a re-derivation from\n        # the `mode` string), so the kill-switch demotion already folded\n        # into is_enforcing() drives the decision. `mode` (possibly\n        # demoted to \"advisory\" by get_mode) is still recorded verbatim.\n        decision = \"enforce_telemetry\" if is_enforcing else \"advisory\"\n\n        try:\n            _audit_emit.emit_generic(\n                \"model_routing_enforced\",\n                archetype=archetype[:64],\n                mode=str(mode)[:16],\n                recommended_model=recommended_model,\n                killswitch_armed=killswitch_armed,\n                decision=decision,\n                session_id=session_id,\n                project=str(proj)[:256],\n            )\n        except Exception:  # noqa: BLE001 — fail-open\n            return\n    except Exception:  # pragma: no cover — fail-open invariant\n        return\n\n\n# PLAN-091 Wave A.4 (W3.1) — archetype → mcp_routing task_class heuristic.\n#\n# Maps the spawn's archetype to one of the 4 task_class strings declared in\n# `_lib/mcp_routing._ROUTING_TABLE`. mcp_routing.resolve() emits its own\n# `mcp_route_advised` advisory (PLAN-086 Wave D) — the spawn-hook wire only\n# needs to trigger the resolver at the right callsite. NO mapping fallthrough\n# = NO emit (advisory-only; avoid noise on every spawn).\n_MCP_ARCHETYPE_TASK_CLASS_HINTS: Tuple[Tuple[Tuple[str, ...], str], ...] = (\n    # ORDER MATTERS — first match wins. More-specific archetype slugs\n    # (finops/seo/crypto) come BEFORE the bare \"architect\" pattern so\n    # composite slugs like \"llm-finops-architect\" or \"crypto-research-\n    # analyst\" route to the more specific MCP server bundle.\n    ((\"finops\", \"cost\", \"budget\"), \"finops\"),\n    ((\"seo\", \"ahrefs\", \"similarweb\"), \"seo_research\"),\n    ((\"crypto\", \"lunarcrush\", \"blockchain\"), \"crypto_research\"),\n    ((\"architect\", \"arch-\"), \"arch\"),\n)\n\n\n# PLAN-091 Wave A.5 (W3.3) — archetype-hint patterns triggering a\n# `specialization_promoted` advisory when subagent_type == general-purpose.\n# Match is FIRST-HIT, not exhaustive — keeps emit volume bounded. Hints\n# are lowercase substring matches on (description + prompt).\n_PROMOTION_ARCHETYPE_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n    (\"performance-engineer\",\n     (\"latency\", \"p95\", \"p99\", \"profile\", \"memory leak\", \"throughput\",\n      \"gc tuning\", \"hot path\")),\n    (\"security-engineer\",\n     (\"jwt\", \"oauth\", \"authentication\", \"vulnerability\", \"owasp\",\n      \"xss\", \"sql injection\", \"csrf\", \"rate limiting\")),\n    (\"qa-architect\",\n     (\"test strategy\", \"mutation testing\", \"flake\", \"regression\",\n      \"property-based\", \"fuzz\", \"contract test\")),\n    (\"code-reviewer\",\n     (\"merge gate\", \"code review\", \"veto\", \"review checklist\")),\n    (\"incident-commander\",\n     (\"incident commander\", \"severity classification\", \"all-clear\",\n      \"paging policy\", \"post-incident review\")),\n    (\"identity-trust-architect\",\n     (\"token rotation\", \"session lifecycle\", \"rbac\", \"abac\",\n      \"service-to-service trust\", \"mtls\")),\n    (\"threat-detection-engineer\",\n     (\"mitre att&ck\", \"siem rule\", \"detection rule\", \"alert deduplication\",\n      \"purple team\", \"threat hunting\")),\n    (\"devops\",\n     (\"github actions\", \"sha-pin\", \"ci/cd pipeline\", \"rollback strategy\",\n      \"secret rotation\")),\n)\n\n\ndef _emit_mcp_routing_advisory(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n) -> None:\n    \"\"\"PLAN-091 Wave A.4 (W3.1) — emit `mcp_route_advised` for this spawn.\n\n    Derives task_class from the spawn's archetype via the\n    ``_MCP_ARCHETYPE_TASK_CLASS_HINTS`` table, then delegates to\n    ``_lib/mcp_routing.resolve()`` which performs its own emit (per\n    PLAN-086 Wave D). Bypass: ``CEO_MCP_ROUTING_HOOK=0`` (parallel to\n    PLAN-078 model-routing bypass; per-server kill switches live inside\n    mcp_routing.resolve()).\n\n    NEVER raises. Advisory-only — never mutates tool_input, never blocks.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if (src_env.get(\"CEO_MCP_ROUTING_HOOK\") or \"\").strip() == \"0\":\n            return\n        archetype = _extract_archetype_from_payload(\n            description or \"\", prompt or \"\", subagent_type or \"\"\n        )\n        if not archetype:\n            return\n        archetype_lc = archetype.lower()\n        task_class: Optional[str] = None\n        for hints, mapped in _MCP_ARCHETYPE_TASK_CLASS_HINTS:\n            if any(h in archetype_lc for h in hints):\n                task_class = mapped\n                break\n        if task_class is None:\n            return  # no mapping; emit volume stays bounded\n        try:\n            from _lib import mcp_routing as _mcpr  # type: ignore\n            _mcpr.resolve(task_class)  # resolver fires advisory emit\n        except Exception:  # pragma: no cover - fail-open\n            return\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _emit_promotion_advisory(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n) -> None:\n    \"\"\"PLAN-091 Wave A.5 (W3.3) — emit `specialization_promoted` when a\n    ``general-purpose`` spawn matches a specialist archetype heuristic.\n\n    Advisory ONLY — does NOT auto-spawn the suggested specialist. Records\n    the suggestion in audit log so PLAN-094+ can promote SEMI to AUTO once\n    confidence is established. Bypass: ``CEO_PROMOTION_HEURISTIC=0``.\n\n    First-hit match wins (bounded emit volume). NEVER raises.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if (src_env.get(\"CEO_PROMOTION_HEURISTIC\") or \"\").strip() == \"0\":\n            return\n        if (subagent_type or \"\").strip().lower() != \"general-purpose\":\n            return\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        text = ((description or \"\") + \"\\n\" + (prompt or \"\")).lower()\n        text = text[: 8 * 1024]  # 8KiB cap on hint-scan window\n        for suggested, hints in _PROMOTION_ARCHETYPE_HINTS:\n            for hint in hints:\n                if hint in text:\n                    try:\n                        # PLAN-088 R2 iter-2 STRICKEN specialization_promoted\n                        # as separate action; routed via mcp_route_advised\n                        # with signal_source discriminator per audit_emit.py\n                        # 5099-5105 contract.\n                        _audit_emit.emit_generic(\n                            \"mcp_route_advised\",\n                            session_id=\"\",\n                            task_class=\"promotion\",\n                            suggested_servers=suggested[:64],\n                            kill_switch_overrides=\"\",\n                            signal_source=\"specialization_promoted\",\n                        )\n                    except Exception:  # pragma: no cover - fail-open\n                        pass\n                    return  # first-hit wins\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _emit_advisory_safe(\n    *,\n    archetype: str,\n    task_type: str,\n    model_recommended: str,\n    confidence: float,\n    applied_or_skipped: str,\n    override_reason: str,\n) -> None:\n    \"\"\"Wrapper around audit_emit.emit_generic for `model_routing_advised`.\n\n    Allowlist enforced by audit_emit dispatcher (defense-in-depth). Caller\n    only fills the 6 contract fields; ts/session/project added by emit_generic.\n\n    Codex W1+W2 fix-pack #2: ``confidence`` (float 0..1) is converted at\n    emission time to ``confidence_basis_points`` (int 0..1000) — floats\n    are forbidden in HMAC-covered fields (canonical_json invariant). The\n    in-process API surface still accepts ``confidence: float`` for\n    ergonomic continuity; conversion is colocated with the emit call.\n    \"\"\"\n    try:\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        # Convert float confidence -> int basis-points. NaN / out-of-range\n        # collapse to 0 (lower clamp in audit_emit emitter).\n        try:\n            conf_f = float(confidence)\n        except (TypeError, ValueError):\n            conf_f = 0.0\n        if conf_f != conf_f or conf_f in (float(\"inf\"), float(\"-inf\")):\n            conf_f = 0.0\n        if conf_f < 0.0:\n            conf_f = 0.0\n        if conf_f > 1.0:\n            conf_f = 1.0\n        confidence_bp = int(round(conf_f * 1000.0))\n        # Length-bound caller strings (defense-in-depth on adopter drift).\n        _audit_emit.emit_generic(\n            \"model_routing_advised\",\n            archetype=(archetype or \"\")[:64],\n            task_type=(task_type or \"\")[:32],\n            model_recommended=(model_recommended or \"\")[:64],\n            confidence_basis_points=confidence_bp,\n            applied_or_skipped=(applied_or_skipped or \"\")[:64],\n            override_reason=(override_reason or \"\")[:128],\n        )\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\n# Persona header patterns — must appear at the START of a line.\n_PERSONA_HEADER_RE = re.compile(\n    r\"^(?:PERSONA:|## AGENT PROFILE|## PERSONA)\",\n    flags=re.MULTILINE,\n)\n\n# Governance requirement: named spawns must include this literal section.\n_SKILL_CONTENT_MARKER = \"## SKILL CONTENT\"\n\n# PLAN-019 Phase 2B P1-SEC-B — minimum body size (non-whitespace bytes)\n# required between `## SKILL CONTENT` and the next `##` heading / EOF for\n# the marker to count as a real skill-content section. Rejects empty-body,\n# stub-only, or single-line \"see file X\" shells.\n_SKILL_CONTENT_MIN_BYTES = 256\n\n# Regex to find the marker ON ITS OWN LINE (ignoring trailing whitespace).\n_SKILL_CONTENT_MARKER_RE = re.compile(\n    r\"^## SKILL CONTENT[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n\n# Regex to find the next `##`-level heading (to bound the body extraction).\n_NEXT_H2_RE = re.compile(r\"^##[ \\t]\", flags=re.MULTILINE)\n\n# Code-fence markers (``` or ~~~ with optional language tag).\n_CODE_FENCE_RE = re.compile(r\"^(?:```|~~~)\", flags=re.MULTILINE)\n\n# HTML comment pair — non-greedy across lines.\n_HTML_COMMENT_RE = re.compile(r\"<!--.*?-->\", flags=re.DOTALL)\n\n# Regex to extract ## SPEC CONTEXT block content (between its header and next\n# ## heading or EOF). Used by _sanitize_spec_context_advisory() below.\n_SPEC_CONTEXT_HEADER_RE = re.compile(\n    r\"^##[ \\t]+SPEC[ \\t]+CONTEXT[ \\t]*$\",\n    flags=re.MULTILINE,\n)\n\n\ndef _sanitize_spec_context_advisory(prompt: str, env=None) -> None:\n    \"\"\"PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n    payload and emit telemetry advisory.\n\n    Extracts the ## SPEC CONTEXT block from the spawn prompt, runs it\n    through spec_context_sanitizer.sanitize(), and emits a\n    `spec_context_sanitized` audit-emit event so sentinel violations,\n    truncation, and control-char counts are observable.\n\n    ADVISORY ONLY — never blocks the spawn. Fail-open on any exception.\n    Kill-switch: CEO_SPEC_CTX_SANITIZER_ENABLED=0.\n    \"\"\"\n    try:\n        if not _SPEC_CTX_SANITIZER_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n            return\n        src_env = env if env is not None else os.environ\n        val = (src_env.get(\"CEO_SPEC_CTX_SANITIZER_ENABLED\") or \"1\").strip()\n        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n            return\n        if not prompt:\n            return\n        # Extract ## SPEC CONTEXT block content\n        m = _SPEC_CONTEXT_HEADER_RE.search(prompt)\n        if m is None:\n            return  # no SPEC CONTEXT block — nothing to sanitize\n        block_start = m.end()\n        next_h2 = _NEXT_H2_RE.search(prompt, block_start)\n        block_end = next_h2.start() if next_h2 else len(prompt)\n        spec_payload = prompt[block_start:block_end]\n\n        result = _spec_ctx_sanitizer.sanitize(spec_payload)\n\n        # Emit telemetry (advisory only; sentinel violations logged for CEO)\n        try:\n            _audit_emit.emit_generic(\n                \"spec_context_sanitized\",\n                original_bytes=result.original_bytes,\n                cleaned_bytes=result.cleaned_bytes,\n                truncated=1 if result.truncated else 0,\n                sentinel_violations=len(result.sentinel_violations),\n                control_chars_stripped=result.control_chars_stripped,\n                bidi_zw_chars_stripped=result.bidi_zw_chars_stripped,\n                # PLAN-133 A2 — surface the Tag-block count too (allowlisted in\n                # audit_emit §7d). Harmless if the SanitizeResult lacks the field\n                # (getattr default 0) so this stays import-order tolerant.\n                tag_chars_stripped=getattr(result, \"tag_chars_stripped\", 0),\n                header_escape_count=result.header_escape_count,\n            )\n        except Exception:  # pragma: no cover - fail-open\n            pass\n    except Exception:  # pragma: no cover - fail-open\n        return\n\n\ndef _enforce_spec_context_unicode(prompt: str, env=None):\n    \"\"\"PLAN-133 A2 — fail-CLOSED invisible-unicode guard on the spawn prompt.\n\n    Scans the WHOLE spawn prompt (not just the ## SPEC CONTEXT block — an attacker\n    can smuggle Tag-block/bidi chars anywhere in the named-spawn body) for invisible\n    /smuggling unicode (control / bidi / zero-width / U+E0000-E007F Tag-block).\n\n    Default-OFF (doctrine #1): the BLOCK fires only when CEO_UNICODE_HARDBLOCK=='1'\n    in the import-time trusted_env snapshot. Otherwise advisory — the breadcrumb is\n    emitted with enforced=0 (measure-first) and None is returned (no block).\n\n    Returns a block-reason string when enforced AND a detection fires, else None.\n    Fail-OPEN on any infra exception (never blocks the session on a scanner bug).\n    Master kill: CEO_SOTA_DISABLE=1 forces advisory.\n    \"\"\"\n    try:\n        if not _SPEC_CTX_SANITIZER_AVAILABLE:\n            return None\n        src_env = env if env is not None else os.environ\n        if not prompt:\n            return None\n        # Default-OFF flag, read from the trusted_env snapshot when available so a\n        # late-set value can't toggle enforcement mid-process. Master kill wins.\n        if (src_env.get(\"CEO_SOTA_DISABLE\") or \"\").strip() == \"1\":\n            enforce = False\n        else:\n            enforce = _unicode_hardblock_enforced(src_env)\n\n        result = _spec_ctx_sanitizer.sanitize(prompt)\n        count = _spec_ctx_sanitizer.invisible_unicode_count(result)\n        if count <= 0:\n            return None  # clean — nothing to do\n\n        unicode_class = _spec_ctx_sanitizer.classify_invisible_unicode(result)\n\n        # Emit the closed-enum breadcrumb on BOTH advisory and enforced paths\n        # (the denominator must be real from day one — no 0/0/0 trap).\n        if _AUDIT_EMIT_AVAILABLE:\n            try:\n                _audit_emit.emit_generic(\n                    \"invisible_unicode_blocked\",\n                    surface=\"spawn\",\n                    unicode_class=unicode_class,\n                    char_count=int(count),\n                    enforced=1 if enforce else 0,\n                )\n            except Exception:  # pragma: no cover - fail-open\n                pass\n\n        if not enforce:\n            return None  # advisory only\n\n        return (\n            \"GOVERNANCE: invisible_unicode_blocked: the spawn prompt contains \"\n            f\"{count} invisible/smuggling character(s) (class={unicode_class}: \"\n            \"control / bidi / zero-width / Unicode-Tags-block). These are \"\n            \"removed by the sanitizer and rejected fail-CLOSED before review. \"\n            \"Remove the hidden characters and re-spawn. To run advisory-only, \"\n            \"unset CEO_UNICODE_HARDBLOCK.\"\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return None\n\n\ndef _unicode_hardblock_enforced(src_env) -> bool:\n    \"\"\"True iff CEO_UNICODE_HARDBLOCK=='1' (PLAN-133 A2). Prefers the trusted_env\n    snapshot; falls back to the passed env dict. Pure; never raises.\"\"\"\n    try:\n        from _lib import trusted_env as _te  # noqa: E402\n        val = _te.get_trusted(\"CEO_UNICODE_HARDBLOCK\")\n        if val is not None:\n            return (val or \"\").strip() == \"1\"\n    except Exception:  # pragma: no cover\n        pass\n    return (src_env.get(\"CEO_UNICODE_HARDBLOCK\") or \"\").strip() == \"1\"\n\n\ndef _emit_spawn_confidence_advisory(\n    *,\n    action_type: str,\n    is_named_spawn: bool,\n    env=None,\n) -> None:\n    \"\"\"PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n\n    Classifies the spawn as an action and emits `spawn_confidence_advisory`\n    so recommender / receipt formatter surfaces have a hook-level confidence\n    signal for governance dashboards.\n\n    ADVISORY ONLY — never blocks. Fail-open on any exception.\n    Kill-switch: CEO_SPAWN_CONFIDENCE_ENABLED=0.\n    \"\"\"\n    try:\n        if not _CONFIDENCE_LABELS_AVAILABLE or not _AUDIT_EMIT_AVAILABLE:\n            return\n        src_env = env if env is not None else os.environ\n        val = (src_env.get(\"CEO_SPAWN_CONFIDENCE_ENABLED\") or \"1\").strip()\n        if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n            return\n\n        ctx = {\"canonical\": False}\n        conf = _confidence_labels.classify(action_type, ctx)\n        marker = _confidence_labels.as_emoji_free_marker(conf)\n\n        try:\n            _audit_emit.emit_generic(\n                \"spawn_confidence_advisory\",\n                action_type=(action_type or \"\")[:32],\n                confidence_level=(conf.level or \"\")[:32],\n                confidence_marker=(marker or \"\")[:32],\n                reason_code=(conf.reason_code or \"\")[:64],\n                is_named_spawn=1 if is_named_spawn else 0,\n            )\n        except Exception:  # pragma: no cover - fail-open\n            pass\n    except Exception:  # pragma: no cover - fail-open\n        return\n","numLines":546,"startLine":1,"totalLines":546}},"tool_result_meta":[{"id":"toolu_01BvReek19kt4nJPeF8yYzEC","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1MJJcmdmq4UyE4xzeCZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01HYPGZ57sfVTmiG69cEBv18","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/outcome_telemetry.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":7520,"cache_read_input_tokens":94146,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":7520},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"f61eea00-5ad8-4d7e-ab09-d78ac2eec102","timestamp":"2026-11-13T17:50:45.724Z","request_id":"req_011Ch1MJJCUd6esELXmBo84f","wire_tool_inputs":{"toolu_01HYPGZ57sfVTmiG69cEBv18":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/outcome_telemetry.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HYPGZ57sfVTmiG69cEBv18","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport re\n4\t\n5\t__all__ = ('_GOAP_RENDER_LOOKBACK_S', '_audit_log_path', '_parse_event_ts', '_tail_recent_rendered', '_resolve_session_id_from_env', '_resolve_project_from_env', '_emit_persona_coverage_synthesized', '_emit_goap_deferred_outcome', '_GOAP_PLAN_ID_RE', '_GOAP_CONFIRM_HEADER_RE', '_GOAP_PLAN_ID_VALUE_RE', '_GOAP_ACTION_ID_VALUE_RE', '_BLOCK_REASON_MARKERS')\n6\t\n7\t# ---------------------------------------------------------------------------\n8\t# PLAN-105 Wave A.6 — Deferred-emit override detection helper.\n9\t#\n10\t# Reads the most-recent goap_recommendation_rendered event in the current\n11\t# session (≤5 min window, matching plan_id), compares the spawn's\n12\t# `goap-action-id:` marker, and emits goap_recommendation_accepted on\n13\t# exact match OR goap_recommendation_overridden with the appropriate\n14\t# `override_type` (substituted_action / no_render_prior / marker_absent).\n15\t#\n16\t# Kill-switches:\n17\t#   CEO_GOAP_ADVISORY_ENABLED=0  → all 3 emits silent (existing PLAN-098 kill-switch)\n18\t#   CEO_GOAP_OVERRIDE_DETECTION_DISABLED=1  → always emit _accepted on allow-path (diagnostic only)\n19\t# ---------------------------------------------------------------------------\n20\t\n21\t_GOAP_RENDER_LOOKBACK_S = 300  # 5 minutes\n22\t\n23\t\n24\tdef _audit_log_path() -> Optional[Path]:\n25\t    \"\"\"Resolve audit log path — delegates to audit_emit._log_path() for\n26\t    byte-identical write/read paths.\n27\t\n28\t    PLAN-105 R2 P0 #2 fold: previously derived a slug from CLAUDE_PROJECT_DIR,\n29\t    which diverged from audit_emit's `~/.claude/projects/<native-slug>`\n30\t    default. Now imports the real resolver so reader path == writer path.\n31\t    \"\"\"\n32\t    try:\n33\t        from _lib import audit_emit as _ae  # type: ignore\n34\t        path = _ae._log_path()\n35\t        return path if path else None\n36\t    except Exception:\n37\t        # Fallback: env-driven path so unit tests using CEO_AUDIT_LOG_PATH\n38\t        # work pre-import.\n39\t        env_path = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n40\t        if env_path:\n41\t            return Path(env_path)\n42\t        env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n43\t        if env_dir:\n44\t            return Path(env_dir) / \"audit-log.jsonl\"\n45\t        return None\n46\t\n47\t\n48\tdef _parse_event_ts(ts) -> Optional[float]:\n49\t    \"\"\"Parse audit-log ts field (ISO-8601 UTC string or epoch float) → epoch seconds.\"\"\"\n50\t    if ts is None:\n51\t        return None\n52\t    if isinstance(ts, (int, float)):\n53\t        return float(ts)\n54\t    if isinstance(ts, str):\n55\t        s = ts.strip()\n56\t        if not s:\n57\t            return None\n58\t        # Try epoch first.\n59\t        try:\n60\t            return float(s)\n61\t        except (TypeError, ValueError):\n62\t            pass\n63\t        # ISO-8601 — strip trailing Z, parse via datetime.fromisoformat.\n64\t        import datetime as _dt\n65\t        try:\n66\t            if s.endswith(\"Z\"):\n67\t                s = s[:-1] + \"+00:00\"\n68\t            return _dt.datetime.fromisoformat(s).timestamp()\n69\t        except Exception:\n70\t            return None\n71\t    return None\n72\t\n73\t\n74\tdef _tail_recent_rendered(\n75\t    plan_id: str,\n76\t    max_age_s: int = _GOAP_RENDER_LOOKBACK_S,\n77\t    session_id: Optional[str] = None,\n78\t):\n79\t    \"\"\"Tail audit log for most-recent goap_recommendation_rendered matching plan_id.\n80\t\n81\t    PLAN-105 R2 P1 fold:\n82\t    - Optional `session_id` filter — same-session join (concurrent sessions\n83\t      with same plan_id within 5 min cannot misclassify).\n84\t    - Conservative ts handling — unparseable / missing ts treated as\n85\t      out-of-window (skipped), not as \"match-anyway\".\n86\t\n87\t    Returns parsed event dict (Optional[dict]). Returns None if no match\n88\t    within `max_age_s` seconds. Bounded tail = last 256 lines (~512KB).\n89\t    \"\"\"\n90\t    log_path = _audit_log_path()\n91\t    if log_path is None or not log_path.exists():\n92\t        return None\n93\t    try:\n94\t        import json as _json\n95\t        import time as _time\n96\t        with log_path.open(\"r\", encoding=\"utf-8\") as f:\n97\t            # Read last ~256 lines via seek-from-end (bounded perf).\n98\t            try:\n99\t                f.seek(0, 2)\n100\t                size = f.tell()\n101\t                read_back = min(size, 256 * 2048)  # ~512KB max\n102\t                start_offset = max(0, size - read_back)\n103\t                f.seek(start_offset, 0)\n104\t                # Only discard partial first line if we didn't seek to 0\n105\t                # (otherwise we'd lose the first real line of a small file).\n106\t                if start_offset > 0:\n107\t                    f.readline()\n108\t                tail = f.readlines()\n109\t            except OSError:\n110\t                tail = f.readlines()[-256:]\n111\t        now = _time.time()\n112\t        for line in reversed(tail):\n113\t            try:\n114\t                ev = _json.loads(line)\n115\t            except Exception:\n116\t                continue\n117\t            if ev.get(\"action\") != \"goap_recommendation_rendered\":\n118\t                continue\n119\t            if ev.get(\"plan_id\") != plan_id:\n120\t                continue\n121\t            # PLAN-105 R2 P1-3 fold — same-session filter when provided.\n122\t            if session_id is not None and ev.get(\"session_id\") != session_id:\n123\t                continue\n124\t            ts_f = _parse_event_ts(ev.get(\"ts\"))\n125\t            # PLAN-105 R2 P1-2 fold — conservative: unparseable ts skipped.\n126\t            if ts_f is None:\n127\t                continue\n128\t            if (now - ts_f) > max_age_s:\n129\t                # Older than the window — skip.\n130\t                continue\n131\t            return ev\n132\t        return None\n133\t    except Exception:\n134\t        return None\n135\t\n136\t\n137\tdef _resolve_session_id_from_env(env: Dict[str, str]) -> str:\n138\t    \"\"\"Resolve session_id from harness env (CLAUDE_SESSION_ID) — PLAN-105 R2 P1-1 fold.\"\"\"\n139\t    for key in (\"CLAUDE_SESSION_ID\", \"CEO_SESSION_ID\"):\n140\t        v = (env.get(key) or \"\").strip()\n141\t        if v:\n142\t            return v[:64]\n143\t    return \"\"\n144\t\n145\t\n146\tdef _resolve_project_from_env(env: Dict[str, str]) -> str:\n147\t    \"\"\"Derive project slug from CLAUDE_PROJECT_DIR basename — PLAN-105 R2 P1-1 fold.\"\"\"\n148\t    pd = (env.get(\"CLAUDE_PROJECT_DIR\") or \"\").strip()\n149\t    if pd:\n150\t        return Path(pd).name[:64]\n151\t    return \"\"\n152\t\n153\t\n154\tdef _emit_persona_coverage_synthesized(\n155\t    subagent_type: str,\n156\t    description: str,\n157\t    prompt: str,\n158\t    source: str,\n159\t    env: dict,\n160\t) -> None:\n161\t    \"\"\"PLAN-106 Wave C — emit persona_coverage_synthesized at allow path.\n162\t\n163\t    Maps (subagent_type, derived task_type) → 4×4 cell, emits one\n164\t    event via audit_emit.emit_generic. Best-effort; any exception is\n165\t    swallowed (fail-open). Bypass: ``CEO_PERSONA_COVERAGE_EMIT=0``.\n166\t\n167\t    The closed-enum sets (archetype + task_type) MUST match\n168\t    `_lib/audit_emit.py:_PERSONA_COVERAGE_ARCHETYPES` /\n169\t    `_PERSONA_COVERAGE_TASK_TYPES`. Both lists are duplicated here\n170\t    intentionally so the hook does no extra import at hot-path.\n171\t    \"\"\"\n172\t    if (env.get(\"CEO_PERSONA_COVERAGE_EMIT\") or \"\").strip() == \"0\":\n173\t        return\n174\t    if not _AUDIT_EMIT_AVAILABLE:\n175\t        return\n176\t    # Closed-set archetype filter — only emit for the 4 VETO-floor personas.\n177\t    arch_lower = (subagent_type or \"\").strip().lower()\n178\t    if arch_lower not in {\n179\t        \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n180\t        \"threat-detection-engineer\",\n181\t    }:\n182\t        return\n183\t    # Derive task_type via simple description+prompt keyword scan.\n184\t    haystack = \" \".join([\n185\t        (description or \"\").lower(),\n186\t        (prompt or \"\")[:4096].lower(),  # bounded — security R1 P1 NFKC budget\n187\t    ])\n188\t    # NFKC normalize once (Cf-injected bypass guard — full-width chars\n189\t    # in adversarial spawn prompts).\n190\t    haystack = unicodedata.normalize(\"NFKC\", haystack)\n191\t    task_type = \"\"\n192\t    # Order matters: most specific first.\n193\t    for keyword, t in (\n194\t        (\"review\", \"review\"),\n195\t        (\"audit\", \"review\"),  # reviewer aliases\n196\t        (\"vet\", \"vet\"),\n197\t        (\"validate\", \"vet\"),\n198\t        (\"verify\", \"vet\"),\n199\t        (\"test\", \"test\"),\n200\t        (\"detect\", \"detect\"),\n201\t        (\"triage\", \"detect\"),\n202\t        (\"incident\", \"detect\"),\n203\t    ):\n204\t        if keyword in haystack:\n205\t            task_type = t\n206\t            break\n207\t    if not task_type:\n208\t        # No keyword match → no cell signal. Skip emit; do not\n209\t        # arbitrarily bin into a default cell (would skew coverage).\n210\t        return\n211\t\n212\t    # cell_id = sha256[:8] of canonical f\"{arch_lower}:{task_type}\".\n213\t    # Deterministic across calls so dedup at audit layer can collapse\n214\t    # repeats from check_agent_spawn + check_canonical_edit on the\n215\t    # same (archetype, task_type) within a window.\n216\t    cell_input = f\"{arch_lower}:{task_type}\".encode(\"utf-8\")\n217\t    cell_id = hashlib.sha256(cell_input).hexdigest()[:8]\n218\t\n219\t    try:\n220\t        _audit_emit.emit_generic(\n221\t            \"persona_coverage_synthesized\",\n222\t            archetype=arch_lower,\n223\t            task_type=task_type,\n224\t            cell_id=cell_id,\n225\t            source=source,\n226\t        )\n227\t    except Exception:  # noqa: BLE001 — fail-open, never block spawn\n228\t        pass\n229\t\n230\t\n231\tdef _emit_goap_deferred_outcome(\n232\t    plan_id: Optional[str],\n233\t    action_id: Optional[str],\n234\t    env: Dict[str, str],\n235\t) -> None:\n236\t    \"\"\"Emit goap_recommendation_accepted or _overridden at decide() allow-return.\n237\t\n238\t    PLAN-105 Wave A.6. Silent no-op if plan_id is None (non-GOAP spawn).\n239\t    Silent no-op if kill-switch CEO_GOAP_ADVISORY_ENABLED=0.\n240\t\n241\t    PLAN-105 R2 P1-1 fold: session_id + project propagated from env so\n242\t    audit consumers can correlate spawn outcome with rendered event.\n243\t    \"\"\"\n244\t    if not plan_id:\n245\t        return\n246\t    if (env.get(\"CEO_GOAP_ADVISORY_ENABLED\", \"1\") or \"\").strip() == \"0\":\n247\t        return\n248\t    try:\n249\t        from _lib import audit_emit as _ae  # type: ignore\n250\t    except Exception:\n251\t        return\n252\t\n253\t    session_id = _resolve_session_id_from_env(env)\n254\t    project = _resolve_project_from_env(env)\n255\t\n256\t    diag_force_accept = (\n257\t        env.get(\"CEO_GOAP_OVERRIDE_DETECTION_DISABLED\", \"0\") or \"\"\n258\t    ).strip() == \"1\"\n259\t    if diag_force_accept:\n260\t        fn = getattr(_ae, \"emit_goap_recommendation_accepted\", None)\n261\t        if fn is not None:\n262\t            try:\n263\t                fn(plan_id=plan_id, action_id=(action_id or \"DIAG_FORCED\"),\n264\t                   session_id=session_id, project=project)\n265\t            except Exception:\n266\t                pass\n267\t        return\n268\t\n269\t    # PLAN-105 R2 P1-3 fold — same-session filter when session_id available.\n270\t    rendered = _tail_recent_rendered(\n271\t        plan_id,\n272\t        session_id=session_id if session_id else None,\n273\t    )\n274\t    if rendered is None:\n275\t        # Try a second pass without session-id filter — covers cases where\n276\t        # the _rendered event was emitted from /goap CLI invocation that\n277\t        # didn't carry session_id (or session env was unset at planner time).\n278\t        rendered = _tail_recent_rendered(plan_id)\n279\t    if rendered is None:\n280\t        # No recent _rendered for this plan_id — emit _overridden:no_render_prior.\n281\t        fn = getattr(_ae, \"emit_goap_recommendation_overridden\", None)\n282\t        if fn is not None:\n283\t            try:\n284\t                fn(plan_id=plan_id,\n285\t                   original_action_id=\"NO_RENDER_PRIOR\",\n286\t                   dispatched_action_id=(action_id or \"MARKER_ABSENT\"),\n287\t                   override_type=\"no_render_prior\",\n288\t                   session_id=session_id, project=project)\n289\t            except Exception:\n290\t                pass\n291\t        return\n292\t\n293\t    if action_id is None:\n294\t        # Spawn lacks goap-action-id marker — emit _overridden:marker_absent.\n295\t        fn = getattr(_ae, \"emit_goap_recommendation_overridden\", None)\n296\t        if fn is not None:\n297\t            try:\n298\t                fn(plan_id=plan_id,\n299\t                   original_action_id=(rendered.get(\"action_ids_csv\", \"\") or \"\")[:64],\n300\t                   dispatched_action_id=\"MARKER_ABSENT\",\n301\t                   override_type=\"marker_absent\",\n302\t                   session_id=session_id, project=project)\n303\t            except Exception:\n304\t                pass\n305\t        return\n306\t\n307\t    rendered_csv = rendered.get(\"action_ids_csv\", \"\") or \"\"\n308\t    rendered_ids = [s.strip() for s in rendered_csv.split(\",\") if s.strip()]\n309\t    if action_id in rendered_ids:\n310\t        fn = getattr(_ae, \"emit_goap_recommendation_accepted\", None)\n311\t        if fn is not None:\n312\t            try:\n313\t                fn(plan_id=plan_id, action_id=action_id,\n314\t                   session_id=session_id, project=project)\n315\t            except Exception:\n316\t                pass\n317\t    else:\n318\t        fn = getattr(_ae, \"emit_goap_recommendation_overridden\", None)\n319\t        if fn is not None:\n320\t            try:\n321\t                fn(plan_id=plan_id,\n322\t                   original_action_id=rendered_csv[:64],\n323\t                   dispatched_action_id=action_id,\n324\t                   override_type=\"substituted_action\",\n325\t                   session_id=session_id, project=project)\n326\t            except Exception:\n327\t                pass\n328\t\n329\t\n330\t# Session 75 Codex re-pass remaining concern: derive a stable\n331\t# reason_code from the human-readable Decision.reason so the audit\n332\t# trail correctly classifies the block path. Order is significant —\n333\t# more-specific prefixes first, generic fallback last.\n334\t# PLAN-098 Wave C.2 (ADR-132) - GOAP advisory-only invariant enforcement.\n335\t_GOAP_PLAN_ID_RE = re.compile(r\"\\bgoap-plan-id\\s*:\\s*\\S+\", re.IGNORECASE)\n336\t_GOAP_CONFIRM_HEADER_RE = re.compile(\n337\t    r\"^##\\s+GOAP\\s+CONFIRM\\b\", re.IGNORECASE | re.MULTILINE\n338\t)\n339\t# PLAN-105 Wave A.6 - capture value of goap-plan-id / goap-action-id markers\n340\t# for deferred-emit override detection at decide() allow-path return.\n341\t_GOAP_PLAN_ID_VALUE_RE = re.compile(\n342\t    r\"\\bgoap-plan-id\\s*:\\s*(\\S+)\", re.IGNORECASE\n343\t)\n344\t_GOAP_ACTION_ID_VALUE_RE = re.compile(\n345\t    r\"\\bgoap-action-id\\s*:\\s*(\\S+)\", re.IGNORECASE\n346\t)\n347\t\n348\t\n349\t_BLOCK_REASON_MARKERS = (\n350\t    (\"SPAWN-SECRET-BLOCKED\", \"secret_in_spawn_prompt\"),\n351\t    (\"GOVERNANCE: veto_floor_demoted\", \"veto_floor_demoted\"),\n352\t    (\"ARCHITECT-RECURSION\", \"architect_role_not_delegable\"),\n353\t    (\"GOVERNANCE: spawn prompt contains a `/effort` token\", \"effort_token_in_spawn\"),\n354\t    # Skill-reference path: reason text format is\n355\t    # \"GOVERNANCE: <reason_code>: <detail>...\" — extract the embedded code.\n356\t    (\"GOVERNANCE: reference_\", \"__REFERENCE_PREFIX__\"),\n357\t    # PLAN-098 Wave C.2 (ADR-132) - GOAP advisory-only invariant.\n358\t    (\"GOVERNANCE: goap_advisory_without_owner_confirm\", \"goap_advisory_without_owner_confirm\"),\n359\t    # PLAN-133 E3 — per-spawn tool scoping + depth/overlap rails.\n360\t    (\"GOVERNANCE: spawn_tool_out_of_scope\", \"spawn_tool_out_of_scope\"),\n361\t    (\"GOVERNANCE: spawn_depth_over_one\", \"spawn_depth_over_one\"),\n362\t    (\"GOVERNANCE: spawn_file_assignment_overlap\", \"spawn_file_assignment_overlap\"),\n363\t    # PLAN-178 C1 / ADR-191 - FILE ASSIGNMENT grammar (measure-first flip).\n364\t    (\"GOVERNANCE: spawn_file_assignment_missing\", \"spawn_file_assignment_missing\"),\n365\t    (\"GOVERNANCE: spawn_file_assignment_unparseable\", \"spawn_file_assignment_unparseable\"),\n366\t    # PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.\n367\t    (\"GOVERNANCE: spawn_prompt_defense_missing\", \"spawn_prompt_defense_missing\"),\n368\t    # NAMED-spawn-without-skill is the historical default — keep last.\n369\t    (\"GOVERNANCE: Agent spawn detected as NAMED\", \"missing_skill_content\"),\n370\t)\n371\t"}]},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"98fedd0c-e619-407c-a37c-49212757cdf7","timestamp":"2026-11-13T17:50:45.730Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/outcome_telemetry.py","content":"from __future__ import annotations\n\nimport re\n\n__all__ = ('_GOAP_RENDER_LOOKBACK_S', '_audit_log_path', '_parse_event_ts', '_tail_recent_rendered', '_resolve_session_id_from_env', '_resolve_project_from_env', '_emit_persona_coverage_synthesized', '_emit_goap_deferred_outcome', '_GOAP_PLAN_ID_RE', '_GOAP_CONFIRM_HEADER_RE', '_GOAP_PLAN_ID_VALUE_RE', '_GOAP_ACTION_ID_VALUE_RE', '_BLOCK_REASON_MARKERS')\n\n# ---------------------------------------------------------------------------\n# PLAN-105 Wave A.6 — Deferred-emit override detection helper.\n#\n# Reads the most-recent goap_recommendation_rendered event in the current\n# session (≤5 min window, matching plan_id), compares the spawn's\n# `goap-action-id:` marker, and emits goap_recommendation_accepted on\n# exact match OR goap_recommendation_overridden with the appropriate\n# `override_type` (substituted_action / no_render_prior / marker_absent).\n#\n# Kill-switches:\n#   CEO_GOAP_ADVISORY_ENABLED=0  → all 3 emits silent (existing PLAN-098 kill-switch)\n#   CEO_GOAP_OVERRIDE_DETECTION_DISABLED=1  → always emit _accepted on allow-path (diagnostic only)\n# ---------------------------------------------------------------------------\n\n_GOAP_RENDER_LOOKBACK_S = 300  # 5 minutes\n\n\ndef _audit_log_path() -> Optional[Path]:\n    \"\"\"Resolve audit log path — delegates to audit_emit._log_path() for\n    byte-identical write/read paths.\n\n    PLAN-105 R2 P0 #2 fold: previously derived a slug from CLAUDE_PROJECT_DIR,\n    which diverged from audit_emit's `~/.claude/projects/<native-slug>`\n    default. Now imports the real resolver so reader path == writer path.\n    \"\"\"\n    try:\n        from _lib import audit_emit as _ae  # type: ignore\n        path = _ae._log_path()\n        return path if path else None\n    except Exception:\n        # Fallback: env-driven path so unit tests using CEO_AUDIT_LOG_PATH\n        # work pre-import.\n        env_path = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n        if env_path:\n            return Path(env_path)\n        env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n        if env_dir:\n            return Path(env_dir) / \"audit-log.jsonl\"\n        return None\n\n\ndef _parse_event_ts(ts) -> Optional[float]:\n    \"\"\"Parse audit-log ts field (ISO-8601 UTC string or epoch float) → epoch seconds.\"\"\"\n    if ts is None:\n        return None\n    if isinstance(ts, (int, float)):\n        return float(ts)\n    if isinstance(ts, str):\n        s = ts.strip()\n        if not s:\n            return None\n        # Try epoch first.\n        try:\n            return float(s)\n        except (TypeError, ValueError):\n            pass\n        # ISO-8601 — strip trailing Z, parse via datetime.fromisoformat.\n        import datetime as _dt\n        try:\n            if s.endswith(\"Z\"):\n                s = s[:-1] + \"+00:00\"\n            return _dt.datetime.fromisoformat(s).timestamp()\n        except Exception:\n            return None\n    return None\n\n\ndef _tail_recent_rendered(\n    plan_id: str,\n    max_age_s: int = _GOAP_RENDER_LOOKBACK_S,\n    session_id: Optional[str] = None,\n):\n    \"\"\"Tail audit log for most-recent goap_recommendation_rendered matching plan_id.\n\n    PLAN-105 R2 P1 fold:\n    - Optional `session_id` filter — same-session join (concurrent sessions\n      with same plan_id within 5 min cannot misclassify).\n    - Conservative ts handling — unparseable / missing ts treated as\n      out-of-window (skipped), not as \"match-anyway\".\n\n    Returns parsed event dict (Optional[dict]). Returns None if no match\n    within `max_age_s` seconds. Bounded tail = last 256 lines (~512KB).\n    \"\"\"\n    log_path = _audit_log_path()\n    if log_path is None or not log_path.exists():\n        return None\n    try:\n        import json as _json\n        import time as _time\n        with log_path.open(\"r\", encoding=\"utf-8\") as f:\n            # Read last ~256 lines via seek-from-end (bounded perf).\n            try:\n                f.seek(0, 2)\n                size = f.tell()\n                read_back = min(size, 256 * 2048)  # ~512KB max\n                start_offset = max(0, size - read_back)\n                f.seek(start_offset, 0)\n                # Only discard partial first line if we didn't seek to 0\n                # (otherwise we'd lose the first real line of a small file).\n                if start_offset > 0:\n                    f.readline()\n                tail = f.readlines()\n            except OSError:\n                tail = f.readlines()[-256:]\n        now = _time.time()\n        for line in reversed(tail):\n            try:\n                ev = _json.loads(line)\n            except Exception:\n                continue\n            if ev.get(\"action\") != \"goap_recommendation_rendered\":\n                continue\n            if ev.get(\"plan_id\") != plan_id:\n                continue\n            # PLAN-105 R2 P1-3 fold — same-session filter when provided.\n            if session_id is not None and ev.get(\"session_id\") != session_id:\n                continue\n            ts_f = _parse_event_ts(ev.get(\"ts\"))\n            # PLAN-105 R2 P1-2 fold — conservative: unparseable ts skipped.\n            if ts_f is None:\n                continue\n            if (now - ts_f) > max_age_s:\n                # Older than the window — skip.\n                continue\n            return ev\n        return None\n    except Exception:\n        return None\n\n\ndef _resolve_session_id_from_env(env: Dict[str, str]) -> str:\n    \"\"\"Resolve session_id from harness env (CLAUDE_SESSION_ID) — PLAN-105 R2 P1-1 fold.\"\"\"\n    for key in (\"CLAUDE_SESSION_ID\", \"CEO_SESSION_ID\"):\n        v = (env.get(key) or \"\").strip()\n        if v:\n            return v[:64]\n    return \"\"\n\n\ndef _resolve_project_from_env(env: Dict[str, str]) -> str:\n    \"\"\"Derive project slug from CLAUDE_PROJECT_DIR basename — PLAN-105 R2 P1-1 fold.\"\"\"\n    pd = (env.get(\"CLAUDE_PROJECT_DIR\") or \"\").strip()\n    if pd:\n        return Path(pd).name[:64]\n    return \"\"\n\n\ndef _emit_persona_coverage_synthesized(\n    subagent_type: str,\n    description: str,\n    prompt: str,\n    source: str,\n    env: dict,\n) -> None:\n    \"\"\"PLAN-106 Wave C — emit persona_coverage_synthesized at allow path.\n\n    Maps (subagent_type, derived task_type) → 4×4 cell, emits one\n    event via audit_emit.emit_generic. Best-effort; any exception is\n    swallowed (fail-open). Bypass: ``CEO_PERSONA_COVERAGE_EMIT=0``.\n\n    The closed-enum sets (archetype + task_type) MUST match\n    `_lib/audit_emit.py:_PERSONA_COVERAGE_ARCHETYPES` /\n    `_PERSONA_COVERAGE_TASK_TYPES`. Both lists are duplicated here\n    intentionally so the hook does no extra import at hot-path.\n    \"\"\"\n    if (env.get(\"CEO_PERSONA_COVERAGE_EMIT\") or \"\").strip() == \"0\":\n        return\n    if not _AUDIT_EMIT_AVAILABLE:\n        return\n    # Closed-set archetype filter — only emit for the 4 VETO-floor personas.\n    arch_lower = (subagent_type or \"\").strip().lower()\n    if arch_lower not in {\n        \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n        \"threat-detection-engineer\",\n    }:\n        return\n    # Derive task_type via simple description+prompt keyword scan.\n    haystack = \" \".join([\n        (description or \"\").lower(),\n        (prompt or \"\")[:4096].lower(),  # bounded — security R1 P1 NFKC budget\n    ])\n    # NFKC normalize once (Cf-injected bypass guard — full-width chars\n    # in adversarial spawn prompts).\n    haystack = unicodedata.normalize(\"NFKC\", haystack)\n    task_type = \"\"\n    # Order matters: most specific first.\n    for keyword, t in (\n        (\"review\", \"review\"),\n        (\"audit\", \"review\"),  # reviewer aliases\n        (\"vet\", \"vet\"),\n        (\"validate\", \"vet\"),\n        (\"verify\", \"vet\"),\n        (\"test\", \"test\"),\n        (\"detect\", \"detect\"),\n        (\"triage\", \"detect\"),\n        (\"incident\", \"detect\"),\n    ):\n        if keyword in haystack:\n            task_type = t\n            break\n    if not task_type:\n        # No keyword match → no cell signal. Skip emit; do not\n        # arbitrarily bin into a default cell (would skew coverage).\n        return\n\n    # cell_id = sha256[:8] of canonical f\"{arch_lower}:{task_type}\".\n    # Deterministic across calls so dedup at audit layer can collapse\n    # repeats from check_agent_spawn + check_canonical_edit on the\n    # same (archetype, task_type) within a window.\n    cell_input = f\"{arch_lower}:{task_type}\".encode(\"utf-8\")\n    cell_id = hashlib.sha256(cell_input).hexdigest()[:8]\n\n    try:\n        _audit_emit.emit_generic(\n            \"persona_coverage_synthesized\",\n            archetype=arch_lower,\n            task_type=task_type,\n            cell_id=cell_id,\n            source=source,\n        )\n    except Exception:  # noqa: BLE001 — fail-open, never block spawn\n        pass\n\n\ndef _emit_goap_deferred_outcome(\n    plan_id: Optional[str],\n    action_id: Optional[str],\n    env: Dict[str, str],\n) -> None:\n    \"\"\"Emit goap_recommendation_accepted or _overridden at decide() allow-return.\n\n    PLAN-105 Wave A.6. Silent no-op if plan_id is None (non-GOAP spawn).\n    Silent no-op if kill-switch CEO_GOAP_ADVISORY_ENABLED=0.\n\n    PLAN-105 R2 P1-1 fold: session_id + project propagated from env so\n    audit consumers can correlate spawn outcome with rendered event.\n    \"\"\"\n    if not plan_id:\n        return\n    if (env.get(\"CEO_GOAP_ADVISORY_ENABLED\", \"1\") or \"\").strip() == \"0\":\n        return\n    try:\n        from _lib import audit_emit as _ae  # type: ignore\n    except Exception:\n        return\n\n    session_id = _resolve_session_id_from_env(env)\n    project = _resolve_project_from_env(env)\n\n    diag_force_accept = (\n        env.get(\"CEO_GOAP_OVERRIDE_DETECTION_DISABLED\", \"0\") or \"\"\n    ).strip() == \"1\"\n    if diag_force_accept:\n        fn = getattr(_ae, \"emit_goap_recommendation_accepted\", None)\n        if fn is not None:\n            try:\n                fn(plan_id=plan_id, action_id=(action_id or \"DIAG_FORCED\"),\n                   session_id=session_id, project=project)\n            except Exception:\n                pass\n        return\n\n    # PLAN-105 R2 P1-3 fold — same-session filter when session_id available.\n    rendered = _tail_recent_rendered(\n        plan_id,\n        session_id=session_id if session_id else None,\n    )\n    if rendered is None:\n        # Try a second pass without session-id filter — covers cases where\n        # the _rendered event was emitted from /goap CLI invocation that\n        # didn't carry session_id (or session env was unset at planner time).\n        rendered = _tail_recent_rendered(plan_id)\n    if rendered is None:\n        # No recent _rendered for this plan_id — emit _overridden:no_render_prior.\n        fn = getattr(_ae, \"emit_goap_recommendation_overridden\", None)\n        if fn is not None:\n            try:\n                fn(plan_id=plan_id,\n                   original_action_id=\"NO_RENDER_PRIOR\",\n                   dispatched_action_id=(action_id or \"MARKER_ABSENT\"),\n                   override_type=\"no_render_prior\",\n                   session_id=session_id, project=project)\n            except Exception:\n                pass\n        return\n\n    if action_id is None:\n        # Spawn lacks goap-action-id marker — emit _overridden:marker_absent.\n        fn = getattr(_ae, \"emit_goap_recommendation_overridden\", None)\n        if fn is not None:\n            try:\n                fn(plan_id=plan_id,\n                   original_action_id=(rendered.get(\"action_ids_csv\", \"\") or \"\")[:64],\n                   dispatched_action_id=\"MARKER_ABSENT\",\n                   override_type=\"marker_absent\",\n                   session_id=session_id, project=project)\n            except Exception:\n                pass\n        return\n\n    rendered_csv = rendered.get(\"action_ids_csv\", \"\") or \"\"\n    rendered_ids = [s.strip() for s in rendered_csv.split(\",\") if s.strip()]\n    if action_id in rendered_ids:\n        fn = getattr(_ae, \"emit_goap_recommendation_accepted\", None)\n        if fn is not None:\n            try:\n                fn(plan_id=plan_id, action_id=action_id,\n                   session_id=session_id, project=project)\n            except Exception:\n                pass\n    else:\n        fn = getattr(_ae, \"emit_goap_recommendation_overridden\", None)\n        if fn is not None:\n            try:\n                fn(plan_id=plan_id,\n                   original_action_id=rendered_csv[:64],\n                   dispatched_action_id=action_id,\n                   override_type=\"substituted_action\",\n                   session_id=session_id, project=project)\n            except Exception:\n                pass\n\n\n# Session 75 Codex re-pass remaining concern: derive a stable\n# reason_code from the human-readable Decision.reason so the audit\n# trail correctly classifies the block path. Order is significant —\n# more-specific prefixes first, generic fallback last.\n# PLAN-098 Wave C.2 (ADR-132) - GOAP advisory-only invariant enforcement.\n_GOAP_PLAN_ID_RE = re.compile(r\"\\bgoap-plan-id\\s*:\\s*\\S+\", re.IGNORECASE)\n_GOAP_CONFIRM_HEADER_RE = re.compile(\n    r\"^##\\s+GOAP\\s+CONFIRM\\b\", re.IGNORECASE | re.MULTILINE\n)\n# PLAN-105 Wave A.6 - capture value of goap-plan-id / goap-action-id markers\n# for deferred-emit override detection at decide() allow-path return.\n_GOAP_PLAN_ID_VALUE_RE = re.compile(\n    r\"\\bgoap-plan-id\\s*:\\s*(\\S+)\", re.IGNORECASE\n)\n_GOAP_ACTION_ID_VALUE_RE = re.compile(\n    r\"\\bgoap-action-id\\s*:\\s*(\\S+)\", re.IGNORECASE\n)\n\n\n_BLOCK_REASON_MARKERS = (\n    (\"SPAWN-SECRET-BLOCKED\", \"secret_in_spawn_prompt\"),\n    (\"GOVERNANCE: veto_floor_demoted\", \"veto_floor_demoted\"),\n    (\"ARCHITECT-RECURSION\", \"architect_role_not_delegable\"),\n    (\"GOVERNANCE: spawn prompt contains a `/effort` token\", \"effort_token_in_spawn\"),\n    # Skill-reference path: reason text format is\n    # \"GOVERNANCE: <reason_code>: <detail>...\" — extract the embedded code.\n    (\"GOVERNANCE: reference_\", \"__REFERENCE_PREFIX__\"),\n    # PLAN-098 Wave C.2 (ADR-132) - GOAP advisory-only invariant.\n    (\"GOVERNANCE: goap_advisory_without_owner_confirm\", \"goap_advisory_without_owner_confirm\"),\n    # PLAN-133 E3 — per-spawn tool scoping + depth/overlap rails.\n    (\"GOVERNANCE: spawn_tool_out_of_scope\", \"spawn_tool_out_of_scope\"),\n    (\"GOVERNANCE: spawn_depth_over_one\", \"spawn_depth_over_one\"),\n    (\"GOVERNANCE: spawn_file_assignment_overlap\", \"spawn_file_assignment_overlap\"),\n    # PLAN-178 C1 / ADR-191 - FILE ASSIGNMENT grammar (measure-first flip).\n    (\"GOVERNANCE: spawn_file_assignment_missing\", \"spawn_file_assignment_missing\"),\n    (\"GOVERNANCE: spawn_file_assignment_unparseable\", \"spawn_file_assignment_unparseable\"),\n    # PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.\n    (\"GOVERNANCE: spawn_prompt_defense_missing\", \"spawn_prompt_defense_missing\"),\n    # NAMED-spawn-without-skill is the historical default — keep last.\n    (\"GOVERNANCE: Agent spawn detected as NAMED\", \"missing_skill_content\"),\n)\n","numLines":371,"startLine":1,"totalLines":371}},"tool_result_meta":[{"id":"toolu_01HYPGZ57sfVTmiG69cEBv18","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
