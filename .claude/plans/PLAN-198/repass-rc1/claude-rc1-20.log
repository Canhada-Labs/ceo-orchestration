{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014pyHk22auLWxtBBja7XqeQ","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\t__all__ = ('_TASK_ROUTE_MODULE', '_TASK_ROUTE_LOAD_FAILED', '_FRONTMATTER_MODEL_CACHE', '_FRONTMATTER_CACHE_MAX', '_resolve_task_route', '_read_archetype_model_frontmatter', '_extract_archetype_from_payload', '_emit_model_routing_advisory')\n4\t\n5\t# ---------------------------------------------------------------------------\n6\t# PLAN-078 Wave 1 — Model routing telemetry (advisory-emit-only)\n7\t# ---------------------------------------------------------------------------\n8\t# Telemetry-only: hook contract (`_lib/contract.py:112-127`) supports only\n9\t# allow/block/systemMessage. NO `tool_input` mutation. This block exists to\n10\t# observe sub-agent spawn → recommended model deltas so the CEO can hand-edit\n11\t# `.claude/agents/<archetype>.md` frontmatter (manual remediation path). The\n12\t# hard-enforcement leg is the existing VETO-floor check at\n13\t# check_veto_floor_for_role() which runs BEFORE this advisory.\n14\t#\n15\t# Hot-path requirement: p95 ≤ 20ms. Achieved via:\n16\t#   - module-level cache of task_route module + classify reference\n17\t#   - module-level cache of frontmatter parser\n18\t#   - frontmatter cache by-archetype (LRU dict, capped 64 entries) — agents\n19\t#     dir is small + rarely changes mid-session, so cache invalidation is\n20\t#     not required (next session re-imports module).\n21\t#\n22\t# Bypass: env var `CEO_MODEL_ROUTING=0` short-circuits to a no-op.\n23\t# Fail-open: any exception during advisory emit is swallowed (logged to\n24\t# breadcrumb if available) so the spawn is NEVER blocked by a routing bug.\n25\t\n26\t# Lazy task_route module reference — populated on first call. Cached.\n27\t_TASK_ROUTE_MODULE: Optional[Any] = None\n28\t_TASK_ROUTE_LOAD_FAILED: bool = False\n29\t\n30\t# In-memory cache: archetype -> (model: Optional[str], confidence: float).\n31\t# Cleared at module init only (process-scoped).\n32\t_FRONTMATTER_MODEL_CACHE: Dict[str, Tuple[Optional[str], float]] = {}\n33\t_FRONTMATTER_CACHE_MAX = 64\n34\t\n35\t\n36\tdef _resolve_task_route():\n37\t    \"\"\"Best-effort import of `.claude/scripts/task-route.py` as a module.\n38\t\n39\t    Returns the module on success, None on failure. Never raises.\n40\t    Cached after first call (positive or negative).\n41\t\n42\t    Resolution order:\n43\t      1. ``CLAUDE_PROJECT_DIR`` env var (test-friendly + adopter-respectful)\n44\t      2. Walk up from `_HOOKS_DIR` looking for a `.claude/scripts/task-route.py`\n45\t    \"\"\"\n46\t    global _TASK_ROUTE_MODULE, _TASK_ROUTE_LOAD_FAILED\n47\t    if _TASK_ROUTE_MODULE is not None or _TASK_ROUTE_LOAD_FAILED:\n48\t        return _TASK_ROUTE_MODULE\n49\t    try:\n50\t        import importlib.util as _ilutil\n51\t        candidates = []\n52\t        env_root = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n53\t        if env_root:\n54\t            candidates.append(\n55\t                Path(env_root) / \".claude\" / \"scripts\" / \"task-route.py\"\n56\t            )\n57\t        # Walk up from _HOOKS_DIR (stable in normal install)\n58\t        candidates.append(\n59\t            _HOOKS_DIR.parent.parent / \".claude\" / \"scripts\" / \"task-route.py\"\n60\t        )\n61\t        # Walk up from this file's location (helps when the hook itself is\n62\t        # staged under .claude/plans/PLAN-NNN/staging/...; rare but useful\n63\t        # for in-tree pytest runs that exercise the staged copy).\n64\t        cur = Path(__file__).resolve().parent\n65\t        for _ in range(8):\n66\t            if cur == cur.parent:\n67\t                break\n68\t            cand = cur / \".claude\" / \"scripts\" / \"task-route.py\"\n69\t            if cand.is_file():\n70\t                candidates.append(cand)\n71\t                break\n72\t            cur = cur.parent\n73\t        tr_path = next((c for c in candidates if c.is_file()), None)\n74\t        if tr_path is None:\n75\t            _TASK_ROUTE_LOAD_FAILED = True\n76\t            return None\n77\t        spec = _ilutil.spec_from_file_location(\"task_route\", tr_path)\n78\t        if spec is None or spec.loader is None:\n79\t            _TASK_ROUTE_LOAD_FAILED = True\n80\t            return None\n81\t        mod = _ilutil.module_from_spec(spec)\n82\t        spec.loader.exec_module(mod)\n83\t        _TASK_ROUTE_MODULE = mod\n84\t        return mod\n85\t    except Exception:  # pragma: no cover - fail-open\n86\t        _TASK_ROUTE_LOAD_FAILED = True\n87\t        return None\n88\t\n89\t\n90\tdef _read_archetype_model_frontmatter(\n91\t    archetype: str,\n92\t    agents_dir: Path,\n93\t) -> Tuple[Optional[str], float]:\n94\t    \"\"\"Read `model:` field from `<agents_dir>/<archetype>.md`.\n95\t\n96\t    Returns (model, confidence). When frontmatter present + model field\n97\t    set, confidence is 1.0 (authoritative). When file missing or no\n98\t    model field, confidence is 0.0 (caller will fall back to classify).\n99\t    Cached by archetype to avoid re-reading on repeat spawns.\n100\t    \"\"\"\n101\t    cached = _FRONTMATTER_MODEL_CACHE.get(archetype)\n102\t    if cached is not None:\n103\t        return cached\n104\t    result: Tuple[Optional[str], float] = (None, 0.0)\n105\t    try:\n106\t        if _agent_frontmatter is None:\n107\t            pass\n108\t        else:\n109\t            path = _agent_frontmatter.resolve_agent_file(archetype, agents_dir)\n110\t            if path.is_file():\n111\t                metadata = _agent_frontmatter.parse_agent_file(path)\n112\t                model = metadata.get(\"model\", \"\").strip() if metadata else \"\"\n113\t                if model:\n114\t                    result = (model, 1.0)\n115\t    except Exception:  # pragma: no cover - fail-open\n116\t        result = (None, 0.0)\n117\t    # Bounded LRU-ish cache (simple FIFO eviction at cap).\n118\t    if len(_FRONTMATTER_MODEL_CACHE) >= _FRONTMATTER_CACHE_MAX:\n119\t        try:\n120\t            _FRONTMATTER_MODEL_CACHE.pop(next(iter(_FRONTMATTER_MODEL_CACHE)))\n121\t        except StopIteration:  # pragma: no cover\n122\t            pass\n123\t    _FRONTMATTER_MODEL_CACHE[archetype] = result\n124\t    return result\n125\t\n126\t\n127\tdef _extract_archetype_from_payload(\n128\t    description: str,\n129\t    prompt: str,\n130\t    subagent_type: str,\n131\t) -> str:\n132\t    \"\"\"Best-effort archetype detection from spawn payload.\n133\t\n134\t    Order: ``subagent_type`` (Agent tool input) → first persona header\n135\t    line → empty string. Returns archetype slug or empty string.\n136\t    \"\"\"\n137\t    if subagent_type:\n138\t        return subagent_type.strip().lower()\n139\t    # Try to find archetype from persona header in prompt\n140\t    if prompt:\n141\t        m = re.search(\n142\t            r\"(?:archetype|role|persona):\\s*([a-z][a-z0-9_-]+)\",\n143\t            prompt,\n144\t            flags=re.IGNORECASE,\n145\t        )\n146\t        if m:\n147\t            return m.group(1).strip().lower()\n148\t    return \"\"\n149\t\n150\t\n151\tdef _emit_model_routing_advisory(\n152\t    *,\n153\t    description: str,\n154\t    prompt: str,\n155\t    subagent_type: str,\n156\t    env: Optional[Dict[str, str]] = None,\n157\t    project_dir: Optional[str] = None,\n158\t) -> None:\n159\t    \"\"\"Emit a `model_routing_advised` advisory event for this spawn.\n160\t\n161\t    PLAN-078 Wave 1. Telemetry-only — this function:\n162\t      - reads archetype from spawn payload\n163\t      - reads `.claude/agents/<archetype>.md` frontmatter `model:` if set\n164\t      - else calls `task_route.classify()` for a recommendation\n165\t      - emits via audit_emit (deny-by-default 6-field allowlist)\n166\t\n167\t    NEVER raises. Bypass via `CEO_MODEL_ROUTING=0`.\n168\t    \"\"\"\n169\t    try:\n170\t        src_env = env if env is not None else os.environ\n171\t        if (src_env.get(\"CEO_MODEL_ROUTING\") or \"\").strip() == \"0\":\n172\t            return  # bypass\n173\t        if not _AUDIT_EMIT_AVAILABLE:\n174\t            return  # audit emit unavailable; nothing to do\n175\t\n176\t        archetype = _extract_archetype_from_payload(\n177\t            description or \"\", prompt or \"\", subagent_type or \"\"\n178\t        )\n179\t        if not archetype:\n180\t            return  # generic spawn — no archetype to route\n181\t\n182\t        # Path A: agent frontmatter declared model -> authoritative.\n183\t        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n184\t        agents_dir = Path(proj) / \".claude\" / \"agents\"\n185\t        fm_model, fm_conf = _read_archetype_model_frontmatter(\n186\t            archetype, agents_dir\n187\t        )\n188\t\n189\t        if fm_model:\n190\t            model_recommended = fm_model\n191\t            confidence = fm_conf\n192\t            applied_or_skipped = \"skipped_classify_frontmatter_authoritative\"\n193\t            override_reason = \"frontmatter_model_present\"\n194\t            task_type = \"frontmatter\"\n195\t        else:\n196\t            # Path B: in-process classify.\n197\t            tr = _resolve_task_route()\n198\t            if tr is None or not hasattr(tr, \"classify\"):\n199\t                # Fail-open: no recommendation available, advisory skipped.\n200\t                return\n201\t            try:\n202\t                desc_text = (description or \"\")[:8 * 1024]  # cap to 8KiB\n203\t                result = tr.classify(desc_text, [])\n204\t            except Exception:\n205\t                # classify() raised — fail-open with breadcrumb attempt.\n206\t                _emit_advisory_safe(\n207\t                    archetype=archetype,\n208\t                    task_type=\"classify_error\",\n209\t                    model_recommended=\"\",\n210\t                    confidence=0.0,\n211\t                    applied_or_skipped=\"skipped_classify_exception\",\n212\t                    override_reason=\"classify_raised\",\n213\t                )\n214\t                return\n215\t            classification = (\n216\t                result.get(\"classification\") if isinstance(result, dict) else \"\"\n217\t            ) or \"\"\n218\t            # Conservative mapping: classify() returns S/M/L/XL classification —\n219\t            # not a model directly. Telemetry records the classification +\n220\t            # leaves model_recommended empty so PLAN-079 can decide the mapping.\n221\t            model_recommended = \"\"\n222\t            confidence = 0.7 if classification else 0.0\n223\t            applied_or_skipped = (\n224\t                \"advisory_only_no_recommendation\"\n225\t                if not classification\n226\t                else \"advisory_only_classification_emitted\"\n227\t            )\n228\t            override_reason = \"\"\n229\t            task_type = classification or \"unclassified\"\n230\t\n231\t        _emit_advisory_safe(\n232\t            archetype=archetype,\n233\t            task_type=task_type,\n234\t            model_recommended=model_recommended,\n235\t            confidence=float(confidence),\n236\t            applied_or_skipped=applied_or_skipped,\n237\t            override_reason=override_reason,\n238\t        )\n239\t    except Exception:  # pragma: no cover - fail-open invariant\n240\t        return\n241\t"}]},"parent_tool_use_id":null,"session_id":"2528d9c1-8eb1-455d-9821-50eb46f8d21a","uuid":"7d445ef9-28dd-42db-b24c-3dc96238c471","timestamp":"2026-11-13T17:50:29.933Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/agent_spawn/model_routing.py","content":"from __future__ import annotations\n\n__all__ = ('_TASK_ROUTE_MODULE', '_TASK_ROUTE_LOAD_FAILED', '_FRONTMATTER_MODEL_CACHE', '_FRONTMATTER_CACHE_MAX', '_resolve_task_route', '_read_archetype_model_frontmatter', '_extract_archetype_from_payload', '_emit_model_routing_advisory')\n\n# ---------------------------------------------------------------------------\n# PLAN-078 Wave 1 — Model routing telemetry (advisory-emit-only)\n# ---------------------------------------------------------------------------\n# Telemetry-only: hook contract (`_lib/contract.py:112-127`) supports only\n# allow/block/systemMessage. NO `tool_input` mutation. This block exists to\n# observe sub-agent spawn → recommended model deltas so the CEO can hand-edit\n# `.claude/agents/<archetype>.md` frontmatter (manual remediation path). The\n# hard-enforcement leg is the existing VETO-floor check at\n# check_veto_floor_for_role() which runs BEFORE this advisory.\n#\n# Hot-path requirement: p95 ≤ 20ms. Achieved via:\n#   - module-level cache of task_route module + classify reference\n#   - module-level cache of frontmatter parser\n#   - frontmatter cache by-archetype (LRU dict, capped 64 entries) — agents\n#     dir is small + rarely changes mid-session, so cache invalidation is\n#     not required (next session re-imports module).\n#\n# Bypass: env var `CEO_MODEL_ROUTING=0` short-circuits to a no-op.\n# Fail-open: any exception during advisory emit is swallowed (logged to\n# breadcrumb if available) so the spawn is NEVER blocked by a routing bug.\n\n# Lazy task_route module reference — populated on first call. Cached.\n_TASK_ROUTE_MODULE: Optional[Any] = None\n_TASK_ROUTE_LOAD_FAILED: bool = False\n\n# In-memory cache: archetype -> (model: Optional[str], confidence: float).\n# Cleared at module init only (process-scoped).\n_FRONTMATTER_MODEL_CACHE: Dict[str, Tuple[Optional[str], float]] = {}\n_FRONTMATTER_CACHE_MAX = 64\n\n\ndef _resolve_task_route():\n    \"\"\"Best-effort import of `.claude/scripts/task-route.py` as a module.\n\n    Returns the module on success, None on failure. Never raises.\n    Cached after first call (positive or negative).\n\n    Resolution order:\n      1. ``CLAUDE_PROJECT_DIR`` env var (test-friendly + adopter-respectful)\n      2. Walk up from `_HOOKS_DIR` looking for a `.claude/scripts/task-route.py`\n    \"\"\"\n    global _TASK_ROUTE_MODULE, _TASK_ROUTE_LOAD_FAILED\n    if _TASK_ROUTE_MODULE is not None or _TASK_ROUTE_LOAD_FAILED:\n        return _TASK_ROUTE_MODULE\n    try:\n        import importlib.util as _ilutil\n        candidates = []\n        env_root = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n        if env_root:\n            candidates.append(\n                Path(env_root) / \".claude\" / \"scripts\" / \"task-route.py\"\n            )\n        # Walk up from _HOOKS_DIR (stable in normal install)\n        candidates.append(\n            _HOOKS_DIR.parent.parent / \".claude\" / \"scripts\" / \"task-route.py\"\n        )\n        # Walk up from this file's location (helps when the hook itself is\n        # staged under .claude/plans/PLAN-NNN/staging/...; rare but useful\n        # for in-tree pytest runs that exercise the staged copy).\n        cur = Path(__file__).resolve().parent\n        for _ in range(8):\n            if cur == cur.parent:\n                break\n            cand = cur / \".claude\" / \"scripts\" / \"task-route.py\"\n            if cand.is_file():\n                candidates.append(cand)\n                break\n            cur = cur.parent\n        tr_path = next((c for c in candidates if c.is_file()), None)\n        if tr_path is None:\n            _TASK_ROUTE_LOAD_FAILED = True\n            return None\n        spec = _ilutil.spec_from_file_location(\"task_route\", tr_path)\n        if spec is None or spec.loader is None:\n            _TASK_ROUTE_LOAD_FAILED = True\n            return None\n        mod = _ilutil.module_from_spec(spec)\n        spec.loader.exec_module(mod)\n        _TASK_ROUTE_MODULE = mod\n        return mod\n    except Exception:  # pragma: no cover - fail-open\n        _TASK_ROUTE_LOAD_FAILED = True\n        return None\n\n\ndef _read_archetype_model_frontmatter(\n    archetype: str,\n    agents_dir: Path,\n) -> Tuple[Optional[str], float]:\n    \"\"\"Read `model:` field from `<agents_dir>/<archetype>.md`.\n\n    Returns (model, confidence). When frontmatter present + model field\n    set, confidence is 1.0 (authoritative). When file missing or no\n    model field, confidence is 0.0 (caller will fall back to classify).\n    Cached by archetype to avoid re-reading on repeat spawns.\n    \"\"\"\n    cached = _FRONTMATTER_MODEL_CACHE.get(archetype)\n    if cached is not None:\n        return cached\n    result: Tuple[Optional[str], float] = (None, 0.0)\n    try:\n        if _agent_frontmatter is None:\n            pass\n        else:\n            path = _agent_frontmatter.resolve_agent_file(archetype, agents_dir)\n            if path.is_file():\n                metadata = _agent_frontmatter.parse_agent_file(path)\n                model = metadata.get(\"model\", \"\").strip() if metadata else \"\"\n                if model:\n                    result = (model, 1.0)\n    except Exception:  # pragma: no cover - fail-open\n        result = (None, 0.0)\n    # Bounded LRU-ish cache (simple FIFO eviction at cap).\n    if len(_FRONTMATTER_MODEL_CACHE) >= _FRONTMATTER_CACHE_MAX:\n        try:\n            _FRONTMATTER_MODEL_CACHE.pop(next(iter(_FRONTMATTER_MODEL_CACHE)))\n        except StopIteration:  # pragma: no cover\n            pass\n    _FRONTMATTER_MODEL_CACHE[archetype] = result\n    return result\n\n\ndef _extract_archetype_from_payload(\n    description: str,\n    prompt: str,\n    subagent_type: str,\n) -> str:\n    \"\"\"Best-effort archetype detection from spawn payload.\n\n    Order: ``subagent_type`` (Agent tool input) → first persona header\n    line → empty string. Returns archetype slug or empty string.\n    \"\"\"\n    if subagent_type:\n        return subagent_type.strip().lower()\n    # Try to find archetype from persona header in prompt\n    if prompt:\n        m = re.search(\n            r\"(?:archetype|role|persona):\\s*([a-z][a-z0-9_-]+)\",\n            prompt,\n            flags=re.IGNORECASE,\n        )\n        if m:\n            return m.group(1).strip().lower()\n    return \"\"\n\n\ndef _emit_model_routing_advisory(\n    *,\n    description: str,\n    prompt: str,\n    subagent_type: str,\n    env: Optional[Dict[str, str]] = None,\n    project_dir: Optional[str] = None,\n) -> None:\n    \"\"\"Emit a `model_routing_advised` advisory event for this spawn.\n\n    PLAN-078 Wave 1. Telemetry-only — this function:\n      - reads archetype from spawn payload\n      - reads `.claude/agents/<archetype>.md` frontmatter `model:` if set\n      - else calls `task_route.classify()` for a recommendation\n      - emits via audit_emit (deny-by-default 6-field allowlist)\n\n    NEVER raises. Bypass via `CEO_MODEL_ROUTING=0`.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if (src_env.get(\"CEO_MODEL_ROUTING\") or \"\").strip() == \"0\":\n            return  # bypass\n        if not _AUDIT_EMIT_AVAILABLE:\n            return  # audit emit unavailable; nothing to do\n\n        archetype = _extract_archetype_from_payload(\n            description or \"\", prompt or \"\", subagent_type or \"\"\n        )\n        if not archetype:\n            return  # generic spawn — no archetype to route\n\n        # Path A: agent frontmatter declared model -> authoritative.\n        proj = project_dir or src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        agents_dir = Path(proj) / \".claude\" / \"agents\"\n        fm_model, fm_conf = _read_archetype_model_frontmatter(\n            archetype, agents_dir\n        )\n\n        if fm_model:\n            model_recommended = fm_model\n            confidence = fm_conf\n            applied_or_skipped = \"skipped_classify_frontmatter_authoritative\"\n            override_reason = \"frontmatter_model_present\"\n            task_type = \"frontmatter\"\n        else:\n            # Path B: in-process classify.\n            tr = _resolve_task_route()\n            if tr is None or not hasattr(tr, \"classify\"):\n                # Fail-open: no recommendation available, advisory skipped.\n                return\n            try:\n                desc_text = (description or \"\")[:8 * 1024]  # cap to 8KiB\n                result = tr.classify(desc_text, [])\n            except Exception:\n                # classify() raised — fail-open with breadcrumb attempt.\n                _emit_advisory_safe(\n                    archetype=archetype,\n                    task_type=\"classify_error\",\n                    model_recommended=\"\",\n                    confidence=0.0,\n                    applied_or_skipped=\"skipped_classify_exception\",\n                    override_reason=\"classify_raised\",\n                )\n                return\n            classification = (\n                result.get(\"classification\") if isinstance(result, dict) else \"\"\n            ) or \"\"\n            # Conservative mapping: classify() returns S/M/L/XL classification —\n            # not a model directly. Telemetry records the classification +\n            # leaves model_recommended empty so PLAN-079 can decide the mapping.\n            model_recommended = \"\"\n            confidence = 0.7 if classification else 0.0\n            applied_or_skipped = (\n                \"advisory_only_no_recommendation\"\n                if not classification\n                else \"advisory_only_classification_emitted\"\n            )\n            override_reason = \"\"\n            task_type = classification or \"unclassified\"\n\n        _emit_advisory_safe(\n            archetype=archetype,\n            task_type=task_type,\n            model_recommended=model_recommended,\n            confidence=float(confidence),\n            applied_or_skipped=applied_or_skipped,\n            override_reason=override_reason,\n        )\n    except Exception:  # pragma: no cover - fail-open invariant\n        return\n","numLines":241,"startLine":1,"totalLines":241}},"tool_result_meta":[{"id":"toolu_014pyHk22auLWxtBBja7XqeQ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
