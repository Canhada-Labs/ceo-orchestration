+                    "action": "audit_producer_path_pollution_detected",
+                    "ts": rotated_at,
+                    "session_id": "",
+                    "project": "",
+                    "event_schema": "v2",
+                    "tokens_in": None,
+                    "tokens_out": None,
+                    "tokens_total": None,
+                    "hmac": None,
+                    "hmac_error": "producer_path_pollution_detected",
+                    "chokepoint": "chain_reset_marker",
+                    "reason_code": _rc,
+                    "path_sha256_prefix": _psp,
+                    "expected_canonical_prefix": _ecp,
