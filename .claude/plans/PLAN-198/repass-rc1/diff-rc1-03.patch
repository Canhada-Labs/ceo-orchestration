+        "plan_id": plan_id,
+        "spawn_id": spawn_id,
+        "tokens_used": int(tokens_used),
+        "cap": int(cap),
+        "scope": scope,
+        "session_id": session_id,
+        "project": project,
+    }
+    _write_event(event)
+
+
+def emit_budget_bypass_used(
