+    spawn_id: str,
+    tokens_used: int,
+    cap: int,
+    scope: str = "spawn",
+    session_id: str = "",
+    project: str = "",
+) -> None:
+    """Emit a budget_exceeded event (Sprint 11 Phase 6, ADR-033).
+
+    Fired by ``check_budget.py`` when a spawn or plan rollup exceeds the
