import json, sys

try:
    obj = json.load(sys.stdin)
except Exception:
    print("__CEO_PARSE_FAILURE__")
    raise SystemExit(0)
decision = ""
if isinstance(obj, dict):
    d = obj.get("decision")
    if isinstance(d, str):
        decision = d
