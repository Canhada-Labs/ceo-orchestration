        return False\n561\t    manifest_version = manifest.get(\"package_version\")\n562\t    if _cli_currency.parse_semver(manifest_version) is None:\n563\t        result[\"status\"] = \"mismatch\"\n564\t        result[\"detail\"] = \"manifest_package_version_malformed\"\n565\t        return True\n566\t    if _cli_currency.compatible_package_version(payload, launcher, manifest_version):\n567\t        result[\"status\"] = \"compatible\"\n568\t        result[\"detail\"] = \"version_floor_only\"\n569\t        result[\"path\"] = str(payload)\n570\t        return True\n571\t    return False\n572\t\n573\t\n574\tdef _resolve_codex_bin() -> Optional[str]:\n575\t    \"\"\"Return verified or floor-compatible native payload; infra is None.\"\"\"\n576\t    override = os.environ.get(\"CEO_PAIR_RAIL_CODEX_BIN\")\n577\t    res = (\n578\t        verify_codex_payload(payload_override=override)\n579\t        if override\n580\t        else verify_codex_payload()\n581\t    )\n582\t    status = res.get(\"status\")\n583\t    if status in (\"verified\", \"compatible\"):\n584\t        return str(res.get(\"path\") or \"\") or None\n585\t    if status == \"infra\":\n586\t        return None\n587\t    raise CodexPinMismatch(\n588\t        f\"{status}:{res.get('detail')} triple={res.get('target_triple') or '?'} \"\n589\t        f\"payload_sha={str(res.get('sha256'))[:16] or '?'} \""}]},"parent_tool_use_id":null,"session_id":"dc5b5fe9-2c6b-46ea-80f3-b2c4ce2f3240","uuid":"02c313de-06dd-41d9-939f-4b36127cdee2","timestamp":"2026-11-13T18:28:28.181Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_pair_rail_parts/part_01.py","content":"                result[\"detail\"] = \"override_payload_missing\"\n                return result\n        else:\n            payload = _resolve_codex_payload(launcher_path, rel_path, triple)\n            if payload is None:\n                # The launcher itself would throw \"Missing optional\n                # dependency\" here — codex cannot run at all → INFRA.\n                result[\"detail\"] = \"payload_not_resolved\"\n                return result\n        result[\"path\"] = str(payload)\n\n        actual = _sha256_file(payload)\n        if actual is None:\n            result[\"detail\"] = \"payload_unreadable\"\n            return result\n        result[\"sha256\"] = actual\n\n        if actual != expected:\n            if _apply_currency_policy(payload, launcher_path, manifest, result):\n                return result\n            result[\"status\"] = \"mismatch\"\n            result[\"detail\"] = \"payload_sha256_mismatch\"\n            return result\n\n        result[\"status\"] = \"verified\"\n        result[\"detail\"] = \"ok\"\n        return result\n    except Exception as e:  # defensive: kernel never raises\n        result[\"status\"] = \"infra\"\n        result[\"detail\"] = f\"unexpected:{type(e).__name__}\"\n        return result\n\n\ndef _apply_currency_policy(\n    payload: Path, launcher: Optional[Path], manifest: Dict[str, Any], result: Dict[str, Any],\n) -> bool:\n    \"\"\"Record qualified version and apply only the explicitly allowed currency arm.\"\"\"\n    installed = _cli_currency.qualified_package_version(payload, launcher)\n    result[\"installed_version\"] = installed or \"\"\n    if installed is None:\n        return False\n    manifest_version = manifest.get(\"package_version\")\n    if _cli_currency.parse_semver(manifest_version) is None:\n        result[\"status\"] = \"mismatch\"\n        result[\"detail\"] = \"manifest_package_version_malformed\"\n        return True\n    if _cli_currency.compatible_package_version(payload, launcher, manifest_version):\n        result[\"status\"] = \"compatible\"\n        result[\"detail\"] = \"version_floor_only\"\n        result[\"path\"] = str(payload)\n        return True\n    return False\n\n\ndef _resolve_codex_bin() -> Optional[str]:\n    \"\"\"Return verified or floor-compatible native payload; infra is None.\"\"\"\n    override = os.environ.get(\"CEO_PAIR_RAIL_CODEX_BIN\")\n    res = (\n        verify_codex_payload(payload_override=override)\n        if override\n        else verify_codex_payload()\n    )\n    status = res.get(\"status\")\n    if status in (\"verified\", \"compatible\"):\n        return str(res.get(\"path\") or \"\") or None\n    if status == \"infra\":\n        return None\n    raise CodexPinMismatch(\n        f\"{status}:{res.get('detail')} triple={res.get('target_triple') or '?'} \"\n        f\"payload_sha={str(res.get('sha256'))[:16] or '?'} \"","numLines":70,"startLine":520,"totalLines":649}},"tool_result_meta":[{"id":"toolu_01YaXDadAW9N7ZfTi5VeLj1V","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
