e[Any, ...]]] = []\n    for raw in (text or \"\").split(\",\"):\n        raw = raw.strip()\n        m = _RANGE_CLAUSE_RE.match(raw)\n        if not m:\n            return None\n        key = semver_key(m.group(2))\n        if key is None:\n            return None\n        clauses.append((m.group(1) or \"==\", key))\n    return clauses or None\n\n\ndef in_range(version: str, clauses: List[Tuple[str, Tuple[Any, ...]]]) -> bool:\n    key = semver_key(version)\n    if key is None:\n        return False\n    for op, bound in clauses:\n        ok = {\n            \">=\": key >= bound, \">\": key > bound, \"<=\": key <= bound,\n            \"<\": key < bound, \"==\": key == bound, \"=\": key == bound,\n        }[op]\n        if not ok:\n            return False\n    return True\n\n\ndef _run(argv: List[str], timeout: float, cwd: Optional[str] = None,","numLines":35,"startLine":215,"totalLines":1285}},"tool_result_meta":[{"id":"toolu_01HYyExZcP5yNRYeTJJ8Nh4H","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
