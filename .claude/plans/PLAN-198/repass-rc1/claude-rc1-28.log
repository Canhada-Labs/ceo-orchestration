{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LASus2rYmB2p3KF9wcRoKx","type":"tool_result","content":"1\t\"\"\"Bind split installer-census components to the legacy module namespace.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom copy import deepcopy\n4\tfrom types import FunctionType\n5\tfrom . import commands, engine, model, operands, report, syntax, verdicts_a, verdicts_b\n6\t\n7\t\n8\tdef _bind_function(original, namespace):\n9\t    bound = FunctionType(original.__code__, namespace, original.__name__, original.__defaults__, original.__closure__)\n10\t    bound.__kwdefaults__ = original.__kwdefaults__\n11\t    bound.__annotations__ = original.__annotations__.copy()\n12\t    bound.__dict__.update(original.__dict__)\n13\t    bound.__doc__ = original.__doc__\n14\t    bound.__qualname__ = original.__qualname__\n15\t    bound.__module__ = namespace[\"__name__\"]\n16\t    return bound\n17\t\n18\t\n19\tdef _bind_class(original, namespace):\n20\t    if not getattr(original, \"__module__\", \"\").startswith(\n21\t        (\"_installer_write_safety\", \"_lib._installer_write_safety\")\n22\t    ):\n23\t        return original\n24\t    attrs = dict(vars(original))\n25\t    attrs.pop(\"__dict__\", None)\n26\t    attrs.pop(\"__weakref__\", None)\n27\t    for slot in attrs.get(\"__slots__\", ()):\n28\t        attrs.pop(slot, None)\n29\t    for name, member in list(attrs.items()):\n30\t        if isinstance(member, FunctionType):\n31\t            attrs[name] = _bind_function(member, namespace)\n32\t        elif isinstance(member, staticmethod):\n33\t            attrs[name] = staticmethod(_bind_function(member.__func__, namespace))\n34\t        elif isinstance(member, classmethod):\n35\t            attrs[name] = classmethod(_bind_function(member.__func__, namespace))\n36\t    clone = type(original)(original.__name__, original.__bases__, attrs)\n37\t    clone.__module__ = namespace[\"__name__\"]\n38\t    clone.__qualname__ = original.__qualname__\n39\t    return clone\n40\t\n41\t\n42\tdef bind(namespace):\n43\t    \"\"\"Export every legacy name against one patchable facade namespace.\"\"\"\n44\t    mutable_state = {}\n45\t    for component in (engine, syntax, commands, operands, model, verdicts_a, verdicts_b, report):\n46\t        for name in component.__all__:\n47\t            original = getattr(component, name)\n48\t            if isinstance(original, FunctionType):\n49\t                namespace[name] = _bind_function(original, namespace)\n50\t            elif isinstance(original, type):\n51\t                namespace[name] = _bind_class(original, namespace)\n52\t            elif isinstance(original, (dict, list, set)):\n53\t                namespace[name] = deepcopy(original, mutable_state)\n54\t            else:\n55\t                namespace[name] = original\n56\t"}]},"parent_tool_use_id":null,"session_id":"dc5b5fe9-2c6b-46ea-80f3-b2c4ce2f3240","uuid":"ef2af88d-d046-4293-8e1a-da9b22cb95a7","timestamp":"2026-11-13T18:24:46.225Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_installer_write_safety/__init__.py","content":"\"\"\"Bind split installer-census components to the legacy module namespace.\"\"\"\nfrom __future__ import annotations\nfrom copy import deepcopy\nfrom types import FunctionType\nfrom . import commands, engine, model, operands, report, syntax, verdicts_a, verdicts_b\n\n\ndef _bind_function(original, namespace):\n    bound = FunctionType(original.__code__, namespace, original.__name__, original.__defaults__, original.__closure__)\n    bound.__kwdefaults__ = original.__kwdefaults__\n    bound.__annotations__ = original.__annotations__.copy()\n    bound.__dict__.update(original.__dict__)\n    bound.__doc__ = original.__doc__\n    bound.__qualname__ = original.__qualname__\n    bound.__module__ = namespace[\"__name__\"]\n    return bound\n\n\ndef _bind_class(original, namespace):\n    if not getattr(original, \"__module__\", \"\").startswith(\n        (\"_installer_write_safety\", \"_lib._installer_write_safety\")\n    ):\n        return original\n    attrs = dict(vars(original))\n    attrs.pop(\"__dict__\", None)\n    attrs.pop(\"__weakref__\", None)\n    for slot in attrs.get(\"__slots__\", ()):\n        attrs.pop(slot, None)\n    for name, member in list(attrs.items()):\n        if isinstance(member, FunctionType):\n            attrs[name] = _bind_function(member, namespace)\n        elif isinstance(member, staticmethod):\n            attrs[name] = staticmethod(_bind_function(member.__func__, namespace))\n        elif isinstance(member, classmethod):\n            attrs[name] = classmethod(_bind_function(member.__func__, namespace))\n    clone = type(original)(original.__name__, original.__bases__, attrs)\n    clone.__module__ = namespace[\"__name__\"]\n    clone.__qualname__ = original.__qualname__\n    return clone\n\n\ndef bind(namespace):\n    \"\"\"Export every legacy name against one patchable facade namespace.\"\"\"\n    mutable_state = {}\n    for component in (engine, syntax, commands, operands, model, verdicts_a, verdicts_b, report):\n        for name in component.__all__:\n            original = getattr(component, name)\n            if isinstance(original, FunctionType):\n                namespace[name] = _bind_function(original, namespace)\n            elif isinstance(original, type):\n                namespace[name] = _bind_class(original, namespace)\n            elif isinstance(original, (dict, list, set)):\n                namespace[name] = deepcopy(original, mutable_state)\n            else:\n                namespace[name] = original\n","numLines":56,"startLine":1,"totalLines":56}},"tool_result_meta":[{"id":"toolu_01LASus2rYmB2p3KF9wcRoKx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
