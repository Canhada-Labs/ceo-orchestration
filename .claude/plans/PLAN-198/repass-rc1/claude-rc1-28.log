: str) -> Optional[str]:\n507\t    \"\"\"The mold of a pack whose manifest ``.new`` already pins ``version``,\n508\t    unless the live manifest pins it too (then that pack is the applied one).\n509\t    None when there is none or the inventory cannot be read (fail-open: the\n510\t    caller falls back to the generator's own answer).\"\"\"\n511\t    pinned = read_codex_pin(repo).get(\"package_version\")\n512\t    if pinned == version:\n513\t        return None\n514\t    try:\n515\t        want = tool.parse_version(version)\n516\t        rows = tool.mold_inventory(repo)\n517\t    except Exception:  # noqa: BLE001 — infra fail-open; newest_mold() names it\n518\t        return None\n519\t    hits = sorted(r[\"rel\"] for r in rows if r.get(\"target\") == want)\n520\t    return hits[-1] if hits else None\n521\t\n522\t\n523\tdef _stale_pack_reason(tool: Any, repo: Path, mold_rel: str) -> Optional[str]:\n524\t    \"\"\"Why an existing constants-block pack can no longer be applied, or None.\n525\t\n526\t    That grammar records the sha256 of the live pin and manifest when the\n527\t    pack was generated (``BASE_PIN_SHA256``/``BASE_MAN_SHA256``) and its\n528\t    ceremony dies when either file changed since. A heredoc-grammar pack\n529\t    records neither, and a mold this generator does not parse is not judged\n530\t    (fail-open: the caller keeps the \"apply the existing pack\" advice).\n531\t    \"\"\"\n532\t    try:\n533\t        text = (repo / mold_rel).read_bytes().decode(\"utf-8\")\n534\t        parts = tool.parse_mold(text)\n535\t    except Exception:  # noqa: BLE001 — infra/unparsed mold: not judged\n536\t        return None\n537\t    if parts.get(\"grammar\") != getattr(tool, \"GRAMMAR_CONSTANTS\", None):\n538\t        return None\n539\t    consts = parts.get(\"consts\") or {}\n540\t    changed = []\n541\t    for key, rel in ((\"BASE_PIN_SHA256\", tool.PIN_REL), (\"BASE_MAN_SHA256\", tool.MANIFEST_REL)):\n542\t        entry = consts.get(key)\n543\t        if entry is None:\n544\t            return None\n545\t        try:\n546\t            live = hashlib.sha256((repo / rel).read_bytes()).hexdigest()\n547\t        except OSError:\n548\t            return None\n549\t        if entry[1].strip(\"'\") != live:\n550\t            changed.append(rel)\n551\t    if not changed:\n552\t        return None\n553\t    return \"{} changed after the pack was generated (its {} no longer match)\".format(\n554\t        \" and \".join(changed), \"BASE_*_SHA256\" if len(changed) > 1 else \"BASE_* sha256\")\n555\t\n556\t\n557\tdef _codex_installed_findings(repo: Path, pin: Dict[str, Any],\n558\t                              installed: str) -> List[Dict[str, Any]]:\n559\t    pinned = pin[\"package_version\"]\n560\t    clauses = parse_range(pin[\"range\"]) if pin.get(\"range\") else None\n561\t    range_note = \"\"\n562\t    if clauses is not None:\n563\t        range_note = \" (pre-flight range {}: {})\".format(\n564\t            pin[\"range\"], \"inside\" if in_range(installed, clauses) else \"OUTSIDE\")\n565\t    if installed == pinned:\n566\t        if clauses is not None and not in_range(pinned, clauses):\n567\t            return [_finding(\"codex\", \"CODEX_PIN_PACK_INCOHERENT\", \"drift\",\n568\t                             \"manifest pins {} but codex-cli-pin.txt range {} excludes it\".format(\n569\t                                 pinned, pin[\"range\"]), repin_next(repo, pinned))]\n570\t        return []\n571\t    if (clauses is not None and len(clauses) == 1 and clauses[0][0] == \">=\"\n572\t            and _RELEASE_RE.match(installed) and in_range(installed, clauses)):\n573\t        return [_finding(\n574\t            \"codex\", \"CODEX_INSTALLED_COMPATIBLE\", \"info\",\n575\t            \"installed codex {} meets the unbounded semantic floor {} — version \"\n576\t            \"compatibility only; the payload hash is verified separately\".format(\n577\t                installed, pin[\"range\"]),\n578\t            [], {\"installed\": installed, \"floor\": pin[\"range\"]})]\n579\t    ikey, pkey = semver_key(installed), semver_key(pinned)\n580\t    claim = (\"installed codex {} is not the pinned {}{} — the payload sha256 will not \"\n581\t             \"match the manifest, so the pair-rail fails CLOSED at the next L3+ call\"\n582\t             ).format(installed, pinned, range_note)\n583\t    if (ikey is not None and pkey is not None and ikey < pkey) or not _RELEASE_RE.match(installed):\n584\t        # Older than the pin, or a prerelease (never re-pinned): restore.\n585\t        nxt = [\"npm i -g {}@{}   # Owner-run: restore the pinned binary\".format(\n586\t            _NPM_PACKAGE, pinned),\n587\t            \"python3 .claude/hooks/check_pair_rail.py --verify-codex-pin\"]\n588\t    else:\n589\t        nxt = repin_next(repo, installed) + [\n590\t            \"or restore the pinned binary (Owner-run): npm i -g {}@{}\".format(\n591\t                _NPM_PACKAGE, pinned)]\n592\t    return [_finding(\"codex\", \"CODEX_INSTALLED_NOT_PINNED\", \"drift\", claim, nxt,\n593\t                     {\"installed\": installed, \"pinned\": pinned})]\n594\t\n595\t\n596\t# --------------------------------------------------------------------------\n597\t# npm dist-tags cache (the ONLY network path; opt-in)\n598\t# --------------------------------------------------------------------------\n599\t\n600\tdef default_cache_path(repo: Path, project: Optional[str]) -> Optional[Path]:\n601\t    \"\"\"Cache under the project runtime state dir — the single resolver.\n602\t\n603\t    ``project`` None keeps the resolver's own precedence (CLAUDE_PROJECT_DIR,\n604\t    else cwd); an explicit --repo-root is passed AS GIVEN (no realpath: the\n605\t    harness slugs the launch path as given — runtime_paths \"symlink honesty\").\n606\t    \"\"\"\n607\t    hooks = repo / \".claude\" / \"hooks\"\n608\t    candidates = [hooks, SCRIPT_DIR.parent / \"hooks\"]\n609\t    for cand in candidates:\n610\t        if (cand / \"_lib\" / \"runtime_paths.py\").is_file():\n611\t            if str(cand) not in sys.path:\n612\t                sys.path.insert(0, str(cand))\n613\t            break\n614\t    try:\n615\t        from _lib import runtime_paths as _rp  # noqa: E402\n616\t    except Exception:  # noqa: BLE001 — infra fail-open\n617\t        return None\n618\t    return _rp.runtime_state_dir(project=project) / _CACHE_SUBDIR / _CACHE_NAME\n619\t"}]},"parent_tool_use_id":null,"session_id":"dc5b5fe9-2c6b-46ea-80f3-b2c4ce2f3240","uuid":"c118a1fb-15c6-490f-984b-991c2a7e152a","timestamp":"2026-11-13T18:28:00.663Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/check-substrate-drift.py","content":"            cmds.append(\"re-pin {} via the ADR-182 pin ceremony (the mold check failed: {})\".format(\n                version, type(exc).__name__))\n        else:\n            if mold is None:\n                cmds.append(\"re-pin {} via the ADR-182 pin ceremony (no pack mold found under \"\n                            \".claude/plans/{})\".format(version, tool.MOLD_GLOB))\n            elif not mold[\"compatible\"]:\n                cmds.append(\"re-pin {} by cloning the newest pin-pack mold {} by hand (ADR-182 \"\n                            \"ceremony) — no generator-compatible mold: re-pin-codex.py refuses it \"\n                            \"({})\".format(version, mold[\"rel\"], mold[\"reason\"]))\n            elif in_repo:\n                ga = (\" --ga-tag vA.B.C\" if mold.get(\"grammar\") == tool.GRAMMAR_CONSTANTS\n                      else \"\")\n                ga_note = (\"; vA.B.C = the release tag the re-pin must follow (the mold's \"\n                           \"GA_TAG)\" if ga else \"\")\n                cmds.append(\"python3 .claude/scripts/re-pin-codex.py {} --mold {} --plan \"\n                            \"PLAN-NNN{}   # PLAN-NNN = the plan that carries the re-pin{}; \"\n                            \"emits the pin pack (never applies it); the Owner signs it \"\n                            \"(ADR-182)\".format(version, mold[\"rel\"], ga, ga_note))\n            else:\n                cmds.append(\"re-pin {} by cloning the newest pin-pack mold {} (ADR-182 \"\n                            \"ceremony)\".format(version, mold[\"rel\"]))\n    cmds.append(\"python3 .claude/hooks/check_pair_rail.py --verify-codex-pin\")\n    return cmds\n\n\ndef _existing_pack_for(tool: Any, repo: Path, version: str) -> Optional[str]:\n    \"\"\"The mold of a pack whose manifest ``.new`` already pins ``version``,\n    unless the live manifest pins it too (then that pack is the applied one).\n    None when there is none or the inventory cannot be read (fail-open: the\n    caller falls back to the generator's own answer).\"\"\"\n    pinned = read_codex_pin(repo).get(\"package_version\")\n    if pinned == version:\n        return None\n    try:\n        want = tool.parse_version(version)\n        rows = tool.mold_inventory(repo)\n    except Exception:  # noqa: BLE001 — infra fail-open; newest_mold() names it\n        return None\n    hits = sorted(r[\"rel\"] for r in rows if r.get(\"target\") == want)\n    return hits[-1] if hits else None\n\n\ndef _stale_pack_reason(tool: Any, repo: Path, mold_rel: str) -> Optional[str]:\n    \"\"\"Why an existing constants-block pack can no longer be applied, or None.\n\n    That grammar records the sha256 of the live pin and manifest when the\n    pack was generated (``BASE_PIN_SHA256``/``BASE_MAN_SHA256``) and its\n    ceremony dies when either file changed since. A heredoc-grammar pack\n    records neither, and a mold this generator does not parse is not judged\n    (fail-open: the caller keeps the \"apply the existing pack\" advice).\n    \"\"\"\n    try:\n        text = (repo / mold_rel).read_bytes().decode(\"utf-8\")\n        parts = tool.parse_mold(text)\n    except Exception:  # noqa: BLE001 — infra/unparsed mold: not judged\n        return None\n    if parts.get(\"grammar\") != getattr(tool, \"GRAMMAR_CONSTANTS\", None):\n        return None\n    consts = parts.get(\"consts\") or {}\n    changed = []\n    for key, rel in ((\"BASE_PIN_SHA256\", tool.PIN_REL), (\"BASE_MAN_SHA256\", tool.MANIFEST_REL)):\n        entry = consts.get(key)\n        if entry is None:\n            return None\n        try:\n            live = hashlib.sha256((repo / rel).read_bytes()).hexdigest()\n        except OSError:\n            return None\n        if entry[1].strip(\"'\") != live:\n            changed.append(rel)\n    if not changed:\n        return None\n    return \"{} changed after the pack was generated (its {} no longer match)\".format(\n        \" and \".join(changed), \"BASE_*_SHA256\" if len(changed) > 1 else \"BASE_* sha256\")\n\n\ndef _codex_installed_findings(repo: Path, pin: Dict[str, Any],\n                              installed: str) -> List[Dict[str, Any]]:\n    pinned = pin[\"package_version\"]\n    clauses = parse_range(pin[\"range\"]) if pin.get(\"range\") else None\n    range_note = \"\"\n    if clauses is not None:\n        range_note = \" (pre-flight range {}: {})\".format(\n            pin[\"range\"], \"inside\" if in_range(installed, clauses) else \"OUTSIDE\")\n    if installed == pinned:\n        if clauses is not None and not in_range(pinned, clauses):\n            return [_finding(\"codex\", \"CODEX_PIN_PACK_INCOHERENT\", \"drift\",\n                             \"manifest pins {} but codex-cli-pin.txt range {} excludes it\".format(\n                                 pinned, pin[\"range\"]), repin_next(repo, pinned))]\n        return []\n    if (clauses is not None and len(clauses) == 1 and clauses[0][0] == \">=\"\n            and _RELEASE_RE.match(installed) and in_range(installed, clauses)):\n        return [_finding(\n            \"codex\", \"CODEX_INSTALLED_COMPATIBLE\", \"info\",\n            \"installed codex {} meets the unbounded semantic floor {} — version \"\n            \"compatibility only; the payload hash is verified separately\".format(\n                installed, pin[\"range\"]),\n            [], {\"installed\": installed, \"floor\": pin[\"range\"]})]\n    ikey, pkey = semver_key(installed), semver_key(pinned)\n    claim = (\"installed codex {} is not the pinned {}{} — the payload sha256 will not \"\n             \"match the manifest, so the pair-rail fails CLOSED at the next L3+ call\"\n             ).format(installed, pinned, range_note)\n    if (ikey is not None and pkey is not None and ikey < pkey) or not _RELEASE_RE.match(installed):\n        # Older than the pin, or a prerelease (never re-pinned): restore.\n        nxt = [\"npm i -g {}@{}   # Owner-run: restore the pinned binary\".format(\n            _NPM_PACKAGE, pinned),\n            \"python3 .claude/hooks/check_pair_rail.py --verify-codex-pin\"]\n    else:\n        nxt = repin_next(repo, installed) + [\n            \"or restore the pinned binary (Owner-run): npm i -g {}@{}\".format(\n                _NPM_PACKAGE, pinned)]\n    return [_finding(\"codex\", \"CODEX_INSTALLED_NOT_PINNED\", \"drift\", claim, nxt,\n                     {\"installed\": installed, \"pinned\": pinned})]\n\n\n# --------------------------------------------------------------------------\n# npm dist-tags cache (the ONLY network path; opt-in)\n# --------------------------------------------------------------------------\n\ndef default_cache_path(repo: Path, project: Optional[str]) -> Optional[Path]:\n    \"\"\"Cache under the project runtime state dir — the single resolver.\n\n    ``project`` None keeps the resolver's own precedence (CLAUDE_PROJECT_DIR,\n    else cwd); an explicit --repo-root is passed AS GIVEN (no realpath: the\n    harness slugs the launch path as given — runtime_paths \"symlink honesty\").\n    \"\"\"\n    hooks = repo / \".claude\" / \"hooks\"\n    candidates = [hooks, SCRIPT_DIR.parent / \"hooks\"]\n    for cand in candidates:\n        if (cand / \"_lib\" / \"runtime_paths.py\").is_file():\n            if str(cand) not in sys.path:\n                sys.path.insert(0, str(cand))\n            break\n    try:\n        from _lib import runtime_paths as _rp  # noqa: E402\n    except Exception:  # noqa: BLE001 — infra fail-open\n        return None\n    return _rp.runtime_state_dir(project=project) / _CACHE_SUBDIR / _CACHE_NAME\n","numLines":140,"startLine":480,"totalLines":1285}},"tool_result_meta":[{"id":"toolu_01B2McR7hyJmqAS8CYksazFe","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
