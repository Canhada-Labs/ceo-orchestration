 row[\"severity\"]) for row in findings], [\n49\t            (\"CODEX_INSTALLED_COMPATIBLE\", \"info\")\n50\t        ])\n51\t        self.assertEqual(findings[0][\"floor\"], \">=0.160.0\")\n52\t\n53\t    def test_fu144_watch_newer_codex_is_compatible_not_drift(self) -> None:\n54\t        ledger = {\"_meta\": {}, \"components\": [{\n55\t            \"key\": \"codex_cli\", \"label\": \"Codex\", \"last_seen\": {\n56\t                \"version\": \"0.160.0\", \"date\": \"2026-10-01\"\n57\t            }\n58\t        }]}\n59\t        with mock.patch.object(WATCH, \"_probe_installed\", return_value=(\"0.166.0\", \"ok\")):\n60\t            report = WATCH.build_report(ledger, probe_installed=True)\n61\t        self.assertEqual(report[\"status\"], \"current\")\n62\t        self.assertFalse(report[\"components\"][0][\"drift\"])\n63\t        self.assertEqual(report[\"components\"][0][\"currency\"], \"compatible\")\n64\t\n65\t    def test_fu144_harness_uses_canonical_or_floor_only_fallback(self) -> None:\n66\t        harness = REPO_ROOT / \"scripts\" / \"_codex_harness.sh\"\n67\t        fallback = subprocess.run(\n68\t            [\"bash\", \"-c\", 'source \"$1\"; SOURCE_DIR=\"$2\"; _codex_pin_range', \"--\",\n69\t             str(harness), str(self.project_dir)],\n70\t            capture_output=True, text=True, check=False,\n71\t        )\n72\t        self.assertEqual(fallback.returncode, 0, fallback.stderr)\n73\t        self.assertEqual(fallback.stdout.strip(), \">=0.160.0\")\n74\t\n75\t    def test_fu144_pair_gate_reports_compatible_without_hash_claim(self) -> None:\n76\t        gate = self.project_dir / \".claude/scripts/local/pair-rail-gate.sh\"\n77\t        gate.parent.mkdir(parents=True)\n78\t        shutil.copy(REPO_ROOT / \".claude/scripts/local/pair-rail-gate.sh\", gate)\n79\t        gov = self.project_dir / \".claude/governance\"\n80\t        gov.mkdir(parents=True)\n81\t        (gov / \"codex-cli-pin.txt\").write_text(\">=0.160.0\\n\", encoding=\"utf-8\")\n82\t        (gov / \"codex-cli-pin-manifest.json\").write_text(\"{}\\n\", encoding=\"utf-8\")\n83\t        hook = self.project_dir / \".claude/hooks/check_pair_rail.py\"\n84\t        hook.parent.mkdir(parents=True)\n85\t        hook.write_text(\n86\t            \"import json\\nprint(json.dumps({'status': 'compatible'}))\\n\", encoding=\"utf-8\"\n87\t        )\n88\t        fake_bin = self._tmp_root / \"bin\"\n89\t        fake_bin.mkdir()\n90\t        codex = fake_bin / \"codex\"\n91\t        codex.write_text(\"#!/bin/sh\\necho 'codex 0.166.0'\\n\", encoding=\"utf-8\")\n92\t        codex.chmod(0o755)\n93\t        auth = self.home_dir / \".codex\"\n94\t        auth.mkdir(parents=True)\n95\t        (auth / \"auth.json\").write_text(\"{}\\n\", encoding=\"utf-8\")\n96\t        env = dict(os.environ, PATH=str(fake_bin) + os.pathsep + os.environ[\"PATH\"])\n97\t        proc = subprocess.run([\"bash\", str(gate), \"--phase\", \"6\"], cwd=self.project_dir,\n98\t                              env=env, capture_output=True, text=True, check=False)\n99\t        self.assertEqual(proc.returncode, 0, proc.stderr + proc.stdout)\n100\t        self.assertIn(\"version-floor compatible\", proc.stdout)\n101\t        self.assertNotIn(\"payload sha256 matches\", proc.stdout)\n102\t\n103\t\n104\tif __name__ == \"__main__\":\n105\t    unittest.main()\n106\t"}]},"parent_tool_use_id":null,"session_id":"dc5b5fe9-2c6b-46ea-80f3-b2c4ce2f3240","uuid":"a275202a-1c6f-4f59-985a-291b78ae465c","timestamp":"2026-11-13T18:28:59.161Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/tests/test_cli_floor_consumers.py","content":"\"\"\"Onda6B floor-consumer contracts (fu144).\"\"\"\nfrom __future__ import annotations\n\nimport importlib.util\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport unittest\nfrom pathlib import Path\nfrom unittest import mock\n\nREPO_ROOT = Path(__file__).resolve().parents[3]\nHOOKS_DIR = REPO_ROOT / \".claude\" / \"hooks\"\nif str(HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(HOOKS_DIR))\n\nfrom _lib.testing import TestEnvContext  # noqa: E402\n\n\ndef _module(name: str, rel: str):\n    spec = importlib.util.spec_from_file_location(name, REPO_ROOT / rel)\n    module = importlib.util.module_from_spec(spec)\n    assert spec.loader is not None\n    spec.loader.exec_module(module)\n    return module\n\n\nREP = _module(\"repin_floor\", \".claude/scripts/re-pin-codex.py\")\nDRIFT = _module(\"drift_floor\", \".claude/scripts/check-substrate-drift.py\")\nWATCH = _module(\"watch_floor\", \".claude/scripts/check-substrate-watch.py\")\n\n\nclass TestCliFloorConsumers(TestEnvContext):\n    def test_fu144_repin_preserves_unbounded_floor(self) -> None:\n        prefix, lower, upper = REP.parse_pin(\"# current\\n>=0.160.0\\n\")\n        self.assertEqual((prefix, lower, upper), ([\"# current\"], \"0.160.0\", None))\n        self.assertEqual(\n            REP.plan_range(lower, upper, (0, 166, 0)), (\">=0.160.0,<0.167.0\", True)\n        )\n\n    def test_fu144_drift_marks_newer_unbounded_release_info(self) -> None:\n        findings = DRIFT._codex_installed_findings(\n            self.project_dir,\n            {\"package_version\": \"0.160.0\", \"range\": \">=0.160.0\"},\n            \"0.166.0\",\n        )\n        self.assertEqual([(row[\"kind\"], row[\"severity\"]) for row in findings], [\n            (\"CODEX_INSTALLED_COMPATIBLE\", \"info\")\n        ])\n        self.assertEqual(findings[0][\"floor\"], \">=0.160.0\")\n\n    def test_fu144_watch_newer_codex_is_compatible_not_drift(self) -> None:\n        ledger = {\"_meta\": {}, \"components\": [{\n            \"key\": \"codex_cli\", \"label\": \"Codex\", \"last_seen\": {\n                \"version\": \"0.160.0\", \"date\": \"2026-10-01\"\n            }\n        }]}\n        with mock.patch.object(WATCH, \"_probe_installed\", return_value=(\"0.166.0\", \"ok\")):\n            report = WATCH.build_report(ledger, probe_installed=True)\n        self.assertEqual(report[\"status\"], \"current\")\n        self.assertFalse(report[\"components\"][0][\"drift\"])\n        self.assertEqual(report[\"components\"][0][\"currency\"], \"compatible\")\n\n    def test_fu144_harness_uses_canonical_or_floor_only_fallback(self) -> None:\n        harness = REPO_ROOT / \"scripts\" / \"_codex_harness.sh\"\n        fallback = subprocess.run(\n            [\"bash\", \"-c\", 'source \"$1\"; SOURCE_DIR=\"$2\"; _codex_pin_range', \"--\",\n             str(harness), str(self.project_dir)],\n            capture_output=True, text=True, check=False,\n        )\n        self.assertEqual(fallback.returncode, 0, fallback.stderr)\n        self.assertEqual(fallback.stdout.strip(), \">=0.160.0\")\n\n    def test_fu144_pair_gate_reports_compatible_without_hash_claim(self) -> None:\n        gate = self.project_dir / \".claude/scripts/local/pair-rail-gate.sh\"\n        gate.parent.mkdir(parents=True)\n        shutil.copy(REPO_ROOT / \".claude/scripts/local/pair-rail-gate.sh\", gate)\n        gov = self.project_dir / \".claude/governance\"\n        gov.mkdir(parents=True)\n        (gov / \"codex-cli-pin.txt\").write_text(\">=0.160.0\\n\", encoding=\"utf-8\")\n        (gov / \"codex-cli-pin-manifest.json\").write_text(\"{}\\n\", encoding=\"utf-8\")\n        hook = self.project_dir / \".claude/hooks/check_pair_rail.py\"\n        hook.parent.mkdir(parents=True)\n        hook.write_text(\n            \"import json\\nprint(json.dumps({'status': 'compatible'}))\\n\", encoding=\"utf-8\"\n        )\n        fake_bin = self._tmp_root / \"bin\"\n        fake_bin.mkdir()\n        codex = fake_bin / \"codex\"\n        codex.write_text(\"#!/bin/sh\\necho 'codex 0.166.0'\\n\", encoding=\"utf-8\")\n        codex.chmod(0o755)\n        auth = self.home_dir / \".codex\"\n        auth.mkdir(parents=True)\n        (auth / \"auth.json\").write_text(\"{}\\n\", encoding=\"utf-8\")\n        env = dict(os.environ, PATH=str(fake_bin) + os.pathsep + os.environ[\"PATH\"])\n        proc = subprocess.run([\"bash\", str(gate), \"--phase\", \"6\"], cwd=self.project_dir,\n                              env=env, capture_output=True, text=True, check=False)\n        self.assertEqual(proc.returncode, 0, proc.stderr + proc.stdout)\n        self.assertIn(\"version-floor compatible\", proc.stdout)\n        self.assertNotIn(\"payload sha256 matches\", proc.stdout)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":106,"startLine":1,"totalLines":106}},"tool_result_meta":[{"id":"toolu_018vXSqtVJAmfANqyoT2C1C6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
