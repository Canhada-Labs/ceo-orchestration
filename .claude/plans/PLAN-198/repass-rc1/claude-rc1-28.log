\"),\n223\t            \"label\": comp.get(\"label\", comp.get(\"key\", \"?\")),\n224\t            \"last_seen_version\": seen_version,\n225\t            \"last_seen_date\": str(last_seen.get(\"date\", \"unknown\")),\n226\t            \"installed_version\": None,\n227\t            \"probe_note\": \"not probed (--probe-installed off)\",\n228\t            \"drift\": False,\n229\t            \"runbook\": None,\n230\t        }\n231\t        if seen_version == \"unknown\":\n232\t            any_unknown = True\n233\t        if probe_installed:\n234\t            installed, note = _probe_installed(str(comp.get(\"key\", \"\")))\n235\t            row[\"installed_version\"] = installed\n236\t            row[\"probe_note\"] = note\n237\t            codex_current = (\n238\t                str(comp.get(\"key\", \"\")) in (\"codex_cli\", \"codex_harness\")\n239\t                and cli_currency.compare_semver(\n240\t                    installed, cli_currency.CODEX_VERSION_FLOOR\n241\t                ) is not None\n242\t                and cli_currency.compare_semver(\n243\t                    installed, cli_currency.CODEX_VERSION_FLOOR\n244\t                ) >= 0\n245\t            )\n246\t            if installed is not None and codex_current:\n247\t                row[\"currency\"] = \"compatible\"\n248\t            elif installed is not None and seen_version != \"unknown\" and installed != seen_version:\n249\t                row[\"drift\"] = True\n250\t                any_drift = True\n251\t                # Attach the code-registered runbook (None-safe): the alert\n252\t                # names the fixture re-record procedure, not just the delta.\n253\t                row[\"runbook\"] = _DRIFT_RUNBOOKS.get(str(comp.get(\"key\", \"\")))\n254\t        rows.append(row)\n255\t\n256\t    if source_stale or any_unknown:\n257\t        status = \"stale-ledger\"\n258\t        summary = (\n259\t            \"substrate-watch ledger never Owner-refreshed against the live \"\n260\t        