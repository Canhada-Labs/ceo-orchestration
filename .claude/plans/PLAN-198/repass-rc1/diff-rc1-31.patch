-            continue
-        try:
-            text = f.read_text(encoding="utf-8", errors="replace")
-        except OSError:
-            continue
-        # Find Status line (first match wins)
-        status_match = _ADR_STATUS_RE.search(text)
-        if not status_match:
-            continue
-        status_value = status_match.group(1).strip()
-        if "ACCEPTED" not in status_value.upper():
