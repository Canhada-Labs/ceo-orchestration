-            continue
-
-        # Capture body until next H2 or EOF
-        start = header_match.end()
-        next_h2 = re.search(r"^##\s+", text[start:], re.MULTILINE)
-        body_end = start + next_h2.start() if next_h2 else len(text)
-        body = text[start:body_end]
