+# Substitution openers. `$(<U+2026>)` tokenizes as `$` + `(` under this hook's
+# punctuation_chars, and `` ` `` is its own token.
+_E4_SUBST_OPENERS = frozenset({"$", "`"})
+_E4_SUBST_CLOSERS = frozenset({")", "`"})
+
