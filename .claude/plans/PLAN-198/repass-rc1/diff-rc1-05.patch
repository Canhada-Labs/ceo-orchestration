+        ack = (_trusted_env.get_trusted(_GIT_BYPASS_ALLOW_ACK_VAR) or "").strip()
+    except Exception:  # pragma: no cover
+        return False
+    return bool(
+        reason
+        and ack == "I-ACCEPT"
+        and _GIT_BYPASS_TICKET_RE.match(reason)
+    )
