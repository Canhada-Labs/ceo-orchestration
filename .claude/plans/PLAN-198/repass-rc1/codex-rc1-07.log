from __future__ import annotations

def _get_plan_paths() -> List[Path]:
    """Return sorted PLAN-*.md paths, using a module-level cache."""
    global _PLAN_GLOB_CACHE
    if _PLAN_GLOB_CACHE is None:
        _PLAN_GLOB_CACHE = sorted(
