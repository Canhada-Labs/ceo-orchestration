+        f" / min={s.get('min_ms', 0):.1f} / max={s.get('max_ms', 0):.1f}"
+        f" | rss_delta={s.get('rss_delta_kb', 0):.1f} |"
+    )
+    lines.append("")
+    return "\n".join(lines)
