    44	        # separator so sentinel-declared paths match target_rel
    45	        # resolution consistently.
    46	        normalized = _os.path.normpath(raw).replace(_os.sep, "/")
    47	        if normalized == ".":
    48	            continue
    49	        declared_paths.add(normalized)
