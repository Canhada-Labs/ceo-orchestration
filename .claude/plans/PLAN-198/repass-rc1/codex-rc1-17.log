        audit_emit.emit_veto_triggered(
            hook="check_canonical_edit",
            reason_code=reason_code,
            reason_preview=_preview,
            blocked_tool=_blocked_tool_field(),  # PLAN162_FIX_9
            project=os.environ.get("CLAUDE_PROJECT_DIR") or "",
        )
