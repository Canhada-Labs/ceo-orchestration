   956	def scan(
   957	    text: str,
   958	    *,
   959	    patterns: Optional[List[SecretPattern]] = None,
   960	    budget_seconds: float = 0.5,
   961	    normalize_unicode: bool = True,
   962	) -> List[Finding]:
   963	    """Scan text for matches against the catalog. ReDoS-guarded.
   964	
   965	    Matches the historical frame -- the NFKC view when ``normalize_unicode``
   966	    is on, else ``text`` -- and, when that view differs from ``text``, also
   967	    ``text`` itself, and returns the union. Every offset indexes ``text``:
   968	    NFKC-frame spans are mapped back through the segment map (they may
   969	    over-cover, never under-cover).
