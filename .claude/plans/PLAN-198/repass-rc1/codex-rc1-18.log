-            if current >= self.per_minute:
-                return False
-            self._buckets[key] = current + 1
-            return True
-
-    def _prune_locked(self, current_bucket: int) -> None:
-        cutoff = current_bucket - 2
-        stale = [k for k in self._buckets if k[2] < cutoff]
-        for k in stale:
-            del self._buckets[k]
