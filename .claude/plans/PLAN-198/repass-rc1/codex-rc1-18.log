-        if not isinstance(scopes_list, (list, tuple)):
-            scopes_list = []
-        _safe_emit(
-            "federation_scope_denied",
-            peer_id=peer_id[:64],
-            route=route[:64],
-            required_scope=required_scope[:32],
-            peer_scopes_count=int(len(scopes_list)),
-        )
-
-    def _emit_write_endpoint_denied(
-        self,
-        peer_id: str,
