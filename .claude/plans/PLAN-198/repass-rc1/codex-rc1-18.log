+"""Anchored model-family currency rules for PLAN-176."""
+from __future__ import annotations
+
+import re
+from typing import Iterable, Optional
+
+_RETIRED = frozenset({"claude-opus-4-1"})
+_LEGACY_WORKING = frozenset({"claude-fable-5", "claude-fable-5-1"})
+_LEGACY_FLOOR = frozenset({"claude-fable-5"})
+_TAIL = r"(?:[.-][0-9]+)*(?:-[a-z][a-z0-9]*)*"
+_ALLOWED = re.compile(
+    r"^(?:claude-(?:opus|sonnet|haiku)-[4-9]" + _TAIL
+    + r"|gpt-[5-9]" + _TAIL + r"|o[3-9]" + _TAIL
+    + r"|gemini-[2-9]" + _TAIL + r"|grok-[3-9]" + _TAIL + r")$"
+)
+_FLOOR = re.compile(r"^(?:claude-opus-[4-9]" + _TAIL + r"|gpt-[5-9]" + _TAIL + r"|o[3-9]" + _TAIL + r")$")
+_PREFIXES = tuple(
+    ["claude-%s-%d" % (family, major) for family in ("opus", "sonnet", "haiku") for major in range(4, 10)]
+    + ["gpt-%d" % major for major in range(5, 10)]
+    + ["o%d" % major for major in range(3, 10)]
+    + ["gemini-%d" % major for major in range(2, 10)]
+    + ["grok-%d" % major for major in range(3, 10)]
+)
+
+
+def _explicit(name: str, models: Optional[Iterable[str]]) -> bool:
+    return models is not None and name in frozenset(models)
+
+
+def availability_entries(explicit_models: Iterable[str]) -> list:
+    """Stable explicit IDs followed by native major-version availability prefixes."""
+    out = []
+    for model in list(explicit_models) + list(_PREFIXES):
+        if model not in out:
+            out.append(model)
+    return out
+
+
+def is_allowed_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:
+    """Accept approved semantic families or an explicit legacy working ID."""
+    return isinstance(name, str) and name not in _RETIRED and (
+        bool(_ALLOWED.fullmatch(name)) or _explicit(name, explicit_models)
+        or (explicit_models is None and name in _LEGACY_WORKING)
+    )
+
+
+def is_veto_floor_model(name: object, explicit_models: Optional[Iterable[str]] = None) -> bool:
+    """Accept VETO-capable families or an explicit legacy floor ID."""
+    return isinstance(name, str) and name not in _RETIRED and (
+        bool(_FLOOR.fullmatch(name)) or _explicit(name, explicit_models)
+        or (explicit_models is None and name in _LEGACY_FLOOR)
+    )
+
+
+def main(argv: Optional[list] = None) -> int:
+    """Exit 0 for an admitted model, 1 for rejection, 2 for invalid usage."""
+    import sys
+
+    args = list(sys.argv[1:] if argv is None else argv)
+    veto = args[:1] == ["--veto"]
+    if veto:
+        args = args[1:]
+    if len(args) != 1:
+        return 2
+    predicate = is_veto_floor_model if veto else is_allowed_model
+    return 0 if predicate(args[0]) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/.claude/hooks/_lib/pii_patterns.py b/.claude/hooks/_lib/pii_patterns.py
index 77e0b9bbb5e7..811a264a9f79 100644
--- a/.claude/hooks/_lib/pii_patterns.py
+++ b/.claude/hooks/_lib/pii_patterns.py
@@ -733,4 +733,9 @@ def _apply_redactions(text: str, matches: List[Match]) -> str:
 
-    Overlapping matches are resolved by processing right-to-left so earlier
-    spans' offsets remain valid during replacement.
+    Spans are merged into their UNION before splicing. The previous
+    right-to-left walk SKIPPED a container whose contained span had been
+    spliced first, so the container's head and tail survived in cleartext
+    (the rest of an ``aws_secret_key=`` value after an AKIA-shaped prefix;
+    the tail of a Bearer token after its JWT). A merged run carries the
+    token of its leftmost (then longest) match. ``matches`` must index
+    ``text`` (every caller passes spans found on that same string).
     """
@@ -738,14 +743,17 @@ def _apply_redactions(text: str, matches: List[Match]) -> str:
         return text
-    # Sort descending by start so replacements don't shift later offsets
-    spans = sorted(matches, key=lambda m: m.start, reverse=True)
-    buf = text
-    covered_end = len(text) + 1
-    for m in spans:
-        # Skip if nested inside a higher-priority span already redacted
-        if m.end > covered_end:
-            continue
-        token = f"[REDACTED:{m.family.upper()}]"
-        buf = buf[: m.start] + token + buf[m.end :]
-        covered_end = m.start
-    return buf
+    runs: List[Tuple[int, int, str]] = []  # (start, end, token)
+    for m in sorted(matches, key=lambda x: (x.start, -x.end)):
+        if runs and m.start < runs[-1][1]:
+            start, end, token = runs[-1]
+            runs[-1] = (start, max(end, m.end), token)
+        else:
+            runs.append((m.start, m.end, f"[REDACTED:{m.family.upper()}]"))
+    parts: List[str] = []
+    pos = 0
+    for start, end, token in runs:
+        parts.append(text[pos:start])
+        parts.append(token)
+        pos = end
+    parts.append(text[pos:])
+    return "".join(parts)
 
diff --git a/.claude/hooks/_lib/plan_paths.py b/.claude/hooks/_lib/plan_paths.py
new file mode 100644
index 000000000000..328e37bc0eb2
--- /dev/null
+++ b/.claude/hooks/_lib/plan_paths.py
@@ -0,0 +1,37 @@
+"""Shared PLAN filename and path matching for lifecycle consumers.
+
+The filename grammar is the authoritative PLAN-SCHEMA.md §1.4 pattern.
+Paths are normalized before matching so hooks receive the same result from
+relative, absolute, POSIX, and Windows-style tool payloads.
+"""
+
+from __future__ import annotations
+
+import re
+
+
+PLAN_FILENAME_RE = re.compile(
+    r"^PLAN-[0-9]{3}(-FOLLOWUP)?-[a-z0-9]+(-[a-z0-9]+)*\.md$"
+)
+
+def is_plan_path(file_path: str) -> bool:
+    """Return whether ``file_path`` names a schema-valid plan file."""
+    if not file_path:
+        return False
+    parent, _, filename = str(file_path).replace("\\", "/").rpartition("/")
+    in_plans = parent == ".claude/plans" or parent.endswith("/.claude/plans")
+    return in_plans and PLAN_FILENAME_RE.fullmatch(filename) is not None
+
+
+def plan_id_from_path(file_path: str) -> str:
+    """Return ``PLAN-NNN`` from a schema-valid path, otherwise ``""``."""
+    if not file_path:
+        return ""
+    normalized = str(file_path).replace("\\", "/")
+    filename = normalized.rsplit("/", 1)[-1]
+    if not PLAN_FILENAME_RE.fullmatch(filename):
+        return ""
+    return filename[:8]
+
+
+__all__ = ["PLAN_FILENAME_RE", "is_plan_path", "plan_id_from_path"]
