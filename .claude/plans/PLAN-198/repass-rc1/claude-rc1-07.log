{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DdwuFoAkZuHxhLgespu7rD","type":"tool_result","content":"1\t\"\"\"PLAN-188: ADR-010 scope plus real, isolated GPG detached signatures.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport hashlib\n6\timport os\n7\timport shutil\n8\timport subprocess\n9\timport sys\n10\timport tempfile\n11\tfrom pathlib import Path\n12\t\n13\timport pytest\n14\t\n15\t_HOOKS = Path(__file__).resolve().parents[2] / \"hooks\"\n16\tsys.path.insert(0, str(_HOOKS))\n17\tfrom _lib._ceremony_toolkit import (  # noqa: E402\n18\t    build_ceremony_summary,\n19\t    collect_modified_canonical_paths,\n20\t    validate_sentinel_pack,\n21\t    verify_detached_signatures,\n22\t)\n23\tfrom _subprocess_helpers import run_in_process_group  # noqa: E402\n24\t\n25\t\n26\t@pytest.fixture\n27\tdef pack(tmp_path):\n28\t    root = tmp_path / \"repo\"\n29\t    root.mkdir()\n30\t    guarded = root / \".claude/team.md\"\n31\t    guarded.parent.mkdir()\n32\t    guarded.write_text(\"team=original\\n\", encoding=\"utf-8\")\n33\t    sentinel = root / \"approved.md\"\n34\t    sentinel.write_text(\n35\t        \"---\\nplan: PLAN-188\\nround: 1\\ntype: architect-sentinel\\n---\\n\\n\"\n36\t        \"Approved-By: @owner \" + \"a\" * 40 + \"\\n\"\n37\t        \"Approved-At: 2026-11-01T10:00:00Z\\n\"\n38\t        \"Scope:\\n  - .claude/team.md\\n\",\n39\t        encoding=\"utf-8\",\n40\t    )\n41\t    return root, sentinel, guarded\n42\t\n43\t\n44\tdef _validate(pack, paths=(\".claude/team.md\",), **kwargs):\n45\t    root, sentinel, _ = pack\n46\t    return validate_sentinel_pack(\n47\t        root, sentinel, paths, canonical_patterns=(\".claude/team.md\", \".claude/skills/**/SKILL.md\"), **kwargs\n48\t    )\n49\t\n50\t\n51\tdef test_scope_exact_match(pack):\n52\t    result = _validate(pack)\n53\t    assert result[\"valid\"] is True\n54\t    assert result[\"canonical_paths\"] == (\".claude/team.md\",)\n55\t\n56\t\n57\tdef test_scope_missing_canonical_change_rejected(pack):\n58\t    result = _validate(pack, (\".claude/team.md\", \".claude/skills/other/SKILL.md\"))\n59\t    assert result[\"valid\"] is False\n60\t    assert result[\"reason\"] == \"scope_diff_mismatch\"\n61\t\n62\t\n63\tdef test_scope_extra_unmodified_change_rejected(pack):\n64\t    root, sentinel, _ = pack\n65\t    sentinel.write_text(sentinel.read_text().replace(\"Scope:\\n\", \"Scope:\\n  - .claude/skills/other/SKILL.md\\n\"))\n66\t    result = _validate(pack)\n67\t    assert result[\"valid\"] is False\n68\t    assert result[\"reason\"] == \"scope_diff_mismatch\"\n69\t\n70\t\n71\tdef test_missing_approval_line_rejected(pack):\n72\t    root, sentinel, _ = pack\n73\t    sentinel.write_text(sentinel.read_text().replace(\"Approved-By:\", \"Reviewer:\"))\n74\t    assert _validate(pack)[\"reason\"] == \"approved_by_missing_or_ambiguous\"\n75\t\n76\t\n77\tdef test_two_separated_scope_blocks_rejected(pack):\n78\t    _, sentinel, _ = pack\n79\t    sentinel.write_text(sentinel.read_text() + \"\\nExplanation: unrelated\\n\\nScope:\\n  - .claude/team.md\\n\")\n80\t    result = _validate(pack)\n81\t    assert result[\"valid\"] is False\n82\t    assert result[\"reason\"] == \"duplicate_scope\"\n83\t\n84\t\n85\tdef test_traversal_in_diff_rejected(pack):\n86\t    result = _validate(pack, (\"../.claude/team.md\",))\n87\t    assert result[\"valid\"] is False\n88\t    assert result[\"reason\"] == \"unsafe_path\"\n89\t\n90\t\n91\tdef test_canonical_segment_matching_not_recursive_single_star(pack):\n92\t    root, _, _ = pack\n93\t    result = collect_modified_canonical_paths(\n94\t        root, (\"docs/nope\", \".claude/skills/one/two/SKILL.md\", \".claude/skills/one/SKILL.md\"),\n95\t        canonical_patterns=(\".claude/skills/*/SKILL.md\",),\n96\t    )\n97\t    assert result == (\".claude/skills/one/SKILL.md\",)\n98\t\n99\t\n100\tdef test_sha256_pins_remeasured_after_content_change(pack):\n101\t    root, _, guarded = pack\n102\t    digest = hashlib.sha256(guarded.read_bytes()).hexdigest()\n103\t    assert _validate(pack, expected_sha256={\".claude/team.md\": digest})[\"valid\"]\n104\t    guarded.write_text(\"team=tampered\\n\")\n105\t    result = _validate(pack, expected_sha256={\".claude/team.md\": digest})\n106\t    assert result[\"valid\"] is False\n107\t    assert result[\"reason\"] == \"sha256_pin_mismatch\"\n108\t    assert result[\"sha256\"][\".claude/team.md\"] != digest\n109\t\n110\t\n111\tdef test_summary_cannot_claim_owner_approval_without_signature(pack):\n112\t    summary = build_ceremony_summary(_validate(pack), {\"valid\": False, \"fingerprint\": \"\", \"reason\": \"unsigned\"})\n113\t    assert summary[\"ready_for_owner_review\"] is False\n114\t    assert summary[\"signed_or_landed_by_toolkit\"] is False\n115\t    assert summary[\"reason\"] == \"unsigned\"\n116\t\n117\t\n118\tdef test_signature_rejects_empty_allowlist_before_running_gpg(tmp_path):\n119\t    home = tmp_path / \"keyring\"\n120\t    home.mkdir()\n121\t    signed = tmp_path / \"signed.md\"\n122\t    sig = tmp_path / \"signed.md.asc\"\n123\t    signed.write_text(\"content\")\n124\t    sig.write_text(\"fake gpg signature\")\n125\t    result = verify_detached_signatures(signed, sig, keyring_home=home, allowed_fingerprints=[])\n126\t    assert result[\"valid\"] is False\n127\t    assert result[\"reason\"] == \"invalid_or_empty_fingerprint_allowlist\"\n128\t\n129\t\n130\tdef test_signature_does_not_fallback_to_personal_keyring(tmp_path):\n131\t    signed = tmp_path / \"signed.md\"\n132\t    sig = tmp_path / \"signed.md.asc\"\n133\t    signed.write_text(\"content\")\n134\t    sig.write_text(\"fake gpg signature\")\n135\t    result = verify_detached_signatures(\n136\t        signed, sig, keyring_home=tmp_path / \"absent\", allowed_fingerprints=[\"A\" * 40]\n137\t    )\n138\t    assert result[\"valid\"] is False\n139\t    assert result[\"reason\"] == \"explicit_keyring_required\"\n140\t\n141\t\n142\t#: gpg derives its agent socket paths (longest: S.gpg-agent.browser) from\n143\t#: --homedir. A unix socket address holds 104 bytes on macOS and 108 on Linux;\n144\t#: pytest's tmp_path under a long TMPDIR exceeded it on macOS and the key\n145\t#: import failed with \"can't connect to the gpg-agent: File name too long\".\n146\t_SOCKET_PATH_LIMIT = 100\n147\t\n148\t\n149\tdef _short_gnupg_home() -> Path:\n150\t    \"\"\"A fresh 0700 home whose agent socket paths fit a unix socket address.\"\"\"\n151\t    for base in (tempfile.gettempdir(), \"/tmp\"):\n152\t        if len(os.path.join(base, \"gpg-XXXXXXXX\", \"S.gpg-agent.browser\")) < _SOCKET_PATH_LIMIT:\n153\t            return Path(tempfile.mkdtemp(prefix=\"gpg-\", dir=base))\n154\t    pytest.fail(\"no temporary directory short enough for a gpg home\")\n155\t\n156\t\n157\tdef _discard_gnupg_home(home: Path) -> None:\n158\t    \"\"\"Stop any daemon bound to the home, then delete it (it lives outside tmp_path).\n159\t\n160\t    Every gpg call here passes --no-autostart, so there is normally nothing to\n161\t    stop; the kill is a bounded precaution and its exit status is not a verdict.\n162\t    \"\"\"\n163\t    gpgconf = shutil.which(\"gpgconf\")\n164\t    try:\n165\t        if gpgconf:\n166\t            run_in_process_group(\n167\t                [gpgconf, \"--homedir\", str(home), \"--kill\", \"all\"],\n168\t                capture_output=True, timeout=25,\n169\t            )\n170\t    finally:\n171\t        shutil.rmtree(home, ignore_errors=True)\n172\t\n173\t\n174\t@pytest.fixture(scope=\"module\")\n175\tdef signed_fixture(tmp_path_factory, request):\n176\t    binary = shutil.which(\"gpg\")\n177\t    if not binary:\n178\t        pytest.skip(\"gpg ausente; verificacao real impossivel\")\n179\t    root = tmp_path_factory.mktemp(\"ceremony-gpg\")\n180\t    home = _short_gnupg_home()\n181\t    request.addfinalizer(lambda: _discard_gnupg_home(home))\n182\t    sample = root / \"signed.md\"\n183\t    signature = root / \"signed.md.asc\"\n184\t    # Historic signature fixture, not a new approval or test-generated key.\n185\t    # SP-042's tracked bytes verify under .claude/trust/owner.asc; SP-026\n186\t    # currently fails GPG (BADSIG), so its presence alone proves nothing.\n187\t    claude = Path(__file__).resolve().parents[2]\n188\t    proposal = claude / \"proposals/SP-042-cross-llm-pair-review-lint-fm-10-2026-07-10.md\"\n189\t    shutil.copy2(proposal, sample)\n190\t    shutil.copy2(Path(str(proposal) + \".asc\"), signature)\n191\t    public_key = root / \"owner.asc\"\n192\t    shutil.copy2(claude / \"trust/owner.asc\", public_key)\n193\t\n194\t    def run(*arguments):\n195\t        return run_in_process_group(\n196\t            [binary, \"--no-options\", \"--no-autostart\", \"--homedir\", str(home), \"--batch\", *arguments],\n197\t            capture_output=True, text=True, check=True, timeout=25,\n198\t        )\n199\t\n200\t    run(\"--import\", str(public_key))\n201\t    listing = run(\"--with-colons\", \"--fingerprint\", \"--list-keys\").stdout\n202\t    fingerprint = next(row.split(\":\")[9] for row in listing.splitlines() if row.startswith(\"fpr:\"))\n203\t    return home, sample, signature, fingerprint\n204\t\n205\t\n206\tdef test_detached_gpg_signature_validates_real_bytes(signed_fixture):\n207\t    home, sample, signature, fingerprint = signed_fixture\n208\t    result = verify_detached_signatures(sample, signature, keyring_home=home, allowed_fingerprints=[fingerprint])\n209\t    assert result == {\"valid\": True, \"fingerprint\": fingerprint, \"reason\": \"\"}\n210\t\n211\t\n212\tdef test_detached_gpg_rejects_tampered_payload(signed_fixture, tmp_path):\n213\t    home, sample, signature, fingerprint = signed_fixture\n214\t    tampered = tmp_path / \"signed.md\"\n215\t    tampered.write_text(sample.read_text() + \"malicious change\\n\")\n216\t    result = verify_detached_signatures(tampered, signature, keyring_home=home, allowed_fingerprints=[fingerprint])\n217\t    assert result[\"valid\"] is False\n218\t    assert result[\"reason\"] == \"gpg_invalid_signature\"\n219\t\n220\t\n221\tdef test_detached_gpg_rejects_signer_not_allowlisted(signed_fixture):\n222\t    home, sample, signature, _ = signed_fixture\n223\t    result = verify_detached_signatures(sample, signature, keyring_home=home, allowed_fingerprints=[\"F\" * 40])\n224\t    assert result[\"valid\"] is False\n225\t    assert result[\"reason\"] == \"signer_not_allowlisted\"\n226\t\n227\t\n228\tdef test_detached_gpg_rejects_missing_explicit_keyring(signed_fixture, tmp_path):\n229\t    _, sample, signature, fingerprint = signed_fixture\n230\t    result = verify_detached_signatures(sample, signature, keyring_home=tmp_path / \"missing\", allowed_fingerprints=[fingerprint])\n231\t    assert result[\"valid\"] is False\n232\t    assert result[\"reason\"] == \"explicit_keyring_required\"\n233\t\n234\t\n235\tdef test_detached_gpg_rejects_symlink_signature(signed_fixture, tmp_path):\n236\t    home, sample, signature, fingerprint = signed_fixture\n237\t    link = tmp_path / \"signature.asc\"\n238\t    link.symlink_to(signature)\n239\t    result = verify_detached_signatures(sample, link, keyring_home=home, allowed_fingerprints=[fingerprint])\n240\t    assert result[\"valid\"] is False\n241\t    assert result[\"reason\"] == \"signed_file_or_signature_missing\"\n242\t"}]},"parent_tool_use_id":null,"session_id":"1aeb651e-484c-4168-99bd-f9adce0be74b","uuid":"d8c9f31b-85c5-4b04-8ac4-6e879626631a","timestamp":"2026-11-13T16:48:04.433Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/tests/test_plan188_ceremony_toolkit.py","content":"\"\"\"PLAN-188: ADR-010 scope plus real, isolated GPG detached signatures.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\n\nimport pytest\n\n_HOOKS = Path(__file__).resolve().parents[2] / \"hooks\"\nsys.path.insert(0, str(_HOOKS))\nfrom _lib._ceremony_toolkit import (  # noqa: E402\n    build_ceremony_summary,\n    collect_modified_canonical_paths,\n    validate_sentinel_pack,\n    verify_detached_signatures,\n)\nfrom _subprocess_helpers import run_in_process_group  # noqa: E402\n\n\n@pytest.fixture\ndef pack(tmp_path):\n    root = tmp_path / \"repo\"\n    root.mkdir()\n    guarded = root / \".claude/team.md\"\n    guarded.parent.mkdir()\n    guarded.write_text(\"team=original\\n\", encoding=\"utf-8\")\n    sentinel = root / \"approved.md\"\n    sentinel.write_text(\n        \"---\\nplan: PLAN-188\\nround: 1\\ntype: architect-sentinel\\n---\\n\\n\"\n        \"Approved-By: @owner \" + \"a\" * 40 + \"\\n\"\n        \"Approved-At: 2026-11-01T10:00:00Z\\n\"\n        \"Scope:\\n  - .claude/team.md\\n\",\n        encoding=\"utf-8\",\n    )\n    return root, sentinel, guarded\n\n\ndef _validate(pack, paths=(\".claude/team.md\",), **kwargs):\n    root, sentinel, _ = pack\n    return validate_sentinel_pack(\n        root, sentinel, paths, canonical_patterns=(\".claude/team.md\", \".claude/skills/**/SKILL.md\"), **kwargs\n    )\n\n\ndef test_scope_exact_match(pack):\n    result = _validate(pack)\n    assert result[\"valid\"] is True\n    assert result[\"canonical_paths\"] == (\".claude/team.md\",)\n\n\ndef test_scope_missing_canonical_change_rejected(pack):\n    result = _validate(pack, (\".claude/team.md\", \".claude/skills/other/SKILL.md\"))\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"scope_diff_mismatch\"\n\n\ndef test_scope_extra_unmodified_change_rejected(pack):\n    root, sentinel, _ = pack\n    sentinel.write_text(sentinel.read_text().replace(\"Scope:\\n\", \"Scope:\\n  - .claude/skills/other/SKILL.md\\n\"))\n    result = _validate(pack)\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"scope_diff_mismatch\"\n\n\ndef test_missing_approval_line_rejected(pack):\n    root, sentinel, _ = pack\n    sentinel.write_text(sentinel.read_text().replace(\"Approved-By:\", \"Reviewer:\"))\n    assert _validate(pack)[\"reason\"] == \"approved_by_missing_or_ambiguous\"\n\n\ndef test_two_separated_scope_blocks_rejected(pack):\n    _, sentinel, _ = pack\n    sentinel.write_text(sentinel.read_text() + \"\\nExplanation: unrelated\\n\\nScope:\\n  - .claude/team.md\\n\")\n    result = _validate(pack)\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"duplicate_scope\"\n\n\ndef test_traversal_in_diff_rejected(pack):\n    result = _validate(pack, (\"../.claude/team.md\",))\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"unsafe_path\"\n\n\ndef test_canonical_segment_matching_not_recursive_single_star(pack):\n    root, _, _ = pack\n    result = collect_modified_canonical_paths(\n        root, (\"docs/nope\", \".claude/skills/one/two/SKILL.md\", \".claude/skills/one/SKILL.md\"),\n        canonical_patterns=(\".claude/skills/*/SKILL.md\",),\n    )\n    assert result == (\".claude/skills/one/SKILL.md\",)\n\n\ndef test_sha256_pins_remeasured_after_content_change(pack):\n    root, _, guarded = pack\n    digest = hashlib.sha256(guarded.read_bytes()).hexdigest()\n    assert _validate(pack, expected_sha256={\".claude/team.md\": digest})[\"valid\"]\n    guarded.write_text(\"team=tampered\\n\")\n    result = _validate(pack, expected_sha256={\".claude/team.md\": digest})\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"sha256_pin_mismatch\"\n    assert result[\"sha256\"][\".claude/team.md\"] != digest\n\n\ndef test_summary_cannot_claim_owner_approval_without_signature(pack):\n    summary = build_ceremony_summary(_validate(pack), {\"valid\": False, \"fingerprint\": \"\", \"reason\": \"unsigned\"})\n    assert summary[\"ready_for_owner_review\"] is False\n    assert summary[\"signed_or_landed_by_toolkit\"] is False\n    assert summary[\"reason\"] == \"unsigned\"\n\n\ndef test_signature_rejects_empty_allowlist_before_running_gpg(tmp_path):\n    home = tmp_path / \"keyring\"\n    home.mkdir()\n    signed = tmp_path / \"signed.md\"\n    sig = tmp_path / \"signed.md.asc\"\n    signed.write_text(\"content\")\n    sig.write_text(\"fake gpg signature\")\n    result = verify_detached_signatures(signed, sig, keyring_home=home, allowed_fingerprints=[])\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"invalid_or_empty_fingerprint_allowlist\"\n\n\ndef test_signature_does_not_fallback_to_personal_keyring(tmp_path):\n    signed = tmp_path / \"signed.md\"\n    sig = tmp_path / \"signed.md.asc\"\n    signed.write_text(\"content\")\n    sig.write_text(\"fake gpg signature\")\n    result = verify_detached_signatures(\n        signed, sig, keyring_home=tmp_path / \"absent\", allowed_fingerprints=[\"A\" * 40]\n    )\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"explicit_keyring_required\"\n\n\n#: gpg derives its agent socket paths (longest: S.gpg-agent.browser) from\n#: --homedir. A unix socket address holds 104 bytes on macOS and 108 on Linux;\n#: pytest's tmp_path under a long TMPDIR exceeded it on macOS and the key\n#: import failed with \"can't connect to the gpg-agent: File name too long\".\n_SOCKET_PATH_LIMIT = 100\n\n\ndef _short_gnupg_home() -> Path:\n    \"\"\"A fresh 0700 home whose agent socket paths fit a unix socket address.\"\"\"\n    for base in (tempfile.gettempdir(), \"/tmp\"):\n        if len(os.path.join(base, \"gpg-XXXXXXXX\", \"S.gpg-agent.browser\")) < _SOCKET_PATH_LIMIT:\n            return Path(tempfile.mkdtemp(prefix=\"gpg-\", dir=base))\n    pytest.fail(\"no temporary directory short enough for a gpg home\")\n\n\ndef _discard_gnupg_home(home: Path) -> None:\n    \"\"\"Stop any daemon bound to the home, then delete it (it lives outside tmp_path).\n\n    Every gpg call here passes --no-autostart, so there is normally nothing to\n    stop; the kill is a bounded precaution and its exit status is not a verdict.\n    \"\"\"\n    gpgconf = shutil.which(\"gpgconf\")\n    try:\n        if gpgconf:\n            run_in_process_group(\n                [gpgconf, \"--homedir\", str(home), \"--kill\", \"all\"],\n                capture_output=True, timeout=25,\n            )\n    finally:\n        shutil.rmtree(home, ignore_errors=True)\n\n\n@pytest.fixture(scope=\"module\")\ndef signed_fixture(tmp_path_factory, request):\n    binary = shutil.which(\"gpg\")\n    if not binary:\n        pytest.skip(\"gpg ausente; verificacao real impossivel\")\n    root = tmp_path_factory.mktemp(\"ceremony-gpg\")\n    home = _short_gnupg_home()\n    request.addfinalizer(lambda: _discard_gnupg_home(home))\n    sample = root / \"signed.md\"\n    signature = root / \"signed.md.asc\"\n    # Historic signature fixture, not a new approval or test-generated key.\n    # SP-042's tracked bytes verify under .claude/trust/owner.asc; SP-026\n    # currently fails GPG (BADSIG), so its presence alone proves nothing.\n    claude = Path(__file__).resolve().parents[2]\n    proposal = claude / \"proposals/SP-042-cross-llm-pair-review-lint-fm-10-2026-07-10.md\"\n    shutil.copy2(proposal, sample)\n    shutil.copy2(Path(str(proposal) + \".asc\"), signature)\n    public_key = root / \"owner.asc\"\n    shutil.copy2(claude / \"trust/owner.asc\", public_key)\n\n    def run(*arguments):\n        return run_in_process_group(\n            [binary, \"--no-options\", \"--no-autostart\", \"--homedir\", str(home), \"--batch\", *arguments],\n            capture_output=True, text=True, check=True, timeout=25,\n        )\n\n    run(\"--import\", str(public_key))\n    listing = run(\"--with-colons\", \"--fingerprint\", \"--list-keys\").stdout\n    fingerprint = next(row.split(\":\")[9] for row in listing.splitlines() if row.startswith(\"fpr:\"))\n    return home, sample, signature, fingerprint\n\n\ndef test_detached_gpg_signature_validates_real_bytes(signed_fixture):\n    home, sample, signature, fingerprint = signed_fixture\n    result = verify_detached_signatures(sample, signature, keyring_home=home, allowed_fingerprints=[fingerprint])\n    assert result == {\"valid\": True, \"fingerprint\": fingerprint, \"reason\": \"\"}\n\n\ndef test_detached_gpg_rejects_tampered_payload(signed_fixture, tmp_path):\n    home, sample, signature, fingerprint = signed_fixture\n    tampered = tmp_path / \"signed.md\"\n    tampered.write_text(sample.read_text() + \"malicious change\\n\")\n    result = verify_detached_signatures(tampered, signature, keyring_home=home, allowed_fingerprints=[fingerprint])\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"gpg_invalid_signature\"\n\n\ndef test_detached_gpg_rejects_signer_not_allowlisted(signed_fixture):\n    home, sample, signature, _ = signed_fixture\n    result = verify_detached_signatures(sample, signature, keyring_home=home, allowed_fingerprints=[\"F\" * 40])\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"signer_not_allowlisted\"\n\n\ndef test_detached_gpg_rejects_missing_explicit_keyring(signed_fixture, tmp_path):\n    _, sample, signature, fingerprint = signed_fixture\n    result = verify_detached_signatures(sample, signature, keyring_home=tmp_path / \"missing\", allowed_fingerprints=[fingerprint])\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"explicit_keyring_required\"\n\n\ndef test_detached_gpg_rejects_symlink_signature(signed_fixture, tmp_path):\n    home, sample, signature, fingerprint = signed_fixture\n    link = tmp_path / \"signature.asc\"\n    link.symlink_to(signature)\n    result = verify_detached_signatures(sample, link, keyring_home=home, allowed_fingerprints=[fingerprint])\n    assert result[\"valid\"] is False\n    assert result[\"reason\"] == \"signed_file_or_signature_missing\"\n","numLines":242,"startLine":1,"totalLines":242}},"tool_result_meta":[{"id":"toolu_01DdwuFoAkZuHxhLgespu7rD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
