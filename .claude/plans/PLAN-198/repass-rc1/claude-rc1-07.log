{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VzRVGUqvte4pbpuSd3yy6w","type":"tool_result","content":"1\t\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\timport re\n4\t\n5\t_CANONICAL_GUARDS = [\n6\t    \".claude/team.md\",\n7\t    \".claude/frontend-team.md\",\n8\t    \".claude/pitfalls-catalog.yaml\",\n9\t    # SKILL.md under any tier\n10\t    \".claude/skills/core/*/SKILL.md\",\n11\t    \".claude/skills/frontend/*/SKILL.md\",\n12\t    # PLAN-074 Wave 0 ADJ-A5: replace fixed 4-segment glob with\n13\t    # recursive ** to cover sub-namespaces (e.g. game-development/<engine>).\n14\t    \".claude/skills/domains/**/SKILL.md\",\n15\t    # Domain-level governance files\n16\t    \".claude/skills/domains/*/team-personas.md\",\n17\t    \".claude/skills/domains/*/pitfalls.yaml\",\n18\t    # Sprint 9 (PLAN-009 A22 / A14) — defense-in-depth for confidence gate\n19\t    \".claude/**/conftest.py\",\n20\t    \".claude/hooks/check_confidence_gate.py\",\n21\t    \".claude/scripts/lessons.py\",\n22\t    \".claude/scripts/prune-lessons.py\",\n23\t    \".claude/scripts/lesson-restore.py\",\n24\t    \".claude/scripts/lesson_ranker.py\",\n25\t    # ---- PLAN-019 P1-SEC-A expansion: full governance surface ----\n26\t    # Hook source files (all PreToolUse / PostToolUse Python hooks).\n27\t    # An agent that can edit these can disable governance. Sentinel-gated\n28\t    # so Owner-signed ADRs can still land architectural changes.\n29\t    \".claude/hooks/*.py\",\n30\t    \".claude/hooks/_python-hook.sh\",\n31\t    # Hook shared library (_lib/*) — governance utilities.\n32\t    \".claude/hooks/_lib/*.py\",\n33\t    \".claude/hooks/_lib/adapters/*.py\",\n34\t    \".claude/hooks/_lib/**/*.py\",\n35\t    # Policy-as-code (ADR-045) — policies + fixtures.\n36\t    \".claude/policies/*.yaml\",\n37\t    \".claude/policies/*.yml\",\n38\t    \".claude/policies/fixtures/*.jsonl\",\n39\t    # PLAN-080 Phase 0b — JSON Schema for squad-bundle frontmatter validation\n40\t    # (M2-CDX-4 closure). Guarded so squad-bundle authoring contract cannot\n41\t    # be silently weakened. KERNEL-HARD-DENY since check_canonical_edit.py\n42\t    # itself is in _KERNEL_PATHS — extending its guard list requires both\n43\t    # CEO_KERNEL_OVERRIDE=PLAN-080-PHASE-0B-SCHEMA-GUARD-EXTENSION AND\n44\t    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the sentinel.\n45\t    \".claude/policies/schemas/*.json\",\n46\t    # PLAN-081 Phase 2 — Pair-Rail dispatcher canonical surface. The\n47\t    # routing-matrix.yaml carries the per-archetype coder/reviewer\n48\t    # decisions consumed by inject-agent-context.sh --pair-mode and\n49\t    # check_pair_rail.py (Phase 3 asymmetric VETO matrix arms). Mutation\n50\t    # of this YAML or the loader/predicate-eval would mis-route Pair-Rail\n51\t    # dispatches (T-4 archetype-spoofing in CROSS-LLM-THREAT-MODEL.md).\n52\t    # Sentinel-gated edits only — KERNEL-HARD-DENY since this guard list\n53\t    # itself is in _KERNEL_PATHS — extending requires\n54\t    # CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-2-DISPATCHER-GUARD-EXTENSION\n55\t    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n56\t    \".claude/dispatcher/*.py\",\n57\t    \".claude/dispatcher/*.yaml\",\n58\t    \".claude/dispatcher/*.yml\",\n59\t    \".claude/dispatcher/**/*.py\",\n60\t    # Settings file — matcher/hook registration.\n61\t    \".claude/settings.json\",\n62\t    # PLAN-074 Wave 0 ADJ-A3 BLOCKER 2: sub-agent definitions ship the\n63\t    # ROUTING TABLE personas + model: floor declarations. Editable only\n64\t    # via Owner-signed sentinel; CR/Sec/etc. archetype files cannot be\n65\t    # silently mutated by a sub-agent.\n66\t    \".claude/agents/*.md\",\n67\t    # ADRs — architectural record, supersede/immutability discipline.\n68\t    \".claude/adr/ADR-*.md\",\n69\t    \".claude/adr/README.md\",\n70\t    # SPEC/v1 — published compliance contract.\n71\t    \"SPEC/v1/*.md\",\n72\t    \"SPEC/**/*.md\",\n73\t    # CI workflows — release / branch-protection / validation gates.\n74\t    \".github/workflows/*.yml\",\n75\t    \".github/workflows/*.yaml\",\n76\t    # CODEOWNERS — merge-side branch-protection gate.\n77\t    \".github/CODEOWNERS\",\n78\t    # Installer + upgrader scripts — framework distribution surface.\n79\t    \"scripts/install.sh\",\n80\t    \"scripts/install-npm.sh\",\n81\t    \"scripts/upgrade.sh\",\n82\t    # PLAN-138 Wave C (ADR-155) — sourced helpers backing the install/upgrade\n83\t    # baseline-manifest engine. They are `source`d by the GPG-gated\n84\t    # install.sh/upgrade.sh, so mutating them silently changes the integrity\n85\t    # classification (FRAMEWORK-CHANGED vs ADOPTER-CUSTOMIZED) that protects\n86\t    # adopter customizations + the root PROTOCOL.md. Guarded so they are not a\n87\t    # soft underbelly relative to the scripts that source them.\n88\t    \"scripts/_hash_lib.sh\",\n89\t    \"scripts/_framework_manifest_set.sh\",\n90\t    # Root governance docs. PROTOCOL.md is rarely-changed governance;\n91\t    # CLAUDE.md is intentionally NOT guarded because it is edited every\n92\t    # session during closeout (see DYN-SEC1 dynamic finding). Protecting\n93\t    # CLAUDE.md needs a separate \"session-closeout\" ceremony convention\n94\t    # (tracked in dynamic-findings.md).\n95\t    \"PROTOCOL.md\",\n96\t    # PLAN-042 ITEM 6 (FINDING-14): spec.md is injected\n97\t    # verbatim into sub-agent prompts via `## SPEC CONTEXT`\n98\t    # (ADR-058). Guard prevents unauthorized spec edits from\n99\t    # becoming a prompt-injection vector across sub-agents.\n100\t    \".claude/plans/PLAN-*/spec.md\",\n101\t    # PLAN-043 / ADR-064 — tier-policy artifacts\n102\t    \".claude/tier-policy.json\",\n103\t    \".claude/tier-policy.json.sigchain\",\n104\t    # PLAN-081 Phase 4-bis — Pair-Rail locked corpus governance per ADR-111.\n105\t    # The MANIFEST + each fixture file are SHA-pinned; mutation defeats the\n106\t    # cross-LLM disagreement signal (corpus immutability is a structural\n107\t    # defense per ADR-108 §Operational). Sentinel-gated edits only — KERNEL\n108\t    # HARD-DENY since this guard list itself is in _KERNEL_PATHS — extending\n109\t    # requires CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-4-BIS-CORPUS-GUARD-EXTENSION\n110\t    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n111\t    \".claude/plans/PLAN-*/corpus/locked/MANIFEST.md\",\n112\t    \".claude/plans/PLAN-*/corpus/locked/**/*.py\",\n113\t    \".claude/plans/PLAN-*/corpus/locked/**/*.js\",\n114\t    # PLAN-081 Phase 6-bis — Pair-Rail governance pin files (codex-cli-pin,\n115\t    # codex-cli-binary-sha256, inputs-hash-manifest, verdict-template,\n116\t    # function-length-grandfather, governance-waivers, audit_tokens_allowlist).\n117\t    # Mutation of any of these silently changes release-gate behavior or\n118\t    # pair-rail trust-chain validation. Sentinel-gated edits only — KERNEL\n119\t    # HARD-DENY since this guard list itself is in _KERNEL_PATHS — extending\n120\t    # requires CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-6-BIS-GOVERNANCE-GUARD-EXTENSION\n121\t    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n122\t    \".claude/governance/*.txt\",\n123\t    \".claude/governance/*.md\",\n124\t    \".claude/governance/*.yaml\",\n125\t    \".claude/governance/*.json\",\n126\t    # PLAN-084 Wave 0.5 — SOTA-finalization audit canonical artifacts.\n127\t    # 3 outputs: findings-master.jsonl, capability-gap-report.md,\n128\t    # evolution-roadmap.md. KERNEL HARD-DENY extension per ADR-113;\n129\t    # CEO_KERNEL_OVERRIDE=PLAN-084-WAVE-0-CANONICAL-GUARD-EXTENSION +\n130\t    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT required to extend this list.\n131\t    \".claude/plans/PLAN-*/canonical/*\",\n132\t    # ---- PLAN-155 Wave 3b (SENT-CX-E) — Codex kill-switch surface ----\n133\t    # debate A8: the .codex registration/rules/managed surface + the\n134\t    # operator AGENTS.md are the rail's OWN disarm surface under the Codex\n135\t    # harness. Waves 2/3 EMIT these as unguarded L2 templates; without this\n136\t    # guard an agent running under Codex could rewrite `.codex/hooks.json`\n137\t    # (or the rest of the surface) and disarm every ENFORCED rail while the\n138\t    # boot tripwire that should detect it stays silent — the circular-disarm\n139\t    # gap. Sentinel-gated edits only. KERNEL HARD-DENY since this guard list\n140\t    # itself is in `_KERNEL_PATHS` — extending it requires\n141\t    # CEO_KERNEL_OVERRIDE=PLAN-155-CODEX-KILLSWITCH-GUARD-EXTENSION AND\n142\t    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the SENT-CX-E sentinel\n143\t    # (same double-gate as PLAN-080-PHASE-0B / PLAN-081-PHASE-2). NOTE: in\n144\t    # THIS framework repo the root `AGENTS.md` is the reviewer contract\n145\t    # (S261) — a trusted prompt surface injected into reviewer prompts — so\n146\t    # guarding it here is a deliberate, defensible protection, not only the\n147\t    # installed-target operator file. Path patterns are repo-relative and\n148\t    # apply to BOTH this repo and an installed target's tree.\n149\t    \".codex/hooks.json\",\n150\t    \".codex/config.toml\",\n151\t    \".codex/rules/ceo.rules\",\n152\t    \"requirements.toml\",\n153\t    \"AGENTS.md\",\n154\t    # ---- PLAN-156 Wave 3 (SENT-GK-E) — Grok kill-switch surface ----\n155\t    # Same class as the .codex surface above: under the Grok harness these\n156\t    # files ARE the rail's own disarm surface. An agent running under grok\n157\t    # that can rewrite `.grok/config.toml` (compat cells, leader mode) or\n158\t    # `.grok/sandbox.toml` (the council lane's OS-level containment)\n159\t    # disarms governance while the boot tripwire stays silent — the\n160\t    # circular-disarm gap. `.grok/hooks/` is guarded even though PLAN-156\n161\t    # deliberately ships NO live hooks there: a file we choose not to ship\n162\t    # is exactly the file an attacker would CREATE, and creating it\n163\t    # re-opens the double-fire that the single-surface decision closes.\n164\t    #\n165\t    # Why single-surface (OQ1, INVERTED by evidence — S269 probe P8): with\n166\t    # BOTH `.grok/hooks/` and the legacy `.claude/settings.json` present,\n167\t    # grok 0.2.93 fires EVERY hook TWICE on the same toolUseId, and neither\n168\t    # documented kill switch turns the legacy surface off at runtime —\n169\t    # `[compat.claude] hooks = false` in the project config is not even\n170\t    # read, and `GROK_CLAUDE_HOOKS_ENABLED=0` marks the hook `[disabled]`\n171\t    # in `grok inspect` while the runtime STILL fires it (probes\n172\t    # P8b/P8c/P8d; product-bug class on a 0.x). A double-fired audit-chain\n173\t    # append is an HMAC double-count + a filelock race, so the only sound\n174\t    # resolution is to arm exactly ONE surface. We arm the one grok reads\n175\t    # natively as legacy compat — the `.claude/settings.json` this\n176\t    # framework already ships — and guard `.grok/**` so nothing re-arms the\n177\t    # second one behind our back.\n178\t    #\n179\t    # KERNEL HARD-DENY (this guard list lives in _KERNEL_PATHS): extending\n180\t    # it requires CEO_KERNEL_OVERRIDE=PLAN-156-GROK-KILLSWITCH-GUARD-EXTENSION\n181\t    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the SENT-GK-E\n182\t    # sentinel (same double-gate as PLAN-155-CODEX-KILLSWITCH).\n183\t    \".grok/hooks/*.json\",\n184\t    \".grok/hooks/**/*.json\",\n185\t    \".grok/config.toml\",\n186\t    \".grok/sandbox.toml\",\n187\t    \".grok/rules/*.md\",\n188\t    # ---- PLAN-156 Wave 3 (SENT-GK-E) — install-template settings ----\n189\t    # pair-rail R13: `templates/settings/settings.base.json` is the hook\n190\t    # REGISTRATION surface every new install inherits, and it carried the\n191\t    # same non-shim `check_codex_filewrite.py` registration the live\n192\t    # settings.json did — so fixing only the dogfood file would have left\n193\t    # every adopter fail-open under grok (both halves: no exit-2 mapping,\n194\t    # no block->deny rewrite). It is a fail-open-BEARING distribution\n195\t    # surface and belongs under the same sentinel gate as\n196\t    # `.claude/settings.json`, not merely under a CI meta-test.\n197\t    \"templates/settings/settings.base.json\",\n198\t    \"templates/settings/*.json\",\n199\t    # ---- PLAN-156 Wave 6 (SENT-GK-F) — cross-vendor council egress surface ----\n200\t    # `council-audit.js` OWNS the live external-lane egress: it invokes the\n201\t    # ADR-114 redactor, enforces the per-lane budget hard-kill, and carries\n202\t    # the no-CI fence. A later ORDINARY edit that stripped the redactor call\n203\t    # or the fence would transmit repo content to xAI/OpenAI UNREDACTED — so\n204\t    # the workflow AND the /council command that triggers it are guarded.\n205\t    # NOTE (verified): `.claude/workflows/` was NOT previously canonical-\n206\t    # guarded (only `.github/workflows/*` is); this closes that gap for the\n207\t    # egress-bearing workflow. The `.claude/commands/council.md` trigger is\n208\t    # guarded for the same reason — it is the operator entry point to egress.\n209\t    # KERNEL HARD-DENY (this guard list is in _KERNEL_PATHS): extending it\n210\t    # requires CEO_KERNEL_OVERRIDE=PLAN-156-COUNCIL-GUARD-EXTENSION AND\n211\t    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to SENT-GK-F.\n212\t    #\n213\t    # PLAN-156-FOLLOWUP F3 (S270 live-fire finding, OQ1 Owner-ratified):\n214\t    # the exact-path entry guarded the INSTANCE, not the CLASS. A sibling\n215\t    # (or nested) workflow could carry the same external-lane egress and be\n216\t    # ordinary-writable — \"a file we choose not to ship is exactly the file\n217\t    # an attacker would CREATE\". The glob covers subdirectories too; `**`\n218\t    # matches zero or more segments in _fnmatch_segments (Sprint 9).\n219\t    # Cost accepted at ratification: authoring ANY .claude/workflows/*.js\n220\t    # becomes a sentinel ceremony.\n221\t    \".claude/workflows/**/*.js\",\n222\t    \".claude/commands/council.md\",\n223\t    # PLAN-165 p1-corrected (CX-1, S290): the night-mode posture-write\n224\t    # surface. The per-tool deny entries in settings.json close the\n225\t    # Edit/Write rail; THESE entries are the load-bearing rail for Bash —\n226\t    # check_bash_safety keys write-shaped (and -c/-e-body) command\n227\t    # references off this list, so without them\n228\t    # `echo '{...}' > settings.local.json` passes under acceptEdits with\n229\t    # the deny applied (the codex CX-1 refutation of the original p1).\n230\t    # Listing the WRITER script here also removes model-rail invocation\n231\t    # of the toggle (OQ1-redo, Owner-ratified 2026-08-03: presence =\n232\t    # only a human at the keyboard runs on/off, via `!` or a terminal).\n233\t    \".claude/settings.local.json\",\n234\t    \".claude/state/night-mode.json\",\n235\t    \".claude/scripts/night-mode.py\",\n236\t    # PLAN162_FIX_3 (PLAN-162 findings #3 + #8, consensus C10) — guard the\n237\t    # files the guard itself TRUSTS. Both were guarded by NEITHER rail on\n238\t    # HEAD (verified: canonical=False AND kernel=False), which is what\n239\t    # separates them from finding #12 (that one at least has the kernel\n240\t    # hard-deny underneath).\n241\t    #\n242\t    #   1. `.claude/security/sentinel-signers-registry.yaml` — the ADR-121\n243\t    #      identity root read below in `_sentinel_grants_path`. An ordinary\n244\t    #      Edit silently disarmed half the dual signer rail.\n245\t    #   2. `.claude/policies/.drift-manifest.json` — the policy hash-pin\n246\t    #      registry. Rewritable without the sentinel it pins; the parallel\n247\t    #      of #3 (\"pin the pinner\").\n248\t    #\n249\t    # BOTH are ALSO in `_KERNEL_PATHS` (same wave) — the sentinel rail\n250\t    # alone would let a sentinel authorize an edit to the registry that\n251\t    # decides which signers are valid, i.e. a sentinel bootstrapping its\n252\t    # own successor. C10 explicitly does NOT invert the `.exists()` gate\n253\t    # into \"absence ⇒ fail-closed\": that would make DELETING a file the\n254\t    # way to pick the posture.\n255\t    \".claude/security/sentinel-signers-registry.yaml\",\n256\t    \".claude/policies/.drift-manifest.json\",\n257\t]\n258\t\n259\t\n260\t# PLAN-065 Layer A (S81-tris gap closure, 2026-05-04):\n261\t# Write-shape parameter keys observed in MCP tool input payloads.\n262\t# When tool_name starts with `mcp__`, the hook scans tool_input for\n263\t# values under any of these keys and treats each as a candidate\n264\t# canonical-edit target. Conservative list: matches common MCP server\n265\t# implementations (codex, supabase, claude_ai_*) without false-positive\n266\t# on read-only tools. Tools like mcp__codex__apply_patch encode the\n267\t# target inside a `patch` blob (unified diff); v1 of Layer A does NOT\n268\t# parse those blobs — Layer B (PLAN-070 R3, server-side middleware)\n269\t# closes that surface. Layer A relies on the hook gate at PreToolUse\n270\t# matcher to surface mcp__* events; the hook itself blocks any direct\n271\t# path match against canonical guards.\n272\t_MCP_WRITE_PATH_KEYS = (\n273\t    \"path\",\n274\t    \"file_path\",\n275\t    \"target_path\",\n276\t    \"file\",\n277\t    \"filename\",\n278\t    \"dest\",\n279\t    \"destination\",\n280\t    \"target\",\n281\t    \"uri\",\n282\t)\n283\t\n284\t\n285\t_APPROVED_BY_RE = re.compile(\n286\t    r\"^\\s*Approved-By:\\s*@[\\w\\-]+\\s+\\S+\", flags=re.MULTILINE\n287\t)\n288\t\n289\t# PLAN-085 Wave E.5 — amendment file frontmatter pattern. Amendment\n290\t# files (e.g. `approved-amendment-2026-05-12.md`) reference the\n291\t# original sentinel they extend via an `Amends:` line and inherit its\n292\t# Scope: declarations transitively. The discovery path resolves the\n293\t# chain in `_find_sentinels` filtering above; the byte-identity of the\n294\t# original sentinel is preserved (no mutation, only amendment).\n295\t_AMENDS_RE = re.compile(\n296\t    r\"^\\s*Amends:\\s*\\.claude/plans/PLAN-\\d{3}/[^\\n]+\", flags=re.MULTILINE\n297\t)\n298\t\n299\t# PLAN-044 audit-v2 C6-P0-04 — Scope: block parser regex constants.\n300\t# Supports both the PLAN-050 round-17 plain `Scope:` format AND the\n301\t# Session 67 mega-sentinel `Scope (24 canonical paths):` format with\n302\t# categorized sub-sections and blank lines between bullet groups.\n303\t_SCOPE_HEADER_RE = re.compile(\n304\t    r\"^Scope(?:\\s*\\([^)\\n]*\\))?:\\s*$\",\n305\t    flags=re.MULTILINE,\n306\t)\n307\t# Top-level continuation headers that mark the end of the Scope block.\n308\t# Sub-section headers WITHIN Scope (e.g. \"Hook code (PLAN-052):\") are\n309\t# NOT in this set and are silently skipped during bullet collection.\n310\t#\n311\t# PLAN162_FIX_4 rule 3 (finding #4, consensus C5): the END scope marker\n312\t# is now a terminator too. Without it a marker-LESS (Tier-2) sentinel\n313\t# could carry `Scope:` bullets, an `<!-- END SIGNED SCOPE -->` line, and\n314\t# then MORE bullets — the comment line is not bullet-shaped, so\n315\t# collection simply continued straight past it and the post-END bullets\n316\t# granted. Listed FIRST in the alternation so the cheap literal wins.\n317\t_SCOPE_TERMINATOR_RE = re.compile(\n318\t    r\"^(?:\\s*<!--\\s*END\\s+SIGNED\\s+SCOPE\\s*-->\"\n319\t    r\"|(?:Effective|Plans|Rationale(?:\\s+by\\s+path)?|\"\n320\t    r\"Authorization(?:\\s+source)?|Anchor\\s+commit|Approved-By)\"\n321\t    r\"\\s*[:.])\",\n322\t    flags=re.IGNORECASE,\n323\t)\n324\t# Markdown horizontal rule — also terminates Scope block.\n325\t_SCOPE_HR_RE = re.compile(r\"^(?:-{3,}|\\*{3,}|_{3,})\\s*$\")\n326\t\n327\t# PLAN-064 Option D — Lexical scope markers (DIM-13 closure, 2026-05-04).\n328\t#\n329\t# Tier-1 sentinel format: scope is delimited by HTML-comment markers,\n330\t# unambiguously separating signed scope from lifecycle annotations.\n331\t#\n332\t#     <!-- BEGIN SIGNED SCOPE -->\n333\t#     Approved-By: @user <commit-sha>\n334\t#     Plans: PLAN-NNN\n335\t#     Scope:\n336\t#       - .claude/path/one.md\n337\t#     <!-- END SIGNED SCOPE -->\n338\t#\n339\t#     Status: ... (lifecycle text outside markers, ignored by parser)\n340\t#\n341\t# Parser tier-prioritizes: if markers present, parse Scope: ONLY from\n342\t# inside the marker region; if markers absent (legacy 44 sentinels at\n343\t# 2026-05-04), fall back to existing _SCOPE_HEADER_RE parser. No env\n344\t# flag — auto-detected by marker presence. Backward-compatible by\n345\t# construction.\n346\t#\n347\t# The GPG `.asc` continues to cover the whole file. Any tamper of any\n348\t# byte (markers, scope, lifecycle, anywhere) breaks the signature; the\n349\t# markers add only parser-side disambiguation, not new crypto authority.\n350\t#\n351\t# ReDoS-safety: anchored regex; non-greedy `.*?` bounded by END marker;\n352\t# 64KiB length cap on text before regex invocation (matches existing\n353\t# 4096-byte MCP path cap pattern at line ~205).\n354\t_SCOPE_MARKER_RE = re.compile(\n355\t    r\"<!--\\s*BEGIN\\s+SIGNED\\s+SCOPE\\s*-->\\s*\\n(.*?)\\n\\s*<!--\\s*END\\s+SIGNED\\s+SCOPE\\s*-->\",\n356\t    flags=re.DOTALL,\n357\t)\n358\t_SCOPE_MARKER_CAP_BYTES = 64 * 1024\n359\t# PLAN162_FIX_4 rule 1 — BEGIN-marker PRESENCE, independent of whether a\n360\t# well-formed PAIR exists. Detecting the two separately is what lets a\n361\t# lone/malformed BEGIN fail-CLOSE instead of quietly falling to Tier-2.\n362\t_BEGIN_MARKER_RE = re.compile(r\"<!--\\s*BEGIN\\s+SIGNED\\s+SCOPE\\s*-->\")\n363\t\n364\t\n365\t# ---------------------------------------------------------------------------\n366\t# PLAN162_FIX_9 — blocked_tool must be forensic, not decorative (C6)\n367\t# ---------------------------------------------------------------------------\n368\t# FOUR sites write ``blocked_tool`` into the HMAC audit chain: three\n369\t# carried the literal \"Edit|Write|MultiEdit\" regardless of which tool\n370\t# actually fired, and one carried the empty string. This hook is\n371\t# registered for ``mcp__.*`` too, so a human reading the chain after an\n372\t# incident was told the wrong tool — the two newest sites (the\n373\t# session-roots deny and the registry-tamper emit) were born after the\n374\t# council that found this.\n375\t#\n376\t# The fix plumbs the EVENT's tool name through. It is VALIDATED first,\n377\t# against a closed enum plus the ``mcp__`` shape, because the value is\n378\t# attacker-influenced input landing in a log humans read: an unvalidated\n379\t# fix would turn a forensics repair into a log-injection vector. Anything\n380\t# unrecognized becomes the literal \"unknown\" — never truncated (a\n381\t# truncation would let two distinct hostile names alias to one string).\n382\t_EDIT_CLASS_TOOLS = frozenset({\"Edit\", \"Write\", \"MultiEdit\", \"NotebookEdit\"})\n383\t_MCP_TOOL_NAME_RE = re.compile(r\"^mcp__[a-z0-9_]+$\")\n384\t_BLOCKED_TOOL_UNKNOWN = \"unknown\"\n385\t\n386\t__all__ = ['_CANONICAL_GUARDS', '_MCP_WRITE_PATH_KEYS', '_APPROVED_BY_RE', '_AMENDS_RE', '_SCOPE_HEADER_RE', '_SCOPE_TERMINATOR_RE', '_SCOPE_HR_RE', '_SCOPE_MARKER_RE', '_SCOPE_MARKER_CAP_BYTES', '_BEGIN_MARKER_RE', '_EDIT_CLASS_TOOLS', '_MCP_TOOL_NAME_RE', '_BLOCKED_TOOL_UNKNOWN']\n387\t"}]},"parent_tool_use_id":null,"session_id":"1aeb651e-484c-4168-99bd-f9adce0be74b","uuid":"80f92f3f-37f5-4701-af58-1d5692f8a509","timestamp":"2026-11-13T16:49:08.987Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/canonical_edit/guards.py","content":"\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\nfrom __future__ import annotations\nimport re\n\n_CANONICAL_GUARDS = [\n    \".claude/team.md\",\n    \".claude/frontend-team.md\",\n    \".claude/pitfalls-catalog.yaml\",\n    # SKILL.md under any tier\n    \".claude/skills/core/*/SKILL.md\",\n    \".claude/skills/frontend/*/SKILL.md\",\n    # PLAN-074 Wave 0 ADJ-A5: replace fixed 4-segment glob with\n    # recursive ** to cover sub-namespaces (e.g. game-development/<engine>).\n    \".claude/skills/domains/**/SKILL.md\",\n    # Domain-level governance files\n    \".claude/skills/domains/*/team-personas.md\",\n    \".claude/skills/domains/*/pitfalls.yaml\",\n    # Sprint 9 (PLAN-009 A22 / A14) — defense-in-depth for confidence gate\n    \".claude/**/conftest.py\",\n    \".claude/hooks/check_confidence_gate.py\",\n    \".claude/scripts/lessons.py\",\n    \".claude/scripts/prune-lessons.py\",\n    \".claude/scripts/lesson-restore.py\",\n    \".claude/scripts/lesson_ranker.py\",\n    # ---- PLAN-019 P1-SEC-A expansion: full governance surface ----\n    # Hook source files (all PreToolUse / PostToolUse Python hooks).\n    # An agent that can edit these can disable governance. Sentinel-gated\n    # so Owner-signed ADRs can still land architectural changes.\n    \".claude/hooks/*.py\",\n    \".claude/hooks/_python-hook.sh\",\n    # Hook shared library (_lib/*) — governance utilities.\n    \".claude/hooks/_lib/*.py\",\n    \".claude/hooks/_lib/adapters/*.py\",\n    \".claude/hooks/_lib/**/*.py\",\n    # Policy-as-code (ADR-045) — policies + fixtures.\n    \".claude/policies/*.yaml\",\n    \".claude/policies/*.yml\",\n    \".claude/policies/fixtures/*.jsonl\",\n    # PLAN-080 Phase 0b — JSON Schema for squad-bundle frontmatter validation\n    # (M2-CDX-4 closure). Guarded so squad-bundle authoring contract cannot\n    # be silently weakened. KERNEL-HARD-DENY since check_canonical_edit.py\n    # itself is in _KERNEL_PATHS — extending its guard list requires both\n    # CEO_KERNEL_OVERRIDE=PLAN-080-PHASE-0B-SCHEMA-GUARD-EXTENSION AND\n    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the sentinel.\n    \".claude/policies/schemas/*.json\",\n    # PLAN-081 Phase 2 — Pair-Rail dispatcher canonical surface. The\n    # routing-matrix.yaml carries the per-archetype coder/reviewer\n    # decisions consumed by inject-agent-context.sh --pair-mode and\n    # check_pair_rail.py (Phase 3 asymmetric VETO matrix arms). Mutation\n    # of this YAML or the loader/predicate-eval would mis-route Pair-Rail\n    # dispatches (T-4 archetype-spoofing in CROSS-LLM-THREAT-MODEL.md).\n    # Sentinel-gated edits only — KERNEL-HARD-DENY since this guard list\n    # itself is in _KERNEL_PATHS — extending requires\n    # CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-2-DISPATCHER-GUARD-EXTENSION\n    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n    \".claude/dispatcher/*.py\",\n    \".claude/dispatcher/*.yaml\",\n    \".claude/dispatcher/*.yml\",\n    \".claude/dispatcher/**/*.py\",\n    # Settings file — matcher/hook registration.\n    \".claude/settings.json\",\n    # PLAN-074 Wave 0 ADJ-A3 BLOCKER 2: sub-agent definitions ship the\n    # ROUTING TABLE personas + model: floor declarations. Editable only\n    # via Owner-signed sentinel; CR/Sec/etc. archetype files cannot be\n    # silently mutated by a sub-agent.\n    \".claude/agents/*.md\",\n    # ADRs — architectural record, supersede/immutability discipline.\n    \".claude/adr/ADR-*.md\",\n    \".claude/adr/README.md\",\n    # SPEC/v1 — published compliance contract.\n    \"SPEC/v1/*.md\",\n    \"SPEC/**/*.md\",\n    # CI workflows — release / branch-protection / validation gates.\n    \".github/workflows/*.yml\",\n    \".github/workflows/*.yaml\",\n    # CODEOWNERS — merge-side branch-protection gate.\n    \".github/CODEOWNERS\",\n    # Installer + upgrader scripts — framework distribution surface.\n    \"scripts/install.sh\",\n    \"scripts/install-npm.sh\",\n    \"scripts/upgrade.sh\",\n    # PLAN-138 Wave C (ADR-155) — sourced helpers backing the install/upgrade\n    # baseline-manifest engine. They are `source`d by the GPG-gated\n    # install.sh/upgrade.sh, so mutating them silently changes the integrity\n    # classification (FRAMEWORK-CHANGED vs ADOPTER-CUSTOMIZED) that protects\n    # adopter customizations + the root PROTOCOL.md. Guarded so they are not a\n    # soft underbelly relative to the scripts that source them.\n    \"scripts/_hash_lib.sh\",\n    \"scripts/_framework_manifest_set.sh\",\n    # Root governance docs. PROTOCOL.md is rarely-changed governance;\n    # CLAUDE.md is intentionally NOT guarded because it is edited every\n    # session during closeout (see DYN-SEC1 dynamic finding). Protecting\n    # CLAUDE.md needs a separate \"session-closeout\" ceremony convention\n    # (tracked in dynamic-findings.md).\n    \"PROTOCOL.md\",\n    # PLAN-042 ITEM 6 (FINDING-14): spec.md is injected\n    # verbatim into sub-agent prompts via `## SPEC CONTEXT`\n    # (ADR-058). Guard prevents unauthorized spec edits from\n    # becoming a prompt-injection vector across sub-agents.\n    \".claude/plans/PLAN-*/spec.md\",\n    # PLAN-043 / ADR-064 — tier-policy artifacts\n    \".claude/tier-policy.json\",\n    \".claude/tier-policy.json.sigchain\",\n    # PLAN-081 Phase 4-bis — Pair-Rail locked corpus governance per ADR-111.\n    # The MANIFEST + each fixture file are SHA-pinned; mutation defeats the\n    # cross-LLM disagreement signal (corpus immutability is a structural\n    # defense per ADR-108 §Operational). Sentinel-gated edits only — KERNEL\n    # HARD-DENY since this guard list itself is in _KERNEL_PATHS — extending\n    # requires CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-4-BIS-CORPUS-GUARD-EXTENSION\n    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n    \".claude/plans/PLAN-*/corpus/locked/MANIFEST.md\",\n    \".claude/plans/PLAN-*/corpus/locked/**/*.py\",\n    \".claude/plans/PLAN-*/corpus/locked/**/*.js\",\n    # PLAN-081 Phase 6-bis — Pair-Rail governance pin files (codex-cli-pin,\n    # codex-cli-binary-sha256, inputs-hash-manifest, verdict-template,\n    # function-length-grandfather, governance-waivers, audit_tokens_allowlist).\n    # Mutation of any of these silently changes release-gate behavior or\n    # pair-rail trust-chain validation. Sentinel-gated edits only — KERNEL\n    # HARD-DENY since this guard list itself is in _KERNEL_PATHS — extending\n    # requires CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-6-BIS-GOVERNANCE-GUARD-EXTENSION\n    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n    \".claude/governance/*.txt\",\n    \".claude/governance/*.md\",\n    \".claude/governance/*.yaml\",\n    \".claude/governance/*.json\",\n    # PLAN-084 Wave 0.5 — SOTA-finalization audit canonical artifacts.\n    # 3 outputs: findings-master.jsonl, capability-gap-report.md,\n    # evolution-roadmap.md. KERNEL HARD-DENY extension per ADR-113;\n    # CEO_KERNEL_OVERRIDE=PLAN-084-WAVE-0-CANONICAL-GUARD-EXTENSION +\n    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT required to extend this list.\n    \".claude/plans/PLAN-*/canonical/*\",\n    # ---- PLAN-155 Wave 3b (SENT-CX-E) — Codex kill-switch surface ----\n    # debate A8: the .codex registration/rules/managed surface + the\n    # operator AGENTS.md are the rail's OWN disarm surface under the Codex\n    # harness. Waves 2/3 EMIT these as unguarded L2 templates; without this\n    # guard an agent running under Codex could rewrite `.codex/hooks.json`\n    # (or the rest of the surface) and disarm every ENFORCED rail while the\n    # boot tripwire that should detect it stays silent — the circular-disarm\n    # gap. Sentinel-gated edits only. KERNEL HARD-DENY since this guard list\n    # itself is in `_KERNEL_PATHS` — extending it requires\n    # CEO_KERNEL_OVERRIDE=PLAN-155-CODEX-KILLSWITCH-GUARD-EXTENSION AND\n    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the SENT-CX-E sentinel\n    # (same double-gate as PLAN-080-PHASE-0B / PLAN-081-PHASE-2). NOTE: in\n    # THIS framework repo the root `AGENTS.md` is the reviewer contract\n    # (S261) — a trusted prompt surface injected into reviewer prompts — so\n    # guarding it here is a deliberate, defensible protection, not only the\n    # installed-target operator file. Path patterns are repo-relative and\n    # apply to BOTH this repo and an installed target's tree.\n    \".codex/hooks.json\",\n    \".codex/config.toml\",\n    \".codex/rules/ceo.rules\",\n    \"requirements.toml\",\n    \"AGENTS.md\",\n    # ---- PLAN-156 Wave 3 (SENT-GK-E) — Grok kill-switch surface ----\n    # Same class as the .codex surface above: under the Grok harness these\n    # files ARE the rail's own disarm surface. An agent running under grok\n    # that can rewrite `.grok/config.toml` (compat cells, leader mode) or\n    # `.grok/sandbox.toml` (the council lane's OS-level containment)\n    # disarms governance while the boot tripwire stays silent — the\n    # circular-disarm gap. `.grok/hooks/` is guarded even though PLAN-156\n    # deliberately ships NO live hooks there: a file we choose not to ship\n    # is exactly the file an attacker would CREATE, and creating it\n    # re-opens the double-fire that the single-surface decision closes.\n    #\n    # Why single-surface (OQ1, INVERTED by evidence — S269 probe P8): with\n    # BOTH `.grok/hooks/` and the legacy `.claude/settings.json` present,\n    # grok 0.2.93 fires EVERY hook TWICE on the same toolUseId, and neither\n    # documented kill switch turns the legacy surface off at runtime —\n    # `[compat.claude] hooks = false` in the project config is not even\n    # read, and `GROK_CLAUDE_HOOKS_ENABLED=0` marks the hook `[disabled]`\n    # in `grok inspect` while the runtime STILL fires it (probes\n    # P8b/P8c/P8d; product-bug class on a 0.x). A double-fired audit-chain\n    # append is an HMAC double-count + a filelock race, so the only sound\n    # resolution is to arm exactly ONE surface. We arm the one grok reads\n    # natively as legacy compat — the `.claude/settings.json` this\n    # framework already ships — and guard `.grok/**` so nothing re-arms the\n    # second one behind our back.\n    #\n    # KERNEL HARD-DENY (this guard list lives in _KERNEL_PATHS): extending\n    # it requires CEO_KERNEL_OVERRIDE=PLAN-156-GROK-KILLSWITCH-GUARD-EXTENSION\n    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the SENT-GK-E\n    # sentinel (same double-gate as PLAN-155-CODEX-KILLSWITCH).\n    \".grok/hooks/*.json\",\n    \".grok/hooks/**/*.json\",\n    \".grok/config.toml\",\n    \".grok/sandbox.toml\",\n    \".grok/rules/*.md\",\n    # ---- PLAN-156 Wave 3 (SENT-GK-E) — install-template settings ----\n    # pair-rail R13: `templates/settings/settings.base.json` is the hook\n    # REGISTRATION surface every new install inherits, and it carried the\n    # same non-shim `check_codex_filewrite.py` registration the live\n    # settings.json did — so fixing only the dogfood file would have left\n    # every adopter fail-open under grok (both halves: no exit-2 mapping,\n    # no block->deny rewrite). It is a fail-open-BEARING distribution\n    # surface and belongs under the same sentinel gate as\n    # `.claude/settings.json`, not merely under a CI meta-test.\n    \"templates/settings/settings.base.json\",\n    \"templates/settings/*.json\",\n    # ---- PLAN-156 Wave 6 (SENT-GK-F) — cross-vendor council egress surface ----\n    # `council-audit.js` OWNS the live external-lane egress: it invokes the\n    # ADR-114 redactor, enforces the per-lane budget hard-kill, and carries\n    # the no-CI fence. A later ORDINARY edit that stripped the redactor call\n    # or the fence would transmit repo content to xAI/OpenAI UNREDACTED — so\n    # the workflow AND the /council command that triggers it are guarded.\n    # NOTE (verified): `.claude/workflows/` was NOT previously canonical-\n    # guarded (only `.github/workflows/*` is); this closes that gap for the\n    # egress-bearing workflow. The `.claude/commands/council.md` trigger is\n    # guarded for the same reason — it is the operator entry point to egress.\n    # KERNEL HARD-DENY (this guard list is in _KERNEL_PATHS): extending it\n    # requires CEO_KERNEL_OVERRIDE=PLAN-156-COUNCIL-GUARD-EXTENSION AND\n    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to SENT-GK-F.\n    #\n    # PLAN-156-FOLLOWUP F3 (S270 live-fire finding, OQ1 Owner-ratified):\n    # the exact-path entry guarded the INSTANCE, not the CLASS. A sibling\n    # (or nested) workflow could carry the same external-lane egress and be\n    # ordinary-writable — \"a file we choose not to ship is exactly the file\n    # an attacker would CREATE\". The glob covers subdirectories too; `**`\n    # matches zero or more segments in _fnmatch_segments (Sprint 9).\n    # Cost accepted at ratification: authoring ANY .claude/workflows/*.js\n    # becomes a sentinel ceremony.\n    \".claude/workflows/**/*.js\",\n    \".claude/commands/council.md\",\n    # PLAN-165 p1-corrected (CX-1, S290): the night-mode posture-write\n    # surface. The per-tool deny entries in settings.json close the\n    # Edit/Write rail; THESE entries are the load-bearing rail for Bash —\n    # check_bash_safety keys write-shaped (and -c/-e-body) command\n    # references off this list, so without them\n    # `echo '{...}' > settings.local.json` passes under acceptEdits with\n    # the deny applied (the codex CX-1 refutation of the original p1).\n    # Listing the WRITER script here also removes model-rail invocation\n    # of the toggle (OQ1-redo, Owner-ratified 2026-08-03: presence =\n    # only a human at the keyboard runs on/off, via `!` or a terminal).\n    \".claude/settings.local.json\",\n    \".claude/state/night-mode.json\",\n    \".claude/scripts/night-mode.py\",\n    # PLAN162_FIX_3 (PLAN-162 findings #3 + #8, consensus C10) — guard the\n    # files the guard itself TRUSTS. Both were guarded by NEITHER rail on\n    # HEAD (verified: canonical=False AND kernel=False), which is what\n    # separates them from finding #12 (that one at least has the kernel\n    # hard-deny underneath).\n    #\n    #   1. `.claude/security/sentinel-signers-registry.yaml` — the ADR-121\n    #      identity root read below in `_sentinel_grants_path`. An ordinary\n    #      Edit silently disarmed half the dual signer rail.\n    #   2. `.claude/policies/.drift-manifest.json` — the policy hash-pin\n    #      registry. Rewritable without the sentinel it pins; the parallel\n    #      of #3 (\"pin the pinner\").\n    #\n    # BOTH are ALSO in `_KERNEL_PATHS` (same wave) — the sentinel rail\n    # alone would let a sentinel authorize an edit to the registry that\n    # decides which signers are valid, i.e. a sentinel bootstrapping its\n    # own successor. C10 explicitly does NOT invert the `.exists()` gate\n    # into \"absence ⇒ fail-closed\": that would make DELETING a file the\n    # way to pick the posture.\n    \".claude/security/sentinel-signers-registry.yaml\",\n    \".claude/policies/.drift-manifest.json\",\n]\n\n\n# PLAN-065 Layer A (S81-tris gap closure, 2026-05-04):\n# Write-shape parameter keys observed in MCP tool input payloads.\n# When tool_name starts with `mcp__`, the hook scans tool_input for\n# values under any of these keys and treats each as a candidate\n# canonical-edit target. Conservative list: matches common MCP server\n# implementations (codex, supabase, claude_ai_*) without false-positive\n# on read-only tools. Tools like mcp__codex__apply_patch encode the\n# target inside a `patch` blob (unified diff); v1 of Layer A does NOT\n# parse those blobs — Layer B (PLAN-070 R3, server-side middleware)\n# closes that surface. Layer A relies on the hook gate at PreToolUse\n# matcher to surface mcp__* events; the hook itself blocks any direct\n# path match against canonical guards.\n_MCP_WRITE_PATH_KEYS = (\n    \"path\",\n    \"file_path\",\n    \"target_path\",\n    \"file\",\n    \"filename\",\n    \"dest\",\n    \"destination\",\n    \"target\",\n    \"uri\",\n)\n\n\n_APPROVED_BY_RE = re.compile(\n    r\"^\\s*Approved-By:\\s*@[\\w\\-]+\\s+\\S+\", flags=re.MULTILINE\n)\n\n# PLAN-085 Wave E.5 — amendment file frontmatter pattern. Amendment\n# files (e.g. `approved-amendment-2026-05-12.md`) reference the\n# original sentinel they extend via an `Amends:` line and inherit its\n# Scope: declarations transitively. The discovery path resolves the\n# chain in `_find_sentinels` filtering above; the byte-identity of the\n# original sentinel is preserved (no mutation, only amendment).\n_AMENDS_RE = re.compile(\n    r\"^\\s*Amends:\\s*\\.claude/plans/PLAN-\\d{3}/[^\\n]+\", flags=re.MULTILINE\n)\n\n# PLAN-044 audit-v2 C6-P0-04 — Scope: block parser regex constants.\n# Supports both the PLAN-050 round-17 plain `Scope:` format AND the\n# Session 67 mega-sentinel `Scope (24 canonical paths):` format with\n# categorized sub-sections and blank lines between bullet groups.\n_SCOPE_HEADER_RE = re.compile(\n    r\"^Scope(?:\\s*\\([^)\\n]*\\))?:\\s*$\",\n    flags=re.MULTILINE,\n)\n# Top-level continuation headers that mark the end of the Scope block.\n# Sub-section headers WITHIN Scope (e.g. \"Hook code (PLAN-052):\") are\n# NOT in this set and are silently skipped during bullet collection.\n#\n# PLAN162_FIX_4 rule 3 (finding #4, consensus C5): the END scope marker\n# is now a terminator too. Without it a marker-LESS (Tier-2) sentinel\n# could carry `Scope:` bullets, an `<!-- END SIGNED SCOPE -->` line, and\n# then MORE bullets — the comment line is not bullet-shaped, so\n# collection simply continued straight past it and the post-END bullets\n# granted. Listed FIRST in the alternation so the cheap literal wins.\n_SCOPE_TERMINATOR_RE = re.compile(\n    r\"^(?:\\s*<!--\\s*END\\s+SIGNED\\s+SCOPE\\s*-->\"\n    r\"|(?:Effective|Plans|Rationale(?:\\s+by\\s+path)?|\"\n    r\"Authorization(?:\\s+source)?|Anchor\\s+commit|Approved-By)\"\n    r\"\\s*[:.])\",\n    flags=re.IGNORECASE,\n)\n# Markdown horizontal rule — also terminates Scope block.\n_SCOPE_HR_RE = re.compile(r\"^(?:-{3,}|\\*{3,}|_{3,})\\s*$\")\n\n# PLAN-064 Option D — Lexical scope markers (DIM-13 closure, 2026-05-04).\n#\n# Tier-1 sentinel format: scope is delimited by HTML-comment markers,\n# unambiguously separating signed scope from lifecycle annotations.\n#\n#     <!-- BEGIN SIGNED SCOPE -->\n#     Approved-By: @user <commit-sha>\n#     Plans: PLAN-NNN\n#     Scope:\n#       - .claude/path/one.md\n#     <!-- END SIGNED SCOPE -->\n#\n#     Status: ... (lifecycle text outside markers, ignored by parser)\n#\n# Parser tier-prioritizes: if markers present, parse Scope: ONLY from\n# inside the marker region; if markers absent (legacy 44 sentinels at\n# 2026-05-04), fall back to existing _SCOPE_HEADER_RE parser. No env\n# flag — auto-detected by marker presence. Backward-compatible by\n# construction.\n#\n# The GPG `.asc` continues to cover the whole file. Any tamper of any\n# byte (markers, scope, lifecycle, anywhere) breaks the signature; the\n# markers add only parser-side disambiguation, not new crypto authority.\n#\n# ReDoS-safety: anchored regex; non-greedy `.*?` bounded by END marker;\n# 64KiB length cap on text before regex invocation (matches existing\n# 4096-byte MCP path cap pattern at line ~205).\n_SCOPE_MARKER_RE = re.compile(\n    r\"<!--\\s*BEGIN\\s+SIGNED\\s+SCOPE\\s*-->\\s*\\n(.*?)\\n\\s*<!--\\s*END\\s+SIGNED\\s+SCOPE\\s*-->\",\n    flags=re.DOTALL,\n)\n_SCOPE_MARKER_CAP_BYTES = 64 * 1024\n# PLAN162_FIX_4 rule 1 — BEGIN-marker PRESENCE, independent of whether a\n# well-formed PAIR exists. Detecting the two separately is what lets a\n# lone/malformed BEGIN fail-CLOSE instead of quietly falling to Tier-2.\n_BEGIN_MARKER_RE = re.compile(r\"<!--\\s*BEGIN\\s+SIGNED\\s+SCOPE\\s*-->\")\n\n\n# ---------------------------------------------------------------------------\n# PLAN162_FIX_9 — blocked_tool must be forensic, not decorative (C6)\n# ---------------------------------------------------------------------------\n# FOUR sites write ``blocked_tool`` into the HMAC audit chain: three\n# carried the literal \"Edit|Write|MultiEdit\" regardless of which tool\n# actually fired, and one carried the empty string. This hook is\n# registered for ``mcp__.*`` too, so a human reading the chain after an\n# incident was told the wrong tool — the two newest sites (the\n# session-roots deny and the registry-tamper emit) were born after the\n# council that found this.\n#\n# The fix plumbs the EVENT's tool name through. It is VALIDATED first,\n# against a closed enum plus the ``mcp__`` shape, because the value is\n# attacker-influenced input landing in a log humans read: an unvalidated\n# fix would turn a forensics repair into a log-injection vector. Anything\n# unrecognized becomes the literal \"unknown\" — never truncated (a\n# truncation would let two distinct hostile names alias to one string).\n_EDIT_CLASS_TOOLS = frozenset({\"Edit\", \"Write\", \"MultiEdit\", \"NotebookEdit\"})\n_MCP_TOOL_NAME_RE = re.compile(r\"^mcp__[a-z0-9_]+$\")\n_BLOCKED_TOOL_UNKNOWN = \"unknown\"\n\n__all__ = ['_CANONICAL_GUARDS', '_MCP_WRITE_PATH_KEYS', '_APPROVED_BY_RE', '_AMENDS_RE', '_SCOPE_HEADER_RE', '_SCOPE_TERMINATOR_RE', '_SCOPE_HR_RE', '_SCOPE_MARKER_RE', '_SCOPE_MARKER_CAP_BYTES', '_BEGIN_MARKER_RE', '_EDIT_CLASS_TOOLS', '_MCP_TOOL_NAME_RE', '_BLOCKED_TOOL_UNKNOWN']\n","numLines":387,"startLine":1,"totalLines":387}},"tool_result_meta":[{"id":"toolu_01VzRVGUqvte4pbpuSd3yy6w","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
