{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019VSJAcsEasjdRQuiZBWNKb","type":"tool_result","content":"1\t\"\"\"Ordered ceo-boot declarations for the public script facade.\n2\t\n3\tEach part is ordinary Python source. The loader compiles it with its real\n4\tfilename and executes it in the facade dictionary, retaining legacy global\n5\tlookup and monkeypatch behavior without proxies.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\tfrom pathlib import Path\n10\tfrom typing import Any, Dict, Tuple\n11\t\n12\t_PARTS: Tuple[str, ...] = (\n13\t    \"state_plan_audit\", \"harness_governance\", \"model_persona\",\n14\t    \"persona_confidence\", \"liveness_schedule\", \"scheduled_cache\",\n15\t    \"cache_recommendations\", \"telemetry_candidates\", \"candidates_lessons\",\n16\t    \"lessons_cli\",\n17\t)\n18\t\n19\t\n20\tdef install(namespace: Dict[str, Any]) -> None:\n21\t    \"\"\"Execute real declaration files in their original dependency order.\"\"\"\n22\t    directory = Path(__file__).resolve().parent\n23\t    for name in _PARTS:\n24\t        path = directory / (name + \".py\")\n25\t        code = compile(path.read_text(encoding=\"utf-8\"), str(path), \"exec\")\n26\t        exec(code, namespace)\n27\t"}]},"parent_tool_use_id":null,"session_id":"1aeb651e-484c-4168-99bd-f9adce0be74b","uuid":"21e8b13c-4966-482b-880d-d1b98756134e","timestamp":"2026-11-13T16:47:05.631Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_ceo_boot_parts/__init__.py","content":"\"\"\"Ordered ceo-boot declarations for the public script facade.\n\nEach part is ordinary Python source. The loader compiles it with its real\nfilename and executes it in the facade dictionary, retaining legacy global\nlookup and monkeypatch behavior without proxies.\n\"\"\"\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Any, Dict, Tuple\n\n_PARTS: Tuple[str, ...] = (\n    \"state_plan_audit\", \"harness_governance\", \"model_persona\",\n    \"persona_confidence\", \"liveness_schedule\", \"scheduled_cache\",\n    \"cache_recommendations\", \"telemetry_candidates\", \"candidates_lessons\",\n    \"lessons_cli\",\n)\n\n\ndef install(namespace: Dict[str, Any]) -> None:\n    \"\"\"Execute real declaration files in their original dependency order.\"\"\"\n    directory = Path(__file__).resolve().parent\n    for name in _PARTS:\n        path = directory / (name + \".py\")\n        code = compile(path.read_text(encoding=\"utf-8\"), str(path), \"exec\")\n        exec(code, namespace)\n","numLines":27,"startLine":1,"totalLines":27}},"tool_result_meta":[{"id":"toolu_019VSJAcsEasjdRQuiZBWNKb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
