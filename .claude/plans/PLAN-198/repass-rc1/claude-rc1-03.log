{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017uh91L7xQJZ42asxkKmSJL","type":"tool_result","content":"579\tdef build_entry(\n580\t    *,\n581\t    event: \"_contract.NormalizedEvent | _payload.HookPayload\",\n582\t    project_dir: str,\n583\t    hook_duration_ms: int,\n584\t) -> Optional[Dict[str, Any]]:\n585\t    \"\"\"Construct a JSONL row from a NormalizedEvent (or legacy HookPayload).\n586\t\n587\t    Accepts either type for backward compatibility with older tests.\n588\t    Returns None if the event indicates a non-Agent tool (defensive — the\n589\t    matcher should already filter to Agent).\n590\t    \"\"\"\n591\t    tool_name = getattr(event, \"tool_name\", \"\")\n592\t    if tool_name and tool_name not in (\"Agent\", \"unknown\"):\n593\t        return None\n594\t\n595\t    description = getattr(event, \"description\", \"\") or \"\"\n596\t    prompt = getattr(event, \"prompt\", \"\") or \"\"\n597\t    session_id = getattr(event, \"session_id\", \"\") or \"\"\n598\t    subagent_type = getattr(event, \"subagent_type\", \"\") or \"\"\n599\t    tool_response = getattr(event, \"tool_response\", {}) or {}\n600\t\n601\t    desc_preview = _redact.redact_secrets(description)\n602\t    desc_hash = _redact.hash_description(description)\n603\t    # PLAN-079: pass subagent_type for Path D archetype-mapping fallback.\n604\t    skill = extract_skill(prompt, subagent_type)\n605\t\n606\t    # PLAN-006 Phase 5b (ADR-016): extract token counts from tool_response.\n607\t    # Always emit the keys (even if None) so consumers can distinguish\n608\t    # \"post-ADR-016 emitter with unknown shape\" from \"pre-ADR-016 emitter\".\n609\t    tin, tout = _tokens.extract_tokens(tool_response)\n610\t    ttotal = _tokens.total_tokens(tool_response)\n611\t\n612\t    # PLAN-020 Phase 0 item 1: capture Anthropic usage_metadata for cache\n613\t    # coverage analysis. Additive v2.7 fields. Null-safe for emitters that\n614\t    # don't provide usage_metadata (legacy + non-Anthropic adapters).\n615\t    usage_metadata = _extract_usage_metadata(tool_response)\n616\t    # PLAN-118 WS-E (S181): the derived ratio is a FLOAT, which\n617\t    # ``canonical_json.encode()`` forbids in HMAC-covered payloads\n618\t    # (``CanonicalJsonError`` → fail-open ``hmac:null`` → chain one-way-rule\n619\t    # break → whole-chain ``tamper``). Encode as integer basis-points\n620\t    # (ratio × 10000, clamped 0..10000) BEFORE it reaches the entry dict.\n621\t    # Mirrors the S164 ``hit_rate`` → ``hit_rate_bps`` class fix; closes the\n622\t    # last live float-in-HMAC leak (the agent_spawn observer path that the\n623\t    # S164 emit_* introspection guard never covered).\n624\t    cache_coverage = _compute_cache_coverage(usage_metadata)\n625\t    cache_coverage_bps = (\n626\t        max(0, min(10000, int(round(cache_coverage * 10000))))\n627\t        if cache_coverage is not None\n628\t        else None\n629\t    )\n630\t\n631\t    # PLAN-020 Phase 1: dual-rail discriminator. Detect from prompt\n632\t    # structure (## SKILL REFERENCE = native rail; ## SKILL CONTENT =\n633\t    # custom inline rail) OR from subagent_type matching canonical-5.\n634\t    rail = _detect_rail(prompt, subagent_type)\n635\t\n636\t    # PLAN-021 ADR-052: model discriminator. Captured from Anthropic\n637\t    # API response when present. Null-safe for non-Anthropic adapters.\n638\t    # PLAN-044 audit-v2 C3-P0-01 (Wave B): fall back to ADR-052\n639\t    # role-to-model policy when tool_response.model is null (default\n640\t    # behavior of Task tool response shape at v1.11.0).\n641\t    model = _extract_model(tool_response, subagent_type=subagent_type)\n642\t\n643\t    # PLAN-044 audit-v2 C3-P0-08 (Wave B): archetype + dispatch_mode\n644\t    # fields. Audit-telemetry.py per-archetype rollups depend on these\n645\t    # being non-null. ADR-082 per-archetype dispatch claim was undone\n646\t    # at v1.11.0 because no emitter wrote them. Wave B closes the gap.\n647\t    archetype = subagent_type if (\n648\t        isinstance(subagent_type, str) and subagent_type\n649\t    ) else None\n650\t    dispatch_mode = _resolve_dispatch_mode(subagent_type or \"\", rail)\n651\t\n652\t    # PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2): capture dispatch_archetype_hint\n653\t    # from the IN-PROMPT marker emitted by inject-agent-context.sh:\n654\t    #   `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n655\t    # The marker propagates cross-process via the recorded `prompt` payload —\n656\t    # env vars do NOT survive the inject-agent-context.sh subprocess → Agent\n657\t    # tool dispatch → audit hook subprocess chain (Codex iter 2 finding).\n658\t    #\n659\t    # Validated via the same NFKC + ≤64 char + charset `^[a-z][a-z0-9-]*$` +\n660\t    # control/JSON-meta rejection contract as `_lib.audit_emit._validate_dispatch_archetype_hint`.\n661\t    # On rejection (or marker absent): returns None (fail-open). The field is\n662\t    # always emitted in the audit row — null when no hint is set/validated,\n663\t    # validated string otherwise.\n664\t    dispatch_archetype_hint = _extract_dispatch_archetype_hint(prompt)\n665\t\n666\t    entry: Dict[str, Any] = {\n667\t        \"ts\": now_iso_utc(),\n668\t        \"action\": \"agent_spawn\",\n669\t        \"session_id\": session_id,\n670\t        \"project\": project_dir,\n671\t        \"tool\": tool_name or \"Agent\",\n672\t        \"subagent_type\": subagent_type,\n673\t        \"desc_preview\": desc_preview,\n674\t        \"desc_hash\": desc_hash,\n675\t        \"skill\": skill,\n676\t        \"has_profile\": has_profile(prompt),\n677\t        \"has_file_assignment\": has_file_assignment(prompt),\n678\t        \"prompt_len_bucket\": bucket_prompt_length(len(prompt)),\n679\t        \"response_kind\": _payload.response_kind(tool_response),\n680\t        \"hook_duration_ms\": int(hook_duration_ms),\n681\t        # Tokens (ADR-016): optional nullable, always-present.\n682\t        \"tokens_in\": tin,\n683\t        \"tokens_out\": tout,\n684\t        \"tokens_total\": ttotal,\n685\t        # PLAN-020 v2.7 additions (ADDITIVE — older consumers ignore).\n686\t        \"usage_metadata\": usage_metadata,\n687\t        # PLAN-118 WS-E (S181): integer basis-points (ratio × 10000) — the\n688\t        # legacy float ``cache_coverage`` field is REMOVED (it caused\n689\t        # CanonicalJsonError + fail-open hmac:null on every real spawn).\n690\t        \"cache_coverage_bps\": cache_coverage_bps,\n691\t        \"rail\": rail,\n692\t        # PLAN-021 v2.8 addition (ADDITIVE — ADR-052 multi-model).\n693\t        \"model\": model,\n694\t        # PLAN-044 audit-v2 v2.14 additions (Wave B C3-P0-08).\n695\t        \"archetype\": archetype,\n696\t        \"dispatch_mode\": dispatch_mode,\n697\t        # PLAN-080 Phase 1 v2.24 addition (M2-C3 + M2-CDX-1) —\n698\t        # dispatch_archetype_hint captured pre-ADR-082-mitigation.\n699\t        # Validated via _lib.audit_emit redaction contract.\n700\t        # Always-present (null when env unset or validation rejected).\n701\t        \"dispatch_archetype_hint\": dispatch_archetype_hint,\n702\t    }\n703\t    return entry\n704\t\n705\t\n706\t# -----------------------------------------------------------------------------\n707\t# PLAN-020 v2.7 cache-header capture helpers (Phase 0 item 1)\n708\t# -----------------------------------------------------------------------------\n709\t\n710\t# Canonical-5 archetypes that ship with native subagent files (ADR-050).\n711\t# Rail discrimination: archetype is \"native\" IFF its name matches AND\n712\t# subagent_type is non-empty. Else \"custom\" if classic spawn signal is\n713\t# present. Else null (legacy / unknown)."}]},"parent_tool_use_id":null,"session_id":"87055104-8462-4c4d-860e-1d287a85b12f","uuid":"0e4c0196-e61e-4fd8-aa83-ce9bb218e510","timestamp":"2026-11-13T16:36:29.913Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/audit_log.py","content":"def build_entry(\n    *,\n    event: \"_contract.NormalizedEvent | _payload.HookPayload\",\n    project_dir: str,\n    hook_duration_ms: int,\n) -> Optional[Dict[str, Any]]:\n    \"\"\"Construct a JSONL row from a NormalizedEvent (or legacy HookPayload).\n\n    Accepts either type for backward compatibility with older tests.\n    Returns None if the event indicates a non-Agent tool (defensive — the\n    matcher should already filter to Agent).\n    \"\"\"\n    tool_name = getattr(event, \"tool_name\", \"\")\n    if tool_name and tool_name not in (\"Agent\", \"unknown\"):\n        return None\n\n    description = getattr(event, \"description\", \"\") or \"\"\n    prompt = getattr(event, \"prompt\", \"\") or \"\"\n    session_id = getattr(event, \"session_id\", \"\") or \"\"\n    subagent_type = getattr(event, \"subagent_type\", \"\") or \"\"\n    tool_response = getattr(event, \"tool_response\", {}) or {}\n\n    desc_preview = _redact.redact_secrets(description)\n    desc_hash = _redact.hash_description(description)\n    # PLAN-079: pass subagent_type for Path D archetype-mapping fallback.\n    skill = extract_skill(prompt, subagent_type)\n\n    # PLAN-006 Phase 5b (ADR-016): extract token counts from tool_response.\n    # Always emit the keys (even if None) so consumers can distinguish\n    # \"post-ADR-016 emitter with unknown shape\" from \"pre-ADR-016 emitter\".\n    tin, tout = _tokens.extract_tokens(tool_response)\n    ttotal = _tokens.total_tokens(tool_response)\n\n    # PLAN-020 Phase 0 item 1: capture Anthropic usage_metadata for cache\n    # coverage analysis. Additive v2.7 fields. Null-safe for emitters that\n    # don't provide usage_metadata (legacy + non-Anthropic adapters).\n    usage_metadata = _extract_usage_metadata(tool_response)\n    # PLAN-118 WS-E (S181): the derived ratio is a FLOAT, which\n    # ``canonical_json.encode()`` forbids in HMAC-covered payloads\n    # (``CanonicalJsonError`` → fail-open ``hmac:null`` → chain one-way-rule\n    # break → whole-chain ``tamper``). Encode as integer basis-points\n    # (ratio × 10000, clamped 0..10000) BEFORE it reaches the entry dict.\n    # Mirrors the S164 ``hit_rate`` → ``hit_rate_bps`` class fix; closes the\n    # last live float-in-HMAC leak (the agent_spawn observer path that the\n    # S164 emit_* introspection guard never covered).\n    cache_coverage = _compute_cache_coverage(usage_metadata)\n    cache_coverage_bps = (\n        max(0, min(10000, int(round(cache_coverage * 10000))))\n        if cache_coverage is not None\n        else None\n    )\n\n    # PLAN-020 Phase 1: dual-rail discriminator. Detect from prompt\n    # structure (## SKILL REFERENCE = native rail; ## SKILL CONTENT =\n    # custom inline rail) OR from subagent_type matching canonical-5.\n    rail = _detect_rail(prompt, subagent_type)\n\n    # PLAN-021 ADR-052: model discriminator. Captured from Anthropic\n    # API response when present. Null-safe for non-Anthropic adapters.\n    # PLAN-044 audit-v2 C3-P0-01 (Wave B): fall back to ADR-052\n    # role-to-model policy when tool_response.model is null (default\n    # behavior of Task tool response shape at v1.11.0).\n    model = _extract_model(tool_response, subagent_type=subagent_type)\n\n    # PLAN-044 audit-v2 C3-P0-08 (Wave B): archetype + dispatch_mode\n    # fields. Audit-telemetry.py per-archetype rollups depend on these\n    # being non-null. ADR-082 per-archetype dispatch claim was undone\n    # at v1.11.0 because no emitter wrote them. Wave B closes the gap.\n    archetype = subagent_type if (\n        isinstance(subagent_type, str) and subagent_type\n    ) else None\n    dispatch_mode = _resolve_dispatch_mode(subagent_type or \"\", rail)\n\n    # PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2): capture dispatch_archetype_hint\n    # from the IN-PROMPT marker emitted by inject-agent-context.sh:\n    #   `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n    # The marker propagates cross-process via the recorded `prompt` payload —\n    # env vars do NOT survive the inject-agent-context.sh subprocess → Agent\n    # tool dispatch → audit hook subprocess chain (Codex iter 2 finding).\n    #\n    # Validated via the same NFKC + ≤64 char + charset `^[a-z][a-z0-9-]*$` +\n    # control/JSON-meta rejection contract as `_lib.audit_emit._validate_dispatch_archetype_hint`.\n    # On rejection (or marker absent): returns None (fail-open). The field is\n    # always emitted in the audit row — null when no hint is set/validated,\n    # validated string otherwise.\n    dispatch_archetype_hint = _extract_dispatch_archetype_hint(prompt)\n\n    entry: Dict[str, Any] = {\n        \"ts\": now_iso_utc(),\n        \"action\": \"agent_spawn\",\n        \"session_id\": session_id,\n        \"project\": project_dir,\n        \"tool\": tool_name or \"Agent\",\n        \"subagent_type\": subagent_type,\n        \"desc_preview\": desc_preview,\n        \"desc_hash\": desc_hash,\n        \"skill\": skill,\n        \"has_profile\": has_profile(prompt),\n        \"has_file_assignment\": has_file_assignment(prompt),\n        \"prompt_len_bucket\": bucket_prompt_length(len(prompt)),\n        \"response_kind\": _payload.response_kind(tool_response),\n        \"hook_duration_ms\": int(hook_duration_ms),\n        # Tokens (ADR-016): optional nullable, always-present.\n        \"tokens_in\": tin,\n        \"tokens_out\": tout,\n        \"tokens_total\": ttotal,\n        # PLAN-020 v2.7 additions (ADDITIVE — older consumers ignore).\n        \"usage_metadata\": usage_metadata,\n        # PLAN-118 WS-E (S181): integer basis-points (ratio × 10000) — the\n        # legacy float ``cache_coverage`` field is REMOVED (it caused\n        # CanonicalJsonError + fail-open hmac:null on every real spawn).\n        \"cache_coverage_bps\": cache_coverage_bps,\n        \"rail\": rail,\n        # PLAN-021 v2.8 addition (ADDITIVE — ADR-052 multi-model).\n        \"model\": model,\n        # PLAN-044 audit-v2 v2.14 additions (Wave B C3-P0-08).\n        \"archetype\": archetype,\n        \"dispatch_mode\": dispatch_mode,\n        # PLAN-080 Phase 1 v2.24 addition (M2-C3 + M2-CDX-1) —\n        # dispatch_archetype_hint captured pre-ADR-082-mitigation.\n        # Validated via _lib.audit_emit redaction contract.\n        # Always-present (null when env unset or validation rejected).\n        \"dispatch_archetype_hint\": dispatch_archetype_hint,\n    }\n    return entry\n\n\n# -----------------------------------------------------------------------------\n# PLAN-020 v2.7 cache-header capture helpers (Phase 0 item 1)\n# -----------------------------------------------------------------------------\n\n# Canonical-5 archetypes that ship with native subagent files (ADR-050).\n# Rail discrimination: archetype is \"native\" IFF its name matches AND\n# subagent_type is non-empty. Else \"custom\" if classic spawn signal is\n# present. Else null (legacy / unknown).","numLines":135,"startLine":579,"totalLines":1616}},"tool_result_meta":[{"id":"toolu_017uh91L7xQJZ42asxkKmSJL","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
