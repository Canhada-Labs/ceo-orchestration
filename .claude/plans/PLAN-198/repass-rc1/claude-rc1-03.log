{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CaKpp9m6LnBfhKEJUM9tYt","type":"tool_result","content":"1330\t# PLAN-155 Wave 4 — Codex host-wire audit-chain path (SENT-CX-B / ADR-161)\n1331\t# -----------------------------------------------------------------------------\n1332\t#\n1333\t# Under OpenAI Codex (CEO_HOOK_ADAPTER=codex) the same audit_log.py hook is\n1334\t# registered on the PostToolUse `*` matcher (templates/codex/hooks.json) and,\n1335\t# via the headless `scripts/codex-exec-wrapper.sh`, is fed synthesized\n1336\t# SessionStart/Stop bracket envelopes. The codex path reads the codex host\n1337\t# wire through the codex adapter and appends metadata-only records to the SAME\n1338\t# HMAC chain via `_lib.audit_emit` (the single-writer emitter that verify_chain\n1339\t# validates). Two NEW registered actions keep the per-tool append and the\n1340\t# turn-level backstop COUNTABLE separately (PLAN-155 Wave 4-A / Wave 4-B):\n1341\t#\n1342\t#   PostToolUse (any tool)  -> emit_codex_tool_recorded   (per-tool append, A)\n1343\t#   Stop / SubagentStop     -> emit_codex_turn_ended      (turn backstop, B)\n1344\t#   SessionStart            -> emit_session_start          (boot bracket; only\n1345\t#                              reached via the wrapper — production codex\n1346\t#                              routes SessionStart to SessionStart.py, so there\n1347\t#                              is no double-count)\n1348\t#\n1349\t# The claude (default) path below is UNCHANGED and byte-identical when\n1350\t# CEO_HOOK_ADAPTER is unset/`claude`. Completeness residual (named, ADR-161 +\n1351\t# degradation page): partial shell interception means a per-tool row may be\n1352\t# absent — absence is not evidence of absence of activity. verify_chain() and\n1353\t# the HMAC chain shape are untouched; this path only appends.\n1354\t\n1355\t# Closed tool-name enum mirror of _lib.audit_emit._CODEX_TOOL_RECORDED_TOOL_NAME_ENUM.\n1356\t# The codex adapter has already aliased apply_patch -> Write/Edit and\n1357\t# spawn_agent -> Task before we see the event; here we only fold mcp__* down to\n1358\t# `mcp_other` (MF-SEC-1) and leave the emitter to coerce any residual miss to\n1359\t# `other`.\n1360\tdef _codex_tool_enum(tool_name: str) -> str:\n1361\t    \"\"\"Map a normalized codex tool name to the closed audit enum. Never raises.\"\"\"\n1362\t    if not isinstance(tool_name, str) or not tool_name:\n1363\t        return \"other\"\n1364\t    if tool_name.startswith(\"mcp__\"):\n1365\t        return \"mcp_other\"\n1366\t    return tool_name\n1367\t\n1368\t\n1369\tdef _codex_audit_main(t0: float) -> int:\n1370\t    \"\"\"Codex host-wire audit append (PLAN-155 Wave 4). Exits 0 on every path.\n1371\t\n1372\t    Reads the codex host envelope via the codex adapter and appends the\n1373\t    matching metadata-only action to the shared HMAC chain through\n1374\t    `_lib.audit_emit`. Fail-open per SPEC/v1 §4 — the audit hook is\n1375\t    observability, not an enforcement gate, so an unresolved adapter / parse\n1376\t    error / import failure breadcrumbs and returns 0 (the completeness bound is\n1377\t    already the named residual; a security matcher would fail CLOSED instead,\n1378\t    but this is not one).\n1379\t    \"\"\"\n1380\t    try:\n1381\t        from _lib.adapters import codex as _codex_adapter\n1382\t        from _lib import audit_emit as _audit_emit\n1383\t    except Exception as e:  # pragma: no cover — infrastructure import failure\n1384\t        try:\n1385\t            write_breadcrumb(\n1386\t                audit_paths()[\"err\"],\n1387\t                f\"codex audit import failed (fail-open): {type(e).__name__}\",\n1388\t            )\n1389\t        except Exception:\n1390\t            pass\n1391\t        return 0\n1392\t\n1393\t    try:\n1394\t        event = _codex_adapter.read_post_event()\n1395\t    except Exception as e:  # pragma: no cover — adapter never raises by contract\n1396\t        write_breadcrumb(\n1397\t            audit_paths()[\"err\"],\n1398\t            f\"codex read_post_event raised (fail-open): {type(e).__name__}\",\n1399\t        )\n1400\t        return 0\n1401\t\n1402\t    if getattr(event, \"parse_error\", None):\n1403\t        write_breadcrumb(\n1404\t            audit_paths()[\"err\"],\n1405\t            f\"codex stdin parse error: {event.parse_error}\",\n1406\t        )\n1407\t        return 0\n1408\t\n1409\t    # The codex wire's event name WINS over the phase arg (host adapter sets\n1410\t    # NormalizedEvent.phase = hook_event_name). raw_payload carries the raw\n1411\t    # codex scalars (stop_hook_active, etc.).\n1412\t    hook_event = str(getattr(event, \"phase\", \"\") or \"\")\n1413\t    raw_payload = getattr(event, \"raw_payload\", {}) or {}\n1414\t    session_id = str(getattr(event, \"session_id\", \"\") or \"\")\n1415\t    project_dir = str(getattr(event, \"project\", \"\") or \"\") or (\n1416\t        os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n1417\t    )\n1418\t\n1419\t    try:\n1420\t        if hook_event == \"PostToolUse\":\n1421\t            tool_enum = _codex_tool_enum(str(getattr(event, \"tool_name\", \"\") or \"\"))\n1422\t            _audit_emit.emit_codex_tool_recorded(\n1423\t                session_id=session_id,\n1424\t                tool_name_enum=tool_enum,\n1425\t                hook_event_name=\"PostToolUse\",\n1426\t                project=project_dir,\n1427\t            )\n1428\t        elif hook_event in (\"Stop\", \"SubagentStop\"):\n1429\t            # source: derive from the event, unless the headless wrapper\n1430\t            # overrode it (CEO_CODEX_TURN_SOURCE) to mark a wrapper bracket.\n1431\t            derived = \"subagent_stop\" if hook_event == \"SubagentStop\" else \"stop\"\n1432\t            source = os.environ.get(\"CEO_CODEX_TURN_SOURCE\") or derived\n1433\t            stop_active = bool(raw_payload.get(\"stop_hook_active\"))\n1434\t            _audit_emit.emit_codex_turn_ended(\n1435\t                session_id=session_id,\n1436\t                source=source,\n1437\t                stop_hook_active=stop_active,\n1438\t                project=project_dir,\n1439\t            )\n1440\t        elif hook_event == \"SessionStart\":\n1441\t            # Boot bracket — only reached when the wrapper pipes a SessionStart\n1442\t            # envelope here (production routes SessionStart -> SessionStart.py).\n1443\t            emit_ss = getattr(_audit_emit, \"emit_session_start\", None)\n1444\t            if emit_ss is not None:\n1445\t                emit_ss(session_id=session_id, project=project_dir)\n1446\t        # else: UserPromptSubmit / SubagentStart / PreToolUse are not this\n1447\t        # hook's job under codex — return 0 (no append).\n1448\t    except Exception as e:  # pragma: no cover — emit is fail-open by contract\n1449\t        write_breadcrumb(\n1450\t            audit_paths()[\"err\"],\n1451\t            f\"codex audit emit failed (fail-open): {type(e).__name__}\",\n1452\t        )\n1453\t    return 0\n1454\t\n1455\t\n1456\tdef _grok_tool_enum(tool_name: str) -> str:\n1457\t    \"\"\"Map a normalized grok tool name to the closed audit enum. Never raises.\n1458\t\n1459\t    The grok adapter has already aliased run_terminal_command -> Bash,\n1460\t    search_replace -> Edit, spawn_subagent -> Task, etc. before we see the\n1461\t    event; here we only fold mcp__* down to `mcp_other` (MF-SEC-1) and leave\n1462\t    the emitter to coerce any residual miss to `other`.\n1463\t    \"\"\"\n1464\t    if not isinstance(tool_name, str) or not tool_name:\n1465\t        return \"other\"\n1466\t    if tool_name.startswith(\"mcp__\"):\n1467\t        return \"mcp_other\"\n1468\t    return tool_name\n1469\t\n1470\t\n1471\tdef _grok_audit_main(t0: float) -> int:\n1472\t    \"\"\"Grok host-wire audit append (PLAN-156 Wave 4). Exits 0 on every path.\n1473\t\n1474\t    Mirror of `_codex_audit_main`: reads the grok host envelope via the grok\n1475\t    adapter and appends the matching metadata-only action to the shared HMAC\n1476\t    chain through `_lib.audit_emit`. Fail-open per SPEC/v1 §4 — the audit hook\n1477\t    is observability, not enforcement, so an unresolved adapter / parse error\n1478\t    / import failure breadcrumbs and returns 0.\n1479\t\n1480\t    Grok specifics: PostToolUse is passive (a deny cannot block), but the\n1481\t    append still lands. SessionEnd is unreliable in headless runs, so\n1482\t    turn-ended accounting hangs off Stop / SubagentStop (completeness caveat,\n1483\t    ADR-162).\n1484\t    \"\"\"\n1485\t    try:\n1486\t        from _lib.adapters import grok as _grok_adapter\n1487\t        from _lib import audit_emit as _audit_emit\n1488\t    except Exception as e:  # pragma: no cover — infrastructure import failure\n1489\t        try:\n1490\t            write_breadcrumb(\n1491\t                audit_paths()[\"err\"],\n1492\t                f\"grok audit import failed (fail-open): {type(e).__name__}\",\n1493\t            )\n1494\t        except Exception:\n1495\t            pass\n1496\t        return 0\n1497\t\n1498\t    try:\n1499\t        event = _grok_adapter.read_post_event()\n1500\t    except Exception as e:  # pragma: no cover — adapter never raises by contract\n1501\t        write_breadcrumb(\n1502\t            audit_paths()[\"err\"],\n1503\t            f\"grok read_post_event raised (fail-open): {type(e).__name__}\",\n1504\t        )\n1505\t        return 0\n1506\t\n1507\t    if getattr(event, \"parse_error\", None):\n1508\t        write_breadcrumb(\n1509\t            audit_paths()[\"err\"],\n1510\t            f\"grok stdin parse error: {event.parse_error}\",\n1511\t        )\n1512\t        return 0\n1513\t\n1514\t    hook_event = str(getattr(event, \"phase\", \"\") or \"\")\n1515\t    session_id = str(getattr(event, \"session_id\", \"\") or \"\")\n1516\t    project_dir = str(getattr(event, \"project\", \"\") or \"\") or (\n1517\t        os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n1518\t    )\n1519\t\n1520\t    try:\n1521\t        if hook_event == \"PostToolUse\":\n1522\t            tool_enum = _grok_tool_enum(str(getattr(event, \"tool_name\", \"\") or \"\"))\n1523\t            _audit_emit.emit_grok_tool_recorded(\n1524\t                session_id=session_id,\n1525\t                tool_name_enum=tool_enum,\n1526\t                hook_event_name=\"PostToolUse\",\n1527\t                project=project_dir,\n1528\t            )\n1529\t        elif hook_event in (\"Stop\", \"SubagentStop\"):\n1530\t            derived = \"subagent_stop\" if hook_event == \"SubagentStop\" else \"stop\"\n1531\t            source = os.environ.get(\"CEO_GROK_TURN_SOURCE\") or derived\n1532\t            _audit_emit.emit_grok_turn_ended(\n1533\t                session_id=session_id,\n1534\t                source=source,\n1535\t                project=project_dir,\n1536\t            )\n1537\t        # else: SessionStart / UserPromptSubmit / SubagentStart / PreToolUse\n1538\t        # are not this hook's job under grok — return 0 (no append).\n1539\t    except Exception as e:  # pragma: no cover — emit is fail-open by contract\n1540\t        write_breadcrumb(\n1541\t            audit_paths()[\"err\"],\n1542\t            f\"grok audit emit failed (fail-open): {type(e).__name__}\",\n1543\t        )\n1544\t    return 0\n1545\t\n1546\t\n1547\t# -----------------------------------------------------------------------------\n1548\t# Main entry point\n1549\t# -----------------------------------------------------------------------------\n1550\t\n1551\t\n1552\tdef main() -> int:\n1553\t    \"\"\"PostToolUse hook entry point.\n1554\t\n1555\t    PLAN-006 Phase 1 final migration (ADR-014): uses\n1556\t    `claude_adapter.read_post_event()` with explicit PostToolUse phase\n1557\t    (R-SB1 fix). Reads stdin, extracts fields, redacts, writes one\n1558\t    JSONL line to the audit log under lock. Silent on stdout. Exits 0\n1559\t    on all paths (fail-open governance contract).\n1560\t\n1561\t    PLAN-155 Wave 4: under CEO_HOOK_ADAPTER=codex the codex host-wire path\n1562\t    (`_codex_audit_main`) handles the append via `_lib.audit_emit`; the claude\n1563\t    path below is byte-identical when the env var is unset/`claude`.\n1564\t    \"\"\"\n1565\t    t0 = time.monotonic()\n1566\t    _adapter = os.environ.get(\"CEO_HOOK_ADAPTER\")\n1567\t    if _adapter == \"codex\":\n1568\t        return _codex_audit_main(t0)\n1569\t    if _adapter == \"grok\":\n1570\t        return _grok_audit_main(t0)\n1571\t    try:\n1572\t        event = _claude_adapter.read_post_event()\n1573\t        if event.parse_error:\n1574\t            paths = audit_paths()\n1575\t            write_breadcrumb(\n1576\t                paths[\"err\"],\n1577\t                f\"stdin parse error: {event.parse_error}\",\n1578\t            )\n1579\t            return 0\n1580\t\n1581\t        # Filter: only care about Agent spawns\n1582\t        if event.tool_name and event.tool_name not in (\"Agent\", \"unknown\"):\n1583\t            return 0\n1584\t\n1585\t        project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n1586\t        try:\n1587\t            project_dir = str(Path(project_dir).resolve())\n1588\t        except OSError:\n1589\t            pass\n1590\t\n1591\t        duration_ms = int((time.monotonic() - t0) * 1000)\n1592\t        entry = build_entry(\n1593\t            event=event, project_dir=project_dir, hook_duration_ms=duration_ms\n1594\t        )\n1595\t        if entry is None:\n1596\t            return 0\n1597\t\n1598\t        paths = audit_paths()\n1599\t        append_entry(\n1600\t            entry,\n1601\t            paths=paths,\n1602\t            threshold_bytes=rotate_threshold(),\n1603\t        )\n1604\t        return 0\n1605\t    except Exception as e:  # pragma: no cover — catastrophic\n1606\t        try:\n1607\t            paths = audit_paths()\n1608\t            write_breadcrumb(paths[\"err\"], f\"fatal: {e.__class__.__name__}: {e}\")\n1609\t        except Exception:\n1610\t            pass\n1611\t        return 0\n1612\t\n1613\t\n1614\tif __name__ == \"__main__\":\n1615\t    sys.exit(main())\n1616\t"}]},"parent_tool_use_id":null,"session_id":"dbb97fe8-0e18-4c56-9a57-e9a508557997","uuid":"8c2bc1a6-42df-4c18-bfaa-c264698f116b","timestamp":"2026-11-15T09:19:51.885Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/audit_log.py","content":"# PLAN-155 Wave 4 — Codex host-wire audit-chain path (SENT-CX-B / ADR-161)\n# -----------------------------------------------------------------------------\n#\n# Under OpenAI Codex (CEO_HOOK_ADAPTER=codex) the same audit_log.py hook is\n# registered on the PostToolUse `*` matcher (templates/codex/hooks.json) and,\n# via the headless `scripts/codex-exec-wrapper.sh`, is fed synthesized\n# SessionStart/Stop bracket envelopes. The codex path reads the codex host\n# wire through the codex adapter and appends metadata-only records to the SAME\n# HMAC chain via `_lib.audit_emit` (the single-writer emitter that verify_chain\n# validates). Two NEW registered actions keep the per-tool append and the\n# turn-level backstop COUNTABLE separately (PLAN-155 Wave 4-A / Wave 4-B):\n#\n#   PostToolUse (any tool)  -> emit_codex_tool_recorded   (per-tool append, A)\n#   Stop / SubagentStop     -> emit_codex_turn_ended      (turn backstop, B)\n#   SessionStart            -> emit_session_start          (boot bracket; only\n#                              reached via the wrapper — production codex\n#                              routes SessionStart to SessionStart.py, so there\n#                              is no double-count)\n#\n# The claude (default) path below is UNCHANGED and byte-identical when\n# CEO_HOOK_ADAPTER is unset/`claude`. Completeness residual (named, ADR-161 +\n# degradation page): partial shell interception means a per-tool row may be\n# absent — absence is not evidence of absence of activity. verify_chain() and\n# the HMAC chain shape are untouched; this path only appends.\n\n# Closed tool-name enum mirror of _lib.audit_emit._CODEX_TOOL_RECORDED_TOOL_NAME_ENUM.\n# The codex adapter has already aliased apply_patch -> Write/Edit and\n# spawn_agent -> Task before we see the event; here we only fold mcp__* down to\n# `mcp_other` (MF-SEC-1) and leave the emitter to coerce any residual miss to\n# `other`.\ndef _codex_tool_enum(tool_name: str) -> str:\n    \"\"\"Map a normalized codex tool name to the closed audit enum. Never raises.\"\"\"\n    if not isinstance(tool_name, str) or not tool_name:\n        return \"other\"\n    if tool_name.startswith(\"mcp__\"):\n        return \"mcp_other\"\n    return tool_name\n\n\ndef _codex_audit_main(t0: float) -> int:\n    \"\"\"Codex host-wire audit append (PLAN-155 Wave 4). Exits 0 on every path.\n\n    Reads the codex host envelope via the codex adapter and appends the\n    matching metadata-only action to the shared HMAC chain through\n    `_lib.audit_emit`. Fail-open per SPEC/v1 §4 — the audit hook is\n    observability, not an enforcement gate, so an unresolved adapter / parse\n    error / import failure breadcrumbs and returns 0 (the completeness bound is\n    already the named residual; a security matcher would fail CLOSED instead,\n    but this is not one).\n    \"\"\"\n    try:\n        from _lib.adapters import codex as _codex_adapter\n        from _lib import audit_emit as _audit_emit\n    except Exception as e:  # pragma: no cover — infrastructure import failure\n        try:\n            write_breadcrumb(\n                audit_paths()[\"err\"],\n                f\"codex audit import failed (fail-open): {type(e).__name__}\",\n            )\n        except Exception:\n            pass\n        return 0\n\n    try:\n        event = _codex_adapter.read_post_event()\n    except Exception as e:  # pragma: no cover — adapter never raises by contract\n        write_breadcrumb(\n            audit_paths()[\"err\"],\n            f\"codex read_post_event raised (fail-open): {type(e).__name__}\",\n        )\n        return 0\n\n    if getattr(event, \"parse_error\", None):\n        write_breadcrumb(\n            audit_paths()[\"err\"],\n            f\"codex stdin parse error: {event.parse_error}\",\n        )\n        return 0\n\n    # The codex wire's event name WINS over the phase arg (host adapter sets\n    # NormalizedEvent.phase = hook_event_name). raw_payload carries the raw\n    # codex scalars (stop_hook_active, etc.).\n    hook_event = str(getattr(event, \"phase\", \"\") or \"\")\n    raw_payload = getattr(event, \"raw_payload\", {}) or {}\n    session_id = str(getattr(event, \"session_id\", \"\") or \"\")\n    project_dir = str(getattr(event, \"project\", \"\") or \"\") or (\n        os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n    )\n\n    try:\n        if hook_event == \"PostToolUse\":\n            tool_enum = _codex_tool_enum(str(getattr(event, \"tool_name\", \"\") or \"\"))\n            _audit_emit.emit_codex_tool_recorded(\n                session_id=session_id,\n                tool_name_enum=tool_enum,\n                hook_event_name=\"PostToolUse\",\n                project=project_dir,\n            )\n        elif hook_event in (\"Stop\", \"SubagentStop\"):\n            # source: derive from the event, unless the headless wrapper\n            # overrode it (CEO_CODEX_TURN_SOURCE) to mark a wrapper bracket.\n            derived = \"subagent_stop\" if hook_event == \"SubagentStop\" else \"stop\"\n            source = os.environ.get(\"CEO_CODEX_TURN_SOURCE\") or derived\n            stop_active = bool(raw_payload.get(\"stop_hook_active\"))\n            _audit_emit.emit_codex_turn_ended(\n                session_id=session_id,\n                source=source,\n                stop_hook_active=stop_active,\n                project=project_dir,\n            )\n        elif hook_event == \"SessionStart\":\n            # Boot bracket — only reached when the wrapper pipes a SessionStart\n            # envelope here (production routes SessionStart -> SessionStart.py).\n            emit_ss = getattr(_audit_emit, \"emit_session_start\", None)\n            if emit_ss is not None:\n                emit_ss(session_id=session_id, project=project_dir)\n        # else: UserPromptSubmit / SubagentStart / PreToolUse are not this\n        # hook's job under codex — return 0 (no append).\n    except Exception as e:  # pragma: no cover — emit is fail-open by contract\n        write_breadcrumb(\n            audit_paths()[\"err\"],\n            f\"codex audit emit failed (fail-open): {type(e).__name__}\",\n        )\n    return 0\n\n\ndef _grok_tool_enum(tool_name: str) -> str:\n    \"\"\"Map a normalized grok tool name to the closed audit enum. Never raises.\n\n    The grok adapter has already aliased run_terminal_command -> Bash,\n    search_replace -> Edit, spawn_subagent -> Task, etc. before we see the\n    event; here we only fold mcp__* down to `mcp_other` (MF-SEC-1) and leave\n    the emitter to coerce any residual miss to `other`.\n    \"\"\"\n    if not isinstance(tool_name, str) or not tool_name:\n        return \"other\"\n    if tool_name.startswith(\"mcp__\"):\n        return \"mcp_other\"\n    return tool_name\n\n\ndef _grok_audit_main(t0: float) -> int:\n    \"\"\"Grok host-wire audit append (PLAN-156 Wave 4). Exits 0 on every path.\n\n    Mirror of `_codex_audit_main`: reads the grok host envelope via the grok\n    adapter and appends the matching metadata-only action to the shared HMAC\n    chain through `_lib.audit_emit`. Fail-open per SPEC/v1 §4 — the audit hook\n    is observability, not enforcement, so an unresolved adapter / parse error\n    / import failure breadcrumbs and returns 0.\n\n    Grok specifics: PostToolUse is passive (a deny cannot block), but the\n    append still lands. SessionEnd is unreliable in headless runs, so\n    turn-ended accounting hangs off Stop / SubagentStop (completeness caveat,\n    ADR-162).\n    \"\"\"\n    try:\n        from _lib.adapters import grok as _grok_adapter\n        from _lib import audit_emit as _audit_emit\n    except Exception as e:  # pragma: no cover — infrastructure import failure\n        try:\n            write_breadcrumb(\n                audit_paths()[\"err\"],\n                f\"grok audit import failed (fail-open): {type(e).__name__}\",\n            )\n        except Exception:\n            pass\n        return 0\n\n    try:\n        event = _grok_adapter.read_post_event()\n    except Exception as e:  # pragma: no cover — adapter never raises by contract\n        write_breadcrumb(\n            audit_paths()[\"err\"],\n            f\"grok read_post_event raised (fail-open): {type(e).__name__}\",\n        )\n        return 0\n\n    if getattr(event, \"parse_error\", None):\n        write_breadcrumb(\n            audit_paths()[\"err\"],\n            f\"grok stdin parse error: {event.parse_error}\",\n        )\n        return 0\n\n    hook_event = str(getattr(event, \"phase\", \"\") or \"\")\n    session_id = str(getattr(event, \"session_id\", \"\") or \"\")\n    project_dir = str(getattr(event, \"project\", \"\") or \"\") or (\n        os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n    )\n\n    try:\n        if hook_event == \"PostToolUse\":\n            tool_enum = _grok_tool_enum(str(getattr(event, \"tool_name\", \"\") or \"\"))\n            _audit_emit.emit_grok_tool_recorded(\n                session_id=session_id,\n                tool_name_enum=tool_enum,\n                hook_event_name=\"PostToolUse\",\n                project=project_dir,\n            )\n        elif hook_event in (\"Stop\", \"SubagentStop\"):\n            derived = \"subagent_stop\" if hook_event == \"SubagentStop\" else \"stop\"\n            source = os.environ.get(\"CEO_GROK_TURN_SOURCE\") or derived\n            _audit_emit.emit_grok_turn_ended(\n                session_id=session_id,\n                source=source,\n                project=project_dir,\n            )\n        # else: SessionStart / UserPromptSubmit / SubagentStart / PreToolUse\n        # are not this hook's job under grok — return 0 (no append).\n    except Exception as e:  # pragma: no cover — emit is fail-open by contract\n        write_breadcrumb(\n            audit_paths()[\"err\"],\n            f\"grok audit emit failed (fail-open): {type(e).__name__}\",\n        )\n    return 0\n\n\n# -----------------------------------------------------------------------------\n# Main entry point\n# -----------------------------------------------------------------------------\n\n\ndef main() -> int:\n    \"\"\"PostToolUse hook entry point.\n\n    PLAN-006 Phase 1 final migration (ADR-014): uses\n    `claude_adapter.read_post_event()` with explicit PostToolUse phase\n    (R-SB1 fix). Reads stdin, extracts fields, redacts, writes one\n    JSONL line to the audit log under lock. Silent on stdout. Exits 0\n    on all paths (fail-open governance contract).\n\n    PLAN-155 Wave 4: under CEO_HOOK_ADAPTER=codex the codex host-wire path\n    (`_codex_audit_main`) handles the append via `_lib.audit_emit`; the claude\n    path below is byte-identical when the env var is unset/`claude`.\n    \"\"\"\n    t0 = time.monotonic()\n    _adapter = os.environ.get(\"CEO_HOOK_ADAPTER\")\n    if _adapter == \"codex\":\n        return _codex_audit_main(t0)\n    if _adapter == \"grok\":\n        return _grok_audit_main(t0)\n    try:\n        event = _claude_adapter.read_post_event()\n        if event.parse_error:\n            paths = audit_paths()\n            write_breadcrumb(\n                paths[\"err\"],\n                f\"stdin parse error: {event.parse_error}\",\n            )\n            return 0\n\n        # Filter: only care about Agent spawns\n        if event.tool_name and event.tool_name not in (\"Agent\", \"unknown\"):\n            return 0\n\n        project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        try:\n            project_dir = str(Path(project_dir).resolve())\n        except OSError:\n            pass\n\n        duration_ms = int((time.monotonic() - t0) * 1000)\n        entry = build_entry(\n            event=event, project_dir=project_dir, hook_duration_ms=duration_ms\n        )\n        if entry is None:\n            return 0\n\n        paths = audit_paths()\n        append_entry(\n            entry,\n            paths=paths,\n            threshold_bytes=rotate_threshold(),\n        )\n        return 0\n    except Exception as e:  # pragma: no cover — catastrophic\n        try:\n            paths = audit_paths()\n            write_breadcrumb(paths[\"err\"], f\"fatal: {e.__class__.__name__}: {e}\")\n        except Exception:\n            pass\n        return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":287,"startLine":1330,"totalLines":1616}},"tool_result_meta":[{"id":"toolu_01CaKpp9m6LnBfhKEJUM9tYt","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
