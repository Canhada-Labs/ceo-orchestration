{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XazcxCJ1TqEhWguew8tNR4","type":"tool_result","content":"1160\t            required.issubset(audit_emit._KNOWN_ACTIONS),\n1161\t            f\"missing from _KNOWN_ACTIONS: {required - audit_emit._KNOWN_ACTIONS}\",\n1162\t        )\n1163\t\n1164\t\n1165\tclass TestAuditFallbackPath(TestEnvContext):\n1166\t    \"\"\"F-CHAOS-1 — when primary audit dir is unwritable, emit writes\n1167\t    land in /tmp fallback with a once-per-session stderr banner.\"\"\"\n1168\t\n1169\t    def setUp(self):\n1170\t        super().setUp()\n1171\t        audit_emit._FALLBACK_NOTIFIED = False\n1172\t        import tempfile\n1173\t        self._fb_tmp = tempfile.TemporaryDirectory()\n1174\t        self.fallback_path = Path(self._fb_tmp.name) / \"ceo-audit-fallback-testuser.log\"\n1175\t        os.environ[\"CEO_AUDIT_LOG_FALLBACK_PATH\"] = str(self.fallback_path)\n1176\t\n1177\t    def tearDown(self):\n1178\t        os.environ.pop(\"CEO_AUDIT_LOG_FALLBACK_PATH\", None)\n1179\t        audit_emit._FALLBACK_NOTIFIED = False\n1180\t        self._fb_tmp.cleanup()\n1181\t        super().tearDown()\n1182\t\n1183\t    def test_fallback_used_when_primary_unwritable(self):\n1184\t        import io\n1185\t        from unittest import mock\n1186\t\n1187\t        stderr_capture = io.StringIO()\n1188\t        primary_log = audit_emit._log_path()\n1189\t        real_open = Path.open\n1190\t\n1191\t        def fake_open(self_path, *args, **kwargs):\n1192\t            if self_path == primary_log:\n1193\t                raise PermissionError(\"simulated unwritable primary\")\n1194\t            return real_open(self_path, *args, **kwargs)\n1195\t\n1196\t        with mock.patch.object(Path, \"open\", fake_open), \\\n1197\t             mock.patch(\"sys.stderr\", stderr_capture):\n1198\t            audit_emit.emit_debate_event(\n1199\t                plan_id=\"PLAN-019\", round_num=1, phase=\"agent-done\",\n1200\t                agent=\"security-engineer\",\n1201\t            )\n1202\t\n1203\t        self.assertTrue(self.fallback_path.exists())\n1204\t        content = self.fallback_path.read_text()\n1205\t        self.assertIn('\"action\": \"debate_event\"', content)\n1206\t        self.assertIn('\"plan_id\": \"PLAN-019\"', content)\n1207\t\n1208\t        banner = stderr_capture.getvalue()\n1209\t        self.assertIn(\"::warning::audit-log write failed\", banner)\n1210\t        self.assertIn(\"falling back to\", banner)\n1211\t        self.assertEqual(banner.count(\"::warning::audit-log write failed\"), 1)\n1212\t\n1213\t    def test_fallback_banner_dedups_across_writes(self):\n1214\t        import io\n1215\t        from unittest import mock\n1216\t\n1217\t        stderr_capture = io.StringIO()\n1218\t        primary_log = audit_emit._log_path()\n1219\t        real_open = Path.open\n1220\t\n1221\t        def fake_open(self_path, *args, **kwargs):\n1222\t            if self_path == primary_log:\n1223\t                raise PermissionError(\"simulated\")\n1224\t            return real_open(self_path, *args, **kwargs)\n1225\t\n1226\t        with mock.patch.object(Path, \"open\", fake_open), \\\n1227\t             mock.patch(\"sys.stderr\", stderr_capture):\n1228\t            for i in range(5):\n1229\t                audit_emit.emit_veto_triggered(\n1230\t                    hook=\"check_agent_spawn\",\n1231\t                    reason_code=\"test\",\n1232\t                    reason_preview=f\"preview {i}\",\n1233\t                )\n1234\t\n1235\t        self.assertTrue(self.fallback_path.exists())\n1236\t        lines = [\n1237\t            line for line in self.fallback_path.read_text().splitlines()\n1238\t            if line.strip()\n1239\t        ]"}]},"parent_tool_use_id":null,"session_id":"87055104-8462-4c4d-860e-1d287a85b12f","uuid":"0b15ad69-b7c8-4cff-af51-bee369148d93","timestamp":"2026-11-13T16:36:17.371Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1