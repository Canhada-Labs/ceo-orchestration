eld.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"credential_rotation_due\",\n        \"provider\": provider,\n        \"age_days\": int(age_days),\n        \"warn_threshold_days\": int(warn_threshold_days),\n        \"max_threshold_days\": int(max_threshold_days),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\nfrom _lib._audit_emit_parts import install as _install_parts\n\n_install_parts(\n    globals(),\n    (\n        \"writer\",\n        \"streaming\",\n        \"boot_schemas\",\n        \"optimizer\",\n        \"federation_schemas\",\n        \"governance\",\n        \"workflow\",\n        \"resource_events\",\n        \"adapters\",\n        \"security\",\n        \"planning\",\n        \"replay\",\n        \"lifecycle_schemas\",\n        \"harness_schemas\",\n        \"compaction\",\n        \"context_pressure\",\n        \"tokens_boot\",\n        \"harness\",\n        \"lifecycle\",\n        \"defense\",\n        \"routing\",\n        \"pair_rail\",\n        \"rate_limits\",\n        \"operations\",\n        \"orchestration\",\n        \"federation_persona\",\n        \"confidence\",\n        \"finalization\",\n        \"generic_dispatch_01\",\n        \"generic_dispatch_02\",\n        \"generic_dispatch_03\",\n        \"generic_dispatch_04\",\n        \"generic_dispatch_05\",\n    ),\n)\n\n\n# ``install`` has just bound replay.iter_events to this facade namespace, so\n# keep that bound implementation behind the stable streaming delegation API.\n_streaming = SimpleNamespace(iter_events=iter_events)\n\n\ndef iter_events(*args: Any, **kwargs: Any) -> Any:\n    return _streaming.iter_events(*args, **kwargs)\n\n\n_GENERIC_DISPATCH_HANDLERS = (\n    _apply_generic_group_01,\n    _apply_generic_group_02,\n    _apply_generic_group_03,\n    _apply_generic_group_04,\n    _apply_generic_group_05,\n)\n\n\ndef emit_generic(action: str, **kwargs: Any) -> None:\n    if action == \"tool_call_lifecycle_recorded\":\n        _dispatch_generic(action, kwargs)\n        return\n    if action == \"settings_tamper_detected\":\n        _dispatch_generic(action, kwargs)\n        return\n    _dispatch_generic(action, kwargs)\n\n\n_PLAN088_RATE_LOCK = threading.Lock()\n_PLAN090_BUCKET_LOCK = threading.Lock()\n\nif _SPOOL_WRITER_AVAILABLE and _spool_writer is not None:\n    try:\n        _spool_writer.set_forensic_emitter(\n            lambda _action, _fields: emit_generic(_action, **_fields)\n        )\n    except Exception:\n        pass\n    try:\n        _spool_writer.install_exit_handlers()\n    except Exception:\n        pass\n","numLines":497,"startLine":1,"totalLines":497}},"tool_result_meta":[{"id":"toolu_01Bcg4KWadUwKhnuzDmZV3Yg","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
