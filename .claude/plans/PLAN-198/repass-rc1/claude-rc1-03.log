_judge_hijack_suspected\",\n366\t    \"tournament_run_completed\",\n367\t    \"tournament_run_started\",\n368\t    \"tournament_task_scored\",\n369\t    \"trading_kill_switch_disabled\",\n370\t    \"trading_kill_switch_invoked\",\n371\t    \"trading_write_override_used\",\n372\t    \"value_dashboard_summarized\",\n373\t    \"verify_after_edit_finding\",\n374\t    \"veto_triggered\",\n375\t    \"wave_artifact_written\",\n376\t    \"wave_readonly_violation\",\n377\t}\n378\t\n379\tEVENT_SCHEMA_V2 = \"v2\"\n380\t\n381\t\n382\tdef iter_events(*args: Any, **kwargs: Any) -> Any:\n383\t    return _streaming.iter_events(*args, **kwargs)\n384\t\n385\t\n386\tdef emit_credential_rotation_due(\n387\t    provider: str,\n388\t    age_days: int,\n389\t    warn_threshold_days: int = 75,\n390\t    max_threshold_days: int = 90,\n391\t    session_id: str = \"\",\n392\t    project: str = \"\",\n393\t) -> None:\n394\t    \"\"\"Emit a credential_rotation_due event (ADR-040 §4).\n395\t\n396\t    Fired on every live call once the active API key is older than\n397\t    ``warn_threshold_days`` (default 75). The event does not block the\n398\t    call — it surfaces in the dashboard so the operator rotates before\n399\t    the 90-day hard cap. Credential value is NEVER in any field.\n400\t    \"\"\"\n401\t    event: Dict[str, Any] = {\n402\t        \"action\": \"credential_rotation_due\",\n403\t        \"provider\": provider,\n404\t        \"age_days\": int(age_days),\n405\t        \"warn_threshold_days\": int(warn_threshold_days),\n406\t        \"max_threshold_days\": int(max_threshold_days),\n407\t        \"session_id\": session_id,\n408\t        \"project\": project,\n409\t    }\n410\t    _write_event(event)\n411\t\n412\t\n413\tfrom _lib._audit_emit_parts import install as _install_parts\n414\t\n415\t_install_parts(\n416\t    globals(),\n417\t    (\n418\t        \"writer\",\n419\t        \"streaming\",\n420\t        \"boot_schemas\",\n421\t        \"optimizer\",\n422\t        \"federation_schemas\",\n423\t        \"governance\",\n424\t        \"workflow\",\n425\t        \"resource_events\",\n426\t        \"adapters\",\n427\t        \"security\",\n428\t        \"planning\",\n429\t        \"replay\",\n430\t        \"lifecycle_schemas\",\n431\t        \"harness_schemas\",\n432\t        \"compaction\",\n433\t        \"context_pressure\",\n434\t        \"tokens_boot\",\n435\t        \"harness\",\n436\t        \"lifecycle\",\n437\t        \"defense\",\n438\t        \"routing\",\n439\t        \"pair_rail\",\n440\t        \"rate_limits\",\n441\t        \"operations\",\n442\t        \"orchestration\",\n443\t        \"federation_persona\",\n444\t        \"confidence\",\n445\t        \"finalization\",\n446\t        \"generic_dispatch_01\",\n447\t        \"generic_dispatch_02\",\n448\t        \"generic_dispatch_03\",\n449\t        \"generic_dispatch_04\",\n450\t        \"generic_dispatch_05\",\n451\t    ),\n452\t)\n453\t\n454\t\n455\t# ``install`` has just bound replay.iter_events to this facade namespace, so\n456\t# keep that bound implementation behind the stable streaming delegation API.\n457\t_streaming = SimpleNamespace(iter_events=iter_events)\n458\t\n459\t\n460\tdef iter_events(*args: Any, **kwargs: Any) -> Any:\n461\t    return _streaming.iter_events(*args, **kwargs)\n462\t\n463\t\n464\t_GENERIC_DISPATCH_HANDLERS = (\n465\t    _apply_generic_group_01,\n466\t    _apply_generic_group_02,\n467\t    _apply_generic_group_03,\n468\t    _apply_generic_group_04,\n469\t    _apply_generic_group_05,\n470\t)\n471\t\n472\t\n473\tdef emit_generic(action: str, **kwargs: Any) -> None:\n474\t    if action == \"tool_call_lifecycle_recorded\":\n475\t        _dispatch_generic(action, kwargs)\n476\t        return\n477\t    if action == \"settings_tamper_detected\":\n478\t        _dispatch_generic(action, kwargs)\n479\t        return\n480\t    _dispatch_generic(action, kwargs)\n481\t\n482\t\n483\t_PLAN088_RATE_LOCK = threading.Lock()\n484\t_PLAN090_BUCKET_LOCK = threading.Lock()\n485\t\n486\tif _SPOOL_WRITER_AVAILABLE and _spool_writer is not None:\n487\t    try:\n488\t        _spool_writer.set_forensic_emitter(\n489\t            lambda _action, _fields: emit_generic(_action, **_fields)\n490\t        )\n491\t    except Exception:\n492\t        pass\n493\t    try:\n494\t        _spool_writer.install_exit_handlers()\n495\t    except Exception:\n496\t        pass\n497\t"}]},"parent_tool_use_id":null,"session_id":"dbb97fe8-0e18-4c56-9a57-e9a508557997","uuid":"a54b0363-f772-4da8-818a-42e3d616df29","timestamp":"2026-11-15T09:14:36.010Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/audit_emit.py","content":"from __future__ import annotations\nimport getpass\nimport json\nimport os\nimport re\nimport sys\nimport threading\nimport time\nimport zlib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Optional\nfrom types import SimpleNamespace\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\nfrom _lib import redact as _redact\nfrom _lib import runtime_paths as _runtime_paths\nfrom _lib.filelock import FileLock, FileLockTimeout\nfrom _lib._audit_emit_parts import replay as _streaming\n\ntry:\n    from _lib.audit_rotation import rotate_if_needed as _shared_rotate_if_needed\n\n    _ROTATION_AVAILABLE = True\nexcept Exception:\n    _shared_rotate_if_needed = None\n    _ROTATION_AVAILABLE = False\ntry:\n    from _lib import audit_hmac as _audit_hmac\n\n    _HMAC_AVAILABLE = True\nexcept Exception:\n    _audit_hmac = None\n    _HMAC_AVAILABLE = False\ntry:\n    from _lib import spool_writer as _spool_writer\n\n    _SPOOL_WRITER_AVAILABLE = True\nexcept Exception:\n    _spool_writer = None\n    _SPOOL_WRITER_AVAILABLE = False\n\n_KNOWN_ACTIONS = {\n    \"action_required_held\",\n    \"action_required_rejected\",\n   