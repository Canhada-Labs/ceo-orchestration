   226	# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [END]
   227	# ---------------------------------------------------------------------------
   228	
   229	def decide(
   230	    *,
   231	    description: str,
   232	    prompt: str,
   233	    names_regex,
   234	    env: Optional[dict] = None,
   235	    subagent_type: str = "",
   236	) -> Decision:
   237	    """Pure decision function — no I/O, trivially unit-testable.
   238	
   239	    Args:
   240	        description: The Agent tool's `description` field.
   241	        prompt: The Agent tool's `prompt` field.
   242	        names_regex: A compiled regex matching team member names, or None
   243	            if no team files were found (degrades to header-only detection).
   244	        env: Environment-var dict (defaults to os.environ). Used to read
   245	            CEO_ARCHITECT_ACTIVE for the recursion guard (Sprint 5 ADR-010).
   246	        subagent_type: Agent tool ``subagent_type`` field (PLAN-078 Wave 1
   247	            telemetry). Used to identify archetype for model-routing
   248	            advisory emit; never affects the allow/block decision.
   249	
   250	    Returns:
   251	        Decision(allow=True) if the spawn is fine.
   252	        Decision(allow=False, reason=...) if governance requires blocking.
   253	    """
   254	    src_env = env if env is not None else os.environ
   255	
   256	    # PLAN-133 E3 — resolve session id once for the spawn-rails (depth/overlap).
   257	    _e3_session_id = _resolve_session_id_from_env(src_env)
   258	
   259	    # PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT
   260	    # payload (advisory telemetry; never blocks). Runs early so sentinel
   261	    # violations are logged before any governance decision. Fail-open.
   262	    _sanitize_spec_context_advisory(prompt or "", env=src_env)
   263	
   264	    # PLAN-133 A2 (Goose-harvest) — fail-CLOSED invisible-unicode guard.
   265	    # Default-OFF (CEO_UNICODE_HARDBLOCK=1 enforces); when enforced, a spawn
   266	    # prompt carrying control / bidi / zero-width / U+E0000-E007F Tag-block
   267	    # chars is BLOCKED here, BEFORE any LLM/debate/governance review. The
   268	    # breadcrumb (invisible_unicode_blocked) is emitted on both the advisory
   269	    # and enforced paths so the measure-first denominator is real. Fail-open.
   270	    _uni_block = _enforce_spec_context_unicode(prompt or "", env=src_env)
   271	    if _uni_block is not None:
   272	        return Decision(allow=False, reason=_uni_block)
   273	
   274	    # Session 75 Codex Finding 4 closure: scan spawn prompt for
   275	    # leaked secrets when Owner-opted-in via CEO_SPAWN_SECRET_SCAN=1.
   276	    # Default OFF; without the env var, _validate_spawn_prompt_has_no_secrets
   277	    # short-circuits to ok=True so legacy spawns are unaffected.
   278	    _scan_ok, _scan_code, _scan_detail = _validate_spawn_prompt_has_no_secrets(prompt)
   279	    if not _scan_ok:
   280	        return Decision(
   281	            allow=False,
   282	            reason=(
   283	                f"SPAWN-SECRET-BLOCKED: {_scan_code} ({_scan_detail}). "
   284	                "To bypass once: unset CEO_SPAWN_SECRET_SCAN."
   285	            ),
   286	        )
   287	
   288	    # PLAN-045 Wave 1 P0-03 — VETO floor runtime check.
   289	    # If the spawn targets a VETO-floor role (code-reviewer,
   290	    # security-engineer), verify the agent frontmatter still binds
   291	    # them to Opus. Closes F-01-03 demotion-via-frontmatter attack.
   292	    # Skipped when the validator lib is missing (defense-in-depth
   293	    # fail-open; arbitration kernel still blocks agents/*.md edits).
   294	    if _agent_frontmatter is not None:
   295	        agents_dir = Path(
   296	            src_env.get("CLAUDE_PROJECT_DIR") or os.getcwd()
   297	        ) / ".claude" / "agents"
   298	        haystack_lower = " ".join([
   299	            (description or "").lower(), (prompt or "").lower()
   300	        ])
   301	        for _role in sorted(_agent_frontmatter.VETO_FLOOR_ROLES):
   302	            if _role.lower() not in haystack_lower:
   303	                continue
   304	            ok, reason = _agent_frontmatter.check_veto_floor_for_role(
   305	                _role, agents_dir
   306	            )
   307	            if not ok and reason != "not_veto_role":
   308	                return Decision(
   309	                    allow=False,
   310	                    reason=(
   311	                        f"GOVERNANCE: veto_floor_demoted: role={_role} "
   312	                        f"reason={reason}. The VETO floor requires "
   313	                        "security-engineer and code-reviewer to bind to a "
   314	                        "member of VETO_FLOOR_ALLOWED (agent_frontmatter.py) "
   315	                        "- the enforcement is set membership, not one id. "
   316	                        "See ADR-052 + PLAN-045 Wave 1 P0-03; PLAN-169 W2.10 D2."
   317	                    ),
   318	                )
   319	
   320	    # PLAN-078 Wave 1 — model routing advisory telemetry (advisory-only).
   321	    # Runs AFTER VETO-floor enforcement so the hard-block path remains
   322	    # authoritative. Emits `model_routing_advised` event when a spawn
   323	    # archetype is identifiable. NEVER mutates tool_input. NEVER blocks.
   324	    # Bypass: `CEO_MODEL_ROUTING=0`.
   325	    _emit_model_routing_advisory(
   326	        description=description or "",
   327	        prompt=prompt or "",
   328	        subagent_type=subagent_type or "",
   329	        env=src_env,
   330	        project_dir=src_env.get("CLAUDE_PROJECT_DIR") or os.getcwd(),
   331	    )
   332	
   333	    # PLAN-112-FOLLOWUP-persona-routing-wire W1 — god-mode matrix consult.
   334	    # Runs AFTER the VETO-floor hard-block (above) so it never masks it.
   335	    # CONSULT + AUDIT ONLY — emits model_routing_enforced /
   336	    # model_routing_eval_error; NEVER blocks (block deferred, see W3 above).
   337	    # Mode is read off authoritative subagent_type only.
   338	    _consult_model_routing_mode(
   339	        description=description or "",
   340	        prompt=prompt or "",
   341	        subagent_type=subagent_type or "",
   342	        env=src_env,
   343	        project_dir=src_env.get("CLAUDE_PROJECT_DIR") or os.getcwd(),
   344	    )
   345	
   346	    # PLAN-091 Wave A.4 (W3.1) — MCP routing advisory.
   347	    # Maps archetype → mcp_routing task_class; resolver emits
   348	    # `mcp_route_advised` (PLAN-086 Wave D). Bypass: CEO_MCP_ROUTING_HOOK=0.
   349	    _emit_mcp_routing_advisory(
   350	        description=description or "",
   351	        prompt=prompt or "",
   352	        subagent_type=subagent_type or "",
   353	        env=src_env,
   354	    )
   355	
   356	    # PLAN-091 Wave A.5 (W3.3) — specialization promotion heuristic.
   357	    # When general-purpose spawn matches a specialist hint, emit
   358	    # `specialization_promoted` advisory. NEVER auto-spawns.
   359	    # Bypass: CEO_PROMOTION_HEURISTIC=0.
   360	    _emit_promotion_advisory(
   361	        description=description or "",
   362	        prompt=prompt or "",
   363	        subagent_type=subagent_type or "",
   364	        env=src_env,
   365	    )
   366	
   367	    # PLAN-092 Wave A.4 (W3.2 SEMI-11) — cookbook-advisor pattern hint.
   368	    # Matches spawn against 4 Anthropic Cookbook patterns (COOK-P1..P4);
   369	    # emits `cookbook_pattern_advised` advisory. Kill-switch:
   370	    # CEO_COOKBOOK_ADVISOR_ENABLED=0. NEVER mutates tool_input.
   371	    _emit_cookbook_pattern_advisory(
   372	        description=description or "",
   373	        prompt=prompt or "",
   374	        env=src_env,
   375	    )
   376	
   377	    # PLAN-098 Wave C.2 (ADR-132) — GOAP advisory-only invariant.
   378	    # PLAN-105 Wave A.6 — capture intent for deferred-emit at allow-return.
   379	    _goap_intent_plan_id: Optional[str] = None
   380	    _goap_intent_action_id: Optional[str] = None
   381	    if _GOAP_PLAN_ID_RE.search(prompt or ""):
   382	        owner_confirmed_env = (src_env.get("CEO_GOAP_CONFIRMED") or "").strip() == "1"
   383	        has_goap_confirm_block = bool(_GOAP_CONFIRM_HEADER_RE.search(prompt or ""))
   384	        if not (owner_confirmed_env and has_goap_confirm_block):
   385	            preview = (description or "")[:80]
   386	            missing: List[str] = []
   387	            if not owner_confirmed_env:
   388	                missing.append("CEO_GOAP_CONFIRMED=1 env")
   389	            if not has_goap_confirm_block:
   390	                missing.append("## GOAP CONFIRM block")
   391	            return Decision(
   392	                allow=False,
   393	                reason=(
   394	                    "GOVERNANCE: goap_advisory_without_owner_confirm: "
   395	                    f"spawn references a GOAP plan (description={preview!r}) "
   396	                    f"but lacks: {', '.join(missing)}. The GOAP planner is "
   397	                    "advisory-only - the Owner must physically confirm each "
   398	                    "action before spawn. See ADR-132 Decision Part 2."
   399	                ),
   400	            )
   401	        # PLAN-105 Wave A.6 — GOAP gates passed; record intent for deferred emit.
   402	        _pid_m = _GOAP_PLAN_ID_VALUE_RE.search(prompt or "")
   403	        _aid_m = _GOAP_ACTION_ID_VALUE_RE.search(prompt or "")
   404	        if _pid_m is not None:
   405	            _goap_intent_plan_id = _pid_m.group(1).strip()[:32]
   406	            if _aid_m is not None:
   407	                _goap_intent_action_id = _aid_m.group(1).strip()[:64]
   408	
   409	    # Recursion guard (ADR-010): block Architect-spawning-Architect.
   410	    architect_active = (src_env.get("CEO_ARCHITECT_ACTIVE") or "").strip()
   411	    if architect_active == "1":
   412	        haystack = " ".join([description or "", prompt or ""])
   413	        if _ARCHITECT_NAME_RE.search(haystack):
   414	            return Decision(
   415	                allow=False,
   416	                reason=(
   417	                    "ARCHITECT-RECURSION: a spawn naming 'Agent Architect' "
   418	                    "was detected while CEO_ARCHITECT_ACTIVE=1. The Agent "
   419	                    "Architect must not spawn another instance of itself "
   420	                    "within the same session. See ADR-010."
   421	                ),
   422	            )
   423	
   424	    # PLAN-020 Phase 3 — /effort scope clause (QA must-fix #7): /effort
   425	    # hints are CEO-only. Spawn prompts MUST NOT include them.
   426	    if _has_effort_token(prompt or ""):
   427	        return Decision(
   428	            allow=False,
   429	            reason=(
   430	                "GOVERNANCE: spawn prompt contains a `/effort` token. "
   431	                "Effort hints are CEO-only — sub-agents inherit Anthropic "
   432	                "default thinking budget. Strip /effort from the prompt "
   433	                "before retrying. See PLAN-020 §4 Phase 3 scope clause."
   434	            ),
   435	        )
   436	
   437	    desc_matched_name = False
   438	    if names_regex is not None and description:
   439	        if names_regex.search(description):
   440	            desc_matched_name = True
   441	
   442	    prompt_has_persona = False
   443	    if prompt and _PERSONA_HEADER_RE.search(prompt):
   444	        prompt_has_persona = True
   445	
   446	    is_named_spawn = desc_matched_name or prompt_has_persona
   447	
   448	    # PLAN-133 E3 — per-spawn tool scoping + depth/overlap rails. ADVISORY by
   449	    # default (emit-only, enforced=0); BLOCKS only under the per-rail env flag
   450	    # (CEO_SPAWN_TOOL_SCOPE / CEO_SPAWN_DEPTH_GUARD / CEO_SPAWN_OVERLAP_GUARD).
   451	    # Runs AFTER the VETO-floor + A2 unicode hard-blocks so those remain
   452	    # authoritative; runs BEFORE the SKILL CONTENT accept-path so an
   453	    # out-of-scope / depth-2 / clobbering spawn is rejected even when otherwise
   454	    # well-formed. Fail-open (returns None on any infra error).
   455	    _e3_hit = _enforce_spawn_rails(
   456	        prompt=prompt or "",
   457	        is_named_spawn=is_named_spawn,
   458	        env=src_env,
   459	        session_id=_e3_session_id,
   460	    )
   461	    if _e3_hit is not None:
   462	        _e3_code, _e3_detail = _e3_hit
   463	        return Decision(
   464	            allow=False,
   465	            reason=(
   466	                f"GOVERNANCE: {_e3_code}: {_e3_detail}. "
   467	                "The spawn violates a PLAN-133 E3 rail (per-spawn tool "
   468	                "allow-list / depth-over-one fence / FILE ASSIGNMENT overlap) "
   469	                "or the ADR-191 FILE ASSIGNMENT grammar (PLAN-178 C1). "
   470	                "Fix for a grammar block: regenerate the prompt via "
   471	                ".claude/scripts/inject-agent-context.sh (it always emits "
   472	                "the block). If the block is UNPARSEABLE, REPLACE or "
   473	                "remove the malformed block (the classifier aggregates "
   474	                "ALL blocks — appending a valid one cannot clear an "
   475	                "invalid token's taint); appending `## FILE ASSIGNMENT` "
   476	                "with `- CAN edit: <concrete paths>` or the explicit "
   477	                "read-only form `- CAN edit: NONE-READ-ONLY` works only "
   478	                "for the ABSENT state. Recovery route: "
   479	                "CEO_SOTA_DISABLE=1 forces advisory. See PLAN-133 §E E3 + "
   480	                "ADR-191."
   481	            ),
   482	        )
   483	
   484	    # PLAN-113 WIRE-DEADMOD — confidence_labels advisory (PLAN-083 Wave 1.10).
   485	    # Emits spawn_confidence_advisory so recommender / receipt formatter have
   486	    # a hook-level signal. Advisory only — never blocks. Fail-open.
   487	    _action_type = "canonical_edit" if is_named_spawn else "bash_execute"
   488	    _emit_spawn_confidence_advisory(
   489	        action_type=_action_type,
   490	        is_named_spawn=is_named_spawn,
   491	        env=src_env,
   492	    )
   493	
   494	    if not is_named_spawn:
   495	        # Generic research / simple tasks — no governance requirement.
   496	        _emit_goap_deferred_outcome(
   497	            _goap_intent_plan_id, _goap_intent_action_id, src_env
   498	        )
   499	        return Decision(allow=True)
   500	
   501	    # PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.
   502	    # NAMED spawns only (scoped here, after the generic early-return, so
   503	    # unmatched/generic spawns see zero behavior change). Runs BEFORE the
   504	    # SKILL REFERENCE / SKILL CONTENT accept-paths so an untrusted-content
   505	    # spawn missing the block is rejected even when otherwise well-formed.
   506	    # Input fail-CLOSED (matched + missing block => BLOCK); infra fail-OPEN
   507	    # inside _enforce_prompt_defense. Kill-switches documented at the gate.
   508	    _pd_hit = _enforce_prompt_defense(
   509	        description=description or "",
   510	        prompt=prompt or "",
   511	        env=src_env,
   512	    )
   513	    if _pd_hit is not None:
   514	        _pd_code, _pd_detail = _pd_hit
   515	        return Decision(
   516	            allow=False,
   517	            reason=(
   518	                f"GOVERNANCE: {_pd_code}: {_pd_detail}. This NAMED spawn's "
   519	                "task indicates contact with untrusted content (WebFetch/"
   520	                "WebSearch/scrape/imported/upstream/third-party), but the "
   521	                "prompt has no `## PROMPT DEFENSE` section with >= 6 bullet "
   522	                "lines. Fix: regenerate the prompt via "
   523	                ".claude/scripts/inject-agent-context.sh (it emits the block "
   524	                "unconditionally), or append the 6-bullet anti-injection "
   525	                "block verbatim. See PLAN-153 Wave E item 7 / ADR-175."
   526	            ),
   527	        )
   528	
   529	    # PLAN-020 Phase 2 — Reference path (ADR-051). If `## SKILL REFERENCE`
   530	    # marker is present, validate strictly (fail-CLOSED). Reference path
   531	    # opt-in via env var; default ON per Q1 Owner answer.
   532	    if _is_enabled("CEO_SKILL_REFERENCE_MODE", ENABLE_SKILL_REFERENCE_MODE, src_env):
   533	        if _SKILL_REFERENCE_HEADER_RE.search(prompt or ""):
   534	            ok, reason_code, detail = _validate_skill_reference(prompt or "")
   535	            if ok:
   536	                _emit_goap_deferred_outcome(
   537	                    _goap_intent_plan_id, _goap_intent_action_id, src_env
   538	                )
   539	                # PLAN-106 Wave C — persona coverage emit at allow path.
   540	                _emit_persona_coverage_synthesized(
   541	                    subagent_type=subagent_type,
   542	                    description=description,
   543	                    prompt=prompt,
   544	                    source="dispatch",
   545	                    env=src_env,
   546	                )
   547	                return Decision(allow=True)
   548	            preview = (description or "")[:80]
   549	            return Decision(
   550	                allow=False,
   551	                reason=(
   552	                    f"GOVERNANCE: {reason_code}: {detail}. "
   553	                    f"Spawn rejected (description={preview!r}). "
   554	                    "See ADR-051 §Synchronous validation for sub-check details."
   555	                ),
   556	            )
   557	
   558	    # Named spawn: require real SKILL CONTENT section (P1-SEC-B: bypass-resistant).
   559	    if _has_skill_content(prompt or ""):
   560	        _emit_goap_deferred_outcome(
   561	            _goap_intent_plan_id, _goap_intent_action_id, src_env
   562	        )
   563	        # PLAN-106 Wave C — persona coverage emit at allow path.
   564	        _emit_persona_coverage_synthesized(
   565	            subagent_type=subagent_type,
   566	            description=description,
   567	            prompt=prompt,
   568	            source="dispatch",
   569	            env=src_env,
   570	        )
   571	        return Decision(allow=True)
   572	
   573	    # Build a helpful block reason pointing at the injector script.
   574	    preview = (description or "")[:80]
   575	    reason = (
   576	        "GOVERNANCE: Agent spawn detected as NAMED "
   577	        f"(description='{preview}'), but prompt has no {_SKILL_CONTENT_MARKER} "
   578	        "section. Read the agent's skill file and include its full content "
   579	        "in the prompt before spawning. Use "
   580	        ".claude/scripts/inject-agent-context.sh <AgentName> <task> to "
   581	        "generate a compliant prompt."
   582	    )
   583	    return Decision(allow=False, reason=reason)
