     1	"""Domain implementations for the public ``_lib.audit_emit`` facade.
     2	
     3	The facade historically owns mutable state and every helper lookup. Ordinary
     4	function re-exports would silently bypass monkeypatches on that facade. Bind
     5	the original code objects to its namespace instead: signatures, source files,
     6	tracebacks and inspect.isfunction remain intact, with no proxy per event.
     7	
     8	Imported parts are private declaration templates. Each facade import/reload
     9	gets fresh mutable values and fresh functions; never mutate the templates.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	from copy import deepcopy
    15	from importlib import import_module
    16	from types import FunctionType
    17	from typing import Any, Dict, Tuple
    18	
    19	
    20	def install(namespace: Dict[str, Any], modules: Tuple[str, ...],
    21	            package: str = __name__) -> None:
    22	    """Publish declarations with the facade as their sole runtime namespace.
    23	
    24	    ``package`` permits other facades to share the same binding contract.
    25	    """
    26	    declarations = {}
    27	    for name in modules:
    28	        module = import_module(f"{package}.{name}")
    29	        declarations.update({key: getattr(module, key) for key in module.__all__})
    30	        namespace.setdefault("__annotations__", {}).update(
    31	            getattr(module, "__annotations__", {})
    32	        )
    33	    # One memo preserves aliases between mutable declarations, and a reload
    34	    # cannot inherit rate-limit counters or registry edits from a prior import.
    35	    namespace.update(deepcopy(declarations))
    36	    for name, original in declarations.items():
    37	        if not isinstance(original, FunctionType):
    38	            continue
    39	        bound = FunctionType(
    40	            original.__code__, namespace, original.__name__,
    41	            original.__defaults__, original.__closure__,
    42	        )
    43	        bound.__kwdefaults__ = deepcopy(original.__kwdefaults__)
    44	        bound.__annotations__ = dict(original.__annotations__)
    45	        bound.__dict__.update(original.__dict__)
    46	        bound.__qualname__ = original.__qualname__
    47	        bound.__module__ = namespace["__name__"]
    48	        namespace[name] = bound

