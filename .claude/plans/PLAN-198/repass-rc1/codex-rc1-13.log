   158	def _emit_cookbook_pattern_advisory(
   159	    *,
   160	    description: str,
   161	    prompt: str,
   162	    env=None,
   163	) -> None:
   164	    """PLAN-092 Wave A.4 (W3.2 SEMI-11) — emit cookbook_pattern_advised
   165	    when a spawn prompt matches one of 4 Anthropic Cookbook pattern
   166	    trigger taxonomies (COOK-P1..P4).
   167	
   168	    Advisory ONLY — UX hint. NEVER blocks, NEVER mutates tool_input.
   169	    Rate-cap via PLAN-088 global _plan088_rate_admit in audit_emit.
   170	    Kill-switch: CEO_COOKBOOK_ADVISOR_ENABLED=0. Privacy invariant:
   171	    3 fields max (no raw prompt persisted — AC3b).
   172	
   173	    Audit-emit signature mapping (PLAN-090 W3.2 canonical contract):
   174	      pattern_id (COOK-P*)   -> top_pattern_keys
   175	      trigger_class (string) -> task_signature (enum-constrained "other")
   176	      bucket (high/med/low)  -> pattern_count (3/2/1)
   177	
   178	    NEVER raises.
   179	    """
   180	    try:
   181	        src_env = env if env is not None else os.environ
   182	        if not _COOKBOOK_PATTERNS_AVAILABLE:
   183	            return
   184	        if not _AUDIT_EMIT_AVAILABLE:
   185	            return
   186	        # Kill-switch
   187	        try:
   188	            if hasattr(_cookbook_patterns, "kill_switch_enabled"):
   189	                if not _cookbook_patterns.kill_switch_enabled():
   190	                    return
   191	            else:
   192	                val = (src_env.get("CEO_COOKBOOK_ADVISOR_ENABLED") or "1").strip()
   193	                if val in ("0", "false", "False", "no", "off"):
   194	                    return
   195	        except Exception:  # pragma: no cover
   196	            return
   197	        # Concat description + prompt, cap at 8KiB
   198	        text = ((description or "") + "\n" + (prompt or ""))[: 8 * 1024]
   199	        if not text.strip():
   200	            return
   201	        # Match (first-hit canonical order COOK-P1 -> P4)
   202	        try:
   203	            result = _cookbook_patterns.match_pattern(text)
   204	        except Exception:  # pragma: no cover
   205	            return
   206	        if result is None:
   207	            return
   208	        pattern_id, trigger_class, bucket = result
   209	        if not hasattr(_audit_emit, "emit_cookbook_pattern_advised"):
   210	            return
   211	        # Map semantic -> canonical signature
   212	        bucket_to_count = {"high": 3, "medium": 2, "low": 1}
   213	        try:
   214	            _audit_emit.emit_cookbook_pattern_advised(
   215	                task_signature="other",
   216	                top_pattern_keys=str(pattern_id)[:128],
   217	                pattern_count=bucket_to_count.get(str(bucket), 1),
   218	            )
   219	        except Exception:  # pragma: no cover
   220	            return
   221	    except Exception:  # pragma: no cover - fail-open invariant
   222	        return
   223	
