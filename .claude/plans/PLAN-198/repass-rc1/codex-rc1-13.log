   128	        from _lib._audit_emit_parts import install
   129	        install(globals(), (name,), package="_lib.agent_spawn")
   130	    except Exception as exc:
   131	        if __name__ != "__main__":
   132	            raise
   133	        print(f"[check_agent_spawn] FATAL: {type(exc).__name__}: {exc}", file=sys.stderr)
   134	        print(json.dumps({}))
   135	        sys.exit(0)
