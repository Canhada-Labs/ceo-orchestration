   588	def _classify_block_reason(reason: str) -> str:
   589	    """Map a Decision.reason string to a stable audit reason_code.
   590	
   591	    Defaults to ``unknown_block`` when no marker matches — visibility
   592	    on a marker drift is preferable to silent misclassification.
   593	    """
   594	    if not reason:
   595	        return "unknown_block"
   596	    for needle, code in _BLOCK_REASON_MARKERS:
   597	        if needle in reason:
   598	            if code == "__REFERENCE_PREFIX__":
   599	                # Embedded reason_code form: "GOVERNANCE: <code>: <detail>".
   600	                # Skill-reference path emits codes like reference_hash_mismatch,
   601	                # reference_unsafe_path, etc. (constants at
   602	                # check_agent_spawn.py:188 REASON_REFERENCE_*).
   603	                head = reason[len("GOVERNANCE: "):]
   604	                colon = head.find(":")
   605	                return head[:colon] if colon > 0 else "reference_invalid"
   606	            return code
   607	    return "unknown_block"
