   141	@dataclass
   142	class Decision:
   143	    """Typed result of the governance check."""
   144	
   145	    allow: bool
   146	    reason: Optional[str] = None
   147	
   148	    def to_json(self) -> str:
   149	        if self.allow:
   150	            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow
   151	        return json.dumps(
   152	            {"decision": "block", "reason": self.reason or ""},
   153	            ensure_ascii=False,
   154	        )
