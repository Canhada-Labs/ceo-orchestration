-    try:
-        if not _AUDIT_EMIT_AVAILABLE:
-            return
-        _audit_emit.emit_generic(
-            "spawn_prompt_defense_gate",
-            keyword=(keyword or "")[:32],
-            present=1 if present else 0,
-            enforced=1 if enforced else 0,
