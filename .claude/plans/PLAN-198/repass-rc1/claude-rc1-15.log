{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RpykE3m3SPuuA4kDz5adxb","type":"tool_result","content":"559\t        )\n560\t\n561\t    def test_action_classified_as_scrub_branch_not_passthrough(self):\n562\t        branched = self._branched_actions()\n563\t        self.assertIn(\"tool_call_lifecycle_recorded\", branched)\n564\t        self.assertNotIn(\n565\t            \"tool_call_lifecycle_recorded\",\n566\t            audit_emit._EMIT_GENERIC_PASSTHROUGH,\n567\t        )\n568\t        self.assertNotIn(\n569\t            \"tool_call_lifecycle_recorded\",\n570\t            set(audit_emit._RESERVED_ACTIONS),\n571\t        )\n572\t\n573\t    def test_typed_emitter_exists(self):\n574\t        self.assertTrue(\n575\t            hasattr(audit_emit, \"emit_tool_call_lifecycle_recorded\")\n576\t        )\n577\t\n578\t\n579\t# ---------------------------------------------------------------------------\n580\t# 9. Enum mappers (unit)\n581\t# ---------------------------------------------------------------------------\n582\t\n583\t\n584\tclass TestEnumMappers(unittest.TestCase):\n585\t    def test_tool_name_enum_mapping(self):\n586\t        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Bash\"), \"Bash\")\n587\t        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Agent\"), \"Agent\")\n588\t        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Task\"), \"Task\")\n589\t        self.assertEqual(\n590\t            tool_lifecycle.to_tool_name_enum(\"mcp__codex__codex\"), \"mcp_other\"\n591\t        )\n592\t        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Whatever\"), \"other\")\n593\t        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"\"), \"other\")\n594\t        self.assertEqual(tool_lifecycle.to_tool_name_enum(None), \"other\")\n595\t        # The two synthetic buckets are IDEMPOTENT (pass through unchanged) so\n596\t        # the enum stored in the per-session record file re-maps cleanly in\n597\t        # record_post (Codex pair-rail P2). A raw mcp__* string still collapses\n598\t        # to mcp_other above, so no raw tool name ever reaches the wire."}]},"parent_tool_use_id":null,"session_id":"b47e4f41-b6d4-40ce-b1ea-9cdfea4ae85e","uuid":"b3f57316-ad61-4b62-a22e-b36254fc7b40","timestamp":"2026-11-15T10:20:43.405Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/tests/test_tool_lifecycle.py","content":"        )\n\n    def test_action_classified_as_scrub_branch_not_passthrough(self):\n        branched = self._branched_actions()\n        self.assertIn(\"tool_call_lifecycle_recorded\", branched)\n        self.assertNotIn(\n            \"tool_call_lifecycle_recorded\",\n            audit_emit._EMIT_GENERIC_PASSTHROUGH,\n        )\n        self.assertNotIn(\n            \"tool_call_lifecycle_recorded\",\n            set(audit_emit._RESERVED_ACTIONS),\n        )\n\n    def test_typed_emitter_exists(self):\n        self.assertTrue(\n            hasattr(audit_emit, \"emit_tool_call_lifecycle_recorded\")\n        )\n\n\n# ---------------------------------------------------------------------------\n# 9. Enum mappers (unit)\n# ---------------------------------------------------------------------------\n\n\nclass TestEnumMappers(unittest.TestCase):\n    def test_tool_name_enum_mapping(self):\n        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Bash\"), \"Bash\")\n        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Agent\"), \"Agent\")\n        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Task\"), \"Task\")\n        self.assertEqual(\n            tool_lifecycle.to_tool_name_enum(\"mcp__codex__codex\"), \"mcp_other\"\n        )\n        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"Whatever\"), \"other\")\n        self.assertEqual(tool_lifecycle.to_tool_name_enum(\"\"), \"other\")\n        self.assertEqual(tool_lifecycle.to_tool_name_enum(None), \"other\")\n        # The two synthetic buckets are IDEMPOTENT (pass through unchanged) so\n        # the enum stored in the per-session record file re-maps cleanly in\n        # record_post (Codex pair-rail P2). A raw mcp__* string still collapses\n        # to mcp_other above, so no raw tool name ever reaches the wire.","numLines":40,"startLine":559,"totalLines":624}},"tool_result_meta":[{"id":"toolu_01RpykE3m3SPuuA4kDz5adxb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
