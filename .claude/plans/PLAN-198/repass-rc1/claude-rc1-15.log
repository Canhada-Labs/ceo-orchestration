{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H2K5Hp6GgmVQmifwbZX2Qu","type":"tool_result","content":"1\t\"\"\"Context pressure.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\tfrom .compaction import _CONTEXT_PRESSURE_MARKER_GC_MAX\n8\tfrom .compaction import _CONTEXT_PRESSURE_MARKER_TTL_S\n9\t\n10\t__all__ = ('_context_pressure_marker_name', '_context_pressure_bucket_ok', '_GC_SHARDS', '_GC_SHARD_COUNTER_NAME', '_gc_shard_of_name', '_gc_next_shard', '_gc_context_pressure_markers', 'should_emit_context_pressure', 'clear_context_pressure_marker', '_BASH_INPUT_REWRITTEN_ALLOWLIST', '_BASH_REWRITE_CLASSES')\n11\t\n12\tdef _context_pressure_marker_name(session_id: Any) -> str:\n13\t    \"\"\"Marker basename for ``session_id`` (PLAN-179 rail finding A).\n14\t\n15\t    Returns the bare project-wide basename when ``session_id`` is absent /\n16\t    blank / not a string — the documented degraded mode, in which two\n17\t    concurrent sessions in one repo can interfere with each other's\n18\t    hysteresis. Otherwise returns ``<basename>.<sanitized-id>``.\n19\t\n20\t    Never raises: this runs inside a fail-open bookkeeping helper.\n21\t    \"\"\"\n22\t    if not isinstance(session_id, str):\n23\t        return _CONTEXT_PRESSURE_STATE_BASENAME\n24\t    raw = session_id.strip()\n25\t    if not raw:\n26\t        return _CONTEXT_PRESSURE_STATE_BASENAME\n27\t    if (len(raw) <= _CONTEXT_PRESSURE_SID_MAX_LEN\n28\t            and all(ch in _CONTEXT_PRESSURE_SID_SAFE_CHARS for ch in raw)):\n29\t        suffix = raw\n30\t    else:\n31\t        # Local import: this module keeps hashlib out of its top-level import\n32\t        # surface and imports it at the point of use (see _short_hash et al).\n33\t        import hashlib\n34\t        suffix = hashlib.sha256(\n35\t            raw.encode(\"utf-8\", errors=\"replace\")\n36\t        ).hexdigest()[:32]\n37\t    return _CONTEXT_PRESSURE_STATE_BASENAME + \".\" + suffix\n38\t\n39\t\n40\tdef _context_pressure_bucket_ok(value: Any) -> bool:\n41\t    \"\"\"Strict INTEGER percent-bucket check for context_pressure_observed.\n42\t\n43\t    Type-strict on purpose. ``40.0 in {40}`` is True in Python (equal\n44\t    numbers hash alike), so a plain membership test would wave a FLOAT onto\n45\t    the wire — and a float under the HMAC chain DISCARDS THE WHOLE EVENT\n46\t    (S181 / ADR-055-AMEND-2), not just the offending field. ``bool`` is\n47\t    rejected explicitly because it is an ``int`` subclass and ``True`` would\n48\t    otherwise sail through any numeric check.\n49\t    \"\"\"\n50\t    if isinstance(value, bool) or not isinstance(value, int):\n51\t        return False\n52\t    return value in _CONTEXT_PRESSURE_USED_BUCKETS_PCT\n53\t\n54\t\n55\t# PLAN-179 rail round-5 [P2] — rotating identity shards, best-effort sweep.\n56\t# A shard selects eligible names; it does not preserve directory position.\n57\t# Each sweep starts a fresh scandir and can hit its deadline before the\n58\t# same tail, so expired markers there have no guaranteed reclamation.\n59\t_GC_SHARDS = 8\n60\t\n61\t\n62\t# Contador de VARREDURA (rail round-6 [P2]): o shard avanca por SWEEP, nunca\n63\t# pelo relogio — varreduras no mesmo minuto modulo K starvariam as outras.\n64\t_GC_SHARD_COUNTER_NAME = \".gc-shard-cursor\"\n65\t\n66\t\n67\tdef _gc_shard_of_name(name):\n68\t    \"\"\"Shard estavel derivado do NOME (nunca da ordem de leitura).\"\"\"\n69\t    try:\n70\t        return zlib.crc32(name.encode(\"utf-8\", \"replace\")) % _GC_SHARDS\n71\t    except Exception:\n72\t        return 0\n73\t\n74\t\n75\tdef _gc_next_shard(state_dir):\n76\t    \"\"\"Select the next shard from a best-effort persisted counter.\n77\t\n78\t    A successful read/write advances the counter. A failed read seeds it\n79\t    from randomness (zero if randomness also fails); a failed write can\n80\t    leave the same counter for the next sweep. This selects eligible names,\n81\t    without guaranteeing that the deadline-bounded scan reaches each name.\n82\t    The counter read and ancestor paths retain the rc.1 condition 28 limits;\n83\t    O_NOFOLLOW here protects only the temporary file used for the write.\n84\t    \"\"\"\n85\t    counter_path = Path(str(state_dir)) / _GC_SHARD_COUNTER_NAME\n86\t    current = None\n87\t    try:\n88\t        raw = counter_path.read_text(encoding=\"utf-8\").strip()\n89\t        current = int(raw)\n90\t    except Exception:\n91\t        current = None\n92\t    if current is None:\n93\t        try:\n94\t            current = int.from_bytes(os.urandom(2), \"big\")\n95\t        except Exception:\n96\t            current = 0\n97\t    nxt = (current + 1) % (_GC_SHARDS * 1024)  # espaco folgado, sem overflow\n98\t    try:\n99\t        counter_path.parent.mkdir(parents=True, exist_ok=True)\n100\t        tmp = counter_path.parent / (\n101\t            \".\" + counter_path.name + \".\" + str(os.getpid()) + \".\"\n102\t            + os.urandom(4).hex() + \".tmp\"\n103\t        )\n104\t        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, \"O_NOFOLLOW\", 0)\n105\t        fd = os.open(str(tmp), flags, 0o600)\n106\t        try:\n107\t            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n108\t                fh.write(str(nxt))\n109\t        except Exception:\n110\t            try:\n111\t                os.unlink(str(tmp))\n112\t            except OSError:\n113\t                pass\n114\t            raise\n115\t        os.replace(str(tmp), str(counter_path))\n116\t    except Exception:\n117\t        pass  # housekeeping: nao persistir custa cobertura, nunca correcao\n118\t    return nxt % _GC_SHARDS\n119\t\n120\t\n121\tdef _gc_context_pressure_markers(\n122\t    state_dir: Any,\n123\t    ttl_seconds: int = _CONTEXT_PRESSURE_MARKER_TTL_S,\n124\t    max_files: int = _CONTEXT_PRESSURE_MARKER_GC_MAX,\n125\t) -> int:\n126\t    \"\"\"Unlink aged-out per-session markers. Bounded, fail-open (finding A).\n127\t\n128\t    Per-session keying trades one shared file for one file per session, so\n129\t    it must come with its own reclaim or it re-opens the unbounded-growth\n130\t    class the rail rejected in the session STORES (finding C). Markers are\n131\t    ~4 bytes and are only created on a rung TRANSITION with the progress\n132\t    floor armed, so the rate is low — this sweep exists so \"low\" never\n133\t    becomes \"forever\".\n134\t\n135\t    Only names carrying the marker prefix AND a suffix are considered; the\n136\t    project-wide marker itself is never collected (it has no suffix), and an\n137\t    unrelated file in ``.claude/state/`` is left alone. Returns the number\n138\t    of files unlinked; every OSError is swallowed (housekeeping).\n139\t    \"\"\"\n140\t    removed = 0\n141\t    prefix = _CONTEXT_PRESSURE_STATE_BASENAME + \".\"\n142\t    try:\n143\t        cutoff = time.time() - float(ttl_seconds)\n144\t        directory = Path(str(state_dir))\n145\t        # PLAN-179 rail rounds 2/3/4 [P2] — same story as the twin sweep in\n146\t        # `scratchpad_lib.gc_orphan_session_stores`, and the same conclusion.\n147\t        # r2 removed the sort+materialise; r3 replaced it with a fixed prefix\n148\t        # window that STARVED the tail; r4 showed the rotating offset was still\n149\t        # `% _scan_cap`, so nothing past ~2x that was ever reachable.\n150\t        # Scan lazily without sorting, stopping at `max_files` deletions\n151\t        # or the wall-clock deadline. The deadline can repeatedly leave\n152\t        # the same tail unvisited: shard rotation alone does not guarantee\n153\t        # coverage. A continuation mechanism remains an rc.1 P2 follow-up.\n154\t        _deadline = time.time() + _GC_MARKER_WALL_BUDGET_S\n155\t        _shard = _gc_next_shard(directory)\n156\t        _scanned = 0\n157\t        _it = os.scandir(str(directory))\n158\t        try:\n159\t            for _de in _it:\n160\t                _scanned += 1\n161\t                if removed >= int(max_files):\n162\t                    break\n163\t                if (_scanned & 63) == 0 and time.time() >= _deadline:\n164\t                    break\n165\t                entry = Path(_de.path)\n166\t                name = entry.name\n167\t                if _gc_shard_of_name(name) != _shard:\n168\t                    continue\n169\t                # Both the live marker `<prefix><sid>` and a crash-orphaned\n170\t                # atomic-write temp `.<prefix><sid>.<pid>.<rand>.tmp`.\n171\t                if name.startswith(\".\"):\n172\t                    name = name[1:]\n173\t                if not name.startswith(prefix) or len(name) <= len(prefix):\n174\t                    continue\n175\t                try:\n176\t                    if entry.stat().st_mtime >= cutoff:\n177\t                        continue\n178\t                    entry.unlink()\n179\t                    removed += 1\n180\t                except OSError:\n181\t                    # Per-entry fail-open: a racing unlink must not abort it.\n182\t                    continue\n183\t        finally:\n184\t            try:\n185\t                _it.close()\n186\t            except Exception:\n187\t                pass\n188\t    except (OSError, TypeError, ValueError):\n189\t        return removed\n190\t    return removed\n191\t\n192\t\n193\t# QDSAA-FUNCAO-LONGA: Preserve the existing marker expiry, sharded GC, and edge-trigger sequence during relocation.\n194\tdef should_emit_context_pressure(\n195\t    used_bucket: Any, state_dir: Any, session_id: Any = None\n196\t) -> bool:\n197\t    \"\"\"Return True only on a bucket TRANSITION (PLAN-179 W0 US2 / 8.1).\n198\t\n199\t    ``state_dir`` is the directory holding the marker — callers pass\n200\t    ``<project>/.claude/state``. The marker records the last percent bucket\n201\t    observed; a repeat of the same bucket returns False, a transition in\n202\t    EITHER direction returns True and re-arms the marker. This is\n203\t    hysteresis, not sampling: without it the rail emits one row per prompt\n204\t    while the session sits in a single rung, which is exactly the flood the\n205\t    HMAC chain must not carry.\n206\t\n207\t    ``session_id`` (PLAN-179 rail finding A, round-1 REJECT) KEYS that\n208\t    marker. It must be the TRUSTED id — the one the harness put in the hook\n209\t    input (``scratchpad_lib.session_id_from_event``), never\n210\t    ``CLAUDE_SESSION_ID`` from the environment, which any agent with a\n211\t    subshell can set (consensus M2). Passing None is legal and means the\n212\t    DEGRADED project-wide marker: hysteresis then behaves as it did before\n213\t    this fix, i.e. two concurrent sessions in the same repo suppress and\n214\t    re-arm each other and the wire rows cannot be attributed. Callers that\n215\t    have a trusted id must pass it; callers that do not should say so on the\n216\t    wire by omitting ``session_id`` from the event rather than inventing one.\n217\t\n218\t    FAIL-OPEN on infrastructure (house rule): any state I/O error — absent\n219\t    directory, unwritable path, corrupt or truncated marker — means\n220\t    \"emit\", and the caller is never allowed to see an exception. The caller\n221\t    is a hook; a bookkeeping file may not block or crash a user session.\n222\t    Fail-open costs at most a duplicate breadcrumb, whereas fail-closed\n223\t    would silently lose the very signal PLAN-179 exists to measure.\n224\t    \"\"\"\n225\t    if not _context_pressure_bucket_ok(used_bucket):\n226\t        # Off-enum input must never re-arm the marker (that would let a\n227\t        # bogus value suppress the NEXT real transition). The dispatch\n228\t        # branch coerces the field itself, so there is nothing to debounce.\n229\t        return True\n230\t    try:\n231\t        marker = Path(str(state_dir)) / _context_pressure_marker_name(session_id)\n232\t    except (TypeError, ValueError):  # pragma: no cover - defensive\n233\t        return True\n234\t    current = str(int(used_bucket))\n235\t    previous = None  # type: Optional[str]\n236\t    try:\n237\t        previous = marker.read_text(encoding=\"utf-8\").strip()\n238\t    except (OSError, ValueError, UnicodeDecodeError):\n239\t        previous = None\n240\t    if previous == current:\n241\t        return False\n242\t    # Re-arm atomically (tmp + os.replace, 0600) — same idiom as\n243\t    # check_directory_added._atomic_write, kept inline so audit_emit gains\n244\t    # no new import.\n245\t    try:\n246\t        marker.parent.mkdir(parents=True, exist_ok=True)\n247\t        # PLAN-179 rail finding A: the tmp name is derived from the SAME\n248\t        # per-session marker name. Reusing the bare basename here would give\n249\t        # two sessions re-arming at the same moment one shared tmp path.\n250\t        # PLAN-179 rail round-3 [P1] — SYMLINK-SAFE, and the name is not\n251\t        # guessable. `.claude/state/` is gitignored and world-writable to\n252\t        # anything running as this user, so a PREDICTABLE tmp path could be\n253\t        # pre-created as a symlink; a plain `open(..., \"w\")` follows it and the\n254\t        # hook then truncates whatever it points at — an arbitrary-write\n255\t        # primitive that routes around every canonical-edit guard, reached\n256\t        # through an advisory audit helper. Three things close it together:\n257\t        # O_EXCL (refuses an existing path), O_NOFOLLOW (refuses a symlink even\n258\t        # if it appears between the check and the open), and a random suffix so\n259\t        # pre-creation is not feasible in the first place. The mode is set AT\n260\t        # CREATION, which also removes the window the old separate `chmod` left.\n261\t        _rand = os.urandom(6).hex()\n262\t        tmp = marker.parent / (\n263\t            \".\" + marker.name + \".\" + str(os.getpid()) + \".\" + _rand + \".tmp\"\n264\t        )\n265\t        _flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY\n266\t        _flags |= getattr(os, \"O_NOFOLLOW\", 0)  # POSIX; 0 is a safe no-op\n267\t        _fd = os.open(str(tmp), _flags, 0o600)\n268\t        try:\n269\t            with os.fdopen(_fd, \"w\", encoding=\"utf-8\") as fh:\n270\t                fh.write(current + \"\\n\")\n271\t        except Exception:\n272\t            # Never leave the temp behind on a failed write — the GC below\n273\t            # only sweeps by AGE, so an orphan would linger for a full TTL.\n274\t            try:\n275\t                os.unlink(str(tmp))\n276\t            except OSError:\n277\t                pass\n278\t            raise\n279\t        os.replace(str(tmp), str(marker))\n280\t    except (OSError, ValueError):\n281\t        _breadcrumb(\n282\t            \"should_emit_context_pressure: marker re-arm failed — \"\n283\t            \"fail-open (the same bucket may emit twice)\"\n284\t        )\n285\t    # PLAN-179 rail finding A: reclaim runs ONLY on the re-arm path, i.e. on a\n286\t    # rung TRANSITION, which is rare by construction (that is the whole point\n287\t    # of the hysteresis above). It is bounded and fail-open by its own\n288\t    # contract, and its result cannot change what this function returns.\n289\t    _gc_context_pressure_markers(marker.parent)\n290\t    return True\n291\t\n292\t\n293\tdef clear_context_pressure_marker(state_dir: Any, session_id: Any = None) -> None:\n294\t    \"\"\"Re-arma a histerese de pressão após uma compactação (rail round-10 [P1]).\n295\t\n296\t    O produtor é PreCompact-only: nada observa a QUEDA de contexto pós-\n297\t    compactação, então uma sessão que compacta duas vezes no mesmo degrau\n298\t    mantém previous==current e a segunda travessia genuína é suprimida.\n299\t    O PostCompact chama isto para fechar a GERAÇÃO de compactação:\n300\t    remover o marker re-arma o debounce para o próximo ciclo.\n301\t\n302\t    FAIL-OPEN (regra da casa): qualquer erro de I/O é engolido — um unlink\n303\t    de bookkeeping nunca pode quebrar um hook. Marker ausente é o caso\n304\t    normal (sessão que nunca cruzou um degrau).\"\"\"\n305\t    try:\n306\t        marker = Path(str(state_dir)) / _context_pressure_marker_name(session_id)\n307\t        marker.unlink()\n308\t    except (OSError, TypeError, ValueError):\n309\t        pass\n310\t\n311\t\n312\t# PLAN-135 W2 H5 (ADR-154) — Sec field allowlist for the bash-input-rewrite\n313\t# breadcrumb (bash_input_rewritten, producer .claude/hooks/check_bash_safety.py).\n314\t# Deny-by-default. Same no-value-echo contract as settings_tamper_detected\n315\t# ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]): the\n316\t# command STRING (before OR after the rewrite), the remote URL / refspec and\n317\t# any inline credential are NEVER allowed fields — only the closed-enum\n318\t# rewrite_class + the two 64-hex sha256 hashes travel on the wire. The hash\n319\t# pair lets an auditor prove audited-cmd == executed-cmd without seeing either.\n320\t_BASH_INPUT_REWRITTEN_ALLOWLIST = frozenset({\n321\t    \"action\", \"session_id\", \"project\",\n322\t    \"rewrite_class\", \"before_sha256\", \"after_sha256\",\n323\t    # _write_event envelope (pre-allowed so scrub doesn't strip on round-trip):\n324\t    \"ts\", \"event_schema\",\n325\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n326\t    \"hmac\", \"hmac_error\",\n327\t})\n328\t\n329\t\n330\t# PLAN-135 W2 H5 — closed enum for the rewrite class. The pilot ships EXACTLY\n331\t# one rewrite pattern; widening requires a new ADR + Codex (Doctrine 1\n332\t# corollary + ADR-154 §1 single-rewriter invariant). Anything outside the set\n333\t# (incl. a missing field) is COERCED to \"other\" (S172 doctrine — the rejected\n334\t# value is never echoed).\n335\t_BASH_REWRITE_CLASSES = frozenset({\n336\t    \"git_push_force_to_lease\",\n337\t    \"other\",\n338\t})\n339\t"}]},"parent_tool_use_id":null,"session_id":"e5b55c72-4db7-4559-92ff-5b12e402f7bf","uuid":"82c8cd59-e447-4448-86c8-1d5fec921bb2","timestamp":"2026-11-13T17:24:59.520Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/context_pressure.py","content":"\"\"\"Context pressure.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\nfrom .compaction import _CONTEXT_PRESSURE_MARKER_GC_MAX\nfrom .compaction import _CONTEXT_PRESSURE_MARKER_TTL_S\n\n__all__ = ('_context_pressure_marker_name', '_context_pressure_bucket_ok', '_GC_SHARDS', '_GC_SHARD_COUNTER_NAME', '_gc_shard_of_name', '_gc_next_shard', '_gc_context_pressure_markers', 'should_emit_context_pressure', 'clear_context_pressure_marker', '_BASH_INPUT_REWRITTEN_ALLOWLIST', '_BASH_REWRITE_CLASSES')\n\ndef _context_pressure_marker_name(session_id: Any) -> str:\n    \"\"\"Marker basename for ``session_id`` (PLAN-179 rail finding A).\n\n    Returns the bare project-wide basename when ``session_id`` is absent /\n    blank / not a string — the documented degraded mode, in which two\n    concurrent sessions in one repo can interfere with each other's\n    hysteresis. Otherwise returns ``<basename>.<sanitized-id>``.\n\n    Never raises: this runs inside a fail-open bookkeeping helper.\n    \"\"\"\n    if not isinstance(session_id, str):\n        return _CONTEXT_PRESSURE_STATE_BASENAME\n    raw = session_id.strip()\n    if not raw:\n        return _CONTEXT_PRESSURE_STATE_BASENAME\n    if (len(raw) <= _CONTEXT_PRESSURE_SID_MAX_LEN\n            and all(ch in _CONTEXT_PRESSURE_SID_SAFE_CHARS for ch in raw)):\n        suffix = raw\n    else:\n        # Local import: this module keeps hashlib out of its top-level import\n        # surface and imports it at the point of use (see _short_hash et al).\n        import hashlib\n        suffix = hashlib.sha256(\n            raw.encode(\"utf-8\", errors=\"replace\")\n        ).hexdigest()[:32]\n    return _CONTEXT_PRESSURE_STATE_BASENAME + \".\" + suffix\n\n\ndef _context_pressure_bucket_ok(value: Any) -> bool:\n    \"\"\"Strict INTEGER percent-bucket check for context_pressure_observed.\n\n    Type-strict on purpose. ``40.0 in {40}`` is True in Python (equal\n    numbers hash alike), so a plain membership test would wave a FLOAT onto\n    the wire — and a float under the HMAC chain DISCARDS THE WHOLE EVENT\n    (S181 / ADR-055-AMEND-2), not just the offending field. ``bool`` is\n    rejected explicitly because it is an ``int`` subclass and ``True`` would\n    otherwise sail through any numeric check.\n    \"\"\"\n    if isinstance(value, bool) or not isinstance(value, int):\n        return False\n    return value in _CONTEXT_PRESSURE_USED_BUCKETS_PCT\n\n\n# PLAN-179 rail round-5 [P2] — rotating identity shards, best-effort sweep.\n# A shard selects eligible names; it does not preserve directory position.\n# Each sweep starts a fresh scandir and can hit its deadline before the\n# same tail, so expired markers there have no guaranteed reclamation.\n_GC_SHARDS = 8\n\n\n# Contador de VARREDURA (rail round-6 [P2]): o shard avanca por SWEEP, nunca\n# pelo relogio — varreduras no mesmo minuto modulo K starvariam as outras.\n_GC_SHARD_COUNTER_NAME = \".gc-shard-cursor\"\n\n\ndef _gc_shard_of_name(name):\n    \"\"\"Shard estavel derivado do NOME (nunca da ordem de leitura).\"\"\"\n    try:\n        return zlib.crc32(name.encode(\"utf-8\", \"replace\")) % _GC_SHARDS\n    except Exception:\n        return 0\n\n\ndef _gc_next_shard(state_dir):\n    \"\"\"Select the next shard from a best-effort persisted counter.\n\n    A successful read/write advances the counter. A failed read seeds it\n    from randomness (zero if randomness also fails); a failed write can\n    leave the same counter for the next sweep. This selects eligible names,\n    without guaranteeing that the deadline-bounded scan reaches each name.\n    The counter read and ancestor paths retain the rc.1 condition 28 limits;\n    O_NOFOLLOW here protects only the temporary file used for the write.\n    \"\"\"\n    counter_path = Path(str(state_dir)) / _GC_SHARD_COUNTER_NAME\n    current = None\n    try:\n        raw = counter_path.read_text(encoding=\"utf-8\").strip()\n        current = int(raw)\n    except Exception:\n        current = None\n    if current is None:\n        try:\n            current = int.from_bytes(os.urandom(2), \"big\")\n        except Exception:\n            current = 0\n    nxt = (current + 1) % (_GC_SHARDS * 1024)  # espaco folgado, sem overflow\n    try:\n        counter_path.parent.mkdir(parents=True, exist_ok=True)\n        tmp = counter_path.parent / (\n            \".\" + counter_path.name + \".\" + str(os.getpid()) + \".\"\n            + os.urandom(4).hex() + \".tmp\"\n        )\n        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, \"O_NOFOLLOW\", 0)\n        fd = os.open(str(tmp), flags, 0o600)\n        try:\n            with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n                fh.write(str(nxt))\n        except Exception:\n            try:\n                os.unlink(str(tmp))\n            except OSError:\n                pass\n            raise\n        os.replace(str(tmp), str(counter_path))\n    except Exception:\n        pass  # housekeeping: nao persistir custa cobertura, nunca correcao\n    return nxt % _GC_SHARDS\n\n\ndef _gc_context_pressure_markers(\n    state_dir: Any,\n    ttl_seconds: int = _CONTEXT_PRESSURE_MARKER_TTL_S,\n    max_files: int = _CONTEXT_PRESSURE_MARKER_GC_MAX,\n) -> int:\n    \"\"\"Unlink aged-out per-session markers. Bounded, fail-open (finding A).\n\n    Per-session keying trades one shared file for one file per session, so\n    it must come with its own reclaim or it re-opens the unbounded-growth\n    class the rail rejected in the session STORES (finding C). Markers are\n    ~4 bytes and are only created on a rung TRANSITION with the progress\n    floor armed, so the rate is low — this sweep exists so \"low\" never\n    becomes \"forever\".\n\n    Only names carrying the marker prefix AND a suffix are considered; the\n    project-wide marker itself is never collected (it has no suffix), and an\n    unrelated file in ``.claude/state/`` is left alone. Returns the number\n    of files unlinked; every OSError is swallowed (housekeeping).\n    \"\"\"\n    removed = 0\n    prefix = _CONTEXT_PRESSURE_STATE_BASENAME + \".\"\n    try:\n        cutoff = time.time() - float(ttl_seconds)\n        directory = Path(str(state_dir))\n        # PLAN-179 rail rounds 2/3/4 [P2] — same story as the twin sweep in\n        # `scratchpad_lib.gc_orphan_session_stores`, and the same conclusion.\n        # r2 removed the sort+materialise; r3 replaced it with a fixed prefix\n        # window that STARVED the tail; r4 showed the rotating offset was still\n        # `% _scan_cap`, so nothing past ~2x that was ever reachable.\n        # Scan lazily without sorting, stopping at `max_files` deletions\n        # or the wall-clock deadline. The deadline can repeatedly leave\n        # the same tail unvisited: shard rotation alone does not guarantee\n        # coverage. A continuation mechanism remains an rc.1 P2 follow-up.\n        _deadline = time.time() + _GC_MARKER_WALL_BUDGET_S\n        _shard = _gc_next_shard(directory)\n        _scanned = 0\n        _it = os.scandir(str(directory))\n        try:\n            for _de in _it:\n                _scanned += 1\n                if removed >= int(max_files):\n                    break\n                if (_scanned & 63) == 0 and time.time() >= _deadline:\n                    break\n                entry = Path(_de.path)\n                name = entry.name\n                if _gc_shard_of_name(name) != _shard:\n                    continue\n                # Both the live marker `<prefix><sid>` and a crash-orphaned\n                # atomic-write temp `.<prefix><sid>.<pid>.<rand>.tmp`.\n                if name.startswith(\".\"):\n                    name = name[1:]\n                if not name.startswith(prefix) or len(name) <= len(prefix):\n                    continue\n                try:\n                    if entry.stat().st_mtime >= cutoff:\n                        continue\n                    entry.unlink()\n                    removed += 1\n                except OSError:\n                    # Per-entry fail-open: a racing unlink must not abort it.\n                    continue\n        finally:\n            try:\n                _it.close()\n            except Exception:\n                pass\n    except (OSError, TypeError, ValueError):\n        return removed\n    return removed\n\n\n# QDSAA-FUNCAO-LONGA: Preserve the existing marker expiry, sharded GC, and edge-trigger sequence during relocation.\ndef should_emit_context_pressure(\n    used_bucket: Any, state_dir: Any, session_id: Any = None\n) -> bool:\n    \"\"\"Return True only on a bucket TRANSITION (PLAN-179 W0 US2 / 8.1).\n\n    ``state_dir`` is the directory holding the marker — callers pass\n    ``<project>/.claude/state``. The marker records the last percent bucket\n    observed; a repeat of the same bucket returns False, a transition in\n    EITHER direction returns True and re-arms the marker. This is\n    hysteresis, not sampling: without it the rail emits one row per prompt\n    while the session sits in a single rung, which is exactly the flood the\n    HMAC chain must not carry.\n\n    ``session_id`` (PLAN-179 rail finding A, round-1 REJECT) KEYS that\n    marker. It must be the TRUSTED id — the one the harness put in the hook\n    input (``scratchpad_lib.session_id_from_event``), never\n    ``CLAUDE_SESSION_ID`` from the environment, which any agent with a\n    subshell can set (consensus M2). Passing None is legal and means the\n    DEGRADED project-wide marker: hysteresis then behaves as it did before\n    this fix, i.e. two concurrent sessions in the same repo suppress and\n    re-arm each other and the wire rows cannot be attributed. Callers that\n    have a trusted id must pass it; callers that do not should say so on the\n    wire by omitting ``session_id`` from the event rather than inventing one.\n\n    FAIL-OPEN on infrastructure (house rule): any state I/O error — absent\n    directory, unwritable path, corrupt or truncated marker — means\n    \"emit\", and the caller is never allowed to see an exception. The caller\n    is a hook; a bookkeeping file may not block or crash a user session.\n    Fail-open costs at most a duplicate breadcrumb, whereas fail-closed\n    would silently lose the very signal PLAN-179 exists to measure.\n    \"\"\"\n    if not _context_pressure_bucket_ok(used_bucket):\n        # Off-enum input must never re-arm the marker (that would let a\n        # bogus value suppress the NEXT real transition). The dispatch\n        # branch coerces the field itself, so there is nothing to debounce.\n        return True\n    try:\n        marker = Path(str(state_dir)) / _context_pressure_marker_name(session_id)\n    except (TypeError, ValueError):  # pragma: no cover - defensive\n        return True\n    current = str(int(used_bucket))\n    previous = None  # type: Optional[str]\n    try:\n        previous = marker.read_text(encoding=\"utf-8\").strip()\n    except (OSError, ValueError, UnicodeDecodeError):\n        previous = None\n    if previous == current:\n        return False\n    # Re-arm atomically (tmp + os.replace, 0600) — same idiom as\n    # check_directory_added._atomic_write, kept inline so audit_emit gains\n    # no new import.\n    try:\n        marker.parent.mkdir(parents=True, exist_ok=True)\n        # PLAN-179 rail finding A: the tmp name is derived from the SAME\n        # per-session marker name. Reusing the bare basename here would give\n        # two sessions re-arming at the same moment one shared tmp path.\n        # PLAN-179 rail round-3 [P1] — SYMLINK-SAFE, and the name is not\n        # guessable. `.claude/state/` is gitignored and world-writable to\n        # anything running as this user, so a PREDICTABLE tmp path could be\n        # pre-created as a symlink; a plain `open(..., \"w\")` follows it and the\n        # hook then truncates whatever it points at — an arbitrary-write\n        # primitive that routes around every canonical-edit guard, reached\n        # through an advisory audit helper. Three things close it together:\n        # O_EXCL (refuses an existing path), O_NOFOLLOW (refuses a symlink even\n        # if it appears between the check and the open), and a random suffix so\n        # pre-creation is not feasible in the first place. The mode is set AT\n        # CREATION, which also removes the window the old separate `chmod` left.\n        _rand = os.urandom(6).hex()\n        tmp = marker.parent / (\n            \".\" + marker.name + \".\" + str(os.getpid()) + \".\" + _rand + \".tmp\"\n        )\n        _flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY\n        _flags |= getattr(os, \"O_NOFOLLOW\", 0)  # POSIX; 0 is a safe no-op\n        _fd = os.open(str(tmp), _flags, 0o600)\n        try:\n            with os.fdopen(_fd, \"w\", encoding=\"utf-8\") as fh:\n                fh.write(current + \"\\n\")\n        except Exception:\n            # Never leave the temp behind on a failed write — the GC below\n            # only sweeps by AGE, so an orphan would linger for a full TTL.\n            try:\n                os.unlink(str(tmp))\n            except OSError:\n                pass\n            raise\n        os.replace(str(tmp), str(marker))\n    except (OSError, ValueError):\n        _breadcrumb(\n            \"should_emit_context_pressure: marker re-arm failed — \"\n            \"fail-open (the same bucket may emit twice)\"\n        )\n    # PLAN-179 rail finding A: reclaim runs ONLY on the re-arm path, i.e. on a\n    # rung TRANSITION, which is rare by construction (that is the whole point\n    # of the hysteresis above). It is bounded and fail-open by its own\n    # contract, and its result cannot change what this function returns.\n    _gc_context_pressure_markers(marker.parent)\n    return True\n\n\ndef clear_context_pressure_marker(state_dir: Any, session_id: Any = None) -> None:\n    \"\"\"Re-arma a histerese de pressão após uma compactação (rail round-10 [P1]).\n\n    O produtor é PreCompact-only: nada observa a QUEDA de contexto pós-\n    compactação, então uma sessão que compacta duas vezes no mesmo degrau\n    mantém previous==current e a segunda travessia genuína é suprimida.\n    O PostCompact chama isto para fechar a GERAÇÃO de compactação:\n    remover o marker re-arma o debounce para o próximo ciclo.\n\n    FAIL-OPEN (regra da casa): qualquer erro de I/O é engolido — um unlink\n    de bookkeeping nunca pode quebrar um hook. Marker ausente é o caso\n    normal (sessão que nunca cruzou um degrau).\"\"\"\n    try:\n        marker = Path(str(state_dir)) / _context_pressure_marker_name(session_id)\n        marker.unlink()\n    except (OSError, TypeError, ValueError):\n        pass\n\n\n# PLAN-135 W2 H5 (ADR-154) — Sec field allowlist for the bash-input-rewrite\n# breadcrumb (bash_input_rewritten, producer .claude/hooks/check_bash_safety.py).\n# Deny-by-default. Same no-value-echo contract as settings_tamper_detected\n# ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]): the\n# command STRING (before OR after the rewrite), the remote URL / refspec and\n# any inline credential are NEVER allowed fields — only the closed-enum\n# rewrite_class + the two 64-hex sha256 hashes travel on the wire. The hash\n# pair lets an auditor prove audited-cmd == executed-cmd without seeing either.\n_BASH_INPUT_REWRITTEN_ALLOWLIST = frozenset({\n    \"action\", \"session_id\", \"project\",\n    \"rewrite_class\", \"before_sha256\", \"after_sha256\",\n    # _write_event envelope (pre-allowed so scrub doesn't strip on round-trip):\n    \"ts\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n})\n\n\n# PLAN-135 W2 H5 — closed enum for the rewrite class. The pilot ships EXACTLY\n# one rewrite pattern; widening requires a new ADR + Codex (Doctrine 1\n# corollary + ADR-154 §1 single-rewriter invariant). Anything outside the set\n# (incl. a missing field) is COERCED to \"other\" (S172 doctrine — the rejected\n# value is never echoed).\n_BASH_REWRITE_CLASSES = frozenset({\n    \"git_push_force_to_lease\",\n    \"other\",\n})\n","numLines":339,"startLine":1,"totalLines":339}},"tool_result_meta":[{"id":"toolu_01H2K5Hp6GgmVQmifwbZX2Qu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
