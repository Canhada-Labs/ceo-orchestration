)\n485\t\n486\tif _SPOOL_WRITER_AVAILABLE and _spool_writer is not None:\n487\t    try:\n488\t        _spool_writer.set_forensic_emitter(\n489\t            lambda _action, _fields: emit_generic(_action, **_fields)\n490\t        )\n491\t    except Exception:\n492\t        pass\n493\t    try:\n494\t        _spool_writer.install_exit_handlers()\n495\t    except Exception:\n496\t        pass\n497\t"}]},"parent_tool_use_id":null,"session_id":"e5b55c72-4db7-4559-92ff-5b12e402f7bf","uuid":"553d229a-e2d5-4586-9d95-7dfbe3ab4b46","timestamp":"2026-11-13T17:23:51.587Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/audit_emit.py","content":"from __future__ import annotations\nimport getpass\nimport json\nimport os\nimport re\nimport sys\nimport threading\nimport time\nimport zlib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Optional\nfrom types import SimpleNamespace\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\nfrom _lib import redact as _redact\nfrom _lib import runtime_paths as _runtime_paths\nfrom _lib.filelock import FileLock, FileLockTimeout\nfrom _lib._audit_emit_parts import replay as _streaming\n\ntry:\n    from _lib.audit_rotation import rotate_if_needed as _shared_rotate_if_needed\n\n    _ROTATION_AVAILABLE = True\nexcept Exception:\n    _shared_rotate_if_needed = None\n    _ROTATION_AVAILABLE = False\ntry:\n    from _lib import audit_hmac as _audit_hmac\n\n    _HMAC_AVAILABLE = True\nexcept Exception:\n    _audit_hmac = None\n    _HMAC_AVAILABLE = False\ntry:\n    from _lib import spool_writer as _spool_writer\n\n    _SPOOL_WRITER_AVAILABLE = True\nexcept Exception:\n    _spool_writer = None\n    _SPOOL_WRITER_AVAILABLE = False\n\n_KNOWN_ACTIONS = {\n    \"action_required_held\",\n    \"action_required_rejected\",\n   