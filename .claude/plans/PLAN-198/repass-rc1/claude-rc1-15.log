{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1KPwDbVAfTE3WBUMTox","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01EXBbf8SLL5VJupuAUa2Dxz","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/tokens_boot.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":996,"cache_read_input_tokens":195009,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":996},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e5b55c72-4db7-4559-92ff-5b12e402f7bf","uuid":"815b415b-eea1-4d59-bbf6-9e18dd673855","timestamp":"2026-11-13T17:25:39.716Z","request_id":"req_011Ch1KPvyhgtsQQF4B71ped","wire_tool_inputs":{"toolu_01EXBbf8SLL5VJupuAUa2Dxz":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/tokens_boot.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EXBbf8SLL5VJupuAUa2Dxz","type":"tool_result","content":"1\t\"\"\"Tokens boot.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_is_sha256_hex', '_SUBAGENT_LIFECYCLE_OBSERVED_ALLOWLIST', '_SUBAGENT_LIFECYCLE_ARCHETYPES', '_SUBAGENT_LIFECYCLE_WALL_SOURCES', '_SUBAGENT_LIFECYCLE_BUCKETS', 'scrub_audit_tokens_event', 'emit_audit_tokens_emitted', 'emit_audit_tokens_timeout', 'emit_audit_tokens_key_dropped', 'emit_mcp_injection_finding', '_scrub_ceo_boot_event', 'emit_ceo_boot_emitted', '_TOOL_CALL_LIFECYCLE_DURATION_BUCKETS', '_TOOL_CALL_LIFECYCLE_TOOL_NAME_ENUM')\n9\t\n10\tdef _is_sha256_hex(value: Any) -> bool:\n11\t    \"\"\"True iff ``value`` is a 64-char lowercase-hex sha256 digest.\n12\t\n13\t    Defensive validator for the before/after hash pair (ADR-154 §2): a\n14\t    non-string, wrong-length, or non-hex value is rejected and the caller\n15\t    coerces it to \"\" (never echoed). Kept as a plain check (no regex) to\n16\t    preserve audit_emit's import surface.\n17\t    \"\"\"\n18\t    if not isinstance(value, str) or len(value) != 64:\n19\t        return False\n20\t    try:\n21\t        int(value, 16)\n22\t    except ValueError:\n23\t        return False\n24\t    return value == value.lower()\n25\t\n26\t\n27\t# PLAN-135 W2 H3 — Sec field allowlist for the per-agent SubagentStop lifecycle\n28\t# bracket (subagent_lifecycle_observed, producer\n29\t# .claude/hooks/check_fluency_nudge.py H3 extension). Deny-by-default. Same\n30\t# no-value-echo contract as settings_tamper_detected\n31\t# ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]): the\n32\t# transcript path/body, the RAW token counts, the RAW wall-time seconds, the\n33\t# raw agent_id and the confidence-marker snippets are NEVER allowed fields —\n34\t# only the closed-enum archetype + the four coarse brackets travel on the wire.\n35\t# The bracket IS the audit signal; the raw counts stay forensic-private (the\n36\t# S227 modelUsage reconstruction lives at bucket granularity here).\n37\t_SUBAGENT_LIFECYCLE_OBSERVED_ALLOWLIST = frozenset({\n38\t    \"action\", \"session_id\", \"project\",\n39\t    \"agent_archetype\", \"wall_bucket\", \"wall_source\",\n40\t    \"token_bucket\", \"claim_bucket\",\n41\t    # _write_event envelope (pre-allowed so scrub doesn't strip on round-trip):\n42\t    \"ts\", \"event_schema\",\n43\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n44\t    \"hmac\", \"hmac_error\",\n45\t})\n46\t\n47\t\n48\t# PLAN-135 W2 H3 — closed enum for the persona archetype that feeds the\n49\t# persona-ledger. Mirrors _PERSONA_COVERAGE_ARCHETYPES (the 4 VETO-floor\n50\t# personas, PLAN-093 Wave C.5) + \"other\" for any non-matching spawn type +\n51\t# \"unknown\" when the SubagentStart sidecar never recorded an agent_type.\n52\t# Anything outside the set (incl. a free-text spawn label or a missing field)\n53\t# is COERCED to \"other\" (S172 doctrine — the rejected value is never echoed,\n54\t# so a spawn description smuggled into agent_type cannot reach the wire).\n55\t_SUBAGENT_LIFECYCLE_ARCHETYPES = frozenset({\n56\t    \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n57\t    \"threat-detection-engineer\", \"other\", \"unknown\",\n58\t})\n59\t\n60\t\n61\t# PLAN-135 W2 H3 — closed enum for wall_source: was the SubagentStart instant\n62\t# recorded (so wall-time is a true bracket) or did the start go unobserved\n63\t# (orphaned start / kill-switch / crashed agent → bracket is \"unknown\")?\n64\t_SUBAGENT_LIFECYCLE_WALL_SOURCES = frozenset({\n65\t    \"bracketed\", \"unknown\",\n66\t})\n67\t\n68\t\n69\t# PLAN-135 W2 H3 — shared closed-enum bucket vocabulary for wall_bucket,\n70\t# token_bucket and claim_bucket. Coarse, monotonic, never a raw count. The\n71\t# bucketing function lives producer-side (check_fluency_nudge.py); audit_emit\n72\t# only validates the resulting token against this closed set (defense-in-depth\n73\t# on the direct emit_generic-caller path). \"unknown\" is the fail-closed\n74\t# sentinel for an unmeasured / unparseable dimension.\n75\t_SUBAGENT_LIFECYCLE_BUCKETS = frozenset({\n76\t    \"none\", \"low\", \"medium\", \"high\", \"very_high\", \"unknown\",\n77\t})\n78\t\n79\t\n80\tdef scrub_audit_tokens_event(\n81\t    event: Dict[str, Any],\n82\t    *,\n83\t    allowlist: Optional[frozenset] = None,\n84\t) -> Tuple[Dict[str, Any], List[str]]:\n85\t    \"\"\"Filter an audit-tokens event dict to allowlisted keys only.\n86\t\n87\t    Returns ``(cleaned_event, dropped_keys)``. Dropped keys are\n88\t    typically forbidden (raw text, payload bodies). Caller should\n89\t    emit ``audit_tokens_key_dropped`` breadcrumb if dropped is\n90\t    non-empty (defense-in-depth on allowlist drift).\n91\t\n92\t    Pure function — no side effects. Never raises.\n93\t\n94\t    Per SEC-P0-04 spec §Hook integration, this is called by\n95\t    emit_audit_tokens_emitted before _write_event. Belt-and-braces\n96\t    on top of audit-tokens.py CLI flag (--content-ban=strict).\n97\t    \"\"\"\n98\t    if allowlist is None:\n99\t        allowlist = _AUDIT_TOKENS_ALLOWLIST\n100\t    if not isinstance(event, dict):\n101\t        return ({}, [])\n102\t    cleaned: Dict[str, Any] = {}\n103\t    dropped: List[str] = []\n104\t    for key, value in event.items():\n105\t        if key in allowlist:\n106\t            cleaned[key] = value\n107\t        else:\n108\t            dropped.append(key)\n109\t    return (cleaned, dropped)\n110\t\n111\t\n112\tdef emit_audit_tokens_emitted(\n113\t    *,\n114\t    session_id: str,\n115\t    window_seconds: int,\n116\t    events_scanned: int,\n117\t    tokens_in_total: int,\n118\t    tokens_out_total: int,\n119\t    cost_cents: int,\n120\t    tier_id_distribution: Optional[Dict[str, int]] = None,\n121\t    detector_findings_count: Optional[Dict[str, int]] = None,\n122\t    hook_duration_ms: int = 0,\n123\t    timestamp: str = \"\",\n124\t    project: str = \"\",\n125\t) -> None:\n126\t    \"\"\"Emit audit_tokens_emitted (SEC-P0-04 / ADR-080).\n127\t\n128\t    Builds a counts-only event from audit-tokens.py stub output.\n129\t    Applies scrub_audit_tokens_event() defense-in-depth before write.\n130\t    If forbidden keys are stripped, also emits\n131\t    audit_tokens_key_dropped breadcrumb.\n132\t\n133\t    Total event payload is bounded: per SEC-P0-04 spec §Acceptance\n134\t    test 8, serialized JSON < 2 KiB. The 12-key allowlist + integer/\n135\t    short-string values keep this well under cap.\n136\t    \"\"\"\n137\t    raw_event: Dict[str, Any] = {\n138\t        \"action\": \"audit_tokens_emitted\",\n139\t        \"session_id\": session_id,\n140\t        \"timestamp\": timestamp or _utc_now_iso(),\n141\t        \"window_seconds\": int(window_seconds),\n142\t        \"events_scanned\": int(events_scanned),\n143\t        \"tokens_in_total\": int(tokens_in_total),\n144\t        \"tokens_out_total\": int(tokens_out_total),\n145\t        \"cost_cents\": int(cost_cents),\n146\t        \"tier_id_distribution\": dict(tier_id_distribution or {}),\n147\t        \"detector_findings_count\": dict(detector_findings_count or {}),\n148\t        \"hook_duration_ms\": int(hook_duration_ms),\n149\t        \"project\": project,\n150\t    }\n151\t    cleaned, dropped = scrub_audit_tokens_event(raw_event)\n152\t    _write_event(cleaned)\n153\t    # Defense-in-depth: if any keys were stripped, breadcrumb so a\n154\t    # post-flight scan or CI gate can detect allowlist drift.\n155\t    if dropped:\n156\t        emit_audit_tokens_key_dropped(\n157\t            session_id=session_id,\n158\t            dropped_keys=dropped,\n159\t            project=project,\n160\t        )\n161\t\n162\t\n163\tdef emit_audit_tokens_timeout(\n164\t    *,\n165\t    session_id: str,\n166\t    timeout_seconds: float,\n167\t    project: str = \"\",\n168\t) -> None:\n169\t    \"\"\"Emit audit_tokens_timeout (SEC-P0-04 §Performance budget).\n170\t\n171\t    Fired when audit-tokens.py subprocess invocation exceeds\n172\t    ``timeout_seconds`` (default per SEC-P0-04: 0.05 = 50ms wall).\n173\t    Replaces the audit_tokens_emitted that would have been emitted\n174\t    on success — SessionEnd hook should not block on slow detectors.\n175\t\n176\t    ``timeout_ms`` is integer milliseconds. canonical_json forbids floats\n177\t    in HMAC-covered fields; the old ``timeout_seconds`` float caused\n178\t    CanonicalJsonError + dropped events. Caller passes a float seconds\n179\t    value (backward-compatible); we convert to int ms here.\n180\t    \"\"\"\n181\t    event: Dict[str, Any] = {\n182\t        \"action\": \"audit_tokens_timeout\",\n183\t        \"session_id\": session_id,\n184\t        \"timeout_ms\": max(0, int(round(timeout_seconds * 1000))),\n185\t        \"project\": project,\n186\t    }\n187\t    _write_event(event)\n188\t\n189\t\n190\tdef emit_audit_tokens_key_dropped(\n191\t    *,\n192\t    session_id: str,\n193\t    dropped_keys: List[str],\n194\t    project: str = \"\",\n195\t) -> None:\n196\t    \"\"\"Emit audit_tokens_key_dropped breadcrumb (SEC-P0-04 defense-in-depth).\n197\t\n198\t    Fired by scrub_audit_tokens_event() when forbidden keys are\n199\t    stripped from an audit-tokens event. Indicates either:\n200\t\n201\t    1. A code change introduced a new key without updating\n202\t       _AUDIT_TOKENS_ALLOWLIST (likely benign — drift signal).\n203\t    2. An attacker / misconfigured code injected forbidden content\n204\t       into audit-tokens output (real signal — investigate).\n205\t\n206\t    Either way, post-flight scan can grep for these breadcrumbs to\n207\t    catch drift OR alert on attack. Event itself does NOT include\n208\t    the dropped values, only the keys (so even hostile keys with\n209\t    payload-like names don't leak content).\n210\t    \"\"\"\n211\t    # Bound dropped_keys list size to prevent pathological emit cost\n212\t    # if every key in a misconfigured event was forbidden.\n213\t    keys_preview = list(dropped_keys)[:50]\n214\t    event: Dict[str, Any] = {\n215\t        \"action\": \"audit_tokens_key_dropped\",\n216\t        \"session_id\": session_id,\n217\t        \"dropped_keys\": keys_preview,\n218\t        \"dropped_count\": len(dropped_keys),\n219\t        \"project\": project,\n220\t    }\n221\t\n222\t\n223\t\n224\t\n225\t\n226\t\n227\t    _write_event(event)\n228\t\n229\t\n230\t# ---------------------------------------------------------------------\n231\t# PLAN-052 Phase 1 / ADR-083 — MCP injection scanner advisory finding\n232\t# Wired by PLAN-044 audit-v2 Wave B (C1-P0-03).\n233\t# ---------------------------------------------------------------------\n234\t\n235\t\n236\tdef emit_mcp_injection_finding(\n237\t    *,\n238\t    server_id: str,\n239\t    mcp_tool_name: str,\n240\t    source_kind: str,\n241\t    family_counts: Dict[str, int],\n242\t    match_count: int,\n243\t    bytes_scanned: int,\n244\t    severity: str,\n245\t    snippet_preview: str,\n246\t    scanner_action: str = \"advisory\",\n247\t    session_id: str = \"\",\n248\t    project: str = \"\",\n249\t) -> None:\n250\t    \"\"\"Emit `mcp_injection_finding` event from check_mcp_response.py.\n251\t\n252\t    Schema mirrors `output_scan_finding` (ADR-057) with MCP-specific\n253\t    fields. Per SPEC/v1/audit-log.schema.md v2.13, fields are:\n254\t\n255\t      - server_id: MCP server identifier (parsed from `mcp__<server>__<tool>`)\n256\t      - mcp_tool_name: tool name within the server\n257\t      - source_kind: which MCP surface triggered the scan\n258\t        (`tool_result` | `instructions` | `resource_fetch`)\n259\t      - family_counts: per-injection-family hit counts\n260\t        (harness_mimicry, role_preamble, directive_prose, synthetic_tool_call)\n261\t      - match_count: total individual pattern matches across families\n262\t      - bytes_scanned: total bytes the scanner inspected (for budget tracking)\n263\t      - severity: `low` | `medium` | `high` (per `_lib/mcp_injection_scan.py`\n264\t        `_SEVERITY_BY_FAMILY`; SPEC v1 audit-log.schema.md aligned). Session 75\n265\t        Codex Finding 6 closure: prior docstring `info|warn|block` was schema\n266\t        drift — never matched `classify()` returns.\n267\t      - snippet_preview: redacted ≤120-char preview of the offending text\n268\t      - scanner_action: `advisory` | `stripped` | `blocked` (per SPEC v1\n269\t        audit-log.schema.md). Session 75 Codex Finding 6 closure: prior\n270\t        docstring `block` was verb-form drift; SPEC declares state-form\n271\t        `blocked`. `stripped` is reserved for Phase 2 sanitization.\n272\t\n273\t    Called from check_mcp_response.py:148 only when\n274\t    finding.matched. The hook is fail-open by contract — emission failures\n275\t    are swallowed by the caller's try/except.\n276\t\n277\t    PLAN-044 audit-v2 C1-P0-03 closes 5 cross-validating findings\n278\t    (dim 04, 06, 07, 16, 18) by removing the `hasattr` guard in the\n279\t    hook AND registering the action here so emit_generic doesn't\n280\t    short-circuit.\n281\t    \"\"\"\n282\t    emit_generic(\n283\t        \"mcp_injection_finding\",\n284\t        session_id=session_id,\n285\t        server_id=server_id,\n286\t        mcp_tool_name=mcp_tool_name,\n287\t        source_kind=source_kind,\n288\t        family_counts=dict(family_counts or {}),\n289\t        match_count=int(match_count),\n290\t        bytes_scanned=int(bytes_scanned),\n291\t        severity=severity,\n292\t        snippet_preview=snippet_preview[:120] if snippet_preview else \"\",\n293\t        scanner_action=scanner_action,\n294\t        project=project,\n295\t    )\n296\t\n297\t\n298\t# ---------------------------------------------------------------------\n299\t# PLAN-065 Phase 2 / ADR-098 — /ceo-boot lifecycle emitters.\n300\t# Sec MF-3 field allowlist enforced (deny-by-default). Forbidden fields\n301\t# (tokens / cost / paths / prompt / SKILL / env) are stripped before emit\n302\t# and a breadcrumb is written to audit-log.errors (NOT a typed audit\n303\t# event — drift signal only, mirrors the audit-tokens `_key_dropped`\n304\t# defense-in-depth pattern but kept off the typed stream until v1.13.0\n305\t# PLAN-067 if needed).\n306\t# ---------------------------------------------------------------------\n307\t\n308\t\n309\tdef _scrub_ceo_boot_event(\n310\t    event: Dict[str, Any],\n311\t    allowlist: frozenset,\n312\t) -> Tuple[Dict[str, Any], List[str]]:\n313\t    \"\"\"Strip any field outside ``allowlist``. Returns (cleaned, dropped_keys).\n314\t\n315\t    Pure function. No I/O. Caller decides whether to breadcrumb the drop.\n316\t    Forbidden fields are NEVER returned in cleaned dict — this is the\n317\t    Sec MF-3 enforcement boundary. Drift = drop = visible.\n318\t    \"\"\"\n319\t    cleaned: Dict[str, Any] = {}\n320\t    dropped: List[str] = []\n321\t    for k, v in event.items():\n322\t        if k in allowlist:\n323\t            cleaned[k] = v\n324\t        else:\n325\t            dropped.append(k)\n326\t    return cleaned, dropped\n327\t\n328\t\n329\tdef emit_ceo_boot_emitted(\n330\t    *,\n331\t    session_id: str,\n332\t    gate_pass: bool,\n333\t    duration_ms: int,\n334\t    checks_total: int,\n335\t    checks_failed: int,\n336\t    cache_hit: bool = False,\n337\t    project: str = \"\",\n338\t) -> None:\n339\t    \"\"\"Emit ceo_boot_emitted (PLAN-065 Phase 2 / ADR-098).\n340\t\n341\t    Fired once per /ceo-boot invocation at end-of-run (cached + uncached).\n342\t    Field allowlist enforced (Sec MF-3): no token counts, no cost, no\n343\t    paths, no prompt content, no SKILL.md content, no environment values.\n344\t\n345\t    Fail-open per audit_emit contract — exceptions are swallowed by\n346\t    _write_event. Caller (ceo-boot.py) MUST also wrap in a broad except\n347\t    so that a slow audit-log filelock NEVER blocks the user session.\n348\t    \"\"\"\n349\t    raw_event: Dict[str, Any] = {\n350\t        \"action\": \"ceo_boot_emitted\",\n351\t        \"session_id\": session_id,\n352\t        \"project\": project,\n353\t        \"gate_pass\": bool(gate_pass),\n354\t        \"duration_ms\": int(duration_ms),\n355\t        \"checks_total\": int(checks_total),\n356\t        \"checks_failed\": int(checks_failed),\n357\t        \"cache_hit\": bool(cache_hit),\n358\t    }\n359\t    cleaned, dropped = _scrub_ceo_boot_event(raw_event, _CEO_BOOT_EMITTED_ALLOWLIST)\n360\t    _write_event(cleaned)\n361\t    if dropped:  # pragma: no cover — should be impossible from the typed wrapper\n362\t        _breadcrumb(\n363\t            f\"ceo_boot_emitted dropped forbidden field(s): \"\n364\t            f\"{sorted(dropped)[:10]}\"\n365\t        )\n366\t\n367\t\n368\t# PLAN-125 WS-1 (kooky-harvest) — closed-enum validation sets for the\n369\t# tool_call_lifecycle_recorded typed emitter. Kept local to the emitter so the\n370\t# enum domain is enforced at the typed entrypoint AND re-checked here even if a\n371\t# caller hand-builds the field values (defense-in-depth; the mapper in\n372\t# _lib/tool_lifecycle.py is the canonical producer).\n373\t_TOOL_CALL_LIFECYCLE_DURATION_BUCKETS = frozenset({\n374\t    \"lt_100ms\", \"b_100ms_1s\", \"b_1_10s\", \"b_10_60s\", \"gt_60s\",\n375\t})\n376\t\n377\t\n378\t# Recognized standard tool names + the two synthetic buckets the mapper\n379\t# produces. A value outside this set is coerced to \"other\" before emit so a\n380\t# raw mcp__<server>__<tool> string can NEVER reach the wire (MF-SEC-1), even on\n381\t# a direct typed-emitter call that bypassed the mapper.\n382\t# PLAN-153 wave-backlog (v2.48 additive enum extension): + TaskCreate /\n383\t# TaskUpdate / TaskGet / TaskList — the Claude Code 2.1.x Task tools that\n384\t# deprecate TodoWrite (which stays for back-compat). COUPLING (3-way pin):\n385\t# must stay in sync with `_RECOGNIZED_TOOL_NAMES` in _lib/tool_lifecycle.py\n386\t# and the closed enum on the `tool_call_lifecycle_recorded` row of\n387\t# SPEC/v1/audit-log.schema.md; pin-sync regression-guarded by\n388\t# hooks/tests/test_tool_lifecycle_enum_pin_sync.py.\n389\t_TOOL_CALL_LIFECYCLE_TOOL_NAME_ENUM = frozenset({\n390\t    \"Agent\", \"Task\", \"TaskCreate\", \"TaskUpdate\", \"TaskGet\", \"TaskList\",\n391\t    \"Bash\", \"Edit\", \"MultiEdit\", \"Write\", \"Read\",\n392\t    \"Glob\", \"Grep\", \"WebFetch\", \"WebSearch\", \"NotebookEdit\", \"TodoWrite\",\n393\t    \"mcp_other\", \"other\",\n394\t})\n395\t"}]},"parent_tool_use_id":null,"session_id":"e5b55c72-4db7-4559-92ff-5b12e402f7bf","uuid":"4f19a99c-7a5f-4a6f-9b9c-85920edf0867","timestamp":"2026-11-13T17:25:39.729Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/tokens_boot.py","content":"\"\"\"Tokens boot.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('_is_sha256_hex', '_SUBAGENT_LIFECYCLE_OBSERVED_ALLOWLIST', '_SUBAGENT_LIFECYCLE_ARCHETYPES', '_SUBAGENT_LIFECYCLE_WALL_SOURCES', '_SUBAGENT_LIFECYCLE_BUCKETS', 'scrub_audit_tokens_event', 'emit_audit_tokens_emitted', 'emit_audit_tokens_timeout', 'emit_audit_tokens_key_dropped', 'emit_mcp_injection_finding', '_scrub_ceo_boot_event', 'emit_ceo_boot_emitted', '_TOOL_CALL_LIFECYCLE_DURATION_BUCKETS', '_TOOL_CALL_LIFECYCLE_TOOL_NAME_ENUM')\n\ndef _is_sha256_hex(value: Any) -> bool:\n    \"\"\"True iff ``value`` is a 64-char lowercase-hex sha256 digest.\n\n    Defensive validator for the before/after hash pair (ADR-154 §2): a\n    non-string, wrong-length, or non-hex value is rejected and the caller\n    coerces it to \"\" (never echoed). Kept as a plain check (no regex) to\n    preserve audit_emit's import surface.\n    \"\"\"\n    if not isinstance(value, str) or len(value) != 64:\n        return False\n    try:\n        int(value, 16)\n    except ValueError:\n        return False\n    return value == value.lower()\n\n\n# PLAN-135 W2 H3 — Sec field allowlist for the per-agent SubagentStop lifecycle\n# bracket (subagent_lifecycle_observed, producer\n# .claude/hooks/check_fluency_nudge.py H3 extension). Deny-by-default. Same\n# no-value-echo contract as settings_tamper_detected\n# ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]): the\n# transcript path/body, the RAW token counts, the RAW wall-time seconds, the\n# raw agent_id and the confidence-marker snippets are NEVER allowed fields —\n# only the closed-enum archetype + the four coarse brackets travel on the wire.\n# The bracket IS the audit signal; the raw counts stay forensic-private (the\n# S227 modelUsage reconstruction lives at bucket granularity here).\n_SUBAGENT_LIFECYCLE_OBSERVED_ALLOWLIST = frozenset({\n    \"action\", \"session_id\", \"project\",\n    \"agent_archetype\", \"wall_bucket\", \"wall_source\",\n    \"token_bucket\", \"claim_bucket\",\n    # _write_event envelope (pre-allowed so scrub doesn't strip on round-trip):\n    \"ts\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n})\n\n\n# PLAN-135 W2 H3 — closed enum for the persona archetype that feeds the\n# persona-ledger. Mirrors _PERSONA_COVERAGE_ARCHETYPES (the 4 VETO-floor\n# personas, PLAN-093 Wave C.5) + \"other\" for any non-matching spawn type +\n# \"unknown\" when the SubagentStart sidecar never recorded an agent_type.\n# Anything outside the set (incl. a free-text spawn label or a missing field)\n# is COERCED to \"other\" (S172 doctrine — the rejected value is never echoed,\n# so a spawn description smuggled into agent_type cannot reach the wire).\n_SUBAGENT_LIFECYCLE_ARCHETYPES = frozenset({\n    \"code-reviewer\", \"security-engineer\", \"qa-architect\",\n    \"threat-detection-engineer\", \"other\", \"unknown\",\n})\n\n\n# PLAN-135 W2 H3 — closed enum for wall_source: was the SubagentStart instant\n# recorded (so wall-time is a true bracket) or did the start go unobserved\n# (orphaned start / kill-switch / crashed agent → bracket is \"unknown\")?\n_SUBAGENT_LIFECYCLE_WALL_SOURCES = frozenset({\n    \"bracketed\", \"unknown\",\n})\n\n\n# PLAN-135 W2 H3 — shared closed-enum bucket vocabulary for wall_bucket,\n# token_bucket and claim_bucket. Coarse, monotonic, never a raw count. The\n# bucketing function lives producer-side (check_fluency_nudge.py); audit_emit\n# only validates the resulting token against this closed set (defense-in-depth\n# on the direct emit_generic-caller path). \"unknown\" is the fail-closed\n# sentinel for an unmeasured / unparseable dimension.\n_SUBAGENT_LIFECYCLE_BUCKETS = frozenset({\n    \"none\", \"low\", \"medium\", \"high\", \"very_high\", \"unknown\",\n})\n\n\ndef scrub_audit_tokens_event(\n    event: Dict[str, Any],\n    *,\n    allowlist: Optional[frozenset] = None,\n) -> Tuple[Dict[str, Any], List[str]]:\n    \"\"\"Filter an audit-tokens event dict to allowlisted keys only.\n\n    Returns ``(cleaned_event, dropped_keys)``. Dropped keys are\n    typically forbidden (raw text, payload bodies). Caller should\n    emit ``audit_tokens_key_dropped`` breadcrumb if dropped is\n    non-empty (defense-in-depth on allowlist drift).\n\n    Pure function — no side effects. Never raises.\n\n    Per SEC-P0-04 spec §Hook integration, this is called by\n    emit_audit_tokens_emitted before _write_event. Belt-and-braces\n    on top of audit-tokens.py CLI flag (--content-ban=strict).\n    \"\"\"\n    if allowlist is None:\n        allowlist = _AUDIT_TOKENS_ALLOWLIST\n    if not isinstance(event, dict):\n        return ({}, [])\n    cleaned: Dict[str, Any] = {}\n    dropped: List[str] = []\n    for key, value in event.items():\n        if key in allowlist:\n            cleaned[key] = value\n        else:\n            dropped.append(key)\n    return (cleaned, dropped)\n\n\ndef emit_audit_tokens_emitted(\n    *,\n    session_id: str,\n    window_seconds: int,\n    events_scanned: int,\n    tokens_in_total: int,\n    tokens_out_total: int,\n    cost_cents: int,\n    tier_id_distribution: Optional[Dict[str, int]] = None,\n    detector_findings_count: Optional[Dict[str, int]] = None,\n    hook_duration_ms: int = 0,\n    timestamp: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit audit_tokens_emitted (SEC-P0-04 / ADR-080).\n\n    Builds a counts-only event from audit-tokens.py stub output.\n    Applies scrub_audit_tokens_event() defense-in-depth before write.\n    If forbidden keys are stripped, also emits\n    audit_tokens_key_dropped breadcrumb.\n\n    Total event payload is bounded: per SEC-P0-04 spec §Acceptance\n    test 8, serialized JSON < 2 KiB. The 12-key allowlist + integer/\n    short-string values keep this well under cap.\n    \"\"\"\n    raw_event: Dict[str, Any] = {\n        \"action\": \"audit_tokens_emitted\",\n        \"session_id\": session_id,\n        \"timestamp\": timestamp or _utc_now_iso(),\n        \"window_seconds\": int(window_seconds),\n        \"events_scanned\": int(events_scanned),\n        \"tokens_in_total\": int(tokens_in_total),\n        \"tokens_out_total\": int(tokens_out_total),\n        \"cost_cents\": int(cost_cents),\n        \"tier_id_distribution\": dict(tier_id_distribution or {}),\n        \"detector_findings_count\": dict(detector_findings_count or {}),\n        \"hook_duration_ms\": int(hook_duration_ms),\n        \"project\": project,\n    }\n    cleaned, dropped = scrub_audit_tokens_event(raw_event)\n    _write_event(cleaned)\n    # Defense-in-depth: if any keys were stripped, breadcrumb so a\n    # post-flight scan or CI gate can detect allowlist drift.\n    if dropped:\n        emit_audit_tokens_key_dropped(\n            session_id=session_id,\n            dropped_keys=dropped,\n            project=project,\n        )\n\n\ndef emit_audit_tokens_timeout(\n    *,\n    session_id: str,\n    timeout_seconds: float,\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit audit_tokens_timeout (SEC-P0-04 §Performance budget).\n\n    Fired when audit-tokens.py subprocess invocation exceeds\n    ``timeout_seconds`` (default per SEC-P0-04: 0.05 = 50ms wall).\n    Replaces the audit_tokens_emitted that would have been emitted\n    on success — SessionEnd hook should not block on slow detectors.\n\n    ``timeout_ms`` is integer milliseconds. canonical_json forbids floats\n    in HMAC-covered fields; the old ``timeout_seconds`` float caused\n    CanonicalJsonError + dropped events. Caller passes a float seconds\n    value (backward-compatible); we convert to int ms here.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"audit_tokens_timeout\",\n        \"session_id\": session_id,\n        \"timeout_ms\": max(0, int(round(timeout_seconds * 1000))),\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_audit_tokens_key_dropped(\n    *,\n    session_id: str,\n    dropped_keys: List[str],\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit audit_tokens_key_dropped breadcrumb (SEC-P0-04 defense-in-depth).\n\n    Fired by scrub_audit_tokens_event() when forbidden keys are\n    stripped from an audit-tokens event. Indicates either:\n\n    1. A code change introduced a new key without updating\n       _AUDIT_TOKENS_ALLOWLIST (likely benign — drift signal).\n    2. An attacker / misconfigured code injected forbidden content\n       into audit-tokens output (real signal — investigate).\n\n    Either way, post-flight scan can grep for these breadcrumbs to\n    catch drift OR alert on attack. Event itself does NOT include\n    the dropped values, only the keys (so even hostile keys with\n    payload-like names don't leak content).\n    \"\"\"\n    # Bound dropped_keys list size to prevent pathological emit cost\n    # if every key in a misconfigured event was forbidden.\n    keys_preview = list(dropped_keys)[:50]\n    event: Dict[str, Any] = {\n        \"action\": \"audit_tokens_key_dropped\",\n        \"session_id\": session_id,\n        \"dropped_keys\": keys_preview,\n        \"dropped_count\": len(dropped_keys),\n        \"project\": project,\n    }\n\n\n\n\n\n\n    _write_event(event)\n\n\n# ---------------------------------------------------------------------\n# PLAN-052 Phase 1 / ADR-083 — MCP injection scanner advisory finding\n# Wired by PLAN-044 audit-v2 Wave B (C1-P0-03).\n# ---------------------------------------------------------------------\n\n\ndef emit_mcp_injection_finding(\n    *,\n    server_id: str,\n    mcp_tool_name: str,\n    source_kind: str,\n    family_counts: Dict[str, int],\n    match_count: int,\n    bytes_scanned: int,\n    severity: str,\n    snippet_preview: str,\n    scanner_action: str = \"advisory\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit `mcp_injection_finding` event from check_mcp_response.py.\n\n    Schema mirrors `output_scan_finding` (ADR-057) with MCP-specific\n    fields. Per SPEC/v1/audit-log.schema.md v2.13, fields are:\n\n      - server_id: MCP server identifier (parsed from `mcp__<server>__<tool>`)\n      - mcp_tool_name: tool name within the server\n      - source_kind: which MCP surface triggered the scan\n        (`tool_result` | `instructions` | `resource_fetch`)\n      - family_counts: per-injection-family hit counts\n        (harness_mimicry, role_preamble, directive_prose, synthetic_tool_call)\n      - match_count: total individual pattern matches across families\n      - bytes_scanned: total bytes the scanner inspected (for budget tracking)\n      - severity: `low` | `medium` | `high` (per `_lib/mcp_injection_scan.py`\n        `_SEVERITY_BY_FAMILY`; SPEC v1 audit-log.schema.md aligned). Session 75\n        Codex Finding 6 closure: prior docstring `info|warn|block` was schema\n        drift — never matched `classify()` returns.\n      - snippet_preview: redacted ≤120-char preview of the offending text\n      - scanner_action: `advisory` | `stripped` | `blocked` (per SPEC v1\n        audit-log.schema.md). Session 75 Codex Finding 6 closure: prior\n        docstring `block` was verb-form drift; SPEC declares state-form\n        `blocked`. `stripped` is reserved for Phase 2 sanitization.\n\n    Called from check_mcp_response.py:148 only when\n    finding.matched. The hook is fail-open by contract — emission failures\n    are swallowed by the caller's try/except.\n\n    PLAN-044 audit-v2 C1-P0-03 closes 5 cross-validating findings\n    (dim 04, 06, 07, 16, 18) by removing the `hasattr` guard in the\n    hook AND registering the action here so emit_generic doesn't\n    short-circuit.\n    \"\"\"\n    emit_generic(\n        \"mcp_injection_finding\",\n        session_id=session_id,\n        server_id=server_id,\n        mcp_tool_name=mcp_tool_name,\n        source_kind=source_kind,\n        family_counts=dict(family_counts or {}),\n        match_count=int(match_count),\n        bytes_scanned=int(bytes_scanned),\n        severity=severity,\n        snippet_preview=snippet_preview[:120] if snippet_preview else \"\",\n        scanner_action=scanner_action,\n        project=project,\n    )\n\n\n# ---------------------------------------------------------------------\n# PLAN-065 Phase 2 / ADR-098 — /ceo-boot lifecycle emitters.\n# Sec MF-3 field allowlist enforced (deny-by-default). Forbidden fields\n# (tokens / cost / paths / prompt / SKILL / env) are stripped before emit\n# and a breadcrumb is written to audit-log.errors (NOT a typed audit\n# event — drift signal only, mirrors the audit-tokens `_key_dropped`\n# defense-in-depth pattern but kept off the typed stream until v1.13.0\n# PLAN-067 if needed).\n# ---------------------------------------------------------------------\n\n\ndef _scrub_ceo_boot_event(\n    event: Dict[str, Any],\n    allowlist: frozenset,\n) -> Tuple[Dict[str, Any], List[str]]:\n    \"\"\"Strip any field outside ``allowlist``. Returns (cleaned, dropped_keys).\n\n    Pure function. No I/O. Caller decides whether to breadcrumb the drop.\n    Forbidden fields are NEVER returned in cleaned dict — this is the\n    Sec MF-3 enforcement boundary. Drift = drop = visible.\n    \"\"\"\n    cleaned: Dict[str, Any] = {}\n    dropped: List[str] = []\n    for k, v in event.items():\n        if k in allowlist:\n            cleaned[k] = v\n        else:\n            dropped.append(k)\n    return cleaned, dropped\n\n\ndef emit_ceo_boot_emitted(\n    *,\n    session_id: str,\n    gate_pass: bool,\n    duration_ms: int,\n    checks_total: int,\n    checks_failed: int,\n    cache_hit: bool = False,\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit ceo_boot_emitted (PLAN-065 Phase 2 / ADR-098).\n\n    Fired once per /ceo-boot invocation at end-of-run (cached + uncached).\n    Field allowlist enforced (Sec MF-3): no token counts, no cost, no\n    paths, no prompt content, no SKILL.md content, no environment values.\n\n    Fail-open per audit_emit contract — exceptions are swallowed by\n    _write_event. Caller (ceo-boot.py) MUST also wrap in a broad except\n    so that a slow audit-log filelock NEVER blocks the user session.\n    \"\"\"\n    raw_event: Dict[str, Any] = {\n        \"action\": \"ceo_boot_emitted\",\n        \"session_id\": session_id,\n        \"project\": project,\n        \"gate_pass\": bool(gate_pass),\n        \"duration_ms\": int(duration_ms),\n        \"checks_total\": int(checks_total),\n        \"checks_failed\": int(checks_failed),\n        \"cache_hit\": bool(cache_hit),\n    }\n    cleaned, dropped = _scrub_ceo_boot_event(raw_event, _CEO_BOOT_EMITTED_ALLOWLIST)\n    _write_event(cleaned)\n    if dropped:  # pragma: no cover — should be impossible from the typed wrapper\n        _breadcrumb(\n            f\"ceo_boot_emitted dropped forbidden field(s): \"\n            f\"{sorted(dropped)[:10]}\"\n        )\n\n\n# PLAN-125 WS-1 (kooky-harvest) — closed-enum validation sets for the\n# tool_call_lifecycle_recorded typed emitter. Kept local to the emitter so the\n# enum domain is enforced at the typed entrypoint AND re-checked here even if a\n# caller hand-builds the field values (defense-in-depth; the mapper in\n# _lib/tool_lifecycle.py is the canonical producer).\n_TOOL_CALL_LIFECYCLE_DURATION_BUCKETS = frozenset({\n    \"lt_100ms\", \"b_100ms_1s\", \"b_1_10s\", \"b_10_60s\", \"gt_60s\",\n})\n\n\n# Recognized standard tool names + the two synthetic buckets the mapper\n# produces. A value outside this set is coerced to \"other\" before emit so a\n# raw mcp__<server>__<tool> string can NEVER reach the wire (MF-SEC-1), even on\n# a direct typed-emitter call that bypassed the mapper.\n# PLAN-153 wave-backlog (v2.48 additive enum extension): + TaskCreate /\n# TaskUpdate / TaskGet / TaskList — the Claude Code 2.1.x Task tools that\n# deprecate TodoWrite (which stays for back-compat). COUPLING (3-way pin):\n# must stay in sync with `_RECOGNIZED_TOOL_NAMES` in _lib/tool_lifecycle.py\n# and the closed enum on the `tool_call_lifecycle_recorded` row of\n# SPEC/v1/audit-log.schema.md; pin-sync regression-guarded by\n# hooks/tests/test_tool_lifecycle_enum_pin_sync.py.\n_TOOL_CALL_LIFECYCLE_TOOL_NAME_ENUM = frozenset({\n    \"Agent\", \"Task\", \"TaskCreate\", \"TaskUpdate\", \"TaskGet\", \"TaskList\",\n    \"Bash\", \"Edit\", \"MultiEdit\", \"Write\", \"Read\",\n    \"Glob\", \"Grep\", \"WebFetch\", \"WebSearch\", \"NotebookEdit\", \"TodoWrite\",\n    \"mcp_other\", \"other\",\n})\n","numLines":395,"startLine":1,"totalLines":395}},"tool_result_meta":[{"id":"toolu_01EXBbf8SLL5VJupuAUa2Dxz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
