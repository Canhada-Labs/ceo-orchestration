ule\n141\t\n142\t\n143\tdef _reset_module_cache() -> None:\n144\t    \"\"\"Test helper — drop the cached audit-query module.\"\"\"\n145\t    global _AUDIT_QUERY_MODULE, _LOAD_ERROR\n146\t    with _MODULE_LOCK:\n147\t        _AUDIT_QUERY_MODULE = None\n148\t        _LOAD_ERROR = None\n149\t        sys.modules.pop(\"_mcp_audit_query_module\", None)\n150\t\n151\t\n152\t# ---------------------------------------------------------------------------\n153\t# Argparse Namespace synthesis\n154\t# ---------------------------------------------------------------------------\n155\t\n156\t\n157\t_NAMESPACE_DEFAULTS: Dict[str, Any] = {\n158\t    # Shared/global flags (--log, --include-rotated, --json, --csv,\n159\t    # --errors-path) populated by audit-query.py _build_shared_parser.\n160\t    \"log\": None,\n161\t    \"include_rotated\": False,\n162\t    \"json\": True,  # MCP always wants JSON output\n163\t    \"csv\": False,\n164\t    \"errors_path\": None,\n165\t    # Per-command frequently-used flags. Anything missing falls back to\n166\t    # None and audit-query.py per-command logic handles it.\n167\t    \"top_n\": None,\n168\t    \"regex\": \"\",\n169\t    \"since\": None,\n170\t    \"limit\": None,\n171\t    \"domain\": None,\n172\t    \"window\": None,\n173\t    \"month\": None,\n174\t    \"skill\": None,\n175\t    \"tail\": None,\n176\t    \"format\": \"json\",\n177\t    \"plan_id\": None,\n178\t    \"case_id\": None,\n179\t    \"wave\": None,\n180\t    \"include_sunset\": False,\n181\t    \"exclude_sunset\": False,\n182\t    \"subject\": None,\n183\t    \"verdict\": None,\n184\t    \"evidence_uri\": None,\n185\t    \"min_records\": None,\n186\t    \"min_calls\": None,\n187\t    \"min_dispatches\": None,\n188\t    \"min_observations\": None,\n189\t    \"min_routes\": None,\n190\t}\n191\t\n192\t\n193\tdef _build_namespace(params: Dict[str, Any]) -> argparse.Namespace:\n194\t    \"\"\"Synthesize an argparse.Namespace from JSON-RPC params.\n195\t\n196\t    Only keys in _NAMESPACE_DEFAULTS are forwarded; any unknown key is\n197\t    silently dropped (caller's responsibility to surface a warning if\n198\t    they want strict-mode behavior — read-only handlers favor\n199\t    fail-open).\n200\t    \"\"\"\n201\t    ns = argparse.Namespace()\n202\t    # Seed from defaults first.\n203\t    for k, v in _NAMESPACE_DEFAULTS.items():\n204\t        setattr(ns, k, v)\n205\t    # Override with caller-provided fields.\n206\t    if isinstance(params, dict):\n207\t        for k, v in params.items():\n208\t            if k in _NAMESPACE_DEFAULTS:\n209\t                setattr(ns, k, v)\n210\t    return ns\n211\t\n212\t\n213\t# ---------------------------------------------------------------------------\n214\t# Read-only invariant probe\n215\t# ---------------------------------------------------------------------------\n216\t\n217\t\n218\t# Param keys that would route to a writable cmd_* function. AC-R-1\n219\t# rejects ALL forged-write attempts before the handler invokes the\n220\t# underlying sub-command. The list is conservative: any param matching\n221\t# `_FORBIDDEN_WRITE_KEYS` (case-insensitive substring match) is\n222\t# rejected.\n223\t_FORBIDDEN_WRITE_KEYS = (\n224\t    \"label\",  # cmd_label appends HMAC-chained record\n225\t    \"write\",\n226\t    \"append\",\n227\t    \"output_path\",\n228\t    \"out_path\",\n229\t    \"store\",\n230\t    \"patch\",\n231\t)\n232\t\n233\t\n234\tdef _is_forged_write(params: Dict[str, Any]) -> Optional[str]:\n235\t    \"\"\"Return the first matching forbidden-write key, or None.\n236\t\n237\t    Used by AC-R-1 forged-write probe in test_mcp_readonly_invariant.py.\n238\t    \"\"\"\n239\t    if not isinstance(params, dict):\n240\t        return None\n241\t    for key in params:\n242\t        if not isinstance(key, str):\n243\t            continue\n244\t        kl = key.lower()\n245\t        for forbidden in _FORBIDDEN_WRITE_KEYS:\n246\t            if forbidden in kl:\n247\t                return key\n248\t    return None\n249\t\n250\t\n251\t# ---------------------------------------------------------------------------\n252\t# Dispatcher\n253\t# ---------------------------------------------------------------------------\n254\t\n255\t\n256\tdef _make_handler(subcommand: str):\n257\t    \"\"\"Build a handle(params, context) closure for a sub-command.\n258\t\n259\t    Returns a callable suitable for registration in\n260\t    ``dispatch.HANDLERS``. The closure captures ``subcommand`` (the MCP\n261\t    suffix) and the underlying ``cmd_*`` function name.\n262\t    \"\"\"\n263\t    if subcommand not in ALLOWED_SUBCOMMANDS:\n264\t        raise KeyError(f\"audit_query.{subcommand}: not in ALLOWED_SUBCOMMANDS\")\n265\t    cmd_fn_name = ALLOWED_SUBCOMMANDS[subcommand]\n266\t\n267\t    def handle(params: Dict[str, Any], context: Dict[str, Any]) -> Dict[str, Any]:\n268\t        \"\"\"Dispatch a single audit-query sub-command.\n269\t\n270\t        Returns:\n271\t            ``{\"subcommand\": str, \"data\": <result>}`` on success.\n272\t            ``{\"subcommand\": str, \"data\": [], \"warning\": str}`` on\n273\t            fail-open paths. NEVER raises.\n274\t        \"\"\"\n275\t        project_dir_raw = context.get(\"project_dir\")\n276\t        if project_dir_raw is None:\n277\t            return {\n278\t                \"subcommand\": subcommand,\n279\t                \"data\": [],\n280\t                \"warning\": \"project_dir_missing\",\n281\t            }\n282\t        project_dir = Path(project_dir_raw)\n283\t\n284\t        # AC-R-1 — forged-write probe at dispatcher entry.\n285\t        forged = _is_forged_write(params if isinstance(params, dict) else {})\n286\t        if forged is not None:\n287\t            return {\n288\t                \"subcommand\": subcommand,\n289\t                \"data\": [],\n290\t                \"__error__\": {\n291\t                    \"code\": -32602,\n292\t                    \"message\": f\"read_only_violation:forbidden_param:{forged}\",\n293\t                },\n294\t            }\n295\t\n296\t        module = _load_audit_query(project_dir)\n297\t        if module is None:\n298\t            return {\n299\t                \"subcommand\": subcommand,\n300\t                \"data\": [],\n301\t                \"warning\": _LOAD_ERROR or \"load_failed\",\n302\t            }\n303\t\n304\t        cmd_fn = getattr(module, cmd_fn_name, None)\n305\t        if cmd_fn is None:\n306\t            return {\n307\t                \"subcommand\": subcommand,\n308\t                \"data\": [],\n309\t                \"warning\": f\"cmd_fn_missing:{cmd_fn_name}\",\n310\t            }\n311\t\n312\t        ns = _build_namespace(params if isinstance(params, dict) else {})\n313\t\n314\t        try:\n315\t            if subcommand in _NO_ENTRIES_SUBCOMMANDS:\n316\t                # cmd_errors(args) — no entries parameter.\n317\t                result = cmd_fn(ns)\n318\t            else:\n319\t                entries = _load_entries(module, ns, project_dir)\n320\t                result = cmd_fn(entries, ns)\n321\t        except Exception as e:\n322\t            return {\n323\t                \"subcommand\": subcommand,\n324\t                \"data\": [],\n325\t                \"warning\": f\"cmd_failed:{type(e).__name__}\",\n326\t            }\n327\t\n328\t        # Coerce result to a JSON-serializable shape. cmd_* returns\n329\t        # dict | list | scalar — wrap into a uniform envelope.\n330\t        if isinstance(result, dict):\n331\t            return {\"subcommand\": subcommand, \"data\": result}\n332\t        if isinstance(result, list):\n333\t            return {\"subcommand\": subcommand, \"data\": result, \"count\": len(result)}\n334\t        return {\"subcommand\": subcommand, \"data\": result}\n335\t\n336\t    handle.__name__ = f\"handle_audit_query_{subcommand}\"\n337\t    handle.__qualname__ = handle.__name__\n338\t    return handle\n339\t"}]},"parent_tool_use_id":null,"session_id":"094f61f1-d94f-4087-9101-aa