,\n202\t    \".claude/hooks/_lib/escalation_signals.py\",\n203\t    \".claude/hooks/check_pair_rail.py\",\n204\t    \".claude/hooks/check_bash_safety.py\",\n205\t    \".claude/hooks/check_bash_canonical_forensic.py\",\n206\t    \".claude/hooks/check_codex_filewrite.py\",\n207\t    \".claude/hooks/check_codex_response.py\",\n208\t    \".claude/hooks/check_skill_bootstrap_post.py\",\n209\t    \".claude/hooks/check_skill_reference_read.py\",\n210\t    \".claude/hooks/check_read_injection.py\",\n211\t    \".claude/hooks/check_webfetch_injection.py\",\n212\t    \".claude/hooks/check_output_secrets.py\",\n213\t    \".claude/hooks/check_output_safety.py\",\n214\t    \".claude/hooks/check_mcp_response.py\",\n215\t    \".claude/hooks/check_tier_policy.py\",\n216\t    \".claude/hooks/check_tier_policy_misrouting_24h.py\",\n217\t    \".claude/hooks/check_subagent_fabrication.py\",\n218\t    \".claude/hooks/check_confidence_gate.py\",\n219\t    \".claude/hooks/check_anti_ceo_overhead.py\",\n220\t    \".claude/hooks/check_scratchpad_access.py\",\n221\t    \".claude/hooks/check_budget.py\",\n222\t    \".claude/hooks/check_fluency_nudge.py\",\n223\t    \".claude/hooks/audit_log.py\",\n224\t    \".claude/hooks/SessionStart.py\",\n225\t    \".claude/hooks/SessionEnd.py\",\n226\t    \".claude/hooks/Stop.py\",\n227\t    \".claude/hooks/UserPromptSubmit.py\",\n228\t    \".claude/hooks/emit_architect_outcome.py\",\n229\t    \".claude/tier-policy.json\",\n230\t    \".claude/tier-policy.json.sigchain\",\n231\t    \".claude/governance/governance-waivers.yaml\",\n232\t    \".claude/governance/codex-cli-pin.txt\",\n233\t    \".claude/governance/codex-cli-binary-sha256.txt\",\n234\t    # PLAN-163 T5.2 (ADR-182): the payload-pin manifest replaces the\n235\t    # launcher-hash pin above (now a comment-only tombstone, kept\n236\t    # guarded). The manifest is the runtime verify-then-invoke trust\n237\t    # root for check_pair_rail.py AND the release.yml step-15 payload\n238\t    # gate — enrol