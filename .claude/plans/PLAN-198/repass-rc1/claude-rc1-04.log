{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015SbRMYUmKEf6PPgCQRyJy2","type":"tool_result","content":"473\tdef decide_command(command: str) -> Decision:\n474\t    \"\"\"Pure decision function — no I/O, trivially unit-testable.\n475\t\n476\t    Args:\n477\t        command: The raw `tool_input.command` string.\n478\t\n479\t    Returns:\n480\t        Decision(allow=True) if no rule matches.\n481\t        Decision(allow=False, reason=...) on first rule match.\n482\t    \"\"\"\n483\t    if not command or not command.strip():\n484\t        return Decision(allow=True)\n485\t\n486\t    # Credential scan runs BEFORE tokenization — quoted keys must match.\n487\t    cred_hit = _check_credential_leak(command)\n488\t    if cred_hit is not None:\n489\t        return Decision(allow=False, reason=(\n490\t            \"GOVERNANCE: bash command contains what appears to be a live \"\n491\t            f\"API credential. Redact before executing. Pattern: {cred_hit[1]}. \"\n492\t            \"Export via env var (never inline).\"))\n493\t\n494\t    # PLAN-085 Wave E.3 — canonical-path write interceptor (heuristic v1).\n495\t    canonical_reason = _e3_check_canonical_path_write(command)\n496\t    if canonical_reason is not None:\n497\t        return Decision(allow=False, reason=canonical_reason)\n498\t\n499\t    # PLAN-165 NF-08 — posture-toggle INVOCATION guard (OQ1-redo). Not\n500\t    # `destructive=True`: this block is a governance boundary, not a\n501\t    # destructive-command class, so the ADR-175 citation gate must never be\n502\t    # able to release it.\n503\t    toggle_reason = _e4_check_posture_toggle_invocation(command)\n504\t    if toggle_reason is not None:\n505\t        return Decision(allow=False, reason=toggle_reason)\n506\t\n507\t    # PLAN-133 A1 — optional env-hijack denylist; pure decision.\n508\t    if _env_guard_enforced():\n509\t        env_hit = _check_env_hijack(command)\n510\t        if env_hit is not None:\n511\t            _hijack_class, _key, reason = env_hit\n512\t            return Decision(allow=False, reason=reason)\n513\t\n514\t    # PLAN-124 WS-1 — git bypass guard runs before destructive checks.\n515\t    git_bypass_hit = _check_git_bypass(command)\n516\t    if git_bypass_hit is not None:\n517\t        kind, _flag_class, reason = git_bypass_hit\n518\t        if kind == \"block\":\n519\t            return Decision(allow=False, reason=reason)\n520\t        # kind == \"escape\": dual-auth authorized → ALLOW (emit handled in main).\n521\t\n522\t    for subcommand in _split_subcommands(command):\n523\t        tokens = _tokenize(subcommand)\n524\t        if tokens is None:\n525\t            # PLAN-152 error-handling-01 (debate C4 + Codex R2 P2#1): shlex\n526\t            # rejected this chunk — the naive splitter broke inside quotes\n527\t            # (e.g. `rm -rf ~ \";\"`). Re-tokenize the WHOLE command and block\n528\t            # only if a real command SEGMENT is destructive; quoted text\n529\t            # like `echo \"a && rm -rf /tmp\"` re-parses to a single benign\n530\t            # `echo` segment and is allowed. CEO_BASH_RAWSCAN=0 reverts.\n531\t            if _rawscan_enabled():\n532\t                reason = _recheck_whole_command(command)\n533\t                if reason:\n534\t                    # PLAN-153.E5 / ADR-175: destructive=True — rawscan hits\n535\t                    # are the same destructive class, so they are citation-\n536\t                    # gatable (main() applies the gate off this tag).\n537\t                    return Decision(allow=False, reason=reason, destructive=True)\n538\t            continue\n539\t        if not tokens:\n540\t            continue\n541\t        for check in (\n542\t            _check_rm_rf,\n543\t            _check_git_reset_hard,\n544\t            _check_git_push_force,\n545\t        ):\n546\t            reason = check(tokens)\n547\t            if reason:\n548\t                # PLAN-135 W2 H5 — corrective rewrite for the force-push\n549\t                # pattern ONLY. When the rewrite is enabled AND the command\n550\t                # is the trivially-safe single-subcommand `git push --force`\n551\t                # pilot pattern, REWRITE → `--force-with-lease` and surface\n552\t                # an `ask` (constraint (b)) carrying the new command via\n553\t                # updatedInput, instead of a hard BLOCK. Any failure to\n554\t                # build a clean rewrite (compound command, ambiguity, etc.)\n555\t                # falls through to the existing BLOCK (constraint (a): the\n556\t                # corrective rewrite NEVER degrades a BLOCK into a silent\n557\t                # allow — Doctrine 1 corollary). All OTHER block reasons\n558\t                # (rm -rf, git reset --hard) are unaffected.\n559\t                if check is _check_git_push_force and _force_push_rewrite_enabled():\n560\t                    rewrite = _rewrite_git_push_force(command)\n561\t                    if rewrite is not None:\n562\t                        # allow=True is the contract-layer carrier; main()\n563\t                        # translates the attached Rewrite into the `ask` +\n564\t                        # updatedInput vendor shape. The permission prompt is\n565\t                        # ALWAYS retained — this is never a silent allow.\n566\t                        return Decision(allow=True, rewrite=rewrite)\n567\t                # PLAN-153.E5 / ADR-175: destructive=True marks this block as\n568\t                # citation-gatable (main() applies the gate off this tag).\n569\t                return Decision(allow=False, reason=reason, destructive=True)\n570\t\n571\t    from _lib import bash_indirect_guard as _indirect_guard\n572\t    try:\n573\t        _indirect_switch = _trusted_env.get_trusted(\"CEO_BASH_INDIRECT_GUARD\")\n574\t        _heuristic_switch = _trusted_env.get_trusted(\"CEO_BASH_INDIRECT_HEURISTICS\")\n575\t    except Exception:  # no trusted snapshot -> safety default ON\n576\t        _indirect_switch = None\n577\t        _heuristic_switch = None\n578\t    indirect_hit = None if _indirect_switch == \"0\" else _indirect_guard.scan(\n579\t        command, heuristics=_heuristic_switch != \"0\"\n580\t    )\n581\t    if indirect_hit is not None:\n582\t        _is_destructive = indirect_hit.reason_code != \"bash_computed_canonical_target\"\n583\t        return Decision(allow=False, reason=indirect_hit.reason,\n584\t                        destructive=_is_destructive, reason_code=indirect_hit.reason_code)\n585\t    return Decision(allow=True)\n586\t\n587\t\n588\tdef _to_contract_decision(\n589\t    d: \"Decision\",\n590\t    tool_input: \"Optional[Dict]\" = None,\n591\t) -> _contract.Decision:\n592\t    \"\"\"Translate local Decision → adapter-layer contract.Decision.\n593\t\n594\t    PLAN-135 W2 H5: when the Decision carries a :class:`Rewrite`, build the\n595\t    Claude Code PreToolUse `ask` + `updatedInput` vendor shape via the\n596\t    neutral contract `extra` channel (the claude adapter merges `extra`\n597\t    into the top-level JSON). The output is:\n598\t\n599\t        {\"hookSpecificOutput\": {\n600\t            \"hookEventName\": \"PreToolUse\",\n601\t            \"permissionDecision\": \"ask\",\n602\t            \"permissionDecisionReason\": \"<names the rewrite>\",\n603\t            \"updatedInput\": {<original tool_input>, \"command\": \"<rewritten>\"}\n604\t        }}\n605\t\n606\t    The ORIGINAL tool_input keys are preserved and only `command` is\n607\t    overridden (constraint (c) — we change the command, nothing else). If\n608\t    `tool_input` is not a dict, `updatedInput` carries just the rewritten\n609\t    command (the executor reads `command`).\n610\t    \"\"\"\n611\t    if d.rewrite is not None:\n612\t        rw = d.rewrite\n613\t        updated_input: Dict[str, object] = {}\n614\t        if isinstance(tool_input, dict):\n615\t            updated_input.update(tool_input)\n616\t        updated_input[\"command\"] = rw.new_command\n617\t        dec = _contract.allow()\n618\t        dec.extra[\"hookSpecificOutput\"] = {\n619\t            \"hookEventName\": \"PreToolUse\",\n620\t            \"permissionDecision\": \"ask\",\n621\t            \"permissionDecisionReason\": rw.reason,\n622\t            \"updatedInput\": updated_input,\n623\t        }\n624\t        return dec\n625\t    if d.allow:\n626\t        return _contract.allow()\n627\t    return _contract.block(d.reason or \"\")\n628\t\n629\t\n630\tdef _emit_git_hook_bypass_event(flag_class: str) -> None:\n631\t    \"\"\"Emit git_hook_bypass_blocked(flag_class). Fail-open (PLAN-124 WS-1).\n632\t\n633\t    The ONLY field is the closed-enum flag_class — NEVER the command bytes\n634\t    (MF-G). Emitted on BOTH an unauthorized block AND an authorized\n635\t    escape-hatch use (flag_class=escape_hatch_used). session_id / project are\n636\t    read from the live env (forensic envelope only; not a grant source).\n637\t    \"\"\"\n638\t    if _audit_emit is None:\n639\t        return\n640\t    try:\n641\t        import os as _os\n642\t        _audit_emit.emit_git_hook_bypass_blocked(\n643\t            flag_class=flag_class,\n644\t            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n645\t            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n646\t        )\n647\t    except Exception:  # pragma: no cover\n648\t        pass\n649\t"}]},"parent_tool_use_id":null,"session_id":"094f61f1-d94f-4087-9101-aa726795eaac","uuid":"e923a8bb-1a2f-42e9-a4cb-b82b85690c4d","timestamp":"2026-11-15T09:18:50.379Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_bash_safety_parts/posture_scan.py","content":"def decide_command(command: str) -> Decision:\n    \"\"\"Pure decision function — no I/O, trivially unit-testable.\n\n    Args:\n        command: The raw `tool_input.command` string.\n\n    Returns:\n        Decision(allow=True) if no rule matches.\n        Decision(allow=False, reason=...) on first rule match.\n    \"\"\"\n    if not command or not command.strip():\n        return Decision(allow=True)\n\n    # Credential scan runs BEFORE tokenization — quoted keys must match.\n    cred_hit = _check_credential_leak(command)\n    if cred_hit is not None:\n        return Decision(allow=False, reason=(\n            \"GOVERNANCE: bash command contains what appears to be a live \"\n            f\"API credential. Redact before executing. Pattern: {cred_hit[1]}. \"\n            \"Export via env var (never inline).\"))\n\n    # PLAN-085 Wave E.3 — canonical-path write interceptor (heuristic v1).\n    canonical_reason = _e3_check_canonical_path_write(command)\n    if canonical_reason is not None:\n        return Decision(allow=False, reason=canonical_reason)\n\n    # PLAN-165 NF-08 — posture-toggle INVOCATION guard (OQ1-redo). Not\n    # `destructive=True`: this block is a governance boundary, not a\n    # destructive-command class, so the ADR-175 citation gate must never be\n    # able to release it.\n    toggle_reason = _e4_check_posture_toggle_invocation(command)\n    if toggle_reason is not None:\n        return Decision(allow=False, reason=toggle_reason)\n\n    # PLAN-133 A1 — optional env-hijack denylist; pure decision.\n    if _env_guard_enforced():\n        env_hit = _check_env_hijack(command)\n        if env_hit is not None:\n            _hijack_class, _key, reason = env_hit\n            return Decision(allow=False, reason=reason)\n\n    # PLAN-124 WS-1 — git bypass guard runs before destructive checks.\n    git_bypass_hit = _check_git_bypass(command)\n    if git_bypass_hit is not None:\n        kind, _flag_class, reason = git_bypass_hit\n        if kind == \"block\":\n            return Decision(allow=False, reason=reason)\n        # kind == \"escape\": dual-auth authorized → ALLOW (emit handled in main).\n\n    for subcommand in _split_subcommands(command):\n        tokens = _tokenize(subcommand)\n        if tokens is None:\n            # PLAN-152 error-handling-01 (debate C4 + Codex R2 P2#1): shlex\n            # rejected this chunk — the naive splitter broke inside quotes\n            # (e.g. `rm -rf ~ \";\"`). Re-tokenize the WHOLE command and block\n            # only if a real command SEGMENT is destructive; quoted text\n            # like `echo \"a && rm -rf /tmp\"` re-parses to a single benign\n            # `echo` segment and is allowed. CEO_BASH_RAWSCAN=0 reverts.\n            if _rawscan_enabled():\n                reason = _recheck_whole_command(command)\n                if reason:\n                    # PLAN-153.E5 / ADR-175: destructive=True — rawscan hits\n                    # are the same destructive class, so they are citation-\n                    # gatable (main() applies the gate off this tag).\n                    return Decision(allow=False, reason=reason, destructive=True)\n            continue\n        if not tokens:\n            continue\n        for check in (\n            _check_rm_rf,\n            _check_git_reset_hard,\n            _check_git_push_force,\n        ):\n            reason = check(tokens)\n            if reason:\n                # PLAN-135 W2 H5 — corrective rewrite for the force-push\n                # pattern ONLY. When the rewrite is enabled AND the command\n                # is the trivially-safe single-subcommand `git push --force`\n                # pilot pattern, REWRITE → `--force-with-lease` and surface\n                # an `ask` (constraint (b)) carrying the new command via\n                # updatedInput, instead of a hard BLOCK. Any failure to\n                # build a clean rewrite (compound command, ambiguity, etc.)\n                # falls through to the existing BLOCK (constraint (a): the\n                # corrective rewrite NEVER degrades a BLOCK into a silent\n                # allow — Doctrine 1 corollary). All OTHER block reasons\n                # (rm -rf, git reset --hard) are unaffected.\n                if check is _check_git_push_force and _force_push_rewrite_enabled():\n                    rewrite = _rewrite_git_push_force(command)\n                    if rewrite is not None:\n                        # allow=True is the contract-layer carrier; main()\n                        # translates the attached Rewrite into the `ask` +\n                        # updatedInput vendor shape. The permission prompt is\n                        # ALWAYS retained — this is never a silent allow.\n                        return Decision(allow=True, rewrite=rewrite)\n                # PLAN-153.E5 / ADR-175: destructive=True marks this block as\n                # citation-gatable (main() applies the gate off this tag).\n                return Decision(allow=False, reason=reason, destructive=True)\n\n    from _lib import bash_indirect_guard as _indirect_guard\n    try:\n        _indirect_switch = _trusted_env.get_trusted(\"CEO_BASH_INDIRECT_GUARD\")\n        _heuristic_switch = _trusted_env.get_trusted(\"CEO_BASH_INDIRECT_HEURISTICS\")\n    except Exception:  # no trusted snapshot -> safety default ON\n        _indirect_switch = None\n        _heuristic_switch = None\n    indirect_hit = None if _indirect_switch == \"0\" else _indirect_guard.scan(\n        command, heuristics=_heuristic_switch != \"0\"\n    )\n    if indirect_hit is not None:\n        _is_destructive = indirect_hit.reason_code != \"bash_computed_canonical_target\"\n        return Decision(allow=False, reason=indirect_hit.reason,\n                        destructive=_is_destructive, reason_code=indirect_hit.reason_code)\n    return Decision(allow=True)\n\n\ndef _to_contract_decision(\n    d: \"Decision\",\n    tool_input: \"Optional[Dict]\" = None,\n) -> _contract.Decision:\n    \"\"\"Translate local Decision → adapter-layer contract.Decision.\n\n    PLAN-135 W2 H5: when the Decision carries a :class:`Rewrite`, build the\n    Claude Code PreToolUse `ask` + `updatedInput` vendor shape via the\n    neutral contract `extra` channel (the claude adapter merges `extra`\n    into the top-level JSON). The output is:\n\n        {\"hookSpecificOutput\": {\n            \"hookEventName\": \"PreToolUse\",\n            \"permissionDecision\": \"ask\",\n            \"permissionDecisionReason\": \"<names the rewrite>\",\n            \"updatedInput\": {<original tool_input>, \"command\": \"<rewritten>\"}\n        }}\n\n    The ORIGINAL tool_input keys are preserved and only `command` is\n    overridden (constraint (c) — we change the command, nothing else). If\n    `tool_input` is not a dict, `updatedInput` carries just the rewritten\n    command (the executor reads `command`).\n    \"\"\"\n    if d.rewrite is not None:\n        rw = d.rewrite\n        updated_input: Dict[str, object] = {}\n        if isinstance(tool_input, dict):\n            updated_input.update(tool_input)\n        updated_input[\"command\"] = rw.new_command\n        dec = _contract.allow()\n        dec.extra[\"hookSpecificOutput\"] = {\n            \"hookEventName\": \"PreToolUse\",\n            \"permissionDecision\": \"ask\",\n            \"permissionDecisionReason\": rw.reason,\n            \"updatedInput\": updated_input,\n        }\n        return dec\n    if d.allow:\n        return _contract.allow()\n    return _contract.block(d.reason or \"\")\n\n\ndef _emit_git_hook_bypass_event(flag_class: str) -> None:\n    \"\"\"Emit git_hook_bypass_blocked(flag_class). Fail-open (PLAN-124 WS-1).\n\n    The ONLY field is the closed-enum flag_class — NEVER the command bytes\n    (MF-G). Emitted on BOTH an unauthorized block AND an authorized\n    escape-hatch use (flag_class=escape_hatch_used). session_id / project are\n    read from the live env (forensic envelope only; not a grant source).\n    \"\"\"\n    if _audit_emit is None:\n        return\n    try:\n        import os as _os\n        _audit_emit.emit_git_hook_bypass_blocked(\n            flag_class=flag_class,\n            session_id=_os.environ