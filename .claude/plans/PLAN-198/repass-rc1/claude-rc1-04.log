{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MHpVqawF3XHvXKybN7Zuyb","type":"tool_result","content":"363\tdef _sanitize_prompt(prompt: str) -> Optional[str]:\n364\t    \"\"\"PLAN-065 Phase 1 / Sec MF-7 — NFKC normalize + NUL-strip + length cap.\n365\t\n366\t    Returns the safe text for regex scanning, or None if rejected. Never\n367\t    raises. Mirrors ``extract-skill.py._sanitize`` pre-regex hardening.\n368\t\n369\t    Rejections:\n370\t    - non-string inputs (defense-in-depth)\n371\t    - empty / whitespace-only\n372\t    - over ``_MAX_INPUT_CHARS`` code points or ``_MAX_INPUT_BYTES`` UTF-8\n373\t    - NUL byte present (post-NFKC)\n374\t    \"\"\"\n375\t    if not isinstance(prompt, str):\n376\t        return None\n377\t    if not prompt or not prompt.strip():\n378\t        return None\n379\t    if len(prompt) > _MAX_INPUT_CHARS:\n380\t        return None\n381\t    # NFKC normalize first — homoglyph defense (Cyrillic 'о' U+043E → 'o' folds\n382\t    # under NFKC so Cyrillic-only homoglyphs that LOOK like 'o' survive as\n383\t    # distinct code-points, then the validator's strict ASCII charset rejects).\n384\t    normalized = unicodedata.normalize(\"NFKC\", prompt)\n385\t    if \"\\x00\" in normalized:\n386\t        return None\n387\t    if len(normalized.encode(\"utf-8\", errors=\"replace\")) > _MAX_INPUT_BYTES:\n388\t        return None\n389\t    return normalized\n390\t\n391\t\n392\tdef _validate_skill_name(name: str) -> bool:\n393\t    \"\"\"Defense-in-depth: re-validate captured skill name post-extract.\n394\t\n395\t    Even though each path's regex already bounds the captured group, we\n396\t    re-validate here so a future grammar drift cannot smuggle a\n397\t    pathological name out via a regex edge case.\n398\t\n399\t    Path-traversal patterns are denied here: the captured-group grammars\n400\t    exclude ``/`` ``..`` ``\\\\`` already, but we add an explicit anchor.\n401\t    \"\"\"\n402\t    if not name or len(name) > _MAX_SKILL_NAME_CHARS:\n403\t        return False\n404\t    if \"/\" in name or \"..\" in name or \"\\\\\" in name:\n405\t        return False\n406\t    if not _SKILL_NAME_CHARSET_RE.match(name):\n407\t        return False\n408\t    return True\n409\t\n410\t\n411\tdef _path_d_lookup(subagent_type: str) -> str:\n412\t    \"\"\"PLAN-079 Path D — resolve subagent_type to canonical skill name.\n413\t\n414\t    Returns the mapped skill if subagent_type is one of the 5 canonical\n415\t    archetypes (``code-reviewer``, ``security-engineer``, ``qa-architect``,\n416\t    ``performance-engineer``, ``devops``); otherwise returns ``\"unknown\"``.\n417\t\n418\t    Normalization: ``strip().lower()`` is applied to mirror the\n419\t    archetype-routing precedent in ``check_agent_spawn.py:204``\n420\t    (``_extract_archetype_from_payload``). Case-fold is intentional —\n421\t    Agent-tool emitters may pass mixed case for the same archetype.\n422\t\n423\t    Defense-in-depth (Sec MF-7):\n424\t    - Non-string input rejected (``isinstance(subagent_type, str)``)\n425\t    - Raw input length capped at 80 chars BEFORE normalize to bound\n426\t      strip/lower allocation cost on the hot audit-hook path (Codex\n427\t      G23-04)\n428\t    - Post-normalize charset enforced via ``_ARCHETYPE_NAME_RE.fullmatch``\n429\t      (anchored both ends) — slash, dot-traversal, NUL, unicode rejected\n430\t\n431\t    Never raises.\n432\t    \"\"\"\n433\t    if not isinstance(subagent_type, str):\n434\t        return \"unknown\"\n435\t    # G23-04: bound raw length before allocating strip/lower copy.\n436\t    # 80 leaves headroom for whitespace + 64-char post-normalize cap.\n437\t    if len(subagent_type) > 80:\n438\t        return \"unknown\"\n439\t    name = subagent_type.strip().lower()\n440\t    if not _ARCHETYPE_NAME_RE.fullmatch(name):\n441\t        return \"unknown\"\n442\t    return _ARCHETYPE_TO_SKILL.get(name, \"unknown\")\n443\t\n444\t\n445\tdef extract_skill(prompt: str, subagent_type: str = \"\") -> str:\n446\t    \"\"\"Return the skill name extracted from a spawn prompt, or 'unknown'.\n447\t"}]},"parent_tool_use_id":null,"session_id":"b95297ab-5d0d-413e-87dc-83b93d304a3d","uuid":"8c638ffa-1357-4f70-b95b-8878ccf09ae3","timestamp":"2026-11-13T16:33:08.586Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/audit_log.py","content":"def _sanitize_prompt(prompt: str) -> Optional[str]:\n    \"\"\"PLAN-065 Phase 1 / Sec MF-7 — NFKC normalize + NUL-strip + length cap.\n\n    Returns the safe text for regex scanning, or None if rejected. Never\n    raises. Mirrors ``extract-skill.py._sanitize`` pre-regex hardening.\n\n    Rejections:\n    - non-string inputs (defense-in-depth)\n    - empty / whitespace-only\n    - over ``_MAX_INPUT_CHARS`` code points or ``_MAX_INPUT_BYTES`` UTF-8\n    - NUL byte present (post-NFKC)\n    \"\"\"\n    if not isinstance(prompt, str):\n        return None\n    if not prompt or not prompt.strip():\n        return None\n    if len(prompt) > _MAX_INPUT_CHARS:\n        return None\n    # NFKC normalize first — homoglyph defense (Cyrillic 'о' U+043E → 'o' folds\n    # under NFKC so Cyrillic-only homoglyphs that LOOK like 'o' survive as\n    # distinct code-points, then the validator's strict ASCII charset rejects).\n    normalized = unicodedata.normalize(\"NFKC\", prompt)\n    if \"\\x00\" in normalized:\n        return None\n    if len(normalized.encode(\"utf-8\", errors=\"replace\")) > _MAX_INPUT_BYTES:\n        return None\n    return normalized\n\n\ndef _validate_skill_name(name: str) -> bool:\n    \"\"\"Defense-in-depth: re-validate captured skill name post-extract.\n\n    Even though each path's regex already bounds the captured group, we\n    re-validate here so a future grammar drift cannot smuggle a\n    pathological name out via a regex edge case.\n\n    Path-traversal patterns are denied here: the captured-group grammars\n    exclude ``/`` ``..`` ``\\\\`` already, but we add an explicit anchor.\n    \"\"\"\n    if not name or len(name) > _MAX_SKILL_NAME_CHARS:\n        return False\n    if \"/\" in name or \"..\" in name or \"\\\\\" in name:\n        return False\n    if not _SKILL_NAME_CHARSET_RE.match(name):\n        return False\n    return True\n\n\ndef _path_d_lookup(subagent_type: str) -> str:\n    \"\"\"PLAN-079 Path D — resolve subagent_type to canonical skill name.\n\n    Returns the mapped skill if subagent_type is one of the 5 canonical\n    archetypes (``code-reviewer``, ``security-engineer``, ``qa-architect``,\n    ``performance-engineer``, ``devops``); otherwise returns ``\"unknown\"``.\n\n    Normalization: ``strip().lower()`` is applied to mirror the\n    archetype-routing precedent in ``check_agent_spawn.py:204``\n    (``_extract_archetype_from_payload``). Case-fold is intentional —\n    Agent-tool emitters may pass mixed case for the same archetype.\n\n    Defense-in-depth (Sec MF-7):\n    - Non-string input rejected (``isinstance(subagent_type, str)``)\n    - Raw input length capped at 80 chars BEFORE normalize to bound\n      strip/lower allocation cost on the hot audit-hook path (Codex\n      G23-04)\n    - Post-normalize charset enforced via ``_ARCHETYPE_NAME_RE.fullmatch``\n      (anchored both ends) — slash, dot-traversal, NUL, unicode rejected\n\n    Never raises.\n    \"\"\"\n    if not isinstance(subagent_type, str):\n        return \"unknown\"\n    # G23-04: bound raw length before allocating strip/lower copy.\n    # 80 leaves headroom for whitespace + 64-char post-normalize cap.\n    if len(subagent_type) > 80:\n        return \"unknown\"\n    name = subagent_type.strip().lower()\n    if not _ARCHETYPE_NAME_RE.fullmatch(name):\n        return \"unknown\"\n    return _ARCHETYPE_TO_SKILL.get(name, \"unknown\")\n\n\ndef extract_skill(prompt: str, subagent_type: str = \"\") -> str:\n    \"\"\"Return the skill name extracted from a spawn prompt, or 'unknown'.\n","numLines":85,"startLine":363,"totalLines":1616}},"tool_result_meta":[{"id":"toolu_01MHpVqawF3XHvXKybN7Zuyb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
