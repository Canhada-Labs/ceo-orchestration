{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QBN7XqdzCvVYqwymRMbH8H","type":"tool_result","content":"1803\tdef _apply_fact_gate(\n1804\t    decision: \"Decision\",\n1805\t    command: str,\n1806\t    transcript_path: str,\n1807\t    now_fn=None,\n1808\t) -> \"tuple\":\n1809\t    \"\"\"Apply the PLAN-154 deny-once fact gate to a DESTRUCTIVE block.\n1810\t\n1811\t    Called from main() ONLY on the already-matched rare path\n1812\t    (``not decision.allow and decision.destructive``). Returns\n1813\t    ``(decision, enforce_active)`` — when ``enforce_active`` is True the\n1814\t    caller must SKIP the ADR-175 pilot gate (deny-once owns the outcome).\n1815\t\n1816\t    ``now_fn`` is the injectable clock seam (A9; wall clock only as the\n1817\t    default) — timestamps are used solely for record eviction ordering.\n1818\t\n1819\t    INFRASTRUCTURE exceptions return the incoming decision unchanged\n1820\t    (which on this path is already a BLOCK) with ``enforce_active=False``;\n1821\t    the INPUT side (citation verification) stays fail-CLOSED inside\n1822\t    `_verify_destructive_citation`.\n1823\t    \"\"\"\n1824\t    try:\n1825\t        enforce_enabled, source = _fact_gate_enforce_state()\n1826\t        shadow_enabled = _fact_gate_shadow_enabled()\n1827\t        if not enforce_enabled and not shadow_enabled:\n1828\t            return (decision, False)  # structurally off — zero delta\n1829\t        import os as _os\n1830\t        import time as _time\n1831\t        now = (now_fn or _time.time)()\n1832\t        session_id = _os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n1833\t        state_path = _fact_gate_state_path(session_id)\n1834\t\n1835\t        emit_activation = None  # type: Optional[bool]\n1836\t        emit_disabled_breadcrumb = False\n1837\t        cite_status = \"absent\"\n1838\t        source_class = \"\"\n1839\t        verify_detail = \"\"\n1840\t        prior = False\n1841\t        command_sha = \"\"\n1842\t\n1843\t        with _FactGateLock(state_path):\n1844\t            state = _fact_gate_load(state_path)\n1845\t            records = state.setdefault(\"records\", {})\n1846\t            flags = state.setdefault(\"flags\", {})\n1847\t\n1848\t            # (e) lazy activation-change detection → governance event.\n1849\t            last = state.get(\"enforce_state\")\n1850\t            last_enabled = bool(last.get(\"enabled\")) if isinstance(last, dict) else False\n1851\t            if last_enabled != enforce_enabled:\n1852\t                emit_activation = enforce_enabled\n1853\t            state[\"enforce_state\"] = {\"enabled\": enforce_enabled, \"source\": source}\n1854\t\n1855\t            # (A12) once-per-session disabled breadcrumb: an explicit env\n1856\t            # emergency-off suppressed an otherwise-armed enforce flip.\n1857\t            if (\n1858\t                not enforce_enabled\n1859\t                and source == \"env_emergency_off\"\n1860\t                and not flags.get(\"disabled_breadcrumb\")\n1861\t            ):\n1862\t                emit_disabled_breadcrumb = True\n1863\t                flags[\"disabled_breadcrumb\"] = True\n1864\t\n1865\t            normalized = _fact_gate_normalize(command)\n1866\t            if normalized is None:\n1867\t                # Unparseable command: no stable hash → never releasable\n1868\t                # (fail-CLOSED). Persist the observed enforce state only.\n1869\t                _fact_gate_save(state_path, state)\n1870\t                if emit_activation is not None:\n1871\t                    _emit_fact_gate_activation_changed(emit_activation, source)\n1872\t                if emit_disabled_breadcrumb:\n1873\t                    _emit_learning_rail_disabled(\"fact_gate\", _FACT_GATE_ENFORCE_VAR)\n1874\t                return (decision, enforce_enabled)\n1875\t\n1876\t            command_sha = hashlib.sha256(\n1877\t                normalized.encode(\"utf-8\")\n1878\t            ).hexdigest()\n1879\t            prior = command_sha in records\n1880\t\n1881\t            status, src_or_detail, cited = _extract_destructive_citation(command)\n1882\t            if status in (\"absent\", \"malformed\"):\n1883\t                cite_status = status\n1884\t                verify_detail = src_or_detail\n1885\t            else:\n1886\t                cite_status = \"unverified\"\n1887\t                # Verification I/O runs ONLY when release is possible:\n1888\t                # well-formed citation AND a prior deny record (item 6c).\n1889\t                if prior:\n1890\t                    ok, verify_detail, source_class = _verify_destructive_citation(\n1891\t                        src_or_detail, cited, transcript_path\n1892\t                    )\n1893\t                    cite_status = \"verified\" if ok else \"verify_failed\"\n1894\t\n1895\t            if enforce_enabled and cite_status == \"verified\":\n1896\t                rec = records.get(command_sha)\n1897\t                if not isinstance(rec, dict):  # pragma: no cover — prior implies dict\n1898\t                    rec = {\"first_denied_s\": now, \"denials\": 0}\n1899\t                rec[\"released\"] = True\n1900\t                rec[\"releases\"] = int(rec.get(\"releases\", 0)) + 1\n1901\t                records[command_sha] = rec\n1902\t                _fact_gate_save(state_path, state)\n1903\t            elif enforce_enabled or cite_status != \"verified\":\n1904\t                # Deny (enforce) or would-deny (shadow): record the hash so\n1905\t                # an exact retry can release / be measured.\n1906\t                rec = records.get(command_sha)\n1907\t                if not isinstance(rec, dict):\n1908\t                    rec = {\"first_denied_s\": now, \"denials\": 0, \"released\": False}\n1909\t                rec[\"denials\"] = int(rec.get(\"denials\", 0)) + 1\n1910\t                records[command_sha] = rec\n1911\t                _fact_gate_evict(records)\n1912\t                _fact_gate_save(state_path, state)\n1913\t            else:\n1914\t                # shadow would-release: state unchanged beyond enforce_state.\n1915\t                _fact_gate_save(state_path, state)\n1916\t\n1917\t        # --- emits + decision shaping happen OUTSIDE the lock ---------\n1918\t        if emit_activation is not None:\n1919\t            _emit_fact_gate_activation_changed(emit_activation, source)\n1920\t        if emit_disabled_breadcrumb:\n1921\t            _emit_learning_rail_disabled(\"fact_gate\", _FACT_GATE_ENFORCE_VAR)\n1922\t"}]},"parent_tool_use_id":null,"session_id":"094f61f1-d94f-4087-9101-aa726795eaac","uuid":"9fbaab37-7d2c-455c-8037-b4db2d4c6bc7","timestamp":"2026-11-15T09:18:30.539Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/plans/PLAN-182/staged-w1/tree/.claude/hooks/check_bash_safety.py","content":"def _apply_fact_gate(\n    decision: \"Decision\",\n    command: str,\n    transcript_path: str,\n    now_fn=None,\n) -> \"tuple\":\n    \"\"\"Apply the PLAN-154 deny-once fact gate to a DESTRUCTIVE block.\n\n    Called from main() ONLY on the already-matched rare path\n    (``not decision.allow and decision.destructive``). Returns\n    ``(decision, enforce_active)`` — when ``enforce_active`` is True the\n    caller must SKIP the ADR-175 pilot gate (deny-once owns the outcome).\n\n    ``now_fn`` is the injectable clock seam (A9; wall clock only as the\n    default) — timestamps are used solely for record eviction ordering.\n\n    INFRASTRUCTURE exceptions return the incoming decision unchanged\n    (which on this path is already a BLOCK) with ``enforce_active=False``;\n    the INPUT side (citation verification) stays fail-CLOSED inside\n    `_verify_destructive_citation`.\n    \"\"\"\n    try:\n        enforce_enabled, source = _fact_gate_enforce_state()\n        shadow_enabled = _fact_gate_shadow_enabled()\n        if not enforce_enabled and not shadow_enabled:\n            return (decision, False)  # structurally off — zero delta\n        import os as _os\n        import time as _time\n        now = (now_fn or _time.time)()\n        session_id = _os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n        state_path = _fact_gate_state_path(session_id)\n\n        emit_activation = None  # type: Optional[bool]\n        emit_disabled_breadcrumb = False\n        cite_status = \"absent\"\n        source_class = \"\"\n        verify_detail = \"\"\n        prior = False\n        command_sha = \"\"\n\n        with _FactGateLock(state_path):\n            state = _fact_gate_load(state_path)\n            records = state.setdefault(\"records\", {})\n            flags = state.setdefault(\"flags\", {})\n\n            # (e) lazy activation-change detection → governance event.\n            last = state.get(\"enforce_state\")\n            last_enabled = bool(last.get(\"enabled\")) if isinstance(last, dict) else False\n            if last_enabled != enforce_enabled:\n                emit_activation = enforce_enabled\n            state[\"enforce_state\"] = {\"enabled\": enforce_enabled, \"source\": source}\n\n            # (A12) once-per-session disabled breadcrumb: an explicit env\n            # emergency-off suppressed an otherwise-armed enforce flip.\n            if (\n                not enforce_enabled\n                and source == \"env_emergency_off\"\n                and not flags.get(\"disabled_breadcrumb\")\n            ):\n                emit_disabled_breadcrumb = True\n                flags[\"disabled_breadcrumb\"] = True\n\n            normalized = _fact_gate_normalize(command)\n            if normalized is None:\n                # Unparseable command: no stable hash → never releasable\n                # (fail-CLOSED). Persist the observed enforce state only.\n                _fact_gate_save(state_path, state)\n                if emit_activation is not None:\n                    _emit_fact_gate_activation_changed(emit_activation, source)\n                if emit_disabled_breadcrumb:\n                    _emit_learning_rail_disabled(\"fact_gate\", _FACT_GATE_ENFORCE_VAR)\n                return (decision, enforce_enabled)\n\n            command_sha = hashlib.sha256(\n                normalized.encode(\"utf-8\")\n            ).hexdigest()\n            prior = command_sha in records\n\n            status, src_or_detail, cited = _extract_destructive_citation(command)\n            if status in (\"absent\", \"malformed\"):\n                cite_status = status\n                verify_detail = src_or_detail\n            else:\n                cite_status = \"unverified\"\n                # Verification I/O runs ONLY when release is possible:\n                # well-formed citation AND a prior deny record (item 6c).\n                if prior:\n                    ok, verify_detail, source_class = _verify_destructive_citation(\n                        src_or_detail, cited, transcript_path\n                    )\n                    cite_status = \"verified\" if ok else \"verify_failed\"\n\n            if enforce_enabled and cite_status == \"verified\":\n                rec = records.get(command_sha)\n                if not isinstance(rec, dict):  # pragma: no cover — prior implies dict\n                    rec = {\"first_denied_s\": now, \"denials\": 0}\n                rec[\"released\"] = True\n                rec[\"releases\"] = int(rec.get(\"releases\", 0)) + 1\n                records[command_sha] = rec\n                _fact_gate_save(state_path, state)\n            elif enforce_enabled or cite_status != \"verified\":\n                # Deny (enforce) or would-deny (shadow): record the hash so\n                # an exact retry can release / be measured.\n                rec = records.get(command_sha)\n                if not isinstance(rec, dict):\n                    rec = {\"first_denied_s\": now, \"denials\": 0, \"released\": False}\n                rec[\"denials\"] = int(rec.get(\"denials\", 0)) + 1\n                records[command_sha] = rec\n                _fact_gate_evict(records)\n                _fact_gate_save(state_path, state)\n            else:\n                # shadow would-release: state unchanged beyond enforce_state.\n                _fact_gate_save(state_path, state)\n\n        # --- emits + decision shaping happen OUTSIDE the lock ---------\n        if emit_activation is not None:\n            _emit_fact_gate_activation_changed(emit_activation, source)\n        if emit_disabled_breadcrumb:\n            _emit_learning_rail_disabled(\"fact_gate\", _FACT_GATE_ENFORCE_VAR)\n","numLines":120,"startLine":1803,"totalLines":4238}},"tool_result_meta":[{"id":"toolu_01QBN7XqdzCvVYqwymRMbH8H","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
