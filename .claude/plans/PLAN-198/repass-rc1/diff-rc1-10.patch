+_MAX_RESPONSE_BYTES = 4 * 1024 * 1024  # 4 MiB
+
+_MAX_RESPONSE_LINES = 200_000
+
+_MAX_OUTPUT_FILE_BYTES: int = 1 * 1024 * 1024  # 1 MiB
