ude/hooks/_lib/_bash_safety_parts/normalization.py-376-    for t in tokens[1:]:\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-377-        if not t.startswith(\"-\"):\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-378-            continue  # positional argument\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-379-        if t.startswith(\"--\"):\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-380-            # Long option: match exact names (+ optional =value tail).\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-381-            # The ``=value`` form on ``--recursive``/``--force`` is NON-\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-382-            # STANDARD for POSIX ``rm`` (which treats both as boolean\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-383-            # flags). Security-first interpretation: if someone types\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-384-            # ``--recursive=<value>`` they are almost certainly probing\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-385-            # the parser; treat the equals-form on destructive flags as\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-386-            # implying BOTH ``-r`` and ``-f`` (defensive fail-closed).\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-387-            # See PLAN-019 P0-01 live-verification vector\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-388-            # ``rm --recursive=true /tmp``.\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-389-            has_eq = \"=\" in t\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-390-            name = t[2:].split(\"=\", 1)[0].lower()\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-391-            if name in (\"recursive\", \"r\"):\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-392-                has_r = True\n.claude/hooks/_lib/_bash_safety_parts/normalization.py-393-                if has_eq: