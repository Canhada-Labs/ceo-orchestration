dact_secrets` — fail-\n78\t         CLOSED to empty string if redactor not importable.\n79\t      2. Overlap scrub: any contiguous substring of length >=8 chars\n80\t         that also appears in `claim_args` is replaced with\n81\t         `<redacted>` (catches r.detail echoing r.claim.args).\n82\t      3. NFKC normalize + clip to 64 chars.\n83\t    \"\"\"\n84\t    try:\n85\t        from _lib.redact import redact_secrets as _redact\n86\t        s = _redact(str(raw or \"\"))\n87\t    except Exception:\n88\t        # Fail-CLOSED on missing redactor.\n89\t        return \"\"\n90\t    ca = str(claim_args or \"\")\n91\t    if ca:\n92\t        for i in range(0, max(0, len(ca) - 8 + 1)):\n93\t            window = ca[i:i + 8]\n94\t            if window in s:\n95\t                s = s.replace(window, \"<redacted>\")\n96\t    import unicodedata\n97\t    return unicodedata.normalize(\"NFKC\", s)[:64]\n98\t\n99\t\n100\t_CLAIM_EMITTED_ALLOWLIST = frozenset({\n101\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n102\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n103\t    \"hmac\", \"hmac_error\",\n104\t    \"claim_id\", \"claim_type\", \"severity\",\n105\t    \"verifier_kind\", \"agent_name\", \"source\",\n106\t    \"line_num\", \"payload_hash\",\n107\t    \"kind_supported\",\n108\t})\n109\t\n110\t"}]},"parent_tool_use_id":null,"session_id":"34b005ba-8b89-4e2d-a38f-79b02c6d7b54","uuid":"1b65d939-c0dd-48b7-b71c-eccfaa1e7c19","timestamp":"2026-11-13T17:24:31.180Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/confidence.py","content":"\"\"\"Confidence.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('_safe_claim_id_hash', '_safe_payload_hash', '_safe_verifier_outcome', '_CLAIM_EMITTED_ALLOWLIST', '_CONFIDENCE_GATE_VERDICT_ALLOWLIST', '_CO