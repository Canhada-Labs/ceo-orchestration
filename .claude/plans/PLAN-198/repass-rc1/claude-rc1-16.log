{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UAgQ1d3Krm5QpKJ11s3c14","type":"tool_result","content":"1\t\"\"\"Audit action registrations; combined by schemas_actions.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t_ACTIONS = {\n5\t    \"goap_search_aborted\",\n6\t    \"goap_search_summary\",\n7\t    \"goap_cycle_detected\",\n8\t    \"goap_depth_exceeded\",\n9\t    \"goap_replan_triggered\",\n10\t    \"goap_replan_exhausted\",\n11\t    \"goap_disabled_by_env\",\n12\t    \"goap_recommendation_accepted\",\n13\t    # PLAN-105 Wave A.1 + A.2 — GOAP recommendation outcome telemetry.\n14\t    \"goap_recommendation_rendered\",\n15\t    \"goap_recommendation_overridden\",\n16\t    # PLAN-099 (ADR-129 / ADR-135) — federation cross-machine MVP audit surface.\n17\t    \"federation_connection_accepted\",\n18\t    \"federation_connection_rejected\",\n19\t    \"federation_connection_replay_suspected\",\n20\t    \"federation_cert_expiry_warned\",\n21\t    \"federation_cert_rotated\",\n22\t    \"federation_cert_revoked\",\n23\t    \"federation_write_attempt_blocked\",\n24\t    \"federation_lan_bind_denied\",\n25\t    \"federation_autonomous_call_blocked\",\n26\t    \"federation_enable_sentinel_invalid\",\n27\t    # PLAN-099-FOLLOWUP Wave F — federation write-mode audit surface\n28\t    # (ADR-129-AMEND-1 / ADR-135-AMEND-1 / attack-rebinding.md §2).\n29\t    # 20 actions touched; +19 net-new (federation_cert_rotated already\n30\t    # in set from PLAN-099 MVP S134, field-shape-superseded in-place).\n31\t    # Registered via kernel-override\n32\t    # PLAN-099-FOLLOWUP-WAVE-F-AUDIT-EMIT-EXTENSION at v1.39.1.\n33\t    \"federation_audit_event_pushed\",\n34\t    \"federation_audit_event_pushed_batch\",\n35\t    \"federation_audit_log_backpressure\",\n36\t    \"federation_cert_validity_window_too_large\",\n37\t    \"federation_event_action_blocked\",\n38\t    \"federation_hmac_secret_rotated\",\n39\t    \"federation_key_floor_rejected\",\n40\t    \"federation_key_floor_stale\",\n41\t    \"federation_message_storm_detected\",\n42\t    \"federation_peer_invalid_no_fingerprint\",\n43\t    \"federation_peer_registered\",\n44\t    \"federation_peer_registered_collision\",\n45\t    \"federation_peer_revoked_remote\",\n46\t    \"federation_pin_legacy_used\",\n47\t    \"federation_scope_denied\",\n48\t    \"federation_spki_fingerprint_mismatch\",\n49\t    \"federation_tamper_detected\",\n50\t    \"federation_write_disabled_sentinel_invalid\",\n51\t    \"federation_write_endpoint_denied\",\n52\t    \"federation_peer_list_reloaded\",\n53\t    # PLAN-104 Wave A — persona-demand ledger audit surface (S134 R2 ACCEPT).\n54\t    \"persona_demand_opened\",\n55\t    \"persona_demand_matched\",\n56\t    \"persona_demand_unmet\",\n57\t    \"persona_demand_waived\",\n58\t    # PLAN-090-FOLLOWUP Wave A — claim producer pair (S138 R2 ACCEPT).\n59\t    \"claim_emitted\",\n60\t    \"confidence_gate_verdict\",\n61\t    # PLAN-100 Wave B — per-class block-mode (S139 R2 ACCEPT;\n62\t    # ADR-019-AMEND-1 PROPOSED). confidence_gate_blocked emitted when\n63\t    # decision.action == \"block\"; confidence_gate_fp_drift_detected\n64\t    # emitted by check-confidence-gate-drift.py on 7d rolling FPR > 2%.\n65\t    \"confidence_gate_blocked\",\n66\t    \"confidence_gate_fp_drift_detected\",\n67\t    # PLAN-106 Wave C — persona-coverage 4×4 cell emit from production\n68\t    # hooks (check_agent_spawn allow path + check_canonical_edit allow\n69\t    # path). Source field carries `dispatch` | `canonical_edit` for\n70\t    # downstream attribution. NO public typed wrapper — emit_generic +\n71\t    # Sec MF-3 scrub keeps `_EXPECTED_PUBLIC_SYMBOLS` stable per\n72\t    # PLAN-102 Wave A precedent (S142 R2 iter-1 P1 #3 fold).\n73\t    \"persona_coverage_synthesized\",\n74\t    # PLAN-110 Wave D — protocol_semver_cascade advisory hook\n75\t    \"protocol_edit_missing_amend_paired\",\n76\t    # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — chain_reset_marker is\n77\t    # the synthetic genesis entry written as line 1 of every rotation-\n78\t    # created fresh audit-log.jsonl. Per ADR-055-AMEND-2 (drafted in\n79\t    # this plan): verifier reads `audit-log.rotation-manifest.json`\n80\t    # sidecar; if present, line 1 of fresh log MUST be a\n81\t    # chain_reset_marker entry — non-marker line 1 = STATUS_TAMPER.\n82\t    # Registered via kernel-override\n83\t    # PLAN-112-FOLLOWUP-WAVE-B3-AUDIT-EMIT-EXTENSION at v1.39.4.\n84\t    \"chain_reset_marker\",\n85\t    # PLAN-118 AC-B5 — closed-enum producer-pollution forensic breadcrumb.\n86\t    # Emitted by chokepoint 1 (audit_emit._emit_chain_reset_marker_under_lock)\n87\t    # + chokepoint 4 (spool_writer._phase4_build_batch) when the canonical-\n88\t    # resolution check (audit_hmac._ensure_canonical_lib_modules) detects\n89\t    # a stale `_lib` copy on sys.path. Allowlist payload: chokepoint\n90\t    # (enum: chain_reset_marker | spool_drain) + reason_code (enum:\n91\t    # audit_emit_path_pollution | canonical_json_path_pollution |\n92\t    # audit_hmac_path_pollution) + path_sha256_prefix (8 hex chars) +\n93\t    # expected_canonical_prefix (8 hex chars). NO `__file__` raw echo\n94\t    # per [[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]].\n95\t    \"audit_producer_path_pollution_detected\",\n96\t    # PLAN-125 WS-1 (kooky-harvest) — per-tool-call lifecycle telemetry.\n97\t    # Deny-by-default: routes through the dedicated _scrub_ branch +\n98\t    # _TOOL_CALL_LIFECYCLE_RECORDED_ALLOWLIST below, NEVER\n99\t    # _EMIT_GENERIC_PASSTHROUGH (Sec MF-SEC-2). Carries ONLY 4 closed fields:\n100\t    # tool_name_enum (mcp__* → mcp_other, Sec MF-SEC-1), duration_bucket\n101\t    # (coarse enum, never raw duration_ms, Sec MF-SEC-3), success, orphan.\n102\t    \"tool_call_lifecycle_recorded\",\n103\t    # PLAN-124 WS-1 (ECC value-harvest) — git hook-bypass guard breadcrumb.\n104\t    # Deny-by-default: routes through the dedicated _scrub_ branch +\n105\t    # _GIT_HOOK_BYPASS_BLOCKED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n106\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n107\t    # The ONLY caller-supplied field is `flag_class` (closed enum, MF-G); the\n108\t    # matched command bytes are NEVER persisted (a malicious flag value such as\n109\t    # `-c http.extraHeader=\"Bearer <secret>\"` could otherwise leak).\n110\t    \"git_hook_bypass_blocked\",\n111\t    # PLAN-133 A1 — linker/loader/runtime env-hijack denylist breadcrumb.\n112\t    # Deny-by-default: routes through the dedicated _scrub_ branch +\n113\t    # _ENV_VAR_HIJACK_BLOCKED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n114\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n115\t    # The ONLY caller-supplied field is `hijack_class` (closed enum); the matched\n116\t    # variable NAME and the assigned VALUE are NEVER persisted (the value can be\n117\t    # a path/preload payload or a smuggled secret).\n118\t    \"env_var_hijack_blocked\",\n119\t    # PLAN-133 A3 — egress-destination taxonomy breadcrumb (advisory). Routes\n120\t    # through the dedicated _scrub_ branch + _EGRESS_DESTINATION_DETECTED_ALLOWLIST\n121\t    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n122\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The ONLY\n123\t    # caller-supplied fields are `egress_class` (closed enum) + `destination`\n124\t    # (BARE HOST only — never the full URL/path/query/credential).\n125\t    \"egress_destination_detected\",\n126\t    # PLAN-133 E1 — adversary local-rules deny/ask gate breadcrumb. Deny-by-default:\n127\t    # routes through the dedicated _scrub_ branch + _ADVERSARY_REVIEW_FLAGGED_ALLOWLIST\n128\t    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n129\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The ONLY\n130\t    # caller-supplied fields are `decision` + `rule_class` (both closed enums) and\n131\t    # `rule_id` (author-controlled config token). The matched COMMAND bytes and any\n132\t    # env value are NEVER persisted.\n133\t    \"adversary_review_flagged\",\n134\t    # PLAN-133 G1 — MOIM persistent-instructions BLOCKING validator breadcrumb.\n135\t    # Deny-by-default: routes through the dedicated _scrub_ branch +\n136\t    # _PERSISTENT_INSTRUCTIONS_BLOCKED_ALLOWLIST below, NEVER\n137\t    # _EMIT_GENERIC_PASSTHROUGH\n138\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The\n139\t    # ONLY caller-supplied fields are `reason` (closed enum) + integer counts\n140\t    # `family_hits`/`bytes_scanned`. The instruction-file body, the matched\n141\t    # line, and any path/env value are NEVER persisted.\n142\t    \"persistent_instructions_blocked\",\n143\t    # PLAN-133 G3 — hierarchical nested .claude/hints.md provenance breadcrumb.\n144\t    # Deny-by-default: routes through the dedicated _scrub_ branch +\n145\t    # _HINT_PROVENANCE_RECORDED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n146\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The\n147\t    # ONLY caller-supplied fields are `reason` (closed enum) + integer\n148\t    # `rel_dir_depth` / `family_hits` / `bytes_scanned`. The hint-file body, the\n149\t    # matched line, and the absolute/relative PATH text are NEVER persisted —\n150\t    # only the integer directory DEPTH below the repo root.\n151\t    \"hint_provenance_recorded\",\n152\t    # PLAN-135 W1 S3 — /ceo-boot Tier-S settings/env tamper tripwire\n153\t    # breadcrumb (one emit per detected tamper class). Deny-by-default:\n154\t    # routes through the dedicated _scrub_ branch +\n155\t    # _SETTINGS_TAMPER_DETECTED_ALLOWLIST below, NEVER\n156\t    # _EMIT_GENERIC_PASSTHROUGH\n157\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n158\t    # The ONLY caller-supplied fields are `tamper_class` + `layer` (both\n159\t    # closed enums mirroring _lib/effective_config; coerced to \"other\" on\n160\t    # a miss) and integer `finding_count` (clamped 0..99). The tamper\n161\t    # finding DETAIL (endpoint URL / model id / helper path / flag value)\n162\t    # and any env VALUE are NEVER persisted.\n163\t    \"settings_tamper_detected\",\n164\t    # PLAN-135 W2 H2 — ConfigChange guard: a settings-surface config change\n165\t    # was observed and NO forbidden-key finding was scoped to it (allow +\n166\t    # audit path of check_config_change.py). Deny-by-default: routes through\n167\t    # the dedicated _scrub_ branch + _CONFIG_CHANGE_OBSERVED_ALLOWLIST\n168\t    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n169\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n170\t    # The ONLY caller-supplied field is `layer` (closed enum\n171\t    # user/project/local/managed/other; coerced to \"other\" on a miss). The\n172\t    # changed file's CONTENT, its path text and any key/value are NEVER\n173\t    # persisted.\n174\t    \"config_change_observed\",\n175\t    # PLAN-135 W2 H2 — ConfigChange guard: a forbidden-key finding\n176\t    # (_lib/effective_config.FORBIDDEN_KEYS, the S3/H2 single source) was\n177\t    # scoped to a settings-surface config change → advisory-block (one emit\n178\t    # per tamper class, settings_tamper_detected producer precedent).\n179\t    # Deny-by-default: dedicated _scrub_ branch +\n180\t    # _CONFIG_CHANGE_FORBIDDEN_KEY_ALLOWLIST below, NEVER\n181\t    # _EMIT_GENERIC_PASSTHROUGH. The ONLY caller-supplied fields are\n182\t    # `tamper_class` (closed enum mirroring _lib/effective_config\n183\t    # TAMPER_CLASSES; coerced to \"other\") + `layer` (closed enum\n184\t    # user/project/local/managed/other; coerced to \"other\") and integer\n185\t    # `finding_count` (clamped 0..99). The forbidden key's VALUE (endpoint\n186\t    # URL / model id / helper path / flag value) and the finding DETAIL are\n187\t    # NEVER persisted.\n188\t    \"config_change_forbidden_key\",\n189\t    # PLAN-135 W2 H1 (ADR-153 compaction-continuity) — PreCompact governance\n190\t    # snapshot breadcrumb (one emit per compaction event,\n191\t    # check_precompact_continuity.py). Deny-by-default: routes through the\n192\t    # dedicated _scrub_ branch + _COMPACTION_CONTINUITY_SNAPSHOT_ALLOWLIST\n193\t    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n194\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n195\t    # The ONLY caller-supplied fields are `trigger` + `snapshot_outcome`\n196\t    # (closed enums, coerced to \"other\"), `plan_id` (strict PLAN-NNN shape\n197\t    # check, coerced to \"unknown\") and integer `chain_length` (clamped\n198\t    # 0..[REDACTED:rg]). The snapshot BODY (plan path, checkbox position,\n199\t    # ceremony flags, last-hmac prefix) lives in the plan-scoped scratchpad\n200\t    # ONLY and is NEVER persisted on the audit wire.\n201\t    \"compaction_continuity_snapshot\",\n202\t    # PLAN-135 W2 H1 (ADR-153 compaction-continuity) — PostCompact\n203\t    # governance-pointer reinjection breadcrumb\n204\t    # (check_postcompact_reinject.py). Deny-by-default: dedicated _scrub_\n205\t    # branch + _COMPACTION_CONTEXT_REINJECTED_ALLOWLIST below, NEVER\n206\t    # _EMIT_GENERIC_PASSTHROUGH. The ONLY caller-supplied fields are\n207\t    # `plan_id` (strict PLAN-NNN shape check, coerced to \"unknown\"),\n208\t    # boolean `snapshot_found` (any non-bool coerced to False) and integers\n209\t    # `snapshot_age_s` (clamped 0..9999999) + `pointer_count` (clamped\n210\t    # 0..9). The reinjected additionalContext TEXT is NEVER persisted\n211\t    # (pointers-only by design; the audit wire carries counters, not\n212\t    # context).\n213\t    \"compaction_context_reinjected\",\n214\t    # PLAN-135 W2 H5 (ADR-154 single-rewriter) — check_bash_safety rewrote a\n215\t    # `git push --force`/`-f` Bash input to `--force-with-lease` via the\n216\t    # PreToolUse `updatedInput` channel (surfaced as an `ask`, never a silent\n217\t    # allow). Deny-by-default: dedicated _scrub_ branch +\n218\t    # _BASH_INPUT_REWRITTEN_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n219\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The\n220\t    # ONLY caller-supplied fields are `rewrite_class` (closed enum, coerced to\n221\t    # \"other\") + the before/after sha256 hash PAIR (`before_sha256` /\n222\t    # `after_sha256`, each validated to 64-hex else coerced to \"\"). The\n223\t    # command BYTES (before OR after) are NEVER persisted — a force-push line\n224\t    # can carry a remote URL with an inline token; the hash pair lets an\n225\t    # auditor prove audited-cmd == executed-cmd without seeing either command\n226\t    # (ADR-154 §2 before/after hash invariant).\n227\t    \"bash_input_rewritten\",\n228\t    # PLAN-135 W2 H3 — per-agent lifecycle bracket emitted ONCE at SubagentStop\n229\t    # (.claude/hooks/check_fluency_nudge.py H3 extension) after consuming the\n230\t    # SubagentStart sidecar (check_subagent_start.py) + the harness-supplied\n231\t    # `agent_transcript_path`: the S227 `modelUsage` forensic reconstruction\n232\t    # becomes a live hook emit, feeding the persona-ledger (PLAN-104) + quota\n233\t    # economics. Deny-by-default: dedicated _scrub_ branch +\n234\t    # _SUBAGENT_LIFECYCLE_OBSERVED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n235\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). EVERY\n236\t    # caller-supplied field is a CLOSED enum or a coarse BUCKET — `agent_archetype`\n237\t    # (persona-ledger archetype enum, coerced to \"other\"/\"unknown\"), `wall_bucket`\n238\t    # + `wall_source` + `token_bucket` + `claim_bucket` (closed enums). RAW\n239\t    # wall-time seconds, RAW token counts, the transcript path/body, the\n240\t    # confidence-marker snippets and the raw agent_id are NEVER persisted —\n241\t    # only the closed-enum brackets travel (the bracket is the audit signal; the\n242\t    # raw counts stay forensic-private, mirroring the S227 reconstruction).\n243\t    \"subagent_lifecycle_observed\",\n244\t    # ---- PLAN-135 ARC CONSOLIDATION — W5 ops actions folded in one place ----\n245\t    # The three W5 actions are TRUSTED-producer emit_generic actions (the\n246\t    # emitter is a standalone Owner-run / Owner-configured script OR the\n247\t    # adapter library itself, not a deny-by-default hook). The producers\n248\t    # pre-redact at the emit site (key-hygiene.py `_redact()`; statusline-ceo.py\n249\t    # passes only numbers/enum-ids; claude.py drops `stop_details.explanation`\n250\t    # and forwards ONLY the closed `stop_details.category` vocabulary) — BUT per\n251\t    # Codex R5 P1-2 (PLAN-135-FOLLOWUP) producer-side pre-redaction is NOT the\n252\t    # only line: each action is ALSO given a dedicated deny-by-default scrub\n253\t    # branch in emit_generic (NEVER _EMIT_GENERIC_PASSTHROUGH) so the Sec MF-3\n254\t    # field-allowlist + enum-value-coercion boundary holds against a direct /\n255\t    # future mis-caller that bypasses the trusted producer — the established\n256\t    # invisible_unicode_blocked / tool_call_lifecycle_recorded precedent. They\n257\t    # are \"branched\" members of the ghost-action-guard tri-state invariant.\n258\t    # PLAN-135 W5 o9 — Anthropic Admin API key-lifecycle breadcrumb\n259\t    # (.claude/scripts/key-hygiene.py `_audit_emit` -> emit_generic). Closed-enum\n260\t    # `operation`/`reason` + IDs/counts only; key material never reaches the emit\n261\t    # (producer `_redact()` on free text). Secondary tamper-evident breadcrumb;\n262\t    # the load-bearing artifact is the append-only docs/rotation-log.md row.\n263\t    \"admin_key_lifecycle_event\",\n264\t    # PLAN-135 W5 o4 — statusLine sidecar-write breadcrumb\n265\t    # (.claude/scripts/statusline-ceo.py `maybe_emit` -> emit_generic). Debounced\n266\t    # (material-digest + CEO_STATUSLINE_EMIT_INTERVAL_S); carries only the sidecar\n267\t    # abs path, plan-id, percentages, bucket count, session_id + a 12-char digest\n268\t    # prefix — never the raw statusLine stdin free text. The load-bearing artifact\n269\t    # is the atomic sidecar JSON (always written); this event arms post-ceremony.\n270\t    \"statusline_sidecar_write\",\n271\t    # PLAN-135 W5 o7 — model-refusal observability breadcrumb\n272\t    # (.claude/hooks/_lib/adapters/live/claude.py `_on_response` -> emit_generic on\n273\t    # stop_reason == \"refusal\"). Forwards ONLY the closed provider\n274\t    # `stop_details.category` vocabulary (<=64 chars) + provider/model slugs +\n275\t    # status/duration ints; `stop_details.explanation` (model free text) is dropped\n276\t    # at the emit site and can NEVER reach the audit log.\n277\t    \"model_refusal_observed\",\n278\t    # ------------------------------------------------------------------\n279\t    # PLAN-154 (Gated Learning Loop / ADR-160) — 11 new actions, all\n280\t    # metadata-only (A2: closed enums / booleans / bounded IDs / hashes;\n281\t    # NO free-text field). Every one routes through a dedicated\n282\t    # deny-by-default scrub branch + allowlist below — NEVER\n283\t    # _EMIT_GENERIC_PASSTHROUGH (Sec MF-3). Count: 303 -> 314.\n284\t    # ------------------------------------------------------------------\n285\t    # Candidate lifecycle (lessons.py add_candidate — birth event carrying\n286\t    # the A6 content pin sha256(trigger+\"\\n\"+advisory_text); its chain ts\n287\t    # is the created_at authority for TTL + approval).\n288\t    \"lesson_candidate_written\",\n289\t    # /lesson-review approval (lessons.py approve_candidate) — THE A6\n290\t    # hash-pinned approval event; get_boot_lessons_verified recomputes\n291\t    # and verifies against it before any render.\n292\t    \"lesson_approved\",\n293\t    # Post-birth terminal QUARANTINED transition (INPUT failures at the\n294\t    # fail-CLOSED promotion boundary, A4).\n295\t    \"lesson_quarantined\",\n296\t    # Terminal TTL expiry (A9 — never any default disposition toward\n297\t    # activation).\n298\t    \"lesson_expired\",\n299\t    # A6 verify-before-render drop breadcrumb (hash mismatch / missing\n300\t    # approval event / vocab tamper) — feeds the item-6 flip criterion\n301\t    # \"zero unresolved integrity flags\".\n302\t    \"lesson_integrity_flag\",\n303\t    # /ceo-boot render-gate drop breadcrumb (item 4 / A5 — closed reason\n304\t    # enum + bounded lesson_id; count-only human counterpart in digest).\n305\t    \"lesson_boot_render_dropped\",\n306\t    # A12 disabled-this-session breadcrumb, shared by all four rails\n307\t    # (observe / distill / boot_render / fact_gate); wired to the ADR-158\n308\t    # fail-open-rail liveness surface. Emitted ONLY on explicit disable.\n309\t    \"learning_rail_disabled\",\n310\t    # A8 governance event — every observed ADVISORY<->ENFORCE flip of the\n311\t    # item-6 fact-forcing deny-once gate (settings-backed; lazy detection\n312\t    # on the already-matched destructive path in check_bash_safety).\n313\t    \"fact_gate_activation_changed\",\n314\t    # A10 dampening condensation — <=1 per advisory ID per session\n315\t    # (_lib/advisory_dampen.py; bounded ID + ordinal + closed channel).\n316\t    \"advisory_dampened\",\n317\t    # Item-2 offline distiller run rollup — tokens_in/tokens_out make the\n318\t    # distiller its own /agent-budget line item; closed outcome enum.\n319\t    \"distiller_run_completed\",\n320\t    # Item-7 $0 deterministic clustering pass — counts-only breadcrumb.\n321\t    \"lesson_evolve_run\",\n322\t    # PLAN-155 Wave 4 (Codex harness audit chain / SENT-CX-B, ADR-161) — two\n323\t    # NEW metadata-only actions so the HMAC chain appends under OpenAI Codex.\n324\t    # Both are distinct from agent_spawn (the claude-only spawn record) AND\n325\t    # from tool_call_lifecycle_recorded, so codex-completeness analysis can\n326\t    # tell the per-tool rail from the turn-level backstop apart in the same\n327\t    # log slice (the completeness query IS the Wave-4 replay test).\n328\t    # Deny-by-default: each routes through a dedicated `_scrub_` branch in\n329\t    # emit_generic + its own closed-enum allowlist below, NEVER\n330\t    # _EMIT_GENERIC_PASSTHROUGH. NO command bytes / patch body / paths /\n331\t    # prompt / last_assistant_message / tool_response text is EVER persisted\n332\t    # — only closed-enum + bool scalars (Sec MF-3). Emitted by audit_log.py\n333\t    # under CEO_HOOK_ADAPTER=codex (via the codex host adapter). The HMAC\n334\t    # chain shape + verify_chain() are UNTOUCHED; only the enum grows.\n335\t    #\n336\t    # (A) per-tool-call append for the codex PostToolUse `*` matcher — the\n337\t    # completeness-bounded record that \"a tool call happened\", tool identity\n338\t    # coerced to a closed enum (raw mcp__<server>__<tool> -> mcp_other).\n339\t    \"codex_tool_recorded\",\n340\t    # (B) turn-ended backstop (Stop / SubagentStop / notify / headless-wrapper\n341\t    # bracket) — a DISTINCT action so a turn-level append is never conflated\n342\t    # with a per-tool append when partial shell interception drops per-tool\n343\t    # events (the named completeness residual).\n344\t    \"codex_turn_ended\",\n345\t    # PLAN-156 Wave 4 (SENT-GK-B) — grok host per-tool + turn-ended pair.\n346\t    # Same completeness contract as the codex pair above: a `grok`\n347\t    # discriminator so analysis can pivot the grok rail without inferring\n348\t    # from the action name. Grok fires PostToolUse per tool call and Stop\n349\t    # per turn (both passive — a deny there is cosmetic, but the AUDIT\n350\t    # append still lands); SessionEnd is not reliable on grok, so\n351\t    # turn-ended accounting hangs off Stop (completeness caveat documented).\n352\t    \"grok_tool_recorded\",\n353\t    \"grok_turn_ended\",\n354\t    # PLAN-156 Wave 6 (SENT-GK-F) — cross-vendor council lane invocation.\n355\t    # One append per AVAILABLE external lane per council run (who asked what,\n356\t    # when) so cross-vendor egress is itself auditable. Registered HERE, not\n357\t    # in Wave 4, so a slipped Wave 6 never publishes a contract action the\n358\t    # framework cannot yet emit (pair-rail R11). Completeness-bounded.\n359\t    \"council_lane_invoked\",\n360\t    # PLAN-161 W2 C5 (CF-9) — pair-rail liveness telemetry pair. Registered\n361\t    # via the PLAN-161 W2 ceremony (CEO_KERNEL_OVERRIDE=\n362\t    # PLAN-161-C5-LIVENESS-ACTIONS); _KNOWN_ACTIONS 319 -> 321. Both are\n363\t    # deny-by-default: dedicated _scrub_ branches +\n364\t    # _CODEX_REVIEW_VERDICT_ALLOWLIST / _PAIR_RAIL_REVIEW_EXPECTED_ALLOWLIST\n365\t    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n366\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n367\t    #\n368\t    # (A) Stop-hook cross-review OUTCOME, emitted by\n369\t    # codex_review_user_code.py (the Stop hook wired in settings.json) once\n370\t    # per distinct (diff_sha256, outcome) pair: closed-enum `outcome`\n371\t    # {clean, findings, skipped_failopen, detected_only} (unrecognized\n372\t    # COERCED to skipped_failopen — never a healthy-class value) +\n373\t    # `diff_sha256` (64-lowercase-hex shape-validated, else \"\"). DENIED on\n374\t    # the wire: the verdict TEXT, the diff content, file paths (a Codex\n375\t    # finding can quote secrets from the reviewed diff). Deliberately NOT\n376\t    # `pair_rail_codex_unavailable` — that would pollute the dispatcher's\n377\t    # Codex-outage predicate (disable_predicate_eval.py).\n378\t    \"codex_review_verdict\",\n379\t    # (B) canonical-edit review ENTERED, emitted by check_pair_rail.py\n380\t    # _decide() only after the kill-switch / non-write-tool / not-L3+ /\n381\t    # sentinel-bypass arms have all returned: the durable session-correlated\n382\t    # DENOMINATOR for the /ceo-boot `pair_rail` activity-conditioned\n383\t    # liveness row (the S254 class — expected-without-outcome must escalate,\n384\t    # and a healthy outcome from session B must never mask session A). The\n385\t    # ONLY caller fields are `session_id` + closed-enum `tool_name` + the\n386\t    # bounded 16-hex `file_path_hash_prefix` (r4 F2 legacy bucket key —\n387\t    # same token as `pair_rail_case`) + the exact-16-hex-or-\"\" `review_id`\n388\t    # (r5 F2 — per-invocation correlation id minted at review entry and\n389\t    # identical on this emit and its own `pair_rail_case`, so the\n390\t    # /ceo-boot deficit pairs invocation-EXACT: no completed case — even\n391\t    # for the SAME (session, file) — can ever offset a different dead\n392\t    # review).\n393\t    \"pair_rail_review_expected\",\n394\t    # PLAN-163 T3.1/T3.2 (CC 2.1.220 substrate uplift, ADR-183) — 2 NEW\n395\t    # metadata-only actions for the two NEW harness lifecycle events\n396\t    # (DirectoryAdded + Notification). Registered via the PLAN-163 pack\n397\t    # ceremony; _KNOWN_ACTIONS 321 -> 323. Both are deny-by-default:\n398\t    # dedicated _scrub_ branches + _DIRECTORY_ADDED_RECORDED_ALLOWLIST /\n399\t    # _NOTIFICATION_LIFECYCLE_ALLOWLIST below, NEVER\n400\t    # _EMIT_GENERIC_PASSTHROUGH\n401\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n402\t    #\n403\t    # (A) DirectoryAdded workspace-root append, emitted by\n404\t    # check_directory_added.py (the DirectoryAdded observer — the event is\n405\t    # NOTIFICATION-ONLY on CC 2.1.220: permission/sandbox already include\n406\t    # the dir BEFORE dispatch, so this row is the POST-FACTO forensic\n407\t    # record that the session's write surface grew). Closed-enum `source`\n408\t    # {slash_command, register_repo_root, session_start_snapshot, other}\n409\t    # (the wire carries the first two; session_start_snapshot is reserved\n410\t    # for the documented --add-dir-at-LAUNCH blind-spot mitigation — the\n411\t    # launch flag never fires the event, so a SessionStart roots snapshot\n412\t    # is the only producer that can cover it) + `directory_hash_prefix`\n413\t    # (exact 12-lowercase-hex sha256 prefix of the absolute path, or \"\";\n414\t    # the RAW directory path is NEVER persisted — LLM06 side-channel\n415\t    # guard, same 12-hex token class as message_sha256_prefix below and\n416\t    # the exact length check_directory_added.py computes).\n417\t    \"directory_added_recorded\",\n418\t    # (B) Notification lifecycle telemetry, emitted by\n419\t    # check_notification.py (pure observer on the Notification event).\n420\t    # Closed-enum `notification_type` {agent_needs_input, agent_completed,\n421\t    # permission_request, other} — the harness enum is OPEN, so any\n422\t    # unrecognized wire value COERCES to `other` (never echoed) — +\n423\t    # `has_title` (bool) + `message_sha256_prefix` (exact 12-lowercase-hex\n424\t    # sha256 prefix of the message body, or \"\"; the message/title TEXT is\n425\t    # NEVER persisted — no-value-echo, a notification message can quote\n426\t    # tool output or secrets).\n427\t    \"notification_lifecycle\",\n428\t    # PLAN-165 P2 (night-mode / D2) — Owner-invoked autonomy posture toggle\n429\t    # forensic record, emitted by .claude/scripts/night-mode.py (the SINGLE\n430\t    # writer of the per-machine overlay .claude/settings.local.json — the\n431\t    # PLAN-165 P1 deny rule closes the tool Edit/Write path) once per on|off\n432\t    # invocation. Registered via the PLAN-165 prerequisite ceremony;\n433\t    # _KNOWN_ACTIONS 323 -> 324. Deny-by-default: dedicated _scrub_ branch +\n434\t    # _NIGHT_MODE_TOGGLED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n435\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n436\t    # Closed-enum `mode` / `previous_mode` {acceptEdits, manual, absent,\n437\t    # other} + closed-enum `result` {applied, noop, refused, failed, other}\n438\t    # + `hostname_hash` (exact 12-lowercase-hex sha256 prefix of the machine\n439\t    # hostname, or \"\"). DENIED on the wire: the overlay PATH, settings file\n440\t    # CONTENT, marker content, the RAW hostname — settings JSON and paths\n441\t    # can carry usernames, allowlists, and project identity (LLM06\n442\t    # side-channel guard).\n443\t    \"night_mode_toggled\",\n444\t    # PLAN-179 W0 US2 (amendment 8.1 — the ADR-153 continuity successor\n445\t    # rail) — EDGE-TRIGGERED context-pressure breadcrumb: the session\n446\t    # crossed INTO a new context-usage percent bucket. A TRANSITION, never\n447\t    # a per-turn sample — the hysteresis gate is\n448\t    # should_emit_context_pressure() below, and without it the HMAC chain\n449\t    # would take one row per prompt while the session sits in one rung.\n450\t    # Registered via the staged PLAN-179 W0/W1 bundle; _KNOWN_ACTIONS\n451\t    # 324 -> 325. Deny-by-default: dedicated _scrub_ branch +\n452\t    # _CONTEXT_PRESSURE_OBSERVED_ALLOWLIST below, NEVER\n453\t    # _EMIT_GENERIC_PASSTHROUGH\n454\t    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n455\t    # The ONLY caller-supplied fields are `used_bucket` (closed set of\n456\t    # INTEGER PERCENT buckets {40,60,80,90,95} — the name carries the unit;\n457\t    # the check is TYPE-strict because canonical_json refuses floats and a\n458\t    # float here would discard the WHOLE event, S181/ADR-055-AMEND-2),\n459\t    # `event_source` (closed enum, coerced to \"other\") and `plan_id`\n460\t    # (strict PLAN-NNN shape check, coerced to \"unknown\"). DENIED on the\n461\t    # wire: the raw token/byte counts, the transcript text, the plan path\n462\t    # text, the prompt body.\n463\t    \"context_pressure_observed\",\n464\t    # PLAN-174 W1 (registered by the SENT-S318 pack; _KNOWN_ACTIONS\n465\t    # 325 -> 326) — ceremony-lint ADR-186 escape-hatch breadcrumb:\n466\t    # CEO_CEREMONY_LINT_UNLOCK=<sha256> + _REASON consumed by\n467\t    # check-ceremony-script.py. Metadata-only wire (`file_sha256` 16-hex\n468\t    # prefix + `reason_len` int); the reason TEXT never reaches the log.\n469\t    # Emitter parked in 908707e until this registration existed.\n470\t    \"ceremony_lint_unlock_used\",\n471\t    # PLAN-182 W1 (ADR-079 S318 amendment §2; _KNOWN_ACTIONS 326 -> 327)\n472\t    # — the ONE sanctioned salt-rotation register: minting a per-project\n473\t    # .salt is OBSERVABLE in the chain, never silent. Metadata-only wire\n474\t    # (`reason` closed enum + `salt_scope` fixed + `slug_sha256` 16-hex\n475\t    # prefix); raw slug and salt-file path are excluded from the payload.\n476\t    # The base `project` field still carries the absolute repository path.\n477\t    # Emitted lazily\n478\t    # by _lib/injection_salt.py at mint time (marker sidecar is the\n479\t    # forensic ground truth when the emit path is unavailable).\n480\t    \"salt_rotation_registered\",\n481\t    # PLAN-179 W2/W4 (ADR-195 — work-boundary persistence; registered by the\n482\t    # staged-w24 ceremony pack, Owner decision 2026-08-25 \"3 actions\";\n483\t    # _KNOWN_ACTIONS 327 -> 330). All THREE are deny-by-default: a dedicated\n484\t    # `action ==` scrub branch in emit_generic + the allowlists\n485\t    # _LEDGER_CHECKPOINT_RECORDED_ALLOWLIST /\n486\t    # _LEDGER_CHECKPOINT_SKIPPED_ALLOWLIST / _LEDGER_ENTRY_REJECTED_ALLOWLIST\n487\t    # below, NEVER _EMIT_GENERIC_PASSTHROUGH.\n488\t    #\n489\t    # (1) The advisory work-boundary observation: a `git commit` landing\n490\t    # plan-scoped work was inspected for its LEDGER.md checkpoint. Producer =\n491\t    # check_ledger_checkpoint.py (PreToolUse/Bash), which never denies. Wire =\n492\t    # closed enums (`outcome`, `scope_source`, `state_kind`), the strict\n493\t    # PLAN-NNN id, and TYPE-strict INT counters clamped 0..99 (a float is\n494\t    # refused by canonical_json and would discard the WHOLE event —\n495\t    # S181/ADR-055-AMEND-2). DENIED on the wire: the commit MESSAGE, the\n496\t    # committed PATHS, the ledger CONTENT, the repo root, any AC text.\n497\t    \"ledger_checkpoint_recorded\",\n498\t    # (2) The same rail's negative case, kept as its OWN action so \"the rail\n499\t    # did not fire\" is countable instead of inferred from absence: the\n500\t    # measure-first window needs a denominator, and \"skipped because the\n501\t    # commit was out of scope\" and \"never observed at all\" are different\n502\t    # facts.\n503\t    \"ledger_checkpoint_skipped\",\n504\t    # (3) The W4 ledger write-gate discard: an externally-sourced entry was\n505\t    # refused fail-CLOSED. Producer = _lib/ledger_provenance.py. This action\n506\t    # exists precisely so the discard is NOT filed as\n507\t    # `prompt_injection_detected`: routing `scanner_unavailable` / `oversize`\n508\t    # / `malformed_input` into a DETECTION action would poison the very FPR\n509\t    # series the advisory window has to measure. Wire = closed enums + INT\n510\t    # counters. DENIED on the wire: the rejected entry BODY (not even a\n511\t    # preview), the entry id, and any path.\n512\t    \"ledger_entry_rejected\",\n513\t    # PLAN-179 W2 US8 (wave-179-close ceremony; SPEC v2.60) — SessionEnd\n514\t    # memory-delta observation: one emit per session, immediately before\n515\t    # `session_end` — activity in the shared project memory directory during\n516\t    # this session's window; it does not establish session authorship.\n517\t    # Stat-only producer; closed enums + INT counters only.\n518\t    # DENIED on the wire: memory file names/basenames, file bodies, the\n519\t    # memory-dir absolute path and the $HOME-derived slug, the raw\n520\t    # session_start source line, any env value (LLM06 side-channel guard\n521\t    # — the producer renders counts on the systemMessage operator channel,\n522\t    # and never forwards basenames to the signed chain).\n523\t    \"session_memory_delta_observed\",\n524\t}\n525\t"}]},"parent_tool_use_id":null,"session_id":"34b005ba-8b89-4e2d-a38f-79b02c6d7b54","uuid":"49f6a0d6-aa80-4f42-b119-e5536d11f110","timestamp":"2026-11-13T17:32:24.684Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/actions_extended.py","content":"\"\"\"Audit action registrations; combined by schemas_actions.\"\"\"\nfrom __future__ import annotations\n\n_ACTIONS = {\n    \"goap_search_aborted\",\n    \"goap_search_summary\",\n    \"goap_cycle_detected\",\n    \"goap_depth_exceeded\",\n    \"goap_replan_triggered\",\n    \"goap_replan_exhausted\",\n    \"goap_disabled_by_env\",\n    \"goap_recommendation_accepted\",\n    # PLAN-105 Wave A.1 + A.2 — GOAP recommendation outcome telemetry.\n    \"goap_recommendation_rendered\",\n    \"goap_recommendation_overridden\",\n    # PLAN-099 (ADR-129 / ADR-135) — federation cross-machine MVP audit surface.\n    \"federation_connection_accepted\",\n    \"federation_connection_rejected\",\n    \"federation_connection_replay_suspected\",\n    \"federation_cert_expiry_warned\",\n    \"federation_cert_rotated\",\n    \"federation_cert_revoked\",\n    \"federation_write_attempt_blocked\",\n    \"federation_lan_bind_denied\",\n    \"federation_autonomous_call_blocked\",\n    \"federation_enable_sentinel_invalid\",\n    # PLAN-099-FOLLOWUP Wave F — federation write-mode audit surface\n    # (ADR-129-AMEND-1 / ADR-135-AMEND-1 / attack-rebinding.md §2).\n    # 20 actions touched; +19 net-new (federation_cert_rotated already\n    # in set from PLAN-099 MVP S134, field-shape-superseded in-place).\n    # Registered via kernel-override\n    # PLAN-099-FOLLOWUP-WAVE-F-AUDIT-EMIT-EXTENSION at v1.39.1.\n    \"federation_audit_event_pushed\",\n    \"federation_audit_event_pushed_batch\",\n    \"federation_audit_log_backpressure\",\n    \"federation_cert_validity_window_too_large\",\n    \"federation_event_action_blocked\",\n    \"federation_hmac_secret_rotated\",\n    \"federation_key_floor_rejected\",\n    \"federation_key_floor_stale\",\n    \"federation_message_storm_detected\",\n    \"federation_peer_invalid_no_fingerprint\",\n    \"federation_peer_registered\",\n    \"federation_peer_registered_collision\",\n    \"federation_peer_revoked_remote\",\n    \"federation_pin_legacy_used\",\n    \"federation_scope_denied\",\n    \"federation_spki_fingerprint_mismatch\",\n    \"federation_tamper_detected\",\n    \"federation_write_disabled_sentinel_invalid\",\n    \"federation_write_endpoint_denied\",\n    \"federation_peer_list_reloaded\",\n    # PLAN-104 Wave A — persona-demand ledger audit surface (S134 R2 ACCEPT).\n    \"persona_demand_opened\",\n    \"persona_demand_matched\",\n    \"persona_demand_unmet\",\n    \"persona_demand_waived\",\n    # PLAN-090-FOLLOWUP Wave A — claim producer pair (S138 R2 ACCEPT).\n    \"claim_emitted\",\n    \"confidence_gate_verdict\",\n    # PLAN-100 Wave B — per-class block-mode (S139 R2 ACCEPT;\n    # ADR-019-AMEND-1 PROPOSED). confidence_gate_blocked emitted when\n    # decision.action == \"block\"; confidence_gate_fp_drift_detected\n    # emitted by check-confidence-gate-drift.py on 7d rolling FPR > 2%.\n    \"confidence_gate_blocked\",\n    \"confidence_gate_fp_drift_detected\",\n    # PLAN-106 Wave C — persona-coverage 4×4 cell emit from production\n    # hooks (check_agent_spawn allow path + check_canonical_edit allow\n    # path). Source field carries `dispatch` | `canonical_edit` for\n    # downstream attribution. NO public typed wrapper — emit_generic +\n    # Sec MF-3 scrub keeps `_EXPECTED_PUBLIC_SYMBOLS` stable per\n    # PLAN-102 Wave A precedent (S142 R2 iter-1 P1 #3 fold).\n    \"persona_coverage_synthesized\",\n    # PLAN-110 Wave D — protocol_semver_cascade advisory hook\n    \"protocol_edit_missing_amend_paired\",\n    # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — chain_reset_marker is\n    # the synthetic genesis entry written as line 1 of every rotation-\n    # created fresh audit-log.jsonl. Per ADR-055-AMEND-2 (drafted in\n    # this plan): verifier reads `audit-log.rotation-manifest.json`\n    # sidecar; if present, line 1 of fresh log MUST be a\n    # chain_reset_marker entry — non-marker line 1 = STATUS_TAMPER.\n    # Registered via kernel-override\n    # PLAN-112-FOLLOWUP-WAVE-B3-AUDIT-EMIT-EXTENSION at v1.39.4.\n    \"chain_reset_marker\",\n    # PLAN-118 AC-B5 — closed-enum producer-pollution forensic breadcrumb.\n    # Emitted by chokepoint 1 (audit_emit._emit_chain_reset_marker_under_lock)\n    # + chokepoint 4 (spool_writer._phase4_build_batch) when the canonical-\n    # resolution check (audit_hmac._ensure_canonical_lib_modules) detects\n    # a stale `_lib` copy on sys.path. Allowlist payload: chokepoint\n    # (enum: chain_reset_marker | spool_drain) + reason_code (enum:\n    # audit_emit_path_pollution | canonical_json_path_pollution |\n    # audit_hmac_path_pollution) + path_sha256_prefix (8 hex chars) +\n    # expected_canonical_prefix (8 hex chars). NO `__file__` raw echo\n    # per [[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]].\n    \"audit_producer_path_pollution_detected\",\n    # PLAN-125 WS-1 (kooky-harvest) — per-tool-call lifecycle telemetry.\n    # Deny-by-default: routes through the dedicated _scrub_ branch +\n    # _TOOL_CALL_LIFECYCLE_RECORDED_ALLOWLIST below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH (Sec MF-SEC-2). Carries ONLY 4 closed fields:\n    # tool_name_enum (mcp__* → mcp_other, Sec MF-SEC-1), duration_bucket\n    # (coarse enum, never raw duration_ms, Sec MF-SEC-3), success, orphan.\n    \"tool_call_lifecycle_recorded\",\n    # PLAN-124 WS-1 (ECC value-harvest) — git hook-bypass guard breadcrumb.\n    # Deny-by-default: routes through the dedicated _scrub_ branch +\n    # _GIT_HOOK_BYPASS_BLOCKED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    # The ONLY caller-supplied field is `flag_class` (closed enum, MF-G); the\n    # matched command bytes are NEVER persisted (a malicious flag value such as\n    # `-c http.extraHeader=\"Bearer <secret>\"` could otherwise leak).\n    \"git_hook_bypass_blocked\",\n    # PLAN-133 A1 — linker/loader/runtime env-hijack denylist breadcrumb.\n    # Deny-by-default: routes through the dedicated _scrub_ branch +\n    # _ENV_VAR_HIJACK_BLOCKED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    # The ONLY caller-supplied field is `hijack_class` (closed enum); the matched\n    # variable NAME and the assigned VALUE are NEVER persisted (the value can be\n    # a path/preload payload or a smuggled secret).\n    \"env_var_hijack_blocked\",\n    # PLAN-133 A3 — egress-destination taxonomy breadcrumb (advisory). Routes\n    # through the dedicated _scrub_ branch + _EGRESS_DESTINATION_DETECTED_ALLOWLIST\n    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The ONLY\n    # caller-supplied fields are `egress_class` (closed enum) + `destination`\n    # (BARE HOST only — never the full URL/path/query/credential).\n    \"egress_destination_detected\",\n    # PLAN-133 E1 — adversary local-rules deny/ask gate breadcrumb. Deny-by-default:\n    # routes through the dedicated _scrub_ branch + _ADVERSARY_REVIEW_FLAGGED_ALLOWLIST\n    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The ONLY\n    # caller-supplied fields are `decision` + `rule_class` (both closed enums) and\n    # `rule_id` (author-controlled config token). The matched COMMAND bytes and any\n    # env value are NEVER persisted.\n    \"adversary_review_flagged\",\n    # PLAN-133 G1 — MOIM persistent-instructions BLOCKING validator breadcrumb.\n    # Deny-by-default: routes through the dedicated _scrub_ branch +\n    # _PERSISTENT_INSTRUCTIONS_BLOCKED_ALLOWLIST below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The\n    # ONLY caller-supplied fields are `reason` (closed enum) + integer counts\n    # `family_hits`/`bytes_scanned`. The instruction-file body, the matched\n    # line, and any path/env value are NEVER persisted.\n    \"persistent_instructions_blocked\",\n    # PLAN-133 G3 — hierarchical nested .claude/hints.md provenance breadcrumb.\n    # Deny-by-default: routes through the dedicated _scrub_ branch +\n    # _HINT_PROVENANCE_RECORDED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The\n    # ONLY caller-supplied fields are `reason` (closed enum) + integer\n    # `rel_dir_depth` / `family_hits` / `bytes_scanned`. The hint-file body, the\n    # matched line, and the absolute/relative PATH text are NEVER persisted —\n    # only the integer directory DEPTH below the repo root.\n    \"hint_provenance_recorded\",\n    # PLAN-135 W1 S3 — /ceo-boot Tier-S settings/env tamper tripwire\n    # breadcrumb (one emit per detected tamper class). Deny-by-default:\n    # routes through the dedicated _scrub_ branch +\n    # _SETTINGS_TAMPER_DETECTED_ALLOWLIST below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    # The ONLY caller-supplied fields are `tamper_class` + `layer` (both\n    # closed enums mirroring _lib/effective_config; coerced to \"other\" on\n    # a miss) and integer `finding_count` (clamped 0..99). The tamper\n    # finding DETAIL (endpoint URL / model id / helper path / flag value)\n    # and any env VALUE are NEVER persisted.\n    \"settings_tamper_detected\",\n    # PLAN-135 W2 H2 — ConfigChange guard: a settings-surface config change\n    # was observed and NO forbidden-key finding was scoped to it (allow +\n    # audit path of check_config_change.py). Deny-by-default: routes through\n    # the dedicated _scrub_ branch + _CONFIG_CHANGE_OBSERVED_ALLOWLIST\n    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    # The ONLY caller-supplied field is `layer` (closed enum\n    # user/project/local/managed/other; coerced to \"other\" on a miss). The\n    # changed file's CONTENT, its path text and any key/value are NEVER\n    # persisted.\n    \"config_change_observed\",\n    # PLAN-135 W2 H2 — ConfigChange guard: a forbidden-key finding\n    # (_lib/effective_config.FORBIDDEN_KEYS, the S3/H2 single source) was\n    # scoped to a settings-surface config change → advisory-block (one emit\n    # per tamper class, settings_tamper_detected producer precedent).\n    # Deny-by-default: dedicated _scrub_ branch +\n    # _CONFIG_CHANGE_FORBIDDEN_KEY_ALLOWLIST below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH. The ONLY caller-supplied fields are\n    # `tamper_class` (closed enum mirroring _lib/effective_config\n    # TAMPER_CLASSES; coerced to \"other\") + `layer` (closed enum\n    # user/project/local/managed/other; coerced to \"other\") and integer\n    # `finding_count` (clamped 0..99). The forbidden key's VALUE (endpoint\n    # URL / model id / helper path / flag value) and the finding DETAIL are\n    # NEVER persisted.\n    \"config_change_forbidden_key\",\n    # PLAN-135 W2 H1 (ADR-153 compaction-continuity) — PreCompact governance\n    # snapshot breadcrumb (one emit per compaction event,\n    # check_precompact_continuity.py). Deny-by-default: routes through the\n    # dedicated _scrub_ branch + _COMPACTION_CONTINUITY_SNAPSHOT_ALLOWLIST\n    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    # The ONLY caller-supplied fields are `trigger` + `snapshot_outcome`\n    # (closed enums, coerced to \"other\"), `plan_id` (strict PLAN-NNN shape\n    # check, coerced to \"unknown\") and integer `chain_length` (clamped\n    # 0..[REDACTED:rg]). The snapshot BODY (plan path, checkbox position,\n    # ceremony flags, last-hmac prefix) lives in the plan-scoped scratchpad\n    # ONLY and is NEVER persisted on the audit wire.\n    \"compaction_continuity_snapshot\",\n    # PLAN-135 W2 H1 (ADR-153 compaction-continuity) — PostCompact\n    # governance-pointer reinjection breadcrumb\n    # (check_postcompact_reinject.py). Deny-by-default: dedicated _scrub_\n    # branch + _COMPACTION_CONTEXT_REINJECTED_ALLOWLIST below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH. The ONLY caller-supplied fields are\n    # `plan_id` (strict PLAN-NNN shape check, coerced to \"unknown\"),\n    # boolean `snapshot_found` (any non-bool coerced to False) and integers\n    # `snapshot_age_s` (clamped 0..9999999) + `pointer_count` (clamped\n    # 0..9). The reinjected additionalContext TEXT is NEVER persisted\n    # (pointers-only by design; the audit wire carries counters, not\n    # context).\n    \"compaction_context_reinjected\",\n    # PLAN-135 W2 H5 (ADR-154 single-rewriter) — check_bash_safety rewrote a\n    # `git push --force`/`-f` Bash input to `--force-with-lease` via the\n    # PreToolUse `updatedInput` channel (surfaced as an `ask`, never a silent\n    # allow). Deny-by-default: dedicated _scrub_ branch +\n    # _BASH_INPUT_REWRITTEN_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). The\n    # ONLY caller-supplied fields are `rewrite_class` (closed enum, coerced to\n    # \"other\") + the before/after sha256 hash PAIR (`before_sha256` /\n    # `after_sha256`, each validated to 64-hex else coerced to \"\"). The\n    # command BYTES (before OR after) are NEVER persisted — a force-push line\n    # can carry a remote URL with an inline token; the hash pair lets an\n    # auditor prove audited-cmd == executed-cmd without seeing either command\n    # (ADR-154 §2 before/after hash invariant).\n    \"bash_input_rewritten\",\n    # PLAN-135 W2 H3 — per-agent lifecycle bracket emitted ONCE at SubagentStop\n    # (.claude/hooks/check_fluency_nudge.py H3 extension) after consuming the\n    # SubagentStart sidecar (check_subagent_start.py) + the harness-supplied\n    # `agent_transcript_path`: the S227 `modelUsage` forensic reconstruction\n    # becomes a live hook emit, feeding the persona-ledger (PLAN-104) + quota\n    # economics. Deny-by-default: dedicated _scrub_ branch +\n    # _SUBAGENT_LIFECYCLE_OBSERVED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]). EVERY\n    # caller-supplied field is a CLOSED enum or a coarse BUCKET — `agent_archetype`\n    # (persona-ledger archetype enum, coerced to \"other\"/\"unknown\"), `wall_bucket`\n    # + `wall_source` + `token_bucket` + `claim_bucket` (closed enums). RAW\n    # wall-time seconds, RAW token counts, the transcript path/body, the\n    # confidence-marker snippets and the raw agent_id are NEVER persisted —\n    # only the closed-enum brackets travel (the bracket is the audit signal; the\n    # raw counts stay forensic-private, mirroring the S227 reconstruction).\n    \"subagent_lifecycle_observed\",\n    # ---- PLAN-135 ARC CONSOLIDATION — W5 ops actions folded in one place ----\n    # The three W5 actions are TRUSTED-producer emit_generic actions (the\n    # emitter is a standalone Owner-run / Owner-configured script OR the\n    # adapter library itself, not a deny-by-default hook). The producers\n    # pre-redact at the emit site (key-hygiene.py `_redact()`; statusline-ceo.py\n    # passes only numbers/enum-ids; claude.py drops `stop_details.explanation`\n    # and forwards ONLY the closed `stop_details.category` vocabulary) — BUT per\n    # Codex R5 P1-2 (PLAN-135-FOLLOWUP) producer-side pre-redaction is NOT the\n    # only line: each action is ALSO given a dedicated deny-by-default scrub\n    # branch in emit_generic (NEVER _EMIT_GENERIC_PASSTHROUGH) so the Sec MF-3\n    # field-allowlist + enum-value-coercion boundary holds against a direct /\n    # future mis-caller that bypasses the trusted producer — the established\n    # invisible_unicode_blocked / tool_call_lifecycle_recorded precedent. They\n    # are \"branched\" members of the ghost-action-guard tri-state invariant.\n    # PLAN-135 W5 o9 — Anthropic Admin API key-lifecycle breadcrumb\n    # (.claude/scripts/key-hygiene.py `_audit_emit` -> emit_generic). Closed-enum\n    # `operation`/`reason` + IDs/counts only; key material never reaches the emit\n    # (producer `_redact()` on free text). Secondary tamper-evident breadcrumb;\n    # the load-bearing artifact is the append-only docs/rotation-log.md row.\n    \"admin_key_lifecycle_event\",\n    # PLAN-135 W5 o4 — statusLine sidecar-write breadcrumb\n    # (.claude/scripts/statusline-ceo.py `maybe_emit` -> emit_generic). Debounced\n    # (material-digest + CEO_STATUSLINE_EMIT_INTERVAL_S); carries only the sidecar\n    # abs path, plan-id, percentages, bucket count, session_id + a 12-char digest\n    # prefix — never the raw statusLine stdin free text. The load-bearing artifact\n    # is the atomic sidecar JSON (always written); this event arms post-ceremony.\n    \"statusline_sidecar_write\",\n    # PLAN-135 W5 o7 — model-refusal observability breadcrumb\n    # (.claude/hooks/_lib/adapters/live/claude.py `_on_response` -> emit_generic on\n    # stop_reason == \"refusal\"). Forwards ONLY the closed provider\n    # `stop_details.category` vocabulary (<=64 chars) + provider/model slugs +\n    # status/duration ints; `stop_details.explanation` (model free text) is dropped\n    # at the emit site and can NEVER reach the audit log.\n    \"model_refusal_observed\",\n    # ------------------------------------------------------------------\n    # PLAN-154 (Gated Learning Loop / ADR-160) — 11 new actions, all\n    # metadata-only (A2: closed enums / booleans / bounded IDs / hashes;\n    # NO free-text field). Every one routes through a dedicated\n    # deny-by-default scrub branch + allowlist below — NEVER\n    # _EMIT_GENERIC_PASSTHROUGH (Sec MF-3). Count: 303 -> 314.\n    # ------------------------------------------------------------------\n    # Candidate lifecycle (lessons.py add_candidate — birth event carrying\n    # the A6 content pin sha256(trigger+\"\\n\"+advisory_text); its chain ts\n    # is the created_at authority for TTL + approval).\n    \"lesson_candidate_written\",\n    # /lesson-review approval (lessons.py approve_candidate) — THE A6\n    # hash-pinned approval event; get_boot_lessons_verified recomputes\n    # and verifies against it before any render.\n    \"lesson_approved\",\n    # Post-birth terminal QUARANTINED transition (INPUT failures at the\n    # fail-CLOSED promotion boundary, A4).\n    \"lesson_quarantined\",\n    # Terminal TTL expiry (A9 — never any default disposition toward\n    # activation).\n    \"lesson_expired\",\n    # A6 verify-before-render drop breadcrumb (hash mismatch / missing\n    # approval event / vocab tamper) — feeds the item-6 flip criterion\n    # \"zero unresolved integrity flags\".\n    \"lesson_integrity_flag\",\n    # /ceo-boot render-gate drop breadcrumb (item 4 / A5 — closed reason\n    # enum + bounded lesson_id; count-only human counterpart in digest).\n    \"lesson_boot_render_dropped\",\n    # A12 disabled-this-session breadcrumb, shared by all four rails\n    # (observe / distill / boot_render / fact_gate); wired to the ADR-158\n    # fail-open-rail liveness surface. Emitted ONLY on explicit disable.\n    \"learning_rail_disabled\",\n    # A8 governance event — every observed ADVISORY<->ENFORCE flip of the\n    # item-6 fact-forcing deny-once gate (settings-backed; lazy detection\n    # on the already-matched destructive path in check_bash_safety).\n    \"fact_gate_activation_changed\",\n    # A10 dampening condensation — <=1 per advisory ID per session\n    # (_lib/advisory_dampen.py; bounded ID + ordinal + closed channel).\n    \"advisory_dampened\",\n    # Item-2 offline distiller run rollup — tokens_in/tokens_out make the\n    # distiller its own /agent-budget line item; closed outcome enum.\n    \"distiller_run_completed\",\n    # Item-7 $0 deterministic clustering pass — counts-only breadcrumb.\n    \"lesson_evolve_run\",\n    # PLAN-155 Wave 4 (Codex harness audit chain / SENT-CX-B, ADR-161) — two\n    # NEW metadata-only actions so the HMAC chain appends under OpenAI Codex.\n    # Both are distinct from agent_spawn (the claude-only spawn record) AND\n    # from tool_call_lifecycle_recorded, so codex-completeness analysis can\n    # tell the per-tool rail from the turn-level backstop apart in the same\n    # log slice (the completeness query IS the Wave-4 replay test).\n    # Deny-by-default: each routes through a dedicated `_scrub_` branch in\n    # emit_generic + its own closed-enum allowlist below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH. NO command bytes / patch body / paths /\n    # prompt / last_assistant_message / tool_response text is EVER persisted\n    # — only closed-enum + bool scalars (Sec MF-3). Emitted by audit_log.py\n    # under CEO_HOOK_ADAPTER=codex (via the codex host adapter). The HMAC\n    # chain shape + verify_chain() are UNTOUCHED; only the enum grows.\n    #\n    # (A) per-tool-call append for the codex PostToolUse `*` matcher — the\n    # completeness-bounded record that \"a tool call happened\", tool identity\n    # coerced to a closed enum (raw mcp__<server>__<tool> -> mcp_other).\n    \"codex_tool_recorded\",\n    # (B) turn-ended backstop (Stop / SubagentStop / notify / headless-wrapper\n    # bracket) — a DISTINCT action so a turn-level append is never conflated\n    # with a per-tool append when partial shell interception drops per-tool\n    # events (the named completeness residual).\n    \"codex_turn_ended\",\n    # PLAN-156 Wave 4 (SENT-GK-B) — grok host per-tool + turn-ended pair.\n    # Same completeness contract as the codex pair above: a `grok`\n    # discriminator so analysis can pivot the grok rail without inferring\n    # from the action name. Grok fires PostToolUse per tool call and Stop\n    # per turn (both passive — a deny there is cosmetic, but the AUDIT\n    # append still lands); SessionEnd is not reliable on grok, so\n    # turn-ended accounting hangs off Stop (completeness caveat documented).\n    \"grok_tool_recorded\",\n    \"grok_turn_ended\",\n    # PLAN-156 Wave 6 (SENT-GK-F) — cross-vendor council lane invocation.\n    # One append per AVAILABLE external lane per council run (who asked what,\n    # when) so cross-vendor egress is itself auditable. Registered HERE, not\n    # in Wave 4, so a slipped Wave 6 never publishes a contract action the\n    # framework cannot yet emit (pair-rail R11). Completeness-bounded.\n    \"council_lane_invoked\",\n    # PLAN-161 W2 C5 (CF-9) — pair-rail liveness telemetry pair. Registered\n    # via the PLAN-161 W2 ceremony (CEO_KERNEL_OVERRIDE=\n    # PLAN-161-C5-LIVENESS-ACTIONS); _KNOWN_ACTIONS 319 -> 321. Both are\n    # deny-by-default: dedicated _scrub_ branches +\n    # _CODEX_REVIEW_VERDICT_ALLOWLIST / _PAIR_RAIL_REVIEW_EXPECTED_ALLOWLIST\n    # below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    #\n    # (A) Stop-hook cross-review OUTCOME, emitted by\n    # codex_review_user_code.py (the Stop hook wired in settings.json) once\n    # per distinct (diff_sha256, outcome) pair: closed-enum `outcome`\n    # {clean, findings, skipped_failopen, detected_only} (unrecognized\n    # COERCED to skipped_failopen — never a healthy-class value) +\n    # `diff_sha256` (64-lowercase-hex shape-validated, else \"\"). DENIED on\n    # the wire: the verdict TEXT, the diff content, file paths (a Codex\n    # finding can quote secrets from the reviewed diff). Deliberately NOT\n    # `pair_rail_codex_unavailable` — that would pollute the dispatcher's\n    # Codex-outage predicate (disable_predicate_eval.py).\n    \"codex_review_verdict\",\n    # (B) canonical-edit review ENTERED, emitted by check_pair_rail.py\n    # _decide() only after the kill-switch / non-write-tool / not-L3+ /\n    # sentinel-bypass arms have all returned: the durable session-correlated\n    # DENOMINATOR for the /ceo-boot `pair_rail` activity-conditioned\n    # liveness row (the S254 class — expected-without-outcome must escalate,\n    # and a healthy outcome from session B must never mask session A). The\n    # ONLY caller fields are `session_id` + closed-enum `tool_name` + the\n    # bounded 16-hex `file_path_hash_prefix` (r4 F2 legacy bucket key —\n    # same token as `pair_rail_case`) + the exact-16-hex-or-\"\" `review_id`\n    # (r5 F2 — per-invocation correlation id minted at review entry and\n    # identical on this emit and its own `pair_rail_case`, so the\n    # /ceo-boot deficit pairs invocation-EXACT: no completed case — even\n    # for the SAME (session, file) — can ever offset a different dead\n    # review).\n    \"pair_rail_review_expected\",\n    # PLAN-163 T3.1/T3.2 (CC 2.1.220 substrate uplift, ADR-183) — 2 NEW\n    # metadata-only actions for the two NEW harness lifecycle events\n    # (DirectoryAdded + Notification). Registered via the PLAN-163 pack\n    # ceremony; _KNOWN_ACTIONS 321 -> 323. Both are deny-by-default:\n    # dedicated _scrub_ branches + _DIRECTORY_ADDED_RECORDED_ALLOWLIST /\n    # _NOTIFICATION_LIFECYCLE_ALLOWLIST below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    #\n    # (A) DirectoryAdded workspace-root append, emitted by\n    # check_directory_added.py (the DirectoryAdded observer — the event is\n    # NOTIFICATION-ONLY on CC 2.1.220: permission/sandbox already include\n    # the dir BEFORE dispatch, so this row is the POST-FACTO forensic\n    # record that the session's write surface grew). Closed-enum `source`\n    # {slash_command, register_repo_root, session_start_snapshot, other}\n    # (the wire carries the first two; session_start_snapshot is reserved\n    # for the documented --add-dir-at-LAUNCH blind-spot mitigation — the\n    # launch flag never fires the event, so a SessionStart roots snapshot\n    # is the only producer that can cover it) + `directory_hash_prefix`\n    # (exact 12-lowercase-hex sha256 prefix of the absolute path, or \"\";\n    # the RAW directory path is NEVER persisted — LLM06 side-channel\n    # guard, same 12-hex token class as message_sha256_prefix below and\n    # the exact length check_directory_added.py computes).\n    \"directory_added_recorded\",\n    # (B) Notification lifecycle telemetry, emitted by\n    # check_notification.py (pure observer on the Notification event).\n    # Closed-enum `notification_type` {agent_needs_input, agent_completed,\n    # permission_request, other} — the harness enum is OPEN, so any\n    # unrecognized wire value COERCES to `other` (never echoed) — +\n    # `has_title` (bool) + `message_sha256_prefix` (exact 12-lowercase-hex\n    # sha256 prefix of the message body, or \"\"; the message/title TEXT is\n    # NEVER persisted — no-value-echo, a notification message can quote\n    # tool output or secrets).\n    \"notification_lifecycle\",\n    # PLAN-165 P2 (night-mode / D2) — Owner-invoked autonomy posture toggle\n    # forensic record, emitted by .claude/scripts/night-mode.py (the SINGLE\n    # writer of the per-machine overlay .claude/settings.local.json — the\n    # PLAN-165 P1 deny rule closes the tool Edit/Write path) once per on|off\n    # invocation. Registered via the PLAN-165 prerequisite ceremony;\n    # _KNOWN_ACTIONS 323 -> 324. Deny-by-default: dedicated _scrub_ branch +\n    # _NIGHT_MODE_TOGGLED_ALLOWLIST below, NEVER _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    # Closed-enum `mode` / `previous_mode` {acceptEdits, manual, absent,\n    # other} + closed-enum `result` {applied, noop, refused, failed, other}\n    # + `hostname_hash` (exact 12-lowercase-hex sha256 prefix of the machine\n    # hostname, or \"\"). DENIED on the wire: the overlay PATH, settings file\n    # CONTENT, marker content, the RAW hostname — settings JSON and paths\n    # can carry usernames, allowlists, and project identity (LLM06\n    # side-channel guard).\n    \"night_mode_toggled\",\n    # PLAN-179 W0 US2 (amendment 8.1 — the ADR-153 continuity successor\n    # rail) — EDGE-TRIGGERED context-pressure breadcrumb: the session\n    # crossed INTO a new context-usage percent bucket. A TRANSITION, never\n    # a per-turn sample — the hysteresis gate is\n    # should_emit_context_pressure() below, and without it the HMAC chain\n    # would take one row per prompt while the session sits in one rung.\n    # Registered via the staged PLAN-179 W0/W1 bundle; _KNOWN_ACTIONS\n    # 324 -> 325. Deny-by-default: dedicated _scrub_ branch +\n    # _CONTEXT_PRESSURE_OBSERVED_ALLOWLIST below, NEVER\n    # _EMIT_GENERIC_PASSTHROUGH\n    # ([[feedback-closed-enum-breadcrumb-must-not-echo-rejected-value]]).\n    # The ONLY caller-supplied fields are `used_bucket` (closed set of\n    # INTEGER PERCENT buckets {40,60,80,90,95} — the name carries the unit;\n    # the check is TYPE-strict because canonical_json refuses floats and a\n    # float here would discard the WHOLE event, S181/ADR-055-AMEND-2),\n    # `event_source` (closed enum, coerced to \"other\") and `plan_id`\n    # (strict PLAN-NNN shape check, coerced to \"unknown\"). DENIED on the\n    # wire: the raw token/byte counts, the transcript text, the plan path\n    # text, the prompt body.\n    \"context_pressure_observed\",\n    # PLAN-174 W1 (registered by the SENT-S318 pack; _KNOWN_ACTIONS\n    # 325 -> 326) — ceremony-lint ADR-186 escape-hatch breadcrumb:\n    # CEO_CEREMONY_LINT_UNLOCK=<sha256> + _REASON consumed by\n    # check-ceremony-script.py. Metadata-only wire (`file_sha256` 16-hex\n    # prefix + `reason_len` int); the reason TEXT never reaches the log.\n    # Emitter parked in 908707e until this registration existed.\n    \"ceremony_lint_unlock_used\",\n    # PLAN-182 W1 (ADR-079 S318 amendment §2; _KNOWN_ACTIONS 326 -> 327)\n    # — the ONE sanctioned salt-rotation register: minting a per-project\n    # .salt is OBSERVABLE in the chain, never silent. Metadata-only wire\n    # (`reason` closed enum + `salt_scope` fixed + `slug_sha256` 16-hex\n    # prefix); raw slug and salt-file path are excluded from the payload.\n    # The base `project` field still carries the absolute repository path.\n    # Emitted lazily\n    # by _lib/injection_salt.py at mint time (marker sidecar is the\n    # forensic ground truth when the emit path is unavailable).\n    \"salt_rotation_registered\",\n    # PLAN-179 W2/W4 (ADR-195 — work-boundary persistence; registered by the\n    # staged-w24 ceremony pack, Owner decision 2026-08-25 \"3 actions\";\n    # _KNOWN_ACTIONS 327 -> 330). All THREE are deny-by-default: a dedicated\n    # `action ==` scrub branch in emit_generic + the allowlists\n    # _LEDGER_CHECKPOINT_RECORDED_ALLOWLIST /\n    # _LEDGER_CHECKPOINT_SKIPPED_ALLOWLIST / _LEDGER_ENTRY_REJECTED_ALLOWLIST\n    # below, NEVER _EMIT_GENERIC_PASSTHROUGH.\n    #\n    # (1) The advisory work-boundary observation: a `git commit` landing\n    # plan-scoped work was inspected for its LEDGER.md checkpoint. Producer =\n    # check_ledger_checkpoint.py (PreToolUse/Bash), which never denies. Wire =\n    # closed enums (`outcome`, `scope_source`, `state_kind`), the strict\n    # PLAN-NNN id, and TYPE-strict INT counters clamped 0..99 (a float is\n    # refused by canonical_json and would discard the WHOLE event —\n    # S181/ADR-055-AMEND-2). DENIED on the wire: the commit MESSAGE, the\n    # committed PATHS, the ledger CONTENT, the repo root, any AC text.\n    \"ledger_checkpoint_recorded\",\n    # (2) The same rail's negative case, kept as its OWN action so \"the rail\n    # did not fire\" is countable instead of inferred from absence: the\n    # measure-first window needs a denominator, and \"skipped because the\n    # commit was out of scope\" and \"never observed at all\" are different\n    # facts.\n    \"ledger_checkpoint_skipped\",\n    # (3) The W4 ledger write-gate discard: an externally-sourced entry was\n    # refused fail-CLOSED. Producer = _lib/ledger_provenance.py. This action\n    # exists precisely so the discard is NOT filed as\n    # `prompt_injection_detected`: routing `scanner_unavailable` / `oversize`\n    # / `malformed_input` into a DETECTION action would poison the very FPR\n    # series the advisory window has to measure. Wire = closed enums + INT\n    # counters. DENIED on the wire: the rejected entry BODY (not even a\n    # preview), the entry id, and any path.\n    \"ledger_entry_rejected\",\n    # PLAN-179 W2 US8 (wave-179-close ceremony; SPEC v2.60) — SessionEnd\n    # memory-delta observation: one emit per session, immediately before\n    # `session_end` — activity in the shared project memory directory during\n    # this session's window; it does not establish session authorship.\n    # Stat-only producer; closed enums + INT counters only.\n    # DENIED on the wire: memory file names/basenames, file bodies, the\n    # memory-dir absolute path and the $HOME-derived slug, the raw\n    # session_start source line, any env value (LLM06 side-channel guard\n    # — the producer renders counts on the systemMessage operator channel,\n    # and never forwards basenames to the signed chain).\n    \"session_memory_delta_observed\",\n}\n","numLines":525,"startLine":1,"totalLines":525}},"tool_result_meta":[{"id":"toolu_01UAgQ1d3Krm5QpKJ11s3c14","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
