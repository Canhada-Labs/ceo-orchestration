{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y1qS3moofcpPrKbedk9Lgf","type":"tool_result","content":"1\t\"\"\"Confidence.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_safe_claim_id_hash', '_safe_payload_hash', '_safe_verifier_outcome', '_CLAIM_EMITTED_ALLOWLIST', '_CONFIDENCE_GATE_VERDICT_ALLOWLIST', '_CONFIDENCE_GATE_VERDICTS', '_CLAIM_SEVERITIES', 'emit_claim_emitted', 'emit_confidence_gate_verdict', '_CONFIDENCE_GATE_BLOCKED_ALLOWLIST', '_CONFIDENCE_GATE_FP_DRIFT_DETECTED_ALLOWLIST', 'emit_confidence_gate_blocked', 'emit_confidence_gate_fp_drift_detected')\n9\t\n10\t# -----------------------------------------------------------------------------\n11\t# PLAN-090-FOLLOWUP Wave A — claim producer pair (S138 R2 ACCEPT).\n12\t# Kernel-protected; registered via CEO_KERNEL_OVERRIDE=PLAN-090-FOLLOWUP-\n13\t# PRODUCER-PAIR + CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n14\t# Sec MF-3 caller-field deny-by-default per action.\n15\t# Raw claim bodies + verifier free-text NEVER persisted (LLM06 hold).\n16\t# -----------------------------------------------------------------------------\n17\t\n18\tdef _safe_claim_id_hash(raw: str) -> str:\n19\t    \"\"\"Return collision-safe claim_id of form '<claim_type>:<12-hex>'.\n20\t\n21\t    Accepts pre-formatted claim_id ('<type>:<12-hex>') ONLY if the\n22\t    prefix matches the KNOWN_KINDS grammar `^[a-z_]{1,32}$`; else\n23\t    rehashes raw via NFKC + sha256[:12] (Codex iter-1 P0-3 fold —\n24\t    prior version accepted ARBITRARY prefix, allowing a direct\n25\t    `emit_generic(claim_id=\"password=hunter2:deadbeefdead\")` to\n26\t    persist the secret unchanged through the \"defensive\" path).\n27\t\n28\t    Force `unknown:` prefix on rehash (no inheritance of caller\n29\t    prefix; mirrors `_persona_demand_safe_hash` strictness).\n30\t    \"\"\"\n31\t    import hashlib\n32\t    import re\n33\t    import