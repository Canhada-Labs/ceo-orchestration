{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QJcN4u2pJrbnLWaKs6QmKk","type":"tool_result","content":"36\t\n37\t\n38\tdef _fallback_log_path() -> Path:\n39\t    \"\"\"Return the /tmp fallback audit path, user-scoped.\n40\t\n41\t    Env override: ``CEO_AUDIT_LOG_FALLBACK_PATH`` for tests.\n42\t    \"\"\"\n43\t    override = os.environ.get(\"CEO_AUDIT_LOG_FALLBACK_PATH\")\n44\t    if override:\n45\t        return Path(override)\n46\t    try:\n47\t        user = getpass.getuser() or \"unknown\"\n48\t    except Exception:  # pragma: no cover\n49\t        user = os.environ.get(\"USER\") or \"unknown\"\n50\t    user = \"\".join(c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\"))\n51\t    return Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n52\t\n53\t\n54\tdef _emit_fallback_banner_once(primary: Path, fallback: Path, err: str) -> None:\n55\t    \"\"\"Emit `::warning::` stderr banner once per session (F-CHAOS-1).\"\"\"\n56\t    global _FALLBACK_NOTIFIED\n57\t    if _FALLBACK_NOTIFIED:\n58\t        return\n59\t    _FALLBACK_NOTIFIED = True\n60\t    try:\n61\t        sys.stderr.write(\n62\t            f\"::warning::audit-log write failed ({err}); \"\n63\t            f\"falling back to {fallback}. \"\n64\t            f\"Investigate writability of {primary.parent}.\\n\"\n65\t        )\n66\t        sys.stderr.flush()\n67\t    except Exception:  # pragma: no cover\n68\t        pass\n69\t\n70\t\n71\tdef _write_fallback(event_line: str) -> bool:\n72\t    \"\"\"Append ``event_line`` to fallback path with 0o600. Never raises.\"\"\"\n73\t    try:\n74\t        fallback = _fallback_log_path()\n75\t        fallback.parent.mkdir(parents=True, exist_ok=True)\n76\t        with fallback.open(\"a\", encoding=\"utf-8\") as f:\n77\t            f.write(event_line)\n78\t            # PLAN-025 F-obs-002 — durability on fallback path too; if the\n79\t            # primary failed and we're writing fallback, crash-safety matters\n80\t            # MORE than on the happy path.\n81\t            f.flush()\n82\t            try:\n83\t                os.fsync(f.fileno())\n84\t            except (OSError, AttributeError):\n85\t                pass\n86\t        try:\n87\t            os.chmod(fallback, 0o600)\n88\t        except OSError:\n89\t            pass\n90\t        return True\n91\t    except Exception as e:\n92\t        try:\n93\t            sys.stderr.write(\n94\t                f\"[audit_emit] fallback write ALSO failed: {type(e).__name__}: {e}\\n\"\n95\t            )\n96\t            sys.stderr.flush()\n97\t        except Exception:  # pragma: no cover\n98\t            pass\n99\t        return False\n100\t\n101\t\n102\tdef _safe_target_ref_hash_field(v):\n103\t    \"\"\"Return a non-empty 12-hex (or shorter) lowercase hash, else '' (fail-closed;\n104\t    never echoes a rejected value such as a raw branch name a caller tried to stuff).\"\"\"\n105\t    s = str(v or \"\")\n106\t    if s and len(s) <= 12 and all(c in \"0123456789abcdef\" for c in s):\n107\t        return s\n108\t    return \"\"\n109\t\n110\t\n111\tdef _accel_clamp_count(v):\n112\t    try:\n113\t        n = int(v)\n114\t    except (TypeError, ValueError):\n115\t        return 0\n116\t    return 0 if n < 0 else (99 if n > 99 else n)\n117\t\n118\t\n119\tdef _auto_compact_clamp_pct(v):\n120\t    \"\"\"Coerce to an int percent in [0, 100]; 0 on malformed (never echoes).\"\"\"\n121\t    try:\n122\t        n = int(v)\n123\t    except (TypeError, ValueError):\n124\t        return 0\n125\t    return 0 if n < 0 else (100 if n > 100 else n)\n126\t\n127\t\n128\tdef _e3_clamp01(v):\n129\t    \"\"\"Coerce to 0/1 (enforced flag). Anything truthy-but-weird -> 0 (safe).\"\"\"\n130\t    try:\n131\t        return 1 if int(v) == 1 else 0\n132\t    except (TypeError, ValueError):\n133\t        return 0\n134\t\n135\t\n136\tdef _e3_safe_path_hashes(v):\n137\t    \"\"\"Keep only comma-joined 12-hex tokens; drop anything else (a caller\n138\t    that tries to stuff a raw pat