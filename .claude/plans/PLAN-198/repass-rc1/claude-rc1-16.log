{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JAGUyMBA5P6A4TJ6NULf8s","type":"tool_result","content":"1\t\"\"\"Streaming.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\timport time\n8\t\n9\t__all__ = ('is_audit_stream_verbose', 'streaming_rate_admit', 'persona_auto_decision_rate_admit', '_PHASE_C_ENFORCING_FLIPPED_ALLOWLIST', 'emit_phase_c_enforcing_flipped', '_KILL_SWITCH_INVOKED_ALLOWLIST', 'emit_kill_switch_invoked', '_PERSONA_AUTO_DECISION_EMITTED_ALLOWLIST', 'emit_persona_auto_decision_emitted', '_PERSONA_AUTO_RATE_CAPPED_ALLOWLIST', 'emit_persona_auto_rate_capped', '_STREAMING_TOKEN_YIELDED_ALLOWLIST', 'emit_streaming_token_yielded', '_STREAMING_RATE_CAPPED_ALLOWLIST', 'emit_streaming_rate_capped', '_MCP_BEARER_FRICTION_OBSERVED_ALLOWLIST', 'emit_mcp_bearer_friction_observed', '_CONFIDENCE_GATE_BASELINE_EMITTED_ALLOWLIST', 'emit_confidence_gate_baseline_emitted', '_CAPABILITY_ROLLOUT_COMPLETE_ALLOWLIST', 'emit_capability_rollout_complete')\n10\t\n11\tdef is_audit_stream_verbose() -> bool:\n12\t    \"\"\"ADR-123 §4 — EXACT MATCH ``CEO_AUDIT_STREAM_VERBOSE=1`` only.\"\"\"\n13\t    return os.environ.get(_VERBOSE_STREAM_ENV) == _VERBOSE_STREAM_ARMED_VALUE\n14\t\n15\t\n16\tdef streaming_rate_admit(persona: str, _now: Callable[[], float] = time.monotonic) -> bool:\n17\t    \"\"\"Per-persona token bucket for streaming_token_yielded.\"\"\"\n18\t    now = _now()\n19\t    with _PLAN090_BUCKET_LOCK:\n20\t        last_ts, tokens = _PLAN090_STREAM_BUCKETS.get(persona, (now, _PLAN090_STREAM_BURST))\n21\t        elapsed_min = (now - last_ts) / 60.0\n22\t        refill = int(elapsed_min * _PLAN090_STREAM_REFILL_PER_MIN)\n23\t        if refill > 0:\n24\t            tokens = min(_PLAN090_STREAM_BURST, tokens + refill)\n25\t            last_ts = now\n26\t        if tokens <= 0:\n27\t            _PLAN090_STREAM_BUCKETS[persona] = (last_ts, tokens)\n28\t            return False\n29\t        _PLAN090_STREAM_BUCKETS[persona] = (last_ts, tokens - 1)\n30\t        return True\n31\t\n32\t\n33\tdef persona_auto_decision_rate_admit(\n34\t    persona: str, _now: Callable[[], float] = time.monotonic\n35\t) -> bool:\n36\t    \"\"\"Per-persona token bucket for persona_auto_decision_emitted.\"\"\"\n37\t    now = _now()\n38\t    with _PLAN090_BUCKET_LOCK:\n39\t        last_ts, tokens = _PLAN090_PERSONA_BUCKETS.get(persona, (now, _PLAN090_PERSONA_BURST))\n40\t        elapsed_min = (now - last_ts) / 60.0\n41\t        refill = int(elapsed_min * _PLAN090_PERSONA_REFILL_PER_MIN)\n42\t        if refill > 0:\n43\t            tokens = min(_PLAN090_PERSONA_BURST, tokens + refill)\n44\t            last_ts = now\n45\t        if tokens <= 0:\n46\t            _PLAN090_PERSONA_BUCKETS[persona] = (last_ts, tokens)\n47\t            return False\n48\t        _PLAN090_PERSONA_BUCKETS[persona] = (last_ts, tokens - 1)\n49\t        return True\n50\t\n51\t\n52\t_PHASE_C_ENFORCING_FLIPPED_ALLOWLIST = frozenset({\n53\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n54\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n55\t    \"hmac\", \"hmac_error\",\n56\t    \"migration_phase\", \"ts_unix\",\n57\t})\n58\t\n59\t\n60\tdef emit_phase_c_enforcing_flipped(\n61\t    *,\n62\t    migration_phase: str = \"first_session\",\n63\t    ts_unix: int = 0,\n64\t    session_id: str = \"\",\n65\t    project: str = \"\",\n66\t) -> None:\n67\t    \"\"\"Emit phase_c_enforcing_flipped (PLAN-090 Wave A.4 / ADR-118-AMEND-1 §4).\"\"\"\n68\t    raw_event: Dict[str, Any] = {\n69\t        \"action\": \"phase_c_enforcing_flipped\",\n70\t        \"session_id\": session_id,\n71\t        \"project\": project,\n72\t        \"migration_phase\": (migration_phase or \"\")[:32],\n73\t        \"ts_unix\": int(ts_unix),\n74\t    }\n75\t    cleaned, _ = _scrub_ceo_boot_event(raw_event, _PHASE_C_ENFORCING_FLIPPED_ALLOWLIST)\n76\t    _write_event(cleaned)\n77\t\n78\t\n79\t_KILL_SWITCH_INVOKED_ALLOWLIST = frozenset({\n80\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n81\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n82\t    \"hmac\", \"hmac_error\",\n83\t    \"env_value\",\n84\t})\n85\t\n86\t\n87\tdef emit_kill_switch_invoked(\n88\t    *,\n89\t    env_value: str = \"0\",\n90\t    session_id: str = \"\",\n91\t    project: str = \"\",\n92\t) -> None:\n93\t    \"\"\"Emit kill_switch_invoked (PLAN-090 Wave A.4 / ADR-118-AMEND-1 §3).\"\"\"\n94\t    raw_event: Dict[str, Any] = {\n95\t        \"action\": \"kill_switch_invoked\",\n96\t        \"session_id\": session_id,\n97\t        \"project\": project,\n98\t        \"env_value\": (env_value or \"\")[:8],\n99\t    }\n100\t    cleaned, _ = _scrub_ceo_boot_event(raw_event, _KILL_SWITCH_INVOKED_ALLOWLIST)\n101\t    _write_event(cleaned)\n102\t\n103\t\n104\t_PERSONA_AUTO_DECISION_EMITTED_ALLOWLIST = frozenset({\n105\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n106\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n107\t    \"hmac\", \"hmac_error\",\n108\t    \"atlas_technique\",\n109\t    \"persona\", \"primitive\", \"decision\", \"decision_rationale\",\n110\t})\n111\t\n112\t\n113\tdef emit_persona_auto_decision_emitted(\n114\t    *,\n115\t    persona: str = \"\",\n116\t    primitive: str = \"\",\n117\t    decision: str = \"\",\n118\t    decision_rationale: str = \"\",\n119\t    session_id: str = \"\",\n120\t    project: str = \"\",\n121\t    atlas_technique: Optional[str] = None,\n122\t) -> None:\n123\t    \"\"\"Emit persona_auto_decision_emitted (PLAN-090 Wave A.4).\"\"\"\n124\t    if not persona_auto_decision_rate_admit(persona):\n125\t        return\n126\t    raw_event: Dict[str, Any] = {\n127\t        \"action\": \"persona_auto_decision_emitted\",\n128\t        \"session_id\": session_id,\n129\t        \"project\": project,\n130\t        \"atlas_technique\": atlas_technique or \"T1059\",\n131\t        \"persona\": (persona or