{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016V1qUBv9RmCnp6zZVeYFW1","type":"tool_result","content":"1\t\"\"\"Finalization.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('emit_chain_reset_marker', 'emit_task_route_key_dropped', 'emit_reality_ledger_key_dropped', 'emit_swarm_finalize_grouped', 'emit_swarm_finalize_committed', 'emit_skill_reference_never_read', 'emit_escalation_detected', 'emit_escalation_dispatched', 'emit_escalation_suppressed', 'emit_escalation_baseline_recorded', 'emit_tournament_run_started', 'emit_tournament_task_scored', 'emit_tournament_run_completed', 'emit_tournament_budget_projected', 'emit_tournament_budget_exceeded', 'emit_tournament_aborted', 'emit_tournament_fixture_rejected', 'emit_tournament_judge_hijack_suspected')\n9\t\n10\t# PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — chain_reset_marker\n11\t# Registered via kernel-override PLAN-112-FOLLOWUP-WAVE-B3-AUDIT-EMIT-EXTENSION\n12\t# at v1.39.4. Per ADR-055-AMEND-2: this is the synthetic genesis entry\n13\t# written as line 1 of every rotation-created fresh audit-log.jsonl.\n14\t# Verifier marker-enforcement is scoped via audit-log.rotation-manifest.json\n15\t# sidecar (NO archive walking — preserves rejected-Path-A boundary).\n16\tdef emit_chain_reset_marker(\n17\t    previous_archive_path: str,\n18\t    previous_archive_last_hmac: str,\n19\t    rotation_ts: str,\n20\t    rotation_trigger: str = \"size_threshold\",\n21\t    session_id: str = \"\",\n22\t    project: str = \"\",\n23\t) -> None:\n24\t    \"\"\"Emit chain_reset_marker as the genesis-anchored line 1 of a\n25\t    rotation-created fresh audit-log.jsonl.\n26\t\n27\t    Per ADR-055-AMEND-2 (drafted by PLAN-112-FOLLOWUP-hmac-tamper-fix\n28\t    at v1.39.4): rotation MUST emit this marker as the first entry of\n29\t    the new file, HMAC-anchored at GENESIS_PREV. The marker carries the\n30\t    rotated archive's last_hmac as a DATA field (not a chain link), so\n31\t    forensic continuity is preserved across rotation without inverting\n32\t    the verifier's \"log = source of truth\" doctrine.\n33\t\n34\t    Caller (`audit_emit._rotate_if_needed_safe` site OR Wave B.2\n35\t    quarantine ceremony script) must hold the canonical FileLock and\n36\t    write the marker BEFORE releasing the lock, so a concurrent emit\n37\t    cannot land a non-marker line 1.\n38\t\n39\t    Args:\n40\t      previous_archive_path: relative path of the rotated archive,\n41\t        e.g., `audit-log-2026-05-21-pre-fix-tampered.jsonl`\n42\t      previous_archive_last_hmac: hex digest of the last HMAC-bearing\n43\t        entry of the rotated archive (32-byte HMAC SHA-256 hex-encoded;\n44\t        empty string allowed for first-install/no-prior-chain case)\n45\t      rotation_ts: ISO-8601 UTC timestamp of the rotation event\n46\t      rotation_trigger: one of `size_threshold` | `manual` | `owner_rotation`\n47\t        | `quarantine_pre_fix` (the last applies to Wave B.2 ceremony)\n48\t    \"\"\"\n49\t    rotation_trigger = _normalize_rotation_trigger(rotation_trigger)\n50\t    event: Dict[str, Any] = {\n51\t        \"action\": \"chain_reset_marker\",\n52\t        \"previous_archive_path\": str(previous_archive_path)[:256],\n53\t        \"previous_archive_last_hmac\": str(previous_archive_last_hmac)[:64],\n54\t        \"rotation_ts\": str(rotation_ts)[:32],\n55\t        \"rotation_trigger\": rotation_trigger,\n56\t        \"session_id\": session_id,\n57\t        \"project\": project,\n58\t    }\n59\t    _write_event(event)\n60\t\n61\t\n62\t# =============================================================================\n63\t# PLAN-113 Phase B WIRE-AUDIT — typed wrappers for previously-orphan actions.\n64\t# Each wrapper follows the Sec MF-3 pattern: explicit field allowlist,\n65\t# fail-open (never raises), stdlib-only.\n66\t# =============================================================================\n67\t\n68\t\n69\tdef emit_task_route_key_dropped(\n70\t    *,\n71\t    key: str = \"\",\n72\t    reason_code: str = \"\",\n73\t    session_id: str = \"\",\n74\t    project: str = \"\",\n75\t) -> None:\n76\t    \"\"\"Emit task_route_key_dropped when AEK drops an unexpected field.\n77\t\n78\t    Emitted by the reality-ledger / task-router when an unknown key\n79\t    arrives in a contract payload.  Sec MF-3: only safe, non-content\n80\t    fields persist.\n81\t    \"\"\"\n82\t    emit_generic(\n83\t        \"task_route_key_dropped\",\n84\t        key=str(key)[:64],\n85\t        reason_code=str(reason_code)[:32],\n86\t        session_id=session_id,\n87\t        project=project,\n88\t    )\n89\t\n90\t\n91\tdef emit_reality_ledger_key_dropped(\n92\t    *,\n93\t    key: str = \"\",\n94\t    detector: str = \"\",\n95\t    session_id: str = \"\",\n96\t    project: str = \"\",\n97\t) -> None:\n98\t    \"\"\"Emit reality_ledger_key_dropped when the reality-ledger strips a field.\n99\t\n100\t    Fired by reality-ledger.py on allowlist-mismatch before persisting\n101\t    a finding. Sec MF-3: no raw field value; only key name + detector.\n102\t    \"\"\"\n103\t    emit_generic(\n104\t        \"reality_ledger_key_dropped\",\n105\t        key=str(key)[:64],\n106\t        detector=str(detector)[:64],\n107\t        session_id=session_id,\n108\t        project=project,\n109\t    )\n110\t\n111\t\n112\tdef emit_swarm_finalize_grouped(\n113\t    *,\n114\t    swarm_id: str = \"\",\n115\t    groups: int = 0,\n116\t    session_id: str = \"\",\n117\t    project: str = \"\",\n118\t) -> None:\n119\t    \"\"\"Emit swarm_finalize_grouped when the coordinator groups winner outputs.\n120\t\n121\t    Fired by the swarm coordinator after tournament selection, before\n122\t    commit.  Sec MF-3: no raw patch content or file paths.\n123\t    \"\"\"\n124\t    emit_generic(\n125\t        \"swarm_finalize_grouped\",\n126\t        swarm_id=str(swarm_id)[:64],\n127\t        groups=int(groups),\n128\t        session_id=session_id,\n129\t        project=project,\n130\t    )\n131\t\n132\t\n133\tdef emit_swarm_finalize_committed(\n134\t    *,\n135\t    swarm_id: str = \"\",\n136\t    commit: str = \"\",\n137\t    session_id: str = \"\",\n138\t    project: str = \"\",\n139\t) -> None:\n140\t    \"\"\"Emit swarm_finalize_committed when the coordinator commits the winner.\n141\t\n142\t    Fired after the winning patch is applied and committed to the branch.\n143\t    ``commit`` is a 7-char git SHA-prefix (or empty if pre-commit).\n144\t    Sec MF-3: no raw patch content or file paths.\n145\t    \"\"\"\n146\t    emit_generic(\n147\t        \"swarm_finalize_committed\",\n148\t        swarm_id=str(swarm_id)[:64],\n149\t        commit=str(commit)[:16],\n150\t        session_id=session_id,\n151\t        project=project,\n152\t    )\n153\t\n154\t\n155\tdef emit_skill_reference_never_read(\n156\t    *,\n157\t    skill_path: str = \"\",\n158\t    session_id: str = \"\",\n159\t    project: str = \"\",\n160\t) -> None:\n161\t    \"\"\"Emit skill_reference_never_read when a pinned SKILL.md is never Read.\n162\t\n163\t    Fired by check_skill_reference_read.py on SubagentStop when a\n164\t    skill-reference claim was made at spawn time but the SKILL.md was\n165\t    never Read during the sub-agent session.  Sec MF-3: no raw SKILL\n166\t    content; only a 12-hex path hash.\n167\t    \"\"\"\n168\t    import hashlib as _hashlib\n169\t    path_hash = _hashlib.sha256(\n170\t        str(skill_path).encode(\"utf-8\", errors=\"replace\")\n171\t    ).hexdigest()[:12]\n172\t    emit_generic(\n173\t        \"skill_reference_never_read\",\n174\t        skill_path_hash=path_hash,\n175\t        session_id=session_id,\n176\t        project=project,\n177\t    )\n178\t\n179\t\n180\t# ---------------------------------------------------------------------------\n181\t# Escalation cluster typed wrappers (PLAN-048 Phase 2 / ceo-escalation-\n182\t# detector.py). Sec MF-3 enforced: no raw prompt content, no session\n183\t# detail text — only signal metadata.\n184\t# ---------------------------------------------------------------------------\n185\t\n186\t\n187\tdef emit_escalation_detected(\n188\t    *,\n189\t    signal: str = \"\",\n190\t    severity: str = \"\",\n191\t    plan_id: str = \"\",\n192\t    session_id: str = \"\",\n193\t    project: str = \"\",\n194\t) -> None:\n195\t    \"\"\"Emit escalation_detected when a PLAN-048 escalation signal fires.\"\"\"\n196\t    emit_generic(\n197\t        \"escalation_detected\",\n198\t        signal=str(signal)[:64],\n199\t        severity=str(severity)[:16],\n200\t        plan_id=str(plan_id)[:32],\n201\t        session_id=session_id,\n202\t        project=project,\n203\t    )\n204\t\n205\t\n206\tdef emit_escalation_dispatched(\n207\t    *,\n208\t    signal: str = \"\",\n209\t    target_model: str = \"\",\n210\t    plan_id: str = \"\",\n211\t    session_id: str = \"\",\n212\t    project: str = \"\",\n213\t) -> None:\n214\t    \"\"\"Emit escalation_dispatched when Opus re-dispatch is triggered.\"\"\"\n215\t    emit_generic(\n216\t        \"escalation_dispatched\",\n217\t        signal=str(signal)[:64],\n218\t        target_model=str(target_model)[:64],\n219\t        plan_id=str(plan_id)[:32],\n220\t        session_id=session_id,\n221\t        project=project,\n222\t    )\n223\t\n224\t\n225\tdef emit_escalation_suppressed(\n226\t    *,\n227\t    signal: str = \"\",\n228\t    reason_code: str = \"\",\n229\t    session_id: str = \"\",\n230\t    project: str = \"\",\n231\t) -> None:\n232\t    \"\"\"Emit escalation_suppressed when escalation is rate-limited or suppressed.\"\"\"\n233\t    emit_generic(\n234\t        \"escalation_suppressed\",\n235\t        signal=str(signal)[:64],\n236\t        reason_code=str(reason_code)[:32],\n237\t        session_id=session_id,\n238\t        project=project,\n239\t    )\n240\t\n241\t\n242\tdef emit_escalation_baseline_recorded(\n243\t    *,\n244\t    signals_count: int = 0,\n245\t    session_id: str = \"\",\n246\t    project: str = \"\",\n247\t) -> None:\n248\t    \"\"\"Emit escalation_baseline_recorded at baseline-observation session end.\"\"\"\n249\t    emit_generic(\n250\t        \"escalation_baseline_recorded\",\n251\t        signals_count=int(signals_count),\n252\t        session_id=session_id,\n253\t        project=project,\n254\t    )\n255\t\n256\t\n257\t# ---------------------------------------------------------------------------\n258\t# Tournament cluster typed wrappers (PLAN-032 / ADR-063).\n259\t# The tournament module (scripts/swarm/tournament.py) calls these after\n260\t# scoring + selection. Sec MF-3: no raw patch content.\n261\t# ---------------------------------------------------------------------------\n262\t\n263\t\n264\tdef emit_tournament_run_started(\n265\t    *,\n266\t    swarm_id: str = \"\",\n267\t    candidate_count: int = 0,\n268\t    direction: str = \"\",\n269\t    session_id: str = \"\",\n270\t    project: str = \"\",\n271\t) -> None:\n272\t    \"\"\"Emit tournament_run_started at the beginning of a best-of-N run.\"\"\"\n273\t    emit_generic(\n274\t        \"tournament_run_started\",\n275\t        swarm_id=str(swarm_id)[:64],\n276\t        candidate_count=int(candidate_count),\n277\t        direction=str(direction)[:16],\n278\t        session_id=session_id,\n279\t        project=project,\n280\t    )\n281\t\n282\t\n283\tdef emit_tournament_task_scored(\n284\t    *,\n285\t    swarm_id: str = \"\",\n286\t    loop_id: str = \"\",\n287\t    score_bps: int = 0,\n288\t    tests_passed: int = 0,\n289\t    tests_failed: int = 0,\n290\t    session_id: str = \"\",\n291\t    project: str = \"\",\n292\t) -> None:\n293\t    \"\"\"Emit tournament_task_scored when a candidate receives its score.\n294\t\n295\t    ``score_bps`` is integer basis-points (score × 1000) to satisfy\n296\t    canonical_json no-floats invariant on HMAC-chained fields.\n297\t    \"\"\"\n298\t    emit_generic(\n299\t        \"tournament_task_scored\",\n300\t        swarm_id=str(swarm_id)[:64],\n301\t        loop_id=str(loop_id)[:64],\n302\t        score_bps=int(score_bps),\n303\t        tests_passed=int(tests_passed),\n304\t        tests_failed=int(tests_failed),\n305\t        session_id=session_id,\n306\t        project=project,\n307\t    )\n308\t\n309\t\n310\tdef emit_tournament_run_completed(\n311\t    *,\n312\t    swarm_id: str = \"\",\n313\t    winner_loop_id: str = \"\",\n314\t    rejected_count: int = 0,\n315\t    decisive: bool = True,\n316\t    session_id: str = \"\",\n317\t    project: str = \"\",\n318\t) -> None:\n319\t    \"\"\"Emit tournament_run_completed after the winner is determined.\"\"\"\n320\t    emit_generic(\n321\t        \"tournament_run_completed\",\n322\t        swarm_id=str(swarm_id)[:64],\n323\t        winner_loop_id=str(winner_loop_id)[:64],\n324\t        rejected_count=int(rejected_count),\n325\t        decisive=bool(decisive),\n326\t        session_id=session_id,\n327\t        project=project,\n328\t    )\n329\t\n330\t\n331\tdef emit_tournament_budget_projected(\n332\t    *,\n333\t    swarm_id: str = \"\",\n334\t    projected_cost_cents: int = 0,\n335\t    candidate_count: int = 0,\n336\t    session_id: str = \"\",\n337\t    project: str = \"\",\n338\t) -> None:\n339\t    \"\"\"Emit tournament_budget_projected with cost estimate before run.\"\"\"\n340\t    emit_generic(\n341\t        \"tournament_budget_projected\",\n342\t        swarm_id=str(swarm_id)[:64],\n343\t        projected_cost_cents=int(projected_cost_cents),\n344\t        candidate_count=int(candidate_count),\n345\t        session_id=session_id,\n346\t        project=project,\n347\t    )\n348\t\n349\t\n350\tdef emit_tournament_budget_exceeded(\n351\t    *,\n352\t    swarm_id: str = \"\",\n353\t    actual_cost_cents: int = 0,\n354\t    cap_cents: int = 0,\n355\t    session_id: str = \"\",\n356\t    project: str = \"\",\n357\t) -> None:\n358\t    \"\"\"Emit tournament_budget_exceeded when cost cap is breached.\"\"\"\n359\t    emit_generic(\n360\t        \"tournament_budget_exceeded\",\n361\t        swarm_id=str(swarm_id)[:64],\n362\t        actual_cost_cents=int(actual_cost_cents),\n363\t        cap_cents=int(cap_cents),\n364\t        session_id=session_id,\n365\t        project=project,\n366\t    )\n367\t\n368\t\n369\tdef emit_tournament_aborted(\n370\t    *,\n371\t    swarm_id: str = \"\",\n372\t    reason: str = \"\",\n373\t    session_id: str = \"\",\n374\t    project: str = \"\",\n375\t) -> None:\n376\t    \"\"\"Emit tournament_aborted when the tournament cannot complete.\"\"\"\n377\t    emit_generic(\n378\t        \"tournament_aborted\",\n379\t        swarm_id=str(swarm_id)[:64],\n380\t        reason=str(reason)[:64],\n381\t        session_id=session_id,\n382\t        project=project,\n383\t    )\n384\t\n385\t\n386\tdef emit_tournament_fixture_rejected(\n387\t    *,\n388\t    swarm_id: str = \"\",\n389\t    loop_id: str = \"\",\n390\t    reason: str = \"\",\n391\t    session_id: str = \"\",\n392\t    project: str = \"\",\n393\t) -> None:\n394\t    \"\"\"Emit tournament_fixture_rejected when a candidate fixture is invalid.\"\"\"\n395\t    emit_generic(\n396\t        \"tournament_fixture_rejected\",\n397\t        swarm_id=str(swarm_id)[:64],\n398\t        loop_id=str(loop_id)[:64],\n399\t        reason=str(reason)[:64],\n400\t        session_id=session_id,\n401\t        project=project,\n402\t    )\n403\t\n404\t\n405\tdef emit_tournament_judge_hijack_suspected(\n406\t    *,\n407\t    swarm_id: str = \"\",\n408\t    loop_id: str = \"\",\n409\t    indicator: str = \"\",\n410\t    session_id: str = \"\",\n411\t    project: str = \"\",\n412\t) -> None:\n413\t    \"\"\"Emit tournament_judge_hijack_suspected on adversarial judge indicators.\"\"\"\n414\t    emit_generic(\n415\t        \"tournament_judge_hijack_suspected\",\n416\t        swarm_id=str(swarm_id)[:64],\n417\t        loop_id=str(loop_id)[:64],\n418\t        indicator=str(indicator)[:64],\n419\t        session_id=session_id,\n420\t        project=project,\n421\t    )\n422\t"}]},"parent_tool_use_id":null,"session_id":"2ad11fd4-f4ee-435e-bb65-ad9fa0e55842","uuid":"949ebb2d-3f25-4c0f-9e98-75c7a5a8c4c2","timestamp":"2026-11-15T10:09:55.990Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_audit_emit_parts/finalization.py","content":"\"\"\"Finalization.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('emit_chain_reset_marker', 'emit_task_route_key_dropped', 'emit_reality_ledger_key_dropped', 'emit_swarm_finalize_grouped', 'emit_swarm_finalize_committed', 'emit_skill_reference_never_read', 'emit_escalation_detected', 'emit_escalation_dispatched', 'emit_escalation_suppressed', 'emit_escalation_baseline_recorded', 'emit_tournament_run_started', 'emit_tournament_task_scored', 'emit_tournament_run_completed', 'emit_tournament_budget_projected', 'emit_tournament_budget_exceeded', 'emit_tournament_aborted', 'emit_tournament_fixture_rejected', 'emit_tournament_judge_hijack_suspected')\n\n# PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — chain_reset_marker\n# Registered via kernel-override PLAN-112-FOLLOWUP-WAVE-B3-AUDIT-EMIT-EXTENSION\n# at v1.39.4. Per ADR-055-AMEND-2: this is the synthetic genesis entry\n# written as line 1 of every rotation-created fresh audit-log.jsonl.\n# Verifier marker-enforcement is scoped via audit-log.rotation-manifest.json\n# sidecar (NO archive walking — preserves rejected-Path-A boundary).\ndef emit_chain_reset_marker(\n    previous_archive_path: str,\n    previous_archive_last_hmac: str,\n    rotation_ts: str,\n    rotation_trigger: str = \"size_threshold\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit chain_reset_marker as the genesis-anchored line 1 of a\n    rotation-created fresh audit-log.jsonl.\n\n    Per ADR-055-AMEND-2 (drafted by PLAN-112-FOLLOWUP-hmac-tamper-fix\n    at v1.39.4): rotation MUST emit this marker as the first entry of\n    the new file, HMAC-anchored at GENESIS_PREV. The marker carries the\n    rotated archive's last_hmac as a DATA field (not a chain link), so\n    forensic continuity is preserved across rotation without inverting\n    the verifier's \"log = source of truth\" doctrine.\n\n    Caller (`audit_emit._rotate_if_needed_safe` site OR Wave B.2\n    quarantine ceremony script) must hold the canonical FileLock and\n    write the marker BEFORE releasing the lock, so a concurrent emit\n    cannot land a non-marker line 1.\n\n    Args:\n      previous_archive_path: relative path of the rotated archive,\n        e.g., `audit-log-2026-05-21-pre-fix-tampered.jsonl`\n      previous_archive_last_hmac: hex digest of the last HMAC-bearing\n        entry of the rotated archive (32-byte HMAC SHA-256 hex-encoded;\n        empty string allowed for first-install/no-prior-chain case)\n      rotation_ts: ISO-8601 UTC timestamp of the rotation event\n      rotation_trigger: one of `size_threshold` | `manual` | `owner_rotation`\n        | `quarantine_pre_fix` (the last applies to Wave B.2 ceremony)\n    \"\"\"\n    rotation_trigger = _normalize_rotation_trigger(rotation_trigger)\n    event: Dict[str, Any] = {\n        \"action\": \"chain_reset_marker\",\n        \"previous_archive_path\": str(previous_archive_path)[:256],\n        \"previous_archive_last_hmac\": str(previous_archive_last_hmac)[:64],\n        \"rotation_ts\": str(rotation_ts)[:32],\n        \"rotation_trigger\": rotation_trigger,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\n# =============================================================================\n# PLAN-113 Phase B WIRE-AUDIT — typed wrappers for previously-orphan actions.\n# Each wrapper follows the Sec MF-3 pattern: explicit field allowlist,\n# fail-open (never raises), stdlib-only.\n# =============================================================================\n\n\ndef emit_task_route_key_dropped(\n    *,\n    key: str = \"\",\n    reason_code: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit task_route_key_dropped when AEK drops an unexpected field.\n\n    Emitted by the reality-ledger / task-router when an unknown key\n    arrives in a contract payload.  Sec MF-3: only safe, non-content\n    fields persist.\n    \"\"\"\n    emit_generic(\n        \"task_route_key_dropped\",\n        key=str(key)[:64],\n        reason_code=str(reason_code)[:32],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_reality_ledger_key_dropped(\n    *,\n    key: str = \"\",\n    detector: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit reality_ledger_key_dropped when the reality-ledger strips a field.\n\n    Fired by reality-ledger.py on allowlist-mismatch before persisting\n    a finding. Sec MF-3: no raw field value; only key name + detector.\n    \"\"\"\n    emit_generic(\n        \"reality_ledger_key_dropped\",\n        key=str(key)[:64],\n        detector=str(detector)[:64],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_swarm_finalize_grouped(\n    *,\n    swarm_id: str = \"\",\n    groups: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit swarm_finalize_grouped when the coordinator groups winner outputs.\n\n    Fired by the swarm coordinator after tournament selection, before\n    commit.  Sec MF-3: no raw patch content or file paths.\n    \"\"\"\n    emit_generic(\n        \"swarm_finalize_grouped\",\n        swarm_id=str(swarm_id)[:64],\n        groups=int(groups),\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_swarm_finalize_committed(\n    *,\n    swarm_id: str = \"\",\n    commit: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit swarm_finalize_committed when the coordinator commits the winner.\n\n    Fired after the winning patch is applied and committed to the branch.\n    ``commit`` is a 7-char git SHA-prefix (or empty if pre-commit).\n    Sec MF-3: no raw patch content or file paths.\n    \"\"\"\n    emit_generic(\n        \"swarm_finalize_committed\",\n        swarm_id=str(swarm_id)[:64],\n        commit=str(commit)[:16],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_skill_reference_never_read(\n    *,\n    skill_path: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit skill_reference_never_read when a pinned SKILL.md is never Read.\n\n    Fired by check_skill_reference_read.py on SubagentStop when a\n    skill-reference claim was made at spawn time but the SKILL.md was\n    never Read during the sub-agent session.  Sec MF-3: no raw SKILL\n    content; only a 12-hex path hash.\n    \"\"\"\n    import hashlib as _hashlib\n    path_hash = _hashlib.sha256(\n        str(skill_path).encode(\"utf-8\", errors=\"replace\")\n    ).hexdigest()[:12]\n    emit_generic(\n        \"skill_reference_never_read\",\n        skill_path_hash=path_hash,\n        session_id=session_id,\n        project=project,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Escalation cluster typed wrappers (PLAN-048 Phase 2 / ceo-escalation-\n# detector.py). Sec MF-3 enforced: no raw prompt content, no session\n# detail text — only signal metadata.\n# ---------------------------------------------------------------------------\n\n\ndef emit_escalation_detected(\n    *,\n    signal: str = \"\",\n    severity: str = \"\",\n    plan_id: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit escalation_detected when a PLAN-048 escalation signal fires.\"\"\"\n    emit_generic(\n        \"escalation_detected\",\n        signal=str(signal)[:64],\n        severity=str(severity)[:16],\n        plan_id=str(plan_id)[:32],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_escalation_dispatched(\n    *,\n    signal: str = \"\",\n    target_model: str = \"\",\n    plan_id: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit escalation_dispatched when Opus re-dispatch is triggered.\"\"\"\n    emit_generic(\n        \"escalation_dispatched\",\n        signal=str(signal)[:64],\n        target_model=str(target_model)[:64],\n        plan_id=str(plan_id)[:32],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_escalation_suppressed(\n    *,\n    signal: str = \"\",\n    reason_code: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit escalation_suppressed when escalation is rate-limited or suppressed.\"\"\"\n    emit_generic(\n        \"escalation_suppressed\",\n        signal=str(signal)[:64],\n        reason_code=str(reason_code)[:32],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_escalation_baseline_recorded(\n    *,\n    signals_count: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit escalation_baseline_recorded at baseline-observation session end.\"\"\"\n    emit_generic(\n        \"escalation_baseline_recorded\",\n        signals_count=int(signals_count),\n        session_id=session_id,\n        project=project,\n    )\n\n\n# ---------------------------------------------------------------------------\n# Tournament cluster typed wrappers (PLAN-032 / ADR-063).\n# The tournament module (scripts/swarm/tournament.py) calls these after\n# scoring + selection. Sec MF-3: no raw patch content.\n# ---------------------------------------------------------------------------\n\n\ndef emit_tournament_run_started(\n    *,\n    swarm_id: str = \"\",\n    candidate_count: int = 0,\n    direction: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_run_started at the beginning of a best-of-N run.\"\"\"\n    emit_generic(\n        \"tournament_run_started\",\n        swarm_id=str(swarm_id)[:64],\n        candidate_count=int(candidate_count),\n        direction=str(direction)[:16],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_tournament_task_scored(\n    *,\n    swarm_id: str = \"\",\n    loop_id: str = \"\",\n    score_bps: int = 0,\n    tests_passed: int = 0,\n    tests_failed: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_task_scored when a candidate receives its score.\n\n    ``score_bps`` is integer basis-points (score × 1000) to satisfy\n    canonical_json no-floats invariant on HMAC-chained fields.\n    \"\"\"\n    emit_generic(\n        \"tournament_task_scored\",\n        swarm_id=str(swarm_id)[:64],\n        loop_id=str(loop_id)[:64],\n        score_bps=int(score_bps),\n        tests_passed=int(tests_passed),\n        tests_failed=int(tests_failed),\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_tournament_run_completed(\n    *,\n    swarm_id: str = \"\",\n    winner_loop_id: str = \"\",\n    rejected_count: int = 0,\n    decisive: bool = True,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_run_completed after the winner is determined.\"\"\"\n    emit_generic(\n        \"tournament_run_completed\",\n        swarm_id=str(swarm_id)[:64],\n        winner_loop_id=str(winner_loop_id)[:64],\n        rejected_count=int(rejected_count),\n        decisive=bool(decisive),\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_tournament_budget_projected(\n    *,\n    swarm_id: str = \"\",\n    projected_cost_cents: int = 0,\n    candidate_count: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_budget_projected with cost estimate before run.\"\"\"\n    emit_generic(\n        \"tournament_budget_projected\",\n        swarm_id=str(swarm_id)[:64],\n        projected_cost_cents=int(projected_cost_cents),\n        candidate_count=int(candidate_count),\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_tournament_budget_exceeded(\n    *,\n    swarm_id: str = \"\",\n    actual_cost_cents: int = 0,\n    cap_cents: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_budget_exceeded when cost cap is breached.\"\"\"\n    emit_generic(\n        \"tournament_budget_exceeded\",\n        swarm_id=str(swarm_id)[:64],\n        actual_cost_cents=int(actual_cost_cents),\n        cap_cents=int(cap_cents),\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_tournament_aborted(\n    *,\n    swarm_id: str = \"\",\n    reason: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_aborted when the tournament cannot complete.\"\"\"\n    emit_generic(\n        \"tournament_aborted\",\n        swarm_id=str(swarm_id)[:64],\n        reason=str(reason)[:64],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_tournament_fixture_rejected(\n    *,\n    swarm_id: str = \"\",\n    loop_id: str = \"\",\n    reason: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_fixture_rejected when a candidate fixture is invalid.\"\"\"\n    emit_generic(\n        \"tournament_fixture_rejected\",\n        swarm_id=str(swarm_id)[:64],\n        loop_id=str(loop_id)[:64],\n        reason=str(reason)[:64],\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_tournament_judge_hijack_suspected(\n    *,\n    swarm_id: str = \"\",\n    loop_id: str = \"\",\n    indicator: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit tournament_judge_hijack_suspected on adversarial judge indicators.\"\"\"\n    emit_generic(\n        \"tournament_judge_hijack_suspected\",\n        swarm_id=str(swarm_id)[:64],\n        loop_id=str(loop_id)[:64],\n        indicator=str(indicator)[:64],\n        session_id=session_id,\n        project=project,\n    )\n","numLines":422,"startLine":1,"totalLines":422}},"tool_result_meta":[{"id":"toolu_016V1qUBv9RmCnp6zZVeYFW1","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
