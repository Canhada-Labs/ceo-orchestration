pired\":\n40\t        event, dropped = _scrub_ceo_boot_event(event, _LESSON_EXPIRED_ALLOWLIST)\n41\t        event[\"lesson_id\"] = _learning_token_field(event.get(\"lesson_id\"))\n42\t        event[\"age_days\"] = _learning_int_field(event.get(\"age_days\"), 100000)\n43\t        if event.get(\"created_at_source\") not in _LESSON_CREATED_AT_SOURCE_ENUM:\n44\t            event[\"created_at_source\"] = \"file\"\n45\t        if dropped:\n46\t            _breadcrumb(\n47\t                \"emit_generic lesson_expired dropped: %s\" % sorted(dropped)[:10]\n48\t            )\n49\t        state[\"event\"] = event\n50\t        return True\n51\t\n52\t    if action == \"lesson_integrity_flag\":\n53\t        event, dropped = _scrub_ceo_boot_event(event, _LESSON_INTEGRITY_FLAG_ALLOWLIST)\n54\t        event[\"lesson_id\"] = _learning_token_field(event.get(\"lesson_id\"))\n55\t        if event.get(\"check\") not in _LESSON_INTEGRITY_CHECK_ENUM:\n56\t            event[\"check\"] = \"hash_unverifiable\"\n57\t        if event.get(\"consumer\") not in _LESSON_INTEGRITY_CONSUMER_ENUM:\n58\t            event[\"consumer\"] = \"boot\"\n59\t        if dropped:\n60\t            _breadcrumb(\n61\t                \"emit_generic lesson_integrity_flag dropped: %s\" % sorted(dropped)[:10]\n62\t            )\n63\t        state[\"event\"] = event\n64\t        return True\n65\t\n66\t    if action == \"lesson_boot_render_dropped\":\n67\t        event, dropped = _scrub_ceo_boot_event(\n68\t            event, _LESSON_BOOT_RENDER_DROPPED_ALLOWLIST\n69\t        )\n70\t        if event.get(\"reason\") not in _LESSON_BOOT_DROP_REASON_ENUM:\n71\t            event[\"reason\"] = \"other\"\n72\t        event[\"lesson_id\"] = _learning_token_field(event.get(\"lesson_id\"))\n73\t        if dropped:\n74\t            _breadcrumb(\n75\t                \"emit_generic lesson_boot_render_dropped dropped: %s\"\n76\t                % sorted(dropped)[:10]\n77\t            )\n78\t        state[\"event\"] = event\n79\t    