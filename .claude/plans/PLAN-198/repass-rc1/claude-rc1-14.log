TATE.clear()\n277\t\n278\t\n279\tdef _plan088_rate_admit(action: str, _clock: Callable[[], float] = time.time) -> bool:\n280\t    \"\"\"Return True if action emit is within the 100/min/action cap.\n281\t\n282\t    Sliding 60s window; on rollover, resets count. Increments `dropped`\n283\t    counter when over-budget WITHOUT re-emitting (M-12 anti-recursive-flood\n284\t    invariant — never call `_write_event` or `_breadcrumb` from this path).\n285\t\n286\t    `_clock` is injectable for tests (advance simulated time without\n287\t    `time.sleep`).\n288\t    \"\"\"\n289\t    now = _clock()\n290\t    with _PLAN088_RATE_LOCK:\n291\t        window_start, count, dropped = _PLAN088_RATE_STATE.get(action, (now, 0, 0))\n292\t        if now - window_start >= 60.0:\n293\t            window_start, count, dropped = now, 0, 0\n294\t        if count >= _PLAN088_RATE_CAP_PER_MIN:\n295\t            _PLAN088_RATE_STATE[action] = (window_start, count, dropped + 1)\n296\t            return False\n297\t        _PLAN088_RATE_STATE[action] = (window_start, count + 1, dropped)\n298\t        return True\n299\t\n300\t\n301\tdef _plan088_payload_cap(value: str, max_bytes: int = _PLAN088_PAYLOAD_MAX_BYTES) -> str:\n302\t    \"\"\"Truncate a utf-8 string to ``max_bytes`` without breaking codepoint.\n303\t\n304\t    M-12 anti-traceback-leak guard. qa-architect P0-4 fix: use ``errors='ignore'``\n305\t    + strip-continuation-byte loop so the cut point lands on a valid utf-8\n306\t    boundary (no \\\\ufffd replacement-char overflow that would push past\n307\t    max_bytes by 1-2 bytes).\n308\t\n309\t    Only accepts str input (P1 fix: do not coerce None / non-str types\n310\t    silently — let caller's typed default handle missing values).\n311\t    \"\"\"\n312\t    if not isinstance(value, str):\n313\t        return \"\"\n314\t    encoded = value.encode(\"utf-8\", errors=\"replace\")\n315\t    if len(encoded) <= max_bytes:\n316\t        return value\n317\t    # Strip trailing continuation bytes 