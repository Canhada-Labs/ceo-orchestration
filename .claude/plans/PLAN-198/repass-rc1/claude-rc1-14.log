{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ChguZAhwrREfBi7qVxqbbe","type":"tool_result","content":"1\t\"\"\"Federation schemas.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_FEDERATION_ENVELOPE', '_FEDERATION_CONNECTION_ACCEPTED_ALLOWLIST', '_FEDERATION_CONNECTION_REJECTED_ALLOWLIST', '_FEDERATION_CONNECTION_REPLAY_SUSPECTED_ALLOWLIST', '_FEDERATION_CERT_EXPIRY_WARNED_ALLOWLIST', '_FEDERATION_CERT_REVOKED_ALLOWLIST', '_FEDERATION_CERT_VALIDITY_WINDOW_TOO_LARGE_ALLOWLIST', '_FEDERATION_ENABLE_SENTINEL_INVALID_ALLOWLIST', '_FEDERATION_LAN_BIND_DENIED_ALLOWLIST', '_FEDERATION_WRITE_ATTEMPT_BLOCKED_ALLOWLIST', '_FEDERATION_WRITE_ENDPOINT_DENIED_ALLOWLIST', '_FEDERATION_WRITE_DISABLED_SENTINEL_INVALID_ALLOWLIST', '_FEDERATION_SCOPE_DENIED_ALLOWLIST', '_FEDERATION_EVENT_ACTION_BLOCKED_ALLOWLIST', '_FEDERATION_AUDIT_EVENT_PUSHED_ALLOWLIST', '_FEDERATION_AUDIT_EVENT_PUSHED_BATCH_ALLOWLIST', '_FEDERATION_PEER_REGISTERED_ALLOWLIST', '_FEDERATION_PEER_REGISTERED_COLLISION_ALLOWLIST', '_FEDERATION_PEER_REVOKED_REMOTE_ALLOWLIST', '_FEDERATION_PEER_INVALID_NO_FINGERPRINT_ALLOWLIST', '_FEDERATION_PEER_LIST_RELOADED_ALLOWLIST', '_FEDERATION_PIN_LEGACY_USED_ALLOWLIST', '_FEDERATION_SPKI_FINGERPRINT_MISMATCH_ALLOWLIST', '_FEDERATION_MESSAGE_STORM_DETECTED_ALLOWLIST', '_FEDERATION_AUDIT_LOG_BACKPRESSURE_ALLOWLIST', '_FEDERATION_TAMPER_DETECTED_ALLOWLIST', '_RESERVED_ACTIONS', '_EMIT_GENERIC_PASSTHROUGH', '_FEDERATION_AUTONOMOUS_CALL_BLOCKED_ALLOWLIST', '_FEDERATION_HMAC_SECRET_ROTATED_ALLOWLIST', '_FEDERATION_KEY_FLOOR_REJECTED_ALLOWLIST', '_FEDERATION_KEY_FLOOR_STALE_ALLOWLIST', '_BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST', '_SPAWN_CONFIDENCE_ADVISORY_ALLOWLIST', '_SPAWN_PROMPT_DEFENSE_GATE_ALLOWLIST', '_SPEC_CONTEXT_SANITIZED_ALLOWLIST', '_ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST', '_ADMIN_KEY_OPERATIONS', '_ADMIN_KEY_REASONS', '_STATUSLINE_SIDECAR_WRITE_ALLOWLIST', '_STATUSLINE_SIDECAR_PATH_CAP', '_STATUSLINE_STR_CAP', '_MODEL_REFUSAL_OBSERVED_ALLOWLIST', '_INVISIBLE_UNICODE_BLOCKED_ALLOWLIST', '_INVISIBLE_UNICODE_CLASSES', '_INVISIBLE_UNICODE_SURFACES')\n9\t\n10\t# PLAN-113 Phase B B-STRUCTURAL — federation emit_generic Sec MF-3 field\n11\t# allowlists (deny-by-default). Closes the \"ghost-action leak\" finding: the\n12\t# ~25 `federation_*` actions reach `emit_generic` via\n13\t# `_lib.federation.*._safe_emit(action, **fields)` but had NO dispatch-gate\n14\t# branch — so before this plan their caller kwargs were written VERBATIM into\n15\t# the HMAC audit log (no allowlist scrub). Each allowlist below is the union\n16\t# of the framework envelope (`_FEDERATION_ENVELOPE`) + the per-action SAFE\n17\t# fields taken BYTE-FOR-BYTE from SPEC/v1/audit-log.schema.md v2.29/v2.33.\n18\t#\n19\t# LLM06 / GDPR hold preserved per the SPEC rows: full SPKI/DER fingerprints\n20\t# are never logged (only `*_prefix` 16-hex), full IPs are /24-truncated\n21\t# (`ip_prefix`) where the producer truncates, and the two filesystem-path\n22\t# fields (`source_path`, `sentinel_path`) are NEVER persisted raw — the\n23\t# dispatch-gate re-hashes them via `_federation_safe_path_hash` (12-hex)\n24\t# BEFORE write, so an accidental caller cannot leak a host path into the\n25\t# chained log.\n26\t_FEDERATION_ENVELOPE = frozenset({\n27\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n28\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n29\t    \"hmac\", \"hmac_error\",\n30\t})\n31\t\n32\t\n33\t# Read-path connection lifecycle (PLAN-099 MVP / ADR-129 / ADR-135). `client_ip`\n34\t# is persisted per the SPEC v2.27 rows (read-path connection forensics; the\n35\t# LLM06 drop applies to the WRITE-handler emits, not these).\n36\t_FEDERATION_CONNECTION_ACCEPTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n37\t    \"peer_id\", \"client_ip\", \"fed_correlation_id\",\n38\t}\n39\t\n40\t\n41\t_FEDERATION_CONNECTION_REJECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n42\t    \"peer_id_cert_fingerprint\", \"client_ip\", \"reason\",\n43\t}\n44\t\n45\t\n46\t_FEDERATION_CONNECTION_REPLAY_SUSPECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n47\t    \"peer_id\", \"client_ip\", \"reason\",\n48\t}\n49\t\n50\t\n51\t_FEDERATION_CERT_EXPIRY_WARNED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n52\t    \"peer_id\", \"days_remaining\",\n53\t}\n54\t\n55\t\n56\t_FEDERATION_CERT_REVOKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n57\t    \"peer_id\", \"reason\",\n58\t}\n59\t\n60\t\n61\t_FEDERATION_CERT_VALIDITY_WINDOW_TOO_LARGE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n62\t    \"peer_id\", \"route\", \"window_days\", \"max_days\",\n63\t    # SPEC v2.29 also carries the ISO bounds + duration_days for the\n64\t    # advisory; allow them (no PII — cert validity window is public).\n65\t    \"not_before_iso\", \"not_after_iso\", \"duration_days\",\n66\t}\n67\t\n68\t\n69\t_FEDERATION_ENABLE_SENTINEL_INVALID_ALLOWLIST = _FEDERATION_ENVELOPE | {\n70\t    \"sentinel_kind\", \"reason\",\n71\t}\n72\t\n73\t\n74\t_FEDERATION_LAN_BIND_DENIED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n75\t    \"bind_host\", \"resolved_ip\", \"reason\",\n76\t}\n77\t\n78\t\n79\t# Write-mode surface (PLAN-099-FOLLOWUP Wave E/F.2 / ADR-135-AMEND-1).\n80\t_FEDERATION_WRITE_ATTEMPT_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n81\t    \"peer_id_cert_fingerprint\", \"client_ip\", \"fed_correlation_id\",\n82\t    \"method\", \"path\",\n83\t}\n84\t\n85\t\n86\t_FEDERATION_WRITE_ENDPOINT_DENIED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n87\t    \"peer_id\", \"route\", \"gate_failed\", \"reason_code\",\n88\t}\n89\t\n90\t\n91\t_FEDERATION_WRITE_DISABLED_SENTINEL_INVALID_ALLOWLIST = _FEDERATION_ENVELOPE | {\n92\t    \"reason_code\", \"sentinel_path\",  # sentinel_path re-hashed in dispatch-gate\n93\t}\n94\t\n95\t\n96\t_FEDERATION_SCOPE_DENIED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n97\t    \"peer_id\", \"route\", \"required_scope\", \"peer_scopes_count\",\n98\t}\n99\t\n100\t\n101\t_FEDERATION_EVENT_ACTION_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n102\t    \"peer_id\", \"event_action\", \"reason_code\",\n103\t}\n104\t\n105\t\n106\t_FEDERATION_AUDIT_EVENT_PUSHED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n107\t    \"peer_id\", \"event_action\", \"hmac_ok\", \"origin_overwritten\",\n108\t}\n109\t\n110\t\n111\t_FEDERATION_AUDIT_EVENT_PUSHED_BATCH_ALLOWLIST = _FEDERATION_ENVELOPE | {\n112\t    \"peer_id\", \"batch_size\", \"accepted_count\", \"rejected_count\",\n113\t}\n114\t\n115\t\n116\t_FEDERATION_PEER_REGISTERED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n117\t    \"peer_id\", \"route\", \"scopes_count\", \"spki_fingerprint_prefix\",\n118\t}\n119\t\n120\t\n121\t_FEDERATION_PEER_REGISTERED_COLLISION_ALLOWLIST = _FEDERATION_ENVELOPE | {\n122\t    \"peer_id\", \"attempted_by_origin_peer_id\",\n123\t}\n124\t\n125\t\n126\t_FEDERATION_PEER_REVOKED_REMOTE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n127\t    \"peer_id\", \"revoked_by_origin_peer_id\", \"reason_code\",\n128\t}\n129\t\n130\t\n131\t_FEDERATION_PEER_INVALID_NO_FINGERPRINT_ALLOWLIST = _FEDERATION_ENVELOPE | {\n132\t    \"peer_id\", \"source_path\",  # source_path re-hashed in dispatch-gate\n133\t}\n134\t\n135\t\n136\t_FEDERATION_PEER_LIST_RELOADED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n137\t    \"peer_id\", \"peer_count\", \"reload_reason\",\n138\t    \"source_path\",  # source_path re-hashed in dispatch-gate\n139\t}\n140\t\n141\t\n142\t_FEDERATION_PIN_LEGACY_USED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n143\t    \"peer_id\", \"route\", \"der_fingerprint_prefix\",\n144\t}\n145\t\n146\t\n147\t_FEDERATION_SPKI_FINGERPRINT_MISMATCH_ALLOWLIST = _FEDERATION_ENVELOPE | {\n148\t    \"peer_id\", \"expected_prefix\", \"presented_prefix\", \"route\",\n149\t}\n150\t\n151\t\n152\t# T1499 DoS surface (PLAN-099-FOLLOWUP Wave E.1 / ADR-135-AMEND-1 §2.4).\n153\t_FEDERATION_MESSAGE_STORM_DETECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n154\t    \"peer_id\", \"route\", \"ip_prefix\", \"hits_in_window\", \"window_seconds\",\n155\t}\n156\t\n157\t\n158\t_FEDERATION_AUDIT_LOG_BACKPRESSURE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n159\t    \"p99_latency_ms\", \"window_seconds\", \"action_taken\",\n160\t}\n161\t\n162\t\n163\t# T1565 tamper surface (PLAN-099-FOLLOWUP Wave E.3 / ADR-135-AMEND-1 §6).\n164\t_FEDERATION_TAMPER_DETECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n165\t    \"peer_id\", \"route\", \"tamper_type\", \"prev_hash_prefix\",\n166\t}\n167\t\n168\t\n169\t# PLAN-113 Phase B B5 — RESERVED-no-producer registry. Each maps a registered\n170\t# `_KNOWN_ACTIONS` member that has ZERO production caller today to its gating\n171\t# ADR. The CI-guard test (test_audit_emit_ghost_action_guard.py) asserts (a)\n172\t# every member here is truly producer-less and (b) if a member ever GROWS a\n173\t# production caller, its gating ADR MUST be in ACCEPTED state — else fail.\n174\t# Verified against SPEC/v1/audit-log.schema.md governing-ADR columns:\n175\t#   - execution_context_* : ADR-133 §D (cross-process wiring DEFERRED, F-1.2)\n176\t#   - federation_autonomous_call_blocked : ADR-135 (PLAN-099 import-graph\n177\t#     denylist surface; AC18 helper exists but is never invoked)\n178\t#   - federation_hmac_secret_rotated : ADR-135-AMEND-1 §6 (Owner co-sign\n179\t#     rotate path not wired to a producer)\n180\t#   - federation_key_floor_rejected / _stale : ADR-129-AMEND-1 §3/§4\n181\t#     (key-floor enforcement is advisory-staged; no emit producer yet)\n182\t# NOTE: federation_tamper_detected / federation_message_storm_detected /\n183\t# federation_audit_log_backpressure are NOT reserved — they have live\n184\t# `_safe_emit` producers (audit_chain_ext.py / rate_limit.py) and get explicit\n185\t# dispatch-gate branches above.\n186\t_RESERVED_ACTIONS = {\n187\t    \"execution_context_signed\": \"ADR-133\",\n188\t    \"execution_context_validation_failed\": \"ADR-133\",\n189\t    \"federation_autonomous_call_blocked\": \"ADR-135\",\n190\t    \"federation_hmac_secret_rotated\": \"ADR-135-AMEND-1\",\n191\t    \"federation_key_floor_rejected\": \"ADR-129-AMEND-1\",\n192\t    \"federation_key_floor_stale\": \"ADR-129-AMEND-1\",\n193\t}\n194\t\n195\t\n196\t# PLAN-113 Phase B B-STRUCTURAL — emit_generic verbatim-passthrough registry.\n197\t# These `_KNOWN_ACTIONS` members are emitted via emit_generic by TRUSTED\n198\t# in-repo producers (their own typed wrappers in this module, or first-party\n199\t# hook/script producers) with controlled, pre-scrubbed field sets. They have\n200\t# no dedicated dispatch-gate scrub branch and their verbatim pass-through is\n201\t# the ACCEPTED pre-existing contract (each has direct field-presence coverage\n202\t# in test_audit_emit_coverage.py). They are explicitly enumerated here so the\n203\t# default-deny `else` in emit_generic can distinguish them from a genuinely\n204\t# unhandled / future / unexpected producer.\n205\t#\n206\t# INVARIANT (enforced by test_audit_emit_ghost_action_guard.py): every\n207\t# `_KNOWN_ACTIONS` member is EXACTLY ONE of: (a) has an explicit `action ==`\n208\t# dispatch-gate branch, (b) is in `_RESERVED_ACTIONS`, or (c) is in this\n209\t# passthrough set. Any member matching NONE of the three reaches the\n210\t# default-deny `else` (all caller kwargs dropped). A NEW action added to\n211\t# `_KNOWN_ACTIONS` therefore defaults to fail-closed (default-deny) until the\n212\t# author either gives it a scrub branch or consciously lists it here — the\n213\t# leak class cannot silently reopen.\n214\t_EMIT_GENERIC_PASSTHROUGH = frozenset({\n215\t    # admin_key_lifecycle_event MOVED out of passthrough (Codex R5 P1-2,\n216\t    # PLAN-135-FOLLOWUP) → dedicated _ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST scrub\n217\t    # branch in emit_generic: Sec MF-3 deny-by-default + operation/reason\n218\t    # enum-value coercion enforced even against a direct emit_generic caller.\n219\t    \"agent_spawn\",\n220\t    \"audit_flush_dropped_count\",\n221\t    \"audit_spool_duplicate_tuple_rejected\",\n222\t    \"audit_spool_intentionally_deleted\",\n223\t    \"audit_spool_partial_line_discarded\",\n224\t    \"audit_spool_stale_recovered\",\n225\t    \"audit_spool_tamper_detected\",\n226\t    \"audit_spool_unexpected_skip\",\n227\t    \"audit_tokens_emitted\",\n228\t    \"audit_tokens_key_dropped\",\n229\t    \"audit_tokens_timeout\",\n230\t    # bash_canonical_bypass_invoked REMOVED from passthrough (PLAN-113 Codex P1):\n231\t    # routed through explicit _BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST scrub branch\n232\t    # so target_path_hash (12-hex sha256) is the ONLY path representation in the log\n233\t    # (replaces the old target_path_preview raw-path field; Sec MF-3 P1 fix).\n234\t    \"benchmark_run\",\n235\t    \"breaker_closed\",\n236\t    \"breaker_opened\",\n237\t    \"budget_bypass_used\",\n238\t    \"budget_exceeded\",\n239\t    \"canonical_edit_attempted\",\n240\t    \"canonical_edit_blocked\",\n241\t    \"capability_rollout_complete\",\n242\t    \"chain_reset_marker\",\n243\t    \"codex-reply\",\n244\t    \"confidence_gate\",\n245\t    \"confidence_gate_baseline_emitted\",\n246\t    \"credential_rotation_due\",\n247\t    \"debate_event\",\n248\t    \"escalation_baseline_recorded\",\n249\t    \"escalation_detected\",\n250\t    \"escalation_dispatched\",\n251\t    \"escalation_suppressed\",\n252\t    \"estimate_refined\",\n253\t    \"federation_cert_rotated\",\n254\t    \"fluency_nudge\",\n255\t    \"goap_cycle_detected\",\n256\t    \"goap_depth_exceeded\",\n257\t    \"goap_disabled_by_env\",\n258\t    \"goap_edge_explored\",\n259\t    \"goap_recommendation_accepted\",\n260\t    \"goap_recommendation_overridden\",\n261\t    \"goap_recommendation_rendered\",\n262\t    \"goap_replan_exhausted\",\n263\t    \"goap_replan_triggered\",\n264\t    \"goap_search_aborted\",\n265\t    \"goap_search_summary\",\n266\t    \"gpg_signed\",\n267\t    \"gpg_verified\",\n268\t    \"injection_flag\",\n269\t    \"kernel_extension_landed\",\n270\t    \"kill_switch_invoked\",\n271\t    \"lesson_archived\",\n272\t    \"lesson_outcome\",\n273\t    \"lesson_outcome_undone\",\n274\t    \"lesson_read\",\n275\t    \"lesson_restored\",\n276\t    \"lesson_write\",\n277\t    \"live_adapter_call_failed\",\n278\t    \"live_adapter_call_started\",\n279\t    \"live_adapter_call_succeeded\",\n280\t    \"mcp_bearer_friction_observed\",\n281\t    \"mcp_canonical_guard_internal_error\",\n282\t    \"mcp_cross_tenant_denied\",\n283\t    \"mcp_handler_denied\",\n284\t    \"mcp_handler_invoked\",\n285\t    # mcp_injection_finding REMOVED from passthrough (PLAN-113 Codex B3 P1):\n286\t    # it carries MCP-controlled snippet_preview → routed through an explicit\n287\t    # scrub branch with allowlist + _preview() re-truncation instead.\n288\t    \"mcp_server_disabled_by_kill_switch\",\n289\t    \"mcp_server_started\",\n290\t    \"mcp_soak_fpr_breach\",\n291\t    # model_refusal_observed MOVED out of passthrough (Codex R5 P1-2,\n292\t    # PLAN-135-FOLLOWUP) → dedicated _MODEL_REFUSAL_OBSERVED_ALLOWLIST scrub\n293\t    # branch in emit_generic (stop_reason/stop_category/http_status/duration_ms\n294\t    # value-bounded against a direct caller).\n295\t    \"otel_export_dropped\",\n296\t    \"output_safety_flag\",\n297\t    \"output_scan_finding\",\n298\t    \"pair_rail_codex_unavailable\",\n299\t    \"pair_rail_codex_violation\",\n300\t    \"pair_rail_review_passed\",\n301\t    \"pair_rail_sentinel_bypass\",\n302\t    \"pattern_evicted\",\n303\t    \"pattern_queried\",\n304\t    \"pattern_stored\",\n305\t    \"persona_auto_decision_emitted\",\n306\t    \"persona_auto_rate_capped\",\n307\t    \"phase_c_enforcing_flipped\",\n308\t    \"plan_transition\",\n309\t    \"policy_denied\",\n310\t    \"policy_error\",\n311\t    \"policy_evaluated\",\n312\t    \"prediction_queried\",\n313\t    \"prompt_submitted\",\n314\t    \"protocol_edit_missing_amend_paired\",\n315\t    \"rag_auto_wire_skipped_sidecar_down\",\n316\t    \"rag_false_large_demoted\",\n317\t    \"rag_hit_rate_degraded\",\n318\t    \"rag_index_redacted\",\n319\t    \"rag_profile_recommended\",\n320\t    \"rag_query_fallback\",\n321\t    \"rag_query_issued\",\n322\t    \"rag_query_redacted\",\n323\t    \"rag_query_returned\",\n324\t    \"rag_query_routed\",\n325\t    \"reality_ledger_key_dropped\",\n326\t    \"replay_capture_completed\",\n327\t    \"replay_capture_started\",\n328\t    \"replay_completed\",\n329\t    \"replay_diff_produced\",\n330\t    \"replay_started\",\n331\t    \"repo_profile_confirmed\",\n332\t    \"sentinel_created\",\n333\t    \"sentinel_signer_expiry_warned\",\n334\t    \"sentinel_signer_quorum_attempted\",\n335\t    \"sentinel_signer_quorum_failed\",\n336\t    \"sentinel_signer_revoked\",\n337\t    \"sentinel_signer_rotated\",\n338\t    \"sentinel_verified\",\n339\t    \"session_end\",\n340\t    \"session_start\",\n341\t    \"session_stop\",\n342\t    \"skill_bootstrap_post_hash\",\n343\t    \"skill_bootstrap_used\",\n344\t    \"skill_cache_stats\",\n345\t    \"skill_patch_applied\",\n346\t    \"skill_reference_never_read\",\n347\t    \"skill_reference_read_mismatch\",\n348\t    \"skill_reference_read_stale\",\n349\t    # spawn_confidence_advisory + spec_context_sanitized REMOVED from passthrough\n350\t    # (PLAN-113 Codex P2): moved to explicit per-action allowlist branches so\n351\t    # Sec MF-3 deny-by-default is structurally enforced even if a future\n352\t    # callsite adds unexpected fields. See _SPAWN_CONFIDENCE_ADVISORY_ALLOWLIST\n353\t    # and _SPEC_CONTEXT_SANITIZED_ALLOWLIST below + dispatch branches in\n354\t    # emit_generic.\n355\t    \"squad_imported\",\n356\t    \"state_store_pruned\",\n357\t    \"state_store_read\",\n358\t    \"state_store_write\",\n359\t    # statusline_sidecar_write MOVED out of passthrough (Codex R5 P1-2,\n360\t    # PLAN-135-FOLLOWUP) → dedicated _STATUSLINE_SIDECAR_WRITE_ALLOWLIST scrub\n361\t    # branch in emit_generic (numeric/id/digest fields type-bounded; sidecar_path\n362\t    # length-capped against a direct caller).\n363\t    \"streaming_rate_capped\",\n364\t    \"streaming_token_yielded\",\n365\t    \"swarm_aborted_error\",\n366\t    \"swarm_finalize_committed\",\n367\t    \"swarm_finalize_grouped\",\n368\t    \"swarm_halted_budget\",\n369\t    \"swarm_halted_convergence\",\n370\t    \"swarm_halted_kill\",\n371\t    \"swarm_iteration\",\n372\t    \"swarm_killed\",\n373\t    \"swarm_started\",\n374\t    \"swarm_tournament_selected\",\n375\t    \"task_route_key_dropped\",\n376\t    \"thinking_budget_set\",\n377\t    \"threat_model_freshness_breach\",\n378\t    \"threat_model_promoted\",\n379\t    \"tier_policy_adopter_override_respected\",\n380\t    \"tier_policy_demote_requested\",\n381\t    \"tier_policy_derived\",\n382\t    \"tier_policy_dry_run_complete\",\n383\t    \"tier_policy_hmac_verify_failed\",\n384\t    \"tier_policy_killswitch_triggered\",\n385\t    \"tier_policy_promote_applied\",\n386\t    \"tier_policy_promote_cost_gated\",\n387\t    \"tier_policy_rejected\",\n388\t    \"tournament_aborted\",\n389\t    \"tournament_budget_exceeded\",\n390\t    \"tournament_budget_projected\",\n391\t    \"tournament_fixture_rejected\",\n392\t    \"tournament_judge_hijack_suspected\",\n393\t    \"tournament_run_completed\",\n394\t    \"tournament_run_started\",\n395\t    \"tournament_task_scored\",\n396\t    \"veto_triggered\",\n397\t    \"wave_artifact_written\",\n398\t    \"wave_readonly_violation\",\n399\t})\n400\t\n401\t\n402\t# Defense-in-depth allowlists for the 3 destructive RESERVED federation\n403\t# actions (no producer today; if an accidental caller appears, fields are\n404\t# allowlist-bounded not raw). Fields per SPEC v2.29 rows.\n405\t_FEDERATION_AUTONOMOUS_CALL_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n406\t    \"call_site\",\n407\t}\n408\t\n409\t\n410\t_FEDERATION_HMAC_SECRET_ROTATED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n411\t    \"peer_id\", \"rotation_reason_code\",\n412\t}\n413\t\n414\t\n415\t_FEDERATION_KEY_FLOOR_REJECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n416\t    \"peer_id\", \"key_type\", \"key_bits\", \"curve_name\", \"reason_code\",\n417\t}\n418\t\n419\t\n420\t_FEDERATION_KEY_FLOOR_STALE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n421\t    \"peer_id\", \"key_floor_verified_at_iso\", \"advisory_only\",\n422\t}\n423\t\n424\t\n425\t# PLAN-113 Codex P1 — bash_canonical_bypass_invoked field allowlist.\n426\t# target_path_preview REMOVED (raw filesystem path → Sec MF-3 violation).\n427\t# Replaced by target_path_hash (12-hex sha256 prefix; no path body leaks).\n428\t_BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n429\t    \"token_hash_prefix\",\n430\t    \"target_path_hash\",\n431\t    \"ticket_expires_in_s\",\n432\t    \"atlas_technique\",\n433\t}\n434\t\n435\t\n436\t# PLAN-113 Codex P2 — spawn_confidence_advisory explicit allowlist.\n437\t# Moved from _EMIT_GENERIC_PASSTHROUGH so Sec MF-3 deny-by-default is\n438\t# structurally enforced. Fields: bounded enums/labels from\n439\t# check_agent_spawn._emit_spawn_confidence_advisory() per SPEC v2.34.\n440\t_SPAWN_CONFIDENCE_ADVISORY_ALLOWLIST = _FEDERATION_ENVELOPE | {\n441\t    \"action_type\",\n442\t    \"confidence_level\",\n443\t    \"confidence_marker\",\n444\t    \"reason_code\",\n445\t    \"is_named_spawn\",\n446\t}\n447\t\n448\t\n449\t# PLAN-153 Wave E item 7 (ADR-175) — spawn_prompt_defense_gate explicit allowlist.\n450\t# Sec MF-3 deny-by-default: only the 3 caller-supplied fields from\n451\t# check_agent_spawn._emit_prompt_defense_event() persist. `keyword` is a\n452\t# closed-enum untrusted-content hint (bounded + 32-char capped in the dispatch\n453\t# branch below); `present`/`enforced` are 0/1 flags. NO prompt/description body.\n454\t_SPAWN_PROMPT_DEFENSE_GATE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n455\t    \"keyword\",\n456\t    \"present\",\n457\t    \"enforced\",\n458\t}\n459\t\n460\t\n461\t# PLAN-113 Codex P2 — spec_context_sanitized explicit allowlist.\n462\t# Moved from _EMIT_GENERIC_PASSTHROUGH so Sec MF-3 deny-by-default is\n463\t# structurally enforced. Fields: bounded counters/flags from\n464\t# check_agent_spawn._maybe_sanitize_spec_context() per SPEC v2.34.\n465\t# No prompt content is persisted — all fields are derived byte/count metrics.\n466\t_SPEC_CONTEXT_SANITIZED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n467\t    \"original_bytes\",\n468\t    \"cleaned_bytes\",\n469\t    \"truncated\",\n470\t    \"sentinel_violations\",\n471\t    \"control_chars_stripped\",\n472\t    \"bidi_zw_chars_stripped\",\n473\t    \"tag_chars_stripped\",\n474\t    \"header_escape_count\",\n475\t}\n476\t\n477\t\n478\t# PLAN-135-FOLLOWUP (Codex R5 P1-2) — the 3 W5 ops actions move OFF\n479\t# _EMIT_GENERIC_PASSTHROUGH into dedicated deny-by-default scrub branches so the\n480\t# Sec MF-3 field-allowlist + enum-value-coercion boundary holds against a direct /\n481\t# future emit_generic caller that bypasses the trusted producer. Field sets are\n482\t# byte-accurate to the live producers AND to SPEC/v1/audit-log.schema.md L480-482.\n483\t#\n484\t# o9 — Anthropic Admin API key-lifecycle (.claude/scripts/key-hygiene.py\n485\t# `_audit_emit`). Producer passes operation + a per-call-site subset of\n486\t# {key_count | key_id | reason | rotation_log_appended}; rotated_by/notes go to\n487\t# docs/rotation-log.md, NEVER the emit. `reason` is a REQUIRED credential-forensic\n488\t# field (the WHY of a key deactivation) — kept + enum-coerced, never dropped.\n489\t_ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST = _FEDERATION_ENVELOPE | {\n490\t    \"operation\",\n491\t    \"key_id\",\n492\t    \"key_count\",\n493\t    \"reason\",\n494\t    \"rotation_log_appended\",\n495\t}\n496\t\n497\t\n498\t# Closed enums for VALUE re-coercion (mirror key-hygiene.py: the operation\n499\t# discriminator + VALID_REASONS). Out-of-set → \"other\" (S172 coerce-to-safe-\n500\t# sentinel) so a direct caller cannot smuggle free text through an allowed key.\n501\t_ADMIN_KEY_OPERATIONS = frozenset({\"list\", \"deactivate\", \"incident\"})\n502\t\n503\t\n504\t_ADMIN_KEY_REASONS = frozenset({\"compromise\", \"suspicion\", \"scheduled\"})\n505\t\n506\t\n507\t# o4 — statusLine sidecar-write (.claude/scripts/statusline-ceo.py `maybe_emit`).\n508\t# session_id is already in _FEDERATION_ENVELOPE; sidecar_path is an abs path SPEC\n509\t# L481 explicitly permits — length-capped to bound log-line bloat / oversized-field\n510\t# log-injection (Codex R5 P1-2 sec must-fix).\n511\t_STATUSLINE_SIDECAR_WRITE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n512\t    \"sidecar_path\",\n513\t    \"plan_id\",\n514\t    # PLAN-135-FOLLOWUP-2 (S234): percentage fields are HMAC-covered ->\n515\t    # integer basis-points (pct * 100), NEVER float. The canonical encoder\n516\t    # forbids float (S181 / ADR-055-AMEND-2); the float form was written\n517\t    # with hmac=null on every emit since v2.44. Producer converts pct->bps;\n518\t    # the scrub branch below clamps to int authoritatively.\n519\t    \"context_pct_bps\",\n520\t    \"bucket_count\",\n521\t    \"buckets_used_pct_max_bps\",\n522\t    \"digest\",\n523\t}\n524\t\n525\t\n526\t_STATUSLINE_SIDECAR_PATH_CAP = 512\n527\t\n528\t\n529\t_STATUSLINE_STR_CAP = 256\n530\t\n531\t\n532\t# o7 — model-refusal observability (.claude/hooks/_lib/adapters/live/claude.py\n533\t# `_on_response`). stop_reason is the const \"refusal\"; stop_category is the closed\n534\t# provider vocabulary (<=64); http_status/duration_ms are bounded non-negative ints\n535\t# (no float in the HMAC-covered chain — S181 doctrine).\n536\t_MODEL_REFUSAL_OBSERVED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n537\t    \"provider\",\n538\t    \"model\",\n539\t    \"stop_reason\",\n540\t    \"stop_category\",\n541\t    \"http_status\",\n542\t    \"duration_ms\",\n543\t}\n544\t\n545\t\n546\t# PLAN-133 A2 — Sec field allowlist for invisible_unicode_blocked. Deny-by-default.\n547\t# The ONLY caller-supplied payload fields are the closed-enum `surface` +\n548\t# `unicode_class`, the bounded int `char_count`, and the flag `enforced`. The\n549\t# prompt / skill text, the matched characters, and any var/value are NEVER allowed\n550\t# fields, so smuggled content can never reach the signed chain.\n551\t_INVISIBLE_UNICODE_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n552\t    \"surface\",\n553\t    \"unicode_class\",\n554\t    \"char_count\",\n555\t    \"enforced\",\n556\t}\n557\t\n558\t\n559\t# PLAN-133 A2 — closed unicode_class enum. MUST mirror\n560\t# _lib/spec_context_sanitizer.INVISIBLE_UNICODE_CLASSES. Kept as a literal frozenset\n561\t# here (NOT imported) so audit_emit has zero import-time dependency on the sanitizer;\n562\t# a drift is caught by a dedicated test (the two frozensets MUST be equal). A value\n563\t# outside this set is COERCED to \"control\" before emit (defense-in-depth).\n564\t_INVISIBLE_UNICODE_CLASSES = frozenset({\n565\t    \"tag_block\", \"bidi_zw\", \"control\", \"none\",\n566\t})\n567\t\n568\t\n569\t# PLAN-133 A2 — closed surface enum (origin of the detection). Out-of-set → \"spawn\".\n570\t_INVISIBLE_UNICODE_SURFACES = frozenset({\n571\t    \"spawn\", \"skill_write\", \"skill_read\",\n572\t})\n573\t"}]},"parent_tool_use_id":null,"session_id":"5ff2ef3b-1be9-4d6b-9faf-7d08cfab8359","uuid":"defef692-d0fc-49eb-9ea0-1d142f4864b1","timestamp":"2026-11-13T17:15:00.221Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/federation_schemas.py","content":"\"\"\"Federation schemas.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('_FEDERATION_ENVELOPE', '_FEDERATION_CONNECTION_ACCEPTED_ALLOWLIST', '_FEDERATION_CONNECTION_REJECTED_ALLOWLIST', '_FEDERATION_CONNECTION_REPLAY_SUSPECTED_ALLOWLIST', '_FEDERATION_CERT_EXPIRY_WARNED_ALLOWLIST', '_FEDERATION_CERT_REVOKED_ALLOWLIST', '_FEDERATION_CERT_VALIDITY_WINDOW_TOO_LARGE_ALLOWLIST', '_FEDERATION_ENABLE_SENTINEL_INVALID_ALLOWLIST', '_FEDERATION_LAN_BIND_DENIED_ALLOWLIST', '_FEDERATION_WRITE_ATTEMPT_BLOCKED_ALLOWLIST', '_FEDERATION_WRITE_ENDPOINT_DENIED_ALLOWLIST', '_FEDERATION_WRITE_DISABLED_SENTINEL_INVALID_ALLOWLIST', '_FEDERATION_SCOPE_DENIED_ALLOWLIST', '_FEDERATION_EVENT_ACTION_BLOCKED_ALLOWLIST', '_FEDERATION_AUDIT_EVENT_PUSHED_ALLOWLIST', '_FEDERATION_AUDIT_EVENT_PUSHED_BATCH_ALLOWLIST', '_FEDERATION_PEER_REGISTERED_ALLOWLIST', '_FEDERATION_PEER_REGISTERED_COLLISION_ALLOWLIST', '_FEDERATION_PEER_REVOKED_REMOTE_ALLOWLIST', '_FEDERATION_PEER_INVALID_NO_FINGERPRINT_ALLOWLIST', '_FEDERATION_PEER_LIST_RELOADED_ALLOWLIST', '_FEDERATION_PIN_LEGACY_USED_ALLOWLIST', '_FEDERATION_SPKI_FINGERPRINT_MISMATCH_ALLOWLIST', '_FEDERATION_MESSAGE_STORM_DETECTED_ALLOWLIST', '_FEDERATION_AUDIT_LOG_BACKPRESSURE_ALLOWLIST', '_FEDERATION_TAMPER_DETECTED_ALLOWLIST', '_RESERVED_ACTIONS', '_EMIT_GENERIC_PASSTHROUGH', '_FEDERATION_AUTONOMOUS_CALL_BLOCKED_ALLOWLIST', '_FEDERATION_HMAC_SECRET_ROTATED_ALLOWLIST', '_FEDERATION_KEY_FLOOR_REJECTED_ALLOWLIST', '_FEDERATION_KEY_FLOOR_STALE_ALLOWLIST', '_BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST', '_SPAWN_CONFIDENCE_ADVISORY_ALLOWLIST', '_SPAWN_PROMPT_DEFENSE_GATE_ALLOWLIST', '_SPEC_CONTEXT_SANITIZED_ALLOWLIST', '_ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST', '_ADMIN_KEY_OPERATIONS', '_ADMIN_KEY_REASONS', '_STATUSLINE_SIDECAR_WRITE_ALLOWLIST', '_STATUSLINE_SIDECAR_PATH_CAP', '_STATUSLINE_STR_CAP', '_MODEL_REFUSAL_OBSERVED_ALLOWLIST', '_INVISIBLE_UNICODE_BLOCKED_ALLOWLIST', '_INVISIBLE_UNICODE_CLASSES', '_INVISIBLE_UNICODE_SURFACES')\n\n# PLAN-113 Phase B B-STRUCTURAL — federation emit_generic Sec MF-3 field\n# allowlists (deny-by-default). Closes the \"ghost-action leak\" finding: the\n# ~25 `federation_*` actions reach `emit_generic` via\n# `_lib.federation.*._safe_emit(action, **fields)` but had NO dispatch-gate\n# branch — so before this plan their caller kwargs were written VERBATIM into\n# the HMAC audit log (no allowlist scrub). Each allowlist below is the union\n# of the framework envelope (`_FEDERATION_ENVELOPE`) + the per-action SAFE\n# fields taken BYTE-FOR-BYTE from SPEC/v1/audit-log.schema.md v2.29/v2.33.\n#\n# LLM06 / GDPR hold preserved per the SPEC rows: full SPKI/DER fingerprints\n# are never logged (only `*_prefix` 16-hex), full IPs are /24-truncated\n# (`ip_prefix`) where the producer truncates, and the two filesystem-path\n# fields (`source_path`, `sentinel_path`) are NEVER persisted raw — the\n# dispatch-gate re-hashes them via `_federation_safe_path_hash` (12-hex)\n# BEFORE write, so an accidental caller cannot leak a host path into the\n# chained log.\n_FEDERATION_ENVELOPE = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n})\n\n\n# Read-path connection lifecycle (PLAN-099 MVP / ADR-129 / ADR-135). `client_ip`\n# is persisted per the SPEC v2.27 rows (read-path connection forensics; the\n# LLM06 drop applies to the WRITE-handler emits, not these).\n_FEDERATION_CONNECTION_ACCEPTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"client_ip\", \"fed_correlation_id\",\n}\n\n\n_FEDERATION_CONNECTION_REJECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id_cert_fingerprint\", \"client_ip\", \"reason\",\n}\n\n\n_FEDERATION_CONNECTION_REPLAY_SUSPECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"client_ip\", \"reason\",\n}\n\n\n_FEDERATION_CERT_EXPIRY_WARNED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"days_remaining\",\n}\n\n\n_FEDERATION_CERT_REVOKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"reason\",\n}\n\n\n_FEDERATION_CERT_VALIDITY_WINDOW_TOO_LARGE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"route\", \"window_days\", \"max_days\",\n    # SPEC v2.29 also carries the ISO bounds + duration_days for the\n    # advisory; allow them (no PII — cert validity window is public).\n    \"not_before_iso\", \"not_after_iso\", \"duration_days\",\n}\n\n\n_FEDERATION_ENABLE_SENTINEL_INVALID_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"sentinel_kind\", \"reason\",\n}\n\n\n_FEDERATION_LAN_BIND_DENIED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"bind_host\", \"resolved_ip\", \"reason\",\n}\n\n\n# Write-mode surface (PLAN-099-FOLLOWUP Wave E/F.2 / ADR-135-AMEND-1).\n_FEDERATION_WRITE_ATTEMPT_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id_cert_fingerprint\", \"client_ip\", \"fed_correlation_id\",\n    \"method\", \"path\",\n}\n\n\n_FEDERATION_WRITE_ENDPOINT_DENIED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"route\", \"gate_failed\", \"reason_code\",\n}\n\n\n_FEDERATION_WRITE_DISABLED_SENTINEL_INVALID_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"reason_code\", \"sentinel_path\",  # sentinel_path re-hashed in dispatch-gate\n}\n\n\n_FEDERATION_SCOPE_DENIED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"route\", \"required_scope\", \"peer_scopes_count\",\n}\n\n\n_FEDERATION_EVENT_ACTION_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"event_action\", \"reason_code\",\n}\n\n\n_FEDERATION_AUDIT_EVENT_PUSHED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"event_action\", \"hmac_ok\", \"origin_overwritten\",\n}\n\n\n_FEDERATION_AUDIT_EVENT_PUSHED_BATCH_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"batch_size\", \"accepted_count\", \"rejected_count\",\n}\n\n\n_FEDERATION_PEER_REGISTERED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"route\", \"scopes_count\", \"spki_fingerprint_prefix\",\n}\n\n\n_FEDERATION_PEER_REGISTERED_COLLISION_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"attempted_by_origin_peer_id\",\n}\n\n\n_FEDERATION_PEER_REVOKED_REMOTE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"revoked_by_origin_peer_id\", \"reason_code\",\n}\n\n\n_FEDERATION_PEER_INVALID_NO_FINGERPRINT_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"source_path\",  # source_path re-hashed in dispatch-gate\n}\n\n\n_FEDERATION_PEER_LIST_RELOADED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"peer_count\", \"reload_reason\",\n    \"source_path\",  # source_path re-hashed in dispatch-gate\n}\n\n\n_FEDERATION_PIN_LEGACY_USED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"route\", \"der_fingerprint_prefix\",\n}\n\n\n_FEDERATION_SPKI_FINGERPRINT_MISMATCH_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"expected_prefix\", \"presented_prefix\", \"route\",\n}\n\n\n# T1499 DoS surface (PLAN-099-FOLLOWUP Wave E.1 / ADR-135-AMEND-1 §2.4).\n_FEDERATION_MESSAGE_STORM_DETECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"route\", \"ip_prefix\", \"hits_in_window\", \"window_seconds\",\n}\n\n\n_FEDERATION_AUDIT_LOG_BACKPRESSURE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"p99_latency_ms\", \"window_seconds\", \"action_taken\",\n}\n\n\n# T1565 tamper surface (PLAN-099-FOLLOWUP Wave E.3 / ADR-135-AMEND-1 §6).\n_FEDERATION_TAMPER_DETECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"route\", \"tamper_type\", \"prev_hash_prefix\",\n}\n\n\n# PLAN-113 Phase B B5 — RESERVED-no-producer registry. Each maps a registered\n# `_KNOWN_ACTIONS` member that has ZERO production caller today to its gating\n# ADR. The CI-guard test (test_audit_emit_ghost_action_guard.py) asserts (a)\n# every member here is truly producer-less and (b) if a member ever GROWS a\n# production caller, its gating ADR MUST be in ACCEPTED state — else fail.\n# Verified against SPEC/v1/audit-log.schema.md governing-ADR columns:\n#   - execution_context_* : ADR-133 §D (cross-process wiring DEFERRED, F-1.2)\n#   - federation_autonomous_call_blocked : ADR-135 (PLAN-099 import-graph\n#     denylist surface; AC18 helper exists but is never invoked)\n#   - federation_hmac_secret_rotated : ADR-135-AMEND-1 §6 (Owner co-sign\n#     rotate path not wired to a producer)\n#   - federation_key_floor_rejected / _stale : ADR-129-AMEND-1 §3/§4\n#     (key-floor enforcement is advisory-staged; no emit producer yet)\n# NOTE: federation_tamper_detected / federation_message_storm_detected /\n# federation_audit_log_backpressure are NOT reserved — they have live\n# `_safe_emit` producers (audit_chain_ext.py / rate_limit.py) and get explicit\n# dispatch-gate branches above.\n_RESERVED_ACTIONS = {\n    \"execution_context_signed\": \"ADR-133\",\n    \"execution_context_validation_failed\": \"ADR-133\",\n    \"federation_autonomous_call_blocked\": \"ADR-135\",\n    \"federation_hmac_secret_rotated\": \"ADR-135-AMEND-1\",\n    \"federation_key_floor_rejected\": \"ADR-129-AMEND-1\",\n    \"federation_key_floor_stale\": \"ADR-129-AMEND-1\",\n}\n\n\n# PLAN-113 Phase B B-STRUCTURAL — emit_generic verbatim-passthrough registry.\n# These `_KNOWN_ACTIONS` members are emitted via emit_generic by TRUSTED\n# in-repo producers (their own typed wrappers in this module, or first-party\n# hook/script producers) with controlled, pre-scrubbed field sets. They have\n# no dedicated dispatch-gate scrub branch and their verbatim pass-through is\n# the ACCEPTED pre-existing contract (each has direct field-presence coverage\n# in test_audit_emit_coverage.py). They are explicitly enumerated here so the\n# default-deny `else` in emit_generic can distinguish them from a genuinely\n# unhandled / future / unexpected producer.\n#\n# INVARIANT (enforced by test_audit_emit_ghost_action_guard.py): every\n# `_KNOWN_ACTIONS` member is EXACTLY ONE of: (a) has an explicit `action ==`\n# dispatch-gate branch, (b) is in `_RESERVED_ACTIONS`, or (c) is in this\n# passthrough set. Any member matching NONE of the three reaches the\n# default-deny `else` (all caller kwargs dropped). A NEW action added to\n# `_KNOWN_ACTIONS` therefore defaults to fail-closed (default-deny) until the\n# author either gives it a scrub branch or consciously lists it here — the\n# leak class cannot silently reopen.\n_EMIT_GENERIC_PASSTHROUGH = frozenset({\n    # admin_key_lifecycle_event MOVED out of passthrough (Codex R5 P1-2,\n    # PLAN-135-FOLLOWUP) → dedicated _ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST scrub\n    # branch in emit_generic: Sec MF-3 deny-by-default + operation/reason\n    # enum-value coercion enforced even against a direct emit_generic caller.\n    \"agent_spawn\",\n    \"audit_flush_dropped_count\",\n    \"audit_spool_duplicate_tuple_rejected\",\n    \"audit_spool_intentionally_deleted\",\n    \"audit_spool_partial_line_discarded\",\n    \"audit_spool_stale_recovered\",\n    \"audit_spool_tamper_detected\",\n    \"audit_spool_unexpected_skip\",\n    \"audit_tokens_emitted\",\n    \"audit_tokens_key_dropped\",\n    \"audit_tokens_timeout\",\n    # bash_canonical_bypass_invoked REMOVED from passthrough (PLAN-113 Codex P1):\n    # routed through explicit _BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST scrub branch\n    # so target_path_hash (12-hex sha256) is the ONLY path representation in the log\n    # (replaces the old target_path_preview raw-path field; Sec MF-3 P1 fix).\n    \"benchmark_run\",\n    \"breaker_closed\",\n    \"breaker_opened\",\n    \"budget_bypass_used\",\n    \"budget_exceeded\",\n    \"canonical_edit_attempted\",\n    \"canonical_edit_blocked\",\n    \"capability_rollout_complete\",\n    \"chain_reset_marker\",\n    \"codex-reply\",\n    \"confidence_gate\",\n    \"confidence_gate_baseline_emitted\",\n    \"credential_rotation_due\",\n    \"debate_event\",\n    \"escalation_baseline_recorded\",\n    \"escalation_detected\",\n    \"escalation_dispatched\",\n    \"escalation_suppressed\",\n    \"estimate_refined\",\n    \"federation_cert_rotated\",\n    \"fluency_nudge\",\n    \"goap_cycle_detected\",\n    \"goap_depth_exceeded\",\n    \"goap_disabled_by_env\",\n    \"goap_edge_explored\",\n    \"goap_recommendation_accepted\",\n    \"goap_recommendation_overridden\",\n    \"goap_recommendation_rendered\",\n    \"goap_replan_exhausted\",\n    \"goap_replan_triggered\",\n    \"goap_search_aborted\",\n    \"goap_search_summary\",\n    \"gpg_signed\",\n    \"gpg_verified\",\n    \"injection_flag\",\n    \"kernel_extension_landed\",\n    \"kill_switch_invoked\",\n    \"lesson_archived\",\n    \"lesson_outcome\",\n    \"lesson_outcome_undone\",\n    \"lesson_read\",\n    \"lesson_restored\",\n    \"lesson_write\",\n    \"live_adapter_call_failed\",\n    \"live_adapter_call_started\",\n    \"live_adapter_call_succeeded\",\n    \"mcp_bearer_friction_observed\",\n    \"mcp_canonical_guard_internal_error\",\n    \"mcp_cross_tenant_denied\",\n    \"mcp_handler_denied\",\n    \"mcp_handler_invoked\",\n    # mcp_injection_finding REMOVED from passthrough (PLAN-113 Codex B3 P1):\n    # it carries MCP-controlled snippet_preview → routed through an explicit\n    # scrub branch with allowlist + _preview() re-truncation instead.\n    \"mcp_server_disabled_by_kill_switch\",\n    \"mcp_server_started\",\n    \"mcp_soak_fpr_breach\",\n    # model_refusal_observed MOVED out of passthrough (Codex R5 P1-2,\n    # PLAN-135-FOLLOWUP) → dedicated _MODEL_REFUSAL_OBSERVED_ALLOWLIST scrub\n    # branch in emit_generic (stop_reason/stop_category/http_status/duration_ms\n    # value-bounded against a direct caller).\n    \"otel_export_dropped\",\n    \"output_safety_flag\",\n    \"output_scan_finding\",\n    \"pair_rail_codex_unavailable\",\n    \"pair_rail_codex_violation\",\n    \"pair_rail_review_passed\",\n    \"pair_rail_sentinel_bypass\",\n    \"pattern_evicted\",\n    \"pattern_queried\",\n    \"pattern_stored\",\n    \"persona_auto_decision_emitted\",\n    \"persona_auto_rate_capped\",\n    \"phase_c_enforcing_flipped\",\n    \"plan_transition\",\n    \"policy_denied\",\n    \"policy_error\",\n    \"policy_evaluated\",\n    \"prediction_queried\",\n    \"prompt_submitted\",\n    \"protocol_edit_missing_amend_paired\",\n    \"rag_auto_wire_skipped_sidecar_down\",\n    \"rag_false_large_demoted\",\n    \"rag_hit_rate_degraded\",\n    \"rag_index_redacted\",\n    \"rag_profile_recommended\",\n    \"rag_query_fallback\",\n    \"rag_query_issued\",\n    \"rag_query_redacted\",\n    \"rag_query_returned\",\n    \"rag_query_routed\",\n    \"reality_ledger_key_dropped\",\n    \"replay_capture_completed\",\n    \"replay_capture_started\",\n    \"replay_completed\",\n    \"replay_diff_produced\",\n    \"replay_started\",\n    \"repo_profile_confirmed\",\n    \"sentinel_created\",\n    \"sentinel_signer_expiry_warned\",\n    \"sentinel_signer_quorum_attempted\",\n    \"sentinel_signer_quorum_failed\",\n    \"sentinel_signer_revoked\",\n    \"sentinel_signer_rotated\",\n    \"sentinel_verified\",\n    \"session_end\",\n    \"session_start\",\n    \"session_stop\",\n    \"skill_bootstrap_post_hash\",\n    \"skill_bootstrap_used\",\n    \"skill_cache_stats\",\n    \"skill_patch_applied\",\n    \"skill_reference_never_read\",\n    \"skill_reference_read_mismatch\",\n    \"skill_reference_read_stale\",\n    # spawn_confidence_advisory + spec_context_sanitized REMOVED from passthrough\n    # (PLAN-113 Codex P2): moved to explicit per-action allowlist branches so\n    # Sec MF-3 deny-by-default is structurally enforced even if a future\n    # callsite adds unexpected fields. See _SPAWN_CONFIDENCE_ADVISORY_ALLOWLIST\n    # and _SPEC_CONTEXT_SANITIZED_ALLOWLIST below + dispatch branches in\n    # emit_generic.\n    \"squad_imported\",\n    \"state_store_pruned\",\n    \"state_store_read\",\n    \"state_store_write\",\n    # statusline_sidecar_write MOVED out of passthrough (Codex R5 P1-2,\n    # PLAN-135-FOLLOWUP) → dedicated _STATUSLINE_SIDECAR_WRITE_ALLOWLIST scrub\n    # branch in emit_generic (numeric/id/digest fields type-bounded; sidecar_path\n    # length-capped against a direct caller).\n    \"streaming_rate_capped\",\n    \"streaming_token_yielded\",\n    \"swarm_aborted_error\",\n    \"swarm_finalize_committed\",\n    \"swarm_finalize_grouped\",\n    \"swarm_halted_budget\",\n    \"swarm_halted_convergence\",\n    \"swarm_halted_kill\",\n    \"swarm_iteration\",\n    \"swarm_killed\",\n    \"swarm_started\",\n    \"swarm_tournament_selected\",\n    \"task_route_key_dropped\",\n    \"thinking_budget_set\",\n    \"threat_model_freshness_breach\",\n    \"threat_model_promoted\",\n    \"tier_policy_adopter_override_respected\",\n    \"tier_policy_demote_requested\",\n    \"tier_policy_derived\",\n    \"tier_policy_dry_run_complete\",\n    \"tier_policy_hmac_verify_failed\",\n    \"tier_policy_killswitch_triggered\",\n    \"tier_policy_promote_applied\",\n    \"tier_policy_promote_cost_gated\",\n    \"tier_policy_rejected\",\n    \"tournament_aborted\",\n    \"tournament_budget_exceeded\",\n    \"tournament_budget_projected\",\n    \"tournament_fixture_rejected\",\n    \"tournament_judge_hijack_suspected\",\n    \"tournament_run_completed\",\n    \"tournament_run_started\",\n    \"tournament_task_scored\",\n    \"veto_triggered\",\n    \"wave_artifact_written\",\n    \"wave_readonly_violation\",\n})\n\n\n# Defense-in-depth allowlists for the 3 destructive RESERVED federation\n# actions (no producer today; if an accidental caller appears, fields are\n# allowlist-bounded not raw). Fields per SPEC v2.29 rows.\n_FEDERATION_AUTONOMOUS_CALL_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"call_site\",\n}\n\n\n_FEDERATION_HMAC_SECRET_ROTATED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"rotation_reason_code\",\n}\n\n\n_FEDERATION_KEY_FLOOR_REJECTED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"key_type\", \"key_bits\", \"curve_name\", \"reason_code\",\n}\n\n\n_FEDERATION_KEY_FLOOR_STALE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"peer_id\", \"key_floor_verified_at_iso\", \"advisory_only\",\n}\n\n\n# PLAN-113 Codex P1 — bash_canonical_bypass_invoked field allowlist.\n# target_path_preview REMOVED (raw filesystem path → Sec MF-3 violation).\n# Replaced by target_path_hash (12-hex sha256 prefix; no path body leaks).\n_BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"token_hash_prefix\",\n    \"target_path_hash\",\n    \"ticket_expires_in_s\",\n    \"atlas_technique\",\n}\n\n\n# PLAN-113 Codex P2 — spawn_confidence_advisory explicit allowlist.\n# Moved from _EMIT_GENERIC_PASSTHROUGH so Sec MF-3 deny-by-default is\n# structurally enforced. Fields: bounded enums/labels from\n# check_agent_spawn._emit_spawn_confidence_advisory() per SPEC v2.34.\n_SPAWN_CONFIDENCE_ADVISORY_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"action_type\",\n    \"confidence_level\",\n    \"confidence_marker\",\n    \"reason_code\",\n    \"is_named_spawn\",\n}\n\n\n# PLAN-153 Wave E item 7 (ADR-175) — spawn_prompt_defense_gate explicit allowlist.\n# Sec MF-3 deny-by-default: only the 3 caller-supplied fields from\n# check_agent_spawn._emit_prompt_defense_event() persist. `keyword` is a\n# closed-enum untrusted-content hint (bounded + 32-char capped in the dispatch\n# branch below); `present`/`enforced` are 0/1 flags. NO prompt/description body.\n_SPAWN_PROMPT_DEFENSE_GATE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"keyword\",\n    \"present\",\n    \"enforced\",\n}\n\n\n# PLAN-113 Codex P2 — spec_context_sanitized explicit allowlist.\n# Moved from _EMIT_GENERIC_PASSTHROUGH so Sec MF-3 deny-by-default is\n# structurally enforced. Fields: bounded counters/flags from\n# check_agent_spawn._maybe_sanitize_spec_context() per SPEC v2.34.\n# No prompt content is persisted — all fields are derived byte/count metrics.\n_SPEC_CONTEXT_SANITIZED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"original_bytes\",\n    \"cleaned_bytes\",\n    \"truncated\",\n    \"sentinel_violations\",\n    \"control_chars_stripped\",\n    \"bidi_zw_chars_stripped\",\n    \"tag_chars_stripped\",\n    \"header_escape_count\",\n}\n\n\n# PLAN-135-FOLLOWUP (Codex R5 P1-2) — the 3 W5 ops actions move OFF\n# _EMIT_GENERIC_PASSTHROUGH into dedicated deny-by-default scrub branches so the\n# Sec MF-3 field-allowlist + enum-value-coercion boundary holds against a direct /\n# future emit_generic caller that bypasses the trusted producer. Field sets are\n# byte-accurate to the live producers AND to SPEC/v1/audit-log.schema.md L480-482.\n#\n# o9 — Anthropic Admin API key-lifecycle (.claude/scripts/key-hygiene.py\n# `_audit_emit`). Producer passes operation + a per-call-site subset of\n# {key_count | key_id | reason | rotation_log_appended}; rotated_by/notes go to\n# docs/rotation-log.md, NEVER the emit. `reason` is a REQUIRED credential-forensic\n# field (the WHY of a key deactivation) — kept + enum-coerced, never dropped.\n_ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"operation\",\n    \"key_id\",\n    \"key_count\",\n    \"reason\",\n    \"rotation_log_appended\",\n}\n\n\n# Closed enums for VALUE re-coercion (mirror key-hygiene.py: the operation\n# discriminator + VALID_REASONS). Out-of-set → \"other\" (S172 coerce-to-safe-\n# sentinel) so a direct caller cannot smuggle free text through an allowed key.\n_ADMIN_KEY_OPERATIONS = frozenset({\"list\", \"deactivate\", \"incident\"})\n\n\n_ADMIN_KEY_REASONS = frozenset({\"compromise\", \"suspicion\", \"scheduled\"})\n\n\n# o4 — statusLine sidecar-write (.claude/scripts/statusline-ceo.py `maybe_emit`).\n# session_id is already in _FEDERATION_ENVELOPE; sidecar_path is an abs path SPEC\n# L481 explicitly permits — length-capped to bound log-line bloat / oversized-field\n# log-injection (Codex R5 P1-2 sec must-fix).\n_STATUSLINE_SIDECAR_WRITE_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"sidecar_path\",\n    \"plan_id\",\n    # PLAN-135-FOLLOWUP-2 (S234): percentage fields are HMAC-covered ->\n    # integer basis-points (pct * 100), NEVER float. The canonical encoder\n    # forbids float (S181 / ADR-055-AMEND-2); the float form was written\n    # with hmac=null on every emit since v2.44. Producer converts pct->bps;\n    # the scrub branch below clamps to int authoritatively.\n    \"context_pct_bps\",\n    \"bucket_count\",\n    \"buckets_used_pct_max_bps\",\n    \"digest\",\n}\n\n\n_STATUSLINE_SIDECAR_PATH_CAP = 512\n\n\n_STATUSLINE_STR_CAP = 256\n\n\n# o7 — model-refusal observability (.claude/hooks/_lib/adapters/live/claude.py\n# `_on_response`). stop_reason is the const \"refusal\"; stop_category is the closed\n# provider vocabulary (<=64); http_status/duration_ms are bounded non-negative ints\n# (no float in the HMAC-covered chain — S181 doctrine).\n_MODEL_REFUSAL_OBSERVED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"provider\",\n    \"model\",\n    \"stop_reason\",\n    \"stop_category\",\n    \"http_status\",\n    \"duration_ms\",\n}\n\n\n# PLAN-133 A2 — Sec field allowlist for invisible_unicode_blocked. Deny-by-default.\n# The ONLY caller-supplied payload fields are the closed-enum `surface` +\n# `unicode_class`, the bounded int `char_count`, and the flag `enforced`. The\n# prompt / skill text, the matched characters, and any var/value are NEVER allowed\n# fields, so smuggled content can never reach the signed chain.\n_INVISIBLE_UNICODE_BLOCKED_ALLOWLIST = _FEDERATION_ENVELOPE | {\n    \"surface\",\n    \"unicode_class\",\n    \"char_count\",\n    \"enforced\",\n}\n\n\n# PLAN-133 A2 — closed unicode_class enum. MUST mirror\n# _lib/spec_context_sanitizer.INVISIBLE_UNICODE_CLASSES. Kept as a literal frozenset\n# here (NOT imported) so audit_emit has zero import-time dependency on the sanitizer;\n# a drift is caught by a dedicated test (the two frozensets MUST be equal). A value\n# outside this set is COERCED to \"control\" before emit (defense-in-depth).\n_INVISIBLE_UNICODE_CLASSES = frozenset({\n    \"tag_block\", \"bidi_zw\", \"control\", \"none\",\n})\n\n\n# PLAN-133 A2 — closed surface enum (origin of the detection). Out-of-set → \"spawn\".\n_INVISIBLE_UNICODE_SURFACES = frozenset({\n    \"spawn\", \"skill_write\", \"skill_read\",\n})\n","numLines":573,"startLine":1,"totalLines":573}},"tool_result_meta":[{"id":"toolu_01ChguZAhwrREfBi7qVxqbbe","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
