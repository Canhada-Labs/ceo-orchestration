{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BWuUDdZ2Mk5jgQmythkkD6","type":"tool_result","content":"1\t\"\"\"Audit persistence helpers bound into the audit_emit facade.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\t__all__ = (\n6\t    \"_FALLBACK_NOTIFIED\",\n7\t    \"_fallback_log_path\",\n8\t    \"_emit_fallback_banner_once\",\n9\t    \"_write_fallback\",\n10\t    \"_safe_target_ref_hash_field\",\n11\t    \"_accel_clamp_count\",\n12\t    \"_auto_compact_clamp_pct\",\n13\t    \"_e3_clamp01\",\n14\t    \"_e3_safe_path_hashes\",\n15\t    \"_safe_token_sha_field\",\n16\t    \"_federation_safe_path_hash\",\n17\t    \"_audit_dir\",\n18\t    \"_log_path\",\n19\t    \"_log_family_dir\",\n20\t    \"_lock_path\",\n21\t    \"_errors_path\",\n22\t    \"_utc_now_iso\",\n23\t    \"_breadcrumb\",\n24\t    \"_DEFAULT_ROTATE_AT_BYTES\",\n25\t    \"_rotate_threshold\",\n26\t    \"_now_month_slug\",\n27\t    \"_rotate_if_needed_safe\",\n28\t    \"_VALID_ROTATION_TRIGGERS\",\n29\t    \"_normalize_rotation_trigger\",\n30\t    \"_emit_chain_reset_marker_under_lock\",\n31\t    \"_write_event\",\n32\t    \"_preview\",\n33\t)\n34\t\n35\t_FALLBACK_NOTIFIED = False\n36\t\n37\t\n38\tdef _fallback_log_path() -> Path:\n39\t    \"\"\"Return the /tmp fallback audit path, user-scoped.\n40\t\n41\t    Env override: ``CEO_AUDIT_LOG_FALLBACK_PATH`` for tests.\n42\t    \"\"\"\n43\t    override = os.environ.get(\"CEO_AUDIT_LOG_FALLBACK_PATH\")\n44\t    if override:\n45\t        return Path(override)\n46\t    try:\n47\t        user = getpass.getuser() or \"unknown\"\n48\t    except Exception:  # pragma: no cover\n49\t        user = os.environ.get(\"USER\") or \"unknown\"\n50\t    user = \"\".join(c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\"))\n51\t    return Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n52\t\n53\t\n54\tdef _emit_fallback_banner_once(primary: Path, fallback: Path, err: str) -> None:\n55\t    \"\"\"Emit `::warning::` stderr banner once per session (F-CHAOS-1).\"\"\"\n56\t    global _FALLBACK_NOTIFIED\n57\t    if _FALLBACK_NOTIFIED:\n58\t        return\n59\t    _FALLBACK_NOTIFIED = True\n60\t    try:\n61\t        sys.stderr.write(\n62\t            f\"::warning::audit-log write failed ({err}); \"\n63\t            f\"falling back to {fallback}. \"\n64\t            f\"Investigate writability of {primary.parent}.\\n\"\n65\t        )\n66\t        sys.stderr.flush()\n67\t    except Exception:  # pragma: no cover\n68\t        pass\n69\t\n70\t\n71\tdef _write_fallback(event_line: str) -> bool:\n72\t    \"\"\"Append ``event_line`` to fallback path with 0o600. Never raises.\"\"\"\n73\t    try:\n74\t        fallback = _fallback_log_path()\n75\t        fallback.parent.mkdir(parents=True, exist_ok=True)\n76\t        with fallback.open(\"a\", encoding=\"utf-8\") as f:\n77\t            f.write(event_line)\n78\t            # PLAN-025 F-obs-002 — durability on fallback path too; if the\n79\t            # primary failed and we're writing fallback, crash-safety matters\n80\t            # MORE than on the happy path.\n81\t            f.flush()\n82\t            try:\n83\t                os.fsync(f.fileno())\n84\t            except (OSError, AttributeError):\n85\t                pass\n86\t        try:\n87\t            os.chmod(fallback, 0o600)\n88\t        except OSError:\n89\t            pass\n90\t        return True\n91\t    except Exception as e:\n92\t        try:\n93\t            sys.stderr.write(\n94\t                f\"[audit_emit] fallback write ALSO failed: {type(e).__name__}: {e}\\n\"\n95\t            )\n96\t            sys.stderr.flush()\n97\t        except Exception:  # pragma: no cover\n98\t            pass\n99\t        return False\n100\t\n101\t\n102\tdef _safe_target_ref_hash_field(v):\n103\t    \"\"\"Return a non-empty 12-hex (or shorter) lowercase hash, else '' (fail-closed;\n104\t    never echoes a rejected value such as a raw branch name a caller tried to stuff).\"\"\"\n105\t    s = str(v or \"\")\n106\t    if s and len(s) <= 12 and all(c in \"0123456789abcdef\" for c in s):\n107\t        return s\n108\t    return \"\"\n109\t\n110\t\n111\tdef _accel_clamp_count(v):\n112\t    try:\n113\t        n = int(v)\n114\t    except (TypeError, ValueError):\n115\t        return 0\n116\t    return 0 if n < 0 else (99 if n > 99 else n)\n117\t\n118\t\n119\tdef _auto_compact_clamp_pct(v):\n120\t    \"\"\"Coerce to an int percent in [0, 100]; 0 on malformed (never echoes).\"\"\"\n121\t    try:\n122\t        n = int(v)\n123\t    except (TypeError, ValueError):\n124\t        return 0\n125\t    return 0 if n < 0 else (100 if n > 100 else n)\n126\t\n127\t\n128\tdef _e3_clamp01(v):\n129\t    \"\"\"Coerce to 0/1 (enforced flag). Anything truthy-but-weird -> 0 (safe).\"\"\"\n130\t    try:\n131\t        return 1 if int(v) == 1 else 0\n132\t    except (TypeError, ValueError):\n133\t        return 0\n134\t\n135\t\n136\tdef _e3_safe_path_hashes(v):\n137\t    \"\"\"Keep only comma-joined 12-hex tokens; drop anything else (a caller\n138\t    that tries to stuff a raw path gets it silently dropped, never echoed).\"\"\"\n139\t    s = str(v or \"\")\n140\t    toks = []\n141\t    for t in s.split(\",\"):\n142\t        t = t.strip()\n143\t        if t and len(t) <= 12 and all(c in \"0123456789abcdef\" for c in t):\n144\t            toks.append(t)\n145\t    return \",\".join(toks)[:512]\n146\t\n147\t\n148\tdef _safe_token_sha_field(v):\n149\t    \"\"\"Return a 64-hex lowercase token hash, else '' (fail-closed; never\n150\t    echoes a rejected value such as a raw token a caller tried to stuff).\"\"\"\n151\t    s = str(v or \"\")\n152\t    if len(s) == 64 and all(c in \"0123456789abcdef\" for c in s):\n153\t        return s\n154\t    return \"\"\n155\t\n156\t\n157\tdef _federation_safe_path_hash(raw: str) -> str:\n158\t    \"\"\"Return a 12-hex hash of a filesystem-path field (Sec MF-3 / LLM06).\n159\t\n160\t    Mirrors :func:`_persona_demand_safe_hash` strictness: an already-12-hex\n161\t    value passes through (idempotent re-hash safe); anything else (a raw\n162\t    host path) is SHA-256'd and truncated to 12 hex chars so no path body\n163\t    can leak into the HMAC-chained audit log.\n164\t    \"\"\"\n165\t    import hashlib\n166\t\n167\t    s = str(raw or \"\").strip().lower()\n168\t    if len(s) == 12 and all(c in \"0123456789abcdef\" for c in s):\n169\t        return s\n170\t    return hashlib.sha256(s.encode(\"utf-8\", errors=\"replace\")).hexdigest()[:12]\n171\t\n172\t\n173\tdef _audit_dir() -> Path:\n174\t    \"\"\"Return the audit log directory (env-overridable; matches audit_log.py).\n175\t\n176\t    PLAN-182 W1 (ADR-001 S318 amendment): the default delegates to the\n177\t    single family resolver — per-project native slug — instead of the\n178\t    four-month literal. ``CEO_AUDIT_LOG_DIR`` keeps its whole-dir\n179\t    precedence for tests/multi-log setups.\n180\t    \"\"\"\n181\t    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n182\t    if env_dir:\n183\t        return Path(env_dir)\n184\t    return _runtime_paths.runtime_state_dir()\n185\t\n186\t\n187\tdef _log_path() -> Path:\n188\t    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n189\t    if env:\n190\t        return Path(env)\n191\t    return _audit_dir() / \"audit-log.jsonl\"\n192\t\n193\t\n194\tdef _log_family_dir() -> Path:\n195\t    \"\"\"Return the dir the lock/errors sidecars must share with the LOG.\n196\t\n197\t    PLAN-182 W1 family-atomicity cure (ADR-001 S318 amendment item 3):\n198\t    when ``CEO_AUDIT_LOG_PATH`` moves the log, the lock and errors\n199\t    FOLLOW its parent instead of staying on the default dir — the W0\n200\t    matrix measured that split leaving two projects with distinct logs\n201\t    serializing on one lock. ``.resolve().parent`` matches\n202\t    ``audit_hmac._audit_dir_from_env`` byte-for-byte so key, lock and\n203\t    errors co-locate under the same derivation.\n204\t    \"\"\"\n205\t    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n206\t    if env:\n207\t        return Path(env).resolve().parent\n208\t    return _audit_dir()\n209\t\n210\t\n211\tdef _lock_path() -> Path:\n212\t    env = os.environ.get(\"CEO_AUDIT_LOG_LOCK\")\n213\t    if env:\n214\t        return Path(env)\n215\t    return _log_family_dir() / \"audit-log.lock\"\n216\t\n217\t\n218\tdef _errors_path() -> Path:\n219\t    env = os.environ.get(\"CEO_AUDIT_LOG_ERR\")\n220\t    if env:\n221\t        return Path(env)\n222\t    return _log_family_dir() / \"audit-log.errors\"\n223\t\n224\t\n225\tdef _utc_now_iso() -> str:\n226\t    \"\"\"Return current UTC time in ISO 8601 second-precision.\"\"\"\n227\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n228\t\n229\t\n230\tdef _breadcrumb(message: str) -> None:\n231\t    \"\"\"Append a failure breadcrumb. Fail-open: never raise.\"\"\"\n232\t    try:\n233\t        err = _errors_path()\n234\t        err.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n235\t        with err.open(\"a\", encoding=\"utf-8\") as f:\n236\t            f.write(f\"{_utc_now_iso()} audit_emit: {message}\\n\")\n237\t    except Exception:  # pragma: no cover\n238\t        pass\n239\t\n240\t\n241\t_DEFAULT_ROTATE_AT_BYTES = 10 * 1024 * 1024\n242\t\n243\t\n244\tdef _rotate_threshold() -> int:\n245\t    \"\"\"Return the active rotation threshold (bytes).\n246\t\n247\t    Mirrors `audit_log.rotate_threshold()` so both write paths use\n248\t    identical semantics. Env override: ``CEO_AUDIT_LOG_ROTATE_BYTES``.\n249\t    \"\"\"\n250\t    env = os.environ.get(\"CEO_AUDIT_LOG_ROTATE_BYTES\")\n251\t    if env:\n252\t        try:\n253\t            val = int(env)\n254\t            if val > 0:\n255\t                return val\n256\t        except ValueError:\n257\t            pass\n258\t    return _DEFAULT_ROTATE_AT_BYTES\n259\t\n260\t\n261\tdef _now_month_slug() -> str:\n262\t    \"\"\"Return the current UTC year-month slug (YYYY-MM) for rotated files.\n263\t\n264\t    Mirrors `audit_log.now_month_slug()`; kept local to avoid a runtime\n265\t    coupling on that module (audit_emit.py is a leaf `_lib/` primitive\n266\t    per ADR-002, audit_log.py is a hook entrypoint).\n267\t    \"\"\"\n268\t    now = datetime.now(timezone.utc)\n269\t    return now.strftime(\"%Y-%m\")\n270\t\n271\t\n272\tdef _rotate_if_needed_safe(log_path: Path) -> Optional[Path]:\n273\t    \"\"\"Invoke the shared rotation primitive; fail-open on any error.\n274\t\n275\t    MUST be called UNDER the audit-log FileLock. Returns the rotated-to\n276\t    path on success or None if no rotation was performed.\n277\t    \"\"\"\n278\t    if not _ROTATION_AVAILABLE or _shared_rotate_if_needed is None:\n279\t        return None\n280\t    try:\n281\t        return _shared_rotate_if_needed(\n282\t            log_path, _rotate_threshold(), _now_month_slug()\n283\t        )\n284\t    except Exception as e:  # pragma: no cover\n285\t        _breadcrumb(f\"rotate_if_needed exception: {type(e).__name__}: {e}\")\n286\t        return None\n287\t\n288\t\n289\t_VALID_ROTATION_TRIGGERS = frozenset(\n290\t    (\n291\t        \"size_threshold\",\n292\t        \"manual\",\n293\t        \"owner_rotation\",\n294\t        \"quarantine_pre_fix\",\n295\t    )\n296\t)\n297\t\n298\t\n299\tdef _normalize_rotation_trigger(value: object) -> str:\n300\t    \"\"\"Coerce + validate a rotation_trigger against the closed enum.\n301\t\n302\t    Truncates to 32 chars then fails OPEN to the common-case\n303\t    ``size_threshold`` for any value outside ``_VALID_ROTATION_TRIGGERS``.\n304\t    Fail-open (never raises) matches the audit-emit contract — the marker\n305\t    must still be written on rotation.\n306\t    \"\"\"\n307\t    s = str(value)[:32]\n308\t    if s not in _VALID_ROTATION_TRIGGERS:\n309\t        return \"size_threshold\"\n310\t    return s\n311\t\n312\t\n313\t# QDSAA-FUNCAO-LONGA: mantém a compatibilidade de dispatch e o lookup dinâmico da fachada.\n314\tdef _emit_chain_reset_marker_under_lock(\n315\t    log: Path,\n316\t    previous_archive_path: str,\n317\t    rotation_trigger: str = \"size_threshold\",\n318\t) -> Optional[bytes]:\n319\t    \"\"\"Emit chain_reset_marker as line 1 + write rotation manifest.\n320\t\n321\t    Caller MUST hold the canonical FileLock + the canonical log file\n322\t    MUST be empty (just rotated). Returns the marker HMAC bytes on\n323\t    success or None on failure (caller breadcrumbs + falls back to\n324\t    legacy-mode rotation without marker).\n325\t\n326\t    Side effects under the lock (sidecars-before-marker order per\n327\t    Codex R3 P1 fold — partial-failure recoverable):\n328\t    1. Read rotated archive's last hmac (best-effort; \"\" if not found)\n329\t    2. Compute marker HMAC at GENESIS_PREV (marker is genesis-anchored)\n330\t    3. **Write rotation manifest sidecar FIRST** (fail-closed: return None\n331\t       if fails — marker not on disk, next emit uses legacy mode)\n332\t    4. **Write audit-log.last-hmac with marker HMAC** (fail-closed: revert\n333\t       manifest, return None — both sidecars in pre-marker state)\n334\t    5. Write audit-log.chain-length to 1 (non-critical canary; fail-open\n335\t       with breadcrumb)\n336\t    6. **Append marker line LAST to new audit-log.jsonl** (line 1; if this\n337\t       fails, sidecars + manifest already consistent → verifier in\n338\t       manifest-required mode tamper-flags the missing line 1 marker,\n339\t       which is correct fail-LOUD detection)\n340\t\n341\t    Pre-R3 order was: append-then-sidecars (marker on disk before manifest\n342\t    write); a sidecar failure could leave marker on disk + stale sidecars,\n343\t    causing the NEXT emit to chain from genesis and produce a broken\n344\t    line 2. The sidecars-first ordering eliminates this failure mode.\n345\t    \"\"\"\n346\t    from datetime import datetime, timezone\n347\t\n348\t    try:\n349\t        # Step 1: read rotated archive's last hmac.\n350\t        previous_archive_last_hmac = \"\"\n351\t        try:\n352\t            archive_path = Path(previous_archive_path)\n353\t            if archive_path.exists() and archive_path.stat().st_size > 0:\n354\t                # Read last non-empty line from archive\n355\t                with open(archive_path, \"rb\") as f:\n356\t                    f.seek(0, 2)  # seek to end\n357\t                    file_size = f.tell()\n358\t                    # Read last 4KB (sufficient for one JSONL line)\n359\t                    seek_to = max(0, file_size - 4096)\n360\t                    f.seek(seek_to)\n361\t                    tail = f.read().decode(\"utf-8\", errors=\"replace\")\n362\t                    last_line = \"\"\n363\t                    for line in tail.splitlines():\n364\t                        line = line.strip()\n365\t                        if line:\n366\t                            last_line = line\n367\t                    if last_line:\n368\t                        try:\n369\t                            last_entry = json.loads(last_line)\n370\t                            if isinstance(last_entry, dict):\n371\t                                hmac_val = last_entry.get(\"hmac\")\n372\t                                if isinstance(hmac_val, str) and len(hmac_val) == 64:\n373\t                                    previous_archive_last_hmac = hmac_val\n374\t                        except json.JSONDecodeError:\n375\t                            pass\n376\t        except (OSError, AttributeError):\n377\t            pass\n378\t\n379\t        # Step 2: compute marker HMAC at GENESIS_PREV (genesis-anchored).\n380\t        rotated_at = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n381\t        marker_event = {\n382\t            \"action\": \"chain_reset_marker\",\n383\t            \"previous_archive_path\": str(previous_archive_path)[:256],\n384\t            \"previous_archive_last_hmac\": previous_archive_last_hmac[:64],\n385\t            \"rotation_ts\": rotated_at,\n386\t            \"rotation_trigger\": _normalize_rotation_trigger(rotation_trigger),\n387\t            \"session_id\": \"\",\n388\t            \"project\": \"\",\n389\t            \"event_schema\": \"v2\",\n390\t            \"ts\": rotated_at,\n391\t            \"tokens_in\": None,\n392\t            \"tokens_out\": None,\n393\t            \"tokens_total\": None,\n394\t        }\n395\t        key = _audit_hmac.get_or_create_key()\n396\t        marker_sans_hmac = {\n397\t            k: v for k, v in marker_event.items() if k != \"hmac\" and k != \"hmac_error\"\n398\t        }\n399\t        try:\n400\t            marker_digest = _audit_hmac.compute_entry_hmac(\n401\t                key, _audit_hmac.GENESIS_PREV, marker_sans_hmac\n402\t            )\n403\t        except _audit_hmac.AuditProducerPathPollutionError as ppe:\n404\t            # PLAN-118 AC-B4 chokepoint 1 + recursion-safety case 3 —\n405\t            # detected at the marker chokepoint itself. SKIP the marker\n406\t            # emission entirely (the marker would otherwise be signed\n407\t            # under the polluted producer's canonicalization, perpetuating\n408\t            # the exact bug we're closing). Write ONE bounded breadcrumb\n409\t            # line directly to the host's audit-log via the pre-canonical\n410\t            # fast-path (stdlib `open(path, 'a')` JSON write — NO\n411\t            # _write_event, NO compute_entry_hmac re-entry, NO chain\n412\t            # anchoring). The breadcrumb is non-chain-anchored advisory;\n413\t            # the chain head is what we're protecting.\n414\t            _breadcrumb(f\"chain_reset_marker SKIPPED (producer path pollution): {ppe}\")\n415\t            # Parse the exception message to extract closed-enum fields.\n416\t            # The exception message format is:\n417\t            #   \"non_canonical_lib_resolution: reason_code=<rc> \"\n418\t            #   \"path_sha256_prefix=<8hex> \"\n419\t            #   \"expected_canonical_prefix=<8hex>\"\n420\t            try:\n421\t                _msg = str(ppe)\n422\t                _rc = \"audit_emit_path_pollution\"  # safe default\n423\t                _psp = \"[REDACTED:rg]\"\n424\t                _ecp = \"[REDACTED:rg]\"\n425\t                for _tok in _msg.split():\n426\t                    if _tok.startswith(\"reason_code=\"):\n427\t                        _rc_candidate = _tok.split(\"=\", 1)[1]\n428\t                        if _rc_candidate in _AUDIT_PRODUCER_PATH_POLLUTION_REASON_CODES:\n429\t                            _rc = _rc_candidate\n430\t                    elif _tok.startswith(\"path_sha256_prefix=\"):\n431\t                        _psp_candidate = _tok.split(\"=\", 1)[1]\n432\t                        if len(_psp_candidate) == 8 and all(\n433\t                            c in \"0123456789abcdef\" for c in _psp_candidate\n434\t                        ):\n435\t                            _psp = _psp_candidate\n436\t                    elif _tok.startswith(\"expected_canonical_prefix=\"):\n437\t                        _ecp_candidate = _tok.split(\"=\", 1)[1]\n438\t                        if len(_ecp_candidate) == 8 and all(\n439\t                            c in \"0123456789abcdef\" for c in _ecp_candidate\n440\t                        ):\n441\t                            _ecp = _ecp_candidate\n442\t                _breadcrumb_event = {\n443\t                    \"action\": \"audit_producer_path_pollution_detected\",\n444\t                    \"ts\": rotated_at,\n445\t                    \"session_id\": \"\",\n446\t                    \"project\": \"\",\n447\t                    \"event_schema\": \"v2\",\n448\t                    \"tokens_in\": None,\n449\t                    \"tokens_out\": None,\n450\t                    \"tokens_total\": None,\n451\t                    \"hmac\": None,\n452\t                    \"hmac_error\": \"producer_path_pollution_detected\",\n453\t                    \"chokepoint\": \"chain_reset_marker\",\n454\t                    \"reason_code\": _rc,\n455\t                    \"path_sha256_prefix\": _psp,\n456\t                    \"expected_canonical_prefix\": _ecp,\n457\t                }\n458\t                _line = json.dumps(_breadcrumb_event, ensure_ascii=False) + \"\\n\"\n459\t                with log.open(\"a\", encoding=\"utf-8\") as _f:\n460\t                    _f.write(_line)\n461\t                    _f.flush()\n462\t            except Exception as _be:  # pragma: no cover\n463\t                _breadcrumb(\n464\t                    f\"chain_reset_marker breadcrumb fast-path write failed: \"\n465\t                    f\"{type(_be).__name__}: {_be}\"\n466\t                )\n467\t            return None\n468\t        marker_event[\"hmac\"] = _audit_hmac.hex_digest(marker_digest)\n469\t\n470\t        # PLAN-112-FOLLOWUP-hmac-tamper-fix Codex R3 P1 fold —\n471\t        # Sidecars-before-marker ordering: write all 3 sidecars FIRST,\n472\t        # then marker line LAST. If sidecar writes fail, marker is NOT\n473\t        # on disk yet → next emit handles via legacy chain-from-genesis\n474\t        # (recoverable). If sidecar succeeds + marker fails: revert\n475\t        # sidecars to pre-marker state (delete manifest + reset chain).\n476\t        # This makes partial-failure states recoverable + fail-closed\n477\t        # rather than silently mischaining line 2.\n478\t\n479\t        # Step 3 (was 4): write rotation manifest sidecar FIRST\n480\t        try:\n481\t            _audit_hmac.write_rotation_manifest(\n482\t                previous_archive_filename=str(Path(previous_archive_path).name),\n483\t                rotated_at=rotated_at,\n484\t            )\n485\t        except _audit_hmac.AuditHmacError as me:\n486\t            _breadcrumb(\n487\t                \"chain_reset_marker manifest write FAIL-CLOSED: {e}\".format(e=me)\n488\t            )\n489\t            return None  # marker not on disk; next emit uses legacy mode\n490\t\n491\t        # Step 4 (was 5): update last-hmac sidecar with marker's HMAC.\n492\t        try:\n493\t            _audit_hmac.write_last_hmac(marker_digest)\n494\t        except _audit_hmac.AuditHmacError as me:\n495\t            # Sidecar update failed; revert manifest write\n496\t            try:\n497\t                _audit_hmac.delete_rotation_manifest()\n498\t            except Exception:\n499\t                pass\n500\t            _breadcrumb(\n501\t                \"chain_reset_marker last_hmac write FAIL-CLOSED: {e}\".format(e=me)\n502\t            )\n503\t            return None\n504\t\n505\t        # Step 5 (was 6): update chain-length to 1 (marker is HMAC-bearing).\n506\t        try:\n507\t            _audit_hmac.write_chain_length(1)\n508\t        except _audit_hmac.AuditHmacError as ce:\n509\t            # Chain-length is detection-canary; non-critical\n510\t            _breadcrumb(\n511\t                \"chain_reset_marker chain_length write failed (non-blocking): \"\n512\t                \"{e}\".format(e=ce)\n513\t            )\n514\t\n515\t        # Step 6 (was 3): NOW append marker as line 1 of (current) new log.\n516\t        # If this fails, sidecars are already in marker-consistent state\n517\t        # but no line on disk — this is also recoverable: next sync emit\n518\t        # will see last-hmac=marker_digest and chain from it; the missing\n519\t        # marker line means verifier (manifest-mode) will tamper-flag\n520\t        # line 1, which is correct: marker IS required if manifest exists.\n521\t        line = json.dumps(marker_event, ensure_ascii=False) + \"\\n\"\n522\t        try:\n523\t            with log.open(\"a\", encoding=\"utf-8\") as f:\n524\t                f.write(line)\n525\t                f.flush()\n526\t                try:\n527\t                    os.fsync(f.fileno())\n528\t                except (OSError, AttributeError):\n529\t                    pass\n530\t        except OSError as we:\n531\t            # Marker line write failed. Sidecars already point at marker\n532\t            # HMAC + manifest exists → verifier will tamper-flag the\n533\t            # marker-missing state on next verify (correct fail-loud\n534\t            # behavior). Caller breadcrumbs.\n535\t            _breadcrumb(\"chain_reset_marker line write FAIL-LOUD: {e}\".format(e=we))\n536\t            return None\n537\t\n538\t        return marker_digest\n539\t    except Exception as e:  # pragma: no cover\n540\t        _breadcrumb(\n541\t            f\"_emit_chain_reset_marker_under_lock failed: {type(e).__name__}: {e}\"\n542\t        )\n543\t        return None\n544\t\n545\t\n546\t# QDSAA-FUNCAO-LONGA: mantém a compatibilidade de dispatch e o lookup dinâmico da fachada.\n547\tdef _write_event(event: Dict[str, Any]) -> None:\n548\t    \"\"\"Write a single JSONL event under the shared lock.\n549\t\n550\t    Fail-open: any exception writes a breadcrumb and returns silently.\n551\t    F-CHAOS-1 (PLAN-019): when the primary audit dir is unwritable, fall\n552\t    back to /tmp/ceo-audit-fallback-<user>.log with once-per-session banner.\n553\t    \"\"\"\n554\t    try:\n555\t        log = _log_path()\n556\t\n557\t        # Enforce mandatory fields\n558\t        if \"action\" not in event or event[\"action\"] not in _KNOWN_ACTIONS:\n559\t            _breadcrumb(f\"unknown action: {event.get('action')!r}\")\n560\t            return\n561\t\n562\t        # Always set event_schema + ts\n563\t        event.setdefault(\"event_schema\", EVENT_SCHEMA_V2)\n564\t        event.setdefault(\"ts\", _utc_now_iso())\n565\t\n566\t        # Reserve nullable cost fields (AI specialist P5)\n567\t        event.setdefault(\"tokens_in\", None)\n568\t        event.setdefault(\"tokens_out\", None)\n569\t        event.setdefault(\"tokens_total\", None)\n570\t\n571\t        # PLAN-023 Phase B (ADR-055) — HMAC chain fields.\n572\t        # Additive; null when chain is disabled or key-read fails.\n573\t        event.setdefault(\"hmac\", None)\n574\t        event.setdefault(\"hmac_error\", None)\n575\t\n576\t        # PLAN-094 Wave A.3 — spool-writer hot path (ADR-055-AMEND-1).\n577\t        # Default path: append to per-PID spool + occasional amortized drain.\n578\t        # Falls back to sync canonical write on kill-switch or any spool error.\n579\t        if (\n580\t            _SPOOL_WRITER_AVAILABLE\n581\t            and _spool_writer is not None\n582\t            and not _spool_writer.is_sync_mode()\n583\t        ):\n584\t            try:\n585\t                _spool_writer.spool_append(event)\n586\t                # PLAN-094-FOLLOWUP Wave A.3-fail-open (option B) — check\n587\t                # durability indicator; fall through to sync canonical\n588\t                # write if spool path silently swallowed an OSError.\n589\t                if _spool_writer.last_append_succeeded():\n590\t                    if _spool_writer.should_drain():\n591\t                        _spool_writer.drain_now()\n592\t                    return  # spool path succeeded\n593\t                _breadcrumb(\n594\t                    \"spool_append silent drop; falling back to sync canonical write\"\n595\t                )\n596\t                # fall through to sync canonical write below\n597\t            except Exception as se:  # pragma: no cover\n598\t                _breadcrumb(f\"spool path fallback to sync: {type(se).__name__}: {se}\")\n599\t                # fall through to sync canonical write below\n600\t\n601\t        # Phase 1: attempt primary write under lock.\n602\t        try:\n603\t            log.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n604\t            with FileLock(str(_lock_path()), timeout=2.5):\n605\t                # PLAN-045 Wave 2 P0-07/08 rotation wire — invoke the\n606\t                # shared rotation primitive BEFORE computing the HMAC.\n607\t                # If rotation happens, reset the chain sidecar so the next\n608\t                # write re-anchors at genesis in the new (empty) file.\n609\t                # Fail-open: any rotation exception is breadcrumbed and\n610\t                # the write proceeds against the over-threshold log.\n611\t                rotated_to = _rotate_if_needed_safe(log)\n612\t                if rotated_to is not None and _HMAC_AVAILABLE:\n613\t                    try:\n614\t                        _audit_hmac.reset_chain_on_rotation()\n615\t                    except Exception as re:  # pragma: no cover\n616\t                        _breadcrumb(\n617\t                            f\"reset_chain_on_rotation failed: {type(re).__name__}: {re}\"\n618\t                        )\n619\t                    # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — write\n620\t                    # chain_reset_marker as line 1 of new file + rotation\n621\t                    # manifest sidecar, per ADR-055-AMEND-2. Fail-open:\n622\t                    # if marker emit fails, manifest is NOT written, so\n623\t                    # verifier falls back to legacy mode (no marker\n624\t                    # enforcement on this rotation event).\n625\t                    if not _audit_hmac.is_disabled():\n626\t                        try:\n627\t                            _emit_chain_reset_marker_under_lock(\n628\t                                log=log,\n629\t                                previous_archive_path=str(rotated_to),\n630\t                                rotation_trigger=\"size_threshold\",\n631\t                            )\n632\t                        except Exception as me:  # pragma: no cover\n633\t                            _breadcrumb(\n634\t                                f\"chain_reset_marker emit failed (rotation \"\n635\t                                f\"proceeds without marker): \"\n636\t                                f\"{type(me).__name__}: {me}\"\n637\t                            )\n638\t\n639\t                # PLAN-023 Phase B — compute HMAC INSIDE the lock so the\n640\t                # read-modify-write sequence is atomic against concurrent\n641\t                # subprocess writes. Chain-fork defect (security review\n642\t                # §3b) avoided because prev_hmac read + compute + write +\n643\t                # sidecar update all happen under the same FileLock.\n644\t                if _HMAC_AVAILABLE and not _audit_hmac.is_disabled():\n645\t                    try:\n646\t                        key = _audit_hmac.get_or_create_key()\n647\t                        prev = _audit_hmac.read_prev_hmac()\n648\t                        entry_sans = {\n649\t                            k: v\n650\t                            for k, v in event.items()\n651\t                            if k != \"hmac\" and k != \"hmac_error\"\n652\t                        }\n653\t                        digest = _audit_hmac.compute_entry_hmac(key, prev, entry_sans)\n654\t                        event[\"hmac\"] = _audit_hmac.hex_digest(digest)\n655\t                    except _audit_hmac.AuditProducerPathPollutionError as ppe:\n656\t                        # PLAN-118 AC-B4 chokepoint 2 — _write_event HMAC\n657\t                        # path. Stale `_lib` on sys.path was detected by\n658\t                        # audit_hmac._ensure_canonical_lib_modules at\n659\t                        # compute_entry_hmac entry. Fail-OPEN at host\n660\t                        # hook (line written with hmac=null + closed-enum\n661\t                        # hmac_error); fail-CLOSED for the chain (no\n662\t                        # signed bytes leak under stale canonicalization).\n663\t                        # User session NEVER blocked.\n664\t                        event[\"hmac\"] = None\n665\t                        event[\"hmac_error\"] = \"producer_path_pollution_detected\"\n666\t                        _breadcrumb(\n667\t                            f\"hmac_error: producer_path_pollution_detected: {ppe}\"\n668\t                        )\n669\t                    except _audit_hmac.AuditHmacError as he:\n670\t                        # Fail-open: record the error kind + proceed\n671\t                        # with hmac=null. Operator finds breadcrumbs in\n672\t                        # audit-log.errors.\n673\t                        event[\"hmac\"] = None\n674\t                        event[\"hmac_error\"] = type(he).__name__\n675\t                        _breadcrumb(f\"hmac_error: {he}\")\n676\t                    except Exception as he:  # pragma: no cover\n677\t                        event[\"hmac\"] = None\n678\t                        event[\"hmac_error\"] = type(he).__name__\n679\t                        _breadcrumb(f\"hmac_unexpected: {type(he).__name__}: {he}\")\n680\t\n681\t                # Serialize AFTER the hmac field was populated so the\n682\t                # on-disk line matches the canonical form used to compute\n683\t                # the HMAC. ensure_ascii=False keeps Unicode; the HMAC\n684\t                # was computed on the NFC-normalized canonical form so\n685\t                # a verifier re-computing from the line gets the same\n686\t                # digest (json.loads → canonical_json.encode is lossless).\n687\t                line = json.dumps(event, ensure_ascii=False) + \"\\n\"\n688\t\n689\t                with log.open(\"a\", encoding=\"utf-8\") as f:\n690\t                    f.write(line)\n691\t                    f.flush()\n692\t                    try:\n693\t                        os.fsync(f.fileno())\n694\t                    except (OSError, AttributeError):\n695\t                        pass\n696\t                try:\n697\t                    os.chmod(log, 0o600)\n698\t                except OSError:\n699\t                    pass\n700\t\n701\t                # Update the last-hmac sidecar under the same lock so\n702\t                # the next writer sees the correct prev_hmac. Best-effort\n703\t                # (no fsync on sidecar per perf-engineer §10).\n704\t                if (\n705\t                    _HMAC_AVAILABLE\n706\t                    and event.get(\"hmac\")\n707\t                    and not _audit_hmac.is_disabled()\n708\t                ):\n709\t                    try:\n710\t                        _audit_hmac.write_last_hmac(_audit_hmac.from_hex(event[\"hmac\"]))\n711\t                    except _audit_hmac.AuditHmacError:\n712\t                        pass  # next read falls back to genesis\n713\t\n714\t                # PLAN-044 audit-v2 C6-P0-03 fix: wire chain-length canary\n715\t                # increment under same FileLock, after the JSON line is\n716\t                # already on disk + last_hmac persisted. Detection aid for\n717\t                # tail-truncation; gate-on-event[\"hmac\"] keeps counter\n718\t                # semantically aligned with verify_chain.verified_count.\n719\t                # Fail-open with breadcrumb (canary is detection-aid, not\n720\t                # correctness-critical). Ordering invariant: rotation ->\n721\t                # hmac compute -> JSON write+fsync -> write_last_hmac ->\n722\t                # canary increment. Future refactors must preserve order.\n723\t                if (\n724\t                    _HMAC_AVAILABLE\n725\t                    and event.get(\"hmac\")\n726\t                    and not _audit_hmac.is_disabled()\n727\t                ):\n728\t                    try:\n729\t                        n = _audit_hmac.read_chain_length()\n730\t                        _audit_hmac.write_chain_length(n + 1)\n731\t                    except _audit_hmac.AuditHmacError as ce:\n732\t                        _breadcrumb(\n733\t                            \"chain_length_canary_io_error: {cls}: {err}\".format(\n734\t                                cls=type(ce).__name__, err=ce\n735\t                            )\n736\t                        )  # fail-open: counter may stay stale; verifier-side re-walk catches drift\n737\t            return  # primary write succeeded\n738\t        except FileLockTimeout:\n739\t            # M9 — previously the entry was DROPPED on lock-timeout\n740\t            # (only a breadcrumb), so a contended log silently lost audit\n741\t            # events — the opposite of the tamper-evidence contract. Route the\n742\t            # event to the /tmp fallback log instead of dropping it. `line` is\n743\t            # NOT in scope here (it is built INSIDE the lock body, which never\n744\t            # ran because FileLock.__enter__ timed out), so serialize a\n745\t            # best-effort fallback line from `event` directly. It carries\n746\t            # hmac=null — acceptable: the fallback log is an explicitly\n747\t            # degraded, un-chained durability path (see banner), and a\n748\t            # null-hmac line in fallback is strictly better than a lost event.\n749\t            _breadcrumb(f\"lock timeout for action={event.get('action')!r}\")\n750\t            try:\n751\t                _fallback_line = json.dumps(event, ensure_ascii=False) + \"\\n\"\n752\t            except Exception:  # pragma: no cover — event unserializable\n753\t                _fallback_line = None\n754\t            if _fallback_line is not None:\n755\t                _emit_fallback_banner_once(log, _fallback_log_path(), \"lock timeout\")\n756\t                _write_fallback(_fallback_line)\n757\t            return\n758\t        except (OSError, PermissionError) as primary_err:\n759\t            # F-CHAOS-1: primary path unwritable → fallback + banner.\n760\t            _emit_fallback_banner_once(log, _fallback_log_path(), str(primary_err))\n761\t            _write_fallback(line)\n762\t            return\n763\t    except Exception as e:  # pragma: no cover\n764\t        _breadcrumb(f\"write_event exception: {type(e).__name__}: {e}\")\n765\t\n766\t\n767\tdef _preview(text: Optional[str], max_len: int = 120) -> str:\n768\t    \"\"\"Redact + collapse whitespace + truncate to max_len.\n769\t\n770\t    PLAN-087 Wave C.8: outer whitespace collapse removed. The\n771\t    redact_secrets call internally collapses whitespace already\n772\t    (see _lib/redact.py); the outer collapse was an O(N) no-op on\n773\t    the hot path that doubled the string scan cost for long inputs.\n774\t    str() coercion kept for defense-in-depth on Optional callers.\n775\t    KERNEL FILE - landed under CEO_KERNEL_OVERRIDE per ADR-116.\n776\t    \"\"\"\n777\t    if not text:\n778\t        return \"\"\n779\t    redacted = _redact.redact_secrets(str(text))\n780\t    if len(redacted) > max_len:\n781\t        return redacted[: max_len - 1] + \"…\"\n782\t    return redacted\n783\t"}]},"parent_tool_use_id":null,"session_id":"5ff2ef3b-1be9-4d6b-9faf-7d08cfab8359","uuid":"183e9a9f-72a1-4ce2-ba4d-485c3421e56f","timestamp":"2026-11-13T17:14:10.674Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/writer.py","content":"\"\"\"Audit persistence helpers bound into the audit_emit facade.\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = (\n    \"_FALLBACK_NOTIFIED\",\n    \"_fallback_log_path\",\n    \"_emit_fallback_banner_once\",\n    \"_write_fallback\",\n    \"_safe_target_ref_hash_field\",\n    \"_accel_clamp_count\",\n    \"_auto_compact_clamp_pct\",\n    \"_e3_clamp01\",\n    \"_e3_safe_path_hashes\",\n    \"_safe_token_sha_field\",\n    \"_federation_safe_path_hash\",\n    \"_audit_dir\",\n    \"_log_path\",\n    \"_log_family_dir\",\n    \"_lock_path\",\n    \"_errors_path\",\n    \"_utc_now_iso\",\n    \"_breadcrumb\",\n    \"_DEFAULT_ROTATE_AT_BYTES\",\n    \"_rotate_threshold\",\n    \"_now_month_slug\",\n    \"_rotate_if_needed_safe\",\n    \"_VALID_ROTATION_TRIGGERS\",\n    \"_normalize_rotation_trigger\",\n    \"_emit_chain_reset_marker_under_lock\",\n    \"_write_event\",\n    \"_preview\",\n)\n\n_FALLBACK_NOTIFIED = False\n\n\ndef _fallback_log_path() -> Path:\n    \"\"\"Return the /tmp fallback audit path, user-scoped.\n\n    Env override: ``CEO_AUDIT_LOG_FALLBACK_PATH`` for tests.\n    \"\"\"\n    override = os.environ.get(\"CEO_AUDIT_LOG_FALLBACK_PATH\")\n    if override:\n        return Path(override)\n    try:\n        user = getpass.getuser() or \"unknown\"\n    except Exception:  # pragma: no cover\n        user = os.environ.get(\"USER\") or \"unknown\"\n    user = \"\".join(c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\"))\n    return Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n\n\ndef _emit_fallback_banner_once(primary: Path, fallback: Path, err: str) -> None:\n    \"\"\"Emit `::warning::` stderr banner once per session (F-CHAOS-1).\"\"\"\n    global _FALLBACK_NOTIFIED\n    if _FALLBACK_NOTIFIED:\n        return\n    _FALLBACK_NOTIFIED = True\n    try:\n        sys.stderr.write(\n            f\"::warning::audit-log write failed ({err}); \"\n            f\"falling back to {fallback}. \"\n            f\"Investigate writability of {primary.parent}.\\n\"\n        )\n        sys.stderr.flush()\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _write_fallback(event_line: str) -> bool:\n    \"\"\"Append ``event_line`` to fallback path with 0o600. Never raises.\"\"\"\n    try:\n        fallback = _fallback_log_path()\n        fallback.parent.mkdir(parents=True, exist_ok=True)\n        with fallback.open(\"a\", encoding=\"utf-8\") as f:\n            f.write(event_line)\n            # PLAN-025 F-obs-002 — durability on fallback path too; if the\n            # primary failed and we're writing fallback, crash-safety matters\n            # MORE than on the happy path.\n            f.flush()\n            try:\n                os.fsync(f.fileno())\n            except (OSError, AttributeError):\n                pass\n        try:\n            os.chmod(fallback, 0o600)\n        except OSError:\n            pass\n        return True\n    except Exception as e:\n        try:\n            sys.stderr.write(\n                f\"[audit_emit] fallback write ALSO failed: {type(e).__name__}: {e}\\n\"\n            )\n            sys.stderr.flush()\n        except Exception:  # pragma: no cover\n            pass\n        return False\n\n\ndef _safe_target_ref_hash_field(v):\n    \"\"\"Return a non-empty 12-hex (or shorter) lowercase hash, else '' (fail-closed;\n    never echoes a rejected value such as a raw branch name a caller tried to stuff).\"\"\"\n    s = str(v or \"\")\n    if s and len(s) <= 12 and all(c in \"0123456789abcdef\" for c in s):\n        return s\n    return \"\"\n\n\ndef _accel_clamp_count(v):\n    try:\n        n = int(v)\n    except (TypeError, ValueError):\n        return 0\n    return 0 if n < 0 else (99 if n > 99 else n)\n\n\ndef _auto_compact_clamp_pct(v):\n    \"\"\"Coerce to an int percent in [0, 100]; 0 on malformed (never echoes).\"\"\"\n    try:\n        n = int(v)\n    except (TypeError, ValueError):\n        return 0\n    return 0 if n < 0 else (100 if n > 100 else n)\n\n\ndef _e3_clamp01(v):\n    \"\"\"Coerce to 0/1 (enforced flag). Anything truthy-but-weird -> 0 (safe).\"\"\"\n    try:\n        return 1 if int(v) == 1 else 0\n    except (TypeError, ValueError):\n        return 0\n\n\ndef _e3_safe_path_hashes(v):\n    \"\"\"Keep only comma-joined 12-hex tokens; drop anything else (a caller\n    that tries to stuff a raw path gets it silently dropped, never echoed).\"\"\"\n    s = str(v or \"\")\n    toks = []\n    for t in s.split(\",\"):\n        t = t.strip()\n        if t and len(t) <= 12 and all(c in \"0123456789abcdef\" for c in t):\n            toks.append(t)\n    return \",\".join(toks)[:512]\n\n\ndef _safe_token_sha_field(v):\n    \"\"\"Return a 64-hex lowercase token hash, else '' (fail-closed; never\n    echoes a rejected value such as a raw token a caller tried to stuff).\"\"\"\n    s = str(v or \"\")\n    if len(s) == 64 and all(c in \"0123456789abcdef\" for c in s):\n        return s\n    return \"\"\n\n\ndef _federation_safe_path_hash(raw: str) -> str:\n    \"\"\"Return a 12-hex hash of a filesystem-path field (Sec MF-3 / LLM06).\n\n    Mirrors :func:`_persona_demand_safe_hash` strictness: an already-12-hex\n    value passes through (idempotent re-hash safe); anything else (a raw\n    host path) is SHA-256'd and truncated to 12 hex chars so no path body\n    can leak into the HMAC-chained audit log.\n    \"\"\"\n    import hashlib\n\n    s = str(raw or \"\").strip().lower()\n    if len(s) == 12 and all(c in \"0123456789abcdef\" for c in s):\n        return s\n    return hashlib.sha256(s.encode(\"utf-8\", errors=\"replace\")).hexdigest()[:12]\n\n\ndef _audit_dir() -> Path:\n    \"\"\"Return the audit log directory (env-overridable; matches audit_log.py).\n\n    PLAN-182 W1 (ADR-001 S318 amendment): the default delegates to the\n    single family resolver — per-project native slug — instead of the\n    four-month literal. ``CEO_AUDIT_LOG_DIR`` keeps its whole-dir\n    precedence for tests/multi-log setups.\n    \"\"\"\n    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n    if env_dir:\n        return Path(env_dir)\n    return _runtime_paths.runtime_state_dir()\n\n\ndef _log_path() -> Path:\n    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n    if env:\n        return Path(env)\n    return _audit_dir() / \"audit-log.jsonl\"\n\n\ndef _log_family_dir() -> Path:\n    \"\"\"Return the dir the lock/errors sidecars must share with the LOG.\n\n    PLAN-182 W1 family-atomicity cure (ADR-001 S318 amendment item 3):\n    when ``CEO_AUDIT_LOG_PATH`` moves the log, the lock and errors\n    FOLLOW its parent instead of staying on the default dir — the W0\n    matrix measured that split leaving two projects with distinct logs\n    serializing on one lock. ``.resolve().parent`` matches\n    ``audit_hmac._audit_dir_from_env`` byte-for-byte so key, lock and\n    errors co-locate under the same derivation.\n    \"\"\"\n    env = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n    if env:\n        return Path(env).resolve().parent\n    return _audit_dir()\n\n\ndef _lock_path() -> Path:\n    env = os.environ.get(\"CEO_AUDIT_LOG_LOCK\")\n    if env:\n        return Path(env)\n    return _log_family_dir() / \"audit-log.lock\"\n\n\ndef _errors_path() -> Path:\n    env = os.environ.get(\"CEO_AUDIT_LOG_ERR\")\n    if env:\n        return Path(env)\n    return _log_family_dir() / \"audit-log.errors\"\n\n\ndef _utc_now_iso() -> str:\n    \"\"\"Return current UTC time in ISO 8601 second-precision.\"\"\"\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef _breadcrumb(message: str) -> None:\n    \"\"\"Append a failure breadcrumb. Fail-open: never raise.\"\"\"\n    try:\n        err = _errors_path()\n        err.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n        with err.open(\"a\", encoding=\"utf-8\") as f:\n            f.write(f\"{_utc_now_iso()} audit_emit: {message}\\n\")\n    except Exception:  # pragma: no cover\n        pass\n\n\n_DEFAULT_ROTATE_AT_BYTES = 10 * 1024 * 1024\n\n\ndef _rotate_threshold() -> int:\n    \"\"\"Return the active rotation threshold (bytes).\n\n    Mirrors `audit_log.rotate_threshold()` so both write paths use\n    identical semantics. Env override: ``CEO_AUDIT_LOG_ROTATE_BYTES``.\n    \"\"\"\n    env = os.environ.get(\"CEO_AUDIT_LOG_ROTATE_BYTES\")\n    if env:\n        try:\n            val = int(env)\n            if val > 0:\n                return val\n        except ValueError:\n            pass\n    return _DEFAULT_ROTATE_AT_BYTES\n\n\ndef _now_month_slug() -> str:\n    \"\"\"Return the current UTC year-month slug (YYYY-MM) for rotated files.\n\n    Mirrors `audit_log.now_month_slug()`; kept local to avoid a runtime\n    coupling on that module (audit_emit.py is a leaf `_lib/` primitive\n    per ADR-002, audit_log.py is a hook entrypoint).\n    \"\"\"\n    now = datetime.now(timezone.utc)\n    return now.strftime(\"%Y-%m\")\n\n\ndef _rotate_if_needed_safe(log_path: Path) -> Optional[Path]:\n    \"\"\"Invoke the shared rotation primitive; fail-open on any error.\n\n    MUST be called UNDER the audit-log FileLock. Returns the rotated-to\n    path on success or None if no rotation was performed.\n    \"\"\"\n    if not _ROTATION_AVAILABLE or _shared_rotate_if_needed is None:\n        return None\n    try:\n        return _shared_rotate_if_needed(\n            log_path, _rotate_threshold(), _now_month_slug()\n        )\n    except Exception as e:  # pragma: no cover\n        _breadcrumb(f\"rotate_if_needed exception: {type(e).__name__}: {e}\")\n        return None\n\n\n_VALID_ROTATION_TRIGGERS = frozenset(\n    (\n        \"size_threshold\",\n        \"manual\",\n        \"owner_rotation\",\n        \"quarantine_pre_fix\",\n    )\n)\n\n\ndef _normalize_rotation_trigger(value: object) -> str:\n    \"\"\"Coerce + validate a rotation_trigger against the closed enum.\n\n    Truncates to 32 chars then fails OPEN to the common-case\n    ``size_threshold`` for any value outside ``_VALID_ROTATION_TRIGGERS``.\n    Fail-open (never raises) matches the audit-emit contract — the marker\n    must still be written on rotation.\n    \"\"\"\n    s = str(value)[:32]\n    if s not in _VALID_ROTATION_TRIGGERS:\n        return \"size_threshold\"\n    return s\n\n\n# QDSAA-FUNCAO-LONGA: mantém a compatibilidade de dispatch e o lookup dinâmico da fachada.\ndef _emit_chain_reset_marker_under_lock(\n    log: Path,\n    previous_archive_path: str,\n    rotation_trigger: str = \"size_threshold\",\n) -> Optional[bytes]:\n    \"\"\"Emit chain_reset_marker as line 1 + write rotation manifest.\n\n    Caller MUST hold the canonical FileLock + the canonical log file\n    MUST be empty (just rotated). Returns the marker HMAC bytes on\n    success or None on failure (caller breadcrumbs + falls back to\n    legacy-mode rotation without marker).\n\n    Side effects under the lock (sidecars-before-marker order per\n    Codex R3 P1 fold — partial-failure recoverable):\n    1. Read rotated archive's last hmac (best-effort; \"\" if not found)\n    2. Compute marker HMAC at GENESIS_PREV (marker is genesis-anchored)\n    3. **Write rotation manifest sidecar FIRST** (fail-closed: return None\n       if fails — marker not on disk, next emit uses legacy mode)\n    4. **Write audit-log.last-hmac with marker HMAC** (fail-closed: revert\n       manifest, return None — both sidecars in pre-marker state)\n    5. Write audit-log.chain-length to 1 (non-critical canary; fail-open\n       with breadcrumb)\n    6. **Append marker line LAST to new audit-log.jsonl** (line 1; if this\n       fails, sidecars + manifest already consistent → verifier in\n       manifest-required mode tamper-flags the missing line 1 marker,\n       which is correct fail-LOUD detection)\n\n    Pre-R3 order was: append-then-sidecars (marker on disk before manifest\n    write); a sidecar failure could leave marker on disk + stale sidecars,\n    causing the NEXT emit to chain from genesis and produce a broken\n    line 2. The sidecars-first ordering eliminates this failure mode.\n    \"\"\"\n    from datetime import datetime, timezone\n\n    try:\n        # Step 1: read rotated archive's last hmac.\n        previous_archive_last_hmac = \"\"\n        try:\n            archive_path = Path(previous_archive_path)\n            if archive_path.exists() and archive_path.stat().st_size > 0:\n                # Read last non-empty line from archive\n                with open(archive_path, \"rb\") as f:\n                    f.seek(0, 2)  # seek to end\n                    file_size = f.tell()\n                    # Read last 4KB (sufficient for one JSONL line)\n                    seek_to = max(0, file_size - 4096)\n                    f.seek(seek_to)\n                    tail = f.read().decode(\"utf-8\", errors=\"replace\")\n                    last_line = \"\"\n                    for line in tail.splitlines():\n                        line = line.strip()\n                        if line:\n                            last_line = line\n                    if last_line:\n                        try:\n                            last_entry = json.loads(last_line)\n                            if isinstance(last_entry, dict):\n                                hmac_val = last_entry.get(\"hmac\")\n                                if isinstance(hmac_val, str) and len(hmac_val) == 64:\n                                    previous_archive_last_hmac = hmac_val\n                        except json.JSONDecodeError:\n                            pass\n        except (OSError, AttributeError):\n            pass\n\n        # Step 2: compute marker HMAC at GENESIS_PREV (genesis-anchored).\n        rotated_at = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n        marker_event = {\n            \"action\": \"chain_reset_marker\",\n            \"previous_archive_path\": str(previous_archive_path)[:256],\n            \"previous_archive_last_hmac\": previous_archive_last_hmac[:64],\n            \"rotation_ts\": rotated_at,\n            \"rotation_trigger\": _normalize_rotation_trigger(rotation_trigger),\n            \"session_id\": \"\",\n            \"project\": \"\",\n            \"event_schema\": \"v2\",\n            \"ts\": rotated_at,\n            \"tokens_in\": None,\n            \"tokens_out\": None,\n            \"tokens_total\": None,\n        }\n        key = _audit_hmac.get_or_create_key()\n        marker_sans_hmac = {\n            k: v for k, v in marker_event.items() if k != \"hmac\" and k != \"hmac_error\"\n        }\n        try:\n            marker_digest = _audit_hmac.compute_entry_hmac(\n                key, _audit_hmac.GENESIS_PREV, marker_sans_hmac\n            )\n        except _audit_hmac.AuditProducerPathPollutionError as ppe:\n            # PLAN-118 AC-B4 chokepoint 1 + recursion-safety case 3 —\n            # detected at the marker chokepoint itself. SKIP the marker\n            # emission entirely (the marker would otherwise be signed\n            # under the polluted producer's canonicalization, perpetuating\n            # the exact bug we're closing). Write ONE bounded breadcrumb\n            # line directly to the host's audit-log via the pre-canonical\n            # fast-path (stdlib `open(path, 'a')` JSON write — NO\n            # _write_event, NO compute_entry_hmac re-entry, NO chain\n            # anchoring). The breadcrumb is non-chain-anchored advisory;\n            # the chain head is what we're protecting.\n            _breadcrumb(f\"chain_reset_marker SKIPPED (producer path pollution): {ppe}\")\n            # Parse the exception message to extract closed-enum fields.\n            # The exception message format is:\n            #   \"non_canonical_lib_resolution: reason_code=<rc> \"\n            #   \"path_sha256_prefix=<8hex> \"\n            #   \"expected_canonical_prefix=<8hex>\"\n            try:\n                _msg = str(ppe)\n                _rc = \"audit_emit_path_pollution\"  # safe default\n                _psp = \"[REDACTED:rg]\"\n                _ecp = \"[REDACTED:rg]\"\n                for _tok in _msg.split():\n                    if _tok.startswith(\"reason_code=\"):\n                        _rc_candidate = _tok.split(\"=\", 1)[1]\n                        if _rc_candidate in _AUDIT_PRODUCER_PATH_POLLUTION_REASON_CODES:\n                            _rc = _rc_candidate\n                    elif _tok.startswith(\"path_sha256_prefix=\"):\n                        _psp_candidate = _tok.split(\"=\", 1)[1]\n                        if len(_psp_candidate) == 8 and all(\n                            c in \"0123456789abcdef\" for c in _psp_candidate\n                        ):\n                            _psp = _psp_candidate\n                    elif _tok.startswith(\"expected_canonical_prefix=\"):\n                        _ecp_candidate = _tok.split(\"=\", 1)[1]\n                        if len(_ecp_candidate) == 8 and all(\n                            c in \"0123456789abcdef\" for c in _ecp_candidate\n                        ):\n                            _ecp = _ecp_candidate\n                _breadcrumb_event = {\n                    \"action\": \"audit_producer_path_pollution_detected\",\n                    \"ts\": rotated_at,\n                    \"session_id\": \"\",\n                    \"project\": \"\",\n                    \"event_schema\": \"v2\",\n                    \"tokens_in\": None,\n                    \"tokens_out\": None,\n                    \"tokens_total\": None,\n                    \"hmac\": None,\n                    \"hmac_error\": \"producer_path_pollution_detected\",\n                    \"chokepoint\": \"chain_reset_marker\",\n                    \"reason_code\": _rc,\n                    \"path_sha256_prefix\": _psp,\n                    \"expected_canonical_prefix\": _ecp,\n                }\n                _line = json.dumps(_breadcrumb_event, ensure_ascii=False) + \"\\n\"\n                with log.open(\"a\", encoding=\"utf-8\") as _f:\n                    _f.write(_line)\n                    _f.flush()\n            except Exception as _be:  # pragma: no cover\n                _breadcrumb(\n                    f\"chain_reset_marker breadcrumb fast-path write failed: \"\n                    f\"{type(_be).__name__}: {_be}\"\n                )\n            return None\n        marker_event[\"hmac\"] = _audit_hmac.hex_digest(marker_digest)\n\n        # PLAN-112-FOLLOWUP-hmac-tamper-fix Codex R3 P1 fold —\n        # Sidecars-before-marker ordering: write all 3 sidecars FIRST,\n        # then marker line LAST. If sidecar writes fail, marker is NOT\n        # on disk yet → next emit handles via legacy chain-from-genesis\n        # (recoverable). If sidecar succeeds + marker fails: revert\n        # sidecars to pre-marker state (delete manifest + reset chain).\n        # This makes partial-failure states recoverable + fail-closed\n        # rather than silently mischaining line 2.\n\n        # Step 3 (was 4): write rotation manifest sidecar FIRST\n        try:\n            _audit_hmac.write_rotation_manifest(\n                previous_archive_filename=str(Path(previous_archive_path).name),\n                rotated_at=rotated_at,\n            )\n        except _audit_hmac.AuditHmacError as me:\n            _breadcrumb(\n                \"chain_reset_marker manifest write FAIL-CLOSED: {e}\".format(e=me)\n            )\n            return None  # marker not on disk; next emit uses legacy mode\n\n        # Step 4 (was 5): update last-hmac sidecar with marker's HMAC.\n        try:\n            _audit_hmac.write_last_hmac(marker_digest)\n        except _audit_hmac.AuditHmacError as me:\n            # Sidecar update failed; revert manifest write\n            try:\n                _audit_hmac.delete_rotation_manifest()\n            except Exception:\n                pass\n            _breadcrumb(\n                \"chain_reset_marker last_hmac write FAIL-CLOSED: {e}\".format(e=me)\n            )\n            return None\n\n        # Step 5 (was 6): update chain-length to 1 (marker is HMAC-bearing).\n        try:\n            _audit_hmac.write_chain_length(1)\n        except _audit_hmac.AuditHmacError as ce:\n            # Chain-length is detection-canary; non-critical\n            _breadcrumb(\n                \"chain_reset_marker chain_length write failed (non-blocking): \"\n                \"{e}\".format(e=ce)\n            )\n\n        # Step 6 (was 3): NOW append marker as line 1 of (current) new log.\n        # If this fails, sidecars are already in marker-consistent state\n        # but no line on disk — this is also recoverable: next sync emit\n        # will see last-hmac=marker_digest and chain from it; the missing\n        # marker line means verifier (manifest-mode) will tamper-flag\n        # line 1, which is correct: marker IS required if manifest exists.\n        line = json.dumps(marker_event, ensure_ascii=False) + \"\\n\"\n        try:\n            with log.open(\"a\", encoding=\"utf-8\") as f:\n                f.write(line)\n                f.flush()\n                try:\n                    os.fsync(f.fileno())\n                except (OSError, AttributeError):\n                    pass\n        except OSError as we:\n            # Marker line write failed. Sidecars already point at marker\n            # HMAC + manifest exists → verifier will tamper-flag the\n            # marker-missing state on next verify (correct fail-loud\n            # behavior). Caller breadcrumbs.\n            _breadcrumb(\"chain_reset_marker line write FAIL-LOUD: {e}\".format(e=we))\n            return None\n\n        return marker_digest\n    except Exception as e:  # pragma: no cover\n        _breadcrumb(\n            f\"_emit_chain_reset_marker_under_lock failed: {type(e).__name__}: {e}\"\n        )\n        return None\n\n\n# QDSAA-FUNCAO-LONGA: mantém a compatibilidade de dispatch e o lookup dinâmico da fachada.\ndef _write_event(event: Dict[str, Any]) -> None:\n    \"\"\"Write a single JSONL event under the shared lock.\n\n    Fail-open: any exception writes a breadcrumb and returns silently.\n    F-CHAOS-1 (PLAN-019): when the primary audit dir is unwritable, fall\n    back to /tmp/ceo-audit-fallback-<user>.log with once-per-session banner.\n    \"\"\"\n    try:\n        log = _log_path()\n\n        # Enforce mandatory fields\n        if \"action\" not in event or event[\"action\"] not in _KNOWN_ACTIONS:\n            _breadcrumb(f\"unknown action: {event.get('action')!r}\")\n            return\n\n        # Always set event_schema + ts\n        event.setdefault(\"event_schema\", EVENT_SCHEMA_V2)\n        event.setdefault(\"ts\", _utc_now_iso())\n\n        # Reserve nullable cost fields (AI specialist P5)\n        event.setdefault(\"tokens_in\", None)\n        event.setdefault(\"tokens_out\", None)\n        event.setdefault(\"tokens_total\", None)\n\n        # PLAN-023 Phase B (ADR-055) — HMAC chain fields.\n        # Additive; null when chain is disabled or key-read fails.\n        event.setdefault(\"hmac\", None)\n        event.setdefault(\"hmac_error\", None)\n\n        # PLAN-094 Wave A.3 — spool-writer hot path (ADR-055-AMEND-1).\n        # Default path: append to per-PID spool + occasional amortized drain.\n        # Falls back to sync canonical write on kill-switch or any spool error.\n        if (\n            _SPOOL_WRITER_AVAILABLE\n            and _spool_writer is not None\n            and not _spool_writer.is_sync_mode()\n        ):\n            try:\n                _spool_writer.spool_append(event)\n                # PLAN-094-FOLLOWUP Wave A.3-fail-open (option B) — check\n                # durability indicator; fall through to sync canonical\n                # write if spool path silently swallowed an OSError.\n                if _spool_writer.last_append_succeeded():\n                    if _spool_writer.should_drain():\n                        _spool_writer.drain_now()\n                    return  # spool path succeeded\n                _breadcrumb(\n                    \"spool_append silent drop; falling back to sync canonical write\"\n                )\n                # fall through to sync canonical write below\n            except Exception as se:  # pragma: no cover\n                _breadcrumb(f\"spool path fallback to sync: {type(se).__name__}: {se}\")\n                # fall through to sync canonical write below\n\n        # Phase 1: attempt primary write under lock.\n        try:\n            log.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n            with FileLock(str(_lock_path()), timeout=2.5):\n                # PLAN-045 Wave 2 P0-07/08 rotation wire — invoke the\n                # shared rotation primitive BEFORE computing the HMAC.\n                # If rotation happens, reset the chain sidecar so the next\n                # write re-anchors at genesis in the new (empty) file.\n                # Fail-open: any rotation exception is breadcrumbed and\n                # the write proceeds against the over-threshold log.\n                rotated_to = _rotate_if_needed_safe(log)\n                if rotated_to is not None and _HMAC_AVAILABLE:\n                    try:\n                        _audit_hmac.reset_chain_on_rotation()\n                    except Exception as re:  # pragma: no cover\n                        _breadcrumb(\n                            f\"reset_chain_on_rotation failed: {type(re).__name__}: {re}\"\n                        )\n                    # PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — write\n                    # chain_reset_marker as line 1 of new file + rotation\n                    # manifest sidecar, per ADR-055-AMEND-2. Fail-open:\n                    # if marker emit fails, manifest is NOT written, so\n                    # verifier falls back to legacy mode (no marker\n                    # enforcement on this rotation event).\n                    if not _audit_hmac.is_disabled():\n                        try:\n                            _emit_chain_reset_marker_under_lock(\n                                log=log,\n                                previous_archive_path=str(rotated_to),\n                                rotation_trigger=\"size_threshold\",\n                            )\n                        except Exception as me:  # pragma: no cover\n                            _breadcrumb(\n                                f\"chain_reset_marker emit failed (rotation \"\n                                f\"proceeds without marker): \"\n                                f\"{type(me).__name__}: {me}\"\n                            )\n\n                # PLAN-023 Phase B — compute HMAC INSIDE the lock so the\n                # read-modify-write sequence is atomic against concurrent\n                # subprocess writes. Chain-fork defect (security review\n                # §3b) avoided because prev_hmac read + compute + write +\n                # sidecar update all happen under the same FileLock.\n                if _HMAC_AVAILABLE and not _audit_hmac.is_disabled():\n                    try:\n                        key = _audit_hmac.get_or_create_key()\n             