{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018sTZ14fjteNfok4h8mBoRD","type":"tool_result","content":"180\t#   - federation_key_floor_rejected / _stale : ADR-129-AMEND-1 §3/§4\n181\t#     (key-floor enforcement is advisory-staged; no emit producer yet)\n182\t# NOTE: federation_tamper_detected / federation_message_storm_detected /\n183\t# federation_audit_log_backpressure are NOT reserved — they have live\n184\t# `_safe_emit` producers (audit_chain_ext.py / rate_limit.py) and get explicit\n185\t# dispatch-gate branches above.\n186\t_RESERVED_ACTIONS = {\n187\t    \"execution_context_signed\": \"ADR-133\",\n188\t    \"execution_context_validation_failed\": \"ADR-133\",\n189\t    \"federation_autonomous_call_blocked\": \"ADR-135\",\n190\t    \"federation_hmac_secret_rotated\": \"ADR-135-AMEND-1\",\n191\t    \"federation_key_floor_rejected\": \"ADR-129-AMEND-1\",\n192\t    \"federation_key_floor_stale\": \"ADR-129-AMEND-1\",\n193\t}\n194\t\n195\t\n196\t# PLAN-113 Phase B B-STRUCTURAL — emit_generic verbatim-passthrough registry.\n197\t# These `_KNOWN_ACTIONS` members are emitted via emit_generic by TRUSTED\n198\t# in-repo producers (their own typed wrappers in this module, or first-party\n199\t# hook/script producers) with controlled, pre-scrubbed field sets. They have\n200\t# no dedicated dispatch-gate scrub branch and their verbatim pass-through is\n201\t# the ACCEPTED pre-existing contract (each has direct field-presence coverage\n202\t# in test_audit_emit_coverage.py). They are explicitly enumerated here so the\n203\t# default-deny `else` in emit_generic can distinguish them from a genuinely\n204\t# unhandled / future / unexpected producer.\n205\t#\n206\t# INVARIANT (enforced by test_audit_emit_ghost_action_guard.py): every\n207\t# `_KNOWN_ACTIONS` member is EXACTLY ONE of: (a) has an explicit `action ==`\n208\t# dispatch-gate branch, (b) is in `_RESERVED_ACTIONS`, or (c) is in this\n209\t# passthrough set. Any member matching NONE of the three reaches the\n210\t# default-deny `else` (all caller kwargs dropped). A NEW action added to\n211\t# `_KNOWN_ACTIONS` therefore defaults to fail-closed (default-deny) until the\n212\t# author either gives it a scrub branch or consciously lists it here — the\n213\t# leak class cannot silently reopen.\n214\t_EMIT_GENERIC_PASSTHROUGH = frozenset({\n215\t    # admin_key_lifecycle_event MOVED out of passthrough (Codex R5 P1-2,\n216\t    # PLAN-135-FOLLOWUP) → dedicated _ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST scrub\n217\t    # branch in emit_generic: Sec MF-3 deny-by-default + operation/reason\n218\t    # enum-value coercion enforced even against a direct emit_generic caller.\n219\t    \"agent_spawn\",\n220\t    \"audit_flush_dropped_count\",\n221\t    \"audit_spool_duplicate_tuple_rejected\",\n222\t    \"audit_spool_intentionally_deleted\",\n223\t    \"audit_spool_partial_line_discarded\",\n224\t    \"audit_spool_stale_recovered\",\n225\t    \"audit_spool_tamper_detected\",\n226\t    \"audit_spool_unexpected_skip\",\n227\t    \"audit_tokens_emitted\",\n228\t    \"audit_tokens_key_dropped\",\n229\t    \"audit_tokens_timeout\",\n230\t    # bash_canonical_bypass_invoked REMOVED from passthrough (PLAN-113 Codex P1):\n231\t    # routed through explicit _BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST scrub branch\n232\t    # so target_path_hash (12-hex sha256) is the ONLY path representation in the log\n233\t    # (replaces the old target_path_preview raw-path field; Sec MF-3 P1 fix).\n234\t    \"benchmark_run\",\n235\t    \"breaker_closed\",\n236\t    \"breaker_opened\",\n237\t    \"budget_bypass_used\",\n238\t    \"budget_exceeded\",\n239\t    \"canonical_edit_attempted\",\n240\t    \"canonical_edit_blocked\",\n241\t    \"capability_rollout_complete\",\n242\t    \"chain_reset_marker\",\n243\t    \"codex-reply\",\n244\t    \"confidence_gate\",\n245\t    \"confidence_gate_baseline_emitted\",\n246\t    \"credential_rotation_due\",\n247\t    \"debate_event\",\n248\t    \"escalation_baseline_recorded\",\n249\t    \"escalation_detected\",\n250\t    \"escalation_dispatched\",\n251\t    \"escalation_suppressed\",\n252\t    \"estimate_refined\",\n253\t    \"federation_cert_rotated\",\n254\t    \"fluency_nudge\",\n255\t    \"goap_cycle_detected\",\n256\t    \"goap_depth_exceeded\",\n257\t    \"goap_disabled_by_env\",\n258\t    \"goap_edge_explored\",\n259\t    \"goap_recommendation_accepted\",\n260\t    \"goap_recommendation_overridden\",\n261\t    \"goap_recommendation_rendered\",\n262\t    \"goap_replan_exhausted\",\n263\t    \"goap_replan_triggered\",\n264\t    \"goap_search_aborted\",\n265\t    \"goap_search_summary\",\n266\t    \"gpg_signed\",\n267\t    \"gpg_verified\",\n268\t    \"injection_flag\",\n269\t    \"kernel_extension_landed\",\n270\t    \"kill_switch_invoked\",\n271\t    \"lesson_archived\",\n272\t    \"lesson_outcome\",\n273\t    \"lesson_outcome_undone\",\n274\t    \"lesson_read\",\n275\t    \"lesson_restored\",\n276\t    \"lesson_write\",\n277\t    \"live_adapter_call_failed\",\n278\t    \"live_adapter_call_started\",\n279\t    \"live_adapter_call_succeeded\",\n280\t    \"mcp_bearer_friction_observed\",\n281\t    \"mcp_canonical_guard_internal_error\",\n282\t    \"mcp_cross_tenant_denied\",\n283\t    \"mcp_handler_denied\",\n284\t    \"mcp_handler_invoked\",\n285\t    # mcp_injection_finding REMOVED from passthrough (PLAN-113 Codex B3 P1):\n286\t    # it carries MCP-controlled snippet_preview → routed through an explicit\n287\t    # scrub branch with allowlist + _preview() re-truncation instead.\n288\t    \"mcp_server_disabled_by_kill_switch\",\n289\t    \"mcp_server_started\",\n290\t    \"mcp_soak_fpr_breach\",\n291\t    # model_refusal_observed MOVED out of passthrough (Codex R5 P1-2,\n292\t    # PLAN-135-FOLLOWUP) → dedicated _MODEL_REFUSAL_OBSERVED_ALLOWLIST scrub\n293\t    # branch in emit_generic (stop_reason/stop_category/http_status/duration_ms\n294\t    # value-bounded against a direct caller).\n295\t    \"otel_export_dr