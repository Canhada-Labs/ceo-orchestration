\t        if not isinstance(_nm_prev, str) or _nm_prev not in _NIGHT_MODE_MODE_ENUM:\n335\t            event[\"previous_mode\"] = \"other\"\n336\t        _nm_result = event.get(\"result\")\n337\t        if not isinstance(_nm_result, str) or _nm_result not in _NIGHT_MODE_RESULT_ENUM:\n338\t            event[\"result\"] = \"other\"\n339\t        _nm_hh = event.get(\"hostname_hash\")\n340\t        if not (\n341\t            isinstance(_nm_hh, str) and _NIGHT_MODE_HOSTNAME_HASH_RE.fullmatch(_nm_hh)\n342\t        ):\n343\t            event[\"hostname_hash\"] = \"\"\n344\t        event, dropped = _scrub_ceo_boot_event(event, _NIGHT_MODE_TOGGLED_ALLOWLIST)\n345\t        if dropped:\n346\t            _breadcrumb(\n347\t                \"emit_generic night_mode_toggled dropped: %s\" % sorted(dropped)[:10]\n348\t            )\n349\t        state[\"event\"] = event\n350\t        return True\n351\t\n352\t    if action in _EMIT_GENERIC_PASSTHROUGH:\n353\t        pass\n354\t        state[\"event\"] = event\n355\t        return True\n356\t    return False\n357\t\n358\t\n359\t# QDSAA-FUNCAO-LONGA: centraliza a ordem original de scrub/default-deny e mantém\n360\t# todos os handlers ligados ao namespace da fachada para monkeypatch em tempo real.\n361\tdef _dispatch_generic(action, kwargs):\n362\t    if action not in _KNOWN_ACTIONS:\n363\t        _breadcrumb(\"unknown audit action dropped: %s\" % action)\n364\t        return\n365\t    event = {\"action\": action}\n366\t    event.update(kwargs)\n367\t    state = {\"event\": event, \"kwargs\": kwargs}\n368\t    for handler in _GENERIC_DISPATCH_HANDLERS:\n369\t        outcome = handler(action, state)\n370\t        if outcome is None:\n371\t            return\n372\t        if outcome:\n373\t            _write_event(state[\"event\"])\n374\t            return\n375\t    event = {\"action\": action}\n376\t    _breadcrumb(\"emit_generic %s: default-deny dropped caller kwargs\" % action)\n377\t    _write_event(event)\n378\t"}]},"parent_tool_use