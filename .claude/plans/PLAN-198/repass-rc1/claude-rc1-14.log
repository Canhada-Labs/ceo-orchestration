{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fzzi3MuUPgjPtTH6SfRRNB","type":"tool_result","content":"300\t# PLAN-161 W2 C5 — pair-rail liveness telemetry pair (CF-9). Sec MF-3\n301\t# deny-by-default; every branch also re-coerces VALUES by closed-set\n302\t# membership / bounded shape so a direct emit_generic caller can never sign\n303\t# free text into the HMAC chain. NEVER _EMIT_GENERIC_PASSTHROUGH.\n304\t# ---------------------------------------------------------------------------\n305\t\n306\t# Closed outcome enum for the Stop-hook cross-review. The COERCION TARGET for\n307\t# an unrecognized value is \"skipped_failopen\" (never a healthy-class value):\n308\t# unparseable telemetry input must not be able to claim rail health.\n309\t_CODEX_REVIEW_VERDICT_OUTCOME_ENUM = frozenset({\n310\t    \"clean\", \"findings\", \"skipped_failopen\", \"detected_only\",\n311\t})\n312\t\n313\t\n314\t# 64-lowercase-hex sha256 shape gate for diff_sha256; off-shape -> \"\".\n315\t_CODEX_REVIEW_DIFF_SHA256_RE = re.compile(r\"^[0-9a-f]{64}$\")\n316\t\n317\t\n318\t_CODEX_REVIEW_VERDICT_ALLOWLIST = _CODEX_AUDIT_ENVELOPE | frozenset({\n319\t    \"outcome\", \"diff_sha256\",\n320\t})\n321\t\n322\t\n323\t# Mirrors emit_pair_rail_case's write-tool coercion set (+ the \"unknown\"\n324\t# coercion target itself).\n325\t_PAIR_RAIL_REVIEW_EXPECTED_TOOL_ENUM = frozenset({\n326\t    \"Edit\", \"Write\", \"MultiEdit\", \"NotebookEdit\", \"unknown\",\n327\t})\n328\t\n329\t\n330\t# r4 F2 — bounded shape gate for `file_path_hash_prefix` (same 16-hex\n331\t# SHA-256-prefix token `pair_rail_case` carries; raw path forbidden per\n332\t# LLM06). 0..16 lowercase hex; off-shape -> \"\". Kept as the legacy\n333\t# fallback bucket key (+ harmless secondary key) for id-less events.\n334\t_PAIR_RAIL_FILE_HASH_PREFIX_RE = re.compile(r\"^[0-9a-f]{0,16}$\")\n335\t\n336\t\n337\t# r5 F2 — bounded shape gate for `review_id`, the PER-INVOCATION\n338\t# correlation id (os.urandom(8).hex() minted by check_pair_rail.py\n339\t# `_decide()` at review entry; identical on a review's\n340\t# `pair_rail_review_expected` AND its own `pair_rail_case`).\n341\t# r6 F2 tightening: EXACTLY 16 lowercase hex, or exactly \"\" (legacy\n342\t# id-less emit — falls back to the r4 (session, file-hash) bucket-count\n343\t# heuristic in /ceo-boot). Any other value (short/partial, oversize,\n344\t# uppercase, non-hex) is DROPPED to \"\" — never truncated: the r5\n345\t# `{0,16}` + truncate-before-validate let two distinct off-shape ids\n346\t# sharing their first 16 chars ALIAS to one pairing key, so an older\n347\t# terminal could offset a later dead review again (the exact F2\n348\t# false-green this id exists to prevent). The exact-id pairing is what\n349\t# counting could not do: pair a specific expected with its OWN case, so\n350\t# an old completed case for the SAME (session, file) can never offset a\n351\t# later dead expected.\n352\t_PAIR_RAIL_REVIEW_ID_RE = re.compile(r\"^([0-9a-f]{16})?$\")\n353\t\n354\t\n355\t_PAIR_RAIL_REVIEW_EXPECTED_ALLOWLIST = _CODEX_AUDIT_ENVELOPE | frozenset({\n356\t    # ADR-110-AMEND-2 §1.6 — `timeout_ms`: the EFFECTIVE post-clamp codex\n357\t    # budget in INTEGER MILLISECONDS (canonical_json forbids floats in\n358\t    # HMAC-covered fields; a float here is not merely rejected — the spool\n359\t    # writer DROPS the whole event). Carried on BOTH pair-rail liveness"}]},"parent_tool_use_id":null,"session_id":"5ff2ef3b-1be9-4d6b-9faf-7d08cfab8359","uuid":"fc8c44d1-b9b0-49bb-a87d-f7ad150ce1da","timestamp":"2026-11-13T17:16:02.634Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/lifecycle_schemas.py","content":"# PLAN-161 W2 C5 — pair-rail liveness telemetry pair (CF-9). Sec MF-3\n# deny-by-default; every branch also re-coerces VALUES by closed-set\n# membership / bounded shape so a direct emit_generic caller ca