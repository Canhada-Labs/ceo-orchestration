{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GYwWThfY3aBJBmmsnWbfvo","type":"tool_result","content":"1\t\"\"\"Boot schemas.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_CEO_BOOT_EMITTED_ALLOWLIST', '_CEO_BOOT_CHECK_SKIPPED_ALLOWLIST', '_CEO_BOOT_PERSONA_COVERAGE_ALLOWLIST', '_MCP_CANONICAL_GUARD_ALLOWED_ALLOWLIST', '_MCP_CANONICAL_GUARD_BLOCKED_ALLOWLIST', '_TASK_ROUTE_ADVISED_ALLOWLIST', '_REALITY_LEDGER_FINDING_ALLOWLIST', '_TASK_ROUTE_GROUND_TRUTH_LABEL_ALLOWLIST', '_COST_ENVELOPE_CAPPED_ALLOWLIST', '_SWARM_RUNAWAY_SUSPECTED_ALLOWLIST', '_SWARM_PAUSED_OWNER_ABSENT_ALLOWLIST', '_SWARM_LAYER_3_4_BLOCKED_ALLOWLIST', '_EXECUTION_CONTEXT_SIGNED_ALLOWLIST', '_EXECUTION_CONTEXT_VALIDATION_FAILED_ALLOWLIST', '_MODEL_ROUTING_ADVISED_ALLOWLIST', '_OPTIMIZER_ENVELOPE', '_OPTIMIZER_ALLOWLISTS', '_ACCEL_LANG_ENUM', '_VERIFY_CHECKER_ENUM', '_ADEQUACY_REASON_ENUM', '_CODEX_REVIEW_STATUS_ENUM', '_CODEX_REVIEW_SOURCE_ENUM', '_PERSONA_MATCH_MODALITY_ENUM')\n9\t\n10\t# PLAN-065 Phase 2 / ADR-098 — Sec MF-3 field allowlist for /ceo-boot events.\n11\t# Whitelist (deny-by-default). Forbidden fields stripped + breadcrumbed before\n12\t# emit. Caller passes ceo_boot_emitted/_check_skipped via the typed wrappers\n13\t# below; emit_generic dispatch is also gated by the allowlist (defense-in-\n14\t# depth on adopter or future-CEO drift). See PLAN-065 §4.3.4.\n15\t_CEO_BOOT_EMITTED_ALLOWLIST = frozenset({\n16\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n17\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",  # reserved nullable per v2 contract\n18\t    \"hmac\", \"hmac_error\",  # ADR-055 chain fields\n19\t    \"gate_pass\", \"duration_ms\", \"checks_total\", \"checks_failed\", \"cache_hit\",\n20\t})\n21\t\n22\t\n23\t_CEO_BOOT_CHECK_SKIPPED_ALLOWLIST = frozenset({\n24\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n25\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n26\t    \"hmac\", \"hmac_error\",\n27\t    \"check_name\", \"timeout_ms\",\n28\t})\n29\t\n30\t\n31\t_CEO_BOOT_PERSONA_COVERAGE_ALLOWLIST = frozenset({  # PLAN-093 Wave C.5 + PLAN-104 carry-over\n32\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n33\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n34\t    \"hmac\", \"hmac_error\",\n35\t    \"score_x100\", \"cells_covered\", \"total_cells\",\n36\t    # PLAN-104 Wave A.2 — S127 scope-(b) carry-over (3 fields).\n37\t    \"window_hours\", \"events_with_target_archetype\", \"eligible_demand_events\",\n38\t})\n39\t\n40\t\n41\t# PLAN-070 Round 6 / Codex R6-01 closure — Sec MF-3 field allowlist for\n42\t# Layer B MCP middleware events. Tightened to the agreed 6-field contract\n43\t# (Sec ACCEPT-CONDITIONAL R4 + Codex R6-01 P2 ratification, 2026-05-05):\n44\t#\n45\t#   caller-supplied: tool_name, target_path, reason\n46\t#   auto-baseline:   action, ts (==timestamp), session_id, project,\n47\t#                    event_schema, tokens_*, hmac, hmac_error\n48\t#\n49\t# Deny-by-default. NO raw params, NO content/patch body, NO sentinel\n50\t# body, NO error class names, NO reason_code (renamed -> reason), NO\n51\t# file_path (renamed -> target_path). Pre-R6-01 the allowlist included\n52\t# `reason_code`/`file_path`/`sentinel`/`error` as caller fields — Codex\n53\t# R6-01 flagged this as schema drift from the agreed Sec MF-3 contract;\n54\t# the canonical_guard.py emit call sites are simultaneously renamed.\n55\t_MCP_CANONICAL_GUARD_ALLOWED_ALLOWLIST = frozenset({\n56\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n57\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n58\t    \"hmac\", \"hmac_error\",\n59\t    \"tool_name\", \"target_path\", \"reason\",\n60\t})\n61\t\n62\t\n63\t_MCP_CANONICAL_GUARD_BLOCKED_ALLOWLIST = _MCP_CANONICAL_GUARD_ALLOWED_ALLOWLIST\n64\t\n65\t\n66\t# PLAN-071 / ADR-104 — task-route + reality-ledger field allowlists\n67\t# (Sec MF-3 enforcement, deny-by-default). Forbidden fields stripped +\n68\t# breadcrumb action emitted. Token counts, cost, prompt content,\n69\t# SKILL.md content, file paths, recommendation text body, environment\n70\t# values are NEVER persisted to audit-log.\n71\t#\n72\t# S87 ceremony hot-fix (post Codex audit #15): the ceremony script's\n73\t# first injection pass skip-check matched on the dispatch-gate\n74\t# REFERENCE (audit_emit.py:2037+2046) instead of the definition,\n75\t# leaving these frozensets undefined. Codex MCP audit caught the\n76\t# runtime NameError pre-tag; injected directly via Bash python3\n77\t# inline (matches S80 ceremony pattern; arbitration-kernel hook\n78\t# matcher is Edit|Write|MultiEdit only).\n79\t_TASK_ROUTE_ADVISED_ALLOWLIST = frozenset({\n80\t    \"action\", \"ts\", \"session_id\", \"project\",\n81\t    \"contract_id\", \"classification\", \"task_description_hmac\",\n82\t    \"duration_ms\",\n83\t})\n84\t\n85\t\n86\t_REALITY_LEDGER_FINDING_ALLOWLIST = frozenset({\n87\t    \"action\", \"ts\", \"session_id\", \"project\",\n88\t    \"detector\", \"severity\",\n89\t    # confidence_bps: integer basis-points (confidence × 1000, 0..1000).\n90\t    # canonical_json forbids floats; the old \"confidence\" float (0.0-1.0)\n91\t    # caused CanonicalJsonError on every reality_ledger_finding emit.\n92\t    \"confidence_bps\",\n93\t    \"claim_source_sha256\", \"finding_count_in_run\",\n94\t})\n95\t\n96\t\n97\t# PLAN-101 Wave B / ADR-104-AMEND-1 §E — task_route_ground_truth_label.\n98\t# Append-only ground-truth join-key for AEK calibration C3 FPR matrix.\n99\t# Sec MF-3 deny-by-default: only the 8 fields below persist; LLM06\n100\t# hold preserved (raw task descriptions never persisted via this row).\n101\t_TASK_ROUTE_GROUND_TRUTH_LABEL_ALLOWLIST = frozenset({\n102\t    \"action\", \"ts\", \"session_id\", \"project\",\n103\t    \"contract_id\", \"ground_truth_class\", \"ground_truth_source\",\n104\t    \"annotation_confidence_bps\",\n105\t})\n106\t\n107\t\n108\t# PLAN-102 Wave A / ADR-133 §A — cost_envelope_capped.\n109\t# Emitted by check_cost_envelope.py on HARD CAP breach.\n110\t# Sec MF-3 deny-by-default: project_path raw, user_id raw, plan body,\n111\t# command text are NEVER persisted via this row.\n112\t_COST_ENVELOPE_CAPPED_ALLOWLIST = frozenset({\n113\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n114\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n115\t    \"hmac\", \"hmac_error\",\n116\t    \"class_tier\", \"window_breached\", \"cap_cents\", \"current_cents\",\n117\t})\n118\t\n119\t\n120\t# PLAN-102 Wave A / ADR-133 §B — swarm_runaway_suspected.\n121\t# Reverse-tripwire over 24h rolling iteration counter; advisory only.\n122\t_SWARM_RUNAWAY_SUSPECTED_ALLOWLIST = frozenset({\n123\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n124\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n125\t    \"hmac\", \"hmac_error\",\n126\t    \"iteration_count_24h\", \"threshold\", \"triggering_class\",\n127\t})\n128\t\n129\t\n130\t# PLAN-102 Wave A / ADR-133 §C — swarm_paused_owner_absent.\n131\t# Weekend-burn detector. loop_duration_hours bucketed (>=1h) to avoid\n132\t# wallclock side-channel leakage.\n133\t_SWARM_PAUSED_OWNER_ABSENT_ALLOWLIST = frozenset({\n134\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n135\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n136\t    \"hmac\", \"hmac_error\",\n137\t    \"loop_duration_hours\", \"last_owner_read_iso\", \"swarm_pid\",\n138\t})\n139\t\n140\t\n141\t# PLAN-102-FOLLOWUP / ADR-133 §Part 1 §6 — swarm_layer_3_4_blocked.\n142\t# Per-iteration runtime gate event (distinct from swarm_paused_owner_absent\n143\t# which is the weekend-burn detector). LLM06 hold: NO command text, NO\n144\t# sentinel body, NO env values, NO file paths, NO error stack traces.\n145\t_SWARM_LAYER_3_4_BLOCKED_ALLOWLIST = frozenset({\n146\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n147\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n148\t    \"hmac\", \"hmac_error\",\n149\t    \"class_tier\", \"reason_code\", \"loop_id\",\n150\t})\n151\t\n152\t\n153\t# PLAN-102 Wave B / ADR-133 §D — execution_context_signed.\n154\t# Emitted whenever an execution_context HMAC is recorded against an\n155\t# autonomous-loop iteration. NO command text, NO plan body.\n156\t_EXECUTION_CONTEXT_SIGNED_ALLOWLIST = frozenset({\n157\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n158\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n159\t    \"hmac\", \"hmac_error\",\n160\t    \"context_hash\", \"key_id\", \"iteration\",\n161\t})\n162\t\n163\t\n164\t# PLAN-102 Wave B / ADR-133 §D — execution_context_validation_failed.\n165\t# Emitted when execution_context HMAC verification fails (tamper signal).\n166\t# Sec MF-3 deny-by-default: forbid raw context body.\n167\t_EXECUTION_CONTEXT_VALIDATION_FAILED_ALLOWLIST = frozenset({\n168\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n169\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n170\t    \"hmac\", \"hmac_error\",\n171\t    \"context_hash\", \"key_id\", \"iteration\", \"failure_reason\",\n172\t})\n173\t\n174\t\n175\t# PLAN-078 Wave 1 — `model_routing_advised` field allowlist (deny-by-default).\n176\t# 6 caller fields per plan §4 Wave 1 + the auto-baseline (action, ts,\n177\t# session_id, project, event_schema, tokens_*, hmac, hmac_error) added by\n178\t# `_write_event`. NO prompt content, NO description, NO path of agent\n179\t# frontmatter file, NO classify rationale, NO env-var values.\n180\t#\n181\t# Codex W1+W2 fix-pack #2: confidence is integer basis-points (0..1000)\n182\t# instead of float — canonical_json forbids floats, otherwise HMAC chain\n183\t# breaks with `hmac=null` + `hmac_error=CanonicalJsonError` breadcrumb.\n184\t# 0.875 caller → 875 emitted; consumer divides by 1000 to recover ratio.\n185\t_MODEL_ROUTING_ADVISED_ALLOWLIST = frozenset({\n186\t    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n187\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n188\t    \"hmac\", \"hmac_error\",\n189\t    \"archetype\", \"task_type\", \"model_recommended\",\n190\t    \"confidence_basis_points\", \"applied_or_skipped\", \"override_reason\",\n191\t})\n192\t\n193\t\n194\t# PLAN-122 WS12 — Sec MF-3 deny-by-default field allowlists for the optimizer\n195\t# recommender actions. The allowlist gates only CALLER-supplied fields (the\n196\t# scrub runs in emit_generic BEFORE _write_event); _write_event adds the\n197\t# ts/event_schema/tokens_*/hmac/hmac_error envelope by setdefault AFTER the\n198\t# scrub, so those reserved fields are NOT (and must NOT be) allowlisted here —\n199\t# allowlisting tokens_* would let a caller inject a token-count side channel\n200\t# (Codex 019e7ebc P1). The optimizer caller passes only `action` + `session_id`\n201\t# + the per-action fields below. NO prompt body, NO file paths, NO label free\n202\t# text, NO secret/token side-channel.\n203\t_OPTIMIZER_ENVELOPE = (\"action\", \"session_id\")\n204\t\n205\t\n206\t_OPTIMIZER_ALLOWLISTS = {\n207\t    \"optimizer_route_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n208\t        \"route\", \"complexity_bucket\", \"parallelizable\", \"suggested_width\",\n209\t        \"prompt_len_bucket\", \"kill_switch_state\",\n210\t    )),\n211\t    \"fanout_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n212\t        \"subtask_count\", \"suggested_width\", \"width_capped\", \"budget_governed\",\n213\t        \"rate_backoff_applied\", \"models_basis\",\n214\t    )),\n215\t    \"model_choice_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n216\t        \"subtask_index\", \"model_recommended\", \"confidence_basis_points\",\n217\t        \"cost_governed\", \"fell_back_to_static\",\n218\t    )),\n219\t    \"rag_context_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n220\t        \"router_decision\", \"chunks_returned\", \"kill_switch_state\",\n221\t    )),\n222\t    \"codex_review_disabled\": frozenset(_OPTIMIZER_ENVELOPE + (\n223\t        \"reason\",\n224\t    )),\n225\t    # PLAN-122 WS3 — per-phase Codex review event. Caller-supplied fields ONLY\n226\t    # (PhaseReview-shaped, redacted). NO raw Codex text, NO tokens_* side channel,\n227\t    # NO review_disabled_signal bool.\n228\t    \"codex_review_invoked\": frozenset(_OPTIMIZER_ENVELOPE + (\n229\t        \"phase_number\", \"review_status\", \"summary_hash\", \"thread_id_redacted\",\n230\t        \"codex_model\", \"duration_ms\", \"violations_found_count\",\n231\t        \"review_source\", \"target_ref_hash\",  # PLAN-132 / ADR-145 (branch-binding)\n232\t    )),\n233\t}\n234\t\n235\t\n236\t# PLAN-128 §7 (S217) — accelerator catch-emit closed enums + allowlists (Sec MF-3).\n237\t# Invalid enum value is coerced to \"other\" in the dispatch-gate (S172: never echo the\n238\t# rejected value); the breadcrumb lists dropped KEY NAMES only. Counts clamped 0..99.\n239\t_ACCEL_LANG_ENUM = frozenset({\"python\", \"js_ts\", \"go\", \"other\"})\n240\t\n241\t\n242\t_VERIFY_CHECKER_ENUM = frozenset({\"py_compile\", \"ruff\", \"eslint\", \"node_check\", \"go_build\", \"other\"})\n243\t\n244\t\n245\t_ADEQUACY_REASON_ENUM = frozenset({\"no_test_delta\", \"weak_assertion\", \"uncovered_change\", \"other\"})\n246\t\n247\t\n248\t# PLAN-132 / ADR-145 — closed enums for cross-model review provenance + match\n249\t# modality. S172 doctrine: an invalid value coerces to a safe sentinel, never echoed.\n250\t_CODEX_REVIEW_STATUS_ENUM = frozenset({\"invoked\", \"passed\", \"failed\", \"deferred\", \"other\"})\n251\t\n252\t\n253\t_CODEX_REVIEW_SOURCE_ENUM = frozenset({\"phase_gate\", \"user_code_auto\", \"adhoc_mcp\", \"other\"})\n254\t\n255\t\n256\t_PERSONA_MATCH_MODALITY_ENUM = frozenset({\"native_spawn\", \"codex_review\"})\n257\t"}]},"parent_tool_use_id":null,"session_id":"5ff2ef3b-1be9-4d6b-9faf-7d08cfab8359","uuid":"1c8e1b94-a627-4605-acdf-1cf37208c04d","timestamp":"2026-11-13T17:17:41.192Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/boot_schemas.py","content":"\"\"\"Boot schemas.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('_CEO_BOOT_EMITTED_ALLOWLIST', '_CEO_BOOT_CHECK_SKIPPED_ALLOWLIST', '_CEO_BOOT_PERSONA_COVERAGE_ALLOWLIST', '_MCP_CANONICAL_GUARD_ALLOWED_ALLOWLIST', '_MCP_CANONICAL_GUARD_BLOCKED_ALLOWLIST', '_TASK_ROUTE_ADVISED_ALLOWLIST', '_REALITY_LEDGER_FINDING_ALLOWLIST', '_TASK_ROUTE_GROUND_TRUTH_LABEL_ALLOWLIST', '_COST_ENVELOPE_CAPPED_ALLOWLIST', '_SWARM_RUNAWAY_SUSPECTED_ALLOWLIST', '_SWARM_PAUSED_OWNER_ABSENT_ALLOWLIST', '_SWARM_LAYER_3_4_BLOCKED_ALLOWLIST', '_EXECUTION_CONTEXT_SIGNED_ALLOWLIST', '_EXECUTION_CONTEXT_VALIDATION_FAILED_ALLOWLIST', '_MODEL_ROUTING_ADVISED_ALLOWLIST', '_OPTIMIZER_ENVELOPE', '_OPTIMIZER_ALLOWLISTS', '_ACCEL_LANG_ENUM', '_VERIFY_CHECKER_ENUM', '_ADEQUACY_REASON_ENUM', '_CODEX_REVIEW_STATUS_ENUM', '_CODEX_REVIEW_SOURCE_ENUM', '_PERSONA_MATCH_MODALITY_ENUM')\n\n# PLAN-065 Phase 2 / ADR-098 — Sec MF-3 field allowlist for /ceo-boot events.\n# Whitelist (deny-by-default). Forbidden fields stripped + breadcrumbed before\n# emit. Caller passes ceo_boot_emitted/_check_skipped via the typed wrappers\n# below; emit_generic dispatch is also gated by the allowlist (defense-in-\n# depth on adopter or future-CEO drift). See PLAN-065 §4.3.4.\n_CEO_BOOT_EMITTED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",  # reserved nullable per v2 contract\n    \"hmac\", \"hmac_error\",  # ADR-055 chain fields\n    \"gate_pass\", \"duration_ms\", \"checks_total\", \"checks_failed\", \"cache_hit\",\n})\n\n\n_CEO_BOOT_CHECK_SKIPPED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"check_name\", \"timeout_ms\",\n})\n\n\n_CEO_BOOT_PERSONA_COVERAGE_ALLOWLIST = frozenset({  # PLAN-093 Wave C.5 + PLAN-104 carry-over\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"score_x100\", \"cells_covered\", \"total_cells\",\n    # PLAN-104 Wave A.2 — S127 scope-(b) carry-over (3 fields).\n    \"window_hours\", \"events_with_target_archetype\", \"eligible_demand_events\",\n})\n\n\n# PLAN-070 Round 6 / Codex R6-01 closure — Sec MF-3 field allowlist for\n# Layer B MCP middleware events. Tightened to the agreed 6-field contract\n# (Sec ACCEPT-CONDITIONAL R4 + Codex R6-01 P2 ratification, 2026-05-05):\n#\n#   caller-supplied: tool_name, target_path, reason\n#   auto-baseline:   action, ts (==timestamp), session_id, project,\n#                    event_schema, tokens_*, hmac, hmac_error\n#\n# Deny-by-default. NO raw params, NO content/patch body, NO sentinel\n# body, NO error class names, NO reason_code (renamed -> reason), NO\n# file_path (renamed -> target_path). Pre-R6-01 the allowlist included\n# `reason_code`/`file_path`/`sentinel`/`error` as caller fields — Codex\n# R6-01 flagged this as schema drift from the agreed Sec MF-3 contract;\n# the canonical_guard.py emit call sites are simultaneously renamed.\n_MCP_CANONICAL_GUARD_ALLOWED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"tool_name\", \"target_path\", \"reason\",\n})\n\n\n_MCP_CANONICAL_GUARD_BLOCKED_ALLOWLIST = _MCP_CANONICAL_GUARD_ALLOWED_ALLOWLIST\n\n\n# PLAN-071 / ADR-104 — task-route + reality-ledger field allowlists\n# (Sec MF-3 enforcement, deny-by-default). Forbidden fields stripped +\n# breadcrumb action emitted. Token counts, cost, prompt content,\n# SKILL.md content, file paths, recommendation text body, environment\n# values are NEVER persisted to audit-log.\n#\n# S87 ceremony hot-fix (post Codex audit #15): the ceremony script's\n# first injection pass skip-check matched on the dispatch-gate\n# REFERENCE (audit_emit.py:2037+2046) instead of the definition,\n# leaving these frozensets undefined. Codex MCP audit caught the\n# runtime NameError pre-tag; injected directly via Bash python3\n# inline (matches S80 ceremony pattern; arbitration-kernel hook\n# matcher is Edit|Write|MultiEdit only).\n_TASK_ROUTE_ADVISED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\",\n    \"contract_id\", \"classification\", \"task_description_hmac\",\n    \"duration_ms\",\n})\n\n\n_REALITY_LEDGER_FINDING_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\",\n    \"detector\", \"severity\",\n    # confidence_bps: integer basis-points (confidence × 1000, 0..1000).\n    # canonical_json forbids floats; the old \"confidence\" float (0.0-1.0)\n    # caused CanonicalJsonError on every reality_ledger_finding emit.\n    \"confidence_bps\",\n    \"claim_source_sha256\", \"finding_count_in_run\",\n})\n\n\n# PLAN-101 Wave B / ADR-104-AMEND-1 §E — task_route_ground_truth_label.\n# Append-only ground-truth join-key for AEK calibration C3 FPR matrix.\n# Sec MF-3 deny-by-default: only the 8 fields below persist; LLM06\n# hold preserved (raw task descriptions never persisted via this row).\n_TASK_ROUTE_GROUND_TRUTH_LABEL_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\",\n    \"contract_id\", \"ground_truth_class\", \"ground_truth_source\",\n    \"annotation_confidence_bps\",\n})\n\n\n# PLAN-102 Wave A / ADR-133 §A — cost_envelope_capped.\n# Emitted by check_cost_envelope.py on HARD CAP breach.\n# Sec MF-3 deny-by-default: project_path raw, user_id raw, plan body,\n# command text are NEVER persisted via this row.\n_COST_ENVELOPE_CAPPED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"class_tier\", \"window_breached\", \"cap_cents\", \"current_cents\",\n})\n\n\n# PLAN-102 Wave A / ADR-133 §B — swarm_runaway_suspected.\n# Reverse-tripwire over 24h rolling iteration counter; advisory only.\n_SWARM_RUNAWAY_SUSPECTED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"iteration_count_24h\", \"threshold\", \"triggering_class\",\n})\n\n\n# PLAN-102 Wave A / ADR-133 §C — swarm_paused_owner_absent.\n# Weekend-burn detector. loop_duration_hours bucketed (>=1h) to avoid\n# wallclock side-channel leakage.\n_SWARM_PAUSED_OWNER_ABSENT_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"loop_duration_hours\", \"last_owner_read_iso\", \"swarm_pid\",\n})\n\n\n# PLAN-102-FOLLOWUP / ADR-133 §Part 1 §6 — swarm_layer_3_4_blocked.\n# Per-iteration runtime gate event (distinct from swarm_paused_owner_absent\n# which is the weekend-burn detector). LLM06 hold: NO command text, NO\n# sentinel body, NO env values, NO file paths, NO error stack traces.\n_SWARM_LAYER_3_4_BLOCKED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"class_tier\", \"reason_code\", \"loop_id\",\n})\n\n\n# PLAN-102 Wave B / ADR-133 §D — execution_context_signed.\n# Emitted whenever an execution_context HMAC is recorded against an\n# autonomous-loop iteration. NO command text, NO plan body.\n_EXECUTION_CONTEXT_SIGNED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"context_hash\", \"key_id\", \"iteration\",\n})\n\n\n# PLAN-102 Wave B / ADR-133 §D — execution_context_validation_failed.\n# Emitted when execution_context HMAC verification fails (tamper signal).\n# Sec MF-3 deny-by-default: forbid raw context body.\n_EXECUTION_CONTEXT_VALIDATION_FAILED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"context_hash\", \"key_id\", \"iteration\", \"failure_reason\",\n})\n\n\n# PLAN-078 Wave 1 — `model_routing_advised` field allowlist (deny-by-default).\n# 6 caller fields per plan §4 Wave 1 + the auto-baseline (action, ts,\n# session_id, project, event_schema, tokens_*, hmac, hmac_error) added by\n# `_write_event`. NO prompt content, NO description, NO path of agent\n# frontmatter file, NO classify rationale, NO env-var values.\n#\n# Codex W1+W2 fix-pack #2: confidence is integer basis-points (0..1000)\n# instead of float — canonical_json forbids floats, otherwise HMAC chain\n# breaks with `hmac=null` + `hmac_error=CanonicalJsonError` breadcrumb.\n# 0.875 caller → 875 emitted; consumer divides by 1000 to recover ratio.\n_MODEL_ROUTING_ADVISED_ALLOWLIST = frozenset({\n    \"action\", \"ts\", \"session_id\", \"project\", \"event_schema\",\n    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n    \"hmac\", \"hmac_error\",\n    \"archetype\", \"task_type\", \"model_recommended\",\n    \"confidence_basis_points\", \"applied_or_skipped\", \"override_reason\",\n})\n\n\n# PLAN-122 WS12 — Sec MF-3 deny-by-default field allowlists for the optimizer\n# recommender actions. The allowlist gates only CALLER-supplied fields (the\n# scrub runs in emit_generic BEFORE _write_event); _write_event adds the\n# ts/event_schema/tokens_*/hmac/hmac_error envelope by setdefault AFTER the\n# scrub, so those reserved fields are NOT (and must NOT be) allowlisted here —\n# allowlisting tokens_* would let a caller inject a token-count side channel\n# (Codex 019e7ebc P1). The optimizer caller passes only `action` + `session_id`\n# + the per-action fields below. NO prompt body, NO file paths, NO label free\n# text, NO secret/token side-channel.\n_OPTIMIZER_ENVELOPE = (\"action\", \"session_id\")\n\n\n_OPTIMIZER_ALLOWLISTS = {\n    \"optimizer_route_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n        \"route\", \"complexity_bucket\", \"parallelizable\", \"suggested_width\",\n        \"prompt_len_bucket\", \"kill_switch_state\",\n    )),\n    \"fanout_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n        \"subtask_count\", \"suggested_width\", \"width_capped\", \"budget_governed\",\n        \"rate_backoff_applied\", \"models_basis\",\n    )),\n    \"model_choice_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n        \"subtask_index\", \"model_recommended\", \"confidence_basis_points\",\n        \"cost_governed\", \"fell_back_to_static\",\n    )),\n    \"rag_context_recommended\": frozenset(_OPTIMIZER_ENVELOPE + (\n        \"router_decision\", \"chunks_returned\", \"kill_switch_state\",\n    )),\n    \"codex_review_disabled\": frozenset(_OPTIMIZER_ENVELOPE + (\n        \"reason\",\n    )),\n    # PLAN-122 WS3 — per-phase Codex review event. Caller-supplied fields ONLY\n    # (PhaseReview-shaped, redacted). NO raw Codex text, NO tokens_* side channel,\n    # NO review_disabled_signal bool.\n    \"codex_review_invoked\": frozenset(_OPTIMIZER_ENVELOPE + (\n        \"phase_number\", \"review_status\", \"summary_hash\", \"thread_id_redacted\",\n        \"codex_model\", \"duration_ms\", \"violations_found_count\",\n        \"review_source\", \"target_ref_hash\",  # PLAN-132 / ADR-145 (branch-binding)\n    )),\n}\n\n\n# PLAN-128 §7 (S217) — accelerator catch-emit closed enums + allowlists (Sec MF-3).\n# Invalid enum value is coerced to \"other\" in the dispatch-gate (S172: never echo the\n# rejected value); the breadcrumb lists dropped KEY NAMES only. Counts clamped 0..99.\n_ACCEL_LANG_ENUM = frozenset({\"python\", \"js_ts\", \"go\", \"other\"})\n\n\n_VERIFY_CHECKER_ENUM = frozenset({\"py_compile\", \"ruff\", \"eslint\", \"node_check\", \"go_build\", \"other\"})\n\n\n_ADEQUACY_REASON_ENUM = frozenset({\"no_test_delta\", \"weak_assertion\", \"uncovered_change\", \"other\"})\n\n\n# PLAN-132 / ADR-145 — closed enums for cross-model review provenance + match\n# modality. S172 doctrine: an invalid value coerces to a safe sentinel, never echoed.\n_CODEX_REVIEW_STATUS_ENUM = frozenset({\"invoked\", \"passed\", \"failed\", \"deferred\", \"other\"})\n\n\n_CODEX_REVIEW_SOURCE_ENUM = frozenset({\"phase_gate\", \"user_code_auto\", \"adhoc_mcp\", \"other\"})\n\n\n_PERSONA_MATCH_MODALITY_ENUM = frozenset({\"native_spawn\", \"codex_review\"})\n","numLines":257,"startLine":1,"totalLines":257}},"tool_result_meta":[{"id":"toolu_01GYwWThfY3aBJBmmsnWbfvo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1JmqeUf6js6jKMy9Bga","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01W7XAMG7jTQm9JJQ3hdW76G","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/optimizer.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":613,"cache_read_input_tokens":208418,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":613},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"5ff2ef3b-1be9-4d6b-9faf-7d08cfab8359","uuid":"942a78ae-bce8-4cf2-8c8e-a8e980677d19","timestamp":"2026-11-13T17:17:42.605Z","request_id":"req_011Ch1JmqQ6AUVdAC2xkY5KD","wire_tool_inputs":{"toolu_01W7XAMG7jTQm9JJQ3hdW76G":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_emit_parts/optimizer.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W7XAMG7jTQm9JJQ3hdW76G","type":"tool_result","content":"1\t\"\"\"Optimizer.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\tfrom .boot_schemas import _OPTIMIZER_ENVELOPE\n8\t\n9\t__all__ = ('_VERIFY_AFTER_EDIT_FINDING_ALLOWLIST', '_ADEQUACY_GATE_FLAG_ALLOWLIST', '_QUOTA_ERROR_CLASS_ENUM', '_QUOTA_ERROR_SOURCE_ENUM', '_QUOTA_EXHAUSTED_ALLOWLIST', '_AUTO_COMPACT_REASON_ENUM', '_AUTO_COMPACT_SUPPRESS_REASON_ENUM', '_CONTEXT_AUTO_COMPACTED_ALLOWLIST', '_CONTEXT_AUTO_COMPACT_SUPPRESSED_ALLOWLIST', '_MIDDLE_OUT_REASON_ENUM', '_CONTEXT_MIDDLE_OUT_DEGRADED_ALLOWLIST', '_CONTEXT_MIDDLE_OUT_DEGRADE_FAILED_ALLOWLIST', '_SUPPLY_CHAIN_VERDICT_ENUM', '_SUPPLY_CHAIN_REASON_ENUM', '_SUPPLY_CHAIN_ECOSYSTEM_ENUM', '_SUPPLY_CHAIN_ADVISORY_EMITTED_ALLOWLIST', '_SPAWN_RAIL_ENUM', '_SPAWN_TOOL_SCOPE_VIOLATION_ALLOWLIST', '_SPAWN_DEPTH_OR_OVERLAP_ALLOWLIST', '_SPAWN_FILE_ASSIGNMENT_RECORDED_ALLOWLIST', '_ACTION_REQUIRED_KIND_ENUM', '_ACTION_REQUIRED_REJECT_ENUM', '_ACTION_REQUIRED_HELD_ALLOWLIST', '_ACTION_REQUIRED_RESUMED_ALLOWLIST', '_ACTION_REQUIRED_REJECTED_ALLOWLIST', '_MODEL_ROUTING_ENFORCED_ALLOWLIST', '_MODEL_ROUTING_EVAL_ERROR_ALLOWLIST')\n10\t\n11\t_VERIFY_AFTER_EDIT_FINDING_ALLOWLIST = frozenset(_OPTIMIZER_ENVELOPE + (\n12\t    \"checker\", \"lang\", \"finding_count\",\n13\t))\n14\t\n15\t\n16\t_ADEQUACY_GATE_FLAG_ALLOWLIST = frozenset(_OPTIMIZER_ENVELOPE + (\n17\t    \"flag_reason\", \"lang\", \"flag_count\",\n18\t))\n19\t\n20\t\n21\t# PLAN-133 B5 — provider/cost error taxonomy mirror closed enums + allowlist (Sec MF-3).\n22\t# error_class is coerced to a closed-enum member in the dispatch-gate (S172: an\n23\t# invalid value is replaced by \"unknown\", NEVER echoed). source is a closed enum\n24\t# distinguishing the metered-API path from the subscription main loop. NO\n25\t# retry_delay / Retry-After / body / header value is ever allowlisted — the\n26\t# backoff seconds are a caller-side float that must never reach the payload.\n27\t_QUOTA_ERROR_CLASS_ENUM = frozenset({\n28\t    \"quota_exhausted\", \"credits_exhausted\", \"auth\", \"rate_limited\", \"overloaded\",\n29\t    \"server_error\", \"bad_request\", \"timeout\", \"network\", \"unknown\",\n30\t})\n31\t\n32\t\n33\t_QUOTA_ERROR_SOURCE_ENUM = frozenset({\"subscription_main_loop\", \"metered_api\", \"subprocess\", \"unknown\"})\n34\t\n35\t\n36\t_QUOTA_EXHAUSTED_ALLOWLIST = frozenset(_OPTIMIZER_ENVELOPE + (\n37\t    # closed-enum scalars + bounded ints ONLY\n38\t    \"error_class\",        # closed enum (coerced)\n39\t    \"source\",             # closed enum (coerced)\n40\t    \"http_status\",        # int (the bare status code; no body)\n41\t    \"retryable\",          # bool\n42\t    \"metered_api_only\",   # bool\n43\t    \"attempt\",            # int 0..99 (clamped) — which retry attempt\n44\t    \"project\",\n45\t))\n46\t\n47\t\n48\t# PLAN-133 D1 — proactive auto-compaction telemetry. Closed enums so a malformed\n49\t# value coerces to a safe sentinel (S172 doctrine: never echo a rejected value).\n50\t# `reason` mirrors REASON_* in scripts/context-budget.py. `trigger` distinguishes\n51\t# the high/low-water hysteresis edge. NO bytes/tokens raw text — only bucketed\n52\t# percentages (0..100 clamp) so a transcript size can never be reconstructed\n53\t# field-by-field into a side channel.\n54\t_AUTO_COMPACT_REASON_ENUM = frozenset({\n55\t    \"compact\", \"cooldown\", \"reclaim_floor\", \"not_rearmed\",\n56\t    \"below_high_water\", \"disabled\", \"other\",\n57\t})\n58\t\n59\t\n60\t_AUTO_COMPACT_SUPPRESS_REASON_ENUM = frozenset({\n61\t    \"cooldown\", \"reclaim_floor\", \"other\",\n62\t})\n63\t\n64\t\n65\t# context_auto_compacted — a compaction WAS performed. Carries only the closed\n66\t# reason enum + the hysteresis percentages + the reclaimed-percent bucket + a\n67\t# turn counter. `reason` IS in the allowlist (the dispatch gate coerces it).\n68\t_CONTEXT_AUTO_COMPACTED_ALLOWLIST = frozenset(_OPTIMIZER_ENVELOPE + (\n69\t    \"reason\", \"usage_pct\", \"reclaim_pct\", \"turns_since_last\",\n70\t))\n71\t\n72\t\n73\t# context_auto_compact_suppressed — a would-be compaction was SKIPPED by a gate\n74\t# (cooldown or reclaim-floor). Carries the closed suppression reason + the same\n75\t# bucketed percentages.\n76\t_CONTEXT_AUTO_COMPACT_SUPPRESSED_ALLOWLIST = frozenset(_OPTIMIZER_ENVELOPE + (\n77\t    \"suppress_reason\", \"usage_pct\", \"reclaim_pct\", \"turns_since_last\",\n78\t))\n79\t\n80\t\n81\t# PLAN-133 D5 — middle-out degradation telemetry for the context-overflow path.\n82\t# Closed enums so a malformed value coerces to a safe sentinel (S172 doctrine:\n83\t# never echo a rejected value). `reason` mirrors MO_REASON_* in\n84\t# scripts/context-budget.py. Only bucketed COUNTS + a small ladder-rung int are\n85\t# carried (0..99 clamp) — NOT the message text, tool/agent identity, file paths,\n86\t# or raw token totals — so a transcript can never be reconstructed field-by-\n87\t# field into a side channel.\n88\t_MIDDLE_OUT_REASON_ENUM = frozenset({\n89\t    \"degraded\", \"failed\", \"no_overflow\", \"disabled\", \"other\",\n90\t})\n91\t\n92\t\n93\t# context_middle_out_degraded — a degradation pass DID elide >=1 message's\n94\t# middle to fit the budget. Carries only the closed reason enum + bucketed\n95\t# counts (degraded / total messages + protect_last) + the ladder `rung` int\n96\t# (0..99 clamp) + a coarse reclaim-tokens BUCKET + the `fits_after` bool.\n97\t# `reason` IS in the allowlist (the dispatch gate coerces it).\n98\t_CONTEXT_MIDDLE_OUT_DEGRADED_ALLOWLIST = frozenset(_OPTIMIZER_ENVELOPE + (\n99\t    \"reason\", \"rung\", \"degraded_count\", \"total_count\", \"protect_last\",\n100\t    \"reclaim_bucket\", \"fits_after\",\n101\t))\n102\t\n103\t\n104\t# context_middle_out_degrade_failed — the ladder was exhausted (or no message\n105\t# was eligible) and the context STIL