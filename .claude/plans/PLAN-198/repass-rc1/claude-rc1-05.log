{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MCpP6pnzze3T4N8yRK42sB","type":"tool_result","content":"1\t\"\"\"Fact-gate state, storage, and enforcement declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _apply_destructive_citation_gate(\n5\t    decision: \"Decision\", command: str, transcript_path: str\n6\t) -> \"Decision\":\n7\t    \"\"\"Apply the ADR-175 citation gate to a DESTRUCTIVE block decision.\n8\t\n9\t    Called from main() ONLY when the gate is enabled AND\n10\t    ``decision.destructive`` is True. Outcomes:\n11\t\n12\t      * citation absent    → BLOCK (original reason + how-to-cite hint)\n13\t      * citation malformed → BLOCK (actionable shape error)\n14\t      * verify failure     → BLOCK (fail-CLOSED; actionable reason)\n15\t      * verified           → ALLOW + `destructive_citation_accepted`\n16\t                             recorded into the HMAC chain (emit fail-open)\n17\t\n18\t    This function performs bounded file I/O — it lives on the main() side,\n19\t    NOT in decide_command (which stays pure).\n20\t    \"\"\"\n21\t    status, source_or_detail, cited = _extract_destructive_citation(command)\n22\t    if status == \"absent\":\n23\t        return Decision(\n24\t            allow=False,\n25\t            reason=(decision.reason or \"\") + (\n26\t                \"\\nCITATION GATE (ADR-175): destructive Bash additionally \"\n27\t                \"requires a verbatim citation of the instruction that \"\n28\t                \"justifies it. Re-run as: \"\n29\t                \"CEO_DESTRUCTIVE_CITE='transcript:<verbatim instruction \"\n30\t                \"text>' <command>  (or 'PLAN-NNN:<verbatim plan text>'). \"\n31\t                \"The cited text (>= %d chars) must appear VERBATIM in the \"\n32\t                \"cited source or the op stays blocked.\" % _CITE_MIN_CHARS\n33\t            ),\n34\t            destructive=True,\n35\t        )\n36\t    if status == \"malformed\":\n37\t        _emit_destructive_citation_rejected(\"malformed: \" + source_or_detail)\n38\t        return Decision(\n39\t            allow=False,\n40\t            reason=(\n41\t                \"BLOCKED (citation gate, fail-CLOSED): the \"\n42\t                \"CEO_DESTRUCTIVE_CITE citation is malformed — %s. Expected \"\n43\t                \"CEO_DESTRUCTIVE_CITE='<source>:<verbatim text>' with \"\n44\t                \"source 'transcript' or 'PLAN-NNN'. The destructive op \"\n45\t                \"stays blocked.\" % source_or_detail\n46\t            ),\n47\t            destructive=True,\n48\t        )\n49\t    ok, detail, source_class = _verify_destructive_citation(\n50\t        source_or_detail, cited, transcript_path\n51\t    )\n52\t    if not ok:\n53\t        _emit_destructive_citation_rejected(detail)\n54\t        return Decision(\n55\t            allow=False,\n56\t            reason=(\n57\t                \"BLOCKED (citation gate, fail-CLOSED): destructive Bash \"\n58\t                \"citation could not be verified — %s. Content the gate \"\n59\t                \"cannot verify is blocked, not waved through (mirror of \"\n60\t                \"the Wave E.3 parse gate). Fix the citation so the quoted \"\n61\t                \"text appears VERBATIM in the cited source, or drop the \"\n62\t                \"destructive command.\" % detail\n63\t            ),\n64\t            destructive=True,\n65\t        )\n66\t    _emit_destructive_citation_accepted(source_class, source_or_detail, cited)\n67\t    return Decision(allow=True)\n68\t# <<< PLAN-153.E5 / ADR-175 citation-gate END\n69\t\n70\t\n71\t# >>> PLAN-154.F6 / ADR-160 fact-gate BEGIN (deny-once ADVISORY->ENFORCE)\n72\t# -----------------------------------------------------------------------------\n73\t# PLAN-154 item 6 / ADR-160 — fact-forcing DENY-ONCE gate on the Wave-E\n74\t# citation gate (ADVISORY -> ENFORCE path)\n75\t# -----------------------------------------------------------------------------\n76\t#\n77\t# The Wave-E citation gate above (ADR-175) is a per-command allow path.\n78\t# PLAN-154 item 6 layers the FACT-FORCING ritual on top of it:\n79\t#\n80\t#   * ENFORCE mode: a DESTRUCTIVE command (Decision.destructive == True) is\n81\t#     denied ONCE per session per exact command. The deny-once state binds to\n82\t#     ``sha256(normalized command)`` (normalization strips ONLY the\n83\t#     ``CEO_DESTRUCTIVE_CITE`` assignment, so the cited retry hashes equal to\n84\t#     the original attempt). A RETRY releases ONLY on an exact-hash match AND\n85\t#     a verified citation (``_verify_destructive_citation`` — the fail-CLOSED\n86\t#     ADR-175 verifier: transcript-only source, bounded tail read, every\n87\t#     exception => BLOCK). A first attempt NEVER releases, even with a valid\n88\t#     citation — release is defined only for retries of a previously-denied\n89\t#     exact hash (the temporal fact-forcing property). While ENFORCE is\n90\t#     active the ADR-175 pilot gate is SKIPPED (deny-once is the strict\n91\t#     superset; the pilot's first-attempt allow path must not undercut it).\n92\t#   * SHADOW mode (the default — \"default ADVISORY\" per PLAN-154 A8): the\n93\t#     decision is returned UNTOUCHED (byte-identical legacy behavior,\n94\t#     including the ADR-175 pilot if armed). The gate only (a) records the\n95\t#     deny-once state it WOULD have used, (b) emits the shadow telemetry the\n96\t#     ADR-160 numeric flip criteria are measured from (FP < 2% over >= 50\n97\t#     gate-candidate events + >= 14 calendar days + zero integrity flags —\n98\t#     the criteria live in ADR-160; this code emits the events, it never\n99\t#     evaluates the criteria), and (c) prints ONE human-facing stderr\n100\t#     advisory line, routed through ``_lib.advisory_dampen`` (PLAN-154\n101\t#     item 5 — the single wired dampening consumer; block reasons are\n102\t#     EXEMPT and never routed there).\n103\t#\n104\t# FLIP GOVERNANCE (A8): the ADVISORY->ENFORCE flip is SETTINGS-BACKED —\n105\t# ``env.CEO_FACT_GATE_ENFORCE == \"1\"`` in the layered settings files\n106\t# (user < project < local < managed, read via `_lib.effective_config`'s\n107\t# layer readers — the house settings-read pattern). The ENV VAR of the same\n108\t# name is an EMERGENCY OFF only (``CEO_FACT_GATE_ENFORCE=0`` in the\n109\t# trusted_env snapshot forces advisory; the env var can NEVER enable).\n110\t# ``CEO_SOTA_DISABLE=1`` is the master kill (gate fully off, zero\n111\t# filesystem delta). Every observed activation CHANGE emits the\n112\t# ``fact_gate_activation_changed`` HMAC governance event (detection is\n113\t# lazy — hooks are per-invocation processes, so the last observed state is\n114\t# persisted in the session state file and compared on the next\n115\t# already-matched destructive command).\n116\t#\n117\t# FAIL POSTURE (PLAN-152 C4): release-side citation verification is\n118\t# fail-CLOSED (inherited from `_verify_destructive_citation`); state-file\n119\t# unavailability degrades toward MORE blocking in ENFORCE (no readable\n120\t# prior record => no release), and toward byte-identical legacy behavior\n121\t# in SHADOW; an INFRASTRUCTURE exception anywhere in the gate returns the\n122\t# incoming decision unchanged (which on this path is already a BLOCK).\n123\t# Fail-open is permitted ONLY on the audit-emit side.\n124\t#\n125\t# PROFILE GUARD: every function below is reachable ONLY from the\n126\t# already-matched destructive-block path in main() (`not decision.allow and\n127\t# decision.destructive`) — never the common path. Citation verification\n128\t# I/O additionally runs only when a well-formed citation AND a prior\n129\t# deny record both exist. No new top-level imports (os/time/effective_config/\n130\t# advisory_dampen/filelock are all lazy).\n131\t#\n132\t# STATE: per-session 0600 JSON file (tool_lifecycle.py pattern) at\n133\t# ``<audit_dir>/fact-gate/<sanitized session_id>.json`` — expires with the\n134\t# session (never consulted across sessions), atomic replace, best-effort\n135\t# lock, bounded record count.\n136\t\n137\t_FACT_GATE_ENFORCE_VAR = \"CEO_FACT_GATE_ENFORCE\"\n138\t_FACT_GATE_SHADOW_VAR = \"CEO_FACT_GATE_SHADOW\"\n139\t_FACT_GATE_MASTER_KILL_VAR = \"CEO_SOTA_DISABLE\"\n140\t_FACT_GATE_STATE_SUBDIR = \"fact-gate\"\n141\t_FACT_GATE_MAX_RECORDS = 64        # per-session deny-once hash bound\n142\t_FACT_GATE_LOCK_TIMEOUT_S = 0.2    # MaybeLock budget (tool_lifecycle value)\n143\t\n144\t\n145\tdef _fact_gate_shadow_enabled() -> bool:\n146\t    \"\"\"SHADOW telemetry switch — default ON (shadow IS the gate's advisory\n147\t    default per PLAN-154 A8; the flip criteria need dogfood telemetry).\n148\t    ``CEO_FACT_GATE_SHADOW=0`` is the emergency off; ``CEO_SOTA_DISABLE=1``\n149\t    is the master kill. Read from the import-time trusted_env snapshot.\n150\t    Snapshot unavailability => ON (shadow never blocks; `_rawscan_enabled`\n151\t    precedent). Never raises.\"\"\"\n152\t    if _trusted_env is None:  # pragma: no cover — import failure → stay on\n153\t        return True\n154\t    try:\n155\t        if str(_trusted_env.get_trusted(_FACT_GATE_MASTER_KILL_VAR) or \"\").strip() == \"1\":\n156\t            return False\n157\t        raw = _trusted_env.get_trusted(_FACT_GATE_SHADOW_VAR)\n158\t    except Exception:  # pragma: no cover\n159\t        return True\n160\t    return (str(raw).strip() != \"0\") if raw is not None else True\n161\t\n162\t\n163\tdef _fact_gate_settings_value() -> \"Optional[str]\":\n164\t    \"\"\"Read ``env.CEO_FACT_GATE_ENFORCE`` from the layered settings files\n165\t    via `_lib.effective_config`'s layer readers (`_layer_paths` +\n166\t    `_read_json_layer` — the resolver never raises per layer). Last-defined\n167\t    layer wins in LAYER_MERGE_ORDER (user, project, local, managed), i.e.\n168\t    managed carries the highest precedence. Returns the raw string value or\n169\t    None. INFRASTRUCTURE failure (import/paths) => None => the gate stays\n170\t    in its default-advisory state — a settings-read failure can never flip\n171\t    a new deny surface ON. Never raises.\"\"\"\n172\t    try:\n173\t        from _lib import effective_config as _effective_config\n174\t        import os as _os\n175\t        project_dir = Path(\n176\t            _os.environ.get(\"CLAUDE_PROJECT_DIR\") or _os.getcwd()\n177\t        )\n178\t        value = None  # type: Optional[str]\n179\t        for _name, _path in _effective_config._layer_paths(project_dir):\n180\t            layer = _effective_config._read_json_layer(_name, _path)\n181\t            data = layer.get(\"data\") if isinstance(layer, dict) else None\n182\t            env_block = data.get(\"env\") if isinstance(data, dict) else None\n183\t            if isinstance(env_block, dict) and _FACT_GATE_ENFORCE_VAR in env_block:\n184\t                value = str(env_block[_FACT_GATE_ENFORCE_VAR])\n185\t        return value\n186\t    except Exception:\n187\t        return None\n188\t\n189\t\n190\tdef _fact_gate_enforce_state() -> \"tuple\":\n191\t    \"\"\"Resolve the effective ENFORCE state. Returns ``(enabled, source)``\n192\t    with source a closed enum:\n193\t\n194\t      * ``sota_master_off``   — CEO_SOTA_DISABLE=1 (master kill)\n195\t      * ``env_emergency_off`` — env CEO_FACT_GATE_ENFORCE=0 overrides an\n196\t                                otherwise-armed settings flip\n197\t      * ``settings``          — settings-backed ``env.CEO_FACT_GATE_ENFORCE\n198\t                                == \"1\"`` (the ONLY enable channel)\n199\t      * ``default_advisory``  — nothing armed (shadow)\n200\t\n201\t    The env var can never ENABLE (settings-backed flip, A8). trusted_env\n202\t    unavailability => default advisory (a new deny surface must not arm on\n203\t    a degraded trust anchor). Never raises.\"\"\"\n204\t    if _trusted_env is None:  # pragma: no cover — degraded anchor → advisory\n205\t        return (False, \"default_advisory\")\n206\t    try:\n207\t        if str(_trusted_env.get_trusted(_FACT_GATE_MASTER_KILL_VAR) or \"\").strip() == \"1\":\n208\t            return (False, \"sota_master_off\")\n209\t        env_raw = _trusted_env.get_trusted(_FACT_GATE_ENFORCE_VAR)\n210\t        if env_raw is not None and str(env_raw).strip() == \"0\":\n211\t            return (False, \"env_emergency_off\")\n212\t    except Exception:  # pragma: no cover\n213\t        return (False, \"default_advisory\")\n214\t    if _fact_gate_settings_value() == \"1\":\n215\t        return (True, \"settings\")\n216\t    return (False, \"default_advisory\")\n217\t\n218\t\n219\tdef _fact_gate_normalize(command: str) -> \"Optional[str]\":\n220\t    \"\"\"Normalize ``command`` for deny-once hashing."}]},"parent_tool_use_id":null,"session_id":"bd5ebd56-59b6-4268-812f-e9994cacc38a","uuid":"4678d9f9-5d41-4da4-b7b4-e732f29a2641","timestamp":"2026-11-15T09:29:50.193Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_bash_safety_parts/fact_state.py","content":"\"\"\"Fact-gate state, storage, and enforcement declarations.\"\"\"\nfrom __future__ import annotations\n\ndef _apply_destructive_citation_gate(\n    decision: \"Decision\", command: str, transcript_path: str\n) -> \"Decision\":\n    \"\"\"Apply the ADR-175 citation gate to a DESTRUCTIVE block decision.\n\n    Called from main() ONLY when the gate is enabled AND\n    ``decision.destructive`` is True. Outcomes:\n\n      * citation absent    → BLOCK (original reason + how-to-cite hint)\n      * citation malformed → BLOCK (actionable shape error)\n      * verify failure     → BLOCK (fail-CLOSED; actionable reason)\n      * verified           → ALLOW + `destructive_citation_accepted`\n                             recorded into the HMAC chain (emit fail-open)\n\n    This function performs bounded file I/O — it lives on the main() side,\n    NOT in decide_command (which stays pure).\n    \"\"\"\n    status, source_or_detail, cited = _extract_destructive_citation(command)\n    if status == \"absent\":\n        return Decision(\n            allow=False,\n            reason=(decision.reason or \"\") + (\n                \"\\nCITATION GATE (ADR-175): destructive Bash additionally \"\n                \"requires a verbatim citation of the instruction that \"\n                \"justifies it. Re-run as: \"\n                \"CEO_DESTRUCTIVE_CITE='transcript:<verbatim instruction \"\n                \"text>' <command>  (or 'PLAN-NNN:<verbatim plan text>'). \"\n                \"The cited text (>= %d chars) must appear VERBATIM in the \"\n                \"cited source or the op stays blocked.\" % _CITE_MIN_CHARS\n            ),\n            destructive=True,\n        )\n    if status == \"malformed\":\n        _emit_destructive_citation_rejected(\"malformed: \" + source_or_detail)\n        return Decision(\n            allow=False,\n            reason=(\n                \"BLOCKED (citation gate, fail-CLOSED): the \"\n                \"CEO_DESTRUCTIVE_CITE citation is malformed — %s. Expected \"\n                \"CEO_DESTRUCTIVE_CITE='<source>:<verbatim text>' with \"\n                \"source 'transcript' or 'PLAN-NNN'. The destructive op \"\n                \"stays blocked.\" % source_or_detail\n            ),\n            destructive=True,\n        )\n    ok, detail, source_class = _verify_destructive_citation(\n        source_or_detail, cited, transcript_path\n    )\n    if not ok:\n        _emit_destructive_citation_rejected(detail)\n        return Decision(\n            allow=False,\n            reason=(\n                \"BLOCKED (citation gate, fail-CLOSED): destructive Bash \"\n                \"citation could not be verified — %s. Content the gate \"\n                \"cannot verify is blocked, not waved through (mirror of \"\n                \"the Wave E.3 parse gate). Fix the citation so the quoted \"\n                \"text appears VERBATIM in the cited source, or drop the \"\n                \"destructive command.\" % detail\n            ),\n            destructive=True,\n        )\n    _emit_destructive_citation_accepted(source_class, source_or_detail, cited)\n    return Decision(allow=True)\n# <<< PLAN-153.E5 / ADR-175 citation-gate END\n\n\n# >>> PLAN-154.F6 / ADR-160 fact-gate BEGIN (deny-once ADVISORY->ENFORCE)\n# -----------------------------------------------------------------------------\n# PLAN-154 item 6 / ADR-160 — fact-forcing DENY-ONCE gate on the Wave-E\n# citation gate (ADVISORY -> ENFORCE path)\n# -----------------------------------------------------------------------------\n#\n# The Wave-E citation gate above (ADR-175) is a per-command allow path.\n# PLAN-154 item 6 layers the FACT-FORCING ritual on top of it:\n#\n#   * ENFORCE mode: a DESTRUCTIVE command (Decision.destructive == True) is\n#     denied ONCE per session per exact command. The deny-once state binds to\n#     ``sha256(normalized command)`` (normalization strips ONLY the\n#     ``CEO_DESTRUCTIVE_CITE`` assignment, so the cited retry hashes equal to\n#     the original attempt). A RETRY releases ONLY on an exact-hash match AND\n#     a verified citation (``_verify_destructive_citation`` — the fail-CLOSED\n#     ADR-175 verifier: transcript-only source, bounded tail read, every\n#     exception => BLOCK). A first attempt NEVER releases, even with a valid\n#     citation — release is defined only for retries of a previously-denied\n#     exact hash (the temporal fact-forcing property). While ENFORCE is\n#     active the ADR-175 pilot gate is SKIPPED (deny-once is the strict\n#     superset; the pilot's first-attempt allow path must not undercut it).\n#   * SHADOW mode (the default — \"default ADVISORY\" per PLAN-154 A8): the\n#     decision is returned UNTOUCHED (byte-identical legacy behavior,\n#     including the ADR-175 pilot if armed). The gate only (a) records the\n#     deny-once state it WOULD have used, (b) emits the shadow telemetry the\n#     ADR-160 numeric flip criteria are measured from (FP < 2% over >= 50\n#     gate-candidate events + >= 14 calendar days + zero integrity flags —\n#     the criteria live in ADR-160; this code emits the events, it never\n#     evaluates the criteria), and (c) prints ONE human-facing stderr\n#     advisory line, routed through ``_lib.advisory_dampen`` (PLAN-154\n#     item 5 — the single wired dampening consumer; block reasons are\n#     EXEMPT and never routed there).\n#\n# FLIP GOVERNANCE (A8): the ADVISORY->ENFORCE flip is SETTINGS-BACKED —\n# ``env.CEO_FACT_GATE_ENFORCE == \"1\"`` in the layered settings files\n# (user < project < local < managed, read via `_lib.effective_config`'s\n# layer readers — the house settings-read pattern). The ENV VAR of the same\n# name is an EMERGENCY OFF only (``CEO_FACT_GATE_ENFORCE=0`` in the\n# trusted_env snapshot forces advisory; the env var can NEVER enable).\n# ``CEO_SOTA_DISABLE=1`` is the master kill (gate fully off, zero\n# filesystem delta). Every observed activation CHANGE emits the\n# ``fact_gate_activation_changed`` HMAC governance event (detection is\n# lazy — hooks are per-invocation processes, so the last observed state is\n# persisted in the session state file and compared on the next\n# already-matched destructive command).\n#\n# FAIL POSTURE (PLAN-152 C4): release-side citation verification is\n# fail-CLOSED (inherited from `_verify_destructive_citation`); state-file\n# unavailability degrades toward MORE blocking in ENFORCE (no readable\n# prior record => no release), and toward byte-identical legacy behavior\n# in SHADOW; an INFRASTRUCTURE exception anywhere in the gate returns the\n# incoming decision unchanged (which on this path is already a BLOCK).\n# Fail-open is permitted ONLY on the audit-emit side.\n#\n# PROFILE GUARD: every function below is reachable ONLY from the\n# already-matched destructive-block path in main() (`not decision.allow and\n# decision.destructive`) — never the common path. Citation verification\n# I/O additionally runs only when a well-formed citation AND a prior\n# deny record both exist. No new top-level imports (os/time/effective_config/\n# advisory_dampen/filelock are all lazy).\n#\n# STATE: per-session 0600 JSON file (tool_lifecycle.py pattern) at\n# ``<audit_dir>/fact-gate/<sanitized session_id>.json`` — expires with the\n# session (never consulted across sessions), atomic replace, best-effort\n# lock, bounded record count.\n\n_FACT_GATE_ENFORCE_VAR = \"CEO_FACT_GATE_ENFORCE\"\n_FACT_GATE_SHADOW_VAR = \"CEO_FACT_GATE_SHADOW\"\n_FACT_GATE_MASTER_KILL_VAR = \"CEO_SOTA_DISABLE\"\n_FACT_GATE_STATE_SUBDIR = \"fact-gate\"\n_FACT_GATE_MAX_RECORDS = 64        # per-session deny-once hash bound\n_FACT_GATE_LOCK_TIMEOUT_S = 0.2    # MaybeLock budget (tool_lifecycle value)\n\n\ndef _fact_gate_shadow_enabled() -> bool:\n    \"\"\"SHADOW telemetry switch — default ON (shadow IS the gate's advisory\n    default per PLAN-154 A8; the flip criteria need dogfood telemetry).\n    ``CEO_FACT_GATE_SHADOW=0`` is the emergency off; ``CEO_SOTA_DISABLE=1``\n    is the master kill. Read from the import-time trusted_env snapshot.\n    Snapshot unavailability => ON (shadow never blocks; `_rawscan_enabled`\n    precedent). Never raises.\"\"\"\n    if _trusted_env is None:  # pragma: no cover — import failure → stay on\n        return True\n    try:\n        if str(_trusted_env.get_trusted(_FACT_GATE_MASTER_KILL_VAR) or \"\").strip() == \"1\":\n            return False\n        raw = _trusted_env.get_trusted(_FACT_GATE_SHADOW_VAR)\n    except Exception:  # pragma: no cover\n        return True\n    return (str(raw).strip() != \"0\") if raw is not None else True\n\n\ndef _fact_gate_settings_value() -> \"Optional[str]\":\n    \"\"\"Read ``env.CEO_FACT_GATE_ENFORCE`` from the layered settings files\n    via `_lib.effective_config`'s layer readers (`_layer_paths` +\n    `_read_json_layer` — the resolver never raises per layer). Last-defined\n    layer wins in LAYER_MERGE_ORDER (user, project, local, managed), i.e.\n    managed carries the highest precedence. Returns the raw string value or\n    None. INFRASTRUCTURE failure (import/paths) => None => the gate stays\n    in its default-advisory state — a settings-read failure can never flip\n    a new deny surface ON. Never raises.\"\"\"\n    try:\n        from _lib import effective_config as _effective_config\n        import os as _os\n        project_dir = Path(\n            _os.environ.get(\"CLAUDE_PROJECT_DIR\") or _os.getcwd()\n        )\n        value = None  # type: Optional[str]\n        for _name, _path in _effective_config._layer_paths(project_dir):\n            layer = _effective_config._read_json_layer(_name, _path)\n            data = layer.get(\"data\") if isinstance(layer, dict) else None\n            env_block = data.get(\"env\") if isinstance(data, dict) else None\n            if isinstance(env_block, dict) and _FACT_GATE_ENFORCE_VAR in env_block:\n                value = str(env_block[_FACT_GATE_ENFORCE_VAR])\n        return value\n    except Exception:\n        return None\n\n\ndef _fact_gate_enforce_state() -> \"tuple\":\n    \"\"\"Resolve the effective ENFORCE state. Returns ``(enabled, source)``\n    with source a closed enum:\n\n      * ``sota_master_off``   — CEO_SOTA_DISABLE=1 (master kill)\n      * ``env_emergency_off`` — env CEO_FACT_GATE_ENFORCE=0 overrides an\n                                otherwise-armed settings flip\n      * ``settings``          — settings-backed ``env.CEO_FACT_GATE_ENFORCE\n                                == \"1\"`` (the ONLY enable channel)\n      * ``default_advisory``  — nothing armed (shadow)\n\n    The env var can never ENABLE (settings-backed flip, A8). trusted_env\n    unavailability => default advisory (a new deny surface must not arm on\n    a degraded trust anchor). Never raises.\"\"\"\n    if _trusted_env is None:  # pragma: no cover — degraded anchor → advisory\n        return (False, \"default_advisory\")\n    try:\n        if str(_trusted_env.get_trusted(_FACT_GATE_MASTER_KILL_VAR) or \"\").strip() == \"1\":\n            return (False, \"sota_master_off\")\n        env_raw = _trusted_env.get_trusted(_FACT_GATE_ENFORCE_VAR)\n        if env_raw is not None and str(env_raw).strip() == \"0\":\n            return (False, \"env_emergency_off\")\n    except Exception:  # pragma: no cover\n        return (False, \"default_advisory\")\n    if _fact_gate_settings_value() == \"1\":\n        return (True, \"settings\")\n    return (False, \"default_advisory\")\n\n\ndef _fact_gate_normalize(command: str) -> \"Optional[str]\":\n    \"\"\"Normalize ``command`` for deny-once hashing.","numLines":220,"startLine":1,"totalLines":560}},"tool_result_meta":[{"id":"toolu_01MCpP6pnzze3T4N8yRK42sB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
