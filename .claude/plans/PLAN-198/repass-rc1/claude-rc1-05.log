{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KWkK1vZuMqD8PZHKXBkJFh","type":"tool_result","content":"1\t\"\"\"Decision conversion, audit emitters, and hook entry point.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef _emit_env_var_hijack_event(hijack_class: str) -> None:\n5\t    \"\"\"Emit env_var_hijack_blocked(hijack_class). Fail-open (PLAN-133 A1).\n6\t\n7\t    The ONLY caller-supplied field is the closed-enum `hijack_class` — NEVER the\n8\t    variable NAME and NEVER the assigned VALUE (the value is the payload surface,\n9\t    MF analogous to git_hook_bypass MF-G). session_id / project are read from the\n10\t    live env (forensic envelope only; not a grant source). Emitted on BOTH an\n11\t    enforced block AND an advisory (default-OFF) detection.\n12\t    \"\"\"\n13\t    if _audit_emit is None:\n14\t        return\n15\t    try:\n16\t        import os as _os\n17\t        _audit_emit.emit_env_var_hijack_blocked(\n18\t            hijack_class=hijack_class,\n19\t            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n20\t            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n21\t        )\n22\t    except Exception:  # pragma: no cover\n23\t        pass\n24\t\n25\t\n26\tdef _emit_egress_destination_event(egress_class: str, destination: str) -> None:\n27\t    \"\"\"Emit egress_destination_detected(egress_class, destination). Fail-open.\n28\t\n29\t    `destination` is ALREADY host-only (egress_taxonomy reduces it); the audit\n30\t    emitter re-truncates defensively. The full URL / path / query / inline\n31\t    credential is NEVER passed here. When egress_class == 'pair_rail' the caller\n32\t    ALSO emits pair_rail_outgoing_redaction_applied (positive proof the outbound\n33\t    redactor ran on the sanctioned channel). session_id / project are forensic\n34\t    envelope only (not a grant source).\n35\t    \"\"\"\n36\t    if _audit_emit is None:\n37\t        return\n38\t    try:\n39\t        import os as _os\n40\t        _sid = _os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n41\t        _proj = _os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\")\n42\t        _audit_emit.emit_egress_destination_detected(\n43\t            egress_class=egress_class,\n44\t            destination=destination,\n45\t            session_id=_sid,\n46\t            project=_proj,\n47\t        )\n48\t        if egress_class == \"pair_rail\":\n49\t            _audit_emit.emit_pair_rail_outgoing_redaction_applied(\n50\t                signal=\"egress_taxonomy\",\n51\t                family=\"pair_rail\",\n52\t                match_count=0,\n53\t                bytes_scanned=0,\n54\t                callsite=\"check_bash_safety.egress\",\n55\t                session_id=_sid,\n56\t                project=_proj,\n57\t            )\n58\t    except Exception:  # pragma: no cover\n59\t        pass\n60\t\n61\t\n62\tdef _emit_credential_leak_event(provider: str, redacted: str) -> None:\n63\t    \"\"\"Emit veto_triggered(credential_leak). Fail-open.\"\"\"\n64\t    if _audit_emit is None:\n65\t        return\n66\t    try:\n67\t        _audit_emit.emit_veto_triggered(\n68\t            hook=\"check_bash_safety\", reason_code=\"credential_leak\",\n69\t            reason_preview=f\"bash_credential_leak_blocked provider={provider} match={redacted}\",\n70\t            blocked_tool=\"Bash\")\n71\t    except Exception:  # pragma: no cover\n72\t        pass\n73\t\n74\t\n75\tdef _emit_bash_input_rewritten_event(rewrite: \"Rewrite\") -> None:\n76\t    \"\"\"Emit bash_input_rewritten with the before/after hash PAIR. Fail-open.\n77\t\n78\t    PLAN-135 W2 H5 (mini-ADR-154 §2). The ONLY caller-supplied fields are\n79\t    the closed-enum `rewrite_class` and the two 64-hex sha256 hashes — the\n80\t    command BYTES (before OR after) are NEVER persisted (a force-push line\n81\t    can carry a remote URL with an inline token). The hash pair lets an\n82\t    auditor prove the audited command equals the executed command without\n83\t    seeing either command. session_id / project are forensic envelope only.\n84\t    \"\"\"\n85\t    if _audit_emit is None:\n86\t        return\n87\t    try:\n88\t        import os as _os\n89\t        _audit_emit.emit_bash_input_rewritten(\n90\t            rewrite_class=rewrite.rewrite_class,\n91\t            before_sha256=rewrite.before_sha256,\n92\t            after_sha256=rewrite.after_sha256,\n93\t            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n94\t            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n95\t        )\n96\t    except Exception:  # pragma: no cover\n97\t        pass\n98\t\n99\t\n100\tdef _adapter_emit(adapter, decision, event=None) -> None:\n101\t    \"\"\"Emit a neutral ``Decision`` through the resolved host adapter\n102\t    (PLAN-155 Wave 1 dispatch seam, debate A1).\n103\t\n104\t    Claude path: the historical two-arg call — byte-identical output\n105\t    (``claude.py:emit_decision`` does not take ``event=``). Any other\n106\t    resolved adapter (codex host mode, ``_FailClosedAdapter``) receives\n107\t    the parsed NormalizedEvent so the egress shape follows the wire that\n108\t    produced it (host shape is EXPLICIT-only) and the debate-A2\n109\t    coherence override can fire.\n110\t    \"\"\"\n111\t    adapter_basename = (getattr(adapter, \"__name__\", \"\") or \"\").rsplit(\".\", 1)[-1]\n112\t    if adapter_basename == \"claude\":\n113\t        adapter.emit_decision(decision)\n114\t        return\n115\t    adapter.emit_decision(decision, event=event)\n116\t\n117\t\n118\tdef main() -> int:\n119\t    \"\"\"Hook entry point: read stdin via Adapter Layer, decide, write stdout, exit 0.\n120\t\n121\t    PLAN-006 Phase 1 migration (ADR-014). Uses `claude_adapter.read_event()`\n122\t    / `emit_decision()` instead of direct `_lib.payload` + `print()`.\n123\t    Output is byte-identical to pre-migration (test_hook_byte_fidelity).\n124\t\n125\t    PLAN-155 Wave 1 (debate A1, ratified seam option b): the adapter is\n126\t    resolved ONCE per invocation via the shared seam\n127\t    ``_lib.adapters.resolve()`` — BEFORE the fail-open try block, so the\n128\t    debate-A2 coherence gate inside ``resolve()``\n129\t    (explicitly-set-but-unresolvable ``CEO_HOOK_ADAPTER`` → INPUT class\n130\t    per PLAN-152 C4 → fail-CLOSED: ``resolve()`` returns a\n131\t    ``_FailClosedAdapter`` whose egress ALWAYS denies in BOTH harness\n132\t    vocabularies, with a stderr + audit breadcrumb — never a silent\n133\t    fallback to the claude adapter) is never swallowed into an allow.\n134\t    Under ``CEO_HOOK_ADAPTER`` unset/\"claude\" the seam returns the claude\n135\t    adapter module and downstream behavior is byte-identical.\n136\t    \"\"\"\n137\t    _adapter = _adapters.resolve()\n138\t    event = None\n139\t    try:\n140\t        # >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (stdin buffering)\n141\t        # Read stdin ONCE into a buffer, then hand the adapter an equivalent\n142\t        # stream. The adapter's NormalizedEvent deliberately drops the raw\n143\t        # payload (deny-by-default), but the citation gate needs the\n144\t        # top-level `transcript_path` field — parsed here from the SAME\n145\t        # bytes the adapter consumes, so the verified path is exactly what\n146\t        # the harness sent. Behavior-neutral for every other code path.\n147\t        import io as _io\n148\t        try:\n149\t            _raw_stdin_text = sys.stdin.read()\n150\t        except Exception:  # exotic stdin failure → same fail-open as before\n151\t            _raw_stdin_text = \"\"\n152\t        event = _adapter.read_event(\n153\t            stream=_io.StringIO(_raw_stdin_text), phase=\"PreToolUse\"\n154\t        )\n155\t        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n156\t        if event.parse_error:\n157\t            print(\n158\t                f\"[check_bash_safety] WARN: stdin parse error: {event.parse_error}\",\n159\t                file=sys.stderr,\n160\t            )\n161\t            _adapter_emit(_adapter, _contract.allow(), event)\n162\t            return 0\n163\t\n164\t        command = event.command or \"\"\n165\t        if not command and isinstance(event.tool_input, dict):\n166\t            command = str(event.tool_input.get(\"command\") or \"\")\n167\t\n168\t        try:\n169\t            from _lib import bash_indirect_telemetry as _indirect_telemetry\n170\t            for _switch in (\"CEO_BASH_INDIRECT_GUARD\", \"CEO_BASH_INDIRECT_HEURISTICS\"):\n171\t                if _trusted_env.get_trusted(_switch) == \"0\":\n172\t                    _indirect_telemetry.disabled_once(_switch, event.session_id)\n173\t        except Exception:  # audit infrastructure must not change the verdict\n174\t            pass\n175\t\n176\t        decision = decide_command(command)\n177\t        # PLAN-154 fact gate precedes the PLAN-153 citation pilot for\n178\t        # destructive-class blocks. Both see the final decision.\n179\t        if not decision.allow and decision.destructive:\n180\t            _fact_transcript_path = _extract_transcript_path(_raw_stdin_text)\n181\t            decision, _fact_enforce_active = _apply_fact_gate(\n182\t                decision, command, _fact_transcript_path\n183\t            )\n184\t            if (\n185\t                not decision.allow\n186\t                and decision.destructive\n187\t                and not _fact_enforce_active\n188\t                and _destructive_citation_gate_enabled()\n189\t            ):\n190\t                decision = _apply_destructive_citation_gate(\n191\t                    decision, command, _fact_transcript_path\n192\t                )\n193\t        # <<< PLAN-154.F6 fact-gate END\n194\t        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n195\t        if not decision.allow and decision.reason_code and _audit_emit is not None:\n196\t            try:\n197\t                _audit_emit.emit_veto_triggered(\n198\t                    hook=\"check_bash_safety\", reason_code=decision.reason_code,\n199\t                    reason_preview=decision.reason[:200], blocked_tool=\"Bash\",\n200\t                )\n201\t            except Exception:  # audit infrastructure must remain fail-open\n202\t                pass\n203\t        # Re-run detector on credential blocks to emit audit event.\n204\t        if not decision.allow and decision.reason and \"API credential\" in decision.reason:\n205\t            hit = _check_credential_leak(command)\n206\t            if hit is not None:\n207\t                _emit_credential_leak_event(hit[0], hit[1])\n208\t        # PLAN-124 WS-1 — emit git_hook_bypass_blocked on a block OR an\n209\t        # authorized escape-hatch use. Re-scan to recover the closed-enum\n210\t        # flag_class (decide_command stays pure / I/O-free). The credential\n211\t        # block above takes precedence, so skip if the reason was a credential.\n212\t        if not (decision.reason and \"API credential\" in decision.reason):\n213\t            git_hit = _check_git_bypass(command)\n214\t            if git_hit is not None:\n215\t                _kind, _flag_class, _reason = git_hit\n216\t                # block → emit the matched flag_class; escape → escape_hatch_used.\n217\t                _emit_git_hook_bypass_event(_flag_class)\n218\t        # PLAN-133 A1 — emit env_var_hijack_blocked on ANY detected env-hijack\n219\t        # SET (enforced block OR advisory default-OFF detection). Re-scan to\n220\t        # recover the closed-enum hijack_class (decide_command stays pure). Only\n221\t        # the closed-enum class is persisted — never the var name/value.\n222\t        if not (decision.reason and \"API credential\" in decision.reason):\n223\t            env_hit = _check_env_hijack(command)\n224\t            if env_hit is not None:\n225\t                _hijack_class, _key, _reason = env_hit\n226\t                _emit_env_var_hijack_event(_hijack_class)\n227\t        # PLAN-133 A3 — emit egress destinations on block or allow.\n228\t        if _egress_emit_enabled():\n229\t            for _eclass, _edest in _classify_egress(command):\n230\t                _emit_egress_destination_event(_eclass, _edest)\n231\t        # PLAN-135 W2 H5 — when decide_command chose the corrective rewrite,\n232\t        # emit the bash_input_rewritten audit event with the before/after\n233\t        # hash PAIR BEFORE emitting the `ask` decision (mini-ADR-154 §2: the\n234\t        # audit records that the rail rewrote the input, so the downstream\n235\t        # audited command provably equals the executed/asked command). The\n236\t        # emit is fail-open (it never gates the decision).\n237\t        if decision.rewrite is not None:\n238\t            _emit_bash_input_rewritten_event(decision.rewrite)\n239\t        _adapter_emit(\n240\t            _adapter, _to_contract_decision(decision, event.tool_input), event\n241\t        )\n242\t        return 0\n243\t    except Exception as e:  # pragma: no cover\n244\t        print(\n245\t            f\"[check_bash_safety] FATAL: {e.__class__.__name__}: {e}\",\n246\t            file=sys.stderr,\n247\t        )\n248\t        _adapter_emit(_adapter, _contract.allow(), event)\n249\t        return 0\n250\t\n251\t\n252\tif __name__ == \"__main__\":\n253\t    sys.exit(main())\n254\t"}]},"parent_tool_use_id":null,"session_id":"00ec2b1d-64bd-4aca-88dc-c9646f7b6927","uuid":"c89cec36-a850-464c-892e-31318d477bbe","timestamp":"2026-11-13T16:39:52.291Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_bash_safety_parts/decisions_cli.py","content":"\"\"\"Decision conversion, audit emitters, and hook entry point.\"\"\"\nfrom __future__ import annotations\n\ndef _emit_env_var_hijack_event(hijack_class: str) -> None:\n    \"\"\"Emit env_var_hijack_blocked(hijack_class). Fail-open (PLAN-133 A1).\n\n    The ONLY caller-supplied field is the closed-enum `hijack_class` — NEVER the\n    variable NAME and NEVER the assigned VALUE (the value is the payload surface,\n    MF analogous to git_hook_bypass MF-G). session_id / project are read from the\n    live env (forensic envelope only; not a grant source). Emitted on BOTH an\n    enforced block AND an advisory (default-OFF) detection.\n    \"\"\"\n    if _audit_emit is None:\n        return\n    try:\n        import os as _os\n        _audit_emit.emit_env_var_hijack_blocked(\n            hijack_class=hijack_class,\n            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _emit_egress_destination_event(egress_class: str, destination: str) -> None:\n    \"\"\"Emit egress_destination_detected(egress_class, destination). Fail-open.\n\n    `destination` is ALREADY host-only (egress_taxonomy reduces it); the audit\n    emitter re-truncates defensively. The full URL / path / query / inline\n    credential is NEVER passed here. When egress_class == 'pair_rail' the caller\n    ALSO emits pair_rail_outgoing_redaction_applied (positive proof the outbound\n    redactor ran on the sanctioned channel). session_id / project are forensic\n    envelope only (not a grant source).\n    \"\"\"\n    if _audit_emit is None:\n        return\n    try:\n        import os as _os\n        _sid = _os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n        _proj = _os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\")\n        _audit_emit.emit_egress_destination_detected(\n            egress_class=egress_class,\n            destination=destination,\n            session_id=_sid,\n            project=_proj,\n        )\n        if egress_class == \"pair_rail\":\n            _audit_emit.emit_pair_rail_outgoing_redaction_applied(\n                signal=\"egress_taxonomy\",\n                family=\"pair_rail\",\n                match_count=0,\n                bytes_scanned=0,\n                callsite=\"check_bash_safety.egress\",\n                session_id=_sid,\n                project=_proj,\n            )\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _emit_credential_leak_event(provider: str, redacted: str) -> None:\n    \"\"\"Emit veto_triggered(credential_leak). Fail-open.\"\"\"\n    if _audit_emit is None:\n        return\n    try:\n        _audit_emit.emit_veto_triggered(\n            hook=\"check_bash_safety\", reason_code=\"credential_leak\",\n            reason_preview=f\"bash_credential_leak_blocked provider={provider} match={redacted}\",\n            blocked_tool=\"Bash\")\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _emit_bash_input_rewritten_event(rewrite: \"Rewrite\") -> None:\n    \"\"\"Emit bash_input_rewritten with the before/after hash PAIR. Fail-open.\n\n    PLAN-135 W2 H5 (mini-ADR-154 §2). The ONLY caller-supplied fields are\n    the closed-enum `rewrite_class` and the two 64-hex sha256 hashes — the\n    command BYTES (before OR after) are NEVER persisted (a force-push line\n    can carry a remote URL with an inline token). The hash pair lets an\n    auditor prove the audited command equals the executed command without\n    seeing either command. session_id / project are forensic envelope only.\n    \"\"\"\n    if _audit_emit is None:\n        return\n    try:\n        import os as _os\n        _audit_emit.emit_bash_input_rewritten(\n            rewrite_class=rewrite.rewrite_class,\n            before_sha256=rewrite.before_sha256,\n            after_sha256=rewrite.after_sha256,\n            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _adapter_emit(adapter, decision, event=None) -> None:\n    \"\"\"Emit a neutral ``Decision`` through the resolved host adapter\n    (PLAN-155 Wave 1 dispatch seam, debate A1).\n\n    Claude path: the historical two-arg call — byte-identical output\n    (``claude.py:emit_decision`` does not take ``event=``). Any other\n    resolved adapter (codex host mode, ``_FailClosedAdapter``) receives\n    the parsed NormalizedEvent so the egress shape follows the wire that\n    produced it (host shape is EXPLICIT-only) and the debate-A2\n    coherence override can fire.\n    \"\"\"\n    adapter_basename = (getattr(adapter, \"__name__\", \"\") or \"\").rsplit(\".\", 1)[-1]\n    if adapter_basename == \"claude\":\n        adapter.emit_decision(decision)\n        return\n    adapter.emit_decision(decision, event=event)\n\n\ndef main() -> int:\n    \"\"\"Hook entry point: read stdin via Adapter Layer, decide, write stdout, exit 0.\n\n    PLAN-006 Phase 1 migration (ADR-014). Uses `claude_adapter.read_event()`\n    / `emit_decision()` instead of direct `_lib.payload` + `print()`.\n    Output is byte-identical to pre-migration (test_hook_byte_fidelity).\n\n    PLAN-155 Wave 1 (debate A1, ratified seam option b): the adapter is\n    resolved ONCE per invocation via the shared seam\n    ``_lib.adapters.resolve()`` — BEFORE the fail-open try block, so the\n    debate-A2 coherence gate inside ``resolve()``\n    (explicitly-set-but-unresolvable ``CEO_HOOK_ADAPTER`` → INPUT class\n    per PLAN-152 C4 → fail-CLOSED: ``resolve()`` returns a\n    ``_FailClosedAdapter`` whose egress ALWAYS denies in BOTH harness\n    vocabularies, with a stderr + audit breadcrumb — never a silent\n    fallback to the claude adapter) is never swallowed into an allow.\n    Under ``CEO_HOOK_ADAPTER`` unset/\"claude\" the seam returns the claude\n    adapter module and downstream behavior is byte-identical.\n    \"\"\"\n    _adapter = _adapters.resolve()\n    event = None\n    try:\n        # >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (stdin buffering)\n        # Read stdin ONCE into a buffer, then hand the adapter an equivalent\n        # stream. The adapter's NormalizedEvent deliberately drops the raw\n        # payload (deny-by-default), but the citation gate needs the\n        # top-level `transcript_path` field — parsed here from the SAME\n        # bytes the adapter consumes, so the verified path is exactly what\n        # the harness sent. Behavior-neutral for every other code path.\n        import io as _io\n        try:\n            _raw_stdin_text = sys.stdin.read()\n        except Exception:  # exotic stdin failure → same fail-open as before\n            _raw_stdin_text = \"\"\n        event = _adapter.read_event(\n            stream=_io.StringIO(_raw_stdin_text), phase=\"PreToolUse\"\n        )\n        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n        if event.parse_error:\n            print(\n                f\"[check_bash_safety] WARN: stdin parse error: {event.parse_error}\",\n                file=sys.stderr,\n            )\n            _adapter_emit(_adapter, _contract.allow(), event)\n            return 0\n\n        command = event.command or \"\"\n        if not command and isinstance(event.tool_input, dict):\n            command = str(event.tool_input.get(\"command\") or \"\")\n\n        try:\n            from _lib import bash_indirect_telemetry as _indirect_telemetry\n            for _switch in (\"CEO_BASH_INDIRECT_GUARD\", \"CEO_BASH_INDIRECT_HEURISTICS\"):\n                if _trusted_env.get_trusted(_switch) == \"0\":\n                    _indirect_telemetry.disabled_once(_switch, event.session_id)\n        except Exception:  # audit infrastructure must not change the verdict\n            pass\n\n        decision = decide_command(command)\n        # PLAN-154 fact gate precedes the PLAN-153 citation pilot for\n        # destructive-class blocks. Both see the final decision.\n        if not decision.allow and decision.destructive:\n            _fact_transcript_path = _extract_transcript_path(_raw_stdin_text)\n            decision, _fact_enforce_active = _apply_fact_gate(\n                decision, command, _fact_transcript_path\n            )\n            if (\n                not decision.allow\n                and decision.destructive\n                and not _fact_enforce_active\n                and _destructive_citation_gate_enabled()\n            ):\n                decision = _apply_destructive_citation_gate(\n                    decision, command, _fact_transcript_path\n                )\n        # <<< PLAN-154.F6 fact-gate END\n        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n        if not decision.allow and decision.reason_code and _audit_emit is not None:\n            try:\n                _audit_emit.emit_veto_triggered(\n                    hook=\"check_bash_safety\", reason_code=decision.reason_code,\n                    reason_preview=decision.reason[:200], blocked_tool=\"Bash\",\n                )\n            except Exception:  # audit infrastructure must remain fail-open\n                pass\n        # Re-run detector on credential blocks to emit audit event.\n        if not decision.allow and decision.reason and \"API credential\" in decision.reason:\n            hit = _check_credential_leak(command)\n            if hit is not None:\n                _emit_credential_leak_event(hit[0], hit[1])\n        # PLAN-124 WS-1 — emit git_hook_bypass_blocked on a block OR an\n        # authorized escape-hatch use. Re-scan to recover the closed-enum\n        # flag_class (decide_command stays pure / I/O-free). The credential\n        # block above takes precedence, so skip if the reason was a credential.\n        if not (decision.reason and \"API credential\" in decision.reason):\n            git_hit = _check_git_bypass(command)\n            if git_hit is not None:\n                _kind, _flag_class, _reason = git_hit\n                # block → emit the matched flag_class; escape → escape_hatch_used.\n                _emit_git_hook_bypass_event(_flag_class)\n        # PLAN-133 A1 — emit env_var_hijack_blocked on ANY detected env-hijack\n        # SET (enforced block OR advisory default-OFF detection). Re-scan to\n        # recover the closed-enum hijack_class (decide_command stays pure). Only\n        # the closed-enum class is persisted — never the var name/value.\n        if not (decision.reason and \"API credential\" in decision.reason):\n            env_hit = _check_env_hijack(command)\n            if env_hit is not None:\n                _hijack_class, _key, _reason = env_hit\n                _emit_env_var_hijack_event(_hijack_class)\n        # PLAN-133 A3 — emit egress destinations on block or allow.\n        if _egress_emit_enabled():\n            for _eclass, _edest in _classify_egress(command):\n                _emit_egress_destination_event(_eclass, _edest)\n        # PLAN-135 W2 H5 — when decide_command chose the corrective rewrite,\n        # emit the bash_input_rewritten audit event with the before/after\n        # hash PAIR BEFORE emitting the `ask` decision (mini-ADR-154 §2: the\n        # audit records that the rail rewrote the input, so the downstream\n        # audited command provably equals the executed/asked command). The\n        # emit is fail-open (it never gates the decision).\n        if decision.rewrite is not None:\n            _emit_bash_input_rewritten_event(decision.rewrite)\n        _adapter_emit(\n            _adapter, _to_contract_decision(decision, event.tool_input), event\n        )\n        return 0\n    except Exception as e:  # pragma: no cover\n        print(\n            f\"[check_bash_safety] FATAL: {e.__class__.__name__}: {e}\",\n            file=sys.stderr,\n        )\n        _adapter_emit(_adapter, _contract.allow(), event)\n        return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":254,"startLine":1,"totalLines":254}},"tool_result_meta":[{"id":"toolu_01KWkK1vZuMqD8PZHKXBkJFh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
