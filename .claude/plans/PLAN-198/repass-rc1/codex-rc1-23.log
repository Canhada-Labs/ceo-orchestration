   133	def _assertions(nodes: list) -> Iterable[ast.AST]:
   134	    for node in nodes:
   135	        if isinstance(node, ast.Assert):
   136	            yield node.test
   137	        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
   138	            if node.func.attr.startswith("assert"):
