-def _decide_with_matrix(
-    *,
-    tool_name: str,
-    file_path: str,
-    proposed_content: str,
-    repo_root: Path,
-    timeout_s: float,
-    session_id: str = "",
-) -> Dict[str, Any]:
-    """Phase 3 asymmetric VETO matrix wrapper around `_decide()`.
