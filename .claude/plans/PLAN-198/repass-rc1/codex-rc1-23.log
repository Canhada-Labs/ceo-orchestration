   193	def _codex_target_triple() -> Optional[str]:
   194	    """Derive the launcher's targetTriple for this host, or None.
   195	
   196	    Mirrors `bin/codex.js` (`process.platform`/`process.arch` mapping,
   197	    transcribed in PLAN-163 `probes/payload-sha-evidence.md`). Windows
   198	    payloads carry a `.exe` suffix handled in `_resolve_codex_payload`.
   199	
   200	    H1 fail-CLOSED test seam: `CEO_PAIR_RAIL_TARGET_TRIPLE` overrides the
   201	    derivation ONLY under the explicit `CEO_PAIR_RAIL_TEST_MODE=1` marker.
   202	    On the LIVE path (no marker) the override is IGNORED and the triple is
   203	    derived from the real host, so no CODEX-specific seam can point
   204	    verification at a foreign per-triple manifest entry. The
   205	    derived-or-overridden triple is still VERIFIED downstream — this seam
   206	    never relaxes the sha comparison. (Scope, PLAN-163 DIM1: this "no env"
   207	    claim covers CODEX-specific seams only; the manifest BASE follows the
   208	    framework-wide `CLAUDE_PROJECT_DIR` anchor — see `_pin_manifest_path`.)
   209	    """
   210	    if os.environ.get("CEO_PAIR_RAIL_TEST_MODE") == "1":
   211	        override = os.environ.get("CEO_PAIR_RAIL_TARGET_TRIPLE")
   212	        if override:
   213	            return override
   214	    try:
   215	        import platform as _platform
   216	        sysname = _platform.system()
   217	        machine = _platform.machine().lower()
   218	    except Exception:
   219	        return None
   220	    arm = machine in ("arm64", "aarch64")
   221	    x64 = machine in ("x86_64", "amd64")
   222	    if sysname == "Darwin":
   223	        if arm:
   224	            return "aarch64-apple-darwin"
   225	        if x64:
   226	            return "x86_64-apple-darwin"
   227	    elif sysname == "Linux":
   228	        if x64:
   229	            return "x86_64-unknown-linux-musl"
   230	        if arm:
   231	            return "aarch64-unknown-linux-musl"
   232	    elif sysname == "Windows":
   233	        if x64:
   234	            return "x86_64-pc-windows-msvc"
   235	        if arm:
   236	            return "aarch64-pc-windows-msvc"
   237	    return None
