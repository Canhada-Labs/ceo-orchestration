    21	def _fnmatch_segments(path: str, pattern: str) -> bool:
    22	    """Segment-wise glob matcher with `*` (one segment) and `**` (zero+).
    23	
    24	    Stripped-down port of `check_canonical_edit._fnmatch_segments`.
    25	    """
    26	    import fnmatch as _fn
    27	
    28	    p_parts = path.split("/")
    29	    pat_parts = pattern.split("/")
    30	
    31	    def _match(p: List[str], pat: List[str]) -> bool:
    32	        if not pat:
    33	            return not p
    34	        head, rest = pat[0], pat[1:]
    35	        if head == "**":
    36	            for i in range(len(p) + 1):
    37	                if _match(p[i:], rest):
    38	                    return True
    39	            return False
    40	        if not p:
    41	            return False
    42	        if head == "*" or _fn.fnmatchcase(p[0], head):
    43	            return _match(p[1:], rest)
    44	        return False
    45	
    46	    return _match(p_parts, pat_parts)
