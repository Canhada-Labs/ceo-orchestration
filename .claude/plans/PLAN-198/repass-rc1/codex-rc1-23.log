    13	def main(argv=None) -> int:
    14	    parser = argparse.ArgumentParser(description=__doc__)
    15	    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[2])
    16	    parser.add_argument("--baseline", type=Path, default=Path(__file__).with_name("subprocess-test-baseline.json"))
    17	    parser.add_argument("--kind", choices=(*KINDS, "all"), default="all")
    18	    parser.add_argument("--list", action="store_true", help="emit all current findings as JSON")
    19	    args = parser.parse_args(argv)
    20	    try:
    21	        findings = [f for f in scan_tree(args.root) if args.kind in ("all", f.kind)]
    22	        additions = new_findings(findings, load_baseline(args.baseline))
    23	    except (OSError, UnicodeError, SyntaxError, ValueError) as exc:
    24	        print(f"subprocess census: {type(exc).__name__}: {exc}", file=sys.stderr)
    25	        return 2
    26	    if args.list:
    27	        print(json.dumps([f._asdict() for f in findings], indent=2))
    28	    for finding in additions:
    29	        print(f"NEW {finding.kind} {finding.path}:{finding.line} {finding.scope}", file=sys.stderr)
    30	    if not args.list:
    31	        print(f"subprocess census: {len(findings)} existing sites; {len(additions)} new sites")
    32	    return 1 if additions else 0
    33	
    34	
    35	if __name__ == "__main__":
    36	    raise SystemExit(main())
