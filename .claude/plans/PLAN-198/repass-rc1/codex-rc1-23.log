    42	from __future__ import annotations
    43	
    44	import fnmatch
    45	import subprocess
    46	from pathlib import Path
    47	from typing import Iterable, Iterator, Optional, Set
    48	
    49	
    50	class FileWalker:
    51	    """Unified file iterator + allowlist applier."""
    52	
    53	    def __init__(
    54	        self,
    55	        repo_root: Path,
    56	        mode: str = "filesystem",
    57	        suffixes: Optional[Set[str]] = None,
