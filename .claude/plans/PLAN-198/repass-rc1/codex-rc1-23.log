-    ``bool`` is rejected explicitly: it is an ``int`` subclass and ``True``
-    would otherwise sail through as the number 1."""
-    if isinstance(val, bool):
-        return None
-    if isinstance(val, (int, float)):
-        return float(val)
-    return None
