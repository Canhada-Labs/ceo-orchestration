-def _hash_file_path_prefix(file_path: str) -> str:
-    """Compute 16-hex SHA-256 prefix of file path (LLM06 side-channel guard)."""
-    import hashlib
-    if not file_path:
-        return ""
-    return hashlib.sha256(file_path.encode("utf-8")).hexdigest()[:16]
