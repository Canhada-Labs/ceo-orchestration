    92	def _detect_write_shaped_patch(response_text: str) -> Optional[str]:
    93	    """Detect any write-shaped patch in a Codex review response.
    94	
    95	    Returns the matched grammar tag (`codex_apply_patch`, `unified_diff`,
    96	    `codex_move`, `json_patch`) on first detection, or None if response
    97	    is clean. Order is: Codex envelope → unified diff → JSON patch.
    98	
    99	    Defense:
   100	    - Length cap (4 MiB) — pathological responses skipped (treated as
   101	      clean by production heuristic; future revision should fail-CLOSED).
   102	    - Line cap (200k) — bound regex iteration.
   103	    - All regexes anchored with `^...$` (multiline) — no nested
   104	      quantifiers susceptible to ReDoS.
   105	    """
   106	    if not isinstance(response_text, str) or not response_text:
   107	        return None
   108	    if len(response_text) > _MAX_RESPONSE_BYTES:
   109	        # Spike: treat oversize as clean (advisory). Production note:
   110	        # ADR-110 PROPOSED Phase 1 should fail-CLOSED here.
   111	        return None
   112	    # Cap line count via early exit on findall-like inspection.
   113	    line_count = response_text.count("\n")
   114	    if line_count > _MAX_RESPONSE_LINES:
   115	        return None
   116	
   117	    # Grammar 1a: Codex apply_patch envelope.
   118	    if _CODEX_PATCH_RE.search(response_text) is not None:
   119	        return "codex_apply_patch"
   120	
   121	    # Grammar 1b: Codex move directive.
   122	    if _CODEX_MOVE_RE.search(response_text) is not None:
   123	        return "codex_move"
   124	
   125	    # Grammar 2: Unified diff. Filter false positives from prose by
   126	    # requiring the second-half marker to also exist (`---` AND `+++`).
   127	    has_minus = re.search(r"^---\s+", response_text, re.MULTILINE) is not None
   128	    has_plus = re.search(r"^\+\+\+\s+", response_text, re.MULTILINE) is not None
   129	    if has_minus and has_plus:
   130	        return "unified_diff"
   131	
   132	    # Grammar 3: JSON Patch (RFC 6902). Two-pass:
   133	    # (a) JSON-shape body — try strict json.loads.
   134	    stripped = response_text.lstrip()
   135	    if stripped.startswith(("[", "{")):
   136	        try:
   137	            parsed = json.loads(response_text)
   138	        except (ValueError, TypeError):
   139	            parsed = None
   140	        if isinstance(parsed, list):
   141	            for op in parsed:
   142	                if (
   143	                    isinstance(op, dict)
   144	                    and isinstance(op.get("op"), str)
   145	                    and isinstance(op.get("path"), str)
   146	                    and op["path"].startswith("/")
   147	                    and op["op"] in {"add", "remove", "replace", "move", "copy"}
   148	                ):
   149	                    return "json_patch"
   150	        elif isinstance(parsed, dict):
   151	            # Single op object (uncommon but valid).
   152	            if (
   153	                isinstance(parsed.get("op"), str)
   154	                and isinstance(parsed.get("path"), str)
   155	                and parsed["path"].startswith("/")
   156	                and parsed["op"] in {"add", "remove", "replace", "move", "copy"}
   157	            ):
   158	                return "json_patch"
   159	    # (b) Legacy regex fallback for embedded JSON-Patch fragments in
   160	    # mixed prose.
   161	    if (
   162	        '"op"' in response_text
   163	        and '"path"' in response_text
   164	        and _JSON_PATCH_PATH_RE.search(response_text) is not None
   165	    ):
   166	        return "json_patch"
   167	
   168	    return None
