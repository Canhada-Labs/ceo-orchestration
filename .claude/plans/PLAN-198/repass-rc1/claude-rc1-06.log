{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01B5T5eoLMQWg4hWcBEsim1G","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"check-vacuous-checks.py — lint de vacuidade dos checks do /ceo-boot.\n3\t\n4\tPLAN-178 W-C Lote A (C3), perna R1. Classe-alvo (S287/S292 +\n5\tfeedback-check-tier-a-spec-version-drift-vacuous): um ``check_*`` que\n6\tnao consegue DISCRIMINAR — nenhum caminho alcancavel muda a cor com o\n7\testado do mundo — e verde decorativo: parece instrumento, nao mede.\n8\t\n9\tRegra R1 (heuristica conservadora, stdlib-only; codex Lote-A P2-2 —\n10\tos status sao derivados EXCLUSIVAMENTE dos nos ``return``, nunca do\n11\ttexto do corpo, senao um literal em docstring/dict/branch morto conta\n12\tcomo discriminacao):\n13\t- ``ok``       — os ``return``s da funcao devolvem >= 2 literais de\n14\t                 status distintos dentre {green, yellow, red}.\n15\t- ``indirect`` — algum ``return`` devolve o status por VARIAVEL ou\n16\t                 CHAMADA (helper/delegacao): nao-decidivel\n17\t                 estaticamente; contado e pulado, nunca flagrado.\n18\t- ``waived``   — comentario ESTRUTURADO ``# CEO-INFORMATIONAL-ONLY:\n19\t                 <razao>`` na linha do ``def`` ou na anterior — e SO\n20\t                 ai; mencao em docstring/string nao waiva (espelha\n21\t                 ``# CEO-DEBT:`` do nightly dim viii). Para checks\n22\t                 deliberadamente informacionais (contadores sem\n23\t                 limiar).\n24\t- ``VACUOUS``  — nada acima: so consegue devolver UMA cor. Exit 1.\n25\t\n26\tA perna R2 da cura (positive control POR check) vive nos testes de\n27\t``.claude/scripts/tests/`` — este lint nao a substitui.\n28\t\n29\tExit: 0 = limpo; 1 = candidato(s) vacuoso(s); 2 = erro de uso/parse.\n30\tA medicao imprime seus INPUTS (licao S285).\n31\t\"\"\"\n32\tfrom __future__ import annotations\n33\t\n34\timport ast\n35\timport re\n36\timport sys\n37\tfrom typing import Iterator, List, Optional, Set, Tuple\n38\t\n39\tSTATUSES = (\"green\", \"yellow\", \"red\")\n40\tWAIVER_MARK = \"CEO-INFORMATIONAL-ONLY\"\n41\t# Waiver ESTRUTURADO (codex r2 P2-4): comentario com razao nao-vazia —\n42\t# mencao em docstring/string NUNCA waiva.\n43\t_WAIVER_RE = re.compile(r\"#[ \\t]*\" + WAIVER_MARK + r\"[ \\t]*:[ \\t]*\\S\")\n44\t\n45\t\n46\tdef _iter_local_returns(node: ast.FunctionDef) -> Iterator[ast.Return]:\n47\t    \"\"\"Returns PROPRIOS da funcao, alcancaveis (codex r2 P2-3).\n48\t\n49\t    Nao desce em def/class aninhados (returns de helper nao contam) e\n50\t    poda branches estaticamente mortos (``if False:`` / ``if True:``\n51\t    elide o lado morto).\n52\t    \"\"\"\n53\t    def walk(stmts):\n54\t        for st in stmts:\n55\t            if isinstance(st, (ast.FunctionDef, ast.AsyncFunctionDef,\n56\t                               ast.ClassDef)):\n57\t                continue\n58\t            if isinstance(st, ast.Return):\n59\t                yield st\n60\t                continue\n61\t            if isinstance(st, ast.If) and isinstance(st.test, ast.Constant):\n62\t                yield from walk(st.body if st.test.value else st.orelse)\n63\t                continue\n64\t            for field in (\"body\", \"orelse\", \"finalbody\"):\n65\t                sub = getattr(st, field, None)\n66\t                if sub:\n67\t                    yield from walk(sub)\n68\t            for handler in getattr(st, \"handlers\", []) or []:\n69\t                yield from walk(handler.body)\n70\t    yield from walk(node.body)\n71\t\n72\t\n73\tdef _return_status_profile(node: ast.FunctionDef) -> Tuple[Set[str], bool]:\n74\t    \"\"\"(literais de status devolvidos, ha_return_indireto).\n75\t\n76\t    Olha SO o primeiro elemento de cada ``return`` local alcancavel.\n77\t    Literal fora de {green,yellow,red} e ignorado; nao-literal\n78\t    (Name/Call/IfExp/...) marca a funcao como indireta.\n79\t    \"\"\"\n80\t    found: Set[str] = set()\n81\t    indirect = False\n82\t    for sub in _iter_local_returns(node):\n83\t        if sub.value is None:\n84\t            continue\n85\t        val = sub.value\n86\t        first = val.elts[0] if isinstance(val, ast.Tuple) and val.elts else val\n87\t        if isinstance(first, ast.Constant) and isinstance(first.value, str):\n88\t            if first.value in STATUSES:\n89\t                found.add(first.value)\n90\t        else:\n91\t            indirect = True\n92\t    return found, indirect\n93\t\n94\t\n95\tdef scan_file(path: str) -> Tuple[int, List[str]]:\n96\t    try:\n97\t        with open(path, \"r\", encoding=\"utf-8\") as fh:\n98\t            src = fh.read()\n99\t        tree = ast.parse(src)\n100\t    except (OSError, SyntaxError) as exc:  # fail-loud: lint nao adivinha\n101\t        return 2, [\"PARSE-ERROR %s: %s\" % (path, exc)]\n102\t\n103\t    lines = src.splitlines()\n104\t    ok = waived = indirect = 0\n105\t    flagged: List[str] = []\n106\t    for node in ast.walk(tree):\n107\t        if not (isinstance(node, ast.FunctionDef)\n108\t                and node.name.startswith(\"check_\")):\n109\t            continue\n110\t        head = \"\\n\".join(lines[max(0, node.lineno - 2):node.lineno + 1])\n111\t        returned, has_indirect = _return_status_profile(node)\n112\t        if len(returned) >= 2:\n113\t            ok += 1\n114\t        elif has_indirect:\n115\t            indirect += 1\n116\t        elif _WAIVER_RE.search(head):\n117\t            waived += 1\n118\t        else:\n119\t            found = sorted(returned) or [\"<none>\"]\n120\t            flagged.append(\"VACUOUS %s:%d %s statuses=%s\"\n121\t                           % (path, node.lineno, node.name, found))\n122\t    total = ok + waived + indirect + len(flagged)\n123\t    print(\"INPUTS: file=%s checks=%d rule=discriminate>=2of%s waiver=%s\"\n124\t          % (path, total, list(STATUSES), WAIVER_MARK))\n125\t    print(\"ok=%d indirect=%d waived=%d flagged=%d\"\n126\t          % (ok, indirect, waived, len(flagged)))\n127\t    return (1 if flagged else 0), flagged\n128\t\n129\t\n130\tdef main(argv: Optional[List[str]] = None) -> int:\n131\t    args = list(sys.argv[1:] if argv is None else argv)\n132\t    if not args:\n133\t        args = [\".claude/scripts/ceo-boot.py\"]\n134\t    worst = 0\n135\t    for path in args:\n136\t        code, flagged = scan_file(path)\n137\t        for line in flagged:\n138\t            print(\"  \" + line)\n139\t        worst = max(worst, code)\n140\t    return worst\n141\t\n142\t\n143\tif __name__ == \"__main__\":\n144\t    sys.exit(main())\n145\t"}]},"parent_tool_use_id":null,"session_id":"8251238c-5deb-4f64-879e-480beb36292d","uuid":"b9a6ee5b-fb48-4919-9b35-79dba418a0ef","timestamp":"2026-11-13T16:40:54.654Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/check-vacuous-checks.py","content":"#!/usr/bin/env python3\n\"\"\"check-vacuous-checks.py — lint de vacuidade dos checks do /ceo-boot.\n\nPLAN-178 W-C Lote A (C3), perna R1. Classe-alvo (S287/S292 +\nfeedback-check-tier-a-spec-version-drift-vacuous): um ``check_*`` que\nnao consegue DISCRIMINAR — nenhum caminho alcancavel muda a cor com o\nestado do mundo — e verde decorativo: parece instrumento, nao mede.\n\nRegra R1 (heuristica conservadora, stdlib-only; codex Lote-A P2-2 —\nos status sao derivados EXCLUSIVAMENTE dos nos ``return``, nunca do\ntexto do corpo, senao um literal em docstring/dict/branch morto conta\ncomo discriminacao):\n- ``ok``       — os ``return``s da funcao devolvem >= 2 literais de\n                 status distintos dentre {green, yellow, red}.\n- ``indirect`` — algum ``return`` devolve o status por VARIAVEL ou\n                 CHAMADA (helper/delegacao): nao-decidivel\n                 estaticamente; contado e pulado, nunca flagrado.\n- ``waived``   — comentario ESTRUTURADO ``# CEO-INFORMATIONAL-ONLY:\n                 <razao>`` na linha do ``def`` ou na anterior — e SO\n                 ai; mencao em docstring/string nao waiva (espelha\n                 ``# CEO-DEBT:`` do nightly dim viii). Para checks\n                 deliberadamente informacionais (contadores sem\n                 limiar).\n- ``VACUOUS``  — nada acima: so consegue devolver UMA cor. Exit 1.\n\nA perna R2 da cura (positive control POR check) vive nos testes de\n``.claude/scripts/tests/`` — este lint nao a substitui.\n\nExit: 0 = limpo; 1 = candidato(s) vacuoso(s); 2 = erro de uso/parse.\nA medicao imprime seus INPUTS (licao S285).\n\"\"\"\nfrom __future__ import annotations\n\nimport ast\nimport re\nimport sys\nfrom typing import Iterator, List, Optional, Set, Tuple\n\nSTATUSES = (\"green\", \"yellow\", \"red\")\nWAIVER_MARK = \"CEO-INFORMATIONAL-ONLY\"\n# Waiver ESTRUTURADO (codex r2 P2-4): comentario com razao nao-vazia —\n# mencao em docstring/string NUNCA waiva.\n_WAIVER_RE = re.compile(r\"#[ \\t]*\" + WAIVER_MARK + r\"[ \\t]*:[ \\t]*\\S\")\n\n\ndef _iter_local_returns(node: ast.FunctionDef) -> Iterator[ast.Return]:\n    \"\"\"Returns PROPRIOS da funcao, alcancaveis (codex r2 P2-3).\n\n    Nao desce em def/class aninhados (returns de helper nao contam) e\n    poda branches estaticamente mortos (``if False:`` / ``if True:``\n    elide o lado morto).\n    \"\"\"\n    def walk(stmts):\n        for st in stmts:\n            if isinstance(st, (ast.FunctionDef, ast.AsyncFunctionDef,\n                               ast.ClassDef)):\n                continue\n            if isinstance(st, ast.Return):\n                yield st\n                continue\n            if isinstance(st, ast.If) and isinstance(st.test, ast.Constant):\n                yield from walk(st.body if st.test.value else st.orelse)\n                continue\n            for field in (\"body\", \"orelse\", \"finalbody\"):\n                sub = getattr(st, field, None)\n                if sub:\n                    yield from walk(sub)\n            for handler in getattr(st, \"handlers\", []) or []:\n                yield from walk(handler.body)\n    yield from walk(node.body)\n\n\ndef _return_status_profile(node: ast.FunctionDef) -> Tuple[Set[str], bool]:\n    \"\"\"(literais de status devolvidos, ha_return_indireto).\n\n    Olha SO o primeiro elemento de cada ``return`` local alcancavel.\n    Literal fora de {green,yellow,red} e ignorado; nao-literal\n    (Name/Call/IfExp/...) marca a funcao como indireta.\n    \"\"\"\n    found: Set[str] = set()\n    indirect = False\n    for sub in _iter_local_returns(node):\n        if sub.value is None:\n            continue\n        val = sub.value\n        first = val.elts[0] if isinstance(val, ast.Tuple) and val.elts else val\n        if isinstance(first, ast.Constant) and isinstance(first.value, str):\n            if first.value in STATUSES:\n                found.add(first.value)\n        else:\n            indirect = True\n    return found, indirect\n\n\ndef scan_file(path: str) -> Tuple[int, List[str]]:\n    try:\n        with open(path, \"r\", encoding=\"utf-8\") as fh:\n            src = fh.read()\n        tree = ast.parse(src)\n    except (OSError, SyntaxError) as exc:  # fail-loud: lint nao adivinha\n        return 2, [\"PARSE-ERROR %s: %s\" % (path, exc)]\n\n    lines = src.splitlines()\n    ok = waived = indirect = 0\n    flagged: List[str] = []\n    for node in ast.walk(tree):\n        if not (isinstance(node, ast.FunctionDef)\n                and node.name.startswith(\"check_\")):\n            continue\n        head = \"\\n\".join(lines[max(0, node.lineno - 2):node.lineno + 1])\n        returned, has_indirect = _return_status_profile(node)\n        if len(returned) >= 2:\n            ok += 1\n        elif has_indirect:\n            indirect += 1\n        elif _WAIVER_RE.search(head):\n            waived += 1\n        else:\n            found = sorted(returned) or [\"<none>\"]\n            flagged.append(\"VACUOUS %s:%d %s statuses=%s\"\n                           % (path, node.lineno, node.name, found))\n    total = ok + waived + indirect + len(flagged)\n    print(\"INPUTS: file=%s checks=%d rule=discriminate>=2of%s waiver=%s\"\n          % (path, total, list(STATUSES), WAIVER_MARK))\n    print(\"ok=%d indirect=%d waived=%d flagged=%d\"\n          % (ok, indirect, waived, len(flagged)))\n    return (1 if flagged else 0), flagged\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    args = list(sys.argv[1:] if argv is None else argv)\n    if not args:\n        args = [\".claude/scripts/ceo-boot.py\"]\n    worst = 0\n    for path in args:\n        code, flagged = scan_file(path)\n        for line in flagged:\n            print(\"  \" + line)\n        worst = max(worst, code)\n    return worst\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":145,"startLine":1,"totalLines":145}},"tool_result_meta":[{"id":"toolu_01B5T5eoLMQWg4hWcBEsim1G","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
