{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DaUR9Wr2DKo4tHNCstm8hw","type":"tool_result","content":"1\t\"\"\"Extracted ceo-boot declarations executed by the facade.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t\n5\t\n6\t# ---- Bench harness ---------------------------------------------------------\n7\t\n8\tdef _percentile(xs: List[float], p: float) -> float:\n9\t    \"\"\"Stdlib percentile via sorted index. p in [0,100]. Empty → 0.0.\n10\t\n11\t    Spec (PLAN-065 §4.3 + S82 brief): use ``sorted(arr)[int(0.95 * len(arr))]``\n12\t    style indexing — NOT numpy. With small N the index can hit an off-by-one\n13\t    near the upper bound; we use ``int(round((len(s)-1) * p/100))`` which is\n14\t    monotonic-correct for both N=5 and N=10.\n15\t    \"\"\"\n16\t    if not xs:\n17\t        return 0.0\n18\t    s = sorted(xs)\n19\t    k = int(round((len(s) - 1) * p / 100.0))\n20\t    return s[k]\n21\t\n22\t\n23\tdef _rss_kb_current() -> float:\n24\t    \"\"\"Return current process RSS in KiB.\n25\t\n26\t    Codex S82 P1 fix: ``resource.getrusage(RUSAGE_SELF).ru_maxrss`` returns\n27\t    BYTES on macOS but KiB on Linux. We normalize to KiB by detecting the\n28\t    platform. This is high-water mark for the process; deltas across runs\n29\t    are still meaningful as long as the platform's unit is consistent.\n30\t    \"\"\"\n31\t    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n32\t    if sys.platform == \"darwin\":\n33\t        # macOS: bytes → KiB\n34\t        return rss / 1024.0\n35\t    # Linux + most BSDs: already KiB\n36\t    return float(rss)\n37\t\n38\t\n39\tdef bench(n_runs: int = 5, *, include_tier_a: bool = False) -> Dict[str, Any]:\n40\t    \"\"\"Run the dispatcher N times. Report p50/p95 wall-clock, per-iter RSS, deltas.\n41\t\n42\t    Output schema includes the legacy fields (``wall_clock_ms`` map, per-check\n43\t    p50/p95, tracemalloc current/peak) PLUS the PLAN-065 §4.3 spec fields\n44\t    (per-iter ``iterations`` list with ``iter``, ``duration_ms``, ``rss_kb``\n45\t    + summary dict with ``p50_ms``, ``p95_ms``, ``min_ms``, ``max_ms``,\n46\t    ``rss_delta_kb``).\n47\t    \"\"\"\n48\t    wall_clocks: List[float] = []\n49\t    rss_per_iter: List[float] = []\n50\t    iterations: List[Dict[str, Any]] = []\n51\t    registry = list(TIER_S_CHECKS) + (list(TIER_A_CHECKS) if include_tier_a else [])\n52\t    per_check_durations: Dict[str, List[float]] = {name: [] for name, _ in registry}\n53\t\n54\t    rss_before = _rss_kb_current()\n55\t    tracemalloc.start()\n56\t    snap_before = tracemalloc.take_snapshot()\n57\t    for i in range(n_runs):\n58\t        t0 = time.perf_counter()\n59\t        results = dispatch_parallel(include_tier_a=include_tier_a)\n60\t        wc = (time.perf_counter() - t0) * 1000\n61\t        rss_now = _rss_kb_current()\n62\t        wall_clocks.append(wc)\n63\t        rss_per_iter.append(rss_now)\n64\t        iterations.append({\n65\t            \"iter\": i + 1,\n66\t            \"duration_ms\": round(wc, 2),\n67\t            \"rss_kb\": round(rss_now, 2),\n68\t        })\n69\t        for r in results:\n70\t            per_check_durations.setdefault(r.name, []).append(r.duration_ms)\n71\t    snap_after = tracemalloc.take_snapshot()\n72\t    current, peak = tracemalloc.get_traced_memory()\n73\t    tracemalloc.stop()\n74\t    rss_after = _rss_kb_current()\n75\t\n76\t    diff_stats = snap_after.compare_to(snap_before, \"filename\")\n77\t    py_delta_kb = sum(stat.size_diff for stat in diff_stats) / 1024.0\n78\t\n79\t    return {\n80\t        \"n_runs\": n_runs,\n81\t        \"include_tier_a\": include_tier_a,\n82\t        \"iterations\": iterations,\n83\t        \"wall_clock_ms\": {\n84\t            \"p50\": _percentile(wall_clocks, 50),\n85\t            \"p95\": _percentile(wall_clocks, 95),\n86\t            \"min\": min(wall_clocks) if wall_clocks else 0.0,\n87\t            \"max\": max(wall_clocks) if wall_clocks else 0.0,\n88\t        },\n89\t        \"summary\": {\n90\t            \"p50_ms\": round(_percentile(wall_clocks, 50), 2),\n91\t            \"p95_ms\": round(_percentile(wall_clocks, 95), 2),\n92\t            \"min_ms\": round(min(wall_clocks), 2) if wall_clocks else 0.0,\n93\t            \"max_ms\": round(max(wall_clocks), 2) if wall_clocks else 0.0,\n94\t            \"rss_delta_kb\": round(rss_after - rss_before, 2),\n95\t        },\n96\t        \"per_check_p95_ms\": {name: _percentile(durs, 95) for name, durs in per_check_durations.items()},\n97\t        \"per_check_p50_ms\": {name: _percentile(durs, 50) for name, durs in per_check_durations.items()},\n98\t        \"memory_python_delta_kb\": round(py_delta_kb, 2),\n99\t        \"tracemalloc_peak_kb\": round(peak / 1024.0, 2),\n100\t        \"tracemalloc_current_kb\": round(current / 1024.0, 2),\n101\t    }\n102\t\n103\t\n104\tdef render_bench_markdown(report: Dict[str, Any]) -> str:\n105\t    \"\"\"Render bench report as a markdown table (PLAN-065 §4.3 spec).\n106\t\n107\t    Header columns: iter # | duration_ms | RSS_kb. Summary row appended\n108\t    with p50/p95/min/max/RSS_delta. Returns the rendered string (caller\n109\t    writes to stdout).\n110\t    \"\"\"\n111\t    lines = [\"\", \"## /ceo-boot --bench\", \"\"]\n112\t    lines.append(f\"N={report['n_runs']}  include_tier_a={report.get('include_tier_a', False)}\")\n113\t    lines.append(\"\")\n114\t    lines.append(\"| iter | duration_ms | RSS_kb |\")\n115\t    lines.append(\"|---|---|---|\")\n116\t    for it in report.get(\"iterations\", []):\n117\t        lines.append(f\"| {it['iter']} | {it['duration_ms']:.1f} | {it['rss_kb']:.1f} |\")\n118\t    s = report.get(\"summary\", {})\n119\t    lines.append(\n120\t        f\"| **summary** | p50={s.get('p50_ms', 0):.1f} / p95={s.get('p95_ms', 0):.1f}\"\n121\t        f\" / min={s.get('min_ms', 0):.1f} / max={s.get('max_ms', 0):.1f}\"\n122\t        f\" | rss_delta={s.get('rss_delta_kb', 0):.1f} |\"\n123\t    )\n124\t    lines.append(\"\")\n125\t    return \"\\n\".join(lines)\n126\t\n127\t\n128\t# === PLAN-065 Phase 2 audit_emit wire =====================================\n129\t# Reality-Ledger fixture #4 closure (declared-but-not-wired). Pre-S82,\n130\t# ceo-boot.py shipped emit comments only. Phase 2 wires the actual call.\n131\t# Sec MF-3 field allowlist enforced ON THE EMIT SIDE (_lib/audit_emit.py).\n132\t# Caller passes only allowlisted fields; never raises on emit failure.\n133\t# Pre-canonical-ceremony the symbol is missing → hasattr() guard short-\n134\t# circuits silently (advisory log to stderr only when CEO_BOOT_DEBUG=1).\n135\t\n136\t\n137\tdef _ceo_boot_session_id() -> str:\n138\t    \"\"\"Derive session id from harness env or a stable fallback.\n139\t\n140\t    Defense-in-depth: never raises. The session_id is used as a forensic\n141\t    correlator across the 15 Tier-S checks; it does NOT need to be\n142\t    cryptographically unique.\n143\t    \"\"\"\n144\t    sid = os.environ.get(\"CLAUDE_SESSION_ID\") or os.environ.get(\"CEO_SESSION_ID\")\n145\t    if sid:\n146\t        return sid[:64]  # bound length defense-in-depth\n147\t    # Fallback: parent shell PID + start of audit-log mtime. Stable\n148\t    # within a session, advisory across sessions.\n149\t    try:\n150\t        return f\"pid-{os.getppid()}-{int(AUDIT_LOG_DEFAULT.stat().st_mtime)}\"\n151\t    except OSError:\n152\t        return f\"pid-{os.getppid()}\"\n153\t\n154\t\n155\tdef _emit_ceo_boot_emitted_safe(\n156\t    *,\n157\t    gate_pass: bool,\n158\t    duration_ms: int,\n159\t    checks_total: int,\n160\t    checks_failed: int,\n161\t    cache_hit: bool = False,\n162\t) -> None:\n163\t    \"\"\"Wire-up to audit_emit.emit_ceo_boot_emitted. Fail-open contract.\n164\t\n165\t    Pre-canonical-ceremony: hasattr() returns False, function is a no-op.\n166\t    Post-ceremony: emits the telemetry event with Sec MF-3 field allowlist\n167\t    enforced on the emit side.\n168\t    \"\"\"\n169\t    if _audit_emit is None:\n170\t        return\n171\t    fn = getattr(_audit_emit, \"emit_ceo_boot_emitted\", None)\n172\t    if not callable(fn):\n173\t        if os.environ.get(\"CEO_BOOT_DEBUG\") == \"1\":\n174\t            sys.stderr.write(\n175\t                \"# ceo-boot: audit_emit.emit_ceo_boot_emitted not registered \"\n176\t                \"(canonical ceremony pending v1.12.0)\\n\"\n177\t            )\n178\t        return\n179\t    try:\n180\t        fn(\n181\t            session_id=_ceo_boot_session_id(),\n182\t            gate_pass=bool(gate_pass),\n183\t            duration_ms=int(duration_ms),\n184\t            checks_total=int(checks_total),\n185\t            checks_failed=int(checks_failed),\n186\t            cache_hit=bool(cache_hit),\n187\t        )\n188\t    except Exception:  # noqa: BLE001 — fail-open per audit_emit contract\n189\t        if os.environ.get(\"CEO_BOOT_DEBUG\") == \"1\":\n190\t            import traceback\n191\t            traceback.print_exc(file=sys.stderr)\n192\t\n193\t\n194\tdef _emit_ceo_boot_check_skipped_safe(\n195\t    *,\n196\t    check_name: str,\n197\t    timeout_ms: int,\n198\t) -> None:\n199\t    \"\"\"Wire-up to audit_emit.emit_ceo_boot_check_skipped. Fail-open contract.\"\"\"\n200\t    if _audit_emit is None:\n201\t        return\n202\t    fn = getattr(_audit_emit, \"emit_ceo_boot_check_skipped\", None)\n203\t    if not callable(fn):\n204\t        return\n205\t    try:\n206\t        fn(\n207\t            session_id=_ceo_boot_session_id(),\n208\t            check_name=check_name,\n209\t            timeout_ms=int(timeout_ms),\n210\t        )\n211\t    except Exception:  # noqa: BLE001 — fail-open\n212\t        pass\n213\t\n214\t\n215\t# === END PLAN-065 Phase 2 audit_emit wire =================================\n216\t\n217\t\n218\t# === PLAN-078 Wave 5 — TaskCreate-candidate marker emit + dedup ============\n219\t# Layer A of the Wave 5 closure (per PLAN-078 §4 + Codex CDX-UNIQUE-02 +\n220\t# CDX-P0-03 + CDX-P1-04 + Perf PERF-P1-03). Writes a structured stdout\n221\t# marker block per top-3 high/medium recommendation when gate_pass=False,\n222\t# dedup'd by 12-hex subject_hash via a 24h TTL state file under\n223\t# `_lib/filelock`. The Claude orchestrator running /ceo-boot reads the\n224\t# marker blocks and invokes TaskCreate when the session offers it, or\n225\t# renders the candidates inline when it does not (the task tools are\n226\t# model-dependent since Claude Code 2.1.233 — commands/ceo-boot.md\n227\t# Step 4.5); this script never touches the TaskCreate harness primitive\n228\t# directly, so the marker format is the same either way. Audit emit goes through\n229\t# `audit_emit.emit_ceo_boot_task_candidate_emitted` (hasattr-guarded\n230\t# pre-canonical-ceremony per the W5 staging→canonical model).\n231\t\n232\t# Default state path lives under the same project state dir as the cache\n233\t# (parity with audit-log.jsonl). Override `CEO_BOOT_TASK_STATE_PATH` for\n234\t# tests. Format: {\"entries\": [{\"subject_hash\": \"...\", \"ts\": <epoch>}, ...]}\n235\t# bounded to 256 entries (LRU evict on overflow).\n236\tTASK_EMIT_STATE_PATH_DEFAULT = (\n237\t    _rp.runtime_state_dir() / \"state\" / \"ceo-boot-tasks-emitted.json\"\n238\t)\n239\tTASK_EMIT_TTL_S = 24 * 60 * 60          # 24h dedup window\n240\tTASK_EMIT_TOP_N = 3                     # emit at most 3 markers per boot\n241\tTASK_EMIT_STATE_MAX_ENTRIES = 256       # bounded state size\n242\t\n243\t\n244\tdef _task_emit_state_path() -> Path:\n245\t    \"\"\"Resolve dedup state-file path at call time (env override-aware).\"\"\"\n246\t    override = os.environ.get(\"CEO_BOOT_TASK_STATE_PATH\")\n247\t    if override:\n248\t        return Path(override)\n249\t    return TASK_EMIT_STATE_PATH_DEFAULT\n250\t\n251\t\n252\tdef _subject_hash(subject: str) -> str:\n253\t    \"\"\"Return a 12-hex-char prefix of sha256(subject) for dedup bookkeeping.\n254\t\n255\t    The full subject text is NEVER persisted (Sec MF-3); the hash is the\n256\t    only stable identifier shared between the audit event and the state\n257\t    file. NFKC-normalize first so homoglyph variants collapse to the\n258\t    same dedup key (parity with `_sanitize_for_recs`).\n259\t    \"\"\"\n260\t    safe = subject if isinstance(subject, str) else str(subject)\n261\t    try:\n262\t        safe = unicodedata.normalize(\"NFKC\", safe)\n263\t    except (TypeError, ValueError):  # pragma: no cover — defensive\n264\t        pass\n265\t    digest = hashlib.sha256(safe.encode(\"utf-8\", errors=\"replace\")).hexdigest()\n266\t    return digest[:12]\n267\t\n268\t\n269\tdef _load_task_emit_state(path: Path) -> Dict[str, Any]:\n270\t    \"\"\"Load dedup state, prune entries older than TASK_EMIT_TTL_S.\n271\t\n272\t    Fail-open: corrupt JSON / unreadable file → returns empty state. The\n273\t    caller persists the pruned state on next write so corruption is\n274\t    self-healing across boots.\n275\t\n276\t    Codex CDX-W5-P1-04 closure: drop entries with non-finite timestamps\n277\t    (NaN / inf) and entries with timestamps in the future (NTP jump\n278\t    backward, deliberate clock skew). The TTL window is `[0, TTL)` —\n279\t    age must be a finite non-negative number strictly less than the\n280\t    TTL bound.\n281\t    \"\"\"\n282\t    if not path.exists():\n283\t        return {\"entries\": []}\n284\t    try:\n285\t        raw = path.read_text(encoding=\"utf-8\")\n286\t        data = json.loads(raw)\n287\t    except (OSError, json.JSONDecodeError):\n288\t        return {\"entries\": []}\n289\t    entries = data.get(\"entries\") if isinstance(data, dict) else None\n290\t    if not isinstance(entries, list):\n291\t        return {\"entries\": []}\n292\t    now = time.time()\n293\t    pruned: List[Dict[str, Any]] = []\n294\t    for entry in entries:\n295\t        if not isinstance(entry, dict):\n296\t            continue\n297\t        ts = entry.get(\"ts\")\n298\t        sh = entry.get(\"subject_hash\")\n299\t        if not isinstance(sh, str) or not isinstance(ts, (int, float)):\n300\t            continue\n301\t        # Reject NaN / inf — float comparison NaN!=NaN always; inf age\n302\t        # would otherwise be retained as TTL-current.\n303\t        ts_f = float(ts)\n304\t        if ts_f != ts_f or ts_f in (float(\"inf\"), float(\"-inf\")):\n305\t            continue\n306\t        age = now - ts_f\n307\t        if 0 <= age < TASK_EMIT_TTL_S:\n308\t            pruned.append({\"subject_hash\": sh[:12], \"ts\": ts_f})\n309\t    # Bound state size — LRU keep most-recent.\n310\t    if len(pruned) > TASK_EMIT_STATE_MAX_ENTRIES:\n311\t        pruned.sort(key=lambda e: e[\"ts\"], reverse=True)\n312\t        pruned = pruned[:TASK_EMIT_STATE_MAX_ENTRIES]\n313\t    return {\"entries\": pruned}\n314\t\n315\t\n316\tdef _save_task_emit_state(path: Path, state: Dict[str, Any]) -> None:\n317\t    \"\"\"Persist state atomically via temp-file + rename. Fail-open.\n318\t\n319\t    Codex CDX-W5-P1-03 closure: `os.replace` is atomic but not\n320\t    crash-durable on macOS — if the box loses power between the rename\n321\t    and the buffer flush, the dedup record is lost. We `fsync(tmp_fd)`\n322\t    before the rename and best-effort `fsync` the parent directory after.\n323\t    Both fsyncs are wrapped — fsync failure must NOT block the user\n324\t    session (the dedup is advisory; over-emitting once on crash is\n325\t    acceptable, lost-update is not).\n326\t    \"\"\"\n327\t    try:\n328\t        path.parent.mkdir(parents=True, exist_ok=True)\n329\t    except OSError:\n330\t        return\n331\t    tmp = path.with_suffix(path.suffix + \".tmp\")\n332\t    payload = json.dumps(state, separators=(\",\", \":\")).encode(\"utf-8\")\n333\t    try:\n334\t        # Write + fsync the data file before atomic rename.\n335\t        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)\n336\t        try:\n337\t            os.write(fd, payload)\n338\t            try:\n339\t                os.fsync(fd)\n340\t            except OSError:  # pragma: no cover — fsync best-effort\n341\t                pass\n342\t        finally:\n343\t            os.close(fd)\n344\t        os.replace(str(tmp), str(path))\n345\t        # Best-effort fsync of the parent directory so the rename\n346\t        # itself is durable. POSIX-only; NotImplementedError on win.\n347\t        try:\n348\t            dir_fd = os.open(str(path.parent), os.O_RDONLY)\n349\t            try:\n350\t                os.fsync(dir_fd)\n351\t            except OSError:  # pragma: no cover\n352\t                pass\n353\t            finally:\n354\t                os.close(dir_fd)\n355\t        except OSError:  # pragma: no cover — directory fsync optional\n356\t            pass\n357\t    except OSError:\n358\t        # Best-effort cleanup of the tmp file\n359\t        try:\n360\t            if tmp.exists():\n361\t                tmp.unlink()\n362\t        except OSError:  # pragma: no cover\n363\t            pass\n364\t\n365\t\n366\tdef _is_subject_recent(state: Dict[str, Any], subject_hash: str) -> bool:\n367\t    \"\"\"Return True if `subject_hash` is in state within TTL (already pruned by load).\"\"\"\n368\t    for entry in state.get(\"entries\", []):\n369\t        if isinstance(entry, dict) and entry.get(\"subject_hash\") == subject_hash:\n370\t            return True\n371\t    return False\n372\t\n373\t\n374\t# Codex CDX-W5-P1-05 closure: collapse interior whitespace in a marker\n375\t# subject so the `Subject:` line stays single-line. `_sanitize_for_recs`\n376\t# strips angle brackets + backticks but preserves `\\n` / `\\t` / multi-\n377\t# space, which can ambiguate the `<!-- /TASKCREATE-CANDIDATE -->`\n378\t# closing marker if a recommendation summary contains a literal newline.\n379\t# Bound to 200 chars (parity with `_sanitize_for_recs` length cap).\n380\tdef _collapse_marker_subject(text: str) -> str:\n381\t    \"\"\"Single-line, length-bounded subject for `Subject:` marker line.\n382\t\n383\t    Python `re.sub(r\"\\\\s+\", \" \", ...)` on a `str` matches Unicode\n384\t    whitespace (NBSP / em-space / narrow NBSP / line-tab / vertical-tab /\n385\t    form-feed in addition to ASCII), so the collapse is locale-safe.\n386\t    \"\"\"\n387\t    if not isinstance(text, str):\n388\t        text = str(text)\n389\t    # Replace ALL whitespace runs (Unicode-aware) with a single space.\n390\t    text = re.sub(r\"\\s+\", \" \", text).strip()\n391\t    return text[:200]\n392\t\n393\t\n394\tdef _emit_task_candidate_safe(\n395\t    *,\n396\t    rank: int,\n397\t    severity: str,\n398\t    subject_hash: str,\n399\t    awaiting_confirm: bool = False,\n400\t) -> None:\n401\t    \"\"\"Wire-up to audit_emit.emit_ceo_boot_task_candidate_emitted. Fail-open.\n402\t\n403\t    Pre-canonical-ceremony: hasattr() returns False, function is a no-op.\n404\t    Post-ceremony: emits the telemetry event with Sec MF-3 field allowlist\n405\t    enforced on the emit side (subject text NEVER leaves this script).\n406\t    \"\"\"\n407\t    if _audit_emit is None:\n408\t        return\n409\t    fn = getattr(_audit_emit, \"emit_ceo_boot_task_candidate_emitted\", None)\n410\t    if not callable(fn):\n411\t        if os.environ.get(\"CEO_BOOT_DEBUG\") == \"1\":\n412\t            sys.stderr.write(\n413\t                \"# ceo-boot: audit_emit.emit_ceo_boot_task_candidate_emitted \"\n414\t                \"not registered (canonical ceremony pending)\\n\"\n415\t            )\n416\t        return\n417\t    try:\n418\t        fn(\n419\t            session_id=_ceo_boot_session_id(),\n420\t            rank=int(rank),\n421\t            severity=str(severity),\n422\t            subject_hash=str(subject_hash),\n423\t            awaiting_confirm=bool(awaiting_confirm),\n424\t        )\n425\t    except Exception:  # noqa: BLE001 — fail-open per audit_emit contract\n426\t        if os.environ.get(\"CEO_BOOT_DEBUG\") == \"1\":\n427\t            import traceback\n428\t            traceback.print_exc(file=sys.stderr)\n429\t"}]},"parent_tool_use_id":null,"session_id":"8251238c-5deb-4f64-879e-480beb36292d","uuid":"eabb2b01-5b74-405c-91eb-4c6ab4348be9","timestamp":"2026-11-13T16:39:24.091Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_ceo_boot_parts/telemetry_candidates.py","content":"\"\"\"Extracted ceo-boot declarations executed by the facade.\"\"\"\nfrom __future__ import annotations\n\n\n\n# ---- Bench harness ---------------------------------------------------------\n\ndef _percentile(xs: List[float], p: float) -> float:\n    \"\"\"Stdlib percentile via sorted index. p in [0,100]. Empty → 0.0.\n\n    Spec (PLAN-065 §4.3 + S82 brief): use ``sorted(arr)[int(0.95 * len(arr))]``\n    style indexing — NOT numpy. With small N the index can hit an off-by-one\n    near the upper bound; we use ``int(round((len(s)-1) * p/100))`` which is\n    monotonic-correct for both N=5 and N=10.\n    \"\"\"\n    if not xs:\n        return 0.0\n    s = sorted(xs)\n    k = int(round((len(s) - 1) * p / 100.0))\n    return s[k]\n\n\ndef _rss_kb_current() -> float:\n    \"\"\"Return current process RSS in KiB.\n\n    Codex S82 P1 fix: ``resource.getrusage(RUSAGE_SELF).ru_maxrss`` returns\n    BYTES on macOS but KiB on Linux. We normalize to KiB by detecting the\n    platform. This is high-water mark for the process; deltas across runs\n    are still meaningful as long as the platform's unit is consistent.\n    \"\"\"\n    rss = resource.getrusage(resource.RUSAGE_SELF).ru_maxrss\n    if sys.platform == \"darwin\":\n        # macOS: bytes → KiB\n        return rss / 1024.0\n    # Linux + most BSDs: already KiB\n    return float(rss)\n\n\ndef bench(n_runs: int = 5, *, include_tier_a: bool = False) -> Dict[str, Any]:\n    \"\"\"Run the dispatcher N times. Report p50/p95 wall-clock, per-iter RSS, deltas.\n\n    Output schema includes the legacy fields (``wall_clock_ms`` map, per-check\n    p50/p95, tracemalloc current/peak) PLUS the PLAN-065 §4.3 spec fields\n    (per-iter ``iterations`` list with ``iter``, ``duration_ms``, ``rss_kb``\n    + summary dict with ``p50_ms``, ``p95_ms``, ``min_ms``, ``max_ms``,\n    ``rss_delta_kb``).\n    \"\"\"\n    wall_clocks: List[float] = []\n    rss_per_iter: List[float] = []\n    iterations: List[Dict[str, Any]] = []\n    registry = list(TIER_S_CHECKS) + (list(TIER_A_CHECKS) if include_tier_a else [])\n    per_check_durations: Dict[str, List[float]] = {name: [] for name, _ in registry}\n\n    rss_before = _rss_kb_current()\n    tracemalloc.start()\n    snap_before = tracemalloc.take_snapshot()\n    for i in range(n_runs):\n        t0 = time.perf_counter()\n        results = dispatch_parallel(include_tier_a=include_tier_a)\n        wc = (time.perf_counter() - t0) * 1000\n        rss_now = _rss_kb_current()\n        wall_clocks.append(wc)\n        rss_per_iter.append(rss_now)\n        iterations.append({\n            \"iter\": i + 1,\n            \"duration_ms\": round(wc, 2),\n            \"rss_kb\": round(rss_now, 2),\n        })\n        for r in results:\n            per_check_durations.setdefault(r.name, []).append(r.duration_ms)\n    snap_after = tracemalloc.take_snapshot()\n    current, peak = tracemalloc.get_traced_memory()\n    tracemalloc.stop()\n    rss_after = _rss_kb_current()\n\n    diff_stats = snap_after.compare_to(snap_before, \"filename\")\n    py_delta_kb = sum(stat.size_diff for stat in diff_stats) / 1024.0\n\n    return {\n        \"n_runs\": n_runs,\n        \"include_tier_a\": include_tier_a,\n        \"iterations\": iterations,\n        \"wall_clock_ms\": {\n            \"p50\": _percentile(wall_clocks, 50),\n            \"p95\": _percentile(wall_clocks, 95),\n            \"min\": min(wall_clocks) if wall_clocks else 0.0,\n            \"max\": max(wall_clocks) if wall_clocks else 0.0,\n        },\n        \"summary\": {\n            \"p50_ms\": round(_percentile(wall_clocks, 50), 2),\n            \"p95_ms\": round(_percentile(wall_clocks, 95), 2),\n            \"min_ms\": round(min(wall_clocks), 2) if wall_clocks else 0.0,\n            \"max_ms\": round(max(wall_clocks), 2) if wall_clocks else 0.0,\n            \"rss_delta_kb\": round(rss_after - rss_before, 2),\n        },\n        \"per_check_p95_ms\": {name: _percentile(durs, 95) for name, durs in per_check_durations.items()},\n        \"per_check_p50_ms\": {name: _percentile(durs, 50) for name, durs in per_check_durations.items()},\n        \"memory_python_delta_kb\": round(py_delta_kb, 2),\n        \"tracemalloc_peak_kb\": round(peak / 1024.0, 2),\n        \"tracemalloc_current_kb\": round(current / 1024.0, 2),\n    }\n\n\ndef render_bench_markdown(report: Dict[str, Any]) -> str:\n    \"\"\"Render bench report as a markdown table (PLAN-065 §4.3 spec).\n\n    Header columns: iter # | duration_ms | RSS_kb. Summary row appended\n    with p50/p95/min/max/RSS_delta. Returns the rendered string (caller\n    writes to stdout).\n    \"\"\"\n    lines = [\"\", \"## /ceo-boot --bench\", \"\"]\n    lines.append(f\"N={report['n_runs']}  include_tier_a={report.get('include_tier_a', False)}\")\n    lines.append(\"\")\n    lines.append(\"| iter | duration_ms | RSS_kb |\")\n    lines.append(\"|---|---|---|\")\n    for it in report.get(\"iterations\", []):\n        lines.append(f\"| {it['iter']} | {it['duration_ms']:.1f} | {it['rss_kb']:.1f} |\")\n    s = report.get(\"summary\", {})\n    lines.append(\n        f\"| **summary** | p50={s.get('p50_ms', 0):.1f} / p95={s.get('p95_ms', 0):.1f}\"\n        f\" / min={s.get('min_ms', 0):.1f} / max={s.get('max_ms', 0):.1f}\"\n        f\" | rss_delta={s.get('rss_delta_kb', 0):.1f} |\"\n    )\n    lines.append(\"\")\n    return \"\\n\".join(lines)\n\n\n# === PLAN-065 Phase 2 audit_emit wire =====================================\n# Reality-Ledger fixture #4 closure (declared-but-not-wired). Pre-S82,\n# ceo-boot.py shipped emit comments only. Phase 2 wires the actual call.\n# Sec MF-3 field allowlist enforced ON THE EMIT SIDE (_lib/audit_emit.py).\n# Caller passes only allowlisted fields; never raises on emit failure.\n# Pre-canonical-ceremony the symbol is missing → hasattr() guard short-\n# circuits silently (advisory log to stderr only when CEO_BOOT_DEBUG=1).\n\n\ndef _ceo_boot_session_id() -> str:\n    \"\"\"Derive session id from harness env or a stable fallback.\n\n    Defense-in-depth: never raises. The session_id is used as a forensic\n    correlator across the 15 Tier-S checks; it does NOT need to be\n    cryptographically unique.\n    \"\"\"\n    sid = os.environ.get(\"CLAUDE_SESSION_ID\") or os.environ.get(\"CEO_SESSION_ID\")\n    if sid:\n        return sid[:64]  # bound length defense-in-depth\n    # Fallback: parent shell PID + start of audit-log mtime. Stable\n    # within a session, advisory across sessions.\n    try:\n        return f\"pid-{os.getppid()}-{int(AUDIT_LOG_DEFAULT.stat().st_mtime)}\"\n    except OSError:\n        return f\"pid-{os.getppid()}\"\n\n\ndef _emit_ceo_boot_emitted_safe(\n    *,\n    gate_pass: bool,\n    duration_ms: int,\n    checks_total: int,\n    checks_failed: int,\n    cache_hit: bool = False,\n) -> None:\n    \"\"\"Wire-up to audit_emit.emit_ceo_boot_emitted. Fail-open contract.\n\n    Pre-canonical-ceremony: hasattr() returns False, function is a no-op.\n    Post-ceremony: emits the telemetry event with Sec MF-3 field allowlist\n    enforced on the emit side.\n    \"\"\"\n    if _audit_emit is None:\n        return\n    fn = getattr(_audit_emit, \"emit_ceo_boot_emitted\", None)\n    if not callable(fn):\n        if os.environ.get(\"CEO_BOOT_DEBUG\") == \"1\":\n            sys.stderr.write(\n                \"# ceo-boot: audit_emit.emit_ceo_boot_emitted not registered \"\n                \"(canonical ceremony pending v1.12.0)\\n\"\n            )\n        return\n    try:\n        fn(\n            session_id=_ceo_boot_session_id(),\n            gate_pass=bool(gate_pass),\n            duration_ms=int(duration_ms),\n            checks_total=int(checks_total),\n            checks_failed=int(checks_failed),\n            cache_hit=bool(cache_hit),\n        )\n    except Exception:  # noqa: BLE001 — fail-open per audit_emit contract\n        if os.environ.get(\"CEO_BOOT_DEBUG\") == \"1\":\n            import traceback\n            traceback.print_exc(file=sys.stderr)\n\n\ndef _emit_ceo_boot_check_skipped_safe(\n    *,\n    check_name: str,\n    timeout_ms: int,\n) -> None:\n    \"\"\"Wire-up to audit_emit.emit_ceo_boot_check_skipped. Fail-open contract.\"\"\"\n    if _audit_emit is None:\n        return\n    fn = getattr(_audit_emit, \"emit_ceo_boot_check_skipped\", None)\n    if not callable(fn):\n        return\n    try:\n        fn(\n            session_id=_ceo_boot_session_id(),\n            check_name=check_name,\n            timeout_ms=int(timeout_ms),\n        )\n    except Exception:  # noqa: BLE001 — fail-open\n        pass\n\n\n# === END PLAN-065 Phase 2 audit_emit wire =================================\n\n\n# === PLAN-078 Wave 5 — TaskCreate-candidate marker emit + dedup ============\n# Layer A of the Wave 5 closure (per PLAN-078 §4 + Codex CDX-UNIQUE-02 +\n# CDX-P0-03 + CDX-P1-04 + Perf PERF-P1-03). Writes a structured stdout\n# marker block per top-3 high/medium recommendation when gate_pass=False,\n# dedup'd by 12-hex subject_hash via a 24h TTL state file under\n# `_lib/filelock`. The Claude orchestrator running /ceo-boot reads the\n# marker blocks and invokes TaskCreate when the session offers it, or\n# renders the candidates inline when it does not (the task tools are\n# model-dependent since Claude Code 2.1.233 — commands/ceo-boot.md\n# Step 4.5); this script never touches the TaskCreate harness primitive\n# directly, so the marker format is the same either way. Audit emit goes through\n# `audit_emit.emit_ceo_boot_task_candidate_emitted` (hasattr-guarded\n# pre-canonical-ceremony per the W5 staging→canonical model).\n\n# Default state path lives under the same project state dir as the cache\n# (parity with audit-log.jsonl). Override `CEO_BOOT_TASK_STATE_PATH` for\n# tests. Format: {\"entries\": [{\"subject_hash\": \"...\", \"ts\": <epoch>}, ...]}\n# bounded to 256 entries (LRU evict on overflow).\nTASK_EMIT_STATE_PATH_DEFAULT = (\n    _rp.runtime_state_dir() / \"state\" / \"ceo-boot-tasks-emitted.json\"\n)\nTASK_EMIT_TTL_S = 24 * 60 * 60          # 24h dedup window\nTASK_EMIT_TOP_N = 3                     # emit at most 3 markers per boot\nTASK_EMIT_STATE_MAX_ENTRIES = 256       # bounded state size\n\n\ndef _task_emit_state_path() -> Path:\n    \"\"\"Resolve dedup state-file path at call time (env override-aware).\"\"\"\n    override = os.environ.get(\"CEO_BOOT_TASK_STATE_PATH\")\n    if override:\n        return Path(override)\n    return TASK_EMIT_STATE_PATH_DEFAULT\n\n\ndef _subject_hash(subject: str) -> str:\n    \"\"\"Return a 12-hex-char prefix of sha256(subject) for dedup bookkeeping.\n\n    The full subject text is NEVER persisted (Sec MF-3); the hash is the\n    only stable identifier shared between the audit event and the state\n    file. NFKC-normalize first so homoglyph variants collapse to the\n    same dedup key (parity with `_sanitize_for_recs`).\n    \"\"\"\n    safe = subject if isinstance(subject, str) else str(subject)\n    try:\n        safe = unicodedata.normalize(\"NFKC\", safe)\n    except (TypeError, ValueError):  # pragma: no cover — defensive\n        pass\n    digest = hashlib.sha256(safe.encode(\"utf-8\", errors=\"replace\")).hexdigest()\n    return digest[:12]\n\n\ndef _load_task_emit_state(path: Path) -> Dict[str, Any]:\n    \"\"\"Load dedup state, prune entries older than TASK_EMIT_TTL_S.\n\n    Fail-open: corrupt JSON / unreadable file → returns empty state. The\n    caller persists the pruned state on next write so corruption is\n    self-healing across boots.\n\n    Codex CDX-W5-P1-04 closure: drop entries with non-finite timestamps\n    (NaN / inf) and entries with timestamps in the future (NTP jump\n    backward, deliberate clock skew). The TTL window is `[0, TTL)` —\n    age must be a finite non-negative number strictly less than the\n    TTL bound.\n    \"\"\"\n    if not path.exists():\n        return {\"entries\": []}\n    try:\n        raw = path.read_text(encoding=\"utf-8\")\n        data = json.loads(raw)\n    except (OSError, json.JSONDecodeError):\n        return {\"entries\": []}\n    entries = data.get(\"entries\") if isinstance(data, dict) else None\n    if not isinstance(entries, list):\n        return {\"entries\": []}\n    now = time.time()\n    pruned: List[Dict[str, Any]] = []\n    for entry in entries:\n        if not isinstance(entry, dict):\n            continue\n        ts = entry.get(\"ts\")\n        sh = entry.get(\"subject_hash\")\n        if not isinstance(sh, str) or not isinstance(ts, (int, float)):\n            continue\n        # Reject NaN / inf — float comparison NaN!=NaN always; inf age\n        # would otherwise be retained as TTL-current.\n        ts_f = float(ts)\n        if ts_f != ts_f or ts_f in (float(\"inf\"), float(\"-inf\")):\n            continue\n        age = now - ts_f\n        if 0 <= age < TASK_EMIT_TTL_S:\n            pruned.append({\"subject_hash\": sh[:12], \"ts\": ts_f})\n    # Bound state size — LRU keep most-recent.\n    if len(pruned) > TASK_EMIT_STATE_MAX_ENTRIES:\n        pruned.sort(key=lambda e: e[\"ts\"], reverse=True)\n        pruned = pruned[:TASK_EMIT_STATE_MAX_ENTRIES]\n    return {\"entries\": pruned}\n\n\ndef _save_task_emit_state(path: Path, state: Dict[str, Any]) -> None:\n    \"\"\"Persist state atomically via temp-file + rename. Fail-open.\n\n    Codex CDX-W5-P1-03 closure: `os.replace` is atomic but not\n    crash-durable on macOS — if the box loses power between the rename\n    and the buffer flush, the dedup record is lost. We `fsync(tmp_fd)`\n    before the rename and best-effort `fsync` the parent directory after.\n    Both fsyncs are wrapped — fsync failure must NOT block the user\n    session (the dedup is advisory; over-emitting once on crash is\n    acceptable, lost-update is not).\n    \"\"\"\n    try:\n        path.parent.mkdir(parents=True, exist_ok=True)\n    except OSError:\n        return\n    tmp = path.with_suffix(path.suffix + \".tmp\")\n    payload = json.dumps(state, separators=(\",\", \":\")).encode(\"utf-8\")\n    try:\n        # Write + fsync the data file before atomic rename.\n        fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644)\n        try:\n            os.write(fd, payload)\n            try:\n                os.fsync(fd)\n            except OSError:  # pragma: no cover — fsync best-effort\n                pass\n        finally:\n            os.close(fd)\n        os.replace(str(tmp), str(path))\n        # Best-effort fsync of the parent directory so the rename\n        # itself is durable. POSIX-only; NotImplementedError on win.\n        try:\n            dir_fd = os.open(str(path.parent), os.O_RDONLY)\n            try:\n                os.fsync(dir_fd)\n            except OSError:  # pragma: no cover\n                pass\n            finally:\n                os.close(dir_fd)\n        except OSError:  # pragma: no cover — directory fsync optional\n            pass\n    except OSError:\n        # Best-effort cleanup of the tmp file\n        try:\n            if tmp.exists():\n                tmp.unlink()\n        except OSError:  # pragma: no cover\n            pass\n\n\ndef _is_subject_recent(state: Dict[str, Any], subject_hash: str) -> bool:\n    \"\"\"Return True if `subject_hash` is in state within TTL (already pruned by load).\"\"\"\n    for entry in state.get(\"entries\", []):\n        if isinstance(entry, dict) and entry.get(\"subject_hash\") == subject_hash:\n            return True\n    return False\n\n\n# Codex CDX-W5-P1-05 closure: collapse interior whitespace in a marker\n# subject so the `Subject:` line stays single-line. `_sanitize_for_recs`\n# strips angle brackets + backticks but preserves `\\n` / `\\t` / multi-\n# space, which can ambiguate the `<!-- /TASKCREATE-CANDIDATE -->`\n# closing marker if a recommendation summary contains a literal newline.\n# Bound to 200 chars (parity with `_sanitize_for_recs` length cap).\ndef _collapse_marker_subject(text: str) -> str:\n    \"\"\"Single-line, length-bounded subject for `Subject:` marker line.\n\n    Python `re.sub(r\"\\\\s+\", \" \", ...)` on a `str` matches Unicode\n    whitespace (NBSP / em-space / narrow NBSP / line-tab / vertical-tab /\n    form-feed in addition to ASCII), so the collapse is locale-safe.\n    \"\"\"\n    if not isinstance(text, str):\n        text = str(text)\n    # Replace ALL whitespace runs (Unicode-aware) with a single space.\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text[:200]\n\n\ndef _emit_task_candidate_safe(\n    *,\n    rank: int,\n    severity: str,\n    subject_hash: str,\n    awaiting_confirm: bool = False,\n) -> None:\n    \"\"\"Wire-up to audit_emit.emit_ceo_boot_task_candidate_emitted. Fail-open.\n\n    Pre-canonical-ceremony: hasattr() returns False, function is a no-op.\n    Post-ceremony: emits the telemetry event with Sec MF-3 field allowlist\n    enforced on the emit side (subject text NEVER leaves this script).\n    \"\"\"\n    if _audit_emit is None:\n        return\n    fn = getattr(_audit_emit, \"emit_ceo_boot_task_candidate_emitted\", None)\n    if not callable(fn):\n        if os.environ.get(\"CEO_BOOT_DEBUG\") == \"1\":\n            sys.stderr.write(\n                \"# ceo-boot: audit_emit.emit_ceo_boot_task_candidate_emitted \"\n                \"not registered (canonical ceremony pending)\\n\"\n            )\n        return\n    try:\n        fn(\n            session_id=_ceo_boot_session_id(),\n            rank=int(rank),\n            severity=str(severity),\n            subject_hash=str(subject_hash),\n            awaiting_confirm=bool(awaiting_confirm),\n        )\n    except Exception:  # noqa: BLE001 — fail-open per audit_emit contract\n        