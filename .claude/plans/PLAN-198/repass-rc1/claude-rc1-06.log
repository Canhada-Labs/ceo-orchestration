{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y8ANMDS4A9d9hCK87nrz1k","type":"tool_result","content":"40\t# (production callsite means a non-self consumer).\n41\tEXPECTED_CALLSITES: Dict[str, Tuple[Path, ...]] = {\n42\t    \"mcp_route_advised\": (\n43\t        _HOOKS_DIR / \"check_agent_spawn.py\",\n44\t        _HOOKS_DIR / \"_lib\" / \"mcp_routing.py\",\n45\t    ),\n46\t    # PLAN-088 R2 iter-2 STRICKEN specialization_promoted as separate\n47\t    # action; the A.5 promotion heuristic now emits mcp_route_advised\n48\t    # with signal_source=\"specialization_promoted\" discriminator.\n49\t    \"model_routing_advised\": (\n50\t        _HOOKS_DIR / \"check_agent_spawn.py\",\n51\t    ),\n52\t}\n53\t\n54\t\n55\t# Tier-S registry entries — production caller is ``ceo-boot.py``.\n56\tEXPECTED_TIER_S_REGISTRATIONS: Dict[str, Path] = {\n57\t    \"tier_policy_misrouting_24h\": _SCRIPTS / \"ceo-boot.py\",\n58\t}\n59\t\n60\t\n61\tdef _file_contains_emit(path: Path, action: str) -> bool:\n62\t    \"\"\"True iff the file contains a textual reference to the emit action\n63\t    that is NOT inside the audit_emit.py wrapper definition itself.\n64\t\n65\t    Pragma — exclude:\n66\t      - String literal in `_KNOWN_ACTIONS` registry (registry rows are\n67\t        not callsites).\n68\t      - The emit wrapper function `def emit_<action>(` (that IS the\n69\t        wrapper, not a caller).\n70\t    Both heuristics are absent from the production hook + script\n71\t    callsites (which only consume via `emit_generic(action_name, ...)`\n72\t    or `emit_<action>(...)`), so the false-positive risk is bounded.\n73\t    \"\"\"\n74\t    try:\n75\t        source = path.read_text(encoding=\"utf-8\")\n76\t    except OSError:\n77\t        return False\n78\t    # Anywhere the action string appears as a function call argument\n79\t    # or as a bare emit_<action> call counts as a callsite.\n80\t    if f'\"{action}\"' in source:\n81\t        return True\n82\t    if f\"'{action}'\" in source:\n83\t        return True\n84\t    if f\"emit_{action}(\" in source:\n85\t        return True\n86\t    return False\n87\t\n88\t\n89\tclass TestExpectedCallsites(unittest.TestCase):\n90\t    \"\"\"AC15.5 — every PLAN-091 wire has ≥1 non-self production caller.\"\"\"\n91\t\n92\t    def test_each_wire_has_at_least_one_callsite(self):\n93\t        missing: List[str] = []\n94\t        for action, callers in EXPECTED_CALLSITES.items():\n95\t            self.assertGreaterEqual(\n96\t                len(callers),\n97\t                1,\n98\t                f\"EXPECTED_CALLSITES entry for {action!r} must list ≥1 caller\",\n99\t            )\n100\t            hit = False\n101\t            for caller in callers:\n102\t                self.assertTrue(\n103\t                    caller.is_file(),\n104\t                    f\"Expected caller path missing on disk: {caller}\",\n105\t                )\n106\t                if _file_contains_emit(caller, action):\n107\t                    hit = True\n108\t                    break\n109\t            if not hit:\n110\t                missing.append(action)\n111\t        self.assertEqual(\n112\t            missing,\n113\t            [],\n114\t            f\"AC15.5 VIOLATION: actions without production callsite: {missing}\",\n115\t        )\n116\t\n117\t    def test_callers_outside_audit_emit_wrapper_module(self):\n118\t        \"\"\"A callsite under `_lib/audit_emit.py` is the wrapper definition,\n119\t        not a production caller — must be excluded from the map values.\n120\t        \"\"\"\n121\t        for action, callers in EXPECTED_CALLSITES.items():\n122\t            for caller in callers:\n123\t                self.assertNotEqual(\n124\t                    caller.name,\n125\t                    \"audit_emit.py\",\n126\t                    f\"{action}: audit_emit.py is the wrapper, not a callsite\",\n127\t                )\n128\t\n129\t\n130\tclass TestTierSRegistrations(unittest.TestCase):\n131\t    \"\"\"A