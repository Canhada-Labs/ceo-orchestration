{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XZm9pKgFUJPAV2EZQs1Hp5","type":"tool_result","content":"55\tfrom __future__ import annotations\n56\t\n57\timport json\n58\tfrom typing import Dict, List, Optional, Tuple\n59\t\n60\t# ---------------------------------------------------------------------------\n61\t# Module identity / version\n62\t# ---------------------------------------------------------------------------\n63\t\n64\t#: SemVer for the CLI-shape contract. Bump whenever the emitted flag\n65\t#: surface changes (e.g. the NEXT codex-cli bump edits THIS module —\n66\t#: that is the whole point of D2).\n67\tCLI_SHAPE_VERSION: str = \"1.0.0\"\n68\t\n69\t#: The codex-cli version this shape targets. Kept in sync with\n70\t#: ``.claude/governance/codex-cli-pin.txt`` (informational; the pin file\n71\t#: is the enforced supply-chain gate, not this constant).\n72\tCODEX_CLI_TARGET_VERSION: str = \"0.139.0\"\n73\t\n74\t\n75\t# ---------------------------------------------------------------------------\n76\t# Model-id catalog (MOVED here from _lib/adapters/codex.py — PLAN-142 §3 D2)\n77\t# ---------------------------------------------------------------------------\n78\t#\n79\t# This list is the SINGLE validation surface for Codex reviewer model ids.\n80\t# After the ceremony, `_lib/adapters/codex.py` imports `_VALID_MODELS` and\n81\t# `DEFAULT_MODEL` from here (no local copy) so the grep gate finds no\n82\t# model-id literal in the kernel files.\n83\t#\n84\t# PLAN-142 D5 / OQ1 resolution (smoke-resolved at execution, S246): a hands-on\n85\t# 0.139 probe against the Owner's Codex account showed that account serves ONLY\n86\t# its own default (`gpt-5.5`); forcing ANY id of the API-key catalog of that\n87\t# time returned HTTP 400 \"model not supported when using Codex with a ChatGPT\n88\t# account\". The historical `gpt-5.5` default that S120 silently coerced to the\n89\t# catalog default of that time was therefore the ONLY id that actually worked.\n90\t# The portable resolution: DEFAULT is to OMIT `--model` entirely so each account\n91\t# uses the model it can serve. `_VALID_MODELS` is a NAME-allowlist for an\n92\t# EXPLICIT override (rejects typos LOUDLY) — NOT an availability guarantee; a\n93\t# named-but-unavailable id degrades to a 400 -> ADVISORY at runtime (fail-open).\n94\t#"}]},"parent_tool_use_id":null,"session_id":"10e40156-2d16-43df-8172-e751d2a1e24b","uuid":"f130d8cb-6aa7-4ad7-a0d3-735cbaec636c","timestamp":"2026-11-15T09:07:48.564Z","tool_use_result":{"type":"text","file":{"filePath":".claude/hooks/_lib/codex_cli_shape.py","content":"from __future__ import annotations\n\nimport json\nfrom typing import Dict, List, Optional, Tuple\n\n# ---------------------------------------------------------------------------\n# Module identity / version\n# ---------------------------------------------------------------------------\n\n#: SemVer for the CLI-shape contract. Bump whenever the emitted flag\n#: surface changes (e.g. the NEXT codex-cli bump edits THIS module —\n#: that is the whole point of D2).\nCLI_SHAPE_VERSION: str = \"1.0.0\"\n\n#: The codex-cli version this shape targets. Kept in sync with\n#: ``.claude/governance/codex-cli-pin.txt`` (informational; the pin file\n#: is the enforced supply-chain gate, not this constant).\nCODEX_CLI_TARGET_VERSION: str = \"0.139.0\"\n\n\n# ---------------------------------------------------------------------------\n# Model-id catalog (MOVED here from _lib/adapters/codex.py — PLAN-142 §3 D2)\n# ---------------------------------------------------------------------------\n#\n# This list is the SINGLE validation surface for Codex reviewer model ids.\n# After the ceremony, `_lib/adapters/codex.py` imports `_VALID_MODELS` and\n# `DEFAULT_MODEL` from here (no local copy) so the grep gate finds no\n# model-id literal in the kernel files.\n#\n# PLAN-142 D5 / OQ1 resolution (smoke-resolved at execution, S246): a hands-on\n# 0.139 probe against the Owner's Codex account