pters) is cp -R'd wholesale, dragging nested __pycache__ dirs and\n1520:install_lib_selective() {\n1522:  echo \"==> Installing hooks/_lib (runtime only — tests/, test_isolation.py, testing.py excluded)\"\n1524:  for e in \"$SOURCE_DIR/.claude/hooks/_lib/\"*; do\n1533:      if _framework_path_excluded \".claude/hooks/_lib/$base\"; then continue; fi\n1540:    [[ -e \"$TARGET/.claude/hooks/_lib/$base\" || -L \"$TARGET/.claude/hooks/_lib/$base\" ]] && preexisting=1\n1541:    install_one \".claude/hooks/_lib/$base\"\n1547:      _prune_pycache_under \"$TARGET/.claude/hooks/_lib/$base\"\n1552:install_hooks_selective() {\n1554:  echo \"==> Installing hooks (top-level + _lib/, tests/ + legacy/ excluded)\"\n1555:  _state_record_op \"install_hooks\" \"selective (top-level + _lib)\"\n1556:  install_lib_selective\n1558:  for f in \"$SOURCE_DIR/.claude/hooks/\"*.sh \"$SOURCE_DIR/.claude/hooks/\"*.py; do\n1561:    install_one \".claude/hooks/$base\"\n1725:# to the legacy .py hooks (ADJ-014 dual-path); adopters opt-in to the\n1740:install_hooks_selective\n2023:# names .claude/skills/**, .claude/hooks/**, .claude/plans/PLAN-*.md).\n2355:    echo \"    COPIED: settings.base.json -> .claude/settings.json (base only, no stack hooks)\"\n2368:    # sandbox keys, not just its hooks — otherwise `--stack sandbox` ships a\n2371:    # Additive `// (base default)` precedence mirrors the hooks lines: the\n2377:      | .hooks.PreToolUse = (($base.hooks.PreToolUse // []) + ($stack.hooks.PreToolUse // []))\n2378:      | .hooks.PostToolUse = (($base.hooks.PostToolUse // []) + ($stack.hooks.PostToolUse // []))\n2393:    echo \"ERROR: jq is required to merge stack hooks for --stack $STACK, but jq was not found.\" >&2\n2398:    echo \"    WARNING: jq not found — using base only. Install jq and re-run to merge stack hooks.\" >&2\n2964:  #   - .claude/hooks/*                (same reason)\n3075:    \"$TARGET/.claude/hooks\"\n3138:    # PLAN-138 Wave C (ADR-155): portable verify via _hash_lib.sh\n3549:  