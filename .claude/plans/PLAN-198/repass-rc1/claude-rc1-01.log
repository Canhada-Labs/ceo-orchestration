{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014Bo67puo8vi1RQJiiqD85i","type":"tool_result","content":"1\t\"\"\"Reality ledger: audit actions.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport ast\n7\timport hashlib\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\timport time\n13\timport unicodedata\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom pathlib import Path\n17\tfrom typing import Any, Dict, FrozenSet, Iterable, List, Optional, Tuple\n18\t\n19\tfrom .constants import *  # shared declaration defaults\n20\t\n21\tdef _read_known_actions(audit_emit_path: Path) -> set:\n22\t    \"\"\"Parse `_KNOWN_ACTIONS = { ... }` from audit_emit.py via AST.\"\"\"\n23\t    try:\n24\t        source = audit_emit_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n25\t        tree = ast.parse(source, filename=str(audit_emit_path))\n26\t    except (OSError, SyntaxError):\n27\t        return set()\n28\t    out: set = set()\n29\t    for node in ast.walk(tree):\n30\t        if isinstance(node, ast.Assign):\n31\t            for tgt in node.targets:\n32\t                if isinstance(tgt, ast.Name) and tgt.id == \"_KNOWN_ACTIONS\":\n33\t                    val = node.value\n34\t                    if isinstance(val, (ast.Set, ast.List, ast.Tuple)):\n35\t                        for elt in val.elts:\n36\t                            if isinstance(elt, ast.Constant) and isinstance(elt.value, str):\n37\t                                out.add(elt.value)\n38\t    if out:\n39\t        return out\n40\t\n41\t    # Resolve only the literal roster passed to the facade's imported binder.\n42\t    # Target files are parsed as data; none is imported or executed.\n43\t    binders = {\n44\t        alias.asname or alias.name\n45\t        for node in tree.body if isinstance(node, ast.ImportFrom)\n46\t        and node.module == \"_lib._audit_emit_parts\"\n47\t        for alias in node.names if alias.name == \"install\"\n48\t    }\n49\t    roster = []\n50\t    for node in tree.body:\n51\t        if not (isinstance(node, ast.Expr) and isinstance(node.value, ast.Call)):\n52\t            continue\n53\t        call = node.value\n54\t        if not (isinstance(call.func, ast.Name) and call.func.id in binders\n55\t                and len(call.args) >= 2 and isinstance(call.args[1], (ast.Tuple, ast.List))):\n56\t            continue\n57\t        for item in call.args[1].elts:\n58\t            if isinstance(item, ast.Constant) and isinstance(item.value, str) and item.value.isidentifier():\n59\t                roster.append(item.value)\n60\t\n61\t    parts = audit_emit_path.parent / \"_audit_emit_parts\"\n62\t    parsed = {}\n63\t\n64\t    def parse_part(name):\n65\t        if name not in parsed:\n66\t            try:\n67\t                parsed[name] = ast.parse((parts / (name + \".py\")).read_text(\n68\t                    encoding=\"utf-8\", errors=\"replace\"))\n69\t            except (OSError, SyntaxError):\n70\t                parsed[name] = None\n71\t        return parsed[name]\n72\t\n73\t    def resolve(name, symbol, visiting):\n74\t        key = (name, symbol)\n75\t        if key in visiting:\n76\t            return None\n77\t        part = parse_part(name)\n78\t        if part is None:\n79\t            return None\n80\t        visiting = visiting | {key}\n81\t        for stmt in part.body:\n82\t            if isinstance(stmt, ast.Assign) and any(\n83\t                isinstance(target, ast.Name) and target.id == symbol for target in stmt.targets\n84\t            ):\n85\t                return evaluate(name, stmt.value, visiting)\n86\t            if isinstance(stmt, ast.ImportFrom) and stmt.level == 1 and stmt.module and stmt.module.isidentifier():\n87\t                for alias in stmt.names:\n88\t                    if (alias.asname or alias.name) == symbol and alias.name.isidentifier():\n89\t                        return resolve(stmt.module, alias.name, visiting)\n90\t        return None\n91\t\n92\t    def evaluate(name, expr, visiting):\n93\t        if isinstance(expr, (ast.Set, ast.List, ast.Tuple)):\n94\t            if all(isinstance(item, ast.Constant) and isinstance(item.value, str) for item in expr.elts):\n95\t                return {item.value for item in expr.elts}\n96\t        elif isinstance(expr, ast.Name):\n97\t            return resolve(name, expr.id, visiting)\n98\t        elif isinstance(expr, ast.BinOp) and isinstance(expr.op, ast.BitOr):\n99\t            left = evaluate(name, expr.left, visiting)\n100\t            right = evaluate(name, expr.right, visiting)\n101\t            if left is not None and right is not None:\n102\t                return left | right\n103\t        return None\n104\t\n105\t    for name in roster:\n106\t        part = parse_part(name)\n107\t        if part is None:\n108\t            continue\n109\t        exports = resolve(name, \"__all__\", set())\n110\t        if exports is not None and \"_KNOWN_ACTIONS\" in exports:\n111\t            actions = resolve(name, \"_KNOWN_ACTIONS\", set())\n112\t            if actions is not None:\n113\t                out.update(actions)\n114\t    return out\n115\t\n116\t\n117\tclass _EmitActionFinder(ast.NodeVisitor):\n118\t    \"\"\"Walk AST collecting action= literals from emit_generic(...) Call nodes.\n119\t\n120\t    AST-level avoids false positives in docstrings / regex examples / comments\n121\t    that the regex form inevitably catches (Codex precedent: docstring example\n122\t    literal `emit_generic(action=\"name\", ...)` got flagged as phantom).\n123\t    \"\"\"\n124\t\n125\t    def __init__(self) -> None:\n126\t        # action_name -> list of (lineno,)\n127\t        self.actions: Dict[str, List[int]] = {}\n128\t\n129\t    def visit_Call(self, node: ast.Call) -> None:  # noqa: N802\n130\t        # Only consider calls whose callee ends in `emit_generic`.\n131\t        func = node.func\n132\t        callee_chain: List[str] = []\n133\t        cur: Any = func\n134\t        while isinstance(cur, ast.Attribute):\n135\t            callee_chain.append(cur.attr)\n136\t            cur = cur.value\n137\t        if isinstance(cur, ast.Name):\n138\t            callee_chain.append(cur.id)\n139\t        callee_chain.reverse()\n140\t        last = callee_chain[-1] if callee_chain else \"\"\n141\t        if last == \"emit_generic\":\n142\t            # Find action= keyword OR first positional\n143\t            action_val: Optional[str] = None\n144\t            for kw in node.keywords or []:\n145\t                if kw.arg == \"action\" and isinstance(kw.value, ast.Constant) \\\n146\t                        and isinstance(kw.value.value, str):\n147\t                    action_val = kw.value.value\n148\t                    break\n149\t            if action_val is None and node.args:\n150\t                first = node.args[0]\n151\t                if isinstance(first, ast.Constant) and isinstance(first.value, str):\n152\t                    action_val = first.value\n153\t            if action_val:\n154\t                self.actions.setdefault(action_val, []).append(node.lineno)\n155\t        self.generic_visit(node)\n156\t\n157\t\n158\tdef _scan_emitted_actions(py_files: List[Path], *, repo_root: Path) -> Dict[str, List[str]]:\n159\t    \"\"\"Find action names emitted in code via emit_generic(...) — AST-level only.\n160\t\n161\t    Skips files whose path includes `tests/` to avoid catching fixture\n162\t    strings / mocked event payloads. Skips files inside `_lib/audit_emit.py`\n163\t    itself (its own dispatch table must reference all actions; not a phantom).\n164\t\n165\t    `repo_root` is required because we compute the relative path from the\n166\t    *target* root (which may be a fixture root in tests), not the\n167\t    framework root. Without this, a fixture under `…/tests/fixtures/…`\n168\t    in the framework checkout was always filtered out as \"tests/\".\n169\t    \"\"\"\n170\t    out: Dict[str, List[str]] = {}\n171\t    for f in py_files:\n172\t        try:\n173\t            rel = str(f.resolve().relative_to(repo_root.resolve())).replace(os.sep, \"/\")\n174\t        except (ValueError, OSError):\n175\t            rel = _to_repo_rel(f)\n176\t        # Exclude tests + audit_emit.py itself\n177\t        if \"/tests/\" in (\"/\" + rel) or rel.endswith(\"audit_emit.py\"):\n178\t            continue\n179\t        try:\n180\t            source = f.read_text(encoding=\"utf-8\", errors=\"replace\")\n181\t            tree = ast.parse(source, filename=str(f))\n182\t        except (OSError, SyntaxError):\n183\t            continue\n184\t        finder = _EmitActionFinder()\n185\t        try:\n186\t            finder.visit(tree)\n187\t        except Exception:\n188\t            continue\n189\t        for action, linenos in finder.actions.items():\n190\t            for ln in linenos:\n191\t                out.setdefault(action, []).append(f\"{rel}:{ln}\")\n192\t    return out\n193\t\n194\t\n195\tdef _legacy_scan_emitted_actions(py_files: List[Path]) -> Dict[str, List[str]]:\n196\t    \"\"\"Backward-compat wrapper used in unit-tests of the original signature.\"\"\"\n197\t    return _scan_emitted_actions(py_files, repo_root=_REPO_ROOT)\n198\t\n199\t\n200\tdef detect_audit_action_phantom(\n201\t    *,\n202\t    repo_root: Path,\n203\t) -> List[Dict[str, Any]]:\n204\t    \"\"\"Detector #6.\n205\t\n206\t    Phantom = action emitted in code but missing from `_KNOWN_ACTIONS`\n207\t    (silent drop precedent: Codex S76 `skill_bootstrap_used` regression).\n208\t    \"\"\"\n209\t    findings: List[Dict[str, Any]] = []\n210\t    audit_emit_path = repo_root / \".claude\" / \"hooks\" / \"_lib\" / \"audit_emit.py\"\n211\t    if not audit_emit_path.exists():\n212\t        return findings\n213\t\n214\t    known = _read_known_actions(audit_emit_path)\n215\t    py_roots = [repo_root / \".claude\" / \"scripts\", repo_root / \".claude\" / \"hooks\"]\n216\t    py_files = _iter_python_files(py_roots, repo_root=repo_root)\n217\t    emitted = _scan_emitted_actions(py_files, repo_root=repo_root)\n218\t\n219\t    # Phantom: emitted but not registered\n220\t    phantoms = sorted(set(emitted.keys()) - known)\n221\t    for action in phantoms:\n222\t        first_loc = emitted[action][0]\n223\t        finding = _build_finding(\n224\t            detector=\"audit_action_phantom\",\n225\t            severity=DETECTOR_REGISTRY[\"audit_action_phantom\"][\"severity\"],\n226\t            confidence=0.99,\n227\t            claim_source_path=first_loc,\n228\t            expected_evidence=(\n229\t                f\"action {action!r} present in audit_emit._KNOWN_ACTIONS\"\n230\t            ),\n231\t            actual_evidence=(\n232\t                f\"emitted in {len(emitted[action])} site(s); not registered\"\n233\t            ),\n234\t            advisory_action=(\n235\t                \"add action to _KNOWN_ACTIONS via KERNEL ceremony OR rename \"\n236\t                \"the emit call site\"\n237\t            ),\n238\t            extra={\"action\": action, \"emit_sites\": emitted[action][:5]},\n239\t        )\n240\t        findings.append(finding)\n241\t    return findings\n242\t\n243\t\n244\t# ---------------------------------------------------------------------------\n245\t# Detector #7 — estimate_drift  (PLAN-078 Wave 2)\n246\t# ---------------------------------------------------------------------------\n247\t#\n248\t# On plans whose `status: done` transition fired, compares the original\n249\t# `estimate.compute_hours` + `estimate.owner_physical_min` against the\n250\t# observed actuals (commit time-span + GPG-signed-commit count + manual\n251\t# override). Finding emitted when |drift_factor| ≥ 1.2 in either axis.\n252\t#\n253\t# Implementation discipline (Codex re-pass + plan §4.2):\n254\t#   - SINGLE batched `git log --pretty=%H,%aI --name-only` (~1 subprocess\n255\t#     call, NOT 1-per-plan) — see _git_log_paths().\n256\t#   - `created` field preferred over `created_at` (PLAN-SCHEMA §2 use).\n257\t#   - actual_owner_physical_min derived from GPG-signed commit count + an\n258\t#     optional `actual_owner_physical_min:` plan-frontmatter override\n259\t#     (clamped 0..10000; non-int → fail-open warn).\n260\t#   - severity bands: low <1.5×, medium 1.5-2×, high >2×.\n261\t#   - systematic_bias_direction: emitted ONLY in the run-summary recommend\n262\t#     event when N≥5 plans drift same direction.\n263\t#   - CSV append at `.claude/scripts/local/calibration-history.csv`\n264\t#     (gitignored). Each row keyed by `<plan_id>,<run_iso8601>` so re-runs\n265\t#     are idempotent (existing rows are NOT duplicated).\n266\t#   - Bypass: `CEO_REALITY_LEDGER_DETECTOR_07=0`.\n267\t#\n268\t# Output: List of finding dicts (run_detectors aggregator handles render +\n269\t# emit). Each finding embeds plan-level deltas in `_extra` for forensics.\n270\t\n271\t_PLAN_FILE_RE = re.compile(r\"^PLAN-(\\d{3,4})-.*\\.md$\")\n272\t_HOURS_RANGE_RE = re.compile(r\"(\\d+(?:\\.\\d+)?)\\s*-\\s*(\\d+(?:\\.\\d+)?)\")\n273\t_SINGLE_NUM_RE = re.compile(r\"\\d+(?:\\.\\d+)?\")\n274\t_ESTIMATE_KEY_RE = re.compile(r\"^estimate:\\s*$\")\n275\t_ESTIMATE_INDENT_RE = re.compile(r\"^\\s+(\\w+):\\s*(.+?)\\s*$\")\n276\t_TOP_KEY_RE = re.compile(r\"^[A-Za-z_]\")\n277\t\n278\t\n279\t\n280\t__all__ = ['_read_known_actions', '_EmitActionFinder', '_scan_emitted_actions', '_legacy_scan_emitted_actions', 'detect_audit_action_phantom', '_PLAN_FILE_RE', '_HOURS_RANGE_RE', '_SINGLE_NUM_RE', '_ESTIMATE_KEY_RE', '_ESTIMATE_INDENT_RE', '_TOP_KEY_RE']\n281\t"}]},"parent_tool_use_id":null,"session_id":"58d86da0-a33a-4fc7-a08e-6d4c6f14f756","uuid":"17135784-c200-4296-a1df-6169de38c3de","timestamp":"2026-11-13T16:20:58.522Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_reality_ledger_parts/audit_actions.py","content":"\"\"\"Reality ledger: audit actions.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport ast\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nimport time\nimport unicodedata\nimport uuid\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, FrozenSet, Iterable, List, Optional, Tuple\n\nfrom .constants import *  # shared declaration defaults\n\ndef _read_known_actions(audit_emit_path: Path) -> set:\n    \"\"\"Parse `_KNOWN_ACTIONS = { ... }` from audit_emit.py via AST.\"\"\"\n    try:\n        source = audit_emit_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n        tree = ast.parse(source, filename=str(audit_emit_path))\n    except (OSError, SyntaxError):\n        return set()\n    out: set = set()\n    for node in ast.walk(tree):\n        if isinstance(node, ast.Assign):\n            for tgt in node.targets:\n                if isinstance(tgt, ast.Name) and tgt.id == \"_KNOWN_ACTIONS\":\n                    val = node.value\n                    if isinstance(val, (ast.Set, ast.List, ast.Tuple)):\n                        for elt in val.elts:\n                            if isinstance(elt, ast.Constant) and isinstance(elt.value, str):\n                                out.add(elt.value)\n    if out:\n        return out\n\n    # Resolve only the literal roster passed to the facade's imported binder.\n    # Target files are parsed as data; none is imported or executed.\n    binders = {\n        alias.asname or alias.name\n        for node in tree.body if isinstance(node, ast.ImportFrom)\n        and node.module == \"_lib._audit_emit_parts\"\n        for alias in node.names if alias.name == \"install\"\n    }\n    roster = []\n    for node in tree.body:\n        if not (isinstance(node, ast.Expr) and isinstance(node.value, ast.Call)):\n            continue\n        call = node.value\n        if not (isinstance(call.func, ast.Name) and call.func.id in binders\n                and len(call.args) >= 2 and isinstance(call.args[1], (ast.Tuple, ast.List))):\n            continue\n        for item in call.args[1].elts:\n            if isinstance(item, ast.Constant) and isinstance(item.value, str) and item.value.isidentifier():\n                roster.append(item.value)\n\n    parts = audit_emit_path.parent / \"_audit_emit_parts\"\n    parsed = {}\n\n    def parse_part(name):\n        if name not in parsed:\n            try:\n                parsed[name] = ast.parse((parts / (name + \".py\")).read_text(\n                    encoding=\"utf-8\", errors=\"replace\"))\n            except (OSError, SyntaxError):\n                parsed[name] = None\n        return parsed[name]\n\n    def resolve(name, symbol, visiting):\n        key = (name, symbol)\n        if key in visiting:\n            return None\n        part = parse_part(name)\n        if part is None:\n            return None\n        visiting = visiting | {key}\n        for stmt in part.body:\n            if isinstance(stmt, ast.Assign) and any(\n                isinstance(target, ast.Name) and target.id == symbol for target in stmt.targets\n            ):\n                return evaluate(name, stmt.value, visiting)\n            if isinstance(stmt, ast.ImportFrom) and stmt.level == 1 and stmt.module and stmt.module.isidentifier():\n                for alias in stmt.names:\n                    if (alias.asname or alias.name) == symbol and alias.name.isidentifier():\n                        return resolve(stmt.module, alias.name, visiting)\n        return None\n\n    def evaluate(name, expr, visiting):\n        if isinstance(expr, (ast.Set, ast.List, ast.Tuple)):\n            if all(isinstance(item, ast.Constant) and isinstance(item.value, str) for item in expr.elts):\n                return {item.value for item in expr.elts}\n        elif isinstance(expr, ast.Name):\n            return resolve(name, expr.id, visiting)\n        elif isinstance(expr, ast.BinOp) and isinstance(expr.op, ast.BitOr):\n            left = evaluate(name, expr.left, visiting)\n            right = evaluate(name, expr.right, visiting)\n            if left is not None and right is not None:\n                return left | right\n        return None\n\n    for name in roster:\n        part = parse_part(name)\n        if part is None:\n            continue\n        exports = resolve(name, \"__all__\", set())\n        if exports is not None and \"_KNOWN_ACTIONS\" in exports:\n            actions = resolve(name, \"_KNOWN_ACTIONS\", set())\n            if actions is not None:\n                out.update(actions)\n    return out\n\n\nclass _EmitActionFinder(ast.NodeVisitor):\n    \"\"\"Walk AST collecting action= literals from emit_generic(...) Call nodes.\n\n    AST-level avoids false positives in docstrings / regex examples / comments\n    that the regex form inevitably catches (Codex precedent: docstring example\n    literal `emit_generic(action=\"name\", ...)` got flagged as phantom).\n    \"\"\"\n\n    def __init__(self) -> None:\n        # action_name -> list of (lineno,)\n        self.actions: Dict[str, List[int]] = {}\n\n    def visit_Call(self, node: ast.Call) -> None:  # noqa: N802\n        # Only consider calls whose callee ends in `emit_generic`.\n        func = node.func\n        callee_chain: List[str] = []\n        cur: Any = func\n        while isinstance(cur, ast.Attribute):\n            callee_chain.append(cur.attr)\n            cur = cur.value\n        if isinstance(cur, ast.Name):\n            callee_chain.append(cur.id)\n        callee_chain.reverse()\n        last = callee_chain[-1] if callee_chain else \"\"\n        if last == \"emit_generic\":\n            # Find action= keyword OR first positional\n            action_val: Optional[str] = None\n            for kw in node.keywords or []:\n                if kw.arg == \"action\" and isinstance(kw.value, ast.Constant) \\\n                        and isinstance(kw.value.value, str):\n                    action_val = kw.value.value\n                    break\n            if action_val is None and node.args:\n                first = node.args[0]\n                if isinstance(first, ast.Constant) and isinstance(first.value, str):\n                    action_val = first.value\n            if action_val:\n                self.actions.setdefault(action_val, []).append(node.lineno)\n        self.generic_visit(node)\n\n\ndef _scan_emitted_actions(py_files: List[Path], *, repo_root: Path) -> Dict[str, List[str]]:\n    \"\"\"Find action names emitted in code via emit_generic(...) — AST-level only.\n\n    Skips files whose path includes `tests/` to avoid catching fixture\n    strings / mocked event payloads. Skips files inside `_lib/audit_emit.py`\n    itself (its own dispatch table must reference all actions; not a phantom).\n\n    `repo_root` is required because we compute the relative path from the\n    *target* root (which may be a fixture root in tests), not the\n    framework root. Without this, a fixture under `…/tests/fixtures/…`\n    in the framework checkout was always filtered out as \"tests/\".\n    \"\"\"\n    out: Dict[str, List[str]] = {}\n    for f in py_files:\n        try:\n            rel = str(f.resolve().relative_to(repo_root.resolve())).replace(os.sep, \"/\")\n        except (ValueError, OSError):\n            rel = _to_repo_rel(f)\n        # Exclude tests + audit_emit.py itself\n        if \"/tests/\" in (\"/\" + rel) or rel.endswith(\"audit_emit.py\"):\n            continue\n        try:\n            source = f.read_text(encoding=\"utf-8\", errors=\"replace\")\n            tree = ast.parse(source, filename=str(f))\n        except (OSError, SyntaxError):\n            continue\n        finder = _EmitActionFinder()\n        try:\n            finder.visit(tree)\n        except Exception:\n            continue\n        for action, linenos in finder.actions.items():\n            for ln in linenos:\n                out.setdefault(action, []).append(f\"{rel}:{ln}\")\n    return out\n\n\ndef _legacy_scan_emitted_actions(py_files: List[Path]) -> Dict[str, List[str]]:\n    \"\"\"Backward-compat wrapper used in unit-tests of the original signature.\"\"\"\n    return _scan_emitted_actions(py_files, repo_root=_REPO_ROOT)\n\n\ndef detect_audit_action_phantom(\n    *,\n    repo_root: Path,\n) -> List[Dict[str, Any]]:\n    \"\"\"Detector #6.\n\n    Phantom = action emitted in code but missing from `_KNOWN_ACTIONS`\n    (silent drop precedent: Codex S76 `skill_bootstrap_used` regression).\n    \"\"\"\n    findings: List[Dict[str, Any]] = []\n    audit_emit_path = repo_root / \".claude\" / \"hooks\" / \"_lib\" / \"audit_emit.py\"\n    if not audit_emit_path.exists():\n        return findings\n\n    known = _read_known_actions(audit_emit_path)\n    py_roots = [repo_root / \".claude\" / \"scripts\", repo_root / \".claude\" / \"hooks\"]\n    py_files = _iter_python_files(py_roots, repo_root=repo_root)\n    emitted = _scan_emitted_actions(py_files, repo_root=repo_root)\n\n    # Phantom: emitted but not registered\n    phantoms = sorted(set(emitted.keys()) - known)\n    for action in phantoms:\n        first_loc = emitted[action][0]\n        finding = _build_finding(\n            detector=\"audit_action_phantom\",\n            severity=DETECTOR_REGISTRY[\"audit_action_phantom\"][\"severity\"],\n            confidence=0.99,\n            claim_source_path=first_loc,\n            expected_evidence=(\n                f\"action {action!r} present in audit_emit._KNOWN_ACTIONS\"\n            ),\n            actual_evidence=(\n                f\"emitted in {len(emitted[action])} site(s); not registered\"\n            ),\n            advisory_action=(\n                \"add action to _KNOWN_ACTIONS via KERNEL ceremony OR rename \"\n                \"the emit call site\"\n            ),\n            extra={\"action\": action, \"emit_sites\": emitted[action][:5]},\n        )\n        findings.append(finding)\n    return findings\n\n\n# ---------------------------------------------------------------------------\n# Detector #7 — estimate_drift  (PLAN-078 Wave 2)\n# ---------------------------------------------------------------------------\n#\n# On plans whose `status: done` transition fired, compares the original\n# `estimate.compute_hours` + `estimate.owner_physical_min` against the\n# observed actuals (commit time-span + GPG-signed-commit count + manual\n# override). Finding emitted when |drift_factor| ≥ 1.2 in either axis.\n#\n# Implementation discipline (Codex re-pass + plan §4.2):\n#   - SINGLE batched `git log --pretty=%H,%aI --name-only` (~1 subprocess\n#     call, NOT 1-per-plan) — see _git_log_paths().\n#   - `created` field preferred over `created_at` (PLAN-SCHEMA §2 use).\n#   - actual_owner_physical_min derived from GPG-signed commit count + an\n#     optional `actual_owner_physical_min:` plan-frontmatter override\n#     (clamped 0..10000; non-int → fail-open warn).\n#   - severity bands: low <1.5×, medium 1.5-2×, high >2×.\n#   - systematic_bias_direction: emitted ONLY in the run-summary recommend\n#     event when N≥5 plans drift same direction.\n#   - CSV append at `.claude/scripts/local/calibration-history.csv`\n#     (gitignored). Each row keyed by `<plan_id>,<run_iso8601>` so re-runs\n#     are idempotent (existing rows are NOT duplicated).\n#   - Bypass: `CEO_REALITY_LEDGER_DETECTOR_07=0`.\n#\n# Output: List of finding dicts (run_detectors aggregator handles render +\n# emit). Each finding embeds plan-level deltas in `_extra` for forensics.\n\n_PLAN_FILE_RE = re.compile(r\"^PLAN-(\\d{3,4})-.*\\.md$\")\n_HOURS_RANGE_RE = re.compile(r\"(\\d+(?:\\.\\d+)?)\\s*-\\s*(\\d+(?:\\.\\d+)?)\")\n_SINGLE_NUM_RE = re.compile(r\"\\d+(?:\\.\\d+)?\")\n_ESTIMATE_KEY_RE = re.compile(r\"^estimate:\\s*$\")\n_ESTIMATE_INDENT_RE = re.compile(r\"^\\s+(\\w+):\\s*(.+?)\\s*$\")\n_TOP_KEY_RE = re.compile(r\"^[A-Za-z_]\")\n\n\n\n__all__ = ['_read_known_actions', '_EmitActionFinder', '_scan_emitted_actions', '_legacy_scan_emitted_actions', 'detect_audit_action_phantom', '_PLAN_FILE_RE', '_HOURS_RANGE_RE', '_SINGLE_NUM_RE', '_ESTIMATE_KEY_RE', '_ESTIMATE_INDENT_RE', '_TOP_KEY_RE']\n","numLines":281,"startLine":1,"totalLines":281}},"tool_result_meta":[{"id":"toolu_014Bo67puo8vi1RQJiiqD85i","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
