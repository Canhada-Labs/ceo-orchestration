          except OSError:\n517\t                is_regular = False\n518\t            if not is_regular:\n519\t                result[\"status\"] = \"mismatch\"\n520\t                result[\"detail\"] = \"override_payload_missing\"\n521\t                return result\n522\t        else:\n523\t            payload = _resolve_codex_payload(launcher_path, rel_path, triple)\n524\t            if payload is None:\n525\t                # The launcher itself would throw \"Missing optional\n526\t                # dependency\" here — codex cannot run at all → INFRA.\n527\t                result[\"detail\"] = \"payload_not_resolved\"\n528\t                return result\n529\t        result[\"path\"] = str(payload)\n530\t\n531\t        actual = _sha256_file(payload)\n532\t        if actual is None:\n533\t            result[\"detail\"] = \"payload_unreadable\"\n534\t            return result\n535\t        result[\"sha256\"] = actual\n536\t\n537\t        if actual != expected:\n538\t            if _apply_currency_policy(payload, launcher_path, manifest, result):\n539\t                return result\n540\t            result[\"status\"] = \"mismatch\"\n541\t            result[\"detail\"] = \"payload_sha256_mismatch\"\n542\t            return result\n543\t\n544\t        result[\"status\"] = \"verified\"\n545\t        result[\"detail\"] = \"ok\"\n546\t        return result\n547\t    except Exception as e:  # defensive: kernel never raises\n548\t        result[\"status\"] = \"infra\"\n549\t        result[\"detail\"] = f\"unexpected:{type(e).__name__}\"\n550\t        return result\n551\t\n552\t\n553\tdef _apply_currency_policy(\n554\t    payload: Path, launcher: Optional[Path], manifest: Dict[str, Any], result: Dict[str, Any],\n555\t) -> bool:\n556\t    \"\"\"Record qualified version and apply only the explicitly allowed currency arm.\"\"\"\n557\t    installed = _cli_currency.qualified_package_version(payload, launcher)\n558\t    result[\"installed_version\"] = installed or \"\"\n559\t  