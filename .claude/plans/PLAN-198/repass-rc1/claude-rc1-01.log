            raise\n133\t        print(f\"[check_agent_spawn] FATAL: {type(exc).__name__}: {exc}\", file=sys.stderr)\n134\t        print(json.dumps({}))\n135\t        sys.exit(0)\n136\t\n137\t_load_spawn_part(\"model_routing\")\n138\t_load_spawn_part(\"advisories\")\n139\t_load_spawn_part(\"prompt_rules\")\n140\t\n141\t@dataclass\n142\tclass Decision:\n143\t    \"\"\"Typed result of the governance check.\"\"\"\n144\t\n145\t    allow: bool\n146\t    reason: Optional[str] = None\n147\t\n148\t    def to_json(self) -> str:\n149\t        if self.allow:\n150\t            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow\n151\t        return json.dumps(\n152\t            {\"decision\": \"block\", \"reason\": self.reason or \"\"},\n153\t            ensure_ascii=False,\n154\t        )\n155\t\n156\t\n157\t\n158\tdef _emit_cookbook_pattern_advisory(\n159\t    *,\n160\t    description: str,\n161\t    prompt: str,\n162\t    env=None,\n163\t) -> None:\n164\t    \"\"\"PLAN-092 Wave A.4 (W3.2 SEMI-11) — emit cookbook_pattern_advised\n165\t    when a spawn prompt matches one of 4 Anthropic Cookbook pattern\n166\t    trigger taxonomies (COOK-P1..P4).\n167\t\n168\t    Advisory ONLY — UX hint. NEVER blocks, NEVER mutates tool_input.\n169\t    Rate-cap via PLAN-088 global _plan088_rate_admit in audit_emit.\n170\t    Kill-switch: CEO_COOKBOOK_ADVISOR_ENABLED=0. Privacy invariant:\n171\t    3 fields max (no raw prompt persisted — AC3b).\n172\t\n173\t    Audit-emit signature mapping (PLAN-090 W3.2 canonical contract):\n174\t      pattern_id (COOK-P*)   -> top_pattern_keys\n175\t      trigger_class (string) -> task_signature (enum-constrained \"other\")\n176\t      bucket (high/med/low)  -> pattern_count (3/2/1)\n177\t\n178\t    NEVER raises.\n179\t    \"\"\"\n180\t    try:\n181\t        src_env = env if env is not None else os.environ\n182\t        if not _COOKBOOK_PATTERNS_AVAILABLE:\n183\t            return\n184\t        if not _AUDIT_EMIT_AVAILABLE:\n185\t            return\n186\t        # Kill-switch\n187\t        try:\n188\t            if hasattr(_cookbook_patterns, \"kill_switch_enabled\"):\n189\t                if not _cookbook_patterns.kill_switch_enabled():\n190\t                    return\n191\t            else:\n192\t                val = (src_env.get(\"CEO_COOKBOOK_ADVISOR_ENABLED\") or \"1\").strip()\n193\t                if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n194\t                    return\n195\t        except Exception:  # pragma: no cover\n196\t            return\n197\t        # Concat description + prompt, cap at 8KiB\n198\t        text = ((description or \"\") + \"\\n\" + (prompt or \"\"))[: 8 * 1024]\n199\t        if not text.strip():\n200\t            return\n201\t        # Match (first-hit canonical order COOK-P1 -> P4)\n202\t        try:\n203\t            result = _cookbook_patterns.match_pattern(text)\n204\t        except Exception:  # pragma: no cover\n205\t            return\n206\t        if result is None:\n207\t            return\n208\t        pattern_id, trigger_class, bucket = result\n209\t        if not hasattr(_audit_emit, \"emit_cookbook_pattern_advised\"):\n210\t            return\n211\t        # Map semantic -> canonical signature\n212\t        bucket_to_count = {\"high\": 3, \"medium\": 2, \"low\": 1}\n213\t        try:\n214\t            _audit_emit.emit_cookbook_pattern_advised(\n215\t                task_signature=\"other\",\n216\t                top_pattern_keys=str(pattern_id)[:128],\n217\t                pattern_count=bucket_to_count.get(str(bucket), 1),\n218\t            )\n219\t        except Exception:  # pragma: no cover"}]},"parent_tool_use_id":null,"session_id":"58d86da0-a33a-4fc7-a08e-6d4c6f14f756","uuid":"274835d7-fe78-4b5b-bb36-d2fe8913b7b4","timestamp":"2026-11-13T16:26:59.170Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/check_agent_spawn.py","content":"# P