 banner once per session (F-CHAOS-1).\"\"\"\n56\t    global _FALLBACK_NOTIFIED\n57\t    if _FALLBACK_NOTIFIED:\n58\t        return\n59\t    _FALLBACK_NOTIFIED = True\n60\t    try:\n61\t        sys.stderr.write(\n62\t            f\"::warning::audit-log write failed ({err}); \"\n63\t            f\"falling back to {fallback}. \"\n64\t            f\"Investigate writability of {primary.parent}.\\n\"\n65\t        )\n66\t        sys.stderr.flush()\n67\t    except Exception:  # pragma: no cover\n68\t        pass\n69\t\n70\t\n71\tdef _write_fallback(event_line: str) -> bool:\n72\t    \"\"\"Append ``event_line`` to fallback path with 0o600. Never raises.\"\"\"\n73\t    try:\n74\t        fallback = _fallback_log_path()\n75\t        fallback.parent.mkdir(parents=True, exist_ok=True)\n76\t        with fallback.open(\"a\", encoding=\"utf-8\") as f:\n77\t            f.write(event_line)\n78\t            # PLAN-025 F-obs-002 — durability on fallback path too; if the\n79\t            # primary failed and we're writing fallback, crash-safety matters\n80\t            # MORE than on the happy path."}]},"parent_tool_use_id":null,"session_id":"10e40156-2d16-43df-8172-e751d2a1e24b","uuid":"a87c0a46-de7b-4d15-b3b7-c60e7318ba4f","timestamp":"2026-11-15T09:07:04.456Z","tool_use_result":{"type":"text","file":{"filePath":".claude/hooks/_lib/_audit_emit_parts/writer.py","content":"\"\"\"Audit persistence helpers bound into the audit_emit facade.\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = (\n    \"_FALLBACK_NOTIFIED\",\n    \"_fallback_log_path\",\n    \"_emit_fallback_banner_once\",\n    \"_write_fallback\",\n    \"_safe_target_ref_hash_field\",\n    \"_accel_clamp_count\",\n    \"_auto_compact_clamp_pct\",\n    \"_e3_clamp01\",\n    \"_e3_safe_path_hashes\",\n    \"_safe_token_sha_field\",\n    \"_federation_safe_path_hash\",\n    \"_audit_dir\",\n    \"_log_path\",\n    \"_log_family_dir\",\n    \"_lock_path\",\n    \"_errors_path\",\n    \"_utc_now_iso\",\n    \"_breadcrumb\",\n