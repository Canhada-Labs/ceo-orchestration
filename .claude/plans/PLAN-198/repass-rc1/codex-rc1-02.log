+_PERSISTENT_INSTRUCTIONS_BLOCKED_ALLOWLIST = frozenset({
+    "action", "session_id", "project",
+    "reason", "family_hits", "bytes_scanned",
+    # _write_event envelope (pre-allowed so scrub doesn't strip on round-trip):
+    "ts", "event_schema",
