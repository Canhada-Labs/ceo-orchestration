+# compact / fail upstream. Carries the closed reason + bucketed counts + rung.
+_CONTEXT_MIDDLE_OUT_DEGRADE_FAILED_ALLOWLIST = frozenset(_OPTIMIZER_ENVELOPE + (
+    "reason", "rung", "degraded_count", "total_count", "protect_last",
