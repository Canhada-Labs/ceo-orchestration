{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NqJv7B1bTn42HkKZue","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01BUK5W4ebvqjtbg2qmbMURn","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/labeling.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":18661,"cache_read_input_tokens":118430,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":18661},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"2d195c18-e3e7-43b9-8945-4ba35eb497a7","timestamp":"2026-11-13T18:10:53.224Z","request_id":"req_011Ch1NqJfyzYWcEtGuF9shL","wire_tool_inputs":{"toolu_01BUK5W4ebvqjtbg2qmbMURn":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/labeling.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BUK5W4ebvqjtbg2qmbMURn","type":"tool_result","content":"1\t\"\"\"labeling audit-query declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport csv\n7\timport io\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\tfrom collections import Counter, defaultdict\n13\tfrom datetime import datetime, timedelta, timezone\n14\tfrom pathlib import Path\n15\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n16\t\n17\t__all__ = ('_LABEL_STORE_PATH', '_LABEL_VALID_CASES', '_LABEL_VALID_LABELS', '_label_store_path', '_canonical_json_for_chain', '_compute_label_hmac', '_load_label_records', '_append_label_record', 'cmd_label', '_wilson_bounds', 'cmd_fp_rate', 'cmd_case_summary', 'cmd_codex_writeguard_summary')\n18\t\n19\t_LABEL_STORE_PATH = (\n20\t    Path(__file__).resolve().parent / \"audit-log-labels.jsonl\"\n21\t)\n22\t# ADR-108 §Operational labeling protocol: Owner labels Case-B verdicts with\n23\t# fp (false-positive — Codex was wrong; close as advisory), tp (true-positive\n24\t# — block stands), or triage_pending (extends grace by 24h; max 1 extension\n25\t# before mechanical close-as-advisory). retracted is added for explicit Owner\n26\t# revocation of a prior label (creates a new chain entry that supersedes).\n27\t_LABEL_VALID_CASES = frozenset([\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"])\n28\t_LABEL_VALID_LABELS = frozenset([\"fp\", \"tp\", \"triage_pending\", \"retracted\"])\n29\t\n30\t\n31\tdef _label_store_path() -> Path:\n32\t    \"\"\"Return the labels jsonl path; env override for tests.\"\"\"\n33\t    override = os.environ.get(\"CEO_PAIR_RAIL_LABEL_STORE_PATH\")\n34\t    return Path(override) if override else _LABEL_STORE_PATH\n35\t\n36\t\n37\tdef _canonical_json_for_chain(record: Dict[str, Any]) -> str:\n38\t    \"\"\"Canonical JSON for HMAC chain — sort keys + no whitespace + UTF-8.\"\"\"\n39\t    return json.dumps(record, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True)\n40\t\n41\t\n42\tdef _compute_label_hmac(prev_hmac_hex: str, record: Dict[str, Any]) -> str:\n43\t    \"\"\"Compute HMAC-SHA256 over (prev_hmac || canonical_record) using\n44\t    the same key as `audit_hmac.get_or_create_key()`. Each record's\n45\t    `hmac` field links to the previous record's hmac forming a chain.\n46\t\n47\t    Hexlified output for jsonl-friendly storage.\n48\t    \"\"\"\n49\t    import hmac as _hmac\n50\t    import hashlib as _hashlib\n51\t    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"hooks\" / \"_lib\"))\n52\t    try:\n53\t        import audit_hmac  # type: ignore\n54\t        key = audit_hmac.get_or_create_key()\n55\t    except Exception:\n56\t        # Fallback: deterministic per-project SHA-256 chain when key infra\n57\t        # unavailable (e.g. fresh adopter clone). This still provides\n58\t        # tamper-evidence (mutating an old record breaks subsequent chain\n59\t        # verification) but is not authenticated against an external key.\n60\t        key = b\"ceo-pair-rail-label-chain-fallback-key-v1\"\n61\t    msg = (prev_hmac_hex + _canonical_json_for_chain(record)).encode(\"utf-8\")\n62\t    return _hmac.new(key, msg, _hashlib.sha256).hexdigest()\n63\t\n64\t\n65\tdef _load_label_records() -> List[Dict[str, Any]]:\n66\t    \"\"\"Read label jsonl + verify HMAC chain. Returns list of records or [].\n67\t\n68\t    On HMAC mismatch, raises ValueError with the offending record index.\n69\t    \"\"\"\n70\t    p = _label_store_path()\n71\t    if not p.exists():\n72\t        return []\n73\t    records: List[Dict[str, Any]] = []\n74\t    prev_hmac = \"\"  # genesis\n75\t    with p.open(\"r\", encoding=\"utf-8\") as fh:\n76\t        for idx, line in enumerate(fh):\n77\t            line = line.strip()\n78\t            if not line:\n79\t                continue\n80\t            try:\n81\t                rec = json.loads(line)\n82\t            except json.JSONDecodeError as e:\n83\t                raise ValueError(\n84\t                    f\"audit-log-labels.jsonl record {idx}: invalid JSON: {e}\"\n85\t                ) from e\n86\t            stored_hmac = rec.pop(\"hmac\", \"\")\n87\t            record_for_compute = dict(rec)\n88\t            expected_hmac = _compute_label_hmac(prev_hmac, record_for_compute)\n89\t            if stored_hmac != expected_hmac:\n90\t                raise ValueError(\n91\t                    f\"audit-log-labels.jsonl record {idx}: HMAC chain broken \"\n92\t                    f\"(stored={stored_hmac[:16]}, computed={expected_hmac[:16]})\"\n93\t                )\n94\t            rec[\"hmac\"] = stored_hmac\n95\t            records.append(rec)\n96\t            prev_hmac = stored_hmac\n97\t    return records\n98\t\n99\t\n100\tdef _append_label_record(record: Dict[str, Any]) -> str:\n101\t    \"\"\"Append a record to label store with HMAC chain link. Returns the new HMAC.\"\"\"\n102\t    p = _label_store_path()\n103\t    p.parent.mkdir(parents=True, exist_ok=True)\n104\t    records = _load_label_records()\n105\t    prev_hmac = records[-1][\"hmac\"] if records else \"\"\n106\t    new_hmac = _compute_label_hmac(prev_hmac, record)\n107\t    full_record = dict(record)\n108\t    full_record[\"hmac\"] = new_hmac\n109\t    with p.open(\"a\", encoding=\"utf-8\") as fh:\n110\t        fh.write(_canonical_json_for_chain(full_record) + \"\\n\")\n111\t    return new_hmac\n112\t\n113\t\n114\tdef cmd_label(entries, args) -> Dict[str, Any]:\n115\t    \"\"\"Owner labels a pair_rail_case event post-hoc. PLAN-081 Phase 6-bis.\n116\t\n117\t    Append-only via HMAC chain to `.claude/scripts/audit-log-labels.jsonl`.\n118\t    The Owner labels Case B (Claude PASS + Codex BLOCK) verdicts per\n119\t    ADR-108 §Owner labeling protocol with one of:\n120\t\n121\t    - fp (false-positive — Codex was wrong; close as advisory)\n122\t    - tp (true-positive — block stands)\n123\t    - triage_pending (extends grace by 24h; max 1 extension before\n124\t      mechanical close-as-advisory)\n125\t    - retracted (creates new chain entry that supersedes the latest\n126\t      prior label for the same run_id; if retracted is the most-recent\n127\t      entry, the event reverts to unlabeled status in fp-rate computations)\n128\t\n129\t    fp-rate aggregator (cmd_fp_rate) denominator behavior: case_b_total\n130\t    ALWAYS includes every Case-B event in the window. The numerator\n131\t    counts only `fp` labels for the lower bound; unlabeled +\n132\t    triage_pending count as worst-case FP for the upper bound. See\n133\t    cmd_fp_rate docstring for the Wilson 95% bounds details.\n134\t    \"\"\"\n135\t    run_id = getattr(args, \"run_id\", None)\n136\t    case = getattr(args, \"case\", None)\n137\t    label = getattr(args, \"label\", None)\n138\t    note = getattr(args, \"note\", \"\") or \"\"\n139\t\n140\t    if not run_id:\n141\t        return {\"verdict\": \"ERROR\", \"reason\": \"--run-id required\"}\n142\t    if case not in _LABEL_VALID_CASES:\n143\t        return {\n144\t            \"verdict\": \"ERROR\",\n145\t            \"reason\": f\"--case must be one of {sorted(_LABEL_VALID_CASES)}, got {case!r}\",\n146\t        }\n147\t    if label not in _LABEL_VALID_LABELS:\n148\t        return {\n149\t            \"verdict\": \"ERROR\",\n150\t            \"reason\": f\"--label must be one of {sorted(_LABEL_VALID_LABELS)}, got {label!r}\",\n151\t        }\n152\t\n153\t    ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n154\t    record = {\n155\t        \"ts\": ts,\n156\t        \"run_id\": run_id,\n157\t        \"case\": case,\n158\t        \"label\": label,\n159\t        \"note_bucket\": \"empty\" if not note else (\n160\t            \"short\" if len(note) <= 50 else \"medium\" if len(note) <= 200 else \"long\"\n161\t        ),\n162\t    }\n163\t    new_hmac = _append_label_record(record)\n164\t    return {\n165\t        \"verdict\": \"OK\",\n166\t        \"run_id\": run_id,\n167\t        \"case\": case,\n168\t        \"label\": label,\n169\t        \"ts\": ts,\n170\t        \"hmac_prefix\": new_hmac[:16],\n171\t    }\n172\t\n173\t\n174\tdef _wilson_bounds(successes: int, n: int, z: float = 1.96) -> Tuple[float, float]:\n175\t    \"\"\"95% Wilson score interval for binomial proportion (ADR-108 §FP-rate).\n176\t\n177\t    More accurate than naive (p ± z·sqrt(p(1-p)/n)) at small n or\n178\t    extreme p. Returns (lower, upper) ∈ [0, 1].\n179\t    \"\"\"\n180\t    if n <= 0:\n181\t        return 0.0, 0.0\n182\t    p = successes / n\n183\t    z2 = z * z\n184\t    denom = 1.0 + z2 / n\n185\t    center = (p + z2 / (2.0 * n)) / denom\n186\t    half_width = (z * ((p * (1.0 - p) + z2 / (4.0 * n)) / n) ** 0.5) / denom\n187\t    lo = max(0.0, center - half_width)\n188\t    hi = min(1.0, center + half_width)\n189\t    return lo, hi\n190\t\n191\t\n192\tdef cmd_fp_rate(entries, args) -> Dict[str, Any]:\n193\t    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE-3 + ADR-108 §FP-rate): Case-B\n194\t    false-positive rate aggregator with 95% Wilson score interval.\n195\t\n196\t    The Wilson interval provides robust lower/upper bounds at small n or\n197\t    extreme proportions, which a simple Laplace bound underestimates. Per\n198\t    ADR-108 §FP-rate, the reopen criterion fires when fp_rate_30d > 30%\n199\t    via `disable_predicate_eval.py` `fp_rate_30d_above_30pct` predicate.\n200\t\n201\t    Labels per ADR-108 §Owner labeling protocol:\n202\t    - `fp` = labeled false-positive — counted in numerator + denominator\n203\t    - `tp` = labeled true-positive — counted in denominator (not in fp num)\n204\t    - `triage_pending` = grace extended — counted in denominator (still\n205\t      provisional; treated as labeled-pending for Wilson computation)\n206\t    - `retracted` = supersedes prior label — most-recent non-retracted\n207\t      label wins; if retracted is the latest entry for a run_id, the\n208\t      event reverts to unlabeled\n209\t    The denominator (case_b_total) ALWAYS includes every Case-B event in\n210\t    the window — labeled or not. Wilson upper bound treats unlabeled +\n211\t    triage_pending as worst-case FP.\n212\t\n213\t    Window selection via --window-days (default 30).\n214\t    \"\"\"\n215\t    window_days = getattr(args, \"window_days\", None)\n216\t    if window_days is None:\n217\t        window_days = 30  # default 30-day window per ADR-108 §FP-rate\n218\t\n219\t    now = datetime.now(timezone.utc)\n220\t    cutoff = now - timedelta(days=window_days)\n221\t    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n222\t\n223\t    # Filter pair_rail_case events in window — only Case B (asymmetric case)\n224\t    case_b_total = 0\n225\t    case_b_run_ids: List[str] = []\n226\t    for e in entries:\n227\t        if e.get(\"action\") != \"pair_rail_case\":\n228\t            continue\n229\t        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n230\t            continue\n231\t        if e.get(\"case\") != \"B\":\n232\t            continue\n233\t        case_b_total += 1\n234\t        rid = str(e.get(\"run_id\") or e.get(\"pair_rail_run_id\") or \"\")\n235\t        if rid:\n236\t            case_b_run_ids.append(rid)\n237\t\n238\t    # Load labels + match by run_id (latest label wins per run_id; retracted\n239\t    # entries supersede prior labels)\n240\t    try:\n241\t        labels = _load_label_records()\n242\t    except ValueError as exc:\n243\t        return {\"verdict\": \"ERROR\", \"reason\": str(exc)}\n244\t\n245\t    label_index: Dict[str, str] = {}  # run_id → most-recent non-retracted label\n246\t    for r in labels:\n247\t        if r.get(\"case\") != \"B\":\n248\t            continue\n249\t        rid = str(r.get(\"run_id\", \"\"))\n250\t        lab = str(r.get(\"label\", \"\"))\n251\t        if lab == \"retracted\":\n252\t            label_index.pop(rid, None)\n253\t        else:\n254\t            label_index[rid] = lab\n255\t\n256\t    labeled_fp = 0\n257\t    labeled_tp = 0\n258\t    labeled_triage = 0\n259\t    unlabeled = 0\n260\t    for rid in case_b_run_ids:\n261\t        lab = label_index.get(rid)\n262\t        if lab == \"fp\":\n263\t            labeled_fp += 1\n264\t        elif lab == \"tp\":\n265\t            labeled_tp += 1\n266\t        elif lab == \"triage_pending\":\n267\t            labeled_triage += 1\n268\t        else:\n269\t            unlabeled += 1\n270\t\n271\t    # Wilson 95% bounds: numerator = labeled_fp, denominator = case_b_total\n272\t    # Upper bound assumes both unlabeled AND triage_pending are worst-case\n273\t    # FP per ADR-108 §FP-rate + cmd_label/cmd_fp_rate docstring contract\n274\t    # (Codex iter-6 P2 fix — implementation now matches docstring).\n275\t    fp_lo, _ = _wilson_bounds(labeled_fp, case_b_total)\n276\t    worst_case_fp = labeled_fp + unlabeled + labeled_triage\n277\t    _, fp_hi_via_worst = _wilson_bounds(worst_case_fp, case_b_total)\n278\t    fp_hi = fp_hi_via_worst\n279\t\n280\t    # Reopen threshold per ADR-108 §FP-rate (default 0.30 — the 30% bar that\n281\t    # triggers `fp_rate_30d_above_30pct` predicate in disable_predicate_eval.py)\n282\t    threshold = float(getattr(args, \"reopen_threshold\", None) or 0.30)\n283\t    trigger_reopen = fp_lo > threshold\n284\t\n285\t    return {\n286\t        \"window_days\": window_days,\n287\t        \"window_start\": cutoff_iso,\n288\t        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n289\t        \"case_b_total\": case_b_total,\n290\t        \"case_b_labeled_fp\": labeled_fp,\n291\t        \"case_b_labeled_tp\": labeled_tp,\n292\t        \"case_b_labeled_triage\": labeled_triage,\n293\t        \"case_b_unlabeled\": unlabeled,\n294\t        \"fp_rate_lower_bound\": round(fp_lo, 4),\n295\t        \"fp_rate_upper_bound\": round(fp_hi, 4),\n296\t        \"wilson_z\": 1.96,\n297\t        \"reopen_threshold\": threshold,\n298\t        \"trigger_reopen\": trigger_reopen,\n299\t        \"predicate_ref\": \"fp_rate_30d_above_30pct\",\n300\t    }\n301\t\n302\t\n303\tdef cmd_case_summary(entries, args) -> Dict[str, Any]:\n304\t    \"\"\"PLAN-081 Phase 6-bis (ADR-108 §Operational): Cases A-F distribution.\n305\t\n306\t    Aggregates `pair_rail_case` audit events over the window and returns\n307\t    counts + percentages for each Case (A=both PASS, B=Claude PASS+Codex\n308\t    BLOCK, C=Claude BLOCK+Codex PASS, D=both BLOCK, E=Jaccard divergence,\n309\t    F=Codex outage). Operators use this to monitor healthy distribution\n310\t    per ADR-108 §Operational (Case A typically 70-85%; Case F < 2%).\n311\t    \"\"\"\n312\t    window_days = getattr(args, \"window_days\", None)\n313\t    if window_days is None:\n314\t        window_days = 7  # default 7-day window (faster operational signal)\n315\t\n316\t    now = datetime.now(timezone.utc)\n317\t    cutoff = now - timedelta(days=window_days)\n318\t    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n319\t\n320\t    per_case: Dict[str, int] = {\"A\": 0, \"B\": 0, \"C\": 0, \"D\": 0, \"E\": 0, \"F\": 0}\n321\t    unknown_case = 0\n322\t    precondition_met_count = 0\n323\t    precondition_not_met_count = 0  # Case B'\n324\t    for e in entries:\n325\t        if e.get(\"action\") != \"pair_rail_case\":\n326\t            continue\n327\t        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n328\t            continue\n329\t        case = str(e.get(\"case\") or \"\")\n330\t        if case in per_case:\n331\t            per_case[case] += 1\n332\t            if case == \"B\":\n333\t                pm = e.get(\"precondition_met\")\n334\t                if pm is True or pm == \"true\":\n335\t                    precondition_met_count += 1\n336\t                elif pm is False or pm == \"false\":\n337\t                    precondition_not_met_count += 1\n338\t        else:\n339\t            unknown_case += 1\n340\t\n341\t    total = sum(per_case.values()) + unknown_case\n342\t    per_case_pct = {\n343\t        k: round(v / total * 100.0, 2) if total else 0.0\n344\t        for k, v in per_case.items()\n345\t    }\n346\t\n347\t    # Healthy distribution sentinels per ADR-108 §Operational\n348\t    healthy_ranges = {\n349\t        \"A\": (70.0, 85.0),\n350\t        \"B\": (1.0, 8.0),\n351\t        \"C\": (2.0, 10.0),\n352\t        \"D\": (1.0, 5.0),\n353\t        \"E\": (1.0, 5.0),\n354\t        \"F\": (0.0, 2.0),\n355\t    }\n356\t    health = {}\n357\t    for k, pct in per_case_pct.items():\n358\t        lo, hi = healthy_ranges[k]\n359\t        if total == 0:\n360\t            health[k] = \"NO_DATA\"\n361\t        elif lo <= pct <= hi:\n362\t            health[k] = \"OK\"\n363\t        elif pct < lo:\n364\t            health[k] = \"LOW\"\n365\t        else:\n366\t            health[k] = \"HIGH\"\n367\t\n368\t    return {\n369\t        \"window_days\": window_days,\n370\t        \"window_start\": cutoff_iso,\n371\t        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n372\t        \"total_pair_rail_case_events\": total,\n373\t        \"case_counts\": per_case,\n374\t        \"case_percentages\": per_case_pct,\n375\t        \"unknown_case_count\": unknown_case,\n376\t        \"case_b_precondition_met\": precondition_met_count,\n377\t        \"case_b_precondition_not_met\": precondition_not_met_count,\n378\t        \"health_per_case\": health,\n379\t    }\n380\t\n381\t\n382\tdef cmd_codex_writeguard_summary(entries, args) -> Dict[str, Any]:\n383\t    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE Q2): Codex codando deny-list hit summary.\n384\t\n385\t    Aggregates `pair_rail_codex_denylist_hit` audit events by target_path\n386\t    bucket. Surfaces top-attempted forbidden paths so operators can detect\n387\t    deny-list coverage gaps.\n388\t    \"\"\"\n389\t    window_days = getattr(args, \"window_days\", None)\n390\t    if window_days is None:\n391\t        window_days = 30\n392\t\n393\t    now = datetime.now(timezone.utc)\n394\t    cutoff = now - timedelta(days=window_days)\n395\t    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n396\t\n397\t    per_path: Dict[str, int] = {}\n398\t    total_hits = 0\n399\t    for e in entries:\n400\t        if e.get(\"action\") != \"pair_rail_codex_denylist_hit\":\n401\t            continue\n402\t        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n403\t            continue\n404\t        path = str(e.get(\"target_path_bucket\") or e.get(\"target_path\") or \"unknown\")\n405\t        per_path[path] = per_path.get(path, 0) + 1\n406\t        total_hits += 1\n407\t\n408\t    top_n = int(getattr(args, \"top\", None) or 10)\n409\t    top_paths = sorted(per_path.items(), key=lambda kv: (-kv[1], kv[0]))[:top_n]\n410\t\n411\t    return {\n412\t        \"window_days\": window_days,\n413\t        \"window_start\": cutoff_iso,\n414\t        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n415\t        \"total_hits\": total_hits,\n416\t        \"unique_paths\": len(per_path),\n417\t        \"top_paths\": [{\"path_bucket\": p, \"hits\": c} for p, c in top_paths],\n418\t    }\n419\t\n420\t\n421\t# ---------------------------------------------------------------------------\n422\t# PLAN-113 Phase B, Wave W1 — critical-security-action reader (audit-reader\n423\t# coverage). These 38 actions are emitted by hooks but had NO reader handler\n424\t# in this CLI, so an operator could not surface them (PLAN-112 finding class\n425\t# \"Critical action has no reader handler\"). cmd_critical reads the registry\n426\t# below and surfaces, per action, count + first/last timestamp + a compact\n427\t# set of SAFE summary fields ALREADY PRESENT on the event (never invented).\n428\t# Actions with ZERO occurrences are still listed (count=0) so a\n429\t# missing-but-expected critical event is visible — surfacing ABSENCE is the\n430\t# whole point.\n431\t# ---------------------------------------------------------------------------\n432\t"}]},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"1f9aa9f7-ea49-4b86-81a4-e1055cb64cd1","timestamp":"2026-11-13T18:10:53.240Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/labeling.py","content":"\"\"\"labeling audit-query declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport io\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n\n__all__ = ('_LABEL_STORE_PATH', '_LABEL_VALID_CASES', '_LABEL_VALID_LABELS', '_label_store_path', '_canonical_json_for_chain', '_compute_label_hmac', '_load_label_records', '_append_label_record', 'cmd_label', '_wilson_bounds', 'cmd_fp_rate', 'cmd_case_summary', 'cmd_codex_writeguard_summary')\n\n_LABEL_STORE_PATH = (\n    Path(__file__).resolve().parent / \"audit-log-labels.jsonl\"\n)\n# ADR-108 §Operational labeling protocol: Owner labels Case-B verdicts with\n# fp (false-positive — Codex was wrong; close as advisory), tp (true-positive\n# — block stands), or triage_pending (extends grace by 24h; max 1 extension\n# before mechanical close-as-advisory). retracted is added for explicit Owner\n# revocation of a prior label (creates a new chain entry that supersedes).\n_LABEL_VALID_CASES = frozenset([\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"])\n_LABEL_VALID_LABELS = frozenset([\"fp\", \"tp\", \"triage_pending\", \"retracted\"])\n\n\ndef _label_store_path() -> Path:\n    \"\"\"Return the labels jsonl path; env override for tests.\"\"\"\n    override = os.environ.get(\"CEO_PAIR_RAIL_LABEL_STORE_PATH\")\n    return Path(override) if override else _LABEL_STORE_PATH\n\n\ndef _canonical_json_for_chain(record: Dict[str, Any]) -> str:\n    \"\"\"Canonical JSON for HMAC chain — sort keys + no whitespace + UTF-8.\"\"\"\n    return json.dumps(record, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True)\n\n\ndef _compute_label_hmac(prev_hmac_hex: str, record: Dict[str, Any]) -> str:\n    \"\"\"Compute HMAC-SHA256 over (prev_hmac || canonical_record) using\n    the same key as `audit_hmac.get_or_create_key()`. Each record's\n    `hmac` field links to the previous record's hmac forming a chain.\n\n    Hexlified output for jsonl-friendly storage.\n    \"\"\"\n    import hmac as _hmac\n    import hashlib as _hashlib\n    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"hooks\" / \"_lib\"))\n    try:\n        import audit_hmac  # type: ignore\n        key = audit_hmac.get_or_create_key()\n    except Exception:\n        # Fallback: deterministic per-project SHA-256 chain when key infra\n        # unavailable (e.g. fresh adopter clone). This still provides\n        # tamper-evidence (mutating an old record breaks subsequent chain\n        # verification) but is not authenticated against an external key.\n        key = b\"ceo-pair-rail-label-chain-fallback-key-v1\"\n    msg = (prev_hmac_hex + _canonical_json_for_chain(record)).encode(\"utf-8\")\n    return _hmac.new(key, msg, _hashlib.sha256).hexdigest()\n\n\ndef _load_label_records() -> List[Dict[str, Any]]:\n    \"\"\"Read label jsonl + verify HMAC chain. Returns list of records or [].\n\n    On HMAC mismatch, raises ValueError with the offending record index.\n    \"\"\"\n    p = _label_store_path()\n    if not p.exists():\n        return []\n    records: List[Dict[str, Any]] = []\n    prev_hmac = \"\"  # genesis\n    with p.open(\"r\", encoding=\"utf-8\") as fh:\n        for idx, line in enumerate(fh):\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                rec = json.loads(line)\n            except json.JSONDecodeError as e:\n                raise ValueError(\n                    f\"audit-log-labels.jsonl record {idx}: invalid JSON: {e}\"\n                ) from e\n            stored_hmac = rec.pop(\"hmac\", \"\")\n            record_for_compute = dict(rec)\n            expected_hmac = _compute_label_hmac(prev_hmac, record_for_compute)\n            if stored_hmac != expected_hmac:\n                raise ValueError(\n                    f\"audit-log-labels.jsonl record {idx}: HMAC chain broken \"\n                    f\"(stored={stored_hmac[:16]}, computed={expected_hmac[:16]})\"\n                )\n            rec[\"hmac\"] = stored_hmac\n            records.append(rec)\n            prev_hmac = stored_hmac\n    return records\n\n\ndef _append_label_record(record: Dict[str, Any]) -> str:\n    \"\"\"Append a record to label store with HMAC chain link. Returns the new HMAC.\"\"\"\n    p = _label_store_path()\n    p.parent.mkdir(parents=True, exist_ok=True)\n    records = _load_label_records()\n    prev_hmac = records[-1][\"hmac\"] if records else \"\"\n    new_hmac = _compute_label_hmac(prev_hmac, record)\n    full_record = dict(record)\n    full_record[\"hmac\"] = new_hmac\n    with p.open(\"a\", encoding=\"utf-8\") as fh:\n        fh.write(_canonical_json_for_chain(full_record) + \"\\n\")\n    return new_hmac\n\n\ndef cmd_label(entries, args) -> Dict[str, Any]:\n    \"\"\"Owner labels a pair_rail_case event post-hoc. PLAN-081 Phase 6-bis.\n\n    Append-only via HMAC chain to `.claude/scripts/audit-log-labels.jsonl`.\n    The Owner labels Case B (Claude PASS + Codex BLOCK) verdicts per\n    ADR-108 §Owner labeling protocol with one of:\n\n    - fp (false-positive — Codex was wrong; close as advisory)\n    - tp (true-positive — block stands)\n    - triage_pending (extends grace by 24h; max 1 extension before\n      mechanical close-as-advisory)\n    - retracted (creates new chain entry that supersedes the latest\n      prior label for the same run_id; if retracted is the most-recent\n      entry, the event reverts to unlabeled status in fp-rate computations)\n\n    fp-rate aggregator (cmd_fp_rate) denominator behavior: case_b_total\n    ALWAYS includes every Case-B event in the window. The numerator\n    counts only `fp` labels for the lower bound; unlabeled +\n    triage_pending count as worst-case FP for the upper bound. See\n    cmd_fp_rate docstring for the Wilson 95% bounds details.\n    \"\"\"\n    run_id = getattr(args, \"run_id\", None)\n    case = getattr(args, \"case\", None)\n    label = getattr(args, \"label\", None)\n    note = getattr(args, \"note\", \"\") or \"\"\n\n    if not run_id:\n        return {\"verdict\": \"ERROR\", \"reason\": \"--run-id required\"}\n    if case not in _LABEL_VALID_CASES:\n        return {\n            \"verdict\": \"ERROR\",\n            \"reason\": f\"--case must be one of {sorted(_LABEL_VALID_CASES)}, got {case!r}\",\n        }\n    if label not in _LABEL_VALID_LABELS:\n        return {\n            \"verdict\": \"ERROR\",\n            \"reason\": f\"--label must be one of {sorted(_LABEL_VALID_LABELS)}, got {label!r}\",\n        }\n\n    ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    record = {\n        \"ts\": ts,\n        \"run_id\": run_id,\n        \"case\": case,\n        \"label\": label,\n        \"note_bucket\": \"empty\" if not note else (\n            \"short\" if len(note) <= 50 else \"medium\" if len(note) <= 200 else \"long\"\n        ),\n    }\n    new_hmac = _append_label_record(record)\n    return {\n        \"verdict\": \"OK\",\n        \"run_id\": run_id,\n        \"case\": case,\n        \"label\": label,\n        \"ts\": ts,\n        \"hmac_prefix\": new_hmac[:16],\n    }\n\n\ndef _wilson_bounds(successes: int, n: int, z: float = 1.96) -> Tuple[float, float]:\n    \"\"\"95% Wilson score interval for binomial proportion (ADR-108 §FP-rate).\n\n    More accurate than naive (p ± z·sqrt(p(1-p)/n)) at small n or\n    extreme p. Returns (lower, upper) ∈ [0, 1].\n    \"\"\"\n    if n <= 0:\n        return 0.0, 0.0\n    p = successes / n\n    z2 = z * z\n    denom = 1.0 + z2 / n\n    center = (p + z2 / (2.0 * n)) / denom\n    half_width = (z * ((p * (1.0 - p) + z2 / (4.0 * n)) / n) ** 0.5) / denom\n    lo = max(0.0, center - half_width)\n    hi = min(1.0, center + half_width)\n    return lo, hi\n\n\ndef cmd_fp_rate(entries, args) -> Dict[str, Any]:\n    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE-3 + ADR-108 §FP-rate): Case-B\n    false-positive rate aggregator with 95% Wilson score interval.\n\n    The Wilson interval provides robust lower/upper bounds at small n or\n    extreme proportions, which a simple Laplace bound underestimates. Per\n    ADR-108 §FP-rate, the reopen criterion fires when fp_rate_30d > 30%\n    via `disable_predicate_eval.py` `fp_rate_30d_above_30pct` predicate.\n\n    Labels per ADR-108 §Owner labeling protocol:\n    - `fp` = labeled false-positive — counted in numerator + denominator\n    - `tp` = labeled true-positive — counted in denominator (not in fp num)\n    - `triage_pending` = grace extended — counted in denominator (still\n      provisional; treated as labeled-pending for Wilson computation)\n    - `retracted` = supersedes prior label — most-recent non-retracted\n      label wins; if retracted is the latest entry for a run_id, the\n      event reverts to unlabeled\n    The denominator (case_b_total) ALWAYS includes every Case-B event in\n    the window — labeled or not. Wilson upper bound treats unlabeled +\n    triage_pending as worst-case FP.\n\n    Window selection via --window-days (default 30).\n    \"\"\"\n    window_days = getattr(args, \"window_days\", None)\n    if window_days is None:\n        window_days = 30  # default 30-day window per ADR-108 §FP-rate\n\n    now = datetime.now(timezone.utc)\n    cutoff = now - timedelta(days=window_days)\n    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    # Filter pair_rail_case events in window — only Case B (asymmetric case)\n    case_b_total = 0\n    case_b_run_ids: List[str] = []\n    for e in entries:\n        if e.get(\"action\") != \"pair_rail_case\":\n            continue\n        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n            continue\n        if e.get(\"case\") != \"B\":\n            continue\n        case_b_total += 1\n        rid = str(e.get(\"run_id\") or e.get(\"pair_rail_run_id\") or \"\")\n        if rid:\n            case_b_run_ids.append(rid)\n\n    # Load labels + match by run_id (latest label wins per run_id; retracted\n    # entries supersede prior labels)\n    try:\n        labels = _load_label_records()\n    except ValueError as exc:\n        return {\"verdict\": \"ERROR\", \"reason\": str(exc)}\n\n    label_index: Dict[str, str] = {}  # run_id → most-recent non-retracted label\n    for r in labels:\n        if r.get(\"case\") != \"B\":\n            continue\n        rid = str(r.get(\"run_id\", \"\"))\n        lab = str(r.get(\"label\", \"\"))\n        if lab == \"retracted\":\n            label_index.pop(rid, None)\n        else:\n            label_index[rid] = lab\n\n    labeled_fp = 0\n    labeled_tp = 0\n    labeled_triage = 0\n    unlabeled = 0\n    for rid in case_b_run_ids:\n        lab = label_index.get(rid)\n        if lab == \"fp\":\n            labeled_fp += 1\n        elif lab == \"tp\":\n            labeled_tp += 1\n        elif lab == \"triage_pending\":\n            labeled_triage += 1\n        else:\n            unlabeled += 1\n\n    # Wilson 95% bounds: numerator = labeled_fp, denominator = case_b_total\n    # Upper bound assumes both unlabeled AND triage_pending are worst-case\n    # FP per ADR-108 §FP-rate + cmd_label/cmd_fp_rate docstring contract\n    # (Codex iter-6 P2 fix — implementation now matches docstring).\n    fp_lo, _ = _wilson_bounds(labeled_fp, case_b_total)\n    worst_case_fp = labeled_fp + unlabeled + labeled_triage\n    _, fp_hi_via_worst = _wilson_bounds(worst_case_fp, case_b_total)\n    fp_hi = fp_hi_via_worst\n\n    # Reopen threshold per ADR-108 §FP-rate (default 0.30 — the 30% bar that\n    # triggers `fp_rate_30d_above_30pct` predicate in disable_predicate_eval.py)\n    threshold = float(getattr(args, \"reopen_threshold\", None) or 0.30)\n    trigger_reopen = fp_lo > threshold\n\n    return {\n        \"window_days\": window_days,\n        \"window_start\": cutoff_iso,\n        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"case_b_total\": case_b_total,\n        \"case_b_labeled_fp\": labeled_fp,\n        \"case_b_labeled_tp\": labeled_tp,\n        \"case_b_labeled_triage\": labeled_triage,\n        \"case_b_unlabeled\": unlabeled,\n        \"fp_rate_lower_bound\": round(fp_lo, 4),\n        \"fp_rate_upper_bound\": round(fp_hi, 4),\n        \"wilson_z\": 1.96,\n        \"reopen_threshold\": threshold,\n        \"trigger_reopen\": trigger_reopen,\n        \"predicate_ref\": \"fp_rate_30d_above_30pct\",\n    }\n\n\ndef cmd_case_summary(entries, args) -> Dict[str, Any]:\n    \"\"\"PLAN-081 Phase 6-bis (ADR-108 §Operational): Cases A-F distribution.\n\n    Aggregates `pair_rail_case` audit events over the window and returns\n    counts + percentages for each Case (A=both PASS, B=Claude PASS+Codex\n    BLOCK, C=Claude BLOCK+Codex PASS, D=both BLOCK, E=Jaccard divergence,\n    F=Codex outage). Operators use this to monitor healthy distribution\n    per ADR-108 §Operational (Case A typically 70-85%; Case F < 2%).\n    \"\"\"\n    window_days = getattr(args, \"window_days\", None)\n    if window_days is None:\n        window_days = 7  # default 7-day window (faster operational signal)\n\n    now = datetime.now(timezone.utc)\n    cutoff = now - timedelta(days=window_days)\n    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    per_case: Dict[str, int] = {\"A\": 0, \"B\": 0, \"C\": 0, \"D\": 0, \"E\": 0, \"F\": 0}\n    unknown_case = 0\n    precondition_met_count = 0\n    precondition_not_met_count = 0  # Case B'\n    for e in entries:\n        if e.get(\"action\") != \"pair_rail_case\":\n            continue\n        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n            continue\n        case = str(e.get(\"case\") or \"\")\n        if case in per_case:\n            per_case[case] += 1\n            if case == \"B\":\n                pm = e.get(\"precondition_met\")\n                if pm is True or pm == \"true\":\n                    precondition_met_count += 1\n                elif pm is False or pm == \"false\":\n                    precondition_not_met_count += 1\n        else:\n            unknown_case += 1\n\n    total = sum(per_case.values()) + unknown_case\n    per_case_pct = {\n        k: round(v / total * 100.0, 2) if total else 0.0\n        for k, v in per_case.items()\n    }\n\n    # Healthy distribution sentinels per ADR-108 §Operational\n    healthy_ranges = {\n        \"A\": (70.0, 85.0),\n        \"B\": (1.0, 8.0),\n        \"C\": (2.0, 10.0),\n        \"D\": (1.0, 5.0),\n        \"E\": (1.0, 5.0),\n        \"F\": (0.0, 2.0),\n    }\n    health = {}\n    for k, pct in per_case_pct.items():\n        lo, hi = healthy_ranges[k]\n        if total == 0:\n            health[k] = \"NO_DATA\"\n        elif lo <= pct <= hi:\n            health[k] = \"OK\"\n        elif pct < lo:\n            health[k] = \"LOW\"\n        else:\n            health[k] = \"HIGH\"\n\n    return {\n        \"window_days\": window_days,\n        \"window_start\": cutoff_iso,\n        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"total_pair_rail_case_events\": total,\n        \"case_counts\": per_case,\n        \"case_percentages\": per_case_pct,\n        \"unknown_case_count\": unknown_case,\n        \"case_b_precondition_met\": precondition_met_count,\n        \"case_b_precondition_not_met\": precondition_not_met_count,\n        \"health_per_case\": health,\n    }\n\n\ndef cmd_codex_writeguard_summary(entries, args) -> Dict[str, Any]:\n    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE Q2): Codex codando deny-list hit summary.\n\n    Aggregates `pair_rail_codex_denylist_hit` audit events by target_path\n    bucket. Surfaces top-attempted forbidden paths so operators can detect\n    deny-list coverage gaps.\n    \"\"\"\n    window_days = getattr(args, \"window_days\", None)\n    if window_days is None:\n        window_days = 30\n\n    now = datetime.now(timezone.utc)\n    cutoff = now - timedelta(days=window_days)\n    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    per_path: Dict[str, int] = {}\n    total_hits = 0\n    for e in entries:\n        if e.get(\"action\") != \"pair_rail_codex_denylist_hit\":\n            continue\n        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n            continue\n        path = str(e.get(\"target_path_bucket\") or e.get(\"target_path\") or \"unknown\")\n        per_path[path] = per_path.get(path, 0) + 1\n        total_hits += 1\n\n    top_n = int(getattr(args, \"top\", None) or 10)\n    top_paths = sorted(per_path.items(), key=lambda kv: (-kv[1], kv[0]))[:top_n]\n\n    return {\n        \"window_days\": window_days,\n        \"window_start\": cutoff_iso,\n        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"total_hits\": total_hits,\n        \"unique_paths\": len(per_path),\n        \"top_paths\": [{\"path_bucket\": p, \"hits\": c} for p, c in top_paths],\n    }\n\n\n# ---------------------------------------------------------------------------\n# PLAN-113 Phase B, Wave W1 — critical-security-action reader (audit-reader\n# coverage). These 38 actions are emitted by hooks but had NO reader handler\n# in this CLI, so an operator could not surface them (PLAN-112 finding class\n# \"Critical action has no reader handler\"). cmd_critical reads the registry\n# below and surfaces, per action, count + first/last timestamp + a compact\n# set of SAFE summary fields ALREADY PRESENT on the event (never invented).\n# Actions with ZERO occurrences are still listed (count=0) so a\n# missing-but-expected critical event is visible — surfacing ABSENCE is the\n# whole point.\n# ---------------------------------------------------------------------------\n","numLines":432,"startLine":1,"totalLines":432}},"tool_result_meta":[{"id":"toolu_01BUK5W4ebvqjtbg2qmbMURn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
