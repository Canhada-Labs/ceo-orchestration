{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019dNufSvVFCbf8jYpqB9vyn","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tdef build_plan_attribution(\n4\t    events: List[Dict[str, Any]],\n5\t) -> Dict[int, Optional[str]]:\n6\t    \"\"\"Build event-index → plan_id attribution map.\n7\t\n8\t    Algorithm (best-effort, in order):\n9\t      1. If event has an explicit ``plan_id`` field matching PLAN-NNN,\n10\t         that wins.\n11\t      2. Else: find the most recent preceding ``plan_status_transition``\n12\t         event in the same ``session_id`` whose ``to_status`` (or\n13\t         ``status``) is ``executing``; attribute to that plan.\n14\t      3. Else: None (display as ``(unknown)``).\n15\t\n16\t    The events list must be sorted by timestamp ascending. The map is\n17\t    keyed by *index in the supplied list* so callers can re-zip without\n18\t    holding a second copy.\n19\t    \"\"\"\n20\t    attribution: Dict[int, Optional[str]] = {}\n21\t    # session_id → currently-executing plan_id\n22\t    session_executing: Dict[str, str] = {}\n23\t\n24\t    for idx, ev in enumerate(events):\n25\t        action = ev.get(\"action\") or \"\"\n26\t        session_id = ev.get(\"session_id\") or \"\"\n27\t\n28\t        # Update executing context from plan_status_transition events.\n29\t        if action == \"plan_status_transition\":\n30\t            to_status = (\n31\t                ev.get(\"to_status\")\n32\t                or ev.get(\"status\")\n33\t                or ev.get(\"new_status\")\n34\t                or \"\"\n35\t            )\n36\t            pid = _safe_plan_id(ev.get(\"plan_id\"))\n37\t            if pid and to_status == \"executing\":\n38\t                session_executing[session_id] = pid\n39\t            elif pid and to_status in (\"done\", \"abandoned\", \"blocked\"):\n40\t                # Plan no longer executing — clear if it matches.\n41\t                if session_executing.get(session_id) == pid:\n42\t                    session_executing.pop(session_id, None)\n43\t\n44\t        # Explicit field wins.\n45\t        explicit = _safe_plan_id(ev.get(\"plan_id\"))\n46\t        if explicit:\n47\t            attribution[idx] = explicit\n48\t            continue\n49\t\n50\t        # Inferred from session executing context.\n51\t        inferred = session_executing.get(session_id)\n52\t        if inferred:\n53\t            attribution[idx] = inferred\n54\t        else:\n55\t            attribution[idx] = None\n56\t\n57\t    return attribution\n58\t\n59\t\n60\tdef compute_cost_usd(\n61\t    model: Optional[str],\n62\t    tokens_in: int,\n63\t    tokens_out: int,\n64\t    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n65\t    ts: Optional[str] = None,\n66\t) -> Optional[float]:\n67\t    \"\"\"Compute USD cost from model + token counts; None on unknown model.\n68\t\n69\t    P2a: when ``ts`` (the event's own ISO-8601 timestamp) is given and the\n70\t    model has a dated row, the rate is resolved against that date\n71\t    (``ts[:10]`` lexicographic compare — no parse). A caller-supplied\n72\t    custom row for the model always wins over the built-in dated row; a\n73\t    missing ``ts`` falls back to the static row (pre-P2a behaviour).\n74\t    \"\"\"\n75\t    if pricing is None:\n76\t        pricing = _DEFAULT_PRICING\n77\t    if not isinstance(model, str) or not model:\n78\t        return None\n79\t    key = model.lower()\n80\t    row = pricing.get(key)\n81\t    dated = _DATED_PRICING.get(key)\n82\t    if (\n83\t        dated is not None\n84\t        and isinstance(ts, str)\n85\t        and len(ts) >= 10\n86\t        and row == _DEFAULT_PRICING.get(key)\n87\t    ):\n88\t        cutoff, through, after = dated\n89\t        row = through if ts[:10] <= cutoff else after\n90\t    if not row:\n91\t        return None\n92\t    cost = (tokens_in / 1000.0) * row.get(\"in\", 0.0)\n93\t    cost += (tokens_out / 1000.0) * row.get(\"out\", 0.0)\n94\t    return round(cost, 6)\n95\t\n96\t\n97\tdef _load_normalize_model_name():\n98\t    \"\"\"Load ``normalize_model_name`` from the repo's EXISTING registry\n99\t    module ``optimizer/model_normalize.py`` (PLAN-133 B2) — REUSE, never\n100\t    a second table. Tries the deterministic sibling file first (works\n101\t    when this script is loaded by path, as the test suite does), then a\n102\t    plain package import. Fail-open on infra: returns None when neither\n103\t    route works; ``_normalize_model_id`` then degrades to case/\n104\t    whitespace/``[1m]`` handling + registry-derived family folding.\n105\t    \"\"\"\n106\t    candidate = Path(__file__).resolve().parent / \"optimizer\" / \"model_normalize.py\"\n107\t    try:\n108\t        if candidate.is_file():\n109\t            import importlib.util\n110\t\n111\t            spec = importlib.util.spec_from_file_location(\n112\t                \"_budget_summary_model_normalize\", str(candidate)\n113\t            )\n114\t            if spec is not None and spec.loader is not None:\n115\t                mod = importlib.util.module_from_spec(spec)\n116\t                spec.loader.exec_module(mod)\n117\t                fn = getattr(mod, \"normalize_model_name\", None)\n118\t                if callable(fn):\n119\t                    return fn\n120\t    except Exception:\n121\t        pass\n122\t    try:\n123\t        from optimizer.model_normalize import normalize_model_name as fn2  # type: ignore\n124\t\n125\t        if callable(fn2):\n126\t            return fn2\n127\t    except Exception:\n128\t        pass\n129\t    return None\n130\t\n131\t\n132\tdef _family_candidates(\n133\t    family: str,\n134\t    pricing: Dict[str, Dict[str, float]],\n135\t) -> Set[str]:\n136\t    \"\"\"Canonical ids in the EXISTING pricing registry whose family segment\n137\t    equals ``family`` (date-stamped variants folded through the reused\n138\t    normalizer so ``claude-haiku-4-5-[REDACTED:rg]`` and ``claude-haiku-4-5``\n139\t    count as ONE candidate, not two).\"\"\"\n140\t    out: Set[str] = set()\n141\t    for key in pricing:\n142\t        m = _CLAUDE_FAMILY_RE.match(key)\n143\t        if not m or m.group(1) != family:\n144\t            continue\n145\t        canon = key\n146\t        if _NORMALIZE_MODEL_NAME is not None:\n147\t            try:\n148\t                folded = _NORMALIZE_MODEL_NAME(key)\n149\t                if folded:\n150\t                    canon = folded\n151\t            except Exception:\n152\t                pass\n153\t        out.add(canon)\n154\t    return out\n155\t\n156\t\n157\tdef _normalize_model_id(\n158\t    model: Any,\n159\t    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n160\t) -> Optional[str]:\n161\t    \"\"\"Resolve a raw model string to a canonical model id (W1.2-3).\n162\t\n163\t    Pipeline (all lookups against EXISTING registry surfaces):\n164\t      1. coerce/strip/lower; empty → None.\n165\t      2. strip a trailing ``[1m]`` packaging suffix (generic — the\n166\t         ``model_normalize`` alias map only carries the 4-8 row).\n167\t      3. fold aliases via the reused ``normalize_model_name``\n168\t         (``optimizer/model_normalize.py``): date stamps, bare\n169\t         family+version (``opus-5`` → ``claude-opus-5``),\n170\t         ``anthropic/`` prefix, case/whitespace.\n171\t      4. exact hit in the pricing registry → resolved.\n172\t      5. bare family alias (``fable``): resolved ONLY when the registry\n173\t         holds exactly one canonical id for that family; ambiguous\n174\t         families (``opus``/``sonnet``/``haiku``) → None — never guess\n175\t         a version.\n176\t      6. a specific-but-unpriced id passes through unchanged so reports\n177\t         can NAME the model that lacks a pricing row (cost stays TBD).\n178\t\n179\t    Returns the canonical id, or None when the input is empty or an\n180\t    ambiguous alias. A None result (or a resolved id with no pricing\n181\t    row) MUST surface as ``TBD`` in cost columns — never as $0.\n182\t    \"\"\"\n183\t    if pricing is None:\n184\t        pricing = _DEFAULT_PRICING\n185\t    if not isinstance(model, str):\n186\t        return None\n187\t    m = model.strip().lower()\n188\t    if not m:\n189\t        return None\n190\t    m = _ONE_M_SUFFIX_RE.sub(\"\", m)\n191\t    if not m:\n192\t        return None\n193\t    if _NORMALIZE_MODEL_NAME is not None:\n194\t        try:\n195\t            folded = _NORMALIZE_MODEL_NAME(m)\n196\t            if folded:\n197\t                m = folded\n198\t        except Exception:\n199\t            pass\n200\t    if m in pricing:\n201\t        return m\n202\t    if _BARE_FAMILY_RE.match(m):\n203\t        candidates = _family_candidates(m, pricing)\n204\t        if len(candidates) == 1:\n205\t            return next(iter(candidates))\n206\t        return None\n207\t    return m\n208\t\n209\t\n210\tdef rollup(\n211\t    *,\n212\t    audit_dir: Optional[Path] = None,\n213\t    plan_filter: Optional[str] = None,\n214\t    since: Optional[timedelta] = None,\n215\t    by_wave: bool = False,\n216\t    now: Optional[datetime] = None,\n217\t    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n218\t) -> Dict[str, Any]:\n219\t    \"\"\"Compute the cumulative rollup.\n220\t\n221\t    Returns a JSON-serializable dict. See module docstring for output\n222\t    shape.\n223\t    \"\"\"\n224\t    if now is None:\n225\t        now = datetime.now(timezone.utc)\n226\t    cutoff = (now - since) if since is not None else None\n227\t\n228\t    log_paths = discover_logs(audit_dir)\n229\t    # Materialize so we can do two passes (attribution + rollup).\n230\t    all_events: List[Dict[str, Any]] = list(iter_unique_events(log_paths))\n231\t    # Sort ascending by ts (stable on equal ts).\n232\t    all_events.sort(key=lambda e: (e.get(\"ts\") or \"\", e.get(\"action\") or \"\"))\n233\t\n234\t    attribution = build_plan_attribution(all_events)\n235\t\n236\t    tot_in = 0\n237\t    tot_out = 0\n238\t    tot_total = 0\n239\t    tot_cost = 0.0\n240\t    cost_known = False\n241\t    spawn_count = 0\n242\t    codex_event_count = 0\n243\t    unknown_plan_count = 0\n244\t\n245\t    per_plan: Dict[str, Dict[str, Any]] = {}\n246\t    per_session: Dict[str, Dict[str, Any]] = {}\n247\t    per_wave: Dict[str, Dict[str, Any]] = {}\n248\t\n249\t    for idx, ev in enumerate(all_events):\n250\t        action = ev.get(\"action\") or \"\"\n251\t        if action not in _TOKEN_BEARING_ACTIONS:\n252\t            continue\n253\t\n254\t        ts = _parse_ts(ev.get(\"ts\"))\n255\t        if cutoff is not None and ts is not None and ts < cutoff:\n256\t            continue\n257\t\n258\t        # plan_id attribution\n259\t        attributed = attribution.get(idx)\n260\t        if plan_filter:\n261\t            if attributed != plan_filter:\n262\t                continue\n263\t        plan_label = attributed or \"(unknown)\"\n264\t        if attributed is None:\n265\t            unknown_plan_count += 1\n266\t\n267\t        # Tokens — None coerced to 0\n268\t        t_in_raw = ev.get(\"tokens_in\")\n269\t        t_out_raw = ev.get(\"tokens_out\")\n270\t        t_total_raw = ev.get(\"tokens_total\")\n271\t        t_in = int(t_in_raw) if isinstance(t_in_raw, (int, float)) and t_in_raw else 0\n272\t        t_out = int(t_out_raw) if isinstance(t_out_raw, (int, float)) and t_out_raw else 0\n273\t        t_total = int(t_total_raw) if isinstance(t_total_raw, (int, float)) and t_total_raw else 0\n274\t\n275\t        spawn_count += 1\n276\t        if action == \"pair_rail_case\":\n277\t            codex_event_count += 1\n278\t\n279\t        tot_in += t_in\n280\t        tot_out += t_out\n281\t        tot_total += t_total or (t_in + t_out)\n282\t\n283\t        model = ev.get(\"model\") or ev.get(\"agent_model\") or \"\"\n284\t        if isinstance(model, str) and not model and action == \"pair_rail_case\":\n285\t            # Codex events default to gpt-5-codex when model not annotated.\n286\t            model = \"gpt-5-codex\"\n287\t        cost = compute_cost_usd(model if isinstance(model, str) else None,\n288\t                                t_in, t_out, pricing=pricing,\n289\t                                ts=ev.get(\"ts\"))\n290\t        if cost is not None:\n291\t            cost_known = True\n292\t            tot_cost += cost\n293\t\n294\t        # Per-plan\n295\t        prow = per_plan.setdefault(plan_label, {\n296\t            \"plan_id\": plan_label,\n297\t            \"event_count\": 0,\n298\t            \"tokens_in\": 0,\n299\t            \"tokens_out\": 0,\n300\t            \"tokens_total\": 0,\n301\t            \"cost_usd\": 0.0,\n302\t            \"cost_known\": False,\n303\t        })\n304\t        prow[\"event_count\"] += 1\n305\t        prow[\"tokens_in\"] += t_in\n306\t        prow[\"tokens_out\"] += t_out\n307\t        prow[\"tokens_total\"] += t_total or (t_in + t_out)\n308\t        if cost is not None:\n309\t            prow[\"cost_usd\"] = round(prow[\"cost_usd\"] + cost, 6)\n310\t            prow[\"cost_known\"] = True\n311\t\n312\t        # Per-session\n313\t        sid = ev.get(\"session_id\") or \"(unknown)\"\n314\t        srow = per_session.setdefault(sid, {\n315\t            \"session_id\": sid,\n316\t            \"event_count\": 0,\n317\t            \"tokens_total\": 0,\n318\t            \"cost_usd\": 0.0,\n319\t        })\n320\t        srow[\"event_count\"] += 1\n321\t        srow[\"tokens_total\"] += t_total or (t_in + t_out)\n322\t        if cost is not None:\n323\t            srow[\"cost_usd\"] = round(srow[\"cost_usd\"] + cost, 6)\n324\t\n325\t        # Per-wave (optional aggregation)\n326\t        if by_wave:\n327\t            wave = _extract_wave_id(ev)\n328\t            if wave:\n329\t                wrow = per_wave.setdefault(wave, {\n330\t                    \"wave\": wave,\n331\t                    \"event_count\": 0,\n332\t                    \"tokens_total\": 0,\n333\t                    \"cost_usd\": 0.0,\n334\t                })\n335\t                wrow[\"event_count\"] += 1\n336\t                wrow[\"tokens_total\"] += t_total or (t_in + t_out)\n337\t                if cost is not None:\n338\t                    wrow[\"cost_usd\"] = round(wrow[\"cost_usd\"] + cost, 6)\n339\t\n340\t    result: Dict[str, Any] = {\n341\t        \"audit_dir\": str(audit_dir or default_audit_dir()),\n342\t        \"log_files_read\": [p.name for p in log_paths],\n343\t        \"plan_filter\": plan_filter,\n344\t        \"since\": None,  # filled by caller who knows the expr\n345\t        \"total_events\": spawn_count,\n346\t        \"codex_event_count\": codex_event_count,\n347\t        \"unknown_plan_count\": unknown_plan_count,\n348\t        \"total_tokens_in\": tot_in,\n349\t        \"total_tokens_out\": tot_out,\n350\t        \"total_tokens\": tot_total,\n351\t        \"total_cost_usd\": round(tot_cost, 6) if cost_known else None,\n352\t        \"cost_source\": \"default-pricing-table\" if cost_known else \"unknown\",\n353\t        \"per_plan\": sorted(per_plan.values(), key=lambda r: r[\"plan_id\"]),\n354\t        \"per_session\": sorted(per_session.values(), key=lambda r: r[\"session_id\"]),\n355\t    }\n356\t    if by_wave:\n357\t        result[\"per_wave\"] = sorted(per_wave.values(), key=lambda r: r[\"wave\"])\n358\t\n359\t    return result\n360\t\n361\t\n362\tdef _bench_cost_usd(r: Dict[str, Any]) -> float:\n363\t    \"\"\"Per-run benchmark cost in USD. Prefers int-encoded\n364\t    ``cost_usd_cents`` (÷100); falls back to a legacy float ``cost_usd``.\"\"\"\n365\t    cents = r.get(\"cost_usd_cents\")\n366\t    if cents is not None:\n367\t        try:\n368\t            return int(cents) / 100.0\n369\t        except (TypeError, ValueError):\n370\t            return 0.0\n371\t    try:\n372\t        return float(r.get(\"cost_usd\") or 0.0)\n373\t    except (TypeError, ValueError):\n374\t        return 0.0\n375\t\n376\t\n377\tdef _bench_duration_s(r: Dict[str, Any]) -> float:\n378\t    \"\"\"Per-run wall-clock (the harbor 'compute' column) in seconds.\n379\t    Prefers int-encoded ``duration_ms`` (÷1000); falls back to legacy\n380\t    float ``duration_s``.\"\"\"\n381\t    ms = r.get(\"duration_ms\")\n382\t    if ms is not None:\n383\t        try:\n384\t            return int(ms) / 1000.0\n385\t        except (TypeError, ValueError):\n386\t            return 0.0\n387\t    try:\n388\t        return float(r.get(\"duration_s\") or 0.0)\n389\t    except (TypeError, ValueError):\n390\t        return 0.0\n391\t\n392\t\n393\t\n394\t"}]},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"f3255b05-16b5-4623-bf1a-ba26250547ff","timestamp":"2026-11-13T18:12:01.207Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_budget_summary_parts/cost_rollup.py","content":"from __future__ import annotations\n\ndef build_plan_attribution(\n    events: List[Dict[str, Any]],\n) -> Dict[int, Optional[str]]:\n    \"\"\"Build event-index → plan_id attribution map.\n\n    Algorithm (best-effort, in order):\n      1. If event has an explicit ``plan_id`` field matching PLAN-NNN,\n         that wins.\n      2. Else: find the most recent preceding ``plan_status_transition``\n         event in the same ``session_id`` whose ``to_status`` (or\n         ``status``) is ``executing``; attribute to that plan.\n      3. Else: None (display as ``(unknown)``).\n\n    The events list must be sorted by timestamp ascending. The map is\n    keyed by *index in the supplied list* so callers can re-zip without\n    holding a second copy.\n    \"\"\"\n    attribution: Dict[int, Optional[str]] = {}\n    # session_id → currently-executing plan_id\n    session_executing: Dict[str, str] = {}\n\n    for idx, ev in enumerate(events):\n        action = ev.get(\"action\") or \"\"\n        session_id = ev.get(\"session_id\") or \"\"\n\n        # Update executing context from plan_status_transition events.\n        if action == \"plan_status_transition\":\n            to_status = (\n                ev.get(\"to_status\")\n                or ev.get(\"status\")\n                or ev.get(\"new_status\")\n                or \"\"\n            )\n            pid = _safe_plan_id(ev.get(\"plan_id\"))\n            if pid and to_status == \"executing\":\n                session_executing[session_id] = pid\n            elif pid and to_status in (\"done\", \"abandoned\", \"blocked\"):\n                # Plan no longer executing — clear if it matches.\n                if session_executing.get(session_id) == pid:\n                    session_executing.pop(session_id, None)\n\n        # Explicit field wins.\n        explicit = _safe_plan_id(ev.get(\"plan_id\"))\n        if explicit:\n            attribution[idx] = explicit\n            continue\n\n        # Inferred from session executing context.\n        inferred = session_executing.get(session_id)\n        if inferred:\n            attribution[idx] = inferred\n        else:\n            attribution[idx] = None\n\n    return attribution\n\n\ndef compute_cost_usd(\n    model: Optional[str],\n    tokens_in: int,\n    tokens_out: int,\n    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n    ts: Optional[str] = None,\n) -> Optional[float]:\n    \"\"\"Compute USD cost from model + token counts; None on unknown model.\n\n    P2a: when ``ts`` (the event's own ISO-8601 timestamp) is given and the\n    model has a dated row, the rate is resolved against that date\n    (``ts[:10]`` lexicographic compare — no parse). A caller-supplied\n    custom row for the model always wins over the built-in dated row; a\n    missing ``ts`` falls back to the static row (pre-P2a behaviour).\n    \"\"\"\n    if pricing is None:\n        pricing = _DEFAULT_PRICING\n    if not isinstance(model, str) or not model:\n        return None\n    key = model.lower()\n    row = pricing.get(key)\n    dated = _DATED_PRICING.get(key)\n    if (\n        dated is not None\n        and isinstance(ts, str)\n        and len(ts) >= 10\n        and row == _DEFAULT_PRICING.get(key)\n    ):\n        cutoff, through, after = dated\n        row = through if ts[:10] <= cutoff else after\n    if not row:\n        return None\n    cost = (tokens_in / 1000.0) * row.get(\"in\", 0.0)\n    cost += (tokens_out / 1000.0) * row.get(\"out\", 0.0)\n    return round(cost, 6)\n\n\ndef _load_normalize_model_name():\n    \"\"\"Load ``normalize_model_name`` from the repo's EXISTING registry\n    module ``optimizer/model_normalize.py`` (PLAN-133 B2) — REUSE, never\n    a second table. Tries the deterministic sibling file first (works\n    when this script is loaded by path, as the test suite does), then a\n    plain package import. Fail-open on infra: returns None when neither\n    route works; ``_normalize_model_id`` then degrades to case/\n    whitespace/``[1m]`` handling + registry-derived family folding.\n    \"\"\"\n    candidate = Path(__file__).resolve().parent / \"optimizer\" / \"model_normalize.py\"\n    try:\n        if candidate.is_file():\n            import importlib.util\n\n            spec = importlib.util.spec_from_file_location(\n                \"_budget_summary_model_normalize\", str(candidate)\n            )\n            if spec is not None and spec.loader is not None:\n                mod = importlib.util.module_from_spec(spec)\n                spec.loader.exec_module(mod)\n                fn = getattr(mod, \"normalize_model_name\", None)\n                if callable(fn):\n                    return fn\n    except Exception:\n        pass\n    try:\n        from optimizer.model_normalize import normalize_model_name as fn2  # type: ignore\n\n        if callable(fn2):\n            return fn2\n    except Exception:\n        pass\n    return None\n\n\ndef _family_candidates(\n    family: str,\n    pricing: Dict[str, Dict[str, float]],\n) -> Set[str]:\n    \"\"\"Canonical ids in the EXISTING pricing registry whose family segment\n    equals ``family`` (date-stamped variants folded through the reused\n    normalizer so ``claude-haiku-4-5-[REDACTED:rg]`` and ``claude-haiku-4-5``\n    count as ONE candidate, not two).\"\"\"\n    out: Set[str] = set()\n    for key in pricing:\n        m = _CLAUDE_FAMILY_RE.match(key)\n        if not m or m.group(1) != family:\n            continue\n        canon = key\n        if _NORMALIZE_MODEL_NAME is not None:\n            try:\n                folded = _NORMALIZE_MODEL_NAME(key)\n                if folded:\n                    canon = folded\n            except Exception:\n                pass\n        out.add(canon)\n    return out\n\n\ndef _normalize_model_id(\n    model: Any,\n    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n) -> Optional[str]:\n    \"\"\"Resolve a raw model string to a canonical model id (W1.2-3).\n\n    Pipeline (all lookups against EXISTING registry surfaces):\n      1. coerce/strip/lower; empty → None.\n      2. strip a trailing ``[1m]`` packaging suffix (generic — the\n         ``model_normalize`` alias map only carries the 4-8 row).\n      3. fold aliases via the reused ``normalize_model_name``\n         (``optimizer/model_normalize.py``): date stamps, bare\n         family+version (``opus-5`` → ``claude-opus-5``),\n         ``anthropic/`` prefix, case/whitespace.\n      4. exact hit in the pricing registry → resolved.\n      5. bare family alias (``fable``): resolved ONLY when the registry\n         holds exactly one canonical id for that family; ambiguous\n         families (``opus``/``sonnet``/``haiku``) → None — never guess\n         a version.\n      6. a specific-but-unpriced id passes through unchanged so reports\n         can NAME the model that lacks a pricing row (cost stays TBD).\n\n    Returns the canonical id, or None when the input is empty or an\n    ambiguous alias. A None result (or a resolved id with no pricing\n    row) MUST surface as ``TBD`` in cost columns — never as $0.\n    \"\"\"\n    if pricing is None:\n        pricing = _DEFAULT_PRICING\n    if not isinstance(model, str):\n        return None\n    m = model.strip().lower()\n    if not m:\n        return None\n    m = _ONE_M_SUFFIX_RE.sub(\"\", m)\n    if not m:\n        return None\n    if _NORMALIZE_MODEL_NAME is not None:\n        try:\n            folded = _NORMALIZE_MODEL_NAME(m)\n            if folded:\n                m = folded\n        except Exception:\n            pass\n    if m in pricing:\n        return m\n    if _BARE_FAMILY_RE.match(m):\n        candidates = _family_candidates(m, pricing)\n        if len(candidates) == 1:\n            return next(iter(candidates))\n        return None\n    return m\n\n\ndef rollup(\n    *,\n    audit_dir: Optional[Path] = None,\n    plan_filter: Optional[str] = None,\n    since: Optional[timedelta] = None,\n    by_wave: bool = False,\n    now: Optional[datetime] = None,\n    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n) -> Dict[str, Any]:\n    \"\"\"Compute the cumulative rollup.\n\n    Returns a JSON-serializable dict. See module docstring for output\n    shape.\n    \"\"\"\n    if now is None:\n        now = datetime.now(timezone.utc)\n    cutoff = (now - since) if since is not None else None\n\n    log_paths = discover_logs(audit_dir)\n    # Materialize so we can do two passes (attribution + rollup).\n    all_events: List[Dict[str, Any]] = list(iter_unique_events(log_paths))\n    # Sort ascending by ts (stable on equal ts).\n    all_events.sort(key=lambda e: (e.get(\"ts\") or \"\", e.get(\"action\") or \"\"))\n\n    attribution = build_plan_attribution(all_events)\n\n    tot_in = 0\n    tot_out = 0\n    tot_total = 0\n    tot_cost = 0.0\n    cost_known = False\n    spawn_count = 0\n    codex_event_count = 0\n    unknown_plan_count = 0\n\n    per_plan: Dict[str, Dict[str, Any]] = {}\n    per_session: Dict[str, Dict[str, Any]] = {}\n    per_wave: Dict[str, Dict[str, Any]] = {}\n\n    for idx, ev in enumerate(all_events):\n        action = ev.get(\"action\") or \"\"\n        if action not in _TOKEN_BEARING_ACTIONS:\n            continue\n\n        ts = _parse_ts(ev.get(\"ts\"))\n        if cutoff is not None and ts is not None and ts < cutoff:\n            continue\n\n        # plan_id attribution\n        attributed = attribution.get(idx)\n        if plan_filter:\n            if attributed != plan_filter:\n                continue\n        plan_label = attributed or \"(unknown)\"\n        if attributed is None:\n            unknown_plan_count += 1\n\n        # Tokens — None coerced to 0\n        t_in_raw = ev.get(\"tokens_in\")\n        t_out_raw = ev.get(\"tokens_out\")\n        t_total_raw = ev.get(\"tokens_total\")\n        t_in = int(t_in_raw) if isinstance(t_in_raw, (int, float)) and t_in_raw else 0\n        t_out = int(t_out_raw) if isinstance(t_out_raw, (int, float)) and t_out_raw else 0\n        t_total = int(t_total_raw) if isinstance(t_total_raw, (int, float)) and t_total_raw else 0\n\n        spawn_count += 1\n        if action == \"pair_rail_case\":\n            codex_event_count += 1\n\n        tot_in += t_in\n        tot_out += t_out\n        tot_total += t_total or (t_in + t_out)\n\n        model = ev.get(\"model\") or ev.get(\"agent_model\") or \"\"\n        if isinstance(model, str) and not model and action == \"pair_rail_case\":\n            # Codex events default to gpt-5-codex when model not annotated.\n            model = \"gpt-5-codex\"\n        cost = compute_cost_usd(model if isinstance(model, str) else None,\n                                t_in, t_out, pricing=pricing,\n                                ts=ev.get(\"ts\"))\n        if cost is not None:\n            cost_known = True\n            tot_cost += cost\n\n        # Per-plan\n        prow = per_plan.setdefault(plan_label, {\n            \"plan_id\": plan_label,\n            \"event_count\": 0,\n            \"tokens_in\": 0,\n            \"tokens_out\": 0,\n            \"tokens_total\": 0,\n            \"cost_usd\": 0.0,\n            \"cost_known\": False,\n        })\n        prow[\"event_count\"] += 1\n        prow[\"tokens_in\"] += t_in\n        prow[\"tokens_out\"] += t_out\n        prow[\"tokens_total\"] += t_total or (t_in + t_out)\n        if cost is not None:\n            prow[\"cost_usd\"] = round(prow[\"cost_usd\"] + cost, 6)\n            prow[\"cost_known\"] = True\n\n        # Per-session\n        sid = ev.get(\"session_id\") or \"(unknown)\"\n        srow = per_session.setdefault(sid, {\n            \"session_id\": sid,\n            \"event_count\": 0,\n            \"tokens_total\": 0,\n            \"cost_usd\": 0.0,\n        })\n        srow[\"event_count\"] += 1\n        srow[\"tokens_total\"] += t_total or (t_in + t_out)\n        if cost is not None:\n            srow[\"cost_usd\"] = round(srow[\"cost_usd\"] + cost, 6)\n\n        # Per-wave (optional aggregation)\n        if by_wave:\n            wave = _extract_wave_id(ev)\n            if wave:\n                wrow = per_wave.setdefault(wave, {\n                    \"wave\": wave,\n                    \"event_count\": 0,\n                    \"tokens_total\": 0,\n                    \"cost_usd\": 0.0,\n                })\n                wrow[\"event_count\"] += 1\n                wrow[\"tokens_total\"] += t_total or (t_in + t_out)\n                if cost is not None:\n                    wrow[\"cost_usd\"] = round(wrow[\"cost_usd\"] + cost, 6)\n\n    result: Dict[str, Any] = {\n        \"audit_dir\": str(audit_dir or default_audit_dir()),\n        \"log_files_read\": [p.name for p in log_paths],\n        \"plan_filter\": plan_filter,\n        \"since\": None,  # filled by caller who knows the expr\n        \"total_events\": spawn_count,\n        \"codex_event_count\": codex_event_count,\n        \"unknown_plan_count\": unknown_plan_count,\n        \"total_tokens_in\": tot_in,\n        \"total_tokens_out\": tot_out,\n        \"total_tokens\": tot_total,\n        \"total_cost_usd\": round(tot_cost, 6) if cost_known else None,\n        \"cost_source\": \"default-pricing-table\" if cost_known else \"unknown\",\n        \"per_plan\": sorted(per_plan.values(), key=lambda r: r[\"plan_id\"]),\n        \"per_session\": sorted(per_session.values(), key=lambda r: r[\"session_id\"]),\n    }\n    if by_wave:\n        result[\"per_wave\"] = sorted(per_wave.values(), key=lambda r: r[\"wave\"])\n\n    return result\n\n\ndef _bench_cost_usd(r: Dict[str, Any]) -> float:\n    \"\"\"Per-run benchmark cost in USD. Prefers int-encoded\n    ``cost_usd_cents`` (÷100); falls back to a legacy float ``cost_usd``.\"\"\"\n    cents = r.get(\"cost_usd_cents\")\n    if cents is not None:\n        try:\n            return int(cents) / 100.0\n        except (TypeError, ValueError):\n            return 0.0\n    try:\n        return float(r.get(\"cost_usd\") or 0.0)\n    except (TypeError, ValueError):\n        return 0.0\n\n\ndef _bench_duration_s(r: Dict[str, Any]) -> float:\n    \"\"\"Per-run wall-clock (the harbor 'compute' column) in seconds.\n    Prefers int-encoded ``duration_ms`` (÷1000); falls back to legacy\n    float ``duration_s``.\"\"\"\n    ms = r.get(\"duration_ms\")\n    if ms is not None:\n        try:\n            return int(ms) / 1000.0\n        except (TypeError, ValueError):\n            return 0.0\n    try:\n        return float(r.get(\"duration_s\") or 0.0)\n    except (TypeError, ValueError):\n        return 0.0\n\n\n\n","numLines":394,"startLine":1,"totalLines":394}},"tool_result_meta":[{"id":"toolu_019dNufSvVFCbf8jYpqB9vyn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
