{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LTLdE7bEghve7pCtdNSFqG","type":"tool_result","content":"55\t# Read-only subcommand allowlist (AC-R-1 enforcement surface)\n56\t# ---------------------------------------------------------------------------\n57\t\n58\t\n59\t# 27 read-only sub-commands. Map MCP method suffix → audit-query.py\n60\t# cmd_* function name. The `label` sub-command is intentionally\n61\t# excluded — it appends to .claude/scripts/audit-log-labels.jsonl.\n62\tALLOWED_SUBCOMMANDS: Dict[str, str] = {\n63\t    \"summary\": \"cmd_summary\",\n64\t    \"by_skill\": \"cmd_by_skill\",\n65\t    \"compliance\": \"cmd_compliance\",\n66\t    \"by_day\": \"cmd_by_day\",\n67\t    \"search\": \"cmd_search\",\n68\t    \"since\": \"cmd_since\",\n69\t    \"errors\": \"cmd_errors\",\n70\t    \"stats\": \"cmd_stats\",\n71\t    \"export\": \"cmd_export\",\n72\t    \"debate\": \"cmd_debate\",\n73\t    \"plans\": \"cmd_plans\",\n74\t    \"vetoes\": \"cmd_vetoes\",\n75\t    \"benchmarks\": \"cmd_benchmarks\",\n76\t    \"lessons\": \"cmd_lessons\",\n77\t    \"metrics\": \"cmd_metrics\",\n78\t    \"health\": \"cmd_health\",\n79\t    \"tokens\": \"cmd_tokens\",\n80\t    \"claims\": \"cmd_claims\",\n81\t    \"prune_restore_ratio\": \"cmd_prune_restore_ratio\",\n82\t    \"architect_outcomes\": \"cmd_architect_outcomes\",\n83\t    \"lessons_effectiveness\": \"cmd_lessons_effectiveness\",\n84\t    \"weekly_summary\": \"cmd_weekly_summary\",\n85\t    \"spawn_stats\": \"cmd_spawn_stats\",\n86\t    \"by_domain\": \"cmd_by_domain\",\n87\t    \"fp_rate\": \"cmd_fp_rate\",\n88\t    \"case_summary\": \"cmd_case_summary\",\n89\t    \"codex_writeguard_summary\": \"cmd_codex_writeguard_summary\",\n90\t}\n91\t\n92\t\n93\t# Sub-commands that require entries to be loaded first. `errors` reads\n94\t# its own breadcrumb file and does NOT take `entries`; everything else\n95\t# does.\n96\t_NO_ENTRIES_SUBCOMMANDS = frozenset({\"errors\"})\n97\t\n98\t\n99\t# ---------------------------------------------------------------------------\n100\t# Module loader (memoized)\n101\t# ---------------------------------------------------------------------------\n102\t\n103\t\n104\t_MODULE_LOCK = threading.Lock()\n105\t_AUDIT_QUERY_MODULE: Optional[types.ModuleType] = None\n106\t_LOAD_ERROR: Optional[str] = None\n107\t\n108\t\n109\tdef _load_audit_query(project_dir: Path) -> Optional[types.ModuleType]:\n110\t    \"\"\"Memoized loader for audit-query.py.\n111\t\n112\t    Returns the loaded module, or None on import failure (caller surfaces\n113\t    a fail-open warning).\n114\t    \"\"\"\n115\t    global _AUDIT_QUERY_MODULE, _LOAD_ERROR\n116\t    with _MODULE_LOCK:\n117\t        if _AUDIT_QUERY_MODULE is not None:\n118\t            return _AUDIT_QUERY_MODULE\n119\t        if _LOAD_ERROR is not None:\n120\t            # Fast-fail subsequent attempts within the same process.\n121\t            return None\n122\t        script = project_dir / \".claude\" / \"scripts\" / \"audit-query.py\"\n123\t        if not script.is_file():\n124\t            _LOAD_ERROR = f\"audit_query_script_missing:{script}\"\n125\t            return None\n126\t        try:\n127\t            spec = importlib.util.spec_from_file_location(\n128\t                \"_mcp_audit_query_module\", str(script)\n129\t            )\n130\t            if spec is None or spec.loader is None:\n131\t                _LOAD_ERROR = \"spec_from_file_location_failed\"\n132\t                return None\n133\t            module = importlib.util.module_from_spec(spec)\n134\t            sys.modules.setdefault(\"_mcp_audit_query_module\", module)\n135\t            spec.loader.exec_module(module)\n136\t        except Exception as e:  # broad: anything during import is fail-open\n137\t            _LOAD_ERROR = f\"import_failed:{type(e).__name__}\"\n138\t            return None\n139\t        _AUDIT_QUERY_MODULE = module\n140\t        return module\n141\t\n142\t\n143\tdef _reset_module_cache() -> None:\n144\t    \"\"\"Test helper — drop the cached audit-query module.\"\"\"\n145\t    global _AUDIT_QUERY_MODULE, _LOAD_ERROR\n146\t    with _MODULE_LOCK:\n147\t        _AUDIT_QUERY_MODULE = None\n148\t        _LOAD_ERROR = None\n149\t        sys.modules.pop(\"_mcp_audit_query_module\", None)\n150\t\n151\t\n152\t# ---------------------------------------------------------------------------\n153\t# Argparse Namespace synthesis\n154\t# ---------------------------------------------------------------------------\n155\t\n156\t\n157\t_NAMESPACE_DEFAULTS: Dict[str, Any] = {\n158\t    # Shared/global flags (--log, --include-rotated, --json, --csv,\n159\t    # --errors-path) populated by audit-query.py _build_shared_parser.\n160\t    \"log\": None,\n161\t    \"include_rotated\": False,\n162\t    \"json\": True,  # MCP always wants JSON output\n163\t    \"csv\": False,\n164\t    \"errors_path\": None,\n165\t    # Per-command frequently-used flags. Anything missing falls back to\n166\t    # None and audit-query.py per-command logic handles it.\n167\t    \"top_n\": None,\n168\t    \"regex\": \"\",\n169\t    \"since\": None,\n170\t    \"limit\": None,\n171\t    \"domain\": None,\n172\t    \"window\": None,\n173\t    \"month\": None,\n174\t    \"skill\": None,\n175\t    \"tail\": None,\n176\t    \"format\": \"json\",\n177\t    \"plan_id\": None,\n178\t    \"case_id\": None,\n179\t    \"wave\": None,\n180\t    \"include_sunset\": False,\n181\t    \"exclude_sunset\": False,\n182\t    \"subject\": None,\n183\t    \"verdict\": None,\n184\t    \"evidence_uri\": None,\n185\t    \"min_records\": None,\n186\t    \"min_calls\": None,\n187\t    \"min_dispatches\": None,\n188\t    \"min_observations\": None,\n189\t    \"min_routes\": None,\n190\t}\n191\t\n192\t\n193\tdef _build_namespace(params: Dict[str, Any]) -> argparse.Namespace:\n194\t    \"\"\"Synthesize an argparse.Namespace from JSON-RPC params.\n195\t\n196\t    Only keys in _NAMESPACE_DEFAULTS are forwarded; any unknown key is\n197\t    silently dropped (caller's responsibility to surface a warning if\n198\t    they want strict-mode behavior — read-only handlers favor\n199\t    fail-open).\n200\t    \"\"\"\n201\t    ns = argparse.Namespace()\n202\t    # Seed from defaults first.\n203\t    for k, v in _NAMESPACE_DEFAULTS.items():\n204\t        setattr(ns, k, v)\n205\t    # Override with caller-provided fields.\n206\t    if isinstance(params, dict):\n207\t        for k, v in params.items():\n208\t            if k in _NAMESPACE_DEFAULTS:\n209\t                setattr(ns, k, v)\n210\t    return ns\n211\t\n212\t\n213\t# ---------------------------------------------------------------------------\n214\t# Read-only invariant probe\n215\t# ---------------------------------------------------------------------------\n216\t\n217\t\n218\t# Param keys that would route to a writable cmd_* function. AC-R-1\n219\t# rejects ALL forged-write attempts before the handler invokes the\n220\t# underlying sub-command. The list is conservative: any param matching\n221\t# `_FORBIDDEN_WRITE_KEYS` (case-insensitive substring match) is\n222\t# rejected.\n223\t_FORBIDDEN_WRITE_KEYS = (\n224\t    \"label\",  # cmd_label appends HMAC-chained record\n225\t    \"write\",\n226\t    \"append\",\n227\t    \"output_path\",\n228\t    \"out_path\",\n229\t    \"store\",\n230\t    \"patch\",\n231\t)\n232\t\n233\t\n234\tdef _is_forged_write(params: Dict[str, Any]) -> Optional[str]:\n235\t    \"\"\"Return the first matching forbidden-write key, or None.\n236\t\n237\t    Used by AC-R-1 forged-write probe in test_mcp_readonly_invariant.py.\n238\t    \"\"\"\n239\t    if not isinstance(params, dict):\n240\t        return None\n241\t    for key in params:\n242\t        if not isinstance(key, str):\n243\t            continue\n244\t        kl = key.lower()\n245\t        for forbidden in _FORBIDDEN_WRITE_KEYS:\n246\t            if forbidden in kl:\n247\t                return key\n248\t    return None\n249\t\n250\t\n251\t# ---------------------------------------------------------------------------\n252\t# Dispatcher\n253\t# ---------------------------------------------------------------------------\n254\t\n255\t\n256\tdef _make_handler(subcommand: str):\n257\t    \"\"\"Build a handle(params, context) closure for a sub-command.\n258\t\n259\t    Returns a callable suitable for registration in\n260\t    ``dispatch.HANDLERS``. The closure captures ``subcommand`` (the MCP\n261\t    suffix) and the underlying ``cmd_*`` function name.\n262\t    \"\"\"\n263\t    if subcommand not in ALLOWED_SUBCOMMANDS:\n264\t        raise KeyError(f\"audit_query.{subcommand}: not in ALLOWED_SUBCOMMANDS\")\n265\t    cmd_fn_name = ALLOWED_SUBCOMMANDS[subcommand]\n266\t\n267\t    def handle(params: Dict[str, Any], context: Dict[str, Any]) -> Dict[str, Any]:\n268\t        \"\"\"Dispatch a single audit-query sub-command.\n269\t\n270\t        Returns:\n271\t            ``{\"subcommand\": str, \"data\": <result>}`` on success.\n272\t            ``{\"subcommand\": str, \"data\": [], \"warning\": str}`` on\n273\t            fail-open paths. NEVER raises.\n274\t        \"\"\"\n275\t        project_dir_raw = context.get(\"project_dir\")\n276\t        if project_dir_raw is None:\n277\t            return {\n278\t                \"subcommand\": subcommand,\n279\t                \"data\": [],\n280\t                \"warning\": \"project_dir_missing\",\n281\t            }\n282\t        project_dir = Path(project_dir_raw)\n283\t\n284\t        # AC-R-1 — forged-write probe at dispatcher entry.\n285\t        forged = _is_forged_write(params if isinstance(params, dict) else {})\n286\t        if forged is not None:\n287\t            return {\n288\t                \"subcommand\": subcommand,\n289\t                \"data\": [],\n290\t                \"__error__\": {\n291\t                    \"code\": -32602,\n292\t                    \"message\": f\"read_only_violation:forbidden_param:{forged}\",\n293\t                },\n294\t            }\n295\t\n296\t        module = _load_audit_query(project_dir)\n297\t        if module is None:\n298\t            return {\n299\t                \"subcommand\": subcommand,\n300\t                \"data\": [],\n301\t                \"warning\": _LOAD_ERROR or \"load_failed\",\n302\t            }\n303\t\n304\t        cmd_fn = getattr(module, cmd_fn_name, None)\n305\t        if cmd_fn is None:\n306\t            return {\n307\t                \"subcommand\": subcommand,\n308\t                \"data\": [],\n309\t                \"warning\": f\"cmd_fn_missing:{cmd_fn_name}\",\n310\t            }\n311\t\n312\t        ns = _build_namespace(params if isinstance(params, dict) else {})\n313\t\n314\t        try:\n315\t            if subcommand in _NO_ENTRIES_SUBCOMMANDS:\n316\t                # cmd_errors(args) — no entries parameter.\n317\t                result = cmd_fn(ns)\n318\t            else:\n319\t                entries = _load_entries(module, ns, project_dir)\n320\t                result = cmd_fn(entries, ns)\n321\t        except Exception as e:\n322\t            return {\n323\t                \"subcommand\": subcommand,\n324\t                \"data\": [],\n325\t                \"warning\": f\"cmd_failed:{type(e).__name__}\",\n326\t            }\n327\t\n328\t        # Coerce result to a JSON-serializable shape. cmd_* returns\n329\t        # dict | list | scalar — wrap into a uniform envelope.\n330\t        if isinstance(result, dict):\n331\t            return {\"subcommand\": subcommand, \"data\": result}\n332\t        if isinstance(result, list):\n333\t            return {\"subcommand\": subcommand, \"data\": result, \"count\": len(result)}\n334\t        return {\"subcommand\": subcommand, \"data\": result}\n335\t\n336\t    handle.__name__ = f\"handle_audit_query_{subcommand}\"\n337\t    handle.__qualname__ = handle.__name__\n338\t    return handle\n339\t\n340\t\n341\tdef _load_entries(\n342\t    module: types.ModuleType,\n343\t    ns: argparse.Namespace,\n344\t    project_dir: Path,\n345\t) -> List[Dict[str, Any]]:\n346\t    \"\"\"Load audit-log entries via audit-query helpers.\"\"\"\n347\t    default_path_fn = getattr(module, \"default_log_path\", None)\n348\t    discover_fn = getattr(module, \"discover_logs\", None)\n349\t    read_fn = getattr(module, \"read_entries\", None)\n350\t    if default_path_fn is None or discover_fn is None or read_fn is None:\n351\t        return []\n352\t    log_path = Path(ns.log) if ns.log else default_path_fn()\n353\t    paths = discover_fn(log_path, bool(getattr(ns, \"include_rotated\", False)))\n354\t    try:\n355\t        return read_fn(paths)\n356\t    except TypeError:\n357\t        # Some audit-query versions accept (paths, args).\n358\t        try:\n359\t            return read_fn(paths, ns)\n360\t        except Exception:\n361\t            return []\n362\t    except Exception:\n363\t        return []\n364\t\n365\t\n366\t# ---------------------------------------------------------------------------\n367\t# Public registry — consumed by dispatch.py to register one handler per\n368\t# sub-command.\n369\t# ---------------------------------------------------------------------------\n370\t\n371\t\n372\tHANDLERS: Dict[str, Any] = {\n373\t    f\"audit_query.{suffix}\": _make_handler(suffix)\n374\t    for suffix in ALLOWED_SUBCOMMANDS"}]},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"6ebf1888-6ede-417d-b0e9-ab9c2020b4c0","timestamp":"2026-11-13T18:11:24.357Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/mcp-server/handlers/audit_query.py","content":"# Read-only subcommand allowlist (AC-R-1 enforcement surface)\n# ---------------------------------------------------------------------------\n\n\n# 27 read-only sub-commands. Map MCP method suffix → audit-query.py\n# cmd_* function name. The `label` sub-command is intentionally\n# excluded — it appends to .claude/scripts/audit-log-labels.jsonl.\nALLOWED_SUBCOMMANDS: Dict[str, str] = {\n    \"summary\": \"cmd_summary\",\n    \"by_skill\": \"cmd_by_skill\",\n    \"compliance\": \"cmd_compliance\",\n    \"by_day\": \"cmd_by_day\",\n    \"search\": \"cmd_search\",\n    \"since\": \"cmd_since\",\n    \"errors\": \"cmd_errors\",\n    \"stats\": \"cmd_stats\",\n    \"export\": \"cmd_export\",\n    \"debate\": \"cmd_debate\",\n    \"plans\": \"cmd_plans\",\n    \"vetoes\": \"cmd_vetoes\",\n    \"benchmarks\": \"cmd_benchmarks\",\n    \"lessons\": \"cmd_lessons\",\n    \"metrics\": \"cmd_metrics\",\n    \"health\": \"cmd_health\",\n    \"tokens\": \"cmd_tokens\",\n    \"claims\": \"cmd_claims\",\n    \"prune_restore_ratio\": \"cmd_prune_restore_ratio\",\n    \"architect_outcomes\": \"cmd_architect_outcomes\",\n    \"lessons_effectiveness\": \"cmd_lessons_effectiveness\",\n    \"weekly_summary\": \"cmd_weekly_summary\",\n    \"spawn_stats\": \"cmd_spawn_stats\",\n    \"by_domain\": \"cmd_by_domain\",\n    \"fp_rate\": \"cmd_fp_rate\",\n    \"case_summary\": \"cmd_case_summary\",\n    \"codex_writeguard_summary\": \"cmd_codex_writeguard_summary\",\n}\n\n\n# Sub-commands that require entries to be loaded first. `errors` reads\n# its own breadcrumb file and does NOT take `entries`; everything else\n# does.\n_NO_ENTRIES_SUBCOMMANDS = frozenset({\"errors\"})\n\n\n# ---------------------------------------------------------------------------\n# Module loader (memoized)\n# ---------------------------------------------------------------------------\n\n\n_MODULE_LOCK = threading.Lock()\n_AUDIT_QUERY_MODULE: Optional[types.ModuleType] = None\n_LOAD_ERROR: Optional[str] = None\n\n\ndef _load_audit_query(project_dir: Path) -> Optional[types.ModuleType]:\n    \"\"\"Memoized loader for audit-query.py.\n\n    Returns the loaded module, or None on import failure (caller surfaces\n    a fail-open warning).\n    \"\"\"\n    global _AUDIT_QUERY_MODULE, _LOAD_ERROR\n    with _MODULE_LOCK:\n        if _AUDIT_QUERY_MODULE is not None:\n            return _AUDIT_QUERY_MODULE\n        if _LOAD_ERROR is not None:\n            # Fast-fail subsequent attempts within the same process.\n            return None\n        script = project_dir / \".claude\" / \"scripts\" / \"audit-query.py\"\n        if not script.is_file():\n            _LOAD_ERROR = f\"audit_query_script_missing:{script}\"\n            return None\n        try:\n            spec = importlib.util.spec_from_file_location(\n                \"_mcp_audit_query_module\", str(script)\n            )\n            if spec is None or spec.loader is None:\n                _LOAD_ERROR = \"spec_from_file_location_failed\"\n                return None\n            module = importlib.util.module_from_spec(spec)\n            sys.modules.setdefault(\"_mcp_audit_query_module\", module)\n            spec.loader.exec_module(module)\n        except Exception as e:  # broad: anything during import is fail-open\n            _LOAD_ERROR = f\"import_failed:{type(e).__name__}\"\n            return None\n        _AUDIT_QUERY_MODULE = module\n        return module\n\n\ndef _reset_module_cache() -> None:\n    \"\"\"Test helper — drop the cached audit-query module.\"\"\"\n    global _AUDIT_QUERY_MODULE, _LOAD_ERROR\n    with _MODULE_LOCK:\n        _AUDIT_QUERY_MODULE = None\n        _LOAD_ERROR = None\n        sys.modules.pop(\"_mcp_audit_query_module\", None)\n\n\n# ---------------------------------------------------------------------------\n# Argparse Namespace synthesis\n# ---------------------------------------------------------------------------\n\n\n_NAMESPACE_DEFAULTS: Dict[str, Any] = {\n    # Shared/global flags (--log, --include-rotated, --json, --csv,\n    # --errors-path) populated by audit-query.py _build_shared_parser.\n    \"log\": None,\n    \"include_rotated\": False,\n    \"json\": True,  # MCP always wants JSON output\n    \"csv\": False,\n    \"errors_path\": None,\n    # Per-command frequently-used flags. Anything missing falls back to\n    # None and audit-query.py per-command logic handles it.\n    \"top_n\": None,\n    \"regex\": \"\",\n    \"since\": None,\n    \"limit\": None,\n    \"domain\": None,\n    \"window\": None,\n    \"month\": None,\n    \"skill\": None,\n    \"tail\": None,\n    \"format\": \"json\",\n    \"plan_id\": None,\n    \"case_id\": None,\n    \"wave\": None,\n    \"include_sunset\": False,\n    \"exclude_sunset\": False,\n    \"subject\": None,\n    \"verdict\": None,\n    \"evidence_uri\": None,\n    \"min_records\": None,\n    \"min_calls\": None,\n    \"min_dispatches\": None,\n    \"min_observations\": None,\n    \"min_routes\": None,\n}\n\n\ndef _build_namespace(params: Dict[str, Any]) -> argparse.Namespace:\n    \"\"\"Synthesize an argparse.Namespace from JSON-RPC params.\n\n    Only keys in _NAMESPACE_DEFAULTS are forwarded; any unknown key is\n    silently dropped (caller's responsibility to surface a warning if\n    they want strict-mode behavior — read-only handlers favor\n    fail-open).\n    \"\"\"\n    ns = argparse.Namespace()\n    # Seed from defaults first.\n    for k, v in _NAMESPACE_DEFAULTS.items():\n        setattr(ns, k, v)\n    # Override with caller-provided fields.\n    if isinstance(params, dict):\n        for k, v in params.items():\n            if k in _NAMESPACE_DEFAULTS:\n                setattr(ns, k, v)\n    return ns\n\n\n# ---------------------------------------------------------------------------\n# Read-only invariant probe\n# ---------------------------------------------------------------------------\n\n\n# Param keys that would route to a writable cmd_* function. AC-R-1\n# rejects ALL forged-write attempts before the handler invokes the\n# underlying sub-command. The list is conservative: any param matching\n# `_FORBIDDEN_WRITE_KEYS` (case-insensitive substring match) is\n# rejected.\n_FORBIDDEN_WRITE_KEYS = (\n    \"label\",  # cmd_label appends HMAC-chained record\n    \"write\",\n    \"append\",\n    \"output_path\",\n    \"out_path\",\n    \"store\",\n    \"patch\",\n)\n\n\ndef _is_forged_write(params: Dict[str, Any]) -> Optional[str]:\n    \"\"\"Return the first matching forbidden-write key, or None.\n\n    Used by AC-R-1 forged-write probe in test_mcp_readonly_invariant.py.\n    \"\"\"\n    if not isinstance(params, dict):\n        return None\n    for key in params:\n        if not isinstance(key, str):\n            continue\n        kl = key.lower()\n        for forbidden in _FORBIDDEN_WRITE_KEYS:\n            if forbidden in kl:\n                return key\n    return None\n\n\n# ---------------------------------------------------------------------------\n# Dispatcher\n# ---------------------------------------------------------------------------\n\n\ndef _make_handler(subcommand: str):\n    \"\"\"Build a handle(params, context) closure for a sub-command.\n\n    Returns a callable suitable for registration in\n    ``dispatch.HANDLERS``. The closure captures ``subcommand`` (the MCP\n    suffix) and the underlying ``cmd_*`` function name.\n    \"\"\"\n    if subcommand not in ALLOWED_SUBCOMMANDS:\n        raise KeyError(f\"audit_query.{subcommand}: not in ALLOWED_SUBCOMMANDS\")\n    cmd_fn_name = ALLOWED_SUBCOMMANDS[subcommand]\n\n    def handle(params: Dict[str, Any], context: Dict[str, Any]) -> Dict[str, Any]:\n        \"\"\"Dispatch a single audit-query sub-command.\n\n        Returns:\n            ``{\"subcommand\": str, \"data\": <result>}`` on success.\n            ``{\"subcommand\": str, \"data\": [], \"warning\": str}`` on\n            fail-open paths. NEVER raises.\n        \"\"\"\n        project_dir_raw = context.get(\"project_dir\")\n        if project_dir_raw is None:\n            return {\n                \"subcommand\": subcommand,\n                \"data\": [],\n                \"warning\": \"project_dir_missing\",\n            }\n        project_dir = Path(project_dir_raw)\n\n        # AC-R-1 — forged-write probe at dispatcher entry.\n        forged = _is_forged_write(params if isinstance(params, dict) else {})\n        if forged is not None:\n            return {\n                \"subcommand\": subcommand,\n                \"data\": [],\n                \"__error__\": {\n                    \"code\": -32602,\n                    \"message\": f\"read_only_violation:forbidden_param:{forged}\",\n                },\n            }\n\n        module = _load_audit_query(project_dir)\n        if module is None:\n            return {\n                \"subcommand\": subcommand,\n                \"data\": [],\n                \"warning\": _LOAD_ERROR or \"load_failed\",\n            }\n\n        cmd_fn = getattr(module, cmd_fn_name, None)\n        if cmd_fn is None:\n            return {\n                \"subcommand\": subcommand,\n                \"data\": [],\n                \"warning\": f\"cmd_fn_missing:{cmd_fn_name}\",\n            }\n\n        ns = _build_namespace(params if isinstance(params, dict) else {})\n\n        try:\n            if subcommand in _NO_ENTRIES_SUBCOMMANDS:\n                # cmd_errors(args) — no entries parameter.\n                result = cmd_fn(ns)\n            else:\n                entries = _load_entries(module, ns, project_dir)\n                result = cmd_fn(entries, ns)\n        except Exception as e:\n            return {\n                \"subcommand\": subcommand,\n                \"data\": [],\n                \"warning\": f\"cmd_failed:{type(e).__name__}\",\n            }\n\n        # Coerce result to a JSON-serializable shape. cmd_* returns\n        # dict | list | scalar — wrap into a uniform envelope.\n        if isinstance(result, dict):\n            return {\"subcommand\": subcommand, \"data\": result}\n        if isinstance(result, list):\n            return {\"subcommand\": subcommand, \"data\": result, \"count\": len(result)}\n        return {\"subcommand\": subcommand, \"data\": result}\n\n    handle.__name__ = f\"handle_audit_query_{subcommand}\"\n    handle.__qualname__ = handle.__name__\n    return handle\n\n\ndef _load_entries(\n    module: types.ModuleType,\n    ns: argparse.Namespace,\n    project_dir: Path,\n) -> List[Dict[str, Any]]:\n    \"\"\"Load audit-log entries via audit-query helpers.\"\"\"\n    default_path_fn = getattr(module, \"default_log_path\", None)\n    discover_fn = getattr(module, \"discover_logs\", None)\n    read_fn = getattr(module, \"read_entries\", None)\n    if default_path_fn is None or discover_fn is None or read_fn is None:\n        return []\n    log_path = Path(ns.log) if ns.log else default_path_fn()\n    paths = discover_fn(log_path, bool(getattr(ns, \"include_rotated\", False)))\n    try:\n        return read_fn(paths)\n    except TypeError:\n        # Some audit-query versions accept (paths, args).\n        try:\n            return read_fn(paths, ns)\n        except Exception:\n            return []\n    except Exception:\n        return []\n\n\n# ---------------------------------------------------------------------------\n# Public registry — consumed by dispatch.py to register one handler per\n# sub-command.\n# ---------------------------------------------------------------------------\n\n\nHANDLERS: Dict[str, Any] = {\n    f\"audit_query.{suffix}\": _make_handler(suffix)\n    for suffix in ALLOWED_SUBCOMMANDS","numLines":320,"startLine":55,"totalLines":385}},"tool_result_meta":[{"id":"toolu_01LTLdE7bEghve7pCtdNSFqG","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
