{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KGoMzDpWAic3zzvN5FnEgb","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tdef load_transcripts_instrument():\n4\t    \"\"\"Import `ceo-cost-transcripts.py` from next to this file, or None.\n5\t\n6\t    Fail-soft by construction: an unimportable instrument degrades the\n7\t    primary source to a labelled note, it never breaks the audit rollup.\n8\t    \"\"\"\n9\t    cached = sys.modules.get(_TRANSCRIPTS_MODULE_NAME)\n10\t    if cached is not None:\n11\t        return cached\n12\t    src = Path(__file__).resolve().parent / _TRANSCRIPTS_FILENAME\n13\t    if not src.is_file():\n14\t        return None\n15\t    try:\n16\t        spec = importlib.util.spec_from_file_location(\n17\t            _TRANSCRIPTS_MODULE_NAME, src\n18\t        )\n19\t        if spec is None or spec.loader is None:\n20\t            return None\n21\t        mod = importlib.util.module_from_spec(spec)\n22\t        # Registered BEFORE exec_module: with `from __future__ import\n23\t        # annotations`, @dataclass resolves sys.modules[cls.__module__] at\n24\t        # class-definition time and blows up on a missing entry.\n25\t        sys.modules[_TRANSCRIPTS_MODULE_NAME] = mod\n26\t        spec.loader.exec_module(mod)\n27\t        return mod\n28\t    except Exception:\n29\t        sys.modules.pop(_TRANSCRIPTS_MODULE_NAME, None)\n30\t        return None\n31\t\n32\t\n33\tdef transcripts_root(root_arg: Optional[str] = None) -> Optional[Path]:\n34\t    \"\"\"Resolve the transcripts corpus root (flag > env > shared resolver).\"\"\"\n35\t    mod = load_transcripts_instrument()\n36\t    if mod is None:\n37\t        return Path(root_arg) if root_arg else None\n38\t    return mod.resolve_root(root_arg)\n39\t\n40\t\n41\tdef _tx_audit_pinned(path_arg: Optional[str] = None) -> bool:\n42\t    \"\"\"True when the SECONDARY (audit) ledger was pointed at a specific\n43\t    place — by flag or by CEO_AUDIT_LOG_PATH / CEO_AUDIT_LOG_DIR. Rail r3\n44\t    P1-1: a flag is not the only carrier, and the cross-project pairing only\n45\t    EXISTS when both ledgers are on screen.\n46\t    \"\"\"\n47\t    mod = load_transcripts_instrument()\n48\t    if mod is None:\n49\t        return bool(path_arg)\n50\t    return mod.audit_source_is_pinned(\n51\t        path_arg, carriers=_AUDIT_ENV_CARRIERS\n52\t    )\n53\t\n54\t\n55\tdef collect_transcripts(\n56\t    root_arg: Optional[str] = None,\n57\t    cutoff: Optional[datetime] = None,\n58\t    audit_override: bool = False,\n59\t) -> Dict[str, Any]:\n60\t    \"\"\"Primary-source rollup, or a `{\"available\": False, \"reason\": ...}` note.\n61\t\n62\t    `budget-summary` has no `--by` flag, so the breakdown dimension is fixed\n63\t    to `model` — the same dimension its audit-side `per_plan` table is most\n64\t    comparable against. `audit_override` says `--audit-dir` pointed the\n65\t    SECONDARY source at an explicit path; with no explicit transcripts root\n66\t    that pairing crosses projects and is refused by name (rail r2 P1-1).\n67\t    \"\"\"\n68\t    mod = load_transcripts_instrument()\n69\t    if mod is None:\n70\t        return {\n71\t            \"available\": False,\n72\t            \"reason\": \"instrument ceo-cost-transcripts.py is not importable\",\n73\t        }\n74\t    return mod.collect(\n75\t        root_arg=root_arg,\n76\t        cutoff=cutoff,\n77\t        by=\"model\",\n78\t        audit_override=audit_override,\n79\t    )\n80\t\n81\t\n82\tdef format_human(data: Dict[str, Any], memory_claim: Optional[Dict[str, Any]] = None) -> str:\n83\t    \"\"\"Render the rollup as a human-readable text block.\n84\t\n85\t    PLAN-186 W0 (AC-1b): when `data` carries a `source` key the PRIMARY\n86\t    transcripts block is rendered first, labelled; `source == 'audit'`\n87\t    sets NO key at all, so that rendering is byte-identical to the\n88\t    pre-integration one.\n89\t    \"\"\"\n90\t    lines: List[str] = []"}]},"parent_tool_