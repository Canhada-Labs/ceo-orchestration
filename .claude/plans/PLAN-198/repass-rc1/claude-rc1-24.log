{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Wjg4Ga9vmvYvqVmZVW6nuQ","type":"tool_result","content":"1\t\"\"\"critical audit-query declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport csv\n7\timport io\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\tfrom collections import Counter, defaultdict\n13\tfrom datetime import datetime, timedelta, timezone\n14\tfrom pathlib import Path\n15\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n16\t\n17\t__all__ = ('_CRITICAL_SECURITY_ACTIONS', '_CRITICAL_ACTION_DOMAIN', '_CRITICAL_SAFE_SUMMARY_KEYS', 'cmd_critical', '_CRITICAL_SECURITY_ACTION_SET', '_critical_safe_summary')\n18\t\n19\t\n20\t_CRITICAL_SECURITY_ACTIONS: Tuple[str, ...] = (\n21\t    # --- federation (cross-machine peer trust / write-mode) ---\n22\t    \"federation_autonomous_call_blocked\",\n23\t    \"federation_cert_revoked\",\n24\t    \"federation_event_action_blocked\",\n25\t    \"federation_hmac_secret_rotated\",\n26\t    \"federation_key_floor_rejected\",\n27\t    \"federation_lan_bind_denied\",\n28\t    \"federation_peer_revoked_remote\",\n29\t    \"federation_scope_denied\",\n30\t    \"federation_spki_fingerprint_mismatch\",\n31\t    \"federation_tamper_detected\",\n32\t    \"federation_write_attempt_blocked\",\n33\t    \"federation_write_endpoint_denied\",\n34\t    # --- mcp (bearer-token / tenant isolation) ---\n35\t    \"mcp_bearer_replay_rejected\",\n36\t    \"mcp_cross_tenant_denied\",\n37\t    \"mcp_non_loopback_rejected\",\n38\t    # --- sentinel-signer (GPG quorum / rotation / revocation) ---\n39\t    \"gpg_signed\",\n40\t    \"gpg_verified\",\n41\t    \"sentinel_signer_expiry_warned\",\n42\t    \"sentinel_signer_quorum_attempted\",\n43\t    \"sentinel_signer_quorum_failed\",\n44\t    \"sentinel_signer_revoked\",\n45\t    \"sentinel_signer_rotated\",\n46\t    # --- trading (kill-switch / write-override) ---\n47\t    \"trading_kill_switch_disabled\",\n48\t    \"trading_kill_switch_invoked\",\n49\t    \"trading_write_override_used\",\n50\t    # --- credential (age / emergency override) ---\n51\t    \"credential_blocked_due_to_age\",\n52\t    \"credential_emergency_override_used\",\n53\t    # --- audit-spool (tamper detection) ---\n54\t    \"audit_spool_tamper_detected\",\n55\t    # --- governance (kernel / kill-switch / overrides / pair-rail / swarm) ---\n56\t    \"anti_ceo_overhead_override_used\",\n57\t    \"bash_canonical_bypass_invoked\",\n58\t    \"confidence_gate_blocked\",\n59\t    \"kernel_extension_landed\",\n60\t    \"kill_switch_invoked\",\n61\t    \"live_adapter_blocked\",\n62\t    \"pair_rail_codex_injection_detected\",\n63\t    \"pair_rail_outgoing_redaction_applied\",\n64\t    \"phase_c_enforcing_flipped\",\n65\t    \"swarm_layer_3_4_blocked\",\n66\t)\n67\t\n68\t# Map each critical action to its domain group (for the table/json output).\n69\t# Domains mirror the comment blocks in _CRITICAL_SECURITY_ACTIONS above.\n70\t_CRITICAL_ACTION_DOMAIN: Dict[str, str] = {\n71\t    # federation\n72\t    \"federation_autonomous_call_blocked\": \"federation\",\n73\t    \"federation_cert_revoked\": \"federation\",\n74\t    \"federation_event_action_blocked\": \"federation\",\n75\t    \"federation_hmac_secret_rotated\": \"federation\",\n76\t    \"federation_key_floor_rejected\": \"federation\",\n77\t    \"federation_lan_bind_denied\": \"federation\",\n78\t    \"federation_peer_revoked_remote\": \"federation\",\n79\t    \"federation_scope_denied\": \"federation\",\n80\t    \"federation_spki_fingerprint_mismatch\": \"federation\",\n81\t    \"federation_tamper_detected\": \"federation\",\n82\t    \"federation_write_attempt_blocked\": \"federation\",\n83\t    \"federation_write_endpoint_denied\": \"federation\",\n84\t    # mcp\n85\t    \"mcp_bearer_replay_rejected\": \"mcp\",\n86\t    \"mcp_cross_tenant_denied\": \"mcp\",\n87\t    \"mcp_non_loopback_rejected\": \"mcp\",\n88\t    # sentinel-signer\n89\t    \"gpg_signed\": \"sentinel-signer\",\n90\t    \"gpg_verified\": \"sentinel-signer\",\n91\t    \"sentinel_signer_expiry_warned\": \"sentinel-signer\",\n92\t    \"sentinel_signer_quorum_attempted\": \"sentinel-signer\",\n93\t    \"sentinel_signer_quorum_failed\": \"sentinel-signer\",\n94\t    \"sentinel_signer_revoked\": \"sentinel-signer\",\n95\t    \"sentinel_signer_rotated\": \"sentinel-signer\",\n96\t    # trading\n97\t    \"trading_kill_switch_disabled\": \"trading\",\n98\t    \"trading_kill_switch_invoked\": \"trading\",\n99\t    \"trading_write_override_used\": \"trading\",\n100\t    # credential\n101\t    \"credential_blocked_due_to_age\": \"credential\",\n102\t    \"credential_emergency_override_used\": \"credential\",\n103\t    # audit-spool\n104\t    \"audit_spool_tamper_detected\": \"audit-spool\",\n105\t    # governance\n106\t    \"anti_ceo_overhead_override_used\": \"governance\",\n107\t    \"bash_canonical_bypass_invoked\": \"governance\",\n108\t    \"confidence_gate_blocked\": \"governance\",\n109\t    \"kernel_extension_landed\": \"governance\",\n110\t    \"kill_switch_invoked\": \"governance\",\n111\t    \"live_adapter_blocked\": \"governance\",\n112\t    \"pair_rail_codex_injection_detected\": \"governance\",\n113\t    \"pair_rail_outgoing_redaction_applied\": \"governance\",\n114\t    \"phase_c_enforcing_flipped\": \"governance\",\n115\t    \"swarm_layer_3_4_blocked\": \"governance\",\n116\t}\n117\t\n118\t# Allowlist of SAFE, schema-stable scalar summary keys to echo when present\n119\t# on a critical event. We never echo arbitrary fields (avoids surfacing\n120\t# large/unexpected payloads) and never INVENT a field — only keys in this set\n121\t# that actually exist on the event dict are surfaced, and only scalar values\n122\t# (str/int/float/bool). These keys are all part of audit_emit's per-action\n123\t# allowlists (already scrubbed at emit time) so echoing them is safe.\n124\t_CRITICAL_SAFE_SUMMARY_KEYS: Tuple[str, ...] = (\n125\t    \"session_id\",\n126\t    \"project\",\n127\t    \"reason\",\n128\t    \"reason_code\",\n129\t    \"scope\",\n130\t    \"phase\",\n131\t    \"migration_phase\",\n132\t    \"env_value\",\n133\t    \"mode\",\n134\t    \"outcome\",\n135\t    \"decision\",\n136\t    \"peer_id\",\n137\t    \"endpoint\",\n138\t    \"tenant\",\n139\t    \"signer\",\n140\t    \"key_id\",\n141\t    \"fingerprint\",\n142\t    \"loop_id\",\n143\t    \"redaction_count\",\n144\t    \"field_count\",\n145\t)\n146\t\n147\t\n148\tdef cmd_critical(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n149\t    \"\"\"`audit-query critical` — surface the 38 critical-security actions.\n150\t\n151\t    PLAN-113 Phase B, Wave W1 (audit-reader-coverage). Each action in\n152\t    ``_CRITICAL_SECURITY_ACTIONS`` is emitted by a hook but had no reader\n153\t    handler, so an operator could not query it. This command aggregates,\n154\t    per critical action that appears in the log: ``count``, first/last ISO\n155\t    timestamp, and a compact set of SAFE summary fields drawn from the\n156\t    LATEST matching event (only keys in ``_CRITICAL_SAFE_SUMMARY_KEYS`` that\n157\t    are actually present + scalar — no invented fields).\n158\t\n159\t    Actions with ZERO occurrences are STILL emitted with ``count=0`` so a\n160\t    missing-but-expected critical event is visible (surfacing absence is the\n161\t    whole point of the reader-coverage gap PLAN-112 found).\n162\t\n163\t    ``--action <name>`` drills into one action; the name must be in the\n164\t    registry (else error). Output is a table (default) or JSON (``--json``).\n165\t\n166\t    Output envelope (mirrors the other v-era commands):\n167\t        {\"query\": \"critical\", \"version\": \"1\",\n168\t         \"data\": {\"action_filter\": ..., \"total_critical_events\": N,\n169\t                  \"present_action_count\": M, \"registry_size\": 38,\n170\t                  \"actions\": [{action, domain, count, first_ts, last_ts,\n171\t                               last_summary: {...}}, ...]}}\n172\t    \"\"\"\n173\t    action_filter = getattr(args, \"action\", None)\n174\t    if action_filter is not None:\n175\t        if action_filter not in _CRITICAL_SECURITY_ACTION_SET:\n176\t            print(\n177\t                f\"[audit-query] ERROR: critical: unknown --action \"\n178\t                f\"{action_filter!r}; must be one of the \"\n179\t                f\"{len(_CRITICAL_SECURITY_ACTIONS)} registry actions\",\n180\t                file=sys.stderr,\n181\t            )\n182\t            sys.exit(1)\n183\t        registry: Tuple[str, ...] = (action_filter,)\n184\t    else:\n185\t        registry = _CRITICAL_SECURITY_ACTIONS\n186\t\n187\t    # Single pass: accumulate count / first_ts / last_ts / latest-event\n188\t    # safe-summary per critical action. We only track actions in `registry`.\n189\t    registry_set = set(registry)\n190\t    agg: Dict[str, Dict[str, Any]] = {\n191\t        a: {\"count\": 0, \"first_ts\": \"\", \"last_ts\": \"\", \"last_summary\": {}}\n192\t        for a in registry\n193\t    }\n194\t    total_critical_events = 0\n195\t\n196\t    for e in entries:\n197\t        action = e.get(\"action\")\n198\t        if action not in registry_set:\n199\t            continue\n200\t        a = agg[action]\n201\t        a[\"count\"] += 1\n202\t        total_critical_events += 1\n203\t        ts = str(e.get(\"ts\") or \"\")\n204\t        if ts:\n205\t            if not a[\"first_ts\"] or ts < a[\"first_ts\"]:\n206\t                a[\"first_ts\"] = ts\n207\t            if ts >= a[\"last_ts\"]:\n208\t                a[\"last_ts\"] = ts\n209\t                a[\"last_summary\"] = _critical_safe_summary(e)\n210\t\n211\t    actions: List[Dict[str, Any]] = []\n212\t    present_action_count = 0\n213\t    # Stable order: by domain, then action name (registry is the universe).\n214\t    for action in sorted(\n215\t        registry,\n216\t        key=lambda x: (_CRITICAL_ACTION_DOMAIN.get(x, \"zzz\"), x),\n217\t    ):\n218\t        a = agg[action]\n219\t        if a[\"count\"] > 0:\n220\t            present_action_count += 1\n221\t        actions.append(\n222\t            {\n223\t                \"action\": action,\n224\t                \"domain\": _CRITICAL_ACTION_DOMAIN.get(action, \"unknown\"),\n225\t                \"count\": a[\"count\"],\n226\t                \"first_ts\": a[\"first_ts\"],\n227\t                \"last_ts\": a[\"last_ts\"],\n228\t                \"last_summary\": a[\"last_summary\"],\n229\t            }\n230\t        )\n231\t\n232\t    data = {\n233\t        \"action_filter\": action_filter,\n234\t        \"registry_size\": len(_CRITICAL_SECURITY_ACTIONS),\n235\t        \"total_critical_events\": total_critical_events,\n236\t        \"present_action_count\": present_action_count,\n237\t        \"absent_action_count\": len(registry) - present_action_count,\n238\t        \"actions\": actions,\n239\t    }\n240\t    return {\n241\t        \"query\": \"critical\",\n242\t        \"version\": \"1\",\n243\t        \"data\": data,\n244\t    }\n245\t\n246\t\n247\t# Set form for O(1) membership tests (validation + per-entry filter).\n248\t_CRITICAL_SECURITY_ACTION_SET = frozenset(_CRITICAL_SECURITY_ACTIONS)\n249\t\n250\t\n251\tdef _critical_safe_summary(event: Dict[str, Any]) -> Dict[str, Any]:\n252\t    \"\"\"Echo only the SAFE, scalar summary keys present on a critical event.\n253\t\n254\t    Never invents a field: iterates ``_CRITICAL_SAFE_SUMMARY_KEYS`` and copies\n255\t    a key only when it exists on the event AND its value is a scalar\n256\t    (str/int/float/bool). This keeps the per-action summary compact and avoids\n257\t    surfacing large/unexpected payloads.\n258\t    \"\"\"\n259\t    out: Dict[str, Any] = {}\n260\t    for key in _CRITICAL_SAFE_SUMMARY_KEYS:\n261\t        if key not in event:\n262\t            continue\n263\t        val = event[key]\n264\t        if isinstance(val, bool) or isinstance(val, (str, int, float)):\n265\t            out[key] = val\n266\t    return out\n267\t\n268\t\n269\t"}]},"parent_tool_use_id":null,"session_id":"208d6398-50f3-4598-a736-f21d26865a99","uuid":"d3bbebac-9fca-4d91-a1ca-cfcfb03ff8f3","timestamp":"2026-11-15T10:58:53.741Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_audit_query/critical.py","content":"\"\"\"critical audit-query declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport io\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n\n__all__ = ('_CRITICAL_SECURITY_ACTIONS', '_CRITICAL_ACTION_DOMAIN', '_CRITICAL_SAFE_SUMMARY_KEYS', 'cmd_critical', '_CRITICAL_SECURITY_ACTION_SET', '_critical_safe_summary')\n\n\n_CRITICAL_SECURITY_ACTIONS: Tuple[str, ...] = (\n    # --- federation (cross-machine peer trust / write-mode) ---\n    \"federation_autonomous_call_blocked\",\n    \"federation_cert_revoked\",\n    \"federation_event_action_blocked\",\n    \"federation_hmac_secret_rotated\",\n    \"federation_key_floor_rejected\",\n    \"federation_lan_bind_denied\",\n    \"federation_peer_revoked_remote\",\n    \"federation_scope_denied\",\n    \"federation_spki_fingerprint_mismatch\",\n    \"federation_tamper_detected\",\n    \"federation_write_attempt_blocked\",\n    \"federation_write_endpoint_denied\",\n    # --- mcp (bearer-token / tenant isolation) ---\n    \"mcp_bearer_replay_rejected\",\n    \"mcp_cross_tenant_denied\",\n    \"mcp_non_loopback_rejected\",\n    # --- sentinel-signer (GPG quorum / rotation / revocation) ---\n    \"gpg_signed\",\n    \"gpg_verified\",\n    \"sentinel_signer_expiry_warned\",\n    \"sentinel_signer_quorum_attempted\",\n    \"sentinel_signer_quorum_failed\",\n    \"sentinel_signer_revoked\",\n    \"sentinel_signer_rotated\",\n    # --- trading (kill-switch / write-override) ---\n    \"trading_kill_switch_disabled\",\n    \"trading_kill_switch_invoked\",\n    \"trading_write_override_used\",\n    # --- credential (age / emergency override) ---\n    \"credential_blocked_due_to_age\",\n    \"credential_emergency_override_used\",\n    # --- audit-spool (tamper detection) ---\n    \"audit_spool_tamper_detected\",\n    # --- governance (kernel / kill-switch / overrides / pair-rail / swarm) ---\n    \"anti_ceo_overhead_override_used\",\n    \"bash_canonical_bypass_invoked\",\n    \"confidence_gate_blocked\",\n    \"kernel_extension_landed\",\n    \"kill_switch_invoked\",\n    \"live_adapter_blocked\",\n    \"pair_rail_codex_injection_detected\",\n    \"pair_rail_outgoing_redaction_applied\",\n    \"phase_c_enforcing_flipped\",\n    \"swarm_layer_3_4_blocked\",\n)\n\n# Map each critical action to its domain group (for the table/json output).\n# Domains mirror the comment blocks in _CRITICAL_SECURITY_ACTIONS above.\n_CRITICAL_ACTION_DOMAIN: Dict[str, str] = {\n    # federation\n    \"federation_autonomous_call_blocked\": \"federation\",\n    \"federation_cert_revoked\": \"federation\",\n    \"federation_event_action_blocked\": \"federation\",\n    \"federation_hmac_secret_rotated\": \"federation\",\n    \"federation_key_floor_rejected\": \"federation\",\n    \"federation_lan_bind_denied\": \"federation\",\n    \"federation_peer_revoked_remote\": \"federation\",\n    \"federation_scope_denied\": \"federation\",\n    \"federation_spki_fingerprint_mismatch\": \"federation\",\n    \"federation_tamper_detected\": \"federation\",\n    \"federation_write_attempt_blocked\": \"federation\",\n    \"federation_write_endpoint_denied\": \"federation\",\n    # mcp\n    \"mcp_bearer_replay_rejected\": \"mcp\",\n    \"mcp_cross_tenant_denied\": \"mcp\",\n    \"mcp_non_loopback_rejected\": \"mcp\",\n    # sentinel-signer\n    \"gpg_signed\": \"sentinel-signer\",\n    \"gpg_verified\": \"sentinel-signer\",\n    \"sentinel_signer_expiry_warned\": \"sentinel-signer\",\n    \"sentinel_signer_quorum_attempted\": \"sentinel-signer\",\n    \"sentinel_signer_quorum_failed\": \"sentinel-signer\",\n    \"sentinel_signer_revoked\": \"sentinel-signer\",\n    \"sentinel_signer_rotated\": \"sentinel-signer\",\n    # trading\n    \"trading_kill_switch_disabled\": \"trading\",\n    \"trading_kill_switch_invoked\": \"trading\",\n    \"trading_write_override_used\": \"trading\",\n    # credential\n    \"credential_blocked_due_to_age\": \"credential\",\n    \"credential_emergency_override_used\": \"credential\",\n    # audit-spool\n    \"audit_spool_tamper_detected\": \"audit-spool\",\n    # governance\n    \"anti_ceo_overhead_override_used\": \"governance\",\n    \"bash_canonical_bypass_invoked\": \"governance\",\n    \"confidence_gate_blocked\": \"governance\",\n    \"kernel_extension_landed\": \"governance\",\n    \"kill_switch_invoked\": \"governance\",\n    \"live_adapter_blocked\": \"governance\",\n    \"pair_rail_codex_injection_detected\": \"governance\",\n    \"pair_rail_outgoing_redaction_applied\": \"governance\",\n    \"phase_c_enforcing_flipped\": \"governance\",\n    \"swarm_layer_3_4_blocked\": \"governance\",\n}\n\n# Allowlist of SAFE, schema-stable scalar summary keys to echo when present\n# on a critical event. We never echo arbitrary fields (avoids surfacing\n# large/unexpected payloads) and never INVENT a field — only keys in this set\n# that actually exist on the event dict are surfaced, and only scalar values\n# (str/int/float/bool). These keys are all part of audit_emit's per-action\n# allowlists (already scrubbed at emit time) so echoing them is safe.\n_CRITICAL_SAFE_SUMMARY_KEYS: Tuple[str, ...] = (\n    \"session_id\",\n    \"project\",\n    \"reason\",\n    \"reason_code\",\n    \"scope\",\n    \"phase\",\n    \"migration_phase\",\n    \"env_value\",\n    \"mode\",\n    \"outcome\",\n    \"decision\",\n    \"peer_id\",\n    \"endpoint\",\n    \"tenant\",\n    \"signer\",\n    \"key_id\",\n    \"fingerprint\",\n    \"loop_id\",\n    \"redaction_count\",\n    \"field_count\",\n)\n\n\ndef cmd_critical(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n    \"\"\"`audit-query critical` — surface the 38 critical-security actions.\n\n    PLAN-113 Phase B, Wave W1 (audit-reader-coverage). Each action in\n    ``_CRITICAL_SECURITY_ACTIONS`` is emitted by a hook but had no reader\n    handler, so an operator could not query it. This command aggregates,\n    per critical action that appears in the log: ``count``, first/last ISO\n    timestamp, and a compact set of SAFE summary fields drawn from the\n    LATEST matching event (only keys in ``_CRITICAL_SAFE_SUMMARY_KEYS`` that\n    are actually present + scalar — no invented fields).\n\n    Actions with ZERO occurrences are STILL emitted with ``count=0`` so a\n    missing-but-expected critical event is visible (surfacing absence is the\n    whole point of the reader-coverage gap PLAN-112 found).\n\n    ``--action <name>`` drills into one action; the name must be in the\n    registry (else error). Output is a table (default) or JSON (``--json``).\n\n    Output envelope (mirrors the other v-era commands):\n        {\"query\": \"critical\", \"version\": \"1\",\n         \"data\": {\"action_filter\": ..., \"total_critical_events\": N,\n                  \"present_action_count\": M, \"registry_size\": 38,\n                  \"actions\": [{action, domain, count, first_ts, last_ts,\n                               last_summary: {...}}, ...]}}\n    \"\"\"\n    action_filter = getattr(args, \"action\", None)\n    if action_filter is not None:\n        if action_filter not in _CRITICAL_SECURITY_ACTION_SET:\n            print(\n                f\"[audit-query] ERROR: critical: unknown --action \"\n                f\"{action_filter!r}; must be one of the \"\n                f\"{len(_CRITICAL_SECURITY_ACTIONS)} registry actions\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n        registry: Tuple[str, ...] = (action_filter,)\n    else:\n        registry = _CRITICAL_SECURITY_ACTIONS\n\n    # Single pass: accumulate count / first_ts / last_ts / latest-event\n    # safe-summary per critical action. We only track actions in `registry`.\n    registry_set = set(registry)\n    agg: Dict[str, Dict[str, Any]] = {\n        a: {\"count\": 0, \"first_ts\": \"\", \"last_ts\": \"\", \"last_summary\": {}}\n        for a in registry\n    }\n    total_critical_events = 0\n\n    for e in entries:\n        action = e.get(\"action\")\n        if action not in registry_set:\n            continue\n        a = agg[action]\n        a[\"count\"] += 1\n        total_critical_events += 1\n        ts = str(e.get(\"ts\") or \"\")\n        if ts:\n            if not a[\"first_ts\"] or ts < a[\"first_ts\"]:\n                a[\"first_ts\"] = ts\n            if ts >= a[\"last_ts\"]:\n                a[\"last_ts\"] = ts\n                a[\"last_summary\"] = _critical_safe_summary(e)\n\n    actions: List[Dict[str, Any]] = []\n    present_action_count = 0\n    # Stable order: by domain, then action name (registry is the universe).\n    for action in sorted(\n        registry,\n        key=lambda x: (_CRITICAL_ACTION_DOMAIN.get(x, \"zzz\"), x),\n    ):\n        a = agg[action]\n        if a[\"count\"] > 0:\n            present_action_count += 1\n        actions.append(\n            {\n                \"action\": action,\n                \"domain\": _CRITICAL_ACTION_DOMAIN.get(action, \"unknown\"),\n                \"count\": a[\"count\"],\n                \"first_ts\": a[\"first_ts\"],\n                \"last_ts\": a[\"last_ts\"],\n                \"last_summary\": a[\"last_summary\"],\n            }\n        )\n\n    data = {\n        \"action_filter\": action_filter,\n        \"registry_size\": len(_CRITICAL_SECURITY_ACTIONS),\n        \"total_critical_events\": total_critical_events,\n        \"present_action_count\": present_action_count,\n        \"absent_action_count\": len(registry) - present_action_count,\n        \"actions\": actions,\n    }\n    return {\n        \"query\": \"critical\",\n        \"version\": \"1\",\n        \"data\": data,\n    }\n\n\n# Set form for O(1) membership tests (validation + per-entry filter).\n_CRITICAL_SECURITY_ACTION_SET = frozenset(_CRITICAL_SECURITY_ACTIONS)\n\n\ndef _critical_safe_summary(event: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Echo only the SAFE, scalar summary keys present on a critical event.\n\n    Never invents a field: iterates ``_CRITICAL_SAFE_SUMMARY_KEYS`` and copies\n    a key only when it exists on the event AND its value is a scalar\n    (str/int/float/bool). This keeps the per-action summary compact and avoids\n    surfacing large/unexpected payloads.\n    \"\"\"\n    out: Dict[str, Any] = {}\n    for key in _CRITICAL_SAFE_SUMMARY_KEYS:\n        if key not in event:\n            continue\n        val = event[key]\n        if isinstance(val, bool) or isinstance(val, (str, int, float)):\n            out[key] = val\n    return out\n\n\n","numLines":269,"startLine":1,"totalLines":269}},"tool_result_meta":[{"id":"toolu_01Wjg4Ga9vmvYvqVmZVW6nuQ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
