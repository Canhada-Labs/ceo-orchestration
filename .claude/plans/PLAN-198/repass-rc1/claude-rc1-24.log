{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NpkYSyXnaWE2fnRqiz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Lsvb63YcB7mrq344EQTP9a","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/queries.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":677,"cache_read_input_tokens":117753,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":677},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"5e24f49e-2b5f-4ffb-ad24-b0018ecf5bbc","timestamp":"2026-11-13T18:10:38.198Z","request_id":"req_011Ch1NpkLnkUR8xoYPxQorn","wire_tool_inputs":{"toolu_01Lsvb63YcB7mrq344EQTP9a":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/queries.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lsvb63YcB7mrq344EQTP9a","type":"tool_result","content":"1\t\"\"\"Aggregations used by the audit-query compatibility facade.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport csv\n6\timport io\n7\timport json\n8\timport re\n9\timport sys\n10\tfrom collections import Counter, defaultdict\n11\tfrom datetime import datetime, timedelta, timezone\n12\tfrom pathlib import Path\n13\tfrom typing import Any, Dict, Iterable, List, Optional, Tuple\n14\tdef cmd_summary(entries, args) -> Dict[str, Any]:\n15\t    \"\"\"Summary aggregates — single-pass streaming (Perf-P1-002).\n16\t\n17\t    Accepts any iterable of entries. Computes total / first_ts / last_ts /\n18\t    top 5 skills / compliant count in one pass so a 100k-row log does not\n19\t    need to be fully materialized.\n20\t    \"\"\"\n21\t    total = 0\n22\t    first_ts = \"\"\n23\t    last_ts = \"\"\n24\t    skill_counts: Counter = Counter()\n25\t    compliant = 0\n26\t    for e in entries:\n27\t        total += 1\n28\t        ts = e.get(\"ts\", \"\")\n29\t        if ts:\n30\t            if not first_ts or ts < first_ts:\n31\t                first_ts = ts\n32\t            if ts > last_ts:\n33\t                last_ts = ts\n34\t        skill_counts[e.get(\"skill\", \"unknown\")] += 1\n35\t        if (\n36\t            e.get(\"has_profile\")\n37\t            and e.get(\"has_file_assignment\")\n38\t            and e.get(\"skill\") != \"unknown\"\n39\t        ):\n40\t            compliant += 1\n41\t\n42\t    if total == 0:\n43\t        return {\n44\t            \"total_spawns\": 0,\n45\t            \"date_range\": None,\n46\t            \"top_skills\": [],\n47\t            \"compliance_rate\": None,\n48\t        }\n49\t\n50\t    top_skills = skill_counts.most_common(5)\n51\t    compliance_rate = compliant / total\n52\t    return {\n53\t        \"total_spawns\": total,\n54\t        \"date_range\": {\"from\": first_ts, \"to\": last_ts},\n55\t        \"top_skills\": [{\"skill\": s, \"count\": c} for s, c in top_skills],\n56\t        \"compliance_rate\": round(compliance_rate, 3),\n57\t        \"compliant_spawns\": compliant,\n58\t    }\n59\t\n60\t\n61\tdef cmd_by_skill(entries, args) -> List[Dict[str, Any]]:\n62\t    \"\"\"Streamable — single-pass Counter aggregation (Perf-P1-002).\"\"\"\n63\t    counts: Counter = Counter()\n64\t    for e in entries:\n65\t        counts[e.get(\"skill\", \"unknown\")] += 1\n66\t    top = counts.most_common(args.top)\n67\t    return [{\"skill\": s, \"count\": c} for s, c in top]\n68\t\n69\t\n70\tdef cmd_compliance(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n71\t    \"\"\"Handle the `audit-query compliance` sub-command — SOC2/LGPD evidence pack.\"\"\"\n72\t    total = len(entries)\n73\t    if total == 0:\n74\t        return {\n75\t            \"total\": 0,\n76\t            \"has_profile_rate\": None,\n77\t            \"has_file_assignment_rate\": None,\n78\t            \"known_skill_rate\": None,\n79\t        }\n80\t\n81\t    with_profile = sum(1 for e in entries if e.get(\"has_profile\"))\n82\t    with_fa = sum(1 for e in entries if e.get(\"has_file_assignment\"))\n83\t    with_skill = sum(1 for e in entries if e.get(\"skill\") != \"unknown\")\n84\t\n85\t    non_compliant = [\n86\t        {\n87\t            \"ts\": e.get(\"ts\"),\n88\t            \"skill\": e.get(\"skill\", \"unknown\"),\n89\t            \"has_profile\": e.get(\"has_profile\", False),\n90\t            \"has_file_assignment\": e.get(\"has_file_assignment\", False),\n91\t            \"desc_preview\": e.get(\"desc_preview\", \"\"),\n92\t        }\n93\t        for e in entries\n94\t        if not (\n95\t            e.get(\"has_profile\")\n96\t            and e.get(\"has_file_assignment\")\n97\t            and e.get(\"skill\") != \"unknown\"\n98\t        )\n99\t    ]\n100\t\n101\t    return {\n102\t        \"total\": total,\n103\t        \"has_profile\": with_profile,\n104\t        \"has_profile_rate\": round(with_profile / total, 3),\n105\t        \"has_file_assignment\": with_fa,\n106\t        \"has_file_assignment_rate\": round(with_fa / total, 3),\n107\t        \"known_skill\": with_skill,\n108\t        \"known_skill_rate\": round(with_skill / total, 3),\n109\t        \"non_compliant_count\": len(non_compliant),\n110\t        \"non_compliant\": non_compliant[:20],  # cap preview\n111\t    }\n112\t\n113\t\n114\tdef cmd_by_day(entries, args) -> List[Dict[str, Any]]:\n115\t    \"\"\"Streamable — single-pass histogram (Perf-P1-002).\n116\t\n117\t    Fast-path: cutoff is compared as a fixed YYYY-MM-DD string (since our\n118\t    `ts` format is lexicographically sortable). We only fall back to\n119\t    ``datetime.strptime`` when the raw timestamp doesn't match the\n120\t    expected 20-char ISO-Z shape — a rare case (parse errors / rotated\n121\t    schemas) that does not dominate 100k-entry runs.\n122\t    \"\"\"\n123\t    days = args.days\n124\t    now = datetime.now(timezone.utc)\n125\t    cutoff = now - timedelta(days=days)\n126\t    cutoff_day = cutoff.strftime(\"%Y-%m-%d\")\n127\t    histogram: Dict[str, int] = defaultdict(int)\n128\t    for e in entries:\n129\t        ts = e.get(\"ts\", \"\")\n130\t        if not ts:\n131\t            continue\n132\t        # Fast path: YYYY-MM-DDTHH:MM:SSZ is 20 chars with day at 0..10\n133\t        if len(ts) >= 20 and ts.endswith(\"Z\") and ts[10:11] == \"T\":\n134\t            day_key = ts[:10]\n135\t            # Lexicographic compare works because YYYY-MM-DD is fixed width.\n136\t            if day_key < cutoff_day:\n137\t                continue\n138\t        else:\n139\t            try:\n140\t                when = datetime.strptime(ts, \"%Y-%m-%dT%H:%M:%SZ\").replace(\n141\t                    tzinfo=timezone.utc\n142\t                )\n143\t            except ValueError:\n144\t                continue\n145\t            if when < cutoff:\n146\t                continue\n147\t            day_key = when.strftime(\"%Y-%m-%d\")\n148\t        histogram[day_key] += 1\n149\t\n150\t    result = [\n151\t        {\"date\": day, \"count\": count}\n152\t        for day, count in sorted(histogram.items())\n153\t    ]\n154\t    return result\n155\t\n156\t\n157\tdef cmd_search(entries, args) -> List[Dict[str, Any]]:\n158\t    \"\"\"Streamable — filter via regex (Perf-P1-002).\"\"\"\n159\t    try:\n160\t        pattern = re.compile(args.regex, flags=re.IGNORECASE)\n161\t    except re.error as e:\n162\t        print(f\"[audit-query] ERROR: bad regex: {e}\", file=sys.stderr)\n163\t        sys.exit(1)\n164\t    matches = []\n165\t    for e in entries:\n166\t        preview = e.get(\"desc_preview\", \"\")\n167\t        if pattern.search(preview):\n168\t            matches.append(\n169\t                {\n170\t                    \"ts\": e.get(\"ts\"),\n171\t                    \"skill\": e.get(\"skill\"),\n172\t                    \"desc_preview\": preview,\n173\t                    \"desc_hash\": e.get(\"desc_hash\"),\n174\t                }\n175\t            )\n176\t    return matches\n177\t\n178\t\n179\tdef cmd_since(entries, args) -> List[Dict[str, Any]]:\n180\t    \"\"\"Streamable — filter by date cutoff (Perf-P1-002).\"\"\"\n181\t    # Parse the input date (supports YYYY-MM-DD, YYYY-MM-DDTHH:MM:SSZ)\n182\t    raw = args.iso_date\n183\t    parsed = None\n184\t    for fmt in (\"%Y-%m-%dT%H:%M:%SZ\", \"%Y-%m-%d\"):\n185\t        try:\n186\t            parsed = datetime.strptime(raw, fmt).replace(tzinfo=timezone.utc)\n187\t            break\n188\t        except ValueError:\n189\t            continue\n190\t    if parsed is None:\n191\t        print(\n192\t            f\"[audit-query] ERROR: cannot parse date {raw!r} \"\n193\t            \"(use YYYY-MM-DD or YYYY-MM-DDTHH:MM:SSZ)\",\n194\t            file=sys.stderr,\n195\t        )\n196\t        sys.exit(1)\n197\t\n198\t    # Fast path: both parsed cutoff and entry ts are ISO-Z → string compare\n199\t    # is equivalent to datetime compare (fixed-width YYYY-MM-DDTHH:MM:SSZ).\n200\t    # Falls back to strptime for non-canonical ts shapes.\n201\t    cutoff_str = parsed.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n202\t    out = []\n203\t    for e in entries:\n204\t        ts = e.get(\"ts\", \"\")\n205\t        if len(ts) >= 20 and ts.endswith(\"Z\") and ts[10:11] == \"T\":\n206\t            if ts >= cutoff_str:\n207\t                out.append(e)\n208\t            continue\n209\t        try:\n210\t            when = datetime.strptime(ts, \"%Y-%m-%dT%H:%M:%SZ\").replace(\n211\t                tzinfo=timezone.utc\n212\t            )\n213\t        except ValueError:\n214\t            continue\n215\t        if when >= parsed:\n216\t            out.append(e)\n217\t    return out\n218\t\n219\t\n220\tdef cmd_stats(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n221\t    \"\"\"Handle the `audit-query stats` sub-command — aggregate counts by action.\"\"\"\n222\t    # PLAN-125 WS-1 — per-tool-call lifecycle latency view (--tool-latency).\n223\t    if getattr(args, \"tool_latency\", False):\n224\t        return _tool_latency_stats(entries)\n225\t\n226\t    total = len(entries)\n227\t    if total == 0:\n228\t        return {\"total\": 0}\n229\t\n230\t    bucket_counts = Counter(\n231\t        e.get(\"prompt_len_bucket\", \"unknown\") for e in entries\n232\t    )\n233\t    response_kinds = Counter(e.get(\"response_kind\", \"absent\") for e in entries)\n234\t\n235\t    # hook_duration_ms stats (tolerates missing — older entries don't have it)\n236\t    durations = [\n237\t        e.get(\"hook_duration_ms\")\n238\t        for e in entries\n239\t        if isinstance(e.get(\"hook_duration_ms\"), (int, float))\n240\t    ]\n241\t    duration_summary: Dict[str, Any]\n242\t    if durations:\n243\t        durations_sorted = sorted(durations)\n244\t        duration_summary = {\n245\t            \"count\": len(durations_sorted),\n246\t            \"min_ms\": durations_sorted[0],\n247\t            \"max_ms\": durations_sorted[-1],\n248\t            \"mean_ms\": round(sum(durations_sorted) / len(durations_sorted), 1),\n249\t            \"p50_ms\": _percentile(durations_sorted, 50),\n250\t            \"p95_ms\": _percentile(durations_sorted, 95),\n251\t            \"p99_ms\": _percentile(durations_sorted, 99),\n252\t        }\n253\t    else:\n254\t        duration_summary = {\"count\": 0}\n255\t\n256\t    return {\n257\t        \"total\": total,\n258\t        \"prompt_len_buckets\": dict(bucket_counts),\n259\t        \"response_kinds\": dict(response_kinds),\n260\t        \"hook_duration_ms\": duration_summary,\n261\t    }\n262\t\n263\t\n264\tdef _tool_latency_stats(entries: List[Dict[str, Any]]) -> Dict[str, Any]:\n265\t    \"\"\"PLAN-125 WS-1 — per-tool lifecycle bucket histogram.\n266\t\n267\t    Reads ``tool_call_lifecycle_recorded`` rows and rolls up, per\n268\t    ``tool_name_enum``, a Counter of ``duration_bucket`` plus success / orphan\n269\t    tallies. Bucket-counts ONLY — the action never records a raw\n270\t    ``duration_ms`` (MF-SEC-3), so there are no percentiles to compute.\n271\t    \"\"\"\n272\t    rows = [\n273\t        e for e in entries\n274\t        if e.get(\"action\") == \"tool_call_lifecycle_recorded\"\n275\t    ]\n276\t    per_tool: Dict[str, Dict[str, Any]] = {}\n277\t    for e in rows:\n278\t        tool = e.get(\"tool_name_enum\", \"other\")\n279\t        if not isinstance(tool, str):\n280\t            tool = \"other\"\n281\t        slot = per_tool.setdefault(\n282\t            tool,\n283\t            {\"count\": 0, \"duration_buckets\": Counter(),\n284\t             \"success\": 0, \"failure\": 0, \"orphan\": 0},\n285\t        )\n286\t        slot[\"count\"] += 1\n287\t        bucket = e.get(\"duration_bucket\", \"unknown\")\n288\t        if not isinstance(bucket, str):\n289\t            bucket = \"unknown\"\n290\t        slot[\"duration_buckets\"][bucket] += 1\n291\t        if e.get(\"orphan\") is True:\n292\t            slot[\"orphan\"] += 1\n293\t        if e.get(\"success\") is True:\n294\t            slot[\"success\"] += 1\n295\t        elif e.get(\"success\") is False:\n296\t            slot[\"failure\"] += 1\n297\t\n298\t    # Materialize Counters to plain dicts for JSON / display.\n299\t    tool_latency = {\n300\t        tool: {\n301\t            \"count\": slot[\"count\"],\n302\t            \"duration_buckets\": dict(slot[\"duration_buckets\"]),\n303\t            \"success\": slot[\"success\"],\n304\t            \"failure\": slot[\"failure\"],\n305\t            \"orphan\": slot[\"orphan\"],\n306\t        }\n307\t        for tool, slot in sorted(per_tool.items())\n308\t    }\n309\t    return {\n310\t        \"total_lifecycle_rows\": len(rows),\n311\t        \"tool_latency\": tool_latency,\n312\t    }\n313\t\n314\t\n315\tdef _percentile(sorted_values: List[float], p: float) -> float:\n316\t    if not sorted_values:\n317\t        return 0.0\n318\t    k = (len(sorted_values) - 1) * (p / 100.0)\n319\t    f = int(k)\n320\t    c = min(f + 1, len(sorted_values) - 1)\n321\t    if f == c:\n322\t        return round(float(sorted_values[f]), 1)\n323\t    return round(\n324\t        sorted_values[f] + (sorted_values[c] - sorted_values[f]) * (k - f),\n325\t        1,\n326\t    )\n327\t\n328\t\n329\tdef cmd_errors(args) -> Dict[str, Any]:\n330\t    err_path = Path(args.errors_path) if args.errors_path else default_errors_path()\n331\t    if not err_path.is_file():\n332\t        return {\"errors_path\": str(err_path), \"count\": 0, \"lines\": []}\n333\t    try:\n334\t        text = err_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n335\t    except OSError as e:\n336\t        print(f\"[audit-query] ERROR: cannot read {err_path}: {e}\", file=sys.stderr)\n337\t        sys.exit(2)\n338\t    lines = [ln for ln in text.split(\"\\n\") if ln.strip()]\n339\t    return {\n340\t        \"errors_path\": str(err_path),\n341\t        \"count\": len(lines),\n342\t        \"lines\": lines[-50:],  # tail\n343\t    }\n344\t\n345\t\n346\tdef cmd_debate(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n347\t    \"\"\"Group debate_event rows by (plan_id, round). Sprint 5 A.2.\"\"\"\n348\t    groups: Dict[Tuple[str, int], Dict[str, Any]] = {}\n349\t    for e in entries:\n350\t        if e.get(\"action\") != \"debate_event\":\n351\t            continue\n352\t        key = (e.get(\"plan_id\", \"?\"), int(e.get(\"round\") or 0))\n353\t        g = groups.setdefault(\n354\t            key,\n355\t            {\n356\t                \"plan_id\": key[0],\n357\t                \"round\": key[1],\n358\t                \"start_ts\": None,\n359\t                \"consensus_ts\": None,\n360\t                \"agents\": [],\n361\t                \"consensus_adjustments\": None,\n362\t            },\n363\t        )\n364\t        phase = e.get(\"phase\")\n365\t        ts = e.get(\"ts\")\n366\t        if phase == \"start\":\n367\t            g[\"start_ts\"] = ts\n368\t        elif phase == \"agent-done\":\n369\t            agent = e.get(\"agent\")\n370\t            if agent and agent not in g[\"agents\"]:\n371\t                g[\"agents\"].append(agent)\n372\t        elif phase == \"consensus\":\n373\t            g[\"consensus_ts\"] = ts\n374\t            if e.get(\"consensus_adjustments_count\") is not None:\n375\t                g[\"consensus_adjustments\"] = e[\"consensus_adjustments_count\"]\n376\t    # Sort by (plan_id, round)\n377\t    return [groups[k] for k in sorted(groups.keys())]\n378\t\n379\t\n380\tdef cmd_plans(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n381\t    \"\"\"Show plan status transitions over time. Sprint 5 A.2.\"\"\"\n382\t    by_plan: Dict[str, List[Dict[str, Any]]] = defaultdict(list)\n383\t    for e in entries:\n384\t        if e.get(\"action\") != \"plan_transition\":\n385\t            continue\n386\t        by_plan[e.get(\"plan_id\", \"?\")].append(\n387\t            {\n388\t                \"ts\": e.get(\"ts\"),\n389\t                \"from\": e.get(\"from_status\"),\n390\t                \"to\": e.get(\"to_status\"),\n391\t                \"editor\": e.get(\"editor_tool\"),\n392\t            }\n393\t        )\n394\t    # Sort transitions by ts, then emit one row per plan with a chain summary\n395\t    out = []\n396\t    for plan_id in sorted(by_plan.keys()):\n397\t        trans = sorted(by_plan[plan_id], key=lambda t: t.get(\"ts\") or \"\")\n398\t        chain = \"→\".join(\n399\t            [t[\"from\"] for t in trans] + [trans[-1][\"to\"]] if trans else []\n400\t        )\n401\t        out.append(\n402\t            {\n403\t                \"plan_id\": plan_id,\n404\t                \"transitions\": len(trans),\n405\t                \"chain\": chain,\n406\t                \"first_ts\": trans[0][\"ts\"] if trans else None,\n407\t                \"last_ts\": trans[-1][\"ts\"] if trans else None,\n408\t                \"current_status\": trans[-1][\"to\"] if trans else None,\n409\t            }\n410\t        )\n411\t    return out\n412\t\n413\t\n414\tdef cmd_vetoes(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n415\t    \"\"\"Aggregate veto_triggered rows by (hook, reason_code). Sprint 5 A.2.\"\"\"\n416\t    counts: Dict[Tuple[str, str], Dict[str, Any]] = {}\n417\t    for e in entries:\n418\t        if e.get(\"action\") != \"veto_triggered\":\n419\t            continue\n420\t        key = (e.get(\"hook\", \"?\"), e.get(\"reason_code\", \"?\"))\n421\t        g = counts.setdefault(\n422\t            key,\n423\t            {\n424\t                \"hook\": key[0],\n425\t                \"reason_code\": key[1],\n426\t                \"count\": 0,\n427\t                \"first_ts\": None,\n428\t                \"last_ts\": None,\n429\t                \"sample_preview\": \"\",\n430\t            },\n431\t        )\n432\t        g[\"count\"] += 1\n433\t        ts = e.get(\"ts\") or \"\"\n434\t        if g[\"first_ts\"] is None or ts < g[\"first_ts\"]:\n435\t            g[\"first_ts\"] = ts\n436\t        if g[\"last_ts\"] is None or ts > g[\"last_ts\"]:\n437\t            g[\"last_ts\"] = ts\n438\t        if not g[\"sample_preview\"] and e.get(\"reason_preview\"):\n439\t            g[\"sample_preview\"] = e[\"reason_preview\"]\n440\t    return sorted(\n441\t        counts.values(),\n442\t        key=lambda g: (-g[\"count\"], g[\"hook\"], g[\"reason_code\"]),\n443\t    )\n444\t\n445\t\n446\tdef cmd_lessons(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n447\t    \"\"\"Aggregate lesson_write rows by archetype. Sprint 5 A.2.\"\"\"\n448\t    by_arch: Dict[str, Dict[str, Any]] = {}\n449\t    triggers = Counter()\n450\t    for e in entries:\n451\t        if e.get(\"action\") != \"lesson_write\":\n452\t            continue\n453\t        arch = e.get(\"archetype\", \"?\")\n454\t        g = by_arch.setdefault(\n455\t            arch,\n456\t            {\n457\t                \"archetype\": arch,\n458\t                \"count\": 0,\n459\t                \"triggers\": Counter(),\n460\t                \"last_ts\": None,\n461\t            },\n462\t        )\n463\t        g[\"count\"] += 1\n464\t        g[\"triggers\"][e.get(\"trigger\", \"unknown\")] += 1\n465\t        ts = e.get(\"ts\") or \"\"\n466\t        if g[\"last_ts\"] is None or ts > g[\"last_ts\"]:\n467\t            g[\"last_ts\"] = ts\n468\t        triggers[e.get(\"trigger\", \"unknown\")] += 1\n469\t\n470\t    out = []\n471\t    for arch in sorted(by_arch.keys(), key=lambda a: (-by_arch[a][\"count\"], a)):\n472\t        g = by_arch[arch]\n473\t        # Collapse the Counter to a dict for JSON-friendly rendering\n474\t        g[\"triggers\"] = dict(g[\"triggers\"])\n475\t        out.append(g)\n476\t    return out\n477\t\n478\t\n479\tdef _parse_since_arg(raw: str) -> Optional[datetime]:\n480\t    \"\"\"Parse `--since` value: ``24h`` / ``7d`` / ``30m`` / ISO 8601 / ``all``.\n481\t\n482\t    Returns a timezone-aware UTC datetime cutoff, or None for \"all time\".\n483\t    PLAN-009 A18 (shared across new sub-commands).\n484\t    \"\"\"\n485\t    if not raw or raw == \"all\":\n486\t        return None\n487\t    raw = raw.strip().lower()\n488\t    # Shorthand: <int><unit>  (m=minutes, h=hours, d=days)\n489\t    if re.fullmatch(r\"\\d+[mhd]\", raw):\n490\t        n = int(raw[:-1])\n491\t        unit = raw[-1]\n492\t        delta = {\"m\": timedelta(minutes=n), \"h\": timedelta(hours=n), \"d\": timedelta(days=n)}[unit]\n493\t        return datetime.now(timezone.utc) - delta\n494\t    # Try ISO 8601 parse\n495\t    try:\n496\t        if raw.endswith(\"z\"):\n497\t            raw = raw[:-1] + \"+00:00\"\n498\t        dt = datetime.fromisoformat(raw)\n499\t        if dt.tzinfo is None:\n500\t            dt = dt.replace(tzinfo=timezone.utc)\n501\t        return dt\n502\t    except ValueError:\n503\t        return None\n504\t\n505\t\n506\tdef cmd_lessons_effectiveness(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n507\t    \"\"\"`audit-query lessons-effectiveness` — per-lesson effectiveness ranking.\n508\t\n509\t    PLAN-009 Phase 5 P5.1. Aggregates `lesson_outcome` + `lesson_read`\n510\t    events per `lesson_id`; computes effectiveness + injection count +\n511\t    recency; sorts by operator-chosen axis.\n512\t\n513\t    Output envelope (SPEC/v1/audit-query.schema.md):\n514\t        {\"query\": \"lessons-effectiveness\", \"version\": \"1\",\n515\t         \"data\": {\"lessons\": [...]}}\n516\t    \"\"\"\n517\t    since = _parse_since_arg(getattr(args, \"since\", \"24h\"))\n518\t    include_window_only = getattr(args, \"include_window_only\", False)\n519\t    sort_by = getattr(args, \"by\", \"effectiveness\")\n520\t    top_n = int(getattr(args, \"top\", 0) or 0)\n521\t    bottom_n = int(getattr(args, \"bottom\", 0) or 0)\n522\t\n523\t    def _in_window(e: Dict[str, Any]) -> bool:\n524\t        if since is None:\n525\t            return True\n526\t        ts = _parse_since_arg(e.get(\"ts\", \"\"))\n527\t        return ts is None or ts >= since\n528\t\n529\t    from collections import defaultdict\n530\t    agg: Dict[str, Dict[str, Any]] = defaultdict(\n531\t        lambda: {\"hit\": 0, \"miss\": 0, \"injections\": 0,\n532\t                 \"last\": \"\", \"modes\": {}}\n533\t    )\n534\t\n535\t    for e in entries:\n536\t        action = e.get(\"action\")\n537\t        if action == \"lesson_outcome\":\n538\t            mode = e.get(\"inference_mode\", \"\") or \"unspecified\"\n539\t            if not include_window_only and mode == \"window-only\":\n540\t                continue\n541\t            if not _in_window(e):\n542\t                continue\n543\t            lid = e.get(\"lesson_id\", \"\")\n544\t            if not lid:\n545\t                continue\n546\t            # When lesson_id is comma-separated (emit_architect_outcome\n547\t            # aggregate emit), split into component ids\n548\t            for lid_part in lid.split(\",\"):\n549\t                lid_part = lid_part.strip()\n550\t                if not lid_part:\n551\t                    continue\n552\t                a = agg[lid_part]\n553\t                if e.get(\"hit\"):\n554\t                    a[\"hit\"] += 1\n555\t                else:\n556\t                    a[\"miss\"] += 1\n557\t                a[\"modes\"][mode] = a[\"modes\"].get(mode, 0) + 1\n558\t                ts = e.get(\"ts\", \"\")\n559\t                if ts > a[\"last\"]:\n560\t                    a[\"last\"] = ts\n561\t        elif action == \"lesson_read\":\n562\t            if not _in_window(e):\n563\t                continue\n564\t            for lid in e.get(\"lesson_ids\", []) or []:\n565\t                agg[lid][\"injections\"] += 1\n566\t\n567\t    # Compute effectiveness + days-since-last\n568\t    from datetime import datetime, timezone\n569\t    now = datetime.now(timezone.utc)\n570\t    lessons = []\n571\t    for lid, a in agg.items():\n572\t        total = a[\"hit\"] + a[\"miss\"]\n573\t        eff = (a[\"hit\"] / total) if total > 0 else None\n574\t        days_since = None\n575\t        last_dt = _parse_since_arg(a[\"last\"]) if a[\"last\"] else None\n576\t        if last_dt is not None:\n577\t            days_since = (now - last_dt).total_seconds() / 86400.0\n578\t        lessons.append({\n579\t            \"lesson_id\": lid,\n580\t            \"hit_count\": a[\"hit\"],\n581\t            \"miss_count\": a[\"miss\"],\n582\t            \"effectiveness\": eff,\n583\t            \"days_since_last_outcome\": days_since,\n584\t            \"injection_count\": a[\"injections\"],\n585\t            \"inference_mode_breakdown\": a[\"modes\"],\n586\t        })\n587\t\n588\t    # Sorting — null effectiveness sorts AFTER non-null (A5/A9)\n589\t    warning = None\n590\t    if sort_by == \"effectiveness\":\n591\t        lessons.sort(key=lambda x: (\n592\t            x[\"effectiveness\"] is None,\n593\t            -(x[\"effectiveness\"] or 0.0),\n594\t        ))\n595\t    elif sort_by == \"recency\":\n596\t        lessons.sort(key=lambda x: (\n597\t            x[\"days_since_last_outcome\"] is None,\n598\t            x[\"days_since_last_outcome\"] or float(\"inf\"),\n599\t        ))\n600\t    elif sort_by == \"injections\":\n601\t        # VP unseen #4 — warn about gameable axis\n602\t        warning = \"sorting by 'injections' is a gameable axis; use with caution\"\n603\t        lessons.sort(key=lambda x: -x[\"injection_count\"])\n604\t\n605\t    if top_n > 0:\n606\t        lessons = lessons[:top_n]\n607\t    elif bottom_n > 0:\n608\t        lessons = lessons[-bottom_n:][::-1]\n609\t\n610\t    data = {\n611\t        \"sort_by\": sort_by,\n612\t        \"include_window_only\": include_window_only,\n613\t        \"since\": since.isoformat() if since else \"all\",\n614\t        \"lesson_count\": len(lessons),\n615\t        \"lessons\": lessons,\n616\t    }\n617\t    if warning:\n618\t        data[\"warning\"] = warning\n619\t    return {\n620\t        \"query\": \"lessons-effectiveness\",\n621\t        \"version\": \"1\",\n622\t        \"data\": data,\n623\t    }\n624\t"}]},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"aa0aa98c-1e46-4ae8-a492-16c101456cbd","timestamp":"2026-11-13T18:10:38.215Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/queries.py","content":"\"\"\"Aggregations used by the audit-query compatibility facade.\"\"\"\n\nfrom __future__ import annotations\n\nimport csv\nimport io\nimport json\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, List, Optional, Tuple\ndef cmd_summary(entries, args) -> Dict[str, Any]:\n    \"\"\"Summary aggregates — single-pass streaming (Perf-P1-002).\n\n    Accepts any iterable of entries. Computes total / first_ts / last_ts /\n    top 5 skills / compliant count in one pass so a 100k-row log does not\n    need to be fully materialized.\n    \"\"\"\n    total = 0\n    first_ts = \"\"\n    last_ts = \"\"\n    skill_counts: Counter = Counter()\n    compliant = 0\n    for e in entries:\n        total += 1\n        ts = e.get(\"ts\", \"\")\n        if ts:\n            if not first_ts or ts < first_ts:\n                first_ts = ts\n            if ts > last_ts:\n                last_ts = ts\n        skill_counts[e.get(\"skill\", \"unknown\")] += 1\n        if (\n            e.get(\"has_profile\")\n            and e.get(\"has_file_assignment\")\n            and e.get(\"skill\") != \"unknown\"\n        ):\n            compliant += 1\n\n    if total == 0:\n        return {\n            \"total_spawns\": 0,\n            \"date_range\": None,\n            \"top_skills\": [],\n            \"compliance_rate\": None,\n        }\n\n    top_skills = skill_counts.most_common(5)\n    compliance_rate = compliant / total\n    return {\n        \"total_spawns\": total,\n        \"date_range\": {\"from\": first_ts, \"to\": last_ts},\n        \"top_skills\": [{\"skill\": s, \"count\": c} for s, c in top_skills],\n        \"compliance_rate\": round(compliance_rate, 3),\n        \"compliant_spawns\": compliant,\n    }\n\n\ndef cmd_by_skill(entries, args) -> List[Dict[str, Any]]:\n    \"\"\"Streamable — single-pass Counter aggregation (Perf-P1-002).\"\"\"\n    counts: Counter = Counter()\n    for e in entries:\n        counts[e.get(\"skill\", \"unknown\")] += 1\n    top = counts.most_common(args.top)\n    return [{\"skill\": s, \"count\": c} for s, c in top]\n\n\ndef cmd_compliance(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n    \"\"\"Handle the `audit-query compliance` sub-command — SOC2/LGPD evidence pack.\"\"\"\n    total = len(entries)\n    if total == 0:\n        return {\n            \"total\": 0,\n            \"has_profile_rate\": None,\n            \"has_file_assignment_rate\": None,\n            \"known_skill_rate\": None,\n        }\n\n    with_profile = sum(1 for e in entries if e.get(\"has_profile\"))\n    with_fa = sum(1 for e in entries if e.get(\"has_file_assignment\"))\n    with_skill = sum(1 for e in entries if e.get(\"skill\") != \"unknown\")\n\n    non_compliant = [\n        {\n            \"ts\": e.get(\"ts\"),\n            \"skill\": e.get(\"skill\", \"unknown\"),\n            \"has_profile\": e.get(\"has_profile\", False),\n            \"has_file_assignment\": e.get(\"has_file_assignment\", False),\n            \"desc_preview\": e.get(\"desc_preview\", \"\"),\n        }\n        for e in entries\n        if not (\n            e.get(\"has_profile\")\n            and e.get(\"has_file_assignment\")\n            and e.get(\"skill\") != \"unknown\"\n        )\n    ]\n\n    return {\n        \"total\": total,\n        \"has_profile\": with_profile,\n        \"has_profile_rate\": round(with_profile / total, 3),\n        \"has_file_assignment\": with_fa,\n        \"has_file_assignment_rate\": round(with_fa / total, 3),\n        \"known_skill\": with_skill,\n        \"known_skill_rate\": round(with_skill / total, 3),\n        \"non_compliant_count\": len(non_compliant),\n        \"non_compliant\": non_compliant[:20],  # cap preview\n    }\n\n\ndef cmd_by_day(entries, args) -> List[Dict[str, Any]]:\n    \"\"\"Streamable — single-pass histogram (Perf-P1-002).\n\n    Fast-path: cutoff is compared as a fixed YYYY-MM-DD string (since our\n    `ts` format is lexicographically sortable). We only fall back to\n    ``datetime.strptime`` when the raw timestamp doesn't match the\n    expected 20-char ISO-Z shape — a rare case (parse errors / rotated\n    schemas) that does not dominate 100k-entry runs.\n    \"\"\"\n    days = args.days\n    now = datetime.now(timezone.utc)\n    cutoff = now - timedelta(days=days)\n    cutoff_day = cutoff.strftime(\"%Y-%m-%d\")\n    histogram: Dict[str, int] = defaultdict(int)\n    for e in entries:\n        ts = e.get(\"ts\", \"\")\n        if not ts:\n            continue\n        # Fast path: YYYY-MM-DDTHH:MM:SSZ is 20 chars with day at 0..10\n        if len(ts) >= 20 and ts.endswith(\"Z\") and ts[10:11] == \"T\":\n            day_key = ts[:10]\n            # Lexicographic compare works because YYYY-MM-DD is fixed width.\n            if day_key < cutoff_day:\n                continue\n        else:\n            try:\n                when = datetime.strptime(ts, \"%Y-%m-%dT%H:%M:%SZ\").replace(\n                    tzinfo=timezone.utc\n                )\n            except ValueError:\n                continue\n            if when < cutoff:\n                continue\n            day_key = when.strftime(\"%Y-%m-%d\")\n        histogram[day_key] += 1\n\n    result = [\n        {\"date\": day, \"count\": count}\n        for day, count in sorted(histogram.items())\n    ]\n    return result\n\n\ndef cmd_search(entries, args) -> List[Dict[str, Any]]:\n    \"\"\"Streamable — filter via regex (Perf-P1-002).\"\"\"\n    try:\n        pattern = re.compile(args.regex, flags=re.IGNORECASE)\n    except re.error as e:\n        print(f\"[audit-query] ERROR: bad regex: {e}\", file=sys.stderr)\n        sys.exit(1)\n    matches = []\n    for e in entries:\n        preview = e.get(\"desc_preview\", \"\")\n        if pattern.search(preview):\n            matches.append(\n                {\n                    \"ts\": e.get(\"ts\"),\n                    \"skill\": e.get(\"skill\"),\n                    \"desc_preview\": preview,\n                    \"desc_hash\": e.get(\"desc_hash\"),\n                }\n            )\n    return matches\n\n\ndef cmd_since(entries, args) -> List[Dict[str, Any]]:\n    \"\"\"Streamable — filter by date cutoff (Perf-P1-002).\"\"\"\n    # Parse the input date (supports YYYY-MM-DD, YYYY-MM-DDTHH:MM:SSZ)\n    raw = args.iso_date\n    parsed = None\n    for fmt in (\"%Y-%m-%dT%H:%M:%SZ\", \"%Y-%m-%d\"):\n        try:\n            parsed = datetime.strptime(raw, fmt).replace(tzinfo=timezone.utc)\n            break\n        except ValueError:\n            continue\n    if parsed is None:\n        print(\n            f\"[audit-query] ERROR: cannot parse date {raw!r} \"\n            \"(use YYYY-MM-DD or YYYY-MM-DDTHH:MM:SSZ)\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n\n    # Fast path: both parsed cutoff and entry ts are ISO-Z → string compare\n    # is equivalent to datetime compare (fixed-width YYYY-MM-DDTHH:MM:SSZ).\n    # Falls back to strptime for non-canonical ts shapes.\n    cutoff_str = parsed.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    out = []\n    for e in entries:\n        ts = e.get(\"ts\", \"\")\n        if len(ts) >= 20 and ts.endswith(\"Z\") and ts[10:11] == \"T\":\n            if ts >= cutoff_str:\n                out.append(e)\n            continue\n        try:\n            when = datetime.strptime(ts, \"%Y-%m-%dT%H:%M:%SZ\").replace(\n                tzinfo=timezone.utc\n            )\n        except ValueError:\n            continue\n        if when >= parsed:\n            out.append(e)\n    return out\n\n\ndef cmd_stats(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n    \"\"\"Handle the `audit-query stats` sub-command — aggregate counts by action.\"\"\"\n    # PLAN-125 WS-1 — per-tool-call lifecycle latency view (--tool-latency).\n    if getattr(args, \"tool_latency\", False):\n        return _tool_latency_stats(entries)\n\n    total = len(entries)\n    if total == 0:\n        return {\"total\": 0}\n\n    bucket_counts = Counter(\n        e.get(\"prompt_len_bucket\", \"unknown\") for e in entries\n    )\n    response_kinds = Counter(e.get(\"response_kind\", \"absent\") for e in entries)\n\n    # hook_duration_ms stats (tolerates missing — older entries don't have it)\n    durations = [\n        e.get(\"hook_duration_ms\")\n        for e in entries\n        if isinstance(e.get(\"hook_duration_ms\"), (int, float))\n    ]\n    duration_summary: Dict[str, Any]\n    if durations:\n        durations_sorted = sorted(durations)\n        duration_summary = {\n            \"count\": len(durations_sorted),\n            \"min_ms\": durations_sorted[0],\n            \"max_ms\": durations_sorted[-1],\n            \"mean_ms\": round(sum(durations_sorted) / len(durations_sorted), 1),\n            \"p50_ms\": _percentile(durations_sorted, 50),\n            \"p95_ms\": _percentile(durations_sorted, 95),\n            \"p99_ms\": _percentile(durations_sorted, 99),\n        }\n    else:\n        duration_summary = {\"count\": 0}\n\n    return {\n        \"total\": total,\n        \"prompt_len_buckets\": dict(bucket_counts),\n        \"response_kinds\": dict(response_kinds),\n        \"hook_duration_ms\": duration_summary,\n    }\n\n\ndef _tool_latency_stats(entries: List[Dict[str, Any]]) -> Dict[str, Any]:\n    \"\"\"PLAN-125 WS-1 — per-tool lifecycle bucket histogram.\n\n    Reads ``tool_call_lifecycle_recorded`` rows and rolls up, per\n    ``tool_name_enum``, a Counter of ``duration_bucket`` plus success / orphan\n    tallies. Bucket-counts ONLY — the action never records a raw\n    ``duration_ms`` (MF-SEC-3), so there are no percentiles to compute.\n    \"\"\"\n    rows = [\n        e for e in entries\n        if e.get(\"action\") == \"tool_call_lifecycle_recorded\"\n    ]\n    per_tool: Dict[str, Dict[str, Any]] = {}\n    for e in rows:\n        tool = e.get(\"tool_name_enum\", \"other\")\n        if not isinstance(tool, str):\n            tool = \"other\"\n        slot = per_tool.setdefault(\n            tool,\n            {\"count\": 0, \"duration_buckets\": Counter(),\n             \"success\": 0, \"failure\": 0, \"orphan\": 0},\n        )\n        slot[\"count\"] += 1\n        bucket = e.get(\"duration_bucket\", \"unknown\")\n        if not isinstance(bucket, str):\n            bucket = \"unknown\"\n        slot[\"duration_buckets\"][bucket] += 1\n        if e.get(\"orphan\") is True:\n            slot[\"orphan\"] += 1\n        if e.get(\"success\") is True:\n            slot[\"success\"] += 1\n        elif e.get(\"success\") is False:\n            slot[\"failure\"] += 1\n\n    # Materialize Counters to plain dicts for JSON / display.\n    tool_latency = {\n        tool: {\n            \"count\": slot[\"count\"],\n            \"duration_buckets\": dict(slot[\"duration_buckets\"]),\n            \"success\": slot[\"success\"],\n            \"failure\": slot[\"failure\"],\n            \"orphan\": slot[\"orphan\"],\n        }\n        for tool, slot in sorted(per_tool.items())\n    }\n    return {\n        \"total_lifecycle_rows\": len(rows),\n        \"tool_latency\": tool_latency,\n    }\n\n\ndef _percentile(sorted_values: List[float], p: float) -> float:\n    if not sorted_values:\n        return 0.0\n    k = (len(sorted_values) - 1) * (p / 100.0)\n    f = int(k)\n    c = min(f + 1, len(sorted_values) - 1)\n    if f == c:\n        return round(float(sorted_values[f]), 1)\n    return round(\n        sorted_values[f] + (sorted_values[c] - sorted_values[f]) * (k - f),\n        1,\n    )\n\n\ndef cmd_errors(args) -> Dict[str, Any]:\n    err_path = Path(args.errors_path) if args.errors_path else default_errors_path()\n    if not err_path.is_file():\n        return {\"errors_path\": str(err_path), \"count\": 0, \"lines\": []}\n    try:\n        text = err_path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    except OSError as e:\n        print(f\"[audit-query] ERROR: cannot read {err_path}: {e}\", file=sys.stderr)\n        sys.exit(2)\n    lines = [ln for ln in text.split(\"\\n\") if ln.strip()]\n    return {\n        \"errors_path\": str(err_path),\n        \"count\": len(lines),\n        \"lines\": lines[-50:],  # tail\n    }\n\n\ndef cmd_debate(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n    \"\"\"Group debate_event rows by (plan_id, round). Sprint 5 A.2.\"\"\"\n    groups: Dict[Tuple[str, int], Dict[str, Any]] = {}\n    for e in entries:\n        if e.get(\"action\") != \"debate_event\":\n            continue\n        key = (e.get(\"plan_id\", \"?\"), int(e.get(\"round\") or 0))\n        g = groups.setdefault(\n            key,\n            {\n                \"plan_id\": key[0],\n                \"round\": key[1],\n                \"start_ts\": None,\n                \"consensus_ts\": None,\n                \"agents\": [],\n                \"consensus_adjustments\": None,\n            },\n        )\n        phase = e.get(\"phase\")\n        ts = e.get(\"ts\")\n        if phase == \"start\":\n            g[\"start_ts\"] = ts\n        elif phase == \"agent-done\":\n            agent = e.get(\"agent\")\n            if agent and agent not in g[\"agents\"]:\n                g[\"agents\"].append(agent)\n        elif phase == \"consensus\":\n            g[\"consensus_ts\"] = ts\n            if e.get(\"consensus_adjustments_count\") is not None:\n                g[\"consensus_adjustments\"] = e[\"consensus_adjustments_count\"]\n    # Sort by (plan_id, round)\n    return [groups[k] for k in sorted(groups.keys())]\n\n\ndef cmd_plans(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n    \"\"\"Show plan status transitions over time. Sprint 5 A.2.\"\"\"\n    by_plan: Dict[str, List[Dict[str, Any]]] = defaultdict(list)\n    for e in entries:\n        if e.get(\"action\") != \"plan_transition\":\n            continue\n        by_plan[e.get(\"plan_id\", \"?\")].append(\n            {\n                \"ts\": e.get(\"ts\"),\n                \"from\": e.get(\"from_status\"),\n                \"to\": e.get(\"to_status\"),\n                \"editor\": e.get(\"editor_tool\"),\n            }\n        )\n    # Sort transitions by ts, then emit one row per plan with a chain summary\n    out = []\n    for plan_id in sorted(by_plan.keys()):\n        trans = sorted(by_plan[plan_id], key=lambda t: t.get(\"ts\") or \"\")\n        chain = \"→\".join(\n            [t[\"from\"] for t in trans] + [trans[-1][\"to\"]] if trans else []\n        )\n        out.append(\n            {\n                \"plan_id\": plan_id,\n                \"transitions\": len(trans),\n                \"chain\": chain,\n                \"first_ts\": trans[0][\"ts\"] if trans else None,\n                \"last_ts\": trans[-1][\"ts\"] if trans else None,\n                \"current_status\": trans[-1][\"to\"] if trans else None,\n            }\n        )\n    return out\n\n\ndef cmd_vetoes(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n    \"\"\"Aggregate veto_triggered rows by (hook, reason_code). Sprint 5 A.2.\"\"\"\n    counts: Dict[Tuple[str, str], Dict[str, Any]] = {}\n    for e in entries:\n        if e.get(\"action\") != \"veto_triggered\":\n            continue\n        key = (e.get(\"hook\", \"?\"), e.get(\"reason_code\", \"?\"))\n        g = counts.setdefault(\n            key,\n            {\n                \"hook\": key[0],\n                \"reason_code\": key[1],\n                \"count\": 0,\n                \"first_ts\": None,\n                \"last_ts\": None,\n                \"sample_preview\": \"\",\n            },\n        )\n        g[\"count\"] += 1\n        ts = e.get(\"ts\") or \"\"\n        if g[\"first_ts\"] is None or ts < g[\"first_ts\"]:\n            g[\"first_ts\"] = ts\n        if g[\"last_ts\"] is None or ts > g[\"last_ts\"]:\n            g[\"last_ts\"] = ts\n        if not g[\"sample_preview\"] and e.get(\"reason_preview\"):\n            g[\"sample_preview\"] = e[\"reason_preview\"]\n    return sorted(\n        counts.values(),\n        key=lambda g: (-g[\"count\"], g[\"hook\"], g[\"reason_code\"]),\n    )\n\n\ndef cmd_lessons(entries: List[Dict[str, Any]], args) -> List[Dict[str, Any]]:\n    \"\"\"Aggregate lesson_write rows by archetype. Sprint 5 A.2.\"\"\"\n    by_arch: Dict[str, Dict[str, Any]] = {}\n    triggers = Counter()\n    for e in entries:\n        if e.get(\"action\") != \"lesson_write\":\n            continue\n        arch = e.get(\"archetype\", \"?\")\n        g = by_arch.setdefault(\n            arch,\n            {\n                \"archetype\": arch,\n                \"count\": 0,\n                \"triggers\": Counter(),\n                \"last_ts\": None,\n            },\n        )\n        g[\"count\"] += 1\n        g[\"triggers\"][e.get(\"trigger\", \"unknown\")] += 1\n        ts = e.get(\"ts\") or \"\"\n        if g[\"last_ts\"] is None or ts > g[\"last_ts\"]:\n            g[\"last_ts\"] = ts\n        triggers[e.get(\"trigger\", \"unknown\")] += 1\n\n    out = []\n    for arch in sorted(by_arch.keys(), key=lambda a: (-by_arch[a][\"count\"], a)):\n        g = by_arch[arch]\n        # Collapse the Counter to a dict for JSON-friendly rendering\n        g[\"triggers\"] = dict(g[\"triggers\"])\n        out.append(g)\n    return out\n\n\ndef _parse_since_arg(raw: str) -> Optional[datetime]:\n    \"\"\"Parse `--since` value: ``24h`` / ``7d`` / ``30m`` / ISO 8601 / ``all``.\n\n    Returns a timezone-aware UTC datetime cutoff, or None for \"all time\".\n    PLAN-009 A18 (shared across new sub-commands).\n    \"\"\"\n    if not raw or raw == \"all\":\n        return None\n    raw = raw.strip().lower()\n    # Shorthand: <int><unit>  (m=minutes, h=hours, d=days)\n    if re.fullmatch(r\"\\d+[mhd]\", raw):\n        n = int(raw[:-1])\n        unit = raw[-1]\n        delta = {\"m\": timedelta(minutes=n), \"h\": timedelta(hours=n), \"d\": timedelta(days=n)}[unit]\n        return datetime.now(timezone.utc) - delta\n    # Try ISO 8601 parse\n    try:\n        if raw.endswith(\"z\"):\n            raw = raw[:-1] + \"+00:00\"\n        dt = datetime.fromisoformat(raw)\n        if dt.tzinfo is None:\n            dt = dt.replace(tzinfo=timezone.utc)\n        return dt\n    except ValueError:\n        return None\n\n\ndef cmd_lessons_effectiveness(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n    \"\"\"`audit-query lessons-effectiveness` — per-lesson effectiveness ranking.\n\n    PLAN-009 Phase 5 P5.1. Aggregates `lesson_outcome` + `lesson_read`\n    events per `lesson_id`; computes effectiveness + injection count +\n    recency; sorts by operator-chosen axis.\n\n    Output envelope (SPEC/v1/audit-query.schema.md):\n        {\"query\": \"lessons-effectiveness\", \"version\": \"1\",\n         \"data\": {\"lessons\": [...]}}\n    \"\"\"\n    since = _parse_since_arg(getattr(args, \"since\", \"24h\"))\n    include_window_only = getattr(args, \"include_window_only\", False)\n    sort_by = getattr(args, \"by\", \"effectiveness\")\n    top_n = int(getattr(args, \"top\", 0) or 0)\n    bottom_n = int(getattr(args, \"bottom\", 0) or 0)\n\n    def _in_window(e: Dict[str, Any]) -> bool:\n        if since is None:\n            return True\n        ts = _parse_since_arg(e.get(\"ts\", \"\"))\n        return ts is None or ts >= since\n\n    from collections import defaultdict\n    agg: Dict[str, Dict[str, Any]] = defaultdict(\n        lambda: {\"hit\": 0, \"miss\": 0, \"injections\": 0,\n                 \"last\": \"\", \"modes\": {}}\n    )\n\n    for e in entries:\n        action = e.get(\"action\")\n        if action == \"lesson_outcome\":\n            mode = e.get(\"inference_mode\", \"\") or \"unspecified\"\n            if not include_window_only and mode == \"window-only\":\n                continue\n            if not _in_window(e):\n                continue\n            lid = e.get(\"lesson_id\", \"\")\n            if not lid:\n                continue\n            # When lesson_id is comma-separated (emit_architect_outcome\n            # aggregate emit), split into component ids\n            for lid_part in lid.split(\",\"):\n                lid_part = lid_part.strip()\n                if not lid_part:\n                    continue\n                a = agg[lid_part]\n                if e.get(\"hit\"):\n                    a[\"hit\"] += 1\n                else:\n                    a[\"miss\"] += 1\n                a[\"modes\"][mode] = a[\"modes\"].get(mode, 0) + 1\n                ts = e.get(\"ts\", \"\")\n                if ts > a[\"last\"]:\n                    a[\"last\"] = ts\n        elif action == \"lesson_read\":\n            if not _in_window(e):\n                continue\n            for lid in e.get(\"lesson_ids\", []) or []:\n                agg[lid][\"injections\"] += 1\n\n    # Compute effectiveness + days-since-last\n    from datetime import datetime, timezone\n    now = datetime.now(timezone.utc)\n    lessons = []\n    for lid, a in agg.items():\n        total = a[\"hit\"] + a[\"miss\"]\n        eff = (a[\"hit\"] / total) if total > 0 else None\n        days_since = None\n        last_dt = _parse_since_arg(a[\"last\"]) if a[\"last\"] else None\n        if last_dt is not None:\n            days_since = (now - last_dt).total_seconds() / 86400.0\n        lessons.append({\n            \"lesson_id\": lid,\n            \"hit_count\": a[\"hit\"],\n            \"miss_count\": a[\"miss\"],\n            \"effectiveness\": eff,\n            \"days_since_last_outcome\": days_since,\n            \"injection_count\": a[\"injections\"],\n            \"inference_mode_breakdown\": a[\"modes\"],\n        })\n\n    # Sorting — null effectiveness sorts AFTER non-null (A5/A9)\n    warning = None\n    if sort_by == \"effectiveness\":\n        lessons.sort(key=lambda x: (\n            x[\"effectiveness\"] is None,\n            -(x[\"effectiveness\"] or 0.0),\n        ))\n    elif sort_by == \"recency\":\n        lessons.sort(key=lambda x: (\n            x[\"days_since_last_outcome\"] is None,\n            x[\"days_since_last_outcome\"] or float(\"inf\"),\n        ))\n    elif sort_by == \"injections\":\n        # VP unseen #4 — warn about gameable axis\n        warning = \"sorting by 'injections' is a gameable axis; use with caution\"\n        lessons.sort(key=lambda x: -x[\"injection_count\"])\n\n    if top_n > 0:\n        lessons = lessons[:top_n]\n    elif bottom_n > 0:\n        lessons = lessons[-bottom_n:][::-1]\n\n    data = {\n        \"sort_by\": sort_by,\n        \"include_window_only\": include_window_only,\n        \"since\": since.isoformat() if since else \"all\",\n        \"lesson_count\": len(lessons),\n        \"lessons\": lessons,\n    }\n    if warning:\n        data[\"warning\"] = warning\n    return {\n        \"query\": \"lessons-effectiveness\",\n        \"version\": \"1\",\n        \"data\": data,\n    }\n","numLines":624,"startLine":1,"totalLines":624}},"tool_result_meta":[{"id":"toolu_01Lsvb63YcB7mrq344EQTP9a","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch1NpkYSyXnaWE2fnRqiz","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NpstnVS548JxZPkwnyQ7dd","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/parsing.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":677,"cache_read_input_tokens":117753,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":677},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"a89559d2-bbe8-46f4-b544-9febf08af3b1","timestamp":"2026-11-13T18:10:39.053Z","request_id":"req_011Ch1NpkLnkUR8xoYPxQorn","wire_tool_inputs":{"toolu_01NpstnVS548JxZPkwnyQ7dd":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/parsing.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NpstnVS548JxZPkwnyQ7dd","type":"tool_result","content":"1\t\"\"\"parsing audit-query declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport csv\n7\timport io\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\tfrom collections import Counter, defaultdict\n13\tfrom datetime import datetime, timedelta, timezone\n14\tfrom pathlib import Path\n15\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n16\t\n17\t__all__ = ('_build_shared_parser', '_add_v1_subparsers', '_add_v2_subparsers', '_add_sprint8_9_subparsers', '_add_plan015_subparsers', '_add_plan080_subparsers', '_add_plan081_subparsers', '_add_plan113_subparsers', 'build_parser')\n18\t\n19\tdef _build_shared_parser(*, for_subcommand: bool = False) -> argparse.ArgumentParser:\n20\t    \"\"\"Return a parent parser with the shared flags.\n21\t\n22\t    The same flags are registered on the top-level parser AND on every\n23\t    sub-command, so users can write either::\n24\t\n25\t        audit-query.py summary --log X --json\n26\t        audit-query.py --log X --json summary  # same result\n27\t\n28\t    Precedence rule: the top-level copy owns the real defaults; the\n29\t    sub-command copy (``for_subcommand=True``) registers every flag with\n30\t    ``default=argparse.SUPPRESS``, so a sub-command that does not repeat\n31\t    a flag keeps the value given before it. A flag given on BOTH sides\n32\t    resolves to the sub-command-level value. argparse parses a\n33\t    sub-command into a fresh namespace and copies every attribute back —\n34\t    with real defaults there, ``--log X summary`` silently read the\n35\t    default log instead of X (FD-23).\n36\t    \"\"\"\n37\t    def _default(value: Any) -> Any:\n38\t        return argparse.SUPPRESS if for_subcommand else value\n39\t\n40\t    shared = argparse.ArgumentParser(add_help=False)\n41\t    shared.add_argument(\n42\t        \"--log\",\n43\t        default=_default(None),\n44\t        help=\"Path to audit-log.jsonl (default: CEO_AUDIT_LOG_PATH or ~)\",\n45\t    )\n46\t    shared.add_argument(\n47\t        \"--include-rotated\",\n48\t        action=\"store_true\",\n49\t        default=_default(False),\n50\t        help=\"Also read audit-log-YYYY-MM*.jsonl siblings\",\n51\t    )\n52\t    shared.add_argument(\"--json\", dest=\"as_json\", action=\"store_true\", default=_default(False))\n53\t    shared.add_argument(\"--csv\", dest=\"as_csv\", action=\"store_true\", default=_default(False))\n54\t    shared.add_argument(\n55\t        \"--errors-path\",\n56\t        default=_default(None),\n57\t        help=\"Override path for the `errors` sub-command\",\n58\t    )\n59\t    return shared\n60\t\n61\t\n62\tdef _add_v1_subparsers(sub: \"argparse._SubParsersAction\",\n63\t                       shared: argparse.ArgumentParser) -> None:\n64\t    \"\"\"Register the original v1 sub-commands (summary/by-skill/... export).\"\"\"\n65\t    sub.add_parser(\n66\t        \"summary\",\n67\t        parents=[shared],\n68\t        help=\"Overview: count, range, top skills, compliance\",\n69\t    )\n70\t\n71\t    byskill = sub.add_parser(\"by-skill\", parents=[shared], help=\"Rank skills by usage count\")\n72\t    byskill.add_argument(\"--top\", type=int, default=10)\n73\t\n74\t    sub.add_parser(\"compliance\", parents=[shared], help=\"Governance compliance breakdown\")\n75\t\n76\t    byday = sub.add_parser(\"by-day\", parents=[shared], help=\"Spawns-per-day histogram\")\n77\t    byday.add_argument(\"--days\", type=int, default=14)\n78\t\n79\t    search = sub.add_parser(\"search\", parents=[shared], help=\"Regex-match against desc_preview\")\n80\t    search.add_argument(\"regex\")\n81\t\n82\t    since = sub.add_parser(\"since\", parents=[shared], help=\"Entries on or after a date\")\n83\t    since.add_argument(\"iso_date\", help=\"YYYY-MM-DD or full ISO 8601\")\n84\t\n85\t    sub.add_parser(\"errors\", parents=[shared], help=\"Tail the audit-log.errors breadcrumb file\")\n86\t\n87\t    stats_p = sub.add_parser(\n88\t        \"stats\",\n89\t        parents=[shared],\n90\t        help=\"Prompt-length + response_kind distributions + latency; \"\n91\t             \"--tool-latency for per-tool lifecycle buckets\",\n92\t    )\n93\t    # PLAN-125 WS-1 — per-tool-call lifecycle latency view. Bucket-counts ONLY\n94\t    # (the tool_call_lifecycle_recorded action carries NO raw duration_ms per\n95\t    # MF-SEC-3), so this is a histogram, NOT percentiles.\n96\t    stats_p.add_argument(\n97\t        \"--tool-latency\",\n98\t        dest=\"tool_latency\",\n99\t        action=\"store_true\",\n100\t        help=\"Per-tool_name_enum duration_bucket histogram (+ success / orphan \"\n101\t             \"rollups) from tool_call_lifecycle_recorded rows. Bucket-counts \"\n102\t             \"only — no percentiles (raw duration_ms is never recorded).\",\n103\t    )\n104\t\n105\t    export = sub.add_parser(\"export\", parents=[shared], help=\"Dump all entries in csv/json/tsv\")\n106\t    export.add_argument(\n107\t        \"--format\", dest=\"export_format\", choices=[\"csv\", \"json\", \"tsv\"], default=\"json\"\n108\t    )\n109\t\n110\t\n111\tdef _add_v2_subparsers(sub: \"argparse._SubParsersAction\",\n112\t                       shared: argparse.ArgumentParser) -> None:\n113\t    \"\"\"Register Sprint 5 A.2 v2 event-stream sub-commands.\"\"\"\n114\t    sub.add_parser(\n115\t        \"debate\",\n116\t        parents=[shared],\n117\t        help=\"Debate rounds: grouped by (plan_id, round) with agents + consensus\",\n118\t    )\n119\t    sub.add_parser(\n120\t        \"plans\",\n121\t        parents=[shared],\n122\t        help=\"Plan status transitions per plan_id\",\n123\t    )\n124\t    sub.add_parser(\n125\t        \"vetoes\",\n126\t        parents=[shared],\n127\t        help=\"Veto events aggregated by (hook, reason_code)\",\n128\t    )\n129\t    sub.add_parser(\n130\t        \"benchmarks\",\n131\t        parents=[shared],\n132\t        help=(\n133\t            \"Benchmark runs aggregated by skill — harbor-style row: \"\n134\t            \"pass_rate + cost + compute + turns (PLAN-133 C4)\"\n135\t        ),\n136\t    )\n137\t    sub.add_parser(\n138\t        \"lessons\",\n139\t        parents=[shared],\n140\t        help=\"Lesson-write events grouped by archetype + trigger\",\n141\t    )\n142\t    sub.add_parser(\n143\t        \"metrics\",\n144\t        parents=[shared],\n145\t        help=\"Cross-cutting derived metrics (veto rate, debate completion)\",\n146\t    )\n147\t    sub.add_parser(\n148\t        \"health\",\n149\t        parents=[shared],\n150\t        help=\"Framework health verdict (PASS / WARN / FAIL / NO_DATA)\",\n151\t    )\n152\t    sub.add_parser(\n153\t        \"tokens\",\n154\t        parents=[shared],\n155\t        help=\"Spawn token aggregates (PLAN-006 Phase 5a / ADR-016)\",\n156\t    )\n157\t\n158\t\n159\tdef _add_sprint8_9_subparsers(sub: \"argparse._SubParsersAction\",\n160\t                               shared: argparse.ArgumentParser) -> None:\n161\t    \"\"\"Register confidence-gate + ADR-020 + lesson-effectiveness commands.\"\"\"\n162\t    # Sprint 8 Phase 2 — confidence_gate aggregates (ADR-018)\n163\t    claims = sub.add_parser(\n164\t        \"claims\",\n165\t        parents=[shared],\n166\t        help=\"Confidence-gate verification aggregates (pass/fail by kind + agent)\",\n167\t    )\n168\t    claims.add_argument(\"--kind\", help=\"Filter by claim kind (e.g. path_exists)\")\n169\t    claims.add_argument(\"--agent\", help=\"Filter by agent name\")\n170\t    claims.add_argument(\n171\t        \"--failed-only\",\n172\t        action=\"store_true\",\n173\t        help=\"Only include events with ≥1 failed claim\",\n174\t    )\n175\t\n176\t    # Sprint 9 Phase 2 (ADR-020) — prune-restore-ratio measurement\n177\t    prr = sub.add_parser(\n178\t        \"prune-restore-ratio\",\n179\t        parents=[shared],\n180\t        help=\"Ratio of restored/archived lessons over a time window (ADR-020)\",\n181\t    )\n182\t    prr.add_argument(\n183\t        \"--since\", default=\"24h\",\n184\t        help=\"Window start: 24h / 7d / 30m / ISO 8601 / 'all' (default 24h)\",\n185\t    )\n186\t    prr.add_argument(\n187\t        \"--until\", default=None,\n188\t        help=\"Window end: ISO 8601 (default: now)\",\n189\t    )\n190\t\n191\t    # Sprint 9 Phase 3 (PLAN-009 P3.4) — Architect outcome tracking\n192\t    aout = sub.add_parser(\n193\t        \"architect-outcomes\",\n194\t        parents=[shared],\n195\t        help=\"Per-lesson hit/miss from Architect spawns (ADR-015 amended)\",\n196\t    )\n197\t    aout.add_argument(\n198\t        \"--since\", default=\"24h\",\n199\t        help=\"Window start: 24h / 7d / 30m / ISO 8601 / 'all' (default 24h)\",\n200\t    )\n201\t    aout.add_argument(\n202\t        \"--consumer\", default=\"architect\",\n203\t        choices=[\"architect\", \"benchmark\"],\n204\t        help=\"Filter by consumer (default: architect)\",\n205\t    )\n206\t    aout.add_argument(\n207\t        \"--include-window-only\", action=\"store_true\",\n208\t        help=\"Include pre-Sprint-9 window-only events (dirty signal)\",\n209\t    )\n210\t\n211\t    # Sprint 9 Phase 5 (PLAN-009 P5.1) — lessons effectiveness ranking\n212\t    leff = sub.add_parser(\n213\t        \"lessons-effectiveness\",\n214\t        parents=[shared],\n215\t        help=\"Per-lesson effectiveness ranking (PLAN-009 Phase 5)\",\n216\t    )\n217\t    leff.add_argument(\"--since\", default=\"24h\",\n218\t                      help=\"Window start (default 24h; 'all' for no filter)\")\n219\t    leff.add_argument(\"--include-window-only\", action=\"store_true\")\n220\t    leff.add_argument(\"--by\", default=\"effectiveness\",\n221\t                      choices=[\"effectiveness\", \"recency\", \"injections\"],\n222\t                      help=\"Sort axis (default: effectiveness)\")\n223\t    leff.add_argument(\"--top\", type=int, default=0, help=\"Return top N\")\n224\t    leff.add_argument(\"--bottom\", type=int, default=0, help=\"Return bottom N\")\n225\t\n226\t\n227\tdef _add_plan015_subparsers(sub: \"argparse._SubParsersAction\",\n228\t                             shared: argparse.ArgumentParser) -> None:\n229\t    \"\"\"Register PLAN-015 adopter-triage sub-commands.\"\"\"\n230\t    # PLAN-015 Phase 0.5 — adopter-side weekly triage\n231\t    wks = sub.add_parser(\n232\t        \"weekly-summary\",\n233\t        parents=[shared],\n234\t        help=\"Week-over-week spawn/veto/plan trend for adopter triage (PLAN-015)\",\n235\t    )\n236\t    wks.add_argument(\"--window\", default=\"7d\",\n237\t                     help=\"Window length: 7d (default), 14d, 30d, or 'all'\")\n238\t    wks.add_argument(\"--now\", default=None,\n239\t                     help=\"Override 'now' with an ISO-8601 timestamp (testing)\")\n240\t\n241\t    # PLAN-025 Batch D F-obs-001 — ADR-052 multi-model spawn distribution.\n242\t    # Referenced from SLO-SLA.md + DAY-1-CHECKLIST; was missing pre-Batch-D.\n243\t    spawn_stats = sub.add_parser(\n244\t        \"spawn-stats\",\n245\t        parents=[shared],\n246\t        help=\"Spawn distribution by skill + model (PLAN-025 F-obs-001; ADR-052)\",\n247\t    )\n248\t    spawn_stats.add_argument(\n249\t        \"--since\",\n250\t        default=None,\n251\t        help=\"Filter to entries at or after this ISO-8601 timestamp or relative (e.g. '7d')\",\n252\t    )\n253\t    spawn_stats.add_argument(\n254\t        \"--by\",\n255\t        default=\"model\",\n256\t        choices=(\"model\", \"skill\", \"both\"),\n257\t        help=\"Group-by dimension (default: model)\",\n258\t    )\n259\t\n260\t\n261\tdef _add_plan080_subparsers(sub: \"argparse._SubParsersAction\",\n262\t                             shared: argparse.ArgumentParser) -> None:\n263\t    \"\"\"Register PLAN-080 Phase 1 sub-commands.\n264\t\n265\t    by-domain: group spawn events by dispatch_archetype_hint for squad-bundle\n266\t    governance observability (PLAN-080 Phase 1 / ADR-112).\n267\t    \"\"\"\n268\t    by_domain = sub.add_parser(\n269\t        \"by-domain\",\n270\t        parents=[shared],\n271\t        help=(\n272\t            \"Group agent_spawn events by dispatch_archetype_hint domain \"\n273\t            \"(PLAN-080 Phase 1 / ADR-112)\"\n274\t        ),\n275\t    )\n276\t    # Window options — mutually exclusive groups handled in cmd_by_domain\n277\t    by_domain.add_argument(\n278\t        \"--window\",\n279\t        default=f\"{_BY_DOMAIN_DEFAULT_WINDOW_DAYS}d\",\n280\t        metavar=\"WINDOW\",\n281\t        help=(\n282\t            \"Trailing window (e.g. 30d, 7d, 14d). \"\n283\t            f\"Default: {_BY_DOMAIN_DEFAULT_WINDOW_DAYS}d. \"\n284\t            \"Ignored when --start/--end are provided.\"\n285\t        ),\n286\t    )\n287\t    by_domain.add_argument(\n288\t        \"--start\",\n289\t        default=None,\n290\t        metavar=\"YYYY-MM-DD\",\n291\t        help=\"Start date (inclusive). Must be paired with --end.\",\n292\t    )\n293\t    by_domain.add_argument(\n294\t        \"--end\",\n295\t        default=None,\n296\t        metavar=\"YYYY-MM-DD\",\n297\t        help=\"End date (inclusive). Must be paired with --start.\",\n298\t    )\n299\t    by_domain.add_argument(\n300\t        \"--check-reopen\",\n301\t        action=\"store_true\",\n302\t        dest=\"check_reopen\",\n303\t        help=(\n304\t            \"Filter output to sunset domains (from grandfather-cap.policy.yaml) \"\n305\t            \"with >= 1 spawn. UNKNOWN bucket excluded per M2-CDX-7.\"\n306\t        ),\n307\t    )\n308\t\n309\t\n310\tdef _add_plan081_subparsers(sub: \"argparse._SubParsersAction\",\n311\t                             shared: argparse.ArgumentParser) -> None:\n312\t    \"\"\"Register PLAN-081 Phase 6-bis sub-commands.\n313\t\n314\t    label: Owner labels a pair_rail_case event post-hoc (R1 S-TDE-3).\n315\t    fp-rate: false-positive rate aggregator with reopen-trigger threshold.\n316\t    codex-writeguard-summary: aggregates pair_rail_codex_denylist_hit events\n317\t                              by target_path bucket (R1 S-TDE Q2).\n318\t    \"\"\"\n319\t    # --- label ---\n320\t    label_p = sub.add_parser(\n321\t        \"label\",\n322\t        parents=[shared],\n323\t        help=\"Append a Case-B verdict label to audit-log-labels.jsonl (PLAN-081 Phase 6-bis)\",\n324\t    )\n325\t    label_p.add_argument(\n326\t        \"--run-id\", required=True, dest=\"run_id\",\n327\t        help=\"pair_rail_promotion_run_id (UUID hex) of the event being labeled\",\n328\t    )\n329\t    label_p.add_argument(\n330\t        \"--case\", required=True, choices=sorted(_LABEL_VALID_CASES),\n331\t        help=\"Case letter A-F to label\",\n332\t    )\n333\t    label_p.add_argument(\n334\t        \"--label\", required=True, choices=sorted(_LABEL_VALID_LABELS),\n335\t        help=\"Verdict label: fp | tp | triage_pending | retracted (per ADR-108 §Owner labeling protocol)\",\n336\t    )\n337\t    label_p.add_argument(\n338\t        \"--note\", default=\"\",\n339\t        help=\"Optional free-form note (length is bucketed in audit emit; content NOT stored)\",\n340\t    )\n341\t\n342\t    # --- fp-rate ---\n343\t    fp_p = sub.add_parser(\n344\t        \"fp-rate\",\n345\t        parents=[shared],\n346\t        help=\"Case-B false-positive rate aggregator (PLAN-081 Phase 6-bis R1 S-TDE-3)\",\n347\t    )\n348\t    fp_p.add_argument(\n349\t        \"--window-days\", type=int, default=30, dest=\"window_days\",\n350\t        help=\"Trailing window in days (default 30)\",\n351\t    )\n352\t    fp_p.add_argument(\n353\t        \"--reopen-threshold\", type=float, default=0.30, dest=\"reopen_threshold\",\n354\t        help=\"trigger_reopen=true when fp_rate_lower_bound > threshold (default 0.30 per ADR-108 §FP-rate)\",\n355\t    )\n356\t\n357\t    # --- case-summary ---\n358\t    cs_p = sub.add_parser(\n359\t        \"case-summary\",\n360\t        parents=[shared],\n361\t        help=\"Cases A-F distribution rollup over window (PLAN-081 Phase 6-bis ADR-108 §Operational)\",\n362\t    )\n363\t    cs_p.add_argument(\n364\t        \"--window-days\", type=int, default=7, dest=\"window_days\",\n365\t        help=\"Trailing window in days (default 7 — faster operational signal than 30d)\",\n366\t    )\n367\t\n368\t    # --- codex-writeguard-summary ---\n369\t    cw_p = sub.add_parser(\n370\t        \"codex-writeguard-summary\",\n371\t        parents=[shared],\n372\t        help=\"Codex codando deny-list hit summary by path bucket (PLAN-081 Phase 6-bis R1 S-TDE Q2)\",\n373\t    )\n374\t    cw_p.add_argument(\n375\t        \"--window-days\", type=int, default=30, dest=\"window_days\",\n376\t        help=\"Trailing window in days (default 30)\",\n377\t    )\n378\t    cw_p.add_argument(\n379\t        \"--top\", type=int, default=10,\n380\t        help=\"Top N most-attempted forbidden paths (default 10)\",\n381\t    )\n382\t\n383\t\n384\tdef _add_plan113_subparsers(sub: \"argparse._SubParsersAction\",\n385\t                            shared: argparse.ArgumentParser) -> None:\n386\t    \"\"\"Register PLAN-113 Phase B Wave W1 sub-command.\n387\t\n388\t    critical: surface the 38 critical-security actions (count + first/last\n389\t    ts + safe summary), listing zero-occurrence actions so missing-but-\n390\t    expected critical events are visible (audit-reader-coverage gap).\n391\t    \"\"\"\n392\t    crit = sub.add_parser(\n393\t        \"critical\",\n394\t        parents=[shared],\n395\t        help=(\n396\t            \"Surface critical-security actions (count + last-seen + safe \"\n397\t            \"summary); absent actions listed with count=0 (PLAN-113 W1)\"\n398\t        ),\n399\t    )\n400\t    crit.add_argument(\n401\t        \"--action\",\n402\t        default=None,\n403\t        metavar=\"ACTION\",\n404\t        help=(\n405\t            \"Drill into a single critical action (must be one of the \"\n406\t            \"registry actions; errors otherwise)\"\n407\t        ),\n408\t    )\n409\t\n410\t\n411\tdef build_parser() -> argparse.ArgumentParser:\n412\t    \"\"\"Construct the full audit-query argparse tree.\n413\t\n414\t    Delegates each era of sub-commands to a private helper\n415\t    (``_add_v1_subparsers`` / ``_add_v2_subparsers`` /\n416\t    ``_add_sprint8_9_subparsers`` / ``_add_plan015_subparsers`` /\n417\t    ``_add_plan080_subparsers`` / ``_add_plan081_subparsers``). The\n418\t    public contract of this function is unchanged — callers get back\n419\t    an ``argparse.ArgumentParser`` with ``cmd`` as the required\n420\t    subcommand. Sub-commands get the SUPPRESS-default copy of the shared\n421\t    flags (precedence rule in ``_build_shared_parser``).\n422\t    \"\"\"\n423\t    shared = _build_shared_parser()\n424\t    sub_shared = _build_shared_parser(for_subcommand=True)\n425\t\n426\t    parser = argparse.ArgumentParser(\n427\t        prog=\"audit-query.py\",\n428\t        parents=[shared],\n429\t        description=\"Query the ceo-orchestration agent spawn audit log\",\n430\t        formatter_class=argparse.RawDescriptionHelpFormatter,\n431\t        epilog=(\n432\t            \"Examples:\\n\"\n433\t            \"  audit-query.py summary\\n\"\n434\t            \"  audit-query.py by-skill --top 10\\n\"\n435\t            \"  audit-query.py compliance --json\\n\"\n436\t            \"  audit-query.py search 'security' --include-rotated\\n\"\n437\t            \"  audit-query.py by-day --days 7\\n\"\n438\t            \"  audit-query.py since 2026-04-01\\n\"\n439\t            \"  audit-query.py export --format csv > spawns.csv\\n\"\n440\t            \"  audit-query.py stats --json\\n\"\n441\t            \"  audit-query.py errors\\n\"\n442\t            \"  audit-query.py by-domain --window 30d\\n\"\n443\t            \"  audit-query.py by-domain --start 2026-04-01 --end 2026-05-01\\n\"\n444\t            \"  audit-query.py by-domain --window 30d --check-reopen\\n\"\n445\t            \"  audit-query.py critical\\n\"\n446\t            \"  audit-query.py critical --action kill_switch_invoked --json\\n\"\n447\t        ),\n448\t    )\n449\t\n450\t    sub = parser.add_subparsers(dest=\"cmd\", required=True)\n451\t    _add_v1_subparsers(sub, sub_shared)\n452\t    _add_v2_subparsers(sub, sub_shared)\n453\t    _add_sprint8_9_subparsers(sub, sub_shared)\n454\t    _add_plan015_subparsers(sub, sub_shared)\n455\t    _add_plan080_subparsers(sub, sub_shared)\n456\t    _add_plan081_subparsers(sub, sub_shared)\n457\t    _add_plan113_subparsers(sub, sub_shared)\n458\t\n459\t    return parser\n460\t\n461\t\n462\t# ---------------------------------------------------------------------------\n463\t# main\n464\t# ---------------------------------------------------------------------------\n465\t\n466\t\n467\t"}]},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"3a07cb86-a6e0-4a70-9810-cc5254cecaf7","timestamp":"2026-11-13T18:10:39.078Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/hooks/_lib/_audit_query/parsing.py","content":"\"\"\"parsing audit-query declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport io\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n\n__all__ = ('_build_shared_parser', '_add_v1_subparsers', '_add_v2_subparsers', '_add_sprint8_9_subparsers', '_add_plan015_subparsers', '_add_plan080_subparsers', '_add_plan081_subparsers', '_add_plan113_subparsers', 'build_parser')\n\ndef _build_shared_parser(*, for_subcommand: bool = False) -> argparse.ArgumentParser:\n    \"\"\"Return a parent parser with the shared flags.\n\n    The same flags are registered on the top-level parser AND on every\n    sub-command, so users can write either::\n\n        audit-query.py summary --log X --json\n        audit-query.py --log X --json summary  # same result\n\n    Precedence rule: the top-level copy owns the real defaults; the\n    sub-command copy (``for_subcommand=True``) registers every flag with\n    ``default=argparse.SUPPRESS``, so a sub-command that does not repeat\n    a flag keeps the value given before it. A flag given on BOTH sides\n    resolves to the sub-command-level value. argparse parses a\n    sub-command into a fresh namespace and copies every attribute back —\n    with real defaults there, ``--log X summary`` silently read the\n    default log instead of X (FD-23).\n    \"\"\"\n    def _default(value: Any) -> Any:\n        return argparse.SUPPRESS if for_subcommand else value\n\n    shared = argparse.ArgumentParser(add_help=False)\n    shared.add_argument(\n        \"--log\",\n        default=_default(None),\n        help=\"Path to audit-log.jsonl (default: CEO_AUDIT_LOG_PATH or ~)\",\n    )\n    shared.add_argument(\n        \"--include-rotated\",\n        action=\"store_true\",\n        default=_default(False),\n        help=\"Also read audit-log-YYYY-MM*.jsonl siblings\",\n    )\n    shared.add_argument(\"--json\", dest=\"as_json\", action=\"store_true\", default=_default(False))\n    shared.add_argument(\"--csv\", dest=\"as_csv\", action=\"store_true\", default=_default(False))\n    shared.add_argument(\n        \"--errors-path\",\n        default=_default(None),\n        help=\"Override path for the `errors` sub-command\",\n    )\n    return shared\n\n\ndef _add_v1_subparsers(sub: \"argparse._SubParsersAction\",\n                       shared: argparse.ArgumentParser) -> None:\n    \"\"\"Register the original v1 sub-commands (summary/by-skill/... export).\"\"\"\n    sub.add_parser(\n        \"summary\",\n        parents=[shared],\n        help=\"Overview: count, range, top skills, compliance\",\n    )\n\n    byskill = sub.add_parser(\"by-skill\", parents=[shared], help=\"Rank skills by usage count\")\n    byskill.add_argument(\"--top\", type=int, default=10)\n\n    sub.add_parser(\"compliance\", parents=[shared], help=\"Governance compliance breakdown\")\n\n    byday = sub.add_parser(\"by-day\", parents=[shared], help=\"Spawns-per-day histogram\")\n    byday.add_argument(\"--days\", type=int, default=14)\n\n    search = sub.add_parser(\"search\", parents=[shared], help=\"Regex-match against desc_preview\")\n    search.add_argument(\"regex\")\n\n    since = sub.add_parser(\"since\", parents=[shared], help=\"Entries on or after a date\")\n    since.add_argument(\"iso_date\", help=\"YYYY-MM-DD or full ISO 8601\")\n\n    sub.add_parser(\"errors\", parents=[shared], help=\"Tail the audit-log.errors breadcrumb file\")\n\n    stats_p = sub.add_parser(\n        \"stats\",\n        parents=[shared],\n        help=\"Prompt-length + response_kind distributions + latency; \"\n             \"--tool-latency for per-tool lifecycle buckets\",\n    )\n    # PLAN-125 WS-1 — per-tool-call lifecycle latency view. Bucket-counts ONLY\n    # (the tool_call_lifecycle_recorded action carries NO raw duration_ms per\n    # MF-SEC-3), so this is a histogram, NOT percentiles.\n    stats_p.add_argument(\n        \"--tool-latency\",\n        dest=\"tool_latency\",\n        action=\"store_true\",\n        help=\"Per-tool_name_enum duration_bucket histogram (+ success / orphan \"\n             \"rollups) from tool_call_lifecycle_recorded rows. Bucket-counts \"\n             \"only — no percentiles (raw duration_ms is never recorded).\",\n    )\n\n    export = sub.add_parser(\"export\", parents=[shared], help=\"Dump all entries in csv/json/tsv\")\n    export.add_argument(\n        \"--format\", dest=\"export_format\", choices=[\"csv\", \"json\", \"tsv\"], default=\"json\"\n    )\n\n\ndef _add_v2_subparsers(sub: \"argparse._SubParsersAction\",\n                       shared: argparse.ArgumentParser) -> None:\n    \"\"\"Register Sprint 5 A.2 v2 event-stream sub-commands.\"\"\"\n    sub.add_parser(\n        \"debate\",\n        parents=[shared],\n        help=\"Debate rounds: grouped by (plan_id, round) with agents + consensus\",\n    )\n    sub.add_parser(\n        \"plans\",\n        parents=[shared],\n        help=\"Plan status transitions per plan_id\",\n    )\n    sub.add_parser(\n        \"vetoes\",\n        parents=[shared],\n        help=\"Veto events aggregated by (hook, reason_code)\",\n    )\n    sub.add_parser(\n        \"benchmarks\",\n        parents=[shared],\n        help=(\n            \"Benchmark runs aggregated by skill — harbor-style row: \"\n            \"pass_rate + cost + compute + turns (PLAN-133 C4)\"\n        ),\n    )\n    sub.add_parser(\n        \"lessons\",\n        parents=[shared],\n        help=\"Lesson-write events grouped by archetype + trigger\",\n    )\n    sub.add_parser(\n        \"metrics\",\n        parents=[shared],\n        help=\"Cross-cutting derived metrics (veto rate, debate completion)\",\n    )\n    sub.add_parser(\n        \"health\",\n        parents=[shared],\n        help=\"Framework health verdict (PASS / WARN / FAIL / NO_DATA)\",\n    )\n    sub.add_parser(\n        \"tokens\",\n        parents=[shared],\n        help=\"Spawn token aggregates (PLAN-006 Phase 5a / ADR-016)\",\n    )\n\n\ndef _add_sprint8_9_subparsers(sub: \"argparse._SubParsersAction\",\n                               shared: argparse.ArgumentParser) -> None:\n    \"\"\"Register confidence-gate + ADR-020 + lesson-effectiveness commands.\"\"\"\n    # Sprint 8 Phase 2 — confidence_gate aggregates (ADR-018)\n    claims = sub.add_parser(\n        \"claims\",\n        parents=[shared],\n        help=\"Confidence-gate verification aggregates (pass/fail by kind + agent)\",\n    )\n    claims.add_argument(\"--kind\", help=\"Filter by claim kind (e.g. path_exists)\")\n    claims.add_argument(\"--agent\", help=\"Filter by agent name\")\n    claims.add_argument(\n        \"--failed-only\",\n        action=\"store_true\",\n        help=\"Only include events with ≥1 failed claim\",\n    )\n\n    # Sprint 9 Phase 2 (ADR-020) — prune-restore-ratio measurement\n    prr = sub.add_parser(\n        \"prune-restore-ratio\",\n        parents=[shared],\n        help=\"Ratio of restored/archived lessons over a time window (ADR-020)\",\n    )\n    prr.add_argument(\n        \"--since\", default=\"24h\",\n        help=\"Window start: 24h / 7d / 30m / ISO 8601 / 'all' (default 24h)\",\n    )\n    prr.add_argument(\n        \"--until\", default=None,\n        help=\"Window end: ISO 8601 (default: now)\",\n    )\n\n    # Sprint 9 Phase 3 (PLAN-009 P3.4) — Architect outcome tracking\n    aout = sub.add_parser(\n        \"architect-outcomes\",\n        parents=[shared],\n        help=\"Per-lesson hit/miss from Architect spawns (ADR-015 amended)\",\n    )\n    aout.add_argument(\n        \"--since\", default=\"24h\",\n        help=\"Window start: 24h / 7d / 30m / ISO 8601 / 'all' (default 24h)\",\n    )\n    aout.add_argument(\n        \"--consumer\", default=\"architect\",\n        choices=[\"architect\", \"benchmark\"],\n        help=\"Filter by consumer (default: architect)\",\n    )\n    aout.add_argument(\n        \"--include-window-only\", action=\"store_true\",\n        help=\"Include pre-Sprint-9 window-only events (dirty signal)\",\n    )\n\n    # Sprint 9 Phase 5 (PLAN-009 P5.1) — lessons effectiveness ranking\n    leff = sub.add_parser(\n        \"lessons-effectiveness\",\n        parents=[shared],\n        help=\"Per-lesson effectiveness ranking (PLAN-009 Phase 5)\",\n    )\n    leff.add_argument(\"--since\", default=\"24h\",\n                      help=\"Window start (default 24h; 'all' for no filter)\")\n    leff.add_argument(\"--include-window-only\", action=\"store_true\")\n    leff.add_argument(\"--by\", default=\"effectiveness\",\n                      choices=[\"effectiveness\", \"recency\", \"injections\"],\n                      help=\"Sort axis (default: effectiveness)\")\n    leff.add_argument(\"--top\", type=int, default=0, help=\"Return top N\")\n    leff.add_argument(\"--bottom\", type=int, default=0, help=\"Return bottom N\")\n\n\ndef _add_plan015_subparsers(sub: \"argparse._SubParsersAction\",\n                             shared: argparse.ArgumentParser) -> None:\n    \"\"\"Register PLAN-015 adopter-triage sub-commands.\"\"\"\n    # PLAN-015 Phase 0.5 — adopter-side weekly triage\n    wks = sub.add_parser(\n        \"weekly-summary\",\n        parents=[shared],\n        help=\"Week-over-week spawn/veto/plan trend for adopter triage (PLAN-015)\",\n    )\n    wks.add_argument(\"--window\", default=\"7d\",\n                     help=\"Window length: 7d (default), 14d, 30d, or 'all'\")\n    wks.add_argument(\"--now\", default=None,\n                     help=\"Override 'now' with an ISO-8601 timestamp (testing)\")\n\n    # PLAN-025 Batch D F-obs-001 — ADR-052 multi-model spawn distribution.\n    # Referenced from SLO-SLA.md + DAY-1-CHECKLIST; was missing pre-Batch-D.\n    spawn_stats = sub.add_parser(\n        \"spawn-stats\",\n        parents=[shared],\n        help=\"Spawn distribution by skill + model (PLAN-025 F-obs-001; ADR-052)\",\n    )\n    spawn_stats.add_argument(\n        \"--since\",\n        default=None,\n        help=\"Filter to entries at or after this ISO-8601 timestamp or relative (e.g. '7d')\",\n    )\n    spawn_stats.add_argument(\n        \"--by\",\n        default=\"model\",\n        choices=(\"model\", \"skill\", \"both\"),\n        help=\"Group-by dimension (default: model)\",\n    )\n\n\ndef _add_plan080_subparsers(sub: \"argparse._SubParsersAction\",\n                             shared: argparse.ArgumentParser) -> None:\n    \"\"\"Register PLAN-080 Phase 1 sub-commands.\n\n    by-domain: group spawn events by dispatch_archetype_hint for squad-bundle\n    governance observability (PLAN-080 Phase 1 / ADR-112).\n    \"\"\"\n    by_domain = sub.add_parser(\n        \"by-domain\",\n        parents=[shared],\n        help=(\n            \"Group agent_spawn events by dispatch_archetype_hint domain \"\n            \"(PLAN-080 Phase 1 / ADR-112)\"\n        ),\n    )\n    # Window options — mutually exclusive groups handled in cmd_by_domain\n    by_domain.add_argument(\n        \"--window\",\n        default=f\"{_BY_DOMAIN_DEFAULT_WINDOW_DAYS}d\",\n        metavar=\"WINDOW\",\n        help=(\n            \"Trailing window (e.g. 30d, 7d, 14d). \"\n            f\"Default: {_BY_DOMAIN_DEFAULT_WINDOW_DAYS}d. \"\n            \"Ignored when --start/--end are provided.\"\n        ),\n    )\n    by_domain.add_argument(\n        \"--start\",\n        default=None,\n        metavar=\"YYYY-MM-DD\",\n        help=\"Start date (inclusive). Must be paired with --end.\",\n    )\n    by_domain.add_argument(\n        \"--end\",\n        default=None,\n        metavar=\"YYYY-MM-DD\",\n        help=\"End date (inclusive). Must be paired with --start.\",\n    )\n    by_domain.add_argument(\n        \"--check-reopen\",\n        action=\"store_true\",\n        dest=\"check_reopen\",\n        help=(\n            \"Filter output to sunset domains (from grandfather-cap.policy.yaml) \"\n            \"with >= 1 spawn. UNKNOWN bucket excluded per M2-CDX-7.\"\n        ),\n    )\n\n\ndef _add_plan081_subparsers(sub: \"argparse._SubParsersAction\",\n                             shared: argparse.ArgumentParser) -> None:\n    \"\"\"Register PLAN-081 Phase 6-bis sub-commands.\n\n    label: Owner labels a pair_rail_case event post-hoc (R1 S-TDE-3).\n    fp-rate: false-positive rate aggregator with reopen-trigger threshold.\n    codex-writeguard-summary: aggregates pair_rail_codex_denylist_hit events\n                              by target_path bucket (R1 S-TDE Q2).\n    \"\"\"\n    # --- label ---\n    label_p = sub.add_parser(\n        \"label\",\n        parents=[shared],\n        help=\"Append a Case-B verdict label to audit-log-labels.jsonl (PLAN-081 Phase 6-bis)\",\n    )\n    label_p.add_argument(\n        \"--run-id\", required=True, dest=\"run_id\",\n        help=\"pair_rail_promotion_run_id (UUID hex) of the event being labeled\",\n    )\n    label_p.add_argument(\n        \"--case\", required=True, choices=sorted(_LABEL_VALID_CASES),\n        help=\"Case letter A-F to label\",\n    )\n    label_p.add_argument(\n        \"--label\", required=True, choices=sorted(_LABEL_VALID_LABELS),\n        help=\"Verdict label: fp | tp | triage_pending | retracted (per ADR-108 §Owner labeling protocol)\",\n    )\n    label_p.add_argument(\n        \"--note\", default=\"\",\n        help=\"Optional free-form note (length is bucketed in audit emit; content NOT stored)\",\n    )\n\n    # --- fp-rate ---\n    fp_p = sub.add_parser(\n        \"fp-rate\",\n        parents=[shared],\n        help=\"Case-B false-positive rate aggregator (PLAN-081 Phase 6-bis R1 S-TDE-3)\",\n    )\n    fp_p.add_argument(\n        \"--window-days\", type=int, default=30, dest=\"window_days\",\n        help=\"Trailing window in days (default 30)\",\n    )\n    fp_p.add_argument(\n        \"--reopen-threshold\", type=float, default=0.30, dest=\"reopen_threshold\",\n        help=\"trigger_reopen=true when fp_rate_lower_bound > threshold (default 0.30 per ADR-108 §FP-rate)\",\n    )\n\n    # --- case-summary ---\n    cs_p = sub.add_parser(\n        \"case-summary\",\n        parents=[shared],\n        help=\"Cases A-F distribution rollup over window (PLAN-081 Phase 6-bis ADR-108 §Operational)\",\n    )\n    cs_p.add_argument(\n        \"--window-days\", type=int, default=7, dest=\"window_days\",\n        help=\"Trailing window in days (default 7 — faster operational signal than 30d)\",\n    )\n\n    # --- codex-writeguard-summary ---\n    cw_p = sub.add_parser(\n        \"codex-writeguard-summary\",\n        parents=[shared],\n        help=\"Codex codando deny-list hit summary by path bucket (PLAN-081 Phase 6-bis R1 S-TDE Q2)\",\n    )\n    cw_p.add_argument(\n        \"--window-days\", type=int, default=30, dest=\"window_days\",\n        help=\"Trailing window in days (default 30)\",\n    )\n    cw_p.add_argument(\n        \"--top\", type=int, default=10,\n        help=\"Top N most-attempted forbidden paths (default 10)\",\n    )\n\n\ndef _add_plan113_subparsers(sub: \"argparse._SubParsersAction\",\n                            shared: argparse.ArgumentParser) -> None:\n    \"\"\"Register PLAN-113 Phase B Wave W1 sub-command.\n\n    critical: surface the 38 critical-security actions (count + first/last\n    ts + safe summary), listing zero-occurrence actions so missing-but-\n    expected critical events are visible (audit-reader-coverage gap).\n    \"\"\"\n    crit = sub.add_parser(\n        \"critical\",\n        parents=[shared],\n        help=(\n            \"Surface critical-security actions (count + last-seen + safe \"\n            \"summary); absent actions listed with count=0 (PLAN-113 W1)\"\n        ),\n    )\n    crit.add_argument(\n        \"--action\",\n        default=None,\n        metavar=\"ACTION\",\n        help=(\n            \"Drill into a single critical action (must be one of the \"\n            \"registry actions; errors otherwise)\"\n        ),\n    )\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    \"\"\"Construct the full audit-query argparse tree.\n\n    Delegates each era of sub-commands to a private helper\n    (``_add_v1_subparsers`` / ``_add_v2_subparsers`` /\n    ``_add_sprint8_9_subparsers`` / ``_add_plan015_subparsers`` /\n    ``_add_plan080_subparsers`` / ``_add_plan081_subparsers``). The\n    public contract of this function is unchanged — callers get back\n    an ``argparse.ArgumentParser`` with ``cmd`` as the required\n    subcommand. Sub-commands get the SUPPRESS-default copy of the shared\n    flags (precedence rule in ``_build_shared_parser``).\n    \"\"\"\n    shared = _build_shared_parser()\n    sub_shared = _build_shared_parser(for_subcommand=True)\n\n    parser = argparse.ArgumentParser(\n        prog=\"audit-query.py\",\n        parents=[shared],\n        description=\"Query the ceo-orchestration agent spawn audit log\",\n        formatter_class=argparse.RawDescriptionHelpFormatter,\n        epilog=(\n            \"Examples:\\n\"\n            \"  audit-query.py summary\\n\"\n            \"  audit-query.py by-skill --top 10\\n\"\n            \"  audit-query.py compliance --json\\n\"\n            \"  audit-query.py search 'security' --include-rotated\\n\"\n            \"  audit-query.py by-day --days 7\\n\"\n            \"  audit-query.py since 2026-04-01\\n\"\n            \"  audit-query.py export --format csv > spawns.csv\\n\"\n            \"  audit-query.py stats --json\\n\"\n            \"  audit-query.py errors\\n\"\n            \"  audit-query.py by-domain --window 30d\\n\"\n            \"  audit-query.py by-domain --start 2026-04-01 --end 2026-05-01\\n\"\n            \"  audit-query.py by-domain --window 30d --check-reopen\\n\"\n            \"  audit-query.py critical\\n\"\n            \"  audit-query.py critical --action kill_switch_invoked --json\\n\"\n        ),\n    )\n\n    sub = parser.add_subparsers(dest=\"cmd\", required=True)\n    _add_v1_subparsers(sub, sub_shared)\n    _add_v2_subparsers(sub, sub_shared)\n    _add_sprint8_9_subparsers(sub, sub_shared)\n    _add_plan015_subparsers(sub, sub_shared)\n    _add_plan080_subparsers(sub, sub_shared)\n    _add_plan081_subparsers(sub, sub_shared)\n    _add_plan113_subparsers(sub, sub_shared)\n\n    return parser\n\n\n# ---------------------------------------------------------------------------\n# main\n# ---------------------------------------------------------------------------\n\n\n","numLines":467,"startLine":1,"totalLines":467}},"tool_result_meta":[{"id":"toolu_01NpstnVS548JxZPkwnyQ7dd","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
