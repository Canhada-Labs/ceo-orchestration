{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01C7cGQiThUjtV4JKt2qD55x","type":"tool_result","content":"1\t\"\"\"Implementation pieces for the budget summary facade.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tdef parse_since(expr: str) -> timedelta:\n6\t    \"\"\"Parse ``Nm`` / ``Nh`` / ``Nd`` into a timedelta. Raises ValueError.\"\"\"\n7\t    m = _SINCE_RE.match(expr.strip().lower())\n8\t    if not m:\n9\t        raise ValueError(\n10\t            f\"bad --since value: {expr!r} (expected Nm / Nh / Nd, e.g. 30d)\"\n11\t        )\n12\t    n = int(m.group(1))\n13\t    unit = m.group(2)\n14\t    if n < 0:\n15\t        raise ValueError(f\"--since must be non-negative: {expr!r}\")\n16\t    if unit == \"m\":\n17\t        return timedelta(minutes=n)\n18\t    if unit == \"h\":\n19\t        return timedelta(hours=n)\n20\t    if unit == \"d\":\n21\t        return timedelta(days=n)\n22\t    raise ValueError(f\"unknown unit: {unit!r}\")  # pragma: no cover\n23\t\n24\t\n25\tdef _parse_ts(ts: Any) -> Optional[datetime]:\n26\t    \"\"\"Parse ISO8601 audit-log timestamp; returns None on miss.\"\"\"\n27\t    if not isinstance(ts, str):\n28\t        return None\n29\t    normalized = ts.replace(\"Z\", \"+0000\")\n30\t    try:\n31\t        return datetime.strptime(normalized, \"%Y-%m-%dT%H:%M:%S%z\")\n32\t    except ValueError:\n33\t        return None\n34\t\n35\t\n36\tdef _parse_ts_any(ts: Any) -> Optional[datetime]:\n37\t    \"\"\"``_parse_ts`` that also accepts fractional-second ISO stamps.\"\"\"\n38\t    if not isinstance(ts, str):\n39\t        return None\n40\t    return _parse_ts(_TS_FRACTION_RE.sub(\"\", ts))\n41\t\n42\t\n43\tdef default_audit_dir() -> Path:\n44\t    \"\"\"Return the canonical audit-log directory.\n45\t\n46\t    Honors ``CEO_AUDIT_LOG_DIR`` env override (used by tests). Otherwise\n47\t    defaults to ``~/.claude/projects/<native-slug>/``.\n48\t    \"\"\"\n49\t    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n50\t    if env_dir:\n51\t        return Path(env_dir)\n52\t    home = os.environ.get(\"HOME\") or str(Path.home())\n53\t    return _rp.runtime_state_dir()\n54\t\n55\t\n56\tdef discover_logs(audit_dir: Optional[Path] = None) -> List[Path]:\n57\t    \"\"\"Return all ``audit-log*.jsonl`` files in the audit dir, sorted.\n58\t\n59\t    Ordering: ``audit-log.jsonl`` (the active log) is read LAST so that\n60\t    when an event is duplicated across rotation boundary the *backup*\n61\t    version wins (it's the immutable, GPG-friendly historical record).\n62\t    Backups are sorted lexicographically (which equals chronological\n63\t    for the ``audit-log-YYYY-MM-N.jsonl`` rotation convention).\n64\t    \"\"\"\n65\t    if audit_dir is None:\n66\t        audit_dir = default_audit_dir()\n67\t    if not audit_dir.is_dir():\n68\t        return []\n69\t    pattern = str(audit_dir / AUDIT_LOG_GLOB)\n70\t    paths = sorted(Path(p) for p in glob.glob(pattern))\n71\t    active: List[Path] = []\n72\t    backups: List[Path] = []\n73\t    for p in paths:\n74\t        if p.name == \"audit-log.jsonl\":\n75\t            active.append(p)\n76\t        else:\n77\t            backups.append(p)\n78\t    return backups + active\n79\t\n80\t\n81\tdef canonical_event_sha256(event: Dict[str, Any]) -> str:\n82\t    \"\"\"Compute sha256 over the canonical form of an event.\n83\t\n84\t    Strips ``_DEDUP_STRIP_FIELDS`` (hmac/hmac_error/hook_duration_ms)\n85\t    so that the *same logical event* mirrored across a rotation\n86\t    boundary canonicalizes identically.\n87\t\n88\t    Returns a 64-char hex digest.\n89\t    \"\"\"\n90\t    canonical = {k: v for k, v in event.items() if k not in _DEDUP_STRIP_FIELDS}\n91\t    blob = json.dumps(canonical, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n92\t    return hashlib.sha256(blob.encode(\"utf-8\")).hexdigest()\n93\t\n94\t\n95\tdef iter_unique_events(\n96\t    log_paths: Iterable[Path],\n97\t    seen: Optional[Set[str]] = None,\n98\t) -> Iterator[Dict[str, Any]]:\n99\t    \"\"\"Yield deduplicated events across multiple log files.\n100\t\n101\t    Tolerates malformed JSON lines (silently skipped — matches\n102\t    ``audit_emit.iter_events`` behavior for forward compatibility).\n103\t    \"\"\"\n104\t    if seen is None:\n105\t        seen = set()\n106\t    for path in log_paths:\n107\t        try:\n108\t            with path.open(\"r\", encoding=\"utf-8\") as f:\n109\t                for raw in f:\n110\t                    raw = raw.strip()\n111\t                    if not raw:\n112\t                        continue\n113\t                    try:\n114\t                        event = json.loads(raw)\n115\t                    except json.JSONDecodeError:\n116\t                        continue\n117\t                    if not isinstance(event, dict):\n118\t                        continue\n119\t                    digest = canonical_event_sha256(event)\n120\t                    if digest in seen:\n121\t                        continue\n122\t                    seen.add(digest)\n123\t                    yield event\n124\t        except OSError:\n125\t            continue\n126\t\n127\t\n128\tdef _safe_plan_id(value: Any) -> Optional[str]:\n129\t    \"\"\"Return value if it matches PLAN-NNN, else None (Sec MF-3 boundary).\"\"\"\n130\t    if not isinstance(value, str):\n131\t        return None\n132\t    if _PLAN_ID_RE.match(value):\n133\t        return value\n134\t    return None\n135\t\n136\t\n137\t\n138\t"}]},"parent_tool_use_id":null,"session_id":"208d6398-50f3-4598-a736-f21d26865a99","uuid":"9ca3b613-4ed5-4a79-b247-43d4f23577fe","timestamp":"2026-11-15T11:03:30.726Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.tG8bbW/tree/.claude/hooks/_lib/_budget_summary_parts/audit_events.py","content":"\"\"\"Implementation pieces for the budget summary facade.\"\"\"\n\nfrom __future__ import annotations\n\ndef parse_since(expr: str) -> timedelta:\n    \"\"\"Parse ``Nm`` / ``Nh`` / ``Nd`` into a timedelta. Raises ValueError.\"\"\"\n    m = _SINCE_RE.match(expr.strip().lower())\n    if not m:\n        raise ValueError(\n            f\"bad --since value: {expr!r} (expected Nm / Nh / Nd, e.g. 30d)\"\n        )\n    n = int(m.group(1))\n    unit = m.group(2)\n    if n < 0:\n        raise ValueError(f\"--since must be non-negative: {expr!r}\")\n    if unit == \"m\":\n        return timedelta(minutes=n)\n    if unit == \"h\":\n        return timedelta(hours=n)\n    if unit == \"d\":\n        return timedelta(days=n)\n    raise ValueError(f\"unknown unit: {unit!r}\")  # pragma: no cover\n\n\ndef _parse_ts(ts: Any) -> Optional[datetime]:\n    \"\"\"Parse ISO8601 audit-log timestamp; returns None on miss.\"\"\"\n    if not isinstance(ts, str):\n        return None\n    normalized = ts.replace(\"Z\", \"+0000\")\n    try:\n        return datetime.strptime(normalized, \"%Y-%m-%dT%H:%M:%S%z\")\n    except ValueError:\n        return None\n\n\ndef _parse_ts_any(ts: Any) -> Optional[datetime]:\n    \"\"\"``_parse_ts`` that also accepts fractional-second ISO stamps.\"\"\"\n    if not isinstance(ts, str):\n        return None\n    return _parse_ts(_TS_FRACTION_RE.sub(\"\", ts))\n\n\ndef default_audit_dir() -> Path:\n    \"\"\"Return the canonical audit-log directory.\n\n    Honors ``CEO_AUDIT_LOG_DIR`` env override (used by tests). Otherwise\n    defaults to ``~/.claude/projects/<native-slug>/``.\n    \"\"\"\n    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n    if env_dir:\n        return Path(env_dir)\n    home = os.environ.get(\"HOME\") or str(Path.home())\n    return _rp.runtime_state_dir()\n\n\ndef discover_logs(audit_dir: Optional[Path] = None) -> List[Path]:\n    \"\"\"Return all ``audit-log*.jsonl`` files in the audit dir, sorted.\n\n    Ordering: ``audit-log.jsonl`` (the active log) is read LAST so that\n    when an event is duplicated across rotation boundary the *backup*\n    version wins (it's the immutable, GPG-friendly historical record).\n    Backups are sorted lexicographically (which equals chronological\n    for the ``audit-log-YYYY-MM-N.jsonl`` rotation convention).\n    \"\"\"\n    if audit_dir is None:\n        audit_dir = default_audit_dir()\n    if not audit_dir.is_dir():\n        return []\n    pattern = str(audit_dir / AUDIT_LOG_GLOB)\n    paths = sorted(Path(p) for p in glob.glob(pattern))\n    active: List[Path] = []\n    backups: List[Path] = []\n    for p in paths:\n        if p.name == \"audit-log.jsonl\":\n            active.append(p)\n        else:\n            backups.append(p)\n    return backups + active\n\n\ndef canonical_event_sha256(event: Dict[str, Any]) -> str:\n    \"\"\"Compute sha256 over the canonical form of an event.\n\n    Strips ``_DEDUP_STRIP_FIELDS`` (hmac/hmac_error/hook_duration_ms)\n    so that the *same logical event* mirrored across a rotation\n    boundary canonicalizes identically.\n\n    Returns a 64-char hex digest.\n    \"\"\"\n    canonical = {k: v for k, v in event.items() if k not in _DEDUP_STRIP_FIELDS}\n    blob = json.dumps(canonical, sort_keys=True, ensure_ascii=False, separators=(\",\", \":\"))\n    return hashlib.sha256(blob.encode(\"utf-8\")).hexdigest()\n\n\ndef iter_unique_events(\n    log_paths: Iterable[Path],\n    seen: Optional[Set[str]] = None,\n) -> Iterator[Dict[str, Any]]:\n    \"\"\"Yield deduplicated events across multiple log files.\n\n    Tolerates malformed JSON lines (silently skipped — matches\n    ``audit_emit.iter_events`` behavior for forward compatibility).\n    \"\"\"\n    if seen is None:\n        seen = set()\n    for path in log_paths:\n        try:\n            with path.open(\"r\", encoding=\"utf-8\") as f:\n                for raw in f:\n                    raw = raw.strip()\n                    if not raw:\n                        continue\n                    try:\n                        event = json.loads(raw)\n                    except json.JSONDecodeError:\n                        continue\n                    if not isinstance(event, dict):\n                        continue\n                    digest = canonical_event_sha256(event)\n                    if digest in seen:\n                        continue\n                    seen.add(digest)\n                    yield event\n        except OSError:\n            continue\n\n\ndef _safe_plan_id(value: Any) -> Optional[str]:\n    \"\"\"Return value if it matches PLAN-NNN, else None (Sec MF-3 boundary).\"\"\"\n    if not isinstance(value, str):\n        return None\n    if _PLAN_ID_RE.match(value):\n        return value\n    return None\n\n\n\n","numLines":138,"startLine":1,"totalLines":138}},"tool_result_meta":[{"id":"toolu_01C7cGQiThUjtV4JKt2qD55x","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
