{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017gtzmsMW9m2LwjT27VERj6","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"audit-query — query the ceo-orchestration agent spawn audit log.\n3\t\n4\tStdlib-only CLI that reads `audit-log.jsonl` (+ rotated siblings) and\n5\tanswers common operator questions:\n6\t\n7\t    audit-query.py summary\n8\t    audit-query.py by-skill [--top N]\n9\t    audit-query.py compliance\n10\t    audit-query.py by-day [--days N]\n11\t    audit-query.py search <regex>\n12\t    audit-query.py since <ISO-date>\n13\t    audit-query.py errors\n14\t    audit-query.py stats\n15\t    audit-query.py export [--format csv|json|tsv]\n16\t    audit-query.py by-domain [--window=30d|--start=YYYY-MM-DD --end=YYYY-MM-DD]\n17\t                              [--check-reopen]\n18\t\n19\tDefault input path:\n20\t    ${CEO_AUDIT_LOG_PATH:-$HOME/.claude/projects/<native-slug>/audit-log.jsonl}\n21\t\n22\tPass `--log <path>` to override or `--include-rotated` to aggregate\n23\tacross all `audit-log*.jsonl` in the audit directory.\n24\t\n25\tOutput formats:\n26\t    - Default: human-readable tab-separated table\n27\t    - `--json` flag: machine-readable JSON\n28\t    - `--csv` flag: CSV\n29\t\n30\tExit codes:\n31\t    0 — success (including empty result set)\n32\t    1 — log file missing OR bad query\n33\t    2 — unreadable log file (permissions, etc.)\n34\t\"\"\"\n35\t\n36\tfrom __future__ import annotations\n37\t\n38\timport argparse\n39\tfrom copy import deepcopy\n40\timport csv\n41\timport io\n42\timport json\n43\timport os\n44\timport re\n45\timport sys\n46\tfrom types import FunctionType\n47\tfrom collections import Counter, defaultdict\n48\tfrom datetime import datetime, timedelta, timezone\n49\tfrom pathlib import Path\n50\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n51\timport sys as _sys_rp\n52\tfrom pathlib import Path as _Path_rp\n53\t_HOOKS_RP = _Path_rp(__file__).resolve()\n54\tfor _anc in _HOOKS_RP.parents:\n55\t    if (_anc / \".claude\" / \"hooks\" / \"_lib\").is_dir():\n56\t        if str(_anc / \".claude\" / \"hooks\") not in _sys_rp.path:\n57\t            _sys_rp.path.insert(0, str(_anc / \".claude\" / \"hooks\"))\n58\t        break\n59\tfrom _lib import runtime_paths as _rp  # noqa: E402  # PLAN-182 W1 single resolver\n60\t\n61\t\n62\t# ---------------------------------------------------------------------------\n63\t# Path resolution (mirrors audit_log.py conventions)\n64\t# ---------------------------------------------------------------------------\n65\t\n66\t\n67\tdef default_log_path() -> Path:\n68\t    \"\"\"Return the conventional audit log path from env vars / defaults.\"\"\"\n69\t    home = Path(os.environ.get(\"HOME\") or str(Path.home()))\n70\t    default_dir = _rp.runtime_state_dir()\n71\t    return Path(\n72\t        os.environ.get(\"CEO_AUDIT_LOG_PATH\") or str(default_dir / \"audit-log.jsonl\")\n73\t    )\n74\t\n75\t\n76\tdef default_errors_path() -> Path:\n77\t    env = os.environ.get(\"CEO_AUDIT_LOG_ERR\")\n78\t    if env:\n79\t        return Path(env)\n80\t    # rail r2 G: family-follows-log — o errors mora ao lado do LOG efetivo\n81\t    # (com CEO_AUDIT_LOG_PATH setado, os escritores poem o breadcrumb no\n82\t    # parent do PATH; ler do default perderia exatamente esses erros).\n83\t    env_log = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n84\t    if env_log:\n85\t        return Path(env_log).resolve().parent / \"audit-log.errors\"\n86\t    # rail r3 P2: espelha a cascata dos ESCRITORES — DIR-only poe o\n87\t    # breadcrumb sob CEO_AUDIT_LOG_DIR.\n88\t    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n89\t    if env_dir:\n90\t        return Path(env_dir) / \"audit-log.errors\"\n91\t    return _rp.runtime_state_dir() / \"audit-log.errors\"\n92\t\n93\t\n94\tdef discover_logs(primary: Path, include_rotated: bool) -> List[Path]:\n95\t    \"\"\"Return the list of log files to read, sorted by modification time.\"\"\"\n96\t    if not include_rotated:\n97\t        return [primary] if primary.is_file() else []\n98\t    if not primary.parent.is_dir():\n99\t        return []\n100\t    stem = primary.stem  # \"audit-log\"\n101\t    siblings = []\n102\t    for candidate in primary.parent.glob(f\"{stem}*.jsonl\"):\n103\t        if candidate.is_file():\n104\t            siblings.append(candidate)\n105\t    # Sort: primary file last so its entries are newest in the stream\n106\t    siblings.sort(key=lambda p: p.stat().st_mtime)\n107\t    return siblings\n108\t\n109\t\n110\t# ---------------------------------------------------------------------------\n111\t# Streaming reader — tolerates malformed lines with a stderr breadcrumb\n112\t# ---------------------------------------------------------------------------\n113\t\n114\t\n115\t# ---------------------------------------------------------------------------\n116\t# Perf-P1-002 — large-log materialization warning threshold.\n117\t#\n118\t# Subcommands that need FULL context (median, percentile, debate grouping,\n119\t# weekly-summary) still materialize the list. At this size threshold we\n120\t# emit a stderr hint so operators learn the log grew past the streaming\n121\t# regime and consider `--include-rotated=false` or log rotation.\n122\t# Value = 100_000 entries ≈ ~40-80 MB typical ≈ ~500-900ms parse on a\n123\t# modern laptop. Under this bar the materialization is unnoticeable.\n124\t_MATERIALIZATION_WARN_THRESHOLD = 100_000\n125\t\n126\t\n127\tdef read_entries(\n128\t    paths: Iterable[Path],\n129\t    *,\n130\t    warn_stream=None,\n131\t) -> Iterator[Dict[str, Any]]:\n132\t    \"\"\"Yield parsed JSON entries from the given log paths, streaming.\n133\t\n134\t    Malformed lines are skipped with a breadcrumb to warn_stream.\n135\t    Large logs are read line-by-line so memory stays constant.\n136\t\n137\t    Note: warn_stream defaults to None → resolved to sys.stderr at call\n138\t    time, not definition time, so test harness stderr redirection works.\n139\t    \"\"\"\n140\t    if warn_stream is None:\n141\t        warn_stream = sys.stderr\n142\t    for path in paths:\n143\t        try:\n144\t            with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n145\t                for lineno, line in enumerate(f, start=1):\n146\t                    line = line.strip()\n147\t                    if not line:\n148\t                        continue\n149\t                    try:\n150\t                        entry = json.loads(line)\n151\t                    except json.JSONDecodeError as e:\n152\t                        print(\n153\t                            f\"[audit-query] WARN: {path}:{lineno}: \"\n154\t                            f\"skipping malformed JSONL ({e.msg})\",\n155\t                            file=warn_stream,\n156\t                        )\n157\t                        continue\n158\t                    if not isinstance(entry, dict):\n159\t                        continue\n160\t                    yield entry\n161\t        except OSError as e:\n162\t            print(\n163\t                f\"[audit-query] WARN: cannot read {path}: {e}\",\n164\t                file=warn_stream,\n165\t            )\n166\t\n167\t\n168\t# ---------------------------------------------------------------------------\n169\t# Sub-command implementations\n170\t# ---------------------------------------------------------------------------\n171\t\n172\t\n173\t\n174\t# Query aggregations live outside this compatibility facade.  The named\n175\t# delegates below intentionally remain: downstream consumers load this\n176\t# hyphenated file by path and the read-API freeze guard inspects its AST.\n177\tfrom _lib._audit_query import queries as _queries\n178\tfrom _lib._audit_query import reporting as _reporting\n179\tfrom _lib._audit_query import reporting_health as _reporting_health\n180\tfrom _lib._audit_query import domain as _domain\n181\tfrom _lib._audit_query import rendering as _rendering\n182\tfrom _lib._audit_query import labeling as _labeling\n183\tfrom _lib._audit_query import critical as _critical\n184\tfrom _lib._audit_query import parsing as _parsing\n185\t\n186\t_EXTRACTED_MODULES = (\n187\t    _domain, _rendering, _labeling, _critical, _parsing,\n188\t)\n189\t# Copy all declared values with one memo per facade. Mutable dictionaries and\n190\t# sets belong to this import, not to the cached declaration templates; a\n191\t# single deepcopy also preserves aliases across the exported declarations.\n192\t_extracted_declarations = {}\n193\tfor _section in _EXTRACTED_MODULES:\n194\t    for _symbol in _section.__all__:\n195\t        _extracted_declarations[_symbol] = getattr(_section, _symbol)\n196\t    globals().setdefault(\"__annotations__\", {}).update(\n197\t        dict(getattr(_section, \"__annotations__\", {}))\n198\t    )\n199\tglobals().update(deepcopy(_extracted_declarations))\n200\tdel _extracted_declarations\n201\t# Functions use this facade as their sole global namespace after rebinding.\n202\t# A path constant is relative to the original CLI, not its extracted module.\n203\t_LABEL_STORE_PATH = Path(__file__).resolve().parent / \"audit-log-labels.jsonl\"\n204\t\n205\t\n206\tdef _bind_query_functions():\n207\t    \"\"\"Re-home extracted functions in this module's historical globals.\n208\t\n209\t    Tests and downstream scripts load this hyphenated file by path and patch\n210\t    its globals.  FunctionType keeps the implementation in a real module\n211\t    while making those patches visible to the extracted code.\n212\t    \"\"\"\n213\t    bound = {}\n214\t    for implementation in (_queries, _reporting, _reporting_health, *_EXTRACTED_MODULES):\n215\t        for name, value in vars(implementation).items():\n216\t            if not isinstance(value, FunctionType) or value.__module__ != implementation.__name__:\n217\t                continue\n218\t            clone = FunctionType(value.__code__, globals(), name, value.__defaults__, value.__closure__)\n219\t            clone.__kwdefaults__ = value.__kwdefaults__\n220\t            clone.__annotations__ = value.__annotations__\n221\t            clone.__dict__.update(value.__dict__)\n222\t            clone.__doc__ = value.__doc__\n223\t            bound[name] = clone\n224\t            globals()[name] = clone\n225\t    return bound\n226\t\n227\t\n228\t_query_impls = _bind_query_functions()\n229\t\n230\t\n231\tdef _query_call(name, *args):\n232\t    return _query_impls[name](*args)\n233\t\n234\t\n235\tdef cmd_summary(entries, args): return _query_call(\"cmd_summary\", entries, args)\n236\tdef cmd_by_skill(entries, args): return _query_call(\"cmd_by_skill\", entries, args)\n237\tdef cmd_compliance(entries, args): return _query_call(\"cmd_compliance\", entries, args)\n238\tdef cmd_by_day(entries, args): return _query_call(\"cmd_by_day\", entries, args)\n239\tdef cmd_search(entries, args): return _query_call(\"cmd_search\", entries, args)\n240\tdef cmd_since(entries, args): return _query_call(\"cmd_since\", entries, args)\n241\tdef cmd_stats(entries, args): return _query_call(\"cmd_stats\", entries, args)\n242\tdef cmd_errors(args): return _query_call(\"cmd_errors\", args)\n243\tdef cmd_debate(entries, args): return _query_call(\"cmd_debate\", entries, args)\n244\tdef cmd_plans(entries, args): return _query_call(\"cmd_plans\", entries, args)\n245\tdef cmd_vetoes(entries, args): return _query_call(\"cmd_vetoes\", entries, args)\n246\tdef _bench_cost_usd(r: Dict[str, Any]) -> float:\n247\t    \"\"\"Per-run benchmark cost in USD. Prefers the int-encoded\n248\t    ``cost_usd_cents`` (÷100); falls back to a legacy float ``cost_usd``.\n249\t    Returns 0.0 when neither is present (pre-cost-instrumented runs).\"\"\"\n250\t    cents = r.get(\"cost_usd_cents\")\n251\t    if cents is not None:\n252\t        try:\n253\t            return int(cents) / 100.0\n254\t        except (TypeError, ValueError):\n255\t            return 0.0\n256\t    try:\n257\t        return float(r.get(\"cost_usd\") or 0.0)\n258\t    except (TypeError, ValueError):\n259\t        return 0.0\n260\t\n261\t\n262\tdef _bench_duration_s(r: Dict[str, Any]) -> float:\n263\t    \"\"\"Per-run wall-clock (the harbor 'compute' column) in seconds.\n264\t    Prefers int-encoded ``duration_ms`` (÷1000); falls back to legacy\n265\t    float ``duration_s``.\"\"\"\n266\t    ms = r.get(\"duration_ms\")\n267\t    if ms is not None:\n268\t        try:\n269\t            return int(ms) / 1000.0\n270\t        except (TypeError, ValueError):\n271\t            return 0.0\n272\t    try:\n273\t        return float(r.get(\"duration_s\") or 0.0)\n274\t    except (TypeError, ValueError):\n275\t        return 0.0\n276\t\n277\t\n278\tdef _bench_turns(r: Dict[str, Any]) -> int:\n279\t    \"\"\"Per-run scenario count (the harbor 'turns' column). Each scenario\n280\t    is one model interaction unit; pass+fail covers every scored\n281\t    scenario. Tolerates missing counts.\"\"\"\n282\t    try:\n283\t        return int(r.get(\"pass_count\") or 0) + int(r.get(\"fail_count\") or 0)\n284\t    except (TypeError, ValueError):\n285\t        return 0\n286\t\n287\t\n288\tdef cmd_benchmarks(\n289\t    entries: List[Dict[str, Any]], args\n290\t) -> List[Dict[str, Any]]:\n291\t    \"\"\"Aggregate benchmark_run rows by skill. Sprint 5 A.2; PLAN-133 C4.\n292\t\n293\t    Reports run count, latest pass_rate, median across runs, cumulative\n294\t    lessons_written per skill.\n295\t\n296\t    PLAN-133 C4 (harbor-style row): co-reports **cost + compute + turns\n297\t    alongside pass-rate** so a benchmark is never read as a bare scalar.\n298\t    The added columns are strictly additive (existing keys unchanged) and\n299\t    derive only from fields already on the ``benchmark_run`` event\n300\t    (``cost_usd_cents``, ``duration_ms``, ``pass_count``/``fail_count``) —\n301\t    no SPEC change is required, so this reader stays $0 and canonical-free.\n302\t    \"\"\"\n303\t    by_skill: Dict[str, List[Dict[str, Any]]] = defaultdict(list)\n304\t    for e in entries:\n305\t        if e.get(\"action\") != \"benchmark_run\":\n306\t            continue\n307\t        by_skill[e.get(\"skill\", \"?\")].append(e)\n308\t    out = []\n309\t    for skill in sorted(by_skill.keys()):\n310\t        runs = sorted(by_skill[skill], key=lambda r: r.get(\"ts\") or \"\")\n311\t        # Prefer new int-encoded fields (bps ÷ 1000 → float); fall back to\n312\t        # the legacy float fields for logs written before the migration.\n313\t        def _pass_rate(r: Dict[str, Any]) -> float:\n314\t            bps = r.get(\"pass_rate_bps\")\n315\t            if bps is not None:\n316\t                return int(bps) / 1000.0\n317\t            return float(r.get(\"pass_rate\") or 0.0)\n318\t\n319\t        def _floor_rate(r: Dict[str, Any]) -> float:\n320\t            bps = r.get(\"floor_bps\")\n321\t            if bps is not None:\n322\t                return int(bps) / 1000.0\n323\t            return float(r.get(\"floor\") or 0.0)\n324\t\n325\t        rates = [_pass_rate(r) for r in runs]\n326\t        if rates:\n327\t            med = _percentile(sorted(rates), 50)\n328\t        else:\n329\t            med = 0.0\n330\t        latest = runs[-1]\n331\t        # PLAN-133 C4 — harbor-style compute/cost/turns co-report.\n332\t        # Cumulative across all runs for the skill + the latest single run,\n333\t        # so an operator sees both the trend cost and the marginal cost.\n334\t        total_cost = sum(_bench_cost_usd(r) for r in runs)\n335\t        total_compute_s = sum(_bench_duration_s(r) for r in runs)\n336\t        total_turns = sum(_bench_turns(r) for r in runs)\n337\t        out.append(\n338\t            {\n339\t                \"skill\": skill,\n340\t                \"runs\": len(runs),\n341\t                \"latest_pass_rate\": round(_pass_rate(latest), 3),\n342\t                \"median_pass_rate\": med,\n343\t                \"last_floor\": _floor_rate(latest),\n344\t                \"latest_ts\": latest.get(\"ts\"),\n345\t                \"total_lessons_written\": sum(\n346\t                    int(r.get(\"lessons_written\") or 0) for r in runs\n347\t                ),\n348\t                # --- PLAN-133 C4 harbor-style row (additive) ---\n349\t                \"latest_cost_usd\": round(_bench_cost_usd(latest), 6),\n350\t                \"total_cost_usd\": round(total_cost, 6),\n351\t                \"latest_compute_s\": round(_bench_duration_s(latest), 3),\n352\t                \"total_compute_s\": round(total_compute_s, 3),\n353\t                \"latest_turns\": _bench_turns(latest),\n354\t                \"total_turns\": total_turns,\n355\t            }\n356\t        )\n357\t    return out\n358\t\n359\t\n360\tdef cmd_lessons(entries, args): return _query_call(\"cmd_lessons\", entries, args)\n361\tdef cmd_lessons_effectiveness(entries, args): return _query_call(\"cmd_lessons_effectiveness\", entries, args)\n362\tdef cmd_spawn_stats(entries, args): return _query_call(\"cmd_spawn_stats\", entries, args)\n363\tdef cmd_weekly_summary(entries, args): return _query_call(\"cmd_weekly_summary\", entries, args)\n364\tdef cmd_architect_outcomes(entries, args): return _query_call(\"cmd_architect_outcomes\", entries, args)\n365\tdef cmd_prune_restore_ratio(entries, args): return _query_call(\"cmd_prune_restore_ratio\", entries, args)\n366\tdef cmd_claims(entries, args): return _query_call(\"cmd_claims\", entries, args)\n367\tdef cmd_metrics(entries, args): return _query_call(\"cmd_metrics\", entries, args)\n368\tdef cmd_tokens(entries, args): return _query_call(\"cmd_tokens\", entries, args)\n369\tdef cmd_health(entries, args): return _query_call(\"cmd_health\", entries, args)\n370\tdef cmd_export(entries, args): return _query_call(\"cmd_export\", entries, args)\n371\t\n372\t\n373\tfor _query_name in (\n374\t    \"cmd_summary\", \"cmd_by_skill\", \"cmd_compliance\", \"cmd_by_day\", \"cmd_search\",\n375\t    \"cmd_since\", \"cmd_stats\", \"cmd_errors\", \"cmd_export\", \"cmd_debate\",\n376\t    \"cmd_plans\", \"cmd_vetoes\", \"cmd_lessons\", \"cmd_lessons_effectiveness\",\n377\t    \"cmd_spawn_stats\", \"cmd_weekly_summary\", \"cmd_architect_outcomes\",\n378\t    \"cmd_prune_restore_ratio\", \"cmd_claims\", \"cmd_metrics\", \"cmd_health\",\n379\t    \"cmd_tokens\",\n380\t):\n381\t    _query_wrapper = globals()[_query_name]\n382\t    _query_impl = _query_impls[_query_name]\n383\t    _query_wrapper.__doc__ = _query_impl.__doc__\n384\t    _query_wrapper.__annotations__ = _query_impl.__annotations__\n385\t    _query_wrapper.__wrapped__ = _query_impl\n386\t\n387\t# ---------------------------------------------------------------------------\n388\t# PLAN-080 Phase 1 — by-domain sub-command\n389\t# ---------------------------------------------------------------------------\n390\t\n391\t# Default window for by-domain (calendar days, trailing from UTC midnight)\n392\t\n393\t\n394\t# Remaining domain implementations are rebound above the CLI entrypoint.\n395\tdef main(argv: Optional[List[str]] = None) -> int:\n396\t    \"\"\"CLI entrypoint — dispatch audit-query sub-commands.\"\"\"\n397\t    parser = build_parser()\n398\t    args = parser.parse_args(argv)\n399\t\n400\t    # `errors` subcommand reads a different file, doesn't need the jsonl\n401\t    if args.cmd == \"errors\":\n402\t        result = cmd_errors(args)\n403\t        print(render(result, as_json=args.as_json, as_csv=args.as_csv))\n404\t        return 0\n405\t\n406\t    log_path = Path(args.log) if args.log else default_log_path()\n407\t    log_files = discover_logs(log_path, args.include_rotated)\n408\t\n409\t    # Perf-P1-002 — streamable subcommands consume the iterator directly so\n410\t    # a 100k-row log does not sit in RAM as a Python list.  Non-streamable\n411\t    # subcommands (median / percentile / cross-reference) still materialize\n412\t    # but emit a stderr hint when the log crosses the warn threshold.\n413\t    _STREAMABLE_CMDS = frozenset({\n414\t        \"summary\", \"by-skill\", \"by-day\", \"search\", \"since\",\n415\t    })\n416\t\n417\t    if not log_files:\n418\t        entries_iter: Iterable[Dict[str, Any]] = iter(())\n419\t        entries: List[Dict[str, Any]] = []\n420\t    elif args.cmd in _STREAMABLE_CMDS:\n421\t        entries_iter = read_entries(log_files)\n422\t        entries = []  # sentinel — not used on streaming path\n423\t    else:\n424\t        entries = list(read_entries(log_files))\n425\t        entries_iter = entries\n426\t        if len(entries) >= _MATERIALIZATION_WARN_THRESHOLD:\n427\t            print(\n428\t                \"[audit-query] NOTE: loaded {n} entries into RAM for \"\n429\t                \"subcommand {cmd!r} (threshold {thr}). Consider rotating \"\n430\t                \"older logs or running a streamable subcommand.\".format(\n431\t                    n=len(entries),\n432\t                    cmd=args.cmd,\n433\t                    thr=_MATERIALIZATION_WARN_THRESHOLD,\n434\t                ),\n435\t                file=sys.stderr,\n436\t            )\n437\t\n438\t    if args.cmd == \"summary\":\n439\t        result = cmd_summary(entries_iter, args)\n440\t    elif args.cmd == \"by-skill\":\n441\t        result = cmd_by_skill(entries_iter, args)\n442\t    elif args.cmd == \"compliance\":\n443\t        result = cmd_compliance(entries, args)\n444\t    elif args.cmd == \"by-day\":\n445\t        result = cmd_by_day(entries_iter, args)\n446\t    elif args.cmd == \"search\":\n447\t        result = cmd_search(entries_iter, args)\n448\t    elif args.cmd == \"since\":\n449\t        result = cmd_since(entries_iter, args)\n450\t    elif args.cmd == \"stats\":\n451\t        result = cmd_stats(entries, args)\n452\t    elif args.cmd == \"export\":\n453\t        result = cmd_export(entries, args)\n454\t        # Export handles its own formatting\n455\t        if args.export_format in (\"csv\", \"tsv\"):\n456\t            sys.stdout.write(result)\n457\t            return 0\n458\t        print(json.dumps(result, indent=2, ensure_ascii=True))\n459\t        return 0\n460\t    # Sprint 5 A.2 — 7 new sub-commands\n461\t    elif args.cmd == \"debate\":\n462\t        result = cmd_debate(entries, args)\n463\t    elif args.cmd == \"plans\":\n464\t        result = cmd_plans(entries, args)\n465\t    elif args.cmd == \"vetoes\":\n466\t        result = cmd_vetoes(entries, args)\n467\t    elif args.cmd == \"benchmarks\":\n468\t        result = cmd_benchmarks(entries, args)\n469\t    elif args.cmd == \"lessons\":\n470\t        result = cmd_lessons(entries, args)\n471\t    elif args.cmd == \"metrics\":\n472\t        result = cmd_metrics(entries, args)\n473\t    elif args.cmd == \"health\":\n474\t        result = cmd_health(entries, args)\n475\t    elif args.cmd == \"tokens\":\n476\t        result = cmd_tokens(entries, args)\n477\t    elif args.cmd == \"claims\":\n478\t        result = cmd_claims(entries, args)\n479\t    elif args.cmd == \"prune-restore-ratio\":\n480\t        result = cmd_prune_restore_ratio(entries, args)\n481\t    elif args.cmd == \"architect-outcomes\":\n482\t        result = cmd_architect_outcomes(entries, args)\n483\t    elif args.cmd == \"lessons-effectiveness\":\n484\t        result = cmd_lessons_effectiveness(entries, args)\n485\t    elif args.cmd == \"weekly-summary\":\n486\t        result = cmd_weekly_summary(entries, args)\n487\t    elif args.cmd == \"spawn-stats\":\n488\t        result = cmd_spawn_stats(entries, args)\n489\t    # PLAN-080 Phase 1\n490\t    elif args.cmd == \"by-domain\":\n491\t        result = cmd_by_domain(entries, args)\n492\t    # PLAN-081 Phase 6-bis\n493\t    elif args.cmd == \"label\":\n494\t        result = cmd_label(entries, args)\n495\t    elif args.cmd == \"fp-rate\":\n496\t        result = cmd_fp_rate(entries, args)\n497\t    elif args.cmd == \"case-summary\":\n498\t        result = cmd_case_summary(entries, args)\n499\t    elif args.cmd == \"codex-writeguard-summary\":\n500\t        result = cmd_codex_writeguard_summary(entries, args)\n501\t    # PLAN-113 Phase B Wave W1 — critical-security-action reader\n502\t    elif args.cmd == \"critical\":\n503\t        result = cmd_critical(entries, args)\n504\t    else:  # pragma: no cover — argparse prevents this\n505\t        parser.error(f\"unknown cmd: {args.cmd}\")\n506\t\n507\t    print(render(result, as_json=args.as_json, as_csv=args.as_csv))\n508\t    return 0\n509\t\n510\t\n511\tif __name__ == \"__main__\":\n512\t    sys.exit(main())\n513\t"}]},"parent_tool_use_id":null,"session_id":"491a10bf-cca8-4c48-ae81-b32fc5bafb56","uuid":"f7fb8097-b4c7-495a-9a80-b735c242c817","timestamp":"2026-11-13T18:10:26.721Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.nUJTgA/tree/.claude/scripts/audit-query.py","content":"#!/usr/bin/env python3\n\"\"\"audit-query — query the ceo-orchestration agent spawn audit log.\n\nStdlib-only CLI that reads `audit-log.jsonl` (+ rotated siblings) and\nanswers common operator questions:\n\n    audit-query.py summary\n    audit-query.py by-skill [--top N]\n    audit-query.py compliance\n    audit-query.py by-day [--days N]\n    audit-query.py search <regex>\n    audit-query.py since <ISO-date>\n    audit-query.py errors\n    audit-query.py stats\n    audit-query.py export [--format csv|json|tsv]\n    audit-query.py by-domain [--window=30d|--start=YYYY-MM-DD --end=YYYY-MM-DD]\n                              [--check-reopen]\n\nDefault input path:\n    ${CEO_AUDIT_LOG_PATH:-$HOME/.claude/projects/<native-slug>/audit-log.jsonl}\n\nPass `--log <path>` to override or `--include-rotated` to aggregate\nacross all `audit-log*.jsonl` in the audit directory.\n\nOutput formats:\n    - Default: human-readable tab-separated table\n    - `--json` flag: machine-readable JSON\n    - `--csv` flag: CSV\n\nExit codes:\n    0 — success (including empty result set)\n    1 — log file missing OR bad query\n    2 — unreadable log file (permissions, etc.)\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nfrom copy import deepcopy\nimport csv\nimport io\nimport json\nimport os\nimport re\nimport sys\nfrom types import FunctionType\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\nimport sys as _sys_rp\nfrom pathlib import Path as _Path_rp\n_HOOKS_RP = _Path_rp(__file__).resolve()\nfor _anc in _HOOKS_RP.parents:\n    if (_anc / \".claude\" / \"hooks\" / \"_lib\").is_dir():\n        if str(_anc / \".claude\" / \"hooks\") not in _sys_rp.path:\n            _sys_rp.path.insert(0, str(_anc / \".claude\" / \"hooks\"))\n        break\nfrom _lib import runtime_paths as _rp  # noqa: E402  # PLAN-182 W1 single resolver\n\n\n# ---------------------------------------------------------------------------\n# Path resolution (mirrors audit_log.py conventions)\n# ---------------------------------------------------------------------------\n\n\ndef default_log_path() -> Path:\n    \"\"\"Return the conventional audit log path from env vars / defaults.\"\"\"\n    home = Path(os.environ.get(\"HOME\") or str(Path.home()))\n    default_dir = _rp.runtime_state_dir()\n    return Path(\n        os.environ.get(\"CEO_AUDIT_LOG_PATH\") or str(default_dir / \"audit-log.jsonl\")\n    )\n\n\ndef default_errors_path() -> Path:\n    env = os.environ.get(\"CEO_AUDIT_LOG_ERR\")\n    if env:\n        return Path(env)\n    # rail r2 G: family-follows-log — o errors mora ao lado do LOG efetivo\n    # (com CEO_AUDIT_LOG_PATH setado, os escritores poem o breadcrumb no\n    # parent do PATH; ler do default perderia exatamente esses erros).\n    env_log = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n    if env_log:\n        return Path(env_log).resolve().parent / \"audit-log.errors\"\n    # rail r3 P2: espelha a cascata dos ESCRITORES — DIR-only poe o\n    # breadcrumb sob CEO_AUDIT_LOG_DIR.\n    env_dir = os.environ.get(\"CEO_AUDIT_LOG_DIR\")\n    if env_dir:\n        return Path(env_dir) / \"audit-log.errors\"\n    return _rp.runtime_state_dir() / \"audit-log.errors\"\n\n\ndef discover_logs(primary: Path, include_rotated: bool) -> List[Path]:\n    \"\"\"Return the list of log files to read, sorted by modification time.\"\"\"\n    if not include_rotated:\n        return [primary] if primary.is_file() else []\n    if not primary.parent.is_dir():\n        return []\n    stem = primary.stem  # \"audit-log\"\n    siblings = []\n    for candidate in primary.parent.glob(f\"{stem}*.jsonl\"):\n        if candidate.is_file():\n            siblings.append(candidate)\n    # Sort: primary file last so its entries are newest in the stream\n    siblings.sort(key=lambda p: p.stat().st_mtime)\n    return siblings\n\n\n# ---------------------------------------------------------------------------\n# Streaming reader — tolerates malformed lines with a stderr breadcrumb\n# ---------------------------------------------------------------------------\n\n\n# ---------------------------------------------------------------------------\n# Perf-P1-002 — large-log materialization warning threshold.\n#\n# Subcommands that need FULL context (median, percentile, debate grouping,\n# weekly-summary) still materialize the list. At this size threshold we\n# emit a stderr hint so operators learn the log grew past the streaming\n# regime and consider `--include-rotated=false` or log rotation.\n# Value = 100_000 entries ≈ ~40-80 MB typical ≈ ~500-900ms parse on a\n# modern laptop. Under this bar the materialization is unnoticeable.\n_MATERIALIZATION_WARN_THRESHOLD = 100_000\n\n\ndef read_entries(\n    paths: Iterable[Path],\n    *,\n    warn_stream=None,\n) -> Iterator[Dict[str, Any]]:\n    \"\"\"Yield parsed JSON entries from the given log paths, streaming.\n\n    Malformed lines are skipped with a breadcrumb to warn_stream.\n    Large logs are read line-by-line so memory stays constant.\n\n    Note: warn_stream defaults to None → resolved to sys.stderr at call\n    time, not definition time, so test harness stderr redirection works.\n    \"\"\"\n    if warn_stream is None:\n        warn_stream = sys.stderr\n    for path in paths:\n        try:\n            with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n                for lineno, line in enumerate(f, start=1):\n                    line = line.strip()\n                    if not line:\n                        continue\n                    try:\n                        entry = json.loads(line)\n                    except json.JSONDecodeError as e:\n                        print(\n                            f\"[audit-query] WARN: {path}:{lineno}: \"\n                            f\"skipping malformed JSONL ({e.msg})\",\n                            file=warn_stream,\n                        )\n                        continue\n                    if not isinstance(entry, dict):\n                        continue\n                    yield entry\n        except OSError as e:\n            print(\n                f\"[audit-query] WARN: cannot read {path}: {e}\",\n                file=warn_stream,\n            )\n\n\n# ---------------------------------------------------------------------------\n# Sub-command implementations\n# ---------------------------------------------------------------------------\n\n\n\n# Query aggregations live outside this compatibility facade.  The named\n# delegates below intentionally remain: downstream consumers load this\n# hyphenated file by path and the read-API freeze guard inspects its AST.\nfrom _lib._audit_query import queries as _queries\nfrom _lib._audit_query import reporting as _reporting\nfrom _lib._audit_query import reporting_health as _reporting_health\nfrom _lib._audit_query import domain as _domain\nfrom _lib._audit_query import rendering as _rendering\nfrom _lib._audit_query import labeling as _labeling\nfrom _lib._audit_query import critical as _critical\nfrom _lib._audit_query import parsing as _parsing\n\n_EXTRACTED_MODULES = (\n    _domain, _rendering, _labeling, _critical, _parsing,\n)\n# Copy all declared values with one memo per facade. Mutable dictionaries and\n# sets belong to this import, not to the cached declaration templates; a\n# single deepcopy also preserves aliases across the exported declarations.\n_extracted_declarations = {}\nfor _section in _EXTRACTED_MODULES:\n    for _symbol in _section.__all__:\n        _extracted_declarations[_symbol] = getattr(_section, _symbol)\n    globals().setdefault(\"__annotations__\", {}).update(\n        dict(getattr(_section, \"__annotations__\", {}))\n    )\nglobals().update(deepcopy(_extracted_declarations))\ndel _extracted_declarations\n# Functions use this facade as their sole global namespace after rebinding.\n# A path constant is relative to the original CLI, not its extracted module.\n_LABEL_STORE_PATH = Path(__file__).resolve().parent / \"audit-log-labels.jsonl\"\n\n\ndef _bind_query_functions():\n    \"\"\"Re-home extracted functions in this module's historical globals.\n\n    Tests and downstream scripts load this hyphenated file by path and patch\n    its globals.  FunctionType keeps the implementation in a real module\n    while making those patches visible to the extracted code.\n    \"\"\"\n    bound = {}\n    for implementation in (_queries, _reporting, _reporting_health, *_EXTRACTED_MODULES):\n        for name, value in vars(implementation).items():\n            if not isinstance(value, FunctionType) or value.__module__ != implementation.__name__:\n                continue\n            clone = FunctionType(value.__code__, globals(), name, value.__defaults__, value.__closure__)\n            clone.__kwdefaults__ = value.__kwdefaults__\n            clone.__annotations__ = value.__annotations__\n            clone.__dict__.update(value.__dict__)\n            clone.__doc__ = value.__doc__\n            bound[name] = clone\n            globals()[name] = clone\n    return bound\n\n\n_query_impls = _bind_query_functions()\n\n\ndef _query_call(name, *args):\n    return _query_impls[name](*args)\n\n\ndef cmd_summary(entries, args): return _query_call(\"cmd_summary\", entries, args)\ndef cmd_by_skill(entries, args): return _query_call(\"cmd_by_skill\", entries, args)\ndef cmd_compliance(entries, args): return _query_call(\"cmd_compliance\", entries, args)\ndef cmd_by_day(entries, args): return _query_call(\"cmd_by_day\", entries, args)\ndef cmd_search(entries, args): return _query_call(\"cmd_search\", entries, args)\ndef cmd_since(entries, args): return _query_call(\"cmd_since\", entries, args)\ndef cmd_stats(entries, args): return _query_call(\"cmd_stats\", entries, args)\ndef cmd_errors(args): return _query_call(\"cmd_errors\", args)\ndef cmd_debate(entries, args): return _query_call(\"cmd_debate\", entries, args)\ndef cmd_plans(entries, args): return _query_call(\"cmd_plans\", entries, args)\ndef cmd_vetoes(entries, args): return _query_call(\"cmd_vetoes\", entries, args)\ndef _bench_cost_usd(r: Dict[str, Any]) -> float:\n    \"\"\"Per-run benchmark cost in USD. Prefers the int-encoded\n    ``cost_usd_cents`` (÷100); falls back to a legacy float ``cost_usd``.\n    Returns 0.0 when neither is present (pre-cost-instrumented runs).\"\"\"\n    cents = r.get(\"cost_usd_cents\")\n    if cents is not None:\n        try:\n            return int(cents) / 100.0\n        except (TypeError, ValueError):\n            return 0.0\n    try:\n        return float(r.get(\"cost_usd\") or 0.0)\n    except (TypeError, ValueError):\n        return 0.0\n\n\ndef _bench_duration_s(r: Dict[str, Any]) -> float:\n    \"\"\"Per-run wall-clock (the harbor 'compute' column) in seconds.\n    Prefers int-encoded ``duration_ms`` (÷1000); falls back to legacy\n    float ``duration_s``.\"\"\"\n    ms = r.get(\"duration_ms\")\n    if ms is not None:\n        try:\n            return int(ms) / 1000.0\n        except (TypeError, ValueError):\n            return 0.0\n    try:\n        return float(r.get(\"duration_s\") or 0.0)\n    except (TypeError, ValueError):\n        return 0.0\n\n\ndef _bench_turns(r: Dict[str, Any]) -> int:\n    \"\"\"Per-run scenario count (the harbor 'turns' column). Each scenario\n    is one model interaction unit; pass+fail covers every scored\n    scenario. Tolerates missing counts.\"\"\"\n    try:\n        return int(r.get(\"pass_count\") or 0) + int(r.get(\"fail_count\") or 0)\n    except (TypeError, ValueError):\n        return 0\n\n\ndef cmd_benchmarks(\n    entries: List[Dict[str, Any]], args\n) -> List[Dict[str, Any]]:\n    \"\"\"Aggregate benchmark_run rows by skill. Sprint 5 A.2; PLAN-133 C4.\n\n    Reports run count, latest pass_rate, median across runs, cumulative\n    lessons_written per skill.\n\n    PLAN-133 C4 (harbor-style row): co-reports **cost + compute + turns\n    alongside pass-rate** so a benchmark is never read as a bare scalar.\n    The added columns are strictly additive (existing keys unchanged) and\n    derive only from fields already on the ``benchmark_run`` event\n    (``cost_usd_cents``, ``duration_ms``, ``pass_count``/``fail_count``) —\n    no SPEC change is required, so this reader stays $0 and canonical-free.\n    \"\"\"\n    by_skill: Dict[str, List[Dict[str, Any]]] = defaultdict(list)\n    for e in entries:\n        if e.get(\"action\") != \"benchmark_run\":\n            continue\n        by_skill[e.get(\"skill\", \"?\")].append(e)\n    out = []\n    for skill in sorted(by_skill.keys()):\n        runs = sorted(by_skill[skill], key=lambda r: r.get(\"ts\") or \"\")\n        # Prefer new int-encoded fields (bps ÷ 1000 → float); fall back to\n        # the legacy float fields for logs written before the migration.\n        def _pass_rate(r: Dict[str, Any]) -> float:\n            bps = r.get(\"pass_rate_bps\")\n            if bps is not None:\n                return int(bps) / 1000.0\n            return float(r.get(\"pass_rate\") or 0.0)\n\n        def _floor_rate(r: Dict[str, Any]) -> float:\n            bps = r.get(\"floor_bps\")\n            if bps is not None:\n                return int(bps) / 1000.0\n            return float(r.get(\"floor\") or 0.0)\n\n        rates = [_pass_rate(r) for r in runs]\n        if rates:\n            med = _percentile(sorted(rates), 50)\n        else:\n            med = 0.0\n        latest = runs[-1]\n        # PLAN-133 C4 — harbor-style compute/cost/turns co-report.\n        # Cumulative across all runs for the skill + the latest single run,\n        # so an operator sees both the trend cost and the marginal cost.\n        total_cost = sum(_bench_cost_usd(r) for r in runs)\n        total_compute_s = sum(_bench_duration_s(r) for r in runs)\n        total_turns = sum(_bench_turns(r) for r in runs)\n        out.append(\n            {\n                \"skill\": skill,\n                \"runs\": len(runs),\n                \"latest_pass_rate\": round(_pass_rate(latest), 3),\n                \"median_pass_rate\": med,\n                \"last_floor\": _floor_rate(latest),\n                \"latest_ts\": latest.get(\"ts\"),\n                \"total_lessons_written\": sum(\n                    int(r.get(\"lessons_written\") or 0) for r in runs\n                ),\n                # --- PLAN-133 C4 harbor-style row (additive) ---\n                \"latest_cost_usd\": round(_bench_cost_usd(latest), 6),\n                \"total_cost_usd\": round(total_cost, 6),\n                \"latest_compute_s\": round(_bench_duration_s(latest), 3),\n                \"total_compute_s\": round(total_compute_s, 3),\n                \"latest_turns\": _bench_turns(latest),\n                \"total_turns\": total_turns,\n            }\n        )\n    return out\n\n\ndef cmd_lessons(entries, args): return _query_call(\"cmd_lessons\", entries, args)\ndef cmd_lessons_effectiveness(entries, args): return _query_call(\"cmd_lessons_effectiveness\", entries, args)\ndef cmd_spawn_stats(entries, args): return _query_call(\"cmd_spawn_stats\", entries, args)\ndef cmd_weekly_summary(entries, args): return _query_call(\"cmd_weekly_summary\", entries, args)\ndef cmd_architect_outcomes(entries, args): return _query_call(\"cmd_architect_outcomes\", entries, args)\ndef cmd_prune_restore_ratio(entries, args): return _query_call(\"cmd_prune_restore_ratio\", entries, args)\ndef cmd_claims(entries, args): return _query_call(\"cmd_claims\", entries, args)\ndef cmd_metrics(entries, args): return _query_call(\"cmd_metrics\", entries, args)\ndef cmd_tokens(entries, args): return _query_call(\"cmd_tokens\", entries, args)\ndef cmd_health(entries, args): return _query_call(\"cmd_health\", entries, args)\ndef cmd_export(entries, args): return _query_call(\"cmd_export\", entries, args)\n\n\nfor _query_name in (\n    \"cmd_summary\", \"cmd_by_skill\", \"cmd_compliance\", \"cmd_by_day\", \"cmd_search\",\n    \"cmd_since\", \"cmd_stats\", \"cmd_errors\", \"cmd_export\", \"cmd_debate\",\n    \"cmd_plans\", \"cmd_vetoes\", \"cmd_lessons\", \"cmd_lessons_effectiveness\",\n    \"cmd_spawn_stats\", \"cmd_weekly_summary\", \"cmd_architect_outcomes\",\n    \"cmd_prune_restore_ratio\", \"cmd_claims\", \"cmd_metrics\", \"cmd_health\",\n    \"cmd_tokens\",\n):\n    _query_wrapper = globals()[_query_name]\n    _query_impl = _query_impls[_query_name]\n    _query_wrapper.__doc__ = _query_impl.__doc__\n    _query_wrapper.__annotations__ = _query_impl.__annotations__\n    _query_wrapper.__wrapped__ = _query_impl\n\n# ---------------------------------------------------------------------------\n# PLAN-080 Phase 1 — by-domain sub-command\n# ---------------------------------------------------------------------------\n\n# Default window for by-domain (calendar days, trailing from UTC midnight)\n\n\n# Remaining domain implementations are rebound above the CLI entrypoint.\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"CLI entrypoint — dispatch audit-query sub-commands.\"\"\"\n    parser = build_parser()\n    args = parser.parse_args(argv)\n\n    # `errors` subcommand reads a different file, doesn't need the jsonl\n    if args.cmd == \"errors\":\n        result = cmd_errors(args)\n        print(render(result, as_json=args.as_json, as_csv=args.as_csv))\n        return 0\n\n    log_path = Path(args.log) if args.log else default_log_path()\n    log_files = discover_logs(log_path, args.include_rotated)\n\n    # Perf-P1-002 — streamable subcommands consume the iterator directly so\n    # a 100k-row log does not sit in RAM as a Python list.  Non-streamable\n    # subcommands (median / percentile / cross-reference) still materialize\n    # but emit a stderr hint when the log crosses the warn threshold.\n    _STREAMABLE_CMDS = frozenset({\n        \"summary\", \"by-skill\", \"by-day\", \"search\", \"since\",\n    })\n\n    if not log_files:\n        entries_iter: Iterable[Dict[str, Any]] = iter(())\n        entries: List[Dict[str, Any]] = []\n    elif args.cmd in _STREAMABLE_CMDS:\n        entries_iter = read_entries(log_files)\n        entries = []  # sentinel — not used on streaming path\n    else:\n        entries = list(read_entries(log_files))\n        entries_iter = entries\n        if len(entries) >= _MATERIALIZATION_WARN_THRESHOLD:\n            print(\n                \"[audit-query] NOTE: loaded {n} entries into RAM for \"\n                \"subcommand {cmd!r} (threshold {thr}). Consider rotating \"\n                \"older logs or running a streamable subcommand.\".format(\n                    n=len(entries),\n                    cmd=args.cmd,\n                    thr=_MATERIALIZATION_WARN_THRESHOLD,\n                ),\n                file=sys.stderr,\n            )\n\n    if args.cmd == \"summary\":\n        result = cmd_summary(entries_iter, args)\n    elif args.cmd == \"by-skill\":\n        result = cmd_by_skill(entries_iter, args)\n    elif args.cmd == \"compliance\":\n        result = cmd_compliance(entries, args)\n    elif args.cmd == \"by-day\":\n        result = cmd_by_day(entries_iter, args)\n    elif args.cmd == \"search\":\n        result = cmd_search(entries_iter, args)\n    elif args.cmd == \"since\":\n        result = cmd_since(entries_iter, args)\n    elif args.cmd == \"stats\":\n        result = cmd_stats(entries, args)\n    elif args.cmd == \"export\":\n        result = cmd_export(entries, args)\n        # Export handles its own formatting\n        if args.export_format in (\"csv\", \"tsv\"):\n            sys.stdout.write(result)\n            return 0\n        print(json.dumps(result, indent=2, ensure_ascii=True))\n        return 0\n    # Sprint 5 A.2 — 7 new sub-commands\n    elif args.cmd == \"debate\":\n        result = cmd_debate(entries, args)\n    elif args.cmd == \"plans\":\n        result = cmd_plans(entries, args)\n    elif args.cmd == \"vetoes\":\n        result = cmd_vetoes(entries, args)\n    elif args.cmd == \"benchmarks\":\n        result = cmd_benchmarks(entries, args)\n    elif args.cmd == \"lessons\":\n        result = cmd_lessons(entries, args)\n    elif args.cmd == \"metrics\":\n        result = cmd_metrics(entries, args)\n    elif args.cmd == \"health\":\n        result = cmd_health(entries, args)\n    elif args.cmd == \"tokens\":\n        result = cmd_tokens(entries, args)\n    elif args.cmd == \"claims\":\n        result = cmd_claims(entries, args)\n    elif args.cmd == \"prune-restore-ratio\":\n        result = cmd_prune_restore_ratio(entries, args)\n    elif args.cmd == \"architect-outcomes\":\n        result = cmd_architect_outcomes(entries, args)\n    elif args.cmd == \"lessons-effectiveness\":\n        result = cmd_lessons_effectiveness(entries, args)\n    elif args.cmd == \"weekly-summary\":\n        result = cmd_weekly_summary(entries, args)\n    elif args.cmd == \"spawn-stats\":\n        result = cmd_spawn_stats(entries, args)\n    # PLAN-080 Phase 1\n    elif args.cmd == \"by-domain\":\n        result = cmd_by_domain(entries, args)\n    # PLAN-081 Phase 6-bis\n    elif args.cmd == \"label\":\n        result = cmd_label(entries, args)\n    elif args.cmd == \"fp-rate\":\n        result = cmd_fp_rate(entries, args)\n    elif args.cmd == \"case-summary\":\n        result = cmd_case_summary(entries, args)\n    elif args.cmd == \"codex-writeguard-summary\":\n        result = cmd_codex_writeguard_summary(entries, args)\n    # PLAN-113 Phase B Wave W1 — critical-security-action reader\n    elif args.cmd == \"critical\":\n        result = cmd_critical(entries, args)\n    else:  # pragma: no cover — argparse prevents this\n        parser.error(f\"unknown cmd: {args.cmd}\")\n\n    print(render(result, as_json=args.as_json, as_csv=args.as_csv))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":513,"startLine":1,"totalLines":513}},"tool_result_meta":[{"id":"toolu_017gtzmsMW9m2LwjT27VERj6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
