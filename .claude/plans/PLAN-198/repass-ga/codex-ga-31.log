+            for key in ("CLAUDE_SESSION_ID",
                         "CEO_LEARNING_OBSERVE", "CEO_TOOL_LIFECYCLE", "CEO_SOTA_DISABLE",
@@ -48,4 +91,2 @@ def main() -> None:
