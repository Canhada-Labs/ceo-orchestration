def _m1_hit(rel, body):
    """M1 comportamental com as 3 excecoes documentadas acima."""
    if rel in M1_SANCTIONED:
        return False
    kept = []
    for ln in body.splitlines():
        if M1_ALLOW_MARK in ln:
            continue
        if any(c in ln for c in M1_SKILL_CTX):
            continue
