+            start -= 1  # the ASCII head (a _SAFE_CUT head is in the match)
+        head = text[start]
+        image = image_of(text[start:end])
+        if (start < m.start("tail") and len(unicodedata.normalize("NFKD", head)) == 1
+                and image.startswith(image_of(head))):
