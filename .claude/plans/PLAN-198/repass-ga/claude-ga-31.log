{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y9TPcSMrGYrb6hRFnGKpfi","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Print an isolated subprocess profile, including audit drains at exit.\n3\t\n4\tDiagnostic only: this never replaces the independent N=200 latency gate.\n5\tUses the gate's exact paired lifecycle payloads, with observe off and on.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport atexit\n10\timport cProfile\n11\timport importlib.util\n12\timport os\n13\tfrom pathlib import Path\n14\timport pstats\n15\timport runpy\n16\timport subprocess\n17\timport sys\n18\timport time\n19\timport shutil\n20\timport tempfile\n21\t\n22\t\n23\t# Location carriers from _lib.test_isolation.  This runtime script cannot\n24\t# import that pytest-only module, so keep the production copy explicit and\n25\t# pin parity in test_diagnose_output_hook.py.  HOME is included because it is\n26\t# the resolver fallback; CLAUDE_PROJECT_DIR_NATIVE wins every other carrier.\n27\t_CHILD_LOCATION_CARRIERS = (\n28\t    \"HOME\", \"CEO_AUDIT_LOG_DIR\", \"CEO_PROJECT_STATE_DIR\",\n29\t    \"CEO_AUDIT_LOG_PATH\", \"CEO_AUDIT_LOG_ERR\", \"CEO_AUDIT_LOG_LOCK\",\n30\t    \"CEO_AUDIT_KEY_PATH\", \"CEO_AUDIT_LAST_HMAC_PATH\",\n31\t    \"CEO_AUDIT_CHAIN_LENGTH_PATH\", \"CEO_AUDIT_LOG_FALLBACK_PATH\",\n32\t    \"CEO_AUDIT_LOG_ROTATE_BYTES\", \"CEO_AUDIT_HMAC_DISABLE\",\n33\t    \"CLAUDE_PROJECT_DIR_NATIVE\",\n34\t)\n35\t\n36\t\n37\tdef _isolated_child_env(base: dict, tmp: str, root: Path) -> dict:\n38\t    \"\"\"Build a child environment whose audit family lives below ``tmp``.\"\"\"\n39\t    env = dict(base)\n40\t    for key in _CHILD_LOCATION_CARRIERS:\n41\t        env.pop(key, None)\n42\t    env.update(\n43\t        HOME=tmp,\n44\t        CEO_AUDIT_LOG_DIR=str(Path(tmp) / \"audit\"),\n45\t        CEO_PROJECT_STATE_DIR=str(Path(tmp) / \"state\"),\n46\t        CLAUDE_PROJECT_DIR=str(root),\n47\t    )\n48\t    return env\n49\t\n50\t\n51\tdef _iterations(argv: list) -> int:\n52\t    \"\"\"Read the optional diagnostic sample count without changing its default.\"\"\"\n53\t    if not argv:\n54\t        return 201\n55\t    if len(argv) == 2 and argv[0] == \"--iterations\":\n56\t        try:\n57\t            count = int(argv[1])\n58\t        except ValueError:\n59\t            count = 0\n60\t        if count > 0:\n61\t            return count\n62\t    raise SystemExit(\"usage: diagnose-output-hook.py [--iterations POSITIVE]\")\n63\t\n64\t\n65\tdef main() -> None:\n66\t    root = Path(__file__).resolve().parents[2]\n67\t    hook = root / \".claude/hooks/check_output_secrets.py\"\n68\t    if len(sys.argv) == 3 and sys.argv[1] == \"--child\":\n69\t        profile = cProfile.Profile()\n70\t        # Registered first => saved after the hook's own exit handlers.\n71\t        def save() -> None:\n72\t            profile.disable()\n73\t            profile.dump_stats(sys.argv[2])\n74\t        atexit.register(save)\n75\t        profile.enable()\n76\t        runpy.run_path(str(hook), run_name=\"__main__\")\n77\t        return\n78\t\n79\t    spec = importlib.util.spec_from_file_location(\n80\t        \"latency_gate\", root / \".claude/scripts/profile-opus-4-7.py\"\n81\t    )\n82\t    gate = importlib.util.module_from_spec(spec)\n83\t    spec.loader.exec_module(gate)\n84\t    iterations = _iterations(sys.argv[1:])\n85\t    for observe in (\"\", \"1\"):\n86\t        with tempfile.TemporaryDirectory(prefix=\"ceo-profile-diagnostic-\") as tmp:\n87\t            env = _isolated_child_env(os.environ, tmp, root)\n88\t            for key in (\"CLAUDE_SESSION_ID\",\n89\t                        \"CEO_LEARNING_OBSERVE\", \"CEO_TOOL_LIFECYCLE\", \"CEO_SOTA_DISABLE\",\n90\t                        \"CEO_ANTI_OVERHEAD\"):\n91\t                env.pop(key, None)\n92\t            for key in (\"CEO_MODEL_ROUTING\", \"CEO_PROMOTION_HEURISTIC\",\n93\t                        \"CEO_COOKBOOK_ADVISOR_ENABLED\", \"CEO_SPEC_CTX_SANITIZER_ENABLED\",\n94\t                        \"CEO_SPAWN_CONFIDENCE_ENABLED\"):\n95\t                env[key] = \"0\"\n96\t            if observe:\n97\t                env[\"CEO_LEARNING_OBSERVE\"] = observe\n98\t            stats_path = str(Path(tmp) / \"hook.prof\")\n99\t            samples = []\n100\t            worst_ms = -1.0\n101\t            worst_path = str(Path(tmp) / \"worst.prof\")\n102\t            for i in range(iterations):\n103\t                tool_id = \"diagnostic-%d\" % i\n104\t                subprocess.run(\n105\t                    [sys.executable, str(hook.with_name(\"check_anti_ceo_overhead.py\"))],\n106\t                    input=gate._latency_pre_payload(tool_id), env=env,\n107\t                    cwd=root, capture_output=True, timeout=10, check=True,\n108\t                )\n109\t                started = time.perf_counter()\n110\t                subprocess.run(\n111\t                    [sys.executable, str(Path(__file__).resolve()), \"--child\", stats_path],\n112\t                    input=gate._latency_post_payload(tool_id), env=env,\n113\t                    cwd=root, capture_output=True, timeout=10, check=True,\n114\t                )\n115\t                elapsed_ms = (time.perf_counter() - started) * 1000\n116\t                stats = pstats.Stats(stats_path)\n117\t                fsync_ms = sum(v[2] for k, v in stats.stats.items() if \"posix.fsync\" in k[2]) * 1000\n118\t                samples.append((elapsed_ms, fsync_ms))\n119\t                if elapsed_ms > worst_ms:\n120\t                    worst_ms = elapsed_ms\n121\t                    shutil.copyfile(stats_path, worst_path)\n122\t            print(\"DIAGNOSTIC wall/fsync ms (1 cold then %d warm):\" % (iterations - 1), samples)\n123\t            print(\"OUTPUT HOOK DIAGNOSTIC observe=%s (separate from gate)\" % (observe or \"unset\"))\n124\t            pstats.Stats(worst_path).strip_dirs().sort_stats(\"cumulative\").print_stats(25)\n125\t            pstats.Stats(worst_path).strip_dirs().sort_stats(\"tottime\").print_stats(15)\n126\t\n127\t\n128\tif __name__ == \"__main__\":\n129\t    main()\n130\t"}]},"parent_tool_use_id":null,"session_id":"9cf3be2a-1cec-4f25-9988-6f9e6658e555","uuid":"a9cd9e5f-686a-4759-9607-e81495de8cc5","timestamp":"2026-11-16T20:05:30.851Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/diagnose-output-hook.py","content":"#!/usr/bin/env python3\n\"\"\"Print an isolated subprocess profile, including audit drains at exit.\n\nDiagnostic only: this never replaces the independent N=200 latency gate.\nUses the gate's exact paired lifecycle payloads, with observe off and on.\n\"\"\"\nfrom __future__ import annotations\n\nimport atexit\nimport cProfile\nimport importlib.util\nimport os\nfrom pathlib import Path\nimport pstats\nimport runpy\nimport subprocess\nimport sys\nimport time\nimport shutil\nimport tempfile\n\n\n# Location carriers from _lib.test_isolation.  This runtime script cannot\n# import that pytest-only module, so keep the production copy explicit and\n# pin parity in test_diagnose_output_hook.py.  HOME is included because it is\n# the resolver fallback; CLAUDE_PROJECT_DIR_NATIVE wins every other carrier.\n_CHILD_LOCATION_CARRIERS = (\n    \"HOME\", \"CEO_AUDIT_LOG_DIR\", \"CEO_PROJECT_STATE_DIR\",\n    \"CEO_AUDIT_LOG_PATH\", \"CEO_AUDIT_LOG_ERR\", \"CEO_AUDIT_LOG_LOCK\",\n    \"CEO_AUDIT_KEY_PATH\", \"CEO_AUDIT_LAST_HMAC_PATH\",\n    \"CEO_AUDIT_CHAIN_LENGTH_PATH\", \"CEO_AUDIT_LOG_FALLBACK_PATH\",\n    \"CEO_AUDIT_LOG_ROTATE_BYTES\", \"CEO_AUDIT_HMAC_DISABLE\",\n    \"CLAUDE_PROJECT_DIR_NATIVE\",\n)\n\n\ndef _isolated_child_env(base: dict, tmp: str, root: Path) -> dict:\n    \"\"\"Build a child environment whose audit family lives below ``tmp``.\"\"\"\n    env = dict(base)\n    for key in _CHILD_LOCATION_CARRIERS:\n        env.pop(key, None)\n    env.update(\n        HOME=tmp,\n        CEO_AUDIT_LOG_DIR=str(Path(tmp) / \"audit\"),\n        CEO_PROJECT_STATE_DIR=str(Path(tmp) / \"state\"),\n        CLAUDE_PROJECT_DIR=str(root),\n    )\n    return env\n\n\ndef _iterations(argv: list) -> int:\n    \"\"\"Read the optional diagnostic sample count without changing its default.\"\"\"\n    if not argv:\n        return 201\n    if len(argv) == 2 and argv[0] == \"--iterations\":\n        try:\n            count = int(argv[1])\n        except ValueError:\n            count = 0\n        if count > 0:\n            return count\n    raise SystemExit(\"usage: diagnose-output-hook.py [--iterations POSITIVE]\")\n\n\ndef main() -> None:\n    root = Path(__file__).resolve().parents[2]\n    hook = root / \".claude/hooks/check_output_secrets.py\"\n    if len(sys.argv) == 3 and sys.argv[1] == \"--child\":\n        profile = cProfile.Profile()\n        # Registered first => saved after the hook's own exit handlers.\n        def save() -> None:\n            profile.disable()\n            profile.dump_stats(sys.argv[2])\n        atexit.register(save)\n        profile.enable()\n        runpy.run_path(str(hook), run_name=\"__main__\")\n        return\n\n    spec = importlib.util.spec_from_file_location(\n        \"latency_gate\", root / \".claude/scripts/profile-opus-4-7.py\"\n    )\n    gate = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(gate)\n    iterations = _iterations(sys.argv[1:])\n    for observe in (\"\", \"1\"):\n        with tempfile.TemporaryDirectory(prefix=\"ceo-profile-diagnostic-\") as tmp:\n            env = _isolated_child_env(os.environ, tmp, root)\n            for key in (\"CLAUDE_SESSION_ID\",\n                        \"CEO_LEARNING_OBSERVE\", \"CEO_TOOL_LIFECYCLE\", \"CEO_SOTA_DISABLE\",\n                        \"CEO_ANTI_OVERHEAD\"):\n                env.pop(key, None)\n            for key in (\"CEO_MODEL_ROUTING\", \"CEO_PROMOTION_HEURISTIC\",\n                        \"CEO_COOKBOOK_ADVISOR_ENABLED\", \"CEO_SPEC_CTX_SANITIZER_ENABLED\",\n                        \"CEO_SPAWN_CONFIDENCE_ENABLED\"):\n                env[key] = \"0\"\n            if observe:\n                env[\"CEO_LEARNING_OBSERVE\"] = observe\n            stats_path = str(Path(tmp) / \"hook.prof\")\n            samples = []\n            worst_ms = -1.0\n            worst_path = str(Path(tmp) / \"worst.prof\")\n            for i in range(iterations):\n                tool_id = \"diagnostic-%d\" % i\n                subprocess.run(\n                    [sys.executable, str(hook.with_name(\"check_anti_ceo_overhead.py\"))],\n                    input=gate._latency_pre_payload(tool_id), env=env,\n                    cwd=root, capture_output=True, timeout=10, check=True,\n                )\n                started = time.perf_counter()\n                subprocess.run(\n                    [sys.executable, str(Path(__file__).resolve()), \"--child\", stats_path],\n                    input=gate._latency_post_payload(tool_id), env=env,\n                    cwd=root, capture_output=True, timeout=10, check=True,\n                )\n                elapsed_ms = (time.perf_counter() - started) * 1000\n                stats = pstats.Stats(stats_path)\n                fsync_ms = sum(v[2] for k, v in stats.stats.items() if \"posix.fsync\" in k[2]) * 1000\n                samples.append((elapsed_ms, fsync_ms))\n                if elapsed_ms > worst_ms:\n                    worst_ms = elapsed_ms\n                    shutil.copyfile(stats_path, worst_path)\n            print(\"DIAGNOSTIC wall/fsync ms (1 cold then %d warm):\" % (iterations - 1), samples)\n            print(\"OUTPUT HOOK DIAGNOSTIC observe=%s (separate from gate)\" % (observe or \"unset\"))\n            pstats.Stats(worst_path).strip_dirs().sort_stats(\"cumulative\").print_stats(25)\n            pstats.Stats(worst_path).strip_dirs().sort_stats(\"tottime\").print_stats(15)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":130,"startLine":1,"totalLines":130}},"tool_result_meta":[{"id":"toolu_01Y9TPcSMrGYrb6hRFnGKpfi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
