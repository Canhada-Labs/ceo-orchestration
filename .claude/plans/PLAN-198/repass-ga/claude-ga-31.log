{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7Cxkih7n6ALMXPRig4G","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012JmgxfeTMaCHRLk56gB79Q","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_context_budget_parts/__init__.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":8520,"cache_read_input_tokens":81585,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":8520},"output_tokens":6,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"9cf3be2a-1cec-4f25-9988-6f9e6658e555","uuid":"6ea1a994-d56a-49f3-a50f-eb637460d68a","timestamp":"2026-11-16T20:04:50.316Z","request_id":"req_011Ch7CxkSpeRLNo1ZNvi3am","wire_tool_inputs":{"toolu_012JmgxfeTMaCHRLk56gB79Q":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_context_budget_parts/__init__.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012JmgxfeTMaCHRLk56gB79Q","type":"tool_result","content":"1\t\"\"\"Implementation sections for the context-budget CLI compatibility facade.\n2\t\n3\tFunctions execute against the facade globals, preserving patched dependencies.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\tfrom copy import deepcopy\n9\tfrom importlib import import_module\n10\tfrom types import FunctionType\n11\tfrom typing import Any, Dict, Tuple\n12\t\n13\t\n14\tdef _bind(function: FunctionType, namespace: Dict[str, Any]) -> FunctionType:\n15\t    bound = FunctionType(\n16\t        function.__code__, namespace, function.__name__,\n17\t        function.__defaults__, function.__closure__,\n18\t    )\n19\t    bound.__kwdefaults__ = function.__kwdefaults__\n20\t    bound.__annotations__ = dict(function.__annotations__)\n21\t    bound.__dict__.update(function.__dict__)\n22\t    bound.__qualname__ = function.__qualname__\n23\t    bound.__module__ = namespace[\"__name__\"]\n24\t    return bound\n25\t\n26\t\n27\tdef install(namespace: Dict[str, Any], modules: Tuple[str, ...]) -> None:\n28\t    \"\"\"Re-export all declarations, including private names, in the facade.\"\"\"\n29\t    declarations: Dict[str, Any] = {}\n30\t    for name in modules:\n31\t        module = import_module(\"{}.{}\".format(__name__, name))\n32\t        declarations.update({key: getattr(module, key) for key in module.__all__})\n33\t        namespace.setdefault(\"__annotations__\", {}).update(\n34\t            getattr(module, \"__annotations__\", {})\n35\t        )\n36\t    namespace.update(deepcopy(declarations))\n37\t    for name, original in declarations.items():\n38\t        if isinstance(original, FunctionType):\n39\t            namespace[name] = _bind(original, namespace)\n40\t        elif isinstance(original, type) and original.__module__.startswith(__name__):\n41\t            # Never change an imported template class: independent facade\n42\t            # imports (including test import-by-path) need independent methods.\n43\t            attributes = {\n44\t                key: value for key, value in vars(original).items()\n45\t                if key not in (\"__dict__\", \"__weakref__\")\n46\t            }\n47\t            bound_class = type(original.__name__, original.__bases__, attributes)\n48\t            for method_name, method in vars(bound_class).items():\n49\t                if isinstance(method, FunctionType):\n50\t                    setattr(bound_class, method_name, _bind(method, namespace))\n51\t            bound_class.__module__ = namespace[\"__name__\"]\n52\t            namespace[name] = bound_class\n53\t"}]},"parent_tool_use_id":null,"session_id":"9cf3be2a-1cec-4f25-9988-6f9e6658e555","uuid":"556ceccb-6992-4e9f-b6a7-a2edc4f5d908","timestamp":"2026-11-16T20:04:50.335Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_context_budget_parts/__init__.py","content":"\"\"\"Implementation sections for the context-budget CLI compatibility facade.\n\nFunctions execute against the facade globals, preserving patched dependencies.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom copy import deepcopy\nfrom importlib import import_module\nfrom types import FunctionType\nfrom typing import Any, Dict, Tuple\n\n\ndef _bind(function: FunctionType, namespace: Dict[str, Any]) -> FunctionType:\n    bound = FunctionType(\n        function.__code__, namespace, function.__name__,\n        function.__defaults__, function.__closure__,\n    )\n    bound.__kwdefaults__ = function.__kwdefaults__\n    bound.__annotations__ = dict(function.__annotations__)\n    bound.__dict__.update(function.__dict__)\n    bound.__qualname__ = function.__qualname__\n    bound.__module__ = namespace[\"__name__\"]\n    return bound\n\n\ndef install(namespace: Dict[str, Any], modules: Tuple[str, ...]) -> None:\n    \"\"\"Re-export all declarations, including private names, in the facade.\"\"\"\n    declarations: Dict[str, Any] = {}\n    for name in modules:\n        module = import_module(\"{}.{}\".format(__name__, name))\n        declarations.update({key: getattr(module, key) for key in module.__all__})\n        namespace.setdefault(\"__annotations__\", {}).update(\n            getattr(module, \"__annotations__\", {})\n        )\n    namespace.update(deepcopy(declarations))\n    for name, original in declarations.items():\n        if isinstance(original, FunctionType):\n            namespace[name] = _bind(original, namespace)\n        elif isinstance(original, type) and original.__module__.startswith(__name__):\n            # Never change an imported template class: independent facade\n            # imports (including test import-by-path) need independent methods.\n            attributes = {\n                key: value for key, value in vars(original).items()\n                if key not in (\"__dict__\", \"__weakref__\")\n            }\n            bound_class = type(original.__name__, original.__bases__, attributes)\n            for method_name, method in vars(bound_class).items():\n                if isinstance(method, FunctionType):\n                    setattr(bound_class, method_name, _bind(method, namespace))\n            bound_class.__module__ = namespace[\"__name__\"]\n            namespace[name] = bound_class\n","numLines":53,"startLine":1,"totalLines":53}},"tool_result_meta":[{"id":"toolu_012JmgxfeTMaCHRLk56gB79Q","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
