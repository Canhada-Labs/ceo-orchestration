{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EKQBddbCa1DkoquyJosEQ6","type":"tool_result","content":"1\t\"\"\"inventory context-budget declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport json\n7\timport os\n8\timport re\n9\timport sys\n10\tfrom pathlib import Path\n11\tfrom typing import Any, Dict, List, Optional, Tuple\n12\t\n13\t# Static note initialization only; bound functions use the facade value.\n14\tCHARS_PER_TOKEN = 4\n15\tREDACTED = \"[REDACTED-INJECTION-PATTERN]\"\n16\t\n17\t__all__ = ('_scan_matched', 'fence_token', 'POINTER_OVERHEAD_TOKENS', 'DESIGNATED_PILOTS', 'HONESTY_NOTES', 'estimate_tokens', '_read_text', '_line_count', '_BLOCK_SCALAR_INDICATORS', '_key_indent', 'parse_frontmatter', '_file_entry', 'discover_mcp_servers', '_collect_files', '_flag_file', 'compute_savings', '_savings_entry', 'build_inventory')\n18\t\n19\tdef _scan_matched(s: str) -> Optional[bool]:\n20\t    \"\"\"Run the injection scan. True=hit, False=clean, None=scanner down.\"\"\"\n21\t    if _injection_patterns is None:\n22\t        return None\n23\t    try:\n24\t        scan_fn = getattr(_injection_patterns, \"scan_harness_mimicry\", None)\n25\t        if not callable(scan_fn):\n26\t            return None\n27\t        result = scan_fn(s)\n28\t        matched = getattr(result, \"matched\", None)\n29\t        if matched is None:\n30\t            matched = bool(result)\n31\t        return bool(matched)\n32\t    except Exception:  # noqa: BLE001\n33\t        return None\n34\t\n35\t\n36\tdef fence_token(s: Any, *, max_len: int = 80) -> str:\n37\t    \"\"\"Fence an identifier-like field (MCP server name) for display.\n38\t\n39\t    Scanner first (hit => REDACTED), then a strictly-destructive charset\n40\t    allowlist — safe to use even when the scanner is unavailable.\n41\t    \"\"\"\n42\t    if not isinstance(s, str):\n43\t        s = str(s)\n44\t    s = s.replace(\"\\x00\", \"\")[:max_len]\n45\t    if _scan_matched(s) is True:\n46\t        return REDACTED\n47\t    s = _TOKEN_ALLOWED.sub(\"\", s)\n48\t    return s or \"(empty)\"\n49\t\n50\t\n51\t# ---------------------------------------------------------------------------\n52\t# PLAN-153 Wave C item 5 — progressive-disclosure savings\n53\t# ---------------------------------------------------------------------------\n54\t\n55\t# Loader-pointer stub assumed to remain in a split SKILL.md (est. tokens).\n56\tPOINTER_OVERHEAD_TOKENS = 150\n57\t\n58\t# PLAN-153 Wave C item 1 designated progressive-disclosure pilots\n59\t# (testing-strategy 1026L, security-and-auth 868L at designation time).\n60\t# Surfaced FIRST in savings_top3 when — and only when — the scan finds them\n61\t# still un-split; designation is a plan decision, not a size ranking, and\n62\t# the entry's `reason` says so.\n63\tDESIGNATED_PILOTS = (\n64\t    \".claude/skills/core/testing-strategy/SKILL.md\",\n65\t    \".claude/skills/core/security-and-auth/SKILL.md\",\n66\t)\n67\t\n68\t# Honesty block rendered in BOTH outputs (markdown + --json).\n69\tHONESTY_NOTES = (\n70\t    \"Token figures are chars/{} — a heuristic ESTIMATE, not a tokenizer \"\n71\t    \"(expect +/-20-30% vs real BPE counts).\".format(CHARS_PER_TOKEN),\n72\t    \"STATIC audit only: measures what a file costs WHEN loaded, not runtime \"\n73\t    \"usage or value. Retire/merge/improve judgement belongs to /skill-health \"\n74\t    \"telemetry; neither tool can measure greenfield domains (PLAN-153 \"\n75\t    \"debate A must-fix 4).\",\n76\t    \"All scanned file content is rendered as UNTRUSTED DATA, never as \"\n77\t    \"instructions. Re-displayed free text (MCP server names) is \"\n78\t    \"injection-scanned; hits render as {}.\".format(REDACTED),\n79\t    \"savings_top3 assumes the Wave C progressive-disclosure mechanism: \"\n80\t    \"extract references/*.md + keep a ~{}-token loader pointer in SKILL.md \"\n81\t    \"(100% content preserved; saving is activation-time only).\".format(\n82\t        POINTER_OVERHEAD_TOKENS),\n83\t)\n84\t\n85\t\n86\t# ---------------------------------------------------------------------------\n87\t# Primitives\n88\t# ---------------------------------------------------------------------------\n89\t\n90\t\n91\tdef estimate_tokens(char_count: int) -> int:\n92\t    \"\"\"chars/4 token estimate (repo-canonical heuristic; estimate only).\"\"\"\n93\t    if char_count <= 0:\n94\t        return 0\n95\t    return char_count // CHARS_PER_TOKEN\n96\t\n97\t\n98\tdef _read_text(path: Path) -> Optional[str]:\n99\t    \"\"\"Read a file as UTF-8; return None on any OS/decoding error.\n100\t\n101\t    Resilient by design — a missing or unreadable file MUST NOT crash an\n102\t    advisory scan (fail-open, §5 doctrine).\n103\t    \"\"\"\n104\t    try:\n105\t        return path.read_text(encoding=\"utf-8\")\n106\t    except (OSError, UnicodeDecodeError):\n107\t        return None\n108\t\n109\t\n110\tdef _line_count(text: str) -> int:\n111\t    if not text:\n112\t        return 0\n113\t    # Count lines without a spurious trailing-empty when file ends in \\n.\n114\t    n = text.count(\"\\n\")\n115\t    if text and not text.endswith(\"\\n\"):\n116\t        n += 1\n117\t    return n\n118\t\n119\t\n120\t# YAML block-scalar indicators that introduce a multi-line value on the\n121\t# following more-indented continuation lines (`description: >` etc.). An empty\n122\t# value after the colon is also treated as a possible block start so a plain\n123\t# `description:`\\n  text continuation is captured too.\n124\t_BLOCK_SCALAR_INDICATORS = frozenset({\">\", \"|\", \">-\", \"|-\", \">+\", \"|+\"})\n125\t\n126\t\n127\tdef _key_indent(raw_line: str) -> int:\n128\t    \"\"\"Leading-space indent width of a raw (un-stripped) frontmatter line.\"\"\"\n129\t    return len(raw_line) - len(raw_line.lstrip(\" \"))\n130\t\n131\t\n132\tdef parse_frontmatter(text: str) -> Dict[str, str]:\n133\t    \"\"\"Parse a leading ``---`` YAML-ish frontmatter block into a flat dict.\n134\t\n135\t    Best-effort line-based parse (no YAML dep): ``key: value`` only, first\n136\t    colon wins, ``#`` comment lines skipped. Mirrors check-staleness.py.\n137\t\n138\t    YAML folded/block scalars are handled: when a ``key:`` line has an empty\n139\t    value OR a block indicator (``>``, ``|``, ``>-``, ``|-``, ``>+``, ``|+``),\n140\t    the subsequent MORE-INDENTED continuation lines are consumed and\n141\t    space-joined as the value. This is what lets ``bloated_description`` fire\n142\t    on the ~49 real SKILL.md files that write ``description: >`` with the body\n143\t    on following indented lines (otherwise the value reads as ``>``, len 1).\n144\t    \"\"\"\n145\t    if not text:\n146\t        return {}\n147\t    m = _FRONTMATTER_RE.match(text)\n148\t    if not m:\n149\t        return {}\n150\t    result: Dict[str, str] = {}\n151\t    raw_lines = m.group(1).splitlines()\n152\t    i = 0\n153\t    n = len(raw_lines)\n154\t    while i < n:\n155\t        raw = raw_lines[i]\n156\t        s = raw.strip()\n157\t        if not s or s.startswith(\"#\"):\n158\t            i += 1\n159\t            continue\n160\t        if \":\" not in s:\n161\t            i += 1\n162\t            continue\n163\t        k, _, v = s.partition(\":\")\n164\t        key = k.strip()\n165\t        value = v.strip()\n166\t        key_indent = _key_indent(raw)\n167\t        i += 1\n168\t        if value == \"\" or value in _BLOCK_SCALAR_INDICATORS:\n169\t            # Consume the following MORE-INDENTED (non-blank, non-comment)\n170\t            # continuation lines as the block/folded scalar body.\n171\t            parts: List[str] = []\n172\t            while i < n:\n173\t                cont_raw = raw_lines[i]\n174\t                cont_stripped = cont_raw.strip()\n175\t                if cont_stripped == \"\":\n176\t                    # Blank line: part of a block scalar — keep scanning, but\n177\t                    # contributes no token to a space-joined value.\n178\t                    i += 1\n179\t                    continue\n180\t                if _key_indent(cont_raw) <= key_indent:\n181\t                    break  # dedent back to (or above) the key → block ended\n182\t                parts.append(cont_stripped)\n183\t                i += 1\n184\t            joined = \" \".join(parts).strip()\n185\t            # If the scalar had an explicit indicator but no body, fall back to\n186\t            # the indicator text only if nothing was captured (len stays small).\n187\t            if joined:\n188\t                value = joined\n189\t        result[key] = value\n190\t    return result\n191\t\n192\t\n193\tdef _file_entry(path: Path, repo: Path, category: str) -> Optional[Dict[str, Any]]:\n194\t    \"\"\"Build a per-file inventory entry, or None if unreadable.\n195\t\n196\t    Carries the line count, byte/char size, token estimate, and (when a\n197\t    frontmatter ``description:`` exists) its length for bloat-flagging.\n198\t    \"\"\"\n199\t    text = _read_text(path)\n200\t    if text is None:\n201\t        return None\n202\t    chars = len(text)\n203\t    lines = _line_count(text)\n204\t    fm = parse_frontmatter(text)\n205\t    description = fm.get(\"description\", \"\")\n206\t    try:\n207\t        rel = str(path.relative_to(repo))\n208\t    except ValueError:\n209\t        rel = str(path)\n210\t    # Progressive-disclosure state (Wave C): a skill self-retires from\n211\t    # savings_top3 only when its live SKILL.md actually POINTS at the\n212\t    # references/ dir. Dir existence alone is not enough: during a\n213\t    # parallel-shadow soak the references land beside a still-unsplit\n214\t    # live SKILL.md, and that skill must keep appearing in the report.\n215\t    has_references = (\n216\t        category in (CAT_SKILLS, CAT_CORE_SKILL)\n217\t        and (path.parent / \"references\").is_dir()\n218\t        and \"references/\" in text\n219\t    )\n220\t    return {\n221\t        \"category\": category,\n222\t        \"path\": rel,\n223\t        \"lines\": lines,\n224\t        \"chars\": chars,\n225\t        \"est_tokens\": estimate_tokens(chars),\n226\t        \"description_chars\": len(description),\n227\t        \"has_references\": has_references,\n228\t    }\n229\t\n230\t\n231\t# ---------------------------------------------------------------------------\n232\t# MCP discovery\n233\t# ---------------------------------------------------------------------------\n234\t\n235\t\n236\tdef discover_mcp_servers(repo: Path) -> Tuple[List[str], List[str]]:\n237\t    \"\"\"Best-effort discovery of the MCP subscription surface.\n238\t\n239\t    Looks for an ``mcpServers`` object in (in order) ``.mcp.json``,\n240\t    ``.claude/.mcp.json``, ``.claude/settings.json``, and\n241\t    ``.claude/settings.local.json``. Returns ``(server_names, source_files)``.\n242\t    Read-only; tolerant of malformed JSON / missing files (advisory).\n243\t    \"\"\"\n244\t    candidates = [\n245\t        repo / \".mcp.json\",\n246\t        repo / \".claude\" / \".mcp.json\",\n247\t        repo / \".claude\" / \"settings.json\",\n248\t        repo / \".claude\" / \"settings.local.json\",\n249\t    ]\n250\t    names: List[str] = []\n251\t    sources: List[str] = []\n252\t    for cand in candidates:\n253\t        if not cand.is_file():\n254\t            continue\n255\t        text = _read_text(cand)\n256\t        if text is None:\n257\t            continue\n258\t        try:\n259\t            data = json.loads(text)\n260\t        except (json.JSONDecodeError, ValueError):\n261\t            continue\n262\t        if not isinstance(data, dict):\n263\t            continue\n264\t        servers = data.get(\"mcpServers\")\n265\t        if isinstance(servers, dict) and servers:\n266\t            try:\n267\t                rel = str(cand.relative_to(repo))\n268\t            except ValueError:\n269\t                rel = str(cand)\n270\t            sources.append(rel)\n271\t            for key in servers.keys():\n272\t                # Untrusted-data fence: server names come from file content\n273\t                # and are re-displayed — scan + charset-allowlist first.\n274\t                fenced = fence_token(str(key))\n275\t                if fenced not in names:\n276\t                    names.append(fenced)\n277\t    return names, sources\n278\t\n279\t\n280\t# ---------------------------------------------------------------------------\n281\t# Inventory\n282\t# ---------------------------------------------------------------------------\n283\t\n284\t\n285\tdef _collect_files(repo: Path) -> Dict[str, List[Dict[str, Any]]]:\n286\t    \"\"\"Walk the Gate-1 + skill surface and build per-category file entries.\"\"\"\n287\t    out: Dict[str, List[Dict[str, Any]]] = {\n288\t        CAT_CLAUDE_MD: [],\n289\t        CAT_PROTOCOL: [],\n290\t        CAT_TEAM: [],\n291\t        CAT_CORE_SKILL: [],\n292\t        CAT_AGENTS: [],\n293\t        CAT_SKILLS: [],\n294\t        CAT_COMMANDS: [],\n295\t    }\n296\t\n297\t    def _add(category: str, path: Path) -> None:\n298\t        if path.is_file():\n299\t            entry = _file_entry(path, repo, category)\n300\t            if entry is not None:\n301\t                out[category].append(entry)\n302\t\n303\t    _add(CAT_CLAUDE_MD, repo / \"CLAUDE.md\")\n304\t    _add(CAT_PROTOCOL, repo / \"PROTOCOL.md\")\n305\t    _add(CAT_TEAM, repo / \".claude\" / \"team.md\")\n306\t    _add(CAT_TEAM, repo / \".claude\" / \"frontend-team.md\")\n307\t\n308\t    core_skill = repo / \".claude\" / \"skills\" / \"core\" / \"ceo-orchestration\" / \"SKILL.md\"\n309\t    _add(CAT_CORE_SKILL, core_skill)\n310\t\n311\t    agents_dir = repo / \".claude\" / \"agents\"\n312\t    if agents_dir.is_dir():\n313\t        for p in sorted(agents_dir.glob(\"*.md\")):\n314\t            _add(CAT_AGENTS, p)\n315\t\n316\t    skills_dir = repo / \".claude\" / \"skills\"\n317\t    if skills_dir.is_dir():\n318\t        for p in sorted(skills_dir.rglob(\"SKILL.md\")):\n319\t            # The core ceo-orchestration SKILL.md is its own category — don't\n320\t            # double-count it under the generic skills bucket.\n321\t            if p.resolve() == core_skill.resolve():\n322\t                continue\n323\t            _add(CAT_SKILLS, p)\n324\t\n325\t    commands_dir = repo / \".claude\" / \"commands\"\n326\t    if commands_dir.is_dir():\n327\t        for p in sorted(commands_dir.glob(\"*.md\")):\n328\t            _add(CAT_COMMANDS, p)\n329\t\n330\t    return out\n331\t\n332\t\n333\tdef _flag_file(entry: Dict[str, Any]) -> List[Dict[str, Any]]:\n334\t    \"\"\"Return reduction-candidate flags for a single file entry.\n335\t\n336\t    Heavy-file (line) flags use the per-category threshold; a bloated\n337\t    frontmatter ``description:`` is a separate flag.\n338\t    \"\"\"\n339\t    flags: List[Dict[str, Any]] = []\n340\t    category = entry[\"category\"]\n341\t    lines = entry[\"lines\"]\n342\t\n343\t    if category == CAT_AGENTS:\n344\t        threshold = THRESHOLD_AGENT_LINES\n345\t    elif category in (CAT_SKILLS, CAT_CORE_SKILL):\n346\t        threshold = THRESHOLD_SKILL_LINES\n347\t    elif category == CAT_COMMANDS:\n348\t        threshold = THRESHOLD_RULE_LINES\n349\t    else:\n350\t        threshold = None  # claude_md / protocol / team have no line threshold\n351\t\n352\t    if threshold is not None and lines > threshold:\n353\t        flags.append({\n354\t            \"kind\": \"heavy_file\",\n355\t            \"category\": category,\n356\t            \"path\": entry[\"path\"],\n357\t            \"lines\": lines,\n358\t            \"threshold_lines\": threshold,\n359\t            \"est_tokens\": entry[\"est_tokens\"],\n360\t            \"message\": (\n361\t                \"{cat} file is {lines} lines (> {thr}); consider splitting or \"\n362\t                \"trimming to reduce always-loaded context\".format(\n363\t                    cat=category, lines=lines, thr=threshold,\n364\t                )\n365\t            ),\n366\t        })\n367\t\n368\t    if entry[\"description_chars\"] > THRESHOLD_DESCRIPTION_CHARS:\n369\t        flags.append({\n370\t            \"kind\": \"bloated_description\",\n371\t            \"category\": category,\n372\t            \"path\": entry[\"path\"],\n373\t            \"description_chars\": entry[\"description_chars\"],\n374\t            \"threshold_chars\": THRESHOLD_DESCRIPTION_CHARS,\n375\t            \"est_tokens\": entry[\"est_tokens\"],\n376\t            \"message\": (\n377\t                \"frontmatter description is {n} chars (> {thr}); trim to keep \"\n378\t                \"the skill/agent index lean\".format(\n379\t                    n=entry[\"description_chars\"], thr=THRESHOLD_DESCRIPTION_CHARS,\n380\t                )\n381\t            ),\n382\t        })\n383\t\n384\t    return flags\n385\t\n386\t\n387\tdef compute_savings(\n388\t    files_by_cat: Dict[str, List[Dict[str, Any]]],\n389\t    limit: int = 3,\n390\t) -> List[Dict[str, Any]]:\n391\t    \"\"\"Top-N progressive-disclosure savings opportunities (Wave C item 5).\n392\t\n393\t    Candidate = a SKILL.md entry (skills or core_skill category) with\n394\t    ``lines > THRESHOLD_SKILL_LINES`` and NO existing ``references/`` dir.\n395\t    PLAN-153-designated pilots rank first WHEN FOUND as candidates; remaining\n396\t    slots go to the largest candidates by estimated tokens (path tie-break).\n397\t    Every entry carries an honest ``reason`` naming which rule ranked it.\n398\t    \"\"\"\n399\t    candidates = [\n400\t        e\n401\t        for cat in (CAT_SKILLS, CAT_CORE_SKILL)\n402\t        for e in files_by_cat.get(cat, [])\n403\t        if e[\"lines\"] > THRESHOLD_SKILL_LINES and not e.get(\"has_references\")\n404\t    ]\n405\t    by_path = {e[\"path\"]: e for e in candidates}\n406\t    picked: List[Dict[str, Any]] = []\n407\t    picked_paths = set()\n408\t\n409\t    for pilot in DESIGNATED_PILOTS:\n410\t        if len(picked) >= limit:\n411\t            break\n412\t        entry = by_path.get(pilot)\n413\t        if entry is None:\n414\t            continue\n415\t        picked.append(_savings_entry(\n416\t            entry,\n417\t            reason=\"PLAN-153 Wave C item 1 designated pilot (plan decision, \"\n418\t                   \"not size rank alone — larger files may exist below)\",\n419\t        ))\n420\t        picked_paths.add(entry[\"path\"])\n421\t\n422\t    rest = sorted(\n423\t        (e for e in candidates if e[\"path\"] not in picked_paths),\n424\t        key=lambda e: (-e[\"est_tokens\"], e[\"path\"]),\n425\t    )\n426\t    for entry in rest:\n427\t        if len(picked) >= limit:\n428\t            break\n429\t        picked.append(_savings_entry(\n430\t            entry, reason=\"largest un-split SKILL.md by estimated tokens\"))\n431\t        picked_paths.add(entry[\"path\"])\n432\t\n433\t    for rank, item in enumerate(picked, start=1):\n434\t        item[\"rank\"] = rank\n435\t    return picked\n436\t\n437\t\n438\tdef _savings_entry(entry: Dict[str, Any], reason: str) -> Dict[str, Any]:\n439\t    \"\"\"One savings_top3 row. Numbers are estimates (chars/4 heuristic).\"\"\"\n440\t    item = {\n441\t        \"rank\": 0,\n442\t        \"path\": entry[\"path\"],\n443\t        \"category\": entry[\"category\"],\n444\t        \"lines\": entry[\"lines\"],\n445\t        \"est_tokens\": entry[\"est_tokens\"],\n446\t        \"est_saving_tokens\": max(\n447\t            0, entry[\"est_tokens\"] - POINTER_OVERHEAD_TOKENS),\n448\t        \"reason\": reason,\n449\t        \"mechanism\": (\n450\t            \"extract references/*.md + loader pointer in SKILL.md \"\n451\t            \"(100% content preserved; saving = activation-time only)\"\n452\t        ),\n453\t    }\n454\t    if entry[\"category\"] == CAT_CORE_SKILL:\n455\t        item[\"caveat\"] = (\n456\t            \"always-on at Gate 2 — highest raw saving, but restructuring the \"\n457\t            \"core CEO skill needs its own ceremony/debate, not a Wave C pilot\"\n458\t        )\n459\t    return item\n460\t\n461\t\n462\tdef build_inventory(repo: Path, top: int = 10) -> Dict[str, Any]:\n463\t    \"\"\"Produce the full context-budget report dict.\n464\t\n465\t    Categories table + flat file list + flagged reduction candidates + a\n466\t    top-N ranking by estimated tokens (heaviest first).\n467\t    \"\"\"\n468\t    files_by_cat = _collect_files(repo)\n469\t    mcp_names, mcp_sources = discover_mcp_servers(repo)\n470\t\n471\t    categories: List[Dict[str, Any]] = []\n472\t    all_files: List[Dict[str, Any]] = []\n473\t    flags: List[Dict[str, Any]] = []\n474\t    grand_tokens = 0\n475\t\n476\t    cat_order = [\n477\t        CAT_CLAUDE_MD, CAT_PROTOCOL, CAT_TEAM, CAT_CORE_SKILL,\n478\t        CAT_AGENTS, CAT_SKILLS, CAT_COMMANDS,\n479\t    ]\n480\t    for cat in cat_order:\n481\t        entries = files_by_cat.get(cat, [])\n482\t        cat_tokens = sum(e[\"est_tokens\"] for e in entries)\n483\t        cat_lines = sum(e[\"lines\"] for e in entries)\n484\t        grand_tokens += cat_tokens\n485\t        categories.append({\n486\t            \"category\": cat,\n487\t            \"file_count\": len(entries),\n488\t            \"total_lines\": cat_lines,\n489\t            \"est_tokens\": cat_tokens,\n490\t        })\n491\t        for e in entries:\n492\t            all_files.append(e)\n493\t            flags.extend(_flag_file(e))\n494\t\n495\t    # MCP category — count-based, not file-token-based.\n496\t    mcp_over = len(mcp_names) > THRESHOLD_MCP_SERVERS\n497\t    categories.append({\n498\t        \"category\": CAT_MCP,\n499\t        \"file_count\": len(mcp_sources),\n500\t        \"server_count\": len(mcp_names),\n501\t        \"servers\": mcp_names,\n502\t        \"sources\": mcp_sources,\n503\t        \"over_subscribed\": mcp_over,\n504\t        \"threshold_servers\": THRESHOLD_MCP_SERVERS,\n505\t    })\n506\t    if mcp_over:\n507\t        flags.append({\n508\t            \"kind\": \"mcp_over_subscription\",\n509\t            \"category\": CAT_MCP,\n510\t            \"server_count\": len(mcp_names),\n511\t            \"threshold_servers\": THRESHOLD_MCP_SERVERS,\n512\t            \"servers\": mcp_names,\n513\t            \"message\": (\n514\t                \"{n} MCP servers configured (> {thr}); each adds tool-schema \"\n515\t                \"context — unsubscribe unused ones\".format(\n516\t                    n=len(mcp_names), thr=THRESHOLD_MCP_SERVERS,\n517\t                )\n518\t            ),\n519\t        })\n520\t\n521\t    # Top-N reduction candidates: heaviest files by estimated tokens, desc.\n522\t    # Stable tie-break on path so ordering is deterministic across runs.\n523\t    ranked = sorted(\n524\t        all_files,\n525\t        key=lambda e: (-e[\"est_tokens\"], e[\"path\"]),\n526\t    )\n527\t    if top is not None and top >= 0:\n528\t        ranked = ranked[:top]\n529\t\n530\t    return {\n531\t        \"schema\": \"context-budget.v1\",\n532\t        \"repo_root\": str(repo),\n533\t        \"heuristic\": \"1 token ~= {} chars (ESTIMATE, not the Anthropic \"\n534\t                     \"tokenizer)\".format(CHARS_PER_TOKEN),\n535\t        \"grand_total_est_tokens\": grand_tokens,\n536\t        \"categories\": categories,\n537\t        \"top_candidates\": ranked,\n538\t        # PLAN-153 Wave C item 5 (additive to v1): top-3 progressive-\n539\t        # disclosure savings + the honesty block. See module docstring.\n540\t        \"savings_top3\": compute_savings(files_by_cat),\n541\t        # PLAN-179 W3 US11 (additive to v1): declared orphan-probe status for\n542\t        # the D1/D2/D5 decision probes. Descriptive; gates nothing.\n543\t        \"probe_status\": probe_status(),\n544\t        \"notes\": list(HONESTY_NOTES) + [PROBE_STATUS_NOTE],\n545\t        \"scanner_available\": _injection_patterns is not None,\n546\t        \"flags\": flags,\n547\t        \"flag_count\": len(flags),\n548\t        \"files\": all_files,\n549\t    }\n550\t\n551\t\n552\t"}]},"parent_tool_use_id":null,"session_id":"9cf3be2a-1cec-4f25-9988-6f9e6658e555","uuid":"4fb33386-3648-498a-91d8-6c30a7a99f66","timestamp":"2026-11-16T20:04:51.286Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_context_budget_parts/inventory.py","content":"\"\"\"inventory context-budget declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n# Static note initialization only; bound functions use the facade value.\nCHARS_PER_TOKEN = 4\nREDACTED = \"[REDACTED-INJECTION-PATTERN]\"\n\n__all__ = ('_scan_matched', 'fence_token', 'POINTER_OVERHEAD_TOKENS', 'DESIGNATED_PILOTS', 'HONESTY_NOTES', 'estimate_tokens', '_read_text', '_line_count', '_BLOCK_SCALAR_INDICATORS', '_key_indent', 'parse_frontmatter', '_file_entry', 'discover_mcp_servers', '_collect_files', '_flag_file', 'compute_savings', '_savings_entry', 'build_inventory')\n\ndef _scan_matched(s: str) -> Optional[bool]:\n    \"\"\"Run the injection scan. True=hit, False=clean, None=scanner down.\"\"\"\n    if _injection_patterns is None:\n        return None\n    try:\n        scan_fn = getattr(_injection_patterns, \"scan_harness_mimicry\", None)\n        if not callable(scan_fn):\n            return None\n        result = scan_fn(s)\n        matched = getattr(result, \"matched\", None)\n        if matched is None:\n            matched = bool(result)\n        return bool(matched)\n    except Exception:  # noqa: BLE001\n        return None\n\n\ndef fence_token(s: Any, *, max_len: int = 80) -> str:\n    \"\"\"Fence an identifier-like field (MCP server name) for display.\n\n    Scanner first (hit => REDACTED), then a strictly-destructive charset\n    allowlist — safe to use even when the scanner is unavailable.\n    \"\"\"\n    if not isinstance(s, str):\n        s = str(s)\n    s = s.replace(\"\\x00\", \"\")[:max_len]\n    if _scan_matched(s) is True:\n        return REDACTED\n    s = _TOKEN_ALLOWED.sub(\"\", s)\n    return s or \"(empty)\"\n\n\n# ---------------------------------------------------------------------------\n# PLAN-153 Wave C item 5 — progressive-disclosure savings\n# ---------------------------------------------------------------------------\n\n# Loader-pointer stub assumed to remain in a split SKILL.md (est. tokens).\nPOINTER_OVERHEAD_TOKENS = 150\n\n# PLAN-153 Wave C item 1 designated progressive-disclosure pilots\n# (testing-strategy 1026L, security-and-auth 868L at designation time).\n# Surfaced FIRST in savings_top3 when — and only when — the scan finds them\n# still un-split; designation is a plan decision, not a size ranking, and\n# the entry's `reason` says so.\nDESIGNATED_PILOTS = (\n    \".claude/skills/core/testing-strategy/SKILL.md\",\n    \".claude/skills/core/security-and-auth/SKILL.md\",\n)\n\n# Honesty block rendered in BOTH outputs (markdown + --json).\nHONESTY_NOTES = (\n    \"Token figures are chars/{} — a heuristic ESTIMATE, not a tokenizer \"\n    \"(expect +/-20-30% vs real BPE counts).\".format(CHARS_PER_TOKEN),\n    \"STATIC audit only: measures what a file costs WHEN loaded, not runtime \"\n    \"usage or value. Retire/merge/improve judgement belongs to /skill-health \"\n    \"telemetry; neither tool can measure greenfield domains (PLAN-153 \"\n    \"debate A must-fix 4).\",\n    \"All scanned file content is rendered as UNTRUSTED DATA, never as \"\n    \"instructions. Re-displayed free text (MCP server names) is \"\n    \"injection-scanned; hits render as {}.\".format(REDACTED),\n    \"savings_top3 assumes the Wave C progressive-disclosure mechanism: \"\n    \"extract references/*.md + keep a ~{}-token loader pointer in SKILL.md \"\n    \"(100% content preserved; saving is activation-time only).\".format(\n        POINTER_OVERHEAD_TOKENS),\n)\n\n\n# ---------------------------------------------------------------------------\n# Primitives\n# ---------------------------------------------------------------------------\n\n\ndef estimate_tokens(char_count: int) -> int:\n    \"\"\"chars/4 token estimate (repo-canonical heuristic; estimate only).\"\"\"\n    if char_count <= 0:\n        return 0\n    return char_count // CHARS_PER_TOKEN\n\n\ndef _read_text(path: Path) -> Optional[str]:\n    \"\"\"Read a file as UTF-8; return None on any OS/decoding error.\n\n    Resilient by design — a missing or unreadable file MUST NOT crash an\n    advisory scan (fail-open, §5 doctrine).\n    \"\"\"\n    try:\n        return path.read_text(encoding=\"utf-8\")\n    except (OSError, UnicodeDecodeError):\n        return None\n\n\ndef _line_count(text: str) -> int:\n    if not text:\n        return 0\n    # Count lines without a spurious trailing-empty when file ends in \\n.\n    n = text.count(\"\\n\")\n    if text and not text.endswith(\"\\n\"):\n        n += 1\n    return n\n\n\n# YAML block-scalar indicators that introduce a multi-line value on the\n# following more-indented continuation lines (`description: >` etc.). An empty\n# value after the colon is also treated as a possible block start so a plain\n# `description:`\\n  text continuation is captured too.\n_BLOCK_SCALAR_INDICATORS = frozenset({\">\", \"|\", \">-\", \"|-\", \">+\", \"|+\"})\n\n\ndef _key_indent(raw_line: str) -> int:\n    \"\"\"Leading-space indent width of a raw (un-stripped) frontmatter line.\"\"\"\n    return len(raw_line) - len(raw_line.lstrip(\" \"))\n\n\ndef parse_frontmatter(text: str) -> Dict[str, str]:\n    \"\"\"Parse a leading ``---`` YAML-ish frontmatter block into a flat dict.\n\n    Best-effort line-based parse (no YAML dep): ``key: value`` only, first\n    colon wins, ``#`` comment lines skipped. Mirrors check-staleness.py.\n\n    YAML folded/block scalars are handled: when a ``key:`` line has an empty\n    value OR a block indicator (``>``, ``|``, ``>-``, ``|-``, ``>+``, ``|+``),\n    the subsequent MORE-INDENTED continuation lines are consumed and\n    space-joined as the value. This is what lets ``bloated_description`` fire\n    on the ~49 real SKILL.md files that write ``description: >`` with the body\n    on following indented lines (otherwise the value reads as ``>``, len 1).\n    \"\"\"\n    if not text:\n        return {}\n    m = _FRONTMATTER_RE.match(text)\n    if not m:\n        return {}\n    result: Dict[str, str] = {}\n    raw_lines = m.group(1).splitlines()\n    i = 0\n    n = len(raw_lines)\n    while i < n:\n        raw = raw_lines[i]\n        s = raw.strip()\n        if not s or s.startswith(\"#\"):\n            i += 1\n            continue\n        if \":\" not in s:\n            i += 1\n            continue\n        k, _, v = s.partition(\":\")\n        key = k.strip()\n        value = v.strip()\n        key_indent = _key_indent(raw)\n        i += 1\n        if value == \"\" or value in _BLOCK_SCALAR_INDICATORS:\n            # Consume the following MORE-INDENTED (non-blank, non-comment)\n            # continuation lines as the block/folded scalar body.\n            parts: List[str] = []\n            while i < n:\n                cont_raw = raw_lines[i]\n                cont_stripped = cont_raw.strip()\n                if cont_stripped == \"\":\n                    # Blank line: part of a block scalar — keep scanning, but\n                    # contributes no token to a space-joined value.\n                    i += 1\n                    continue\n                if _key_indent(cont_raw) <= key_indent:\n                    break  # dedent back to (or above) the key → block ended\n                parts.append(cont_stripped)\n                i += 1\n            joined = \" \".join(parts).strip()\n            # If the scalar had an explicit indicator but no body, fall back to\n            # the indicator text only if nothing was captured (len stays small).\n            if joined:\n                value = joined\n        result[key] = value\n    return result\n\n\ndef _file_entry(path: Path, repo: Path, category: str) -> Optional[Dict[str, Any]]:\n    \"\"\"Build a per-file inventory entry, or None if unreadable.\n\n    Carries the line count, byte/char size, token estimate, and (when a\n    frontmatter ``description:`` exists) its length for bloat-flagging.\n    \"\"\"\n    text = _read_text(path)\n    if text is None:\n        return None\n    chars = len(text)\n    lines = _line_count(text)\n    fm = parse_frontmatter(text)\n    description = fm.get(\"description\", \"\")\n    try:\n        rel = str(path.relative_to(repo))\n    except ValueError:\n        rel = str(path)\n    # Progressive-disclosure state (Wave C): a skill self-retires from\n    # savings_top3 only when its live SKILL.md actually POINTS at the\n    # references/ dir. Dir existence alone is not enough: during a\n    # parallel-shadow soak the references land beside a still-unsplit\n    # live SKILL.md, and that skill must keep appearing in the report.\n    has_references = (\n        category in (CAT_SKILLS, CAT_CORE_SKILL)\n        and (path.parent / \"references\").is_dir()\n        and \"references/\" in text\n    )\n    return {\n        \"category\": category,\n        \"path\": rel,\n        \"lines\": lines,\n        \"chars\": chars,\n        \"est_tokens\": estimate_tokens(chars),\n        \"description_chars\": len(description),\n        \"has_references\": has_references,\n    }\n\n\n# ---------------------------------------------------------------------------\n# MCP discovery\n# ---------------------------------------------------------------------------\n\n\ndef discover_mcp_servers(repo: Path) -> Tuple[List[str], List[str]]:\n    \"\"\"Best-effort discovery of the MCP subscription surface.\n\n    Looks for an ``mcpServers`` object in (in order) ``.mcp.json``,\n    ``.claude/.mcp.json``, ``.claude/settings.json``, and\n    ``.claude/settings.local.json``. Returns ``(server_names, source_files)``.\n    Read-only; tolerant of malformed JSON / missing files (advisory).\n    \"\"\"\n    candidates = [\n        repo / \".mcp.json\",\n        repo / \".claude\" / \".mcp.json\",\n        repo / \".claude\" / \"settings.json\",\n        repo / \".claude\" / \"settings.local.json\",\n    ]\n    names: List[str] = []\n    sources: List[str] = []\n    for cand in candidates:\n        if not cand.is_file():\n            continue\n        text = _read_text(cand)\n        if text is None:\n            continue\n        try:\n            data = json.loads(text)\n        except (json.JSONDecodeError, ValueError):\n            continue\n        if not isinstance(data, dict):\n            continue\n        servers = data.get(\"mcpServers\")\n        if isinstance(servers, dict) and servers:\n            try:\n                rel = str(cand.relative_to(repo))\n            except ValueError:\n                rel = str(cand)\n            sources.append(rel)\n            for key in servers.keys():\n                # Untrusted-data fence: server names come from file content\n                # and are re-displayed — scan + charset-allowlist first.\n                fenced = fence_token(str(key))\n                if fenced not in names:\n                    names.append(fenced)\n    return names, sources\n\n\n# ---------------------------------------------------------------------------\n# Inventory\n# ---------------------------------------------------------------------------\n\n\ndef _collect_files(repo: Path) -> Dict[str, List[Dict[str, Any]]]:\n    \"\"\"Walk the Gate-1 + skill surface and build per-category file entries.\"\"\"\n    out: Dict[str, List[Dict[str, Any]]] = {\n        CAT_CLAUDE_MD: [],\n        CAT_PROTOCOL: [],\n        CAT_TEAM: [],\n        CAT_CORE_SKILL: [],\n        CAT_AGENTS: [],\n        CAT_SKILLS: [],\n        CAT_COMMANDS: [],\n    }\n\n    def _add(category: str, path: Path) -> None:\n        if path.is_file():\n            entry = _file_entry(path, repo, category)\n            if entry is not None:\n                out[category].append(entry)\n\n    _add(CAT_CLAUDE_MD, repo / \"CLAUDE.md\")\n    _add(CAT_PROTOCOL, repo / \"PROTOCOL.md\")\n    _add(CAT_TEAM, repo / \".claude\" / \"team.md\")\n    _add(CAT_TEAM, repo / \".claude\" / \"frontend-team.md\")\n\n    core_skill = repo / \".claude\" / \"skills\" / \"core\" / \"ceo-orchestration\" / \"SKILL.md\"\n    _add(CAT_CORE_SKILL, core_skill)\n\n    agents_dir = repo / \".claude\" / \"agents\"\n    if agents_dir.is_dir():\n        for p in sorted(agents_dir.glob(\"*.md\")):\n            _add(CAT_AGENTS, p)\n\n    skills_dir = repo / \".claude\" / \"skills\"\n    if skills_dir.is_dir():\n        for p in sorted(skills_dir.rglob(\"SKILL.md\")):\n            # The core ceo-orchestration SKILL.md is its own category — don't\n            # double-count it under the generic skills bucket.\n            if p.resolve() == core_skill.resolve():\n                continue\n            _add(CAT_SKILLS, p)\n\n    commands_dir = repo / \".claude\" / \"commands\"\n    if commands_dir.is_dir():\n        for p in sorted(commands_dir.glob(\"*.md\")):\n            _add(CAT_COMMANDS, p)\n\n    return out\n\n\ndef _flag_file(entry: Dict[str, Any]) -> List[Dict[str, Any]]:\n    \"\"\"Return reduction-candidate flags for a single file entry.\n\n    Heavy-file (line) flags use the per-category threshold; a bloated\n    frontmatter ``description:`` is a separate flag.\n    \"\"\"\n    flags: List[Dict[str, Any]] = []\n    category = entry[\"category\"]\n    lines = entry[\"lines\"]\n\n    if category == CAT_AGENTS:\n        threshold = THRESHOLD_AGENT_LINES\n    elif category in (CAT_SKILLS, CAT_CORE_SKILL):\n        threshold = THRESHOLD_SKILL_LINES\n    elif category == CAT_COMMANDS:\n        threshold = THRESHOLD_RULE_LINES\n    else:\n        threshold = None  # claude_md / protocol / team have no line threshold\n\n    if threshold is not None and lines > threshold:\n        flags.append({\n            \"kind\": \"heavy_file\",\n            \"category\": category,\n            \"path\": entry[\"path\"],\n            \"lines\": lines,\n            \"threshold_lines\": threshold,\n            \"est_tokens\": entry[\"est_tokens\"],\n            \"message\": (\n                \"{cat} file is {lines} lines (> {thr}); consider splitting or \"\n                \"trimming to reduce always-loaded context\".format(\n                    cat=category, lines=lines, thr=threshold,\n                )\n            ),\n        })\n\n    if entry[\"description_chars\"] > THRESHOLD_DESCRIPTION_CHARS:\n        flags.append({\n            \"kind\": \"bloated_description\",\n            \"category\": category,\n            \"path\": entry[\"path\"],\n            \"description_chars\": entry[\"description_chars\"],\n            \"threshold_chars\": THRESHOLD_DESCRIPTION_CHARS,\n            \"est_tokens\": entry[\"est_tokens\"],\n            \"message\": (\n                \"frontmatter description is {n} chars (> {thr}); trim to keep \"\n                \"the skill/agent index lean\".format(\n                    n=entry[\"description_chars\"], thr=THRESHOLD_DESCRIPTION_CHARS,\n                )\n            ),\n        })\n\n    return flags\n\n\ndef compute_savings(\n    files_by_cat: Dict[str, List[Dict[str, Any]]],\n    limit: int = 3,\n) -> List[Dict[str, Any]]:\n    \"\"\"Top-N progressive-disclosure savings opportunities (Wave C item 5).\n\n    Candidate = a SKILL.md entry (skills or core_skill category) with\n    ``lines > THRESHOLD_SKILL_LINES`` and NO existing ``references/`` dir.\n    PLAN-153-designated pilots rank first WHEN FOUND as candidates; remaining\n    slots go to the largest candidates by estimated tokens (path tie-break).\n    Every entry carries an honest ``reason`` naming which rule ranked it.\n    \"\"\"\n    candidates = [\n        e\n        for cat in (CAT_SKILLS, CAT_CORE_SKILL)\n        for e in files_by_cat.get(cat, [])\n        if e[\"lines\"] > THRESHOLD_SKILL_LINES and not e.get(\"has_references\")\n    ]\n    by_path = {e[\"path\"]: e for e in candidates}\n    picked: List[Dict[str, Any]] = []\n    picked_paths = set()\n\n    for pilot in DESIGNATED_PILOTS:\n        if len(picked) >= limit:\n            break\n        entry = by_path.get(pilot)\n        if entry is None:\n            continue\n        picked.append(_savings_entry(\n            entry,\n            reason=\"PLAN-153 Wave C item 1 designated pilot (plan decision, \"\n                   \"not size rank alone — larger files may exist below)\",\n        ))\n        picked_paths.add(entry[\"path\"])\n\n    rest = sorted(\n        (e for e in candidates if e[\"path\"] not in picked_paths),\n        key=lambda e: (-e[\"est_tokens\"], e[\"path\"]),\n    )\n    for entry in rest:\n        if len(picked) >= limit:\n            break\n        picked.append(_savings_entry(\n            entry, reason=\"largest un-split SKILL.md by estimated tokens\"))\n        picked_paths.add(entry[\"path\"])\n\n    for rank, item in enumerate(picked, start=1):\n        item[\"rank\"] = rank\n    return picked\n\n\ndef _savings_entry(entry: Dict[str, Any], reason: str) -> Dict[str, Any]:\n    \"\"\"One savings_top3 row. Numbers are estimates (chars/4 heuristic).\"\"\"\n    item = {\n        \"rank\": 0,\n        \"path\": entry[\"path\"],\n        \"category\": entry[\"category\"],\n        \"lines\": entry[\"lines\"],\n        \"est_tokens\": entry[\"est_tokens\"],\n        \"est_saving_tokens\": max(\n            0, entry[\"est_tokens\"] - POINTER_OVERHEAD_TOKENS),\n        \"reason\": reason,\n        \"mechanism\": (\n            \"extract references/*.md + loader pointer in SKILL.md \"\n            \"(100% content preserved; saving = activation-time only)\"\n        ),\n    }\n    if entry[\"category\"] == CAT_CORE_SKILL:\n        item[\"caveat\"] = (\n            \"always-on at Gate 2 — highest raw saving, but restructuring the \"\n            \"core CEO skill needs its own ceremony/debate, not a Wave C pilot\"\n        )\n    return item\n\n\ndef build_inventory(repo: Path, top: int = 10) -> Dict[str, Any]:\n    \"\"\"Produce the full context-budget report dict.\n\n    Categories table + flat file list + flagged reduction candidates + a\n    top-N ranking by estimated tokens (heaviest first).\n    \"\"\"\n    files_by_cat = _collect_files(repo)\n    mcp_names, mcp_sources = discover_mcp_servers(repo)\n\n    categories: List[Dict[str, Any]] = []\n    all_files: List[Dict[str, Any]] = []\n    flags: List[Dict[str, Any]] = []\n    grand_tokens = 0\n\n    cat_order = [\n        CAT_CLAUDE_MD, CAT_PROTOCOL, CAT_TEAM, CAT_CORE_SKILL,\n        CAT_AGENTS, CAT_SKILLS, CAT_COMMANDS,\n    ]\n    for cat in cat_order:\n        entries = files_by_cat.get(cat, [])\n        cat_tokens = sum(e[\"est_tokens\"] for e in entries)\n        cat_lines = sum(e[\"lines\"] for e in entries)\n        grand_tokens += cat_tokens\n        categories.append({\n            \"category\": cat,\n            \"file_count\": len(entries),\n            \"total_lines\": cat_lines,\n            \"est_tokens\": cat_tokens,\n        })\n        for e in entries:\n            all_files.append(e)\n            flags.extend(_flag_file(e))\n\n    # MCP category — count-based, not file-token-based.\n    mcp_over = len(mcp_names) > THRESHOLD_MCP_SERVERS\n    categories.append({\n        \"category\": CAT_MCP,\n        \"file_count\": len(mcp_sources),\n        \"server_count\": len(mcp_names),\n        \"servers\": mcp_names,\n        \"sources\": mcp_sources,\n        \"over_subscribed\": mcp_over,\n        \"threshold_servers\": THRESHOLD_MCP_SERVERS,\n    })\n    if mcp_over:\n        flags.append({\n            \"kind\": \"mcp_over_subscription\",\n            \"category\": CAT_MCP,\n            \"server_count\": len(mcp_names),\n            \"threshold_servers\": THRESHOLD_MCP_SERVERS,\n            \"servers\": mcp_names,\n            \"message\": (\n                \"{n} MCP servers configured (> {thr}); each adds tool-schema \"\n                \"context — unsubscribe unused ones\".format(\n                    n=len(mcp_names), thr=THRESHOLD_MCP_SERVERS,\n                )\n            ),\n        })\n\n    # Top-N reduction candidates: heaviest files by estimated tokens, desc.\n    # Stable tie-break on path so ordering is deterministic across runs.\n    ranked = sorted(\n        all_files,\n        key=lambda e: (-e[\"est_tokens\"], e[\"path\"]),\n    )\n    if top is not None and top >= 0:\n        ranked = ranked[:top]\n\n    return {\n        \"schema\": \"context-budget.v1\",\n        \"repo_root\": str(repo),\n        \"heuristic\": \"1 token ~= {} chars (ESTIMATE, not the Anthropic \"\n                     \"tokenizer)\".format(CHARS_PER_TOKEN),\n        \"grand_total_est_tokens\": grand_tokens,\n        \"categories\": categories,\n        \"top_candidates\": ranked,\n        # PLAN-153 Wave C item 5 (additive to v1): top-3 progressive-\n        # disclosure savings + the honesty block. See module docstring.\n        \"savings_top3\": compute_savings(files_by_cat),\n        # PLAN-179 W3 US11 (additive to v1): declared orphan-probe status for\n        # the D1/D2/D5 decision probes. Descriptive; gates nothing.\n        \"probe_status\": probe_status(),\n        \"notes\": list(HONESTY_NOTES) + [PROBE_STATUS_NOTE],\n        \"scanner_available\": _injection_patterns is not None,\n        \"flags\": flags,\n        \"flag_count\": len(flags),\n        \"files\": all_files,\n    }\n\n\n","numLines":552,"startLine":1,"totalLines":552}},"tool_result_meta":[{"id":"toolu_01EKQBddbCa1DkoquyJosEQ6","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
