+def cmd_off(root: Path) -> int:
+    refused = _refuse_if_ci()
+    if refused is not None:
+        _summary(mode="none", previous_mode="none", result="refused")
+        _emit_audit("other", "other", "refused")
+        return refused
+
+    FileLock = _import_filelock()
