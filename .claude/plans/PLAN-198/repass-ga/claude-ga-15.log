{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TutMMbdMhChRS45ZwhBSMF","type":"tool_result","content":"1\t\"\"\"Workflow.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('emit_debate_event', 'emit_plan_transition', 'emit_veto_triggered', 'emit_benchmark_run', '_EVAL_TASK_COMPLETED_ALLOWLIST', 'emit_eval_task_completed', 'emit_injection_flag', 'emit_lesson_write', 'emit_confidence_gate', 'emit_lesson_read', 'emit_lesson_archived', 'emit_lesson_restored', 'emit_lesson_outcome', 'emit_state_store_write', 'emit_state_store_read', 'emit_budget_exceeded', 'emit_budget_bypass_used', 'emit_otel_export_dropped', 'emit_output_safety_flag')\n9\t\n10\t# -----------------------------------------------------------------------------\n11\t# Public emitters\n12\t# -----------------------------------------------------------------------------\n13\t\n14\t\n15\tdef emit_debate_event(\n16\t    plan_id: str,\n17\t    round_num: int,\n18\t    phase: str,\n19\t    agent: str,\n20\t    artifact_path: Optional[str] = None,\n21\t    consensus_adjustments_count: Optional[int] = None,\n22\t    session_id: str = \"\",\n23\t    project: str = \"\",\n24\t) -> None:\n25\t    \"\"\"Emit a debate round event.\n26\t\n27\t    Args:\n28\t        plan_id: e.g. \"PLAN-004\"\n29\t        round_num: 1–3\n30\t        phase: \"start\" | \"agent-done\" | \"consensus\"\n31\t        agent: archetype slug (vp-engineering, security-engineer, etc.) or \"consensus\"\n32\t        artifact_path: path to the critique/consensus file\n33\t        consensus_adjustments_count: set only on phase=\"consensus\"\n34\t    \"\"\"\n35\t    event: Dict[str, Any] = {\n36\t        \"action\": \"debate_event\",\n37\t        \"plan_id\": plan_id,\n38\t        \"round\": round_num,\n39\t        \"phase\": phase,\n40\t        \"agent\": agent,\n41\t        \"session_id\": session_id,\n42\t        \"project\": project,\n43\t    }\n44\t    if artifact_path is not None:\n45\t        event[\"artifact_path\"] = artifact_path\n46\t    if consensus_adjustments_count is not None:\n47\t        event[\"consensus_adjustments_count\"] = consensus_adjustments_count\n48\t    _write_event(event)\n49\t\n50\t\n51\tdef emit_plan_transition(\n52\t    plan_id: str,\n53\t    from_status: str,\n54\t    to_status: str,\n55\t    file_path: str,\n56\t    editor_tool: str = \"Edit\",\n57\t    session_id: str = \"\",\n58\t    project: str = \"\",\n59\t) -> None:\n60\t    \"\"\"Emit a legal plan status transition event.\n61\t\n62\t    Illegal transitions are blocked by check_plan_edit.py and emit a\n63\t    veto_triggered event instead.\n64\t    \"\"\"\n65\t    event: Dict[str, Any] = {\n66\t        \"action\": \"plan_transition\",\n67\t        \"plan_id\": plan_id,\n68\t        \"from_status\": from_status,\n69\t        \"to_status\": to_status,\n70\t        \"editor_tool\": editor_tool,\n71\t        \"file_path\": file_path,\n72\t        \"transition_legal\": True,\n73\t        \"session_id\": session_id,\n74\t        \"project\": project,\n75\t    }\n76\t    _write_event(event)\n77\t\n78\t\n79\tdef emit_veto_triggered(\n80\t    hook: str,\n81\t    reason_code: str,\n82\t    reason_preview: str,\n83\t    blocked_tool: str = \"\",\n84\t    strike_count: Optional[int] = None,\n85\t    session_id: str = \"\",\n86\t    project: str = \"\",\n87\t    caller: str = \"\",\n88\t) -> None:\n89\t    \"\"\"Emit a veto / block event from any governance hook.\n90\t\n91\t    Args:\n92\t        hook: \"check_agent_spawn\" | \"check_plan_edit\" | \"check_bash_safety\"\n93\t        reason_code: machine-readable rule identifier (e.g. \"missing_skill_content\")\n94\t        reason_preview: human-readable summary (redacted + truncated)\n95\t        blocked_tool: tool call that was blocked\n96\t        strike_count: session-scoped count (if tracked)\n97\t        caller: identity of the spawning agent or \"ceo\" (kernel events\n98\t            require this for forensic traceability — schema v2.14)\n99\t    \"\"\"\n100\t    event: Dict[str, Any] = {\n101\t        \"action\": \"veto_triggered\",\n102\t        \"hook\": hook,\n103\t        \"reason_code\": reason_code,\n104\t        \"reason_preview\": _preview(reason_preview),\n105\t        \"blocked_tool\": blocked_tool,\n106\t        \"session_id\": session_id,\n107\t        \"project\": project,\n108\t    }\n109\t    if strike_count is not None:\n110\t        event[\"strike_count\"] = strike_count\n111\t    if caller:\n112\t        event[\"caller\"] = caller\n113\t    _write_event(event)\n114\t\n115\t\n116\tdef emit_benchmark_run(\n117\t    benchmark_id: str,\n118\t    skill: str,\n119\t    pass_count: int,\n120\t    fail_count: int,\n121\t    pass_rate: float,\n122\t    median_score: float,\n123\t    floor: float,\n124\t    cost_usd: float = 0.0,\n125\t    duration_s: float = 0.0,\n126\t    lessons_written: int = 0,\n127\t    session_id: str = \"\",\n128\t    project: str = \"\",\n129\t) -> None:\n130\t    \"\"\"Emit a benchmark run completion event.\n131\t\n132\t    Float fields are encoded as integers to satisfy the canonical_json\n133\t    no-float invariant on HMAC-covered audit events:\n134\t\n135\t    - ``pass_rate``    → ``pass_rate_bps``    (rate × 1000, 0..1000)\n136\t    - ``median_score`` → ``median_score_bps`` (score × 1000, 0..1000)\n137\t    - ``floor``        → ``floor_bps``        (rate × 1000, 0..1000)\n138\t    - ``cost_usd``     → ``cost_usd_cents``   (USD × 100, ≥0)\n139\t    - ``duration_s``   → ``duration_ms``      (seconds × 1000, ≥0)\n140\t\n141\t    Readers must divide by the respective denominator to recover the\n142\t    original scale.\n143\t    \"\"\"\n144\t    event: Dict[str, Any] = {\n145\t        \"action\": \"benchmark_run\",\n146\t        \"benchmark_id\": benchmark_id,\n147\t        \"skill\": skill,\n148\t        \"pass_count\": int(pass_count),\n149\t        \"fail_count\": int(fail_count),\n150\t        \"pass_rate_bps\": max(0, min(1000, int(round(float(pass_rate) * 1000)))),\n151\t        \"median_score_bps\": max(0, min(1000, int(round(float(median_score) * 1000)))),\n152\t        \"floor_bps\": max(0, min(1000, int(round(float(floor) * 1000)))),\n153\t        \"cost_usd_cents\": max(0, int(round(float(cost_usd) * 100))),\n154\t        \"duration_ms\": max(0, int(round(float(duration_s) * 1000))),\n155\t        \"lessons_written\": int(lessons_written),\n156\t        \"session_id\": session_id,\n157\t        \"project\": project,\n158\t    }\n159\t    _write_event(event)\n160\t\n161\t\n162\t# PLAN-133 C3 — Sec MF-3 field allowlist for eval_task_completed. Closed set;\n163\t# anything outside it is dropped by _scrub (see emit_generic dispatch below).\n164\t_EVAL_TASK_COMPLETED_ALLOWLIST = frozenset({\n165\t    \"action\", \"task_id\", \"reward_bps\", \"status\", \"attempts\",\n166\t    \"flaky\", \"tokens\", \"turns\", \"event_schema\", \"ts\",\n167\t})\n168\t\n169\t\n170\tdef emit_eval_task_completed(\n171\t    task_id: str,\n172\t    reward: float,\n173\t    status: str = \"\",\n174\t    attempts: int = 0,\n175\t    flaky: bool = False,\n176\t    tokens: int = 0,\n177\t    turns: int = 0,\n178\t) -> None:\n179\t    \"\"\"Emit one real-task reward-benchmark result (PLAN-133 C3).\n180\t\n181\t    NO-VALUE-ECHO contract: the only free-text inputs are ``task_id`` (a stable\n182\t    task slug from .claude/eval/tasks/, NOT user/model content) and ``status``\n183\t    (coerced to the closed trial-status enum). No rejected env value, egress\n184\t    destination, retry_delay, or model output is ever carried. ``reward`` is\n185\t    encoded as basis-points (``reward_bps`` 0..1000) to satisfy the canonical_json\n186\t    no-float invariant; ``flaky`` is encoded as 0/1.\n187\t    \"\"\"\n188\t    status_norm = status if status in (\"pass\", \"partial\", \"fail\") else \"other\"\n189\t    event: Dict[str, Any] = {\n190\t        \"action\": \"eval_task_completed\",\n191\t        \"task_id\": str(task_id)[:64],\n192\t        \"reward_bps\": max(0, min(1000, int(round(float(reward) * 1000)))),\n193\t        \"status\": status_norm,\n194\t        \"attempts\": max(0, int(attempts)),\n195\t        \"flaky\": 1 if flaky else 0,\n196\t        \"tokens\": max(0, int(tokens)),\n197\t        \"turns\": max(0, int(turns)),\n198\t    }\n199\t    _write_event(event)\n200\t\n201\t\n202\tdef emit_injection_flag(\n203\t    source: str,\n204\t    family_counts: Dict[str, int],\n205\t    match_count: int,\n206\t    bytes_scanned: int,\n207\t    triggered_by_tool: str = \"\",\n208\t    snippet_preview: str = \"\",\n209\t    truncated: bool = False,\n210\t    session_id: str = \"\",\n211\t    project: str = \"\",\n212\t) -> None:\n213\t    \"\"\"Emit a prompt-injection flag event (v2.1, ADR-011).\n214\t\n215\t    Always advisory: this event records observation, never enforces a\n216\t    block. The PreToolUse hook `check_read_injection.py` calls this\n217\t    after running scan_text on a Read result; the audit-query.py\n218\t    `vetoes` and `metrics` sub-commands surface aggregated counts.\n219\t\n220\t    Args:\n221\t        source: file path / \"<stdin>\" / tool input identifier\n222\t        family_counts: per-family hit counts (e.g. {\"direct_override\": 2})\n223\t        match_count: total matches across families\n224\t        bytes_scanned: bytes the scanner inspected (bounded at 1 MiB)\n225\t        triggered_by_tool: e.g. \"Read\", \"Bash\"\n226\t        snippet_preview: redacted snippet of the highest-confidence hit\n227\t        truncated: True if input exceeded scanner cap\n228\t    \"\"\"\n229\t    event: Dict[str, Any] = {\n230\t        \"action\": \"injection_flag\",\n231\t        \"source\": source,\n232\t        \"family_counts\": dict(family_counts),\n233\t        \"match_count\": int(match_count),\n234\t        \"bytes_scanned\": int(bytes_scanned),\n235\t        \"truncated\": bool(truncated),\n236\t        \"triggered_by_tool\": triggered_by_tool,\n237\t        \"snippet_preview\": _preview(snippet_preview, max_len=200),\n238\t        \"session_id\": session_id,\n239\t        \"project\": project,\n240\t    }\n241\t    _write_event(event)\n242\t\n243\t\n244\tdef emit_lesson_write(\n245\t    lesson_id: str,\n246\t    archetype: str,\n247\t    scope_tags: List[str],\n248\t    trigger: str,\n249\t    source_event_id: str = \"\",\n250\t    session_id: str = \"\",\n251\t    project: str = \"\",\n252\t) -> None:\n253\t    \"\"\"Emit a lesson-write event (Reflexion corpus growth).\n254\t\n255\t    Args:\n256\t        lesson_id: stable identifier (e.g. hash or ULID)\n257\t        archetype: owning archetype slug\n258\t        scope_tags: scope tag list (subset of skill scope_tags)\n259\t        trigger: \"benchmark_fail\" | \"debate_adjustment\" | \"manual\"\n260\t        source_event_id: correlation to the originating event (desc_hash or artifact_path)\n261\t    \"\"\"\n262\t    event: Dict[str, Any] = {\n263\t        \"action\": \"lesson_write\",\n264\t        \"lesson_id\": lesson_id,\n265\t        \"archetype\": archetype,\n266\t        \"scope_tags\": list(scope_tags),\n267\t        \"trigger\": trigger,\n268\t        \"source_event_id\": source_event_id,\n269\t        \"session_id\": session_id,\n270\t        \"project\": project,\n271\t    }\n272\t    _write_event(event)\n273\t\n274\t\n275\tdef emit_confidence_gate(\n276\t    claim_count: int,\n277\t    pass_count: int,\n278\t    fail_count: int,\n279\t    verifier_kind_counts: Dict[str, int],\n280\t    agent_name: str = \"\",\n281\t    source: str = \"\",\n282\t    session_id: str = \"\",\n283\t    project: str = \"\",\n284\t    raw_claim_count: Optional[int] = None,\n285\t    truncated: bool = False,\n286\t) -> None:\n287\t    \"\"\"Emit a confidence_gate event (Sprint 8 Phase 2, ADR-018).\n288\t\n289\t    Advisory-only in Sprint 8: collects FPR baseline for Sprint 9 enforcement\n290\t    decision. Reserved fields set from day 1 (debate consensus C4).\n291\t\n292\t    Sprint 9 (PLAN-009 A12) adds ``raw_claim_count`` + ``truncated`` for\n293\t    ``CEO_CONFIDENCE_MAX_CLAIMS`` cap reporting. When the input produced\n294\t    more CLAIM tokens than the cap, ``claim_count`` is the post-cap value,\n295\t    ``raw_claim_count`` is the pre-cap count, and ``truncated=True``.\n296\t\n297\t    Args:\n298\t        claim_count: verified CLAIM tokens (post code-block exemption + cap)\n299\t        pass_count: claims that verified\n300\t        fail_count: claims that failed to verify\n301\t        verifier_kind_counts: dict of claim kind -> count (all kinds seen)\n302\t        agent_name: name of the agent whose output was scanned (optional)\n303\t        source: \"stdin\" | \"<file path>\" | \"<spawn-ref>\"\n304\t        raw_claim_count: pre-cap CLAIM token count; defaults to claim_count\n305\t            when the caller did not surface a cap\n306\t        truncated: True when raw_claim_count > claim_count\n307\t    \"\"\"\n308\t    if raw_claim_count is None:\n309\t        raw_claim_count = int(claim_count)\n310\t    event: Dict[str, Any] = {\n311\t        \"action\": \"confidence_gate\",\n312\t        \"claim_count\": int(claim_count),\n313\t        \"raw_claim_count\": int(raw_claim_count),\n314\t        \"truncated\": bool(truncated),\n315\t        \"pass_count\": int(pass_count),\n316\t        \"fail_count\": int(fail_count),\n317\t        \"verifier_kind_counts\": dict(verifier_kind_counts),\n318\t        \"agent_name\": agent_name,\n319\t        \"source\": source,\n320\t        \"session_id\": session_id,\n321\t        \"project\": project,\n322\t    }\n323\t    _write_event(event)\n324\t\n325\t\n326\tdef emit_lesson_read(\n327\t    lesson_ids: List[str],\n328\t    archetype: str,\n329\t    keywords: List[str],\n330\t    k: int,\n331\t    consumer: str = \"architect\",\n332\t    session_id: str = \"\",\n333\t    project: str = \"\",\n334\t) -> None:\n335\t    \"\"\"Emit a lesson_read event (Sprint 8 Phase 3).\n336\t\n337\t    Logged when `lessons.get_top_k()` is invoked to inject top-K lessons\n338\t    into a spawn prompt. Enables Sprint 9 outcome-tracking integration\n339\t    (correlating which injected lessons correlated with benchmark hits).\n340\t\n341\t    Args:\n342\t        lesson_ids: list of lesson IDs that were read (length <= k)\n343\t        archetype: archetype that the lessons were queried for\n344\t        keywords: keywords used for ranking\n345\t        k: requested top-K count\n346\t        consumer: \"architect\" | \"spawn\" | \"cli\"\n347\t    \"\"\"\n348\t    event: Dict[str, Any] = {\n349\t        \"action\": \"lesson_read\",\n350\t        \"lesson_ids\": list(lesson_ids),\n351\t        \"lesson_count\": len(lesson_ids),\n352\t        \"archetype\": archetype,\n353\t        \"keywords\": list(keywords),\n354\t        \"k\": int(k),\n355\t        \"consumer\": consumer,\n356\t        \"session_id\": session_id,\n357\t        \"project\": project,\n358\t    }\n359\t    _write_event(event)\n360\t\n361\t\n362\tdef emit_lesson_archived(\n363\t    lesson_id: str,\n364\t    archetype: str,\n365\t    hit_count: int,\n366\t    miss_count: int,\n367\t    hit_rate: float,\n368\t    archive_path: str,\n369\t    reason: str = \"low_hit_rate\",\n370\t    session_id: str = \"\",\n371\t    project: str = \"\",\n372\t) -> None:\n373\t    \"\"\"Emit a lesson_archived event (Sprint 8 Phase 4).\n374\t\n375\t    Logged by `prune-lessons.py --execute` when a lesson meets prune\n376\t    criteria (ADR-017, amended Sprint 8) and is moved to archive.\n377\t    Archive is reversible via `lesson-restore.py`.\n378\t\n379\t    ``hit_rate_bps`` is integer basis-points (hit_rate × 1000, clamped\n380\t    0..1000). canonical_json forbids floats in HMAC-covered fields; the\n381\t    old ``hit_rate`` float caused CanonicalJsonError + dropped events.\n382\t    Caller passes the raw 0..1 float; we convert here.\n383\t    \"\"\"\n384\t    bps = max(0, min(1000, int(round(hit_rate * 1000))))\n385\t    event: Dict[str, Any] = {\n386\t        \"action\": \"lesson_archived\",\n387\t        \"lesson_id\": lesson_id,\n388\t        \"archetype\": archetype,\n389\t        \"hit_count\": int(hit_count),\n390\t        \"miss_count\": int(miss_count),\n391\t        \"hit_rate_bps\": bps,\n392\t        \"archive_path\": archive_path,\n393\t        \"reason\": reason,\n394\t        \"session_id\": session_id,\n395\t        \"project\": project,\n396\t    }\n397\t    _write_event(event)\n398\t\n399\t\n400\tdef emit_lesson_restored(\n401\t    lesson_id: str,\n402\t    archetype: str,\n403\t    restored_from: str,\n404\t    restored_to: str,\n405\t    session_id: str = \"\",\n406\t    project: str = \"\",\n407\t) -> None:\n408\t    \"\"\"Emit a lesson_restored event (Sprint 8 Phase 4b).\n409\t\n410\t    Logged by `lesson-restore.py` when a previously archived lesson is\n411\t    moved back to the active lessons directory.\n412\t    \"\"\"\n413\t    event: Dict[str, Any] = {\n414\t        \"action\": \"lesson_restored\",\n415\t        \"lesson_id\": lesson_id,\n416\t        \"archetype\": archetype,\n417\t        \"restored_from\": restored_from,\n418\t        \"restored_to\": restored_to,\n419\t        \"session_id\": session_id,\n420\t        \"project\": project,\n421\t    }\n422\t    _write_event(event)\n423\t\n424\t\n425\tdef emit_lesson_outcome(\n426\t    lesson_id: str,\n427\t    archetype: str,\n428\t    hit: bool,\n429\t    hit_count: int = 0,\n430\t    miss_count: int = 0,\n431\t    session_id: str = \"\",\n432\t    project: str = \"\",\n433\t    consumer: str = \"benchmark\",\n434\t    inference_mode: str = \"\",\n435\t    window_duration_seconds: int = 0,\n436\t    session_end_reason: str = \"\",\n437\t) -> None:\n438\t    \"\"\"Emit a lesson_outcome event (Reflexion v2 / ADR-015).\n439\t\n440\t    Logged when a consumer (benchmark or architect) applies a lesson and\n441\t    the outcome is classified as hit / miss.\n442\t\n443\t    PLAN-009 P3.2/P3.5 (ADR-015 amendment) adds:\n444\t\n445\t    - ``consumer`` — closed enum {\"benchmark\", \"architect\"}. Back-compat:\n446\t      pre-Sprint-9 events missing this field are parsed as \"benchmark\"\n447\t      (single-consumer era default). SPEC/v1/audit-log.schema.md v2.2.2.\n448\t    - ``inference_mode`` — \"window-only\" | \"session-correlated\" |\n449\t      \"\" (legacy). Architect paths use \"session-correlated\"; older\n450\t      benchmarks retain \"window-only\" retroactively.\n451\t    - ``window_duration_seconds`` — how wide a window the outcome was\n452\t      attributed across (0 = not-applicable / benchmark).\n453\t    - ``session_end_reason`` — \"timeout\" | \"explicit\" | \"unknown\" | \"\".\n454\t\n455\t    `event_schema` stays \"v2\" — additive per ADR-011 pattern.\n456\t    \"\"\"\n457\t    event: Dict[str, Any] = {\n458\t        \"action\": \"lesson_outcome\",\n459\t        \"lesson_id\": lesson_id,\n460\t        \"archetype\": archetype,\n461\t        \"hit\": bool(hit),\n462\t        \"hit_count\": int(hit_count),\n463\t        \"miss_count\": int(miss_count),\n464\t        \"session_id\": session_id,\n465\t        \"project\": project,\n466\t        \"consumer\": consumer,\n467\t        \"inference_mode\": inference_mode,\n468\t        \"window_duration_seconds\": int(window_duration_seconds),\n469\t        \"session_end_reason\": session_end_reason,\n470\t    }\n471\t    _write_event(event)\n472\t\n473\t\n474\tdef emit_state_store_write(\n475\t    store_name: str,\n476\t    plan_id_hash: str,\n477\t    key_hash: str,\n478\t    value_bytes: int,\n479\t    ttl_seconds: Optional[int] = None,\n480\t    redaction_applied: bool = False,\n481\t    session_id: str = \"\",\n482\t    project: str = \"\",\n483\t) -> None:\n484\t    \"\"\"Emit a state_store write event (Sprint 11 Phase 0, ADR-027).\n485\t\n486\t    ``plan_id_hash`` and ``key_hash`` are SHA-256 prefixes (16 chars) —\n487\t    plaintext plan_id/key is never audited. ``redaction_applied`` is True\n488\t    if ``redact_secrets`` mutated the original string value.\n489\t\n490\t    Args:\n491\t        store_name: short store slug (e.g. \"scratchpad\").\n492\t        plan_id_hash: 16-char SHA-256 prefix of PLAN-NNN string.\n493\t        key_hash: 16-char SHA-256 prefix of the key.\n494\t        value_bytes: size of the stored value (post-redaction) in bytes.\n495\t        ttl_seconds: None if no TTL; int seconds-from-now otherwise.\n496\t        redaction_applied: True if ``redact_secrets`` changed the value.\n497\t    \"\"\"\n498\t    event: Dict[str, Any] = {\n499\t        \"action\": \"state_store_write\",\n500\t        \"store_name\": store_name,\n501\t        \"plan_id_hash\": plan_id_hash,\n502\t        \"key_hash\": key_hash,\n503\t        \"value_bytes\": int(value_bytes),\n504\t        \"ttl_seconds\": int(ttl_seconds) if ttl_seconds is not None else None,\n505\t        \"redaction_applied\": bool(redaction_applied),\n506\t        \"session_id\": session_id,\n507\t        \"project\": project,\n508\t    }\n509\t    _write_event(event)\n510\t\n511\t\n512\tdef emit_state_store_read(\n513\t    store_name: str,\n514\t    plan_id_hash: str,\n515\t    key_hash: str,\n516\t    found: bool,\n517\t    session_id: str = \"\",\n518\t    project: str = \"\",\n519\t) -> None:\n520\t    \"\"\"Emit a state_store read event (Sprint 11 Phase 0, ADR-027).\n521\t\n522\t    ``found=False`` covers both missing-key and expired-TTL — the\n523\t    consumer can correlate with subsequent prune events to tell them\n524\t    apart if needed.\n525\t    \"\"\"\n526\t    event: Dict[str, Any] = {\n527\t        \"action\": \"state_store_read\",\n528\t        \"store_name\": store_name,\n529\t        \"plan_id_hash\": plan_id_hash,\n530\t        \"key_hash\": key_hash,\n531\t        \"found\": bool(found),\n532\t        \"session_id\": session_id,\n533\t        \"project\": project,\n534\t    }\n535\t    _write_event(event)\n536\t\n537\t\n538\tdef emit_budget_exceeded(\n539\t    plan_id: str,\n540\t    spawn_id: str,\n541\t    tokens_used: int,\n542\t    cap: int,\n543\t    scope: str = \"spawn\",\n544\t    session_id: str = \"\",\n545\t    project: str = \"\",\n546\t) -> None:\n547\t    \"\"\"Emit a budget_exceeded event (Sprint 11 Phase 6, ADR-033).\n548\t\n549\t    Fired by ``check_budget.py`` when a spawn or plan rollup exceeds the\n550\t    configured cap. Advisory in Sprint 11 (enforcing Sprint 12 IFF FPR\n551\t    data supports it per H16).\n552\t\n553\t    Args:\n554\t        plan_id: PLAN-NNN string (unhashed; plan-level budgets are\n555\t            Owner-visible).\n556\t        spawn_id: session-local spawn identifier or ``\"\"`` for plan-scope.\n557\t        tokens_used: post-spawn running total.\n558\t        cap: configured cap (e.g. CEO_MAX_SPAWN_TOKENS).\n559\t        scope: ``\"spawn\"`` | ``\"plan\"``.\n560\t    \"\"\"\n561\t    event: Dict[str, Any] = {\n562\t        \"action\": \"budget_exceeded\",\n563\t        \"plan_id\": plan_id,\n564\t        \"spawn_id\": spawn_id,\n565\t        \"tokens_used\": int(tokens_used),\n566\t        \"cap\": int(cap),\n567\t        \"scope\": scope,\n568\t        \"session_id\": session_id,\n569\t        \"project\": project,\n570\t    }\n571\t    _write_event(event)\n572\t\n573\t\n574\tdef emit_budget_bypass_used(\n575\t    plan_id: str,\n576\t    caller_pid: int,\n577\t    reason: str = \"\",\n578\t    session_id: str = \"\",\n579\t    project: str = \"\",\n580\t) -> None:\n581\t    \"\"\"Emit a budget_bypass_used event (Sprint 11 Phase 6, H13).\n582\t\n583\t    Fired when ``CEO_BUDGET_BYPASS=1`` is honored on a blocked spawn.\n584\t    Owner-only scope (H13 mirrors ADR-019 C6/A8). Rate-limited to N\n585\t    bypasses / 24h — caller enforces the counter; this emitter just\n586\t    records the event. ``reason`` is a short free-text preview (e.g.\n587\t    ``\"emergency: prod down\"``).\n588\t    \"\"\"\n589\t    event: Dict[str, Any] = {\n590\t        \"action\": \"budget_bypass_used\",\n591\t        \"plan_id\": plan_id,\n592\t        \"caller_pid\": int(caller_pid),\n593\t        \"reason_preview\": _preview(reason, max_len=120),\n594\t        \"session_id\": session_id,\n595\t        \"project\": project,\n596\t    }\n597\t    _write_event(event)\n598\t\n599\t\n600\tdef emit_otel_export_dropped(\n601\t    fields_dropped_count: int,\n602\t    endpoint_host: str = \"\",\n603\t    reason: str = \"\",\n604\t    session_id: str = \"\",\n605\t    project: str = \"\",\n606\t) -> None:\n607\t    \"\"\"Emit an otel_export_dropped event (Sprint 11 Phase 8, CR3).\n608\t\n609\t    Fired by ``otel-export.py`` when ``redact_secrets`` removes a field\n610\t    from a span attribute OR when host allowlist rejects a target. The\n611\t    endpoint is recorded as host-only (no URL path, no query). Full\n612\t    endpoint URL is NEVER audited (defense-in-depth).\n613\t    \"\"\"\n614\t    event: Dict[str, Any] = {\n615\t        \"action\": \"otel_export_dropped\",\n616\t        \"fields_dropped_count\": int(fields_dropped_count),\n617\t        \"endpoint_host\": endpoint_host,\n618\t        \"reason\": reason,\n619\t        \"session_id\": session_id,\n620\t        \"project\": project,\n621\t    }\n622\t    _write_event(event)\n623\t\n624\t\n625\tdef emit_output_safety_flag(\n626\t    source: str,\n627\t    family_counts: Dict[str, int],\n628\t    match_count: int,\n629\t    bytes_scanned: int,\n630\t    redaction_applied: bool = False,\n631\t    triggered_by_tool: str = \"\",\n632\t    snippet_preview: str = \"\",\n633\t    truncated: bool = False,\n634\t    session_id: str = \"\",\n635\t    project: str = \"\",\n636\t) -> None:\n637\t    \"\"\"Emit an output_safety_flag event (Sprint 11 Phase 9, ADR-036).\n638\t\n639\t    Shape mirrors ``injection_flag`` (ADR-011) but scans agent outputs\n640\t    instead of inputs (PostToolUse Agent). Advisory Sprint 11. See\n641\t    consensus H14 for scanner pipeline order.\n642\t    \"\"\"\n643\t    event: Dict[str, Any] = {\n644\t        \"action\": \"output_safety_flag\",\n645\t        \"source\": source,\n646\t        \"family_counts\": dict(family_counts),\n647\t        \"match_count\": int(match_count),\n648\t        \"bytes_scanned\": int(bytes_scanned),\n649\t        \"redaction_applied\": bool(redaction_applied),\n650\t        \"truncated\": bool(truncated),\n651\t        \"triggered_by_tool\": triggered_by_tool,\n652\t        \"snippet_preview\": _preview(snippet_preview, max_len=200),\n653\t        \"session_id\": session_id,\n654\t        \"project\": project,\n655\t    }\n656\t    _write_event(event)\n657\t"}]},"parent_tool_use_id":null,"session_id":"6ecec1be-c9f5-46ca-a77f-82706eb464cc","uuid":"23338ba2-a0c7-47b7-9a76-e675d8a62e05","timestamp":"2026-11-16T18:58:05.780Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/workflow.py","content":"\"\"\"Workflow.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('emit_debate_event', 'emit_plan_transition', 'emit_veto_triggered', 'emit_benchmark_run', '_EVAL_TASK_COMPLETED_ALLOWLIST', 'emit_eval_task_completed', 'emit_injection_flag', 'emit_lesson_write', 'emit_confidence_gate', 'emit_lesson_read', 'emit_lesson_archived', 'emit_lesson_restored', 'emit_lesson_outcome', 'emit_state_store_write', 'emit_state_store_read', 'emit_budget_exceeded', 'emit_budget_bypass_used', 'emit_otel_export_dropped', 'emit_output_safety_flag')\n\n# -----------------------------------------------------------------------------\n# Public emitters\n# -----------------------------------------------------------------------------\n\n\ndef emit_debate_event(\n    plan_id: str,\n    round_num: int,\n    phase: str,\n    agent: str,\n    artifact_path: Optional[str] = None,\n    consensus_adjustments_count: Optional[int] = None,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a debate round event.\n\n    Args:\n        plan_id: e.g. \"PLAN-004\"\n        round_num: 1–3\n        phase: \"start\" | \"agent-done\" | \"consensus\"\n        agent: archetype slug (vp-engineering, security-engineer, etc.) or \"consensus\"\n        artifact_path: path to the critique/consensus file\n        consensus_adjustments_count: set only on phase=\"consensus\"\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"debate_event\",\n        \"plan_id\": plan_id,\n        \"round\": round_num,\n        \"phase\": phase,\n        \"agent\": agent,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    if artifact_path is not None:\n        event[\"artifact_path\"] = artifact_path\n    if consensus_adjustments_count is not None:\n        event[\"consensus_adjustments_count\"] = consensus_adjustments_count\n    _write_event(event)\n\n\ndef emit_plan_transition(\n    plan_id: str,\n    from_status: str,\n    to_status: str,\n    file_path: str,\n    editor_tool: str = \"Edit\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a legal plan status transition event.\n\n    Illegal transitions are blocked by check_plan_edit.py and emit a\n    veto_triggered event instead.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"plan_transition\",\n        \"plan_id\": plan_id,\n        \"from_status\": from_status,\n        \"to_status\": to_status,\n        \"editor_tool\": editor_tool,\n        \"file_path\": file_path,\n        \"transition_legal\": True,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_veto_triggered(\n    hook: str,\n    reason_code: str,\n    reason_preview: str,\n    blocked_tool: str = \"\",\n    strike_count: Optional[int] = None,\n    session_id: str = \"\",\n    project: str = \"\",\n    caller: str = \"\",\n) -> None:\n    \"\"\"Emit a veto / block event from any governance hook.\n\n    Args:\n        hook: \"check_agent_spawn\" | \"check_plan_edit\" | \"check_bash_safety\"\n        reason_code: machine-readable rule identifier (e.g. \"missing_skill_content\")\n        reason_preview: human-readable summary (redacted + truncated)\n        blocked_tool: tool call that was blocked\n        strike_count: session-scoped count (if tracked)\n        caller: identity of the spawning agent or \"ceo\" (kernel events\n            require this for forensic traceability — schema v2.14)\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"veto_triggered\",\n        \"hook\": hook,\n        \"reason_code\": reason_code,\n        \"reason_preview\": _preview(reason_preview),\n        \"blocked_tool\": blocked_tool,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    if strike_count is not None:\n        event[\"strike_count\"] = strike_count\n    if caller:\n        event[\"caller\"] = caller\n    _write_event(event)\n\n\ndef emit_benchmark_run(\n    benchmark_id: str,\n    skill: str,\n    pass_count: int,\n    fail_count: int,\n    pass_rate: float,\n    median_score: float,\n    floor: float,\n    cost_usd: float = 0.0,\n    duration_s: float = 0.0,\n    lessons_written: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a benchmark run completion event.\n\n    Float fields are encoded as integers to satisfy the canonical_json\n    no-float invariant on HMAC-covered audit events:\n\n    - ``pass_rate``    → ``pass_rate_bps``    (rate × 1000, 0..1000)\n    - ``median_score`` → ``median_score_bps`` (score × 1000, 0..1000)\n    - ``floor``        → ``floor_bps``        (rate × 1000, 0..1000)\n    - ``cost_usd``     → ``cost_usd_cents``   (USD × 100, ≥0)\n    - ``duration_s``   → ``duration_ms``      (seconds × 1000, ≥0)\n\n    Readers must divide by the respective denominator to recover the\n    original scale.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"benchmark_run\",\n        \"benchmark_id\": benchmark_id,\n        \"skill\": skill,\n        \"pass_count\": int(pass_count),\n        \"fail_count\": int(fail_count),\n        \"pass_rate_bps\": max(0, min(1000, int(round(float(pass_rate) * 1000)))),\n        \"median_score_bps\": max(0, min(1000, int(round(float(median_score) * 1000)))),\n        \"floor_bps\": max(0, min(1000, int(round(float(floor) * 1000)))),\n        \"cost_usd_cents\": max(0, int(round(float(cost_usd) * 100))),\n        \"duration_ms\": max(0, int(round(float(duration_s) * 1000))),\n        \"lessons_written\": int(lessons_written),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\n# PLAN-133 C3 — Sec MF-3 field allowlist for eval_task_completed. Closed set;\n# anything outside it is dropped by _scrub (see emit_generic dispatch below).\n_EVAL_TASK_COMPLETED_ALLOWLIST = frozenset({\n    \"action\", \"task_id\", \"reward_bps\", \"status\", \"attempts\",\n    \"flaky\", \"tokens\", \"turns\", \"event_schema\", \"ts\",\n})\n\n\ndef emit_eval_task_completed(\n    task_id: str,\n    reward: float,\n    status: str = \"\",\n    attempts: int = 0,\n    flaky: bool = False,\n    tokens: int = 0,\n    turns: int = 0,\n) -> None:\n    \"\"\"Emit one real-task reward-benchmark result (PLAN-133 C3).\n\n    NO-VALUE-ECHO contract: the only free-text inputs are ``task_id`` (a stable\n    task slug from .claude/eval/tasks/, NOT user/model content) and ``status``\n    (coerced to the closed trial-status enum). No rejected env value, egress\n    destination, retry_delay, or model output is ever carried. ``reward`` is\n    encoded as basis-points (``reward_bps`` 0..1000) to satisfy the canonical_json\n    no-float invariant; ``flaky`` is encoded as 0/1.\n    \"\"\"\n    status_norm = status if status in (\"pass\", \"partial\", \"fail\") else \"other\"\n    event: Dict[str, Any] = {\n        \"action\": \"eval_task_completed\",\n        \"task_id\": str(task_id)[:64],\n        \"reward_bps\": max(0, min(1000, int(round(float(reward) * 1000)))),\n        \"status\": status_norm,\n        \"attempts\": max(0, int(attempts)),\n        \"flaky\": 1 if flaky else 0,\n        \"tokens\": max(0, int(tokens)),\n        \"turns\": max(0, int(turns)),\n    }\n    _write_event(event)\n\n\ndef emit_injection_flag(\n    source: str,\n    family_counts: Dict[str, int],\n    match_count: int,\n    bytes_scanned: int,\n    triggered_by_tool: str = \"\",\n    snippet_preview: str = \"\",\n    truncated: bool = False,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a prompt-injection flag event (v2.1, ADR-011).\n\n    Always advisory: this event records observation, never enforces a\n    block. The PreToolUse hook `check_read_injection.py` calls this\n    after running scan_text on a Read result; the audit-query.py\n    `vetoes` and `metrics` sub-commands surface aggregated counts.\n\n    Args:\n        source: file path / \"<stdin>\" / tool input identifier\n        family_counts: per-family hit counts (e.g. {\"direct_override\": 2})\n        match_count: total matches across families\n        bytes_scanned: bytes the scanner inspected (bounded at 1 MiB)\n        triggered_by_tool: e.g. \"Read\", \"Bash\"\n        snippet_preview: redacted snippet of the highest-confidence hit\n        truncated: True if input exceeded scanner cap\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"injection_flag\",\n        \"source\": source,\n        \"family_counts\": dict(family_counts),\n        \"match_count\": int(match_count),\n        \"bytes_scanned\": int(bytes_scanned),\n        \"truncated\": bool(truncated),\n        \"triggered_by_tool\": triggered_by_tool,\n        \"snippet_preview\": _preview(snippet_preview, max_len=200),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_lesson_write(\n    lesson_id: str,\n    archetype: str,\n    scope_tags: List[str],\n    trigger: str,\n    source_event_id: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a lesson-write event (Reflexion corpus growth).\n\n    Args:\n        lesson_id: stable identifier (e.g. hash or ULID)\n        archetype: owning archetype slug\n        scope_tags: scope tag list (subset of skill scope_tags)\n        trigger: \"benchmark_fail\" | \"debate_adjustment\" | \"manual\"\n        source_event_id: correlation to the originating event (desc_hash or artifact_path)\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"lesson_write\",\n        \"lesson_id\": lesson_id,\n        \"archetype\": archetype,\n        \"scope_tags\": list(scope_tags),\n        \"trigger\": trigger,\n        \"source_event_id\": source_event_id,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_confidence_gate(\n    claim_count: int,\n    pass_count: int,\n    fail_count: int,\n    verifier_kind_counts: Dict[str, int],\n    agent_name: str = \"\",\n    source: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n    raw_claim_count: Optional[int] = None,\n    truncated: bool = False,\n) -> None:\n    \"\"\"Emit a confidence_gate event (Sprint 8 Phase 2, ADR-018).\n\n    Advisory-only in Sprint 8: collects FPR baseline for Sprint 9 enforcement\n    decision. Reserved fields set from day 1 (debate consensus C4).\n\n    Sprint 9 (PLAN-009 A12) adds ``raw_claim_count`` + ``truncated`` for\n    ``CEO_CONFIDENCE_MAX_CLAIMS`` cap reporting. When the input produced\n    more CLAIM tokens than the cap, ``claim_count`` is the post-cap value,\n    ``raw_claim_count`` is the pre-cap count, and ``truncated=True``.\n\n    Args:\n        claim_count: verified CLAIM tokens (post code-block exemption + cap)\n        pass_count: claims that verified\n        fail_count: claims that failed to verify\n        verifier_kind_counts: dict of claim kind -> count (all kinds seen)\n        agent_name: name of the agent whose output was scanned (optional)\n        source: \"stdin\" | \"<file path>\" | \"<spawn-ref>\"\n        raw_claim_count: pre-cap CLAIM token count; defaults to claim_count\n            when the caller did not surface a cap\n        truncated: True when raw_claim_count > claim_count\n    \"\"\"\n    if raw_claim_count is None:\n        raw_claim_count = int(claim_count)\n    event: Dict[str, Any] = {\n        \"action\": \"confidence_gate\",\n        \"claim_count\": int(claim_count),\n        \"raw_claim_count\": int(raw_claim_count),\n        \"truncated\": bool(truncated),\n        \"pass_count\": int(pass_count),\n        \"fail_count\": int(fail_count),\n        \"verifier_kind_counts\": dict(verifier_kind_counts),\n        \"agent_name\": agent_name,\n        \"source\": source,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_lesson_read(\n    lesson_ids: List[str],\n    archetype: str,\n    keywords: List[str],\n    k: int,\n    consumer: str = \"architect\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a lesson_read event (Sprint 8 Phase 3).\n\n    Logged when `lessons.get_top_k()` is invoked to inject top-K lessons\n    into a spawn prompt. Enables Sprint 9 outcome-tracking integration\n    (correlating which injected lessons correlated with benchmark hits).\n\n    Args:\n        lesson_ids: list of lesson IDs that were read (length <= k)\n        archetype: archetype that the lessons were queried for\n        keywords: keywords used for ranking\n        k: requested top-K count\n        consumer: \"architect\" | \"spawn\" | \"cli\"\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"lesson_read\",\n        \"lesson_ids\": list(lesson_ids),\n        \"lesson_count\": len(lesson_ids),\n        \"archetype\": archetype,\n        \"keywords\": list(keywords),\n        \"k\": int(k),\n        \"consumer\": consumer,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_lesson_archived(\n    lesson_id: str,\n    archetype: str,\n    hit_count: int,\n    miss_count: int,\n    hit_rate: float,\n    archive_path: str,\n    reason: str = \"low_hit_rate\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a lesson_archived event (Sprint 8 Phase 4).\n\n    Logged by `prune-lessons.py --execute` when a lesson meets prune\n    criteria (ADR-017, amended Sprint 8) and is moved to archive.\n    Archive is reversible via `lesson-restore.py`.\n\n    ``hit_rate_bps`` is integer basis-points (hit_rate × 1000, clamped\n    0..1000). canonical_json forbids floats in HMAC-covered fields; the\n    old ``hit_rate`` float caused CanonicalJsonError + dropped events.\n    Caller passes the raw 0..1 float; we convert here.\n    \"\"\"\n    bps = max(0, min(1000, int(round(hit_rate * 1000))))\n    event: Dict[str, Any] = {\n        \"action\": \"lesson_archived\",\n        \"lesson_id\": lesson_id,\n        \"archetype\": archetype,\n        \"hit_count\": int(hit_count),\n        \"miss_count\": int(miss_count),\n        \"hit_rate_bps\": bps,\n        \"archive_path\": archive_path,\n        \"reason\": reason,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_lesson_restored(\n    lesson_id: str,\n    archetype: str,\n    restored_from: str,\n    restored_to: str,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a lesson_restored event (Sprint 8 Phase 4b).\n\n    Logged by `lesson-restore.py` when a previously archived lesson is\n    moved back to the active lessons directory.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"lesson_restored\",\n        \"lesson_id\": lesson_id,\n        \"archetype\": archetype,\n        \"restored_from\": restored_from,\n        \"restored_to\": restored_to,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_lesson_outcome(\n    lesson_id: str,\n    archetype: str,\n    hit: bool,\n    hit_count: int = 0,\n    miss_count: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n    consumer: str = \"benchmark\",\n    inference_mode: str = \"\",\n    window_duration_seconds: int = 0,\n    session_end_reason: str = \"\",\n) -> None:\n    \"\"\"Emit a lesson_outcome event (Reflexion v2 / ADR-015).\n\n    Logged when a consumer (benchmark or architect) applies a lesson and\n    the outcome is classified as hit / miss.\n\n    PLAN-009 P3.2/P3.5 (ADR-015 amendment) adds:\n\n    - ``consumer`` — closed enum {\"benchmark\", \"architect\"}. Back-compat:\n      pre-Sprint-9 events missing this field are parsed as \"benchmark\"\n      (single-consumer era default). SPEC/v1/audit-log.schema.md v2.2.2.\n    - ``inference_mode`` — \"window-only\" | \"session-correlated\" |\n      \"\" (legacy). Architect paths use \"session-correlated\"; older\n      benchmarks retain \"window-only\" retroactively.\n    - ``window_duration_seconds`` — how wide a window the outcome was\n      attributed across (0 = not-applicable / benchmark).\n    - ``session_end_reason`` — \"timeout\" | \"explicit\" | \"unknown\" | \"\".\n\n    `event_schema` stays \"v2\" — additive per ADR-011 pattern.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"lesson_outcome\",\n        \"lesson_id\": lesson_id,\n        \"archetype\": archetype,\n        \"hit\": bool(hit),\n        \"hit_count\": int(hit_count),\n        \"miss_count\": int(miss_count),\n        \"session_id\": session_id,\n        \"project\": project,\n        \"consumer\": consumer,\n        \"inference_mode\": inference_mode,\n        \"window_duration_seconds\": int(window_duration_seconds),\n        \"session_end_reason\": session_end_reason,\n    }\n    _write_event(event)\n\n\ndef emit_state_store_write(\n    store_name: str,\n    plan_id_hash: str,\n    key_hash: str,\n    value_bytes: int,\n    ttl_seconds: Optional[int] = None,\n    redaction_applied: bool = False,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a state_store write event (Sprint 11 Phase 0, ADR-027).\n\n    ``plan_id_hash`` and ``key_hash`` are SHA-256 prefixes (16 chars) —\n    plaintext plan_id/key is never audited. ``redaction_applied`` is True\n    if ``redact_secrets`` mutated the original string value.\n\n    Args:\n        store_name: short store slug (e.g. \"scratchpad\").\n        plan_id_hash: 16-char SHA-256 prefix of PLAN-NNN string.\n        key_hash: 16-char SHA-256 prefix of the key.\n        value_bytes: size of the stored value (post-redaction) in bytes.\n        ttl_seconds: None if no TTL; int seconds-from-now otherwise.\n        redaction_applied: True if ``redact_secrets`` changed the value.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"state_store_write\",\n        \"store_name\": store_name,\n        \"plan_id_hash\": plan_id_hash,\n        \"key_hash\": key_hash,\n        \"value_bytes\": int(value_bytes),\n        \"ttl_seconds\": int(ttl_seconds) if ttl_seconds is not None else None,\n        \"redaction_applied\": bool(redaction_applied),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_state_store_read(\n    store_name: str,\n    plan_id_hash: str,\n    key_hash: str,\n    found: bool,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a state_store read event (Sprint 11 Phase 0, ADR-027).\n\n    ``found=False`` covers both missing-key and expired-TTL — the\n    consumer can correlate with subsequent prune events to tell them\n    apart if needed.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"state_store_read\",\n        \"store_name\": store_name,\n        \"plan_id_hash\": plan_id_hash,\n        \"key_hash\": key_hash,\n        \"found\": bool(found),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_budget_exceeded(\n    plan_id: str,\n    spawn_id: str,\n    tokens_used: int,\n    cap: int,\n    scope: str = \"spawn\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a budget_exceeded event (Sprint 11 Phase 6, ADR-033).\n\n    Fired by ``check_budget.py`` when a spawn or plan rollup exceeds the\n    configured cap. Advisory in Sprint 11 (enforcing Sprint 12 IFF FPR\n    data supports it per H16).\n\n    Args:\n        plan_id: PLAN-NNN string (unhashed; plan-level budgets are\n            Owner-visible).\n        spawn_id: session-local spawn identifier or ``\"\"`` for plan-scope.\n        tokens_used: post-spawn running total.\n        cap: configured cap (e.g. CEO_MAX_SPAWN_TOKENS).\n        scope: ``\"spawn\"`` | ``\"plan\"``.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"budget_exceeded\",\n        \"plan_id\": plan_id,\n        \"spawn_id\": spawn_id,\n        \"tokens_used\": int(tokens_used),\n        \"cap\": int(cap),\n        \"scope\": scope,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_budget_bypass_used(\n    plan_id: str,\n    caller_pid: int,\n    reason: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a budget_bypass_used event (Sprint 11 Phase 6, H13).\n\n    Fired when ``CEO_BUDGET_BYPASS=1`` is honored on a blocked spawn.\n    Owner-only scope (H13 mirrors ADR-019 C6/A8). Rate-limited to N\n    bypasses / 24h — caller enforces the counter; this emitter just\n    records the event. ``reason`` is a short free-text preview (e.g.\n    ``\"emergency: prod down\"``).\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"budget_bypass_used\",\n        \"plan_id\": plan_id,\n        \"caller_pid\": int(caller_pid),\n        \"reason_preview\": _preview(reason, max_len=120),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_otel_export_dropped(\n    fields_dropped_count: int,\n    endpoint_host: str = \"\",\n    reason: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit an otel_export_dropped event (Sprint 11 Phase 8, CR3).\n\n    Fired by ``otel-export.py`` when ``redact_secrets`` removes a field\n    from a span attribute OR when host allowlist rejects a target. The\n    endpoint is recorded as host-only (no URL path, no query). Full\n    endpoint URL is NEVER audited (defense-in-depth).\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"otel_export_dropped\",\n        \"fields_dropped_count\": int(fields_dropped_count),\n        \"endpoint_host\": endpoint_host,\n        \"reason\": reason,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_output_safety_flag(\n    source: str,\n    family_counts: Dict[str, int],\n    match_count: int,\n    bytes_scanned: int,\n    redaction_applied: bool = False,\n    triggered_by_tool: str = \"\",\n    snippet_preview: str = \"\",\n    truncated: bool = False,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit an output_safety_flag event (Sprint 11 Phase 9, ADR-036).\n\n    Shape mirrors ``injection_flag`` (ADR-011) but scans agent outputs\n    instead of inputs (PostToolUse Agent). Advisory Sprint 11. See\n    consensus H14 for scanner pipeline order.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"output_safety_flag\",\n        \"source\": source,\n        \"family_counts\": dict(family_counts),\n        \"match_count\": int(match_count),\n        \"bytes_scanned\": int(bytes_scanned),\n        \"redaction_applied\": bool(redaction_applied),\n        \"truncated\": bool(truncated),\n        \"triggered_by_tool\": triggered_by_tool,\n        \"snippet_preview\": _preview(snippet_preview, max_len=200),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n","numLines":657,"startLine":1,"totalLines":657}},"tool_result_meta":[{"id":"toolu_01TutMMbdMhChRS45ZwhBSMF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
