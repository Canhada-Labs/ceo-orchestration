{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XNwiYtpHeh3Q21hVynJDFi","type":"tool_result","content":"1\t\"\"\"Resource events.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('emit_skill_patch_applied', 'emit_squad_imported', 'emit_state_store_pruned', 'emit_lesson_outcome_undone')\n9\t\n10\tdef emit_skill_patch_applied(\n11\t    proposal_id: str,\n12\t    skill_slug: str,\n13\t    commit_sha: str,\n14\t    signer_fingerprint: str = \"\",\n15\t    shadow_mode: bool = False,\n16\t    session_id: str = \"\",\n17\t    project: str = \"\",\n18\t) -> None:\n19\t    \"\"\"Emit a skill_patch_applied event (Sprint 11 Phase 4, ADR-031).\n20\t\n21\t    Fired by ``skill-patch-apply.py`` when a proposal is merged via\n22\t    signed Owner approval. ``shadow_mode=True`` during the 7-day shadow\n23\t    period per CR1; ``False`` after promotion to real SKILL.md.\n24\t    \"\"\"\n25\t    event: Dict[str, Any] = {\n26\t        \"action\": \"skill_patch_applied\",\n27\t        \"proposal_id\": proposal_id,\n28\t        \"skill_slug\": skill_slug,\n29\t        \"commit_sha\": commit_sha,\n30\t        \"signer_fingerprint\": signer_fingerprint,\n31\t        \"shadow_mode\": bool(shadow_mode),\n32\t        \"session_id\": session_id,\n33\t        \"project\": project,\n34\t    }\n35\t    _write_event(event)\n36\t\n37\t\n38\tdef emit_squad_imported(\n39\t    squad_name: str,\n40\t    manifest_sha256: str,\n41\t    signer_fingerprint: str = \"\",\n42\t    source: str = \"\",\n43\t    session_id: str = \"\",\n44\t    project: str = \"\",\n45\t) -> None:\n46\t    \"\"\"Emit a squad_imported event (Sprint 11 Phase 12, CR2).\n47\t\n48\t    Fired by ``squad-import.py`` after signature verification passes.\n49\t    ``source`` is the pin-allowlist entry (e.g.\n50\t    ``\"github.com/acme/squad-edtech@v1\"``).\n51\t    \"\"\"\n52\t    event: Dict[str, Any] = {\n53\t        \"action\": \"squad_imported\",\n54\t        \"squad_name\": squad_name,\n55\t        \"manifest_sha256\": manifest_sha256,\n56\t        \"signer_fingerprint\": signer_fingerprint,\n57\t        \"source\": source,\n58\t        \"session_id\": session_id,\n59\t        \"project\": project,\n60\t    }\n61\t    _write_event(event)\n62\t\n63\t\n64\tdef emit_state_store_pruned(\n65\t    store_name: str,\n66\t    plan_id_hash: str,\n67\t    keys_pruned_count: int,\n68\t    session_id: str = \"\",\n69\t    project: str = \"\",\n70\t) -> None:\n71\t    \"\"\"Emit a state_store prune event (Sprint 11 Phase 0, ADR-027).\n72\t\n73\t    Emitted by ``SqliteStateStore.prune_expired()`` (TTL sweep) and\n74\t    ``clear_plan()`` (plan rollback). A single event covers a batch.\n75\t    \"\"\"\n76\t    event: Dict[str, Any] = {\n77\t        \"action\": \"state_store_pruned\",\n78\t        \"store_name\": store_name,\n79\t        \"plan_id_hash\": plan_id_hash,\n80\t        \"keys_pruned_count\": int(keys_pruned_count),\n81\t        \"session_id\": session_id,\n82\t        \"project\": project,\n83\t    }\n84\t    _write_event(event)\n85\t\n86\t\n87\tdef emit_lesson_outcome_undone(\n88\t    lesson_id: str,\n89\t    archetype: str,\n90\t    consumer: str,\n91\t    undone_kind: str,\n92\t    hit_count: int = 0,\n93\t    miss_count: int = 0,\n94\t    session_id: str = \"\",\n95\t    project: str = \"\",\n96\t) -> None:\n97\t    \"\"\"Emit a lesson_outcome_undone event (PLAN-009 P3.3, schema v2.3).\n98\t\n99\t    Admin-facing escape hatch for reversing a bad attribution. Emitted\n100\t    by `lessons.undo_outcome()` after the decrement is persisted.\n101\t\n102\t    ``undone_kind`` is \"hit\" or \"miss\" — which counter was decremented.\n103\t    \"\"\"\n104\t    event: Dict[str, Any] = {\n105\t        \"action\": \"lesson_outcome_undone\",\n106\t        \"lesson_id\": lesson_id,\n107\t        \"archetype\": archetype,\n108\t        \"consumer\": consumer,\n109\t        \"undone_kind\": undone_kind,\n110\t        \"hit_count\": int(hit_count),\n111\t        \"miss_count\": int(miss_count),\n112\t        \"session_id\": session_id,\n113\t        \"project\": project,\n114\t    }\n115\t    _write_event(event)\n116\t"}]},"parent_tool_use_id":null,"session_id":"6ecec1be-c9f5-46ca-a77f-82706eb464cc","uuid":"43959d45-11ea-40fb-8da5-977e5a7c0f6b","timestamp":"2026-11-16T18:58:12.059Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/resource_events.py","content":"\"\"\"Resource events.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('emit_skill_patch_applied', 'emit_squad_imported', 'emit_state_store_pruned', 'emit_lesson_outcome_undone')\n\ndef emit_skill_patch_applied(\n    proposal_id: str,\n    skill_slug: str,\n    commit_sha: str,\n    signer_fingerprint: str = \"\",\n    shadow_mode: bool = False,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a skill_patch_applied event (Sprint 11 Phase 4, ADR-031).\n\n    Fired by ``skill-patch-apply.py`` when a proposal is merged via\n    signed Owner approval. ``shadow_mode=True`` during the 7-day shadow\n    period per CR1; ``False`` after promotion to real SKILL.md.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"skill_patch_applied\",\n        \"proposal_id\": proposal_id,\n        \"skill_slug\": skill_slug,\n        \"commit_sha\": commit_sha,\n        \"signer_fingerprint\": signer_fingerprint,\n        \"shadow_mode\": bool(shadow_mode),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_squad_imported(\n    squad_name: str,\n    manifest_sha256: str,\n    signer_fingerprint: str = \"\",\n    source: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a squad_imported event (Sprint 11 Phase 12, CR2).\n\n    Fired by ``squad-import.py`` after signature verification passes.\n    ``source`` is the pin-allowlist entry (e.g.\n    ``\"github.com/acme/squad-edtech@v1\"``).\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"squad_imported\",\n        \"squad_name\": squad_name,\n        \"manifest_sha256\": manifest_sha256,\n        \"signer_fingerprint\": signer_fingerprint,\n        \"source\": source,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_state_store_pruned(\n    store_name: str,\n    plan_id_hash: str,\n    keys_pruned_count: int,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a state_store prune event (Sprint 11 Phase 0, ADR-027).\n\n    Emitted by ``SqliteStateStore.prune_expired()`` (TTL sweep) and\n    ``clear_plan()`` (plan rollback). A single event covers a batch.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"state_store_pruned\",\n        \"store_name\": store_name,\n        \"plan_id_hash\": plan_id_hash,\n        \"keys_pruned_count\": int(keys_pruned_count),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_lesson_outcome_undone(\n    lesson_id: str,\n    archetype: str,\n    consumer: str,\n    undone_kind: str,\n    hit_count: int = 0,\n    miss_count: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a lesson_outcome_undone event (PLAN-009 P3.3, schema v2.3).\n\n    Admin-facing escape hatch for reversing a bad attribution. Emitted\n    by `lessons.undo_outcome()` after the decrement is persisted.\n\n    ``undone_kind`` is \"hit\" or \"miss\" — which counter was decremented.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"lesson_outcome_undone\",\n        \"lesson_id\": lesson_id,\n        \"archetype\": archetype,\n        \"consumer\": consumer,\n        \"undone_kind\": undone_kind,\n        \"hit_count\": int(hit_count),\n        \"miss_count\": int(miss_count),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n","numLines":116,"startLine":1,"totalLines":116}},"tool_result_meta":[{"id":"toolu_01XNwiYtpHeh3Q21hVynJDFi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
