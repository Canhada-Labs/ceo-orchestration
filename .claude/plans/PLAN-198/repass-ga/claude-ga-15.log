{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014aVApREUkVXu1r7QuCPzdS","type":"tool_result","content":"1\t\"\"\"Security.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('emit_prompt_injection_detected', 'emit_ledger_entry_rejected', 'emit_session_memory_delta_observed', 'emit_secret_leak_detected', 'emit_pii_redacted_outgoing', 'emit_codex_egress_redacted', 'emit_pair_rail_outgoing_redaction_applied', 'emit_mcp_handler_invoked', 'emit_mcp_handler_denied', 'emit_mcp_cross_tenant_denied', 'emit_mcp_soak_fpr_breach')\n9\t\n10\tdef emit_prompt_injection_detected(\n11\t    *,\n12\t    signal: str = \"\",\n13\t    family: str = \"\",\n14\t    snippet_preview: str = \"\",\n15\t    match_count: int = 0,\n16\t    bytes_scanned: int = 0,\n17\t    triggered_by_tool: str = \"\",\n18\t    session_id: str = \"\",\n19\t    project: str = \"\",\n20\t    atlas_technique: Optional[str] = None,\n21\t) -> None:\n22\t    \"\"\"Emit prompt_injection_detected event (PLAN-085 G.1b / AML.T0051).\n23\t\n24\t    Detection of LLM prompt-injection patterns at hook/scanner layer.\n25\t    ``atlas_technique`` defaults to the immutable registry value;\n26\t    callers may override for sub-technique disambiguation.\n27\t    \"\"\"\n28\t    emit_generic(\n29\t        \"prompt_injection_detected\",\n30\t        atlas_technique=atlas_technique or _ATLAS_REGISTRY[\"prompt_injection_detected\"],\n31\t        signal=signal,\n32\t        family=family,\n33\t        snippet_preview=snippet_preview[:200],\n34\t        match_count=int(match_count),\n35\t        bytes_scanned=int(bytes_scanned),\n36\t        triggered_by_tool=triggered_by_tool,\n37\t        session_id=session_id,\n38\t        project=project,\n39\t    )\n40\t\n41\t\n42\tdef emit_ledger_entry_rejected(\n43\t    *,\n44\t    signal: str = \"\",\n45\t    decision: str = \"reject\",\n46\t    reason: str = \"\",\n47\t    family: str = \"\",\n48\t    hits_count: int = 0,\n49\t    bytes_scanned: int = 0,\n50\t    scanned: int = 0,\n51\t    enforced: int = 0,\n52\t    session_id: str = \"\",\n53\t    project: str = \"\",\n54\t) -> None:\n55\t    \"\"\"Emit ledger_entry_rejected (PLAN-179 W4 / ADR-195).\n56\t\n57\t    The ledger write-gate refused an externally-sourced entry fail-CLOSED.\n58\t    Called by ``_lib/ledger_provenance._emit_rejection``; the keyword names\n59\t    mirror ``GateVerdict.to_audit_fields()`` EXACTLY, because that caller\n60\t    splats the dict (``typed(**fields)``) and a signature mismatch would\n61\t    look like a raising emitter and degrade the rail silently.\n62\t\n63\t    Deliberately NO ``int()`` coercion here: the scrub branch is TYPE-strict\n64\t    and a float must become 0, not be rounded into the signed chain. The\n65\t    rejected entry BODY is not a parameter of this function at all — the\n66\t    gate never forwards it, not even truncated.\n67\t    \"\"\"\n68\t    emit_generic(\n69\t        \"ledger_entry_rejected\",\n70\t        signal=signal or _LEDGER_GATE_SIGNAL,\n71\t        decision=decision,\n72\t        reason=reason,\n73\t        family=family,\n74\t        hits_count=hits_count,\n75\t        bytes_scanned=bytes_scanned,\n76\t        scanned=scanned,\n77\t        enforced=enforced,\n78\t        session_id=session_id,\n79\t        project=project,\n80\t    )\n81\t\n82\t\n83\tdef emit_session_memory_delta_observed(\n84\t    *,\n85\t    outcome: str = \"\",\n86\t    files_count: int = 0,\n87\t    modified_count: int = 0,\n88\t    index_modified: bool = False,\n89\t    anchor_source: str = \"\",\n90\t    session_id: str = \"\",\n91\t    project: str = \"\",\n92\t) -> None:\n93\t    \"\"\"Emit session_memory_delta_observed (PLAN-179 W2 US8, SPEC v2.60).\n94\t\n95\t    One emit per session from ``SessionEnd.py``, immediately before the\n96\t    ``session_end`` emit: a stat-only observation of activity in the shared\n97\t    project memor