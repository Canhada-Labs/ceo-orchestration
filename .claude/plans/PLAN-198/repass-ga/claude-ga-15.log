{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch77su42pnHPiwSc6pitw","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Lj6VcguHDssuf8LVJyKg7t","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/adapters.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10967,"cache_read_input_tokens":166968,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10967},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"6ecec1be-c9f5-46ca-a77f-82706eb464cc","uuid":"34158748-fefd-4b63-b0ad-2af93ddeb5bc","timestamp":"2026-11-16T18:58:10.192Z","request_id":"req_011Ch77stqNewNMZ7eRtbggr","wire_tool_inputs":{"toolu_01Lj6VcguHDssuf8LVJyKg7t":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/adapters.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Lj6VcguHDssuf8LVJyKg7t","type":"tool_result","content":"1\t\"\"\"Adapters.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('emit_live_adapter_call_started', 'emit_live_adapter_call_succeeded', 'emit_live_adapter_call_failed', 'emit_breaker_opened', 'emit_breaker_closed', 'emit_live_adapter_blocked', 'emit_credential_blocked_due_to_age', 'emit_credential_emergency_override_used', '_CREDENTIAL_OVERRIDE_VAR_NAME', '_CREDENTIAL_OVERRIDE_PROVENANCE_HINTS', 'emit_credential_override_late_set_ignored', 'emit_mcp_bearer_replay_rejected', 'emit_mcp_non_loopback_rejected', '_ATLAS_REGISTRY', '_ATLAS_NAMESPACE_REGISTRY')\n9\t\n10\t# -----------------------------------------------------------------------------\n11\t# Sprint 13 Phase A.0 (PLAN-013 Gap #3) — Live adapter / breaker / credential\n12\t# -----------------------------------------------------------------------------\n13\t\n14\t\n15\tdef emit_live_adapter_call_started(\n16\t    provider: str,\n17\t    url: str,\n18\t    attempt: int,\n19\t    session_id: str = \"\",\n20\t    project: str = \"\",\n21\t) -> None:\n22\t    \"\"\"Emit a live_adapter_call_started event (ADR-040 §7).\n23\t\n24\t    Fired by ``_lib/adapters/live/_transport.py::post_json`` on every\n25\t    attempt (initial + retries). ``url`` MUST be query-scrubbed by\n26\t    the caller (_scrub_url_query). Credential values never appear.\n27\t    \"\"\"\n28\t    event: Dict[str, Any] = {\n29\t        \"action\": \"live_adapter_call_started\",\n30\t        \"provider\": provider,\n31\t        \"url\": url,\n32\t        \"attempt\": int(attempt),\n33\t        \"session_id\": session_id,\n34\t        \"project\": project,\n35\t    }\n36\t    _write_event(event)\n37\t\n38\t\n39\tdef emit_live_adapter_call_succeeded(\n40\t    provider: str,\n41\t    url: str,\n42\t    status: int,\n43\t    duration_ms: int,\n44\t    retried: bool = False,\n45\t    session_id: str = \"\",\n46\t    project: str = \"\",\n47\t) -> None:\n48\t    \"\"\"Emit a live_adapter_call_succeeded event (ADR-040 §7).\n49\t\n50\t    Fired on any 2xx response. ``duration_ms`` is wall-clock including\n51\t    retry backoff. ``retried=True`` if this response came after at least\n52\t    one earlier attempt failed transiently.\n53\t    \"\"\"\n54\t    event: Dict[str, Any] = {\n55\t        \"action\": \"live_adapter_call_succeeded\",\n56\t        \"provider\": provider,\n57\t        \"url\": url,\n58\t        \"status\": int(status),\n59\t        \"duration_ms\": int(duration_ms),\n60\t        \"retried\": bool(retried),\n61\t        \"session_id\": session_id,\n62\t        \"project\": project,\n63\t    }\n64\t    _write_event(event)\n65\t\n66\t\n67\tdef emit_live_adapter_call_failed(\n68\t    provider: str,\n69\t    failure_mode: str,\n70\t    http_status: Optional[int] = None,\n71\t    duration_ms: int = 0,\n72\t    retry_count: int = 0,\n73\t    session_id: str = \"\",\n74\t    project: str = \"\",\n75\t) -> None:\n76\t    \"\"\"Emit a live_adapter_call_failed event (ADR-040 §7).\n77\t\n78\t    ``failure_mode`` is the closed enum from SPEC/v1/live-adapters-policy\n79\t    §3 (auth_permanent, rate_limit, server_error, connect_timeout,\n80\t    read_timeout, connection_refused, parse_error, breaker_open,\n81\t    budget_hard_stop, scope_misconfigured).\n82\t    \"\"\"\n83\t    event: Dict[str, Any] = {\n84\t        \"action\": \"live_adapter_call_failed\",\n85\t        \"provider\": provider,\n86\t        \"failure_mode\": failure_mode,\n87\t        \"http_status\": int(http_status) if http_status is not None else None,\n88\t        \"duration_ms\": int(duration_ms),\n89\t        \"retry_count\": int(retry_count),\n90\t        \"session_id\": session_id,\n91\t        \"project\": project,\n92\t    }\n93\t    _write_event(event)\n94\t\n95\t\n96\tdef emit_breaker_opened(\n97\t    provider: str,\n98\t    failures_in_window: int,\n99\t    threshold: int,\n100\t    reason: str = \"server_error\",\n101\t    session_id: str = \"\",\n102\t    project: str = \"\",\n103\t) -> None:\n104\t    \"\"\"Emit a breaker_opened event (ADR-040 §2).\n105\t\n106\t    Fired when :class:`_lib.adapters.live._breaker.CircuitBreaker`\n107\t    transitions CLOSED → OPEN (threshold crossed) or HALF_OPEN → OPEN\n108\t    (probe failed). ``reason`` is the failure classification that\n109\t    triggered the transition.\n110\t    \"\"\"\n111\t    event: Dict[str, Any] = {\n112\t        \"action\": \"breaker_opened\",\n113\t        \"provider\": provider,\n114\t        \"failures_in_window\": int(failures_in_window),\n115\t        \"threshold\": int(threshold),\n116\t        \"reason\": reason,\n117\t        \"session_id\": session_id,\n118\t        \"project\": project,\n119\t    }\n120\t    _write_event(event)\n121\t\n122\t\n123\tdef emit_breaker_closed(\n124\t    provider: str,\n125\t    from_state: str,\n126\t    session_id: str = \"\",\n127\t    project: str = \"\",\n128\t) -> None:\n129\t    \"\"\"Emit a breaker_closed event (ADR-040 §2).\n130\t\n131\t    Fired when :class:`_lib.adapters.live._breaker.CircuitBreaker`\n132\t    transitions back to CLOSED (from HALF_OPEN after successful probe,\n133\t    or explicit reset). ``from_state`` ∈ {\"open\", \"half_open\", \"reset\"}.\n134\t    \"\"\"\n135\t    event: Dict[str, Any] = {\n136\t        \"action\": \"breaker_closed\",\n137\t        \"provider\": provider,\n138\t        \"from_state\": from_state,\n139\t        \"session_id\": session_id,\n140\t        \"project\": project,\n141\t    }\n142\t    _write_event(event)\n143\t\n144\t\n145\t# -----------------------------------------------------------------------------\n146\t# Sprint 13 Phase A (PLAN-013) — MCP server events (ADR-042)\n147\t# -----------------------------------------------------------------------------\n148\t\n149\t\n150\t# ---------------------------------------------------------------------\n151\t# PLAN-085 Wave C.1 — live_adapter_blocked\n152\t# ---------------------------------------------------------------------\n153\t\n154\t\n155\tdef emit_live_adapter_blocked(\n156\t    provider: str,\n157\t    reason: str,\n158\t    session_id: str = \"\",\n159\t    project: str = \"\",\n160\t    *,\n161\t    atlas_technique: Optional[str] = None,\n162\t) -> None:\n163\t    \"\"\"Emit a live_adapter_blocked event (PLAN-085 C.1 / ADR-040 §6.3).\n164\t\n165\t    PLAN-085 Wave G.1b — extended with optional ``atlas_technique``\n166\t    parameter. Defaults to AML.T0049 (Exploit Public-Facing\n167\t    Application) from the immutable registry.\n168\t    \"\"\"\n169\t    emit_generic(\n170\t        \"live_adapter_blocked\",\n171\t        provider=provider,\n172\t        reason=reason,\n173\t        atlas_technique=atlas_technique or _ATLAS_REGISTRY[\"live_adapter_blocked\"],\n174\t        session_id=session_id,\n175\t        project=project,\n176\t    )\n177\t\n178\t\n179\t# ---------------------------------------------------------------------\n180\t# PLAN-085 Wave C.2 — credential lifecycle blocking + override\n181\t# ---------------------------------------------------------------------\n182\t\n183\t\n184\tdef emit_credential_blocked_due_to_age(\n185\t    provider: str,\n186\t    age_days: int,\n187\t    max_age_days: int,\n188\t    session_id: str = \"\",\n189\t    project: str = \"\",\n190\t) -> None:\n191\t    \"\"\"Emit credential_blocked_due_to_age (ADR-040 §4 + ADR-040-AMEND-2).\"\"\"\n192\t    emit_generic(\n193\t        \"credential_blocked_due_to_age\",\n194\t        provider=provider,\n195\t        age_days=int(age_days),\n196\t        max_age_days=int(max_age_days),\n197\t        session_id=session_id,\n198\t        project=project,\n199\t    )\n200\t\n201\t\n202\tdef emit_credential_emergency_override_used(\n203\t    provider: str,\n204\t    ticket_id: str,\n205\t    age_days: int,\n206\t    max_age_days: int,\n207\t    session_id: str = \"\",\n208\t    project: str = \"\",\n209\t) -> None:\n210\t    \"\"\"Emit credential_emergency_override_used (ADR-040-AMEND-2).\"\"\"\n211\t    emit_generic(\n212\t        \"credential_emergency_override_used\",\n213\t        provider=provider,\n214\t        ticket_id=ticket_id,\n215\t        age_days=int(age_days),\n216\t        max_age_days=int(max_age_days),\n217\t        session_id=session_id,\n218\t        project=project,\n219\t    )\n220\t\n221\t\n222\t# PLAN-117 WS-A — closed-enum + constant for the late-set forensic emit. The\n223\t# rejected override VALUE must NEVER reach the payload, so the dispatch gate\n224\t# (below) forces the var name to this constant and coerces an out-of-enum\n225\t# provenance hint to \"unspecified\" — the no-value-echo invariant is enforced at\n226\t# the chokepoint, independent of the caller (defense-in-depth, mirrors the\n227\t# closed-enum reason_code precedent in tier_policy_loader_fallback_observed).\n228\t_CREDENTIAL_OVERRIDE_VAR_NAME = \"CEO_CREDENTIAL_BLOCK_EMERGENCY_OVERRIDE\"\n229\t\n230\t\n231\t_CREDENTIAL_OVERRIDE_PROVENANCE_HINTS = frozenset({\n232\t    \"late_os_environ_set\", \"spawn_payload_env\", \"subprocess_inherited\",\n233\t})\n234\t\n235\t\n236\tdef emit_credential_override_late_set_ignored(\n237\t    provider: str,\n238\t    provenance_hint: str = \"late_os_environ_set\",\n239\t    session_id: str = \"\",\n240\t    project: str = \"\",\n241\t) -> None:\n242\t    \"\"\"Emit credential_override_late_set_ignored (ADR-040-AMEND-2 §Layer-1).\n243\t\n244\t    Forensic trace for an emergency-override value that was present in the\n245\t    LIVE environment but ABSENT from the import-time trust-root snapshot\n246\t    (set post-anchor) and therefore IGNORED — never honored. The rejected\n247\t    VALUE is never persisted: the emit_generic dispatch gate FORCES\n248\t    ``attempted_var_name`` to the constant variable name and COERCES an\n249\t    out-of-enum ``provenance_hint`` — so the no-value-echo invariant does not\n250\t    depend on the caller (closed-enum-breadcrumb-must-not-echo-rejected-value).\n251\t    There is intentionally no ``attempted_var_name`` parameter: a caller cannot\n252\t    inject it.\n253\t    \"\"\"\n254\t    emit_generic(\n255\t        \"credential_override_late_set_ignored\",\n256\t        provider=provider,\n257\t        provenance_hint=provenance_hint,\n258\t        session_id=session_id,\n259\t        project=project,\n260\t    )\n261\t\n262\t\n263\t# ---------------------------------------------------------------------\n264\t# PLAN-085 Wave C.3 — MCP bearer-token replay defense (loopback-only)\n265\t# ---------------------------------------------------------------------\n266\t\n267\t\n268\tdef emit_mcp_bearer_replay_rejected(\n269\t    reason: str,\n270\t    nonce_prefix: str = \"\",\n271\t    session_id: str = \"\",\n272\t    project: str = \"\",\n273\t) -> None:\n274\t    \"\"\"Emit mcp_bearer_replay_rejected (PLAN-085 C.3 / IDA-P0-03).\"\"\"\n275\t    emit_generic(\n276\t        \"mcp_bearer_replay_rejected\",\n277\t        reason=reason,\n278\t        nonce_prefix=nonce_prefix[:8] if nonce_prefix else \"\",\n279\t        session_id=session_id,\n280\t        project=project,\n281\t    )\n282\t\n283\t\n284\tdef emit_mcp_non_loopback_rejected(\n285\t    remote_addr_family: str = \"\",\n286\t    session_id: str = \"\",\n287\t    project: str = \"\",\n288\t) -> None:\n289\t    \"\"\"Emit mcp_non_loopback_rejected (PLAN-085 C.3 / ADR-040-MCP-Auth).\"\"\"\n290\t    emit_generic(\n291\t        \"mcp_non_loopback_rejected\",\n292\t        remote_addr_family=remote_addr_family,\n293\t        session_id=session_id,\n294\t        project=project,\n295\t    )\n296\t\n297\t\n298\t# ---------------------------------------------------------------------\n299\t# PLAN-085 Wave G.1b — ATLAS technique-ID schema (5 mappings).\n300\t# Immutable v1.19.0 registry; G.1a authored docs + fixtures + test\n301\t# infrastructure; G.1b lands the production audit_emit wiring.\n302\t# Source of truth: docs/EXT-011-mitre-atlas.md §2 SHIPPED table.\n303\t#\n304\t# PLAN-095 Wave A (S128) — registry expanded to 19 entries / 11 unique\n305\t# technique IDs by PLAN-088/089/090 across multiple plan ships. PLAN-095\n306\t# Wave B ships OWASP LLM03:2025 Supply Chain detection in\n307\t# `_lib/output_scan.py::_LLM_PATTERN_GROUPS` (family LLM03_2025_supply_chain).\n308\t# That detection family is NOT bound to a row in this registry because\n309\t# supply-chain is a family-level concern over output payloads, not a\n310\t# single technique-ID bound to a single audit-action. Cross-reference\n311\t# only; see `.claude/plans/PLAN-095/honest-scope-correction.md` §A.2.\n312\t# ---------------------------------------------------------------------\n313\t\n314\t_ATLAS_REGISTRY = {\n315\t    \"prompt_injection_detected\": \"AML.T0051\",\n316\t    # PLAN-095 Wave A LLM02:2025 retag — AML.T0024.001 (ATLAS Infer\n317\t    # Training Data Membership) maps to OWASP 2024 LLM06 Sensitive\n318\t    # Information Disclosure AND OWASP 2025 LLM02 Sensitive Information\n319\t    # Disclosure (renumbering only; semantic preserved across both).\n320\t    \"secret_leak_detected\": \"AML.T0024.001\",\n321\t    \"pii_redacted_outgoing\": \"AML.T0048.004\",\n322\t    \"live_adapter_blocked\": \"AML.T0049\",\n323\t    \"codex_egress_redacted\": \"AML.T0054\",\n324\t    # PLAN-088 canonical-13 ATLAS bindings (S114) — 6 actions with non-null\n325\t    # technique-IDs per W0 ATLAS-binding table. Remaining 7 canonical-13\n326\t    # actions have atlas_technique=null + atlas_rationale per PLAN-088 §1.5\n327\t    # (telemetry-only / UX-trigger / infra-error / cost-optimization).\n328\t    \"subagent_findings_partial_drop\": \"AML.T0048\",   # W1.4 SEMI-13 — Governance bypass observation\n329\t    \"anthropic_429_observed\":         \"AML.T0029\",   # W1.4 SEMI-13 — Denial of ML Service signal\n330\t    \"codex_invoke_dispatched\":        \"AML.T0050\",   # W1.4 SEMI-13 — LLM Plugin Compromise dual-rail\n331\t    \"tier_policy_misrouting_advised\": \"AML.T0048\",   # W2.1 AUTO-04 — Governance bypass\n332\t    \"mcp_route_advised\":              \"AML.T0050\",   # W3.1 AUTO-06 — LLM Plugin / supply-chain signal\n333\t    \"pair_rail_phase_advanced\":       \"AML.T0050\",   # W4.1 AUTO-07 — LLM Plugin Compromise dual-rail check\n334\t    # PLAN-089 Wave C.5 — ATT&CK Enterprise bindings (R1 TDE P0 fold +\n335\t    # R2 Codex iter-1 P1 taxonomy correction). T1556/T1565.001 are\n336\t    # ATT&CK Enterprise (not ATLAS); registry name is generic for\n337\t    # technique-ID storage despite historic ATLAS-only origin.\n338\t    \"kernel_extension_landed\":            \"T1565.001\",  # Stored Data Manipulation — canonical kernel surface\n339\t    \"bash_canonical_bypass_invoked\":      \"T1565.001\",  # Stored Data Manipulation — same surface, kill-switch path\n340\t    \"sentinel_signer_rotated\":            \"T1556\",      # Modify Authentication Process\n341\t    \"sentinel_signer_expiry_warned\":      \"T1556\",      # Modify Authentication Process (forward signal)\n342\t    \"sentinel_signer_revoked\":            \"T1556\",      # Modify Authentication Process\n343\t    \"sentinel_signer_quorum_failed\":      \"T1556\",      # Modify Authentication Process (negative path canary)\n344\t    \"sentinel_signer_quorum_attempted\":   \"T1556\",      # Modify Authentication Process (forensic completeness)\n345\t    # PLAN-090 Wave B.5 — streaming side-channel monitoring.\n346\t    \"streaming_token_yielded\":            \"T1071\",\n347\t    # Note: T1584 (Compromise Infrastructure) applies to cold-key\n348\t    # compromise SCENARIOS — captured at IR investigation time, not at\n349\t    # any single audit-event level. See ADR-121 §7.\n350\t}\n351\t\n352\t\n353\t# PLAN-095 Wave A.8 (S128) — explicit namespace metadata per unique\n354\t# technique-ID for `verify-atlas-binding.py --strict-namespace` gate.\n355\t# Maps each of the 11 unique technique IDs in `_ATLAS_REGISTRY` to its\n356\t# source namespace: `atlas` (MITRE ATLAS LLM-system surface) or\n357\t# `attack-enterprise` (MITRE ATT&CK Enterprise OS-level surface).\n358\t# Registry intentionally carries the namespace mix per ADR-049\n359\t# detection-as-code corpus expansion; strict-namespace gate makes the\n360\t# mix EXPLICIT rather than implicit.\n361\t_ATLAS_NAMESPACE_REGISTRY: Dict[str, str] = {\n362\t    \"AML.T0024.001\": \"atlas\",\n363\t    \"AML.T0029\":     \"atlas\",\n364\t    \"AML.T0048\":     \"atlas\",\n365\t    \"AML.T0048.004\": \"atlas\",\n366\t    \"AML.T0049\":     \"atlas\",\n367\t    \"AML.T0050\":     \"atlas\",\n368\t    \"AML.T0051\":     \"atlas\",\n369\t    \"AML.T0054\":     \"atlas\",\n370\t    \"T1071\":         \"attack-enterprise\",\n371\t    \"T1556\":         \"attack-enterprise\",\n372\t    \"T1565.001\":     \"attack-enterprise\",\n373\t}\n374\t"}]},"parent_tool_use_id":null,"session_id":"6ecec1be-c9f5-46ca-a77f-82706eb464cc","uuid":"c110f660-e300-4a42-8e8a-55517cccaede","timestamp":"2026-11-16T18:58:10.209Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/adapters.py","content":"\"\"\"Adapters.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('emit_live_adapter_call_started', 'emit_live_adapter_call_succeeded', 'emit_live_adapter_call_failed', 'emit_breaker_opened', 'emit_breaker_closed', 'emit_live_adapter_blocked', 'emit_credential_blocked_due_to_age', 'emit_credential_emergency_override_used', '_CREDENTIAL_OVERRIDE_VAR_NAME', '_CREDENTIAL_OVERRIDE_PROVENANCE_HINTS', 'emit_credential_override_late_set_ignored', 'emit_mcp_bearer_replay_rejected', 'emit_mcp_non_loopback_rejected', '_ATLAS_REGISTRY', '_ATLAS_NAMESPACE_REGISTRY')\n\n# -----------------------------------------------------------------------------\n# Sprint 13 Phase A.0 (PLAN-013 Gap #3) — Live adapter / breaker / credential\n# -----------------------------------------------------------------------------\n\n\ndef emit_live_adapter_call_started(\n    provider: str,\n    url: str,\n    attempt: int,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a live_adapter_call_started event (ADR-040 §7).\n\n    Fired by ``_lib/adapters/live/_transport.py::post_json`` on every\n    attempt (initial + retries). ``url`` MUST be query-scrubbed by\n    the caller (_scrub_url_query). Credential values never appear.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"live_adapter_call_started\",\n        \"provider\": provider,\n        \"url\": url,\n        \"attempt\": int(attempt),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_live_adapter_call_succeeded(\n    provider: str,\n    url: str,\n    status: int,\n    duration_ms: int,\n    retried: bool = False,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a live_adapter_call_succeeded event (ADR-040 §7).\n\n    Fired on any 2xx response. ``duration_ms`` is wall-clock including\n    retry backoff. ``retried=True`` if this response came after at least\n    one earlier attempt failed transiently.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"live_adapter_call_succeeded\",\n        \"provider\": provider,\n        \"url\": url,\n        \"status\": int(status),\n        \"duration_ms\": int(duration_ms),\n        \"retried\": bool(retried),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_live_adapter_call_failed(\n    provider: str,\n    failure_mode: str,\n    http_status: Optional[int] = None,\n    duration_ms: int = 0,\n    retry_count: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a live_adapter_call_failed event (ADR-040 §7).\n\n    ``failure_mode`` is the closed enum from SPEC/v1/live-adapters-policy\n    §3 (auth_permanent, rate_limit, server_error, connect_timeout,\n    read_timeout, connection_refused, parse_error, breaker_open,\n    budget_hard_stop, scope_misconfigured).\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"live_adapter_call_failed\",\n        \"provider\": provider,\n        \"failure_mode\": failure_mode,\n        \"http_status\": int(http_status) if http_status is not None else None,\n        \"duration_ms\": int(duration_ms),\n        \"retry_count\": int(retry_count),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_breaker_opened(\n    provider: str,\n    failures_in_window: int,\n    threshold: int,\n    reason: str = \"server_error\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a breaker_opened event (ADR-040 §2).\n\n    Fired when :class:`_lib.adapters.live._breaker.CircuitBreaker`\n    transitions CLOSED → OPEN (threshold crossed) or HALF_OPEN → OPEN\n    (probe failed). ``reason`` is the failure classification that\n    triggered the transition.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"breaker_opened\",\n        \"provider\": provider,\n        \"failures_in_window\": int(failures_in_window),\n        \"threshold\": int(threshold),\n        \"reason\": reason,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\ndef emit_breaker_closed(\n    provider: str,\n    from_state: str,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a breaker_closed event (ADR-040 §2).\n\n    Fired when :class:`_lib.adapters.live._breaker.CircuitBreaker`\n    transitions back to CLOSED (from HALF_OPEN after successful probe,\n    or explicit reset). ``from_state`` ∈ {\"open\", \"half_open\", \"reset\"}.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"breaker_closed\",\n        \"provider\": provider,\n        \"from_state\": from_state,\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\n# -----------------------------------------------------------------------------\n# Sprint 13 Phase A (PLAN-013) — MCP server events (ADR-042)\n# -----------------------------------------------------------------------------\n\n\n# ---------------------------------------------------------------------\n# PLAN-085 Wave C.1 — live_adapter_blocked\n# ---------------------------------------------------------------------\n\n\ndef emit_live_adapter_blocked(\n    provider: str,\n    reason: str,\n    session_id: str = \"\",\n    project: str = \"\",\n    *,\n    atlas_technique: Optional[str] = None,\n) -> None:\n    \"\"\"Emit a live_adapter_blocked event (PLAN-085 C.1 / ADR-040 §6.3).\n\n    PLAN-085 Wave G.1b — extended with optional ``atlas_technique``\n    parameter. Defaults to AML.T0049 (Exploit Public-Facing\n    Application) from the immutable registry.\n    \"\"\"\n    emit_generic(\n        \"live_adapter_blocked\",\n        provider=provider,\n        reason=reason,\n        atlas_technique=atlas_technique or _ATLAS_REGISTRY[\"live_adapter_blocked\"],\n        session_id=session_id,\n        project=project,\n    )\n\n\n# ---------------------------------------------------------------------\n# PLAN-085 Wave C.2 — credential lifecycle blocking + override\n# ---------------------------------------------------------------------\n\n\ndef emit_credential_blocked_due_to_age(\n    provider: str,\n    age_days: int,\n    max_age_days: int,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit credential_blocked_due_to_age (ADR-040 §4 + ADR-040-AMEND-2).\"\"\"\n    emit_generic(\n        \"credential_blocked_due_to_age\",\n        provider=provider,\n        age_days=int(age_days),\n        max_age_days=int(max_age_days),\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_credential_emergency_override_used(\n    provider: str,\n    ticket_id: str,\n    age_days: int,\n    max_age_days: int,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit credential_emergency_override_used (ADR-040-AMEND-2).\"\"\"\n    emit_generic(\n        \"credential_emergency_override_used\",\n        provider=provider,\n        ticket_id=ticket_id,\n        age_days=int(age_days),\n        max_age_days=int(max_age_days),\n        session_id=session_id,\n        project=project,\n    )\n\n\n# PLAN-117 WS-A — closed-enum + constant for the late-set forensic emit. The\n# rejected override VALUE must NEVER reach the payload, so the dispatch gate\n# (below) forces the var name to this constant and coerces an out-of-enum\n# provenance hint to \"unspecified\" — the no-value-echo invariant is enforced at\n# the chokepoint, independent of the caller (defense-in-depth, mirrors the\n# closed-enum reason_code precedent in tier_policy_loader_fallback_observed).\n_CREDENTIAL_OVERRIDE_VAR_NAME = \"CEO_CREDENTIAL_BLOCK_EMERGENCY_OVERRIDE\"\n\n\n_CREDENTIAL_OVERRIDE_PROVENANCE_HINTS = frozenset({\n    \"late_os_environ_set\", \"spawn_payload_env\", \"subprocess_inherited\",\n})\n\n\ndef emit_credential_override_late_set_ignored(\n    provider: str,\n    provenance_hint: str = \"late_os_environ_set\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit credential_override_late_set_ignored (ADR-040-AMEND-2 §Layer-1).\n\n    Forensic trace for an emergency-override value that was present in the\n    LIVE environment but ABSENT from the import-time trust-root snapshot\n    (set post-anchor) and therefore IGNORED — never honored. The rejected\n    VALUE is never persisted: the emit_generic dispatch gate FORCES\n    ``attempted_var_name`` to the constant variable name and COERCES an\n    out-of-enum ``provenance_hint`` — so the no-value-echo invariant does not\n    depend on the caller (closed-enum-breadcrumb-must-not-echo-rejected-value).\n    There is intentionally no ``attempted_var_name`` parameter: a caller cannot\n    inject it.\n    \"\"\"\n    emit_generic(\n        \"credential_override_late_set_ignored\",\n        provider=provider,\n        provenance_hint=provenance_hint,\n        session_id=session_id,\n        project=project,\n    )\n\n\n# ---------------------------------------------------------------------\n# PLAN-085 Wave C.3 — MCP bearer-token replay defense (loopback-only)\n# ---------------------------------------------------------------------\n\n\ndef emit_mcp_bearer_replay_rejected(\n    reason: str,\n    nonce_prefix: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit mcp_bearer_replay_rejected (PLAN-085 C.3 / IDA-P0-03).\"\"\"\n    emit_generic(\n        \"mcp_bearer_replay_rejected\",\n        reason=reason,\n        nonce_prefix=nonce_prefix[:8] if nonce_prefix else \"\",\n        session_id=session_id,\n        project=project,\n    )\n\n\ndef emit_mcp_non_loopback_rejected(\n    remote_addr_family: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit mcp_non_loopback_rejected (PLAN-085 C.3 / ADR-040-MCP-Auth).\"\"\"\n    emit_generic(\n        \"mcp_non_loopback_rejected\",\n        remote_addr_family=remote_addr_family,\n        session_id=session_id,\n        project=project,\n    )\n\n\n# ---------------------------------------------------------------------\n# PLAN-085 Wave G.1b — ATLAS technique-ID schema (5 mappings).\n# Immutable v1.19.0 registry; G.1a authored docs + fixtures + test\n# infrastructure; G.1b lands the production audit_emit wiring.\n# Source of truth: docs/EXT-011-mitre-atlas.md §2 SHIPPED table.\n#\n# PLAN-095 Wave A (S128) — registry expanded to 19 entries / 11 unique\n# technique IDs by PLAN-088/089/090 across multiple plan ships. PLAN-095\n# Wave B ships OWASP LLM03:2025 Supply Chain detection in\n# `_lib/output_scan.py::_LLM_PATTERN_GROUPS` (family LLM03_2025_supply_chain).\n# That detection family is NOT bound to a row in this registry because\n# supply-chain is a family-level concern over output payloads, not a\n# single technique-ID bound to a single audit-action. Cross-reference\n# only; see `.claude/plans/PLAN-095/honest-scope-correction.md` §A.2.\n# ---------------------------------------------------------------------\n\n_ATLAS_REGISTRY = {\n    \"prompt_injection_detected\": \"AML.T0051\",\n    # PLAN-095 Wave A LLM02:2025 retag — AML.T0024.001 (ATLAS Infer\n    # Training Data Membership) maps to OWASP 2024 LLM06 Sensitive\n    # Information Disclosure AND OWASP 2025 LLM02 Sensitive Information\n    # Disclosure (renumbering only; semantic preserved across both).\n    \"secret_leak_detected\": \"AML.T0024.001\",\n    \"pii_redacted_outgoing\": \"AML.T0048.004\",\n    \"live_adapter_blocked\": \"AML.T0049\",\n    \"codex_egress_redacted\": \"AML.T0054\",\n    # PLAN-088 canonical-13 ATLAS bindings (S114) — 6 actions with non-null\n    # technique-IDs per W0 ATLAS-binding table. Remaining 7 canonical-13\n    # actions have atlas_technique=null + atlas_rationale per PLAN-088 §1.5\n    # (telemetry-only / UX-trigger / infra-error / cost-optimization).\n    \"subagent_findings_partial_drop\": \"AML.T0048\",   # W1.4 SEMI-13 — Governance bypass observation\n    \"anthropic_429_observed\":         \"AML.T0029\",   # W1.4 SEMI-13 — Denial of ML Service signal\n    \"codex_invoke_dispatched\":        \"AML.T0050\",   # W1.4 SEMI-13 — LLM Plugin Compromise dual-rail\n    \"tier_policy_misrouting_advised\": \"AML.T0048\",   # W2.1 AUTO-04 — Governance bypass\n    \"mcp_route_advised\":              \"AML.T0050\",   # W3.1 AUTO-06 — LLM Plugin / supply-chain signal\n    \"pair_rail_phase_advanced\":       \"AML.T0050\",   # W4.1 AUTO-07 — LLM Plugin Compromise dual-rail check\n    # PLAN-089 Wave C.5 — ATT&CK Enterprise bindings (R1 TDE P0 fold +\n    # R2 Codex iter-1 P1 taxonomy correction). T1556/T1565.001 are\n    # ATT&CK Enterprise (not ATLAS); registry name is generic for\n    # technique-ID storage despite historic ATLAS-only origin.\n    \"kernel_extension_landed\":            \"T1565.001\",  # Stored Data Manipulation — canonical kernel surface\n    \"bash_canonical_bypass_invoked\":      \"T1565.001\",  # Stored Data Manipulation — same surface, kill-switch path\n    \"sentinel_signer_rotated\":            \"T1556\",      # Modify Authentication Process\n    \"sentinel_signer_expiry_warned\":      \"T1556\",      # Modify Authentication Process (forward signal)\n    \"sentinel_signer_revoked\":            \"T1556\",      # Modify Authentication Process\n    \"sentinel_signer_quorum_failed\":      \"T1556\",      # Modify Authentication Process (negative path canary)\n    \"sentinel_signer_quorum_attempted\":   \"T1556\",      # Modify Authentication Process (forensic completeness)\n    # PLAN-090 Wave B.5 — streaming side-channel monitoring.\n    \"streaming_token_yielded\":            \"T1071\",\n    # Note: T1584 (Compromise Infrastructure) applies to cold-key\n    # compromise SCENARIOS — captured at IR investigation time, not at\n    # any single audit-event level. See ADR-121 §7.\n}\n\n\n# PLAN-095 Wave A.8 (S128) — explicit namespace metadata per unique\n# technique-ID for `verify-atlas-binding.py --strict-namespace` gate.\n# Maps each of the 11 unique technique IDs in `_ATLAS_REGISTRY` to its\n# source namespace: `atlas` (MITRE ATLAS LLM-system surface) or\n# `attack-enterprise` (MITRE ATT&CK Enterprise OS-level surface).\n# Registry intentionally carries the namespace mix per ADR-049\n# detection-as-code corpus expansion; strict-namespace gate makes the\n# mix EXPLICIT rather than implicit.\n_ATLAS_NAMESPACE_REGISTRY: Dict[str, str] = {\n    \"AML.T0024.001\": \"atlas\",\n    \"AML.T0029\":     \"atlas\",\n    \"AML.T0048\":     \"atlas\",\n    \"AML.T0048.004\": \"atlas\",\n    \"AML.T0049\":     \"atlas\",\n    \"AML.T0050\":     \"atlas\",\n    \"AML.T0051\":     \"atlas\",\n    \"AML.T0054\":     \"atlas\",\n    \"T1071\":         \"attack-enterprise\",\n    \"T1556\":         \"attack-enterprise\",\n    \"T1565.001\":     \"attack-enterprise\",\n}\n","numLines":374,"startLine":1,"totalLines":374}},"tool_result_meta":[{"id":"toolu_01Lj6VcguHDssuf8LVJyKg7t","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
