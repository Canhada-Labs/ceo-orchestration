+_IO_CYCLES = 24
+_PROBE = "ref-exec 2026-08-25 https://example.invalid token=abc12345"
+
+
+def term_imports():
+    import json
+    import re
+    import hashlib
+    import pathlib
+
+    pats = (
+        re.compile(r"[A-Za-z0-9_]{8,}"),
+        re.compile(r"(?i)\b(secret|token|key)\b"),
+        re.compile(r"^\s*[-*]\s+"),
+        re.compile(r"\d{4}-\d{2}-\d{2}"),
+        re.compile(r"https?://\S+"),
