{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BqgxQdwdvEZvD2XGzwy4Ui","type":"tool_result","content":"1\t\"\"\"Compatibility of independently loaded reality-ledger facades.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport importlib.util\n5\tfrom pathlib import Path\n6\t\n7\tSCRIPT = Path(__file__).resolve().parents[1] / \"reality-ledger.py\"\n8\t\n9\t\n10\tdef load(name):\n11\t    spec = importlib.util.spec_from_file_location(name, SCRIPT)\n12\t    module = importlib.util.module_from_spec(spec)\n13\t    spec.loader.exec_module(module)\n14\t    return module\n15\t\n16\t\n17\tdef test_facade_patch_reaches_detector_and_class(monkeypatch, tmp_path):\n18\t    module = load(\"ledger_patch\")\n19\t    monkeypatch.setattr(module, \"_is_excluded\", lambda *args, **kwargs: True)\n20\t    (tmp_path / \"x.py\").write_text(\"pass\")\n21\t    assert module._iter_python_files([tmp_path], repo_root=tmp_path) == []\n22\t    monkeypatch.setattr(module, \"_EnvVarReadFinder\", lambda: None)\n23\t    assert module._ast_collect_runtime_env_reads([tmp_path / \"x.py\"]) == {}\n24\t\n25\t\n26\tdef test_independent_imports_and_class_methods(monkeypatch):\n27\t    first = load(\"ledger_first\")\n28\t    second = load(\"ledger_second\")\n29\t    first.DETECTOR_REGISTRY.clear()\n30\t    assert second.DETECTOR_REGISTRY\n31\t    monkeypatch.setattr(first, \"ast\", None)\n32\t    finder = second._EnvVarReadFinder()\n33\t    finder.visit(second.ast.parse(\"os.getenv('CEO_EXAMPLE')\"))\n34\t    assert finder.read_vars == {\"CEO_EXAMPLE\"}\n35\t    assert first._EnvVarReadFinder.visit_Call.__globals__ is first.__dict__\n36\t    assert second._EnvVarReadFinder.visit_Call.__globals__ is second.__dict__\n37\t\n38\t\n39\tdef test_excludes_extracted_implementation():\n40\t    module = load(\"ledger_exclusion\")\n41\t    root = SCRIPT.parents[2]\n42\t    path = root / \".claude/hooks/_lib/_reality_ledger_parts/environment.py\"\n43\t    assert module._is_excluded(path, repo_root=root)\n44\t\n45\t\n46\tdef test_static_registry_uses_installed_exports_and_imports(tmp_path):\n47\t    module = load(\"ledger_registry\")\n48\t    facade = tmp_path / \"audit_emit.py\"\n49\t    parts = tmp_path / \"_audit_emit_parts\"\n50\t    parts.mkdir()\n51\t    (parts / \"actions.py\").write_text(\n52\t        \"from .renamed_source import _ACTIONS as _CORE\\n\"\n53\t        \"__all__ = ('_KNOWN_ACTIONS',)\\n_KNOWN_ACTIONS = _CORE | {'second'}\\n\"\n54\t    )\n55\t    (parts / \"renamed_source.py\").write_text(\"_ACTIONS = {'first'}\\n\")\n56\t    (parts / \"actions_core.py\").write_text(\"_ACTIONS = {'decoy'}\\n\")\n57\t    prefix = \"from _lib._audit_emit_parts import install as bind\\n\"\n58\t    facade.write_text(prefix + \"bind(globals(), ('actions',))\\n\")\n59\t    assert module._read_known_actions(facade) == {\"first\", \"second\"}\n60\t    facade.write_text(prefix + \"bind(globals(), ('renamed_source',))\\n\")\n61\t    assert module._read_known_actions(facade) == set()\n62\t"}]},"parent_tool_use_id":null,"session_id":"ca89a6a8-eeaf-4df8-8f1a-94ed9ebe813a","uuid":"f176ebcd-c2a3-4de1-a31d-1fc2c8f47379","timestamp":"2026-11-16T18:38:37.920Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/tests/test_reality_ledger_parts.py","content":"\"\"\"Compatibility of independently loaded reality-ledger facades.\"\"\"\nfrom __future__ import annotations\n\nimport importlib.util\nfrom pathlib import Path\n\nSCRIPT = Path(__file__).resolve().parents[1] / \"reality-ledger.py\"\n\n\ndef load(name):\n    spec = importlib.util.spec_from_file_location(name, SCRIPT)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\ndef test_facade_patch_reaches_detector_and_class(monkeypatch, tmp_path):\n    module = load(\"ledger_patch\")\n    monkeypatch.setattr(module, \"_is_excluded\", lambda *args, **kwargs: True)\n    (tmp_path / \"x.py\").write_text(\"pass\")\n    assert module._iter_python_files([tmp_path], repo_root=tmp_path) == []\n    monkeypatch.setattr(module, \"_EnvVarReadFinder\", lambda: None)\n    assert module._ast_collect_runtime_env_reads([tmp_path / \"x.py\"]) == {}\n\n\ndef test_independent_imports_and_class_methods(monkeypatch):\n    first = load(\"ledger_first\")\n    second = load(\"ledger_second\")\n    first.DETECTOR_REGISTRY.clear()\n    assert second.DETECTOR_REGISTRY\n    monkeypatch.setattr(first, \"ast\", None)\n    finder = second._EnvVarReadFinder()\n    finder.visit(second.ast.parse(\"os.getenv('CEO_EXAMPLE')\"))\n    assert finder.read_vars == {\"CEO_EXAMPLE\"}\n    assert first._EnvVarReadFinder.visit_Call.__globals__ is first.__dict__\n    assert second._EnvVarReadFinder.visit_Call.__globals__ is second.__dict__\n\n\ndef test_excludes_extracted_implementation():\n    module = load(\"ledger_exclusion\")\n    root = SCRIPT.parents[2]\n    path = root / \".claude/hooks/_lib/_reality_ledger_parts/environment.py\"\n    assert module._is_excluded(path, repo_root=root)\n\n\ndef test_static_registry_uses_installed_exports_and_imports(tmp_path):\n    module = load(\"ledger_registry\")\n    facade = tmp_path / \"audit_emit.py\"\n    parts = tmp_path / \"_audit_emit_parts\"\n    parts.mkdir()\n    (parts / \"actions.py\").write_text(\n        \"from .renamed_source import _ACTIONS as _CORE\\n\"\n        \"__all__ = ('_KNOWN_ACTIONS',)\\n_KNOWN_ACTIONS = _CORE | {'second'}\\n\"\n    )\n    (parts / \"renamed_source.py\").write_text(\"_ACTIONS = {'first'}\\n\")\n    (parts / \"actions_core.py\").write_text(\"_ACTIONS = {'decoy'}\\n\")\n    prefix = \"from _lib._audit_emit_parts import install as bind\\n\"\n    facade.write_text(prefix + \"bind(globals(), ('actions',))\\n\")\n    assert module._read_known_actions(facade) == {\"first\", \"second\"}\n    facade.write_text(prefix + \"bind(globals(), ('renamed_source',))\\n\")\n    assert module._read_known_actions(facade) == set()\n","numLines":62,"startLine":1,"totalLines":62}},"tool_result_meta":[{"id":"toolu_01BqgxQdwdvEZvD2XGzwy4Ui","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
