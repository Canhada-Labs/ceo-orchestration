{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TbsksAFh8mJWq99n5qkDSu","type":"tool_result","content":"1\t\"\"\"Extracted policy declarations: decisions.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t@dataclass\n5\tclass CompiledRule:\n6\t    rule_id: str\n7\t    description: str\n8\t    decision: str\n9\t    reason: Optional[str]\n10\t    predicate: _CompiledPredicate\n11\t    status: Optional[str] = None  # \"deprecated\" etc. (advisory only)\n12\t\n13\t\n14\tclass Policy:\n15\t    \"\"\"Immutable post-load. :meth:`decide` is pure over the frozen AST.\n16\t\n17\t    Attributes:\n18\t        policy_id: slug from ``id:`` field (matches filename base).\n19\t        schema_version: ``\"policy-dsl/v1\"``.\n20\t        kind: ``\"allow_list\"`` | ``\"deny_list\"`` | ``\"mixed\"``.\n21\t        defaults: ``{\"decision\": ..., \"reason\": ...}``.\n22\t        rules: ordered list of :class:`CompiledRule`.\n23\t        error_reasons: closed enum from ``error_model.reasons``.\n24\t        canonical_hash: SHA-256 hex digest (SPEC §6.1).\n25\t    \"\"\"\n26\t\n27\t    def __init__(\n28\t        self,\n29\t        policy_id: str,\n30\t        schema_version: str,\n31\t        description: str,\n32\t        kind: str,\n33\t        defaults: Dict[str, Any],\n34\t        rules: List[CompiledRule],\n35\t        error_reasons: Dict[str, str],\n36\t    ):\n37\t        self.policy_id = policy_id\n38\t        self.schema_version = schema_version\n39\t        self.description = description\n40\t        self.kind = kind\n41\t        self.defaults = dict(defaults)\n42\t        self.rules = list(rules)\n43\t        self.error_reasons = dict(error_reasons)\n44\t        self._rule_locks: Dict[str, \"threading.RLock\"] = {\n45\t            r.rule_id: threading.RLock() for r in rules\n46\t        }\n47\t        # Compute canonical hash last.\n48\t        payload = json.dumps(\n49\t            self.to_canonical_dict(),\n50\t            sort_keys=True,\n51\t            separators=(\",\", \":\"),\n52\t            ensure_ascii=False,\n53\t        ).encode(\"utf-8\")\n54\t        self.canonical_hash = hashlib.sha256(payload).hexdigest()\n55\t\n56\t    # --- public --------------------------------------------------------\n57\t\n58\t    def to_canonical_dict(self) -> Dict[str, Any]:\n59\t        \"\"\"SPEC §6.1 canonical-form serialization.\n60\t\n61\t        - Keys sorted at every level (enforced by ``json.dumps(..., sort_keys=True)``\n62\t          at hash time).\n63\t        - Rules preserved in declared order (first-match-wins semantic).\n64\t        - Regex patterns as source strings.\n65\t        \"\"\"\n66\t        return {\n67\t            \"schema\": self.schema_version,\n68\t            \"id\": self.policy_id,\n69\t            \"description\": self.description,\n70\t            \"kind\": self.kind,\n71\t            \"defaults\": dict(self.defaults),\n72\t            \"rules\": [\n73\t                {\n74\t                    \"id\": r.rule_id,\n75\t                    \"description\": r.description,\n76\t                    \"decision\": r.decision,\n77\t                    \"reason\": r.reason,\n78\t                    \"predicate\": _predicate_to_canonical(r.predicate),\n79\t                }\n80\t                for r in self.rules\n81\t            ],\n82\t            \"error_model\": {\n83\t                \"reasons\": dict(self.error_reasons),\n84\t            },\n85\t        }\n86\t\n87\t    def decide(self, event: Dict[str, Any]) -> Dict[str, Any]:\n88\t        \"\"\"Evaluate rules in declared order; first match wins.\n89\t\n90\t        Emits :func:`audit_emit.emit_policy_evaluated` (always) and\n91\t        :func:`audit_emit.emit_policy_denied` (deny path only) before\n92\t        returning. Never raises; field-missing → predicate-false per\n93\t        SPEC §7.3.\n94\t        \"\"\"\n95\t        start = time.monotonic()\n96\t        matched: Optional[CompiledRule] = None\n97\t        for rule in self.rules:\n98\t            if _evaluate(rule.predicate, event):\n99\t                matched = rule\n100\t                break\n101\t        duration_ms = int((time.monotonic() - start) * 1000)\n102\t        if matched is None:\n103\t            decision = str(self.defaults.get(\"decision\", \"allow\"))\n104\t            reason = self.defaults.get(\"reason\")\n105\t            rule_id = \"<default>\"\n106\t            out: Dict[str, Any] = {\"decision\": decision}\n107\t            if decision == \"block\" and reason:\n108\t                out[\"reason\"] = reason\n109\t                msg = self.error_reasons.get(str(reason))\n110\t                if msg:\n111\t                    out[\"message\"] = msg\n112\t            self._emit_evaluated(rule_id, decision, duration_ms)\n113\t            if decision == \"block\":\n114\t                self._emit_denied(rule_id, str(reason or \"\"))\n115\t            return out\n116\t        out2: Dict[str, Any] = {\"decision\": matched.decision}\n117\t        if matched.decision == \"block\" and matched.reason:\n118\t            out2[\"reason\"] = matched.reason\n119\t            msg = self.error_reasons.get(matched.reason)\n120\t            if msg:\n121\t                out2[\"message\"] = msg\n122\t        self._emit_evaluated(matched.rule_id, matched.decision, duration_ms)\n123\t        if matched.decision == \"block\":\n124\t            self._emit_denied(matched.rule_id, matched.reason or \"\")\n125\t        return out2\n126\t\n127\t    # --- audit helpers (fail-open) -------------------------------------\n128\t\n129\t    # PLAN-182 W2 (S321) — atribuicao de projeto nos emissores de policy.\n130\t    #\n131\t    # Medido: `policy_evaluated` + `policy_denied` respondiam por 15.128 dos\n132\t    # 15.208 eventos NAO-ATRIBUIVEIS pos-W1. A causa nao era o scrub\n133\t    # (`project` esta em `_FEDERATION_ENVELOPE`, logo nas allowlists) nem o\n134\t    # env: era o CHAMADOR omitindo o kwarg, com o default do emissor em \"\".\n135\t    # 