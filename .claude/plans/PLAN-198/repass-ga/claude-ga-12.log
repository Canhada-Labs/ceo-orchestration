{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013kbKpLi3GwpkroZAzcdGCU","type":"tool_result","content":"1\t\"\"\"Policy-as-code engine — PLAN-014 Phase A.3.\n2\t\n3\tImplements SPEC/v1/policy-dsl.schema.md §3 Grammar + §4 Runtime Semantics\n4\t+ §5 Error Model + §6 Policy Identity.\n5\t\n6\tStdlib-only per ADR-002 (PyYAML FORBIDDEN). Hand-rolled YAML subset parser\n7\tper SPEC §3.1-§3.2 with all hard limits enforced (§3.3).\n8\t\n9\tPublic API:\n10\t\n11\t    from _lib.policy import load, Policy, PolicyLoadError\n12\t\n13\t    policy = load(Path(\".claude/policies/bash-safety.policy.yaml\"))\n14\t    decision = policy.decide({\"tool\": \"Bash\", \"tool_input\": {\"command\": \"ls\"}})\n15\t    # -> {\"decision\": \"allow\"}\n16\t\n17\tSee SPEC for normative semantics. This module is tested against the SPEC,\n18\tnot the reverse (public-api-design skill rule 1).\n19\t\"\"\"\n20\t\n21\tfrom __future__ import annotations\n22\t\n23\ttry:\n24\t    from _lib import redact as _redact  # noqa: E402\n25\texcept Exception:  # pragma: no cover\n26\t    _redact = None  # type: ignore\n27\t\n28\timport hashlib\n29\timport json\n30\timport os\n31\timport re\n32\timport sys\n33\timport threading\n34\timport time\n35\tfrom dataclasses import dataclass, field\n36\tfrom pathlib import Path\n37\tfrom typing import Any, Dict, List, Optional, Tuple\n38\t\n39\t_HOOKS_DIR = Path(__file__).resolve().parent.parent\n40\tif str(_HOOKS_DIR) not in sys.path:\n41\t    sys.path.insert(0, str(_HOOKS_DIR))\n42\t\n43\ttry:\n44\t    from _lib import audit_emit as _audit_emit  # noqa: E402\n45\texcept Exception:  # pragma: no cover\n46\t    _audit_emit = None  # type: ignore\n47\t\n48\t\n49\t# ---------------------------------------------------------------------------\n50\t# Limits (SPEC §3.3)\n51\t# ---------------------------------------------------------------------------\n52\t\n53\t_LIMIT_FILE_BYTES = 64 * 1024  # 64 KiB raw file size\n54\t_LIMIT_DEPTH = 8\n55\t_LIMIT_TOTAL_EXPAND_BYTES = 1024 * 1024  # 1 MiB post-parse\n56\t_LIMIT_KEY_COUNT = 2000\n57\t_LIMIT_SCALAR_LEN = 16 * 1024  # 16 KiB per-scalar\n58\t_LIMIT_PARSE_CPU_MS = 500.0  # wall-clock\n59\t_LIMIT_REGEX_PATTERN = 512\n60\t\n61\t\n62\t# Closed enum from SPEC §5.\n63\t_ERROR_KINDS = frozenset({\n64\t    \"parse_error\",\n65\t    \"predicate_missing\",\n66\t    \"import_failure\",\n67\t    \"depth_limit\",\n68\t    \"size_limit\",\n69\t    \"alias_rejected\",\n70\t    \"tag_rejected\",\n71\t    \"timeout\",\n72\t    \"field_missing\",\n73\t    \"regex_compile_error\",\n74\t    \"schema_version_mismatch\",\n75\t})\n76\t\n77\t\n78\t# Closed set of predicate forms per SPEC §3.5.\n79\t_PREDICATE_FORMS = frozenset({\n80\t    \"all\", \"any\", \"not\",\n81\t    \"eq\", \"neq\", \"in\", \"not_in\",\n82\t    \"regex\", \"starts_with\", \"ends_with\", \"contains\",\n83\t    \"length_le\", \"length_ge\", \"path_under\",\n84\t})\n85\t\n86\t\n87\t# Top-level required keys per SPEC §3.4.\n88\t_TOP_LEVEL_REQUIRED = (\"schema\", \"id\", \"description\", \"kind\", \"defaults\",\n89\t                       \"rules\", \"error_model\")\n90\t\n91\t_KIND_ENUM = frozenset({\"allow_list\", \"deny_list\", \"mixed\"})\n92\t_DECISION_ENUM = frozenset({\"allow\", \"block\"})\n93\t\n94\t\n95\t# ---------------------------------------------------------------------------\n96\t# Exceptions\n97\t# ---------------------------------------------------------------------------\n98\t\n99\t\n100\tclass PolicyLoadError(Exception):\n101\t    \"\"\"Raised when :func:`load` cannot build a valid Policy.\n102\t\n103\t    ``error_kind`` is a closed-enum value from SPEC §5. ``detail`` is\n104\t    free-text (may be surfaced in ``policy_error`` audit via redaction).\n105\t    \"\"\"\n106\t\n107\t    def __init__(self, error_kind: str, detail: str, policy_id: str = \"\"):\n108\t        if error_kind not in _ERROR_KINDS:\n109\t            # Defensive: reject unknown kinds at raise site so the enum\n110\t            # contract is enforced. Fall back to parse_error.\n111\t            error_kind = \"parse_error\"\n112\t        self.error_kind = error_kind\n113\t        if _redact is not None:\n114\t            try:\n115\t                self.detail = _redact.redact_secrets(detail, max_chars=200)\n116\t            except Exception:\n117\t                self.detail = (detail[:200] if detail else \"\")\n118\t        else:\n119\t            self.detail = (detail[:200] if detail else \"\")\n120\t        self.policy_id = policy_id\n121\t        super().__init__(f\"{error_kind}: {detail}\")\n122\t\n123\t\n124\t# The parser keeps its historical public/private class name while methods live\n125\t# in ordered mixins.  Their code executes with this facade as globals.\n126\t# Opt-out: CEO_POLICY_ENGINE_DISABLE=1 reverts to Python-hook fallback.\n127\tfrom _lib._policy_parts import install as _install_policy_parts\n128\t_install_policy_parts(globals())\n129\tdel _install_policy_parts\n130\t\n131\tclass _YamlParser(_YamlBlocksMixin, _YamlFlowsMixin, _YamlScalarsMixin):\n132\t    \"\"\"YAML subset parser assembled from bounded implementation mixins.\"\"\"\n133\t    _INT_RE = re.compile(r\"^-?\\d+$\")\n134\t    _DIRECTIVE_RE = re.compile(r\"^\\s*%(YAML|TAG)\\b\")\n135\t\n136\t    def __init__(self, text: str, cpu_deadline_monotonic: float,\n137\t                 policy_id_hint: str = \"\"):\n138\t        self._lines = text.splitlines()\n139\t        self._i = 0\n140\t        self._n = len(self._lines)\n141\t        self._deadline = cpu_deadline_monotonic\n142\t        self._key_count = 0\n143\t        self._policy_id_hint = policy_id_hint\n144\t"}]},"parent_tool_use_id":null,"session_id":"ca89a6a8-eeaf-4df8-8f1a-94ed9ebe813a","uuid":"e2c63ef3-215a-4f75-af27-5f7f668be4fc","timestamp":"2026-11-16T18:35:15.039Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/policy.py","content":"\"\"\"Policy-as-code engine — PLAN-014 Phase A.3.\n\nImplements SPEC/v1/policy-dsl.schema.md §3 Grammar + §4 Runtime Semantics\n+ §5 Error Model + §6 Policy Identity.\n\nStdlib-only per ADR-002 (PyYAML FORBIDDEN). Hand-rolled YAML subset parser\nper SPEC §3.1-§3.2 with all hard limits enforced (§3.3).\n\nPublic API:\n\n    from _lib.policy import load, Policy, PolicyLoadError\n\n    policy = load(Path(\".claude/policies/bash-safety.policy.yaml\"))\n    decision = policy.decide({\"tool\": \"Bash\", \"tool_input\": {\"command\": \"ls\"}})\n    # -> {\"decision\": \"allow\"}\n\nSee SPEC for normative semantics. This module is tested against the SPEC,\nnot the reverse (public-api-design skill rule 1).\n\"\"\"\n\nfrom __future__ import annotations\n\ntry:\n    from _lib import redact as _redact  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _redact = None  # type: ignore\n\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nimport threading\nimport time\nfrom dataclasses import dataclass, field\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n_HOOKS_DIR = Path(__file__).resolve().parent.parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\ntry:\n    from _lib import audit_emit as _audit_emit  # noqa: E402\nexcept Exception:  # pragma: no cover\n    _audit_emit = None  # type: ignore\n\n\n# ---------------------------------------------------------------------------\n# Limits (SPEC §3.3)\n# ---------------------------------------------------------------------------\n\n_LIMIT_FILE_BYTES = 64 * 1024  # 64 KiB raw file size\n_LIMIT_DEPTH = 8\n_LIMIT_TOTAL_EXPAND_BYTES = 1024 * 1024  # 1 MiB post-parse\n_LIMIT_KEY_COUNT = 2000\n_LIMIT_SCALAR_LEN = 16 * 1024  # 16 KiB per-scalar\n_LIMIT_PARSE_CPU_MS = 500.0  # wall-clock\n_LIMIT_REGEX_PATTERN = 512\n\n\n# Closed enum from SPEC §5.\n_ERROR_KINDS = frozenset({\n    \"parse_error\",\n    \"predicate_missing\",\n    \"import_failure\",\n    \"depth_limit\",\n    \"size_limit\",\n    \"alias_rejected\",\n    \"tag_rejected\",\n    \"timeout\",\n    \"field_missing\",\n    \"regex_compile_error\",\n    \"schema_version_mismatch\",\n})\n\n\n# Closed set of predicate forms per SPEC §3.5.\n_PREDICATE_FORMS = frozenset({\n    \"all\", \"any\", \"not\",\n    \"eq\", \"neq\", \"in\", \"not_in\",\n    \"regex\", \"starts_with\", \"ends_with\", \"contains\",\n    \"length_le\", \"length_ge\", \"path_under\",\n})\n\n\n# Top-level required keys per SPEC §3.4.\n_TOP_LEVEL_REQUIRED = (\"schema\", \"id\", \"description\", \"kind\", \"defaults\",\n                       \"rules\", \"error_model\")\n\n_KIND_ENUM = frozenset({\"allow_list\", \"deny_list\", \"mixed\"})\n_DECISION_ENUM = frozenset({\"allow\", \"block\"})\n\n\n# ---------------------------------------------------------------------------\n# Exceptions\n# ---------------------------------------------------------------------------\n\n\nclass PolicyLoadError(Exception):\n    \"\"\"Raised when :func:`load` cannot build a valid Policy.\n\n    ``error_kind`` is a closed-enum value from SPEC §5. ``detail`` is\n    free-text (may be surfaced in ``policy_error`` audit via redaction).\n    \"\"\"\n\n    def __init__(self, error_kind: str, detail: str, policy_id: str = \"\"):\n        if error_kind not in _ERROR_KINDS:\n            # Defensive: reject unknown kinds at raise site so the enum\n            # contract is enforced. Fall back to parse_error.\n            error_kind = \"parse_error\"\n        self.error_kind = error_kind\n        if _redact is not None:\n            try:\n                self.detail = _redact.redact_secrets(detail, max_chars=200)\n            except Exception:\n                self.detail = (detail[:200] if detail else \"\")\n        else:\n            self.detail = (detail[:200] if detail else \"\")\n        self.policy_id = policy_id\n        super().__init__(f\"{error_kind}: {detail}\")\n\n\n# The parser keeps its historical public/private class name while methods live\n# in ordered mixins.  Their code executes with this facade as globals.\n# Opt-out: CEO_POLICY_ENGINE_DISABLE=1 reverts to Python-hook fallback.\nfrom _lib._policy_parts import install as _install_policy_parts\n_install_policy_parts(globals())\ndel _install_policy_parts\n\nclass _YamlParser(_YamlBlocksMixin, _YamlFlowsMixin, _YamlScalarsMixin):\n    \"\"\"YAML subset parser assembled from bounded implementation mixins.\"\"\"\n    _INT_RE = re.compile(r\"^-?\\d+$\")\n    _DIRECTIVE_RE = re.compile(r\"^\\s*%(YAML|TAG)\\b\")\n\n    def __init__(self, text: str, cpu_deadline_monotonic: float,\n                 policy_id_hint: str = \"\"):\n        self._lines = text.splitlines()\n        self._i = 0\n        self._n = len(self._lines)\n        self._deadline = cpu_deadline_monotonic\n        self._key_count = 0\n        self._policy_id_hint = policy_id_hint\n","numLines":144,"startLine":1,"totalLines":144}},"tool_result_meta":[{"id":"toolu_013kbKpLi3GwpkroZAzcdGCU","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
