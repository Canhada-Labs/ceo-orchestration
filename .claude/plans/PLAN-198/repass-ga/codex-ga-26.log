   124	_resolve_rp() {
   125	  if [ ! -f "$_RP" ] || ! command -v python3 >/dev/null 2>&1; then
   126	    echo "fatal: single resolver not found at $_RP (run scripts/upgrade.sh) -- refusing to guess the state dir" >&2
