    72	def differences(before: Dict[str, str], after: Dict[str, str]) -> List[str]:
    73	    """Uma frase por diferença; lista vazia = o repositório chamador está intacto."""
    74	    out: List[str] = []
    75	    if before.get("symbolic_ref") != after.get("symbolic_ref"):
    76	        out.append("HEAD apontava para %r e agora aponta para %r"
    77	                   % (before.get("symbolic_ref") or "(destacado)",
    78	                      after.get("symbolic_ref") or "(destacado)"))
    79	    if before.get("head") != after.get("head"):
    80	        out.append("HEAD era %r e agora é %r" % (before.get("head"), after.get("head")))
    81	    was = set((before.get("refs") or "").splitlines())
    82	    now = set((after.get("refs") or "").splitlines())
    83	    out.extend("ref sumiu ou mudou: %s" % line for line in sorted(was - now))
    84	    out.extend("ref nova ou mudada: %s" % line for line in sorted(now - was))
    85	    return out
