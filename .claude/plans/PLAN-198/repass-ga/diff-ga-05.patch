+        if emit_activation is not None:
+            _emit_fact_gate_activation_changed(emit_activation, source)
+        if emit_disabled_breadcrumb:
+            _emit_learning_rail_disabled("fact_gate", _FACT_GATE_ENFORCE_VAR)
