RE_ERR_LINE = r"(?:\[(%s)\] |(%s) ([A-Za-z_][A-Za-z0-9_]*): )(.*)" % (_STAMP, _STAMP)
_ERR_LINE_RX = re.compile(RE_ERR_LINE, re.ASCII)
