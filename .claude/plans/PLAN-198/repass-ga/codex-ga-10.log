RE_QUARANTINE = (r"audit-spool\.([1-9][0-9]{0,9})"
                 r"\.(?:malformed|quarantined|test-origin|corrupt-header)\.([0-9a-f]{8})")
_QUARANTINE_RX = re.compile(RE_QUARANTINE, re.ASCII)
AGGREGATE_JOURNAL = "audit-pending.journal"
