{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012wz3QEBDncUZ1ZdRwVZrj4","type":"tool_result","content":"1\t# mutation-floors.yaml — PLAN-045 F-03-09 (non-canonical companion)\n2\t#\n3\t# Recorded mutation kill-rate floors per critical module. A bump\n4\t# requires an ADR amendment documenting the regression tolerance\n5\t# (currently the targets are at-or-above these floors per PLAN-032\n6\t# Session 37 + PLAN-043 Session 37 cont measurements).\n7\t#\n8\t# Consumed by:\n9\t#   - `.claude/scripts/mutation-test.py --fail-under $(lookup floor)`\n10\t#   - `.github/workflows/mutation-gate.yml` (staged — see\n11\t#     `.claude/plans/PLAN-045/staged-code/F-03-09-mutation-ci-wiring.md`)\n12\t#\n13\t# Format: `<module-relative-path>: <float in [0.0, 1.0]>`\n14\t# Bump rule: raise floors opportunistically when suite lands fresh\n15\t# mutants-killed; lower only via explicit Owner-signed ADR\n16\t# amendment + rationale.\n17\t\n18\tfloors:\n19\t  # Agent-eval tournament (PLAN-032 Session 37; kill rate measured\n20\t  # 100% on scorer, 72.5% on reporter with survivors in fail-open\n21\t  # branches documented).\n22\t  \"tournament/scorer.py\": 0.95\n23\t  \"tournament/reporter.py\": 0.70\n24\t\n25\t  # Dynamic tier-policy (PLAN-043 Session 37 cont; VETO-floor\n26\t  # mutations killed 100% in-dev).\n27\t  \"tier_policy_cli/learn.py\": 0.95\n28\t  \"tier_policy_cli/apply.py\": 0.95\n29\t\n30\t  # Audit-log HMAC crypto-critical path (PLAN-023 Phase B + PLAN-\n31\t  # 045 Wave 5 F-01-06 hardening).\n32\t  \"_lib/audit_hmac.py\": 0.85\n33\t\n34\t# Non-target modules (listed for future bumps; no floor set).\n35\tcandidates_for_future_floors:\n36\t  - \".claude/scripts/confidence_gate.py\"\n37\t  - \".claude/hooks/_lib/policy.py\"\n38\t  - \".claude/hooks/_lib/state_store.py\"\n39\t  - \".claude/hooks/check_canonical_edit.py\"   # arbitration-kernel\n40\t  - \".claude/hooks/check_agent_spawn.py\"      # arbitration-kernel\n41\t\n42\t# ADRs gating any floor change:\n43\t# - ADR-052 multi-model dispatch by role (VETO floor scope)\n44\t# - ADR-055 audit-log HMAC chain (crypto invariant scope)\n45\t# - ADR-063 agent-eval empirical dispatch validation\n46\t# - ADR-064 dynamic tier-policy learned dispatch\n47\t\n48\t# Cadence:\n49\t# - Weekly scheduled run (staged mutation-gate.yml cron Tue 05:45 UTC)\n50\t# - Phase 1 advisory until 2026-05-20 (1-month post-sentinel)\n51\t# - Phase 2 enforcing (`continue-on-error: false`) after 4 green weeks\n52\t"}]},"parent_tool_use_id":null,"session_id":"44c9ec98-ac5f-45ac-a8b8-721313d99788","uuid":"b3f4ddf2-531c-46ff-b38e-adb3157fc040","timestamp":"2026-11-16T18:41:20.882Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/mutation-floors.yaml","content":"# mutation-floors.yaml — PLAN-045 F-03-09 (non-canonical companion)\n#\n# Recorded mutation kill-rate floors per critical module. A bump\n# requires an ADR amendment documenting the regression tolerance\n# (currently the targets are at-or-above these floors per PLAN-032\n# Session 37 + PLAN-043 Session 37 cont measurements).\n#\n# Consumed by:\n#   - `.claude/scripts/mutation-test.py --fail-under $(lookup floor)`\n#   - `.github/workflows/mutation-gate.yml` (staged — see\n#     `.claude/plans/PLAN-045/staged-code/F-03-09-mutation-ci-wiring.md`)\n#\n# Format: `<module-relative-path>: <float in [0.0, 1.0]>`\n# Bump rule: raise floors opportunistically when suite lands fresh\n# mutants-killed; lower only via explicit Owner-signed ADR\n# amendment + rationale.\n\nfloors:\n  # Agent-eval tournament (PLAN-032 Session 37; kill rate measured\n  # 100% on scorer, 72.5% on reporter with survivors in fail-open\n  # branches documented).\n  \"tournament/scorer.py\": 0.95\n  \"tournament/reporter.py\": 0.70\n\n  # Dynamic tier-policy (PLAN-043 Session 37 cont; VETO-floor\n  # mutations killed 100% in-dev).\n  \"tier_policy_cli/learn.py\": 0.95\n  \"tier_policy_cli/apply.py\": 0.95\n\n  # Audit-log HMAC crypto-critical path (PLAN-023 Phase B + PLAN-\n  # 045 Wave 5 F-01-06 hardening).\n  \"_lib/audit_hmac.py\": 0.85\n\n# Non-target modules (listed for future bumps; no floor set).\ncandidates_for_future_floors:\n  - \".claude/scripts/confidence_gate.py\"\n  - \".claude/hooks/_lib/policy.py\"\n  - \".claude/hooks/_lib/state_store.py\"\n  - \".claude/hooks/check_canonical_edit.py\"   # arbitration-kernel\n  - \".claude/hooks/check_agent_spawn.py\"      # arbitration-kernel\n\n# ADRs gating any floor change:\n# - ADR-052 multi-model dispatch by role (VETO floor scope)\n# - ADR-055 audit-log HMAC chain (crypto invariant scope)\n# - ADR-063 agent-eval empirical dispatch validation\n# - ADR-064 dynamic tier-policy learned dispatch\n\n# Cadence:\n# - Weekly scheduled run (staged mutation-gate.yml cron Tue 05:45 UTC)\n# - Phase 1 advisory until 2026-05-20 (1-month post-sentinel)\n# - Phase 2 enforcing (`continue-on-error: false`) after 4 green weeks\n","numLines":52,"startLine":1,"totalLines":52}},"tool_result_meta":[{"id":"toolu_012wz3QEBDncUZ1ZdRwVZrj4","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
