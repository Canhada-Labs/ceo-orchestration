hed\n511\t            # path. The launcher indirection is skipped: the override IS\n512\t            # the payload we hash and compare.\n513\t            payload: Optional[Path] = Path(payload_override)\n514\t            try:\n515\t                is_regular = payload.is_file()\n516\t            except OSError:\n517\t                is_regular = False\n518\t            if not is_regular:\n519\t                result[\"status\"] = \"mismatch\"\n520\t                result[\"detail\"] = \"override_payload_missing\"\n521\t                return result\n522\t        else:\n523\t            payload = _resolve_codex_payload(launcher_path, rel_path, triple)\n524\t            if payload is None:\n525\t                # The launcher itself would throw \"Missing optional\n526\t                # dependency\" here — codex cannot run at all → INFRA.\n527\t                result[\"detail\"] = \"payload_not_resolved\"\n528\t                return result\n529\t        result[\"path\"] = str(payload)\n530\t\n531\t        actual = _sha256_file(payload)\n532\t        if actual is None:\n533\t            result[\"detail\"] = \"payload_unreadable\"\n534\t            return result\n535\t        result[\"sha256\"] = actual\n536\t\n537\t        if actual != expected:\n538\t            if _apply_currency_policy(payload, launcher_path, manifest, result):\n539\t                return result\n540\t            result[\"status\"] = \"mismatch\"\n541\t            result[\"detail\"] = \"payload_sha256_mismatch\"\n542\t            return result\n543\t\n544\t        result[\"status\"] = \"verified\"\n545\t        result[\"detail\"] = \"ok\"\n546\t        return result\n547\t    except Exception as e:  # defensive: kernel never raises\n548\t        result[\"status\"] = \"infra\"\n549\t        result[\"detail\"] = f\"unexpected:{type(e).__name__}\"\n550\t        return result\n551\t\n552\t\n553\tdef _apply_currency_policy(\n554\t    payload: Path, launcher: Optional[Path], manifest: Dict[str, Any], result: Dict[str, Any],\n555\t) -> bool:\n556\t    \"\"\"Record qualified version and apply only the explicitly allowed currency arm.\"\"\"\n557\t    installed = _cli_currency.qualified_package_version(payload, launcher)\n558\t    result[\"installed_version\"] = installed or \"\"\n559\t    if installed is None:\n560\t        return False\n561\t    manifest_version = manifest.get(\"package_version\")\n562\t    if _cli_currency.parse_semver(manifest_version) is None:\n563\t        result[\"status\"] = \"mismatch\"\n564\t        result[\"detail\"] = \"manifest_package_version_malformed\"\n565\t        return True\n566\t    if _cli_currency.compatible_package_version(payload, launcher, manifest_version):\n567\t        result[\"status\"] = \"compatible\"\n568\t        result[\"detail\"] = \"version_floor_only\"\n569\t        result[\"path\"] = str(payload)\n570\t        return True\n571\t    return False\n572\t\n573\t\n574\tdef _resolve_codex_bin() -> Optional[str]:\n575\t    \"\"\"Return verified or floor-compatible native payload; infra is None.\"\"\"\n576\t    override = os.environ.get(\"CEO_PAIR_RAIL_CODEX_BIN\")\n577\t    res = (\n578\t        verify_codex_payload(payload_override=override)\n579\t        if override\n580\t        else verify_codex_payload()\n581\t    )\n582\t    status = res.get(\"status\")\n583\t    if status in (\"verified\", \"compatible\"):\n584\t        return str(res.get(\"path\") or \"\") or None\n585\t    if status == \"infra\":"}]},"parent_tool_use_id":null,"session_id":"44c9ec98-ac5f-45ac-a8b8-721313d99788","uuid":"393ad407-beec-47d9-9325-a73e87dff714","timestamp":"2026-11-16T18:42:41.258Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_pair_rail_parts/part_01.py","content":"            result[\"detail\"] = \"manifest_unreadable\"\n            return result\n\n        entry = manifest[\"payloads\"].get(triple)\n        if entry is N