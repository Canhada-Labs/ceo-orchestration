{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JHv3GAWpnahDU9UvYgcagn","type":"tool_result","content":"1\t\"\"\"Signature verification rail for canonical-edit sentinel checks.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\t__all__ = (\"_verify_signature_rail\",)\n5\t\n6\tdef _verify_signature_rail(sentinel_path: Path) -> bool:\n7\t    \"\"\"The full detached-GPG + dual signer-registry rail for ONE sentinel.\n8\t\n9\t    Extracted verbatim from ``_sentinel_grants_path`` (PLAN162_FIX_1) so\n10\t    the decision it produces — which is INDEPENDENT of the edit target —\n11\t    can be cached target-free. Behaviour is unchanged: fail-CLOSED on a\n12\t    missing helper, bad signature, unlisted fingerprint, bootstrap-SHA\n13\t    mismatch, or (post-GENESIS) a registry parse failure.\n14\t    \"\"\"\n15\t    if _gpg_verify is None:\n16\t        # _lib.gpg_verify is unavailable — fail-CLOSED. No sentinel\n17\t        # can grant canonical edits without the verification helper.\n18\t        return False\n19\t    sig_path = sentinel_path.with_name(sentinel_path.name + \".asc\")\n20\t    # PLAN-089 Wave C.4 — dual-rail signer verification (ADR-121).\n21\t    # First-class path: legacy `.claude/sentinel-signers.txt` (existing).\n22\t    # Defense-in-depth: if YAML registry exists, re-check fingerprint via\n23\t    # _lib.sentinel_signers + bootstrap-SHA pin. Either rail rejecting\n24\t    # → fail-CLOSED. Post-GENESIS (_BOOTSTRAP_REGISTRY_SHA256 set),\n25\t    # parse/hash failure → fail-CLOSED (R2 Codex iter-1 Q5+Q7 fold);\n26\t    # pre-GENESIS (None), parse failure → legacy-only fallback.\n27\t    # PLAN162_FIX_1 (Codex P1 fold) — the subprocess is bounded by what is\n28\t    # LEFT of the invocation budget, minus the margin needed to still emit\n29\t    # a decision. ``None`` => not enough budget to verify AND emit: refuse\n30\t    # the spawn and latch, so the caller's next deadline poll produces the\n31\t    # fail-closed wall-deadline block instead of a harness kill.\n32\t    _timeout = _gpg_verify_timeout()\n33\t    if _timeout is None:\n34\t        _mark_wall_budget_exhausted()\n35\t        return False\n36\t    ok, _fpr, _reason = _gpg_verify.verify_detached(\n37\t        sentinel_path,\n38\t        sig_path,\n39\t        allowlist_path=_SENTINEL_SIGNERS_FILE,\n40\t        timeout=_timeout,\n41\t    )\n42\t    if not ok:\n43\t        return False\n44\t    if (\n45\t        _sentinel_signers is not None\n46\t        and _SENTINEL_SIGNERS_REGISTRY_YAML.exists()\n47\t        and _fpr\n48\t    ):\n49\t        _post_genesis = _BOOTSTRAP_REGISTRY_SHA256 is not None\n50\t        try:\n51\t            # Bootstrap SHA pin verification (post-GENESIS only).\n52\t            if _post_genesis:\n53\t                import hashlib as _hashlib\n54\t                _yaml_bytes = _SENTINEL_SIGNERS_REGISTRY_YAML.read_bytes()\n55\t                _computed_sha = _hashlib.sha256(_yaml_bytes).hexdigest()\n56\t                if _computed_sha != _BOOTSTRAP_REGISTRY_SHA256:\n57\t                    try:\n58\t                        from _lib import audit_emit as _audit_emit\n59\t                        if hasattr(_audit_emit, \"emit_sentinel_signer_quorum_failed\"):\n60\t                            _audit_emit.emit_sentinel_signer_quorum_failed(\n61\t                                key_id=_fpr,\n62\t                                reason=\"bootstrap_sha_mismatch\",\n63\t                                source=\"canonical_edit_bootstrap_pin\",\n64\t                            )\n65\t                    except Exception:  # pragma: no cover\n66\t                        pass\n67\t                    return False\n68\t            _registry = _sentinel_signers.load_registry(\n69\t                _SENTINEL_SIGNERS_REGISTRY_YAML\n70\t            )\n71\t            _valid, _why = _sentinel_signers.is_valid_signer(\n72\t                _fpr, registry=_registry\n73\t            )\n74\t            # PLAN-113 WIRE-AUDIT: emit quorum_attempted on EVERY\n75\t            # signer verification attempt (success + failure).\n76\t            try:\n77\t                from _lib import audit_emit as _audit_emit_qa\n78\t                if hasattr(_audit_emit_qa, \"emit_sentinel_signer_quorum_attempted\"):\n79\t                    _audit_emit_qa.emit_sentinel_signer_quorum_attempted(\n80\t                        distinct_signers=1,\n81\t                        threshold_required=1,\n82\t                        outcome=\"valid\" if _valid else \"failed\",\n83\t                        source=\"canonical_edit_sentinel_verify\",\n84\t                    )\n85\t            except Exception:  # pragma: no cover\n86\t                pass\n87\t            if not _valid:\n88\t                try:\n89\t                    from _lib import audit_emit as _audit_emit\n90\t                    if hasattr(_audit_emit, \"emit_sentinel_signer_quorum_failed\"):\n91\t                        _audit_emit.emit_sentinel_signer_quorum_failed(\n92\t                            key_id=_fpr,\n93\t                            reason=_why,\n94\t                            source=\"canonical_edit_sentinel_verify\",\n95\t                        )\n96\t                except Exception:  # pragma: no cover\n97\t                    pass\n98\t                return False\n99\t        except Exception:  # pragma: no cover\n100\t            # Pre-GENESIS (constant None) — degrade to legacy-only.\n101\t            # Post-GENESIS — fail-CLOSED (R2 Codex Q7 fold).\n102\t            if _BOOTSTRAP_REGISTRY_SHA256 is not None:\n103\t                return False\n104\t    return True\n105\t\n106\t\n107\t\n108\t"}]},"parent_tool_use_id":null,"session_id":"25218e86-87a6-4bef-99f8-c68505010f45","uuid":"2ba237db-03dd-4b6f-acb9-0c2ee150b330","timestamp":"2026-11-16T19:28:39.759Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/canonical_edit/signature_rail.py","content":"\"\"\"Signature verification rail for canonical-edit sentinel checks.\"\"\"\nfrom __future__ import annotations\n\n__all__ = (\"_verify_signature_rail\",)\n\ndef _verify_signature_rail(sentinel_path: Path) -> bool:\n    \"\"\"The full detached-GPG + dual signer-registry rail for ONE sentinel.\n\n    Extracted verbatim from ``_sentinel_grants_path`` (PLAN162_FIX_1) so\n    the decision it produces — which is INDEPENDENT of the edit target —\n    can be cached target-free. Behaviour is unchanged: fail-CLOSED on a\n    missing helper, bad signature, unlisted fingerprint, bootstrap-SHA\n    mismatch, or (post-GENESIS) a registry parse failure.\n    \"\"\"\n    if _gpg_verify is None:\n        # _lib.gpg_verify is unavailable — fail-CLOSED. No sentinel\n        # can grant canonical edits without the verification helper.\n        return False\n    sig_path = sentinel_path.with_name(sentinel_path.name + \".asc\")\n    # PLAN-089 Wave C.4 — dual-rail signer verification (ADR-121).\n    # First-class path: legacy `.claude/sentinel-signers.txt` (existing).\n    # Defense-in-depth: if YAML registry exists, re-check fingerprint via\n    # _lib.sentinel_signers + bootstrap-SHA pin. Either rail rejecting\n    # → fail-CLOSED. Post-GENESIS (_BOOTSTRAP_REGISTRY_SHA256 set),\n    # parse/hash failure → fail-CLOSED (R2 Codex iter-1 Q5+Q7 fold);\n    # pre-GENESIS (None), parse failure → legacy-only fallback.\n    # PLAN162_FIX_1 (Codex P1 fold) — the subprocess is bounded by what is\n    # LEFT of the invocation budget, minus the margin needed to still emit\n    # a decision. ``None`` => not enough budget to verify AND emit: refuse\n    # the spawn and latch, so the caller's next deadline poll produces the\n    # fail-closed wall-deadline block instead of a harness kill.\n    _timeout = _gpg_verify_timeout()\n    if _timeout is None:\n        _mark_wall_budget_exhausted()\n        return False\n    ok, _fpr, _reason = _gpg_verify.verify_detached(\n        sentinel_path,\n        sig_path,\n        allowlist_path=_SENTINEL_SIGNERS_FILE,\n        timeout=_timeout,\n    )\n    if not ok:\n        return False\n    if (\n        _sentinel_signers is not None\n        and _SENTINEL_SIGNERS_REGISTRY_YAML.exists()\n        and _fpr\n    ):\n        _post_genesis = _BOOTSTRAP_REGISTRY_SHA256 is not None\n        try:\n            # Bootstrap SHA pin verification (post-GENESIS only).\n            if _post_genesis:\n                import hashlib as _hashlib\n                _yaml_bytes = _SENTINEL_SIGNERS_REGISTRY_YAML.read_bytes()\n                _computed_sha = _hashlib.sha256(_yaml_bytes).hexdigest()\n                if _computed_sha != _BOOTSTRAP_REGISTRY_SHA256:\n                    try:\n                        from _lib import audit_emit as _audit_emit\n                        if hasattr(_audit_emit, \"emit_sentinel_signer_quorum_failed\"):\n                            _audit_emit.emit_sentinel_signer_quorum_failed(\n                                key_id=_fpr,\n                                reason=\"bootstrap_sha_mismatch\",\n                                source=\"canonical_edit_bootstrap_pin\",\n                            )\n                    except Exception:  # pragma: no cover\n                        pass\n                    return False\n            _registry = _sentinel_signers.load_registry(\n                _SENTINEL_SIGNERS_REGISTRY_YAML\n            )\n            _valid, _why = _sentinel_signers.is_valid_signer(\n                _fpr, registry=_registry\n            )\n            # PLAN-113 WIRE-AUDIT: emit quorum_attempted on EVERY\n            # signer verification attempt (success + failure).\n            try:\n                from _lib import audit_emit as _audit_emit_qa\n                if hasattr(_audit_emit_qa, \"emit_sentinel_signer_quorum_attempted\"):\n                    _audit_emit_qa.emit_sentinel_signer_quorum_attempted(\n                        distinct_signers=1,\n                        threshold_required=1,\n                        outcome=\"valid\" if _valid else \"failed\",\n                        source=\"canonical_edit_sentinel_verify\",\n                    )\n            except Exception:  # pragma: no cover\n                pass\n            if not _valid:\n                try:\n                    from _lib import audit_emit as _audit_emit\n                    if hasattr(_audit_emit, \"emit_sentinel_signer_quorum_failed\"):\n                        _audit_emit.emit_sentinel_signer_quorum_failed(\n                            key_id=_fpr,\n                            reason=_why,\n                            source=\"canonical_edit_sentinel_verify\",\n                        )\n                except Exception:  # pragma: no cover\n                    pass\n                return False\n        except Exception:  # pragma: no cover\n            # Pre-GENESIS (constant None) — degrade to legacy-only.\n            # Post-GENESIS — fail-CLOSED (R2 Codex Q7 fold).\n            if _BOOTSTRAP_REGISTRY_SHA256 is not None:\n                return False\n    return True\n\n\n\n","numLines":108,"startLine":1,"totalLines":108}},"tool_result_meta":[{"id":"toolu_01JHv3GAWpnahDU9UvYgcagn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7ACZW3dkvpTC5B8bGqB","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MwFebKCbUhLZupFrUyKEXw","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/canonical_edit/sentinels.py","offset":1,"limit":140},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2952,"cache_read_input_tokens":140761,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2952},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"25218e86-87a6-4bef-99f8-c68505010f45","uuid":"cb4e9697-6fe0-42c1-832c-981cfd48f418","timestamp":"2026-11-16T19:28:41.846Z","request_id":"req_011Ch7ACZGQXanL9Z1eA3p3z","wire_tool_inputs":{"toolu_01MwFebKCbUhLZupFrUyKEXw":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/canonical_edit/sentinels.py","offset":1,"limit":140}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MwFebKCbUhLZupFrUyKEXw","type":"tool_result","content":"1\t\"\"\"Sentinel scope, signature caches and unlock provenance.\n2\t\n3\tFunctions are bound to the owning hook namespace by ``bind``. This keeps\n4\tits injectable dependencies and per-import state on the public hook.\n5\t\"\"\"\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_parse_scope_paths_from_text', '_sentinel_cache_disabled', '_compute_sentinel_cache_key', '_file_digest', '_compute_sig_cache_key', 'sentinel_cache_stats', '_signature_rail_ok', '_repo_root_for_sentinels', '_reset_unlock_trust_diag', '_note_unlock_trust_diag', '_git_anchor_timeout', '_anchored_blob_text', '_pinned_sentinel_digests', '_unlock_trusted_text', '_unlock_trust_hint', '_sentinel_grants_path')\n9\t\n10\t\n11\tdef _parse_scope_paths_from_text(scope_text: str) -> \"Set[str]\":\n12\t    \"\"\"Extract declared canonical paths from a Scope block.\n13\t\n14\t    PLAN-064 Option D — extracted helper used by both Tier-1 (marker\n15\t    region) and Tier-2 (legacy `_SCOPE_HEADER_RE`) parser paths.\n16\t\n17\t    The Scope block extends from the `Scope` header line to the first\n18\t    top-level continuation header (Effective:, Plans:, Rationale,\n19\t    Authorization source:, Anchor commit:, a re-encountered\n20\t    `Approved-By:`) or markdown horizontal rule (---, ***, ___) or\n21\t    end-of-text. Sub-headers within Scope (lines ending with `:` that\n22\t    are NOT in the terminator set) are silently skipped.\n23\t    \"\"\"\n24\t    import os as _os\n25\t    declared_paths: Set[str] = set()\n26\t    scope_header = _SCOPE_HEADER_RE.search(scope_text)\n27\t    if not scope_header:\n28\t        return declared_paths\n29\t    post = scope_text[scope_header.end():]\n30\t    for line in post.splitlines():\n31\t        if _SCOPE_TERMINATOR_RE.match(line) or _SCOPE_HR_RE.match(line):\n32\t            break\n33\t        m = re.match(r\"\\s*-\\s*(\\S+)\", line)\n34\t        if not m:\n35\t            # Blank line or sub-header (e.g. \"Hook code (PLAN-052):\") —\n36\t            # keep collecting; only the explicit terminators stop us.\n37\t            continue\n38\t        raw = m.group(1)\n39\t        # PLAN-024 F-sec-003 P1 fix: reject any control-char in scope\n40\t        # entries (bidi, null, ANSI escape, etc.) before normalization.\n41\t        if any(ord(c) < 0x20 for c in raw):\n42\t            continue\n43\t        # Normalize `./foo/bar` -> `foo/bar` and strip any ending\n44\t        # separator so sentinel-declared paths match target_rel\n45\t        # resolution consistently.\n46\t        normalized = _os.path.normpath(raw).replace(_os.sep, \"/\")\n47\t        if normalized == \".\":\n48\t            continue\n49\t        declared_paths.add(normalized)\n50\t    return declared_paths\n51\t\n52\t\n53\t\n54\tdef _sentinel_cache_disabled() -> bool:\n55\t    \"\"\"Kill-switch CEO_SENTINEL_SESSION_CACHE_DISABLED=1 bypasses cache.\"\"\"\n56\t    return os.environ.get(\"CEO_SENTINEL_SESSION_CACHE_DISABLED\", \"\") == \"1\"\n57\t\n58\t\n59\t\n60\tdef _compute_sentinel_cache_key(\n61\t    sentinel_path: Path,\n62\t    target_rel: str = \"\",\n63\t) -> Optional[Tuple[str, int, int, int, str, str, int]]:\n64\t    \"\"\"Return composite key or None on stat/read failure (don't cache errors).\n65\t\n66\t    iter-1 P0 fix: target_rel included so cache value (grant decision\n67\t    dependent on target_rel) is correct on hit.\n68\t    \"\"\"\n69\t    try:\n70\t        st = sentinel_path.stat()\n71\t        content = sentinel_path.read_bytes()\n72\t    except OSError:\n73\t        return None\n74\t    return (\n75\t        str(sentinel_path),\n76\t        st.st_ino,\n77\t        st.st_mtime_ns,\n78\t        st.st_size,\n79\t        hashlib.sha256(content).hexdigest(),\n80\t        target_rel,\n81\t        _SENTINEL_CACHE_FORMAT_VERSION,\n82\t    )\n83\t\n84\t\n85\t\n86\tdef _file_digest(path: Optional[Path]) -> str:\n87\t    \"\"\"sha256 of a file's bytes, or a stable marker when unreadable.\n88\t\n89\t    PLAN162_FIX_1 helper. ``\"-\"`` distinguishes \"no such file\" from any\n90\t    real digest, so a signer allowlist APPEARING (or vanishing) changes\n91\t    the signature cache key just like editing it does.\n92\t    \"\"\"\n93\t    if path is None:\n94\t        return \"-\"\n95\t    try:\n96\t        return hashlib.sha256(path.read_bytes()).hexdigest()\n97\t    except OSError:\n98\t        return \"-\"\n99\t\n100\t\n101\t\n102\tdef _compute_sig_cache_key(sentinel_path: Path) -> Optional[tuple]:\n103\t    \"\"\"Target-FREE key over everything the SIGNATURE decision depends on.\n104\t\n105\t    PLAN162_FIX_1 (#1 partition + #10 staleness). Covers the sentinel's\n106\t    own identity/bytes AND the three signing-material inputs — the\n107\t    detached ``.asc``, the legacy signer allowlist, and the ADR-121 YAML\n108\t    registry — plus the PATH of the latter two (they are module-level\n109\t    seams; a different file is a different decision).\n110\t\n111\t    Returns ``None`` on stat/read failure of the sentinel itself, which\n112\t    means \"do not cache\" — errors are never memoized.\n113\t    \"\"\"\n114\t    try:\n115\t        st = sentinel_path.stat()\n116\t        content = sentinel_path.read_bytes()\n117\t    except OSError:\n118\t        return None\n119\t    sig_path = sentinel_path.with_name(sentinel_path.name + \".asc\")\n120\t    return (\n121\t        str(sentinel_path),\n122\t        st.st_ino,\n123\t        st.st_mtime_ns,\n124\t        st.st_size,\n125\t        hashlib.sha256(content).hexdigest(),\n126\t        _file_digest(sig_path),\n127\t        str(_SENTINEL_SIGNERS_FILE),\n128\t        _file_digest(_SENTINEL_SIGNERS_FILE),\n129\t        str(_SENTINEL_SIGNERS_REGISTRY_YAML),\n130\t        _file_digest(_SENTINEL_SIGNERS_REGISTRY_YAML),\n131\t        _SIG_CACHE_FORMAT_VERSION,\n132\t    )\n133\t\n134\t\n135\t\n136\tdef sentinel_cache_stats() -> Dict[str, int]:\n137\t    \"\"\"Return session-scoped cache counters (skill_cache_stats sibling).\"\"\"\n138\t    return {\n139\t        \"hit_count\": _SENTINEL_CACHE_HITS,\n140\t        \"miss_count\": _SENTINEL_CACHE_MISSES,"}]},"parent_tool_use_id":null,"session_id":"25218e86-87a6-4bef-99f8-c68505010f45","uuid":"a5af2ba1-4d0b-4331-adb5-debc85ad61fe","timestamp":"2026-11-16T19:28:41.861Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/canonical_edit/sentinels.py","content":"\"\"\"Sentinel scope, signature caches and unlock provenance.\n\nFunctions are bound to the owning hook namespace by ``bind``. This keeps\nits injectable dependencies and per-import state on the public hook.\n\"\"\"\nfrom __future__ import annotations\n\n__all__ = ('_parse_scope_paths_from_text', '_sentinel_cache_disabled', '_compute_sentinel_cache_key', '_file_digest', '_compute_sig_cache_key', 'sentinel_cache_stats', '_signature_rail_ok', '_repo_root_for_sentinels', '_reset_unlock_trust_diag', '_note_unlock_trust_diag', '_git_anchor_timeout', '_anchored_blob_text', '_pinned_sentinel_digests', '_unlock_trusted_text', '_unlock_trust_hint', '_sentinel_grants_path')\n\n\ndef _parse_scope_paths_from_text(scope_text: str) -> \"Set[str]\":\n    \"\"\"Extract declared canonical paths from a Scope block.\n\n    PLAN-064 Option D — extracted helper used by both Tier-1 (marker\n    region) and Tier-2 (legacy `_SCOPE_HEADER_RE`) parser paths.\n\n    The Scope block extends from the `Scope` header line to the first\n    top-level continuation header (Effective:, Plans:, Rationale,\n    Authorization source:, Anchor commit:, a re-encountered\n    `Approved-By:`) or markdown horizontal rule (---, ***, ___) or\n    end-of-text. Sub-headers within Scope (lines ending with `:` that\n    are NOT in the terminator set) are silently skipped.\n    \"\"\"\n    import os as _os\n    declared_paths: Set[str] = set()\n    scope_header = _SCOPE_HEADER_RE.search(scope_text)\n    if not scope_header:\n        return declared_paths\n    post = scope_text[scope_header.end():]\n    for line in post.splitlines():\n        if _SCOPE_TERMINATOR_RE.match(line) or _SCOPE_HR_RE.match(line):\n            break\n        m = re.match(r\"\\s*-\\s*(\\S+)\", line)\n        if not m:\n            # Blank line or sub-header (e.g. \"Hook code (PLAN-052):\") —\n            # keep collecting; only the explicit terminators stop us.\n            continue\n        raw = m.group(1)\n        # PLAN-024 F-sec-003 P1 fix: reject any control-char in scope\n        # entries (bidi, null, ANSI escape, etc.) before normalization.\n        if any(ord(c) < 0x20 for c in raw):\n            continue\n        # Normalize `./foo/bar` -> `foo/bar` and strip any ending\n        # separator so sentinel-declared paths match target_rel\n        # resolution consistently.\n        normalized = _os.path.normpath(raw).replace(_os.sep, \"/\")\n        if normalized == \".\":\n            continue\n        declared_paths.add(normalized)\n    return declared_paths\n\n\n\ndef _sentinel_cache_disabled() -> bool:\n    \"\"\"Kill-switch CEO_SENTINEL_SESSION_CACHE_DISABLED=1 bypasses cache.\"\"\"\n    return os.environ.get(\"CEO_SENTINEL_SESSION_CACHE_DISABLED\", \"\") == \"1\"\n\n\n\ndef _compute_sentinel_cache_key(\n    sentinel_path: Path,\n    target_rel: str = \"\",\n) -> Optional[Tuple[str, int, int, int, str, str, int]]:\n    \"\"\"Return composite key or None on stat/read failure (don't cache errors).\n\n    iter-1 P0 fix: target_rel included so cache value (grant decision\n    dependent on target_rel) is correct on hit.\n    \"\"\"\n    try:\n        st = sentinel_path.stat()\n        content = sentinel_path.read_bytes()\n    except OSError:\n        return None\n    return (\n        str(sentinel_path),\n        st.st_ino,\n        st.st_mtime_ns,\n        st.st_size,\n        hashlib.sha256(content).hexdigest(),\n        target_rel,\n        _SENTINEL_CACHE_FORMAT_VERSION,\n    )\n\n\n\ndef _file_digest(path: Optional[Path]) -> str:\n    \"\"\"sha256 of a file's bytes, or a stable marker when unreadable.\n\n    PLAN162_FIX_1 helper. ``\"-\"`` distinguishes \"no such file\" from any\n    real digest, so a signer allowlist APPEARING (or vanishing) changes\n    the signature cache key just like editing it does.\n    \"\"\"\n    if path is None:\n        return \"-\"\n    try:\n        return hashlib.sha256(path.read_bytes()).hexdigest()\n    except OSError:\n        return \"-\"\n\n\n\ndef _compute_sig_cache_key(sentinel_path: Path) -> Optional[tuple]:\n    \"\"\"Target-FREE key over everything the SIGNATURE decision depends on.\n\n    PLAN162_FIX_1 (#1 partition + #10 staleness). Covers the sentinel's\n    own identity/bytes AND the three signing-material inputs — the\n    detached ``.asc``, the legacy signer allowlist, and the ADR-121 YAML\n    registry — plus the PATH of the latter two (they are module-level\n    seams; a different file is a different decision).\n\n    Returns ``None`` on stat/read failure of the sentinel itself, which\n    means \"do not cache\" — errors are never memoized.\n    \"\"\"\n    try:\n        st = sentinel_path.stat()\n        content = sentinel_path.read_bytes()\n    except OSError:\n        return None\n    sig_path = sentinel_path.with_name(sentinel_path.name + \".asc\")\n    return (\n        str(sentinel_path),\n        st.st_ino,\n        st.st_mtime_ns,\n        st.st_size,\n        hashlib.sha256(content).hexdigest(),\n        _file_digest(sig_path),\n        str(_SENTINEL_SIGNERS_FILE),\n        _file_digest(_SENTINEL_SIGNERS_FILE),\n        str(_SENTINEL_SIGNERS_REGISTRY_YAML),\n        _file_digest(_SENTINEL_SIGNERS_REGISTRY_YAML),\n        _SIG_CACHE_FORMAT_VERSION,\n    )\n\n\n\ndef sentinel_cache_stats() -> Dict[str, int]:\n    \"\"\"Return session-scoped cache counters (skill_cache_stats sibling).\"\"\"\n    return {\n        \"hit_count\": _SENTINEL_CACHE_HITS,\n        \"miss_count\": _SENTINEL_CACHE_MISSES,","numLines":140,"startLine":1,"totalLines":582}},"tool_result_meta":[{"id":"toolu_01MwFebKCbUhLZupFrUyKEXw","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
