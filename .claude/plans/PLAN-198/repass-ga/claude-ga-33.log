{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PV8fHvnxifsK8utZyAG5Gc","type":"tool_result","content":"1\t\"\"\"Extracted implementation: latency.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport hashlib\n6\timport json\n7\timport math\n8\timport os\n9\timport shutil\n10\timport subprocess\n11\timport sys\n12\timport tempfile\n13\timport time\n14\tfrom datetime import datetime, timezone\n15\tfrom pathlib import Path\n16\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n17\t\n18\tdef run_hook_latency(\n19\t    repo_root: Path,\n20\t    iterations: int = 200,\n21\t    p95_ceiling_ms: float = 180.0,\n22\t    p99_ceiling_ms: float = 160.0,\n23\t    p99_advisory: bool = False,\n24\t    exec_reference: bool = False,\n25\t    relative_advisory: bool = False,\n26\t    relative_k_source: Optional[str] = None,\n27\t    wall_budget_seconds: float = 420.0,\n28\t    strict_relative: bool = False,\n29\t    sampler: Optional[Callable[[str, str, int], float]] = None,\n30\t) -> Dict[str, Any]:\n31\t    \"\"\"Profile hook latency; full contract in hook_latency_docs.\"\"\"\n32\t    hooks_dir = repo_root / \".claude\" / \"hooks\"\n33\t    agent_spawn = hooks_dir / \"check_agent_spawn.py\"\n34\t    anti_overhead = hooks_dir / \"check_anti_ceo_overhead.py\"\n35\t    output_secrets = hooks_dir / \"check_output_secrets.py\"\n36\t    measured_at = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n37\t    # ADR-163 percentile precondition (PLAN-159 debate round-1 must-fix):\n38\t    # with the nearest-rank truncation in _pct_of_sorted (int((n-1)*p/100)),\n39\t    # p95 and p99 collapse onto the SAME order statistic for n < 22 — the\n40\t    # p99 ceiling becomes dead code and the gate keys on the 2nd-largest\n41\t    # sample (the S272/S273 load-flake class). A gate run on a collapsed\n42\t    # index is a defect state: fail LOUDLY instead of measuring.\n43\t    idx_p95 = int((iterations - 1) * 95 / 100.0)\n44\t    idx_p99 = int((iterations - 1) * 99 / 100.0)\n45\t    if idx_p95 == idx_p99:\n46\t        return {\n47\t            \"schema\": \"profile-opus-4-7.v1\",\n48\t            \"mode\": \"hook_latency\",\n49\t            \"measured_at\": measured_at,\n50\t            \"error\": (\n51\t                \"percentile_indices_collapsed: iterations=%d puts p95 and \"\n52\t                \"p99 on the same order statistic (index %d); minimum is 22, \"\n53\t                \"gate standard is 200 (ADR-163)\" % (iterations, idx_p95)\n54\t            ),\n55\t            \"p95_ceiling_ms\": p95_ceiling_ms,\n56\t            \"p99_ceiling_ms\": p99_ceiling_ms,\n57\t            \"passed\": False,\n58\t        }\n59\t    for required in (agent_spawn, anti_overhead, output_secrets):\n60\t        if not required.is_file():\n61\t            return {\n62\t                \"schema\": \"profile-opus-4-7.v1\",\n63\t                \"mode\": \"hook_latency\",\n64\t                \"measured_at\": measured_at,\n65\t                \"error\": f\"hook not found: {required}\",\n66\t                \"passed\": False,\n67\t            }\n68\t    # --- second-key wiring (ADR-163 Amendment PLAN-169 S328) ---------------\n69\t    # The whole relative machinery — reference sampling AND the wall self-cap\n70\t    # — is gated on the new flags, so a run without them is byte-identical to\n71\t    # today (report keys AND exit code), which is the back-compat contract.\n72\t    second_key = bool(exec_reference or relative_advisory or relative_k_source)\n73\t    relative_warnings: List[str] = []\n74\t    k_by_entry: Dict[str, float] = {}\n75\t    if relative_k_source:\n76\t        k_by_entry, relative_warnings = _load_relative_k_source(relative_k_source)\n77\t        if not exec_reference and k_by_entry:\n78\t            relative_warnings.append(\n79\t                \"relative_k_source_ignored: --relative-k-source needs \"\n80\t                \"--exec-reference (no reference measured, so rel_ok is \"\n81\t                \"undefined); every entry stays on phase 1\"\n82\t            )\n83\t            k_by_entry = {}\n84\t    ref_plan = _ref_schedule(iterations, _REF_SAMPLES_PER_ENTRY) if exec_reference else []\n85\t    t_gate_start = time.perf_counter()\n86\t    wall_deadline_s = _WALL_BUDGET_SAFETY_FRACTION * float(wall_budget_seconds)\n87\t    wall_exceeded = False\n88\t    def _wall_blown() -> bool:\n89\t        if not second_key:\n90\t            return False\n91\t        return (time.perf_counter() - t_gate_start) > wall_deadline_s\n92\t    # Static rail detection: does this tree's tool_lifecycle ship the PLAN-154\n93\t    # observe rail? Drives whether the positive control is REQUIRED (post-\n94\t    # landing) or informational (pre-landing baseline-parity run).\n95\t    observe_rail_present = False\n96\t    try:\n97\t        observe_rail_present = \"observation_store_path\" in (\n98\t            hooks_dir / \"_lib\" / \"tool_lifecycle.py\"\n99\t        ).read_text(encoding=\"utf-8\")\n100\t    except OSError:\n101\t        observe_rail_present = False\n102\t    base_env = {k: v for k, v in os.environ.items()}\n103\t    base_env[\"PYTHONPATH\"] = str(hooks_dir)\n104\t    base_env[\"CLAUDE_PROJECT_DIR\"] = str(repo_root)\n105\t    # Disable all advisory emitters so we measure governance logic only\n106\t    base_env[\"CEO_MODEL_ROUTING\"] = \"0\"\n107\t    base_env[\"CEO_PROMOTION_HEURISTIC\"] = \"0\"\n108\t    base_env[\"CEO_COOKBOOK_ADVISOR_ENABLED\"] = \"0\"\n109\t    base_env[\"CEO_SPEC_CTX_SANITIZER_ENABLED\"] = \"0\"\n110\t    base_env[\"CEO_SPAWN_CONFIDENCE_ENABLED\"] = \"0\"\n111\t    # Deterministic corpus state: no inherited kill-switches / session id.\n112\t    # CLAUDE_PROJECT_DIR_NATIVE is the HIGHEST-PRECEDENCE runtime-state\n113\t    # carrier (runtime_paths): left in the inherited env it overrides both\n114\t    # HOME and CEO_AUDIT_LOG_DIR below, and every measured hook would append\n115\t    # to the LIVE HMAC chain instead of the per-entry throwaway dir — the\n116\t    # S321/S326 non-attributable-elos class. Scrubbing it is unconditional:\n117\t    # it is an isolation fix, not part of the second key, and it changes no\n118\t    # report key and no exit code.\n119\t    for scrubbed in (\n120\t        \"CEO_LEARNING_OBSERVE\",\n121\t        \"CEO_SOTA_DISABLE\",\n122\t        \"CEO_TOOL_LIFECYCLE\",\n123\t        \"CEO_ANTI_OVERHEAD\",\n124\t        \"CLAUDE_SESSION_ID\",\n125\t        \"CLAUDE_PROJECT_DIR_NATIVE\",\n126\t    ):\n127\t        base_env.pop(scrubbed, None)\n128\t    def _spawn_payload(tool_use_id: str) -> bytes:  # noqa: ARG001 — uniform sig\n129\t        return json.dumps({\n130\t            \"session_id\": _LATENCY_SESSION_ID,\n131\t            \"tool_name\": \"Agent\",\n132\t            \"tool_input\": {\"description\": \"latency probe\", \"prompt\": \"bench\"},\n133\t        }).encode()\n134\t    corpus: List[Dict[str, Any]] = [\n135\t        {\n136\t            \"name\": \"check_agent_spawn\",\n137\t            \"hook\": agent_spawn,\n138\t            \"payload\": _spawn_payload,\n139\t            \"env_set\": {},\n140\t            \"seed\": False,\n141\t        },\n142\t        {\n143\t            \"name\": \"check_anti_ceo_overhead[observe=unset]\",\n144\t            \"hook\": anti_overhead,\n145\t            \"payload\": _latency_pre_payload,\n146\t            \"env_set\": {},\n147\t            \"seed\": False,\n148\t        },\n149\t        {\n150\t            \"name\": \"check_anti_ceo_overhead[observe=1]\",\n151\t            \"hook\": anti_overhead,\n152\t            \"payload\": _latency_pre_payload,\n153\t            \"env_set\": {\"CEO_LEARNING_OBSERVE\": \"1\"},\n154\t            \"seed\": False,\n155\t        },\n156\t        {\n157\t            \"name\": \"check_output_secrets[observe=unset]\",\n158\t            \"hook\": output_secrets,\n159\t            \"payload\": _latency_post_payload,\n160\t            \"env_set\": {},\n161\t            \"seed\": True,\n162\t        },\n163\t        {\n164\t            \"name\": \"check_output_secrets[observe=1]\",\n165\t            \"hook\": output_secrets,\n166\t            \"payload\": _latency_post_payload,\n167\t            \"env_set\": {\"CEO_LEARNING_OBSERVE\": \"1\"},\n168\t            \"seed\": True,\n169\t        },\n170\t    ]\n171\t    observe_store_name = _LATENCY_SESSION_ID + \".observe.jsonl\"\n172\t    hooks_out: Dict[str, Dict[str, Any]] = {}\n173\t    all_within_budget = True\n174\t    # rail round-1 P2 — a K file may only name entries that EXIST. Without\n175\t    # this, one typo armed phase 2 for the whole run while applying K to\n176\t    # nothing: `any_enforced` keys on `bool(k_by_entry)`, so every entry\n177\t    # classified with `k_e=None` (label \"pass\" whenever the absolute key was\n178\t    # met, and — the actual hole — a run that phase 1 would exit 1 on could\n179\t    # aggregate to \"pass\" and exit 0). Rejecting the name keeps the loader's\n180\t    # stated contract: a rejection is NAMED and degrades to PHASE 1, never\n181\t    # to a silently wider gate.\n182\t    if k_by_entry:\n183\t        _known_names = {e[\"name\"] for e in corpus}\n184\t        for _unknown in sorted(set(k_by_entry) - _known_names):\n185\t            relative_warnings.append(\n186\t                \"relative_k_unknown_entry[%s]: not a corpus entry name; \"\n187\t                \"dropped (the run stays on phase 1 unless another K \"\n188\t                \"applies)\" % _unknown\n189\t            )\n190\t            k_by_entry.pop(_unknown)\n191\t    for entry in corpus:\n192\t        if _wall_blown():\n193\t            wall_exceeded = True\n194\t            break\n195\t        entry_tmp = Path(tempfile.mkdtemp(prefix=\"ceo-hook-latency-\"))\n196\t        try:\n197\t            env = dict(base_env)\n198\t            env[\"HOME\"] = str(entry_tmp / \"home\")\n199\t            env[\"CEO_AUDIT_LOG_DIR\"] = str(entry_tmp / \"audit\")\n200\t            env.update(entry[\"env_set\"])\n201\t            (entry_tmp / \"home\").mkdir(parents=True, exist_ok=True)\n202\t            (entry_tmp / \"audit\").mkdir(parents=True, exist_ok=True)\n203\t            # Reference lane: its own dir, SIBLING of the audit dir (same\n204\t            # filesystem, which is the whole point of term 3) and never\n205\t            # inside it — the observe-rail positive control must keep\n206\t            # counting exactly the rows the hooks wrote. PYTHONPATH is\n207\t            # dropped so the reference cannot import the hook tree even by\n208\t            # accident (anti-coupling contract).\n209\t            ref_env = dict(env)\n210\t            ref_env.pop(\"PYTHONPATH\", None)\n211\t            ref_dir = entry_tmp / \"ref\"\n212\t            ref_script = entry_tmp / \"ref_exec.py\"\n213\t            if exec_reference and sampler is None:\n214\t                ref_dir.mkdir(parents=True, exist_ok=True)\n215\t                ref_script.write_text(_REF_EXEC_SOURCE, encoding=\"utf-8\")\n216\t            # Codex pair-rail S265 P2: a hook that exits non-zero (import\n217\t            # or runtime error) must FAIL the gate, not silently record a\n218\t            # small latency sample. Hooks always exit 0 by contract, so any\n219\t            # non-zero return is a real failure — capture it for seed AND\n220\t            # timed runs and fold it into entry_passed (the S254 vacuous-\n221\t            # green class this profiler exists to prevent).\n222\t            entry_hook_failed = False\n223\t            # rail round-1 P1 — the SAME rule as the line above, for the lane\n224\t            # that did not have it. The reference is a MEASUREMENT of how\n225\t            # fast this runner executes; a process that died on an import,\n226\t            # a missing dir or a permission is not a slow reference, it is\n227\t            # NO reference. Discarding its return code let a fast, repeatable\n228\t            # failure (~15ms, low split-half drift) present as a perfectly\n229\t            # healthy `ref_valid=true` — and a tiny ref_p50 is the worst\n230\t            # possible poison for phase 2, where K_e is pinned from\n231\t            # max(hook_p50/ref_p50): one broken run pins K enormous and buys\n232\t            # blanket amnesty forever after.\n233\t            entry_ref_failed = False\n234\t            def _run_once(tag: str, kind: str = \"warm\", index: int = 0) -> float:\n235\t                nonlocal entry_hook_failed\n236\t                if sampler is not None:\n237\t                    # Injected measurement: no subprocess at all (seed\n238\t                    # included). Unit tests plant regressions at the\n239\t                    # predicate level instead of via time.sleep.\n240\t                    return float(sampler(entry[\"name\"], kind, index))\n241\t                tool_use_id = \"profile-tu-\" + tag\n242\t                if entry[\"seed\"]:\n243\t                    # Unmeasured Pre stamp via the REAL record_pre carrier so\n244\t                    # the timed record_post run takes the paired path.\n245\t                    # ADR-163: a >10s stall is folded into the fail-closed\n246\t                    # sink instead of raising an opaque TimeoutExpired\n247\t                    # traceback (more subprocess calls at N=200 raise the\n248\t                    # cumulative odds of one stall on a contended runner).\n249\t                    try:\n250\t                        seed_res = subprocess.run(\n251\t                            [sys.executable, str(anti_overhead)],\n252\t                            input=_latency_pre_payload(tool_use_id),\n253\t                            capture_output=True,\n254\t                            env=env,\n255\t                            cwd=str(repo_root),\n256\t                            timeout=10,\n257\t                        )\n258\t                        if seed_res.returncode != 0:\n259\t                            entry_hook_failed = True\n260\t                    except subprocess.TimeoutExpired:\n261\t                        entry_hook_failed = True\n262\t                payload = entry[\"payload\"](tool_use_id)\n263\t                t0 = time.perf_counter_ns()\n264\t                try:\n265\t                    res = subprocess.run(\n266\t                        [sys.executable, str(entry[\"hook\"])],\n267\t                        input=payload,\n268\t                        capture_output=True,\n269\t                        env=env,\n270\t                        cwd=str(repo_root),\n271\t                        timeout=10,\n272\t                    )\n273\t                    if res.returncode != 0:\n274\t                        entry_hook_failed = True\n275\t                except subprocess.TimeoutExpired:\n276\t                    # ADR-163: stall == hook failure (fail-closed, clean\n277\t                    # report instead of an uncaught traceback); the ~10s\n278\t                    # elapsed sample also breaches the ceiling by itself.\n279\t                    entry_hook_failed = True\n280\t                return (time.perf_counter_ns() - t0) / 1_000_000.0\n281\t            def _run_ref(index: int) -> float:\n282\t                nonlocal entry_ref_failed\n283\t                if sampler is not None:\n284\t                    return float(sampler(entry[\"name\"], \"ref\", index))\n285\t                t0 = time.perf_counter_ns()\n286\t                # INVERTED predicate. The rail found this same class twice —\n287\t                # round-1 P1 (return code discarded) and round-2 P2 (timeout\n288\t                # left unmarked) — which per the repo's own rule means the\n289\t                # ARCHITECTURE of the cure is wrong, not the round. So the\n290\t                # reference is DISTRUSTED by default and earns trust on\n291\t                # exactly one path: the process ran to completion and exited\n292\t                # 0. A branch added later that forgets to mark failure cannot\n293\t                # reintroduce the hole, because failure is what the variable\n294\t                # already says.\n295\t                #\n296\t                # Why neither shape check can stand in for this: a fast crash\n297\t                # is a small, finite, low-drift sample, and a MINORITY of 10s\n298\t                # stalls does not move a median — measured, 3 timeouts among\n299\t                # the 40 samples give ref_p50=50.0 and split-half drift=1.000\n300\t                # against a 1.5 ceiling, so the classifier answered `pass`\n301\t                # with `ref_valid=True` over three processes that never\n302\t                # completed. The median is what makes this gate robust to\n303\t                # runner noise (ADR-163:258); that robustness is exactly what\n304\t                # blinds it here. Statistics cannot answer \"did the process\n305\t                # finish\".\n306\t                completed_ok = False\n307\t                try:\n308\t                    res = subprocess.run(\n309\t                        [sys.executable, str(ref_script), str(ref_dir)],\n310\t                        capture_output=True,\n311\t                        env=ref_env,\n312\t                        cwd=str(entry_tmp),\n313\t                        timeout=10,\n314\t                    )\n315\t                    completed_ok = res.returncode == 0\n316\t                except subprocess.TimeoutExpired:\n317\t                    # A stalled reference is a contention signal, not a hook\n318\t                    # verdict; it reads as infrastructure_contended.\n319\t                    pass\n320\t                if not completed_ok:\n321\t                    entry_ref_failed = True\n322\t                return (time.perf_counter_ns() - t0) / 1_000_000.0\n323\t            cold_ms = _run_once(\"cold\", \"cold\", 0)\n324\t            warm: List[float] = []\n325\t            ref_samples: List[float] = []\n326\t            # ROUND-ROBIN: the reference is sampled INSIDE the hook loop, so\n327\t            # both keys price the same scheduler window. The S318 defect was\n328\t            # a probe measured once, outside the window that degraded.\n329\t            for i in range(iterations):\n330\t                # rail round-1 P2 — checked EVERY iteration, not every tenth.\n331\t                # The self-cap exists to guarantee a structured wall-capped\n332\t                # result instead of the outer 420s timeout's rc124, and the\n333\t                # stride broke that guarantee on exactly the runner it was\n334\t                # written for: one iteration can spend 10s in the seed, 10s\n335\t                # in the hook and 10s in the reference, so a check passing\n336\t                # just under the 378s deadline could be followed by ~300s\n337\t                # unchecked. `_wall_blown()` is one perf_counter subtraction;\n338\t                # paying it 200 times instead of 20 costs microseconds and is\n339\t                # not measurable against a 180ms budget.\n340\t                if second_key and i and _wall_blown():\n341\t                    wall_exceeded = True\n342\t                    break\n343\t                warm.append(_run_once(\"%04d\" % i, \"warm\", i))\n344\t                # Re-checked BEFORE the reference lane: with the hook sample\n345\t                # already paid, the remaining reference runs of this same\n346\t                # iteration are the last place the overshoot can still grow.\n347\t                if second_key and _wall_blown():\n348\t                    wall_exceeded = True\n349\t                    break\n350\t                for _ in range(ref_plan[i] if i < len(ref_plan) else 0):\n351\t                    ref_samples.append(_run_ref(len(ref_samples)))\n352\t            warm_sorted = sorted(warm)\n353\t            p50 = _pct_of_sorted(warm_sorted, 50)\n354\t            p95 = _pct_of_sorted(warm_sorted, 95)\n355\t            p99 = _pct_of_sorted(warm_sorted, 99)\n356\t            p99_within = p99 <= p99_ceiling_ms\n357\t            entry_passed = (\n358\t                p95 <= p95_ceiling_ms\n359\t                and (p99_advisory or p99_within)\n360\t                and not entry_hook_failed\n361\t            )\n362\t            all_within_budget = all_within_budget and entry_passed\n363\t            hooks_out[entry[\"name\"]] = {\n364\t                \"cold_ms\": round(cold_ms, 1),\n365\t                \"p50_ms\": round(p50, 1),\n366\t                \"p95_ms\": round(p95, 1),\n367\t                \"p99_ms\": round(p99, 1),\n368\t                \"max_ms\": round(max(warm_sorted) if warm_sorted else 0.0, 1),\n369\t                \"hook_failed\": entry_hook_failed,\n370\t                \"p99_within\": p99_within,\n371\t                \"passed\": entry_passed,\n372\t            }\n373\t            if second_key:\n374\t                ref_sorted = sorted(ref_samples)\n375\t                ref_p50 = _pct_of_sorted(ref_sorted, 50) if ref_sorted else 0.0\n376\t                ref_p95 = _pct_of_sorted(ref_sorted, 95) if ref_sorted else 0.0\n377\t                ref_drift = (\n378\t                    _split_half_drift(ref_samples)\n379\t                    if exec_reference\n380\t                    else float(\"inf\")\n381\t                )\n382\t                k_e = k_by_entry.get(entry[\"name\"])\n383\t                label, rel_ok, ref_valid = _classify_entry(\n384\t                    hook_p50=p50,\n385\t                    hook_p95=p95,\n386\t                    ref_p50=ref_p50,\n387\t                    ref_drift=ref_drift,\n388\t                    p95_ceiling_ms=p95_ceiling_ms,\n389\t                    k_e=k_e,\n390\t                    ref_measured=exec_reference,\n391\t                    wall_exceeded=wall_exceeded,\n392\t                    strict_relative=strict_relative,\n393\t                    ref_failed=entry_ref_failed,\n394\t                )\n395\t                stats = hooks_out[entry[\"name\"]]\n396\t                if exec_reference:\n397\t                    stats[\"ref_p50_ms\"] = round(ref_p50, 1)\n398\t                    stats[\"ref_p95_ms\"] = round(ref_p95, 1)\n399\t                    stats[\"ref_samples\"] = len(ref_samples)\n400\t                    stats[\"ref_split_half_drift\"] = (\n401\t                        round(ref_drift, 3) if math.isfinite(ref_drift) else None\n402\t                    )\n403\t                    stats[\"ref_valid\"] = ref_valid\n404\t                    # Published so the exit-5 has a NAME: `ref_valid=false`\n405\t                    # alone cannot tell an operator whether the reference was\n406\t                    # mis-shaped, drifting, or simply never ran.\n407\t                    stats[\"ref_failed\"] = entry_ref_failed\n408\t                if relative_advisory or relative_k_source:\n409\t                    stats[\"R_e\"] = (\n410\t                        round(p50 / ref_p50, 3)\n411\t                        if (exec_reference and ref_valid and ref_p50 > 0)\n412\t                        else None\n413\t                    )\n414\t                    stats[\"K_e\"] = k_e\n415\t                    stats[\"rel_ok\"] = rel_ok\n416\t                    stats[\"verdict_label\"] = label\n417\t                    # Phase is a property of the ENTRY's K, not of the\n418\t                    # outcome: an entry with a usable K whose reference came\n419\t                    # back broken is still phase 2 (its verdict is exit 5),\n420\t                    # while an entry absent from the K file is phase 1.\n421\t                    stats[\"phase\"] = (\n422\t                        \"2-enforcing\" if k_e is not None else \"1-advisory\"\n423\t                    )\n424\t                    if k_e is None and relative_k_source:\n425\t                        relative_warnings.append(\n426\t                            \"relative_k_missing[%s]: no usable K in the \"\n427\t                            \"source file; this entry stays on phase 1 (its \"\n428\t                            \"label follows the absolute key alone)\"\n429\t                            % entry[\"name\"]\n430\t                        )\n431\t            # Snapshot the entry's observation store BEFORE the tmpdir is\n432\t            # deleted (the controls below consume these snapshots).\n433\t            store = entry_tmp / \"audit\" / \"tool-lifecycle\" / observe_store_name\n434\t            if store.is_file():\n435\t                try:\n436\t                    rows = [\n437\t                        json.loads(line)\n438\t                        for line in store.read_text(\n439\t                            encoding=\"utf-8\"\n440\t                        ).splitlines()\n441\t                        if line.strip()\n442\t                    ]\n443\t                except (OSError, json.JSONDecodeError):\n444\t                    rows = []\n445\t                hooks_out[entry[\"name\"]][\"observe_rows\"] = len(rows)\n446\t                hooks_out[entry[\"name\"]][\"observe_paired_rows\"] = sum(\n447\t                    1 for r in rows\n448\t                    if isinstance(r, dict) and r.get(\"paired\") is True\n449\t                )\n450\t            else:\n451\t                hooks_out[entry[\"name\"]][\"observe_rows\"] = 0\n452\t                hooks_out[entry[\"name\"]][\"observe_paired_rows\"] = 0\n453\t        finally:\n454\t            shutil.rmtree(entry_tmp, ignore_errors=True)\n455\t        if wall_exceeded:\n456\t            # The self-cap fired mid-entry: stop measuring rather than run\n457\t            # into the workflow's `timeout 420` (rc 124, an opaque kill).\n458\t            break\n459\t    def _entry_field(name: str, key: str, default: Any = 0) -> Any:\n460\t        \"\"\"Read a per-entry field, tolerating a WALL-CAP-truncated corpus.\"\"\"\n461\t        block = hooks_out.get(name)\n462\t        if not isinstance(block, dict):\n463\t            return default\n464\t        return block.get(key, default)\n465\t    # ---- Observe-rail controls (anti-vacuity, S254 class) -------------------\n466\t    on_rows = _entry_field(\"check_output_secrets[observe=1]\", \"observe_rows\")\n467\t    on_paired = _entry_field(\n468\t        \"check_output_secrets[observe=1]\", \"observe_paired_rows\"\n469\t    )\n470\t    # Codex pair-rail S265 P3: every seeded run (cold + all warm) takes the\n471\t    # paired path, so EVERY observed row must be paired — requiring only\n472\t    # `on_paired >= iterations` let one unpaired warm row hide behind the\n473\t    # cold row's paired count (cold + 19 paired + 1 unpaired = 20). The\n474\t    # robust invariant is: no unpaired rows at all, and at least `iterations`\n475\t    # of them.\n476\t    positive_ok = (not observe_rail_present) or (\n477\t        on_rows >= iterations and on_paired == on_rows\n478\t    )\n479\t    positive_control = {\n480\t        \"required\": observe_rail_present,\n481\t        \"rows\": on_rows,\n482\t        \"paired_rows\": on_paired,\n483\t        \"passed\": positive_ok,\n484\t        \"note\": (\n485\t            \"observe rail present: store must hold >= iterations paired rows \"\n486\t            \"or the observe=1 timing is a vacuous no-op measurement\"\n487\t            if observe_rail_present\n488\t            else \"observe rail not in this tree; both states are baseline \"\n489\t            \"parity runs (control arms automatically at PLAN-154 landing)\"\n490\t        ),\n491\t    }\n492\t    off_rows = _entry_field(\"check_output_secrets[observe=unset]\", \"observe_rows\")\n493\t    pre_rows = _entry_field(\"check_anti_ceo_overhead[observe=1]\", \"observe_rows\")\n494\t    negative_ok = off_rows == 0 and pre_rows == 0\n495\t    negative_control = {\n496\t        \"unset_store_rows\": off_rows,\n497\t        \"pre_side_store_rows\": pre_rows,\n498\t        \"passed\": negative_ok,\n499\t        \"note\": (\n500\t            \"A12 zero-delta: unset state writes nothing; MF-SEC-5: the \"\n501\t            \"record_pre carrier never writes the store even with observe=1\"\n502\t        ),\n503\t    }\n504\t    passed = (\n505\t        all_within_budget\n506\t        and positive_ok\n507\t        and negative_ok\n508\t        and not wall_exceeded\n509\t    )\n510\t    report: Dict[str, Any] = {\n511\t        \"schema\": \"profile-opus-4-7.v1\",\n512\t        \"mode\": \"hook_latency\",\n513\t        \"measured_at\": measured_at,\n514\t        \"python\": sys.version.split()[0],\n515\t        \"iterations\": iterations,\n516\t        \"p95_ceiling_ms\": p95_ceiling_ms,\n517\t        \"p99_ceiling_ms\": p99_ceiling_ms,\n518\t        \"p99_advisory\": p99_advisory,\n519\t        \"observe_rail_present\": observe_rail_present,\n520\t        \"hooks\": hooks_out,\n521\t        # Back-compat: legacy consumers read this top-level block.\n522\t        \"check_agent_spawn\": hooks_out.get(\"check_agent_spawn\", {}),\n523\t        \"controls\": {\n524\t            \"observe_positive_control\": positive_control,\n525\t            \"observe_negative_control\": negative_control,\n526\t        },\n527\t        \"passed\": passed,\n528\t        \"note\": (\n529\t            \"Advisory emitters disabled (CEO_MODEL_ROUTING=0 etc.); \"\n530\t            \"measures governance hot-path only. Budget ADR-163 S318 \"\n531\t            \"amendment: p95<%.0fms hard per corpus entry; p99<%.0fms %s. \"\n532\t            \"PLAN-154 constraint 8: observe-rail extended write path \"\n533\t            \"profiled in both states with anti-vacuity controls.\"\n534\t            % (\n535\t                p95_ceiling_ms,\n536\t                p99_ceiling_ms,\n537\t                \"ADVISORY (reported, never gates)\" if p99_advisory\n538\t                else \"hard (back-compat default)\",\n539\t            )\n540\t        ),\n541\t    }\n542\t    # ---- second key (ADR-163 Amendment PLAN-169 S328) ----------------------\n543\t    # Every key below is ADDITIVE and appears ONLY under the new flags: a run\n544\t    # without them returns the dict above verbatim, which is the back-compat\n545\t    # contract test (e) asserts byte-for-byte.\n546\t    if second_key:\n547\t        entry_labels = [\n548\t            hooks_out[name][\"verdict_label\"]\n549\t            for name in hooks_out\n550\t            if isinstance(hooks_out[name], dict)\n551\t            and \"verdict_label\" in hooks_out[name]\n552\t        ]\n553\t        # PHASE 2 is armed by the K FILE, not by the outcome: a run whose\n554\t        # reference came back broken must still exit 5, and a wall-capped run\n555\t        # with an EMPTY corpus must never aggregate to \"pass\".\n556\t        any_enforced = bool(k_by_entry)\n557\t        # rail round-4 P2 — the no-labels fallback follows the ABSOLUTE key\n558\t        # instead of asserting \"pass\".\n559\t        #\n560\t        # `--exec-reference` without `--relative-advisory` is a supported CLI\n561\t        # combination that stores no per-entry `verdict_label`, so this list\n562\t        # is empty. Hardcoding \"pass\" then published a document that\n563\t        # contradicted itself — measured, with every entry over p95:\n564\t        # `passed=false`, `exit_class=1`, `verdict_label=\"pass\"`. A JSON\n565\t        # consumer reading the label got the opposite of the exit code.\n566\t        #\n567\t        # With no labels the absolute key is the only key that ran, which is\n568\t        # exactly what phase 1 means, so the label reports what it decided.\n569\t        aggregate = (\n570\t            _aggregate_label(entry_labels)\n571\t            if entry_labels\n572\t            else (\"pass\" if passed else \"real_regression\")\n573\t        )\n574\t        if wall_exceeded:\n575\t            aggregate = \"infrastructure_contended\"\n576\t        any_hook_failed = any(\n577\t            isinstance(block, dict) and block.get(\"hook_failed\")\n578\t            for block in hooks_out.values()\n579\t        )\n580\t        # rail round-2 P2 — the HARD p99 ceiling survives phase 2, scoped to\n581\t        # the entries that are NOT under amnesty.\n582\t        #\n583\t        # `_classify_entry` keys the absolute half on p95 ALONE, so an entry\n584\t        # can meet p95 and the relative key while breaching p99 and still be\n585\t        # labelled \"pass\". Under phase 1 that run exits 1 (`entry_passed`\n586\t        # carries `p99_advisory or p99_within`); arming phase 2 silently\n587\t        # dropped the ceiling. That \"pass\" cell is the hole, and it is the\n588\t        # ONLY cell that closes here.\n589\t        #\n590\t        # The `advisory_slow_runner` cell is deliberately EXEMPT, and the\n591\t        # ordering of the two ceilings is why: p99 >= p95 always, while the\n592\t        # p99 ceiling (160ms) sits BELOW the p95 one (180ms). So every entry\n593\t        # that breaches p95 breaches p99 too — a blanket p99 term makes\n594\t        # amnesty unreachable and cancels this amendment outright. (Written\n595\t        # blanket first; the pre-existing amnesty test caught it.) On an\n596\t        # entry whose slowness the relative key has already attributed to\n597\t        # the runner, the p99 breach is the same runner, not a second\n598\t        # finding.\n599\t        hard_p99_breach = (not p99_advisory) and any(\n600\t            isinstance(block, dict)\n601\t            and block.get(\"p99_within\") is False\n602\t            and block.get(\"verdict_label\") == \"pass\"\n603\t            for block in hooks_out.values()\n604\t        )\n605\t        if any_enforced:\n606\t            # PHASE 2: the relative key DECIDES. Hook failures, the two\n607\t            # observe controls and a hard p99 breach stay hard failures\n608\t            # regardless of any label.\n609\t            if (\n610\t                (not positive_ok)\n611\t                or (not negative_ok)\n612\t                or any_hook_failed\n613\t                or hard_p99_breach\n614\t            ):\n615\t                exit_class = 1\n616\t            else:\n617\t                exit_class = _LABEL_EXIT_CLASS[aggregate]\n618\t        else:\n619\t            # PHASE 1: byte-identical to today's exit contract.\n620\t            exit_class = 0 if passed else 1\n621\t        report[\"phase\"] = \"2-enforcing\" if any_enforced else \"1-advisory\"\n622\t        report[\"verdict_label\"] = aggregate\n623\t        report[\"exit_class\"] = exit_class\n624\t        report[\"outcome_labels\"] = list(_OUTCOME_LABELS)\n625\t        report[\"exec_reference\"] = exec_reference\n626\t        report[\"relative_advisory\"] = relative_advisory\n627\t        report[\"strict_relative\"] = strict_relative\n628\t        report[\"abs_backstop_ms\"] = _ABS_BACKSTOP_MS\n629\t        report[\"ref_drift_max\"] = _REF_DRIFT_MAX\n630\t        report[\"wall_budget_seconds\"] = float(wall_budget_seconds)\n631\t        report[\"wall_deadline_seconds\"] = round(wall_deadline_s, 1)\n632\t        report[\"wall_exceeded\"] = wall_exceeded\n633\t        report[\"elapsed_seconds\"] = round(time.perf_counter() - t_gate_start, 1)\n634\t        report[\"relative_warnings\"] = relative_warnings\n635\t        if exec_reference:\n636\t            report[\"ref_source_sha256\"] = ref_source_sha256()\n637\t            report[\"ref_samples_per_entry\"] = _REF_SAMPLES_PER_ENTRY\n638\t        report[\"relative_note\"] = (\n639\t            \"ADR-163 Amendment (PLAN-169 S328) second key. PHASE 1: labels \"\n640\t            \"are PUBLISHED and the exit code is byte-identical to the \"\n641\t            \"absolute-key contract — K_e is not derivable until an advisory \"\n642\t            \"window supplies paired (hook, reference) samples. R_e = \"\n643\t            \"hook_p50/ref_p50; do NOT read a single run's R_e as K.\"\n644\t            if not any_enforced\n645\t            else \"ADR-163 Amendment (PLAN-169 S328) second key. PHASE 2: \"\n646\t            \"rel_ok = hook_p50 <= K_e * ref_p50 DECIDES the exit \"\n647\t            \"(pass/advisory_slow_runner 0, real_regression 1, \"\n648\t            \"infrastructure_contended 5).\"\n649\t        )\n650\t    return report\n651\t"}]},"parent_tool_use_id":null,"session_id":"8e98cc69-9185-4f95-b319-4d1b22b49864","uuid":"18c6007f-377c-4706-a1a8-0042426d92b9","timestamp":"2026-11-16T20:10:59.909Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_profile_opus_parts/latency.py","content":"\"\"\"Extracted implementation: latency.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\n\ndef run_hook_latency(\n    repo_root: Path,\n    iterations: int = 200,\n    p95_ceiling_ms: float = 180.0,\n    p99_ceiling_ms: float = 160.0,\n    p99_advisory: bool = False,\n    exec_reference: bool = False,\n    relative_advisory: bool = False,\n    relative_k_source: Optional[str] = None,\n    wall_budget_seconds: float = 420.0,\n    strict_relative: bool = False,\n    sampler: Optional[Callable[[str, str, int], float]] = None,\n) -> Dict[str, Any]:\n    \"\"\"Profile hook latency; full contract in hook_latency_docs.\"\"\"\n    hooks_dir = repo_root / \".claude\" / \"hooks\"\n    agent_spawn = hooks_dir / \"check_agent_spawn.py\"\n    anti_overhead = hooks_dir / \"check_anti_ceo_overhead.py\"\n    output_secrets = hooks_dir / \"check_output_secrets.py\"\n    measured_at = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    # ADR-163 percentile precondition (PLAN-159 debate round-1 must-fix):\n    # with the nearest-rank truncation in _pct_of_sorted (int((n-1)*p/100)),\n    # p95 and p99 collapse onto the SAME order statistic for n < 22 — the\n    # p99 ceiling becomes dead code and the gate keys on the 2nd-largest\n    # sample (the S272/S273 load-flake class). A gate run on a collapsed\n    # index is a defect state: fail LOUDLY instead of measuring.\n    idx_p95 = int((iterations - 1) * 95 / 100.0)\n    idx_p99 = int((iterations - 1) * 99 / 100.0)\n    if idx_p95 == idx_p99:\n        return {\n            \"schema\": \"profile-opus-4-7.v1\",\n            \"mode\": \"hook_latency\",\n            \"measured_at\": measured_at,\n            \"error\": (\n                \"percentile_indices_collapsed: iterations=%d puts p95 and \"\n                \"p99 on the same order statistic (index %d); minimum is 22, \"\n                \"gate standard is 200 (ADR-163)\" % (iterations, idx_p95)\n            ),\n            \"p95_ceiling_ms\": p95_ceiling_ms,\n            \"p99_ceiling_ms\": p99_ceiling_ms,\n            \"passed\": False,\n        }\n    for required in (agent_spawn, anti_overhead, output_secrets):\n        if not required.is_file():\n            return {\n                \"schema\": \"profile-opus-4-7.v1\",\n                \"mode\": \"hook_latency\",\n                \"measured_at\": measured_at,\n                \"error\": f\"hook not found: {required}\",\n                \"passed\": False,\n            }\n    # --- second-key wiring (ADR-163 Amendment PLAN-169 S328) ---------------\n    # The whole relative machinery — reference sampling AND the wall self-cap\n    # — is gated on the new flags, so a run without them is byte-identical to\n    # today (report keys AND exit code), which is the back-compat contract.\n    second_key = bool(exec_reference or relative_advisory or relative_k_source)\n    relative_warnings: List[str] = []\n    k_by_entry: Dict[str, float] = {}\n    if relative_k_source:\n        k_by_entry, relative_warnings = _load_relative_k_source(relative_k_source)\n        if not exec_reference and k_by_entry:\n            relative_warnings.append(\n                \"relative_k_source_ignored: --relative-k-source needs \"\n                \"--exec-reference (no reference measured, so rel_ok is \"\n                \"undefined); every entry stays on phase 1\"\n            )\n            k_by_entry = {}\n    ref_plan = _ref_schedule(iterations, _REF_SAMPLES_PER_ENTRY) if exec_reference else []\n    t_gate_start = time.perf_counter()\n    wall_deadline_s = _WALL_BUDGET_SAFETY_FRACTION * float(wall_budget_seconds)\n    wall_exceeded = False\n    def _wall_blown() -> bool:\n        if not second_key:\n            return False\n        return (time.perf_counter() - t_gate_start) > wall_deadline_s\n    # Static rail detection: does this tree's tool_lifecycle ship the PLAN-154\n    # observe rail? Drives whether the positive control is REQUIRED (post-\n    # landing) or informational (pre-landing baseline-parity run).\n    observe_rail_present = False\n    try:\n        observe_rail_present = \"observation_store_path\" in (\n            hooks_dir / \"_lib\" / \"tool_lifecycle.py\"\n        ).read_text(encoding=\"utf-8\")\n    except OSError:\n        observe_rail_present = False\n    base_env = {k: v for k, v in os.environ.items()}\n    base_env[\"PYTHONPATH\"] = str(hooks_dir)\n    base_env[\"CLAUDE_PROJECT_DIR\"] = str(repo_root)\n    # Disable all advisory emitters so we measure governance logic only\n    base_env[\"CEO_MODEL_ROUTING\"] = \"0\"\n    base_env[\"CEO_PROMOTION_HEURISTIC\"] = \"0\"\n    base_env[\"CEO_COOKBOOK_ADVISOR_ENABLED\"] = \"0\"\n    base_env[\"CEO_SPEC_CTX_SANITIZER_ENABLED\"] = \"0\"\n    base_env[\"CEO_SPAWN_CONFIDENCE_ENABLED\"] = \"0\"\n    # Deterministic corpus state: no inherited kill-switches / session id.\n    # CLAUDE_PROJECT_DIR_NATIVE is the HIGHEST-PRECEDENCE runtime-state\n    # carrier (runtime_paths): left in the inherited env it overrides both\n    # HOME and CEO_AUDIT_LOG_DIR below, and every measured hook would append\n    # to the LIVE HMAC chain instead of the per-entry throwaway dir — the\n    # S321/S326 non-attributable-elos class. Scrubbing it is unconditional:\n    # it is an isolation fix, not part of the second key, and it changes no\n    # report key and no exit code.\n    for scrubbed in (\n        \"CEO_LEARNING_OBSERVE\",\n        \"CEO_SOTA_DISABLE\",\n        \"CEO_TOOL_LIFECYCLE\",\n        \"CEO_ANTI_OVERHEAD\",\n        \"CLAUDE_SESSION_ID\",\n        \"CLAUDE_PROJECT_DIR_NATIVE\",\n    ):\n        base_env.pop(scrubbed, None)\n    def _spawn_payload(tool_use_id: str) -> bytes:  # noqa: ARG001 — uniform sig\n        return json.dumps({\n            \"session_id\": _LATENCY_SESSION_ID,\n            \"tool_name\": \"Agent\",\n            \"tool_input\": {\"description\": \"latency probe\", \"prompt\": \"bench\"},\n        }).encode()\n    corpus: List[Dict[str, Any]] = [\n        {\n            \"name\": \"check_agent_spawn\",\n            \"hook\": agent_spawn,\n            \"payload\": _spawn_payload,\n            \"env_set\": {},\n            \"seed\": False,\n        },\n        {\n            \"name\": \"check_anti_ceo_overhead[observe=unset]\",\n            \"hook\": anti_overhead,\n            \"payload\": _latency_pre_payload,\n            \"env_set\": {},\n            \"seed\": False,\n        },\n        {\n            \"name\": \"check_anti_ceo_overhead[observe=1]\",\n            \"hook\": anti_overhead,\n            \"payload\": _latency_pre_payload,\n            \"env_set\": {\"CEO_LEARNING_OBSERVE\": \"1\"},\n            \"seed\": False,\n        },\n        {\n            \"name\": \"check_output_secrets[observe=unset]\",\n            \"hook\": output_secrets,\n            \"payload\": _latency_post_payload,\n            \"env_set\": {},\n            \"seed\": True,\n        },\n        {\n            \"name\": \"check_output_secrets[observe=1]\",\n            \"hook\": output_secrets,\n            \"payload\": _latency_post_payload,\n            \"env_set\": {\"CEO_LEARNING_OBSERVE\": \"1\"},\n            \"seed\": True,\n        },\n    ]\n    observe_store_name = _LATENCY_SESSION_ID + \".observe.jsonl\"\n    hooks_out: Dict[str, Dict[str, Any]] = {}\n    all_within_budget = True\n    # rail round-1 P2 — a K file may only name entries that EXIST. Without\n    # this, one typo armed phase 2 for the whole run while applying K to\n    # nothing: `any_enforced` keys on `bool(k_by_entry)`, so every entry\n    # classified with `k_e=None` (label \"pass\" whenever the absolute key was\n    # met, and — the actual hole — a run that phase 1 would exit 1 on could\n    # aggregate to \"pass\" and exit 0). Rejecting the name keeps the loader's\n    # stated contract: a rejection is NAMED and degrades to PHASE 1, never\n    # to a silently wider gate.\n    if k_by_entry:\n        _known_names = {e[\"name\"] for e in corpus}\n        for _unknown in sorted(set(k_by_entry) - _known_names):\n            relative_warnings.append(\n                \"relative_k_unknown_entry[%s]: not a corpus entry name; \"\n                \"dropped (the run stays on phase 1 unless another K \"\n                \"applies)\" % _unknown\n            )\n            k_by_entry.pop(_unknown)\n    for entry in corpus:\n        if _wall_blown():\n            wall_exceeded = True\n            break\n        entry_tmp = Path(tempfile.mkdtemp(prefix=\"ceo-hook-latency-\"))\n        try:\n            env = dict(base_env)\n            env[\"HOME\"] = str(entry_tmp / \"home\")\n            env[\"CEO_AUDIT_LOG_DIR\"] = str(entry_tmp / \"audit\")\n            env.update(entry[\"env_set\"])\n            (entry_tmp / \"home\").mkdir(parents=True, exist_ok=True)\n            (entry_tmp / \"audit\").mkdir(parents=True, exist_ok=True)\n            # Reference lane: its own dir, SIBLING of the audit dir (same\n            # filesystem, which is the whole point of term 3) and never\n            # inside it — the observe-rail positive control must keep\n            # counting exactly the rows the hooks wrote. PYTHONPATH is\n            # dropped so the reference cannot import the hook tree even by\n            # accident (anti-coupling contract).\n            ref_env = dict(env)\n            ref_env.pop(\"PYTHONPATH\", None)\n            ref_dir = entry_tmp / \"ref\"\n            ref_script = entry_tmp / \"ref_exec.py\"\n            if exec_reference and sampler is None:\n                ref_dir.mkdir(parents=True, exist_ok=True)\n                ref_script.write_text(_REF_EXEC_SOURCE, encoding=\"utf-8\")\n            # Codex pair-rail S265 P2: a hook that exits non-zero (import\n            # or runtime error) must FAIL the gate, not silently record a\n            # small latency sample. Hooks always exit 0 by contract, so any\n            # non-zero return is a real failure — capture it for seed AND\n            # timed runs and fold it into entry_passed (the S254 vacuous-\n            # green class this profiler exists to prevent).\n            entry_hook_failed = False\n            # rail round-1 P1 — the SAME rule as the line above, for the lane\n            # that did not have it. The reference is a MEASUREMENT of how\n            # fast this runner executes; a process that died on an import,\n            # a missing dir or a permission is not a slow reference, it is\n            # NO reference. Discarding its return code let a fast, repeatable\n            # failure (~15ms, low split-half drift) present as a perfectly\n            # healthy `ref_valid=true` — and a tiny ref_p50 is the worst\n            # possible poison for phase 2, where K_e is pinned from\n            # max(hook_p50/ref_p50): one broken run pins K enormous and buys\n            # blanket amnesty forever after.\n            entry_ref_failed = False\n            def _run_once(tag: str, kind: str = \"warm\", index: int = 0) -> float:\n                nonlocal entry_hook_failed\n                if sampler is not None:\n                    # Injected measurement: no subprocess at all (seed\n                    # included). Unit tests plant regressions at the\n                    # predicate level instead of via time.sleep.\n                    return float(sampler(entry[\"name\"], kind, index))\n                tool_use_id = \"profile-tu-\" + tag\n                if entry[\"seed\"]:\n                    # Unmeasured Pre stamp via the REAL record_pre carrier so\n                    # the timed record_post run takes the paired path.\n                    # ADR-163: a >10s stall is folded into the fail-closed\n                    # sink instead of raising an opaque TimeoutExpired\n                    # traceback (more subprocess calls at N=200 raise the\n                    # cumulative odds of one stall on a contended runner).\n                    try:\n                        seed_res = subprocess.run(\n                            [sys.executable, str(anti_overhead)],\n                            input=_latency_pre_payload(tool_use_id),\n                            capture_output=True,\n                            env=env,\n                            cwd=str(repo_root),\n                            timeout=10,\n                        )\n                        if seed_res.returncode != 0:\n                            entry_hook_failed = True\n                    except subprocess.TimeoutExpired:\n                        entry_hook_failed = True\n                payload = entry[\"payload\"](tool_use_id)\n                t0 = time.perf_counter_ns()\n                try:\n                    res = subprocess.run(\n                        [sys.executable, str(entry[\"hook\"])],\n                        input=payload,\n                        capture_output=True,\n                        env=env,\n                        cwd=str(repo_root),\n                        timeout=10,\n                    )\n                    if res.returncode != 0:\n                        entry_hook_failed = True\n                except subprocess.TimeoutExpired:\n                    # ADR-163: stall == hook failure (fail-closed, clean\n                    # report instead of an uncaught traceback); the ~10s\n                    # elapsed sample also breaches the ceiling by itself.\n                    entry_hook_failed = True\n                return (time.perf_counter_ns() - t0) / 1_000_000.0\n            def _run_ref(index: int) -> float:\n                nonlocal entry_ref_failed\n                if sampler is not None:\n                    return float(sampler(entry[\"name\"], \"ref\", index))\n                t0 = time.perf_counter_ns()\n                # INVERTED predicate. The rail found this same class twice —\n                # round-1 P1 (return code discarded) and round-2 P2 (timeout\n                # left unmarked) — which per the repo's own rule means the\n                # ARCHITECTURE of the cure is wrong, not the round. So the\n                # reference is DISTRUSTED by default and earns trust on\n                # exactly one path: the process ran to completion and exited\n                # 0. A branch added later that forgets to mark failure cannot\n                # reintroduce the hole, because failure is what the variable\n                # already says.\n                #\n                # Why neither shape check can stand in for this: a fast crash\n                # is a small, finite, low-drift sample, and a MINORITY of 10s\n                # stalls does not move a median — measured, 3 timeouts among\n                # the 40 samples give ref_p50=50.0 and split-half drift=1.000\n                # against a 1.5 ceiling, so the classifier answered `pass`\n                # with `ref_valid=True` over three processes that never\n                # completed. The median is what makes this gate robust to\n                # runner noise (ADR-163:258); that robustness is exactly what\n                # blinds it here. Statistics cannot answer \"did the process\n                # finish\".\n                completed_ok = False\n                try:\n                    res = subprocess.run(\n                        [sys.executable, str(ref_script), str(ref_dir)],\n                        capture_output=True,\n                        env=ref_env,\n                        cwd=str(entry_tmp),\n                        timeout=10,\n                    )\n                    completed_ok = res.returncode == 0\n                except subprocess.TimeoutExpired:\n                    # A stalled reference is a contention signal, not a hook\n                    # verdict; it reads as infrastructure_contended.\n                    pass\n                if not completed_ok:\n                    entry_ref_failed = True\n                return (time.perf_counter_ns() - t0) / 1_000_000.0\n            cold_ms = _run_once(\"cold\", \"cold\", 0)\n            warm: List[float] = []\n            ref_samples: List[float] = []\n            # ROUND-ROBIN: the reference is sampled INSIDE the hook loop, so\n            # both keys price the same scheduler window. The S318 defect was\n            # a probe measured once, outside the window that degraded.\n            for i in range(iterations):\n                # rail round-1 P2 — checked EVERY iteration, not every tenth.\n                # The self-cap exists to guarantee a structured wall-capped\n                # result instead of the outer 420s timeout's rc124, and the\n                # stride broke that guarantee on exactly the runner it was\n                # written for: one iteration can spend 10s in the seed, 10s\n                # in the hook and 10s in the reference, so a check passing\n                # just under the 378s deadline could be followed by ~300s\n                # unchecked. `_wall_blown()` is one perf_counter subtraction;\n                # paying it 200 times instead of 20 costs microseconds and is\n                # not measurable against a 180ms budget.\n                if second_key and i and _wall_blown():\n                    wall_exceeded = True\n                    break\n                warm.append(_run_once(\"%04d\" % i, \"warm\", i))\n                # Re-checked BEFORE the reference lane: with the hook sample\n                # already paid, the remaining reference runs of this same\n                # iteration are the last place the overshoot can still grow.\n                if second_key and _wall_blown():\n                    wall_exceeded = True\n                    break\n                for _ in range(ref_plan[i] if i < len(ref_plan) else 0):\n                    ref_samples.append(_run_ref(len(ref_samples)))\n            warm_sorted = sorted(warm)\n            p50 = _pct_of_sorted(warm_sorted, 50)\n            p95 = _pct_of_sorted(warm_sorted, 95)\n            p99 = _pct_of_sorted(warm_sorted, 99)\n            p99_within = p99 <= p99_ceiling_ms\n            entry_passed = (\n                p95 <= p95_ceiling_ms\n                and (p99_advisory or p99_within)\n                and not entry_hook_failed\n            )\n            all_within_budget = all_within_budget and entry_passed\n            hooks_out[entry[\"name\"]] = {\n                \"cold_ms\": round(cold_ms, 1),\n                \"p50_ms\": round(p50, 1),\n                \"p95_ms\": round(p95, 1),\n                \"p99_ms\": round(p99, 1),\n                \"max_ms\": round(max(warm_sorted) if warm_sorted else 0.0, 1),\n                \"hook_failed\": entry_hook_failed,\n                \"p99_within\": p99_within,\n                \"passed\": entry_passed,\n            }\n            if second_key:\n                ref_sorted = sorted(ref_samples)\n                ref_p50 = _pct_of_sorted(ref_sorted, 50) if ref_sorted else 0.0\n                ref_p95 = _pct_of_sorted(ref_sorted, 95) if ref_sorted else 0.0\n                ref_drift = (\n                    _split_half_drift(ref_samples)\n                    if exec_reference\n                    else float(\"inf\")\n                )\n                k_e = k_by_entry.get(entry[\"name\"])\n                label, rel_ok, ref_valid = _classify_entry(\n                    hook_p50=p50,\n                    hook_p95=p95,\n                    ref_p50=ref_p50,\n                    ref_drift=ref_drift,\n                    p95_ceiling_ms=p95_ceiling_ms,\n                    k_e=k_e,\n                    ref_measured=exec_reference,\n                    wall_exceeded=wall_exceeded,\n                    strict_relative=strict_relative,\n                    ref_failed=entry_ref_failed,\n                )\n                stats = hooks_out[entry[\"name\"]]\n                if exec_reference:\n                    stats[\"ref_p50_ms\"] = round(ref_p50, 1)\n                    stats[\"ref_p95_ms\"] = round(ref_p95, 1)\n                    stats[\"ref_samples\"] = len(ref_samples)\n                    stats[\"ref_split_half_drift\"] = (\n                        round(ref_drift, 3) if math.isfinite(ref_drift) else None\n                    )\n                    stats[\"ref_valid\"] = ref_valid\n                    # Published so the exit-5 has a NAME: `ref_valid=false`\n                    # alone cannot tell an operator whether the reference was\n                    # mis-shaped, drifting, or simply never ran.\n                    stats[\"ref_failed\"] = entry_ref_failed\n                if relative_advisory or relative_k_source:\n                    stats[\"R_e\"] = (\n                        round(p50 / ref_p50, 3)\n                        if (exec_reference and ref_valid and ref_p50 > 0)\n                        else None\n                    )\n                    stats[\"K_e\"] = k_e\n                    stats[\"rel_ok\"] = rel_ok\n                    stats[\"verdict_label\"] = label\n                    # Phase is a property of the ENTRY's K, not of the\n                    # outcome: an entry with a usable K whose reference came\n                    # back broken is still phase 2 (its verdict is exit 5),\n                    # while an entry absent from the K file is phase 1.\n                    stats[\"phase\"] = (\n                        \"2-enforcing\" if k_e is not None else \"1-advisory\"\n                    )\n                    if k_e is None and relative_k_source:\n                        relative_warnings.append(\n                            \"relative_k_missing[%s]: no usable K in the \"\n                            \"source file; this entry stays on phase 1 (its \"\n                            \"label follows the absolute key alone)\"\n                            % entry[\"name\"]\n                        )\n            # Snapshot the entry's observation store BEFORE the tmpdir is\n            # deleted (the controls below consume these snapshots).\n            store = entry_tmp / \"audit\" / \"tool-lifecycle\" / observe_store_name\n            if store.is_file():\n                try:\n                    rows = [\n                        json.loads(line)\n                        for line in store.read_text(\n                            encoding=\"utf-8\"\n                        ).splitlines()\n                        if line.strip()\n                    ]\n                except (OSError, json.JSONDecodeError):\n                    rows = []\n                hooks_out[entry[\"name\"]][\"observe_rows\"] = len(rows)\n                hooks_out[entry[\"name\"]][\"observe_paired_rows\"] = sum(\n                    1 for r in rows\n                    if isinstance(r, dict) and r.get(\"paired\") is True\n                )\n            else:\n                hooks_out[entry[\"name\"]][\"observe_rows\"] = 0\n                hooks_out[entry[\"name\"]][\"observe_paired_rows\"] = 0\n        finally:\n            shutil.rmtree(entry_tmp, ignore_errors=True)\n        if wall_exceeded:\n            # The self-cap fired mid-entry: stop measuring rather than run\n            # into the workflow's `timeout 420` (rc 124, an opaque kill).\n            break\n    def _entry_field(name: str, key: str, default: Any = 0) -> Any:\n        \"\"\"Read a per-entry field, tolerating a WALL-CAP-truncated corpus.\"\"\"\n        block = hooks_out.get(name)\n        if not isinstance(block, dict):\n            return default\n        return block.get(key, default)\n    # ---- Observe-rail controls (anti-vacuity, S254 class) -------------------\n    on_rows = _entry_field(\"check_output_secrets[observe=1]\", \"observe_rows\")\n    on_paired = _entry_field(\n        \"check_output_secrets[observe=1]\", \"observe_paired_rows\"\n    )\n    # Codex pair-rail S265 P3: every seeded run (cold + all warm) takes the\n    # paired path, so EVERY observed row must be paired — requiring only\n    # `on_paired >= iterations` let one unpaired warm row hide behind the\n    # cold row's paired count (cold + 19 paired + 1 unpaired = 20). The\n    # robust invariant is: no unpaired rows at all, and at least `iterations`\n    # of them.\n    positive_ok = (not observe_rail_present) or (\n        on_rows >= iterations and on_paired == on_rows\n    )\n    positive_control = {\n        \"required\": observe_rail_present,\n        \"rows\": on_rows,\n        \"paired_rows\": on_paired,\n        \"passed\": positive_ok,\n        \"note\": (\n            \"observe rail present: store must hold >= iterations paired rows \"\n            \"or the observe=1 timing is a vacuous no-op measurement\"\n            if observe_rail_present\n            else \"observe rail not in this tree; both states are baseline \"\n            \"parity runs (control arms automatically at PLAN-154 landing)\"\n        ),\n    }\n    off_rows = _entry_field(\"check_output_secrets[observe=unset]\", \"observe_rows\")\n    pre_rows = _entry_field(\"check_anti_ceo_overhead[observe=1]\", \"observe_rows\")\n    negative_ok = off_rows == 0 and pre_rows == 0\n    negative_control = {\n        \"unset_store_rows\": off_rows,\n        \"pre_side_store_rows\": pre_rows,\n        \"passed\": negative_ok,\n        \"note\": (\n            \"A12 zero-delta: unset state writes nothing; MF-SEC-5: the \"\n            \"record_pre carrier never writes the store even with observe=1\"\n        ),\n    }\n    passed = (\n        all_within_budget\n        and positive_ok\n        and negative_ok\n        and not wall_exceeded\n    )\n    report: Dict[str, Any] = {\n        \"schema\": \"profile-opus-4-7.v1\",\n        \"mode\": \"hook_latency\",\n        \"measured_at\": measured_at,\n        \"python\": sys.version.split()[0],\n        \"iterations\": iterations,\n        \"p95_ceiling_ms\": p95_ceiling_ms,\n        \"p99_ceiling_ms\": p99_ceiling_ms,\n        \"p99_advisory\": p99_advisory,\n        \"observe_rail_present\": observe_rail_present,\n        \"hooks\": hooks_out,\n        # Back-compat: legacy consumers read this top-level block.\n        \"check_agent_spawn\": hooks_out.get(\"check_agent_spawn\", {}),\n        \"controls\": {\n            \"observe_positive_control\": positive_control,\n            \"observe_negative_control\": negative_control,\n        },\n        \"passed\": passed,\n        \"note\": (\n            \"Advisory emitters disabled (CEO_MODEL_ROUTING=0 etc.); \"\n            \"measures governance hot-path only. Budget ADR-163 S318 \"\n            \"amendment: p95<%.0fms hard per corpus entry; p99<%.0fms %s. \"\n            \"PLAN-154 constraint 8: observe-rail extended write path \"\n            \"profiled in both states with anti-vacuity controls.\"\n            % (\n                p95_ceiling_ms,\n                p99_ceiling_ms,\n                \"ADVISORY (reported, never gates)\" if p99_advisory\n                else \"hard (back-compat default)\",\n            )\n        ),\n    }\n    # ---- second key (ADR-163 Amendment PLAN-169 S328) ----------------------\n    # Every key below is ADDITIVE and appears ONLY under the new flags: a run\n    # without them returns the dict above verbatim, which is the back-compat\n    # contract test (e) asserts byte-for-byte.\n    if second_key:\n        entry_labels = [\n            hooks_out[name][\"verdict_label\"]\n            for name in hooks_out\n            if isinstance(hooks_out[name], dict)\n            and \"verdict_label\" in hooks_out[name]\n        ]\n        # PHASE 2 is armed by the K FILE, not by the outcome: a run whose\n        # reference came back broken must still exit 5, and a wall-capped run\n        # with an EMPTY corpus must never aggregate to \"pass\".\n        any_enforced = bool(k_by_entry)\n        # rail round-4 P2 — the no-labels fallback follows the ABSOLUTE key\n        # instead of asserting \"pass\".\n        #\n        # `--exec-reference` without `--relative-advisory` is a supported CLI\n        # combination that stores no per-entry `verdict_label`, so this list\n        # is empty. Hardcoding \"pass\" then published a document that\n        # contradicted itself — measured, with every entry over p95:\n        # `passed=false`, `exit_class=1`, `verdict_label=\"pass\"`. A JSON\n        # consumer reading the label got the opposite of the exit code.\n        #\n        # With no labels the absolute key is the only key that ran, which is\n        # exactly what phase 1 means, so the label reports what it decided.\n        aggregate = (\n            _aggregate_label(entry_labels)\n            if entry_labels\n            else (\"pass\" if passed else \"real_regression\")\n        )\n        if wall_exceeded:\n            aggregate = \"infrastructure_contended\"\n        any_hook_failed = any(\n            isinstance(block, dict) and block.get(\"hook_failed\")\n            for block in hooks_out.values()\n        )\n        # rail round-2 P2 — the HARD p99 ceiling survives phase 2, scoped to\n        # the entries that are NOT under amnesty.\n        #\n        # `_classify_entry` keys the absolute half on p95 ALONE, so an entry\n        # can meet p95 and the relative key while breaching p99 and still be\n        # labelled \"pass\". Under phase 1 that run exits 1 (`entry_passed`\n        # carries `p99_advisory or p99_within`); arming phase 2 silently\n        # dropped the ceiling. That \"pass\" cell is the hole, and it is the\n        # ONLY cell that closes here.\n        #\n        # The `advisory_slow_runner` cell is deliberately EXEMPT, and the\n        # ordering of the two ceilings is why: p99 >= p95 always, while the\n        # p99 ceiling (160ms) sits BELOW the p95 one (180ms). So every entry\n        # that breaches p95 breaches p99 too — a blanket p99 term makes\n        # amnesty unreachable and cancels this amendment outright. (Written\n        # blanket first; the pre-existing amnesty test caught it.) On an\n        # entry whose slowness the relative key has already attributed to\n        # the runner, the p99 breach is the same runner, not a second\n        # finding.\n        hard_p99_breach = (not p99_advisory) and any(\n            isinstance(block, dict)\n            and block.get(\"p99_within\") is False\n            and block.get(\"verdict_label\") == \"pass\"\n            for block in hooks_out.values()\n        )\n        if any_enforced:\n            # PHASE 2: the relative key DECIDES. Hook failures, the two\n            # observe controls and a hard p99 breach stay hard failures\n            # regardless of any label.\n            if (\n                (not positive_ok)\n                or (not negative_ok)\n                or any_hook_failed\n                or hard_p99_breach\n            ):\n                exit_class = 1\n            else:\n                exit_class = _LABEL_EXIT_CLASS[aggregate]\n        else:\n            # PHASE 1: byte-identical to today's exit contract.\n            exit_class = 0 if passed else 1\n        report[\"phase\"] = \"2-enforcing\" if any_enforced else \"1-advisory\"\n        report[\"verdict_label\"] = aggregate\n        report[\"exit_class\"] = exit_class\n        report[\"outcome_labels\"] = list(_OUTCOME_LABELS)\n        report[\"exec_reference\"] = exec_reference\n        report[\"relative_advisory\"] = relative_advisory