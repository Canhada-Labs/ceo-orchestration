{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WtKKqVrR6y4iWmbzLxF8X9","type":"tool_result","content":"1\t\"\"\"Reality ledger: dispatch.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport ast\n7\timport hashlib\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\timport time\n13\timport unicodedata\n14\timport uuid\n15\tfrom datetime import datetime, timezone\n16\tfrom pathlib import Path\n17\tfrom typing import Any, Dict, FrozenSet, Iterable, List, Optional, Tuple\n18\t\n19\tfrom .constants import *  # shared declaration defaults\n20\t\n21\tdef _run_with_timeout(\n22\t    fn,\n23\t    *,\n24\t    timeout_ms: int,\n25\t    detector_name: str,\n26\t) -> Tuple[List[Dict[str, Any]], Optional[str]]:\n27\t    \"\"\"Run a detector with ITIMER guard. Returns (findings, error_str).\"\"\"\n28\t    budget_s = max(0.001, timeout_ms / 1000.0)\n29\t    prev = _install_itimer_guard(budget_s)\n30\t    try:\n31\t        findings = fn()\n32\t        return findings, None\n33\t    except ScanBudgetExceeded:\n34\t        return [], f\"detector {detector_name} timed out after {timeout_ms}ms\"\n35\t    except Exception as exc:  # pragma: no cover - safety net\n36\t        return [], f\"detector {detector_name} raised {exc.__class__.__name__}: {exc}\"\n37\t    finally:\n38\t        _clear_itimer_guard(prev)\n39\t\n40\t\n41\tdef run_detectors(\n42\t    *,\n43\t    repo_root: Path,\n44\t    detector_names: Optional[List[str]] = None,\n45\t    timeout_ms: int = DEFAULT_DETECTOR_TIMEOUT_MS,\n46\t    audit_log_path: Optional[Path] = None,\n47\t    emit_audit: bool = False,\n48\t    audit_emit_module: Optional[Any] = None,\n49\t    session_id: str = \"\",\n50\t    project: str = \"\",\n51\t) -> Tuple[List[Dict[str, Any]], List[str]]:\n52\t    \"\"\"Run requested detectors; returns (findings, errors).\n53\t\n54\t    Codex W1+W2 fix-pack #1: detector #7 (estimate_drift) accepts\n55\t    ``emit_audit`` + identifier args so it can fire its TYPED emitters\n56\t    (``emit_estimate_drift_detected`` / ``emit_estimate_drift_systematic_bias``)\n57\t    inline. Other detectors continue to use the generic\n58\t    ``_try_emit_finding`` path (handled by the CLI loop).\n59\t    \"\"\"\n60\t    selected = detector_names or sorted(DETECTOR_REGISTRY.keys())\n61\t    findings: List[Dict[str, Any]] = []\n62\t    errors: List[str] = []\n63\t\n64\t    detector_fns = {\n65\t        \"runtime_read_missing\": lambda: detect_runtime_read_missing(\n66\t            repo_root=repo_root,\n67\t        ),\n68\t        \"installable_claim_drift\": lambda: detect_installable_claim_drift(\n69\t            repo_root=repo_root,\n70\t        ),\n71\t        \"model_assignment_divergence\": lambda: detect_model_assignment_divergence(\n72\t            repo_root=repo_root,\n73\t            audit_log_path=audit_log_path,\n74\t        ),\n75\t        \"enforcement_commit_unpopulated\": lambda: detect_enforcement_commit_unpopulated(\n76\t            repo_root=repo_root,\n77\t        ),\n78\t        \"audit_action_phantom\": lambda: detect_audit_action_phantom(\n79\t            repo_root=repo_root,\n80\t        ),\n81\t        # PLAN-078 Wave 2 — Reality Ledger detector #7 (estimate-drift).\n82\t        # Codex Fix #1: emit-audit + module + identifiers flow inward so the\n83\t        # detector can call its TYPED emit wrappers (NOT generic).\n84\t        \"estimate_drift\": lambda: detect_estimate_drift(\n85\t            repo_root=repo_root,\n86\t            emit_audit=emit_audit,\n87\t            audit_emit_module=audit_emit_module,\n88\t            session_id=session_id,\n89\t            project=project,\n90\t        ),\n91\t    }\n92\t\n93\t    for name in selected:\n94\t        if name not in detector_fns:\n95\t            errors.append(f\"unknown detector: {name}\")\n96\t            continue\n97\t        f, err = _run_with_timeout(\n98\t            detector_fns[name],\n99\t            timeout_ms=timeout_ms,\n100\t            detector_name=name,\n101\t        )\n102\t        if err:\n103\t            errors.append(err)\n104\t        findings.extend(f)\n105\t    return findings, errors\n106\t\n107\t\n108\tdef filter_by_severity(findings: List[Dict[str, Any]], min_severity: str) -> List[Dict[str, Any]]:\n109\t    if min_severity not in _SEVERITY_ORDER:\n110\t        return findings\n111\t    threshold = _SEVERITY_ORDER[min_severity]\n112\t    return [f for f in findings if _SEVERITY_ORDER.get(f.get(\"severity\", \"low\"), 0) >= threshold]\n113\t\n114\t\n115\t# ---------------------------------------------------------------------------\n116\t# CLI\n117\t# ---------------------------------------------------------------------------\n118\t\n119\tdef main(argv: Optional[List[str]] = None) -> int:\n120\t    parser = argparse.ArgumentParser(\n121\t        prog=\"reality-ledger\",\n122\t        description=(\n123\t            \"Adaptive Execution Kernel claim-vs-evidence detector \"\n124\t            \"(advisory-only; never blocks).\"\n125\t        ),\n126\t    )\n127\t    parser.add_argument(\n128\t        \"--format\",\n129\t        choices=(\"markdown\", \"json\", \"jsonl\"),\n130\t        default=\"markdown\",\n131\t    )\n132\t    parser.add_argument(\n133\t        \"--detector\",\n134\t        action=\"append\",\n135\t        default=None,\n136\t        help=\"Run only this detector (repeatable). Default: all 5.\",\n137\t    )\n138\t    parser.add_argument(\n139\t        \"--severity\",\n140\t        choices=_SEVERITIES,\n141\t        default=\"low\",\n142\t        help=\"Minimum severity to emit (low/medium/high). Default: low.\",\n143\t    )\n144\t    parser.add_argument(\n145\t        \"--detector-timeout-ms\",\n146\t        type=int,\n147\t        default=DEFAULT_DETECTOR_TIMEOUT_MS,\n148\t        help=f\"Per-detector timeout. Default: {DEFAULT_DETECTOR_TIMEOUT_MS}.\",\n149\t    )\n150\t    parser.add_argument(\n151\t        \"--since\",\n152\t        default=None,\n153\t      