.perf_counter() - t0) * 1000)\n206\t\n207\t    if errors and not findings:\n208\t        # detector internal error path with no salvage\n209\t        for e in errors:\n210\t            sys.stderr.write(f\"[reality-ledger] {e}\\n\")\n211\t        return 2\n212\t\n213\t    if errors:\n214\t        # partial run — log errors but continue\n215\t        for e in errors:\n216\t            sys.stderr.write(f\"[reality-ledger] {e}\\n\")\n217\t\n218\t    findings = filter_by_severity(findings, args.severity)\n219\t\n220\t    # Best-effort audit emit (advisory) — applies to detectors #1-#6 ONLY.\n221\t    # Codex W1+W2 fix-pack #1: detector #7 (estimate_drift) already emitted\n222\t    # via typed wrappers inline; emitting again via generic\n223\t    # ``reality_ledger_finding`` would double-record AND defeat the typed\n224\t    # action contract. Skip detector-7 findings here.\n225\t    if args.emit_audit:\n226\t        for f in findings:\n227\t            if f.get(\"detector\") == \"estimate_drift\":\n228\t                continue  # typed emit already fired inside detect_estimate_drift\n229\t            _try_emit_finding(f, finding_count_in_run=len(findings))\n230\t\n231\t    # Render\n232\t    if args.format == \"markdown\":\n233\t        rendered = render_findings_markdown(findings)\n234\t    elif args.format == \"json\":\n235\t        rendered = render_findings_json(findings)\n236\t    else:  # jsonl\n237\t        rendered = render_findings_jsonl(findings)\n238\t\n239\t    # Append run metadata as a markdown footer (only for markdown)\n240\t    if args.format == \"markdown\":\n241\t        rendered = (\n242\t            rendered\n243\t            + f\"\\n_run_id: `{uuid.uuid4()}`  ·  duration_ms: `{elapsed_ms}`_\\n\"\n244\t        )\n245\t\n246\t    if args.output:\n247\t        try:\n248\t            Path(args.output).write_text(rendered, encoding=\"utf-8\")\n249\t        except OSError as exc:\n250\t            sys.stderr.write(f\"[reality-ledger] cannot write output: