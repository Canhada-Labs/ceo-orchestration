darwin-arm64 platform tarball is 131,652,985 bytes gzipped and 326,415,360\n227\t# bytes of tar (2026-09-23).\n228\tUNPACKED_MAX_BYTES = 1 << 30\n229\t\n230\t# npm platform suffix -> launcher targetTriple. Mirror of\n231\t# check_pair_rail._codex_target_triple (the host -> triple map).\n232\tPLATFORM_TRIPLE: Dict[str, str] = {\n233\t    \"darwin-arm64\": \"aarch64-apple-darwin\",\n234\t    \"darwin-x64\": \"x86_64-apple-darwin\",\n235\t    \"linux-x64\": \"x86_64-unknown-linux-musl\",\n236\t    \"linux-arm64\": \"aarch64-unknown-linux-musl\",\n237\t    \"win32-x64\": \"x86_64-pc-windows-msvc\",\n238\t    \"win32-arm64\": \"aarch64-pc-windows-msvc\",\n239\t}\n240\t\n241\t_MANIFEST_KEYS = frozenset({\"schema\", \"package_version\", \"npm_integrity\", \"payloads\"})\n242\t_SEMVER_RE = re.compile(r\"(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\")\n243\t_RANGE_RE = re.compile(r\">=([0-9]+\\.[0-9]+\\.[0-9]+)(?:,<([0-9]+\\.[0-9]+\\.[0-9]+))?\")\n244\t_SHA256_RE = re.compile(r\"[0-9a-f]{64}\")\n245\t_SRI512_RE = re.compile(r\"sha512-[A-Za-z0-9+/]{86}==\")\n246\t_PACK_DIR_RE = re.compile(r\"\\.claude/plans/(PLAN-[0-9]{3})/[a-z0-9][a-z0-9._-]*\")\n247\t_PLAN_RE = re.compile(r\"PLAN-[0-9]{3}\")\n248\t_DATE_RE = re.compile(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}\")\n249\t# Registry data is untrusted: only a plain https tarball URL reaches the sentinel.\n250\t_TARBALL_URL_RE = re.compile(r\"https://[A-Za-z0-9.-]+/[A-Za-z0-9._~@%+/-]+\\.tgz\")\n251\t\n252\t# Mold grammar (the value lines the generator owns, each exactly once).\n253\t_OWNED_SHAPES: Dict[str, \"re.Pattern[str]\"] = {\n254\t    \"D\": re.compile(r\"\\.claude/plans/[A-Za-z0-9._/-]+\"),\n255\t    \"SENT_LIVE\": re.compile(r'\"\\$D/pin-[a-z0-9-]+-approved\\.md\"'),\n256\t    \"NEW_RANGE\": re.compile(r\"'>=[0-9]+\\.[0-9]+\\.[0-9]+,<[0-9]+\\.[0-9]+\\.[0-9]+'\"),\n257\t    \"NEW_VERSION\": re.compile(r\"\"\"'\"package_version\": \"[0-9]+\\.[0-9]+\\.[0-9]+\"'\"\"\"),\n258\t    \"NEW_SHA\": re.compile(r\"'[0-9a-f]{64}'\"),\n259\t}\n260\t# Lines the mold must carry verbatim: what it reads is what this tool emits,\n261\t# what it writes is what this tool targets.\n262\t_REQUIRED_LINES = (\n263\t    'SRC_PIN=\"$D/' + PIN_OUT + '\"',\n264\t    'SRC_MAN=\"$D/' + MANIFEST_OUT + '\"',\n265\t    \"DST_PIN=\" + PIN_REL,\n266\t    \"DST_MAN=\" + MANIFEST_REL,\n267\t)\n268\t# Names the injected guard and the generated commit message rely on (``DRY``\n269\t# is checked by ``_dry_definition``: it has two accepted shapes)."}]},"parent_tool_use_id":null,"session_id":"8e98cc69-9185-4f95-b319-4d1b22b49864","uuid":"c1858628-d27d-4466-9489-407c6f56f3ef","timestamp":"2026-11-16T20:11:48.754Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/re-pin-codex.py","content":"import json\nimport os\nimport posixpath\nimport re\nimport shutil\nimport stat\nimport subprocess\nimport sys\nimport tarfile\nimport tempfile\nimport textwrap\nimport zlib\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Set, Tuple\n\nfrom _repin_guard import GUARD as _GUARD, guard as _guard\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\nPACKAGE = \"@openai/codex\"\nGENERATOR = \".claude/scripts/re-pin-codex.py\"\nMANIFEST_REL = \".claude/governance/codex-cli-pin-manifest.json\"\nPIN_REL = \".claude/governance/codex-cli-pin.txt\"\nMANIFEST_OUT = \"codex-cli-pin-manifest.json.new\"\nPIN_OUT = \"codex-cli-pin.txt.new\"\nTODO_MARK = \"TODO(owner)\"\n\nEXIT_INPUT = 2\nEXIT_VERIFY = 3\nEXIT_INFRA = 4\n\n#: The registry every npm call names explicitly (never ~/.npmrc's choice):\n#: the sentinel records it, so the signed reproduction runs against the\n#: registry that was measured.\nNPM_REGISTRY = \"https://registry.npmjs.org/\"\n#: Both flags: a ``@openai:registry`` line in an .npmrc outranks ``registry``\n#: for this scoped package, so the scope is pinned too.\nNPM_REGISTRY_ARGS = (\"--registry=\" + NPM_REGISTRY, \"--@openai:registry=\" + NPM_REGISTRY)\n#: Pack molds, relative to ``.claude/plans`` (the same glob the drift\n#: detector used to walk).\nMOLD_GLOB = \"PLAN-*/codex-pin*/OWNER-PIN-SIGN.sh\"\nNPM_VIEW_TIMEOUT = 120\nNPM_PACK_TIMEOUT = 1800\n# Cap on the tarball read into memory. The 0.156.0 darwin-arm64 platform\n# tarball measured 131,567,699 bytes (2026-09-22).\nTARBALL_MAX_BYTES = 1 << 30\n# Decompressed-size cap (a gzip bomb stops here). Measured: the real 0.156.1\n# darwin-arm64 platform tarball is 131,652,985 bytes gzipped and 326,415,360\n# bytes of tar (2026-09-23).\nUNPACKED_MAX_BYTES = 1 << 30\n\n# npm platform suffix -> launcher targetTriple. Mirror of\n# check_pair_rail._codex_target_triple (the host -> triple map).\nPLATFORM_TRIPLE: Dict[str, str] = {\n    \"darwin-arm64\": \"aarch64-apple-darwin\",\n    \"darwin-x64\": \"x86_64-apple-darwin\",\n    \"linux-x64\": \"x86_64-unknown-linux-musl\",\n    \"linux-arm64\": \"aarch64-unknown-linux-musl\",\n    \"win32-x64\": \"x86_64-pc-windows-msvc\",\n    \"win32-arm64\": \"aarch64-pc-windows-msvc\",\n}\n\n_MANIFEST_KEYS = frozenset({\"schema\", \"package_version\", \"npm_integrity\", \"payloads\"})\n_SEMVER_RE = re.compile(r\"(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\")\n_RANGE_RE = re.compile(r\">=([0-9]+\\.[0-9]+\\.[0-9]+)(?:,<([0-9]+\\.[0-9]+\\.[0-9]+))?\")\n_SHA256_RE = re.compile(r\"[0-9a-f]{64}\")\n_SRI512_RE = re.compile(r\"sha512-[A-Za-z0-9+/]{86}==\")\n_PACK_DIR_RE = re.compile(r\"\\.claude/plans/(PLAN-[0-9]{3})/[a-z0-9][a-z0-9._-]*\")\n_PLAN_RE = re.compile(r\"PLAN-[0-9]{3}\")\n_DATE_RE = re.compile(r\"[0-9]{4}-[0-9]{2}-[0-9]{2}\")\n# Registry data is untrusted: only a plain https tarball URL reaches the sentinel.\n_TARBALL_URL_RE = re.compile(r\"https://[A-Za-z0-9.-]+/[A-Za-z0-9._~@%+/-]+\\.tgz\")\n\n# Mold grammar (the value lines the generator owns, each exactly once).\n_OWNED_SHAPES: Dict[str, \"re.Pattern[str]\"] = {\n    \"D\": re.compile(r\"\\.claude/plans/[A-Za-z0-9._/-]+\"),\n    \"SENT_LIVE\": re.compile(r'\"\\$D/pin-[a-z0-9-]+-approved\\.md\"'),\n    \"NEW_RANGE\": re.compile(r\"'>=[0-9]+\\.[0-9]+\\.[0-9]+,<[0-9]+\\.[0-9]+\\.[0-9]+'\"),\n    \"NEW_VERSION\": re.compile(r\"\"\"'\"package_version\": \"[0-9]+\\.[0-9]+\\.[0-9]+\"'\"\"\"),\n    \"NEW_SHA\": re.compile(r\"'[0-9a-f]{64}'\"),\n}\n# Lines the mold must carry verbatim: what it reads is what this tool emits,\n# what it writes is what this tool targets.\n_REQUIRED_LINES = (\n    'SRC_PIN=\"$D/' + PIN_OUT + '\"',\n    'SRC_MAN=\"$D/' + MANIFEST_OUT + '\"',\n    \"DST_PIN=\" + PIN_REL,\n    \"DST_MAN=\" + MANIFEST_REL,\n)\n# Names the injected guard and the generated commit message rely on (``DRY``\n# is checked by ``_dry_definition``: it has two accepted shapes).","numLines":90,"startLine":180,"totalLines":2314}},"tool_result_meta":[{"id":"toolu_01MqjC5sQ8e6zXmf86aq4hsM","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
