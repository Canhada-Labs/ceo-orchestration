\"\n83\t    r\"COVERALLS_|CODECOV_|\"\n84\t    r\"SENTRY_|\"\n85\t    r\"PYTHONPATH$|PATH$|HOME$\"\n86\t    r\")\"\n87\t)\n88\t\n89\t# Doc-side regex: env var names appearing as `$VAR`, `VAR=value`, or\n90\t# inside backticks. Min 5 chars (e.g. `CEO_X`) to prevent matching the\n91\t# bare prefix `CEO_` (4 chars). Convention floor `_ENV_PREFIX_RE`\n92\t# additionally requires at least 1 char after the prefix underscore.\n93\t# Body of the env-var name: starts upper, ≥4 chars, ends in a non-underscore.\n94\t# Prevents `ANTHROPIC_` (trailing underscore = a prefix mention, not a name).\n95\t_ENV_NAME_BODY = r\"[A-Z][A-Z0-9_]{2,62}[A-Z0-9]\"\n96\t_BACKTICK_ENV_RE = re.compile(r\"`(\" + _ENV_NAME_BODY + r\")`\")\n97\t_SHELL_ASSIGN_RE = re.compile(r\"\\b(\" + _ENV_NAME_BODY + r\")=[^\\s]\")\n98\t_DOLLAR_VAR_RE = re.compile(r\"\\$(\" + _ENV_NAME_BODY + r\")\\b\")\n99\t\n100\t# ADR Status field forms supported.\n101\t_ADR_STATUS_RE = re.compile(\n102\t    r\"^(?:>\\s*)?\\*{0,2}Status:?\\*{0,2}\\s*[:\\-]?\\s*(.+?)\\s*$\",\n103\t    re.MULTILINE,\n104\t)\n105\t# Many ADRs use \"**Status:** ACCEPTED ...\" or \"> **Status:** ...\"\n106\t_ADR_ENFORCEMENT_HEADER_RE = re.compile(\n107\t    r\"^##\\s+Enforcement\\s+commit\\s*$\",\n108\t    re.MULTILINE | re.IGNORECASE,\n109\t)\n110\t_ENFORCEMENT_SHA_RE = re.compile(r\"`([0-9a-f]{7,40})`\")\n111\t_ENFORCEMENT_PLACEHOLDER_RE = re.compile(\n112\t    r\"\\((?:populated\\s+on\\s+flip|pending|TBD|to\\s+be\\s+populated|_pending_)\",\n113\t    re.IGNORECASE,\n114\t)\n115\t\n116\t# Detector #6 — emit_<action> regex inside python source.\n117\t_EMIT_CALL_RE = re.compile(\n118\t    r\"\\bemit_generic\\s*\\(\\s*action\\s*=\\s*[\\\"']([a-z][a-z0-9_]*)[\\\"']\"\n119\t)\n120\t_EMIT_NAMED_RE = re.compile(\n121\t    r\"\\baudit_emit\\s*\\.\\s*emit_([a-z][a-z0-9_]*)\\s*\\(\"\n122\t)\n123\t\n124\t\n125\t# ---------------------------------------------------------------------------\n126\t# File walking utilities (deterministic, exclusion-aware)\n127\t# 