 List[Path] = []\n    for root in roots:\n        if not root.exists():\n            continue\n        for p in sorted(root.rglob(\"*.py\")):\n            if _is_excluded(p, repo_root=repo_root):\n                continue\n            out.append(p)\n    return out\n\n\ndef _iter_md_files(roots: Iterable[Path], *, repo_root: Path) -> List[Path]:\n    out: List[Path] = []\n    for root in roots:\n        if not root.exists():\n            continue\n        for p in sorted(root.rglob(\"*.md\")):\n            if _is_excluded(p, repo_root=repo_root):\n                continue\n            out.append(p)\n    return out\n\n\n# ---------------------------------------------------------------------------\n# Detector #1 — runtime_read_missing (AST-level)\n# ---------------------------------------------------------------------------\n\n\n__all__ = ['_is_excluded', '_iter_python_files', '_iter_md_files']\n","numLines":70,"startLine":1,"totalLines":70}},"tool_result_meta":[{"id":"toolu_013mJ3oqwS62qyAkCq2TnLbY","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
