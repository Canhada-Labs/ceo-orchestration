{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BTPjNKJibjgXpw9Xe7HqTZ","type":"tool_result","content":"1\t\"\"\"Extracted implementation: smoke.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport hashlib\n6\timport json\n7\timport math\n8\timport os\n9\timport shutil\n10\timport subprocess\n11\timport sys\n12\timport tempfile\n13\timport time\n14\tfrom datetime import datetime, timezone\n15\tfrom pathlib import Path\n16\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n17\t\n18\t\n19\t# ---------------------------------------------------------------------------\n20\t# Subprocess startup floor (Phase 0 item 8)\n21\t# ---------------------------------------------------------------------------\n22\t\n23\t\n24\tdef measure_subprocess_floor(samples: int = 50) -> Dict[str, Any]:\n25\t    \"\"\"Measure python3 -c 'pass' wall-clock as canonical startup tax.\n26\t\n27\t    Returns p50/p95/p99 in nanoseconds. p50 is the recommended floor\n28\t    used by hook-profiler logic_only_ns subtraction.\n29\t    \"\"\"\n30\t    times: List[int] = []\n31\t    for _ in range(samples):\n32\t        t0 = time.perf_counter_ns()\n33\t        subprocess.run(\n34\t            [\"python3\", \"-c\", \"pass\"],\n35\t            capture_output=True,\n36\t            check=True,\n37\t        )\n38\t        t1 = time.perf_counter_ns()\n39\t        times.append(t1 - t0)\n40\t    times.sort()\n41\t    n = len(times)\n42\t    return {\n43\t        \"samples\": n,\n44\t        \"min_ns\": times[0],\n45\t        \"p50_ns\": times[n // 2],\n46\t        \"p95_ns\": times[int(n * 0.95)],\n47\t        \"p99_ns\": times[int(n * 0.99)],\n48\t        \"max_ns\": times[-1],\n49\t        \"mean_ns\": sum(times) // n,\n50\t    }\n51\t\n52\t\n53\t# ---------------------------------------------------------------------------\n54\t# Smoke mode (CI-runnable, no API)\n55\t# ---------------------------------------------------------------------------\n56\t\n57\t\n58\t_GATE_FILES = [\n59\t    \"CLAUDE.md\",\n60\t    \"PROTOCOL.md\",\n61\t    \".claude/team.md\",\n62\t    \".claude/frontend-team.md\",\n63\t    \".claude/skills/core/ceo-orchestration/SKILL.md\",\n64\t]\n65\t\n66\t\n67\tdef estimate_gate_boot_token_cost(repo_root: Path) -> Dict[str, Any]:\n68\t    \"\"\"Approximate token cost of Gates 1-3 file load.\n69\t\n70\t    Heuristic: 1 token ≈ 4 chars (English-Portuguese mix). Real counts\n71\t    require the Anthropic tokenizer; this estimate is for monotonic\n72\t    diff tracking, not absolute precision.\n73\t    \"\"\"\n74\t    breakdown: Dict[str, int] = {}\n75\t    total_bytes = 0\n76\t    for relpath in _GATE_FILES:\n77\t        target = repo_root / relpath\n78\t        if target.is_file():\n79\t            size = target.stat().st_size\n80\t            breakdown[relpath] = size\n81\t            total_bytes += size\n82\t    # 4 chars/token rough heuristic\n83\t    estimated_tokens = total_bytes // 4\n84\t    return {\n85\t        \"files\": breakdown,\n86\t        \"total_bytes\": total_bytes,\n87\t        \"estimated_tokens_at_4_char_per_token\": estimated_tokens,\n88\t        \"note\": (\n89\t            \"Estimate only; replace with Anthropic tokenizer counts in \"\n90\t            \"Phase 0 item 1 (audit_log.py v2.7 cache-header capture)\"\n91\t        ),\n92\t    }\n93\t\n94\t\n95\tdef estimate_spawn_prompt_cost(repo_root: Path) -> Dict[str, Any]:\n96\t    \"\"\"Approximate tokens consumed by canonical Spawn Protocol prompt.\n97\t\n98\t    Sample: code-reviewer persona + code-review-checklist SKILL inline.\n99\t    \"\"\"\n100\t    persona_path = repo_root / \".claude\" / \"team.md\"\n101\t    skill_path = (\n102\t        repo_root / \".claude\" / \"skills\" / \"core\" / \"code-review-checklist\" / \"SKILL.md\"\n103\t    )\n104\t    persona_bytes = persona_path.stat().st_size if persona_path.is_file() else 0\n105\t    skill_bytes = skill_path.stat().st_size if skill_path.is_file() else 0\n106\t    inline_total = persona_bytes + skill_bytes\n107\t    return {\n108\t        \"persona_bytes\": persona_bytes,\n109\t        \"skill_bytes_inline\": skill_bytes,\n110\t        \"inline_total_bytes\": inline_total,\n111\t        \"estimated_tokens_inline\": inline_total // 4,\n112\t        \"estimated_tokens_reference_mode\": (\n113\t            persona_bytes // 4\n114\t            + 96  # @reference + sha256= + path = ~96 chars\n115\t        ),\n116\t        \"expected_savings_pct_at_phase_2\": (\n117\t            round(\n118\t                (skill_bytes - 96)\n119\t                * 100.0\n120\t                / max(inline_total, 1),\n121\t                1,\n122\t            )\n123\t            if inline_total > 0\n124\t            else 0\n125\t        ),\n126\t    }\n127\t\n128\t\n129\tdef smoke_checks(repo_root: Path) -> List[Dict[str, Any]]:\n130\t    \"\"\"Lightweight invariants. Each returns {name, passed, detail}.\"\"\"\n131\t    checks = []\n132\t\n133\t    # Check 1: gate files exist\n134\t    missing = [f for f in _GATE_FILES if not (repo_root / f).is_file()]\n135\t    checks.append(\n136\t        {\n137\t            \"name\": \"gate_files_present\",\n138\t            \"passed\": not missing,\n139\t            \"detail\": missing or \"all 5 gate files present\",\n140\t        }\n141\t    )\n142\t\n143\t    # Check 2: agents/ tree (Phase 1 prep)\n144\t    agents_dir = repo_root / \".claude\" / \"agents\"\n145\t    checks.append(\n146\t        {\n147\t            \"name\": \"agents_tree_present\",\n148\t            \"passed\": True,  # creating empty tree is fine\n149\t            \"detail\": (\n150\t                f\"exists={agents_dir.is_dir()}; \"\n151\t                f\"files={len(list(agents_dir.glob('*.md'))) if agents_dir.is_dir() else 0}\"\n152\t            ),\n153\t        }\n154\t    )\n155\t\n156\t    # Check 3: no PLAN with status: executing is older than 90 days\n157\t    # (replaces the stale plan_020_executing check — PLAN-020 is done).\n158\t    # This steady-state invariant fires when the repo has a plan stuck\n159\t    # in executing for more than 90 days without a completed_at entry,\n160\t    # which could indicate an orphaned or false-active plan.\n161\t    plans_dir = repo_root / \".claude\" / \"plans\"\n162\t    stale_executing: list = []\n163\t    import datetime as _dt\n164\t    _now = _dt.datetime.now(tz=_dt.timezone.utc)\n165\t    if plans_dir.is_dir():\n166\t        for plan_file in sorted(plans_dir.glob(\"PLAN-*.md\")):\n167\t            try:\n168\t                text = plan_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n169\t                if \"status: executing\" not in text:\n170\t                    continue\n171\t                if \"completed_at:\" in text:\n172\t                    continue\n173\t                # Extract executing_at date if present\n174\t                import re as _re\n175\t                m = _re.search(r\"executing_at:\\s*(\\d{4}-\\d{2}-\\d{2})\", text)\n176\t                if m:\n177\t                    try:\n178\t                        ea = _dt.datetime.strptime(m.group(1), \"%Y-%m-%d\").replace(\n179\t                            tzinfo=_dt.timezone.utc\n180\t                        )\n181\t                        age_days = (_now - ea).days\n182\t                        if age_days > 90:\n183\t                            stale_executing.append(\n184\t                                f\"{plan_file.name} (executing {age_days}d)\"\n185\t                            )\n186\t                    except Exception:\n187\t                        pass\n188\t            except Exception:\n189\t                pass\n190\t    checks.append(\n191\t        {\n192\t            \"name\": \"no_stale_executing_plans\",\n193\t            \"passed\": len(stale_executing) == 0,\n194\t            \"detail\": (\n195\t                \"all executing plans within 90-day window\"\n196\t                if not stale_executing\n197\t                else f\"stale: {stale_executing[:5]}\"\n198\t            ),\n199\t        }\n200\t    )\n201\t\n202\t    # Check 4: CODEOWNERS Phase 0a globs\n203\t    co_path = repo_root / \".github\" / \"CODEOWNERS\"\n204\t    if co_path.is_file():\n205\t        co = co_path.read_text(encoding=\"utf-8\")\n206\t        has_phase_0a = \"PLAN-020 Phase 0a\" in co\n207\t        checks.append(\n208\t            {\n209\t                \"name\": \"codeowners_phase_0a_present\",\n210\t                \"passed\": has_phase_0a,\n211\t                \"detail\": \"PLAN-020 Phase 0a block present\" if has_phase_0a else \"missing\",\n212\t            }\n213\t        )\n214\t    else:\n215\t        checks.append(\n216\t            {\n217\t                \"name\": \"codeowners_phase_0a_present\",\n218\t                \"passed\": False,\n219\t                \"detail\": \"CODEOWNERS file missing\",\n220\t            }\n221\t        )\n222\t\n223\t    return checks\n224\t\n225\t\n226\t# ---------------------------------------------------------------------------\n227\t# CLI dispatcher\n228\t# ---------------------------------------------------------------------------\n229\t\n230\t\n231\tdef run_smoke(repo_root: Path, budget_seconds: float) -> Dict[str, Any]:\n232\t    \"\"\"Run the Opus 4.7 smoke profile — quick cache-warming + sanity latency.\"\"\"\n233\t    t0 = time.perf_counter()\n234\t    checks = smoke_checks(repo_root)\n235\t    gate = estimate_gate_boot_token_cost(repo_root)\n236\t    spawn = estimate_spawn_prompt_cost(repo_root)\n237\t    elapsed_ms = (time.perf_counter() - t0) * 1000\n238\t    return {\n239\t        \"schema\": \"profile-opus-4-7.v1\",\n240\t        \"mode\": \"smoke\",\n241\t        \"measured_at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n242\t        \"python\": sys.version.split()[0],\n243\t        \"elapsed_ms\": round(elapsed_ms, 2),\n244\t        \"budget_seconds\": budget_seconds,\n245\t        \"within_budget\": elapsed_ms / 1000 < budget_seconds,\n246\t        \"checks\": checks,\n247\t        \"decomposition\": {\n248\t            \"gate_boot\": gate,\n249\t            \"spawn_prompt\": spawn,\n250\t        },\n251\t    }\n252\t\n253\t\n254\tdef run_floor() -> Dict[str, Any]:\n255\t    \"\"\"Run the Opus 4.7 latency floor profile (p50/p95/p99 percentiles).\"\"\"\n256\t    floor = measure_subprocess_floor(samples=50)\n257\t    return {\n258\t        \"schema\": \"profile-opus-4-7.v1\",\n259\t        \"mode\": \"floor\",\n260\t        \"measured_at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n261\t        \"python\": sys.version.split()[0],\n262\t        \"subprocess_floor_ns\": floor,\n263\t        \"subprocess_floor_ms\": {\n264\t            \"p50\": round(floor[\"p50_ns\"] / 1e6, 2),\n265\t            \"p95\": round(floor[\"p95_ns\"] / 1e6, 2),\n266\t            \"p99\": round(floor[\"p99_ns\"] / 1e6, 2),\n267\t        },\n268\t        \"interpretation\": {\n269\t            \"use\": \"Subtract from hook end-to-end p99 to compute logic_only_ns\",\n270\t            \"example\": (\n271\t                \"If hook p99 = 30.9ms and floor p50 = 23.2ms, \"\n272\t                \"logic_only ≈ 7.7ms (algorithmic surface)\"\n273\t            ),\n274\t        },\n275\t    }\n276\t\n277\t\n278\tdef _pct_of_sorted(lst: List[float], p: float) -> float:\n279\t    \"\"\"Nearest-rank percentile of an ascending-sorted list (0.0 on empty).\"\"\"\n280\t    if not lst:\n281\t        return 0.0\n282\t    idx = int((len(lst) - 1) * p / 100.0)\n283\t    return lst[min(idx, len(lst) - 1)]\n284\t"}]},"parent_tool_use_id":null,"session_id":"8e98cc69-9185-4f95-b319-4d1b22b49864","uuid":"3fc29035-9a2b-486b-a93f-1e8423dc3683","timestamp":"2026-11-16T20:10:53.986Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_profile_opus_parts/smoke.py","content":"\"\"\"Extracted implementation: smoke.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\n\n\n# ---------------------------------------------------------------------------\n# Subprocess startup floor (Phase 0 item 8)\n# ---------------------------------------------------------------------------\n\n\ndef measure_subprocess_floor(samples: int = 50) -> Dict[str, Any]:\n    \"\"\"Measure python3 -c 'pass' wall-clock as canonical startup tax.\n\n    Returns p50/p95/p99 in nanoseconds. p50 is the recommended floor\n    used by hook-profiler logic_only_ns subtraction.\n    \"\"\"\n    times: List[int] = []\n    for _ in range(samples):\n        t0 = time.perf_counter_ns()\n        subprocess.run(\n            [\"python3\", \"-c\", \"pass\"],\n            capture_output=True,\n            check=True,\n        )\n        t1 = time.perf_counter_ns()\n        times.append(t1 - t0)\n    times.sort()\n    n = len(times)\n    return {\n        \"samples\": n,\n        \"min_ns\": times[0],\n        \"p50_ns\": times[n // 2],\n        \"p95_ns\": times[int(n * 0.95)],\n        \"p99_ns\": times[int(n * 0.99)],\n        \"max_ns\": times[-1],\n        \"mean_ns\": sum(times) // n,\n    }\n\n\n# ---------------------------------------------------------------------------\n# Smoke mode (CI-runnable, no API)\n# ---------------------------------------------------------------------------\n\n\n_GATE_FILES = [\n    \"CLAUDE.md\",\n    \"PROTOCOL.md\",\n    \".claude/team.md\",\n    \".claude/frontend-team.md\",\n    \".claude/skills/core/ceo-orchestration/SKILL.md\",\n]\n\n\ndef estimate_gate_boot_token_cost(repo_root: Path) -> Dict[str, Any]:\n    \"\"\"Approximate token cost of Gates 1-3 file load.\n\n    Heuristic: 1 token ≈ 4 chars (English-Portuguese mix). Real counts\n    require the Anthropic tokenizer; this estimate is for monotonic\n    diff tracking, not absolute precision.\n    \"\"\"\n    breakdown: Dict[str, int] = {}\n    total_bytes = 0\n    for relpath in _GATE_FILES:\n        target = repo_root / relpath\n        if target.is_file():\n            size = target.stat().st_size\n            breakdown[relpath] = size\n            total_bytes += size\n    # 4 chars/token rough heuristic\n    estimated_tokens = total_bytes // 4\n    return {\n        \"files\": breakdown,\n        \"total_bytes\": total_bytes,\n        \"estimated_tokens_at_4_char_per_token\": estimated_tokens,\n        \"note\": (\n            \"Estimate only; replace with Anthropic tokenizer counts in \"\n            \"Phase 0 item 1 (audit_log.py v2.7 cache-header capture)\"\n        ),\n    }\n\n\ndef estimate_spawn_prompt_cost(repo_root: Path) -> Dict[str, Any]:\n    \"\"\"Approximate tokens consumed by canonical Spawn Protocol prompt.\n\n    Sample: code-reviewer persona + code-review-checklist SKILL inline.\n    \"\"\"\n    persona_path = repo_root / \".claude\" / \"team.md\"\n    skill_path = (\n        repo_root / \".claude\" / \"skills\" / \"core\" / \"code-review-checklist\" / \"SKILL.md\"\n    )\n    persona_bytes = persona_path.stat().st_size if persona_path.is_file() else 0\n    skill_bytes = skill_path.stat().st_size if skill_path.is_file() else 0\n    inline_total = persona_bytes + skill_bytes\n    return {\n        \"persona_bytes\": persona_bytes,\n        \"skill_bytes_inline\": skill_bytes,\n        \"inline_total_bytes\": inline_total,\n        \"estimated_tokens_inline\": inline_total // 4,\n        \"estimated_tokens_reference_mode\": (\n            persona_bytes // 4\n            + 96  # @reference + sha256= + path = ~96 chars\n        ),\n        \"expected_savings_pct_at_phase_2\": (\n            round(\n                (skill_bytes - 96)\n                * 100.0\n                / max(inline_total, 1),\n                1,\n            )\n            if inline_total > 0\n            else 0\n        ),\n    }\n\n\ndef smoke_checks(repo_root: Path) -> List[Dict[str, Any]]:\n    \"\"\"Lightweight invariants. Each returns {name, passed, detail}.\"\"\"\n    checks = []\n\n    # Check 1: gate files exist\n    missing = [f for f in _GATE_FILES if not (repo_root / f).is_file()]\n    checks.append(\n        {\n            \"name\": \"gate_files_present\",\n            \"passed\": not missing,\n            \"detail\": missing or \"all 5 gate files present\",\n        }\n    )\n\n    # Check 2: agents/ tree (Phase 1 prep)\n    agents_dir = repo_root / \".claude\" / \"agents\"\n    checks.append(\n        {\n            \"name\": \"agents_tree_present\",\n            \"passed\": True,  # creating empty tree is fine\n            \"detail\": (\n                f\"exists={agents_dir.is_dir()}; \"\n                f\"files={len(list(agents_dir.glob('*.md'))) if agents_dir.is_dir() else 0}\"\n            ),\n        }\n    )\n\n    # Check 3: no PLAN with status: executing is older than 90 days\n    # (replaces the stale plan_020_executing check — PLAN-020 is done).\n    # This steady-state invariant fires when the repo has a plan stuck\n    # in executing for more than 90 days without a completed_at entry,\n    # which could indicate an orphaned or false-active plan.\n    plans_dir = repo_root / \".claude\" / \"plans\"\n    stale_executing: list = []\n    import datetime as _dt\n    _now = _dt.datetime.now(tz=_dt.timezone.utc)\n    if plans_dir.is_dir():\n        for plan_file in sorted(plans_dir.glob(\"PLAN-*.md\")):\n            try:\n                text = plan_file.read_text(encoding=\"utf-8\", errors=\"replace\")\n                if \"status: executing\" not in text:\n                    continue\n                if \"completed_at:\" in text:\n                    continue\n                # Extract executing_at date if present\n                import re as _re\n                m = _re.search(r\"executing_at:\\s*(\\d{4}-\\d{2}-\\d{2})\", text)\n                if m:\n                    try:\n                        ea = _dt.datetime.strptime(m.group(1), \"%Y-%m-%d\").replace(\n                            tzinfo=_dt.timezone.utc\n                        )\n                        age_days = (_now - ea).days\n                        if age_days > 90:\n                            stale_executing.append(\n                                f\"{plan_file.name} (executing {age_days}d)\"\n                            )\n                    except Exception:\n                        pass\n            except Exception:\n                pass\n    checks.append(\n        {\n            \"name\": \"no_stale_executing_plans\",\n            \"passed\": len(stale_executing) == 0,\n            \"detail\": (\n                \"all executing plans within 90-day window\"\n                if not stale_executing\n                else f\"stale: {stale_executing[:5]}\"\n            ),\n        }\n    )\n\n    # Check 4: CODEOWNERS Phase 0a globs\n    co_path = repo_root / \".github\" / \"CODEOWNERS\"\n    if co_path.is_file():\n        co = co_path.read_text(encoding=\"utf-8\")\n        has_phase_0a = \"PLAN-020 Phase 0a\" in co\n        checks.append(\n            {\n                \"name\": \"codeowners_phase_0a_present\",\n                \"passed\": has_phase_0a,\n                \"detail\": \"PLAN-020 Phase 0a block present\" if has_phase_0a else \"missing\",\n            }\n        )\n    else:\n        checks.append(\n            {\n                \"name\": \"codeowners_phase_0a_present\",\n                \"passed\": False,\n                \"detail\": \"CODEOWNERS file missing\",\n            }\n        )\n\n    return checks\n\n\n# ---------------------------------------------------------------------------\n# CLI dispatcher\n# ---------------------------------------------------------------------------\n\n\ndef run_smoke(repo_root: Path, budget_seconds: float) -> Dict[str, Any]:\n    \"\"\"Run the Opus 4.7 smoke profile — quick cache-warming + sanity latency.\"\"\"\n    t0 = time.perf_counter()\n    checks = smoke_checks(repo_root)\n    gate = estimate_gate_boot_token_cost(repo_root)\n    spawn = estimate_spawn_prompt_cost(repo_root)\n    elapsed_ms = (time.perf_counter() - t0) * 1000\n    return {\n        \"schema\": \"profile-opus-4-7.v1\",\n        \"mode\": \"smoke\",\n        \"measured_at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"python\": sys.version.split()[0],\n        \"elapsed_ms\": round(elapsed_ms, 2),\n        \"budget_seconds\": budget_seconds,\n        \"within_budget\": elapsed_ms / 1000 < budget_seconds,\n        \"checks\": checks,\n        \"decomposition\": {\n            \"gate_boot\": gate,\n            \"spawn_prompt\": spawn,\n        },\n    }\n\n\ndef run_floor() -> Dict[str, Any]:\n    \"\"\"Run the Opus 4.7 latency floor profile (p50/p95/p99 percentiles).\"\"\"\n    floor = measure_subprocess_floor(samples=50)\n    return {\n        \"schema\": \"profile-opus-4-7.v1\",\n        \"mode\": \"floor\",\n        \"measured_at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"python\": sys.version.split()[0],\n        \"subprocess_floor_ns\": floor,\n        \"subprocess_floor_ms\": {\n            \"p50\": round(floor[\"p50_ns\"] / 1e6, 2),\n            \"p95\": round(floor[\"p95_ns\"] / 1e6, 2),\n            \"p99\": round(floor[\"p99_ns\"] / 1e6, 2),\n        },\n        \"interpretation\": {\n            \"use\": \"Subtract from hook end-to-end p99 to compute logic_only_ns\",\n            \"example\": (\n                \"If hook p99 = 30.9ms and floor p50 = 23.2ms, \"\n                \"logic_only ≈ 7.7ms (algorithmic surface)\"\n            ),\n        },\n    }\n\n\ndef _pct_of_sorted(lst: List[float], p: float) -> float:\n    \"\"\"Nearest-rank percentile of an ascending-sorted list (0.0 on empty).\"\"\"\n    if not lst:\n        return 0.0\n    idx = int((len(lst) - 1) * p / 100.0)\n    return lst[min(idx, len(lst) - 1)]\n","numLines":284,"startLine":1,"totalLines":284}},"tool_result_meta":[{"id":"toolu_01BTPjNKJibjgXpw9Xe7HqTZ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
