{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QR3LHi4jvTPgJbDsjRWFeX","type":"tool_result","content":"1\t\"\"\"Extracted implementation: reference.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\timport argparse\n5\timport hashlib\n6\timport json\n7\timport math\n8\timport os\n9\timport shutil\n10\timport subprocess\n11\timport sys\n12\timport tempfile\n13\timport time\n14\tfrom datetime import datetime, timezone\n15\tfrom pathlib import Path\n16\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n17\t\n18\t\n19\t\n20\t# ---------------------------------------------------------------------------\n21\t# ADR-163 Amendment (PLAN-169 S328) — runner-normalized SECOND KEY\n22\t# ---------------------------------------------------------------------------\n23\t#\n24\t# Evidence: `check_output_secrets` measured p95 361.4 / 424.8 / 229.1 ms on\n25\t# ubuntu-latest against the 180 ms hard ceiling while the ADR-163 contention\n26\t# pre-probe (`python3 -c pass`, the SPAWN floor) read UNCONTENDED at 7.76 ms\n27\t# and the same hook bytes measured 70-77 ms locally — and the immediately\n28\t# preceding commit PASSED 3.5 h earlier with ZERO files touched under the\n29\t# hook tree. `python3 -c pass` prices process CREATION; it is structurally\n30\t# blind to a runner that is slow-but-uncontended once execution starts.\n31\t#\n32\t# Cure: a SECOND key, relative, against an EXECUTION reference measured in\n33\t# the same run, round-robin-interleaved with the hook samples so both keys\n34\t# price the same scheduler window. The absolute ceiling STAYS (no third\n35\t# recalibration — \"bump the number\" already failed at ADR-163:291).\n36\t#\n37\t# PHASE 1 (this landing): labels are computed and PUBLISHED; exit codes stay\n38\t# byte-identical to today. K is not derivable — zero paired (hook, ref)\n39\t# samples exist anywhere. Phase 2 pins K_e per entry from an advisory window\n40\t# and is plumbed here (`--relative-k-source`) but INERT without that file.\n41\t\n42\t# Closed set, DERIVED by every consumer (never recalled — the\n43\t# `feedback-closed-sets-must-be-derived-not-recalled` class).\n44\t_OUTCOME_LABELS: Tuple[str, ...] = (\n45\t    \"pass\",\n46\t    \"advisory_slow_runner\",\n47\t    \"real_regression\",\n48\t    \"infrastructure_contended\",\n49\t)\n50\t\n51\t# label -> process exit code, PHASE 2 only. Phase 1 keeps today's 0/1.\n52\t_LABEL_EXIT_CLASS: Dict[str, int] = {\n53\t    \"pass\": 0,\n54\t    \"advisory_slow_runner\": 0,\n55\t    \"real_regression\": 1,\n56\t    \"infrastructure_contended\": 5,\n57\t}\n58\t\n59\t# Aggregation precedence (strongest verdict first): a PROVEN regression on\n60\t# any entry outranks contention elsewhere, and contention outranks amnesty.\n61\t_LABEL_PRECEDENCE: Tuple[str, ...] = (\n62\t    \"real_regression\",\n63\t    \"infrastructure_contended\",\n64\t    \"advisory_slow_runner\",\n65\t    \"pass\",\n66\t)\n67\t\n68\t# The COMPLETE set of report keys the second key may add. Declared here so\n69\t# the back-compat test can assert `set(new_report) - set(old_report)` is a\n70\t# subset of it: a future key added without registering it here turns that\n71\t# test RED instead of silently widening the report.\n72\t_SECOND_KEY_REPORT_KEYS: Tuple[str, ...] = (\n73\t    \"phase\",\n74\t    \"verdict_label\",\n75\t    \"exit_class\",\n76\t    \"outcome_labels\",\n77\t    \"exec_reference\",\n78\t    \"relative_advisory\",\n79\t    \"strict_relative\",\n80\t    \"abs_backstop_ms\",\n81\t    \"ref_drift_max\",\n82\t    \"wall_budget_seconds\",\n83\t    \"wall_deadline_seconds\",\n84\t    \"wall_exceeded\",\n85\t    \"elapsed_seconds\",\n86\t    \"relative_warnings\",\n87\t    \"ref_source_sha256\",\n88\t    \"ref_samples_per_entry\",\n89\t    \"relative_note\",\n90\t)\n91\t_SECOND_KEY_ENTRY_KEYS: Tuple[str, ...] = (\n92\t    \"ref_p50_ms\",\n93\t    \"ref_p95_ms\",\n94\t    \"ref_samples\",\n95\t    \"ref_split_half_drift\",\n96\t    \"ref_valid\",\n97\t    \"ref_failed\",\n98\t    \"R_e\",\n99\t    \"K_e\",\n100\t    \"rel_ok\",\n101\t    \"verdict_label\",\n102\t    \"phase\",\n103\t)\n104\t\n105\t# Absolute backstop above which a slow runner still FAILS instead of being\n106\t# granted amnesty. OPEN QUESTION for the Owner: this number has no evidence\n107\t# behind it — it is a \"what latency is unusable in a real session\" judgment.\n108\t_ABS_BACKSTOP_MS = 600.0\n109\t\n110\t# Reference samples per corpus entry (round-robin). The relative key gates on\n111\t# p50, where the ADR-163 nearest-rank index collapse cannot arise, so the\n112\t# n>=22 separation rule does not bind here; 40 is the adopted floor.\n113\t_REF_SAMPLES_PER_ENTRY = 40\n114\t\n115\t# Split-half p50 drift above which the REFERENCE itself is untrustworthy:\n116\t# the machine moved mid-entry, so the ratio prices two different machines.\n117\t_REF_DRIFT_MAX = 1.5\n118\t\n119\t# Self-cap fraction of --wall-budget-seconds. The cap fires BEFORE the\n120\t# workflow's `timeout 420`, so rc 124 becomes unreachable in practice.\n121\t_WALL_BUDGET_SAFETY_FRACTION = 0.9\n122\t# (rail round-1 P2 retired `_WALL_CHECK_EVERY`: the wall is checked on EVERY\n123\t# iteration and again before the reference lane, so there is no stride to\n124\t# name. A stride here is a defect, not a tuning knob — it made the 378s\n125\t# self-cap miss by up to ~300s, which is the rc124 the cap exists to avoid.)\n126\t\n127\t# --- the frozen execution reference ----------------------------------------\n128\t# Three terms, source-pinned by sha256 in the report. Any edit changes that\n129\t# hash DELIBERATELY: a heavier reference silently LOOSENS the relative key.\n130\t_REF_EXEC_SOURCE = r'''#!/usr/bin/env python3\n131\t# Frozen EXECUTION reference — ADR-163 Amendment (PLAN-169 S328).\n132\t#\n133\t# THREE TERMS, in order:\n134\t#   1. cold stdlib imports (json / re / hashlib / pathlib) + a fixed\n135\t#      re.compile set   -- prices the interpreter + import machinery;\n136\t#   2. a fixed CPU-bound hashing loop        -- prices the core;\n137\t#   3. M x open/append/flock/fsync/rename    -- prices the filesystem.\n138\t#\n139\t# HARD CONTRACT: stdlib ONLY, and NOTHING from the framework's own hook\n140\t# tree. The regression class this gate exists to catch IS an eager\n141\t# framework import; a reference paying that same import would inflate\n142\t# numerator AND denominator and go blind to its own reason to exist. An\n143\t# anti-coupling test walks this source's AST and asserts it.\n144\timport os\n145\timport sys\n146\t\n147\ttry:\n148\t    import fcntl as _locker\n149\texcept ImportError:  # pragma: no cover - non-POSIX\n150\t    _locker = None\n151\t\n152\t# Term sizing is MEASURED, not guessed (local macOS, 2026-08-25, N=30):\n153\t# spawn floor 23.9ms; imports +6.4ms; these constants add ~+16ms of CPU and\n154\t# ~+5ms of locked IO, putting the reference at p50 ~46ms of which ~48% is\n155\t# EXECUTION. The first draft (4000/6) sat at 34ms / 30% execution — barely\n156\t# more than the spawn probe it replaces, which would leave the ratio nearly\n157\t# as blind as the probe. The corpus hooks are ~52-64ms at ~63% execution;\n158\t# the residual under-tracking is declared, not hidden.\n159\t_HASH_ROUNDS = 14000\n160\t_IO_CYCLES = 24\n161\t_PROBE = \"ref-exec 2026-08-25 https://example.invalid token=abc12345\"\n162\t\n163\t\n164\tdef term_imports():\n165\t    import json\n166\t    import re\n167\t    import hashlib\n168\t    import pathlib\n169\t\n170\t    pats = (\n171\t        re.compile(r\"[A-Za-z0-9_]{8,}\"),\n172\t        re.compile(r\"(?i)\\b(secret|token|key)\\b\"),\n173\t        re.compile(r\"^\\s*[-*]\\s+\"),\n174\t        re.compile(r\"\\d{4}-\\d{2}-\\d{2}\"),\n175\t        re.compile(r\"https?://\\S+\"),\n176\t    )\n177\t    blob = json.dumps({\"probe\": _PROBE, \"rounds\": _HASH_ROUNDS})\n178\t    hits = sum(1 for p in pats if p.search(blob))\n179\t    hits += len(pathlib.PurePosixPath(\"/a/b/c/d\").parts)\n180\t    hits += len(hashlib.sha256(blob.encode(\"utf-8\")).hexdigest())\n181\t    return hits\n182\t\n183\t\n184\tdef term_cpu():\n185\t    import hashlib\n186\t\n187\t    acc = hashlib.sha256(b\"ceo-exec-reference-seed\")\n188\t    for i in range(_HASH_ROUNDS):\n189\t        acc.update(acc.digest())\n190\t        acc.update(str(i).encode(\"ascii\"))\n191\t    return acc.hexdigest()\n192\t\n193\t\n194\tdef term_io(dirpath):\n195\t    if not os.path.isdir(dirpath):\n196\t        os.makedirs(dirpath, exist_ok=True)\n197\t    target = os.path.join(dirpath, \"ref-exec.log\")\n198\t    made = 0\n199\t    for i in range(_IO_CYCLES):\n200\t        staging = os.path.join(dirpath, \"ref-exec.%d.part\" % i)\n201\t        fh = open(staging, \"a\")\n202\t        try:\n203\t            if _locker is not None:\n204\t                _locker.flock(fh.fileno(), _locker.LOCK_EX)\n205\t            fh.write(\"ref-exec cycle %d\\n\" % i)\n206\t            fh.flush()\n207\t            os.fsync(fh.fileno())\n208\t            if _locker is not None:\n209\t                _locker.flock(fh.fileno(), _locker.LOCK_UN)\n210\t        finally:\n211\t            fh.close()\n212\t        os.replace(staging, target)\n213\t        made += 1\n214\t    return made\n215\t\n216\t\n217\tdef main():\n218\t    dirpath = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()\n219\t    a = term_imports()\n220\t    b = term_cpu()\n221\t    c = term_io(dirpath)\n222\t    sys.stdout.write(\"%d %s %d\\n\" % (a, b[:8], c))\n223\t    return 0\n224\t\n225\t\n226\tif __name__ == \"__main__\":\n227\t    sys.exit(main())\n228\t'''\n229\t\n230\t\n231\tdef ref_source_sha256() -> str:\n232\t    \"\"\"sha256 of the frozen reference source text (report-pinned).\"\"\"\n233\t    return hashlib.sha256(_REF_EXEC_SOURCE.encode(\"utf-8\")).hexdigest()\n234\t\n235\t\n236\tdef _is_real_number(value: Any) -> bool:\n237\t    \"\"\"True only for a finite, non-bool int/float (codex r1 F8 case list).\n238\t\n239\t    ``True`` / ``\"-1\"`` / ``NaN`` / ``-Infinity`` / ``None`` all read False,\n240\t    exactly as the ADR-163 contention probe's parser treats them — the two\n241\t    parsers must not diverge.\n242\t    \"\"\"\n243\t    if isinstance(value, bool) or not isinstance(value, (int, float)):\n244\t        return False\n245\t    try:\n246\t        return math.isfinite(float(value))\n247\t    except (TypeError, ValueError, OverflowError):\n248\t        return False\n249\t\n250\t\n251\tdef _split_half_drift(samples: List[float]) -> float:\n252\t    \"\"\"Ratio between the p50 of the two TEMPORAL halves (>= 1.0).\n253\t\n254\t    ``inf`` when undefined (too few samples, or a zero/negative half-median):\n255\t    an undefined drift reads as CONTENDED, never as permission to gate.\n256\t    \"\"\"\n257\t    n = len(samples)\n258\t    if n < 4:\n259\t        return float(\"inf\")\n260\t    half = n // 2\n261\t    first = _pct_of_sorted(sorted(samples[:half]), 50)\n262\t    second = _pct_of_sorted(sorted(samples[half:]), 50)\n263\t    lo, hi = (first, second) if first <= second else (second, first)\n264\t    if not _is_real_number(lo) or lo <= 0:\n265\t        return float(\"inf\")\n266\t    return hi / lo\n267\t\n268\t\n269\tdef _classify_entry(\n270\t    hook_p50: float,\n271\t    hook_p95: float,\n272\t    ref_p50: Any,\n273\t    ref_drift: Any,\n274\t    p95_ceiling_ms: float,\n275\t    k_e: Optional[float] = None,\n276\t    ref_measured: bool = True,\n277\t    wall_exceeded: bool = False,\n278\t    abs_backstop_ms: float = _ABS_BACKSTOP_MS,\n279\t    strict_relative: bool = False,\n280\t    ref_failed: bool = False,\n281\t) -> Tuple[str, Optional[bool], bool]:\n282\t    \"\"\"PURE verdict function — returns ``(label, rel_ok, ref_valid)``.\n283\t\n284\t    ``rel_ok`` is ``None`` whenever no K applies to this entry (phase 1, or a\n285\t    phase-2 file with no usable K for this name): the label then follows the\n286\t    ABSOLUTE key alone, which is exactly today's contract.\n287\t\n288\t    ``strict_relative`` enables the ``abs_ok and not rel_ok`` cell (a clean\n289\t    regression that still fits under the fixed ceiling — the blind spot\n290\t    ADR-163:291 declares). Default OFF: it is a detection-floor product call\n291\t    for the Owner, implemented and unit-tested but not armed.\n292\t    \"\"\"\n293\t    if wall_exceeded:\n294\t        return (\"infrastructure_contended\", None, False)\n295\t\n296\t    ref_valid = True\n297\t    if ref_measured:\n298\t        if ref_failed:\n299\t            # rail round-1 P1. Checked FIRST and on its own: a failing\n300\t            # reference can still produce numbers that pass every shape test\n301\t            # below (a fast crash is a small, low-drift, perfectly finite\n302\t            # sample). Shape is not provenance — only the return code says\n303\t            # whether the process actually did the work.\n304\t            ref_valid = False\n305\t        elif not _is_real_number(ref_p50) or ref_p50 <= 0:\n306\t            ref_valid = False\n307\t        elif not _is_real_number(ref_drift) or ref_drift > _REF_DRIFT_MAX:\n308\t            ref_valid = False\n309\t        if not ref_valid:\n310\t            return (\"infrastructure_contended\", None, False)\n311\t    else:\n312\t        ref_valid = False\n313\t\n314\t    abs_ok = hook_p95 <= p95_ceiling_ms\n315\t\n316\t    rel_ok: Optional[bool] = None\n317\t    if k_e is not None and ref_measured and ref_valid:\n318\t        rel_ok = hook_p50 <= k_e * ref_p50\n319\t\n320\t    if rel_ok is None:\n321\t        # Phase 1 for this entry: the absolute key is the only key.\n322\t        return (\"pass\" if abs_ok else \"real_regression\", None, ref_valid)\n323\t\n324\t    if abs_ok:\n325\t        if rel_ok or not strict_relative:\n326\t            return (\"pass\", rel_ok, True)\n327\t        return (\"real_regression\", rel_ok, True)\n328\t\n329\t    if rel_ok and hook_p95 <= abs_backstop_ms:\n330\t        return (\"advisory_slow_runner\", rel_ok, True)\n331\t    return (\"real_regression\", rel_ok, True)\n332\t\n333\t\n334\tdef _aggregate_label(labels: List[str]) -> str:\n335\t    \"\"\"Strongest verdict in the corpus, by _LABEL_PRECEDENCE.\"\"\"\n336\t    for candidate in _LABEL_PRECEDENCE:\n337\t        if candidate in labels:\n338\t            return candidate\n339\t    return \"pass\"\n340\t\n341\t\n342\tdef _load_relative_k_source(path: str) -> Tuple[Dict[str, float], List[str]]:\n343\t    \"\"\"Parse the phase-2 K file -> ``({entry_name: K}, warnings)``.\n344\t\n345\t    Every rejection is NAMED in ``warnings`` and degrades that entry (or the\n346\t    whole file) back to PHASE 1 — never to a silently wider gate. An\n347\t    ``admissibility_max_K`` that the K REACHES is a REJECTION (the cap is\n348\t    exclusive — equality already loses the positive control): the design's\n349\t    \"an empty admissibility interval means the reference is mis-shaped\"\n350\t    branch is mechanical here, so \"widen K\" cannot be reached by editing\n351\t    one number. Exception text is never echoed (it can carry a machine path).\n352\t    \"\"\"\n353\t    warnings: List[str] = []\n354\t    try:\n355\t        doc = json.loads(Path(path).read_text(encoding=\"utf-8\"))\n356\t    except (OSError, ValueError) as exc:\n357\t        return {}, [\"relative_k_source_unreadable: %s\" % type(exc).__name__]\n358\t    if not isinstance(doc, dict):\n359\t        return {}, [\"relative_k_source_malformed: top level is not an object\"]\n360\t    entries = doc.get(\"entries\")\n361\t    if not isinstance(entries, dict):\n362\t        return {}, [\n363\t            \"relative_k_source_malformed: 'entries' missing or not an object\"\n364\t        ]\n365\t    out: Dict[str, float] = {}\n366\t    for name, spec in sorted(entries.items()):\n367\t        if not isinstance(spec, dict):\n368\t            warnings.append(\"relative_k_invalid[%s]: entry is not an object\" % name)\n369\t            continue\n370\t        k = spec.get(\"K\")\n371\t        if not _is_real_number(k) or k <= 0:\n372\t            warnings.append(\n373\t                \"relative_k_invalid[%s]: K=%r is not a finite positive JSON \"\n374\t                \"number\" % (name, k)\n375\t            )\n376\t            continue\n377\t        cap = spec.get(\"admissibility_max_K\")\n378\t        if cap is not None:\n379\t            if not _is_real_number(cap) or cap <= 0:\n380\t                warnings.append(\n381\t                    \"relative_k_invalid[%s]: admissibility_max_K=%r is not a \"\n382\t                    \"finite positive JSON number\" % (name, cap)\n383\t                )\n384\t                continue\n385\t            # rail round-3 P2 — the cap is EXCLUSIVE. `>` alone let K land\n386\t            # exactly ON it, and the guarantee the cap encodes (\"the +150ms\n387\t            # positive control still fails at the worst observed reference\")\n388\t            # needs `hook_p50 > K * ref_p50`, i.e. K STRICTLY below\n389\t            # (baseline+150)/max_ref — because the classifier's comparison is\n390\t            # inclusive. Measured with baseline 70 / worst ref 50 / cap 4.4:\n391\t            # K == cap gives `advisory_slow_runner` on the regressed sample,\n392\t            # K one epsilon below gives `real_regression`. Float pushes the\n393\t            # same way (4.4*50 == 220.00000000000003 > 220.0), so equality is\n394\t            # rejected rather than nudged with a tolerance.\n395\t            if k >= cap:\n396\t                warnings.append(\n397\t                    \"relative_k_inadmissible[%s]: K=%s reaches \"\n398\t                    \"admissibility_max_K=%s (the cap is exclusive) — the \"\n399\t                    \"+150ms positive control would not fail at the worst \"\n400\t                    \"observed reference; entry stays on phase 1\"\n401\t                    % (name, k, cap)\n402\t                )\n403\t                continue\n404\t        out[name] = float(k)\n405\t    return out, warnings\n406\t\n407\t\n408\tdef _ref_schedule(iterations: int, n_ref: int) -> List[int]:\n409\t    \"\"\"Round-robin plan: how many reference samples to take AFTER hook i.\n410\t\n411\t    Even spread by construction (``round((i+1)*n_ref/iterations)`` cumulative),\n412\t    and the totals always land on exactly ``n_ref``. With more hook samples\n413\t    than reference samples this yields 0/1 per iteration; with fewer it takes\n414\t    several per iteration. The interleaving is the point: the S318 defect was\n415\t    a probe measured ONCE, outside the window that actually degraded.\n416\t    \"\"\"\n417\t    if iterations <= 0 or n_ref <= 0:\n418\t        return []\n419\t    plan: List[int] = []\n420\t    taken = 0\n421\t    for i in range(iterations):\n422\t        want = int(round((i + 1) * float(n_ref) / iterations))\n423\t        want = min(want, n_ref)\n424\t        plan.append(max(0, want - taken))\n425\t        taken += plan[-1]\n426\t    if taken < n_ref:\n427\t        plan[-1] += n_ref - taken\n428\t    return plan\n429\t\n430\t\n431\t# Session id used by every hook-latency corpus payload. Kept alnum+underscore\n432\t# so tool_lifecycle._safe_session_component passes it through unchanged (the\n433\t# observe-rail controls below need to predict the on-disk store filename).\n434\t_LATENCY_SESSION_ID = \"profile_latency\"\n435\t\n436\t\n437\tdef _latency_pre_payload(tool_use_id: str) -> bytes:\n438\t    \"\"\"PreToolUse payload for check_anti_ceo_overhead.py (record_pre carrier).\"\"\"\n439\t    return json.dumps({\n440\t        \"session_id\": _LATENCY_SESSION_ID,\n441\t        \"hook_event_name\": \"PreToolUse\",\n442\t        \"tool_name\": \"Bash\",\n443\t        \"tool_use_id\": tool_use_id,\n444\t        \"tool_input\": {\"command\": \"true\"},\n445\t    }).encode()\n446\t\n447\t\n448\tdef _latency_post_payload(tool_use_id: str) -> bytes:\n449\t    \"\"\"PostToolUse payload for check_output_secrets.py (record_post host).\"\"\"\n450\t    return json.dumps({\n451\t        \"session_id\": _LATENCY_SESSION_ID,\n452\t        \"hook_event_name\": \"PostToolUse\",\n453\t        \"tool_name\": \"Bash\",\n454\t        \"tool_use_id\": tool_use_id,\n455\t        \"duration_ms\": 42,\n456\t        \"tool_response\": \"profile latency probe output (benign, no secrets)\",\n457\t    }).encode()\n458\t\n459\t\n460\t"}]},"parent_tool_use_id":null,"session_id":"8e98cc69-9185-4f95-b319-4d1b22b49864","uuid":"b7cd880c-8938-496f-bb1a-f8feb0591523","timestamp":"2026-11-16T20:10:55.145Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_profile_opus_parts/reference.py","content":"\"\"\"Extracted implementation: reference.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nimport os\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\n\n\n\n# ---------------------------------------------------------------------------\n# ADR-163 Amendment (PLAN-169 S328) — runner-normalized SECOND KEY\n# ---------------------------------------------------------------------------\n#\n# Evidence: `check_output_secrets` measured p95 361.4 / 424.8 / 229.1 ms on\n# ubuntu-latest against the 180 ms hard ceiling while the ADR-163 contention\n# pre-probe (`python3 -c pass`, the SPAWN floor) read UNCONTENDED at 7.76 ms\n# and the same hook bytes measured 70-77 ms locally — and the immediately\n# preceding commit PASSED 3.5 h earlier with ZERO files touched under the\n# hook tree. `python3 -c pass` prices process CREATION; it is structurally\n# blind to a runner that is slow-but-uncontended once execution starts.\n#\n# Cure: a SECOND key, relative, against an EXECUTION reference measured in\n# the same run, round-robin-interleaved with the hook samples so both keys\n# price the same scheduler window. The absolute ceiling STAYS (no third\n# recalibration — \"bump the number\" already failed at ADR-163:291).\n#\n# PHASE 1 (this landing): labels are computed and PUBLISHED; exit codes stay\n# byte-identical to today. K is not derivable — zero paired (hook, ref)\n# samples exist anywhere. Phase 2 pins K_e per entry from an advisory window\n# and is plumbed here (`--relative-k-source`) but INERT without that file.\n\n# Closed set, DERIVED by every consumer (never recalled — the\n# `feedback-closed-sets-must-be-derived-not-recalled` class).\n_OUTCOME_LABELS: Tuple[str, ...] = (\n    \"pass\",\n    \"advisory_slow_runner\",\n    \"real_regression\",\n    \"infrastructure_contended\",\n)\n\n# label -> process exit code, PHASE 2 only. Phase 1 keeps today's 0/1.\n_LABEL_EXIT_CLASS: Dict[str, int] = {\n    \"pass\": 0,\n    \"advisory_slow_runner\": 0,\n    \"real_regression\": 1,\n    \"infrastructure_contended\": 5,\n}\n\n# Aggregation precedence (strongest verdict first): a PROVEN regression on\n# any entry outranks contention elsewhere, and contention outranks amnesty.\n_LABEL_PRECEDENCE: Tuple[str, ...] = (\n    \"real_regression\",\n    \"infrastructure_contended\",\n    \"advisory_slow_runner\",\n    \"pass\",\n)\n\n# The COMPLETE set of report keys the second key may add. Declared here so\n# the back-compat test can assert `set(new_report) - set(old_report)` is a\n# subset of it: a future key added without registering it here turns that\n# test RED instead of silently widening the report.\n_SECOND_KEY_REPORT_KEYS: Tuple[str, ...] = (\n    \"phase\",\n    \"verdict_label\",\n    \"exit_class\",\n    \"outcome_labels\",\n    \"exec_reference\",\n    \"relative_advisory\",\n    \"strict_relative\",\n    \"abs_backstop_ms\",\n    \"ref_drift_max\",\n    \"wall_budget_seconds\",\n    \"wall_deadline_seconds\",\n    \"wall_exceeded\",\n    \"elapsed_seconds\",\n    \"relative_warnings\",\n    \"ref_source_sha256\",\n    \"ref_samples_per_entry\",\n    \"relative_note\",\n)\n_SECOND_KEY_ENTRY_KEYS: Tuple[str, ...] = (\n    \"ref_p50_ms\",\n    \"ref_p95_ms\",\n    \"ref_samples\",\n    \"ref_split_half_drift\",\n    \"ref_valid\",\n    \"ref_failed\",\n    \"R_e\",\n    \"K_e\",\n    \"rel_ok\",\n    \"verdict_label\",\n    \"phase\",\n)\n\n# Absolute backstop above which a slow runner still FAILS instead of being\n# granted amnesty. OPEN QUESTION for the Owner: this number has no evidence\n# behind it — it is a \"what latency is unusable in a real session\" judgment.\n_ABS_BACKSTOP_MS = 600.0\n\n# Reference samples per corpus entry (round-robin). The relative key gates on\n# p50, where the ADR-163 nearest-rank index collapse cannot arise, so the\n# n>=22 separation rule does not bind here; 40 is the adopted floor.\n_REF_SAMPLES_PER_ENTRY = 40\n\n# Split-half p50 drift above which the REFERENCE itself is untrustworthy:\n# the machine moved mid-entry, so the ratio prices two different machines.\n_REF_DRIFT_MAX = 1.5\n\n# Self-cap fraction of --wall-budget-seconds. The cap fires BEFORE the\n# workflow's `timeout 420`, so rc 124 becomes unreachable in practice.\n_WALL_BUDGET_SAFETY_FRACTION = 0.9\n# (rail round-1 P2 retired `_WALL_CHECK_EVERY`: the wall is checked on EVERY\n# iteration and again before the reference lane, so there is no stride to\n# name. A stride here is a defect, not a tuning knob — it made the 378s\n# self-cap miss by up to ~300s, which is the rc124 the cap exists to avoid.)\n\n# --- the frozen execution reference ----------------------------------------\n# Three terms, source-pinned by sha256 in the report. Any edit changes that\n# hash DELIBERATELY: a heavier reference silently LOOSENS the relative key.\n_REF_EXEC_SOURCE = r'''#!/usr/bin/env python3\n# Frozen EXECUTION reference — ADR-163 Amendment (PLAN-169 S328).\n#\n# THREE TERMS, in order:\n#   1. cold stdlib imports (json / re / hashlib / pathlib) + a fixed\n#      re.compile set   -- prices the interpreter + import machinery;\n#   2. a fixed CPU-bound hashing loop        -- prices the core;\n#   3. M x open/append/flock/fsync/rename    -- prices the filesystem.\n#\n# HARD CONTRACT: stdlib ONLY, and NOTHING from the framework's own hook\n# tree. The regression class this gate exists to catch IS an eager\n# framework import; a reference paying that same import would inflate\n# numerator AND denominator and go blind to its own reason to exist. An\n# anti-coupling test walks this source's AST and asserts it.\nimport os\nimport sys\n\ntry:\n    import fcntl as _locker\nexcept ImportError:  # pragma: no cover - non-POSIX\n    _locker = None\n\n# Term sizing is MEASURED, not guessed (local macOS, 2026-08-25, N=30):\n# spawn floor 23.9ms; imports +6.4ms; these constants add ~+16ms of CPU and\n# ~+5ms of locked IO, putting the reference at p50 ~46ms of which ~48% is\n# EXECUTION. The first draft (4000/6) sat at 34ms / 30% execution — barely\n# more than the spawn probe it replaces, which would leave the ratio nearly\n# as blind as the probe. The corpus hooks are ~52-64ms at ~63% execution;\n# the residual under-tracking is declared, not hidden.\n_HASH_ROUNDS = 14000\n_IO_CYCLES = 24\n_PROBE = \"ref-exec 2026-08-25 https://example.invalid token=abc12345\"\n\n\ndef term_imports():\n    import json\n    import re\n    import hashlib\n    import pathlib\n\n    pats = (\n        re.compile(r\"[A-Za-z0-9_]{8,}\"),\n        re.compile(r\"(?i)\\b(secret|token|key)\\b\"),\n        re.compile(r\"^\\s*[-*]\\s+\"),\n        re.compile(r\"\\d{4}-\\d{2}-\\d{2}\"),\n        re.compile(r\"https?://\\S+\"),\n    )\n    blob = json.dumps({\"probe\": _PROBE, \"rounds\": _HASH_ROUNDS})\n    hits = sum(1 for p in pats if p.search(blob))\n    hits += len(pathlib.PurePosixPath(\"/a/b/c/d\").parts)\n    hits += len(hashlib.sha256(blob.encode(\"utf-8\")).hexdigest())\n    return hits\n\n\ndef term_cpu():\n    import hashlib\n\n    acc = hashlib.sha256(b\"ceo-exec-reference-seed\")\n    for i in range(_HASH_ROUNDS):\n        acc.update(acc.digest())\n        acc.update(str(i).encode(\"ascii\"))\n    return acc.hexdigest()\n\n\ndef term_io(dirpath):\n    if not os.path.isdir(dirpath):\n        os.makedirs(dirpath, exist_ok=True)\n    target = os.path.join(dirpath, \"ref-exec.log\")\n    made = 0\n    for i in range(_IO_CYCLES):\n        staging = os.path.join(dirpath, \"ref-exec.%d.part\" % i)\n        fh = open(staging, \"a\")\n        try:\n            if _locker is not None:\n                _locker.flock(fh.fileno(), _locker.LOCK_EX)\n            fh.write(\"ref-exec cycle %d\\n\" % i)\n            fh.flush()\n            os.fsync(fh.fileno())\n            if _locker is not None:\n                _locker.flock(fh.fileno(), _locker.LOCK_UN)\n        finally:\n            fh.close()\n        os.replace(staging, target)\n        made += 1\n    return made\n\n\ndef main():\n    dirpath = sys.argv[1] if len(sys.argv) > 1 else os.getcwd()\n    a = term_imports()\n    b = term_cpu()\n    c = term_io(dirpath)\n    sys.stdout.write(\"%d %s %d\\n\" % (a, b[:8], c))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n'''\n\n\ndef ref_source_sha256() -> str:\n    \"\"\"sha256 of the frozen reference source text (report-pinned).\"\"\"\n    return hashlib.sha256(_REF_EXEC_SOURCE.encode(\"utf-8\")).hexdigest()\n\n\ndef _is_real_number(value: Any) -> bool:\n    \"\"\"True only for a finite, non-bool int/float (codex r1 F8 case list).\n\n    ``True`` / ``\"-1\"`` / ``NaN`` / ``-Infinity`` / ``None`` all read False,\n    exactly as the ADR-163 contention probe's parser treats them — the two\n    parsers must not diverge.\n    \"\"\"\n    if isinstance(value, bool) or not isinstance(value, (int, float)):\n        return False\n    try:\n        return math.isfinite(float(value))\n    except (TypeError, ValueError, OverflowError):\n        return False\n\n\ndef _split_half_drift(samples: List[float]) -> float:\n    \"\"\"Ratio between the p50 of the two TEMPORAL halves (>= 1.0).\n\n    ``inf`` when undefined (too few samples, or a zero/negative half-median):\n    an undefined drift reads as CONTENDED, never as permission to gate.\n    \"\"\"\n    n = len(samples)\n    if n < 4:\n        return float(\"inf\")\n    half = n // 2\n    first = _pct_of_sorted(sorted(samples[:half]), 50)\n    second = _pct_of_sorted(sorted(samples[half:]), 50)\n    lo, hi = (first, second) if first <= second else (second, first)\n    if not _is_real_number(lo) or lo <= 0:\n        return float(\"inf\")\n    return hi / lo\n\n\ndef _classify_entry(\n    hook_p50: float,\n    hook_p95: float,\n    ref_p50: Any,\n    ref_drift: Any,\n    p95_ceiling_ms: float,\n    k_e: Optional[float] = None,\n    ref_measured: bool = True,\n    wall_exceeded: bool = False,\n    abs_backstop_ms: float = _ABS_BACKSTOP_MS,\n    strict_relative: bool = False,\n    ref_failed: bool = False,\n) -> Tuple[str, Optional[bool], bool]:\n    \"\"\"PURE verdict function — returns ``(label, rel_ok, ref_valid)``.\n\n    ``rel_ok`` is ``None`` whenever no K applies to this entry (phase 1, or a\n    phase-2 file with no usable K for this name): the label then follows the\n    ABSOLUTE key alone, which is exactly today's contract.\n\n    ``strict_relative`` enables the ``abs_ok and not rel_ok`` cell (a clean\n    regression that still fits under the fixed ceiling — the blind spot\n    ADR-163:291 declares). Default OFF: it is a detection-floor product call\n    for the Owner, implemented and unit-tested but not armed.\n    \"\"\"\n    if wall_exceeded:\n        return (\"infrastructure_contended\", None, False)\n\n    ref_valid = True\n    if ref_measured:\n        if ref_failed:\n            # rail round-1 P1. Checked FIRST and on its own: a failing\n            # reference can still produce numbers that pass every shape test\n            # below (a fast crash is a small, low-drift, perfectly finite\n            # sample). Shape is not provenance — only the return code says\n            # whether the process actually did the work.\n            ref_valid = False\n        elif not _is_real_number(ref_p50) or ref_p50 <= 0:\n            ref_valid = False\n        elif not _is_real_number(ref_drift) or ref_drift > _REF_DRIFT_MAX:\n            ref_valid = False\n        if not ref_valid:\n            return (\"infrastructure_contended\", None, False)\n    else:\n        ref_valid = False\n\n    abs_ok = hook_p95 <= p95_ceiling_ms\n\n    rel_ok: Optional[bool] = None\n    if k_e is not None and ref_measured and ref_valid:\n        rel_ok = hook_p50 <= k_e * ref_p50\n\n    if rel_ok is None:\n        # Phase 1 for this entry: the absolute key is the only key.\n        return (\"pass\" if abs_ok else \"real_regression\", None, ref_valid)\n\n    if abs_ok:\n        if rel_ok or not strict_relative:\n            return (\"pass\", rel_ok, True)\n        return (\"real_regression\", rel_ok, True)\n\n    if rel_ok and hook_p95 <= abs_backstop_ms:\n        return (\"advisory_slow_runner\", rel_ok, True)\n    return (\"real_regression\", rel_ok, True)\n\n\ndef _aggregate_label(labels: List[str]) -> str:\n    \"\"\"Strongest verdict in the corpus, by _LABEL_PRECEDENCE.\"\"\"\n    for candidate in _LABEL_PRECEDENCE:\n        if candidate in labels:\n            return candidate\n    return \"pass\"\n\n\ndef _load_relative_k_source(path: str) -> Tuple[Dict[str, float], List[str]]:\n    \"\"\"Parse the phase-2 K file -> ``({entry_name: K}, warnings)``.\n\n    Every rejection is NAMED in ``warnings`` and degrades that entry (or the\n    whole file) back to PHASE 1 — never to a silently wider gate. An\n    ``admissibility_max_K`` that the K REACHES is a REJECTION (the cap is\n    exclusive — equality already loses the positive control): the design's\n    \"an empty admissibility interval means the reference is mis-shaped\"\n    branch is mechanical here, so \"widen K\" cannot be reached by editing\n    one number. Exception text is never echoed (it can carry a machine path).\n    \"\"\"\n    warnings: List[str] = []\n    try:\n        doc = json.loads(Path(path).read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError) as exc:\n        return {}, [\"relative_k_source_unreadable: %s\" % type(exc).__name__]\n    if not isinstance(doc, dict):\n        return {}, [\"relative_k_source_malformed: top level is not an object\"]\n    entries = doc.get(\"entries\")\n    if not isinstance(entries, dict):\n        return {}, [\n            \"relative_k_source_malformed: 'entries' missing or not an object\"\n        ]\n    out: Dict[str, float] = {}\n    for name, spec in sorted(entries.items()):\n        if not isinstance(spec, dict):\n            warnings.append(\"relative_k_invalid[%s]: entry is not an object\" % name)\n            continue\n        k = spec.get(\"K\")\n        if not _is_real_number(k) or k <= 0:\n            warnings.append(\n                \"relative_k_invalid[%s]: K=%r is not a finite positive JSON \"\n                \"number\" % (name, k)\n            )\n            continue\n        cap = spec.get(\"admissibility_max_K\")\n        if cap is not None:\n            if not _is_real_number(cap) or cap <= 0:\n                warnings.append(\n                    \"relative_k_invalid[%s]: admissibility_max_K=%r is not a \"\n                    \"finite positive JSON number\" % (name, cap)\n                )\n                continue\n            # rail round-3 P2 — the cap is EXCLUSIVE. `>` alone let K land\n            # exactly ON it, and the guarantee the cap encodes (\"the +150ms\n            # positive control still fails at the worst observed reference\")\n            # needs `hook_p50 > K * ref_p50`, i.e. K STRICTLY below\n            # (baseline+150)/max_ref — because the classifier's comparison is\n            # inclusive. Measured with baseline 70 / worst ref 50 / cap 4.4:\n            # K == cap gives `advisory_slow_runner` on the regressed sample,\n            # K one epsilon below gives `real_regression`. Float pushes the\n            # same way (4.4*50 == 220.00000000000003 > 220.0), so equality is\n            # rejected rather than nudged with a tolerance.\n            if k >= cap:\n                warnings.append(\n                    \"relative_k_inadmissible[%s]: K=%s reaches \"\n                    \"admissibility_max_K=%s (the cap is exclusive) — the \"\n                    \"+150ms positive control would not fail at the worst \"\n                    \"observed reference; entry stays on phase 1\"\n                    % (name, k, cap)\n                )\n                continue\n        out[name] = float(k)\n    return out, warnings\n\n\ndef _ref_schedule(iterations: int, n_ref: int) -> List[int]:\n    \"\"\"Round-robin plan: how many reference samples to take AFTER hook i.\n\n    Even spread by construction (``round((i+1)*n_ref/iterations)`` cumulative),\n    and the totals always land on exactly ``n_ref``. With more hook samples\n    than reference samples this yields 0/1 per iteration; with fewer it takes\n    several per iteration. The interleaving is the point: the S318 defect was\n    a probe measured ONCE, outside the window that actually degraded.\n    \"\"\"\n    if iterations <= 0 or n_ref <= 0:\n        return []\n    plan: List[int] = []\n    taken = 0\n    for i in range(iterations):\n        want = int(round((i + 1) * float(n_ref) / iterations))\n        want = min(want, n_ref)\n        plan.append(max(0, want - taken))\n        taken += plan[-1]\n    if taken < n_ref:\n        plan[-1] += n_ref - taken\n    return plan\n\n\n# Session id used by every hook-latency corpus payload. Kept alnum+underscore\n# so tool_lifecycle._safe_session_component passes it through unchanged (the\n# observe-rail controls below need to predict the on-disk store filename).\n_LATENCY_SESSION_ID = \"profile_latency\"\n\n\ndef _latency_pre_payload(tool_use_id: str) -> bytes:\n    \"\"\"PreToolUse payload for check_anti_ceo_overhead.py (record_pre carrier).\"\"\"\n    return json.dumps({\n        \"session_id\": _LATENCY_SESSION_ID,\n        \"hook_event_name\": \"PreToolUse\",\n        \"tool_name\": \"Bash\",\n        \"tool_use_id\": tool_use_id,\n        \"tool_input\": {\"command\": \"true\"},\n    }).encode()\n\n\ndef _latency_post_payload(tool_use_id: str) -> bytes:\n    \"\"\"PostToolUse payload for check_output_secrets.py (record_post host).\"\"\"\n    return json.dumps({\n        \"session_id\": _LATENCY_SESSION_ID,\n        \"hook_event_name\": \"PostToolUse\",\n        \"tool_name\": \"Bash\",\n        \"tool_use_id\": tool_use_id,\n        \"duration_ms\": 42,\n        \"tool_response\": \"profile latency probe output (benign, no secrets)\",\n    }).encode()\n\n\n","numLines":460,"startLine":1,"totalLines":460}},"tool_result_meta":[{"id":"toolu_01QR3LHi4jvTPgJbDsjRWFeX","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
