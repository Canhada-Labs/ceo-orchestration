{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch73nuUxuDvddtaSnzpa9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01WPgMSvG6ctXHCRXxym1rZT","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/budget-summary.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6292,"cache_read_input_tokens":101206,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6292},"output_tokens":5,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"15f68acd-8563-46de-ac1c-c65891f7fb4e","uuid":"e81dfa5a-2f05-4055-b931-6c756e089e8e","timestamp":"2026-11-16T18:04:35.920Z","request_id":"req_011Ch73nuHopYaq9Sqmp7S79","wire_tool_inputs":{"toolu_01WPgMSvG6ctXHCRXxym1rZT":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/budget-summary.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WPgMSvG6ctXHCRXxym1rZT","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"budget-summary.py — multi-rotation FinOps rollup (PLAN-083 Wave 0b sub-0.8).\n3\t\n4\tThis is the **PLAN-083 reissue** of ``.claude/scripts/budget-summary.py``.\n5\tIt supersedes the prior ADR-033 implementation in three dimensions per\n6\tPLAN-083 §5.2 row 0.8:\n7\t\n8\t1. **Multi-rotation read** — globs ``audit-log*.jsonl`` in the audit dir\n9\t   so cumulative spend reflects all 12 backup rotations + the active\n10\t   log. The prior script read only ``audit-log.jsonl`` and therefore\n11\t   reported ``$0.28`` against a memory claim of ``~$1003-1543`` for the\n12\t   S82-S99 window.\n13\t\n14\t2. **Dedup by event sha256** — per PLAN-083 §13 risk register row\n15\t   \"FinOps backup glob double-counts events across rotations\". On a\n16\t   rotation boundary the tail of the previous log may be partially\n17\t   mirrored in the next rotation's head (atomic rename + retry\n18\t   semantics). We canonicalize each event (drop ``hmac``, ``hmac_error``,\n19\t   ``hook_duration_ms``) and compute sha256 over the sorted-keys JSON\n20\t   form; first occurrence wins.\n21\t\n22\t3. **Codex MCP tokens included** — ``pair_rail_case`` action events\n23\t   contribute ``tokens_in`` / ``tokens_out`` to the rollup. Combined\n24\t   with the companion ``codex-adapter-token-wire.patch`` that\n25\t   actually populates those fields, this closes the\n26\t   \"tokens not tracked for Codex\" half of the observability gap.\n27\t\n28\t4. **plan_id auto-attribution** — events that carry an explicit\n29\t   ``plan_id`` field win. Otherwise we infer ``plan_id`` from the\n30\t   nearest preceding ``plan_status_transition`` event in the same\n31\t   ``session_id`` whose status is ``executing`` (per ADR-058). Only\n32\t   when both signals are absent do we fall back to ``(unknown)``.\n33\t\n34\t5. **Native-source cross-check (PLAN-178 W1.2, default-OFF)** — the\n35\t   ``--native`` flag (or ``CEO_BUDGET_NATIVE=1``) appends a cross-check\n36\t   of the audit-log spawn ledger against the harness-native transcript\n37\t   corpus under ``~/.claude/projects/<cwd-slug>/<SESSION-UUID>/subagents/``\n38\t   (probe: ``.claude/plans/PLAN-178/w12-native-cost-probe.md``).\n39\t   Doctrine: **cross-check, not authority-swap** — the native source\n40\t   NEVER silently replaces the audit-log rollup; UNMATCHED residue on\n41\t   BOTH sides is always reported (silencing it would fake a low\n42\t   divergence). Model aliases (``opus`` / ``sonnet`` / ``fable`` /\n43\t   ``claude-fable-5[1m]`` …) are resolved through the repo's EXISTING\n44\t   normalizer (``optimizer/model_normalize.py``) + the pricing registry\n45\t   below — an unresolvable/unpriced model is reported as cost ``TBD``,\n46\t   never as ``$0``. When the native source is dormant (no transcripts on\n47\t   disk) and the flag is OFF, output is byte-for-byte unchanged.\n48\t\n49\t## Usage\n50\t\n51\t::\n52\t\n53\t    python3 budget-summary.py summary\n54\t    python3 budget-summary.py summary --since 30d\n55\t    python3 budget-summary.py summary --plan-id PLAN-081\n56\t    python3 budget-summary.py summary --by-wave\n57\t    python3 budget-summary.py summary --json\n58\t    python3 budget-summary.py summary --validate-memory-claim\n59\t    python3 budget-summary.py summary --native\n60\t\n61\tStdlib only. Python 3.9+.\n62\t\"\"\"\n63\t\n64\tfrom __future__ import annotations\n65\t\n66\timport argparse\n67\timport glob\n68\timport hashlib\n69\timport importlib.util\n70\timport json\n71\timport os\n72\timport re\n73\timport sys\n74\tfrom datetime import datetime, timedelta, timezone\n75\tfrom pathlib import Path\n76\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Set, Tuple\n77\timport sys as _sys_rp\n78\tfrom pathlib import Path as _Path_rp\n79\t_HOOKS_RP = _Path_rp(__file__).resolve()\n80\tfor _anc in _HOOKS_RP.parents:\n81\t    if (_anc / \".claude\" / \"hooks\" / \"_lib\").is_dir():\n82\t        if str(_anc / \".claude\" / \"hooks\") not in _sys_rp.path:\n83\t            _sys_rp.path.insert(0, str(_anc / \".claude\" / \"hooks\"))\n84\t        break\n85\tfrom _lib import runtime_paths as _rp  # noqa: E402  # PLAN-182 W1 single resolver\n86\t\n87\t\n88\t# ---------------------------------------------------------------------------\n89\t# Constants\n90\t# ---------------------------------------------------------------------------\n91\t\n92\t#: ``--since`` time-expression parser.\n93\t_SINCE_RE = re.compile(r\"^(\\d+)\\s*([mhd])$\")\n94\t\n95\t#: PLAN-id syntactic check (Sec MF-3 — bound any plan_id we display).\n96\t_PLAN_ID_RE = re.compile(r\"^PLAN-[0-9]{3}$\")\n97\t\n98\t#: Wave-id parser (e.g. ``\"wave-0a\"``, ``\"wave-1\"``, ``\"wave-minus-1\"``).\n99\t_WAVE_ID_RE = re.compile(r\"^wave-[a-z0-9-]{1,16}$\")\n100\t\n101\t#: Memory-claim band per CLAUDE.md §6 (S82-S99 cumulative).\n102\tMEMORY_CLAIM_LOW_USD: float = 1003.0\n103\tMEMORY_CLAIM_HIGH_USD: float = 1543.0\n104\tMEMORY_CLAIM_PASS_RATIO_LOW: float = 0.5\n105\tMEMORY_CLAIM_PASS_RATIO_HIGH: float = 1.5\n106\t\n107\t#: Audit-log filename glob.\n108\tAUDIT_LOG_GLOB: str = \"audit-log*.jsonl\"\n109\t\n110\t#: Fields stripped before computing event sha256 (rotation overlap dedup).\n111\t#: ``hmac`` and ``hmac_error`` differ between rotations because they're\n112\t#: chained off prior_hmac; ``hook_duration_ms`` is observation-time noise.\n113\t_DEDUP_STRIP_FIELDS: Tuple[str, ...] = (\"hmac\", \"hmac_error\", \"hook_duration_ms\")\n114\t\n115\t#: Default per-1k-token pricing (USD). Falls back to these if the\n116\t#: pricing doc is unavailable. Numbers are conservative midpoints from\n117\t#: Anthropic + OpenAI public pricing as of 2026-05; intent here is\n118\t#: *order-of-magnitude correctness*, not pricing engine.\n119\t#: PLAN-120 WS-C: refreshed to current Anthropic slugs + rates (per-1k tokens,\n120\t#: USD). claude-opus-4-8 = current flagship $5/$25 per MTok (0.005/0.025 per-1k);\n121\t#: claude-opus-4-7 RETAINED HISTORICAL ($15/$75) for log replay of pre-4.8\n122\t#: sessions; Sonnet 4.6 = $3/$15; Haiku 4.5 = $1/$5 (was 4x underpriced).\n123\t#: PLAN-163 T1.5b — ADDITIVE Claude 5 fleet rows (historical rows retained,\n124\t#: ADR-142): fable-5 $10/$50; opus-5 $5/$25 (drop-in at the 4.8 rate);\n125\t#: opus-5-fast $10/$50 premium row; sonnet-5 $2/$10 — the launch intro price\n126\t#: became the STANDARD price (official pricing page fetched 2026-09-01: the\n127\t#: scheduled 2026-09-01 increase to $3/$15 \"will not occur\"; PLAN-169 S338\n128\t#: follow-up).\n129\t#: ADR-149 Amendment 3 (S357): claude-opus-5-5 $4/$20 (pricing page fetched\n130\t#: 2026-09-22); its 0.05x cache-read rate lives in\n131\t#: _CACHE_READ_MULTIPLIER_OVERRIDES below.\n132\t_DEFAULT_PRICING: Dict[str, Dict[str, float]] = {\n133\t    \"claude-opus-4-8\":             {\"in\": 0.005, \"out\": 0.025},\n134\t    \"claude-opus-4-8-fast\":       {\"in\": 0.010, \"out\": 0.050},\n135\t    \"claude-fable-5\":             {\"in\": 0.010, \"out\": 0.050},\n136\t    \"claude-fable-5-1\":           {\"in\": 0.010, \"out\": 0.050},  # ADR-149 Amendment 2 (S338)\n137\t    \"claude-opus-5\":              {\"in\": 0.005, \"out\": 0.025},\n138\t    \"claude-opus-5-fast\":         {\"in\": 0.010, \"out\": 0.050},\n139\t    \"claude-opus-5-5\":            {\"in\": 0.004, \"out\": 0.020},  # ADR-149 Amendment 3 (S357)\n140\t    \"claude-sonnet-5\":            {\"in\": 0.002, \"out\": 0.010},\n141\t    \"claude-opus-4-7\":            {\"in\": 0.015, \"out\": 0.075},\n142\t    \"claude-opus-4\":              {\"in\": 0.015, \"out\": 0.075},\n143\t    \"claude-sonnet-4-6\":          {\"in\": 0.003, \"out\": 0.015},\n144\t    \"claude-sonnet-4-5\":          {\"in\": 0.003, \"out\": 0.015},\n145\t    \"claude-sonnet-4\":            {\"in\": 0.003, \"out\": 0.015},\n146\t    \"claude-haiku-4-5-[REDACTED:rg]\":  {\"in\": 0.001, \"out\": 0.005},\n147\t    \"claude-haiku-4-5\":           {\"in\": 0.001, \"out\": 0.005},\n148\t    \"claude-haiku-4\":             {\"in\": 0.001, \"out\": 0.005},\n149\t    \"gpt-5\":             {\"in\": 0.005,  \"out\": 0.020},\n150\t    \"gpt-5-codex\":       {\"in\": 0.005,  \"out\": 0.020},\n151\t    \"gpt-5-mini\":        {\"in\": 0.0005, \"out\": 0.002},\n152\t    \"o3\":                {\"in\": 0.015,  \"out\": 0.060},\n153\t    \"o4-mini\":           {\"in\": 0.001,  \"out\": 0.004},\n154\t}\n155\t\n156\t\n157\t#: Fractional-seconds tolerant variant (PLAN-178 W1.2). Native transcript\n158\t#: lines stamp ``2026-08-11T14:48:12.648Z``; the audit-log stamps whole\n159\t#: seconds. Ordering uses the raw ISO string (lexicographic == chronological\n160\t#: for same-zone ISO-8601); PARSING for the ``--since`` cutoff strips the\n161\t#: fraction first, then reuses ``_parse_ts``.\n162\t_TS_FRACTION_RE = re.compile(r\"\\.\\d+(?=Z|[+-]\\d{2}:?\\d{2}$)\")\n163\t\n164\t\n165\t# ---------------------------------------------------------------------------\n166\t# Pricing\n167\t# ---------------------------------------------------------------------------\n168\t\n169\t\n170\t#: PLAN-163 W2 P2a — event-date-aware rows (per-1k twin of the tables in\n171\t#: audit-telemetry.py / ceo-cost.py): an event is priced by its OWN ``ts``,\n172\t#: never by \"today\" and never by mutating the global row. Shape: model ->\n173\t#: (cutoff_iso_date, row_through_cutoff_inclusive, row_after).\n174\t#: EMPTY since the PLAN-169 S338 follow-up: the Sonnet 5 row ($2/$10 per\n175\t#: MTok intro through 2026-08-31, then $3/$15) was retired when the official\n176\t#: pricing page (fetched 2026-09-01) made $2/$10 the standard price and\n177\t#: cancelled the 2026-09-01 increase — both legs equal the base row. The\n178\t#: MECHANISM (the ``ts`` branch of ``compute_cost_usd``) stays;\n179\t#: test_model_fleet_presence.py exercises it through a synthetic row.\n180\t_DATED_PRICING: Dict[str, Tuple[str, Dict[str, float], Dict[str, float]]] = {}\n181\t\n182\t\n183\t# ---------------------------------------------------------------------------\n184\t# PLAN-178 W1.2-3 — model-id normalization (alias → canonical pricing key)\n185\t#\n186\t# The native corpus carries a MIXED model vocabulary (probe §1.3: bare\n187\t# aliases ``opus``/``sonnet``/``fable``/``haiku``, full ids, a ``[1m]``\n188\t# packaging suffix, and 262/416 metas with NO model at all). Resolution\n189\t# REUSES the repo's existing registry surfaces — ``optimizer/\n190\t# model_normalize.py`` (``normalize_model_name`` + its ``_RAW_ALIASES``\n191\t# closed alias map) and the ``_DEFAULT_PRICING`` table above — and\n192\t# deliberately does NOT introduce a second local alias table. A bare\n193\t# family alias is resolved ONLY when the existing registry contains\n194\t# exactly one canonical id for that family (today: ``fable`` →\n195\t# ``claude-fable-5``); an ambiguous family (``opus`` spans 4-7/4-8/5/…)\n196\t# stays UNRESOLVED — we never guess a version (the load-bearing\n197\t# invariant of ``model_normalize.py``: never collapse two versions).\n198\t# Unresolved / unpriced models are reported as cost ``TBD``, never $0.\n199\t# ---------------------------------------------------------------------------\n200\t\n201\t\n202\t#: The ``[1m]`` context-window packaging suffix the harness appends to a\n203\t#: live model id (probe §1.3: ``claude-fable-5[1m]``). A packaging tag,\n204\t#: not a version — stripped generically before alias lookup.\n205\t_ONE_M_SUFFIX_RE = re.compile(r\"\\[1m\\]$\")\n206\t\n207\t#: A bare family alias (``opus`` / ``sonnet`` / ``fable`` / ``haiku`` …):\n208\t#: a single lowercase token with no version component.\n209\t_BARE_FAMILY_RE = re.compile(r\"^[a-z][a-z0-9]*$\")\n210\t\n211\t#: Family extractor over canonical Claude pricing keys\n212\t#: (``claude-<family>-…`` → ``<family>``).\n213\t_CLAUDE_FAMILY_RE = re.compile(r\"^claude-([a-z]+)-\")\n214\t\n215\t\n216\t#: Resolved once at import; None ⇒ degraded (but never crashing) mode.\n217\t_NORMALIZE_MODEL_NAME = None  # initialized after binding\n218\t\n219\t\n220\t# ---------------------------------------------------------------------------\n221\t# Rollup\n222\t# ---------------------------------------------------------------------------\n223\t\n224\t\n225\t#: Audit actions that contribute tokens to the rollup.\n226\t_TOKEN_BEARING_ACTIONS: Tuple[str, ...] = (\n227\t    \"agent_spawn\",        # Claude sub-agent dispatches\n228\t    \"pair_rail_case\",     # Codex MCP cross-LLM gate (post-wire)\n229\t    \"pair_rail_promotion\",  # Phase 4 promotion gate runs\n230\t)\n231\t\n232\t\n233\t# ---------------------------------------------------------------------------\n234\t# PLAN-133 C4 — benchmark co-report (harbor-style row)\n235\t#\n236\t# Default-OFF behavioral surface, gated by the ``--benchmarks`` flag (and the\n237\t# ``CEO_BUDGET_BENCHMARKS=1`` env opt-in). When OFF, the rollup output is\n238\t# byte-for-byte unchanged. When ON, a ``benchmarks`` block is appended that\n239\t# co-reports **cost + compute + turns alongside pass-rate** per skill so a\n240\t# benchmark is never read as a bare scalar — the same harbor-style row the\n241\t# ``audit-query benchmarks`` reader emits (PLAN-133 C4). $0, read-only,\n242\t# derives only from fields already on the ``benchmark_run`` event.\n243\t# ---------------------------------------------------------------------------\n244\t\n245\t\n246\t# ---------------------------------------------------------------------------\n247\t# PLAN-178 W1.2-2 — native-source cross-check (audit-log × harness corpus)\n248\t#\n249\t# Default-OFF behavioral surface, gated by the ``--native`` flag (and the\n250\t# ``CEO_BUDGET_NATIVE=1`` env opt-in) — same pattern as the C4 benchmark\n251\t# block: when OFF, output is byte-for-byte unchanged. When ON, a\n252\t# ``native_cross_check`` block joins the audit-log ``agent_spawn`` ledger\n253\t# against the harness-native transcript corpus:\n254\t#\n255\t#     ~/.claude/projects/<cwd-slug>/<SESSION-UUID>/subagents/agent-a*.jsonl\n256\t#     ~/.claude/projects/<cwd-slug>/<SESSION-UUID>/subagents/workflows/\n257\t#         wf_*/agent-a*.jsonl        (journal.jsonl EXCLUDED — no meta)\n258\t#\n259\t# Join key (probe §handoff): ``(session_id, agentType~subagent_type,\n260\t# ordinal-by-timestamp)`` — the audit-log has no agentId and the native\n261\t# meta has no desc_hash, so within each (session, type) group both sides\n262\t# are sorted by timestamp and zipped pairwise. UNMATCHED residue on BOTH\n263\t# sides is ALWAYS reported (own section + count): silencing it would\n264\t# produce a falsely-low divergence. Rail category comes from the PATH\n265\t# shape (``workflows/wf_*/`` ⇒ workflow), never from ``taskKind`` — the\n266\t# field cannot distinguish the rails (probe §3 blocker #1).\n267\t#\n268\t# Doctrine: **cross-check, not authority-swap** — the audit-log rollup\n269\t# above remains the sole authority; this block is additive evidence and\n270\t# degrades (dormant) to nothing when the corpus is absent. Cache-token\n271\t# columns are reported token-only (no invented cache pricing); cost is\n272\t# computed over input+output, and a spawn whose model cannot be resolved\n273\t# to a priced id is reported as cost TBD — never $0.\n274\t# ---------------------------------------------------------------------------\n275\t\n276\t\n277\t#: Usage keys summed per transcript (probe §handoff item 4). Cache columns\n278\t#: are reported token-only — no cache pricing row exists in the registry\n279\t#: and we never invent one.\n280\t_NATIVE_USAGE_KEYS: Tuple[str, ...] = (\n281\t    \"input_tokens\",\n282\t    \"output_tokens\",\n283\t    \"cache_creation_input_tokens\",\n284\t    \"cache_read_input_tokens\",\n285\t)\n286\t\n287\t\n288\t#: ADR-149 Amendment 2 (S338, codex rail r1 P2): the cache-read multiplier\n289\t#: is PER MODEL. The pricing page (fetched 2026-09-01) prices cache hits on\n290\t#: Claude Fable 5.1 / Mythos 5.1 at 0.025x the base input price\n291\t#: ($0.25/MTok). A flat 0.10x would OVERSTATE Fable 5.1 cache reads 4x.\n292\t#: ADR-149 Amendment 3 (S357): Claude Opus 5.5 cache hits are 0.05x its $4\n293\t#: base ($0.20/MTok, pricing page fetched 2026-09-22) — a flat 0.10x would\n294\t#: overstate them 2x. Every other model of the ADR-149 working set keeps\n295\t#: the standard 0.10x; Mythos 5.1 (0.025x on the same page) is outside\n296\t#: the working set and carries no entry. Keys are canonical ids.\n297\t#: ceo-cost-transcripts.py mirrors this table exactly;\n298\t#: test_model_fleet_presence.py binds the two.\n299\t_CACHE_READ_MULTIPLIER_DEFAULT: float = 0.10\n300\t_CACHE_READ_MULTIPLIER_OVERRIDES: Dict[str, float] = {\n301\t    \"claude-fable-5-1\": 0.025,\n302\t    \"claude-opus-5-5\": 0.05,\n303\t}\n304\t\n305\t\n306\t# ---------------------------------------------------------------------------\n307\t# PLAN-186 W0 (AC-1b) — transcripts as the PRIMARY cost source\n308\t# ---------------------------------------------------------------------------\n309\t#\n310\t# The audit log is a GOVERNANCE ledger (agent_spawn rows; tokens_in/out on\n311\t# them are best-effort and frequently absent). The real token ledger is the\n312\t# harness-native transcript corpus — `message.usage` per assistant turn —\n313\t# which `.claude/scripts/ceo-cost-transcripts.py` reads with the full\n314\t# input / output / cache-read / cache-write-5m / cache-write-1h split and\n315\t# per-model prices. This module consumes that instrument through its\n316\t# programmatic API and prints BOTH sources, labelled, side by side.\n317\t# `--source audit` restores the pre-PLAN-186 rendering byte-for-byte.\n318\t#\n319\t# SCOPE NOTE (deliberate, not an oversight): this repo carries THREE\n320\t# independent pricing tables — `ceo-cost.py::_DEFAULT_PRICING`, the model\n321\t# registry behind `budget-summary.py::compute_cost_usd`, and the\n322\t# instrument's `_EMBEDDED_PRICING` / `cost-table.yaml` loader. Unifying them\n323\t# is a separate wave. This integration only REUSES what the instrument\n324\t# already exposes: the transcripts block is priced by the instrument, the\n325\t# audit block by whatever priced it before, and each block says so.\n326\t#\n327\t# The loader below is the one thing that cannot live in the instrument: its\n328\t# filename is hyphenated, so every caller needs its own importlib bootstrap.\n329\t# Everything else (root resolution, collection, rendering) is delegated, so\n330\t# the two callers cannot drift apart.\n331\t\n332\t_TRANSCRIPTS_MODULE_NAME = \"ceo_cost_transcripts\"\n333\t_TRANSCRIPTS_FILENAME = \"ceo-cost-transcripts.py\"\n334\t\n335\t\n336\t#: Resolved ONCE, from the instrument, so the two callers cannot publish a\n337\t#: different `--source` domain or a different banner than the block they\n338\t#: render. The literals are a fail-soft fallback for a missing instrument\n339\t#: (argparse needs a concrete tuple at parser-build time) and are asserted\n340\t#: equal to the instrument's in test_ceo_cost_integration.py.\n341\t_TX_MODULE = None  # initialized after binding\n342\tSOURCE_CHOICES = (\n343\t    _TX_MODULE.SOURCE_CHOICES\n344\t    if _TX_MODULE is not None\n345\t    else (\"transcripts\", \"audit\", \"both\")\n346\t)\n347\tAUDIT_BANNER = (\n348\t    _TX_MODULE.AUDIT_BANNER\n349\t    if _TX_MODULE is not None\n350\t    else \"=== SOURCE: AUDIT LOG (governance ledger -- SECONDARY) ===\"\n351\t)\n352\tROOT_ENV = (\n353\t    _TX_MODULE.ROOT_ENV\n354\t    if _TX_MODULE is not None\n355\t    else \"CEO_COST_TRANSCRIPTS_DIR\"\n356\t)\n357\t\n358\t\n359\t#: The audit-path env carriers THIS caller actually obeys.\n360\t#: `default_audit_dir()` reads CEO_AUDIT_LOG_DIR and nothing else, so\n361\t#: CEO_AUDIT_LOG_PATH does not move budget-summary's ledger and must not\n362\t#: be read as a cross-project pin (rail S341 r1 [P2]; measured: audit_dir\n363\t#: byte-identical with and without that var). ceo-cost.py honours both\n364\t#: carriers and passes none.\n365\t_AUDIT_ENV_CARRIERS = (\"CEO_AUDIT_LOG_DIR\",)\n366\t\n367\t\n368\t# Rebind extracted functions to this facade's globals: calls between functions\n369\t# and dynamically monkeypatched names retain the original module semantics.\n370\tfrom types import FunctionType as _FunctionType\n371\tfrom _lib._budget_summary_parts import (\n372\t    audit_events as _audit_events,\n373\t    cost_rollup as _cost_rollup,\n374\t    benchmark_native as _benchmark_native,\n375\t    native_reconciliation as _native_reconciliation,\n376\t    presentation_cli as _presentation_cli,\n377\t    native_formatting as _native_formatting,\n378\t)\n379\t\n380\tfor _part in (\n381\t    _audit_events, _cost_rollup, _benchmark_native,\n382\t    _native_reconciliation, _presentation_cli, _native_formatting,\n383\t):\n384\t    for _name, _obj in vars(_part).items():\n385\t        if isinstance(_obj, _FunctionType) and _obj.__module__ == _part.__name__:\n386\t            _bound = _FunctionType(\n387\t                _obj.__code__, globals(), _obj.__name__, _obj.__defaults__,\n388\t                _obj.__closure__,\n389\t            )\n390\t            _bound.__kwdefaults__ = _obj.__kwdefaults__\n391\t            _bound.__annotations__ = _obj.__annotations__\n392\t            _bound.__dict__.update(_obj.__dict__)\n393\t            _bound.__qualname__ = _obj.__qualname__\n394\t            _bound.__module__ = __name__\n395\t            globals()[_name] = _bound\n396\t\n397\tdel _part, _name, _obj, _bound\n398\t\n399\t\n400\tdef _load_normalize_model_name():\n401\t    candidate = Path(__file__).resolve().parent / \"optimizer\" / \"model_normalize.py\"\n402\t    try:\n403\t        if candidate.is_file():\n404\t            spec = importlib.util.spec_from_file_location(\n405\t                \"_budget_summary_model_normalize\", str(candidate)\n406\t            )\n407\t            if spec is not None and spec.loader is not None:\n408\t                mod = importlib.util.module_from_spec(spec)\n409\t                spec.loader.exec_module(mod)\n410\t                fn = getattr(mod, \"normalize_model_name\", None)\n411\t                if callable(fn):\n412\t                    return fn\n413\t    except Exception:\n414\t        pass\n415\t    try:\n416\t        from optimizer.model_normalize import normalize_model_name as fn2  # type: ignore\n417\t\n418\t        if callable(fn2):\n419\t            return fn2\n420\t    except Exception:\n421\t        pass\n422\t    return None\n423\t\n424\t\n425\t_NORMALIZE_MODEL_NAME = _load_normalize_model_name()\n426\t_TX_MODULE = load_transcripts_instrument()\n427\tSOURCE_CHOICES = _TX_MODULE.SOURCE_CHOICES if _TX_MODULE is not None else (\"transcripts\", \"audit\", \"both\")\n428\tAUDIT_BANNER = _TX_MODULE.AUDIT_BANNER if _TX_MODULE is not None else \"=== SOURCE: AUDIT LOG (governance ledger -- SECONDARY) ===\"\n429\tROOT_ENV = _TX_MODULE.ROOT_ENV if _TX_MODULE is not None else \"CEO_COST_TRANSCRIPTS_DIR\"\n430\t\n431\tif __name__ == \"__main__\":\n432\t    sys.exit(main())\n433\t"}]},"parent_tool_use_id":null,"session_id":"15f68acd-8563-46de-ac1c-c65891f7fb4e","uuid":"3c23e453-a315-4c86-96f2-dc15e686c6c4","timestamp":"2026-11-16T18:04:35.941Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/budget-summary.py","content":"#!/usr/bin/env python3\n\"\"\"budget-summary.py — multi-rotation FinOps rollup (PLAN-083 Wave 0b sub-0.8).\n\nThis is the **PLAN-083 reissue** of ``.claude/scripts/budget-summary.py``.\nIt supersedes the prior ADR-033 implementation in three dimensions per\nPLAN-083 §5.2 row 0.8:\n\n1. **Multi-rotation read** — globs ``audit-log*.jsonl`` in the audit dir\n   so cumulative spend reflects all 12 backup rotations + the active\n   log. The prior script read only ``audit-log.jsonl`` and therefore\n   reported ``$0.28`` against a memory claim of ``~$1003-1543`` for the\n   S82-S99 window.\n\n2. **Dedup by event sha256** — per PLAN-083 §13 risk register row\n   \"FinOps backup glob double-counts events across rotations\". On a\n   rotation boundary the tail of the previous log may be partially\n   mirrored in the next rotation's head (atomic rename + retry\n   semantics). We canonicalize each event (drop ``hmac``, ``hmac_error``,\n   ``hook_duration_ms``) and compute sha256 over the sorted-keys JSON\n   form; first occurrence wins.\n\n3. **Codex MCP tokens included** — ``pair_rail_case`` action events\n   contribute ``tokens_in`` / ``tokens_out`` to the rollup. Combined\n   with the companion ``codex-adapter-token-wire.patch`` that\n   actually populates those fields, this closes the\n   \"tokens not tracked for Codex\" half of the observability gap.\n\n4. **plan_id auto-attribution** — events that carry an explicit\n   ``plan_id`` field win. Otherwise we infer ``plan_id`` from the\n   nearest preceding ``plan_status_transition`` event in the same\n   ``session_id`` whose status is ``executing`` (per ADR-058). Only\n   when both signals are absent do we fall back to ``(unknown)``.\n\n5. **Native-source cross-check (PLAN-178 W1.2, default-OFF)** — the\n   ``--native`` flag (or ``CEO_BUDGET_NATIVE=1``) appends a cross-check\n   of the audit-log spawn ledger against the harness-native transcript\n   corpus under ``~/.claude/projects/<cwd-slug>/<SESSION-UUID>/subagents/``\n   (probe: ``.claude/plans/PLAN-178/w12-native-cost-probe.md``).\n   Doctrine: **cross-check, not authority-swap** — the native source\n   NEVER silently replaces the audit-log rollup; UNMATCHED residue on\n   BOTH sides is always reported (silencing it would fake a low\n   divergence). Model aliases (``opus`` / ``sonnet`` / ``fable`` /\n   ``claude-fable-5[1m]`` …) are resolved through the repo's EXISTING\n   normalizer (``optimizer/model_normalize.py``) + the pricing registry\n   below — an unresolvable/unpriced model is reported as cost ``TBD``,\n   never as ``$0``. When the native source is dormant (no transcripts on\n   disk) and the flag is OFF, output is byte-for-byte unchanged.\n\n## Usage\n\n::\n\n    python3 budget-summary.py summary\n    python3 budget-summary.py summary --since 30d\n    python3 budget-summary.py summary --plan-id PLAN-081\n    python3 budget-summary.py summary --by-wave\n    python3 budget-summary.py summary --json\n    python3 budget-summary.py summary --validate-memory-claim\n    python3 budget-summary.py summary --native\n\nStdlib only. Python 3.9+.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport glob\nimport hashlib\nimport importlib.util\nimport json\nimport os\nimport re\nimport sys\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Set, Tuple\nimport sys as _sys_rp\nfrom pathlib import Path as _Path_rp\n_HOOKS_RP = _Path_rp(__file__).resolve()\nfor _anc in _HOOKS_RP.parents:\n    if (_anc / \".claude\" / \"hooks\" / \"_lib\").is_dir():\n        if str(_anc / \".claude\" / \"hooks\") not in _sys_rp.path:\n            _sys_rp.path.insert(0, str(_anc / \".claude\" / \"hooks\"))\n        break\nfrom _lib import runtime_paths as _rp  # noqa: E402  # PLAN-182 W1 single resolver\n\n\n# ---------------------------------------------------------------------------\n# Constants\n# ---------------------------------------------------------------------------\n\n#: ``--since`` time-expression parser.\n_SINCE_RE = re.compile(r\"^(\\d+)\\s*([mhd])$\")\n\n#: PLAN-id syntactic check (Sec MF-3 — bound any plan_id we display).\n_PLAN_ID_RE = re.compile(r\"^PLAN-[0-9]{3}$\")\n\n#: Wave-id parser (e.g. ``\"wave-0a\"``, ``\"wave-1\"``, ``\"wave-minus-1\"``).\n_WAVE_ID_RE = re.compile(r\"^wave-[a-z0-9-]{1,16}$\")\n\n#: Memory-claim band per CLAUDE.md §6 (S82-S99 cumulative).\nMEMORY_CLAIM_LOW_USD: float = 1003.0\nMEMORY_CLAIM_HIGH_USD: float = 1543.0\nMEMORY_CLAIM_PASS_RATIO_LOW: float = 0.5\nMEMORY_CLAIM_PASS_RATIO_HIGH: float = 1.5\n\n#: Audit-log filename glob.\nAUDIT_LOG_GLOB: str = \"audit-log*.jsonl\"\n\n#: Fields stripped before computing event sha256 (rotation overlap dedup).\n#: ``hmac`` and ``hmac_error`` differ between rotations because they're\n#: chained off prior_hmac; ``hook_duration_ms`` is observation-time noise.\n_DEDUP_STRIP_FIELDS: Tuple[str, ...] = (\"hmac\", \"hmac_error\", \"hook_duration_ms\")\n\n#: Default per-1k-token pricing (USD). Falls back to these if the\n#: pricing doc is unavailable. Numbers are conservative midpoints from\n#: Anthropic + OpenAI public pricing as of 2026-05; intent here is\n#: *order-of-magnitude correctness*, not pricing engine.\n#: PLAN-120 WS-C: refreshed to current Anthropic slugs + rates (per-1k tokens,\n#: USD). claude-opus-4-8 = current flagship $5/$25 per MTok (0.005/0.025 per-1k);\n#: claude-opus-4-7 RETAINED HISTORICAL ($15/$75) for log replay of pre-4.8\n#: sessions; Sonnet 4.6 = $3/$15; Haiku 4.5 = $1/$5 (was 4x underpriced).\n#: PLAN-163 T1.5b — ADDITIVE Claude 5 fleet rows (historical rows retained,\n#: ADR-142): fable-5 $10/$50; opus-5 $5/$25 (drop-in at the 4.8 rate);\n#: opus-5-fast $10/$50 premium row; sonnet-5 $2/$10 — the launch intro price\n#: became the STANDARD price (official pricing page fetched 2026-09-01: the\n#: scheduled 2026-09-01 increase to $3/$15 \"will not occur\"; PLAN-169 S338\n#: follow-up).\n#: ADR-149 Amendment 3 (S357): claude-opus-5-5 $4/$20 (pricing page fetched\n#: 2026-09-22); its 0.05x cache-read rate lives in\n#: _CACHE_READ_MULTIPLIER_OVERRIDES below.\n_DEFAULT_PRICING: Dict[str, Dict[str, float]] = {\n    \"claude-opus-4-8\":             {\"in\": 0.005, \"out\": 0.025},\n    \"claude-opus-4-8-fast\":       {\"in\": 0.010, \"out\": 0.050},\n    \"claude-fable-5\":             {\"in\": 0.010, \"out\": 0.050},\n    \"claude-fable-5-1\":           {\"in\": 0.010, \"out\": 0.050},  # ADR-149 Amendment 2 (S338)\n    \"claude-opus-5\":              {\"in\": 0.005, \"out\": 0.025},\n    \"claude-opus-5-fast\":         {\"in\": 0.010, \"out\": 0.050},\n    \"claude-opus-5-5\":            {\"in\": 0.004, \"out\": 0.020},  # ADR-149 Amendment 3 (S357)\n    \"claude-sonnet-5\":            {\"in\": 0.002, \"out\": 0.010},\n    \"claude-opus-4-7\":            {\"in\": 0.015, \"out\": 0.075},\n    \"claude-opus-4\":              {\"in\": 0.015, \"out\": 0.075},\n    \"claude-sonnet-4-6\":          {\"in\": 0.003, \"out\": 0.015},\n    \"claude-sonnet-4-5\":          {\"in\": 0.003, \"out\": 0.015},\n    \"claude-sonnet-4\":            {\"in\": 0.003, \"out\": 0.015},\n    \"claude-haiku-4-5-[REDACTED:rg]\":  {\"in\": 0.001, \"out\": 0.005},\n    \"claude-haiku-4-5\":           {\"in\": 0.001, \"out\": 0.005},\n    \"claude-haiku-4\":             {\"in\": 0.001, \"out\": 0.005},\n    \"gpt-5\":             {\"in\": 0.005,  \"out\": 0.020},\n    \"gpt-5-codex\":       {\"in\": 0.005,  \"out\": 0.020},\n    \"gpt-5-mini\":        {\"in\": 0.0005, \"out\": 0.002},\n    \"o3\":                {\"in\": 0.015,  \"out\": 0.060},\n    \"o4-mini\":           {\"in\": 0.001,  \"out\": 0.004},\n}\n\n\n#: Fractional-seconds tolerant variant (PLAN-178 W1.2). Native transcript\n#: lines stamp ``2026-08-11T14:48:12.648Z``; the audit-log stamps whole\n#: seconds. Ordering uses the raw ISO string (lexicographic == chronological\n#: for same-zone ISO-8601); PARSING for the ``--since`` cutoff strips the\n#: fraction first, then reuses ``_parse_ts``.\n_TS_FRACTION_RE = re.compile(r\"\\.\\d+(?=Z|[+-]\\d{2}:?\\d{2}$)\")\n\n\n# ---------------------------------------------------------------------------\n# Pricing\n# ---------------------------------------------------------------------------\n\n\n#: PLAN-163 W2 P2a — event-date-aware rows (per-1k twin of the tables in\n#: audit-telemetry.py / ceo-cost.py): an event is priced by its OWN ``ts``,\n#: never by \"today\" and never by mutating the global row. Shape: model ->\n#: (cutoff_iso_date, row_through_cutoff_inclusive, row_after).\n#: EMPTY since the PLAN-169 S338 follow-up: the Sonnet 5 row ($2/$10 per\n#: MTok intro through 2026-08-31, then $3/$15) was retired when the official\n#: pricing page (fetched 2026-09-01) made $2/$10 the standard price and\n#: cancelled the 2026-09-01 increase — both legs equal the base row. The\n#: MECHANISM (the ``ts`` branch of ``compute_cost_usd``) stays;\n#: test_model_fleet_presence.py exercises it through a synthetic row.\n_DATED_PRICING: Dict[str, Tuple[str, Dict[str, float], Dict[str, float]]] = {}\n\n\n# ---------------------------------------------------------------------------\n# PLAN-178 W1.2-3 — model-id normalization (alias → canonical pricing key)\n#\n# The native corpus carries a MIXED model vocabulary (probe §1.3: bare\n# aliases ``opus``/``sonnet``/``fable``/``haiku``, full ids, a ``[1m]``\n# packaging suffix, and 262/416 metas with NO model at all). Resolution\n# REUSES the repo's existing registry surfaces — ``optimizer/\n# model_normalize.py`` (``normalize_model_name`` + its ``_RAW_ALIASES``\n# closed alias map) and the ``_DEFAULT_PRICING`` table above — and\n# deliberately does NOT introduce a second local alias table. A bare\n# family alias is resolved ONLY when the existing registry contains\n# exactly one canonical id for that family (today: ``fable`` →\n# ``claude-fable-5``); an ambiguous family (``opus`` spans 4-7/4-8/5/…)\n# stays UNRESOLVED — we never guess a version (the load-bearing\n# invariant of ``model_normalize.py``: never collapse two versions).\n# Unresolved / unpriced models are reported as cost ``TBD``, never $0.\n# ---------------------------------------------------------------------------\n\n\n#: The ``[1m]`` context-window packaging suffix the harness appends to a\n#: live model id (probe §1.3: ``claude-fable-5[1m]``). A packaging tag,\n#: not a version — stripped generically before alias lookup.\n_ONE_M_SUFFIX_RE = re.compile(r\"\\[1m\\]$\")\n\n#: A bare family alias (``opus`` / ``sonnet`` / ``fable`` / ``haiku`` …):\n#: a single lowercase token with no version component.\n_BARE_FAMILY_RE = re.compile(r\"^[a-z][a-z0-9]*$\")\n\n#: Family extractor over canonical Claude pricing keys\n#: (``claude-<family>-…`` → ``<family>``).\n_CLAUDE_FAMILY_RE = re.compile(r\"^claude-([a-z]+)-\")\n\n\n#: Resolved once at import; None ⇒ degraded (but never crashing) mode.\n_NORMALIZE_MODEL_NAME = None  # initialized after binding\n\n\n# ---------------------------------------------------------------------------\n# Rollup\n# ---------------------------------------------------------------------------\n\n\n#: Audit actions that contribute tokens to the rollup.\n_TOKEN_BEARING_ACTIONS: Tuple[str, ...] = (\n    \"agent_spawn\",        # Claude sub-agent dispatches\n    \"pair_rail_case\",     # Codex MCP cross-LLM gate (post-wire)\n    \"pair_rail_promotion\",  # Phase 4 promotion gate runs\n)\n\n\n# ---------------------------------------------------------------------------\n# PLAN-133 C4 — benchmark co-report (harbor-style row)\n#\n# Default-OFF behavioral surface, gated by the ``--benchmarks`` flag (and the\n# ``CEO_BUDGET_BENCHMARKS=1`` env opt-in). When OFF, the rollup output is\n# byte-for-byte unchanged. When ON, a ``benchmarks`` block is appended that\n# co-reports **cost + compute + turns alongside pass-rate** per skill so a\n# benchmark is never read as a bare scalar — the same harbor-style row the\n# ``audit-query benchmarks`` reader emits (PLAN-133 C4). $0, read-only,\n# derives only from fields already on the ``benchmark_run`` event.\n# ---------------------------------------------------------------------------\n\n\n# ---------------------------------------------------------------------------\n# PLAN-178 W1.2-2 — native-source cross-check (audit-log × harness corpus)\n#\n# Default-OFF behavioral surface, gated by the ``--native`` flag (and the\n# ``CEO_BUDGET_NATIVE=1`` env opt-in) — same pattern as the C4 benchmark\n# block: when OFF, output is byte-for-byte unchanged. When ON, a\n# ``native_cross_check`` block joins the audit-log ``agent_spawn`` ledger\n# against the harness-native transcript corpus:\n#\n#     ~/.claude/projects/<cwd-slug>/<SESSION-UUID>/subagents/agent-a*.jsonl\n#     ~/.claude/projects/<cwd-slug>/<SESSION-UUID>/subagents/workflows/\n#         wf_*/agent-a*.jsonl        (journal.jsonl EXCLUDED — no meta)\n#\n# Join key (probe §handoff): ``(session_id, agentType~subagent_type,\n# ordinal-by-timestamp)`` — the audit-log has no agentId and the native\n# meta has no desc_hash, so within each (session, type) group both sides\n# are sorted by timestamp and zipped pairwise. UNMATCHED residue on BOTH\n# sides is ALWAYS reported (own section + count): silencing it would\n# produce a falsely-low divergence. Rail category comes from the PATH\n# shape (``workflows/wf_*/`` ⇒ workflow), never from ``taskKind`` — the\n# field cannot distinguish the rails (probe §3 blocker #1).\n#\n# Doctrine: **cross-check, not authority-swap** — the audit-log rollup\n# above remains the sole authority; this block is additive evidence and\n# degrades (dormant) to nothing when the corpus is absent. Cache-token\n# columns are reported token-only (no invented cache pricing); cost is\n# computed over input+output, and a spawn whose model cannot be resolved\n# to a priced id is reported as cost TBD — never $0.\n# ---------------------------------------------------------------------------\n\n\n#: Usage keys summed per transcript (probe §handoff item 4). Cache columns\n#: are reported token-only — no cache pricing row exists in the registry\n#: and we never invent one.\n_NATIVE_USAGE_KEYS: Tuple[str, ...] = (\n    \"input_tokens\",\n    \"output_tokens\",\n    \"cache_creation_input_tokens\",\n    \"cache_read_input_tokens\",\n)\n\n\n#: ADR-149 Amendment 2 (S338, codex rail r1 P2): the cache-read multiplier\n#: is PER MODEL. The pricing page (fetched 2026-09-01) prices cache hits on\n#: Claude Fable 5.1 / Mythos 5.1 at 0.025x the base input price\n#: ($0.25/MTok). A flat 0.10x would OVERSTATE Fable 5.1 cache reads 4x.\n#: ADR-149 Amendment 3 (S357): Claude Opus 5.5 cache hits are 0.05x its $4\n#: base ($0.20/MTok, pricing page fetched 2026-09-22) — a flat 0.10x would\n#: overstate them 2x. Every other model of the ADR-149 working set keeps\n#: the standard 0.10x; Mythos 5.1 (0.025x on the same page) is outside\n#: the working set and carries no entry. Keys are canonical ids.\n#: ceo-cost-transcripts.py mirrors this table exactly;\n#: test_model_fleet_presence.py binds the two.\n_CACHE_READ_MULTIPLIER_DEFAULT: float = 0.10\n_CACHE_READ_MULTIPLIER_OVERRIDES: Dict[str, float] = {\n    \"claude-fable-5-1\": 0.025,\n    \"claude-opus-5-5\": 0.05,\n}\n\n\n# ---------------------------------------------------------------------------\n# PLAN-186 W0 (AC-1b) — transcripts as the PRIMARY cost source\n# ---------------------------------------------------------------------------\n#\n# The audit log is a GOVERNANCE ledger (agent_spawn rows; tokens_in/out on\n# them are best-effort and frequently absent). The real token ledger is the\n# harness-native transcript corpus — `message.usage` per assistant turn —\n# which `.claude/scripts/ceo-cost-transcripts.py` reads with the full\n# input / output / cache-read / cache-write-5m / cache-write-1h split and\n# per-model prices. This module consumes that instrument through its\n# programmatic API and prints BOTH sources, labelled, side by side.\n# `--source audit` restores the pre-PLAN-186 rendering byte-for-byte.\n#\n# SCOPE NOTE (deliberate, not an oversight): this repo carries THREE\n# independent pricing tables — `ceo-cost.py::_DEFAULT_PRICING`, the model\n# registry behind `budget-summary.py::compute_cost_usd`, and the\n# instrument's `_EMBEDDED_PRICING` / `cost-table.yaml` loader. Unifying them\n# is a separate wave. This integration only REUSES what the instrument\n# already exposes: the transcripts block is priced by the instrument, the\n# audit block by whatever priced it before, and each block says so.\n#\n# The loader below is the one thing that cannot live in the instrument: its\n# filename is hyphenated, so every caller needs its own importlib bootstrap.\n# Everything else (root resolution, collection, rendering) is delegated, so\n# the two callers cannot drift apart.\n\n_TRANSCRIPTS_MODULE_NAME = \"ceo_cost_transcripts\"\n_TRANSCRIPTS_FILENAME = \"ceo-cost-transcripts.py\"\n\n\n#: Resolved ONCE, from the instrument, so the two callers cannot publish a\n#: different `--source` domain or a different banner than the block they\n#: render. The literals are a fail-soft fallback for a missing instrument\n#: (argparse needs a concrete tuple at parser-build time) and are asserted\n#: equal to the instrument's in test_ceo_cost_integration.py.\n_TX_MODULE = None  # initialized after binding\nSOURCE_CHOICES = (\n    _TX_MODULE.SOURCE_CHOICES\n    if _TX_MODULE is not None\n    else (\"transcripts\", \"audit\", \"both\")\n)\nAUDIT_BANNER = (\n    _TX_MODULE.AUDIT_BANNER\n    if _TX_MODULE is not None\n    else \"=== SOURCE: AUDIT LOG (governance ledger -- SECONDARY) ===\"\n)\nROOT_ENV = (\n    _TX_MODULE.ROOT_ENV\n    if _TX_MODULE is not None\n    else \"CEO_COST_TRANSCRIPTS_DIR\"\n)\n\n\n#: The audit-path env carriers THIS caller actually obeys.\n#: `default_audit_dir()` reads CEO_AUDIT_LOG_DIR and nothing else, so\n#: CEO_AUDIT_LOG_PATH does not move budget-summary's ledger and must not\n#: be read as a cross-project pin (rail S341 r1 [P2]; measured: audit_dir\n#: byte-identical with and without that var). ceo-cost.py honours both\n#: carriers and passes none.\n_AUDIT_ENV_CARRIERS = (\"CEO_AUDIT_LOG_DIR\",)\n\n\n# Rebind extracted functions to this facade's globals: calls between functions\n# and dynamically monkeypatched names retain the original module semantics.\nfrom types import FunctionType as _FunctionType\nfrom _lib._budget_summary_parts import (\n    audit_events as _audit_events,\n    cost_rollup as _cost_rollup,\n    benchmark_native as _benchmark_native,\n    native_reconciliation as _native_reconciliation,\n    presentation_cli as _presentation_cli,\n    native_formatting as _native_formatting,\n)\n\nfor _part in (\n    _audit_events, _cost_rollup, _benchmark_native,\n    _native_reconciliation, _presentation_cli, _native_formatting,\n):\n    for _name, _obj in vars(_part).items():\n        if isinstance(_obj, _FunctionType) and _obj.__module__ == _part.__name__:\n            _bound = _FunctionType(\n                _obj.__code__, globals(), _obj.__name__, _obj.__defaults__,\n                _obj.__closure__,\n            )\n            _bound.__kwdefaults__ = _obj.__kwdefaults__\n            _bound.__annotations__ = _obj.__annotations__\n            _bound.__dict__.update(_obj.__dict__)\n            _bound.__qualname__ = _obj.__qualname__\n            _bound.__module__ = __name__\n            globals()[_name] = _bound\n\ndel _part, _name, _obj, _bound\n\n\ndef _load_normalize_model_name():\n    candidate = Path(__file__).resolve().parent / \"optimizer\" / \"model_normalize.py\"\n    try:\n        if candidate.is_file():\n            spec = importlib.util.spec_from_file_location(\n                \"_budget_summary_model_normalize\", str(candidate)\n            )\n            if spec is not None and spec.loader is not None:\n                mod = importlib.util.module_from_spec(spec)\n                spec.loader.exec_module(mod)\n                fn = getattr(mod, \"normalize_model_name\", None)\n                if callable(fn):\n                    return fn\n    except Exception:\n        pass\n    try:\n        from optimizer.model_normalize import normalize_model_name as fn2  # type: ignore\n\n        if callable(fn2):\n            return fn2\n    except Exception:\n        pass\n    return None\n\n\n_NORMALIZE_MODEL_NAME = _load_normalize_model_name()\n_TX_MODULE = load_transcripts_instrument()\nSOURCE_CHOICES = _TX_MODULE.SOURCE_CHOICES if _TX_MODULE is not None else (\"transcripts\", \"audit\", \"both\")\nAUDIT_BANNER = _TX_MODULE.AUDIT_BANNER if _TX_MODULE is not None else \"=== SOURCE: AUDIT LOG (governance ledger -- SECONDARY) ===\"\nROOT_ENV = _TX_MODULE.ROOT_ENV if _TX_MODULE is not None else \"CEO_COST_TRANSCRIPTS_DIR\"\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":433,"startLine":1,"totalLines":433}},"tool_result_meta":[{"id":"toolu_01WPgMSvG6ctXHCRXxym1rZT","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
