{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RizQc3QNNCvdYv7Pfa234M","type":"tool_result","content":"1\t\"\"\"Bind canonical-edit components to the legacy hook's public namespace.\n2\t\n3\tThe hook exposes mutable globals, counters and injectable functions. A normal\n4\tre-export would give implementations a different globals dictionary, breaking\n5\tboth callers that patch those seams and independent imports of the hook. Bind\n6\tthe compiled functions once at import time instead of copying mutable state or\n7\tsynchronizing it around calls. Source locations and signatures remain intact.\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\tfrom types import FunctionType\n12\t\n13\tfrom . import paths, sentinels, signature_rail, session_roots, utility, decisions, entry\n14\t\n15\t\n16\tdef bind(namespace: dict) -> None:\n17\t    \"\"\"Install implementations with the owning hook's globals and identity.\"\"\"\n18\t    for component in (paths, sentinels, signature_rail, session_roots, utility, decisions, entry):\n19\t        for name in component.__all__:\n20\t            original = getattr(component, name)\n21\t            bound = FunctionType(\n22\t                original.__code__, namespace, original.__name__,\n23\t                original.__defaults__, original.__closure__,\n24\t            )\n25\t            bound.__kwdefaults__ = original.__kwdefaults__\n26\t            bound.__annotations__ = original.__annotations__.copy()\n27\t            bound.__dict__.update(original.__dict__)\n28\t            bound.__doc__ = original.__doc__\n29\t            bound.__qualname__ = original.__qualname__\n30\t            bound.__module__ = namespace[\"__name__\"]\n31\t            namespace[name] = bound\n32\t"}]},"parent_tool_use_id":null,"session_id":"15f68acd-8563-46de-ac1c-c65891f7fb4e","uuid":"2e7b415c-cc93-42ea-99fb-d4b707c572b0","timestamp":"2026-11-16T18:05:20.554Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/canonical_edit/__init__.py","content":"\"\"\"Bind canonical-edit components to the legacy hook's public namespace.\n\nThe hook exposes mutable globals, counters and injectable functions. A normal\nre-export would give implementations a different globals dictionary, breaking\nboth callers that patch those seams and independent imports of the hook. Bind\nthe compiled functions once at import time instead of copying mutable state or\nsynchronizing it around calls. Source locations and signatures remain intact.\n\"\"\"\nfrom __future__ import annotations\n\nfrom types import FunctionType\n\nfrom . import paths, sentinels, signature_rail, session_roots, utility, decisions, entry\n\n\ndef bind(namespace: dict) -> None:\n    \"\"\"Install implementations with the owning hook's globals and identity.\"\"\"\n    for component in (paths, sentinels, signature_rail, session_roots, utility, decisions, entry):\n        for name in component.__all__:\n            original = getattr(component, name)\n            bound = FunctionType(\n                original.__code__, namespace, original.__name__,\n                original.__defaults__, original.__closure__,\n            )\n            bound.__kwdefaults__ = original.__kwdefaults__\n            bound.__annotations__ = original.__annotations__.copy()\n            bound.__dict__.update(original.__dict__)\n            bound.__doc__ = original.__doc__\n            bound.__qualname__ = original.__qualname__\n            bound.__module__ = namespace[\"__name__\"]\n            namespace[name] = bound\n","numLines":32,"startLine":1,"totalLines":32}},"tool_result_meta":[{"id":"toolu_01RizQc3QNNCvdYv7Pfa234M","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
