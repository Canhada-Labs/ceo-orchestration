{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ViLRvT1arXpsa7hbfP5cof","type":"tool_result","content":"939\t-        for provider, match, _off in _credentials.detect_keys(command):\n940\t-            if _credentials.is_likely_real_key(match, command):\n941\t-                return provider, _credentials.redacted_display(provider, match)\n942\t-        return None\n943\t-    except Exception as e:\n944\t-        print(f\"[check_bash_safety] credential-scan failure; failing closed: \"\n945\t-              f\"{e.__class__.__name__}\", file=sys.stderr)\n946\t-        return \"unknown\", \"unknown:****\"\n947\t-\n948\t-\n949\t-# >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (gate implementation)\n950\t-# -----------------------------------------------------------------------------\n951\t-# PLAN-153 Wave E item 5 / ADR-175 half 1 — destructive-Bash CITATION GATE\n952\t-# -----------------------------------------------------------------------------\n953\t-#\n954\t-# When a command classifies as DESTRUCTIVE (rm -rf / git reset --hard /\n955\t-# git push --force — Decision.destructive == True), the operator may supply\n956\t-# a CITATION: the instruction that justifies the destructive op, quoted\n957\t-# VERBATIM, via a leading shell env-assignment on the command itself:\n958\t-#\n959\t-#     CEO_DESTRUCTIVE_CITE='transcript:<verbatim instruction text>' rm -rf build/\n960\t-#     CEO_DESTRUCTIVE_CITE='PLAN-153:<verbatim plan text>'          rm -rf build/\n961\t-#\n962\t-# Channel rationale: the assignment travels INSIDE `tool_input.command` — the\n963\t-# one field this PreToolUse hook actually receives and can verify against the\n964\t-# stdin payload (a separate env var would be invisible to the payload; a\n965\t-# transcript-adjacent side file would be writable by the same actor issuing\n966\t-# the command). `_normalize_command_tokens` strips leading assignments, so\n967\t-# the citation prefix can never DE-classify the command (see the env-\n968\t-# assignment normalization block above).\n969\t-#\n970\t-# VERIFICATION (bounded read):\n971\t-#   * source `transcript` → the `transcript_path` field of the hook's OWN\n972\t-#     stdin payload (Claude Code supplies it on every hook event). Hardening:\n973\t-#     the resolved path must live under ~/.claude/ and end in `.jsonl` —\n974\t-#     a payload pointing anywhere else fails verification (fail-CLOSED).\n975\t-#     The cited text must appear verbatim (raw or JSON-escaped, since\n976\t-#     transcripts are JSONL) within the LAST `_CITE_READ_CAP_BYTES` of the\n977\t-#     file (recent instructions live at the tail; text beyond the bound\n978\t-#     simply fails verification — the fail-closed direction).\n979\t-#   * source `PLAN-NNN` → `$CLAUDE_PROJECT_DIR/.claude/plans/PLAN-NNN-*.md`\n980\t-#     (PLAN-SCHEMA naming), same bounded read.\n981\t-#\n982\t-# FAIL-CLOSED (mirrors the `_e3` whole-command parse gate + the\n983\t-# `_check_credential_leak` precedent, PLAN-152 debate C4): citation absent /\n984\t-# malformed / too short / transcript unreadable / cited text not found ⇒ the\n985\t-# destructive op stays BLOCKED with an actionable reason. Fail-OPEN is\n986\t-# permitted ONLY on the audit-emit side (an emit failure never flips the\n987\t-# decision).\n988\t-#\n989\t-# ACCEPTED citations are recorded into the HMAC audit chain via\n990\t-# `_lib.audit_emit.emit_generic(\"veto_triggered\", ...)` (a passthrough-\n991\t-# registered action; a NEW action name would require touching\n992\t-# `_lib/audit_emit.py`'s _KNOWN_ACTIONS, outside this unit's scope — the\n993\t-# `reason_code=destructive_citation_accepted` + `gate_outcome` fields\n994\t-# disambiguate, following the git_hook_bypass_blocked/escape_hatch_used\n995\t-# precedent of recording the AUTHORIZED path under the guard's action). The\n996\t-# cited text passes `_lib.redact.redact_secrets` and lands in the\n997\t-# `cited_instruction_data` field — the `_data` suffix marks it as inert DATA\n998\t-# (quoted evidence), never instructions.\n999\t-#\n1000\t-# SCOPE GUARD: the gate keys off `Decision.destructive` ONLY. Canonical-path\n1001\t-# writes, credential leaks, git hook-bypass and env-hijack blocks are NOT\n1002\t-# citation-gatable — no citation unlocks those.\n1003\t-#\n1004\t-# Pilot flag: CEO_DESTRUCTIVE_CITATION_GATE == \"1\" ENABLES the gate\n1005\t-# (default-OFF, mirroring the H5 force-push-rewrite pilot: a change that adds\n1006\t-# an allow path to a hard block ships opt-in until its ceremony + Codex round\n1007\t-# close). Read from the import-time trusted_env snapshot, NOT live os.environ.\n1008\t-\n1009\t-_DESTRUCTIVE_CITE_GATE_VAR = \"CEO_DESTRUCTIVE_CITATION_GATE\"\n1010\t-_DESTRUCTIVE_CITE_VAR = \"CEO_DESTRUCTIVE_CITE\"\n1011\t-_CITE_MIN_CHARS = 16                    # a real instruction, not a token\n1012\t-_CITE_READ_CAP_BYTES = 4 * 1024 * 1024  # bounded tail read (4 MiB)\n1013\t-_CITE_AUDIT_PREVIEW_CHARS = 400         # cap on cited text entering the chain\n1014\t-_CITE_PLAN_SOURCE_RE = re.compile(r\"^PLAN-\\d{3}$\")\n1015\t-_CITE_MAX_PLAN_FILES = 5                # bound the glob fan-out\n1016\t-\n1017\t-\n1018\t-def _destructive_citation_gate_enabled() -> bool:\n1019\t-    \"\"\"True iff CEO_DESTRUCTIVE_CITATION_GATE == \"1\" in the trusted_env\n1020\t-    snapshot (default-OFF pilot). Snapshot unavailability ⇒ DISABLED (the\n1021\t-    most conservative state: the legacy hard BLOCK). Pure; never raises.\"\"\"\n1022\t-    if _trusted_env is None:  # pragma: no cover — import failure → default-OFF\n1023\t-        return False\n1024\t-    try:\n1025\t-        raw = _trusted_env.get_trusted(_DESTRUCTIVE_CITE_GATE_VAR)\n1026\t-    except Exception:  # pragma: no cover\n1027\t-        return False\n1028\t-    return (str(raw).strip() == \"1\") if raw is not None else False\n1029\t-\n1030\t-\n1031\t-def _extract_destructive_citation(command: str) -> \"tuple\":\n1032\t-    \"\"\"Extract the CEO_DESTRUCTIVE_CITE citation from the command's leading\n1033\t-    env-assignment prefix.\n1034\t-\n1035\t-    Returns a 3-tuple ``(status, source, cited_text)``:\n1036\t-      * ``(\"absent\", \"\", \"\")``     — no citation assignment in the prefix\n1037\t-        (also the outcome when the whole command fails shlex — an\n1038\t-        unparseable command cannot carry a verifiable citation, and the\n1039\t-        caller's fail-closed handling keeps the op blocked).\n1040\t-      * ``(\"malformed\", detail, \"\")`` — assignment present but not of shape\n1041\t-        ``<source>:<verbatim text>`` with source ``transcript`` | ``PLAN-NNN``\n1042\t-        and text >= _CITE_MIN_CHARS.\n1043\t-      * ``(\"ok\", source, cited_text)`` — well-formed citation.\n1044\t-\n1045\t-    Only the LEADING assignment run is scanned (shell semantics: assignments\n1046\t-    after the first command word are arguments, not environment). Pure;\n1047\t-    never raises.\n1048\t-    \"\"\"\n1049\t-    if not command or not command.strip():\n1050\t-        return (\"absent\", \"\", \"\")\n1051\t-    try:\n1052\t-        tokens = shlex.split(command)\n1053\t-    except ValueError:\n1054\t-        return (\"absent\", \"\", \"\")\n1055\t-    value = None  # type: Optional[str]\n1056\t-    for tok in tokens:\n1057\t-        if not _ENV_ASSIGNMENT_RE.match(tok):\n1058\t-            break  # first non-assignment token ends the env prefix run\n1059\t-        name, _, rest = tok.partition(\"=\")\n1060\t-        if name == _DESTRUCTIVE_CITE_VAR:\n1061\t-            value = rest\n1062\t-            break\n1063\t-    if value is None:\n1064\t-        return (\"absent\", \"\", \"\")\n1065\t-    source, sep, cited = value.partition(\":\")\n1066\t-    if not sep:\n1067\t-        return (\n1068\t-            \"malformed\",\n1069\t-            \"missing ':' separator (expected '<source>:<verbatim text>')\",\n1070\t-            \"\",\n1071\t-        )\n1072\t-    source = source.strip()\n1073\t-    if source != \"transcript\" and not _CITE_PLAN_SOURCE_RE.match(source):\n1074\t-        return (\n1075\t-            \"malformed\",\n1076\t-            \"unknown source %r (expected 'transcript' or 'PLAN-NNN')\" % source,\n1077\t-            \"\",\n1078\t-        )\n1079\t-    if len(cited) < _CITE_MIN_CHARS:\n1080\t-        return (\n1081\t-            \"malformed\",\n1082\t-            \"cited text under %d chars — quote the justifying instruction \"\n1083\t-            \"verbatim, not a fragment\" % _CITE_MIN_CHARS,\n1084\t-            \"\",\n1085\t-        )\n1086\t-    return (\"ok\", source, cited)\n1087\t-\n1088\t-\n1089\t-def _cite_bounded_tail_read(path: \"Path\") -> str:\n1090\t-    \"\"\"Read at most the LAST _CITE_READ_CAP_BYTES of ``path`` as utf-8\n1091\t-    (errors=replace). Raises OSError family on unreadable paths — the\n1092\t-    CALLER converts that to a fail-CLOSED block.\"\"\"\n1093\t-    import os as _os\n1094\t-    size = _os.path.getsize(str(path))\n1095\t-    with open(str(path), \"rb\") as fh:\n1096\t-        if size > _CITE_READ_CAP_BYTES:\n1097\t-            fh.seek(size - _CITE_READ_CAP_BYTES)\n1098\t-        data = fh.read(_CITE_READ_CAP_BYTES)\n1099\t-    return data.decode(\"utf-8\", \"replace\")\n1100\t-\n1101\t-\n1102\t-def _cite_needles(cited_text: str) -> \"List[str]\":\n1103\t-    \"\"\"The raw cited text + its JSON-escaped form (transcripts are JSONL, so\n1104\t-    an instruction containing quotes/newlines is stored escaped).\"\"\"\n1105\t-    needles = [cited_text]\n1106\t-    try:\n1107\t-        escaped = json.dumps(cited_text, ensure_ascii=False)[1:-1]\n1108\t-        if escaped != cited_text:\n1109\t-            needles.append(escaped)\n1110\t-    except Exception:  # pragma: no cover — dumps on str cannot realistically fail\n1111\t-        pass\n1112\t-    return needles\n1113\t-\n1114\t-\n1115\t-def _verify_destructive_citation(\n1116\t-    source: str,\n1117\t-    cited_text: str,\n1118\t-    transcript_path: str,\n1119\t-) -> \"tuple\":\n1120\t-    \"\"\"Verify ``cited_text`` appears verbatim in the source it points at.\n1121\t-\n1122\t-    Returns ``(ok, detail, source_class)`` where ``source_class`` is the\n1123\t-    closed enum ``\"transcript\"`` | ``\"plan\"`` (for the audit record) and\n1124\t-    ``detail`` is an actionable failure description on ``ok == False``.\n1125\t-\n1126\t-    FAIL-CLOSED BY CONSTRUCTION: every unexpected exception is caught and\n1127\t-    converted to ``(False, ...)`` — content the gate cannot verify is\n1128\t-    blocked, never waved through (the `_e3` / C4 precedent).\n1129\t-    \"\"\"\n1130\t-    import os as _os\n1131\t-    try:\n1132\t-        if source == \"transcript\":\n1133\t-            if not transcript_path:\n1134\t-                return (\n1135\t-                    False,\n1136\t-                    \"hook payload carried no transcript_path (cannot verify \"\n1137\t-                    \"a 'transcript:' citation in this session)\",\n1138\t-                    \"transcript\",\n1139\t-                )\n1140\t-            real = _os.path.realpath(transcript_path)\n1141\t-            claude_root = _os.path.realpath(\n1142\t-                _os.path.join(_os.path.expanduser(\"~\"), \".claude\")\n1143\t-            )\n1144\t-            if not real.startswith(claude_root + _os.sep):\n1145\t-                return (\n1146\t-                    False,\n1147\t-                    \"transcript_path resolves outside ~/.claude/ \"\n1148\t-                    \"(refusing to verify against an arbitrary file)\",\n1149\t-                    \"transcript\",\n1150\t-                )\n1151\t-            if not real.endswith(\".jsonl\"):\n1152\t-                return (\n1153\t-                    False,\n1154\t-                    \"transcript_path is not a .jsonl session transcript\",\n1155\t-                    \"transcript\",\n1156\t-                )\n1157\t-            if not _os.path.isfile(real):\n1158\t-                return (\n1159\t-                    False,\n1160\t-                    \"transcript file does not exist or is not a regular file\",\n1161\t-                    \"transcript\",\n1162\t-                )\n1163\t-            content = _cite_bounded_tail_read(Path(real))\n1164\t-            for needle in _cite_needles(cited_text):\n1165\t-                if needle in content:\n1166\t-                    return (True, \"\", \"transcript\")\n1167\t-            return (\n1168\t-                False,\n1169\t-                \"cited text not found in the session transcript (last %d \"\n1170\t-                \"bytes searched) — the citation must be VERBATIM\"\n1171\t-                % _CITE_READ_CAP_BYTES,\n1172\t-                \"transcript\",\n1173\t-            )\n1174\t-        # PLAN-NNN source. Codex pair-rail P2 (S261 landing): a plan file is\n1175\t-        # NOT a trusted citation source. Any agent can plant a line in a draft\n1176\t-        # `.claude/plans/PLAN-NNN-*.md` and then cite it to flip a destructive\n1177\t-        # command from BLOCK to ALLOW. Per the repo's fail-CLOSED rule for\n1178\t-        # security matchers, only the session TRANSCRIPT (append-only, written\n1179\t-        # by the harness, not plantable by the agent) is a trusted source for\n1180\t-        # authorizing a destructive op. Plan citations are rejected — cite the\n1181\t-        # instruction via the session transcript instead. (A future signed-\n1182\t-        # sentinel citation channel could reinstate a trusted file source.)\n1183\t-        return (\n1184\t-            False,\n1185\t-            \"plan-file citations are not a trusted source (an agent can plant \"\n1186\t-            \"a line in a draft plan) — cite the authorizing instruction via \"\n1187\t-            \"the session transcript instead\",\n1188\t-            \"plan\",\n1189\t-        )\n1190\t-    except Exception as e:\n1191\t-        # FAIL-CLOSED: unreadable source == unverifiable citation == block.\n1192\t-        return (\n1193\t-            False,\n1194\t-            \"citation source read failed (%s) — cannot verify, so the op \"\n1195\t-            \"stays blocked\" % e.__class__.__name__,\n1196\t-            \"transcript\" if source == \"transcript\" else \"plan\",\n1197\t-        )\n1198\t-\n1199\t-\n1200\t-def _emit_destructive_citation_accepted(\n1201\t-    source_class: str, source: str, cited_text: str\n1202\t-) -> None:\n1203\t-    \"\"\"Record the ACCEPTED citation into the HMAC audit chain. Fail-open\n1204\t-    (an emit failure never flips the allow) — but NEVER writes the cited\n1205\t-    text unredacted: if the redactor is unavailable the text is withheld.\"\"\"\n1206\t-    if _audit_emit is None:\n1207\t-        return\n1208\t-    try:\n1209\t-        try:\n1210\t-            from _lib.redact import redact_secrets as _redact_secrets\n1211\t-            cited_data = _redact_secrets(\n1212\t-                cited_text, max_chars=_CITE_AUDIT_PREVIEW_CHARS\n1213\t-            )\n1214\t-        except Exception:\n1215\t-            cited_data = \"[REDACTION-UNAVAILABLE: cited text withheld]\"\n1216\t-        import os as _os\n1217\t-        _audit_emit.emit_generic(\n1218\t-            \"veto_triggered\",\n1219\t-            hook=\"check_bash_safety\",\n1220\t-            reason_code=\"destructive_citation_accepted\",\n1221\t-            reason_preview=(\n1222\t-                \"destructive Bash ALLOWED via verified citation \"\n1223\t-                \"(source=%s); see cited_instruction_data\" % source_class\n1224\t-            ),\n1225\t-            blocked_tool=\"Bash\",\n1226\t-            gate_outcome=\"allowed_with_citation\",\n1227\t-            cite_source_class=source_class,\n1228\t-            cite_source_label=source[:80],\n1229\t-            # DATA field (ADR-175): quoted evidence of the justifying\n1230\t-            # instruction — redacted, truncated, inert. Never instructions.\n1231\t-            cited_instruction_data=cited_data,\n1232\t-            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n1233\t-            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n1234\t-        )\n1235\t-    except Exception:  # pragma: no cover — fail-open on emit only\n1236\t-        pass\n1237\t-\n1238\t-\n1239\t-def _emit_destructive_citation_rejected(detail: str) -> None:\n1240\t-    \"\"\"Record a citation verify-failure (the op was BLOCKED). Metadata only —\n1241\t-    the cited bytes are NOT persisted on the reject path. Fail-open.\"\"\"\n1242\t-    if _audit_emit is None:\n1243\t-        return\n1244\t-    try:\n1245\t-        _audit_emit.emit_veto_triggered(\n1246\t-            hook=\"check_bash_safety\",\n1247\t-            reason_code=\"destructive_citation_verify_failed\",\n1248\t-            reason_preview=detail[:200],\n1249\t-            blocked_tool=\"Bash\",\n1250\t-        )\n1251\t-    except Exception:  # pragma: no cover — fail-open on emit only\n1252\t-        pass\n1253\t-\n1254\t-\n1255\t-def _extract_transcript_path(raw_stdin_text: str) -> str:\n1256\t-    \"\"\"Best-effort read of the top-level `transcript_path` field from the\n1257\t-    hook's raw stdin payload (the adapter's NormalizedEvent deliberately\n1258\t-    drops it — deny-by-default raw_payload — so we parse the buffered raw\n1259\t-    text ourselves). Returns \"\" on any parse issue; a missing path only\n1260\t-    ever FAILS a 'transcript:' citation (fail-closed), never allows.\"\"\"\n1261\t-    try:\n1262\t-        data = json.loads(raw_stdin_text)\n1263\t-        if isinstance(data, dict):\n1264\t-            tp = data.get(\"transcript_path\")\n1265\t-            if isinstance(tp, str):\n1266\t-                return tp\n1267\t-    except Exception:\n1268\t-        pass\n1269\t-    return \"\"\n1270\t-\n1271\t-\n1272\t-def _apply_destructive_citation_gate(\n1273\t-    decision: \"Decision\", command: str, transcript_path: str\n1274\t-) -> \"Decision\":\n1275\t-    \"\"\"Apply the ADR-175 citation gate to a DESTRUCTIVE block decision.\n1276\t-\n1277\t-    Called from main() ONLY when the gate is enabled AND\n1278\t-    ``decision.destructive`` is True. Outcomes:"}]},"parent_tool_use_id":null,"session_id":"15f68acd-8563-46de-ac1c-c65891f7fb4e","uuid":"b93d6a1b-bc45-48b6-bb69-9a6f55bbd42c","timestamp":"2026-11-16T18:11:22.278Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/plans/PLAN-198/repass-rc1/diff-rc1-21.patch","content":"-        for provider, match, _off in _credentials.detect_keys(command):\n-            if _credentials.is_likely_real_key(match, command):\n-                return provider, _credentials.redacted_display(provider, match)\n-        return None\n-    except Exception as e:\n-        print(f\"[check_bash_safety] credential-scan failure; failing closed: \"\n-              f\"{e.__class__.__name__}\", file=sys.stderr)\n-        return \"unknown\", \"unknown:****\"\n-\n-\n-# >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (gate implementation)\n-# -----------------------------------------------------------------------------\n-# PLAN-153 Wave E item 5 / ADR-175 half 1 — destructive-Bash CITATION GATE\n-# -----------------------------------------------------------------------------\n-#\n-# When a command classifies as DESTRUCTIVE (rm -rf / git reset --hard /\n-# git push --force — Decision.destructive == True), the operator may supply\n-# a CITATION: the instruction that justifies the destructive op, quoted\n-# VERBATIM, via a leading shell env-assignment on the command itself:\n-#\n-#     CEO_DESTRUCTIVE_CITE='transcript:<verbatim instruction text>' rm -rf build/\n-#     CEO_DESTRUCTIVE_CITE='PLAN-153:<verbatim plan text>'          rm -rf build/\n-#\n-# Channel rationale: the assignment travels INSIDE `tool_input.command` — the\n-# one field this PreToolUse hook actually receives and can verify against the\n-# stdin payload (a separate env var would be invisible to the payload; a\n-# transcript-adjacent side file would be writable by the same actor issuing\n-# the command). `_normalize_command_tokens` strips leading assignments, so\n-# the citation prefix can never DE-classify the command (see the env-\n-# assignment normalization block above).\n-#\n-# VERIFICATION (bounded read):\n-#   * source `transcript` → the `transcript_path` field of the hook's OWN\n-#     stdin payload (Claude Code supplies it on every hook event). Hardening:\n-#     the resolved path must live under ~/.claude/ and end in `.jsonl` —\n-#     a payload pointing anywhere else fails verification (fail-CLOSED).\n-#     The cited text must appear verbatim (raw or JSON-escaped, since\n-#     transcripts are JSONL) within the LAST `_CITE_READ_CAP_BYTES` of the\n-#     file (recent instructions live at the tail; text beyond the bound\n-#     simply fails verification — the fail-closed direction).\n-#   * source `PLAN-NNN` → `$CLAUDE_PROJECT_DIR/.claude/plans/PLAN-NNN-*.md`\n-#     (PLAN-SCHEMA naming), same bounded read.\n-#\n-# FAIL-CLOSED (mirrors the `_e3` whole-command parse gate + the\n-# `_check_credential_leak` precedent, PLAN-152 debate C4): citation absent /\n-# malformed / too short / transcript unreadable / cited text not found ⇒ the\n-# destructive op stays BLOCKED with an actionable reason. Fail-OPEN is\n-# permitted ONLY on the audit-emit side (an emit failure never flips the\n-# decision).\n-#\n-# ACCEPTED citations are recorded into the HMAC audit chain via\n-# `_lib.audit_emit.emit_generic(\"veto_triggered\", ...)` (a passthrough-\n-# registered action; a NEW action name would require touching\n-# `_lib/audit_emit.py`'s _KNOWN_ACTIONS, outside this unit's scope — the\n-# `reason_code=destructive_citation_accepted` + `gate_outcome` fields\n-# disambiguate, following the git_hook_bypass_blocked/escape_hatch_used\n-# precedent of recording the AUTHORIZED path under the guard's action). The\n-# cited text passes `_lib.redact.redact_secrets` and lands in the\n-# `cited_instruction_data` field — the `_data` suffix marks it as inert DATA\n-# (quoted evidence), never instructions.\n-#\n-# SCOPE GUARD: the gate keys off `Decision.destructive` ONLY. Canonical-path\n-# writes, credential leaks, git hook-bypass and env-hijack blocks are NOT\n-# citation-gatable — no citation unlocks those.\n-#\n-# Pilot flag: CEO_DESTRUCTIVE_CITATION_GATE == \"1\" ENABLES the gate\n-# (default-OFF, mirroring the H5 force-push-rewrite pilot: a change that adds\n-# an allow path to a hard block ships opt-in until its ceremony + Codex round\n-# close). Read from the import-time trusted_env snapshot, NOT live os.environ.\n-\n-_DESTRUCTIVE_CITE_GATE_VAR = \"CEO_DESTRUCTIVE_CITATION_GATE\"\n-_DESTRUCTIVE_CITE_VAR = \"CEO_DESTRUCTIVE_CITE\"\n-_CITE_MIN_CHARS = 16                    # a real instruction, not a token\n-_CITE_READ_CAP_BYTES = 4 * 1024 * 1024  # bounded tail read (4 MiB)\n-_CITE_AUDIT_PREVIEW_CHARS = 400         # cap on cited text entering the chain\n-_CITE_PLAN_SOURCE_RE = re.compile(r\"^PLAN-\\d{3}$\")\n-_CITE_MAX_PLAN_FILES = 5                # bound the glob fan-out\n-\n-\n-def _destructive_citation_gate_enabled() -> bool:\n-    \"\"\"True iff CEO_DESTRUCTIVE_CITATION_GATE == \"1\" in the trusted_env\n-    snapshot (default-OFF pilot). Snapshot unavailability ⇒ DISABLED (the\n-    most conservative state: the legacy hard BLOCK). Pure; never raises.\"\"\"\n-    if _trusted_env is None:  # pragma: no cover — import failure → default-OFF\n-        return False\n-    try:\n-        raw = _trusted_env.get_trusted(_DESTRUCTIVE_CITE_GATE_VAR)\n-    except Exception:  # pragma: no cover\n-        return False\n-    return (str(raw).strip() == \"1\") if raw is not None else False\n-\n-\n-def _extract_destructive_citation(command: str) -> \"tuple\":\n-    \"\"\"Extract the CEO_DESTRUCTIVE_CITE citation from the command's leading\n-    env-assignment prefix.\n-\n-    Returns a 3-tuple ``(status, source, cited_text)``:\n-      * ``(\"absent\", \"\", \"\")``     — no citation assignment in the prefix\n-        (also the outcome when the whole command fails shlex — an\n-        unparseable command cannot carry a verifiable citation, and the\n-        caller's fail-closed handling keeps the op blocked).\n-      * ``(\"malformed\", detail, \"\")`` — assignment present but not of shape\n-        ``<source>:<verbatim text>`` with source ``transcript`` | ``PLAN-NNN``\n-        and text >= _CITE_MIN_CHARS.\n-      * ``(\"ok\", source, cited_text)`` — well-formed citation.\n-\n-    Only the LEADING assignment run is scanned (shell semantics: assignments\n-    after the first command word are arguments, not environment). Pure;\n-    never raises.\n-    \"\"\"\n-    if not command or not command.strip():\n-        return (\"absent\", \"\", \"\")\n-    try:\n-        tokens = shlex.split(command)\n-    except ValueError:\n-        return (\"absent\", \"\", \"\")\n-    value = None  # type: Optional[str]\n-    for tok in tokens:\n-        if not _ENV_ASSIGNMENT_RE.match(tok):\n-            break  # first non-assignment token ends the env prefix run\n-        name, _, rest = tok.partition(\"=\")\n-        if name == _DESTRUCTIVE_CITE_VAR:\n-            value = rest\n-            break\n-    if value is None:\n-        return (\"absent\", \"\", \"\")\n-    source, sep, cited = value.partition(\":\")\n-    if not sep:\n-        return (\n-            \"malformed\",\n-            \"missing ':' separator (expected '<source>:<verbatim text>')\",\n-            \"\",\n-        )\n-    source = source.strip()\n-    if source != \"transcript\" and not _CITE_PLAN_SOURCE_RE.match(source):\n-        return (\n-            \"malformed\",\n-            \"unknown source %r (expected 'transcript' or 'PLAN-NNN')\" % source,\n-            \"\",\n-        )\n-    if len(cited) < _CITE_MIN_CHARS:\n-        return (\n-            \"malformed\",\n-            \"cited text under %d chars — quote the justifying instruction \"\n-            \"verbatim, not a fragment\" % _CITE_MIN_CHARS,\n-            \"\",\n-        )\n-    return (\"ok\", source, cited)\n-\n-\n-def _cite_bounded_tail_read(path: \"Path\") -> str:\n-    \"\"\"Read at most the LAST _CITE_READ_CAP_BYTES of ``path`` as utf-8\n-    (errors=replace). Raises OSError family on unreadable paths — the\n-    CALLER converts that to a fail-CLOSED block.\"\"\"\n-    import os as _os\n-    size = _os.path.getsize(str(path))\n-    with open(str(path), \"rb\") as fh:\n-        if size > _CITE_READ_CAP_BYTES:\n-            fh.seek(size - _CITE_READ_CAP_BYTES)\n-        data = fh.read(_CITE_READ_CAP_BYTES)\n-    return data.decode(\"utf-8\", \"replace\")\n-\n-\n-def _cite_needles(cited_text: str) -> \"List[str]\":\n-    \"\"\"The raw cited text + its JSON-escaped form (transcripts are JSONL, so\n-    an instruction containing quotes/newlines is stored escaped).\"\"\"\n-    needles = [cited_text]\n-    try:\n-        escaped = json.dumps(cited_text, ensure_ascii=False)[1:-1]\n-        if escaped != cited_text:\n-            needles.append(escaped)\n-    except Exception:  # pragma: no cover — dumps on str cannot realistically fail\n-        pass\n-    return needles\n-\n-\n-def _verify_destructive_citation(\n-    source: str,\n-    cited_text: str,\n-    transcript_path: str,\n-) -> \"tuple\":\n-    \"\"\"Verify ``cited_text`` appears verbatim in the source it points at.\n-\n-    Returns ``(ok, detail, source_class)`` where ``source_class`` is the\n-    closed enum ``\"transcript\"`` | ``\"plan\"`` (for the audit record) and\n-    ``detail`` is an actionable failure description on ``ok == False``.\n-\n-    FAIL-CLOSED BY CONSTRUCTION: every unexpected exception is caught and\n-    converted to ``(False, ...)`` — content the gate cannot verify is\n-    blocked, never waved through (the `_e3` / C4 precedent).\n-    \"\"\"\n-    import os as _os\n-    try:\n-        if source == \"transcript\":\n-            if not transcript_path:\n-                return (\n-                    False,\n-                    \"hook payload carried no transcript_path (cannot verify \"\n-                    \"a 'transcript:' citation in this session)\",\n-                    \"transcript\",\n-                )\n-            real = _os.path.realpath(transcript_path)\n-            claude_root = _os.path.realpath(\n-                _os.path.join(_os.path.expanduser(\"~\"), \".claude\")\n-            )\n-            if not real.startswith(claude_root + _os.sep):\n-                return (\n-                    False,\n-                    \"transcript_path resolves outside ~/.claude/ \"\n-                    \"(refusing to verify against an arbitrary file)\",\n-                    \"transcript\",\n-                )\n-            if not real.endswith(\".jsonl\"):\n-                return (\n-                    False,\n-                    \"transcript_path is not a .jsonl session transcript\",\n-                    \"transcript\",\n-                )\n-            if not _os.path.isfile(real):\n-                return (\n-                    False,\n-                    \"transcript file does not exist or is not a regular file\",\n-                    \"transcript\",\n-                )\n-            content = _cite_bounded_tail_read(Path(real))\n-            for needle in _cite_needles(cited_text):\n-                if needle in content:\n-                    return (True, \"\", \"transcript\")\n-            return (\n-                False,\n-                \"cited text not found in the session transcript (last %d \"\n-                \"bytes searched) — the citation must be VERBATIM\"\n-                % _CITE_READ_CAP_BYTES,\n-                \"transcript\",\n-            )\n-        # PLAN-NNN source. Codex pair-rail P2 (S261 landing): a plan file is\n-        # NOT a trusted citation source. Any agent can plant a line in a draft\n-        # `.claude/plans/PLAN-NNN-*.md` and then cite it to flip a destructive\n-        # command from BLOCK to ALLOW. Per the repo's fail-CLOSED rule for\n-        # security matchers, only the session TRANSCRIPT (append-only, written\n-        # by the harness, not plantable by the agent) is a trusted source for\n-        # authorizing a destructive op. Plan citations are rejected — cite the\n-        # instruction via the session transcript instead. (A future signed-\n-        # sentinel citation channel could reinstate a trusted file source.)\n-        return (\n-            False,\n-            \"plan-file citations are not a trusted source (an agent can plant \"\n-            \"a line in a draft plan) — cite the authorizing instruction via \"\n-            \"the session transcript instead\",\n-            \"plan\",\n-        )\n-    except Exception as e:\n-        # FAIL-CLOSED: unreadable source == unverifiable citation == block.\n-        return (\n-            False,\n-            \"citation source read failed (%s) — cannot verify, so the op \"\n-            \"stays blocked\" % e.__class__.__name__,\n-            \"transcript\" if source == \"transcript\" else \"plan\",\n-        )\n-\n-\n-def _emit_destructive_citation_accepted(\n-    source_class: str, source: str, cited_text: str\n-) -> None:\n-    \"\"\"Record the ACCEPTED citation into the HMAC audit chain. Fail-open\n-    (an emit failure never flips the allow) — but NEVER writes the cited\n-    text unredacted: if the redactor is unavailable the text is withheld.\"\"\"\n-    if _audit_emit is None:\n-        return\n-    try:\n-        try:\n-            from _lib.redact import redact_secrets as _redact_secrets\n-            cited_data = _redact_secrets(\n-                cited_text, max_chars=_CITE_AUDIT_PREVIEW_CHARS\n-            )\n-        except Exception:\n-            cited_data = \"[REDACTION-UNAVAILABLE: cited text withheld]\"\n-        import os as _os\n-        _audit_emit.emit_generic(\n-            \"veto_triggered\",\n-            hook=\"check_bash_safety\",\n-            reason_code=\"destructive_citation_accepted\",\n-            reason_preview=(\n-                \"destructive Bash ALLOWED via verified citation \"\n-                \"(source=%s); see cited_instruction_data\" % source_class\n-            ),\n-            blocked_tool=\"Bash\",\n-            gate_outcome=\"allowed_with_citation\",\n-            cite_source_class=source_class,\n-            cite_source_label=source[:80],\n-            # DATA field (ADR-175): quoted evidence of the justifying\n-            # instruction — redacted, truncated, inert. Never instructions.\n-            cited_instruction_data=cited_data,\n-            session_id=_os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n-            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n-        )\n-    except Exception:  # pragma: no cover — fail-open on emit only\n-        pass\n-\n-\n-def _emit_destructive_citation_rejected(detail: str) -> None:\n-    \"\"\"Record a citation verify-failure (the op was BLOCKED). Metadata only —\n-    the cited bytes are NOT persisted on the reject path. Fail-open.\"\"\"\n-    if _audit_emit is None:\n-        return\n-    try:\n-        _audit_emit.emit_veto_triggered(\n-            hook=\"check_bash_safety\",\n-            reason_code=\"destructive_citation_verify_failed\",\n-            reason_preview=detail[:200],\n-            blocked_tool=\"Bash\",\n-        )\n-    except Exception:  # pragma: no cover — fail-open on emit only\n-        pass\n-\n-\n-def _extract_transcript_path(raw_stdin_text: str) -> str:\n-    \"\"\"Best-effort read of the top-level `transcript_path` field from the\n-    hook's raw stdin payload (the adapter's NormalizedEvent deliberately\n-    drops it — deny-by-default raw_payload — so we parse the buffered raw\n-    text ourselves). Returns \"\" on any parse issue; a missing path only\n-    ever FAILS a 'transcript:' citation (fail-closed), never allows.\"\"\"\n-    try:\n-        data = json.loads(raw_stdin_text)\n-        if isinstance(data, dict):\n-            tp = data.get(\"transcript_path\")\n-            if isinstance(tp, str):\n-                return tp\n-    except Exception:\n-        pass\n-    return \"\"\n-\n-\n-def _apply_destructive_citation_gate(\n-    decision: \"Decision\", command: str, transcript_path: str\n-) -> \"Decision\":\n-    \"\"\"Apply the ADR-175 citation gate to a DESTRUCTIVE block decision.\n-\n-    Called from main() ONLY when the gate is enabled AND\n-    ``decision.destructive`` is True. Outcomes:","numLines":340,"startLine":939,"totalLines":4272}},"tool_result_meta":[{"id":"toolu_01ViLRvT1arXpsa7hbfP5cof","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
