{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QXoe8SH5ftMFCFKYtMoReF","type":"tool_result","content":"680\t-# fixture corpus is unchanged. Read from the import-time trusted_env snapshot\n681\t-# (NOT live os.environ) so a late-set value cannot toggle the rewriter mid-op.\n682\t-\n683\t-_FORCE_PUSH_REWRITE_DISABLE_VAR = \"CEO_BASH_FORCE_PUSH_REWRITE\"\n684\t-_FORCE_PUSH_REWRITE_CLASS = \"git_push_force_to_lease\"\n685\t-\n686\t-\n687\t-def _force_push_rewrite_enabled() -> bool:\n688\t-    \"\"\"True iff the H5 force-push→lease rewrite is enabled (PILOT, default-OFF).\n689\t-\n690\t-    Enabled ONLY when CEO_BASH_FORCE_PUSH_REWRITE == \"1\" in the import-time\n691\t-    trusted_env snapshot (NOT live os.environ — a late-set value cannot toggle\n692\t-    the rewriter mid-op). Default-OFF restores the legacy force-push BLOCK as\n693\t-    the shipped behavior (existing byte-identity fixtures unchanged); the\n694\t-    rewrite is an opt-in pilot. When the snapshot is unavailable the rewrite\n695\t-    stays DISABLED (fail to the legacy BLOCK — the most conservative state).\n696\t-    Pure; never raises.\n697\t-    \"\"\"\n698\t-    if _trusted_env is None:  # pragma: no cover — import failure → default-OFF (block)\n699\t-        return False\n700\t-    try:\n701\t-        raw = _trusted_env.get_trusted(_FORCE_PUSH_REWRITE_DISABLE_VAR)\n702\t-    except Exception:  # pragma: no cover\n703\t-        return False\n704\t-    if raw is None:\n705\t-        return False\n706\t-    return str(raw).strip() == \"1\"\n707\t-\n708\t-\n709\t-def _sha256_hex(text: str) -> str:\n710\t-    \"\"\"sha256 hex digest of ``text`` (utf-8). Pure; never raises.\"\"\"\n711\t-    return hashlib.sha256(text.encode(\"utf-8\", \"surrogatepass\")).hexdigest()\n712\t-\n713\t-\n714\t-def _rewrite_git_push_force(command: str) -> Optional[Rewrite]:\n715\t-    \"\"\"Build a `git push --force-with-lease` rewrite, or None to fall back.\n716\t-\n717\t-    Returns a :class:`Rewr