-                        audit_emit_module=audit_emit_module,
-                        session_id=session_id,
-                        project=project,
-                        bias_direction=direction,
-                        plans_affected_count=count,
-                        avg_drift_factor_compute=avg_compute,
-                        avg_drift_factor_owner=avg_owner,
-                    )
-                break
-
-    return findings
