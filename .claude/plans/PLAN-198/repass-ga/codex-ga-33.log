-                payload = entry["payload"](tool_use_id)
-                t0 = time.perf_counter_ns()
-                try:
-                    res = subprocess.run(
-                        [sys.executable, str(entry["hook"])],
-                        input=payload,
-                        capture_output=True,
-                        env=env,
