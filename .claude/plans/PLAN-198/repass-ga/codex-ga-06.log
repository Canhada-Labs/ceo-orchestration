+    if opt_in is None or opt_in == "":
+        return False, ""
+    return False, "CEO_LEARNING_BOOT_LESSONS"
+
+
+def _emit_learning_rail_disabled_safe(switch: str) -> None:
+    """A12 disabled-this-session breadcrumb (rail=boot_render). Fail-open.
+
