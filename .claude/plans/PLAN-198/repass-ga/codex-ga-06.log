+# audit action registration owned by the integrator).
+_LESSON_BOOT_DROP_REASONS = frozenset({
+    "bad_shape", "hash_malformed", "vocab", "oversize",
+    "validator_unavailable", "validator_block", "scan_redacted",
+    "excess", "other",
