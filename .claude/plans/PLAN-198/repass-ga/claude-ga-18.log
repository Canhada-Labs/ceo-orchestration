{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016xbX9i4UPbnKjR4jCGyayo","type":"tool_result","content":"140\t        # >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (stdin buffering)\n141\t        # Read stdin ONCE into a buffer, then hand the adapter an equivalent\n142\t        # stream. The adapter's NormalizedEvent deliberately drops the raw\n143\t        # payload (deny-by-default), but the citation gate needs the\n144\t        # top-level `transcript_path` field — parsed here from the SAME\n145\t        # bytes the adapter consumes, so the verified path is exactly what\n146\t        # the harness sent. Behavior-neutral for every other code path.\n147\t        import io as _io\n148\t        try:\n149\t            _raw_stdin_text = sys.stdin.read()\n150\t        except Exception:  # exotic stdin failure → same fail-open as before\n151\t            _raw_stdin_text = \"\"\n152\t        event = _adapter.read_event(\n153\t            stream=_io.StringIO(_raw_stdin_text), phase=\"PreToolUse\"\n154\t        )\n155\t        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n156\t        if event.parse_error:\n157\t            print(\n158\t                f\"[check_bash_safety] WARN: stdin parse error: {event.parse_error}\",\n159\t                file=sys.stderr,\n160\t            )\n161\t            _adapter_emit(_adapter, _contract.allow(), event)\n162\t            return 0\n163\t\n164\t        command = event.command or \"\"\n165\t        if not command and isinstance(event.tool_input, dict):\n166\t            command = str(event.tool_input.get(\"command\") or \"\")\n167\t\n168\t        try:\n169\t            from _lib import bash_indirect_telemetry as _indirect_telemetry\n170\t            for _switch in (\"CEO_BASH_INDIRECT_GUARD\", \"CEO_BASH_INDIRECT_HEURISTICS\"):\n171\t                if _trusted_env.get_trusted(_switch) == \"0\":\n172\t                    _indirect_telemetry.disabled_once(_switch, event.session_id)\n173\t        except Exception:  # audit infrastructure must not change the verdict\n174\t            pass\n175\t\n176\t        decision = decide_command(command)\n177\t        # PLAN-154 fact gate precedes the PLAN-153 citation pilot for\n178\t        # destructive-class blocks. Both see the final decision.\n179\t        if not decision.allow and decision.destructive:\n180\t            _fact_transcript_path = _extract_transcript_path(_raw_stdin_text)\n181\t            decision, _fact_enforce_active = _apply_fact_gate(\n182\t                decision, command, _fact_transcript_path\n183\t            )\n184\t            if (\n185\t                not decision.allow\n186\t                and decision.destructive\n187\t                and not _fact_enforce_active\n188\t                and _destructive_citation_gate_enabled()\n189\t            ):\n190\t                decision = _apply_destructive_citation_gate(\n191\t                    decision, command, _fact_transcript_path\n192\t                )\n193\t        # <<< PLAN-154.F6 fact-gate END\n194\t        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n195\t        if not decision.allow and decision.reason_code and _audit_emit is not None:\n196\t            try:\n197\t                _audit_emit.emit_veto_triggered(\n198\t                    hook=\"check_bash_safety\", reason_code=decision.reason_code,\n199\t                    reason_preview=decision.reason[:200], blocked_tool=\"Bash\",\n200\t                )\n201\t            except Exception:  # audit infrastructure must remain fail-open\n202\t                pass\n203\t        # Re-run detector on credential blocks to emit audit event.\n204\t        if not decision.allow and decision.reason and \"API credential\" in decision.reason:\n205\t            hit = _check_credential_leak(command)\n206\t            if hit is not None:\n207\t                _emit_credential_leak_event(hit[0], hit[1])\n208\t        # PLAN-124 WS-1 — emit git_hook_bypass_blocked on a block OR an\n209\t        # authorized escape-hatch use. Re-scan to recover the closed-enum\n210\t        # flag_class (decide_command stays pure / I/O-free). The credential\n211\t        # block above takes precedence, so skip if the reason was a credential.\n212\t        if not (decision.reason and \"API credential\" in decision.reason):\n213\t            git_hit = _check_git_bypass(command)\n214\t            if git_hit is not None:\n215\t                _kind, _flag_class, _reason = git_hit\n216\t                # block → emit the matched flag_class; escape → escape_hatch_used.\n217\t                _emit_git_hook_bypass_event(_flag_class)\n218\t        # PLAN-133 A1 — emit env_var_hijack_blocked on ANY detected env-hijack\n219\t        # SET (enforced block OR advisory default-OFF detection). Re-scan to\n220\t        # recover the closed-enum hijack_class (decide_command stays pure). Only\n221\t        # the closed-enum class is persisted — never the var name/value.\n222\t        if not (decision.reason and \"API credential\" in decision.reason):\n223\t            env_hit = _check_env_hijack(command)\n224\t            if env_hit is not None:\n225\t                _hijack_class, _key, _reason = env_hit\n226\t                _emit_env_var_hijack_event(_hijack_class)\n227\t        # PLAN-133 A3 — emit egress destinations on block or allow.\n228\t        if _egress_emit_enabled():\n229\t            for _eclass, _edest in _classify_egress(command):\n230\t                _emit_egress_destination_event(_eclass, _edest)\n231\t        # PLAN-135 W2 H5 — when decide_command chose the corrective rewrite,\n232\t        # emit the bash_input_rewritten audit event with the before/after\n233\t        # hash PAIR BEFORE emitting the `ask` decision (mini-ADR-154 §2: the\n234\t        # audit records that the rail rewrote the input, so the downstream\n235\t        # audited command provably equals the executed/asked command). The\n236\t        # emit is fail-open (it never gates the decision).\n237\t        if decision.rewrite is not None:\n238\t            _emit_bash_input_rewritten_event(decision.rewrite)\n239\t        _adapter_emit(\n240\t            _adapter, _to_contract_decision(decision, event.tool_input), event\n241\t        )\n242\t        return 0\n243\t    except Exception as e:  # pragma: no cover\n244\t        print(\n245\t            f\"[check_bash_safety] FATAL: {e.__class__.__name__}: {e}\",\n246\t            file=sys.stderr,\n247\t        )\n248\t        _adapter_emit(_adapter, _contract.allow(), event)\n249\t        return 0\n250\t\n251\t\n252\tif __name__ == \"__main__\":\n253\t    sys.exit(main())\n254\t"}]},"parent_tool_use_id":null,"session_id":"447e2ee8-eb2d-46ed-af95-50cde31c949e","uuid":"1ea7fba5-88e2-4205-8fa8-d84e98c23b03","timestamp":"2026-11-16T19:02:02.712Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_bash_safety_parts/decisions_cli.py","content":"        # >>> PLAN-153.E5 / ADR-175 citation-gate BEGIN (stdin buffering)\n        # Read stdin ONCE into a buffer, then hand the adapter an equivalent\n        # stream. The adapter's NormalizedEvent deliberately drops the raw\n        # payload (deny-by-default), but the citation gate needs the\n        # top-level `transcript_path` field — parsed here from the SAME\n        # bytes the adapter consumes, so the verified path is exactly what\n        # the harness sent. Behavior-neutral for every other code path.\n        import io as _io\n        try:\n            _raw_stdin_text = sys.stdin.read()\n        except Exception:  # exotic stdin failure → same fail-open as before\n            _raw_stdin_text = \"\"\n        event = _adapter.read_event(\n            stream=_io.StringIO(_raw_stdin_text), phase=\"PreToolUse\"\n        )\n        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n        if event.parse_error:\n            print(\n                f\"[check_bash_safety] WARN: stdin parse error: {event.parse_error}\",\n                file=sys.stderr,\n            )\n            _adapter_emit(_adapter, _contract.allow(), event)\n            return 0\n\n        command = event.command or \"\"\n        if not command and isinstance(event.tool_input, dict):\n            command = str(event.tool_input.get(\"command\") or \"\")\n\n        try:\n            from _lib import bash_indirect_telemetry as _indirect_telemetry\n            for _switch in (\"CEO_BASH_INDIRECT_GUARD\", \"CEO_BASH_INDIRECT_HEURISTICS\"):\n                if _trusted_env.get_trusted(_switch) == \"0\":\n                    _indirect_telemetry.disabled_once(_switch, event.session_id)\n        except Exception:  # audit infrastructure must not change the verdict\n            pass\n\n        decision = decide_command(command)\n        # PLAN-154 fact gate precedes the PLAN-153 citation pilot for\n        # destructive-class blocks. Both see the final decision.\n        if not decision.allow and decision.destructive:\n            _fact_transcript_path = _extract_transcript_path(_raw_stdin_text)\n            decision, _fact_enforce_active = _apply_fact_gate(\n                decision, command, _fact_transcript_path\n            )\n            if (\n                not decision.allow\n                and decision.destructive\n                and not _fact_enforce_active\n                and _destructive_citation_gate_enabled()\n            ):\n                decision = _apply_destructive_citation_gate(\n                    decision, command, _fact_transcript_path\n                )\n        # <<< PLAN-154.F6 fact-gate END\n        # <<< PLAN-153.E5 / ADR-175 citation-gate END\n        if not decision.allow and decision.reason_code and _audit_emit is not None:\n            try:\n                _audit_emit.emit_veto_triggered(\n                    hook=\"check_bash_safety\", reason_code=decision.reason_code,\n                    reason_preview=decision.reason[:200], blocked_tool=\"Bash\",\n                )\n            except Exception:  # audit infrastructure must remain fail-open\n                pass\n        # Re-run detector on credential blocks to emit audit event.\n        if not decision.allow and decision.reason and \"API credential\" in decision.reason:\n            hit = _check_credential_leak(command)\n            if hit is not None:\n                _emit_credential_leak_event(hit[0], hit[1])\n        # PLAN-124 WS-1 — emit git_hook_bypass_blocked on a block OR an\n        # authorized escape-hatch use. Re-scan to recover the closed-enum\n        # flag_class (decide_command stays pure / I/O-free). The credential\n        # block above takes precedence, so skip if the reason was a credential.\n        if not (decision.reason and \"API credential\" in decision.reason):\n            git_hit = _check_git_bypass(command)\n            if git_hit is not None:\n                _kind, _flag_class, _reason = git_hit\n                # block → emit the matched flag_class; escape → escape_hatch_used.\n                _emit_git_hook_bypass_event(_flag_class)\n        # PLAN-133 A1 — emit env_var_hijack_blocked on ANY detected env-hijack\n        # SET (enforced block OR advisory default-OFF detection). Re-scan to\n        # recover the closed-enum hijack_class (decide_command stays pure). Only\n        # the closed-enum class is persisted — never the var name/value.\n        if not (decision.reason and \"API credential\" in decision.reason):\n            env_hit = _check_env_hijack(command)\n            if env_hit is not None:\n                _hijack_class, _key, _reason = env_hit\n                _emit_env_var_hijack_event(_hijack_class)\n        # PLAN-133 A3 — emit egress destinations on block or allow.\n        if _egress_emit_enabled():\n            for _eclass, _edest in _classify_egress(command):\n                _emit_egress_destination_event(_eclass, _edest)\n        # PLAN-135 W2 H5 — when decide_command chose the corrective rewrite,\n        # emit the bash_input_rewritten audit event with the before/after\n        # hash PAIR BEFORE emitting the `ask` decision (mini-ADR-154 §2: the\n        # audit records that the rail rewrote the input, so the downstream\n        # audited command provably equals the executed/asked command). The\n        # emit is fail-open (it never gates the decision).\n        if decision.rewrite is not None:\n            _emit_bash_input_rewritten_event(decision.rewrite)\n        _adapter_emit(\n            _adapter, _to_contract_decision(decision, event.tool_input), event\n        )\n        return 0\n    except Exception as e:  # pragma: no cover\n        print(\n            f\"[check_bash_safety] FATAL: {e.__class__.__name__}: {e}\",\n            file=sys.stderr,\n        )\n        _adapter_emit(_adapter, _contract.allow(), event)\n        return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":115,"startLine":140,"totalLines":254}},"tool_result_meta":[{"id":"toolu_016xbX9i4UPbnKjR4jCGyayo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
