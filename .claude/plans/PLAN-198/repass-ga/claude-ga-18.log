{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SGZ9eowNF5ZrMwLo87iVSz","type":"tool_result","content":"100\t#: Audit-wire layer enum (settings layers + the safe sentinel). Mirrors\n101\t#: audit_emit._CONFIG_CHANGE_LAYERS.\n102\t_AUDIT_LAYERS = frozenset({\"user\", \"project\", \"local\", \"managed\", \"other\"})\n103\t\n104\t_REASON_CAP = 600\n105\t\n106\t\n107\tdef _breadcrumb(message: str) -> None:\n108\t    \"\"\"stderr breadcrumb for degraded / fail-open paths (closeout-guard precedent).\"\"\"\n109\t    try:\n110\t        sys.stderr.write(\"# check_config_change: %s\\n\" % str(message)[:200])\n111\t    except Exception:\n112\t        pass\n113\t\n114\t\n115\tdef _disabled() -> bool:\n116\t    return os.environ.get(\"CEO_CONFIG_CHANGE_GUARD\", \"1\").strip() == \"0\"\n117\t\n118\t\n119\tdef _coerce_layer(layer: Any) -> str:\n120\t    \"\"\"Coerce a finding layer to the audit-wire closed enum (sentinel ``other``).\"\"\"\n121\t    return layer if layer in _AUDIT_LAYERS else \"other\"\n122\t\n123\t\n124\tdef _resolve_cwd(hook_input: Dict[str, Any]) -> str:\n125\t    \"\"\"Project dir from the hook payload, else CLAUDE_PROJECT_DIR, else cwd.\"\"\"\n126\t    cwd = hook_input.get(\"cwd\")\n127\t    if isinstance(cwd, str) and cwd.strip():\n128\t        return cwd\n129\t    env_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\").strip()\n130\t    if env_dir:\n131\t        return env_dir\n132\t    return os.getcwd()\n133\t\n134\t\n135\tdef _settings_surface_findings(findings: List[Dict[str, str]]) -> List[Dict[str, str]]:\n136\t    \"\"\"Keep only findings scoped to a settings-FILE layer (drop env/disk).\n137\t\n138\t    H2 block-scopes the file surfaces a ConfigChange event represents; the\n139\t    process-``env`` snapshot and the on-disk hook census are S3's boot\n140\t    surfaces, not a settings-file change, so census/env findings are\n141\t    OBSERVE-ONLY here — never block-worthy.\n142\t    \"\"\"\n143\t    out: List[Dict[str, str]] = []\n144\t    for finding in findings:\n145\t        if not isinstance(finding, dict):\n146\t            continue\n147\t        layer = finding.get(\"layer\")\n148\t        if layer in _NON_FILE_LAYERS:\n149\t            continue\n150\t        out.append(finding)\n151\t    return out\n152\t\n153\t\n154\tdef _classify(cwd: str) -> List[Dict[str, str]]:\n155\t    \"\"\"Resolve + classify; never raises (resolver is fail-open by contract).\"\"\"\n156\t    if not _EFF_AVAILABLE or _eff is None:\n157\t        _breadcrumb(\"effective_config unavailable — degraded to allow (no scan)\")\n158\t        return []\n159\t    try:\n160\t        resolved = _eff.resolve_settings(cwd)\n161\t        # classify_tampering(resolved, None) consults the IMPORT-TIME env\n162\t        # snapshot (trusted_env pattern), NEVER live os.environ — a late-set\n163\t        # value injected mid-session cannot dodge the scan. We then filter\n164\t        # env/disk findings out of the BLOCK path below.\n165\t        return _eff.classify_tampering(resolved)\n166\t    except Exception as exc:  # pragma: no cover — resolver already fails open\n167\t        _breadcrumb(\"classify failed (%s) — degraded to allow\" % type(exc).__name__)\n168\t        return []\n169\t\n170\t\n171\tdef _emit_observed(layer: str, session_id: str, project: str) -> None:\n172\t    \"\"\"Audit the benign ALLOW path (one emit). Deny-by-default scrub branch.\n173\t\n174\t    No public typed wrapper (settings_tamper_detected precedent) — emit via\n175\t    emit_generic, which routes config_change_observed through its dedicated\n176\t    _scrub_ branch + _CONFIG_CHANGE_OBSERVED_ALLOWLIST. The ONLY caller field\n177\t    is the closed-enum ``layer``; the changed file's path/body and any\n178\t    settings value are NEVER passed.\n179\t    \"\"\"\n180\t    if not _AUDIT_AVAILABLE or _audit_emit is None:\n181\t        return\n182\t    try:\n183\t        _audit_emit.emit_generic(\n184\t            \"config_change_observed\",\n185\t            layer=_coerce_layer(layer),\n186\t            session_id=session_id,\n187\t            project=project,\n188\t        )\n189\t    except Exception as exc:  # pragma: no cover — emit never blocks the hook\n190\t        _breadcrumb(\"emit config_change_observed failed: %s\" % type(exc).__name__)\n191\t\n192\t\n193\tdef _emit_forbidden_key(\n194\t    tamper_class: str,\n195\t    layer: str,\n196\t    finding_count: int,\n197\t    session_id: str,\n198\t    project: str,\n199\t) -> None:\n200\t    \"\"\"Audit one forbidden-key tamper class on the BLOCK path.\n201\t\n202\t    ONE emit per (tamper_class) on the changed layer. Caller fields are the\n203\t    closed-enum ``tamper_class`` + ``layer`` + the integer ``finding_count``;\n204\t    the forbidden key's VALUE and the effective_config finding DETAIL are\n205\t    NEVER passed (the _scrub_ branch + allowlist would drop them anyway —\n206\t    belt and braces, the producer simply never sends them).\n207\t    \"\"\"\n208\t    if not _AUDIT_AVAILABLE or _audit_emit is None:\n209\t        return\n210\t    try:\n211\t        _audit_emit.emit_generic(\n212\t            \"config_change_forbidden_key\",\n213\t            tamper_class=str(tamper_class),\n214\t            layer=_coerce_layer(layer),\n215\t            finding_count=int(finding_count),\n216\t            session_id=session_id,\n217\t            project=project,\n218\t        )\n219\t    except Exception as exc:  # pragma: no cover\n220\t        _breadcrumb(\"emit config_change_forbidden_key failed: %s\" % type(exc).__name__)\n221\t\n222\t\n223\tdef _block_reason(forbidden: List[Dict[str, str]]) -> str:\n224\t    \"\"\"Build the advisory-block reason.\n225\t\n226\t    Names the tamper CLASS and the LAYER only — never the finding ``detail``\n227\t    (an attacker endpoint URL / off-allowlist model id / apiKeyHelper path /\n228\t    dangerously-flag value lives there; it is NEVER rendered into a\n229\t    decision-channel string the operator's terminal echoes).\n230\t    \"\"\"\n231\t    pairs = sorted({(f.get(\"class\", \"other\"), f.get(\"layer\", \"other\")) for f in forbidden})\n232\t    listed = \"; \".join(\"%s @ %s\" % (cls, layer) for cls, layer in pairs[:8])\n233\t    return (\n234\t        \"CONFIG-TAMPER: an out-of-band settings change introduced a forbidden \"\n235\t        \"key (S197 class). Forbidden-key tamper detected: %s. Review the \"\n236\t        \"settings layer named above and revert if you did not intend it; this \"\n237\t        \"is advisory — your edit is recorded but NOT auto-reverted. Coverage \"\n238\t        \"boundary: this guard is itself a hook (disarmed by disableAllHooks \"\n239\t        \"and blind to outside-harness edits); the /ceo-boot tripwires re-scan \"\n240\t        \"on the next boot.\" % (listed or \"unclassified\")\n241\t    )[:_REASON_CAP]\n242\t\n243\t\n244\tdef gate(hook_input: Dict[str, Any]) -> Dict[str, Any]:\n245\t    \"\"\"Pure decision function.\n246\t\n247\t    Returns ``{}`` (allow) on every benign / infra path, or\n248\t    ``{\"decision\": \"block\", \"reason\": ...}`` ONLY when a forbidden-key\n249\t    finding is scoped to a settings-file layer. Never raises.\n250\t    \"\"\"\n251\t    if _disabled():\n252\t        return {}\n253\t    cwd = _resolve_cwd(hook_input)\n254\t    session_id = \"\"\n255\t    sid = hook_input.get(\"session_id\")\n256\t    if isinstance(sid, str):\n257\t        session_id = sid[:64]\n258\t    project = \"\"\n259\t    proj = hook_input.get(\"project\")\n260\t    if isinstance(proj, str):\n261\t        project = proj[:128]\n262\t\n263\t    findings = _settings_surface_findings(_classify(cwd))\n264\t\n265\t    # Partition: forbidden-key findings on a block-scope settings layer\n266\t    # (FORBIDDEN_KEYS hits — every classify_tampering finding IS a\n267\t    # FORBIDDEN_KEYS hit by construction) vs. nothing-to-block.\n268\t    forbidden = [\n269\t        f for f in findings\n270\t        if isinstance(f, dict) and f.get(\"layer\") in _BLOCK_SCOPE_LAYERS\n271\t    ]\n272\t\n273\t    if not forbidden:\n274\t        # Benign change (or only env/disk findings, which are S3's surface):\n275\t        # audit one observed event. Layer is best-effort from the highest-\n276\t        # precedence settings layer that exists; default \"other\".\n277\t        _emit_observed(_observed_layer(cwd), session_id, project)\n278\t        return {}\n279\t\n280\t    # ADVISORY-BLOCK path: one audit emit per (tamper_class, layer) pair,\n281\t    # then return a block decision. NEVER degrade a would-be block into a\n282\t    # silent allow on a partial result (the resolver is fail-open; a real\n283\t    # forbidden finding here is authoritative).\n284\t    emitted = set()\n285\t    for finding in forbidden:\n286\t        cls = finding.get(\"class\", \"other\")\n287\t        layer = finding.get(\"layer\", \"other\")\n288\t        key = (cls, layer)\n289\t        if key in emitted:\n290\t            continue\n291\t        emitted.add(key)\n292\t        count = sum(\n293\t            1 for f in forbidden\n294\t            if f.get(\"class\") == cls and f.get(\"layer\") == layer\n295\t        )\n296\t        _emit_forbidden_key(cls, layer, count, session_id, project)\n297\t    return {\"decision\": \"block\", \"reason\": _block_reason(forbidden)}\n298\t\n299\t"}]},"parent_tool_use_id":null,"session_id":"447e2ee8-eb2d-46ed-af95-50cde31c949e","uuid":"6f1484f1-d540-4a54-8a89-bef5970a88fd","timestamp":"2026-11-16T19:04:00.939Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_config_change.py","content":"#: Audit-wire layer enum (settings layers + the safe sentinel). Mirrors\n#: audit_emit._CONFIG_CHANGE_LAYERS.\n_AUDIT_LAYERS = frozenset({\"user\", \"project\", \"local\", \"managed\", \"other\"})\n\n_REASON_CAP = 600\n\n\ndef _breadcrumb(message: str) -> None:\n    \"\"\"stderr breadcrumb for degraded / fail-open paths (closeout-guard precedent).\"\"\"\n    try:\n        sys.stderr.write(\"# check_config_change: %s\\n\" % str(message)[:200])\n    except Exception:\n        pass\n\n\ndef _disabled() -> bool:\n    return os.environ.get(\"CEO_CONFIG_CHANGE_GUARD\", \"1\").strip() == \"0\"\n\n\ndef _coerce_layer(layer: Any) -> str:\n    \"\"\"Coerce a finding layer to the audit-wire closed enum (sentinel ``other``).\"\"\"\n    return layer if layer in _AUDIT_LAYERS else \"other\"\n\n\ndef _resolve_cwd(hook_input: Dict[str, Any]) -> str:\n    \"\"\"Project dir from the hook payload, else CLAUDE_PROJECT_DIR, else cwd.\"\"\"\n    cwd = hook_input.get(\"cwd\")\n    if isinstance(cwd, str) and cwd.strip():\n        return cwd\n    env_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\").strip()\n    if env_dir:\n        return env_dir\n    return os.getcwd()\n\n\ndef _settings_surface_findings(findings: List[Dict[str, str]]) -> List[Dict[str, str]]:\n    \"\"\"Keep only findings scoped to a settings-FILE layer (drop env/disk).\n\n    H2 block-scopes the file surfaces a ConfigChange event represents; the\n    process-``env`` snapshot and the on-disk hook census are S3's boot\n    surfaces, not a settings-file change, so census/env findings are\n    OBSERVE-ONLY here — never block-worthy.\n    \"\"\"\n    out: List[Dict[str, str]] = []\n    for finding in findings:\n        if not isinstance(finding, dict):\n            continue\n        layer = finding.get(\"layer\")\n        if layer in _NON_FILE_LAYERS:\n            continue\n        out.append(finding)\n    return out\n\n\ndef _classify(cwd: str) -> List[Dict[str, str]]:\n    \"\"\"Resolve + classify; never raises (resolver is fail-open by contract).\"\"\"\n    if not _EFF_AVAILABLE or _eff is None:\n        _breadcrumb(\"effective_config unavailable — degraded to allow (no scan)\")\n        return []\n    try:\n        resolved = _eff.resolve_settings(cwd)\n        # classify_tampering(resolved, None) consults the IMPORT-TIME env\n        # snapshot (trusted_env pattern), NEVER live os.environ — a late-set\n        # value injected mid-session cannot dodge the scan. We then filter\n        # env/disk findings out of the BLOCK path below.\n        return _eff.classify_tampering(resolved)\n    except Exception as exc:  # pragma: no cover — resolver already fails open\n        _breadcrumb(\"classify failed (%s) — degraded to allow\" % type(exc).__name__)\n        return []\n\n\ndef _emit_observed(layer: str, session_id: str, project: str) -> None:\n    \"\"\"Audit the benign ALLOW path (one emit). Deny-by-default scrub branch.\n\n    No public typed wrapper (settings_tamper_detected precedent) — emit via\n    emit_generic, which routes config_change_observed through its dedicated\n    _scrub_ branch + _CONFIG_CHANGE_OBSERVED_ALLOWLIST. The ONLY caller field\n    is the closed-enum ``layer``; the changed file's path/body and any\n    settings value are NEVER passed.\n    \"\"\"\n    if not _AUDIT_AVAILABLE or _audit_emit is None:\n        return\n    try:\n        _audit_emit.emit_generic(\n            \"config_change_observed\",\n            layer=_coerce_layer(layer),\n            session_id=session_id,\n            project=project,\n        )\n    except Exception as exc:  # pragma: no cover — emit never blocks the hook\n        _breadcrumb(\"emit config_change_observed failed: %s\" % type(exc).__name__)\n\n\ndef _emit_forbidden_key(\n    tamper_class: str,\n    layer: str,\n    finding_count: int,\n    session_id: str,\n    project: str,\n) -> None:\n    \"\"\"Audit one forbidden-key tamper class on the BLOCK path.\n\n    ONE emit per (tamper_class) on the changed layer. Caller fields are the\n    closed-enum ``tamper_class`` + ``layer`` + the integer ``finding_count``;\n    the forbidden key's VALUE and the effective_config finding DETAIL are\n    NEVER passed (the _scrub_ branch + allowlist would drop them anyway —\n    belt and braces, the producer simply never sends them).\n    \"\"\"\n    if not _AUDIT_AVAILABLE or _audit_emit is None:\n        return\n    try:\n        _audit_emit.emit_generic(\n            \"config_change_forbidden_key\",\n            tamper_class=str(tamper_class),\n            layer=_coerce_layer(layer),\n            finding_count=int(finding_count),\n            session_id=session_id,\n            project=project,\n        )\n    except Exception as exc:  # pragma: no cover\n        _breadcrumb(\"emit config_change_forbidden_key failed: %s\" % type(exc).__name__)\n\n\ndef _block_reason(forbidden: List[Dict[str, str]]) -> str:\n    \"\"\"Build the advisory-block reason.\n\n    Names the tamper CLASS and the LAYER only — never the finding ``detail``\n    (an attacker endpoint URL / off-allowlist model id / apiKeyHelper path /\n    dangerously-flag value lives there; it is NEVER rendered into a\n    decision-channel string the operator's terminal echoes).\n    \"\"\"\n    pairs = sorted({(f.get(\"class\", \"other\"), f.get(\"layer\", \"other\")) for f in forbidden})\n    listed = \"; \".join(\"%s @ %s\" % (cls, layer) for cls, layer in pairs[:8])\n    return (\n        \"CONFIG-TAMPER: an out-of-band settings change introduced a forbidden \"\n        \"key (S197 class). Forbidden-key tamper detected: %s. Review the \"\n        \"settings layer named above and revert if you did not intend it; this \"\n        \"is advisory — your edit is recorded but NOT auto-reverted. Coverage \"\n        \"boundary: this guard is itself a hook (disarmed by disableAllHooks \"\n        \"and blind to outside-harness edits); the /ceo-boot tripwires re-scan \"\n        \"on the next boot.\" % (listed or \"unclassified\")\n    )[:_REASON_CAP]\n\n\ndef gate(hook_input: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Pure decision function.\n\n    Returns ``{}`` (allow) on every benign / infra path, or\n    ``{\"decision\": \"block\", \"reason\": ...}`` ONLY when a forbidden-key\n    finding is scoped to a settings-file layer. Never raises.\n    \"\"\"\n    if _disabled():\n        return {}\n    cwd = _resolve_cwd(hook_input)\n    session_id = \"\"\n    sid = hook_input.get(\"session_id\")\n    if isinstance(sid, str):\n        session_id = sid[:64]\n    project = \"\"\n    proj = hook_input.get(\"project\")\n    if isinstance(proj, str):\n        project = proj[:128]\n\n    findings = _settings_surface_findings(_classify(cwd))\n\n    # Partition: forbidden-key findings on a block-scope settings layer\n    # (FORBIDDEN_KEYS hits — every classify_tampering finding IS a\n    # FORBIDDEN_KEYS hit by construction) vs. nothing-to-block.\n    forbidden = [\n        f for f in findings\n        if isinstance(f, dict) and f.get(\"layer\") in _BLOCK_SCOPE_LAYERS\n    ]\n\n    if not forbidden:\n        # Benign change (or only env/disk findings, which are S3's surface):\n        # audit one observed event. Layer is best-effort from the highest-\n        # precedence settings layer that exists; default \"other\".\n        _emit_observed(_observed_layer(cwd), session_id, project)\n        return {}\n\n    # ADVISORY-BLOCK path: one audit emit per (tamper_class, layer) pair,\n    # then return a block decision. NEVER degrade a would-be block into a\n    # silent allow on a partial result (the resolver is fail-open; a real\n    # forbidden finding here is authoritative).\n    emitted = set()\n    for finding in forbidden:\n        cls = finding.get(\"class\", \"other\")\n        layer = finding.get(\"layer\", \"other\")\n        key = (cls, layer)\n        if key in emitted:\n            continue\n        emitted.add(key)\n        count = sum(\n            1 for f in forbidden\n            if f.get(\"class\") == cls and f.get(\"layer\") == layer\n        )\n        _emit_forbidden_key(cls, layer, count, session_id, project)\n    return {\"decision\": \"block\", \"reason\": _block_reason(forbidden)}\n\n","numLines":200,"startLine":100,"totalLines":347}},"tool_result_meta":[{"id":"toolu_01SGZ9eowNF5ZrMwLo87iVSz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
