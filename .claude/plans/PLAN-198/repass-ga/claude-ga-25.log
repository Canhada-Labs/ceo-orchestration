{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MvviJ3QXyzxNGFGdYRzuAJ","type":"tool_result","content":"1\t\"\"\"Additional audit-query reports.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport csv\n7\timport io\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\tfrom collections import Counter, defaultdict\n13\tfrom datetime import datetime, timedelta, timezone\n14\tfrom pathlib import Path\n15\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n16\t\n17\tdef cmd_health(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n18\t    \"\"\"High-level framework health. Sprint 5 A.2.\n19\t\n20\t    Rolls up several gates into an overall PASS/WARN/FAIL verdict so\n21\t    `audit-dashboard.py` and ops tooling have one call to make.\n22\t    \"\"\"\n23\t    total = len(entries)\n24\t    if total == 0:\n25\t        return {\"verdict\": \"NO_DATA\", \"total_events\": 0, \"gates\": {}}\n26\t\n27\t    compliance = cmd_compliance(entries, args)\n28\t    metrics = cmd_metrics(entries, args)\n29\t\n30\t    gates: Dict[str, str] = {}\n31\t\n32\t    # Gate 1: compliance rate >= 0.95\n33\t    known_rate = compliance.get(\"known_skill_rate\")\n34\t    if known_rate is None:\n35\t        gates[\"compliance\"] = \"NO_DATA\"\n36\t    elif known_rate >= 0.95:\n37\t        gates[\"compliance\"] = \"PASS\"\n38\t    elif known_rate >= 0.8:\n39\t        gates[\"compliance\"] = \"WARN\"\n40\t    else:\n41\t        gates[\"compliance\"] = \"FAIL\"\n42\t\n43\t    # Gate 2: veto rate < 0.15\n44\t    veto_rate = metrics.get(\"veto_rate\")\n45\t    if veto_rate is None:\n46\t        gates[\"vetoes\"] = \"NO_DATA\"\n47\t    elif veto_rate < 0.05:\n48\t        gates[\"vetoes\"] = \"PASS\"\n49\t    elif veto_rate < 0.15:\n50\t        gates[\"vetoes\"] = \"WARN\"\n51\t    else:\n52\t        gates[\"vetoes\"] = \"FAIL\"\n53\t\n54\t    # Gate 3: debate completion rate >= 0.8 (if any rounds started)\n55\t    dc = metrics.get(\"debate_completion_rate\")\n56\t    if dc is None:\n57\t        gates[\"debate_completion\"] = \"NO_DATA\"\n58\t    elif dc >= 0.8:\n59\t        gates[\"debate_completion\"] = \"PASS\"\n60\t    elif dc >= 0.5:\n61\t        gates[\"debate_completion\"] = \"WARN\"\n62\t    else:\n63\t        gates[\"debate_completion\"] = \"FAIL\"\n64\t\n65\t    # Verdict reduction\n66\t    if any(v == \"FAIL\" for v in gates.values()):\n67\t        verdict = \"FAIL\"\n68\t    elif any(v == \"WARN\" for v in gates.values()):\n69\t        verdict = \"WARN\"\n70\t    elif all(v in (\"PASS\", \"NO_DATA\") for v in gates.values()):\n71\t        verdict = \"PASS\"\n72\t    else:\n73\t        verdict = \"WARN\"\n74\t\n75\t    return {\n76\t        \"verdict\": verdict,\n77\t        \"total_events\": total,\n78\t        \"gates\": gates,\n79\t        \"known_skill_rate\": known_rate,\n80\t        \"veto_rate\": veto_rate,\n81\t        \"debate_completion_rate\": dc,\n82\t        \"action_counts\": metrics.get(\"action_counts\", {}),\n83\t    }\n84\t\n85\t\n86\tdef cmd_export(entries: List[Dict[str, Any]], args) -> Any:\n87\t    \"\"\"Handle the `audit-query export` sub-command — emit filtered audit-log slices.\"\"\"\n88\t    fmt = args.export_format\n89\t    if fmt == \"json\":\n90\t        return entries\n91\t    if fmt == \"csv\":\n92\t        buf = io.StringIO()\n93\t        if not entries:\n94\t            return \"\"\n95\t        fieldnames = sorted({k for e in entries for k in e.keys()})\n96\t        writer = csv.DictWriter(buf, fieldnames=fieldnames, extrasaction=\"ignore\")\n97\t        writer.writeheader()\n98\t        for e in entries:\n99\t            writer.writerow(e)\n100\t        return buf.getvalue()\n101\t    if fmt == \"tsv\":\n102\t        buf = io.StringIO()\n103\t        if not entries:\n104\t            return \"\"\n105\t        fieldnames = sorted({k for e in entries for k in e.keys()})\n106\t        writer = csv.DictWriter(\n107\t            buf, fieldnames=fieldnames, extrasaction=\"ignore\", delimiter=\"\\t\"\n108\t        )\n109\t        writer.writeheader()\n110\t        for e in entries:\n111\t            writer.writerow(e)\n112\t        return buf.getvalue()\n113\t    raise ValueError(f\"unsupported export format: {fmt}\")\n114\t"}]},"parent_tool_use_id":null,"session_id":"686fe0c6-c9dd-4361-bad4-fda29b25a7f7","uuid":"8b7a06e6-518f-4402-a23d-98ad664dbc56","timestamp":"2026-11-16T19:39:22.702Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_query/reporting_health.py","content":"\"\"\"Additional audit-query reports.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport io\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n\ndef cmd_health(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n    \"\"\"High-level framework health. Sprint 5 A.2.\n\n    Rolls up several gates into an overall PASS/WARN/FAIL verdict so\n    `audit-dashboard.py` and ops tooling have one call to make.\n    \"\"\"\n    total = len(entries)\n    if total == 0:\n        return {\"verdict\": \"NO_DATA\", \"total_events\": 0, \"gates\": {}}\n\n    compliance = cmd_compliance(entries, args)\n    metrics = cmd_metrics(entries, args)\n\n    gates: Dict[str, str] = {}\n\n    # Gate 1: compliance rate >= 0.95\n    known_rate = compliance.get(\"known_skill_rate\")\n    if known_rate is None:\n        gates[\"compliance\"] = \"NO_DATA\"\n    elif known_rate >= 0.95:\n        gates[\"compliance\"] = \"PASS\"\n    elif known_rate >= 0.8:\n        gates[\"compliance\"] = \"WARN\"\n    else:\n        gates[\"compliance\"] = \"FAIL\"\n\n    # Gate 2: veto rate < 0.15\n    veto_rate = metrics.get(\"veto_rate\")\n    if veto_rate is None:\n        gates[\"vetoes\"] = \"NO_DATA\"\n    elif veto_rate < 0.05:\n        gates[\"vetoes\"] = \"PASS\"\n    elif veto_rate < 0.15:\n        gates[\"vetoes\"] = \"WARN\"\n    else:\n        gates[\"vetoes\"] = \"FAIL\"\n\n    # Gate 3: debate completion rate >= 0.8 (if any rounds started)\n    dc = metrics.get(\"debate_completion_rate\")\n    if dc is None:\n        gates[\"debate_completion\"] = \"NO_DATA\"\n    elif dc >= 0.8:\n        gates[\"debate_completion\"] = \"PASS\"\n    elif dc >= 0.5:\n        gates[\"debate_completion\"] = \"WARN\"\n    else:\n        gates[\"debate_completion\"] = \"FAIL\"\n\n    # Verdict reduction\n    if any(v == \"FAIL\" for v in gates.values()):\n        verdict = \"FAIL\"\n    elif any(v == \"WARN\" for v in gates.values()):\n        verdict = \"WARN\"\n    elif all(v in (\"PASS\", \"NO_DATA\") for v in gates.values()):\n        verdict = \"PASS\"\n    else:\n        verdict = \"WARN\"\n\n    return {\n        \"verdict\": verdict,\n        \"total_events\": total,\n        \"gates\": gates,\n        \"known_skill_rate\": known_rate,\n        \"veto_rate\": veto_rate,\n        \"debate_completion_rate\": dc,\n        \"action_counts\": metrics.get(\"action_counts\", {}),\n    }\n\n\ndef cmd_export(entries: List[Dict[str, Any]], args) -> Any:\n    \"\"\"Handle the `audit-query export` sub-command — emit filtered audit-log slices.\"\"\"\n    fmt = args.export_format\n    if fmt == \"json\":\n        return entries\n    if fmt == \"csv\":\n        buf = io.StringIO()\n        if not entries:\n            return \"\"\n        fieldnames = sorted({k for e in entries for k in e.keys()})\n        writer = csv.DictWriter(buf, fieldnames=fieldnames, extrasaction=\"ignore\")\n        writer.writeheader()\n        for e in entries:\n            writer.writerow(e)\n        return buf.getvalue()\n    if fmt == \"tsv\":\n        buf = io.StringIO()\n        if not entries:\n            return \"\"\n        fieldnames = sorted({k for e in entries for k in e.keys()})\n        writer = csv.DictWriter(\n            buf, fieldnames=fieldnames, extrasaction=\"ignore\", delimiter=\"\\t\"\n        )\n        writer.writeheader()\n        for e in entries:\n            writer.writerow(e)\n        return buf.getvalue()\n    raise ValueError(f\"unsupported export format: {fmt}\")\n","numLines":114,"startLine":1,"totalLines":114}},"tool_result_meta":[{"id":"toolu_01MvviJ3QXyzxNGFGdYRzuAJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7B2V3Vg4mpf1GmAKm9s","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MTtx5WprDDPBHaCDcNzKEJ","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_query/domain.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12533,"cache_read_input_tokens":131795,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12533},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"686fe0c6-c9dd-4361-bad4-fda29b25a7f7","uuid":"58b164d1-f323-42a1-ae8e-11f2964c1e23","timestamp":"2026-11-16T19:39:26.968Z","request_id":"req_011Ch7B2Ui9abK4fSrf8ARkU","wire_tool_inputs":{"toolu_01MTtx5WprDDPBHaCDcNzKEJ":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_query/domain.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MTtx5WprDDPBHaCDcNzKEJ","type":"tool_result","content":"1\t\"\"\"domain audit-query declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport csv\n7\timport io\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\tfrom collections import Counter, defaultdict\n13\tfrom datetime import datetime, timedelta, timezone\n14\tfrom pathlib import Path\n15\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n16\t\n17\t__all__ = ('_BY_DOMAIN_DEFAULT_WINDOW_DAYS', '_UNKNOWN_BUCKET', '_GRANDFATHER_POLICY_RELPATH', '_parse_domain_date', '_resolve_window_bounds', '_load_sunset_domains', '_parse_sunset_from_policy', '_load_sunset_reopen_options', '_parse_sunset_reopen_flags', '_entry_ts_to_dt', 'cmd_by_domain')\n18\t\n19\t_BY_DOMAIN_DEFAULT_WINDOW_DAYS = 30\n20\t\n21\t# Sentinel used when no dispatch_archetype_hint is available\n22\t_UNKNOWN_BUCKET = \"UNKNOWN\"\n23\t\n24\t# Default policy file location (relative to repo root, resolved at runtime)\n25\t_GRANDFATHER_POLICY_RELPATH = \".claude/policies/grandfather-cap.policy.yaml\"\n26\t\n27\t\n28\tdef _parse_domain_date(raw: str) -> Optional[datetime]:\n29\t    \"\"\"Parse YYYY-MM-DD into a UTC-aware datetime (midnight UTC).\n30\t\n31\t    Returns None on failure (not sys.exit — caller handles the error).\n32\t    \"\"\"\n33\t    try:\n34\t        dt = datetime.strptime(raw.strip(), \"%Y-%m-%d\")\n35\t        return dt.replace(tzinfo=timezone.utc)\n36\t    except ValueError:\n37\t        return None\n38\t\n39\t\n40\tdef _resolve_window_bounds(\n41\t    args,\n42\t) -> Tuple[Optional[datetime], Optional[datetime], str]:\n43\t    \"\"\"Resolve --window / --start / --end into (start_dt, end_dt, window_label).\n44\t\n45\t    Returns (start_dt, end_dt, label) where:\n46\t      - start_dt: inclusive lower bound (UTC midnight); None means no lower bound\n47\t      - end_dt:   inclusive upper bound (UTC now for default windows)\n48\t      - label:    human-readable description of the window\n49\t\n50\t    Validates start <= end; prints error + sys.exit(1) on invalid input.\n51\t    \"\"\"\n52\t    now = datetime.now(timezone.utc)\n53\t    # --start / --end take precedence over --window\n54\t    start_raw = getattr(args, \"start\", None)\n55\t    end_raw = getattr(args, \"end\", None)\n56\t    window_raw = getattr(args, \"window\", None) or f\"{_BY_DOMAIN_DEFAULT_WINDOW_DAYS}d\"\n57\t\n58\t    if start_raw or end_raw:\n59\t        if not start_raw or not end_raw:\n60\t            print(\n61\t                \"[audit-query] ERROR: by-domain: --start and --end must both be provided\",\n62\t                file=sys.stderr,\n63\t            )\n64\t            sys.exit(1)\n65\t        start_dt = _parse_domain_date(start_raw)\n66\t        end_dt = _parse_domain_date(end_raw)\n67\t        if start_dt is None:\n68\t            print(\n69\t                f\"[audit-query] ERROR: by-domain: invalid --start date {start_raw!r} \"\n70\t                \"(use YYYY-MM-DD)\",\n71\t                file=sys.stderr,\n72\t            )\n73\t            sys.exit(1)\n74\t        if end_dt is None:\n75\t            print(\n76\t                f\"[audit-query] ERROR: by-domain: invalid --end date {end_raw!r} \"\n77\t                \"(use YYYY-MM-DD)\",\n78\t                file=sys.stderr,\n79\t            )\n80\t            sys.exit(1)\n81\t        # Make end_dt the end of that calendar day (23:59:59 UTC)\n82\t        end_dt = end_dt.replace(hour=23, minute=59, second=59)\n83\t        if start_dt > end_dt:\n84\t            print(\n85\t                f\"[audit-query] ERROR: by-domain: --start ({start_raw}) is after \"\n86\t                f\"--end ({end_raw})\",\n87\t                file=sys.stderr,\n88\t            )\n89\t            sys.exit(1)\n90\t        label = f\"{start_raw} to {end_raw}\"\n91\t        return start_dt, end_dt, label\n92\t\n93\t    # Parse --window (e.g. \"30d\", \"7d\")\n94\t    m = re.fullmatch(r\"(\\d+)([dhm])\", window_raw.strip().lower())\n95\t    if not m:\n96\t        print(\n97\t            f\"[audit-query] ERROR: by-domain: invalid --window {window_raw!r}; \"\n98\t            \"expected e.g. 30d, 7d, 14d\",\n99\t            file=sys.stderr,\n100\t        )\n101\t        sys.exit(1)\n102\t    n, unit = int(m.group(1)), m.group(2)\n103\t    delta = {\"d\": timedelta(days=n), \"h\": timedelta(hours=n), \"m\": timedelta(minutes=n)}[unit]\n104\t    start_dt = now - delta\n105\t    label = f\"trailing {window_raw}\"\n106\t    return start_dt, now, label\n107\t\n108\t\n109\tdef _load_sunset_domains(args) -> Optional[List[str]]:\n110\t    \"\"\"Load sunset domain list for --check-reopen.\n111\t\n112\t    Sources (in priority order):\n113\t    1. CEO_GRANDFATHER_POLICY_PATH env var\n114\t    2. <repo_root>/.claude/policies/grandfather-cap.policy.yaml (if exists)\n115\t    3. stdin JSON list (if CEO_BY_DOMAIN_SUNSET_STDIN=1)\n116\t\n117\t    Returns a list of domain slugs, or None if the policy file is not found\n118\t    and stdin mode is not active. An empty list [] means \"policy found but\n119\t    no sunset members\".\n120\t    \"\"\"\n121\t    # Check env override\n122\t    policy_path_env = os.environ.get(\"CEO_GRANDFATHER_POLICY_PATH\")\n123\t    if policy_path_env:\n124\t        p = Path(policy_path_env)\n125\t        if p.is_file():\n126\t            return _parse_sunset_from_policy(p)\n127\t        print(\n128\t            f\"[audit-query] WARN: CEO_GRANDFATHER_POLICY_PATH={policy_path_env!r} \"\n129\t            \"not found; no sunset list loaded\",\n130\t            file=sys.stderr,\n131\t        )\n132\t        return []\n133\t\n134\t    # Try conventional project-relative path via CLAUDE_PROJECT_DIR or cwd\n135\t    for base_env in (\"CLAUDE_PROJECT_DIR\",):\n136\t        base = os.environ.get(base_env)\n137\t        if base:\n138\t            p = Path(base) / _GRANDFATHER_POLICY_RELPATH\n139\t            if p.is_file():\n140\t                return _parse_sunset_from_policy(p)\n141\t\n142\t    # Try cwd-relative (developer convenience)\n143\t    p = Path(_GRANDFATHER_POLICY_RELPATH)\n144\t    if p.is_file():\n145\t        return _parse_sunset_from_policy(p)\n146\t\n147\t    # Stdin JSON fallback (CEO_BY_DOMAIN_SUNSET_STDIN=1 for testing)\n148\t    if os.environ.get(\"CEO_BY_DOMAIN_SUNSET_STDIN\") == \"1\":\n149\t        try:\n150\t            raw = sys.stdin.read()\n151\t            data = json.loads(raw)\n152\t            if isinstance(data, list):\n153\t                return [str(x) for x in data if x]\n154\t        except (json.JSONDecodeError, OSError):\n155\t            pass\n156\t        return []\n157\t\n158\t    return None  # policy not found — caller will skip reopen check\n159\t\n160\t\n161\tdef _parse_sunset_from_policy(path: Path) -> List[str]:\n162\t    \"\"\"Extract sunset domain members from grandfather-cap.policy.yaml.\n163\t\n164\t    Parses the YAML manually using stdlib (no PyYAML dependency).\n165\t    Looks for `domain_bundles.members:` list block.\n166\t\n167\t    Returns list of domain slug strings (may be empty).\n168\t    \"\"\"\n169\t    try:\n170\t        text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n171\t    except OSError:\n172\t        return []\n173\t\n174\t    # Simple line-based YAML parser for the members list.\n175\t    # We scan for \"members:\" under \"domain_bundles:\" section.\n176\t    in_domain_bundles = False\n177\t    in_members = False\n178\t    members: List[str] = []\n179\t\n180\t    for line in text.splitlines():\n181\t        stripped = line.strip()\n182\t        if stripped.startswith(\"#\"):\n183\t            continue\n184\t        if stripped == \"domain_bundles:\":\n185\t            in_domain_bundles = True\n186\t            in_members = False\n187\t            continue\n188\t        if in_domain_bundles:\n189\t            # Another top-level key → leave domain_bundles section\n190\t            if stripped and not line.startswith(\" \") and not line.startswith(\"\\t\"):\n191\t                in_domain_bundles = False\n192\t                in_members = False\n193\t                continue\n194\t            if stripped == \"members:\":\n195\t                in_members = True\n196\t                continue\n197\t            if in_members:\n198\t                if stripped.startswith(\"- \"):\n199\t                    member = stripped[2:].strip()\n200\t                    if member:\n201\t                        members.append(member)\n202\t                elif stripped and not stripped.startswith(\"-\"):\n203\t                    # End of list\n204\t                    in_members = False\n205\t\n206\t    return members\n207\t\n208\t\n209\tdef _load_sunset_reopen_options(args) -> Optional[Dict[str, bool]]:\n210\t    \"\"\"M2-CDX-4 + M2-CDX-7 (Codex Phase 1 iter 1) — load reopen filter flags.\n211\t\n212\t    Returns dict with `requires_hint_match` and `unknown_excluded` boolean\n213\t    flags read from the same grandfather-cap.policy.yaml as\n214\t    `_load_sunset_domains`. Defaults to {True, True} if either flag is\n215\t    missing/unparseable. Returns None if the policy file is not found.\n216\t    \"\"\"\n217\t    # Reuse the same path resolution as _load_sunset_domains for consistency\n218\t    policy_path_env = os.environ.get(\"CEO_GRANDFATHER_POLICY_PATH\")\n219\t    candidates: List[Path] = []\n220\t    if policy_path_env:\n221\t        candidates.append(Path(policy_path_env))\n222\t    base = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n223\t    if base:\n224\t        candidates.append(Path(base) / _GRANDFATHER_POLICY_RELPATH)\n225\t    candidates.append(Path(_GRANDFATHER_POLICY_RELPATH))\n226\t\n227\t    for p in candidates:\n228\t        if not p.is_file():\n229\t            continue\n230\t        try:\n231\t            text = p.read_text(encoding=\"utf-8\", errors=\"replace\")\n232\t        except OSError:\n233\t            continue\n234\t        return _parse_sunset_reopen_flags(text)\n235\t    return None\n236\t\n237\t\n238\tdef _parse_sunset_reopen_flags(text: str) -> Dict[str, bool]:\n239\t    \"\"\"Parse `sunset_reopen_requires_hint_match` and `sunset_reopen_unknown_excluded`.\n240\t\n241\t    Both flags default to True if missing (defensive — secure-by-default).\n242\t    \"\"\"\n243\t    requires_hint_match = True\n244\t    unknown_excluded = True\n245\t    for line in text.splitlines():\n246\t        s = line.strip()\n247\t        if s.startswith(\"#\"):\n248\t            continue\n249\t        if s.startswith(\"sunset_reopen_requires_hint_match:\"):\n250\t            v = s.split(\":\", 1)[1].strip().lower()\n251\t            requires_hint_match = (v == \"true\" or v.startswith(\"true\"))\n252\t        elif s.startswith(\"sunset_reopen_unknown_excluded:\"):\n253\t            v = s.split(\":\", 1)[1].strip().lower()\n254\t            unknown_excluded = (v == \"true\" or v.startswith(\"true\"))\n255\t    return {\n256\t        \"requires_hint_match\": requires_hint_match,\n257\t        \"unknown_excluded\": unknown_excluded,\n258\t    }\n259\t\n260\t\n261\tdef _entry_ts_to_dt(ts: str) -> Optional[datetime]:\n262\t    \"\"\"Parse a log entry `ts` field into a UTC datetime.\"\"\"\n263\t    if not ts:\n264\t        return None\n265\t    try:\n266\t        s = ts[:-1] + \"+00:00\" if ts.endswith(\"Z\") else ts\n267\t        dt = datetime.fromisoformat(s)\n268\t        return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)\n269\t    except ValueError:\n270\t        return None\n271\t\n272\t\n273\tdef cmd_by_domain(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n274\t    \"\"\"`audit-query by-domain` — spawn activity grouped by dispatch_archetype_hint.\n275\t\n276\t    PLAN-080 Phase 1 — domain-level observability for squad-bundle governance.\n277\t\n278\t    Groups `agent_spawn` events by `dispatch_archetype_hint` field if present;\n279\t    falls back to `archetype` field, then to the \"UNKNOWN\" bucket. Entries\n280\t    outside the requested time window are excluded.\n281\t\n282\t    Output columns:\n283\t      Domain | Spawns | First seen | Last seen | hint_coverage_pct\n284\t\n285\t    Sorted deterministically by domain name (alphabetic, UNKNOWN last).\n286\t\n287\t    With --check-reopen: additionally filters to domains present in the sunset\n288\t    list from grandfather-cap.policy.yaml. Reports domains with >= 1 spawn\n289\t    where hint matches a sunset domain (UNKNOWN excluded per M2-CDX-7).\n290\t    \"\"\"\n291\t    start_dt, end_dt, window_label = _resolve_window_bounds(args)\n292\t\n293\t    # Load sunset list + reopen options if --check-reopen requested\n294\t    check_reopen = getattr(args, \"check_reopen\", False)\n295\t    sunset_domains: Optional[List[str]] = None\n296\t    # M2-CDX-4 + M2-CDX-7 (Codex Phase 1 iter 1): honor policy flags.\n297\t    # Defaults match policy semantics when flags missing/unparseable.\n298\t    requires_hint_match = True       # sunset_reopen_requires_hint_match (default true per §8)\n299\t    unknown_excluded = True          # sunset_reopen_unknown_excluded (M2-CDX-7 default true)\n300\t    if check_reopen:\n301\t        sunset_domains = _load_sunset_domains(args)\n302\t        sunset_options = _load_sunset_reopen_options(args)\n303\t        if sunset_options is not None:\n304\t            requires_hint_match = sunset_options.get(\"requires_hint_match\", True)\n305\t            unknown_excluded = sunset_options.get(\"unknown_excluded\", True)\n306\t        if sunset_domains is None:\n307\t            print(\n308\t                \"[audit-query] WARN: by-domain --check-reopen: no sunset policy file \"\n309\t                \"found; skipping reopen filter. Set CEO_GRANDFATHER_POLICY_PATH or \"\n310\t                \"place grandfather-cap.policy.yaml at \"\n311\t                f\"{_GRANDFATHER_POLICY_RELPATH}\",\n312\t                file=sys.stderr,\n313\t            )\n314\t\n315\t    # Aggregation state per domain bucket\n316\t    # domain → {spawns, first_ts, last_ts, with_hint, total}\n317\t    domain_agg: Dict[str, Dict[str, Any]] = {}\n318\t\n319\t    total_in_window = 0\n320\t    total_with_hint = 0\n321\t\n322\t    for e in entries:\n323\t        if e.get(\"action\") != \"agent_spawn\":\n324\t            continue\n325\t\n326\t        ts_raw = e.get(\"ts\", \"\")\n327\t        entry_dt = _entry_ts_to_dt(ts_raw)\n328\t\n329\t        # Apply window filter\n330\t        if start_dt is not None and entry_dt is not None:\n331\t            if entry_dt < start_dt:\n332\t                continue\n333\t        if end_dt is not None and entry_dt is not None:\n334\t            if entry_dt > end_dt:\n335\t                continue\n336\t\n337\t        total_in_window += 1\n338\t\n339\t        # Determine domain bucket\n340\t        hint = e.get(\"dispatch_archetype_hint\")\n341\t        if hint and isinstance(hint, str) and hint.strip():\n342\t            domain = hint.strip()\n343\t            has_hint = True\n344\t            total_with_hint += 1\n345\t        else:\n346\t            # Fallback: archetype field\n347\t            arch = e.get(\"archetype\")\n348\t            if arch and isinstance(arch, str) and arch.strip():\n349\t                domain = arch.strip()\n350\t            else:\n351\t                domain = _UNKNOWN_BUCKET\n352\t            has_hint = False\n353\t\n354\t        bucket = domain_agg.setdefault(\n355\t            domain,\n356\t            {\n357\t                \"spawns\": 0,\n358\t                \"first_ts\": ts_raw or \"\",\n359\t                \"last_ts\": ts_raw or \"\",\n360\t                \"with_hint\": 0,\n361\t                \"total\": 0,\n362\t            },\n363\t        )\n364\t        bucket[\"spawns\"] += 1\n365\t        bucket[\"total\"] += 1\n366\t        if has_hint:\n367\t            bucket[\"with_hint\"] += 1\n368\t        if ts_raw:\n369\t            if not bucket[\"first_ts\"] or ts_raw < bucket[\"first_ts\"]:\n370\t                bucket[\"first_ts\"] = ts_raw\n371\t            if ts_raw > bucket[\"last_ts\"]:\n372\t                bucket[\"last_ts\"] = ts_raw\n373\t\n374\t    # Build output rows\n375\t    rows: List[Dict[str, Any]] = []\n376\t    for domain in sorted(domain_agg.keys(), key=lambda d: (\"\" if d != _UNKNOWN_BUCKET else \"\\xff\") + d):\n377\t        b = domain_agg[domain]\n378\t        hint_pct = round(b[\"with_hint\"] / b[\"total\"] * 100, 1) if b[\"total\"] > 0 else 0.0\n379\t        row: Dict[str, Any] = {\n380\t            \"domain\": domain,\n381\t            \"spawns\": b[\"spawns\"],\n382\t            \"first_seen\": b[\"first_ts\"][:10] if b[\"first_ts\"] else \"\",\n383\t            \"last_seen\": b[\"last_ts\"][:10] if b[\"last_ts\"] else \"\",\n384\t            \"hint_coverage_pct\": hint_pct,\n385\t        }\n386\t        rows.append(row)\n387\t\n388\t    # Apply --check-reopen filter\n389\t    # M2-CDX-7: UNKNOWN excluded when sunset_reopen_unknown_excluded=true (default)\n390\t    # M2-CDX-4: When sunset_reopen_requires_hint_match=true (default), only\n391\t    #   spawns whose ORIGINAL audit row carried `dispatch_archetype_hint`\n392\t    #   (has_hint=True) qualify for reopen. archetype-fallback rows do not\n393\t    #   trigger reopen (per PLAN-080 §8: \"spawn carries dispatch_archetype_hint\n394\t    #   matching the sunset domain's archetype set\").\n395\t    if check_reopen and sunset_domains is not None:\n396\t        sunset_set = set(sunset_domains)\n397\t        reopen_rows = []\n398\t        for r in rows:\n399\t            if unknown_excluded and r[\"domain\"] == _UNKNOWN_BUCKET:\n400\t                continue\n401\t            if r[\"domain\"] not in sunset_set:\n402\t                continue\n403\t            if r[\"spawns\"] < 1:\n404\t                continue\n405\t            if requires_hint_match:\n406\t                # Reopen requires at least one hint-source spawn matching this\n407\t                # sunset domain. Use the per-bucket `with_hint` count from the\n408\t                # aggregation — bucket[\"with_hint\"] tracks how many spawns in\n409\t                # this domain bucket arrived with dispatch_archetype_hint set.\n410\t                bucket = domain_agg.get(r[\"domain\"], {})\n411\t                if int(bucket.get(\"with_hint\", 0)) < 1:\n412\t                    continue\n413\t            reopen_rows.append(r)\n414\t    else:\n415\t        reopen_rows = []\n416\t\n417\t    # Build markdown table\n418\t    def _md_table(table_rows: List[Dict[str, Any]]) -> str:\n419\t        if not table_rows:\n420\t            return \"| Domain | Spawns | First seen | Last seen | hint_coverage_pct |\\n\" \\\n421\t                   \"| ------ | ------ | ---------- | --------- | ----------------- |\\n\" \\\n422\t                   \"| (no results) | - | - | - | - |\\n\"\n423\t        lines = [\n424\t            \"| Domain | Spawns | First seen | Last seen | hint_coverage_pct |\",\n425\t            \"| ------ | ------ | ---------- | --------- | ----------------- |\",\n426\t        ]\n427\t        for r in table_rows:\n428\t            lines.append(\n429\t                f\"| {r['domain']} | {r['spawns']} | {r['first_seen']} \"\n430\t                f\"| {r['last_seen']} | {r['hint_coverage_pct']}% |\"\n431\t            )\n432\t        return \"\\n\".join(lines) + \"\\n\"\n433\t\n434\t    output: Dict[str, Any] = {\n435\t        \"query\": \"by-domain\",\n436\t        \"version\": \"1\",\n437\t        \"window\": window_label,\n438\t        \"total_spawns_in_window\": total_in_window,\n439\t        \"overall_hint_coverage_pct\": (\n440\t            round(total_with_hint / total_in_window * 100, 1)\n441\t            if total_in_window > 0\n442\t            else 0.0\n443\t        ),\n444\t        \"domain_count\": len(rows),\n445\t        \"domains\": rows,\n446\t        \"markdown_table\": _md_table(rows),\n447\t    }\n448\t\n449\t    if check_reopen:\n450\t        output[\"check_reopen\"] = {\n451\t            \"sunset_domains_loaded\": len(sunset_domains) if sunset_domains is not None else 0,\n452\t            \"reopen_candidates\": reopen_rows,\n453\t            \"reopen_count\": len(reopen_rows),\n454\t            \"note\": (\n455\t                \"Domains from sunset list with >= 1 spawn in window. \"\n456\t                \"UNKNOWN bucket excluded per M2-CDX-7.\"\n457\t            ),\n458\t        }\n459\t\n460\t    return output\n461\t\n462\t\n463\t# ---------------------------------------------------------------------------\n464\t# Output formatting\n465\t# ---------------------------------------------------------------------------\n466\t\n467\t\n468\t"}]},"parent_tool_use_id":null,"session_id":"686fe0c6-c9dd-4361-bad4-fda29b25a7f7","uuid":"ae2bc1be-aae5-4662-a4b1-9243507c0fd2","timestamp":"2026-11-16T19:39:26.982Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_query/domain.py","content":"\"\"\"domain audit-query declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport io\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n\n__all__ = ('_BY_DOMAIN_DEFAULT_WINDOW_DAYS', '_UNKNOWN_BUCKET', '_GRANDFATHER_POLICY_RELPATH', '_parse_domain_date', '_resolve_window_bounds', '_load_sunset_domains', '_parse_sunset_from_policy', '_load_sunset_reopen_options', '_parse_sunset_reopen_flags', '_entry_ts_to_dt', 'cmd_by_domain')\n\n_BY_DOMAIN_DEFAULT_WINDOW_DAYS = 30\n\n# Sentinel used when no dispatch_archetype_hint is available\n_UNKNOWN_BUCKET = \"UNKNOWN\"\n\n# Default policy file location (relative to repo root, resolved at runtime)\n_GRANDFATHER_POLICY_RELPATH = \".claude/policies/grandfather-cap.policy.yaml\"\n\n\ndef _parse_domain_date(raw: str) -> Optional[datetime]:\n    \"\"\"Parse YYYY-MM-DD into a UTC-aware datetime (midnight UTC).\n\n    Returns None on failure (not sys.exit — caller handles the error).\n    \"\"\"\n    try:\n        dt = datetime.strptime(raw.strip(), \"%Y-%m-%d\")\n        return dt.replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n\n\ndef _resolve_window_bounds(\n    args,\n) -> Tuple[Optional[datetime], Optional[datetime], str]:\n    \"\"\"Resolve --window / --start / --end into (start_dt, end_dt, window_label).\n\n    Returns (start_dt, end_dt, label) where:\n      - start_dt: inclusive lower bound (UTC midnight); None means no lower bound\n      - end_dt:   inclusive upper bound (UTC now for default windows)\n      - label:    human-readable description of the window\n\n    Validates start <= end; prints error + sys.exit(1) on invalid input.\n    \"\"\"\n    now = datetime.now(timezone.utc)\n    # --start / --end take precedence over --window\n    start_raw = getattr(args, \"start\", None)\n    end_raw = getattr(args, \"end\", None)\n    window_raw = getattr(args, \"window\", None) or f\"{_BY_DOMAIN_DEFAULT_WINDOW_DAYS}d\"\n\n    if start_raw or end_raw:\n        if not start_raw or not end_raw:\n            print(\n                \"[audit-query] ERROR: by-domain: --start and --end must both be provided\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n        start_dt = _parse_domain_date(start_raw)\n        end_dt = _parse_domain_date(end_raw)\n        if start_dt is None:\n            print(\n                f\"[audit-query] ERROR: by-domain: invalid --start date {start_raw!r} \"\n                \"(use YYYY-MM-DD)\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n        if end_dt is None:\n            print(\n                f\"[audit-query] ERROR: by-domain: invalid --end date {end_raw!r} \"\n                \"(use YYYY-MM-DD)\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n        # Make end_dt the end of that calendar day (23:59:59 UTC)\n        end_dt = end_dt.replace(hour=23, minute=59, second=59)\n        if start_dt > end_dt:\n            print(\n                f\"[audit-query] ERROR: by-domain: --start ({start_raw}) is after \"\n                f\"--end ({end_raw})\",\n                file=sys.stderr,\n            )\n            sys.exit(1)\n        label = f\"{start_raw} to {end_raw}\"\n        return start_dt, end_dt, label\n\n    # Parse --window (e.g. \"30d\", \"7d\")\n    m = re.fullmatch(r\"(\\d+)([dhm])\", window_raw.strip().lower())\n    if not m:\n        print(\n            f\"[audit-query] ERROR: by-domain: invalid --window {window_raw!r}; \"\n            \"expected e.g. 30d, 7d, 14d\",\n            file=sys.stderr,\n        )\n        sys.exit(1)\n    n, unit = int(m.group(1)), m.group(2)\n    delta = {\"d\": timedelta(days=n), \"h\": timedelta(hours=n), \"m\": timedelta(minutes=n)}[unit]\n    start_dt = now - delta\n    label = f\"trailing {window_raw}\"\n    return start_dt, now, label\n\n\ndef _load_sunset_domains(args) -> Optional[List[str]]:\n    \"\"\"Load sunset domain list for --check-reopen.\n\n    Sources (in priority order):\n    1. CEO_GRANDFATHER_POLICY_PATH env var\n    2. <repo_root>/.claude/policies/grandfather-cap.policy.yaml (if exists)\n    3. stdin JSON list (if CEO_BY_DOMAIN_SUNSET_STDIN=1)\n\n    Returns a list of domain slugs, or None if the policy file is not found\n    and stdin mode is not active. An empty list [] means \"policy found but\n    no sunset members\".\n    \"\"\"\n    # Check env override\n    policy_path_env = os.environ.get(\"CEO_GRANDFATHER_POLICY_PATH\")\n    if policy_path_env:\n        p = Path(policy_path_env)\n        if p.is_file():\n            return _parse_sunset_from_policy(p)\n        print(\n            f\"[audit-query] WARN: CEO_GRANDFATHER_POLICY_PATH={policy_path_env!r} \"\n            \"not found; no sunset list loaded\",\n            file=sys.stderr,\n        )\n        return []\n\n    # Try conventional project-relative path via CLAUDE_PROJECT_DIR or cwd\n    for base_env in (\"CLAUDE_PROJECT_DIR\",):\n        base = os.environ.get(base_env)\n        if base:\n            p = Path(base) / _GRANDFATHER_POLICY_RELPATH\n            if p.is_file():\n                return _parse_sunset_from_policy(p)\n\n    # Try cwd-relative (developer convenience)\n    p = Path(_GRANDFATHER_POLICY_RELPATH)\n    if p.is_file():\n        return _parse_sunset_from_policy(p)\n\n    # Stdin JSON fallback (CEO_BY_DOMAIN_SUNSET_STDIN=1 for testing)\n    if os.environ.get(\"CEO_BY_DOMAIN_SUNSET_STDIN\") == \"1\":\n        try:\n            raw = sys.stdin.read()\n            data = json.loads(raw)\n            if isinstance(data, list):\n                return [str(x) for x in data if x]\n        except (json.JSONDecodeError, OSError):\n            pass\n        return []\n\n    return None  # policy not found — caller will skip reopen check\n\n\ndef _parse_sunset_from_policy(path: Path) -> List[str]:\n    \"\"\"Extract sunset domain members from grandfather-cap.policy.yaml.\n\n    Parses the YAML manually using stdlib (no PyYAML dependency).\n    Looks for `domain_bundles.members:` list block.\n\n    Returns list of domain slug strings (may be empty).\n    \"\"\"\n    try:\n        text = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n    except OSError:\n        return []\n\n    # Simple line-based YAML parser for the members list.\n    # We scan for \"members:\" under \"domain_bundles:\" section.\n    in_domain_bundles = False\n    in_members = False\n    members: List[str] = []\n\n    for line in text.splitlines():\n        stripped = line.strip()\n        if stripped.startswith(\"#\"):\n            continue\n        if stripped == \"domain_bundles:\":\n            in_domain_bundles = True\n            in_members = False\n            continue\n        if in_domain_bundles:\n            # Another top-level key → leave domain_bundles section\n            if stripped and not line.startswith(\" \") and not line.startswith(\"\\t\"):\n                in_domain_bundles = False\n                in_members = False\n                continue\n            if stripped == \"members:\":\n                in_members = True\n                continue\n            if in_members:\n                if stripped.startswith(\"- \"):\n                    member = stripped[2:].strip()\n                    if member:\n                        members.append(member)\n                elif stripped and not stripped.startswith(\"-\"):\n                    # End of list\n                    in_members = False\n\n    return members\n\n\ndef _load_sunset_reopen_options(args) -> Optional[Dict[str, bool]]:\n    \"\"\"M2-CDX-4 + M2-CDX-7 (Codex Phase 1 iter 1) — load reopen filter flags.\n\n    Returns dict with `requires_hint_match` and `unknown_excluded` boolean\n    flags read from the same grandfather-cap.policy.yaml as\n    `_load_sunset_domains`. Defaults to {True, True} if either flag is\n    missing/unparseable. Returns None if the policy file is not found.\n    \"\"\"\n    # Reuse the same path resolution as _load_sunset_domains for consistency\n    policy_path_env = os.environ.get(\"CEO_GRANDFATHER_POLICY_PATH\")\n    candidates: List[Path] = []\n    if policy_path_env:\n        candidates.append(Path(policy_path_env))\n    base = os.environ.get(\"CLAUDE_PROJECT_DIR\")\n    if base:\n        candidates.append(Path(base) / _GRANDFATHER_POLICY_RELPATH)\n    candidates.append(Path(_GRANDFATHER_POLICY_RELPATH))\n\n    for p in candidates:\n        if not p.is_file():\n            continue\n        try:\n            text = p.read_text(encoding=\"utf-8\", errors=\"replace\")\n        except OSError:\n            continue\n        return _parse_sunset_reopen_flags(text)\n    return None\n\n\ndef _parse_sunset_reopen_flags(text: str) -> Dict[str, bool]:\n    \"\"\"Parse `sunset_reopen_requires_hint_match` and `sunset_reopen_unknown_excluded`.\n\n    Both flags default to True if missing (defensive — secure-by-default).\n    \"\"\"\n    requires_hint_match = True\n    unknown_excluded = True\n    for line in text.splitlines():\n        s = line.strip()\n        if s.startswith(\"#\"):\n            continue\n        if s.startswith(\"sunset_reopen_requires_hint_match:\"):\n            v = s.split(\":\", 1)[1].strip().lower()\n            requires_hint_match = (v == \"true\" or v.startswith(\"true\"))\n        elif s.startswith(\"sunset_reopen_unknown_excluded:\"):\n            v = s.split(\":\", 1)[1].strip().lower()\n            unknown_excluded = (v == \"true\" or v.startswith(\"true\"))\n    return {\n        \"requires_hint_match\": requires_hint_match,\n        \"unknown_excluded\": unknown_excluded,\n    }\n\n\ndef _entry_ts_to_dt(ts: str) -> Optional[datetime]:\n    \"\"\"Parse a log entry `ts` field into a UTC datetime.\"\"\"\n    if not ts:\n        return None\n    try:\n        s = ts[:-1] + \"+00:00\" if ts.endswith(\"Z\") else ts\n        dt = datetime.fromisoformat(s)\n        return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n\n\ndef cmd_by_domain(entries: List[Dict[str, Any]], args) -> Dict[str, Any]:\n    \"\"\"`audit-query by-domain` — spawn activity grouped by dispatch_archetype_hint.\n\n    PLAN-080 Phase 1 — domain-level observability for squad-bundle governance.\n\n    Groups `agent_spawn` events by `dispatch_archetype_hint` field if present;\n    falls back to `archetype` field, then to the \"UNKNOWN\" bucket. Entries\n    outside the requested time window are excluded.\n\n    Output columns:\n      Domain | Spawns | First seen | Last seen | hint_coverage_pct\n\n    Sorted deterministically by domain name (alphabetic, UNKNOWN last).\n\n    With --check-reopen: additionally filters to domains present in the sunset\n    list from grandfather-cap.policy.yaml. Reports domains with >= 1 spawn\n    where hint matches a sunset domain (UNKNOWN excluded per M2-CDX-7).\n    \"\"\"\n    start_dt, end_dt, window_label = _resolve_window_bounds(args)\n\n    # Load sunset list + reopen options if --check-reopen requested\n    check_reopen = getattr(args, \"check_reopen\", False)\n    sunset_domains: Optional[List[str]] = None\n    # M2-CDX-4 + M2-CDX-7 (Codex Phase 1 iter 1): honor policy flags.\n    # Defaults match policy semantics when flags missing/unparseable.\n    requires_hint_match = True       # sunset_reopen_requires_hint_match (default true per §8)\n    unknown_excluded = True          # sunset_reopen_unknown_excluded (M2-CDX-7 default true)\n    if check_reopen:\n        sunset_domains = _load_sunset_domains(args)\n        sunset_options = _load_sunset_reopen_options(args)\n        if sunset_options is not None:\n            requires_hint_match = sunset_options.get(\"requires_hint_match\", True)\n            unknown_excluded = sunset_options.get(\"unknown_excluded\", True)\n        if sunset_domains is None:\n            print(\n                \"[audit-query] WARN: by-domain --check-reopen: no sunset policy file \"\n                \"found; skipping reopen filter. Set CEO_GRANDFATHER_POLICY_PATH or \"\n                \"place grandfather-cap.policy.yaml at \"\n                f\"{_GRANDFATHER_POLICY_RELPATH}\",\n                file=sys.stderr,\n            )\n\n    # Aggregation state per domain bucket\n    # domain → {spawns, first_ts, last_ts, with_hint, total}\n    domain_agg: Dict[str, Dict[str, Any]] = {}\n\n    total_in_window = 0\n    total_with_hint = 0\n\n    for e in entries:\n        if e.get(\"action\") != \"agent_spawn\":\n            continue\n\n        ts_raw = e.get(\"ts\", \"\")\n        entry_dt = _entry_ts_to_dt(ts_raw)\n\n        # Apply window filter\n        if start_dt is not None and entry_dt is not None:\n            if entry_dt < start_dt:\n                continue\n        if end_dt is not None and entry_dt is not None:\n            if entry_dt > end_dt:\n                continue\n\n        total_in_window += 1\n\n        # Determine domain bucket\n        hint = e.get(\"dispatch_archetype_hint\")\n        if hint and isinstance(hint, str) and hint.strip():\n            domain = hint.strip()\n            has_hint = True\n            total_with_hint += 1\n        else:\n            # Fallback: archetype field\n            arch = e.get(\"archetype\")\n            if arch and isinstance(arch, str) and arch.strip():\n                domain = arch.strip()\n            else:\n                domain = _UNKNOWN_BUCKET\n            has_hint = False\n\n        bucket = domain_agg.setdefault(\n            domain,\n            {\n                \"spawns\": 0,\n                \"first_ts\": ts_raw or \"\",\n                \"last_ts\": ts_raw or \"\",\n                \"with_hint\": 0,\n                \"total\": 0,\n            },\n        )\n        bucket[\"spawns\"] += 1\n        bucket[\"total\"] += 1\n        if has_hint:\n            bucket[\"with_hint\"] += 1\n        if ts_raw:\n            if not bucket[\"first_ts\"] or ts_raw < bucket[\"first_ts\"]:\n                bucket[\"first_ts\"] = ts_raw\n            if ts_raw > bucket[\"last_ts\"]:\n                bucket[\"last_ts\"] = ts_raw\n\n    # Build output rows\n    rows: List[Dict[str, Any]] = []\n    for domain in sorted(domain_agg.keys(), key=lambda d: (\"\" if d != _UNKNOWN_BUCKET else \"\\xff\") + d):\n        b = domain_agg[domain]\n        hint_pct = round(b[\"with_hint\"] / b[\"total\"] * 100, 1) if b[\"total\"] > 0 else 0.0\n        row: Dict[str, Any] = {\n            \"domain\": domain,\n            \"spawns\": b[\"spawns\"],\n            \"first_seen\": b[\"first_ts\"][:10] if b[\"first_ts\"] else \"\",\n            \"last_seen\": b[\"last_ts\"][:10] if b[\"last_ts\"] else \"\",\n            \"hint_coverage_pct\": hint_pct,\n        }\n        rows.append(row)\n\n    # Apply --check-reopen filter\n    # M2-CDX-7: UNKNOWN excluded when sunset_reopen_unknown_excluded=true (default)\n    # M2-CDX-4: When sunset_reopen_requires_hint_match=true (default), only\n    #   spawns whose ORIGINAL audit row carried `dispatch_archetype_hint`\n    #   (has_hint=True) qualify for reopen. archetype-fallback rows do not\n    #   trigger reopen (per PLAN-080 §8: \"spawn carries dispatch_archetype_hint\n    #   matching the sunset domain's archetype set\").\n    if check_reopen and sunset_domains is not None:\n        sunset_set = set(sunset_domains)\n        reopen_rows = []\n        for r in rows:\n            if unknown_excluded and r[\"domain\"] == _UNKNOWN_BUCKET:\n                continue\n            if r[\"domain\"] not in sunset_set:\n                continue\n            if r[\"spawns\"] < 1:\n                continue\n            if requires_hint_match:\n                # Reopen requires at least one hint-source spawn matching this\n                # sunset domain. Use the per-bucket `with_hint` count from the\n                # aggregation — bucket[\"with_hint\"] tracks how many spawns in\n                # this domain bucket arrived with dispatch_archetype_hint set.\n                bucket = domain_agg.get(r[\"domain\"], {})\n                if int(bucket.get(\"with_hint\", 0)) < 1:\n                    continue\n            reopen_rows.append(r)\n    else:\n        reopen_rows = []\n\n    # Build markdown table\n    def _md_table(table_rows: List[Dict[str, Any]]) -> str:\n        if not table_rows:\n            return \"| Domain | Spawns | First seen | Last seen | hint_coverage_pct |\\n\" \\\n                   \"| ------ | ------ | ---------- | --------- | ----------------- |\\n\" \\\n                   \"| (no results) | - | - | - | - |\\n\"\n        lines = [\n            \"| Domain | Spawns | First seen | Last seen | hint_coverage_pct |\",\n            \"| ------ | ------ | ---------- | --------- | ----------------- |\",\n        ]\n        for r in table_rows:\n            lines.append(\n                f\"| {r['domain']} | {r['spawns']} | {r['first_seen']} \"\n                f\"| {r['last_seen']} | {r['hint_coverage_pct']}% |\"\n            )\n        return \"\\n\".join(lines) + \"\\n\"\n\n    output: Dict[str, Any] = {\n        \"query\": \"by-domain\",\n        \"version\": \"1\",\n        \"window\": window_label,\n        \"total_spawns_in_window\": total_in_window,\n        \"overall_hint_coverage_pct\": (\n            round(total_with_hint / total_in_window * 100, 1)\n            if total_in_window > 0\n            else 0.0\n        ),\n        \"domain_count\": len(rows),\n        \"domains\": rows,\n        \"markdown_table\": _md_table(rows),\n    }\n\n    if check_reopen:\n        output[\"check_reopen\"] = {\n            \"sunset_domains_loaded\": len(sunset_domains) if sunset_domains is not None else 0,\n            \"reopen_candidates\": reopen_rows,\n            \"reopen_count\": len(reopen_rows),\n            \"note\": (\n                \"Domains from sunset list with >= 1 spawn in window. \"\n                \"UNKNOWN bucket excluded per M2-CDX-7.\"\n            ),\n        }\n\n    return output\n\n\n# ---------------------------------------------------------------------------\n# Output formatting\n# ---------------------------------------------------------------------------\n\n\n","numLines":468,"startLine":1,"totalLines":468}},"tool_result_meta":[{"id":"toolu_01MTtx5WprDDPBHaCDcNzKEJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7B2V3Vg4mpf1GmAKm9s","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01SJTc6EpDoMnwhsgWpHJd6j","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_query/labeling.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":12533,"cache_read_input_tokens":131795,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12533},"output_tokens":16,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"686fe0c6-c9dd-4361-bad4-fda29b25a7f7","uuid":"7866572f-5026-4f30-bcd6-8752daaf5e42","timestamp":"2026-11-16T19:39:28.574Z","request_id":"req_011Ch7B2Ui9abK4fSrf8ARkU","wire_tool_inputs":{"toolu_01SJTc6EpDoMnwhsgWpHJd6j":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_query/labeling.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SJTc6EpDoMnwhsgWpHJd6j","type":"tool_result","content":"1\t\"\"\"labeling audit-query declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport csv\n7\timport io\n8\timport json\n9\timport os\n10\timport re\n11\timport sys\n12\tfrom collections import Counter, defaultdict\n13\tfrom datetime import datetime, timedelta, timezone\n14\tfrom pathlib import Path\n15\tfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n16\t\n17\t__all__ = ('_LABEL_STORE_PATH', '_LABEL_VALID_CASES', '_LABEL_VALID_LABELS', '_label_store_path', '_canonical_json_for_chain', '_compute_label_hmac', '_load_label_records', '_append_label_record', 'cmd_label', '_wilson_bounds', 'cmd_fp_rate', 'cmd_case_summary', 'cmd_codex_writeguard_summary')\n18\t\n19\t_LABEL_STORE_PATH = (\n20\t    Path(__file__).resolve().parent / \"audit-log-labels.jsonl\"\n21\t)\n22\t# ADR-108 §Operational labeling protocol: Owner labels Case-B verdicts with\n23\t# fp (false-positive — Codex was wrong; close as advisory), tp (true-positive\n24\t# — block stands), or triage_pending (extends grace by 24h; max 1 extension\n25\t# before mechanical close-as-advisory). retracted is added for explicit Owner\n26\t# revocation of a prior label (creates a new chain entry that supersedes).\n27\t_LABEL_VALID_CASES = frozenset([\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"])\n28\t_LABEL_VALID_LABELS = frozenset([\"fp\", \"tp\", \"triage_pending\", \"retracted\"])\n29\t\n30\t\n31\tdef _label_store_path() -> Path:\n32\t    \"\"\"Return the labels jsonl path; env override for tests.\"\"\"\n33\t    override = os.environ.get(\"CEO_PAIR_RAIL_LABEL_STORE_PATH\")\n34\t    return Path(override) if override else _LABEL_STORE_PATH\n35\t\n36\t\n37\tdef _canonical_json_for_chain(record: Dict[str, Any]) -> str:\n38\t    \"\"\"Canonical JSON for HMAC chain — sort keys + no whitespace + UTF-8.\"\"\"\n39\t    return json.dumps(record, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True)\n40\t\n41\t\n42\tdef _compute_label_hmac(prev_hmac_hex: str, record: Dict[str, Any]) -> str:\n43\t    \"\"\"Compute HMAC-SHA256 over (prev_hmac || canonical_record) using\n44\t    the same key as `audit_hmac.get_or_create_key()`. Each record's\n45\t    `hmac` field links to the previous record's hmac forming a chain.\n46\t\n47\t    Hexlified output for jsonl-friendly storage.\n48\t    \"\"\"\n49\t    import hmac as _hmac\n50\t    import hashlib as _hashlib\n51\t    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"hooks\" / \"_lib\"))\n52\t    try:\n53\t        import audit_hmac  # type: ignore\n54\t        key = audit_hmac.get_or_create_key()\n55\t    except Exception:\n56\t        # Fallback: deterministic per-project SHA-256 chain when key infra\n57\t        # unavailable (e.g. fresh adopter clone). This still provides\n58\t        # tamper-evidence (mutating an old record breaks subsequent chain\n59\t        # verification) but is not authenticated against an external key.\n60\t        key = b\"ceo-pair-rail-label-chain-fallback-key-v1\"\n61\t    msg = (prev_hmac_hex + _canonical_json_for_chain(record)).encode(\"utf-8\")\n62\t    return _hmac.new(key, msg, _hashlib.sha256).hexdigest()\n63\t\n64\t\n65\tdef _load_label_records() -> List[Dict[str, Any]]:\n66\t    \"\"\"Read label jsonl + verify HMAC chain. Returns list of records or [].\n67\t\n68\t    On HMAC mismatch, raises ValueError with the offending record index.\n69\t    \"\"\"\n70\t    p = _label_store_path()\n71\t    if not p.exists():\n72\t        return []\n73\t    records: List[Dict[str, Any]] = []\n74\t    prev_hmac = \"\"  # genesis\n75\t    with p.open(\"r\", encoding=\"utf-8\") as fh:\n76\t        for idx, line in enumerate(fh):\n77\t            line = line.strip()\n78\t            if not line:\n79\t                continue\n80\t            try:\n81\t                rec = json.loads(line)\n82\t            except json.JSONDecodeError as e:\n83\t                raise ValueError(\n84\t                    f\"audit-log-labels.jsonl record {idx}: invalid JSON: {e}\"\n85\t                ) from e\n86\t            stored_hmac = rec.pop(\"hmac\", \"\")\n87\t            record_for_compute = dict(rec)\n88\t            expected_hmac = _compute_label_hmac(prev_hmac, record_for_compute)\n89\t            if stored_hmac != expected_hmac:\n90\t                raise ValueError(\n91\t                    f\"audit-log-labels.jsonl record {idx}: HMAC chain broken \"\n92\t                    f\"(stored={stored_hmac[:16]}, computed={expected_hmac[:16]})\"\n93\t                )\n94\t            rec[\"hmac\"] = stored_hmac\n95\t            records.append(rec)\n96\t            prev_hmac = stored_hmac\n97\t    return records\n98\t\n99\t\n100\tdef _append_label_record(record: Dict[str, Any]) -> str:\n101\t    \"\"\"Append a record to label store with HMAC chain link. Returns the new HMAC.\"\"\"\n102\t    p = _label_store_path()\n103\t    p.parent.mkdir(parents=True, exist_ok=True)\n104\t    records = _load_label_records()\n105\t    prev_hmac = records[-1][\"hmac\"] if records else \"\"\n106\t    new_hmac = _compute_label_hmac(prev_hmac, record)\n107\t    full_record = dict(record)\n108\t    full_record[\"hmac\"] = new_hmac\n109\t    with p.open(\"a\", encoding=\"utf-8\") as fh:\n110\t        fh.write(_canonical_json_for_chain(full_record) + \"\\n\")\n111\t    return new_hmac\n112\t\n113\t\n114\tdef cmd_label(entries, args) -> Dict[str, Any]:\n115\t    \"\"\"Owner labels a pair_rail_case event post-hoc. PLAN-081 Phase 6-bis.\n116\t\n117\t    Append-only via HMAC chain to `.claude/scripts/audit-log-labels.jsonl`.\n118\t    The Owner labels Case B (Claude PASS + Codex BLOCK) verdicts per\n119\t    ADR-108 §Owner labeling protocol with one of:\n120\t\n121\t    - fp (false-positive — Codex was wrong; close as advisory)\n122\t    - tp (true-positive — block stands)\n123\t    - triage_pending (extends grace by 24h; max 1 extension before\n124\t      mechanical close-as-advisory)\n125\t    - retracted (creates new chain entry that supersedes the latest\n126\t      prior label for the same run_id; if retracted is the most-recent\n127\t      entry, the event reverts to unlabeled status in fp-rate computations)\n128\t\n129\t    fp-rate aggregator (cmd_fp_rate) denominator behavior: case_b_total\n130\t    ALWAYS includes every Case-B event in the window. The numerator\n131\t    counts only `fp` labels for the lower bound; unlabeled +\n132\t    triage_pending count as worst-case FP for the upper bound. See\n133\t    cmd_fp_rate docstring for the Wilson 95% bounds details.\n134\t    \"\"\"\n135\t    run_id = getattr(args, \"run_id\", None)\n136\t    case = getattr(args, \"case\", None)\n137\t    label = getattr(args, \"label\", None)\n138\t    note = getattr(args, \"note\", \"\") or \"\"\n139\t\n140\t    if not run_id:\n141\t        return {\"verdict\": \"ERROR\", \"reason\": \"--run-id required\"}\n142\t    if case not in _LABEL_VALID_CASES:\n143\t        return {\n144\t            \"verdict\": \"ERROR\",\n145\t            \"reason\": f\"--case must be one of {sorted(_LABEL_VALID_CASES)}, got {case!r}\",\n146\t        }\n147\t    if label not in _LABEL_VALID_LABELS:\n148\t        return {\n149\t            \"verdict\": \"ERROR\",\n150\t            \"reason\": f\"--label must be one of {sorted(_LABEL_VALID_LABELS)}, got {label!r}\",\n151\t        }\n152\t\n153\t    ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n154\t    record = {\n155\t        \"ts\": ts,\n156\t        \"run_id\": run_id,\n157\t        \"case\": case,\n158\t        \"label\": label,\n159\t        \"note_bucket\": \"empty\" if not note else (\n160\t            \"short\" if len(note) <= 50 else \"medium\" if len(note) <= 200 else \"long\"\n161\t        ),\n162\t    }\n163\t    new_hmac = _append_label_record(record)\n164\t    return {\n165\t        \"verdict\": \"OK\",\n166\t        \"run_id\": run_id,\n167\t        \"case\": case,\n168\t        \"label\": label,\n169\t        \"ts\": ts,\n170\t        \"hmac_prefix\": new_hmac[:16],\n171\t    }\n172\t\n173\t\n174\tdef _wilson_bounds(successes: int, n: int, z: float = 1.96) -> Tuple[float, float]:\n175\t    \"\"\"95% Wilson score interval for binomial proportion (ADR-108 §FP-rate).\n176\t\n177\t    More accurate than naive (p ± z·sqrt(p(1-p)/n)) at small n or\n178\t    extreme p. Returns (lower, upper) ∈ [0, 1].\n179\t    \"\"\"\n180\t    if n <= 0:\n181\t        return 0.0, 0.0\n182\t    p = successes / n\n183\t    z2 = z * z\n184\t    denom = 1.0 + z2 / n\n185\t    center = (p + z2 / (2.0 * n)) / denom\n186\t    half_width = (z * ((p * (1.0 - p) + z2 / (4.0 * n)) / n) ** 0.5) / denom\n187\t    lo = max(0.0, center - half_width)\n188\t    hi = min(1.0, center + half_width)\n189\t    return lo, hi\n190\t\n191\t\n192\tdef cmd_fp_rate(entries, args) -> Dict[str, Any]:\n193\t    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE-3 + ADR-108 §FP-rate): Case-B\n194\t    false-positive rate aggregator with 95% Wilson score interval.\n195\t\n196\t    The Wilson interval provides robust lower/upper bounds at small n or\n197\t    extreme proportions, which a simple Laplace bound underestimates. Per\n198\t    ADR-108 §FP-rate, the reopen criterion fires when fp_rate_30d > 30%\n199\t    via `disable_predicate_eval.py` `fp_rate_30d_above_30pct` predicate.\n200\t\n201\t    Labels per ADR-108 §Owner labeling protocol:\n202\t    - `fp` = labeled false-positive — counted in numerator + denominator\n203\t    - `tp` = labeled true-positive — counted in denominator (not in fp num)\n204\t    - `triage_pending` = grace extended — counted in denominator (still\n205\t      provisional; treated as labeled-pending for Wilson computation)\n206\t    - `retracted` = supersedes prior label — most-recent non-retracted\n207\t      label wins; if retracted is the latest entry for a run_id, the\n208\t      event reverts to unlabeled\n209\t    The denominator (case_b_total) ALWAYS includes every Case-B event in\n210\t    the window — labeled or not. Wilson upper bound treats unlabeled +\n211\t    triage_pending as worst-case FP.\n212\t\n213\t    Window selection via --window-days (default 30).\n214\t    \"\"\"\n215\t    window_days = getattr(args, \"window_days\", None)\n216\t    if window_days is None:\n217\t        window_days = 30  # default 30-day window per ADR-108 §FP-rate\n218\t\n219\t    now = datetime.now(timezone.utc)\n220\t    cutoff = now - timedelta(days=window_days)\n221\t    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n222\t\n223\t    # Filter pair_rail_case events in window — only Case B (asymmetric case)\n224\t    case_b_total = 0\n225\t    case_b_run_ids: List[str] = []\n226\t    for e in entries:\n227\t        if e.get(\"action\") != \"pair_rail_case\":\n228\t            continue\n229\t        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n230\t            continue\n231\t        if e.get(\"case\") != \"B\":\n232\t            continue\n233\t        case_b_total += 1\n234\t        rid = str(e.get(\"run_id\") or e.get(\"pair_rail_run_id\") or \"\")\n235\t        if rid:\n236\t            case_b_run_ids.append(rid)\n237\t\n238\t    # Load labels + match by run_id (latest label wins per run_id; retracted\n239\t    # entries supersede prior labels)\n240\t    try:\n241\t        labels = _load_label_records()\n242\t    except ValueError as exc:\n243\t        return {\"verdict\": \"ERROR\", \"reason\": str(exc)}\n244\t\n245\t    label_index: Dict[str, str] = {}  # run_id → most-recent non-retracted label\n246\t    for r in labels:\n247\t        if r.get(\"case\") != \"B\":\n248\t            continue\n249\t        rid = str(r.get(\"run_id\", \"\"))\n250\t        lab = str(r.get(\"label\", \"\"))\n251\t        if lab == \"retracted\":\n252\t            label_index.pop(rid, None)\n253\t        else:\n254\t            label_index[rid] = lab\n255\t\n256\t    labeled_fp = 0\n257\t    labeled_tp = 0\n258\t    labeled_triage = 0\n259\t    unlabeled = 0\n260\t    for rid in case_b_run_ids:\n261\t        lab = label_index.get(rid)\n262\t        if lab == \"fp\":\n263\t            labeled_fp += 1\n264\t        elif lab == \"tp\":\n265\t            labeled_tp += 1\n266\t        elif lab == \"triage_pending\":\n267\t            labeled_triage += 1\n268\t        else:\n269\t            unlabeled += 1\n270\t\n271\t    # Wilson 95% bounds: numerator = labeled_fp, denominator = case_b_total\n272\t    # Upper bound assumes both unlabeled AND triage_pending are worst-case\n273\t    # FP per ADR-108 §FP-rate + cmd_label/cmd_fp_rate docstring contract\n274\t    # (Codex iter-6 P2 fix — implementation now matches docstring).\n275\t    fp_lo, _ = _wilson_bounds(labeled_fp, case_b_total)\n276\t    worst_case_fp = labeled_fp + unlabeled + labeled_triage\n277\t    _, fp_hi_via_worst = _wilson_bounds(worst_case_fp, case_b_total)\n278\t    fp_hi = fp_hi_via_worst\n279\t\n280\t    # Reopen threshold per ADR-108 §FP-rate (default 0.30 — the 30% bar that\n281\t    # triggers `fp_rate_30d_above_30pct` predicate in disable_predicate_eval.py)\n282\t    threshold = float(getattr(args, \"reopen_threshold\", None) or 0.30)\n283\t    trigger_reopen = fp_lo > threshold\n284\t\n285\t    return {\n286\t        \"window_days\": window_days,\n287\t        \"window_start\": cutoff_iso,\n288\t        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n289\t        \"case_b_total\": case_b_total,\n290\t        \"case_b_labeled_fp\": labeled_fp,\n291\t        \"case_b_labeled_tp\": labeled_tp,\n292\t        \"case_b_labeled_triage\": labeled_triage,\n293\t        \"case_b_unlabeled\": unlabeled,\n294\t        \"fp_rate_lower_bound\": round(fp_lo, 4),\n295\t        \"fp_rate_upper_bound\": round(fp_hi, 4),\n296\t        \"wilson_z\": 1.96,\n297\t        \"reopen_threshold\": threshold,\n298\t        \"trigger_reopen\": trigger_reopen,\n299\t        \"predicate_ref\": \"fp_rate_30d_above_30pct\",\n300\t    }\n301\t\n302\t\n303\tdef cmd_case_summary(entries, args) -> Dict[str, Any]:\n304\t    \"\"\"PLAN-081 Phase 6-bis (ADR-108 §Operational): Cases A-F distribution.\n305\t\n306\t    Aggregates `pair_rail_case` audit events over the window and returns\n307\t    counts + percentages for each Case (A=both PASS, B=Claude PASS+Codex\n308\t    BLOCK, C=Claude BLOCK+Codex PASS, D=both BLOCK, E=Jaccard divergence,\n309\t    F=Codex outage). Operators use this to monitor healthy distribution\n310\t    per ADR-108 §Operational (Case A typically 70-85%; Case F < 2%).\n311\t    \"\"\"\n312\t    window_days = getattr(args, \"window_days\", None)\n313\t    if window_days is None:\n314\t        window_days = 7  # default 7-day window (faster operational signal)\n315\t\n316\t    now = datetime.now(timezone.utc)\n317\t    cutoff = now - timedelta(days=window_days)\n318\t    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n319\t\n320\t    per_case: Dict[str, int] = {\"A\": 0, \"B\": 0, \"C\": 0, \"D\": 0, \"E\": 0, \"F\": 0}\n321\t    unknown_case = 0\n322\t    precondition_met_count = 0\n323\t    precondition_not_met_count = 0  # Case B'\n324\t    for e in entries:\n325\t        if e.get(\"action\") != \"pair_rail_case\":\n326\t            continue\n327\t        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n328\t            continue\n329\t        case = str(e.get(\"case\") or \"\")\n330\t        if case in per_case:\n331\t            per_case[case] += 1\n332\t            if case == \"B\":\n333\t                pm = e.get(\"precondition_met\")\n334\t                if pm is True or pm == \"true\":\n335\t                    precondition_met_count += 1\n336\t                elif pm is False or pm == \"false\":\n337\t                    precondition_not_met_count += 1\n338\t        else:\n339\t            unknown_case += 1\n340\t\n341\t    total = sum(per_case.values()) + unknown_case\n342\t    per_case_pct = {\n343\t        k: round(v / total * 100.0, 2) if total else 0.0\n344\t        for k, v in per_case.items()\n345\t    }\n346\t\n347\t    # Healthy distribution sentinels per ADR-108 §Operational\n348\t    healthy_ranges = {\n349\t        \"A\": (70.0, 85.0),\n350\t        \"B\": (1.0, 8.0),\n351\t        \"C\": (2.0, 10.0),\n352\t        \"D\": (1.0, 5.0),\n353\t        \"E\": (1.0, 5.0),\n354\t        \"F\": (0.0, 2.0),\n355\t    }\n356\t    health = {}\n357\t    for k, pct in per_case_pct.items():\n358\t        lo, hi = healthy_ranges[k]\n359\t        if total == 0:\n360\t            health[k] = \"NO_DATA\"\n361\t        elif lo <= pct <= hi:\n362\t            health[k] = \"OK\"\n363\t        elif pct < lo:\n364\t            health[k] = \"LOW\"\n365\t        else:\n366\t            health[k] = \"HIGH\"\n367\t\n368\t    return {\n369\t        \"window_days\": window_days,\n370\t        \"window_start\": cutoff_iso,\n371\t        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n372\t        \"total_pair_rail_case_events\": total,\n373\t        \"case_counts\": per_case,\n374\t        \"case_percentages\": per_case_pct,\n375\t        \"unknown_case_count\": unknown_case,\n376\t        \"case_b_precondition_met\": precondition_met_count,\n377\t        \"case_b_precondition_not_met\": precondition_not_met_count,\n378\t        \"health_per_case\": health,\n379\t    }\n380\t\n381\t\n382\tdef cmd_codex_writeguard_summary(entries, args) -> Dict[str, Any]:\n383\t    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE Q2): Codex codando deny-list hit summary.\n384\t\n385\t    Aggregates `pair_rail_codex_denylist_hit` audit events by target_path\n386\t    bucket. Surfaces top-attempted forbidden paths so operators can detect\n387\t    deny-list coverage gaps.\n388\t    \"\"\"\n389\t    window_days = getattr(args, \"window_days\", None)\n390\t    if window_days is None:\n391\t        window_days = 30\n392\t\n393\t    now = datetime.now(timezone.utc)\n394\t    cutoff = now - timedelta(days=window_days)\n395\t    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n396\t\n397\t    per_path: Dict[str, int] = {}\n398\t    total_hits = 0\n399\t    for e in entries:\n400\t        if e.get(\"action\") != \"pair_rail_codex_denylist_hit\":\n401\t            continue\n402\t        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n403\t            continue\n404\t        path = str(e.get(\"target_path_bucket\") or e.get(\"target_path\") or \"unknown\")\n405\t        per_path[path] = per_path.get(path, 0) + 1\n406\t        total_hits += 1\n407\t\n408\t    top_n = int(getattr(args, \"top\", None) or 10)\n409\t    top_paths = sorted(per_path.items(), key=lambda kv: (-kv[1], kv[0]))[:top_n]\n410\t\n411\t    return {\n412\t        \"window_days\": window_days,\n413\t        \"window_start\": cutoff_iso,\n414\t        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n415\t        \"total_hits\": total_hits,\n416\t        \"unique_paths\": len(per_path),\n417\t        \"top_paths\": [{\"path_bucket\": p, \"hits\": c} for p, c in top_paths],\n418\t    }\n419\t\n420\t\n421\t# ---------------------------------------------------------------------------\n422\t# PLAN-113 Phase B, Wave W1 — critical-security-action reader (audit-reader\n423\t# coverage). These 38 actions are emitted by hooks but had NO reader handler\n424\t# in this CLI, so an operator could not surface them (PLAN-112 finding class\n425\t# \"Critical action has no reader handler\"). cmd_critical reads the registry\n426\t# below and surfaces, per action, count + first/last timestamp + a compact\n427\t# set of SAFE summary fields ALREADY PRESENT on the event (never invented).\n428\t# Actions with ZERO occurrences are still listed (count=0) so a\n429\t# missing-but-expected critical event is visible — surfacing ABSENCE is the\n430\t# whole point.\n431\t# ---------------------------------------------------------------------------\n432\t"}]},"parent_tool_use_id":null,"session_id":"686fe0c6-c9dd-4361-bad4-fda29b25a7f7","uuid":"d8fc5b45-00e7-4461-ba3d-15a85c5d46c2","timestamp":"2026-11-16T19:39:28.587Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_query/labeling.py","content":"\"\"\"labeling audit-query declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport csv\nimport io\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter, defaultdict\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, Iterator, List, Optional, Tuple\n\n__all__ = ('_LABEL_STORE_PATH', '_LABEL_VALID_CASES', '_LABEL_VALID_LABELS', '_label_store_path', '_canonical_json_for_chain', '_compute_label_hmac', '_load_label_records', '_append_label_record', 'cmd_label', '_wilson_bounds', 'cmd_fp_rate', 'cmd_case_summary', 'cmd_codex_writeguard_summary')\n\n_LABEL_STORE_PATH = (\n    Path(__file__).resolve().parent / \"audit-log-labels.jsonl\"\n)\n# ADR-108 §Operational labeling protocol: Owner labels Case-B verdicts with\n# fp (false-positive — Codex was wrong; close as advisory), tp (true-positive\n# — block stands), or triage_pending (extends grace by 24h; max 1 extension\n# before mechanical close-as-advisory). retracted is added for explicit Owner\n# revocation of a prior label (creates a new chain entry that supersedes).\n_LABEL_VALID_CASES = frozenset([\"A\", \"B\", \"C\", \"D\", \"E\", \"F\"])\n_LABEL_VALID_LABELS = frozenset([\"fp\", \"tp\", \"triage_pending\", \"retracted\"])\n\n\ndef _label_store_path() -> Path:\n    \"\"\"Return the labels jsonl path; env override for tests.\"\"\"\n    override = os.environ.get(\"CEO_PAIR_RAIL_LABEL_STORE_PATH\")\n    return Path(override) if override else _LABEL_STORE_PATH\n\n\ndef _canonical_json_for_chain(record: Dict[str, Any]) -> str:\n    \"\"\"Canonical JSON for HMAC chain — sort keys + no whitespace + UTF-8.\"\"\"\n    return json.dumps(record, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=True)\n\n\ndef _compute_label_hmac(prev_hmac_hex: str, record: Dict[str, Any]) -> str:\n    \"\"\"Compute HMAC-SHA256 over (prev_hmac || canonical_record) using\n    the same key as `audit_hmac.get_or_create_key()`. Each record's\n    `hmac` field links to the previous record's hmac forming a chain.\n\n    Hexlified output for jsonl-friendly storage.\n    \"\"\"\n    import hmac as _hmac\n    import hashlib as _hashlib\n    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / \"hooks\" / \"_lib\"))\n    try:\n        import audit_hmac  # type: ignore\n        key = audit_hmac.get_or_create_key()\n    except Exception:\n        # Fallback: deterministic per-project SHA-256 chain when key infra\n        # unavailable (e.g. fresh adopter clone). This still provides\n        # tamper-evidence (mutating an old record breaks subsequent chain\n        # verification) but is not authenticated against an external key.\n        key = b\"ceo-pair-rail-label-chain-fallback-key-v1\"\n    msg = (prev_hmac_hex + _canonical_json_for_chain(record)).encode(\"utf-8\")\n    return _hmac.new(key, msg, _hashlib.sha256).hexdigest()\n\n\ndef _load_label_records() -> List[Dict[str, Any]]:\n    \"\"\"Read label jsonl + verify HMAC chain. Returns list of records or [].\n\n    On HMAC mismatch, raises ValueError with the offending record index.\n    \"\"\"\n    p = _label_store_path()\n    if not p.exists():\n        return []\n    records: List[Dict[str, Any]] = []\n    prev_hmac = \"\"  # genesis\n    with p.open(\"r\", encoding=\"utf-8\") as fh:\n        for idx, line in enumerate(fh):\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                rec = json.loads(line)\n            except json.JSONDecodeError as e:\n                raise ValueError(\n                    f\"audit-log-labels.jsonl record {idx}: invalid JSON: {e}\"\n                ) from e\n            stored_hmac = rec.pop(\"hmac\", \"\")\n            record_for_compute = dict(rec)\n            expected_hmac = _compute_label_hmac(prev_hmac, record_for_compute)\n            if stored_hmac != expected_hmac:\n                raise ValueError(\n                    f\"audit-log-labels.jsonl record {idx}: HMAC chain broken \"\n                    f\"(stored={stored_hmac[:16]}, computed={expected_hmac[:16]})\"\n                )\n            rec[\"hmac\"] = stored_hmac\n            records.append(rec)\n            prev_hmac = stored_hmac\n    return records\n\n\ndef _append_label_record(record: Dict[str, Any]) -> str:\n    \"\"\"Append a record to label store with HMAC chain link. Returns the new HMAC.\"\"\"\n    p = _label_store_path()\n    p.parent.mkdir(parents=True, exist_ok=True)\n    records = _load_label_records()\n    prev_hmac = records[-1][\"hmac\"] if records else \"\"\n    new_hmac = _compute_label_hmac(prev_hmac, record)\n    full_record = dict(record)\n    full_record[\"hmac\"] = new_hmac\n    with p.open(\"a\", encoding=\"utf-8\") as fh:\n        fh.write(_canonical_json_for_chain(full_record) + \"\\n\")\n    return new_hmac\n\n\ndef cmd_label(entries, args) -> Dict[str, Any]:\n    \"\"\"Owner labels a pair_rail_case event post-hoc. PLAN-081 Phase 6-bis.\n\n    Append-only via HMAC chain to `.claude/scripts/audit-log-labels.jsonl`.\n    The Owner labels Case B (Claude PASS + Codex BLOCK) verdicts per\n    ADR-108 §Owner labeling protocol with one of:\n\n    - fp (false-positive — Codex was wrong; close as advisory)\n    - tp (true-positive — block stands)\n    - triage_pending (extends grace by 24h; max 1 extension before\n      mechanical close-as-advisory)\n    - retracted (creates new chain entry that supersedes the latest\n      prior label for the same run_id; if retracted is the most-recent\n      entry, the event reverts to unlabeled status in fp-rate computations)\n\n    fp-rate aggregator (cmd_fp_rate) denominator behavior: case_b_total\n    ALWAYS includes every Case-B event in the window. The numerator\n    counts only `fp` labels for the lower bound; unlabeled +\n    triage_pending count as worst-case FP for the upper bound. See\n    cmd_fp_rate docstring for the Wilson 95% bounds details.\n    \"\"\"\n    run_id = getattr(args, \"run_id\", None)\n    case = getattr(args, \"case\", None)\n    label = getattr(args, \"label\", None)\n    note = getattr(args, \"note\", \"\") or \"\"\n\n    if not run_id:\n        return {\"verdict\": \"ERROR\", \"reason\": \"--run-id required\"}\n    if case not in _LABEL_VALID_CASES:\n        return {\n            \"verdict\": \"ERROR\",\n            \"reason\": f\"--case must be one of {sorted(_LABEL_VALID_CASES)}, got {case!r}\",\n        }\n    if label not in _LABEL_VALID_LABELS:\n        return {\n            \"verdict\": \"ERROR\",\n            \"reason\": f\"--label must be one of {sorted(_LABEL_VALID_LABELS)}, got {label!r}\",\n        }\n\n    ts = datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    record = {\n        \"ts\": ts,\n        \"run_id\": run_id,\n        \"case\": case,\n        \"label\": label,\n        \"note_bucket\": \"empty\" if not note else (\n            \"short\" if len(note) <= 50 else \"medium\" if len(note) <= 200 else \"long\"\n        ),\n    }\n    new_hmac = _append_label_record(record)\n    return {\n        \"verdict\": \"OK\",\n        \"run_id\": run_id,\n        \"case\": case,\n        \"label\": label,\n        \"ts\": ts,\n        \"hmac_prefix\": new_hmac[:16],\n    }\n\n\ndef _wilson_bounds(successes: int, n: int, z: float = 1.96) -> Tuple[float, float]:\n    \"\"\"95% Wilson score interval for binomial proportion (ADR-108 §FP-rate).\n\n    More accurate than naive (p ± z·sqrt(p(1-p)/n)) at small n or\n    extreme p. Returns (lower, upper) ∈ [0, 1].\n    \"\"\"\n    if n <= 0:\n        return 0.0, 0.0\n    p = successes / n\n    z2 = z * z\n    denom = 1.0 + z2 / n\n    center = (p + z2 / (2.0 * n)) / denom\n    half_width = (z * ((p * (1.0 - p) + z2 / (4.0 * n)) / n) ** 0.5) / denom\n    lo = max(0.0, center - half_width)\n    hi = min(1.0, center + half_width)\n    return lo, hi\n\n\ndef cmd_fp_rate(entries, args) -> Dict[str, Any]:\n    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE-3 + ADR-108 §FP-rate): Case-B\n    false-positive rate aggregator with 95% Wilson score interval.\n\n    The Wilson interval provides robust lower/upper bounds at small n or\n    extreme proportions, which a simple Laplace bound underestimates. Per\n    ADR-108 §FP-rate, the reopen criterion fires when fp_rate_30d > 30%\n    via `disable_predicate_eval.py` `fp_rate_30d_above_30pct` predicate.\n\n    Labels per ADR-108 §Owner labeling protocol:\n    - `fp` = labeled false-positive — counted in numerator + denominator\n    - `tp` = labeled true-positive — counted in denominator (not in fp num)\n    - `triage_pending` = grace extended — counted in denominator (still\n      provisional; treated as labeled-pending for Wilson computation)\n    - `retracted` = supersedes prior label — most-recent non-retracted\n      label wins; if retracted is the latest entry for a run_id, the\n      event reverts to unlabeled\n    The denominator (case_b_total) ALWAYS includes every Case-B event in\n    the window — labeled or not. Wilson upper bound treats unlabeled +\n    triage_pending as worst-case FP.\n\n    Window selection via --window-days (default 30).\n    \"\"\"\n    window_days = getattr(args, \"window_days\", None)\n    if window_days is None:\n        window_days = 30  # default 30-day window per ADR-108 §FP-rate\n\n    now = datetime.now(timezone.utc)\n    cutoff = now - timedelta(days=window_days)\n    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    # Filter pair_rail_case events in window — only Case B (asymmetric case)\n    case_b_total = 0\n    case_b_run_ids: List[str] = []\n    for e in entries:\n        if e.get(\"action\") != \"pair_rail_case\":\n            continue\n        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n            continue\n        if e.get(\"case\") != \"B\":\n            continue\n        case_b_total += 1\n        rid = str(e.get(\"run_id\") or e.get(\"pair_rail_run_id\") or \"\")\n        if rid:\n            case_b_run_ids.append(rid)\n\n    # Load labels + match by run_id (latest label wins per run_id; retracted\n    # entries supersede prior labels)\n    try:\n        labels = _load_label_records()\n    except ValueError as exc:\n        return {\"verdict\": \"ERROR\", \"reason\": str(exc)}\n\n    label_index: Dict[str, str] = {}  # run_id → most-recent non-retracted label\n    for r in labels:\n        if r.get(\"case\") != \"B\":\n            continue\n        rid = str(r.get(\"run_id\", \"\"))\n        lab = str(r.get(\"label\", \"\"))\n        if lab == \"retracted\":\n            label_index.pop(rid, None)\n        else:\n            label_index[rid] = lab\n\n    labeled_fp = 0\n    labeled_tp = 0\n    labeled_triage = 0\n    unlabeled = 0\n    for rid in case_b_run_ids:\n        lab = label_index.get(rid)\n        if lab == \"fp\":\n            labeled_fp += 1\n        elif lab == \"tp\":\n            labeled_tp += 1\n        elif lab == \"triage_pending\":\n            labeled_triage += 1\n        else:\n            unlabeled += 1\n\n    # Wilson 95% bounds: numerator = labeled_fp, denominator = case_b_total\n    # Upper bound assumes both unlabeled AND triage_pending are worst-case\n    # FP per ADR-108 §FP-rate + cmd_label/cmd_fp_rate docstring contract\n    # (Codex iter-6 P2 fix — implementation now matches docstring).\n    fp_lo, _ = _wilson_bounds(labeled_fp, case_b_total)\n    worst_case_fp = labeled_fp + unlabeled + labeled_triage\n    _, fp_hi_via_worst = _wilson_bounds(worst_case_fp, case_b_total)\n    fp_hi = fp_hi_via_worst\n\n    # Reopen threshold per ADR-108 §FP-rate (default 0.30 — the 30% bar that\n    # triggers `fp_rate_30d_above_30pct` predicate in disable_predicate_eval.py)\n    threshold = float(getattr(args, \"reopen_threshold\", None) or 0.30)\n    trigger_reopen = fp_lo > threshold\n\n    return {\n        \"window_days\": window_days,\n        \"window_start\": cutoff_iso,\n        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"case_b_total\": case_b_total,\n        \"case_b_labeled_fp\": labeled_fp,\n        \"case_b_labeled_tp\": labeled_tp,\n        \"case_b_labeled_triage\": labeled_triage,\n        \"case_b_unlabeled\": unlabeled,\n        \"fp_rate_lower_bound\": round(fp_lo, 4),\n        \"fp_rate_upper_bound\": round(fp_hi, 4),\n        \"wilson_z\": 1.96,\n        \"reopen_threshold\": threshold,\n        \"trigger_reopen\": trigger_reopen,\n        \"predicate_ref\": \"fp_rate_30d_above_30pct\",\n    }\n\n\ndef cmd_case_summary(entries, args) -> Dict[str, Any]:\n    \"\"\"PLAN-081 Phase 6-bis (ADR-108 §Operational): Cases A-F distribution.\n\n    Aggregates `pair_rail_case` audit events over the window and returns\n    counts + percentages for each Case (A=both PASS, B=Claude PASS+Codex\n    BLOCK, C=Claude BLOCK+Codex PASS, D=both BLOCK, E=Jaccard divergence,\n    F=Codex outage). Operators use this to monitor healthy distribution\n    per ADR-108 §Operational (Case A typically 70-85%; Case F < 2%).\n    \"\"\"\n    window_days = getattr(args, \"window_days\", None)\n    if window_days is None:\n        window_days = 7  # default 7-day window (faster operational signal)\n\n    now = datetime.now(timezone.utc)\n    cutoff = now - timedelta(days=window_days)\n    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    per_case: Dict[str, int] = {\"A\": 0, \"B\": 0, \"C\": 0, \"D\": 0, \"E\": 0, \"F\": 0}\n    unknown_case = 0\n    precondition_met_count = 0\n    precondition_not_met_count = 0  # Case B'\n    for e in entries:\n        if e.get(\"action\") != \"pair_rail_case\":\n            continue\n        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n            continue\n        case = str(e.get(\"case\") or \"\")\n        if case in per_case:\n            per_case[case] += 1\n            if case == \"B\":\n                pm = e.get(\"precondition_met\")\n                if pm is True or pm == \"true\":\n                    precondition_met_count += 1\n                elif pm is False or pm == \"false\":\n                    precondition_not_met_count += 1\n        else:\n            unknown_case += 1\n\n    total = sum(per_case.values()) + unknown_case\n    per_case_pct = {\n        k: round(v / total * 100.0, 2) if total else 0.0\n        for k, v in per_case.items()\n    }\n\n    # Healthy distribution sentinels per ADR-108 §Operational\n    healthy_ranges = {\n        \"A\": (70.0, 85.0),\n        \"B\": (1.0, 8.0),\n        \"C\": (2.0, 10.0),\n        \"D\": (1.0, 5.0),\n        \"E\": (1.0, 5.0),\n        \"F\": (0.0, 2.0),\n    }\n    health = {}\n    for k, pct in per_case_pct.items():\n        lo, hi = healthy_ranges[k]\n        if total == 0:\n            health[k] = \"NO_DATA\"\n        elif lo <= pct <= hi:\n            health[k] = \"OK\"\n        elif pct < lo:\n            health[k] = \"LOW\"\n        else:\n            health[k] = \"HIGH\"\n\n    return {\n        \"window_days\": window_days,\n        \"window_start\": cutoff_iso,\n        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"total_pair_rail_case_events\": total,\n        \"case_counts\": per_case,\n        \"case_percentages\": per_case_pct,\n        \"unknown_case_count\": unknown_case,\n        \"case_b_precondition_met\": precondition_met_count,\n        \"case_b_precondition_not_met\": precondition_not_met_count,\n        \"health_per_case\": health,\n    }\n\n\ndef cmd_codex_writeguard_summary(entries, args) -> Dict[str, Any]:\n    \"\"\"PLAN-081 Phase 6-bis (R1 S-TDE Q2): Codex codando deny-list hit summary.\n\n    Aggregates `pair_rail_codex_denylist_hit` audit events by target_path\n    bucket. Surfaces top-attempted forbidden paths so operators can detect\n    deny-list coverage gaps.\n    \"\"\"\n    window_days = getattr(args, \"window_days\", None)\n    if window_days is None:\n        window_days = 30\n\n    now = datetime.now(timezone.utc)\n    cutoff = now - timedelta(days=window_days)\n    cutoff_iso = cutoff.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n    per_path: Dict[str, int] = {}\n    total_hits = 0\n    for e in entries:\n        if e.get(\"action\") != \"pair_rail_codex_denylist_hit\":\n            continue\n        if str(e.get(\"ts\", \"\")) < cutoff_iso:\n            continue\n        path = str(e.get(\"target_path_bucket\") or e.get(\"target_path\") or \"unknown\")\n        per_path[path] = per_path.get(path, 0) + 1\n        total_hits += 1\n\n    top_n = int(getattr(args, \"top\", None) or 10)\n    top_paths = sorted(per_path.items(), key=lambda kv: (-kv[1], kv[0]))[:top_n]\n\n    return {\n        \"window_days\": window_days,\n        \"window_start\": cutoff_iso,\n        \"window_end\": now.strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n        \"total_hits\": total_hits,\n        \"unique_paths\": len(per_path),\n        \"top_paths\": [{\"path_bucket\": p, \"hits\": c} for p, c in top_paths],\n    }\n\n\n# ---------------------------------------------------------------------------\n# PLAN-113 Phase B, Wave W1 — critical-security-action reader (audit-reader\n# coverage). These 38 actions are emitted by hooks but had NO reader handler\n# in this CLI, so an operator could not surface them (PLAN-112 finding class\n# \"Critical action has no reader handler\"). cmd_critical reads the registry\n# below and surfaces, per action, count + first/last timestamp + a compact\n# set of SAFE summary fields ALREADY PRESENT on the event (never invented).\n# Actions with ZERO occurrences are still listed (count=0) so a\n# missing-but-expected critical event is visible — surfacing ABSENCE is the\n# whole point.\n# ---------------------------------------------------------------------------\n","numLines":432,"startLine":1,"totalLines":432}},"tool_result_meta":[{"id":"toolu_01SJTc6EpDoMnwhsgWpHJd6j","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
