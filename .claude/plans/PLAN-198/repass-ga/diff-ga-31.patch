-def _safe_ratio_pct(numerator: Any, denominator: Any) -> Optional[float]:
-    """numerator/denominator as a percent (0..100), or None if not derivable."""
-    try:
-        num = float(numerator)
-        den = float(denominator)
-    except (TypeError, ValueError):
-        return None
-    if den <= 0:
-        return None
-    pct = (num / den) * 100.0
-    if pct < 0:
-        return 0.0
-    return pct
