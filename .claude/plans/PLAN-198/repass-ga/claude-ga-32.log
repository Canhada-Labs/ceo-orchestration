{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011mPr1yjYLXUtSZPweW7LEx","type":"tool_result","content":"1\t# Implementation section: globals belong to the lessons facade.\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\t__all__ = ['write_lesson', 'list_lessons', '_archetype_match', '_scope_overlap', '_recency_decay', 'rank_lessons', 'get_top_k', 'record_outcome', 'undo_outcome', 'build_index', 'VALID_CONSUMERS']\n6\t\n7\tdef write_lesson(\n8\t    scenario_id: str,\n9\t    archetype: str,\n10\t    remember_this: str,\n11\t    scope_tags: List[str],\n12\t    agent_response: str = \"\",\n13\t    expected_response: str = \"\",\n14\t    base_dir: Optional[str] = None,\n15\t    trigger: str = \"benchmark_fail\",\n16\t) -> Path:\n17\t    \"\"\"Write a lesson file to disk. Returns the file path.\n18\t\n19\t    Uses a directory-scoped FileLock to serialize writes across processes\n20\t    so that concurrent runners (e.g. parallel benchmark workers) don't\n21\t    corrupt lesson files or emit interleaved audit events.\n22\t    \"\"\"\n23\t    now = datetime.now(timezone.utc).isoformat()\n24\t    lesson_id = _generate_id(scenario_id, now)\n25\t\n26\t    # PLAN-009 P3.6 (K5/A21): scan the lesson body for prompt-injection\n27\t    # patterns BEFORE persisting. Attacker-written lessons become fuel for\n28\t    # the next Architect spawn (they are injected via top-K retrieval).\n29\t    # Advisory: we don't refuse to write, but we emit a breadcrumb +\n30\t    # `injection_flag` audit event so future triage can find compromised\n31\t    # lessons. Fail-open: scanner errors never block lesson writes.\n32\t    try:\n33\t        _scan_lesson_for_injection(\n34\t            text_blob=\"\\n\".join([remember_this, agent_response, expected_response]),\n35\t            lesson_id=lesson_id,\n36\t            archetype=archetype,\n37\t        )\n38\t    except Exception:\n39\t        pass\n40\t\n41\t    lesson = Lesson(\n42\t        lesson_id=lesson_id,\n43\t        created_at=now,\n44\t        scenario_id=scenario_id,\n45\t        archetype=archetype,\n46\t        remember_this=remember_this[:200],\n47\t        scope_tags=scope_tags,\n48\t        agent_response=redact_secrets(agent_response),\n49\t        expected_response=redact_secrets(expected_response),\n50\t    )\n51\t\n52\t    d = _lessons_dir(base_dir)\n53\t    d.mkdir(parents=True, exist_ok=True)\n54\t    path = d / f\"{lesson_id}.json\"\n55\t    payload = json.dumps(asdict(lesson), indent=2, ensure_ascii=False) + \"\\n\"\n56\t\n57\t    if _FILELOCK_AVAILABLE:\n58\t        lock_path = str(d / \".lessons.lock\")\n59\t        try:\n60\t            with FileLock(lock_path, timeout=2.5):\n61\t                path.write_text(payload, encoding=\"utf-8\")\n62\t        except FileLockTimeout:\n63\t            # Fail-open: lock contention is not fatal. Write anyway.\n64\t            path.write_text(payload, encoding=\"utf-8\")\n65\t    else:\n66\t        path.write_text(payload, encoding=\"utf-8\")\n67\t\n68\t    # Emit audit event (fail-open: wrapped in its own try/except)\n69\t    if _AUDIT_EMIT_AVAILABLE:\n70\t        try:\n71\t            _emit_lesson_write(\n72\t                lesson_id=lesson_id,\n73\t                archetype=archetype,\n74\t                scope_tags=scope_tags,\n75\t                trigger=trigger,\n76\t                source_event_id=scenario_id,\n77\t            )\n78\t        except Exception:\n79\t            pass\n80\t\n81\t    return path\n82\t\n83\t\n84\tdef list_lessons(base_dir: Optional[str] = None) -> List[Lesson]:\n85\t    \"\"\"List all lessons, capped at _MAX_SCAN files.\"\"\"\n86\t    d = _lessons_dir(base_dir)\n87\t    if not d.is_dir():\n88\t        return []\n89\t\n90\t    lessons = []\n91\t    count = 0\n92\t    for f in sorted(d.iterdir()):\n93\t        if count >= _MAX_SCAN:\n94\t            break\n95\t        if not f.suffix == \".json\":\n96\t            continue\n97\t        count += 1\n98\t        try:\n99\t            data = json.loads(f.read_text(encoding=\"utf-8\"))\n100\t            # PLAN-154 belt: a candidate record misplaced in the live\n101\t            # top-level dir must NEVER load as a live lesson — candidates\n102\t            # surface only via the verified boot path (A6). Their own\n103\t            # namespace is candidates/ (skipped here as a directory).\n104\t            if isinstance(data, dict) and str(\n105\t                data.get(\"status\") or \"\"\n106\t            ) in CANDIDATE_STATUSES:\n107\t                continue\n108\t            lessons.append(Lesson(**{\n109\t                k: data.get(k, v)\n110\t                for k, v in Lesson().__dict__.items()\n111\t            }))\n112\t        except (json.JSONDecodeError, TypeError, KeyError):\n113\t            continue\n114\t    return lessons\n115\t\n116\t\n117\tdef _archetype_match(lesson_archetype: str, query_archetype: str) -> float:\n118\t    \"\"\"1.0 exact, 0.3 related (same word overlap), 0.0 otherwise.\"\"\"\n119\t    if not lesson_archetype or not query_archetype:\n120\t        return 0.0\n121\t    la = set(lesson_archetype.lower().split())\n122\t    qa = set(query_archetype.lower().split())\n123\t    if la == qa:\n124\t        return 1.0\n125\t    if la & qa:\n126\t        return 0.3\n127\t    return 0.0\n128\t\n129\t\n130\tdef _scope_overlap(lesson_tags: List[str], query_keywords: List[str]) -> float:\n131\t    \"\"\"Jaccard similarity of tag sets.\"\"\"\n132\t    if not lesson_tags or not query_keywords:\n133\t        return 0.0\n134\t    a = set(t.lower() for t in lesson_tags)\n135\t    b = set(k.lower() for k in query_keywords)\n136\t    intersection = len(a & b)\n137\t    union = len(a | b)\n138\t    if union == 0:\n139\t        return 0.0\n140\t    return intersection / union\n141\t\n142\t\n143\tdef _recency_decay(\n144\t    created_at: str,\n145\t    now_fn: Optional[Callable[[], Any]] = None,\n146\t) -> float:\n147\t    \"\"\"exp(-days/90) exponential decay — 90-day e-folding time.\n148\t\n149\t    PLAN-154 A14 docstring fix: the old wording claimed a \"90-day\n150\t    half-life\"; the actual half-life of exp(-days/90) is 90·ln(2) ≈\n151\t    62.4 days (90 days is the e-folding constant, decay ≈ 0.368).\n152\t\n153\t    PLAN-154 A9: injectable ``now_fn`` (wall clock only as default) so\n154\t    decay is deterministic under test — golden-value boundaries,\n155\t    monotonicity, and twice-run-identical are pinned in\n156\t    ``test_lessons_candidates.py``.\n157\t    \"\"\"\n158\t    try:\n159\t        # Parse ISO 8601\n160\t        if created_at.endswith(\"Z\"):\n161\t            created_at = created_at[:-1] + \"+00:00\"\n162\t        dt = datetime.fromisoformat(created_at)\n163\t        if dt.tzinfo is None:\n164\t            dt = dt.replace(tzinfo=timezone.utc)\n165\t        now = _now_utc(now_fn)\n166\t        days = (now - dt).total_seconds() / 86400\n167\t        return math.exp(-days / 90)\n168\t    except (ValueError, TypeError, AttributeError):\n169\t        return 0.5  # neutral if unparseable\n170\t\n171\t\n172\tdef rank_lessons(\n173\t    archetype: str,\n174\t    keywords: List[str],\n175\t    base_dir: Optional[str] = None,\n176\t    now_fn: Optional[Callable[[], Any]] = None,\n177\t) -> List[Lesson]:\n178\t    \"\"\"Return top-3 lessons by relevance score (injection-sized).\"\"\"\n179\t    return get_top_k(archetype, keywords, k=3, base_dir=base_dir, now_fn=now_fn)\n180\t\n181\t\n182\tdef get_top_k(\n183\t    archetype: str,\n184\t    keywords: List[str],\n185\t    k: int = 50,\n186\t    base_dir: Optional[str] = None,\n187\t    now_fn: Optional[Callable[[], Any]] = None,\n188\t) -> List[Lesson]:\n189\t    \"\"\"Return top-K lessons by relevance score, capped by K.\n190\t\n191\t    PLAN-006 Phase 4 (ADR-015, R-VP4 10x scale): hard cap prevents O(n)\n192\t    cross-archetype scoring on every spawn from degrading at scale.\n193\t    Relevance weighted by `archetype_match × scope_overlap ×\n194\t    recency_decay × hit_rate_weight`.\n195\t\n196\t    Default K=50 (ADR-015 scaling envelope). Injection path uses K=3.\n197\t    \"\"\"\n198\t    if k < 1:\n199\t        k = 1\n200\t    if k > 50:\n201\t        k = 50  # hard ceiling per ADR-015\n202\t\n203\t    lessons = list_lessons(base_dir)\n204\t    if not lessons:\n205\t        return []\n206\t\n207\t    scored = []\n208\t    for lesson in lessons:\n209\t        am = _archetype_match(lesson.archetype, archetype)\n210\t        so = _scope_overlap(lesson.scope_tags, keywords)\n211\t        rd = _recency_decay(lesson.created_at, now_fn=now_fn)\n212\t        # Hit-rate weight: untested lessons (n<3) get neutral 1.0;\n213\t        # proven lessons in [0.5, 1.5] range so confirmed winners\n214\t        # (hr=1.0 → hw=1.5) outrank untested ones, while confirmed\n215\t        # losers (hr=0.0 → hw=0.5) are down-weighted but not zeroed\n216\t        # (pruning policy in ADR-017 handles deletion separately).\n217\t        hr = lesson.hit_rate()\n218\t        hw = 1.0 if hr is None else max(0.1, 0.5 + hr)\n219\t        score = am * so * rd * hw\n220\t        if score > 0:\n221\t            scored.append((score, lesson))\n222\t\n223\t    scored.sort(key=lambda x: x[0], reverse=True)\n224\t    return [lesson for _, lesson in scored[:k]]\n225\t\n226\t\n227\t# PLAN-009 P3.2 (C10/A10) — consumer enum is closed; new values require\n228\t# SPEC amendment (SPEC/v1/audit-log.schema.md).\n229\tVALID_CONSUMERS = frozenset({\"benchmark\", \"architect\"})\n230\t\n231\t\n232\tdef record_outcome(\n233\t    lesson_id: str,\n234\t    hit: bool,\n235\t    base_dir: Optional[str] = None,\n236\t    consumer: str = \"benchmark\",\n237\t) -> Optional[Lesson]:\n238\t    \"\"\"Increment hit_count or miss_count on a lesson; update last_outcome_at.\n239\t\n240\t    PLAN-006 Phase 4 (ADR-015); PLAN-009 P3.2 adds ``consumer``\n241\t    parameter. Fail-open — returns None if lesson not found or write\n242\t    fails.\n243\t\n244\t    Args:\n245\t        lesson_id: lesson ID (SHA-256 prefix of scenario_id + created_at)\n246\t        hit: True → increment hit_count; False → miss_count\n247\t        base_dir: optional override for lessons directory (testing)\n248\t        consumer: ``\"benchmark\"`` (default, back-compat) or\n249\t            ``\"architect\"``. New values require SPEC amendment — see\n250\t            ``VALID_CONSUMERS``.\n251\t\n252\t    Raises:\n253\t        ValueError: when ``consumer`` is not in ``VALID_CONSUMERS``.\n254\t            Strict validation at entry prevents silent mis-attribution\n255\t            of Architect outcomes to benchmark aggregates.\n256\t    \"\"\"\n257\t    if consumer not in VALID_CONSUMERS:\n258\t        raise ValueError(\n259\t            f\"record_outcome: unknown consumer={consumer!r}. \"\n260\t            f\"Valid values: {sorted(VALID_CONSUMERS)}. \"\n261\t            \"Adding a new consumer requires SPEC v1 amendment.\"\n262\t        )\n263\t\n264\t    d = _lessons_dir(base_dir)\n265\t    path = d / f\"{lesson_id}.json\"\n266\t    if not path.is_file():\n267\t        return None\n268\t\n269\t    now = datetime.now(timezone.utc).isoformat()\n270\t    try:\n271\t        data = json.loads(path.read_text(encoding=\"utf-8\"))\n272\t    except (OSError, json.JSONDecodeError):\n273\t        return None\n274\t\n275\t    if hit:\n276\t        data[\"hit_count\"] = int(data.get(\"hit_count\") or 0) + 1\n277\t    else:\n278\t        data[\"miss_count\"] = int(data.get(\"miss_count\") or 0) + 1\n279\t    data[\"last_outcome_at\"] = now\n280\t\n281\t    # Preserve field order; write under lock\n282\t    payload = json.dumps(data, indent=2, ensure_ascii=False) + \"\\n\"\n283\t    if _FILELOCK_AVAILABLE:\n284\t        lock_path = str(d / \".lessons.lock\")\n285\t        try:\n286\t            with FileLock(lock_path, timeout=2.5):\n287\t                path.write_text(payload, encoding=\"utf-8\")\n288\t        except FileLockTimeout:\n289\t            path.write_text(payload, encoding=\"utf-8\")\n290\t    else:\n291\t        path.write_text(payload, encoding=\"utf-8\")\n292\t\n293\t    # Audit event (fail-open)\n294\t    try:\n295\t        from _lib import audit_emit  # noqa: WPS433\n296\t        audit_emit.emit_lesson_outcome(\n297\t            lesson_id=lesson_id,\n298\t            archetype=str(data.get(\"archetype\") or \"\"),\n299\t            hit=hit,\n300\t            hit_count=int(data.get(\"hit_count\") or 0),\n301\t            miss_count=int(data.get(\"miss_count\") or 0),\n302\t            consumer=consumer,\n303\t        )\n304\t    except Exception:\n305\t        pass\n306\t\n307\t    return Lesson(**{k: v for k, v in data.items() if k in Lesson.__dataclass_fields__})\n308\t\n309\t\n310\tdef undo_outcome(\n311\t    lesson_id: str,\n312\t    consumer: str,\n313\t    base_dir: Optional[str] = None,\n314\t) -> Optional[Lesson]:\n315\t    \"\"\"Reverse a single hit/miss increment on a lesson (PLAN-009 P3.3).\n316\t\n317\t    Escape hatch when the Architect inference rule proves bad. Decrements\n318\t    the larger of (hit_count, miss_count) by 1 if > 0. Emits a\n319\t    `lesson_outcome_undone` audit event (schema v2.3).\n320\t\n321\t    Best-effort: returns None on not-found / parse error / both counts\n322\t    already zero. Consumer is validated per ``VALID_CONSUMERS``.\n323\t    \"\"\"\n324\t    if consumer not in VALID_CONSUMERS:\n325\t        raise ValueError(\n326\t            f\"undo_outcome: unknown consumer={consumer!r}. \"\n327\t            f\"Valid values: {sorted(VALID_CONSUMERS)}.\"\n328\t        )\n329\t\n330\t    d = _lessons_dir(base_dir)\n331\t    path = d / f\"{lesson_id}.json\"\n332\t    if not path.is_file():\n333\t        return None\n334\t\n335\t    try:\n336\t        data = json.loads(path.read_text(encoding=\"utf-8\"))\n337\t    except (OSError, json.JSONDecodeError):\n338\t        return None\n339\t\n340\t    hit_count = int(data.get(\"hit_count\") or 0)\n341\t    miss_count = int(data.get(\"miss_count\") or 0)\n342\t\n343\t    if hit_count == 0 and miss_count == 0:\n344\t        return None  # nothing to undo\n345\t\n346\t    # Decrement the larger counter (most recent outcome is ambiguous without\n347\t    # a per-event log, but the larger bucket is the safer guess for undo).\n348\t    if hit_count >= miss_count and hit_count > 0:\n349\t        data[\"hit_count\"] = hit_count - 1\n350\t        undone_kind = \"hit\"\n351\t    elif miss_count > 0:\n352\t        data[\"miss_count\"] = miss_count - 1\n353\t        undone_kind = \"miss\"\n354\t    else:\n355\t        return None\n356\t\n357\t    payload = json.dumps(data, indent=2, ensure_ascii=False) + \"\\n\"\n358\t    if _FILELOCK_AVAILABLE:\n359\t        lock_path = str(d / \".lessons.lock\")\n360\t        try:\n361\t            with FileLock(lock_path, timeout=2.5):\n362\t                path.write_text(payload, encoding=\"utf-8\")\n363\t        except FileLockTimeout:\n364\t            path.write_text(payload, encoding=\"utf-8\")\n365\t    else:\n366\t        path.write_text(payload, encoding=\"utf-8\")\n367\t\n368\t    # Audit event — emit best-effort (fail-open)\n369\t    try:\n370\t        from _lib import audit_emit  # noqa: WPS433\n371\t        audit_emit.emit_lesson_outcome_undone(\n372\t            lesson_id=lesson_id,\n373\t            archetype=str(data.get(\"archetype\") or \"\"),\n374\t            consumer=consumer,\n375\t            undone_kind=undone_kind,\n376\t            hit_count=int(data.get(\"hit_count\") or 0),\n377\t            miss_count=int(data.get(\"miss_count\") or 0),\n378\t        )\n379\t    except Exception:\n380\t        pass\n381\t\n382\t    return Lesson(**{k: v for k, v in data.items() if k in Lesson.__dataclass_fields__})\n383\t\n384\t\n385\tdef build_index(base_dir: Optional[str] = None) -> Path:\n386\t    \"\"\"Regenerate lessons/index.json — lesson metadata for fast top-K.\n387\t\n388\t    PLAN-006 Phase 4 (ADR-015). Writes a compact index so consumers\n389\t    (inject-agent-context) can avoid O(n) file reads on every spawn.\n390\t    Index structure:\n391\t\n392\t        {\n393\t          \"generated_at\": \"ISO8601\",\n394\t          \"lesson_count\": N,\n395\t          \"lessons\": [\n396\t            {\"id\": \"...\", \"archetype\": \"...\", \"scope_tags\": [...],\n397\t             \"hit_count\": X, \"miss_count\": Y, \"created_at\": \"...\"}\n398\t          ]\n399\t        }\n400\t    \"\"\"\n401\t    d = _lessons_dir(base_dir)\n402\t    d.mkdir(parents=True, exist_ok=True)\n403\t    lessons = list_lessons(base_dir)\n404\t    index = {\n405\t        \"generated_at\": datetime.now(timezone.utc).isoformat(),\n406\t        \"lesson_count\": len(lessons),\n407\t        \"lessons\": [\n408\t            {\n409\t                \"id\": l.lesson_id,\n410\t                \"archetype\": l.archetype,\n411\t                \"scope_tags\": l.scope_tags,\n412\t                \"hit_count\": l.hit_count,\n413\t                \"miss_count\": l.miss_count,\n414\t                \"created_at\": l.created_at,\n415\t            }\n416\t            for l in lessons\n417\t        ],\n418\t    }\n419\t    index_path = d / \"index.json\"\n420\t    payload = json.dumps(index, indent=2, ensure_ascii=False) + \"\\n\"\n421\t\n422\t    if _FILELOCK_AVAILABLE:\n423\t        lock_path = str(d / \".lessons.lock\")\n424\t        try:\n425\t            with FileLock(lock_path, timeout=2.5):\n426\t                index_path.write_text(payload, encoding=\"utf-8\")\n427\t        except FileLockTimeout:\n428\t            index_path.write_text(payload, encoding=\"utf-8\")\n429\t    else:\n430\t        index_path.write_text(payload, encoding=\"utf-8\")\n431\t    return index_path\n432\t\n433\t\n434\t# ---------------------------------------------------------------------------\n435\t# PLAN-154 — candidate store (separate namespace: <lessons_dir>/candidates/)\n436\t# ---------------------------------------------------------------------------\n437\t"}]},"parent_tool_use_id":null,"session_id":"0b6cbc95-c175-4ebd-a48b-61e9e70f7284","uuid":"18443308-9a63-4ec5-bbab-44170ef8d189","timestamp":"2026-11-16T20:05:06.625Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_lessons_parts/lessons.py","content":"# Implementation section: globals belong to the lessons facade.\n\nfrom __future__ import annotations\n\n__all__ = ['write_lesson', 'list_lessons', '_archetype_match', '_scope_overlap', '_recency_decay', 'rank_lessons', 'get_top_k', 'record_outcome', 'undo_outcome', 'build_index', 'VALID_CONSUMERS']\n\ndef write_lesson(\n    scenario_id: str,\n    archetype: str,\n    remember_this: str,\n    scope_tags: List[str],\n    agent_response: str = \"\",\n    expected_response: str = \"\",\n    base_dir: Optional[str] = None,\n    trigger: str = \"benchmark_fail\",\n) -> Path:\n    \"\"\"Write a lesson file to disk. Returns the file path.\n\n    Uses a directory-scoped FileLock to serialize writes across processes\n    so that concurrent runners (e.g. parallel benchmark workers) don't\n    corrupt lesson files or emit interleaved audit events.\n    \"\"\"\n    now = datetime.now(timezone.utc).isoformat()\n    lesson_id = _generate_id(scenario_id, now)\n\n    # PLAN-009 P3.6 (K5/A21): scan the lesson body for prompt-injection\n    # patterns BEFORE persisting. Attacker-written lessons become fuel for\n    # the next Architect spawn (they are injected via top-K retrieval).\n    # Advisory: we don't refuse to write, but we emit a breadcrumb +\n    # `injection_flag` audit event so future triage can find compromised\n    # lessons. Fail-open: scanner errors never block lesson writes.\n    try:\n        _scan_lesson_for_injection(\n            text_blob=\"\\n\".join([remember_this, agent_response, expected_response]),\n            lesson_id=lesson_id,\n            archetype=archetype,\n        )\n    except Exception:\n        pass\n\n    lesson = Lesson(\n        lesson_id=lesson_id,\n        created_at=now,\n        scenario_id=scenario_id,\n        archetype=archetype,\n        remember_this=remember_this[:200],\n        scope_tags=scope_tags,\n        agent_response=redact_secrets(agent_response),\n        expected_response=redact_secrets(expected_response),\n    )\n\n    d = _lessons_dir(base_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    path = d / f\"{lesson_id}.json\"\n    payload = json.dumps(asdict(lesson), indent=2, ensure_ascii=False) + \"\\n\"\n\n    if _FILELOCK_AVAILABLE:\n        lock_path = str(d / \".lessons.lock\")\n        try:\n            with FileLock(lock_path, timeout=2.5):\n                path.write_text(payload, encoding=\"utf-8\")\n        except FileLockTimeout:\n            # Fail-open: lock contention is not fatal. Write anyway.\n            path.write_text(payload, encoding=\"utf-8\")\n    else:\n        path.write_text(payload, encoding=\"utf-8\")\n\n    # Emit audit event (fail-open: wrapped in its own try/except)\n    if _AUDIT_EMIT_AVAILABLE:\n        try:\n            _emit_lesson_write(\n                lesson_id=lesson_id,\n                archetype=archetype,\n                scope_tags=scope_tags,\n                trigger=trigger,\n                source_event_id=scenario_id,\n            )\n        except Exception:\n            pass\n\n    return path\n\n\ndef list_lessons(base_dir: Optional[str] = None) -> List[Lesson]:\n    \"\"\"List all lessons, capped at _MAX_SCAN files.\"\"\"\n    d = _lessons_dir(base_dir)\n    if not d.is_dir():\n        return []\n\n    lessons = []\n    count = 0\n    for f in sorted(d.iterdir()):\n        if count >= _MAX_SCAN:\n            break\n        if not f.suffix == \".json\":\n            continue\n        count += 1\n        try:\n            data = json.loads(f.read_text(encoding=\"utf-8\"))\n            # PLAN-154 belt: a candidate record misplaced in the live\n            # top-level dir must NEVER load as a live lesson — candidates\n            # surface only via the verified boot path (A6). Their own\n            # namespace is candidates/ (skipped here as a directory).\n            if isinstance(data, dict) and str(\n                data.get(\"status\") or \"\"\n            ) in CANDIDATE_STATUSES:\n                continue\n            lessons.append(Lesson(**{\n                k: data.get(k, v)\n                for k, v in Lesson().__dict__.items()\n            }))\n        except (json.JSONDecodeError, TypeError, KeyError):\n            continue\n    return lessons\n\n\ndef _archetype_match(lesson_archetype: str, query_archetype: str) -> float:\n    \"\"\"1.0 exact, 0.3 related (same word overlap), 0.0 otherwise.\"\"\"\n    if not lesson_archetype or not query_archetype:\n        return 0.0\n    la = set(lesson_archetype.lower().split())\n    qa = set(query_archetype.lower().split())\n    if la == qa:\n        return 1.0\n    if la & qa:\n        return 0.3\n    return 0.0\n\n\ndef _scope_overlap(lesson_tags: List[str], query_keywords: List[str]) -> float:\n    \"\"\"Jaccard similarity of tag sets.\"\"\"\n    if not lesson_tags or not query_keywords:\n        return 0.0\n    a = set(t.lower() for t in lesson_tags)\n    b = set(k.lower() for k in query_keywords)\n    intersection = len(a & b)\n    union = len(a | b)\n    if union == 0:\n        return 0.0\n    return intersection / union\n\n\ndef _recency_decay(\n    created_at: str,\n    now_fn: Optional[Callable[[], Any]] = None,\n) -> float:\n    \"\"\"exp(-days/90) exponential decay — 90-day e-folding time.\n\n    PLAN-154 A14 docstring fix: the old wording claimed a \"90-day\n    half-life\"; the actual half-life of exp(-days/90) is 90·ln(2) ≈\n    62.4 days (90 days is the e-folding constant, decay ≈ 0.368).\n\n    PLAN-154 A9: injectable ``now_fn`` (wall clock only as default) so\n    decay is deterministic under test — golden-value boundaries,\n    monotonicity, and twice-run-identical are pinned in\n    ``test_lessons_candidates.py``.\n    \"\"\"\n    try:\n        # Parse ISO 8601\n        if created_at.endswith(\"Z\"):\n            created_at = created_at[:-1] + \"+00:00\"\n        dt = datetime.fromisoformat(created_at)\n        if dt.tzinfo is None:\n            dt = dt.replace(tzinfo=timezone.utc)\n        now = _now_utc(now_fn)\n        days = (now - dt).total_seconds() / 86400\n        return math.exp(-days / 90)\n    except (ValueError, TypeError, AttributeError):\n        return 0.5  # neutral if unparseable\n\n\ndef rank_lessons(\n    archetype: str,\n    keywords: List[str],\n    base_dir: Optional[str] = None,\n    now_fn: Optional[Callable[[], Any]] = None,\n) -> List[Lesson]:\n    \"\"\"Return top-3 lessons by relevance score (injection-sized).\"\"\"\n    return get_top_k(archetype, keywords, k=3, base_dir=base_dir, now_fn=now_fn)\n\n\ndef get_top_k(\n    archetype: str,\n    keywords: List[str],\n    k: int = 50,\n    base_dir: Optional[str] = None,\n    now_fn: Optional[Callable[[], Any]] = None,\n) -> List[Lesson]:\n    \"\"\"Return top-K lessons by relevance score, capped by K.\n\n    PLAN-006 Phase 4 (ADR-015, R-VP4 10x scale): hard cap prevents O(n)\n    cross-archetype scoring on every spawn from degrading at scale.\n    Relevance weighted by `archetype_match × scope_overlap ×\n    recency_decay × hit_rate_weight`.\n\n    Default K=50 (ADR-015 scaling envelope). Injection path uses K=3.\n    \"\"\"\n    if k < 1:\n        k = 1\n    if k > 50:\n        k = 50  # hard ceiling per ADR-015\n\n    lessons = list_lessons(base_dir)\n    if not lessons:\n        return []\n\n    scored = []\n    for lesson in lessons:\n        am = _archetype_match(lesson.archetype, archetype)\n        so = _scope_overlap(lesson.scope_tags, keywords)\n        rd = _recency_decay(lesson.created_at, now_fn=now_fn)\n        # Hit-rate weight: untested lessons (n<3) get neutral 1.0;\n        # proven lessons in [0.5, 1.5] range so confirmed winners\n        # (hr=1.0 → hw=1.5) outrank untested ones, while confirmed\n        # losers (hr=0.0 → hw=0.5) are down-weighted but not zeroed\n        # (pruning policy in ADR-017 handles deletion separately).\n        hr = lesson.hit_rate()\n        hw = 1.0 if hr is None else max(0.1, 0.5 + hr)\n        score = am * so * rd * hw\n        if score > 0:\n            scored.append((score, lesson))\n\n    scored.sort(key=lambda x: x[0], reverse=True)\n    return [lesson for _, lesson in scored[:k]]\n\n\n# PLAN-009 P3.2 (C10/A10) — consumer enum is closed; new values require\n# SPEC amendment (SPEC/v1/audit-log.schema.md).\nVALID_CONSUMERS = frozenset({\"benchmark\", \"architect\"})\n\n\ndef record_outcome(\n    lesson_id: str,\n    hit: bool,\n    base_dir: Optional[str] = None,\n    consumer: str = \"benchmark\",\n) -> Optional[Lesson]:\n    \"\"\"Increment hit_count or miss_count on a lesson; update last_outcome_at.\n\n    PLAN-006 Phase 4 (ADR-015); PLAN-009 P3.2 adds ``consumer``\n    parameter. Fail-open — returns None if lesson not found or write\n    fails.\n\n    Args:\n        lesson_id: lesson ID (SHA-256 prefix of scenario_id + created_at)\n        hit: True → increment hit_count; False → miss_count\n        base_dir: optional override for lessons directory (testing)\n        consumer: ``\"benchmark\"`` (default, back-compat) or\n            ``\"architect\"``. New values require SPEC amendment — see\n            ``VALID_CONSUMERS``.\n\n    Raises:\n        ValueError: when ``consumer`` is not in ``VALID_CONSUMERS``.\n            Strict validation at entry prevents silent mis-attribution\n            of Architect outcomes to benchmark aggregates.\n    \"\"\"\n    if consumer not in VALID_CONSUMERS:\n        raise ValueError(\n            f\"record_outcome: unknown consumer={consumer!r}. \"\n            f\"Valid values: {sorted(VALID_CONSUMERS)}. \"\n            \"Adding a new consumer requires SPEC v1 amendment.\"\n        )\n\n    d = _lessons_dir(base_dir)\n    path = d / f\"{lesson_id}.json\"\n    if not path.is_file():\n        return None\n\n    now = datetime.now(timezone.utc).isoformat()\n    try:\n        data = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError):\n        return None\n\n    if hit:\n        data[\"hit_count\"] = int(data.get(\"hit_count\") or 0) + 1\n    else:\n        data[\"miss_count\"] = int(data.get(\"miss_count\") or 0) + 1\n    data[\"last_outcome_at\"] = now\n\n    # Preserve field order; write under lock\n    payload = json.dumps(data, indent=2, ensure_ascii=False) + \"\\n\"\n    if _FILELOCK_AVAILABLE:\n        lock_path = str(d / \".lessons.lock\")\n        try:\n            with FileLock(lock_path, timeout=2.5):\n                path.write_text(payload, encoding=\"utf-8\")\n        except FileLockTimeout:\n            path.write_text(payload, encoding=\"utf-8\")\n    else:\n        path.write_text(payload, encoding=\"utf-8\")\n\n    # Audit event (fail-open)\n    try:\n        from _lib import audit_emit  # noqa: WPS433\n        audit_emit.emit_lesson_outcome(\n            lesson_id=lesson_id,\n            archetype=str(data.get(\"archetype\") or \"\"),\n            hit=hit,\n            hit_count=int(data.get(\"hit_count\") or 0),\n            miss_count=int(data.get(\"miss_count\") or 0),\n            consumer=consumer,\n        )\n    except Exception:\n        pass\n\n    return Lesson(**{k: v for k, v in data.items() if k in Lesson.__dataclass_fields__})\n\n\ndef undo_outcome(\n    lesson_id: str,\n    consumer: str,\n    base_dir: Optional[str] = None,\n) -> Optional[Lesson]:\n    \"\"\"Reverse a single hit/miss increment on a lesson (PLAN-009 P3.3).\n\n    Escape hatch when the Architect inference rule proves bad. Decrements\n    the larger of (hit_count, miss_count) by 1 if > 0. Emits a\n    `lesson_outcome_undone` audit event (schema v2.3).\n\n    Best-effort: returns None on not-found / parse error / both counts\n    already zero. Consumer is validated per ``VALID_CONSUMERS``.\n    \"\"\"\n    if consumer not in VALID_CONSUMERS:\n        raise ValueError(\n            f\"undo_outcome: unknown consumer={consumer!r}. \"\n            f\"Valid values: {sorted(VALID_CONSUMERS)}.\"\n        )\n\n    d = _lessons_dir(base_dir)\n    path = d / f\"{lesson_id}.json\"\n    if not path.is_file():\n        return None\n\n    try:\n        data = json.loads(path.read_text(encoding=\"utf-8\"))\n    except (OSError, json.JSONDecodeError):\n        return None\n\n    hit_count = int(data.get(\"hit_count\") or 0)\n    miss_count = int(data.get(\"miss_count\") or 0)\n\n    if hit_count == 0 and miss_count == 0:\n        return None  # nothing to undo\n\n    # Decrement the larger counter (most recent outcome is ambiguous without\n    # a per-event log, but the larger bucket is the safer guess for undo).\n    if hit_count >= miss_count and hit_count > 0:\n        data[\"hit_count\"] = hit_count - 1\n        undone_kind = \"hit\"\n    elif miss_count > 0:\n        data[\"miss_count\"] = miss_count - 1\n        undone_kind = \"miss\"\n    else:\n        return None\n\n    payload = json.dumps(data, indent=2, ensure_ascii=False) + \"\\n\"\n    if _FILELOCK_AVAILABLE:\n        lock_path = str(d / \".lessons.lock\")\n        try:\n            with FileLock(lock_path, timeout=2.5):\n                path.write_text(payload, encoding=\"utf-8\")\n        except FileLockTimeout:\n            path.write_text(payload, encoding=\"utf-8\")\n    else:\n        path.write_text(payload, encoding=\"utf-8\")\n\n    # Audit event — emit best-effort (fail-open)\n    try:\n        from _lib import audit_emit  # noqa: WPS433\n        audit_emit.emit_lesson_outcome_undone(\n            lesson_id=lesson_id,\n            archetype=str(data.get(\"archetype\") or \"\"),\n            consumer=consumer,\n            undone_kind=undone_kind,\n            hit_count=int(data.get(\"hit_count\") or 0),\n            miss_count=int(data.get(\"miss_count\") or 0),\n        )\n    except Exception:\n        pass\n\n    return Lesson(**{k: v for k, v in data.items() if k in Lesson.__dataclass_fields__})\n\n\ndef build_index(base_dir: Optional[str] = None) -> Path:\n    \"\"\"Regenerate lessons/index.json — lesson metadata for fast top-K.\n\n    PLAN-006 Phase 4 (ADR-015). Writes a compact index so consumers\n    (inject-agent-context) can avoid O(n) file reads on every spawn.\n    Index structure:\n\n        {\n          \"generated_at\": \"ISO8601\",\n          \"lesson_count\": N,\n          \"lessons\": [\n            {\"id\": \"...\", \"archetype\": \"...\", \"scope_tags\": [...],\n             \"hit_count\": X, \"miss_count\": Y, \"created_at\": \"...\"}\n          ]\n        }\n    \"\"\"\n    d = _lessons_dir(base_dir)\n    d.mkdir(parents=True, exist_ok=True)\n    lessons = list_lessons(base_dir)\n    index = {\n        \"generated_at\": datetime.now(timezone.utc).isoformat(),\n        \"lesson_count\": len(lessons),\n        \"lessons\": [\n            {\n                \"id\": l.lesson_id,\n                \"archetype\": l.archetype,\n                \"scope_tags\": l.scope_tags,\n                \"hit_count\": l.hit_count,\n                \"miss_count\": l.miss_count,\n                \"created_at\": l.created_at,\n            }\n            for l in lessons\n        ],\n    }\n    index_path = d / \"index.json\"\n    payload = json.dumps(index, indent=2, ensure_ascii=False) + \"\\n\"\n\n    if _FILELOCK_AVAILABLE:\n        lock_path = str(d / \".lessons.lock\")\n        try:\n            with FileLock(lock_path, timeout=2.5):\n                index_path.write_text(payload, encoding=\"utf-8\")\n        except FileLockTimeout:\n            index_path.write_text(payload, encoding=\"utf-8\")\n    else:\n        index_path.write_text(payload, encoding=\"utf-8\")\n    return index_path\n\n\n# ---------------------------------------------------------------------------\n# PLAN-154 — candidate store (separate namespace: <lessons_dir>/candidates/)\n# ---------------------------------------------------------------------------\n","numLines":437,"startLine":1,"totalLines":437}},"tool_result_meta":[{"id":"toolu_011mPr1yjYLXUtSZPweW7LEx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
