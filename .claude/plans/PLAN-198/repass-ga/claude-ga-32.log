ts/toggles.py\n.claude/plans/PLAN-198/repass-rc1/claude-rc1-31.verdict.txt:32:- Scenario: the code that writes the posture now lives in an importable module. A model-rail `python3 -c` body can put .claude/hooks on sys.path, call _night_mode_parts.install() on a namespace it builds itself, and call cmd_on(). It names neither .claude/scripts/night-mode.py nor settings.local.json, so neither the _e4 matcher nor the _e3 literal scan sees it, and main()'s NF-08b check never runs.\n.claude/plans/PLAN-198/repass-rc1/claude-rc1-31.verdict.txt:34:- Minimal fix: treat the module as a writer by matching `_night_mode_parts` in -c bodies, or move the CI refusal and the self-path guard into cmd_on, cmd_off and cmd_off_discard_snapshot so that calling them through the parts also refuses.\n.claude/scripts/night-mode.py:330:from _lib._night_mode_parts import install as _install_parts\n.claude/scripts/lessons.py:153:from _lib._lessons_parts.config import CANDIDATE_TEXT_MAX_CHARS\n.claude/scripts/lessons.py:204:from _lib._audit_emit_parts import install as _install_lessons_parts\n.claude/scripts/lessons.py:205:_install_lessons_parts(globals(), (\"storage_audit\", \"lessons\", \"candidates\", \"render\", \"cli\"),\n.claude/scripts/lessons.py:206:                       package=\"_lib._lessons_parts\")\n.claude/scripts/lessons.py:207:del _install_lessons_parts"}]},"parent_tool_use_id":null,"session_id":"0b6cbc95-c175-4ebd-a48b-61e9e70f7284","uuid":"8a699036-9f46-41b0-88e4-361413d908f6","timestamp":"2026-11-16T20:05:58.786Z","tool_use_result":{"mode":"content","numFiles":0,"filenames":[],"content":".claude/plans/PLAN-198/repass-rc1/scope-rc1.txt:128:in-scope\t.claude/hooks/_lib/_lessons_parts/__init__.py\n.claude/plans/PLAN-198/repass-rc1/scope-rc1.txt:129:in-scope\t.claude/hooks/_lib/_lessons_parts/candidates.py\n.claude/plans/PLAN-198/repass-rc1/scope-rc1.txt:130:in-scope\t.claude/hooks/_lib/_lessons_parts/cli.py\n.claude/plans/PLAN-198/repass-rc1/scope-rc1.txt:131:in-scope\t.claude/hoo