{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015zgGsah2npNhPjeGoJPiYX","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\tfrom ._shared import *\n3\t\n4\tdef _resolve_codex_cli_shape():  # type: ignore[no-untyped-def]\n5\t    \"\"\"Resolve the NEW non-kernel `_lib.codex_cli_shape` module.\n6\t\n7\t    Mirrors the canonical-layout resolution used elsewhere: the\n8\t    `.claude/hooks/` dir that houses this file also houses `_lib/`. Returns\n9\t    the module or None (fail-OPEN — the caller treats None as\n10\t    CodexUnavailable, the ADR-106 fail-open path). NEVER raises.\n11\t    \"\"\"\n12\t    try:\n13\t        hooks_dir = Path(__file__).resolve().parent\n14\t        if str(hooks_dir) not in sys.path:\n15\t            sys.path.insert(0, str(hooks_dir))\n16\t        from _lib import codex_cli_shape as _shape  # type: ignore\n17\t        return _shape\n18\t    except Exception:\n19\t        return None\n20\t\n21\t# QDSAA-FUNCAO-LONGA: ciclo do subprocesso, arquivo seguro e limpeza permanecem atômicos para não abrir TOCTOU no payload.\n22\tdef _invoke_codex_review(\n23\t    tool_name: str,\n24\t    file_path: str,\n25\t    proposed_content: str,\n26\t    timeout_s: float,\n27\t) -> str:\n28\t    \"\"\"Invoke Codex review on codex-cli 0.139.0; return the REDACTED\n29\t    last-message file content (one structured JSON object) as a str.\n30\t\n31\t    PLAN-142: the verdict is obtained by having the CLI write ONLY the final\n32\t    agent message to a private output file (verified on 0.139: a one-line\n33\t    JSON object). ALL flag-shape lives in the NON-kernel\n34\t    ``_lib.codex_cli_shape`` helper (D2); this kernel function constructs NO\n35\t    argv literals.\n36\t\n37\t    Signature contract UNCHANGED for the consumer: returns a single str.\n38\t    But it is now the isolated last agent message (one structured object),\n39\t    ALREADY single-pass redacted (R-SEC-1 — redaction at the lowest-trust\n40\t    file-read site, before any json.loads in the consumer).\n41\t\n42\t    No env-fixture path (PLAN-163 FXα): the former\n43\t    `CEO_PAIR_RAIL_FIXTURE_RESPONSE` short-circuit was REMOVED from\n44\t    production. Pin verification via `_resolve_codex_bin()` is now\n45\t    UNCONDITIONAL — no env can preset a review or skip the ADR-182 sha\n46\t    gate. Tests inject a Codex review by mocking THIS function at the\n47\t    invoke boundary (`mock.patch.object(<mod>, \"_invoke_codex_review\",\n48\t    return_value=<review>)`); the sha gate is covered directly in\n49\t    `test_check_pair_rail_payload_pin.py`.\n50\t\n51\t    tmpfile TOCTOU hygiene (R-SEC-4 / R-VP-E): a private `mkdtemp(0o700)`\n52\t    dir per call; the output file is pre-created O_CREAT|O_EXCL|0o600 at an\n53\t    absolute path; after the run we REFUSE to read if it is a symlink / not\n54\t    a regular file / not owned by us; `finally:` unlink (output + schema) +\n55\t    rmdir on EVERY exit path (success, read error, timeout, exception).\n56\t\n57\t    Degradation matrix → CodexUnavailable / CodexTimeout / CodexMalformed\n58\t    (all map to ADVISORY in `_decide`), NEVER raise past the typed wall:\n59\t      helper/binary missing, spawn error, non-zero exit → CodexUnavailable;\n60\t      timeout → CodexTimeout; output file missing-after-exit-0 / symlink /\n61\t      non-regular / not-owned / empty / oversize → CodexMalformed.\n62\t\n63\t    ADR-182 (PLAN-163 T5.2) verify-then-invoke: `_resolve_codex_bin()`\n64\t    now returns the VERIFIED native payload path (sha256 checked against\n65\t    the pin manifest) and the subprocess argv below execs EXACTLY that\n66\t    path — the artifact that was hashed is the artifact that runs.\n67\t\n68\t    Raises:\n69\t        CodexUnavailable, CodexTimeout, CodexMalformed (all consumed as\n70\t        ADVISORY fail-open by `_decide`);\n71\t        CodexPinMismatch (ADR-182 fail-CLOSED — consumed as a BLOCK by\n72\t        `_decide`, never advisory).\n73\t    \"\"\"\n74\t    import os as _os  # local alias to avoid any chance of shadowing\n75\t    import stat as _stat\n76\t    import tempfile as _tempfile\n77\t\n78\t    # PLAN-163 FXα: the CEO_PAIR_RAIL_FIXTURE_RESPONSE short-circuit was\n79\t    # REMOVED from production entirely. Pin verification is now\n80\t    # UNCONDITIONAL — no env (test-mode or otherwise) injects a preset\n81\t    # review before _resolve_codex_bin(), so \"no env relaxes the sha\n82\t    # verification\" is literally true. Tests inject a Codex review by\n83\t    # mocking THIS function (_invoke_codex_review) at the invoke boundary,\n84\t    # never via env; the ADR-182 sha gate is exercised directly in\n85\t    # test_check_pair_rail_payload_pin.py.\n86\t\n87\t    # ADR-182: may raise CodexPinMismatch (fail-CLOSED) — deliberately\n88\t    # NOT caught here; `_decide` maps it to `{decision: block}`.\n89\t    codex_bin = _resolve_codex_bin()\n90\t    if codex_bin is None:\n91\t        raise CodexUnavailable(\n92\t            \"codex binary not on PATH (or ADR-182 pin verification \"\n93\t            \"hit an INFRA arm — see pair_rail_codex_unavailable audit)\"\n94\t        )\n95\t\n96\t    shape = _resolve_codex_cli_shape()\n97\t    if shape is None:\n98\t        # The single argv builder is gone/unimportable. Fail-OPEN to\n99\t        # ADVISORY rather than hand-roll a (possibly rejected) argv.\n100\t        raise CodexUnavailable(\"codex_cli_shape helper unavailable\")\n101\t\n102\t    prompt = _build_codex_prompt(tool_name, file_path, proposed_content)\n103\t    # PLAN-084 Wave 0.5 (ADR-114 + AC9 — Codex egress redaction symmetry).\n104\t    # proposed_content is raw FILE CONTENT being reviewed (potentially\n105\t    # secret-laden source). Redact the OUTGOING prompt BEFORE it leaves the\n106\t    # framework. This stays fail-CLOSED per ADR-114: a redactor-import\n107\t    # failure REFUSES to ship the prompt.\n108\t    try:\n109\t        from _lib import codex_egress_redact as _redact\n110\t        _egress_bytes = len(prompt.encode(\"utf-8\", \"replace\")) if isinstance(prompt, str) else 0\n111\t        prompt, _egress_findings = _redact.redact_outgoing_with_findings(prompt)\n112\t    except ImportError:\n113\t        # Fail-CLOSED per ADR-114: refuse to ship unredacted prompt to Codex.\n114\t        raise CodexUnavailable(\"codex_egress_redact unavailable — fail-CLOSED per ADR-114\")\n115\t    # PLAN-112-FOLLOWUP-codex-egress-proof-telemetry (F-7.9): positive-proof\n116\t    # emit on EVERY outbound redaction (empty allowed). Fail-OPEN — wraps ONLY\n117\t    # the emit; the redact above stays fail-CLOSED per ADR-114.\n118\t    try:\n119\t        from _lib import audit_emit as _ae\n120\t        _ae.emit_pair_rail_outgoing_redaction_applied(\n121\t            signal=\"outbound\",\n122\t            match_count=len(_egress_findings),\n123\t            bytes_scanned=_egress_bytes,\n124\t            callsite=\"check_pair_rail.py:_invoke_codex_review\",\n125\t            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n126\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n127\t        )\n128\t    except Exception:\n129\t        pass\n130\t\n131\t    # -----------------------------------------------------------------\n132\t    # tmpfile setup — we own the dir (0o700) and pre-create the output\n133\t    # file with O_EXCL|0o600 to win the symlink race; the CLI writes to it\n134\t    # by absolute path. A sibling schema file (written by US, not the\n135\t    # untrusted binary) carries the CLI-enforced verdict shape.\n136\t    # -----------------------------------------------------------------\n137\t    tmp_dir = _tempfile.mkdtemp(prefix=\"ceo_pairrail_\")\n138\t    try:\n139\t        _os.chmod(tmp_dir, 0o700)\n140\t    except OSError:\n141\t        pass  # mkdtemp already creates 0o700 on POSIX\n142\t    out_path = _os.path.join(tmp_dir, \"codex_last_message.json\")\n143\t    schema_path = _os.path.join(tmp_dir, \"codex_verdict_schema.json\")\n144\t\n145\t    def _cleanup() -> None:\n146\t        \"\"\"Unlink both tmpfiles + rmdir the dir; never raises.\"\"\"\n147\t        for _p in (out_path, schema_path):\n148\t            try:\n149\t                _os.unlink(_p)\n150\t            except OSError:\n151\t                pass\n152\t        try:\n153\t            _os.rmdir(tmp_dir)\n154\t        except OSError:\n155\t            pass\n156\t\n157\t    try:\n158\t        # Pre-create O_CREAT|O_EXCL|0o600 — if a symlink/file already sits\n159\t        # at out_path, O_EXCL fails and we treat it as unavailable.\n160\t        try:\n161\t            fd = _os.open(out_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n162\t            _os.close(fd)\n163\t        except FileNotFoundError:\n164\t            raise CodexUnavailable(\"tmpdir vanished before pre-create\")\n165\t        except FileExistsError:\n166\t            raise CodexUnavailable(\"tmpfile pre-create lost O_EXCL race\")\n167\t        except OSError as e:\n168\t            raise CodexUnavailable(f\"tmpfile pre-create failed: {type(e).__name__}\")\n169\t\n170\t        # Write the CLI-enforced verdict schema to our schema tmpfile\n171\t        # (PLAN-142 §3 [P1], R-SEC-2). Best-effort: if the helper cannot\n172\t        # serialize it, proceed WITHOUT enforcement (parser-side\n173\t        # parse_verdict_strict still validates the shape).\n174\t        schema_arg: Optional[str] = None\n175\t        try:\n176\t            schema_json = shape.verdict_output_schema_json()\n177\t            sfd = _os.open(schema_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n178\t            try:\n179\t                _os.write(sfd, schema_json.encode(\"utf-8\"))\n180\t            finally:\n181\t                _os.close(sfd)\n182\t            schema_arg = schema_path\n183\t        except Exception:\n184\t            schema_arg = None\n185\t\n186\t        # Build argv via the NON-kernel helper. The live-rail shape writes\n187\t        # the verdict to our output file and drops usage telemetry (R-SEC-5);\n188\t        # we pass only semantic intent — the helper owns flag names, the\n189\t        # model id, and the dead-flag migration.\n190\t        try:\n191\t            cli_args = shape.build_verdict_argv(\n192\t                prompt,\n193\t                output_file=out_path,\n194\t                schema_file=schema_arg,\n195\t            )\n196\t        except Exception as e:\n197\t            raise CodexUnavailable(\n198\t                f\"codex_cli_shape.build_verdict_argv failed: {type(e).__name__}\"\n199\t            )\n200\t        if not isinstance(cli_args, (list, tuple)) or not cli_args:\n201\t            raise CodexUnavailable(\"codex_cli_shape returned empty argv\")\n202\t\n203\t        # ADR-182 verify-then-invoke: `codex_bin` is the VERIFIED native\n204\t        # payload path returned by `_resolve_codex_bin()` (or the\n205\t        # test-only CEO_PAIR_RAIL_CODEX_BIN override). Invoking the\n206\t        # exact verified path — not `codex` re-resolved from $PATH —\n207\t        # closes the hash-launcher/execute-payload gap of the retired\n208\t        # codex-cli-binary-sha256.txt pin.\n209\t        cmd = [codex_bin] + list(cli_args)\n210\t\n211\t        # Invoke. The prompt is the trailing positional built by the helper;\n212\t        # close stdin via input=\"\" so the child never blocks on a pipe.\n213\t        try:\n214\t            proc = subprocess.run(\n215\t                cmd,\n216\t                input=\"\",\n217\t                capture_output=True,\n218\t                text=True,\n219\t                timeout=timeout_s,\n220\t                check=False,\n221\t            )\n222\t        except subprocess.TimeoutExpired:\n223\t            raise CodexTimeout(f\"codex invoke exceeded {timeout_s}s\")\n224\t        except (FileNotFoundError, PermissionError, OSError, ConnectionError) as e:\n225\t            raise CodexUnavailable(f\"codex invoke failed: {type(e).__name__}: {e}\")\n226\t        except ValueError as e:\n227\t            # UnicodeDecodeError IS-A ValueError; map to malformed so\n228\t            # `_decide` degrades to ADVISORY (preserve concrete name).\n229\t            raise CodexMalformed(f\"codex invoke {type(e).__name__}: {e}\")\n230\t\n231\t        # Post-subprocess audit breadcrumb (UNCHANGED behavior).\n232\t        try:\n233\t            from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n234\t            if hasattr(_ae, \"emit_generic\"):\n235\t                _ae.emit_generic(\"codex_invoke_dispatched\", exit_code=int(proc.returncode))\n236\t        except Exception:\n237\t            pass\n238\t\n239\t        if proc.returncode != 0:\n240\t            # Non-zero exit → unavailable (fail-OPEN). A present output file\n241\t            # after a non-zero exit is IGNORED (not read) and cleaned up.\n242\t            raise CodexUnavailable(\n243\t                f\"codex returned exit={proc.returncode}; stderr_head=\"\n244\t                f\"{(proc.stderr or '')[:240]!r}\"\n245\t            )\n246\t\n247\t        # -------------------------------------------------------------\n248\t        # Read back the output file with TOCTOU re-validation. Re-stat via\n249\t        # os.lstat (NOT following symlinks) and refuse anything that is not\n250\t        # a regular file we own.\n251\t        # -------------------------------------------------------------\n252\t        try:\n253\t            st = _os.lstat(out_path)\n254\t        except FileNotFoundError:\n255\t            raise CodexMalformed(\"codex last-message file missing after exit-0\")\n256\t        except OSError as e:\n257\t            raise CodexMalformed(f\"codex last-message lstat failed: {type(e).__name__}\")\n258\t\n259\t        if _stat.S_ISLNK(st.st_mode):\n260\t            raise CodexMalformed(\"codex last-message path is a symlink; refusing to read\")\n261\t        if not _stat.S_ISREG(st.st_mode):\n262\t            raise CodexMalformed(\"codex last-message path is not a regular file; refusing\")\n263\t        try:\n264\t            if st.st_uid != _os.getuid():\n265\t                raise CodexMalformed(\"codex last-message file not owned by us; refusing\")\n266\t        except AttributeError:\n267\t            # os.getuid absent (non-POSIX) — the 0o700 mkdtemp + O_EXCL\n268\t            # pre-create are the primary controls; skip the uid check.\n269\t            pass\n270\t        if st.st_size == 0:\n271\t            raise CodexMalformed(\"codex last-message file is empty\")\n272\t        if st.st_size > _MAX_OUTPUT_FILE_BYTES:\n273\t            raise CodexMalformed(\n274\t                f\"codex last-message oversize ({st.st_size} > {_MAX_OUTPUT_FILE_BYTES})\"\n275\t            )\n276\t\n277\t        # Open refusing to follow a symlink swapped in post-lstat.\n278\t        try:\n279\t            open_flags = _os.O_RDONLY\n280\t            if hasattr(_os, \"O_NOFOLLOW\"):\n281\t                open_flags |= _os.O_NOFOLLOW\n282\t            rfd = _os.open(out_path, open_flags)\n283\t        except OSError as e:\n284\t            raise CodexMalformed(f\"codex last-message open failed: {type(e).__name__}\")\n285\t        try:\n286\t            raw_bytes = _os.read(rfd, _MAX_OUTPUT_FILE_BYTES + 1)\n287\t        finally:\n288\t            try:\n289\t                _os.close(rfd)\n290\t            except OSError:\n291\t                pass\n292\t        if len(raw_bytes) > _MAX_OUTPUT_FILE_BYTES:\n293\t            raise CodexMalformed(\"codex last-message grew past cap during read\")\n294\t\n295\t        content = raw_bytes.decode(\"utf-8\", errors=\"replace\")\n296\t\n297\t        # -------------------------------------------------------------\n298\t        # SINGLE-PASS redact the FULL byte-string BEFORE returning (and\n299\t        # thus before any json.loads in the consumer). R-SEC-1. Ingress\n300\t        # redaction is fail-OPEN to ADVISORY (distinct from the ADR-114\n301\t        # fail-CLOSED *egress* contract above): if the redactor is\n302\t        # unavailable we refuse to hand un-redacted text to the parser and\n303\t        # degrade to ADVISORY via CodexMalformed.\n304\t        # -------------------------------------------------------------\n305\t        try:\n306\t            from _lib import codex_egress_redact as _redact  # noqa: F811\n307\t            redacted = _redact.redact(content)\n308\t        except Exception:\n309\t            raise CodexMalformed(\n310\t                \"codex_egress_redact unavailable on ingress; refusing raw parse\"\n311\t            )\n312\t        return redacted\n313\t    finally:\n314\t        _cleanup()\n315\t\n316\tdef _sentinel_grants_pair_rail_bypass(\n317\t    file_path: str, repo_root: Path\n318\t) -> bool:\n319\t    \"\"\"True if any Architect sentinel covers `file_path` in its scope.\n320\t\n321\t    Production: piggybacks on `check_canonical_edit._sentinel_grants_path`\n322\t    if that helper is importable. Otherwise returns False (no bypass).\n323\t    \"\"\"\n324\t    try:\n325\t        # Best-effort import; staging file should not depend on\n326\t        # production import path. Fail soft.\n327\t        hooks_dir = repo_root / \".claude\" / \"hooks\"\n328\t        if str(hooks_dir) not in sys.path:\n329\t            sys.path.insert(0, str(hooks_dir))\n330\t        try:\n331\t            import check_canonical_edit as _cce  # type: ignore\n332\t        except Exception:\n333\t            return False\n334\t        try:\n335\t            rel = (\n336\t                Path(file_path).resolve().relative_to(repo_root.resolve())\n337\t            )\n338\t        except (ValueError, OSError):\n339\t            return False\n340\t        rel_str = str(rel).replace(os.sep, \"/\")\n341\t        sentinels = _cce._find_sentinels(repo_root)  # type: ignore[attr-defined]\n342\t        for sentinel in sentinels:\n343\t            try:\n344\t                if _cce._sentinel_grants_path(sentinel, rel_str):  # type: ignore[attr-defined]\n345\t                    return True\n346\t            except Exception:\n347\t                continue\n348\t        return False\n349\t    except Exception:\n350\t        return False"}]},"parent_tool_use_id":null,"session_id":"fff1c582-0add-4cc7-a8a5-0376027f1063","uuid":"faad3712-d4cb-4760-95f5-144b20589b81","timestamp":"2026-11-16T19:28:06.619Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_pair_rail_parts/part_02.py","content":"from __future__ import annotations\nfrom ._shared import *\n\ndef _resolve_codex_cli_shape():  # type: ignore[no-untyped-def]\n    \"\"\"Resolve the NEW non-kernel `_lib.codex_cli_shape` module.\n\n    Mirrors the canonical-layout resolution used elsewhere: the\n    `.claude/hooks/` dir that houses this file also houses `_lib/`. Returns\n    the module or None (fail-OPEN — the caller treats None as\n    CodexUnavailable, the ADR-106 fail-open path). NEVER raises.\n    \"\"\"\n    try:\n        hooks_dir = Path(__file__).resolve().parent\n        if str(hooks_dir) not in sys.path:\n            sys.path.insert(0, str(hooks_dir))\n        from _lib import codex_cli_shape as _shape  # type: ignore\n        return _shape\n    except Exception:\n        return None\n\n# QDSAA-FUNCAO-LONGA: ciclo do subprocesso, arquivo seguro e limpeza permanecem atômicos para não abrir TOCTOU no payload.\ndef _invoke_codex_review(\n    tool_name: str,\n    file_path: str,\n    proposed_content: str,\n    timeout_s: float,\n) -> str:\n    \"\"\"Invoke Codex review on codex-cli 0.139.0; return the REDACTED\n    last-message file content (one structured JSON object) as a str.\n\n    PLAN-142: the verdict is obtained by having the CLI write ONLY the final\n    agent message to a private output file (verified on 0.139: a one-line\n    JSON object). ALL flag-shape lives in the NON-kernel\n    ``_lib.codex_cli_shape`` helper (D2); this kernel function constructs NO\n    argv literals.\n\n    Signature contract UNCHANGED for the consumer: returns a single str.\n    But it is now the isolated last agent message (one structured object),\n    ALREADY single-pass redacted (R-SEC-1 — redaction at the lowest-trust\n    file-read site, before any json.loads in the consumer).\n\n    No env-fixture path (PLAN-163 FXα): the former\n    `CEO_PAIR_RAIL_FIXTURE_RESPONSE` short-circuit was REMOVED from\n    production. Pin verification via `_resolve_codex_bin()` is now\n    UNCONDITIONAL — no env can preset a review or skip the ADR-182 sha\n    gate. Tests inject a Codex review by mocking THIS function at the\n    invoke boundary (`mock.patch.object(<mod>, \"_invoke_codex_review\",\n    return_value=<review>)`); the sha gate is covered directly in\n    `test_check_pair_rail_payload_pin.py`.\n\n    tmpfile TOCTOU hygiene (R-SEC-4 / R-VP-E): a private `mkdtemp(0o700)`\n    dir per call; the output file is pre-created O_CREAT|O_EXCL|0o600 at an\n    absolute path; after the run we REFUSE to read if it is a symlink / not\n    a regular file / not owned by us; `finally:` unlink (output + schema) +\n    rmdir on EVERY exit path (success, read error, timeout, exception).\n\n    Degradation matrix → CodexUnavailable / CodexTimeout / CodexMalformed\n    (all map to ADVISORY in `_decide`), NEVER raise past the typed wall:\n      helper/binary missing, spawn error, non-zero exit → CodexUnavailable;\n      timeout → CodexTimeout; output file missing-after-exit-0 / symlink /\n      non-regular / not-owned / empty / oversize → CodexMalformed.\n\n    ADR-182 (PLAN-163 T5.2) verify-then-invoke: `_resolve_codex_bin()`\n    now returns the VERIFIED native payload path (sha256 checked against\n    the pin manifest) and the subprocess argv below execs EXACTLY that\n    path — the artifact that was hashed is the artifact that runs.\n\n    Raises:\n        CodexUnavailable, CodexTimeout, CodexMalformed (all consumed as\n        ADVISORY fail-open by `_decide`);\n        CodexPinMismatch (ADR-182 fail-CLOSED — consumed as a BLOCK by\n        `_decide`, never advisory).\n    \"\"\"\n    import os as _os  # local alias to avoid any chance of shadowing\n    import stat as _stat\n    import tempfile as _tempfile\n\n    # PLAN-163 FXα: the CEO_PAIR_RAIL_FIXTURE_RESPONSE short-circuit was\n    # REMOVED from production entirely. Pin verification is now\n    # UNCONDITIONAL — no env (test-mode or otherwise) injects a preset\n    # review before _resolve_codex_bin(), so \"no env relaxes the sha\n    # verification\" is literally true. Tests inject a Codex review by\n    # mocking THIS function (_invoke_codex_review) at the invoke boundary,\n    # never via env; the ADR-182 sha gate is exercised directly in\n    # test_check_pair_rail_payload_pin.py.\n\n    # ADR-182: may raise CodexPinMismatch (fail-CLOSED) — deliberately\n    # NOT caught here; `_decide` maps it to `{decision: block}`.\n    codex_bin = _resolve_codex_bin()\n    if codex_bin is None:\n        raise CodexUnavailable(\n            \"codex binary not on PATH (or ADR-182 pin verification \"\n            \"hit an INFRA arm — see pair_rail_codex_unavailable audit)\"\n        )\n\n    shape = _resolve_codex_cli_shape()\n    if shape is None:\n        # The single argv builder is gone/unimportable. Fail-OPEN to\n        # ADVISORY rather than hand-roll a (possibly rejected) argv.\n        raise CodexUnavailable(\"codex_cli_shape helper unavailable\")\n\n    prompt = _build_codex_prompt(tool_name, file_path, proposed_content)\n    # PLAN-084 Wave 0.5 (ADR-114 + AC9 — Codex egress redaction symmetry).\n    # proposed_content is raw FILE CONTENT being reviewed (potentially\n    # secret-laden source). Redact the OUTGOING prompt BEFORE it leaves the\n    # framework. This stays fail-CLOSED per ADR-114: a redactor-import\n    # failure REFUSES to ship the prompt.\n    try:\n        from _lib import codex_egress_redact as _redact\n        _egress_bytes = len(prompt.encode(\"utf-8\", \"replace\")) if isinstance(prompt, str) else 0\n        prompt, _egress_findings = _redact.redact_outgoing_with_findings(prompt)\n    except ImportError:\n        # Fail-CLOSED per ADR-114: refuse to ship unredacted prompt to Codex.\n        raise CodexUnavailable(\"codex_egress_redact unavailable — fail-CLOSED per ADR-114\")\n    # PLAN-112-FOLLOWUP-codex-egress-proof-telemetry (F-7.9): positive-proof\n    # emit on EVERY outbound redaction (empty allowed). Fail-OPEN — wraps ONLY\n    # the emit; the redact above stays fail-CLOSED per ADR-114.\n    try:\n        from _lib import audit_emit as _ae\n        _ae.emit_pair_rail_outgoing_redaction_applied(\n            signal=\"outbound\",\n            match_count=len(_egress_findings),\n            bytes_scanned=_egress_bytes,\n            callsite=\"check_pair_rail.py:_invoke_codex_review\",\n            session_id=os.environ.get(\"CLAUDE_SESSION_ID\", \"\"),\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:\n        pass\n\n    # -----------------------------------------------------------------\n    # tmpfile setup — we own the dir (0o700) and pre-create the output\n    # file with O_EXCL|0o600 to win the symlink race; the CLI writes to it\n    # by absolute path. A sibling schema file (written by US, not the\n    # untrusted binary) carries the CLI-enforced verdict shape.\n    # -----------------------------------------------------------------\n    tmp_dir = _tempfile.mkdtemp(prefix=\"ceo_pairrail_\")\n    try:\n        _os.chmod(tmp_dir, 0o700)\n    except OSError:\n        pass  # mkdtemp already creates 0o700 on POSIX\n    out_path = _os.path.join(tmp_dir, \"codex_last_message.json\")\n    schema_path = _os.path.join(tmp_dir, \"codex_verdict_schema.json\")\n\n    def _cleanup() -> None:\n        \"\"\"Unlink both tmpfiles + rmdir the dir; never raises.\"\"\"\n        for _p in (out_path, schema_path):\n            try:\n                _os.unlink(_p)\n            except OSError:\n                pass\n        try:\n            _os.rmdir(tmp_dir)\n        except OSError:\n            pass\n\n    try:\n        # Pre-create O_CREAT|O_EXCL|0o600 — if a symlink/file already sits\n        # at out_path, O_EXCL fails and we treat it as unavailable.\n        try:\n            fd = _os.open(out_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n            _os.close(fd)\n        except FileNotFoundError:\n            raise CodexUnavailable(\"tmpdir vanished before pre-create\")\n        except FileExistsError:\n            raise CodexUnavailable(\"tmpfile pre-create lost O_EXCL race\")\n        except OSError as e:\n            raise CodexUnavailable(f\"tmpfile pre-create failed: {type(e).__name__}\")\n\n        # Write the CLI-enforced verdict schema to our schema tmpfile\n        # (PLAN-142 §3 [P1], R-SEC-2). Best-effort: if the helper cannot\n        # serialize it, proceed WITHOUT enforcement (parser-side\n        # parse_verdict_strict still validates the shape).\n        schema_arg: Optional[str] = None\n        try:\n            schema_json = shape.verdict_output_schema_json()\n            sfd = _os.open(schema_path, _os.O_CREAT | _os.O_EXCL | _os.O_WRONLY, 0o600)\n            try:\n                _os.write(sfd, schema_json.encode(\"utf-8\"))\n            finally:\n                _os.close(sfd)\n            schema_arg = schema_path\n        except Exception:\n            schema_arg = None\n\n        # Build argv via the NON-kernel helper. The live-rail shape writes\n        # the verdict to our output file and drops usage telemetry (R-SEC-5);\n        # we pass only semantic intent — the helper owns flag names, the\n        # model id, and the dead-flag migration.\n        try:\n            cli_args = shape.build_verdict_argv(\n                prompt,\n                output_file=out_path,\n                schema_file=schema_arg,\n            )\n        except Exception as e:\n            raise CodexUnavailable(\n                f\"codex_cli_shape.build_verdict_argv failed: {type(e).__name__}\"\n            )\n        if not isinstance(cli_args, (list, tuple)) or not cli_args:\n            raise CodexUnavailable(\"codex_cli_shape returned empty argv\")\n\n        # ADR-182 verify-then-invoke: `codex_bin` is the VERIFIED native\n        # payload path returned by `_resolve_codex_bin()` (or the\n        # test-only CEO_PAIR_RAIL_CODEX_BIN override). Invoking the\n        # exact verified path — not `codex` re-resolved from $PATH —\n        # closes the hash-launcher/execute-payload gap of the retired\n        # codex-cli-binary-sha256.txt pin.\n        cmd = [codex_bin] + list(cli_args)\n\n        # Invoke. The prompt is the trailing positional built by the helper;\n        # close stdin via input=\"\" so the child never blocks on a pipe.\n        try:\n            proc = subprocess.run(\n                cmd,\n                input=\"\",\n                capture_output=True,\n                text=True,\n                timeout=timeout_s,\n                check=False,\n            )\n        except subprocess.TimeoutExpired:\n            raise CodexTimeout(f\"codex invoke exceeded {timeout_s}s\")\n        except (FileNotFoundError, PermissionError, OSError, ConnectionError) as e:\n            raise CodexUnavailable(f\"codex invoke failed: {type(e).__name__}: {e}\")\n        except ValueError as e:\n            # UnicodeDecodeError IS-A ValueError; map to malformed so\n            # `_decide` degrades to ADVISORY (preserve concrete name).\n            raise CodexMalformed(f\"codex invoke {type(e).__name__}: {e}\")\n\n        # Post-subprocess audit breadcrumb (UNCHANGED behavior).\n        try:\n            from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            if hasattr(_ae, \"emit_generic\"):\n                _ae.emit_generic(\"codex_invoke_dispatched\", exit_code=int(proc.returncode))\n        except Exception:\n            pass\n\n        if proc.returncode != 0:\n            # Non-zero exit → unavailable (fail-OPEN). A present output file\n            # after a non-zero exit is IGNORED (not read) and cleaned up.\n            raise CodexUnavailable(\n                f\"codex returned exit={proc.returncode}; stderr_head=\"\n                f\"{(proc.stderr or '')[:240]!r}\"\n            )\n\n        # -------------------------------------------------------------\n        # Read back the output file with TOCTOU re-validation. Re-stat via\n        # os.lstat (NOT following symlinks) and refuse anything that is not\n        # a regular file we own.\n        # -------------------------------------------------------------\n        try:\n            st = _os.lstat(out_path)\n        except FileNotFoundError:\n            raise CodexMalformed(\"codex last-message file missing after exit-0\")\n        except OSError as e:\n            raise CodexMalformed(f\"codex last-message lstat failed: {type(e).__name__}\")\n\n        if _stat.S_ISLNK(st.st_mode):\n            raise CodexMalformed(\"codex last-message path is a symlink; refusing to read\")\n        if not _stat.S_ISREG(st.st_mode):\n            raise CodexMalformed(\"codex last-message path is not a regular file; refusing\")\n        try:\n            if st.st_uid != _os.getuid():\n                raise CodexMalformed(\"codex last-message file not owned by us; refusing\")\n        except AttributeError:\n            # os.getuid absent (non-POSIX) — the 0o700 mkdtemp + O_EXCL\n            # pre-create are the primary controls; skip the uid check.\n            pass\n        if st.st_size == 0:\n            raise CodexMalformed(\"codex last-message file is empty\")\n        if st.st_size > _MAX_OUTPUT_FILE_BYTES:\n            raise CodexMalformed(\n                f\"codex last-message oversize ({st.st_size} > {_MAX_OUTPUT_FILE_BYTES})\"\n            )\n\n        # Open refusing to follow a symlink swapped in post-lstat.\n        try:\n            open_flags = _os.O_RDONLY\n            if hasattr(_os, \"O_NOFOLLOW\"):\n                open_flags |= _os.O_NOFOLLOW\n            rfd = _os.open(out_path, open_flags)\n        except OSError as e:\n            raise CodexMalformed(f\"codex last-message open failed: {type(e).__name__}\")\n        try:\n            raw_bytes = _os.read(rfd, _MAX_OUTPUT_FILE_BYTES + 1)\n        finally:\n            try:\n                _os.close(rfd)\n            except OSError:\n                pass\n        if len(raw_bytes) > _MAX_OUTPUT_FILE_BYTES:\n            raise CodexMalformed(\"codex last-message grew past cap during read\")\n\n        content = raw_bytes.decode(\"utf-8\", errors=\"replace\")\n\n        # -------------------------------------------------------------\n        # SINGLE-PASS redact the FULL byte-string BEFORE returning (and\n        # thus before any json.loads in the consumer). R-SEC-1. Ingress\n        # redaction is fail-OPEN to ADVISORY (distinct from the ADR-114\n        # fail-CLOSED *egress* contract above): if the redactor is\n        # unavailable we refuse to hand un-redacted text to the parser and\n        # degrade to ADVISORY via CodexMalformed.\n        # -------------------------------------------------------------\n        try:\n            from _lib import codex_egress_redact as _redact  # noqa: F811\n            redacted = _redact.redact(content)\n        except Exception:\n            raise CodexMalformed(\n                \"codex_egress_redact unavailable on ingress; refusing raw parse\"\n            )\n        return redacted\n    finally:\n        _cleanup()\n\ndef _sentinel_grants_pair_rail_bypass(\n    file_path: str, repo_root: Path\n) -> bool:\n    \"\"\"True if any Architect sentinel covers `file_path` in its scope.\n\n    Production: piggybacks on `check_canonical_edit._sentinel_grants_path`\n    if that helper is importable. Otherwise returns False (no bypass).\n    \"\"\"\n    try:\n        # Best-effort import; staging file should not