{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EAm9Dz8F7oiguWaaAYbthP","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\tfrom ._shared import *\n3\t\n4\t# QDSAA-FUNCAO-LONGA: evento forense completo mantém campos correlatos; separar normalização poderia publicar retrato parcial.\n5\tdef _emit_pair_rail_review_expected(\n6\t    *,\n7\t    tool_name: str,\n8\t    session_id: str = \"\",\n9\t    file_path: str = \"\",\n10\t    review_id: str = \"\",\n11\t    timeout_s: float = 0.0,\n12\t) -> None:\n13\t    \"\"\"Best-effort audit emit of pair_rail_review_expected. Fail-OPEN.\n14\t\n15\t    PLAN-161 C5 (r3 F2 + r4 F1): the durable session-correlated DENOMINATOR\n16\t    for the /ceo-boot `pair_rail` activity-conditioned liveness row. Called\n17\t    from `_decide()` only after the kill-switch / non-write-tool / not-L3+ /\n18\t    sentinel-bypass arms have all returned — i.e. a Codex review is\n19\t    definitely being ENTERED.\n20\t\n21\t    r5 F2: ``review_id`` is the per-invocation correlation id generated at\n22\t    review entry (`os.urandom(8).hex()`, 16-hex). The SAME id rides this\n23\t    emit AND the matching `pair_rail_case` emit of the same `_decide()`\n24\t    invocation, so the /ceo-boot deficit pairs invocation-exact — counting\n25\t    (even (session, file-hash)-bucketed) cannot pair a specific expected\n26\t    with its OWN case. Forwarded only when the resolved audit_emit's\n27\t    signature accepts it (``__kwdefaults__`` probe), so a version-skewed\n28\t    audit_emit degrades to the id-less legacy emit instead of a TypeError\n29\t    that would swallow the whole event (fail-open regression class).\n30\t\n31\t    r4 F2 (kept as the legacy fallback + harmless secondary key):\n32\t    ``file_path`` is hashed here with the SAME helper the\n33\t    `pair_rail_case` emit uses (`_hash_file_path_prefix` — 16-hex SHA-256\n34\t    prefix, raw path NEVER on the wire per LLM06) so id-less events can\n35\t    still pair per (session, file-hash) BUCKET.\n36\t\n37\t    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n38\t    budget for this invocation in SECONDS (resolved in `main()`, threaded\n39\t    through `_decide_with_matrix` → `_decide`). It exists so a case F\n40\t    caused by a sub-floor `CEO_PAIR_RAIL_TIMEOUT_S` export stops being\n41\t    indistinguishable from a genuine Codex outage (§4(i) residual — the\n42\t    quiet knob was stealthier than the documented kill-switch). It reaches\n43\t    the wire as the INTEGER-millisecond `timeout_ms` (see `_timeout_ms`:\n44\t    canonical_json forbids floats in HMAC-covered fields), forwarded under\n45\t    the SAME `__kwdefaults__` skew guard as `review_id`.\n46\t\n47\t    Import resolution mirrors `_emit_pair_rail_case` (staged-dir override →\n48\t    canonical layout → PYTHONPATH). hasattr-guarded: a pre-ceremony\n49\t    audit_emit without `emit_pair_rail_review_expected` is a silent no-op.\n50\t    Deliberately NO `CEO_PAIR_RAIL_AUDIT_SINK` write — the sink is the\n51\t    matrix tests' `pair_rail_case` capture surface and must not grow\n52\t    extra rows under their counts.\n53\t    \"\"\"\n54\t    _ae = None\n55\t    try:\n56\t        # Resolution 1: test-only staged-dir override.\n57\t        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n58\t        if staged_dir:\n59\t            staged_path = Path(staged_dir)\n60\t            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n61\t                if str(staged_path) not in sys.path:\n62\t                    sys.path.insert(0, str(staged_path))\n63\t                try:\n64\t                    from _lib import audit_emit as _ae  # type: ignore\n65\t                except Exception:\n66\t                    _ae = None\n67\t        # Resolution 2: canonical layout.\n68\t        if _ae is None:\n69\t            hooks_dir = Path(__file__).resolve().parent\n70\t            if str(hooks_dir) not in sys.path:\n71\t                sys.path.insert(0, str(hooks_dir))\n72\t            try:\n73\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n74\t            except Exception:\n75\t                _ae = None\n76\t        # Resolution 3: PYTHONPATH already configured.\n77\t        if _ae is None:\n78\t            try:\n79\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n80\t            except Exception:\n81\t                _ae = None\n82\t        if _ae is None or not hasattr(_ae, \"emit_pair_rail_review_expected\"):\n83\t            return\n84\t        _kwargs = {\n85\t            \"session_id\": session_id,\n86\t            \"tool_name\": tool_name,\n87\t            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n88\t        }\n89\t        # r5 F2 — forward review_id only when the resolved audit_emit\n90\t        # accepts it (kw-only param with default → visible in\n91\t        # __kwdefaults__). A version-skewed audit_emit thus degrades to\n92\t        # the id-less legacy emit instead of a TypeError swallowed by the\n93\t        # outer fail-open (which would drop the WHOLE event).\n94\t        _kwd = getattr(\n95\t            _ae.emit_pair_rail_review_expected, \"__kwdefaults__\", None\n96\t        ) or {}\n97\t        if \"review_id\" in _kwd:\n98\t            _kwargs[\"review_id\"] = review_id\n99\t        # ADR-110-AMEND-2 §1.6 — same skew guard: a pre-ceremony\n100\t        # audit_emit without `timeout_ms` degrades to the budget-less\n101\t        # legacy emit instead of a TypeError that would drop the WHOLE\n102\t        # denominator event (fail-open regression class).\n103\t        if \"timeout_ms\" in _kwd:\n104\t            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n105\t        _ae.emit_pair_rail_review_expected(**_kwargs)\n106\t    except Exception:\n107\t        pass  # fail-OPEN — never block on audit\n108\t\n109\t# QDSAA-FUNCAO-LONGA: emissão principal e sink derivam o mesmo caso, severidade e correlação antes de qualquer escrita.\n110\tdef _emit_pair_rail_case(\n111\t    *,\n112\t    case: str,\n113\t    claude_verdict: str,\n114\t    codex_verdict: str,\n115\t    tool_name: str,\n116\t    file_path: str,\n117\t    precondition_met: bool = False,\n118\t    rubric_violation_id: str = \"\",\n119\t    severity: str = \"\",\n120\t    jaccard_bucket: str = \"\",\n121\t    repo_root: Optional[Path] = None,\n122\t    session_id: str = \"\",\n123\t    review_id: str = \"\",\n124\t    timeout_s: float = 0.0,\n125\t) -> None:\n126\t    \"\"\"Best-effort audit emit of pair_rail_case. Fail-OPEN.\n127\t\n128\t    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n129\t    budget this invocation ran under, in SECONDS. A case F emitted under a\n130\t    sub-floor budget (`CEO_PAIR_RAIL_TIMEOUT_S=5`) and a case F from a\n131\t    genuine Codex outage were byte-identical before this field existed —\n132\t    §4(i). It reaches the wire as the INTEGER-millisecond `timeout_ms`\n133\t    (see `_timeout_ms`), forwarded under the SAME `__kwdefaults__` skew\n134\t    guard as `review_id`.\n135\t\n136\t    r5 F2: ``review_id`` is the per-invocation correlation id generated by\n137\t    `_decide()` at review entry and threaded here via `_decide_with_matrix`\n138\t    — identical on this case emit and its own `pair_rail_review_expected`.\n139\t    Forwarded only when the resolved audit_emit's signature accepts it\n140\t    (``__kwdefaults__`` probe): a version-skewed (pre-land) audit_emit\n141\t    degrades to the id-less legacy emit instead of raising TypeError into\n142\t    the outer fail-open catch, which would silently drop the whole case\n143\t    emit and MANUFACTURE a liveness deficit.\n144\t\n145\t    Import resolution order (first hit wins):\n146\t\n147\t    1. Test-only env override ``CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR``\n148\t       points at a directory containing ``_lib/audit_emit.py``. Used by\n149\t       the Phase 3 staging tests to load the staged audit_emit before\n150\t       the ceremony cp lands it canonical. Removed post-ceremony.\n151\t    2. Canonical layout: ``Path(__file__).resolve().parent`` (the\n152\t       canonical ``.claude/hooks/`` dir) contains ``_lib/audit_emit.py``.\n153\t       Standard production path post-ceremony.\n154\t    3. PYTHONPATH-discovered ``_lib.audit_emit`` (rare adopter\n155\t       scenario where the canonical hooks dir isn't this file's parent).\n156\t\n157\t    Any failure → return silently (fail-OPEN per ADR-106).\n158\t    \"\"\"\n159\t    _ae = None\n160\t    try:\n161\t        # Resolution 1: test-only staged-dir override.\n162\t        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n163\t        if staged_dir:\n164\t            staged_path = Path(staged_dir)\n165\t            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n166\t                if str(staged_path) not in sys.path:\n167\t                    sys.path.insert(0, str(staged_path))\n168\t                try:\n169\t                    from _lib import audit_emit as _ae  # type: ignore\n170\t                except Exception:\n171\t                    _ae = None\n172\t        # Resolution 2: canonical layout.\n173\t        if _ae is None:\n174\t            hooks_dir = Path(__file__).resolve().parent\n175\t            if str(hooks_dir) not in sys.path:\n176\t                sys.path.insert(0, str(hooks_dir))\n177\t            try:\n178\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n179\t            except Exception:\n180\t                _ae = None\n181\t        # Resolution 3: PYTHONPATH already configured.\n182\t        if _ae is None:\n183\t            try:\n184\t                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n185\t            except Exception:\n186\t                _ae = None\n187\t        # Defense-in-depth: ALSO breadcrumb to CEO_PAIR_RAIL_AUDIT_SINK\n188\t        # (the spike's per-test file sink). Used by Phase 3 matrix tests\n189\t        # to capture matrix decisions in the same JSONL surface as the\n190\t        # spike's `_emit_audit`. Production deployment relies on\n191\t        # audit_emit.emit_pair_rail_case being reachable; the sink\n192\t        # breadcrumb is a forensic continuity bridge for tests + adopters\n193\t        # without canonical audit-log writability.\n194\t        sink = os.environ.get(\"CEO_PAIR_RAIL_AUDIT_SINK\")\n195\t        if sink:\n196\t            try:\n197\t                with open(sink, \"a\", encoding=\"utf-8\") as f:\n198\t                    f.write(json.dumps({\n199\t                        \"action\": \"pair_rail_case\",\n200\t                        \"case\": case,\n201\t                        \"claude_verdict\": claude_verdict,\n202\t                        \"codex_verdict\": codex_verdict,\n203\t                        \"tool_name\": tool_name,\n204\t                        \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n205\t                        \"review_id\": review_id,\n206\t                        \"precondition_met\": precondition_met,\n207\t                        \"rubric_violation_id\": rubric_violation_id,\n208\t                        \"severity\": severity,\n209\t                        \"jaccard_similarity_bucket\": jaccard_bucket,\n210\t                        \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n211\t                        # ADR-110-AMEND-2 §1.6 — forensic parity with the\n212\t                        # signed row (same integer-ms encoding). The sink\n213\t                        # BYPASSES audit_emit, so the bound is applied\n214\t                        # here too — never write an unbounded caller\n215\t                        # value to a file.\n216\t                        \"timeout_ms\": _timeout_ms(timeout_s),\n217\t                    }, ensure_ascii=False) + \"\\n\")\n218\t            except Exception:\n219\t                pass\n220\t\n221\t        if _ae is None or not hasattr(_ae, \"emit_pair_rail_case\"):\n222\t            return\n223\t        _kwargs = {\n224\t            \"case\": case,\n225\t            \"claude_verdict\": claude_verdict,\n226\t            \"codex_verdict\": codex_verdict,\n227\t            \"tool_name\": tool_name,\n228\t            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n229\t            \"precondition_met\": precondition_met,\n230\t            \"rubric_violation_id\": rubric_violation_id,\n231\t            \"severity\": severity,\n232\t            \"jaccard_similarity_bucket\": jaccard_bucket,\n233\t            \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n234\t            # PLAN-161 C5 (r3 F2): the hook payload's session id, no longer\n235\t            # discarded — the typed default \"\" only remains for legacy\n236\t            # callers.\n237\t            \"session_id\": session_id,\n238\t        }\n239\t        # r5 F2 — forward review_id only when the resolved audit_emit\n240\t        # accepts it (see _emit_pair_rail_review_expected; same skew\n241\t        # guard — a TypeError here would silently DROP the case emit and\n242\t        # manufacture a /ceo-boot deficit, worse than an id-less emit).\n243\t        _kwd = getattr(\n244\t            _ae.emit_pair_rail_case, \"__kwdefaults__\", None\n245\t        ) or {}\n246\t        if \"review_id\" in _kwd:\n247\t            _kwargs[\"review_id\"] = review_id\n248\t        # ADR-110-AMEND-2 §1.6 — same skew guard: a version-skewed\n249\t        # audit_emit without `timeout_ms` degrades to the budget-less\n250\t        # legacy emit rather than raising a TypeError that would DROP the\n251\t        # case emit and manufacture a /ceo-boot liveness deficit.\n252\t        if \"timeout_ms\" in _kwd:\n253\t            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n254\t        _ae.emit_pair_rail_case(**_kwargs)\n255\t    except Exception:\n256\t        pass  # fail-OPEN — never block on audit\n257\t\n258\tdef _load_pair_rail_decide():  # type: ignore[no-untyped-def]\n259\t    \"\"\"Resolve the canonical pure decision module `_lib.pair_rail_decide`.\n260\t\n261\t    Mirrors `_emit_pair_rail_case`'s Resolution-2 (canonical layout):\n262\t    the `.claude/hooks/` dir that houses this file also houses `_lib/`.\n263\t    Returns the module or None (fail-OPEN — caller must tolerate None).\n264\t    \"\"\"\n265\t    try:\n266\t        hooks_dir = Path(__file__).resolve().parent\n267\t        if str(hooks_dir) not in sys.path:\n268\t            sys.path.insert(0, str(hooks_dir))\n269\t        from _lib import pair_rail_decide as _prd  # type: ignore\n270\t        return _prd\n271\t    except Exception:\n272\t        return None\n273\t\n274\tdef _base_to_verdicts(base: Dict[str, Any]) -> Tuple[str, str, str]:\n275\t    \"\"\"Translate the procedural `base` decision dict into the verdict\n276\t    triple `_lib.pair_rail_decide.detect_case()` consumes.\n277\t\n278\t    PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W1). PURE + fail-OPEN:\n279\t    any malformed input yields the no-case tuple `(\"\", \"\", \"\")` (which\n280\t    `detect_case()` maps to None → no matrix emit), never raises.\n281\t\n282\t    The substring contract is byte-identical to the LEGACY inline\n283\t    classification in `_decide_with_matrix` (verified against\n284\t    `_decide()` returns, source lines 595-679). Precedence MUST match\n285\t    the inline arm order: F (Codex fail) → B (write-shape/block) →\n286\t    A (review clean) → None (sentinel / kill-switch / out-of-scope).\n287\t\n288\t    Returns:\n289\t        (claude_verdict, codex_verdict, jaccard_bucket).\n290\t        claude_verdict is \"PASS\" for every reachable matrix case\n291\t        (Claude already passed to reach a PreToolUse write). Sentinel\n292\t        bypass + non-matrix short-circuits return (\"\", \"\", \"\").\n293\t    \"\"\"\n294\t    try:\n295\t        sysmsg = base.get(\"systemMessage\", \"\")\n296\t        if not isinstance(sysmsg, str):\n297\t            sysmsg = \"\"\n298\t        decision = base.get(\"decision\", \"allow\")\n299\t        # Arm 1 — Case F (Codex unavailable / timeout / malformed).\n300\t        if (\n301\t            \"Codex unavailable\" in sysmsg\n302\t            or \"Codex timeout\" in sysmsg\n303\t            or \"Codex malformed\" in sysmsg\n304\t        ):\n305\t            sysmsg_lower = sysmsg.lower()\n306\t            if \"malformed\" in sysmsg_lower:\n307\t                return \"PASS\", \"MALFORMED\", \"\"\n308\t            # timeout AND unavailable both coerce to TIMEOUT (schema-\n309\t            # compatible; precise reason stays in base[systemMessage]).\n310\t            return \"PASS\", \"TIMEOUT\", \"\"\n311\t        # Arm 2 — sentinel bypass is NOT a matrix case (no verdicts).\n312\t        if \"bypass via Architect sentinel\" in sysmsg:\n313\t            return \"\", \"\", \"\"\n314\t        # Arm 3 — Case B (write-shape advisory OR legacy block path).\n315\t        is_advisory_writeshape = (\n316\t            \"PAIR-RAIL-ADVISORY\" in sysmsg and \"write-shaped\" in sysmsg\n317\t        )\n318\t        if decision == \"block\" or is_advisory_writeshape:\n319\t            return \"PASS\", \"BLOCK\", \"\"\n320\t        # Arm 4 — Case A (clean review).\n321\t        if \"review clean\" in sysmsg:\n322\t            return \"PASS\", \"PASS\", \"\"\n323\t        # Arm 5 — non-matrix short-circuit (kill-switch / out-of-scope).\n324\t        return \"\", \"\", \"\"\n325\t    except Exception:\n326\t        # Fail-OPEN: derivation error → no-case tuple (detect_case → None).\n327\t        return \"\", \"\", \"\"\n328\t\n329\t# QDSAA-FUNCAO-LONGA: matriz assimétrica em ordem normativa preserva precedência do VETO e emissão do caso correspondente.\n330\tdef _decide_with_matrix(\n331\t    *,\n332\t    tool_name: str,\n333\t    file_path: str,\n334\t    proposed_content: str,\n335\t    repo_root: Path,\n336\t    timeout_s: float,\n337\t    session_id: str = \"\",\n338\t) -> Dict[str, Any]:\n339\t    \"\"\"Phase 3 asymmetric VETO matrix wrapper around `_decide()`.\n340\t\n341\t    Calls the canonical `_decide()` codepath to get the Phase 1 verdict\n342\t    (review-only semantics), then applies the Cases A-F matrix:\n343\t\n344\t      - canonical path returns ALLOW with no matrix-relevant signal → Case A\n345\t      - canonical path returns advisory write-shape (PLAN-092 Wave B\n346\t        SHADOW-strip per ADR-127) → validate Case-B preconditions:\n347\t          + preconditions met → Case B (advisory + audit)\n348\t          + preconditions NOT met → Case B' fail-OPEN (advisory)\n349\t      - canonical path returns ALLOW with `systemMessage` containing\n350\t        \"Codex unavailable\" / \"timeout\" / \"malformed\" → Case F (allow)\n351\t      - canonical path returns ALLOW with sentinel bypass → not a matrix case\n352\t        (already authorized by Owner sentinel)\n353\t\n354\t    Each matrix arm emits `pair_rail_case` with case + verdicts +\n355\t    preconditions + rubric metadata.\n356\t\n357\t    R1 S-Perf-3: matrix lookup uses O(1) dict (NOT linear scan); the\n358\t    ``_MATRIX_DECISIONS`` table below dispatches in constant time.\n359\t    \"\"\"\n360\t    # r5 F2 — reset the per-invocation correlation slot BEFORE _decide():\n361\t    # a stale id from a prior in-process invocation must never attach to\n362\t    # a case whose review path was not entered this time. _decide() sets\n363\t    # it (os.urandom(8).hex()) exactly when the review path is ENTERED,\n364\t    # in the same breath as the pair_rail_review_expected emit.\n365\t    global _CURRENT_REVIEW_ID\n366\t    _CURRENT_REVIEW_ID = \"\"\n367\t\n368\t    # Compute base decision via spike _decide()\n369\t    base = _decide(\n370\t        tool_name=tool_name,\n371\t        file_path=file_path,\n372\t        proposed_content=proposed_content,\n373\t        repo_root=repo_root,\n374\t        timeout_s=timeout_s,\n375\t        session_id=session_id,\n376\t    )\n377\t\n378\t    # r5 F2 — the id generated by THIS _decide() invocation (or \"\" when\n379\t    # the review path was never entered / kill-switch / out-of-scope /\n380\t    # sentinel arms returned early — those paths emit no case anyway).\n381\t    review_id = _CURRENT_REVIEW_ID\n382\t\n383\t    sysmsg = base.get(\"systemMessage\", \"\")\n384\t\n385\t    # PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W2): delegate the\n386\t    # verdict→case CLASSIFICATION to the canonical pure module\n387\t    # `_lib.pair_rail_decide.detect_case()`. The procedural shell\n388\t    # (Codex invoke, patch detect — both inside `_decide()` above), the\n389\t    # B'/precondition resolution, and every audit emit STAY INLINE.\n390\t    # `evaluate()` is DELIBERATELY NOT called: it would convert a\n391\t    # precondition-unmet Case B into B' (pair_rail_decide.py:197-204),\n392\t    # diverging from production's byte-identical `case=\"B\"` emit.\n393\t    #\n394\t    # Fail-OPEN: any error in verdict-derivation / classification / lib\n395\t    # import returns `base` (implicit allow), never raises.\n396\t    try:\n397\t        cv, xv, jb = _base_to_verdicts(base)\n398\t        _prd = _load_pair_rail_decide()\n399\t        matrix_case = (\n400\t            _prd.detect_case(claude_verdict=cv, codex_verdict=xv, jaccard_bucket=jb)\n401\t            if _prd is not None\n402\t            else None\n403\t        )\n404\t    except Exception:\n405\t        return base  # fail-OPEN — never block the user on a classifier bug\n406\t\n407\t    if matrix_case is None:\n408\t        # r6 F1 — discriminate on the invocation correlation id. A\n409\t        # non-empty `review_id` proves THIS _decide() invocation ENTERED\n410\t        # the review path (it emitted `pair_rail_review_expected`) and\n411\t        # returned a base decision that classifies to NO matrix case.\n412\t        # The only post-entry return that lands here is the ADVISORY\n413\t        # parse-miss arm (`_decide()` verdict==\"ADVISORY\": codex RAN and\n414\t        # ANSWERED, but the response parsed to no structured PASS/BLOCK\n415\t        # — `_base_to_verdicts` Arm 5 → detect_case None). Without a\n416\t        # case emit that expected review_id stays OUTSTANDING forever →\n417\t        # a FALSE /ceo-boot S254 deficit (\"hook died between the two\n418\t        # emits\") for a rail that actually answered. Emit the accounted\n419\t        # fail-open terminal case — case=F, codex_verdict=ADVISORY (both\n420\t        # already in the audit_emit closed enums; no schema change) —\n421\t        # carrying the SAME review_id so expected<->case pairs and the\n422\t        # row is LADDERED by its failopen bucket, exactly like the\n423\t        # sibling stop_review rail's parse-miss (`skipped_failopen`,\n424\t        # plan C5 r2 F2: unparseable is NEVER healthy). The deficit RED\n425\t        # stays reserved for an entered review with ZERO case emit (the\n426\t        # genuine S254 hook-death signal). An empty review_id = a\n427\t        # pre-review short-circuit (sentinel bypass / kill-switch /\n428\t        # out-of-scope / non-write tool) — byte-identical legacy\n429\t        # no-emit.\n430\t        if review_id:\n431\t            _emit_pair_rail_case(\n432\t                case=\"F\", claude_verdict=\"PASS\", codex_verdict=\"ADVISORY\",\n433\t                tool_name=tool_name, file_path=file_path,\n434\t                session_id=session_id, review_id=review_id,\n435\t                timeout_s=timeout_s,\n436\t            )\n437\t        return base\n438\t\n439\t    case_value = getattr(matrix_case, \"value\", matrix_case)\n440\t\n441\t    if case_value == \"F\":\n442\t        # Case F — fail-OPEN. The codex_verdict sub-discrimination\n443\t        # (MALFORMED vs TIMEOUT, with UNAVAILABLE coercing to TIMEOUT)\n444\t        # is carried by `_base_to_verdicts()` in `xv`; emit it verbatim.\n445\t        _emit_pair_rail_case(\n446\t            case=\"F\", claude_verdict=\"PASS\", codex_verdict=xv,\n447\t            tool_name=tool_name, file_path=file_path,\n448\t            session_id=session_id, review_id=review_id,\n449\t            timeout_s=timeout_s,\n450\t        )\n451\t        return base\n452\t\n453\t    if case_value == \"B\":\n454\t        # Procedural Case-B audit emit (advisory-only per ADR-127).\n455\t        # B'/precondition resolution stays INLINE (NOT via evaluate()).\n456\t        # precondition_met reflects whether substantive rubric evidence\n457\t        # was attached (False at Phase 3; True at Phase 4 corpus-replay).\n458\t        preconditions_met, reason_slug = _validate_provider_pair(\n459\t            codex_verdict=\"BLOCK\",\n460\t            rubric_violation_id=\"\",  # not extracted from procedural grammar\n461\t            severity=\"\",\n462\t            file_line_cited=False,\n463\t            repo_root=repo_root,\n464\t        )\n465\t        _emit_pair_rail_case(\n466\t            case=\"B\", claude_verdict=\"PASS\", codex_verdict=\"BLOCK\",\n467\t            tool_name=tool_name, file_path=file_path,\n468\t            precondition_met=preconditions_met,\n469\t            rubric_violation_id=\"\",\n470\t            severity=\"P0\",  # write-shape violation defaulted P0 procedural\n471\t            session_id=session_id, review_id=review_id,\n472\t            timeout_s=timeout_s,\n473\t        )\n474\t        # Advisory-only return — `base` already carries the advisory\n475\t        # systemMessage (Site 1). No `decision` key — schema treats\n476\t        # absence as implicit allow.\n477\t        return base\n478\t\n479\t    if case_value == \"A\":\n480\t        _emit_pair_rail_case(\n481\t            case=\"A\", claude_verdict=\"PASS\", codex_verdict=\"PASS\",\n482\t            tool_name=tool_name, file_path=file_path,\n483\t            session_id=session_id, review_id=review_id,\n484\t            timeout_s=timeout_s,\n485\t        )\n486\t        return base\n487\t\n488\t    # Defensive: any other detected case (C/D/E — confirmed unreachable\n489\t    # from the procedural `base`, plan §2a.2) → no emit, fail-OPEN allow.\n490\t    return base\n491\t\n492\tdef _verify_pin_cli(argv: List[str]) -> int:\n493\t    \"\"\"ADR-182 CLI entry — `check_pair_rail.py --verify-codex-pin\n494\t    [<launcher-path>]`. Shared verification surface for\n495\t    `pair-rail-gate.sh` Gate 4 and operator forensics: prints the\n496\t    `verify_codex_payload()` result as one JSON object.\n497\t\n498\t    Exit codes (gate.sh contract):\n499\t      0 — verified (payload sha256 matches the manifest entry)\n500\t      1 — fail-CLOSED arm (mismatch / triple_missing)\n501\t      3 — INFRA arm (manifest unreadable, launcher/payload missing, ...)\n502\t    \"\"\"\n503\t    launcher = argv[0] if argv else None\n504\t    res = verify_codex_payload(launcher)\n505\t    try:\n506\t        sys.stdout.write(json.dumps(res, ensure_ascii=False) + \"\\n\")\n507\t    except Exception:\n508\t        pass\n509\t    status = res.get(\"status\")\n510\t    if status in (\"verified\", \"compatible\"):\n511\t        return 0\n512\t    if status in (\"mismatch\", \"triple_missing\"):\n513\t        return 1\n514\t    return 3\n515\t\n516\t__all__ = (\n517\t    '_emit_pair_rail_review_expected',\n518\t    '_emit_pair_rail_case',\n519\t    '_load_pair_rail_decide',\n520\t    '_base_to_verdicts',\n521\t    '_decide_with_matrix',\n522\t    '_verify_pin_cli',\n523\t)\n524\t"}]},"parent_tool_use_id":null,"session_id":"fff1c582-0add-4cc7-a8a5-0376027f1063","uuid":"e2028462-0be3-4578-b1be-6103fc36303a","timestamp":"2026-11-16T19:27:45.118Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_pair_rail_parts/part_04.py","content":"from __future__ import annotations\nfrom ._shared import *\n\n# QDSAA-FUNCAO-LONGA: evento forense completo mantém campos correlatos; separar normalização poderia publicar retrato parcial.\ndef _emit_pair_rail_review_expected(\n    *,\n    tool_name: str,\n    session_id: str = \"\",\n    file_path: str = \"\",\n    review_id: str = \"\",\n    timeout_s: float = 0.0,\n) -> None:\n    \"\"\"Best-effort audit emit of pair_rail_review_expected. Fail-OPEN.\n\n    PLAN-161 C5 (r3 F2 + r4 F1): the durable session-correlated DENOMINATOR\n    for the /ceo-boot `pair_rail` activity-conditioned liveness row. Called\n    from `_decide()` only after the kill-switch / non-write-tool / not-L3+ /\n    sentinel-bypass arms have all returned — i.e. a Codex review is\n    definitely being ENTERED.\n\n    r5 F2: ``review_id`` is the per-invocation correlation id generated at\n    review entry (`os.urandom(8).hex()`, 16-hex). The SAME id rides this\n    emit AND the matching `pair_rail_case` emit of the same `_decide()`\n    invocation, so the /ceo-boot deficit pairs invocation-exact — counting\n    (even (session, file-hash)-bucketed) cannot pair a specific expected\n    with its OWN case. Forwarded only when the resolved audit_emit's\n    signature accepts it (``__kwdefaults__`` probe), so a version-skewed\n    audit_emit degrades to the id-less legacy emit instead of a TypeError\n    that would swallow the whole event (fail-open regression class).\n\n    r4 F2 (kept as the legacy fallback + harmless secondary key):\n    ``file_path`` is hashed here with the SAME helper the\n    `pair_rail_case` emit uses (`_hash_file_path_prefix` — 16-hex SHA-256\n    prefix, raw path NEVER on the wire per LLM06) so id-less events can\n    still pair per (session, file-hash) BUCKET.\n\n    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n    budget for this invocation in SECONDS (resolved in `main()`, threaded\n    through `_decide_with_matrix` → `_decide`). It exists so a case F\n    caused by a sub-floor `CEO_PAIR_RAIL_TIMEOUT_S` export stops being\n    indistinguishable from a genuine Codex outage (§4(i) residual — the\n    quiet knob was stealthier than the documented kill-switch). It reaches\n    the wire as the INTEGER-millisecond `timeout_ms` (see `_timeout_ms`:\n    canonical_json forbids floats in HMAC-covered fields), forwarded under\n    the SAME `__kwdefaults__` skew guard as `review_id`.\n\n    Import resolution mirrors `_emit_pair_rail_case` (staged-dir override →\n    canonical layout → PYTHONPATH). hasattr-guarded: a pre-ceremony\n    audit_emit without `emit_pair_rail_review_expected` is a silent no-op.\n    Deliberately NO `CEO_PAIR_RAIL_AUDIT_SINK` write — the sink is the\n    matrix tests' `pair_rail_case` capture surface and must not grow\n    extra rows under their counts.\n    \"\"\"\n    _ae = None\n    try:\n        # Resolution 1: test-only staged-dir override.\n        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n        if staged_dir:\n            staged_path = Path(staged_dir)\n            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n                if str(staged_path) not in sys.path:\n                    sys.path.insert(0, str(staged_path))\n                try:\n                    from _lib import audit_emit as _ae  # type: ignore\n                except Exception:\n                    _ae = None\n        # Resolution 2: canonical layout.\n        if _ae is None:\n            hooks_dir = Path(__file__).resolve().parent\n            if str(hooks_dir) not in sys.path:\n                sys.path.insert(0, str(hooks_dir))\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        # Resolution 3: PYTHONPATH already configured.\n        if _ae is None:\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        if _ae is None or not hasattr(_ae, \"emit_pair_rail_review_expected\"):\n            return\n        _kwargs = {\n            \"session_id\": session_id,\n            \"tool_name\": tool_name,\n            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n        }\n        # r5 F2 — forward review_id only when the resolved audit_emit\n        # accepts it (kw-only param with default → visible in\n        # __kwdefaults__). A version-skewed audit_emit thus degrades to\n        # the id-less legacy emit instead of a TypeError swallowed by the\n        # outer fail-open (which would drop the WHOLE event).\n        _kwd = getattr(\n            _ae.emit_pair_rail_review_expected, \"__kwdefaults__\", None\n        ) or {}\n        if \"review_id\" in _kwd:\n            _kwargs[\"review_id\"] = review_id\n        # ADR-110-AMEND-2 §1.6 — same skew guard: a pre-ceremony\n        # audit_emit without `timeout_ms` degrades to the budget-less\n        # legacy emit instead of a TypeError that would drop the WHOLE\n        # denominator event (fail-open regression class).\n        if \"timeout_ms\" in _kwd:\n            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n        _ae.emit_pair_rail_review_expected(**_kwargs)\n    except Exception:\n        pass  # fail-OPEN — never block on audit\n\n# QDSAA-FUNCAO-LONGA: emissão principal e sink derivam o mesmo caso, severidade e correlação antes de qualquer escrita.\ndef _emit_pair_rail_case(\n    *,\n    case: str,\n    claude_verdict: str,\n    codex_verdict: str,\n    tool_name: str,\n    file_path: str,\n    precondition_met: bool = False,\n    rubric_violation_id: str = \"\",\n    severity: str = \"\",\n    jaccard_bucket: str = \"\",\n    repo_root: Optional[Path] = None,\n    session_id: str = \"\",\n    review_id: str = \"\",\n    timeout_s: float = 0.0,\n) -> None:\n    \"\"\"Best-effort audit emit of pair_rail_case. Fail-OPEN.\n\n    ADR-110-AMEND-2 §1.6: ``timeout_s`` is the EFFECTIVE post-clamp Codex\n    budget this invocation ran under, in SECONDS. A case F emitted under a\n    sub-floor budget (`CEO_PAIR_RAIL_TIMEOUT_S=5`) and a case F from a\n    genuine Codex outage were byte-identical before this field existed —\n    §4(i). It reaches the wire as the INTEGER-millisecond `timeout_ms`\n    (see `_timeout_ms`), forwarded under the SAME `__kwdefaults__` skew\n    guard as `review_id`.\n\n    r5 F2: ``review_id`` is the per-invocation correlation id generated by\n    `_decide()` at review entry and threaded here via `_decide_with_matrix`\n    — identical on this case emit and its own `pair_rail_review_expected`.\n    Forwarded only when the resolved audit_emit's signature accepts it\n    (``__kwdefaults__`` probe): a version-skewed (pre-land) audit_emit\n    degrades to the id-less legacy emit instead of raising TypeError into\n    the outer fail-open catch, which would silently drop the whole case\n    emit and MANUFACTURE a liveness deficit.\n\n    Import resolution order (first hit wins):\n\n    1. Test-only env override ``CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR``\n       points at a directory containing ``_lib/audit_emit.py``. Used by\n       the Phase 3 staging tests to load the staged audit_emit before\n       the ceremony cp lands it canonical. Removed post-ceremony.\n    2. Canonical layout: ``Path(__file__).resolve().parent`` (the\n       canonical ``.claude/hooks/`` dir) contains ``_lib/audit_emit.py``.\n       Standard production path post-ceremony.\n    3. PYTHONPATH-discovered ``_lib.audit_emit`` (rare adopter\n       scenario where the canonical hooks dir isn't this file's parent).\n\n    Any failure → return silently (fail-OPEN per ADR-106).\n    \"\"\"\n    _ae = None\n    try:\n        # Resolution 1: test-only staged-dir override.\n        staged_dir = os.environ.get(\"CEO_PAIR_RAIL_STAGED_AUDIT_EMIT_DIR\")\n        if staged_dir:\n            staged_path = Path(staged_dir)\n            if staged_path.is_dir() and (staged_path / \"_lib\" / \"audit_emit.py\").exists():\n                if str(staged_path) not in sys.path:\n                    sys.path.insert(0, str(staged_path))\n                try:\n                    from _lib import audit_emit as _ae  # type: ignore\n                except Exception:\n                    _ae = None\n        # Resolution 2: canonical layout.\n        if _ae is None:\n            hooks_dir = Path(__file__).resolve().parent\n            if str(hooks_dir) not in sys.path:\n                sys.path.insert(0, str(hooks_dir))\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        # Resolution 3: PYTHONPATH already configured.\n        if _ae is None:\n            try:\n                from _lib import audit_emit as _ae  # type: ignore  # noqa: F811\n            except Exception:\n                _ae = None\n        # Defense-in-depth: ALSO breadcrumb to CEO_PAIR_RAIL_AUDIT_SINK\n        # (the spike's per-test file sink). Used by Phase 3 matrix tests\n        # to capture matrix decisions in the same JSONL surface as the\n        # spike's `_emit_audit`. Production deployment relies on\n        # audit_emit.emit_pair_rail_case being reachable; the sink\n        # breadcrumb is a forensic continuity bridge for tests + adopters\n        # without canonical audit-log writability.\n        sink = os.environ.get(\"CEO_PAIR_RAIL_AUDIT_SINK\")\n        if sink:\n            try:\n                with open(sink, \"a\", encoding=\"utf-8\") as f:\n                    f.write(json.dumps({\n                        \"action\": \"pair_rail_case\",\n                        \"case\": case,\n                        \"claude_verdict\": claude_verdict,\n                        \"codex_verdict\": codex_verdict,\n                        \"tool_name\": tool_name,\n                        \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n                        \"review_id\": review_id,\n                        \"precondition_met\": precondition_met,\n                        \"rubric_violation_id\": rubric_violation_id,\n                        \"severity\": severity,\n                        \"jaccard_similarity_bucket\": jaccard_bucket,\n                        \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n                        # ADR-110-AMEND-2 §1.6 — forensic parity with the\n                        # signed row (same integer-ms encoding). The sink\n                        # BYPASSES audit_emit, so the bound is applied\n                        # here too — never write an unbounded caller\n                        # value to a file.\n                        \"timeout_ms\": _timeout_ms(timeout_s),\n                    }, ensure_ascii=False) + \"\\n\")\n            except Exception:\n                pass\n\n        if _ae is None or not hasattr(_ae, \"emit_pair_rail_case\"):\n            return\n        _kwargs = {\n            \"case\": case,\n            \"claude_verdict\": claude_verdict,\n            \"codex_verdict\": codex_verdict,\n            \"tool_name\": tool_name,\n            \"file_path_hash_prefix\": _hash_file_path_prefix(file_path),\n            \"precondition_met\": precondition_met,\n            \"rubric_violation_id\": rubric_violation_id,\n            \"severity\": severity,\n            \"jaccard_similarity_bucket\": jaccard_bucket,\n            \"human_triage_grace_h\": _resolve_human_triage_grace_h(severity),\n            # PLAN-161 C5 (r3 F2): the hook payload's session id, no longer\n            # discarded — the typed default \"\" only remains for legacy\n            # callers.\n            \"session_id\": session_id,\n        }\n        # r5 F2 — forward review_id only when the resolved audit_emit\n        # accepts it (see _emit_pair_rail_review_expected; same skew\n        # guard — a TypeError here would silently DROP the case emit and\n        # manufacture a /ceo-boot deficit, worse than an id-less emit).\n        _kwd = getattr(\n            _ae.emit_pair_rail_case, \"__kwdefaults__\", None\n        ) or {}\n        if \"review_id\" in _kwd:\n            _kwargs[\"review_id\"] = review_id\n        # ADR-110-AMEND-2 §1.6 — same skew guard: a version-skewed\n        # audit_emit without `timeout_ms` degrades to the budget-less\n        # legacy emit rather than raising a TypeError that would DROP the\n        # case emit and manufacture a /ceo-boot liveness deficit.\n        if \"timeout_ms\" in _kwd:\n            _kwargs[\"timeout_ms\"] = _timeout_ms(timeout_s)\n        _ae.emit_pair_rail_case(**_kwargs)\n    except Exception:\n        pass  # fail-OPEN — never block on audit\n\ndef _load_pair_rail_decide():  # type: ignore[no-untyped-def]\n    \"\"\"Resolve the canonical pure decision module `_lib.pair_rail_decide`.\n\n    Mirrors `_emit_pair_rail_case`'s Resolution-2 (canonical layout):\n    the `.claude/hooks/` dir that houses this file also houses `_lib/`.\n    Returns the module or None (fail-OPEN — caller must tolerate None).\n    \"\"\"\n    try:\n        hooks_dir = Path(__file__).resolve().parent\n        if str(hooks_dir) not in sys.path:\n            sys.path.insert(0, str(hooks_dir))\n        from _lib import pair_rail_decide as _prd  # type: ignore\n        return _prd\n    except Exception:\n        return None\n\ndef _base_to_verdicts(base: Dict[str, Any]) -> Tuple[str, str, str]:\n    \"\"\"Translate the procedural `base` decision dict into the verdict\n    triple `_lib.pair_rail_decide.detect_case()` consumes.\n\n    PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W1). PURE + fail-OPEN:\n    any malformed input yields the no-case tuple `(\"\", \"\", \"\")` (which\n    `detect_case()` maps to None → no matrix emit), never raises.\n\n    The substring contract is byte-identical to the LEGACY inline\n    classification in `_decide_with_matrix` (verified against\n    `_decide()` returns, source lines 595-679). Precedence MUST match\n    the inline arm order: F (Codex fail) → B (write-shape/block) →\n    A (review clean) → None (sentinel / kill-switch / out-of-scope).\n\n    Returns:\n        (claude_verdict, codex_verdict, jaccard_bucket).\n        claude_verdict is \"PASS\" for every reachable matrix case\n        (Claude already passed to reach a PreToolUse write). Sentinel\n        bypass + non-matrix short-circuits return (\"\", \"\", \"\").\n    \"\"\"\n    try:\n        sysmsg = base.get(\"systemMessage\", \"\")\n        if not isinstance(sysmsg, str):\n            sysmsg = \"\"\n        decision = base.get(\"decision\", \"allow\")\n        # Arm 1 — Case F (Codex unavailable / timeout / malformed).\n        if (\n            \"Codex unavailable\" in sysmsg\n            or \"Codex timeout\" in sysmsg\n            or \"Codex malformed\" in sysmsg\n        ):\n            sysmsg_lower = sysmsg.lower()\n            if \"malformed\" in sysmsg_lower:\n                return \"PASS\", \"MALFORMED\", \"\"\n            # timeout AND unavailable both coerce to TIMEOUT (schema-\n            # compatible; precise reason stays in base[systemMessage]).\n            return \"PASS\", \"TIMEOUT\", \"\"\n        # Arm 2 — sentinel bypass is NOT a matrix case (no verdicts).\n        if \"bypass via Architect sentinel\" in sysmsg:\n            return \"\", \"\", \"\"\n        # Arm 3 — Case B (write-shape advisory OR legacy block path).\n        is_advisory_writeshape = (\n            \"PAIR-RAIL-ADVISORY\" in sysmsg and \"write-shaped\" in sysmsg\n        )\n        if decision == \"block\" or is_advisory_writeshape:\n            return \"PASS\", \"BLOCK\", \"\"\n        # Arm 4 — Case A (clean review).\n        if \"review clean\" in sysmsg:\n            return \"PASS\", \"PASS\", \"\"\n        # Arm 5 — non-matrix short-circuit (kill-switch / out-of-scope).\n        return \"\", \"\", \"\"\n    except Exception:\n        # Fail-OPEN: derivation error → no-case tuple (detect_case → None).\n        return \"\", \"\", \"\"\n\n# QDSAA-FUNCAO-LONGA: matriz assimétrica em ordem normativa preserva precedência do VETO e emissão do caso correspondente.\ndef _decide_with_matrix(\n    *,\n    tool_name: str,\n    file_path: str,\n    proposed_content: str,\n    repo_root: Path,\n    timeout_s: float,\n    session_id: str = \"\",\n) -> Dict[str, Any]:\n    \"\"\"Phase 3 asymmetric VETO matrix wrapper around `_decide()`.\n\n    Calls the canonical `_decide()` codepath to get the Phase 1 verdict\n    (review-only semantics), then applies the Cases A-F matrix:\n\n      - canonical path returns ALLOW with no matrix-relevant signal → Case A\n      - canonical path returns advisory write-shape (PLAN-092 Wave B\n        SHADOW-strip per ADR-127) → validate Case-B preconditions:\n          + preconditions met → Case B (advisory + audit)\n          + preconditions NOT met → Case B' fail-OPEN (advisory)\n      - canonical path returns ALLOW with `systemMessage` containing\n        \"Codex unavailable\" / \"timeout\" / \"malformed\" → Case F (allow)\n      - canonical path returns ALLOW with sentinel bypass → not a matrix case\n        (already authorized by Owner sentinel)\n\n    Each matrix arm emits `pair_rail_case` with case + verdicts +\n    preconditions + rubric metadata.\n\n    R1 S-Perf-3: matrix lookup uses O(1) dict (NOT linear scan); the\n    ``_MATRIX_DECISIONS`` table below dispatches in constant time.\n    \"\"\"\n    # r5 F2 — reset the per-invocation correlation slot BEFORE _decide():\n    # a stale id from a prior in-process invocation must never attach to\n    # a case whose review path was not entered this time. _decide() sets\n    # it (os.urandom(8).hex()) exactly when the review path is ENTERED,\n    # in the same breath as the pair_rail_review_expected emit.\n    global _CURRENT_REVIEW_ID\n    _CURRENT_REVIEW_ID = \"\"\n\n    # Compute base decision via spike _decide()\n    base = _decide(\n        tool_name=tool_name,\n        file_path=file_path,\n        proposed_content=proposed_content,\n        repo_root=repo_root,\n        timeout_s=timeout_s,\n        session_id=session_id,\n    )\n\n    # r5 F2 — the id generated by THIS _decide() invocation (or \"\" when\n    # the review path was never entered / kill-switch / out-of-scope /\n    # sentinel arms returned early — those paths emit no case anyway).\n    review_id = _CURRENT_REVIEW_ID\n\n    sysmsg = base.get(\"systemMessage\", \"\")\n\n    # PLAN-112-FOLLOWUP-pair-rail-decide-canonical (W2): delegate the\n    # verdict→case CLASSIFICATION to the canonical pure module\n    # `_lib.pair_rail_decide.detect_case()`. The procedural shell\n    # (Codex invoke, patch detect — both inside `_decide()` above), the\n    # B'/precondition resolution, and every audit emit STAY INLINE.\n    # `evaluate()` is DELIBERATELY NOT called: it would convert a\n    # precondition-unmet Case B into B' (pair_rail_decide.py:197-204),\n    # diverging from production's byte-identical `case=\"B\"` emit.\n    #\n    # Fail-OPEN: any error in verdict-derivation / classification / lib\n    # import returns `base` (implicit allow), never raises.\n    try:\n        cv, xv, jb = _base_to_verdicts(base)\n        _prd = _load_pair_rail_decide()\n        matrix_case = (\n            _prd.detect_case(claude_verdict=cv, codex_verdict=xv, jaccard_bucket=jb)\n            if _prd is not None\n            else None\n        )\n    except Exception:\n        return base  # fail-OPEN — never block the user on a classifier bug\n\n    if matrix_case is None:\n        # r6 F1 — discriminate on the invocation correlation id. A\n        # non-empty `review_id` proves THIS _decide() invocation ENTERED\n        # the review path (it emitted `pair_rail_review_expected`) and\n        # returned a base decision that classifies to NO matrix case.\n        # The only post-entry return that lands here is the ADVISORY\n        # parse-miss arm (`_decide()` verdict==\"ADVISORY\": codex RAN and\n        # ANSWERED, but the response parsed to no structured PASS/BLOCK\n        # — `_base_to_verdicts` Arm 5 → detect_case None). Without a\n        # case emit that expected review_id stays OUTSTANDING forever →\n        # a FALSE /ceo-boot S254 deficit (\"hook died between the two\n        # emits\") for a rail that actually answered. Emit the accounted\n        # fail-open terminal case — case=F, codex_verdict=ADVISORY (both\n        # already in the audit_emit closed enums; no schema change) —\n        # carrying the SAME review_id so expected<->case pairs and the\n        # row is LADDERED by its failopen bucket, exactly like the\n        # sibling stop_review rail's parse-miss (`skipped_failopen`,\n        # plan C5 r2 F2: unparseable is NEVER healthy). The deficit RED\n        # stays reserved for an entered review with ZERO case emit (the\n        # genuine S254 hook-death signal). An empty review_id = a\n        # pre-review short-circuit (sentinel bypass / kill-switch /\n        # out-of-scope / non-write tool) — byte-identical legacy\n        # no-emit.\n        if review_id:\n            _emit_pair_rail_case(\n                case=\"F\", claude_verdict=\"PASS\", codex_verdict=\"ADVISORY\",\n                tool_name=tool_name, file_path=file_path,\n                session_id=session_id, review_id=review_id,\n                timeout_s=timeout_s,\n            )\n        return base\n\n    case_value = getattr(matrix_case, \"value\", matrix_case)\n\n    if case_value == \"F\":\n        # Case F — fail-OPEN. The codex_verdict sub-discrimination\n        # (MALFORMED vs TIMEOUT, with UNAVAILABLE coercing to TIMEOUT)\n        # is carried by `_base_to_verdicts()` in `xv`; emit it verbatim.\n        _emit_pair_rail_case(\n            case=\"F\", claude_verdict=\"PASS\", codex_verdict=xv,\n            tool_name=tool_name, file_path=file_path,\n            session_id=session_id, review_id=review_id,\n            timeout_s=timeout_s,\n        )\n        return base\n\n    if case_value == \"B\":\n        # Procedural Case-B audit emit (advisory-only per ADR-127).\n        # B'/precondition resolution stays INLINE (NOT via evaluate()).\n        # precondition_met reflects whether substantive rubric evidence\n        # was attached (False at Phase 3; True at Phase 4 corpus-replay).\n        preconditions_met, reason_slug = _validate_provider_pair(\n            codex_verdict=\"BLOCK\",\n            rubric_violation_id=\"\",  # not extracted from procedural grammar\n            severity=\"\",\n            file_line_cited=False,\n            repo_root=repo_root,\n        )\n        _emit_pair_rail_case(\n            case=\"B\", claude_verdict=\"PASS\", codex_verdict=\"BLOCK\",\n            tool_name=tool_name, file_path=file_path,\n            precondition_met=preconditions_met,\n            rubric_violation_id=\"\",\n            severity=\"P0\",  # write-shape violation defaulted P0 procedural\n            session_id=session_id, review_id=review_id,\n            timeout_s=timeout_s,\n        )\n        # Advisory-only return — `base` already carries the advisory\n        # systemMessage (Site 1). No `decision` key — schema treats\n        # absence as implicit allow.\n        return base\n\n    if case_value == \"A\":\n        _emit_pair_rail_case(\n            case=\"A\", claude_verdict=\"PASS\", codex_verdict=\"PASS\",\n            tool_name=tool_name, file_path=file_path,\n            session_id=session_id, review_id=review_id,\n            timeout_s=timeout_s,\n        )\n        return base\n\n    # Defensive: any other detected case (C/D/E — confirmed unreachable\n    # from the procedural `base`, plan §2a.2) → no emit, fail-OPEN allow.\n    return base\n\ndef _verify_pin_cli(argv: List[str]) -> int:\n    \"\"\"ADR-182 CLI entry — `check_pair_rail.py --verify-codex-pin\n    [<launcher-path>]`. Shared verification surface for\n    `pair-rail-gate.sh` Gate 4 and operator forensics: prints the\n    `verify_codex_payload()` result as one JSON object.\n\n    Exit codes (gate.sh contract):\n      0 — verified (payload sha256 matches the manifest entry)\n      1 — fail-CLOSED arm (mismatch / triple_missing)\n      3 — INFRA arm (manifest unreadable, launcher/payload missing, ...)\n    \"\"\"\n    launcher = argv[0] if argv else None\n    res = verify_codex_payload(launcher)\n    try:\n        sys.stdout.write(json.dumps(res, ensure_ascii=False) + \"\\n\")\n    except Exception:\n        pass\n    status = res.get(\"status\")\n    if status in (\"verified\", \"compatible\"):\n        return 0\n    if status in (\"mismatch\", \"triple_missing\"):\n        return 1\n    return 3\n\n__all__ = (\n    '_emit_pair_rail_review_expected',\n    '_emit_pair_rail_case',\n    '_load_pair_rail_decide',\n    '_base_to_verdicts',\n    '_decide_with_matrix',\n    '_verify_pin_cli',\n)\n","numLines":524,"startLine":1,"totalLines":524}},"tool_result_meta":[{"id":"toolu_01EAm9Dz8F7oiguWaaAYbthP","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
