{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CVeoGFGHJPqpzaU3TWCvYo","type":"tool_result","content":"80\timport sys\n81\timport time\n82\tfrom dataclasses import dataclass\n83\tfrom datetime import datetime, timezone\n84\tfrom pathlib import Path\n85\tfrom typing import Dict, List, Optional\n86\t\n87\t_HOOKS_DIR = Path(__file__).resolve().parent\n88\tif str(_HOOKS_DIR) not in sys.path:\n89\t    sys.path.insert(0, str(_HOOKS_DIR))\n90\t\n91\tfrom _lib import contract as _contract  # noqa: E402\n92\tfrom _lib import adapters as _adapters  # noqa: E402\n93\tfrom _lib import plan_frontmatter as _fm  # noqa: E402\n94\tfrom _lib import plan_paths as _plan_paths  # noqa: E402\n95\t\n96\t# Optional: emit to event stream v2 (fail-open if module missing or errors)\n97\ttry:\n98\t    from _lib import audit_emit as _audit_emit  # noqa: E402\n99\t    _AUDIT_EMIT_AVAILABLE = True\n100\texcept Exception:  # pragma: no cover\n101\t    _AUDIT_EMIT_AVAILABLE = False\n102\t\n103\t\n104\t# Legal status values per PLAN-SCHEMA.md §4\n105\t#\n106\t# `superseded` (PLAN-113 W2): a terminal status used when a later plan\n107\t# fully absorbs this plan's scope. Distinct from `abandoned` (premise\n108\t# proved wrong) — the work itself was valid but is now tracked elsewhere.\n109\t# Requires a `superseded_by:` frontmatter pointer. A plan may be\n110\t# superseded from any prior state, including `done` (e.g. PLAN-093/095\n111\t# -FOLLOWUP were done then folded into PLAN-106).\n112\t_LEGAL_STATUSES = {\n113\t    \"draft\",\n114\t    \"reviewed\",\n115\t    \"executing\",\n116\t    \"done\",\n117\t    \"abandoned\",\n118\t    \"refused\",\n119\t    \"superseded\",\n120\t}\n121\t\n122\t# Transition graph: status → set of allowed next statuses\n123\t_ALLOWED_TRANSITIONS: Dict[str, set] = {\n124\t    \"draft\": {\"draft\", \"reviewed\", \"abandoned\", \"refused\", \"superseded\"},\n125\t    \"reviewed\": {\"reviewed\", \"executing\", \"abandoned\", \"refused\", \"superseded\"},\n126\t    \"executing\": {\"executing\", \"done\", \"abandoned\", \"refused\", \"superseded\"},\n127\t    # done is reopen-able when the plan body declares a `reopen_via:`\n128\t    # ADR reference (audit-v2 ADR-092 honest-deferral framework).\n129\t    # done → superseded is allowed when a later plan absorbs the scope.\n130\t    \"done\": {\"done\", \"executing\", \"superseded\"},\n131\t    \"abandoned\": {\"abandoned\"},  # terminal\n132\t    \"refused\": {\"refused\"},  # terminal — must cite refused_adr\n133\t    \"superseded\": {\"superseded\"},  # terminal — must cite superseded_by\n134\t}\n135\t\n136\t# ---------------------------------------------------------------------\n137\t# PLAN-065 §4.4.B — Stranded-work detection thresholds\n138\t# ---------------------------------------------------------------------\n139\t#\n140\t# Mode 8.2 (\"Paperclip in_progress sem run vivo\"): plan stuck in\n141\t# `status: executing` with no commit touching the plan file in this\n142\t# many seconds. 24h matches Paperclip's `WIP > 1d` heuristic.\n143\t_STRANDED_EXECUTING_MAX_AGE_SECS = 24 * 3600  # 24 hours\n144\t\n145\t# Mode 8.1 (\"todo dispatch falhou\"): plan parked in `status: reviewed`\n146\t# with a `reviewed_at` ISO date older than this many seconds. 7 days\n147\t# is the Owner-wake threshold per PLAN-065 §4.4.B.\n148\t_STRANDED_REVIEWED_MAX_AGE_SECS = 7 * 24 * 3600  # 7 days\n149\t\n150\t\n151\tdef _extract_plan_id(file_path: str) -> str:\n152\t    \"\"\"Return the plan ID from a plan file path, or empty string.\"\"\"\n153\t    return _plan_paths.plan_id_from_path(file_path)\n154\t\n155\t\n156\tdef _emit_transition(file_path: str, old_status: str, new_status: str, editor_tool: str = \"Edit\") -> None:\n157\t    \"\"\"Fail-open emit of plan_transition event to stream v2.\"\"\"\n158\t    if not _AUDIT_EMIT_AVAILABLE:\n159\t        return\n160\t    try:\n161\t        plan_id = _extract_plan_id(file_path)\n162\t        if not plan_id or not old_status or not new_status or old_status == new_status:\n163\t            return\n164\t        import os as _os\n165\t        _audit_emit.emit_plan_transition(\n166\t            plan_id=plan_id,\n167\t            from_status=old_status,\n168\t            to_status=new_status,\n169\t            file_path=file_path,\n170\t            editor_tool=editor_tool,\n171\t            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n172\t        )\n173\t    except Exception:  # pragma: no cover\n174\t        pass\n175\t\n176\t\n177\tdef _emit_stranded(plan_id: str, mode: str, age_days: int, status: str, file_path: str) -> None:\n178\t    \"\"\"Fail-open emit of stranded_plan_detected event.\n179\t\n180\t    PLAN-065 §4.4.B — `stranded_plan_detected` is NOT yet in the\n181\t    `_KNOWN_ACTIONS` registry. We attempt the emit via `emit_generic`\n182\t    which silently breadcrumbs unknown actions (no-op pre-canonical\n183\t    ceremony). Once the action is registered in audit_emit.py\n184\t    (PLAN-065 Phase 4-B canonical ceremony), the same call site\n185\t    starts producing real events with no code change.\n186\t    \"\"\"\n187\t    # PLAN-065 Phase 4-B v1.12.1: action `stranded_plan_detected` is NOT\n188\t    # YET registered in `_KNOWN_ACTIONS`. Wiring deferred to v1.13.0 /\n189\t    # PLAN-067 (per ADR-093 §per-plan-cap — ADR-098 already consumed for\n190\t    # PLAN-065). Until then, this is a no-op stub. The actual emit call\n191\t    # is intentionally absent to avoid `check-audit-registry-coverage.py`\n192\t    # AST drift detector flagging an orphan emit (would block PR).\n193\t    # Reference inputs so static analyzers see them used:\n194\t    _ = plan_id, mode, age_days, status, file_path\n195\t    if not _AUDIT_EMIT_AVAILABLE:\n196\t        return\n197\t    return\n198\t\n199\t\n200\t@dataclass\n201\tclass StrandedPlan:\n202\t    \"\"\"Typed result of stranded-plan detection.\n203\t\n204\t    PLAN-065 §4.4.B. Field semantics:\n205\t\n206\t    - ``plan_id``: PLAN-NNN identifier extracted from filename.\n207\t    - ``mode``: ``\"8.1\"`` (reviewed dispatch failed) or ``\"8.2\"``\n208\t      (executing paperclip — no run vivo).\n209\t    - ``age_days``: integer days since the relevant timestamp\n210\t      (commit mtime for 8.2; ``reviewed_at`` for 8.1).\n211\t    - ``status``: current frontmatter status (executing / reviewed).\n212\t    - ``file_path``: relative-or-absolute path to the plan file.\n213\t    \"\"\"\n214\t\n215\t    plan_id: str\n216\t    mode: str\n217\t    age_days: int\n218\t    status: str\n219\t    file_path: str\n220\t\n221\t\n222\t@dataclass\n223\tclass Decision:\n224\t    \"\"\"Typed result.\"\"\"\n225\t\n226\t    allow: bool\n227\t    reason: Optional[str] = None\n228\t\n229\t    def to_json(self) -> str:\n230\t        if self.allow:\n231\t            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow\n232\t        return json.dumps(\n233\t            {\"decision\": \"block\", \"reason\": self.reason or \"\"},\n234\t            ensure_ascii=False,\n235\t        )\n236\t\n237\t\n238\tdef _is_plan_file(file_path: str) -> bool:\n239\t    \"\"\"Return True only for a schema-valid plan path.\"\"\"\n240\t    return _plan_paths.is_plan_path(file_path)\n241\t\n242\t\n243\tdef _read_current_plan(file_path: str) -> str:\n244\t    \"\"\"Read the current file content. Returns empty string on any error.\"\"\"\n245\t    try:\n246\t        return Path(file_path).read_text(encoding=\"utf-8\")\n247\t    except (OSError, UnicodeDecodeError):\n248\t        return \"\"\n249\t\n250\t\n251\tdef _apply_edit(\n252\t    current: str, old_string: str, new_string: str, replace_all: bool\n253\t) -> str:\n254\t    \"\"\"Simulate the Edit tool's substitution locally.\n255\t\n256\t    Returns the post-edit content. If old_string is not in current,\n257\t    returns current unchanged (the real Edit would fail, but we don't\n258\t    want to block on that — fail-open to let Edit produce its own error).\n259\t    \"\"\"\n260\t    if not current or old_string not in current:\n261\t        return current\n262\t    if replace_all:\n263\t        return current.replace(old_string, new_string)\n264\t    # Non-replace-all: replace first occurrence only\n265\t    return current.replace(old_string, new_string, 1)\n266\t\n267\t\n268\tdef _check_transition(\n269\t    old_status: str, new_status: str\n270\t) -> Optional[str]:\n271\t    \"\"\"Return a block reason if the transition is illegal; None if OK.\"\"\"\n272\t    if new_status not in _LEGAL_STATUSES:\n273\t        return (\n274\t            f\"PLAN-LIFECYCLE: illegal status value '{new_status}'. \"\n275\t            f\"Must be one of: {', '.join(sorted(_LEGAL_STATUSES))}.\"\n276\t        )\n277\t    if not old_status:\n278\t        # New plan (no existing status in the old content) — anything legal is fine\n279\t        return None"}]},"parent_tool_use_id":null,"session_id":"fff1c582-0add-4cc7-a8a5-0376027f1063","uuid":"c949d106-4a68-449d-aa76-92833ea6fd08","timestamp":"2026-11-16T19:29:19.757Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_plan_edit.py","content":"import sys\nimport time\nfrom dataclasses import dataclass\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Dict, List, Optional\n\n_HOOKS_DIR = Path(__file__).resolve().parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\nfrom _lib import contract as _contract  # noqa: E402\nfrom _lib import adapters as _adapters  # noqa: E402\nfrom _lib import plan_frontmatter as _fm  # noqa: E402\nfrom _lib import plan_paths as _plan_paths  # noqa: E402\n\n# Optional: emit to event stream v2 (fail-open if module missing or errors)\ntry:\n    from _lib import audit_emit as _audit_emit  # noqa: E402\n    _AUDIT_EMIT_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _AUDIT_EMIT_AVAILABLE = False\n\n\n# Legal status values per PLAN-SCHEMA.md §4\n#\n# `superseded` (PLAN-113 W2): a terminal status used when a later plan\n# fully absorbs this plan's scope. Distinct from `abandoned` (premise\n# proved wrong) — the work itself was valid but is now tracked elsewhere.\n# Requires a `superseded_by:` frontmatter pointer. A plan may be\n# superseded from any prior state, including `done` (e.g. PLAN-093/095\n# -FOLLOWUP were done then folded into PLAN-106).\n_LEGAL_STATUSES = {\n    \"draft\",\n    \"reviewed\",\n    \"executing\",\n    \"done\",\n    \"abandoned\",\n    \"refused\",\n    \"superseded\",\n}\n\n# Transition graph: status → set of allowed next statuses\n_ALLOWED_TRANSITIONS: Dict[str, set] = {\n    \"draft\": {\"draft\", \"reviewed\", \"abandoned\", \"refused\", \"superseded\"},\n    \"reviewed\": {\"reviewed\", \"executing\", \"abandoned\", \"refused\", \"superseded\"},\n    \"executing\": {\"executing\", \"done\", \"abandoned\", \"refused\", \"superseded\"},\n    # done is reopen-able when the plan body declares a `reopen_via:`\n    # ADR reference (audit-v2 ADR-092 honest-deferral framework).\n    # done → superseded is allowed when a later plan absorbs the scope.\n    \"done\": {\"done\", \"executing\", \"superseded\"},\n    \"abandoned\": {\"abandoned\"},  # terminal\n    \"refused\": {\"refused\"},  # terminal — must cite refused_adr\n    \"superseded\": {\"superseded\"},  # terminal — must cite superseded_by\n}\n\n# ---------------------------------------------------------------------\n# PLAN-065 §4.4.B — Stranded-work detection thresholds\n# ---------------------------------------------------------------------\n#\n# Mode 8.2 (\"Paperclip in_progress sem run vivo\"): plan stuck in\n# `status: executing` with no commit touching the plan file in this\n# many seconds. 24h matches Paperclip's `WIP > 1d` heuristic.\n_STRANDED_EXECUTING_MAX_AGE_SECS = 24 * 3600  # 24 hours\n\n# Mode 8.1 (\"todo dispatch falhou\"): plan parked in `status: reviewed`\n# with a `reviewed_at` ISO date older than this many seconds. 7 days\n# is the Owner-wake threshold per PLAN-065 §4.4.B.\n_STRANDED_REVIEWED_MAX_AGE_SECS = 7 * 24 * 3600  # 7 days\n\n\ndef _extract_plan_id(file_path: str) -> str:\n    \"\"\"Return the plan ID from a plan file path, or empty string.\"\"\"\n    return _plan_paths.plan_id_from_path(file_path)\n\n\ndef _emit_transition(file_path: str, old_status: str, new_status: str, editor_tool: str = \"Edit\") -> None:\n    \"\"\"Fail-open emit of plan_transition event to stream v2.\"\"\"\n    if not _AUDIT_EMIT_AVAILABLE:\n        return\n    try:\n        plan_id = _extract_plan_id(file_path)\n        if not plan_id or not old_status or not new_status or old_status == new_status:\n            return\n        import os as _os\n        _audit_emit.emit_plan_transition(\n            plan_id=plan_id,\n            from_status=old_status,\n            to_status=new_status,\n            file_path=file_path,\n            editor_tool=editor_tool,\n            project=_os.environ.get(\"CLAUDE_PROJECT_DIR\") or \"\",\n        )\n    except Exception:  # pragma: no cover\n        pass\n\n\ndef _emit_stranded(plan_id: str, mode: str, age_days: int, status: str, file_path: str) -> None:\n    \"\"\"Fail-open emit of stranded_plan_detected event.\n\n    PLAN-065 §4.4.B — `stranded_plan_detected` is NOT yet in the\n    `_KNOWN_ACTIONS` registry. We attempt the emit via `emit_generic`\n    which silently breadcrumbs unknown actions (no-op pre-canonical\n    ceremony). Once the action is registered in audit_emit.py\n    (PLAN-065 Phase 4-B canonical ceremony), the same call site\n    starts producing real events with no code change.\n    \"\"\"\n    # PLAN-065 Phase 4-B v1.12.1: action `stranded_plan_detected` is NOT\n    # YET registered in `_KNOWN_ACTIONS`. Wiring deferred to v1.13.0 /\n    # PLAN-067 (per ADR-093 §per-plan-cap — ADR-098 already consumed for\n    # PLAN-065). Until then, this is a no-op stub. The actual emit call\n    # is intentionally absent to avoid `check-audit-registry-coverage.py`\n    # AST drift detector flagging an orphan emit (would block PR).\n    # Reference inputs so static analyzers see them used:\n    _ = plan_id, mode, age_days, status, file_path\n    if not _AUDIT_EMIT_AVAILABLE:\n        return\n    return\n\n\n@dataclass\nclass StrandedPlan:\n    \"\"\"Typed result of stranded-plan detection.\n\n    PLAN-065 §4.4.B. Field semantics:\n\n    - ``plan_id``: PLAN-NNN identifier extracted from filename.\n    - ``mode``: ``\"8.1\"`` (reviewed dispatch failed) or ``\"8.2\"``\n      (executing paperclip — no run vivo).\n    - ``age_days``: integer days since the relevant timestamp\n      (commit mtime for 8.2; ``reviewed_at`` for 8.1).\n    - ``status``: current frontmatter status (executing / reviewed).\n    - ``file_path``: relative-or-absolute path to the plan file.\n    \"\"\"\n\n    plan_id: str\n    mode: str\n    age_days: int\n    status: str\n    file_path: str\n\n\n@dataclass\nclass Decision:\n    \"\"\"Typed result.\"\"\"\n\n    allow: bool\n    reason: Optional[str] = None\n\n    def to_json(self) -> str:\n        if self.allow:\n            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow\n        return json.dumps(\n            {\"decision\": \"block\", \"reason\": self.reason or \"\"},\n            ensure_ascii=False,\n        )\n\n\ndef _is_plan_file(file_path: str) -> bool:\n    \"\"\"Return True only for a schema-valid plan path.\"\"\"\n    return _plan_paths.is_plan_path(file_path)\n\n\ndef _read_current_plan(file_path: str) -> str:\n    \"\"\"Read the current file content. Returns empty string on any error.\"\"\"\n    try:\n        return Path(file_path).read_text(encoding=\"utf-8\")\n    except (OSError, UnicodeDecodeError):\n        return \"\"\n\n\ndef _apply_edit(\n    current: str, old_string: str, new_string: str, replace_all: bool\n) -> str:\n    \"\"\"Simulate the Edit tool's substitution locally.\n\n    Returns the post-edit content. If old_string is not in current,\n    returns current unchanged (the real Edit would fail, but we don't\n    want to block on that — fail-open to let Edit produce its own error).\n    \"\"\"\n    if not current or old_string not in current:\n        return current\n    if replace_all:\n        return current.replace(old_string, new_string)\n    # Non-replace-all: replace first occurrence only\n    return current.replace(old_string, new_string, 1)\n\n\ndef _check_transition(\n    old_status: str, new_status: str\n) -> Optional[str]:\n    \"\"\"Return a block reason if the transition is illegal; None if OK.\"\"\"\n    if new_status not in _LEGAL_STATUSES:\n        return (\n            f\"PLAN-LIFECYCLE: illegal status value '{new_status}'. \"\n            f\"Must be one of: {', '.join(sorted(_LEGAL_STATUSES))}.\"\n        )\n    if not old_status:\n        # New plan (no existing status in the old content) — anything legal is fine\n        return None","numLines":200,"startLine":80,"totalLines":957}},"tool_result_meta":[{"id":"toolu_01CVeoGFGHJPqpzaU3TWCvYo","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
