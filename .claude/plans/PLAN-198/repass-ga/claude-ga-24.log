{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7AG3TPj8E55nRr3JTnv","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Cxopw1MP89Gybgm63j4FPu","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_plan_edit.py","offset":279,"limit":420},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5029,"cache_read_input_tokens":201798,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5029},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"fff1c582-0add-4cc7-a8a5-0376027f1063","uuid":"2177c11b-7a19-42d4-ad3c-f856e6b95f98","timestamp":"2026-11-16T19:29:26.642Z","request_id":"req_011Ch7AG3C1pVrvXoMEs4n9y","wire_tool_inputs":{"toolu_01Cxopw1MP89Gybgm63j4FPu":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_plan_edit.py","offset":279,"limit":420}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Cxopw1MP89Gybgm63j4FPu","type":"tool_result","content":"279\t        return None\n280\t    if old_status not in _LEGAL_STATUSES:\n281\t        # Corrupt existing status — don't block; let it be cleaned up\n282\t        return None\n283\t    allowed = _ALLOWED_TRANSITIONS.get(old_status, set())\n284\t    if new_status not in allowed:\n285\t        return (\n286\t            f\"PLAN-LIFECYCLE: illegal transition '{old_status}' → '{new_status}'. \"\n287\t            f\"From '{old_status}', allowed next states: \"\n288\t            f\"{', '.join(sorted(allowed - {old_status}))}. \"\n289\t            f\"See .claude/plans/PLAN-SCHEMA.md §4.\"\n290\t        )\n291\t    return None\n292\t\n293\t\n294\tdef _check_required_fields(\n295\t    old_status: str,\n296\t    new_status: str,\n297\t    new_fm: Dict[str, _fm.FrontmatterValue],\n298\t    new_body: str,\n299\t) -> Optional[str]:\n300\t    \"\"\"Check required fields for the new status. Returns reason or None.\n301\t\n302\t    Session 76 audit-v3 (DIM-11) extended this to enforce the full\n303\t    ADR-092 honest-deferral contract: `refused_at` for `refused`, plus\n304\t    `reopen_via` + `reopen_trigger` + `## Reopen criteria` body section\n305\t    for the `done -> executing` reopen path. Prior to this fix the FSM\n306\t    accepted reopen with no body fields and refused without `refused_at`.\n307\t    \"\"\"\n308\t    if new_status == \"reviewed\":\n309\t        if not new_fm.get(\"reviewed_at\"):\n310\t            return (\n311\t                \"PLAN-LIFECYCLE: transition to 'reviewed' requires \"\n312\t                \"`reviewed_at: <YYYY-MM-DD>` in frontmatter.\"\n313\t            )\n314\t    elif new_status == \"done\":\n315\t        if not new_fm.get(\"completed_at\"):\n316\t            return (\n317\t                \"PLAN-LIFECYCLE: transition to 'done' requires \"\n318\t                \"`completed_at: <YYYY-MM-DD>` in frontmatter.\"\n319\t            )\n320\t        rc = new_fm.get(\"related_commits\")\n321\t        if not rc or (isinstance(rc, list) and len(rc) == 0):\n322\t            return (\n323\t                \"PLAN-LIFECYCLE: transition to 'done' requires non-empty \"\n324\t                \"`related_commits: [sha1, sha2, ...]` in frontmatter.\"\n325\t            )\n326\t    elif new_status == \"abandoned\":\n327\t        if not _fm.has_abandonment_reason(new_body):\n328\t            return (\n329\t                \"PLAN-LIFECYCLE: transition to 'abandoned' requires an \"\n330\t                \"`## Abandonment reason` section in the plan body.\"\n331\t            )\n332\t    elif new_status == \"refused\":\n333\t        # Session 75 Codex Finding 7: terminal `refused` status requires\n334\t        # a `refused_adr: ADR-NNN` field citing the ADR that documents\n335\t        # the refusal. Closes the gap where _LEGAL_STATUSES allowed\n336\t        # `refused` but no field validation enforced citation.\n337\t        refused_adr = new_fm.get(\"refused_adr\")\n338\t        if not refused_adr:\n339\t            return (\n340\t                \"PLAN-LIFECYCLE: transition to 'refused' requires \"\n341\t                \"`refused_adr: ADR-NNN` in frontmatter (cite the ADR \"\n342\t                \"that documents the refusal). Per ADR-092 honest deferral.\"\n343\t            )\n344\t        ra = str(refused_adr).strip()\n345\t        import re as _re\n346\t        if not _re.match(r\"^ADR-\\d{3,4}\\b\", ra):\n347\t            return (\n348\t                \"PLAN-LIFECYCLE: 'refused_adr' field must be an ADR \"\n349\t                \"identifier of the form 'ADR-NNN' or 'ADR-NNNN'.\"\n350\t            )\n351\t        # Session 76 audit-v3 (DIM-11) — ADR-092 also requires refused_at.\n352\t        if not new_fm.get(\"refused_at\"):\n353\t            return (\n354\t                \"PLAN-LIFECYCLE: transition to 'refused' requires \"\n355\t                \"`refused_at: <YYYY-MM-DD>` in frontmatter. Per ADR-092 \"\n356\t                \"honest deferral.\"\n357\t            )\n358\t    elif new_status == \"superseded\":\n359\t        # PLAN-113 W2 — terminal `superseded` status requires a\n360\t        # `superseded_by:` field naming the plan that absorbed this\n361\t        # plan's scope. Mirrors the abandoned/refused citation pattern:\n362\t        # a superseded plan must point forward to where the work lives.\n363\t        superseded_by = new_fm.get(\"superseded_by\")\n364\t        if not superseded_by:\n365\t            return (\n366\t                \"PLAN-LIFECYCLE: transition to 'superseded' requires \"\n367\t                \"`superseded_by: PLAN-NNN` in frontmatter (name the plan \"\n368\t                \"that absorbed this plan's scope).\"\n369\t            )\n370\t        sb = str(superseded_by).strip()\n371\t        import re as _re_superseded\n372\t        if not _re_superseded.match(r\"^PLAN-\\d{3}\\b\", sb):\n373\t            return (\n374\t                \"PLAN-LIFECYCLE: 'superseded_by' field must be a plan \"\n375\t                \"identifier of the form 'PLAN-NNN'.\"\n376\t            )\n377\t    elif new_status == \"executing\" and old_status == \"done\":\n378\t        # Session 76 audit-v3 (DIM-11) — `done -> executing` reopen per\n379\t        # ADR-092 requires `reopen_via: ADR-NNN` + `reopen_trigger:\n380\t        # <free-text>` + body section `## Reopen criteria`. Prior FSM\n381\t        # let plans silently flip back without these fields.\n382\t        reopen_via = new_fm.get(\"reopen_via\")\n383\t        if not reopen_via:\n384\t            return (\n385\t                \"PLAN-LIFECYCLE: reopen 'done' -> 'executing' requires \"\n386\t                \"`reopen_via: ADR-NNN` in frontmatter. Per ADR-092 honest \"\n387\t                \"deferral framework.\"\n388\t            )\n389\t        rv = str(reopen_via).strip()\n390\t        import re as _re_reopen\n391\t        if not _re_reopen.match(r\"^ADR-\\d{3,4}\\b\", rv):\n392\t            return (\n393\t                \"PLAN-LIFECYCLE: 'reopen_via' field must be an ADR \"\n394\t                \"identifier of the form 'ADR-NNN' or 'ADR-NNNN'.\"\n395\t            )\n396\t        if not new_fm.get(\"reopen_trigger\"):\n397\t            return (\n398\t                \"PLAN-LIFECYCLE: reopen 'done' -> 'executing' requires \"\n399\t                \"`reopen_trigger: <free-text describing the external \"\n400\t                \"signal>` in frontmatter. Per ADR-092.\"\n401\t            )\n402\t        if \"## Reopen criteria\" not in new_body:\n403\t            return (\n404\t                \"PLAN-LIFECYCLE: reopen 'done' -> 'executing' requires a \"\n405\t                \"`## Reopen criteria` section in the plan body. Per ADR-092.\"\n406\t            )\n407\t    return None\n408\t\n409\t\n410\t# ---------------------------------------------------------------------\n411\t# PLAN-065 §4.4.B — Stranded-work detection helpers\n412\t# ---------------------------------------------------------------------\n413\t\n414\t\n415\tdef _parse_iso_date_to_unix(s: str) -> Optional[int]:\n416\t    \"\"\"Parse ``YYYY-MM-DD`` (or ISO datetime) to a UTC unix timestamp.\n417\t\n418\t    Returns None on any malformed input. Tolerates the three formats\n419\t    used elsewhere in the framework:\n420\t\n421\t    - ``2026-04-12``               (date only — anchored to 00:00 UTC)\n422\t    - ``2026-04-12T13:45:01Z``\n423\t    - ``2026-04-12T13:45:01+0000``\n424\t\n425\t    Stdlib only. ``datetime.fromisoformat`` is not used (Py3.9 does not\n426\t    accept ``Z``); we fall back to ``strptime``.\n427\t    \"\"\"\n428\t    if not s:\n429\t        return None\n430\t    s = str(s).strip()\n431\t    if not s:\n432\t        return None\n433\t    for fmt in (\"%Y-%m-%dT%H:%M:%SZ\", \"%Y-%m-%dT%H:%M:%S%z\", \"%Y-%m-%d\"):\n434\t        try:\n435\t            d = datetime.strptime(s, fmt)\n436\t            if d.tzinfo is None:\n437\t                d = d.replace(tzinfo=timezone.utc)\n438\t            return int(d.timestamp())\n439\t        except ValueError:\n440\t            continue\n441\t    return None\n442\t\n443\t\n444\tdef _git_last_commit_unix(plan_path: Path, repo_root: Optional[Path] = None) -> Optional[int]:\n445\t    \"\"\"Return unix-ts of the most recent commit touching ``plan_path``.\n446\t\n447\t    Uses ``git log -1 --format=%ct -- <path>``. Returns None on any\n448\t    git error (not a repo, file untracked, git binary missing, etc.).\n449\t    Fail-open invariant: detection short-circuits to \"no stranded\n450\t    finding for this plan\" rather than blocking the hook.\n451\t    \"\"\"\n452\t    try:\n453\t        cwd = str(repo_root) if repo_root else str(plan_path.parent)\n454\t        result = subprocess.run(\n455\t            [\"git\", \"log\", \"-1\", \"--format=%ct\", \"--\", str(plan_path)],\n456\t            capture_output=True,\n457\t            text=True,\n458\t            timeout=2.0,\n459\t            cwd=cwd,\n460\t        )\n461\t        if result.returncode != 0:\n462\t            return None\n463\t        out = (result.stdout or \"\").strip()\n464\t        if not out:\n465\t            return None\n466\t        return int(out)\n467\t    except (subprocess.TimeoutExpired, subprocess.SubprocessError,\n468\t            FileNotFoundError, ValueError, OSError):\n469\t        return None\n470\t\n471\t\n472\tdef detect_stranded(\n473\t    plans_dir: Path,\n474\t    *,\n475\t    now_unix: Optional[int] = None,\n476\t    repo_root: Optional[Path] = None,\n477\t) -> List[StrandedPlan]:\n478\t    \"\"\"Walk plans_dir and return all stranded plans across modes 8.1 + 8.2.\n479\t\n480\t    PLAN-065 §4.4.B. Stranded modes:\n481\t\n482\t    - **Mode 8.2 paperclip** — ``status == executing`` and no commit\n483\t      has touched the plan file in the last\n484\t      ``_STRANDED_EXECUTING_MAX_AGE_SECS`` seconds (24h). If the\n485\t      frontmatter declares ``last_commit_at: <ISO-date>`` that value\n486\t      overrides the git-log query (used by tests + by environments\n487\t      where git history is unavailable but the plan author manually\n488\t      records progress). Mode-8.2 has priority over Mode-8.1: an\n489\t      executing-too-long plan is reported as 8.2 only.\n490\t    - **Mode 8.1 todo-dispatch-failed** — ``status == reviewed`` and\n491\t      ``reviewed_at`` is older than\n492\t      ``_STRANDED_REVIEWED_MAX_AGE_SECS`` seconds (7d).\n493\t\n494\t    Args:\n495\t        plans_dir: directory holding ``PLAN-*.md`` files. Non-PLAN\n496\t            files (PLAN-SCHEMA.md, examples/, archive/) are skipped.\n497\t        now_unix: unix timestamp to compare against (defaults to\n498\t            ``time.time()``). Injected for deterministic tests.\n499\t        repo_root: passed to ``git log`` ``cwd``. Defaults to plans_dir.\n500\t\n501\t    Returns:\n502\t        List of StrandedPlan, in deterministic alphabetical order by\n503\t        plan filename.\n504\t\n505\t    Fail-open invariant: any per-plan exception is swallowed and the\n506\t    walk continues. A blanket exception on the directory walk returns\n507\t    an empty list. The hook NEVER blocks on stranded detection.\n508\t    \"\"\"\n509\t    if now_unix is None:\n510\t        now_unix = int(time.time())\n511\t\n512\t    results: List[StrandedPlan] = []\n513\t    if not plans_dir or not plans_dir.is_dir():\n514\t        return results\n515\t\n516\t    try:\n517\t        plan_files = sorted(plans_dir.glob(\"PLAN-*.md\"))\n518\t    except OSError:\n519\t        return results\n520\t\n521\t    for plan_file in plan_files:\n522\t        try:\n523\t            # Skip PLAN-SCHEMA.md / DEBATE-SCHEMA.md / etc.\n524\t            if not _is_plan_file(str(plan_file)):\n525\t                continue\n526\t\n527\t            text = plan_file.read_text(encoding=\"utf-8\")\n528\t            fm = _fm.parse_frontmatter(text)\n529\t            status = str(fm.get(\"status\", \"\")).strip()\n530\t            plan_id = _extract_plan_id(plan_file.name) or plan_file.stem\n531\t            file_path = str(plan_file)\n532\t\n533\t            if status == \"executing\":\n534\t                # Mode 8.2 — query last-commit timestamp, frontmatter\n535\t                # override wins for testability.\n536\t                fm_lc = fm.get(\"last_commit_at\", \"\")\n537\t                last_unix: Optional[int] = None\n538\t                if fm_lc:\n539\t                    last_unix = _parse_iso_date_to_unix(str(fm_lc))\n540\t                if last_unix is None:\n541\t                    last_unix = _git_last_commit_unix(plan_file, repo_root=repo_root)\n542\t                if last_unix is None:\n543\t                    # No data → cannot decide stranded; skip (fail-open).\n544\t                    continue\n545\t                age_secs = now_unix - last_unix\n546\t                if age_secs > _STRANDED_EXECUTING_MAX_AGE_SECS:\n547\t                    age_days = max(0, age_secs // 86400)\n548\t                    results.append(\n549\t                        StrandedPlan(\n550\t                            plan_id=plan_id,\n551\t                            mode=\"8.2\",\n552\t                            age_days=int(age_days),\n553\t                            status=status,\n554\t                            file_path=file_path,\n555\t                        )\n556\t                    )\n557\t                continue  # mode-8.2 priority over mode-8.1\n558\t\n559\t            if status == \"reviewed\":\n560\t                fm_rv = fm.get(\"reviewed_at\", \"\")\n561\t                if not fm_rv:\n562\t                    continue\n563\t                reviewed_unix = _parse_iso_date_to_unix(str(fm_rv))\n564\t                if reviewed_unix is None:\n565\t                    continue\n566\t                age_secs = now_unix - reviewed_unix\n567\t                if age_secs > _STRANDED_REVIEWED_MAX_AGE_SECS:\n568\t                    age_days = max(0, age_secs // 86400)\n569\t                    results.append(\n570\t                        StrandedPlan(\n571\t                            plan_id=plan_id,\n572\t                            mode=\"8.1\",\n573\t                            age_days=int(age_days),\n574\t                            status=status,\n575\t                            file_path=file_path,\n576\t                        )\n577\t                    )\n578\t                continue\n579\t        except Exception:\n580\t            # Per-plan fail-open: a corrupt plan must not block the walk.\n581\t            continue\n582\t\n583\t    return results\n584\t\n585\t\n586\tdef _stranded_breadcrumb(strandeds: List[StrandedPlan]) -> str:\n587\t    \"\"\"Render a short, audit-friendly summary line for the systemMessage.\"\"\"\n588\t    if not strandeds:\n589\t        return \"\"\n590\t    parts = []\n591\t    for s in strandeds[:5]:  # cap output — breadcrumb only\n592\t        parts.append(f\"{s.plan_id} (mode {s.mode}, {s.age_days}d)\")\n593\t    suffix = \"\"\n594\t    if len(strandeds) > 5:\n595\t        suffix = f\" +{len(strandeds) - 5} more\"\n596\t    return \"PLAN-LIFECYCLE-STRANDED: \" + \", \".join(parts) + suffix\n597\t\n598\t\n599\tdef decide(\n600\t    *,\n601\t    file_path: str,\n602\t    old_string: str,\n603\t    new_string: str,\n604\t    replace_all: bool,\n605\t    read_current=_read_current_plan,\n606\t) -> Decision:\n607\t    \"\"\"Pure decision function — IO injected via read_current for testing.\"\"\"\n608\t    # Scope guard: only run on plan files\n609\t    if not _is_plan_file(file_path):\n610\t        return Decision(allow=True)\n611\t\n612\t    # Read current file content\n613\t    current = read_current(file_path)\n614\t    if not current:\n615\t        # File doesn't exist yet (creation via Edit is unusual; fail-open)\n616\t        return Decision(allow=True)\n617\t\n618\t    # Compute post-edit content\n619\t    new_content = _apply_edit(current, old_string, new_string, replace_all)\n620\t    if new_content == current:\n621\t        # Edit doesn't actually modify the file (or old_string not found)\n622\t        return Decision(allow=True)\n623\t\n624\t    return _decide_on_buffers(current, new_content)\n625\t\n626\t\n627\tdef _decide_on_buffers(old_content: str, new_content: str) -> Decision:\n628\t    \"\"\"Common decision path once we have pre/post buffers.\n629\t\n630\t    Used by the Edit path (direct substitution), the Write path (full\n631\t    replacement) and the MultiEdit path (sequential application).\n632\t    \"\"\"\n633\t    if new_content == old_content:\n634\t        return Decision(allow=True)\n635\t\n636\t    old_fm = _fm.parse_frontmatter(old_content)\n637\t    new_fm = _fm.parse_frontmatter(new_content)\n638\t\n639\t    old_status = str(old_fm.get(\"status\", \"\")).strip()\n640\t    new_status = str(new_fm.get(\"status\", \"\")).strip()\n641\t\n642\t    # If status didn't change, nothing to check\n643\t    if old_status == new_status:\n644\t        return Decision(allow=True)\n645\t\n646\t    # Status changed — validate\n647\t    reason = _check_transition(old_status, new_status)\n648\t    if reason:\n649\t        return Decision(allow=False, reason=reason)\n650\t\n651\t    reason = _check_required_fields(old_status, new_status, new_fm, new_content)\n652\t    if reason:\n653\t        return Decision(allow=False, reason=reason)\n654\t\n655\t    return Decision(allow=True)\n656\t\n657\t\n658\tdef decide_write(\n659\t    *,\n660\t    file_path: str,\n661\t    content: str,\n662\t    read_current=_read_current_plan,\n663\t) -> Decision:\n664\t    \"\"\"Write-tool variant of decide().\n665\t\n666\t    PLAN-019 P1-SEC-E: `Write` has `content` instead of old/new strings.\n667\t    We synthesize an Edit where old_string = <entire existing content>\n668\t    (or empty for a new file) and new_string = <content>, then run the\n669\t    same transition + required-field checks.\n670\t\n671\t    If the Write creates a brand-new plan file, `current` is empty. The\n672\t    transition validation still runs: a new plan with `status: done` but\n673\t    no `completed_at` is blocked just like `draft → done` via Edit.\n674\t    \"\"\"\n675\t    if not _is_plan_file(file_path):\n676\t        return Decision(allow=True)\n677\t\n678\t    current = read_current(file_path) or \"\"\n679\t    new_content = content or \"\"\n680\t    if new_content == current:\n681\t        return Decision(allow=True)\n682\t\n683\t    # For brand-new plan files (current == \"\"), old_status is empty and\n684\t    # the transition validator treats any legal new status as OK (see\n685\t    # _check_transition \"new plan\" branch). Required-field checks still\n686\t    # fire, so a new plan written directly as done/without-completed_at\n687\t    # blocks correctly.\n688\t    return _decide_on_buffers(current, new_content)\n689\t\n690\t\n691\tdef decide_multiedit(\n692\t    *,\n693\t    file_path: str,\n694\t    edits: list,\n695\t    read_current=_read_current_plan,\n696\t) -> Decision:\n697\t    \"\"\"MultiEdit-tool variant of decide().\n698\t"}]},"parent_tool_use_id":null,"session_id":"fff1c582-0add-4cc7-a8a5-0376027f1063","uuid":"daee73c0-7d7e-41dc-80ba-2203911063c1","timestamp":"2026-11-16T19:29:26.648Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_plan_edit.py","content":"        return None\n    if old_status not in _LEGAL_STATUSES:\n        # Corrupt existing status — don't block; let it be cleaned up\n        return None\n    allowed = _ALLOWED_TRANSITIONS.get(old_status, set())\n    if new_status not in allowed:\n        return (\n            f\"PLAN-LIFECYCLE: illegal transition '{old_status}' → '{new_status}'. \"\n            f\"From '{old_status}', allowed next states: \"\n            f\"{', '.join(sorted(allowed - {old_status}))}. \"\n            f\"See .claude/plans/PLAN-SCHEMA.md §4.\"\n        )\n    return None\n\n\ndef _check_required_fields(\n    old_status: str,\n    new_status: str,\n    new_fm: Dict[str, _fm.FrontmatterValue],\n    new_body: str,\n) -> Optional[str]:\n    \"\"\"Check required fields for the new status. Returns reason or None.\n\n    Session 76 audit-v3 (DIM-11) extended this to enforce the full\n    ADR-092 honest-deferral contract: `refused_at` for `refused`, plus\n    `reopen_via` + `reopen_trigger` + `## Reopen criteria` body section\n    for the `done -> executing` reopen path. Prior to this fix the FSM\n    accepted reopen with no body fields and refused without `refused_at`.\n    \"\"\"\n    if new_status == \"reviewed\":\n        if not new_fm.get(\"reviewed_at\"):\n            return (\n                \"PLAN-LIFECYCLE: transition to 'reviewed' requires \"\n                \"`reviewed_at: <YYYY-MM-DD>` in frontmatter.\"\n            )\n    elif new_status == \"done\":\n        if not new_fm.get(\"completed_at\"):\n            return (\n                \"PLAN-LIFECYCLE: transition to 'done' requires \"\n                \"`completed_at: <YYYY-MM-DD>` in frontmatter.\"\n            )\n        rc = new_fm.get(\"related_commits\")\n        if not rc or (isinstance(rc, list) and len(rc) == 0):\n            return (\n                \"PLAN-LIFECYCLE: transition to 'done' requires non-empty \"\n                \"`related_commits: [sha1, sha2, ...]` in frontmatter.\"\n            )\n    elif new_status == \"abandoned\":\n        if not _fm.has_abandonment_reason(new_body):\n            return (\n                \"PLAN-LIFECYCLE: transition to 'abandoned' requires an \"\n                \"`## Abandonment reason` section in the plan body.\"\n            )\n    elif new_status == \"refused\":\n        # Session 75 Codex Finding 7: terminal `refused` status requires\n        # a `refused_adr: ADR-NNN` field citing the ADR that documents\n        # the refusal. Closes the gap where _LEGAL_STATUSES allowed\n        # `refused` but no field validation enforced citation.\n        refused_adr = new_fm.get(\"refused_adr\")\n        if not refused_adr:\n            return (\n                \"PLAN-LIFECYCLE: transition to 'refused' requires \"\n                \"`refused_adr: ADR-NNN` in frontmatter (cite the ADR \"\n                \"that documents the refusal). Per ADR-092 honest deferral.\"\n            )\n        ra = str(refused_adr).strip()\n        import re as _re\n        if not _re.match(r\"^ADR-\\d{3,4}\\b\", ra):\n            return (\n                \"PLAN-LIFECYCLE: 'refused_adr' field must be an ADR \"\n                \"identifier of the form 'ADR-NNN' or 'ADR-NNNN'.\"\n            )\n        # Session 76 audit-v3 (DIM-11) — ADR-092 also requires refused_at.\n        if not new_fm.get(\"refused_at\"):\n            return (\n                \"PLAN-LIFECYCLE: transition to 'refused' requires \"\n                \"`refused_at: <YYYY-MM-DD>` in frontmatter. Per ADR-092 \"\n                \"honest deferral.\"\n            )\n    elif new_status == \"superseded\":\n        # PLAN-113 W2 — terminal `superseded` status requires a\n        # `superseded_by:` field naming the plan that absorbed this\n        # plan's scope. Mirrors the abandoned/refused citation pattern:\n        # a superseded plan must point forward to where the work lives.\n        superseded_by = new_fm.get(\"superseded_by\")\n        if not superseded_by:\n            return (\n                \"PLAN-LIFECYCLE: transition to 'superseded' requires \"\n                \"`superseded_by: PLAN-NNN` in frontmatter (name the plan \"\n                \"that absorbed this plan's scope).\"\n            )\n        sb = str(superseded_by).strip()\n        import re as _re_superseded\n        if not _re_superseded.match(r\"^PLAN-\\d{3}\\b\", sb):\n            return (\n                \"PLAN-LIFECYCLE: 'superseded_by' field must be a plan \"\n                \"identifier of the form 'PLAN-NNN'.\"\n            )\n    elif new_status == \"executing\" and old_status == \"done\":\n        # Session 76 audit-v3 (DIM-11) — `done -> executing` reopen per\n        # ADR-092 requires `reopen_via: ADR-NNN` + `reopen_trigger:\n        # <free-text>` + body section `## Reopen criteria`. Prior FSM\n        # let plans silently flip back without these fields.\n        reopen_via = new_fm.get(\"reopen_via\")\n        if not reopen_via:\n            return (\n                \"PLAN-LIFECYCLE: reopen 'done' -> 'executing' requires \"\n                \"`reopen_via: ADR-NNN` in frontmatter. Per ADR-092 honest \"\n                \"deferral framework.\"\n            )\n        rv = str(reopen_via).strip()\n        import re as _re_reopen\n        if not _re_reopen.match(r\"^ADR-\\d{3,4}\\b\", rv):\n            return (\n                \"PLAN-LIFECYCLE: 'reopen_via' field must be an ADR \"\n                \"identifier of the form 'ADR-NNN' or 'ADR-NNNN'.\"\n            )\n        if not new_fm.get(\"reopen_trigger\"):\n            return (\n                \"PLAN-LIFECYCLE: reopen 'done' -> 'executing' requires \"\n                \"`reopen_trigger: <free-text describing the external \"\n                \"signal>` in frontmatter. Per ADR-092.\"\n            )\n        if \"## Reopen criteria\" not in new_body:\n            return (\n                \"PLAN-LIFECYCLE: reopen 'done' -> 'executing' requires a \"\n                \"`## Reopen criteria` section in the plan body. Per ADR-092.\"\n            )\n    return None\n\n\n# ---------------------------------------------------------------------\n# PLAN-065 §4.4.B — Stranded-work detection helpers\n# ---------------------------------------------------------------------\n\n\ndef _parse_iso_date_to_unix(s: str) -> Optional[int]:\n    \"\"\"Parse ``YYYY-MM-DD`` (or ISO datetime) to a UTC unix timestamp.\n\n    Returns None on any malformed input. Tolerates the three formats\n    used elsewhere in the framework:\n\n    - ``2026-04-12``               (date only — anchored to 00:00 UTC)\n    - ``2026-04-12T13:45:01Z``\n    - ``2026-04-12T13:45:01+0000``\n\n    Stdlib only. ``datetime.fromisoformat`` is not used (Py3.9 does not\n    accept ``Z``); we fall back to ``strptime``.\n    \"\"\"\n    if not s:\n        return None\n    s = str(s).strip()\n    if not s:\n        return None\n    for fmt in (\"%Y-%m-%dT%H:%M:%SZ\", \"%Y-%m-%dT%H:%M:%S%z\", \"%Y-%m-%d\"):\n        try:\n            d = datetime.strptime(s, fmt)\n            if d.tzinfo is None:\n                d = d.replace(tzinfo=timezone.utc)\n            return int(d.timestamp())\n        except ValueError:\n            continue\n    return None\n\n\ndef _git_last_commit_unix(plan_path: Path, repo_root: Optional[Path] = None) -> Optional[int]:\n    \"\"\"Return unix-ts of the most recent commit touching ``plan_path``.\n\n    Uses ``git log -1 --format=%ct -- <path>``. Returns None on any\n    git error (not a repo, file untracked, git binary missing, etc.).\n    Fail-open invariant: detection short-circuits to \"no stranded\n    finding for this plan\" rather than blocking the hook.\n    \"\"\"\n    try:\n        cwd = str(repo_root) if repo_root else str(plan_path.parent)\n        result = subprocess.run(\n            [\"git\", \"log\", \"-1\", \"--format=%ct\", \"--\", str(plan_path)],\n            capture_output=True,\n            text=True,\n            timeout=2.0,\n            cwd=cwd,\n        )\n        if result.returncode != 0:\n            return None\n        out = (result.stdout or \"\").strip()\n        if not out:\n            return None\n        return int(out)\n    except (subprocess.TimeoutExpired, subprocess.SubprocessError,\n            FileNotFoundError, ValueError, OSError):\n        return None\n\n\ndef detect_stranded(\n    plans_dir: Path,\n    *,\n    now_unix: Optional[int] = None,\n    repo_root: Optional[Path] = None,\n) -> List[StrandedPlan]:\n    \"\"\"Walk plans_dir and return all stranded plans across modes 8.1 + 8.2.\n\n    PLAN-065 §4.4.B. Stranded modes:\n\n    - **Mode 8.2 paperclip** — ``status == executing`` and no commit\n      has touched the plan file in the last\n      ``_STRANDED_EXECUTING_MAX_AGE_SECS`` seconds (24h). If the\n      frontmatter declares ``last_commit_at: <ISO-date>`` that value\n      overrides the git-log query (used by tests + by environments\n      where git history is unavailable but the plan author manually\n      records progress). Mode-8.2 has priority over Mode-8.1: an\n      executing-too-long plan is reported as 8.2 only.\n    - **Mode 8.1 todo-dispatch-failed** — ``status == reviewed`` and\n      ``reviewed_at`` is older than\n      ``_STRANDED_REVIEWED_MAX_AGE_SECS`` seconds (7d).\n\n    Args:\n        plans_dir: directory holding ``PLAN-*.md`` files. Non-PLAN\n            files (PLAN-SCHEMA.md, examples/, archive/) are skipped.\n        now_unix: unix timestamp to compare against (defaults to\n            ``time.time()``). Injected for deterministic tests.\n        repo_root: passed to ``git log`` ``cwd``. Defaults to plans_dir.\n\n    Returns:\n        List of StrandedPlan, in deterministic alphabetical order by\n        plan filename.\n\n    Fail-open invariant: any per-plan exception is swallowed and the\n    walk continues. A blanket exception on the directory walk returns\n    an empty list. The hook NEVER blocks on stranded detection.\n    \"\"\"\n    if now_unix is None:\n        now_unix = int(time.time())\n\n    results: List[StrandedPlan] = []\n    if not plans_dir or not plans_dir.is_dir():\n        return results\n\n    try:\n        plan_files = sorted(plans_dir.glob(\"PLAN-*.md\"))\n    except OSError:\n        return results\n\n    for plan_file in plan_files:\n        try:\n            # Skip PLAN-SCHEMA.md / DEBATE-SCHEMA.md / etc.\n            if not _is_plan_file(str(plan_file)):\n                continue\n\n            text = plan_file.read_text(encoding=\"utf-8\")\n            fm = _fm.parse_frontmatter(text)\n            status = str(fm.get(\"status\", \"\")).strip()\n            plan_id = _extract_plan_id(plan_file.name) or plan_file.stem\n            file_path = str(plan_file)\n\n            if status == \"executing\":\n                # Mode 8.2 — query last-commit timestamp, frontmatter\n                # override wins for testability.\n                fm_lc = fm.get(\"last_commit_at\", \"\")\n                last_unix: Optional[int] = None\n                if fm_lc:\n                    last_unix = _parse_iso_date_to_unix(str(fm_lc))\n                if last_unix is None:\n                    last_unix = _git_last_commit_unix(plan_file, repo_root=repo_root)\n                if last_unix is None:\n                    # No data → cannot decide stranded; skip (fail-open).\n                    continue\n                age_secs = now_unix - last_unix\n                if age_secs > _STRANDED_EXECUTING_MAX_AGE_SECS:\n                    age_days = max(0, age_secs // 86400)\n                    results.append(\n                        StrandedPlan(\n                            plan_id=plan_id,\n                            mode=\"8.2\",\n                            age_days=int(age_days),\n                            status=status,\n                            file_path=file_path,\n                        )\n                    )\n                continue  # mode-8.2 priority over mode-8.1\n\n            if status == \"reviewed\":\n                fm_rv = fm.get(\"reviewed_at\", \"\")\n                if not fm_rv:\n                    continue\n                reviewed_unix = _parse_iso_date_to_unix(str(fm_rv))\n                if reviewed_unix is None:\n                    continue\n                age_secs = now_unix - reviewed_unix\n                if age_secs > _STRANDED_REVIEWED_MAX_AGE_SECS:\n                    age_days = max(0, age_secs // 86400)\n                    results.append(\n                        StrandedPlan(\n                            plan_id=plan_id,\n                            mode=\"8.1\",\n                            age_days=int(age_days),\n                            status=status,\n                            file_path=file_path,\n                        )\n                    )\n                continue\n        except Exception:\n            # Per-plan fail-open: a corrupt plan must not block the walk.\n            continue\n\n    return results\n\n\ndef _stranded_breadcrumb(strandeds: List[StrandedPlan]) -> str:\n    \"\"\"Render a short, audit-friendly summary line for the systemMessage.\"\"\"\n    if not strandeds:\n        return \"\"\n    parts = []\n    for s in strandeds[:5]:  # cap output — breadcrumb only\n        parts.append(f\"{s.plan_id} (mode {s.mode}, {s.age_days}d)\")\n    suffix = \"\"\n    if len(strandeds) > 5:\n        suffix = f\" +{len(strandeds) - 5} more\"\n    return \"PLAN-LIFECYCLE-STRANDED: \" + \", \".join(parts) + suffix\n\n\ndef decide(\n    *,\n    file_path: str,\n    old_string: str,\n    new_string: str,\n    replace_all: bool,\n    read_current=_read_current_plan,\n) -> Decision:\n    \"\"\"Pure decision function — IO injected via read_current for testing.\"\"\"\n    # Scope guard: only run on plan files\n    if not _is_plan_file(file_path):\n        return Decision(allow=True)\n\n    # Read current file content\n    current = read_current(file_path)\n    if not current:\n        # File doesn't exist yet (creation via Edit is unusual; fail-open)\n        return Decision(allow=True)\n\n    # Compute post-edit content\n    new_content = _apply_edit(current, old_string, new_string, replace_all)\n    if new_content == current:\n        # Edit doesn't actually modify the file (or old_string not found)\n        return Decision(allow=True)\n\n    return _decide_on_buffers(current, new_content)\n\n\ndef _decide_on_buffers(old_content: str, new_content: str) -> Decision:\n    \"\"\"Common decision path once we have pre/post buffers.\n\n    Used by the Edit path (direct substitution), the Write path (full\n    replacement) and the MultiEdit path (sequential application).\n    \"\"\"\n    if new_content == old_content:\n        return Decision(allow=True)\n\n    old_fm = _fm.parse_frontmatter(old_content)\n    new_fm = _fm.parse_frontmatter(new_content)\n\n    old_status = str(old_fm.get(\"status\", \"\")).strip()\n    new_status = str(new_fm.get(\"status\", \"\")).strip()\n\n    # If status didn't change, nothing to check\n    if old_status == new_status:\n        return Decision(allow=True)\n\n    # Status changed — validate\n    reason = _check_transition(old_status, new_status)\n    if reason:\n        return Decision(allow=False, reason=reason)\n\n    reason = _check_required_fields(old_status, new_status, new_fm, new_content)\n    if reason:\n        return Decision(allow=False, reason=reason)\n\n    return Decision(allow=True)\n\n\ndef decide_write(\n    *,\n    file_path: str,\n    content: str,\n    read_current=_read_current_plan,\n) -> Decision:\n    \"\"\"Write-tool variant of decide().\n\n    PLAN-019 P1-SEC-E: `Write` has `content` instead of old/new strings.\n    We synthesize an Edit where old_string = <entire existing content>\n    (or empty for a new file) and new_string = <content>, then run the\n    same transition + required-field checks.\n\n    If the Write creates a brand-new plan file, `current` is empty. The\n    transition validation still runs: a new plan with `status: done` but\n    no `completed_at` is blocked just like `draft → done` via Edit.\n    \"\"\"\n    if not _is_plan_file(file_path):\n        return Decision(allow=True)\n\n    current = read_current(file_path) or \"\"\n    new_content = content or \"\"\n    if new_content == current:\n        return Decision(allow=True)\n\n    # For brand-new plan files (current == \"\"), old_status is empty and\n    # the transition validator treats any legal new status as OK (see\n    # _check_transition \"new plan\" branch). Required-field checks still\n    # fire, so a new plan written directly as done/without-completed_at\n    # blocks correctly.\n    return _decide_on_buffers(current, new_content)\n\n\ndef decide_multiedit(\n    *,\n    file_path: str,\n    edits: list,\n    read_current=_read_current_plan,\n) -> Decision:\n    \"\"\"MultiEdit-tool variant of decide().\n","numLines":420,"startLine":279,"totalLines":957}},"tool_result_meta":[{"id":"toolu_01Cxopw1MP89Gybgm63j4FPu","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
