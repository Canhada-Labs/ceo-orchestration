{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VrrA3JBD1H8jd9UstJUsgD","type":"tool_result","content":"150\t# is honoured without any project discovery (pair-rail r2 P2): the slug is\n151\t# only needed by the branch that builds the path from it.\n152\tif [ -n \"$DEST_OVERRIDE\" ]; then\n153\t  DEST=\"$DEST_OVERRIDE\"\n154\telif [ -n \"${CEO_AUDIT_LOG_DIR:-}\" ]; then\n155\t  DEST=\"$CEO_AUDIT_LOG_DIR\"\n156\telif [ -n \"${PROJECT_SLUG_OVERRIDE:-}${CEO_PROJECT_NAME:-}\" ]; then\n157\t  # An explicit operator slug names the destination directly under $HOME.\n158\t  PROJECT_SLUG=\"${PROJECT_SLUG_OVERRIDE:-$CEO_PROJECT_NAME}\"\n159\t  DEST=\"$HOME/.claude/projects/$PROJECT_SLUG\"\n160\telse\n161\t  DEST=\"$(_resolve_rp --state-dir)\" || exit 2\n162\tfi\n163\t[ -n \"$DEST\" ] || { echo \"fatal: empty destination\" >&2; exit 2; }\n164\t\n165\tlog \"ceo-restore: tarball=$TARBALL dest=$DEST mode=$([ \"$APPLY\" -eq 1 ] && echo APPLY || echo DRY-RUN)\"\n166\t\n167\t_physical_dest() {\n168\t  local raw=\"$1\" parent leaf\n169\t  case \"$raw\" in\n170\t    *//*|*/./*|*/../*|../*|.)\n171\t      echo \"fatal: refused destination spelling: $raw\" >&2; return 1 ;;\n172\t  esac\n173\t  parent=\"$(dirname \"$raw\")\"\n174\t  leaf=\"$(basename \"$raw\")\"\n175\t  if [ -e \"$raw\" ] || [ -L \"$raw\" ]; then\n176\t    [ -d \"$raw\" ] && [ ! -L \"$raw\" ] || {\n177\t      echo \"fatal: destination must be a real directory, not a link or file\" >&2; return 1;\n178\t    }\n179\t    (cd -P \"$raw\" && pwd)\n180\t    return 0\n181\t  fi\n182\t  [ -d \"$parent\" ] && [ ! -L \"$parent\" ] || {\n183\t    echo \"fatal: destination parent must be a real directory\" >&2; return 1;\n184\t  }\n185\t  printf '%s/%s\\n' \"$(cd -P \"$parent\" && pwd)\" \"$leaf\"\n186\t}\n187\t\n188\tARCHIVE_VALIDATOR=\"$(dirname \"${BASH_SOURCE[0]}\")/_restore_archive.py\"\n189\t[ -f \"$ARCHIVE_VALIDATOR\" ] || { echo \"fatal: archive validator missing\" >&2; exit 2; }\n190\tpython3 \"$ARCHIVE_VALIDATOR\" \"$TARBALL\" || exit 2\n191\tDEST=\"$(_physical_dest \"$DEST\")\" || exit 2\n192\t\n193\t# Resolve sha256 binary\n194\tSHA256_BIN=\"\"\n195\tif command -v sha256sum >/dev/null 2>&1; then\n196\t  SHA256_BIN=\"sha256sum\"\n197\telif command -v shasum >/dev/null 2>&1; then\n198\t  SHA256_BIN=\"shasum -a 256\"\n199\tfi\n200\t\n201\t# SHA verification\n202\tSHA_SIDE=\"$TARBALL.sha256\"\n203\tif [ -n \"$SHA256_BIN\" ] && [ -f \"$SHA_SIDE\" ]; then\n204\t  EXPECTED=\"$(cat \"$SHA_SIDE\" | awk '{print $1}')\"\n205\t  ACTUAL=\"$($SHA256_BIN \"$TARBALL\" | awk '{print $1}')\"\n206\t  if [ \"$EXPECTED\" != \"$ACTUAL\" ]; then\n207\t    echo \"fatal: SHA256 mismatch\" >&2\n208\t    echo \"  expected: $EXPECTED\" >&2\n209\t    echo \"  actual:   $ACTUAL\" >&2\n210\t    exit 2\n211\t  fi\n212\t  log \"sha256: verified ($ACTUAL)\"\n213\telse\n214\t  log \"warning: no .sha256 sidecar found; integrity not verified\"\n215\tfi\n216\t\n217\t# Validate the exact tree that both preview and apply describe.  This is before\n218\t# the dry-run return deliberately: preview must never bless an apply it rejects.\n219\tif [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] || [ \"$RESTORE_PLANS\" -eq 1 ]; then\n220\t  if [ -L \"$(pwd)/.claude\" ] || [ ! -d \"$(pwd)/.claude\" ]; then\n221\t    echo \"fatal: optional restore requires a real .claude directory in CWD\" >&2\n222\t    exit 2\n223\t  fi\n224\t  if [ \"$RESTORE_PLANS\" -eq 1 ] && [ -L \"$(pwd)/.claude/plans\" ]; then\n225\t    echo \"fatal: optional plans restore requires a real .claude/plans directory\" >&2\n226\t    exit 2\n227\t  fi\n228\tfi\n229\tSTAGE_DIR=\"$(mktemp -d -t ceo-restore-XXXXXX)\"\n230\ttrap 'rm -rf \"$STAGE_DIR\"' EXIT\n231\t# The validator writes ONLY the members it accepted (never `tar -x` of the\n232\t# whole archive): a skipped macOS AppleDouble member `._<name>` never lands\n233\t# on disk, in the preview or in the apply.\n234\tpython3 \"$ARCHIVE_VALIDATOR\" \"$TARBALL\" \"$STAGE_DIR\" || exit 2\n235\tif find \"$STAGE_DIR\" -type l -print -quit | grep -q .; then\n236\t  echo \"fatal: archive contains symbolic links\" >&2\n237\t  exit 2\n238\tfi\n239\t\n240\t# List contents (dry-run preview)\n241\tlog \"\"\n242\tlog \"tarball contents:\"\n243\tif [ \"$QUIET\" -eq 0 ]; then\n244\t  tar -tzf \"$TARBALL\" | sed -n '1,50{s/^/  /;p;}' >&2\n245\tfi\n246\t\n247\t_refuse_link_ancestors() {\n248\t  local path=\"$1\" stop=\"$2\"\n249\t  if [ -L \"$path\" ]; then\n250\t    echo \"fatal: restore target is a symbolic link: $path\" >&2\n251\t    return 2\n252\t  fi\n253\t  if [ -e \"$path\" ] && [ ! -f \"$path\" ]; then\n254\t    echo \"fatal: restore target must be a regular file: $path\" >&2\n255\t    return 2\n256\t  fi\n257\t  while [ \"$path\" != \"$stop\" ]; do\n258\t    if [ -L \"$path\" ]; then\n259\t      echo \"fatal: restore target is a symbolic link: $path\" >&2\n260\t      return 2\n261\t    fi\n262\t    path=\"$(dirname \"$path\")\"\n263\t  done\n264\t}\n265\t\n266\t_preflight_targets() {\n267\t  local f rel target\n268\t  if [ -d \"$STAGE_DIR/audit\" ]; then\n269\t    for f in \"$STAGE_DIR/audit\"/*; do\n270\t      [ -f \"$f\" ] || continue\n271\t      _refuse_link_ancestors \"$DEST/$(basename \"$f\")\" \"$DEST\" || return 2\n272\t    done\n273\t  fi\n274\t  if [ -d \"$STAGE_DIR/memory\" ]; then\n275\t    while IFS= read -r -d '' f; do\n276\t      rel=\"${f#\"$STAGE_DIR/memory/\"}\"\n277\t      target=\"$DEST/memory/$rel\"\n278\t      _refuse_link_ancestors \"$target\" \"$DEST\" || return 2\n279\t    done < <(find \"$STAGE_DIR/memory\" -type f -print0)\n280\t  fi\n281\t  if [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] && [ -f \"$STAGE_DIR/agent-metrics.md\" ]; then\n282\t    _refuse_link_ancestors \"$(pwd)/.claude/agent-metrics.md\" \"$(pwd)\" || return 2\n283\t  fi\n284\t  if [ \"$RESTORE_PLANS\" -eq 1 ] && [ -d \"$STAGE_DIR/plans\" ]; then\n285\t    while IFS= read -r -d '' f; do\n286\t      rel=\"${f#\"$STAGE_DIR/plans/\"}\"\n287\t      _refuse_link_ancestors \"$(pwd)/.claude/