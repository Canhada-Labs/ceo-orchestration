{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch79SGRR76GmscmeLX6V9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01DCqrcVFfHbpHksL5gS4c2q","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/paths_skills.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15561,"cache_read_input_tokens":179404,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15561},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"f2ba7ab1-c0a6-4ae1-9ac9-9be24fc2150d","timestamp":"2026-11-16T19:19:21.165Z","request_id":"req_011Ch79SGDWsp8srr6oovYAG","wire_tool_inputs":{"toolu_01DCqrcVFfHbpHksL5gS4c2q":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/paths_skills.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DCqrcVFfHbpHksL5gS4c2q","type":"tool_result","content":"1\t\"\"\"Path resolution and skill extraction declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef audit_paths() -> Dict[str, Path]:\n5\t    \"\"\"Resolve the audit log paths from env vars with sensible defaults.\"\"\"\n6\t    home = Path(os.environ.get(\"HOME\") or str(Path.home()))\n7\t    default_dir = _rp_state_dir()\n8\t\n9\t    audit_dir = Path(os.environ.get(\"CEO_AUDIT_LOG_DIR\") or str(default_dir))\n10\t    env_log = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n11\t    audit_log = Path(env_log) if env_log else audit_dir / \"audit-log.jsonl\"\n12\t    # PLAN-182 W1 rail r1 P1-2: family-follows-log — when the LOG moved via\n13\t    # CEO_AUDIT_LOG_PATH, lock + errors follow its resolved parent (same\n14\t    # derivation as audit_emit._log_family_dir / audit_hmac), never the\n15\t    # default dir. One log, one lock, for every writer.\n16\t    family_dir = Path(env_log).resolve().parent if env_log else audit_dir\n17\t    audit_err = Path(\n18\t        os.environ.get(\"CEO_AUDIT_LOG_ERR\") or str(family_dir / \"audit-log.errors\")\n19\t    )\n20\t    audit_lock = Path(\n21\t        os.environ.get(\"CEO_AUDIT_LOG_LOCK\")\n22\t        or str(family_dir / \"audit-log.lock\")\n23\t    )\n24\t    return {\n25\t        \"dir\": audit_dir,\n26\t        \"log\": audit_log,\n27\t        \"err\": audit_err,\n28\t        \"lock\": audit_lock,\n29\t    }\n30\t\n31\t\n32\tdef rotate_threshold() -> int:\n33\t    \"\"\"Rotation threshold in bytes, overridable via env for tests.\"\"\"\n34\t    raw = os.environ.get(\"CEO_AUDIT_LOG_ROTATE_BYTES\")\n35\t    if raw:\n36\t        try:\n37\t            return int(raw)\n38\t        except ValueError:\n39\t            pass\n40\t    return DEFAULT_ROTATE_AT_BYTES\n41\t\n42\t\n43\t# -----------------------------------------------------------------------------\n44\t# Field extraction\n45\t# -----------------------------------------------------------------------------\n46\t\n47\t\n48\tdef bucket_prompt_length(n: int) -> str:\n49\t    \"\"\"Bucket a prompt length into the fixed histogram buckets.\"\"\"\n50\t    if n < 256:\n51\t        return \"<256\"\n52\t    if n < 1024:\n53\t        return \"<1024\"\n54\t    if n < 4096:\n55\t        return \"<4096\"\n56\t    if n < 16384:\n57\t        return \"<16384\"\n58\t    if n < 65536:\n59\t        return \"<65536\"\n60\t    return \">=65536\"\n61\t\n62\t\n63\tdef _sanitize_prompt(prompt: str) -> Optional[str]:\n64\t    \"\"\"PLAN-065 Phase 1 / Sec MF-7 — NFKC normalize + NUL-strip + length cap.\n65\t\n66\t    Returns the safe text for regex scanning, or None if rejected. Never\n67\t    raises. Mirrors ``extract-skill.py._sanitize`` pre-regex hardening.\n68\t\n69\t    Rejections:\n70\t    - non-string inputs (defense-in-depth)\n71\t    - empty / whitespace-only\n72\t    - over ``_MAX_INPUT_CHARS`` code points or ``_MAX_INPUT_BYTES`` UTF-8\n73\t    - NUL byte present (post-NFKC)\n74\t    \"\"\"\n75\t    if not isinstance(prompt, str):\n76\t        return None\n77\t    if not prompt or not prompt.strip():\n78\t        return None\n79\t    if len(prompt) > _MAX_INPUT_CHARS:\n80\t        return None\n81\t    # NFKC normalize first — homoglyph defense (Cyrillic 'о' U+043E → 'o' folds\n82\t    # under NFKC so Cyrillic-only homoglyphs that LOOK like 'o' survive as\n83\t    # distinct code-points, then the validator's strict ASCII charset rejects).\n84\t    normalized = unicodedata.normalize(\"NFKC\", prompt)\n85\t    if \"\\x00\" in normalized:\n86\t        return None\n87\t    if len(normalized.encode(\"utf-8\", errors=\"replace\")) > _MAX_INPUT_BYTES:\n88\t        return None\n89\t    return normalized\n90\t\n91\t\n92\tdef _validate_skill_name(name: str) -> bool:\n93\t    \"\"\"Defense-in-depth: re-validate captured skill name post-extract.\n94\t\n95\t    Even though each path's regex already bounds the captured group, we\n96\t    re-validate here so a future grammar drift cannot smuggle a\n97\t    pathological name out via a regex edge case.\n98\t\n99\t    Path-traversal patterns are denied here: the captured-group grammars\n100\t    exclude ``/`` ``..`` ``\\\\`` already, but we add an explicit anchor.\n101\t    \"\"\"\n102\t    if not name or len(name) > _MAX_SKILL_NAME_CHARS:\n103\t        return False\n104\t    if \"/\" in name or \"..\" in name or \"\\\\\" in name:\n105\t        return False\n106\t    if not _SKILL_NAME_CHARSET_RE.match(name):\n107\t        return False\n108\t    return True\n109\t\n110\t\n111\tdef _path_d_lookup(subagent_type: str) -> str:\n112\t    \"\"\"PLAN-079 Path D — resolve subagent_type to canonical skill name.\n113\t\n114\t    Returns the mapped skill if subagent_type is one of the 5 canonical\n115\t    archetypes (``code-reviewer``, ``security-engineer``, ``qa-architect``,\n116\t    ``performance-engineer``, ``devops``); otherwise returns ``\"unknown\"``.\n117\t\n118\t    Normalization: ``strip().lower()`` is applied to mirror the\n119\t    archetype-routing precedent in ``check_agent_spawn.py:204``\n120\t    (``_extract_archetype_from_payload``). Case-fold is intentional —\n121\t    Agent-tool emitters may pass mixed case for the same archetype.\n122\t\n123\t    Defense-in-depth (Sec MF-7):\n124\t    - Non-string input rejected (``isinstance(subagent_type, str)``)\n125\t    - Raw input length capped at 80 chars BEFORE normalize to bound\n126\t      strip/lower allocation cost on the hot audit-hook path (Codex\n127\t      G23-04)\n128\t    - Post-normalize charset enforced via ``_ARCHETYPE_NAME_RE.fullmatch``\n129\t      (anchored both ends) — slash, dot-traversal, NUL, unicode rejected\n130\t\n131\t    Never raises.\n132\t    \"\"\"\n133\t    if not isinstance(subagent_type, str):\n134\t        return \"unknown\"\n135\t    # G23-04: bound raw length before allocating strip/lower copy.\n136\t    # 80 leaves headroom for whitespace + 64-char post-normalize cap.\n137\t    if len(subagent_type) > 80:\n138\t        return \"unknown\"\n139\t    name = subagent_type.strip().lower()\n140\t    if not _ARCHETYPE_NAME_RE.fullmatch(name):\n141\t        return \"unknown\"\n142\t    return _ARCHETYPE_TO_SKILL.get(name, \"unknown\")\n143\t\n144\t\n145\tdef extract_skill(prompt: str, subagent_type: str = \"\") -> str:\n146\t    \"\"\"Return the skill name extracted from a spawn prompt, or 'unknown'.\n147\t\n148\t    PLAN-065 Phase 1 — 3-path matrix; PLAN-079 — +Path D archetype map.\n149\t\n150\t    Order of precedence:\n151\t\n152\t      A. Format-A inline ``^SKILL: <name>$`` (line-anchored)\n153\t      B. Format-B reference\n154\t         ``^@.claude/skills/<scope>/<name>/SKILL.md sha256=<64hex>$``\n155\t      C. Format-C ``## SKILL CONTENT`` block + ``SKILL LOADED: <name>`` line\n156\t      D. Path D (PLAN-079) — ``subagent_type`` ∈ canonical-5 archetypes\n157\t         maps to the skill loaded via ``.claude/agents/<name>.md`` per\n158\t         ADR-051. Tail fallback only — never overrides an explicit\n159\t         Path A/B/C envelope.\n160\t\n161\t    Multi-format prompts: Path A wins (line-order preference per\n162\t    PLAN-065 spec). Path D fires only if Paths A/B/C miss AND\n163\t    ``subagent_type`` is provided + valid.\n164\t\n165\t    Path D edge case (Codex gate #23 hardened):\n166\t    - Fires on TRULY EMPTY ``prompt`` (legitimate empty-body case)\n167\t    - Does NOT fire on ``_sanitize_prompt``-rejected prompt (G23-03)\n168\t      — rejected prompts may have contained a conflicting `SKILL:`\n169\t      envelope we failed to parse; preserving \"unknown\" surfaces the\n170\t      rejection signal in forensic logs\n171\t    - Does NOT fire on non-string ``prompt`` (G23-09) — None, False,\n172\t      0, list, dict all return \"unknown\" before reaching Path D\n173\t\n174\t    Sanitization (Sec MF-7) runs once before any path regex on the\n175\t    prompt. The ``subagent_type`` input is independently validated\n176\t    against ``_ARCHETYPE_NAME_RE`` inside ``_path_d_lookup`` (post-\n177\t    `strip().lower()` normalize, with raw-length pre-bound). Never\n178\t    raises — returns ``\"unknown\"`` on any rejection.\n179\t\n180\t    The legacy single-arg signature (``str -> str``) remains supported\n181\t    via the default ``subagent_type=\"\"`` arg — pre-PLAN-079 callers\n182\t    continue to work unchanged.\n183\t\n184\t    Path D firing rules (Codex gate #23 hardened):\n185\t\n186\t    | prompt              | subagent_type    | result                  |\n187\t    |---------------------|------------------|-------------------------|\n188\t    | non-string          | any              | \"unknown\" (G23-09)      |\n189\t    | \"\" (empty)          | canonical-5      | mapped skill (Path D)   |\n190\t    | \"\" (empty)          | other / \"\"       | \"unknown\"               |\n191\t    | str, sanitize=None  | any              | \"unknown\" (G23-03)      |\n192\t    | str, Path A match   | any              | Path A name (precedence)|\n193\t    | str, Path B match   | any              | Path B name (precedence)|\n194\t    | str, Path C match   | any              | Path C name (precedence)|\n195\t    | str, A/B/C miss     | canonical-5      | mapped skill (Path D)   |\n196\t    | str, A/B/C miss     | other / \"\"       | \"unknown\"               |\n197\t    \"\"\"\n198\t    # Codex G23-09: type-check prompt BEFORE the falsy-short-circuit\n199\t    # so non-string prompts (None, False, 0, [], {}) don't silently fall\n200\t    # through to Path D fallback via the `if not prompt` branch.\n201\t    if not isinstance(prompt, str):\n202\t        return \"unknown\"\n203\t    if not prompt:\n204\t        # Empty prompt is a legitimate case (archetype dispatch with no\n205\t        # user-visible body). Path D may resolve from subagent_type alone.\n206\t        if subagent_type:\n207\t            return _path_d_lookup(subagent_type)\n208\t        return \"unknown\"\n209\t    safe = _sanitize_prompt(prompt)\n210\t    if safe is None:\n211\t        # Codex G23-03: prompt was REJECTED by Sec MF-7 hardening\n212\t        # (oversize, NUL byte, whitespace-only). Do NOT fall back to\n213\t        # Path D — the rejected prompt may have contained a different\n214\t        # SKILL envelope we failed to parse. Returning the mapped\n215\t        # archetype skill here would silently override a conflicting\n216\t        # (but malformed) explicit claim. Returning \"unknown\" preserves\n217\t        # the rejection signal so downstream forensics see the parse\n218\t        # failure, not a synthesized skill identity.\n219\t        return \"unknown\"\n220\t\n221\t    # Path A — Format-A inline (precedence wins on multi-format).\n222\t    m = _SKILL_PATH_A_RE.search(safe)\n223\t    if m:\n224\t        name = m.group(1)\n225\t        if _validate_skill_name(name):\n226\t            return name\n227\t\n228\t    # Path B — Format-B reference.\n229\t    m = _SKILL_PATH_B_RE.search(safe)\n230\t    if m:\n231\t        name = m.group(1)\n232\t        if _validate_skill_name(name):\n233\t            return name\n234\t\n235\t    # Path C — `## SKILL CONTENT` block fallback (legacy).\n236\t    if _SKILL_PATH_C_HEADER_RE.search(safe):\n237\t        m = _SKILL_PATH_C_LOADED_RE.search(safe)\n238\t        if m:\n239\t            name = m.group(1)\n240\t            if _validate_skill_name(name):\n241\t                return name\n242\t\n243\t    # Path D — PLAN-079 canonical archetype → skill mapping (last resort).\n244\t    if subagent_type:\n245\t        return _path_d_lookup(subagent_type)\n246\t\n247\t    return \"unknown\"\n248\t\n249\t\n250\tdef has_profile(prompt: str) -> bool:\n251\t    \"\"\"True if the spawn prompt contains an `## AGENT PROFILE` section (spawn discipline marker).\"\"\"\n252\t    if not prompt:\n253\t        return False\n254\t    return bool(_PROFILE_RE.search(prompt))\n255\t\n256\t\n257\tdef has_file_assignment(prompt: str) -> bool:\n258\t    \"\"\"True if the spawn prompt contains a `## FILE ASSIGNMENT` section (anti-collision marker).\"\"\"\n259\t    if not prompt:\n260\t        return False\n261\t    return bool(_FILE_ASSIGNMENT_RE.search(prompt))\n262\t\n263\t\n264\tdef now_iso_utc() -> str:\n265\t    \"\"\"ISO 8601 UTC timestamp with second precision (e.g. 2026-04-11T13:15:47Z).\"\"\"\n266\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n267\t\n268\t\n269\tdef now_month_slug() -> str:\n270\t    \"\"\"YYYY-MM for the current UTC month — used for rotated filenames.\"\"\"\n271\t    return datetime.now(timezone.utc).strftime(\"%Y-%m\")\n272\t\n273\t\n274\t# -----------------------------------------------------------------------------\n275\t# Entry builder\n276\t# -----------------------------------------------------------------------------\n277\t\n278\t\n279\t"}]},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"ea475db9-4d55-49ea-9b09-4fc9d0e57671","timestamp":"2026-11-16T19:19:21.182Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/paths_skills.py","content":"\"\"\"Path resolution and skill extraction declarations.\"\"\"\nfrom __future__ import annotations\n\ndef audit_paths() -> Dict[str, Path]:\n    \"\"\"Resolve the audit log paths from env vars with sensible defaults.\"\"\"\n    home = Path(os.environ.get(\"HOME\") or str(Path.home()))\n    default_dir = _rp_state_dir()\n\n    audit_dir = Path(os.environ.get(\"CEO_AUDIT_LOG_DIR\") or str(default_dir))\n    env_log = os.environ.get(\"CEO_AUDIT_LOG_PATH\")\n    audit_log = Path(env_log) if env_log else audit_dir / \"audit-log.jsonl\"\n    # PLAN-182 W1 rail r1 P1-2: family-follows-log — when the LOG moved via\n    # CEO_AUDIT_LOG_PATH, lock + errors follow its resolved parent (same\n    # derivation as audit_emit._log_family_dir / audit_hmac), never the\n    # default dir. One log, one lock, for every writer.\n    family_dir = Path(env_log).resolve().parent if env_log else audit_dir\n    audit_err = Path(\n        os.environ.get(\"CEO_AUDIT_LOG_ERR\") or str(family_dir / \"audit-log.errors\")\n    )\n    audit_lock = Path(\n        os.environ.get(\"CEO_AUDIT_LOG_LOCK\")\n        or str(family_dir / \"audit-log.lock\")\n    )\n    return {\n        \"dir\": audit_dir,\n        \"log\": audit_log,\n        \"err\": audit_err,\n        \"lock\": audit_lock,\n    }\n\n\ndef rotate_threshold() -> int:\n    \"\"\"Rotation threshold in bytes, overridable via env for tests.\"\"\"\n    raw = os.environ.get(\"CEO_AUDIT_LOG_ROTATE_BYTES\")\n    if raw:\n        try:\n            return int(raw)\n        except ValueError:\n            pass\n    return DEFAULT_ROTATE_AT_BYTES\n\n\n# -----------------------------------------------------------------------------\n# Field extraction\n# -----------------------------------------------------------------------------\n\n\ndef bucket_prompt_length(n: int) -> str:\n    \"\"\"Bucket a prompt length into the fixed histogram buckets.\"\"\"\n    if n < 256:\n        return \"<256\"\n    if n < 1024:\n        return \"<1024\"\n    if n < 4096:\n        return \"<4096\"\n    if n < 16384:\n        return \"<16384\"\n    if n < 65536:\n        return \"<65536\"\n    return \">=65536\"\n\n\ndef _sanitize_prompt(prompt: str) -> Optional[str]:\n    \"\"\"PLAN-065 Phase 1 / Sec MF-7 — NFKC normalize + NUL-strip + length cap.\n\n    Returns the safe text for regex scanning, or None if rejected. Never\n    raises. Mirrors ``extract-skill.py._sanitize`` pre-regex hardening.\n\n    Rejections:\n    - non-string inputs (defense-in-depth)\n    - empty / whitespace-only\n    - over ``_MAX_INPUT_CHARS`` code points or ``_MAX_INPUT_BYTES`` UTF-8\n    - NUL byte present (post-NFKC)\n    \"\"\"\n    if not isinstance(prompt, str):\n        return None\n    if not prompt or not prompt.strip():\n        return None\n    if len(prompt) > _MAX_INPUT_CHARS:\n        return None\n    # NFKC normalize first — homoglyph defense (Cyrillic 'о' U+043E → 'o' folds\n    # under NFKC so Cyrillic-only homoglyphs that LOOK like 'o' survive as\n    # distinct code-points, then the validator's strict ASCII charset rejects).\n    normalized = unicodedata.normalize(\"NFKC\", prompt)\n    if \"\\x00\" in normalized:\n        return None\n    if len(normalized.encode(\"utf-8\", errors=\"replace\")) > _MAX_INPUT_BYTES:\n        return None\n    return normalized\n\n\ndef _validate_skill_name(name: str) -> bool:\n    \"\"\"Defense-in-depth: re-validate captured skill name post-extract.\n\n    Even though each path's regex already bounds the captured group, we\n    re-validate here so a future grammar drift cannot smuggle a\n    pathological name out via a regex edge case.\n\n    Path-traversal patterns are denied here: the captured-group grammars\n    exclude ``/`` ``..`` ``\\\\`` already, but we add an explicit anchor.\n    \"\"\"\n    if not name or len(name) > _MAX_SKILL_NAME_CHARS:\n        return False\n    if \"/\" in name or \"..\" in name or \"\\\\\" in name:\n        return False\n    if not _SKILL_NAME_CHARSET_RE.match(name):\n        return False\n    return True\n\n\ndef _path_d_lookup(subagent_type: str) -> str:\n    \"\"\"PLAN-079 Path D — resolve subagent_type to canonical skill name.\n\n    Returns the mapped skill if subagent_type is one of the 5 canonical\n    archetypes (``code-reviewer``, ``security-engineer``, ``qa-architect``,\n    ``performance-engineer``, ``devops``); otherwise returns ``\"unknown\"``.\n\n    Normalization: ``strip().lower()`` is applied to mirror the\n    archetype-routing precedent in ``check_agent_spawn.py:204``\n    (``_extract_archetype_from_payload``). Case-fold is intentional —\n    Agent-tool emitters may pass mixed case for the same archetype.\n\n    Defense-in-depth (Sec MF-7):\n    - Non-string input rejected (``isinstance(subagent_type, str)``)\n    - Raw input length capped at 80 chars BEFORE normalize to bound\n      strip/lower allocation cost on the hot audit-hook path (Codex\n      G23-04)\n    - Post-normalize charset enforced via ``_ARCHETYPE_NAME_RE.fullmatch``\n      (anchored both ends) — slash, dot-traversal, NUL, unicode rejected\n\n    Never raises.\n    \"\"\"\n    if not isinstance(subagent_type, str):\n        return \"unknown\"\n    # G23-04: bound raw length before allocating strip/lower copy.\n    # 80 leaves headroom for whitespace + 64-char post-normalize cap.\n    if len(subagent_type) > 80:\n        return \"unknown\"\n    name = subagent_type.strip().lower()\n    if not _ARCHETYPE_NAME_RE.fullmatch(name):\n        return \"unknown\"\n    return _ARCHETYPE_TO_SKILL.get(name, \"unknown\")\n\n\ndef extract_skill(prompt: str, subagent_type: str = \"\") -> str:\n    \"\"\"Return the skill name extracted from a spawn prompt, or 'unknown'.\n\n    PLAN-065 Phase 1 — 3-path matrix; PLAN-079 — +Path D archetype map.\n\n    Order of precedence:\n\n      A. Format-A inline ``^SKILL: <name>$`` (line-anchored)\n      B. Format-B reference\n         ``^@.claude/skills/<scope>/<name>/SKILL.md sha256=<64hex>$``\n      C. Format-C ``## SKILL CONTENT`` block + ``SKILL LOADED: <name>`` line\n      D. Path D (PLAN-079) — ``subagent_type`` ∈ canonical-5 archetypes\n         maps to the skill loaded via ``.claude/agents/<name>.md`` per\n         ADR-051. Tail fallback only — never overrides an explicit\n         Path A/B/C envelope.\n\n    Multi-format prompts: Path A wins (line-order preference per\n    PLAN-065 spec). Path D fires only if Paths A/B/C miss AND\n    ``subagent_type`` is provided + valid.\n\n    Path D edge case (Codex gate #23 hardened):\n    - Fires on TRULY EMPTY ``prompt`` (legitimate empty-body case)\n    - Does NOT fire on ``_sanitize_prompt``-rejected prompt (G23-03)\n      — rejected prompts may have contained a conflicting `SKILL:`\n      envelope we failed to parse; preserving \"unknown\" surfaces the\n      rejection signal in forensic logs\n    - Does NOT fire on non-string ``prompt`` (G23-09) — None, False,\n      0, list, dict all return \"unknown\" before reaching Path D\n\n    Sanitization (Sec MF-7) runs once before any path regex on the\n    prompt. The ``subagent_type`` input is independently validated\n    against ``_ARCHETYPE_NAME_RE`` inside ``_path_d_lookup`` (post-\n    `strip().lower()` normalize, with raw-length pre-bound). Never\n    raises — returns ``\"unknown\"`` on any rejection.\n\n    The legacy single-arg signature (``str -> str``) remains supported\n    via the default ``subagent_type=\"\"`` arg — pre-PLAN-079 callers\n    continue to work unchanged.\n\n    Path D firing rules (Codex gate #23 hardened):\n\n    | prompt              | subagent_type    | result                  |\n    |---------------------|------------------|-------------------------|\n    | non-string          | any              | \"unknown\" (G23-09)      |\n    | \"\" (empty)          | canonical-5      | mapped skill (Path D)   |\n    | \"\" (empty)          | other / \"\"       | \"unknown\"               |\n    | str, sanitize=None  | any              | \"unknown\" (G23-03)      |\n    | str, Path A match   | any              | Path A name (precedence)|\n    | str, Path B match   | any              | Path B name (precedence)|\n    | str, Path C match   | any              | Path C name (precedence)|\n    | str, A/B/C miss     | canonical-5      | mapped skill (Path D)   |\n    | str, A/B/C miss     | other / \"\"       | \"unknown\"               |\n    \"\"\"\n    # Codex G23-09: type-check prompt BEFORE the falsy-short-circuit\n    # so non-string prompts (None, False, 0, [], {}) don't silently fall\n    # through to Path D fallback via the `if not prompt` branch.\n    if not isinstance(prompt, str):\n        return \"unknown\"\n    if not prompt:\n        # Empty prompt is a legitimate case (archetype dispatch with no\n        # user-visible body). Path D may resolve from subagent_type alone.\n        if subagent_type:\n            return _path_d_lookup(subagent_type)\n        return \"unknown\"\n    safe = _sanitize_prompt(prompt)\n    if safe is None:\n        # Codex G23-03: prompt was REJECTED by Sec MF-7 hardening\n        # (oversize, NUL byte, whitespace-only). Do NOT fall back to\n        # Path D — the rejected prompt may have contained a different\n        # SKILL envelope we failed to parse. Returning the mapped\n        # archetype skill here would silently override a conflicting\n        # (but malformed) explicit claim. Returning \"unknown\" preserves\n        # the rejection signal so downstream forensics see the parse\n        # failure, not a synthesized skill identity.\n        return \"unknown\"\n\n    # Path A — Format-A inline (precedence wins on multi-format).\n    m = _SKILL_PATH_A_RE.search(safe)\n    if m:\n        name = m.group(1)\n        if _validate_skill_name(name):\n            return name\n\n    # Path B — Format-B reference.\n    m = _SKILL_PATH_B_RE.search(safe)\n    if m:\n        name = m.group(1)\n        if _validate_skill_name(name):\n            return name\n\n    # Path C — `## SKILL CONTENT` block fallback (legacy).\n    if _SKILL_PATH_C_HEADER_RE.search(safe):\n        m = _SKILL_PATH_C_LOADED_RE.search(safe)\n        if m:\n            name = m.group(1)\n            if _validate_skill_name(name):\n                return name\n\n    # Path D — PLAN-079 canonical archetype → skill mapping (last resort).\n    if subagent_type:\n        return _path_d_lookup(subagent_type)\n\n    return \"unknown\"\n\n\ndef has_profile(prompt: str) -> bool:\n    \"\"\"True if the spawn prompt contains an `## AGENT PROFILE` section (spawn discipline marker).\"\"\"\n    if not prompt:\n        return False\n    return bool(_PROFILE_RE.search(prompt))\n\n\ndef has_file_assignment(prompt: str) -> bool:\n    \"\"\"True if the spawn prompt contains a `## FILE ASSIGNMENT` section (anti-collision marker).\"\"\"\n    if not prompt:\n        return False\n    return bool(_FILE_ASSIGNMENT_RE.search(prompt))\n\n\ndef now_iso_utc() -> str:\n    \"\"\"ISO 8601 UTC timestamp with second precision (e.g. 2026-04-11T13:15:47Z).\"\"\"\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef now_month_slug() -> str:\n    \"\"\"YYYY-MM for the current UTC month — used for rotated filenames.\"\"\"\n    return datetime.now(timezone.utc).strftime(\"%Y-%m\")\n\n\n# -----------------------------------------------------------------------------\n# Entry builder\n# -----------------------------------------------------------------------------\n\n\n","numLines":279,"startLine":1,"totalLines":279}},"tool_result_meta":[{"id":"toolu_01DCqrcVFfHbpHksL5gS4c2q","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch79SGRR76GmscmeLX6V9","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01JrnnFJNpn4sdh7MTirAKUQ","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/entries_usage.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":15561,"cache_read_input_tokens":179404,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":15561},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"e38e7233-91d5-4e9f-9912-50abd1d21ed3","timestamp":"2026-11-16T19:19:23.011Z","request_id":"req_011Ch79SGDWsp8srr6oovYAG","wire_tool_inputs":{"toolu_01JrnnFJNpn4sdh7MTirAKUQ":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/entries_usage.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JrnnFJNpn4sdh7MTirAKUQ","type":"tool_result","content":"1\t\"\"\"Audit-entry construction and usage metadata declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef build_entry(\n5\t    *,\n6\t    event: \"_contract.NormalizedEvent | _payload.HookPayload\",\n7\t    project_dir: str,\n8\t    hook_duration_ms: int,\n9\t) -> Optional[Dict[str, Any]]:\n10\t    \"\"\"Construct a JSONL row from a NormalizedEvent (or legacy HookPayload).\n11\t\n12\t    Accepts either type for backward compatibility with older tests.\n13\t    Returns None if the event indicates a non-Agent tool (defensive — the\n14\t    matcher should already filter to Agent).\n15\t    \"\"\"\n16\t    tool_name = getattr(event, \"tool_name\", \"\")\n17\t    if tool_name and tool_name not in (\"Agent\", \"unknown\"):\n18\t        return None\n19\t\n20\t    description = getattr(event, \"description\", \"\") or \"\"\n21\t    prompt = getattr(event, \"prompt\", \"\") or \"\"\n22\t    session_id = getattr(event, \"session_id\", \"\") or \"\"\n23\t    subagent_type = getattr(event, \"subagent_type\", \"\") or \"\"\n24\t    tool_response = getattr(event, \"tool_response\", {}) or {}\n25\t\n26\t    desc_preview = _redact.redact_secrets(description)\n27\t    desc_hash = _redact.hash_description(description)\n28\t    # PLAN-079: pass subagent_type for Path D archetype-mapping fallback.\n29\t    skill = extract_skill(prompt, subagent_type)\n30\t\n31\t    # PLAN-006 Phase 5b (ADR-016): extract token counts from tool_response.\n32\t    # Always emit the keys (even if None) so consumers can distinguish\n33\t    # \"post-ADR-016 emitter with unknown shape\" from \"pre-ADR-016 emitter\".\n34\t    tin, tout = _tokens.extract_tokens(tool_response)\n35\t    ttotal = _tokens.total_tokens(tool_response)\n36\t\n37\t    # PLAN-020 Phase 0 item 1: capture Anthropic usage_metadata for cache\n38\t    # coverage analysis. Additive v2.7 fields. Null-safe for emitters that\n39\t    # don't provide usage_metadata (legacy + non-Anthropic adapters).\n40\t    usage_metadata = _extract_usage_metadata(tool_response)\n41\t    # PLAN-118 WS-E (S181): the derived ratio is a FLOAT, which\n42\t    # ``canonical_json.encode()`` forbids in HMAC-covered payloads\n43\t    # (``CanonicalJsonError`` → fail-open ``hmac:null`` → chain one-way-rule\n44\t    # break → whole-chain ``tamper``). Encode as integer basis-points\n45\t    # (ratio × 10000, clamped 0..10000) BEFORE it reaches the entry dict.\n46\t    # Mirrors the S164 ``hit_rate`` → ``hit_rate_bps`` class fix; closes the\n47\t    # last live float-in-HMAC leak (the agent_spawn observer path that the\n48\t    # S164 emit_* introspection guard never covered).\n49\t    cache_coverage = _compute_cache_coverage(usage_metadata)\n50\t    cache_coverage_bps = (\n51\t        max(0, min(10000, int(round(cache_coverage * 10000))))\n52\t        if cache_coverage is not None\n53\t        else None\n54\t    )\n55\t\n56\t    # PLAN-020 Phase 1: dual-rail discriminator. Detect from prompt\n57\t    # structure (## SKILL REFERENCE = native rail; ## SKILL CONTENT =\n58\t    # custom inline rail) OR from subagent_type matching canonical-5.\n59\t    rail = _detect_rail(prompt, subagent_type)\n60\t\n61\t    # PLAN-021 ADR-052: model discriminator. Captured from Anthropic\n62\t    # API response when present. Null-safe for non-Anthropic adapters.\n63\t    # PLAN-044 audit-v2 C3-P0-01 (Wave B): fall back to ADR-052\n64\t    # role-to-model policy when tool_response.model is null (default\n65\t    # behavior of Task tool response shape at v1.11.0).\n66\t    model = _extract_model(tool_response, subagent_type=subagent_type)\n67\t\n68\t    # PLAN-044 audit-v2 C3-P0-08 (Wave B): archetype + dispatch_mode\n69\t    # fields. Audit-telemetry.py per-archetype rollups depend on these\n70\t    # being non-null. ADR-082 per-archetype dispatch claim was undone\n71\t    # at v1.11.0 because no emitter wrote them. Wave B closes the gap.\n72\t    archetype = subagent_type if (\n73\t        isinstance(subagent_type, str) and subagent_type\n74\t    ) else None\n75\t    dispatch_mode = _resolve_dispatch_mode(subagent_type or \"\", rail)\n76\t\n77\t    # PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2): capture dispatch_archetype_hint\n78\t    # from the IN-PROMPT marker emitted by inject-agent-context.sh:\n79\t    #   `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n80\t    # The marker propagates cross-process via the recorded `prompt` payload —\n81\t    # env vars do NOT survive the inject-agent-context.sh subprocess → Agent\n82\t    # tool dispatch → audit hook subprocess chain (Codex iter 2 finding).\n83\t    #\n84\t    # Validated via the same NFKC + ≤64 char + charset `^[a-z][a-z0-9-]*$` +\n85\t    # control/JSON-meta rejection contract as `_lib.audit_emit._validate_dispatch_archetype_hint`.\n86\t    # On rejection (or marker absent): returns None (fail-open). The field is\n87\t    # always emitted in the audit row — null when no hint is set/validated,\n88\t    # validated string otherwise.\n89\t    dispatch_archetype_hint = _extract_dispatch_archetype_hint(prompt)\n90\t\n91\t    entry: Dict[str, Any] = {\n92\t        \"ts\": now_iso_utc(),\n93\t        \"action\": \"agent_spawn\",\n94\t        \"session_id\": session_id,\n95\t        \"project\": project_dir,\n96\t        \"tool\": tool_name or \"Agent\",\n97\t        \"subagent_type\": subagent_type,\n98\t        \"desc_preview\": desc_preview,\n99\t        \"desc_hash\": desc_hash,\n100\t        \"skill\": skill,\n101\t        \"has_profile\": has_profile(prompt),\n102\t        \"has_file_assignment\": has_file_assignment(prompt),\n103\t        \"prompt_len_bucket\": bucket_prompt_length(len(prompt)),\n104\t        \"response_kind\": _payload.response_kind(tool_response),\n105\t        \"hook_duration_ms\": int(hook_duration_ms),\n106\t        # Tokens (ADR-016): optional nullable, always-present.\n107\t        \"tokens_in\": tin,\n108\t        \"tokens_out\": tout,\n109\t        \"tokens_total\": ttotal,\n110\t        # PLAN-020 v2.7 additions (ADDITIVE — older consumers ignore).\n111\t        \"usage_metadata\": usage_metadata,\n112\t        # PLAN-118 WS-E (S181): integer basis-points (ratio × 10000) — the\n113\t        # legacy float ``cache_coverage`` field is REMOVED (it caused\n114\t        # CanonicalJsonError + fail-open hmac:null on every real spawn).\n115\t        \"cache_coverage_bps\": cache_coverage_bps,\n116\t        \"rail\": rail,\n117\t        # PLAN-021 v2.8 addition (ADDITIVE — ADR-052 multi-model).\n118\t        \"model\": model,\n119\t        # PLAN-044 audit-v2 v2.14 additions (Wave B C3-P0-08).\n120\t        \"archetype\": archetype,\n121\t        \"dispatch_mode\": dispatch_mode,\n122\t        # PLAN-080 Phase 1 v2.24 addition (M2-C3 + M2-CDX-1) —\n123\t        # dispatch_archetype_hint captured pre-ADR-082-mitigation.\n124\t        # Validated via _lib.audit_emit redaction contract.\n125\t        # Always-present (null when env unset or validation rejected).\n126\t        \"dispatch_archetype_hint\": dispatch_archetype_hint,\n127\t    }\n128\t    return entry\n129\t\n130\t\n131\t# -----------------------------------------------------------------------------\n132\t# PLAN-020 v2.7 cache-header capture helpers (Phase 0 item 1)\n133\t# -----------------------------------------------------------------------------\n134\t\n135\t# Canonical-5 archetypes that ship with native subagent files (ADR-050).\n136\t# Rail discrimination: archetype is \"native\" IFF its name matches AND\n137\t# subagent_type is non-empty. Else \"custom\" if classic spawn signal is\n138\t# present. Else null (legacy / unknown).\n139\t_CANONICAL_5 = frozenset({\n140\t    \"code-reviewer\",\n141\t    \"security-engineer\",\n142\t    \"qa-architect\",\n143\t    \"performance-engineer\",\n144\t    \"devops\",\n145\t})\n146\t\n147\t# Native rail spawn-prompt sentinel (additive ADR-051; co-exists with\n148\t# the legacy \"## SKILL CONTENT\" inline sentinel).\n149\t_SKILL_REFERENCE_RE = re.compile(\n150\t    r\"^##\\s+SKILL\\s+REFERENCE\\s*$\", re.MULTILINE\n151\t)\n152\t_SKILL_CONTENT_RE = re.compile(\n153\t    r\"^##\\s+SKILL\\s+CONTENT\\s*$\", re.MULTILINE\n154\t)\n155\t\n156\t\n157\tdef _extract_usage_metadata(tool_response: Any) -> Optional[Dict[str, Any]]:\n158\t    \"\"\"Extract Anthropic usage_metadata from a tool_response payload.\n159\t\n160\t    Returns a dict with `cache_creation_input_tokens`,\n161\t    `cache_read_input_tokens`, `uncached_input_tokens`, `output_tokens`,\n162\t    `thinking_tokens` — each int or None. Returns None if the payload\n163\t    has no `usage_metadata` field at all (legacy / non-Anthropic).\n164\t\n165\t    Defensive: never raises; returns None on any unexpected shape.\n166\t    \"\"\"\n167\t    if not isinstance(tool_response, dict):\n168\t        return None\n169\t    usage = tool_response.get(\"usage_metadata\")\n170\t    if not isinstance(usage, dict):\n171\t        # Some emitters may put it under \"usage\" or in nested response.\n172\t        usage = tool_response.get(\"usage\")\n173\t        if not isinstance(usage, dict):\n174\t            return None\n175\t\n176\t    def _coerce_int(value: Any) -> Optional[int]:\n177\t        if isinstance(value, bool):\n178\t            return None\n179\t        if isinstance(value, int):\n180\t            return value\n181\t        if isinstance(value, str) and value.isdigit():\n182\t            return int(value)\n183\t        return None\n184\t\n185\t    return {\n186\t        \"cache_creation_input_tokens\": _coerce_int(\n187\t            usage.get(\"cache_creation_input_tokens\")\n188\t        ),\n189\t        \"cache_read_input_tokens\": _coerce_int(\n190\t            usage.get(\"cache_read_input_tokens\")\n191\t        ),\n192\t        \"uncached_input_tokens\": _coerce_int(usage.get(\"uncached_input_tokens\")),\n193\t        \"output_tokens\": _coerce_int(usage.get(\"output_tokens\")),\n194\t        \"thinking_tokens\": _coerce_int(usage.get(\"thinking_tokens\")),\n195\t    }\n196\t\n197\t\n198\tdef _compute_cache_coverage(\n199\t    usage_metadata: Optional[Dict[str, Any]],\n200\t) -> Optional[float]:\n201\t    \"\"\"Derived metric: cache_read / (cache_read + cache_creation + uncached).\n202\t\n203\t    Returns None if the inputs are missing or the denominator is zero\n204\t    (defensive against synthetic / mocked payloads).\n205\t    \"\"\"\n206\t    if not usage_metadata:\n207\t        return None\n208\t    cache_read = usage_metadata.get(\"cache_read_input_tokens\") or 0\n209\t    cache_creation = usage_metadata.get(\"cache_creation_input_tokens\") or 0\n210\t    uncached = usage_metadata.get(\"uncached_input_tokens\") or 0\n211\t    denom = cache_read + cache_creation + uncached\n212\t    if denom <= 0:\n213\t        return None\n214\t    return round(cache_read / denom, 4)\n215\t\n216\t\n217\t# PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — in-prompt hint marker pattern.\n218\t# inject-agent-context.sh emits this marker once near the top of every spawn\n219\t# prompt; audit_log.py extracts the slug at PostToolUse audit time. The\n220\t# regex captures the slug into group 1 and validates the charset inline.\n221\t_DISPATCH_HINT_MARKER_RE = re.compile(\n222\t    r\"<!--\\s*ceo-dispatch-archetype-hint:\\s*([a-z][a-z0-9-]{0,63})\\s*-->\",\n223\t    re.IGNORECASE,\n224\t)\n225\t\n226\t\n227\tdef _extract_dispatch_archetype_hint(prompt: str) -> Optional[str]:\n228\t    \"\"\"PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — extract validated hint.\n229\t\n230\t    Searches `prompt` for the in-prompt marker:\n231\t      `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n232\t\n233\t    Falls back to `CEO_DISPATCH_ARCHETYPE_HINT` env var ONLY if the marker\n234\t    is absent (advisory path; env vars do not reliably propagate across the\n235\t    /spawn subprocess → Agent tool dispatch → audit hook subprocess chain\n236\t    per Codex Phase 1 iter 2 finding).\n237\t\n238\t    Validation contract (mirrors `_lib.audit_emit._validate_dispatch_archetype_hint`):\n239\t      1. NFKC normalize\n240\t      2. Length ≤ 64 chars post-NFKC\n241\t      3. Charset `^[a-z][a-z0-9-]*$` (lowercase prefix; hyphens + digits)\n242\t      4. Reject control bytes (0x00-0x1f, 0x7f-0x9f), null, JSON-meta `{}[]:\",\\\\`\n243\t\n244\t    On rejection: return None (fail-open per audit hook contract; never blocks).\n245\t    On marker absent + env unset: return None.\n246\t    On accept: return normalized lowercase slug.\n247\t    \"\"\"\n248\t    raw: Optional[str] = None\n249\t    # Primary path: in-prompt marker\n250\t    if isinstance(prompt, str) and prompt:\n251\t        m = _DISPATCH_HINT_MARKER_RE.search(prompt)\n252\t        if m:\n253\t            raw = m.group(1)\n254\t    # Fallback path: env var (advisory; may be set by future direct callers)\n255\t    if not raw:\n256\t        raw = os.environ.get(\"CEO_DISPATCH_ARCHETYPE_HINT\")\n257\t    if not raw:\n258\t        return None\n259\t    # Defensive try/except — must NEVER throw under fail-open contract.\n260\t    try:\n261\t        # NFKC normalize then lowercase (regex was case-insensitive)\n262\t        norm = unicodedata.normalize(\"NFKC\", raw).lower()\n263\t        # Length cap (post-NFKC)\n264\t        if len(norm) > 64 or len(norm) == 0:\n265\t            return None\n266\t        # Charset: ^[a-z][a-z0-9-]*$\n267\t        if not re.match(r\"^[a-z][a-z0-9-]*$\", norm):\n268\t            return None\n269\t        # Defensive: reject if any control byte slipped through\n270\t        if any(ord(c) < 0x20 or 0x7f <= ord(c) <= 0x9f for c in norm):\n271\t            return None\n272\t        # Defensive: JSON-meta chars\n273\t        if any(c in '{}[]:,\"\\\\' for c in norm):\n274\t            return None\n275\t        return norm\n276\t    except Exception:  # pragma: no cover (defensive — extraction never throws)\n277\t        return None\n278\t\n279\t\n280\tdef _extract_model(\n281\t    tool_response: Any,\n282\t    subagent_type: Optional[str] = None,\n283\t) -> Optional[str]:\n284\t    \"\"\"PLAN-021 ADR-052: extract Claude model ID from tool_response.\n285\t\n286\t    Anthropic API responses include a `model` field (e.g. \"claude-fable-5\",\n287\t    \"claude-opus-5\", \"claude-haiku-4-5\"; older gens appear in replay). Some adapters nest\n288\t    it under `response.model` or `content.model`. Returns the string if\n289\t    found, else falls back to ADR-052 role-to-model policy table when\n290\t    `subagent_type` is supplied; otherwise None.\n291\t\n292\t    Canonical IDs (PLAN-169 W2.10 D1 — current fleet; the table below is\n293\t    the authority, this prose only illustrates):\n294\t      - claude-fable-5 / claude-opus-5 → orchestrator + critical VETOs\n295\t      - claude-sonnet-5                → mid-complexity workers\n296\t      - claude-haiku-4-5               → high-frequency fan-out\n297\t\n298\t    PLAN-044 audit-v2 C3-P0-01 fix (Wave B): the Task tool response\n299\t    shape from Claude Code's hook payload omits the `model` field on\n300\t    100% of agent_spawn events (verified at audit time: 199/199 events\n301\t    had `model: null`). Without an authoritative observation, the\n302\t    fallback uses the ADR-052 policy table — adopters reading the\n303\t    audit-log get a *policy-derived* model identity, not an\n304\t    *observation-derived* one. The two diverge only when an adopter\n305\t    overrides ADR-052 (then the audit-log over-reports the policy\n306\t    model rather than the actual model — known limitation; downstream\n307\t    cost reports re-resolve via subagent_type when present).\n308\t    \"\"\"\n309\t    if isinstance(tool_response, dict):\n310\t        # Direct top-level (most Anthropic SDK shapes)\n311\t        model = tool_response.get(\"model\")\n312\t        if isinstance(model, str) and model:\n313\t            return model\n314\t        # Nested under \"response\" (some adapter shapes)\n315\t        resp = tool_response.get(\"response\")\n316\t        if isinstance(resp, dict):\n317\t            m = resp.get(\"model\")\n318\t            if isinstance(m, str) and m:\n319\t                return m\n320\t        # Nested under \"usage_metadata\" sibling-content\n321\t        usage = tool_response.get(\"usage_metadata\")\n322\t        if isinstance(usage, dict):\n323\t            m = usage.get(\"model\")\n324\t            if isinstance(m, str) and m:\n325\t                return m\n326\t\n327\t    # Wave B fallback — ADR-052 role-to-model policy table.\n328\t    if isinstance(subagent_type, str) and subagent_type:\n329\t        policy_model = _ADR_052_ROLE_TO_MODEL.get(subagent_type)\n330\t        if policy_model:\n331\t            return policy_model\n332\t    return None\n333\t\n334\t\n335\t# PLAN-044 audit-v2 C3-P0-01 — ADR-052 §Role-to-model distribution table.\n336\t# Used as fallback when tool_response.model is null (which happens on 100%\n337\t# of Task-dispatched spawns at v1.11.0). Pinned to canonical IDs from\n338\t# ADR-052; if an adopter overrides ADR-052 they should also override\n339\t# this table OR pre-populate tool_response.model upstream.\n340\t# PLAN-163 T1.4 (ADR-181, OQ1=b + OQ2=migrate-now): ROUTING refresh only —\n341\t# Opus-tier fallbacks move claude-opus-4-8 -> claude-opus-5 and the advisory\n342\t# (Sonnet) tier moves claude-sonnet-4-6 -> claude-sonnet-5. This table is a\n343\t# routing-policy fallback, NOT a pricing surface (grok F11): historical\n344\t# pricing/replay tables keep the old ids. Every value MUST stay inside the\n345\t# ADR-149 AVAILABLE_MODELS_WORKING_SET (tied by\n346\t# test_adr149_validator_parity.py).\n347\t_ADR_052_ROLE_TO_MODEL: Dict[str, str] = {\n348\t    # Canonical-5 VETO archetypes — Opus floor per ADR-052 + ADR-080\n349\t    \"code-reviewer\": \"claude-opus-5\",\n350\t    \"security-engineer\": \"claude-opus-5\",\n351\t    \"qa-architect\": \"claude-sonnet-5\",\n352\t    \"performance-engineer\": \"claude-sonnet-5\",\n353\t    # PLAN-169 W2.10 F8: bare id — the dated pin is not in availableModels\n354\t    # and interacts badly with enforceAvailableModels.\n355\t    \"devops\": \"claude-haiku-4-5\",\n356\t    # Mitigated rail — general-purpose dispatch inherits CEO model.\n357\t    # Default-CEO is Opus-tier unless CEO_MODEL_DOWNSHIFT is honored.\n358\t    # ADR-149 Amendment 3 (S357): follows the session-default pin, now\n359\t    # claude-opus-5-5. A POLICY value, not an observation: when the Task\n360\t    # response carries no model (the common case, see _extract_model) the\n361\t    # audit log records this row even if a per-call model or alias served\n362\t    # the spawn.\n363\t    \"general-purpose\": \"claude-opus-5-5\",\n364\t    # Probe / specialty archetypes\n365\t    \"growth-engineer\": \"claude-sonnet-5\",\n366\t    \"billing-engineer\": \"claude-sonnet-5\",\n367\t    \"compliance-specialist\": \"claude-sonnet-5\",\n368\t    \"chaos-engineer\": \"claude-sonnet-5\",\n369\t    \"data-engineer\": \"claude-sonnet-5\",\n370\t    \"real-time-systems-engineer\": \"claude-sonnet-5\",\n371\t    \"refactoring-lead\": \"claude-sonnet-5\",\n372\t    \"vp-engineering\": \"claude-opus-5\",\n373\t    \"vp-product\": \"claude-sonnet-5\",\n374\t    \"vp-operations\": \"claude-sonnet-5\",\n375\t    # PLAN-074 Wave 1c provenance — see docs/PLAN-086-adr-052-role-extension.md\n376\t    # 4 VETO-floor archetypes added per PLAN-086 Wave B (R-019 ROLE_TO_MODEL ext).\n377\t    # ADR-052 §Veto-floor expansion (lines 186-210) names these as VETO-floor;\n378\t    # llm-finops-architect carries Opus floor for cost-ceiling integrity (see\n379\t    # docs §2 §Why llm-finops-architect). ADR-052 bytes NOT mutated (anti-churn).\n380\t    \"incident-commander\": \"claude-opus-5\",\n381\t    \"identity-trust-architect\": \"claude-opus-5\",\n382\t    \"threat-detection-engineer\": \"claude-opus-5\",\n383\t    \"llm-finops-architect\": \"claude-opus-5\",\n384\t}\n385\t\n386\t\n387\tdef _resolve_dispatch_mode(\n388\t    subagent_type: str,\n389\t    rail: Optional[str],\n390\t) -> Optional[str]:\n391\t    \"\"\"PLAN-044 audit-v2 C3-P0-08 — Wave B: derive dispatch_mode field.\n392\t\n393\t    Maps (subagent_type, rail) → \"native\" | \"mitigated\" per the\n394\t    PLAN-061 / ADR-082 dispatch policy:\n395\t\n396\t      - canonical-5 native rail → \"native\" (full tool grant per\n397\t        ADR-052 floor; H4 anomaly does NOT apply because empirically\n398\t        only `code-reviewer` is reliable; PLAN-061 default-on routes\n399\t        the other 4 via mitigated).\n400\t      - any non-canonical archetype → \"mitigated\" (general-purpose\n401\t        with persona injected via `## SKILL CONTENT`).\n402\t      - rail=None or unknown → None (legacy / pre-PLAN-061).\n403\t\n404\t    See ADR-082 §Routing decision and `inject-agent-context.sh` for\n405\t    the live override matrix (CEO_DISPATCHER_MODE,\n406\t    CEO_MITIGATION_DISABLE).\n407\t    \"\"\"\n408\t    if not isinstance(subagent_type, str):\n409\t        return None\n410\t    # Canonical-5 native rail — only code-reviewer routes natively\n411\t    # by default per PLAN-061 / ADR-082. Other 4 are mitigated.\n412\t    if subagent_type == \"code-reviewer\" and rail == \"native\":\n413\t        return \"native\"\n414\t    if subagent_type in _CANONICAL_5 and rail == \"custom\":\n415\t        # Older inline ## SKILL CONTENT prompt — pre-PLAN-061 spawn.\n416\t        return \"native_legacy\"\n417\t    if rail is None:\n418\t        return None\n419\t    # Default mitigated rail for non-canonical-5 + non-cr canonicals\n420\t    # under PLAN-061 default-on.\n421\t    return \"mitigated\"\n422\t\n423\t\n424\tdef _detect_rail(prompt: str, subagent_type: str) -> Optional[str]:\n425\t    \"\"\"Detect spawn dispatch rail (native vs custom) from prompt + subagent.\n426\t\n427\t    Heuristic order:\n428\t    1. If subagent_type matches a canonical-5 archetype name AND the\n429\t       prompt has `## SKILL REFERENCE` sentinel → \"native\".\n430\t    2. Else if prompt has `## SKILL CONTENT` (legacy inline) → \"custom\".\n431\t    3. Else if prompt has `## SKILL REFERENCE` only → \"native\"\n432\t       (subagent_type may be empty for some adapters).\n433\t    4. Else None (unknown / pre-PLAN-020 / non-spawn event).\n434\t    \"\"\"\n435\t    if not isinstance(prompt, str):\n436\t        return None\n437\t    has_reference = bool(_SKILL_REFERENCE_RE.search(prompt))\n438\t    has_content = bool(_SKILL_CONTENT_RE.search(prompt))\n439\t    is_canonical = (\n440\t        isinstance(subagent_type, str) and subagent_type in _CANONICAL_5\n441\t    )\n442\t\n443\t    if is_canonical and has_reference:\n444\t        return \"native\"\n445\t    if has_content:\n446\t        return \"custom\"\n447\t    if has_reference:\n448\t        return \"native\"\n449\t    return None\n450\t\n451\t\n452\t# -----------------------------------------------------------------------------\n453\t# Rotation\n454\t# -----------------------------------------------------------------------------\n455\t\n456\t\n457\t"}]},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"7f619984-5893-4f43-a268-78f6e947950b","timestamp":"2026-11-16T19:19:23.027Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/entries_usage.py","content":"\"\"\"Audit-entry construction and usage metadata declarations.\"\"\"\nfrom __future__ import annotations\n\ndef build_entry(\n    *,\n    event: \"_contract.NormalizedEvent | _payload.HookPayload\",\n    project_dir: str,\n    hook_duration_ms: int,\n) -> Optional[Dict[str, Any]]:\n    \"\"\"Construct a JSONL row from a NormalizedEvent (or legacy HookPayload).\n\n    Accepts either type for backward compatibility with older tests.\n    Returns None if the event indicates a non-Agent tool (defensive — the\n    matcher should already filter to Agent).\n    \"\"\"\n    tool_name = getattr(event, \"tool_name\", \"\")\n    if tool_name and tool_name not in (\"Agent\", \"unknown\"):\n        return None\n\n    description = getattr(event, \"description\", \"\") or \"\"\n    prompt = getattr(event, \"prompt\", \"\") or \"\"\n    session_id = getattr(event, \"session_id\", \"\") or \"\"\n    subagent_type = getattr(event, \"subagent_type\", \"\") or \"\"\n    tool_response = getattr(event, \"tool_response\", {}) or {}\n\n    desc_preview = _redact.redact_secrets(description)\n    desc_hash = _redact.hash_description(description)\n    # PLAN-079: pass subagent_type for Path D archetype-mapping fallback.\n    skill = extract_skill(prompt, subagent_type)\n\n    # PLAN-006 Phase 5b (ADR-016): extract token counts from tool_response.\n    # Always emit the keys (even if None) so consumers can distinguish\n    # \"post-ADR-016 emitter with unknown shape\" from \"pre-ADR-016 emitter\".\n    tin, tout = _tokens.extract_tokens(tool_response)\n    ttotal = _tokens.total_tokens(tool_response)\n\n    # PLAN-020 Phase 0 item 1: capture Anthropic usage_metadata for cache\n    # coverage analysis. Additive v2.7 fields. Null-safe for emitters that\n    # don't provide usage_metadata (legacy + non-Anthropic adapters).\n    usage_metadata = _extract_usage_metadata(tool_response)\n    # PLAN-118 WS-E (S181): the derived ratio is a FLOAT, which\n    # ``canonical_json.encode()`` forbids in HMAC-covered payloads\n    # (``CanonicalJsonError`` → fail-open ``hmac:null`` → chain one-way-rule\n    # break → whole-chain ``tamper``). Encode as integer basis-points\n    # (ratio × 10000, clamped 0..10000) BEFORE it reaches the entry dict.\n    # Mirrors the S164 ``hit_rate`` → ``hit_rate_bps`` class fix; closes the\n    # last live float-in-HMAC leak (the agent_spawn observer path that the\n    # S164 emit_* introspection guard never covered).\n    cache_coverage = _compute_cache_coverage(usage_metadata)\n    cache_coverage_bps = (\n        max(0, min(10000, int(round(cache_coverage * 10000))))\n        if cache_coverage is not None\n        else None\n    )\n\n    # PLAN-020 Phase 1: dual-rail discriminator. Detect from prompt\n    # structure (## SKILL REFERENCE = native rail; ## SKILL CONTENT =\n    # custom inline rail) OR from subagent_type matching canonical-5.\n    rail = _detect_rail(prompt, subagent_type)\n\n    # PLAN-021 ADR-052: model discriminator. Captured from Anthropic\n    # API response when present. Null-safe for non-Anthropic adapters.\n    # PLAN-044 audit-v2 C3-P0-01 (Wave B): fall back to ADR-052\n    # role-to-model policy when tool_response.model is null (default\n    # behavior of Task tool response shape at v1.11.0).\n    model = _extract_model(tool_response, subagent_type=subagent_type)\n\n    # PLAN-044 audit-v2 C3-P0-08 (Wave B): archetype + dispatch_mode\n    # fields. Audit-telemetry.py per-archetype rollups depend on these\n    # being non-null. ADR-082 per-archetype dispatch claim was undone\n    # at v1.11.0 because no emitter wrote them. Wave B closes the gap.\n    archetype = subagent_type if (\n        isinstance(subagent_type, str) and subagent_type\n    ) else None\n    dispatch_mode = _resolve_dispatch_mode(subagent_type or \"\", rail)\n\n    # PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2): capture dispatch_archetype_hint\n    # from the IN-PROMPT marker emitted by inject-agent-context.sh:\n    #   `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n    # The marker propagates cross-process via the recorded `prompt` payload —\n    # env vars do NOT survive the inject-agent-context.sh subprocess → Agent\n    # tool dispatch → audit hook subprocess chain (Codex iter 2 finding).\n    #\n    # Validated via the same NFKC + ≤64 char + charset `^[a-z][a-z0-9-]*$` +\n    # control/JSON-meta rejection contract as `_lib.audit_emit._validate_dispatch_archetype_hint`.\n    # On rejection (or marker absent): returns None (fail-open). The field is\n    # always emitted in the audit row — null when no hint is set/validated,\n    # validated string otherwise.\n    dispatch_archetype_hint = _extract_dispatch_archetype_hint(prompt)\n\n    entry: Dict[str, Any] = {\n        \"ts\": now_iso_utc(),\n        \"action\": \"agent_spawn\",\n        \"session_id\": session_id,\n        \"project\": project_dir,\n        \"tool\": tool_name or \"Agent\",\n        \"subagent_type\": subagent_type,\n        \"desc_preview\": desc_preview,\n        \"desc_hash\": desc_hash,\n        \"skill\": skill,\n        \"has_profile\": has_profile(prompt),\n        \"has_file_assignment\": has_file_assignment(prompt),\n        \"prompt_len_bucket\": bucket_prompt_length(len(prompt)),\n        \"response_kind\": _payload.response_kind(tool_response),\n        \"hook_duration_ms\": int(hook_duration_ms),\n        # Tokens (ADR-016): optional nullable, always-present.\n        \"tokens_in\": tin,\n        \"tokens_out\": tout,\n        \"tokens_total\": ttotal,\n        # PLAN-020 v2.7 additions (ADDITIVE — older consumers ignore).\n        \"usage_metadata\": usage_metadata,\n        # PLAN-118 WS-E (S181): integer basis-points (ratio × 10000) — the\n        # legacy float ``cache_coverage`` field is REMOVED (it caused\n        # CanonicalJsonError + fail-open hmac:null on every real spawn).\n        \"cache_coverage_bps\": cache_coverage_bps,\n        \"rail\": rail,\n        # PLAN-021 v2.8 addition (ADDITIVE — ADR-052 multi-model).\n        \"model\": model,\n        # PLAN-044 audit-v2 v2.14 additions (Wave B C3-P0-08).\n        \"archetype\": archetype,\n        \"dispatch_mode\": dispatch_mode,\n        # PLAN-080 Phase 1 v2.24 addition (M2-C3 + M2-CDX-1) —\n        # dispatch_archetype_hint captured pre-ADR-082-mitigation.\n        # Validated via _lib.audit_emit redaction contract.\n        # Always-present (null when env unset or validation rejected).\n        \"dispatch_archetype_hint\": dispatch_archetype_hint,\n    }\n    return entry\n\n\n# -----------------------------------------------------------------------------\n# PLAN-020 v2.7 cache-header capture helpers (Phase 0 item 1)\n# -----------------------------------------------------------------------------\n\n# Canonical-5 archetypes that ship with native subagent files (ADR-050).\n# Rail discrimination: archetype is \"native\" IFF its name matches AND\n# subagent_type is non-empty. Else \"custom\" if classic spawn signal is\n# present. Else null (legacy / unknown).\n_CANONICAL_5 = frozenset({\n    \"code-reviewer\",\n    \"security-engineer\",\n    \"qa-architect\",\n    \"performance-engineer\",\n    \"devops\",\n})\n\n# Native rail spawn-prompt sentinel (additive ADR-051; co-exists with\n# the legacy \"## SKILL CONTENT\" inline sentinel).\n_SKILL_REFERENCE_RE = re.compile(\n    r\"^##\\s+SKILL\\s+REFERENCE\\s*$\", re.MULTILINE\n)\n_SKILL_CONTENT_RE = re.compile(\n    r\"^##\\s+SKILL\\s+CONTENT\\s*$\", re.MULTILINE\n)\n\n\ndef _extract_usage_metadata(tool_response: Any) -> Optional[Dict[str, Any]]:\n    \"\"\"Extract Anthropic usage_metadata from a tool_response payload.\n\n    Returns a dict with `cache_creation_input_tokens`,\n    `cache_read_input_tokens`, `uncached_input_tokens`, `output_tokens`,\n    `thinking_tokens` — each int or None. Returns None if the payload\n    has no `usage_metadata` field at all (legacy / non-Anthropic).\n\n    Defensive: never raises; returns None on any unexpected shape.\n    \"\"\"\n    if not isinstance(tool_response, dict):\n        return None\n    usage = tool_response.get(\"usage_metadata\")\n    if not isinstance(usage, dict):\n        # Some emitters may put it under \"usage\" or in nested response.\n        usage = tool_response.get(\"usage\")\n        if not isinstance(usage, dict):\n            return None\n\n    def _coerce_int(value: Any) -> Optional[int]:\n        if isinstance(value, bool):\n            return None\n        if isinstance(value, int):\n            return value\n        if isinstance(value, str) and value.isdigit():\n            return int(value)\n        return None\n\n    return {\n        \"cache_creation_input_tokens\": _coerce_int(\n            usage.get(\"cache_creation_input_tokens\")\n        ),\n        \"cache_read_input_tokens\": _coerce_int(\n            usage.get(\"cache_read_input_tokens\")\n        ),\n        \"uncached_input_tokens\": _coerce_int(usage.get(\"uncached_input_tokens\")),\n        \"output_tokens\": _coerce_int(usage.get(\"output_tokens\")),\n        \"thinking_tokens\": _coerce_int(usage.get(\"thinking_tokens\")),\n    }\n\n\ndef _compute_cache_coverage(\n    usage_metadata: Optional[Dict[str, Any]],\n) -> Optional[float]:\n    \"\"\"Derived metric: cache_read / (cache_read + cache_creation + uncached).\n\n    Returns None if the inputs are missing or the denominator is zero\n    (defensive against synthetic / mocked payloads).\n    \"\"\"\n    if not usage_metadata:\n        return None\n    cache_read = usage_metadata.get(\"cache_read_input_tokens\") or 0\n    cache_creation = usage_metadata.get(\"cache_creation_input_tokens\") or 0\n    uncached = usage_metadata.get(\"uncached_input_tokens\") or 0\n    denom = cache_read + cache_creation + uncached\n    if denom <= 0:\n        return None\n    return round(cache_read / denom, 4)\n\n\n# PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — in-prompt hint marker pattern.\n# inject-agent-context.sh emits this marker once near the top of every spawn\n# prompt; audit_log.py extracts the slug at PostToolUse audit time. The\n# regex captures the slug into group 1 and validates the charset inline.\n_DISPATCH_HINT_MARKER_RE = re.compile(\n    r\"<!--\\s*ceo-dispatch-archetype-hint:\\s*([a-z][a-z0-9-]{0,63})\\s*-->\",\n    re.IGNORECASE,\n)\n\n\ndef _extract_dispatch_archetype_hint(prompt: str) -> Optional[str]:\n    \"\"\"PLAN-080 Phase 1 (M2-C3 + M2-CDX-1 iter 2) — extract validated hint.\n\n    Searches `prompt` for the in-prompt marker:\n      `<!-- ceo-dispatch-archetype-hint: <slug> -->`\n\n    Falls back to `CEO_DISPATCH_ARCHETYPE_HINT` env var ONLY if the marker\n    is absent (advisory path; env vars do not reliably propagate across the\n    /spawn subprocess → Agent tool dispatch → audit hook subprocess chain\n    per Codex Phase 1 iter 2 finding).\n\n    Validation contract (mirrors `_lib.audit_emit._validate_dispatch_archetype_hint`):\n      1. NFKC normalize\n      2. Length ≤ 64 chars post-NFKC\n      3. Charset `^[a-z][a-z0-9-]*$` (lowercase prefix; hyphens + digits)\n      4. Reject control bytes (0x00-0x1f, 0x7f-0x9f), null, JSON-meta `{}[]:\",\\\\`\n\n    On rejection: return None (fail-open per audit hook contract; never blocks).\n    On marker absent + env unset: return None.\n    On accept: return normalized lowercase slug.\n    \"\"\"\n    raw: Optional[str] = None\n    # Primary path: in-prompt marker\n    if isinstance(prompt, str) and prompt:\n        m = _DISPATCH_HINT_MARKER_RE.search(prompt)\n        if m:\n            raw = m.group(1)\n    # Fallback path: env var (advisory; may be set by future direct callers)\n    if not raw:\n        raw = os.environ.get(\"CEO_DISPATCH_ARCHETYPE_HINT\")\n    if not raw:\n        return None\n    # Defensive try/except — must NEVER throw under fail-open contract.\n    try:\n        # NFKC normalize then lowercase (regex was case-insensitive)\n        norm = unicodedata.normalize(\"NFKC\", raw).lower()\n        # Length cap (post-NFKC)\n        if len(norm) > 64 or len(norm) == 0:\n            return None\n        # Charset: ^[a-z][a-z0-9-]*$\n        if not re.match(r\"^[a-z][a-z0-9-]*$\", norm):\n            return None\n        # Defensive: reject if any control byte slipped through\n        if any(ord(c) < 0x20 or 0x7f <= ord(c) <= 0x9f for c in norm):\n            return None\n        # Defensive: JSON-meta chars\n        if any(c in '{}[]:,\"\\\\' for c in norm):\n            return None\n        return norm\n    except Exception:  # pragma: no cover (defensive — extraction never throws)\n        return None\n\n\ndef _extract_model(\n    tool_response: Any,\n    subagent_type: Optional[str] = None,\n) -> Optional[str]:\n    \"\"\"PLAN-021 ADR-052: extract Claude model ID from tool_response.\n\n    Anthropic API responses include a `model` field (e.g. \"claude-fable-5\",\n    \"claude-opus-5\", \"claude-haiku-4-5\"; older gens appear in replay). Some adapters nest\n    it under `response.model` or `content.model`. Returns the string if\n    found, else falls back to ADR-052 role-to-model policy table when\n    `subagent_type` is supplied; otherwise None.\n\n    Canonical IDs (PLAN-169 W2.10 D1 — current fleet; the table below is\n    the authority, this prose only illustrates):\n      - claude-fable-5 / claude-opus-5 → orchestrator + critical VETOs\n      - claude-sonnet-5                → mid-complexity workers\n      - claude-haiku-4-5               → high-frequency fan-out\n\n    PLAN-044 audit-v2 C3-P0-01 fix (Wave B): the Task tool response\n    shape from Claude Code's hook payload omits the `model` field on\n    100% of agent_spawn events (verified at audit time: 199/199 events\n    had `model: null`). Without an authoritative observation, the\n    fallback uses the ADR-052 policy table — adopters reading the\n    audit-log get a *policy-derived* model identity, not an\n    *observation-derived* one. The two diverge only when an adopter\n    overrides ADR-052 (then the audit-log over-reports the policy\n    model rather than the actual model — known limitation; downstream\n    cost reports re-resolve via subagent_type when present).\n    \"\"\"\n    if isinstance(tool_response, dict):\n        # Direct top-level (most Anthropic SDK shapes)\n        model = tool_response.get(\"model\")\n        if isinstance(model, str) and model:\n            return model\n        # Nested under \"response\" (some adapter shapes)\n        resp = tool_response.get(\"response\")\n        if isinstance(resp, dict):\n            m = resp.get(\"model\")\n            if isinstance(m, str) and m:\n                return m\n        # Nested under \"usage_metadata\" sibling-content\n        usage = tool_response.get(\"usage_metadata\")\n        if isinstance(usage, dict):\n            m = usage.get(\"model\")\n            if isinstance(m, str) and m:\n                return m\n\n    # Wave B fallback — ADR-052 role-to-model policy table.\n    if isinstance(subagent_type, str) and subagent_type:\n        policy_model = _ADR_052_ROLE_TO_MODEL.get(subagent_type)\n        if policy_model:\n            return policy_model\n    return None\n\n\n# PLAN-044 audit-v2 C3-P0-01 — ADR-052 §Role-to-model distribution table.\n# Used as fallback when tool_response.model is null (which happens on 100%\n# of Task-dispatched spawns at v1.11.0). Pinned to canonical IDs from\n# ADR-052; if an adopter overrides ADR-052 they should also override\n# this table OR pre-populate tool_response.model upstream.\n# PLAN-163 T1.4 (ADR-181, OQ1=b + OQ2=migrate-now): ROUTING refresh only —\n# Opus-tier fallbacks move claude-opus-4-8 -> claude-opus-5 and the advisory\n# (Sonnet) tier moves claude-sonnet-4-6 -> claude-sonnet-5. This table is a\n# routing-policy fallback, NOT a pricing surface (grok F11): historical\n# pricing/replay tables keep the old ids. Every value MUST stay inside the\n# ADR-149 AVAILABLE_MODELS_WORKING_SET (tied by\n# test_adr149_validator_parity.py).\n_ADR_052_ROLE_TO_MODEL: Dict[str, str] = {\n    # Canonical-5 VETO archetypes — Opus floor per ADR-052 + ADR-080\n    \"code-reviewer\": \"claude-opus-5\",\n    \"security-engineer\": \"claude-opus-5\",\n    \"qa-architect\": \"claude-sonnet-5\",\n    \"performance-engineer\": \"claude-sonnet-5\",\n    # PLAN-169 W2.10 F8: bare id — the dated pin is not in availableModels\n    # and interacts badly with enforceAvailableModels.\n    \"devops\": \"claude-haiku-4-5\",\n    # Mitigated rail — general-purpose dispatch inherits CEO model.\n    # Default-CEO is Opus-tier unless CEO_MODEL_DOWNSHIFT is honored.\n    # ADR-149 Amendment 3 (S357): follows the session-default pin, now\n    # claude-opus-5-5. A POLICY value, not an observation: when the Task\n    # response carries no model (the common case, see _extract_model) the\n    # audit log records this row even if a per-call model or alias served\n    # the spawn.\n    \"general-purpose\": \"claude-opus-5-5\",\n    # Probe / specialty archetypes\n    \"growth-engineer\": \"claude-sonnet-5\",\n    \"billing-engineer\": \"claude-sonnet-5\",\n    \"compliance-specialist\": \"claude-sonnet-5\",\n    \"chaos-engineer\": \"claude-sonnet-5\",\n    \"data-engineer\": \"claude-sonnet-5\",\n    \"real-time-systems-engineer\": \"claude-sonnet-5\",\n    \"refactoring-lead\": \"claude-sonnet-5\",\n    \"vp-engineering\": \"claude-opus-5\",\n    \"vp-product\": \"claude-sonnet-5\",\n    \"vp-operations\": \"claude-sonnet-5\",\n    # PLAN-074 Wave 1c provenance — see docs/PLAN-086-adr-052-role-extension.md\n    # 4 VETO-floor archetypes added per PLAN-086 Wave B (R-019 ROLE_TO_MODEL ext).\n    # ADR-052 §Veto-floor expansion (lines 186-210) names these as VETO-floor;\n    # llm-finops-architect carries Opus floor for cost-ceiling integrity (see\n    # docs §2 §Why llm-finops-architect). ADR-052 bytes NOT mutated (anti-churn).\n    \"incident-commander\": \"claude-opus-5\",\n    \"identity-trust-architect\": \"claude-opus-5\",\n    \"threat-detection-engineer\": \"claude-opus-5\",\n    \"llm-finops-architect\": \"claude-opus-5\",\n}\n\n\ndef _resolve_dispatch_mode(\n    subagent_type: str,\n    rail: Optional[str],\n) -> Optional[str]:\n    \"\"\"PLAN-044 audit-v2 C3-P0-08 — Wave B: derive dispatch_mode field.\n\n    Maps (subagent_type, rail) → \"native\" | \"mitigated\" per the\n    PLAN-061 / ADR-082 dispatch policy:\n\n      - canonical-5 native rail → \"native\" (full tool grant per\n        ADR-052 floor; H4 anomaly does NOT apply because empirically\n        only `code-reviewer` is reliable; PLAN-061 default-on routes\n        the other 4 via mitigated).\n      - any non-canonical archetype → \"mitigated\" (general-purpose\n        with persona injected via `## SKILL CONTENT`).\n      - rail=None or unknown → None (legacy / pre-PLAN-061).\n\n    See ADR-082 §Routing decision and `inject-agent-context.sh` for\n    the live override matrix (CEO_DISPATCHER_MODE,\n    CEO_MITIGATION_DISABLE).\n    \"\"\"\n    if not isinstance(subagent_type, str):\n        return None\n    # Canonical-5 native rail — only code-reviewer routes natively\n    # by default per PLAN-061 / ADR-082. Other 4 are mitigated.\n    if subagent_type == \"code-reviewer\" and rail == \"native\":\n        return \"native\"\n    if subagent_type in _CANONICAL_5 and rail == \"custom\":\n        # Older inline ## SKILL CONTENT prompt — pre-PLAN-061 spawn.\n        return \"native_legacy\"\n    if rail is None:\n        return None\n    # Default mitigated rail for non-canonical-5 + non-cr canonicals\n    # under PLAN-061 default-on.\n    return \"mitigated\"\n\n\ndef _detect_rail(prompt: str, subagent_type: str) -> Optional[str]:\n    \"\"\"Detect spawn dispatch rail (native vs custom) from prompt + subagent.\n\n    Heuristic order:\n    1. If subagent_type matches a canonical-5 archetype name AND the\n       prompt has `## SKILL REFERENCE` sentinel → \"native\".\n    2. Else if prompt has `## SKILL CONTENT` (legacy inline) → \"custom\".\n    3. Else if prompt has `## SKILL REFERENCE` only → \"native\"\n       (subagent_type may be empty for some adapters).\n    4. Else None (unknown / pre-PLAN-020 / non-spawn event).\n    \"\"\"\n    if not isinstance(prompt, str):\n        return None\n    has_reference = bool(_SKILL_REFERENCE_RE.search(prompt))\n    has_content = bool(_SKILL_CONTENT_RE.search(prompt))\n    is_canonical = (\n        isinstance(subagent_type, str) and subagent_type in _CANONICAL_5\n    )\n\n    if is_canonical and has_reference:\n        return \"native\"\n    if has_content:\n        return \"custom\"\n    if has_reference:\n        return \"native\"\n    return None\n\n\n# -----------------------------------------------------------------------------\n# Rotation\n# -----------------------------------------------------------------------------\n\n\n","numLines":457,"startLine":1,"totalLines":457}},"tool_result_meta":[{"id":"toolu_01JrnnFJNpn4sdh7MTirAKUQ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
