{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015EcdSQGV6MAQxy5JiKJhzk","type":"tool_result","content":"1480\t# PLAN-120-FOLLOWUP WS-D (E4-F1/E4-F2) — install _lib/ SELECTIVELY. A flat\n1481\t# `install_one .claude/hooks/_lib` does cp -R (or a whole-tree symlink),\n1482\t# which drags the framework's OWN test harness into the adopter runtime:\n1483\t# _lib/tests/ (emits real audit events with no session redirect — no\n1484\t# conftest ships) + test_isolation.py / testing.py (both `import pytest`\n1485\t# at module top). We iterate the top-level _lib entries and skip exactly\n1486\t# those three names; everything else (all runtime *.py + the runtime\n1487\t# subdirs adapters/ estimation/ federation/ mcp/ otel/ tier_policy/ +\n1488\t# __init__.py) ships. New runtime modules are picked up automatically by\n1489\t# the glob, matching the install_scripts_selective convention.\n1490\t# PLAN-161 U2 (codex r1 F7): prune nested __pycache__/ dirs + *.pyc files\n1491\t# under a freshly-copied destination directory. The exclusion predicate above\n1492\t# screens only TOP-LEVEL _lib entries; a permitted SUBDIRECTORY (e.g.\n1493\t# _lib/adapters) is cp -R'd wholesale, dragging nested __pycache__ dirs and\n1494\t# .pyc files the predicate declares globally excluded. Per-file delete +\n1495\t# rmdir only — NEVER rm -rf. Refuses to operate through a symlink root\n1496\t# (link-mode dst is a symlink into the SOURCE tree). Fail-open: every step\n1497\t# is guarded; never changes the install exit status.\n1498\t_prune_pycache_under() {\n1499\t  local _pp_root=\"$1\" _pp_d _pp_f\n1500\t  [[ -d \"$_pp_root\" && ! -L \"$_pp_root\" ]] || return 0\n1501\t  # 1) *.pyc files anywhere under the copied destination (find without -L:\n1502\t  #    symlinks are never followed).\n1503\t  while IFS= read -r _pp_f; do\n1504\t    [[ -n \"$_pp_f\" ]] || continue\n1505\t    rm -f \"$_pp_f\" 2>/dev/null || true\n1506\t  done < <( find \"$_pp_root\" -type f -name '*.pyc' -print 2>/dev/null )\n1507\t  # 2) __pycache__ dirs, deepest first (-depth): delete their files one by\n1508\t  #    one, then rmdir. A dir still holding anything unexpected simply stays.\n1509\t  while IFS= read -r _pp_d; do\n1510\t    [[ -n \"$_pp_d\" && -d \"$_pp_d\" && ! -L \"$_pp_d\" ]] || continue\n1511\t    while IFS= read -r _pp_f; do\n1512\t      [[ -n \"$_pp_f\" ]] || continue\n1513\t      rm -f \"$_pp_f\" 2>/dev/null || true\n1514\t    done < <( find \"$_pp_d\" \\( -type f -o -type l \\) -print 2>/dev/null )\n1515\t    rmdir \"$_pp_d\" 2>/dev/null || true\n1516\t  done < <( find \"$_pp_root\" -depth -type d -name '__pycache__' -print 2>/dev/null )\n1517\t  return 0\n1518\t}\n1519\t\n1520\tinstall_lib_selective() {\n1521\t  echo \"\"\n1522\t  echo \"==> Installing hooks/_lib (runtime only — tests/, test_isolation.py, testing.py excluded)\"\n1523\t  local e base preexisting\n1524\t  for e in \"$SOURCE_DIR/.claude/hooks/_lib/\"*; do\n1525\t    [[ -e \"$e\" ]] || continue\n1526\t    base=\"$( basename \"$e\" )\"\n1527\t    # PLAN-161 U2 (CF-7): route through the ONE canonical framework-internal\n1528\t    # exclusion predicate (scripts/_framework_manifest_set.sh) so install and\n1529\t    # upgrade can never drift apart again. Behavior identical to the previous\n1530\t    # literal case; the fallback case below only serves a partial checkout\n1531\t    # where the helper file was absent at source time (fail-open parity).\n1532\t    if command -v _framework_path_excluded >/dev/null 2>&1; then\n1533\t      if _framework_path_excluded \".claude/hooks/_lib/$base\"; then continue; fi\n1534\t    else\n1535\t      case \"$base\" in\n1536\t        tests|test_isolation.py|testing.py|__pycache__) continue ;;\n1537\t      esac\n1538\t    fi\n1539\t    preexisting=0\n1540\t    [[ -e \"$TARGET/.claude/hooks/_lib/$base\" || -L \"$TARGET/.claude/hooks/_lib/$base\" ]] && preexisting=1\n1541\t    install_one \".claude/hooks/_lib/$base\"\n1542\t    # PLAN-161 U2 (codex r1 F7): only a