{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch79MaSyzLoPJEdaz4a9M","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NVuVfL2wnLWL9rt4xTu1Hd","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_python-hook.sh"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5028,"cache_read_input_tokens":105779,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5028},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"3555e588-d612-4c40-8493-0abcf9f94fc6","timestamp":"2026-11-16T19:17:39.449Z","request_id":"req_011Ch79MaD6LmLSUcv94pQSP","wire_tool_inputs":{"toolu_01NVuVfL2wnLWL9rt4xTu1Hd":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_python-hook.sh"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NVuVfL2wnLWL9rt4xTu1Hd","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# _python-hook.sh — Python version resolver + hook invoker.\n3\t#\n4\t# Registered in .claude/settings.json as the entrypoint for every Python\n5\t# hook (check_agent_spawn.py, audit_log.py). Resolves `python3.12` →\n6\t# `python3.11` → `python3.10` → `python3` and refuses anything below 3.9.\n7\t#\n8\t# ## Why a shim?\n9\t#\n10\t# `python3` on a user's $PATH is not hermetic:\n11\t# - asdf / pyenv resolution is shell-dependent\n12\t# - macOS system Python is 3.9 on older machines\n13\t# - ubuntu-22.04 runners default to 3.10\n14\t# - ubuntu-24.04 runners default to 3.12\n15\t# - minimal containers may ship Python 3.8 or none at all\n16\t#\n17\t# Letting Claude Code run `python3 ...` directly lets a mis-resolved PATH\n18\t# silently pick a version that can't run the hooks. The shim is explicit:\n19\t# it looks for the newest Python 3.x ≥ 3.9 and refuses to continue if no\n20\t# compatible interpreter is found. The refusal message points at install\n21\t# commands so the Owner can fix it in one step.\n22\t#\n23\t# ## Minimum Python version\n24\t#\n25\t# **3.9** — the macOS system Python on Big Sur / Monterey. This is a\n26\t# concession to reality: the original PLAN-002 §11-bis Q1 targeted 3.10\n27\t# as minimum, but local dogfooding on this repo runs on 3.9.6 and\n28\t# installing 3.10+ globally is out of scope for a framework that wants\n29\t# to be \"clone and use\". All hook Python code is written with\n30\t# `from __future__ import annotations` + `typing.Optional/Union` and\n31\t# avoids match statements, so 3.9 is fully workable.\n32\t#\n33\t# ## Usage\n34\t#\n35\t# In settings.json:\n36\t#     \"command\": \"bash \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\\\" check_agent_spawn.py\"\n37\t#\n38\t# The shim forwards stdin/stdout/stderr and passes any trailing args\n39\t# through to the Python interpreter.\n40\t\n41\t# F-CHAOS-5 (PLAN-019) + PLAN-023 Phase F (F-perf-001): explicit Python\n42\t# version gate, gated to the cache-miss branch only.\n43\t#\n44\t# Framework requires Python >=3.9 (ADR-002). Earlier versions silently\n45\t# lack stdlib features (from __future__ import annotations, etc.).\n46\t#\n47\t# Pre PLAN-023 Phase F: _py_version_check() ran unconditionally at shim\n48\t# entry, spawning a `python3 -c \"import sys...\"` subprocess every single\n49\t# invocation (~15-20ms). Cache-hit paths paid this cost even though the\n50\t# cached interpreter had already been validated on its first resolution.\n51\t#\n52\t# Post PLAN-023 Phase F: the check is called ONLY from the cache-miss\n53\t# branch below (after CANDIDATES-loop probing). The cache file persists\n54\t# a validated interpreter absolute path; a cache-hit restore implicitly\n55\t# re-validates by invoking the cached binary for the hook itself. If the\n56\t# cached binary has been uninstalled between invocations, the subsequent\n57\t# hook invocation fails loud with the OS-level \"No such file\" — cleaner\n58\t# signal than a silent version re-probe.\n59\t_py_version_check() {\n60\t  local ver\n61\t  ver=$(python3 -c \"import sys; print(f\\\"{sys.version_info.major}.{sys.version_info.minor}\\\")\" 2>/dev/null) || {\n62\t    echo \"ERROR: python3 not found or invocable. Framework requires Python >=3.9.\" >&2\n63\t    exit 3\n64\t  }\n65\t  local major minor\n66\t  major=${ver%.*}\n67\t  minor=${ver#*.}\n68\t  if [ \"$major\" -lt 3 ] || { [ \"$major\" -eq 3 ] && [ \"$minor\" -lt 9 ]; }; then\n69\t    echo \"ERROR: Python $ver detected; framework requires >=3.9 (ADR-002).\" >&2\n70\t    echo \"       Upgrade via your package manager and retry.\" >&2\n71\t    exit 3\n72\t  fi\n73\t}\n74\t# NOTE: call is deferred to the cache-miss branch below (see\n75\t# `_py_version_check` call site inside the CANDIDATES loop). Intentionally\n76\t# no call here — Phase F perf optimization.\n77\t\n78\t# PLAN-025 F-perf-dead-code-1: the earlier `_extract_session_id()`\n79\t# helper (P3-SEC-M PLAN-019) had no callers in production paths and\n80\t# was forking an extra `python3 -c` subprocess per invocation. Removed\n81\t# in Batch K to reduce shim overhead. If session_id breadcrumbs ever\n82\t# need to be extracted at shim level again, re-add with the Python\n83\t# JSON-parse call INSIDE the existing per-invocation python3 spawn\n84\t# (zero marginal cost) instead of a separate subprocess.\n85\t\n86\tset -euo pipefail\n87\t\n88\t# ---------------------------------------------------------------------------\n89\t# PLAN-156 Wave 2 (SENT-GK-A) — grok adapter AUTO-DETECT (pair-rail S269 P1 #1).\n90\t#\n91\t# THE CRITICAL single-surface fix. The grok harness arms the legacy-compat\n92\t# `.claude/settings.json`, whose hook commands do NOT carry\n93\t# `env CEO_HOOK_ADAPTER=grok` (they are the Claude-native registrations —\n94\t# adding it would break Claude Code, which shares the file). But grok delivers\n95\t# a camelCase wire (`hookEventName`/`toolName`) to those hooks, so without the\n96\t# adapter set they resolve to the CLAUDE adapter, which misparses the grok\n97\t# wire → empty tool_name → the matcher-shaped guards no-op → ENFORCEMENT\n98\t# SILENTLY FAILS (fail-open). The live-fire missed this because it set the env\n99\t# by hand; the codex pair-rail caught it.\n100\t#\n101\t# Grok injects `GROK_HOOK_EVENT` (+ GROK_SESSION_ID / GROK_WORKSPACE_ROOT) on\n102\t# EVERY hook it runs, and never sets CEO_HOOK_ADAPTER. So: if a grok runner\n103\t# var is present and the adapter is unset, we ARE under grok — select it. This\n104\t# is what makes the single-surface (`.claude/settings.json`) armed rail\n105\t# actually enforce under grok. An explicit CEO_HOOK_ADAPTER always wins (tests,\n106\t# codex, a deliberate override).\n107\tif [ -z \"${CEO_HOOK_ADAPTER:-}\" ] && [ -n \"${GROK_HOOK_EVENT:-}${GROK_SESSION_ID:-}\" ]; then\n108\t  export CEO_HOOK_ADAPTER=grok\n109\tfi\n110\t\n111\tMIN_MAJOR=3\n112\tMIN_MINOR=9\n113\t\n114\t# Preferred candidates, most-recent first.\n115\tCANDIDATES=(\n116\t  \"python3.13\"\n117\t  \"python3.12\"\n118\t  \"python3.11\"\n119\t  \"python3.10\"\n120\t  \"python3.9\"\n121\t  \"python3\"\n122\t)\n123\t\n124\t# PLAN-019 Perf-P2-002 — resolved-interpreter cache.\n125\t#\n126\t# Measured overhead pre-optimization: ~24ms p50 (on a box where only\n127\t# `python3` exists, 5 `command -v` failures + 1 spawn of `python -c\n128\t# \"import sys; print(...)\"` for version probe). Hot-path cost dominated\n129\t# by the version-probe subprocess.\n130\t#\n131\t# Optimization: cache the resolved interpreter path + PATH hash in a\n132\t# per-user tempfile. On cache-hit with matching PATH signature, skip the\n133\t# probing loop entirely. Cache invalidates automatically when the user's\n134\t# PATH changes (e.g. `brew install python@3.12`) so the freshest\n135\t# interpreter is picked up without manual eviction.\n136\t#\n137\t# Expected post-fix overhead: ~2ms (single `stat` + read of cache file).\n138\t#\n139\t# Security: cache file lives under $TMPDIR (or /tmp) with user-scoped\n140\t# path, so a rogue cache from another user cannot hijack. The cached\n141\t# path is only USED if the interpreter still exists + reports the same\n142\t# version. Fail-safe: cache miss falls back to the full probe.\n143\t_cache_dir() {\n144\t  local base=\"${TMPDIR:-/tmp}\"\n145\t  # Strip trailing slash for consistent path construction.\n146\t  base=\"${base%/}\"\n147\t  echo \"${base}/ceo-pyhook-$(id -u)\"\n148\t}\n149\t_path_hash() {\n150\t  # Fast-ish, deterministic hash of the current $PATH. Prefer shasum\n151\t  # (macOS); fall back to sha256sum (Linux); fall back to cksum (POSIX)\n152\t  # if neither is available (content differs but is still deterministic).\n153\t  if command -v shasum >/dev/null 2>&1; then\n154\t    printf '%s' \"$PATH\" | shasum -a 256 | cut -c1-16\n155\t  elif command -v sha256sum >/dev/null 2>&1; then\n156\t    printf '%s' \"$PATH\" | sha256sum | cut -c1-16\n157\t  else\n158\t    printf '%s' \"$PATH\" | cksum | cut -d' ' -f1\n159\t  fi\n160\t}\n161\t\n162\t# PLAN-152 security-01 — cache trust gate (TOCTOU / symlink hardening).\n163\t#\n164\t# The cached interpreter path is READ from $TMPDIR and later EXEC'd; under\n165\t# a shared /tmp another local user could pre-create the cache dir (or swap\n166\t# in a symlink) and plant an interpreter path of their choosing, and a\n167\t# symlinked cache DIR would additionally redirect the cache WRITE into an\n168\t# attacker-chosen location. Before any read or write we therefore require:\n169\t# the cache dir is a real directory (not a symlink) owned by the current\n170\t# uid, and the cache file (when present) is a regular non-symlink file\n171\t# owned by the current uid. Any failed check = cache miss (fall back to\n172\t# the full probe) — never a hard failure.\n173\t_owner_uid() {\n174\t  # GNU stat first (Linux); BSD stat fallback (macOS).\n175\t  stat -c '%u' \"$1\" 2>/dev/null || stat -f '%u' \"$1\" 2>/dev/null\n176\t}\n177\t_perm_bits() {\n178\t  # Octal permission bits (low bits only): GNU '%a' / BSD '%Lp'.\n179\t  stat -c '%a' \"$1\" 2>/dev/null || stat -f '%Lp' \"$1\" 2>/dev/null\n180\t}\n181\t_dir_mode_safe() {\n182\t  # PLAN-152 security-01 P2 (Codex R2): reject a group/other-writable\n183\t  # cache dir. A user-owned but world/group-writable dir lets another\n184\t  # local user swap the cache file between the trust check and the read\n185\t  # (TOCTOU), restoring the interpreter-hijack this gate closes.\n186\t  local m\n187\t  m=\"$(_perm_bits \"$1\")\" || return 1\n188\t  [ -n \"$m\" ] && [ \"$(( 0${m} & 022 ))\" -eq 0 ]\n189\t}\n190\t_cache_dir_trusted() {\n191\t  [ ! -L \"$_CACHE_DIR\" ] && [ -d \"$_CACHE_DIR\" ] \\\n192\t    && [ \"$(_owner_uid \"$_CACHE_DIR\")\" = \"$_CUR_UID\" ] \\\n193\t    && _dir_mode_safe \"$_CACHE_DIR\"\n194\t}\n195\t_cache_file_trusted() {\n196\t  [ ! -L \"$_CACHE_FILE\" ] && [ -f \"$_CACHE_FILE\" ] \\\n197\t    && [ \"$(_owner_uid \"$_CACHE_FILE\")\" = \"$_CUR_UID\" ]\n198\t}\n199\t\n200\tparse_version() {\n201\t  # Emit \"MAJOR MINOR\" from `python --version` output (e.g. \"Python 3.12.3\")\n202\t  local py=\"$1\"\n203\t  \"$py\" -c 'import sys; print(sys.version_info[0], sys.version_info[1])' 2>/dev/null\n204\t}\n205\t\n206\tversion_ok() {\n207\t  # Accepts \"MAJOR MINOR\"; returns 0 if ≥ MIN, else 1.\n208\t  local major=\"$1\" minor=\"$2\"\n209\t  if [ \"$major\" -lt \"$MIN_MAJOR\" ]; then\n210\t    return 1\n211\t  fi\n212\t  if [ \"$major\" -eq \"$MIN_MAJOR\" ] && [ \"$minor\" -lt \"$MIN_MINOR\" ]; then\n213\t    return 1\n214\t  fi\n215\t  return 0\n216\t}\n217\t\n218\t# ---- Cache lookup (fast path) ----\n219\tFOUND_PY=\"\"\n220\t_CUR_UID=\"$(id -u)\"\n221\t_CACHE_DIR=\"$(_cache_dir)\"\n222\t_PATH_SIG=\"$(_path_hash 2>/dev/null || echo \"nohash\")\"\n223\t_CACHE_FILE=\"${_CACHE_DIR}/resolved-py-${_PATH_SIG}\"\n224\t\n225\t# Honour CEO_PYHOOK_NO_CACHE=1 to force re-probe (useful for testing\n226\t# the fallback path or after installing a new interpreter mid-session).\n227\t# PLAN-152 security-01: the dir + file trust gates (ownership, no\n228\t# symlinks) run BEFORE the read — an untrusted cache is a cache MISS.\n229\tif [ \"${CEO_PYHOOK_NO_CACHE:-0}\" != \"1\" ] && _cache_dir_trusted \\\n230\t    && _cache_file_trusted && [ -r \"$_CACHE_FILE\" ]; then\n231\t  _cached_py=\"$(cat \"$_CACHE_FILE\" 2>/dev/null || echo \"\")\"\n232\t  if [ -n \"$_cached_py\" ] && command -v \"$_cached_py\" >/dev/null 2>&1; then\n233\t    # Trust the cache: PATH-hash changes would have produced a different\n234\t    # cache filename, and the interpreter path still resolves. No version\n235\t    # recheck needed on hot path.\n236\t    FOUND_PY=\"$_cached_py\"\n237\t  fi\n238\tfi\n239\t\n240\t# ---- Cache miss: full probe + repopulate ----\n241\tif [ -z \"$FOUND_PY\" ]; then\n242\t  # PLAN-023 Phase F (F-perf-001): run the baseline Python≥3.9 gate ONLY\n243\t  # in the cache-miss branch. The gate's `python3 -c ...` spawn is ~15-20ms\n244\t  # that cache-hit paths no longer pay. The gate still fires on every\n245\t  # first-time or PATH-changed invocation, which is the only time a new\n246\t  # interpreter could appear.\n247\t  _py_version_check\n248\t\n249\t  for candidate in \"${CANDIDATES[@]}\"; do\n250\t    if command -v \"$candidate\" >/dev/null 2>&1; then\n251\t      read -r py_major py_minor <<< \"$(parse_version \"$candidate\")\"\n252\t      if [ -n \"${py_major:-}\" ] && version_ok \"$py_major\" \"$py_minor\"; then\n253\t        FOUND_PY=\"$candidate\"\n254\t        break\n255\t      fi\n256\t    fi\n257\t  done\n258\t\n259\t  # Cache the result for next invocation (atomic write via mv).\n260\t  if [ -n \"$FOUND_PY\" ]; then\n261\t    # mkdir is idempotent + concurrent-safe (-p). Set 0700 so another\n262\t    # unix user on the host cannot read or replace the cache.\n263\t    # PLAN-152 security-01: never write through a symlinked or foreign-\n264\t    # owned cache dir (symlink-redirect write primitive).\n265\t    # Order matters (PLAN-152 security-01 P2): reject a symlinked dir\n266\t    # BEFORE chmod (never chmod an attacker's symlink target), then chmod\n267\t    # 0700 to normalize the mode under a loose umask, THEN the full trust\n268\t    # check (owner + non-symlink + no group/other write).\n269\t    if mkdir -p \"$_CACHE_DIR\" 2>/dev/null && [ ! -L \"$_CACHE_DIR\" ] \\\n270\t        && chmod 0700 \"$_CACHE_DIR\" 2>/dev/null && _cache_dir_trusted; then\n271\t      _tmp_cache=\"${_CACHE_FILE}.$$\"\n272\t      if printf '%s\\n' \"$FOUND_PY\" > \"$_tmp_cache\" 2>/dev/null; then\n273\t        mv -f \"$_tmp_cache\" \"$_CACHE_FILE\" 2>/dev/null || rm -f \"$_tmp_cache\" 2>/dev/null\n274\t      fi\n275\t    fi\n276\t  fi\n277\tfi\n278\t\n279\tif [ -z \"$FOUND_PY\" ]; then\n280\t  cat >&2 <<EOF\n281\t[_python-hook.sh] ERROR: No Python >= ${MIN_MAJOR}.${MIN_MINOR} found.\n282\tceo-orchestration hooks require Python ${MIN_MAJOR}.${MIN_MINOR}+. Install one:\n283\t\n284\t  macOS:   brew install python@3.12\n285\t  Ubuntu:  sudo apt install python3.12\n286\t  Fedora:  sudo dnf install python3.12\n287\t\n288\tAfter installing, restart your shell so the PATH picks up the new interpreter.\n289\tEOF\n290\t  # Fail-open: emit a permissive decision so the user session isn't bricked\n291\t  # if Python is missing. The governance hook degrades gracefully.\n292\t  echo '{}'  # schema-compliant allow\n293\t  exit 0\n294\tfi\n295\t\n296\t# First positional arg is the hook script name (relative to this dir).\n297\tHOOKS_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\n298\tif [ $# -lt 1 ]; then\n299\t  echo \"[_python-hook.sh] ERROR: missing hook script name\" >&2\n300\t  echo '{}'  # schema-compliant allow\n301\t  exit 0\n302\tfi\n303\t\n304\tHOOK_SCRIPT=\"$HOOKS_DIR/$1\"\n305\tshift\n306\t\n307\tif [ ! -f \"$HOOK_SCRIPT\" ]; then\n308\t  echo \"[_python-hook.sh] ERROR: hook not found: $HOOK_SCRIPT\" >&2\n309\t  echo '{}'  # schema-compliant allow\n310\t  exit 0\n311\tfi\n312\t\n313\t# ---------------------------------------------------------------------------\n314\t# PLAN-156 Wave 2 (SENT-GK-A) — decision→exit chokepoint.\n315\t#\n316\t# ## Why the shim owns this\n317\t#\n318\t# Grok Build's PreToolUse contract (grok 0.2.93) and Codex's both key a\n319\t# deny on **exit 2** in addition to the stdout JSON (probes:\n320\t# PLAN-156/artifacts/characterization-grok-codex-S269.md). Before this\n321\t# block, deny-emit and process-exit were DECOUPLED: `write_decision` only\n322\t# wrote stdout and the shim `exec`'d the hook, so the hook's own exit 0\n323\t# became the process exit — a correct deny could still fail OPEN on a\n324\t# host that keys on the code. The mapping cannot live in Python (an\n325\t# interpreter crash / ImportError / signal never reaches Python), so it\n326\t# lives HERE: the single path every registered hook routes through.\n327\t#\n328\t# ## The rule: decision-derived, never exit-code-derived\n329\t#\n330\t#   emitted deny          -> exit 2   (a decision was made: enforce it)\n331\t#   emitted allow / {}    -> exit 0\n332\t#   crashed, NO decision  -> hook's own rc (fail-OPEN: the INFRASTRUCTURE\n333\t#                                     half of CLAUDE.md §4 — a missing\n334\t#                                     file, an ImportError, a timeout\n335\t#                                     must never block the user session)\n336\t#\n337\t# Reading the DECISION rather than the hook's exit code is what keeps\n338\t# those two apart: an input-class deny (a security matcher emitting a\n339\t# structured deny on a payload it cannot parse — the codex.py coherence\n340\t# gate pattern) exits 2, while a bare interpreter crash with no decision\n341\t# on stdout keeps its own (fail-open) code. A blanket \"nonzero -> deny\"\n342\t# remap would break the fail-open half and is explicitly NOT what this does.\n343\t#\n344\t# ## ADAPTER-AWARE: gated on CEO_HOOK_ADAPTER=grok (debate C14, per lacuna (h))\n345\t#\n346\t# The plan's Wave-2 conditional: \"UNCONDITIONAL mapping SAFE iff Wave-0\n347\t# lacuna (h) confirms exit 2 is INERT on Codex; if not, the mapping is\n348\t# adapter-aware.\" Lacuna (h) found exit 2 is NOT inert on Codex — it is an\n349\t# ACTIVE deny on PreToolUse (probe P9a). So the plan's own fork selects the\n350\t# adapter-aware branch: gate on grok, leave Claude/Codex byte-identical.\n351\t#\n352\t# This is not a weakening. On EVERY host the stdout JSON decision blocks on\n353\t# its own (grok P2, codex JSON-deny, claude JSON-block); the exit code is\n354\t# belt-and-suspenders. Remapping deny->2 on Codex/Claude would only change\n355\t# an observable exit code with no enforcement gain, while breaking every\n356\t# existing test that pins \"deny -> exit 0\" — a large blast radius for zero\n357\t# security benefit. The grok gate keeps the value (a future grok release\n358\t# that tightens the docs.x.ai \"deny REQUIRES exit 2\" rule is covered) where\n359\t# it belongs.\n360\t#\n361\t# R-SEC2 (unset adapter under grok → fail-open) is NOT solved by an\n362\t# unconditional EXIT map anyway: on grok a `block` with exit 2 STILL\n363\t# fail-opens (P5 — malformed output beats the exit code). It is solved by\n364\t# (1) the grok registration always setting CEO_HOOK_ADAPTER=grok — exactly\n365\t# as codex sets =codex — and (2) the CI test asserting every registration\n366\t# routes through this shim (hooks/tests/test_exit2_chokepoint.py). A named\n367\t# residual, identical in kind to the codex one.\n368\t#\n369\t# ## What this block does NOT do\n370\t#\n371\t# It does NOT rewrite the decision vocabulary here — the grok block->deny\n372\t# rewrite below (also grok-gated) is the ESSENTIAL fix, because grok\n373\t# fail-OPENs on `{\"decision\":\"block\"}` EVEN WITH exit 2 (probe P5). This\n374\t# exit map is the secondary half; the meta-test asserts BOTH.\n375\t#\n376\t# CEO_HOOK_EXIT_MAP=0 disables the mapping (escape hatch if a future grok\n377\t# release turns exit-2-hostile; the arming check surfaces the override).\n378\t\n379\t# The grok path has TWO halves with DIFFERENT disable semantics:\n380\t#   - vocabulary rewrite (block->deny): the ESSENTIAL grok fix — a `block`\n381\t#     fail-OPENs on grok (P4/P5). NOT disableable by CEO_HOOK_EXIT_MAP.\n382\t#   - exit-2 mapping (deny->exit 2): belt-and-suspenders. CEO_HOOK_EXIT_MAP=0\n383\t#     turns this off (a future grok release that makes exit-2 hostile).\n384\t# Both fire ONLY under CEO_HOOK_ADAPTER=grok on a BLOCKING event; every other\n385\t# path preserves the historical exec byte-for-byte (Claude/Codex unchanged).\n386\t_CEO_GROK_PATH=0\n387\tif [ \"${CEO_HOOK_ADAPTER:-}\" = \"grok\" ]; then\n388\t  _CEO_GROK_PATH=1\n389\tfi\n390\t\n391\t# Event source: under grok, GROK_HOOK_EVENT is the AUTHORITATIVE source (grok\n392\t# sets it). Pair-rail S269 finding #4: a generic\n393\t# `${CLAUDE_HOOK_EVENT:-${GROK_HOOK_EVENT:-…}}` precedence lets a stale/injected\n394\t# CLAUDE_HOOK_EVENT=post_tool_use mislabel a real grok pre_tool_use as passive\n395\t# and DISABLE the chokepoint (grok then fail-opens). Since this whole block is\n396\t# already gated on CEO_HOOK_ADAPTER=grok, read grok's own var first.\n397\t_CEO_EVENT=\"${GROK_HOOK_EVENT:-${CLAUDE_HOOK_EVENT:-${CODEX_HOOK_EVENT:-}}}\"\n398\t_CEO_BLOCKING_EVENT=1\n399\tcase \"$_CEO_EVENT\" in\n400\t  # Passive events (grok spells them snake_case). A passive hook can never\n401\t  # block on grok, so neither the rewrite nor the exit map should touch it.\n402\t  post_tool_use|post_tool_use_failure|session_start|session_end|\\\n403\t  notification|pre_compact|post_compact|subagent_start|subagent_stop|\\\n404\t  permission_denied|stop_failure|stop)\n405\t    _CEO_BLOCKING_EVENT=0\n406\t    ;;\n407\tesac\n408\t\n409\t# Registered hooks have invocation deadlines: exit must leave spool work pending.\n410\texport CEO_HOOK_BOUNDED_EXIT=1\n411\t\n412\tif [ \"$_CEO_GROK_PATH\" -eq 0 ] || [ \"$_CEO_BLOCKING_EVENT\" -eq 0 ]; then\n413\t  # Not the grok blocking path (Claude/Codex byte-identical to the historical\n414\t  # shim), or a passive grok event: preserve the historical exec (zero added\n415\t  # latency; exit = the hook's own).\n416\t  exec \"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\"\n417\tfi\n418\t\n419\t# Blocking event: capture stdout so the decision can drive the exit code.\n420\t# stderr passes through untouched (breadcrumbs stay visible to the host).\n421\t# `set -e` must not kill us on a nonzero hook exit — we inspect it.\n422\tset +e\n423\t_CEO_HOOK_STDOUT=\"$(\"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\")\"\n424\t_CEO_HOOK_RC=$?\n425\tset -e\n426\t\n427\t# --- grok vocabulary backstop (probe P5) ------------------------------------\n428\t#\n429\t# Hooks that route their egress through `_lib/adapters/resolve()` already\n430\t# emit `deny` under CEO_HOOK_ADAPTER=grok (grok.py:write_decision). But a\n431\t# LEGACY hook that hardcodes the Claude vocabulary — today\n432\t# `check_codex_filewrite.py`, which json.dumps `{\"decision\": \"block\"}`\n433\t# directly (lines 275/294/356) — would emit a word grok does not know.\n434\t# On grok that is malformed output = hook failure = **fail-OPEN, even\n435\t# with exit 2** (P5). Re-routing that hook through this shim (PLAN-156\n436\t# Wave 2 settings edit) gives it the exit mapping but NOT the vocabulary,\n437\t# so the shim translates here as well: one chokepoint owns BOTH halves,\n438\t# and any future hook that forgets the adapter seam degrades to a correct\n439\t# deny instead of a silent allow.\n440\t#\n441\t# We are guaranteed here to be on the grok blocking path. Rewrite block→deny\n442\t# with a WHITESPACE-TOLERANT regex (pair-rail S269 finding #3): the two\n443\t# fixed-string substitutions only matched json.dumps's exact spacing\n444\t# (`\"decision\": \"block\"` and `\"decision\":\"block\"`), so a hook emitting\n445\t# `\"decision\" : \"block\"` (space before the colon) would slip through and\n446\t# grok would fail-OPEN. `[[:space:]]*` around the colon covers any spacing.\n447\t# sed is one cheap subprocess on the (rare) blocking path — acceptable vs a\n448\t# silent-allow on an unusual-but-valid deny shape.\n449\tif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n450\t  _CEO_HOOK_STDOUT=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" \\\n451\t    | sed -E 's/\"decision\"[[:space:]]*:[[:space:]]*\"block\"/\"decision\": \"deny\"/g')\"\n452\tfi\n453\t\n454\t# NOTE (pair-rail R1 P1, S272): stdout is emitted AFTER the decision parse\n455\t# below, not here. On grok the JSON on stdout is the PRIMARY block; emitting a\n456\t# malformed deny-bearing payload first hands grok garbage (it fails open on it)\n457\t# and leaves only the secondary exit-2 rail — turning the belt-and-suspenders\n458\t# design into a single strap. The parse block decides, then emits: verbatim on\n459\t# every normal path, and a well-formed `{\"decision\":\"deny\"}` when the payload\n460\t# is unparseable BUT carries a deny token.\n461\t\n462\t# Exit-2 mapping (belt-and-suspenders; CEO_HOOK_EXIT_MAP=0 disables JUST this\n463\t# half, never the vocabulary rewrite above). After the rewrite the only deny\n464\t# vocabulary on stdout is grok's `deny` (or a codex-shaped permissionDecision\n465\t# from a legacy hook that also routed here).\n466\t#\n467\t# F6 (PLAN-156-FOLLOWUP, consensus C5 — security-VETO direction): the original\n468\t# mapping was an order-sensitive whole-stdout case glob\n469\t# (*'\"decision\"'*'\"deny\"'*), which mis-fires BOTH ways: an ALLOW payload whose\n470\t# other fields merely QUOTE a deny shape exited 2 (spurious block — the S270\n471\t# live-fire finding), and a first-occurrence variant would let a decoy nested\n472\t# `\"decision\":\"allow\"` mask a real top-level deny. Replaced with a STRUCTURAL\n473\t# parse of the TOP-LEVEL `decision` / `hookSpecificOutput.permissionDecision`\n474\t# via the already-resolved $FOUND_PY (one extra subprocess on the rare\n475\t# blocking path — cost accepted by the debate).\n476\t#\n477\t# Dual fail-direction semantics (NEVER \"nonzero -> deny\"):\n478\t#   parse OK      -> the FIELD governs: deny -> exit 2, anything else -> the\n479\t#                    hook's own rc below.\n480\t#   parse FAILURE -> deny token ('\"deny\"') present on stdout -> exit 2\n481\t#                    (fail-CLOSED: content the mapper cannot parse is never\n482\t#                    waved through when it may carry a real deny — the\n483\t#                    CLAUDE.md §4 INPUT half);\n484\t#                 -> no deny token -> the hook's own rc below (the\n485\t#                    INFRASTRUCTURE fail-open half, preserved: a crash or\n486\t#                    garbage with no decision never blocks the session).\n487\t# A crash with EMPTY stdout skips this block entirely -> hook rc (fail-open).\n488\tif [ \"${CEO_HOOK_EXIT_MAP:-1}\" = \"1\" ] && [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n489\t  _CEO_DECISION=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" | \"$FOUND_PY\" -c '\n490\timport json, sys\n491\t\n492\ttry:\n493\t    obj = json.load(sys.stdin)\n494\texcept Exception:\n495\t    print(\"__CEO_PARSE_FAILURE__\")\n496\t    raise SystemExit(0)\n497\tdecision = \"\"\n498\tif isinstance(obj, dict):\n499\t    d = obj.get(\"decision\")\n500\t    if isinstance(d, str):\n501\t        decision = d\n502\t    else:\n503\t        hso = obj.get(\"hookSpecificOutput\")\n504\t        if isinstance(hso, dict):\n505\t            pd = hso.get(\"permissionDecision\")\n506\t            if isinstance(pd, str):\n507\t                decision = pd\n508\tprint(decision)\n509\t' 2>/dev/null)\" || _CEO_DECISION=\"__CEO_PARSE_FAILURE__\"\n510\t  case \"$_CEO_DECISION\" in\n511\t    deny)\n512\t      # Structural top-level deny — emit the (valid) payload so the PRIMARY\n513\t      # stdout rail blocks, then enforce the secondary exit-2 rail.\n514\t      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n515\t      exit 2\n516\t      ;;\n517\t    __CEO_PARSE_FAILURE__)\n518\t      # Sentinel also covers the parser subprocess itself failing to spawn:\n519\t      # that infra failure degrades to the token scan, never to a silent allow\n520\t      # of a deny-bearing payload.\n521\t      case \"$_CEO_HOOK_STDOUT\" in\n522\t        *'\"deny\"'*)\n523\t          # Unparseable BUT deny-bearing: emitting the garbage would fail OPEN\n524\t          # on grok's primary rail. Emit a well-formed deny instead — both\n525\t          # rails now block. The original payload is preserved on stderr for\n526\t          # forensics (stderr never feeds the decision).\n527\t          printf '%s\\n' \"$_CEO_HOOK_STDOUT\" >&2\n528\t          printf '%s\\n' '{\"decision\": \"deny\", \"reason\": \"hook emitted an unparseable deny-bearing payload; blocked fail-CLOSED by _python-hook.sh (original payload on stderr)\"}'\n529\t          exit 2\n530\t          ;;\n531\t      esac\n532\t      # Unparseable and NO deny token: emit verbatim (a malformed allow is the\n533\t      # hook's own business) and fall through to its rc — INFRASTRUCTURE\n534\t      # fail-open half, preserved.\n535\t      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n536\t      ;;\n537\t    *)\n538\t      # Parsed, not a deny (allow / ask / absent) — emit verbatim.\n539\t      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n540\t      ;;\n541\t  esac\n542\telif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n543\t  # Exit-map disabled (CEO_HOOK_EXIT_MAP=0): the vocabulary rewrite above still\n544\t  # ran; emit the hook's stdout unchanged — the JSON rail is on its own.\n545\t  printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n546\tfi\n547\t\n548\texit \"$_CEO_HOOK_RC\"\n549\t"}]},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"c9ceee6b-4a15-4cf1-943e-0f342c2ec67a","timestamp":"2026-11-16T19:17:39.467Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_python-hook.sh","content":"#!/usr/bin/env bash\n# _python-hook.sh — Python version resolver + hook invoker.\n#\n# Registered in .claude/settings.json as the entrypoint for every Python\n# hook (check_agent_spawn.py, audit_log.py). Resolves `python3.12` →\n# `python3.11` → `python3.10` → `python3` and refuses anything below 3.9.\n#\n# ## Why a shim?\n#\n# `python3` on a user's $PATH is not hermetic:\n# - asdf / pyenv resolution is shell-dependent\n# - macOS system Python is 3.9 on older machines\n# - ubuntu-22.04 runners default to 3.10\n# - ubuntu-24.04 runners default to 3.12\n# - minimal containers may ship Python 3.8 or none at all\n#\n# Letting Claude Code run `python3 ...` directly lets a mis-resolved PATH\n# silently pick a version that can't run the hooks. The shim is explicit:\n# it looks for the newest Python 3.x ≥ 3.9 and refuses to continue if no\n# compatible interpreter is found. The refusal message points at install\n# commands so the Owner can fix it in one step.\n#\n# ## Minimum Python version\n#\n# **3.9** — the macOS system Python on Big Sur / Monterey. This is a\n# concession to reality: the original PLAN-002 §11-bis Q1 targeted 3.10\n# as minimum, but local dogfooding on this repo runs on 3.9.6 and\n# installing 3.10+ globally is out of scope for a framework that wants\n# to be \"clone and use\". All hook Python code is written with\n# `from __future__ import annotations` + `typing.Optional/Union` and\n# avoids match statements, so 3.9 is fully workable.\n#\n# ## Usage\n#\n# In settings.json:\n#     \"command\": \"bash \\\"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\\\" check_agent_spawn.py\"\n#\n# The shim forwards stdin/stdout/stderr and passes any trailing args\n# through to the Python interpreter.\n\n# F-CHAOS-5 (PLAN-019) + PLAN-023 Phase F (F-perf-001): explicit Python\n# version gate, gated to the cache-miss branch only.\n#\n# Framework requires Python >=3.9 (ADR-002). Earlier versions silently\n# lack stdlib features (from __future__ import annotations, etc.).\n#\n# Pre PLAN-023 Phase F: _py_version_check() ran unconditionally at shim\n# entry, spawning a `python3 -c \"import sys...\"` subprocess every single\n# invocation (~15-20ms). Cache-hit paths paid this cost even though the\n# cached interpreter had already been validated on its first resolution.\n#\n# Post PLAN-023 Phase F: the check is called ONLY from the cache-miss\n# branch below (after CANDIDATES-loop probing). The cache file persists\n# a validated interpreter absolute path; a cache-hit restore implicitly\n# re-validates by invoking the cached binary for the hook itself. If the\n# cached binary has been uninstalled between invocations, the subsequent\n# hook invocation fails loud with the OS-level \"No such file\" — cleaner\n# signal than a silent version re-probe.\n_py_version_check() {\n  local ver\n  ver=$(python3 -c \"import sys; print(f\\\"{sys.version_info.major}.{sys.version_info.minor}\\\")\" 2>/dev/null) || {\n    echo \"ERROR: python3 not found or invocable. Framework requires Python >=3.9.\" >&2\n    exit 3\n  }\n  local major minor\n  major=${ver%.*}\n  minor=${ver#*.}\n  if [ \"$major\" -lt 3 ] || { [ \"$major\" -eq 3 ] && [ \"$minor\" -lt 9 ]; }; then\n    echo \"ERROR: Python $ver detected; framework requires >=3.9 (ADR-002).\" >&2\n    echo \"       Upgrade via your package manager and retry.\" >&2\n    exit 3\n  fi\n}\n# NOTE: call is deferred to the cache-miss branch below (see\n# `_py_version_check` call site inside the CANDIDATES loop). Intentionally\n# no call here — Phase F perf optimization.\n\n# PLAN-025 F-perf-dead-code-1: the earlier `_extract_session_id()`\n# helper (P3-SEC-M PLAN-019) had no callers in production paths and\n# was forking an extra `python3 -c` subprocess per invocation. Removed\n# in Batch K to reduce shim overhead. If session_id breadcrumbs ever\n# need to be extracted at shim level again, re-add with the Python\n# JSON-parse call INSIDE the existing per-invocation python3 spawn\n# (zero marginal cost) instead of a separate subprocess.\n\nset -euo pipefail\n\n# ---------------------------------------------------------------------------\n# PLAN-156 Wave 2 (SENT-GK-A) — grok adapter AUTO-DETECT (pair-rail S269 P1 #1).\n#\n# THE CRITICAL single-surface fix. The grok harness arms the legacy-compat\n# `.claude/settings.json`, whose hook commands do NOT carry\n# `env CEO_HOOK_ADAPTER=grok` (they are the Claude-native registrations —\n# adding it would break Claude Code, which shares the file). But grok delivers\n# a camelCase wire (`hookEventName`/`toolName`) to those hooks, so without the\n# adapter set they resolve to the CLAUDE adapter, which misparses the grok\n# wire → empty tool_name → the matcher-shaped guards no-op → ENFORCEMENT\n# SILENTLY FAILS (fail-open). The live-fire missed this because it set the env\n# by hand; the codex pair-rail caught it.\n#\n# Grok injects `GROK_HOOK_EVENT` (+ GROK_SESSION_ID / GROK_WORKSPACE_ROOT) on\n# EVERY hook it runs, and never sets CEO_HOOK_ADAPTER. So: if a grok runner\n# var is present and the adapter is unset, we ARE under grok — select it. This\n# is what makes the single-surface (`.claude/settings.json`) armed rail\n# actually enforce under grok. An explicit CEO_HOOK_ADAPTER always wins (tests,\n# codex, a deliberate override).\nif [ -z \"${CEO_HOOK_ADAPTER:-}\" ] && [ -n \"${GROK_HOOK_EVENT:-}${GROK_SESSION_ID:-}\" ]; then\n  export CEO_HOOK_ADAPTER=grok\nfi\n\nMIN_MAJOR=3\nMIN_MINOR=9\n\n# Preferred candidates, most-recent first.\nCANDIDATES=(\n  \"python3.13\"\n  \"python3.12\"\n  \"python3.11\"\n  \"python3.10\"\n  \"python3.9\"\n  \"python3\"\n)\n\n# PLAN-019 Perf-P2-002 — resolved-interpreter cache.\n#\n# Measured overhead pre-optimization: ~24ms p50 (on a box where only\n# `python3` exists, 5 `command -v` failures + 1 spawn of `python -c\n# \"import sys; print(...)\"` for version probe). Hot-path cost dominated\n# by the version-probe subprocess.\n#\n# Optimization: cache the resolved interpreter path + PATH hash in a\n# per-user tempfile. On cache-hit with matching PATH signature, skip the\n# probing loop entirely. Cache invalidates automatically when the user's\n# PATH changes (e.g. `brew install python@3.12`) so the freshest\n# interpreter is picked up without manual eviction.\n#\n# Expected post-fix overhead: ~2ms (single `stat` + read of cache file).\n#\n# Security: cache file lives under $TMPDIR (or /tmp) with user-scoped\n# path, so a rogue cache from another user cannot hijack. The cached\n# path is only USED if the interpreter still exists + reports the same\n# version. Fail-safe: cache miss falls back to the full probe.\n_cache_dir() {\n  local base=\"${TMPDIR:-/tmp}\"\n  # Strip trailing slash for consistent path construction.\n  base=\"${base%/}\"\n  echo \"${base}/ceo-pyhook-$(id -u)\"\n}\n_path_hash() {\n  # Fast-ish, deterministic hash of the current $PATH. Prefer shasum\n  # (macOS); fall back to sha256sum (Linux); fall back to cksum (POSIX)\n  # if neither is available (content differs but is still deterministic).\n  if command -v shasum >/dev/null 2>&1; then\n    printf '%s' \"$PATH\" | shasum -a 256 | cut -c1-16\n  elif command -v sha256sum >/dev/null 2>&1; then\n    printf '%s' \"$PATH\" | sha256sum | cut -c1-16\n  else\n    printf '%s' \"$PATH\" | cksum | cut -d' ' -f1\n  fi\n}\n\n# PLAN-152 security-01 — cache trust gate (TOCTOU / symlink hardening).\n#\n# The cached interpreter path is READ from $TMPDIR and later EXEC'd; under\n# a shared /tmp another local user could pre-create the cache dir (or swap\n# in a symlink) and plant an interpreter path of their choosing, and a\n# symlinked cache DIR would additionally redirect the cache WRITE into an\n# attacker-chosen location. Before any read or write we therefore require:\n# the cache dir is a real directory (not a symlink) owned by the current\n# uid, and the cache file (when present) is a regular non-symlink file\n# owned by the current uid. Any failed check = cache miss (fall back to\n# the full probe) — never a hard failure.\n_owner_uid() {\n  # GNU stat first (Linux); BSD stat fallback (macOS).\n  stat -c '%u' \"$1\" 2>/dev/null || stat -f '%u' \"$1\" 2>/dev/null\n}\n_perm_bits() {\n  # Octal permission bits (low bits only): GNU '%a' / BSD '%Lp'.\n  stat -c '%a' \"$1\" 2>/dev/null || stat -f '%Lp' \"$1\" 2>/dev/null\n}\n_dir_mode_safe() {\n  # PLAN-152 security-01 P2 (Codex R2): reject a group/other-writable\n  # cache dir. A user-owned but world/group-writable dir lets another\n  # local user swap the cache file between the trust check and the read\n  # (TOCTOU), restoring the interpreter-hijack this gate closes.\n  local m\n  m=\"$(_perm_bits \"$1\")\" || return 1\n  [ -n \"$m\" ] && [ \"$(( 0${m} & 022 ))\" -eq 0 ]\n}\n_cache_dir_trusted() {\n  [ ! -L \"$_CACHE_DIR\" ] && [ -d \"$_CACHE_DIR\" ] \\\n    && [ \"$(_owner_uid \"$_CACHE_DIR\")\" = \"$_CUR_UID\" ] \\\n    && _dir_mode_safe \"$_CACHE_DIR\"\n}\n_cache_file_trusted() {\n  [ ! -L \"$_CACHE_FILE\" ] && [ -f \"$_CACHE_FILE\" ] \\\n    && [ \"$(_owner_uid \"$_CACHE_FILE\")\" = \"$_CUR_UID\" ]\n}\n\nparse_version() {\n  # Emit \"MAJOR MINOR\" from `python --version` output (e.g. \"Python 3.12.3\")\n  local py=\"$1\"\n  \"$py\" -c 'import sys; print(sys.version_info[0], sys.version_info[1])' 2>/dev/null\n}\n\nversion_ok() {\n  # Accepts \"MAJOR MINOR\"; returns 0 if ≥ MIN, else 1.\n  local major=\"$1\" minor=\"$2\"\n  if [ \"$major\" -lt \"$MIN_MAJOR\" ]; then\n    return 1\n  fi\n  if [ \"$major\" -eq \"$MIN_MAJOR\" ] && [ \"$minor\" -lt \"$MIN_MINOR\" ]; then\n    return 1\n  fi\n  return 0\n}\n\n# ---- Cache lookup (fast path) ----\nFOUND_PY=\"\"\n_CUR_UID=\"$(id -u)\"\n_CACHE_DIR=\"$(_cache_dir)\"\n_PATH_SIG=\"$(_path_hash 2>/dev/null || echo \"nohash\")\"\n_CACHE_FILE=\"${_CACHE_DIR}/resolved-py-${_PATH_SIG}\"\n\n# Honour CEO_PYHOOK_NO_CACHE=1 to force re-probe (useful for testing\n# the fallback path or after installing a new interpreter mid-session).\n# PLAN-152 security-01: the dir + file trust gates (ownership, no\n# symlinks) run BEFORE the read — an untrusted cache is a cache MISS.\nif [ \"${CEO_PYHOOK_NO_CACHE:-0}\" != \"1\" ] && _cache_dir_trusted \\\n    && _cache_file_trusted && [ -r \"$_CACHE_FILE\" ]; then\n  _cached_py=\"$(cat \"$_CACHE_FILE\" 2>/dev/null || echo \"\")\"\n  if [ -n \"$_cached_py\" ] && command -v \"$_cached_py\" >/dev/null 2>&1; then\n    # Trust the cache: PATH-hash changes would have produced a different\n    # cache filename, and the interpreter path still resolves. No version\n    # recheck needed on hot path.\n    FOUND_PY=\"$_cached_py\"\n  fi\nfi\n\n# ---- Cache miss: full probe + repopulate ----\nif [ -z \"$FOUND_PY\" ]; then\n  # PLAN-023 Phase F (F-perf-001): run the baseline Python≥3.9 gate ONLY\n  # in the cache-miss branch. The gate's `python3 -c ...` spawn is ~15-20ms\n  # that cache-hit paths no longer pay. The gate still fires on every\n  # first-time or PATH-changed invocation, which is the only time a new\n  # interpreter could appear.\n  _py_version_check\n\n  for candidate in \"${CANDIDATES[@]}\"; do\n    if command -v \"$candidate\" >/dev/null 2>&1; then\n      read -r py_major py_minor <<< \"$(parse_version \"$candidate\")\"\n      if [ -n \"${py_major:-}\" ] && version_ok \"$py_major\" \"$py_minor\"; then\n        FOUND_PY=\"$candidate\"\n        break\n      fi\n    fi\n  done\n\n  # Cache the result for next invocation (atomic write via mv).\n  if [ -n \"$FOUND_PY\" ]; then\n    # mkdir is idempotent + concurrent-safe (-p). Set 0700 so another\n    # unix user on the host cannot read or replace the cache.\n    # PLAN-152 security-01: never write through a symlinked or foreign-\n    # owned cache dir (symlink-redirect write primitive).\n    # Order matters (PLAN-152 security-01 P2): reject a symlinked dir\n    # BEFORE chmod (never chmod an attacker's symlink target), then chmod\n    # 0700 to normalize the mode under a loose umask, THEN the full trust\n    # check (owner + non-symlink + no group/other write).\n    if mkdir -p \"$_CACHE_DIR\" 2>/dev/null && [ ! -L \"$_CACHE_DIR\" ] \\\n        && chmod 0700 \"$_CACHE_DIR\" 2>/dev/null && _cache_dir_trusted; then\n      _tmp_cache=\"${_CACHE_FILE}.$$\"\n      if printf '%s\\n' \"$FOUND_PY\" > \"$_tmp_cache\" 2>/dev/null; then\n        mv -f \"$_tmp_cache\" \"$_CACHE_FILE\" 2>/dev/null || rm -f \"$_tmp_cache\" 2>/dev/null\n      fi\n    fi\n  fi\nfi\n\nif [ -z \"$FOUND_PY\" ]; then\n  cat >&2 <<EOF\n[_python-hook.sh] ERROR: No Python >= ${MIN_MAJOR}.${MIN_MINOR} found.\nceo-orchestration hooks require Python ${MIN_MAJOR}.${MIN_MINOR}+. Install one:\n\n  macOS:   brew install python@3.12\n  Ubuntu:  sudo apt install python3.12\n  Fedora:  sudo dnf install python3.12\n\nAfter installing, restart your shell so the PATH picks up the new interpreter.\nEOF\n  # Fail-open: emit a permissive decision so the user session isn't bricked\n  # if Python is missing. The governance hook degrades gracefully.\n  echo '{}'  # schema-compliant allow\n  exit 0\nfi\n\n# First positional arg is the hook script name (relative to this dir).\nHOOKS_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")\" && pwd -P)\"\nif [ $# -lt 1 ]; then\n  echo \"[_python-hook.sh] ERROR: missing hook script name\" >&2\n  echo '{}'  # schema-compliant allow\n  exit 0\nfi\n\nHOOK_SCRIPT=\"$HOOKS_DIR/$1\"\nshift\n\nif [ ! -f \"$HOOK_SCRIPT\" ]; then\n  echo \"[_python-hook.sh] ERROR: hook not found: $HOOK_SCRIPT\" >&2\n  echo '{}'  # schema-compliant allow\n  exit 0\nfi\n\n# ---------------------------------------------------------------------------\n# PLAN-156 Wave 2 (SENT-GK-A) — decision→exit chokepoint.\n#\n# ## Why the shim owns this\n#\n# Grok Build's PreToolUse contract (grok 0.2.93) and Codex's both key a\n# deny on **exit 2** in addition to the stdout JSON (probes:\n# PLAN-156/artifacts/characterization-grok-codex-S269.md). Before this\n# block, deny-emit and process-exit were DECOUPLED: `write_decision` only\n# wrote stdout and the shim `exec`'d the hook, so the hook's own exit 0\n# became the process exit — a correct deny could still fail OPEN on a\n# host that keys on the code. The mapping cannot live in Python (an\n# interpreter crash / ImportError / signal never reaches Python), so it\n# lives HERE: the single path every registered hook routes through.\n#\n# ## The rule: decision-derived, never exit-code-derived\n#\n#   emitted deny          -> exit 2   (a decision was made: enforce it)\n#   emitted allow / {}    -> exit 0\n#   crashed, NO decision  -> hook's own rc (fail-OPEN: the INFRASTRUCTURE\n#                                     half of CLAUDE.md §4 — a missing\n#                                     file, an ImportError, a timeout\n#                                     must never block the user session)\n#\n# Reading the DECISION rather than the hook's exit code is what keeps\n# those two apart: an input-class deny (a security matcher emitting a\n# structured deny on a payload it cannot parse — the codex.py coherence\n# gate pattern) exits 2, while a bare interpreter crash with no decision\n# on stdout keeps its own (fail-open) code. A blanket \"nonzero -> deny\"\n# remap would break the fail-open half and is explicitly NOT what this does.\n#\n# ## ADAPTER-AWARE: gated on CEO_HOOK_ADAPTER=grok (debate C14, per lacuna (h))\n#\n# The plan's Wave-2 conditional: \"UNCONDITIONAL mapping SAFE iff Wave-0\n# lacuna (h) confirms exit 2 is INERT on Codex; if not, the mapping is\n# adapter-aware.\" Lacuna (h) found exit 2 is NOT inert on Codex — it is an\n# ACTIVE deny on PreToolUse (probe P9a). So the plan's own fork selects the\n# adapter-aware branch: gate on grok, leave Claude/Codex byte-identical.\n#\n# This is not a weakening. On EVERY host the stdout JSON decision blocks on\n# its own (grok P2, codex JSON-deny, claude JSON-block); the exit code is\n# belt-and-suspenders. Remapping deny->2 on Codex/Claude would only change\n# an observable exit code with no enforcement gain, while breaking every\n# existing test that pins \"deny -> exit 0\" — a large blast radius for zero\n# security benefit. The grok gate keeps the value (a future grok release\n# that tightens the docs.x.ai \"deny REQUIRES exit 2\" rule is covered) where\n# it belongs.\n#\n# R-SEC2 (unset adapter under grok → fail-open) is NOT solved by an\n# unconditional EXIT map anyway: on grok a `block` with exit 2 STILL\n# fail-opens (P5 — malformed output beats the exit code). It is solved by\n# (1) the grok registration always setting CEO_HOOK_ADAPTER=grok — exactly\n# as codex sets =codex — and (2) the CI test asserting every registration\n# routes through this shim (hooks/tests/test_exit2_chokepoint.py). A named\n# residual, identical in kind to the codex one.\n#\n# ## What this block does NOT do\n#\n# It does NOT rewrite the decision vocabulary here — the grok block->deny\n# rewrite below (also grok-gated) is the ESSENTIAL fix, because grok\n# fail-OPENs on `{\"decision\":\"block\"}` EVEN WITH exit 2 (probe P5). This\n# exit map is the secondary half; the meta-test asserts BOTH.\n#\n# CEO_HOOK_EXIT_MAP=0 disables the mapping (escape hatch if a future grok\n# release turns exit-2-hostile; the arming check surfaces the override).\n\n# The grok path has TWO halves with DIFFERENT disable semantics:\n#   - vocabulary rewrite (block->deny): the ESSENTIAL grok fix — a `block`\n#     fail-OPENs on grok (P4/P5). NOT disableable by CEO_HOOK_EXIT_MAP.\n#   - exit-2 mapping (deny->exit 2): belt-and-suspenders. CEO_HOOK_EXIT_MAP=0\n#     turns this off (a future grok release that makes exit-2 hostile).\n# Both fire ONLY under CEO_HOOK_ADAPTER=grok on a BLOCKING event; every other\n# path preserves the historical exec byte-for-byte (Claude/Codex unchanged).\n_CEO_GROK_PATH=0\nif [ \"${CEO_HOOK_ADAPTER:-}\" = \"grok\" ]; then\n  _CEO_GROK_PATH=1\nfi\n\n# Event source: under grok, GROK_HOOK_EVENT is the AUTHORITATIVE source (grok\n# sets it). Pair-rail S269 finding #4: a generic\n# `${CLAUDE_HOOK_EVENT:-${GROK_HOOK_EVENT:-…}}` precedence lets a stale/injected\n# CLAUDE_HOOK_EVENT=post_tool_use mislabel a real grok pre_tool_use as passive\n# and DISABLE the chokepoint (grok then fail-opens). Since this whole block is\n# already gated on CEO_HOOK_ADAPTER=grok, read grok's own var first.\n_CEO_EVENT=\"${GROK_HOOK_EVENT:-${CLAUDE_HOOK_EVENT:-${CODEX_HOOK_EVENT:-}}}\"\n_CEO_BLOCKING_EVENT=1\ncase \"$_CEO_EVENT\" in\n  # Passive events (grok spells them snake_case). A passive hook can never\n  # block on grok, so neither the rewrite nor the exit map should touch it.\n  post_tool_use|post_tool_use_failure|session_start|session_end|\\\n  notification|pre_compact|post_compact|subagent_start|subagent_stop|\\\n  permission_denied|stop_failure|stop)\n    _CEO_BLOCKING_EVENT=0\n    ;;\nesac\n\n# Registered hooks have invocation deadlines: exit must leave spool work pending.\nexport CEO_HOOK_BOUNDED_EXIT=1\n\nif [ \"$_CEO_GROK_PATH\" -eq 0 ] || [ \"$_CEO_BLOCKING_EVENT\" -eq 0 ]; then\n  # Not the grok blocking path (Claude/Codex byte-identical to the historical\n  # shim), or a passive grok event: preserve the historical exec (zero added\n  # latency; exit = the hook's own).\n  exec \"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\"\nfi\n\n# Blocking event: capture stdout so the decision can drive the exit code.\n# stderr passes through untouched (breadcrumbs stay visible to the host).\n# `set -e` must not kill us on a nonzero hook exit — we inspect it.\nset +e\n_CEO_HOOK_STDOUT=\"$(\"$FOUND_PY\" \"$HOOK_SCRIPT\" \"$@\")\"\n_CEO_HOOK_RC=$?\nset -e\n\n# --- grok vocabulary backstop (probe P5) ------------------------------------\n#\n# Hooks that route their egress through `_lib/adapters/resolve()` already\n# emit `deny` under CEO_HOOK_ADAPTER=grok (grok.py:write_decision). But a\n# LEGACY hook that hardcodes the Claude vocabulary — today\n# `check_codex_filewrite.py`, which json.dumps `{\"decision\": \"block\"}`\n# directly (lines 275/294/356) — would emit a word grok does not know.\n# On grok that is malformed output = hook failure = **fail-OPEN, even\n# with exit 2** (P5). Re-routing that hook through this shim (PLAN-156\n# Wave 2 settings edit) gives it the exit mapping but NOT the vocabulary,\n# so the shim translates here as well: one chokepoint owns BOTH halves,\n# and any future hook that forgets the adapter seam degrades to a correct\n# deny instead of a silent allow.\n#\n# We are guaranteed here to be on the grok blocking path. Rewrite block→deny\n# with a WHITESPACE-TOLERANT regex (pair-rail S269 finding #3): the two\n# fixed-string substitutions only matched json.dumps's exact spacing\n# (`\"decision\": \"block\"` and `\"decision\":\"block\"`), so a hook emitting\n# `\"decision\" : \"block\"` (space before the colon) would slip through and\n# grok would fail-OPEN. `[[:space:]]*` around the colon covers any spacing.\n# sed is one cheap subprocess on the (rare) blocking path — acceptable vs a\n# silent-allow on an unusual-but-valid deny shape.\nif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n  _CEO_HOOK_STDOUT=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" \\\n    | sed -E 's/\"decision\"[[:space:]]*:[[:space:]]*\"block\"/\"decision\": \"deny\"/g')\"\nfi\n\n# NOTE (pair-rail R1 P1, S272): stdout is emitted AFTER the decision parse\n# below, not here. On grok the JSON on stdout is the PRIMARY block; emitting a\n# malformed deny-bearing payload first hands grok garbage (it fails open on it)\n# and leaves only the secondary exit-2 rail — turning the belt-and-suspenders\n# design into a single strap. The parse block decides, then emits: verbatim on\n# every normal path, and a well-formed `{\"decision\":\"deny\"}` when the payload\n# is unparseable BUT carries a deny token.\n\n# Exit-2 mapping (belt-and-suspenders; CEO_HOOK_EXIT_MAP=0 disables JUST this\n# half, never the vocabulary rewrite above). After the rewrite the only deny\n# vocabulary on stdout is grok's `deny` (or a codex-shaped permissionDecision\n# from a legacy hook that also routed here).\n#\n# F6 (PLAN-156-FOLLOWUP, consensus C5 — security-VETO direction): the original\n# mapping was an order-sensitive whole-stdout case glob\n# (*'\"decision\"'*'\"deny\"'*), which mis-fires BOTH ways: an ALLOW payload whose\n# other fields merely QUOTE a deny shape exited 2 (spurious block — the S270\n# live-fire finding), and a first-occurrence variant would let a decoy nested\n# `\"decision\":\"allow\"` mask a real top-level deny. Replaced with a STRUCTURAL\n# parse of the TOP-LEVEL `decision` / `hookSpecificOutput.permissionDecision`\n# via the already-resolved $FOUND_PY (one extra subprocess on the rare\n# blocking path — cost accepted by the debate).\n#\n# Dual fail-direction semantics (NEVER \"nonzero -> deny\"):\n#   parse OK      -> the FIELD governs: deny -> exit 2, anything else -> the\n#                    hook's own rc below.\n#   parse FAILURE -> deny token ('\"deny\"') present on stdout -> exit 2\n#                    (fail-CLOSED: content the mapper cannot parse is never\n#                    waved through when it may carry a real deny — the\n#                    CLAUDE.md §4 INPUT half);\n#                 -> no deny token -> the hook's own rc below (the\n#                    INFRASTRUCTURE fail-open half, preserved: a crash or\n#                    garbage with no decision never blocks the session).\n# A crash with EMPTY stdout skips this block entirely -> hook rc (fail-open).\nif [ \"${CEO_HOOK_EXIT_MAP:-1}\" = \"1\" ] && [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n  _CEO_DECISION=\"$(printf '%s' \"$_CEO_HOOK_STDOUT\" | \"$FOUND_PY\" -c '\nimport json, sys\n\ntry:\n    obj = json.load(sys.stdin)\nexcept Exception:\n    print(\"__CEO_PARSE_FAILURE__\")\n    raise SystemExit(0)\ndecision = \"\"\nif isinstance(obj, dict):\n    d = obj.get(\"decision\")\n    if isinstance(d, str):\n        decision = d\n    else:\n        hso = obj.get(\"hookSpecificOutput\")\n        if isinstance(hso, dict):\n            pd = hso.get(\"permissionDecision\")\n            if isinstance(pd, str):\n                decision = pd\nprint(decision)\n' 2>/dev/null)\" || _CEO_DECISION=\"__CEO_PARSE_FAILURE__\"\n  case \"$_CEO_DECISION\" in\n    deny)\n      # Structural top-level deny — emit the (valid) payload so the PRIMARY\n      # stdout rail blocks, then enforce the secondary exit-2 rail.\n      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n      exit 2\n      ;;\n    __CEO_PARSE_FAILURE__)\n      # Sentinel also covers the parser subprocess itself failing to spawn:\n      # that infra failure degrades to the token scan, never to a silent allow\n      # of a deny-bearing payload.\n      case \"$_CEO_HOOK_STDOUT\" in\n        *'\"deny\"'*)\n          # Unparseable BUT deny-bearing: emitting the garbage would fail OPEN\n          # on grok's primary rail. Emit a well-formed deny instead — both\n          # rails now block. The original payload is preserved on stderr for\n          # forensics (stderr never feeds the decision).\n          printf '%s\\n' \"$_CEO_HOOK_STDOUT\" >&2\n          printf '%s\\n' '{\"decision\": \"deny\", \"reason\": \"hook emitted an unparseable deny-bearing payload; blocked fail-CLOSED by _python-hook.sh (original payload on stderr)\"}'\n          exit 2\n          ;;\n      esac\n      # Unparseable and NO deny token: emit verbatim (a malformed allow is the\n      # hook's own business) and fall through to its rc — INFRASTRUCTURE\n      # fail-open half, preserved.\n      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n      ;;\n    *)\n      # Parsed, not a deny (allow / ask / absent) — emit verbatim.\n      printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\n      ;;\n  esac\nelif [ -n \"$_CEO_HOOK_STDOUT\" ]; then\n  # Exit-map disabled (CEO_HOOK_EXIT_MAP=0): the vocabulary rewrite above still\n  # ran; emit the hook's stdout unchanged — the JSON rail is on its own.\n  printf '%s\\n' \"$_CEO_HOOK_STDOUT\"\nfi\n\nexit \"$_CEO_HOOK_RC\"\n","numLines":549,"startLine":1,"totalLines":549}},"tool_result_meta":[{"id":"toolu_01NVuVfL2wnLWL9rt4xTu1Hd","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch79MaSyzLoPJEdaz4a9M","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_018Khun3FHvpFraBHt7f8tWb","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_agent_spawn.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5028,"cache_read_input_tokens":105779,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5028},"output_tokens":3,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"8cef102d-797b-4c53-bdf1-cad3bbce02d5","timestamp":"2026-11-16T19:17:40.196Z","request_id":"req_011Ch79MaD6LmLSUcv94pQSP","wire_tool_inputs":{"toolu_018Khun3FHvpFraBHt7f8tWb":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_agent_spawn.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018Khun3FHvpFraBHt7f8tWb","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Governance Hook: named agents MUST include ## SKILL CONTENT.\n3\t\n4\tRegistered in `.claude/settings.json` under `hooks.PreToolUse.Agent`.\n5\tRuns via the `_python-hook.sh` shim (A.4) for Python version resolution.\n6\t\n7\tPort of `.claude/hooks/check-agent-spawn.sh` with:\n8\t- stdlib-only (no jq dependency)\n9\t- unit-testable (logic is in `decide()`, not tangled with stdin/stdout)\n10\t- fail-open on any internal error (never blocks the user on infrastructure bug)\n11\t\n12\t## Two detection strategies\n13\t\n14\t1. The agent's `description` field contains a team member name, extracted\n15\t   dynamically from team.md / frontend-team.md / domains/*/team-personas.md.\n16\t2. The prompt contains a persona header (`PERSONA:`, `## AGENT PROFILE`,\n17\t   `## PERSONA`) — self-describing spawn.\n18\t\n19\tIf either strategy matches, the prompt MUST contain `## SKILL CONTENT`.\n20\tWithout it, the spawn is blocked as a generic agent wearing a name tag.\n21\t\n22\tThe extracted agent_spawn.skill_reference helpers also validate references to\n23\tSKILL.md files under .claude/skills; this hook still guards that skill surface.\n24\t\n25\t## Output contract\n26\t\n27\tWrites a single-line JSON decision to stdout:\n28\t\n29\t    {\"decision\":\"allow\"}\n30\t    {\"decision\":\"block\",\"reason\":\"GOVERNANCE: ...\"}\n31\t\n32\tExit code is 0 in both cases — Claude Code reads the decision from stdout,\n33\tnot the exit code. Internal errors (bad stdin, missing team files, etc.)\n34\tare logged to stderr and the spawn is allowed (fail-open).\n35\t\"\"\"\n36\t\n37\tfrom __future__ import annotations\n38\t\n39\timport hashlib\n40\timport json\n41\timport os\n42\timport re\n43\timport sys\n44\timport unicodedata\n45\tfrom dataclasses import dataclass\n46\tfrom pathlib import Path\n47\tfrom typing import Any, Dict, List, Optional, Tuple\n48\t\n49\t# Make the _lib package importable — hooks live in .claude/hooks/ and\n50\t# _lib is a sibling package; delegated skill-reference guards cover .claude/skills/**/SKILL.md.\n51\t_HOOKS_DIR = Path(__file__).resolve().parent\n52\tif str(_HOOKS_DIR) not in sys.path:\n53\t    sys.path.insert(0, str(_HOOKS_DIR))\n54\t\n55\tfrom _lib import contract as _contract  # noqa: E402\n56\tfrom _lib.adapters import claude as _claude_adapter  # noqa: E402\n57\tfrom _lib import team as _team  # noqa: E402\n58\tfrom _lib import redact as _redact  # noqa: E402  (PLAN-020 Phase 2: skill-ref scan)\n59\t\n60\t# PLAN-106 Wave G.1 — sub-agent N-of-M aggregator with partial-drop emit.\n61\t# Re-exported below as `aggregate_subagent_findings` so coordinator-side\n62\t# callers (swarm coordinator, future debate consensus aggregator) can\n63\t# `from check_agent_spawn import aggregate_subagent_findings` without\n64\t# poking into `_lib`. Closes AC10 grep contract.\n65\tfrom _lib import subagent_dispatch as _subagent_dispatch  # noqa: E402\n66\t\n67\t# PLAN-045 Wave 1 P0-03 — VETO floor runtime validator.\n68\ttry:\n69\t    from _lib import agent_frontmatter as _agent_frontmatter\n70\texcept Exception:  # pragma: no cover\n71\t    _agent_frontmatter = None  # type: ignore[assignment]\n72\t\n73\t# Optional: emit veto_triggered to event stream v2 (fail-open)\n74\ttry:\n75\t    # PLAN-094 Wave E — lazy-import dispatch shim closes AC9c spawn-hook regression\n76\t    from _lib import audit_emit_dispatch as _audit_emit  # noqa: E402\n77\t    _AUDIT_EMIT_AVAILABLE = True\n78\texcept Exception:  # pragma: no cover\n79\t    _AUDIT_EMIT_AVAILABLE = False\n80\t\n81\t# PLAN-092 Wave A.4 — cookbook-advisor pattern matcher (fail-open import).\n82\ttry:\n83\t    from _lib import cookbook_patterns as _cookbook_patterns  # noqa: E402\n84\t    _COOKBOOK_PATTERNS_AVAILABLE = True\n85\texcept Exception:  # pragma: no cover\n86\t    _COOKBOOK_PATTERNS_AVAILABLE = False\n87\t\n88\t# PLAN-112-FOLLOWUP-persona-routing-wire W1 — persona_routing matrix\n89\t# consult (fail-open import). The god-mode (persona × primitive) routing\n90\t# matrix declares AUTO-05 (\"model_routing_advised\") ENFORCING per\n91\t# ADR-118-AMEND-1, but check_agent_spawn never consulted it — the policy\n92\t# was dead at runtime. This wire makes the matrix observable/auditable.\n93\t# CONSULT + AUDIT ONLY — the BLOCK is DEFERRED (the hook payload exposes\n94\t# no requested-model signal; see plan §2/§3). NEVER read\n95\t# `_PRIMITIVE_DEFAULT_MODE` directly — get_mode() encapsulates the\n96\t# kill-switch demotion.\n97\ttry:\n98\t    from _lib import persona_routing as _persona_routing  # noqa: E402\n99\texcept Exception:  # pragma: no cover - fail-open\n100\t    _persona_routing = None  # type: ignore[assignment]\n101\t\n102\t# PLAN-113 WIRE-DEADMOD — SEC-P0-01 spec-context sanitizer (ADR-089).\n103\t# Sanitizes the ## SPEC CONTEXT block payload in spawn prompts before allow.\n104\t# ADVISORY telemetry only: sanitize result is emitted via emit_generic so\n105\t# sentinel violations / truncation are visible in the audit log. Never blocks.\n106\t# Fail-open: missing module → _SPEC_CTX_SANITIZER_AVAILABLE = False.\n107\ttry:\n108\t    from _lib import spec_context_sanitizer as _spec_ctx_sanitizer  # noqa: E402\n109\t    _SPEC_CTX_SANITIZER_AVAILABLE = True\n110\texcept Exception:  # pragma: no cover - fail-open\n111\t    _spec_ctx_sanitizer = None  # type: ignore[assignment]\n112\t    _SPEC_CTX_SANITIZER_AVAILABLE = False\n113\t\n114\t# PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n115\t# Classifies the spawn action type and emits a spawn_confidence_advisory event\n116\t# so that recommender / receipt formatter surfaces have a hook-level signal.\n117\t# ADVISORY only — never blocks. Fail-open.\n118\ttry:\n119\t    from _lib import confidence_labels as _confidence_labels  # noqa: E402\n120\t    _CONFIDENCE_LABELS_AVAILABLE = True\n121\texcept Exception:  # pragma: no cover - fail-open\n122\t    _confidence_labels = None  # type: ignore[assignment]\n123\t    _CONFIDENCE_LABELS_AVAILABLE = False\n124\t\n125\t# Components bind to the facade to preserve patched globals and isolated state.\n126\tdef _load_spawn_part(name):\n127\t    try:\n128\t        from _lib._audit_emit_parts import install\n129\t        install(globals(), (name,), package=\"_lib.agent_spawn\")\n130\t    except Exception as exc:\n131\t        if __name__ != \"__main__\":\n132\t            raise\n133\t        print(f\"[check_agent_spawn] FATAL: {type(exc).__name__}: {exc}\", file=sys.stderr)\n134\t        print(json.dumps({}))\n135\t        sys.exit(0)\n136\t\n137\t_load_spawn_part(\"model_routing\")\n138\t_load_spawn_part(\"advisories\")\n139\t_load_spawn_part(\"prompt_rules\")\n140\t\n141\t@dataclass\n142\tclass Decision:\n143\t    \"\"\"Typed result of the governance check.\"\"\"\n144\t\n145\t    allow: bool\n146\t    reason: Optional[str] = None\n147\t\n148\t    def to_json(self) -> str:\n149\t        if self.allow:\n150\t            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow\n151\t        return json.dumps(\n152\t            {\"decision\": \"block\", \"reason\": self.reason or \"\"},\n153\t            ensure_ascii=False,\n154\t        )\n155\t\n156\t\n157\t\n158\tdef _emit_cookbook_pattern_advisory(\n159\t    *,\n160\t    description: str,\n161\t    prompt: str,\n162\t    env=None,\n163\t) -> None:\n164\t    \"\"\"PLAN-092 Wave A.4 (W3.2 SEMI-11) — emit cookbook_pattern_advised\n165\t    when a spawn prompt matches one of 4 Anthropic Cookbook pattern\n166\t    trigger taxonomies (COOK-P1..P4).\n167\t\n168\t    Advisory ONLY — UX hint. NEVER blocks, NEVER mutates tool_input.\n169\t    Rate-cap via PLAN-088 global _plan088_rate_admit in audit_emit.\n170\t    Kill-switch: CEO_COOKBOOK_ADVISOR_ENABLED=0. Privacy invariant:\n171\t    3 fields max (no raw prompt persisted — AC3b).\n172\t\n173\t    Audit-emit signature mapping (PLAN-090 W3.2 canonical contract):\n174\t      pattern_id (COOK-P*)   -> top_pattern_keys\n175\t      trigger_class (string) -> task_signature (enum-constrained \"other\")\n176\t      bucket (high/med/low)  -> pattern_count (3/2/1)\n177\t\n178\t    NEVER raises.\n179\t    \"\"\"\n180\t    try:\n181\t        src_env = env if env is not None else os.environ\n182\t        if not _COOKBOOK_PATTERNS_AVAILABLE:\n183\t            return\n184\t        if not _AUDIT_EMIT_AVAILABLE:\n185\t            return\n186\t        # Kill-switch\n187\t        try:\n188\t            if hasattr(_cookbook_patterns, \"kill_switch_enabled\"):\n189\t                if not _cookbook_patterns.kill_switch_enabled():\n190\t                    return\n191\t            else:\n192\t                val = (src_env.get(\"CEO_COOKBOOK_ADVISOR_ENABLED\") or \"1\").strip()\n193\t                if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n194\t                    return\n195\t        except Exception:  # pragma: no cover\n196\t            return\n197\t        # Concat description + prompt, cap at 8KiB\n198\t        text = ((description or \"\") + \"\\n\" + (prompt or \"\"))[: 8 * 1024]\n199\t        if not text.strip():\n200\t            return\n201\t        # Match (first-hit canonical order COOK-P1 -> P4)\n202\t        try:\n203\t            result = _cookbook_patterns.match_pattern(text)\n204\t        except Exception:  # pragma: no cover\n205\t            return\n206\t        if result is None:\n207\t            return\n208\t        pattern_id, trigger_class, bucket = result\n209\t        if not hasattr(_audit_emit, \"emit_cookbook_pattern_advised\"):\n210\t            return\n211\t        # Map semantic -> canonical signature\n212\t        bucket_to_count = {\"high\": 3, \"medium\": 2, \"low\": 1}\n213\t        try:\n214\t            _audit_emit.emit_cookbook_pattern_advised(\n215\t                task_signature=\"other\",\n216\t                top_pattern_keys=str(pattern_id)[:128],\n217\t                pattern_count=bucket_to_count.get(str(bucket), 1),\n218\t            )\n219\t        except Exception:  # pragma: no cover\n220\t            return\n221\t    except Exception:  # pragma: no cover - fail-open invariant\n222\t        return\n223\t\n224\t\n225\t# ---------------------------------------------------------------------------\n226\t# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [END]\n227\t# ---------------------------------------------------------------------------\n228\t\n229\tdef decide(\n230\t    *,\n231\t    description: str,\n232\t    prompt: str,\n233\t    names_regex,\n234\t    env: Optional[dict] = None,\n235\t    subagent_type: str = \"\",\n236\t) -> Decision:\n237\t    \"\"\"Pure decision function — no I/O, trivially unit-testable.\n238\t\n239\t    Args:\n240\t        description: The Agent tool's `description` field.\n241\t        prompt: The Agent tool's `prompt` field.\n242\t        names_regex: A compiled regex matching team member names, or None\n243\t            if no team files were found (degrades to header-only detection).\n244\t        env: Environment-var dict (defaults to os.environ). Used to read\n245\t            CEO_ARCHITECT_ACTIVE for the recursion guard (Sprint 5 ADR-010).\n246\t        subagent_type: Agent tool ``subagent_type`` field (PLAN-078 Wave 1\n247\t            telemetry). Used to identify archetype for model-routing\n248\t            advisory emit; never affects the allow/block decision.\n249\t\n250\t    Returns:\n251\t        Decision(allow=True) if the spawn is fine.\n252\t        Decision(allow=False, reason=...) if governance requires blocking.\n253\t    \"\"\"\n254\t    src_env = env if env is not None else os.environ\n255\t\n256\t    # PLAN-133 E3 — resolve session id once for the spawn-rails (depth/overlap).\n257\t    _e3_session_id = _resolve_session_id_from_env(src_env)\n258\t\n259\t    # PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n260\t    # payload (advisory telemetry; never blocks). Runs early so sentinel\n261\t    # violations are logged before any governance decision. Fail-open.\n262\t    _sanitize_spec_context_advisory(prompt or \"\", env=src_env)\n263\t\n264\t    # PLAN-133 A2 (Goose-harvest) — fail-CLOSED invisible-unicode guard.\n265\t    # Default-OFF (CEO_UNICODE_HARDBLOCK=1 enforces); when enforced, a spawn\n266\t    # prompt carrying control / bidi / zero-width / U+E0000-E007F Tag-block\n267\t    # chars is BLOCKED here, BEFORE any LLM/debate/governance review. The\n268\t    # breadcrumb (invisible_unicode_blocked) is emitted on both the advisory\n269\t    # and enforced paths so the measure-first denominator is real. Fail-open.\n270\t    _uni_block = _enforce_spec_context_unicode(prompt or \"\", env=src_env)\n271\t    if _uni_block is not None:\n272\t        return Decision(allow=False, reason=_uni_block)\n273\t\n274\t    # Session 75 Codex Finding 4 closure: scan spawn prompt for\n275\t    # leaked secrets when Owner-opted-in via CEO_SPAWN_SECRET_SCAN=1.\n276\t    # Default OFF; without the env var, _validate_spawn_prompt_has_no_secrets\n277\t    # short-circuits to ok=True so legacy spawns are unaffected.\n278\t    _scan_ok, _scan_code, _scan_detail = _validate_spawn_prompt_has_no_secrets(prompt)\n279\t    if not _scan_ok:\n280\t        return Decision(\n281\t            allow=False,\n282\t            reason=(\n283\t                f\"SPAWN-SECRET-BLOCKED: {_scan_code} ({_scan_detail}). \"\n284\t                \"To bypass once: unset CEO_SPAWN_SECRET_SCAN.\"\n285\t            ),\n286\t        )\n287\t\n288\t    # PLAN-045 Wave 1 P0-03 — VETO floor runtime check.\n289\t    # If the spawn targets a VETO-floor role (code-reviewer,\n290\t    # security-engineer), verify the agent frontmatter still binds\n291\t    # them to Opus. Closes F-01-03 demotion-via-frontmatter attack.\n292\t    # Skipped when the validator lib is missing (defense-in-depth\n293\t    # fail-open; arbitration kernel still blocks agents/*.md edits).\n294\t    if _agent_frontmatter is not None:\n295\t        agents_dir = Path(\n296\t            src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n297\t        ) / \".claude\" / \"agents\"\n298\t        haystack_lower = \" \".join([\n299\t            (description or \"\").lower(), (prompt or \"\").lower()\n300\t        ])\n301\t        for _role in sorted(_agent_frontmatter.VETO_FLOOR_ROLES):\n302\t            if _role.lower() not in haystack_lower:\n303\t                continue\n304\t            ok, reason = _agent_frontmatter.check_veto_floor_for_role(\n305\t                _role, agents_dir\n306\t            )\n307\t            if not ok and reason != \"not_veto_role\":\n308\t                return Decision(\n309\t                    allow=False,\n310\t                    reason=(\n311\t                        f\"GOVERNANCE: veto_floor_demoted: role={_role} \"\n312\t                        f\"reason={reason}. The VETO floor requires \"\n313\t                        \"security-engineer and code-reviewer to bind to a \"\n314\t                        \"member of VETO_FLOOR_ALLOWED (agent_frontmatter.py) \"\n315\t                        \"- the enforcement is set membership, not one id. \"\n316\t                        \"See ADR-052 + PLAN-045 Wave 1 P0-03; PLAN-169 W2.10 D2.\"\n317\t                    ),\n318\t                )\n319\t\n320\t    # PLAN-078 Wave 1 — model routing advisory telemetry (advisory-only).\n321\t    # Runs AFTER VETO-floor enforcement so the hard-block path remains\n322\t    # authoritative. Emits `model_routing_advised` event when a spawn\n323\t    # archetype is identifiable. NEVER mutates tool_input. NEVER blocks.\n324\t    # Bypass: `CEO_MODEL_ROUTING=0`.\n325\t    _emit_model_routing_advisory(\n326\t        description=description or \"\",\n327\t        prompt=prompt or \"\",\n328\t        subagent_type=subagent_type or \"\",\n329\t        env=src_env,\n330\t        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n331\t    )\n332\t\n333\t    # PLAN-112-FOLLOWUP-persona-routing-wire W1 — god-mode matrix consult.\n334\t    # Runs AFTER the VETO-floor hard-block (above) so it never masks it.\n335\t    # CONSULT + AUDIT ONLY — emits model_routing_enforced /\n336\t    # model_routing_eval_error; NEVER blocks (block deferred, see W3 above).\n337\t    # Mode is read off authoritative subagent_type only.\n338\t    _consult_model_routing_mode(\n339\t        description=description or \"\",\n340\t        prompt=prompt or \"\",\n341\t        subagent_type=subagent_type or \"\",\n342\t        env=src_env,\n343\t        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n344\t    )\n345\t\n346\t    # PLAN-091 Wave A.4 (W3.1) — MCP routing advisory.\n347\t    # Maps archetype → mcp_routing task_class; resolver emits\n348\t    # `mcp_route_advised` (PLAN-086 Wave D). Bypass: CEO_MCP_ROUTING_HOOK=0.\n349\t    _emit_mcp_routing_advisory(\n350\t        description=description or \"\",\n351\t        prompt=prompt or \"\",\n352\t        subagent_type=subagent_type or \"\",\n353\t        env=src_env,\n354\t    )\n355\t\n356\t    # PLAN-091 Wave A.5 (W3.3) — specialization promotion heuristic.\n357\t    # When general-purpose spawn matches a specialist hint, emit\n358\t    # `specialization_promoted` advisory. NEVER auto-spawns.\n359\t    # Bypass: CEO_PROMOTION_HEURISTIC=0.\n360\t    _emit_promotion_advisory(\n361\t        description=description or \"\",\n362\t        prompt=prompt or \"\",\n363\t        subagent_type=subagent_type or \"\",\n364\t        env=src_env,\n365\t    )\n366\t\n367\t    # PLAN-092 Wave A.4 (W3.2 SEMI-11) — cookbook-advisor pattern hint.\n368\t    # Matches spawn against 4 Anthropic Cookbook patterns (COOK-P1..P4);\n369\t    # emits `cookbook_pattern_advised` advisory. Kill-switch:\n370\t    # CEO_COOKBOOK_ADVISOR_ENABLED=0. NEVER mutates tool_input.\n371\t    _emit_cookbook_pattern_advisory(\n372\t        description=description or \"\",\n373\t        prompt=prompt or \"\",\n374\t        env=src_env,\n375\t    )\n376\t\n377\t    # PLAN-098 Wave C.2 (ADR-132) — GOAP advisory-only invariant.\n378\t    # PLAN-105 Wave A.6 — capture intent for deferred-emit at allow-return.\n379\t    _goap_intent_plan_id: Optional[str] = None\n380\t    _goap_intent_action_id: Optional[str] = None\n381\t    if _GOAP_PLAN_ID_RE.search(prompt or \"\"):\n382\t        owner_confirmed_env = (src_env.get(\"CEO_GOAP_CONFIRMED\") or \"\").strip() == \"1\"\n383\t        has_goap_confirm_block = bool(_GOAP_CONFIRM_HEADER_RE.search(prompt or \"\"))\n384\t        if not (owner_confirmed_env and has_goap_confirm_block):\n385\t            preview = (description or \"\")[:80]\n386\t            missing: List[str] = []\n387\t            if not owner_confirmed_env:\n388\t                missing.append(\"CEO_GOAP_CONFIRMED=1 env\")\n389\t            if not has_goap_confirm_block:\n390\t                missing.append(\"## GOAP CONFIRM block\")\n391\t            return Decision(\n392\t                allow=False,\n393\t                reason=(\n394\t                    \"GOVERNANCE: goap_advisory_without_owner_confirm: \"\n395\t                    f\"spawn references a GOAP plan (description={preview!r}) \"\n396\t                    f\"but lacks: {', '.join(missing)}. The GOAP planner is \"\n397\t                    \"advisory-only - the Owner must physically confirm each \"\n398\t                    \"action before spawn. See ADR-132 Decision Part 2.\"\n399\t                ),\n400\t            )\n401\t        # PLAN-105 Wave A.6 — GOAP gates passed; record intent for deferred emit.\n402\t        _pid_m = _GOAP_PLAN_ID_VALUE_RE.search(prompt or \"\")\n403\t        _aid_m = _GOAP_ACTION_ID_VALUE_RE.search(prompt or \"\")\n404\t        if _pid_m is not None:\n405\t            _goap_intent_plan_id = _pid_m.group(1).strip()[:32]\n406\t            if _aid_m is not None:\n407\t                _goap_intent_action_id = _aid_m.group(1).strip()[:64]\n408\t\n409\t    # Recursion guard (ADR-010): block Architect-spawning-Architect.\n410\t    architect_active = (src_env.get(\"CEO_ARCHITECT_ACTIVE\") or \"\").strip()\n411\t    if architect_active == \"1\":\n412\t        haystack = \" \".join([description or \"\", prompt or \"\"])\n413\t        if _ARCHITECT_NAME_RE.search(haystack):\n414\t            return Decision(\n415\t                allow=False,\n416\t                reason=(\n417\t                    \"ARCHITECT-RECURSION: a spawn naming 'Agent Architect' \"\n418\t                    \"was detected while CEO_ARCHITECT_ACTIVE=1. The Agent \"\n419\t                    \"Architect must not spawn another instance of itself \"\n420\t                    \"within the same session. See ADR-010.\"\n421\t                ),\n422\t            )\n423\t\n424\t    # PLAN-020 Phase 3 — /effort scope clause (QA must-fix #7): /effort\n425\t    # hints are CEO-only. Spawn prompts MUST NOT include them.\n426\t    if _has_effort_token(prompt or \"\"):\n427\t        return Decision(\n428\t            allow=False,\n429\t            reason=(\n430\t                \"GOVERNANCE: spawn prompt contains a `/effort` token. \"\n431\t                \"Effort hints are CEO-only — sub-agents inherit Anthropic \"\n432\t                \"default thinking budget. Strip /effort from the prompt \"\n433\t                \"before retrying. See PLAN-020 §4 Phase 3 scope clause.\"\n434\t            ),\n435\t        )\n436\t\n437\t    desc_matched_name = False\n438\t    if names_regex is not None and description:\n439\t        if names_regex.search(description):\n440\t            desc_matched_name = True\n441\t\n442\t    prompt_has_persona = False\n443\t    if prompt and _PERSONA_HEADER_RE.search(prompt):\n444\t        prompt_has_persona = True\n445\t\n446\t    is_named_spawn = desc_matched_name or prompt_has_persona\n447\t\n448\t    # PLAN-133 E3 — per-spawn tool scoping + depth/overlap rails. ADVISORY by\n449\t    # default (emit-only, enforced=0); BLOCKS only under the per-rail env flag\n450\t    # (CEO_SPAWN_TOOL_SCOPE / CEO_SPAWN_DEPTH_GUARD / CEO_SPAWN_OVERLAP_GUARD).\n451\t    # Runs AFTER the VETO-floor + A2 unicode hard-blocks so those remain\n452\t    # authoritative; runs BEFORE the SKILL CONTENT accept-path so an\n453\t    # out-of-scope / depth-2 / clobbering spawn is rejected even when otherwise\n454\t    # well-formed. Fail-open (returns None on any infra error).\n455\t    _e3_hit = _enforce_spawn_rails(\n456\t        prompt=prompt or \"\",\n457\t        is_named_spawn=is_named_spawn,\n458\t        env=src_env,\n459\t        session_id=_e3_session_id,\n460\t    )\n461\t    if _e3_hit is not None:\n462\t        _e3_code, _e3_detail = _e3_hit\n463\t        return Decision(\n464\t            allow=False,\n465\t            reason=(\n466\t                f\"GOVERNANCE: {_e3_code}: {_e3_detail}. \"\n467\t                \"The spawn violates a PLAN-133 E3 rail (per-spawn tool \"\n468\t                \"allow-list / depth-over-one fence / FILE ASSIGNMENT overlap) \"\n469\t                \"or the ADR-191 FILE ASSIGNMENT grammar (PLAN-178 C1). \"\n470\t                \"Fix for a grammar block: regenerate the prompt via \"\n471\t                \".claude/scripts/inject-agent-context.sh (it always emits \"\n472\t                \"the block). If the block is UNPARSEABLE, REPLACE or \"\n473\t                \"remove the malformed block (the classifier aggregates \"\n474\t                \"ALL blocks — appending a valid one cannot clear an \"\n475\t                \"invalid token's taint); appending `## FILE ASSIGNMENT` \"\n476\t                \"with `- CAN edit: <concrete paths>` or the explicit \"\n477\t                \"read-only form `- CAN edit: NONE-READ-ONLY` works only \"\n478\t                \"for the ABSENT state. Recovery route: \"\n479\t                \"CEO_SOTA_DISABLE=1 forces advisory. See PLAN-133 §E E3 + \"\n480\t                \"ADR-191.\"\n481\t            ),\n482\t        )\n483\t\n484\t    # PLAN-113 WIRE-DEADMOD — confidence_labels advisory (PLAN-083 Wave 1.10).\n485\t    # Emits spawn_confidence_advisory so recommender / receipt formatter have\n486\t    # a hook-level signal. Advisory only — never blocks. Fail-open.\n487\t    _action_type = \"canonical_edit\" if is_named_spawn else \"bash_execute\"\n488\t    _emit_spawn_confidence_advisory(\n489\t        action_type=_action_type,\n490\t        is_named_spawn=is_named_spawn,\n491\t        env=src_env,\n492\t    )\n493\t\n494\t    if not is_named_spawn:\n495\t        # Generic research / simple tasks — no governance requirement.\n496\t        _emit_goap_deferred_outcome(\n497\t            _goap_intent_plan_id, _goap_intent_action_id, src_env\n498\t        )\n499\t        return Decision(allow=True)\n500\t\n501\t    # PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.\n502\t    # NAMED spawns only (scoped here, after the generic early-return, so\n503\t    # unmatched/generic spawns see zero behavior change). Runs BEFORE the\n504\t    # SKILL REFERENCE / SKILL CONTENT accept-paths so an untrusted-content\n505\t    # spawn missing the block is rejected even when otherwise well-formed.\n506\t    # Input fail-CLOSED (matched + missing block => BLOCK); infra fail-OPEN\n507\t    # inside _enforce_prompt_defense. Kill-switches documented at the gate.\n508\t    _pd_hit = _enforce_prompt_defense(\n509\t        description=description or \"\",\n510\t        prompt=prompt or \"\",\n511\t        env=src_env,\n512\t    )\n513\t    if _pd_hit is not None:\n514\t        _pd_code, _pd_detail = _pd_hit\n515\t        return Decision(\n516\t            allow=False,\n517\t            reason=(\n518\t                f\"GOVERNANCE: {_pd_code}: {_pd_detail}. This NAMED spawn's \"\n519\t                \"task indicates contact with untrusted content (WebFetch/\"\n520\t                \"WebSearch/scrape/imported/upstream/third-party), but the \"\n521\t                \"prompt has no `## PROMPT DEFENSE` section with >= 6 bullet \"\n522\t                \"lines. Fix: regenerate the prompt via \"\n523\t                \".claude/scripts/inject-agent-context.sh (it emits the block \"\n524\t                \"unconditionally), or append the 6-bullet anti-injection \"\n525\t                \"block verbatim. See PLAN-153 Wave E item 7 / ADR-175.\"\n526\t            ),\n527\t        )\n528\t\n529\t    # PLAN-020 Phase 2 — Reference path (ADR-051). If `## SKILL REFERENCE`\n530\t    # marker is present, validate strictly (fail-CLOSED). Reference path\n531\t    # opt-in via env var; default ON per Q1 Owner answer.\n532\t    if _is_enabled(\"CEO_SKILL_REFERENCE_MODE\", ENABLE_SKILL_REFERENCE_MODE, src_env):\n533\t        if _SKILL_REFERENCE_HEADER_RE.search(prompt or \"\"):\n534\t            ok, reason_code, detail = _validate_skill_reference(prompt or \"\")\n535\t            if ok:\n536\t                _emit_goap_deferred_outcome(\n537\t                    _goap_intent_plan_id, _goap_intent_action_id, src_env\n538\t                )\n539\t                # PLAN-106 Wave C — persona coverage emit at allow path.\n540\t                _emit_persona_coverage_synthesized(\n541\t                    subagent_type=subagent_type,\n542\t                    description=description,\n543\t                    prompt=prompt,\n544\t                    source=\"dispatch\",\n545\t                    env=src_env,\n546\t                )\n547\t                return Decision(allow=True)\n548\t            preview = (description or \"\")[:80]\n549\t            return Decision(\n550\t                allow=False,\n551\t                reason=(\n552\t                    f\"GOVERNANCE: {reason_code}: {detail}. \"\n553\t                    f\"Spawn rejected (description={preview!r}). \"\n554\t                    \"See ADR-051 §Synchronous validation for sub-check details.\"\n555\t                ),\n556\t            )\n557\t\n558\t    # Named spawn: require real SKILL CONTENT section (P1-SEC-B: bypass-resistant).\n559\t    if _has_skill_content(prompt or \"\"):\n560\t        _emit_goap_deferred_outcome(\n561\t            _goap_intent_plan_id, _goap_intent_action_id, src_env\n562\t        )\n563\t        # PLAN-106 Wave C — persona coverage emit at allow path.\n564\t        _emit_persona_coverage_synthesized(\n565\t            subagent_type=subagent_type,\n566\t            description=description,\n567\t            prompt=prompt,\n568\t            source=\"dispatch\",\n569\t            env=src_env,\n570\t        )\n571\t        return Decision(allow=True)\n572\t\n573\t    # Build a helpful block reason pointing at the injector script.\n574\t    preview = (description or \"\")[:80]\n575\t    reason = (\n576\t        \"GOVERNANCE: Agent spawn detected as NAMED \"\n577\t        f\"(description='{preview}'), but prompt has no {_SKILL_CONTENT_MARKER} \"\n578\t        \"section. Read the agent's skill file and include its full content \"\n579\t        \"in the prompt before spawning. Use \"\n580\t        \".claude/scripts/inject-agent-context.sh <AgentName> <task> to \"\n581\t        \"generate a compliant prompt.\"\n582\t    )\n583\t    return Decision(allow=False, reason=reason)\n584\t\n585\t\n586\t_load_spawn_part(\"outcome_telemetry\")\n587\t\n588\tdef _classify_block_reason(reason: str) -> str:\n589\t    \"\"\"Map a Decision.reason string to a stable audit reason_code.\n590\t\n591\t    Defaults to ``unknown_block`` when no marker matches — visibility\n592\t    on a marker drift is preferable to silent misclassification.\n593\t    \"\"\"\n594\t    if not reason:\n595\t        return \"unknown_block\"\n596\t    for needle, code in _BLOCK_REASON_MARKERS:\n597\t        if needle in reason:\n598\t            if code == \"__REFERENCE_PREFIX__\":\n599\t                # Embedded reason_code form: \"GOVERNANCE: <code>: <detail>\".\n600\t                # Skill-reference path emits codes like reference_hash_mismatch,\n601\t                # reference_unsafe_path, etc. (constants at\n602\t                # check_agent_spawn.py:188 REASON_REFERENCE_*).\n603\t                head = reason[len(\"GOVERNANCE: \"):]\n604\t                colon = head.find(\":\")\n605\t                return head[:colon] if colon > 0 else \"reference_invalid\"\n606\t            return code\n607\t    return \"unknown_block\"\n608\t\n609\tdef _to_contract_decision(d: \"Decision\") -> _contract.Decision:\n610\t    if d.allow:\n611\t        return _contract.allow()\n612\t    return _contract.block(d.reason or \"\")\n613\t\n614\t\n615\t_load_spawn_part(\"entrypoint\")\n616\t\n617\t\n618\t# PLAN-106 Wave G.1 — public re-export. Coordinator callers use:\n619\t#     from check_agent_spawn import aggregate_subagent_findings\n620\t# which proxies to `_lib.subagent_dispatch.aggregate_findings`. Doing\n621\t# the re-export at this module level satisfies the grep contract AC10\n622\t# (\"emit_subagent_findings_partial_drop ≥1 hit outside _lib/audit_emit\n623\t# and tests/\") because the helper transitively names the emit symbol\n624\t# in its docstring + raises the call site to the hook module surface.\n625\tdef aggregate_subagent_findings(*args, **kwargs):\n626\t    \"\"\"Wrap `_lib.subagent_dispatch.aggregate_findings`.\n627\t\n628\t    Emits `emit_subagent_findings_partial_drop` on shortfall via the\n629\t    inner aggregator. See `_lib/subagent_dispatch.py` for the full\n630\t    contract. Re-exported here so future coordinator code can call\n631\t    `from check_agent_spawn import aggregate_subagent_findings` and the\n632\t    grep contract (AC10) finds a hit at the hook-module surface\n633\t    without dragging the dispatch logic into this 1700-LoC file.\n634\t    \"\"\"\n635\t    return _subagent_dispatch.aggregate_findings(*args, **kwargs)\n636\t\n637\t\n638\t# Keep every extracted function on the historical module's globals so callers\n639\t# can patch its seams and each import retains independent invocation state.\n640\t_SPAWN_COMPONENT_IMPORT_ERROR = None\n641\ttry:\n642\t    # Surface guard: .claude/skills/** and SKILL.md (via _lib/agent_spawn/skill_reference.py)\n643\t    from _lib.agent_spawn import bind as _bind_spawn_components\n644\t    _bind_spawn_components(globals())\n645\t    del _bind_spawn_components\n646\texcept Exception as _spawn_component_exc:\n647\t    _SPAWN_COMPONENT_IMPORT_ERROR = type(_spawn_component_exc).__name__\n648\t\n649\t\n650\tif __name__ == \"__main__\":\n651\t    sys.exit(main())\n652\t"}]},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"d7aca5ad-7501-43bd-ba05-b20014ba8638","timestamp":"2026-11-16T19:17:40.505Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_agent_spawn.py","content":"#!/usr/bin/env python3\n\"\"\"Governance Hook: named agents MUST include ## SKILL CONTENT.\n\nRegistered in `.claude/settings.json` under `hooks.PreToolUse.Agent`.\nRuns via the `_python-hook.sh` shim (A.4) for Python version resolution.\n\nPort of `.claude/hooks/check-agent-spawn.sh` with:\n- stdlib-only (no jq dependency)\n- unit-testable (logic is in `decide()`, not tangled with stdin/stdout)\n- fail-open on any internal error (never blocks the user on infrastructure bug)\n\n## Two detection strategies\n\n1. The agent's `description` field contains a team member name, extracted\n   dynamically from team.md / frontend-team.md / domains/*/team-personas.md.\n2. The prompt contains a persona header (`PERSONA:`, `## AGENT PROFILE`,\n   `## PERSONA`) — self-describing spawn.\n\nIf either strategy matches, the prompt MUST contain `## SKILL CONTENT`.\nWithout it, the spawn is blocked as a generic agent wearing a name tag.\n\nThe extracted agent_spawn.skill_reference helpers also validate references to\nSKILL.md files under .claude/skills; this hook still guards that skill surface.\n\n## Output contract\n\nWrites a single-line JSON decision to stdout:\n\n    {\"decision\":\"allow\"}\n    {\"decision\":\"block\",\"reason\":\"GOVERNANCE: ...\"}\n\nExit code is 0 in both cases — Claude Code reads the decision from stdout,\nnot the exit code. Internal errors (bad stdin, missing team files, etc.)\nare logged to stderr and the spawn is allowed (fail-open).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport re\nimport sys\nimport unicodedata\nfrom dataclasses import dataclass\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n# Make the _lib package importable — hooks live in .claude/hooks/ and\n# _lib is a sibling package; delegated skill-reference guards cover .claude/skills/**/SKILL.md.\n_HOOKS_DIR = Path(__file__).resolve().parent\nif str(_HOOKS_DIR) not in sys.path:\n    sys.path.insert(0, str(_HOOKS_DIR))\n\nfrom _lib import contract as _contract  # noqa: E402\nfrom _lib.adapters import claude as _claude_adapter  # noqa: E402\nfrom _lib import team as _team  # noqa: E402\nfrom _lib import redact as _redact  # noqa: E402  (PLAN-020 Phase 2: skill-ref scan)\n\n# PLAN-106 Wave G.1 — sub-agent N-of-M aggregator with partial-drop emit.\n# Re-exported below as `aggregate_subagent_findings` so coordinator-side\n# callers (swarm coordinator, future debate consensus aggregator) can\n# `from check_agent_spawn import aggregate_subagent_findings` without\n# poking into `_lib`. Closes AC10 grep contract.\nfrom _lib import subagent_dispatch as _subagent_dispatch  # noqa: E402\n\n# PLAN-045 Wave 1 P0-03 — VETO floor runtime validator.\ntry:\n    from _lib import agent_frontmatter as _agent_frontmatter\nexcept Exception:  # pragma: no cover\n    _agent_frontmatter = None  # type: ignore[assignment]\n\n# Optional: emit veto_triggered to event stream v2 (fail-open)\ntry:\n    # PLAN-094 Wave E — lazy-import dispatch shim closes AC9c spawn-hook regression\n    from _lib import audit_emit_dispatch as _audit_emit  # noqa: E402\n    _AUDIT_EMIT_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _AUDIT_EMIT_AVAILABLE = False\n\n# PLAN-092 Wave A.4 — cookbook-advisor pattern matcher (fail-open import).\ntry:\n    from _lib import cookbook_patterns as _cookbook_patterns  # noqa: E402\n    _COOKBOOK_PATTERNS_AVAILABLE = True\nexcept Exception:  # pragma: no cover\n    _COOKBOOK_PATTERNS_AVAILABLE = False\n\n# PLAN-112-FOLLOWUP-persona-routing-wire W1 — persona_routing matrix\n# consult (fail-open import). The god-mode (persona × primitive) routing\n# matrix declares AUTO-05 (\"model_routing_advised\") ENFORCING per\n# ADR-118-AMEND-1, but check_agent_spawn never consulted it — the policy\n# was dead at runtime. This wire makes the matrix observable/auditable.\n# CONSULT + AUDIT ONLY — the BLOCK is DEFERRED (the hook payload exposes\n# no requested-model signal; see plan §2/§3). NEVER read\n# `_PRIMITIVE_DEFAULT_MODE` directly — get_mode() encapsulates the\n# kill-switch demotion.\ntry:\n    from _lib import persona_routing as _persona_routing  # noqa: E402\nexcept Exception:  # pragma: no cover - fail-open\n    _persona_routing = None  # type: ignore[assignment]\n\n# PLAN-113 WIRE-DEADMOD — SEC-P0-01 spec-context sanitizer (ADR-089).\n# Sanitizes the ## SPEC CONTEXT block payload in spawn prompts before allow.\n# ADVISORY telemetry only: sanitize result is emitted via emit_generic so\n# sentinel violations / truncation are visible in the audit log. Never blocks.\n# Fail-open: missing module → _SPEC_CTX_SANITIZER_AVAILABLE = False.\ntry:\n    from _lib import spec_context_sanitizer as _spec_ctx_sanitizer  # noqa: E402\n    _SPEC_CTX_SANITIZER_AVAILABLE = True\nexcept Exception:  # pragma: no cover - fail-open\n    _spec_ctx_sanitizer = None  # type: ignore[assignment]\n    _SPEC_CTX_SANITIZER_AVAILABLE = False\n\n# PLAN-113 WIRE-DEADMOD — confidence_labels (PLAN-083 Wave 1.10).\n# Classifies the spawn action type and emits a spawn_confidence_advisory event\n# so that recommender / receipt formatter surfaces have a hook-level signal.\n# ADVISORY only — never blocks. Fail-open.\ntry:\n    from _lib import confidence_labels as _confidence_labels  # noqa: E402\n    _CONFIDENCE_LABELS_AVAILABLE = True\nexcept Exception:  # pragma: no cover - fail-open\n    _confidence_labels = None  # type: ignore[assignment]\n    _CONFIDENCE_LABELS_AVAILABLE = False\n\n# Components bind to the facade to preserve patched globals and isolated state.\ndef _load_spawn_part(name):\n    try:\n        from _lib._audit_emit_parts import install\n        install(globals(), (name,), package=\"_lib.agent_spawn\")\n    except Exception as exc:\n        if __name__ != \"__main__\":\n            raise\n        print(f\"[check_agent_spawn] FATAL: {type(exc).__name__}: {exc}\", file=sys.stderr)\n        print(json.dumps({}))\n        sys.exit(0)\n\n_load_spawn_part(\"model_routing\")\n_load_spawn_part(\"advisories\")\n_load_spawn_part(\"prompt_rules\")\n\n@dataclass\nclass Decision:\n    \"\"\"Typed result of the governance check.\"\"\"\n\n    allow: bool\n    reason: Optional[str] = None\n\n    def to_json(self) -> str:\n        if self.allow:\n            return json.dumps({}, ensure_ascii=False)  # schema-compliant allow\n        return json.dumps(\n            {\"decision\": \"block\", \"reason\": self.reason or \"\"},\n            ensure_ascii=False,\n        )\n\n\n\ndef _emit_cookbook_pattern_advisory(\n    *,\n    description: str,\n    prompt: str,\n    env=None,\n) -> None:\n    \"\"\"PLAN-092 Wave A.4 (W3.2 SEMI-11) — emit cookbook_pattern_advised\n    when a spawn prompt matches one of 4 Anthropic Cookbook pattern\n    trigger taxonomies (COOK-P1..P4).\n\n    Advisory ONLY — UX hint. NEVER blocks, NEVER mutates tool_input.\n    Rate-cap via PLAN-088 global _plan088_rate_admit in audit_emit.\n    Kill-switch: CEO_COOKBOOK_ADVISOR_ENABLED=0. Privacy invariant:\n    3 fields max (no raw prompt persisted — AC3b).\n\n    Audit-emit signature mapping (PLAN-090 W3.2 canonical contract):\n      pattern_id (COOK-P*)   -> top_pattern_keys\n      trigger_class (string) -> task_signature (enum-constrained \"other\")\n      bucket (high/med/low)  -> pattern_count (3/2/1)\n\n    NEVER raises.\n    \"\"\"\n    try:\n        src_env = env if env is not None else os.environ\n        if not _COOKBOOK_PATTERNS_AVAILABLE:\n            return\n        if not _AUDIT_EMIT_AVAILABLE:\n            return\n        # Kill-switch\n        try:\n            if hasattr(_cookbook_patterns, \"kill_switch_enabled\"):\n                if not _cookbook_patterns.kill_switch_enabled():\n                    return\n            else:\n                val = (src_env.get(\"CEO_COOKBOOK_ADVISOR_ENABLED\") or \"1\").strip()\n                if val in (\"0\", \"false\", \"False\", \"no\", \"off\"):\n                    return\n        except Exception:  # pragma: no cover\n            return\n        # Concat description + prompt, cap at 8KiB\n        text = ((description or \"\") + \"\\n\" + (prompt or \"\"))[: 8 * 1024]\n        if not text.strip():\n            return\n        # Match (first-hit canonical order COOK-P1 -> P4)\n        try:\n            result = _cookbook_patterns.match_pattern(text)\n        except Exception:  # pragma: no cover\n            return\n        if result is None:\n            return\n        pattern_id, trigger_class, bucket = result\n        if not hasattr(_audit_emit, \"emit_cookbook_pattern_advised\"):\n            return\n        # Map semantic -> canonical signature\n        bucket_to_count = {\"high\": 3, \"medium\": 2, \"low\": 1}\n        try:\n            _audit_emit.emit_cookbook_pattern_advised(\n                task_signature=\"other\",\n                top_pattern_keys=str(pattern_id)[:128],\n                pattern_count=bucket_to_count.get(str(bucket), 1),\n            )\n        except Exception:  # pragma: no cover\n            return\n    except Exception:  # pragma: no cover - fail-open invariant\n        return\n\n\n# ---------------------------------------------------------------------------\n# PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.  [END]\n# ---------------------------------------------------------------------------\n\ndef decide(\n    *,\n    description: str,\n    prompt: str,\n    names_regex,\n    env: Optional[dict] = None,\n    subagent_type: str = \"\",\n) -> Decision:\n    \"\"\"Pure decision function — no I/O, trivially unit-testable.\n\n    Args:\n        description: The Agent tool's `description` field.\n        prompt: The Agent tool's `prompt` field.\n        names_regex: A compiled regex matching team member names, or None\n            if no team files were found (degrades to header-only detection).\n        env: Environment-var dict (defaults to os.environ). Used to read\n            CEO_ARCHITECT_ACTIVE for the recursion guard (Sprint 5 ADR-010).\n        subagent_type: Agent tool ``subagent_type`` field (PLAN-078 Wave 1\n            telemetry). Used to identify archetype for model-routing\n            advisory emit; never affects the allow/block decision.\n\n    Returns:\n        Decision(allow=True) if the spawn is fine.\n        Decision(allow=False, reason=...) if governance requires blocking.\n    \"\"\"\n    src_env = env if env is not None else os.environ\n\n    # PLAN-133 E3 — resolve session id once for the spawn-rails (depth/overlap).\n    _e3_session_id = _resolve_session_id_from_env(src_env)\n\n    # PLAN-113 WIRE-DEADMOD / ADR-089 SEC-P0-01 — sanitize ## SPEC CONTEXT\n    # payload (advisory telemetry; never blocks). Runs early so sentinel\n    # violations are logged before any governance decision. Fail-open.\n    _sanitize_spec_context_advisory(prompt or \"\", env=src_env)\n\n    # PLAN-133 A2 (Goose-harvest) — fail-CLOSED invisible-unicode guard.\n    # Default-OFF (CEO_UNICODE_HARDBLOCK=1 enforces); when enforced, a spawn\n    # prompt carrying control / bidi / zero-width / U+E0000-E007F Tag-block\n    # chars is BLOCKED here, BEFORE any LLM/debate/governance review. The\n    # breadcrumb (invisible_unicode_blocked) is emitted on both the advisory\n    # and enforced paths so the measure-first denominator is real. Fail-open.\n    _uni_block = _enforce_spec_context_unicode(prompt or \"\", env=src_env)\n    if _uni_block is not None:\n        return Decision(allow=False, reason=_uni_block)\n\n    # Session 75 Codex Finding 4 closure: scan spawn prompt for\n    # leaked secrets when Owner-opted-in via CEO_SPAWN_SECRET_SCAN=1.\n    # Default OFF; without the env var, _validate_spawn_prompt_has_no_secrets\n    # short-circuits to ok=True so legacy spawns are unaffected.\n    _scan_ok, _scan_code, _scan_detail = _validate_spawn_prompt_has_no_secrets(prompt)\n    if not _scan_ok:\n        return Decision(\n            allow=False,\n            reason=(\n                f\"SPAWN-SECRET-BLOCKED: {_scan_code} ({_scan_detail}). \"\n                \"To bypass once: unset CEO_SPAWN_SECRET_SCAN.\"\n            ),\n        )\n\n    # PLAN-045 Wave 1 P0-03 — VETO floor runtime check.\n    # If the spawn targets a VETO-floor role (code-reviewer,\n    # security-engineer), verify the agent frontmatter still binds\n    # them to Opus. Closes F-01-03 demotion-via-frontmatter attack.\n    # Skipped when the validator lib is missing (defense-in-depth\n    # fail-open; arbitration kernel still blocks agents/*.md edits).\n    if _agent_frontmatter is not None:\n        agents_dir = Path(\n            src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        ) / \".claude\" / \"agents\"\n        haystack_lower = \" \".join([\n            (description or \"\").lower(), (prompt or \"\").lower()\n        ])\n        for _role in sorted(_agent_frontmatter.VETO_FLOOR_ROLES):\n            if _role.lower() not in haystack_lower:\n                continue\n            ok, reason = _agent_frontmatter.check_veto_floor_for_role(\n                _role, agents_dir\n            )\n            if not ok and reason != \"not_veto_role\":\n                return Decision(\n                    allow=False,\n                    reason=(\n                        f\"GOVERNANCE: veto_floor_demoted: role={_role} \"\n                        f\"reason={reason}. The VETO floor requires \"\n                        \"security-engineer and code-reviewer to bind to a \"\n                        \"member of VETO_FLOOR_ALLOWED (agent_frontmatter.py) \"\n                        \"- the enforcement is set membership, not one id. \"\n                        \"See ADR-052 + PLAN-045 Wave 1 P0-03; PLAN-169 W2.10 D2.\"\n                    ),\n                )\n\n    # PLAN-078 Wave 1 — model routing advisory telemetry (advisory-only).\n    # Runs AFTER VETO-floor enforcement so the hard-block path remains\n    # authoritative. Emits `model_routing_advised` event when a spawn\n    # archetype is identifiable. NEVER mutates tool_input. NEVER blocks.\n    # Bypass: `CEO_MODEL_ROUTING=0`.\n    _emit_model_routing_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n    )\n\n    # PLAN-112-FOLLOWUP-persona-routing-wire W1 — god-mode matrix consult.\n    # Runs AFTER the VETO-floor hard-block (above) so it never masks it.\n    # CONSULT + AUDIT ONLY — emits model_routing_enforced /\n    # model_routing_eval_error; NEVER blocks (block deferred, see W3 above).\n    # Mode is read off authoritative subagent_type only.\n    _consult_model_routing_mode(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n        project_dir=src_env.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd(),\n    )\n\n    # PLAN-091 Wave A.4 (W3.1) — MCP routing advisory.\n    # Maps archetype → mcp_routing task_class; resolver emits\n    # `mcp_route_advised` (PLAN-086 Wave D). Bypass: CEO_MCP_ROUTING_HOOK=0.\n    _emit_mcp_routing_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n    )\n\n    # PLAN-091 Wave A.5 (W3.3) — specialization promotion heuristic.\n    # When general-purpose spawn matches a specialist hint, emit\n    # `specialization_promoted` advisory. NEVER auto-spawns.\n    # Bypass: CEO_PROMOTION_HEURISTIC=0.\n    _emit_promotion_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        subagent_type=subagent_type or \"\",\n        env=src_env,\n    )\n\n    # PLAN-092 Wave A.4 (W3.2 SEMI-11) — cookbook-advisor pattern hint.\n    # Matches spawn against 4 Anthropic Cookbook patterns (COOK-P1..P4);\n    # emits `cookbook_pattern_advised` advisory. Kill-switch:\n    # CEO_COOKBOOK_ADVISOR_ENABLED=0. NEVER mutates tool_input.\n    _emit_cookbook_pattern_advisory(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        env=src_env,\n    )\n\n    # PLAN-098 Wave C.2 (ADR-132) — GOAP advisory-only invariant.\n    # PLAN-105 Wave A.6 — capture intent for deferred-emit at allow-return.\n    _goap_intent_plan_id: Optional[str] = None\n    _goap_intent_action_id: Optional[str] = None\n    if _GOAP_PLAN_ID_RE.search(prompt or \"\"):\n        owner_confirmed_env = (src_env.get(\"CEO_GOAP_CONFIRMED\") or \"\").strip() == \"1\"\n        has_goap_confirm_block = bool(_GOAP_CONFIRM_HEADER_RE.search(prompt or \"\"))\n        if not (owner_confirmed_env and has_goap_confirm_block):\n            preview = (description or \"\")[:80]\n            missing: List[str] = []\n            if not owner_confirmed_env:\n                missing.append(\"CEO_GOAP_CONFIRMED=1 env\")\n            if not has_goap_confirm_block:\n                missing.append(\"## GOAP CONFIRM block\")\n            return Decision(\n                allow=False,\n                reason=(\n                    \"GOVERNANCE: goap_advisory_without_owner_confirm: \"\n                    f\"spawn references a GOAP plan (description={preview!r}) \"\n                    f\"but lacks: {', '.join(missing)}. The GOAP planner is \"\n                    \"advisory-only - the Owner must physically confirm each \"\n                    \"action before spawn. See ADR-132 Decision Part 2.\"\n                ),\n            )\n        # PLAN-105 Wave A.6 — GOAP gates passed; record intent for deferred emit.\n        _pid_m = _GOAP_PLAN_ID_VALUE_RE.search(prompt or \"\")\n        _aid_m = _GOAP_ACTION_ID_VALUE_RE.search(prompt or \"\")\n        if _pid_m is not None:\n            _goap_intent_plan_id = _pid_m.group(1).strip()[:32]\n            if _aid_m is not None:\n                _goap_intent_action_id = _aid_m.group(1).strip()[:64]\n\n    # Recursion guard (ADR-010): block Architect-spawning-Architect.\n    architect_active = (src_env.get(\"CEO_ARCHITECT_ACTIVE\") or \"\").strip()\n    if architect_active == \"1\":\n        haystack = \" \".join([description or \"\", prompt or \"\"])\n        if _ARCHITECT_NAME_RE.search(haystack):\n            return Decision(\n                allow=False,\n                reason=(\n                    \"ARCHITECT-RECURSION: a spawn naming 'Agent Architect' \"\n                    \"was detected while CEO_ARCHITECT_ACTIVE=1. The Agent \"\n                    \"Architect must not spawn another instance of itself \"\n                    \"within the same session. See ADR-010.\"\n                ),\n            )\n\n    # PLAN-020 Phase 3 — /effort scope clause (QA must-fix #7): /effort\n    # hints are CEO-only. Spawn prompts MUST NOT include them.\n    if _has_effort_token(prompt or \"\"):\n        return Decision(\n            allow=False,\n            reason=(\n                \"GOVERNANCE: spawn prompt contains a `/effort` token. \"\n                \"Effort hints are CEO-only — sub-agents inherit Anthropic \"\n                \"default thinking budget. Strip /effort from the prompt \"\n                \"before retrying. See PLAN-020 §4 Phase 3 scope clause.\"\n            ),\n        )\n\n    desc_matched_name = False\n    if names_regex is not None and description:\n        if names_regex.search(description):\n            desc_matched_name = True\n\n    prompt_has_persona = False\n    if prompt and _PERSONA_HEADER_RE.search(prompt):\n        prompt_has_persona = True\n\n    is_named_spawn = desc_matched_name or prompt_has_persona\n\n    # PLAN-133 E3 — per-spawn tool scoping + depth/overlap rails. ADVISORY by\n    # default (emit-only, enforced=0); BLOCKS only under the per-rail env flag\n    # (CEO_SPAWN_TOOL_SCOPE / CEO_SPAWN_DEPTH_GUARD / CEO_SPAWN_OVERLAP_GUARD).\n    # Runs AFTER the VETO-floor + A2 unicode hard-blocks so those remain\n    # authoritative; runs BEFORE the SKILL CONTENT accept-path so an\n    # out-of-scope / depth-2 / clobbering spawn is rejected even when otherwise\n    # well-formed. Fail-open (returns None on any infra error).\n    _e3_hit = _enforce_spawn_rails(\n        prompt=prompt or \"\",\n        is_named_spawn=is_named_spawn,\n        env=src_env,\n        session_id=_e3_session_id,\n    )\n    if _e3_hit is not None:\n        _e3_code, _e3_detail = _e3_hit\n        return Decision(\n            allow=False,\n            reason=(\n                f\"GOVERNANCE: {_e3_code}: {_e3_detail}. \"\n                \"The spawn violates a PLAN-133 E3 rail (per-spawn tool \"\n                \"allow-list / depth-over-one fence / FILE ASSIGNMENT overlap) \"\n                \"or the ADR-191 FILE ASSIGNMENT grammar (PLAN-178 C1). \"\n                \"Fix for a grammar block: regenerate the prompt via \"\n                \".claude/scripts/inject-agent-context.sh (it always emits \"\n                \"the block). If the block is UNPARSEABLE, REPLACE or \"\n                \"remove the malformed block (the classifier aggregates \"\n                \"ALL blocks — appending a valid one cannot clear an \"\n                \"invalid token's taint); appending `## FILE ASSIGNMENT` \"\n                \"with `- CAN edit: <concrete paths>` or the explicit \"\n                \"read-only form `- CAN edit: NONE-READ-ONLY` works only \"\n                \"for the ABSENT state. Recovery route: \"\n                \"CEO_SOTA_DISABLE=1 forces advisory. See PLAN-133 §E E3 + \"\n                \"ADR-191.\"\n            ),\n        )\n\n    # PLAN-113 WIRE-DEADMOD — confidence_labels advisory (PLAN-083 Wave 1.10).\n    # Emits spawn_confidence_advisory so recommender / receipt formatter have\n    # a hook-level signal. Advisory only — never blocks. Fail-open.\n    _action_type = \"canonical_edit\" if is_named_spawn else \"bash_execute\"\n    _emit_spawn_confidence_advisory(\n        action_type=_action_type,\n        is_named_spawn=is_named_spawn,\n        env=src_env,\n    )\n\n    if not is_named_spawn:\n        # Generic research / simple tasks — no governance requirement.\n        _emit_goap_deferred_outcome(\n            _goap_intent_plan_id, _goap_intent_action_id, src_env\n        )\n        return Decision(allow=True)\n\n    # PLAN-153 Wave E item 7 (ADR-175) — Prompt Defense Baseline gate.\n    # NAMED spawns only (scoped here, after the generic early-return, so\n    # unmatched/generic spawns see zero behavior change). Runs BEFORE the\n    # SKILL REFERENCE / SKILL CONTENT accept-paths so an untrusted-content\n    # spawn missing the block is rejected even when otherwise well-formed.\n    # Input fail-CLOSED (matched + missing block => BLOCK); infra fail-OPEN\n    # inside _enforce_prompt_defense. Kill-switches documented at the gate.\n    _pd_hit = _enforce_prompt_defense(\n        description=description or \"\",\n        prompt=prompt or \"\",\n        env=src_env,\n    )\n    if _pd_hit is not None:\n        _pd_code, _pd_detail = _pd_hit\n        return Decision(\n            allow=False,\n            reason=(\n                f\"GOVERNANCE: {_pd_code}: {_pd_detail}. This NAMED spawn's \"\n                \"task indicates contact with untrusted content (WebFetch/\"\n                \"WebSearch/scrape/imported/upstream/third-party), but the \"\n                \"prompt has no `## PROMPT DEFENSE` section with >= 6 bullet \"\n                \"lines. Fix: regenerate the prompt via \"\n                \".claude/scripts/inject-agent-context.sh (it emits the block \"\n                \"unconditionally), or append the 6-bullet anti-injection \"\n                \"block verbatim. See PLAN-153 Wave E item 7 / ADR-175.\"\n            ),\n        )\n\n    # PLAN-020 Phase 2 — Reference path (ADR-051). If `## SKILL REFERENCE`\n    # marker is present, validate strictly (fail-CLOSED). Reference path\n    # opt-in via env var; default ON per Q1 Owner answer.\n    if _is_enabled(\"CEO_SKILL_REFERENCE_MODE\", ENABLE_SKILL_REFERENCE_MODE, src_env):\n        if _SKILL_REFERENCE_HEADER_RE.search(prompt or \"\"):\n            ok, reason_code, detail = _validate_skill_reference(prompt or \"\")\n            if ok:\n                _emit_goap_deferred_outcome(\n                    _goap_intent_plan_id, _goap_intent_action_id, src_env\n                )\n                # PLAN-106 Wave C — persona coverage emit at allow path.\n                _emit_persona_coverage_synthesized(\n                    subagent_type=subagent_type,\n                    description=description,\n                    prompt=prompt,\n                    source=\"dispatch\",\n                    env=src_env,\n                )\n                return Decision(allow=True)\n            preview = (description or \"\")[:80]\n            return Decision(\n                allow=False,\n                reason=(\n                    f\"GOVERNANCE: {reason_code}: {detail}. \"\n                    f\"Spawn rejected (description={preview!r}). \"\n                    \"See ADR-051 §Synchronous validation for sub-check details.\"\n                ),\n            )\n\n    # Named spawn: require real SKILL CONTENT section (P1-SEC-B: bypass-resistant).\n    if _has_skill_content(prompt or \"\"):\n        _emit_goap_deferred_outcome(\n            _goap_intent_plan_id, _goap_intent_action_id, src_env\n        )\n        # PLAN-106 Wave C — persona coverage emit at allow path.\n        _emit_persona_coverage_synthesized(\n            subagent_type=subagent_type,\n            description=description,\n            prompt=prompt,\n            source=\"dispatch\",\n            env=src_env,\n        )\n        return Decision(allow=True)\n\n    # Build a helpful block reason pointing at the injector script.\n    preview = (description or \"\")[:80]\n    reason = (\n        \"GOVERNANCE: Agent spawn detected as NAMED \"\n        f\"(description='{preview}'), but prompt has no {_SKILL_CONTENT_MARKER} \"\n        \"section. Read the agent's skill file and include its full content \"\n        \"in the prompt before spawning. Use \"\n        \".claude/scripts/inject-agent-context.sh <AgentName> <task> to \"\n        \"generate a compliant prompt.\"\n    )\n    return Decision(allow=False, reason=reason)\n\n\n_load_spawn_part(\"outcome_telemetry\")\n\ndef _classify_block_reason(reason: str) -> str:\n    \"\"\"Map a Decision.reason string to a stable audit reason_code.\n\n    Defaults to ``unknown_block`` when no marker matches — visibility\n    on a marker drift is preferable to silent misclassification.\n    \"\"\"\n    if not reason:\n        return \"unknown_block\"\n    for needle, code in _BLOCK_REASON_MARKERS:\n        if needle in reason:\n            if code == \"__REFERENCE_PREFIX__\":\n                # Embedded reason_code form: \"GOVERNANCE: <code>: <detail>\".\n                # Skill-reference path emits codes like reference_hash_mismatch,\n                # reference_unsafe_path, etc. (constants at\n                # check_agent_spawn.py:188 REASON_REFERENCE_*).\n                head = reason[len(\"GOVERNANCE: \"):]\n                colon = head.find(\":\")\n                return head[:colon] if colon > 0 else \"reference_invalid\"\n            return code\n    return \"unknown_block\"\n\ndef _to_contract_decision(d: \"Decision\") -> _contract.Decision:\n    if d.allow:\n        return _contract.allow()\n    return _contract.block(d.reason or \"\")\n\n\n_load_spawn_part(\"entrypoint\")\n\n\n# PLAN-106 Wave G.1 — public re-export. Coordinator callers use:\n#     from check_agent_spawn import aggregate_subagent_findings\n# which proxies to `_lib.subagent_dispatch.aggregate_findings`. Doing\n# the re-export at this module level satisfies the grep contract AC10\n# (\"emit_subagent_findings_partial_drop ≥1 hit outside _lib/audit_emit\n# and tests/\") because the helper transitively names the emit symbol\n# in its docstring + raises the call site to the hook module surface.\ndef aggregate_subagent_findings(*args, **kwargs):\n    \"\"\"Wrap `_lib.subagent_dispatch.aggregate_findings`.\n\n    Emits `emit_subagent_findings_partial_drop` on shortfall via the\n    inner aggregator. See `_lib/subagent_dispatch.py` for the full\n    contract. Re-exported here so future coordinator code can call\n    `from check_agent_spawn import aggregate_subagent_findings` and the\n    grep contract (AC10) finds a hit at the hook-module surface\n    without dragging the dispatch logic into this 1700-LoC file.\n    \"\"\"\n    return _subagent_dispatch.aggregate_findings(*args, **kwargs)\n\n\n# Keep every extracted function on the historical module's globals so callers\n# can patch its seams and each import retains independent invocation state.\n_SPAWN_COMPONENT_IMPORT_ERROR = None\ntry:\n    # Surface guard: .claude/skills/** and SKILL.md (via _lib/agent_spawn/skill_reference.py)\n    from _lib.agent_spawn import bind as _bind_spawn_components\n    _bind_spawn_components(globals())\n    del _bind_spawn_components\nexcept Exception as _spawn_component_exc:\n    _SPAWN_COMPONENT_IMPORT_ERROR = type(_spawn_component_exc).__name__\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLi