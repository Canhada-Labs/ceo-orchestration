{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WHzBLP5tzHBGini5oLpJdh","type":"tool_result","content":"10\t\n11\tKill-switch: env `CEO_BRANCH_COVERAGE_ENFORCING=0` flips this script\n12\tto advisory mode (warns to stderr; exit 0 regardless of threshold).\n13\t\n14\tPLAN-112-FOLLOWUP-coverage-doctrine-reconcile (S157) / ADR-139 — Tier-1\n15\tper-module mode:\n16\t  parse-coverage.py --tier1-modules 'a.py,b.py' --tier1-min 86\n17\treads `coverage.json` `files[].summary.percent_covered` and fails if ANY\n18\tlisted Tier-1 module is below --tier1-min. Modules are matched by path\n19\tsuffix against production files (test-tree paths excluded). A listed\n20\tmodule that matches no production file is itself a failure (guards against\n21\tsilently passing a typo'd module name). When --tier1-modules is set, ONLY\n22\tthe Tier-1 check runs (the branch/line/baseline gate is a separate,\n23\tadvisory invocation). Kill-switch: env `CEO_TIER1_COVERAGE_ENFORCING=0`\n24\tflips the Tier-1 check to advisory (warns; exit 0).\n25\tStdlib-only.\n26\t\"\"\"\n27\tfrom __future__ import annotations\n28\t\n29\timport argparse\n30\timport json\n31\timport os\n32\timport re\n33\timport sys\n34\tfrom pathlib import Path\n35\t\n36\t\n37\tdef _load_data(path: Path) -> dict:\n38\t    with path.open(\"r\", encoding=\"utf-8\") as fh:\n39\t        return json.load(fh)\n40\t\n41\t\n42\tdef _load_totals(path: Path) -> dict:\n43\t    return _load_data(path).get(\"totals\") or {}\n44\t\n45\t\n46\tdef _is_production(file_key: str) -> bool:\n47\t    \"\"\"A coverage.json file key that is live code, not a test or staging copy.\"\"\"\n48\t    return \"/tests/\" not in file_key and \"/plans/\" not in file_key\n49\t\n50\t\n51\tdef tier1_failures(data: dict, modules: list, min_pct: float) -> list:\n52\t    \"\"\"Return human-readable failures for Tier-1 per-module coverage.\n53\t\n54\t    `modules` is a list of path suffixes (e.g. 'check_read_injection.py').\n55\t    A module is matched against production file keys by suffix; a module\n56\t    matching no production file is itself a failure.\n57\t    \"\"\"\n58\t    files = data.get(\"files\") or {}\n59\t    failures = []\n60\t    for mod in modules:\n61\t        mod = mod.strip()\n62\t        if not mod:\n63\t            continue\n64\t        matched = [\n65\t            (k, v) for k, v in files.items()\n66\t            if _is_production(k) and (k == mod or k.endswith(\"/\" + mod) or k.endswith(mod))\n67\t        ]\n68\t        if not matched:\n69\t            failures.append(f\"Tier-1 module '{mod}' not found in coverage.json (production files)\")\n70\t            continue\n71\t        # Most-specific match wins if several (shortest path suffix delta).\n72\t        key, val = min(matched, key=lambda kv: len(kv[0]))\n73\t        pct = float(val.get(\"summary\", {}).get(\"percent_covered\", 0.0))\n74\t        status = \"OK\" if pct >= min_pct else \"BELOW\"\n75\t        print(f\"  TIER1 {status}: {key} = {pct:.2f}% (min {min_pct})\")\n76\t        if pct < min_pct:\n77\t            failures.append(f\"Tier-1 module {key} {pct:.2f}% < min {min_pct}\")\n78\t    return failures\n79\t\n80\t\n81\tdef _branch_pct(totals: dict) -> float:\n82\t    if \"percent_covered_branches\" in totals:\n83\t        return float(totals[\"percent_covered_branches\"])\n84\t    nb = int(totals.get(\"num_branches\", 0))\n85\t    cb = int(totals.get(\"covered_branches\", 0))\n86\t    return (cb / nb * 100.0) if nb else 0.0\n87\t\n88\t\n89\tdef _line_pct(totals: dict) -> float:\n90\t    return float(totals.get(\"percent_covered\", 0.0))\n91\t\n92\t\n93\t_BASELINE_BRANCH_RE = re.compile(r\"^\\s*-\\s*BRANCH\\s*[:=]\\s*([0-9.]+)\\s*%\", re.IGNORECASE | re.MULTILINE)\n94\t\n95\t\n96\tdef _baseline_branch(md: Path) -> float:\n97\t    text = md.read_text(encoding=\"utf-8\")\n98\t    m = _BASELINE_BRANCH_RE.search(text)\n99\t    if not m:"}]},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"9b630c2e-7ab3-4f54-a3da-920d2e902e7c","timestamp":"2026-11-16T19:22:20.428Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.github/scripts/parse-coverage.py","content":"\nKill-switch: env `CEO_BRANCH_COVERAGE_ENFORCING=0` flips this script\nto advisory mode (warns to stderr; exit 0 regardless of threshold).\n\nPLAN-112-FOLLOWUP-coverage-doctrine-reconcile (S157) / ADR-139 — Tier-1\nper-module mode:\n  parse-coverage.py --tier1-modules 'a.py,b.py' --tier1-min 86\nreads `coverage.json` `files[].summary.percent_covered` and fails if ANY\nlisted Tier-1 module is below --tier1-min. Modules are matched by path\nsuffix against production files (test-tree paths excluded). A listed\nmodule that matches no production file is itself a failure (guards against\nsilently passing a typo'd module name). When --tier1-modules is set, ONLY\nthe Tier-1 check runs (the branch/line/baseline gate is a separate,\nadvisory invocation). Kill-switch: env `CEO_TIER1_COVERAGE_ENFORCING=0`\nflips the Tier-1 check to advisory (warns; exit 0).\nStdlib-only.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom pathlib import Path\n\n\ndef _load_data(path: Path) -> dict:\n    with path.open(\"r\", encoding=\"utf-8\") as fh:\n        return json.load(fh)\n\n\ndef _load_totals(path: Path) -> dict:\n    return _load_data(path).get(\"totals\") or {}\n\n\ndef _is_production(file_key: str) -> bool:\n    \"\"\"A coverage.json file key that is live code, not a test or staging copy.\"\"\"\n    return \"/tests/\" not in file_key and \"/plans/\" not in file_key\n\n\ndef tier1_failures(data: dict, modules: list, min_pct: float) -> list:\n    \"\"\"Return human-readable failures for Tier-1 per-module coverage.\n\n    `modules` is a list of path suffixes (e.g. 'check_read_injection.py').\n    A module is matched against production file keys by suffix; a module\n    matching no production file is itself a failure.\n    \"\"\"\n    files = data.get(\"files\") or {}\n    failures = []\n    for mod in modules:\n        mod = mod.strip()\n        if not mod:\n            continue\n        matched = [\n            (k, v) for k, v in files.items()\n            if _is_production(k) and (k == mod or k.endswith(\"/\" + mod) or k.endswith(mod))\n        ]\n        if not matched:\n            failures.append(f\"Tier-1 module '{mod}' not found in coverage.json (production files)\")\n            continue\n        # Most-specific match wins if several (shortest path suffix delta).\n        key, val = min(matched, key=lambda kv: len(kv[0]))\n        pct = float(val.get(\"summary\", {}).get(\"percent_covered\", 0.0))\n        status = \"OK\" if pct >= min_pct else \"BELOW\"\n        print(f\"  TIER1 {status}: {key} = {pct:.2f}% (min {min_pct})\")\n        if pct < min_pct:\n            failures.append(f\"Tier-1 module {key} {pct:.2f}% < min {min_pct}\")\n    return failures\n\n\ndef _branch_pct(totals: dict) -> float:\n    if \"percent_covered_branches\" in totals:\n        return float(totals[\"percent_covered_branches\"])\n    nb = int(totals.get(\"num_branches\", 0))\n    cb = int(totals.get(\"covered_branches\", 0))\n    return (cb / nb * 100.0) if nb else 0.0\n\n\ndef _line_pct(totals: dict) -> float:\n    return float(totals.get(\"percent_covered\", 0.0))\n\n\n_BASELINE_BRANCH_RE = re.compile(r\"^\\s*-\\s*BRANCH\\s*[:=]\\s*([0-9.]+)\\s*%\", re.IGNORECASE | re.MULTILINE)\n\n\ndef _baseline_branch(md: Path) -> float:\n    text = md.read_text(encoding=\"utf-8\")\n    m = _BASELINE_BRANCH_RE.search(text)\n    if not m:","numLines":90,"startLine":10,"totalLines":190}},"tool_result_meta":[{"id":"toolu_01WHzBLP5tzHBGini5oLpJdh","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
