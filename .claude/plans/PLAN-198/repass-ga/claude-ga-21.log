{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch79W49bJYJN6GnNjW3zA","type":"message","role":"assistant","content":[{"type":"thinking","thinking":"","signature":""}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20382,"cache_read_input_tokens":194965,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20382},"output_tokens":10,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"edbc1877-e148-4da8-988c-83a8615a6147","timestamp":"2026-11-16T19:19:29.399Z","request_id":"req_011Ch79W3uTNihMFwDNgyUMW","thinking_duration_ms":2278,"thinking_display":"updates"}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch79W49bJYJN6GnNjW3zA","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01MguEbCWnFMxJZuWGgLgpyf","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/rotation_storage.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":20382,"cache_read_input_tokens":194965,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":20382},"output_tokens":10,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"d86d448a-d928-43ce-9817-7d51a2cce87b","timestamp":"2026-11-16T19:19:30.623Z","request_id":"req_011Ch79W3uTNihMFwDNgyUMW","wire_tool_inputs":{"toolu_01MguEbCWnFMxJZuWGgLgpyf":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/rotation_storage.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MguEbCWnFMxJZuWGgLgpyf","type":"tool_result","content":"1\t\"\"\"Rotation, safe storage, and append declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tdef rotate_if_needed(log_path: Path, threshold_bytes: int) -> Optional[Path]:\n5\t    \"\"\"Rename log_path to a monthly rotated file if it exceeds the threshold.\n6\t\n7\t    Must be called UNDER the lock so no concurrent writer can race.\n8\t\n9\t    PLAN-045 Wave 2 P0-08: delegates to ``_lib.audit_rotation.rotate_if_needed``\n10\t    so both write paths (this ``append_entry`` + ``_lib.audit_emit._write_event``)\n11\t    share identical rotation semantics. Preserves the existing call\n12\t    signature for backwards compatibility.\n13\t\n14\t    PLAN-044 audit-v2 C6-P0-02 fix (Wave B): on successful rotation,\n15\t    invoke ``audit_hmac.reset_chain_on_rotation()`` so the HMAC chain\n16\t    starts a fresh genesis on the new log file. Without this, rotated\n17\t    logs continue chain from the previous final hmac into the new\n18\t    file's genesis row, which `audit-verify-chain.py` cannot validate\n19\t    (genesis is by definition prev_hmac=GENESIS_PREV; a non-genesis\n20\t    prev_hmac after rotation looks like silent tamper). Pattern was\n21\t    already correct in ``_lib.audit_emit._write_event`` — Wave B brings\n22\t    ``audit_log.py`` to parity.\n23\t\n24\t    Returns the rotated path if rotation happened, None otherwise.\n25\t    \"\"\"\n26\t    try:\n27\t        from _lib.audit_rotation import rotate_if_needed as _shared_rotate\n28\t    except ImportError:\n29\t        # Defensive: if the shared primitive isn't available (partial\n30\t        # install), fall back to the inlined legacy implementation so\n31\t        # rotation still works in the classic path.\n32\t        rotated = _legacy_rotate_inline(log_path, threshold_bytes)\n33\t    else:\n34\t        rotated = _shared_rotate(log_path, threshold_bytes, now_month_slug())\n35\t\n36\t    # PLAN-044 audit-v2 C6-P0-02 — reset the per-process HMAC chain\n37\t    # state so the next entry written to the fresh log file is a\n38\t    # GENESIS_PREV-rooted row. Best-effort: missing _lib.audit_hmac\n39\t    # is non-fatal (older installs); chain integrity tests will catch\n40\t    # any rotated row that violates the genesis rule.\n41\t    if rotated is not None:\n42\t        try:\n43\t            from _lib import audit_hmac as _audit_hmac\n44\t            if hasattr(_audit_hmac, \"reset_chain_on_rotation\"):\n45\t                _audit_hmac.reset_chain_on_rotation()\n46\t        except Exception:\n47\t            pass\n48\t    return rotated\n49\t\n50\t\n51\tdef _legacy_rotate_inline(\n52\t    log_path: Path, threshold_bytes: int\n53\t) -> Optional[Path]:\n54\t    \"\"\"Fallback rotation for the rare case ``_lib.audit_rotation`` is missing.\n55\t\n56\t    Kept in-line so a half-installed framework still rotates. Mirrors\n57\t    the behavior of the shared primitive byte-for-byte.\n58\t    \"\"\"\n59\t    try:\n60\t        if not log_path.is_file():\n61\t            return None\n62\t        size = log_path.stat().st_size\n63\t        if size <= threshold_bytes:\n64\t            return None\n65\t    except OSError:\n66\t        return None\n67\t\n68\t    month = now_month_slug()\n69\t    base = log_path.parent / f\"{log_path.stem}-{month}.jsonl\"\n70\t    candidate = base\n71\t    counter = 1\n72\t    while candidate.exists():\n73\t        candidate = log_path.parent / f\"{log_path.stem}-{month}-{counter}.jsonl\"\n74\t        counter += 1\n75\t        if counter > 1000:\n76\t            return None\n77\t\n78\t    try:\n79\t        os.replace(str(log_path), str(candidate))\n80\t    except OSError:\n81\t        return None\n82\t    return candidate\n83\t\n84\t\n85\t# -----------------------------------------------------------------------------\n86\t# Error breadcrumb\n87\t# -----------------------------------------------------------------------------\n88\t\n89\t\n90\tdef write_breadcrumb(err_path: Path, message: str) -> None:\n91\t    \"\"\"Best-effort write to the errors log. Never raises.\"\"\"\n92\t    try:\n93\t        err_path.parent.mkdir(parents=True, exist_ok=True)\n94\t        ts = now_iso_utc()\n95\t        with open(err_path, \"a\", encoding=\"utf-8\") as f:\n96\t            f.write(f\"[{ts}] {message}\\n\")\n97\t    except OSError:\n98\t        # Last-resort: stderr\n99\t        try:\n100\t            sys.stderr.write(f\"[audit-log] breadcrumb write failed: {message}\\n\")\n101\t        except Exception:  # pragma: no cover\n102\t            pass\n103\t\n104\t\n105\t# -----------------------------------------------------------------------------\n106\t# PLAN-045 F-01-06 — symlink + ownership defense\n107\t# -----------------------------------------------------------------------------\n108\t\n109\t\n110\tdef _is_safe_audit_path(\n111\t    path: Path, expected_uid: int\n112\t) -> Tuple[bool, str]:\n113\t    \"\"\"Check audit path for symlink + ownership safety.\n114\t\n115\t    Returns ``(True, \"\")`` if safe (nonexistent OR real file/dir owned\n116\t    by ``expected_uid``). Returns ``(False, reason)`` if unsafe\n117\t    (symlink OR owner mismatch).\n118\t\n119\t    Uses ``os.lstat`` (not ``stat``) so symlinks themselves are\n120\t    inspected rather than their targets. Never raises.\n121\t\n122\t    ## Threat model\n123\t\n124\t    1. **Symlink redirection.** An attacker with write access to\n125\t       ``$HOME/.claude/projects/`` creates\n126\t       ``ceo-orchestration -> /tmp/evil``. Every append goes to\n127\t       attacker-controlled path, defeats tamper-evident audit trail.\n128\t    2. **UID squatting.** Another user's process creates the audit\n129\t       directory. Hook runs as current user → fails to open for\n130\t       append (EACCES) OR leaks sensitive data into foreign-owned\n131\t       file if perms are too permissive.\n132\t\n133\t    Both are refused before any write. The caller logs a breadcrumb\n134\t    to the /tmp fallback path and returns silently (fail-open on\n135\t    session; forensic trail preserved).\n136\t    \"\"\"\n137\t    try:\n138\t        st = path.lstat()\n139\t    except FileNotFoundError:\n140\t        # Nonexistent is safe — the normal first-write path.\n141\t        return (True, \"\")\n142\t    except OSError as e:\n143\t        return (False, f\"lstat_error:{e.__class__.__name__}\")\n144\t    if stat.S_ISLNK(st.st_mode):\n145\t        return (False, \"symlink_rejected\")\n146\t    if st.st_uid != expected_uid:\n147\t        return (\n148\t            False,\n149\t            f\"uid_mismatch:owner={st.st_uid} proc={expected_uid}\",\n150\t        )\n151\t    return (True, \"\")\n152\t\n153\t\n154\tdef _fallback_security_breadcrumb(message: str) -> None:\n155\t    \"\"\"Breadcrumb to ``/tmp`` fallback when primary audit dir is unsafe.\n156\t\n157\t    Mirrors ``_lib.audit_emit._fallback_log_path`` pattern. Never\n158\t    raises. Writes under the current user's namespaced filename so\n159\t    multi-user systems don't clobber each other.\n160\t    \"\"\"\n161\t    try:\n162\t        try:\n163\t            user = getpass.getuser() or \"unknown\"\n164\t        except Exception:\n165\t            user = os.environ.get(\"USER\") or \"unknown\"\n166\t        user = \"\".join(\n167\t            c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\")\n168\t        )\n169\t        fallback = Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n170\t        ts = now_iso_utc()\n171\t        with open(fallback, \"a\", encoding=\"utf-8\") as f:\n172\t            f.write(f\"[{ts}] audit-log security: {message}\\n\")\n173\t    except Exception:\n174\t        pass\n175\t\n176\t\n177\t# -----------------------------------------------------------------------------\n178\t# Append entry under lock\n179\t# -----------------------------------------------------------------------------\n180\t\n181\t\n182\tdef append_entry(\n183\t    entry: Dict[str, Any],\n184\t    *,\n185\t    paths: Dict[str, Path],\n186\t    threshold_bytes: int,\n187\t) -> None:\n188\t    \"\"\"Append a single JSONL line under the lock, rotating if needed.\n189\t\n190\t    Any failure is logged to the errors breadcrumb and swallowed (fail-open).\n191\t\n192\t    PLAN-045 F-01-06: pre-write symlink + ownership check on audit dir\n193\t    and audit log file. On violation, breadcrumb to /tmp fallback +\n194\t    return silently (fail-open on session; entry dropped but forensic\n195\t    trail preserved via fallback + upstream audit_emit).\n196\t    \"\"\"\n197\t    # F-01-06 symlink + uid defense BEFORE any mkdir/write.\n198\t    # Rationale: an attacker who plants a symlink in the audit dir can\n199\t    # redirect writes. Ownership mismatch indicates another user's\n200\t    # process created the path. Both warrant refusal + breadcrumb.\n201\t    expected_uid = os.geteuid()\n202\t    ok, reason = _is_safe_audit_path(paths[\"dir\"], expected_uid)\n203\t    if not ok:\n204\t        _fallback_security_breadcrumb(\n205\t            f\"audit dir unsafe: {paths['dir']} ({reason})\"\n206\t        )\n207\t        return\n208\t    ok, reason = _is_safe_audit_path(paths[\"log\"], expected_uid)\n209\t    if not ok:\n210\t        _fallback_security_breadcrumb(\n211\t            f\"audit log unsafe: {paths['log']} ({reason})\"\n212\t        )\n213\t        return\n214\t    # Ensure dir exists with restrictive perms\n215\t    # PLAN-024 F-sec-001 P1 fix: mkdir(mode=0o700) closes TOCTOU micro-window\n216\t    # between mkdir() and os.chmod() where same-UID attacker could win a race.\n217\t    try:\n218\t        paths[\"dir\"].mkdir(parents=True, exist_ok=True, mode=0o700)\n219\t        # Belt-and-braces: retighten in case dir pre-existed with looser perms\n220\t        try:\n221\t            os.chmod(paths[\"dir\"], 0o700)\n222\t        except OSError:\n223\t            pass\n224\t    except OSError as e:\n225\t        write_breadcrumb(paths[\"err\"], f\"cannot create audit dir: {e}\")\n226\t        return\n227\t\n228\t    # PLAN-085 Wave B.3 — inline HMAC computation closes the two-writer\n229\t    # chain gap (F-C1-001 / T0-line-168 transition_violation root cause).\n230\t    # 100% of agent_spawn events now carry hmac field per ADR-055.\n231\t    # Reuses _lib/audit_hmac primitives; fail-OPEN per CLAUDE.md §5.\n232\t    # PLAN-194 (rc.1 condition 67): key, predecessor, HMAC, append and sidecar\n233\t    # share ONE FileLock (as in audit_emit/drain); read before it, a writer in\n234\t    # between forked the chain. Only the stateless import stays outside.\n235\t    entry.setdefault(\"hmac\", None)\n236\t    entry.setdefault(\"hmac_error\", None)\n237\t    _audit_hmac = None\n238\t    try:\n239\t        from _lib import audit_hmac as _audit_hmac\n240\t    except Exception as _b3_ie:\n241\t        entry[\"hmac\"] = None\n242\t        entry[\"hmac_error\"] = type(_b3_ie).__name__\n243\t\n244\t    line = \"\"\n245\t\n246\t    try:\n247\t        with FileLock(paths[\"lock\"], timeout=2.5):\n248\t            # Rotate inside the lock so writers can't race past a rename\n249\t            rotated_to = rotate_if_needed(paths[\"log\"], threshold_bytes)\n250\t            # ADR-055-AMEND-2 marker as line 1 BEFORE our HMAC reads the predecessor;\n251\t            # no marker on disk => never sign over a last-hmac that may name it.\n252\t            marker_ok = rotated_to is None or _emit_rotation_marker_under_lock(\n253\t                paths[\"log\"], rotated_to, paths[\"err\"])\n254\t            _b3_hmac_digest_bytes = None\n255\t            if _audit_hmac is not None and not marker_ok:\n256\t                entry[\"hmac\"] = None\n257\t                entry[\"hmac_error\"] = \"chain_reset_marker_missing\"\n258\t            elif _audit_hmac is not None:\n259\t                try:\n260\t                    if not _audit_hmac.is_disabled():\n261\t                        _b3_key = _audit_hmac.get_or_create_key()\n262\t                        _b3_prev = _audit_hmac.read_prev_hmac()  # WITH the lock held\n263\t                        _b3_hmac_digest_bytes = _audit_hmac.compute_entry_hmac(\n264\t                            _b3_key, _b3_prev,\n265\t                            {k: v for k, v in entry.items()\n266\t                             if k not in (\"hmac\", \"hmac_error\")},\n267\t                        )\n268\t                        entry[\"hmac\"] = _audit_hmac.hex_digest(_b3_hmac_digest_bytes)\n269\t                except Exception as _b3_he:\n270\t                    _b3_hmac_digest_bytes = None\n271\t                    entry[\"hmac\"] = None\n272\t                    entry[\"hmac_error\"] = type(_b3_he).__name__\n273\t            # Serialize AFTER the hmac field is final (still under the lock).\n274\t            line = json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n275\t            try:\n276\t                # PLAN-024 F-sec-002 P1 fix: os.open with mode=0o600 sets perms\n277\t                # at create-time, closing the default-umask window between\n278\t                # open() and os.chmod().\n279\t                fd = os.open(\n280\t                    paths[\"log\"],\n281\t                    os.O_WRONLY | os.O_CREAT | os.O_APPEND,\n282\t                    0o600,\n283\t                )\n284\t                with os.fdopen(fd, \"a\", encoding=\"utf-8\") as f:\n285\t                    f.write(line + \"\\n\")\n286\t                    # PLAN-025 F-obs-002: flush + fsync so the append survives\n287\t                    # process/OS crash. Audit is source-of-truth for governance;\n288\t                    # silent loss after write() but before OS flush = forensic gap.\n289\t                    # Cost: one syscall per spawn (~200us). Tolerable vs the\n290\t                    # governance invariant \"every spawn is recorded\".\n291\t                    f.flush()\n292\t                    try:\n293\t                        os.fsync(f.fileno())\n294\t                    except (OSError, AttributeError):\n295\t                        # AttributeError on platforms without fsync; OSError on\n296\t                        # read-only fds or closed streams. Both acceptable — the\n297\t                        # write already succeeded; fsync is best-effort durability.\n298\t                        pass\n299\t                # Belt-and-braces: retighten in case file pre-existed looser\n300\t                try:\n301\t                    os.chmod(paths[\"log\"], 0o600)\n302\t                except OSError:\n303\t                    pass\n304\t                # PLAN-085 Wave B.3 — update last-hmac sidecar within lock\n305\t                # so the next writer reads the correct prev_hmac. Best-effort.\n306\t                if _b3_hmac_digest_bytes is not None and _audit_hmac is not None:\n307\t                    try:\n308\t                        _audit_hmac.write_last_hmac(_b3_hmac_digest_bytes)\n309\t                    except Exception:\n310\t                        pass\n311\t            except OSError as e:\n312\t                write_breadcrumb(paths[\"err\"], f\"append failed: {e}  line={line[:200]}\")\n313\t    except FileLockTimeout:\n314\t        # Fail-open: entry dropped (never chained), session never blocked;\n315\t        # the HMAC only exists under the lock, so the breadcrumb lacks it.\n316\t        line = line or json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n317\t        write_breadcrumb(\n318\t            paths[\"err\"],\n319\t            f\"lock timeout (stale?)  would-log={line[:200]}\",\n320\t        )\n321\t    except Exception as e:  # pragma: no cover\n322\t        write_breadcrumb(paths[\"err\"], f\"unexpected error: {e}\")\n323\t\n324\t\n325\tdef _emit_rotation_marker_under_lock(\n326\t    log_path: Path, rotated_to: Path, err_path: Path\n327\t) -> bool:\n328\t    \"\"\"ADR-055-AMEND-2 marker (emitter/drain helper) after OUR rotation, lock held. True =\n329\t    marker on disk or chain off; False = no marker on disk (when its append failed, last-hmac\n330\t    already names it), so the caller signs nothing over it.\"\"\"\n331\t    try:\n332\t        from _lib import audit_hmac as _ah\n333\t        if _ah.is_disabled():\n334\t            return True\n335\t        from _lib import audit_emit as _ae\n336\t        if _ae._emit_chain_reset_marker_under_lock(\n337\t                log=log_path, previous_archive_path=str(rotated_to),\n338\t                rotation_trigger=\"size_threshold\") is not None:\n339\t            return True\n340\t        why = \"helper returned None\"\n341\t    except Exception as e:\n342\t        why = f\"{type(e).__name__}: {e}\"\n343\t    write_breadcrumb(err_path, f\"chain_reset_marker not written ({why}); \"\n344\t                     \"this agent_spawn line is left unchained\")\n345\t    return False\n346\t\n347\t\n348\t# -----------------------------------------------------------------------------\n349\t# PLAN-155 Wave 4 — Codex host-wire audit-chain path (SENT-CX-B / ADR-161)\n350\t# -----------------------------------------------------------------------------\n351\t#\n352\t# Under OpenAI Codex (CEO_HOOK_ADAPTER=codex) the same audit_log.py hook is\n353\t# registered on the PostToolUse `*` matcher (templates/codex/hooks.json) and,\n354\t# via the headless `scripts/codex-exec-wrapper.sh`, is fed synthesized\n355\t# SessionStart/Stop bracket envelopes. The codex path reads the codex host\n356\t# wire through the codex adapter and appends metadata-only records to the SAME\n357\t# HMAC chain via `_lib.audit_emit` (the single-writer emitter that verify_chain\n358\t# validates). Two NEW registered actions keep the per-tool append and the\n359\t# turn-level backstop COUNTABLE separately (PLAN-155 Wave 4-A / Wave 4-B):\n360\t#\n361\t#   PostToolUse (any tool)  -> emit_codex_tool_recorded   (per-tool append, A)\n362\t#   Stop / SubagentStop     -> emit_codex_turn_ended      (turn backstop, B)\n363\t#   SessionStart            -> emit_session_start          (boot bracket; only\n364\t#                              reached via the wrapper — production codex\n365\t#                              routes SessionStart to SessionStart.py, so there\n366\t#                              is no double-count)\n367\t#\n368\t# The claude (default) path below is UNCHANGED and byte-identical when\n369\t# CEO_HOOK_ADAPTER is unset/`claude`. Completeness residual (named, ADR-161 +\n370\t# degradation page): partial shell interception means a per-tool row may be\n371\t# absent — absence is not evidence of absence of activity. verify_chain() and\n372\t# the HMAC chain shape are untouched; this path only appends.\n373\t\n374\t# Closed tool-name enum mirror of _lib.audit_emit._CODEX_TOOL_RECORDED_TOOL_NAME_ENUM.\n375\t# The codex adapter has already aliased apply_patch -> Write/Edit and\n376\t# spawn_agent -> Task before we see the event; here we only fold mcp__* down to\n377\t# `mcp_other` (MF-SEC-1) and leave the emitter to coerce any residual miss to\n378\t# `other`.\n379\t"}]},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"0d9b87f0-7713-4ee5-b063-0e4ff4d05347","timestamp":"2026-11-16T19:19:30.628Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_log_parts/rotation_storage.py","content":"\"\"\"Rotation, safe storage, and append declarations.\"\"\"\nfrom __future__ import annotations\n\ndef rotate_if_needed(log_path: Path, threshold_bytes: int) -> Optional[Path]:\n    \"\"\"Rename log_path to a monthly rotated file if it exceeds the threshold.\n\n    Must be called UNDER the lock so no concurrent writer can race.\n\n    PLAN-045 Wave 2 P0-08: delegates to ``_lib.audit_rotation.rotate_if_needed``\n    so both write paths (this ``append_entry`` + ``_lib.audit_emit._write_event``)\n    share identical rotation semantics. Preserves the existing call\n    signature for backwards compatibility.\n\n    PLAN-044 audit-v2 C6-P0-02 fix (Wave B): on successful rotation,\n    invoke ``audit_hmac.reset_chain_on_rotation()`` so the HMAC chain\n    starts a fresh genesis on the new log file. Without this, rotated\n    logs continue chain from the previous final hmac into the new\n    file's genesis row, which `audit-verify-chain.py` cannot validate\n    (genesis is by definition prev_hmac=GENESIS_PREV; a non-genesis\n    prev_hmac after rotation looks like silent tamper). Pattern was\n    already correct in ``_lib.audit_emit._write_event`` — Wave B brings\n    ``audit_log.py`` to parity.\n\n    Returns the rotated path if rotation happened, None otherwise.\n    \"\"\"\n    try:\n        from _lib.audit_rotation import rotate_if_needed as _shared_rotate\n    except ImportError:\n        # Defensive: if the shared primitive isn't available (partial\n        # install), fall back to the inlined legacy implementation so\n        # rotation still works in the classic path.\n        rotated = _legacy_rotate_inline(log_path, threshold_bytes)\n    else:\n        rotated = _shared_rotate(log_path, threshold_bytes, now_month_slug())\n\n    # PLAN-044 audit-v2 C6-P0-02 — reset the per-process HMAC chain\n    # state so the next entry written to the fresh log file is a\n    # GENESIS_PREV-rooted row. Best-effort: missing _lib.audit_hmac\n    # is non-fatal (older installs); chain integrity tests will catch\n    # any rotated row that violates the genesis rule.\n    if rotated is not None:\n        try:\n            from _lib import audit_hmac as _audit_hmac\n            if hasattr(_audit_hmac, \"reset_chain_on_rotation\"):\n                _audit_hmac.reset_chain_on_rotation()\n        except Exception:\n            pass\n    return rotated\n\n\ndef _legacy_rotate_inline(\n    log_path: Path, threshold_bytes: int\n) -> Optional[Path]:\n    \"\"\"Fallback rotation for the rare case ``_lib.audit_rotation`` is missing.\n\n    Kept in-line so a half-installed framework still rotates. Mirrors\n    the behavior of the shared primitive byte-for-byte.\n    \"\"\"\n    try:\n        if not log_path.is_file():\n            return None\n        size = log_path.stat().st_size\n        if size <= threshold_bytes:\n            return None\n    except OSError:\n        return None\n\n    month = now_month_slug()\n    base = log_path.parent / f\"{log_path.stem}-{month}.jsonl\"\n    candidate = base\n    counter = 1\n    while candidate.exists():\n        candidate = log_path.parent / f\"{log_path.stem}-{month}-{counter}.jsonl\"\n        counter += 1\n        if counter > 1000:\n            return None\n\n    try:\n        os.replace(str(log_path), str(candidate))\n    except OSError:\n        return None\n    return candidate\n\n\n# -----------------------------------------------------------------------------\n# Error breadcrumb\n# -----------------------------------------------------------------------------\n\n\ndef write_breadcrumb(err_path: Path, message: str) -> None:\n    \"\"\"Best-effort write to the errors log. Never raises.\"\"\"\n    try:\n        err_path.parent.mkdir(parents=True, exist_ok=True)\n        ts = now_iso_utc()\n        with open(err_path, \"a\", encoding=\"utf-8\") as f:\n            f.write(f\"[{ts}] {message}\\n\")\n    except OSError:\n        # Last-resort: stderr\n        try:\n            sys.stderr.write(f\"[audit-log] breadcrumb write failed: {message}\\n\")\n        except Exception:  # pragma: no cover\n            pass\n\n\n# -----------------------------------------------------------------------------\n# PLAN-045 F-01-06 — symlink + ownership defense\n# -----------------------------------------------------------------------------\n\n\ndef _is_safe_audit_path(\n    path: Path, expected_uid: int\n) -> Tuple[bool, str]:\n    \"\"\"Check audit path for symlink + ownership safety.\n\n    Returns ``(True, \"\")`` if safe (nonexistent OR real file/dir owned\n    by ``expected_uid``). Returns ``(False, reason)`` if unsafe\n    (symlink OR owner mismatch).\n\n    Uses ``os.lstat`` (not ``stat``) so symlinks themselves are\n    inspected rather than their targets. Never raises.\n\n    ## Threat model\n\n    1. **Symlink redirection.** An attacker with write access to\n       ``$HOME/.claude/projects/`` creates\n       ``ceo-orchestration -> /tmp/evil``. Every append goes to\n       attacker-controlled path, defeats tamper-evident audit trail.\n    2. **UID squatting.** Another user's process creates the audit\n       directory. Hook runs as current user → fails to open for\n       append (EACCES) OR leaks sensitive data into foreign-owned\n       file if perms are too permissive.\n\n    Both are refused before any write. The caller logs a breadcrumb\n    to the /tmp fallback path and returns silently (fail-open on\n    session; forensic trail preserved).\n    \"\"\"\n    try:\n        st = path.lstat()\n    except FileNotFoundError:\n        # Nonexistent is safe — the normal first-write path.\n        return (True, \"\")\n    except OSError as e:\n        return (False, f\"lstat_error:{e.__class__.__name__}\")\n    if stat.S_ISLNK(st.st_mode):\n        return (False, \"symlink_rejected\")\n    if st.st_uid != expected_uid:\n        return (\n            False,\n            f\"uid_mismatch:owner={st.st_uid} proc={expected_uid}\",\n        )\n    return (True, \"\")\n\n\ndef _fallback_security_breadcrumb(message: str) -> None:\n    \"\"\"Breadcrumb to ``/tmp`` fallback when primary audit dir is unsafe.\n\n    Mirrors ``_lib.audit_emit._fallback_log_path`` pattern. Never\n    raises. Writes under the current user's namespaced filename so\n    multi-user systems don't clobber each other.\n    \"\"\"\n    try:\n        try:\n            user = getpass.getuser() or \"unknown\"\n        except Exception:\n            user = os.environ.get(\"USER\") or \"unknown\"\n        user = \"\".join(\n            c for c in user if c.isalnum() or c in (\"-\", \"_\", \".\")\n        )\n        fallback = Path(\"/tmp\") / f\"ceo-audit-fallback-{user}.log\"\n        ts = now_iso_utc()\n        with open(fallback, \"a\", encoding=\"utf-8\") as f:\n            f.write(f\"[{ts}] audit-log security: {message}\\n\")\n    except Exception:\n        pass\n\n\n# -----------------------------------------------------------------------------\n# Append entry under lock\n# -----------------------------------------------------------------------------\n\n\ndef append_entry(\n    entry: Dict[str, Any],\n    *,\n    paths: Dict[str, Path],\n    threshold_bytes: int,\n) -> None:\n    \"\"\"Append a single JSONL line under the lock, rotating if needed.\n\n    Any failure is logged to the errors breadcrumb and swallowed (fail-open).\n\n    PLAN-045 F-01-06: pre-write symlink + ownership check on audit dir\n    and audit log file. On violation, breadcrumb to /tmp fallback +\n    return silently (fail-open on session; entry dropped but forensic\n    trail preserved via fallback + upstream audit_emit).\n    \"\"\"\n    # F-01-06 symlink + uid defense BEFORE any mkdir/write.\n    # Rationale: an attacker who plants a symlink in the audit dir can\n    # redirect writes. Ownership mismatch indicates another user's\n    # process created the path. Both warrant refusal + breadcrumb.\n    expected_uid = os.geteuid()\n    ok, reason = _is_safe_audit_path(paths[\"dir\"], expected_uid)\n    if not ok:\n        _fallback_security_breadcrumb(\n            f\"audit dir unsafe: {paths['dir']} ({reason})\"\n        )\n        return\n    ok, reason = _is_safe_audit_path(paths[\"log\"], expected_uid)\n    if not ok:\n        _fallback_security_breadcrumb(\n            f\"audit log unsafe: {paths['log']} ({reason})\"\n        )\n        return\n    # Ensure dir exists with restrictive perms\n    # PLAN-024 F-sec-001 P1 fix: mkdir(mode=0o700) closes TOCTOU micro-window\n    # between mkdir() and os.chmod() where same-UID attacker could win a race.\n    try:\n        paths[\"dir\"].mkdir(parents=True, exist_ok=True, mode=0o700)\n        # Belt-and-braces: retighten in case dir pre-existed with looser perms\n        try:\n            os.chmod(paths[\"dir\"], 0o700)\n        except OSError:\n            pass\n    except OSError as e:\n        write_breadcrumb(paths[\"err\"], f\"cannot create audit dir: {e}\")\n        return\n\n    # PLAN-085 Wave B.3 — inline HMAC computation closes the two-writer\n    # chain gap (F-C1-001 / T0-line-168 transition_violation root cause).\n    # 100% of agent_spawn events now carry hmac field per ADR-055.\n    # Reuses _lib/audit_hmac primitives; fail-OPEN per CLAUDE.md §5.\n    # PLAN-194 (rc.1 condition 67): key, predecessor, HMAC, append and sidecar\n    # share ONE FileLock (as in audit_emit/drain); read before it, a writer in\n    # between forked the chain. Only the stateless import stays outside.\n    entry.setdefault(\"hmac\", None)\n    entry.setdefault(\"hmac_error\", None)\n    _audit_hmac = None\n    try:\n        from _lib import audit_hmac as _audit_hmac\n    except Exception as _b3_ie:\n        entry[\"hmac\"] = None\n        entry[\"hmac_error\"] = type(_b3_ie).__name__\n\n    line = \"\"\n\n    try:\n        with FileLock(paths[\"lock\"], timeout=2.5):\n            # Rotate inside the lock so writers can't race past a rename\n            rotated_to = rotate_if_needed(paths[\"log\"], threshold_bytes)\n            # ADR-055-AMEND-2 marker as line 1 BEFORE our HMAC reads the predecessor;\n            # no marker on disk => never sign over a last-hmac that may name it.\n            marker_ok = rotated_to is None or _emit_rotation_marker_under_lock(\n                paths[\"log\"], rotated_to, paths[\"err\"])\n            _b3_hmac_digest_bytes = None\n            if _audit_hmac is not None and not marker_ok:\n                entry[\"hmac\"] = None\n                entry[\"hmac_error\"] = \"chain_reset_marker_missing\"\n            elif _audit_hmac is not None:\n                try:\n                    if not _audit_hmac.is_disabled():\n                        _b3_key = _audit_hmac.get_or_create_key()\n                        _b3_prev = _audit_hmac.read_prev_hmac()  # WITH the lock held\n                        _b3_hmac_digest_bytes = _audit_hmac.compute_entry_hmac(\n                            _b3_key, _b3_prev,\n                            {k: v for k, v in entry.items()\n                             if k not in (\"hmac\", \"hmac_error\")},\n                        )\n                        entry[\"hmac\"] = _audit_hmac.hex_digest(_b3_hmac_digest_bytes)\n                except Exception as _b3_he:\n                    _b3_hmac_digest_bytes = None\n                    entry[\"hmac\"] = None\n                    entry[\"hmac_error\"] = type(_b3_he).__name__\n            # Serialize AFTER the hmac field is final (still under the lock).\n            line = json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n            try:\n                # PLAN-024 F-sec-002 P1 fix: os.open with mode=0o600 sets perms\n                # at create-time, closing the default-umask window between\n                # open() and os.chmod().\n                fd = os.open(\n                    paths[\"log\"],\n                    os.O_WRONLY | os.O_CREAT | os.O_APPEND,\n                    0o600,\n                )\n                with os.fdopen(fd, \"a\", encoding=\"utf-8\") as f:\n                    f.write(line + \"\\n\")\n                    # PLAN-025 F-obs-002: flush + fsync so the append survives\n                    # process/OS crash. Audit is source-of-truth for governance;\n                    # silent loss after write() but before OS flush = forensic gap.\n                    # Cost: one syscall per spawn (~200us). Tolerable vs the\n                    # governance invariant \"every spawn is recorded\".\n                    f.flush()\n                    try:\n                        os.fsync(f.fileno())\n                    except (OSError, AttributeError):\n                        # AttributeError on platforms without fsync; OSError on\n                        # read-only fds or closed streams. Both acceptable — the\n                        # write already succeeded; fsync is best-effort durability.\n                        pass\n                # Belt-and-braces: retighten in case file pre-existed looser\n                try:\n                    os.chmod(paths[\"log\"], 0o600)\n                except OSError:\n                    pass\n                # PLAN-085 Wave B.3 — update last-hmac sidecar within lock\n                # so the next writer reads the correct prev_hmac. Best-effort.\n                if _b3_hmac_digest_bytes is not None and _audit_hmac is not None:\n                    try:\n                        _audit_hmac.write_last_hmac(_b3_hmac_digest_bytes)\n                    except Exception:\n                        pass\n            except OSError as e:\n                write_breadcrumb(paths[\"err\"], f\"append failed: {e}  line={line[:200]}\")\n    except FileLockTimeout:\n        # Fail-open: entry dropped (never chained), session never blocked;\n        # the HMAC only exists under the lock, so the breadcrumb lacks it.\n        line = line or json.dumps(entry, ensure_ascii=False, separators=(\",\", \":\"))\n        write_breadcrumb(\n            paths[\"err\"],\n            f\"lock timeout (stale?)  would-log={line[:200]}\",\n        )\n    except Exception as e:  # pragma: no cover\n        write_breadcrumb(paths[\"err\"], f\"unexpected error: {e}\")\n\n\ndef _emit_rotation_marker_under_lock(\n    log_path: Path, rotated_to: Path, err_path: Path\n) -> bool:\n    \"\"\"ADR-055-AMEND-2 marker (emitter/drain helper) after OUR rotation, lock held. True =\n    marker on disk or chain off; False = no marker on disk (when its append failed, last-hmac\n    already names it), so the caller signs nothing over it.\"\"\"\n    try:\n        from _lib import audit_hmac as _ah\n        if _ah.is_disabled():\n            return True\n        from _lib import audit_emit as _ae\n        if _ae._emit_chain_reset_marker_under_lock(\n                log=log_path, previous_archive_path=str(rotated_to),\n                rotation_trigger=\"size_threshold\") is not None:\n            return True\n        why = \"helper returned None\"\n    except Exception as e:\n        why = f\"{type(e).__name__}: {e}\"\n    write_breadcrumb(err_path, f\"chain_reset_marker not written ({why}); \"\n                     \"this agent_spawn line is left unchained\")\n    return False\n\n\n# -----------------------------------------------------------------------------\n# PLAN-155 Wave 4 — Codex host-wire audit-chain path (SENT-CX-B / ADR-161)\n# -----------------------------------------------------------------------------\n#\n# Under OpenAI Codex (CEO_HOOK_ADAPTER=codex) the same audit_log.py hook is\n# registered on the PostToolUse `*` matcher (templates/codex/hooks.json) and,\n# via the headless `scripts/codex-exec-wrapper.sh`, is fed synthesized\n# SessionStart/Stop bracket envelopes. The codex path reads the codex host\n# wire through the codex adapter and appends metadata-only records to the SAME\n# HMAC chain via `_lib.audit_emit` (the single-writer emitter that verify_chain\n# validates). Two NEW registered actions keep the per-tool append and the\n# turn-level backstop COUNTABLE separately (PLAN-155 Wave 4-A / Wave 4-B):\n#\n#   PostToolUse (any tool)  -> emit_codex_tool_recorded   (per-tool append, A)\n#   Stop / SubagentStop     -> emit_codex_turn_ended      (turn backstop, B)\n#   SessionStart            -> emit_session_start          (boot bracket; only\n#                              reached via the wrapper — production codex\n#                              routes SessionStart to SessionStart.py, so there\n#                              is no double-count)\n#\n# The claude (default) path below is UNCHANGED and byte-identical when\n# CEO_HOOK_ADAPTER is unset/`claude`. Completeness residual (named, ADR-161 +\n# degradation page): partial shell interception means a per-tool row may be\n# absent — absence is not evidence of absence of activity. verify_chain() and\n# the HMAC chain shape are untouched; this path only appends.\n\n# Closed tool-name enum mirror of _lib.audit_emit._CODEX_TOOL_RECORDED_TOOL_NAME_ENUM.\n# The codex adapter has already aliased apply_patch -> Write/Edit and\n# spawn_agent -> Task before we see the event; here we only fold mcp__* down to\n# `mcp_other` (MF-SEC-1) and leave the emitter to coerce any residual miss to\n# `other`.\n","numLines":379,"startLine":1,"totalLines":379}},"tool_result_meta":[{"id":"toolu_01MguEbCWnFMxJZuWGgLgpyf","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
