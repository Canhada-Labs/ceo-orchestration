{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0193iELZHyLUXqoveomiRTAr","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\t__all__ = ('main',)\n4\t\n5\tdef main() -> int:\n6\t    \"\"\"Hook entry point: read stdin, decide, write stdout, exit 0.\n7\t\n8\t    PLAN-006 Phase 1 migration (ADR-014): Adapter Layer I/O.\n9\t    Fail-open on any exception.\n10\t    \"\"\"\n11\t    try:\n12\t        if _SPAWN_COMPONENT_IMPORT_ERROR is not None:\n13\t            print(\"[check_agent_spawn] component import unavailable (\" +\n14\t                  _SPAWN_COMPONENT_IMPORT_ERROR + \")\", file=sys.stderr)\n15\t            _claude_adapter.emit_decision(_contract.allow())\n16\t            return 0\n17\t        event = _claude_adapter.read_event(phase=\"PreToolUse\")\n18\t        if event.parse_error:\n19\t            print(\n20\t                f\"[check_agent_spawn] WARN: stdin parse error: {event.parse_error}\",\n21\t                file=sys.stderr,\n22\t            )\n23\t            _claude_adapter.emit_decision(_contract.allow())\n24\t            return 0\n25\t\n26\t        project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n27\t        try:\n28\t            names_regex = _team.load_names(project_dir)\n29\t        except Exception as e:  # pragma: no cover\n30\t            print(\n31\t                f\"[check_agent_spawn] WARN: team load failed: {e}\",\n32\t                file=sys.stderr,\n33\t            )\n34\t            names_regex = None\n35\t\n36\t        decision = decide(\n37\t            description=event.description,\n38\t            prompt=event.prompt,\n39\t            names_regex=names_regex,\n40\t            subagent_type=event.subagent_type,\n41\t        )\n42\t\n43\t        # Side-effect: emit veto_triggered event on block path (v2 stream).\n44\t        # Session 75 Codex re-pass: reason_code derived from decision.reason\n45\t        # via _classify_block_reason() so the audit trail correctly\n46\t        # discriminates secret_in_spawn_prompt / effort_token_in_spawn /\n47\t        # architect_role_not_delegable / veto_floor_demoted / etc.\n48\t        # Previously hardcoded \"missing_skill_content\" misclassified all blocks.\n49\t        if not decision.allow and _AUDIT_EMIT_AVAILABLE:\n50\t            try:\n51\t                _audit_emit.emit_veto_triggered(\n52\t                    hook=\"check_agent_spawn\",\n53\t                    reason_code=_classify_block_reason(decision.reason or \"\"),\n54\t                    reason_preview=decision.reason or \"\",\n55\t                    blocked_tool=\"Agent\",\n56\t                    project=project_dir,\n57\t                )\n58\t            except Exception:\n59\t                pass\n60\t\n61\t        _claude_adapter.emit_decision(_to_contract_decision(decision))\n62\t        return 0\n63\t    except Exception as e:  # pragma: no cover\n64\t        print(\n65\t            f\"[check_agent_spawn] FATAL: {e.__class__.__name__}: {e}\",\n66\t            file=sys.stderr,\n67\t        )\n68\t        _claude_adapter.emit_decision(_contract.allow())\n69\t        return 0\n70\t"}]},"parent_tool_use_id":null,"session_id":"178172ab-278a-4318-ba3b-1534bf22937a","uuid":"da516ff5-e08c-4e0b-ba69-e8a5dc624a53","timestamp":"2026-11-16T19:17:56.895Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/agent_spawn/entrypoint.py","content":"from __future__ import annotations\n\n__all__ = ('main',)\n\ndef main() -> int:\n    \"\"\"Hook entry point: read stdin, decide, write stdout, exit 0.\n\n    PLAN-006 Phase 1 migration (ADR-014): Adapter Layer I/O.\n    Fail-open on any exception.\n    \"\"\"\n    try:\n        if _SPAWN_COMPONENT_IMPORT_ERROR is not None:\n            print(\"[check_agent_spawn] component import unavailable (\" +\n                  _SPAWN_COMPONENT_IMPORT_ERROR + \")\", file=sys.stderr)\n            _claude_adapter.emit_decision(_contract.allow())\n            return 0\n        event = _claude_adapter.read_event(phase=\"PreToolUse\")\n        if event.parse_error:\n            print(\n                f\"[check_agent_spawn] WARN: stdin parse error: {event.parse_error}\",\n                file=sys.stderr,\n            )\n            _claude_adapter.emit_decision(_contract.allow())\n            return 0\n\n        project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n        try:\n            names_regex = _team.load_names(project_dir)\n        except Exception as e:  # pragma: no cover\n            print(\n                f\"[check_agent_spawn] WARN: team load failed: {e}\",\n                file=sys.stderr,\n            )\n            names_regex = None\n\n        decision = decide(\n            description=event.description,\n            prompt=event.prompt,\n            names_regex=names_regex,\n            subagent_type=event.subagent_type,\n        )\n\n        # Side-effect: emit veto_triggered event on block path (v2 stream).\n        # Session 75 Codex re-pass: reason_code derived from decision.reason\n        # via _classify_block_reason() so the audit trail correctly\n        # discriminates secret_in_spawn_prompt / effort_token_in_spawn /\n        # architect_role_not_delegable / veto_floor_demoted / etc.\n        # Previously hardcoded \"missing_skill_content\" misclassified all blocks.\n        if not decision.allow and _AUDIT_EMIT_AVAILABLE:\n            try:\n                _audit_emit.emit_veto_triggered(\n                    hook=\"check_agent_spawn\",\n                    reason_code=_classify_block_reason(decision.reason or \"\"),\n                    reason_preview=decision.reason or \"\",\n                    blocked_tool=\"Agent\",\n                    project=project_dir,\n                )\n            except Exception:\n                pass\n\n        _claude_adapter.emit_decision(_to_contract_decision(decision))\n        return 0\n    except Exception as e:  # pragma: no cover\n        print(\n            f\"[check_agent_spawn] FATAL: {e.__class__.__name__}: {e}\",\n            file=sys.stderr,\n        )\n        _claude_adapter.emit_decision(_contract.allow())\n        return 0\n","numLines":70,"startLine":1,"totalLines":70}},"tool_result_meta":[{"id":"toolu_0193iELZHyLUXqoveomiRTAr","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
