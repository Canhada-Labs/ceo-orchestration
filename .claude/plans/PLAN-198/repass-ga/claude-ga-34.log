{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016WVXMwqc6aNgZRQj5juGHV","type":"tool_result","content":"1\t#!/usr/bin/env bash\n2\t# _codex_harness.sh — Codex (OpenAI) harness emission for install.sh / upgrade.sh\n3\t# =============================================================================\n4\t# PLAN-155 Wave 5 (SENT-CX-C). Single source of truth for the `--harness codex`\n5\t# path: it EMITS the `.codex/` registration bundle, the operator `AGENTS.md`,\n6\t# the optional managed `requirements.toml`, the inverted-pair-rail reviewer\n7\t# guidance, records a lifecycle manifest, and runs the post-install arming\n8\t# check. install.sh and upgrade.sh both `source` this file (like _hash_lib.sh),\n9\t# so the codex logic lives in exactly one place.\n10\t#\n11\t# NEW unguarded companion (rides the SENT-CX-C commit; not canonical-guarded).\n12\t# Sourced, never executed. Stdlib shell only; bash >= 3.2 (no associative\n13\t# arrays / mapfile). shellcheck -S warning clean.\n14\t#\n15\t# HONESTY (binding, PLAN-155 capability matrix):\n16\t#   * NOTHING is enforced until the operator grants /hooks trust. On codex\n17\t#     0.139 an untrusted or modified hook is a SILENT no-op. The arming check\n18\t#     says this loudly and is printed as the installer's FINAL instruction.\n19\t#   * Kill-switch surface protection is ABSENT until PLAN-155 Wave 3b lands.\n20\t#   * No speed claim anywhere. The value is governance + auditability.\n21\t#\n22\t# ENV CONTRACT (set by the caller BEFORE sourcing/calling):\n23\t#   Required : TARGET (abs), SOURCE_DIR (abs framework checkout), DRY_RUN (0|1)\n24\t#   Rendered : PH_PROJECT_PATH (abs target path), PH_PROJECT_NAME\n25\t#   Options  : CODEX_MANAGED_HOOKS (0|1), CODEX_WITH_SKILLS (0|1),\n26\t#              CODEX_FORCE (0|1)\n27\t#   Optional : a caller-defined `codex_journal <op> <detail>` recorder\n28\t#              (maps to install.sh:_state_record_op / upgrade.sh:_up_record_op);\n29\t#              a no-op default is provided below if the caller defines none.\n30\t#\n31\t# The kill-switch / template contents are authored in Waves 2/3\n32\t# (templates/codex/**) and guarded in Wave 3b — this file only COPIES +\n33\t# substitutes them; it never inlines their bytes.\n34\t# =============================================================================\n35\t\n36\t# Fail-open recorder default (overridden by the caller if it has a journal).\n37\tif ! command -v codex_journal >/dev/null 2>&1; then\n38\t  codex_journal() { return 0; }\n39\tfi\n40\t\n41\t# ---------------------------------------------------------------------------\n42\t# Version pin (debate A15). Read the semver range shipped in the framework at\n43\t# .claude/governance/codex-cli-pin.txt (last non-comment, non-blank line);\n44\t# fall back to the PLAN-142-verified range if that file is absent.\n45\t# ---------------------------------------------------------------------------\n46\tCODEX_VERIFIED_VERSION=\"0.160.0\"   # default semantic floor when the canonical pin is absent\n47\t\n48\t_codex_pin_range() {\n49\t  local pin_file=\"$SOURCE_DIR/.claude/governance/codex-cli-pin.txt\"\n50\t  local line=\"\"\n51\t  if [[ -f \"$pin_file\" ]]; then\n52\t    # last line that is neither blank nor a comment\n53\t    line=\"$(grep -vE '^[[:space:]]*(#|$)' \"$pin_file\" 2>/dev/null | tail -n 1 | tr -d '[:space:]')\"\n54\t  fi\n55\t  if [[ -n \"$line\" ]]; then\n56\t    printf '%s\\n' \"$line\"\n57\t  else\n58\t    printf '%s\\n' \">=0.160.0\"\n59\t  fi\n60\t}\n61\t\n62\t# `codex --version` -> bare \"X.Y.Z\" (or empty if the binary is absent/opaque).\n63\t_codex_detect_version() {\n64\t  command -v codex >/dev/null 2>&1 || return 0\n65\t  local raw=\"\"\n66\t  raw=\"$(codex --version 2>/dev/null | head -n 1 || true)\"\n67\t  # Extract the first dotted-number token.\n68\t  printf '%s\\n' \"$raw\" | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -n 1\n69\t}\n70\t\n71\t# $1 >= $2 (semver, via sort -V). Returns 0 (true) / 1 (false).\n72\t_codex_ver_ge() {\n73\t  [ \"$(printf '%s\\n%s\\n' \"$2\" \"$1\" | sort -V 2>/dev/null | head -n 1)\" = \"$2\" ]\n74\t}\n75\t\n76\t# Is $1 inside the range \">=MIN,<MAX\"? Best-effort; unknown grammar => \"in\".\n77\t_codex_ver_in_range() {\n78\t  local ver=\"$1\" range=\"$2\" min=\"\" max=\"\"\n79\t  [[ -n \"$ver\" ]] || return 1\n80\t  min=\"$(printf '%s\\n' \"$range\" | grep -oE '>=[0-9]+\\.[0-9]+\\.[0-9]+' | head -n1 | sed 's/^>=//')\"\n81\t  max=\"$(printf '%s\\n' \"$range\" | grep -oE '<[0-9]+\\.[0-9]+\\.[0-9]+'  | head -n1 | sed 's/^<//')\"\n82\t  if [[ -n \"$min\" ]] && ! _codex_ver_ge \"$ver\" \"$min\"; then return 1; fi\n83\t  # max is exclusive: ver < max  <=>  NOT (ver >= max)\n84\t  if [[ -n \"$max\" ]] && _codex_ver_ge \"$ver\" \"$max\"; then return 1; fi\n85\t  return 0\n86\t}\n87\t\n88\t# Codex 0.139 discovers ZERO hooks inside a git WORKTREE (`.git` is a FILE\n89\t# pointing at the parent). Enforcement is silently absent there — the arming\n90\t# check must flag it loudly (live-fire finding, MANIFEST-A open issue #2).\n91\t_codex_is_git_worktree() {\n92\t  local dir=\"$1\"\n93\t  [[ -f \"$dir/.git\" ]]\n94\t}\n95\t\n96\tCODEX_MANIFEST_REL=\".codex/.ceo-harness-manifest\"\n97\t\n98\t# ---------------------------------------------------------------------------\n99\t# Render a template file: substitute {{PROJECT_PATH}} and {{PROJECT_NAME}} into\n100\t# $dst. Collision policy (debate A10):\n101\t#   - dst missing            => write (record emit)\n102\t#   - dst == rendered bytes  => SKIP (idempotent re-run, no error)\n103\t#   - dst differs, no --force=> REFUSE: print a unified diff, set the refusal\n104\t#                               flag; NEVER clobber\n105\t#   - dst differs, --force   => back up dst to <dst>.ceo-bak-<ts>, write,\n106\t#                               record both backup + emit\n107\t# Uses only literal string replacement (no sed metachar hazards): python3 when\n108\t# present, else a portable awk fallback.\n109\t# ---------------------------------------------------------------------------\n110\t_CODEX_REFUSED=0          # set to 1 by any refused collision this run\n111\t_CODEX_MANIFEST_EMITS=\"\"  # newline list: relpath\n112\t_CODEX_MANIFEST_BACKUPS=\"\" # newline list: relpath<TAB>backup-relpath\n113\t\n114\t_codex_render_to_stdout() {\n115\t  local src=\"$1\"\n116\t  if command -v python3 >/dev/null 2>&1; then\n117\t    PYTHONNOUSERSITE=1 python3 -I -c '\n118\timport sys\n119\tsrc, pp, pn = sys.argv[1], sys.argv[2], sys.argv[3]\n120\twith open(src, \"r\", encoding=\"utf-8\") as f:\n121\t    data = f.read()\n122\tdata = data.replace(\"{{PROJECT_PATH}}\", pp).replace(\"{{PROJECT_NAME}}\", pn)\n123\tsys.stdout.write(data)\n124\t' \"$src\" \"$PH_PROJECT_PATH\" \"$PH_PROJECT_NAME\"\n125\t  else\n126\t    # awk fallback: literal, index-based replacement (no regex).\n127\t    awk -v pp=\"$PH_PROJECT_PATH\" -v pn=\"$PH_PROJECT_NAME\" '\n128\t      function repl(s, needle, val,   out, i) {\n129\t        out = \"\"\n130\t        while ((i = index(s, needle)) > 0) {\n131\t          out = out substr(s, 1, i - 1) val\n132\t          s = substr(s, i + length(needle))\n133\t        }\n134\t        return out s\n135\t      }\n136\t      { line = repl($0, \"{{PROJECT_PATH}}\", pp); line = repl(line, \"{{PROJECT_NAME}}\", pn); print line }\n137\t    ' \"$src\"\n138\t  fi\n139\t}\n140\t\n141\t_codex_emit_file() {\n142\t  local src_rel=\"$1\" dst_rel=\"$2\"\n143\t  local src=\"$SOURCE_DIR/$src_rel\"\n144\t  local dst=\"$TARGET/$dst_rel\"\n145\t\n146\t  if [[ ! -f \"$src\" ]]; then\n147\t    echo \"    SKIP (template missing): $src_rel\" >&2\n148\t    return 0\n149\t  fi\n150\t\n151\t  # Render to a temp so we can compare + reuse.\n152\t  local tmp=\"\"\n153\t  tmp=\"$(mktemp \"${TMPDIR:-/tmp}/ceo-codex-render.XXXXXX\" 2>/dev/null || true)\"\n154\t  if [[ -z \"$tmp\" ]]; then\n155\t    echo \"    ERROR: cannot allocate tempfile for $dst_rel\" >&2\n156\t    return 1\n157\t  fi\n158\t  _codex_render_to_stdout \"$src\" > \"$tmp\" 2>/dev/null\n159\t\n160\t  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n161\t    if [[ -e \"$dst\" ]]; then\n162\t      if diff -q \"$dst\" \"$tmp\" >/dev/null 2>&1; then\n163\t        echo \"    (dry-run) EXISTS identical (would skip): $dst_rel\"\n164\t      elif [[ \"${CODEX_FORCE:-0}\" -eq 1 ]]; then\n165\t        echo \"    (dry-run) DIFFERS (would --force backup+overwrite): $dst_rel\"\n166\t      else\n167\t        echo \"    (dry-run) DIFFERS (would REFUSE — pass --force to overwrite): $dst_rel\"\n168\t      fi\n169\t    else\n170\t      echo \"    (dry-run) would CREATE: $dst_rel\"\n171\t    fi\n172\t    rm -f \"$tmp\" 2>/dev/null || true\n173\t    return 0\n174\t  fi\n175\t\n176\t  mkdir -p \"$( dirname \"$dst\" )\"\n177\t\n178\t  if [[ -e \"$dst\" ]]; then\n179\t    if diff -q \"$dst\" \"$tmp\" >/dev/null 2>&1; then\n180\t      echo \"    EXISTS identical (skipping): $dst_rel\"\n181\t      _CODEX_MANIFEST_EMITS=\"${_CODEX_MANIFEST_EMITS}${dst_rel}\"$'\\n'\n182\t      rm -f \"$tmp\" 2>/dev/null || true\n183\t      return 0\n184\t    fi\n185\t    if [[ \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n186\t      echo \"::error::refusing to overwrite pre-existing $dst_rel (pass --force to override)\" >&2\n187\t      echo \"    --- current (on disk) vs would-install (diff) ---\" >&2\n188\t      diff -u \"$dst\" \"$tmp\" 2>/dev/null | head -40 >&2 || true\n189\t      _CODEX_REFUSED=1\n190\t      rm -f \"$tmp\" 2>/dev/null || true\n191\t      return 0\n192\t    fi\n193\t    # --force: back up, then overwrite.\n194\t    local ts bak\n195\t    ts=\"$(date +%Y%m%d-%H%M%S)\"\n196\t    bak=\"${dst_rel}.ceo-bak-${ts}\"\n197\t    cp \"$dst\" \"$TARGET/$bak\"\n198\t    _CODEX_MANIFEST_BACKUPS=\"${_CODEX_MANIFEST_BACKUPS}${dst_rel}\t${bak}\"$'\\n'\n199\t    echo \"    BACKED UP: $dst_rel -> $bak (--force)\"\n200\t  fi\n201\t\n202\t  cp \"$tmp\" \"$dst\"\n203\t  rm -f \"$tmp\" 2>/dev/null || true\n204\t  echo \"    EMITTED: $dst_rel\"\n205\t  _CODEX_MANIFEST_EMITS=\"${_CODEX_MANIFEST_EMITS}${dst_rel}\"$'\\n'\n206\t  codex_journal \"codex_emit\" \"$dst_rel\"\n207\t  return 0\n208\t}\n209\t\n210\t# Write the lifecycle manifest (schema ceo.codex-harness/v1). Carries forward\n211\t# prior backup lines so a later run never loses a restore target. Wave 6's\n212\t# `.git/` pre-push hook APPENDS its emit line to this same ledger, so uninstall\n213\t# reaches it (debate A9 — the third install surface).\n214\t_codex_write_manifest() {\n215\t  [[ \"$DRY_RUN\" -eq 0 ]] || return 0\n216\t  local manifest=\"$TARGET/$CODEX_MANIFEST_REL\"\n217\t  local ver range prior_backups=\"\"\n218\t  ver=\"$(_codex_detect_version)\"\n219\t  range=\"$(_codex_pin_range)\"\n220\t  # Preserve any backup lines already recorded by an earlier run.\n221\t  if [[ -f \"$manifest\" ]]; then\n222\t    prior_backups=\"$(grep -E '^backup\t' \"$manifest\" 2>/dev/null || true)\"\n223\t  fi\n224\t  mkdir -p \"$( dirname \"$manifest\" )\"\n225\t  {\n226\t    echo \"# ceo-orchestration codex harness install manifest (schema ceo.codex-harness/v1)\"\n227\t    echo \"# TAB-separated: kind<TAB>relpath[<TAB>backup-relpath]; kind in {meta,emit,backup}.\"\n228\t    echo \"# uninstall removes 'emit' relpaths (LIFO) and restores 'backup' pairs.\"\n229\t    printf 'meta\\tcodex_cli_version\\t%s\\n' \"${ver:-unknown}\"\n230\t    printf 'meta\\tpin_range\\t%s\\n' \"$range\"\n231\t    printf 'meta\\tmanaged_hooks\\t%s\\n' \"${CODEX_MANAGED_HOOKS:-0}\"\n232\t    # emit lines (unique, in emission order)\n233\t    printf '%s' \"$_CODEX_MANIFEST_EMITS\" | awk 'NF && !seen[$0]++ {printf \"emit\\t%s\\n\", $0}'\n234\t    # backup lines: prior + this run\n235\t    [[ -n \"$prior_backups\" ]] && printf '%s\\n' \"$prior_backups\"\n236\t    printf '%s' \"$_CODEX_MANIFEST_BACKUPS\" | awk -F'\\t' 'NF>=2 {printf \"backup\\t%s\\t%s\\n\", $1, $2}'\n237\t  } > \"$manifest\"\n238\t  echo \"    WROTE: $CODEX_MANIFEST_REL (lifecycle ledger — uninstall/backup source of truth)\"\n239\t  codex_journal \"codex_write_manifest\" \"$CODEX_MANIFEST_REL\"\n240\t}\n241\t\n242\t# The template-backed emit set (src_rel<TAB>dst_rel). requirements.toml is\n243\t# generated inline (not from a template) and handled separately.\n244\t_codex_planned_pairs() {\n245\t  printf 'templates/codex/hooks.json\\t.codex/hooks.json\\n'\n246\t  printf 'templates/codex/rules/ceo.rules\\t.codex/rules/ceo.rules\\n'\n247\t  printf 'templates/codex/AGENTS.md\\tAGENTS.md\\n'\n248\t}\n249\t\n250\t# Pre-flight collision scan (debate A10): render every planned file, compare to\n251\t# any existing target file, and REFUSE the whole bundle (zero writes) if any\n252\t# differs without --force. Atomic: a refusal leaves the target untouched, so\n253\t# there is never a partial `.codex/` to roll back. Returns 0 (clear) / 2\n254\t# (refused — diffs printed).\n255\t_codex_preflight() {\n256\t  local refused=0 src_rel dst_rel src dst tmp\n257\t  while IFS=$'\\t' read -r src_rel dst_rel; do\n258\t    [[ -n \"$src_rel\" ]] || continue\n259\t    src=\"$SOURCE_DIR/$src_rel\"; dst=\"$TARGET/$dst_rel\"\n260\t    [[ -f \"$src\" ]] || continue\n261\t    [[ -e \"$dst\" ]] || continue\n262\t    tmp=\"$(mktemp \"${TMPDIR:-/tmp}/ceo-codex-pf.XXXXXX\" 2>/dev/null || true)\"\n263\t    [[ -n \"$tmp\" ]] || continue\n264\t    _codex_render_to_stdout \"$src\" > \"$tmp\" 2>/dev/null\n265\t    if ! diff -q \"$dst\" \"$tmp\" >/dev/null 2>&1; then\n266\t      if [[ \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n267\t        refused=1\n268\t        echo \"::error::refusing to overwrite pre-existing $dst_rel (pass --force to override)\" >&2\n269\t        echo \"    --- current (on disk) vs would-install (unified diff, head) ---\" >&2\n270\t        diff -u \"$dst\" \"$tmp\" 2>/dev/null | head -40 >&2 || true\n271\t      fi\n272\t    fi\n273\t    rm -f \"$tmp\" 2>/dev/null || true\n274\t  done <<EOF\n275\t$(_codex_planned_pairs)\n276\tEOF\n277\t  # requirements.toml is generated, not template-backed: a plain differ check.\n278\t  if [[ \"${CODEX_MANAGED_HOOKS:-0}\" -eq 1 && -e \"$TARGET/requirements.toml\" && \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n279\t    refused=1\n280\t    echo \"::error::refusing to overwrite pre-existing requirements.toml (pass --force)\" >&2\n281\t  fi\n282\t  [[ \"$refused\" -eq 0 ]]\n283\t}\n284\t\n285\t# ---------------------------------------------------------------------------\n286\t# codex_emit_bundle — the top-level codex install action. Runs an atomic\n287\t# pre-flight FIRST so an un-forced collision leaves the target untouched\n288\t# (no partial writes). Returns non-zero on a hard error (1) or a refused\n289\t# collision (2), so the caller aborts and the rollback trap restores .claude/.\n290\t# ---------------------------------------------------------------------------\n291\tcodex_emit_bundle() {\n292\t  echo \"\"\n293\t  echo \"==> Codex harness (--harness codex) — emitting .codex/ registration bundle\"\n294\t  echo \"    Verified against codex-cli $CODEX_VERIFIED_VERSION (pin: $(_codex_pin_range)).\"\n295\t  echo \"    HONESTY: NOTHING here is enforced until you grant /hooks trust; an\"\n296\t  echo \"             untrusted or modified hook is a SILENT no-op on codex 0.139.\"\n297\t\n298\t  _CODEX_REFUSED=0\n299\t  _CODEX_MANIFEST_EMITS=\"\"\n300\t  _CODEX_MANIFEST_BACKUPS=\"\"\n301\t\n302\t  # Atomic collision pre-flight — refuse the whole bundle before ANY write.\n303\t  if ! _codex_preflight; then\n304\t    echo \"::error::codex bundle refused to overwrite pre-existing file(s); no files written.\" >&2\n305\t    echo \"         Re-run with --force to back up and overwrite, or resolve by hand.\" >&2\n306\t    return 2\n307\t  fi\n308\t\n309\t  # (1) registration surface + (2)/(3) rules + operator contract.\n310\t  _codex_emit_file \"templates/codex/hooks.json\"      \".codex/hooks.json\"      || return 1\n311\t  _codex_emit_file \"templates/codex/rules/ceo.rules\" \".codex/rules/ceo.rules\" || return 1\n312\t  _codex_emit_file \"templates/codex/AGENTS.md\"       \"AGENTS.md\"              || return 1\n313\t\n314\t  # (4) managed-hooks policy (OQ1: opt-in, consent-first). requirements.toml is\n315\t  # a REVIEWABLE policy file in the repo, not a headless trust write into\n316\t  # $CODEX_HOME — the installer never silently trusts its own hooks.\n317\t  if [[ \"${CODEX_MANAGED_HOOKS:-0}\" -eq 1 ]]; then\n318\t    _codex_emit_managed_requirements\n319\t  fi\n320\t\n321\t  # (5) skills-port row — N/A until Wave 8 lands (OQ2). Guarded, not faked.\n322\t  if [[ \"${CODEX_WITH_SKILLS:-0}\" -eq 1 ]]; then\n323\t    echo \"\"\n324\t    echo \"    NOTE: --with-codex-skills is a NO-OP until PLAN-155 Wave 8 lands.\"\n325\t    echo \"          No .codex/skills/ is created; skill counts are untouched.\"\n326\t    codex_journal \"codex_skills_port\" \"deferred-wave-8\"\n327\t  fi\n328\t\n329\t  # (6) inverted pair-rail reviewer guidance (Codex operates, Claude reviews).\n330\t  _codex_print_reviewer_inversion\n331\t\n332\t  _codex_write_manifest\n333\t\n334\t  # trust-flow guidance always prints (consent-first).\n335\t  _codex_print_trust_flow\n336\t  return 0\n337\t}\n338\t\n339\t_codex_emit_managed_requirements() {\n340\t  local dst=\"$TARGET/requirements.toml\"\n341\t  echo \"\"\n342\t  echo \"==> Managed hooks (--managed-hooks) — emitting requirements.toml\"\n343\t  echo \"    Managed hooks are trusted-by-policy and NON-DISABLEABLE (enterprise\"\n344\t  echo \"    posture). This writes a REVIEWABLE policy file into the repo; it does\"\n345\t  echo \"    NOT write trust into \\$CODEX_HOME. Placement doctrine: admin/org scope\"\n346\t  echo \"    — commit it deliberately (ADR-161).\"\n347\t  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n348\t    if [[ -e \"$dst\" ]]; then\n349\t      echo \"    (dry-run) EXISTS (would REFUSE unless --force): requirements.toml\"\n350\t    else\n351\t      echo \"    (dry-run) would CREATE: requirements.toml\"\n352\t    fi\n353\t    return 0\n354\t  fi\n355\t  if [[ -e \"$dst\" && \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n356\t    echo \"::error::refusing to overwrite pre-existing requirements.toml (pass --force)\" >&2\n357\t    _CODEX_REFUSED=1\n358\t    return 0\n359\t  fi\n360\t  if [[ -e \"$dst\" && \"${CODEX_FORCE:-0}\" -eq 1 ]]; then\n361\t    local ts bak\n362\t    ts=\"$(date +%Y%m%d-%H%M%S)\"\n363\t    bak=\"requirements.toml.ceo-bak-${ts}\"\n364\t    cp \"$dst\" \"$TARGET/$bak\"\n365\t    _CODEX_MANIFEST_BACKUPS=\"${_CODEX_MANIFEST_BACKUPS}requirements.toml\t${bak}\"$'\\n'\n366\t    echo \"    BACKED UP: requirements.toml -> $bak (--force)\"\n367\t  fi\n368\t  # Managed registration points codex at the SAME hooks.json the installer\n369\t  # emitted; the operator still reviews it in VCS.\n370\t  cat > \"$dst\" <<EOF\n371\t# ceo-orchestration — Codex MANAGED hooks policy (PLAN-155 Wave 5, OQ1).\n372\t# Managed hooks are trusted-by-policy and non-disableable. Verified against\n373\t# codex-cli $CODEX_VERIFIED_VERSION. Committing this file is the consent act;\n374\t# it is reviewable in VCS. NOTHING enforces until codex loads it — run the\n375\t# arming check after install. No speed claim; governance + auditability only.\n376\t[hooks]\n377\tsources = [\".codex/hooks.json\"]\n378\t\n379\t# Project trust is a SEPARATE consent gate. The installer does NOT write it\n380\t# for you (consent-first). Grant it explicitly in \\$CODEX_HOME/config.toml:\n381\t#   [projects.\"$PH_PROJECT_PATH\"]\n382\t#   trust_level = \"trusted\"\n383\tEOF\n384\t  echo \"    EMITTED: requirements.toml\"\n385\t  _CODEX_MANIFEST_EMITS=\"${_CODEX_MANIFEST_EMITS}requirements.toml\"$'\\n'\n386\t  codex_journal \"codex_emit\" \"requirements.toml\"\n387\t}\n388\t\n389\t_codex_print_reviewer_inversion() {\n390\t  echo \"\"\n391\t  echo \"==> Inverted pair-rail (Codex operates, Claude reviews)\"\n392\t  echo \"    Under --harness codex the reviewer CLI is \\`claude -p\\` (mirror of the\"\n393\t  echo \"    Claude-host \\`.mcp.json\\` that registers the codex reviewer). The\"\n394\t  echo \"    Stop-hook review gate that USES it lands with PLAN-155 Wave 6; this\"\n395\t  echo \"    installer records the inversion and does NOT install the Claude-host\"\n396\t  echo \"    codex MCP server (.mcp.json) on the codex path.\"\n397\t  echo \"    Reviewer model pin: override with CEO_REVIEWER_MODEL (OQ3); the\"\n398\t  echo \"    same-vendor caveat is direction-neutral (author=OpenAI, reviewer=\"\n399\t  echo \"    Anthropic — no single model is both author and sole reviewer).\"\n400\t  codex_journal \"codex_reviewer_inverted\" \"reviewer_cli=claude\"\n401\t}\n402\t\n403\t_codex_print_trust_flow() {\n404\t  echo \"\"\n405\t  echo \"==> Trust flow (consent-first — the installer NEVER trusts your hooks for you)\"\n406\t  echo \"    Two gates must BOTH hold before any project hook fires:\"\n407\t  echo \"      1. Project trust — in \\$CODEX_HOME/config.toml:\"\n408\t  echo \"           [projects.\\\"$PH_PROJECT_PATH\\\"]\"\n409\t  echo \"           trust_level = \\\"trusted\\\"\"\n410\t  echo \"      2. Per-hook trust — run \\`codex\\` and use /hooks to review + trust\"\n411\t  echo \"         each entry in .codex/hooks.json (trust is keyed to the command\"\n412\t  echo \"         line; any edit re-prompts).\"\n413\t  if [[ \"${CODEX_MANAGED_HOOKS:-0}\" -eq 1 ]]; then\n414\t    echo \"    (You passed --managed-hooks: requirements.toml makes the hooks\"\n415\t    echo \"     trusted-by-policy once committed — but project trust above is still\"\n416\t    echo \"     yours to grant.)\"\n417\t  fi\n418\t}\n419\t\n420\t# ---------------------------------------------------------------------------\n421\t# codex_arming_check — the post-install doctor (debate A7). Prints exactly one\n422\t# verdict: ARMED / NOT-ARMED-(untrusted) / BROKEN. Always states loudly that\n423\t# NOTHING is enforced until /hooks trust is granted. Returns:\n424\t#   0 = ARMED, 1 = NOT-ARMED-(untrusted), 2 = BROKEN.\n425\t# Safe to call standalone (install.sh --harness codex --arming-check).\n426\t# ---------------------------------------------------------------------------\n427\tcodex_arming_check() {\n428\t  local target=\"${1:-$TARGET}\"\n429\t  local broken=0 reasons=\"\"\n430\t  echo \"\"\n431\t  echo \"==> Post-install arming check (codex harness) — is enforcement live?\"\n432\t\n433\t  # (a) required files present.\n434\t  local hooks_json=\"$target/.codex/hooks.json\"\n435\t  local shim=\"$target/.claude/hooks/_python-hook.sh\"\n436\t  if [[ ! -f \"$hooks_json\" ]]; then\n437\t    broken=1; reasons=\"${reasons}  - MISSING: .codex/hooks.json (run the codex install)\"$'\\n'\n438\t  fi\n439\t  if [[ ! -f \"$shim\" ]]; then\n440\t    broken=1; reasons=\"${reasons}  - MISSING: .claude/hooks/_python-hook.sh (framework hooks not installed)\"$'\\n'\n441\t  elif [[ ! -x \"$shim\" ]]; then\n442\t    broken=1; reasons=\"${reasons}  - NOT EXECUTABLE: .claude/hooks/_python-hook.sh (chmod +x)\"$'\\n'\n443\t  fi\n444\t\n445\t  # (b) git-worktree discovery gap (codex 0.139 silently finds ZERO hooks).\n446\t  if _codex_is_git_worktree \"$target\"; then\n447\t    broken=1\n448\t    reasons=\"${reasons}  - GIT WORKTREE: codex 0.139 discovers ZERO hooks inside a git worktree\"$'\\n'\n449\t    reasons=\"${reasons}    (\\`.git\\` is a file). Enforcement is SILENTLY ABSENT here — run from a\"$'\\n'\n450\t    reasons=\"${reasons}    normal clone, or track the substrate-watch item for a codex fix.\"$'\\n'\n451\t  fi\n452\t\n453\t  # (c) codex binary + version skew (A15).\n454\t  local ver range\n455\t  ver=\"$(_codex_detect_version)\"\n456\t  range=\"$(_codex_pin_range)\"\n457\t  if [[ -z \"$ver\" ]]; then\n458\t    reasons=\"${reasons}  - codex not on PATH: cannot verify the binary or its version\"$'\\n'\n459\t  elif ! _codex_ver_in_range \"$ver\" \"$range\"; then\n460\t    reasons=\"${reasons}  - VERSION SKEW: codex $ver is OUTSIDE the verified pin ($range);\"$'\\n'\n461\t    reasons=\"${reasons}    fixtures/enforcement were certified on $CODEX_VERIFIED_VERSION — re-verify.\"$'\\n'\n462\t  fi\n463\t\n464\t  # (d) project trust (best-effort positive check; we NEVER assume trusted).\n465\t  local trusted=0\n466\t  local codex_home=\"${CODEX_HOME:-$HOME/.codex}\"\n467\t  local cfg=\"$codex_home/config.toml\"\n468\t  if [[ -f \"$cfg\" ]] && command -v python3 >/dev/null 2>&1; then\n469\t    if PYTHONNOUSERSITE=1 python3 -I -c '\n470\timport sys\n471\tcfg, proj = sys.argv[1], sys.argv[2]\n472\ttry:\n473\t    import tomllib  # py>=3.11\n474\t    with open(cfg, \"rb\") as f:\n475\t        d = tomllib.load(f)\n476\t    p = d.get(\"projects\", {}).get(proj, {})\n477\t    sys.exit(0 if p.get(\"trust_level\") == \"trusted\" else 1)\n478\texcept Exception:\n479\t    # No tomllib (py<3.11) or parse error: fall back to a literal scan.\n480\t    try:\n481\t        with open(cfg, \"r\", encoding=\"utf-8\") as f:\n482\t            txt = f.read()\n483\t    except OSError:\n484\t        sys.exit(1)\n485\t    needle = \"[projects.\\\"%s\\\"]\" % proj\n486\t    sys.exit(0 if (needle in txt and \"trust_level = \\\"trusted\\\"\" in txt) else 1)\n487\t' \"$cfg\" \"$target\" 2>/dev/null; then\n488\t      trusted=1\n489\t    fi\n490\t  fi\n491\t\n492\t  echo \"\"\n493\t  if [[ \"$broken\" -eq 1 ]]; then\n494\t    echo \"    VERDICT: BROKEN\"\n495\t    printf '%s' \"$reasons\" >&2\n496\t    echo \"    Enforcement is NOT live. Fix the above, then re-run the arming check.\" >&2\n497\t    return 2\n498\t  fi\n499\t  if [[ -n \"$reasons\" ]]; then\n500\t    # Non-fatal warnings (version/PATH) but files are OK — surface them.\n501\t    printf '%s' \"$reasons\" >&2\n502\t  fi\n503\t  if [[ \"$trusted\" -eq 1 ]]; then\n504\t    echo \"    VERDICT: ARMED (project trusted in $cfg)\"\n505\t    echo \"    REMINDER: per-hook /hooks trust is keyed to each command line; any\"\n506\t    echo \"    edit to .codex/hooks.json re-prompts. NOTHING is enforced for an\"\n507\t    echo \"    untrusted or modified hook — re-verify after every change.\"\n508\t    return 0\n509\t  fi\n510\t  echo \"    VERDICT: NOT-ARMED-(untrusted)\"\n511\t  echo \"    NOTHING is enforced until you grant /hooks trust. To arm:\"\n512\t  echo \"      1. Add project trust in \\$CODEX_HOME/config.toml:\"\n513\t  echo \"           [projects.\\\"$target\\\"]\"\n514\t  echo \"           trust_level = \\\"trusted\\\"\"\n515\t  echo \"      2. Run \\`codex\\`, open /hooks, review + trust each .codex/hooks.json entry.\"\n516\t  echo \"      3. Re-run:  scripts/install.sh --harness codex --arming-check $target\"\n517\t  return 1\n518\t}\n519\t\n520\t# ---------------------------------------------------------------------------\n521\t# codex_uninstall — lifecycle symmetry (debate A9). Manifest-driven: removes\n522\t# every 'emit' path (incl. Wave 6's .git/ pre-push hook once it appends its\n523\t# line) and restores every 'backup' pair. Refuses if no manifest.\n524\t# ---------------------------------------------------------------------------\n525\tcodex_uninstall() {\n526\t  local target=\"${1:-$TARGET}\"\n527\t  local manifest=\"$target/$CODEX_MANIFEST_REL\"\n528\t  echo \"\"\n529\t  echo \"==> Codex harness uninstall (manifest-driven)\"\n530\t  if [[ ! -f \"$manifest\" ]]; then\n531\t    echo \"::error::no codex harness manifest at $CODEX_MANIFEST_REL — nothing to uninstall\" >&2\n532\t    return 1\n533\t  fi\n534\t\n535\t  # Restore backups FIRST (so a force-replaced file returns), then remove emits.\n536\t  local rel bak\n537\t  while IFS=$'\\t' read -r kind rel bak; do\n538\t    [[ \"$kind\" == \"backup\" ]] || continue\n539\t    if [[ -n \"$rel\" && -f \"$target/$bak\" ]]; then\n540\t      if [[ \"$DRY_RUN\" -eq 1 ]]; then\n541\t        echo \"    (dry-run) would RESTORE: $bak -> $rel\"\n542\t      else\n543\t        cp \"$target/$bak\" \"$target/$rel\"\n544\t        rm -f \"$target/$bak\"\n545\t        echo \"    RESTORED: $rel (from $bak)\"\n546\t      fi\n547\t    fi\n548\t  done < \"$manifest\"\n549\t\n550\t  # Remove emit paths. Skip any that a backup just restored.\n551\t  local restored=\"\"\n552\t  restored=\"$(grep -E '^backup\t' \"$manifest\" 2>/dev/null | cut -f2 || true)\"\n553\t  while IFS=$'\\t' read -r kind rel _; do\n554\t    [[ \"$kind\" == \"emit\" ]] || continue\n555\t    [[ -n \"$rel\" ]] || continue\n556\t    if printf '%s\\n' \"$restored\" | grep -Fxq \"$rel\"; then\n557\t      continue  # a backup already restored the original in place\n558\t    fi\n559\t    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n560\t      echo \"    (dry-run) would REMOVE: $rel\"\n561\t    else\n562\t      rm -f \"$target/$rel\" 2>/dev/null || true\n563\t      echo \"    REMOVED: $rel\"\n564\t    fi\n565\t  done < \"$manifest\"\n566\t\n567\t  if [[ \"$DRY_RUN\" -eq 0 ]]; then\n568\t    rm -f \"$manifest\" 2>/dev/null || true\n569\t    # Prune the .codex dir if now empty (best-effort).\n570\t    rmdir \"$target/.codex/rules\" 2>/dev/null || true\n571\t    rmdir \"$target/.codex\" 2>/dev/null || true\n572\t    echo \"    Uninstall complete. Verify no enforcement residue: no .codex/, no\"\n573\t    echo \"    operator AGENTS.md, no requirements.toml (unless you kept your own).\"\n574\t  fi\n575\t  return 0\n576\t}\n577\t"}]},"parent_tool_use_id":null,"session_id":"44354e61-c2ec-4181-9296-3322c9641608","uuid":"6606eaea-4d0d-40b2-b607-91aaf317c8a5","timestamp":"2026-11-16T20:12:36.036Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/scripts/_codex_harness.sh","content":"#!/usr/bin/env bash\n# _codex_harness.sh — Codex (OpenAI) harness emission for install.sh / upgrade.sh\n# =============================================================================\n# PLAN-155 Wave 5 (SENT-CX-C). Single source of truth for the `--harness codex`\n# path: it EMITS the `.codex/` registration bundle, the operator `AGENTS.md`,\n# the optional managed `requirements.toml`, the inverted-pair-rail reviewer\n# guidance, records a lifecycle manifest, and runs the post-install arming\n# check. install.sh and upgrade.sh both `source` this file (like _hash_lib.sh),\n# so the codex logic lives in exactly one place.\n#\n# NEW unguarded companion (rides the SENT-CX-C commit; not canonical-guarded).\n# Sourced, never executed. Stdlib shell only; bash >= 3.2 (no associative\n# arrays / mapfile). shellcheck -S warning clean.\n#\n# HONESTY (binding, PLAN-155 capability matrix):\n#   * NOTHING is enforced until the operator grants /hooks trust. On codex\n#     0.139 an untrusted or modified hook is a SILENT no-op. The arming check\n#     says this loudly and is printed as the installer's FINAL instruction.\n#   * Kill-switch surface protection is ABSENT until PLAN-155 Wave 3b lands.\n#   * No speed claim anywhere. The value is governance + auditability.\n#\n# ENV CONTRACT (set by the caller BEFORE sourcing/calling):\n#   Required : TARGET (abs), SOURCE_DIR (abs framework checkout), DRY_RUN (0|1)\n#   Rendered : PH_PROJECT_PATH (abs target path), PH_PROJECT_NAME\n#   Options  : CODEX_MANAGED_HOOKS (0|1), CODEX_WITH_SKILLS (0|1),\n#              CODEX_FORCE (0|1)\n#   Optional : a caller-defined `codex_journal <op> <detail>` recorder\n#              (maps to install.sh:_state_record_op / upgrade.sh:_up_record_op);\n#              a no-op default is provided below if the caller defines none.\n#\n# The kill-switch / template contents are authored in Waves 2/3\n# (templates/codex/**) and guarded in Wave 3b — this file only COPIES +\n# substitutes them; it never inlines their bytes.\n# =============================================================================\n\n# Fail-open recorder default (overridden by the caller if it has a journal).\nif ! command -v codex_journal >/dev/null 2>&1; then\n  codex_journal() { return 0; }\nfi\n\n# ---------------------------------------------------------------------------\n# Version pin (debate A15). Read the semver range shipped in the framework at\n# .claude/governance/codex-cli-pin.txt (last non-comment, non-blank line);\n# fall back to the PLAN-142-verified range if that file is absent.\n# ---------------------------------------------------------------------------\nCODEX_VERIFIED_VERSION=\"0.160.0\"   # default semantic floor when the canonical pin is absent\n\n_codex_pin_range() {\n  local pin_file=\"$SOURCE_DIR/.claude/governance/codex-cli-pin.txt\"\n  local line=\"\"\n  if [[ -f \"$pin_file\" ]]; then\n    # last line that is neither blank nor a comment\n    line=\"$(grep -vE '^[[:space:]]*(#|$)' \"$pin_file\" 2>/dev/null | tail -n 1 | tr -d '[:space:]')\"\n  fi\n  if [[ -n \"$line\" ]]; then\n    printf '%s\\n' \"$line\"\n  else\n    printf '%s\\n' \">=0.160.0\"\n  fi\n}\n\n# `codex --version` -> bare \"X.Y.Z\" (or empty if the binary is absent/opaque).\n_codex_detect_version() {\n  command -v codex >/dev/null 2>&1 || return 0\n  local raw=\"\"\n  raw=\"$(codex --version 2>/dev/null | head -n 1 || true)\"\n  # Extract the first dotted-number token.\n  printf '%s\\n' \"$raw\" | grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' | head -n 1\n}\n\n# $1 >= $2 (semver, via sort -V). Returns 0 (true) / 1 (false).\n_codex_ver_ge() {\n  [ \"$(printf '%s\\n%s\\n' \"$2\" \"$1\" | sort -V 2>/dev/null | head -n 1)\" = \"$2\" ]\n}\n\n# Is $1 inside the range \">=MIN,<MAX\"? Best-effort; unknown grammar => \"in\".\n_codex_ver_in_range() {\n  local ver=\"$1\" range=\"$2\" min=\"\" max=\"\"\n  [[ -n \"$ver\" ]] || return 1\n  min=\"$(printf '%s\\n' \"$range\" | grep -oE '>=[0-9]+\\.[0-9]+\\.[0-9]+' | head -n1 | sed 's/^>=//')\"\n  max=\"$(printf '%s\\n' \"$range\" | grep -oE '<[0-9]+\\.[0-9]+\\.[0-9]+'  | head -n1 | sed 's/^<//')\"\n  if [[ -n \"$min\" ]] && ! _codex_ver_ge \"$ver\" \"$min\"; then return 1; fi\n  # max is exclusive: ver < max  <=>  NOT (ver >= max)\n  if [[ -n \"$max\" ]] && _codex_ver_ge \"$ver\" \"$max\"; then return 1; fi\n  return 0\n}\n\n# Codex 0.139 discovers ZERO hooks inside a git WORKTREE (`.git` is a FILE\n# pointing at the parent). Enforcement is silently absent there — the arming\n# check must flag it loudly (live-fire finding, MANIFEST-A open issue #2).\n_codex_is_git_worktree() {\n  local dir=\"$1\"\n  [[ -f \"$dir/.git\" ]]\n}\n\nCODEX_MANIFEST_REL=\".codex/.ceo-harness-manifest\"\n\n# ---------------------------------------------------------------------------\n# Render a template file: substitute {{PROJECT_PATH}} and {{PROJECT_NAME}} into\n# $dst. Collision policy (debate A10):\n#   - dst missing            => write (record emit)\n#   - dst == rendered bytes  => SKIP (idempotent re-run, no error)\n#   - dst differs, no --force=> REFUSE: print a unified diff, set the refusal\n#                               flag; NEVER clobber\n#   - dst differs, --force   => back up dst to <dst>.ceo-bak-<ts>, write,\n#                               record both backup + emit\n# Uses only literal string replacement (no sed metachar hazards): python3 when\n# present, else a portable awk fallback.\n# ---------------------------------------------------------------------------\n_CODEX_REFUSED=0          # set to 1 by any refused collision this run\n_CODEX_MANIFEST_EMITS=\"\"  # newline list: relpath\n_CODEX_MANIFEST_BACKUPS=\"\" # newline list: relpath<TAB>backup-relpath\n\n_codex_render_to_stdout() {\n  local src=\"$1\"\n  if command -v python3 >/dev/null 2>&1; then\n    PYTHONNOUSERSITE=1 python3 -I -c '\nimport sys\nsrc, pp, pn = sys.argv[1], sys.argv[2], sys.argv[3]\nwith open(src, \"r\", encoding=\"utf-8\") as f:\n    data = f.read()\ndata = data.replace(\"{{PROJECT_PATH}}\", pp).replace(\"{{PROJECT_NAME}}\", pn)\nsys.stdout.write(data)\n' \"$src\" \"$PH_PROJECT_PATH\" \"$PH_PROJECT_NAME\"\n  else\n    # awk fallback: literal, index-based replacement (no regex).\n    awk -v pp=\"$PH_PROJECT_PATH\" -v pn=\"$PH_PROJECT_NAME\" '\n      function repl(s, needle, val,   out, i) {\n        out = \"\"\n        while ((i = index(s, needle)) > 0) {\n          out = out substr(s, 1, i - 1) val\n          s = substr(s, i + length(needle))\n        }\n        return out s\n      }\n      { line = repl($0, \"{{PROJECT_PATH}}\", pp); line = repl(line, \"{{PROJECT_NAME}}\", pn); print line }\n    ' \"$src\"\n  fi\n}\n\n_codex_emit_file() {\n  local src_rel=\"$1\" dst_rel=\"$2\"\n  local src=\"$SOURCE_DIR/$src_rel\"\n  local dst=\"$TARGET/$dst_rel\"\n\n  if [[ ! -f \"$src\" ]]; then\n    echo \"    SKIP (template missing): $src_rel\" >&2\n    return 0\n  fi\n\n  # Render to a temp so we can compare + reuse.\n  local tmp=\"\"\n  tmp=\"$(mktemp \"${TMPDIR:-/tmp}/ceo-codex-render.XXXXXX\" 2>/dev/null || true)\"\n  if [[ -z \"$tmp\" ]]; then\n    echo \"    ERROR: cannot allocate tempfile for $dst_rel\" >&2\n    return 1\n  fi\n  _codex_render_to_stdout \"$src\" > \"$tmp\" 2>/dev/null\n\n  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n    if [[ -e \"$dst\" ]]; then\n      if diff -q \"$dst\" \"$tmp\" >/dev/null 2>&1; then\n        echo \"    (dry-run) EXISTS identical (would skip): $dst_rel\"\n      elif [[ \"${CODEX_FORCE:-0}\" -eq 1 ]]; then\n        echo \"    (dry-run) DIFFERS (would --force backup+overwrite): $dst_rel\"\n      else\n        echo \"    (dry-run) DIFFERS (would REFUSE — pass --force to overwrite): $dst_rel\"\n      fi\n    else\n      echo \"    (dry-run) would CREATE: $dst_rel\"\n    fi\n    rm -f \"$tmp\" 2>/dev/null || true\n    return 0\n  fi\n\n  mkdir -p \"$( dirname \"$dst\" )\"\n\n  if [[ -e \"$dst\" ]]; then\n    if diff -q \"$dst\" \"$tmp\" >/dev/null 2>&1; then\n      echo \"    EXISTS identical (skipping): $dst_rel\"\n      _CODEX_MANIFEST_EMITS=\"${_CODEX_MANIFEST_EMITS}${dst_rel}\"$'\\n'\n      rm -f \"$tmp\" 2>/dev/null || true\n      return 0\n    fi\n    if [[ \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n      echo \"::error::refusing to overwrite pre-existing $dst_rel (pass --force to override)\" >&2\n      echo \"    --- current (on disk) vs would-install (diff) ---\" >&2\n      diff -u \"$dst\" \"$tmp\" 2>/dev/null | head -40 >&2 || true\n      _CODEX_REFUSED=1\n      rm -f \"$tmp\" 2>/dev/null || true\n      return 0\n    fi\n    # --force: back up, then overwrite.\n    local ts bak\n    ts=\"$(date +%Y%m%d-%H%M%S)\"\n    bak=\"${dst_rel}.ceo-bak-${ts}\"\n    cp \"$dst\" \"$TARGET/$bak\"\n    _CODEX_MANIFEST_BACKUPS=\"${_CODEX_MANIFEST_BACKUPS}${dst_rel}\t${bak}\"$'\\n'\n    echo \"    BACKED UP: $dst_rel -> $bak (--force)\"\n  fi\n\n  cp \"$tmp\" \"$dst\"\n  rm -f \"$tmp\" 2>/dev/null || true\n  echo \"    EMITTED: $dst_rel\"\n  _CODEX_MANIFEST_EMITS=\"${_CODEX_MANIFEST_EMITS}${dst_rel}\"$'\\n'\n  codex_journal \"codex_emit\" \"$dst_rel\"\n  return 0\n}\n\n# Write the lifecycle manifest (schema ceo.codex-harness/v1). Carries forward\n# prior backup lines so a later run never loses a restore target. Wave 6's\n# `.git/` pre-push hook APPENDS its emit line to this same ledger, so uninstall\n# reaches it (debate A9 — the third install surface).\n_codex_write_manifest() {\n  [[ \"$DRY_RUN\" -eq 0 ]] || return 0\n  local manifest=\"$TARGET/$CODEX_MANIFEST_REL\"\n  local ver range prior_backups=\"\"\n  ver=\"$(_codex_detect_version)\"\n  range=\"$(_codex_pin_range)\"\n  # Preserve any backup lines already recorded by an earlier run.\n  if [[ -f \"$manifest\" ]]; then\n    prior_backups=\"$(grep -E '^backup\t' \"$manifest\" 2>/dev/null || true)\"\n  fi\n  mkdir -p \"$( dirname \"$manifest\" )\"\n  {\n    echo \"# ceo-orchestration codex harness install manifest (schema ceo.codex-harness/v1)\"\n    echo \"# TAB-separated: kind<TAB>relpath[<TAB>backup-relpath]; kind in {meta,emit,backup}.\"\n    echo \"# uninstall removes 'emit' relpaths (LIFO) and restores 'backup' pairs.\"\n    printf 'meta\\tcodex_cli_version\\t%s\\n' \"${ver:-unknown}\"\n    printf 'meta\\tpin_range\\t%s\\n' \"$range\"\n    printf 'meta\\tmanaged_hooks\\t%s\\n' \"${CODEX_MANAGED_HOOKS:-0}\"\n    # emit lines (unique, in emission order)\n    printf '%s' \"$_CODEX_MANIFEST_EMITS\" | awk 'NF && !seen[$0]++ {printf \"emit\\t%s\\n\", $0}'\n    # backup lines: prior + this run\n    [[ -n \"$prior_backups\" ]] && printf '%s\\n' \"$prior_backups\"\n    printf '%s' \"$_CODEX_MANIFEST_BACKUPS\" | awk -F'\\t' 'NF>=2 {printf \"backup\\t%s\\t%s\\n\", $1, $2}'\n  } > \"$manifest\"\n  echo \"    WROTE: $CODEX_MANIFEST_REL (lifecycle ledger — uninstall/backup source of truth)\"\n  codex_journal \"codex_write_manifest\" \"$CODEX_MANIFEST_REL\"\n}\n\n# The template-backed emit set (src_rel<TAB>dst_rel). requirements.toml is\n# generated inline (not from a template) and handled separately.\n_codex_planned_pairs() {\n  printf 'templates/codex/hooks.json\\t.codex/hooks.json\\n'\n  printf 'templates/codex/rules/ceo.rules\\t.codex/rules/ceo.rules\\n'\n  printf 'templates/codex/AGENTS.md\\tAGENTS.md\\n'\n}\n\n# Pre-flight collision scan (debate A10): render every planned file, compare to\n# any existing target file, and REFUSE the whole bundle (zero writes) if any\n# differs without --force. Atomic: a refusal leaves the target untouched, so\n# there is never a partial `.codex/` to roll back. Returns 0 (clear) / 2\n# (refused — diffs printed).\n_codex_preflight() {\n  local refused=0 src_rel dst_rel src dst tmp\n  while IFS=$'\\t' read -r src_rel dst_rel; do\n    [[ -n \"$src_rel\" ]] || continue\n    src=\"$SOURCE_DIR/$src_rel\"; dst=\"$TARGET/$dst_rel\"\n    [[ -f \"$src\" ]] || continue\n    [[ -e \"$dst\" ]] || continue\n    tmp=\"$(mktemp \"${TMPDIR:-/tmp}/ceo-codex-pf.XXXXXX\" 2>/dev/null || true)\"\n    [[ -n \"$tmp\" ]] || continue\n    _codex_render_to_stdout \"$src\" > \"$tmp\" 2>/dev/null\n    if ! diff -q \"$dst\" \"$tmp\" >/dev/null 2>&1; then\n      if [[ \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n        refused=1\n        echo \"::error::refusing to overwrite pre-existing $dst_rel (pass --force to override)\" >&2\n        echo \"    --- current (on disk) vs would-install (unified diff, head) ---\" >&2\n        diff -u \"$dst\" \"$tmp\" 2>/dev/null | head -40 >&2 || true\n      fi\n    fi\n    rm -f \"$tmp\" 2>/dev/null || true\n  done <<EOF\n$(_codex_planned_pairs)\nEOF\n  # requirements.toml is generated, not template-backed: a plain differ check.\n  if [[ \"${CODEX_MANAGED_HOOKS:-0}\" -eq 1 && -e \"$TARGET/requirements.toml\" && \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n    refused=1\n    echo \"::error::refusing to overwrite pre-existing requirements.toml (pass --force)\" >&2\n  fi\n  [[ \"$refused\" -eq 0 ]]\n}\n\n# ---------------------------------------------------------------------------\n# codex_emit_bundle — the top-level codex install action. Runs an atomic\n# pre-flight FIRST so an un-forced collision leaves the target untouched\n# (no partial writes). Returns non-zero on a hard error (1) or a refused\n# collision (2), so the caller aborts and the rollback trap restores .claude/.\n# ---------------------------------------------------------------------------\ncodex_emit_bundle() {\n  echo \"\"\n  echo \"==> Codex harness (--harness codex) — emitting .codex/ registration bundle\"\n  echo \"    Verified against codex-cli $CODEX_VERIFIED_VERSION (pin: $(_codex_pin_range)).\"\n  echo \"    HONESTY: NOTHING here is enforced until you grant /hooks trust; an\"\n  echo \"             untrusted or modified hook is a SILENT no-op on codex 0.139.\"\n\n  _CODEX_REFUSED=0\n  _CODEX_MANIFEST_EMITS=\"\"\n  _CODEX_MANIFEST_BACKUPS=\"\"\n\n  # Atomic collision pre-flight — refuse the whole bundle before ANY write.\n  if ! _codex_preflight; then\n    echo \"::error::codex bundle refused to overwrite pre-existing file(s); no files written.\" >&2\n    echo \"         Re-run with --force to back up and overwrite, or resolve by hand.\" >&2\n    return 2\n  fi\n\n  # (1) registration surface + (2)/(3) rules + operator contract.\n  _codex_emit_file \"templates/codex/hooks.json\"      \".codex/hooks.json\"      || return 1\n  _codex_emit_file \"templates/codex/rules/ceo.rules\" \".codex/rules/ceo.rules\" || return 1\n  _codex_emit_file \"templates/codex/AGENTS.md\"       \"AGENTS.md\"              || return 1\n\n  # (4) managed-hooks policy (OQ1: opt-in, consent-first). requirements.toml is\n  # a REVIEWABLE policy file in the repo, not a headless trust write into\n  # $CODEX_HOME — the installer never silently trusts its own hooks.\n  if [[ \"${CODEX_MANAGED_HOOKS:-0}\" -eq 1 ]]; then\n    _codex_emit_managed_requirements\n  fi\n\n  # (5) skills-port row — N/A until Wave 8 lands (OQ2). Guarded, not faked.\n  if [[ \"${CODEX_WITH_SKILLS:-0}\" -eq 1 ]]; then\n    echo \"\"\n    echo \"    NOTE: --with-codex-skills is a NO-OP until PLAN-155 Wave 8 lands.\"\n    echo \"          No .codex/skills/ is created; skill counts are untouched.\"\n    codex_journal \"codex_skills_port\" \"deferred-wave-8\"\n  fi\n\n  # (6) inverted pair-rail reviewer guidance (Codex operates, Claude reviews).\n  _codex_print_reviewer_inversion\n\n  _codex_write_manifest\n\n  # trust-flow guidance always prints (consent-first).\n  _codex_print_trust_flow\n  return 0\n}\n\n_codex_emit_managed_requirements() {\n  local dst=\"$TARGET/requirements.toml\"\n  echo \"\"\n  echo \"==> Managed hooks (--managed-hooks) — emitting requirements.toml\"\n  echo \"    Managed hooks are trusted-by-policy and NON-DISABLEABLE (enterprise\"\n  echo \"    posture). This writes a REVIEWABLE policy file into the repo; it does\"\n  echo \"    NOT write trust into \\$CODEX_HOME. Placement doctrine: admin/org scope\"\n  echo \"    — commit it deliberately (ADR-161).\"\n  if [[ \"$DRY_RUN\" -eq 1 ]]; then\n    if [[ -e \"$dst\" ]]; then\n      echo \"    (dry-run) EXISTS (would REFUSE unless --force): requirements.toml\"\n    else\n      echo \"    (dry-run) would CREATE: requirements.toml\"\n    fi\n    return 0\n  fi\n  if [[ -e \"$dst\" && \"${CODEX_FORCE:-0}\" -ne 1 ]]; then\n    echo \"::error::refusing to overwrite pre-existing requirements.toml (pass --force)\" >&2\n    _CODEX_REFUSED=1\n    return 0\n  fi\n  if [[ -e \"$dst\" && \"${CODEX_FORCE:-0}\" -eq 1 ]]; then\n    local ts bak\n    ts=\"$(date +%Y%m%d-%H%M%S)\"\n    bak=\"requirements.toml.ceo-bak-${ts}\"\n    cp \"$dst\" \"$TARGET/$bak\"\n    _CODEX_MANIFEST_BACKUPS=\"${_CODEX_MANIFEST_BACKUPS}requirements.toml\t${bak}\"$'\\n'\n    echo \"    BACKED UP: requirements.toml -> $bak (--force)\"\n  fi\n  # Managed registration points codex at the SAME hooks.json the installer\n  # emitted; the operator still reviews it in VCS.\n  cat > \"$dst\" <<EOF\n# ceo-orchestration — Codex MANAGED hooks policy (PLAN-155 Wave 5, OQ1).\n# Managed hooks are trusted-by-policy and non-disableable. Verified against\n# codex-cli $CODEX_VERIFIED_VERSION. Committing this file is the consent act;\n# it is reviewable in VCS. NOTHING enforces until codex loads it — run the\n# arming check after install. No speed claim; governance + auditability only.\n[hooks]\nsources = [\".codex/hooks.json\"]\n\n# Project trust is a SEPARATE consent gate. The installer does NOT write it\n# for you (consent-first). Grant it explicitly in \\$CODEX_HOME/config.toml:\n#   [projects.\"$PH_PROJECT_PATH\"]\n#   trust_level = \"trusted\"\nEOF\n  echo \"    EMITTED: requirements.toml\"\n  _CODEX_MANIFEST_EMITS=\"${_CODEX_MANIFEST_EMITS}requirements.toml\"$'\\n'\n  codex_journal \"codex_emit\" \"requirements.toml\"\n}\n\n_codex_print_reviewer_inversion() {\n  echo \"\"\n  echo \"==> Inverted pair-rail (Codex operates, Claude reviews)\"\n  echo \"    Under --harness codex the reviewer CLI is \\`claude -p\\` (mirror of the\"\n  echo \"    Claude-host \\`.mcp.json\\` that registers the codex reviewer). The\"\n  echo \"    Stop-hook review gate that USES it lands with PLAN-155 Wave 6; this\"\n  echo \"    installer records the inversion and does NOT install the Claude-host\"\n  echo \"    codex MCP server (.mcp.json) on the codex path.\"\n  echo \"    Reviewer model pin: override with CEO_REVIEWER_MODEL (OQ3); the\"\n  echo \"    same-vendor caveat is direction-neutral (author=OpenAI, reviewer=\"\n  echo \"    Anthropic — no single model is both author and sole reviewer).\"\n  codex_journal \"codex_reviewer_inverted\" \"reviewer_cli=claude\"\n}\n\n_codex_print_trust_flow() {\n  echo \"\"\n  echo \"==> Trust flow (consent-first — the installer NEVER trusts your hooks for you)\"\n  echo \"    Two gates must BOTH hold before any project hook fires:\"\n  echo \"      1. Project trust — in \\$CODEX_HOME/config.toml:\"\n  echo \"           [projects.\\\"$PH_PROJECT_PATH\\\"]\"\n  echo \"           trust_level = \\\"trusted\\\"\"\n  echo \"      2. Per-hook trust — run \\`codex\\` and use /hooks to review + trust\"\n  echo \"         each entry in .codex/hooks.json (trust is keyed to the command\"\n  echo \"         line; any edit re-prompts).\"\n  if [[ \"${CODEX_MANAGED_HOOKS:-0}\" -eq 1 ]]; then\n    echo \"    (You passed --managed-hooks: requirements.toml makes the hooks\"\n    echo \"     trusted-by-policy once committed — but project trust above is still\"\n    echo \"     yours to grant.)\"\n  fi\n}\n\n# ---------------------------------------------------------------------------\n# codex_arming_check — the post-install doctor (debate A7). Prints exactly one\n# verdict: ARMED / NOT-ARMED-(untrusted) / BROKEN. Always states loudly that\n# NOTHING is enforced until /hooks trust is granted. Returns:\n#   0 = ARMED, 1 = NOT-ARMED-(untrusted), 2 = BROKEN.\n# Safe to call standalone (install.sh --harness codex --arming-check).\n# ---------------------------------------------------------------------------\ncodex_arming_check() {\n  local target=\"${1:-$TARGET}\"\n  local broken=0 reasons=\"\"\n  echo \"\"\n  echo \"==> Post-install arming check (codex harness) — is enforcement live?\"\n\n  # (a) required files present.\n  local hooks_json=\"$target/.codex/hooks.json\"\n  local shim=\"$target/.claude/hooks/_python-hook.sh\"\n  if [[ ! -f \"$hooks_json\" ]]; then\n    broken=1; reasons=\"${reasons}  - MISSING: .codex/hooks.json (run the codex install)\"$'\\n'\n  fi\n  if [[ ! -f \"$shim\" ]]; then\n    broken=1; reasons=\"${reasons}  - MISSING: .claude/hooks/_python-hook.sh (framework hooks not installed)\"$'\\n'\n  elif [[ ! -x \"$shim\" ]]; then\n    broken=1; reasons=\"${reasons}  - NOT EXECUTABLE: .claude/hooks/_python-hook.sh (chmod +x)\"$'\\n'\n  fi\n\n  # (b) git-worktree discovery gap (codex 0.139 silently finds ZERO hooks).\n  if _codex_is_git_worktree \"$target\"; then\n    broken=1\n    reasons=\"${reasons}  - GIT WORKTREE: codex 0.139 discovers ZERO hooks inside a git worktree\"$'\\n'\n    reasons=\"${reasons}    (\\`.git\\` is a file). Enforcement is SILENTLY ABSENT here — run from a\"$'\\n'\n    reasons=\"${reasons}    normal clone, or track the substrate-watch item for a codex fix.\"$'\\n'\n  fi\n\n  # (c) codex binary + version skew (A15).\n  local ver range\n  ver=\"$(_codex_detect_version)\"\n  range=\"$(_codex_pin_range)\"\n  if [[ -z \"$ver\" ]]; then\n    reasons=\"${reasons}  - codex not on PATH: cannot verify the binary or its version\"$'\\n'\n  elif ! _codex_ver_in_range \"$ver\" \"$range\"; then\n    reasons=\"${reasons}  - VERSION SKEW: codex $ver is OUTSIDE the verified pin ($range);\"$'\\n'\n    reasons=\"${reasons}    fixtures/enforcement were certified on $CODEX_VERIFIED_VERSION — re-verify.\"$'\\n'\n  fi\n\n  # (d) project trust (best-effort positive check; we NEVER assume trusted).\n  local trusted=0\n  local codex_home=\"${CODEX_HOME:-$HOME/.codex}\"\n  local cfg=\"$codex_home/config.toml\"\n  if [[ -f \"$cfg\" ]] && command -v python3 >/dev/null 2>&1; then\n    if PYTHONNOUSERSITE=1 python3 -I -c '\nimport sys\ncfg, proj = sys.argv[1], sys.argv[2]\ntry:\n    import tomllib  # py>=3.11\n    with open(cfg, \"rb\") as f:\n        d = tomllib.load(f)\n    p = d.get(\"projects\", {}).get(proj, {})\n    sys.exit(0 if p.get(\"trust_level\") == \"trusted\" else 1)\nexcept Exception:\n    # No tomllib (py<3.11) or parse error: fall back to a literal scan.\n    try:\n        with open(cfg, \"r\", encoding=\"utf-8\") as f:\n            txt = f.read()\n    except OSError:\n        sys.exit(1)\n    needle = \"[projects.\\\"%s\\\"]\" % proj\n    sys.exit(0 if (needle in txt and \"trust_level = \\\"trusted\\\"\" in txt) else 1)\n' \"$cfg\" \"$target\" 2>/dev/null; then\n      trusted=1\n    fi\n  fi\n\n  echo \"\"\n  if [[ \"$broken\" -eq 1 ]]; then\n    echo \"    VERDICT: BROKEN\"\n    printf '%s' \"$reasons\" >&2\n    echo \"    Enforcement is NOT live. Fix the above, then re-run the arming check.\" >&2\n    return 2\n  fi\n  if [[ -n \"$reasons\" ]]; then\n    # Non-fatal warnings (version/PATH) but files are OK — surface them.\n    printf '%s' \"$reasons\" >&2\n  fi\n  if [[ \"$trusted\" -eq 1 ]]; then\n    echo \"    VERDICT: ARMED (project trusted in $cfg)\"\n    echo \"    REMINDER: per-hook /hooks trust is keyed to each command line; any\"\n    echo \"    edit to .codex/hooks.json re-prompts. NOTHING is enforced for an\"\n    echo \"    untrusted or modified hook — re-verify after every change.\"\n    return 0\n  fi\n  echo \"    VERDICT: NOT-ARMED-(untrusted)\"\n  echo \"    NOTHING is enforced until you grant /hooks trust. To arm:\"\n  echo \"      1. Add project trust in \\$CODEX_HOME/config.toml:\"\n  echo \"           [projects.\\\"$target\\\"]\"\n  echo \"           trust_level = \\\"trusted\\\"\"\n  echo \"      2. Run \\`codex\\`, open /hooks, review + trust each .codex/hooks.json entry.\"\n  echo \"      3. Re-run:  scripts/install.sh --harness codex --arming-check $target\"\n  return 1\n}\n\n# ---------------------------------------------------------------------------\n# codex_uninstall — lifecycle symmetry (debate A9). Manifest-driven: removes\n# every 'emit' path (incl. Wave 6's .git/ pre-push hook once it appends its\n# line) and restores every 'backup' pair. Refuses if no manifest.\n# ---------------------------------------------------------------------------\ncodex_uninstall() {\n  local target=\"${1:-$TARGET}\"\n  local manifest=\"$target/$CODEX_MANIFEST_REL\"\n  echo \"\"\n  echo \"==> Codex harness uninstall (manifest-driven)\"\n  if [[ ! -f \"$manifest\" ]]; then\n    echo \"::error::no codex harness manifest at $CODEX_MANIFEST_REL — nothing to uninstall\" >&2\n    return 1\n  fi\n\n  # Restore backups FIRST (so a force-replaced file returns), then remove emits.\n  local rel bak\n  while IFS=$'\\t' read -r kind rel bak; do\n    [[ \"$kind\" == \"backup\" ]] || continue\n    if [[ -n \"$rel\" && -f \"$target/$bak\" ]]; then\n      if [[ \"$DRY_RUN\" -eq 1 ]]; then\n        echo \"    (dry-run) would RESTORE: $bak -> $rel\"\n      else\n        cp \"$target/$bak\" \"$target/$rel\"\n        rm -f \"$target/$bak\"\n        echo \"    RESTORED: $rel (from $bak)\"\n      fi\n    fi\n  done < \"$manifest\"\n\n  # Remove emit paths. Skip any that a backup just restored.\n  local restored=\"\"\n  restored=\"$(grep -E '^backup\t' \"$manifest\" 2>/dev/null | cut -f2 || true)\"\n  while IFS=$'\\t' read -r kind rel _; do\n    [[ \"$kind\" == \"emit\" ]] || continue\n    [[ -n \"$rel\" ]] || continue\n    if printf '%s\\n' \"$restored\" | grep -Fxq \"$rel\"; then\n      continue  # a backup already restored the original in place\n    fi\n    if [[ \"$DRY_RUN\" -eq 1 ]]; then\n      echo \"    (dry-run) would REMOVE: $rel\"\n    else\n      rm -f \"$target/$rel\" 2>/dev/null || true\n      echo \"    REMOVED: $rel\"\n    fi\n  done < \"$manifest\"\n\n  if [[ \"$DRY_RUN\" -eq 0 ]]; then\n    rm -f \"$manifest\" 2>/dev/null || true\n    # Prune the .codex dir if now empty (best-effort).\n    rmdir \"$target/.codex/rules\" 2>/dev/null || true\n    rmdir \"$target/.codex\" 2>/dev/null || true\n    echo \"    Uninstall complete. Verify no enforcement residue: no .codex/, no\"\n    echo \"    operator AGENTS.md, no requirements.toml (unless you kept your own).\"\n  fi\n  return 0\n}\n","numLines":577,"startLine":1,"totalLines":577}},"tool_result_meta":[{"id":"toolu_016WVXMwqc6aNgZRQj5juGHV","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
