{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013cdA9ejCFEEFHpoU3gFJFK","type":"tool_result","content":"95\t# -------------------------------- version sync check -------------------------\n96\tVERSION_FILE=\"$(tr -d '[:space:]' < \"$ROOT/VERSION\")\"\n97\tPKG_VERSION=\"$(node -p \"require('$NPM_DIR/package.json').version\")\"\n98\tif [[ \"$VERSION_FILE\" != \"$PKG_VERSION\" ]]; then\n99\t  echo \"::error::VERSION ($VERSION_FILE) ≠ npm/package.json ($PKG_VERSION)\" >&2\n100\t  echo \"Update npm/package.json::version to $VERSION_FILE before building.\" >&2\n101\t  exit 1\n102\tfi\n103\techo \"OK: version sync — $VERSION_FILE\"\n104\t\n105\t# -------------------------------- stage bundle -------------------------------\n106\t# Copy framework source tree into npm/ so npm pack picks it up via files: list.\n107\t# Mirror npm-publish.yml step \"Stage bundle into npm/\".\n108\t# PLAN-152 tarball-01: SELECTIVE staging — the root .npmignore is INERT under\n109\t# the package.json \"files\" whitelist, so exclusion must happen here. Excludes\n110\t# the framework-internal test harness, fixture corpora, eval/, red-team\n111\t# corpus, numbered plan trees, and _lib/testing.py + _lib/test_isolation.py\n112\t# (PLAN-120 contract install.sh already honors); keeps .claude/plans/ schemas\n113\t# + README + examples/ and .claude/policies/fixtures/ (install.sh provisions\n114\t# both).\n115\techo \"==> Staging bundle into npm/\"\n116\tRSYNC_EXCLUDES=(\n117\t  --include='.claude/policies/fixtures/'\n118\t  --include='templates/oidc-proxy/tests/'\n119\t  --include='templates/oidc-proxy/tests/**'\n120\t  --exclude='**/tests/'\n121\t  --exclude='**/fixtures/'\n122\t  --exclude='.claude/scripts/red-team-corpus/'\n123\t  --exclude='.claude/eval/'\n124\t  --exclude='.claude/plans/PLAN-[0-9]*'\n125\t  --exclude='.claude/hooks/_lib/testing.py'\n126\t  --exclude='.claude/hooks/_lib/test_isolation.py'\n127\t  --exclude='__pycache__/'\n128\t  --exclude='*.pyc'\n129\t  --exclude='.pytest_cache/'\n130\t)\n131\tfor src in scripts templates .claude SPEC VERSION LICENSE README.md PROTOCOL.md; do\n132\t  if [[ -e \"$ROOT/$src\" ]]; then\n133\t    rsync -a --delete --delete-excluded \"${RSYNC_EXCLUDES[@]}\" \"$ROOT/$src\" \"$NPM_DIR/\"\n134\t  fi"}]},"parent_tool_use_id":null,"session_id":"44354e61-c2ec-4181-9296-3322c9641608","uuid":"9875d478-e3e7-441e-a3c2-5f02736f7734","timestamp":"2026-11-16T20:18:17.773Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/scripts/install-npm.sh","content":"# -------------------------------- version sync check -------------------------\nVERSION_FILE=\"$(tr -d '[:space:]' < \"$ROOT/VERSION\")\"\nPKG_VERSION=\"$(node -p \"require('$NPM_DIR/package.json').version\")\"\nif [[ \"$VERSION_FILE\" != \"$PKG_VERSION\" ]]; then\n  echo \"::error::VERSION ($VERSION_FILE) ≠ npm/package.json ($PKG_VERSION)\" >&2\n  echo \"Update npm/package.json::version to $VERSION_FILE before building.\" >&2\n  exit 1\nfi\necho \"OK: version sync — $VERSION_FILE\"\n\n# -------------------------------- stage bundle -------------------------------\n# Copy framework source tree into npm/ so npm pack picks it up via files: list.\n# Mirror npm-publish.yml step \"Stage bundle into npm/\".\n# PLAN-152 tarball-01: SELECTIVE staging — the root .npmignore is INERT under\n# the package.json \"files\" whitelist, so exclusion must happen here. Excludes\n# the framework-internal test harness, fixture corpora, eval/, red-team\n# corpus, numbered plan trees, and _lib/testing.py + _lib/test_isolation.py\n# (PLAN-120 contract install.sh already honors); keeps .claude/plans/ schemas\n# + README + examples/ and .claude/policies/fixtures/ (install.sh provisions\n# both).\necho \"==> Staging bundle into npm/\"\nRSYNC_EXCLUDES=(\n  --include='.claude/policies/fixtures/'\n  --include='templates/oidc-proxy/tests/'\n  --include='templates/oidc-proxy/tests/**'\n  --exclude='**/tests/'\n  --exclude='**/fixtures/'\n  --exclude='.claude/scripts/red-team-corpus/'\n  --exclude='.claude/eval/'\n  --exclude='.claude/plans/PLAN-[0-9]*'\n  --exclude='.claude/hooks/_lib/testing.py'\n  --exclude='.claude/hooks/_lib/test_isolation.py'\n  --exclude='__pycache__/'\n  --exclude='*.pyc'\n  --exclude='.pytest_cache/'\n)\nfor src in scripts templates .claude SPEC VERSION LICENSE README.md PROTOCOL.md; do\n  if [[ -e \"$ROOT/$src\" ]]; then\n    rsync -a --delete --delete-excluded \"${RSYNC_EXCLUDES[@]}\" \"$ROOT/$src\" \"$NPM_DIR/\"\n  fi","numLines":40,"startLine":95,"totalLines":339}},"tool_result_meta":[{"id":"toolu_013cdA9ejCFEEFHpoU3gFJFK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
