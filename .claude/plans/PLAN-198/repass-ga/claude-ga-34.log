{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gbmeu11dJ2Gee3D1YpVD3u","type":"tool_result","content":"320\t    \"\"\"Handle the `owner-sign` sub-command — append Owner-signed sigchain entry.\"\"\"\n321\t    owners_file = (\n322\t        Path(args.owners_file) if args.owners_file else DEFAULT_OWNERS_FILE\n323\t    )\n324\t    email = _require_owner_allowlisted(owners_file)\n325\t    if email is None:\n326\t        return 1\n327\t    if not _SP_CHAIN_ID_RE.match(args.sp_chain_id):\n328\t        sys.stderr.write(\n329\t            \"owner-sign: sp_chain_id must match ^SP-\\\\d{3}-[a-f0-9]{8}$\\n\"\n330\t        )\n331\t        return 2\n332\t    if args.from_tier not in VALID_MODEL_IDS:\n333\t        sys.stderr.write(\n334\t            \"owner-sign: from_tier must be a known model ID\\n\"\n335\t        )\n336\t        return 2\n337\t    if args.to_tier not in VALID_MODEL_IDS:\n338\t        sys.stderr.write(\n339\t            \"owner-sign: to_tier must be a known model ID\\n\"\n340\t        )\n341\t        return 2\n342\t    if args.agent not in CANONICAL_5_AGENTS:\n343\t        sys.stderr.write(\n344\t            \"owner-sign: agent must be one of canonical-5\\n\"\n345\t        )\n346\t        return 2\n347\t    # ADR-149 Amendment 3 (S357): the action this entry signs is the one\n348\t    # the learner computes — learn._direction over learn._tier_rank, ONE\n349\t    # authority. VALID_MODEL_IDS is an allowlist in ADR order, not a tier\n350\t    # order (claude-fable-5 is its first entry): its index signed\n351\t    # fable-5 -> opus-5, and fable-5-1 -> opus-5-5, as \"promote\". An id\n352\t    # the ladder does not rank, or the same model on both sides, is\n353\t    # refused before anything is signed.\n354\t    if (\n355\t        learn_mod._tier_rank(args.from_tier) < 0\n356\t        or learn_mod._tier_rank(args.to_tier) < 0\n357\t    ):\n358\t        sys.stderr.write(\n359\t            \"owner-sign: model ID has no tier rank; aborting\\n