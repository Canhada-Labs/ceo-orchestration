ed below.\n44\t# Runtime constant — used by loader.py / learn.py for allowlist checks.\n45\t# ADR-149: claude-fable-5 added (flagship generation bump, additive).\n46\t# ADR-181 (PLAN-163 T1.2d): claude-opus-5 + claude-sonnet-5 added — the\n47\t# Claude 5 refresh working-set members; additive, historical ids stay.\n48\t# ADR-149 Amendment 2 (S338): claude-fable-5-1 appended — working-set\n49\t# only (not a VETO-floor member); additive.\n50\t# ADR-149 Amendment 3 (S357): claude-opus-5-5 appended — working set AND\n51\t# VETO floor; additive.\n52\t# Independent mirror of the ADR-149 AVAILABLE_MODELS_WORKING_SET\n53\t# (defense-in-depth literal; parity enforced by\n54\t# hooks/tests/test_adr149_validator_parity.py).\n55\tVALID_MODEL_IDS: \"Final[Tuple[str, ...]]\" = (\n56\t    \"claude-opus-4-8\",\n57\t    \"claude-fable-5\",\n58\t    \"claude-sonnet-4-6\",\n59\t    \"claude-haiku-4-5-[REDACTED:rg]\",\n60\t    \"claude-opus-5\",\n61\t    \"claude-sonnet-5\",\n62\t    \"claude-fable-5-1\",\n63\t    \"claude-opus-5-5\",\n64\t)\n65\t\n66\t\n67\t# ---------------------------------------------------------------------\n68\t# Role ↔ task-type mapping (C-P0-6).\n69\t# Statistical power gate aggregates tournament win-rates per\n70\t# (role × task-type) cell; this mapping tells learn.py which ADR-063\n71\t# task-types count toward each canonical-5 role.\n72\t# Aggregation across cells for a role: MIN gap_pp (conservative).\n73\t# ---------------------------------------------------------------------\n74\tROLE_TO_TASK_TYPES: \"Final[Dict[str, List[str]]]\" = {\n75\t    \"code-reviewer\": [\"code-review\", \"security-review\"],\n76\t    \"security-engineer\": [\"security-review\"],\n77\t    \"qa-architect\": [\"test-design\"],\n78\t    \"performance-engineer\": [\"performance-triage\"],\n79\t    \"devops\": [\"docs-writing\"],\n80\t}\n81\t\n82\t\n83\t# ---------------------------------------------------------------------\n84\t# Canonical-5 agent slugs (policy artifact assignments ke