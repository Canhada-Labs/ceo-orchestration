{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015eGyuga1dmN3SsaEVVX9b5","type":"tool_result","content":"560\t            if age_hours > args.max_age_hours:\n561\t                print(\n562\t                    f\"EXPIRED: verdict {age_hours:.1f}h old \"\n563\t                    f\"(max {args.max_age_hours}h)\",\n564\t                    file=sys.stderr,\n565\t                )\n566\t                return EXIT_VERDICT_EXPIRED\n567\t        except (TypeError, ValueError):\n568\t            print(f\"INFRA: unparseable generated_at: {generated_at!r}\", file=sys.stderr)\n569\t            return EXIT_INFRA_ERROR\n570\t\n571\t    # R1 S-Sec-4: inputs_hash recompute\n572\t    if args.recompute_inputs_hash and args.inputs_hash_paths_file:\n573\t        try:\n574\t            actual_hash = compute_inputs_hash(\n575\t                repo_root, Path(args.inputs_hash_paths_file)\n576\t            )\n577\t        except (FileNotFoundError, ValueError) as e:\n578\t            print(f\"INFRA: inputs_hash recompute failed: {e}\", file=sys.stderr)\n579\t            return EXIT_INFRA_ERROR\n580\t        declared_hash = verdict.get(\"inputs_hash\", \"\").strip()\n581\t        if declared_hash != actual_hash:\n582\t            print(\n583\t                f\"INVALID: inputs_hash mismatch — \"\n584\t                f\"declared='{declared_hash[:16]}', actual='{actual_hash[:16]}'\",\n585\t                file=sys.stderr,\n586\t            )\n587\t            return EXIT_VERDICT_INVALID\n588\t\n589\t    # R1 C5: Codex CLI pin enforcement\n590\t    if args.codex_cli_pin_file:\n591\t        try:\n592\t            min_v, max_v = parse_pin_range(Path(args.codex_cli_pin_file))\n593\t        except (OSError, ValueError) as exc:\n594\t            print(f\"INVALID: codex CLI pin range rejected: {exc}\", file=sys.stderr); return EXIT_VERDICT_INVALID\n595\t        if min_v:\n596\t            tool_versions = verdict.get(\"tool_versions\", {})\n597\t            if not isinstance(tool_versions, dict):\n598\t                # Codex iter-6 P1 fix — malformed tool_versions (scalar /\n599\t                # non-dict) previously bypassed both semver + binary-SHA\n600\t                # checks. Now hard-fail.\n601\t                print(\n602\t                    f\"INVALID: tool_versions field must be a dict, got \"\n603\t                    f\"{type(tool_versions).__name__}: {tool_versions!r}\",\n604\t                    file=sys.stderr,\n605\t                )\n606\t                return EXIT_VERDICT_INVALID\n607\t            cli_v = tool_versions.get(\"codex_cli\", \"\")\n608\t            comparison = cli_currency.compare_semver(cli_v, min_v)\n609\t            upper_comparison = cli_currency.compare_semver(cli_v, max_v) if max_v else None\n610\t            if (\n611\t                comparison is None\n612\t                or comparison < 0\n613\t                or (max_v is not None and (upper_comparison is None or upper_comparison >= 0))\n614\t            ):\n615\t                range_text = f\">={min_v}\" if max_v is None else f\">={min_v},<{max_v}\"\n616\t                print(\n617\t                    f\"INVALID: codex_cli version {cli_v!r} not in pin \"\n618\t                    f\"range {range_text}\",\n619\t                    file=sys.stderr,\n620\t                )\n621\t                return EXIT_VERDICT_INVALID\n622\t            if comparison > 0 and max_v is None:\n623\t                print(f\"INFO: codex_cli {cli_v} is newer than compatibility floor \"\n624\t                      f\">={min_v}; payload pin uses version-only compatibility\", file=sys.stderr)\n625\t\n626\t    # PLAN-081 Phase 6-bis / T-8: Codex CLI binary SHA-256 pin enforcement\n627\t    if args.codex_cli_binary_sha256_file:\n628\t        pin_path = Path(args.codex_cli_binary_sha256_file)\n629\t        if not pin_path.exists():\n630\t            # ADVISORY skip per Codex iter-1 P1 — missing pin file is a\n631\t            # rollout state (e.g. legacy verdicts pre-Phase-6-bis); do NOT\n632\t            # hard-fail. release.yml step 15 still gates on the codex_cli\n633\t            # semver pin (R1 C5) which is mandatory.\n634\t            print(\n635\t                f\"ADVISORY: codex-cli-binary-sha256-file not found at {pin_path}; \"\n636\t                f\"skipping T-8 binary-SHA pin check (semver pin still enforced)\",\n637\t                file=sys.stderr,\n638\t            )\n639\t            expected_sha = \"\"\n640\t        else:\n641\t            expected_sha = \"\"\n642\t            for line in pin_path.read_text().splitlines():\n643\t                line = line.split(\"#\", 1)[0].strip()\n644\t                if line:\n645\t                    expected_sha = line\n646\t                    break\n647\t        if expected_sha and len(expected_sha) == 64:\n648\t            tool_versions = verdict.get(\"tool_versions\", {})\n649\t            if not isinstance(tool_versions, dict):\n650\t                # Codex iter-7 P1 fix — scalar/non-dict tool_versions\n651\t                # previously silently skipped binary-SHA check (only the\n652\t                # semver pin path enforced dict shape). Hard-fail\n653\t                # consistently regardless of which pin is being checked.\n654\t                print(\n655\t                    f\"INVALID: tool_versions field must be a dict for binary-SHA \"\n656\t                    f\"check, got {type(tool_versions).__name__}: {tool_versions!r}\",\n657\t                    file=sys.stderr,\n658\t                )\n659\t                return EXIT_VERDICT_INVALID\n660\t            declared_binary_sha = tool_versions.get(\n661\t                \"codex_cli_binary_sha256\", \"\"\n662\t            ).strip()\n663\t            if not declared_binary_sha:\n664\t                # When the pin file exists + is non-empty, verdict\n665\t                # envelope MUST carry the binary SHA — missing field is\n666\t                # a regression / pre-rollout legacy state. Per Codex\n667\t                # iter-5 P1 finding, this is hard-fail when pin file\n668\t                # provides authoritative SHA.\n669\t                print(\n670\t                    f\"INVALID: codex-cli-binary-sha256-file pin '{pin_path}' \"\n671\t                    f\"exists + non-empty (sha='{expected_sha[:16]}'), but \"\n672\t                    f\"verdict envelope lacks tool_versions.codex_cli_binary_sha256\",\n673\t                    file=sys.stderr,\n674\t                )\n675\t                return EXIT_VERDICT_INVALID\n676\t            if declared_binary_sha != expected_sha:\n677\t                print(\n678\t                    f\"INVALID: codex_cli_binary_sha256 mismatch — \"\n679\t                    f\"declared='{declared_binary_sha[:16]}', \"\n680\t                    f\"pin='{expected_sha[:16]}'\",\n681\t                    file=sys.stderr,\n682\t                )\n683\t                return EXIT_VERDICT_INVALID\n684\t\n685\t    # ADR-182 (PLAN-163 T5.2): payload-pin manifest enforcement. The\n686\t    # verdict envelope carries the sha256 of the NATIVE codex payload\n687\t    # for the platform triple of the generating run (wire-shape defined\n688\t    # in ADR-182: scalar `tool_versions.codex_payload_sha256` + scalar\n689\t    # `tool_versions.codex_target_triple`); the validator compares it\n690\t    # against `payloads[<triple>].sha256` in the manifest. Fail-CLOSED\n691\t    # on everything except an unreadable manifest file (infra).\n692\t    if args.codex_pin_manifest_file:\n693\t        manifest_path = Path(args.codex_pin_manifest_file)\n694\t        try:\n695\t            manifest_raw = manifest_path.read_text(encoding=\"utf-8\")\n696\t        except OSError as e:\n697\t            print(\n698\t                f\"INFRA: codex-pin-manifest-file unreadable at \"\n699\t                f\"{manifest_path}: {e}\",\n700\t                file=sys.stderr,\n701\t            )\n702\t            return EXIT_INFRA_ERROR\n703\t        try:\n704\t            manifest = json.loads(manifest_raw)\n705\t        except ValueError as e:\n706\t            print(\n707\t                f\"INVALID: codex-pin-manifest-file is not valid JSON \"\n708\t                f\"({e}) — fail-CLOSED per ADR-182\",\n709\t                file=sys.stderr,\n710\t            )\n711\t            return EXIT_VERDICT_INVALID\n712\t        if (\n713\t            not isinstance(manifest, dict)\n714\t            or manifest.get(\"schema\") != 1\n715\t            or cli_currency.parse_semver(manifest.get(\"package_version\")) is None\n716\t            or not isinstance(manifest.get(\"payloads\"), dict)\n717\t        ):\n718\t            print(\n719\t                \"INVALID: codex-pin-manifest-file schema violation \"\n720\t                \"(expected schema=1 + stable package_version + payloads dict) — fail-CLOSED per ADR-182\",\n721\t                file=sys.stderr,\n722\t            )\n723\t            return EXIT_VERDICT_INVALID\n724\t        tool_versions = verdict.get(\"tool_versions\", {})\n725\t        if not isinstance(tool_versions, dict):\n726\t            print(\n727\t                f\"INVALID: tool_versions field must be a dict for \"\n728\t                f\"payload-pin check, got \"\n729\t                f\"{type(tool_versions).__name__}: {tool_versions!r}\",\n730\t                file=sys.stderr,\n731\t            )\n732\t            return EXIT_VERDICT_INVALID\n733\t        declared_triple = str(\n734\t            tool_versions.get(\"codex_target_triple\", \"\")\n735\t        ).strip()\n736\t        declared_payload_sha = str(\n737\t            tool_versions.get(\"codex_payload_sha256\", \"\")\n738\t        ).strip()\n739\t        if not declared_triple or not declared_payload_sha:\n740\t            print(\n741\t                \"INVALID: ADR-182 payload pin requested \"\n742\t                f\"(manifest='{manifest_path}') but verdict envelope \"\n743\t                \"lacks tool_versions.codex_target_triple and/or \"\n744\t                \"tool_versions.codex_payload_sha256\",\n745\t                file=sys.stderr,\n746\t            )\n747\t            return EXIT_VERDICT_INVALID\n748\t        if not re.fullmatch(r\"[0-9a-f]{64}\", declared_payload_sha):\n749\t            print(\"INVALID: verdict codex_payload_sha256 has malformed sha256 \"\n750\t                  \"— fail-CLOSED per ADR-182\", file=sys.stderr)\n751\t            return EXIT_VERDICT_INVALID\n752\t        entry = manifest[\"payloads\"].get(declared_triple)\n753\t        if not isinstance(entry, dict):\n754\t            print(\n755\t                f\"INVALID: targetTriple '{declared_triple}' absent from \"\n756\t                f\"codex-pin-manifest payloads — fail-CLOSED per ADR-182\",\n757\t                file=sys.stderr,\n758\t            )\n759\t            return EXIT_VERDICT_INVALID\n760\t        expected_payload_sha = str(entry.get(\"sha256\", \"\")).strip()\n761\t        if not re.match(r\"^[0-9a-f]{64}$\", expected_payload_sha):\n762\t            print(\n763\t                f\"INVALID: manifest entry for '{declared_triple}' has \"\n764\t                f\"malformed sha256 — fail-CLOSED per ADR-182\",\n765\t                file=sys.stderr,\n766\t            )\n767\t            return EXIT_VERDICT_INVALID\n768\t        package_version = manifest[\"package_version\"]\n769\t        cli_version = tool_versions.get(\"codex_cli\")\n770\t        version_comparison = cli_currency.compare_semver(cli_version, package_version)\n771\t        newer_floor = cli_currency.compare_semver(cli_version, cli_currency.CODEX_VERSION_FLOOR)\n772\t        exact_payload_pin = version_comparison in (None, 0) or newer_floor is None or newer_floor < 0\n773\t        if exact_payload_pin and declared_payload_sha != expected_payload_sha:\n774\t            print(\n775\t                f\"INVALID: codex_payload_sha256 mismatch for \"\n776\t                f\"'{declared_triple}' — \"\n777\t                f\"declared='{declared_payload_sha[: