{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M4iuXw45NhBMFW2Jz7NDEi","type":"tool_result","content":"1\t\"\"\"Fail-open, per-session observability for explicitly disabled GuardFall rails.\n2\t\n3\tThe hook checks trusted switch values before calling :func:`disabled_once`.\n4\tThis module receives only a closed switch *name*, never its environment value\n5\tor the rejected command. A marker written with O_EXCL arbitrates concurrent\n6\thook processes; a crash after marker creation may lose telemetry, consistent\n7\twith the existing learning-rail breadcrumb contract.\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\timport hashlib\n13\timport os\n14\tfrom pathlib import Path\n15\tfrom typing import Optional\n16\t\n17\t\n18\t_SWITCHES = frozenset({\n19\t    \"CEO_BASH_INDIRECT_GUARD\",\n20\t    \"CEO_BASH_INDIRECT_HEURISTICS\",\n21\t})\n22\t_MARKER_DIR = \"bash-indirect-disabled\"\n23\t\n24\t\n25\tdef _marker_path(audit_dir: Path, session_id: str, switch: str) -> Path:\n26\t    \"\"\"Opaque, bounded marker name; raw session bytes never become a path.\"\"\"\n27\t    session_hash = hashlib.sha256(\n28\t        session_id.encode(\"utf-8\", \"replace\")\n29\t    ).hexdigest()[:24]\n30\t    switch_tag = \"guard\" if switch == \"CEO_BASH_INDIRECT_GUARD\" else \"heuristics\"\n31\t    return audit_dir / _MARKER_DIR / (session_hash + \".\" + switch_tag)\n32\t\n33\t\n34\tdef disabled_once(switch: str, session_id: Optional[str] = None) -> None:\n35\t    \"\"\"Emit one ``learning_rail_disabled`` per session and recognized switch.\n36\t\n37\t    Caller must invoke this ONLY when trusted configuration explicitly turns\n38\t    the rail off. Unset/default configuration must never reach this function.\n39\t    Missing session identity suppresses emission to avoid false deduplication\n40\t    across unrelated sessions. Every failure is deliberately fail-open.\n41\t    \"\"\"\n42\t    if switch not in _SWITCHES:\n43\t        return\n44\t    try:\n45\t        sid = session_id if session_id is not None else os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n46\t        if not isinstance(sid, str) or not sid:\n47\t            return\n48\t        # Import at call time: test suites and hooks may rebind the facade.\n49\t        from _lib import audit_emit\n50\t\n51\t        audit_dir = audit_emit._log_family_dir()\n52\t        marker = _marker_path(audit_dir, sid, switch)\n53\t        marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n54\t        try:\n55\t            fd = os.open(str(marker), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)\n56\t        except FileExistsError:\n57\t            return\n58\t        os.close(fd)\n59\t        audit_emit.emit_learning_rail_disabled(\n60\t            rail=\"bash_indirect\",\n61\t            switch=switch,\n62\t            hook=\"check_bash_safety\",\n63\t            session_id=sid,\n64\t            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n65\t        )\n66\t    except Exception:\n67\t        # Telemetry failure must never alter the safety hook's decision.\n68\t        return\n69\t"}]},"parent_tool_use_id":null,"session_id":"33c378c0-c6a8-475a-b029-4896d83549f9","uuid":"624c6f4a-ea1d-4b9d-9b89-9bd8b85b0b57","timestamp":"2026-11-16T17:51:05.906Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/bash_indirect_telemetry.py","content":"\"\"\"Fail-open, per-session observability for explicitly disabled GuardFall rails.\n\nThe hook checks trusted switch values before calling :func:`disabled_once`.\nThis module receives only a closed switch *name*, never its environment value\nor the rejected command. A marker written with O_EXCL arbitrates concurrent\nhook processes; a crash after marker creation may lose telemetry, consistent\nwith the existing learning-rail breadcrumb contract.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nimport os\nfrom pathlib import Path\nfrom typing import Optional\n\n\n_SWITCHES = frozenset({\n    \"CEO_BASH_INDIRECT_GUARD\",\n    \"CEO_BASH_INDIRECT_HEURISTICS\",\n})\n_MARKER_DIR = \"bash-indirect-disabled\"\n\n\ndef _marker_path(audit_dir: Path, session_id: str, switch: str) -> Path:\n    \"\"\"Opaque, bounded marker name; raw session bytes never become a path.\"\"\"\n    session_hash = hashlib.sha256(\n        session_id.encode(\"utf-8\", \"replace\")\n    ).hexdigest()[:24]\n    switch_tag = \"guard\" if switch == \"CEO_BASH_INDIRECT_GUARD\" else \"heuristics\"\n    return audit_dir / _MARKER_DIR / (session_hash + \".\" + switch_tag)\n\n\ndef disabled_once(switch: str, session_id: Optional[str] = None) -> None:\n    \"\"\"Emit one ``learning_rail_disabled`` per session and recognized switch.\n\n    Caller must invoke this ONLY when trusted configuration explicitly turns\n    the rail off. Unset/default configuration must never reach this function.\n    Missing session identity suppresses emission to avoid false deduplication\n    across unrelated sessions. Every failure is deliberately fail-open.\n    \"\"\"\n    if switch not in _SWITCHES:\n        return\n    try:\n        sid = session_id if session_id is not None else os.environ.get(\"CLAUDE_SESSION_ID\", \"\")\n        if not isinstance(sid, str) or not sid:\n            return\n        # Import at call time: test suites and hooks may rebind the facade.\n        from _lib import audit_emit\n\n        audit_dir = audit_emit._log_family_dir()\n        marker = _marker_path(audit_dir, sid, switch)\n        marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n        try:\n            fd = os.open(str(marker), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)\n        except FileExistsError:\n            return\n        os.close(fd)\n        audit_emit.emit_learning_rail_disabled(\n            rail=\"bash_indirect\",\n            switch=switch,\n            hook=\"check_bash_safety\",\n            session_id=sid,\n            project=os.environ.get(\"CLAUDE_PROJECT_DIR\", \"\"),\n        )\n    except Exception:\n        # Telemetry failure must never alter the safety hook's decision.\n        return\n","numLines":69,"startLine":1,"totalLines":69}},"tool_result_meta":[{"id":"toolu_01M4iuXw45NhBMFW2Jz7NDEi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
