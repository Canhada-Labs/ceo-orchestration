{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018nTti3fiQPvR3YK61hGshP","type":"tool_result","content":"490\t# ---------------------------------------------------------------------------\n491\t# PLAN-154 (Gated Learning Loop / ADR-160) — Sec MF-3 closed enums + field\n492\t# allowlists for the 11 learning-loop actions. All deny-by-default; every\n493\t# branch also re-coerces VALUES by closed-set membership / bounded charset so\n494\t# a direct emit_generic caller can never sign free text into the HMAC chain\n495\t# (A2 metadata-only). NEVER _EMIT_GENERIC_PASSTHROUGH.\n496\t# ---------------------------------------------------------------------------\n497\t\n498\t# Base signed envelope every PLAN-154 allowlist pre-allows so the scrub does\n499\t# not strip _write_event's own keys on a round-trip.\n500\t_LEARNING_ENVELOPE = frozenset({\n501\t    \"action\", \"session_id\", \"project\",\n502\t    \"ts\", \"event_schema\",\n503\t    \"tokens_in\", \"tokens_out\", \"tokens_total\",\n504\t    \"hmac\", \"hmac_error\",\n505\t})\n506\t\n507\t\n508\t_LEARNING_RAIL_ENUM = frozenset({\"observe\", \"distill\", \"boot_render\", \"fact_gate\", \"bash_indirect\"})\n509\t\n510\t\n511\t_LEARNING_SWITCH_ENUM = frozenset({\n512\t    \"CEO_LEARNING_OBSERVE\", \"CEO_LEARNING_BOOT_LESSONS\",\n513\t    \"CEO_LEARNING_DISTILL_MODEL\", \"CEO_FACT_GATE_ENFORCE\",\n514\t    \"CEO_FACT_GATE_SHADOW\", \"CEO_ADVISORY_DAMPEN\",\n515\t    \"CEO_SOTA_DISABLE\", \"other\",\n516\t    \"CEO_BASH_INDIRECT_GUARD\", \"CEO_BASH_INDIRECT_HEURISTICS\",\n517\t})\n518\t\n519\t\n520\t_LESSON_CANDIDATE_STATUS_ENUM = frozenset({\"PENDING\", \"QUARANTINED\"})\n521\t\n522\t\n523\t_LESSON_SCAN_OUTCOME_ENUM = frozenset({\n524\t    \"clean\", \"scanner_unavailable\", \"injection_pattern\",\n525\t})\n526\t\n527\t\n528\t_LESSON_QUARANTINE_REASON_ENUM = frozenset({\n529\t    \"injection_pattern\", \"content_hash_mismatch\", \"vocab_violation\","}]},"parent_tool_use_id":null,"session_id":"33c3