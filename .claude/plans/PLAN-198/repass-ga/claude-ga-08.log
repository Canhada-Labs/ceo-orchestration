nt(\"FATAL: cannot inspect --root: %s\"\n2711\t-              % _personal_path_safe(_oserror_reason(exc)),\n2712\t-              file=sys.stderr)\n2713\t-        return 2\n2714\t-    if not is_repo:\n2715\t-        # Not a git repo — exit 2\n2716\t-        print(\"FATAL: not inside a git repo\", file=sys.stderr)\n2717\t-        return 2\n2718\t+# ---------------------------------------------------------------------------\n2719\t+# RULE 1 (`scan`) — census of the borders where it could answer \"clean\" without\n2720\t+# having looked, taken before changing it (PLAN-186-FOLLOWUP AC-7; item 11 of the\n2721\t+# 1.4.4 backlog: the pack fell twice in the rail, by edges AC-7 had not listed).\n2722\t+# CURED, each with a test named test_fu144_* in test_check_contamination_personal_path.py:\n2723\t+#   * empty or partial walk: FileWalker turns a git failure into an empty iterator.\n2724\t+#     The set of paths seen must COVER the index (a set, not a count, for the reason\n2725\t+#     RULE 2 paid for in pair-rail S344 round 3);\n2726\t+#   * an index that cannot be read (git missing, timeout, rc != 0): refused;\n2727\t+#   * a name that is not valid UTF-8: both sides of the proof decode with\n2728\t+#     errors=\"replace\", so two such names collapse into one and the sets compare equal\n2729\t+#     over an unread file. Refused over the WHOLE index before any comparison; RULE 2's\n2730\t+#     scope exception does not apply, because this rule's scope is every tracked path;\n2731\t+#   * a tracked symlink (120000): its blob is the target STRING. read_bytes() followed\n2732\t+#     it, so a term in the payload was never read and someone else's file was judged;\n2733\t+#   * an index mode other than file, executable, link or gitlink: refused;\n2734\t+#   * a file that exists and cannot be read, or a non-regular inode at a tracked path\n2735\t+#     (a FIFO used to hang the read): rc 2. This reverses a deliberate \"fail-OPEN,\n2736\t+#     INFRASTRUCTURE\" note; it is a gate, not a hook, as _personal_path_assert_enumerable\n2737\t+#     already argues, so nothing here blocks a session;\n2738\t+#   * a terms file that is not a regular file was read as absent (`_load_private_terms`).\n2739\t+# DECLARED, not cured:\n2740\t+#   * one stray non-UTF-8 byte still makes this rule skip an ordinary file whole (a term\n2741\t+#     beside it goes unseen). Outside the LEDGER class that is a pinned decision, not an\n2742\t+#     oversight: test_an_undecodable_non_plan_file_is_still_skipped calls it what keeps\n2743\t+#     the exception narrow. Changing it is the Owner's call, not this pack's;\n2744\t+#   * the path allowlist remains an exemption; all other indexed blobs are scanned;\n2745\t+#   * a UTF-16 document does not match;\n2746\t+#   * the index is enumerated and the worktree is read, as in RULE 2's blind spots;\n2747\t+#   * a U+FFFD that is really in a tracked name is refused too (the safe direction).\n2748\t+# ---------------------------------------------------------------------------\n2749\t \n2750\t-    allowlist_path = (\n2751\t-        Path(args.personal_path_allowlist)\n2752\t-        if args.personal_path_allowlist is not None\n2753\t-        else repo_root / _PERSONAL_PATH_ALLOWLIST_REL\n2754\t-    )\n2755\t-    if args.emit_personal_path_rows:\n2756\t-        # Rows ONLY: the term report would make the output\n2757\t-        # unpasteable, and this mode exists to be pasted.\n2758\t-        return report_personal_paths(\n2759\t-            repo_root, allowlist_path, emit_rows=True,\n2760\t-        )\n2761\t \n2762\t-    try:\n2763\t-        violations = scan(repo_root)\n2764\t-    except Exception as exc:\n2765\t-        # A BOUNDARY, not a list of exception types. The term\n2766\t-        # scan reads a file and COMPILES what is in it as a raw\n2767\t-        # regex, so its failure modes are open-ended: OSError,\n2768\t-        # UnicodeDecodeError and re.error were each named here\n2769\t-        # after a rail round found them,