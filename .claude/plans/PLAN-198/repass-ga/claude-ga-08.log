{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Db9bkN8kEc6FeYqfdy6HPJ","type":"tool_result","content":"1\t\"\"\"Term-rule implementation shared by the contamination command facade.\n2\t\n3\tDependencies are arguments rather than imports from the facade.  This keeps\n4\tthe historical module-level patch points (notably ``FileWalker``) effective.\n5\t\"\"\"\n6\t\n7\tfrom __future__ import annotations\n8\t\n9\tfrom pathlib import Path\n10\tfrom typing import Callable, List, Set, Type\n11\t\n12\tfrom _contamination_inventory import RuleOneInputError, scan_rule_one\n13\t\n14\t\n15\tdef find_violations(\n16\t    repo_root: Path,\n17\t    pattern,\n18\t    walker_type: Type[object],\n19\t    allowlist_exact: Set[str],\n20\t    allowlist_globs: Set[str],\n21\t    skip_suffixes: Set[str],\n22\t    never_allowlisted: Callable[[str], bool],\n23\t    index_modes: Callable,\n24\t    unreadable: type,\n25\t) -> List[Path]:\n26\t    \"\"\"Apply the term rule and return tracked files that violate it.\n27\t\n28\t    ``walker_type`` is injected on every call so a consumer patching the\n29\t    public facade sees the same behaviour it saw before this extraction.\n30\t    \"\"\"\n31\t    walker = walker_type(\n32\t        repo_root=repo_root,\n33\t        mode=\"git\",\n34\t        path_allowlist_exact=allowlist_exact,\n35\t        path_allowlist_globs=allowlist_globs,\n36\t    )\n37\t    try:\n38\t        return scan_rule_one(\n39\t            repo_root=walker.repo_root,\n40\t            pattern=pattern,\n41\t            allowlisted=walker.is_allowlisted,\n42\t            never_allowlisted=never_allowlisted,\n43\t            walked=walker.iter_files(),\n44\t            observed_modes=index_modes(walker.repo_root),\n45\t        )\n46\t    except RuleOneInputError as exc:\n47\t        raise unreadable(str(exc)) from None\n48\t"}]},"parent_tool_use_id":null,"session_id":"b318667c-8c92-4c08-a224-b1d445c0d252","uuid":"be610511-d1c6-4588-bb1b-720029a1040a","timestamp":"2026-11-16T18:17:33.834Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_contamination/term_scan.py","content":"\"\"\"Term-rule implementation shared by the contamination command facade.\n\nDependencies are arguments rather than imports from the facade.  This keeps\nthe historical module-level patch points (notably ``FileWalker``) effective.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\nfrom typing import Callable, List, Set, Type\n\nfrom _contamination_inventory import RuleOneInputError, scan_rule_one\n\n\ndef find_violations(\n    repo_root: Path,\n    pattern,\n    walker_type: Type[object],\n    allowlist_exact: Set[str],\n    allowlist_globs: Set[str],\n    skip_suffixes: Set[str],\n    never_allowlisted: Callable[[str], bool],\n    index_modes: Callable,\n    unreadable: type,\n) -> List[Path]:\n    \"\"\"Apply the term rule and return tracked files that violate it.\n\n    ``walker_type`` is injected on every call so a consumer patching the\n    public facade sees the same behaviour it saw before this extraction.\n    \"\"\"\n    walker = walker_type(\n        repo_root=repo_root,\n        mode=\"git\",\n        path_allowlist_exact=allowlist_exact,\n        path_allowlist_globs=allowlist_globs,\n    )\n    try:\n        return scan_rule_one(\n            repo_root=walker.repo_root,\n            pattern=pattern,\n            allowlisted=walker.is_allowlisted,\n            never_allowlisted=never_allowlisted,\n            walked=walker.iter_files(),\n            observed_modes=index_modes(walker.repo_root),\n        )\n    except RuleOneInputError as exc:\n        raise unreadable(str(exc)) from None\n","numLines":48,"startLine":1,"totalLines":48}},"tool_result_meta":[{"id":"toolu_01Db9bkN8kEc6FeYqfdy6HPJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
