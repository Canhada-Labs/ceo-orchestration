    53	def _cli_is_canonical(args: List[str]) -> int:
    54	    """PLAN-156-FOLLOWUP F5 (debate C2(b)) — read-only canonical-path
    55	    classification ORACLE.
    56	
    57	    Single-source-of-truth CLI so shell consumers (the grok/codex pre-push
    58	    review gates) classify paths with the SAME ``_is_canonical`` predicate
    59	    the edit-time guard and the Stop-review recorder use — re-implementing
    60	    the guard glob list in bash IS the drift class F5 fixes.
    61	
    62	    Usage:
    63	        python3 check_canonical_edit.py --is-canonical <path>...
    64	        python3 check_canonical_edit.py --is-canonical -   # paths on stdin,
    65	                                                           # one per line
    66	                                                           # (ARG_MAX-safe)
    67	
    68	    Output: one line per input path, ``<path>\\t<0|1>`` (1 = canonical),
    69	    in input order. Exit 0 on successful classification of every path.
    70	    Exit 2 when no path argument/stdin is supplied (consumers must treat
    71	    ANY nonzero exit as oracle failure and fall back fail-CLOSED to their
    72	    coarse over-triggering classifier).
    73	
    74	    Contract notes:
    75	    - Pure read-only classification. NO hook semantics run in this mode:
    76	      no event parse, no adapter, no sentinel lookup, no emission on the
    77	      hook wire. The hook entry (``main()``) is byte-identical when the
    78	      script is invoked as a hook (argv empty — ``_python-hook.sh`` passes
    79	      no arguments).
    80	    - Repo root resolves exactly like the hook path does
    81	      (``CLAUDE_PROJECT_DIR`` or cwd — see ``main()``), so oracle and hook
    82	      can never disagree on anchoring.
    83	    - Per-path classification fault → that path is reported ``1``
    84	      (canonical). Over-triggering review on an unclassifiable path is the
    85	      safe direction (fail-CLOSED); under-triggering would let an
    86	      unreviewed L3 touch through. ``_is_canonical`` itself already
    87	      returns False for paths outside the repo root — that is the
    88	      oracle's own semantics, not a fault.
    89	    """
    90	    repo_root = Path(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
    91	    paths: List[str] = list(args)
    92	    if paths == ["-"]:
    93	        paths = [ln.rstrip("\n") for ln in sys.stdin.read().splitlines()]
    94	        paths = [p for p in paths if p]
    95	    if not paths:
    96	        sys.stderr.write(
    97	            "usage: check_canonical_edit.py --is-canonical <path>... | -\n"
    98	        )
    99	        return 2
   100	    out_lines: List[str] = []
   101	    for raw in paths:
   102	        try:
   103	            flag = 1 if _is_canonical(raw, repo_root) else 0
   104	        except Exception:
   105	            # Fail-CLOSED per path: unclassifiable → treat as canonical
   106	            # (over-trigger review, never under-trigger).
   107	            flag = 1
   108	        out_lines.append("%s\t%d" % (raw, flag))
   109	    sys.stdout.write("\n".join(out_lines) + "\n")
   110	    return 0
