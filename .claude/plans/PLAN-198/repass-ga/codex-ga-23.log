   113	def main() -> int:
   114	    """Hook entry point.
   115	
   116	    PLAN162_FIX_1 / PLAN162_FIX_9 wrapper: arms the per-invocation
   117	    wall-clock deadline (consensus C2/C3/S8) around the real entry point
   118	    and clears BOTH pieces of invocation-scoped module state in a
   119	    ``finally``. Without the reset, a module-scope deadline (or a stale
   120	    tool name) armed by one in-process invocation would leak into the
   121	    next caller in the same process — the test suite drives ``decide()``
   122	    and ``main()`` in-process, and an expired leftover deadline would
   123	    fail those closed for no reason at all.
   124	    """
   125	    global _CURRENT_TOOL_NAME
   126	    if _COMPONENT_IMPORT_ERROR is not None:
   127	        print("check_canonical_edit: component import unavailable (" +
   128	              _COMPONENT_IMPORT_ERROR + ")", file=sys.stderr)
   129	        if _COMPONENT_IMPORT_IS_INTEGRITY_FAILURE:
   130	            print(_emit_block("CANONICAL-EDIT-BLOCKED: canonical_edit integrity "
   131	                              "failure: component import unavailable."))
   132	            return 0
   133	        print(_emit_allow())
   134	        return 0
   135	    _start_wall_budget()
   136	    try:
   137	        return _main_guarded()
   138	    finally:
   139	        _reset_wall_budget()
   140	        _CURRENT_TOOL_NAME = ""
