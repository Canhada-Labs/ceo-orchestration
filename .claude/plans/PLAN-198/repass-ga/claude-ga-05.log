{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01V49qDpS4k729WLDpC5RjDC","type":"tool_result","content":"150\t_BUILTIN_KNOWN_TOP_LEVEL_KEYS = frozenset(\n151\t    {\n152\t        \"decision\",\n153\t        \"reason\",\n154\t        \"continue\",\n155\t        \"stopReason\",\n156\t        \"suppressOutput\",\n157\t        \"systemMessage\",\n158\t        \"hookSpecificOutput\",\n159\t        \"additionalContext\",\n160\t        \"message\",\n161\t        \"permissionDecision\",\n162\t        \"permissionDecisionReason\",\n163\t    }\n164\t)\n165\t\n166\t_DENY_DECISIONS = frozenset({\"block\", \"deny\"})\n167\t\n168\t# Security matchers: hooks whose INPUT-parse-failure path is fail-CLOSED by\n169\t# design (CLAUDE.md §4 input half; PLAN-152 debate C4). Each entry maps the\n170\t# hook script to an input payload the guard cannot parse and MUST block.\n171\t# check_bash_safety.py: the _e3 whole-command shlex parse gate — an\n172\t# unterminated quote fails shlex.split and must emit a block decision.\n173\t_SECURITY_MATCHERS: Dict[str, Dict[str, Any]] = {\n174\t    \"check_bash_safety.py\": {\n175\t        \"hook_event_name\": \"PreToolUse\",\n176\t        \"session_id\": \"hook-stdout-schema-oracle\",\n177\t        \"tool_name\": \"Bash\",\n178\t        \"tool_input\": {\"command\": 'echo \"unterminated'},\n179\t    },\n180\t}\n181\t\n182\t_DEFAULT_SNAPSHOT_REL = Path(\".claude/data/hook-schema-2.1.220.json\")\n183\t\n184\t# Per-subprocess wall cap (seconds) on top of the registration's own\n185\t# settings.json timeout. Broken-env runs return in well under a second;\n186\t# the cap only exists so a hung hook turns into a reported violation\n187\t# instead of a hung CI job.\n188\t_TIMEOUT_FLOOR_S = 15\n189\t_TIMEOUT_CEIL_S = 150\n190\t\n191\t\n192\t# ---------------------------------------------------------------------------\n193\t# Small arg parser (deliberately NOT argparse — this oracle polices argparse\n194\t# in hooks; keeping the dependency out of its own process is cheap honesty).\n195\t# ---------------------------------------------------------------------------\n196\t\n197\tdef _parse_args(argv: List[str]) -> Dict[str, Any]:\n198\t    opts: Dict[str, Any] = {\n199\t        \"repo\": None,\n200\t        \"schema_snapshot\": None,\n201\t        \"require_snapshot\": False,\n202\t        \"only\": [],\n203\t        \"skip_behavioral\": False,\n204\t        \"json\": False,\n205\t        \"verbose\": False,\n206\t    }\n207\t    i = 0\n208\t    while i < len(argv):\n209\t        a = argv[i]\n210\t        if a == \"--repo\" and i + 1 < len(argv):\n211\t            opts[\"repo\"] = argv[i + 1]\n212\t            i += 2\n213\t        elif a == \"--schema-snapshot\" and i + 1 < len(argv):\n214\t            opts[\"schema_snapshot\"] = argv[i + 1]\n215\t            i += 2\n216\t        elif a == \"--require-snapshot\":\n217\t            opts[\"require_snapshot\"] = True\n218\t            i += 1\n219\t        elif a == \"--only\" and i + 1 < len(argv):\n220\t            opts[\"only\"].append(argv[i + 1])\n221\t            i += 2\n222\t        elif a == \"--skip-behavioral\":\n223\t            opts[\"skip_behavioral\"] = True\n224\t            i += 1\n225\t        elif a == \"--json\":\n226\t            opts[\"json\"] = True\n227\t            i += 1\n228\t        elif a in (\"--verbose\", \"-v\"):\n229\t            opts[\"verbose\"] = True\n230\t            i += 1\n231\t        elif a in (\"--help\", \"-h\"):\n232\t            print(__doc__)\n233\t            raise SystemExit(0)\n234\t        else:\n235\t            print(\"check-hook-stdout-schema: unknown argument %r\" % a, file=sys.stderr)\n236\t            raise SystemExit(2)\n237\t    return opts\n238\t\n239\t"}]},"parent_tool_use_id":null,"session_id":"4310e5bd-b4b6-4a4e-b8bd-71d847027e9a","uuid":"1c3a517c-cd73-47fc-a833-61a319b00137","timestamp":"2026-11-16T18:07:52.927Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm