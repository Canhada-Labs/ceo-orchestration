{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NA8SvQ3KZHz1U3hKJqXsrD","type":"tool_result","content":"1\t\"\"\"Defense.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('emit_learning_rail_disabled', 'emit_git_hook_bypass_blocked', 'emit_bash_input_rewritten', 'emit_subagent_lifecycle_observed', 'emit_env_var_hijack_blocked', 'emit_egress_destination_detected', 'emit_adversary_review_flagged', 'emit_persistent_instructions_blocked', 'emit_hint_provenance_recorded', 'emit_ceo_boot_persona_coverage_score', 'emit_ceo_boot_check_skipped')\n9\t\n10\tdef emit_learning_rail_disabled(\n11\t    *,\n12\t    rail: str,\n13\t    switch: str,\n14\t    hook: str = \"\",\n15\t    session_id: str = \"\",\n16\t    project: str = \"\",\n17\t) -> None:\n18\t    \"\"\"Emit learning_rail_disabled (PLAN-154 A12 / ADR-160 Decision 8).\n19\t\n20\t    Once-per-session \"disabled-this-session\" breadcrumb shared by the four\n21\t    learning-loop rails (observe / distill / boot_render / fact_gate) —\n22\t    emitted ONLY on an EXPLICIT operator disable (switch set to a non-enable\n23\t    value, or CEO_SOTA_DISABLE master kill over an opted-in rail), NEVER on\n24\t    merely-unset (which is structurally off with zero delta). Wired to the\n25\t    ADR-158 fail-open-rail liveness surface so \"off by recorded operator\n26\t    choice\" is distinguishable from a dead rail.\n27\t\n28\t    Both closed enums are re-validated here (defense-in-depth): an\n29\t    unrecognized ``rail`` is coerced to ``\"observe\"`` and an unrecognized\n30\t    ``switch`` to ``\"other\"``. ``hook`` (optional producer tag) is bounded\n31\t    to the identifier charset. Fail-open per audit_emit contract.\n32\t    \"\"\"\n33\t    safe_rail = rail if rail in _LEARNING_RAIL_ENUM else \"observe\"\n34\t    safe_switch = switch if switch in _LEARNING_SWITCH_ENUM else \"other\"\n35\t    raw_event: Dict[str, Any] = {\n36\t        \"action\": \"learning_rail_disabled\",\n37\t        \"session_id\": session_id,\n38\t        \"project\": project,\n39\t        \"rail\": safe_rail,\n40\t        \"switch\": safe_switch,\n41\t    }\n42\t    if hook:\n43\t        raw_event[\"hook\"] = _learning_token_field(hook)\n44\t    cleaned, dropped = _scrub_ceo_boot_event(\n45\t        raw_event, _LEARNING_RAIL_DISABLED_ALLOWLIST\n46\t    )\n47\t    _write_event(cleaned)\n48\t    if dropped:  # pragma: no cover — impossible from the typed wrapper\n49\t        _breadcrumb(\n50\t            f\"learning_rail_disabled dropped forbidden field(s): \"\n51\t            f\"{sorted(dropped)[:10]}\"\n52\t        )\n53\t\n54\t\n55\tdef emit_git_hook_bypass_blocked(\n56\t    *,\n57\t    flag_class: str,\n58\t    session_id: str = \"\",\n59\t    project: str = \"\",\n60\t) -> None:"}]},"parent_tool_use_id":null,"session_id":"4310e5bd-b4b6-4a4e-b8bd-71d847027e9a","uuid":"c59d0d57-61f3-42ea-80f4-0f35f1a2e11f","timestamp":"2026-11-16T18:11:36.704Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/defense.py","content":"\"\"\"Defense.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('emit_learning_rail_disabled', 'emit_git_hook_bypass_blocked', 'emit_bash_input_rewritten', 'emit_subagent_lifecycle_observed', 'emit_env_var_hijack_blocked', 'emit_egress_destination_detected', 'emit_adversary_review_flagged', 'emit_persistent_instructions_blocked', 'emit_hint_provenance_recorded', 'emit_ceo_boot_persona_coverage_score', 'emit_ceo_boot_check_skipped')\n\ndef emit_learning_rail_disabled(\n    *,\n    rail: str,\n    switch: str,\n    hook: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit learning_rail_disabled (PLAN-154 A12 / ADR-160 Decision 8).\n\n    Once-per-session \"disabled-this-session\" breadcrumb shared by the four\n    learning-loop rails (observe / distill / boot_render / fact_gate) —\n    emitted ONLY on an EXPLICIT operator disable (switch set to a non-enable\n    value, or CEO_SOTA_DISABLE master kill over an opted-in rail), NEVER on\n    merely-unset (which is structurally off with zero delta). Wired to the\n    ADR-158 fail-open-rail liveness surface so \"off by recorded operator\n    choice\" is distinguishable from a dead rail.\n\n    Both closed enums are re-validated here (defense-in-depth): an\n    unrecognized ``rail`` is coerced to ``\"observe\"`` and an unrecognized\n    ``switch`` to ``\"other\"``. ``hook`` (optional producer tag) is bounded\n    to the identifier charset. Fail-open per audit_emit contract.\n    \"\"\"\n    safe_rail = rail if rail in _LEARNING_RAIL_ENUM else \"observe\"\n    safe_switch = switch if switch in _LEARNING_SWITCH_ENUM else \"other\"\n    raw_event: Dict[str, Any] = {\n        \"action\": \"learning_rail_disabled\",\n        \"session_id\": session_id,\n        \"project\": project,\n        \"rail\": safe_rail,\n        \"switch\": safe_switch,\n    }\n    if hook:\n        raw_event[\"hook\"] = _learning_token_field(hook)\n    cleaned, dropped = _scrub_ceo_boot_event(\n        raw_event, _LEARNING_RAIL_DISABLED_ALLOWLIST\n    )\n    _write_event(cleaned)\n    if dropped:  # pragma: no cover — impossible from the typed wrapper\n        _breadcrumb(\n            f\"learning_rail_disabled dropped forbidden field(s): \"\n            f\"{sorted(dropped)[:10]}\"\n        )\n\n\ndef emit_git_hook_bypass_blocked(\n    *,\n    flag_class: str,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:","numLines":60,"startLine":1,"totalLines":536}},"tool_result_meta":[{"id":"toolu_01NA8SvQ3KZHz1U3hKJqXsrD","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
