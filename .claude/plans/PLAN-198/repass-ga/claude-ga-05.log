    \"schema_snapshot\": None,\n        \"require_snapshot\": False,\n        \"only\": [],\n        \"skip_behavioral\": False,\n        \"json\": False,\n        \"verbose\": False,\n    }\n    i = 0\n    while i < len(argv):\n        a = argv[i]\n        if a == \"--repo\" and i + 1 < len(argv):\n            opts[\"repo\"] = argv[i + 1]\n            i += 2\n        elif a == \"--schema-snapshot\" and i + 1 < len(argv):\n            opts[\"schema_snapshot\"] = argv[i + 1]\n            i += 2\n        elif a == \"--require-snapshot\":\n            opts[\"require_snapshot\"] = True\n            i += 1\n        elif a == \"--only\" and i + 1 < len(argv):\n            opts[\"only\"].append(argv[i + 1])\n            i += 2\n        elif a == \"--skip-behavioral\":\n            opts[\"skip_behavioral\"] = True\n            i += 1\n        elif a == \"--json\":\n            opts[\"json\"] = True\n            i += 1\n        elif a in (\"--verbose\", \"-v\"):\n            opts[\"verbose\"] = True\n            i += 1\n        elif a in (\"--help\", \"-h\"):\n            print(__doc__)\n            raise SystemExit(0)\n        else:\n            print(\"check-hook-stdout-schema: unknown argument %r\" % a, file=sys.stderr)\n            raise SystemExit(2)\n    return opts\n\n","numLines":90,"startLine":150,"totalLines":1041}},"tool_result_meta":[{"id":"toolu_01V49qDpS4k729WLDpC5RjDC","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
