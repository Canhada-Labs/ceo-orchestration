{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XK8KaKaMqkiVEJrRhWYe9i","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Parser-aware destructive Bash safety hook facade.\n3\t\n4\tThe executable declarations live in installable `_lib` fragments so that the\n5\tinstaller copies them with the `.claude/hooks` library. Each fragment is compiled into\n6\tthis module's namespace: private names, dataclasses, mutable state and calls\n7\tthrough monkeypatched globals therefore retain the historical behavior.\n8\t\n9\t# Source-surface compatibility marker: def _rewrite_git_push_force is loaded\n10\t# into this facade from ``_bash_safety_parts.rewrite_citation``.\n11\t# Historical staged-test loaders also select this entry point by these names:\n12\t# def _apply_destructive_citation_gate — implementation in rewrite_citation.py.\n13\t# def _apply_fact_gate — implementation in fact_canonical.py.\n14\t\"\"\"\n15\tfrom __future__ import annotations\n16\t\n17\tfrom pathlib import Path\n18\tfrom typing import Tuple\n19\t\n20\t_PARTS: Tuple[str, ...] = (\n21\t    \"normalization\", \"rewrite_citation\", \"fact_state\", \"fact_canonical\",\n22\t    \"posture_tables\", \"posture_parser\", \"posture_scan\", \"decisions_cli\",\n23\t)\n24\t\n25\t\n26\tdef _install_parts() -> None:\n27\t    \"\"\"Execute ordered, inspectable source fragments in this namespace.\n28\t\n29\t    The fragments contain ordinary Python declarations, not proxy exports.\n30\t    Compiling them once with this dictionary preserves historical lookup of\n31\t    helpers and constants through the facade, including test monkeypatches.\n32\t    Their own filenames stay in code objects for ``inspect.getsource``.\n33\t    \"\"\"\n34\t    namespace = globals()\n35\t    parts_dir = Path(__file__).resolve().parent / \"_lib\" / \"_bash_safety_parts\"\n36\t    for part_name in _PARTS:\n37\t        part_path = parts_dir / (part_name + \".py\")\n38\t        source = part_path.read_text