{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XC77GUirNVhZYNtpWtGSdv","type":"tool_result","content":"1\t\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\n2\tfrom __future__ import annotations\n3\timport re\n4\t\n5\t_CANONICAL_GUARDS = [\n6\t    \".claude/team.md\",\n7\t    \".claude/frontend-team.md\",\n8\t    \".claude/pitfalls-catalog.yaml\",\n9\t    # SKILL.md under any tier\n10\t    \".claude/skills/core/*/SKILL.md\",\n11\t    \".claude/skills/frontend/*/SKILL.md\",\n12\t    # PLAN-074 Wave 0 ADJ-A5: replace fixed 4-segment glob with\n13\t    # recursive ** to cover sub-namespaces (e.g. game-development/<engine>).\n14\t    \".claude/skills/domains/**/SKILL.md\",\n15\t    # Domain-level governance files\n16\t    \".claude/skills/domains/*/team-personas.md\",\n17\t    \".claude/skills/domains/*/pitfalls.yaml\",\n18\t    # Sprint 9 (PLAN-009 A22 / A14) — defense-in-depth for confidence gate\n19\t    \".claude/**/conftest.py\",\n20\t    \".claude/hooks/check_confidence_gate.py\",\n21\t    \".claude/scripts/lessons.py\",\n22\t    \".claude/scripts/prune-lessons.py\",\n23\t    \".claude/scripts/lesson-restore.py\",\n24\t    \".claude/scripts/lesson_ranker.py\",\n25\t    # ---- PLAN-019 P1-SEC-A expansion: full governance surface ----\n26\t    # Hook source files (all PreToolUse / PostToolUse Python hooks).\n27\t    # An agent that can edit these can disable governance. Sentinel-gated\n28\t    # so Owner-signed ADRs can still land architectural changes.\n29\t    \".claude/hooks/*.py\",\n30\t    \".claude/hooks/_python-hook.sh\",\n31\t    # Hook shared library (_lib/*) — governance utilities.\n32\t    \".claude/hooks/_lib/*.py\",\n33\t    \".claude/hooks/_lib/adapters/*.py\",\n34\t    \".claude/hooks/_lib/**/*.py\",\n35\t    # Policy-as-code (ADR-045) — policies + fixtures.\n36\t    \".claude/policies/*.yaml\",\n37\t    \".claude/policies/*.yml\",\n38\t    \".claude/policies/fixtures/*.jsonl\",\n39\t    # PLAN-080 Phase 0b — JSON Schema for squad-bundle frontmatter validation\n40\t    # (M2-CDX-4 closure). Guarded so squad-bundle authoring contract cannot\n41\t    # be silently weakened. KERNEL-HARD-DENY since check_canonical_edit.py\n42\t    # itself is in _KERNEL_PATHS — extending its guard list requires both\n43\t    # CEO_KERNEL_OVERRIDE=PLAN-080-PHASE-0B-SCHEMA-GUARD-EXTENSION AND\n44\t    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the sentinel.\n45\t    \".claude/policies/schemas/*.json\",\n46\t    # PLAN-081 Phase 2 — Pair-Rail dispatcher canonical surface. The\n47\t    # routing-matrix.yaml carries the per-archetype coder/reviewer\n48\t    # decisions consumed by inject-agent-context.sh --pair-mode and\n49\t    # check_pair_rail.py (Phase 3 asymmetric VETO matrix arms). Mutation\n50\t    # of this YAML or the loader/predicate-eval would mis-route Pair-Rail\n51\t    # dispatches (T-4 archetype-spoofing in CROSS-LLM-THREAT-MODEL.md).\n52\t    # Sentinel-gated edits only — KERNEL-HARD-DENY since this guard list\n53\t    # itself is in _KERNEL_PATHS — extending requires\n54\t    # CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-2-DISPATCHER-GUARD-EXTENSION\n55\t    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n56\t    \".claude/dispatcher/*.py\",\n57\t    \".claude/dispatcher/*.yaml\",\n58\t    \".claude/dispatcher/*.yml\",\n59\t    \".claude/dispatcher/**/*.py\",\n60\t    # Settings file — matcher/hook registration.\n61\t    \".claude/settings.json\",\n62\t    # PLAN-074 Wave 0 ADJ-A3 BLOCKER 2: sub-agent definitions ship the\n63\t    # ROUTING TABLE personas + model: floor declarations. Editable only\n64\t    # via Owner-signed sentinel; CR/Sec/etc. archetype files cannot be\n65\t    # silently mutated by a sub-agent.\n66\t    \".claude/agents/*.md\",\n67\t    # ADRs — architectural record, supersede/immutability discipline.\n68\t    \".claude/adr/ADR-*.md\",\n69\t    \".claude/adr/README.md\",\n70\t    # SPEC/v1 — published compliance contract.\n71\t    \"SPEC/v1/*.md\",\n72\t    \"SPEC/**/*.md\",\n73\t    # CI workflows — release / branch-protection / validation gates.\n74\t    \".github/workflows/*.yml\",\n75\t    \".github/workflows/*.yaml\",\n76\t    # CODEOWNERS — merge-side branch-protection gate.\n77\t    \".github/CODEOWNERS\",\n78\t    # Installer + upgrader scripts — framework distribution surface.\n79\t    \"scripts/install.sh\",\n80\t    \"scripts/install-npm.sh\","}]},"parent_tool_use_id":null,"session_id":"39b2a95c-7098-4a31-b7e8-36b062b92a5a","uuid":"a45fb678-f54f-4b45-8107-b18e58edf078","timestamp":"2026-11-16T18:27:30.125Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/canonical_edit/guards.py","content":"\"\"\"Mechanically extracted canonical-edit declarations.\"\"\"\nfrom __future__ import annotations\nimport re\n\n_CANONICAL_GUARDS = [\n    \".claude/team.md\",\n    \".claude/frontend-team.md\",\n    \".claude/pitfalls-catalog.yaml\",\n    # SKILL.md under any tier\n    \".claude/skills/core/*/SKILL.md\",\n    \".claude/skills/frontend/*/SKILL.md\",\n    # PLAN-074 Wave 0 ADJ-A5: replace fixed 4-segment glob with\n    # recursive ** to cover sub-namespaces (e.g. game-development/<engine>).\n    \".claude/skills/domains/**/SKILL.md\",\n    # Domain-level governance files\n    \".claude/skills/domains/*/team-personas.md\",\n    \".claude/skills/domains/*/pitfalls.yaml\",\n    # Sprint 9 (PLAN-009 A22 / A14) — defense-in-depth for confidence gate\n    \".claude/**/conftest.py\",\n    \".claude/hooks/check_confidence_gate.py\",\n    \".claude/scripts/lessons.py\",\n    \".claude/scripts/prune-lessons.py\",\n    \".claude/scripts/lesson-restore.py\",\n    \".claude/scripts/lesson_ranker.py\",\n    # ---- PLAN-019 P1-SEC-A expansion: full governance surface ----\n    # Hook source files (all PreToolUse / PostToolUse Python hooks).\n    # An agent that can edit these can disable governance. Sentinel-gated\n    # so Owner-signed ADRs can still land architectural changes.\n    \".claude/hooks/*.py\",\n    \".claude/hooks/_python-hook.sh\",\n    # Hook shared library (_lib/*) — governance utilities.\n    \".claude/hooks/_lib/*.py\",\n    \".claude/hooks/_lib/adapters/*.py\",\n    \".claude/hooks/_lib/**/*.py\",\n    # Policy-as-code (ADR-045) — policies + fixtures.\n    \".claude/policies/*.yaml\",\n    \".claude/policies/*.yml\",\n    \".claude/policies/fixtures/*.jsonl\",\n    # PLAN-080 Phase 0b — JSON Schema for squad-bundle frontmatter validation\n    # (M2-CDX-4 closure). Guarded so squad-bundle authoring contract cannot\n    # be silently weakened. KERNEL-HARD-DENY since check_canonical_edit.py\n    # itself is in _KERNEL_PATHS — extending its guard list requires both\n    # CEO_KERNEL_OVERRIDE=PLAN-080-PHASE-0B-SCHEMA-GUARD-EXTENSION AND\n    # CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT in addition to the sentinel.\n    \".claude/policies/schemas/*.json\",\n    # PLAN-081 Phase 2 — Pair-Rail dispatcher canonical surface. The\n    # routing-matrix.yaml carries the per-archetype coder/reviewer\n    # decisions consumed by inject-agent-context.sh --pair-mode and\n    # check_pair_rail.py (Phase 3 asymmetric VETO matrix arms). Mutation\n    # of this YAML or the loader/predicate-eval would mis-route Pair-Rail\n    # dispatches (T-4 archetype-spoofing in CROSS-LLM-THREAT-MODEL.md).\n    # Sentinel-gated edits only — KERNEL-HARD-DENY since this guard list\n    # itself is in _KERNEL_PATHS — extending requires\n    # CEO_KERNEL_OVERRIDE=PLAN-081-PHASE-2-DISPATCHER-GUARD-EXTENSION\n    # AND CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT.\n    \".claude/dispatcher/*.py\",\n    \".claude/dispatcher/*.yaml\",\n    \".claude/dispatcher/*.yml\",\n    \".claude/dispatcher/**/*.py\",\n    # Settings file — matcher/hook registration.\n    \".claude/settings.json\",\n    # PLAN-074 Wave 0 ADJ-A3 BLOCKER 2: sub-agent definitions ship the\n    # ROUTING TABLE personas + model: floor declarations. Editable only\n    # via Owner-signed sentinel; CR/Sec/etc. archetype files cannot be\n    # silently mutated by a sub-agent.\n    \".claude/agents/*.md\",\n    # ADRs — architectural record, supersede/immutability discipline.\n    \".claude/adr/ADR-*.md\",\n    \".claude/adr/README.md\",\n    # SPEC/v1 — published compliance contract.\n    \"SPEC/v1/*.md\",\n    \"SPEC/**/*.md\",\n    # CI workflows — release / branch-protection / validation gates.\n    \".github/workflows/*.yml\",\n    \".github/workflows/*.yaml\",\n    # CODEOWNERS — merge-side branch-protection gate.\n    \".github/CODEOWNERS\",\n    # Installer + upgrader scripts — framework distribution surface.\n    \"scripts/install.sh\",\n    \"scripts/install-npm.sh\",","numLines":80,"startLine":1,"totalLines":387}},"tool_result_meta":[{"id":"toolu_01XC77GUirNVhZYNtpWtGSdv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
