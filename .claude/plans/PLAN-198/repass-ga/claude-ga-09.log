{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DVMxT9RoDREi9wgVAr88GF","type":"tool_result","content":"1\t\"\"\"compaction context-budget declarations.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport argparse\n6\timport json\n7\timport os\n8\timport re\n9\timport sys\n10\tfrom pathlib import Path\n11\tfrom typing import Any, Dict, List, Optional, Tuple\n12\t\n13\t__all__ = ('ENV_AUTO_COMPACT_THRESHOLD', 'ENV_AUTO_COMPACT_LOW_WATER', 'ENV_AUTO_COMPACT_COOLDOWN_TURNS', 'ENV_AUTO_COMPACT_MIN_RECLAIM_PCT', 'DEFAULT_AUTO_COMPACT_THRESHOLD_PCT', 'DEFAULT_AUTO_COMPACT_LOW_WATER_PCT', 'DEFAULT_AUTO_COMPACT_COOLDOWN_TURNS', 'DEFAULT_AUTO_COMPACT_MIN_RECLAIM_PCT', 'REASON_DISABLED', 'REASON_BELOW_HIGH_WATER', 'REASON_NOT_REARMED', 'REASON_COOLDOWN', 'REASON_RECLAIM_FLOOR', 'REASON_COMPACT', '_env_int', 'CompactionPolicy', '_clamp_pct', 'load_policy_from_env', '_safe_ratio_pct', 'decide_compaction')\n14\t\n15\t# ---------------------------------------------------------------------------\n16\t# PLAN-133 D1 — proactive auto-compaction policy (hysteresis state machine)\n17\t# ---------------------------------------------------------------------------\n18\t#\n19\t# Default-OFF behavioral change. The *decision* (this module) is non-canonical\n20\t# and lives here in `scripts/`; the actual `context_auto_compacted` /\n21\t# `context_auto_compact_suppressed` closed-enum audit emit is CANONICAL and has\n22\t# since LANDED in `.claude/hooks/_lib/audit_emit.py` (+ `SPEC/v1/\n23\t# audit-log.schema.md` + `.claude/data/audit-registry.golden.txt`) — this file\n24\t# never edits it. (The former pointer to `.claude/plans/PLAN-133/staged/\n25\t# D1.proposal.md` is stale: that path no longer exists.)\n26\t#\n27\t# PLAN-179 W3 US11 status: KEEP, as an exported policy — NOT as coverage. The\n28\t# emit exists; the EMITTER does not. Zero callers repo-wide and zero observed\n29\t# events. See `probe_status()` at the end of the D5 block, and\n30\t# `.claude/plans/PLAN-179/orphan-probe-decision.md`.\n31\t#\n32\t# Doctrine compliance:\n33\t#   * Default-OFF: the feature is INACTIVE unless `CEO_AUTO_COMPACT_THRESHOLD`\n34\t#     is set to a sane int in (0, 100]. With the env unset, `decide_compaction`\n35\t#     always returns a \"disabled\" decision (compact=False, suppressed=False).\n36\t#     The default constant below (80) is the value used WHEN enabled; it is NOT\n37\t#     a default-on flip.\n38\t#   * Measure-first: every decision carries the numeric reason + ratios so the\n39\t#     compaction-rate can be tabulated from logs before any default-on flip.\n40\t#   * Hysteresis (perf must-fix): trigger at a HIGH-water mark, re-arm only\n41\t#     after dropping below a LOW-water mark, plus a minimum-turns cooldown and\n42\t#     a minimum-bytes-reclaimed floor. When the floor (or a still-disarmed\n43\t#     re-arm gate, or cooldown) blocks a would-be compaction, the decision is\n44\t#     `suppressed=True` so the caller emits `context_auto_compact_suppressed`.\n45\t#   * Fail-open-on-infra: any malformed input / read error yields a \"disabled\"\n46\t#     decision (never raises), so a buggy snapshot never blocks a session.\n47\t#\n48\t# This is a pure, side-effect-free decision function: it does NOT compact, does\n49\t# NOT emit, and does NOT write anything. The host wires the side effects.\n50\t\n51\t# Env flags (default-OFF). `CEO_AUTO_COMPACT_THRESHOLD` is the high-water % of\n52\t# the model context window at which compaction is proposed. Unset/invalid ⇒ OFF.\n53\tENV_AUTO_COMPACT_THRESHOLD = \"CEO_AUTO_COMPACT_THRESHOLD\"\n54\tENV_AUTO_COMPACT_LOW_WATER = \"CEO_AUTO_COMPACT_LOW_WATER\"\n55\tENV_AUTO_COMPACT_COOLDOWN_TURNS = \"CEO_AUTO_COMPACT_COOLDOWN_TURNS\"\n56\tENV_AUTO_COMPACT_MIN_RECLAIM_PCT = \"CEO_AUTO_COMPACT_MIN_RECLAIM_PCT\"\n57\t\n58\t# Defaults used ONLY when the feature is enabled (threshold env present + valid).\n59\tDEFAULT_AUTO_COMPACT_THRESHOLD_PCT = 80   # high-water trigger (% of window)\n60\tDEFAULT_AUTO_COMPACT_LOW_WATER_PCT = 60   # re-arm only after dropping below this\n61\tDEFAULT_AUTO_COMPACT_COOLDOWN_TURNS = 5   # min turns between compactions\n62\tDEFAULT_AUTO_COMPACT_MIN_RECLAIM_PCT = 10  # skip if < this % of bytes would be freed\n63\t\n64\t# Decision reason codes (stable strings for log tabulation; closed set).\n65\tREASON_DISABLED = \"disabled\"                  # feature OFF (env unset/invalid)\n66\tREASON_BELOW_HIGH_WATER = \"below_high_water\"   # usage under trigger\n67\tREASON_NOT_REARMED = \"not_rearmed\"             # above low-water since last compaction\n68\tREASON_COOLDOWN = \"cooldown\"                   # min-turns cooldown not elapsed\n69\tREASON_RECLAIM_FLOOR = \"reclaim_floor\"         # < min-bytes-reclaimed freed → skip\n70\tREASON_COMPACT = \"compact\"                     # all gates pass → compact now\n71\t\n72\t\n73\tdef _env_int(name: str, env: Optional[Dict[str, str]]) -> Optional[int]:\n74\t    \"\"\"Read an int from `env` (or os.environ) — None on absent/malformed.\n75\t\n76\t    Fail-open: never raises. A non-integer, empty, or whitespace value reads as\n77\t    None (treated by callers as \"not configured\").\n78\t    \"\"\"\n79\t    src = env if env is not None else os.environ\n80\t    raw = src.get(name)\n81\t    if raw is None:\n82\t        return None\n83\t    try:\n84\t        return int(str(raw).strip())\n85\t    except (TypeError, ValueError):\n86\t        return None\n87\t\n88\t\n89\tclass CompactionPolicy:\n90\t    \"\"\"Hysteresis config + re-arm state for the auto-compaction decision.\n91\t\n92\t    Stateless across processes by design — the host owns persistence. The host\n93\t    passes the prior `armed` flag and `turns_since_last_compaction` from its own\n94\t    session state; this object only derives the next decision + next state.\n95\t\n96\t    `armed` means \"eligible to trigger again\": it is set False right after a\n97\t    compaction and re-set True once usage has dropped below the low-water mark.\n98\t    \"\"\"\n99\t\n100\t    def __init__(\n101\t        self,\n102\t        high_water_pct: int,\n103\t        low_water_pct: int,\n104\t        cooldown_turns: int,\n105\t        min_reclaim_pct: int,\n106\t    ) -> None:\n107\t        # Clamp to a sane, monotone config (fail-open: never raise on bad nums).\n108\t        self.high_water_pct = _clamp_pct(high_water_pct, DEFAULT_AUTO_COMPACT_THRESHOLD_PCT)\n109\t        low = _clamp_pct(low_water_pct, DEFAULT_AUTO_COMPACT_LOW_WATER_PCT)\n110\t        # Low-water MUST sit strictly below high-water for hysteresis to exist;\n111\t        # if a caller inverts them, pin low to high-1 (degenerate but safe).\n112\t        if low >= self.high_water_pct:\n113\t            low = max(0, self.high_water_pct - 1)\n114\t        self.low_water_pct = low\n115\t        self.cooldown_turns = cooldown_turns if cooldown_turns is not None and cooldown_turns >= 0 else DEFAULT_AUTO_COMPACT_COOLDOWN_TURNS\n116\t        self.min_reclaim_pct = _clamp_pct(min_reclaim_pct, DEFAULT_AUTO_COMPACT_MIN_RECLAIM_PCT)\n117\t\n118\t\n119\tdef _clamp_pct(value: Any, fallback: int) -> int:\n120\t    \"\"\"Coerce `value` to an int in [0, 100]; `fallback` on any malformed input.\"\"\"\n121\t    try:\n122\t        n = int(value)\n123\t    except (TypeError, ValueError):\n124\t        return fallback\n125\t    if n < 0:\n126\t        return 0\n127\t    if n > 100:\n128\t        return 100\n129\t    return n\n130\t\n131\t\n132\tdef load_policy_from_env(env: Optional[Dict[str, str]] = None) -> Optional[CompactionPolicy]:\n133\t    \"\"\"Build a CompactionPolicy from env, or None when the feature is OFF.\n134\t\n135\t    The feature is OFF (returns None) unless `CEO_AUTO_COMPACT_THRESHOLD` is set"}]},"parent_tool_use_id":null,"session_id":"39b2a95c-7098-4a31-b7e8-36b062b92a5a","uuid":"7f1213b6-b0d3-4645-a7fe-15208c79b38d","timestamp":"2026-11-16T18:26:55.367Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_context_budget_parts/compaction.py","content":"\"\"\"compaction context-budget declarations.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, List, Optional, Tuple\n\n__all__ = ('ENV_AUTO_COMPACT_THRESHOLD', 'ENV_AUTO_COMPACT_LOW_WATER', 'ENV_AUTO_COMPACT_COOLDOWN_TURNS', 'ENV_AUTO_COMPACT_MIN_RECLAIM_PCT', 'DEFAULT_AUTO_COMPACT_THRESHOLD_PCT', 'DEFAULT_AUTO_COMPACT_LOW_WATER_PCT', 'DEFAULT_AUTO_COMPACT_COOLDOWN_TURNS', 'DEFAULT_AUTO_COMPACT_MIN_RECLAIM_PCT', 'REASON_DISABLED', 'REASON_BELOW_HIGH_WATER', 'REASON_NOT_REARMED', 'REASON_COOLDOWN', 'REASON_RECLAIM_FLOOR', 'REASON_COMPACT', '_env_int', 'CompactionPolicy', '_clamp_pct', 'load_policy_from_env', '_safe_ratio_pct', 'decide_compaction')\n\n# ---------------------------------------------------------------------------\n# PLAN-133 D1 — proactive auto-compaction policy (hysteresis state machine)\n# ---------------------------------------------------------------------------\n#\n# Default-OFF behavioral change. The *decision* (this module) is non-canonical\n# and lives here in `scripts/`; the actual `context_auto_compacted` /\n# `context_auto_compact_suppressed` closed-enum audit emit is CANONICAL and has\n# since LANDED in `.claude/hooks/_lib/audit_emit.py` (+ `SPEC/v1/\n# audit-log.schema.md` + `.claude/data/audit-registry.golden.txt`) — this file\n# never edits it. (The former pointer to `.claude/plans/PLAN-133/staged/\n# D1.proposal.md` is stale: that path no longer exists.)\n#\n# PLAN-179 W3 US11 status: KEEP, as an exported policy — NOT as coverage. The\n# emit exists; the EMITTER does not. Zero callers repo-wide and zero observed\n# events. See `probe_status()` at the end of the D5 block, and\n# `.claude/plans/PLAN-179/orphan-probe-decision.md`.\n#\n# Doctrine compliance:\n#   * Default-OFF: the feature is INACTIVE unless `CEO_AUTO_COMPACT_THRESHOLD`\n#     is set to a sane int in (0, 100]. With the env unset, `decide_compaction`\n#     always returns a \"disabled\" decision (compact=False, suppressed=False).\n#     The default constant below (80) is the value used WHEN enabled; it is NOT\n#     a default-on flip.\n#   * Measure-first: every decision carries the numeric reason + ratios so the\n#     compaction-rate can be tabulated from logs before any default-on flip.\n#   * Hysteresis (perf must-fix): trigger at a HIGH-water mark, re-arm only\n#     after dropping below a LOW-water mark, plus a minimum-turns cooldown and\n#     a minimum-bytes-reclaimed floor. When the floor (or a still-disarmed\n#     re-arm gate, or cooldown) blocks a would-be compaction, the decision is\n#     `suppressed=True` so the caller emits `context_auto_compact_suppressed`.\n#   * Fail-open-on-infra: any malformed input / read error yields a \"disabled\"\n#     decision (never raises), so a buggy snapshot never blocks a session.\n#\n# This is a pure, side-effect-free decision function: it does NOT compact, does\n# NOT emit, and does NOT write anything. The host wires the side effects.\n\n# Env flags (default-OFF). `CEO_AUTO_COMPACT_THRESHOLD` is the high-water % of\n# the model context window at which compaction is proposed. Unset/invalid ⇒ OFF.\nENV_AUTO_COMPACT_THRESHOLD = \"CEO_AUTO_COMPACT_THRESHOLD\"\nENV_AUTO_COMPACT_LOW_WATER = \"CEO_AUTO_COMPACT_LOW_WATER\"\nENV_AUTO_COMPACT_COOLDOWN_TURNS = \"CEO_AUTO_COMPACT_COOLDOWN_TURNS\"\nENV_AUTO_COMPACT_MIN_RECLAIM_PCT = \"CEO_AUTO_COMPACT_MIN_RECLAIM_PCT\"\n\n# Defaults used ONLY when the feature is enabled (threshold env present + valid).\nDEFAULT_AUTO_COMPACT_THRESHOLD_PCT = 80   # high-water trigger (% of window)\nDEFAULT_AUTO_COMPACT_LOW_WATER_PCT = 60   # re-arm only after dropping below this\nDEFAULT_AUTO_COMPACT_COOLDOWN_TURNS = 5   # min turns between compactions\nDEFAULT_AUTO_COMPACT_MIN_RECLAIM_PCT = 10  # skip if < this % of bytes would be freed\n\n# Decision reason codes (stable strings for log tabulation; closed set).\nREASON_DISABLED = \"disabled\"                  # feature OFF (env unset/invalid)\nREASON_BELOW_HIGH_WATER = \"below_high_water\"   # usage under trigger\nREASON_NOT_REARMED = \"not_rearmed\"             # above low-water since last compaction\nREASON_COOLDOWN = \"cooldown\"                   # min-turns cooldown not elapsed\nREASON_RECLAIM_FLOOR = \"reclaim_floor\"         # < min-bytes-reclaimed freed → skip\nREASON_COMPACT = \"compact\"                     # all gates pass → compact now\n\n\ndef _env_int(name: str, env: Optional[Dict[str, str]]) -> Optional[int]:\n    \"\"\"Read an int from `env` (or os.environ) — None on absent/malformed.\n\n    Fail-open: never raises. A non-integer, empty, or whitespace value reads as\n    None (treated by callers as \"not configured\").\n    \"\"\"\n    src = env if env is not None else os.environ\n    raw = src.get(name)\n    if raw is None:\n        return None\n    try:\n        return int(str(raw).strip())\n    except (TypeError, ValueError):\n        return None\n\n\nclass CompactionPolicy:\n    \"\"\"Hysteresis config + re-arm state for the auto-compaction decision.\n\n    Stateless across processes by design — the host owns persistence. The host\n    passes the prior `armed` flag and `turns_since_last_compaction` from its own\n    session state; this object only derives the next decision + next state.\n\n    `armed` means \"eligible to trigger again\": it is set False right after a\n    compaction and re-set True once usage has dropped below the low-water mark.\n    \"\"\"\n\n    def __init__(\n        self,\n        high_water_pct: int,\n        low_water_pct: int,\n        cooldown_turns: int,\n        min_reclaim_pct: int,\n    ) -> None:\n        # Clamp to a sane, monotone config (fail-open: never raise on bad nums).\n        self.high_water_pct = _clamp_pct(high_water_pct, DEFAULT_AUTO_COMPACT_THRESHOLD_PCT)\n        low = _clamp_pct(low_water_pct, DEFAULT_AUTO_COMPACT_LOW_WATER_PCT)\n        # Low-water MUST sit strictly below high-water for hysteresis to exist;\n        # if a caller inverts them, pin low to high-1 (degenerate but safe).\n        if low >= self.high_water_pct:\n            low = max(0, self.high_water_pct - 1)\n        self.low_water_pct = low\n        self.cooldown_turns = cooldown_turns if cooldown_turns is not None and cooldown_turns >= 0 else DEFAULT_AUTO_COMPACT_COOLDOWN_TURNS\n        self.min_reclaim_pct = _clamp_pct(min_reclaim_pct, DEFAULT_AUTO_COMPACT_MIN_RECLAIM_PCT)\n\n\ndef _clamp_pct(value: Any, fallback: int) -> int:\n    \"\"\"Coerce `value` to an int in [0, 100]; `fallback` on any malformed input.\"\"\"\n    try:\n        n = int(value)\n    except (TypeError, ValueError):\n        return fallback\n    if n < 0:\n        return 0\n    if n > 100:\n        return 100\n    return n\n\n\ndef load_policy_from_env(env: Optional[Dict[str, str]] = None) -> Optional[CompactionPolicy]:\n    \"\"\"Build a CompactionPolicy from env, or None when the feature is OFF.\n\n    The feature is OFF (returns None) unless `CEO_AUTO_COMPACT_THRESHOLD` is set","numLines":135,"startLine":1,"totalLines":307}},"tool_result_meta":[{"id":"toolu_01DVMxT9RoDREi9wgVAr88GF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
