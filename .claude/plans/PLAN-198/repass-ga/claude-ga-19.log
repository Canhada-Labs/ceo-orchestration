xt: str) -> List[Match]:\n    out: List[Match] = []\n    for regex in _API_KEY_RE:","numLines":40,"startLine":480,"totalLines":898}},"tool_result_meta":[{"id":"toolu_01P9fr9seRcQ7XTd6KkwZZc4","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
