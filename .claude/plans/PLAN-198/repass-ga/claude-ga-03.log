{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qx44bMwpKUJVFEf8K2s1q4","type":"tool_result","content":"1\t\"\"\"Domain implementations for the public ``_lib.audit_emit`` facade.\n2\t\n3\tThe facade historically owns mutable state and every helper lookup. Ordinary\n4\tfunction re-exports would silently bypass monkeypatches on that facade. Bind\n5\tthe original code objects to its namespace instead: signatures, source files,\n6\ttracebacks and inspect.isfunction remain intact, with no proxy per event.\n7\t\n8\tImported parts are private declaration templates. Each facade import/reload\n9\tgets fresh mutable values and fresh functions; never mutate the templates.\n10\t\"\"\"\n11\t\n12\tfrom __future__ import annotations\n13\t\n14\tfrom copy import deepcopy\n15\tfrom importlib import import_module\n16\tfrom types import FunctionType\n17\tfrom typing import Any, Dict, Tuple\n18\t\n19\t\n20\tdef install(namespace: Dict[str, Any], modules: Tuple[str, ...],\n21\t            package: str = __name__) -> None:\n22\t    \"\"\"Publish declarations with the facade as their sole runtime namespace.\n23\t\n24\t    ``package`` permits other facades to share the same binding contract.\n25\t    \"\"\"\n26\t    declarations = {}\n27\t    for name in modules:\n28\t        module = import_module(f\"{package}.{name}\")\n29\t        declarations.update({key: getattr(module, key) for key in module.__all__})\n30\t        namespace.setdefault(\"__annotations__\", {}).update(\n31\t            getattr(module, \"__annotations__\", {})\n32\t        )\n33\t    # One memo preserves aliases between mutable declarations, and a reload\n34\t    # cannot inherit rate-limit counters or registry edits from a prior import.\n35\t    namespace.update(deepcopy(declarations))\n36\t    for name, original in declarations.items():\n37\t        if not isinstance(original, FunctionType):\n38\t            continue\n39\t        bound = FunctionType(\n40\t            original.__code__, namespace, original.__name__,\n41\t            original.__defaults__, original.__closure__,\n42\t        )\n43\t        bound.__kwdefaults__ = deepcopy(original.__kwdefaults__)\n44\t        bound.__annotations__ = dict(original.__annotations__)\n45\t        bound.__dict__.update(original.__dict__)\n46\t        bound.__qualname__ = original.__qualname__\n47\t        bound.__module__ = namespace[\"__name__\"]\n48\t        namespace[name] = bound\n49\t"}]},"parent_tool_use_id":null,"session_id":"f3d94731-802e-46e1-9fa0-3006a5880d2e","uuid":"3d56f5d6-e372-42c6-b2c1-7e737090f120","timestamp":"2026-11-16T17:56:06.205Z","tool_use_result":{"type":"text","file":{"filePath":".claude/hooks/_lib/_audit_emit_parts/__init__.py","content":"\"\"\"Domain implementations for the public ``_lib.audit_emit`` facade.\n\nThe facade historically owns mutable state and every helper lookup. Ordinary\nfunction re-exports would silently bypass monkeypatches on that facade. Bind\nthe original code objects to its namespace instead: signatures, source files,\ntracebacks and inspect.isfunction remain intact, with no proxy per event.\n\nImported parts are private declaration templates. Each facade import/reload\ngets fresh mutable values and fresh functions; never mutate the templates.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom copy import deepcopy\nfrom importlib import import_module\nfrom types import FunctionType\nfrom typing import Any, Dict, Tuple\n\n\ndef install(namespace: Dict[str, Any], modules: Tuple[str, ...],\n            package: str = __name__) -> None:\n    \"\"\"Publish declarations with the facade as their sole runtime namespace.\n\n    ``package`` permits other facades to share the same binding contract.\n    \"\"\"\n    declarations = {}\n    for name in modules:\n        module = import_module(f\"{package}.{name}\")\n        declarations.update({key: getattr(module, key) for key in module.__all__})\n        namespace.setdefault(\"__annotations__\", {}).update(\n            getattr(module, \"__annotations__\", {})\n        )\n    # One memo preserves aliases between mutable declarations, and a reload\n    # cannot inherit rate-limit counters or registry edits from a prior import.\n    namespace.update(deepcopy(declarations))\n    for name, original in declarations.items():\n        if not isinstance(original, FunctionType):\n            continue\n        bound = FunctionType(\n            original.__code__, namespace, original.__name__,\n            original.__defaults__, original.__closure__,\n        )\n        bound.__kwdefaults__ = deepcopy(original.__kwdefaults__)\n        bound.__annotations__ = dict(original.__annotations__)\n        bound.__dict__.update(original.__dict__)\n        bound.__qualname__ = original.__qualname__\n        bound.__module__ = namespace[\"__name__\"]\n        namespace[name] = bound\n","numLines":49,"startLine":1,"totalLines":49}},"tool_result_meta":[{"id":"toolu_01Qx44bMwpKUJVFEf8K2s1q4","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
