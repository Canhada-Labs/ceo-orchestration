y_hmac\n.claude/hooks/_lib/audit_hmac.py-781-            # may be invoked from a probe before the producer is loaded;\n.claude/hooks/_lib/audit_hmac.py-782-            # the producer-side chokepoints catch the emit-time case.\n.claude/hooks/_lib/audit_hmac.py-783-            continue\n.claude/hooks/_lib/audit_hmac.py-784-        mod_file = getattr(mod, \"__file__\", None)\n.claude/hooks/_lib/audit_hmac.py-785-        if mod_file is None:\n.claude/hooks/_lib/audit_hmac.py-786-            continue  # builtins / frozen / namespace package\n.claude/hooks/_lib/audit_hmac.py-787-        try:\n.claude/hooks/_lib/audit_hmac.py-788-            resolved_parent = Path(mod_file).resolve().parent\n.claude/hooks/_lib/audit_hmac.py-789-        except (OSError, ValueError):\n.claude/hooks/_lib/audit_hmac.py-790-            continue  # symlink loop / weird path — fail-open at this layer\n.claude/hooks/_lib/audit_hmac.py-791-        if resolved_parent != _CANONICAL_LIB_DIR:\n.claude/hooks/_lib/audit_hmac.py-792-            # PLAN-118 AC-B4 + AC-B5: refuse to compute HMAC; payload\n.claude/hooks/_lib/audit_hmac.py-793-            # carries sha256[:8] prefixes only (no path echo).\n.claude/hooks/_lib/audit_hmac.py-794-            reason_code = {\n.claude/hooks/_lib/audit_hmac.py-795-                \"_lib.audit_emit\": \"audit_emit_path_pollution\",\n.claude/hooks/_lib/audit_hmac.py-796-                \"_lib.canonical_json\": \"canonical_json_path_pollution\",\n.claude/hooks/_lib/audit_hmac.py-797-                \"_lib.audit_hmac\": \"audit_hmac_path_pollution\",\n.claude/hooks/_lib/audit_hmac.py-798-            }[mod_name]\n.claude/hooks/_lib/audit_hmac.py-799-            raise AuditProducerPathPollutionError(\n.claude/hooks/_lib/audit_hmac.py-800-                \"non_canonical_lib_resolution: \"\n.claude/hooks/_lib/audit_hmac.py-801-                f\"reason_code={reason_code} \"\n.claude/hooks/_lib/audit_hmac.py-802-                f\"path_sha256_prefix={path_sha256_prefix(resolv