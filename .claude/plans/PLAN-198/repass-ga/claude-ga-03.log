{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NLe1EhUsfDNZwsH5LNt5Uq","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"check-audit-read-api-stable — audit-log + session-graph read-API freeze guard.\n3\t\n4\tPLAN-014 Phase F.0 + ADJ-011 (VP Engineering §Phase-F pre-work). Pattern\n5\tprecedent: ``check-audit-registry-coverage.py`` (PLAN-013 Gap #3 fix).\n6\t\n7\tDuring Phase F, three new capabilities (replay + predict + cross-plan-memory)\n8\tall consume the **audit-log read API** and the **session-graph derived\n9\tregistry** to reconstruct plan context. If a refactor REMOVES or RENAMES\n10\ta public read function under our feet, every Phase F downstream breaks\n11\tsilently.\n12\t\n13\tThis script FREEZES the public read-API surface at a pinned baseline. Any\n14\tcommit that removes or renames a baseline function trips exit 1. Adding\n15\tnew functions (additive) is fine.\n16\t\n17\t## What it guards\n18\t\n19\t- ``.claude/hooks/_lib/audit_emit.py::iter_events`` — public event iterator\n20\t- ``.claude/scripts/audit-query.py`` sub-command dispatch table\n21\t\n22\t## Baseline (v1.0.0-rc.1)\n23\t\n24\tPublic read-API functions / subcommands that MUST EXIST across v1:\n25\t\n26\t  iter_events\n27\t  read_entries                (audit-query.py)\n28\t  discover_logs               (audit-query.py)\n29\t  default_log_path            (audit-query.py)\n30\t  cmd_summary                 (audit-query.py)\n31\t  cmd_by_skill                (audit-query.py)\n32\t  cmd_compliance              (audit-query.py)\n33\t  cmd_by_day                  (audit-query.py)\n34\t  cmd_search                  (audit-query.py)\n35\t  cmd_since                   (audit-query.py)\n36\t  cmd_stats                   (audit-query.py)\n37\t  cmd_export                  (audit-query.py)\n38\t  cmd_debate                  (audit-query.py)\n39\t  cmd_plans                   (audit-query.py)\n40\t  cmd_vetoes                  (audit-query.py)\n41\t  cmd_benchmarks              (audit-query.py)\n42\t  cmd_lessons                 (audit-query.py)\n43\t  cmd_metrics                 (audit-query.py)\n44\t  cmd_health                  (audit-query.py)\n45\t  cmd_tokens                  (audit-query.py)\n46\t\n47\tBaseline lives in this script (BASELINE_FUNCS). To tighten (add a new\n48\tmust-exist function) is MINOR-bump additive. To REMOVE from the baseline\n49\tis MAJOR-bump (forbidden in v1 without new SPEC file).\n50\t\n51\t## Exit codes\n52\t\n53\t  0 — baseline intact (all functions present); any ADDITIONS are reported\n54\t      advisory\n55\t  1 — drift detected (baseline function missing or renamed)\n56\t  2 — internal error (missing source file, malformed AST)\n57\t\n58\tStdlib only. Python 3.9+.\n59\t\"\"\"\n60\t\n61\tfrom __future__ import annotations\n62\t\n63\timport argparse\n64\timport ast\n65\timport sys\n66\tfrom pathlib import Path\n67\tfrom typing import Dict, List, Optional, Set, Tuple\n68\t\n69\t\n70\t# -----------------------------------------------------------------------------\n71\t# Baseline — pinned v1.0.0-rc.1\n72\t# -----------------------------------------------------------------------------\n73\t\n74\tAUDIT_EMIT_REL = Path(\".claude/hooks/_lib/audit_emit.py\")\n75\tAUDIT_QUERY_REL = Path(\".claude/scripts/audit-query.py\")\n76\t\n77\tBASELINE: Dict[str, Set[str]] = {\n78\t    # module-rel-path: {required public function names}\n79\t    str(AUDIT_EMIT_REL): {\n80\t        \"iter_events\",\n81\t    },\n82\t    str(AUDIT_QUERY_REL): {\n83\t        \"read_entries\",\n84\t        \"discover_logs\",\n85\t        \"default_log_path\",\n86\t        \"cmd_summary\",\n87\t        \"cmd_by_skill\",\n88\t        \"cmd_compliance\",\n89\t        \"cmd_by_day\",\n90\t        \"cmd_search\",\n91\t        \"cmd_since\",\n92\t        \"cmd_stats\",\n93\t        \"cmd_export\",\n94\t        \"cmd_debate\",\n95\t        \"cmd_plans\",\n96\t        \"cmd_vetoes\",\n97\t        \"cmd_benchmarks\",\n98\t        \"cmd_lessons\",\n99\t        \"cmd_metrics\",\n100\t        \"cmd_health\",\n101\t        \"cmd_tokens\",\n102\t    },\n103\t}\n104\t\n105\t\n106\t# -----------------------------------------------------------------------------\n107\t# AST extraction\n108\t# -----------------------------------------------------------------------------\n109\t\n110\t\n111\tdef public_function_names(path: Path) -> Set[str]:\n112\t    \"\"\"Return public top-level function defs from a Python file (stdlib-ast).\"\"\"\n113\t    if not path.is_file():\n114\t        raise FileNotFoundError(f\"cannot read {path}\")\n115\t    try:\n116\t        src = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n117\t        tree = ast.parse(src, filename=str(path))\n118\t    except (OSError, SyntaxError) as e:\n119\t        raise RuntimeError(f\"AST parse failed for {path}: {e}\") from e\n120\t    names: Set[str] = set()\n121\t    for node in tree.body:\n122\t        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n123\t            if not node.name.startswith(\"_\"):\n124\t                names.add(node.name)\n125\t    return names\n126\t\n127\t\n128\t# -----------------------------------------------------------------------------\n129\t# Check\n130\t# -----------------------------------------------------------------------------\n131\t\n132\t\n133\tdef check_baseline(\n134\t    repo_root: Path,\n135\t    baseline: Dict[str, Set[str]] = BASELINE,\n136\t) -> Tuple[int, Dict[str, Dict[str, List[str]]]]:\n137\t    \"\"\"Run the baseline check.\n138\t\n139\t    Returns (exit_code, report) where report is:\n140\t        {rel_path: {missing: [...], extras: [...]}}\n141\t    \"\"\"\n142\t    report: Dict[str, Dict[str, List[str]]] = {}\n143\t    worst = 0\n144\t\n145\t    for rel_path, required in sorted(baseline.items()):\n146\t        abs_path = repo_root / rel_path\n147\t        try:\n148\t            present = public_function_names(abs_path)\n149\t        except FileNotFoundError as e:\n150\t            report[rel_path] = {\"missing\": sorted(required), \"extras\": [], \"error\": [str(e)]}\n151\t            worst = max(worst, 2)\n152\t            continue\n153\t        except RuntimeError as e:\n154\t            report[rel_path] = {\"missing\": [], \"extras\": [], \"error\": [str(e)]}\n155\t            worst = max(worst, 2)\n156\t            continue\n157\t\n158\t        missing = sorted(required - present)\n159\t        extras = sorted(present - required)\n160\t        report[rel_path] = {\"missing\": missing, \"extras\": extras}\n161\t        if missing:\n162\t            worst = max(worst, 1)\n163\t\n164\t    return worst, report\n165\t\n166\t\n167\tdef format_report(report: Dict[str, Dict[str, List[str]]], verbose: bool) -> str:\n168\t    \"\"\"Format the audit-query read-API stability report as human-readable text.\"\"\"\n169\t    lines: List[str] = []\n170\t    for rel_path, info in sorted(report.items()):\n171\t        missing = info.get(\"missing\", [])\n172\t        extras = info.get(\"extras\", [])\n173\t        err = info.get(\"error\", [])\n174\t        if err:\n175\t            lines.append(f\"[FAIL] {rel_path}\")\n176\t            for e in err:\n177\t                lines.append(f\"  error: {e}\")\n178\t            continue\n179\t        if missing:\n180\t            lines.append(f\"[FAIL] {rel_path}\")\n181\t            for m in missing:\n182\t                lines.append(f\"  MISSING baseline function: {m}\")\n183\t        elif verbose:\n184\t            lines.append(f\"[OK]   {rel_path}  (baseline {len(info.get('missing', []))} missing, {len(extras)} additions)\")\n185\t        if extras and verbose:\n186\t            for x in extras:\n187\t                lines.append(f\"  additive (not in baseline): {x}\")\n188\t    return \"\\n\".join(lines) or \"(no report items)\"\n189\t\n190\t\n191\t# -----------------------------------------------------------------------------\n192\t# CLI\n193\t# -----------------------------------------------------------------------------\n194\t\n195\t\n196\tdef build_parser() -> argparse.ArgumentParser:\n197\t    p = argparse.ArgumentParser(\n198\t        prog=\"check-audit-read-api-stable.py\",\n199\t        description=\"Freeze-check for audit-log + session-graph read API (PLAN-014 F.0)\",\n200\t    )\n201\t    p.add_argument(\"--repo-root\", default=None,\n202\t                   help=\"Repo root (default: cwd)\")\n203\t    p.add_argument(\"--verbose\", \"-v\", action=\"store_true\")\n204\t    p.add_argument(\"--json\", action=\"store_true\")\n205\t    return p\n206\t\n207\t\n208\tdef main(argv: Optional[List[str]] = None) -> int:\n209\t    \"\"\"CLI entrypoint — assert audit-query read-API output shape is unchanged.\"\"\"\n210\t    parser = build_parser()\n211\t    args = parser.parse_args(argv)\n212\t\n213\t    repo_root = Path(args.repo_root).resolve() if args.repo_root else Path.cwd()\n214\t\n215\t    exit_code, report = check_baseline(repo_root)\n216\t\n217\t    if args.json:\n218\t        import json as _json\n219\t        payload = {\"exit\": exit_code, \"report\": {\n220\t            k: {\"missing\": v.get(\"missing\", []), \"extras\": v.get(\"extras\", []),\n221\t                \"error\": v.get(\"error\", [])}\n222\t            for k, v in report.items()\n223\t        }}\n224\t        sys.stdout.write(_json.dumps(payload, ensure_ascii=False, indent=2) + \"\\n\")\n225\t    else:\n226\t        out = format_report(report, args.verbose)\n227\t        sys.stdout.write(out + \"\\n\")\n228\t        if exit_code == 0:\n229\t            sys.stdout.write(\"OK: read-API baseline intact\\n\")\n230\t        elif exit_code == 1:\n231\t            sys.stdout.write(\"FAIL: read-API drift — baseline function missing/renamed\\n\")\n232\t        else:\n233\t            sys.stdout.write(\"ERROR: internal failure (missing file or parse error)\\n\")\n234\t\n235\t    return exit_code\n236\t\n237\t\n238\tif __name__ == \"__main__\":  # pragma: no cover\n239\t    sys.exit(main())\n240\t"}]},"parent_tool_use_id":null,"session_id":"f3d94731-802e-46e1-9fa0-3006a5880d2e","uuid":"604ec674-58f9-4d18-a6eb-25d2b774ec90","timestamp":"2026-11-16T18:01:40.877Z","tool_use_result":{"type":"text","file":{"filePath":".claude/scripts/check-audit-read-api-stable.py","content":"#!/usr/bin/env python3\n\"\"\"check-audit-read-api-stable — audit-log + session-graph read-API freeze guard.\n\nPLAN-014 Phase F.0 + ADJ-011 (VP Engineering §Phase-F pre-work). Pattern\nprecedent: ``check-audit-registry-coverage.py`` (PLAN-013 Gap #3 fix).\n\nDuring Phase F, three new capabilities (replay + predict + cross-plan-memory)\nall consume the **audit-log read API** and the **session-graph derived\nregistry** to reconstruct plan context. If a refactor REMOVES or RENAMES\na public read function under our feet, every Phase F downstream breaks\nsilently.\n\nThis script FREEZES the public read-API surface at a pinned baseline. Any\ncommit that removes or renames a baseline function trips exit 1. Adding\nnew functions (additive) is fine.\n\n## What it guards\n\n- ``.claude/hooks/_lib/audit_emit.py::iter_events`` — public event iterator\n- ``.claude/scripts/audit-query.py`` sub-command dispatch table\n\n## Baseline (v1.0.0-rc.1)\n\nPublic read-API functions / subcommands that MUST EXIST across v1:\n\n  iter_events\n  read_entries                (audit-query.py)\n  discover_logs               (audit-query.py)\n  default_log_path            (audit-query.py)\n  cmd_summary                 (audit-query.py)\n  cmd_by_skill                (audit-query.py)\n  cmd_compliance              (audit-query.py)\n  cmd_by_day                  (audit-query.py)\n  cmd_search                  (audit-query.py)\n  cmd_since                   (audit-query.py)\n  cmd_stats                   (audit-query.py)\n  cmd_export                  (audit-query.py)\n  cmd_debate                  (audit-query.py)\n  cmd_plans                   (audit-query.py)\n  cmd_vetoes                  (audit-query.py)\n  cmd_benchmarks              (audit-query.py)\n  cmd_lessons                 (audit-query.py)\n  cmd_metrics                 (audit-query.py)\n  cmd_health                  (audit-query.py)\n  cmd_tokens                  (audit-query.py)\n\nBaseline lives in this script (BASELINE_FUNCS). To tighten (add a new\nmust-exist function) is MINOR-bump additive. To REMOVE from the baseline\nis MAJOR-bump (forbidden in v1 without new SPEC file).\n\n## Exit codes\n\n  0 — baseline intact (all functions present); any ADDITIONS are reported\n      advisory\n  1 — drift detected (baseline function missing or renamed)\n  2 — internal error (missing source file, malformed AST)\n\nStdlib only. Python 3.9+.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport ast\nimport sys\nfrom pathlib import Path\nfrom typing import Dict, List, Optional, Set, Tuple\n\n\n# -----------------------------------------------------------------------------\n# Baseline — pinned v1.0.0-rc.1\n# -----------------------------------------------------------------------------\n\nAUDIT_EMIT_REL = Path(\".claude/hooks/_lib/audit_emit.py\")\nAUDIT_QUERY_REL = Path(\".claude/scripts/audit-query.py\")\n\nBASELINE: Dict[str, Set[str]] = {\n    # module-rel-path: {required public function names}\n    str(AUDIT_EMIT_REL): {\n        \"iter_events\",\n    },\n    str(AUDIT_QUERY_REL): {\n        \"read_entries\",\n        \"discover_logs\",\n        \"default_log_path\",\n        \"cmd_summary\",\n        \"cmd_by_skill\",\n        \"cmd_compliance\",\n        \"cmd_by_day\",\n        \"cmd_search\",\n        \"cmd_since\",\n        \"cmd_stats\",\n        \"cmd_export\",\n        \"cmd_debate\",\n        \"cmd_plans\",\n        \"cmd_vetoes\",\n        \"cmd_benchmarks\",\n        \"cmd_lessons\",\n        \"cmd_metrics\",\n        \"cmd_health\",\n        \"cmd_tokens\",\n    },\n}\n\n\n# -----------------------------------------------------------------------------\n# AST extraction\n# -----------------------------------------------------------------------------\n\n\ndef public_function_names(path: Path) -> Set[str]:\n    \"\"\"Return public top-level function defs from a Python file (stdlib-ast).\"\"\"\n    if not path.is_file():\n        raise FileNotFoundError(f\"cannot read {path}\")\n    try:\n        src = path.read_text(encoding=\"utf-8\", errors=\"replace\")\n        tree = ast.parse(src, filename=str(path))\n    except (OSError, SyntaxError) as e:\n        raise RuntimeError(f\"AST parse failed for {path}: {e}\") from e\n    names: Set[str] = set()\n    for node in tree.body:\n        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n            if not node.name.startswith(\"_\"):\n                names.add(node.name)\n    return names\n\n\n# -----------------------------------------------------------------------------\n# Check\n# -----------------------------------------------------------------------------\n\n\ndef check_baseline(\n    repo_root: Path,\n    baseline: Dict[str, Set[str]] = BASELINE,\n) -> Tuple[int, Dict[str, Dict[str, List[str]]]]:\n    \"\"\"Run the baseline check.\n\n    Returns (exit_code, report) where report is:\n        {rel_path: {missing: [...], extras: [...]}}\n    \"\"\"\n    report: Dict[str, Dict[str, List[str]]] = {}\n    worst = 0\n\n    for rel_path, required in sorted(baseline.items()):\n        abs_path = repo_root / rel_path\n        try:\n            present = public_function_names(abs_path)\n        except FileNotFoundError as e:\n            report[rel_path] = {\"missing\": sorted(required), \"extras\": [], \"error\": [str(e)]}\n            worst = max(worst, 2)\n            continue\n        except RuntimeError as e:\n            report[rel_path] = {\"missing\": [], \"extras\": [], \"error\": [str(e)]}\n            worst = max(worst, 2)\n            continue\n\n        missing = sorted(required - present)\n        extras = sorted(present - required)\n        report[rel_path] = {\"missing\": missing, \"extras\": extras}\n        if missing:\n            worst = max(worst, 1)\n\n    return worst, report\n\n\ndef format_report(report: Dict[str, Dict[str, List[str]]], verbose: bool) -> str:\n    \"\"\"Format the audit-query read-API stability report as human-readable text.\"\"\"\n    lines: List[str] = []\n    for rel_path, info in sorted(report.items()):\n        missing = info.get(\"missing\", [])\n        extras = info.get(\"extras\", [])\n        err = info.get(\"error\", [])\n        if err:\n            lines.append(f\"[FAIL] {rel_path}\")\n            for e in err:\n                lines.append(f\"  error: {e}\")\n            continue\n        if missing:\n            lines.append(f\"[FAIL] {rel_path}\")\n            for m in missing:\n                lines.append(f\"  MISSING baseline function: {m}\")\n        elif verbose:\n            lines.append(f\"[OK]   {rel_path}  (baseline {len(info.get('missing', []))} missing, {len(extras)} additions)\")\n        if extras and verbose:\n            for x in extras:\n                lines.append(f\"  additive (not in baseline): {x}\")\n    return \"\\n\".join(lines) or \"(no report items)\"\n\n\n# -----------------------------------------------------------------------------\n# CLI\n# -----------------------------------------------------------------------------\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    p = argparse.ArgumentParser(\n        prog=\"check-audit-read-api-stable.py\",\n        description=\"Freeze-check for audit-log + session-graph read API (PLAN-014 F.0)\",\n    )\n    p.add_argument(\"--repo-root\", default=None,\n                   help=\"Repo root (default: cwd)\")\n    p.add_argument(\"--verbose\", \"-v\", action=\"store_true\")\n    p.add_argument(\"--json\", action=\"store_true\")\n    return p\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    \"\"\"CLI entrypoint — assert audit-query read-API output shape is unchanged.\"\"\"\n    parser = build_parser()\n    args = parser.parse_args(argv)\n\n    repo_root = Path(args.repo_root).resolve() if args.repo_root else Path.cwd()\n\n    exit_code, report = check_baseline(repo_root)\n\n    if args.json:\n        import json as _json\n        payload = {\"exit\": exit_code, \"report\": {\n            k: {\"missing\": v.get(\"missing\", []), \"extras\": v.get(\"extras\", []),\n                \"error\": v.get(\"error\", [])}\n            for k, v in report.items()\n        }}\n        sys.stdout.write(_json.dumps(payload, ensure_ascii=False, indent=2) + \"\\n\")\n    else:\n        out = format_report(report, args.verbose)\n        sys.stdout.write(out + \"\\n\")\n        if exit_code == 0:\n            sys.stdout.write(\"OK: read-API baseline intact\\n\")\n        elif exit_code == 1:\n            sys.stdout.write(\"FAIL: read-API drift — baseline function missing/renamed\\n\")\n        else:\n            sys.stdout.write(\"ERROR: internal failure (missing file or parse error)\\n\")\n\n    return exit_code\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    sys.exit(main())\n","numLines":240,"startLine":1,"totalLines":240}},"tool_result_meta":[{"id":"toolu_01NLe1EhUsfDNZwsH5LNt5Uq","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
