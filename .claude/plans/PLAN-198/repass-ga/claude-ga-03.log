{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018HDqHx95kqBwp2hphNkHvN","type":"tool_result","content":"100\t            file=sys.stderr,\n101\t        )\n102\t        return 1\n103\t\n104\t    try:\n105\t        finding_ids = _load_finding_ids(args.source, args.severity)\n106\t    except FileNotFoundError as e:\n107\t        print(f\"validate-findings: source JSONL not found: {e}\", file=sys.stderr)\n108\t        return 2\n109\t\n110\t    # Build closure index from plan body. Either:\n111\t    #   closed_in_commit: <SHA>   (next to ID)\n112\t    #   deferred_to: PLAN-NNN     (next to ID)\n113\t    closed_ids: Set[str] = set()\n114\t    for rid in finding_ids:\n115\t        # Cheap substring contains check first; if the ID literal appears at\n116\t        # all in §11 with closure or deferral keyword nearby (same line or\n117\t        # within next 200 chars), count as closed.\n118\t        for m in re.finditer(re.escape(rid), plan_body):\n119\t            ctx = plan_body[max(0, m.start() - 50):m.end() + 200]\n120\t            if re.search(r\"closed_in_commit\\s*:\\s*\\S+\", ctx) or re.search(\n121\t                r\"deferred_to\\s*:\\s*PLAN-\\d+\", ctx\n122\t            ):\n123\t                closed_ids.add(rid)\n124\t                break\n125\t\n126\t    missing = sorted(finding_ids - closed_ids)\n127\t    print(\n128\t        f\"validate-findings progress-log-closure: \"\n129\t        f\"plan={args.plan} severity={args.severity} \"\n130\t        f\"total={len(finding_ids)} closed={len(closed_ids)} \"\n131\t        f\"missing={len(missing)}\"\n132\t    )\n133\t    if missing:\n134\t        for rid in missing[:25]:\n135\t            print(f\"  MISSING: {rid}\", file=sys.stderr)\n136\t        if len(missing) > 25:\n137\t            print(f\"  ... and {len(missing) - 25} more\", file=sys.stderr)\n138\t        return 1\n139\t    return 0\n140\t\n141\t\n142\t# ---------------------------------------------------------------------------\n143\t# Subcommand: emit-typed-coverage\n144\t# ---------------------------------------------------------------------------\n145\t\n146\tdef cmd_emit_typed_coverage(args: argparse.Namespace) -> int:\n147\t    \"\"\"Lint: no `emit_generic(action=\"<X>\"` for any X in --actions.\"\"\"\n148\t    if not args.audit_emit.exists():\n149\t        print(\n150\t            f\"validate-findings: audit_emit.py not found at {args.audit_emit}\",\n151\t            file=sys.stderr,\n152\t        )\n153\t        return 2\n154\t    actions: List[str] = [a.strip() for a in args.actions.split(\",\") if a.strip()]\n155\t    if not actions:\n156\t        print(\"validate-findings: --actions list empty\", file=sys.stderr)\n157\t        return 2\n158\t\n159\t    # Scan whole tree for emit_generic call sites referencing each action.\n160\t    scan_roots = [\n161\t        REPO_ROOT / \".claude\" / \"hooks\",\n162\t        REPO_ROOT / \".claude\" / \"scripts\",\n163\t    ]\n164\t    findings: List[Tuple[str, str, int]] = []\n165\t    for root in scan_roots:\n166\t        if not root.exists():\n167\t            continue\n168\t        for py in root.rglob(\"*.py\"):\n169\t            if \"test\" in py.name and \"fixture\" not in py.name:\n170\t                # Tests may construct test-only emit_generic calls intentionally.\n171\t                continue\n172\t            try:\n173\t                txt = py.read_text(encoding=\"utf-8\")\n174\t            except OSError:\n175\t                continue\n176\t            for action in actions:\n177\t                pat = re.compile(\n178\t                    r\"emit_generic\\s*\\(\\s*[\\\"']\" + re.escape(action) + r\"[\\\"']\"\n179\t                )"}]},"parent_tool_use_id":null,"session_id":"f3d94731-802e-46e1-9fa0-3006a5880d2e","uuid":"4beaa50d-7fba-4650-9749-55cd15924a08","timestamp":"2026-11-16T18:01:57.201Z","tool_use_result":{"type":"text","file":{"filePath":".claude/scripts/validate-findings.py","content":"            file=sys.stderr,\n        )\n        return 1\n\n    try:\n        finding_ids = _load_finding_ids(args.source, args.severity)\n    except FileNotFoundError as e:\n        print(f\"validate-findings: source JSONL not found: {e}\", file=sys.stderr)\n        return 2\n\n    # Build closure index from plan body. Either:\n    #   closed_in_commit: <SHA>   (next to ID)\n    #   deferred_to: PLAN-NNN     (next to ID)\n    closed_ids: Set[str] = set()\n    for rid in finding_ids:\n        # Cheap substring contains check first; if the ID literal appears at\n        # all in §11 with closure or deferral keyword nearby (same line or\n        # within next 200 chars), count as closed.\n        for m in re.finditer(re.escape(rid), plan_body):\n            ctx = plan_body[max(0, m.start() - 50):m.end() + 200]\n            if re.search(r\"closed_in_commit\\s*:\\s*\\S+\", ctx) or re.search(\n                r\"deferred_to\\s*:\\s*PLAN-\\d+\", ctx\n            ):\n                closed_ids.add(rid)\n                break\n\n    missing = sorted(finding_ids - closed_ids)\n    print(\n        f\"validate-findings progress-log-closure: \"\n        f\"plan={args.plan} severity={args.severity} \"\n        f\"total={len(finding_ids)} closed={len(closed_ids)} \"\n        f\"missing={len(missing)}\"\n    )\n    if missing:\n        for rid in missing[:25]:\n            print(f\"  MISSING: {rid}\", file=sys.stderr)\n        if len(missing) > 25:\n            print(f\"  ... and {len(missing) - 25} more\", file=sys.stderr)\n        return 1\n    return 0\n\n\n# ---------------------------------------------------------------------------\n# Subcommand: emit-typed-coverage\n# ---------------------------------------------------------------------------\n\ndef cmd_emit_typed_coverage(args: argparse.Namespace) -> int:\n    \"\"\"Lint: no `emit_generic(action=\"<X>\"` for any X in --actions.\"\"\"\n    if not args.audit_emit.exists():\n        print(\n            f\"validate-findings: audit_emit.py not found at {args.audit_emit}\",\n            file=sys.stderr,\n        )\n        return 2\n    actions: List[str] = [a.strip() for a in args.actions.split(\",\") if a.strip()]\n    if not actions:\n        print(\"validate-findings: --actions list empty\", file=sys.stderr)\n        return 2\n\n    # Scan whole tree for emit_generic call sites referencing each action.\n    scan_roots = [\n        REPO_ROOT / \".claude\" / \"hooks\",\n        REPO_ROOT / \".claude\" / \"scripts\",\n    ]\n    findings: List[Tuple[str, str, int]] = []\n    for root in scan_roots:\n        if not root.exists():\n            continue\n        for py in root.rglob(\"*.py\"):\n            if \"test\" in py.name and \"fixture\" not in py.name:\n                # Tests may construct test-only emit_generic calls intentionally.\n                continue\n            try:\n                txt = py.read_text(encoding=\"utf-8\")\n            except OSError:\n                continue\n            for action in actions:\n                pat = re.compile(\n                    r\"emit_generic\\s*\\(\\s*[\\\"']\" + re.escape(action) + r\"[\\\"']\"\n                )","numLines":80,"startLine":100,"totalLines":244}},"tool_result_meta":[{"id":"toolu_018HDqHx95kqBwp2hphNkHvN","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
