{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K4bHs5eQbeC61SWj4nCuVJ","type":"tool_result","content":"1\t\"\"\"stdio transport for the MCP server (ADR-042 §Transport).\n2\t\n3\tReads newline-delimited JSON-RPC 2.0 envelopes from stdin, writes\n4\tnewline-delimited responses to stdout. Auth fields live in\n5\t``params.authorization`` + ``params.timestamp_ms`` + optional\n6\t``params.session_id`` — stdio has no transport-level headers.\n7\t\n8\tAuth fields are STRIPPED from ``params`` before the handler sees\n9\tthem (ADR-042 §Auth.6 hygiene).\n10\t\n11\tSingle-threaded by construction — one request, one response. This\n12\tmatches the MCP spec's stdio contract: each message is a complete\n13\tJSON value on its own line.\n14\t\n15\t## PLAN-112-FOLLOWUP-mcp-bearer-defenses-wire — remote_addr sentinel\n16\t\n17\tThe stdio transport has NO network remote address (it is a local\n18\tpipe). The replay store's loopback gate would DENY a missing/empty\n19\taddress, so this transport passes the ``\"stdio-local\"`` sentinel\n20\t(``dispatch.bearer_replay.STDIO_LOCAL_ADDR``) into\n21\t``authenticate(remote_addr=...)``; the store whitelists that sentinel\n22\tas loopback-equivalent trust (§3a).\n23\t\"\"\"\n24\t\n25\tfrom __future__ import annotations\n26\t\n27\timport json\n28\timport sys\n29\timport uuid\n30\tfrom pathlib import Path\n31\tfrom typing import Any, Dict, Optional, TextIO\n32\t\n33\t_SERVER_DIR = Path(__file__).resolve().parent\n34\tif str(_SERVER_DIR) not in sys.path:\n35\t    sys.path.insert(0, str(_SERVER_DIR))\n36\t\n37\timport auth  # type: ignore[import-not-found]  # noqa: E402\n38\timport dispatch  # type: ignore[import-not-found]  # noqa: E402\n39\t\n40\t\n41\tdef _extract_auth(envelope: Dict[str, Any]) -> Dict[str, Any]:\n42\t    \"\"\"Remove auth-only fields from envelope.params so handlers see clean params.\n43\t\n44\t    Returns a new envelope dict with clean params; the original is\n45\t    not mutated. This prevents any downstream handler from seeing the\n46\t    bearer token or timestamp (ADR-042 §Auth.6 hygiene).\n47\t    \"\"\"\n48\t    params = envelope.get(\"params\") or {}\n49\t    if not isinstance(params, dict):\n50\t        return envelope\n51\t    clean = {\n52\t        k: v for k, v in params.items()\n53\t        if k not in (\"authorization\", \"timestamp_ms\", \"session_id\")\n54\t    }\n55\t    return {**envelope, \"params\": clean}\n56\t\n57\t\n58\tdef run(\n59\t    project_dir: Path,\n60\t    *,\n61\t    stdin: Optional[TextIO] = None,\n62\t    stdout: Optional[TextIO] = None,\n63\t) -> None:\n64\t    \"\"\"stdio transport main loop.\n65\t\n66\t    Test callers inject ``stdin`` / ``stdout`` streams; production\n67\t    uses ``sys.stdin`` / ``sys.stdout``. Loop exits when stdin is\n68\t    closed (EOF) or exhausted.\n69\t    \"\"\"\n70\t    in_stream = stdin or sys.stdin\n71\t    out_stream = stdout or sys.stdout\n72\t    project = str(project_dir)\n73\t\n74\t    for raw_line in in_stream:\n75\t        line = raw_line.strip()\n76\t        if not line:\n77\t            continue\n78\t        envelope, err_resp = dispatch.parse_envelope(line)\n79\t        if err_resp is not None:\n80\t            out_stream.write(json.dumps(err_resp, ensure_ascii=False) + \"\\n\")\n81\t            out_stream.flush()\n82\t            continue\n83\t        assert envelope is not None\n84\t\n85\t        params = envelope.get(\"params\") or {}\n86\t        if not isinstance(params, dict):\n87\t            out_stream.write(\n88\t                json.dumps(\n89\t                    dispatch.rpc_error(\n90\t                        envelope.get(\"id\"), dispatch.ERR_INVALID_PARAMS, \"Invalid params\"\n91\t                    ),\n92\t                    ensure_ascii=False,\n93\t                )\n94\t                + \"\\n\"\n95\t            )\n96\t            out_stream.flush()\n97\t            continue\n98\t\n99\t        raw_token = params.get(\"authorization\")\n100\t        if not isinstance(raw_token, str):\n101\t            raw_token = None\n102\t        timestamp_ms = params.get(\"timestamp_ms\", \"\")\n103\t        session_id_raw = params.get(\"session_id\")\n104\t        session_id = session_id_raw if isinstance(session_id_raw, str) and session_id_raw else str(uuid.uuid4())\n105\t\n106\t        clean_env = _extract_auth(envelope)\n107\t\n108\t        ctx, deny_reason, _retry_ms = dispatch.authenticate(\n109\t            raw_token=raw_token,\n110\t            timestamp_ms=timestamp_ms,\n111\t            method=envelope[\"method\"],\n112\t            origin=None,\n113\t            transport=\"stdio\",\n114\t            session_id=session_id,\n115\t            project_dir=project_dir,\n116\t            remote_addr=dispatch.bearer_replay.STDIO_LOCAL_ADDR,\n117\t        )\n118\t\n119\t        if deny_reason is not None:\n120\t            client_id_for_audit = \"\"\n121\t            if raw_token:\n122\t                parsed = auth.parse_token(raw_token)\n123\t                if parsed is not None:\n124\t                    client_id_for_audit = parsed[\"client_id\"]\n125\t            dispatch.emit_deny(\n126\t                handler=envelope[\"method\"],\n127\t                client_id=client_id_for_audit,\n128\t                transport=\"stdio\",\n129\t                reason=deny_reason,\n130\t                session_id=session_id,\n131\t                project=project,\n132\t            )\n133\t            code = dispatch.DENY_CODE_MAP.get(deny_reason, dispatch.ERR_APP_AUTH)\n134\t            out_stream.write(\n135\t                json.dumps(\n136\t                    dispatch.rpc_error(envelope.get(\"id\"), code, deny_reason),\n137\t                    ensure_ascii=False,\n138\t                )\n139\t                + \"\\n\"\n140\t            )\n141\t            out_stream.flush()\n142\t            continue\n143\t\n144\t        assert ctx is not None\n145\t        response = dispatch.dispatch(clean_env, ctx, project)\n146\t        out_stream.write(json.dumps(response, ensure_ascii=False) + \"\\n\")\n147\t        out_stream.flush()\n148\t\n149\t\n150\t__all__ = [\"run\"]\n151\t"}]},"parent_tool_use_id":null,"session_id":"4ead31fb-64db-4d2c-9f7e-f45956681e3d","uuid":"139680aa-bd99-46c3-a696-dab5bbae4878","timestamp":"2026-11-16T18:01:52.261Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/mcp-server/stdio_transport.py","content":"\"\"\"stdio transport for the MCP server (ADR-042 §Transport).\n\nReads newline-delimited JSON-RPC 2.0 envelopes from stdin, writes\nnewline-delimited responses to stdout. Auth fields live in\n``params.authorization`` + ``params.timestamp_ms`` + optional\n``params.session_id`` — stdio has no transport-level headers.\n\nAuth fields are STRIPPED from ``params`` before the handler sees\nthem (ADR-042 §Auth.6 hygiene).\n\nSingle-threaded by construction — one request, one response. This\nmatches the MCP spec's stdio contract: each message is a complete\nJSON value on its own line.\n\n## PLAN-112-FOLLOWUP-mcp-bearer-defenses-wire — remote_addr sentinel\n\nThe stdio transport has NO network remote address (it is a local\npipe). The replay store's loopback gate would DENY a missing/empty\naddress, so this transport passes the ``\"stdio-local\"`` sentinel\n(``dispatch.bearer_replay.STDIO_LOCAL_ADDR``) into\n``authenticate(remote_addr=...)``; the store whitelists that sentinel\nas loopback-equivalent trust (§3a).\n\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport sys\nimport uuid\nfrom pathlib import Path\nfrom typing import Any, Dict, Optional, TextIO\n\n_SERVER_DIR = Path(__file__).resolve().parent\nif str(_SERVER_DIR) not in sys.path:\n    sys.path.insert(0, str(_SERVER_DIR))\n\nimport auth  # type: ignore[import-not-found]  # noqa: E402\nimport dispatch  # type: ignore[import-not-found]  # noqa: E402\n\n\ndef _extract_auth(envelope: Dict[str, Any]) -> Dict[str, Any]:\n    \"\"\"Remove auth-only fields from envelope.params so handlers see clean params.\n\n    Returns a new envelope dict with clean params; the original is\n    not mutated. This prevents any downstream handler from seeing the\n    bearer token or timestamp (ADR-042 §Auth.6 hygiene).\n    \"\"\"\n    params = envelope.get(\"params\") or {}\n    if not isinstance(params, dict):\n        return envelope\n    clean = {\n        k: v for k, v in params.items()\n        if k not in (\"authorization\", \"timestamp_ms\", \"session_id\")\n    }\n    return {**envelope, \"params\": clean}\n\n\ndef run(\n    project_dir: Path,\n    *,\n    stdin: Optional[TextIO] = None,\n    stdout: Optional[TextIO] = None,\n) -> None:\n    \"\"\"stdio transport main loop.\n\n    Test callers inject ``stdin`` / ``stdout`` streams; production\n    uses ``sys.stdin`` / ``sys.stdout``. Loop exits when stdin is\n    closed (EOF) or exhausted.\n    \"\"\"\n    in_stream = stdin or sys.stdin\n    out_stream = stdout or sys.stdout\n    project = str(project_dir)\n\n    for raw_line in in_stream:\n        line = raw_line.strip()\n        if not line:\n            continue\n        envelope, err_resp = dispatch.parse_envelope(line)\n        if err_resp is not None:\n            out_stream.write(json.dumps(err_resp, ensure_ascii=False) + \"\\n\")\n            out_stream.flush()\n            continue\n        assert envelope is not None\n\n        params = envelope.get(\"params\") or {}\n        if not isinstance(params, dict):\n            out_stream.write(\n                json.dumps(\n                    dispatch.rpc_error(\n                        envelope.get(\"id\"), dispatch.ERR_INVALID_PARAMS, \"Invalid params\"\n                    ),\n                    ensure_ascii=False,\n                )\n                + \"\\n\"\n            )\n            out_stream.flush()\n            continue\n\n        raw_token = params.get(\"authorization\")\n        if not isinstance(raw_token, str):\n            raw_token = None\n        timestamp_ms = params.get(\"timestamp_ms\", \"\")\n        session_id_raw = params.get(\"session_id\")\n        session_id = session_id_raw if isinstance(session_id_raw, str) and session_id_raw else str(uuid.uuid4())\n\n        clean_env = _extract_auth(envelope)\n\n        ctx, deny_reason, _retry_ms = dispatch.authenticate(\n            raw_token=raw_token,\n            timestamp_ms=timestamp_ms,\n            method=envelope[\"method\"],\n            origin=None,\n            transport=\"stdio\",\n            session_id=session_id,\n            project_dir=project_dir,\n            remote_addr=dispatch.bearer_replay.STDIO_LOCAL_ADDR,\n        )\n\n        if deny_reason is not None:\n            client_id_for_audit = \"\"\n            if raw_token:\n                parsed = auth.parse_token(raw_token)\n                if parsed is not None:\n                    client_id_for_audit = parsed[\"client_id\"]\n            dispatch.emit_deny(\n                handler=envelope[\"method\"],\n                client_id=client_id_for_audit,\n                transport=\"stdio\",\n                reason=deny_reason,\n                session_id=session_id,\n                project=project,\n            )\n            code = dispatch.DENY_CODE_MAP.get(deny_reason, dispatch.ERR_APP_AUTH)\n            out_stream.write(\n                json.dumps(\n                    dispatch.rpc_error(envelope.get(\"id\"), code, deny_reason),\n                    ensure_ascii=False,\n                )\n                + \"\\n\"\n            )\n            out_stream.flush()\n            continue\n\n        assert ctx is not None\n        response = dispatch.dispatch(clean_env, ctx, project)\n        out_stream.write(json.dumps(response, ensure_ascii=False) + \"\\n\")\n        out_stream.flush()\n\n\n__all__ = [\"run\"]\n","numLines":151,"startLine":1,"totalLines":151}},"tool_result_meta":[{"id":"toolu_01K4bHs5eQbeC61SWj4nCuVJ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
