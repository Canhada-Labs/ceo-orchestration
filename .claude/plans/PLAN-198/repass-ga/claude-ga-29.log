{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QWACeXyZNEaWQs6jvycVXi","type":"tool_result","content":"1\t\"\"\"AST inventory of direct subprocess test calls, with a content-based ratchet.\n2\t\n3\tThis is a static census, not proof of control-flow coverage: it recognises\n4\timports/aliases, local command assignments and assertions in the same lexical\n5\tscope. Dynamic dispatch and timeout values hidden inside **kwargs require\n6\tmanual inspection. Existing findings are debt, never an exemption for new sites.\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport ast\n11\timport hashlib\n12\timport json\n13\timport os\n14\timport sys\n15\tfrom pathlib import Path\n16\tfrom typing import Dict, Iterable, List, NamedTuple, Optional\n17\t\n18\t\n19\tTEST_ROOTS = (\n20\t    \".claude/hooks/tests\", \".claude/scripts/tests\", \".claude/scripts/swarm/tests\",\n21\t    \"scripts/tests\", \"tests\", \"templates/oidc-proxy/tests\",\n22\t)\n23\tKINDS = (\"python-rc\", \"timeout-group\")\n24\tSCOPE_TYPES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)\n25\tGROUP_HELPER = \".claude/scripts/tests/_subprocess_helpers.py\"\n26\t# The fingerprint is persisted in the baseline, so it must not depend on the\n27\t# interpreter that computes it. Python 3.13 changed `ast.dump`'s DEFAULT output\n28\t# (new `show_empty=False` drops empty lists such as `keywords=[]`); passing\n29\t# `show_empty=True` restores the <=3.12 shape. Without it a baseline written on\n30\t# 3.9-3.12 reads as 95 \"new\" sites on 3.13/3.14 (S366, nightly py3.14 red).\n31\t# test_fu144_fingerprint_is_interpreter_stable pins golden digests on every\n32\t# matrix interpreter, so the next drift fails by name instead of as a ratchet.\n33\t_DUMP_OPTS = {\"show_empty\": True} if sys.version_info >= (3, 13) else {}\n34\t\n35\t\n36\tdef call_digest(call: ast.Call) -> str:\n37\t    dump = ast.dump(call, include_attributes=False, **_DUMP_OPTS)\n38\t    return hashlib.sha256(dump.encode()).hexdigest()[:20]\n39\t\n40\t\n41\tclass Finding(NamedTuple):\n42\t    kind: str\n43\t    path: str\n44\t    scope: str\n45\t    line: int\n46\t    fingerprint: str\n47\t\n48\t    @property\n49\t    def key(self) -> str:\n50\t        return f\"{self.path}::{self.scope}::{self.fingerprint}\"\n51\t\n52\t\n53\tdef _nodes(scope: ast.AST) -> Iterable[ast.AST]:\n54\t    \"\"\"Walk this scope only; a sibling's assertions cannot discharge its debt.\"\"\"\n55\t    yield scope\n56\t    for child in ast.iter_child_nodes(scope):\n57\t        if not isinstance(child, SCOPE_TYPES):\n58\t            yield from _nodes(child)\n59\t\n60\t\n61\tdef _scopes(tree: ast.AST, prefix: str = \"<module>\") -> Iterable[tuple]:\n62\t    yield prefix, tree\n63\t    for node in _nodes(tree):\n64\t        for child in ast.iter_child_nodes(node):\n65\t            if isinstance(child, SCOPE_TYPES):\n66\t                yield from _scopes(child, f\"{prefix}.{child.name}\")\n67\t\n68\t\n69\tdef _imports(nodes: Iterable[ast.AST], inherited: dict) -> dict:\n70\t    result = dict(inherited)\n71\t    for node in nodes:\n72\t        if isinstance(node, ast.Import):\n73\t            for alias in node.names:\n74\t                result[alias.asname or alias.name] = alias.name\n75\t        elif isinstance(node, ast.ImportFrom):\n76\t            for alias in node.names:\n77\t                result[alias.asname or alias.name] = f\"{node.module}.{alias.name}\"\n78\t    return result\n79\t\n80\t\n81\tdef _name(node: ast.AST, aliases: dict) -> str:\n82\t    if isinstance(node, ast.Name):\n83\t        return aliases.get(node.id, node.id)\n84\t    if isinstance(node, ast.Attribute):\n85\t        return f\"{_name(node.value, aliases)}.{node.attr}\"\n86\t    return \"\"\n87\t\n88\t\n89\tdef _assignments(nodes: list) -> list:\n90\t    result = []\n91\t    for node in nodes:\n92\t        if isinstance(node, ast.Assign):\n93\t            targets = node.targets\n94\t        elif isinstance(node, ast.AnnAssign):\n95\t            targets = [node.target]\n96\t        else:\n97\t            continue\n98\t        for target in targets:\n99\t            if isinstance(target, (ast.Name, ast.Attribute)):\n100\t                result.append((target, node.value, node.lineno))\n101\t    return result\n102\t\n103\t\n104\tdef _python_command(node: Optional[ast.AST], aliases: dict, assignments: list, seen: tuple = ()) -> bool:\n105\t    if node is None:\n106\t        return False\n107\t    for part in ast.walk(node):\n108\t        if _name(part, aliases) == \"sys.executable\":\n109\t            return True\n110\t        if isinstance(part, ast.Name) and part.id not in seen:\n111\t            candidates = [\n112\t                (value, line) for target, value, line in assignments\n113\t                if isinstance(target, ast.Name) and target.id == part.id and line < part.lineno\n114\t            ]\n115\t            if candidates:\n116\t                value, _ = max(candidates, key=lambda item: item[1])\n117\t                if _python_command(value, aliases, assignments, seen + (part.id,)):\n118\t                    return True\n119\t    return False\n120\t\n121\t\n122\tdef _result_name(call: ast.Call, parents: dict, aliases: dict) -> str:\n123\t    parent = parents.get(call)\n124\t    if isinstance(parent, ast.Assign) and len(parent.targets) == 1:\n125\t        return _name(parent.targets[0], aliases)\n126\t    if isinstance(parent, ast.AnnAssign):\n127\t        return _name(parent.target, aliases)\n128\t    if isinstance(parent, ast.withitem) and parent.optional_vars is not None:\n129\t        return _name(parent.optional_vars, aliases)\n130\t    return \"\"\n131\t\n132\t\n133\tdef _assertions(nodes: list) -> Iterable[ast.AST]:\n134\t    for node in nodes:\n135\t        if isinstance(node, ast.Assert):\n136\t            yield node.test\n137\t        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n138\t            if node.func.attr.startswith(\"assert\"):\n139\t                for arg in node.args:\n140\t                    yield arg\n141\t\n142\t\n143\tdef _checks_rc(call: ast.Call, nodes: list, parents: dict, aliases: dict, assignments: list) -> bool:\n144\t    result = _result_name(call, parents, aliases)\n145\t    reassigned = [\n146\t        line for target, _, line in assignments\n147\t        if result and _name(target, aliases) == result and line > call.lineno\n148\t    ]\n149\t    end = min(reassigned, default=float(\"inf\"))\n150\t    for assertion in _assertions(nodes):\n151\t        for part in ast.walk(assertion):\n152\t            if not isinstance(part, ast.Attribute) or part.attr != \"returncode\":\n153\t                continue\n154\t            if part.value is call:\n155\t                return True\n156\t            if result and call.lineno <= part.lineno < end and _name(part.value, aliases) == result:\n157\t                return True\n158\t    return False\n159\t\n160\t\n161\tdef _classify(call: ast.Call, nodes: list, parents: dict, aliases: dict, assignments: list) -> list:\n162\t    name = _name(call.func, aliases)\n163\t    subprocess_call = name in (\"subprocess.run\", \"subprocess.Popen\")\n164\t    kinds = []\n165\t    if subprocess_call:\n166\t        command = call.args[0] if call.args else next((k.value for k in call.keywords if k.arg == \"args\"), None)\n167\t        if _python_command(command, aliases, assignments) and not _checks_rc(call, nodes, parents, aliases, assignments):\n168\t            kinds.append(\"python-rc\")\n169\t    communicate = isinstance(call.func, ast.Attribute) and call.func.attr == \"communicate\"\n170\t    timeout = any(k.arg == \"timeout\" for k in call.keywords) or (communicate and len(call.args) >= 2)\n171\t    if timeout and (subprocess_call or communicate):\n172\t        kinds.append(\"timeout-group\")\n173\t    return kinds\n174\t\n175\t\n176\tdef scan_source(source: str, path: str = \"test_example.py\") -> List[Finding]:\n177\t    tree = ast.parse(source, filename=path)\n178\t    parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}\n179\t    module_aliases = _imports(_nodes(tree), {})\n180\t    findings = []\n181\t    for scope, body in _scopes(tree):\n182\t        nodes = list(_nodes(body))\n183\t        aliases = _imports(nodes, module_aliases)\n184\t        assignments = _assignments(nodes)\n185\t        occurrences: Dict[str, int] = {}\n186\t        for call in (n for n in nodes if isinstance(n, ast.Call)):\n187\t            kinds = _classify(call, nodes, parents, aliases, assignments)\n188\t            if not kinds:\n189\t                continue\n190\t            digest = call_digest(call)\n191\t            occurrences[digest] = occurrences.get(digest, 0) + 1\n192\t            fingerprint = f\"{digest}:{occurrences[digest]}\"\n193\t            for kind in kinds:\n194\t                findings.append(Finding(kind, path, scope, call.lineno, fingerprint))\n195\t    return findings\n196\t\n197\t\n198\tdef _walk_error(error: OSError) -> None:\n199\t    raise error\n200\t\n201\t\n202\tdef scan_tree(root: Path) -> List[Finding]:\n203\t    result = []\n204\t    for relative in TEST_ROOTS:\n205\t        start = root / relative\n206\t        if not start.exists():\n207\t            continue\n208\t        for directory, folders, names in os.walk(start, onerror=_walk_error):\n209\t            folders[:] = sorted(name for name in folders if name != \"__pycache__\")\n210\t            for name in sorted(names):\n211\t                if not name.endswith(\".py\"):\n212\t                    continue\n213\t                path = Path(directory) / name\n214\t                relative_path = path.relative_to(root).as_posix()\n215\t                # Only the implementation that owns session creation and\n216\t                # cleanup is exempt. Imported test helpers remain in scope.\n217\t                if relative_path == GROUP_HELPER:\n218\t                    continue\n219\t                if path.is_symlink():\n220\t                    raise ValueError(f\"symlink test source: {path.relative_to(root)}\")\n221\t                result.extend(scan_source(path.read_text(encoding=\"utf-8\"), relative_path))\n222\t    return sorted(result)\n223\t\n224\t\n225\tdef baseline_rows(findings: Iterable[Finding]) -> dict:\n226\t    \"\"\"Group by source file; row keys survive line-only edits, not new calls.\"\"\"\n227\t    rows: Dict[str, dict] = {kind: {} for kind in KINDS}\n228\t    for finding in findings:\n229\t        rows[finding.kind].setdefault(finding.path, []).append(f\"{finding.scope}::{finding.fingerprint}\")\n230\t    return rows\n231\t\n232\t\n233\tdef new_findings(findings: Iterable[Finding], baseline: dict) -> List[Finding]:\n234\t    return [\n235\t        finding for finding in findings\n236\t        if f\"{finding.scope}::{finding.fingerprint}\" not in baseline.get(finding.kind, {}).get(finding.path, [])\n237\t    ]\n238\t\n239\t\n240\tdef load_baseline(path: Path) -> dict:\n241\t    baseline = json.loads(path.read_text(encoding=\"utf-8\"))\n242\t    if not isinstance(baseline, dict) or set(baseline) != set(KINDS):\n243\t        raise ValueError(\"baseline must contain both census kinds\")\n244\t    for paths in baseline.values():\n245\t        if not isinstance(paths, dict):\n246\t            raise ValueError(\"baseline kind must map paths to site lists\")\n247\t        for sites in paths.values():\n248\t            if not isinstance(sites, list) or any(not isinstance(site, str) for site in sites):\n249\t                raise ValueError(\"baseline sites must be strings\")\n250\t    return baseline\n251\t"}]},"parent_tool_use_id":null,"session_id":"e9f21750-77cd-44a8-9a48-5376b7294476","uuid":"4ca0ba0a-db97-41fd-b9f2-0ca69faef2eb","timestamp":"2026-11-16T19:58:00.146Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/_subprocess_census.py","content":"\"\"\"AST inventory of direct subprocess test calls, with a content-based ratchet.\n\nThis is a static census, not proof of control-flow coverage: it recognises\nimports/aliases, local command assignments and assertions in the same lexical\nscope. Dynamic dispatch and timeout values hidden inside **kwargs require\nmanual inspection. Existing findings are debt, never an exemption for new sites.\n\"\"\"\nfrom __future__ import annotations\n\nimport ast\nimport hashlib\nimport json\nimport os\nimport sys\nfrom pathlib import Path\nfrom typing import Dict, Iterable, List, NamedTuple, Optional\n\n\nTEST_ROOTS = (\n    \".claude/hooks/tests\", \".claude/scripts/tests\", \".claude/scripts/swarm/tests\",\n    \"scripts/tests\", \"tests\", \"templates/oidc-proxy/tests\",\n)\nKINDS = (\"python-rc\", \"timeout-group\")\nSCOPE_TYPES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)\nGROUP_HELPER = \".claude/scripts/tests/_subprocess_helpers.py\"\n# The fingerprint is persisted in the baseline, so it must not depend on the\n# interpreter that computes it. Python 3.13 changed `ast.dump`'s DEFAULT output\n# (new `show_empty=False` drops empty lists such as `keywords=[]`); passing\n# `show_empty=True` restores the <=3.12 shape. Without it a baseline written on\n# 3.9-3.12 reads as 95 \"new\" sites on 3.13/3.14 (S366, nightly py3.14 red).\n# test_fu144_fingerprint_is_interpreter_stable pins golden digests on every\n# matrix interpreter, so the next drift fails by name instead of as a ratchet.\n_DUMP_OPTS = {\"show_empty\": True} if sys.version_info >= (3, 13) else {}\n\n\ndef call_digest(call: ast.Call) -> str:\n    dump = ast.dump(call, include_attributes=False, **_DUMP_OPTS)\n    return hashlib.sha256(dump.encode()).hexdigest()[:20]\n\n\nclass Finding(NamedTuple):\n    kind: str\n    path: str\n    scope: str\n    line: int\n    fingerprint: str\n\n    @property\n    def key(self) -> str:\n        return f\"{self.path}::{self.scope}::{self.fingerprint}\"\n\n\ndef _nodes(scope: ast.AST) -> Iterable[ast.AST]:\n    \"\"\"Walk this scope only; a sibling's assertions cannot discharge its debt.\"\"\"\n    yield scope\n    for child in ast.iter_child_nodes(scope):\n        if not isinstance(child, SCOPE_TYPES):\n            yield from _nodes(child)\n\n\ndef _scopes(tree: ast.AST, prefix: str = \"<module>\") -> Iterable[tuple]:\n    yield prefix, tree\n    for node in _nodes(tree):\n        for child in ast.iter_child_nodes(node):\n            if isinstance(child, SCOPE_TYPES):\n                yield from _scopes(child, f\"{prefix}.{child.name}\")\n\n\ndef _imports(nodes: Iterable[ast.AST], inherited: dict) -> dict:\n    result = dict(inherited)\n    for node in nodes:\n        if isinstance(node, ast.Import):\n            for alias in node.names:\n                result[alias.asname or alias.name] = alias.name\n        elif isinstance(node, ast.ImportFrom):\n            for alias in node.names:\n                result[alias.asname or alias.name] = f\"{node.module}.{alias.name}\"\n    return result\n\n\ndef _name(node: ast.AST, aliases: dict) -> str:\n    if isinstance(node, ast.Name):\n        return aliases.get(node.id, node.id)\n    if isinstance(node, ast.Attribute):\n        return f\"{_name(node.value, aliases)}.{node.attr}\"\n    return \"\"\n\n\ndef _assignments(nodes: list) -> list:\n    result = []\n    for node in nodes:\n        if isinstance(node, ast.Assign):\n            targets = node.targets\n        elif isinstance(node, ast.AnnAssign):\n            targets = [node.target]\n        else:\n            continue\n        for target in targets:\n            if isinstance(target, (ast.Name, ast.Attribute)):\n                result.append((target, node.value, node.lineno))\n    return result\n\n\ndef _python_command(node: Optional[ast.AST], aliases: dict, assignments: list, seen: tuple = ()) -> bool:\n    if node is None:\n        return False\n    for part in ast.walk(node):\n        if _name(part, aliases) == \"sys.executable\":\n            return True\n        if isinstance(part, ast.Name) and part.id not in seen:\n            candidates = [\n                (value, line) for target, value, line in assignments\n                if isinstance(target, ast.Name) and target.id == part.id and line < part.lineno\n            ]\n            if candidates:\n                value, _ = max(candidates, key=lambda item: item[1])\n                if _python_command(value, aliases, assignments, seen + (part.id,)):\n                    return True\n    return False\n\n\ndef _result_name(call: ast.Call, parents: dict, aliases: dict) -> str:\n    parent = parents.get(call)\n    if isinstance(parent, ast.Assign) and len(parent.targets) == 1:\n        return _name(parent.targets[0], aliases)\n    if isinstance(parent, ast.AnnAssign):\n        return _name(parent.target, aliases)\n    if isinstance(parent, ast.withitem) and parent.optional_vars is not None:\n        return _name(parent.optional_vars, aliases)\n    return \"\"\n\n\ndef _assertions(nodes: list) -> Iterable[ast.AST]:\n    for node in nodes:\n        if isinstance(node, ast.Assert):\n            yield node.test\n        elif isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):\n            if node.func.attr.startswith(\"assert\"):\n                for arg in node.args:\n                    yield arg\n\n\ndef _checks_rc(call: ast.Call, nodes: list, parents: dict, aliases: dict, assignments: list) -> bool:\n    result = _result_name(call, parents, aliases)\n    reassigned = [\n        line for target, _, line in assignments\n        if result and _name(target, aliases) == result and line > call.lineno\n    ]\n    end = min(reassigned, default=float(\"inf\"))\n    for assertion in _assertions(nodes):\n        for part in ast.walk(assertion):\n            if not isinstance(part, ast.Attribute) or part.attr != \"returncode\":\n                continue\n            if part.value is call:\n                return True\n            if result and call.lineno <= part.lineno < end and _name(part.value, aliases) == result:\n                return True\n    return False\n\n\ndef _classify(call: ast.Call, nodes: list, parents: dict, aliases: dict, assignments: list) -> list:\n    name = _name(call.func, aliases)\n    subprocess_call = name in (\"subprocess.run\", \"subprocess.Popen\")\n    kinds = []\n    if subprocess_call:\n        command = call.args[0] if call.args else next((k.value for k in call.keywords if k.arg == \"args\"), None)\n        if _python_command(command, aliases, assignments) and not _checks_rc(call, nodes, parents, aliases, assignments):\n            kinds.append(\"python-rc\")\n    communicate = isinstance(call.func, ast.Attribute) and call.func.attr == \"communicate\"\n    timeout = any(k.arg == \"timeout\" for k in call.keywords) or (communicate and len(call.args) >= 2)\n    if timeout and (subprocess_call or communicate):\n        kinds.append(\"timeout-group\")\n    return kinds\n\n\ndef scan_source(source: str, path: str = \"test_example.py\") -> List[Finding]:\n    tree = ast.parse(source, filename=path)\n    parents = {child: node for node in ast.walk(tree) for child in ast.iter_child_nodes(node)}\n    module_aliases = _imports(_nodes(tree), {})\n    findings = []\n    for scope, body in _scopes(tree):\n        nodes = list(_nodes(body))\n        aliases = _imports(nodes, module_aliases)\n        assignments = _assignments(nodes)\n        occurrences: Dict[str, int] = {}\n        for call in (n for n in nodes if isinstance(n, ast.Call)):\n            kinds = _classify(call, nodes, parents, aliases, assignments)\n            if not kinds:\n                continue\n            digest = call_digest(call)\n            occurrences[digest] = occurrences.get(digest, 0) + 1\n            fingerprint = f\"{digest}:{occurrences[digest]}\"\n            for kind in kinds:\n                findings.append(Finding(kind, path, scope, call.lineno, fingerprint))\n    return findings\n\n\ndef _walk_error(error: OSError) -> None:\n    raise error\n\n\ndef scan_tree(root: Path) -> List[Finding]:\n    result = []\n    for relative in TEST_ROOTS:\n        start = root / relative\n        if not start.exists():\n            continue\n        for directory, folders, names in os.walk(start, onerror=_walk_error):\n            folders[:] = sorted(name for name in folders if name != \"__pycache__\")\n            for name in sorted(names):\n                if not name.endswith(\".py\"):\n                    continue\n                path = Path(directory) / name\n                relative_path = path.relative_to(root).as_posix()\n                # Only the implementation that owns session creation and\n                # cleanup is exempt. Imported test helpers remain in scope.\n                if relative_path == GROUP_HELPER:\n                    continue\n                if path.is_symlink():\n                    raise ValueError(f\"symlink test source: {path.relative_to(root)}\")\n                result.extend(scan_source(path.read_text(encoding=\"utf-8\"), relative_path))\n    return sorted(result)\n\n\ndef baseline_rows(findings: Iterable[Finding]) -> dict:\n    \"\"\"Group by source file; row keys survive line-only edits, not new calls.\"\"\"\n    rows: Dict[str, dict] = {kind: {} for kind in KINDS}\n    for finding in findings:\n        rows[finding.kind].setdefault(finding.path, []).append(f\"{finding.scope}::{finding.fingerprint}\")\n    return rows\n\n\ndef new_findings(findings: Iterable[Finding], baseline: dict) -> List[Finding]:\n    return [\n        finding for finding in findings\n        if f\"{finding.scope}::{finding.fingerprint}\" not in baseline.get(finding.kind, {}).get(finding.path, [])\n    ]\n\n\ndef load_baseline(path: Path) -> dict:\n    baseline = json.loads(path.read_text(encoding=\"utf-8\"))\n    if not isinstance(baseline, dict) or set(baseline) != set(KINDS):\n        raise ValueError(\"baseline must contain both census kinds\")\n    for paths in baseline.values():\n        if not isinstance(paths, dict):\n            raise ValueError(\"baseline kind must map paths to site lists\")\n        for sites in paths.values():\n            if not isinstance(sites, list) or any(not isinstance(site, str) for site in sites):\n                raise ValueError(\"baseline sites must be strings\")\n    return baseline\n","numLines":251,"startLine":1,"totalLines":251}},"tool_result_meta":[{"id":"toolu_01QWACeXyZNEaWQs6jvycVXi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
