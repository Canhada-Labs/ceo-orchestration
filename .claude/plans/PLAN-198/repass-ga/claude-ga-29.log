{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3d8qjvd9ESZVZppAQqyEx","type":"tool_result","content":"1\t\"\"\"Bind split installer-census components to the legacy module namespace.\"\"\"\n2\tfrom __future__ import annotations\n3\tfrom copy import deepcopy\n4\tfrom types import FunctionType\n5\tfrom . import commands, engine, model, operands, report, syntax, verdicts_a, verdicts_b\n6\t\n7\t\n8\tdef _bind_function(original, namespace):\n9\t    bound = FunctionType(original.__code__, namespace, original.__name__, original.__defaults__, original.__closure__)\n10\t    bound.__kwdefaults__ = original.__kwdefaults__\n11\t    bound.__annotations__ = original.__annotations__.copy()\n12\t    bound.__dict__.update(original.__dict__)\n13\t    bound.__doc__ = original.__doc__\n14\t    bound.__qualname__ = original.__qualname__\n15\t    bound.__module__ = namespace[\"__name__\"]\n16\t    return bound\n17\t\n18\t\n19\tdef _bind_class(original, namespace):\n20\t    if not getattr(original, \"__module__\", \"\").startswith(\n21\t        (\"_installer_write_safety\", \"_lib._installer_write_safety\")\n22\t    ):\n23\t        return original\n24\t    attrs = dict(vars(original))\n25\t    attrs.pop(\"__dict__\", None)\n26\t    attrs.pop(\"__weakref__\", None)\n27\t    for slot in attrs.get(\"__slots__\", ()):\n28\t        attrs.pop(slot, None)\n29\t    for name, member in list(attrs.items()):\n30\t        if isinstance(member, FunctionType):\n31\t            attrs[name] = _bind_function(member, namespace)\n32\t        elif isinstance(member, staticmethod):\n33\t            attrs[name] = staticmethod(_bind_function(member.__func__, namespace))\n34\t        elif isinstance(member, classmethod):\n35\t            attrs[name] = classmethod(_bind_function(member.__func__, namespace))\n36\t    clone = type(original)(original.__name__, original.__bases__, attrs)\n37\t    clone.__module__ = namespace[\"__name__\"]\n38\t    clone.__qualname__ = original.__qualname__