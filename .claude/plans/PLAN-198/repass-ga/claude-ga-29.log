y is None:\n544\t            return None\n545\t        try:\n546\t            live = hashlib.sha256((repo / rel).read_bytes()).hexdigest()\n547\t        except OSError:\n548\t            return None\n549\t        if entry[1].strip(\"'\") != live:\n550\t            changed.append(rel)\n551\t    if not changed:\n552\t        return None\n553\t    return \"{} changed after the pack was generated (its {} no longer match)\".format(\n554\t        \" and \".join(changed), \"BASE_*_SHA256\" if len(changed) > 1 else \"BASE_* sha256\")\n555\t\n556\t\n557\tdef _codex_installed_findings(repo: Path, pin: Dict[str, Any],\n558\t                              installed: str) -> List[Dict[str, Any]]:\n559\t    pinned = pin[\"package_version\"]\n560\t    clauses = parse_range(pin[\"range\"]) if pin.get(\"range\") else None\n561\t    range_note = \"\"\n562\t    if clauses is not None:\n563\t        range_note = \" (pre-flight range {}: {})\".format(\n564\t            pin[\"range\"], \"inside\" if in_range(installed, clauses) else \"OUTSIDE\")\n565\t    if installed == pinned:\n566\t        if clauses is not None and not in_range(pinned, clauses):\n567\t            return [_finding(\"codex\", \"CODEX_PIN_PACK_INCOHERENT\", \"drift\",\n568\t                             \"manifest pins {} but codex-cli-pin.txt range {} excludes it\".format(\n569\t                                 pinned, pin[\"range\"]), repin_next(repo, pinned))]\n570\t        return []\n571\t    if (clauses is not None and len(clauses) == 1 and clauses[0][0] == \">=\"\n572\t            and _RELEASE_RE.match(installed) and in_range(installed, clauses)):\n573\t        return [_finding(\n574\t            \"codex\", \"CODEX_INSTALLED_COMPATIBLE\", \"info\",\n575\t            \"installed codex {} meets the unbounded semantic floor {} — version \"\n576\t            \"compatibility only; the payload hash is verified separately\".format(\n577\t                installed, pin[\"range\"]),\n578\t            [], {\"installed\": installed, \"floor\": pin[\"range\"]})]\n579\t    ikey, pkey = semver_key(installed), semver_key(pinned)\n580\t    claim = (\"installed codex {} is not the pinned {}{} — the payload sha256 will not \"\n581\t             \"match the manifest, so the pair-rail fails CLOSED at the next L3+ call\"\n582\t             ).format(installed, pinned, range_note)\n583\t    if (ikey is not None and pkey is not None and ikey < pkey) or not _RELEASE_RE.match(installed):\n584\t        # Older than the pin, or a prerelease (never re-pinned): restore.\n585\t        nxt = [\"npm i -g {}@{}   # Owner-run: restore the pinned binary\".format(\n586\t            _NPM_PACKAGE, pinned),\n587\t            \"python3 .claude/hooks/check_pair_rail.py --verify-codex-pin\"]\n588\t    else:\n589\t        nxt = repin_next(repo, installed) + [\n590\t            \"or restore the pinned binary (Owner-run): npm i -g {}@{}\".format(\n591\t                _NPM_PACKAGE, pinned)]\n592\t    return [_finding(\"codex\", \"CODEX_INSTALLED_NOT_PINNED\", \"drift\", claim, nxt,\n593\t                     {\"installed\": installed, \"pinned\": pinned})]\n594\t\n595\t\n596\t# --------------------------------------------------------------------------\n597\t# npm dist-tags cache (the ONLY network path; opt-in)\n598\t# --------------------------------------------------------------------------\n599\t\n600\tdef default_cache_path(repo: Path, project: Optional[str]) -> Optional[Path]:\n601\t    \"\"\"Cache under the project runtime state dir — the single resolver.\n602\t\n603\t    ``project`` None keeps the resolver's own precedence (CLAUDE_PROJECT_DIR,\n604\t    else cwd); an explicit --repo-root is passed AS GIVEN (no realpath: the\n605\t    harness slugs the launch path as given — runtime_paths \"symlink honesty\").\n606\t    \"\"\"\n607\t    hooks = repo / \".claude\" / \"hooks\"\n608\t    candidates = [hooks, SCRIPT_DIR.parent / \"hooks\"]\n609\t    for cand in candidates:\n610\t        if (cand / \"_lib\" / \"runtime_paths.py\").is_file():\n611\t            if str(cand) not in sys.path:\n612\t                sys.path.insert(0, str(cand))\n613\t            break\n614\t    try:\n615\t        from _lib import runtime_paths as _rp  # noqa: E402\n616\t    except Exception:  # noqa: BLE001 — infra fail-open\n617\t        return None\n618\t    return _rp.runtime_state_dir(project=project) / _CACHE_SUBDIR / _CACHE_NAME\n619\t\n620\t\n621\tdef validate_dist_tags(obj: Any) -> Optional[Dict[str, str]]:\n622\t    \"\"\"Untrusted data: keep only tag -> strict-semver pairs (first 256).\n623\t\n624\t    Entries of any other shape are DROPPED, never echoed; the result is None\n625\t    (unusable) unless a strict-semver ``latest`` survives — the one tag the\n626\t    upstream check reads.\n627\t    \"\"\"\n628\t    if not isinstance(obj, dict):\n629\t        return None\n630\t    tags: Dict[str, str] = {}\n631\t    for key, val in list(obj.items())[:256]:\n632\t        if isinstance(key, str) and _TAG_KEY_RE.match(key) and \\\n633\t                isinstance(val, str) and _SEMVER_FULL_RE.match(val):\n634\t            tags[key] = val\n635\t    return tags if \"latest\" in tags else None\n636\t\n637\t\n638\tdef _atomic_write_json(path: Path, payload: Dict[str, Any]) -> None:\n639\t    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n640\t    fd, tmp = tempfile.mkstemp(prefix=\".tmp-\", dir=str(path.parent))\n641\t    try:\n642\t        with os.fdopen(fd, \"w\", encoding=\"utf-8\") as fh:\n643\t            json.dump(payload, fh, indent=2, sort_keys=True)\n644\t            fh.write(\"\\n\")\n645\t        os.replace(tmp, str(path))\n646\t    except BaseException:\n647\t        try:\n648\t            os.unlink(tmp)\n649\t        except OSError:"}]},"parent_tool_use_id":null,"session_id":"e9f21750-77cd-44a8-9a48-5376b7294476","uuid":"cfe5d254-dd0a-407b-86f3-34ef253113b3","timestamp":"2026-11-16T19:59:33.303Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s