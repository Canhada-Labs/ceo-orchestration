{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QyophQ4GQWxTpo4r6pshQ3","type":"tool_result","content":"1\t\"\"\"Stable semantic-version policy for locally resolved CLI packages.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport json\n6\timport re\n7\tfrom pathlib import Path\n8\tfrom typing import Iterable, Optional, Tuple\n9\t\n10\t\n11\tCODEX_VERSION_FLOOR = \"0.160.0\"\n12\t_SEMVER_RE = re.compile(r\"^v?([0-9]+)\\.([0-9]+)\\.([0-9]+)$\")\n13\t\n14\t\n15\tdef parse_semver(value: object) -> Optional[Tuple[int, int, int]]:\n16\t    \"\"\"Parse a stable ``major.minor.patch`` version; reject prereleases.\"\"\"\n17\t    if not isinstance(value, str):\n18\t        return None\n19\t    match = _SEMVER_RE.fullmatch(value.strip())\n20\t    if match is None:\n21\t        return None\n22\t    return tuple(int(part) for part in match.groups())\n23\t\n24\t\n25\tdef compare_semver(candidate: object, floor: object) -> Optional[int]:\n26\t    \"\"\"Compare stable versions: positive when candidate is newer, else None.\"\"\"\n27\t    parsed_candidate = parse_semver(candidate)\n28\t    parsed_floor = parse_semver(floor)\n29\t    if parsed_candidate is None or parsed_floor is None:\n30\t        return None\n31\t    return (parsed_candidate > parsed_floor) - (parsed_candidate < parsed_floor)\n32\t\n33\t\n34\tdef compatible_package_version(\n35\t    payload: Path, launcher: Optional[Path], manifest_version: object = None,\n36\t    floor: str = CODEX_VERSION_FLOOR,\n37\t) -> Optional[str]:\n38\t    \"\"\"Return a qualified stable version meeting floor and optional manifest.\n39\t\n40\t    This is currency evidence only: callers must not describe it as a hash\n41\t    attestation of the executable bytes.\n42\t    \"\"\"\n43\t    for package_file in _package_files((payload, launcher)):\n44\t        version = _qualified_package_version(package_file)\n45\t        comparison = compare_semver(version, floor)\n46\t        manifest_comparison = (\n47\t            1 if manifest_version is None else compare_semver(version, manifest_version)\n48\t        )\n49\t        if comparison is not None and comparison >= 0 and manifest_comparison is not None and manifest_comparison > 0:\n50\t            return version\n51\t    return None\n52\t\n53\t\n54\tdef qualified_package_version(payload: Path, launcher: Optional[Path]) -> Optional[str]:\n55\t    \"\"\"Return stable version from a nearby qualified package, if present.\"\"\"\n56\t    for package_file in _package_files((payload, launcher)):\n57\t        version = _qualified_package_version(package_file)\n58\t        if version is not None:\n59\t            return version\n60\t    return None\n61\t\n62\t\n63\tdef _package_files(paths: Iterable[Optional[Path]]) -> Iterable[Path]:\n64\t    seen = set()\n65\t    for path in paths:\n66\t        if path is None:\n67\t            continue\n68\t        try:\n69\t            path = path.resolve()\n70\t        except OSError:\n71\t            pass\n72\t        for parent in (path.parent, *path.parents):\n73\t            package_file = parent / \"package.json\"\n74\t            if package_file not in seen:\n75\t                seen.add(package_file)\n76\t                yield package_file\n77\t\n78\t\n79\tdef _qualified_package_version(package_file: Path) -> Optional[str]:\n80\t    try:\n81\t        data = json.loads(package_file.read_text(encoding=\"utf-8\"))\n82\t    except (OSError, ValueError, RecursionError):\n83\t        return None\n84\t    if not isinstance(data, dict) or data.get(\"name\") != \"@openai/codex\":\n85\t        return None\n86\t    version = data.get(\"version\")\n87\t    return version if parse_semver(version) is not None else None\n88\t"}]},"parent_tool_use_id":null,"session_id":"e9f21750-77cd-44a8-9a48-5376b7294476","uuid":"741df2f8-aedd-4f8c-bfb4-b3eaae1fc2b5","timestamp":"2026-11-16T20:00:04.961Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/cli_currency.py","content":"\"\"\"Stable semantic-version policy for locally resolved CLI packages.\"\"\"\n\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom pathlib import Path\nfrom typing import Iterable, Optional, Tuple\n\n\nCODEX_VERSION_FLOOR = \"0.160.0\"\n_SEMVER_RE = re.compile(r\"^v?([0-9]+)\\.([0-9]+)\\.([0-9]+)$\")\n\n\ndef parse_semver(value: object) -> Optional[Tuple[int, int, int]]:\n    \"\"\"Parse a stable ``major.minor.patch`` version; reject prereleases.\"\"\"\n    if not isinstance(value, str):\n        return None\n    match = _SEMVER_RE.fullmatch(value.strip())\n    if match is None:\n        return None\n    return tuple(int(part) for part in match.groups())\n\n\ndef compare_semver(candidate: object, floor: object) -> Optional[int]:\n    \"\"\"Compare stable versions: positive when candidate is newer, else None.\"\"\"\n    parsed_candidate = parse_semver(candidate)\n    parsed_floor = parse_semver(floor)\n    if parsed_candidate is None or parsed_floor is None:\n        return None\n    return (parsed_candidate > parsed_floor) - (parsed_candidate < parsed_floor)\n\n\ndef compatible_package_version(\n    payload: Path, launcher: Optional[Path], manifest_version: object = None,\n    floor: str = CODEX_VERSION_FLOOR,\n) -> Optional[str]:\n    \"\"\"Return a qualified stable version meeting floor and optional manifest.\n\n    This is currency evidence only: callers must not describe it as a hash\n    attestation of the executable bytes.\n    \"\"\"\n    for package_file in _package_files((payload, launcher)):\n        version = _qualified_package_version(package_file)\n        comparison = compare_semver(version, floor)\n        manifest_comparison = (\n            1 if manifest_version is None else compare_semver(version, manifest_version)\n        )\n        if comparison is not None and comparison >= 0 and manifest_comparison is not None and manifest_comparison > 0:\n            return version\n    return None\n\n\ndef qualified_package_version(payload: Path, launcher: Optional[Path]) -> Optional[str]:\n    \"\"\"Return stable version from a nearby qualified package, if present.\"\"\"\n    for package_file in _package_files((payload, launcher)):\n        version = _qualified_package_version(package_file)\n        if version is not None:\n            return version\n    return None\n\n\ndef _package_files(paths: Iterable[Optional[Path]]) -> Iterable[Path]:\n    seen = set()\n    for path in paths:\n        if path is None:\n            continue\n        try:\n            path = path.resolve()\n        except OSError:\n            pass\n        for parent in (path.parent, *path.parents):\n            package_file = parent / \"package.json\"\n            if package_file not in seen:\n                seen.add(package_file)\n                yield package_file\n\n\ndef _qualified_package_version(package_file: Path) -> Optional[str]:\n    try:\n        data = json.loads(package_file.read_text(encoding=\"utf-8\"))\n    except (OSError, ValueError, RecursionError):\n        return None\n    if not isinstance(data, dict) or data.get(\"name\") != \"@openai/codex\":\n        return None\n    version = data.get(\"version\")\n    return version if parse_semver(version) is not None else None\n","numLines":88,"startLine":1,"totalLines":88}},"tool_result_meta":[{"id":"toolu_01QyophQ4GQWxTpo4r6pshQ3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
