-def _is_alive_pid(pid: int) -> bool:
-    """Return True if a process with PID is alive in current namespace."""
-    if pid <= 0:
-        return False
-    try:
-        os.kill(pid, 0)
-    except ProcessLookupError:
-        return False
-    except PermissionError:
-        return True
-    except OSError:
-        return False
-    return True
