{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NotW7dYHuiqSTezDzrriJ3","type":"tool_result","content":"740\t    \"\"\"Pure decision function. Returns (decision, side-effect-spec).\n741\t\n742\t    The side-effect-spec is either None (no emits) or a dict describing\n743\t    which audit event to write:\n744\t\n745\t        {\"emit\": \"budget_exceeded\", \"plan_id\": ..., \"tokens_used\": ...,\n746\t         \"cap\": ..., \"scope\": \"plan\", \"cap_source\": ...}\n747\t        {\"emit\": \"budget_bypass_used\", \"plan_id\": ..., \"caller_pid\": ...}\n748\t        {\"emit\": \"rate_limit_exceeded\", ...}  (breadcrumb-only, no audit)\n749\t\n750\t    In Sprint 11 (State 0) the Decision is ALWAYS allow regardless.\n751\t    This isolates the advisory vs. enforcing concern to a single line\n752\t    when Sprint 12 flips the contract.\n753\t\n754\t    Args:\n755\t        cap_source: provenance of the resolved cap. Forwarded into the\n756\t            ``budget_exceeded`` effect dict so audit-tokens can attribute\n757\t            caps to plan / env / default per PLAN-065 §4.5.D.\n758\t    \"\"\"\n759\t    # No active plan — skip the check entirely.\n760\t    if not plan_id:\n761\t        return (_contract.allow(), None)\n762\t\n763\t    # Bypass short-circuit — still obeys rate limit.\n764\t    if bypass_requested and spend_basis != \"plan\":\n765\t        # Codex r13 P2: with >=2 active plans the tie-break plan_id is an\n766\t        # arbitrary attribution target — a plan-scoped budget_bypass_used\n767\t        # event AND its per-plan 24h quota would both be misattributed\n768\t        # (spawn rows carry no plan_id yet). Advisory State 0: allow with\n769\t        # a declared-basis message + forensic breadcrumb; the per-plan\n770\t        # quota is NOT consumed (it belongs to no provable plan).\n771\t        return (\n772\t            _contract.allow(\n773\t                system_message=(\n774\t                    f\"BUDGET BYPASS (multi-plan state) noted for selected \"\n775\t                    f\"plan {plan_id}. Spend basis: PROJECT-WIDE — no \"\n776\t                    \"plan-scope bypass event emitted; per-plan quota not \"\n777\t                    \"consumed (attribution pending the producer cure).\"\n778\t                )\n779\t            ),\n780\t            {\n781\t                \"emit\": \"breadcrumb_only\",\n782\t                \"message\": (\n783\t                    f\"multi-plan budget bypass: CEO_BUDGET_BYPASS=1 with \"\n784\t                    f\">=2 active plans (tie-break selection {plan_id}); \"\n785\t                    \"no plan-scope budget_bypass_used event emitted\"\n786\t                ),\n787\t            },\n788\t        )\n789\t    if bypass_requested:\n790\t        if recent_bypass_count >= bypass_max_per_day:\n791\t            # Rate-limit exhausted. State 0 still allows but writes a\n792\t            # breadcrumb instead of emitting a bypass_used event (H13:\n793\t            # honest accounting of over-quota attempts).\n794\t            return (\n795\t                _contract.allow(\n796\t                    system_message=(\n797\t                        f\"BUDGET BYPASS RATE LIMIT EXCEEDED: {recent_bypass_count}\"\n798\t                        f\"/{bypass_max_per_day} in the last 24h for plan \"\n799\t                        f\"{plan_id}. Advisory-only (Sprint 11).\"\n800\t                    )\n801\t                ),\n802\t                {\"emit\": \"rate_limit_exceeded\", \"plan_id\": plan_id},\n803\t            )\n804\t        return (\n805\t            _contract.allow(\n806\t                system_message=(\n807\t                    f\"BUDGET BYPASS USED for plan {plan_id} \"\n808\t                    f\"({recent_bypass_count + 1}/{bypass_max_per_day} in 24h).\"\n809\t                )\n810\t            ),\n811\t            {\n812\t                \"emit\": \"budget_bypass_used\",\n813\t                \"plan_id\": plan_id,\n814\t                \"caller_pid\": caller_pid,\n815\t                \"session_id\": session_id,\n816\t                \"project\": project,\n817\t            },\n818\t        )\n819\t\n820\t    # Under cap — quiet allow.\n821\t    if tokens_used <= max_plan_tokens:\n822\t        return (_contract.allow(), None)\n823\t\n824\t    # Over cap — emit event + WARNING systemMessage, always allow (State 0).\n825\t    pct = int((tokens_used / max_plan_tokens) * 100) if max_plan_tokens else 0\n826\t    # PLAN-135 W5 O4 — enrich (never gate) the warning with the LIVE rate-limit\n827\t    # buckets from the statusLine sidecar. Fail-soft: \"\" when unavailable.\n828\t    quota_hint = _statusline_quota_hint()\n829\t    basis_note = (\n830\t        \" Spend basis: PROJECT-WIDE (multi-plan state; agent_spawn rows \"\n831\t        \"carry no plan_id yet — per-plan attribution lands with the \"\n832\t        \"producer cure, PLAN-178 record).\" if spend_basis == \"project-wide\"\n833\t        else \"\"\n834\t    )\n835\t    warning = (\n836\t        f\"BUDGET WARNING: plan {plan_id} at {tokens_used}/{max_plan_tokens} tokens \"\n837\t        f\"({pct}%).{basis_note} Advisory-only (Sprint 11). Set \"\n838\t        f\"CEO_BUDGET_BYPASS=1 to suppress this warning for urgent work. \"\n839\t        f\"See ADR-033.{quota_hint}\""}]},"parent_tool_use_id":null,"session_id":"9956911d-51f2-4fa8-b7dc-31e1ce72a226","uuid":"fc1eec60-41a8-4a3f-87d8-2974364bfe73","timestamp":"2026-11-16T18:54:10.069Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_budget.py","content":"    \"\"\"Pure decision function. Returns (decision, side-effect-spec).\n\n    The side-effect-spec is either None (no emits) or a dict describing\n    which audit event to write:\n\n        {\"emit\": \"budget_exceeded\", \"plan_id\": ..., \"tokens_used\": ...,\n         \"cap\": ..., \"scope\": \"plan\", \"cap_source\": ...}\n        {\"emit\": \"budget_bypass_used\", \"plan_id\": ..., \"caller_pid\": ...}\n        {\"emit\": \"rate_limit_exceeded\", ...}  (breadcrumb-only, no audit)\n\n    In Sprint 11 (State 0) the Decision is ALWAYS allow regardless.\n    This isolates the advisory vs. enforcing concern to a single line\n    when Sprint 12 flips the contract.\n\n    Args:\n        cap_source: provenance of the resolved cap. Forwarded into the\n            ``budget_exceeded`` effect dict so audit-tokens can attribute\n            caps to plan / env / default per PLAN-065 §4.5.D.\n    \"\"\"\n    # No active plan — skip the check entirely.\n    if not plan_id:\n        return (_contract.allow(), None)\n\n    # Bypass short-circuit — still obeys rate limit.\n    if bypass_requested and spend_basis != \"plan\":\n        # Codex r13 P2: with >=2 active plans the tie-break plan_id is an\n        # arbitrary attribution target — a plan-scoped budget_bypass_used\n        # event AND its per-plan 24h quota would both be misattributed\n        # (spawn rows carry no plan_id yet). Advisory State 0: allow with\n        # a declared-basis message + forensic breadcrumb; the per-plan\n        # quota is NOT consumed (it belongs to no provable plan).\n        return (\n            _contract.allow(\n                system_message=(\n                    f\"BUDGET BYPASS (multi-plan state) noted for selected \"\n                    f\"plan {plan_id}. Spend basis: PROJECT-WIDE — no \"\n                    \"plan-scope bypass event emitted; per-plan quota not \"\n                    \"consumed (attribution pending the producer cure).\"\n                )\n            ),\n            {\n                \"emit\": \"breadcrumb_only\",\n                \"message\": (\n                    f\"multi-plan budget bypass: CEO_BUDGET_BYPASS=1 with \"\n                    f\">=2 active plans (tie-break selection {plan_id}); \"\n                    \"no plan-scope budget_bypass_used event emitted\"\n                ),\n            },\n        )\n    if bypass_requested:\n        if recent_bypass_count >= bypass_max_per_day:\n            # Rate-limit exhausted. State 0 still allows but writes a\n            # breadcrumb instead of emitting a bypass_used event (H13:\n            # honest accounting of over-quota attempts).\n            return (\n                _contract.allow(\n                    system_message=(\n                        f\"BUDGET BYPASS RATE LIMIT EXCEEDED: {recent_bypass_count}\"\n                        f\"/{bypass_max_per_day} in the last 24h for plan \"\n                        f\"{plan_id}. Advisory-only (Sprint 11).\"\n                    )\n                ),\n                {\"emit\": \"rate_limit_exceeded\", \"plan_id\": plan_id},\n            )\n        return (\n            _contract.allow(\n                system_message=(\n                    f\"BUDGET BYPASS USED for plan {plan_id} \"\n                    f\"({recent_bypass_count + 1}/{bypass_max_per_day} in 24h).\"\n                )\n            ),\n            {\n                \"emit\": \"budget_bypass_used\",\n                \"plan_id\": plan_id,\n                \"caller_pid\": caller_pid,\n                \"session_id\": session_id,\n                \"project\": project,\n            },\n        )\n\n    # Under cap — quiet allow.\n    if tokens_used <= max_plan_tokens:\n        return (_contract.allow(), None)\n\n    # Over cap — emit event + WARNING systemMessage, always allow (State 0).\n    pct = int((tokens_used / max_plan_tokens) * 100) if max_plan_tokens else 0\n    # PLAN-135 W5 O4 — enrich (never gate) the warning with the LIVE rate-limit\n    # buckets from the statusLine sidecar. Fail-soft: \"\" when unavailable.\n    quota_hint = _statusline_quota_hint()\n    basis_note = (\n        \" Spend basis: PROJECT-WIDE (multi-plan state; agent_spawn rows \"\n        \"carry no plan_id yet — per-plan attribution lands with the \"\n        \"producer cure, PLAN-178 record).\" if spend_basis == \"project-wide\"\n        else \"\"\n    )\n    warning = (\n        f\"BUDGET WARNING: plan {plan_id} at {tokens_used}/{max_plan_tokens} tokens \"\n        f\"({pct}%).{basis_note} Advisory-only (Sprint 11). Set \"\n        f\"CEO_BUDGET_BYPASS=1 to suppress this warning for urgent work. \"\n        f\"See ADR-033.{quota_hint}\"","numLines":100,"startLine":740,"totalLines":1080}},"tool_result_meta":[{"id":"toolu_01NotW7dYHuiqSTezDzrriJ3","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
