\n2224\t-    P1-2: flushes the journal buffer for our PID so begin/commit envelopes\n2225\t-    survive signal-driven termination.\n2226\t-\n2227\t-    P2-5: if the previous handler was signal.SIG_IGN, preserve it (the\n2228\t-    user explicitly ignored this signal; default termination would be a\n2229\t-    behavior change). atexit does NOT run after default signal termination\n2230\t-    so our drain call here IS the final flush opportunity for SIG_DFL paths.\n2231\t-    \"\"\"\n2232\t-    if _IN_SPOOL_APPEND:\n2233\t-        # Writer in progress; bail rather than deadlock against ourself.\n2234\t-        _breadcrumb(f\"signal {signum} arrived during spool_append; bail\")\n2235\t-        return\n2236\t-    try:\n2237\t-        drain_now(force=True)\n2238\t-    except Exception:\n2239\t-        pass\n2240\t-    try:\n2241\t-        _flush_journal_buffer(os.getpid())\n2242\t-    except Exception:\n2243\t-        pass\n2244\t-    # Resolve the previous handler.\n2245\t-    if signum == signal.SIGTERM:\n2246\t-        prev = _PREV_SIGTERM_HANDLER\n2247\t-    elif signum == signal.SIGINT:\n2248\t-        prev = _PREV_SIGINT_HANDLER\n2249\t-    else:\n2250\t-        prev = signal.SIG_DFL\n2251\t-\n2252\t-    # P2-5: distinguish SIG_IGN vs SIG_DFL vs callable.\n2253\t-    if prev is signal.SIG_IGN:\n2254\t-        # Restore IGN and do NOT re-raise — the user wanted this signal\n2255\t-        # ignored; honoring that is correctness, not failure.\n2256\t-        try:\n2257\t-            signal.signal(signum, signal.SIG_IGN)\n2258\t-        except (ValueError, OSError):  # pragma: no cover\n2259\t-            pass\n2260\t-        return\n2261\t-    if callable(prev):\n2262\t-        # Chain to user handler.\n2263\t-        try:\n2264\t-            signal.signal(signum, prev)\n2265\t-        except (ValueError, OSError):  # pragma: no cover\n2266\t-            pass\n2267\t-        try:\n2268\t-            prev(signum, frame)\n2269\t-        except Exception:  # pragma: no cover\n2270\t-            pass\n2271\t-        return\n2272\t-    # Default: restore SIG_DFL and re-raise. atexit does NOT run after\n2273\t-    # default-signal termination → the drain_now(force=True) above is the\n2274\t-    # final flush opportunity.\n2275\t-    try:\n2276\t-        signal.signal(signum, signal.SIG_DFL)\n2277\t-    except (ValueError, OSError):  # pragma: no cover\n2278\t-        pass\n2279\t-    try:\n2280\t-        os.kill(os.getpid(), signum)\n2281\t-    except OSError:  # pragma: no cover\n2282\t-        pass\n2283\t-\n2284\t-\n2285\t-def install_exit_handlers() -> None:\n2286\t-    \"\"\"Register atexit + SIGTERM/SIGINT drain handlers (idempotent one-shot).\"\"\"\n2287\t-    global _EXIT_HANDLER_INSTALLED\n2288\t-    global _PREV_SIGTERM_HANDLER, _PREV_SIGINT_HANDLER\n2289\t-    if _EXIT_HANDLER_INSTALLED:\n2290\t-        return\n2291\t-    try:\n2292\t-        atexit.register(_atexit_drain)\n2293\t-    except Exception as e:  # pragma: no cover\n2294\t-        _breadcrumb(f\"atexit register failed: {type(e).__name__}: {e}\")\n2295\t-    try:\n2296\t-        _PREV_SIGTERM_HANDLER = signal.signal(\n2297\t-            signal.SIGTERM, _signal_drain_handler,\n2298\t-        )\n2299\t-    except (ValueError, OSError) as e:\n2300\t-        # Signal handlers only work on main thread; in worker threads\n2301\t-        # signal.signal raises ValueError. Fail-open.\n2302\t-        _breadcrumb(f\"SIGTERM install skipped: {type(e).__name__}: {e}\")\n2303\t-    try:\n2304\t-        _PREV_SIGINT_HANDLER = signal.signal(\n2305\t-            signal.SIGINT, _signal_drain_handler,\n2306\t-        )\n2307\t-    except (ValueError, OSError) as e:\n2308\t-        _breadcrumb(f\"SIGINT install skipped: {type(e).__name__}: {e}\")\n2309\t-    _EXIT_HANDLER_INSTALLED = True\n2310\t-\n2311\t-\n2312\t-# ---------------------------------------------------------------------------\n2313\t-# Test helpers (NOT public API — prefixed _; harness uses these)\n2314\t-# --------