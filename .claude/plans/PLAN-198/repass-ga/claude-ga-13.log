{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GNctbFv9rPx7jqjmCLuY48","type":"tool_result","content":"560\t\n561\t\n562\tdef _plan_tokens_total(\n563\t    plan_id: str,\n564\t    *,\n565\t    project_dir: str,\n566\t    strict_attribution: bool = False,\n567\t) -> Tuple[int, int]:\n568\t    \"\"\"Return ``(total_tokens, spawn_event_count)`` for the plan.\n569\t\n570\t    Scans audit-log ``agent_spawn`` events. ``tokens_total`` is summed\n571\t    across events whose ``project`` matches ``project_dir``. Null /\n572\t    missing ``tokens_total`` is treated as 0 (ADR-016). Events that do\n573\t    not carry a plan_id field (pre-Sprint-11 shape) are included when\n574\t    ``project`` matches — a slight over-count in exchange for not\n575\t    silently skipping legacy data.\n576\t\n577\t    ``strict_attribution=True`` (PLAN-178 Lote B, codex r9 P2 — the\n578\t    multi-plan companion of the tie-break cure): ONLY events carrying\n579\t    an explicit matching ``plan_id`` count; the legacy project-wide\n580\t    fallback is OFF. With >=2 active plans the fallback would charge\n581\t    the SELECTED plan for every other plan's spend plus prior history —\n582\t    a false budget_exceeded machine. Under-count is the honest\n583\t    direction for an advisory warning.\n584\t\n585\t    Fail-open: any exception returns (0, 0).\n586\t    \"\"\"\n587\t    try:\n588\t        from _lib import audit_emit  # noqa: WPS433 (local import to stay fail-open)\n589\t    except Exception:\n590\t        return (0, 0)\n591\t\n592\t    total = 0\n593\t    count = 0\n594\t    try:\n595\t        for event in audit_emit.iter_events(action_filter=\"agent_spawn\"):\n596\t            try:\n597\t                # Plan scoping: when the event carries an explicit plan_id,\n598\t                # require match. When it doesn't (legacy), fall back to\n599\t                # project match so the rollup still reflects real spend.\n600\t                ev_plan = event.get(\"plan_id\")\n601\t                if isinstance(ev_plan, str) and ev_plan:\n602\t                    if ev_plan != plan_id:\n603\t                        continue\n604\t                elif strict_attribution:\n605\t                    # Multi-plan mode: unattributed rows never charge the\n606\t                    # selected plan (see docstring).\n607\t                    continue\n608\t                else:\n609\t                    ev_project = event.get(\"project\") or \"\"\n610\t                    if project_dir and ev_project != project_dir:\n611\t                        continue\n612\t\n613\t                tokens = event.get(\"tokens_total\")\n614\t                if tokens is None:\n615\t                    continue\n616\t                if isinstance(tokens, bool):\n617\t                    continue\n618\t                if isinstance(tokens, (int, float)) and tokens > 0:\n619\t                    total += int(tokens)\n620\t                    count += 1\n621\t            except Exception:"}]},"parent_tool_use_id":null,"session_id":"9956911d-51f2-4fa8-b7dc-31e1ce72a226","uuid":"02014297-f20e-4891-8d52-a1c7995e03ea","timestamp":"2026-11-16T18:50:47.535Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/check_budget.py","content":"\n\ndef _plan_tokens_total(\n    plan_id: str,\n    *,\n    project_dir: str,\n    strict_attribution: bool = False,\n) -> Tuple[int, int]:\n    \"\"\"Return ``(total_tokens, spawn_event_count)`` for the plan.\n\n    Scans audit-log ``agent_spawn`` events. ``tokens_total`` is summed\n    across events whose ``project`` matches ``project_dir``. Null /\n    missing ``tokens_total`` is treated as 0 (ADR-016). Events that do\n    not carry a plan_id field (pre-Sprint-11 shape) are included when\n    ``project`` matches — a slight over-count in exchange for not\n    silently skipping legacy data.\n\n    ``strict_attribution=True`` (PLAN-178 Lote B, codex r9 P2 — the\n    multi-plan companion of the tie-break cure): ONLY events carrying\n    an explicit matching ``plan_id`` count; the legacy project-wide\n    fallback is OFF. With >=2 active plans the fallback would charge\n    the SELECTED plan for every other plan's spend plus prior history —\n    a false budget_exceeded machine. Under-count is the honest\n    direction for an advisory warning.\n\n    Fail-open: any exception returns (0, 0).\n    \"\"\"\n    try:\n        from _lib import audit_emit  # noqa: WPS433 (local import to stay fail-open)\n    except Exception:\n        return (0, 0)\n\n    total = 0\n    count = 0\n    try:\n        for event in audit_emit.iter_events(action_filter=\"agent_spawn\"):\n            try:\n                # Plan scoping: when the event carries an explicit plan_id,\n                # require match. When it doesn't (legacy), fall back to\n                # project match so the rollup still reflects real spend.\n                ev_plan = event.get(\"plan_id\")\n                if isinstance(ev_plan, str) and ev_plan:\n                    if ev_plan != plan_id:\n                        continue\n                elif strict_attribution:\n                    # Multi-plan mode: unattributed rows never charge the\n                    # selected plan (see docstring).\n                    continue\n                else:\n                    ev_project = event.get(\"project\") or \"\"\n                    if project_dir and ev_project != project_dir:\n                        continue\n\n                tokens = event.get(\"tokens_total\")\n                if tokens is None:\n                    continue\n                if isinstance(tokens, bool):\n                    continue\n                if isinstance(tokens, (int, float)) and tokens > 0:\n                    total += int(tokens)\n                    count += 1\n            except Exception:","numLines":62,"startLine":560,"totalLines":1080}},"tool_result_meta":[{"id":"toolu_01GNctbFv9rPx7jqjmCLuY48","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
