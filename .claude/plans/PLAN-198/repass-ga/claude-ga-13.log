lized, \"%Y-%m-%dT%H:%M:%S%z\"\n                    )\n                except ValueError:\n                    continue\n                delta = now - parsed\n                if 0 <= delta.total_seconds() <= 24 * 3600:\n                    count += 1\n            except Exception:\n                continue","numLines":50,"startLine":620,"totalLines":1080}},"tool_result_meta":[{"id":"toolu_01DDbV18SMuXNrZcYhMRRwx5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
