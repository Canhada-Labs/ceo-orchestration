def _accel_clamp_count(v):
    try:
        n = int(v)
    except (TypeError, ValueError):
        return 0
    return 0 if n < 0 else (99 if n > 99 else n)


def _auto_compact_clamp_pct(v):
    """Coerce to an int percent in [0, 100]; 0 on malformed (never echoes)."""
    try:
        n = int(v)
