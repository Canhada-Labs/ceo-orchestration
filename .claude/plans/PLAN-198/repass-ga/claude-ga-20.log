{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F3y4fd1mRXDp3VyjJJwrhR","type":"tool_result","content":"1\t\"\"\"Bind spool writer declarations to the compatibility facade namespace.\"\"\"\n2\tfrom __future__ import annotations\n3\t\n4\tfrom importlib import import_module\n5\tfrom types import FunctionType\n6\t\n7\t\n8\tdef install(namespace, modules):\n9\t    \"\"\"Publish functions so runtime global lookup observes facade monkeypatches.\"\"\"\n10\t    declarations = {}\n11\t    for name in modules:\n12\t        module = import_module(\"%s.%s\" % (__name__, name))\n13\t        declarations.update({key: getattr(module, key) for key in module.__all__})\n14\t    for name, original in declarations.items():\n15\t        if isinstance(original, FunctionType):\n16\t            bound = FunctionType(\n17\t                original.__code__, namespace, original.__name__,\n18\t                original.__defaults__, original.__closure__,\n19\t            )\n20\t            bound.__kwdefaults__ = original.__kwdefaults__\n21\t            bound.__annotations__ = original.__annotations__\n22\t            bound.__dict__.update(original.__dict__)\n23\t            bound.__qualname__ = original.__qualname__\n24\t            bound.__module__ = namespace[\"__name__\"]\n25\t            namespace[name] = bound\n26\t        else:\n27\t            namespace[name] = original\n28\t"}]},"parent_tool_use_id":null,"session_id":"8cec1f7b-b09b-4991-a20f-6e5dfe5185fb","uuid":"37e76bba-d629-4c03-8757-4db7e527c5ce","timestamp":"2026-11-16T19:09:02.829Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_spool_writer_parts/__init__.py","content":"\"\"\"Bind spool writer declarations to the compatibility facade namespace.\"\"\"\nfrom __future__ import annotations\n\nfrom importlib import import_module\nfrom types import FunctionType\n\n\ndef install(namespace, modules):\n    \"\"\"Publish functions so runtime global lookup observes facade monkeypatches.\"\"\"\n    declarations = {}\n    for name in modules:\n        module = import_module(\"%s.%s\" % (__name__, name))\n        declarations.update({key: getattr(module, key) for key in module.__all__})\n    for name, original in declarations.items():\n        if isinstance(original, FunctionType):\n            bound = FunctionType(\n                original.__code__, namespace, original.__name__,\n                original.__defaults__, original.__closure__,\n            )\n            bound.__kwdefaults__ = original.__kwdefaults__\n            bound.__annotations__ = original.__annotations__\n            bound.__dict__.update(original.__dict__)\n            bound.__qualname__ = original.__qualname__\n            bound.__module__ = namespace[\"__name__\"]\n            namespace[name] = bound\n        else:\n            namespace[name] = original\n","numLines":28,"startLine":1,"totalLines":28}},"tool_result_meta":[{"id":"toolu_01F3y4fd1mRXDp3VyjJJwrhR","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
