{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch798wkXvAhoYkmRNyDWK","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01NMchd84zTWC1gBUCbmjsuJ","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_spool_writer_parts/writer.py","offset":78,"limit":360},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":6838,"cache_read_input_tokens":225483,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":6838},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8cec1f7b-b09b-4991-a20f-6e5dfe5185fb","uuid":"2c7d650f-bf8f-4378-a360-fdbba16d824d","timestamp":"2026-11-16T19:14:54.849Z","request_id":"req_011Ch798wYPP1JNWZUApVvZh","wire_tool_inputs":{"toolu_01NMchd84zTWC1gBUCbmjsuJ":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_spool_writer_parts/writer.py","offset":78,"limit":360}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NMchd84zTWC1gBUCbmjsuJ","type":"tool_result","content":"78\t\n79\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n80\tdef _ensure_spool_header(\n81\t    pid: int, _retry_depth: int = 0, *, sync_header: bool = True,\n82\t) -> Dict[str, Any]:\n83\t    \"\"\"Return the header dict for the current spool, creating it if absent.\n84\t\n85\t    Header is written exactly once per spool file (first line). Fresh\n86\t    _spool_uuid minted on creation so body[i].spool_uuid sentinel matches.\n87\t\n88\t    iter2-P1-4: existing nonempty spool with empty header cache (PID reuse,\n89\t    module reload, pytest reset) → parse existing header + reuse uuid;\n90\t    minting a new one would produce header_body_uuid_mismatch quarantine.\n91\t    iter4-P1-1: ordinal recovery via body-line parse (max(ordinal)+1), NOT\n92\t    `\\n` count — robust against unterminated final line from crashed writer.\n93\t    iter4-P1-2: malformed-header → quarantine active spool via direct\n94\t    rename (NOT drain_now() — Phase 2 self-deadlocks on our flock) +\n95\t    fresh-mint retry (bounded depth=1).\n96\t\n97\t    Only spool_append may defer the header fsync: it holds the spool lock\n98\t    and fsyncs the SAME file after writing the first event, before commit\n99\t    or acknowledging success. That sync persists both header and body.\n100\t    Standalone callers keep the durable-header default.\n101\t    \"\"\"\n102\t    header = _SPOOL_HEADER_CACHE.get(pid)\n103\t    spool_p = _spool_path(pid)\n104\t\n105\t    if header is not None and spool_p.exists():\n106\t        return header\n107\t\n108\t    # iter2-P1-4: existing nonempty spool with no in-process header cache.\n109\t    # Read the existing header instead of minting a colliding new one.\n110\t    # iter5-P1: header reuse MUST apply the same strict 4-field validation\n111\t    # that Phase 2 applies (_validate_spool_header_strict). Accepting a\n112\t    # semantically incomplete header here lets new appends ride a file\n113\t    # that Phase 2 will later quarantine → silent loss of the new events.\n114\t    if spool_p.exists():\n115\t        try:\n116\t            st = spool_p.stat()\n117\t        except OSError:\n118\t            st = None\n119\t        if st is not None and st.st_size > 0:\n120\t            header_parsed_ok = False\n121\t            try:\n122\t                with spool_p.open(\"rb\") as fh:\n123\t                    first = fh.readline()\n124\t                existing: Any = json.loads(first.decode(\"utf-8\"))\n125\t                if _validate_spool_header_strict(existing):\n126\t                    _SPOOL_HEADER_CACHE[pid] = existing\n127\t                    # iter4-P1-1: ordinal recovery via body parse (NOT\n128\t                    # `\\n`-count) — robust against unterminated final line.\n129\t                    _ORDINAL_COUNTER[pid] = _recover_ordinal_counter(spool_p)\n130\t                    header_parsed_ok = True\n131\t                    return existing\n132\t            except (OSError, json.JSONDecodeError, UnicodeDecodeError) as e:\n133\t                _breadcrumb(\n134\t                    f\"existing spool header unparsable pid={pid}: \"\n135\t                    f\"{type(e).__name__}: {e}\"\n136\t                )\n137\t            if not header_parsed_ok:\n138\t                # iter4-P1-2: do NOT call drain_now from inside the spool\n139\t                # flock (Phase 2 re-acquires this flock → self-timeout →\n140\t                # bail → caller appends to malformed spool → quarantine\n141\t                # silently loses the new event). Quarantine the file\n142\t                # directly (rename to `.corrupt-header.<epoch>`) and mint\n143\t                # a fresh header. Bounded retry depth = 1.\n144\t                #\n145\t                # iter6-P1: if quarantine FAILS (rename OSError), we MUST\n146\t                # NOT mint over the still-present corrupt file — that\n147\t                # lets new events land behind a header Phase 2 will\n148\t                # quarantine (silent data loss). Raise a specific\n149\t                # exception so caller (`spool_append`) aborts fail-open.\n150\t                quarantined = _quarantine_corrupt_active_spool(spool_p, pid)\n151\t                # Drop any stale in-memory state for this pid.\n152\t                _SPOOL_HEADER_CACHE.pop(pid, None)\n153\t                _ORDINAL_COUNTER.pop(pid, None)\n154\t                if not quarantined:\n155\t                    if _retry_depth >= 1:\n156\t                        # iter6-P1: exhausted retry AND quarantine still\n157\t                        # failing → abort current append fail-open.\n158\t                        # spool_append's outer try/except catches OSError\n159\t                        # and breadcrumbs. The corrupt file remains on\n160\t                        # disk for operator forensic recovery; Phase 2\n161\t                        # may eventually quarantine via its own path\n162\t                        # (header still fails _validate_spool_header_strict).\n163\t                        raise _SpoolHeaderUnrecoverable(\n164\t                            f\"pid={pid}: quarantine of corrupt active spool \"\n165\t                            f\"failed after {_retry_depth + 1} attempt(s); \"\n166\t                            f\"aborting append fail-open\"\n167\t                        )\n168\t                    return _ensure_spool_header(\n169\t                        pid, _retry_depth=_retry_depth + 1,\n170\t                        sync_header=sync_header,\n171\t                    )\n172\t                # Quarantine succeeded → fall through to fresh-mint path.\n173\t\n174\t    header = {\n175\t        \"_spool_header\": True,\n176\t        \"_spool_uuid\": secrets.token_hex(8),\n177\t        \"_pid\": pid,\n178\t        \"_created_wall_ns\": time.time_ns(),\n179\t        \"_created_monotonic_ns\": time.monotonic_ns(),\n180\t        \"_version\": SPOOL_HEADER_VERSION,\n181\t        # PLAN-119 WS-D1 — sticky write-time origin stamp (minted once per PID\n182\t        # file). The drainer refuses to drain \"test\" spool into the LIVE chain.\n183\t        \"_origin\": _origin_for_new_spool(),\n184\t    }\n185\t    spool_p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n186\t    needs_header = (not spool_p.exists()) or spool_p.stat().st_size == 0\n187\t    if needs_header:\n188\t        line = json.dumps(header, separators=(\",\", \":\"), ensure_ascii=False) + \"\\n\"\n189\t        # O_CREAT|O_WRONLY|O_APPEND with 0600 perms — owner-only.\n190\t        fd = os.open(str(spool_p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)\n191\t        try:\n192\t            os.write(fd, line.encode(\"utf-8\"))\n193\t            if sync_header:\n194\t                os.fsync(fd)\n195\t        finally:\n196\t            os.close(fd)\n197\t    _SPOOL_HEADER_CACHE[pid] = header\n198\t    _ORDINAL_COUNTER.setdefault(pid, 0)\n199\t    return header\n200\t\n201\t\n202\tdef _next_ordinal(pid: int) -> int:\n203\t    \"\"\"Return the next strictly-monotonic ordinal for a given pid.\"\"\"\n204\t    n = _ORDINAL_COUNTER.get(pid, 0)\n205\t    _ORDINAL_COUNTER[pid] = n + 1\n206\t    return n\n207\t\n208\t\n209\tdef _ensure_spool_ready_for_append(pid: int) -> None:\n210\t    \"\"\"iter3-P1-1: isolate any unterminated final line before appending.\n211\t\n212\t    If a prior writer died mid-write leaving no trailing newline, the next\n213\t    append concatenates onto the partial line and the new event is lost.\n214\t    Append a separator newline under the held spool flock to isolate the\n215\t    partial fragment (Phase 3 will discard it). No-op when missing/empty/\n216\t    already-newline-terminated. Caller MUST hold _spool_flock_path(pid).\n217\t    Fail-open: breadcrumb on any OSError.\n218\t    \"\"\"\n219\t    spool_p = _spool_path(pid)\n220\t    try:\n221\t        if not spool_p.exists():\n222\t            return\n223\t        st = spool_p.stat()\n224\t        if st.st_size == 0:\n225\t            return\n226\t        with open(str(spool_p), \"rb\") as f:\n227\t            f.seek(-1, os.SEEK_END)\n228\t            last = f.read(1)\n229\t        if last == b\"\\n\":\n230\t            return\n231\t        fd = os.open(str(spool_p), os.O_WRONLY | os.O_APPEND, 0o600)\n232\t        try:\n233\t            os.write(fd, b\"\\n\")\n234\t            os.fsync(fd)\n235\t        finally:\n236\t            os.close(fd)\n237\t        _breadcrumb(\n238\t            f\"spool partial-final-line isolated pid={pid} size={st.st_size}\"\n239\t        )\n240\t    except OSError as e:  # pragma: no cover\n241\t        _breadcrumb(\n242\t            f\"spool ready-for-append check failed pid={pid}: \"\n243\t            f\"{type(e).__name__}: {e}\"\n244\t        )\n245\t\n246\t\n247\tdef _sha256_of_canonical_json(entry_clean: Dict[str, Any]) -> str:\n248\t    \"\"\"sha256 over the canonical_json bytes (deterministic idempotence marker).\n249\t\n250\t    entry_clean MUST exclude internal _drain_* metadata + hmac field. The\n251\t    canonical_json encoder is the same one ADR-055 HMAC chain uses, so the\n252\t    digest is reproducible across re-drains.\n253\t    \"\"\"\n254\t    if _canonical_json is None:\n255\t        raw = json.dumps(entry_clean, sort_keys=True, separators=(\",\", \":\"),\n256\t                         ensure_ascii=False).encode(\"utf-8\")\n257\t    else:\n258\t        raw = _canonical_json.encode(entry_clean)\n259\t    return hashlib.sha256(raw).hexdigest()\n260\t\n261\t\n262\tdef _write_journal_envelope(\n263\t    pid: int,\n264\t    record_id: str,\n265\t    spool_uuid: str,\n266\t    ordinal: int,\n267\t    sha256_of_line: str,\n268\t    op: str,\n269\t    drain_epoch: Optional[str] = None,\n270\t) -> None:\n271\t    \"\"\"Buffer + amortized-fsync journal envelope. Best-effort fail-open.\n272\t\n273\t    P1-2: NOT a hot-path fsync. Envelopes are buffered in\n274\t    _JOURNAL_BUFFER[pid]; flushed + fsync'd at drain boundary, signal\n275\t    handler, atexit, or every _JOURNAL_FLUSH_EVERY writes (per ADR-055-\n276\t    AMEND-1 §3 line 96: \"journal fsync every 100ms OR 10 emits\").\n277\t    \"\"\"\n278\t    env: Dict[str, Any] = {\n279\t        \"record_id\": record_id,\n280\t        \"spool_uuid\": spool_uuid,\n281\t        \"ordinal_within_file\": ordinal,\n282\t        \"sha256_of_line\": sha256_of_line,\n283\t        \"op\": op,\n284\t        \"wall_ns\": time.time_ns(),\n285\t    }\n286\t    if drain_epoch is not None:\n287\t        env[\"drain_epoch_at_commit\"] = drain_epoch\n288\t    try:\n289\t        line = (json.dumps(env, separators=(\",\", \":\"), ensure_ascii=False)\n290\t                + \"\\n\").encode(\"utf-8\")\n291\t    except (TypeError, ValueError) as e:\n292\t        _breadcrumb(f\"journal encode failed: {type(e).__name__}: {e}\")\n293\t        return\n294\t    buf = _JOURNAL_BUFFER.setdefault(pid, [])\n295\t    buf.append(line)\n296\t    if len(buf) >= _JOURNAL_FLUSH_EVERY:\n297\t        _flush_journal_buffer(pid)\n298\t\n299\t\n300\tdef _flush_journal_buffer(pid: int) -> None:\n301\t    \"\"\"Flush buffered journal envelopes for PID with a single fsync.\n302\t\n303\t    P1-2: invoked at drain boundary, signal handler, atexit, or when\n304\t    buffer hits _JOURNAL_FLUSH_EVERY. Best-effort fail-open. Acquires\n305\t    the per-PID journal flock around the append+fsync window.\n306\t    \"\"\"\n307\t    buf = _JOURNAL_BUFFER.get(pid)\n308\t    if not buf:\n309\t        return\n310\t    p = _journal_path(pid)\n311\t    try:\n312\t        p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n313\t    except OSError as e:\n314\t        _breadcrumb(f\"journal mkdir failed: {type(e).__name__}: {e}\")\n315\t        return\n316\t    payload = b\"\".join(buf)\n317\t    try:\n318\t        with FileLock(_journal_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT):\n319\t            fd = os.open(\n320\t                str(p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600,\n321\t            )\n322\t            try:\n323\t                os.write(fd, payload)\n324\t                os.fsync(fd)\n325\t            finally:\n326\t                os.close(fd)\n327\t        # Only clear on successful write; on failure the buffer retains\n328\t        # the envelopes for the next flush attempt (best-effort durability).\n329\t        _JOURNAL_BUFFER[pid] = []\n330\t    except FileLockTimeout:\n331\t        _breadcrumb(f\"journal flock timeout pid={pid}\")\n332\t    except OSError as e:\n333\t        _breadcrumb(f\"journal flush failed: {type(e).__name__}: {e}\")\n334\t\n335\t\n336\t# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\n337\tdef spool_append(entry: Dict[str, Any]) -> None:\n338\t    \"\"\"Write entry to per-PID spool with 4-tuple metadata + fsync.\n339\t\n340\t    Stamps wall_ns, pid, spool_uuid, ordinal_within_file, record_id.\n341\t    Wraps spool write in begin/commit journal envelopes for crash\n342\t    forensics. Fail-open: any infra error writes a breadcrumb and\n343\t    returns silently.\n344\t\n345\t    P1-1: acquires per-PID spool flock for the header-ensure + body\n346\t    append window so same-PID concurrent emit and signal-triggered drain\n347\t    don't race. Module-level _IN_SPOOL_APPEND latch lets signal handler\n348\t    detect a writer in progress and bail.\n349\t\n350\t    P1-3: stamps `record_id` onto the spool entry so the drain Phase 5\n351\t    `op:\"drained\"` envelope can carry it for session-start reconciliation.\n352\t    \"\"\"\n353\t    global _IN_SPOOL_APPEND, _LAST_APPEND_SUCCEEDED\n354\t    _LAST_APPEND_SUCCEEDED = False\n355\t    try:\n356\t        pid = os.getpid()\n357\t        record_id = uuid.uuid4().hex\n358\t        spool_p = _spool_path(pid)\n359\t        # Per-PID spool flock — ADR-055-AMEND-1 §4 Phase 1: writers acquire\n360\t        # only their own spool's flock + journal's flock (never canonical).\n361\t        try:\n362\t            spool_flock = FileLock(\n363\t                _spool_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT,\n364\t            )\n365\t        except OSError as e:\n366\t            _breadcrumb(f\"spool flock alloc failed: {type(e).__name__}: {e}\")\n367\t            return\n368\t        try:\n369\t            with spool_flock:\n370\t                _IN_SPOOL_APPEND = True\n371\t                try:\n372\t                    # The body fsync below covers the new header on this same\n373\t                    # inode too. Do not acknowledge or journal a commit until\n374\t                    # that fsync succeeds. No event durability is deferred.\n375\t                    header = _ensure_spool_header(pid, sync_header=False)\n376\t                    # iter3-P1-1: isolate any unterminated final line from a\n377\t                    # prior crashed writer BEFORE we mint our ordinal so the\n378\t                    # new entry can't be silently lost via concatenation.\n379\t                    _ensure_spool_ready_for_append(pid)\n380\t                    spool_uuid = header[\"_spool_uuid\"]\n381\t                    ordinal = _next_ordinal(pid)\n382\t\n383\t                    stamped: Dict[str, Any] = dict(entry)\n384\t                    stamped.setdefault(\"wall_ns\", time.time_ns())\n385\t                    stamped[\"pid\"] = pid\n386\t                    stamped[\"spool_uuid\"] = spool_uuid\n387\t                    stamped[\"ordinal_within_file\"] = ordinal\n388\t                    # P1-3: carry record_id through the spool so Phase 5\n389\t                    # can emit op:\"drained\" with matching id.\n390\t                    stamped[\"record_id\"] = record_id\n391\t\n392\t                    try:\n393\t                        line_bytes = json.dumps(\n394\t                            stamped, separators=(\",\", \":\"),\n395\t                            ensure_ascii=False,\n396\t                        ).encode(\"utf-8\") + b\"\\n\"\n397\t                    except (TypeError, ValueError) as e:\n398\t                        _breadcrumb(\n399\t                            f\"spool encode failed: {type(e).__name__}: {e}\"\n400\t                        )\n401\t                        return\n402\t\n403\t                    sha = hashlib.sha256(line_bytes).hexdigest()\n404\t\n405\t                    _write_journal_envelope(\n406\t                        pid, record_id, spool_uuid, ordinal, sha, \"begin\",\n407\t                    )\n408\t\n409\t                    try:\n410\t                        fd = os.open(\n411\t                            str(spool_p),\n412\t                            os.O_WRONLY | os.O_CREAT | os.O_APPEND,\n413\t                            0o600,\n414\t                        )\n415\t                        try:\n416\t                            os.write(fd, line_bytes)\n417\t                            os.fsync(fd)\n418\t                        finally:\n419\t                            os.close(fd)\n420\t                    except OSError as e:\n421\t                        _breadcrumb(\n422\t                            f\"spool append failed: {type(e).__name__}: {e}\"\n423\t                        )\n424\t                        return\n425\t\n426\t                    _write_journal_envelope(\n427\t                        pid, record_id, spool_uuid, ordinal, sha, \"commit\",\n428\t                    )\n429\t                    _LAST_APPEND_SUCCEEDED = True\n430\t                finally:\n431\t                    _IN_SPOOL_APPEND = False\n432\t        except FileLockTimeout:\n433\t            _IN_SPOOL_APPEND = False\n434\t            _breadcrumb(f\"spool flock timeout pid={pid}\")\n435\t            return\n436\t    except Exception as e:  # fail-open invariant\n437\t        _IN_SPOOL_APPEND = False"}]},"parent_tool_use_id":null,"session_id":"8cec1f7b-b09b-4991-a20f-6e5dfe5185fb","uuid":"1e56fcec-c49b-4d1c-9ded-633a1019e223","timestamp":"2026-11-16T19:14:54.864Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_spool_writer_parts/writer.py","content":"\n# QDSAA-FUNCAO-LONGA: protocolo de durabilidade atomica; separar altera invariantes de lock e recuperacao.\ndef _ensure_spool_header(\n    pid: int, _retry_depth: int = 0, *, sync_header: bool = True,\n) -> Dict[str, Any]:\n    \"\"\"Return the header dict for the current spool, creating it if absent.\n\n    Header is written exactly once per spool file (first line). Fresh\n    _spool_uuid minted on creation so body[i].spool_uuid sentinel matches.\n\n    iter2-P1-4: existing nonempty spool with empty header cache (PID reuse,\n    module reload, pytest reset) → parse existing header + reuse uuid;\n    minting a new one would produce header_body_uuid_mismatch quarantine.\n    iter4-P1-1: ordinal recovery via body-line parse (max(ordinal)+1), NOT\n    `\\n` count — robust against unterminated final line from crashed writer.\n    iter4-P1-2: malformed-header → quarantine active spool via direct\n    rename (NOT drain_now() — Phase 2 self-deadlocks on our flock) +\n    fresh-mint retry (bounded depth=1).\n\n    Only spool_append may defer the header fsync: it holds the spool lock\n    and fsyncs the SAME file after writing the first event, before commit\n    or acknowledging success. That sync persists both header and body.\n    Standalone callers keep the durable-header default.\n    \"\"\"\n    header = _SPOOL_HEADER_CACHE.get(pid)\n    spool_p = _spool_path(pid)\n\n    if header is not None and spool_p.exists():\n        return header\n\n    # iter2-P1-4: existing nonempty spool with no in-process header cache.\n    # Read the existing header instead of minting a colliding new one.\n    # iter5-P1: header reuse MUST apply the same strict 4-field validation\n    # that Phase 2 applies (_validate_spool_header_strict). Accepting a\n    # semantically incomplete header here lets new appends ride a file\n    # that Phase 2 will later quarantine → silent loss of the new events.\n    if spool_p.exists():\n        try:\n            st = spool_p.stat()\n        except OSError:\n            st = None\n        if st is not None and st.st_size > 0:\n            header_parsed_ok = False\n            try:\n                with spool_p.open(\"rb\") as fh:\n                    first = fh.readline()\n                existing: Any = json.loads(first.decode(\"utf-8\"))\n                if _validate_spool_header_strict(existing):\n                    _SPOOL_HEADER_CACHE[pid] = existing\n                    # iter4-P1-1: ordinal recovery via body parse (NOT\n                    # `\\n`-count) — robust against unterminated final line.\n                    _ORDINAL_COUNTER[pid] = _recover_ordinal_counter(spool_p)\n                    header_parsed_ok = True\n                    return existing\n            except (OSError, json.JSONDecodeError, UnicodeDecodeError) as e:\n                _breadcrumb(\n                    f\"existing spool header unparsable pid={pid}: \"\n                    f\"{type(e).__name__}: {e}\"\n                )\n            if not header_parsed_ok:\n                # iter4-P1-2: do NOT call drain_now from inside the spool\n                # flock (Phase 2 re-acquires this flock → self-timeout →\n                # bail → caller appends to malformed spool → quarantine\n                # silently loses the new event). Quarantine the file\n                # directly (rename to `.corrupt-header.<epoch>`) and mint\n                # a fresh header. Bounded retry depth = 1.\n                #\n                # iter6-P1: if quarantine FAILS (rename OSError), we MUST\n                # NOT mint over the still-present corrupt file — that\n                # lets new events land behind a header Phase 2 will\n                # quarantine (silent data loss). Raise a specific\n                # exception so caller (`spool_append`) aborts fail-open.\n                quarantined = _quarantine_corrupt_active_spool(spool_p, pid)\n                # Drop any stale in-memory state for this pid.\n                _SPOOL_HEADER_CACHE.pop(pid, None)\n                _ORDINAL_COUNTER.pop(pid, None)\n                if not quarantined:\n                    if _retry_depth >= 1:\n                        # iter6-P1: exhausted retry AND quarantine still\n                        # failing → abort current append fail-open.\n                        # spool_append's outer try/except catches OSError\n                        # and breadcrumbs. The corrupt file remains on\n                        # disk for operator forensic recovery; Phase 2\n                        # may eventually quarantine via its own path\n                        # (header still fails _validate_spool_header_strict).\n                        raise _SpoolHeaderUnrecoverable(\n                            f\"pid={pid}: quarantine of corrupt active spool \"\n                            f\"failed after {_retry_depth + 1} attempt(s); \"\n                            f\"aborting append fail-open\"\n                        )\n                    return _ensure_spool_header(\n                        pid, _retry_depth=_retry_depth + 1,\n                        sync_header=sync_header,\n                    )\n                # Quarantine succeeded → fall through to fresh-mint path.\n\n    header = {\n        \"_spool_header\": True,\n        \"_spool_uuid\": secrets.token_hex(8),\n        \"_pid\": pid,\n        \"_created_wall_ns\": time.time_ns(),\n        \"_created_monotonic_ns\": time.monotonic_ns(),\n        \"_version\": SPOOL_HEADER_VERSION,\n        # PLAN-119 WS-D1 — sticky write-time origin stamp (minted once per PID\n        # file). The drainer refuses to drain \"test\" spool into the LIVE chain.\n        \"_origin\": _origin_for_new_spool(),\n    }\n    spool_p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n    needs_header = (not spool_p.exists()) or spool_p.stat().st_size == 0\n    if needs_header:\n        line = json.dumps(header, separators=(\",\", \":\"), ensure_ascii=False) + \"\\n\"\n        # O_CREAT|O_WRONLY|O_APPEND with 0600 perms — owner-only.\n        fd = os.open(str(spool_p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)\n        try:\n            os.write(fd, line.encode(\"utf-8\"))\n            if sync_header:\n                os.fsync(fd)\n        finally:\n            os.close(fd)\n    _SPOOL_HEADER_CACHE[pid] = header\n    _ORDINAL_COUNTER.setdefault(pid, 0)\n    return header\n\n\ndef _next_ordinal(pid: int) -> int:\n    \"\"\"Return the next strictly-monotonic ordinal for a given pid.\"\"\"\n    n = _ORDINAL_COUNTER.get(pid, 0)\n    _ORDINAL_COUNTER[pid] = n + 1\n    return n\n\n\ndef _ensure_spool_ready_for_append(pid: int) -> None:\n    \"\"\"iter3-P1-1: isolate any unterminated final line before appending.\n\n    If a prior writer died mid-write leaving no trailing newline, the next\n    append concatenates onto the partial line and the new event is lost.\n    Append a separator newline under the held spool flock to isolate the\n    partial fragment (Phase 3 will discard it). No-op when missing/empty/\n    already-newline-terminated. Caller MUST hold _spool_flock_path(pid).\n    Fail-open: breadcrumb on any OSError.\n    \"\"\"\n    spool_p = _spool_path(pid)\n    try:\n        if not spool_p.exists():\n            return\n        st = spool_p.stat()\n        if st.st_size == 0:\n            return\n        with open(str(spool_p), \"rb\") as f:\n            f.seek(-1, os.SEEK_END)\n            last = f.read(1)\n        if last == b\"\\n\":\n            return\n        fd = os.open(str(spool_p), os.O_WRONLY | os.O_APPEND, 0o600)\n        try:\n            os.write(fd, b\"\\n\")\n            os.fsync(fd)\n        finally:\n            os.close(fd)\n        _breadcrumb(\n            f\"spool partial-final-line