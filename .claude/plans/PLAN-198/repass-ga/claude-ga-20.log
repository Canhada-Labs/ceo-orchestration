{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01G74QUWJRnPXQVzKYNCspnb","type":"tool_result","content":"280\t        return current\n281\t    if replace_all:\n282\t        return current.replace(old_string, new_string)\n283\t    return current.replace(old_string, new_string, 1)\n284\t\n285\t\n286\tdef _read_plan_file(file_path: str) -> str:\n287\t    \"\"\"Default file reader — empty string on any error (matches .py hook).\"\"\"\n288\t    try:\n289\t        return Path(file_path).read_text(encoding=\"utf-8\")\n290\t    except (OSError, UnicodeDecodeError):\n291\t        return \"\"\n292\t\n293\t\n294\tdef plan_edit_preprocess(event: Dict[str, Any],\n295\t                         *, read_current=None) -> Dict[str, Any]:\n296\t    \"\"\"Enrich ``event`` with ``_derived_plan`` fields.\n297\t\n298\t    Optional ``read_current`` param lets tests inject a fake file reader.\n299\t    When ``None``, reads the real filesystem (matches .py hook behavior).\n300\t    \"\"\"\n301\t    enriched = dict(event) if isinstance(event, dict) else {}\n302\t    derived = _plan_defaults()\n303\t    reader = read_current if read_current is not None else _read_plan_file\n304\t    try:\n305\t        tool_input = event.get(\"tool_input\") if isinstance(event, dict) else None\n306\t        if not isinstance(tool_input, dict):\n307\t            enriched[\"_derived_plan\"] = derived\n308\t            return enriched\n309\t        file_path = str(tool_input.get(\"file_path\") or \"\")\n310\t        old_string = str(tool_input.get(\"old_string\") or \"\")\n311\t        new_string = str(tool_input.get(\"new_string\") or \"\")\n312\t        replace_all = bool(tool_input.get(\"replace_all\") or False)\n313\t\n314\t        # Scope guard.\n315\t        if not _plan_paths.is_plan_path(file_path):\n316\t            enriched[\"_derived_plan\"] = derived\n317\t            return enriched\n318\t        derived[\"is_plan_file\"] = True\n319\t        derived[\"plan_id\"] = _plan_paths.plan_id_from_path(file_path)\n320\t\n321\t        current = reader(file_path)\n322\t        if not current:\n323\t            enriched[\"_derived_plan\"] = derived\n324\t            return enriched\n325\t\n326\t        new_content = _apply_edit(current, old_string, new_string, replace_all)\n327\t        if new_content == current:\n328\t            enriched[\"_derived_plan\"] = derived\n329\t            return enriched\n330\t\n331\t        old_fm = _fm.parse_frontmatter(current)\n332\t        new_fm = _fm.parse_frontmatter(new_content)\n333\t\n334\t        old_status = str(old_fm.get(\"status\", \"\")).strip()\n335\t        new_status = str(new_fm.get(\"status\", \"\")).strip()\n336\t        derived[\"old_status\"] = old_status\n337\t        derived[\"new_status\"] = new_status\n338\t        derived[\"status_changed\"] = bool(\n339\t            old_status and new_status and old_status != new_status\n340\t        )\n341\t\n342\t        # Legality checks\n343\t        new_status_legal = new_status in _LEGAL_STATUSES if new_status else True\n344\t        derived[\"new_status_legal\"] = new_status_legal\n345\t\n346\t        if old_status and old_status in _LEGAL_STATUSES and new_status_legal:\n347\t            allowed = _ALLOWED_TRANSITIONS.get(old_status, frozenset())\n348\t            derived[\"transition_legal\"] = (new_status in allowed) or (\n349\t                old_status == new_status\n350\t            )\n351\t        else:\n352\t            # Corrupt existing status or new plan without old status → don't\n353\t            # block the transition graph (mirrors .py hook _check_transition).\n354\t            derived[\"transition_legal\"] = True\n355\t\n356\t        # Required-field detectors\n357\t        reviewed_at = new_fm.get(\"reviewed_at\")\n358\t        derived[\"reviewed_at_present\"] = bool(reviewed_at)\n359\t        completed_at = new_fm.get(\"completed_at\")\n360\t        derived[\"completed_at_present\"] = bool(completed_at)\n361\t        rc = new_fm.get(\"related_commits\")\n362\t        derived[\"related_commits_nonempty\"] = bool(\n363\t            rc and (not isinstance(rc, list) or len(rc) > 0)\n364\t        )\n365\t        derived[\"abandonment_reason_present\"] = _fm.has_abandonment_reason(\n366\t            new_content\n367\t        )\n368\t        # Session 75 F7: refused_adr field required when status=refused.\n369\t        # Mirrors check_plan_edit.py _check_required_fields refused branch."}]},"parent_tool_use_id":null,"session_id":"8cec1f7b-b09b-4991-a20f-6e5dfe5185fb","uuid":"b908a0ed-754a-4633-a43c-b2e5772eb26a","timestamp":"2026-11-16T19:11:52.488Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/policy_preprocessors.py","content":"        return current\n    if replace_all:\n        return current.replace(old_string, new_string)\n    return current.replace(old_string, new_string, 1)\n\n\ndef _read_plan_file(file_path: str) -> str:\n    \"\"\"Default file reader — empty string on any error (matches .py hook).\"\"\"\n    try:\n        return Path(file_path).read_text(encoding=\"utf-8\")\n    except (OSError, UnicodeDecodeError):\n        return \"\"\n\n\ndef plan_edit_preprocess(event: Dict[str, Any],\n                         *, read_current=None) -> Dict[str, Any]:\n    \"\"\"Enrich ``event`` with ``_derived_plan`` fields.\n\n    Optional ``read_current`` param lets tests inject a fake file reader.\n    When ``None``, reads the real filesystem (matches .py hook behavior).\n    \"\"\"\n    enriched = dict(event) if isinstance(event, dict) else {}\n    derived = _plan_defaults()\n    reader = read_current if read_current is not None else _read_plan_file\n    try:\n        tool_input = event.get(\"tool_input\") if isinstance(event, dict) else None\n        if not isinstance(tool_input, dict):\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n        file_path = str(tool_input.get(\"file_path\") or \"\")\n        old_string = str(tool_input.get(\"old_string\") or \"\")\n        new_string = str(tool_input.get(\"new_string\") or \"\")\n        replace_all = bool(tool_input.get(\"replace_all\") or False)\n\n        # Scope guard.\n        if not _plan_paths.is_plan_path(file_path):\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n        derived[\"is_plan_file\"] = True\n        derived[\"plan_id\"] = _plan_paths.plan_id_from_path(file_path)\n\n        current = reader(file_path)\n        if not current:\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n\n        new_content = _apply_edit(current, old_string, new_string, replace_all)\n        if new_content == current:\n            enriched[\"_derived_plan\"] = derived\n            return enriched\n\n        old_fm = _fm.parse_frontmatter(current)\n        new_fm = _fm.parse_frontmatter(new_content)\n\n        old_status = str(old_fm.get(\"status\", \"\")).strip()\n        new_status = str(new_fm.get(\"status\", \"\")).strip()\n        derived[\"old_status\"] = old_status\n        derived[\"new_status\"] = new_status\n        derived[\"status_changed\"] = bool(\n            old_status and new_status and old_status != new_status\n        )\n\n        # Legality checks\n        new_status_legal = new_status in _LEGAL_STATUSES if new_status else True\n        derived[\"new_status_legal\"] = new_status_legal\n\n        if old_status and old_status in _LEGAL_STATUSES and new_status_legal:\n            allowed = _ALLOWED_TRANSITIONS.get(old_status, frozenset())\n            derived[\"transition_legal\"] = (new_status in allowed) or (\n                old_status == new_status\n            )\n        else:\n            # Corrupt existing status or new plan without old status → don't\n            # block the transition graph (mirrors .py hook _check_transition).\n            derived[\"transition_legal\"] = True\n\n        # Required-field detectors\n        reviewed_at = new_fm.get(\"reviewed_at\")\n        derived[\"reviewed_at_present\"] = bool(reviewed_at)\n        completed_at = new_fm.get(\"completed_at\")\n        derived[\"completed_at_present\"] = bool(completed_at)\n        rc = new_fm.get(\"related_commits\")\n        derived[\"related_commits_nonempty\"] = bool(\n            rc and (not isinstance(rc, list) or len(rc) > 0)\n        )\n        derived[\"abandonment_reason_present\"] = _fm.has_abandonment_reason(\n            new_content\n        )\n        # Session 75 F7: refused_adr field required when status=refused.\n        # Mirrors check_plan_edit.py _check_required_fields refused branch.","numLines":90,"startLine":280,"totalLines":460}},"tool_result_meta":[{"id":"toolu_01G74QUWJRnPXQVzKYNCspnb","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
