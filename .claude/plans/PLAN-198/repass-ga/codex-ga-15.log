-        "archetype": archetype,
-        "hit_count": int(hit_count),
-        "miss_count": int(miss_count),
-        "hit_rate_bps": bps,
-        "archive_path": archive_path,
-        "reason": reason,
-        "session_id": session_id,
-        "project": project,
-    }
-    _write_event(event)
