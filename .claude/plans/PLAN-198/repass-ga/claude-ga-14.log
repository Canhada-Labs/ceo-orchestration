\t-                # parser did not validate — taint, whatever its phrasing.\n1713\t-                invalid_seen = True\n1714\t-        for lm in _CAN_EDIT_LINE_RE.finditer(block):\n1715\t-            block_had_line = True\n1716\t-            for raw in lm.group(1).split(\",\"):\n1717\t-                p = raw.strip().strip(\"`\").strip()\n1718\t-                if not p:\n1719\t-                    continue\n1720\t-                if p.lower() == _FA_READONLY_TOKEN:\n1721\t-                    # Explicit read-only form — never a concrete path,\n1722\t-                    # never a hashable overlap participant (guaranteed by\n1723\t-                    # this branch running BEFORE the concrete-path add).\n1724\t-                    readonly_declared = True\n1725\t-                    continue\n1726\t-                # Drop placeholders + wildcards (cannot prove a clobber).\n1727\t-                # Angle brackets included (codex r1 P2): a scaffold literal\n1728\t-                # like `CAN edit: <concrete paths>` must classify\n1729\t-                # unparseable, not concrete — especially since the hook's\n1730\t-                # own block message shows that exact scaffold string.\n1731\t-                # Every drop marks the declaration TAINTED (codex r14 P1):\n1732\t-                # an earlier NONE-READ-ONLY must not hide a later wildcard\n1733\t-                # grant the agent still READS in its prompt.\n1734\t-                # ALL glob/expansion syntax rejected ANYWHERE in the\n1735\t-                # token (codex r19 P1): `src/?.py`, `src/[ab].py` and\n1736\t-                # `src/{a,b}.py` are multi-file grants the agent reads\n1737\t-                # while telemetry hashes only literal tokens (brace forms\n1738\t-                # additionally split into bogus comma paths upstream).\n1739\t-                if any(ch in p for ch in \"*?[]{}<>\") or p.lower() in (\n1740\t-                    \"none\", \"n/a\", \"tbd\",\n1741\t-                ):\n1742\t-                    invalid_seen = True\n1743\t-                    continue\n1744\t-                # Codex r9 P2: filesystem paths cannot carry NUL/control\n1745\t-                # chars — a crafted value could otherwise classify as\n1746\t-                # concrete AND hash into the domain-separated read-only\n1747\t-                # telemetry marker (which is NUL-framed precisely so real\n1748\t-                # paths can never reach it). Reject, do not sanitize.\n1749\t-                # Broad prose (\"all files\", \"any path\") and shell-\n1750\t-                # expansion forms (\"$HOME/...\") are NOT concrete paths\n1751\t-                # (codex r31 P1): a concrete grant in this grammar has no\n1752\t-                # spaces and no `$` — declared in ADR-191 §2.1.\n1753\t-                if any(ch.isspace() for ch in p) or \"$\" in p:\n1754\t-                    invalid_seen = True\n1755\t-                    continue\n1756\t-                # Unicode line/paragraph separators included (codex r28\n1757\t-                # P1): U+0085 NEL, U+2028 LS, U+2029 PS present injected\n1758\t-                # prompt STRUCTURE to the agent while hashing as one path\n1759\t-                # — and CEO_UNICODE_HARDBLOCK may be unset.\n1760\t-                if any(\n1761\t-                    ord(ch) < 32\n1762\t-                    or ch in (\"\\x7f\", \"\\u0085\", \"\\u2028\", \"\\u2029\")\n1763\t-                    for ch in p\n1764\t-                ):\n1765\t-                    invalid_seen = True\n1766\t-                    continue\n1767\t-                # Normalize: strip a leading ./, collapse; POSIX paths are\n1768\t-                # case-sensitive so keep case, normalize separators only.\n1769\t-                p = p.lstrip(\"./\").replace(\"\\\\\", \"/\")\n1770\t-                if not p:\n1771\t-                    # Codex r3 P1: `...` / `./` normalize to \"\" — an empty\n1772\t-                    # \"path\" must never make the declaration concrete (it\n1773\t-                    # would record path_count=1 and hide a would-block\n1774\t-                    # input from the advisory window).\n1775\t-                    invalid_seen = True\n1776\t-                    continue\n1777\t-                # Cap STORED paths without stopping the scan (codex r16\n1778\t-                # P1). Exceeding the cap TAINTS the declaration (codex r31\n1779\t-                # P2): silently dropping path 65+ would hide granted\n1780\t-                # authority from the overlap guard — an assignment that\n1781\t-                # large is a partition smell anyway.\n1782\t-                if len(paths) < _OVERLAP_MAX_PATHS:\n1783\t-                    paths.add(p)\n1784\t-                else:\n1785\t-                    invalid_seen = True\n1786\t-        if not block_had_line:\n1787\t-            # Codex r23 P1: an appended block with ZERO parseable\n1788\t-            # `CAN edit:` lines (`- MAY edit: ...`, misspellings, empty)\n1789\t-            # is a write grant the agent READS but the parser never saw —\n1790\t-            # it must taint the declaration, not vanish behind an earlier\n1791\t-            # read-only block.\n1792\t-            invalid_seen = True\n1793\t-    if paths and not invalid_seen:\n1794\t-        return (\"concrete\", frozenset(paths))\n1795\t-    if readonly_declared and not paths and not invalid_seen:\n1796\t-        return (\"readonly\", frozenset())\n1797\t-    # ANY dropped token taints the WHOLE declaration (codex r14+r15 P1):\n1798\t-    # a readonly token or a valid path must not launder a wildcard/\n1799\t-    # placeholder/control-char grant past the enforce gate — the agent\n1800\t-    # still READ that grant in its prompt. Mixed declarations classify\n1801\t-    # unparseable; concrete paths are still returned for overlap\n1802\t-    # telemetry (recording them costs nothing and keeps the collision\n1803\t-    # detector informed even on a tainted spawn).\n1804\t-    retur