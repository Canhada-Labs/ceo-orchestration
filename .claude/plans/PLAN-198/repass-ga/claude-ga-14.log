-    partial fragment (Phase 3 will discard it). No-op when missing/empty/\n480\t-    already-newline-terminated. Caller MUST hold _spool_flock_path(pid).\n481\t-    Fail-open: breadcrumb on any OSError.\n482\t-    \"\"\"\n483\t-    spool_p = _spool_path(pid)\n484\t-    try:\n485\t-        if not spool_p.exists():\n486\t-            return\n487\t-        st = spool_p.stat()\n488\t-        if st.st_size == 0:\n489\t-            return\n490\t-        with open(str(spool_p), \"rb\") as f:\n491\t-            f.seek(-1, os.SEEK_END)\n492\t-            last = f.read(1)\n493\t-        if last == b\"\\n\":\n494\t-            return\n495\t-        fd = os.open(str(spool_p), os.O_WRONLY | os.O_APPEND, 0o600)\n496\t-        try:\n497\t-            os.write(fd, b\"\\n\")\n498\t-            os.fsync(fd)\n499\t-        finally:\n500\t-            os.close(fd)\n501\t-        _breadcrumb(\n502\t-            f\"spool partial-final-line isolated pid={pid} size={st.st_size}\"\n503\t-        )\n504\t-    except OSError as e:  # pragma: no cover\n505\t-        _breadcrumb(\n506\t-            f\"spool ready-for-append check failed pid={pid}: \"\n507\t-            f\"{type(e).__name__}: {e}\"\n508\t-        )\n509\t-\n510\t-\n511\t-def _sha256_of_canonical_json(entry_clean: Dict[str, Any]) -> str:\n512\t-    \"\"\"sha256 over the canonical_json bytes (deterministic idempotence marker).\n513\t-\n514\t-    entry_clean MUST exclude internal _drain_* metadata + hmac field. The\n515\t-    canonical_json encoder is the same one ADR-055 HMAC chain uses, so the\n516\t-    digest is reproducible across re-drains.\n517\t-    \"\"\"\n518\t-    if _canonical_json is None:\n519\t-        raw = json.dumps(entry_clean, sort_keys=True, separators=(\",\", \":\"),\n520\t-                         ensure_ascii=False).encode(\"utf-8\")\n521\t-    else:\n522\t-        raw = _canonical_json.encode(entry_clean)\n523\t-    return hashlib.sha256(raw).hexdigest()\n524\t-\n525\t-\n526\t-def _write_journal_envelope(\n527\t-    pid: int,\n528\t-    record_id: str,\n529\t-    spool_uuid: str,\n530\t-    ordinal: int,\n531\t-    sha256_of_line: str,\n532\t-    op: str,\n533\t-    drain_epoch: Optional[str] = None,\n534\t-) -> None:\n535\t-    \"\"\"Buffer + amortized-fsync journal envelope. Best-effort fail-open.\n536\t-\n537\t-    P1-2: NOT a hot-path fsync. Envelopes are buffered in\n538\t-    _JOURNAL_BUFFER[pid]; flushed + fsync'd at drain boundary, signal\n539\t-    handler, atexit, or every _JOURNAL_FLUSH_EVERY writes (per ADR-055-\n540\t-    AMEND-1 §3 line 96: \"journal fsync every 100ms OR 10 emits\").\n541\t-    \"\"\"\n542\t-    env: Dict[str, Any] = {\n543\t-        \"record_id\": record_id,\n544\t-        \"spool_uuid\": spool_uuid,\n545\t-        \"ordinal_within_file\": ordinal,\n546\t-        \"sha256_of_line\": sha256_of_line,\n547\t-        \"op\": op,\n548\t-        \"wall_ns\": time.time_ns(),\n549\t-    }\n550\t-    if drain_epoch is not None:\n551\t-        env[\"drain_epoch_at_commit\"] = drain_epoch\n552\t-    try:\n553\t-        line = (json.dumps(env, separators=(\",\", \":\"), ensure_ascii=False)\n554\t-                + \"\\n\").encode(\"utf-8\")\n555\t-    except (TypeError, ValueError) as e:\n556\t-        _breadcrumb(f\"journal encode failed: {type(e).__name__}: {e}\")\n557\t-        return\n558\t-    buf = _JOURNAL_BUFFER.setdefault(pid, [])\n559\t-    buf.append(line)\n560\t-    if len(buf) >= _JOURNAL_FLUSH_EVERY:\n561\t-        _flush_journal_buffer(pid)\n562\t-\n563\t-\n564\t-def _flush_journal_buffer(pid: int) -> None:\n565\t-    \"\"\"Flush buffered journal envelopes for PID with a single fsync.\n566\t-\n567\t-    P1-2: invoked at drain boundary, signal handler, atexit, or when\n568\t-    buffer hits _JOURNAL_FLUSH_EVERY. Best-effort fail-open. Acquires\n569\t-    the per-PID journal flock around the append+fsync window.\n570\t-    \"\"\"\n571\t-    buf = _JOURNAL_BUFFER.get(pid)\n572\t-    if not buf:\n573\t-        return\n574\t-    p = _journal_path(pid)\n575\t-    try:\n576\t-        p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n577\t-    except OSError as e:\n578\t-        _breadcrumb(f\"journal mkdir failed: {type(e).__name__}: {e}\")\n579\t-        return\n580\t-    payload = b\"\".join(buf)\n581\t-    try:\n582\t-        with FileLock(_journal_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT):\n583\t-            fd = os.open(\n584\t-                str(p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600,\n585\t-            )\n586\t-            try:\n587\t-                os.write(fd, payload)\n588\t-                os.fsync(fd)\n589\t-            finally:\n590\t-                os.close(fd)\n591\t-        # Only clear on successful write; on failure the buffer retains\n592\t-        # the envelopes for the next flush attempt (best-effort durability).\n593\t-        _JOURNAL_BUFFER[pid] = []\n594\t-    except FileLockTimeout:\n595\t-        _breadcrumb(f\"journal flock timeout pid={pid}\")\n596\t-    except OSError as e:\n597\t-        _breadcrumb(f\"journal flush failed: {type(e).__name__}: {e}\")\n598\t-\n599\t-\n600\t-def spool_append(entry: Dict[str, Any]) -> None:\n601\t-    \"\"\"Write entry to per-PID spool with 4-tuple metadata + fsync.\n602\t-\n603\t-    Stamps wall_ns, pid, spool_uuid, ordinal_within_file, record_id.\n604\t-    Wraps spool write in begin/commit journal envelopes for crash\n605\t-    forensics. Fail-open: any infra error writes a breadcrumb and\n606\t-    returns silently.\n607\t-\n608\t-    P1-1: acquires per-PID spool flock for the header-ensure + body\n609\t-    append window so same-PID concurrent emit and signal-triggered drain\n610\t-    don't race. Module-level _IN_SPOOL_APPEND latch lets signal handler\n611\t-    detect a writer in progress and bail.\n612\t-\n613\t-    P1-3: stamps `record_id` onto the spool entry so the drain Phase 5\n614\t-    `op:\"drained\"` envelope can carry it for session-start reconciliation.\n615\t-    \"\"\"\n616\t-    global _IN_SPOOL_APPEND, _LAST_APPEND_SUCCEEDED\n617\t-    _LAST_APPEND_SUCCEEDED = False\n618\t-    try:\n619\t-        pid = os.getpid()\n620\t-        record_id = uuid.uuid4().hex\n621\t-        spool_p = _spool_path(pid)\n622\t-        # Per-PID spool flock — ADR-055-AMEND-1 §4 Phase 1: writers acquire\n623\t-        # only their own spool's flock + journal's flock (never canonical).\n624\t-        try:\n625\t-            spool_flock = FileLock(\n626\t-                _spool_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT,\n627\t-            )\n628\t-        except OSError as e:\n629\t-            _breadcrumb(f\"spool flock alloc failed: {type(e).__name__}: {e}\")\n630\t-            return\n631\t-        try:\n632\t-            with spool_flock:\n633\t-                _IN_SPOOL_APPEND = True\n634\t-                try:\n635\t-                    # The body fsync below covers the new header on this same\n636\t-                    # inode too. Do not acknowledge or journal a commit until\n637\t-                    # that fsync succeeds. No event durability is deferred.\n638\t-                    header = _ensure_spool_header(pid, sync_header=False)\n639\t-                    # iter3-P1-1: isolate any unterminated final line from a\n640\t-                    # prior crashed writer BEFORE we mint our ordinal so the\n641\t-                    # new entry can't be silently lost via concatenation.\n642\t-                    _ensure_spool_ready_for_append(pid)\n643\t-                    spool_uuid = header[\"_spool_uuid\"]\n644\t-                    ordinal = _next_ordinal(pid)\n645\t-\n646\t-                    stamped: Dict[str, Any] = dict(entry)\n647\t-                    stamped.setdefault(\"wall_ns\", time.time_ns())\n648\t-                    stamped[\"pid\"] = pid\n649\t-                    stamped[\"spool_uuid\"] = spool_uuid\n650\t-                    stamped[\"ordinal_within_file\"] = ordinal\n651\t-                    # P1-3: carry record_id through the spool so Phase 5\n652\t-                    # can emit op:\"drained\" with matching id.\n653\t-                    stamped[\"record_id\"] = record_id\n654\t-\n655\t-                    try:\n656\t-                        line_bytes = json.dumps(\n657\t-                            stamped, separators=(\",\", \":\"),\n658\t-                            ensure_ascii=False,\n659\t-                        ).encode(\"utf-8\") + b\"\\n\"\n660\t-                    except (TypeError, ValueError) as e:\n661\t-                        _breadcrumb(\n662\t-                            f\"spool encode failed: {type(e).__name__}: {e}\"\n663\t-                        )\n664\t-                        return\n665\t-\n666\t-                    sha = hashlib.sha256(line_bytes).hexdigest()\n667\t-\n668\t-                    _write_journal_envelope(\n669\t-                        pid, record_id, spool_uuid, ordinal, sha, \"begin\",\n670\t-                    )\n671\t-\n672\t-                    try:\n673\t-                        fd = os.open(\n674\t-                            str(spool_p),\n675\t-                            os.O_WRONLY | os.O_CREAT | os.O_APPEND,\n676\t-                            0o600,\n677\t-                        )\n678\t-                        try:\n679\t-                            os.write(fd, line_bytes)\n680\t-                            os.fsync(fd)\n681\t-                        finally:\n682\t-                            os.close(fd)\n683\t-                    except OSError as e:\n684\t-                        _breadcrumb(\n685\t-                            f\"spool append failed: {type(e).__name__}: {e}\"\n686\t-                        )\n687\t-                        return\n688\t-\n689\t-                    _write_journal_envelope(\n690\t-                        pid, record_id, spool_uuid, ordinal, sha, \"commit\",\n691\t-                    )\n692\t-                    _LAST_APPEND_SUCCEEDED = True\n693\t-                finally:\n694\t-                    _IN_SPOOL_APPEND = False\n695\t-        except FileLockTimeout:\n696\t-            _IN_SPOOL_APPEND = False\n697\t-            _breadcrumb(f\"spool flock timeout pid={pid}\")\n698\t-            return\n699\t-    except Exception as e:  # fail-open invariant\n700\t-        _IN_SPOOL_APPEND = False\n701\t-        _breadcrumb(f\"spool_append unexpected: {type(e).__name__}: {e}\")\n702\t-\n703\t-\n704\t-# ---------------------------------------------------------------------------\n705\t-# Drain trigger\n706\t-# ---------------------------------------------------------------------------\n707\t-\n708\t-\n709\t-def should_drain() -> bool:\n710\t-    \"\"\"Return True if current spool meets event-count or staleness trigger.\n711\t-\n712\t-    P2-1: event-count trigger uses an actual newline-count over the spool\n713\t-    body (capped at DRAIN_TRIGGER_SIZE + 2 to keep the probe cheap), NOT\n714\t-    a byte-size proxy. Header is 1 line; we trigger when body lines >=\n715\t-    DRAIN_TRIGGER_SIZE.\n716\t-    \"\"\"\n717\t-    try:\n718\t-        pid = os.getpid()\n719\t-        p = _spool_path(pid)"}]},"parent_tool_use_id":null,"session_id":"91f7b0d1-4b6c-452f-a17c-4e8edc70c372","uuid":"91f70493-e4f4-4b04-bd7c-0b763d4f0eeb","timestamp":"2026-11-16T18:48:08.077Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/plans/PLAN-198/repass-rc1/diff-rc1-19.patch","content":"-# PLAN-094-FOLLOWUP Wave A.3-fail-open (option B) — module-level durability\n-# indicator for the last `spool_append()` call. audit_emit wire-in checks\n-# `last_append_succeeded()` after each call; on False, falls through to the\n-# sync canonical write path. Preserves the existing fail-open invariant\n-# (`spool_append` never raises to caller) while restoring durability defense\n-# depth on per-PID spool flock alloc / encode / OSError / unexpected paths.\n _LAST_APPEND_SUCCEEDED = True\n-\n-\n def last_append_succeeded() -> bool:\n-    \"\"\"Return True if the most recent spool_append() persisted durably.\n-\n-    audit_emit wire-in uses this to decide whether to fall back to the\n-    sync canonical write path (False = silent-drop on spool side; sync\n-    is now responsible for durability of THIS event).\n-    \"\"\"\n+    \"\"\"Whether the last spool_append persisted durably.\"\"\"\n     return _LAST_APPEND_SUCCEEDED\n \n-# P1-2 journal buffer state (per-PID amortized fsync).\n-# Buffer envelopes in memory; flush + fsync at: drain boundary, signal,\n-# atexit, or every _JOURNAL_FLUSH_EVERY writes. ADR-055-AMEND-1 §3 line 96:\n-# \"journal fsync every 100ms OR 10 emits\".\n+# Per-PID journal buffer; flush at drain boundaries or every ten writes.\n _JOURNAL_FLUSH_EVERY = 10\n@@ -684,4 +551,2 @@ def set_forensic_emitter(emit_fn: Callable[[str, Dict[str, Any]], None]) -> None\n     _FORENSIC_EMIT = emit_fn\n-\n-\n def _forensic(action: str, fields: Dict[str, Any]) -> None:\n@@ -706,9 +571,2 @@ def _forensic(action: str, fields: Dict[str, Any]) -> None:\n         _IN_FORENSIC_EMIT = False\n-\n-\n-# ---------------------------------------------------------------------------\n-# Spool header / append (Phase 0 — writer-side)\n-# ---------------------------------------------------------------------------\n-\n-\n def _origin_for_new_spool() -> str:\n@@ -729,1984 +587,4 @@ def _origin_for_new_spool() -> str:\n \n+from _lib._spool_writer_parts import install as _install_parts\n \n-def _ensure_spool_header(\n-    pid: int, _retry_depth: int = 0, *, sync_header: bool = True,\n-) -> Dict[str, Any]:\n-    \"\"\"Return the header dict for the current spool, creating it if absent.\n-\n-    Header is written exactly once per spool file (first line). Fresh\n-    _spool_uuid minted on creation so body[i].spool_uuid sentinel matches.\n-\n-    iter2-P1-4: existing nonempty spool with empty header cache (PID reuse,\n-    module reload, pytest reset) → parse existing header + reuse uuid;\n-    minting a new one would produce header_body_uuid_mismatch quarantine.\n-    iter4-P1-1: ordinal recovery via body-line parse (max(ordinal)+1), NOT\n-    `\\n` count — robust against unterminated final line from crashed writer.\n-    iter4-P1-2: malformed-header → quarantine active spool via direct\n-    rename (NOT drain_now() — Phase 2 self-deadlocks on our flock) +\n-    fresh-mint retry (bounded depth=1).\n-\n-    Only spool_append may defer the header fsync: it holds the spool lock\n-    and fsyncs the SAME file after writing the first event, before commit\n-    or acknowledging success. That sync persists both header and body.\n-    Standalone callers keep the durable-header default.\n-    \"\"\"\n-    header = _SPOOL_HEADER_CACHE.get(pid)\n-    spool_p = _spool_path(pid)\n-\n-    if header is not None and spool_p.exists():\n-        return header\n-\n-    # iter2-P1-4: existing nonempty spool with no in-process header cache.\n-    # Read the existing header instead of minting a colliding new one.\n-    # iter5-P1: header reuse MUST apply the same strict 4-field validation\n-    # that Phase 2 applies (_validate_spool_header_strict). Accepting a\n-    # semantically incomplete header here lets new appends ride a file\n-    # that Phase 2 will later quarantine → silent loss of the new events.\n-    if spool_p.exists():\n-        try:\n-            st = spool_p.stat()\n-        except OSError:\n-            st = None\n-        if st is not None and st.st_size > 0:\n-            header_parsed_ok = False\n-            try:\n-                with spool_p.open(\"rb\") as fh:\n-                    first = fh.readline()\n-                existing: Any = json.loads(first.decode(\"utf-8\"))\n-                if _validate_spool_header_strict(existing):\n-                    _SPOOL_HEADER_CACHE[pid] = existing\n-                    # iter4-P1-1: ordinal recovery via body parse (NOT\n-                    # `\\n`-count) — robust against unterminated final line.\n-                    _ORDINAL_COUNTER[pid] = _recover_ordinal_counter(spool_p)\n-                    header_parsed_ok = True\n-                    return existing\n-            except (OSError, json.JSONDecodeError, UnicodeDecodeError) as e:\n-                _breadcrumb(\n-                    f\"existing spool header unparsable pid={pid}: \"\n-                    f\"{type(e).__name__}: {e}\"\n-                )\n-            if not header_parsed_ok:\n-                # iter4-P1-2: do NOT call drain_now from inside the spool\n-                # flock (Phase 2 re-acquires this flock → self-timeout →\n-                # bail → caller appends to malformed spool → quarantine\n-                # silently loses the new event). Quarantine the file\n-                # directly (rename to `.corrupt-header.<epoch>`) and mint\n-                # a fresh header. Bounded retry depth = 1.\n-                #\n-                # iter6-P1: if quarantine FAILS (rename OSError), we MUST\n-                # NOT mint over the still-present corrupt file — that\n-                # lets new events land behind a header Phase 2 will\n-                # quarantine (silent data loss). Raise a specific\n-                # exception so caller (`spool_append`) aborts fail-open.\n-                quarantined = _quarantine_corrupt_active_spool(spool_p, pid)\n-                # Drop any stale in-memory state for this pid.\n-                _SPOOL_HEADER_CACHE.pop(pid, None)\n-                _ORDINAL_COUNTER.pop(pid, None)\n-                if not quarantined:\n-                    if _retry_depth >= 1:\n-                        # iter6-P1: exhausted retry AND quarantine still\n-                        # failing → abort current append fail-open.\n-                        # spool_append's outer try/except catches OSError\n-                        # and breadcrumbs. The corrupt file remains on\n-                        # disk for operator forensic recovery; Phase 2\n-                        # may eventually quarantine via its own path\n-                        # (header still fails _validate_spool_header_strict).\n-                        raise _SpoolHeaderUnrecoverable(\n-                            f\"pid={pid}: quarantine of corrupt active spool \"\n-                            f\"failed after {_retry_depth + 1} attempt(s); \"\n-                            f\"aborting append fail-open\"\n-                        )\n-                    return _ensure_spool_header(\n-                        pid, _retry_depth=_retry_depth + 1,\n-                        sync_header=sync_header,\n-                    )\n-                # Quarantine succeeded → fall through to fresh-mint path.\n-\n-    header = {\n-        \"_spool_header\": True,\n-        \"_spool_uuid\": secrets.token_hex(8),\n-        \"_pid\": pid,\n-        \"_created_wall_ns\": time.time_ns(),\n-        \"_created_monotonic_ns\": time.monotonic_ns(),\n-        \"_version\": SPOOL_HEADER_VERSION,\n-        # PLAN-119 WS-D1 — sticky write-time origin stamp (minted once per PID\n-        # file). The drainer refuses to drain \"test\" spool into the LIVE chain.\n-        \"_origin\": _origin_for_new_spool(),\n-    }\n-    spool_p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)\n-    needs_header = (not spool_p.exists()) or spool_p.stat().st_size == 0\n-    if needs_header:\n-        line = json.dumps(header, separators=(\",\", \":\"), ensure_ascii=False) + \"\\n\"\n-        # O_CREAT|O_WRONLY|O_APPEND with 0600 perms — owner-only.\n-        fd = os.open(str(spool_p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)\n-        try:\n-            os.write(fd, line.encode(\"utf-8\"))\n-            if sync_header:\n-                os.fsync(fd)\n-        finally:\n-            os.close(fd)\n-    _SPOOL_HEADER_CACHE[pid] = header\n-    _ORDINAL_COUNTER.setdefault(pid, 0)\n-    return header\n-\n-\n-def _next_ordinal(pid: int) -> int:\n-    \"\"\"Return the next strictly-monotonic ordinal for a given pid.\"\"\"\n-    n = _ORDINAL_COUNTER.get(pi