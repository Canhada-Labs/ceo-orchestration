{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HcHCCmx4y3Y3U9wunJUMNJ","type":"tool_result","content":"1380\t-# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n1381\t-#\n1382\t-# Rail 1 — Tool allow-list: a spawn profile MAY declare\n1383\t-#     ## TOOL ALLOW-LIST\n1384\t-#     - Read\n1385\t-#     - Edit\n1386\t-#     - Bash\n1387\t-# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n1388\t-# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n1389\t-# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n1390\t-#\n1391\t-# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n1392\t-# depth-2 spawn. The harness Agent payload has no native depth field, so we\n1393\t-# read the advisory marker the CEO injects into a delegated prompt\n1394\t-# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n1395\t-# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n1396\t-#\n1397\t-# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n1398\t-# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n1399\t-# other spawns recorded in the audit log within a short concurrency window\n1400\t-# (same session, same plan). Any shared concrete path = clobber risk.\n1401\t-\n1402\t-# --- Rail 1: tool allow-list ----------------------------------------------\n1403\t-_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n1404\t-    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n1405\t-    flags=re.MULTILINE,\n1406\t-)\n1407\t-# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n1408\t-_TOOL_BULLET_RE = re.compile(\n1409\t-    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n1410\t-    flags=re.MULTILINE,\n1411\t-)\n1412\t-# Canonical Claude Code tool names we recognize (closed set — anything not\n1413\t-# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n1414\t-# unknown token can never cause a false block).\n1415\t-_KNOWN_TOOL_NAMES = frozenset({\n1416\t-    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n1417\t-    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n1418\t-})\n1419\t-# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n1420\t-# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n1421\t-# a profile that simply mentions a word does not trip the rail.\n1422\t-_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n1423\t-    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n1424\t-              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n1425\t-    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n1426\t-    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n1427\t-    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n1428\t-    (\"websearch\", (\"search the web\", \"web search\")),\n1429\t-)\n1430\t-_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n1431\t-\n1432\t-# --- Rail 2: depth fence ---------------------------------------------------\n1433\t-_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n1434\t-    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n1435\t-    flags=re.MULTILINE,\n1436\t-)\n1437\t-\n1438\t-# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n1439\t-# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n1440\t-# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n1441\t-# Markdown renderer/agent — recognizing them (instead of enumerating\n1442\t-# taints) keeps the parser aligned with what the agent SEES.\n1443\t-_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n1444\t-    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n1445\t-    flags=re.MULTILINE | re.IGNORECASE,\n1446\t-)\n1447\t-# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n1448\t-# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n1449\t-# make the line a CommonMark CODE BLOCK — example text, never a grant.\n1450\t-_CAN_EDIT_LINE_RE = re.compile(\n1451\t-    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n1452\t-    flags=re.MULTILINE | re.IGNORECASE,\n1453\t-)\n1454\t-# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n1455\t-# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n1456\t-# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n1457\t-# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n1458\t-# match a CLOSED whitelist of recognized forms — anything else is a\n1459\t-# visible grant/instruction the parser did not validate => taint.\n1460\t-_FA_LIST_LINE_RE = re.compile(\n1461\t-    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n1462\t-    flags=re.MULTILINE,\n1463\t-)\n1464\t-_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n1465\t-    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n1466\t-    flags=re.IGNORECASE,\n1467\t-)\n1468\t-_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n1469\t-    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n1470\t-    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n1471\t-    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n1472\t-    r\"|FORBIDDEN\\b\"             # architect forbidden list\n1473\t-    # canonical template escape-hatch prose — the FULL fixed phrase, so\n1474\t-    # the prefix CONSUMES its own `edit` and the suffix rule below can\n1475\t-    # ban any further edit-grant text (codex r34 P1)\n1476\t-    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n1477\t-    r\")\",\n1478\t-    flags=re.IGNORECASE,\n1479\t-)\n1480\t-# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n1481\t-# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n1482\t-# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n1483\t-# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n1484\t-# authority). A token is a whitespace-delimited word stripped of edge\n1485\t-# punctuation; tokens containing / or . are path-like and never match.\n1486\t-_FA_AUTHORITY_WORDS = frozenset((\n1487\t-    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n1488\t-    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n1489\t-))\n1490\t-\n1491\t-\n1492\t-def _fa_suffix_has_authority(suffix: str) -> bool:\n1493\t-    \"\"\"True when the prose suffix carries a bare authority word.\"\"\"\n1494\t-    for tok in suffix.split():\n1495\t-        if \"/\" in tok or \".\" in tok:\n1496\t-            continue  # path-like token — filename parts are not authority\n1497\t-        if tok.strip(\";:,()[]{}'\\\"!?-\").lower() in _FA_AUTHORITY_WORDS:\n1498\t-            return True\n1499\t-    return False\n1500\t-\n1501\t-\n1502\t-def _fa_list_line_allowed(line: str) -> bool:\n1503\t-    \"\"\"Closed whitelist for list lines inside a FILE ASSIGNMENT block.\n1504\t-\n1505\t-    Anchored semantics (codex r33+r34 P1): a PROSE form may not smuggle\n1506\t-    ANY edit grant in its suffix — `- MAY read docs; MUST edit x` and\n1507\t-    `- If you need permission: CAN edit: x` are tainted, not laundered.\n1508\t-    Each prose prefix consumes its own `edit` (when it has one); any\n1509\t-    FURTHER `edit` word after the matched prefix rejects the line.\n1510\t-    \"\"\"\n1511\t-    if _FA_ALLOWED_GRANT_LINE_RE.match(line):\n1512\t-        return True\n1513\t-    m = _FA_ALLOWED_PROSE_LINE_RE.match(line)\n1514\t-    if m:\n1515\t-        return not _fa_suffix_has_authority(line[m.end():])\n1516\t-    return False\n1517\t-_OVERLAP_LOOKBACK_S = 600          # 10-minute concurrency window\n1518\t-_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n1519\t-_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n1520\t-\n1521\t-\n1522\t-def _parse_tool_allowlist(prompt: str) -> Optional[frozenset]:\n1523\t-    \"\"\"Return the declared lowercase tool allow-list, or None if no\n1524\t-    `## TOOL ALLOW-LIST` block is present (= unrestricted, back-compat).\n1525\t-\n1526\t-    Pure. Never raises. Bounded to the block between its header and the next\n1527\t-    `##` heading. Only KNOWN tool names are retained; unknown tokens dropped\n1528\t-    (so a typo cannot create a phantom allow-list that blocks everything).\n1529\t-    \"\"\"\n1530\t-    if not prompt:\n1531\t-        return None\n1532\t-    sanitized = _strip_fenced_and_comments(prompt)\n1533\t-    m = _TOOL_ALLOWLIST_HEADER_RE.search(sanitized)\n1534\t-    if m is None:\n1535\t-        return None\n1536\t-    block_start = m.end()\n1537\t-    nxt = _NEXT_H2_RE.search(sanitized, block_start)\n1538\t-    block = sanitized[block_start: nxt.start() if nxt else len(sanitized)]\n1539\t-    allowed = set()\n1540\t-    for bm in _TOOL_BULLET_RE.finditer(block):\n1541\t-        for tok in bm.group(1).replace(\",\", \" \").split():\n1542\t-            t = tok.strip().lower()\n1543\t-            if t in _KNOWN_TOOL_NAMES:\n1544\t-                allowed.add(t)\n1545\t-    # An empty-but-present block = \"deny all known tools\" (intentional).\n1546\t-    return frozenset(allowed)\n1547\t-\n1548\t-\n1549\t-def _requested_tools(prompt: str) -> frozenset:\n1550\t-    \"\"\"Heuristic set of KNOWN tools this spawn appears to request.\n1551\t-\n1552\t-    First-hit per family, bounded scan. Conservative (high-signal verbs only).\n1553\t-    Pure; never raises.\n1554\t-    \"\"\"\n1555\t-    if not prompt:\n1556\t-        return frozenset()\n1557\t-    text = _strip_fenced_and_comments(prompt)[:_TOOL_SCAN_WINDOW].lower()\n1558\t-    out = set()\n1559\t-    for tool, hints in _TOOL_REQUEST_HINTS:\n1560\t-        if any(h in text for h in hints):\n1561\t-            out.add(tool)\n1562\t-    return frozenset(out)\n1563\t-\n1564\t-\n1565\t-def _check_tool_scope(\n1566\t-    prompt: str,\n1567\t-) -> Optional[Tuple[str, str]]:\n1568\t-    \"\"\"Rail 1. Return (reason_code, detail) if a requested tool is OUTSIDE\n1569\t-    the declared allow-list, else None.\n1570\t-\n1571\t-    `detail` NEVER contains a path or the raw prompt — only the offending\n1572\t-    tool NAME(s) (a closed-enum-safe value) + counts. No-value-echo safe.\n1573\t-    \"\"\"\n1574\t-    allow = _parse_tool_allowlist(prompt)\n1575\t-    if allow is None:\n1576\t-        return None  # no declared scope -> unrestricted (back-compat)\n1577\t-    requested = _requested_tools(prompt)\n1578\t-    out_of_scope = sorted(requested - allow)\n1579\t-    if not out_of_scope:\n1580\t-        return None\n1581\t-    return (\n1582\t-        \"spawn_tool_out_of_scope\",\n1583\t-        f\"tools={','.join(out_of_scope)} declared={len(allow)}\",\n1584\t-    )\n1585\t-\n1586\t-\n1587\t-def _spawn_depth(prompt: str, env: Dict[str, str]) -> int:\n1588\t-    \"\"\"Best-effort current spawn depth. 0 = top-level CEO spawn.\n1589\t-\n1590\t-    Two independent signals, max() wins (fail-toward-detection):\n1591\t-      - `## SUBAGENT-CONTEXT depth=N` marker in the prompt (CEO-injected when\n1592\t-        delegating to a sub-agent that may itself coordinate).\n1593\t-      - `CEO_SPAWN_DEPTH` env breadcrumb (harness/CEO-set).\n1594\t-    Pure-ish (reads env dict only). Never raises.\n1595\t-    \"\"\"\n1596\t-    depth = 0\n1597\t-    try:\n1598\t-        m = _SUBAGENT_DEPTH_MARKER_RE.search(prompt or \"\")\n1599\t-        if m:\n1600\t-            depth = max(depth, int(m.group(1)))\n1601\t-    except Exception:  # pragma: no cover - fail-open\n1602\t-        pass\n1603\t-    try:\n1604\t-        raw = (env.get(\"CEO_SPAWN_DEPTH\") or \"\").strip()\n1605\t-        if raw.isdigit():\n1606\t-            depth = max(depth, int(raw))\n1607\t-    except Exception:  # pragma: no cover - fail-open\n1608\t-        pass\n1609\t-    return depth\n1610\t-\n1611\t-\n1612\t-# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n1613\t-# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n1614\t-# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n1615\t-# ADR-191 cures): read-only intent must be spelled out with this token.\n1616\t-_FA_READONLY_TOKEN = \"none-read-only\"\n1617\t-\n1618\t-# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n1619\t-# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n1620\t-# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n1621\t-# CommonMark) would leak into classification and could satisfy the gate\n1622\t-# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n1623\t-# radius; the shared regex serves every other block parser unchanged).\n1624\t-# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n1625\t-# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n1626\t-# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n1627\t-# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n1628\t-# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n1629\t-# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n1630\t-# Closer must be the SAME character, length >= opener (codex r37 P2:\n1631\t-# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n1632\t-# the fence char; closer = \\1 (full opener string) + \\2* (same char\n1633\t-# only). A shorter/mismatched closer falls through to \\Z — masking to\n1634\t-# EOF, the fail-CLOSED direction.\n1635\t-_FA_FENCE_RE = re.compile(\n1636\t-    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n1637\t-    flags=re.MULTILINE | re.DOTALL,\n1638\t-)\n1639\t-\n1640\t-# Telemetry marker hash for the explicit read-only declaration. DOMAIN-\n1641\t-# SEPARATED from real path hashes (codex r1 P2, Lote B): hashing the bare\n1642\t-# token collided with a legitimate concrete path `./none-read-only` (the\n1643\t-# token check runs BEFORE ./-normalization, so that path survives as\n1644\t-# concrete and would hash identically — under CEO_SPAWN_OVERLAP_GUARD=1 it\n1645\t-# would false-block against every prior read-only spawn). NUL bytes cannot\n1646\t-# appear in a real declared path, so this input is unreachable from\n1647\t-# _path_hash(path) space.\n1648\t-\n1649\t-\n1650\t-def _classify_file_assignment(prompt: str) -> Tuple[str, frozenset]:\n1651\t-    \"\"\"Classify the spawn's `## FILE ASSIGNMENT` declaration (PLAN-178 C1).\n1652\t-\n1653\t-    Returns ``(state, concrete_paths)`` with ``state`` in a closed enum:\n1654\t-\n1655\t-    - ``\"absent\"``      — no `## FILE ASSIGNMENT` header in the sanitized\n1656\t-      prompt (fenced/comment content never counts — same masking rule as\n1657\t-      every other block parser in this hook).\n1658\t-    - ``\"concrete\"``    — >=1 concrete `CAN edit:` path AND zero dropped\n1659\t-      tokens (codex r15 P1: `safe.py, src/**` must NOT classify concrete —"}]},"parent_tool_use_id":null,"session_id":"91f7b0d1-4b6c-452f-a17c-4e8edc70c372","uuid":"578ce9c2-7038-4f82-9253-9c3e0ab6a8cc","timestamp":"2026-11-16T18:47:37.270Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/plans/PLAN-198/repass-rc1/diff-rc1-20.patch","content":"-# under their per-rail env flag. NEVER raises (fail-open per CLAUDE.md §5).\n-#\n-# Rail 1 — Tool allow-list: a spawn profile MAY declare\n-#     ## TOOL ALLOW-LIST\n-#     - Read\n-#     - Edit\n-#     - Bash\n-# When declared AND the prompt's ## TASK/## RESTRICTIONS text requests a tool\n-# OUTSIDE that set (heuristic keyword scan, bounded), emit/block. A profile\n-# with NO ## TOOL ALLOW-LIST block is unrestricted (back-compat: silent allow).\n-#\n-# Rail 2 — Depth fence: a sub-agent that itself emits a NAMED spawn is a\n-# depth-2 spawn. The harness Agent payload has no native depth field, so we\n-# read the advisory marker the CEO injects into a delegated prompt\n-# (## SUBAGENT-CONTEXT depth=N) AND the env breadcrumb CEO_SPAWN_DEPTH. If\n-# EITHER says depth>=1 AND this spawn is itself NAMED, it is depth-over-one.\n-#\n-# Rail 3 — FILE ASSIGNMENT overlap: parse this spawn's `CAN edit:` file list\n-# from its ## FILE ASSIGNMENT block, compare against the `CAN edit:` lists of\n-# other spawns recorded in the audit log within a short concurrency window\n-# (same session, same plan). Any shared concrete path = clobber risk.\n-\n-# --- Rail 1: tool allow-list ----------------------------------------------\n-_TOOL_ALLOWLIST_HEADER_RE = re.compile(\n-    r\"^##[ \\t]+TOOL[ \\t]+ALLOW-?LIST[ \\t]*$\",\n-    flags=re.MULTILINE,\n-)\n-# A bullet line inside the block: \"- Read\" / \"* Bash\" / \"Read,Edit\".\n-_TOOL_BULLET_RE = re.compile(\n-    r\"^[ \\t]*[-*][ \\t]*([A-Za-z][A-Za-z0-9_/ ,]+)$\",\n-    flags=re.MULTILINE,\n-)\n-# Canonical Claude Code tool names we recognize (closed set — anything not\n-# here in a request is ignored, NOT blocked; we only gate KNOWN tools so an\n-# unknown token can never cause a false block).\n-_KNOWN_TOOL_NAMES = frozenset({\n-    \"read\", \"edit\", \"write\", \"multiedit\", \"bash\", \"glob\", \"grep\",\n-    \"webfetch\", \"websearch\", \"task\", \"agent\", \"notebookedit\",\n-})\n-# Heuristic: which tools a spawn is REQUESTING, inferred from prompt text.\n-# First-hit, bounded scan. Conservative — only fires on high-signal verbs so\n-# a profile that simply mentions a word does not trip the rail.\n-_TOOL_REQUEST_HINTS: Tuple[Tuple[str, Tuple[str, ...]], ...] = (\n-    (\"bash\", (\"run the command\", \"run `\", \"execute the script\", \"shell out\",\n-              \"git commit\", \"git push\", \"npm install\", \"curl \", \"subprocess\")),\n-    (\"write\", (\"create the file\", \"write a new file\", \"write the file\")),\n-    (\"edit\", (\"edit the file\", \"modify the file\", \"apply the patch\")),\n-    (\"webfetch\", (\"fetch the url\", \"download from http\", \"fetch http\")),\n-    (\"websearch\", (\"search the web\", \"web search\")),\n-)\n-_TOOL_SCAN_WINDOW = 8 * 1024  # bytes of prompt scanned for tool hints\n-\n-# --- Rail 2: depth fence ---------------------------------------------------\n-_SUBAGENT_DEPTH_MARKER_RE = re.compile(\n-    r\"^##[ \\t]+SUBAGENT-CONTEXT\\b[^\\n]*\\bdepth=(\\d+)\",\n-    flags=re.MULTILINE,\n-)\n-\n-# --- Rail 3: FILE ASSIGNMENT overlap --------------------------------------\n-# Case-insensitive + 0-3 space indent (codex r32 P1): `## File\n-# Assignment` and ` ## FILE ASSIGNMENT` are the SAME heading to a\n-# Markdown renderer/agent — recognizing them (instead of enumerating\n-# taints) keeps the parser aligned with what the agent SEES.\n-_FILE_ASSIGNMENT_HEADER_RE = re.compile(\n-    r\"^[ ]{0,3}##[ \\t]+FILE[ \\t]+ASSIGNMENT[ \\t]*$\",\n-    flags=re.MULTILINE | re.IGNORECASE,\n-)\n-# \"- CAN edit: a/b.py, c/d.py\" (rest of line after the colon, comma-split).\n-# Leading indent 0-3 SPACES only (codex r33 P1): 4+ spaces (or a tab)\n-# make the line a CommonMark CODE BLOCK — example text, never a grant.\n-_CAN_EDIT_LINE_RE = re.compile(\n-    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:[ \\t]*(.+)$\",\n-    flags=re.MULTILINE | re.IGNORECASE,\n-)\n-# STRUCTURAL closure of the parser-differential class (codex r25→r32:\n-# MAY/MUST edit, `+`/numbered markers, header variants — each enumerated\n-# fix bred the next variant). ONE rule instead: inside a FILE ASSIGNMENT\n-# block, every LIST line (any CommonMark marker: -, *, +, 1., 1)) must\n-# match a CLOSED whitelist of recognized forms — anything else is a\n-# visible grant/instruction the parser did not validate => taint.\n-_FA_LIST_LINE_RE = re.compile(\n-    r\"^[ ]{0,3}(?:[-*+]|\\d+[.)])[ \\t]+\\S[^\\n]*$\",\n-    flags=re.MULTILINE,\n-)\n-_FA_ALLOWED_GRANT_LINE_RE = re.compile(\n-    r\"^[ ]{0,3}[-*+][ \\t]*CAN[ \\t]+edit:\",\n-    flags=re.IGNORECASE,\n-)\n-_FA_ALLOWED_PROSE_LINE_RE = re.compile(\n-    r\"^[ ]{0,3}[-*+][ \\t]*(?:\"\n-    r\"CANNOT[ \\t]+edit\"        # negative prose (not parsed, harmless)\n-    r\"|MAY[ \\t]+read\\b\"        # architect read declaration\n-    r\"|FORBIDDEN\\b\"             # architect forbidden list\n-    # canonical template escape-hatch prose — the FULL fixed phrase, so\n-    # the prefix CONSUMES its own `edit` and the suffix rule below can\n-    # ban any further edit-grant text (codex r34 P1)\n-    r\"|If[ \\t]+you[ \\t]+need[ \\t]+to[ \\t]+edit[ \\t]+a[ \\t]+forbidden[ \\t]+file\"\n-    r\")\",\n-    flags=re.IGNORECASE,\n-)\n-# Authority words banned in an allowed-prose SUFFIX (codex r34+r41+r42:\n-# the axis moved from `edit` to synonyms — `MUST write hidden.py`).\n-# WHOLE-TOKEN semantics, not substring (r42 FP: a denied path like\n-# `src/write.py` carries \"write\" INSIDE a path token — filenames are not\n-# authority). A token is a whitespace-delimited word stripped of edge\n-# punctuation; tokens containing / or . are path-like and never match.\n-_FA_AUTHORITY_WORDS = frozenset((\n-    \"edit\", \"write\", \"create\", \"modify\", \"delete\", \"append\", \"overwrite\",\n-    \"rename\", \"move\", \"must\", \"should\", \"allowed\",\n-))\n-\n-\n-def _fa_suffix_has_authority(suffix: str) -> bool:\n-    \"\"\"True when the prose suffix carries a bare authority word.\"\"\"\n-    for tok in suffix.split():\n-        if \"/\" in tok or \".\" in tok:\n-            continue  # path-like token — filename parts are not authority\n-        if tok.strip(\";:,()[]{}'\\\"!?-\").lower() in _FA_AUTHORITY_WORDS:\n-            return True\n-    return False\n-\n-\n-def _fa_list_line_allowed(line: str) -> bool:\n-    \"\"\"Closed whitelist for list lines inside a FILE ASSIGNMENT block.\n-\n-    Anchored semantics (codex r33+r34 P1): a PROSE form may not smuggle\n-    ANY edit grant in its suffix — `- MAY read docs; MUST edit x` and\n-    `- If you need permission: CAN edit: x` are tainted, not laundered.\n-    Each prose prefix consumes its own `edit` (when it has one); any\n-    FURTHER `edit` word after the matched prefix rejects the line.\n-    \"\"\"\n-    if _FA_ALLOWED_GRANT_LINE_RE.match(line):\n-        return True\n-    m = _FA_ALLOWED_PROSE_LINE_RE.match(line)\n-    if m:\n-        return not _fa_suffix_has_authority(line[m.end():])\n-    return False\n-_OVERLAP_LOOKBACK_S = 600          # 10-minute concurrency window\n-_OVERLAP_MAX_PATHS = 64            # bound the per-spawn path set\n-_OVERLAP_TAIL_LINES = 256          # bounded audit-log tail (~512KB)\n-\n-\n-def _parse_tool_allowlist(prompt: str) -> Optional[frozenset]:\n-    \"\"\"Return the declared lowercase tool allow-list, or None if no\n-    `## TOOL ALLOW-LIST` block is present (= unrestricted, back-compat).\n-\n-    Pure. Never raises. Bounded to the block between its header and the next\n-    `##` heading. Only KNOWN tool names are retained; unknown tokens dropped\n-    (so a typo cannot create a phantom allow-list that blocks everything).\n-    \"\"\"\n-    if not prompt:\n-        return None\n-    sanitized = _strip_fenced_and_comments(prompt)\n-    m = _TOOL_ALLOWLIST_HEADER_RE.search(sanitized)\n-    if m is None:\n-        return None\n-    block_start = m.end()\n-    nxt = _NEXT_H2_RE.search(sanitized, block_start)\n-    block = sanitized[block_start: nxt.start() if nxt else len(sanitized)]\n-    allowed = set()\n-    for bm in _TOOL_BULLET_RE.finditer(block):\n-        for tok in bm.group(1).replace(\",\", \" \").split():\n-            t = tok.strip().lower()\n-            if t in _KNOWN_TOOL_NAMES:\n-                allowed.add(t)\n-    # An empty-but-present block = \"deny all known tools\" (intentional).\n-    return frozenset(allowed)\n-\n-\n-def _requested_tools(prompt: str) -> frozenset:\n-    \"\"\"Heuristic set of KNOWN tools this spawn appears to request.\n-\n-    First-hit per family, bounded scan. Conservative (high-signal verbs only).\n-    Pure; never raises.\n-    \"\"\"\n-    if not prompt:\n-        return frozenset()\n-    text = _strip_fenced_and_comments(prompt)[:_TOOL_SCAN_WINDOW].lower()\n-    out = set()\n-    for tool, hints in _TOOL_REQUEST_HINTS:\n-        if any(h in text for h in hints):\n-            out.add(tool)\n-    return frozenset(out)\n-\n-\n-def _check_tool_scope(\n-    prompt: str,\n-) -> Optional[Tuple[str, str]]:\n-    \"\"\"Rail 1. Return (reason_code, detail) if a requested tool is OUTSIDE\n-    the declared allow-list, else None.\n-\n-    `detail` NEVER contains a path or the raw prompt — only the offending\n-    tool NAME(s) (a closed-enum-safe value) + counts. No-value-echo safe.\n-    \"\"\"\n-    allow = _parse_tool_allowlist(prompt)\n-    if allow is None:\n-        return None  # no declared scope -> unrestricted (back-compat)\n-    requested = _requested_tools(prompt)\n-    out_of_scope = sorted(requested - allow)\n-    if not out_of_scope:\n-        return None\n-    return (\n-        \"spawn_tool_out_of_scope\",\n-        f\"tools={','.join(out_of_scope)} declared={len(allow)}\",\n-    )\n-\n-\n-def _spawn_depth(prompt: str, env: Dict[str, str]) -> int:\n-    \"\"\"Best-effort current spawn depth. 0 = top-level CEO spawn.\n-\n-    Two independent signals, max() wins (fail-toward-detection):\n-      - `## SUBAGENT-CONTEXT depth=N` marker in the prompt (CEO-injected when\n-        delegating to a sub-agent that may itself coordinate).\n-      - `CEO_SPAWN_DEPTH` env breadcrumb (harness/CEO-set).\n-    Pure-ish (reads env dict only). Never raises.\n-    \"\"\"\n-    depth = 0\n-    try:\n-        m = _SUBAGENT_DEPTH_MARKER_RE.search(prompt or \"\")\n-        if m:\n-            depth = max(depth, int(m.group(1)))\n-    except Exception:  # pragma: no cover - fail-open\n-        pass\n-    try:\n-        raw = (env.get(\"CEO_SPAWN_DEPTH\") or \"\").strip()\n-        if raw.isdigit():\n-            depth = max(depth, int(raw))\n-    except Exception:  # pragma: no cover - fail-open\n-        pass\n-    return depth\n-\n-\n-# PLAN-178 C1 / ADR-191 — the ONLY valid explicit \"this spawn writes\n-# nothing\" declaration. The bare token `none` stays a DROPPED placeholder\n-# (indistinguishable from omission BY DESIGN — that ambiguity is the cell\n-# ADR-191 cures): read-only intent must be spelled out with this token.\n-_FA_READONLY_TOKEN = \"none-read-only\"\n-\n-# CommonMark fences indented 1-3 spaces (codex r29 P1): the shared\n-# `_strip_fenced_and_comments` masks column-zero fences only — a fenced\n-# FILE ASSIGNMENT example indented by 1-3 spaces (still a valid fence per\n-# CommonMark) would leak into classification and could satisfy the gate\n-# for a spawn with NO real assignment. Masked LOCALLY here (small blast\n-# radius; the shared regex serves every other block parser unchanged).\n-# CommonMark-correct fence masking for THIS classifier (codex r29+r30+\n-# r35): indent 0-3 (column zero included — the SHARED masker is a naive\n-# toggle that ignores opener type/length, so a 4-backtick opener \"closed\"\n-# by 3 backticks, or ``` closed by ~~~, leaks fenced content); closing\n-# fence must be the SAME char and >= opener length (\\1 + absorb longer);\n-# an unclosed fence masks to EOF (\\Z). Applied BEFORE the shared masker.\n-# Closer must be the SAME character, length >= opener (codex r37 P2:\n-# the old [`~]* suffix accepted a mixed ```~~~ \"close\"). Group 2 captures\n-# the fence char; closer = \\1 (full opener string) + \\2* (same char\n-# only). A shorter/mismatched closer falls through to \\Z — masking to\n-# EOF, the fail-CLOSED direction.\n-_FA_FENCE_RE = re.compile(\n-    r\"^[ ]{0,3}((`|~)\\2{2,})[^\\n]*\\n.*?(?:^[ ]{0,3}\\1\\2*[ \\t]*$|\\Z)\",\n-    flags=re.MULTILINE | re.DOTALL,\n-)\n-\n-# Telemetry marker hash for the ex