{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KoNvfWug1HM6HUL685mRHV","type":"tool_result","content":"165\t    \"peer_id\", \"route\", \"tamper_type\", \"prev_hash_prefix\",\n166\t}\n167\t\n168\t\n169\t# PLAN-113 Phase B B5 — RESERVED-no-producer registry. Each maps a registered\n170\t# `_KNOWN_ACTIONS` member that has ZERO production caller today to its gating\n171\t# ADR. The CI-guard test (test_audit_emit_ghost_action_guard.py) asserts (a)\n172\t# every member here is truly producer-less and (b) if a member ever GROWS a\n173\t# production caller, its gating ADR MUST be in ACCEPTED state — else fail.\n174\t# Verified against SPEC/v1/audit-log.schema.md governing-ADR columns:\n175\t#   - execution_context_* : ADR-133 §D (cross-process wiring DEFERRED, F-1.2)\n176\t#   - federation_autonomous_call_blocked : ADR-135 (PLAN-099 import-graph\n177\t#     denylist surface; AC18 helper exists but is never invoked)\n178\t#   - federation_hmac_secret_rotated : ADR-135-AMEND-1 §6 (Owner co-sign\n179\t#     rotate path not wired to a producer)\n180\t#   - federation_key_floor_rejected / _stale : ADR-129-AMEND-1 §3/§4\n181\t#     (key-floor enforcement is advisory-staged; no emit producer yet)\n182\t# NOTE: federation_tamper_detected / federation_message_storm_detected /\n183\t# federation_audit_log_backpressure are NOT reserved — they have live\n184\t# `_safe_emit` producers (audit_chain_ext.py / rate_limit.py) and get explicit\n185\t# dispatch-gate branches above.\n186\t_RESERVED_ACTIONS = {\n187\t    \"execution_context_signed\": \"ADR-133\",\n188\t    \"execution_context_validation_failed\": \"ADR-133\",\n189\t    \"federation_autonomous_call_blocked\": \"ADR-135\",\n190\t    \"federation_hmac_secret_rotated\": \"ADR-135-AMEND-1\",\n191\t    \"federation_key_floor_rejected\": \"ADR-129-AMEND-1\",\n192\t    \"federation_key_floor_stale\": \"ADR-129-AMEND-1\",\n193\t}\n194\t\n195\t\n196\t# PLAN-113 Phase B B-STRUCTURAL — emit_generic verbatim-passthrough registry.\n197\t# These `_KNOWN_ACTIONS` members are emitted via emit_generic by TRUSTED\n198\t# in-repo producers (their own typed wrappers in this module, or first-party\n199\t# hook/script producers) with controlled, pre-scrubbed field sets. They have\n200\t# no dedicated dispatch-gate scrub branch and their verbatim pass-through is\n201\t# the ACCEPTED pre-existing contract (each has direct field-presence coverage\n202\t# in test_audit_emit_coverage.py). They are explicitly enumerated here so the\n203\t# default-deny `else` in emit_generic can distinguish them from a genuinely\n204\t# unhandled / future / unexpected producer.\n205\t#\n206\t# INVARIANT (enforced by test_audit_emit_ghost_action_guard.py): every\n207\t# `_KNOWN_ACTIONS` member is EXACTLY ONE of: (a) has an explicit `action ==`\n208\t# dispatch-gate branch, (b) is in `_RESERVED_ACTIONS`, or (c) is in this\n209\t# passthrough set. Any member matching NONE of the three reaches the\n210\t# default-deny `else` (all caller kwargs dropped). A NEW action added to\n211\t# `_KNOWN_ACTIONS` therefore defaults to fail-closed (default-deny) until the\n212\t# author either gives it a scrub branch or consciously lists it here — the\n213\t# leak class cannot silently reopen.\n214\t_EMIT_GENERIC_PASSTHROUGH = frozenset({\n215\t    # admin_key_lifecycle_event MOVED out of passthrough (Codex R5 P1-2,\n216\t    # PLAN-135-FOLLOWUP) → dedicated _ADMIN_KEY_LIFECYCLE_EVENT_ALLOWLIST scrub\n217\t    # branch in emit_generic: Sec MF-3 deny-by-default + operation/reason\n218\t    # enum-value coercion enforced even against a direct emit_generic caller.\n219\t    \"agent_spawn\",\n220\t    \"audit_flush_dropped_count\",\n221\t    \"audit_spool_duplicate_tuple_rejected\",\n222\t    \"audit_spool_intentionally_deleted\",\n223\t    \"audit_spool_partial_line_discarded\",\n224\t    \"audit_spool_stale_recovered\",\n225\t    \"audit_spool_tamper_detected\",\n226\t    \"audit_spool_unexpected_skip\",\n227\t    \"audit_tokens_emitted\",\n228\t    \"audit_tokens_key_dropped\",\n229\t    \"audit_tokens_timeout\",\n230\t    # bash_canonical_bypass_invoked REMOVED from passthrough (PLAN-113 Codex P1):\n231\t    # routed through explicit _BASH_CANONICAL_BYPASS_INVOKED_ALLOWLIST scrub branch\n232\t    # so target_path_hash (12-hex sha256) is the ONLY path representation in the log\n233\t    # (replaces the old target_path_preview raw-path field; Sec MF-3 P1 fix).\n234\t    \"benchmark_run\",\n235\t    \"breaker_closed\",\n236\t    \"breaker_opened\",\n237\t    \"budget_bypass_used\",\n238\t    \"budget_exceeded\",\n239\t    \"canonical_edit_attempted\",\n240\t    \"canonical_edit_blocked\",\n241\t    \"capability_rollout_complete\",\n242\t    \"chain_reset_marker\",\n243\t    \"codex-reply\",\n244\t    \"confidence_gate\","}]},"parent_tool_use_id":null,"session_id":"05d43db1-9d87-44b2-ba52-8d3e41e19567","uuid":"c8984d50-a03f-41a0-be75-10d9c9130070","timestamp":"2026-11-16T18:57:52.404Z","tool_use_result":{"type":"text","file":{"filePath":".claude/hooks/_lib/_audit_emit_parts/federation_schemas.py","content":"    \"peer_id\", \"route\", \"tamper_type\", \"prev_hash_prefix\",\n}\n\n\n# PLAN-113 Phase B B5 — RESERVED-no-producer registry. Each maps a registered\n# `_KNOWN_ACTIONS` member that has ZERO production caller today to its gating\n# ADR. The CI-guard test (test_audit_emit_ghost_action_guard.py) asserts (a)\n# every member here is truly producer-less and (b) if a member ever GROWS a\n# production caller, its gating ADR MUST be in ACCEPTED state — else fail.\n# Verified against SPEC/v1/audit-log.schema.md governing-ADR columns:\n#   - execution_context_* : ADR-133 §D (cross-process wiring DEFERRED, F-1.2)\n#   - federation_autonomous_call_blocked : ADR-135 (PLAN-099 import-graph\n#     denylist surface; AC18 helper exists but is never invoked)\n#   - federation_hmac_secret_rotated : ADR-135-AMEND-1 §6 (Owner co-sign\n#     rotate path not wired to a producer)\n#   - federation_key_floor_rejected / _stale : ADR-129-AMEND-1 §3/§4\n#     (key-floor enforcement is advisory-staged; no emit producer yet)\n# NOTE: federation_tamper_detected / federation_message_storm_detected /\n# federation_audit_log_backpressure are NOT reserved — they have live\n# `_safe_emit` producers (audit_chain_ext.py / rate_limit.py) and get explicit\n# dispatch-gate branches above.\n_RESERVED_ACTIONS = {\n    \"execution_context_signed\": \"ADR-133\",\n    \"execution_context_validation_failed\": \"ADR-133\",\n    \"federation_autonomous_call_blocked\": \"ADR-135\",\n    \"federation_hmac_secret_rotated\": \"ADR-135-AMEND-1\",\n    \"federation_key_floor_rejected\": \"ADR-129-AMEND-1\",\n    \"federation_key_floor_stale\": \"ADR-129-AMEND-1\",\n}\n\n\n# PLAN-113 Phase B B-STRUCTURAL — emit_generic verbatim-passthrough registry.\n# These `_KNOWN_ACTIONS` members are emitted via emit_generic by TRUSTED\n# in-repo producers (their own typed wrappers in this module, or first-party\n# hook/script producers) with controlled, pre-scrubbed field sets. They have\n# no dedicated dispatch-gate scrub branch and their verbatim pass-through is\n# the ACCEPTED pre-existing contract (each has direct field-presence coverage\n# in test_audit_emit_coverage.py). They are explicitly enumerated here so the\n# default-deny `else` in emit_generic can distinguish them from a genuinely\n# unhandled / future / unexpected producer.\n#\n# INVARIANT (enforced by test_audit_emit_ghost_action_guard.py): every\n# `_KNOWN_ACTIONS` member is EXACTLY ONE of: (a) has an explicit `action ==`\n# dispatch-gate branch, (b) is in `_RESERVED_ACTIONS`, or (c) is in this\n# passthrough set. Any member matching NONE of the three reaches the\n# default-deny `else` (all caller kwargs dropped). A NEW action added to\n# `_KNOWN_ACTIONS` therefore defaults to fail-closed (default-deny) until the\n# author either gives it a scrub branch or consciously lists it here — the\n# leak class cannot silently reopen.\n_EMIT_GENERIC_PASST