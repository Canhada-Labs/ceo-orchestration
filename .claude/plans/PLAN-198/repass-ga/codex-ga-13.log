+                stats.quarantined_files += 1
+                collected = [c for c in collected if c[2] is not f]
+                partial_consumed.pop(path_key, None)
+                break
+            prev_ordinal = ordinal
+            key = (wall_ns, pid, spool_uuid, ordinal)
+            collected.append((key, obj, f, idx))
