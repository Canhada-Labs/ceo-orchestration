{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A2tKnAVZDJ4GUcEQMuU4JL","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tdef _format_native_block(native: Dict[str, Any]) -> List[str]:\n4\t    \"\"\"Human rendering of the W1.2 native cross-check block.\n5\t\n6\t    UNMATCHED residue from BOTH sides always appears — aggregated by\n7\t    (session, rail, agent_type) so every unmatched spawn is represented\n8\t    — each section headed by its COUNT. Full per-spawn detail lives in\n9\t    the ``--json`` output.\n10\t    \"\"\"\n11\t    lines: List[str] = []\n12\t    lines.append(\"\")\n13\t    lines.append(\n14\t        \"Native cross-check (PLAN-178 W1.2 — cross-check, not authority-swap):\"\n15\t    )\n16\t    lines.append(f\"  Native root     : {native.get('native_root')}\")\n17\t    if native.get(\"dormant\"):\n18\t        lines.append(f\"  Status          : DORMANT — {native.get('note')}\")\n19\t        return lines\n20\t    lines.append(\n21\t        f\"  Native spawns   : {native['native_spawn_count']:,} \"\n22\t        f\"(task={native['native_task_spawns']:,}, \"\n23\t        f\"workflow={native['native_workflow_spawns']:,})\"\n24\t    )\n25\t    lines.append(\n26\t        f\"  Audit spawns    : {native['audit_spawn_count']:,} \"\n27\t        f\"(agent_spawn events in scope)\"\n28\t    )\n29\t    lines.append(\n30\t        f\"  Matched pairs   : {native['matched_count']:,} \"\n31\t        f\"(token-comparable: {native['comparable_pair_count']:,})\"\n32\t    )\n33\t    tok = native.get(\"native_tokens\") or {}\n34\t    lines.append(\n35\t        f\"  Native tokens   : in={tok.get('in', 0):,} out={tok.get('out', 0):,} \"\n36\t        f\"cache_creation={tok.get('cache_creation', 0):,} \"\n37\t        f\"cache_read={tok.get('cache_read', 0):,}\"\n38\t    )\n39\t    cost = native.get(\"native_cost_usd\")\n40\t    tbd = int(native.get(\"native_cost_tbd_spawns\") or 0)\n41\t    if cost is None and tbd:\n42\t        cost_col = f\"TBD ({tbd:,} spawns without resolvable model/price)\"\n43\t    elif tbd:\n44\t        cost_col = (\n45\t            f\"${cost:,.4f} + TBD ({tbd:,} spawns without resolvable \"\n46\t            f\"model/price)\"\n47\t        )\n48\t    elif cost is None:\n49\t        cost_col = \"-\"\n50\t    else:\n51\t        cost_col = f\"${cost:,.4f}\"\n52\t    lines.append(f\"  Native cost     : {cost_col}\")\n53\t    lines.append(\n54\t        \"                    (cache priced as input-equivalents: read @0.10x\"\n55\t        \" — \" + _cache_read_exceptions_text() + \" —,\"\n56\t        \" write @1.25x — 5m-TTL assumption, docs/provider-pricing.md)\"\n57\t    )\n58\t    unreadable = int(native.get(\"native_transcripts_unreadable\", 0) or 0)\n59\t    if unreadable:\n60\t        lines.append(\n61\t            f\"  Skipped         : {unreadable} unreadable native transcript(s)\"\n62\t            \" excluded from totals and matching\"\n63\t        )\n64\t    max_div = native.get(\"max_divergence_pct_by_rail\") or {}\n65\t    div_cols = []\n66\t    for rail in (\"task\", \"workflow\"):\n67\t        v = max_div.get(rail)\n68\t        div_cols.append(f\"{rail}={v:.2f}%\" if v is not None else f\"{rail}=-\")\n69\t    div_note = \"\"\n70\t    if native[\"comparable_pair_count\"] == 0:\n71\t        div_note = (\n72\t            \" (no comparable pairs: audit-log spawn tokens are null in scope)\"\n73\t        )\n74\t    lines.append(f\"  Max divergence  : {' '.join(div_cols)}{div_note}\")\n75\t\n76\t    def _grouped(rows: List[Dict[str, Any]], with_rail: bool) -> List[str]:\n77\t        counts: Dict[Tuple[str, ...], int] = {}\n78\t        for r in rows:\n79\t            sess = str(r.get(\"session_id\") or \"(unknown)\")[:8]\n80\t            if with_rail:\n81\t                gkey = (sess, str(r.get(\"rail\") or \"?\"), str(r.get(\"agent_type\") or \"?\"))\n82\t            else:\n83\t                gkey = (sess, str(r.get(\"agent_type\") or \"?\"))\n84\t            counts[gkey] = counts.get(gkey, 0) + 1\n85\t        out = []\n86\t        for gkey in sorted(counts):\n87\t            if with_rail:\n88\t                out.append(\n89\t                    f\"    {gkey[0]:<8}  {gkey[1]:<8}  {gkey[2]:<28}  \"\n90\t                    f\"x{counts[gkey]}\"\n91\t                )\n92\t            else:\n93\t                out.append(f\"    {gkey[0]:<8}  {gkey[1]:<38}  x{counts[gkey]}\")\n94\t        return out\n95\t\n96\t    un_nat = native.get(\"unmatched_native\") or []\n97\t    lines.append(\n98\t        f\"  UNMATCHED — native side (no audit-log counterpart): \"\n99\t        f\"{native['unmatched_native_count']:,}\"\n100\t    )\n101\t    if un_nat:\n102\t        lines.extend(_grouped(un_nat, with_rail=True))\n103\t    else:\n104\t        lines.append(\"    (none)\")\n105\t    un_aud = native.get(\"unmatched_audit\") or []\n106\t    lines.append(\n107\t        f\"  UNMATCHED — audit-log side (no native counterpart): \"\n108\t        f\"{native['unmatched_audit_count']:,}\"\n109\t    )\n110\t    if un_aud:\n111\t        lines.extend(_grouped(un_aud, with_rail=False))\n112\t    else:\n113\t        lines.append(\"    (none)\")\n114\t    lines.append(\n115\t        \"  NOTE: the native source never replaces the audit-log totals \"\n116\t        \"above; the residue is shown in full because silencing it would \"\n117\t        \"fake a low divergence.\"\n118\t    )\n119\t    return lines\n120\t"}]},"parent_tool_use_id":null,"session_id":"554a7565-eb62-4598-9760-aeebd94af377","uuid":"2c619269-0d85-413c-9327-1c8bea4f66b6","timestamp":"2026-11-16T19:39:09.420Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/native_formatting.py","content":"from __future__ import annotations\n\ndef _format_native_block(native: Dict[str, Any]) -> List[str]:\n    \"\"\"Human rendering of the W1.2 native cross-check block.\n\n    UNMATCHED residue from BOTH sides always appears — aggregated by\n    (session, rail, agent_type) so every unmatched spawn is represented\n    — each section headed by its COUNT. Full per-spawn detail lives in\n    the ``--json`` output.\n    \"\"\"\n    lines: List[str] = []\n    lines.append(\"\")\n    lines.append(\n        \"Native cross-check (PLAN-178 W1.2 — cross-check, not authority-swap):\"\n    )\n    lines.append(f\"  Native root     : {native.get('native_root')}\")\n    if native.get(\"dormant\"):\n        lines.append(f\"  Status          : DORMANT — {native.get('note')}\")\n        return lines\n    lines.append(\n        f\"  Native spawns   : {native['native_spawn_count']:,} \"\n        f\"(task={native['native_task_spawns']:,}, \"\n        f\"workflow={native['native_workflow_spawns']:,})\"\n    )\n    lines.append(\n        f\"  Audit spawns    : {native['audit_spawn_count']:,} \"\n        f\"(agent_spawn events in scope)\"\n    )\n    lines.append(\n        f\"  Matched pairs   : {native['matched_count']:,} \"\n        f\"(token-comparable: {native['comparable_pair_count']:,})\"\n    )\n    tok = native.get(\"native_tokens\") or {}\n    lines.append(\n        f\"  Native tokens   : in={tok.get('in', 0):,} out={tok.get('out', 0):,} \"\n        f\"cache_creation={tok.get('cache_creation', 0):,} \"\n        f\"cache_read={tok.get('cache_read', 0):,}\"\n    )\n    cost = native.get(\"native_cost_usd\")\n    tbd = int(native.get(\"native_cost_tbd_spawns\") or 0)\n    if cost is None and tbd:\n        cost_col = f\"TBD ({tbd:,} spawns without resolvable model/price)\"\n    elif tbd:\n        cost_col = (\n            f\"${cost:,.4f} + TBD ({tbd:,} spawns without resolvable \"\n            f\"model/price)\"\n        )\n    elif cost is None:\n        cost_col = \"-\"\n    else:\n        cost_col = f\"${cost:,.4f}\"\n    lines.append(f\"  Native cost     : {cost_col}\")\n    lines.append(\n        \"                    (cache priced as input-equivalents: read @0.10x\"\n        \" — \" + _cache_read_exceptions_text() + \" —,\"\n        \" write @1.25x — 5m-TTL assumption, docs/provider-pricing.md)\"\n    )\n    unreadable = int(native.get(\"native_transcripts_unreadable\", 0) or 0)\n    if unreadable:\n        lines.append(\n            f\"  Skipped         : {unreadable} unreadable native transcript(s)\"\n            \" excluded from totals and matching\"\n        )\n    max_div = native.get(\"max_divergence_pct_by_rail\") or {}\n    div_cols = []\n    for rail in (\"task\", \"workflow\"):\n        v = max_div.get(rail)\n        div_cols.append(f\"{rail}={v:.2f}%\" if v is not None else f\"{rail}=-\")\n    div_note = \"\"\n    if native[\"comparable_pair_count\"] == 0:\n        div_note = (\n            \" (no comparable pairs: audit-log spawn tokens are null in scope)\"\n        )\n    lines.append(f\"  Max divergence  : {' '.join(div_cols)}{div_note}\")\n\n    def _grouped(rows: List[Dict[str, Any]], with_rail: bool) -> List[str]:\n        counts: Dict[Tuple[str, ...], int] = {}\n        for r in rows:\n            sess = str(r.get(\"session_id\") or \"(unknown)\")[:8]\n            if with_rail:\n                gkey = (sess, str(r.get(\"rail\") or \"?\"), str(r.get(\"agent_type\") or \"?\"))\n            else:\n                gkey = (sess, str(r.get(\"agent_type\") or \"?\"))\n            counts[gkey] = counts.get(gkey, 0) + 1\n        out = []\n        for gkey in sorted(counts):\n            if with_rail:\n                out.append(\n                    f\"    {gkey[0]:<8}  {gkey[1]:<8}  {gkey[2]:<28}  \"\n                    f\"x{counts[gkey]}\"\n                )\n            else:\n                out.append(f\"    {gkey[0]:<8}  {gkey[1]:<38}  x{counts[gkey]}\")\n        return out\n\n    un_nat = native.get(\"unmatched_native\") or []\n    lines.append(\n        f\"  UNMATCHED — native side (no audit-log counterpart): \"\n        f\"{native['unmatched_native_count']:,}\"\n    )\n    if un_nat:\n        lines.extend(_grouped(un_nat, with_rail=True))\n    else:\n        lines.append(\"    (none)\")\n    un_aud = native.get(\"unmatched_audit\") or []\n    lines.append(\n        f\"  UNMATCHED — audit-log side (no native counterpart): \"\n        f\"{native['unmatched_audit_count']:,}\"\n    )\n    if un_aud:\n        lines.extend(_grouped(un_aud, with_rail=False))\n    else:\n        lines.append(\"    (none)\")\n    lines.append(\n        \"  NOTE: the native source never replaces the audit-log totals \"\n        \"above; the residue is shown in full because silencing it would \"\n        \"fake a low divergence.\"\n    )\n    return lines\n","numLines":120,"startLine":1,"totalLines":120}},"tool_result_meta":[{"id":"toolu_01A2tKnAVZDJ4GUcEQMuU4JL","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
