{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WnZjAJ6qjPXK79Ezv6uVjx","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tdef _bench_pass_rate(r: Dict[str, Any]) -> float:\n4\t    \"\"\"Per-run pass-rate. Prefers int-encoded ``pass_rate_bps`` (÷1000);\n5\t    falls back to legacy float ``pass_rate``.\"\"\"\n6\t    bps = r.get(\"pass_rate_bps\")\n7\t    if bps is not None:\n8\t        try:\n9\t            return int(bps) / 1000.0\n10\t        except (TypeError, ValueError):\n11\t            return 0.0\n12\t    try:\n13\t        return float(r.get(\"pass_rate\") or 0.0)\n14\t    except (TypeError, ValueError):\n15\t        return 0.0\n16\t\n17\t\n18\tdef _bench_turns(r: Dict[str, Any]) -> int:\n19\t    \"\"\"Per-run scenario count (the harbor 'turns' column). Tolerant.\"\"\"\n20\t    try:\n21\t        return int(r.get(\"pass_count\") or 0) + int(r.get(\"fail_count\") or 0)\n22\t    except (TypeError, ValueError):\n23\t        return 0\n24\t\n25\t\n26\tdef benchmark_rollup(\n27\t    *,\n28\t    audit_dir: Optional[Path] = None,\n29\t    since: Optional[timedelta] = None,\n30\t    now: Optional[datetime] = None,\n31\t) -> Dict[str, Any]:\n32\t    \"\"\"Co-report cost + compute + turns alongside pass-rate per benchmark\n33\t    skill (PLAN-133 C4, harbor-style row). Read-only; fail-open on infra.\n34\t\n35\t    Returns a JSON-serializable dict with a per-skill list. Each row carries\n36\t    the latest pass-rate plus the cumulative + latest cost/compute/turns so\n37\t    an operator sees both the marginal and trend cost of a benchmark.\n38\t    \"\"\"\n39\t    if now is None:\n40\t        now = datetime.now(timezone.utc)\n41\t    cutoff = (now - since) if since is not None else None\n42\t\n43\t    log_paths = discover_logs(audit_dir)\n44\t    by_skill: Dict[str, List[Dict[str, Any]]] = {}\n45\t    try:\n46\t        for ev in iter_unique_events(log_paths):\n47\t            if ev.get(\"action\") != \"benchmark_run\":\n48\t                continue\n49\t            ts = _parse_ts(ev.get(\"ts\"))\n50\t            if cutoff is not None and ts is not None and ts < cutoff:\n51\t                continue\n52\t            skill = str(ev.get(\"skill\") or \"?\")\n53\t            by_skill.setdefault(skill, []).append(ev)\n54\t    except Exception:\n55\t        # fail-open-on-infra: a malformed log never crashes the rollup.\n56\t        by_skill = {}\n57\t\n58\t    rows: List[Dict[str, Any]] = []\n59\t    tot_cost = 0.0\n60\t    tot_compute = 0.0\n61\t    tot_turns = 0\n62\t    for skill in sorted(by_skill.keys()):\n63\t        runs = sorted(by_skill[skill], key=lambda r: r.get(\"ts\") or \"\")\n64\t        latest = runs[-1]\n65\t        s_cost = sum(_bench_cost_usd(r) for r in runs)\n66\t        s_compute = sum(_bench_duration_s(r) for r in runs)\n67\t        s_turns = sum(_bench_turns(r) for r in runs)\n68\t        tot_cost += s_cost\n69\t        tot_compute += s_compute\n70\t        tot_turns += s_turns\n71\t        rows.append({\n72\t            \"skill\": skill,\n73\t            \"runs\": len(runs),\n74\t            \"latest_pass_rate\": round(_bench_pass_rate(latest), 3),\n75\t            \"latest_cost_usd\": round(_bench_cost_usd(latest), 6),\n76\t            \"total_cost_usd\": round(s_cost, 6),\n77\t            \"latest_compute_s\": round(_bench_duration_s(latest), 3),\n78\t            \"total_compute_s\": round(s_compute, 3),\n79\t            \"latest_turns\": _bench_turns(latest),\n80\t            \"total_turns\": s_turns,\n81\t            \"latest_ts\": latest.get(\"ts\"),\n82\t        })\n83\t    return {\n84\t        \"per_skill\": rows,\n85\t        \"total_cost_usd\": round(tot_cost, 6),\n86\t        \"total_compute_s\": round(tot_compute, 3),\n87\t        \"total_turns\": tot_turns,\n88\t        \"skill_count\": len(rows),\n89\t    }\n90\t\n91\t\n92\tdef _extract_wave_id(event: Dict[str, Any]) -> Optional[str]:\n93\t    \"\"\"Extract a wave-id from an event if present.\n94\t\n95\t    Heuristic: check ``wave_id``, ``wave``, then scan\n96\t    ``desc_preview``/``description`` for a ``wave-X`` substring.\n97\t    \"\"\"\n98\t    for key in (\"wave_id\", \"wave\"):\n99\t        v = event.get(key)\n100\t        if isinstance(v, str) and _WAVE_ID_RE.match(v):\n101\t            return v\n102\t    for key in (\"desc_preview\", \"description\", \"task_description\"):\n103\t        v = event.get(key)\n104\t        if isinstance(v, str):\n105\t            m = re.search(r\"\\b(wave-[a-z0-9-]{1,16})\\b\", v)\n106\t            if m and _WAVE_ID_RE.match(m.group(1)):\n107\t                return m.group(1)\n108\t    return None\n109\t\n110\t\n111\tdef default_native_root() -> Path:\n112\t    \"\"\"Root of the harness-native transcript corpus for THIS project.\n113\t\n114\t    Honors ``CEO_NATIVE_USAGE_DIR`` env override (used by tests).\n115\t    Otherwise ``~/.claude/projects/<cwd-slug>/`` where ``<cwd-slug>`` is\n116\t    the absolute project path (``$CLAUDE_PROJECT_DIR``, else cwd) with\n117\t    ``/`` replaced by ``-`` (probe §1.1).\n118\t    \"\"\"\n119\t    env_dir = os.environ.get(\"CEO_NATIVE_USAGE_DIR\")\n120\t    if env_dir:\n121\t        return Path(env_dir)\n122\t    project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n123\t    slug = _rp.project_slug(project_dir)  # PLAN-182 W3 (S321): slug via resolvedor unico, nunca re-derivado\n124\t    home = os.environ.get(\"HOME\") or str(Path.home())\n125\t    return Path(home) / \".claude\" / \"projects\" / slug\n126\t\n127\t\n128\tdef _native_transcript_paths(\n129\t    native_root: Optional[Path],\n130\t) -> List[Tuple[Path, str, str]]:\n131\t    \"\"\"Discover native agent transcripts under ``native_root``.\n132\t\n133\t    Returns ``(path, rail, session_id)`` triples. Rail is derived from\n134\t    the PATH shape (probe §3 blocker: the corpus has no field for it):\n135\t    ``*/subagents/agent-a*.jsonl`` ⇒ ``task``;\n136\t    ``*/subagents/workflows/wf_*/agent-a*.jsonl`` ⇒ ``workflow``.\n137\t    ``journal.jsonl`` never matches (``agent-a*`` prefix). The\n138\t    SESSION-UUID is the first path component under the root.\n139\t    \"\"\"\n140\t    out: List[Tuple[Path, str, str]] = []\n141\t    if native_root is None or not native_root.is_dir():\n142\t        return out\n143\t    root = str(native_root)\n144\t    task_glob = os.path.join(root, \"*\", \"subagents\", \"agent-a*.jsonl\")\n145\t    wf_glob = os.path.join(\n146\t        root, \"*\", \"subagents\", \"workflows\", \"wf_*\", \"agent-a*.jsonl\"\n147\t    )\n148\t    for pattern, rail in ((task_glob, \"task\"), (wf_glob, \"workflow\")):\n149\t        for raw in sorted(glob.glob(pattern)):\n150\t            p = Path(raw)\n151\t            try:\n152\t                session_id = p.relative_to(native_root).parts[0]\n153\t            except (ValueError, IndexError):\n154\t                session_id = \"(unknown)\"\n155\t            out.append((p, rail, session_id))\n156\t    return out\n157\t\n158\t\n159\tdef _cache_read_multiplier(model_id: str) -> float:\n160\t    \"\"\"Cache-read multiplier for ``model_id`` (0.10x unless overridden).\"\"\"\n161\t    return _CACHE_READ_MULTIPLIER_OVERRIDES.get(\n162\t        model_id, _CACHE_READ_MULTIPLIER_DEFAULT\n163\t    )\n164\t\n165\t\n166\tdef _cache_read_exceptions_text() -> str:\n167\t    \"\"\"The per-model cache-read exceptions, rendered FROM the table above.\n168\t\n169\t    ADR-149 Amendment 3 (S357): the report text is DERIVED, never\n170\t    re-listed by hand — the hand-written \"0.025x on Fable 5.1\" went stale\n171\t    on the next model with its own cache-read rate.\n172\t    \"\"\"\n173\t    return \", \".join(\n174\t        \"%gx on %s\" % (mult, model_id)\n175\t        for model_id, mult in sorted(_CACHE_READ_MULTIPLIER_OVERRIDES.items())\n176\t    )\n177\t\n178\t\n179\t\n180\t"}]},"parent_tool_use_id":null,"session_id":"554a7565-eb62-4598-9760-aeebd94af377","uuid":"55961fb1-6208-4a49-a8aa-f5d1f7d125ba","timestamp":"2026-11-16T19:39:02.734Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/benchmark_native.py","content":"from __future__ import annotations\n\ndef _bench_pass_rate(r: Dict[str, Any]) -> float:\n    \"\"\"Per-run pass-rate. Prefers int-encoded ``pass_rate_bps`` (÷1000);\n    falls back to legacy float ``pass_rate``.\"\"\"\n    bps = r.get(\"pass_rate_bps\")\n    if bps is not None:\n        try:\n            return int(bps) / 1000.0\n        except (TypeError, ValueError):\n            return 0.0\n    try:\n        return float(r.get(\"pass_rate\") or 0.0)\n    except (TypeError, ValueError):\n        return 0.0\n\n\ndef _bench_turns(r: Dict[str, Any]) -> int:\n    \"\"\"Per-run scenario count (the harbor 'turns' column). Tolerant.\"\"\"\n    try:\n        return int(r.get(\"pass_count\") or 0) + int(r.get(\"fail_count\") or 0)\n    except (TypeError, ValueError):\n        return 0\n\n\ndef benchmark_rollup(\n    *,\n    audit_dir: Optional[Path] = None,\n    since: Optional[timedelta] = None,\n    now: Optional[datetime] = None,\n) -> Dict[str, Any]:\n    \"\"\"Co-report cost + compute + turns alongside pass-rate per benchmark\n    skill (PLAN-133 C4, harbor-style row). Read-only; fail-open on infra.\n\n    Returns a JSON-serializable dict with a per-skill list. Each row carries\n    the latest pass-rate plus the cumulative + latest cost/compute/turns so\n    an operator sees both the marginal and trend cost of a benchmark.\n    \"\"\"\n    if now is None:\n        now = datetime.now(timezone.utc)\n    cutoff = (now - since) if since is not None else None\n\n    log_paths = discover_logs(audit_dir)\n    by_skill: Dict[str, List[Dict[str, Any]]] = {}\n    try:\n        for ev in iter_unique_events(log_paths):\n            if ev.get(\"action\") != \"benchmark_run\":\n                continue\n            ts = _parse_ts(ev.get(\"ts\"))\n            if cutoff is not None and ts is not None and ts < cutoff:\n                continue\n            skill = str(ev.get(\"skill\") or \"?\")\n            by_skill.setdefault(skill, []).append(ev)\n    except Exception:\n        # fail-open-on-infra: a malformed log never crashes the rollup.\n        by_skill = {}\n\n    rows: List[Dict[str, Any]] = []\n    tot_cost = 0.0\n    tot_compute = 0.0\n    tot_turns = 0\n    for skill in sorted(by_skill.keys()):\n        runs = sorted(by_skill[skill], key=lambda r: r.get(\"ts\") or \"\")\n        latest = runs[-1]\n        s_cost = sum(_bench_cost_usd(r) for r in runs)\n        s_compute = sum(_bench_duration_s(r) for r in runs)\n        s_turns = sum(_bench_turns(r) for r in runs)\n        tot_cost += s_cost\n        tot_compute += s_compute\n        tot_turns += s_turns\n        rows.append({\n            \"skill\": skill,\n            \"runs\": len(runs),\n            \"latest_pass_rate\": round(_bench_pass_rate(latest), 3),\n            \"latest_cost_usd\": round(_bench_cost_usd(latest), 6),\n            \"total_cost_usd\": round(s_cost, 6),\n            \"latest_compute_s\": round(_bench_duration_s(latest), 3),\n            \"total_compute_s\": round(s_compute, 3),\n            \"latest_turns\": _bench_turns(latest),\n            \"total_turns\": s_turns,\n            \"latest_ts\": latest.get(\"ts\"),\n        })\n    return {\n        \"per_skill\": rows,\n        \"total_cost_usd\": round(tot_cost, 6),\n        \"total_compute_s\": round(tot_compute, 3),\n        \"total_turns\": tot_turns,\n        \"skill_count\": len(rows),\n    }\n\n\ndef _extract_wave_id(event: Dict[str, Any]) -> Optional[str]:\n    \"\"\"Extract a wave-id from an event if present.\n\n    Heuristic: check ``wave_id``, ``wave``, then scan\n    ``desc_preview``/``description`` for a ``wave-X`` substring.\n    \"\"\"\n    for key in (\"wave_id\", \"wave\"):\n        v = event.get(key)\n        if isinstance(v, str) and _WAVE_ID_RE.match(v):\n            return v\n    for key in (\"desc_preview\", \"description\", \"task_description\"):\n        v = event.get(key)\n        if isinstance(v, str):\n            m = re.search(r\"\\b(wave-[a-z0-9-]{1,16})\\b\", v)\n            if m and _WAVE_ID_RE.match(m.group(1)):\n                return m.group(1)\n    return None\n\n\ndef default_native_root() -> Path:\n    \"\"\"Root of the harness-native transcript corpus for THIS project.\n\n    Honors ``CEO_NATIVE_USAGE_DIR`` env override (used by tests).\n    Otherwise ``~/.claude/projects/<cwd-slug>/`` where ``<cwd-slug>`` is\n    the absolute project path (``$CLAUDE_PROJECT_DIR``, else cwd) with\n    ``/`` replaced by ``-`` (probe §1.1).\n    \"\"\"\n    env_dir = os.environ.get(\"CEO_NATIVE_USAGE_DIR\")\n    if env_dir:\n        return Path(env_dir)\n    project_dir = os.environ.get(\"CLAUDE_PROJECT_DIR\") or os.getcwd()\n    slug = _rp.project_slug(project_dir)  # PLAN-182 W3 (S321): slug via resolvedor unico, nunca re-derivado\n    home = os.environ.get(\"HOME\") or str(Path.home())\n    return Path(home) / \".claude\" / \"projects\" / slug\n\n\ndef _native_transcript_paths(\n    native_root: Optional[Path],\n) -> List[Tuple[Path, str, str]]:\n    \"\"\"Discover native agent transcripts under ``native_root``.\n\n    Returns ``(path, rail, session_id)`` triples. Rail is derived from\n    the PATH shape (probe §3 blocker: the corpus has no field for it):\n    ``*/subagents/agent-a*.jsonl`` ⇒ ``task``;\n    ``*/subagents/workflows/wf_*/agent-a*.jsonl`` ⇒ ``workflow``.\n    ``journal.jsonl`` never matches (``agent-a*`` prefix). The\n    SESSION-UUID is the first path component under the root.\n    \"\"\"\n    out: List[Tuple[Path, str, str]] = []\n    if native_root is None or not native_root.is_dir():\n        return out\n    root = str(native_root)\n    task_glob = os.path.join(root, \"*\", \"subagents\", \"agent-a*.jsonl\")\n    wf_glob = os.path.join(\n        root, \"*\", \"subagents\", \"workflows\", \"wf_*\", \"agent-a*.jsonl\"\n    )\n    for pattern, rail in ((task_glob, \"task\"), (wf_glob, \"workflow\")):\n        for raw in sorted(glob.glob(pattern)):\n            p = Path(raw)\n            try:\n                session_id = p.relative_to(native_root).parts[0]\n            except (ValueError, IndexError):\n                session_id = \"(unknown)\"\n            out.append((p, rail, session_id))\n    return out\n\n\ndef _cache_read_multiplier(model_id: str) -> float:\n    \"\"\"Cache-read multiplier for ``model_id`` (0.10x unless overridden).\"\"\"\n    return _CACHE_READ_MULTIPLIER_OVERRIDES.get(\n        model_id, _CACHE_READ_MULTIPLIER_DEFAULT\n    )\n\n\ndef _cache_read_exceptions_text() -> str:\n    \"\"\"The per-model cache-read exceptions, rendered FROM the table above.\n\n    ADR-149 Amendment 3 (S357): the report text is DERIVED, never\n    re-listed by hand — the hand-written \"0.025x on Fable 5.1\" went stale\n    on the next model with its own cache-read rate.\n    \"\"\"\n    return \", \".join(\n        \"%gx on %s\" % (mult, model_id)\n        for model_id, mult in sorted(_CACHE_READ_MULTIPLIER_OVERRIDES.items())\n    )\n\n\n\n","numLines":180,"startLine":1,"totalLines":180}},"tool_result_meta":[{"id":"toolu_01WnZjAJ6qjPXK79Ezv6uVjx","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
