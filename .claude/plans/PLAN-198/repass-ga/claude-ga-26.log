{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7B11ewKvzDVjiiQxCgU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01Dpv9H6EHVcaEvvtzyCJSc5","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/native_reconciliation.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10571,"cache_read_input_tokens":75179,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10571},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"554a7565-eb62-4598-9760-aeebd94af377","uuid":"5e3d6d5e-1500-485f-9193-f30619753963","timestamp":"2026-11-16T19:39:07.452Z","request_id":"req_011Ch7B11U357kLyaZ45mzCo","wire_tool_inputs":{"toolu_01Dpv9H6EHVcaEvvtzyCJSc5":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/native_reconciliation.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dpv9H6EHVcaEvvtzyCJSc5","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tMEMORY_CLAIM_LOW_USD = 1003.0\n4\tMEMORY_CLAIM_HIGH_USD = 1543.0\n5\tMEMORY_CLAIM_PASS_RATIO_LOW = 0.5\n6\tMEMORY_CLAIM_PASS_RATIO_HIGH = 1.5\n7\t\n8\tdef _read_native_spawn(\n9\t    transcript: Path,\n10\t    rail: str,\n11\t    session_id: str,\n12\t    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n13\t    counters: Optional[Dict[str, int]] = None,\n14\t) -> Optional[Dict[str, Any]]:\n15\t    \"\"\"Read ONE native spawn (transcript + tolerant meta pairing).\n16\t\n17\t    Tolerant by doctrine (probe §handoff item 3): a missing meta, a\n18\t    malformed/truncated line (live session appending), or a missing\n19\t    field degrades the record — it never raises. Model precedence:\n20\t    ``meta.model`` first, else the first ``message.model`` seen in the\n21\t    transcript (the workflow-path metas carry NO model at all). A\n22\t    ``meta.model`` that resolves to NOTHING (a bare family alias such as\n23\t    ``fable`` once the registry holds two Fable ids — ADR-149 Amendment\n24\t    2) falls back to the transcript's exact ``message.model``: exact\n25\t    evidence beats an ambiguous alias, and neither is ever guessed.\n26\t    \"\"\"\n27\t    stem = transcript.name[: -len(\".jsonl\")]\n28\t    meta_path = transcript.with_name(stem + \".meta.json\")\n29\t    agent_type = \"(unknown)\"\n30\t    meta_model: Optional[str] = None\n31\t    meta_description: Optional[str] = None\n32\t    if meta_path.is_file():\n33\t        try:\n34\t            meta = json.loads(meta_path.read_text(encoding=\"utf-8\"))\n35\t        except (OSError, ValueError):\n36\t            meta = None\n37\t        if isinstance(meta, dict):\n38\t            # Hard fingerprint invariants (substrate-watch cc_native_usage,\n39\t            # 416/416 measured; codex S306 r3 P2 cure — same sonda as the\n40\t            # standalone puller): a meta that parses but lost either field\n41\t            # is schema drift, counted so native_cross_check can degrade.\n42\t            if \"agentType\" not in meta or \"spawnDepth\" not in meta:\n43\t                if counters is not None:\n44\t                    counters[\"meta_invariant_missing\"] = (\n45\t                        counters.get(\"meta_invariant_missing\", 0) + 1\n46\t                    )\n47\t            at = meta.get(\"agentType\")\n48\t            if isinstance(at, str) and at.strip():\n49\t                agent_type = at.strip()\n50\t            mm = meta.get(\"model\")\n51\t            if isinstance(mm, str) and mm.strip():\n52\t                meta_model = mm.strip()\n53\t            md = meta.get(\"description\")\n54\t            if isinstance(md, str) and md:\n55\t                meta_description = md\n56\t\n57\t    start_ts: Optional[str] = None\n58\t    transcript_model: Optional[str] = None\n59\t    sums = {k: 0 for k in _NATIVE_USAGE_KEYS}\n60\t    cache_5m = 0                      # nested usage.cache_creation split\n61\t    cache_1h = 0                      # (codex S306 r3 P2 cure — 1h TTL @2.0x)\n62\t    usage_events = 0\n63\t    try:\n64\t        with transcript.open(\"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n65\t            for raw in f:\n66\t                raw = raw.strip()\n67\t                if not raw:\n68\t                    continue\n69\t                try:\n70\t                    rec = json.loads(raw)\n71\t                except ValueError:\n72\t                    continue\n73\t                if not isinstance(rec, dict):\n74\t                    continue\n75\t                ts = rec.get(\"timestamp\")\n76\t                if start_ts is None and isinstance(ts, str) and ts:\n77\t                    start_ts = ts\n78\t                msg = rec.get(\"message\")\n79\t                if not isinstance(msg, dict):\n80\t                    continue\n81\t                if transcript_model is None:\n82\t                    m = msg.get(\"model\")\n83\t                    if isinstance(m, str) and m.strip():\n84\t                        transcript_model = m.strip()\n85\t                usage = msg.get(\"usage\")\n86\t                if not isinstance(usage, dict):\n87\t                    continue\n88\t                # Fingerprint drift sonda (codex S306 r2 P2 cure): a usage\n89\t                # dict with NEITHER core key is schema drift — counted so\n90\t                # native_cross_check can degrade to audit-only, never summed\n91\t                # as a zero-token event.\n92\t                if (\"input_tokens\" not in usage) and (\"output_tokens\" not in usage):\n93\t                    if counters is not None:\n94\t                        counters[\"usage_missing_core_keys\"] = (\n95\t                            counters.get(\"usage_missing_core_keys\", 0) + 1\n96\t                        )\n97\t                    continue\n98\t                bearing = False\n99\t                for key in _NATIVE_USAGE_KEYS:\n100\t                    v = usage.get(key)\n101\t                    if isinstance(v, (int, float)):\n102\t                        sums[key] += int(v)\n103\t                        if key in (\"input_tokens\", \"output_tokens\"):\n104\t                            bearing = True\n105\t                cc = usage.get(\"cache_creation\")\n106\t                if isinstance(cc, dict):\n107\t                    v5 = cc.get(\"ephemeral_5m_input_tokens\")\n108\t                    v1 = cc.get(\"ephemeral_1h_input_tokens\")\n109\t                    if isinstance(v5, (int, float)):\n110\t                        cache_5m += int(v5)\n111\t                    if isinstance(v1, (int, float)):\n112\t                        cache_1h += int(v1)\n113\t                if bearing:\n114\t                    usage_events += 1\n115\t    except OSError:\n116\t        # codex S306 P2 cure: an unreadable transcript must NOT degrade to a\n117\t        # zero-token record with a \"known\" $0.00 cost — it corrupts totals\n118\t        # AND the ordinal join. Skip the spawn, count it observably.\n119\t        if counters is not None:\n120\t            counters[\"transcripts_unreadable\"] = (\n121\t                counters.get(\"transcripts_unreadable\", 0) + 1\n122\t            )\n123\t        sys.stderr.write(\n124\t            \"budget-summary: unreadable native transcript — spawn skipped: \"\n125\t            \"%s\\n\" % transcript\n126\t        )\n127\t        return None\n128\t\n129\t    model_raw = meta_model or transcript_model\n130\t    model_id = _normalize_model_id(model_raw, pricing=pricing)\n131\t    if (\n132\t        model_id is None\n133\t        and meta_model\n134\t        and transcript_model\n135\t        and transcript_model.strip().lower() != meta_model.strip().lower()\n136\t    ):\n137\t        # ADR-149 Amendment 2 (S338, codex rail r2 P2): a bare family\n138\t        # alias in the meta (\"fable\") turned AMBIGUOUS once the registry\n139\t        # held two Fable ids, and the doctrine never guesses a version.\n140\t        # The transcript's own message.model is exact evidence, not a\n141\t        # guess — fall back to it. Still unresolved => TBD, as before.\n142\t        model_raw = transcript_model\n143\t        model_id = _normalize_model_id(model_raw, pricing=pricing)\n144\t    t_in = sums[\"input_tokens\"]\n145\t    t_out = sums[\"output_tokens\"]\n146\t    # Cache classes are BILLABLE (docs/provider-pricing.md: read @0.10x\n147\t    # input — per-model exceptions in _CACHE_READ_MULTIPLIER_OVERRIDES —,\n148\t    # write @1.25x on the 5m TTL and @2.00x on the 1h TTL). When the\n149\t    # transcript carries the nested ``usage.cache_creation`` split, each\n150\t    # tier gets its own multiplier (codex S306 r3 P2 cure); writes NOT\n151\t    # attributed by the split assume 5m, the API default. Priced as\n152\t    # input-token EQUIVALENTS so compute_cost_usd's full row/dated-row\n153\t    # resolution is reused instead of a second rate table (codex S306 r1 P1\n154\t    # cure: pricing only fresh in/out understated the native total ~10x).\n155\t    c_total = sums[\"cache_creation_input_tokens\"]\n156\t    c_1h = min(cache_1h, c_total)\n157\t    c_5m = min(cache_5m, c_total - c_1h)\n158\t    c_rest = c_total - c_1h - c_5m    # unattributed -> 5m assumption\n159\t    cache_equiv_in = int(\n160\t        _cache_read_multiplier(model_id) * sums[\"cache_read_input_tokens\"]\n161\t        + 1.25 * (c_5m + c_rest)\n162\t        + 2.00 * c_1h\n163\t    )\n164\t    cost = compute_cost_usd(\n165\t        model_id, t_in + cache_equiv_in, t_out, pricing=pricing, ts=start_ts\n166\t    )\n167\t    return {\n168\t        \"session_id\": session_id,\n169\t        \"rail\": rail,\n170\t        \"agent_type\": agent_type,\n171\t        \"description\": meta_description,\n172\t        \"transcript\": transcript.name,\n173\t        \"start_ts\": start_ts,\n174\t        \"usage_events\": usage_events,\n175\t        \"tokens_in\": t_in,\n176\t        \"tokens_out\": t_out,\n177\t        \"cache_creation_tokens\": sums[\"cache_creation_input_tokens\"],\n178\t        \"cache_read_tokens\": sums[\"cache_read_input_tokens\"],\n179\t        \"model_raw\": model_raw,\n180\t        \"model_id\": model_id,\n181\t        \"cost_usd\": cost,\n182\t        \"cost_tbd\": cost is None,\n183\t    }\n184\t\n185\t\n186\tdef collect_native_spawns(\n187\t    native_root: Optional[Path] = None,\n188\t    *,\n189\t    cutoff: Optional[datetime] = None,\n190\t    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n191\t    counters: Optional[Dict[str, int]] = None,\n192\t) -> List[Dict[str, Any]]:\n193\t    \"\"\"Collect all native spawn records under ``native_root``.\n194\t\n195\t    ``cutoff`` mirrors the rollup's ``--since`` semantics: a spawn whose\n196\t    start timestamp parses AND precedes the cutoff is excluded; a spawn\n197\t    with no parseable timestamp is kept (visibility over silence).\n198\t    \"\"\"\n199\t    spawns: List[Dict[str, Any]] = []\n200\t    for path, rail, session_id in _native_transcript_paths(native_root):\n201\t        rec = _read_native_spawn(\n202\t            path, rail, session_id, pricing=pricing, counters=counters\n203\t        )\n204\t        if rec is None:               # unreadable transcript — counted, skipped\n205\t            continue\n206\t        if cutoff is not None:\n207\t            parsed = _parse_ts_any(rec.get(\"start_ts\"))\n208\t            if parsed is not None and parsed < cutoff:\n209\t                continue\n210\t        spawns.append(rec)\n211\t    return spawns\n212\t\n213\t\n214\tdef _collect_audit_spawn_rows(\n215\t    log_paths: Iterable[Path],\n216\t    cutoff: Optional[datetime] = None,\n217\t) -> List[Dict[str, Any]]:\n218\t    \"\"\"Audit-log side of the join: one row per ``agent_spawn`` event.\n219\t\n220\t    Token fields are None-PRESERVING (not coerced to 0): a null stays\n221\t    null so the report can say \"no number on the audit side\" instead of\n222\t    fabricating a 0 that would fake a divergence.\n223\t    \"\"\"\n224\t\n225\t    def _opt_int(v: Any) -> Optional[int]:\n226\t        if isinstance(v, bool):\n227\t            return None\n228\t        if isinstance(v, (int, float)):\n229\t            return int(v)\n230\t        return None\n231\t\n232\t    rows: List[Dict[str, Any]] = []\n233\t    for ev in iter_unique_events(log_paths):\n234\t        if (ev.get(\"action\") or \"\") != \"agent_spawn\":\n235\t            continue\n236\t        ts_parsed = _parse_ts(ev.get(\"ts\"))\n237\t        if cutoff is not None and ts_parsed is not None and ts_parsed < cutoff:\n238\t            continue\n239\t        subagent_type = ev.get(\"subagent_type\")\n240\t        desc_hash = ev.get(\"desc_hash\")\n241\t        rows.append({\n242\t            \"session_id\": ev.get(\"session_id\") or \"(unknown)\",\n243\t            \"agent_type\": (\n244\t                subagent_type.strip()\n245\t                if isinstance(subagent_type, str) and subagent_type.strip()\n246\t                else \"(unknown)\"\n247\t            ),\n248\t            \"desc_hash\": (\n249\t                desc_hash if isinstance(desc_hash, str) and desc_hash else None\n250\t            ),\n251\t            \"ts\": ev.get(\"ts\"),\n252\t            \"model\": ev.get(\"model\"),\n253\t            \"tokens_in\": _opt_int(ev.get(\"tokens_in\")),\n254\t            \"tokens_out\": _opt_int(ev.get(\"tokens_out\")),\n255\t            \"tokens_total\": _opt_int(ev.get(\"tokens_total\")),\n256\t        })\n257\t    return rows\n258\t\n259\t\n260\tdef _audit_total_tokens(row: Dict[str, Any]) -> Optional[int]:\n261\t    \"\"\"Comparable audit-side token total, or None when the ledger has no\n262\t    number for this spawn (the current-rotation reality: all null).\"\"\"\n263\t    total = row.get(\"tokens_total\")\n264\t    if isinstance(total, int):\n265\t        return total\n266\t    t_in = row.get(\"tokens_in\")\n267\t    t_out = row.get(\"tokens_out\")\n268\t    if isinstance(t_in, int) and isinstance(t_out, int):\n269\t        return t_in + t_out\n270\t    return None\n271\t\n272\t\n273\tdef native_cross_check(\n274\t    *,\n275\t    audit_dir: Optional[Path] = None,\n276\t    native_root: Optional[Path] = None,\n277\t    since: Optional[timedelta] = None,\n278\t    now: Optional[datetime] = None,\n279\t    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n280\t) -> Dict[str, Any]:\n281\t    \"\"\"Join the audit-log spawn ledger against the native corpus (W1.2-2).\n282\t\n283\t    Join key: ``(session_id, agent_type)`` with agent_type =\n284\t    audit ``subagent_type`` ≈ native meta ``agentType`` (case-folded);\n285\t    within each group both sides sort by timestamp and zip by ordinal.\n286\t    Matched pairs, plus UNMATCHED residue from BOTH sides, are all\n287\t    returned — nothing is silenced. Read-only; fail-open on infra\n288\t    (a broken corpus degrades to a dormant block with a note, never a\n289\t    crash — the audit-log rollup is unaffected either way).\n290\t    \"\"\"\n291\t    if now is None:\n292\t        now = datetime.now(timezone.utc)\n293\t    cutoff = (now - since) if since is not None else None\n294\t    root = native_root if native_root is not None else default_native_root()\n295\t\n296\t    doctrine = (\n297\t        \"cross-check, not authority-swap: the native source NEVER \"\n298\t        \"silently replaces the audit-log rollup\"\n299\t    )\n300\t\n301\t    infra_note: Optional[str] = None\n302\t    read_counters: Dict[str, int] = {}\n303\t    try:\n304\t        transcript_count = len(_native_transcript_paths(root))\n305\t        native = collect_native_spawns(\n306\t            root, cutoff=cutoff, pricing=pricing, counters=read_counters\n307\t        )\n308\t    except Exception as exc:  # fail-open on infra (CLAUDE.md §4)\n309\t        transcript_count = 0\n310\t        native = []\n311\t        infra_note = (\n312\t            f\"native collection failed ({type(exc).__name__}) — degraded to \"\n313\t            f\"audit-log only\"\n314\t        )\n315\t\n316\t    # Audit side is read BEFORE any early return (codex S306 r5 P2 cure): a\n317\t    # dormant/drifted native source must still report ACCURATE audit counts —\n318\t    # hard-coded zeros would tell JSON consumers the audit ledger is empty\n319\t    # when only the native side is missing.\n320\t    audit_rows = _collect_audit_spawn_rows(discover_logs(audit_dir), cutoff)\n321\t\n322\t    # Path-shape sonda (codex S306 r3 P2 cure — parity with the puller): a\n323\t    # walk sweep seeing MORE agent transcripts than the two known globs\n324\t    # matched means the harness moved the layout. Report DRIFT, never\n325\t    # ordinary dormancy or a zero total.\n326\t    try:\n327\t        walk_seen = sum(\n328\t            1 for p in root.rglob(\"agent-a*.jsonl\") if \"subagents\" in p.parts\n329\t        )\n330\t    except OSError:\n331\t        walk_seen = transcript_count\n332\t    if walk_seen > transcript_count:\n333\t        return {\n334\t            \"doctrine\": doctrine,\n335\t            \"native_root\": str(root),\n336\t            \"dormant\": True,\n337\t            \"degraded\": \"schema-drift\",\n338\t            \"drift\": {\"path_shape_unmatched\": walk_seen - transcript_count},\n339\t            \"native_spawn_count\": 0,\n340\t            \"audit_spawn_count\": len(audit_rows),\n341\t            \"unmatched_audit_count\": len(audit_rows),\n342\t            \"note\": (\n343\t                \"native path shape drifted (%d transcript(s) outside the \"\n344\t                \"known globs) — cross-check degraded to audit-log only\"\n345\t                % (walk_seen - transcript_count)\n346\t            ),\n347\t        }\n348\t\n349\t    if transcript_count == 0:\n350\t        result: Dict[str, Any] = {\n351\t            \"doctrine\": doctrine,\n352\t            \"native_root\": str(root),\n353\t            \"dormant\": True,\n354\t            \"native_spawn_count\": 0,\n355\t            \"audit_spawn_count\": len(audit_rows),\n356\t            \"matched_count\": 0,\n357\t            \"comparable_pair_count\": 0,\n358\t            \"unmatched_native_count\": 0,\n359\t            \"unmatched_audit_count\": len(audit_rows),\n360\t            \"note\": (\n361\t                infra_note\n362\t                or \"no native transcripts found — audit-log rollup is the \"\n363\t                   \"sole source (dormant, by design)\"\n364\t            ),\n365\t        }\n366\t        return result\n367\t\n368\t    # Drift gate on the integrated reader (codex S306 r2 P2 cure — same\n369\t    # fingerprint sonda as the puller): usage dicts whose core token keys\n370\t    # vanished mean the harness schema moved; publishing zero/partial totals\n371\t    # would present drift as genuine zero usage. Degrade to audit-only.\n372\t    drift_hits = {\n373\t        k: read_counters.get(k, 0)\n374\t        for k in (\"usage_missing_core_keys\", \"meta_invariant_missing\")\n375\t        if read_counters.get(k, 0) > 0\n376\t    }\n377\t    if drift_hits:\n378\t        return {\n379\t            \"doctrine\": doctrine,\n380\t            \"native_root\": str(root),\n381\t            \"dormant\": True,\n382\t            \"degraded\": \"schema-drift\",\n383\t            \"drift\": dict(read_counters),\n384\t            \"native_spawn_count\": 0,\n385\t            \"audit_spawn_count\": len(audit_rows),\n386\t            \"unmatched_audit_count\": len(audit_rows),\n387\t            \"note\": (\n388\t                \"native schema drifted (%s) — cross-check degraded to \"\n389\t                \"audit-log only\"\n390\t                % \", \".join(f\"{k}={v}\" for k, v in sorted(drift_hits.items()))\n391\t            ),\n392\t        }\n393\t\n394\t    def _key(session_id: Any, agent_type: Any) -> Tuple[str, str]:\n395\t        return (\n396\t            str(session_id or \"\"),\n397\t            str(agent_type or \"\").strip().lower(),\n398\t        )\n399\t\n400\t    # Pass 0 — EXACT join (codex S306 r2 P1 cure): native ``meta.description``\n401\t    # hashes (sha256, same function as audit_log's hash_description) to the\n402\t    # audit row's ``desc_hash``. This survives the shape where a teammate's\n403\t    # native agentType is its NAME while the audit row says\n404\t    # ``general-purpose`` — the (session, type) grouping alone under-matches.\n405\t    audit_by_hash: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}\n406\t    for row in audit_rows:\n407\t        h = row.get(\"desc_hash\")\n408\t        if isinstance(h, str) and h:\n409\t            audit_by_hash.setdefault(\n410\t                (str(row[\"session_id\"] or \"\"), h), []\n411\t            ).append(row)\n412\t    for group in audit_by_hash.values():\n413\t        group.sort(key=lambda r: r.get(\"ts\") or \"\")\n414\t    exact_pairs: List[Tuple[Dict[str, Any], Dict[str, Any]]] = []\n415\t    consumed_audit: Set[int] = set()\n416\t    remaining_native: List[Dict[str, Any]] = []\n417\t    # Duplicate-description groups pair oldest-to-oldest on BOTH sides\n418\t    # (codex S306 r4 P2 cure): the audit hash groups are ts-sorted above, so\n419\t    # native candidates must be consumed in start_ts order too — glob order\n420\t    # would associate the wrong token totals within the duplicate group.\n421\t    for rec in sorted(native, key=lambda r: r.get(\"start_ts\") or \"\"):\n422\t        desc = rec.get(\"description\")\n423\t        if isinstance(desc, str) and desc:\n424\t            hkey = (\n425\t                str(rec[\"session_id\"] or \"\"),\n426\t                hashlib.sha256(\n427\t                    desc.encode(\"utf-8\", errors=\"replace\")\n428\t                ).hexdigest(),\n429\t            )\n430\t            group = audit_by_hash.get(hkey)\n431\t            if group:\n432\t                aud = group.pop(0)\n433\t                consumed_audit.add(id(aud))\n434\t                exact_pairs.append((rec, aud))\n435\t                continue\n436\t        remaining_native.append(rec)\n437\t    remaining_audit = [r for r in audit_rows if id(r) not in consumed_audit]\n438\t\n439\t    native_by: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}\n440\t    for rec in remaining_native:\n441\t        native_by.setdefault(_key(rec[\"session_id\"], rec[\"agent_type\"]), []).append(rec)\n442\t    audit_by: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}\n443\t    for row in remaining_audit:\n444\t        audit_by.setdefault(_key(row[\"session_id\"], row[\"agent_type\"]), []).append(row)\n445\t\n446\t    for group in native_by.values():\n447\t        group.sort(key=lambda r: r.get(\"start_ts\") or \"\")\n448\t    for group in audit_by.values():\n449\t        group.sort(key=lambda r: r.get(\"ts\") or \"\")\n450\t\n451\t    matched: List[Dict[str, Any]] = []\n452\t    unmatched_native: List[Dict[str, Any]] = []\n453\t    unmatched_audit: List[Dict[str, Any]] = []\n454\t    divergences_by_rail: Dict[str, List[float]] = {\"task\": [], \"workflow\": []}\n455\t\n456\t    def _emit_pair(nat: Dict[str, Any], aud: Dict[str, Any],\n457\t                   ordinal: Optional[int], join: str) -> None:\n458\t        nat_total = int(nat[\"tokens_in\"]) + int(nat[\"tokens_out\"])\n459\t        aud_total = _audit_total_tokens(aud)\n460\t        comparable = aud_total is not None\n461\t        divergence_pct: Optional[float] = None\n462\t        if comparable:\n463\t            base = aud_total if aud_total else 1\n464\t            divergence_pct = round(\n465\t                abs(nat_total - aud_total) * 100.0 / base, 2\n466\t            )\n467\t            divergences_by_rail.setdefault(nat[\"rail\"], []).append(\n468\t                divergence_pct\n469\t            )\n470\t        matched.append({\n471\t            \"session_id\": str(nat[\"session_id\"] or \"\"),\n472\t            \"agent_type\": str(nat[\"agent_type\"] or \"\").strip().lower(),\n473\t            \"ordinal\": ordinal,\n474\t            \"join\": join,\n475\t            \"native_rail\": nat[\"rail\"],\n476\t            \"native_start_ts\": nat[\"start_ts\"],\n477\t            \"native_tokens_in\": nat[\"tokens_in\"],\n478\t            \"native_tokens_out\": nat[\"tokens_out\"],\n479\t            \"native_cache_creation_tokens\": nat[\"cache_creation_tokens\"],\n480\t            \"native_cache_read_tokens\": nat[\"cache_read_tokens\"],\n481\t            \"native_model_raw\": nat[\"model_raw\"],\n482\t            \"native_model_id\": nat[\"model_id\"],\n483\t            \"native_cost_usd\": nat[\"cost_usd\"],\n484\t            \"native_cost_tbd\": nat[\"cost_tbd\"],\n485\t            \"audit_ts\": aud[\"ts\"],\n486\t            \"audit_model\": aud[\"model\"],\n487\t            \"audit_tokens_in\": aud[\"tokens_in\"],\n488\t            \"audit_tokens_out\": aud[\"tokens_out\"],\n489\t            \"audit_tokens_total\": aud[\"tokens_total\"],\n490\t            \"comparable\": comparable,\n491\t            \"divergence_pct\": divergence_pct,\n492\t        })\n493\t\n494\t    for nat, aud in exact_pairs:\n495\t        _emit_pair(nat, aud, None, \"desc_hash\")\n496\t\n497\t    for key in sorted(set(native_by) | set(audit_by)):\n498\t        n_group = native_by.get(key, [])\n499\t        a_group = audit_by.get(key, [])\n500\t        pair_n = min(len(n_group), len(a_group))\n501\t        for i in range(pair_n):\n502\t            _emit_pair(n_group[i], a_group[i], i, \"ordinal\")\n503\t        for i in range(pair_n, len(n_group)):\n504\t            rec = dict(n_group[i])\n505\t            rec[\"ordinal\"] = i\n506\t            unmatched_native.append(rec)\n507\t        for i in range(pair_n, len(a_group)):\n508\t            row = dict(a_group[i])\n509\t            row[\"ordinal\"] = i\n510\t            unmatched_audit.append(row)\n511\t\n512\t    tok = {\n513\t        \"in\": sum(int(r[\"tokens_in\"]) for r in native),\n514\t        \"out\": sum(int(r[\"tokens_out\"]) for r in native),\n515\t        \"cache_creation\": sum(int(r[\"cache_creation_tokens\"]) for r in native),\n516\t        \"cache_read\": sum(int(r[\"cache_read_tokens\"]) for r in native),\n517\t    }\n518\t    priced = [r for r in native if r[\"cost_usd\"] is not None]\n519\t    tbd_spawns = len(native) - len(priced)\n520\t    native_cost = round(sum(float(r[\"cost_usd\"]) for r in priced), 6) if priced else None\n521\t\n522\t    max_div: Dict[str, Optional[float]] = {}\n523\t    for rail in (\"task\", \"workflow\"):\n524\t        vals = divergences_by_rail.get(rail) or []\n525\t        max_div[rail] = max(vals) if vals else None\n526\t\n527\t    comparable_pairs = sum(1 for m in matched if m[\"comparable\"])\n528\t\n529\t    result = {\n530\t        \"doctrine\": doctrine,\n531\t        \"native_root\": str(root),\n532\t        \"dormant\": False,\n533\t        \"native_spawn_count\": len(native),\n534\t        \"native_task_spawns\": sum(1 for r in native if r[\"rail\"] == \"task\"),\n535\t        \"native_workflow_spawns\": sum(\n536\t            1 for r in native if r[\"rail\"] == \"workflow\"\n537\t        ),\n538\t        \"native_usage_event_count\": sum(int(r[\"usage_events\"]) for r in native),\n539\t        \"native_transcripts_unreadable\": read_counters.get(\n540\t            \"transcripts_unreadable\", 0\n541\t        ),\n542\t        \"audit_spawn_count\": len(audit_rows),\n543\t        \"matched_count\": len(matched),\n544\t        \"comparable_pair_count\": comparable_pairs,\n545\t        \"unmatched_native_count\": len(unmatched_native),\n546\t        \"unmatched_audit_count\": len(unmatched_audit),\n547\t        \"native_tokens\": tok,\n548\t        \"native_cost_usd\": native_cost,\n549\t        \"native_cost_tbd_spawns\": tbd_spawns,\n550\t        \"native_cost_note\": (\n551\t            \"spawns without a resolvable/priced model are cost TBD — they \"\n552\t            \"are NEVER priced as $0 and are excluded from native_cost_usd\"\n553\t        ),\n554\t        \"max_divergence_pct_by_rail\": max_div,\n555\t        \"matched\": matched,\n556\t        \"unmatched_native\": unmatched_native,\n557\t        \"unmatched_audit\": unmatched_audit,\n558\t    }\n559\t    if infra_note:\n560\t        result[\"note\"] = infra_note\n561\t    return result\n562\t\n563\t\n564\tdef validate_memory_claim(\n565\t    total_cost_usd: Optional[float],\n566\t    low: float = MEMORY_CLAIM_LOW_USD,\n567\t    high: float = MEMORY_CLAIM_HIGH_USD,\n568\t    ratio_low: float = MEMORY_CLAIM_PASS_RATIO_LOW,\n569\t    ratio_high: float = MEMORY_CLAIM_PASS_RATIO_HIGH,\n570\t) -> Dict[str, Any]:\n571\t    \"\"\"Check the rollup against the CLAUDE.md S82-S99 memory claim band.\n572\t\n573\t    Returns a structured verdict:\n574\t      - ``status``: ``\"pass\"`` (within band), ``\"warn\"`` (outside\n575\t        [ratio_low, ratio_high] multiplied band) or ``\"unknown\"``\n576\t        (no cost computed).\n577\t      - ``band_low_usd`` / ``band_high_usd`` / ``observed_usd`` /\n578\t        ``ratio_to_band_low`` / ``ratio_to_band_high``.\n579\t\n580\t    Methodology: the memory claim is itself a *range* ($1003-1543); we\n581\t    pass when the observed cost is anywhere inside, warn when outside\n582\t    the [0.5*low, 1.5*high] enclosing band. This wide gate accepts\n583\t    pricing-table drift while still flagging obvious bugs.\n584\t    \"\"\"\n585\t    if total_cost_usd is None:\n586\t        return {\n587\t            \"status\": \"unknown\",\n588\t            \"band_low_usd\": low,\n589\t            \"band_high_usd\": high,\n590\t            \"observed_usd\": None,\n591\t            \"ratio_to_band_low\": None,\n592\t            \"ratio_to_band_high\": None,\n593\t            \"message\": \"No cost computed; pricing table likely missed all models.\",\n594\t        }\n595\t    enclosing_low = low * ratio_low\n596\t    enclosing_high = high * ratio_high\n597\t    if low <= total_cost_usd <= high:\n598\t        status = \"pass\"\n599\t        message = (\n600\t            f\"Observed ${total_cost_usd:.2f} within memory-claim \"\n601\t            f\"band [${low:.2f}, ${high:.2f}].\"\n602\t        )\n603\t    elif enclosing_low <= total_cost_usd <= enclosing_high:\n604\t        status = \"pass\"\n605\t        message = (\n606\t            f\"Observed ${total_cost_usd:.2f} within widened band \"\n607\t            f\"[${enclosing_low:.2f}, ${enclosing_high:.2f}] \"\n608\t            f\"(memory claim ${low:.2f}-${high:.2f}).\"\n609\t        )\n610\t    else:\n611\t        status = \"warn\"\n612\t        message = (\n613\t            f\"Observed ${total_cost_usd:.2f} OUTSIDE widened band \"\n614\t            f\"[${enclosing_low:.2f}, ${enclosing_high:.2f}] \"\n615\t            f\"(memory claim ${low:.2f}-${high:.2f}). \"\n616\t            f\"Likely token-tracking gap OR pricing drift.\"\n617\t        )\n618\t    return {\n619\t        \"status\": status,\n620\t        \"band_low_usd\": low,\n621\t        \"band_high_usd\": high,\n622\t        \"observed_usd\": total_cost_usd,\n623\t        \"ratio_to_band_low\": round(total_cost_usd / low, 4) if low else None,\n624\t        \"ratio_to_band_high\": round(total_cost_usd / high, 4) if high else None,\n625\t        \"message\": message,\n626\t    }\n627\t\n628\t\n629\tdef _fmt_tokens(n: int) -> str:\n630\t    return f\"{n:>14,}\"\n631\t\n632\t\n633\t\n634\t\n635\t\n636\t"}]},"parent_tool_use_id":null,"session_id":"554a7565-eb62-4598-9760-aeebd94af377","uuid":"0c968d6a-4372-43b4-90d3-34230e2859b6","timestamp":"2026-11-16T19:39:07.717Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/native_reconciliation.py","content":"from __future__ import annotations\n\nMEMORY_CLAIM_LOW_USD = 1003.0\nMEMORY_CLAIM_HIGH_USD = 1543.0\nMEMORY_CLAIM_PASS_RATIO_LOW = 0.5\nMEMORY_CLAIM_PASS_RATIO_HIGH = 1.5\n\ndef _read_native_spawn(\n    transcript: Path,\n    rail: str,\n    session_id: str,\n    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n    counters: Optional[Dict[str, int]] = None,\n) -> Optional[Dict[str, Any]]:\n    \"\"\"Read ONE native spawn (transcript + tolerant meta pairing).\n\n    Tolerant by doctrine (probe §handoff item 3): a missing meta, a\n    malformed/truncated line (live session appending), or a missing\n    field degrades the record — it never raises. Model precedence:\n    ``meta.model`` first, else the first ``message.model`` seen in the\n    transcript (the workflow-path metas carry NO model at all). A\n    ``meta.model`` that resolves to NOTHING (a bare family alias such as\n    ``fable`` once the registry holds two Fable ids — ADR-149 Amendment\n    2) falls back to the transcript's exact ``message.model``: exact\n    evidence beats an ambiguous alias, and neither is ever guessed.\n    \"\"\"\n    stem = transcript.name[: -len(\".jsonl\")]\n    meta_path = transcript.with_name(stem + \".meta.json\")\n    agent_type = \"(unknown)\"\n    meta_model: Optional[str] = None\n    meta_description: Optional[str] = None\n    if meta_path.is_file():\n        try:\n            meta = json.loads(meta_path.read_text(encoding=\"utf-8\"))\n        except (OSError, ValueError):\n            meta = None\n        if isinstance(meta, dict):\n            # Hard fingerprint invariants (substrate-watch cc_native_usage,\n            # 416/416 measured; codex S306 r3 P2 cure — same sonda as the\n            # standalone puller): a meta that parses but lost either field\n            # is schema drift, counted so native_cross_check can degrade.\n            if \"agentType\" not in meta or \"spawnDepth\" not in meta:\n                if counters is not None:\n                    counters[\"meta_invariant_missing\"] = (\n                        counters.get(\"meta_invariant_missing\", 0) + 1\n                    )\n            at = meta.get(\"agentType\")\n            if isinstance(at, str) and at.strip():\n                agent_type = at.strip()\n            mm = meta.get(\"model\")\n            if isinstance(mm, str) and mm.strip():\n                meta_model = mm.strip()\n            md = meta.get(\"description\")\n            if isinstance(md, str) and md:\n                meta_description = md\n\n    start_ts: Optional[str] = None\n    transcript_model: Optional[str] = None\n    sums = {k: 0 for k in _NATIVE_USAGE_KEYS}\n    cache_5m = 0                      # nested usage.cache_creation split\n    cache_1h = 0                      # (codex S306 r3 P2 cure — 1h TTL @2.0x)\n    usage_events = 0\n    try:\n        with transcript.open(\"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n            for raw in f:\n                raw = raw.strip()\n                if not raw:\n                    continue\n                try:\n                    rec = json.loads(raw)\n                except ValueError:\n                    continue\n                if not isinstance(rec, dict):\n                    continue\n                ts = rec.get(\"timestamp\")\n                if start_ts is None and isinstance(ts, str) and ts:\n                    start_ts = ts\n                msg = rec.get(\"message\")\n                if not isinstance(msg, dict):\n                    continue\n                if transcript_model is None:\n                    m = msg.get(\"model\")\n                    if isinstance(m, str) and m.strip():\n                        transcript_model = m.strip()\n                usage = msg.get(\"usage\")\n                if not isinstance(usage, dict):\n                    continue\n                # Fingerprint drift sonda (codex S306 r2 P2 cure): a usage\n                # dict with NEITHER core key is schema drift — counted so\n                # native_cross_check can degrade to audit-only, never summed\n                # as a zero-token event.\n                if (\"input_tokens\" not in usage) and (\"output_tokens\" not in usage):\n                    if counters is not None:\n                        counters[\"usage_missing_core_keys\"] = (\n                            counters.get(\"usage_missing_core_keys\", 0) + 1\n                        )\n                    continue\n                bearing = False\n                for key in _NATIVE_USAGE_KEYS:\n                    v = usage.get(key)\n                    if isinstance(v, (int, float)):\n                        sums[key] += int(v)\n                        if key in (\"input_tokens\", \"output_tokens\"):\n                            bearing = True\n                cc = usage.get(\"cache_creation\")\n                if isinstance(cc, dict):\n                    v5 = cc.get(\"ephemeral_5m_input_tokens\")\n                    v1 = cc.get(\"ephemeral_1h_input_tokens\")\n                    if isinstance(v5, (int, float)):\n                        cache_5m += int(v5)\n                    if isinstance(v1, (int, float)):\n                        cache_1h += int(v1)\n                if bearing:\n                    usage_events += 1\n    except OSError:\n        # codex S306 P2 cure: an unreadable transcript must NOT degrade to a\n        # zero-token record with a \"known\" $0.00 cost — it corrupts totals\n        # AND the ordinal join. Skip the spawn, count it observably.\n        if counters is not None:\n            counters[\"transcripts_unreadable\"] = (\n                counters.get(\"transcripts_unreadable\", 0) + 1\n            )\n        sys.stderr.write(\n            \"budget-summary: unreadable native transcript — spawn skipped: \"\n            \"%s\\n\" % transcript\n        )\n        return None\n\n    model_raw = meta_model or transcript_model\n    model_id = _normalize_model_id(model_raw, pricing=pricing)\n    if (\n        model_id is None\n        and meta_model\n        and transcript_model\n        and transcript_model.strip().lower() != meta_model.strip().lower()\n    ):\n        # ADR-149 Amendment 2 (S338, codex rail r2 P2): a bare family\n        # alias in the meta (\"fable\") turned AMBIGUOUS once the registry\n        # held two Fable ids, and the doctrine never guesses a version.\n        # The transcript's own message.model is exact evidence, not a\n        # guess — fall back to it. Still unresolved => TBD, as before.\n        model_raw = transcript_model\n        model_id = _normalize_model_id(model_raw, pricing=pricing)\n    t_in = sums[\"input_tokens\"]\n    t_out = sums[\"output_tokens\"]\n    # Cache classes are BILLABLE (docs/provider-pricing.md: read @0.10x\n    # input — per-model exceptions in _CACHE_READ_MULTIPLIER_OVERRIDES —,\n    # write @1.25x on the 5m TTL and @2.00x on the 1h TTL). When the\n    # transcript carries the nested ``usage.cache_creation`` split, each\n    # tier gets its own multiplier (codex S306 r3 P2 cure); writes NOT\n    # attributed by the split assume 5m, the API default. Priced as\n    # input-token EQUIVALENTS so compute_cost_usd's full row/dated-row\n    # resolution is reused instead of a second rate table (codex S306 r1 P1\n    # cure: pricing only fresh in/out understated the native total ~10x).\n    c_total = sums[\"cache_creation_input_tokens\"]\n    c_1h = min(cache_1h, c_total)\n    c_5m = min(cache_5m, c_total - c_1h)\n    c_rest = c_total - c_1h - c_5m    # unattributed -> 5m assumption\n    cache_equiv_in = int(\n        _cache_read_multiplier(model_id) * sums[\"cache_read_input_tokens\"]\n        + 1.25 * (c_5m + c_rest)\n        + 2.00 * c_1h\n    )\n    cost = compute_cost_usd(\n        model_id, t_in + cache_equiv_in, t_out, pricing=pricing, ts=start_ts\n    )\n    return {\n        \"session_id\": session_id,\n        \"rail\": rail,\n        \"agent_type\": agent_type,\n        \"description\": meta_description,\n        \"transcript\": transcript.name,\n        \"start_ts\": start_ts,\n        \"usage_events\": usage_events,\n        \"tokens_in\": t_in,\n        \"tokens_out\": t_out,\n        \"cache_creation_tokens\": sums[\"cache_creation_input_tokens\"],\n        \"cache_read_tokens\": sums[\"cache_read_input_tokens\"],\n        \"model_raw\": model_raw,\n        \"model_id\": model_id,\n        \"cost_usd\": cost,\n        \"cost_tbd\": cost is None,\n    }\n\n\ndef collect_native_spawns(\n    native_root: Optional[Path] = None,\n    *,\n    cutoff: Optional[datetime] = None,\n    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n    counters: Optional[Dict[str, int]] = None,\n) -> List[Dict[str, Any]]:\n    \"\"\"Collect all native spawn records under ``native_root``.\n\n    ``cutoff`` mirrors the rollup's ``--since`` semantics: a spawn whose\n    start timestamp parses AND precedes the cutoff is excluded; a spawn\n    with no parseable timestamp is kept (visibility over silence).\n    \"\"\"\n    spawns: List[Dict[str, Any]] = []\n    for path, rail, session_id in _native_transcript_paths(native_root):\n        rec = _read_native_spawn(\n            path, rail, session_id, pricing=pricing, counters=counters\n        )\n        if rec is None:               # unreadable transcript — counted, skipped\n            continue\n        if cutoff is not None:\n            parsed = _parse_ts_any(rec.get(\"start_ts\"))\n            if parsed is not None and parsed < cutoff:\n                continue\n        spawns.append(rec)\n    return spawns\n\n\ndef _collect_audit_spawn_rows(\n    log_paths: Iterable[Path],\n    cutoff: Optional[datetime] = None,\n) -> List[Dict[str, Any]]:\n    \"\"\"Audit-log side of the join: one row per ``agent_spawn`` event.\n\n    Token fields are None-PRESERVING (not coerced to 0): a null stays\n    null so the report can say \"no number on the audit side\" instead of\n    fabricating a 0 that would fake a divergence.\n    \"\"\"\n\n    def _opt_int(v: Any) -> Optional[int]:\n        if isinstance(v, bool):\n            return None\n        if isinstance(v, (int, float)):\n            return int(v)\n        return None\n\n    rows: List[Dict[str, Any]] = []\n    for ev in iter_unique_events(log_paths):\n        if (ev.get(\"action\") or \"\") != \"agent_spawn\":\n            continue\n        ts_parsed = _parse_ts(ev.get(\"ts\"))\n        if cutoff is not None and ts_parsed is not None and ts_parsed < cutoff:\n            continue\n        subagent_type = ev.get(\"subagent_type\")\n        desc_hash = ev.get(\"desc_hash\")\n        rows.append({\n            \"session_id\": ev.get(\"session_id\") or \"(unknown)\",\n            \"agent_type\": (\n                subagent_type.strip()\n                if isinstance(subagent_type, str) and subagent_type.strip()\n                else \"(unknown)\"\n            ),\n            \"desc_hash\": (\n                desc_hash if isinstance(desc_hash, str) and desc_hash else None\n            ),\n            \"ts\": ev.get(\"ts\"),\n            \"model\": ev.get(\"model\"),\n            \"tokens_in\": _opt_int(ev.get(\"tokens_in\")),\n            \"tokens_out\": _opt_int(ev.get(\"tokens_out\")),\n            \"tokens_total\": _opt_int(ev.get(\"tokens_total\")),\n        })\n    return rows\n\n\ndef _audit_total_tokens(row: Dict[str, Any]) -> Optional[int]:\n    \"\"\"Comparable audit-side token total, or None when the ledger has no\n    number for this spawn (the current-rotation reality: all null).\"\"\"\n    total = row.get(\"tokens_total\")\n    if isinstance(total, int):\n        return total\n    t_in = row.get(\"tokens_in\")\n    t_out = row.get(\"tokens_out\")\n    if isinstance(t_in, int) and isinstance(t_out, int):\n        return t_in + t_out\n    return None\n\n\ndef native_cross_check(\n    *,\n    audit_dir: Optional[Path] = None,\n    native_root: Optional[Path] = None,\n    since: Optional[timedelta] = None,\n    now: Optional[datetime] = None,\n    pricing: Optional[Dict[str, Dict[str, float]]] = None,\n) -> Dict[str, Any]:\n    \"\"\"Join the audit-log spawn ledger against the native corpus (W1.2-2).\n\n    Join key: ``(session_id, agent_type)`` with agent_type =\n    audit ``subagent_type`` ≈ native meta ``agentType`` (case-folded);\n    within each group both sides sort by timestamp and zip by ordinal.\n    Matched pairs, plus UNMATCHED residue from BOTH sides, are all\n    returned — nothing is silenced. Read-only; fail-open on infra\n    (a broken corpus degrades to a dormant block with a note, never a\n    crash — the audit-log rollup is unaffected either way).\n    \"\"\"\n    if now is None:\n        now = datetime.now(timezone.utc)\n    cutoff = (now - since) if since is not None else None\n    root = native_root if native_root is not None else default_native_root()\n\n    doctrine = (\n        \"cross-check, not authority-swap: the native source NEVER \"\n        \"silently replaces the audit-log rollup\"\n    )\n\n    infra_note: Optional[str] = None\n    read_counters: Dict[str, int] = {}\n    try:\n        transcript_count = len(_native_transcript_paths(root))\n        native = collect_native_spawns(\n            root, cutoff=cutoff, pricing=pricing, counters=read_counters\n        )\n    except Exception as exc:  # fail-open on infra (CLAUDE.md §4)\n        transcript_count = 0\n        native = []\n        infra_note = (\n            f\"native collection failed ({type(exc).__name__}) — degraded to \"\n            f\"audit-log only\"\n        )\n\n    # Audit side is read BEFORE any early return (codex S306 r5 P2 cure): a\n    # dormant/drifted native source must still report ACCURATE audit counts —\n    # hard-coded zeros would tell JSON consumers the audit ledger is empty\n    # when only the native side is missing.\n    audit_rows = _collect_audit_spawn_rows(discover_logs(audit_dir), cutoff)\n\n    # Path-shape sonda (codex S306 r3 P2 cure — parity with the puller): a\n    # walk sweep seeing MORE agent transcripts than the two known globs\n    # matched means the harness moved the layout. Report DRIFT, never\n    # ordinary dormancy or a zero total.\n    try:\n        walk_seen = sum(\n            1 for p in root.rglob(\"agent-a*.jsonl\") if \"subagents\" in p.parts\n        )\n    except OSError:\n        walk_seen = transcript_count\n    if walk_seen > transcript_count:\n        return {\n            \"doctrine\": doctrine,\n            \"native_root\": str(root),\n            \"dormant\": True,\n            \"degraded\": \"schema-drift\",\n            \"drift\": {\"path_shape_unmatched\": walk_seen - transcript_count},\n            \"native_spawn_count\": 0,\n            \"audit_spawn_count\": len(audit_rows),\n            \"unmatched_audit_count\": len(audit_rows),\n            \"note\": (\n                \"native path shape drifted (%d transcript(s) outside the \"\n                \"known globs) — cross-check degraded to audit-log only\"\n                % (walk_seen - transcript_count)\n            ),\n        }\n\n    if transcript_count == 0:\n        result: Dict[str, Any] = {\n            \"doctrine\": doctrine,\n            \"native_root\": str(root),\n            \"dormant\": True,\n            \"native_spawn_count\": 0,\n            \"audit_spawn_count\": len(audit_rows),\n            \"matched_count\": 0,\n            \"comparable_pair_count\": 0,\n            \"unmatched_native_count\": 0,\n            \"unmatched_audit_count\": len(audit_rows),\n            \"note\": (\n                infra_note\n                or \"no native transcripts found — audit-log rollup is the \"\n                   \"sole source (dormant, by design)\"\n            ),\n        }\n        return result\n\n    # Drift gate on the integrated reader (codex S306 r2 P2 cure — same\n    # fingerprint sonda as the puller): usage dicts whose core token keys\n    # vanished mean the harness schema moved; publishing zero/partial totals\n    # would present drift as genuine zero usage. Degrade to audit-only.\n    drift_hits = {\n        k: read_counters.get(k, 0)\n        for k in (\"usage_missing_core_keys\", \"meta_invariant_missing\")\n        if read_counters.get(k, 0) > 0\n    }\n    if drift_hits:\n        return {\n            \"doctrine\": doctrine,\n            \"native_root\": str(root),\n            \"dormant\": True,\n            \"degraded\": \"schema-drift\",\n            \"drift\": dict(read_counters),\n            \"native_spawn_count\": 0,\n            \"audit_spawn_count\": len(audit_rows),\n            \"unmatched_audit_count\": len(audit_rows),\n            \"note\": (\n                \"native schema drifted (%s) — cross-check degraded to \"\n                \"audit-log only\"\n                % \", \".join(f\"{k}={v}\" for k, v in sorted(drift_hits.items()))\n            ),\n        }\n\n    def _key(session_id: Any, agent_type: Any) -> Tuple[str, str]:\n        return (\n            str(session_id or \"\"),\n            str(agent_type or \"\").strip().lower(),\n        )\n\n    # Pass 0 — EXACT join (codex S306 r2 P1 cure): native ``meta.description``\n    # hashes (sha256, same function as audit_log's hash_description) to the\n    # audit row's ``desc_hash``. This survives the shape where a teammate's\n    # native agentType is its NAME while the audit row says\n    # ``general-purpose`` — the (session, type) grouping alone under-matches.\n    audit_by_hash: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}\n    for row in audit_rows:\n        h = row.get(\"desc_hash\")\n        if isinstance(h, str) and h:\n            audit_by_hash.setdefault(\n                (str(row[\"session_id\"] or \"\"), h), []\n            ).append(row)\n    for group in audit_by_hash.values():\n        group.sort(key=lambda r: r.get(\"ts\") or \"\")\n    exact_pairs: List[Tuple[Dict[str, Any], Dict[str, Any]]] = []\n    consumed_audit: Set[int] = set()\n    remaining_native: List[Dict[str, Any]] = []\n    # Duplicate-description groups pair oldest-to-oldest on BOTH sides\n    # (codex S306 r4 P2 cure): the audit hash groups are ts-sorted above, so\n    # native candidates must be consumed in start_ts order too — glob order\n    # would associate the wrong token totals within the duplicate group.\n    for rec in sorted(native, key=lambda r: r.get(\"start_ts\") or \"\"):\n        desc = rec.get(\"description\")\n        if isinstance(desc, str) and desc:\n            hkey = (\n                str(rec[\"session_id\"] or \"\"),\n                hashlib.sha256(\n                    desc.encode(\"utf-8\", errors=\"replace\")\n                ).hexdigest(),\n            )\n            group = audit_by_hash.get(hkey)\n            if group:\n                aud = group.pop(0)\n                consumed_audit.add(id(aud))\n                exact_pairs.append((rec, aud))\n                continue\n        remaining_native.append(rec)\n    remaining_audit = [r for r in audit_rows if id(r) not in consumed_audit]\n\n    native_by: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}\n    for rec in remaining_native:\n        native_by.setdefault(_key(rec[\"session_id\"], rec[\"agent_type\"]), []).append(rec)\n    audit_by: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}\n    for row in remaining_audit:\n        audit_by.setdefault(_key(row[\"session_id\"], row[\"agent_type\"]), []).append(row)\n\n    for group in native_by.values():\n        group.sort(key=lambda r: r.get(\"start_ts\") or \"\")\n    for group in audit_by.values():\n        group.sort(key=lambda r: r.get(\"ts\") or \"\")\n\n    matched: List[Dict[str, Any]] = []\n    unmatched_native: List[Dict[str, Any]] = []\n    unmatched_audit: List[Dict[str, Any]] = []\n    divergences_by_rail: Dict[str, List[float]] = {\"task\": [], \"workflow\": []}\n\n    def _emit_pair(nat: Dict[str, Any], aud: Dict[str, Any],\n                   ordinal: Optional[int], join: str) -> None:\n        nat_total = int(nat[\"tokens_in\"]) + int(nat[\"tokens_out\"])\n        aud_total = _audit_total_tokens(aud)\n        comparable = aud_total is not None\n        divergence_pct: Optional[float] = None\n        if comparable:\n            base = aud_total if aud_total else 1\n            divergence_pct = round(\n                abs(nat_total - aud_total) * 100.0 / base, 2\n            )\n            divergences_by_rail.setdefault(nat[\"rail\"], []).append(\n                divergence_pct\n            )\n        matched.append({\n            \"session_id\": str(nat[\"session_id\"] or \"\"),\n            \"agent_type\": str(nat[\"agent_type\"] or \"\").strip().lower(),\n            \"ordinal\": ordinal,\n            \"join\": join,\n            \"native_rail\": nat[\"rail\"],\n            \"native_start_ts\": nat[\"start_ts\"],\n            \"native_tokens_in\": nat[\"tokens_in\"],\n            \"native_tokens_out\": nat[\"tokens_out\"],\n            \"native_cache_creation_tokens\": nat[\"cache_creation_tokens\"],\n            \"native_cache_read_tokens\": nat[\"cache_read_tokens\"],\n            \"native_model_raw\": nat[\"model_raw\"],\n            \"native_model_id\": nat[\"model_id\"],\n            \"native_cost_usd\": nat[\"cost_usd\"],\n            \"native_cost_tbd\": nat[\"cost_tbd\"],\n            \"audit_ts\": aud[\"ts\"],\n            \"audit_model\": aud[\"model\"],\n            \"audit_tokens_in\": aud[\"tokens_in\"],\n            \"audit_tokens_out\": aud[\"tokens_out\"],\n            \"audit_tokens_total\": aud[\"tokens_total\"],\n            \"comparable\": comparable,\n            \"divergence_pct\": divergence_pct,\n        })\n\n    for nat, aud in exact_pairs:\n        _emit_pair(nat, aud, None, \"desc_hash\")\n\n    for key in sorted(set(native_by) | set(audit_by)):\n        n_group = native_by.get(key, [])\n        a_group = audit_by.get(key, [])\n        pair_n = min(len(n_group), len(a_group))\n        for i in range(pair_n):\n            _emit_pair(n_group[i], a_group[i], i, \"ordinal\")\n        for i in range(pair_n, len(n_group)):\n            rec = dict(n_group[i])\n            rec[\"ordinal\"] = i\n            unmatched_native.append(rec)\n        for i in range(pair_n, len(a_group)):\n            row = dict(a_group[i])\n            row[\"ordinal\"] = i\n            unmatched_audit.append(row)\n\n    tok = {\n        \"in\": sum(int(r[\"tokens_in\"]) for r in native),\n        \"out\": sum(int(r[\"tokens_out\"]) for r in native),\n        \"cache_creation\": sum(int(r[\"cache_creation_tokens\"]) for r in native),\n        \"cache_read\": sum(int(r[\"cache_read_tokens\"]) for r in native),\n    }\n    priced = [r for r in native if r[\"cost_usd\"] is not None]\n    tbd_spawns = len(native) - len(priced)\n    native_cost = round(sum(float(r[\"cost_usd\"]) for r in priced), 6) if priced else None\n\n    max_div: Dict[str, Optional[float]] = {}\n    for rail in (\"task\", \"workflow\"):\n        vals = divergences_by_rail.get(rail) or []\n        max_div[rail] = max(vals) if vals else None\n\n    comparable_pairs = sum(1 for m in matched if m[\"comparable\"])\n\n    result = {\n        \"doctrine\": doctrine,\n        \"native_root\": str(root),\n        \"dormant\": False,\n        \"native_spawn_count\": len(native),\n        \"native_task_spawns\": sum(1 for r in native if r[\"rail\"] == \"task\"),\n        \"native_workflow_spawns\": sum(\n            1 for r in native if r[\"rail\"] == \"workflow\"\n        ),\n        \"native_usage_event_count\": sum(int(r[\"usage_events\"]) for r in native),\n        \"native_transcripts_unreadable\": read_counters.get(\n            \"transcripts_unreadable\", 0\n        ),\n        \"audit_spawn_count\": len(audit_rows),\n        \"matched_count\": len(matched),\n        \"comparable_pair_count\": comparable_pairs,\n        \"unmatched_native_count\": len(unmatched_native),\n        \"unmatched_audit_count\": len(unmatched_audit),\n        \"native_tokens\": tok,\n        \"native_cost_usd\": native_cost,\n        \"native_cost_tbd_spawns\": tbd_spawns,\n        \"native_cost_note\": (\n            \"spawns without a resolvable/priced model are cost TBD — they \"\n            \"are NEVER priced as $0 and are excluded from native_cost_usd\"\n        ),\n        \"max_divergence_pct_by_rail\": max_div,\n        \"matched\": matched,\n        \"unmatched_native\": unmatched_native,\n        \"unmatched_audit\": unmatched_audit,\n    }\n    if infra_note:\n        result[\"note\"] = infra_note\n    return result\n\n\ndef validate_memory_claim(\n    total_cost_usd: Optional[float],\n    low: float = MEMORY_CLAIM_LOW_USD,\n    high: float = MEMORY_CLAIM_HIGH_USD,\n    ratio_low: float = MEMORY_CLAIM_PASS_RATIO_LOW,\n    ratio_high: float = MEMORY_CLAIM_PASS_RATIO_HIGH,\n) -> Dict[str, Any]:\n    \"\"\"Check the rollup against the CLAUDE.md S82-S99 memory claim band.\n\n    Returns a structured verdict:\n      - ``status``: ``\"pass\"`` (within band), ``\"warn\"`` (outside\n        [ratio_low, ratio_high] multiplied band) or ``\"unknown\"``\n        (no cost computed).\n      - ``band_low_usd`` / ``band_high_usd`` / ``observed_usd`` /\n        ``ratio_to_band_low`` / ``ratio_to_band_high``.\n\n    Methodology: the memory claim is itself a *range* ($1003-1543); we\n    pass when the observed cost is anywhere inside, warn when outside\n    the [0.5*low, 1.5*high] enclosing band. This wide gate accepts\n    pricing-table drift while still flagging obvious bugs.\n    \"\"\"\n    if total_cost_usd is None:\n        return {\n            \"status\": \"unknown\",\n            \"band_low_usd\": low,\n            \"band_high_usd\": high,\n            \"observed_usd\": None,\n            \"ratio_to_band_low\": None,\n            \"ratio_to_band_high\": None,\n            \"message\": \"No cost computed; pricing table likely missed all models.\",\n        }\n    enclosing_low = low * ratio_low\n    enclosing_high = high * ratio_high\n    if low <= total_cost_usd <= high:\n        status = \"pass\"\n        message = (\n            f\"Observed ${total_cost_usd:.2f} within memory-claim \"\n            f\"band [${low:.2f}, ${high:.2f}].\"\n        )\n    elif enclosing_low <= total_cost_usd <= enclosing_high:\n        status = \"pass\"\n        message = (\n            f\"Observed ${total_cost_usd:.2f} within widened band \"\n            f\"[${enclosing_low:.2f}, ${enclosing_high:.2f}] \"\n            f\"(memory claim ${low:.2f}-${high:.2f}).\"\n        )\n    else:\n        status = \"warn\"\n        message = (\n            f\"Observed ${total_cost_usd:.2f} OUTSIDE widened band \"\n            f\"[${enclosing_low:.2f}, ${enclosing_high:.2f}] \"\n            f\"(memory claim ${low:.2f}-${high:.2f}). \"\n            f\"Likely token-tracking gap OR pricing drift.\"\n        )\n    return {\n        \"status\": status,\n        \"band_low_usd\": low,\n        \"band_high_usd\": high,\n        \"observed_usd\": total_cost_usd,\n        \"ratio_to_band_low\": round(total_cost_usd / low, 4) if low else None,\n        \"ratio_to_band_high\": round(total_cost_usd / high, 4) if high else None,\n        \"message\": message,\n    }\n\n\ndef _fmt_tokens(n: int) -> str:\n    return f\"{n:>14,}\"\n\n\n\n\n\n","numLines":636,"startLine":1,"totalLines":636}},"tool_result_meta":[{"id":"toolu_01Dpv9H6EHVcaEvvtzyCJSc5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7B11ewKvzDVjiiQxCgU","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_014stM2cjwKvxsk9UQ3xdvGi","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/presentation_cli.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":10571,"cache_read_input_tokens":75179,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":10571},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"554a7565-eb62-4598-9760-aeebd94af377","uuid":"44d6a32b-9645-4aa7-8314-2f336f6b34df","timestamp":"2026-11-16T19:39:08.456Z","request_id":"req_011Ch7B11U357kLyaZ45mzCo","wire_tool_inputs":{"toolu_014stM2cjwKvxsk9UQ3xdvGi":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/presentation_cli.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014stM2cjwKvxsk9UQ3xdvGi","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tdef load_transcripts_instrument():\n4\t    \"\"\"Import `ceo-cost-transcripts.py` from next to this file, or None.\n5\t\n6\t    Fail-soft by construction: an unimportable instrument degrades the\n7\t    primary source to a labelled note, it never breaks the audit rollup.\n8\t    \"\"\"\n9\t    cached = sys.modules.get(_TRANSCRIPTS_MODULE_NAME)\n10\t    if cached is not None:\n11\t        return cached\n12\t    src = Path(__file__).resolve().parent / _TRANSCRIPTS_FILENAME\n13\t    if not src.is_file():\n14\t        return None\n15\t    try:\n16\t        spec = importlib.util.spec_from_file_location(\n17\t            _TRANSCRIPTS_MODULE_NAME, src\n18\t        )\n19\t        if spec is None or spec.loader is None:\n20\t            return None\n21\t        mod = importlib.util.module_from_spec(spec)\n22\t        # Registered BEFORE exec_module: with `from __future__ import\n23\t        # annotations`, @dataclass resolves sys.modules[cls.__module__] at\n24\t        # class-definition time and blows up on a missing entry.\n25\t        sys.modules[_TRANSCRIPTS_MODULE_NAME] = mod\n26\t        spec.loader.exec_module(mod)\n27\t        return mod\n28\t    except Exception:\n29\t        sys.modules.pop(_TRANSCRIPTS_MODULE_NAME, None)\n30\t        return None\n31\t\n32\t\n33\tdef transcripts_root(root_arg: Optional[str] = None) -> Optional[Path]:\n34\t    \"\"\"Resolve the transcripts corpus root (flag > env > shared resolver).\"\"\"\n35\t    mod = load_transcripts_instrument()\n36\t    if mod is None:\n37\t        return Path(root_arg) if root_arg else None\n38\t    return mod.resolve_root(root_arg)\n39\t\n40\t\n41\tdef _tx_audit_pinned(path_arg: Optional[str] = None) -> bool:\n42\t    \"\"\"True when the SECONDARY (audit) ledger was pointed at a specific\n43\t    place — by flag or by CEO_AUDIT_LOG_PATH / CEO_AUDIT_LOG_DIR. Rail r3\n44\t    P1-1: a flag is not the only carrier, and the cross-project pairing only\n45\t    EXISTS when both ledgers are on screen.\n46\t    \"\"\"\n47\t    mod = load_transcripts_instrument()\n48\t    if mod is None:\n49\t        return bool(path_arg)\n50\t    return mod.audit_source_is_pinned(\n51\t        path_arg, carriers=_AUDIT_ENV_CARRIERS\n52\t    )\n53\t\n54\t\n55\tdef collect_transcripts(\n56\t    root_arg: Optional[str] = None,\n57\t    cutoff: Optional[datetime] = None,\n58\t    audit_override: bool = False,\n59\t) -> Dict[str, Any]:\n60\t    \"\"\"Primary-source rollup, or a `{\"available\": False, \"reason\": ...}` note.\n61\t\n62\t    `budget-summary` has no `--by` flag, so the breakdown dimension is fixed\n63\t    to `model` — the same dimension its audit-side `per_plan` table is most\n64\t    comparable against. `audit_override` says `--audit-dir` pointed the\n65\t    SECONDARY source at an explicit path; with no explicit transcripts root\n66\t    that pairing crosses projects and is refused by name (rail r2 P1-1).\n67\t    \"\"\"\n68\t    mod = load_transcripts_instrument()\n69\t    if mod is None:\n70\t        return {\n71\t            \"available\": False,\n72\t            \"reason\": \"instrument ceo-cost-transcripts.py is not importable\",\n73\t        }\n74\t    return mod.collect(\n75\t        root_arg=root_arg,\n76\t        cutoff=cutoff,\n77\t        by=\"model\",\n78\t        audit_override=audit_override,\n79\t    )\n80\t\n81\t\n82\tdef format_human(data: Dict[str, Any], memory_claim: Optional[Dict[str, Any]] = None) -> str:\n83\t    \"\"\"Render the rollup as a human-readable text block.\n84\t\n85\t    PLAN-186 W0 (AC-1b): when `data` carries a `source` key the PRIMARY\n86\t    transcripts block is rendered first, labelled; `source == 'audit'`\n87\t    sets NO key at all, so that rendering is byte-identical to the\n88\t    pre-integration one.\n89\t    \"\"\"\n90\t    lines: List[str] = []\n91\t    source = data.get(\"source\")\n92\t    if source is not None:\n93\t        mod = load_transcripts_instrument()\n94\t        if mod is None:\n95\t            lines.append(\n96\t                \"transcripts source UNAVAILABLE: instrument \"\n97\t                \"ceo-cost-transcripts.py is not importable\"\n98\t            )\n99\t        else:\n100\t            lines.extend(mod.render_block(data.get(\"transcripts\")))\n101\t        lines.append(\"\")\n102\t        if source == \"transcripts\":\n103\t            return \"\\n\".join(lines)\n104\t        lines.append(AUDIT_BANNER)\n105\t        lines.append(\"\")\n106\t    scope = data.get(\"plan_filter\") or \"(all plans)\"\n107\t    since = data.get(\"since\") or \"(all time)\"\n108\t    lines.append(f\"FinOps summary — scope={scope} since={since}\")\n109\t    lines.append(\"-\" * 70)\n110\t    lines.append(f\"Audit dir       : {data.get('audit_dir')}\")\n111\t    files = data.get(\"log_files_read\") or []\n112\t    lines.append(f\"Logs read       : {len(files)} file(s)\")\n113\t    for f in files:\n114\t        lines.append(f\"                  - {f}\")\n115\t    lines.append(f\"Events          : {data['total_events']:>14,}\")\n116\t    lines.append(f\"Codex events    : {data['codex_event_count']:>14,}\")\n117\t    lines.append(f\"Unknown plan_id : {data['unknown_plan_count']:>14,}\")\n118\t    lines.append(f\"Tokens in       : {_fmt_tokens(data['total_tokens_in'])}\")\n119\t    lines.append(f\"Tokens out      : {_fmt_tokens(data['total_tokens_out'])}\")\n120\t    lines.append(f\"Tokens total    : {_fmt_tokens(data['total_tokens'])}\")\n121\t    cost = data.get(\"total_cost_usd\")\n122\t    src = data.get(\"cost_source\") or \"unknown\"\n123\t    if cost is None:\n124\t        lines.append(f\"Cost (USD)      : -              (source={src})\")\n125\t    else:\n126\t        lines.append(f\"Cost (USD)      : ${cost:>13,.4f} (source={src})\")\n127\t\n128\t    per_plan = data.get(\"per_plan\") or []\n129\t    if per_plan and not data.get(\"plan_filter\"):\n130\t        lines.append(\"\")\n131\t        lines.append(\"Per plan:\")\n132\t        lines.append(\n133\t            f\"  {'plan_id':<14}  {'events':>7}  {'tokens_total':>14}  \"\n134\t            f\"{'cost_usd':>12}\"\n135\t        )\n136\t        for row in per_plan:\n137\t            cost_col = (\n138\t                f\"${row['cost_usd']:.4f}\" if row.get(\"cost_known\") else \"-\"\n139\t            )\n140\t            lines.append(\n141\t                f\"  {row['plan_id']:<14}  {row['event_count']:>7,}  \"\n142\t                f\"{row['tokens_total']:>14,}  {cost_col:>12}\"\n143\t            )\n144\t\n145\t    per_wave = data.get(\"per_wave\")\n146\t    if per_wave:\n147\t        lines.append(\"\")\n148\t        lines.append(\"Per wave:\")\n149\t        lines.append(\n150\t            f\"  {'wave':<14}  {'events':>7}  {'tokens_total':>14}  \"\n151\t            f\"{'cost_usd':>12}\"\n152\t        )\n153\t        for row in per_wave:\n154\t            cost_col = f\"${row['cost_usd']:.4f}\" if row['cost_usd'] else \"-\"\n155\t            lines.append(\n156\t                f\"  {row['wave']:<14}  {row['event_count']:>7,}  \"\n157\t                f\"{row['tokens_total']:>14,}  {cost_col:>12}\"\n158\t            )\n159\t\n160\t    # PLAN-133 C4 — harbor-style benchmark co-report (only when --benchmarks).\n161\t    benchmarks = data.get(\"benchmarks\")\n162\t    if benchmarks is not None:\n163\t        rows = benchmarks.get(\"per_skill\") or []\n164\t        lines.append(\"\")\n165\t        lines.append(\"Benchmarks (harbor-style — pass-rate never read alone):\")\n166\t        if not rows:\n167\t            lines.append(\"  (no benchmark_run events in scope)\")\n168\t        else:\n169\t            lines.append(\n170\t                f\"  {'skill':<24}  {'runs':>4}  {'pass_rate':>9}  \"\n171\t                f\"{'cost_usd':>10}  {'compute_s':>10}  {'turns':>7}\"\n172\t            )\n173\t            for row in rows:\n174\t                lines.append(\n175\t                    f\"  {str(row['skill'])[:24]:<24}  {row['runs']:>4}  \"\n176\t                    f\"{row['latest_pass_rate']:>9.3f}  \"\n177\t                    f\"${row['total_cost_usd']:>9.4f}  \"\n178\t                    f\"{row['total_compute_s']:>10.1f}  \"\n179\t                    f\"{row['total_turns']:>7,}\"\n180\t                )\n181\t            lines.append(\n182\t                f\"  {'TOTAL':<24}  {'':>4}  {'':>9}  \"\n183\t                f\"${benchmarks['total_cost_usd']:>9.4f}  \"\n184\t                f\"{benchmarks['total_compute_s']:>10.1f}  \"\n185\t                f\"{benchmarks['total_turns']:>7,}\"\n186\t            )\n187\t\n188\t    # PLAN-178 W1.2 — native cross-check (only when --native / env opt-in).\n189\t    native = data.get(\"native_cross_check\")\n190\t    if native is not None:\n191\t        lines.extend(_format_native_block(native))\n192\t\n193\t    if memory_claim is not None:\n194\t        lines.append(\"\")\n195\t        lines.append(\"Memory-claim validation:\")\n196\t        lines.append(f\"  status  : {memory_claim['status']}\")\n197\t        lines.append(f\"  message : {memory_claim['message']}\")\n198\t        # Rail r2 P2-2: say WHICH ledger the verdict is about. Only when\n199\t        # a second ledger is on screen — audit-only output is unchanged.\n200\t        if data.get(\"source\") is not None:\n201\t            lines.append(\n202\t                \"  scope   : validates the AUDIT total (SECONDARY); the \"\n203\t                \"transcripts total above is the PRIMARY figure\"\n204\t            )\n205\t\n206\t    return \"\\n\".join(lines)\n207\t\n208\t\n209\tdef format_json(data: Dict[str, Any], memory_claim: Optional[Dict[str, Any]] = None) -> str:\n210\t    payload = dict(data)\n211\t    if memory_claim is not None:\n212\t        payload[\"memory_claim_validation\"] = memory_claim\n213\t    return json.dumps(payload, indent=2, sort_keys=True)\n214\t\n215\t\n216\tdef build_parser() -> argparse.ArgumentParser:\n217\t    p = argparse.ArgumentParser(\n218\t        prog=\"budget-summary\",\n219\t        description=(\n220\t            \"FinOps rollup across all audit-log rotations \"\n221\t            \"(PLAN-083 Wave 0b sub-0.8).\"\n222\t        ),\n223\t    )\n224\t    sub = p.add_subparsers(dest=\"subcommand\")\n225\t\n226\t    sp = sub.add_parser(\"summary\", help=\"Print cumulative summary.\")\n227\t    sp.add_argument(\"--since\", metavar=\"EXPR\", default=None,\n228\t                    help=\"Time window (Nm/Nh/Nd, e.g. 30d).\")\n229\t    sp.add_argument(\"--plan-id\", metavar=\"PLAN-NNN\", default=None,\n230\t                    help=\"Limit rollup to a single plan_id.\")\n231\t    sp.add_argument(\"--by-wave\", action=\"store_true\",\n232\t                    help=\"Include per-wave aggregates.\")\n233\t    sp.add_argument(\"--json\", action=\"store_true\",\n234\t                    help=\"Emit JSON (default: human table).\")\n235\t    sp.add_argument(\"--validate-memory-claim\", action=\"store_true\",\n236\t                    help=\"Cross-check rollup against CLAUDE.md memory claim band.\")\n237\t    sp.add_argument(\"--audit-dir\", metavar=\"PATH\", default=None,\n238\t                    help=\"Override audit-log directory.\")\n239\t    # PLAN-133 C4 — default-OFF harbor-style benchmark co-report.\n240\t    sp.add_argument(\"--benchmarks\", action=\"store_true\",\n241\t                    help=(\n242\t                        \"Append a harbor-style benchmark co-report \"\n243\t                        \"(cost + compute + turns alongside pass-rate per \"\n244\t                        \"skill). Default-OFF; also enabled by \"\n245\t                        \"CEO_BUDGET_BENCHMARKS=1 (PLAN-133 C4).\"\n246\t                    ))\n247\t    # PLAN-178 W1.2 — default-OFF native-source cross-check.\n248\t    sp.add_argument(\"--native\", action=\"store_true\",\n249\t                    help=(\n250\t                        \"Append the native-source cross-check: audit-log \"\n251\t                        \"agent_spawn ledger joined against the harness \"\n252\t                        \"transcript corpus under ~/.claude/projects/\"\n253\t                        \"<cwd-slug>/. Cross-check, not authority-swap; \"\n254\t                        \"UNMATCHED residue on both sides is always shown. \"\n255\t                        \"Default-OFF; also enabled by CEO_BUDGET_NATIVE=1 \"\n256\t                        \"(PLAN-178 W1.2).\"\n257\t                    ))\n258\t    sp.add_argument(\"--native-root\", metavar=\"PATH\", default=None,\n259\t                    help=(\n260\t                        \"Override the native transcript root (default: \"\n261\t                        \"~/.claude/projects/<cwd-slug>; env override \"\n262\t                        \"CEO_NATIVE_USAGE_DIR).\"\n263\t                    ))\n264\t    # PLAN-186 W0 (AC-1b) — the two-source surface.\n265\t    sp.add_argument(\"--source\", choices=SOURCE_CHOICES, default=\"both\",\n266\t                    help=(\n267\t                        \"Which ledger to report. 'transcripts' = \"\n268\t                        \"harness-native message.usage (PRIMARY, \"\n269\t                        \"cache-aware); 'audit' = the governance audit \"\n270\t                        \"log (SECONDARY, byte-identical to the \"\n271\t                        \"pre-PLAN-186 output); 'both' (default) prints \"\n272\t                        \"them labelled, side by side.\"\n273\t                    ))\n274\t    sp.add_argument(\"--transcripts-root\", metavar=\"PATH\", default=None,\n275\t                    help=(\n276\t                        \"Transcripts corpus root. Default: $%s, else the \"\n277\t                        \"shared _lib.runtime_paths resolver. Distinct \"\n278\t                        \"from --native-root, which feeds the older \"\n279\t                        \"--native cross-check.\" % ROOT_ENV\n280\t                    ))\n281\t    return p\n282\t\n283\t\n284\tdef main(argv: Optional[List[str]] = None) -> int:\n285\t    parser = build_parser()\n286\t    try:\n287\t        args = parser.parse_args(argv)\n288\t    except SystemExit as e:\n289\t        return int(e.code) if isinstance(e.code, int) else 2\n290\t\n291\t    if args.subcommand is None:\n292\t        # Default to \"summary\" when invoked bare.\n293\t        args.subcommand = \"summary\"\n294\t        args.since = None\n295\t        args.plan_id = None\n296\t        args.by_wave = False\n297\t        args.json = False\n298\t        args.validate_memory_claim = False\n299\t        args.audit_dir = None\n300\t        args.benchmarks = False\n301\t        args.native = False\n302\t        args.native_root = None\n303\t        args.source = \"both\"\n304\t        args.transcripts_root = None\n305\t\n306\t    if args.subcommand != \"summary\":\n307\t        sys.stderr.write(f\"budget-summary: unknown subcommand {args.subcommand!r}\\n\")\n308\t        return 2\n309\t\n310\t    since_delta: Optional[timedelta] = None\n311\t    if args.since:\n312\t        try:\n313\t            since_delta = parse_since(args.since)\n314\t        except ValueError as e:\n315\t            sys.stderr.write(f\"budget-summary: {e}\\n\")\n316\t            return 2\n317\t\n318\t    if args.plan_id and not _PLAN_ID_RE.match(args.plan_id):\n319\t        sys.stderr.write(\n320\t            f\"budget-summary: --plan-id must look like PLAN-NNN \"\n321\t            f\"(got {args.plan_id!r})\\n\"\n322\t        )\n323\t        return 2\n324\t\n325\t    audit_dir = Path(args.audit_dir) if args.audit_dir else None\n326\t\n327\t    # Rail r3 P2-1: ONE wall clock for both ledgers. `rollup()` captures\n328\t    # its own `now` internally; taking a second one after it returns let\n329\t    # a record land inside the audit window and outside the transcripts\n330\t    # window while both blocks printed the same `--since`.\n331\t    _now = datetime.now(timezone.utc)\n332\t\n333\t    # PLAN-186 W0 (AC-1b): the PRIMARY source. `--source audit` adds NO\n334\t    # key to `data`, which is what keeps that rendering byte-identical.\n335\t    source = getattr(args, \"source\", \"audit\")\n336\t    # Rail r1 P1-2: the transcript corpus carries NO plan field (the same\n337\t    # limitation the --native cross-check hit in S306). A project-wide\n338\t    # transcripts total printed as PRIMARY beside a plan-scoped audit\n339\t    # block is the wrong number for the plan that was asked about. Under\n340\t    # --plan-id it is suppressed; an EXPLICIT --source transcripts there\n341\t    # is a named refusal, never a silently unscoped answer.\n342\t    if source != \"audit\" and getattr(args, \"plan_id\", None):\n343\t        if source == \"transcripts\":\n344\t            sys.stderr.write(\n345\t                \"budget-summary: --source transcripts cannot be scoped \"\n346\t                \"by --plan-id (the transcript corpus has no plan \"\n347\t                \"field); drop one of the two flags\\n\"\n348\t            )\n349\t            return 2\n350\t        sys.stderr.write(\n351\t            \"budget-summary: transcripts source suppressed under \"\n352\t            \"--plan-id (the transcript corpus has no plan field; run \"\n353\t            \"without --plan-id to see it)\\n\"\n354\t        )\n355\t        source = \"audit\"\n356\t    # Rail r2 P2-2: --validate-memory-claim compares the AUDIT total\n357\t    # against CLAUDE.md's claim band; under --source transcripts there is\n358\t    # no audit total to validate, and returning 'unknown' would look like\n359\t    # a verdict. Named refusal instead.\n360\t    if source == \"transcripts\" and getattr(\n361\t        args, \"validate_memory_claim\", False\n362\t    ):\n363\t        sys.stderr.write(\n364\t            \"budget-summary: --validate-memory-claim validates the AUDIT \"\n365\t            \"total and cannot run under --source transcripts; use \"\n366\t            \"--source both or audit\\n\"\n367\t        )\n368\t        return 2\n369\t    if source == \"transcripts\":\n370\t        # Rail S341 (A): --by-wave shapes the AUDIT rollup (wave_hint\n371\t        # on agent_spawn rows). With rollup() skipped there is no block\n372\t        # to shape, so the flag is DROPPED -- named on stderr, never\n373\t        # silently swallowed, exactly like the two co-reports below.\n374\t        if getattr(args, \"by_wave\", False):\n375\t            sys.stderr.write(\n376\t                \"budget-summary: --by-wave shapes the AUDIT rollup and \"\n377\t                \"is dropped under --source transcripts (the transcript \"\n378\t                \"corpus has no wave field); use --source both or \"\n379\t                \"audit\\n\"\n380\t            )\n381\t        data: Dict[str, Any] = {\"since\": args.since}\n382\t    else:\n383\t        data = rollup(\n384\t            audit_dir=audit_dir,\n385\t            plan_filter=args.plan_id,\n386\t            since=since_delta,\n387\t            by_wave=args.by_wave,\n388\t            # Rail S341 r1 [P2]: capturing `_now` and letting rollup()\n389\t            # take its own clock delivers HALF of D10 -- a record on the\n390\t            # window boundary could still land inside one ledger and\n391\t            # outside the other while both blocks print the same --since.\n392\t            now=_now,\n393\t        )\n394\t        data[\"since\"] = args.since\n395\t    if source != \"audit\":\n396\t        data[\"source\"] = source\n397\t        data[\"transcripts\"] = collect_transcripts(\n398\t            root_arg=getattr(args, \"transcripts_root\", None),\n399\t            cutoff=(\n400\t                _now - since_delta if since_delta is not None else None\n401\t            ),\n402\t            audit_override=(\n403\t                source == \"both\"\n404\t                and _tx_audit_pinned(\n405\t                    str(audit_dir) if audit_dir is not None else None\n406\t                )\n407\t            ),\n408\t        )\n409\t\n410\t    # PLAN-133 C4 — default-OFF benchmark co-report. Enabled by --benchmarks\n411\t    # or CEO_BUDGET_BENCHMARKS=1. When OFF, output is byte-for-byte unchanged.\n412\t    benchmarks_on = bool(getattr(args, \"benchmarks\", False)) or (\n413\t        os.environ.get(\"CEO_BUDGET_BENCHMARKS\", \"\") == \"1\"\n414\t    )\n415\t    # Both co-reports are AUDIT-side; under --source transcripts there is\n416\t    # no audit rollup to append them to. Rail S341 (A): a REQUESTED\n417\t    # block that vanishes with rc 0 and an empty stderr is the shape\n418\t    # this pack removed everywhere else -- so it is dropped by NAME,\n419\t    # mirroring the CEO_NATIVE_COST_DISABLE / --plan-id lines below.\n420\t    if source == \"transcripts\":\n421\t        if benchmarks_on:\n422\t            sys.stderr.write(\n423\t                \"budget-summary: --benchmarks is an AUDIT-side \"\n424\t                \"co-report and is dropped under --source transcripts; \"\n425\t                \"use --source both or audit\\n\"\n426\t            )\n427\t        benchmarks_on = False\n428\t    if benchmarks_on:\n429\t        data[\"benchmarks\"] = benchmark_rollup(\n430\t            audit_dir=audit_dir,\n431\t            since=since_delta,\n432\t        )\n433\t\n434\t    # PLAN-178 W1.2 — default-OFF native cross-check. Enabled by --native or\n435\t    # CEO_BUDGET_NATIVE=1. When OFF, output is byte-for-byte unchanged (and\n436\t    # a dormant corpus degrades to a one-line dormant note, never a crash).\n437\t    # Note: the cross-check is session-scoped; --plan-id does NOT filter it\n438\t    # (the native corpus carries no plan_id field — probe §handoff item 6).\n439\t    native_on = bool(getattr(args, \"native\", False)) or (\n440\t        os.environ.get(\"CEO_BUDGET_NATIVE\", \"\") == \"1\"\n441\t    )\n442\t    if source == \"transcripts\":\n443\t        if native_on:\n444\t            sys.stderr.write(\n445\t                \"budget-summary: --native is an AUDIT-side cross-check \"\n446\t                \"and is dropped under --source transcripts; use \"\n447\t                \"--source both or audit\\n\"\n448\t            )\n449\t        native_on = False\n450\t    # Kill-switch (W1.2-5b, env-inventory.json): dominates the opt-in.\n451\t    if native_on and os.environ.get(\"CEO_NATIVE_COST_DISABLE\", \"\") == \"1\":\n452\t        native_on = False\n453\t        sys.stderr.write(\n454\t            \"budget-summary: native cross-check disabled by \"\n455\t            \"CEO_NATIVE_COST_DISABLE=1\\n\"\n456\t        )\n457\t    # codex S306 P2 cure: the native source carries no plan field (probe\n458\t    # §handoff item 6), so under --plan-id an unscoped cross-check would put\n459\t    # every plan's native activity inside a plan-scoped report. Suppress it.\n460\t    if native_on and getattr(args, \"plan_id\", None):\n461\t        native_on = False\n462\t        sys.stderr.write(\n463\t            \"budget-summary: native cross-check suppressed under --plan-id \"\n464\t            \"(native source has no plan field; run without --plan-id to \"\n465\t            \"see it)\\n\"\n466\t        )\n467\t    if native_on:\n468\t        native_root = (\n469\t            Path(args.native_root)\n470\t            if getattr(args, \"native_root\", None)\n471\t            else None\n472\t        )\n473\t        data[\"native_cross_check\"] = native_cross_check(\n474\t            audit_dir=audit_dir,\n475\t            native_root=native_root,\n476\t            since=since_delta,\n477\t        )\n478\t\n479\t    memory_claim: Optional[Dict[str, Any]] = None\n480\t    if args.validate_memory_claim:\n481\t        memory_claim = validate_memory_claim(data.get(\"total_cost_usd\"))\n482\t\n483\t    if args.json:\n484\t        print(format_json(data, memory_claim))\n485\t    else:\n486\t        print(format_human(data, memory_claim))\n487\t    return 0\n488\t\n489\t\n490\t\n491\t"}]},"parent_tool_use_id":null,"session_id":"554a7565-eb62-4598-9760-aeebd94af377","uuid":"3cb202e4-4b92-4424-b658-3aa9b65cc5d6","timestamp":"2026-11-16T19:39:08.470Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_budget_summary_parts/presentation_cli.py","content":"from __future__ import annotations\n\ndef load_transcripts_instrument():\n    \"\"\"Import `ceo-cost-transcripts.py` from next to this file, or None.\n\n    Fail-soft by construction: an unimportable instrument degrades the\n    primary source to a labelled note, it never breaks the audit rollup.\n    \"\"\"\n    cached = sys.modules.get(_TRANSCRIPTS_MODULE_NAME)\n    if cached is not None:\n        return cached\n    src = Path(__file__).resolve().parent / _TRANSCRIPTS_FILENAME\n    if not src.is_file():\n        return None\n    try:\n        spec = importlib.util.spec_from_file_location(\n            _TRANSCRIPTS_MODULE_NAME, src\n        )\n        if spec is None or spec.loader is None:\n            return None\n        mod = importlib.util.module_from_spec(spec)\n        # Registered BEFORE exec_module: with `from __future__ import\n        # annotations`, @dataclass resolves sys.modules[cls.__module__] at\n        # class-definition time and blows up on a missing entry.\n        sys.modules[_TRANSCRIPTS_MODULE_NAME] = mod\n        spec.loader.exec_module(mod)\n        return mod\n    except Exception:\n        sys.modules.pop(_TRANSCRIPTS_MODULE_NAME, None)\n        return None\n\n\ndef transcripts_root(root_arg: Optional[str] = None) -> Optional[Path]:\n    \"\"\"Resolve the transcripts corpus root (flag > env > shared resolver).\"\"\"\n    mod = load_transcripts_instrument()\n    if mod is None:\n        return Path(root_arg) if root_arg else None\n    return mod.resolve_root(root_arg)\n\n\ndef _tx_audit_pinned(path_arg: Optional[str] = None) -> bool:\n    \"\"\"True when the SECONDARY (audit) ledger was pointed at a specific\n    place — by flag or by CEO_AUDIT_LOG_PATH / CEO_AUDIT_LOG_DIR. Rail r3\n    P1-1: a flag is not the only carrier, and the cross-project pairing only\n    EXISTS when both ledgers are on screen.\n    \"\"\"\n    mod = load_transcripts_instrument()\n    if mod is None:\n        return bool(path_arg)\n    return mod.audit_source_is_pinned(\n        path_arg, carriers=_AUDIT_ENV_CARRIERS\n    )\n\n\ndef collect_transcripts(\n    root_arg: Optional[str] = None,\n    cutoff: Optional[datetime] = None,\n    audit_override: bool = False,\n) -> Dict[str, Any]:\n    \"\"\"Primary-source rollup, or a `{\"available\": False, \"reason\": ...}` note.\n\n    `budget-summary` has no `--by` flag, so the breakdown dimension is fixed\n    to `model` — the same dimension its audit-side `per_plan` table is most\n    comparable against. `audit_override` says `--audit-dir` pointed the\n    SECONDARY source at an explicit path; with no explicit transcripts root\n    that pairing crosses projects and is refused by name (rail r2 P1-1).\n    \"\"\"\n    mod = load_transcripts_instrument()\n    if mod is None:\n        return {\n            \"available\": False,\n            \"reason\": \"instrument ceo-cost-transcripts.py is not importable\",\n        }\n    return mod.collect(\n        root_arg=root_arg,\n        cutoff=cutoff,\n        by=\"model\",\n        audit_override=audit_override,\n    )\n\n\ndef format_human(data: Dict[str, Any], memory_claim: Optional[Dict[str, Any]] = None) -> str:\n    \"\"\"Render the rollup as a human-readable text block.\n\n    PLAN-186 W0 (AC-1b): when `data` carries a `source` key the PRIMARY\n    transcripts block is rendered first, labelled; `source == 'audit'`\n    sets NO key at all, so that rendering is byte-identical to the\n    pre-integration one.\n    \"\"\"\n    lines: List[str] = []\n    source = data.get(\"source\")\n    if source is not None:\n        mod = load_transcripts_instrument()\n        if mod is None:\n            lines.append(\n                \"transcripts source UNAVAILABLE: instrument \"\n                \"ceo-cost-transcripts.py is not importable\"\n            )\n        else:\n            lines.extend(mod.render_block(data.get(\"transcripts\")))\n        lines.append(\"\")\n        if source == \"transcripts\":\n            return \"\\n\".join(lines)\n        lines.append(AUDIT_BANNER)\n        lines.append(\"\")\n    scope = data.get(\"plan_filter\") or \"(all plans)\"\n    since = data.get(\"since\") or \"(all time)\"\n    lines.append(f\"FinOps summary — scope={scope} since={since}\")\n    lines.append(\"-\" * 70)\n    lines.append(f\"Audit dir       : {data.get('audit_dir')}\")\n    files = data.get(\"log_files_read\") or []\n    lines.append(f\"Logs read       : {len(files)} file(s)\")\n    for f in files:\n        lines.append(f\"                  - {f}\")\n    lines.append(f\"Events          : {data['total_events']:>14,}\")\n    lines.append(f\"Codex events    : {data['codex_event_count']:>14,}\")\n    lines.append(f\"Unknown plan_id : {data['unknown_plan_count']:>14,}\")\n    lines.append(f\"Tokens in       : {_fmt_tokens(data['total_tokens_in'])}\")\n    lines.append(f\"Tokens out      : {_fmt_tokens(data['total_tokens_out'])}\")\n    lines.append(f\"Tokens total    : {_fmt_tokens(data['total_tokens'])}\")\n    cost = data.get(\"total_cost_usd\")\n    src = data.get(\"cost_source\") or \"unknown\"\n    if cost is None:\n        lines.append(f\"Cost (USD)      : -              (source={src})\")\n    else:\n        lines.append(f\"Cost (USD)      : ${cost:>13,.4f} (source={src})\")\n\n    per_plan = data.get(\"per_plan\") or []\n    if per_plan and not data.get(\"plan_filter\"):\n        lines.append(\"\")\n        lines.append(\"Per plan:\")\n        lines.append(\n            f\"  {'plan_id':<14}  {'events':>7}  {'tokens_total':>14}  \"\n            f\"{'cost_usd':>12}\"\n        )\n        for row in per_plan:\n            cost_col = (\n                f\"${row['cost_usd']:.4f}\" if row.get(\"cost_known\") else \"-\"\n            )\n            lines.append(\n                f\"  {row['plan_id']:<14}  {row['event_count']:>7,}  \"\n                f\"{row['tokens_total']:>14,}  {cost_col:>12}\"\n            )\n\n    per_wave = data.get(\"per_wave\")\n    if per_wave:\n        lines.append(\"\")\n        lines.append(\"Per wave:\")\n        lines.append(\n            f\"  {'wave':<14}  {'events':>7}  {'tokens_total':>14}  \"\n            f\"{'cost_usd':>12}\"\n        )\n        for row in per_wave:\n            cost_col = f\"${row['cost_usd']:.4f}\" if row['cost_usd'] else \"-\"\n            lines.append(\n                f\"  {row['wave']:<14}  {row['event_count']:>7,}  \"\n                f\"{row['tokens_total']:>14,}  {cost_col:>12}\"\n            )\n\n    # PLAN-133 C4 — harbor-style benchmark co-report (only when --benchmarks).\n    benchmarks = data.get(\"benchmarks\")\n    if benchmarks is not None:\n        rows = benchmarks.get(\"per_skill\") or []\n        lines.append(\"\")\n        lines.append(\"Benchmarks (harbor-style — pass-rate never read alone):\")\n        if not rows:\n            lines.append(\"  (no benchmark_run events in scope)\")\n        else:\n            lines.append(\n                f\"  {'skill':<24}  {'runs':>4}  {'pass_rate':>9}  \"\n                f\"{'cost_usd':>10}  {'compute_s':>10}  {'turns':>7}\"\n            )\n            for row in rows:\n                lines.append(\n                    f\"  {str(row['skill'])[:24]:<24}  {row['runs']:>4}  \"\n                    f\"{row['latest_pass_rate']:>9.3f}  \"\n                    f\"${row['total_cost_usd']:>9.4f}  \"\n                    f\"{row['total_compute_s']:>10.1f}  \"\n                    f\"{row['total_turns']:>7,}\"\n                )\n            lines.append(\n                f\"  {'TOTAL':<24}  {'':>4}  {'':>9}  \"\n                f\"${benchmarks['total_cost_usd']:>9.4f}  \"\n                f\"{benchmarks['total_compute_s']:>10.1f}  \"\n                f\"{benchmarks['total_turns']:>7,}\"\n            )\n\n    # PLAN-178 W1.2 — native cross-check (only when --native / env opt-in).\n    native = data.get(\"native_cross_check\")\n    if native is not None:\n        lines.extend(_format_native_block(native))\n\n    if memory_claim is not None:\n        lines.append(\"\")\n        lines.append(\"Memory-claim validation:\")\n        lines.append(f\"  status  : {memory_claim['status']}\")\n        lines.append(f\"  message : {memory_claim['message']}\")\n        # Rail r2 P2-2: say WHICH ledger the verdict is about. Only when\n        # a second ledger is on screen — audit-only output is unchanged.\n        if data.get(\"source\") is not None:\n            lines.append(\n                \"  scope   : validates the AUDIT total (SECONDARY); the \"\n                \"transcripts total above is the PRIMARY figure\"\n            )\n\n    return \"\\n\".join(lines)\n\n\ndef format_json(data: Dict[str, Any], memory_claim: Optional[Dict[str, Any]] = None) -> str:\n    payload = dict(data)\n    if memory_claim is not None:\n        payload[\"memory_claim_validation\"] = memory_claim\n    return json.dumps(payload, indent=2, sort_keys=True)\n\n\ndef build_parser() -> argparse.ArgumentParser:\n    p = argparse.ArgumentParser(\n        prog=\"budget-summary\",\n        description=(\n            \"FinOps rollup across all audit-log rotations \"\n            \"(PLAN-083 Wave 0b sub-0.8).\"\n        ),\n    )\n    sub = p.add_subparsers(dest=\"subcommand\")\n\n    sp = sub.add_parser(\"summary\", help=\"Print cumulative summary.\")\n    sp.add_argument(\"--since\", metavar=\"EXPR\", default=None,\n                    help=\"Time window (Nm/Nh/Nd, e.g. 30d).\")\n    sp.add_argument(\"--plan-id\", metavar=\"PLAN-NNN\", default=None,\n                    help=\"Limit rollup to a single plan_id.\")\n    sp.add_argument(\"--by-wave\", action=\"store_true\",\n                    help=\"Include per-wave aggregates.\")\n    sp.add_argument(\"--json\", action=\"store_true\",\n                    help=\"Emit JSON (default: human table).\")\n    sp.add_argument(\"--validate-memory-claim\", action=\"store_true\",\n                    help=\"Cross-check rollup against CLAUDE.md memory claim band.\")\n    sp.add_argument(\"--audit-dir\", metavar=\"PATH\", default=None,\n                    help=\"Override audit-log directory.\")\n    # PLAN-133 C4 — default-OFF harbor-style benchmark co-report.\n    sp.add_argument(\"--benchmarks\", action=\"store_true\",\n                    help=(\n                        \"Append a harbor-style benchmark co-report \"\n                        \"(cost + compute + turns alongside pass-rate per \"\n                        \"skill). Default-OFF; also enabled by \"\n                        \"CEO_BUDGET_BENCHMARKS=1 (PLAN-133 C4).\"\n                    ))\n    # PLAN-178 W1.2 — default-OFF native-source cross-check.\n    sp.add_argument(\"--native\", action=\"store_true\",\n                    help=(\n                        \"Append the native-source cross-check: audit-log \"\n                        \"agent_spawn ledger joined against the harness \"\n                        \"transcript corpus under ~/.claude/projects/\"\n                        \"<cwd-slug>/. Cross-check, not authority-swap; \"\n                        \"UNMATCHED residue on both sides is always shown. \"\n                        \"Default-OFF; also enabled by CEO_BUDGET_NATIVE=1 \"\n                        \"(PLAN-178 W1.2).\"\n                    ))\n    sp.add_argument(\"--native-root\", metavar=\"PATH\", default=None,\n                    help=(\n                        \"Override the native transcript root (default: \"\n                        \"~/.claude/projects/<cwd-slug>; env override \"\n                        \"CEO_NATIVE_USAGE_DIR).\"\n                    ))\n    # PLAN-186 W0 (AC-1b) — the two-source surface.\n    sp.add_argument(\"--source\", choices=SOURCE_CHOICES, default=\"both\",\n                    help=(\n                        \"Which ledger to report. 'transcripts' = \"\n                        \"harness-native message.usage (PRIMARY, \"\n                        \"cache-aware); 'audit' = the governance audit \"\n                        \"log (SECONDARY, byte-identical to the \"\n                        \"pre-PLAN-186 output); 'both' (default) prints \"\n                        \"them labelled, side by side.\"\n                    ))\n    sp.add_argument(\"--transcripts-root\", metavar=\"PATH\", default=None,\n                    help=(\n                        \"Transcripts corpus root. Default: $%s, else the \"\n                        \"shared _lib.runtime_paths resolver. Distinct \"\n                        \"from --native-root, which feeds the older \"\n                        \"--native cross-check.\" % ROOT_ENV\n                    ))\n    return p\n\n\ndef main(argv: Optional[List[str]] = None) -> int:\n    parser = build_parser()\n    try:\n        args = parser.parse_args(argv)\n    except SystemExit as e:\n        return int(e.code) if isinstance(e.code, int) else 2\n\n    if args.subcommand is None:\n        # Default to \"summary\" when invoked bare.\n        args.subcommand = \"summary\"\n        args.since = None\n        args.plan_id = None\n        args.by_wave = False\n        args.json = False\n        args.validate_memory_claim = False\n        args.audit_dir = None\n        args.benchmarks = False\n        args.native = False\n        args.native_root = None\n        args.source = \"both\"\n        args.transcripts_root = None\n\n    if args.subcommand != \"summary\":\n        sys.stderr.write(f\"budget-summary: unknown subcommand {args.subcommand!r}\\n\")\n        return 2\n\n    since_delta: Optional[timedelta] = None\n    if args.since:\n        try:\n            since_delta = parse_since(args.since)\n        except ValueError as e:\n            sys.stderr.write(f\"budget-summary: {e}\\n\")\n            return 2\n\n    if args.plan_id and not _PLAN_ID_RE.match(args.plan_id):\n        sys.stderr.write(\n            f\"budget-summary: --plan-id must look like PLAN-NNN \"\n            f\"(got {args.plan_id!r})\\n\"\n        )\n        return 2\n\n    audit_dir = Path(args.audit_dir) if args.audit_dir else None\n\n    # Rail r3 P2-1: ONE wall clock for both ledgers. `rollup()` captures\n    # its own `now` internally; taking a second one after it returns let\n    # a record land inside the audit window and outside the transcripts\n    # window while both blocks printed the same `--since`.\n    _now = datetime.now(timezone.utc)\n\n    # PLAN-186 W0 (AC-1b): the PRIMARY source. `--source audit` adds NO\n    # key to `data`, which is what keeps that rendering byte-identical.\n    source = getattr(args, \"source\", \"audit\")\n    # Rail r1 P1-2: the transcript corpus carries NO plan field (the same\n    # limitation the --native cross-check hit in S306). A project-wide\n    # transcripts total printed as PRIMARY beside a plan-scoped audit\n    # block is the wrong number for the plan that was asked about. Under\n    # --plan-id it is suppressed; an EXPLICIT --source transcripts there\n    # is a named refusal, never a silently unscoped answer.\n    if source != \"audit\" and getattr(args, \"plan_id\", None):\n        if source == \"transcripts\":\n            sys.stderr.write(\n                \"budget-summary: --source transcripts cannot be scoped \"\n                \"by --plan-id (the transcript corpus has no plan \"\n                \"field); drop one of the two flags\\n\"\n            )\n            return 2\n        sys.stderr.write(\n            \"budget-summary: transcripts source suppressed under \"\n            \"--plan-id (the transcript corpus has no plan field; run \"\n            \"without --plan-id to see it)\\n\"\n        )\n        source = \"audit\"\n    # Rail r2 P2-2: --validate-memory-claim compares the AUDIT total\n    # against CLAUDE.md's claim band; under --source transcripts there is\n    # no audit total to validate, and returning 'unknown' would look like\n    # a verdict. Named refusal instead.\n    if source == \"transcripts\" and getattr(\n        args, \"validate_memory_claim\", False\n    ):\n        sys.stderr.write(\n            \"budget-summary: --validate-memory-claim validates the AUDIT \"\n            \"total and cannot run under --source transcripts; use \"\n            \"--source both or audit\\n\"\n        )\n        return 2\n    if source == \"transcripts\":\n        # Rail S341 (A): --by-wave shapes the AUDIT rollup (wave_hint\n        # on agent_spawn rows). With rollup() skipped there is no block\n        # to shape, so the flag is DROPPED -- named on stderr, never\n        # silently swallowed, exactly like the two co-reports below.\n        if getattr(args, \"by_wave\", False):\n            sys.stderr.write(\n                \"budget-summary: --by-wave shapes the AUDIT rollup and \"\n                \"is dropped under --source transcripts (the transcript \"\n                \"corpus has no wave field); use --source both or \"\n                \"audit\\n\"\n            )\n        data: Dict[str, Any] = {\"since\": args.since}\n    else:\n        data = rollup(\n            audit_dir=audit_dir,\n            plan_filter=args.plan_id,\n            since=since_delta,\n            by_wave=args.by_wave,\n            # Rail S341 r1 [P2]: capturing `_now` and letting rollup()\n            # take its own clock delivers HALF of D10 -- a record on the\n            # window boundary could still land inside one ledger and\n            # outside the other while both blocks print the same --since.\n            now=_now,\n        )\n        data[\"since\"] = args.since\n    if source != \"audit\":\n        data[\"source\"] = source\n        data[\"transcripts\"] = collect_transcripts(\n            root_arg=getattr(args, \"transcripts_root\", None),\n            cutoff=(\n                _now - since_delta if since_delta is not None else None\n            ),\n            audit_override=(\n                source == \"both\"\n                and _tx_audit_pinned(\n                    str(audit_dir) if audit_dir is not None else None\n                )\n            ),\n        )\n\n    # PLAN-133 C4 — default-OFF benchmark co-report. Enabled by --benchmarks\n    # or CEO_BUDGET_BENCHMARKS=1. When OFF, output is byte-for-byte unchanged.\n    benchmarks_on = bool(getattr(args, \"benchmarks\", False)) or (\n        os.environ.get(\"CEO_BUDGET_BENCHMARKS\", \"\") == \"1\"\n    )\n    # Both co-reports are AUDIT-side; under --source transcripts there is\n    # no audit rollup to append them to. Rail S341 (A): a REQUESTED\n    # block that vanishes with rc 0 and an empty stderr is the shape\n    # this pack removed everywhere else -- so it is dropped by NAME,\n    # mirroring the CEO_NATIVE_COST_DISABLE / --plan-id lines below.\n    if source == \"transcripts\":\n        if benchmarks_on:\n            sys.stderr.write(\n                \"budget-summary: --benchmarks is an AUDIT-side \"\n                \"co-report and is dropped under --source transcripts; \"\n                \"use --source both or audit\\n\"\n            )\n        benchmarks_on = False\n    if benchmarks_on:\n        data[\"benchmarks\"] = benchmark_rollup(\n            audit_dir=audit_dir,\n            since=since_delta,\n        )\n\n    # PLAN-178 W1.2 — default-OFF native cross-check. Enabled by --native or\n    # CEO_BUDGET_NATIVE=1. When OFF, output is byte-for-byte unchanged (and\n    # a dormant corpus degrades to a one-line dormant note, never a crash).\n    # Note: the cross-check is session-scoped; --plan-id does NOT filter it\n    # (the native corpus carries no plan_id field — probe §handoff item 6).\n    native_on = bool(getattr(args, \"native\", False)) or (\n        os.environ.get(\"CEO_BUDGET_NATIVE\", \"\") == \"1\"\n    )\n    if source == \"transcripts\":\n        if native_on:\n            sys.stderr.write(\n                \"budget-summary: --native is an AUDIT-side cross-check \"\n                \"and is dropped under --source transcripts; use \"\n                \"--source both or audit\\n\"\n            )\n        native_on = False\n    # Kill-switch (W1.2-5b, env-inventory.json): dominates the opt-in.\n    if native_on and os.environ.get(\"CEO_NATIVE_COST_DISABLE\", \"\") == \"1\":\n        native_on = False\n        sys.stderr.write(\n            \"budget-summary: native cross-check disabled by \"\n            \"CEO_NATIVE_COST_DISABLE=1\\n\"\n        )\n    # codex S306 P2 cure: the native source carries no plan field (probe\n    # §handoff item 6), so under --plan-id an unscoped cross-check would put\n    # every plan's native activity inside a plan-scoped report. Suppress it.\n    if native_on and getattr(args, \"plan_id\", None):\n        native_on = False\n        sys.stderr.write(\n            \"budget-summary: native cross-check suppressed under --plan-id \"\n            \"(native source has no plan field; run without --plan-id to \"\n            \"see it)\\n\"\n        )\n    if native_on:\n        native_root = (\n            Path(args.native_root)\n            if getattr(args, \"native_root\", None)\n            else None\n        )\n        data[\"native_cross_check\"] = native_cross_check(\n            audit_dir=audit_dir,\n            native_root=native_root,\n            since=since_delta,\n        )\n\n    memory_claim: Optional[Dict[str, Any]] = None\n    if args.validate_memory_claim:\n        memory_claim = validate_memory_claim(data.get(\"total_cost_usd\"))\n\n    if args.json:\n        print(format_json(data, memory_claim))\n    else:\n        print(format_human(data, memory_claim))\n    return 0\n\n\n\n","numLines":491,"startLine":1,"totalLines":491}},"tool_result_meta":[{"id":"toolu_014stM2cjwKvxsk9UQ3xdvGi","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
