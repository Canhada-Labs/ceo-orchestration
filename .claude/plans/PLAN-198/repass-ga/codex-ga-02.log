+        event["enforced"] = (
+            1 if str(event.get("enforced")) in ("1", "True", "true") else 0
+        )
+        if dropped:
+            _breadcrumb(
+                f"emit_generic spawn_prompt_defense_gate dropped forbidden field(s): {sorted(dropped)[:10]}"
+            )
+        state["event"] = event
+        return True
+
+    if action == "spec_context_sanitized":
