+        raw_event, _DIRECTORY_ADDED_RECORDED_ALLOWLIST
+    )
+    _write_event(cleaned)
+    if dropped:  # pragma: no cover — impossible from the typed wrapper
+        _breadcrumb(
+            f"directory_added_recorded dropped forbidden field(s): "
+            f"{sorted(dropped)[:10]}"
+        )
+
