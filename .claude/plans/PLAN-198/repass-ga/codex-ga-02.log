def _emit_fallback_banner_once(primary: Path, fallback: Path, err: str) -> None:
    """Emit `::warning::` stderr banner once per session (F-CHAOS-1)."""
    global _FALLBACK_NOTIFIED
    if _FALLBACK_NOTIFIED:
        return
    _FALLBACK_NOTIFIED = True
    try:
        sys.stderr.write(
