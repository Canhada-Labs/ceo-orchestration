    98	def scan_rule_one(
    99	    repo_root: Path,
   100	    pattern: Pattern[str],
   101	    allowlisted: Callable[[Path], bool],
   102	    never_allowlisted: Callable[[str], bool],
   103	    walked: Iterable[Path],
   104	    observed_modes: Mapping[str, str],
   105	) -> List[Path]:
   106	    """Scan tracked Rule 1 blobs, with gitlinks as the sole mode exemption."""
   107	    entries = _index(repo_root)
   108	    modes = {raw_name.decode("utf-8"): mode for mode, raw_name in entries}
   109	    if modes != observed_modes:
   110	        raise RuleOneInputError("tracked index snapshots differ; the term scan has no verdict")
   111	    seen = set()
   112	    for path in walked:
   113	        try:
   114	            name = path.relative_to(repo_root).as_posix()
   115	        except ValueError:
   116	            name = path.as_posix()
   117	        if name not in modes:
   118	            raise RuleOneInputError("walked path absent from the tracked index")
   119	        seen.add(name)
   120	    if seen != set(modes):
   121	        raise RuleOneInputError("walk did not cover all tracked index entries")
   122	    violations = []
   123	    for mode, raw_name in entries:
   124	        name = raw_name.decode("utf-8")
   125	        if mode == _GITLINK_MODE:
   126	            continue
   127	        if mode not in _BLOB_MODES:
   128	            raise RuleOneInputError(
   129	                "tracked Rule 1 entry has an unsupported mode")
   130	        path = repo_root / name
   131	        if allowlisted(path) and not never_allowlisted(name):
   132	            continue
   133	        raw = _blob(path, mode)
   134	        if raw is None:
   135	            continue
   136	        try:
   137	            text = raw.decode("utf-8")
   138	        except UnicodeDecodeError:
   139	            if never_allowlisted(name):
   140	                violations.append(path)
   141	            continue
   142	        if pattern.search(unicodedata.normalize("NFKC", text)):
   143	            violations.append(path)
