    68	        self.skip_subdir_names = skip_subdir_names or set()
    69	        self.path_allowlist_exact = path_allowlist_exact or set()
    70	        self.path_allowlist_globs = path_allowlist_globs or set()
    71	        self.path_allowlist_tokens = path_allowlist_tokens or set()
