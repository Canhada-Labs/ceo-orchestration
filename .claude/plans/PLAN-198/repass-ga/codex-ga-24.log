    98	def personal_path_hit_lines(
    99	    text: str, deadline: Optional[float] = None,
   100	) -> Tuple[int, ...]:
   101	    """1-based line numbers of every hit line in ``text``.
   102	
   103	    Returns NUMBERS, never content: the caller — including a CLI whose output
   104	    lands in a public CI log — is left with nothing quotable.
   105	
   106	    `split("\\n")`, NOT `splitlines()`: the report is `file:line`, and a human
   107	    resolves that with `sed -n '<N>p'` or `grep -n`, both of which count
   108	    `\\n`. `splitlines()` ALSO breaks on `\\v`, `\\f`, `\\x1c`-`\\x1e`, U+2028
   109	    and U+2029 — one vertical tab in a frozen transcript would shift every
   110	    line number after it, and a finding that points at the wrong line is a
   111	    finding a reviewer cannot check. NFKC therefore runs PER LINE, after the
   112	    split, so normalisation cannot move the boundaries either.
   113	
   114	    ``deadline`` is a `time.monotonic()` value, not a duration, so the
   115	    budget belongs to the CALLER that knows what it is scanning. When it
   116	    passes, the scan REFUSES the file (`PersonalPathUnreadable`, which
   117	    the CLI renders as rc 2) instead of returning the lines it had found:
   118	    a partial answer from a security matcher is not a clean file.
   119	
   120	    It is consulted AFTER every line, and the claim is exactly that: it
   121	    bounds the file ACROSS its lines. It does NOT interrupt work already
   122	    running inside one line, and `unicodedata.normalize` is work that can
   123	    itself be super-linear -- 140 000 combining marks followed by 140 000
   124	    more took 38.186 s in one call (mechanism lane, round 22). After such
   125	    a line the deadline fires, so the outcome is a NAMED refusal instead
   126	    of a silent green; the seconds spent on that line are not recovered,
   127	    and the honest boundary for them is the outer CI timeout.
   128	    """
   129	    hits: List[int] = []
   130	    for lineno, line in enumerate(text.split("\n"), start=1):
   131	        if line_is_personal_path_hit(unicodedata.normalize("NFKC", line)):
   132	            hits.append(lineno)
   133	        # AFTER the line, and after EVERY line -- both halves are the
   134	        # cure, and each was a defect on its own. Checking every 512th
   135	        # line left a document of ONE line unchecked. Checking at the TOP
   136	        # of the body left it unchecked too, for a subtler reason: the
   137	        # single check then runs before any work has been done, and the
   138	        # loop ends without another one. Measured after that cure:
   139	        # 140 000 U+0315 followed by 140 000 U+0300 took 72.2 s and
   140	        # returned 0 on a 30 s budget. After the line, there is something
   141	        # to detect; before it, there is not.
   142	        if deadline is not None and time.monotonic() > deadline:
   143	            raise PersonalPathUnreadable(
   144	                "matching did not finish within the per-file deadline of "
   145	                "%.0f s (stopped after line %d); the file is REFUSED "
   146	                "rather than reported clean"
   147	                % (_PERSONAL_PATH_FILE_BUDGET_S, lineno))
   148	    return tuple(hits)
