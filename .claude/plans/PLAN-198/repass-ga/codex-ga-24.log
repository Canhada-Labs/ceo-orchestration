     1	"""Byte-preserving inventory for the Rule 1 contamination scanner.
     2	
     3	Git is the authority for both the tracked name and its mode.  Keeping its
     4	NUL-delimited output as bytes prevents an undecodable path from becoming a
     5	different, non-existent pathname before the policy has inspected it.
     6	"""
     7	from __future__ import annotations
     8	
     9	import errno
    10	import os
    11	import stat
    12	import subprocess
    13	import unicodedata
    14	from pathlib import Path
    15	from typing import Callable, Iterable, List, Mapping, Optional, Pattern, Tuple
    16	
    17	
    18	_BLOB_MODES = frozenset({"100644", "100755", "120000"})
    19	_GITLINK_MODE = "160000"
    20	_NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
    21	_NONBLOCK = getattr(os, "O_NONBLOCK", 0)
    22	
    23	
    24	class RuleOneInputError(Exception):
    25	    """An indexed Rule 1 subject could not be verified."""
    26	
    27	
    28	def _index(repo_root: Path) -> List[Tuple[str, bytes]]:
    29	    """Return strict UTF-8 paths and index modes, refusing malformed names."""
    30	    try:
    31	        result = subprocess.run(
    32	            ["git", "ls-files", "-s", "-z"], cwd=str(repo_root),
    33	            capture_output=True, check=False, timeout=60,
    34	        )
    35	    except (OSError, subprocess.SubprocessError) as exc:
    36	        raise RuleOneInputError("cannot enumerate the git index") from exc
    37	    if result.returncode != 0:
    38	        raise RuleOneInputError("git ls-files -s failed")
    39	    entries = []
    40	    for row in result.stdout.split(b"\0"):
    41	        if not row:
    42	            continue
    43	        head, separator, raw_name = row.partition(b"\t")
    44	        if not separator:
    45	            raise RuleOneInputError("malformed git index entry")
    46	        try:
    47	            name = raw_name.decode("utf-8")
    48	        except UnicodeDecodeError as exc:
    49	            raise RuleOneInputError(
    50	                "a tracked Rule 1 path is not valid UTF-8") from None
    51	        if "\ufffd" in name:
    52	            raise RuleOneInputError("a tracked Rule 1 path is not valid UTF-8")
    53	        mode = head.split(b" ", 1)[0].decode("ascii")
    54	        entries.append((mode, name.encode("utf-8")))
    55	    return entries
    56	
    57	
    58	def _read_regular(path: Path) -> bytes:
    59	    """Read a regular blob without following a link swapped in after git."""
    60	    fd = os.open(str(path), os.O_RDONLY | _NOFOLLOW | _NONBLOCK)
    61	    try:
    62	        if not stat.S_ISREG(os.fstat(fd).st_mode):
    63	            raise OSError(errno.EINVAL, "tracked blob is not a regular file")
    64	        chunks = []
    65	        while True:
    66	            block = os.read(fd, 1 << 20)
    67	            if not block:
    68	                return b"".join(chunks)
    69	            chunks.append(block)
    70	    finally:
    71	        os.close(fd)
    72	
    73	
    74	def _blob(path: Path, mode: str) -> Optional[bytes]:
    75	    """Read link payloads as payloads; never follow a tracked symlink."""
    76	    if mode == "120000":
    77	        try:
    78	            return os.fsencode(os.readlink(path))
    79	        except OSError as exc:
    80	            raise RuleOneInputError(
    81	                "cannot read a tracked symlink payload") from exc
    82	    try:
    83	        return _read_regular(path)
    84	    except OSError as exc:
    85	        # A removed regular worktree file is permitted; an indexed symlink
    86	        # must still supply its literal target via readlink above.
    87	        if exc.errno == errno.ENOENT:
    88	            return None
    89	        if exc.errno == errno.ELOOP:
    90	            try:
    91	                return os.fsencode(os.readlink(path))
    92	            except OSError as link_error:
    93	                raise RuleOneInputError(
    94	                    "cannot read a tracked symlink payload") from link_error
    95	        raise RuleOneInputError("cannot read a tracked Rule 1 blob") from exc
    96	
