-
-    scan_blob = "\n".join([trigger, advisory_text, " ".join(scope_tags)])
-    ok, scan_outcome = _scan_candidate_fail_closed(scan_blob)
-    status = STATUS_PENDING if ok else STATUS_QUARANTINED
