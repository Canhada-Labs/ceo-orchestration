-    chain = _chain_latest_events({_ACTION_CANDIDATE_WRITTEN}, ids)
-
-    ttl_s = CANDIDATE_TTL_DAYS * 86400.0
-    warn_s = CANDIDATE_WARN_DAYS * 86400.0
