-class Subst(object):
-    __slots__ = ("delim", "pattern", "repl", "flags")
-
-    def __init__(self, delim: str, pattern: str, repl: str, flags: str) -> None:
-        self.delim = delim
-        self.pattern = pattern
-        self.repl = repl
-        self.flags = flags
-
-
-_SED_SIMPLE = set("pdqnNPDhHgGxzF=l")
-_SED_LABEL = set("btT:")
-_SED_TEXT = set("aic")
-_SED_FILE = set("rRwW")
