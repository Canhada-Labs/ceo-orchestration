{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018xSFa3XfZ9cEufRVjtxZ51","type":"tool_result","content":"1\t\"\"\"Compaction.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('_ledger_int_field', '_SETTINGS_TAMPER_CLASSES', '_SETTINGS_TAMPER_LAYERS', '_CONFIG_CHANGE_OBSERVED_ALLOWLIST', '_CONFIG_CHANGE_FORBIDDEN_KEY_ALLOWLIST', '_CONFIG_CHANGE_LAYERS', '_COMPACTION_CONTINUITY_SNAPSHOT_ALLOWLIST', '_COMPACTION_CONTEXT_REINJECTED_ALLOWLIST', '_CONTEXT_PRESSURE_OBSERVED_ALLOWLIST', '_COMPACTION_TRIGGERS', '_COMPACTION_SNAPSHOT_OUTCOMES', '_compaction_plan_id_ok', '_CONTEXT_PRESSURE_USED_BUCKETS_PCT', '_CONTEXT_PRESSURE_EVENT_SOURCES', '_CONTEXT_PRESSURE_STATE_BASENAME', '_GC_MARKER_WALL_BUDGET_S', '_CONTEXT_PRESSURE_SID_SAFE_CHARS', '_CONTEXT_PRESSURE_SID_MAX_LEN', '_CONTEXT_PRESSURE_MARKER_TTL_S', '_CONTEXT_PRESSURE_MARKER_GC_MAX')\n9\t\n10\tdef _ledger_int_field(value: Any, hi: int) -> int:\n11\t    \"\"\"TYPE-strict clamp for the ledger rail's integer wire fields.\n12\t\n13\t    Deliberately NOT ``int(value)``: ``bool`` is an ``int`` subclass (so\n14\t    ``True`` would sail through any numeric test) and ``canonical_json``\n15\t    REFUSES floats in HMAC-covered fields — a float here would drop the\n16\t    WHOLE event to an ``audit-log.errors`` breadcrumb rather than the one\n17\t    field (S181 / ADR-055-AMEND-2). Anything that is not a plain\n18\t    non-negative ``int`` therefore becomes ``0``, and values above ``hi``\n19\t    are clamped. Never echoes the rejected value.\n20\t    \"\"\"\n21\t    if isinstance(value, bool) or not isinstance(value, int):\n22\t        return 0\n23\t    if value < 0:\n24\t        return 0\n25\t    return value if value <= hi else hi\n26\t\n27\t\n28\t# PLAN-135 W1 S3 — closed enums. MUST mirror\n29\t# _lib/effective_config.TAMPER_CLASSES and the layer names\n30\t# (LAYER_MERGE_ORDER + LAYER_ENV + LAYER_DISK). Kept literal here (NOT\n31\t# imported) so audit_emit has zero import-time dependency on the resolver;\n32\t# a drift is caught by the staged parity test\n33\t# (test_ceo_boot_tamper_tripwires.py §enum-parity). Values outside the\n34\t# sets are COERCED to the safe sentinel \"other\" (S172 doctrine — the\n35\t# rejected value is never echoed)."}]},"parent_tool_use_id":null,"session_id":"718cdb07-6dd0-4fda-8536-67e04c6aa837","uuid":"0eea5fb0-bc25-4808-8957-a65a95d88f6b","timestamp":"2026-11-16T19:04:24.735Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/compaction.py","content":"\"\"\"Compaction.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('_ledger_int_field', '_SETTINGS_TAMPER_CLASSES', '_SETTINGS_TAMPER_LAYERS', '_CONFIG_CHANGE_OBSERVED_ALLOWLIST', '_CONFIG_CHANGE_FORBIDDEN_KEY_ALLOWLIST', '_CONFIG_CHANGE_LAYERS', '_COMPACTION_CONTINUITY_SNAPSHOT_ALLOWLIST', '_COMPACTION_CONTEXT_REINJECTED_ALLOWLIST', '_CONTEXT_PRESSURE_OBSERVED_ALLOWLIST', '_COMPACTION_TRIGGERS', '_COMPACTION_SNAPSHOT_OUTCOMES', '_compaction_plan_id_ok', '_CONTEXT_PRESSURE_USED_BUCKETS_PCT', '_CONTEXT_PRESSURE_EVENT_SOURCES', '_CONTEXT_PRESSURE_STATE_BASENAME', '_GC_MARKER_WALL_BUDGET_S', '_CONTEXT_PRESSURE_SID_SAFE_CHARS', '_CONTEXT_PRESSURE_SID_MAX_LEN', '_CONTEXT_PRESSURE_MARKER_TTL_S', '_CONTEXT_PRESSURE_MARKER_GC_MAX')\n\ndef _ledger_int_field(value: Any, hi: int) -> int:\n    \"\"\"TYPE-strict clamp for the ledger rail's integer wire fields.\n\n    Deliberately NOT ``int(value)``: ``bool`` is an ``int`` subclass (so\n    ``True`` would sail through any numeric test) and ``canonical_json``\n    REFUSES floats in HMAC-covered fields — a float here would drop the\n    WHOLE event to an ``audit-log.errors`` breadcrumb rather than the one\n    field (S181 / ADR-055-AMEND-2). Anything that is not a plain\n    non-negative ``int`` therefore becomes ``0``, and values above ``hi``\n    are clamped. Never echoes the rejected value.\n    \"\"\"\n    if isinstance(value, bool) or not isinstance(value, int):\n        return 0\n    if value < 0:\n        return 0\n    return value if value <= hi else hi\n\n\n# PLAN-135 W1 S3 — closed enums. MUST mirror\n# _lib/effective_config.TAMPER_CLASSES and the layer names\n# (LAYER_MERGE_ORDER + LAYER_ENV + LAYER_DISK). Kept literal here (NOT\n# imported) so audit_emit has zero import-time dependency on the resolver;\n# a drift is caught by the staged parity test\n# (test_ceo_boot_tamper_tripwires.py §enum-parity). Values outside the\n# sets are COERCED to the safe sentinel \"other\" (S172 doctrine — the\n# rejected value is never echoed).","numLines":35,"startLine":1,"totalLines":266}},"tool_result_meta":[{"id":"toolu_018xSFa3XfZ9cEufRVjtxZ51","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
