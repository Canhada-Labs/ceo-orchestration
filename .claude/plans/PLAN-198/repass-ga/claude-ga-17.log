tournament_selected\",\n    \"task_route_advised\",\n    \"task_route_ground_truth_label\",\n    \"task_route_key_dropped\",\n    \"thinking_budget_set\",\n    \"threat_model_freshness_breach\",\n    \"threat_model_promoted\",\n    \"tier_policy_adopter_override_respected\",\n    \"tier_policy_demote_requested\",\n    \"tier_policy_derived\",\n    \"tier_policy_dry_run_complete\",\n    \"tier_policy_hmac_verify_failed\",\n    \"tier_policy_killswitch_triggered\",\n    \"tier_policy_loader_fallback_observed\",\n    \"tier_policy_misrouting_advised\",\n    \"tier_policy_promote_applied\",\n    \"tier_policy_promote_cost_gated\",\n    \"tier_policy_rejected\",\n    \"token_budget_guard_paused\",\n    \"tool_call_lifecycle_recorded\",\n    \"tournament_aborted\",\n    \"tournament_budget_exceeded\",\n    \"tournament_budget_projected\",\n    \"tournament_fixture_rejected\",\n    \"tournament_judge_hijack_suspected\",\n    \"tournament_run_completed\",\n    \"tournament_run_started\",\n    \"tournament_task_scored\",\n    \"trading_kill_switch_disabled\",\n    \"trading_kill_switch_invoked\",\n    \"trading_write_override_used\",\n    \"value_dashboard_summarized\",\n    \"verify_after_edit_finding\",\n    \"veto_triggered\",\n    \"wave_artifact_written\",\n    \"wave_readonly_violation\",\n}\n\nEVENT_SCHEMA_V2 = \"v2\"\n\n\ndef iter_events(*args: Any, **kwargs: Any) -> Any:\n    return _streaming.iter_events(*args, **kwargs)\n\n\ndef emit_credential_rotation_due(\n    provider: str,\n    age_days: int,\n    warn_threshold_days: int = 75,\n    max_threshold_days: int = 90,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit a credential_rotation_due event (ADR-040 §4).\n\n    Fired on every live call once the active API key is older than\n    ``warn_threshold_days`` (default 75). The event does not block the\n    call — it surfaces in the dashboard so the operator rotates before\n    the 90-day hard cap. Credential value is NEVER in any field.\n    \"\"\"\n    event: Dict[str, Any] = {\n        \"action\": \"credential_rotation_due\",\n        \"provider\": provider,\n        \"age_days\": int(age_days),\n        \"warn_threshold_days\": int(warn_threshold_days),\n        \"max_threshold_days\": int(max_threshold_days),\n        \"session_id\": session_id,\n        \"project\": project,\n    }\n    _write_event(event)\n\n\nfrom _lib._audit_emit_parts import install as _install_parts\n\n_install_parts(\n    globals(),\n    (\n        \"writer\",\n        \"streaming\",\n        \"boot_schemas\",\n        \"optimizer\",\n        \"federation_schemas\",\n        \"governance\",\n        \"workflow\",\n        \"resource_events\",\n        \"adapters\",\n        \"security\",\n        \"planning\",\n        \"replay\",\n        \"lifecycle_schemas\",\n        \"harness_schemas\",\n        \"compaction\",\n        \"context_pressure\",\n        \"tokens_boot\",\n        \"harness\",\n        \"lifecycle\",\n        \"defense\",\n        \"routing\",\n        \"pair_rail\",\n        \"rate_limits\",\n        \"operations\",\n        \"orchestration\",\n        \"federation_persona\",\n        \"confidence\",\n        \"finalization\",\n        \"generic_dispatch_01\",\n        \"generic_dispatch_02\",\n        \"generic_dispatch_03\",\n        \"generic_dispatch_04\",\n        \"generic_dispatch_05\",\n    ),\n)\n\n\n# ``install`` has just bound replay.iter_events to this facade namespace, so\n# keep that bound implementation behind the stable streaming delegation API.\n_streaming = SimpleNamespace(iter_events=iter_events)\n\n\ndef iter_events(*args: Any, **kwargs: Any) -> Any:\n    return _streaming.iter_events(*args, **kwargs)\n\n\n_GENERIC_DISPATCH_HANDLERS = (\n    _apply_generic_group_01,\n    _apply_generic_group_02,\n    _apply_generic_group_03,\n    _apply_generic_group_04,\n    _apply_generic_group_05,\n)\n\n\ndef emit_generic(action: str, **kwargs: Any) -> None:\n    if action == \"tool_call_lifecycle_recorded\":\n        _dispatch_generic(action, kwargs)\n        return\n    if action == \"settings_tamper_detected\":\n        _dispatch_generic(action, kwargs)\n        return\n    _dispatch_generic(action, kwargs)\n\n\n_PLAN088_RATE_LOCK = threading.Lock()\n_PLAN090_BUCKET_LOCK = threading.Lock()\n\nif _SPOOL_WRITER_AVAILABLE and _spool_writer is not None:\n    try:\n        _spool_writer.set_forensic_emitter(\n            lambda _action, _fields: emit_generic(_action, **_fields)\n        )\n    except Exception:\n        pass\n    try:\n        _spool_writer.install_exit_handlers()\n    except Exception:\n        pass\n","numLines":497,"startLine":1,"totalLines":497}},"tool_result_meta":[{"id":"toolu_01PL6uzKPQRoFffKwg9MWWPQ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
