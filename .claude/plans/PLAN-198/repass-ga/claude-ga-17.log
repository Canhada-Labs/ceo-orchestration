{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0164LvR64oSXYGicCfQ6ASkA","type":"tool_result","content":"1\t\"\"\"Replay.\n2\t\n3\tInternal declarations exported by the audit_emit compatibility facade.\n4\t\"\"\"\n5\t\n6\tfrom __future__ import annotations\n7\t\n8\t__all__ = ('emit_policy_evaluated', 'emit_policy_denied', 'emit_policy_error', 'emit_replay_started', 'emit_replay_completed', 'emit_replay_diff_produced', 'emit_replay_capture_started', 'emit_replay_capture_completed', 'emit_prediction_queried', 'emit_pattern_stored', 'emit_pattern_queried', 'emit_pattern_evicted', 'emit_threat_model_promoted', 'emit_threat_model_freshness_breach', 'iter_events')\n9\t\n10\t# -----------------------------------------------------------------------------\n11\t# Sprint 14 Phase 0.6 (PLAN-014) — audit registry v2.6 emitters\n12\t# -----------------------------------------------------------------------------\n13\t\n14\t\n15\tdef emit_policy_evaluated(\n16\t    policy_id: str,\n17\t    rule_id: str,\n18\t    decision: str,\n19\t    duration_ms: int = 0,\n20\t    session_id: str = \"\",\n21\t    project: str = \"\",\n22\t) -> None:\n23\t    \"\"\"Emit policy_evaluated (ADR-045 + SPEC/v1/policy-dsl.schema.md).\n24\t\n25\t    Fired on every rule evaluation. ``decision`` ∈ {allow, deny, block}.\n26\t    ``policy_id`` matches ``.claude/policies/<name>.yaml`` filename.\n27\t    \"\"\"\n28\t    _write_event({\n29\t        \"action\": \"policy_evaluated\",\n30\t        \"policy_id\": policy_id,\n31\t        \"rule_id\": rule_id,\n32\t        \"decision\": decision,\n33\t        \"duration_ms\": int(duration_ms),\n34\t        \"session_id\": session_id,\n35\t        \"project\": project,\n36\t    })\n37\t\n38\t\n39\tdef emit_policy_denied(\n40\t    policy_id: str,\n41\t    rule_id: str,\n42\t    reason: str,\n43\t    session_id: str = \"\",\n44\t    project: str = \"\",\n45\t) -> None:\n46\t    \"\"\"Emit policy_denied (ADR-045 §Decision — final deny after rule evaluation).\n47\t\n48\t    ``reason`` is a closed-enum error-model string per SPEC §Error-model.\n49\t    \"\"\"\n50\t    _write_event({\n51\t        \"action\": \"policy_denied\",\n52\t        \"policy_id\": policy_id,\n53\t        \"rule_id\": rule_id,\n54\t        \"reason\": reason,\n55\t        \"session_id\": session_id,\n56\t        \"project\": project,\n57\t    })\n58\t\n59\t\n60\tdef emit_policy_error(\n61\t    policy_id: str,\n62\t    error_kind: str,\n63\t    detail: str = \"\",\n64\t    session_id: str = \"\",\n65\t    project: str = \"\",\n66\t) -> None:\n67\t    \"\"\"Emit policy_error (ADR-045 §Fail-mode matrix — A.3.1).\n68\t\n69\t    ``error_kind`` ∈ {parse_error, predicate_missing, import_failure,\n70\t    depth_limit, size_limit, alias_rejected, tag_rejected}. Security\n71\t    surfaces fail-CLOSED after this event; advisory surfaces fail-open.\n72\t    ``detail`` is free-text redacted via _redact.redact_secrets in write path.\n73\t    \"\"\"\n74\t    _write_event({\n75\t        \"action\": \"policy_error\",\n76\t        \"policy_id\": policy_id,\n77\t        \"error_kind\": error_kind,\n78\t        \"detail\": _redact.redact_secrets(detail or \"\"),\n79\t        \"session_id\": session_id,\n80\t        \"project\": project,\n81\t    })\n82\t\n83\t\n84\tdef emit_replay_started(\n85\t    original_session_id: str,\n86\t    mode: str,\n87\t    redacted_fragments_count: int = 0,\n88\t    as_user: str = \"\",\n89\t    session_id: str = \"\",\n90\t    project: str = \"\",\n91\t) -> None:\n92\t    \"\"\"Emit replay_started (ADR-046 + SPEC/v1/replay.schema.md).\n93\t\n94\t    ``mode`` ∈ {dry_run, execute}. ``--execute`` default: stub adapters +\n95\t    OTEL disabled per ADR-046 invariant \"replays never reach real\n96\t    providers by default\". ``as_user`` preserves original-session-owner\n97\t    distinction (Security unseen #3).\n98\t    \"\"\"\n99\t    _write_event({\n100\t        \"action\": \"replay_started\",\n101\t        \"original_session_id\": original_session_id,\n102\t        \"mode\": mode,\n103\t        \"redacted_fragments_count\": int(redacted_fragments_count),\n104\t        \"as_user\": as_user,\n105\t        \"session_id\": session_id,\n106\t        \"project\": project,\n107\t    })\n108\t\n109\t\n110\tdef emit_replay_completed(\n111\t    original_session_id: str,\n112\t    mode: str,\n113\t    duration_ms: int,\n114\t    spawn_count: int,\n115\t    diff_summary: str = \"\",\n116\t    session_id: str = \"\",\n117\t    project: str = \"\",\n118\t) -> None:\n119\t    \"\"\"Emit replay_completed (ADR-046).\"\"\"\n120\t    _write_event({\n121\t        \"action\": \"replay_completed\",\n122\t        \"original_session_id\": original_session_id,\n123\t        \"mode\": mode,\n124\t        \"duration_ms\": int(duration_ms),\n125\t        \"spawn_count\": int(spawn_count),\n126\t        \"diff_summary\": diff_summary,\n127\t        \"session_id\": session_id,\n128\t        \"project\": project,\n129\t    })\n130\t\n131\t\n132\tdef emit_replay_diff_produced(\n133\t    original_session_id: str,\n134\t    spawn_ordinal: int,\n135\t    divergence_kind: str,\n136\t    artifact_path: str = \"\",\n137\t    session_id: str = \"\",\n138\t    project: str = \"\",\n139\t) -> None:\n140\t    \"\"\"Emit replay_diff_produced (ADR-046 — per-spawn divergence artifact).\n141\t\n142\t    ``divergence_kind`` ∈ {output_mismatch, spawn_missing, extra_spawn,\n143\t    env_mismatch, audit_payload_mismatch}.\n144\t    \"\"\"\n145\t    _write_event({\n146\t        \"action\": \"replay_diff_produced\",\n147\t        \"original_session_id\": original_session_id,\n148\t        \"spawn_ordinal\": int(spawn_ordinal),\n149\t        \"divergence_kind\": divergence_kind,\n150\t        \"artifact_path\": artifact_path,\n151\t        \"session_id\": session_id,\n152\t        \"project\": project,\n153\t    })\n154\t\n155\t\n156\tdef emit_replay_capture_started(\n157\t    original_session_id: str,\n158\t    redacted_fragments_count: int = 0,\n159\t    as_user: str = \"\",\n160\t    session_id: str = \"\",\n161\t    project: str = \"\",\n162\t) -> None:\n163\t    \"\"\"Emit replay_capture_started (PLAN-069 Phase 1 / ADR-101 / SPEC v2.16).\n164\t\n165\t    Capture mode produces a redacted JSONL fixture under $CLAUDE_PROJECT_DIR.\n166\t    Distinct from replay_started which describes dry_run/execute paths.\n167\t    ``redacted_fragments_count`` mirrors the existing replay_started semantic\n168\t    (advisory count of redactable audit-log payloads in scope).\n169\t    \"\"\"\n170\t    _write_event({\n171\t        \"action\": \"replay_capture_started\",\n172\t        \"original_session_id\": original_session_id,\n173\t        \"redacted_fragments_count\": int(redacted_fragments_count),\n174\t        \"as_user\": as_user,\n175\t        \"session_id\": session_id,\n176\t        \"project\": project,\n177\t    })\n178\t\n179\t\n180\tdef emit_replay_capture_completed(\n181\t    original_session_id: str,\n182\t    duration_ms: int,\n183\t    event_count: int,\n184\t    fixture_path: str = \"\",\n185\t    session_id: str = \"\",\n186\t    project: str = \"\",\n187\t) -> None:\n188\t    \"\"\"Emit replay_capture_completed (PLAN-069 Phase 1 / ADR-101 / SPEC v2.16).\n189\t\n190\t    ``event_count`` is the total redacted events written to the fixture.\n191\t    ``fixture_path`` is the resolved $CLAUDE_PROJECT_DIR-relative path.\n192\t    \"\"\"\n193\t    _write_event({\n194\t        \"action\": \"replay_capture_completed\",\n195\t        \"original_session_id\": original_session_id,\n196\t        \"duration_ms\": int(duration_ms),\n197\t        \"event_count\": int(event_count),\n198\t        \"fixture_path\": fixture_path,\n199\t        \"session_id\": session_id,\n200\t        \"project\": project,\n201\t    })\n202\t\n203\t\n204\tdef emit_prediction_queried(\n205\t    plan_id: str,\n206\t    bucket_range: str,\n207\t    confidence: str,\n208\t    training_window_plans: int = 0,\n209\t    session_id: str = \"\",\n210\t    project: str = \"\",\n211\t) -> None:\n212\t    \"\"\"Emit prediction_queried (ADR-047 + SPEC/v1/predict-budget.schema.md).\n213\t\n214\t    ``bucket_range`` is bucketed string (e.g. \"100k-130k\") per ADJ-038\n215\t    (NO raw dollar figures — Tier 2 sensitive). ``confidence`` ∈\n216\t    {high, medium, low, cold_start}. ``cold_start`` for zero-history\n217\t    adopter (Staff Backend unseen #5) — advisory only.\n218\t    \"\"\"\n219\t    _write_event({\n220\t        \"action\": \"prediction_queried\",\n221\t        \"plan_id\": plan_id,\n222\t        \"bucket_range\": bucket_range,\n223\t        \"confidence\": confidence,\n224\t        \"training_window_plans\": int(training_window_plans),\n225\t        \"session_id\": session_id,\n226\t        \"project\": project,\n227\t    })\n228\t\n229\t\n230\tdef emit_pattern_stored(\n231\t    topic: str,\n232\t    content_hash: str,\n233\t    size_bytes: int,\n234\t    session_id: str = \"\",\n235\t    project: str = \"\",\n236\t) -> None:\n237\t    \"\"\"Emit pattern_stored (ADR-048 + SPEC/v1/memory-shared.schema.md).\n238\t\n239\t    ``content_hash`` is sha256 of post-redact content (one-file-per-pattern\n240\t    naming per ADJ-035). ``topic`` is Unicode NFC + lowercase + dash-separated.\n241\t    Caller MUST redact-on-ingest via _redact.redact_secrets before write.\n242\t    \"\"\"\n243\t    _write_event({\n244\t        \"action\": \"pattern_stored\",\n245\t        \"topic\": topic,\n246\t        \"content_hash\": content_hash,\n247\t        \"size_bytes\": int(size_bytes),\n248\t        \"session_id\": session_id,\n249\t        \"project\": project,\n250\t    })\n251\t\n252\t\n253\tdef emit_pattern_queried(\n254\t    topic: str,\n255\t    k: int,\n256\t    match_count: int,\n257\t    session_id: str = \"\",\n258\t    project: str = \"\",\n259\t) -> None:\n260\t    \"\"\"Emit pattern_queried (ADR-048). ``k`` clamped 1..10 per SPEC.\"\"\"\n261\t    _write_event({\n262\t        \"action\": \"pattern_queried\",\n263\t        \"topic\": topic,\n264\t        \"k\": int(k),\n265\t        \"match_count\": int(match_count),\n266\t        \"session_id\": session_id,\n267\t        \"project\": project,\n268\t    })\n269\t\n270\t\n271\tdef emit_pattern_evicted(\n272\t    topic: str,\n273\t    content_hash: str,\n274\t    reason: str,\n275\t    session_id: str = \"\",\n276\t    project: str = \"\",\n277\t) -> None:\n278\t    \"\"\"Emit pattern_evicted (ADR-048 — manual eviction path).\n279\t\n280\t    ``reason`` ∈ {admin_request, size_cap_breach, redact_violation}.\n281\t    Retention unbounded per SPEC — eviction only via this event path.\n282\t    \"\"\"\n283\t    _write_event({\n284\t        \"action\": \"pattern_evicted\",\n285\t        \"topic\": topic,\n286\t        \"content_hash\": content_hash,\n287\t        \"reason\": reason,\n288\t        \"session_id\": session_id,\n289\t        \"project\": project,\n290\t    })\n291\t\n292\t\n293\tdef emit_threat_model_promoted(\n294\t    from_status: str,\n295\t    to_status: str,\n296\t    accepted_by: str,\n297\t    commit_sha: str = \"\",\n298\t    session_id: str = \"\",\n299\t    project: str = \"\",\n300\t) -> None:\n301\t    \"\"\"Emit threat_model_promoted (Phase C.1 — docs/threat-model.md status flip).\n302\t\n303\t    ``from_status`` → ``to_status`` ∈ {draft, accepted, stale}.\n304\t    ``accepted_by`` matches the signed ``Accepted-By:`` line + commit trailer.\n305\t    \"\"\"\n306\t    _write_event({\n307\t        \"action\": \"threat_model_promoted\",\n308\t        \"from_status\": from_status,\n309\t        \"to_status\": to_status,\n310\t        \"accepted_by\": accepted_by,\n311\t        \"commit_sha\": commit_sha,\n312\t        \"session_id\": session_id,\n313\t        \"project\": project,\n314\t    })\n315\t\n316\t\n317\tdef emit_threat_model_freshness_breach(\n318\t    new_adr_count_since_review: int,\n319\t    threshold: int = 2,\n320\t    session_id: str = \"\",\n321\t    project: str = \"\",\n322\t) -> None:\n323\t    \"\"\"Emit threat_model_freshness_breach (Phase C.4 — status-flip accepted→stale).\n324\t\n325\t    Per ADJ-021: freshness script flips status (not just warn) after\n326\t    ``threshold`` new in-scope ADRs merge without review.\n327\t    \"\"\"\n328\t    _write_event({\n329\t        \"action\": \"threat_model_freshness_breach\",\n330\t        \"new_adr_count_since_review\": int(new_adr_count_since_review),\n331\t        \"threshold\": int(threshold),\n332\t        \"session_id\": session_id,\n333\t        \"project\": project,\n334\t    })\n335\t\n336\t\n337\t# -----------------------------------------------------------------------------\n338\t# Public: iterate events (derived views — used by audit-query.py sub-commands)\n339\t# -----------------------------------------------------------------------------\n340\t\n341\t\n342\tdef iter_events(\n343\t    path: Optional[Path] = None,\n344\t    action_filter: Optional[str] = None,\n345\t) -> Iterator[Dict[str, Any]]:\n346\t    \"\"\"Yield events from the audit log, optionally filtering by action.\n347\t\n348\t    Tolerates malformed lines (logs breadcrumb, skips).\n349\t    \"\"\"\n350\t    log = path or _log_path()\n351\t    if not log.exists():\n352\t        return\n353\t    try:\n354\t        with log.open(\"r\", encoding=\"utf-8\") as f:\n355\t            for line_num, raw in enumerate(f, 1):\n356\t                raw = raw.strip()\n357\t                if not raw:\n358\t                    continue\n359\t                try:\n360\t                    event = json.loads(raw)\n361\t                except json.JSONDecodeError:\n362\t                    _breadcrumb(f\"iter_events: malformed line {line_num}\")\n363\t                    continue\n364\t                if action_filter and event.get(\"action\") != action_filter:\n365\t                    continue\n366\t                yield event\n367\t    except OSError as e:  # pragma: no cover\n368\t        _breadcrumb(f\"iter_events open error: {e}\")\n369\t"}]},"parent_tool_use_id":null,"session_id":"718cdb07-6dd0-4fda-8536-67e04c6aa837","uuid":"09cf5788-6e43-4c5f-9fad-65d51e5f310d","timestamp":"2026-11-16T19:01:40.726Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/hooks/_lib/_audit_emit_parts/replay.py","content":"\"\"\"Replay.\n\nInternal declarations exported by the audit_emit compatibility facade.\n\"\"\"\n\nfrom __future__ import annotations\n\n__all__ = ('emit_policy_evaluated', 'emit_policy_denied', 'emit_policy_error', 'emit_replay_started', 'emit_replay_completed', 'emit_replay_diff_produced', 'emit_replay_capture_started', 'emit_replay_capture_completed', 'emit_prediction_queried', 'emit_pattern_stored', 'emit_pattern_queried', 'emit_pattern_evicted', 'emit_threat_model_promoted', 'emit_threat_model_freshness_breach', 'iter_events')\n\n# -----------------------------------------------------------------------------\n# Sprint 14 Phase 0.6 (PLAN-014) — audit registry v2.6 emitters\n# -----------------------------------------------------------------------------\n\n\ndef emit_policy_evaluated(\n    policy_id: str,\n    rule_id: str,\n    decision: str,\n    duration_ms: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit policy_evaluated (ADR-045 + SPEC/v1/policy-dsl.schema.md).\n\n    Fired on every rule evaluation. ``decision`` ∈ {allow, deny, block}.\n    ``policy_id`` matches ``.claude/policies/<name>.yaml`` filename.\n    \"\"\"\n    _write_event({\n        \"action\": \"policy_evaluated\",\n        \"policy_id\": policy_id,\n        \"rule_id\": rule_id,\n        \"decision\": decision,\n        \"duration_ms\": int(duration_ms),\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_policy_denied(\n    policy_id: str,\n    rule_id: str,\n    reason: str,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit policy_denied (ADR-045 §Decision — final deny after rule evaluation).\n\n    ``reason`` is a closed-enum error-model string per SPEC §Error-model.\n    \"\"\"\n    _write_event({\n        \"action\": \"policy_denied\",\n        \"policy_id\": policy_id,\n        \"rule_id\": rule_id,\n        \"reason\": reason,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_policy_error(\n    policy_id: str,\n    error_kind: str,\n    detail: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit policy_error (ADR-045 §Fail-mode matrix — A.3.1).\n\n    ``error_kind`` ∈ {parse_error, predicate_missing, import_failure,\n    depth_limit, size_limit, alias_rejected, tag_rejected}. Security\n    surfaces fail-CLOSED after this event; advisory surfaces fail-open.\n    ``detail`` is free-text redacted via _redact.redact_secrets in write path.\n    \"\"\"\n    _write_event({\n        \"action\": \"policy_error\",\n        \"policy_id\": policy_id,\n        \"error_kind\": error_kind,\n        \"detail\": _redact.redact_secrets(detail or \"\"),\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_replay_started(\n    original_session_id: str,\n    mode: str,\n    redacted_fragments_count: int = 0,\n    as_user: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit replay_started (ADR-046 + SPEC/v1/replay.schema.md).\n\n    ``mode`` ∈ {dry_run, execute}. ``--execute`` default: stub adapters +\n    OTEL disabled per ADR-046 invariant \"replays never reach real\n    providers by default\". ``as_user`` preserves original-session-owner\n    distinction (Security unseen #3).\n    \"\"\"\n    _write_event({\n        \"action\": \"replay_started\",\n        \"original_session_id\": original_session_id,\n        \"mode\": mode,\n        \"redacted_fragments_count\": int(redacted_fragments_count),\n        \"as_user\": as_user,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_replay_completed(\n    original_session_id: str,\n    mode: str,\n    duration_ms: int,\n    spawn_count: int,\n    diff_summary: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit replay_completed (ADR-046).\"\"\"\n    _write_event({\n        \"action\": \"replay_completed\",\n        \"original_session_id\": original_session_id,\n        \"mode\": mode,\n        \"duration_ms\": int(duration_ms),\n        \"spawn_count\": int(spawn_count),\n        \"diff_summary\": diff_summary,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_replay_diff_produced(\n    original_session_id: str,\n    spawn_ordinal: int,\n    divergence_kind: str,\n    artifact_path: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit replay_diff_produced (ADR-046 — per-spawn divergence artifact).\n\n    ``divergence_kind`` ∈ {output_mismatch, spawn_missing, extra_spawn,\n    env_mismatch, audit_payload_mismatch}.\n    \"\"\"\n    _write_event({\n        \"action\": \"replay_diff_produced\",\n        \"original_session_id\": original_session_id,\n        \"spawn_ordinal\": int(spawn_ordinal),\n        \"divergence_kind\": divergence_kind,\n        \"artifact_path\": artifact_path,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_replay_capture_started(\n    original_session_id: str,\n    redacted_fragments_count: int = 0,\n    as_user: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit replay_capture_started (PLAN-069 Phase 1 / ADR-101 / SPEC v2.16).\n\n    Capture mode produces a redacted JSONL fixture under $CLAUDE_PROJECT_DIR.\n    Distinct from replay_started which describes dry_run/execute paths.\n    ``redacted_fragments_count`` mirrors the existing replay_started semantic\n    (advisory count of redactable audit-log payloads in scope).\n    \"\"\"\n    _write_event({\n        \"action\": \"replay_capture_started\",\n        \"original_session_id\": original_session_id,\n        \"redacted_fragments_count\": int(redacted_fragments_count),\n        \"as_user\": as_user,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_replay_capture_completed(\n    original_session_id: str,\n    duration_ms: int,\n    event_count: int,\n    fixture_path: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit replay_capture_completed (PLAN-069 Phase 1 / ADR-101 / SPEC v2.16).\n\n    ``event_count`` is the total redacted events written to the fixture.\n    ``fixture_path`` is the resolved $CLAUDE_PROJECT_DIR-relative path.\n    \"\"\"\n    _write_event({\n        \"action\": \"replay_capture_completed\",\n        \"original_session_id\": original_session_id,\n        \"duration_ms\": int(duration_ms),\n        \"event_count\": int(event_count),\n        \"fixture_path\": fixture_path,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_prediction_queried(\n    plan_id: str,\n    bucket_range: str,\n    confidence: str,\n    training_window_plans: int = 0,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit prediction_queried (ADR-047 + SPEC/v1/predict-budget.schema.md).\n\n    ``bucket_range`` is bucketed string (e.g. \"100k-130k\") per ADJ-038\n    (NO raw dollar figures — Tier 2 sensitive). ``confidence`` ∈\n    {high, medium, low, cold_start}. ``cold_start`` for zero-history\n    adopter (Staff Backend unseen #5) — advisory only.\n    \"\"\"\n    _write_event({\n        \"action\": \"prediction_queried\",\n        \"plan_id\": plan_id,\n        \"bucket_range\": bucket_range,\n        \"confidence\": confidence,\n        \"training_window_plans\": int(training_window_plans),\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_pattern_stored(\n    topic: str,\n    content_hash: str,\n    size_bytes: int,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit pattern_stored (ADR-048 + SPEC/v1/memory-shared.schema.md).\n\n    ``content_hash`` is sha256 of post-redact content (one-file-per-pattern\n    naming per ADJ-035). ``topic`` is Unicode NFC + lowercase + dash-separated.\n    Caller MUST redact-on-ingest via _redact.redact_secrets before write.\n    \"\"\"\n    _write_event({\n        \"action\": \"pattern_stored\",\n        \"topic\": topic,\n        \"content_hash\": content_hash,\n        \"size_bytes\": int(size_bytes),\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_pattern_queried(\n    topic: str,\n    k: int,\n    match_count: int,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit pattern_queried (ADR-048). ``k`` clamped 1..10 per SPEC.\"\"\"\n    _write_event({\n        \"action\": \"pattern_queried\",\n        \"topic\": topic,\n        \"k\": int(k),\n        \"match_count\": int(match_count),\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_pattern_evicted(\n    topic: str,\n    content_hash: str,\n    reason: str,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit pattern_evicted (ADR-048 — manual eviction path).\n\n    ``reason`` ∈ {admin_request, size_cap_breach, redact_violation}.\n    Retention unbounded per SPEC — eviction only via this event path.\n    \"\"\"\n    _write_event({\n        \"action\": \"pattern_evicted\",\n        \"topic\": topic,\n        \"content_hash\": content_hash,\n        \"reason\": reason,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_threat_model_promoted(\n    from_status: str,\n    to_status: str,\n    accepted_by: str,\n    commit_sha: str = \"\",\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit threat_model_promoted (Phase C.1 — docs/threat-model.md status flip).\n\n    ``from_status`` → ``to_status`` ∈ {draft, accepted, stale}.\n    ``accepted_by`` matches the signed ``Accepted-By:`` line + commit trailer.\n    \"\"\"\n    _write_event({\n        \"action\": \"threat_model_promoted\",\n        \"from_status\": from_status,\n        \"to_status\": to_status,\n        \"accepted_by\": accepted_by,\n        \"commit_sha\": commit_sha,\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\ndef emit_threat_model_freshness_breach(\n    new_adr_count_since_review: int,\n    threshold: int = 2,\n    session_id: str = \"\",\n    project: str = \"\",\n) -> None:\n    \"\"\"Emit threat_model_freshness_breach (Phase C.4 — status-flip accepted→stale).\n\n    Per ADJ-021: freshness script flips status (not just warn) after\n    ``threshold`` new in-scope ADRs merge without review.\n    \"\"\"\n    _write_event({\n        \"action\": \"threat_model_freshness_breach\",\n        \"new_adr_count_since_review\": int(new_adr_count_since_review),\n        \"threshold\": int(threshold),\n        \"session_id\": session_id,\n        \"project\": project,\n    })\n\n\n# -----------------------------------------------------------------------------\n# Public: iterate events (derived views — used by audit-query.py sub-commands)\n# -----------------------------------------------------------------------------\n\n\ndef iter_events(\n    path: Optional[Path] = None,\n    action_filter: Optional[str] = None,\n) -> Iterator[Dict[str, Any]]:\n    \"\"\"Yield events from the audit log, optionally filtering by action.\n\n    Tolerates malformed lines (logs breadcrumb, skips).\n    \"\"\"\n    log = path or _log_path()\n    if not log.exists():\n        return\n    try:\n        with log.open(\"r\", encoding=\"utf-8\") as f:\n            for line_num, raw in enumerate(f, 1):\n                raw = raw.strip()\n                if not raw:\n                    continue\n                try:\n                    event = json.loads(raw)\n                except json.JSONDecodeError:\n                    _breadcrumb(f\"iter_events: malformed line {line_num}\")\n                    continue\n                if action_filter and event.get(\"action\") != action_filter:\n                    continue\n                yield event\n    except OSError as e:  # pragma: no cover\n        _breadcrumb(f\"iter_events open error: {e}\")\n","numLines":369,"startLine":1,"totalLines":369}},"tool_result_meta":[{"id":"toolu_0164LvR64oSXYGicCfQ6ASkA","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
