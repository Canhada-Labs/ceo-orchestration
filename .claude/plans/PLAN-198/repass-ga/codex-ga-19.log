def _has_context(
    text: str,
    span_start: int,
    span_end: int,
    context_re: Pattern[str],
    window: int,
) -> bool:
    """True if context_re matches within ``window`` chars of the span."""
    left = max(0, span_start - window)
    right = min(len(text), span_end + window)
    return bool(context_re.search(text[left:right]))


