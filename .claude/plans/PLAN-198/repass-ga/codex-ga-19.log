-            path=str(self.path)[:128] if self.path else "",
-            peer_id_cert_fingerprint=peer_fpr,
-            client_ip=self._client_ip(),
-            fed_correlation_id=correlation[:64],
-        )
-
-    def _send_405(self) -> None:
-        self.send_response(405)
