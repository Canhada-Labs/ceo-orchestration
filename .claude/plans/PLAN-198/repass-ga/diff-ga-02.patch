+    _write_event(cleaned)
+    if dropped:  # pragma: no cover — impossible from the typed wrapper
+        _breadcrumb(
+            f"notification_lifecycle dropped forbidden field(s): "
+            f"{sorted(dropped)[:10]}"
+        )
+
