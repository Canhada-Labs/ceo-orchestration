+def _learning_scope_tags_field(value: Any) -> List[str]:
+    """Coerce scope_tags: <=16 bounded identifier tokens, rest dropped."""
+    out: List[str] = []
+    if isinstance(value, (list, tuple)):
+        for item in value:
+            if isinstance(item, str) and _LEARNING_ID_RE.match(item):
+                out.append(item)
+            if len(out) >= 16:
