   527	def _iter_lines(log_path: Optional[Path]) -> "Iterator[tuple[int, str]]":
   528	    """Yield ``(line_num, raw_line)`` pairs from file or stdin."""
   529	    if log_path is None:
   530	        for i, raw in enumerate(sys.stdin, start=1):
   531	            yield (i, raw)
   532	        return
   533	    if not log_path.exists():
   534	        _err("error: log file not found: {p}".format(p=log_path))
   535	        sys.exit(EXIT_MALFORMED)
   536	    with log_path.open("r", encoding="utf-8") as f:
   537	        for i, raw in enumerate(f, start=1):
   538	            yield (i, raw)
