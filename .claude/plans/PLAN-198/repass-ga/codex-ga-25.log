   613	def _open_log_strict(log_path: Optional[Path]) -> "io.TextIOWrapper":
   614	    """One decoding path for file and stdin, so the same bytes get the same verdict."""
   615	    if log_path is None:
   616	        return io.TextIOWrapper(sys.stdin.buffer, encoding="utf-8", errors="strict")
   617	    try:
   618	        os.lstat(str(log_path))
   619	    except FileNotFoundError as e:
   620	        raise _StrictFailure(
   621	            EXIT_MALFORMED, STATUS_MALFORMED,
   622	            "log_not_found: {p}".format(p=log_path),
   623	        ) from e
   624	    except OSError:
   625	        pass  # the open below names it
   626	    binary = _open_regular_strict(log_path, "log", "log_not_regular")
   627	    return io.TextIOWrapper(binary, encoding="utf-8", errors="strict")
