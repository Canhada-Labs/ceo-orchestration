   730	def _resolve_log_path(args: argparse.Namespace) -> Optional[Path]:
   731	    """The log path of ``args``: None means stdin. :data:`_LOG_PATH_UNRESOLVED` means
   732	    the default directory could not be resolved."""
   733	    if args.stdin or (args.log_file is not None and str(args.log_file) == "-"):
   734	        return None
   735	    if args.log_file is not None:
   736	        return args.log_file
   737	    env_log = os.environ.get("CEO_AUDIT_LOG_PATH")
   738	    if env_log:
   739	        return Path(env_log)
   740	    # Default: sibling of audit-key resolution.
   741	    try:
   742	        default_dir = audit_hmac._audit_dir_from_env()
   743	    except Exception:
   744	        return _LOG_PATH_UNRESOLVED
   745	    return default_dir / "audit-log.jsonl"
