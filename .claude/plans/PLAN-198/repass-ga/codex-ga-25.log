   687	class _ContractParser(argparse.ArgumentParser):
   688	    """argparse, except that under strict an argument error is a named rc 3."""
   689	
   690	    strict_json: Optional[bool] = None  # None: not strict, stock behaviour
   691	
   692	    def error(self, message: str) -> Any:
   693	        if self.strict_json is None:
   694	            super().error(message)
   695	        raise SystemExit(
   696	            _strict_emit(
   697	                _StrictFailure(
   698	                    EXIT_MALFORMED, STATUS_MALFORMED,
   699	                    "invalid_arguments: " + message,
   700	                ),
   701	                self.strict_json,
   702	            )
   703	        )
