   630	def _main_strict(args: argparse.Namespace) -> int:
   631	    """The --strict-against-counter contract of the module docstring."""
   632	    try:
   633	        log_path = _resolve_log_path(args)
   634	        if log_path is _LOG_PATH_UNRESOLVED:
   635	            raise _StrictFailure(
   636	                EXIT_MALFORMED, STATUS_MALFORMED,
   637	                "log_unresolved: cannot resolve default audit-log path; pass --log-file",
   638	            )
   639	        key = _read_key_strict(args.key_file)
   640	        expected, source = _expected_length_strict(args.counter_override)
   641	        stream = _open_log_strict(log_path)
   642	        try:
   643	            return verify(
   644	                enumerate(stream, start=1),
   645	                key,
   646	                since=args.since,
   647	                json_output=args.json,
   648	                verbose=args.verbose,
   649	                log_dir=log_path.parent if log_path is not None else None,
   650	                strict_against_counter=True,
   651	                counter_override=expected,
   652	                chain_length_source=source,
   653	            )
   654	        finally:
   655	            stream.close()
   656	    except _StrictFailure as failure:
   657	        return _strict_emit(failure, args.json)
   658	    except UnicodeError as e:
   659	        return _strict_emit(
   660	            _StrictFailure(
   661	                EXIT_MALFORMED, STATUS_MALFORMED,
   662	                "log_undecodable: {t}: {e}".format(t=type(e).__name__, e=str(e)[:200]),
   663	            ),
   664	            args.json,
   665	        )
   666	    except Exception as e:  # the CLI's boundary: named and fail-closed, no traceback
   667	        return _strict_emit(
   668	            _StrictFailure(
   669	                EXIT_MALFORMED, STATUS_MALFORMED,
   670	                "internal_error: {t}: {e}".format(t=type(e).__name__, e=str(e)[:200]),
   671	            ),
   672	            args.json,
   673	        )
