   573	def _expected_length_strict(counter_override: Optional[int]) -> Tuple[int, str]:
   574	    """``(expected length, source)``. Unlike ``audit_hmac.read_chain_length``, an
   575	    illegible counter is an error (S363-4): only real absence is allowed through."""
   576	    if counter_override is not None:
   577	        return counter_override, "override"
   578	    path = audit_hmac.chain_length_path()
   579	    try:
   580	        os.lstat(str(path))
   581	    except FileNotFoundError:
   582	        return 0, "absent"
   583	    except OSError as e:
   584	        raise _StrictFailure(
   585	            EXIT_MALFORMED, STATUS_MALFORMED,
   586	            "chain_length_unreadable: cannot stat {p}: {e}".format(p=path, e=e),
   587	        ) from e
   588	    with _open_regular_strict(path, "counter", "chain_length_unreadable") as stream:
   589	        raw = stream.read(64)
   590	    text = raw.decode("ascii", "replace").strip(" \t\r\n")
   591	    if _COUNTER_RE.fullmatch(text) is None:
   592	        raise _StrictFailure(
   593	            EXIT_MALFORMED, STATUS_MALFORMED,
   594	            "chain_length_unreadable: {p} does not hold a plain decimal count".format(p=path),
   595	        )
   596	    return int(text), "sidecar"
