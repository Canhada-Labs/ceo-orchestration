   820	        description="Verify the HMAC chain in audit-log.jsonl.",
   821	        epilog="Exit 0=intact, 1=tamper, 2=key missing, 3=malformed, 4=perm.",
   822	    )
   823	    if strict:
   824	        parser.strict_json = strict_json
   825	    args = _add_arguments(parser).parse_args(args_in)
   826	    if args.strict_against_counter:
   827	        return _main_strict(args)
   828	
   829	    # Resolve log path.
   830	    log_path = _resolve_log_path(args)
   831	    if log_path is _LOG_PATH_UNRESOLVED:
   832	        _err("error: cannot resolve default audit-log path; "
   833	             "pass --log-file")
   834	        return EXIT_MALFORMED
   835	
   836	    # Read key.
   837	    try:
