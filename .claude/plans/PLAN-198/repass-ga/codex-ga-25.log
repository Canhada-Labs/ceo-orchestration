   599	def _read_key_strict(key_file: Optional[Path]) -> bytes:
   600	    """:func:`_read_key` with its exits and OS errors mapped to named failures."""
   601	    try:
   602	        return _read_key(key_file)
   603	    except SystemExit as e:
   604	        if e.code == EXIT_KEY_MISSING:
   605	            raise _StrictFailure(EXIT_KEY_MISSING, STATUS_KEY_MISSING, "key_missing") from e
   606	        raise _StrictFailure(EXIT_PERM, STATUS_PERM_ERROR, "key_unusable") from e
   607	    except OSError as e:
   608	        raise _StrictFailure(
   609	            EXIT_PERM, STATUS_PERM_ERROR, "key_unusable: {e}".format(e=e)
   610	        ) from e
