   807	def main(argv: Optional[List[str]] = None) -> int:
   808	    """CLI entrypoint — verify an audit-log HMAC chain end-to-end."""
   809	    args_in = list(sys.argv[1:] if argv is None else argv)
   810	    strict, strict_json, raw_override = _strict_prescan(args_in)
   811	    if strict and raw_override is not None and _COUNTER_RE.fullmatch(raw_override) is None:
   812	        return _strict_emit(
   813	            _StrictFailure(
   814	                EXIT_MALFORMED, STATUS_MALFORMED,
   815	                "counter_override_invalid: expected plain decimal digits",
   816	            ),
   817	            strict_json,
   818	        )
