   123	def _load_private_terms(repo_root: Path) -> List[str]:
   124	    """Extra regex alternatives declared by the repo being scanned.
   125	
   126	    Returns [] when the file is absent (normal in an adopter checkout).
   127	    Propagates OSError when the file exists but cannot be read.
   128	    """
   129	    path = repo_root / _PRIVATE_TERMS_RELPATH
   130	    # Only real ABSENCE means "no private terms". `is_file()` also said False for a
   131	    # dangling link and a directory, which dropped the whole term list in silence.
   132	    if not os.path.lexists(path):
   133	        return []
   134	    if not stat.S_ISREG(os.stat(path).st_mode):  # a FIFO would block the read below
   135	        raise OSError(errno.EINVAL, "not a regular file")
   136	    terms: List[str] = []
   137	    for raw in path.read_text(encoding="utf-8").splitlines():
   138	        line = raw.strip()
   139	        if not line or line.startswith("#"):
   140	            continue
   141	        terms.append(line)
   142	    return terms
