   145	def build_pattern(repo_root: Path) -> "re.Pattern":
   146	    """Placeholder terms plus any private terms declared by this repo.
   147	
   148	    There is deliberately NO module-level constant holding the full
   149	    pattern: a name that silently omits the private half is the exact
   150	    false-green shape this indirection exists to remove.
   151	    """
   152	    alts = list(_PLACEHOLDER_TERMS) + _load_private_terms(repo_root)
   153	    return re.compile("|".join(alts))
