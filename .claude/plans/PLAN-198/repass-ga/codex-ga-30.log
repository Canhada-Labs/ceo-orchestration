   117	    def is_allowlisted(self, path: Path) -> bool:
   118	        """Return True if `path` matches any allowlist style.
   119	
   120	        Supports:
   121	        - exact relative path match
   122	        - glob against relative path (fnmatch)
   123	        - substring token anywhere in the absolute path string
