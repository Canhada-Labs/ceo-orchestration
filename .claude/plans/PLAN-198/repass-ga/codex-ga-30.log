   111	# Absent file => placeholder-only pattern, silently (the expected adopter
   112	# state is not an infrastructure failure). A file that EXISTS but cannot
   113	# be read is an INPUT failure and is surfaced as fatal by main().
   114	_PLACEHOLDER_TERMS = (
