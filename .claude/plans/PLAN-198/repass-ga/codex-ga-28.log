   128	# Action names accepted by the registry: lowercase snake_case (with
   129	# optional hyphens for grandfathered names like ``codex-reply``),
   130	# leading letter, no digits at start. Enforced case-sensitivity —
   131	# ``Emit_Foo`` or ``emit_FOO`` are NOT valid.
   132	# PLAN-091 v1.22.1 (S115 2026-05-13) — allow hyphen for `codex-reply`
   133	# legacy name from PLAN-086 Wave C; net-new actions should still
   134	# prefer snake_case per the rest of the canonical action surface.
   135	_ACTION_NAME_RE = re.compile(r"^[a-z][a-z0-9_\-]*$")
