     1	#!/usr/bin/env python3
     2	"""Validate ceo-restore archive members and extract the accepted ones.
     3	
     4	``<tarball>`` checks every member (exit 2 on the first refused one);
     5	``<tarball> <stage-dir>`` also writes ONLY the accepted members there, so the
     6	preview and the apply of ceo-restore.sh share one rule and one extraction.
     7	
     8	The archive must parse to its end: tarfile stops listing members, with no
     9	error, at a truncated or invalid header, so the member list must end on an
    10	end-of-archive (all-zero) block and the compressed stream must read cleanly
    11	to its end.  Two members with the same name are refused, and so are the key
    12	files ``audit/audit-key`` and ``audit/.salt`` in any letter case (the default
    13	macOS disk, APFS, ignores case).  Every sparse member is refused, an
    14	AppleDouble one included, before anything is written.
    15	
    16	macOS tar writes an AppleDouble member ``._<name>`` (extended-attribute
    17	metadata) before each entry that carries extended attributes.  It is SKIPPED
    18	-- checked, never written -- only when it is a regular file whose companion
    19	(same directory, basename without ``._``; the companion of ``._.`` is the
    20	directory itself) is an accepted member.  Every other ``._`` member is refused.
    21	"""
    22	from __future__ import annotations
    23	
    24	import os
    25	import shutil
    26	import sys
    27	import tarfile
    28	import zlib
    29	from typing import Iterable, List, Optional, Tuple
    30	
    31	_APPLEDOUBLE_PREFIX = "._"
    32	_KEY_FILES = ("audit/audit-key", "audit/.salt")
    33	_CHUNK = 1 << 16
    34	
    35	
    36	def _normalized(name: str) -> str:
    37	    """Return an archive-relative name or raise for an alias/traversal."""
    38	    if name == ".":
    39	        return ""
    40	    if name.startswith("./"):
    41	        name = name[2:]
    42	    if not name or name.startswith("/") or "//" in name:
    43	        raise ValueError("unsafe path")
    44	    parts = name.split("/")
    45	    if any(part in ("", ".", "..") for part in parts):
    46	        raise ValueError("unsafe path")
    47	    return name.rstrip("/")
    48	
    49	
    50	def _allowed(name: str) -> bool:
    51	    if name in ("agent-metrics.md", "MANIFEST.txt"):
    52	        return True
    53	    return name in ("audit", "memory", "plans") or any(
    54	        name.startswith(prefix) for prefix in ("audit/", "memory/", "plans/")
    55	    )
    56	
    57	
    58	def _appledouble_companion(name: str) -> Optional[str]:
    59	    """Return the companion of an AppleDouble name, None for any other name.
    60	
    61	    Raises ValueError when the basename carries the prefix but cannot name a
    62	    companion (``._`` alone, ``._..``).
    63	    """
    64	    head, _, base = name.rpartition("/")
    65	    if not base.startswith(_APPLEDOUBLE_PREFIX):
    66	        return None
    67	    target = base[len(_APPLEDOUBLE_PREFIX):]
    68	    if target == ".":
    69	        return head
    70	    if target in ("", ".."):
    71	        raise ValueError("no companion")
    72	    return head + "/" + target if head else target
    73	
    74	
    75	def validate(members: Iterable[tarfile.TarInfo]) -> List[tarfile.TarInfo]:
    76	    """Reject every non-data member and every name outside the restore layout.
    77	
    78	    Returns the members to extract, in archive order.  AppleDouble members
    79	    that pass the companion rule are left out of the result.
    80	    """
    81	    accepted: List[tarfile.TarInfo] = []
    82	    accepted_names = set()
    83	    seen = set()
    84	    appledouble: List[Tuple[tarfile.TarInfo, str]] = []
    85	    for member in members:
    86	        try:
    87	            name = _normalized(member.name)
    88	        except ValueError:
    89	            raise ValueError("refused path: {0}".format(member.name))
    90	        if name in seen:
    91	            raise ValueError("refused duplicate path: {0}".format(member.name))
    92	        seen.add(name)
    93	        if member.issparse():
    94	            raise ValueError("refused sparse member: {0}".format(member.name))
    95	        try:
    96	            companion = _appledouble_companion(name) if name else None
    97	        except ValueError:
    98	            raise ValueError("refused AppleDouble name: {0}".format(member.name))
    99	        if companion is not None:
   100	            if not member.isfile():
   101	                raise ValueError("refused member type: {0}".format(member.name))
   102	            appledouble.append((member, companion))
   103	            continue
   104	        if not name:
   105	            if member.isdir():
   106	                accepted.append(member)
   107	                accepted_names.add(name)
   108	                continue
   109	            raise ValueError("refused member type: {0}".format(member.name))
   110	        if not _allowed(name):
   111	            raise ValueError("refused path: {0}".format(member.name))
   112	        if not (member.isfile() or member.isdir()):
   113	            raise ValueError("refused member type: {0}".format(member.name))
   114	        if name.casefold() in _KEY_FILES:
   115	            raise ValueError("refused path: {0}".format(member.name))
   116	        accepted.append(member)
   117	        accepted_names.add(name)
   118	    for member, companion in appledouble:
   119	        if companion not in accepted_names:
   120	            raise ValueError("refused path: {0}".format(member.name))
   121	    return accepted
   122	
   123	
   124	def complete_members(archive: tarfile.TarFile) -> List[tarfile.TarInfo]:
   125	    """Return every member, or raise unless the archive parsed to its end.
   126	
   127	    The member walk must stop on a full all-zero block (the end-of-archive
   128	    marker) and the rest of the compressed stream must decompress with a
   129	    valid checksum; otherwise members after the cut would vanish silently.
   130	    """
   131	    stream = archive.fileobj
   132	    try:
   133	        members = archive.getmembers()
   134	        stream.seek(archive.offset)
   135	        block = stream.read(tarfile.BLOCKSIZE)
   136	        while stream.read(_CHUNK):
   137	            pass
   138	    except (EOFError, OSError, tarfile.ReadError, zlib.error) as exc:
   139	        raise ValueError("refused truncated or corrupt archive: {0}".format(exc))
   140	    if len(block) != tarfile.BLOCKSIZE or block.count(b"\0") != tarfile.BLOCKSIZE:
   141	        raise ValueError("refused truncated or corrupt archive: no end-of-archive "
   142	                         "block at byte {0}".format(archive.offset))
   143	    return members
   144	
   145	
   146	def extract(archive: tarfile.TarFile, members: Iterable[tarfile.TarInfo],
   147	            stage: str) -> None:
   148	    """Write the given (already validated) members under ``stage``."""
   149	    nofollow = getattr(os, "O_NOFOLLOW", 0)
   150	    for member in members:
   151	        name = _normalized(member.name)
   152	        if not name:
   153	            continue
   154	        path = os.path.join(stage, *name.split("/"))
   155	        if member.isdir():
   156	            os.makedirs(path, exist_ok=True)
   157	            continue
   158	        parent = os.path.dirname(path)
   159	        if parent:
   160	            os.makedirs(parent, exist_ok=True)
   161	        source = archive.extractfile(member)
   162	        if source is None:
   163	            raise ValueError("refused member type: {0}".format(member.name))
   164	        # O_EXCL: a name that lands on a file already written (two members
   165	        # whose names differ only in letter case, on the default macOS disk,
   166	        # APFS) is refused, never merged into the earlier file with the
   167	        # earlier mode.
   168	        try:
   169	            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | nofollow,
   170	                         member.mode & 0o777)
   171	        except FileExistsError:
   172	            source.close()
   173	            raise ValueError("refused duplicate path: {0}".format(member.name))
   174	        with os.fdopen(fd, "wb") as target, source:
   175	            shutil.copyfileobj(source, target)
   176	        os.utime(path, (member.mtime, member.mtime))
   177	
   178	
   179	def main(argv: List[str]) -> int:
   180	    if len(argv) not in (2, 3):
   181	        print("usage: _restore_archive.py <tarball> [<stage-dir>]", file=sys.stderr)
   182	        return 2
   183	    stage = argv[2] if len(argv) == 3 else None
   184	    if stage is not None and (os.path.islink(stage) or not os.path.isdir(stage)):
   185	        print("fatal: stage must be a real directory", file=sys.stderr)
   186	        return 2
   187	    try:
   188	        with tarfile.open(argv[1], "r:gz") as archive:
   189	            members = validate(complete_members(archive))
   190	            if stage is not None:
   191	                extract(archive, members, stage)
   192	    except (EOFError, OSError, OverflowError, tarfile.TarError, ValueError,
   193	            zlib.error) as exc:
   194	        print("fatal: archive {0}".format(exc), file=sys.stderr)
   195	        return 2
   196	    return 0
   197	
   198	
   199	if __name__ == "__main__":
   200	    raise SystemExit(main(sys.argv))

