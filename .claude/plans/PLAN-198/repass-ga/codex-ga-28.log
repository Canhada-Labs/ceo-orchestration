"""Implementation declarations for the transcript-cost compatibility facade.

Templates remain immutable: independent facade imports never share mutable
tables or function-global namespaces, even when loaded with import-by-path.
"""
from __future__ import annotations

from copy import deepcopy
from importlib import import_module
from types import FunctionType
from typing import Any, Dict, Tuple


def _bind(function: FunctionType, namespace: Dict[str, Any]) -> FunctionType:
    bound = FunctionType(
        function.__code__, namespace, function.__name__,
        function.__defaults__, function.__closure__,
    )
    bound.__kwdefaults__ = deepcopy(function.__kwdefaults__)
    bound.__annotations__ = dict(function.__annotations__)
    bound.__dict__.update(function.__dict__)
    bound.__qualname__ = function.__qualname__
    bound.__module__ = namespace["__name__"]
    return bound


def install(namespace: Dict[str, Any], modules: Tuple[str, ...]) -> None:
    """Export private/public declarations into this facade's live globals."""
    declarations: Dict[str, Any] = {}
    for name in modules:
        module = import_module("{}.{}".format(__name__, name))
        namespace.setdefault("__annotations__", {}).update(
            getattr(module, "__annotations__", {})
        )
        declarations.update({
            key: value for key, value in vars(module).items()
            if not key.startswith("__") and key not in (
                "argparse", "glob", "json", "os", "re", "sys", "time",
                "dataclass", "field", "datetime", "timedelta", "timezone",
                "Path", "Any", "Dict", "List", "Optional", "Tuple",
            )
        })

    namespace.update(deepcopy(declarations))
    for name, original in declarations.items():
        if isinstance(original, FunctionType):
            namespace[name] = _bind(original, namespace)
        elif isinstance(original, type) and original.__module__.startswith(__name__):
            attributes = {
                key: value for key, value in vars(original).items()
                if key not in ("__dict__", "__weakref__")
            }
            bound_class = type(original.__name__, original.__bases__, attributes)
            for method_name, method in vars(bound_class).items():
                if isinstance(method, FunctionType) and method.__module__ == original.__module__:
                    setattr(bound_class, method_name, _bind(method, namespace))
            bound_class.__module__ = namespace["__name__"]
            namespace[name] = bound_class
"""Ordered ceo-boot declarations for the public script facade.

Each part is ordinary Python source. The loader compiles it with its real
filename and executes it in the facade dictionary, retaining legacy global
lookup and monkeypatch behavior without proxies.
"""
from __future__ import annotations

from pathlib import Path
from typing import Any, Dict, Tuple

_PARTS: Tuple[str, ...] = (
    "state_plan_audit", "harness_governance", "model_persona",
    "persona_confidence", "liveness_schedule", "scheduled_cache",
    "cache_recommendations", "telemetry_candidates", "candidates_lessons",
    "lessons_cli",
)


def install(namespace: Dict[str, Any]) -> None:
    """Execute real declaration files in their original dependency order."""
    directory = Path(__file__).resolve().parent
    for name in _PARTS:
        path = directory / (name + ".py")
        code = compile(path.read_text(encoding="utf-8"), str(path), "exec")
        exec(code, namespace)
