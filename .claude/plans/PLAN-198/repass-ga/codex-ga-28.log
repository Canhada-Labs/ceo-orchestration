   141	
   142	
   143	class CallSite:
   144	    """One ``emit_<name>(...)`` call site discovered by AST walk."""
   145	
   146	    __slots__ = ("name", "file", "line")
   147	
   148	    def __init__(self, name: str, file: Path, line: int) -> None:
   149	        self.name = name
   150	        self.file = file
   151	        self.line = line
   152	
   153	    def ref(self, repo_root: Path) -> str:
   154	        try:
   155	            rel = self.file.relative_to(repo_root)
   156	        except ValueError:
   157	            rel = self.file
   158	        return f"{rel}:{self.line}"
   159	
   160	
   161	class FunctionDef(CallSite):
   162	    """One typed emitter, retaining its actual source for drift diagnostics."""
   163	
   164	    __slots__ = ()
   165	
   166	    def __init__(self, name: str, line: int, file: Path = AUDIT_EMIT_REL) -> None:
   167	        super().__init__(name, file, line)
   168	
   169	
   170	# ---------------------------------------------------------------------------
   171	# Extractors — code side
   172	# ---------------------------------------------------------------------------
   173	
   174	
   175	def _parse_emitter_source(path: Path) -> ast.Module:
   176	    """Read declarations without importing code or suppressing broken parts."""
   177	    try:
   178	        return ast.parse(path.read_text(encoding="utf-8"), filename=str(path))
   179	    except SyntaxError as exc:
   180	        raise RuntimeError(
   181	            f"{path.name} parse error at line {exc.lineno}: {exc.msg}"
   182	        ) from exc
   183	    except (OSError, UnicodeError) as exc:
   184	        raise RuntimeError(f"{path.name} unreadable: {exc}") from exc
   185	
   186	
   187	def _emitter_definitions(tree: ast.AST, path: Path) -> List[FunctionDef]:
   188	    definitions = []
   189	    for node in ast.walk(tree):
   190	        if isinstance(node, ast.FunctionDef) and node.name.startswith("emit_"):
   191	            action = node.name[len("emit_"):]
   192	            if _ACTION_NAME_RE.match(action):
   193	                definitions.append(FunctionDef(action, node.lineno, path))
   194	    return definitions
   195	
   196	
   197	def extract_known_actions(audit_emit_path: Path) -> Tuple[Set[str], List[FunctionDef]]:
   198	    """Read the literal facade registry and emitter definitions across its parts."""
   199	    tree = _parse_emitter_source(audit_emit_path)
   200	    known: Optional[Set[str]] = None
   201	    emit_defs = _emitter_definitions(tree, audit_emit_path)
   202	
   203	    for node in ast.walk(tree):
   204	        # _KNOWN_ACTIONS = {...}  — single-target Assign to a Set literal
   205	        if isinstance(node, ast.Assign) and len(node.targets) == 1:
   206	            target = node.targets[0]
   207	            if isinstance(target, ast.Name) and target.id == "_KNOWN_ACTIONS":
   208	                value = node.value
   209	                if not isinstance(value, ast.Set):
   210	                    raise RuntimeError(
   211	                        f"_KNOWN_ACTIONS at line {node.lineno} is not a set literal "
   212	                        f"(found {type(value).__name__})"
   213	                    )
   214	                collected: Set[str] = set()
   215	                for elt in value.elts:
   216	                    if isinstance(elt, ast.Constant) and isinstance(elt.value, str):
   217	                        collected.add(elt.value)
   218	                    else:
   219	                        raise RuntimeError(
   220	                            f"_KNOWN_ACTIONS at line {node.lineno} contains non-str "
   221	                            f"element: {ast.dump(elt)}"
   222	                        )
   223	                known = collected
   224	
   225	    if known is None:
   226	        raise RuntimeError(
   227	            "_KNOWN_ACTIONS set literal not found in audit_emit.py"
   228	        )
   229	    parts = audit_emit_path.parent / "_audit_emit_parts"
   230	    if parts.is_dir():
   231	        for path in sorted(parts.glob("*.py")):
   232	            emit_defs.extend(_emitter_definitions(_parse_emitter_source(path), path))
   233	    return known, emit_defs
   234	
   235	
   236	# ---------------------------------------------------------------------------
   237	# Extractors — schema side
   238	# ---------------------------------------------------------------------------
   239	
   240	
   241	def extract_schema_actions(schema_path: Path) -> Set[str]:
   242	    """Return set of action names in the Required-fields table."""
   243	    try:
   244	        text = schema_path.read_text(encoding="utf-8")
   245	    except OSError as exc:
   246	        raise RuntimeError(f"schema unreadable: {exc}") from exc
   247	
   248	    actions: Set[str] = set()
   249	    in_table = False
   250	    header_marker = "Required fields per v2 action"

