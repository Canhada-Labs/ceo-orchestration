-    if not spelled or "{" not in spelled:
-        return ""
-    matched, undecidable = _e4_brace_names_toggle(spelled)
-    if matched:
-        return _E4_BRACE_NOTE
-    if undecidable:
-        return _E4_BRACE_BUDGET_NOTE
-    return ""
