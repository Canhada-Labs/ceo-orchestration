   588	def _to_contract_decision(
   589	    d: "Decision",
   590	    tool_input: "Optional[Dict]" = None,
   591	) -> _contract.Decision:
   592	    """Translate local Decision → adapter-layer contract.Decision.
   593	
   594	    PLAN-135 W2 H5: when the Decision carries a :class:`Rewrite`, build the
   595	    Claude Code PreToolUse `ask` + `updatedInput` vendor shape via the
   596	    neutral contract `extra` channel (the claude adapter merges `extra`
   597	    into the top-level JSON). The output is:
   598	
   599	        {"hookSpecificOutput": {
   600	            "hookEventName": "PreToolUse",
   601	            "permissionDecision": "ask",
   602	            "permissionDecisionReason": "<names the rewrite>",
   603	            "updatedInput": {<original tool_input>, "command": "<rewritten>"}
   604	        }}
   605	
   606	    The ORIGINAL tool_input keys are preserved and only `command` is
   607	    overridden (constraint (c) — we change the command, nothing else). If
   608	    `tool_input` is not a dict, `updatedInput` carries just the rewritten
   609	    command (the executor reads `command`).
   610	    """
   611	    if d.rewrite is not None:
   612	        rw = d.rewrite
   613	        updated_input: Dict[str, object] = {}
   614	        if isinstance(tool_input, dict):
   615	            updated_input.update(tool_input)
   616	        updated_input["command"] = rw.new_command
   617	        dec = _contract.allow()
   618	        dec.extra["hookSpecificOutput"] = {
   619	            "hookEventName": "PreToolUse",
   620	            "permissionDecision": "ask",
   621	            "permissionDecisionReason": rw.reason,
   622	            "updatedInput": updated_input,
   623	        }
   624	        return dec
   625	    if d.allow:
   626	        return _contract.allow()
   627	    return _contract.block(d.reason or "")
