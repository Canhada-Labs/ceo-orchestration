-        # after the script expr (chaining-safe; not global tokens[-1]).
-        if cmd == "sed" and i + 1 < n and _E3_SED_INPLACE_RE.match(tokens[i + 1]):
-            seg = _e3_segment_positionals(tokens, i + 1)
