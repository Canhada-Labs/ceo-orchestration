{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y6JDkx2wC2sXGXLUNojFiB","type":"tool_result","content":"560\t    to add. Here the fleet is READ from the signed\n561\t    authority — ADR-149 ``AVAILABLE_MODELS_WORKING_SET``, through the same\n562\t    parser the model-currency gate uses — so the NEXT working-set append\n563\t    fails this test until every rollup surface prices it at the\n564\t    cost-table.yaml rate.\n565\t    \"\"\"\n566\t\n567\t    #: (script, table attribute, input key, output key, factor to per-MTok)\n568\t    _SURFACES = (\n569\t        (\"audit-telemetry.py\", \"_PRICING_PER_MTOK\", \"input\", \"output\", 1.0),\n570\t        (\"ceo-cost.py\", \"_DEFAULT_PRICING\", \"input_per_mtok\", \"output_per_mtok\", 1.0),\n571\t        (\"budget-summary.py\", \"_DEFAULT_PRICING\", \"in\", \"out\", 1000.0),\n572\t        (\"success-receipt.py\", \"_DEFAULT_PRICING\", \"in\", \"out\", 1000.0),\n573\t        (\"value-dashboard.py\", \"_DEFAULT_PRICING\", \"in\", \"out\", 1000.0),\n574\t        (\"ceo-cost-transcripts.py\", \"_EMBEDDED_PRICING\", \"input_per_mtok\",\n575\t         \"output_per_mtok\", 1.0),\n576\t    )\n577\t\n578\t    @classmethod\n579\t    def setUpClass(cls):\n580\t        super().setUpClass()\n581\t        currency = _load_registered(\n582\t            \"fleet_ws_currency\", \"check-model-currency.py\")\n583\t        cls.working_set = list(\n584\t            currency.read_adr_blocks(_ADR_149)[\"AVAILABLE_MODELS_WORKING_SET\"])\n585\t        cls.cct = _load_registered(\n586\t            \"fleet_ws_transcripts\", \"ceo-cost-transcripts.py\")\n587\t        cls.cost_table = cls.cct._parse_cost_table_yaml(\n588\t            _COST_TABLE.read_text(encoding=\"utf-8\"))\n589\t        cls.tables = {}\n590\t        for idx, (script, attr, k_in, k_out, factor) in enumerate(cls._SURFACES):\n591\t            if script == \"ceo-cost-transcripts.py\":\n592\t                mod = cls.cct\n593\t            else:\n594\t                mod = _load_registered(\"fleet_ws_surface_%d\" % idx, script)\n595\t            cls.tables[script] = (getattr(mod, attr), k_in, k_out, factor)\n596\t\n597\t    def test_working_set_read_from_the_adr(self) -> None:\n598\t        \"\"\"Non-vacuity: the fleet came from the ADR, and this pack's id is\n599\t        in it (the ADR append and these price rows land together).\"\"\"\n600\t        self.assertGreaterEqual(len(self.working_set), 8)\n601\t        self.assertIn(\"claude-opus-5-5\", self.working_set)\n602\t\n603\t    def test_every_working_set_id_priced_on_every_surface(self) -> None:\n604\t        for model in self.working_set:\n605\t            ref = self.cost_table.get(model)\n606\t            self.assertIsNotNone(ref, \"%s has no cost-table.yaml row\" % model)\n607\t            for script, (table, k_in, k_out, factor) in self.tables.items():\n608\t                with self.subTest(model=model, surface=script):\n609\t                    row = table.get(model)\n610\t                    self.assertIsNotNone(\n611\t                        row, \"%s missing from %s — prices at $0/TBD\" % (model, script))\n612\t                    self.assertAlmostEqual(\n613\t                        row[k_in] * factor, ref[\"input_per_mtok\"], places=6,\n614\t                        msg=\"%s input rate on %s\" % (model, script))\n615\t                    self.assertAlmostEqual(\n616\t                        row[k_out] * factor, ref[\"output_per_mtok\"], places=6,\n617\t                        msg=\"%s output rate on %s\" % (model, script))\n618\t\n619\t\n620\tclass TestCacheReadMultiplierMirror(TestEnvContext):\n621\t    \"\"\"ADR-149 Amendment 3 (S357): the per-model cache-read rate is now a\n622\t    CLASS (Fable 5.1 0.025x, then Opus 5.5 0.05x) that lives in TWO scripts.\n623\t    ceo-cost-transcripts.py declares it \"mirrors budget-summary.py's\n624\t    _CACHE_READ_MULTIPLIER_OVERRIDES exactly\" — this makes that mechanical.\n625\t    \"\"\"\n626\t\n627\t    @classmethod\n628\t    def setUpClass(cls):\n629\t        super().setUpClass()\n630\t        cls.bs = _load_hyphenated(\"budget_summary_cache_mirror\", \"budget-summary.py\")\n631\t        cls.cct = _load_registered(\n632\t            \"transcripts_cache_mirror\", \"ceo-cost-transcripts.py\")\n633\t\n634\t    def test_transcripts_mirror_budget_summary_exactly(self) -> None:\n635\t        self.assertEqual(self.cct._CACHE_READ_MULTIPLIER_OVERRIDES,\n636\t                         self.bs._CACHE_READ_MULTIPLIER_OVERRIDES)\n637\t        self.assertEqual(self.cct._CACHE_READ_MULTIPLIER_DEFAULT,\n638\t                         self.bs._CACHE_READ_MULTIPLIER_DEFAULT)\n639\t\n640\t    def test_opus55_is_005_on_both(self) -> None:\n641\t        for mod in (self.bs, self.cct):\n642\t            self.assertAlmostEqual(mod._cache_read_multiplier(\"claude-opus-5-5\"), 0.05)\n643\t            self.assertAlmostEqual(mod._cache_read_multiplier(\"claude-opus-5\"), 0.10)\n644\t\n645\t    def test_every_override_is_a_priced_id(self) -> None:\n646\t        for model in self.bs._CACHE_READ_MULTIPLIER_OVERRIDES:\n647\t            self.assertIn(model, self.bs._DEFAULT_PRICING)\n648\t            self.assertIn(model, self.cct._EMBEDDED_PRICING)\n649\t"}]},"parent_tool_use_id":null,"session_id":"261e4768-bfba-44df-8655-b8fb9a3eb93f","uuid":"dd8e12fb-3e95-4c85-af74-ecfc71de9c3b","timestamp":"2026-11-16T19:46:57.582Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/tests/test_model_fleet_presence.py","content":"    to add. Here the fleet is READ from the signed\n    authority — ADR-149 ``AVAILABLE_MODELS_WORKING_SET``, through the same\n    parser the model-currency gate uses — so the NEXT working-set append\n    fails this test until every rollup surface prices it at the\n    cost-table.yaml rate.\n    \"\"\"\n\n    #: (script, table attribute, input key, output key, factor to per-MTok)\n    _SURFACES = (\n        (\"audit-telemetry.py\", \"_PRICING_PER_MTOK\", \"input\", \"output\", 1.0),\n        (\"ceo-cost.py\", \"_DEFAULT_PRICING\", \"input_per_mtok\", \"output_per_mtok\", 1.0),\n        (\"budget-summary.py\", \"_DEFAULT_PRICING\", \"in\", \"out\", 1000.0),\n        (\"success-receipt.py\", \"_DEFAULT_PRICING\", \"in\", \"out\", 1000.0),\n        (\"value-dashboard.py\", \"_DEFAULT_PRICING\", \"in\", \"out\", 1000.0),\n        (\"ceo-cost-transcripts.py\", \"_EMBEDDED_PRICING\", \"input_per_mtok\",\n         \"output_per_mtok\", 1.0),\n    )\n\n    @classmethod\n    def setUpClass(cls):\n        super().setUpClass()\n        currency = _load_registered(\n            \"fleet_ws_currency\", \"check-model-currency.py\")\n        cls.working_set = list(\n            currency.read_adr_blocks(_ADR_149)[\"AVAILABLE_MODELS_WORKING_SET\"])\n        cls.cct = _load_registered(\n            \"fleet_ws_transcripts\", \"ceo-cost-transcripts.py\")\n        cls.cost_table = cls.cct._parse_cost_table_yaml(\n            _COST_TABLE.read_text(encoding=\"utf-8\"))\n        cls.tables = {}\n        for idx, (script, attr, k_in, k_out, factor) in enumerate(cls._SURFACES):\n            if script == \"ceo-cost-transcripts.py\":\n                mod = cls.cct\n            else:\n                mod = _load_registered(\"fleet_ws_surface_%d\" % idx, script)\n            cls.tables[script] = (getattr(mod, attr), k_in, k_out, factor)\n\n    def test_working_set_read_from_the_adr(self) -> None:\n        \"\"\"Non-vacuity: the fleet came from the ADR, and this pack's id is\n        in it (the ADR append and these price rows land together).\"\"\"\n        self.assertGreaterEqual(len(self.working_set), 8)\n        self.assertIn(\"claude-opus-5-5\", self.working_set)\n\n    def test_every_working_set_id_priced_on_every_surface(self) -> None:\n        for model in self.working_set:\n            ref = self.cost_table.get(model)\n            self.assertIsNotNone(ref, \"%s has no cost-table.yaml row\" % model)\n            for script, (table, k_in, k_out, factor) in self.tables.items():\n                with self.subTest(model=model, surface=script):\n                    row = table.get(model)\n                    self.assertIsNotNone(\n                        row, \"%s missing from %s — prices at $0/TBD\" % (model, script))\n                    self.assertAlmostEqual(\n                        row[k_in] * factor, ref[\"input_per_mtok\"], places=6,\n                        msg=\"%s input rate on %s\" % (model, script))\n                    self.assertAlmostEqual(\n                        row[k_out] * factor, ref[\"output_per_mtok\"], places=6,\n                        msg=\"%s output rate on %s\" % (model, script))\n\n\nclass TestCacheReadMultiplierMirror(TestEnvContext):\n    \"\"\"ADR-149 Amendment 3 (S357): the per-model cache-read rate is now a\n    CLASS (Fable 5.1 0.025x, then Opus 5.5 0.05x) that lives in TWO scripts.\n    ceo-cost-transcripts.py declares it \"mirrors budget-summary.py's\n    _CACHE_READ_MULTIPLIER_OVERRIDES exactly\" — this makes that mechanical.\n    \"\"\"\n\n    @classmethod\n    def setUpClass(cls):\n        super().setUpClass()\n        cls.bs = _load_hyphenated(\"budget_summary_cache_mirror\", \"budget-summary.py\")\n        cls.cct = _load_registered(\n            \"transcripts_cache_mirror\", \"ceo-cost-transcripts.py\")\n\n    def test_transcripts_mirror_budget_summary_exactly(self) -> None:\n        self.assertEqual(self.cct._CACHE_READ_MULTIPLIER_OVERRIDES,\n                         self.bs._CACHE_READ_MULTIPLIER_OVERRIDES)\n        self.assertEqual(self.cct._CACHE_READ_MULTIPLIER_DEFAULT,\n                         self.bs._CACHE_READ_MULTIPLIER_DEFAULT)\n\n    def test_opus55_is_005_on_both(self) -> None:\n        for mod in (self.bs, self.cct):\n            self.assertAlmostEqual(mod._cache_read_multiplier(\"claude-opus-5-5\"), 0.05)\n            self.assertAlmostEqual(mod._cache_read_multiplier(\"claude-opus-5\"), 0.10)\n\n    def test_every_override_is_a_priced_id(self) -> None:\n        for model in self.bs._CACHE_READ_MULTIPLIER_OVERRIDES:\n            self.assertIn(model, self.bs._DEFAULT_PRICING)\n            self.assertIn(model, self.cct._EMBEDDED_PRICING)\n","numLines":90,"startLine":560,"totalLines":728}},"tool_result_meta":[{"id":"toolu_01Y6JDkx2wC2sXGXLUNojFiB","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
