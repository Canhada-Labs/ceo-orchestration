{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016o774eAfds5Ftpwq4BxCi8","type":"tool_result","content":"90\t)\n91\t\n92\t\n93\tdef _load_hyphenated(module_name: str, file_name: str):\n94\t    \"\"\"Load a hyphenated-filename script as a module (scripts-tests pattern).\"\"\"\n95\t    spec = importlib.util.spec_from_file_location(\n96\t        module_name, str(_SCRIPTS_DIR / file_name)\n97\t    )\n98\t    mod = importlib.util.module_from_spec(spec)\n99\t    spec.loader.exec_module(mod)\n100\t    return mod\n101\t\n102\t\n103\tdef _load_registered(module_name: str, file_name: str):\n104\t    \"\"\"Like ``_load_hyphenated`` but registers the module in ``sys.modules``\n105\t    BEFORE executing it: ceo-cost-transcripts.py declares dataclasses, which\n106\t    resolve their module through ``sys.modules`` at class-definition time.\n107\t    \"\"\"\n108\t    spec = importlib.util.spec_from_file_location(\n109\t        module_name, str(_SCRIPTS_DIR / file_name)\n110\t    )\n111\t    mod = importlib.util.module_from_spec(spec)\n112\t    sys.modules[module_name] = mod\n113\t    spec.loader.exec_module(mod)\n114\t    return mod\n115\t\n116\t\n117\tclass TestAuditTelemetryFleetPresence(TestEnvContext):\n118\t    \"\"\"`_PRICING_PER_MTOK` (audit-telemetry.py) knows the current fleet.\"\"\"\n119\t\n120\t    @classmethod\n121\t    def setUpClass(cls):\n122\t        super().setUpClass()\n123\t        cls.mod = _load_hyphenated(\"audit_telemetry_fleet\", \"audit-telemetry.py\")\n124\t\n125\t    def test_new_fleet_present(self) -> None:\n126\t        pricing = self.mod._PRICING_PER_MTOK\n127\t        for model in _NEW_FLEET:\n128\t            self.assertIn(\n129\t                model, pricing,\n130\t                \"%s missing from audit-telemetry _PRICING_PER_MTOK \"\n131\t                \"(PLAN-163 T1.5a presence fix)\" % model,\n132\t            )\n133\t\n134\t    def test_new_fleet_rates(self) -> None:\n135\t        pricing = self.mod._PRICING_PER_MTOK\n136\t        expected = {\n137\t            \"claude-opus-4-8\": (5.00, 25.00),\n138\t            \"claude-opus-4-8-fast\": (10.00, 50.00),  # W2 P2b\n139\t            \"claude-fable-5\": (10.00, 50.00),\n140\t            \"claude-fable-5-1\": (10.00, 50.00),  # ADR-149 A2 (S338)\n141\t            \"claude-opus-5\": (5.00, 25.00),\n142\t            \"claude-opus-5-fast\": (10.00, 50.00),\n143\t            \"claude-opus-5-5\": (4.00, 20.00),  # ADR-149 A3 (S357)\n144\t            # Base-row intro rate; the 2026-08-31 flip is event-date-aware\n145\t            # via _DATED_PRICING_PER_MTOK (W2 P2a, asserted below).\n146\t            \"claude-sonnet-5\": (2.00, 10.00),\n147\t        }\n148\t        for model, (inp, out) in expected.items():\n149\t            row = pricing.get(model)"}]},"parent_tool_use_id":null,"session_id":"261e4768-bfba-44df-8655-b8fb9a3eb93f","uuid":"5b709e13-b3dc-4b13-8224-fc08bd8fb743","timestamp":"2026-11-16T19:46:55.425Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/tests/test_model_fleet_presence.py","content":")\n\n\ndef _load_hyphenated(module_name: str, file_name: str):\n    \"\"\"Load a hyphenated-filename script as a module (scripts-tests pattern).\"\"\"\n    spec = importlib.util.spec_from_file_location(\n        module_name, str(_SCRIPTS_DIR / file_name)\n    )\n    mod = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(mod)\n    return mod\n\n\ndef _load_registered(module_name: str, file_name: str):\n    \"\"\"Like ``_load_hyphenated`` but registers the module in ``sys.modules``\n    BEFORE executing it: ceo-cost-transcripts.py declares dataclasses, which\n    resolve their module through ``sys.modules`` at class-definition time.\n    \"\"\"\n    spec = importlib.util.spec_from_file_location(\n        module_name, str(_SCRIPTS_DIR / file_name)\n    )\n    mod = importlib.util.module_from_spec(spec)\n    sys.modules[module_name] = mod\n    spec.loader.exec_module(mod)\n    return mod\n\n\nclass TestAuditTelemetryFleetPresence(TestEnvContext):\n    \"\"\"`_PRICING_PER_MTOK` (audit-telemetry.py) knows the current fleet.\"\"\"\n\n    @classmethod\n    def setUpClass(cls):\n        super().setUpClass()\n        cls.mod = _load_hyphenated(\"audit_telemetry_fleet\", \"audit-telemetry.py\")\n\n    def test_new_fleet_present(self) -> None:\n        pricing = self.mod._PRICING_PER_MTOK\n        for model in _NEW_FLEET:\n            self.assertIn(\n                model, pricing,\n                \"%s missing from audit-telemetry _PRICING_PER_MTOK \"\n                \"(PLAN-163 T1.5a presence fix)\" % model,\n            )\n\n    def test_new_fleet_rates(self) -> None:\n        pricing = self.mod._PRICING_PER_MTOK\n        expected = {\n            \"claude-opus-4-8\": (5.00, 25.00),\n            \"claude-opus-4-8-fast\": (10.00, 50.00),  # W2 P2b\n            \"claude-fable-5\": (10.00, 50.00),\n            \"claude-fable-5-1\": (10.00, 50.00),  # ADR-149 A2 (S338)\n            \"claude-opus-5\": (5.00, 25.00),\n            \"claude-opus-5-fast\": (10.00, 50.00),\n            \"claude-opus-5-5\": (4.00, 20.00),  # ADR-149 A3 (S357)\n            # Base-row intro rate; the 2026-08-31 flip is event-date-aware\n            # via _DATED_PRICING_PER_MTOK (W2 P2a, asserted below).\n            \"claude-sonnet-5\": (2.00, 10.00),\n        }\n        for model, (inp, out) in expected.items():\n            row = pricing.get(model)","numLines":60,"startLine":90,"totalLines":728}},"tool_result_meta":[{"id":"toolu_016o774eAfds5Ftpwq4BxCi8","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
