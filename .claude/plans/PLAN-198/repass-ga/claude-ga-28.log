{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RNzsXXuQtHpbdBxfma916N","type":"tool_result","content":"60\t    executes that call — docstring mentions + comments never parse to\n61\t    ``Call`` nodes.\n62\t  - **Normative function-def coverage**. Every ``def emit_<name>`` in\n63\t    ``audit_emit.py`` or its private parts MUST have ``<name>`` in ``_KNOWN_ACTIONS`` — this\n64\t    cross-check is lightweight and catches copy-paste regressions.\n65\t\n66\tStdlib only. Python 3.9+.\n67\t\"\"\"\n68\t\n69\tfrom __future__ import annotations\n70\t\n71\timport argparse\n72\timport ast\n73\timport os\n74\timport re\n75\timport sys\n76\tfrom pathlib import Path\n77\tfrom typing import Any, Dict, Iterable, List, Optional, Set, Tuple\n78\t\n79\t# ---------------------------------------------------------------------------\n80\t# Constants\n81\t# ---------------------------------------------------------------------------\n82\t\n83\tAUDIT_EMIT_REL = Path(\".claude/hooks/_lib/audit_emit.py\")\n84\tSCHEMA_REL = Path(\"SPEC/v1/audit-log.schema.md\")\n85\t\n86\t# PLAN-133 E8 — checked-in golden inventory of the audit-action registry,\n87\t# generated FROM the typed helpers. ``--write-golden`` (re)writes it;\n88\t# ``--check`` asserts the on-disk file matches the freshly generated one.\n89\tGOLDEN_REL = Path(\".claude/data/audit-registry.golden.txt\")\n90\t\n91\t# Stable header for the generated golden. The version token lets a future\n92\t# format change invalidate stale goldens without a silent false-match.\n93\t_GOLDEN_HEADER = \"# audit-action registry golden (generated — do not hand-edit)\"\n94\t_GOLDEN_FORMAT_LINE = \"# format: v1  source: .claude/hooks/_lib/audit_emit.py::_KNOWN_ACTIONS\"\n95\t_GOLDEN_REGEN_HINT = (\n96\t    \"# regenerate: python3 .claude/scripts/check-audit-registry-coverage.py --write-golden\"\n97\t)\n98\t\n99\t# Directories that are legitimately searched for emit_* call sites.\n100\t# Tests are excluded — they contain fixtures that intentionally use\n101\t# non-registered names, and they never run in production.\n102\tSCAN_DIRS_REL: Tuple[Path, ...] = (\n103\t    Path(\".claude/scripts\"),\n104\t    Path(\".claude/hooks\"),\n105\t)\n106\t\n107\t# Subpath fragments that exclude a file from scan (tests, fixtures).\n108\tEXCLUDE_PATH_FRAGMENTS: Tuple[str, ...] = (\n109\t    \"/tests/\",\n110\t    \"/fixtures/\",\n111\t    \"/__pycache__/\",\n112\t)\n113\t\n114\t# The audit_emit module itself contains every ``def emit_<name>`` and\n115\t# internal ``_write_event`` plumbing — it is the source of truth and is\n116\t# not scanned as a caller. Resolved to absolute at check time.\n117\tEXCLUDE_FILES_REL: Tuple[Path, ...] = (\n118\t    AUDIT_EMIT_REL,\n119\t)\n120\t\n121\t# Match a row in the schema table: ``| `<action_name>` (v2.X) | ...``\n122\t# Lead-column regex only — we tolerate ``(v2)``, ``(v2.1)``, ``(v2.4)`` etc.\n123\t# Action must be lowercase snake_case per convention.\n124\t_SCHEMA_ROW_RE = re.compile(\n125\t    r\"^\\|\\s*`([a-z][a-z0-9_\\-]*)`\\s*(?:\\([^)]+\\))?\\s*\\|\",\n126\t)\n127\t\n128\t# Action names accepted by the registry: lowercase snake_case (with\n129\t# optional hyphens for grandfathered names like ``codex-reply``),\n130\t# leading letter, no digits at start. Enforced case-sensitivity —\n131\t# ``Emit_Foo`` or ``emit_FOO`` are NOT valid.\n132\t# PLAN-091 v1.22.1 (S115 2026-05-13) — allow hyphen for `codex-reply`\n133\t# legacy name from PLAN-086 Wave C; net-new actions should still\n134\t# prefer snake_case per the rest of the canonical action surface.\n135\t_ACTION_NAME_RE = re.compile(r\"^[a-z][a-z0-9_\\-]*$\")\n136\t\n137\t\n138\t# ---------------------------------------------------------------------------\n139\t# Data model\n140\t# ---------------------------------------------------------------------------\n141\t\n142\t\n143\tclass CallSite:\n144\t    \"\"\"One ``emit_<name>(...)`` call site discovered by AST walk.\"\"\"\n145\t\n146\t    __slots__ = (\"name\", \"file\", \"line\")\n147\t\n148\t    def __init__(self, name: str, file: Path, line: int) -> None:\n149\t        self.name = name\n150\t        self.file = file\n151\t        self.line = line\n152\t\n153\t    def ref(self, repo_root: Path) -> str:\n154\t        try:\n155\t            rel = self.file.relative_to(repo_root)\n156\t        except ValueError:\n157\t            rel = self.file\n158\t        return f\"{rel}:{self.line}\"\n159\t\n160\t\n161\tclass FunctionDef(CallSite):\n162\t    \"\"\"One typed emitter, retaining its actual source for drift diagnostics.\"\"\"\n163\t\n164\t    __slots__ = ()\n165\t\n166\t    def __init__(self, name: str, line: int, file: Path = AUDIT_EMIT_REL) -> None:\n167\t        super().__init__(name, file, line)\n168\t\n169\t\n170\t# ---------------------------------------------------------------------------\n171\t# Extractors — code side\n172\t# ---------------------------------------------------------------------------\n173\t\n174\t\n175\tdef _parse_emitter_source(path: Path) -> ast.Module:\n176\t    \"\"\"Read declarations without importing code or suppressing broken parts.\"\"\"\n177\t    try:\n178\t        return ast.parse(path.read_text(encoding=\"utf-8\"), filename=str(path))\n179\t    except SyntaxError as exc:\n180\t        raise RuntimeError(\n181\t            f\"{path.name} parse error at line {exc.lineno}: {exc.msg}\"\n182\t        ) from exc\n183\t    except (OSError, UnicodeError) as exc:\n184\t        raise RuntimeError(f\"{path.name} unreadable: {exc}\") from exc\n185\t\n186\t\n187\tdef _emitter_definitions(tree: ast.AST, path: Path) -> List[FunctionDef]:\n188\t    definitions = []\n189\t    for node in ast.walk(tree):\n190\t        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"emit_\"):\n191\t            action = node.name[len(\"emit_\"):]\n192\t            if _ACTION_NAME_RE.match(action):\n193\t                definitions.append(FunctionDef(action, node.lineno, path))\n194\t    return definitions\n195\t\n196\t\n197\tdef extract_known_actions(audit_emit_path: Path) -> Tuple[Set[str], List[FunctionDef]]:\n198\t    \"\"\"Read the literal facade registry and emitter definitions across its parts.\"\"\"\n199\t    tree = _parse_emitter_source(audit_emit_path)\n200\t    known: Optional[Set[str]] = None\n201\t    emit_defs = _emitter_definitions(tree, audit_emit_path)\n202\t\n203\t    for node in ast.walk(tree):\n204\t        # _KNOWN_ACTIONS = {...}  — single-target Assign to a Set literal\n205\t        if isinstance(node, ast.Assign) and len(node.targets) == 1:\n206\t            target = node.targets[0]\n207\t            if isinstance(target, ast.Name) and target.id == \"_KNOWN_ACTIONS\":\n208\t                value = node.value\n209\t                if not isinstance(value, ast.Set):\n210\t                    raise RuntimeError(\n211\t                        f\"_KNOWN_ACTIONS at line {node.lineno} is not a set literal \"\n212\t                        f\"(found {type(value).__name__})\"\n213\t                    )\n214\t                collected: Set[str] = set()\n215\t                for elt in value.elts:\n216\t                    if isinstance(elt, ast.Constant) and isinstance(elt.value, str):\n217\t                        collected.add(elt.value)\n218\t                    else:\n219\t                        raise RuntimeError(\n220\t                            f\"_KNOWN_ACTIONS at line {node.lineno} contains non-str \"\n221\t                            f\"element: {ast.dump(elt)}\"\n222\t                        )\n223\t                known = collected\n224\t\n225\t    if known is None:\n226\t        raise RuntimeError(\n227\t            \"_KNOWN_ACTIONS set literal not found in audit_emit.py\"\n228\t        )\n229\t    parts = audit_emit_path.parent / \"_audit_emit_parts\"\n230\t    if parts.is_dir():\n231\t        for path in sorted(parts.glob(\"*.py\")):\n232\t            emit_defs.extend(_emitter_definitions(_parse_emitter_source(path), path))\n233\t    return known, emit_defs\n234\t\n235\t\n236\t# ---------------------------------------------------------------------------\n237\t# Extractors — schema side\n238\t# ---------------------------------------------------------------------------\n239\t\n240\t\n241\tdef extract_schema_actions(schema_path: Path) -> Set[str]:\n242\t    \"\"\"Return set of action names in the Required-fields table.\"\"\"\n243\t    try:\n244\t        text = schema_path.read_text(encoding=\"utf-8\")\n245\t    except OSError as exc:\n246\t        raise RuntimeError(f\"schema unreadable: {exc}\") from exc\n247\t\n248\t    actions: Set[str] = set()\n249\t    in_table = False\n250\t    header_marker = \"Required fields per v2 action\"\n251\t\n252\t    for raw in text.splitlines():\n253\t        line = raw.rstrip()\n254\t        if header_marker in line:\n255\t            in_table = True\n256\t            continue\n257\t        if in_table:\n258\t            match = _SCHEMA_ROW_RE.match(line)\n259\t            if match:"}]},"parent_tool_use_id":null,"session_id":"261e4768-bfba-44df-8655-b8fb9a3eb93f","uuid":"b8e8bdf1-5781-466d-9b61-2206d0fbf925","timestamp":"2026-11-16T19:50:53.442Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/check-audit-registry-coverage.py","content":"    executes that call — docstring mentions + comments never parse to\n    ``Call`` nodes.\n  - **Normative function-def coverage**. Every ``def emit_<name>`` in\n    ``audit_emit.py`` or its private parts MUST have ``<name>`` in ``_KNOWN_ACTIONS`` — this\n    cross-check is lightweight and catches copy-paste regressions.\n\nStdlib only. Python 3.9+.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport ast\nimport os\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any, Dict, Iterable, List, Optional, Set, Tuple\n\n# ---------------------------------------------------------------------------\n# Constants\n# ---------------------------------------------------------------------------\n\nAUDIT_EMIT_REL = Path(\".claude/hooks/_lib/audit_emit.py\")\nSCHEMA_REL = Path(\"SPEC/v1/audit-log.schema.md\")\n\n# PLAN-133 E8 — checked-in golden inventory of the audit-action registry,\n# generated FROM the typed helpers. ``--write-golden`` (re)writes it;\n# ``--check`` asserts the on-disk file matches the freshly generated one.\nGOLDEN_REL = Path(\".claude/data/audit-registry.golden.txt\")\n\n# Stable header for the generated golden. The version token lets a future\n# format change invalidate stale goldens without a silent false-match.\n_GOLDEN_HEADER = \"# audit-action registry golden (generated — do not hand-edit)\"\n_GOLDEN_FORMAT_LINE = \"# format: v1  source: .claude/hooks/_lib/audit_emit.py::_KNOWN_ACTIONS\"\n_GOLDEN_REGEN_HINT = (\n    \"# regenerate: python3 .claude/scripts/check-audit-registry-coverage.py --write-golden\"\n)\n\n# Directories that are legitimately searched for emit_* call sites.\n# Tests are excluded — they contain fixtures that intentionally use\n# non-registered names, and they never run in production.\nSCAN_DIRS_REL: Tuple[Path, ...] = (\n    Path(\".claude/scripts\"),\n    Path(\".claude/hooks\"),\n)\n\n# Subpath fragments that exclude a file from scan (tests, fixtures).\nEXCLUDE_PATH_FRAGMENTS: Tuple[str, ...] = (\n    \"/tests/\",\n    \"/fixtures/\",\n    \"/__pycache__/\",\n)\n\n# The audit_emit module itself contains every ``def emit_<name>`` and\n# internal ``_write_event`` plumbing — it is the source of truth and is\n# not scanned as a caller. Resolved to absolute at check time.\nEXCLUDE_FILES_REL: Tuple[Path, ...] = (\n    AUDIT_EMIT_REL,\n)\n\n# Match a row in the schema table: ``| `<action_name>` (v2.X) | ...``\n# Lead-column regex only — we tolerate ``(v2)``, ``(v2.1)``, ``(v2.4)`` etc.\n# Action must be lowercase snake_case per convention.\n_SCHEMA_ROW_RE = re.compile(\n    r\"^\\|\\s*`([a-z][a-z0-9_\\-]*)`\\s*(?:\\([^)]+\\))?\\s*\\|\",\n)\n\n# Action names accepted by the registry: lowercase snake_case (with\n# optional hyphens for grandfathered names like ``codex-reply``),\n# leading letter, no digits at start. Enforced case-sensitivity —\n# ``Emit_Foo`` or ``emit_FOO`` are NOT valid.\n# PLAN-091 v1.22.1 (S115 2026-05-13) — allow hyphen for `codex-reply`\n# legacy name from PLAN-086 Wave C; net-new actions should still\n# prefer snake_case per the rest of the canonical action surface.\n_ACTION_NAME_RE = re.compile(r\"^[a-z][a-z0-9_\\-]*$\")\n\n\n# ---------------------------------------------------------------------------\n# Data model\n# ---------------------------------------------------------------------------\n\n\nclass CallSite:\n    \"\"\"One ``emit_<name>(...)`` call site discovered by AST walk.\"\"\"\n\n    __slots__ = (\"name\", \"file\", \"line\")\n\n    def __init__(self, name: str, file: Path, line: int) -> None:\n        self.name = name\n        self.file = file\n        self.line = line\n\n    def ref(self, repo_root: Path) -> str:\n        try:\n            rel = self.file.relative_to(repo_root)\n        except ValueError:\n            rel = self.file\n        return f\"{rel}:{self.line}\"\n\n\nclass FunctionDef(CallSite):\n    \"\"\"One typed emitter, retaining its actual source for drift diagnostics.\"\"\"\n\n    __slots__ = ()\n\n    def __init__(self, name: str, line: int, file: Path = AUDIT_EMIT_REL) -> None:\n        super().__init__(name, file, line)\n\n\n# ---------------------------------------------------------------------------\n# Extractors — code side\n# ---------------------------------------------------------------------------\n\n\ndef _parse_emitter_source(path: Path) -> ast.Module:\n    \"\"\"Read declarations without importing code or suppressing broken parts.\"\"\"\n    try:\n        return ast.parse(path.read_text(encoding=\"utf-8\"), filename=str(path))\n    except SyntaxError as exc:\n        raise RuntimeError(\n            f\"{path.name} parse error at line {exc.lineno}: {exc.msg}\"\n        ) from exc\n    except (OSError, UnicodeError) as exc:\n        raise RuntimeError(f\"{path.name} unreadable: {exc}\") from exc\n\n\ndef _emitter_definitions(tree: ast.AST, path: Path) -> List[FunctionDef]:\n    definitions = []\n    for node in ast.walk(tree):\n        if isinstance(node, ast.FunctionDef) and node.name.startswith(\"emit_\"):\n            action = node.name[len(\"emit_\"):]\n            if _ACTION_NAME_RE.match(action):\n                definitions.append(FunctionDef(action, node.lineno, path))\n    return definitions\n\n\ndef extract_known_actions(audit_emit_path: Path) -> Tuple[Set[str], List[FunctionDef]]:\n    \"\"\"Read the literal facade registry and emitter definitions across its parts.\"\"\"\n    tree = _parse_emitter_source(audit_emit_path)\n    known: Optional[Set[str]] = None\n    emit_defs = _emitter_definitions(tree, audit_emit_path)\n\n    for node in ast.walk(tree):\n        # _KNOWN_ACTIONS = {...}  — single-target Assign to a Set literal\n        if isinstance(node, ast.Assign) and len(node.targets) == 1:\n            target = node.targets[0]\n            if isinstance(target, ast.Name) and target.id == \"_KNOWN_ACTIONS\":\n                value = node.value\n                if not isinstance(value, ast.Set):\n                    raise RuntimeError(\n                        f\"_KNOWN_ACTIONS at line {node.lineno} is not a set literal \"\n                        f\"(found {type(value).__name__})\"\n                    )\n                collected: Set[str] = set()\n                for elt in value.elts:\n                    if isinstance(elt, ast.Constant) and isinstance(elt.value, str):\n                        collected.add(elt.value)\n                    else:\n                        raise RuntimeError(\n                            f\"_KNOWN_ACTIONS at line {node.lineno} contains non-str \"\n                            f\"element: {ast.dump(elt)}\"\n                        )\n                known = collected\n\n    if known is None:\n        raise RuntimeError(\n            \"_KNOWN_ACTIONS set literal not found in audit_emit.py\"\n        )\n    parts = audit_emit_path.parent / \"_audit_emit_parts\"\n    if parts.is_dir():\n        for path in sorted(parts.glob(\"*.py\")):\n            emit_defs.extend(_emitter_definitions(_parse_emitter_source(path), path))\n    return known, emit_defs\n\n\n# ---------------------------------------------------------------------------\n# Extractors — schema side\n# ---------------------------------------------------------------------------\n\n\ndef extract_schema_actions(schema_path: Path) -> Set[str]:\n    \"\"\"Return set of action names in the Required-fields table.\"\"\"\n    try:\n        text = schema_path.read_text(encoding=\"utf-8\")\n    except OSError as exc:\n        raise RuntimeError(f\"schema unreadable: {exc}\") from exc\n\n    actions: Set[str] = set()\n    in_table = False\n    header_marker = \"Required fields per v2 action\"\n\n    for raw in text.splitlines():\n        line = raw.rstrip()\n        if header_marker in line:\n            in_table = True\n            continue\n        if in_table:\n            match = _SCHEMA_ROW_RE.match(line)\n            if match:","numLines":200,"startLine":60,"totalLines":988}},"tool_result_meta":[{"id":"toolu_01RNzsXXuQtHpbdBxfma916N","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
