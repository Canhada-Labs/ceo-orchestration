{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KvZfLnM7sC1mSPXL4HeMx5","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"ceo-boot.py — PLAN-065 Phase 3 production session-boot autopilot.\n3\t\n4\tSingle command at session start that consolidates governance reads + state\n5\tdigest + recommendations. Per PLAN-065 §4.3 acceptance:\n6\t\n7\t- 15 Tier-S checks dispatched parallel via ThreadPoolExecutor (stdlib)\n8\t- Per-check timeout 500 ms; aggregate wall-clock budget 5 s\n9\t- ``--short`` defaults to cached mode (≤2 s budget; cache-hit ≤200 ms)\n10\t- ``--json`` emits machine-readable digest\n11\t- Idempotent (back-to-back identical mod timestamps + transient failures)\n12\t- Recommendations engine (rule-based; ≤5 items)\n13\t- Audit emit hasattr-guarded — works pre + post canonical ceremony\n14\t\n15\tStdlib only. Python 3.9+.\n16\t\n17\tRun from repo root:\n18\t\n19\t    python3 .claude/scripts/ceo-boot.py             # full digest\n20\t    python3 .claude/scripts/ceo-boot.py --short     # cached top-line\n21\t    python3 .claude/scripts/ceo-boot.py --json      # machine output\n22\t    python3 .claude/scripts/ceo-boot.py --bench     # bench harness\n23\t\n24\tSlash command: ``/ceo-boot`` (see ``.claude/commands/ceo-boot.md``).\n25\t\"\"\"\n26\tfrom __future__ import annotations\n27\t\n28\timport argparse\n29\timport hashlib\n30\timport json\n31\timport os\n32\timport re\n33\timport resource\n34\timport subprocess\n35\timport sys\n36\timport time\n37\timport tracemalloc\n38\timport unicodedata\n39\tfrom concurrent.futures import (\n40\t    ThreadPoolExecutor,\n41\t    TimeoutError as FuturesTimeout,\n42\t    as_completed,\n43\t    wait as futures_wait,\n44\t)\n45\tfrom pathlib import Path\n46\tfrom typing import Any, Callable, Dict, List, Optional, Tuple\n47\timport sys as _sys_rp\n48\tfrom pathlib import Path as _Path_rp\n49\t_HOOKS_RP = _Path_rp(__file__).resolve()\n50\tfor _anc in _HOOKS_RP.parents:\n51\t    if (_anc / \".claude\" / \"hooks\" / \"_lib\").is_dir():\n52\t        if str(_anc / \".claude\" / \"hooks\") not in _sys_rp.path:\n53\t            _sys_rp.path.insert(0, str(_anc / \".claude\" / \"hooks\"))\n54\t        break\n55\tfrom _lib import runtime_paths as _rp  # noqa: E402  # PLAN-182 W1 single resolver\n56\t\n57\tREPO_ROOT = Path(__file__).resolve().parents[2]\n58\t\n59\t\n60\t# PLAN-087 Wave C.4 — module-level plan-glob cache.\n61\t# Populated lazily on first call to _get_plan_paths(); subsequent calls\n62\t# within the same /ceo-boot subprocess return the cached sorted list.\n63\t# Process-scoped (no TTL); each /ceo-boot invocation is a fresh subprocess\n64\t# so the cache cannot go stale within a single invocation.\n65\t_PLAN_GLOB_CACHE: Optional[List[Path]] = None\n66\t\n67\t\n68\t\n69\t\n70\tdef check_governance_validate() -> Tuple[str, str, Any]:\n71\t    \"\"\"PLAN-082 Codex Item A: dispatch fast-profile validator.\n72\t\n73\t    Calls `validate-governance.sh --fast --json` (delegates to\n74\t    `validate_governance_fast.py`) with a 1.8 s timeout. Parses JSON\n75\t    output; `rc != 0` is the red truth signal (NOT `stdout.count(\"ERROR\")`\n76\t    — Codex 6th-option catch: the full validator emits `FAIL:` in some\n77\t    sections without printing literal \"ERROR\", which underclassified\n78\t    failures as yellow).\n79\t    \"\"\"\n80\t    script = REPO_ROOT / \".claude\" / \"scripts\" / \"validate-governance.sh\"\n81\t    if not script.exists():\n82\t        return \"yellow\", \"validate-governance missing\", None\n83\t    try:\n84\t        proc = subprocess.run(\n85\t            [\"bash\", str(script), \"--fast\", \"--json\"],\n86\t            capture_output=True, text=True, timeout=1.8, cwd=str(REPO_ROOT),\n87\t        )\n88\t    except subprocess.TimeoutExpired:\n89\t        return \"red\", \"validate timeout (fast)\", None\n90\t    rc = proc.returncode\n91\t    try:\n92\t        payload = json.loads(proc.stdout) if proc.stdout else {}\n93\t    except (json.JSONDecodeError, ValueError):\n94\t        payload = {}\n95\t    errors = payload.get(\"errors\", []) if isinstance(payload, dict) else []\n96\t    warnings = payload.get(\"warnings\", []) if isinstance(payload, dict) else []\n97\t    n_err = len(errors) if isinstance(errors, list) else 0\n98\t    n_warn = len(warnings) if isinstance(warnings, list) else 0\n99\t    # rc != 0 is the red truth (Codex 6th-option catch).\n100\t    if rc != 0:\n101\t        status = \"red\"\n102\t        summary = f\"fast fail: {n_err} error(s)\"\n103\t    elif n_warn:\n104\t        status = \"yellow\"\n105\t        summary = f\"fast pass, {n_warn} warn(s)\"\n106\t    else:\n107\t        status = \"green\"\n108\t        summary = \"fast pass\"\n109\t    return status, summary, {\"rc\": rc, \"errors\": n_err, \"warnings\": n_warn, \"profile\": \"fast\"}\n110\t\n111\t# Declarations live beside the reusable hook library so the installer carries\n112\t# them recursively. They execute in this facade dictionary: private symbols,\n113\t# mutable state, and monkeypatch seams retain their historical identity.\n114\tfrom _lib._ceo_boot_parts import install as _install_ceo_boot_parts  # noqa: E402\n115\t\n116\t_install_ceo_boot_parts(globals())\n117\tdel _install_ceo_boot_parts\n118\t\n119\t\n120\tdef check_tier_a_spec_version_drift() -> Tuple[str, str, Any]:\n121\t    \"\"\"VERSION major vs latest SPEC/v* major agreement — red on drift.\n122\t\n123\t    Lesson validation remains delegated to `_validate_boot_lesson`.\n124\t    \"\"\"\n125\t    fw_file = REPO_ROOT / \".claude\" / \".framework-version\"\n126\t    if not fw_file.exists():\n127\t        return \"green\", \"no .framework-version (drift not attributable)\", None\n128\t    try:\n129\t        repo_v = fw_file.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n130\t    except OSError:\n131\t        return \"yellow\", \".framework-version unreadable\", None\n132\t    provenance_ok = False\n133\t    manifest = REPO_ROOT / \".claude\" / \".install-manifest.sha256\"\n134\t    try:\n135\t        if manifest.exists() and \".claude/.framework-version\" in manifest.read_text(\n136\t                encoding=\"utf-8\", errors=\"replace\"):\n137\t            provenance_ok = True\n138\t    except OSError:\n139\t        pass\n140\t    if not provenance_ok:\n141\t        try:\n142\t            provenance_ok = subprocess.run(\n143\t                [\"git\", \"-C\", str(REPO_ROOT), \"ls-files\", \"--error-unmatch\",\n144\t                 \".claude/.framework-version\"],\n145\t                capture_output=True, timeout=2,\n146\t            ).returncode == 0\n147\t        except (OSError, subprocess.SubprocessError):\n148\t            provenance_ok = False\n149\t    spec_root = REPO_ROOT / \"SPEC\"\n150\t    if not spec_root.exists():\n151\t        return \"green\", f\"repo {repo_v}, no SPEC dir\", repo_v\n152\t    spec_majors = []\n153\t    for p in spec_root.iterdir():\n154\t        if p.is_dir() and p.name.startswith(\"v\"):\n155\t            try:\n156\t                spec_majors.append(int(p.name[1:]))\n157\t            except ValueError:\n158\t                return \"yellow\", f\"unparseable SPEC dir {p.name}\", None\n159\t    if not spec_majors:\n160\t        return \"green\", f\"repo {repo_v}, no SPEC versions\", repo_v\n161\t    try:\n162\t        repo_major = int(repo_v.split(\".\", 1)[0])\n163\t    except ValueError:\n164\t        return \"yellow\", f\"unparseable .framework-version {repo_v}\", None\n165\t    latest_spec = max(spec_majors)\n166\t    detail = {\"repo_version\": repo_v,\n167\t              \"spec_versions\": [\"v%d\" % m for m in sorted(spec_majors)],\n168\t              \"provenance_verified\": provenance_ok}\n169\t    if repo_major != latest_spec:\n170\t        if provenance_ok:\n171\t            return \"red\", (\n172\t                f\"drift: framework major {repo_major} vs SPEC v{latest_spec}\"\n173\t            ), detail\n174\t        return \"yellow\", (\n175\t            f\"drift suspected: marker {repo_major} vs SPEC v{latest_spec} \"\n176\t            \"(provenance unverified — ADR-155-AMEND-1 §5)\"\n177\t        ), detail\n178\t    return \"green\", f\"framework {repo_v} ~ spec v{latest_spec}\", detail\n179\t\n180\t# === PLAN-065 Phase 2 audit_emit wire ===\n181\t# `_emit_ceo_boot_emitted_safe` and `_emit_ceo_boot_check_skipped_safe` are\n182\t# real declarations in the ordered parts above. This surface marker belongs\n183\t# to the script entry point because the delivery guard checks it there.\n184\t# Tier-S 16th entry: check_tier_policy_misrouting_24h (\"tier_policy_misrouting_24h\")\n185\t\n186\t\n187\tif __name__ == \"__main__\":\n188\t    sys.exit(main(sys.argv[1:]))\n189\t"}]},"parent_tool_use_id":null,"session_id":"261e4768-bfba-44df-8655-b8fb9a3eb93f","uuid":"353b6bc8-48ce-47d8-8977-17426dd7f2bf","timestamp":"2026-11-16T19:45:20.056Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/ceo-boot.py","content":"#!/usr/bin/env python3\n\"\"\"ceo-boot.py — PLAN-065 Phase 3 production session-boot autopilot.\n\nSingle command at session start that consolidates governance reads + state\ndigest + recommendations. Per PLAN-065 §4.3 acceptance:\n\n- 15 Tier-S checks dispatched parallel via ThreadPoolExecutor (stdlib)\n- Per-check timeout 500 ms; aggregate wall-clock budget 5 s\n- ``--short`` defaults to cached mode (≤2 s budget; cache-hit ≤200 ms)\n- ``--json`` emits machine-readable digest\n- Idempotent (back-to-back identical mod timestamps + transient failures)\n- Recommendations engine (rule-based; ≤5 items)\n- Audit emit hasattr-guarded — works pre + post canonical ceremony\n\nStdlib only. Python 3.9+.\n\nRun from repo root:\n\n    python3 .claude/scripts/ceo-boot.py             # full digest\n    python3 .claude/scripts/ceo-boot.py --short     # cached top-line\n    python3 .claude/scripts/ceo-boot.py --json      # machine output\n    python3 .claude/scripts/ceo-boot.py --bench     # bench harness\n\nSlash command: ``/ceo-boot`` (see ``.claude/commands/ceo-boot.md``).\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport os\nimport re\nimport resource\nimport subprocess\nimport sys\nimport time\nimport tracemalloc\nimport unicodedata\nfrom concurrent.futures import (\n    ThreadPoolExecutor,\n    TimeoutError as FuturesTimeout,\n    as_completed,\n    wait as futures_wait,\n)\nfrom pathlib import Path\nfrom typing import Any, Callable, Dict, List, Optional, Tuple\nimport sys as _sys_rp\nfrom pathlib import Path as _Path_rp\n_HOOKS_RP = _Path_rp(__file__).resolve()\nfor _anc in _HOOKS_RP.parents:\n    if (_anc / \".claude\" / \"hooks\" / \"_lib\").is_dir():\n        if str(_anc / \".claude\" / \"hooks\") not in _sys_rp.path:\n            _sys_rp.path.insert(0, str(_anc / \".claude\" / \"hooks\"))\n        break\nfrom _lib import runtime_paths as _rp  # noqa: E402  # PLAN-182 W1 single resolver\n\nREPO_ROOT = Path(__file__).resolve().parents[2]\n\n\n# PLAN-087 Wave C.4 — module-level plan-glob cache.\n# Populated lazily on first call to _get_plan_paths(); subsequent calls\n# within the same /ceo-boot subprocess return the cached sorted list.\n# Process-scoped (no TTL); each /ceo-boot invocation is a fresh subprocess\n# so the cache cannot go stale within a single invocation.\n_PLAN_GLOB_CACHE: Optional[List[Path]] = None\n\n\n\n\ndef check_governance_validate() -> Tuple[str, str, Any]:\n    \"\"\"PLAN-082 Codex Item A: dispatch fast-profile validator.\n\n    Calls `validate-governance.sh --fast --json` (delegates to\n    `validate_governance_fast.py`) with a 1.8 s timeout. Parses JSON\n    output; `rc != 0` is the red truth signal (NOT `stdout.count(\"ERROR\")`\n    — Codex 6th-option catch: the full validator emits `FAIL:` in some\n    sections without printing literal \"ERROR\", which underclassified\n    failures as yellow).\n    \"\"\"\n    script = REPO_ROOT / \".claude\" / \"scripts\" / \"validate-governance.sh\"\n    if not script.exists():\n        return \"yellow\", \"validate-governance missing\", None\n    try:\n        proc = subprocess.run(\n            [\"bash\", str(script), \"--fast\", \"--json\"],\n            capture_output=True, text=True, timeout=1.8, cwd=str(REPO_ROOT),\n        )\n    except subprocess.TimeoutExpired:\n        return \"red\", \"validate timeout (fast)\", None\n    rc = proc.returncode\n    try:\n        payload = json.loads(proc.stdout) if proc.stdout else {}\n    except (json.JSONDecodeError, ValueError):\n        payload = {}\n    errors = payload.get(\"errors\", []) if isinstance(payload, dict) else []\n    warnings = payload.get(\"warnings\", []) if isinstance(payload, dict) else []\n    n_err = len(errors) if isinstance(errors, list) else 0\n    n_warn = len(warnings) if isinstance(warnings, list) else 0\n    # rc != 0 is the red truth (Codex 6th-option catch).\n    if rc != 0:\n        status = \"red\"\n        summary = f\"fast fail: {n_err} error(s)\"\n    elif n_warn:\n        status = \"yellow\"\n        summary = f\"fast pass, {n_warn} warn(s)\"\n    else:\n        status = \"green\"\n        summary = \"fast pass\"\n    return status, summary, {\"rc\": rc, \"errors\": n_err, \"warnings\": n_warn, \"profile\": \"fast\"}\n\n# Declarations live beside the reusable hook library so the installer carries\n# them recursively. They execute in this facade dictionary: private symbols,\n# mutable state, and monkeypatch seams retain their historical identity.\nfrom _lib._ceo_boot_parts import install as _install_ceo_boot_parts  # noqa: E402\n\n_install_ceo_boot_parts(globals())\ndel _install_ceo_boot_parts\n\n\ndef check_tier_a_spec_version_drift() -> Tuple[str, str, Any]:\n    \"\"\"VERSION major vs latest SPEC/v* major agreement — red on drift.\n\n    Lesson validation remains delegated to `_validate_boot_lesson`.\n    \"\"\"\n    fw_file = REPO_ROOT / \".claude\" / \".framework-version\"\n    if not fw_file.exists():\n        return \"green\", \"no .framework-version (drift not attributable)\", None\n    try:\n        repo_v = fw_file.read_text(encoding=\"utf-8\", errors=\"replace\").strip()\n    except OSError:\n        return \"yellow\", \".framework-version unreadable\", None\n    provenance_ok = False\n    manifest = REPO_ROOT / \".claude\" / \".install-manifest.sha256\"\n    try:\n        if manifest.exists() and \".claude/.framework-version\" in manifest.read_text(\n                encoding=\"utf-8\", errors=\"replace\"):\n            provenance_ok = True\n    except OSError:\n        pass\n    if not provenance_ok:\n        try:\n            provenance_ok = subprocess.run(\n                [\"git\", \"-C\", str(REPO_ROOT), \"ls-files\", \"--error-unmatch\",\n                 \".claude/.framework-version\"],\n                capture_output=True, timeout=2,\n            ).returncode == 0\n        except (OSError, subprocess.SubprocessError):\n            provenance_ok = False\n    spec_root = REPO_ROOT / \"SPEC\"\n    if not spec_root.exists():\n        return \"green\", f\"repo {repo_v}, no SPEC dir\", repo_v\n    spec_majors = []\n    for p in spec_root.iterdir():\n        if p.is_dir() and p.name.startswith(\"v\"):\n            try:\n                spec_majors.append(int(p.name[1:]))\n            except ValueError:\n                return \"yellow\", f\"unparseable SPEC dir {p.name}\", None\n    if not spec_majors:\n        return \"green\", f\"repo {repo_v}, no SPEC versions\", repo_v\n    try:\n        repo_major = int(repo_v.split(\".\", 1)[0])\n    except ValueError:\n        return \"yellow\", f\"unparseable .framework-version {repo_v}\", None\n    latest_spec = max(spec_majors)\n    detail = {\"repo_version\": repo_v,\n              \"spec_versions\": [\"v%d\" % m for m in sorted(spec_majors)],\n              \"provenance_verified\": provenance_ok}\n    if repo_major != latest_spec:\n        if provenance_ok:\n            return \"red\", (\n                f\"drift: framework major {repo_major} vs SPEC v{latest_spec}\"\n            ), detail\n        return \"yellow\", (\n            f\"drift suspected: marker {repo_major} vs SPEC v{latest_spec} \"\n            \"(provenance unverified — ADR-155-AMEND-1 §5)\"\n        ), detail\n    return \"green\", f\"framework {repo_v} ~ spec v{latest_spec}\", detail\n\n# === PLAN-065 Phase 2 audit_emit wire ===\n# `_emit_ceo_boot_emitted_safe` and `_emit_ceo_boot_check_skipped_safe` are\n# real declarations in the ordered parts above. This surface marker belongs\n# to the script entry point because the delivery guard checks it there.\n# Tier-S 16th entry: check_tier_policy_misrouting_24h (\"tier_policy_misrouting_24h\")\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n","numLines":189,"startLine":1,"totalLines":189}},"tool_result_meta":[{"id":"toolu_01KvZfLnM7sC1mSPXL4HeMx5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
