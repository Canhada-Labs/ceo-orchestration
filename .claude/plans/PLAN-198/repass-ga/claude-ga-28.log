{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EfAM3PaMLp6bvEgTcxTuKZ","type":"tool_result","content":"1\t#!/bin/bash\n2\t# ceo-restore.sh — restore framework state from a ceo-backup tarball\n3\t#\n4\t# Usage:\n5\t#   ceo-restore.sh <tarball>             # dry-run by default\n6\t#   ceo-restore.sh <tarball> --apply     # actually restore\n7\t#\n8\t# Default mode is DRY-RUN — verifies SHA256 sidecar + lists files\n9\t# the apply mode would overwrite.\n10\t#\n11\t# Apply mode prompts for confirmation unless --force is passed.\n12\t#\n13\t# Exit codes:\n14\t#   0 — success (dry-run lists; apply completed)\n15\t#   1 — usage error / SHA mismatch / refused destination\n16\t#   2 — fatal (tarball corrupt, no permissions)\n17\t\n18\tset -euo pipefail\n19\t\n20\tTARBALL=\"\"\n21\tAPPLY=0\n22\tFORCE=0\n23\tQUIET=0\n24\tDEST_OVERRIDE=\"\"\n25\tPROJECT_SLUG_OVERRIDE=\"\"\n26\tRESTORE_PLANS=0\n27\tRESTORE_AGENT_METRICS=0\n28\t\n29\tusage() {\n30\t  cat <<EOF\n31\tceo-restore.sh — restore framework state from a ceo-backup tarball\n32\t\n33\tUsage:\n34\t  ceo-restore.sh <tarball> [options]\n35\t\n36\tOptions:\n37\t  --apply                  Commit the restore (default: dry-run)\n38\t  --force                  Skip the apply confirmation prompt\n39\t  --quiet                  Suppress progress\n40\t  --dest <dir>             Restore destination (default: CEO_AUDIT_LOG_DIR or ~/.claude/projects/<slug>)\n41\t  --project-slug <name>    Override slug for default dest path\n42\t  --restore-plans          Also restore plans/ subdir if present in tarball\n43\t  --restore-agent-metrics  Also restore .claude/agent-metrics.md\n44\t  -h, --help               This message\n45\t\n46\tThe default --dry-run mode:\n47\t  - verifies tarball SHA256 against the .sha256 sidecar (if present)\n48\t  - lists every file the apply mode would write\n49\t  - exits 0 on success; non-zero only on integrity failure\n50\t\n51\tThe --apply mode:\n52\t  - re-verifies SHA256\n53\t  - prompts for confirmation (unless --force)\n54\t  - extracts audit/ + memory/ to <dest>\n55\t  - extracts agent-metrics.md / plans/ to CWD's .claude/ if --restore-* flags\n56\tEOF\n57\t}\n58\t\n59\twhile [[ $# -gt 0 ]]; do\n60\t  case \"$1\" in\n61\t    --apply) APPLY=1; shift ;;\n62\t    --force) FORCE=1; shift ;;\n63\t    --quiet) QUIET=1; shift ;;\n64\t    --dest) DEST_OVERRIDE=\"$2\"; shift 2 ;;\n65\t    --project-slug) PROJECT_SLUG_OVERRIDE=\"$2\"; shift 2 ;;\n66\t    --restore-plans) RESTORE_PLANS=1; shift ;;\n67\t    --restore-agent-metrics) RESTORE_AGENT_METRICS=1; shift ;;\n68\t    -h|--help) usage; exit 0 ;;\n69\t    --*) echo \"unknown flag: $1\" >&2; usage >&2; exit 1 ;;\n70\t    *)\n71\t      if [ -z \"$TARBALL\" ]; then\n72\t        TARBALL=\"$1\"; shift\n73\t      else\n74\t        echo \"extra argument: $1\" >&2; usage >&2; exit 1\n75\t      fi\n76\t      ;;\n77\t  esac\n78\tdone\n79\t\n80\tlog() {\n81\t  if [ \"$QUIET\" -eq 0 ]; then\n82\t    echo \"$@\" >&2\n83\t  fi\n84\t  return 0\n85\t}\n86\t\n87\tif [ -z \"$TARBALL\" ]; then\n88\t  echo \"error: tarball path required\" >&2\n89\t  usage >&2\n90\t  exit 1\n91\tfi\n92\t\n93\tif [ ! -f \"$TARBALL\" ]; then\n94\t  echo \"error: tarball not found: $TARBALL\" >&2\n95\t  exit 1\n96\tfi\n97\t\n98\t# The framework SINGLE resolver (ADR-001; PLAN-182 OQ-6, S326). The old\n99\t# default slug `ceo-orchestration` named THIS framework, not the adopter: every\n100\t# project under one $HOME backed up -- and restored -- the same shared dir.\n101\t# `--project-slug` / CEO_PROJECT_NAME stay as EXPLICIT operator overrides;\n102\t# nothing is defaulted from a literal. No resolver on disk (partial upgrade)\n103\t# => fail loud rather than guess where the state lives.\n104\t# `|| true` inside: under `set -e` a failed `cd` (script copied outside a\n105\t# framework tree) would abort this assignment SILENTLY, before _resolve_rp can\n106\t# print its loud `fatal:`. An empty dir here simply fails the -f test below.\n107\t_RP_DIR=\"$(dirname \"${BASH_SOURCE[0]}\")/../hooks/_lib\"\n108\t_RP=\"$( { cd \"$_RP_DIR\" 2>/dev/null && pwd; } || printf '%s' \"$_RP_DIR\" )/runtime_paths.py\"\n109\t_project_root() {\n110\t  # The project the state belongs to (rail r1 P2 + r3 P1):\n111\t  #   1. the harness-set CLAUDE_PROJECT_DIR;\n112\t  #   2. else walk up from the CWD to the nearest `.claude/` (the resolver\n113\t  #      falls back to the CWD, so a call from a SUBDIRECTORY would otherwise\n114\t  #      name the subdirectory);\n115\t  #   3. else the project this script is INSTALLED in — it lives at\n116\t  #      <project>/.claude/scripts/ — because the documented cron entry\n117\t  #      (docs/DISASTER-RECOVERY.md) invokes it by absolute path with\n118\t  #      CWD=$HOME and no CLAUDE_PROJECT_DIR, where step 2 finds nothing.\n119\t  # Nothing at all => failure (never a guessed slug).\n120\t  if [ -n \"${CLAUDE_PROJECT_DIR:-}\" ]; then printf '%s' \"$CLAUDE_PROJECT_DIR\"; return 0; fi\n121\t  # A project is a directory with the framework INSTALL MARKER — not merely a\n122\t  # `.claude/` (rail r4 P1): under the documented cron, CWD=$HOME and the\n123\t  # user's GLOBAL ~/.claude exists, so a bare `-d .claude` test picked $HOME\n124\t  # as the project and the backup targeted the wrong slug with exit 0.\n125\t  local cur\n126\t  cur=\"$(pwd)\"\n127\t  while [ \"$cur\" != \"/\" ]; do\n128\t    if [ -f \"$cur/.claude/.framework-version\" ]; then printf '%s' \"$cur\"; return 0; fi\n129\t    cur=\"$(dirname \"$cur\")\"\n130\t  done\n131\t  local here\n132\t  here=\"$( { cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" 2>/dev/null && pwd; } || true )\"\n133\t  if [ -n \"$here\" ] && [ -d \"$here/.claude/scripts\" ] && [ -d \"$here/.claude/hooks\" ]; then printf '%s' \"$here\"; return 0; fi\n134\t  return 1\n135\t}\n136\t_resolve_rp() {\n137\t  if [ ! -f \"$_RP\" ] || ! command -v python3 >/dev/null 2>&1; then\n138\t    echo \"fatal: single resolver not found at $_RP (run scripts/upgrade.sh) -- refusing to guess the state dir\" >&2\n139\t    return 2\n140\t  fi\n141\t  local root\n142\t  root=\"$(_project_root)\" || {\n143\t    echo \"fatal: no project root (.claude/) above $(pwd) and CLAUDE_PROJECT_DIR unset -- pass --project-slug or run from the project\" >&2\n144\t    return 2\n145\t  }\n146\t  python3 \"$_RP\" --project \"$root\" \"$@\"\n147\t}\n148\t\n149\t# Resolve destination. An EXPLICIT destination (--dest / CEO_AUDIT_LOG_DIR)\n150\t# is honoured without any project discovery (pair-rail r2 P2): the slug is\n151\t# only needed by the branch that builds the path from it.\n152\tif [ -n \"$DEST_OVERRIDE\" ]; then\n153\t  DEST=\"$DEST_OVERRIDE\"\n154\telif [ -n \"${CEO_AUDIT_LOG_DIR:-}\" ]; then\n155\t  DEST=\"$CEO_AUDIT_LOG_DIR\"\n156\telif [ -n \"${PROJECT_SLUG_OVERRIDE:-}${CEO_PROJECT_NAME:-}\" ]; then\n157\t  # An explicit operator slug names the destination directly under $HOME.\n158\t  PROJECT_SLUG=\"${PROJECT_SLUG_OVERRIDE:-$CEO_PROJECT_NAME}\"\n159\t  DEST=\"$HOME/.claude/projects/$PROJECT_SLUG\"\n160\telse\n161\t  DEST=\"$(_resolve_rp --state-dir)\" || exit 2\n162\tfi\n163\t[ -n \"$DEST\" ] || { echo \"fatal: empty destination\" >&2; exit 2; }\n164\t\n165\tlog \"ceo-restore: tarball=$TARBALL dest=$DEST mode=$([ \"$APPLY\" -eq 1 ] && echo APPLY || echo DRY-RUN)\"\n166\t\n167\t_physical_dest() {\n168\t  local raw=\"$1\" parent leaf\n169\t  case \"$raw\" in\n170\t    *//*|*/./*|*/../*|../*|.)\n171\t      echo \"fatal: refused destination spelling: $raw\" >&2; return 1 ;;\n172\t  esac\n173\t  parent=\"$(dirname \"$raw\")\"\n174\t  leaf=\"$(basename \"$raw\")\"\n175\t  if [ -e \"$raw\" ] || [ -L \"$raw\" ]; then\n176\t    [ -d \"$raw\" ] && [ ! -L \"$raw\" ] || {\n177\t      echo \"fatal: destination must be a real directory, not a link or file\" >&2; return 1;\n178\t    }\n179\t    (cd -P \"$raw\" && pwd)\n180\t    return 0\n181\t  fi\n182\t  [ -d \"$parent\" ] && [ ! -L \"$parent\" ] || {\n183\t    echo \"fatal: destination parent must be a real directory\" >&2; return 1;\n184\t  }\n185\t  printf '%s/%s\\n' \"$(cd -P \"$parent\" && pwd)\" \"$leaf\"\n186\t}\n187\t\n188\tARCHIVE_VALIDATOR=\"$(dirname \"${BASH_SOURCE[0]}\")/_restore_archive.py\"\n189\t[ -f \"$ARCHIVE_VALIDATOR\" ] || { echo \"fatal: archive validator missing\" >&2; exit 2; }\n190\tpython3 \"$ARCHIVE_VALIDATOR\" \"$TARBALL\" || exit 2\n191\tDEST=\"$(_physical_dest \"$DEST\")\" || exit 2\n192\t\n193\t# Resolve sha256 binary\n194\tSHA256_BIN=\"\"\n195\tif command -v sha256sum >/dev/null 2>&1; then\n196\t  SHA256_BIN=\"sha256sum\"\n197\telif command -v shasum >/dev/null 2>&1; then\n198\t  SHA256_BIN=\"shasum -a 256\"\n199\tfi\n200\t\n201\t# SHA verification\n202\tSHA_SIDE=\"$TARBALL.sha256\"\n203\tif [ -n \"$SHA256_BIN\" ] && [ -f \"$SHA_SIDE\" ]; then\n204\t  EXPECTED=\"$(cat \"$SHA_SIDE\" | awk '{print $1}')\"\n205\t  ACTUAL=\"$($SHA256_BIN \"$TARBALL\" | awk '{print $1}')\"\n206\t  if [ \"$EXPECTED\" != \"$ACTUAL\" ]; then\n207\t    echo \"fatal: SHA256 mismatch\" >&2\n208\t    echo \"  expected: $EXPECTED\" >&2\n209\t    echo \"  actual:   $ACTUAL\" >&2\n210\t    exit 2\n211\t  fi\n212\t  log \"sha256: verified ($ACTUAL)\"\n213\telse\n214\t  log \"warning: no .sha256 sidecar found; integrity not verified\"\n215\tfi\n216\t\n217\t# Validate the exact tree that both preview and apply describe.  This is before\n218\t# the dry-run return deliberately: preview must never bless an apply it rejects.\n219\tif [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] || [ \"$RESTORE_PLANS\" -eq 1 ]; then\n220\t  if [ -L \"$(pwd)/.claude\" ] || [ ! -d \"$(pwd)/.claude\" ]; then\n221\t    echo \"fatal: optional restore requires a real .claude directory in CWD\" >&2\n222\t    exit 2\n223\t  fi\n224\t  if [ \"$RESTORE_PLANS\" -eq 1 ] && [ -L \"$(pwd)/.claude/plans\" ]; then\n225\t    echo \"fatal: optional plans restore requires a real .claude/plans directory\" >&2\n226\t    exit 2\n227\t  fi\n228\tfi\n229\tSTAGE_DIR=\"$(mktemp -d -t ceo-restore-XXXXXX)\"\n230\ttrap 'rm -rf \"$STAGE_DIR\"' EXIT\n231\t# The validator writes ONLY the members it accepted (never `tar -x` of the\n232\t# whole archive): a skipped macOS AppleDouble member `._<name>` never lands\n233\t# on disk, in the preview or in the apply.\n234\tpython3 \"$ARCHIVE_VALIDATOR\" \"$TARBALL\" \"$STAGE_DIR\" || exit 2\n235\tif find \"$STAGE_DIR\" -type l -print -quit | grep -q .; then\n236\t  echo \"fatal: archive contains symbolic links\" >&2\n237\t  exit 2\n238\tfi\n239\t\n240\t# List contents (dry-run preview)\n241\tlog \"\"\n242\tlog \"tarball contents:\"\n243\tif [ \"$QUIET\" -eq 0 ]; then\n244\t  tar -tzf \"$TARBALL\" | sed -n '1,50{s/^/  /;p;}' >&2\n245\tfi\n246\t\n247\t_refuse_link_ancestors() {\n248\t  local path=\"$1\" stop=\"$2\"\n249\t  if [ -L \"$path\" ]; then\n250\t    echo \"fatal: restore target is a symbolic link: $path\" >&2\n251\t    return 2\n252\t  fi\n253\t  if [ -e \"$path\" ] && [ ! -f \"$path\" ]; then\n254\t    echo \"fatal: restore target must be a regular file: $path\" >&2\n255\t    return 2\n256\t  fi\n257\t  while [ \"$path\" != \"$stop\" ]; do\n258\t    if [ -L \"$path\" ]; then\n259\t      echo \"fatal: restore target is a symbolic link: $path\" >&2\n260\t      return 2\n261\t    fi\n262\t    path=\"$(dirname \"$path\")\"\n263\t  done\n264\t}\n265\t\n266\t_preflight_targets() {\n267\t  local f rel target\n268\t  if [ -d \"$STAGE_DIR/audit\" ]; then\n269\t    for f in \"$STAGE_DIR/audit\"/*; do\n270\t      [ -f \"$f\" ] || continue\n271\t      _refuse_link_ancestors \"$DEST/$(basename \"$f\")\" \"$DEST\" || return 2\n272\t    done\n273\t  fi\n274\t  if [ -d \"$STAGE_DIR/memory\" ]; then\n275\t    while IFS= read -r -d '' f; do\n276\t      rel=\"${f#\"$STAGE_DIR/memory/\"}\"\n277\t      target=\"$DEST/memory/$rel\"\n278\t      _refuse_link_ancestors \"$target\" \"$DEST\" || return 2\n279\t    done < <(find \"$STAGE_DIR/memory\" -type f -print0)\n280\t  fi\n281\t  if [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] && [ -f \"$STAGE_DIR/agent-metrics.md\" ]; then\n282\t    _refuse_link_ancestors \"$(pwd)/.claude/agent-metrics.md\" \"$(pwd)\" || return 2\n283\t  fi\n284\t  if [ \"$RESTORE_PLANS\" -eq 1 ] && [ -d \"$STAGE_DIR/plans\" ]; then\n285\t    while IFS= read -r -d '' f; do\n286\t      rel=\"${f#\"$STAGE_DIR/plans/\"}\"\n287\t      _refuse_link_ancestors \"$(pwd)/.claude/plans/$rel\" \"$(pwd)\" || return 2\n288\t    done < <(find \"$STAGE_DIR/plans\" -type f -print0)\n289\t  fi\n290\t}\n291\t\n292\t_preflight_targets || exit 2\n293\t\n294\tif [ \"$APPLY\" -eq 0 ]; then\n295\t  log \"\"\n296\t  log \"[dry-run] no files modified.\"\n297\t  log \"[dry-run] re-run with --apply to commit (will prompt unless --force).\"\n298\t  exit 0\n299\tfi\n300\t\n301\t# ----- APPLY -----\n302\tif [ \"$FORCE\" -ne 1 ]; then\n303\t  read -r -p \"Proceed with restore into $DEST? [yes/no] \" ANSWER\n304\t  [ \"$ANSWER\" = \"yes\" ] || { echo \"aborted.\"; exit 1; }\n305\tfi\n306\tmkdir -p \"$DEST\"\n307\t\n308\t# Restore audit/\n309\tif [ -d \"$STAGE_DIR/audit\" ]; then\n310\t  for f in \"$STAGE_DIR/audit\"/*; do\n311\t    [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n312\t    cp -p -- \"$f\" \"$DEST/$(basename \"$f\")\"\n313\t  done\n314\t  log \"restored: audit/ → $DEST/\"\n315\tfi\n316\t\n317\t# Restore memory/\n318\tif [ -d \"$STAGE_DIR/memory\" ]; then\n319\t  mkdir -p \"$DEST/memory\"\n320\t  while IFS= read -r -d '' f; do\n321\t    rel=\"${f#\"$STAGE_DIR/memory/\"}\"\n322\t    mkdir -p \"$DEST/memory/$(dirname \"$rel\")\"\n323\t    cp -p -- \"$f\" \"$DEST/memory/$rel\"\n324\t  done < <(find \"$STAGE_DIR/memory\" -type f -print0)\n325\t  log \"restored: memory/ → $DEST/memory/\"\n326\tfi\n327\t\n328\t# Optional: agent-metrics.md\n329\tif [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] && [ -f \"$STAGE_DIR/agent-metrics.md\" ]; then\n330\t  if [ -d \"$(pwd)/.claude\" ]; then\n331\t    cp -p \"$STAGE_DIR/agent-metrics.md\" \"$(pwd)/.claude/agent-metrics.md\"\n332\t    log \"restored: agent-metrics.md → $(pwd)/.claude/agent-metrics.md\"\n333\t  else\n334\t    log \"warning: no .claude/ in CWD; agent-metrics.md not restored\"\n335\t  fi\n336\tfi\n337\t\n338\t# Optional: plans/\n339\tif [ \"$RESTORE_PLANS\" -eq 1 ] && [ -d \"$STAGE_DIR/plans\" ]; then\n340\t  if [ -d \"$(pwd)/.claude\" ]; then\n341\t    mkdir -p \"$(pwd)/.claude/plans\"\n342\t    while IFS= read -r -d '' f; do\n343\t      rel=\"${f#\"$STAGE_DIR/plans/\"}\"\n344\t      mkdir -p \"$(pwd)/.claude/plans/$(dirname \"$rel\")\"\n345\t      cp -p -- \"$f\" \"$(pwd)/.claude/plans/$rel\"\n346\t    done < <(find \"$STAGE_DIR/plans\" -type f -print0)\n347\t    log \"restored: plans/ → $(pwd)/.claude/plans/\"\n348\t  else\n349\t    log \"warning: no .claude/ in CWD; plans/ not restored\"\n350\t  fi\n351\tfi\n352\t\n353\tlog \"\"\n354\tlog \"restore complete.\"\n355\texit 0\n356\t"}]},"parent_tool_use_id":null,"session_id":"261e4768-bfba-44df-8655-b8fb9a3eb93f","uuid":"7192e8a9-ce3f-4e1a-a986-8a8c6901aeba","timestamp":"2026-11-16T19:47:50.610Z","tool_use_result":{"type":"text","file":{"filePath":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/ceo-restore.sh","content":"#!/bin/bash\n# ceo-restore.sh — restore framework state from a ceo-backup tarball\n#\n# Usage:\n#   ceo-restore.sh <tarball>             # dry-run by default\n#   ceo-restore.sh <tarball> --apply     # actually restore\n#\n# Default mode is DRY-RUN — verifies SHA256 sidecar + lists files\n# the apply mode would overwrite.\n#\n# Apply mode prompts for confirmation unless --force is passed.\n#\n# Exit codes:\n#   0 — success (dry-run lists; apply completed)\n#   1 — usage error / SHA mismatch / refused destination\n#   2 — fatal (tarball corrupt, no permissions)\n\nset -euo pipefail\n\nTARBALL=\"\"\nAPPLY=0\nFORCE=0\nQUIET=0\nDEST_OVERRIDE=\"\"\nPROJECT_SLUG_OVERRIDE=\"\"\nRESTORE_PLANS=0\nRESTORE_AGENT_METRICS=0\n\nusage() {\n  cat <<EOF\nceo-restore.sh — restore framework state from a ceo-backup tarball\n\nUsage:\n  ceo-restore.sh <tarball> [options]\n\nOptions:\n  --apply                  Commit the restore (default: dry-run)\n  --force                  Skip the apply confirmation prompt\n  --quiet                  Suppress progress\n  --dest <dir>             Restore destination (default: CEO_AUDIT_LOG_DIR or ~/.claude/projects/<slug>)\n  --project-slug <name>    Override slug for default dest path\n  --restore-plans          Also restore plans/ subdir if present in tarball\n  --restore-agent-metrics  Also restore .claude/agent-metrics.md\n  -h, --help               This message\n\nThe default --dry-run mode:\n  - verifies tarball SHA256 against the .sha256 sidecar (if present)\n  - lists every file the apply mode would write\n  - exits 0 on success; non-zero only on integrity failure\n\nThe --apply mode:\n  - re-verifies SHA256\n  - prompts for confirmation (unless --force)\n  - extracts audit/ + memory/ to <dest>\n  - extracts agent-metrics.md / plans/ to CWD's .claude/ if --restore-* flags\nEOF\n}\n\nwhile [[ $# -gt 0 ]]; do\n  case \"$1\" in\n    --apply) APPLY=1; shift ;;\n    --force) FORCE=1; shift ;;\n    --quiet) QUIET=1; shift ;;\n    --dest) DEST_OVERRIDE=\"$2\"; shift 2 ;;\n    --project-slug) PROJECT_SLUG_OVERRIDE=\"$2\"; shift 2 ;;\n    --restore-plans) RESTORE_PLANS=1; shift ;;\n    --restore-agent-metrics) RESTORE_AGENT_METRICS=1; shift ;;\n    -h|--help) usage; exit 0 ;;\n    --*) echo \"unknown flag: $1\" >&2; usage >&2; exit 1 ;;\n    *)\n      if [ -z \"$TARBALL\" ]; then\n        TARBALL=\"$1\"; shift\n      else\n        echo \"extra argument: $1\" >&2; usage >&2; exit 1\n      fi\n      ;;\n  esac\ndone\n\nlog() {\n  if [ \"$QUIET\" -eq 0 ]; then\n    echo \"$@\" >&2\n  fi\n  return 0\n}\n\nif [ -z \"$TARBALL\" ]; then\n  echo \"error: tarball path required\" >&2\n  usage >&2\n  exit 1\nfi\n\nif [ ! -f \"$TARBALL\" ]; then\n  echo \"error: tarball not found: $TARBALL\" >&2\n  exit 1\nfi\n\n# The framework SINGLE resolver (ADR-001; PLAN-182 OQ-6, S326). The old\n# default slug `ceo-orchestration` named THIS framework, not the adopter: every\n# project under one $HOME backed up -- and restored -- the same shared dir.\n# `--project-slug` / CEO_PROJECT_NAME stay as EXPLICIT operator overrides;\n# nothing is defaulted from a literal. No resolver on disk (partial upgrade)\n# => fail loud rather than guess where the state lives.\n# `|| true` inside: under `set -e` a failed `cd` (script copied outside a\n# framework tree) would abort this assignment SILENTLY, before _resolve_rp can\n# print its loud `fatal:`. An empty dir here simply fails the -f test below.\n_RP_DIR=\"$(dirname \"${BASH_SOURCE[0]}\")/../hooks/_lib\"\n_RP=\"$( { cd \"$_RP_DIR\" 2>/dev/null && pwd; } || printf '%s' \"$_RP_DIR\" )/runtime_paths.py\"\n_project_root() {\n  # The project the state belongs to (rail r1 P2 + r3 P1):\n  #   1. the harness-set CLAUDE_PROJECT_DIR;\n  #   2. else walk up from the CWD to the nearest `.claude/` (the resolver\n  #      falls back to the CWD, so a call from a SUBDIRECTORY would otherwise\n  #      name the subdirectory);\n  #   3. else the project this script is INSTALLED in — it lives at\n  #      <project>/.claude/scripts/ — because the documented cron entry\n  #      (docs/DISASTER-RECOVERY.md) invokes it by absolute path with\n  #      CWD=$HOME and no CLAUDE_PROJECT_DIR, where step 2 finds nothing.\n  # Nothing at all => failure (never a guessed slug).\n  if [ -n \"${CLAUDE_PROJECT_DIR:-}\" ]; then printf '%s' \"$CLAUDE_PROJECT_DIR\"; return 0; fi\n  # A project is a directory with the framework INSTALL MARKER — not merely a\n  # `.claude/` (rail r4 P1): under the documented cron, CWD=$HOME and the\n  # user's GLOBAL ~/.claude exists, so a bare `-d .claude` test picked $HOME\n  # as the project and the backup targeted the wrong slug with exit 0.\n  local cur\n  cur=\"$(pwd)\"\n  while [ \"$cur\" != \"/\" ]; do\n    if [ -f \"$cur/.claude/.framework-version\" ]; then printf '%s' \"$cur\"; return 0; fi\n    cur=\"$(dirname \"$cur\")\"\n  done\n  local here\n  here=\"$( { cd \"$(dirname \"${BASH_SOURCE[0]}\")/../..\" 2>/dev/null && pwd; } || true )\"\n  if [ -n \"$here\" ] && [ -d \"$here/.claude/scripts\" ] && [ -d \"$here/.claude/hooks\" ]; then printf '%s' \"$here\"; return 0; fi\n  return 1\n}\n_resolve_rp() {\n  if [ ! -f \"$_RP\" ] || ! command -v python3 >/dev/null 2>&1; then\n    echo \"fatal: single resolver not found at $_RP (run scripts/upgrade.sh) -- refusing to guess the state dir\" >&2\n    return 2\n  fi\n  local root\n  root=\"$(_project_root)\" || {\n    echo \"fatal: no project root (.claude/) above $(pwd) and CLAUDE_PROJECT_DIR unset -- pass --project-slug or run from the project\" >&2\n    return 2\n  }\n  python3 \"$_RP\" --project \"$root\" \"$@\"\n}\n\n# Resolve destination. An EXPLICIT destination (--dest / CEO_AUDIT_LOG_DIR)\n# is honoured without any project discovery (pair-rail r2 P2): the slug is\n# only needed by the branch that builds the path from it.\nif [ -n \"$DEST_OVERRIDE\" ]; then\n  DEST=\"$DEST_OVERRIDE\"\nelif [ -n \"${CEO_AUDIT_LOG_DIR:-}\" ]; then\n  DEST=\"$CEO_AUDIT_LOG_DIR\"\nelif [ -n \"${PROJECT_SLUG_OVERRIDE:-}${CEO_PROJECT_NAME:-}\" ]; then\n  # An explicit operator slug names the destination directly under $HOME.\n  PROJECT_SLUG=\"${PROJECT_SLUG_OVERRIDE:-$CEO_PROJECT_NAME}\"\n  DEST=\"$HOME/.claude/projects/$PROJECT_SLUG\"\nelse\n  DEST=\"$(_resolve_rp --state-dir)\" || exit 2\nfi\n[ -n \"$DEST\" ] || { echo \"fatal: empty destination\" >&2; exit 2; }\n\nlog \"ceo-restore: tarball=$TARBALL dest=$DEST mode=$([ \"$APPLY\" -eq 1 ] && echo APPLY || echo DRY-RUN)\"\n\n_physical_dest() {\n  local raw=\"$1\" parent leaf\n  case \"$raw\" in\n    *//*|*/./*|*/../*|../*|.)\n      echo \"fatal: refused destination spelling: $raw\" >&2; return 1 ;;\n  esac\n  parent=\"$(dirname \"$raw\")\"\n  leaf=\"$(basename \"$raw\")\"\n  if [ -e \"$raw\" ] || [ -L \"$raw\" ]; then\n    [ -d \"$raw\" ] && [ ! -L \"$raw\" ] || {\n      echo \"fatal: destination must be a real directory, not a link or file\" >&2; return 1;\n    }\n    (cd -P \"$raw\" && pwd)\n    return 0\n  fi\n  [ -d \"$parent\" ] && [ ! -L \"$parent\" ] || {\n    echo \"fatal: destination parent must be a real directory\" >&2; return 1;\n  }\n  printf '%s/%s\\n' \"$(cd -P \"$parent\" && pwd)\" \"$leaf\"\n}\n\nARCHIVE_VALIDATOR=\"$(dirname \"${BASH_SOURCE[0]}\")/_restore_archive.py\"\n[ -f \"$ARCHIVE_VALIDATOR\" ] || { echo \"fatal: archive validator missing\" >&2; exit 2; }\npython3 \"$ARCHIVE_VALIDATOR\" \"$TARBALL\" || exit 2\nDEST=\"$(_physical_dest \"$DEST\")\" || exit 2\n\n# Resolve sha256 binary\nSHA256_BIN=\"\"\nif command -v sha256sum >/dev/null 2>&1; then\n  SHA256_BIN=\"sha256sum\"\nelif command -v shasum >/dev/null 2>&1; then\n  SHA256_BIN=\"shasum -a 256\"\nfi\n\n# SHA verification\nSHA_SIDE=\"$TARBALL.sha256\"\nif [ -n \"$SHA256_BIN\" ] && [ -f \"$SHA_SIDE\" ]; then\n  EXPECTED=\"$(cat \"$SHA_SIDE\" | awk '{print $1}')\"\n  ACTUAL=\"$($SHA256_BIN \"$TARBALL\" | awk '{print $1}')\"\n  if [ \"$EXPECTED\" != \"$ACTUAL\" ]; then\n    echo \"fatal: SHA256 mismatch\" >&2\n    echo \"  expected: $EXPECTED\" >&2\n    echo \"  actual:   $ACTUAL\" >&2\n    exit 2\n  fi\n  log \"sha256: verified ($ACTUAL)\"\nelse\n  log \"warning: no .sha256 sidecar found; integrity not verified\"\nfi\n\n# Validate the exact tree that both preview and apply describe.  This is before\n# the dry-run return deliberately: preview must never bless an apply it rejects.\nif [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] || [ \"$RESTORE_PLANS\" -eq 1 ]; then\n  if [ -L \"$(pwd)/.claude\" ] || [ ! -d \"$(pwd)/.claude\" ]; then\n    echo \"fatal: optional restore requires a real .claude directory in CWD\" >&2\n    exit 2\n  fi\n  if [ \"$RESTORE_PLANS\" -eq 1 ] && [ -L \"$(pwd)/.claude/plans\" ]; then\n    echo \"fatal: optional plans restore requires a real .claude/plans directory\" >&2\n    exit 2\n  fi\nfi\nSTAGE_DIR=\"$(mktemp -d -t ceo-restore-XXXXXX)\"\ntrap 'rm -rf \"$STAGE_DIR\"' EXIT\n# The validator writes ONLY the members it accepted (never `tar -x` of the\n# whole archive): a skipped macOS AppleDouble member `._<name>` never lands\n# on disk, in the preview or in the apply.\npython3 \"$ARCHIVE_VALIDATOR\" \"$TARBALL\" \"$STAGE_DIR\" || exit 2\nif find \"$STAGE_DIR\" -type l -print -quit | grep -q .; then\n  echo \"fatal: archive contains symbolic links\" >&2\n  exit 2\nfi\n\n# List contents (dry-run preview)\nlog \"\"\nlog \"tarball contents:\"\nif [ \"$QUIET\" -eq 0 ]; then\n  tar -tzf \"$TARBALL\" | sed -n '1,50{s/^/  /;p;}' >&2\nfi\n\n_refuse_link_ancestors() {\n  local path=\"$1\" stop=\"$2\"\n  if [ -L \"$path\" ]; then\n    echo \"fatal: restore target is a symbolic link: $path\" >&2\n    return 2\n  fi\n  if [ -e \"$path\" ] && [ ! -f \"$path\" ]; then\n    echo \"fatal: restore target must be a regular file: $path\" >&2\n    return 2\n  fi\n  while [ \"$path\" != \"$stop\" ]; do\n    if [ -L \"$path\" ]; then\n      echo \"fatal: restore target is a symbolic link: $path\" >&2\n      return 2\n    fi\n    path=\"$(dirname \"$path\")\"\n  done\n}\n\n_preflight_targets() {\n  local f rel target\n  if [ -d \"$STAGE_DIR/audit\" ]; then\n    for f in \"$STAGE_DIR/audit\"/*; do\n      [ -f \"$f\" ] || continue\n      _refuse_link_ancestors \"$DEST/$(basename \"$f\")\" \"$DEST\" || return 2\n    done\n  fi\n  if [ -d \"$STAGE_DIR/memory\" ]; then\n    while IFS= read -r -d '' f; do\n      rel=\"${f#\"$STAGE_DIR/memory/\"}\"\n      target=\"$DEST/memory/$rel\"\n      _refuse_link_ancestors \"$target\" \"$DEST\" || return 2\n    done < <(find \"$STAGE_DIR/memory\" -type f -print0)\n  fi\n  if [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] && [ -f \"$STAGE_DIR/agent-metrics.md\" ]; then\n    _refuse_link_ancestors \"$(pwd)/.claude/agent-metrics.md\" \"$(pwd)\" || return 2\n  fi\n  if [ \"$RESTORE_PLANS\" -eq 1 ] && [ -d \"$STAGE_DIR/plans\" ]; then\n    while IFS= read -r -d '' f; do\n      rel=\"${f#\"$STAGE_DIR/plans/\"}\"\n      _refuse_link_ancestors \"$(pwd)/.claude/plans/$rel\" \"$(pwd)\" || return 2\n    done < <(find \"$STAGE_DIR/plans\" -type f -print0)\n  fi\n}\n\n_preflight_targets || exit 2\n\nif [ \"$APPLY\" -eq 0 ]; then\n  log \"\"\n  log \"[dry-run] no files modified.\"\n  log \"[dry-run] re-run with --apply to commit (will prompt unless --force).\"\n  exit 0\nfi\n\n# ----- APPLY -----\nif [ \"$FORCE\" -ne 1 ]; then\n  read -r -p \"Proceed with restore into $DEST? [yes/no] \" ANSWER\n  [ \"$ANSWER\" = \"yes\" ] || { echo \"aborted.\"; exit 1; }\nfi\nmkdir -p \"$DEST\"\n\n# Restore audit/\nif [ -d \"$STAGE_DIR/audit\" ]; then\n  for f in \"$STAGE_DIR/audit\"/*; do\n    [ -f \"$f\" ] && [ ! -L \"$f\" ] || continue\n    cp -p -- \"$f\" \"$DEST/$(basename \"$f\")\"\n  done\n  log \"restored: audit/ → $DEST/\"\nfi\n\n# Restore memory/\nif [ -d \"$STAGE_DIR/memory\" ]; then\n  mkdir -p \"$DEST/memory\"\n  while IFS= read -r -d '' f; do\n    rel=\"${f#\"$STAGE_DIR/memory/\"}\"\n    mkdir -p \"$DEST/memory/$(dirname \"$rel\")\"\n    cp -p -- \"$f\" \"$DEST/memory/$rel\"\n  done < <(find \"$STAGE_DIR/memory\" -type f -print0)\n  log \"restored: memory/ → $DEST/memory/\"\nfi\n\n# Optional: agent-metrics.md\nif [ \"$RESTORE_AGENT_METRICS\" -eq 1 ] && [ -f \"$STAGE_DIR/agent-metrics.md\" ]; then\n  if [ -d \"$(pwd)/.claude\" ]; then\n    cp -p \"$STAGE_DIR/agent-metrics.md\" \"$(pwd)/.claude/agent-metrics.md\"\n    log \"restored: agent-metrics.md → $(pwd)/.claude/agent-metrics.md\"\n  else\n    log \"warning: no .claude/ in CWD; agent-metrics.md not restored\"\n  fi\nfi\n\n# Optional: plans/\nif [ \"$RESTORE_PLANS\" -eq 1 ] && [ -d \"$STAGE_DIR/plans\" ]; then\n  if [ -d \"$(pwd)/.claude\" ]; then\n    mkdir -p \"$(pwd)/.claude/plans\"\n    while IFS= read -r -d '' f; do\n      rel=\"${f#\"$STAGE_DIR/plans/\"}\"\n      mkdir -p \"$(pwd)/.claude/plans/$(dirname \"$rel\")\"\n      cp -p -- \"$f\" \"$(pwd)/.claude/plans/$rel\"\n    done < <(find \"$STAGE_DIR/plans\" -type f -print0)\n    log \"restored: plans/ → $(pwd)/.claude/plans/\"\n  else\n    log \"warning: no .claude/ in CWD; plans/ not restored\"\n  fi\nfi\n\nlog \"\"\nlog \"restore complete.\"\nexit 0\n","numLines":356,"startLine":1,"totalLines":356}},"tool_result_meta":[{"id":"toolu_01EfAM3PaMLp6bvEgTcxTuKZ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011Ch7BfQZQbkY2oG17Bx5N6","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_012tWUxdnydKFejMfgb2dwvj","name":"Read","input":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/_restore_archive.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3990,"cache_read_input_tokens":152826,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3990},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"261e4768-bfba-44df-8655-b8fb9a3eb93f","uuid":"6da34f1a-e2cd-469e-975b-4a8f1362771c","timestamp":"2026-11-16T19:47:51.849Z","request_id":"req_011Ch7BfQLzpwHuCEwFHZwxh","wire_tool_inputs":{"toolu_012tWUxdnydKFejMfgb2dwvj":{"file_path":"/private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/kit-repass-tree.n5R3O9/tree/.claude/scripts/_restore_archive.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012tWUxdnydKFejMfgb2dwvj","type":"tool_result","content":"1\t#!/usr/bin/env python3\n2\t\"\"\"Validate ceo-restore archive members and extract the accepted ones.\n3\t\n4\t``<tarball>`` checks every member (exit 2 on the first refused one);\n5\t``<tarball> <stage-dir>`` also writes ONLY the accepted members there, so the\n6\tpreview and the apply of ceo-restore.sh share one rule and one extraction.\n7\t\n8\tThe archive must parse to its end: tarfile stops listing members, with no\n9\terror, at a truncated or invalid header, so the member list must end on an\n10\tend-of-archive (all-zero) block and the compressed stream must read cleanly\n11\tto its end.  Two members with the same name are refused, and so are the key\n12\tfiles ``audit/audit-key`` and ``audit/.salt`` in any letter case (the default\n13\tmacOS disk, APFS, ignores case).  Every sparse member is refused, an\n14\tAppleDouble one included, before anything is written.\n15\t\n16\tmacOS tar writes an AppleDouble member ``._<name>`` (extended-attribute\n17\tmetadata) before each entry that carries extended attributes.  It is SKIPPED\n18\t-- checked, never written -- only when it is a regular file whose companion\n19\t(same directory, basename without ``._``; the companion of ``._.`` is the\n20\tdirectory itself) is an accepted member.  Every other ``._`` member is refused.\n21\t\"\"\"\n22\tfrom __future__ import annotations\n23\t\n24\timport os\n25\timport shutil\n26\timport sys\n27\timport tarfile\n28\timport zlib\n29\tfrom typing import Iterable, List, Optional, Tuple\n30\t\n31\t_APPLEDOUBLE_PREFIX = \"._\"\n32\t_KEY_FILES = (\"audit/audit-key\", \"audit/.salt\")\n33\t_CHUNK = 1 << 16\n34\t\n35\t\n36\tdef _normalized(name: str) -> str:\n37\t    \"\"\"Return an archive-relative name or raise for an alias/traversal.\"\"\"\n38\t    if name == \".\":\n39\t        return \"\"\n40\t    if name.startswith(\"./\"):\n41\t        name = name[2:]\n42\t    if not name or name.startswith(\"/\") or \"//\" in name:\n43\t        raise ValueError(\"unsafe path\")\n44\t    parts = name.split(\"/\")\n45\t    if any(part in (\"\", \".\", \"..\") for part in parts):\n46\t        raise ValueError(\"unsafe path\")\n47\t    return name.rstrip(\"/\")\n48\t\n49\t\n50\tdef _allowed(name: str) -> bool:\n51\t    if name in (\"agent-metrics.md\", \"MANIFEST.txt\"):\n52\t        return True\n53\t    return name in (\"audit\", \"memory\", \"plans\") or any(\n54\t        name.startswith(prefix) for prefix in (\"audit/\", \"memory/\", \"plans/\")\n55\t    )\n56\t\n57\t\n58\tdef _appledouble_companion(name: str) -> Optional[str]:\n59\t    \"\"\"Return the companion of an AppleDouble name, None for any other name.\n60\t\n61\t    Raises ValueError when the basename carries the prefix but cannot name a\n62\t    companion (``._`` alone, ``._..``).\n63\t    \"\"\"\n64\t    head, _, base = name.rpartition(\"/\")\n65\t    if not base.startswith(_APPLEDOUBLE_PREFIX):\n66\t        return None\n67\t    target = base[len(_APPLEDOUBLE_PREFIX):]\n68\t    if target == \".\":\n69\t        return head\n70\t    if target in (\"\", \"..\"):\n71\t        raise ValueError(\"no companion\")\n72\t    return head + \"/\" + target if head else target\n73\t\n74\t\n75\tdef validate(members: Iterable[tarfile.TarInfo]) -> List[tarfile.TarInfo]:\n76\t    \"\"\"Reject every non-data member and every name outside the restore layout.\n77\t\n78\t    Returns the members to extract, in archive order.  AppleDouble members\n79\t    that pass the companion rule are left out of the result.\n80\t    \"\"\"\n81\t    accepted: List[tarfile.TarInfo] = []\n82\t    accepted_names = set()\n83\t    seen = set()\n84\t    appledouble: List[Tuple[tarfile.TarInfo, str]] = []\n85\t    for member in members:\n86\t        try:\n87\t            name = _normalized(member.name)\n88\t        except ValueError:\n89\t            raise ValueError(\"refused path: {0}\".format(member.name))\n90\t        if name in seen:\n91\t            raise ValueError(\"refused duplicate path: {0}\".format(member.name))\n92\t        seen.add(name)\n93\t        if member.issparse():\n94\t            raise ValueError(\"refused sparse member: {0}\".format(member.name))\n95\t        try:\n96\t            companion = _appledouble_companion(name) if name else None\n97\t        except ValueError:\n98\t            raise ValueError(\"refused AppleDouble name: {0}\".format(member.name))\n99\t        if companion is not None:\n100\t            if not member.isfile():\n101\t                raise ValueError(\"refused member type: {0}\".format(member.name))\n102\t            appledouble.append((member, companion))\n103\t            continue\n104\t        if not name:\n105\t            if member.isdir():\n106\t                accepted.append(member)\n107\t                accepted_names.add(name)\n108\t                continue\n109\t            raise ValueError(\"refused member type: {0}\".format(member.name))\n110\t        if not _allowed(name):\n111\t            raise ValueError(\"refused path: {0}\".format(member.name))\n112\t        if not (member.isfile() or member.isdir()):\n113\t            raise ValueError(\"refused member type: {0}\".format(member.name))\n114\t        if name.casefold() in _KEY_FILES:\n115\t            raise ValueError(\"refused path: {0}\".format(member.name))\n116\t        accepted.append(member)\n117\t        accepted_names.add(name)\n118\t    for member, companion in appledouble:\n119\t        if companion not in accepted_names:\n120\t            raise ValueError(\"refused path: {0}\".format(member.name))\n121\t    return accepted\n122\t\n123\t\n124\tdef complete_members(archive: tarfile.TarFile) -> List[tarfile.TarInfo]:\n125\t    \"\"\"Return every member, or raise unless the archive parsed to its end.\n126\t\n127\t    The member walk must stop on a full all-zero block (the end-of-archive\n128\t    marker) and the rest of the compressed stream must decompress with a\n129\t    valid checksum; otherwise members after the cut would vanish silently.\n130\t    \"\"\"\n131\t    stream = archive.fileobj\n132\t    try:\n133\t        members = archive.getmembers()\n134\t        stream.seek(archive.offset)\n135\t        block = stream.read(tarfile.BLOCKSIZE)\n136\t        while stream.read(_CHUNK):\n137\t            pass\n138\t    except (EOFError, OSError, tarfile.ReadError, zlib.error) as exc:\n139\t        raise ValueError(\"refused truncated or corrupt archive: {0}\".format(exc))\n140\t    if len(block) != tarfile.BLOCKSIZE or block.count(b\"\\0\") != tarfile.BLOCKSIZE:\n141\t        raise ValueError(\"refused truncated or corrupt archive: no end-of-archive \"\n142\t                         \"block at byte {0}\".format(archive.offset))\n143\t    return members\n144\t\n145\t\n146\tdef extract(archive: tarfile.TarFile, members: Iterable[tarfile.TarInfo],\n147\t            stage: str) -> None:\n148\t    \"\"\"Write the given (already validated) members under ``stage``.\"\"\"\n149\t    nofollow = getattr(os, \"O_NOFOLLOW\", 0)\n150\t    for member in members:\n151\t        name = _normalized(member.name)\n152\t        if not name:\n153\t            continue\n154\t        path = os.path.join(stage, *name.split(\"/\"))\n155\t        if member.isdir():\n156\t            os.makedirs(path, exist_ok=True)\n157\t            continue\n158\t        parent = os.path.dirname(path)\n159\t        if parent:\n160\t            os.makedirs(parent, exist_ok=True)\n161\t        source = archive.extractfile(member)\n162\t        if source is None:\n163\t            raise ValueError(\"refused member type: {0}\".format(member.name))\n164\t        # O_EXCL: a name that lands on a file already written (two members\n165\t        # whose names differ only in letter case, on the default macOS disk,\n166\t        # APFS) is refused, never merged into the earlier file with the\n167\t        # earlier mode.\n168\t        try:\n169\t            fd = os.