+    # whole upgrade instead of falling through to the empty-answer path below.
+    ''|*[!0-9]*) _utn_out="$( ls -ld "$1" 2>/dev/null | awk 'NR==1 {print $2}' || true )" ;;
+  esac
+  case "$_utn_out" in
+    ''|*[!0-9]*) printf '' ;;
+    *)           printf '%s\n' "$_utn_out" ;;
+  esac
