+      - name: Pack dry-run (RC proof — no archive, no registry write)
+        # The pack the GA run will publish, on the pinned toolchain, with
+        # `--dry-run` (npm writes no .tgz). The per-file notices go to a
+        # scratch log; the job prints only its tail (the tarball summary:
+        # name, version, sizes, file count) — or the whole log on failure.
+        working-directory: npm
+        run: |
+          set -euo pipefail
+          LOG="${RUNNER_TEMP}/rc-pack-dry-run.log"
+          if ! npm pack --dry-run 2> "$LOG"; then
+            cat "$LOG"
+            echo "::error::npm pack --dry-run failed on node $(node --version) + npm $(npm --version)"
+            exit 1
+          fi
+          tail -n 12 "$LOG"
+          echo "OK: npm pack --dry-run on node $(node --version) + npm $(npm --version) — nothing was written to the registry"
