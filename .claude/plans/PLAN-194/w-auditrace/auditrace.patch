+    for i in range(iterations):
+        if kind == "spawn":
+            audit_log.append_entry({"action": "agent_spawn", "session_id": "race-spawn-%d" % worker_id},
+                                   paths=paths, threshold_bytes=10 ** 9)
+        else:
