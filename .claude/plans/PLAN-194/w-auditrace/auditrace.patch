+def _race_writer(kind, worker_id, iterations, expected_log, barrier):
+    """Child (spawn): one writer kind; exit 3 unless the log is the sandbox's."""
+    if os.environ.get("CEO_AUDIT_LOG_PATH") != expected_log:
+        sys.exit(3)
+    import audit_log
