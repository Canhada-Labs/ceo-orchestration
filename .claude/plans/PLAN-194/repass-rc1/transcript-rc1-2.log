   930	        "record_id": record_id,
   931	        "spool_uuid": spool_uuid,
   932	        "ordinal_within_file": ordinal,
   933	        "sha256_of_line": sha256_of_line,
   934	        "op": op,
   935	        "wall_ns": time.time_ns(),
   936	    }
