  1138	# ---------------------------------------------------------------------------
  1139	# Tail read of canonical log (Phase 4 prev_hmac + _drain_sha256 set)
  1140	# ---------------------------------------------------------------------------
  1141	
  1142	
  1143	def _read_canonical_tail(
  1144	    log_path: Path, k_lines: int
  1145	) -> Tuple[Optional[bytes], List[Dict[str, Any]]]:
  1146	    """Return (prev_hmac_bytes_or_None, last_k_entries) from canonical log.
  1147	
  1148	    Reads up to k_lines from EOF using a backward chunked scan. Returns the
  1149	    last entry's hmac (raw bytes) plus the parsed dicts for the last K
  1150	    well-formed JSON lines. Empty / missing log → (None, []).
  1151	    """
  1152	    if not log_path.exists():
  1153	        return None, []
  1154	    try:
  1155	        size = log_path.stat().st_size
  1156	    except OSError:
  1157	        return None, []
  1158	    if size == 0:
  1159	        return None, []
  1160	
  1161	    chunk = 8192
  1162	    buf = b""
  1163	    lines: List[bytes] = []
  1164	    try:
  1165	        with log_path.open("rb") as f:
  1166	            pos = size
  1167	            while pos > 0 and len(lines) <= k_lines:
  1168	                read = min(chunk, pos)
  1169	                pos -= read
  1170	                f.seek(pos)
  1171	                buf = f.read(read) + buf
  1172	                parts = buf.split(b"\n")
  1173	                # First element may be a partial fragment until we read
  1174	                # further; keep it in buf, take the tail-complete lines.
  1175	                buf = parts[0]
  1176	                # parts[1:] are complete lines (after the first newline).
  1177	                # Reverse so we accumulate newest-first.
  1178	                for ln in reversed(parts[1:]):
  1179	                    if ln:
  1180	                        lines.append(ln)
