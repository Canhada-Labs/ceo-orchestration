   979	        # the envelopes for the next flush attempt (best-effort durability).
   980	        _JOURNAL_BUFFER[pid] = []
   981	    except FileLockTimeout:
   982	        _breadcrumb(f"journal flock timeout pid={pid}")
   983	    except OSError as e:
   984	        _breadcrumb(f"journal flush failed: {type(e).__name__}: {e}")
