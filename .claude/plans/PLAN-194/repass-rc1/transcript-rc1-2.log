   691	def _strict_pairs(pairs: List[Tuple[str, Any]]) -> Dict[str, Any]:
   692	    """object_pairs_hook: a duplicate key is ambiguous (RFC 8259 §4) — refused, never last-wins."""
   693	    out: Dict[str, Any] = {}
