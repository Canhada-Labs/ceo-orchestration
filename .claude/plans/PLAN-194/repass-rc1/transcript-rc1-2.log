   304	def audit_paths() -> Dict[str, Path]:
   305	    """Resolve the audit log paths from env vars with sensible defaults."""
   306	    home = Path(os.environ.get("HOME") or str(Path.home()))
   307	    default_dir = _rp_state_dir()
   308	
   309	    audit_dir = Path(os.environ.get("CEO_AUDIT_LOG_DIR") or str(default_dir))
   310	    env_log = os.environ.get("CEO_AUDIT_LOG_PATH")
   311	    audit_log = Path(env_log) if env_log else audit_dir / "audit-log.jsonl"
   312	    # PLAN-182 W1 rail r1 P1-2: family-follows-log — when the LOG moved via
   313	    # CEO_AUDIT_LOG_PATH, lock + errors follow its resolved parent (same
   314	    # derivation as audit_emit._log_family_dir / audit_hmac), never the
   315	    # default dir. One log, one lock, for every writer.
   316	    family_dir = Path(env_log).resolve().parent if env_log else audit_dir
   317	    audit_err = Path(
   318	        os.environ.get("CEO_AUDIT_LOG_ERR") or str(family_dir / "audit-log.errors")
   319	    )
   320	    audit_lock = Path(
   321	        os.environ.get("CEO_AUDIT_LOG_LOCK")
   322	        or str(family_dir / "audit-log.lock")
   323	    )
   324	    return {
   325	        "dir": audit_dir,
   326	        "log": audit_log,
   327	        "err": audit_err,
   328	        "lock": audit_lock,
   329	    }
