  1096	def should_drain() -> bool:
  1097	    """Return True if current spool meets event-count or staleness trigger.
  1098	
  1099	    P2-1: event-count trigger uses an actual newline-count over the spool
  1100	    body (capped at DRAIN_TRIGGER_SIZE + 2 to keep the probe cheap), NOT
  1101	    a byte-size proxy. Header is 1 line; we trigger when body lines >=
  1102	    DRAIN_TRIGGER_SIZE.
  1103	    """
  1104	    try:
  1105	        pid = os.getpid()
  1106	        p = _spool_path(pid)
  1107	        if not p.exists():
  1108	            return False
  1109	        st = p.stat()
  1110	        if st.st_size == 0:
  1111	            return False
  1112	        # Staleness trigger first (cheap)
  1113	        age_ms = (time.time() - st.st_mtime) * 1000.0
  1114	        if age_ms > DRAIN_TRIGGER_MTIME_MS:
  1115	            return True
  1116	        # P2-1: honest newline count, capped at DRAIN_TRIGGER_SIZE + 2
  1117	        # (1 for header + 1 to early-exit once we cross the threshold).
  1118	        cap = DRAIN_TRIGGER_SIZE + 2
  1119	        count = 0
  1120	        try:
  1121	            with p.open("rb") as f:
  1122	                while count < cap:
  1123	                    chunk = f.read(8192)
  1124	                    if not chunk:
  1125	                        break
  1126	                    count += chunk.count(b"\n")
  1127	                    if count >= cap:
  1128	                        break
  1129	        except OSError:
  1130	            return False
  1131	        # Body lines = count - 1 (header is line 1). Trigger when
  1132	        # body_lines >= DRAIN_TRIGGER_SIZE → count >= DRAIN_TRIGGER_SIZE+1.
  1133	        return count >= (DRAIN_TRIGGER_SIZE + 1)
  1134	    except Exception:
  1135	        return False
