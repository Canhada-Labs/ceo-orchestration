  1083	            _IN_SPOOL_APPEND = False
  1084	            _breadcrumb(f"spool flock timeout pid={pid}")
  1085	            return
  1086	    except Exception as e:  # fail-open invariant
  1087	        _IN_SPOOL_APPEND = False
  1088	        _breadcrumb(f"spool_append unexpected: {type(e).__name__}: {e}")
