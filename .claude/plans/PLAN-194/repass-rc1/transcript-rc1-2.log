   685	
   686	#: Fixtures are depth 4 today; deeper ones are refused BEFORE the recursive
   687	#: helpers run, so they cannot crash the gate at the interpreter limit (rail r1).
   688	_MAX_FIXTURE_DEPTH = 32
   689	
   690	
   691	def _strict_pairs(pairs: List[Tuple[str, Any]]) -> Dict[str, Any]:
   692	    """object_pairs_hook: a duplicate key is ambiguous (RFC 8259 §4) — refused, never last-wins."""
   693	    out: Dict[str, Any] = {}
   694	    for key, value in pairs:
   695	        if key in out:
   696	            raise ValueError(f"duplicate key {repr(key)[:80]}")
   697	        out[key] = value
   698	    return out
   699	
