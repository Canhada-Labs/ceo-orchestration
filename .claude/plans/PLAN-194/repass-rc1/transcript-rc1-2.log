   473	def read_prev_hmac() -> bytes:
   474	    """Return the binary previous-HMAC or the genesis value.
   475	
   476	    Reads the sidecar ``audit-log.last-hmac`` (hex-encoded 64 chars +
   477	    optional trailing newline). If absent or malformed → genesis.
   478	    Fail-open invariant: a corrupted sidecar must not block writes.
   479	    The log tail itself remains the source of truth; verify-chain
   480	    re-reads from the log, not the sidecar.
   481	
   482	    MUST be called WITH the audit-log FileLock held.
   483	    """
   484	    p = last_hmac_path()
   485	    if not p.exists():
   486	        return GENESIS_PREV
   487	    try:
   488	        raw = p.read_text(encoding="utf-8").strip()
   489	    except OSError:
   490	        return GENESIS_PREV
   491	    if len(raw) != HMAC_HEX_LEN:
   492	        return GENESIS_PREV
   493	    try:
   494	        return bytes.fromhex(raw)
   495	    except ValueError:
   496	        return GENESIS_PREV
