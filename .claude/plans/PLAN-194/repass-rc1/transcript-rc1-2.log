   701	def _refuse_constant(name: str) -> Any:
   702	    """parse_constant of every JSON read in THIS module: NaN/Infinity are not JSON (rail r3)."""
   703	    raise ValueError(f"non-standard JSON constant {name}")
   704	
   705	
   706	def _fixture_defect(doc: Any) -> Optional[str]:
   707	    """Iterative walk of the PARSED fixture: first defect or None — nesting past the cap, or a
   708	    doubled brace in any key/string (retired marker / placeholder grammar, C6; escaped too)."""
   709	    stack: List[Tuple[Any, int]] = [(doc, 1)]
   710	    while stack:
   711	        node, depth = stack.pop()
   712	        if depth > _MAX_FIXTURE_DEPTH:
   713	            return f"nesting deeper than {_MAX_FIXTURE_DEPTH}"
   714	        if isinstance(node, str) and "{{" in node:
   715	            return ("doubled-brace marker (the retired form / an install-time "
   716	                    f"placeholder grammar) — the runtime marker is {FIXTURE_PROJECT_PLACEHOLDER}")
   717	        if isinstance(node, dict):
   718	            stack.extend((x, depth + 1) for kv in node.items() for x in kv)
   719	        elif isinstance(node, list):
   720	            stack.extend((x, depth + 1) for x in node)
   721	    return None
