   924	    parser.add_argument(
   925	        "--settings",
   926	        action="append",
   927	        type=Path,
   928	        default=None,
   929	        help="settings file(s) to scan (default: dogfood + template)",
   930	    )
   931	    parser.add_argument("--fixtures-dir", type=Path, default=None)
   932	    parser.add_argument("--noop-allowlist", type=Path, default=None)
   933	    parser.add_argument(
   934	        "--static", action="store_true", help="run only the static checks"
   935	    )
   936	    parser.add_argument(
   937	        "--replay", action="store_true", help="run only the behavioral replay"
   938	    )
   939	    parser.add_argument(
   940	        "--no-exec-bit",
   941	        action="store_true",
   942	        help="skip delegation to check-active-hooks-executable.py",
   943	    )
   944	    args = parser.parse_args(argv)
   945	
   946	    repo_root = (args.repo_root or _default_repo_root()).resolve()
   947	    do_static = args.static or not args.replay
   948	    do_replay = args.replay or not args.static
   949	
   950	    if args.settings:
   951	        settings_paths = [p if p.is_absolute() else repo_root / p for p in args.settings]
   952	    else:
   953	        settings_paths = [repo_root / rel for rel in DEFAULT_SETTINGS_REL]
   954	
   955	    findings: List[Finding] = []
   956	    try:
   957	        if do_static:
   958	            findings.extend(
   959	                run_static(
   960	                    repo_root,
   961	                    settings_paths,
   962	                    noop_allowlist_path=args.noop_allowlist,
   963	                    include_exec_bit=not args.no_exec_bit,
   964	                )
   965	            )
   966	    except ValueError as exc:
   967	        print(f"::error::{exc}", file=sys.stderr)
   968	        return 2
   969	
   970	    if do_replay:
