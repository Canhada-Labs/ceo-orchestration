   951	def _flush_journal_buffer(pid: int) -> None:
   952	    """Flush buffered journal envelopes for PID with a single fsync.
   953	
   954	    P1-2: invoked at drain boundary, signal handler, atexit, or when
   955	    buffer hits _JOURNAL_FLUSH_EVERY. Best-effort fail-open. Acquires
   956	    the per-PID journal flock around the append+fsync window.
   957	    """
   958	    buf = _JOURNAL_BUFFER.get(pid)
   959	    if not buf:
   960	        return
   961	    p = _journal_path(pid)
   962	    try:
   963	        p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   964	    except OSError as e:
   965	        _breadcrumb(f"journal mkdir failed: {type(e).__name__}: {e}")
   966	        return
   967	    payload = b"".join(buf)
   968	    try:
   969	        with FileLock(_journal_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT):
   970	            fd = os.open(
   971	                str(p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600,
   972	            )
   973	            try:
   974	                os.write(fd, payload)
   975	                os.fsync(fd)
   976	            finally:
   977	                os.close(fd)
