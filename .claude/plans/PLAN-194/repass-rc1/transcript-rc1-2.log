   898	def _sha256_of_canonical_json(entry_clean: Dict[str, Any]) -> str:
   899	    """sha256 over the canonical_json bytes (deterministic idempotence marker).
   900	
   901	    entry_clean MUST exclude internal _drain_* metadata + hmac field. The
   902	    canonical_json encoder is the same one ADR-055 HMAC chain uses, so the
   903	    digest is reproducible across re-drains.
   904	    """
   905	    if _canonical_json is None:
   906	        raw = json.dumps(entry_clean, sort_keys=True, separators=(",", ":"),
   907	                         ensure_ascii=False).encode("utf-8")
   908	    else:
   909	        raw = _canonical_json.encode(entry_clean)
   910	    return hashlib.sha256(raw).hexdigest()
