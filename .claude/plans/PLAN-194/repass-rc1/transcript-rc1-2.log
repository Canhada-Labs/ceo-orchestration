   676	def _substitute_placeholders(node: Any, repo_root: Path) -> Any:
   677	    if isinstance(node, str):
   678	        return node.replace(FIXTURE_PROJECT_PLACEHOLDER, str(repo_root))
   679	    if isinstance(node, dict):
   680	        return {k: _substitute_placeholders(v, repo_root) for k, v in node.items()}
   681	    if isinstance(node, list):
   682	        return [_substitute_placeholders(v, repo_root) for v in node]
   683	    return node
