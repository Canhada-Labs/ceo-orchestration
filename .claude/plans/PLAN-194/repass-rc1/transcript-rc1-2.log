   229	def iter_hook_entries(
   230	    data: Dict[str, Any],
   231	) -> Iterable[Tuple[str, int, Dict[str, Any], Dict[str, Any]]]:
   232	    """Yield ``(event_name, entry_index, matcher_entry, hook_dict)`` for
   233	    every ``{"type": "command", ...}``-shaped hook in ``data["hooks"]``."""
   234	    hooks = data.get("hooks", {})
   235	    if not isinstance(hooks, dict):
   236	        return
   237	    for event_name, matcher_blocks in hooks.items():
   238	        if not isinstance(matcher_blocks, list):
   239	            continue
   240	        for idx, entry in enumerate(matcher_blocks):
   241	            if not isinstance(entry, dict):
   242	                continue
   243	            for hook in entry.get("hooks", []) or []:
   244	                if isinstance(hook, dict):
   245	                    yield event_name, idx, entry, hook
