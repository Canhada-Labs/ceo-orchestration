   832	
   833	            # C3: program, argv, env and cwd come from THIS gate's table and _replay_env, never
   834	            # from the fixture (its ``hook`` field is documentation); the fixture is stdin data.
   835	            hook_path = repo_root / ".claude" / "hooks" / hook_name
   836	            if not hook_path.is_file():
   837	                findings.append(
   838	                    _red("replay", loc, f"hook under test not found: {hook_path}")
   839	                )
   840	                continue
   841	            try:
   842	                proc = subprocess.run(
   843	                    [sys.executable, str(hook_path)],
   844	                    input=json.dumps(payload),
   845	                    capture_output=True,
   846	                    text=True,
   847	                    env=env,
   848	                    cwd=str(repo_root),
   849	                    timeout=timeout,
   850	                )
   851	            except (subprocess.TimeoutExpired, OSError, ValueError) as exc:
   852	                # ValueError: stdout that does not decode as text.
   853	                findings.append(
   854	                    _red(
   855	                        "replay",
   856	                        loc,
   857	                        f"control errored ({type(exc).__name__}) — rail NOT certified alive",
   858	                    )
   859	                )
   860	                continue
   861	            # The WHOLE stdout is ONE JSON value: a preamble or a second object is not a
   862	            # decision (rail r3). No .strip(): it also drops \x0b, \x0c, NBSP and U+2028, which JSON
   863	            # forbids; json.loads already allows JSON's own whitespace (space, tab, CR, LF).
