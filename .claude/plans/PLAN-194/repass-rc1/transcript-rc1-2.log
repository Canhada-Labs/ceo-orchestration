   913	def _write_journal_envelope(
   914	    pid: int,
   915	    record_id: str,
   916	    spool_uuid: str,
   917	    ordinal: int,
   918	    sha256_of_line: str,
   919	    op: str,
   920	    drain_epoch: Optional[str] = None,
   921	) -> None:
   922	    """Buffer + amortized-fsync journal envelope. Best-effort fail-open.
   923	
   924	    P1-2: NOT a hot-path fsync. Envelopes are buffered in
   925	    _JOURNAL_BUFFER[pid]; flushed + fsync'd at drain boundary, signal
   926	    handler, atexit, or every _JOURNAL_FLUSH_EVERY writes (per ADR-055-
   927	    AMEND-1 §3 line 96: "journal fsync every 100ms OR 10 emits").
   928	    """
