   860	def _ensure_spool_ready_for_append(pid: int) -> None:
   861	    """iter3-P1-1: isolate any unterminated final line before appending.
   862	
   863	    If a prior writer died mid-write leaving no trailing newline, the next
   864	    append concatenates onto the partial line and the new event is lost.
   865	    Append a separator newline under the held spool flock to isolate the
   866	    partial fragment (Phase 3 will discard it). No-op when missing/empty/
   867	    already-newline-terminated. Caller MUST hold _spool_flock_path(pid).
   868	    Fail-open: breadcrumb on any OSError.
   869	    """
   870	    spool_p = _spool_path(pid)
   871	    try:
   872	        if not spool_p.exists():
   873	            return
   874	        st = spool_p.stat()
   875	        if st.st_size == 0:
   876	            return
   877	        with open(str(spool_p), "rb") as f:
   878	            f.seek(-1, os.SEEK_END)
   879	            last = f.read(1)
   880	        if last == b"\n":
   881	            return
   882	        fd = os.open(str(spool_p), os.O_WRONLY | os.O_APPEND, 0o600)
   883	        try:
   884	            os.write(fd, b"\n")
   885	            os.fsync(fd)
   886	        finally:
   887	            os.close(fd)
   888	        _breadcrumb(
   889	            f"spool partial-final-line isolated pid={pid} size={st.st_size}"
   890	        )
   891	    except OSError as e:  # pragma: no cover
   892	        _breadcrumb(
   893	            f"spool ready-for-append check failed pid={pid}: "
   894	            f"{type(e).__name__}: {e}"
   895	        )
