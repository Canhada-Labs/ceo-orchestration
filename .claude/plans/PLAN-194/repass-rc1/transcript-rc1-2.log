   724	def _is_block_shaped(decision: Any) -> bool:
   725	    if not isinstance(decision, dict):
   726	        return False
   727	    if decision.get("decision") in ("block", "deny"):
   728	        return True
   729	    hso = decision.get("hookSpecificOutput")
   730	    if isinstance(hso, dict) and hso.get("permissionDecision") == "deny":
   731	        return True
   732	    return False
   733	
   734	
   735	def _replay_env(repo_root: Path, scratch: Path) -> Dict[str, str]:
   736	    """Hermetic env for a replayed hook: real repo provides the hook's
   737	    dependencies (team files, guard lists, sentinel dirs); HOME, GNUPGHOME
   738	    and the audit sink are TEMP so the replay never touches the real
   739	    profile or the live audit chain; CEO_*/CLAUDE_* session overrides
   740	    (CEO_SENTINEL_UNLOCK, CEO_KERNEL_OVERRIDE, ...) are deliberately NOT
   741	    inherited — a planted violation must block under DEFAULT posture.
   742	
   743	    GNUPGHOME is pinned to a short temp dir: without it gpg auto-creates
   744	    agent sockets under $HOME and can stall for the full 15s-per-sentinel
   745	    verify timeout (observed while building this gate).
   746	    """
   747	    home = scratch / "home"
   748	    gnupg = scratch / "gnupg"
   749	    audit = scratch / "audit"
   750	    for d in (home, audit):
   751	        d.mkdir(parents=True, exist_ok=True)
   752	    gnupg.mkdir(parents=True, exist_ok=True)
   753	    os.chmod(str(gnupg), 0o700)
   754	    return {
   755	        "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
   756	        "HOME": str(home),
   757	        "GNUPGHOME": str(gnupg),
   758	        "TMPDIR": str(scratch),
   759	        "LANG": os.environ.get("LANG", "C.UTF-8"),
   760	        "CLAUDE_PROJECT_DIR": str(repo_root),
   761	        "CEO_AUDIT_LOG_DIR": str(audit),
   762	        "CEO_AUDIT_SYNC_MODE": "1",
   763	    }
   764	
   765	
   766	def run_replay(
   767	    repo_root: Path,
   768	    fixtures_dir: Optional[Path] = None,
   769	    *,
   770	    timeout: float = 30.0,
   771	    controls: Tuple[Tuple[str, str], ...] = REQUIRED_REPLAY_CONTROLS,
   772	) -> List[Finding]:
   773	    """Replay every required positive control; RED on any control that
   774	    does not observably BLOCK its planted violation."""
   775	    if (os.environ.get("CEO_SOTA_DISABLE") or "").strip() == "1":
   776	        return [
   777	            _warn(
   778	                "replay",
   779	                "env",
   780	                "CEO_SOTA_DISABLE=1 — behavioral replay skipped (static checks unaffected)",
   781	            )
   782	        ]
   783	    findings: List[Finding] = []
   784	    fdir = fixtures_dir if fixtures_dir is not None else repo_root / REPLAY_FIXTURES_REL
   785	    scratch = Path(tempfile.mkdtemp(prefix="ceo-hc-replay-"))
   786	    try:
   787	        env = _replay_env(repo_root, scratch)
   788	        for hook_name, fixture_name in controls:
   789	            loc = f"replay:{hook_name}"
   790	            fixture_path = fdir / fixture_name
   791	            if not fixture_path.is_file():
   792	                findings.append(
   793	                    _red(
   794	                        "replay",
   795	                        loc,
   796	                        f"positive-control fixture MISSING ({fixture_path}) — "
   797	                        "a control that stops firing reddens the run",
   798	                    )
   799	                )
   800	                continue
   801	            try:
   802	                doc = json.loads(
   803	                    fixture_path.read_text(encoding="utf-8"),
   804	                    object_pairs_hook=_strict_pairs,
   805	                    parse_constant=_refuse_constant,
   806	                )
   807	            except (OSError, ValueError, RecursionError) as exc:
   808	                # A traceback here would drop every other control (rail r1 P2).
   809	                why = f"{type(exc).__name__}: {exc}"
   810	                findings.append(_red("replay", loc, f"fixture unparseable ({why}) — fail-closed"))
   811	                continue
   812	            if not isinstance(doc, dict) or doc.get("expect") != "block":
   813	                findings.append(
   814	                    _red(
   815	                        "replay",
   816	                        loc,
   817	                        "fixture tampered or malformed: 'expect' must be 'block'",
   818	                    )
   819	                )
   820	                continue
   821	            payload = doc.get("payload")
   822	            if not isinstance(payload, dict):
   823	                findings.append(
   824	                    _red("replay", loc, "fixture missing 'payload' object")
   825	                )
   826	                continue
   827	            defect = _fixture_defect(doc)
   828	            if defect is not None:
   829	                findings.append(_red("replay", loc, f"fixture refused: {defect}; fail-closed"))
   830	                continue
   831	            payload = _substitute_placeholders(payload, repo_root)
   832	
   833	            # C3: program, argv, env and cwd come from THIS gate's table and _replay_env, never
   834	            # from the fixture (its ``hook`` field is documentation); the fixture is stdin data.
   835	            hook_path = repo_root / ".claude" / "hooks" / hook_name
   836	            if not hook_path.is_file():
   837	                findings.append(
   838	                    _red("replay", loc, f"hook under test not found: {hook_path}")
   839	                )
   840	                continue
   841	            try:
   842	                proc = subprocess.run(
   843	                    [sys.executable, str(hook_path)],
   844	                    input=json.dumps(payload),
   845	                    capture_output=True,
   846	                    text=True,
   847	                    env=env,
   848	                    cwd=str(repo_root),
   849	                    timeout=timeout,
   850	                )
   851	            except (subprocess.TimeoutExpired, OSError, ValueError) as exc:
   852	                # ValueError: stdout that does not decode as text.
   853	                findings.append(
   854	                    _red(
   855	                        "replay",
   856	                        loc,
   857	                        f"control errored ({type(exc).__name__}) — rail NOT certified alive",
   858	                    )
   859	                )
   860	                continue
   861	            # The WHOLE stdout is ONE JSON value: a preamble or a second object is not a
   862	            # decision (rail r3). No .strip(): it also drops \x0b, \x0c, NBSP and U+2028, which JSON
   863	            # forbids; json.loads already allows JSON's own whitespace (space, tab, CR, LF).
   864	            out = proc.stdout
   865	            decision: Any = None
   866	            if out:
   867	                try:
   868	                    decision = json.loads(out, parse_constant=_refuse_constant)
   869	                except (ValueError, RecursionError):
   870	                    decision = None
   871	            if decision is None:
   872	                findings.append(
   873	                    _red(
   874	                        "replay",
   875	                        loc,
   876	                        f"no parseable decision on stdout (rc={proc.returncode}; the "
   877	                        "whole stdout must be ONE JSON value) — rail NOT certified alive",
   878	                    )
   879	                )
   880	                continue
   881	            if not _is_block_shaped(decision):
   882	                findings.append(
   883	                    _red(
   884	                        "replay",
   885	                        loc,
   886	                        "planted violation was NOT blocked "
   887	                        f"(decision={json.dumps(decision)[:160]}) — DEAD or "
   888	                        "fail-open rail",
   889	                    )
   890	                )
   891	    finally:
   892	        shutil.rmtree(str(scratch), ignore_errors=True)
   893	    return findings
   894	
   895	
   896	# ---------------------------------------------------------------------------
   897	# CLI
   898	# ---------------------------------------------------------------------------
   899	
   900	def _default_repo_root() -> Path:
   901	    env = os.environ.get("CLAUDE_PROJECT_DIR")
   902	    if env:
   903	        return Path(env).resolve()
   904	    # landed location: .claude/hooks/check_harness_config.py → repo root 2 up
   905	    candidate = _THIS_DIR.parent.parent
   906	    if (candidate / ".claude").is_dir():
   907	        return candidate
   908	    return Path.cwd()
   909	
   910	
   911	def _print_findings(findings: List[Finding]) -> None:
   912	    for f in findings:
   913	        print(f"[{f.severity}] {f.check_id} @ {f.location}\n    {f.message}")
   914	
   915	
   916	def main(argv: Optional[List[str]] = None) -> int:
   917	    parser = argparse.ArgumentParser(
   918	        prog="check_harness_config.py",
   919	        description="Harness-config gate: runtime-resolution model, "
   920	        "inline-secret scan, deny baseline, no-op annotation, and "
   921	        "behavioral positive-control replay (PLAN-153 Wave E / ADR-173).",
   922	    )
   923	    parser.add_argument("--repo-root", type=Path, default=None)
   924	    parser.add_argument(
   925	        "--settings",
   926	        action="append",
   927	        type=Path,
   928	        default=None,
   929	        help="settings file(s) to scan (default: dogfood + template)",
   930	    )
   931	    parser.add_argument("--fixtures-dir", type=Path, default=None)
   932	    parser.add_argument("--noop-allowlist", type=Path, default=None)
   933	    parser.add_argument(
   934	        "--static", action="store_true", help="run only the static checks"
   935	    )
   936	    parser.add_argument(
   937	        "--replay", action="store_true", help="run only the behavioral replay"
   938	    )
   939	    parser.add_argument(
   940	        "--no-exec-bit",
   941	        action="store_true",
   942	        help="skip delegation to check-active-hooks-executable.py",
   943	    )
   944	    args = parser.parse_args(argv)
   945	
   946	    repo_root = (args.repo_root or _default_repo_root()).resolve()
   947	    do_static = args.static or not args.replay
   948	    do_replay = args.replay or not args.static
   949	
   950	    if args.settings:
   951	        settings_paths = [p if p.is_absolute() else repo_root / p for p in args.settings]
   952	    else:
   953	        settings_paths = [repo_root / rel for rel in DEFAULT_SETTINGS_REL]
   954	
   955	    findings: List[Finding] = []
   956	    try:
   957	        if do_static:
   958	            findings.extend(
   959	                run_static(
   960	                    repo_root,
   961	                    settings_paths,
   962	                    noop_allowlist_path=args.noop_allowlist,
   963	                    include_exec_bit=not args.no_exec_bit,
   964	                )
   965	            )
   966	    except ValueError as exc:
   967	        print(f"::error::{exc}", file=sys.stderr)
   968	        return 2
   969	
   970	    if do_replay:
   971	        findings.extend(run_replay(repo_root, args.fixtures_dir))
   972	
   973	    _print_findings(findings)
   974	    reds = [f for f in findings if f.severity == "RED"]
   975	    if reds:
   976	        print(f"\nFAIL: {len(reds)} RED finding(s) "
   977	              f"({len(findings) - len(reds)} warning(s))")
   978	        return 1
   979	    print(
   980	        f"OK: harness-config gate green "
   981	        f"(static={'yes' if do_static else 'no'}, "
   982	        f"replay={'yes' if do_replay else 'no'}, "
   983	        f"{len(findings)} warning(s))"
   984	    )
   985	    return 0
   986	
   987	
   988	if __name__ == "__main__":
   989	    sys.exit(main())
