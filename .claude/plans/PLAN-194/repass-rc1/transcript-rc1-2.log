   702	        cb(action, fields)
   703	    except Exception as e:  # pragma: no cover
   704	        _breadcrumb(f"forensic emit failed: {action}: {type(e).__name__}: {e}")
   705	    finally:
   706	        _IN_FORENSIC_EMIT = False
