   714	def _origin_for_new_spool() -> str:
   715	    """PLAN-119 WS-D1 — write-time origin stamp for a freshly-minted spool header.
   716	
   717	    Returns ``"test"`` when a test signal is present AT WRITE TIME
   718	    (``CEO_TEST_HARNESS=1`` or ``PYTEST_CURRENT_TEST`` set), else ``"live"``.
   719	    The writer knows the truth; the drainer cannot infer it later, so the stamp
   720	    is minted ONCE per spool (header) and is sticky to that PID's file. A real
   721	    session writes ``"live"`` and is never quarantined; legacy spool with no
   722	    ``_origin`` defaults to ``"live"`` at drain time (fail-safe toward never
   723	    dropping a real event).
   724	    """
   725	    if (os.environ.get("CEO_TEST_HARNESS") == "1"
   726	            or os.environ.get("PYTEST_CURRENT_TEST")):
   727	        return "test"
   728	    return "live"
