   766	def run_replay(
   767	    repo_root: Path,
   768	    fixtures_dir: Optional[Path] = None,
   769	    *,
   770	    timeout: float = 30.0,
   771	    controls: Tuple[Tuple[str, str], ...] = REQUIRED_REPLAY_CONTROLS,
   772	) -> List[Finding]:
   773	    """Replay every required positive control; RED on any control that
   774	    does not observably BLOCK its planted violation."""
   775	    if (os.environ.get("CEO_SOTA_DISABLE") or "").strip() == "1":
   776	        return [
   777	            _warn(
   778	                "replay",
   779	                "env",
   780	                "CEO_SOTA_DISABLE=1 — behavioral replay skipped (static checks unaffected)",
   781	            )
   782	        ]
   783	    findings: List[Finding] = []
   784	    fdir = fixtures_dir if fixtures_dir is not None else repo_root / REPLAY_FIXTURES_REL
   785	    scratch = Path(tempfile.mkdtemp(prefix="ceo-hc-replay-"))
   786	    try:
   787	        env = _replay_env(repo_root, scratch)
   788	        for hook_name, fixture_name in controls:
   789	            loc = f"replay:{hook_name}"
   790	            fixture_path = fdir / fixture_name
   791	            if not fixture_path.is_file():
   792	                findings.append(
   793	                    _red(
   794	                        "replay",
   795	                        loc,
   796	                        f"positive-control fixture MISSING ({fixture_path}) — "
   797	                        "a control that stops firing reddens the run",
   798	                    )
   799	                )
   800	                continue
   801	            try:
   802	                doc = json.loads(
   803	                    fixture_path.read_text(encoding="utf-8"),
   804	                    object_pairs_hook=_strict_pairs,
   805	                    parse_constant=_refuse_constant,
   806	                )
   807	            except (OSError, ValueError, RecursionError) as exc:
   808	                # A traceback here would drop every other control (rail r1 P2).
   809	                why = f"{type(exc).__name__}: {exc}"
   810	                findings.append(_red("replay", loc, f"fixture unparseable ({why}) — fail-closed"))
   811	                continue
   812	            if not isinstance(doc, dict) or doc.get("expect") != "block":
   813	                findings.append(
   814	                    _red(
   815	                        "replay",
   816	                        loc,
   817	                        "fixture tampered or malformed: 'expect' must be 'block'",
   818	                    )
   819	                )
   820	                continue
   821	            payload = doc.get("payload")
   822	            if not isinstance(payload, dict):
   823	                findings.append(
   824	                    _red("replay", loc, "fixture missing 'payload' object")
   825	                )
