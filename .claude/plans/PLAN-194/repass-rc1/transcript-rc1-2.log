   873	                    _red(
   874	                        "replay",
   875	                        loc,
   876	                        f"no parseable decision on stdout (rc={proc.returncode}; the "
   877	                        "whole stdout must be ONE JSON value) — rail NOT certified alive",
   878	                    )
   879	                )
   880	                continue
   881	            if not _is_block_shaped(decision):
   882	                findings.append(
   883	                    _red(
   884	                        "replay",
   885	                        loc,
   886	                        "planted violation was NOT blocked "
   887	                        f"(decision={json.dumps(decision)[:160]}) — DEAD or "
   888	                        "fail-open rail",
   889	                    )
   890	                )
   891	    finally:
   892	        shutil.rmtree(str(scratch), ignore_errors=True)
   893	    return findings
