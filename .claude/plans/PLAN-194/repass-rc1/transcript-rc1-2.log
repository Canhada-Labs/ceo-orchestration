   217	def load_settings(path: Path) -> Dict[str, Any]:
   218	    """Parse a settings JSON file. Raises ValueError on any failure
   219	    (fail-CLOSED: a gate input we cannot parse is an error, not a skip)."""
   220	    try:
   221	        data = json.loads(path.read_text(encoding="utf-8"), parse_constant=_refuse_constant)
   222	    except (OSError, ValueError, RecursionError) as exc:  # + UnicodeDecodeError
   223	        raise ValueError(f"cannot parse {path}: {type(exc).__name__}: {exc}") from exc
   224	    if not isinstance(data, dict):
   225	        raise ValueError(f"cannot parse {path}: top-level JSON is not an object")
   226	    return data
