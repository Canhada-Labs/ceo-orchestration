#: Behavioral positive controls: (hook file under .claude/hooks/, fixture
#: file under the replay fixtures dir). Every entry is REQUIRED — a missing
#: fixture reddens the run, so a control cannot silently stop firing.
REQUIRED_REPLAY_CONTROLS: Tuple[Tuple[str, str], ...] = (
    ("check_canonical_edit.py", "canonical_edit_unauthorized.json"),
    ("check_bash_safety.py", "bash_safety_destructive.json"),
    ("check_agent_spawn.py", "agent_spawn_named_no_skill_content.json"),
)

#: Default replay fixtures location (repo-relative). PLAN-183 W7a: it MUST be
#: a path the installer delivers — a missing fixture reddens the run, and the
#: old ``.claude/hooks/tests/...`` home (``_framework_path_excluded``) left
#: EVERY adopter install permanently red. ``install_lib_selective`` ships each
#: top-level ``_lib/`` entry. DATA, not a Python package: no ``__init__.py``.
REPLAY_FIXTURES_REL = ".claude/hooks/_lib/harness_replay"

#: Runtime marker replaced by the absolute repo root in fixture payloads.
#: PLAN-183 W7a (C6): NO doubled brace, so it sits outside every install-time
#: placeholder grammar (the installer's "Placeholders remaining" grep, the sed
#: keys, the placeholder tests), all of which now walk the fixtures. Only this
#: form is accepted: a doubled brace in a fixture is RED (_fixture_defect).
FIXTURE_PROJECT_PLACEHOLDER = "@HARNESS_REPLAY_PROJECT_DIR@"

# Settings files scanned by default (mirrors check-active-hooks-executable).
DEFAULT_SETTINGS_REL = (
    ".claude/settings.json",
    "templates/settings/settings.base.json",
)

_ANCHOR_RE = re.compile(r"\$\{?CLAUDE_PROJECT_DIR\}?")
_NOOP_PROGRAMS = frozenset({"echo", "printf", "true", ":"})

# Degraded-mode secret regexes (used ONLY when _lib.secret_patterns is
# unavailable). Deliberately conservative.
_FALLBACK_SECRET_RES: Tuple[Tuple[str, "re.Pattern[str]"], ...] = (
    ("aws_access_key", re.compile(r"\bAKIA[0-9A-Z]{16}\b")),
    ("github_personal_token", re.compile(r"\bghp_[A-Za-z0-9]{36}\b")),
    ("private_key_block", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    (
        "generic_secret_assignment",
        re.compile(
            r"(?i)\b(api[_-]?key|secret|token|passwd|password)\b"
            r"\s*[:=]\s*[\"'][A-Za-z0-9_\-/+=]{20,}[\"']"
        ),
    ),
)


class Finding(NamedTuple):
    """One gate finding. severity: RED (fails the gate) or WARN (printed)."""

    check_id: str
    severity: str  # "RED" | "WARN"
    location: str
    message: str


def _red(check_id: str, location: str, message: str) -> Finding:
    return Finding(check_id, "RED", location, message)


def _warn(check_id: str, location: str, message: str) -> Finding:
    return Finding(check_id, "WARN", location, message)


# ---------------------------------------------------------------------------
# Settings walking
  # ---------------------------------------------------------------------
  rc-toolchain-proof:
    name: RC toolchain proof (no publish)
    if: contains(github.ref, '-rc.')
    runs-on: ubuntu-latest
    timeout-minutes: 8
    permissions:
      contents: read
    steps:
      - name: Checkout tag
        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
        # persist-credentials: false (PLAN-194 W4): the job token is not
        # left in .git/config for the later steps, which run repo code
        # (install.sh smoke, npm pack). None of them needs it: the only
        # remote git call, publish's tag-liveness `git ls-remote origin`,
        # works anonymously on this PUBLIC repo — and fails closed (no
        # publish) if the repo ever stops being public.
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Setup Node ${{ env.PUBLISH_NODE_MAJOR }}
        # SHA-pinned: actions/setup-node@v6.4.0 (the action itself runs on
        # node24; the Node it INSTALLS is `node-version` below)
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e
        with:
          node-version: ${{ env.PUBLISH_NODE_MAJOR }}
          registry-url: "https://registry.npmjs.org"

      - name: Pin npm CLI to the exact version (Trusted Publishing — OIDC)
        # PLAN-158 W1 (debate, all 3 critics) installed npm in-job because
        # the Node 20 line bundled npm 10.x, which does NOT implement the
        # trusted-publishing token exchange (npm >= 11.5.1 is the first
        # CLI that does). PLAN-194 W4.1 (D-12) keeps the in-job install
        # but pins the EXACT version from the workflow-level env — a range
        # would let a newer npm land between the RC proof and the GA run —
        # and asserts BOTH versions before any packaging step runs. The
        # `publish` and `rc-toolchain-proof` copies of this step are
        # byte-identical: the RC run is the toolchain's earlier proof
        # point. The OIDC exchange itself is still first exercised at GA.
        run: |
          set -euo pipefail
          npm install -g "npm@${PUBLISH_NPM_VERSION}"
          NODE_V="$(node --version)"
          NPM_V="$(npm --version)"
          echo "node --version: ${NODE_V}"
          echo "npm --version: ${NPM_V}"
          case "${NODE_V}" in
            "v${PUBLISH_NODE_MAJOR}".*) ;;
            *)
              echo "::error::node ${NODE_V} is not on the declared v${PUBLISH_NODE_MAJOR}.x line"
              exit 1
              ;;
          esac
          if [[ "${NPM_V}" != "${PUBLISH_NPM_VERSION}" ]]; then
            echo "::error::npm ${NPM_V} is not the pinned ${PUBLISH_NPM_VERSION} (PLAN-194 W4, D-12)"
            exit 1
          fi
          echo "OK: node ${NODE_V} + npm ${NPM_V} (exact pin; trusted publishing needs npm >= 11.5.1 on Node >= 22.14.0)"

      - name: Verify VERSION matches the RC tag base
        # RC-aware variant of the publish job's "Verify VERSION matches
        # tag" (same convention as release.yml "Assert VERSION matches
        # tag"): an RC tag `v<X.Y.Z>-rc.N` is cut from a tree whose VERSION
        # already reads `X.Y.Z`, so the `-rc.N` suffix is stripped before
        # comparing. A tag with no `-rc.N` suffix fails here — this job is
        # for RC tags only.
        run: |
          set -euo pipefail
          TAG="${GITHUB_REF_NAME}"
          VERSION_FILE="$(tr -d '[:space:]' < VERSION)"
          EXPECTED="${TAG#v}"
          BASE="${EXPECTED%-rc.[0-9]*}"
          if [[ "$BASE" == "$EXPECTED" ]]; then
            echo "::error::tag $TAG carries no -rc.N suffix — this job runs on RC tags only"
            exit 1
          fi
          if [[ "$VERSION_FILE" != "$BASE" ]]; then
            echo "::error::VERSION ($VERSION_FILE) does not match RC tag ($TAG → base $BASE)"
            exit 1
          fi
          echo "OK: VERSION=$VERSION_FILE matches RC tag=$TAG (base $BASE)"

      - name: Verify npm/package.json version matches VERSION
    # PLAN-013 Phase 0 item 0.2 — RC tag guard.
    # RC tags contain `-rc.` (e.g. `v1.4.0-rc.1`). This job skips them
    # entirely; they run `rc-toolchain-proof` (PLAN-194 W4.3, below),
    # which cannot mint a registry credential and never publishes. Only
    # GA tags (`v1.4.0`) proceed here, and those gate through the
    # `production-npm` environment (manual approval).
    # PLAN-153 Wave B item 5 (f): RC posture UNCHANGED — this exclusion
    # is load-bearing (PLAN-013 anti-goals #3/#16) and MUST survive any
    # future edit to this file; the draft `next` dist-tag idea was
    # DROPPED by ratified debate. Pinned by
    # .claude/scripts/tests/test_release_workflow_asserts.py.
    if: "!contains(github.ref, '-rc.')"
    # PLAN-166 W1 item 1: publish only starts after `await-release-gate`
    # proved release.yml's release-gate job green for this exact tag+SHA
    # (default `success()` semantics of `needs:` — an await failure skips
    # this job while the run itself goes red). Deliberate ordering: the
    # production-npm manual-approval prompt appears only AFTER the gate
    # is green. The `already_published` guard stays below, in this job.
    needs: await-release-gate
    runs-on: ubuntu-latest
    environment: production-npm
    timeout-minutes: 8
    steps:
      - name: Checkout tag
        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
        # persist-credentials: false (PLAN-194 W4): the job token is not
        # left in .git/config for the later steps, which run repo code
        # (install.sh smoke, npm pack). None of them needs it: the only
        # remote git call, publish's tag-liveness `git ls-remote origin`,
        # works anonymously on this PUBLIC repo — and fails closed (no
        # publish) if the repo ever stops being public.
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Setup Node ${{ env.PUBLISH_NODE_MAJOR }}
        # SHA-pinned: actions/setup-node@v6.4.0 (the action itself runs on
        # node24; the Node it INSTALLS is `node-version` below)
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e
        with:
          node-version: ${{ env.PUBLISH_NODE_MAJOR }}
          registry-url: "https://registry.npmjs.org"

      - name: Pin npm CLI to the exact version (Trusted Publishing — OIDC)
