  2404	# Capture build_settings rc correctly. `if ! cmd` negates $? to 0 when
  2405	# the command failed, so we stash the original rc inside build_settings
  2406	# via a dedicated variable. Running under `set -e`, a non-zero return
  2407	# from a function would abort the shell mid-execution before we can
  2408	# report; guard with `|| build_rc=$?`.
  2409	build_rc=0
  2410	build_settings || build_rc=$?
  2411	if [[ "$build_rc" -ne 0 ]]; then
  2412	  exit "$build_rc"
  2413	fi
