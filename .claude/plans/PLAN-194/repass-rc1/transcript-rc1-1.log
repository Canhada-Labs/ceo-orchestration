  2415	# ---- 6a. PLAN-153 Wave E item 3: coarse credential-read deny baseline ----
  2416	#
  2417	# Injects a small permissions.deny baseline into the settings.json THIS
  2418	# install run just produced.
  2419	#
  2420	# HONEST FRAMING (never sold as coverage): this is a coarse harness
  2421	# backstop. Claude Code Read deny rules cover the built-in file tools and
  2422	# the file commands the harness recognizes inside Bash (cat/head/tail/sed),
  2423	# but NOT arbitrary subprocesses that open files themselves; Bash pattern
  2424	# rules are trivially bypassable by rephrasing. The pipe-to-shell class is
  2425	# OWNED by check_bash_safety.py's parse gate — the single
  2426	# "Bash(curl * | bash)" entry here is a tripwire, not the rail.
  2427	# Scope, residuals, and opt-out: docs/deny-baseline.md.
  2428	#
  2429	# Exclusion note (ratified fallback): Claude Code evaluates deny before
  2430	# allow and "a deny rule can't carry allowlist exceptions", so
  2431	# "deny **/.env.* except .env.example" is NOT expressible via deny+allow.
  2432	# We therefore deny SPECIFIC sensitive .env variants only; .env.example /
  2433	# .env.sample / .env.template stay readable because they are simply not
  2434	# listed. Residual: unlisted variants (e.g. .env.secret) pass the backstop.
  2435	#
  2436	# Idempotency: runs ONLY when this run created settings.json
  2437	# (SETTINGS_PRE_EXISTING=0). Re-running install skips settings.json
  2438	# entirely, so removed entries are never re-added. The merge itself is
  2439	# also order-preserving + deduplicating, so even a forced re-apply cannot
  2440	# duplicate entries.
  2441	#
  2442	# Fail-open on infrastructure (house rule): if neither jq nor python3 is
  2443	# available, or the merge fails, WARN with manual instructions and leave
  2444	# the just-copied settings.json untouched.
  2445	#
  2446	# Opt-out: CEO_INSTALL_SKIP_DENY_BASELINE=1 (mirrors CEO_INSTALL_SKIP_SELF_SHA).
  2447	#
  2448	# PLAN-194 W5b (OQ-7, Owner answer 2026-10-01): the same merge writes
  2449	# permissions.defaultMode = DEFAULT_MODE_BASELINE when the settings.json this
  2450	# run produced carries no defaultMode key. The `--ceremony user` template
  2451	# ships no permissions block, and a session whose settings sources configure
  2452	# no mode can start in Claude Code's gated auto default (CHANGELOG 2.1.284;
  2453	# the 2.1.295 binary names it permission_mode_from_default_fallback). A
  2454	# defaultMode the produced file already carries (the maintainer template's
  2455	# own) is kept as-is, and a pre-existing settings.json is never touched (see
  2456	# Idempotency). The value is the "new" of the permissions.defaultMode row of
  2457	# upgrade.sh's T5.4 table, which writes the same key into an upgraded install
  2458	# that lacks it; the test derives its expectation from that table. The
  2459	# opt-out above skips this key too: one merge, one switch.
  2460	DEFAULT_MODE_BASELINE="manual"
  2461	
  2462	DENY_BASELINE_ENTRIES=(
  2463	  "Read(~/.ssh/**)"
  2464	  "Read(~/.aws/**)"
  2465	  "Read(~/.npmrc)"
  2466	  "Read(~/.config/gcloud/**)"
  2467	  "Read(~/.kube/config)"
  2468	  "Read(~/.docker/config.json)"
  2469	  "Read(~/.git-credentials)"
  2470	  "Read(~/.netrc)"
  2471	  "Read(~/.pypirc)"
  2472	  "Read(**/.env)"
  2473	  "Read(**/.env.local)"
  2474	  "Read(**/.env.*.local)"
  2475	  "Read(**/.env.development)"
  2476	  "Read(**/.env.dev)"
  2477	  "Read(**/.env.production)"
  2478	  "Read(**/.env.prod)"
  2479	  "Read(**/.env.staging)"
  2480	  "Read(**/.env.test)"
  2481	  "Read(**/.env.ci)"
  2482	  "Bash(curl * | bash)"
  2483	)
