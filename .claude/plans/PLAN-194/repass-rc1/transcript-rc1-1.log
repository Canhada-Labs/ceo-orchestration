          && github.ref == 'refs/heads/main'
          && (github.event_name == 'push' || github.event_name == 'schedule' || github.event_name == 'workflow_dispatch')
          && fromJSON('["self-hosted","Linux","X64","canhada-ci"]') || 'ubuntu-latest' }}
    # PLAN-161: 5 -> 8 — headroom for the two upgrade oracles (each runs
    # full install + upgrade legs against fixture adopter repos).
    # PLAN-166 F4: 8 -> 20. MEASURED, not guessed. The parity e2e runs 2 full
    # install legs + 1 upgrade leg PER ceremony mode, and the positive control
    # runs the same again with a planted divergence: 12 install/upgrade
    # operations added to this job. Local wall time (Darwin arm64, 16 cores,
    # 2026-08-05): gate 122s + control 118s = 240s. A 2-core ubuntu-latest
    # runner is the usual 2-3x slower, i.e. 8-12 min of NEW work on top of the
    # ~5 min this job already spent. 15 would sit inside the noise band, and
    # the perf-gate N=20 flake (PLAN-159) was exactly that mistake. Re-tighten
    # once real CI runs give a p95.
    # PLAN-166 F3 (assembler): 20 -> 25. The spec-ownership e2e adds 4 more
    # installs + 3 upgrades (S1-S8; ~3-4 min local per the W1-C measurement),
    # i.e. up to ~8-10 more CI minutes at the same 2-3x factor. Same
    # anti-flake sizing rule as the F4 bump above.
    # PLAN-177 W1 (CF-9): 25 -> 32. The night-mode efficacy e2e adds 3 installs
    # + 2 upgrades. MEASURED, not guessed: 2m06s wall on Darwin arm64 (16
    # cores, 2026-08-13), reproduced across two runs. At the same 2-3x runner
    # factor this workflow already sizes with, that is 4-7 CI minutes, so +7.
    # A job-level timeout that clips a green run reports as `cancelled` on an
    # innocent step (the S2xx lesson), so the margin stays deliberate.
    # PLAN-183 W5 (D1 + OQ-5): 32 -> 50. The historical-adopter e2e adds 2
    # installs + 8 full upgrades (six independent adopter fixtures; the two
    # installs are cached and cp -R'd, the upgrades cannot be). MEASURED, not
    # guessed: 357 s wall on Darwin arm64 under concurrent load, 2026-08-24
    # (372 s for the uncached version — the machine was contended, so treat
    # these as an upper bound, not a p50). At the same 2-3x runner factor this
    # file already sizes with, that is 12-18 CI minutes of NEW work, so +18.
    # The `if: always()` steps below also mean a RED main gate no longer ends
    # the job early: the worst case now runs every step, which is the point.
    # rail round-1 (F2 + F5): 50 -> 58. The two new legs of that e2e — H.12
    # (an unclaimed rendered CODEOWNERS must suppress the .template route, on
    # the first upgrade AND the second) and H.13 (a poisoned route row is
    # refused and NOTHING lands outside $TARGET) — add TWO cached fixtures

      - name: Install pytest (dev dep, not shipped)
        run: python3 -m pip install --quiet --no-cache-dir "pytest==8.*" pytest-xdist

      - name: Run hook tests with CEO_NATIVE_SUBAGENTS=${{ matrix.native_subagents }}
        env:
          CEO_NATIVE_SUBAGENTS: ${{ matrix.native_subagents }}
        run: |
          set -euo pipefail
          echo "Running hook tests with CEO_NATIVE_SUBAGENTS=$CEO_NATIVE_SUBAGENTS"
          python3 -m pytest .claude/hooks/tests/ -n auto -m 'not serial' --strict-markers --tb=no -q
          python3 -m pytest .claude/hooks/tests/ -m 'serial' --strict-markers --tb=no -q
          echo "✓ Hook tests green for CEO_NATIVE_SUBAGENTS=$CEO_NATIVE_SUBAGENTS"

  # =========================================================================
  # PLAN-086 Wave G.2 — Python version matrix (M-7 fold)
  # =========================================================================
  hook-tests-python-matrix:
    if: vars.CEO_SOTA_DISABLE != '1'
    # PLAN-194 W1 — runner por versao: `ubuntu-latest` vira 26.04 de
    # 2026-10-19 a 2026-11-19 (actions/runner-images#14748) e o setup-python
    # nao tem 3.9 para 26.04 (medido 2026-10-01). 3.9 (o piso) roda no
    # rotulo FIXO `ubuntu-24.04` (W1.1); 3.14 em `ubuntu-26.04`, so no
    # `schedule` (W1.3, canario); 3.10-3.12 seguem no `Ceo`. O actionlint
    # 1.7.7 nao conhece `ubuntu-26.04` e nao confere rotulo dentro de
    # expressao (medido): a validade vem do issue acima.
    runs-on: >-
      ${{ matrix.python-version != '3.14' && vars.VM_CI_ENABLED == '1' 
          && github.ref == 'refs/heads/main' 
          && (github.event_name == 'push' || github.event_name == 'schedule' || github.event_name == 'workflow_dispatch') 
          && fromJSON('["self-hosted","Linux","X64","canhada-ci"]')
          || (matrix.python-version == '3.9' && 'ubuntu-24.04'
          || (matrix.python-version == '3.14' && 'ubuntu-26.04' || 'ubuntu-latest')) }}
    # Runner padrao (4 vCPU) = 45 min; `Ceo` (8 nucleos) segue 25. Medido
    # no `Ceo` (runs 36932014761, 36832647294): perna 3.9 = 430-646 s
    # paralela + 211-232 s serial; com metade dos nucleos encosta nos 25
    # (estimativa: nenhuma perna rodou num runner padrao).
    timeout-minutes: ${{ (matrix.python-version == '3.9' || matrix.python-version == '3.14') && 45 || 25 }}
    permissions:
      contents: read
    strategy:
      fail-fast: false
      matrix:
        # PLAN-184 A0 — no `push`, so as versoes de FRONTEIRA (3.9 e
        # 3.12); no `pull_request`, as QUATRO; no `schedule` acima, as
        # QUATRO mais a 3.14 (PLAN-194 W1.3).
        # Troca latencia de deteccao por dinheiro (~US$3,15/dia de um
        # teto de ~US$4,04, contados ANTES da W1, com a 3.9 no `Ceo`) sem
        # abrir janela de falso-verde, porque o nightly cobre 3.10/3.11
        # todos os dias.
        python-version: >-
          ${{ fromJSON(github.event_name == 'push'
              && '["3.9","3.12"]'
              || (github.event_name == 'schedule'
                  && '["3.9","3.10","3.11","3.12","3.14"]'
                  || '["3.9","3.10","3.11","3.12"]')) }}
    steps:
      - name: Checkout
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          # Baseline derivation needs GA tags and their ancestry, including on reused runners.
          fetch-depth: 0

      - name: Setup Python ${{ matrix.python-version }}
        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
        with:
          python-version: ${{ matrix.python-version }}

      - name: Install pytest + PyYAML (dev deps, not shipped)
        run: python3 -m pip install --quiet --no-cache-dir "pytest==8.*" "PyYAML>=6.0" pytest-xdist

      - name: Run hook + script tests on Python ${{ matrix.python-version }}
        env:
          PYTHONPATH: "."
          # PLAN-186 W4a — NOT inherited (rail r17 P2): the deleted step A set
          # CEO_HOOK_ADAPTER=claude for .claude/hooks/tests ONLY, while this matrix
          # step runs hooks + scripts + optimizer in ONE pytest. Setting it here would
          # ALTER the scripts/optimizer environment (they ran with it ABSENT in both
          # the deleted step B and this matrix). The variable is the documented default
          # of the adapter, so its absence exercises the default path — the same path
          # step A exercised explicitly. Declared as the second ACCEPTED env delta.
        run: |
          set -euo pipefail
          echo "Python version: $(python3 --version)"
          python3 -m pytest .claude/hooks/tests/ .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
            -n auto -m 'not serial' --strict-markers --tb=no -q
          python3 -m pytest .claude/hooks/tests/ .claude/scripts/tests/ .claude/scripts/optimizer/tests/ \
            -m 'serial' --strict-markers --tb=no -q
          echo "Tests green on Python ${{ matrix.python-version }}"

