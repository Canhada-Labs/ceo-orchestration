  2528	  local tmp="$SETTINGS_DST.deny-baseline.$$"
  2529	
  2530	  if command -v jq >/dev/null 2>&1; then
  2531	    # Order-preserving dedup: keep existing deny list as-is, append only
  2532	    # baseline entries not already present (jq array subtraction). The
  2533	    # defaultMode is set only where the key is absent (`has`, not a value
  2534	    # test: a present key is the template's, whatever it holds).
  2535	    if jq --argjson newdeny "$entries_json" --arg mode "$DEFAULT_MODE_BASELINE" '
  2536	         (.permissions.deny // []) as $cur
  2537	         | .permissions.deny = ($cur + ($newdeny - $cur))
  2538	         | if (.permissions | has("defaultMode")) then . else .permissions.defaultMode = $mode end
  2539	       ' "$SETTINGS_DST" > "$tmp" 2>/dev/null; then
  2540	      mv "$tmp" "$SETTINGS_DST"
  2541	      echo "    MERGED: ${#DENY_BASELINE_ENTRIES[@]}-entry coarse deny baseline (+ permissions.defaultMode if absent) -> .claude/settings.json (docs/deny-baseline.md)"
  2542	      return 0
  2543	    fi
  2544	    rm -f "$tmp"
  2545	    echo "    WARNING: jq merge of the deny baseline failed — settings.json left untouched." >&2
  2546	    echo "             Add the permissions.deny entries manually (docs/deny-baseline.md), and permissions.defaultMode \"$DEFAULT_MODE_BASELINE\" if absent." >&2
  2547	    return 0
  2548	  fi
  2549	
  2550	  if command -v python3 >/dev/null 2>&1; then
  2551	    if python3 - "$SETTINGS_DST" "$entries_json" "$DEFAULT_MODE_BASELINE" > "$tmp" <<'PY'
  2552	import json
  2553	import sys
  2554	
  2555	with open(sys.argv[1], "r", encoding="utf-8") as fh:
  2556	    settings = json.load(fh)
  2557	new = json.loads(sys.argv[2])
  2558	perms = settings.setdefault("permissions", {})
  2559	cur = perms.get("deny") or []
  2560	perms["deny"] = cur + [e for e in new if e not in cur]
  2561	perms.setdefault("defaultMode", sys.argv[3])
  2562	sys.stdout.write(json.dumps(settings, indent=2) + "\n")
  2563	PY
  2564	    then
  2565	      mv "$tmp" "$SETTINGS_DST"
  2566	      echo "    MERGED: ${#DENY_BASELINE_ENTRIES[@]}-entry coarse deny baseline (+ permissions.defaultMode if absent) -> .claude/settings.json (python3; docs/deny-baseline.md)"
  2567	      return 0
  2568	    fi
  2569	    rm -f "$tmp"
  2570	    echo "    WARNING: python3 merge of the deny baseline failed — settings.json left untouched." >&2
  2571	    echo "             Add the permissions.deny entries manually (docs/deny-baseline.md), and permissions.defaultMode \"$DEFAULT_MODE_BASELINE\" if absent." >&2
  2572	    return 0
  2573	  fi
  2574	
  2575	  echo "    WARNING: neither jq nor python3 found — deny baseline NOT applied." >&2
  2576	  echo "             Add the permissions.deny entries manually (docs/deny-baseline.md), and permissions.defaultMode \"$DEFAULT_MODE_BASELINE\" if absent." >&2
  2577	  return 0
  2578	}
