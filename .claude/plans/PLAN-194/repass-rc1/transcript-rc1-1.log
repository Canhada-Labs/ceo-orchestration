  2382	        then .autoAllowBashIfSandboxed = $stack.autoAllowBashIfSandboxed
  2383	        elif ($base.autoAllowBashIfSandboxed != null)
  2384	        then .autoAllowBashIfSandboxed = $base.autoAllowBashIfSandboxed
  2385	        else . end
