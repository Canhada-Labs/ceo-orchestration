  2485	apply_deny_baseline() {
  2486	  # PLAN-185 W1 — third consumer of the settings-destination verdict. Its own
  2487	  # `-f "$SETTINGS_DST"` test below is symlink-FOLLOWING, so on a RESOLVED link
  2488	  # it answers true and the jq rewrite lands outside $TARGET; and `$tmp` is a
  2489	  # sibling INSIDE the target, so the `mv` would additionally replace the
  2490	  # adopter's link with a regular file. Neither is reachable once the shared
  2491	  # verdict is consulted first.
  2492	  if [[ "${_SETTINGS_DST_REFUSED:-0}" -eq 1 ]]; then
  2493	    return 0
  2494	  fi
  2495	  if [[ "${CEO_INSTALL_SKIP_DENY_BASELINE:-0}" = "1" ]]; then
  2496	    echo "    SKIP: deny baseline + permissions.defaultMode (CEO_INSTALL_SKIP_DENY_BASELINE=1)"
  2497	    return 0
  2498	  fi
  2499	
  2500	  if [[ "$DRY_RUN" -eq 1 ]]; then
  2501	    if [[ "$SETTINGS_PRE_EXISTING" -eq 1 ]]; then
  2502	      echo "    (dry-run) settings.json pre-existed — would NOT touch deny baseline + defaultMode"
  2503	    else
  2504	      echo "    (dry-run) would MERGE ${#DENY_BASELINE_ENTRIES[@]} deny-baseline entries (+ permissions.defaultMode \"$DEFAULT_MODE_BASELINE\" if absent) into .claude/settings.json"
  2505	    fi
  2506	    return 0
  2507	  fi
  2508	
  2509	  if [[ "$SETTINGS_PRE_EXISTING" -eq 1 ]]; then
  2510	    echo "    SKIP: deny baseline + defaultMode — settings.json pre-existed this run (add them manually if wanted — docs/deny-baseline.md)"
  2511	    return 0
  2512	  fi
  2513	  if [[ ! -f "$SETTINGS_DST" ]]; then
  2514	    # build_settings decided not to produce one; nothing to inject into.
  2515	    return 0
  2516	  fi
  2517	
  2518	  # Build a JSON array literal from the entries. All entries are static
  2519	  # literals controlled above (no embedded double quotes or backslashes),
  2520	  # so direct interpolation is safe.
  2521	  local entries_json="[" e first=1
  2522	  for e in "${DENY_BASELINE_ENTRIES[@]}"; do
  2523	    if [[ "$first" -eq 1 ]]; then first=0; else entries_json+=","; fi
  2524	    entries_json+="\"$e\""
  2525	  done
  2526	  entries_json+="]"
