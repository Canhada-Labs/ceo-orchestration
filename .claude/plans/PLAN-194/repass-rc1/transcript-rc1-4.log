   451	      # -----------------------------------------------------------------
   452	      # PLAN-153 Wave B item 5 (a) — `already_published` idempotency
   453	      # guard. Before publishing, ask the registry whether this exact
   454	      # name@version already exists. If it does (a re-run of a
   455	      # previously successful publish, or a re-run after a post-publish
   456	      # step failed), the Publish step is skipped and the job succeeds
   457	      # as a documented no-op instead of going red on EPUBLISHCONFLICT.
   458	      #
   459	      # Detection is deliberately conservative: "published" ONLY when
   460	      # `npm view <name>@<version> version` exits 0 AND prints exactly
   461	      # the version (npm has historically flip-flopped between
   462	      # rc!=0/E404 and rc=0/empty-stdout for a missing version of an
   463	      # existing package — both shapes are treated as not-published).
   464	      # Any registry/network error therefore falls through to the
   465	      # publish attempt, which preserves today's behavior (npm itself
   466	      # fails closed on a true conflict). No auth needed: the package
   467	      # is public and `npm view` is an unauthenticated read.
   468	      # -----------------------------------------------------------------
   469	      - name: Check registry for already-published version
   470	        id: already_published
   471	        working-directory: npm
   472	        run: |
   473	          set -euo pipefail
   474	          PKG_NAME=$(node -p "require('./package.json').name")
   475	          PKG_VERSION=$(node -p "require('./package.json').version")
   476	          set +e
   477	          SEEN=$(npm view "${PKG_NAME}@${PKG_VERSION}" version 2>/dev/null)
   478	          RC=$?
   479	          set -e
   480	          if [[ "$RC" -eq 0 && "$SEEN" == "$PKG_VERSION" ]]; then
   481	            echo "published=true" >> "$GITHUB_OUTPUT"
   482	            echo "::notice::${PKG_NAME}@${PKG_VERSION} already exists in the registry — publish will be skipped (idempotent re-run, succeed-as-noop)"
   483	          else
   484	            echo "published=false" >> "$GITHUB_OUTPUT"
   485	            echo "OK: ${PKG_NAME}@${PKG_VERSION} not in registry (rc=$RC) — proceeding to publish"
   486	          fi
