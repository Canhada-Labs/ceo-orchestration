   437	          import json, re, sys
   438	          d = json.load(sys.stdin)
   439	          o = d[0] if isinstance(d, list) else d
   440	          paths = [f["path"] for f in o["files"]]
   441	          pat = re.compile(r"(^|/)(tests|fixtures)(/|$)|(^|/)eval/|(^|/)red-team-corpus/|(^|/)plans/PLAN-[0-9]|(^|/)_lib/(testing|test_isolation)\.py$")
