  rc-toolchain-proof:
    name: RC toolchain proof (no publish)
    if: contains(github.ref, '-rc.')
    runs-on: ubuntu-latest
    timeout-minutes: 8
    permissions:
      contents: read
    steps:
      - name: Checkout tag
        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
        # persist-credentials: false (PLAN-194 W4): the job token is not
        # left in .git/config for the later steps, which run repo code
        # (install.sh smoke, npm pack). None of them needs it: the only
        # remote git call, publish's tag-liveness `git ls-remote origin`,
        # works anonymously on this PUBLIC repo — and fails closed (no
        # publish) if the repo ever stops being public.
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
        with:
          fetch-depth: 0
          persist-credentials: false

      - name: Setup Node ${{ env.PUBLISH_NODE_MAJOR }}
        # SHA-pinned: actions/setup-node@v6.4.0 (the action itself runs on
        # node24; the Node it INSTALLS is `node-version` below)
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e
        with:
          node-version: ${{ env.PUBLISH_NODE_MAJOR }}
          registry-url: "https://registry.npmjs.org"

      - name: Pin npm CLI to the exact version (Trusted Publishing — OIDC)
        # PLAN-158 W1 (debate, all 3 critics) installed npm in-job because
        # the Node 20 line bundled npm 10.x, which does NOT implement the
        # trusted-publishing token exchange (npm >= 11.5.1 is the first
        # CLI that does). PLAN-194 W4.1 (D-12) keeps the in-job install
        # but pins the EXACT version from the workflow-level env — a range
        # would let a newer npm land between the RC proof and the GA run —
        # and asserts BOTH versions before any packaging step runs. The
        # `publish` and `rc-toolchain-proof` copies of this step are
        # byte-identical: the RC run is the toolchain's earlier proof
        # point. The OIDC exchange itself is still first exercised at GA.
        run: |
          set -euo pipefail
          npm install -g "npm@${PUBLISH_NPM_VERSION}"
          NODE_V="$(node --version)"

