name: Formal Verification (TLC)

# PLAN-014 Phase B.6 — advisory-only TLC model checker for TLA+ specs.
# SHA-pinned Java + TLC toolchain per ADR-044 §Toolchain pin.

on:
  pull_request:
    paths:
      - "docs/formal-verification/**"
      - ".github/workflows/formal-verify.yml"
  push:
    branches: [main]
    paths:
      - 'docs/formal-verification/**'
      - '.github/workflows/formal-verify.yml'
  workflow_dispatch:
  schedule:
    # Monday 16:00 UTC — weekly advisory run
    - cron: '0 16 * * 1'

permissions:
  contents: read

env:
  TLA_VERSION: "1.8.0"
  TLA_TOOLS_SHA256: "0f56d6a813368c48008dfbecb23a73ab43a4a5e1bf09f026782a674aa9d4b3c9"
  TLA_TOOLS_URL: "https://github.com/tlaplus/tlaplus/releases/download/v1.8.0/tla2tools.jar"

jobs:
  tlc-model-check:
    name: TLC Model Check (${{ matrix.model }})
    if: vars.CEO_SOTA_DISABLE != '1'
    strategy:
      fail-fast: false
      max-parallel: 3
      matrix:
        model: [breaker, plan-lifecycle, debate-convergence]
    runs-on: ubuntu-latest
    timeout-minutes: 60
    # Preserve the existing advisory contract; step logs/artifacts retain failures.
    continue-on-error: true

    steps:
      - name: Checkout
        # PLAN-019 DevOps-P2-5 — SHA-pin alignment with 14 sibling workflows.
        # Prior pin was actions/checkout@v4.2.2 (11bd719); aligned to the
        # repo-wide v6.0.2 pin (de0fac2) used by validate.yml / release.yml
        # / adapter-live.yml / benchmarks.yml / coverage.yml / red-team.yml
        # / npm-publish.yml / otel-smoke.yml / perf-profile.yml /
        # translations-drift.yml / chaos.yml / shadow-ci.yml /
        # smoke-install.yml. One-at-a-time Dependabot bumps created drift;
        # this aligns before drift compounds.
        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2

      - name: Setup Java 17 LTS
        uses: actions/setup-java@c5195efecf7bdfc987ee8bae7a71cb8b11521c00  # v4.7.1
        with:
          distribution: 'temurin'
          java-version: '17'

      - name: Download + verify tla2tools.jar
        env:
          TLA_CACHE: ${{ runner.temp }}/tla-cache
        run: |
          set -euo pipefail
          bash docs/formal-verification/run-tlc.sh download
          echo "TLC_JAR=${TLA_CACHE}/tla2tools-${TLA_VERSION}.jar" >> "$GITHUB_ENV"

      - name: Check model
        env:
          MODEL: ${{ matrix.model }}
        run: |
          set -euo pipefail
          # TLA+ module names must match the filename. Published source paths
          # retain hyphens; stage exact bytes under the declared module name.
          WORK="$(mktemp -d "${RUNNER_TEMP}/tlc.XXXXXX")"
          MODULE="${MODEL//-/_}"
          cp "docs/formal-verification/${MODEL}.tla" "${WORK}/${MODULE}.tla"
          cp "docs/formal-verification/${MODEL}.cfg" "${WORK}/${MODULE}.cfg"
          cd "$WORK"
          java -Xmx2G -cp "$TLC_JAR" tlc2.TLC \
            -config "${MODULE}.cfg" -workers 4 -deadlock \
            "${MODULE}.tla" 2>&1 | tee "${RUNNER_TEMP}/tlc-${MODEL}.log"

      - name: Breaker model regression and mutation checks
        if: matrix.model == 'breaker'
        run: python3 docs/formal-verification/check-breaker-model.py "$TLC_JAR"

      - name: Print TLC log hashes
        if: always()
        run: |
          echo "=== TLC log hashes ==="
          for log in ${{ runner.temp }}/tlc-*.log; do
            if [ -f "$log" ]; then
              name=$(basename "$log" .log)
              hash=$(sha256sum "$log" | cut -d' ' -f1)
              echo "${name}: ${hash}"
            fi
          done

      - name: Upload TLC logs
        if: always()
        # PLAN-019 DevOps-P2-5 — SHA-pin alignment. Sibling workflows
        # (benchmarks.yml / chaos.yml / coverage.yml / otel-smoke.yml /
        # perf-profile.yml / red-team.yml / shadow-ci.yml) all pin v7.0.1
        # (043fb46). Aligning to avoid one-at-a-time Dependabot drift.
        uses: actions/upload-artifact@043fb46d1a93c77aae656e7c1c64a875d1fc6a0a  # v7.0.1
        with:
          name: tlc-logs-${{ matrix.model }}
          path: ${{ runner.temp }}/tlc-*.log
          retention-days: 30
     1	"""Per-provider circuit breaker — ADR-040 §2.
     2	
     3	Three-state breaker (closed → open → half_open → {closed, open}) with a
     4	sliding failure window. Thread-safe via :class:`threading.Lock`. The
     5	clock is injected (callable returning monotonic seconds) so tests can
     6	drive deterministic state transitions without :mod:`time.sleep`.
     7	
     8	Failure semantics (ADR-040 §2):
     9	
    10	- **Transient failures** (5xx, 429, timeout, connection-refused) count
    11	  toward threshold. ``record_failure(reason="server_error")`` etc.
    12	- **Permanent failures** (``auth_permanent``) open the breaker
    13	  IMMEDIATELY regardless of count. This protects against a key-rotation
    14	  in flight + retry storm.
    15	- **Parse errors** do NOT count — they are prompt-triggered (potential
    16	  DoS surface) and would let an adversary open the breaker by malformed
    17	  responses they cause.
    18	
    19	The breaker is per (provider, instance) — the adapter ``__init__``
    20	constructs one. There is no global breaker registry; each
    21	``ClaudeLiveAdapter()`` etc. carries its own.
    22	"""
    23	
    24	from __future__ import annotations
    25	
    26	import threading
    27	import time as _time
    28	from collections import deque
    29	from dataclasses import dataclass
    30	from enum import Enum
    31	from typing import Callable, Deque, Optional, Tuple
    32	
    33	from ... import audit_emit  # noqa: E402  (relative: _lib/adapters/live → _lib)
    34	
    35	
    36	class BreakerState(str, Enum):
    37	    """Closed = pass through. Open = fail-fast. Half-open = single probe."""
    38	
    39	    CLOSED = "closed"
    40	    OPEN = "open"
    41	    HALF_OPEN = "half_open"
    42	
    43	
    44	# Reason strings that open the breaker IMMEDIATELY irrespective of
    45	# current failure count. ADR-040 §2 row "auth_permanent".
    46	_PERMANENT_OPEN_REASONS = frozenset({"auth_permanent"})
    47	
    48	# Reasons that do NOT count toward threshold (prompt-triggered DoS guard).
    49	_NON_COUNTING_REASONS = frozenset({"parse_error", "scope_misconfigured", "invalid_policy"})
    50	
    51	# Module-level test-only clock override. Chaos tests that don't own
    52	# breaker construction (adapter builds its own) set this to a float
    53	# to freeze the clock across ALL breaker instances. Set to None to
    54	# fall back to the instance-level override or the injected clock.
    55	# Never touched in production paths.
    56	_now_override: Optional[float] = None
    57	
    58	
    59	@dataclass(frozen=True)
    60	class BreakerSnapshot:
    61	    """Read-only view of breaker state — handy for audit emission."""
    62	
    63	    state: str  # "closed" | "open" | "half_open"
    64	    failures_in_window: int
    65	    opened_at: Optional[float]  # monotonic seconds; None if not open
    66	
    67	
    68	class CircuitBreaker:
    69	    """Thread-safe sliding-window circuit breaker per ADR-040 §2.
    70	
    71	    Args:
    72	        threshold: failure count within ``window_s`` that opens breaker.
    73	        window_s: sliding window in seconds.
    74	        half_open_s: how long after opening before allowing a probe.
    75	        clock: callable returning monotonic seconds (injectable for tests).
    76	            Defaults to :func:`time.monotonic`.
    77	
    78	    Example::
    79	
    80	        b = CircuitBreaker(threshold=5, window_s=30, half_open_s=60)
    81	        for _ in range(5):
    82	            b.record_failure("server_error")
    83	        assert b.state == BreakerState.OPEN
    84	        assert not b.should_allow()
    85	    """
    86	
    87	    def __init__(
    88	        self,
    89	        *,
    90	        threshold: int = 5,
    91	        window_s: int = 30,
    92	        half_open_s: int = 60,
    93	        clock: Optional[Callable[[], float]] = None,
    94	        provider: str = "",
    95	    ) -> None:
    96	        if threshold < 2:
    97	            raise ValueError(f"threshold must be >=2, got {threshold}")
    98	        if window_s <= 0 or half_open_s <= 0:
    99	            raise ValueError("window_s and half_open_s must be positive")
