   488	      # -----------------------------------------------------------------
   489	      # PLAN-166 W2 rc.3 (GA re-pass part-2 P1): a delete/re-tag recovery
   490	      # leaves the ORIGINAL run re-approvable (or its failed portion
   491	      # re-runnable) with checkout pinned to the OLD event SHA — every
   492	      # in-run version check still passes (both trees carry the same
   493	      # version string), the registry is still empty, and npm publish
   494	      # would irreversibly ship the WRONG tree while the live tag points
   495	      # elsewhere. Fail-closed liveness assert: the CURRENT remote tag
   496	      # must still peel to this run's GITHUB_SHA immediately before
   497	      # publish. A deleted tag (empty resolve) and a moved tag both
   498	      # abort. This step sits AFTER the production-npm environment
   499	      # approval by job order, so a stale approval cannot race past it.
   500	      # -----------------------------------------------------------------
   501	      - name: Assert remote tag still points at this run's SHA
   502	        # Same skip-condition as the publish step (rail rc.3 r1 P1-2): when
   503	        # the registry already carries the version, publish is a no-op and
   504	        # this guard must not turn the documented idempotent re-run red.
   505	        if: steps.already_published.outputs.published != 'true'
   506	        run: |
   507	          set -euo pipefail
   508	          TAG_REF="${GITHUB_REF_NAME}"
   509	          # ONE ls-remote invocation = ONE remote snapshot (rail rc.3 r1
   510	          # P1-1): separate calls could straddle a concurrent re-tag, keep
   511	          # the OLD peeled SHA and approve the obsolete run.
   512	          SNAP="$(git ls-remote origin "refs/tags/${TAG_REF}" "refs/tags/${TAG_REF}^{}")"
   513	          PEELED="$(printf '%s\n' "$SNAP" | awk -v r="refs/tags/${TAG_REF}^{}" '$2==r{print $1}')"
   514	          PLAIN="$(printf '%s\n' "$SNAP" | awk -v r="refs/tags/${TAG_REF}" '$2==r{print $1}')"
   515	          LIVE="${PEELED:-$PLAIN}"
   516	          if [ -z "$LIVE" ]; then
   517	            echo "::error::tag ${TAG_REF} no longer exists on origin — refusing to publish an orphaned tree (delete/re-tag recovery in flight?)"
   518	            exit 1
   519	          fi
   520	          if [ "$LIVE" != "${GITHUB_SHA}" ]; then
   521	            echo "::error::tag ${TAG_REF} now peels to ${LIVE} but this run was built from ${GITHUB_SHA} — obsolete run; approve/re-run only from the CURRENT tag's run"
   522	            exit 1
   523	          fi
   524	          echo "OK: refs/tags/${TAG_REF} still peels to ${GITHUB_SHA}"
