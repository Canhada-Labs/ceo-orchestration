   414	          awk -v hash="$HASH" '
   415	            NR == FNR { total = NR; next }
   416	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   417	            { print }
   418	          ' "$FILE" "$FILE" > "$FILE.new"
   419	          mv "$FILE.new" "$FILE"
   420	          chmod +x "$FILE"
