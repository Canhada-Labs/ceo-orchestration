   394	        # `# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL` trailer as its
   395	        # last line. At publish time, compute sha256 of the script body
   396	        # (all lines EXCEPT the last) and substitute the placeholder with
   397	        # the real hex. The script's own self-verify logic reads the same
   398	        # last-line pattern, so downstream adopters running
   399	        # `bash install.sh ...` trigger a rc=5 fail-CLOSED if the script
   400	        # is modified in transit.
   401	        working-directory: npm
