    95	  cancel-in-progress: false
    96	
    97	permissions:
    98	  contents: read
    99	  id-token: write   # required for OIDC trusted publishing + provenance
   100	
   101	# PLAN-194 W4.1 (D-12) — the publish TOOLCHAIN, declared ONCE for the two
   102	# jobs that run it (`publish` on GA tags, `rc-toolchain-proof` on RC
   103	# tags); no job or step redefines these keys. Node: the 24 line, which
   104	# setup-node resolves to a 24.x release (runner tool cache first, else
   105	# the actions/node-versions manifest) — above the Node >= 22.14.0 that
   106	# npm documents for trusted publishing. npm: an EXACT version, never a
   107	# range — 11.20.0 is the CLI that published the 1.4.2 GA (run
   108	# 36719886734). Moving either value (npm 12 included) is a written Owner
   109	# decision; test_release_workflow_asserts.py
   110	# (Plan194W4PublishToolchainTest) pins both and goes red otherwise.
   111	env:
   112	  PUBLISH_NODE_MAJOR: "24"
   113	  PUBLISH_NPM_VERSION: "11.20.0"
   114	
   115	jobs:
   116	  # ---------------------------------------------------------------------
   117	  # PLAN-166 W1 item 1 (F1, P0) — OBSERVE THE GOVERNANCE GATE.
   118	  # This job is the machine evidence that release.yml's `release-gate`
   119	  # job passed for this exact tag+SHA+push. It deliberately carries NO
   120	  # `environment:` and NO RC exclusion: it runs on rc tags too, which
   121	  # makes every RC a live positive control of the gate before GA ever
   122	  # depends on it.
   123	  # Decision function + battery: .claude/scripts/await_release_gate.py,
   124	  # .claude/scripts/tests/test_await_release_gate.py.
   125	  await-release-gate:
   126	    name: Await release-gate (release.yml)
   127	    runs-on: ubuntu-latest
   128	    # 50 > the poller's own 45-minute deadline, so a timeout surfaces as
   129	    # the decision function's fail-CLOSED BLOCK (with its inputs printed),
   130	    # not as an opaque runner kill. 45 min > the release-gate's own
   131	    # 35-minute timeout-minutes with margin (rail rc.3 r1 P1-3): the
   132	    # observer must always outlive the producer, or a gate finishing in
   133	    # minutes 31-35 goes green while the waiter already gave up.
   134	    timeout-minutes: 50
   135	    permissions:
   136	      contents: read   # checkout the tag to get the decision script
   137	      actions: read    # read release.yml's runs + jobs over the REST API
   138	    env:
   139	      # `permissions:` alone does NOT authenticate the `gh` CLI on a
   140	      # hosted runner. Without GH_TOKEN every poll dies on auth, which is
   141	      # BLOCK (fail-closed) — i.e. it would break EVERY release, RC and
   142	      # GA alike. This token is the job's only credential; the job has no
   143	      # id-token and no environment.
   144	      GH_TOKEN: ${{ github.token }}
   145	    steps:
   146	      - name: Checkout tag
   147	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   148	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   149	
   150	      # PLAN-169 W2.8 (ADR-192; pair-rail S300 r3 P1-1) — the program
   151	      # this job uses to WAIT for the release gate is itself a free
   152	      # script. Verifying the manifest only in release.yml is not
   153	      # enough: a drifted await_release_gate.py that fake-GRANTs would
   154	      # reach the production-npm approval while release.yml fails in
   155	      # parallel. Fail-closed BEFORE the script runs.
   156	      - name: Gate-scripts integrity (W2.8 checksum manifest)
   157	        run: |
   158	          set -euo pipefail
   159	          M=.claude/governance/gate-scripts-manifest.txt
   160	          [[ -f "$M" ]] || { echo "::error::$M missing (W2.8 canonical manifest)"; exit 1; }
   161	          shasum -a 256 -c "$M" \
   162	            || { echo "::error::gate-script drift vs $M (ADR-192) — member edits go through the canonical-edit ceremony"; exit 1; }
   163	          echo "OK: all gate scripts match $M"
   164	
   165	      - name: Poll release.yml until release-gate concludes
   166	        # No `${{ }}` interpolation inside this script by design — every
   167	        # value arrives through the environment, so no workflow expression
   168	        # is ever spliced into shell text.
   169	        run: |
   170	          set -euo pipefail
   171	          TAG="${GITHUB_REF_NAME}"
   172	          DEADLINE=$(( $(date +%s) + 2700 ))
   173	          SELF_CREATED_AT="$(gh api \
   174	            "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}" \
   175	            --jq '.created_at' < /dev/null)"
   176	          echo "inputs: tag=${TAG} head_sha=${GITHUB_SHA} run_id=${GITHUB_RUN_ID}"
   177	          echo "inputs: self_created_at=${SELF_CREATED_AT} deadline_epoch=${DEADLINE}"
   178	
   179	          fetch_payload() {
   180	            # One document: every run for THIS head_sha, each carrying its
   181	            # jobs. A run whose jobs endpoint is unreadable keeps no `jobs`
   182	            # key — the decision function reads that as WAIT, never GRANT.
   183	            if ! gh api --paginate \
   184	                "repos/${GITHUB_REPOSITORY}/actions/runs?head_sha=${GITHUB_SHA}&per_page=100" \
   185	                --jq '.workflow_runs[] | {id, run_attempt, path, event, head_branch, head_sha, created_at, status, conclusion}' \
   186	                > runs.ndjson < /dev/null; then
   187	              # An API error is BLOCK by design (ADR-186: input we cannot
   188	              # verify is blocked, not waved through).
   189	              echo '{"api_error": "runs listing failed"}' > payload.json
   190	              return 0
   191	            fi
   192	            : > runs_with_jobs.ndjson
   193	            while read -r run; do
   194	              [ -n "${run}" ] || continue
   195	              rid="$(printf '%s' "${run}" | jq -r '.id')"
   196	              if ! run_jobs="$(gh api \
   197	                  "repos/${GITHUB_REPOSITORY}/actions/runs/${rid}/jobs?per_page=100" \
   198	                  --jq '[.jobs[] | {name, status, conclusion}]' < /dev/null)"; then
   199	                printf '%s\n' "${run}" >> runs_with_jobs.ndjson
   200	                continue
   201	              fi
   202	              printf '%s' "${run}" \
   203	                | jq -c --argjson jobs "${run_jobs}" '. + {jobs: $jobs}' \
   204	                >> runs_with_jobs.ndjson
   205	            done < runs.ndjson
   206	            jq -c -s '{workflow_runs: .}' runs_with_jobs.ndjson > payload.json
   207	          }
   208	
   209	          attempt=0
   210	          while true; do
   211	            attempt=$(( attempt + 1 ))
   212	            fetch_payload
   213	            set +e
   214	            python3 .claude/scripts/await_release_gate.py \
   215	              --payload-file payload.json \
   216	              --tag "${TAG}" \
   217	              --head-sha "${GITHUB_SHA}" \
   218	              --self-created-at "${SELF_CREATED_AT}" \
   219	              --deadline-epoch "${DEADLINE}"
   220	            rc=$?
   221	            set -e
   222	            case "${rc}" in
   223	              0)
   224	                echo "::notice::release-gate green for ${TAG} at ${GITHUB_SHA} — publish authorised (poll ${attempt})"
   225	                exit 0
   226	                ;;
   227	              3)
   228	                sleep 20
   229	                ;;
   230	              *)
   231	                echo "::error::release-gate did not authorise this publish (decision exit ${rc}, poll ${attempt}) — the printed inputs above name the run and job that were evaluated"
   232	                exit 1
   233	                ;;
   234	            esac
   235	          done
   236	
   237	  publish:
   238	    # PLAN-013 Phase 0 item 0.2 — RC tag guard.
   239	    # RC tags contain `-rc.` (e.g. `v1.4.0-rc.1`). This job skips them
   240	    # entirely; they run `rc-toolchain-proof` (PLAN-194 W4.3, below),
   241	    # which cannot mint a registry credential and never publishes. Only
   242	    # GA tags (`v1.4.0`) proceed here, and those gate through the
   243	    # `production-npm` environment (manual approval).
   244	    # PLAN-153 Wave B item 5 (f): RC posture UNCHANGED — this exclusion
   245	    # is load-bearing (PLAN-013 anti-goals #3/#16) and MUST survive any
   246	    # future edit to this file; the draft `next` dist-tag idea was
   247	    # DROPPED by ratified debate. Pinned by
   248	    # .claude/scripts/tests/test_release_workflow_asserts.py.
   249	    if: "!contains(github.ref, '-rc.')"
   250	    # PLAN-166 W1 item 1: publish only starts after `await-release-gate`
   251	    # proved release.yml's release-gate job green for this exact tag+SHA
   252	    # (default `success()` semantics of `needs:` — an await failure skips
   253	    # this job while the run itself goes red). Deliberate ordering: the
   254	    # production-npm manual-approval prompt appears only AFTER the gate
   255	    # is green. The `already_published` guard stays below, in this job.
   256	    needs: await-release-gate
   257	    runs-on: ubuntu-latest
   258	    environment: production-npm
   259	    timeout-minutes: 8
   260	    steps:
   261	      - name: Checkout tag
   262	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
