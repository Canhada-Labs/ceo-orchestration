   403	          set -euo pipefail
   404	          FILE="scripts/install.sh"
   405	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   406	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   407	            echo "::error::$FILE trailer not at expected placeholder state"
   408	            echo "got: $TRAILER_LINE"
   409	            exit 1
   410	          fi
   411	          # Compute sha of everything EXCEPT the last line.
   412	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
