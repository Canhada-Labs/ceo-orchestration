/bin/zsh -lc "sed -n '300,470p' .claude/hooks/_lib/launch_ledger.py && sed -n '490,780p' .claude/hooks/_lib/launch_ledger.py && sed -n '775,1060p' .claude/hooks/_lib/launch_ledger.py" in /private/var/folders/9n/hm9srl0s1nz45_p12tj61pd80000gn/T/repass-ga.TOVy5x/wt
 succeeded in 0ms:
