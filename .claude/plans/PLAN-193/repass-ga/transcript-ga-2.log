   572	    # 4) Reset spool_writer dir caches so the new env resolves immediately.
   573	    try:
   574	        from _lib import spool_writer as _spool_writer
   575	        _spool_writer._reset_caches_for_test()
   576	    except Exception:
   577	        pass  # fail-open; cache invalidation is hygiene, not correctness
   578	
   579	    _REDIRECT = {"tmp_root": tmp_root, "env_snapshot": env_snapshot}
   580	    return _REDIRECT
