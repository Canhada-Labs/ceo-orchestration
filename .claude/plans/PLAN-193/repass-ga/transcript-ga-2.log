   583	def _deactivate_redirect(state: Dict[str, object]) -> None:
   584	    """Restore the env snapshot + remove the session tmpdir. Only the activating
   585	    fixture calls this (no-op fixtures pass ``None`` and skip)."""
   586	    global _REDIRECT
   587	    env_snapshot = state.get("env_snapshot") or {}
   588	    for key, value in env_snapshot.items():  # type: ignore[union-attr]
   589	        if value is None:
   590	            os.environ.pop(key, None)
   591	        else:
   592	            os.environ[key] = value
   593	    try:
   594	        from _lib import spool_writer as _spool_writer
   595	        _spool_writer._reset_caches_for_test()
   596	    except Exception:
   597	        pass
   598	    tmp_root = state.get("tmp_root")
   599	    if isinstance(tmp_root, Path):
   600	        shutil.rmtree(tmp_root, ignore_errors=True)
   601	    _REDIRECT = None
