   422	# --- Axis 4 — the host Claude Code CLI (module docstring) ------------------------
   423	#: The directory of the FAKE claude inside the session tree.
   424	CC_STUB_DIRNAME = "claude-code-stub"
   425	#: How bash hands an exported function named ``claude`` to its children: the
   426	#: upstream form, and the one some vendor fixes of 2014 used.
   427	CC_FUNCTION_CARRIERS = ("BASH_FUNC_claude%%", "BASH_FUNC_claude()")
   428	#: What the session snapshots and restores for Axis 4.
   429	CC_CLI_CARRIERS = ("PATH",) + CC_FUNCTION_CARRIERS
   430	_INSTALL_SH = Path(__file__).resolve().parents[3] / "scripts" / "install.sh"
   431	_CC_FLOOR_RE = re.compile(r'^CC_FLOOR_VERSION="([0-9]+\.[0-9]+\.[0-9]+)"$', re.M)
   432	
   433	
   434	def claude_code_floor(install_sh: Optional[Path] = None) -> Optional[str]:
   435	    """The Claude Code floor of ``scripts/install.sh`` (its ONE
   436	    ``CC_FLOOR_VERSION="x.y.z"`` line), or None when the file is unreadable or
   437	    holds no such line, or more than one."""
   438	    try:
   439	        text = (install_sh or _INSTALL_SH).read_text(encoding="utf-8")
   440	    except OSError:
   441	        return None
   442	    found = _CC_FLOOR_RE.findall(text)
   443	    return found[0] if len(found) == 1 else None
   444	
   445	
   446	def _install_claude_code_stub(root: Path) -> Optional[str]:
   447	    """Write the FAKE claude under ``root`` and return its directory; None
   448	    when there is no floor to report."""
   449	    floor = claude_code_floor()
   450	    if floor is None:
   451	        return None
   452	    stub_dir = root / CC_STUB_DIRNAME
   453	    stub_dir.mkdir(parents=True, exist_ok=True)
   454	    exe = stub_dir / "claude"
   455	    exe.write_text(
   456	        "#!/bin/sh\n"
   457	        "# FAKE Claude Code CLI of the pytest session (_lib/test_isolation.py,\n"
   458	        "# Axis 4): it answers only --version, with the floor of scripts/install.sh.\n"
   459	        'if [ "$#" -eq 1 ] && [ "$1" = "--version" ]; then\n'
   460	        '  echo "%s (Claude Code)"\n'
   461	        "  exit 0\n"
   462	        "fi\n"
   463	        'echo "claude: the test-suite stub answers only --version" >&2\n'
   464	        "exit 127\n" % floor,
   465	        encoding="utf-8",
   466	    )
   467	    exe.chmod(0o755)
   468	    return str(stub_dir)
