   471	# --- Idempotent redirect state -------------------------------------------------
   472	# Holds the restore snapshot for the ONE fixture instance that performed the
   473	# real redirect. None ⇒ no active redirect (next session fixture will activate).
   474	_REDIRECT: Optional[Dict[str, object]] = None
   475	
   476	
   477	def _activate_redirect() -> Optional[Dict[str, object]]:
   478	    """Perform the real redirect once. Returns the restore-state dict for the
   479	    activating fixture, or None if a redirect is already active (no-op)."""
   480	    global _REDIRECT
   481	    if _REDIRECT is not None:
   482	        return None  # a sibling conftest's session fixture already redirected
   483	
   484	    # 1) The live log path was snapshotted at IMPORT, before Axis 3 moved the
   485	    #    anchor (resolving it here would return the collection tree). Fall back
   486	    #    to resolving only if the import-time capture failed.
   487	    live_log_snapshot = (
   488	        IMPORT_TIME_LIVE_LOG_SNAPSHOT
   489	        if IMPORT_TIME_LIVE_LOG_SNAPSHOT is not None
   490	        else _resolve_live_log_path_snapshot()
   491	    )
   492	
   493	    # 2) Capture the REAL PyYAML user-site BEFORE the HOME redirect so subprocess
   494	    #    Python tooling (e.g. lint-skills' strict-YAML leg) still resolves it.
   495	    #    Computed while HOME is still real.
   496	    #
   497	    #    GNUPGHOME is DELIBERATELY *not* preserved to the real keyring — it is
   498	    #    CLEARED below so gpg resolves to the redirected HOME's (empty) `.gnupg`.
   499	    #    Exposing the REAL keyring to the suite let sentinel `.asc` verification
   500	    #    SUCCEED inside tests that expect it to FAIL with no key (e.g.
   501	    #    test_mcp_canonical_guard's "PROTOCOL.md must block" — a signed PLAN-020
   502	    #    sentinel scopes PROTOCOL.md, so a real-keyring verify wrongly ALLOWED it).
   503	    #    Tests that genuinely exercise GPG set their own keyring_home/GNUPGHOME.
   504	    import site as _site
   505	    try:
   506	        _real_userbase = _site.getuserbase()
   507	    except Exception:
   508	        _real_userbase = None
   509	    tooling_overrides: Dict[str, str] = {}
   510	    if _real_userbase:
   511	        tooling_overrides["PYTHONUSERBASE"] = _real_userbase
   512	
   513	    # 3) Snapshot every carrier + the sticky signals + the snapshot var + the
   514	    #    tooling vars + the Axis 4 CLI carriers for exact restore at session
   515	    #    end.
   516	    #    WHOLE_DIR_OVERRIDE_CARRIERS is ABSENT from this tuple on purpose: it
   517	    #    is the one carrier set that must NOT come back before the interpreter
   518	    #    exits (module docstring, Axis 2, measurement 2).
   519	    snapshot_keys = (
   520	        ALL_AUDIT_CARRIERS
   521	        + (TEST_HARNESS_VAR, SYNC_MODE_VAR, LIVE_LOG_SNAPSHOT_VAR)
   522	        + TOOLING_PRESERVE_VARS
   523	        + TOOLING_CLEAR_VARS
   524	        + CC_CLI_CARRIERS
   525	    )
   526	    env_snapshot: Dict[str, Optional[str]] = {
   527	        k: os.environ.get(k) for k in snapshot_keys
   528	    }
   529	
   530	    # 4) Build the isolated tree + redirect the full carrier set.
   531	    tmp_root = Path(tempfile.mkdtemp(prefix="ceo-suite-isolation-"))
   532	    overrides = audit_carrier_overrides(tmp_root)
   533	    # Materialize the dirs so writers don't fail to mkdir mid-emit.
   534	    Path(overrides["HOME"]).mkdir(parents=True, exist_ok=True)
   535	    Path(overrides["CEO_AUDIT_LOG_DIR"]).mkdir(parents=True, exist_ok=True)
   536	    Path(overrides["CEO_PROJECT_STATE_DIR"]).mkdir(parents=True, exist_ok=True)
   537	    os.environ.update(overrides)
   538	    # CLEAR carriers so a stale-inherited value can never point at the live tree.
   539	    for key in AUDIT_CLEAR_CARRIERS:
   540	        os.environ.pop(key, None)
   541	    # Re-assert the import-time neutralisation: a plugin, a conftest or an
   542	    # earlier test may have set a whole-dir override between this module's
   543	    # import and the first test. Not snapshotted above, so never restored.
   544	    for key in WHOLE_DIR_OVERRIDE_CARRIERS:
   545	        os.environ.pop(key, None)
   546	    # Re-export the real PyYAML user-site AFTER the HOME redirect (setdefault so a
   547	    # test that manages its own PYTHONUSERBASE keeps control).
   548	    for key, value in tooling_overrides.items():
   549	        os.environ.setdefault(key, value)
   550	    # CLEAR GNUPGHOME so gpg resolves under the redirected (empty) HOME/.gnupg —
   551	    # the suite must NOT reach the real signing keyring (see TOOLING_CLEAR_VARS).
   552	    for key in TOOLING_CLEAR_VARS:
   553	        os.environ.pop(key, None)
   554	    # Publish the live-log snapshot for the WS-D1 drain comparator (children
   555	    # inherit it). Only set when we actually resolved one.
   556	    if live_log_snapshot is not None:
   557	        os.environ[LIVE_LOG_SNAPSHOT_VAR] = live_log_snapshot
   558	
   559	    # Axis 4 (module docstring): an inherited exported claude FUNCTION would
   560	    # shadow every PATH fake, so it goes; then the FAKE claude at the floor
   561	    # goes FIRST on PATH, inside the session tree.
   562	    for key in CC_FUNCTION_CARRIERS:
   563	        os.environ.pop(key, None)
   564	    claude_stub = _install_claude_code_stub(tmp_root)
   565	    if claude_stub is not None:
   566	        inherited_path = os.environ.get("PATH")
   567	        # No empty entry when PATH was unset or empty: an empty entry is
   568	        # the current directory.
   569	        os.environ["PATH"] = claude_stub + (
   570	            os.pathsep + inherited_path if inherited_path else "")
