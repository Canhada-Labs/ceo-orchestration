   672	def snapshot_after_dispatch(d: Path, manifest: Dict[str, Any]) -> Dict[str, Any]:
   673	    """The PostToolUse half of a ``scriptPath`` record (FN-04). The caller passes ONLY the
   674	    manifest that the event's own ``tool_use_id`` names — the PostToolUse of that same call,
   675	    which the harness fires after it decided and ran the call — and only when the response
   676	    labels the run id as the run it launched (``run_id_is_labelled``). The file is read again through
   677	    the same bounded reader, relative to the cwd recorded before dispatch, and its bytes become
   678	    the snapshot only when they hash to the ``sha256`` recorded before dispatch. Otherwise
   679	    nothing is written and ``script_snapshot_why`` says why: ``unreadable_after_dispatch:<why>``,
   680	    ``changed_after_dispatch``, ``write_failed:<type>`` or ``error:<type>``. A record that is not
   681	    a hashed ``scriptPath`` one, that already names a snapshot, or whose launch id is ill-shaped
   682	    is returned unchanged. Returns a copy; never raises (the caller binds the run either way)."""
   683	    try:
   684	        sc = manifest.get("script")
   685	        if not isinstance(sc, dict) or sc.get("source") != "path" or sc.get("unreadable") is True:
   686	            return manifest
   687	        if manifest.get("script_snapshot") is not None:
   688	            return manifest
   689	        sh, sp, lid = sc.get("sha256"), sc.get("path"), manifest.get("launch_id")
   690	        if (not isinstance(sh, str) or SHA256_RE.fullmatch(sh) is None or not isinstance(sp, str) or not sp
   691	                or not isinstance(lid, str) or LAUNCH_ID_RE.fullmatch(lid) is None):
   692	            return manifest
   693	        out = dict(manifest)
   694	        p = Path(sp)
   695	        cwd = manifest.get("cwd")
   696	        if not p.is_absolute() and isinstance(cwd, str) and cwd:
   697	            p = Path(cwd) / p
   698	        data, why = _read_script_file(p)
   699	        if data is None:
   700	            out["script_snapshot_why"] = "unreadable_after_dispatch:%s" % why
   701	        elif hashlib.sha256(data).hexdigest() != sh:
   702	            out["script_snapshot_why"] = "changed_after_dispatch"
   703	        else:
   704	            try:
   705	                _atomic_write(snapshot_path(d, lid), data)
   706	            except Exception as exc:  # noqa: BLE001 — recorded; the bind still happens
   707	                out["script_snapshot_why"] = "write_failed:%s" % type(exc).__name__
   708	            else:
   709	                out["script_snapshot"] = snapshot_path(d, lid).name
   710	                out["script_snapshot_why"] = None
   711	        return out
   712	    except Exception as exc:  # noqa: BLE001
   713	        out = dict(manifest)
   714	        out["script_snapshot_why"] = "error:%s" % type(exc).__name__
   715	        return out
