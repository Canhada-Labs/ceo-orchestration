   453	def manifest_path(d: Path, launch_id: str) -> Path:
   454	    return d / ("%s.json" % launch_id)
   455	
   456	
   457	def snapshot_path(d: Path, launch_id: str) -> Path:
   458	    return d / ("%s.script" % launch_id)
