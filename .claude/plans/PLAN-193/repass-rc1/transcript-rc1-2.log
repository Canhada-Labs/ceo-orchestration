  1033	    """Rename log_path to a monthly rotated file if it exceeds the threshold.
  1034	
  1035	    Must be called UNDER the lock so no concurrent writer can race.
  1036	
  1037	    PLAN-045 Wave 2 P0-08: delegates to ``_lib.audit_rotation.rotate_if_needed``
  1038	    so both write paths (this ``append_entry`` + ``_lib.audit_emit._write_event``)
  1039	    share identical rotation semantics. Preserves the existing call
  1040	    signature for backwards compatibility.
  1041	
  1042	    PLAN-044 audit-v2 C6-P0-02 fix (Wave B): on successful rotation,
  1043	    invoke ``audit_hmac.reset_chain_on_rotation()`` so the HMAC chain
  1044	    starts a fresh genesis on the new log file. Without this, rotated
  1045	    logs continue chain from the previous final hmac into the new
  1046	    file's genesis row, which `audit-verify-chain.py` cannot validate
  1047	    (genesis is by definition prev_hmac=GENESIS_PREV; a non-genesis
  1048	    prev_hmac after rotation looks like silent tamper). Pattern was
  1049	    already correct in ``_lib.audit_emit._write_event`` — Wave B brings
  1050	    ``audit_log.py`` to parity.
  1051	
  1052	    Returns the rotated path if rotation happened, None otherwise.
  1053	    """
  1054	    try:
  1055	        from _lib.audit_rotation import rotate_if_needed as _shared_rotate
  1056	    except ImportError:
  1057	        # Defensive: if the shared primitive isn't available (partial
  1058	        # install), fall back to the inlined legacy implementation so
  1059	        # rotation still works in the classic path.
  1060	        rotated = _legacy_rotate_inline(log_path, threshold_bytes)

