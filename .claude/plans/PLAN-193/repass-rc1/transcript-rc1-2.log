   225	def args_record(tool_input: Dict[str, Any]) -> Dict[str, Any]:
   226	    """Record of ``args``: ABSENT when the key is missing, else two serialisations of what was
   227	    passed — ``literal`` in the ORIGINAL key order (the runner's script sees that order, so
   228	    ``relaunch`` reproduces it) and ``canonical`` with sorted keys (per-key comparison).
   229	    ``null`` stays ``null``; nothing is truncated. Total: a value that cannot be serialised
   230	    (a document nested past the interpreter's recursion limit) yields a record with
   231	    ``canonical``/``literal`` ``None`` and the error type — the guard is then inconclusive."""
   232	    if "args" not in tool_input:
   233	        return {"present": False, "canonical": ABSENT, "literal": ABSENT, "sha256": sha256_text(ABSENT),
   234	                "literal_sha256": sha256_text(ABSENT), "bytes": 0}
   235	    value = tool_input.get("args")
   236	    try:
   237	        canon = canonical_json(value)
   238	        literal = json.dumps(value, ensure_ascii=True, separators=(",", ":"))
   239	    except (RecursionError, ValueError, TypeError) as exc:
   240	        return {"present": True, "canonical": None, "literal": None, "sha256": None, "literal_sha256": None,
   241	                "bytes": None, "error": type(exc).__name__}
   242	    return {"present": True, "canonical": canon, "literal": literal, "sha256": sha256_text(canon),
   243	            "literal_sha256": sha256_text(literal), "bytes": len(literal)}
