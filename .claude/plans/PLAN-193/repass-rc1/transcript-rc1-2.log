   383	# --------------------------------------------------------------------------- manifests
   384	def _now_iso(now: Optional[float] = None) -> str:
   385	    t = time.time() if now is None else now
   386	    return datetime.fromtimestamp(t, tz=timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.%fZ")
   387	
   388	
   389	def build_manifest(event: Dict[str, Any], now: Optional[float] = None) -> Tuple[Dict[str, Any], Optional[bytes]]:
   390	    tool_input = event.get("tool_input") if isinstance(event.get("tool_input"), dict) else {}
   391	    cwd = event.get("cwd") if isinstance(event.get("cwd"), str) else None
   392	    script, script_bytes = script_record(tool_input, cwd)
   393	    args = args_record(tool_input)
   394	    seed = "%s|%s|%s|%s|%s" % (_now_iso(now), event.get("session_id"), event.get("tool_use_id"), script.get("sha256"), args["sha256"])
   395	    launch_id = "L-%s-%s" % (datetime.fromtimestamp(time.time() if now is None else now, tz=timezone.utc).strftime("%Y%m%dT%H%M%S"), sha256_text(seed)[:8])
   396	    resume = tool_input.get("resumeFromRunId")
   397	    manifest = {
   398	        "schema": SCHEMA,
   399	        "launch_id": launch_id,
   400	        "recorded_at": _now_iso(now),
   401	        "session_id": event.get("session_id") if isinstance(event.get("session_id"), str) else None,
   402	        "tool_use_id": event.get("tool_use_id") if isinstance(event.get("tool_use_id"), str) else None,
   403	        "cwd": cwd,
   404	        "script": script,
   405	        "script_snapshot": None,
   406	        # FN-04: a scriptPath file's bytes wait for the PostToolUse half of this same call.
   407	        "script_snapshot_why": "awaiting_post_tool_use" if (script.get("source") == "path" and script.get("sha256")) else None,
   408	        "args": args,
   409	        "resume_from_run_id": resume if isinstance(resume, str) and resume else None,
   410	        "resume_from_run_id_valid": is_run_id(resume) if isinstance(resume, str) and resume else None,
   411	        "name": tool_input.get("name") if isinstance(tool_input.get("name"), str) else None,
   412	        "description": tool_input.get("description") if isinstance(tool_input.get("description"), str) else None,
   413	        "force_declared": force_declaration(tool_input.get("description")) is not None,
   414	        "code": {"head": None, "dirty": None, "status": "pending"},
   415	        "run_id": None,
   416	        "bound_at": None,
   417	        "bind_method": None,
   418	        "persisted_script_path": None,
   419	        "persisted_matches_snapshot": None,
   420	        "guard": {"result": "none", "diff": [], "counts": {}},
   421	    }
   422	    return manifest, script_bytes
   423	
   424	
   425	def fallback_manifest(event: Dict[str, Any], error: str, now: Optional[float] = None) -> Dict[str, Any]:
   426	    """The record written when ``build_manifest`` itself raised: the call is still recorded,
   427	    with its error, and the guard result is ``inconclusive`` (never a silent allow)."""
   428	    tool_input = event.get("tool_input") if isinstance(event.get("tool_input"), dict) else {}
   429	    t = time.time() if now is None else now
   430	    sid = event.get("session_id") if isinstance(event.get("session_id"), str) else None
   431	    tuid = event.get("tool_use_id") if isinstance(event.get("tool_use_id"), str) else None
   432	    seed = "%s|%s|%s|%s" % (_now_iso(t), sid, tuid, error)
   433	    resume = tool_input.get("resumeFromRunId")
   434	    resume = resume if isinstance(resume, str) and resume else None
   435	    return {
   436	        "schema": SCHEMA,
   437	        "launch_id": "L-%s-%s" % (datetime.fromtimestamp(t, tz=timezone.utc).strftime("%Y%m%dT%H%M%S"), sha256_text(seed)[:8]),
   438	        "recorded_at": _now_iso(t), "session_id": sid, "tool_use_id": tuid,
   439	        "cwd": event.get("cwd") if isinstance(event.get("cwd"), str) else None,
   440	        "script": {"source": "unknown", "path": None, "sha256": None, "bytes": None, "unreadable": True, "why": "build_failed"},
   441	        "script_snapshot": None, "script_snapshot_why": None,
   442	        "args": {"present": "args" in tool_input, "canonical": None, "literal": None, "sha256": None,
   443	                 "literal_sha256": None, "bytes": None, "error": error},
   444	        "resume_from_run_id": resume, "resume_from_run_id_valid": is_run_id(resume) if resume else None,
   445	        "name": None, "description": None, "force_declared": False,
   446	        "code": {"head": None, "dirty": None, "status": "pending"},
   447	        "run_id": None, "bound_at": None, "bind_method": None,
   448	        "persisted_script_path": None, "persisted_matches_snapshot": None,
   449	        "guard": {"result": "inconclusive", "error": "build:" + error, "diff": [], "counts": {}},
   450	    }
