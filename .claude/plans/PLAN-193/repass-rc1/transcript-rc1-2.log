   999	def _detect_rail(prompt: str, subagent_type: str) -> Optional[str]:
  1000	    """Detect spawn dispatch rail (native vs custom) from prompt + subagent.
  1001	
  1002	    Heuristic order:
  1003	    1. If subagent_type matches a canonical-5 archetype name AND the
  1004	       prompt has `## SKILL REFERENCE` sentinel → "native".
  1005	    2. Else if prompt has `## SKILL CONTENT` (legacy inline) → "custom".
  1006	    3. Else if prompt has `## SKILL REFERENCE` only → "native"
  1007	       (subagent_type may be empty for some adapters).
  1008	    4. Else None (unknown / pre-PLAN-020 / non-spawn event).
  1009	    """
  1010	    if not isinstance(prompt, str):
  1011	        return None
  1012	    has_reference = bool(_SKILL_REFERENCE_RE.search(prompt))
  1013	    has_content = bool(_SKILL_CONTENT_RE.search(prompt))
  1014	    is_canonical = (
  1015	        isinstance(subagent_type, str) and subagent_type in _CANONICAL_5
  1016	    )
  1017	
  1018	    if is_canonical and has_reference:
  1019	        return "native"
  1020	    if has_content:
  1021	        return "custom"
  1022	    if has_reference:
  1023	        return "native"
  1024	    return None
