   211	def canonical_json(value: Any) -> str:
   212	    # ASCII-escaped: total over every str Python can hold (a lone surrogate included), so hashing
   213	    # and writing a record can never raise on operator input.
   214	    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
