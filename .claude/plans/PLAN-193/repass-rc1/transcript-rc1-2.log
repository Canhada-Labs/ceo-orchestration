   160	def _atomic_write(path: Path, data: bytes) -> None:
   161	    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=str(path.parent))
   162	    try:
   163	        with os.fdopen(fd, "wb") as fh:
   164	            fh.write(data)
   165	        os.chmod(tmp, 0o600)
   166	        os.replace(tmp, str(path))
   167	    except Exception:
   168	        try:
   169	            os.unlink(tmp)
   170	        except OSError:
   171	            pass
   172	        raise
