   872	def format_advisory(run_id: str, comparison: Dict[str, Any], launch_id: str, weak_bind: bool = False,
   873	                    against: Optional[str] = None) -> str:
   874	    """Script-only advisory. ``run_id`` MUST have passed ``is_run_id``; launch ids are generated here."""
   875	    if weak_bind:
   876	        tail = ("The recorded manifest %s was bound heuristically (no tool_use_id), and a heuristic bind never sustains a "
   877	                "block: `python3 .claude/scripts/ceo-launches.py bind %s %s` makes it enforceable." % (against or "?", against or "<launch_id>", run_id))
   878	    else:
   879	        tail = "Set CEO_WORKFLOW_SCRIPT_GUARD=enforce to block this case."
   880	    return (
   881	        "WORKFLOW-RESUME-ADVISORY: the script of %s differs from the recorded launch (hash); args are identical. "
   882	        "Only the phases whose prompt changed will re-execute. Recorded in manifest %s. %s" % (run_id, launch_id, tail)
   883	    )
