   310	def git_revision(cwd: Optional[str], budget_s: float = GIT_BUDGET_S) -> Dict[str, Any]:
   311	    """``HEAD`` and dirty flag of ``cwd`` inside a wall budget; unknown (``None``)
   312	    on any failure or timeout. ``--no-optional-locks`` keeps the hook from
   313	    taking the index lock under a pipeline's own git activity."""
   314	    if not cwd or not Path(cwd).is_dir():
   315	        return {"head": None, "dirty": None}
   316	    t0 = time.monotonic()
   317	    try:
   318	        head = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", cwd, "rev-parse", "HEAD"], capture_output=True, text=True, timeout=budget_s / 2)
   319	        if head.returncode != 0:
   320	            return {"head": None, "dirty": None}
   321	        remaining = budget_s - (time.monotonic() - t0)
   322	        if remaining <= 0.05:
   323	            return {"head": head.stdout.strip() or None, "dirty": None}
   324	        st = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", cwd, "status", "--porcelain", "--untracked-files=no"], capture_output=True, text=True, timeout=remaining)
   325	        dirty = bool(st.stdout.strip()) if st.returncode == 0 else None
   326	        return {"head": head.stdout.strip() or None, "dirty": dirty}
   327	    except Exception:
   328	        return {"head": None, "dirty": None}
