   981	def decide_post(event: Dict[str, Any], d: Path, now: Optional[float] = None) -> Optional[Dict[str, Any]]:
   982	    """PostToolUse: bind the run id from the response — by tool_use_id, else by the single
   983	    unbound launch of the session. An unknown tool_use_id, or zero/several candidates, becomes an
   984	    ``orphan`` line; a response with no run id, or with ambiguous ids, records nothing. The
   985	    ``by_tool_use`` bind first takes the snapshot of a ``scriptPath`` file
   986	    (``snapshot_after_dispatch``) — only when the harness reported that id as the run it launched
   987	    (``run_id_is_labelled``), else ``script_snapshot_why: run_id_not_labelled``; the heuristic
   988	    bind never reads that file — this PostToolUse may belong to another call — and ``bind_run``
   989	    records ``script_snapshot_why: not_bound_by_tool_use`` (as for a manual bind)."""
   990	    run_id = extract_run_id(event.get("tool_response"))
   991	    if run_id is None:
   992	        return None
   993	    session = event.get("session_id") if isinstance(event.get("session_id"), str) else None
   994	    tuid = event.get("tool_use_id") if isinstance(event.get("tool_use_id"), str) and event.get("tool_use_id") else None
   995	    persisted = extract_persisted_script_path(event.get("tool_response"))
