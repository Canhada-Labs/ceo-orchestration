   892	def _guard(manifest: Dict[str, Any], resume: str, d: Path, env: Dict[str, str]) -> Dict[str, Any]:
   893	    """Sets ``manifest["guard"]`` and returns the hook decision for a call carrying
   894	    ``resumeFromRunId``. Pure over (this call, the validated recorded manifest, env)."""
   895	    guard_mode = "advisory" if env.get("CEO_WORKFLOW_RESUME_GUARD") == "0" else "enforce"
   896	    script_guard = "enforce" if env.get("CEO_WORKFLOW_SCRIPT_GUARD") == "enforce" else "advisory"
   897	    if not is_run_id(resume):
   898	        manifest["guard"] = {"result": "resume_id_unrecognised", "diff": [], "counts": {}}
   899	        return {}
   900	    recorded = find_launch_for_run(d, resume)
   901	    if recorded is None:
   902	        manifest["guard"] = {"result": "no_manifest", "diff": [], "counts": {}}
   903	        return {}
   904	    problem = manifest_problem(recorded, d)
   905	    if problem is not None:
   906	        manifest["guard"] = {"result": "inconclusive", "integrity": problem, "diff": [], "counts": {}}
   907	        return {}
   908	    cmp = compare(recorded, manifest)
   909	    if cmp["args"] == "inconclusive":
   910	        manifest["guard"] = {"result": "inconclusive", "integrity": "args_uncanonicalized", "diff": [], "counts": cmp["counts"],
   911	                             "against": recorded["launch_id"]}
   912	        return {}
   913	    weak_bind = recorded["bind_method"] not in STRONG_BIND_METHODS
   914	    base = {"diff": cmp["args_diff"], "counts": cmp["counts"], "script": cmp["script"],
   915	            "against": recorded["launch_id"], "mode": guard_mode, "weak_bind": weak_bind}
   916	    args_differ = cmp["counts"]["total"] > 0
   917	    if not args_differ and cmp["script"] == "same":
   918	        manifest["guard"] = dict(base, result="match")
   919	        return {}
   920	    if not args_differ and cmp["script"] == "inconclusive":
   921	        manifest["guard"] = dict(base, result="inconclusive")
   922	        return {}
   923	    # A block needs ALL of: enforce mode, a STRONG bind (tool_use_id or manual — a heuristic
   924	    # bind never sustains a block, args or script alike), and either an args difference or a
   925	    # script difference under CEO_WORKFLOW_SCRIPT_GUARD=enforce.
   926	    would_block = guard_mode == "enforce" and not weak_bind and (args_differ or script_guard == "enforce")
   927	    if would_block:
   928	        # ONE override path for every block, carried by the call or the process — never by state.
   929	        source: Optional[str] = None
   930	        reason: Optional[str] = None
   931	        if env.get("CEO_WORKFLOW_RESUME_FORCE") == "1":
   932	            source, reason = "env", "CEO_WORKFLOW_RESUME_FORCE=1"
   933	        else:
   934	            declared = force_declaration(manifest.get("description"))
   935	            if declared is not None:
   936	                source, reason = "call", declared
   937	        if source is not None:
   938	            manifest["guard"] = dict(base, result="mismatch_forced", force_source=source, force_reason=reason)
   939	            where = "in this call's description" if source == "call" else "in the harness environment"
   940	            return notice("WORKFLOW-RESUME-FORCED: resuming %s over different inputs by an explicit override declared %s (recorded in manifest %s)." % (resume, where, manifest["launch_id"]))
   941	        manifest["guard"] = dict(base, result="mismatch_blocked" if args_differ else "mismatch_script_blocked")
   942	        return {"decision": "block", "reason": format_block_reason(resume, cmp, manifest["launch_id"])}
   943	    if args_differ:
   944	        manifest["guard"] = dict(base, result="mismatch_advisory_weak_bind" if weak_bind and guard_mode != "advisory" else "mismatch_advisory")
   945	        return notice(format_mismatch_advisory(resume, cmp, manifest["launch_id"], weak_bind and guard_mode != "advisory", recorded["launch_id"]))
   946	    manifest["guard"] = dict(base, result="mismatch_script_advisory")
   947	    return notice(format_advisory(resume, cmp, manifest["launch_id"], weak_bind=weak_bind, against=recorded["launch_id"]))
