   245	
   246	def _read_script_file(p: Path) -> Tuple[Optional[bytes], Optional[str]]:
   247	    """Bytes of a REGULAR file of at most ``SCRIPT_MAX_BYTES``, or ``(None, why)``. Opened
   248	    non-blocking and type-checked on the open descriptor, so a FIFO or device path never
   249	    stalls the hook and cannot be swapped in between the check and the read; a path with a
   250	    NUL byte (``ValueError``) is unreadable, not an exception."""
   251	    try:
   252	        fd = os.open(str(p), os.O_RDONLY | getattr(os, "O_NONBLOCK", 0))
   253	    except (OSError, ValueError):
   254	        return None, "open_failed"
   255	    try:
   256	        st = os.fstat(fd)
   257	        if not stat.S_ISREG(st.st_mode):
   258	            return None, "not_a_regular_file"
   259	        if st.st_size > SCRIPT_MAX_BYTES:
   260	            return None, "too_large"
   261	        chunks = []
   262	        total = 0
   263	        while True:
   264	            chunk = os.read(fd, 1024 * 1024)
   265	            if not chunk:
   266	                break
   267	            total += len(chunk)
   268	            if total > SCRIPT_MAX_BYTES:
   269	                return None, "too_large"
   270	            chunks.append(chunk)
   271	        return b"".join(chunks), None
   272	    except OSError:
   273	        return None, "read_failed"
   274	    finally:
   275	        os.close(fd)
   276	
   277	
   278	read_script_file = _read_script_file  # public name for the CLI
   279	
   280	
   281	def script_record(tool_input: Dict[str, Any], cwd: Optional[str]) -> Tuple[Dict[str, Any], Optional[bytes]]:
   282	    """Fingerprint of the script plus the bytes to snapshot NOW (PreToolUse). Inline
   283	    ``script`` text wins over ``scriptPath``; an unreadable ``scriptPath`` is
   284	    recorded (no hash, no snapshot) — the guard then reports INCONCLUSIVE.
   285	
   286	    Only the call's own inline text is returned for a snapshot. A file named by
   287	    ``scriptPath`` is read to compute its ``sha256`` and size and its bytes are then
   288	    dropped (``None``): this runs before the harness's permission decision, and a
   289	    copy written here would escape a read-deny rule on that path (FN-04). Its
   290	    snapshot is ``snapshot_after_dispatch``'s, on the PostToolUse half."""
   291	    script = tool_input.get("script")
   292	    if isinstance(script, str) and script:
   293	        data = script.encode("utf-8", "surrogatepass")
   294	        return {"source": "inline", "path": None, "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}, data
   295	    sp = tool_input.get("scriptPath")
   296	    if isinstance(sp, str) and sp:
   297	        p = Path(sp)
   298	        if not p.is_absolute() and cwd:
   299	            p = Path(cwd) / p
   300	        data, why = _read_script_file(p)
   301	        if data is None:
   302	            return {"source": "path", "path": sp, "sha256": None, "bytes": None, "unreadable": True, "why": why}, None
   303	        return {"source": "path", "path": sp, "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}, None
   304	    name = tool_input.get("name")
   305	    if isinstance(name, str) and name:
   306	        return {"source": "named", "path": None, "name": name, "sha256": None, "bytes": None}, None
   307	    return {"source": "absent", "path": None, "sha256": None, "bytes": None}, None
   308	
   309	
   310	def git_revision(cwd: Optional[str], budget_s: float = GIT_BUDGET_S) -> Dict[str, Any]:
   311	    """``HEAD`` and dirty flag of ``cwd`` inside a wall budget; unknown (``None``)
   312	    on any failure or timeout. ``--no-optional-locks`` keeps the hook from
   313	    taking the index lock under a pipeline's own git activity."""
   314	    if not cwd or not Path(cwd).is_dir():
   315	        return {"head": None, "dirty": None}
   316	    t0 = time.monotonic()
   317	    try:
   318	        head = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", cwd, "rev-parse", "HEAD"], capture_output=True, text=True, timeout=budget_s / 2)
   319	        if head.returncode != 0:
   320	            return {"head": None, "dirty": None}
   321	        remaining = budget_s - (time.monotonic() - t0)
   322	        if remaining <= 0.05:
   323	            return {"head": head.stdout.strip() or None, "dirty": None}
   324	        st = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", cwd, "status", "--porcelain", "--untracked-files=no"], capture_output=True, text=True, timeout=remaining)
   325	        dirty = bool(st.stdout.strip()) if st.returncode == 0 else None
   326	        return {"head": head.stdout.strip() or None, "dirty": dirty}
   327	    except Exception:
   328	        return {"head": None, "dirty": None}
   329	
   330	
   331	def extract_run_id(tool_response: Any) -> Optional[str]:
   332	    """The run id the harness launched: a ``runId``/``run_id`` key; else the id on the
   333	    ``Run ID:`` label (the harness prints it on launch AND on resume, where the id is the
   334	    same); else the only distinct ``wf_<hex8>[-<hex>]`` token in the response. Two different
   335	    labelled ids, or two different unlabelled ids, are ambiguous ⇒ ``None`` — never the first
   336	    one found. With ``None``, ``decide_post`` records NOTHING: the launch stays unbound (visible in
   337	    ``ceo-launches.py list``) and ``bind`` closes it by hand."""
   338	    if tool_response is None:
   339	        return None
   340	    if isinstance(tool_response, dict):
   341	        for key in ("runId", "run_id"):
   342	            v = tool_response.get(key)
   343	            if is_run_id(v):
   344	                return v
   345	    try:
   346	        text = tool_response if isinstance(tool_response, str) else json.dumps(tool_response, ensure_ascii=True)
   347	    except (RecursionError, ValueError, TypeError):
   348	        return None
   349	    labelled = set(_RUN_ID_LABEL_RE.findall(text))
   350	    if len(labelled) == 1:
   351	        return labelled.pop()
   352	    if len(labelled) > 1:
   353	        return None
   354	    ids = set(RUN_ID_RE.findall(text))
   355	    return ids.pop() if len(ids) == 1 else None
   356	
   357	
   358	def run_id_is_labelled(tool_response: Any, run_id: str) -> bool:
   359	    """True when the harness itself reported ``run_id`` as the run it launched: a top-level
   360	    ``runId``/``run_id`` key equal to it, or it is the id on the ``Run ID:`` label. An id found
   361	    only as a bare token (the fallback of ``extract_run_id``) is not such a report — an error text
   362	    that merely echoes a ``resumeFromRunId`` would carry one."""
   363	    if not is_run_id(run_id) or tool_response is None:
   364	        return False
   365	    if isinstance(tool_response, dict) and any(tool_response.get(k) == run_id for k in ("runId", "run_id")):
   366	        return True
   367	    try:
   368	        text = tool_response if isinstance(tool_response, str) else json.dumps(tool_response, ensure_ascii=True)
   369	    except (RecursionError, ValueError, TypeError):
   370	        return False
   371	    return run_id in set(_RUN_ID_LABEL_RE.findall(text))
   372	
   373	
   374	def extract_persisted_script_path(tool_response: Any) -> Optional[str]:
   375	    try:
   376	        text = tool_response if isinstance(tool_response, str) else json.dumps(tool_response, ensure_ascii=True) if tool_response is not None else ""
   377	    except (RecursionError, ValueError, TypeError):
   378	        return None
   379	    m = _PERSISTED_SCRIPT_RE.search(text)
   380	    return m.group(1) if m else None
