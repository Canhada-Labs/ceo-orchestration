   400	        os.environ[LIVE_LOG_SNAPSHOT_VAR] = snapshot
   401	    else:
   402	        os.environ.pop(LIVE_LOG_SNAPSHOT_VAR, None)
   403	    # 3) move the anchors
   404	    previous = {
   405	        "CEO_AUDIT_LOG_DIR": os.environ.get("CEO_AUDIT_LOG_DIR"),
   406	        "CEO_PROJECT_STATE_DIR": os.environ.get("CEO_PROJECT_STATE_DIR"),
   407	    }
   408	    os.environ["CEO_AUDIT_LOG_DIR"] = str(audit)
   409	    os.environ["CEO_PROJECT_STATE_DIR"] = str(state)
