   484	def enrich_code_revision(manifest: Dict[str, Any], d: Path, budget_s: float = GIT_BUDGET_S) -> Dict[str, Any]:
   485	    """Second, optional write: code revision inside a strict budget."""
   486	    rev = git_revision(manifest.get("cwd"), budget_s=budget_s)
   487	    manifest = dict(manifest)
   488	    manifest["code"] = {"head": rev.get("head"), "dirty": rev.get("dirty"), "status": "known" if rev.get("head") else "unknown"}
   489	    try:
   490	        _atomic_write_json(manifest_path(d, manifest["launch_id"]), manifest)

