   962	def _resolve_dispatch_mode(
   963	    subagent_type: str,
   964	    rail: Optional[str],
   965	) -> Optional[str]:
   966	    """PLAN-044 audit-v2 C3-P0-08 — Wave B: derive dispatch_mode field.
   967	
   968	    Maps (subagent_type, rail) → "native" | "mitigated" per the
   969	    PLAN-061 / ADR-082 dispatch policy:
   970	
   971	      - canonical-5 native rail → "native" (full tool grant per
   972	        ADR-052 floor; H4 anomaly does NOT apply because empirically
   973	        only `code-reviewer` is reliable; PLAN-061 default-on routes
   974	        the other 4 via mitigated).
   975	      - any non-canonical archetype → "mitigated" (general-purpose
   976	        with persona injected via `## SKILL CONTENT`).
   977	      - rail=None or unknown → None (legacy / pre-PLAN-061).
   978	
   979	    See ADR-082 §Routing decision and `inject-agent-context.sh` for
   980	    the live override matrix (CEO_DISPATCHER_MODE,
   981	    CEO_MITIGATION_DISABLE).
   982	    """
   983	    if not isinstance(subagent_type, str):
   984	        return None
   985	    # Canonical-5 native rail — only code-reviewer routes natively
   986	    # by default per PLAN-061 / ADR-082. Other 4 are mitigated.
   987	    if subagent_type == "code-reviewer" and rail == "native":
   988	        return "native"
   989	    if subagent_type in _CANONICAL_5 and rail == "custom":
   990	        # Older inline ## SKILL CONTENT prompt — pre-PLAN-061 spawn.
   991	        return "native_legacy"
   992	    if rail is None:
   993	        return None
   994	    # Default mitigated rail for non-canonical-5 + non-cr canonicals
   995	    # under PLAN-061 default-on.
   996	    return "mitigated"
   997	
