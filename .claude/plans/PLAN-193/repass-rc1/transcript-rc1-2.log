   749	# --------------------------------------------------------------------------- the guard
   750	def _args_key_diff(recorded_canon: str, now_canon: str) -> List[Dict[str, Any]]:
   751	    """Top-level keys whose canonical values differ (or exist on one side only).
   752	    Non-object args are compared as whole values. Values never appear — short hashes do."""
   753	    diffs: List[Dict[str, Any]] = []
   754	    if recorded_canon == now_canon:
   755	        return diffs
   756	    if recorded_canon == ABSENT or now_canon == ABSENT:
   757	        return [{"key": "<args>", "recorded": recorded_canon if recorded_canon == ABSENT else "present", "now": now_canon if now_canon == ABSENT else "present"}]
   758	    try:
   759	        a = json.loads(recorded_canon)
   760	        b = json.loads(now_canon)
   761	    except (ValueError, RecursionError):
   762	        return [{"key": "<args>", "recorded": "unparseable", "now": "unparseable"}]
   763	    if not isinstance(a, dict) or not isinstance(b, dict):
   764	        return [{"key": "<args>", "recorded": sha256_text(recorded_canon)[:12], "now": sha256_text(now_canon)[:12]}]
   765	    for k in sorted(set(a) | set(b)):
   766	        if k not in a:
   767	            diffs.append({"key": k, "recorded": ABSENT, "now": "present"})
   768	        elif k not in b:
   769	            diffs.append({"key": k, "recorded": "present", "now": ABSENT})
   770	        elif canonical_json(a[k]) != canonical_json(b[k]):
   771	            diffs.append({"key": k, "recorded": sha256_text(canonical_json(a[k]))[:12], "now": sha256_text(canonical_json(b[k]))[:12]})
   772	    return diffs
   773	
   774	
   775	def compare(recorded: Dict[str, Any], now: Dict[str, Any]) -> Dict[str, Any]:
   776	    """Structured comparison: ``script`` ∈ {same, differs, inconclusive}; ``args`` ∈ {same,
   777	    differ, inconclusive}; ``args_diff`` list; ``counts`` = {changed, only_recorded, only_now,
   778	    order, total} — the counts are the only thing that may reach the model. Equal canonical
   779	    forms with a different literal key order count as ONE difference (``order``): the script
   780	    sees the order, so a reordered call can re-key phases. The RECORDED script hash counts only
   781	    when snapshot bytes reproduce it (``manifest_problem`` checks them): a ``scriptPath`` record
   782	    without a snapshot carries a hash read before dispatch and never corroborated after it
   783	    (FN-04), so its script comparison is ``inconclusive`` — never ``same`` nor ``differs``."""
   784	    r_s = (recorded.get("script") or {}).get("sha256")
   785	    if (recorded.get("script") or {}).get("source") == "path" and recorded.get("script_snapshot") is None:
   786	        r_s = None
   787	    n_s = (now.get("script") or {}).get("sha256")
   788	    if r_s is None or n_s is None:
   789	        script = "inconclusive"
   790	    else:
   791	        script = "same" if r_s == n_s else "differs"
   792	    ra = recorded.get("args") or {}
   793	    na = now.get("args") or {}
   794	    empty = {"changed": 0, "only_recorded": 0, "only_now": 0, "order": 0, "total": 0}
   795	    if not isinstance(ra.get("canonical"), str) or not isinstance(na.get("canonical"), str):
   796	        return {"script": script, "args": "inconclusive", "args_diff": [], "counts": empty}
   797	    diffs = _args_key_diff(ra["canonical"], na["canonical"])
   798	    if ra["canonical"] != na["canonical"] and not diffs:
   799	        # defensive: canonical forms differ but no per-key difference was named — still ONE change
   800	        diffs = [{"key": "<args>", "recorded": sha256_text(ra["canonical"])[:12], "now": sha256_text(na["canonical"])[:12]}]
   801	    order = 1 if (ra["canonical"] == na["canonical"] and ra.get("literal") != na.get("literal")) else 0
   802	    counts = {
   803	        "changed": sum(1 for d in diffs if d["recorded"] not in (ABSENT, "present") and d["now"] not in (ABSENT, "present")),
   804	        "only_recorded": sum(1 for d in diffs if d["now"] == ABSENT),
   805	        "only_now": sum(1 for d in diffs if d["recorded"] == ABSENT),
   806	        "order": order,
   807	        "total": len(diffs) + order,
   808	    }
   809	    return {"script": script, "args": "differ" if counts["total"] else "same", "args_diff": diffs, "counts": counts}
   810	
