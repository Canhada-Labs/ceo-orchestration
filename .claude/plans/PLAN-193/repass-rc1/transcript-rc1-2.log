   460	
   461	def write_manifest(manifest: Dict[str, Any], d: Path, script_bytes: Optional[bytes] = None) -> Path:
   462	    """Manifest (and the snapshot of ``script_bytes``, when given — at PreToolUse only an
   463	    inline script's text) on disk FIRST; the index line after."""
   464	    if script_bytes is not None:
   465	        _atomic_write(snapshot_path(d, manifest["launch_id"]), script_bytes)
   466	        manifest["script_snapshot"] = snapshot_path(d, manifest["launch_id"]).name
   467	    path = manifest_path(d, manifest["launch_id"])
   468	    _atomic_write_json(path, manifest)
   469	    _append_index(d, {
   470	        "kind": "launch",
   471	        "launch_id": manifest["launch_id"],
   472	        "recorded_at": manifest["recorded_at"],
   473	        "session_id": manifest.get("session_id"),
   474	        "tool_use_id": manifest.get("tool_use_id"),
   475	        "resume_from_run_id": manifest.get("resume_from_run_id"),
   476	        "script_sha256": (manifest.get("script") or {}).get("sha256"),
   477	        "args_sha256": (manifest.get("args") or {}).get("sha256"),
   478	        "guard": (manifest.get("guard") or {}).get("result"),
   479	        "blocked": (manifest.get("guard") or {}).get("result") in BLOCKING_RESULTS,
   480	    })
   481	    return path
   482	
