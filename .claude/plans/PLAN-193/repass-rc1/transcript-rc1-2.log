   199	def _resolve_effort_config(
   200	    model: str,
   201	) -> Tuple[Optional[Dict[str, Any]], Optional[Dict[str, Any]]]:
   202	    """PLAN-091 Wave A.3 + PLAN-134 W0 E6-F2 — resolve `/effort` for ``model``.
   203	
   204	    Reads the ``CEO_EFFORT_OVERRIDE`` env-var set by the `/effort` slash
   205	    command and translates it to the Anthropic Messages API surface valid
   206	    for ``model``:
   207	
   208	    - Adaptive-only ids (every id outside the closed legacy list that
   209	      ``_uses_legacy_budget`` matches): returns
   210	      ``({"type": "adaptive"}, {"effort": <level>})`` via the canonical
   211	      ``_SLASH_EFFORT_TABLE`` from ``_lib.model_routing``. ``off`` resolves
   212	      to ``(None, None)`` — the thinking param is OMITTED entirely (an
   213	      explicit ``{"type": "disabled"}`` is an HTTP 400 on Fable 5). On
   214	      an id whose thinking defaults on, omitting it leaves thinking ON:
   215	      ``off`` does not turn thinking off there (ADR-149 A3.4).
   216	    - Legacy (pre-4.6) ids: returns
   217	      ``({"type": "enabled", "budget_tokens": N}, None)`` via the kept
   218	      ``_SLASH_BUDGET_TABLE`` (single source of truth for budgets).
   219	
   220	    Returns:
   221	        ``(thinking_or_None, output_config_or_None)`` — ``(None, None)`` on
   222	        no env, malformed env, ``off``/zero budget, or import failure
   223	        (fail-soft to caller-default).
   224	
   225	    The ``CEO_THINKING_AUTO_DISABLE=1`` kill-switch is honored at the
   226	    callsite, not here — this helper only resolves a candidate config.
   227	    """
   228	    effort = os.environ.get("CEO_EFFORT_OVERRIDE", "").strip().lower()
   229	    if not effort:
   230	        return None, None
   231	    try:
   232	        from ... import model_routing  # type: ignore
   233	    except Exception:  # noqa: BLE001 — adapter must never raise on env mishaps
   234	        return None, None
   235	    if _is_adaptive_only(model):
   236	        effort_table = getattr(model_routing, "_SLASH_EFFORT_TABLE", {})
   237	        level = effort_table.get(effort)
   238	        if not isinstance(level, str) or not level:
   239	            # "off" (maps to None) or unknown token → omit thinking entirely.
   240	            return None, None
   241	        return {"type": "adaptive"}, {"effort": level}
   242	    budget_table = getattr(model_routing, "_SLASH_BUDGET_TABLE", {})
   243	    budget = budget_table.get(effort, 0)
   244	    if not isinstance(budget, int) or budget <= 0:
   245	        return None, None
   246	    return {"type": "enabled", "budget_tokens": int(budget)}, None
