   718	def bind_run(d: Path, manifest: Dict[str, Any], run_id: str, method: str, now: Optional[float] = None,
   719	             persisted_script_path: Optional[str] = None) -> Dict[str, Any]:
   720	    if not is_run_id(run_id):
   721	        raise ValueError("run id has an unexpected shape")
   722	    manifest = dict(manifest)
   723	    previous = manifest.get("run_id")
   724	    if isinstance(previous, str) and previous and previous != run_id:
   725	        _append_index(d, {"kind": "unbind", "launch_id": manifest["launch_id"], "run_id": previous, "at": _now_iso(now), "reason": "rebound"})
   726	    manifest["run_id"] = run_id
   727	    manifest["bound_at"] = _now_iso(now)
   728	    manifest["bind_method"] = method
   729	    if method != "by_tool_use" and manifest.get("script_snapshot_why") == "awaiting_post_tool_use":
   730	        # FN-04: a heuristic or manual bind never snapshots a scriptPath file — say so in the record.
   731	        manifest["script_snapshot_why"] = "not_bound_by_tool_use"
   732	    if persisted_script_path:
   733	        manifest["persisted_script_path"] = persisted_script_path
   734	        # FN-04: the path named in the response is read ONLY on the bind by tool_use_id (the
   735	        # PostToolUse of the call itself) and ONLY to compare it with a snapshot this record
   736	        # already holds. A heuristic or manual bind reads neither it nor the snapshot.
   737	        snap = load_snapshot(d, manifest) if method == "by_tool_use" else None
   738	        persisted = None
   739	        if snap is not None:
   740	            persisted, _why = _read_script_file(Path(persisted_script_path))  # bounded: the path came from response text
   741	        manifest["persisted_matches_snapshot"] = (
   742	            hashlib.sha256(persisted).hexdigest() == hashlib.sha256(snap).hexdigest()
   743	        ) if (snap is not None and persisted is not None) else None
   744	    _atomic_write_json(manifest_path(d, manifest["launch_id"]), manifest)
   745	    _append_index(d, {"kind": "bind", "launch_id": manifest["launch_id"], "run_id": run_id, "bound_at": manifest["bound_at"], "method": method})
   746	    return manifest
