   950	def decide_pre(event: Dict[str, Any], d: Path, env: Optional[Dict[str, str]] = None, now: Optional[float] = None,
   951	               git_budget_s: float = GIT_BUDGET_S) -> Tuple[Dict[str, Any], Dict[str, Any]]:
   952	    """PreToolUse: guard a resume, record the launch (manifest + index line, and the snapshot of
   953	    an INLINE script — never bytes of a ``scriptPath`` file, which runs before the harness's
   954	    permission decision), then enrich the code revision within budget. Returns (decision, manifest).
   955	
   956	    Totality: an exception INSIDE the guard is recorded as ``inconclusive`` (never a silent
   957	    allow without a record); a failure to PERSIST this call's record does not undo a decision
   958	    the guard already computed from valid evidence (breadcrumb in the manifest copy returned)."""
   959	    env = os.environ if env is None else env
   960	    decision: Dict[str, Any] = {}
   961	    try:
   962	        manifest, script_bytes = build_manifest(event, now=now)
   963	    except Exception as exc:  # noqa: BLE001 — the call is still recorded, inconclusive
   964	        manifest, script_bytes = fallback_manifest(event, type(exc).__name__, now=now), None
   965	    resume = manifest.get("resume_from_run_id") if manifest["guard"]["result"] == "none" else None
   966	    if resume:
   967	        try:
   968	            decision = _guard(manifest, resume, d, env)
   969	        except Exception as exc:  # noqa: BLE001 — recorded, never silent
   970	            manifest["guard"] = {"result": "inconclusive", "error": type(exc).__name__, "diff": [], "counts": {}}
   971	            decision = {}
   972	    try:
   973	        write_manifest(manifest, d, script_bytes)          # before anything slow
   974	    except Exception as exc:  # noqa: BLE001
   975	        manifest["write_error"] = type(exc).__name__
