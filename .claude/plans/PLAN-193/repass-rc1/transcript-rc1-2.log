   886	def notice(text: str) -> Dict[str, Any]:
   887	    """An allowed call with something to say: the MODEL reads ``additionalContext`` (so it can
   888	    act on the route), the USER sees ``systemMessage``. Blocks use ``decision``/``reason``."""
   889	    return {"hookSpecificOutput": {"hookEventName": "PreToolUse", "additionalContext": text}, "systemMessage": text}
