   812	def format_block_reason(run_id: str, comparison: Dict[str, Any], launch_id: str) -> str:
   813	    """Counts-only, no operator text. ``run_id`` MUST have passed ``is_run_id``."""
   814	    c = comparison["counts"]
   815	    parts = []
   816	    if c["changed"]:
   817	        parts.append("%d key(s) changed" % c["changed"])
   818	    if c["only_recorded"]:
   819	        parts.append("%d key(s) only in the recorded call" % c["only_recorded"])
   820	    if c["only_now"]:
   821	        parts.append("%d key(s) only in this call" % c["only_now"])
   822	    if c.get("order"):
   823	        parts.append("key order differs")
   824	    if comparison["script"] == "differs":
   825	        parts.append("script hash differs")
   826	    return (
   827	        "WORKFLOW-RESUME-MISMATCH: the recorded launch of %s differs from this call (%s). "
   828	        "Every phase whose prompt depends on what changed gets a new cache key and re-executes. "
   829	        "If this was NOT meant (inputs rebuilt from memory), use the recorded call. "
   830	        "Route in this session: run `ceo-launches.py relaunch %s` (.claude/scripts/ in a framework install, the plugin's scripts/ otherwise) and re-issue EXACTLY that call. "
   831	        "If it IS a deliberate change (for example args.resume or args.reverify to re-run chosen lanes), declare it: "
   832	        "re-issue this call once with a description that starts with 'CEO_WORKFLOW_RESUME_FORCE: <why>' "
   833	        "(or set CEO_WORKFLOW_RESUME_FORCE=1 in the harness process environment); it is recorded with its reason. "
   834	        "Details (which keys) are in manifest %s, never in this message."
   835	        % (run_id, "; ".join(parts) or "see manifest", run_id, launch_id)
   836	    )
   837	
   838	
   839	def _count_parts(comparison: Dict[str, Any]) -> str:
   840	    c = comparison["counts"]
   841	    parts = []
   842	    if c["changed"]:
   843	        parts.append("%d key(s) changed" % c["changed"])
   844	    if c["only_recorded"]:
   845	        parts.append("%d key(s) only in the recorded call" % c["only_recorded"])
   846	    if c["only_now"]:
   847	        parts.append("%d key(s) only in this call" % c["only_now"])
   848	    if c.get("order"):
   849	        parts.append("key order differs")
   850	    if comparison["script"] == "differs":
   851	        parts.append("script hash differs")
   852	    return "; ".join(parts) or "see manifest"
   853	
