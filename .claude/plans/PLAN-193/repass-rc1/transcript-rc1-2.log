   855	def format_mismatch_advisory(run_id: str, comparison: Dict[str, Any], launch_id: str, weak_bind: bool,
   856	                             against: str) -> str:
   857	    """For an args mismatch that is NOT blocked (heuristic bind, or advisory mode). The call
   858	    PROCEEDS, so this never tells the reader to re-issue it (that would launch it twice)."""
   859	    if weak_bind:
   860	        why = ("the recorded launch %s was bound heuristically (no tool_use_id), and a heuristic bind never "
   861	               "sustains a block; `ceo-launches.py bind %s %s` makes future resumes enforceable" % (against, against, run_id))
   862	    else:
   863	        why = "the guard is in advisory mode (CEO_WORKFLOW_RESUME_GUARD=0)"
   864	    return (
   865	        "WORKFLOW-RESUME-ADVISORY: this resume of %s PROCEEDS although its inputs differ from the recorded launch (%s). "
   866	        "It is not blocked because %s. Phases whose prompt depends on the changed inputs will re-execute. "
   867	        "If that is not intended, stop the run; the recorded call is in manifest %s (`ceo-launches.py relaunch %s` prints it). "
   868	        "Do not re-issue this call." % (run_id, _count_parts(comparison), why, launch_id, run_id)
   869	    )
   870	
