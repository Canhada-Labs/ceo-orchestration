   587	def cmd_report(args: argparse.Namespace) -> int:
   588	    d = _dir(args)
   589	    idx = LL.iter_index(d)
   590	    launches = [ln for ln in idx if ln.get("kind") == "launch"]
   591	    guard: Dict[str, int] = {}
   592	    methods: Dict[str, int] = {}
   593	    bound = 0
   594	    for ln in launches:
   595	        m = LL.load_manifest(d, ln["launch_id"]) or {}
   596	        g = (m.get("guard") or {}).get("result", "?")
   597	        guard[g] = guard.get(g, 0) + 1
   598	        if m.get("run_id"):
   599	            bound += 1
   600	            bm = m.get("bind_method") or "?"
   601	            methods[bm] = methods.get(bm, 0) + 1
   602	    orphans = sum(1 for ln in idx if ln.get("kind") == "orphan")
   603	    print("launches=%d bound=%d unbound=%d orphans=%d" % (len(launches), bound, len(launches) - bound, orphans))
   604	    print("guard results: %s" % json.dumps(guard, sort_keys=True))
   605	    print("bind methods:  %s" % json.dumps(methods, sort_keys=True))
   606	    print("ledger: %s" % d)
   607	    return 0
