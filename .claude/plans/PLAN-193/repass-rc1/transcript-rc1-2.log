   610	def main(argv: Optional[List[str]] = None) -> int:
   611	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   612	    ap.add_argument("--project-dir", default=None, help="runtime state dir root to use instead of the resolver (tests / other projects)")
   613	    sub = ap.add_subparsers(dest="cmd", required=True)
   614	    p = sub.add_parser("list"); p.add_argument("--limit", type=int, default=20); p.set_defaults(fn=cmd_list)
   615	    p = sub.add_parser("show"); p.add_argument("ident"); p.set_defaults(fn=cmd_show)
   616	    p = sub.add_parser("relaunch"); p.add_argument("run_id"); p.add_argument("--out", default=None); p.set_defaults(fn=cmd_relaunch)
   617	    p = sub.add_parser("check"); p.add_argument("--run", dest="run_id", required=True)
   618	    p.add_argument("--script-file", default=None); p.add_argument("--script-text", default=None)
   619	    p.add_argument("--args-file", default=None); p.add_argument("--no-args", action="store_true"); p.set_defaults(fn=cmd_check)
   620	    p = sub.add_parser("bind"); p.add_argument("launch_id"); p.add_argument("run_id"); p.set_defaults(fn=cmd_bind)
   621	    p = sub.add_parser("orphans"); p.add_argument("--limit", type=int, default=50); p.set_defaults(fn=cmd_orphans)
   622	    p = sub.add_parser("report"); p.set_defaults(fn=cmd_report)
   623	    args = ap.parse_args(argv)
   624	    return int(args.fn(args))
