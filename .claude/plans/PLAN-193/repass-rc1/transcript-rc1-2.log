   179	def _append_index(d: Path, line: Dict[str, Any]) -> None:
   180	    """Append one index line under the repo's FileLock (a lock failure degrades to an
   181	    unlocked append rather than losing the record). Record boundary repair: when the file
   182	    does not end in a newline (a writer died mid-line), a newline is written first, so the
   183	    torn line stays isolated and THIS record stays parseable."""
   184	    data = (json.dumps(line, ensure_ascii=True, sort_keys=True) + "\n").encode("ascii")
   185	    lock = None
   186	    try:
   187	        from _lib.filelock import FileLock  # noqa: E402
   188	
   189	        lock = FileLock(str(_index_path(d)) + ".lock", timeout=2.0)
   190	        lock.acquire()
   191	    except Exception:
   192	        lock = None
   193	    try:
   194	        with open(_index_path(d), "a+b") as fh:
   195	            fh.seek(0, os.SEEK_END)
   196	            if fh.tell() > 0:
   197	                fh.seek(-1, os.SEEK_END)
   198	                if fh.read(1) != b"\n":
   199	                    data = b"\n" + data
   200	            fh.seek(0, os.SEEK_END)
   201	            fh.write(data)
   202	    finally:
   203	        if lock is not None:
   204	            try:
   205	                lock.release()
   206	            except Exception:
   207	                pass
