        os.rename(tmp, out)
    except OSError as exc:
        shutil.rmtree(tmp, ignore_errors=True)
        raise RePinError(EXIT_INPUT, f"cannot write the pack at {out} "
                                     f"({type(exc).__name__})") from None
    except BaseException:
