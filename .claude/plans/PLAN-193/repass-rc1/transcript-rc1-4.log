  1793	    """Write the pack into a sibling temp dir, then rename it into place.
  1794	
  1795	    A path that exists at either check is refused. Between the last check and
  1796	    the rename, ``rename(2)`` refuses a non-empty directory or a non-directory
  1797	    at ``out``; only an EMPTY directory created in that window would be
  1798	    replaced (nothing is lost). A filesystem error (an unwritable parent, for
  1799	    instance) is an input refusal of ``out``, never a traceback.
  1800	    ``make_parent`` creates a missing parent (ONE level: the plan's
  1801	    ``PLAN-NNN/`` subdirectory) and removes it again if the write fails.
  1802	    """
  1803	    if os.path.lexists(out):
  1804	        raise RePinError(EXIT_INPUT, f"output path already exists: {out}")
  1805	    parent = out.parent
  1806	    made_parent = False
  1807	    if make_parent and not os.path.lexists(parent):
  1808	        try:
  1809	            os.mkdir(parent, 0o755)
  1810	            made_parent = True
  1811	        except OSError as exc:
  1812	            raise RePinError(EXIT_INPUT, f"cannot create {parent} "
  1813	                                         f"({type(exc).__name__})") from None
  1814	    if not parent.is_dir():
  1815	        raise RePinError(EXIT_INPUT, f"output parent is not a directory: {parent}")
  1816	    try:
  1817	        _write_pack(out, parent, files)
  1818	    except BaseException:
  1819	        if made_parent:
  1820	            try:
  1821	                os.rmdir(parent)
  1822	            except OSError:
  1823	                pass
  1824	        raise
