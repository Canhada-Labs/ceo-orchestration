  1827	def _write_pack(out: Path, parent: Path, files: Dict[str, str]) -> None:
  1828	    try:
  1829	        tmp = Path(tempfile.mkdtemp(prefix=".re-pin-codex-", dir=str(parent)))
  1830	    except OSError as exc:
  1831	        raise RePinError(EXIT_INPUT, f"cannot write under {parent} "
  1832	                                     f"({type(exc).__name__})") from None
  1833	    try:
  1834	        for name, content in files.items():
  1835	            with open(tmp / name, "x", encoding="utf-8", newline="\n") as fh:
  1836	                fh.write(content)
  1837	            os.chmod(tmp / name, 0o644)
  1838	        os.chmod(tmp, 0o755)
  1839	        if os.path.lexists(out):
  1840	            raise RePinError(EXIT_INPUT, f"output path appeared meanwhile: {out}")
  1841	        os.rename(tmp, out)
  1842	    except OSError as exc:
  1843	        shutil.rmtree(tmp, ignore_errors=True)
  1844	        raise RePinError(EXIT_INPUT, f"cannot write the pack at {out} "
  1845	                                     f"({type(exc).__name__})") from None
  1846	    except BaseException:
  1847	        shutil.rmtree(tmp, ignore_errors=True)
  1848	        raise
