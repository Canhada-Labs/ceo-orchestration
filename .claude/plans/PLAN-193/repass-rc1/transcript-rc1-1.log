+    _rr_cmd="$_rr_cmd --pin $(printf '%q' "$PIN_REF")"
+  fi
+  if [[ "$DRY_RUN" -eq 1 ]]; then
+    _rr_cmd="$_rr_cmd --dry-run"
+  fi
