+class TestWireContract(_DeltaBase):
+    """§7 tests 5-6 — what reaches (and never reaches) audit_emit."""
+
+    _EXPECTED_KWARGS = {
+        "outcome", "files_count", "modified_count", "index_modified",
+        "anchor_source", "session_id", "project",
