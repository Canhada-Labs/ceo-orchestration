+        except Exception:
+            log_path = None
+        if log_path is None:
+            _env_lp = os.environ.get("CEO_AUDIT_LOG_PATH")
+            _env_ld = os.environ.get("CEO_AUDIT_LOG_DIR")
+            if _env_lp:
+                log_path = Path(_env_lp)
+            elif _env_ld:
