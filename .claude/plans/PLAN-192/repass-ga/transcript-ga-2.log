   471	def iter_index(d: Path) -> List[Dict[str, Any]]:
   472	    """Index lines that are JSON objects with a string ``kind``; anything else (a torn
   473	    line, garbage, a too-deep document) is skipped, never raised."""
   474	    out: List[Dict[str, Any]] = []
   475	    try:
   476	        with open(_index_path(d), encoding="utf-8", errors="replace") as fh:
   477	            for line in fh:
   478	                line = line.strip()
   479	                if not line:
   480	                    continue
   481	                try:
   482	                    obj = json.loads(line)
   483	                except (ValueError, RecursionError):
   484	                    continue
   485	                if isinstance(obj, dict) and isinstance(obj.get("kind"), str):
   486	                    out.append(obj)
   487	    except OSError:
   488	        return out
   489	    return out
