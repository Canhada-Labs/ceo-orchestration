   284	def git_revision(cwd: Optional[str], budget_s: float = GIT_BUDGET_S) -> Dict[str, Any]:
   285	    """``HEAD`` and dirty flag of ``cwd`` inside a wall budget; unknown (``None``)
   286	    on any failure or timeout. ``--no-optional-locks`` keeps the hook from
   287	    taking the index lock under a pipeline's own git activity."""
   288	    if not cwd or not Path(cwd).is_dir():
   289	        return {"head": None, "dirty": None}
   290	    t0 = time.monotonic()
   291	    try:
   292	        head = subprocess.run(["git", "--no-optional-locks", "-c", "core.fsmonitor=false", "-C", cwd, "rev-parse", "HEAD"], capture_output=True, text=True, timeout=budget_s / 2)
