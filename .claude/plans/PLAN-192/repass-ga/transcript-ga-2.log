    58	def _breadcrumb(msg: str) -> None:
    59	    sys.stderr.write("# check_workflow_launch: %s\n" % msg[:200])
    60	
    61	
    62	def gate(event: Dict[str, Any]) -> Dict[str, Any]:
    63	    if os.environ.get("CEO_WORKFLOW_LEDGER", "1") == "0":
    64	        return {}
    65	    if event.get("tool_name") != "Workflow":
    66	        return {}
    67	    try:
    68	        from _lib import launch_ledger  # noqa: E402
    69	    except Exception as exc:  # pragma: no cover — import guard
    70	        _breadcrumb("launch_ledger import failed (%s)" % str(exc)[:100])
    71	        return {}
    72	    try:
    73	        d = launch_ledger.ledger_dir()
    74	    except Exception as exc:
    75	        _breadcrumb("ledger dir unavailable (%s)" % str(exc)[:100])
    76	        return {}
    77	    hook_event = event.get("hook_event_name")
    78	    if not isinstance(hook_event, str) and "tool_response" in event:
    79	        hook_event = "PostToolUse"  # older CLIs may omit the name; a response present means Post
    80	    try:
    81	        if hook_event == "PostToolUse":
    82	            launch_ledger.decide_post(event, d)
    83	            return {}
    84	        decision, manifest = launch_ledger.decide_pre(event, d)
    85	        if manifest.get("write_error"):
    86	            _breadcrumb("ledger write failed (%s); decision kept" % str(manifest["write_error"])[:40])
    87	        guard_error = (manifest.get("guard") or {}).get("error")
    88	        if guard_error:
    89	            _breadcrumb("guard inconclusive after %s (recorded)" % str(guard_error)[:60])
    90	        return decision
    91	    except Exception as exc:
    92	        _breadcrumb("ledger write/guard failed (%s)" % str(exc)[:100])
    93	        return {}
