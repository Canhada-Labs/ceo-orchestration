   267	        data = script.encode("utf-8", "surrogatepass")
   268	        return {"source": "inline", "path": None, "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}, data
   269	    sp = tool_input.get("scriptPath")
   270	    if isinstance(sp, str) and sp:
