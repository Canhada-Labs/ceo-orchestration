   159	def _append_index(d: Path, line: Dict[str, Any]) -> None:
   160	    """Append one index line under the repo's FileLock (a lock failure degrades to an
   161	    unlocked append rather than losing the record). Record boundary repair: when the file
   162	    does not end in a newline (a writer died mid-line), a newline is written first, so the
   163	    torn line stays isolated and THIS record stays parseable."""
   164	    data = (json.dumps(line, ensure_ascii=True, sort_keys=True) + "\n").encode("ascii")
   165	    lock = None
   166	    try:
   167	        from _lib.filelock import FileLock  # noqa: E402
   168	
   169	        lock = FileLock(str(_index_path(d)) + ".lock", timeout=2.0)
   170	        lock.acquire()
   171	    except Exception:
   172	        lock = None
   173	    try:
   174	        with open(_index_path(d), "a+b") as fh:
   175	            fh.seek(0, os.SEEK_END)
   176	            if fh.tell() > 0:
   177	                fh.seek(-1, os.SEEK_END)
   178	                if fh.read(1) != b"\n":
   179	                    data = b"\n" + data
   180	            fh.seek(0, os.SEEK_END)
   181	            fh.write(data)
   182	    finally:
   183	        if lock is not None:
   184	            try:
   185	                lock.release()
   186	            except Exception:
   187	                pass
