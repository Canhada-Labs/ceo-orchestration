   645	def _args_key_diff(recorded_canon: str, now_canon: str) -> List[Dict[str, Any]]:
   646	    """Top-level keys whose canonical values differ (or exist on one side only).
   647	    Non-object args are compared as whole values. Values never appear — short hashes do."""
   648	    diffs: List[Dict[str, Any]] = []
