   549	def force_declaration(description: Any) -> Optional[str]:
   550	    """The override a CALL declares for itself: ``description`` that starts with the exact
   551	    ``FORCE_MARKER`` followed by a non-empty reason. Returns the reason (capped) or ``None``.
   552	    Pure string inspection of the call being decided — nothing is stored, nothing is read
   553	    back, nothing can be spent twice."""
