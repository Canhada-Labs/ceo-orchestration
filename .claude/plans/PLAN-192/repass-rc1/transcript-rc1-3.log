   140	def _atomic_write(path: Path, data: bytes) -> None:
   141	    fd, tmp = tempfile.mkstemp(prefix=".tmp-", dir=str(path.parent))
   142	    try:
   143	        with os.fdopen(fd, "wb") as fh:
   144	            fh.write(data)
   145	        os.chmod(tmp, 0o600)
   146	        os.replace(tmp, str(path))
   147	    except Exception:
   148	        try:
   149	            os.unlink(tmp)
   150	        except OSError:
   151	            pass
   152	        raise
