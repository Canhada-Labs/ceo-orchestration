   492	def find_launch_for_run(d: Path, run_id: str) -> Optional[Dict[str, Any]]:
   493	    """The manifest CURRENTLY bound to ``run_id``: the most recent binding of that run that
   494	    was not later unbound. Explicit unbinds (a rebind to another run) pop it, so the lookup
   495	    returns to the previous surviving binding. The top binding's record must still carry
   496	    ``run_id``; if it is unreadable or does not, the answer is ``None`` — an OLDER launch is
   497	    never substituted for an unreadable newer one (its inputs may be stale)."""
