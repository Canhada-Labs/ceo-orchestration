   526	def unbound_launches(d: Path, session_id: Optional[str]) -> List[str]:
   527	    """Launch ids of the session that never got a bind line (a later unbind reopens them).
   528	    Never candidates: a launch the guard BLOCKED (it never ran — history only), and a second
   529	    record of a ``tool_use_id`` another launch is already bound to (the same call recorded
   530	    twice, e.g. the hook registered by a plugin AND by the project)."""
   531	    bound: Dict[str, bool] = {}
   532	    launches: List[Tuple[str, Optional[str]]] = []
   533	    for line in iter_index(d):
   534	        kind = line.get("kind")
   535	        if kind == "launch" and (session_id is None or line.get("session_id") == session_id):
   536	            lid = line.get("launch_id")
   537	            if line.get("blocked") is True or not isinstance(lid, str) or LAUNCH_ID_RE.fullmatch(lid) is None:
   538	                continue
   539	            tuid = line.get("tool_use_id") if isinstance(line.get("tool_use_id"), str) and line.get("tool_use_id") else None
   540	            launches.append((lid, tuid))
   541	        elif kind == "bind":
   542	            bound[line.get("launch_id", "")] = True
   543	        elif kind == "unbind":
   544	            bound[line.get("launch_id", "")] = False
   545	    bound_tuids = {tuid for lid, tuid in launches if tuid and bound.get(lid)}
   546	    return [lid for lid, tuid in launches if not bound.get(lid) and not (tuid and tuid in bound_tuids)]
