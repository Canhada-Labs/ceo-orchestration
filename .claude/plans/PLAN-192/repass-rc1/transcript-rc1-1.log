   463	def load_snapshot(d: Path, manifest: Dict[str, Any]) -> Optional[bytes]:
   464	    name = manifest.get("script_snapshot")
   465	    if not isinstance(name, str) or not name or "/" in name or name.startswith("."):
   466	        return None
   467	    data, _why = _read_script_file(d / name)
   468	    return data
