   305	def extract_run_id(tool_response: Any) -> Optional[str]:
   306	    """The run id the harness launched: a ``runId``/``run_id`` key; else the id on the
   307	    ``Run ID:`` label (the harness prints it on launch AND on resume, where the id is the
   308	    same); else the only distinct ``wf_<hex8>[-<hex>]`` token in the response. Two different
   309	    labelled ids, or two different unlabelled ids, are ambiguous ⇒ ``None`` — never the first
   310	    one found. With ``None``, ``decide_post`` records NOTHING: the launch stays unbound (visible in
   311	    ``ceo-launches.py list``) and ``bind`` closes it by hand."""
   312	    if tool_response is None:
   313	        return None
   314	    if isinstance(tool_response, dict):
   315	        for key in ("runId", "run_id"):
   316	            v = tool_response.get(key)
   317	            if is_run_id(v):
   318	                return v
   319	    try:
   320	        text = tool_response if isinstance(tool_response, str) else json.dumps(tool_response, ensure_ascii=True)
   321	    except (RecursionError, ValueError, TypeError):
   322	        return None
   323	    labelled = set(_RUN_ID_LABEL_RE.findall(text))
   324	    if len(labelled) == 1:
   325	        return labelled.pop()
   326	    if len(labelled) > 1:
   327	        return None
   328	    ids = set(RUN_ID_RE.findall(text))
   329	    return ids.pop() if len(ids) == 1 else None
   330	
