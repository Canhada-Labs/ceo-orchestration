   439	def enrich_code_revision(manifest: Dict[str, Any], d: Path, budget_s: float = GIT_BUDGET_S) -> Dict[str, Any]:
   440	    """Second, optional write: code revision inside a strict budget."""
   441	    rev = git_revision(manifest.get("cwd"), budget_s=budget_s)
   442	    manifest = dict(manifest)
   443	    manifest["code"] = {"head": rev.get("head"), "dirty": rev.get("dirty"), "status": "known" if rev.get("head") else "unknown"}
   444	    try:
   445	        _atomic_write_json(manifest_path(d, manifest["launch_id"]), manifest)
   446	    except OSError:
   447	        pass
   448	    return manifest
