   451	def load_manifest(d: Path, launch_id: Any) -> Optional[Dict[str, Any]]:
   452	    """A manifest by id. Ids read back from the index are validated by shape first (no
   453	    path escapes); unreadable/undecodable/too-deep/non-object content ⇒ ``None``."""
   454	    if not isinstance(launch_id, str) or LAUNCH_ID_RE.fullmatch(launch_id) is None:
   455	        return None
   456	    try:
   457	        data = json.loads(manifest_path(d, launch_id).read_text(encoding="utf-8"))
   458	    except (OSError, ValueError, RecursionError):
   459	        return None
   460	    return data if isinstance(data, dict) else None
