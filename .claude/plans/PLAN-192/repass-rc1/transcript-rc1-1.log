   260	
   261	def script_record(tool_input: Dict[str, Any], cwd: Optional[str]) -> Tuple[Dict[str, Any], Optional[bytes]]:
   262	    """Fingerprint of the script plus the effective bytes to snapshot. Inline
   263	    ``script`` text wins over ``scriptPath``; an unreadable ``scriptPath`` is
   264	    recorded (no hash, no snapshot) — the guard then reports INCONCLUSIVE."""
   265	    script = tool_input.get("script")
   266	    if isinstance(script, str) and script:
   267	        data = script.encode("utf-8", "surrogatepass")
   268	        return {"source": "inline", "path": None, "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}, data
   269	    sp = tool_input.get("scriptPath")
   270	    if isinstance(sp, str) and sp:
   271	        p = Path(sp)
   272	        if not p.is_absolute() and cwd:
   273	            p = Path(cwd) / p
   274	        data, why = _read_script_file(p)
   275	        if data is None:
   276	            return {"source": "path", "path": sp, "sha256": None, "bytes": None, "unreadable": True, "why": why}, None
   277	        return {"source": "path", "path": sp, "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}, data
   278	    name = tool_input.get("name")
   279	    if isinstance(name, str) and name:
   280	        return {"source": "named", "path": None, "name": name, "sha256": None, "bytes": None}, None
   281	    return {"source": "absent", "path": None, "sha256": None, "bytes": None}, None
   282	
