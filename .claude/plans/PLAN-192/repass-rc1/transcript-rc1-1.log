   621	def bind_run(d: Path, manifest: Dict[str, Any], run_id: str, method: str, now: Optional[float] = None,
   622	             persisted_script_path: Optional[str] = None) -> Dict[str, Any]:
   623	    if not is_run_id(run_id):
   624	        raise ValueError("run id has an unexpected shape")
   625	    manifest = dict(manifest)
   626	    previous = manifest.get("run_id")
   627	    if isinstance(previous, str) and previous and previous != run_id:
   628	        _append_index(d, {"kind": "unbind", "launch_id": manifest["launch_id"], "run_id": previous, "at": _now_iso(now), "reason": "rebound"})
   629	    manifest["run_id"] = run_id
   630	    manifest["bound_at"] = _now_iso(now)
   631	    manifest["bind_method"] = method
   632	    if persisted_script_path:
   633	        manifest["persisted_script_path"] = persisted_script_path
   634	        snap = load_snapshot(d, manifest)
   635	        persisted, _why = _read_script_file(Path(persisted_script_path))  # bounded: the path came from response text
   636	        manifest["persisted_matches_snapshot"] = (
   637	            hashlib.sha256(persisted).hexdigest() == hashlib.sha256(snap).hexdigest()
   638	        ) if (snap is not None and persisted is not None) else None
   639	    _atomic_write_json(manifest_path(d, manifest["launch_id"]), manifest)
   640	    _append_index(d, {"kind": "bind", "launch_id": manifest["launch_id"], "run_id": run_id, "bound_at": manifest["bound_at"], "method": method})
