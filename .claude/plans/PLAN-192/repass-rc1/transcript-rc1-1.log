   560	def manifest_problem(m: Any, d: Path) -> Optional[str]:
   561	    """The ONE validation of a manifest read back before it is used as evidence. ``None``
   562	    when every field the guard and ``relaunch`` rely on is present and self-consistent;
   563	    otherwise a short problem code.
   564	
   565	    Checks: object; schema; launch id / run id shapes; bind method in the known set.
   566	    ``args``: keys present; ``canonical`` ``None`` only for a recorded serialisation error
   567	    (``args_uncanonicalized``); otherwise canonical and literal are strings whose sha256 match
   568	    their recorded hashes, the literal re-canonicalises to the canonical, and ``present`` is
   569	    False exactly when both are ABSENT. ``script``: the ``sha256`` key must exist and agree with
   570	    the SOURCE — inline, or a path read at launch ⇒ a hex hash whose snapshot bytes exist and
   571	    hash to it; a path unreadable at launch, a named workflow or no script ⇒ ``null``."""
   572	    if not isinstance(m, dict):
   573	        return "not_an_object"
   574	    if m.get("schema") != SCHEMA:
   575	        return "schema"
   576	    if not isinstance(m.get("launch_id"), str) or LAUNCH_ID_RE.fullmatch(m["launch_id"]) is None:
   577	        return "launch_id"
   578	    if not is_run_id(m.get("run_id")):
   579	        return "run_id"
   580	    if m.get("bind_method") not in BIND_METHODS:
   581	        return "bind_method"
   582	    a = m.get("args")
   583	    if not isinstance(a, dict) or not isinstance(a.get("present"), bool) or not {"canonical", "literal", "sha256", "literal_sha256"} <= set(a):
   584	        return "args_shape"
   585	    if a["canonical"] is None:
   586	        return "args_uncanonicalized" if isinstance(a.get("error"), str) else "args_shape"
   587	    for text_key, hash_key in (("canonical", "sha256"), ("literal", "literal_sha256")):
   588	        if not isinstance(a[text_key], str) or not isinstance(a[hash_key], str) or SHA256_RE.fullmatch(a[hash_key]) is None:
   589	            return "args_shape"
   590	        if sha256_text(a[text_key]) != a[hash_key]:
   591	            return "args_inconsistent"
   592	    if (a["present"] is False) != (a["canonical"] == ABSENT) or (a["canonical"] == ABSENT) != (a["literal"] == ABSENT):
   593	        return "args_inconsistent"
   594	    if a["canonical"] != ABSENT:
   595	        try:
   596	            if canonical_json(json.loads(a["literal"])) != a["canonical"]:
   597	                return "args_inconsistent"
   598	        except (ValueError, RecursionError, TypeError):
   599	            return "args_inconsistent"
   600	    sc = m.get("script")
   601	    if not isinstance(sc, dict) or "sha256" not in sc:
   602	        return "script_shape"
   603	    source = sc.get("source")
   604	    sh = sc["sha256"]
   605	    if source == "inline" or (source == "path" and sc.get("unreadable") is not True):
   606	        if not isinstance(sh, str) or SHA256_RE.fullmatch(sh) is None:
   607	            return "script_shape"
   608	        if m.get("script_snapshot") != snapshot_path(d, m["launch_id"]).name:
   609	            return "script_snapshot_missing"
   610	        snap = load_snapshot(d, m)
   611	        if snap is None:
   612	            return "script_snapshot_missing"
   613	        if hashlib.sha256(snap).hexdigest() != sh:
   614	            return "script_snapshot_mismatch"
   615	        return None
   616	    if source in ("path", "named", "absent"):
   617	        return None if sh is None else "script_shape"
   618	    return "script_shape"
   619	
