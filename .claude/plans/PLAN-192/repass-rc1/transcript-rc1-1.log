   417	def write_manifest(manifest: Dict[str, Any], d: Path, script_bytes: Optional[bytes] = None) -> Path:
   418	    """Manifest (and script snapshot) on disk FIRST; the index line after."""
   419	    if script_bytes is not None:
   420	        _atomic_write(snapshot_path(d, manifest["launch_id"]), script_bytes)
   421	        manifest["script_snapshot"] = snapshot_path(d, manifest["launch_id"]).name
   422	    path = manifest_path(d, manifest["launch_id"])
   423	    _atomic_write_json(path, manifest)
   424	    _append_index(d, {
   425	        "kind": "launch",
   426	        "launch_id": manifest["launch_id"],
   427	        "recorded_at": manifest["recorded_at"],
   428	        "session_id": manifest.get("session_id"),
   429	        "tool_use_id": manifest.get("tool_use_id"),
   430	        "resume_from_run_id": manifest.get("resume_from_run_id"),
   431	        "script_sha256": (manifest.get("script") or {}).get("sha256"),
   432	        "args_sha256": (manifest.get("args") or {}).get("sha256"),
   433	        "guard": (manifest.get("guard") or {}).get("result"),
   434	        "blocked": (manifest.get("guard") or {}).get("result") in BLOCKING_RESULTS,
   435	    })
   436	    return path
