   191	def canonical_json(value: Any) -> str:
   192	    # ASCII-escaped: total over every str Python can hold (a lone surrogate included), so hashing
   193	    # and writing a record can never raise on operator input.
   194	    return json.dumps(value, ensure_ascii=True, sort_keys=True, separators=(",", ":"))
   195	
   196	
   197	def sha256_text(text: str) -> str:
   198	    return hashlib.sha256(text.encode("utf-8", "surrogatepass")).hexdigest()
   199	
   200	
   201	def is_run_id(value: Any) -> bool:
   202	    return isinstance(value, str) and RUN_ID_RE.fullmatch(value) is not None
   203	
   204	
   205	def args_record(tool_input: Dict[str, Any]) -> Dict[str, Any]:
   206	    """Record of ``args``: ABSENT when the key is missing, else two serialisations of what was
   207	    passed — ``literal`` in the ORIGINAL key order (the runner's script sees that order, so
   208	    ``relaunch`` reproduces it) and ``canonical`` with sorted keys (per-key comparison).
   209	    ``null`` stays ``null``; nothing is truncated. Total: a value that cannot be serialised
   210	    (a document nested past the interpreter's recursion limit) yields a record with
   211	    ``canonical``/``literal`` ``None`` and the error type — the guard is then inconclusive."""
   212	    if "args" not in tool_input:
   213	        return {"present": False, "canonical": ABSENT, "literal": ABSENT, "sha256": sha256_text(ABSENT),
   214	                "literal_sha256": sha256_text(ABSENT), "bytes": 0}
   215	    value = tool_input.get("args")
   216	    try:
   217	        canon = canonical_json(value)
   218	        literal = json.dumps(value, ensure_ascii=True, separators=(",", ":"))
   219	    except (RecursionError, ValueError, TypeError) as exc:
   220	        return {"present": True, "canonical": None, "literal": None, "sha256": None, "literal_sha256": None,
   221	                "bytes": None, "error": type(exc).__name__}
   222	    return {"present": True, "canonical": canon, "literal": literal, "sha256": sha256_text(canon),
   223	            "literal_sha256": sha256_text(literal), "bytes": len(literal)}
   224	
   225	
   226	def _read_script_file(p: Path) -> Tuple[Optional[bytes], Optional[str]]:
   227	    """Bytes of a REGULAR file of at most ``SCRIPT_MAX_BYTES``, or ``(None, why)``. Opened
   228	    non-blocking and type-checked on the open descriptor, so a FIFO or device path never
   229	    stalls the hook and cannot be swapped in between the check and the read; a path with a
   230	    NUL byte (``ValueError``) is unreadable, not an exception."""
   231	    try:
   232	        fd = os.open(str(p), os.O_RDONLY | getattr(os, "O_NONBLOCK", 0))
   233	    except (OSError, ValueError):
   234	        return None, "open_failed"
   235	    try:
   236	        st = os.fstat(fd)
   237	        if not stat.S_ISREG(st.st_mode):
   238	            return None, "not_a_regular_file"
   239	        if st.st_size > SCRIPT_MAX_BYTES:
   240	            return None, "too_large"
   241	        chunks = []
   242	        total = 0
   243	        while True:
   244	            chunk = os.read(fd, 1024 * 1024)
   245	            if not chunk:
   246	                break
   247	            total += len(chunk)
   248	            if total > SCRIPT_MAX_BYTES:
   249	                return None, "too_large"
   250	            chunks.append(chunk)
   251	        return b"".join(chunks), None
   252	    except OSError:
   253	        return None, "read_failed"
   254	    finally:
   255	        os.close(fd)
   256	
   257	
   258	read_script_file = _read_script_file  # public name for the CLI
