+      [ "$RC" -eq 0 ] \
+        && ok "R12 selection $branch $mode — inactive GitHub routes do not refuse the upgrade" \
+        || bad "R12 selection $branch $mode — rc=$RC, expected 0"
+      if [ -f "$TARGET/.github" ] && [ "$( cat "$TARGET/.github" )" = 'adopter-owned GitHub placeholder' ]; then
