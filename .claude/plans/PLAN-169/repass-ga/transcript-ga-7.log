   395	def main(argv: Optional[List[str]] = None) -> int:
   396	    """CLI entrypoint — dispatch scratchpad sub-commands (read/write/list/clear/delete)."""
   397	    parser = build_parser()
   398	    args = parser.parse_args(argv)
   399	
   400	    # S4 kill switch — bypass sqlite entirely.
   401	    if _sota_disabled():
   402	        _emit(
   403	            {"kind": "disabled", "reason": "CEO_SOTA_DISABLE=1"},
   404	            as_json=getattr(args, "json", False),
   405	        )
   406	        return EXIT_OK
   407	
   408	    if args.cmd is None:
   409	        parser.print_help(sys.stderr)
   410	        return EXIT_USAGE
   411	
   412	    dispatch = {
   413	        "set": cmd_set,
   414	        "get": cmd_get,
   415	        "list": cmd_list,
   416	        "delete": cmd_delete,
   417	        "clear": cmd_clear,
   418	    }
   419	    handler = dispatch.get(args.cmd)
   420	    if handler is None:  # pragma: no cover — argparse enforces
   421	        parser.print_help(sys.stderr)
   422	        return EXIT_USAGE
   423	    return handler(args)
   424	
   425	
   426	if __name__ == "__main__":
   427	    sys.exit(main())

