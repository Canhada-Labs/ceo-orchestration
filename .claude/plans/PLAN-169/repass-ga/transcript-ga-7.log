     1	"""PLAN-179 rail round-7 [P1] — GC expires a session store as a UNIT.
     2	
     3	The class this file closes: `gc_orphan_session_stores` used to shard by FILE
     4	name and expire per file, so the four components of one store (`.sqlite`,
     5	`.sqlite.lock`, `-wal`, `-shm`) landed in DIFFERENT sweeps and an ACTIVE
     6	store (fresh WAL, stale db mtime) could lose a sidecar. The cure shards by
     7	SCOPE (stem), decides expiry from the newest DATA mtime, and both decides
     8	and unlinks under the store's own FileLock — a busy lock means an active
     9	writer and skips the store.
    10	
    11	Coverage mechanics (rail round-10 [P2]): scopes are processed in
    12	lexicographic order ROTATED past a persisted resume cursor, so a
    13	deadline/cap break never starves the same tail twice. Small directories
    14	are fully decided in a single sweep.
    15	"""
    16	
    17	from __future__ import annotations
    18	
    19	import importlib.util
    20	import os
    21	import subprocess
    22	import sys
    23	import time
    24	import unittest
    25	from pathlib import Path
    26	from unittest import mock
    27	
    28	# --- Locate repo root + the staged/live module, CANONICAL-FIRST. ---
    29	_THIS = Path(__file__).resolve()
    30	_repo_root = None
    31	for parent in _THIS.parents:
    32	    if (parent / ".claude" / "hooks" / "_lib").is_dir() and (
    33	        parent / ".claude" / "plans"
    34	    ).is_dir():
    35	        _repo_root = parent
    36	        break
    37	assert _repo_root is not None, "could not locate repo root from test path"
    38	_LIVE_HOOKS = _repo_root / ".claude" / "hooks"
    39	_CANONICAL_SP = _LIVE_HOOKS / "_lib" / "scratchpad_lib.py"
    40	_STAGED_SP = (
    41	    _repo_root / ".claude" / "plans" / "PLAN-179" / "staged-w01"
    42	    / ".claude" / "hooks" / "_lib" / "scratchpad_lib.py"
    43	)
    44	# Marker unique to the round-7 cure: pre-ceremony only the staged copy has
    45	# it; post-ceremony the canonical copy carries it and the pack is gone.
    46	_SP_MARKER = "_SESSION_STORE_DATA_SUFFIXES"
    47	
    48	
    49	def _pick(canonical: Path, staged: Path, marker: str) -> Path:
    50	    try:
    51	        if canonical.is_file() and marker in canonical.read_text(encoding="utf-8"):
    52	            return canonical
    53	    except OSError:
    54	        pass
    55	    if staged.is_file() and marker in staged.read_text(encoding="utf-8"):
    56	        return staged
    57	    raise FileNotFoundError(
    58	        "scratchpad_lib with the round-7 GC not found in canonical (%s) or "
    59	        "staged (%s); marker=%r" % (canonical, staged, marker)
    60	    )
    61	
    62	
    63	_SP_PATH = _pick(_CANONICAL_SP, _STAGED_SP, _SP_MARKER)
    64	
    65	if str(_LIVE_HOOKS) not in sys.path:
    66	    sys.path.insert(0, str(_LIVE_HOOKS))  # canonical _lib package
    67	
    68	from _lib.testing import TestEnvContext  # noqa: E402
    69	
    70	
    71	def _load_sp():
    72	    """Load the module under test under a NON-canonical name, transiently
    73	    bound (tests/conftest.py collection-finish guard: no pollution)."""
    74	    spec = importlib.util.spec_from_file_location(
    75	        "_plan179_gc_sp_under_test", str(_SP_PATH)
    76	    )
    77	    mod = importlib.util.module_from_spec(spec)
    78	    sys.modules[spec.name] = mod
    79	    try:
    80	        spec.loader.exec_module(mod)
    81	    finally:
    82	        sys.modules.pop(spec.name, None)
    83	    return mod
    84	
    85	
    86	_sp = _load_sp()
    87	
    88	_SCOPE = "session-" + "ab12" * 8          # matches _SESSION_SCOPE_ID_RE
    89	_TTL = 72 * 3600
    90	
    91	
    92	class GcStoreUnitBase(TestEnvContext):
    93	    def setUp(self):
    94	        super().setUp()
    95	        self.state_root = Path(self.project_dir) / "state"
    96	        self.store_dir = self.state_root / _sp.SESSION_SCRATCHPAD_STORE_NAME
    97	        self.store_dir.mkdir(parents=True)
    98	        self.now = time.time()
    99	        self.old = self.now - _TTL - 3600
   100	        self.fresh = self.now - 60
   101	
   102	    def _mk(self, scope, **mtimes):
   103	        """Create store files; kwargs: db/lock/wal/shm = mtime or None."""
   104	        names = {
   105	            "db": scope + ".sqlite",
   106	            "lock": scope + ".sqlite.lock",
   107	            "wal": scope + ".sqlite-wal",
   108	            "shm": scope + ".sqlite-shm",
   109	        }
   110	        paths = {}
   111	        for key, mtime in mtimes.items():
   112	            if mtime is None:
   113	                continue
   114	            p = self.store_dir / names[key]
   115	            p.write_bytes(b"x")
   116	            os.utime(str(p), (mtime, mtime))
   117	            paths[key] = p
   118	        return paths
   119	
   120	    def _sweep(self, **kw):
   121	        """One sweep; returns removals."""
   122	        kw.setdefault("ttl_seconds", _TTL)
   123	        kw.setdefault("now", self.now)
   124	        env = {"CEO_STATE_ROOT": str(self.state_root)}
   125	        with mock.patch.dict(os.environ, env, clear=False):
   126	            return _sp.gc_orphan_session_stores(**kw)
   127	
   128	    def _sweep_all(self, **kw):
   129	        """Two sweeps (a full cursor wrap for small dirs); total removals."""
   130	        return self._sweep(**kw) + self._sweep(**kw)
   131	
   132	
   133	class TestExpiredStoreCollectedAsUnit(GcStoreUnitBase):
   134	    def test_expired_store_data_collected_lock_preserved(self):
   135	        """Rail round-9 [P2]: the DATA components go; the `.sqlite.lock`
   136	        is NEVER unlinked — deleting a lock inode under a blocked waiter
   137	        creates dual critical sections."""
   138	        paths = self._mk(_SCOPE, db=self.old, lock=self.old,
   139	                         wal=self.old, shm=self.old)
   140	        removed = self._sweep_all()
   141	        self.assertEqual(removed, 3)
   142	        for key in ("db", "wal", "shm"):
   143	            self.assertFalse(paths[key].exists(),
   144	                             "%s survived the sweep" % paths[key].name)
   145	        self.assertTrue(paths["lock"].exists(),
   146	                        "the lock file must NEVER be unlinked")
   147	
   148	    def test_all_components_fall_in_the_same_sweep(self):
   149	        """THE round-7 regression control: the components of one store are
   150	        decided together — a single sweep collects all three data files."""
   151	        self._mk(_SCOPE, db=self.old, lock=self.old,
   152	                 wal=self.old, shm=self.old)
   153	        self.assertEqual(self._sweep(), 3)
   154	
   155	    def test_cursor_resumes_past_the_previous_prefix(self):
   156	        """Rail round-10 [P2] regression: with the cursor pointing at scope
   157	        A, the next sweep must start at the scope AFTER it (B) — a break
   158	        that always restarts from the top starved the tail forever."""
   159	        scope_a = "session-" + "aa11" * 8
   160	        scope_b = "session-" + "ff99" * 8
   161	        self._mk(scope_a, db=self.old, wal=self.old, shm=self.old)
   162	        b = self._mk(scope_b, db=self.old, wal=self.old, shm=self.old)
   163	        (self.store_dir / _sp._GC_CURSOR_NAME).write_text(
   164	            scope_a, encoding="utf-8"
   165	        )
   166	        # Budget for exactly ONE store: the one past the cursor goes first.
   167	        self.assertEqual(self._sweep(max_files=3), 3)
   168	        for p in b.values():
   169	            self.assertFalse(
   170	                p.exists(),
   171	                "the scope PAST the cursor was not processed first",
   172	            )
   173	        self.assertTrue((self.store_dir / (scope_a + ".sqlite")).exists())
   174	
   175	    def test_orphan_lock_alone_is_left_alone(self):
   176	        """Round-9 declared residual: a lock-only scope is not collectable
   177	        (no data), and the lock inode must stay stable for any waiter."""
   178	        paths = self._mk(_SCOPE, lock=self.old)
   179	        self.assertEqual(self._sweep_all(), 0)
   180	        self.assertTrue(paths["lock"].exists())
