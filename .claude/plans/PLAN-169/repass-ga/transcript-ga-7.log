   183	class TestActiveStoreIsUntouched(GcStoreUnitBase):
   184	    def test_fresh_wal_protects_stale_siblings(self):
   185	        """THE positive control for the finding: stale db + fresh WAL is an
   186	        ACTIVE store (WAL activity leaves the main db mtime stale) — no
   187	        component may be removed."""
   188	        paths = self._mk(_SCOPE, db=self.old, lock=self.old,
   189	                         wal=self.fresh, shm=self.old)
   190	        self.assertEqual(self._sweep_all(), 0)
   191	        for p in paths.values():
   192	            self.assertTrue(p.exists(), "%s was removed from an ACTIVE store"
   193	                            % p.name)
   194	
   195	    def test_fully_fresh_store_untouched(self):
   196	        paths = self._mk(_SCOPE, db=self.fresh, lock=self.fresh,
   197	                         wal=self.fresh, shm=self.fresh)
   198	        self.assertEqual(self._sweep_all(), 0)
   199	        for p in paths.values():
   200	            self.assertTrue(p.exists())
   201	
   202	    def test_held_lock_skips_the_store(self):
   203	        """A writer holding the store's flock means ACTIVE regardless of
   204	        mtimes — the GC must skip, never dispute."""
   205	        paths = self._mk(_SCOPE, db=self.old, lock=self.old,
   206	                         wal=self.old, shm=self.old)
   207	        marker = Path(self.project_dir) / "holder-ready"
   208	        holder = (
   209	            "import fcntl, os, sys, time\n"
   210	            "fd = os.open(sys.argv[1], os.O_CREAT | os.O_WRONLY, 0o600)\n"
   211	            "fcntl.flock(fd, fcntl.LOCK_EX)\n"
   212	            "open(sys.argv[2], 'w').write('locked')\n"
   213	            "time.sleep(30)\n"
   214	        )
   215	        child = subprocess.Popen(
   216	            [sys.executable, "-c", holder,
   217	             str(paths["lock"]), str(marker)],
   218	        )
   219	        try:
   220	            deadline = time.time() + 10
   221	            while not marker.is_file():
   222	                if time.time() >= deadline:
   223	                    self.fail("lock-holder child never signalled readiness")
   224	                if child.poll() is not None:
   225	                    self.fail("lock-holder child exited early")
   226	                time.sleep(0.05)
   227	            self.assertEqual(self._sweep_all(), 0)
   228	            for p in paths.values():
   229	                self.assertTrue(
   230	                    p.exists(),
   231	                    "%s was removed while the store lock was HELD" % p.name,
   232	                )
   233	        finally:
   234	            child.kill()
   235	            child.wait()
