   163	            as_json=args.json,
   164	        )
   165	        return EXIT_USAGE
   166	
   167	    try:
   168	        with open_store("scratchpad", plan_id) as store:
   169	            store.set(args.key, args.value, ttl_seconds=ttl)
   170	            nbytes = len(
   171	                args.value.encode("utf-8", errors="replace")
   172	                if isinstance(args.value, str)
   173	                else args.value
   174	            )
   175	    except StateStoreValueTooLarge as e:
   176	        _emit({"kind": "error", "message": str(e)}, as_json=args.json)
   177	        return EXIT_TOO_LARGE
   178	    except StateStoreInvalidName as e:
   179	        _emit({"kind": "error", "message": str(e)}, as_json=args.json)
   180	        return EXIT_USAGE
   181	
   182	    _emit(
   183	        {
   184	            "kind": "set",
   185	            "plan_id": plan_id,
   186	            "key": args.key,
   187	            "bytes": nbytes,
   188	            "ttl_seconds": ttl,
   189	        },
   190	        as_json=args.json,
   191	    )
   192	    return EXIT_OK
