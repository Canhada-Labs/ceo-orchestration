   162	            BAD=0
   163	            while IFS= read -r v; do
   164	              [[ -z "$v" ]] && continue
   165	              if [[ "$v" != "$FILE" ]]; then
   166	                echo "::error::.claude-plugin/marketplace.json carries version '$v' != VERSION ('$FILE')"
   167	                BAD=1
   168	              fi
   169	            done < <(jq -r '.. | objects | .version? // empty' .claude-plugin/marketplace.json)
   170	            if [[ "$BAD" -ne 0 ]]; then
   171	              exit 1
   172	            fi
   173	            echo "OK: every marketplace.json version field matches VERSION"
   174	          else
   175	            echo "::notice::.claude-plugin/marketplace.json not present — skipping"
   176	          fi
   177	
   178	      # -----------------------------------------------------------------
   179	      # F5 — RC-hold / staleness waiver SUNSET assertion.
   180	      #
   181	      # The pre-GA waivers in .claude/governance/governance-waivers.yaml
   182	      # are honest ONLY while the project is pre-GA (adopter_count=0).
   183	      # Every existing rc_hold/workflow_staleness entry is a 1.x version
   184	      # carrying "Pre-GA ... adopter_count=0". To stop that 100%-waiver
   185	      # escape from silently following the project into GA, this step
   186	      # FAILS the release the moment any waiver `version` parses >= the
   187	      # configured FIRST_GA floor. The floor is the first version at which
   188	      # the framework intends to claim GA / publish to adopters; per
   189	      # ADR-073 the next major (v2.0.0) is the documented GA/breaking
   190	      # boundary, so 2.0.0 is the mechanical sunset. After the first real
   191	      # adopter ships, lower FIRST_GA (or empty the waiver lists) so the
   192	      # ADR-007 RC-hold + 14-day staleness gates resume real enforcement.
   193	      #
   194	      # Today (max waiver 1.0.0 < 2.0.0) this passes; it is a tripwire,
   195	      # not a behavior change for the current pre-GA train.
   196	      #
   197	      # `-rc.N` pre-release suffixes are stripped before comparison: RC
   198	      # tags forensically short-circuit the hold gate (see below), so an
   199	      # rc.* waiver is never an enforcement bypass on its own.
   200	      # -----------------------------------------------------------------
   201	      - name: Assert no waiver has reached the GA sunset floor
   202	        env:
   203	          # First version at which pre-GA waivers are no longer honest.
   204	          # Bump DOWN (or empty the waiver lists) once an adopter ships.
   205	          FIRST_GA: "2.0.0"
   206	        run: |
   207	          set -euo pipefail
   208	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   209	          if [[ ! -f "$WAIVER_FILE" ]]; then
   210	            echo "OK: no waiver file present — nothing to sunset"
   211	            exit 0
   212	          fi
   213	
   214	          # Extract every `version:` value from BOTH waiver sections using
   215	          # the same flag-based section parser the file documents (a range
   216	          # pattern collapses because the start/end regex overlap), strip
   217	          # any -rc.* suffix, then sort -V -u. Iterated via a while-read
   218	          # loop (portable: no mapfile / bash-4 dependency).
   219	          FAILED=0
   220	          COUNT=0
   221	          while IFS= read -r v; do
   222	            [[ -z "$v" ]] && continue
   223	            COUNT=$((COUNT + 1))
   224	            # v >= FIRST_GA  <=>  the smaller of {v, FIRST_GA} under
   225	            # version-sort is FIRST_GA. (Equal floor counts as reached.)
   226	            LOWER="$(printf '%s\n%s\n' "$v" "$FIRST_GA" | sort -V | head -1)"
   227	            if [[ "$v" == "$FIRST_GA" || "$LOWER" == "$FIRST_GA" ]]; then
   228	              echo "::error::Waiver version $v has reached the GA sunset floor (FIRST_GA=$FIRST_GA)"
   229	              echo "::error::Pre-GA RC-hold/staleness waivers are dishonest at or past GA."
   230	              echo "::error::Remove the $v waiver entry (and resume ADR-007 enforcement) or lower FIRST_GA only with a real adopter."
     1	name: NPM Publish
     2	
     3	# Sprint 5 Phase 4; registry auth migrated to npm **Trusted Publishing**
     4	# (OIDC) by PLAN-158 Wave 1 (PLAN-152 §Deferred backlog-oidc successor).
     5	# Publishes ceo-orchestration on tag push (`v*`): the npm CLI (>=11.5.1,
     6	# upgraded in-job — Node 20 bundles npm 10.x, which cannot do the
     7	# exchange) detects the GitHub Actions OIDC context (`id-token: write`)
     8	# and exchanges the per-run JWT for a short-lived publish credential
     9	# scoped to this repo + workflow + `production-npm` environment as
    10	# registered in the npmjs.com trusted-publisher config (Owner console).
    11	# The same JWT keeps feeding the Sigstore `--provenance` attestation.
    12	# The long-lived NPM_TOKEN is NOT read by this workflow anymore and is
    13	# REVOKED once the first OIDC GA publish succeeds (until then it exists
    14	# solely as the rollback path:
    15	# .claude/plans/PLAN-158/staged/wave1/rollback-oidc-to-token.patch +
    16	# .claude/plans/PLAN-158/oidc-failure-playbook.md — tag runs pin the
    17	# workflow to the tag's tree, so a failed GA publish means rollback +
    18	# delete/re-tag; there is no workflow_dispatch here by design).
    19	# Manual `npm publish` is not used. The workflow:
    20	#   1. Verifies VERSION + npm/package.json version + tag are consistent
    21	#   2. Asserts package.json has zero runtime dependencies
    22	#   3. Checks the registry for the exact version (PLAN-153 Wave B item 5
    23	#      `already_published` idempotency guard) — if already present, the
    24	#      run succeeds as a no-op instead of failing on EPUBLISHCONFLICT
    25	#   4. Publishes with --provenance (Sigstore-attested)
    26	#
    27	# PLAN-013 Phase 0 item 0.2 hardening (debate Round 1 consensus §C5
    28	# CRITICAL, 2/5 agents — DevOps + Staff Backend):
    29	#   - Skip RC tags entirely (`if: !contains(github.ref, '-rc.')`) —
    30	#     pushing `v1.4.0-rc.1` MUST NOT trigger a public npm publish;
    31	#     that would violate PLAN-013 anti-goal #3 ("NO NPM publish during
    32	#     Sprint 13") and anti-goal #16 ("NO auto-publish from tag without
    33	#     manual approval").
    34	#   - GA tags (`v1.4.0`) gate through `environment: production-npm`,
    35	#     which requires a manual approval step in GitHub's Environments
    36	#     settings before the job runs. The manual approval is the
    37	#     Owner-in-the-loop gate covering the Sprint 17 public-launch
    38	#     go/no-go decision (private-first strategy per
    39	#     `project_closure_strategy.md`).
    40	#
    41	# ---------------------------------------------------------------------
    42	# PLAN-166 W1 item 1 (F1, P0) — the publish now OBSERVES the governance
    43	# gate. `release.yml` and this workflow both fire on `push: tags: v*` as
    44	# two INDEPENDENT runs; until PLAN-166 nothing made the publish observe
    45	# the gate, so the only barrier was a human approving `production-npm`
    46	# with no machine evidence that `release-gate` was green — a live path
    47	# to publishing an unreviewed tree. A first job (`await-release-gate` —
    48	# deliberately NO `environment:` and NO RC exclusion, so it runs on RC
    49	# tags as a live positive control) polls release.yml's `release-gate`
    50	# JOB (never the run conclusion: CEO_SOTA_DISABLE=1 skips the job while
    51	# the run stays green) for THIS tag at THIS commit and fail-CLOSED
    52	# blocks unless it concluded success. `publish` gains
    53	# `needs: await-release-gate`; its `environment: production-npm`
    54	# approval and the RC exclusion are VERBATIM unchanged. Deliberate
    55	# ordering: the Owner's manual-approval prompt only appears AFTER the
    56	# gate is green — approval can never race ahead of machine evidence —
    57	# and the `already_published` idempotency guard STAYS in the publish
    58	# job (last-resort idempotency), not in the gate job. Do not "optimise"
    59	# the order back.
    60	#
    61	# Alternatives REJECTED (do not resurrect without a new debate):
    62	#   - `workflow_run` trigger: GitHub executes the workflow file from
    63	#     the DEFAULT branch, not the tag's tree — that kills the rollback
    64	#     invariant documented above (tag runs pin this workflow to the
    65	#     tag's tree; a failed GA publish means rollback + delete/re-tag).
    66	#   - moving the publish into release.yml: npm trusted publishing binds
    67	#     OIDC by workflow FILENAME
    68	#     (.claude/plans/PLAN-158/oidc-failure-playbook.md:18) — renaming
    69	#     the publishing workflow breaks the npmjs registration, plus ~6
    70	#     test pins on the npm-publish.yml path.
    71	#   - a reusable `workflow_call` gate shared by both workflows:
    72	#     refactor candidate, post-GA only (PLAN-166 §Deferred) — not
    73	#     during an open release window.
    74	#
    75	# The trusted-publisher binding triple (repository / workflow filename /
    76	# environment) is recorded in
    77	# .claude/governance/npm-trusted-publisher.txt and cross-checked by
    78	# .claude/scripts/tests/test_release_workflow_asserts.py, which READS
    79	# that file (embedding the values in the test would be a 4th copy of
    80	# the truth).
    81	
    82	on:
    83	  push:
    84	    tags:
    85	      - "v*"
    86	
    87	concurrency:
    88	  group: npm-publish-${{ github.ref }}
    89	  cancel-in-progress: false
    90	
    91	permissions:
    92	  contents: read
    93	  id-token: write   # required for OIDC trusted publishing + provenance
    94	
    95	jobs:
    96	  # ---------------------------------------------------------------------
    97	  # PLAN-166 W1 item 1 (F1, P0) — OBSERVE THE GOVERNANCE GATE.
    98	  # This job is the machine evidence that release.yml's `release-gate`
    99	  # job passed for this exact tag+SHA+push. It deliberately carries NO
   100	  # `environment:` and NO RC exclusion: it runs on rc tags too, which
   101	  # makes every RC a live positive control of the gate before GA ever
   102	  # depends on it.
   103	  # Decision function + battery: .claude/scripts/await_release_gate.py,
   104	  # .claude/scripts/tests/test_await_release_gate.py.
   105	  await-release-gate:
   106	    name: Await release-gate (release.yml)
   107	    runs-on: ubuntu-latest
   108	    # 50 > the poller's own 45-minute deadline, so a timeout surfaces as
   109	    # the decision function's fail-CLOSED BLOCK (with its inputs printed),
   110	    # not as an opaque runner kill. 45 min > the release-gate's own
   111	    # 35-minute timeout-minutes with margin (rail rc.3 r1 P1-3): the
   112	    # observer must always outlive the producer, or a gate finishing in
   113	    # minutes 31-35 goes green while the waiter already gave up.
   114	    timeout-minutes: 50
   115	    permissions:
   116	      contents: read   # checkout the tag to get the decision script
   117	      actions: read    # read release.yml's runs + jobs over the REST API
   118	    env:
   119	      # `permissions:` alone does NOT authenticate the `gh` CLI on a
   120	      # hosted runner. Without GH_TOKEN every poll dies on auth, which is
   121	      # BLOCK (fail-closed) — i.e. it would break EVERY release, RC and
   122	      # GA alike. This token is the job's only credential; the job has no
   123	      # id-token and no environment.
   124	      GH_TOKEN: ${{ github.token }}
   125	    steps:
   126	      - name: Checkout tag
   127	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   128	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   129	
   130	      # PLAN-169 W2.8 (ADR-192; pair-rail S300 r3 P1-1) — the program
   131	      # this job uses to WAIT for the release gate is itself a free
   132	      # script. Verifying the manifest only in release.yml is not
   133	      # enough: a drifted await_release_gate.py that fake-GRANTs would
   134	      # reach the production-npm approval while release.yml fails in
   135	      # parallel. Fail-closed BEFORE the script runs.
   136	      - name: Gate-scripts integrity (W2.8 checksum manifest)
   137	        run: |
   138	          set -euo pipefail
   139	          M=.claude/governance/gate-scripts-manifest.txt
   140	          [[ -f "$M" ]] || { echo "::error::$M missing (W2.8 canonical manifest)"; exit 1; }
   141	          shasum -a 256 -c "$M" \
   142	            || { echo "::error::gate-script drift vs $M (ADR-192) — member edits go through the canonical-edit ceremony"; exit 1; }
   143	          echo "OK: all gate scripts match $M"
   144	
   145	      - name: Poll release.yml until release-gate concludes
   146	        # No `${{ }}` interpolation inside this script by design — every
   147	        # value arrives through the environment, so no workflow expression
   148	        # is ever spliced into shell text.
   149	        run: |
   150	          set -euo pipefail
   151	          TAG="${GITHUB_REF_NAME}"
   152	          DEADLINE=$(( $(date +%s) + 2700 ))
   153	          SELF_CREATED_AT="$(gh api \
   154	            "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}" \
   155	            --jq '.created_at' < /dev/null)"
   156	          echo "inputs: tag=${TAG} head_sha=${GITHUB_SHA} run_id=${GITHUB_RUN_ID}"
   157	          echo "inputs: self_created_at=${SELF_CREATED_AT} deadline_epoch=${DEADLINE}"
   158	
   159	          fetch_payload() {
   160	            # One document: every run for THIS head_sha, each carrying its
   161	            # jobs. A run whose jobs endpoint is unreadable keeps no `jobs`
   162	            # key — the decision function reads that as WAIT, never GRANT.
   163	            if ! gh api --paginate \
   164	                "repos/${GITHUB_REPOSITORY}/actions/runs?head_sha=${GITHUB_SHA}&per_page=100" \
   165	                --jq '.workflow_runs[] | {id, run_attempt, path, event, head_branch, head_sha, created_at, status, conclusion}' \
   166	                > runs.ndjson < /dev/null; then
   167	              # An API error is BLOCK by design (ADR-186: input we cannot
   168	              # verify is blocked, not waved through).
   169	              echo '{"api_error": "runs listing failed"}' > payload.json
   170	              return 0
   171	            fi
   172	            : > runs_with_jobs.ndjson
   173	            while read -r run; do
   174	              [ -n "${run}" ] || continue
   175	              rid="$(printf '%s' "${run}" | jq -r '.id')"
   176	              if ! run_jobs="$(gh api \
   177	                  "repos/${GITHUB_REPOSITORY}/actions/runs/${rid}/jobs?per_page=100" \
   178	                  --jq '[.jobs[] | {name, status, conclusion}]' < /dev/null)"; then
   179	                printf '%s\n' "${run}" >> runs_with_jobs.ndjson
   180	                continue
   181	              fi
   182	              printf '%s' "${run}" \
   183	                | jq -c --argjson jobs "${run_jobs}" '. + {jobs: $jobs}' \
   184	                >> runs_with_jobs.ndjson
   185	            done < runs.ndjson
   186	            jq -c -s '{workflow_runs: .}' runs_with_jobs.ndjson > payload.json
   187	          }
   188	
   189	          attempt=0
   190	          while true; do
   191	            attempt=$(( attempt + 1 ))
   192	            fetch_payload
   193	            set +e
   194	            python3 .claude/scripts/await_release_gate.py \
   195	              --payload-file payload.json \
   196	              --tag "${TAG}" \
   197	              --head-sha "${GITHUB_SHA}" \
   198	              --self-created-at "${SELF_CREATED_AT}" \
   199	              --deadline-epoch "${DEADLINE}"
   200	            rc=$?
   201	            set -e
   202	            case "${rc}" in
   203	              0)
   204	                echo "::notice::release-gate green for ${TAG} at ${GITHUB_SHA} — publish authorised (poll ${attempt})"
   205	                exit 0
   206	                ;;
   207	              3)
   208	                sleep 20
   209	                ;;
   210	              *)
   211	                echo "::error::release-gate did not authorise this publish (decision exit ${rc}, poll ${attempt}) — the printed inputs above name the run and job that were evaluated"
   212	                exit 1
   213	                ;;
   214	            esac
   215	          done
   216	
   217	  publish:
   218	    # PLAN-013 Phase 0 item 0.2 — RC tag guard.
   219	    # RC tags contain `-rc.` (e.g. `v1.4.0-rc.1`). Skip them entirely.
   220	    # Only GA tags (`v1.4.0`) proceed, and those gate through the
   221	    # `production-npm` environment (manual approval).
   222	    # PLAN-153 Wave B item 5 (f): RC posture UNCHANGED — this exclusion
   223	    # is load-bearing (PLAN-013 anti-goals #3/#16) and MUST survive any
   224	    # future edit to this file; the draft `next` dist-tag idea was
   225	    # DROPPED by ratified debate. Pinned by
   226	    # .claude/scripts/tests/test_release_workflow_asserts.py.
   227	    if: "!contains(github.ref, '-rc.')"
   228	    # PLAN-166 W1 item 1: publish only starts after `await-release-gate`
   229	    # proved release.yml's release-gate job green for this exact tag+SHA
   230	    # (default `success()` semantics of `needs:` — an await failure skips
   231	    # this job while the run itself goes red). Deliberate ordering: the
   232	    # production-npm manual-approval prompt appears only AFTER the gate
   233	    # is green. The `already_published` guard stays below, in this job.
   234	    needs: await-release-gate
   235	    runs-on: ubuntu-latest
   236	    environment: production-npm
   237	    timeout-minutes: 8
   238	    steps:
   239	      - name: Checkout tag
   240	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   241	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   242	        with:
   243	          fetch-depth: 0
   244	
   245	      - name: Setup Node 20
   246	        # SHA-pinned: actions/setup-node@v4.1.0
   247	        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e
   248	        with:
   249	          node-version: "20"
   250	          registry-url: "https://registry.npmjs.org"
   251	
   252	      - name: Upgrade npm CLI for Trusted Publishing (OIDC)
   253	        # PLAN-158 W1 (debate, all 3 critics): Node 20 bundles npm 10.x,
   254	        # which does NOT implement the trusted-publishing token exchange —
   255	        # without this step the OIDC publish dies ENEEDAUTH at GA, and
   256	        # there is no earlier proof point (RC tags skip this workflow
   257	        # entirely). npm >=11.5.1 is the first trusted-publishing-GA CLI.
   258	        run: |
   259	          set -euo pipefail
   260	          npm install -g npm@^11.5.1
   261	          NPM_V="$(npm --version)"
   262	          case "$NPM_V" in
   263	            10.*|11.0.*|11.1.*|11.2.*|11.3.*|11.4.*|11.5.0)
   264	              echo "::error::npm $NPM_V < 11.5.1 — trusted publishing unsupported"
   265	              exit 1
   266	              ;;
   267	          esac
   268	          echo "OK: npm $NPM_V (>=11.5.1, trusted-publishing capable)"
   269	
   270	      - name: Verify VERSION matches tag
   271	        run: |
   272	          set -euo pipefail
   273	          TAG="${GITHUB_REF_NAME}"
   274	          VERSION_FILE="$(tr -d '[:space:]' < VERSION)"
   275	          EXPECTED="${TAG#v}"
   276	          if [[ "$VERSION_FILE" != "$EXPECTED" ]]; then
   277	            echo "::error::VERSION ($VERSION_FILE) does not match tag ($TAG → $EXPECTED)"
   278	            exit 1
   279	          fi
   280	          echo "OK: VERSION=$VERSION_FILE matches tag=$TAG"
   281	
   282	      - name: Verify npm/package.json version matches VERSION
   283	        run: |
   284	          set -euo pipefail
   285	          PKG_VERSION=$(node -p "require('./npm/package.json').version")
   286	          VERSION_FILE="$(tr -d '[:space:]' < VERSION)"
   287	          if [[ "$PKG_VERSION" != "$VERSION_FILE" ]]; then
   288	            echo "::error::npm/package.json version ($PKG_VERSION) does not match VERSION ($VERSION_FILE)"
   289	            exit 1
   290	          fi
   291	          echo "OK: npm/package.json version=$PKG_VERSION matches VERSION"
   292	
   293	      - name: Verify zero runtime dependencies
   294	        run: |
   295	          set -euo pipefail
   296	          DEP_COUNT=$(node -p "Object.keys(require('./npm/package.json').dependencies || {}).length")
   297	          if [[ "$DEP_COUNT" -ne 0 ]]; then
   298	            echo "::error::ceo-orchestration must ship with 0 runtime dependencies (got $DEP_COUNT)"
   299	            exit 1
   300	          fi
   301	          echo "OK: ceo-orchestration has zero runtime dependencies"
   302	
   303	      - name: Stage bundle into npm/
   304	        # The npm package needs the framework source tree relative to npm/.
   305	        # Copy (don't symlink — npm pack walks symlinks unpredictably across hosts).
   306	        # PLAN-152 tarball-01: SELECTIVE staging. The root .npmignore is INERT
   307	        # (package.json "files" whitelist takes precedence in npm-packlist), so
   308	        # exclusion must happen at stage time. Framework-internal artifacts
   309	        # (test harness, fixture corpora, eval/, red-team corpus, numbered plan
   310	        # trees, _lib/testing.py + _lib/test_isolation.py per the PLAN-120
   311	        # contract install.sh already honors) must NOT ship. Kept deliberately:
   312	        # .claude/plans/ schemas + README + examples/ (install.sh provisions
   313	        # them) and .claude/policies/fixtures/ (install.sh PLAN-014 A.8 ships
   314	        # the policy bundle including fixtures).
   315	        run: |
   316	          set -euo pipefail
   317	          RSYNC_EXCLUDES=(
   318	            --include='.claude/policies/fixtures/'
   319	            --include='templates/oidc-proxy/tests/'
   320	            --include='templates/oidc-proxy/tests/**'
   321	            --exclude='**/tests/'
   322	            --exclude='**/fixtures/'
   323	            --exclude='.claude/scripts/red-team-corpus/'
   324	            --exclude='.claude/eval/'
   325	            --exclude='.claude/plans/PLAN-[0-9]*'
   326	            --exclude='.claude/hooks/_lib/testing.py'
   327	            --exclude='.claude/hooks/_lib/test_isolation.py'
   328	            --exclude='__pycache__/'
   329	            --exclude='*.pyc'
   330	            --exclude='.pytest_cache/'
   331	          )
   332	          # GA-F3 (S288, fechado S293): README.md FORA da lista — rsync do README
   333	          # raiz sobrescrevia o npm/README.md REVISADO (stamp de review é gate de
   334	          # release em verify-counts VERSION_SITES). O npm publica o npm/README.md
   335	          # rastreado, que é a cópia npm-facing revisada a cada bump.
   336	          for src in scripts templates .claude SPEC VERSION LICENSE PROTOCOL.md; do
   337	            if [[ -e "$src" ]]; then
   338	              rsync -a --delete --delete-excluded "${RSYNC_EXCLUDES[@]}" "$src" "npm/"
   339	            fi
   340	          done
   341	          ls -la npm/
   342	
   343	      - name: Syntax-check the shim
   344	        run: node --check npm/bin/ceo-orch-init.js
   345	
   346	      - name: Verify scripts/install.sh is present in staged bundle
   347	        run: test -f npm/scripts/install.sh
   348	
   349	      - name: Populate install.sh self-SHA trailer (P0-15, PLAN-045)
   350	        # PLAN-045 F-15R2-01 / Session 41: install.sh ships with a
   351	        # `# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL` trailer as its
   352	        # last line. At publish time, compute sha256 of the script body
   353	        # (all lines EXCEPT the last) and substitute the placeholder with
   354	        # the real hex. The script's own self-verify logic reads the same
   355	        # last-line pattern, so downstream adopters running
   356	        # `bash install.sh ...` trigger a rc=5 fail-CLOSED if the script
   357	        # is modified in transit.
   358	        working-directory: npm
   359	        run: |
   360	          set -euo pipefail

exec
