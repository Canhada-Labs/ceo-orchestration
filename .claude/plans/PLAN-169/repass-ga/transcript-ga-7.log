   441	          python3 .claude/scripts/check-installer-write-safety.py --strict > "$LOG" 2>&1
   442	          RC=$?
   443	          echo "--strict rc=$RC — ADVISORY; OQ-1 decides when (and whether) this becomes a gate."
   444	          grep -E '^--strict: ' "$LOG" || echo "(no --strict summary line — see the tail below)"
   445	          tail -n 15 "$LOG"
