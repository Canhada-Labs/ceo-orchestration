   182	# fica fora do calculo nos dois sentidos: aquisicoes nao atualizam o mtime
   183	# dele (idade falsa para "ativo") e o proprio FileLock o recria sob demanda
   184	# (frescor falso para "expirado").
   185	_SESSION_STORE_LOCK_SUFFIX = ".sqlite.lock"
   186	_SESSION_STORE_DATA_SUFFIXES = tuple(
   187	    s for s in _SESSION_STORE_SUFFIXES if s != _SESSION_STORE_LOCK_SUFFIX
   188	)
   189	
   190	# Lock ocupado significa store ATIVO — o GC nunca disputa com um writer,
   191	# entao o timeout e minimo (uma tentativa, sem espera util) e o
   192	# FileLockTimeout vira "pula este store nesta varredura".
   193	_GC_LOCK_TIMEOUT_S = 0.05
   194	
   195	
   196	class PlanIdDerivationError(RuntimeError):
   197	    """Raised when we cannot derive a plan-id from the current session.
   198	
   199	    Callers should surface the message and exit non-zero. Falling back
   200	    to an env var is **forbidden** — consensus M2 treats env vars as
   201	    untrusted because an agent with subshell execution can set them.
   202	    """
   203	
   204	
   205	def _resolve_session_id(session_id: Optional[str]) -> str:
   206	    """Return the effective session id, checking CLAUDE_SESSION_ID if arg is None.
   207	
   208	    Empty / whitespace-only values are treated as missing.
   209	    """
   210	    if session_id is not None:
   211	        val = str(session_id).strip()
   212	        return val
   213	    env_val = os.environ.get("CLAUDE_SESSION_ID", "")
   214	    return env_val.strip()
   215	
   216	
   217	def resolve_plan_id(session_id: Optional[str] = None) -> str:
   218	    """Return the PLAN-NNN currently scoped to the given session.
   219	
   220	    Scans ``audit-log.jsonl`` (via :func:`audit_emit.iter_events`) for
   221	    ``plan_transition`` events whose ``session_id`` matches the argument
   222	    (or ``CLAUDE_SESSION_ID`` env var if the argument is None). Returns
   223	    the ``plan_id`` of the MOST RECENT matching event.
   224	
   225	    Args:
   226	        session_id: explicit session id; if None, pulled from env.
   227	
   228	    Returns:
   229	        The canonical ``PLAN-NNN`` string.
   230	
   231	    Raises:
   232	        PlanIdDerivationError: when no session id is available, when
   233	            the audit log is empty or missing, or when no
   234	            ``plan_transition`` event for the session exists.
   235	
   236	    Notes:
   237	        - **No env-var fallback.** Consensus M2 forbids deriving plan
   238	          id from ``CEO_CURRENT_PLAN`` or similar — those are
   239	          agent-spoofable.
   240	        - "Most recent" is *log order*: the last matching event in
   241	          linear file order wins. Timestamps are not re-sorted because
   242	          audit-log writes are ordered by the shared filelock, and
   243	          re-sorting by ts can tie-break wrong on same-second events.
   244	        - A completed-plan session (``to_status=done``) still resolves
   245	          to that plan; scratchpad clear is an explicit call, not an
   246	          implicit consequence of a terminal transition.
   247	        - **PLAN-179 W1 US3 leaves this function unchanged.** The
   248	          session-scope fallback is a NEW path taken by the CALLER after
   249	          this raises — it is not a loosening of the refusal here. This
   250	          function still never guesses a plan id and still never accepts
   251	          one from the environment.
   252	    """
   253	    sid = _resolve_session_id(session_id)
   254	    if not sid:
   255	        raise PlanIdDerivationError(
   256	            "cannot derive plan_id: no session_id provided and "
   257	            "CLAUDE_SESSION_ID env var is unset. Ensure the hook/CLI "
   258	            "is running in a Claude Code session with a live session id."
   259	        )
   260	
   261	    last_plan_id: Optional[str] = None
   262	    seen_any_transition = False
   263	    for event in _audit_emit.iter_events(action_filter="plan_transition"):
   264	        seen_any_transition = True
   265	        event_sid = str(event.get("session_id") or "")
   266	        if event_sid != sid:
   267	            continue
   268	        pid = event.get("plan_id")
   269	        if isinstance(pid, str) and pid:
   270	            last_plan_id = pid
   271	
   272	    if last_plan_id is None:
   273	        if not seen_any_transition:
   274	            raise PlanIdDerivationError(
   275	                f"cannot derive plan_id: no plan_transition events in "
   276	                f"audit-log for session {sid!r}. Is the audit log empty "
   277	                f"or pointed at the wrong path (CEO_AUDIT_LOG_PATH)?"
   278	            )
   279	        raise PlanIdDerivationError(
   280	            f"cannot derive plan_id: audit-log has plan_transition "
   281	            f"events but none for session {sid!r}. The session may not "
   282	            f"have transitioned a plan yet."
   283	        )
   284	    return last_plan_id
   285	
   286	
   287	def open_scratchpad(
   288	    plan_id: Optional[str] = None,
   289	    *,
   290	    value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   291	) -> SqliteStateStore:
   292	    """Open a :class:`SqliteStateStore` for the scratchpad surface.
   293	
   294	    Args:
   295	        plan_id: explicit PLAN-NNN; if None, derived from the current
   296	            session via :func:`resolve_plan_id`.
   297	        value_max_bytes: per-key cap (default inherited from
   298	            state_store; 64 KiB).
   299	
   300	    Returns:
   301	        An unopened store handle. Use as a context manager (``with``)
   302	        or call ``close()`` explicitly.
   303	
   304	    Raises:
   305	        PlanIdDerivationError: when plan_id is None and derivation fails.
   306	        StateStoreInvalidName: when plan_id is malformed.
   307	    """
   308	    resolved = plan_id if plan_id is not None else resolve_plan_id()
   309	    return open_store(
   310	        SCRATCHPAD_STORE_NAME,
   311	        resolved,
   312	        value_max_bytes=value_max_bytes,
   313	    )
   314	
   315	
   316	# --- session-scope fallback (PLAN-179 W1 US3, r1-C1 + r1-C2) -------------
   317	
   318	
   319	def session_id_from_event(event: Optional[Mapping[str, Any]]) -> Optional[str]:
   320	    """Return the session id carried by a hook INPUT dict, or None.
   321	
   322	    PLAN-179 amendment r1-C1 — the refusal. This reads the hook event and
   323	    NOTHING else. In particular it never consults
   324	    ``os.environ['CLAUDE_SESSION_ID']``, and it is deliberately NOT
   325	    routed through :func:`_resolve_session_id` (which does read the env
   326	    as a convenience for the plan path).
   327	
   328	    Why: an env var is agent-spoofable. Any agent that can run a subshell
   329	    can ``export CLAUDE_SESSION_ID=<other-session>`` before a hook fires
   330	    and steer the continuity write into a scope it chose — the same
   380	            :data:`_SESSION_SCOPE_ID_RE`.
   381	    """
   382	    raw = str(session_id or "").strip()
   383	    scope = raw if raw.startswith("session-") else "session-" + raw
   384	    if not _SESSION_SCOPE_ID_RE.match(scope):
   385	        raise StateStoreInvalidName(
   386	            "session scope id %r is not of the form session-<uuid> "
   387	            "(allowed after the prefix: [0-9a-fA-F-]{8,60})" % scope
   388	        )
   389	    return scope
   390	
   391	
   392	def open_session_scratchpad(
   393	    session_id: str,
   394	    *,
   395	    value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   396	) -> SqliteStateStore:
   397	    """Open the SESSION-scoped scratchpad store (r1-C1).
   398	
   399	    Returns the same handle type :func:`open_store` returns, so callers
   400	    use it exactly like :func:`open_scratchpad` (``with`` block, then
   401	    ``set`` / ``get``). The difference is invisible at the call site and
   402	    total on disk: a different ``store_name`` means a different
   403	    directory, so this write can never collide with, shadow, or leak
   404	    into any plan's scratchpad.
   405	
   406	    The ``session-<uuid>`` value is passed as the store's SCOPE id, which
   407	    state_store happens to call ``plan_id`` in its own signature. That is
   408	    a positional-argument name inside another module, not a claim that
   409	    this is a plan: no plan store is ever opened with a ``session-*``
   410	    value, and no ``plan_id`` field in the blob or in any audit event is
   411	    overloaded with it (see :func:`stamp_scope_kind`).
   412	
   413	    Args:
   414	        session_id: session id sourced from the hook input dict.
   415	        value_max_bytes: per-key cap (default 64 KiB, as for plan scope).
   416	
   417	    Returns:
   418	        An unopened :class:`SqliteStateStore` handle.
   419	
   420	    Raises:
   421	        StateStoreInvalidName: when ``session_id`` does not produce a
   422	            valid ``session-<uuid>`` scope id.
   423	    """
   424	    scope = session_scope_id(session_id)
   425	    return open_store(
   426	        SESSION_SCRATCHPAD_STORE_NAME,
   427	        scope,
   428	        value_max_bytes=value_max_bytes,
   429	    )
   430	
   431	
   432	def stamp_scope_kind(blob: Dict[str, Any], scope_kind: str) -> Dict[str, Any]:
   433	    """Stamp ``scope_kind`` into a snapshot blob before it is stored (r1-C1).
   434	
   435	    The stored blob carries which scope produced it so the PostCompact
   436	    reader can report honestly ("this came from the session fallback,
   437	    there was no resolved plan") instead of inferring it from where the
   438	    file happened to be.
   439	
   440	    Args:
   441	        blob: the snapshot dict, mutated in place and returned.
   442	        scope_kind: one of :data:`SCOPE_KIND_PLAN` /
   443	            :data:`SCOPE_KIND_SESSION` — a closed enum, like every other
   444	            governance-visible field in this family.
   445	
   446	    Returns:
   447	        The same dict, with ``scope_kind`` set.
   448	
   449	    Raises:
   450	        ValueError: when ``scope_kind`` is outside the enum.
   451	    """
   452	    if scope_kind not in _SCOPE_KINDS:
   453	        raise ValueError(
   454	            "scope_kind must be one of %r, got %r" % (list(_SCOPE_KINDS), scope_kind)
   455	        )
