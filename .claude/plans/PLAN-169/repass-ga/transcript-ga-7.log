   661	          if ! gpg --show-keys .claude/trust/owner.asc >/dev/null 2>&1; then
   662	            echo "::error::.claude/trust/owner.asc is not a valid PGP public-key block"
   663	            exit 1
   664	          fi
   665	          echo "OK: owner.asc is populated and parseable"
