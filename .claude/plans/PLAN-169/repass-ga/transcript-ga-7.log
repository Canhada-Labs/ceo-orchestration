   902	  publish-release:
   903	    name: Publish GitHub Release + assets
   904	    needs: release-gate
   905	    runs-on: ubuntu-latest
   906	    permissions:
   907	      contents: write
   908	    steps:
   909	      - name: Checkout tag
   910	        # SHA-pinned: actions/checkout@v6.0.2
   911	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   912	        with:
   913	          fetch-depth: 0
   914	      - name: Setup Python 3.11
   915	        # SHA-pinned: actions/setup-python@v6.2.0
   916	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
   917	        with:
   918	          python-version: "3.11"
   919	      - name: Compute install.sh.sha256 (body excluding self-SHA trailer)
   920	        run: |
   921	          set -euo pipefail
   922	          FILE="scripts/install.sh"
   923	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$FILE" "$FILE" | sha256sum | awk '{print $1}')
   924	          printf '%s  install.sh\n' "$HASH" > install.sh.sha256
   925	          echo "install.sh.sha256 = $HASH"
   926	      - name: Generate CycloneDX SBOM
   927	        run: |
   928	          set -euo pipefail
   929	          python3 .claude/scripts/generate-sbom.py --output sbom.cyclonedx.json
   930	      # -----------------------------------------------------------------
   931	      # PLAN-153 Wave B item 5 (d) — templatized release notes.
   932	      # Closes PLAN-152 §Deferred `release-notes-hardcoded-first-release`:
   933	      # the notes string used to hardcode a v1.0.0-only launch sentence,
   934	      # stale for every later tag. Notes are now rendered from
   935	      # `.github/release-notes-template.md` with {{TAG}} / {{VERSION}} /
   936	      # {{BASE_VERSION}} interpolation (BASE_VERSION = VERSION with any
   937	      # -rc.N suffix stripped, so RC notes point at the GA CHANGELOG
   938	      # section). Fail-closed on a missing template or an unrendered
   939	      # placeholder.
   940	      # -----------------------------------------------------------------
   185	            done < runs.ndjson
   186	            jq -c -s '{workflow_runs: .}' runs_with_jobs.ndjson > payload.json
   187	          }
   188	
   189	          attempt=0
   190	          while true; do
   191	            attempt=$(( attempt + 1 ))
   192	            fetch_payload
   193	            set +e
   194	            python3 .claude/scripts/await_release_gate.py \
   195	              --payload-file payload.json \
   196	              --tag "${TAG}" \
   197	              --head-sha "${GITHUB_SHA}" \
   198	              --self-created-at "${SELF_CREATED_AT}" \
   199	              --deadline-epoch "${DEADLINE}"
   200	            rc=$?
   201	            set -e
   202	            case "${rc}" in
   203	              0)
   204	                echo "::notice::release-gate green for ${TAG} at ${GITHUB_SHA} — publish authorised (poll ${attempt})"
   205	                exit 0
   206	                ;;
   207	              3)
   208	                sleep 20
   209	                ;;
   210	              *)
   211	                echo "::error::release-gate did not authorise this publish (decision exit ${rc}, poll ${attempt}) — the printed inputs above name the run and job that were evaluated"
   212	                exit 1
   213	                ;;
   214	            esac
   215	          done
