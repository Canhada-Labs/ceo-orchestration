     1	"""PLAN-179 rail round-10 [P1] — state_store × GC deletion coordination.
     2	
     3	The race: `_ensure_open` runs BEFORE FileLock acquisition, so the
     4	continuity GC (which unlinks aged session stores under that same lock)
     5	can delete the db underneath a connection opened earlier — the writer
     6	then commits into an UNLINKED inode and the snapshot is lost invisibly.
     7	
     8	The cure: `_reopen_if_vanished()` runs as the first statement inside
     9	every FileLock critical section. Under the lock the check is race-free:
    10	if the db path exists, the GC cannot remove it until release; if it
    11	vanished, the store reopens (recreating the file) and the write lands
    12	on disk.
    13	"""
    14	
    15	from __future__ import annotations
    16	
    17	import importlib.util
    18	import os
    19	import sys
    20	import unittest
    21	from pathlib import Path
    22	from unittest import mock
    23	
    24	_THIS = Path(__file__).resolve()
    25	_repo_root = None
    26	for parent in _THIS.parents:
    27	    if (parent / ".claude" / "hooks" / "_lib").is_dir() and (
    28	        parent / ".claude" / "plans"
    29	    ).is_dir():
    30	        _repo_root = parent
    31	        break
    32	assert _repo_root is not None, "could not locate repo root from test path"
    33	_LIVE_HOOKS = _repo_root / ".claude" / "hooks"
    34	_CANONICAL = _LIVE_HOOKS / "_lib" / "state_store.py"
    35	_STAGED = (
    36	    _repo_root / ".claude" / "plans" / "PLAN-179" / "staged-w01"
    37	    / ".claude" / "hooks" / "_lib" / "state_store.py"
    38	)
    39	_MARKER = "_reopen_if_vanished"
    40	
    41	
    42	def _pick(canonical: Path, staged: Path, marker: str) -> Path:
    43	    try:
    44	        if canonical.is_file() and marker in canonical.read_text(encoding="utf-8"):
    45	            return canonical
    46	    except OSError:
    47	        pass
    48	    if staged.is_file() and marker in staged.read_text(encoding="utf-8"):
    49	        return staged
    50	    raise FileNotFoundError(
    51	        "state_store with the round-10 GC coordination not found in "
    52	        "canonical (%s) or staged (%s)" % (canonical, staged)
