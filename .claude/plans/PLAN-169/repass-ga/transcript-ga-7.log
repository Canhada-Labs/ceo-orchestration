   238	class TestCapDiscipline(GcStoreUnitBase):
   239	    def test_cap_splits_across_rotations_lock_always_survives(self):
   240	        """When max_files truncates mid-store, the next rotation finishes
   241	        the DATA collection; the lock file survives both (round-9)."""
   242	        paths = self._mk(_SCOPE, db=self.old, lock=self.old,
   243	                         wal=self.old, shm=self.old)
   244	        first = self._sweep(max_files=2)
   245	        self.assertEqual(first, 2)
   246	        second = self._sweep_all(max_files=10)
   247	        self.assertEqual(first + second, 3)
   248	        for key in ("db", "wal", "shm"):
   249	            self.assertFalse(paths[key].exists())
   250	        self.assertTrue(paths["lock"].exists())
