   116	      - name: Assert framework-version marker matches VERSION
   117	        run: |
   118	          set -euo pipefail
   119	          if [[ ! -f .claude/.framework-version ]]; then
   120	            echo "::error::.claude/.framework-version is missing — it is a tracked file (PLAN-166 F3 / ADR-155-AMEND-1); a release checkout without it must not ship"
   121	            exit 1
   122	          fi
   123	          # BYTE-identical, as the contract says — cmp, not tr-stripped
   124	          # equality. The old tr -d '[:space:]' compare accepted '1 . 3 . 0'
   125	          # or '1.3.0\n\n' while the error message promised byte identity
   126	          # (repass-r2 part-e P2: assert weaker than its own claim).
   127	          if ! cmp -s VERSION .claude/.framework-version; then
   128	            echo "::error::.claude/.framework-version is not byte-identical to VERSION — the version bump writes it as a site (Forma A (ii), fail-closed). xxd both files to see the drift."
   129	            exit 1
   130	          fi
   131	          echo "OK: .claude/.framework-version is byte-identical to VERSION ($(tr -d '[:space:]' < VERSION))"
   132	
   133	      # -----------------------------------------------------------------
   134	      # PLAN-153 Wave B item 5 (e) — version↔plugin-manifest sync, kept
   135	      # NEXT TO the VERSION↔tag assert above so the whole
   136	      # version-consistency family lives in one place.
   137	      #
