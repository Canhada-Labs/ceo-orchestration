   667	      - name: Verify tag GPG signature
   668	        # PLAN-044 audit-v2 C2-P0-02 — activated Wave A 2026-04-27 (Owner pubkey at .claude/trust/owner.asc; PLAN-063 round-4: removed `if: true` per actionlint if-cond)
   669	        run: |
   670	          gpg --import .claude/trust/owner.asc
   671	          git tag --verify ${{ github.ref_name }}
