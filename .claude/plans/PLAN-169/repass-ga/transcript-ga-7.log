   160	          EXPECTED="C.6.2"
   161	          if [ "$OBSERVED" != "$EXPECTED" ]; then
   162	            echo "::error::baseline-manifest failing set CHANGED — declared [$EXPECTED], observed [$OBSERVED]. A NEW id is a regression; a MISSING id means the known-open defect was fixed and this declaration must be updated in the same commit. Never widen it to make the red go away."
   163	            exit 1
   164	          fi
   165	          if [ "$rc" -eq 0 ]; then
