   178	      # -----------------------------------------------------------------
   179	      # F5 — RC-hold / staleness waiver SUNSET assertion.
   180	      #
   181	      # The pre-GA waivers in .claude/governance/governance-waivers.yaml
   182	      # are honest ONLY while the project is pre-GA (adopter_count=0).
   183	      # Every existing rc_hold/workflow_staleness entry is a 1.x version
   184	      # carrying "Pre-GA ... adopter_count=0". To stop that 100%-waiver
   185	      # escape from silently following the project into GA, this step
   186	      # FAILS the release the moment any waiver `version` parses >= the
   187	      # configured FIRST_GA floor. The floor is the first version at which
   188	      # the framework intends to claim GA / publish to adopters; per
   189	      # ADR-073 the next major (v2.0.0) is the documented GA/breaking
   190	      # boundary, so 2.0.0 is the mechanical sunset. After the first real
   191	      # adopter ships, lower FIRST_GA (or empty the waiver lists) so the
   192	      # ADR-007 RC-hold + 14-day staleness gates resume real enforcement.
   193	      #
   194	      # Today (max waiver 1.0.0 < 2.0.0) this passes; it is a tripwire,
   195	      # not a behavior change for the current pre-GA train.
   196	      #
   197	      # `-rc.N` pre-release suffixes are stripped before comparison: RC
   198	      # tags forensically short-circuit the hold gate (see below), so an
   199	      # rc.* waiver is never an enforcement bypass on its own.
   200	      # -----------------------------------------------------------------
   201	      - name: Assert no waiver has reached the GA sunset floor
   202	        env:
   203	          # First version at which pre-GA waivers are no longer honest.
   204	          # Bump DOWN (or empty the waiver lists) once an adopter ships.
   205	          FIRST_GA: "2.0.0"
   206	        run: |
   207	          set -euo pipefail
   208	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   209	          if [[ ! -f "$WAIVER_FILE" ]]; then
   210	            echo "OK: no waiver file present — nothing to sunset"
   211	            exit 0
   212	          fi
   213	
   214	          # Extract every `version:` value from BOTH waiver sections using
   215	          # the same flag-based section parser the file documents (a range
   216	          # pattern collapses because the start/end regex overlap), strip
   217	          # any -rc.* suffix, then sort -V -u. Iterated via a while-read
   218	          # loop (portable: no mapfile / bash-4 dependency).
   219	          FAILED=0
   220	          COUNT=0
   221	          while IFS= read -r v; do
   222	            [[ -z "$v" ]] && continue
   223	            COUNT=$((COUNT + 1))
   224	            # v >= FIRST_GA  <=>  the smaller of {v, FIRST_GA} under
   225	            # version-sort is FIRST_GA. (Equal floor counts as reached.)
   226	            LOWER="$(printf '%s\n%s\n' "$v" "$FIRST_GA" | sort -V | head -1)"
   227	            if [[ "$v" == "$FIRST_GA" || "$LOWER" == "$FIRST_GA" ]]; then
   228	              echo "::error::Waiver version $v has reached the GA sunset floor (FIRST_GA=$FIRST_GA)"
   229	              echo "::error::Pre-GA RC-hold/staleness waivers are dishonest at or past GA."
   230	              echo "::error::Remove the $v waiver entry (and resume ADR-007 enforcement) or lower FIRST_GA only with a real adopter."
   231	              FAILED=1
   232	            fi
   233	          done < <(
   234	            {
   235	              awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   236	              awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE"
   237	            } \
   238	              | grep -oE '^[[:space:]]*-[[:space:]]*version:[[:space:]]*[0-9][0-9A-Za-z.+-]*' \
   239	              | grep -oE '[0-9][0-9A-Za-z.+-]*$' \
   240	              | sed -E 's/-rc\.[0-9.]+$//' \
   241	              | sort -V -u
   242	          )
   243	
   244	          if [[ "$COUNT" -eq 0 ]]; then
   245	            echo "OK: waiver file has no version entries to sunset"
   246	            exit 0
   247	          fi
   248	          if [[ "$FAILED" -ne 0 ]]; then
   249	            exit 1
   250	          fi
   251	          echo "OK: all $COUNT waiver versions are pre-GA (< FIRST_GA=$FIRST_GA)"
   252	
   253	      # -----------------------------------------------------------------
   254	      # PLAN-112-FOLLOWUP-canonical-doc-refresh-gate — canonical doc freshness.
   255	      #
   256	      # Fails the release when an in-scope canonical doc's machine-readable
   257	      # `<!-- last-reviewed: DATE vX.Y.Z -->` stamp is more MINOR releases
   258	      # behind VERSION than its tier allows (security docs N=1; general N=3).
   259	      # Missing/malformed stamp fails-CLOSED. Closes F-D4.
   260	      #
   261	      # Emergency bypass: the checker self-reads an Owner-signed
   262	      # `doc_freshness:` entry (matching this release version) in
   263	      # `.claude/governance/governance-waivers.yaml` and, when present,
   264	      # passes WITH a surfaced ::warning (never a silent skip).
   265	      # -----------------------------------------------------------------
   266	      - name: Canonical doc freshness gate
   267	        run: |
   268	          set -euo pipefail
   269	          python3 .claude/scripts/check-canonical-doc-freshness.py
   270	
   271	      # -----------------------------------------------------------------
   272	      # PLAN-013 Phase 0 item 0.3 — mandatory RC-to-GA hold enforcement.
   273	      # AMENDED 2026-05-03 per ADR-103: 7-day calendar gate REDUCED to
   274	      # 24h Codex re-pass mechanical window per ADR-095 §gate-#6.
   275	      #
   276	      # Debate Round 1 consensus §S3 HIGH (DevOps): "7-day RC hold is
   277	      # policy not mechanism. Policy without mechanism is hope."
   278	      #
   279	      # Rule: a GA tag `v1.x.y` MAY only ship after its corresponding
   280	      # RC tag `v1.x.y-rc.N` has existed for ≥24 hours. The 24h window
   281	      # is mechanical: bounds the maximum Codex external re-pass
   282	      # turnaround (anti same-LLM bias per ADR-095 §gate-#6). NOT a
   283	      # "settle period" — vibecoder-only thesis (ADR-096) means no
   284	      # external adopter pressure for calendar buffers.
   285	      #
   286	      # Mechanism:
   287	      #   1. If tag contains `-rc.` → skip check (RC tags always pass)
   288	      #   2. Else find most recent `v<VERSION>-rc.*` tag (by creator date)
   289	      #   3. If none exists → fail (mandatory RC before GA)
   290	      #   4. Else compute delta; reject if < 24h (86400 seconds)
   291	      # -----------------------------------------------------------------
   292	      - name: Assert 24h Codex re-pass window (GA tags only, waiver-aware)
   293	        run: |
   294	          set -euo pipefail
   295	          TAG="${GITHUB_REF_NAME}"
   296	          VERSION="${TAG#v}"
   297	
   298	          # RC tags short-circuit — they are always permitted.
   299	          if [[ "$TAG" == *-rc.* ]]; then
   300	            echo "::notice::$TAG is an RC tag — skipping 24h hold check"
   301	            exit 0
   302	          fi
   303	
   304	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment).
   305	          # During initial framework development with adopter_count=0,
   306	          # the RC-hold window can be waived per Owner authorization
   307	          # recorded in .claude/governance/rc-hold-waivers.yaml. The
   308	          # waiver is additive: post-first-adopter, the file is expected
   309	          # to be empty and ADR-007 default resumes. Each waiver entry
   310	          # cites Owner directive + round-NN sentinel commit.
   311	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   312	          if [[ -f "$WAIVER_FILE" ]]; then
   313	            if awk '/^rc_hold:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   314	              echo "::notice::$TAG has a pre-GA RC-hold waiver in $WAIVER_FILE — skipping hold check"
   315	              exit 0
   316	            fi
   317	          fi
   318	
   319	          # Find the most-recent RC tag for this version, by creator date.
   320	          # `git tag -l --sort=-creatordate` handles both lightweight and
   321	          # annotated tags uniformly via the dereferenced date.
   322	          LAST_RC=$(git tag -l --sort=-creatordate "v${VERSION}-rc.*" | head -1)
   323	
   324	          if [[ -z "$LAST_RC" ]]; then
   325	            echo "::error::GA tag $TAG has no prior v${VERSION}-rc.* tag"
   326	            echo "::error::Mandatory RC-hold requires a prior RC tag"
   327	            echo "::error::Cut v${VERSION}-rc.1 first; wait 24h (Codex re-pass turnaround); then cut $TAG"
   328	            exit 1
   329	          fi
   330	
   331	          # Creator-date gives a unix-epoch timestamp for both
   332	          # annotated (tagger date) and lightweight (committer date) tags.
   333	          RC_TS=$(git tag -l --format='%(creatordate:unix)' "$LAST_RC")
   334	          GA_TS=$(git tag -l --format='%(creatordate:unix)' "$TAG")
   335	
   336	          if [[ -z "$RC_TS" || -z "$GA_TS" ]]; then
   337	            echo "::error::Could not read creator-date for $LAST_RC or $TAG"
   338	            exit 1
   339	          fi
   340	
   341	          DELTA=$((GA_TS - RC_TS))
   342	          ONE_DAY=$((1 * 86400))
   343	          HOURS=$((DELTA / 3600))
   344	
   345	          if [[ "$DELTA" -lt "$ONE_DAY" ]]; then
   346	            echo "::error::GA tag $TAG is only $HOURS hours after $LAST_RC"
   347	            echo "::error::Mandatory 24h Codex re-pass window not met (delta=${DELTA}s < 86400s)"
   348	            echo "::error::Wait $((24 - HOURS)) more hours OR run Codex re-pass synchronously and add waiver"
   349	            exit 1
   350	          fi
   351	
   352	          echo "OK: $TAG is $HOURS hours after $LAST_RC (≥24h Codex re-pass window per ADR-103)"
   353	
   354	      - name: Assert CHANGELOG entry exists
   355	        run: |
   356	          set -euo pipefail
   357	          TAG="${GITHUB_REF_NAME}"
   358	          VERSION="${TAG#v}"
   359	          # PLAN-153 Wave B item 5 (c) — same RC normalization as the
   360	          # "Assert VERSION matches tag" step above: RC tags never get
   361	          # their own CHANGELOG section; an RC for X.Y.Z validates
   362	          # against the GA `## [X.Y.Z]` section (which exists at RC-cut
   363	          # time because the VERSION bump + CHANGELOG entry land before
   364	          # the RC is tagged). Without this strip the fixed VERSION gate
   365	          # would just move the RC red run one step later.
   366	          VERSION="${VERSION%-rc.[0-9]*}"
   367	          if ! grep -qE "^## \[${VERSION}\]" CHANGELOG.md; then
   368	            echo "::error::CHANGELOG.md has no '## [${VERSION}]' section"
   369	            exit 1
   370	          fi
   371	          echo "OK: CHANGELOG has entry for [$VERSION]"
