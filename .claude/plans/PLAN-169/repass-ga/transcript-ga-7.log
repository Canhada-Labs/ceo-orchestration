   422	      - name: Validate install.sh self-SHA mechanism (P0-15, PLAN-045)
   423	        # PLAN-045 F-15R2-01 / Session 41: end-to-end validation that
   424	        # the install.sh self-SHA verification works. We (a) confirm the
   425	        # placeholder is still present (source checkout state), (b) compute
   426	        # the expected sha, (c) substitute it into a temp copy, (d) run the
   427	        # temp copy — self-verify passes → rc=1 (usage exit, not rc=5).
   428	        run: |
   429	          set -euo pipefail
   430	          FILE="scripts/install.sh"
   430	          FILE="scripts/install.sh"
   431	          # (a) Placeholder must be present in source tree.
   432	          TRAILER_LINE="$(tail -n 1 "$FILE")"
   433	          if [ "$TRAILER_LINE" != "# CEO-INSTALL-SHA256: PLACEHOLDER_RELEASE_FILL" ]; then
   434	            echo "::error::Source install.sh trailer has drifted from placeholder."
   435	            echo "got: $TRAILER_LINE"
   436	            exit 1
   437	          fi
   438	          # (b) + (c) stage a populated copy in a scratch dir.
   439	          SCRATCH="$(mktemp -d -t ceo-selfsha-XXXXXX)"
   440	          cp "$FILE" "$SCRATCH/install.sh"
   441	          HASH=$(awk 'NR==FNR{n++; next} FNR < n' "$SCRATCH/install.sh" "$SCRATCH/install.sh" | sha256sum | awk '{print $1}')
   442	          awk -v hash="$HASH" '
   443	            NR == FNR { total = NR; next }
   444	            FNR == total { print "# CEO-INSTALL-SHA256: " hash; next }
   445	            { print }
   446	          ' "$SCRATCH/install.sh" "$SCRATCH/install.sh" > "$SCRATCH/install.sh.new"
   447	          mv "$SCRATCH/install.sh.new" "$SCRATCH/install.sh"
   448	          chmod +x "$SCRATCH/install.sh"
   449	          # (d) Run the populated copy with no args; must exit rc=1
   450	          #     (usage), NOT rc=5 (self-SHA mismatch).
   451	          set +e
   452	          bash "$SCRATCH/install.sh" > /dev/null 2>"$SCRATCH/err"
   453	          RC=$?
   454	          set -e
   455	          if [ "$RC" -eq 5 ]; then
   456	            echo "::error::populated install.sh still rc=5 — self-SHA mechanism broken"
   457	            cat "$SCRATCH/err"
   458	            exit 1
   459	          fi
   460	          if [ "$RC" -ne 1 ]; then
   461	            echo "::error::populated install.sh rc=$RC (expected 1 for usage exit)"
   462	            cat "$SCRATCH/err"
   463	            exit 1
   464	          fi
   465	          # (e) Tamper test: mutate body, verify rc=5.
   466	          # Prepend malicious line before the trailer
   467	          head -n -1 "$SCRATCH/install.sh" > "$SCRATCH/install.sh.tmp1"
   468	          echo 'echo "MALICIOUS_INJECT" >&2' >> "$SCRATCH/install.sh.tmp1"
   469	          tail -n 1 "$SCRATCH/install.sh" >> "$SCRATCH/install.sh.tmp1"
   470	          chmod +x "$SCRATCH/install.sh.tmp1"
   471	          set +e
   472	          bash "$SCRATCH/install.sh.tmp1" > /dev/null 2>"$SCRATCH/err2"
   473	          RC2=$?
   474	          set -e
   475	          if [ "$RC2" -ne 5 ]; then
   476	            echo "::error::tampered install.sh did NOT rc=5 (got $RC2) — self-SHA gate broken"
   477	            cat "$SCRATCH/err2"
   478	            exit 1
   479	          fi
   480	          echo "OK: install.sh self-SHA mechanism end-to-end validated"
   481	          rm -rf "$SCRATCH"
