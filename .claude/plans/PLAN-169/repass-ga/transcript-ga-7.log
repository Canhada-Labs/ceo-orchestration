   157	    def test_untouched_store_roundtrips_normally(self):
   158	        """Negative control: with no GC interference the guard must be
   159	        invisible — same store object, same values."""
   160	        store = _ss.SqliteStateStore(self.STORE, self.SCOPE)
   161	        try:
   162	            store.set("k", "v")
   163	            self.assertEqual(store.get("k"), b"v")
   164	        finally:
   165	            store.close()
