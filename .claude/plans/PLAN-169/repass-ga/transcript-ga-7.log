   214	def _neutralize_whole_dir_overrides() -> Dict[str, Optional[str]]:
   215	    """Pop every whole-directory override and return what was popped.
   216	
   217	    Import-time by design. All three conftests import this module while pytest
   218	    is loading conftests — BEFORE any test module is imported and long before
   219	    the session fixture body runs (verified: conftest import -> test-module
   220	    import -> session-fixture body -> test body). A fixture-time pop would sit
   221	    two steps later than the collection window.
   222	
   223	    The returned mapping is diagnostic only. Nothing restores it: the escape's
   224	    write happens at interpreter shutdown, so a restore anywhere inside the
   225	    process hands the carrier back before that write. The cost is process-local
   226	    and cosmetic — a runner that calls ``pytest.main()`` repeatedly sees the
   227	    carrier stay popped until it exits — and it is the deliberate trade.
   228	    """
   229	    popped: Dict[str, Optional[str]] = {}
   230	    for key in WHOLE_DIR_OVERRIDE_CARRIERS:
   231	        popped[key] = os.environ.pop(key, None)
   232	    return popped
