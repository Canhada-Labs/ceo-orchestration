   103	
   104	class TestWriteSurvivesGcDeletion(GcCoordinationBase):
   105	    def test_cached_connection_write_lands_after_gc_unlink(self):
   106	        """THE round-10 control: a store object holding a connection opened
   107	        BEFORE the GC unlink must still produce an on-disk write — not a
   108	        commit into an unlinked inode."""
   109	        store = _ss.SqliteStateStore(self.STORE, self.SCOPE)
   110	        store.set("k1", "before-gc")
   111	        self._unlink_store_files()
   112	        store.set("k2", "after-gc")  # would vanish without the reopen guard
   113	        store.close()
