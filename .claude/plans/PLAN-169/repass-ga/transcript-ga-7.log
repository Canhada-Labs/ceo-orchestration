    80	class GcCoordinationBase(TestEnvContext):
    81	    STORE = "scratchpad-session"
    82	    SCOPE = "session-" + "cd34" * 8
    83	
    84	    def setUp(self):
    85	        super().setUp()
    86	        self.state_root = Path(self.project_dir) / "state"
    87	        self._env = mock.patch.dict(
    88	            os.environ, {"CEO_STATE_ROOT": str(self.state_root)}, clear=False
    89	        )
    90	        self._env.start()
    91	        self.addCleanup(self._env.stop)
    92	
    93	    def _unlink_store_files(self):
    94	        """What the GC does under the lock: remove db + WAL + SHM."""
    95	        store_dir = self.state_root / self.STORE
    96	        for suffix in (".sqlite", ".sqlite-wal", ".sqlite-shm"):
    97	            p = store_dir / (self.SCOPE + suffix)
    98	            try:
