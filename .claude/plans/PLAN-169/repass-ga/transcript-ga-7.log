   129	            self.assertIsNone(store.get("k1"))
   130	        finally:
   131	            store.close()
   132	
   133	    def test_second_handle_detects_inode_replacement(self):
   134	        """Rail round-11 [P2]: after a GC unlink, the FIRST handle's reopen
   135	        RECREATES the path — the second handle then sees the path existing
   136	        while its connection targets the dead inode. Identity is (dev, ino),
   137	        so the second handle must ALSO reopen and its write must land."""
   138	        a = _ss.SqliteStateStore(self.STORE, self.SCOPE)
   139	        b = _ss.SqliteStateStore(self.STORE, self.SCOPE)
   140	        a.set("seed-a", "1")
   141	        b.set("seed-b", "1")            # both connections now open
   142	        self._unlink_store_files()      # the GC
   143	        a.set("post-gc-a", "va")        # recreates the path (new inode)
   144	        b.set("post-gc-b", "vb")        # would hit the DEAD inode without
   145	        a.close()                       # the (dev, ino) comparison
   146	        b.close()
   147	        fresh = _ss.SqliteStateStore(self.STORE, self.SCOPE)
   148	        try:
   149	            self.assertEqual(fresh.get("post-gc-a"), b"va")
   150	            self.assertEqual(
   151	                fresh.get("post-gc-b"), b"vb",
   152	                "the second handle committed into the replaced inode",
   153	            )
   154	        finally:
   155	            fresh.close()
