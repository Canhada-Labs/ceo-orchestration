   341	
   342	def build_parser() -> argparse.ArgumentParser:
   343	    """Build the argparse parser for the scratchpad CLI."""
   344	    parser = argparse.ArgumentParser(
   345	        prog="scratchpad.py",
   346	        description=(
   347	            "Plan-scoped shared scratchpad for inter-agent handoff. "
   348	            "Consumes _lib/state_store.py (ADR-027) + derives plan-id "
   349	            "from audit-log session linkage (consensus M2)."
   350	        ),
   351	    )
   352	    sub = parser.add_subparsers(dest="cmd", metavar="<command>")
   353	
   354	    p_set = sub.add_parser("set", help="Write a key/value.")
   355	    p_set.add_argument("key")
   356	    p_set.add_argument("value")
   357	    p_set.add_argument(
   358	        "--ttl",
   359	        type=int,
   360	        default=None,
   361	        help="TTL in seconds (positive int). Omit for no-expiry.",
   362	    )
   363	    _add_plan_flag(p_set)
   364	    _add_json_flag(p_set)
   365	
   366	    p_get = sub.add_parser("get", help="Read a key.")
   367	    p_get.add_argument("key")
   368	    _add_plan_flag(p_get)
   369	    _add_json_flag(p_get)
   370	
   371	    p_list = sub.add_parser("list", help="List non-expired keys.")
   372	    _add_plan_flag(p_list)
   373	    _add_json_flag(p_list)
   374	
   375	    p_del = sub.add_parser("delete", help="Delete a key.")
   376	    p_del.add_argument("key")
   377	    _add_plan_flag(p_del)
   378	    _add_json_flag(p_del)
   379	
   380	    p_clr = sub.add_parser(
   381	        "clear", help="Drop every key for the plan (requires --confirm)."
   382	    )
   383	    p_clr.add_argument(
   384	        "--confirm",
   385	        action="store_true",
   386	        default=False,
   387	        help="Safety interlock — clear refuses without this flag.",
   388	    )
   389	    _add_plan_flag(p_clr)
   390	    _add_json_flag(p_clr)
   391	
   392	    return parser
