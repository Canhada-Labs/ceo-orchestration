   235	          fi
   236	          # rail round-3 F1 — and it must be a destination the SHARED TABLE
   237	          # declares. Shape rules are a denylist; this is the whitelist.
   238	          if ! _wbm_route_dest_declared "$_fms_tpl"; then
   239	            echo "    ERROR: delivered-template entry REJECTED (not a destination declared in $_WBM_ROUTES_TSV): '$_fms_tpl'" >&2
   240	            continue
   241	          fi
   242	          printf '%s\n' "$_fms_tpl"
   243	        done
   244	      fi
   245	    fi
   246	
   247	    [ "$_fms_te_had_f" = "1" ] || set +f
   248	  } | LC_ALL=C sort -u
