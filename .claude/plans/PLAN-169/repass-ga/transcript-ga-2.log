  1055	# Every destination the table declares, one per line. Callers that must decide
  1056	# WHICH routes they delivered (upgrade.sh) iterate this instead of carrying a
  1057	# second copy of the destination list.
  1058	#
  1059	# F2: a row that fails validation is NOT emitted. The count therefore DROPS
  1060	# below _wbm_route_rows_total, which is what upgrade.sh's AC-9 precondition
  1061	# turns into a named delivery failure — the rejected row can never reach a
  1062	# write, and it cannot be swallowed either.
  1063	_wbm_route_dests() {
