   756	#   - If $TARGET/.claude/ already exists, snapshot it to $BACKUP_DIR.
   757	#   - On ANY failure (trap EXIT rc != 0), remove the partial
   758	#     $TARGET/.claude/ and move the backup back into place.
   759	#   - On success, remove the backup in an explicit cleanup step.
   760	# The backup is placed in a unique mktemp tempdir so it cannot collide
   760	# The backup is placed in a unique mktemp tempdir so it cannot collide
   761	# with user data.
   762	
   763	BACKUP_DIR=""
   764	INSTALL_SUCCEEDED=0
   765	
   766	# WS4-mtime-helper: portable file mtime (epoch seconds) — GNU + BSD stat.
   767	detect_mtime() {
   768	  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
   769	}
   770	
   771	cleanup_on_failure() {
   772	  local rc=$?
   773	  # PLAN-153 Wave B item B1 — the ops journal lives OUTSIDE $TARGET; drop it
   774	  # on every exit path (fail-open, never affects rc).
   775	  if [[ -n "${_STATE_OPS_FILE:-}" ]]; then rm -f "$_STATE_OPS_FILE" 2>/dev/null || true; fi
   776	  # PLAN-185 W2 — the staging file of an in-flight atomic write. Every failure
   777	  # path inside the writer removes it; this is the trap half, for an abort
   778	  # BETWEEN mktemp and mv (a signal, or `set -e` firing in a callee). Without
   779	  # it a `.ceo-codeowners.XXXXXX` would be left in the adopter's .github/.
   780	  if [[ -n "${_ATOMIC_TMP_PENDING:-}" ]]; then rm -f "$_ATOMIC_TMP_PENDING" 2>/dev/null || true; fi
   781	  if [[ "$DRY_RUN" -eq 1 ]]; then
   782	    # Dry-run never touches $TARGET, so never restore.
   783	    exit "$rc"
   784	  fi
   785	  if [[ "$INSTALL_SUCCEEDED" -eq 1 ]]; then
   786	    # Success — clean the backup silently.
   787	    if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
   788	      rm -rf "$BACKUP_DIR" 2>/dev/null || true
   789	    fi
   790	    exit "$rc"
   791	  fi
   792	  if [[ $rc -ne 0 && -n "$BACKUP_DIR" && -d "$BACKUP_DIR/.claude" ]]; then
   793	    echo "::error::install failed (rc=$rc) — restoring $TARGET/.claude from $BACKUP_DIR" >&2
   794	    if [[ -d "$TARGET/.claude" ]]; then
   795	      rm -rf "$TARGET/.claude" 2>/dev/null || true
   796	    fi
   797	    mv "$BACKUP_DIR/.claude" "$TARGET/.claude" 2>/dev/null || true
   798	    rm -rf "$BACKUP_DIR" 2>/dev/null || true
   799	    echo "::error::rollback complete — target restored to pre-install state" >&2
   800	  fi
   801	  exit "$rc"
   802	}
   803	
   804	# PLAN-185 W1 (rail round-4 P1) — EVERY path the EXIT trap deletes is
   805	# initialised HERE, before the trap can fire, so none of them can be inherited
   806	# from the caller's environment.
   807	#
   808	# The trap runs `rm -f` on `_STATE_OPS_FILE` and `_ATOMIC_TMP_PENDING`, and
   809	# `rm -rf` on `BACKUP_DIR`. `BACKUP_DIR` was already set above; the other two
   810	# were not — `_ATOMIC_TMP_PENDING` was first assigned inside the atomic writer
   811	# (which `--dry-run` never calls at all) and `_STATE_OPS_FILE` ten lines BELOW
   812	# the trap. Either one exported by the caller was an arbitrary path the trap
   813	# deleted on any exit. REPRODUCED against the pre-cure shadow:
   814	#
   815	#   env _ATOMIC_TMP_PENDING=/path/to/unrelated/file install.sh TARGET --dry-run
   816	#
   817	# exited 0 — with the "no files modified" promise on the label — and the
   818	# unrelated file was GONE. Same class this file already documents for
   819	# `_DELIVERED_TEMPLATES` (:841): a variable the script only ever writes is still
   820	# a variable the environment can seed.
   821	_ATOMIC_TMP_PENDING=""
   822	_STATE_OPS_FILE=""
   823	
   824	trap cleanup_on_failure EXIT
   825	
   826	# ---------------------------------------------------------------------
   827	# PLAN-153 Wave B item B1 — install-state operation journal.
   828	# Each major install operation appends one TAB-separated line
   829	# (op<TAB>detail) to a tempfile OUTSIDE $TARGET; _write_install_state
   830	# folds the journal into .claude/.install-state.json at the end of a
   831	# successful run. Dry-run never creates the journal (the "no files
   832	# modified" promise). Fail-open: journal problems never abort anything.
   833	# ---------------------------------------------------------------------
   834	_STATE_OPS_FILE=""
   835	if [[ "$DRY_RUN" -eq 0 ]]; then
   836	  _STATE_OPS_FILE="$(mktemp "${TMPDIR:-/tmp}/ceo-install-ops.XXXXXX" 2>/dev/null || true)"
   837	fi
   838	_state_record_op() {
   839	  if [[ -n "${_STATE_OPS_FILE:-}" && -f "${_STATE_OPS_FILE:-}" ]]; then
   840	    printf '%s\t%s\n' "$1" "${2:-}" >> "$_STATE_OPS_FILE" 2>/dev/null || true
   841	  fi
   842	  return 0
   843	}
   844	
   845	# ---------------------------------------------------------------------
   846	# PLAN-166 F3 (ADR-155-AMEND-1) — DELIVERY RECORD for the conditional
   847	# framework-ownership surfaces. Each flag flips to 1 ONLY when THIS run
   848	# actually wrote the path (install_one COPIED/LINKED, or the pointer
   849	# heredoc ran) — an EXISTS-skip is NOT a delivery (r17): the pre-existing
   850	# file is the ADOPTER's, and recording it as framework-owned would let the
   851	# baseline hash it, doctor call it drifted, and uninstall delete it.
   852	# write_install_manifest exports these as FMS_DELIVERED_* so the shared
   853	# enumeration (_framework_manifest_set.sh) only records what the framework
   854	# de facto delivered.
   855	# ---------------------------------------------------------------------
   856	_DELIVERED_SPEC=0
   857	_DELIVERED_PROTOCOL=0
   858	_DELIVERED_MARKER=0
   859	# rail round-1 F4 — the ENVIRONMENT is untrusted input for an installer. These
   860	# four are appended to (or flipped) but were never RESET, so an inherited
   861	# value survived into FMS_DELIVERED_* and the baseline manifest recorded it.
   862	# REPRODUCED (S327): with `_DELIVERED_TEMPLATES=ADOPTER-OWNED.md` exported and
   863	# an adopter-owned file of that name in the target, a `--ceremony user` install
   864	# — which runs NEITHER delivery function — recorded that adopter file as
   865	# framework-owned in .claude/.install-manifest.sha256, and a manifest-honouring
   866	# uninstall deletes on a hash match. The three flags below were the same class,
   867	# latent for the same reason; a family is swept when one of its members is.
   868	# Reset here, next to the flags above, so every entry point starts from zero.
   869	_DELIVERED_PLAN_SCHEMA=0
   870	_DELIVERED_DEBATE_SCHEMA=0
   871	_DELIVERED_TEMPLATES=""
   872	_DOCS_TEMPLATE_WROTE=0
   873	_CONTINUITY_PATHS=""
   874	
   875	# PLAN-155 Wave 5 — the codex harness helper records its operations through
   876	# this recorder, mapped onto the install-state journal (overrides the helper's
   877	# no-op default so codex emissions land in .claude/.install-state.json).
   878	codex_journal() { _state_record_op "$1" "${2:-}"; }
   879	
   880	# ---------------------------------------------------------------------------
   881	# PLAN-185 W1 — DESTINATION confinement: the install-side POLICY.
   882	#
   883	# The predicate lives in scripts/_framework_manifest_set.sh (_wbm_dst_refuses);
   884	# this is the policy wrapper, the mirror of _install_src_refuses on the write
   885	# side. Returns 0 when the write must be REFUSED, having already NAMED the path
   886	# and the reason and recorded it for the end-of-run summary.
   887	#
   888	# It sits HERE, above everything that writes, because the global pre-flight
   889	# below has to answer before the first thing that touches the target — and that
   890	# is the `mkdir -p "$TARGET/.claude"` a few lines down.
   891	#
   892	# Fail-CLOSED when the predicate is missing: the library is sourced at :249,
   893	# and a partial checkout that lost it is not a tree this installer should write
   894	# an adopter's target from.
   895	#
   896	# The refusal is ACCUMULATED rather than fatal in place (debate C5/C14). An
   897	# `exit 1` mid-delivery — the shape _assert_no_symlink_parents uses — would
   898	# leave the target MIXED, because the rollback snapshot covers $TARGET/.claude
   899	# ONLY: docs/ and .github/ are never restored. So the writers refuse, keep
   900	# going, and the RUN fails at the end with the whole list. Silence was the
   901	# other option and it is fail-open on delivery.
   902	_DST_REFUSALS=""
   903	_DST_REFUSED_PATHS=""
   904	_DST_REFUSAL_COUNT=0
   905	
   906	# Line-exact membership, NOT a substring `case`. `.github/CODEOWNERS` is a
   907	# PREFIX of `.github/CODEOWNERS.template` and both are destinations of the same
   908	# group, so the substring idiom would answer about the wrong one — the exact
   909	# collision _delivered_template_has already documents.
   910	_dst_already_refused() {
   911	  local want="$1" line
   912	  while IFS= read -r line; do
   913	    [[ "$line" = "$want" ]] && return 0
   914	  done <<< "$_DST_REFUSED_PATHS"
   915	  return 1
   916	}
   917	
   918	# Record ONE unwritten destination for the end-of-run verdict. Shared by the
   919	# confinement refusal below and by the atomic writer, so "the run failed and
   920	# here is every path it did not write" has a single list behind it.
   921	_dst_record_refusal() {
   922	  local dst_rel="$1" why="$2"
   923	  # A destination answered by the pre-flight AND again by its writer must
   924	  # appear ONCE in the summary; the refusal itself is re-answered every time,
   925	  # because the answer closest to the write is the one that matters.
   926	  _dst_already_refused "$dst_rel" && return 0
   927	  echo "    REFUSED (nothing written): $dst_rel — $why" >&2
   928	  _DST_REFUSALS="${_DST_REFUSALS}${_DST_REFUSALS:+
   929	}$dst_rel — $why"
   930	  _DST_REFUSED_PATHS="${_DST_REFUSED_PATHS}${_DST_REFUSED_PATHS:+
   931	}$dst_rel"
   932	  _DST_REFUSAL_COUNT=$(( _DST_REFUSAL_COUNT + 1 ))
   933	  return 0
   934	}
   935	
   936	_dst_refuses() {
   937	  local dst_rel="$1"
   938	  local why=""
   939	  if ! command -v _wbm_dst_refuses >/dev/null 2>&1; then
   940	    why="destination-confinement predicate unavailable (scripts/_framework_manifest_set.sh not sourced) — refusing rather than guessing"
   941	  elif _wbm_dst_refuses "$TARGET" "$dst_rel"; then
   942	    why="${_WBM_DST_REFUSE_WHY:-unknown reason}"
   943	  else
   944	    return 1
   945	  fi
   946	  _dst_record_refusal "$dst_rel" "$why"
   947	  return 0
   948	}
   949	
   950	# rc.1 r12: non-directory ancestor, ANCESTOR-ONLY, for a destination whose
   951	# LEAF policy is owned elsewhere. SPEC/v1 is that case: _ownership_verdict
   952	# decides replacement (PLAN-167) and a `--mode link` delivery leaves a SYMLINK
   953	# there, which _wbm_dst_refuses REFUSES — routing it through _dst_refuses
   954	# would break every link-mode install. An untraversable ancestor is not
   955	# negotiable: an adopter file named SPEC aborted this script at `mkdir` under
   956	# set -e, 387 lines in, with .claude/ already populated.
   957	_dst_ancestor_refuses() {
   958	  local dst_rel="$1"
   959	  local why=""
   960	  if ! command -v _wbm_dst_non_directory_ancestor_refuses >/dev/null 2>&1; then
   961	    why="destination-ancestor predicate unavailable (scripts/_framework_manifest_set.sh not sourced) — refusing rather than guessing"
   962	  elif _wbm_dst_non_directory_ancestor_refuses "$TARGET" "$dst_rel"; then
   963	    why="${_WBM_DST_REFUSE_WHY:-unknown reason}"
   964	  else
   965	    return 1
   966	  fi
   967	  _dst_record_refusal "$dst_rel" "$why"
   968	  return 0
   969	}
   970	
   971	# PLAN-185 W1 — per-GROUP pre-flight (OQ-4, Owner default). Every destination of
   972	# a delivery group is answered BEFORE that group's first write, so a refusal on
   973	# the SECOND destination cannot leave the FIRST one written.
   974	# rc 0 = the whole group may proceed.
   975	_dst_preflight() {
   976	  local rel rc=0
   977	  for rel in "$@"; do
   978	    if _dst_refuses "$rel"; then rc=1; fi
   979	  done
   980	  if [[ "$rc" -ne 0 ]]; then
   981	    echo "    PRE-FLIGHT: refusing this delivery group before its first write (docs/ and .github/ are outside the rollback snapshot, so a mid-group abort would be permanent)" >&2
   982	  fi
   983	  return "$rc"
   984	}
   985	
   986	# Run-level verdict. Called once, after every writer, before the manifest is
   987	# written — a destination the installer refused must never be recorded as a
   988	# framework-owned delivery.
   989	_dst_refusal_verdict() {
   990	  [[ "$_DST_REFUSAL_COUNT" -gt 0 ]] || return 0
   991	  echo "" >&2
   992	  echo "::error::install FAILED — $_DST_REFUSAL_COUNT destination(s) refused because writing them would have escaped $TARGET:" >&2
   993	  local line
   994	  while IFS= read -r line; do
   995	    [[ -n "$line" ]] && echo "::error::  $line" >&2
   996	  done <<< "$_DST_REFUSALS"
   997	  echo "::error::Nothing was written at those paths. Remove the symlink or hard link (or point it inside the target) and re-run." >&2
   998	  return 1
   999	}
  1000	
  1001	# PLAN-185 W1 (rail round-2 P1) — the FIXED template destinations, as ONE list.
  1002	#
  1003	# `install_template` is called with a hardcoded (source, destination) pair in
  1004	# five places, and three of them — CLAUDE.md, MEMORY.md, .mcp.json — run at the
  1005	# very END of the install, long after `.claude/`, `docs/` and `.github/` have
  1006	# been populated. The global pre-flight below therefore has to know about them,
  1007	# and a SECOND hand-written copy of that list is exactly how the pre-flight and
  1008	# the writers drift apart. So the rows live HERE and both sides read them: the
  1009	# pre-flight takes the destination halves, the writers take whole rows.
  1010	#
  1011	# MEASURED pre-cure: a dangling `CLAUDE.md` symlink on a fresh maintainer target
  1012	# sailed through the pre-flight, the whole framework was delivered, and the
  1013	# refusal surfaced only at this last step — leaving a partial install with no
  1014	# manifest on a target that has no BACKUP_DIR to roll back to.
  1015	#
  1016	# Format: one `source|destination` row per line.
  1017	
  1018	# The tier-policy pair lands INSIDE .claude/, so every ceremony delivers it.
  1019	_FIXED_TEMPLATES_ALL_CEREMONIES="templates/.claude/tier-policy.json|.claude/tier-policy.json
  1020	templates/.claude/tier-policy.json.sigchain|.claude/tier-policy.json.sigchain"
  1021	
  1022	# The project-root files are maintainer-only (WS4: a user install writes inside
  1023	# .claude/ and nowhere else).
  1024	#
  1025	# PLAN-135 W1 S5-lite on `.mcp.json`: it is the project-scope MCP registration
  1026	# for the Codex pair-rail (the 'codex' server backs the mcp__codex__codex |
  1027	# mcp__codex__codex-reply matchers in settings.json). install_template is
  1028	# idempotent EXISTS->SKIP, so an adopter's own .mcp.json is never clobbered;
  1029	# credentials travel by ${ENV} expansion only, never as secrets on disk.
  1030	_FIXED_TEMPLATES_MAINTAINER="templates/CLAUDE.md|CLAUDE.md
  1031	templates/MEMORY.md|MEMORY.md
  1032	templates/.mcp.json|.mcp.json"
  1033	
  1034	# The destination halves of a row list, one per line.
  1035	_fixed_template_dests() {
  1036	  local row
  1037	  while IFS= read -r row; do
  1038	    [[ -n "$row" ]] || continue
  1039	    printf '%s\n' "${row#*|}"
  1040	  done <<< "$1"
  1041	}
  1042	
  1043	# Deliver every row of a list through the ONE writer.
  1044	_install_fixed_templates() {
  1045	  local row
  1046	  while IFS= read -r row; do
  1047	    [[ -n "$row" ]] || continue
  1048	    install_template "${row%%|*}" "${row#*|}"
  1049	  done <<< "$1"
  1050	}
  1051	
  1052	# PLAN-185 W1 (rail round-1 P1) — GLOBAL PRE-FLIGHT, before the FIRST write.
  1053	#
  1054	# The per-group pre-flights are not enough on their own: each runs when its
  1055	# group runs, and by then `.claude` has been created and populated. MEASURED
  1056	# pre-cure on a FRESH target carrying a dangling `docs/rotation-log.md`: the run
  1057	# ended rc 1, the refusal was named, and zero bytes went outside the target —
  1058	# but **563 files were left INSIDE it**, `PROTOCOL.md` and `.github/` among
  1059	# them, with NO manifest and NO install-state. Rollback cannot reach that:
  1060	# BACKUP_DIR is EMPTY for a fresh target (there was no `.claude` to snapshot),
  1061	# and even on an existing target it restores `.claude` only. The adopter is left
  1062	# holding a half-installed framework that nothing records — the partial-state
  1063	# outcome the accumulate-and-fail-at-the-end policy exists to avoid, arriving
  1064	# through the door that policy left open.
  1065	#
  1066	# So the run answers FIRST, for every destination whose relpath is known before
  1067	# delivery begins, and refuses with the COMPLETE list while the target is still
  1068	# untouched. `install_one` / `install_template` destinations are enumerated from
  1069	# the source tree as delivery proceeds and keep their per-writer check; those
  1070	# per-writer checks stay regardless, because the answer taken immediately before
  1071	# a write is the one that matters under TOCTOU.
  1072	#
  1073	# rc 0 = every known destination is confined.
  1074	_dst_global_preflight() {
  1075	  local rels rel rc=0
  1076	  rels=".claude/settings.json
  1077	$( _fixed_template_dests "$_FIXED_TEMPLATES_ALL_CEREMONIES" )"
  1078	  if [[ "$WITH_REFERENCE_PERSONAS" -eq 1 ]]; then
  1079	    rels="$rels
  1080	.claude/team-personas-reference.md"
  1081	  fi
  1082	  # A `--ceremony user` install writes inside .claude/ only (WS4), so the root,
  1083	  # docs/ and .github/ destinations below are not its to answer for.
  1084	  if [[ "$CEREMONY" != "user" ]]; then
  1085	    rels="$rels
  1086	$( _fixed_template_dests "$_FIXED_TEMPLATES_MAINTAINER" )
  1087	docs/BRANCH-PROTECTION.md
  1088	docs/rotation-log.md
  1089	PROTOCOL.md
  1090	.github/workflows/validate.yml.template
  1091	.github/workflows/benchmarks.yml.template"
  1092	    # The two CODEOWNERS destinations are mutually exclusive and the handle
  1093	    # decides which, exactly as the delivery branches do.
  1094	    if [[ -n "$GITHUB_OWNER" ]]; then
  1095	      rels="$rels
  1096	.github/CODEOWNERS"
  1097	    else
  1098	      rels="$rels
  1099	.github/CODEOWNERS.template"
  1100	    fi
  1101	  fi
  1102	  while IFS= read -r rel; do
  1103	    [[ -n "$rel" ]] || continue
  1104	    if _dst_refuses "$rel"; then rc=1; fi
  1105	  done <<< "$rels"
  1106	  # SPEC/v1 is a DIRECTORY delivery under the same WS4 ceremony guard as the
  1107	  # root surfaces; ancestor-only, per the note on _dst_ancestor_refuses.
  1108	  if [[ "$CEREMONY" != "user" && -d "$SOURCE_DIR/SPEC/v1" ]]; then
  1109	    if _dst_ancestor_refuses "SPEC/v1"; then rc=1; fi
  1110	  fi
  1111	  return "$rc"
  1112	}
  1113	
  1114	if ! _dst_global_preflight; then
  1115	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1116	    # The preview keeps running: truncating it here would hide everything the
  1117	    # adopter asked to see. The verdict at the end still reports non-zero.
  1118	    echo "    (dry-run) PRE-FLIGHT: a real install would REFUSE the destination(s) above and write NOTHING." >&2
  1119	  else
  1120	    echo "" >&2
  1121	    echo "::error::install REFUSED before its first write — the target has NOT been touched." >&2
  1122	    _dst_refusal_verdict || true
  1123	    exit 1
  1124	  fi
  1125	fi
  1126	
  1127	if [[ "$DRY_RUN" -eq 0 ]]; then
  1128	  if [[ -d "$TARGET/.claude" ]]; then
  1129	    BACKUP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ceo-install-backup.XXXXXX")"
  1130	    cp -R "$TARGET/.claude" "$BACKUP_DIR/.claude"
  1131	    echo "    SNAPSHOT: $TARGET/.claude -> $BACKUP_DIR/.claude (for rollback)"
  1132	  fi
  1133	  mkdir -p "$TARGET/.claude"
  1134	  # WS4-presnapshot: record pre-existing non-.claude top-level entries so
  1135	  # the post-install guard (user ceremony) can detect any CREATE or MODIFY
  1136	  # outside .claude/. Snapshot = "name<TAB>size<TAB>mtime" per entry.
  1137	  _WS4_PRESNAP=""
  1138	  if [[ "$CEREMONY" == "user" ]]; then
  1139	    _WS4_PRESNAP="$(mktemp -t ceo-ws4-presnap-XXXXXX)"
  1140	    for _ws4_e in "$TARGET"/* "$TARGET"/.[!.]* "$TARGET"/..?*; do
  1141	      [[ -e "$_ws4_e" ]] || continue
  1142	      _ws4_b="$(basename "$_ws4_e")"
  1143	      case "$_ws4_b" in
  1144	        .claude|.git) continue ;;
  1145	      esac
  1146	      if [[ -f "$_ws4_e" ]]; then
  1147	        _ws4_sz="$(wc -c < "$_ws4_e" 2>/dev/null | tr -d ' ')"
  1148	        _ws4_mt="$(detect_mtime "$_ws4_e" 2>/dev/null || echo 0)"
  1149	        printf '%s\t%s\t%s\n' "$_ws4_b" "$_ws4_sz" "$_ws4_mt" >> "$_WS4_PRESNAP"
  1150	      else
  1151	        printf '%s\tDIR\t0\n' "$_ws4_b" >> "$_WS4_PRESNAP"
  1152	      fi
  1153	    done
  1154	  fi
  1155	else
  1156	  echo "    (dry-run) would snapshot $TARGET/.claude if present"
  1157	  echo "    (dry-run) would mkdir -p $TARGET/.claude"
  1158	fi
  1159	
  1160	# ---- Helpers ----
  1161	
  1162	# PLAN-120-FOLLOWUP WS-D (E10-F4) — refuse to write through a pre-existing
  1163	# symlinked INTERMEDIATE path component under $TARGET. The leaf $dst is
  1164	# already guarded by the `-L "$dst"` skip below; this closes the gap where
  1165	# e.g. $TARGET/.claude -> /etc would make `mkdir -p` + `cp -R` write under
  1166	# /etc. Walks every component strictly between $TARGET and dirname($dst)
  1167	# and hard-fails (exit 1, picked up by the rollback trap) if any existing
  1168	# component is a symlink. Legitimate `--mode link` installs symlink only
  1169	# the LEAF, never a parent, so this never trips them.
  1170	_assert_no_symlink_parents() {
  1171	  local rel_path="$1"
  1172	  # Only validate paths we write under $TARGET.
  1173	  local parent_rel
  1174	  parent_rel="$( dirname "$rel_path" )"
  1175	  [[ "$parent_rel" == "." ]] && return 0
  1176	  local cur="$TARGET"
  1177	  local comp rest="$parent_rel"
  1178	  # PLAN-185 W1 — the segment walk is now a `case` split, not `IFS='/'` plus an
  1179	  # UNQUOTED `for`. The old form asked for IFS word splitting and silently got
  1180	  # PATHNAME expansion with it, so a component containing `*` was replaced by
  1181	  # whatever it matched in the cwd (or, matching nothing, kept verbatim) — the
  1182	  # walk then tested paths that were not the ones being installed. Same walk as
  1183	  # _wbm_dst_refuses in the shared library, for the same reason.
  1184	  while [[ -n "$rest" ]]; do
  1185	    case "$rest" in
  1186	      */*) comp="${rest%%/*}"; rest="${rest#*/}" ;;
  1187	      *)   comp="$rest";       rest="" ;;
  1188	    esac
  1189	    [[ -z "$comp" || "$comp" == "." ]] && continue
  1190	    cur="$cur/$comp"
  1191	    if [[ -L "$cur" ]]; then
  1192	      echo "::error::refusing install — symlinked path component under target: $cur" >&2
  1193	      echo "::error::an intermediate component of '$rel_path' is a symlink; aborting to avoid write-through escape" >&2
  1194	      exit 1
  1195	    fi
  1196	  done
  1197	  return 0
  1198	}
  1199	
  1200	# The PLAN-185 W1 destination-confinement POLICY (_dst_refuses and friends) used
  1201	# to live here. It now sits immediately after `trap cleanup_on_failure EXIT`,
  1202	# because the global pre-flight has to answer BEFORE the first thing that
  1203	# touches the target — and that thing is `mkdir -p "$TARGET/.claude"`, which
  1204	# runs well above this point.
  1205	
  1206	install_one() {
  1207	  local rel_path="$1"
  1208	  local src="$SOURCE_DIR/$rel_path"
  1209	  local dst="$TARGET/$rel_path"
  1210	
  1211	  # PLAN-166 F3 (ADR-155-AMEND-1): delivery signal for the caller — 1 only
  1212	  # when THIS call actually wrote the destination (COPIED/LINKED). An
  1213	  # EXISTS-skip, a missing source and a dry-run all leave it 0.
  1214	  INSTALL_ONE_WROTE=0
  1215	
  1216	  if [[ ! -e "$src" ]]; then
  1217	    echo "    SKIP (source missing): $rel_path"
  1218	    return
  1219	  fi
  1220	
  1221	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1222	    if [[ -e "$dst" || -L "$dst" ]]; then
  1223	      echo "    (dry-run) EXISTS (would skip): $rel_path"
  1224	    elif [[ "$MODE" == "link" ]]; then
  1225	      echo "    (dry-run) would LINK: $rel_path"
  1226	    else
  1227	      echo "    (dry-run) would COPY: $rel_path"
  1228	    fi
  1229	    return
  1230	  fi
  1231	
  1232	  _assert_no_symlink_parents "$rel_path"
  1233	  mkdir -p "$( dirname "$dst" )"
  1234	
  1235	  if [[ -e "$dst" || -L "$dst" ]]; then
  1236	    echo "    EXISTS (skipping): $rel_path"
  1237	    return
  1238	  fi
  1239	
  1240	  if [[ "$MODE" == "link" ]]; then
  1241	    ln -s "$src" "$dst"
  1242	    INSTALL_ONE_WROTE=1
  1243	    # V5 (repass-r2 part-a): remember every link THIS run created. The
  1244	    # manifest writer exports the exact set as FMS_LINK_PATHS, so the
  1245	    # generator never allow-all serializes a pre-existing adopter symlink
  1246	    # (EXISTS-skipped above, hence NOT in this list) as a LINK delivery.
  1247	    _CREATED_LINK_RELPATHS="${_CREATED_LINK_RELPATHS:-}
  1248	$rel_path"
  1249	    echo "    LINKED: $rel_path"
  1250	  else
  1251	    if [[ -d "$src" ]]; then
  1252	      cp -R "$src" "$dst"
  1253	    else
  1254	      cp "$src" "$dst"
  1255	    fi
  1256	    INSTALL_ONE_WROTE=1
  1257	    echo "    COPIED: $rel_path"
  1258	  fi
  1259	}
