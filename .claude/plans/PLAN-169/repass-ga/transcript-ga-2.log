  2275	    return 0
  2276	  fi
  2277	
  2278	  # jq missing: P2-2 — hard-fail when --stack was explicit; soft-warn otherwise.
  2279	  if [[ "$STACK_EXPLICIT" -eq 1 ]]; then
  2280	    echo "ERROR: jq is required to merge stack hooks for --stack $STACK, but jq was not found." >&2
