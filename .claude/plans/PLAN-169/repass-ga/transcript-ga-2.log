   685	# Fill in deterministic defaults for placeholders now that $TARGET is known.
   686	if [[ -z "$PH_PROJECT_NAME" ]]; then
   687	  PH_PROJECT_NAME="$( basename "$TARGET" )"
   688	fi
   689	if [[ -z "$PH_PROJECT_PATH" ]]; then
   690	  PH_PROJECT_PATH="$TARGET"
   691	fi
   692	if [[ -z "$PH_STACK" ]]; then
   693	  PH_STACK="$STACK"
   694	fi
   695	# PLAN-085 Wave A.5 deterministic default — point PROTOCOL_SOURCE at
   696	# the framework checkout we are installing FROM. Adopters override via
   697	# --protocol-source / CEO_PROTOCOL_SOURCE if their framework lives
   698	# elsewhere post-install. Falling back to $SOURCE_DIR keeps the
   699	# resulting PROTOCOL.md pointer working out-of-the-box (cd into it
   700	# and `git pull` works on day 1).
   701	if [[ -z "$PH_PROTOCOL_SOURCE" ]]; then
   702	  PH_PROTOCOL_SOURCE="$SOURCE_DIR"
   703	fi
