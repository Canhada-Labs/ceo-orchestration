   284	        # PLAN-161 U2 (CF-7): never record framework-internal excluded paths
   285	        # in the baseline — recording them would legitimize a mis-install
   286	        # (and the upgrade would re-add what an adopter deleted by hand).
   287	        if ! _framework_path_excluded "$_fms_out"; then
   288	          printf '%s\n' "$_fms_out"
   289	        fi
   290	      done \
   291	    | LC_ALL=C sort -u
   292	}
   293	
   294	# _write_baseline_manifest — THE single baseline-manifest generator (ADR-155
   295	# decision (iv)). Called by install.sh write_install_manifest AND by upgrade.sh
   296	# after a successful upgrade, so a long-lived adopter who upgrades but never
   297	# re-runs install.sh acquires/refreshes a manifest.
   298	#
   299	# Inputs (callers export these before calling):
   300	#   FMS_ROOT          — the installed target root (paths are relative to it)
   301	#   FMS_PROFILE_PARTS — space-separated profile list (profile-aware enumeration)
   302	#   FMS_MODE          — "link" to emit LINK records for symlinks, else "copy"
   303	# Requires _hash_file (from _hash_lib.sh) on PATH. Writes validated records to
   304	# $1 (the manifest path) atomically. Fail-open: returns 0 with a stderr NOTE on
   305	# any problem; never aborts the caller.
   306	#
   307	# Grammar:
   308	#   <64hex>  <relpath>          — content hash
   309	#   LINK  <relpath>  <target>   — link-mode symlink (content == source)
   310	
   311	# Does FMS_HASH_ROOT apply to this relpath? UNSET FMS_HASH_ROOT_PATHS means
   312	# ALL of them — the upgrade posture, where every enumerated file must record
   313	# what the framework SHIPS. install.sh needs the opposite default for most of
   314	# the tree: it RENDERS templates (`.claude/team.md`, skills, `{{X}}`
   315	# placeholders under --project et al), so those legitimately differ from
   380	    .claude/.framework-version) printf '%s' "${FMS_HASH_SOURCE_MARKER:-}" ;;
   381	    # PLAN-183 W5 (OQ-4, MIXED lane): the RENDERED delivery. Its bytes exist in
   382	    # NO checkout — `sed s/{{OWNER_HANDLE}}/<handle>/` at install.sh:1508
   383	    # produces them — so the route reader has nothing to hash and the
   384	    # non-conditional lane can only DROP it. The conditional lane is the one
   385	    # that can express "the target IS the delivered bytes" (HASH_TARGET on a
   386	    # fresh render) and "carry what was recorded" (HASH_PRIOR_RECORD on
   387	    # continuity), which is exactly the PROTOCOL.md pointer's situation.
   388	    # The 5 VERBATIM routes stay on the non-conditional lane: they have real
   389	    # source bytes and the route reader resolves them.
   390	    .github/CODEOWNERS)         printf '%s' "${FMS_HASH_SOURCE_CODEOWNERS:-}" ;;
   391	    *)                          printf '' ;;
   392	  esac
   393	}
   394	
   395	_wbm_is_conditional() {
   396	  case "$1" in
   397	    SPEC/v1|SPEC/v1/*|PROTOCOL.md|.claude/.framework-version) return 0 ;;
   398	    .github/CODEOWNERS) return 0 ;;
   399	  esac
   400	  return 1
   401	}
