  2630	install_protocol_pointer() {
  2631	  # PLAN-185 W1 (writer 5/7) — ahead of the `-e` test below, which follows
  2632	  # symlinks: a dangling PROTOCOL.md link answered "not installed yet" and the
  2633	  # `>` redirection at the end of this function wrote the rendered pointer
  2634	  # THROUGH it. Refusal is recorded and the run fails at the end; returning 0
  2635	  # here keeps the delivery from aborting mid-flight (nothing restores docs/).
  2630	install_protocol_pointer() {
  2631	  # PLAN-185 W1 (writer 5/7) — ahead of the `-e` test below, which follows
  2632	  # symlinks: a dangling PROTOCOL.md link answered "not installed yet" and the
  2633	  # `>` redirection at the end of this function wrote the rendered pointer
  2634	  # THROUGH it. Refusal is recorded and the run fails at the end; returning 0
  2635	  # here keeps the delivery from aborting mid-flight (nothing restores docs/).
  2636	  if _dst_refuses "PROTOCOL.md"; then
  2637	    return 0
  2638	  fi
  2639	  if [[ -e "$TARGET/PROTOCOL.md" ]]; then
  2640	    return 0
  2641	  fi
  2642	
  2643	  # PLAN-168 W2 (AC-6, Owner decision D1-b): the body comes from the ONE
  2644	  # shared generator in _framework_manifest_set.sh — never a private heredoc.
  2645	  # INV-4 existed because this function and upgrade.sh each carried their own
  2646	  # copy of this text; a silent local fallback would resurrect the class, so
  2647	  # a missing generator is a broken checkout and fails LOUD.
  2648	  #
  2649	  # Relative-path heuristic (unchanged): if $SOURCE_DIR starts with $TARGET,
  2650	  # the framework was copied INTO the target — relative pointer. In ALL other
  2651	  # cases the body is written with the user-editable {{PROTOCOL_SOURCE}}
  2652	  # marker and the placeholder substitution pass below resolves it.
  2653	  command -v _render_protocol_pointer >/dev/null 2>&1 || {
  2654	    echo "    ERROR: _render_protocol_pointer unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot write PROTOCOL.md pointer" >&2
  2655	    return 1
  2656	  }
  2657	
  2658	  if [[ "$DRY_RUN" -eq 1 ]]; then
  2659	    echo "    (dry-run) would CREATE: PROTOCOL.md (pointer)"
  2660	    return 0
  2661	  fi
  2662	
  2663	  case "$SOURCE_DIR" in
  2664	    "$TARGET"/*)
  2665	      _render_protocol_pointer "$SOURCE_DIR" "$TARGET" "$PROFILE" "$STACK" "" > "$TARGET/PROTOCOL.md"
  2666	      ;;
  2667	    *)
  2668	      _render_protocol_pointer_degraded "$TARGET" "$PROFILE" "$STACK" > "$TARGET/PROTOCOL.md"
  2669	      ;;
  2670	  esac
  2671	  echo "    CREATED: PROTOCOL.md (pointer)"
  2672	  _state_record_op "install_protocol_pointer" "PROTOCOL.md"
  2673	  # PLAN-166 F3 (ADR-155-AMEND-1): registered delivery — this line is only
  2674	  # reached when the heredoc actually wrote the pointer (the pre-existing
  2675	  # early-return above never gets here, so an adopter's own root
  2676	  # PROTOCOL.md is never inventoried as framework-owned; r13/r17).
  2677	  _DELIVERED_PROTOCOL=1
  2678	  _state_record_op "delivered_protocol_pointer" "PROTOCOL.md"
  2679	}
