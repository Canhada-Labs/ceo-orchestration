import json, os, sys, tempfile, time
args = sys.argv[1:]
state_path, ops_path, fw_version = args[0], args[1], args[2]
n = int(args[3]); kv = args[4:4 + n]; orig_argv = list(args[4 + n:])
vals = {}; ph = {}
i = 0
while i + 1 < len(kv):
    k, v = kv[i], kv[i + 1]
    if k.startswith("ph."):
        if v != "":
            ph[k[3:]] = v
    else:
        vals[k] = v
