   251	# _framework_manifest_files — expand every target entry into its per-file
   252	# relpaths, relative to FMS_ROOT. Directories are walked (regular files only;
   253	# symlinks are NOT followed into — a symlinked file is emitted as its own
   254	# relpath and the manifest writer records it as a LINK record). EXCLUDES the
   255	# manifest dotfile + .claude.bak/. Sorted + deduped. Missing entries (e.g. a
   256	# profile dir absent on disk) are silently skipped — profile-awareness.
   257	_framework_manifest_files() {
   258	  _fms_root="${FMS_ROOT:-.}"
   259	  {
   260	    _framework_target_entries | while IFS= read -r _fms_entry; do
   261	      [ -n "$_fms_entry" ] || continue
   262	      _fms_abs="$_fms_root/$_fms_entry"
   263	      if [ -f "$_fms_abs" ] || [ -L "$_fms_abs" ]; then
   264	        # A plain file (or symlinked file) target.
   265	        printf '%s\n' "$_fms_entry"
   266	      elif [ -d "$_fms_abs" ]; then
   267	        # Walk the directory for regular files + symlinks. `-print` with a
   268	        # leading "./"-stripped relpath; we re-root each hit at $_fms_entry.
   269	        # bash 3.2-safe: no mapfile; pipe find into a read loop.
   270	        find "$_fms_abs" \( -type f -o -type l \) -print 2>/dev/null | while IFS= read -r _fms_hit; do
   271	          # Strip the "$_fms_root/" prefix to get a repo-relative path.
   272	          _fms_rel="${_fms_hit#"$_fms_root"/}"
   273	          printf '%s\n' "$_fms_rel"
