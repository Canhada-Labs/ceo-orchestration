+    case "$_wbm_sc_rest" in
+      */*) _wbm_sc_seg="${_wbm_sc_rest%%/*}"; _wbm_sc_rest="${_wbm_sc_rest#*/}" ;;
+      *)   _wbm_sc_seg="$_wbm_sc_rest";       _wbm_sc_rest="" ;;
