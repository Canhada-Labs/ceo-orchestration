   251	# _framework_manifest_files — expand every target entry into its per-file
   252	# relpaths, relative to FMS_ROOT. Directories are walked (regular files only;
   253	# symlinks are NOT followed into — a symlinked file is emitted as its own
   254	# relpath and the manifest writer records it as a LINK record). EXCLUDES the
   255	# manifest dotfile + .claude.bak/. Sorted + deduped. Missing entries (e.g. a
   256	# profile dir absent on disk) are silently skipped — profile-awareness.
   257	_framework_manifest_files() {
   258	  _fms_root="${FMS_ROOT:-.}"
   259	  {
   260	    _framework_target_entries | while IFS= read -r _fms_entry; do
   261	      [ -n "$_fms_entry" ] || continue
   262	      _fms_abs="$_fms_root/$_fms_entry"
   263	      if [ -f "$_fms_abs" ] || [ -L "$_fms_abs" ]; then
   264	        # A plain file (or symlinked file) target.
   265	        printf '%s\n' "$_fms_entry"
   266	      elif [ -d "$_fms_abs" ]; then
   267	        # Walk the directory for regular files + symlinks. `-print` with a
   268	        # leading "./"-stripped relpath; we re-root each hit at $_fms_entry.
   269	        # bash 3.2-safe: no mapfile; pipe find into a read loop.
   270	        find "$_fms_abs" \( -type f -o -type l \) -print 2>/dev/null | while IFS= read -r _fms_hit; do
   271	          # Strip the "$_fms_root/" prefix to get a repo-relative path.
   272	          _fms_rel="${_fms_hit#"$_fms_root"/}"
   273	          printf '%s\n' "$_fms_rel"
   274	        done
   275	      fi
   276	      # else: entry absent on disk for this profile — skip (profile-aware).
   277	    done
   278	  } | grep -v -e '^\.claude/\.install-manifest\.sha256$' \
   279	            -e '^\.claude\.bak/' \
   280	            -e '/\.claude\.bak/' \
   281	            -e '/__pycache__/' \
   282	            -e '\.pyc$' \
   283	    | while IFS= read -r _fms_out; do
   284	        # PLAN-161 U2 (CF-7): never record framework-internal excluded paths
   285	        # in the baseline — recording them would legitimize a mis-install
   286	        # (and the upgrade would re-add what an adopter deleted by hand).
   287	        if ! _framework_path_excluded "$_fms_out"; then
   288	          printf '%s\n' "$_fms_out"
   289	        fi
   290	      done \
   291	    | LC_ALL=C sort -u
   292	}
   293	
   294	# _write_baseline_manifest — THE single baseline-manifest generator (ADR-155
   295	# decision (iv)). Called by install.sh write_install_manifest AND by upgrade.sh
   296	# after a successful upgrade, so a long-lived adopter who upgrades but never
   297	# re-runs install.sh acquires/refreshes a manifest.
   298	#
   299	# Inputs (callers export these before calling):
   300	#   FMS_ROOT          — the installed target root (paths are relative to it)
   301	#   FMS_PROFILE_PARTS — space-separated profile list (profile-aware enumeration)
   302	#   FMS_MODE          — "link" to emit LINK records for symlinks, else "copy"
   303	# Requires _hash_file (from _hash_lib.sh) on PATH. Writes validated records to
   304	# $1 (the manifest path) atomically. Fail-open: returns 0 with a stderr NOTE on
   305	# any problem; never aborts the caller.
   306	#
   307	# Grammar:
   308	#   <64hex>  <relpath>          — content hash
   309	#   LINK  <relpath>  <target>   — link-mode symlink (content == source)
   310	
   311	# Does FMS_HASH_ROOT apply to this relpath? UNSET FMS_HASH_ROOT_PATHS means
   312	# ALL of them — the upgrade posture, where every enumerated file must record
   313	# what the framework SHIPS. install.sh needs the opposite default for most of
   314	# the tree: it RENDERS templates (`.claude/team.md`, skills, `{{X}}`
   315	# placeholders under --project et al), so those legitimately differ from
   316	# source and their baseline must be the rendered TARGET. A global
   317	# FMS_HASH_ROOT on an install rerun rewrote every rendered file's hash to the
   318	# unrendered source, which doctor.sh reads as widespread adopter drift and
   319	# later upgrades read as customized => the files stop being refreshed (codex
   320	# W1 round 8, P1). Scoping the override to the ownership-continuity paths
   321	# keeps the round-5 fix (an EDITED delivered SPEC must not be re-baselined as
   322	# framework-owned, or uninstall would delete the adopter's fork) without
   323	# touching the rendered tree. Prefix match: an entry covers the path itself
   324	# and everything under it.
   325	_wbm_hash_root_applies() {
   326	  [ -n "${FMS_HASH_ROOT_PATHS:-}" ] || return 0
   327	  _hra_rel="$1"
   328	  _hra_oldIFS="$IFS"
   329	  IFS='
   330	'
   331	  for _hra_p in $FMS_HASH_ROOT_PATHS; do
   332	    [ -n "$_hra_p" ] || continue
   333	    case "$_hra_rel" in
   334	      "$_hra_p"|"$_hra_p"/*)
   335	        IFS="$_hra_oldIFS"
   336	        return 0
   337	        ;;
   338	    esac
   339	  done
   340	  IFS="$_hra_oldIFS"
   341	  return 1
   342	}
   343	
   344	# May this relpath be serialized as a LINK record? UNSET FMS_LINK_PATHS means
   345	# ANY live symlink may — correct on the INSTALL path, where the installer
   346	# itself created every symlink it is about to record. On the UPGRADE rewrite
   347	# that default is too wide (codex W1 round 10, P2): FMS_MODE=link is inferred
   348	# from the presence of ANY prior LINK record, and every live symlink then
   349	# serializes as a delivery record — including an adopter's OWN symlink
   350	# preserved inside an enumerated directory like `.claude/hooks/`, converting
   351	# an unowned path into framework-managed content that doctor.sh polices.
   352	# upgrade.sh passes the exact set of pre-upgrade LINK relpaths instead.
   353	_wbm_link_allowed() {
   354	  [ -n "${FMS_LINK_PATHS:-}" ] || return 0
   355	  _wla_rel="$1"
   356	  _wla_oldIFS="$IFS"
   357	  IFS='
   358	'
   359	  for _wla_p in $FMS_LINK_PATHS; do
   360	    [ -n "$_wla_p" ] || continue
   361	    if [ "$_wla_rel" = "$_wla_p" ]; then
   362	      IFS="$_wla_oldIFS"
   363	      return 0
   364	    fi
   365	  done
   366	  IFS="$_wla_oldIFS"
   367	  return 1
   368	}
   369	
   370	# --- PLAN-167 W2.3: the DECISION reaches the generator ----------------------
   371	# _ownership_verdict chooses a hash_source per conditional surface; the writer
   372	# obeys it instead of falling back to a default. Across all 62 rows of the
   373	# table the default (HASH_TARGET) is never the correct answer, and it is
   374	# exactly what let three P1 defects re-baseline adopter content as
   375	# framework-owned (docs §3.4).
   376	_wbm_declared_hash_source() {
   377	  case "$1" in
   378	    SPEC/v1|SPEC/v1/*)          printf '%s' "${FMS_HASH_SOURCE_SPEC:-}" ;;
   379	    PROTOCOL.md)                printf '%s' "${FMS_HASH_SOURCE_PROTOCOL:-}" ;;
   380	    .claude/.framework-version) printf '%s' "${FMS_HASH_SOURCE_MARKER:-}" ;;
   381	    # PLAN-183 W5 (OQ-4, MIXED lane): the RENDERED delivery. Its bytes exist in
   382	    # NO checkout — `sed s/{{OWNER_HANDLE}}/<handle>/` at install.sh:1508
   383	    # produces them — so the route reader has nothing to hash and the
   384	    # non-conditional lane can only DROP it. The conditional lane is the one
   385	    # that can express "the target IS the delivered bytes" (HASH_TARGET on a
   386	    # fresh render) and "carry what was recorded" (HASH_PRIOR_RECORD on
   387	    # continuity), which is exactly the PROTOCOL.md pointer's situation.
   388	    # The 5 VERBATIM routes stay on the non-conditional lane: they have real
   389	    # source bytes and the route reader resolves them.
   390	    .github/CODEOWNERS)         printf '%s' "${FMS_HASH_SOURCE_CODEOWNERS:-}" ;;
   391	    *)                          printf '' ;;
   392	  esac
   393	}
   394	
   395	_wbm_is_conditional() {
   396	  case "$1" in
   397	    SPEC/v1|SPEC/v1/*|PROTOCOL.md|.claude/.framework-version) return 0 ;;
   398	    .github/CODEOWNERS) return 0 ;;
   399	  esac
   400	  return 1
   401	}
   402	
   403	# --- PLAN-183 W5 (D3): the THIRD reader of the shared delivery-route table --
   404	# Defect D3: this generator resolved every framework path as "$root/$rel",
   405	# which assumes the SOURCE relpath equals the DESTINATION relpath. That is
   406	# false for every route install.sh delivers out of `templates/` — on the
   407	# upgrade path (FMS_HASH_ROOT=$SOURCE_DIR) `docs/BRANCH-PROTECTION.md` hashes
   408	# the ROOT HOMONYM (wrong bytes recorded as the framework baseline) and
   409	# `.github/*.template` hits the `continue` and vanishes from the baseline in
   410	# SILENCE. The route table is the one place that answers "which source is
   411	# this destination?"; a local branch here would re-open the class CLAUDE.md §4
   412	# closed twice already (PLAN-182 16 modules -> one resolver; PLAN-167
   413	# _ownership_verdict).
   414	#
   415	# Same table, same idiom as scripts/doctor.sh:_route_source and
   416	# scripts/tests/_parity_classify.py. bash 3.2 floor: no `declare -A`, so the
   417	# lookup is a linear scan over ~7 rows. Skip guards act on the FIRST FIELD
   418	# only (the ownership_table.tsv idiom).
   419	#
   420	# rc 0 = identity route, source relpath on stdout
   421	# rc 1 = no row for this destination (the normal case for every framework
   422	#        path that IS identity-mapped: callers keep today's behaviour)
   423	# rc 2 = RENDERED, or the row is malformed => there are no framework source
   424	#        bytes to hash. Fail-CLOSED (CLAUDE.md §4: fail-open on
   425	#        infrastructure, fail-closed on INPUT). `${_wbm_rs_transform:-}` is
   426	#        deliberately an unbraced-default-EMPTY: `:-identity` was the rail
   427	#        S325 fail-OPEN finding that let a truncated row be treated as
   428	#        copyable.
   429	#
   430	# --- rail round-6 F3: the table has ONE source — the running checkout ------
   430	# --- rail round-6 F3: the table has ONE source — the running checkout ------
   431	# The table sits NEXT TO this library (scripts/). Both callers source it via
   432	# an absolute $SCRIPT_DIR (install.sh:251, upgrade.sh:95), so BASH_SOURCE is
   433	# absolute and the lookup never depends on the caller's cwd.
   434	#
   435	# It is resolved UNCONDITIONALLY here, which is the point: this assignment
   436	# CLOBBERS any inherited value, so the environment is not a channel into a
   437	# table that drives WRITES (upgrade delivers into $TARGET, doctor --repair
   438	# copies into it).
   439	#
   440	# WHAT ROUND 6 REMOVED AND WHY. Round 5 kept an environment override behind a
   441	# test switch (an opt-in variable plus a candidate path physically under
   442	# ${TMPDIR:-/tmp}). Both conditions are readable and writable by anyone who
   443	# can influence the environment of an upgrade — setting TMPDIR is the same
   444	# gesture as setting the table — so the pair was never a production trust
   445	# boundary; it was a fixture loader living inside a production entrypoint. The
   446	# cure is not a stronger switch (that class regenerates: see round 3 F1 and
   447	# PLAN-185 W0) but the REMOVAL of the mechanism. Fixtures are now exercised the
   448	# way a real run is: against a COPIED framework tree whose own
   449	# scripts/delivery-routes.tsv is the fixture — the copy's library reads the
   450	# copy's table because BASH_SOURCE says so.
   451	#
   452	# The variable is deliberately NOT named FMS_*: every FMS_* name in this file
   453	# is an input knob a caller may set (FMS_ROOT, FMS_HASH_ROOT, FMS_PRIOR_MANIFEST,
   454	# FMS_DELIVERED_TEMPLATES), and keeping that prefix would invite the next
   455	# author to re-open the channel. `_WBM_ROUTES_TSV` is internal state.
   456	#
   457	# ONE in-process re-point survives, by design and with exactly one production
   458	# user: upgrade.sh copies the table's BYTES to a snapshot before a `--pin`
   459	# checkout can move the source tree, then assigns this variable (rail round-2
   460	# F2). That is code running in the process after sourcing, not an environment
   461	# read; the oracles assert that no THIRD production assignment exists.
   462	_FMS_LIB_DIR="$( dirname "${BASH_SOURCE[0]:-$0}" )"
   463	_WBM_ROUTES_TSV="$_FMS_LIB_DIR/delivery-routes.tsv"
   464	
   465	# --- rail round-1 F2: the table is UNTRUSTED INPUT -------------------------
   466	# The table is a FILE, and a file is input even when it ships with the code: a
   467	# partial checkout, a bad merge or a tampered tree all reach these fields, and
   468	# every field reaches a filesystem path. Round 6 removed the environment
   469	# channel (above); it did NOT make the CONTENT trusted — the validators below
   470	# are what a row has to satisfy, wherever the bytes came from.
   471	# MEASURED pre-cure, S327: a row with
   472	# `dest=../../outside/PWNED.md` was accepted rc=0 by both readers and
   473	# upgrade.sh's `_up_deliver_template` wrote 536 bytes to
   474	# `$TARGET/../../outside/PWNED.md` — a real write outside the requested
   475	# target, before any ownership gate. A row with `src=../../../../etc/passwd`
   476	# reached `cp "$SOURCE_DIR/$src"` the same way, delivering foreign bytes as
   477	# framework content.
   478	#
   479	# A relpath is VALID only when it is: non-empty; RELATIVE (no leading `/`);
   480	# free of any `..` segment (leading, embedded or trailing); free of a leading
   481	# `./`; free of `//`; free of backslashes; and free of whitespace and control
   482	# characters. The predicate ENUMERATES what is acceptable and rejects
   483	# everything else — the "declare the safe forms, not the unsafe ones"
   484	# architecture PLAN-185 W0 arrived at after the same class regenerated three
   485	# times under review.
   486	#
   487	# Deliberately NOT a realpath() check: the fields name paths that do not exist
   488	# yet (a fresh INSTALL destination), so lexical confinement is the only
   489	# property available at read time. The physical confinement assertion lives at
   490	# the write site in upgrade.sh (_up_tpl_confined), belt and braces.
   491	#
   492	# rail round-3 F1: GLOB METACHARACTERS are rejected too. MEASURED pre-cure
   493	# (S327): `FMS_DELIVERED_TEMPLATES='docs/*'` passed this predicate — the entry
   494	# was pathname-EXPANDED by the consumer before it ever got here, so what the
   495	# predicate saw was `docs/ACCELERATORS.md`, a perfectly confined relpath. 125
   496	# unrelated adopter files entered the baseline as framework-owned, which a
   497	# manifest-honouring uninstall deletes on a hash match. The expansion itself is
   498	# killed at the consumer (`set -f` + a quoted read loop), but a path that
   499	# CONTAINS a glob metacharacter is also not a path this framework ever ships,
   500	# so refusing it here is the second, order-independent wall.
   501	_wbm_route_relpath_ok() {
   502	  case "${1:-}" in
   503	    "")            return 1 ;;   # empty
   504	    /*)            return 1 ;;   # absolute
   505	    ./*)           return 1 ;;   # leading ./
   506	    ..|../*)       return 1 ;;   # leading ..
   507	    */../*)        return 1 ;;   # embedded ..
   508	    */..)          return 1 ;;   # trailing ..
   509	    *//*)          return 1 ;;   # empty segment
   510	    *\\*)          return 1 ;;   # backslash
   511	    *\**)          return 1 ;;   # glob metacharacter *
   512	    *\?*)          return 1 ;;   # glob metacharacter ?
   513	    *\[*)          return 1 ;;   # glob metacharacter [
   514	    *\]*)          return 1 ;;   # glob metacharacter ]
   515	    *[[:space:]]*) return 1 ;;   # whitespace (incl. tab/newline)
   516	    *[[:cntrl:]]*) return 1 ;;   # control characters
   517	  esac
   518	  return 0
   519	}
   520	
   521	# --- rail round-5 F1: the DELIVERY DOMAIN, fixed in CODE -------------------
   522	# The table says HOW to route; this says WHERE delivery may EVER write.
   523	#
   524	# WHY THIS EXISTS: `_wbm_route_dest_declared` (round 3) is a whitelist of
   525	# declared destinations, but it reads the SAME table it is meant to constrain —
   526	# so a well-formed hostile table simply declares its own destinations and the
   527	# whitelist agrees with it. MEASURED pre-cure (S327): a row
   528	# `.git/hooks/pre-commit <- scripts/install.sh, identity` passed every lexical
   529	# gate, kept `routes == rows`, was copied into the absent destination, was
   530	# recorded in the manifest, and the upgrade exited 0. A confined relative path
   531	# is not the same property as a path this framework is allowed to deliver.
   532	#
   533	# The domain is a CODE constant, unreachable from any input: destinations live
   534	# under `docs/` or `.github/` — the two trees this wave delivers, by design
   535	# (ADR-194 §1/§4) — and sources live under `templates/`. All six shipped routes
   536	# satisfy it; widening it is an ADR amendment, not a table edit.
   537	#
   538	# rail round-7 F1 — "under .github/" is NOT the property this wave needs, and
   539	# MEASURED pre-cure (S327) the whole tree was in domain: `.github/dependabot.yml`,
   540	# `.github/workflows/pwn.yml` and, worst, `.github/workflows/validate.yml`
   541	# ACCEPTED. That last one is the shipped `validate.yml.template` route with four
   542	# characters removed from its destination: delivery would then write a LIVE
   543	# workflow into the adopter, contradicting the table's own `note` ("the adopter
   544	# never gets a live workflow from install") while the upgrade exits 0.
   545	# So the domain enumerates the INERT FORMS instead of a subtree:
   546	#   docs/<name>.md                    — one segment, Markdown, inert by content;
   547	#   .github/CODEOWNERS                — the rendered route (not executable);
   548	#   .github/CODEOWNERS.template       — its mutually exclusive twin;
   549	#   .github/workflows/<name>.template — one segment under workflows/, and the
   550	#                                       `.template` suffix is what keeps GitHub
   551	#                                       Actions from ever loading the file.
   552	# Nothing else — no second segment, no other basename, no other extension.
   553	# This is the same inversion round 3 F1 and PLAN-185 W0 already paid for:
   554	# enumerate what is PROVEN safe, classify the rest as refused. Widening it is
   555	# an ADR-194 amendment, never a table edit.
   556	#
   557	# $1 = destination relpath. $2 = source relpath, OPTIONAL: the write site holds
   558	# only the destination, and passing an EMPTY $2 is a rejection (not a skip), so
   559	# the one-argument form is the only way to check the destination alone.
   560	# rc 0 = inside the domain.
   561	_wbm_route_domain_ok() {
   562	  case "${1:-}" in
   563	    docs/*)
   564	      _wbm_rd_leaf="${1#docs/}"
   565	      case "$_wbm_rd_leaf" in
   566	        ""|*/*) return 1 ;;   # empty, or more than one segment
   567	        .md)    return 1 ;;   # ".md" is an extension, not a name
   568	        *.md)   ;;
   569	        *)      return 1 ;;
   570	      esac
   571	      ;;
   572	    .github/CODEOWNERS|.github/CODEOWNERS.template) ;;
   573	    .github/workflows/*)
   574	      _wbm_rd_leaf="${1#.github/workflows/}"
   575	      case "$_wbm_rd_leaf" in
   576	        ""|*/*)     return 1 ;;   # empty, or nested under workflows/
   577	        .template)  return 1 ;;   # bare suffix, no workflow name
   578	        *.template) ;;
   579	        *)          return 1 ;;   # anything GitHub Actions would LOAD
   580	      esac
   581	      ;;
   582	    *) return 1 ;;
   583	  esac
   584	  if [ "$#" -ge 2 ]; then
   585	    case "${2:-}" in
   586	      templates/?*) ;;
   587	      *) return 1 ;;
   588	    esac
   589	  fi
   590	  return 0
   591	}
   592	
   593	# --- rail round-7 F2: PHYSICAL confinement of the SOURCE --------------------
   594	# The destination side has had physical confinement since round 1 F2; the
   595	# SOURCE side had only the lexical predicate, and `[ -f ]`, `cp`, `cat` and
   596	# `sha256` all FOLLOW symlinks. MEASURED pre-cure (S327): with
   597	# `templates/docs/BRANCH-PROTECTION.md` a symlink to a regular file outside the
   598	# checkout, `[ -f ]` answered true and the delivered bytes hashed IDENTICAL to
   599	# the foreign file — foreign content installed into an adopter tree as
   600	# framework content, with the manifest then recording it as framework-owned.
   601	# A symlinked ANCESTOR (`templates/docs -> /elsewhere`) does the same thing and
   602	# passes every per-path lexical check.
   603	#
   604	# Two independent walls, both required:
   605	#   1. NO SYMLINK COMPONENT — every component of $2 under the physical root is
   606	#      tested with `-L`, leaf included. A real checkout of this framework has
   607	#      ZERO symlinks (measured: 0 under templates/, .claude/, docs/, and 0 in
   608	#      the whole tree excluding .git), so this costs production nothing.
   609	#   2. PHYSICAL CONTAINMENT — the deepest EXISTING ancestor of the source must
   610	#      resolve (cd -P/pwd -P; the bash 3.2 floor has no realpath) under the
   611	#      PHYSICALLY resolved root. "Deepest existing", not "the parent", so a
   612	#      source that is simply ABSENT — the `--pin` lane, where the destination
   613	#      list is this upgrader's and the sources are the pin's — still reaches
   614	#      its caller's `-f` test and keeps its "SKIPPED (source missing)" verdict
   615	#      instead of being renamed into a confinement refusal.
   616	#
   617	# $1 = source root (absolute). $2 = source relpath.
   618	# rc 0 = usable. rc 1 = refuse, with the reason in _WBM_SRC_CONFINE_WHY (a
   619	# refusal nobody can NAME is the silence D3 was made of).
   620	_WBM_SRC_CONFINE_WHY=""
   621	_wbm_source_confined() {
   622	  _WBM_SRC_CONFINE_WHY=""
   623	  _wbm_sc_root="${1:-}"
   624	  _wbm_sc_rel="${2:-}"
   625	  if [ -z "$_wbm_sc_root" ] || [ -z "$_wbm_sc_rel" ]; then
   626	    _WBM_SRC_CONFINE_WHY="empty source root or source relpath"
   627	    return 1
   628	  fi
   629	  if ! _wbm_route_relpath_ok "$_wbm_sc_rel"; then
   630	    _WBM_SRC_CONFINE_WHY="'$_wbm_sc_rel' is not a confined relative path"
   631	    return 1
   632	  fi
   633	  # `|| true` is load-bearing under `set -euo pipefail`: a failing `cd -P`
   634	  # would abort the caller instead of reaching the named refusal below.
   635	  _wbm_sc_phys="$( cd -P "$_wbm_sc_root" 2>/dev/null && pwd -P || true )"
   636	  if [ -z "$_wbm_sc_phys" ]; then
   637	    _WBM_SRC_CONFINE_WHY="the source root '$_wbm_sc_root' does not resolve"
   638	    return 1
   639	  fi
   640	  _wbm_sc_walk="$_wbm_sc_phys"
   641	  _wbm_sc_rest="$_wbm_sc_rel"
   642	  while [ -n "$_wbm_sc_rest" ]; do
   643	    case "$_wbm_sc_rest" in
   644	      */*) _wbm_sc_seg="${_wbm_sc_rest%%/*}"; _wbm_sc_rest="${_wbm_sc_rest#*/}" ;;
   645	      *)   _wbm_sc_seg="$_wbm_sc_rest";       _wbm_sc_rest="" ;;
   646	    esac
   647	    _wbm_sc_walk="$_wbm_sc_walk/$_wbm_sc_seg"
   648	    if [ -L "$_wbm_sc_walk" ]; then
   649	      _WBM_SRC_CONFINE_WHY="component '$_wbm_sc_seg' of '$_wbm_sc_rel' is a symlink — reading it would deliver bytes from outside the checkout"
   650	      return 1
   651	    fi
   652	  done
   653	  _wbm_sc_anc="$( dirname "$_wbm_sc_phys/$_wbm_sc_rel" )"
   654	  while [ -n "$_wbm_sc_anc" ] && [ ! -d "$_wbm_sc_anc" ]; do
   655	    _wbm_sc_next="$( dirname "$_wbm_sc_anc" )"
   656	    [ "$_wbm_sc_next" != "$_wbm_sc_anc" ] || break
   657	    _wbm_sc_anc="$_wbm_sc_next"
   658	  done
   659	  _wbm_sc_res="$( cd -P "$_wbm_sc_anc" 2>/dev/null && pwd -P || true )"
   660	  if [ -z "$_wbm_sc_res" ]; then
   661	    _WBM_SRC_CONFINE_WHY="the nearest existing ancestor of '$_wbm_sc_rel' does not resolve"
   662	    return 1
   663	  fi
   664	  case "$_wbm_sc_res" in
   665	    "$_wbm_sc_phys"|"$_wbm_sc_phys"/*) return 0 ;;
   666	  esac
   667	  _WBM_SRC_CONFINE_WHY="'$_wbm_sc_rel' resolves to $_wbm_sc_res, outside the source checkout $_wbm_sc_phys"
   668	  return 1
   669	}
   670	
   671	# --- PLAN-185 W1: DESTINATION confinement ----------------------------------
   672	# The link count of a path, or EMPTY when it cannot be read.
   673	#
   674	# Moved here from upgrade.sh's _up_tpl_nlink (which now consumes it) so that
   675	# ONE implementation answers "how many names does this inode have?" for both
   676	# sides of the delivery. Two copies of a confinement primitive drifting apart
   677	# is the exact mechanism of PLAN-183 D1-D4, six sessions of red main.
   678	#
   679	# GNU-first with the output VALIDATED, because on GNU `stat -f` SUCCEEDS
   680	# printing FILESYSTEM information rather than failing; `ls -ld` is the last
   681	# resort. An EMPTY answer means the infrastructure could not tell us, and
   682	# CLAUDE.md §4 makes that fail-OPEN: the caller does not refuse on it.
   683	_wbm_nlink() {
   684	  # `|| true` is load-bearing under `set -euo pipefail`: a failing pipeline
   685	  # inside a command substitution makes the ASSIGNMENT fail, which aborts the
   686	  # caller instead of falling through to the empty-answer path below.
   687	  _wbm_nl_out="$( stat -c '%h' "$1" 2>/dev/null || stat -f '%l' "$1" 2>/dev/null || true )"
   688	  case "$_wbm_nl_out" in
   689	    ''|*[!0-9]*) _wbm_nl_out="$( ls -ld "$1" 2>/dev/null | awk 'NR==1 {print $2}' || true )" ;;
   690	  esac
   691	  case "$_wbm_nl_out" in
   692	    ''|*[!0-9]*) printf '' ;;
   693	    *)           printf '%s\n' "$_wbm_nl_out" ;;
   694	  esac
   695	}
   696	
   697	# Is this destination one the installer may write? The mirror of
   698	# _wbm_source_confined, on the side that WRITES.
   699	#
   700	# WHY THIS EXISTS: install.sh decides whether to write by testing the
   701	# destination for EXISTENCE, and `-e` FOLLOWS symlinks. A DANGLING link planted
   702	# at a destination answers false, so the writer takes the "nothing there yet"
   703	# branch and `cp`/`>` write THROUGH the link, outside $TARGET. MEASURED
   704	# pre-cure (S329) against the live installer: with `docs/rotation-log.md` a
   705	# dangling symlink to a path outside the target, a `--ceremony maintainer`
   706	# install exited 0, logged `COPIED:`, and 536 bytes landed at the external
   707	# path. A RESOLVED link and a symlinked ANCESTOR escape the same way; a HARD
   708	# LINK escapes while every path check passes, because a second name for one
   709	# inode is not a link any path walk can see.
   710	#
   711	# Three walls, all required:
   712	#   1. LEXICAL — the relpath must be confined, through the same
   713	#      _wbm_route_relpath_ok every other confined path in this library uses
   714	#      (absolute, `..`, empty segment, glob metacharacter, whitespace).
   715	#   2. NO SYMLINK COMPONENT — every component under the physical target root is
   716	#      tested with `-L`, leaf INCLUDED. `-L` is true for a DANGLING link, which
   717	#      is precisely the form the `-e` guard is blind to.
   718	#   3. PHYSICAL CONTAINMENT — the deepest EXISTING ancestor must resolve
   719	#      (cd -P/pwd -P; the bash 3.2 floor has no realpath) under the physically
   720	#      resolved root.
   721	# Plus two properties of the LEAF that walls 1-3 cannot express: an existing
   722	# leaf must be a REGULAR FILE or a DIRECTORY, and it must not carry a second
   723	# hard link. Refusing every OTHER file type is the PLAN-185 W0 inversion
   724	# applied here — enumerate the forms proven safe to write, refuse the rest —
   725	# so a fifo or a device node at a destination is a named refusal rather than a
   726	# form nobody modelled.
   727	#
   728	# POLICY IS NOT HERE (debate C5). This answers "must this destination be
   729	# refused?" and publishes the reason; whether that means FAIL, SKIP or
   730	# ACCUMULATE belongs to the caller — install_one keeps the EXISTS-skip its
   731	# tests fix, while the delivery writers accumulate a named refusal and fail the
   732	# run at the end.
   733	#
   734	# TOCTOU, declared: between this answer and the write, nothing prevents the
   735	# destination from BECOMING a symlink. bash offers no openat/O_NOFOLLOW, so the
   736	# window is irreducible — this narrows it, it does not close it.
   737	#
   738	# $1 = target root (absolute). $2 = destination relpath.
   739	# rc 0 = REFUSE the write, reason in _WBM_DST_REFUSE_WHY. rc 1 = confined.
   740	# The polarity is the one _install_src_refuses and _up_tpl_multilink_refuses
   741	# already use: the function is named for what a 0 MEANS.
   742	_WBM_DST_REFUSE_WHY=""
   743	# Structural check shared by the destination guard and the upgrader's early
   744	# delivery preflight. Callers validate the relative path first. Inspect only
   745	# STRICT ancestors: an absent directory can be created, but a regular file,
   746	# FIFO or other non-directory cannot be traversed by mkdir — and neither can
   747	# a symlink that does not RESOLVE to a directory (dangling, or pointing at a
   748	# file): `-e`/`-d` follow the link, so those two shapes are refused here too.
   749	# A symlink that resolves to a directory is NOT this helper's call — that
   750	# policy stays with each caller's existing confinement guard (the full
   751	# destination predicate refuses every symlink component; the forced SPEC/v1
   752	# route accepts a `--mode link` leaf). Pre-cure the `! -L` test skipped every
   753	# symlink, so `SPEC -> file` passed both preflights and the run aborted at
   754	# `mkdir` with the target already written (Codex review of the cure).
   755	_wbm_dst_non_directory_ancestor_refuses() {
   756	  local rel="$2" rest="$2" walk="$1" seg
   757	  _WBM_DST_REFUSE_WHY=""
   758	  while :; do
   759	    case "$rest" in
   760	      */*) seg="${rest%%/*}"; rest="${rest#*/}" ;;
   761	      *) break ;;
   762	    esac
   763	    walk="$walk/$seg"
   764	    if [ -L "$walk" ] && [ ! -e "$walk" ]; then
   765	      _WBM_DST_REFUSE_WHY="'$walk' is a DANGLING symlink — a non-directory ancestor of '$rel'; the destination cannot be created"
   766	      return 0
   767	    fi
   768	    if [ -e "$walk" ] && [ ! -d "$walk" ]; then
   769	      _WBM_DST_REFUSE_WHY="'$walk' is a non-directory ancestor of '$rel' — the destination cannot be created"
   770	      return 0
   771	    fi
   772	  done
   773	  return 1
   774	}
   775	
   776	_wbm_dst_refuses() {
   777	  _WBM_DST_REFUSE_WHY=""
   778	  _wbm_dr_root="${1:-}"
   779	  _wbm_dr_rel="${2:-}"
   780	  if [ -z "$_wbm_dr_root" ] || [ -z "$_wbm_dr_rel" ]; then
   781	    _WBM_DST_REFUSE_WHY="empty target root or destination relpath"
   782	    return 0
   783	  fi
   784	  if ! _wbm_route_relpath_ok "$_wbm_dr_rel"; then
   785	    _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' is not a confined relative path"
   786	    return 0
   787	  fi
   788	  # An ABSENT target root is not a refusal (rail round-1 P2). Nothing exists
   789	  # under a directory that does not exist, so there is no component to follow
   790	  # and nothing to escape through — the lexical wall above has already done the
   791	  # only work available. Refusing here instead broke `install.sh --dry-run`
   792	  # against a target that does not exist yet, which is SUPPORTED behaviour
   793	  # (preview without creating): measured pre-cure, 12 destinations came back
   794	  # "does not resolve" and the run exited 1.
   795	  #
   796	  # The ROOT is tested for being a symlink BEFORE it is resolved (rail round-2
   797	  # P1). The previous order asked `! -e` first, so only a DANGLING root was ever
   798	  # tested with `-L`: a RESOLVED symlink root answered `-e` true, fell through to
   799	  # `cd -P`, and silently moved the confinement BASE to the referent. MEASURED:
   800	  # with the target passed as a symlink to a real directory, the install ran to
   801	  # completion, 567 files landed under the referent and zero landed anywhere
   802	  # else — so containment held, but the comment here claimed a refusal that the
   803	  # code did not perform, and `install.sh` resolves the target with plain
   804	  # `cd`/`pwd` (LOGICAL path, symlink preserved), so the case is reachable on
   805	  # every real install.
   806	  #
   807	  # It is a REFUSAL, not a warning, and the reason carries the recovery: the
   808	  # operator re-runs against the referent. That keeps the gate fail-closed while
   809	  # costing a legitimate symlinked project directory exactly one re-run with the
   810	  # path the message prints — and it makes the dereference an explicit choice
   811	  # instead of something the installer did on the operator's behalf without
   812	  # saying so. Note `-L` tests only the LAST component, so an ordinary path that
   813	  # merely traverses a symlinked ancestor (/tmp -> /private/tmp on macOS) is
   814	  # unaffected.
   815	  if [ -L "$_wbm_dr_root" ]; then
   816	    _wbm_dr_ref="$( cd -P "$_wbm_dr_root" 2>/dev/null && pwd -P || true )"
   817	    if [ -n "$_wbm_dr_ref" ]; then
   818	      _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' is a SYMLINK to '$_wbm_dr_ref' — every write would follow it; re-run against '$_wbm_dr_ref' if that is the directory you meant"
   819	    else
   820	      _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' is a DANGLING symlink — every write under it would follow the link outside the target"
   821	    fi
   822	    return 0
   823	  fi
   824	  if [ ! -e "$_wbm_dr_root" ]; then
   825	    return 1
   826	  fi
   827	  _wbm_dr_phys="$( cd -P "$_wbm_dr_root" 2>/dev/null && pwd -P || true )"
   828	  if [ -z "$_wbm_dr_phys" ]; then
   829	    _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' exists but does not resolve to a directory"
   830	    return 0
   831	  fi
   832	  if _wbm_dst_non_directory_ancestor_refuses "$_wbm_dr_phys" "$_wbm_dr_rel"; then
   833	    return 0
   834	  fi
   835	  _wbm_dr_walk="$_wbm_dr_phys"
   836	  _wbm_dr_rest="$_wbm_dr_rel"
   837	  while [ -n "$_wbm_dr_rest" ]; do
   838	    case "$_wbm_dr_rest" in
   839	      */*) _wbm_dr_seg="${_wbm_dr_rest%%/*}"; _wbm_dr_rest="${_wbm_dr_rest#*/}" ;;
   840	      *)   _wbm_dr_seg="$_wbm_dr_rest";       _wbm_dr_rest="" ;;
   841	    esac
   842	    _wbm_dr_walk="$_wbm_dr_walk/$_wbm_dr_seg"
   843	    if [ -L "$_wbm_dr_walk" ]; then
   844	      if [ -e "$_wbm_dr_walk" ]; then
   845	        _WBM_DST_REFUSE_WHY="component '$_wbm_dr_seg' of '$_wbm_dr_rel' is a symlink — the write would follow it outside the target"
   846	      else
   847	        _WBM_DST_REFUSE_WHY="component '$_wbm_dr_seg' of '$_wbm_dr_rel' is a DANGLING symlink — the existence test guarding this write answers false and the write follows the link outside the target"
   848	      fi
   849	      return 0
   850	    fi
   851	  done
   852	  _wbm_dr_anc="$( dirname "$_wbm_dr_phys/$_wbm_dr_rel" )"
   853	  while [ -n "$_wbm_dr_anc" ] && [ ! -d "$_wbm_dr_anc" ]; do
   854	    _wbm_dr_next="$( dirname "$_wbm_dr_anc" )"
   855	    [ "$_wbm_dr_next" != "$_wbm_dr_anc" ] || break
   856	    _wbm_dr_anc="$_wbm_dr_next"
   857	  done
   858	  _wbm_dr_res="$( cd -P "$_wbm_dr_anc" 2>/dev/null && pwd -P || true )"
   859	  if [ -z "$_wbm_dr_res" ]; then
   860	    _WBM_DST_REFUSE_WHY="the nearest existing ancestor of '$_wbm_dr_rel' does not resolve"
   861	    return 0
   862	  fi
   863	  case "$_wbm_dr_res" in
   864	    "$_wbm_dr_phys"|"$_wbm_dr_phys"/*) ;;
   865	    *)
   866	      _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' resolves to $_wbm_dr_res, outside the target $_wbm_dr_phys"
   867	      return 0
   868	      ;;
   869	  esac
   870	  _wbm_dr_leaf="$_wbm_dr_phys/$_wbm_dr_rel"
   871	  if [ -e "$_wbm_dr_leaf" ]; then
   872	    if [ ! -f "$_wbm_dr_leaf" ] && [ ! -d "$_wbm_dr_leaf" ]; then
   873	      _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' exists and is neither a regular file nor a directory — no proven-safe way to write it"
   874	      return 0
   875	    fi
   876	    if [ -f "$_wbm_dr_leaf" ]; then
   877	      _wbm_dr_n="$( _wbm_nlink "$_wbm_dr_leaf" )"
   878	      if [ -n "$_wbm_dr_n" ] && [ "$_wbm_dr_n" -gt 1 ] 2>/dev/null; then
   879	        _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' has $_wbm_dr_n hard links — writing it would change every other name for the same inode, including names outside the target"
   880	        return 0
   881	      fi
   882	    fi
   883	  fi
   884	  return 1
   885	}
   886	
   887	# --- PLAN-185 W2: the GitHub handle grammar, with ONE owner -----------------
   888	# The SAME grammar upgrade.sh:3700 has enforced since PLAN-183 §9.2, expressed
   889	# once, here, where both executables can reach it. Its comment there says in as
   890	# many words that it exists so the upgrade cannot reproduce the 0-byte
   891	# CODEOWNERS defect — while install.sh, the script that PRODUCES the defect,
   892	# accepted the flag raw. A third implementation would have been the fourth
   893	# local branch of one shared value (debate C6).
   894	#
   895	# Equivalent to the Python `^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$`: 1-39
   896	# characters, first alphanumeric, rest alphanumeric or hyphen. The character
   897	# sets are ENUMERATED rather than written as `[A-Za-z0-9]` ranges because a
   898	# shell range is resolved through the locale's collating sequence, which in a
   899	# UTF-8 locale can admit characters Python's codepoint ranges never match — and
   900	# a grammar that answers differently in two locales is not one grammar.
   901	#
   902	# What the closed set buys, and it is the whole point: the value cannot contain
   903	# `/` (the sed delimiter that produced the 0-byte CODEOWNERS), `&` or `\` (sed
   904	# replacement metacharacters), a newline, whitespace, or a shell metacharacter.
   905	#
   906	# DELIBERATELY NARROW (OQ-2, Owner default): `org/team` is valid CODEOWNERS
   907	# syntax — the template renders `@{{OWNER_HANDLE}}`, so `@org/team` names a
   908	# TEAM — and this grammar rejects it. Supporting teams means changing the
   909	# delimiter in every consumer, which is its own wave; until then the refusal
   910	# says so instead of corrupting the file.
   911	# rc 0 = the value is a handle this framework may interpolate.
   912	#
   913	# rc.1 re-pass part 2 P2 — the predicate and the error text both call this a
   914	# GitHub-handle grammar, and it accepted `owner-` and `a--b`, which GitHub
   915	# does not issue. The installer then exited 0 after rendering that token into
   916	# every CODEOWNERS rule, so the repository carried the syntax of review
   917	# routing with none of the protection the success message implies. Two
   918	# refusals close the gap without renaming the contract: a final alphanumeric
   919	# character, and no consecutive hyphens. The consumers (install.sh's
   920	# `_assert_github_owner_grammar`, upgrade.sh's install-state reader,
   920	# `_assert_github_owner_grammar`, upgrade.sh's install-state reader,
   921	# doctor.sh) all pass through THIS function, so tightening it here tightens
   922	# them together — which is the reason it is one function and not three.
   923	_wbm_github_handle_ok() {
   924	  _wbm_gh_v="${1:-}"
   925	  [ -n "$_wbm_gh_v" ] || return 1
   926	  [ "${#_wbm_gh_v}" -le 39 ] || return 1
   927	  case "$_wbm_gh_v" in
   928	    [!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*) return 1 ;;
   929	    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;;
   930	    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]) return 1 ;;
   931	    *--*) return 1 ;;
   932	  esac
   933	  return 0
   934	}
   935	
   936	# One row's fields, validated together. Emits a breadcrumb NAMING the offending
   937	# row on stderr — a rejection nobody can see is the silence D3 was made of.
   938	# rc 0 = the row may be used; rc 1 = rejected.
   939	#
   940	# This is the ONE choke point every reader passes through (_wbm_route_src via
   941	# _wbm_route_meta, _wbm_route_dests, and therefore _wbm_route_dest_declared),
   942	# which is why the round-5 domain check lands here and not in each caller: a
   943	# rejected row drops out of _wbm_route_dests, `routes < rows` becomes true, and
   944	# upgrade.sh's AC-9 precondition turns the whole delivery into a named failure
   945	# with exit 3 (rounds 3/4 semantics) instead of a partial write.
   946	_wbm_route_row_ok() {
   947	  if ! _wbm_route_relpath_ok "${1:-}"; then
   948	    echo "    ERROR: delivery-route row REJECTED (invalid destination): '${1:-}' in $_WBM_ROUTES_TSV" >&2
   949	    return 1
   950	  fi
   951	  if ! _wbm_route_relpath_ok "${2:-}"; then
   952	    echo "    ERROR: delivery-route row REJECTED (invalid source '${2:-}') for destination '${1}' in $_WBM_ROUTES_TSV" >&2
   953	    return 1
   954	  fi
   955	  if ! _wbm_route_domain_ok "${1:-}" "${2:-}"; then
   956	    echo "    ERROR: delivery-route row REJECTED (outside delivery domain): '${1:-}' <- '${2:-}' in $_WBM_ROUTES_TSV — delivery writes ONLY docs/<name>.md, .github/CODEOWNERS[.template] or .github/workflows/<name>.template, from templates/" >&2
   957	    return 1
   958	  fi
   959	  return 0
   960	}
   961	
   962	# --- rail round-5 F4: ONE accessor for a row's metadata --------------------
   963	# Prints "<src><TAB><transform>" for the row naming destination $1, AFTER the
   964	# row has passed _wbm_route_row_ok.
   965	#   rc 0 = a valid row exists (its transform may be ANY declared value —
   966	#          judging the transform is the caller's job, reading it is not);
   967	#   rc 1 = no table, or no row for this destination;
   968	#   rc 2 = the row exists and was REJECTED (never collapse this into rc=1:
   969	#          rc=1 is answered by the callers' identity fallback "$root/$rel",
   970	#          which for a poisoned row hands back exactly the D3 behaviour).
   971	#
   972	# WHY: upgrade.sh's rendered-CODEOWNERS branch used to pull `src` and
   973	# `transform` out of the table with its own two `awk` calls — a FOURTH parser
   974	# of the shared table, which ADR-194 vetoes by name, and one that would not
   975	# have inherited the round-1/3/5 validators or the round-4 unterminated-row
   976	# fix. This is the accessor it calls instead. _wbm_route_src is now a thin
   977	# projection of the same row, so the file holds ONE loop over the table for
   978	# per-destination lookups, not two that can drift.
   979	#
   980	# rail round-4 F4 — `|| [ -n "$dest" ]`: a final row with NO trailing newline
   981	# fills the read variables but returns non-zero, so a bare `while read` DROPS
   982	# it. MEASURED pre-cure (S327) on a newline-stripped copy of the real table:
   983	# _wbm_route_dests emitted 5 of 6 destinations and _wbm_route_rows_total
   984	# counted 5 — the two agreed, so upgrade.sh's AC-9 precondition
   985	# (routes == rows) PASSED and the run shipped omitting the last delivery,
   986	# exit 0. A disagreement is visible; an agreed-upon undercount is not.
   987	# The row is still put through _wbm_route_row_ok: "process it" is not "trust
   988	# it", and a TRUNCATED final row (missing the transform field) still resolves
   989	# fail-closed at the caller, which sees an empty transform.
   990	# bash 3.2: `read` clears the variables on a true EOF, so the guard is false
   991	# on the next pass and the loop terminates (verified on 3.2.57 for the
   992	# unterminated, terminated and empty-file cases).
   993	# It ALSO publishes the two fields as _WBM_ROUTE_SRC / _WBM_ROUTE_TRANSFORM
   994	# (always reset at entry, filled only on rc=0). That is not decoration: it lets
   995	# a hot caller read them WITHOUT a command substitution. doctor.sh asks
   996	# _wbm_route_src once per manifest record — several hundred per run — and a
   997	# subshell per record is a fork per record for a linear scan of six rows.
   998	_wbm_route_meta() {
   999	  _wbm_rm_want="${1:-}"
  1000	  _wbm_rm_rc=1
  1001	  _WBM_ROUTE_SRC=""
  1002	  _WBM_ROUTE_TRANSFORM=""
  1003	  [ -n "$_wbm_rm_want" ] || return 1
  1004	  # rail round-6 F2 — the TABLE is validated before any ROW is consumed, and
  1005	  # an unusable table answers 2, never 1. rc=1 is the identity fallback
  1006	  # ("$root/$rel") every caller applies, which for a table nobody could parse
  1007	  # is defect D3/D4 arriving through a header instead of a wrong branch. This
  1008	  # also SUBSUMES the old `[ ! -f ]` check: a missing file is one of the ways
  1009	  # a table is unusable, and it now gets the same fail-closed answer.
  1010	  _wbm_route_table_gate || return 2
  1011	  while IFS="$( printf '\t' )" read -r _wbm_rm_dest _wbm_rm_src _wbm_rm_transform _wbm_rm_rest \
  1012	        || [ -n "${_wbm_rm_dest:-}" ]; do
  1013	    if [ -z "${_wbm_rm_dest:-}" ]; then continue; fi
  1014	    case "$_wbm_rm_dest" in \#*|dest) continue ;; esac
  1015	    if [ "$_wbm_rm_dest" != "$_wbm_rm_want" ]; then continue; fi
  1016	    if ! _wbm_route_row_ok "$_wbm_rm_dest" "${_wbm_rm_src:-}"; then
  1017	      _wbm_rm_rc=2
  1018	      break
  1019	    fi
  1020	    _WBM_ROUTE_SRC="$_wbm_rm_src"
  1021	    _WBM_ROUTE_TRANSFORM="${_wbm_rm_transform:-}"
  1022	    printf '%s\t%s\n' "$_WBM_ROUTE_SRC" "$_WBM_ROUTE_TRANSFORM"
  1023	    _wbm_rm_rc=0
  1024	    break
  1025	  done < "$_WBM_ROUTES_TSV"
  1026	  return "$_wbm_rm_rc"
  1027	}
  1028	
  1029	# The IDENTITY projection of _wbm_route_meta: the source relpath, and only for
  1030	# a route the framework copies VERBATIM.
  1031	#   rc 0 = identity route, source relpath on stdout
  1032	#   rc 1 = no row (callers keep today's behaviour: "$root/$rel")
  1033	#   rc 2 = RENDERED, or malformed => there are no framework source bytes to
  1034	#          hash. `${transform}` is compared against the literal `identity` and
  1035	#          nothing else: `:-identity` as a DEFAULT was the rail S325 fail-OPEN
  1036	#          finding that let a truncated row be treated as copyable.
  1037	_wbm_route_src() {
  1038	  _wbm_rs_rc=0
  1039	  # In-process (stdout discarded, fields read from the globals), never
  1040	  # `$( _wbm_route_meta ... )`: this is the per-manifest-record hot path.
  1041	  _wbm_route_meta "${1:-}" >/dev/null || _wbm_rs_rc=$?
  1042	  [ "$_wbm_rs_rc" -eq 0 ] || return "$_wbm_rs_rc"
  1043	  case "${_WBM_ROUTE_TRANSFORM:-}" in
  1044	    identity)
  1045	      if [ -z "${_WBM_ROUTE_SRC:-}" ]; then
  1046	        return 2          # declared identity but no source: malformed
  1047	      fi
  1048	      printf '%s\n' "$_WBM_ROUTE_SRC"
  1049	      return 0
  1050	      ;;
  1051	  esac
  1052	  return 2
  1053	}
  1054	
  1055	# Every destination the table declares, one per line. Callers that must decide
  1056	# WHICH routes they delivered (upgrade.sh) iterate this instead of carrying a
  1057	# second copy of the destination list.
  1058	#
  1059	# F2: a row that fails validation is NOT emitted. The count therefore DROPS
  1060	# below _wbm_route_rows_total, which is what upgrade.sh's AC-9 precondition
  1061	# turns into a named delivery failure — the rejected row can never reach a
  1062	# write, and it cannot be swallowed either.
  1063	_wbm_route_dests() {
  1064	  # rail round-6 F2 — same table gate as _wbm_route_meta, and it is what makes
  1065	  # a corrupted header a NAMED delivery failure: zero destinations enumerated
  1066	  # => routes=0 => upgrade.sh's AC-9 precondition refuses the whole delivery
  1067	  # with exit 3, instead of the readers walking data rows under a header that
  1068	  # no longer says what the columns mean.
  1069	  _wbm_route_table_gate || return 2
  1070	  # rail round-4 F4 — see the note on _wbm_route_src: an unterminated final row
  1071	  # is READ, not dropped. This loop and _wbm_route_rows_total are the numerator
  1072	  # and the denominator of the AC-9 precondition, so they must agree about
  1073	  # WHICH rows exist for the comparison to mean anything.
  1074	  while IFS="$( printf '\t' )" read -r _wbm_rd_dest _wbm_rd_src _wbm_rd_rest \
  1075	        || [ -n "${_wbm_rd_dest:-}" ]; do
  1076	    if [ -z "${_wbm_rd_dest:-}" ]; then continue; fi
  1077	    case "$_wbm_rd_dest" in \#*|dest) continue ;; esac
  1078	    _wbm_route_row_ok "$_wbm_rd_dest" "${_wbm_rd_src:-}" || continue
  1079	    printf '%s\n' "$_wbm_rd_dest"
  1080	  done < "$_WBM_ROUTES_TSV"
  1081	}
  1082	
  1083	# --- rail round-3 F1: the WHITELIST ---------------------------------------
  1084	# Is $1 byte-equal to a destination the (already validated) route table
  1085	# declares? rc 0 = yes.
  1086	#
  1087	# WHY A WHITELIST AND NOT ONE MORE SHAPE RULE: the delivered-template list
  1088	# reaches the generator through the ENVIRONMENT, and every previous cure of
  1089	# this class enumerated what is FORBIDDEN — absolute, `..`, backslash, now
  1090	# glob. Round 3 found the next shape (pathname expansion produced entries that
  1091	# were confined AND legitimate-looking), which is the signature of a denylist
  1092	# architecture regenerating. The table already answers the only question that
  1093	# matters — "may the framework own this destination at all?" — for six paths,
  1094	# and it is the single source of truth the whole wave is built on. Anything
  1095	# that is not a declared destination can never be baselined from the
  1096	# environment, whatever its shape. This is the "enumerate what is PROVEN safe"
  1097	# inversion PLAN-185 W0 arrived at after the same class regenerated three
  1098	# times under review.
  1099	#
  1100	# Fail-CLOSED by construction: no table (or an unreadable one) yields an empty
  1101	# destination list, so every entry is rejected. Ownership is under-claimed,
  1102	# which is the recoverable direction (CLAUDE.md §4).
  1103	_wbm_route_dest_declared() {
  1104	  _wbm_dd_want="${1:-}"
  1105	  [ -n "$_wbm_dd_want" ] || return 1
  1106	  _wbm_dd_rc=1
  1107	  # Redirection, not a pipe: the loop must run in THIS shell or _wbm_dd_rc
  1108	  # would be lost with the subshell.
  1109	  while IFS= read -r _wbm_dd_line; do
  1110	    if [ "$_wbm_dd_line" = "$_wbm_dd_want" ]; then
  1111	      _wbm_dd_rc=0
  1112	      break
  1113	    fi
  1114	  done <<< "$( _wbm_route_dests 2>/dev/null || true )"
  1115	  return "$_wbm_dd_rc"
  1116	}
  1117	
  1118	# How many DATA rows the table holds, validated or not. The denominator for
  1119	# the AC-9 precondition: `_wbm_route_dests | wc -l` < this means at least one
  1120	# row was rejected. Parsing stays in the ONE reader — a caller counting rows
  1121	# itself would be the second copy of the table CLAUDE.md §4 forbids.
  1122	_wbm_route_rows_total() {
  1123	  _wbm_rt_n=0
  1124	  # rail round-6 F2 — the DENOMINATOR obeys the same gate as the numerator. If
  1125	  # only one of the two refused, `routes == rows` could be satisfied by two
  1126	  # numbers derived from different premises, which is exactly the agreed-upon
  1127	  # undercount round 4 F4 closed.
  1128	  _wbm_route_table_gate || { printf '0\n'; return 2; }
  1129	  # rail round-4 F4 — the DENOMINATOR must count the unterminated final row too
  1130	  # (see _wbm_route_src). Dropping it here as well is what made the pre-cure
  1131	  # undercount INVISIBLE: routes and rows both said 5 and the precondition was
  1132	  # satisfied by two wrong numbers agreeing.
  1133	  while IFS="$( printf '\t' )" read -r _wbm_rt_dest _wbm_rt_rest \
  1134	        || [ -n "${_wbm_rt_dest:-}" ]; do
  1135	    if [ -z "${_wbm_rt_dest:-}" ]; then continue; fi
  1136	    case "$_wbm_rt_dest" in \#*|dest) continue ;; esac
  1137	    _wbm_rt_n=$(( _wbm_rt_n + 1 ))
  1138	  done < "$_WBM_ROUTES_TSV"
  1139	  printf '%s\n' "$_wbm_rt_n"
  1140	}
  1141	
  1142	# --- rail round-4 F3: the table is a REQUIRED input, not an optional one ----
  1143	# Is the shared route table PRESENT and shaped like a route table? rc 0 = yes.
  1144	#
  1145	# Every reader above answers "no table" with rc=1, and rc=1 means "no row for
  1146	# this destination" — which the callers answer with the identity fallback
  1147	# `$root/$rel`. That is defect D3/D4 verbatim, arriving through a MISSING file
  1148	# instead of a wrong branch: on a partial checkout `doctor.sh --repair` would
  1149	# hash and copy `$SOURCE_DIR/.github/CODEOWNERS` (this repo's LIVE maintainer
  1150	# file) into an adopter tree. A caller that must not degrade to identity asks
  1151	# THIS question once, at startup, before any verdict is computed.
  1152	#
  1153	# It lives here, next to the reader, for the reason the whole wave exists: the
  1154	# shape of the table is knowledge the table's owner holds. doctor growing its
  1155	# own header parser is exactly the private copy W6 deleted.
  1156	#
  1157	# Checked: readable regular file; a header row whose first three fields are
  1158	# `dest`, `src`, `transform`; and at least one DATA row. An empty-but-present
  1159	# table is not a degenerate success — it is a file that would silently deliver
  1160	# and repair nothing.
  1161	_wbm_route_table_ok() {
  1162	  _wbm_tok_tbl="${_WBM_ROUTES_TSV:-}"
  1163	  _wbm_tok_why=""
  1164	  _wbm_tok_hdr=0
  1165	  _wbm_tok_rows=0
  1166	  # rc.1 re-pass round 3, part 1 — destinations SEEN so far, wrapped in the
  1167	  # one byte a destination cannot contain (TAB is the field separator), so a
  1168	  # membership test is exact. Quoting the expansion inside `case` keeps the
  1169	  # value literal, which matters: a destination carrying a glob character
  1170	  # would otherwise be matched as a PATTERN.
  1171	  _wbm_tok_seen=""
  1172	  _wbm_tok_tab="$( printf '\t' )"
  1173	  _wbm_tok_dupe=""
  1174	  if [ -z "$_wbm_tok_tbl" ]; then
  1175	    _WBM_ROUTE_TABLE_WHY="_WBM_ROUTES_TSV is empty"
  1176	    return 1
  1177	  fi
  1178	  # rc.1 re-pass part 2 P1 — `-f` FOLLOWS symlinks, so the gate below claimed
  1179	  # to require a regular file while a symlinked table was read (and, on the
  1180	  # upgrade path, snapshotted) with no evidence left that its bytes came from
  1181	  # outside the checkout. A well-formed external table can reroute an absent
  1182	  # `.github/CODEOWNERS` to another allowed `templates/*` source, and the
  1183	  # upgrade then installs those wrong bytes successfully. The leaf test comes
  1184	  # FIRST: `-f` on a link to a regular file is true, so asking afterwards
  1185	  # would be asking too late. (Symlinked path COMPONENTS and physical
  1186	  # confinement to the executing checkout are the same class and are NOT
  1187	  # closed here — named as an rc.2 item.)
  1188	  if [ -L "$_wbm_tok_tbl" ]; then
  1189	    _WBM_ROUTE_TABLE_WHY="delivery-route table is a symlink (refusing to follow): $_wbm_tok_tbl"
  1190	    return 1
  1191	  fi
  1192	  if [ ! -f "$_wbm_tok_tbl" ]; then
  1193	    _WBM_ROUTE_TABLE_WHY="not a readable file: $_wbm_tok_tbl"
  1194	    return 1
  1195	  fi
  1196	  if [ ! -r "$_wbm_tok_tbl" ]; then
  1197	    _WBM_ROUTE_TABLE_WHY="not readable (permissions): $_wbm_tok_tbl"
  1198	    return 1
  1199	  fi
  1200	  while IFS="$( printf '\t' )" read -r _wbm_tok_a _wbm_tok_b _wbm_tok_c _wbm_tok_rest \
  1201	        || [ -n "${_wbm_tok_a:-}" ]; do
  1202	    if [ -z "${_wbm_tok_a:-}" ]; then continue; fi
  1203	    case "$_wbm_tok_a" in \#*) continue ;; esac
  1204	    if [ "$_wbm_tok_a" = "dest" ]; then
  1205	      if [ "${_wbm_tok_b:-}" = "src" ] && [ "${_wbm_tok_c:-}" = "transform" ]; then
  1206	        _wbm_tok_hdr=1
  1207	      else
  1208	        _wbm_tok_why="header row is 'dest' but its 2nd/3rd fields are '${_wbm_tok_b:-}'/'${_wbm_tok_c:-}', not 'src'/'transform'"
  1209	      fi
  1210	      continue
  1211	    fi
  1212	    _wbm_tok_rows=$(( _wbm_tok_rows + 1 ))
  1213	    # rc.1 re-pass round 3, part 1 — a DUPLICATE destination is ambiguous
  1214	    # input, and the readers disagreed about it. `_wbm_route_dests` emits
  1215	    # both rows, so routes == rows and the conservation law holds, but every
  1216	    # consumer then asks `_wbm_route_src <dest>`, whose reader stops at the
  1217	    # FIRST match: the first row runs twice, the second is silently ignored,
  1218	    # and the run exits 0. The Python parity reader already refuses this
  1219	    # (`scripts/tests/_parity_classify.py`), so the shell and Python halves of
  1220	    # the same contract answered differently on exactly the input where
  1221	    # ambiguity matters. Refused HERE, in the one gate every reader passes,
  1222	    # so no consumer ever sees a table it would read two ways.
  1223	    case "$_wbm_tok_seen" in
  1224	      *"$_wbm_tok_tab$_wbm_tok_a$_wbm_tok_tab"*)
  1225	        [ -n "$_wbm_tok_dupe" ] || _wbm_tok_dupe="$_wbm_tok_a"
  1226	        ;;
  1227	      *)
  1228	        _wbm_tok_seen="$_wbm_tok_seen$_wbm_tok_tab$_wbm_tok_a$_wbm_tok_tab"
  1229	        ;;
  1230	    esac
  1231	  done < "$_wbm_tok_tbl"
  1232	  if [ -n "$_wbm_tok_dupe" ]; then
  1233	    _WBM_ROUTE_TABLE_WHY="duplicate destination '$_wbm_tok_dupe' (a destination declared twice is read one way by _wbm_route_src and another by the enumeration): $_wbm_tok_tbl"
  1234	    return 1
  1235	  fi
  1236	  if [ "$_wbm_tok_hdr" -ne 1 ]; then
  1237	    _WBM_ROUTE_TABLE_WHY="${_wbm_tok_why:-no 'dest<TAB>src<TAB>transform' header row}: $_wbm_tok_tbl"
  1238	    return 1
  1239	  fi
  1240	  if [ "$_wbm_tok_rows" -lt 1 ]; then
  1241	    _WBM_ROUTE_TABLE_WHY="header present but ZERO data rows: $_wbm_tok_tbl"
  1242	    return 1
  1243	  fi
  1244	  _WBM_ROUTE_TABLE_WHY=""
  1245	  return 0
  1246	}
  1247	
  1248	# --- rail round-6 F2: the table PRECONDITION, for every reader -------------
  1249	# Round 4 F3 put _wbm_route_table_ok in front of doctor.sh only. MEASURED
  1250	# pre-cure (S327) on the other two readers: with the header row deleted — or
  1251	# with its 2nd/3rd column names corrupted to anything but `src`/`transform` —
  1252	# _wbm_route_meta and _wbm_route_dests happily consumed the DATA rows,
  1253	# _wbm_route_rows_total counted the same rows, `routes == rows` held, and a
  1254	# real upgrade DELIVERED and exited 0. A header is not decoration: it is the
  1255	# statement that column 2 means "source" and column 3 means "transform", and
  1256	# without it the rows are an unlabelled tuple the reader is guessing at.
  1257	#
  1258	# So the question moves to where every reader already passes: this gate. One
  1259	# implementation, three call sites (the three loops that open the table), and
  1260	# the oracles assert that a fourth loop cannot be added without one — the
  1261	# alternative, a gate per caller, is the private copy this whole wave deletes.
  1262	#
  1263	# MEMOISED, and the memo is keyed on the table PATH. Not an optimisation for
  1264	# its own sake: doctor.sh asks _wbm_route_src once per manifest record and a
  1265	# full extra pass over the table per record measured ~20 ms each on this
  1266	# machine — hundreds of records means seconds of pure re-reading. Keying on
  1267	# the path is safe because, with the environment channel gone (round 6 F3),
  1268	# the path changes at most once per process: upgrade.sh's snapshot re-point,
  1269	# which the key observes. The named line is therefore printed ONCE per
  1270	# verdict, not once per record — a wall of identical errors is its own kind of
  1271	# silence.
  1272	_WBM_ROUTE_GATE_FOR=""
  1273	_WBM_ROUTE_GATE_RC=""
  1274	_wbm_route_table_gate() {
  1275	  if [ "${_WBM_ROUTE_GATE_FOR:-}" = "${_WBM_ROUTES_TSV:-}" ] && [ -n "${_WBM_ROUTE_GATE_RC:-}" ]; then
  1276	    return "$_WBM_ROUTE_GATE_RC"
  1277	  fi
  1278	  _WBM_ROUTE_GATE_FOR="${_WBM_ROUTES_TSV:-}"
  1279	  if _wbm_route_table_ok; then
  1280	    _WBM_ROUTE_GATE_RC=0
  1281	  else
  1282	    _WBM_ROUTE_GATE_RC=1
  1283	    echo "    ERROR: delivery-route table REFUSED — ${_WBM_ROUTE_TABLE_WHY:-unknown reason}" >&2
  1284	    echo "           Every reader now answers fail-closed and enumerates ZERO routes." >&2
  1285	    echo "           Expected a 'dest<TAB>src<TAB>transform' header and at least one data" >&2
  1286	    echo "           row. docs/ and .github/ are NOT delivered, and nothing is repaired" >&2
  1287	    echo "           or recorded through the identity fallback (that fallback IS D3)." >&2
  1288	  fi
  1289	  return "$_WBM_ROUTE_GATE_RC"
  1290	}
  1291	
  1292	# The digest the PRE-run manifest recorded. Empty when unavailable, which the
  1293	# fail-closed branch turns into "do not record" rather than a guess.
  1294	#
  1295	# rail round-4 F1: EXACT relpath match, via awk on the two-space separator the
  1296	# manifest format uses — never a regex. The relpaths this is asked about carry
  1297	# `.` (`.github/CODEOWNERS`), and under `grep -E` a `.` matches ANY character,
  1298	# so `Xgithub/CODEOWNERS` would have answered for it. upgrade.sh carried its
  1299	# own awk for exactly this reason; it now calls this instead, so the manifest
  1300	# format has one parser again.
  1301	_wbm_prior_digest() {
  1302	  [ -n "${FMS_PRIOR_MANIFEST:-}" ] && [ -f "$FMS_PRIOR_MANIFEST" ] || { printf ''; return 0; }
  1303	  awk -v want="$1" '
  1304	    { i = index($0, "  "); if (i == 0) next
  1305	      if (substr($0, i + 2) != want) next
  1306	      d = substr($0, 1, i - 1)
  1307	      if (length(d) == 64 && d ~ /^[0-9a-f]+$/) { print d; exit } }' \
  1308	    "$FMS_PRIOR_MANIFEST" 2>/dev/null || printf ''
  1309	}
  1310	
  1311	_write_baseline_manifest() {
  1312	  _wbm_manifest="$1"
  1313	  if ! command -v _framework_manifest_files >/dev/null 2>&1 \
  1314	     || ! command -v _hash_file >/dev/null 2>&1; then
  1315	    echo "    NOTE: baseline manifest skipped — hash/enumeration helpers not sourced" >&2
  1316	    return 0
  1317	  fi
  1318	  : "${FMS_ROOT:?_write_baseline_manifest requires FMS_ROOT}"
  1319	  # PLAN-183 W5 (D3) fail-CLOSED precondition. Enumerating delivered templates
  1320	  # WITHOUT a usable route table would resolve each one as "$root/$rel" —
  1321	  # precisely the D3 defect, arriving silently. The table is INPUT, not
  1322	  # infrastructure (CLAUDE.md §4), so refuse to record rather than record the
  1323	  # wrong bytes; ownership is under-claimed, which is recoverable.
  1324	  #
  1325	  # rail round-6 F2 — the whole WRITE is abandoned, not just the delivered
  1310	
  1311	_write_baseline_manifest() {
  1312	  _wbm_manifest="$1"
  1313	  if ! command -v _framework_manifest_files >/dev/null 2>&1 \
  1314	     || ! command -v _hash_file >/dev/null 2>&1; then
  1315	    echo "    NOTE: baseline manifest skipped — hash/enumeration helpers not sourced" >&2
  1316	    return 0
  1317	  fi
  1318	  : "${FMS_ROOT:?_write_baseline_manifest requires FMS_ROOT}"
  1319	  # PLAN-183 W5 (D3) fail-CLOSED precondition. Enumerating delivered templates
  1320	  # WITHOUT a usable route table would resolve each one as "$root/$rel" —
  1321	  # precisely the D3 defect, arriving silently. The table is INPUT, not
  1322	  # infrastructure (CLAUDE.md §4), so refuse to record rather than record the
  1323	  # wrong bytes; ownership is under-claimed, which is recoverable.
  1324	  #
  1325	  # rail round-6 F2 — the whole WRITE is abandoned, not just the delivered
  1326	  # templates. On the upgrade lane every path under $FMS_HASH_ROOT is resolved
  1327	  # through _wbm_route_src, which now answers rc=2 for ALL of them when the
  1328	  # table is unusable; carrying on would replace a correct manifest with a
  1329	  # near-empty one, and an empty baseline is what uninstall and doctor read
  1330	  # next. Leaving the previous manifest untouched is the recoverable direction.
  1331	  # The old check asked `[ ! -f ]`; the gate asks the same question and four
  1332	  # more (readable, regular, header, ≥1 data row).
  1333	  if ! _wbm_route_table_gate; then
  1334	    echo "    ERROR: baseline manifest NOT written — the delivery-route table is" >&2
  1335	    echo "           unusable (${_WBM_ROUTE_TABLE_WHY:-unknown reason})." >&2
  1336	    echo "           Every source would resolve through the identity fallback, which is" >&2
  1337	    echo "           defect D3; the manifest already on disk is left as it stands." >&2
  1338	    return 0
  1339	  fi
  1340	  # FMS_HASH_ROOT (optional): hash the FRAMEWORK version of each file from here
  1341	  # instead of FMS_ROOT. The ENUMERATION still walks FMS_ROOT (what the target
  1342	  # holds), but the recorded baseline must be what the framework SHIPS — never
  1343	  # an adopter-customized target file. Without this, upgrade.sh's post-upgrade
  1344	  # rewrite (C.7) records hash(customized-but-preserved file) as the baseline,
  1345	  # which the NEXT upgrade reads as H_dst==H_base => FRAMEWORK-CHANGED => clobber
  1346	  # (the verified C.5 idempotency failure). Default = FMS_ROOT (install path,
  1347	  # where the target IS the freshly-written framework version). The root
  1348	  # PROTOCOL.md is GENERATED (a pointer), not a source copy, so it always hashes
  1349	  # from FMS_ROOT (the target pointer), never FMS_HASH_ROOT. (Codex R1 + dry-run)
  1350	  _wbm_hash_root="${FMS_HASH_ROOT:-$FMS_ROOT}"
  1351	
  1352	  _wbm_tmp="$( mktemp "$_wbm_manifest.XXXXXX" 2>/dev/null )" || {
  1353	    echo "    NOTE: baseline manifest skipped (mktemp failed) — advisory only" >&2
  1354	    return 0
  1355	  }
  1356	
  1357	  _framework_manifest_files | while IFS= read -r _wbm_rel; do
  1358	    [ -n "$_wbm_rel" ] || continue
  1359	    _wbm_abs="$FMS_ROOT/$_wbm_rel"
  1360	    # Drop relpaths carrying control chars (line-based manifest).
  1361	    case "$_wbm_rel" in
  1362	      *[$'\n\r\t']*) continue ;;
  1363	    esac
  1364	    if [ "${FMS_MODE:-copy}" = "link" ] && [ -L "$_wbm_abs" ] \
  1365	       && _wbm_link_allowed "$_wbm_rel"; then
  1366	      _wbm_target="$( readlink "$_wbm_abs" 2>/dev/null || true )"
  1367	      [ -n "$_wbm_target" ] || continue
  1368	      case "$_wbm_target" in
  1369	        *[$'\n\r\t']*) continue ;;
  1370	      esac
  1371	      printf 'LINK  %s  %s\n' "$_wbm_rel" "$_wbm_target" >> "$_wbm_tmp"
  1372	    elif [ -L "$_wbm_abs" ]; then
  1373	      # A live symlink that did NOT qualify as a LINK record (wrong mode, or
  1374	      # rejected by _wbm_link_allowed) must never fall through to the hash
  1375	      # branch: POSIX -f FOLLOWS the link, and the record would serialize the
  1376	      # ADOPTER's target content as a framework HASH delivery — a new route
  1377	      # around INV-2 (repass-r2 part-a V4). No record at all: not delivered.
  1378	      echo "    NOTE: symlink $_wbm_rel not recorded (no LINK authorization; refusing to hash through it)" >&2
  1379	      continue
  1380	    elif [ -f "$_wbm_abs" ]; then
  1381	      if [ "$_wbm_rel" = "PROTOCOL.md" ]; then
  1382	        # Generated pointer. Use the CANONICAL pointer hash (FMS_PROTOCOL_HASH,
  1383	        # exported by upgrade.sh _refresh_protocol_pointer) so a PRESERVED
  1384	        # adopter-customized PROTOCOL.md is NOT re-recorded as its own baseline
  1385	        # (Codex R2 P0 — else the next upgrade reads H_dst==H_base and clobbers
  1386	        # it). On install (no FMS_PROTOCOL_HASH) the target IS the freshly
  1387	        # written pointer, so hashing it directly is correct.
  1388	        if [ -n "${FMS_PROTOCOL_HASH:-}" ]; then
  1389	          _wbm_digest="$FMS_PROTOCOL_HASH"
  1390	        else
