  1292	# The digest the PRE-run manifest recorded. Empty when unavailable, which the
  1293	# fail-closed branch turns into "do not record" rather than a guess.
  1294	#
  1295	# rail round-4 F1: EXACT relpath match, via awk on the two-space separator the
  1296	# manifest format uses — never a regex. The relpaths this is asked about carry
  1297	# `.` (`.github/CODEOWNERS`), and under `grep -E` a `.` matches ANY character,
  1298	# so `Xgithub/CODEOWNERS` would have answered for it. upgrade.sh carried its
  1299	# own awk for exactly this reason; it now calls this instead, so the manifest
  1300	# format has one parser again.
  1301	_wbm_prior_digest() {
  1302	  [ -n "${FMS_PRIOR_MANIFEST:-}" ] && [ -f "$FMS_PRIOR_MANIFEST" ] || { printf ''; return 0; }
  1303	  awk -v want="$1" '
  1304	    { i = index($0, "  "); if (i == 0) next
  1305	      if (substr($0, i + 2) != want) next
  1306	      d = substr($0, 1, i - 1)
  1307	      if (length(d) == 64 && d ~ /^[0-9a-f]+$/) { print d; exit } }' \
  1308	    "$FMS_PRIOR_MANIFEST" 2>/dev/null || printf ''
  1309	}
