  2405	    # baseline entries not already present (jq array subtraction).
  2406	    if jq --argjson newdeny "$entries_json" '
  2407	         (.permissions.deny // []) as $cur
  2408	         | .permissions.deny = ($cur + ($newdeny - $cur))
