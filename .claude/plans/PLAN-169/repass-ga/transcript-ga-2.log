   126	    case "$-" in *f*) _fms_te_had_f=1 ;; esac
   127	    set -f
   128	
   129	    # Root governance pointer (the verified S238 driver target — outside
   130	    # .claude/). PLAN-166 F3 (ADR-155-AMEND-1): CONDITIONAL on the recorded
   131	    # delivery. A `--ceremony user` install SKIPS install_protocol_pointer
   132	    # (install.sh WS4-guard-proto), and a maintainer target that ALREADY had
   133	    # its own root PROTOCOL.md was never written by the framework —
   134	    # enumerating it unconditionally records the ADOPTER's file as
   135	    # framework-owned (r13/r17).
   136	    if [ "${FMS_DELIVERED_PROTOCOL:-0}" = "1" ]; then
   137	      printf '%s\n' "PROTOCOL.md"
   138	    fi
   139	
   140	    # SPEC/v1 published contract (PLAN-166 F3): an upgrade surface as of
   141	    # v1.3.0 — same delivery-record condition (never ceremony alone, never
   142	    # file presence; r7/r17).
   143	    if [ "${FMS_DELIVERED_SPEC:-0}" = "1" ]; then
   144	      printf '%s\n' "SPEC/v1"
   145	    fi
   146	
   147	    # Framework version marker (PLAN-166 F3): a NORMAL tracked-file entry —
   148	    # present in the source tree, so the FMS_HASH_ROOT baseline rewrite
   149	    # (below) preserves it with no generated-file special-case — but
   150	    # ownership still derives from the registered delivery: a target whose
   151	    # marker pre-existed (install_one EXISTS-skip) stays adopter-owned and
   152	    # every marker-first reader keyed off this same record falls back to
   153	    # VERSION (r20).
