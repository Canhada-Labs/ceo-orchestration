  2358	apply_deny_baseline() {
  2359	  # PLAN-185 W1 — third consumer of the settings-destination verdict. Its own
  2360	  # `-f "$SETTINGS_DST"` test below is symlink-FOLLOWING, so on a RESOLVED link
  2361	  # it answers true and the jq rewrite lands outside $TARGET; and `$tmp` is a
  2362	  # sibling INSIDE the target, so the `mv` would additionally replace the
  2363	  # adopter's link with a regular file. Neither is reachable once the shared
  2364	  # verdict is consulted first.
  2365	  if [[ "${_SETTINGS_DST_REFUSED:-0}" -eq 1 ]]; then
  2366	    return 0
  2367	  fi
  2368	  if [[ "${CEO_INSTALL_SKIP_DENY_BASELINE:-0}" = "1" ]]; then
  2369	    echo "    SKIP: deny baseline (CEO_INSTALL_SKIP_DENY_BASELINE=1)"
  2370	    return 0
  2371	  fi
  2372	
  2373	  if [[ "$DRY_RUN" -eq 1 ]]; then
  2374	    if [[ "$SETTINGS_PRE_EXISTING" -eq 1 ]]; then
  2375	      echo "    (dry-run) settings.json pre-existed — would NOT touch deny baseline"
  2376	    else
  2377	      echo "    (dry-run) would MERGE ${#DENY_BASELINE_ENTRIES[@]} deny-baseline entries into .claude/settings.json"
  2378	    fi
  2379	    return 0
  2380	  fi
  2381	
  2382	  if [[ "$SETTINGS_PRE_EXISTING" -eq 1 ]]; then
  2383	    echo "    SKIP: settings.json pre-existed this run (add entries manually if wanted — docs/deny-baseline.md)"
  2384	    return 0
  2385	  fi
  2386	  if [[ ! -f "$SETTINGS_DST" ]]; then
  2387	    # build_settings decided not to produce one; nothing to inject into.
  2388	    return 0
  2389	  fi
  2390	
  2391	  # Build a JSON array literal from the entries. All entries are static
  2392	  # literals controlled above (no embedded double quotes or backslashes),
  2393	  # so direct interpolation is safe.
  2394	  local entries_json="[" e first=1
  2395	  for e in "${DENY_BASELINE_ENTRIES[@]}"; do
  2396	    if [[ "$first" -eq 1 ]]; then first=0; else entries_json+=","; fi
  2397	    entries_json+="\"$e\""
  2398	  done
  2399	  entries_json+="]"
  2400	
  2401	  local tmp="$SETTINGS_DST.deny-baseline.$$"
  2402	
  2403	  if command -v jq >/dev/null 2>&1; then
  2404	    # Order-preserving dedup: keep existing deny list as-is, append only
  2405	    # baseline entries not already present (jq array subtraction).
  2406	    if jq --argjson newdeny "$entries_json" '
  2407	         (.permissions.deny // []) as $cur
  2408	         | .permissions.deny = ($cur + ($newdeny - $cur))
  2409	       ' "$SETTINGS_DST" > "$tmp" 2>/dev/null; then
  2410	      mv "$tmp" "$SETTINGS_DST"
  2411	      echo "    MERGED: ${#DENY_BASELINE_ENTRIES[@]}-entry coarse deny baseline -> .claude/settings.json (docs/deny-baseline.md)"
  2412	      return 0
  2413	    fi
  2414	    rm -f "$tmp"
  2415	    echo "    WARNING: jq merge of the deny baseline failed — settings.json left untouched." >&2
  2416	    echo "             Add the permissions.deny entries manually: docs/deny-baseline.md." >&2
  2417	    return 0
  2418	  fi
  2419	
  2420	  if command -v python3 >/dev/null 2>&1; then
  2421	    if python3 - "$SETTINGS_DST" "$entries_json" > "$tmp" <<'PY'
  2422	import json
  2423	import sys
  2424	
  2425	with open(sys.argv[1], "r", encoding="utf-8") as fh:
  2426	    settings = json.load(fh)
  2427	new = json.loads(sys.argv[2])
  2428	perms = settings.setdefault("permissions", {})
  2429	cur = perms.get("deny") or []
  2430	perms["deny"] = cur + [e for e in new if e not in cur]
  2431	sys.stdout.write(json.dumps(settings, indent=2) + "\n")
  2432	PY
  2433	    then
  2434	      mv "$tmp" "$SETTINGS_DST"
  2435	      echo "    MERGED: ${#DENY_BASELINE_ENTRIES[@]}-entry coarse deny baseline -> .claude/settings.json (python3; docs/deny-baseline.md)"
  2436	      return 0
  2437	    fi
  2438	    rm -f "$tmp"
  2439	    echo "    WARNING: python3 merge of the deny baseline failed — settings.json left untouched." >&2
  2440	    echo "             Add the permissions.deny entries manually: docs/deny-baseline.md." >&2
  2441	    return 0
  2442	  fi
  2443	
  2444	  echo "    WARNING: neither jq nor python3 found — deny baseline NOT applied." >&2
  2445	  echo "             Add the permissions.deny entries manually: docs/deny-baseline.md." >&2
  2446	  return 0
  2447	}
