  1051	
  1052	# PLAN-185 W1 (rail round-1 P1) — GLOBAL PRE-FLIGHT, before the FIRST write.
  1053	#
  1054	# The per-group pre-flights are not enough on their own: each runs when its
  1055	# group runs, and by then `.claude` has been created and populated. MEASURED
  1056	# pre-cure on a FRESH target carrying a dangling `docs/rotation-log.md`: the run
  1057	# ended rc 1, the refusal was named, and zero bytes went outside the target —
  1058	# but **563 files were left INSIDE it**, `PROTOCOL.md` and `.github/` among
  1059	# them, with NO manifest and NO install-state. Rollback cannot reach that:
  1060	# BACKUP_DIR is EMPTY for a fresh target (there was no `.claude` to snapshot),
  1061	# and even on an existing target it restores `.claude` only. The adopter is left
  1062	# holding a half-installed framework that nothing records — the partial-state
  1063	# outcome the accumulate-and-fail-at-the-end policy exists to avoid, arriving
  1064	# through the door that policy left open.
  1065	#
  1066	# So the run answers FIRST, for every destination whose relpath is known before
  1067	# delivery begins, and refuses with the COMPLETE list while the target is still
  1068	# untouched. `install_one` / `install_template` destinations are enumerated from
  1069	# the source tree as delivery proceeds and keep their per-writer check; those
  1070	# per-writer checks stay regardless, because the answer taken immediately before
  1071	# a write is the one that matters under TOCTOU.
  1072	#
  1073	# rc 0 = every known destination is confined.
  1074	_dst_global_preflight() {
  1075	  local rels rel rc=0
  1076	  rels=".claude/settings.json
  1077	$( _fixed_template_dests "$_FIXED_TEMPLATES_ALL_CEREMONIES" )"
  1078	  if [[ "$WITH_REFERENCE_PERSONAS" -eq 1 ]]; then
  1079	    rels="$rels
  1080	.claude/team-personas-reference.md"
  1081	  fi
  1082	  # A `--ceremony user` install writes inside .claude/ only (WS4), so the root,
  1083	  # docs/ and .github/ destinations below are not its to answer for.
  1084	  if [[ "$CEREMONY" != "user" ]]; then
  1085	    rels="$rels
  1086	$( _fixed_template_dests "$_FIXED_TEMPLATES_MAINTAINER" )
  1087	docs/BRANCH-PROTECTION.md
  1088	docs/rotation-log.md
  1089	PROTOCOL.md
  1090	.github/workflows/validate.yml.template
  1091	.github/workflows/benchmarks.yml.template"
  1092	    # The two CODEOWNERS destinations are mutually exclusive and the handle
  1093	    # decides which, exactly as the delivery branches do.
  1094	    if [[ -n "$GITHUB_OWNER" ]]; then
  1095	      rels="$rels
  1096	.github/CODEOWNERS"
  1097	    else
  1098	      rels="$rels
  1099	.github/CODEOWNERS.template"
  1100	    fi
  1101	  fi
  1102	  while IFS= read -r rel; do
  1103	    [[ -n "$rel" ]] || continue
  1104	    if _dst_refuses "$rel"; then rc=1; fi
  1105	  done <<< "$rels"
  1106	  # SPEC/v1 is a DIRECTORY delivery under the same WS4 ceremony guard as the
  1107	  # root surfaces; ancestor-only, per the note on _dst_ancestor_refuses.
  1108	  if [[ "$CEREMONY" != "user" && -d "$SOURCE_DIR/SPEC/v1" ]]; then
  1109	    if _dst_ancestor_refuses "SPEC/v1"; then rc=1; fi
  1110	  fi
  1111	  return "$rc"
  1112	}
