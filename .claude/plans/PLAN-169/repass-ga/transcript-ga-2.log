  3061	# ----------------------------------------------------------------------
  3062	# PLAN-138 Wave C (ADR-155) — write the baseline SHA-256 manifest.
  3063	#
  3064	# Records, per framework-owned file, a baseline digest so a later upgrade can
  3065	# tell "the framework changed this" apart from "the adopter changed this" and
  3066	# PRESERVE/REFUSE customizations instead of clobbering them (incl. the root
  3067	# PROTOCOL.md — the verified S238 driver). The enumeration is the SINGLE shared
  3068	# set from _framework_manifest_set.sh, so the manifest writer (here) and the
  3069	# upgrade classifier walk an identical list.
  3070	#
  3071	# Manifest grammar (two record kinds):
  3072	#   <64hex>  <relpath>            — content hash of a copied file
  3073	#   LINK  <relpath>  <target>     — a --mode link symlink (content == source,
  3074	#                                   so a content hash is meaningless; the
  3075	#                                   upgrade classifier short-circuits LINK)
  3076	#
  3077	# Written to $TARGET/.claude/.install-manifest.sha256 (distinct from the
  3078	# release skill-manifest.sha256). EXCLUDES the manifest itself + .claude.bak/.
  3079	# Fail-open: any missing helper / unreadable file is skipped with a NOTE; the
  3080	# install never fails because the manifest could not be fully written.
  3081	# ----------------------------------------------------------------------
  3082	write_install_manifest() {
  3083	  # Guarded by the caller for DRY_RUN; defensive re-check here.
  3084	  [[ "${DRY_RUN:-0}" -eq 0 ]] || return 0
  3085	
  3086	  if ! command -v _write_baseline_manifest >/dev/null 2>&1; then
  3087	    echo "    NOTE: baseline manifest skipped — generator helper not sourced" >&2
  3088	    return 0
  3089	  fi
  3090	
  3091	  local manifest="$TARGET/.claude/.install-manifest.sha256"
  3092	  echo ""
  3093	  echo "==> Writing install baseline manifest (.claude/.install-manifest.sha256)"
  3094	  _state_record_op "write_install_manifest" ".claude/.install-manifest.sha256"
  3095	
  3096	  # Profile-aware enumeration rooted at the installed target; the SINGLE shared
  3097	  # generator in _framework_manifest_set.sh does the walk + hashing + LINK
  3098	  # records (the SAME generator upgrade.sh calls after a successful upgrade).
  3099	  export FMS_ROOT="$TARGET"
  3100	  export FMS_PROFILE_PARTS="${PROFILE_PARTS[*]}"
  3101	  export FMS_MODE="$MODE"
  3102	  # PLAN-166 F3 (ADR-155-AMEND-1): conditional ownership from the DELIVERY
  3103	  # RECORD — never the ceremony alone, never file presence. A path
  3104	  # install_one EXISTS-skipped stays out of the baseline, so doctor, the
  3105	  # update-checker and uninstall never treat an adopter file as
  3106	  # framework-owned (r7/r13/r17).
  3107	  #
  3108	  # Ownership CONTINUITY on reruns (codex W1-ceremony round, P1): a rerun
  3109	  # over an already-installed target EXISTS-skips all three paths, so the
  3110	  # THIS-RUN flags are 0 — but the manifest rewrite below REPLACES the old
  3111	  # manifest. Without consulting the PRIOR manifest's records, a rerun
  3112	  # would silently drop framework ownership of SPEC/PROTOCOL/marker (and a
  3113	  # v1.3 SPEC would later misclassify as ADOPTER-FORK — it is absent from
  3114	  # the legacy pristine fingerprints). Preserve a valid prior record: the
  3115	  # regexes mirror upgrade.sh _baseline_has_*_record byte-for-byte
  3116	  # (family-swept; `(/|  |$)` covers the --mode link single-LINK-line form).
  3117	  # A prior LINK record carries ownership forward only while the live symlink
  3118	  # still points where it was RECORDED (codex W1 round 10, P2). On a --link
  3119	  # reinstall over a RETARGETED managed symlink, install_one EXISTS-skips the
  3120	  # path and the continuity check used to accept the record blindly; the
  3121	  # rewrite then serialized the redirected target as the new delivery record
  3122	  # and every later upgrade accepted the foreign tree as healthy. Mirrors the
  3123	  # readlink-vs-record checks upgrade.sh already applies on its refresh
  3124	  # routes. Returns 0 (carry on) when there is no LINK record to compare.
  3125	  _prior_link_target_matches() {   # $1 = manifest, $2 = relpath
  3126	    local _plt_line _plt_rec="" _plt_live
  3127	    while IFS= read -r _plt_line || [[ -n "$_plt_line" ]]; do
  3128	      case "$_plt_line" in
  3129	        "LINK  $2  "*) _plt_rec="${_plt_line#LINK  $2  }"; break ;;
  3130	      esac
  3131	    done < "$1"
  3132	    _plt_live="$( readlink "$TARGET/$2" 2>/dev/null || true )"
  3133	    # A live SYMLINK with no prior LINK record is NOT a match — it is the
  3134	    # ABSENCE of evidence. Returning success there let a --link rerun over a
  3135	    # copy-installed path serialize an arbitrary symlink as a trusted delivery,
  3136	    # converting adopter-owned content into framework-owned (r11-F1, open since
  3137	    # S296; codex W3 r2 P1).
  3138	    if [[ -z "$_plt_rec" ]]; then
  3139	      # No prior LINK record. Ownership carries forward ONLY while the live
  3140	      # path still has the shape the record described. A symlink contradicts a
  3141	      # HASH record (r11-F1); so does a DIRECTORY, and that one is worse — the
  3142	      # continuity branch would enumerate the adopter's own children under it
  3143	      # and record their live hashes, so a later uninstall could delete files
  3144	      # the framework never wrote (codex W3 r3 P1).
  3145	      [[ -z "$_plt_live" ]] || return 1
  3146	      # SPEC/v1 IS a directory by design; only the two SINGLE-FILE surfaces are
  3147	      # contradicted by one. Rejecting every directory broke SPEC continuity.
  3148	      case "$2" in
  3149	        SPEC/v1) : ;;
  3150	        *) [[ ! -d "$TARGET/$2" ]] || return 1 ;;
  3151	      esac
  3152	      return 0
  3153	    fi
  3154	    [[ "$_plt_rec" == "$_plt_live" ]]
  3155	  }
  3156	  if [[ "${_DELIVERED_SPEC:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  3157	     && grep -Eq '^([0-9a-f]{64}|LINK)  SPEC/v1(/|  |$)' "$manifest" 2>/dev/null \
  3158	     && _prior_link_target_matches "$manifest" "SPEC/v1"; then
  3159	    _DELIVERED_SPEC=1
  3160	    _CONTINUITY_FIRED=1
  3161	    _CONTINUITY_PATHS="${_CONTINUITY_PATHS:-}
  3162	SPEC/v1"
  3163	    echo "    ownership continuity: SPEC/v1 delivery record preserved from prior manifest"
  3164	  fi
  3165	  if [[ "${_DELIVERED_PROTOCOL:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  3166	     && grep -Eq '^([0-9a-f]{64}|LINK)  PROTOCOL\.md(  |$)' "$manifest" 2>/dev/null \
  3167	     && _prior_link_target_matches "$manifest" "PROTOCOL.md"; then
  3168	    # FMS_HASH_ROOT does NOT reach PROTOCOL.md: _write_baseline_manifest
  3169	    # special-cases the generated pointer and hashes the TARGET unless
  3170	    # FMS_PROTOCOL_HASH is supplied — which install never set. So a rerun over
  3171	    # a CUSTOMIZED delivered pointer re-baselined the adopter's own bytes as
  3172	    # framework-owned; the next upgrade would then overwrite them and
  3173	    # uninstall could DELETE them (codex W1 round 9, P1). Carry the PRIOR
  3174	    # recorded digest. A LINK record needs none (the rewrite's link branch
  3175	    # fires before the PROTOCOL special case); with neither, DROP the
  3176	    # ownership claim rather than record a knowingly wrong baseline.
  3177	    _PRIOR_PROTOCOL_HASH="$( grep -E '^[0-9a-f]{64}  PROTOCOL\.md$' "$manifest" 2>/dev/null | head -1 | cut -d' ' -f1 || true )"
  3178	    if [[ -n "$_PRIOR_PROTOCOL_HASH" ]] \
  3179	       || grep -Eq '^LINK  PROTOCOL\.md(  |$)' "$manifest" 2>/dev/null; then
  3180	      _DELIVERED_PROTOCOL=1
  3181	      _CONTINUITY_FIRED=1
  3182	      _CONTINUITY_PATHS="${_CONTINUITY_PATHS:-}
  3183	PROTOCOL.md"
  3184	      echo "    ownership continuity: PROTOCOL.md delivery record preserved from prior manifest"
  3185	    else
  3186	      echo "    NOTE: PROTOCOL.md record present but its digest is unrecoverable —" >&2
  3187	      echo "          ownership NOT claimed (the pointer stays adopter-owned)" >&2
  3188	    fi
  3189	  fi
  3190	  if [[ "${_DELIVERED_MARKER:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  3191	     && grep -Eq '^([0-9a-f]{64}|LINK)  \.claude/\.framework-version(  |$)' "$manifest" 2>/dev/null \
  3192	     && _prior_link_target_matches "$manifest" ".claude/.framework-version"; then
  3193	    _DELIVERED_MARKER=1
  3194	    _CONTINUITY_FIRED=1
  3195	    _CONTINUITY_PATHS="${_CONTINUITY_PATHS:-}
  3196	.claude/.framework-version"
  3197	    echo "    ownership continuity: .framework-version delivery record preserved from prior manifest"
  3198	  fi
  3199	  # For the continuity-preserved paths ONLY, hash the FRAMEWORK's pristine
  3200	  # copies instead of the (possibly edited) target's (codex W1 round 5, P1):
  3201	  # install normally hashes FMS_ROOT=$TARGET — on a rerun over an EDITED
  3202	  # delivered SPEC that would re-baseline the fork's bytes as framework-owned,
  3203	  # and a later uninstall would happily DELETE the user's modified tree (its
  3204	  # hash matches the manifest). Same C.5 idempotency posture upgrade.sh uses.
  3205	  #
  3206	  # SCOPED, not global (codex W1 round 8, P1): install RENDERS templates
  3207	  # (`.claude/team.md`, skills, `{{X}}` placeholders under --project et al),
  3208	  # so a global FMS_HASH_ROOT rewrote every rendered file's baseline to the
  3209	  # UNRENDERED source — doctor.sh then reports repo-wide adopter drift and
  3210	  # later upgrades classify those files as customized and stop refreshing
  3211	  # them. PLAN-167 W2.3 replaced that confinement with an EXPLICIT per-surface
  3212	  # hash_source: the decision says which paths take the framework's bytes,
  3213	  # so no global override is set here at all.
  3214	  if [[ "${_CONTINUITY_FIRED:-0}" = "1" ]]; then
  3215	    : # per-surface hash_source below replaces the global override
  3216	    case "$_CONTINUITY_PATHS" in
  3217	      *".claude/.framework-version"*) export FMS_HASH_SOURCE_MARKER="HASH_SOURCE" ;;
  3218	    esac
  3219	    case "$_CONTINUITY_PATHS" in
  3220	      # The generated pointer has no source bytes; carry what was recorded.
  3221	      *"PROTOCOL.md"*)               export FMS_HASH_SOURCE_PROTOCOL="HASH_PRIOR_RECORD" ;;
  3222	    esac
  3223	    echo "    ownership continuity: manifest hashes the preserved paths from the framework source (edited target content stays adopter-owned; rendered files keep their target hash)"
  3224	  fi
  3225	  # Declare on EVERY delivery path, not only continuity. A fresh install
  3226	  # genuinely delivers these surfaces, and the previous attempt at this wave
  3227	  # regressed 24 cells precisely because it left fresh installs undeclared.
  3228	  #
  3229	  # Fresh delivery: the target IS the bytes just written, so HASH_TARGET is
  3230	  # both correct and observationally identical to HASH_SOURCE.
  3231	  # Continuity: the target may be an EDITED fork, so the record must come from
  3232	  # the framework's copy (spec/marker) or the prior record (the generated
  3233	  # pointer, which has no source file).
  3234	  export FMS_SOURCE_ROOT="$SOURCE_DIR"
  3235	  export FMS_PRIOR_MANIFEST="$manifest"
  3236	  if [[ "${_DELIVERED_SPEC:-0}" = "1" ]]; then
  3237	    case "${_CONTINUITY_PATHS:-}" in
  3238	      *"SPEC/v1"*) export FMS_HASH_SOURCE_SPEC="HASH_SOURCE" ;;
  3239	      *)           export FMS_HASH_SOURCE_SPEC="HASH_TARGET" ;;
  3240	    esac
  3241	  fi
  3242	  if [[ "${_DELIVERED_MARKER:-0}" = "1" ]]; then
  3243	    case "${_CONTINUITY_PATHS:-}" in
  3244	      *".claude/.framework-version"*) export FMS_HASH_SOURCE_MARKER="HASH_SOURCE" ;;
  3245	      *)                              export FMS_HASH_SOURCE_MARKER="HASH_TARGET" ;;
  3246	    esac
  3247	  fi
  3248	  if [[ "${_DELIVERED_PROTOCOL:-0}" = "1" ]]; then
  3249	    case "${_CONTINUITY_PATHS:-}" in
  3250	      *"PROTOCOL.md"*) export FMS_HASH_SOURCE_PROTOCOL="HASH_PRIOR_RECORD" ;;
  3251	      *)               export FMS_HASH_SOURCE_PROTOCOL="HASH_TARGET" ;;
  3252	    esac
  3253	  fi
  3254	  export FMS_DELIVERED_SPEC="${_DELIVERED_SPEC:-0}"
  3255	  export FMS_DELIVERED_PROTOCOL="${_DELIVERED_PROTOCOL:-0}"
  3256	  export FMS_DELIVERED_MARKER="${_DELIVERED_MARKER:-0}"
  3257	  # t8 P1: same delivery-record condition for the plans/ schema contracts.
  3258	  export FMS_DELIVERED_PLAN_SCHEMA="${_DELIVERED_PLAN_SCHEMA:-0}"
  3259	  export FMS_DELIVERED_DEBATE_SCHEMA="${_DELIVERED_DEBATE_SCHEMA:-0}"
  3260	  # PLAN-183 W5 (D3): the docs/ + .github/ destinations THIS run delivered,
  3261	  # newline-separated (a LIST, not a 0/1 flag: the set varies with
  3262	  # --github-owner and with what already existed). Empty on a `--ceremony
  3263	  # user` install, which skips both delivery functions (:1484, :1525).
  3264	  # Mutual exclusivity of .github/CODEOWNERS vs .github/CODEOWNERS.template is
  3265	  # already resolved here — only the branch that ran appended.
  3266	  export FMS_DELIVERED_TEMPLATES="${_DELIVERED_TEMPLATES:-}"
  3267	  # PLAN-183 W5 (OQ-4, MIXED lane): .github/CODEOWNERS is RENDERED, so it rides
  3268	  # the CONDITIONAL lane and must declare a hash_source or the generator
  3269	  # fail-closes and records nothing. Declared on EVERY delivery path, never
  3270	  # only on continuity — install.sh:2508-2511 records that the previous attempt
  3271	  # at this wave regressed 24 cells precisely by leaving fresh installs
  3272	  # undeclared. Fresh render: the target IS the delivered bytes => HASH_TARGET.
  3273	  if _delivered_template_has ".github/CODEOWNERS"; then
  3274	    # LINE-EXACT, not the substring `case` the SPEC/PROTOCOL/marker neighbours
  3275	    # use — same reason as _delivered_template_has:1526 and the same shape
  3276	    # upgrade.sh:4746 already uses: `.github/CODEOWNERS` is a PREFIX of
  3277	    # `.github/CODEOWNERS.template`, so `*".github/CODEOWNERS"*` answers
  3278	    # HASH_PRIOR_RECORD for a continuity carrying only the .template sibling —
  3279	    # recording the PRIOR digest for a file this run RENDERED. Inert today (no
  3280	    # writer of _CONTINUITY_PATHS appends a .github/ path), cured as FORM so
  3281	    # the two entrypoints stop disagreeing before a writer arrives.
  3282	    local _co_cont_line
  3283	    export FMS_HASH_SOURCE_CODEOWNERS="HASH_TARGET"
  3284	    while IFS= read -r _co_cont_line; do
  3285	      if [[ "$_co_cont_line" = ".github/CODEOWNERS" ]]; then
  3286	        export FMS_HASH_SOURCE_CODEOWNERS="HASH_PRIOR_RECORD"
  3287	      fi
  3288	    done <<< "${_CONTINUITY_PATHS:-}"
  3289	  fi
  3290	  # Empty on a fresh install (target IS the freshly written pointer, hashing it
  3291	  # is correct); set only by the continuity path above.
  3292	  export FMS_PROTOCOL_HASH="${_PRIOR_PROTOCOL_HASH:-}"
  3293	  # V5 (repass-r2 part-a): the generator's unset-FMS_LINK_PATHS default is
  3294	  # allow-all — correct only when every live symlink is installer-created,
  3295	  # which EXISTS-skip breaks: a pre-existing adopter symlink at a framework
  3296	  # relpath would serialize as a framework LINK delivery (the upgrade caller
  3297	  # was cured earlier; this cures the install caller). Authorized set =
  3298	  # links created THIS run + prior-manifest LINK records that still match
  3299	  # the live readlink (same continuity rule as above). An EMPTY set in link
  3300	  # mode is encoded as a single newline: non-empty for the generator's
  3301	  # [ -n ] probe, zero entries after IFS split — deny-all, never allow-all.
  3302	  if [[ "$MODE" == "link" ]]; then
  3303	    _v5_prior=""
  3304	    if [[ -f "$manifest" ]]; then
  3305	      # Um relpath com MAIS de um registro no manifesto previo — DOIS
  3306	      # LINKs, ou um LINK + um HASH (proveniencia MISTA) — e evidencia
  3307	      # AMBIGUA: _prior_link_target_matches leria so a primeira linha e
  3308	      # a reescrita normalizaria conteudo do adotante como LINK
  3309	      # confiavel (pair-rail S300 r3 P1-6 + r6 P1-2; mesma classe do
  3310	      # V1: evidencia ambigua nunca autoriza). Autorizavel = relpath
  3311	      # com registro LINK cuja contagem GLOBAL (todos os tipos) e 1.
  3312	      while IFS= read -r _v5_rel || [[ -n "$_v5_rel" ]]; do
  3313	        [[ -n "$_v5_rel" ]] || continue
  3314	        if _prior_link_target_matches "$manifest" "$_v5_rel"; then
  3315	          _v5_prior="$_v5_prior
  3316	$_v5_rel"
  3317	        fi
  3318	      done < <( awk '
  3319	        {
  3320	          idx = index($0, "  ");
  3321	          if (idx == 0) next;
  3322	          kind = substr($0, 1, idx - 1);
  3323	          rest = substr($0, idx + 2);
  3324	          j = index(rest, "  ");
  3325	          rel = (j == 0 ? rest : substr(rest, 1, j - 1));
  3326	          count[rel]++;
  3327	          if (kind == "LINK") islink[rel] = 1;
  3328	        }
  3329	        END {
  3330	          for (r in count)
  3331	            if (count[r] == 1 && islink[r] == 1) print r;
  3332	        }' "$manifest" 2>/dev/null | sort || true )
  3333	    fi
  3334	    FMS_LINK_PATHS="$( printf '%s\n' "${_CREATED_LINK_RELPATHS:-}" "$_v5_prior" \
  3335	      | awk 'NF' | sort -u )"
  3336	    if [[ -z "$FMS_LINK_PATHS" ]]; then
  3337	      FMS_LINK_PATHS=$'\n'
  3338	    fi
  3339	    export FMS_LINK_PATHS
  3340	    echo "    link authorization: $( printf '%s\n' "$FMS_LINK_PATHS" | grep -c . || true ) path(s) authorized for LINK records (created this run + still-valid prior records)"
  3341	  fi
  3342	  _write_baseline_manifest "$manifest"
  3343	  unset FMS_ROOT FMS_PROFILE_PARTS FMS_MODE FMS_HASH_ROOT FMS_PROTOCOL_HASH \
  3344	        FMS_PRIOR_MANIFEST FMS_HASH_SOURCE_SPEC FMS_HASH_SOURCE_PROTOCOL \
  3345	        FMS_HASH_SOURCE_MARKER
  3346	  unset FMS_DELIVERED_SPEC FMS_DELIVERED_PROTOCOL FMS_DELIVERED_MARKER
  3347	  return 0
  3348	}
