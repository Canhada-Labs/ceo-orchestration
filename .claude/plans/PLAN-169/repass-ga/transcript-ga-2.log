  2358	apply_deny_baseline() {
  2359	  # PLAN-185 W1 — third consumer of the settings-destination verdict. Its own
  2360	  # `-f "$SETTINGS_DST"` test below is symlink-FOLLOWING, so on a RESOLVED link
  2361	  # it answers true and the jq rewrite lands outside $TARGET; and `$tmp` is a
  2362	  # sibling INSIDE the target, so the `mv` would additionally replace the
  2363	  # adopter's link with a regular file. Neither is reachable once the shared
  2364	  # verdict is consulted first.
  2365	  if [[ "${_SETTINGS_DST_REFUSED:-0}" -eq 1 ]]; then
  2366	    return 0
  2367	  fi
  2368	  if [[ "${CEO_INSTALL_SKIP_DENY_BASELINE:-0}" = "1" ]]; then
  2369	    echo "    SKIP: deny baseline (CEO_INSTALL_SKIP_DENY_BASELINE=1)"
  2370	    return 0
  2371	  fi
  2372	
  2373	  if [[ "$DRY_RUN" -eq 1 ]]; then
  2374	    if [[ "$SETTINGS_PRE_EXISTING" -eq 1 ]]; then
  2375	      echo "    (dry-run) settings.json pre-existed — would NOT touch deny baseline"
  2376	    else
  2377	      echo "    (dry-run) would MERGE ${#DENY_BASELINE_ENTRIES[@]} deny-baseline entries into .claude/settings.json"
  2378	    fi
  2379	    return 0
  2380	  fi
  2381	
  2382	  if [[ "$SETTINGS_PRE_EXISTING" -eq 1 ]]; then
  2383	    echo "    SKIP: settings.json pre-existed this run (add entries manually if wanted — docs/deny-baseline.md)"
  2384	    return 0
  2385	  fi
  2386	  if [[ ! -f "$SETTINGS_DST" ]]; then
  2387	    # build_settings decided not to produce one; nothing to inject into.
  2388	    return 0
  2389	  fi
  2390	
  2391	  # Build a JSON array literal from the entries. All entries are static
  2392	  # literals controlled above (no embedded double quotes or backslashes),
  2393	  # so direct interpolation is safe.
  2394	  local entries_json="[" e first=1
  2395	  for e in "${DENY_BASELINE_ENTRIES[@]}"; do
  2396	    if [[ "$first" -eq 1 ]]; then first=0; else entries_json+=","; fi
  2397	    entries_json+="\"$e\""
  2398	  done
