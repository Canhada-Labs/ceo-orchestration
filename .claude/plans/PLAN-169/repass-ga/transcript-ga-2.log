  2992	# Session 75 Codex Finding 5 closure: --verify post-install integrity.
  2993	# Re-checksums installed skill SHAs against the source manifest if one
  2994	# is shipped at .claude/skill-manifest.sha256. Advisory-only when the
  2995	# manifest is absent (don't break adopters who didn't ship it).
  2996	# Sigstore backend is OUT OF SCOPE per Owner D2 lock.
  2997	# ----------------------------------------------------------------------
  2998	if [[ "${VERIFY:-0}" -eq 1 ]]; then
  2999	  echo ""
  3000	  echo "==> Verifying installed skill checksums (--verify)"
  3001	  _state_record_op "verify_skill_checksums" ""
  3002	  manifest="$TARGET/.claude/skill-manifest.sha256"
  3003	  if [[ ! -f "$manifest" ]]; then
  3004	    echo "    NOTE: no skill-manifest.sha256 present — skipping verify"
  3005	    echo "          (advisory only; manifest is shipped by tarball releases)"
  3006	  else
  3007	    # PLAN-138 Wave C (ADR-155): portable verify via _hash_lib.sh
  3008	    # (shasum||sha256sum probe) instead of a bare `shasum -a 256 -c` — Linux
  3009	    # hosts may ship only sha256sum. Falls back to the legacy bare form if the
  3010	    # helper was not sourced (partial checkout), preserving today's behavior.
  3011	    if ( cd "$TARGET" && { if command -v _hash_verify_c >/dev/null 2>&1; then _hash_verify_c "$manifest"; else shasum -a 256 -c "$manifest"; fi; } >/dev/null 2>&1 ); then
  3012	      echo "    OK: all installed skills match source manifest"
  3013	    else
  3014	      echo "    ERROR: skill checksums do not match manifest" >&2
  3015	      ( cd "$TARGET" && { if command -v _hash_verify_c >/dev/null 2>&1; then _hash_verify_c "$manifest"; else shasum -a 256 -c "$manifest"; fi; } 2>&1 | grep -v ': OK$' | head -20 ) >&2
  3016	      exit 5
  3017	    fi
  3018	  fi
  3019	fi
  3020	
  3021	# WS4-postinstall-guard: user ceremony must not CREATE or MODIFY anything
  3022	# outside $TARGET/.claude/. Pre-existing adopter files (package.json,
  3023	# README.md, the adopter's own CLAUDE.md, docs/, ...) must be byte-stable.
  3024	if [[ "$CEREMONY" == "user" ]]; then
  3025	  _ws4_bad=""
  3026	  for _ws4_e in "$TARGET"/* "$TARGET"/.[!.]* "$TARGET"/..?*; do
  3027	    [[ -e "$_ws4_e" ]] || continue
  3028	    _ws4_b="$(basename "$_ws4_e")"
  3029	    case "$_ws4_b" in
  3030	      .claude|.git) continue ;;
  3031	    esac
  3032	    # Look up this entry in the pre-snapshot (match on leading "name<TAB>").
  3033	    _ws4_pre=""
  3034	    if [[ -f "$_WS4_PRESNAP" ]]; then
  3035	      _ws4_pre="$(grep -F -- "$(printf '%s\t' "$_ws4_b")" "$_WS4_PRESNAP" 2>/dev/null | head -1 || true)"
  3036	    fi
  3037	    if [[ -z "$_ws4_pre" ]]; then
  3038	      # No pre-snapshot row => this entry was CREATED by install.
  3039	      _ws4_bad="$_ws4_bad created:$_ws4_b"
  3040	      continue
  3041	    fi
  3042	    # Pre-existed. If it is a file, compare size + mtime.
  3043	    if [[ -f "$_ws4_e" ]]; then
  3044	      _ws4_now_sz="$(wc -c < "$_ws4_e" 2>/dev/null | tr -d ' ')"
  3045	      _ws4_now_mt="$(detect_mtime "$_ws4_e" 2>/dev/null || echo 0)"
  3046	      _ws4_pre_sz="$(printf '%s' "$_ws4_pre" | cut -f2)"
  3047	      _ws4_pre_mt="$(printf '%s' "$_ws4_pre" | cut -f3)"
  3048	      if [[ "$_ws4_now_sz" != "$_ws4_pre_sz" || "$_ws4_now_mt" != "$_ws4_pre_mt" ]]; then
  3049	        _ws4_bad="$_ws4_bad modified:$_ws4_b"
  3050	      fi
  3051	    fi
  3052	  done
  3053	  if [[ -n "$_ws4_bad" ]]; then
  3054	    echo "ERROR: --ceremony user touched paths outside .claude/:$_ws4_bad" >&2
  3055	    rm -f "$_WS4_PRESNAP"
  3056	    exit 3
  3057	  fi
  3058	  rm -f "$_WS4_PRESNAP"
  3059	fi
