  1134	        || [ -n "${_wbm_rt_dest:-}" ]; do
  1135	    if [ -z "${_wbm_rt_dest:-}" ]; then continue; fi
  1136	    case "$_wbm_rt_dest" in \#*|dest) continue ;; esac
  1137	    _wbm_rt_n=$(( _wbm_rt_n + 1 ))
  1138	  done < "$_WBM_ROUTES_TSV"
