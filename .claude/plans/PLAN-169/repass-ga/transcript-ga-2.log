+        ""|*/*)     return 1 ;;   # empty, or nested under workflows/
+        .template)  return 1 ;;   # bare suffix, no workflow name
+        *.template) ;;
+        *)          return 1 ;;   # anything GitHub Actions would LOAD
+      esac
+      ;;
+    *) return 1 ;;
+  esac
