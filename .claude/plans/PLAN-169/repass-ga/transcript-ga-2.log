  1515	
  1516	# PLAN-133 E2 — OSV.dev / OSSF malicious-packages supply-chain advisory.
  1517	#
  1518	# OPT-IN + DEFAULT-OFF + NEVER-HANG. With CEO_OSV_GATE unset this is a no-op
  1519	# (we never add latency or network egress to a default install). When an
  1520	# adopter / CI opts in (CEO_OSV_GATE=advisory or =block), this scans the
  1521	# install commands the framework ships (the squad-install / accelerator npx/
  1522	# uvx/pip lines) against OSV.dev for MAL-* advisories via .claude/scripts/
  1523	# osv_check.py.
  1524	#
  1525	# Hard-timeout + offline-safe + fail-OPEN contract:
  1526	#   * A hard `timeout` ceiling (CEO_OSV_TIMEOUT_S, default 4s) wraps the call
  1527	#     so the gate can NEVER out-live or hang a fast install step.
  1528	#   * If neither `timeout`/`gtimeout` nor python3 is present, we SKIP (advisory)
  1529	#     and print a breadcrumb — we never block on missing infra.
  1530	#   * `advisory` mode never changes the install exit status (rc=0 always).
  1531	#   * `block` mode fails the install (rc=4 from this function → caller may halt)
  1532	#     ONLY on a concrete MAL advisory hit. A timeout / unknown / malformed
  1533	#     response is fail-OPEN by contract and never blocks.
  1534	osv_supply_chain_advisory() {
  1535	  local mode="${CEO_OSV_GATE:-}"
  1536	  case "$mode" in
  1537	    advisory|block) ;;
  1538	    *) return 0 ;;  # default-OFF: opted out, no-op
  1539	  esac
  1540	
  1541	  local checker="$SOURCE_DIR/.claude/scripts/osv_check.py"
  1542	  if [[ ! -f "$checker" ]]; then
  1543	    echo "    SKIP: osv_check.py absent — supply-chain advisory not run" >&2
  1544	    return 0
  1545	  fi
  1546	  if ! command -v python3 >/dev/null 2>&1; then
  1547	    echo "    SKIP: python3 absent — supply-chain advisory not run" >&2
  1548	    return 0
  1549	  fi
  1550	
  1551	  # Hard-timeout wrapper. Prefer GNU `timeout`, fall back to macOS `gtimeout`,
  1552	  # else run bare (osv_check.py has its own per-request hard ceiling, so even
  1553	  # without an outer `timeout` the call is bounded).
  1554	  local timeout_s="${CEO_OSV_TIMEOUT_S:-4}"
  1555	  local outer_budget=$(( ${timeout_s%.*} + 6 ))   # request budget + slack
  1556	  local TO=()
  1557	  if command -v timeout >/dev/null 2>&1; then
  1558	    TO=(timeout -k 2 "${outer_budget}s")
  1559	  elif command -v gtimeout >/dev/null 2>&1; then
  1560	    TO=(gtimeout -k 2 "${outer_budget}s")
  1561	  fi
  1562	
  1563	  echo ""
  1564	  echo "==> Supply-chain advisory (OSV.dev / OSSF malicious-packages) — mode=$mode"
  1565	  _state_record_op "supply_chain_advisory" "mode=$mode"
  1566	
  1567	  # The framework ships no third-party runtime installs of its own (stdlib
  1568	  # only). The surface this gate guards is the set of install commands an
  1569	  # adopter/squad may run; we feed those that are statically known. For the
  1570	  # framework install itself there is nothing to query, so this is a wired,
  1571	  # exercised, never-hang code path with an empty default target list.
  1572	  local cmd rc
  1573	  local -a OSV_TARGET_COMMANDS=()
  1574	  # Adopters / squad-install pass commands via CEO_OSV_COMMANDS (newline-sep).
  1575	  if [[ -n "${CEO_OSV_COMMANDS:-}" ]]; then
  1576	    while IFS= read -r cmd; do
  1577	      [[ -n "$cmd" ]] && OSV_TARGET_COMMANDS+=("$cmd")
  1578	    done <<< "${CEO_OSV_COMMANDS}"
  1579	  fi
  1580	
  1581	  if [[ ${#OSV_TARGET_COMMANDS[@]} -eq 0 ]]; then
  1582	    echo "    (no install commands to scan — framework runtime is stdlib-only)"
  1583	    return 0
  1584	  fi
  1585	
  1586	  local blocked=0
  1587	  for cmd in "${OSV_TARGET_COMMANDS[@]}"; do
  1588	    rc=0
  1589	    if [[ ${#TO[@]} -gt 0 ]]; then
  1590	      CEO_OSV_GATE="$mode" "${TO[@]}" python3 "$checker" --command "$cmd" || rc=$?
  1591	    else
  1592	      CEO_OSV_GATE="$mode" python3 "$checker" --command "$cmd" || rc=$?
  1593	    fi
  1594	    # rc=124 → outer `timeout` fired (hung request) → fail-OPEN (advisory-skip).
  1595	    if [[ "$rc" -eq 124 ]]; then
  1596	      echo "    TIMEOUT: OSV query exceeded ${outer_budget}s — fail-open (advisory-skip)" >&2
  1597	    elif [[ "$rc" -eq 3 ]]; then
  1598	      # block-mode MAL hit (osv_check returns 3).
  1599	      echo "    BLOCKED: malicious-package advisory for an install target" >&2
  1600	      blocked=1
  1601	    fi
  1602	  done
  1603	
  1604	  if [[ "$mode" == "block" && "$blocked" -eq 1 ]]; then
  1605	    return 4
  1606	  fi
  1607	  return 0
  1608	}
  1609	
  1610	# PLAN-014 Phase A.8 (ADJ-042) — policy-as-code bundle. Ships the YAML
  1611	# policy files + fixtures + drift-manifest. settings.json keeps pointing
  1612	# to the legacy .py hooks (ADJ-014 dual-path); adopters opt-in to the
  1613	# YAML path by editing settings.json post-install after reviewing the
  1614	# shadow-mode guide in docs/.
  1615	install_policies_bundle() {
  1616	  if [[ ! -d "$SOURCE_DIR/.claude/policies" ]]; then
  1617	    return 0
