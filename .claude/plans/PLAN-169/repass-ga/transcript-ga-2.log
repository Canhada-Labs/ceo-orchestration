  1125	  # only one of the two refused, `routes == rows` could be satisfied by two
  1126	  # numbers derived from different premises, which is exactly the agreed-upon
  1127	  # undercount round 4 F4 closed.
  1128	  _wbm_route_table_gate || { printf '0\n'; return 2; }
