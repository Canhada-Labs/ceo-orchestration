   672	  fi
   673	fi
   674	
   675	# Resolve TARGET to absolute form. Real installs cd into the dir;
   676	# dry-runs use realpath -m (path may not exist on disk yet).
   677	if [[ "$DRY_RUN" -eq 1 && ! -d "$TARGET" ]]; then
   678	  if command -v realpath >/dev/null 2>&1; then
   679	    TARGET="$( realpath -m "$TARGET" 2>/dev/null || realpath "$TARGET" 2>/dev/null || echo "$TARGET" )"
   680	  fi
   681	else
   682	  TARGET="$( cd "$TARGET" && pwd )"
   683	fi
