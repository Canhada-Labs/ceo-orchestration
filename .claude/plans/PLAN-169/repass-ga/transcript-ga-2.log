   986	# Run-level verdict. Called once, after every writer, before the manifest is
   987	# written — a destination the installer refused must never be recorded as a
   988	# framework-owned delivery.
   989	_dst_refusal_verdict() {
   990	  [[ "$_DST_REFUSAL_COUNT" -gt 0 ]] || return 0
   991	  echo "" >&2
   992	  echo "::error::install FAILED — $_DST_REFUSAL_COUNT destination(s) refused because writing them would have escaped $TARGET:" >&2
   993	  local line
   994	  while IFS= read -r line; do
   995	    [[ -n "$line" ]] && echo "::error::  $line" >&2
   996	  done <<< "$_DST_REFUSALS"
   997	  echo "::error::Nothing was written at those paths. Remove the symlink or hard link (or point it inside the target) and re-run." >&2
   998	  return 1
   999	}
