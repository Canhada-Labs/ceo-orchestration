  1482	  _state_record_op "install_scripts" "selective"
  1483	  # PLAN-085 Wave A.1 (F-A-QA-0001-c7f21a3e): *.yaml extension added to
  1484	  # the glob so policy/config YAMLs co-located with scripts/ ship to
  1485	  # adopters. Without this, files like smart-loading-cap-table.yaml
  1790	
