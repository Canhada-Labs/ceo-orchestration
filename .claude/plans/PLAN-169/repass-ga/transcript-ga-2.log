  1065	  # a corrupted header a NAMED delivery failure: zero destinations enumerated
  1066	  # => routes=0 => upgrade.sh's AC-9 precondition refuses the whole delivery
  1067	  # with exit 3, instead of the readers walking data rows under a header that
  1068	  # no longer says what the columns mean.
  1069	  _wbm_route_table_gate || return 2
  1070	  # rail round-4 F4 — see the note on _wbm_route_src: an unterminated final row
  1071	  # is READ, not dropped. This loop and _wbm_route_rows_total are the numerator
  1072	  # and the denominator of the AC-9 precondition, so they must agree about
  1073	  # WHICH rows exist for the comparison to mean anything.
  1074	  while IFS="$( printf '\t' )" read -r _wbm_rd_dest _wbm_rd_src _wbm_rd_rest \
  1075	        || [ -n "${_wbm_rd_dest:-}" ]; do
  1076	    if [ -z "${_wbm_rd_dest:-}" ]; then continue; fi
  1077	    case "$_wbm_rd_dest" in \#*|dest) continue ;; esac
  1078	    _wbm_route_row_ok "$_wbm_rd_dest" "${_wbm_rd_src:-}" || continue
  1079	    printf '%s\n' "$_wbm_rd_dest"
  1080	  done < "$_WBM_ROUTES_TSV"
  1081	}
