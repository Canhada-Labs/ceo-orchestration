  1248	# --- rail round-6 F2: the table PRECONDITION, for every reader -------------
  1249	# Round 4 F3 put _wbm_route_table_ok in front of doctor.sh only. MEASURED
  1250	# pre-cure (S327) on the other two readers: with the header row deleted — or
  1251	# with its 2nd/3rd column names corrupted to anything but `src`/`transform` —
  1252	# _wbm_route_meta and _wbm_route_dests happily consumed the DATA rows,
  1253	# _wbm_route_rows_total counted the same rows, `routes == rows` held, and a
  1254	# real upgrade DELIVERED and exited 0. A header is not decoration: it is the
  1255	# statement that column 2 means "source" and column 3 means "transform", and
  1256	# without it the rows are an unlabelled tuple the reader is guessing at.
  1257	#
  1258	# So the question moves to where every reader already passes: this gate. One
  1259	# implementation, three call sites (the three loops that open the table), and
  1260	# the oracles assert that a fourth loop cannot be added without one — the
  1261	# alternative, a gate per caller, is the private copy this whole wave deletes.
  1262	#
  1263	# MEMOISED, and the memo is keyed on the table PATH. Not an optimisation for
  1264	# its own sake: doctor.sh asks _wbm_route_src once per manifest record and a
  1265	# full extra pass over the table per record measured ~20 ms each on this
  1266	# machine — hundreds of records means seconds of pure re-reading. Keying on
  1267	# the path is safe because, with the environment channel gone (round 6 F3),
  1268	# the path changes at most once per process: upgrade.sh's snapshot re-point,
  1269	# which the key observes. The named line is therefore printed ONCE per
  1270	# verdict, not once per record — a wall of identical errors is its own kind of
  1271	# silence.
  1272	_WBM_ROUTE_GATE_FOR=""
  1273	_WBM_ROUTE_GATE_RC=""
  1274	_wbm_route_table_gate() {
  1275	  if [ "${_WBM_ROUTE_GATE_FOR:-}" = "${_WBM_ROUTES_TSV:-}" ] && [ -n "${_WBM_ROUTE_GATE_RC:-}" ]; then
  1276	    return "$_WBM_ROUTE_GATE_RC"
  1277	  fi
  1278	  _WBM_ROUTE_GATE_FOR="${_WBM_ROUTES_TSV:-}"
  1279	  if _wbm_route_table_ok; then
  1280	    _WBM_ROUTE_GATE_RC=0
  1281	  else
  1282	    _WBM_ROUTE_GATE_RC=1
  1283	    echo "    ERROR: delivery-route table REFUSED — ${_WBM_ROUTE_TABLE_WHY:-unknown reason}" >&2
  1284	    echo "           Every reader now answers fail-closed and enumerates ZERO routes." >&2
  1285	    echo "           Expected a 'dest<TAB>src<TAB>transform' header and at least one data" >&2
  1286	    echo "           row. docs/ and .github/ are NOT delivered, and nothing is repaired" >&2
  1287	    echo "           or recorded through the identity fallback (that fallback IS D3)." >&2
  1288	  fi
  1289	  return "$_WBM_ROUTE_GATE_RC"
  1290	}
