  2282	    echo "       Aborting install (rc=3) because the --stack flag was explicitly supplied." >&2
  2283	    return 3
  2284	  else
  2285	    echo "    WARNING: jq not found — using base only. Install jq and re-run to merge stack hooks." >&2
  2286	    cp "$BASE_SRC" "$SETTINGS_DST"
  2287	    return 0
  2288	  fi
