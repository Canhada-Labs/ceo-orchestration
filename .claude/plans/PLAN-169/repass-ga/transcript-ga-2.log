+    _WBM_SRC_CONFINE_WHY="empty source root or source relpath"
+    return 1
+  fi
+  if ! _wbm_route_relpath_ok "$_wbm_sc_rel"; then
+    _WBM_SRC_CONFINE_WHY="'$_wbm_sc_rel' is not a confined relative path"
+    return 1
+  fi
