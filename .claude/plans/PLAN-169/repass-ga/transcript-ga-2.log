   864	# — which runs NEITHER delivery function — recorded that adopter file as
   865	# framework-owned in .claude/.install-manifest.sha256, and a manifest-honouring
   866	# uninstall deletes on a hash match. The three flags below were the same class,
   867	# latent for the same reason; a family is swept when one of its members is.
   868	# Reset here, next to the flags above, so every entry point starts from zero.
   869	_DELIVERED_PLAN_SCHEMA=0
