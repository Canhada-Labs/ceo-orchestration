  1948	# ---- 5e. .github/ templates (PLAN-003 Phase 0 I-3) ----
  1949	
  1950	# PLAN-185 W2 — render {{OWNER_HANDLE}} with NO substitution LANGUAGE involved.
  1951	#
  1952	# The pre-cure form was `sed "s/{{OWNER_HANDLE}}/$GITHUB_OWNER/g"`, which puts
  1953	# the value inside a sed PROGRAM: a `/` ends the s-command, `&` re-inserts the
  1954	# match, `\` escapes. Escaping the value would only make the interpolation
  1955	# survivable; this removes the interpolation. The marker is a literal, `{` and
  1956	# `}` are not bash pattern metacharacters, and the replacement side of `${//}`
  1957	# has no active characters at all — so no value can change what this program
  1958	# DOES, only what it writes. That is also why the census stops seeing a
  1959	# sed-interpolation site here: the site is gone, not escaped.
  1960	#
  1961	# `|| [[ -n "$line" ]]` keeps a final line that lacks its newline (the shipped
  1962	# template ends with one — measured, 1442 bytes / 33 lines / 11 markers).
  1963	_render_owner_handle() {
  1964	  local _roh_src="$1" _roh_handle="$2"
  1965	  local _roh_marker='{{OWNER_HANDLE}}'
  1966	  local _roh_line
  1967	  while IFS= read -r _roh_line || [[ -n "$_roh_line" ]]; do
  1968	    printf '%s\n' "${_roh_line//$_roh_marker/$_roh_handle}"
  1969	  done < "$_roh_src"
  1970	}
  1971	
  1972	# PLAN-185 W2 — ATOMIC destination write: stage in the DESTINATION directory,
  1973	# set the mode on that inode, then rename(2) over the destination.
  1974	#
  1975	# Same directory is a requirement, not a preference: rename(2) cannot cross
  1976	# filesystems, so staging in $TMPDIR (what the pre-cure probe did) degrades
  1977	# `mv` to copy+unlink and re-opens the very 0-byte window this wave exists to
  1978	# close. The name is UNPREDICTABLE (mktemp), because a fixed one inside the
  1979	# target is a path an attacker can pre-plant — the defect portable_sed_inplace
  1980	# still had. `chmod 0644` is explicit: mktemp creates 0600, and a CODEOWNERS
  1981	# the team cannot read is a regression that byte and line counts do not catch.
  1982	# The destination is only ever touched by the rename, so EVERY failure path
  1983	# leaves it exactly as it was — including untouched when it did not exist.
  1984	# rc 0 = delivered.
  1985	_write_rendered_codeowners() {
  1986	  local _wrc_src="$1" _wrc_handle="$2" _wrc_dst="$3"
  1987	  local _wrc_rel="${_wrc_dst#"$TARGET"/}"
  1988	  local _wrc_dir _wrc_tmp
  1989	  _wrc_dir="$( dirname "$_wrc_dst" )"
  1990	  if ! mkdir -p "$_wrc_dir" 2>/dev/null; then
  1991	    _dst_record_refusal "$_wrc_rel" "could not create $_wrc_dir"
  1992	    return 1
  1993	  fi
  1994	  _wrc_tmp="$( mktemp "$_wrc_dir/.ceo-codeowners.XXXXXX" 2>/dev/null || true )"
  1995	  if [[ -z "$_wrc_tmp" ]]; then
  1996	    _dst_record_refusal "$_wrc_rel" "could not stage the render in $_wrc_dir (mktemp failed)"
  1997	    return 1
  1998	  fi
  1999	  _ATOMIC_TMP_PENDING="$_wrc_tmp"
  2000	  if ! _render_owner_handle "$_wrc_src" "$_wrc_handle" > "$_wrc_tmp" 2>/dev/null; then
  2001	    rm -f "$_wrc_tmp"; _ATOMIC_TMP_PENDING=""
  2002	    _dst_record_refusal "$_wrc_rel" "rendering failed — the destination was NOT touched"
  2003	    return 1
  2004	  fi
  2005	  chmod 0644 "$_wrc_tmp" 2>/dev/null || true
  2006	  if ! mv -f "$_wrc_tmp" "$_wrc_dst" 2>/dev/null; then
  2007	    rm -f "$_wrc_tmp"; _ATOMIC_TMP_PENDING=""
  2008	    _dst_record_refusal "$_wrc_rel" "could not move the staged render into place — the destination was NOT touched"
  2009	    return 1
  2010	  fi
  2011	  _ATOMIC_TMP_PENDING=""
  2012	  return 0
  2013	}
  2014	
  2015	# NOTE (rail round-1 P1): a `_read_target_install_state_github_owner` used to
  2016	# live here, reading the persisted handle so it could be offered as provenance.
  2017	# It is GONE rather than merely unused. The recorded handle is evidence of a
  2018	# REQUEST, never of a delivery, and leaving the reader in place as dead code is
  2019	# an invitation to wire it back into the recovery branch — which is exactly the
  2020	# defect the rail reproduced. The handle is still validated where it is actually
  2021	# needed: at the flag parse, before the render, and before it is persisted.
  2022	
  2023	# PLAN-185 W2 / OQ-1 — can this framework PROVE it wrote .github/CODEOWNERS in
  2024	# this target? Prints the evidence that fired (so the recovery line names it);
  2025	# rc 1 = no evidence.
  2026	#
  2027	# EXACTLY ONE kind of evidence counts: a DELIVERY RECORD. The baseline manifest
  2028	# gets a `.github/CODEOWNERS` row only when a writer actually rendered the file
  2029	# (_append_delivered_template -> FMS_DELIVERED_TEMPLATES -> the manifest); when
  2030	# the install SKIPS an adopter-owned file, no row appears. Measured both ways:
  2031	# 1 row after a real delivery, 0 rows after an EXISTS-skip.
  2032	#
  2033	# A recorded `github_owner` was ALSO accepted here until rail round-1, and it is
  2034	# NOT evidence of delivery — it is evidence of a REQUEST. The two come apart in
  2035	# a case that is ordinary rather than exotic, and it was REPRODUCED: an adopter
  2036	# with their own non-empty `.github/CODEOWNERS` runs the installer with
  2037	# `--github-owner`; the file is skipped (their bytes survive, correctly) but the
  2038	# owner is persisted anyway. Later the adopter empties that file deliberately —
  2039	# which is how you switch mandatory review routing off without deleting the path
  2040	# — and the next install read the persisted owner as proof of authorship and
  2041	# re-rendered 1409 bytes of framework template over it, silently re-enabling
  2042	# review routing in a repository this framework never wrote to. That is the
  2043	# PLAN-183 D4 class, and the whole reason OQ-1 requires provenance rather than
  2044	# byte count: asking "did we ask for this?" instead of "did we write this?"
  2045	# reintroduces the defect one question earlier.
  2046	_codeowners_provenance() {
  2047	  local _cp_manifest="$TARGET/.claude/.install-manifest.sha256"
  2048	  if [[ -f "$_cp_manifest" ]] \
  2049	     && grep -q '  \.github/CODEOWNERS$' "$_cp_manifest" 2>/dev/null; then
  2050	    printf 'the baseline manifest (.claude/.install-manifest.sha256) records .github/CODEOWNERS as a framework delivery'
  2051	    return 0
  2052	  fi
  2053	  return 1
  2054	}
  2055	
  2056	install_github_templates() {
  2057	  echo ""
  2058	  echo "==> Installing .github/ templates"
  2059	  _state_record_op "install_github_templates" ""
  2060	
  2061	  local codeowners_src="$SOURCE_DIR/templates/.github/CODEOWNERS.template"
  2062	  # rail round-7 F2 — this source is read by the render and by `cmp` (the
  2063	  # EXISTS byte-compare), both of which follow symlinks. Confine it first.
  2064	  if _install_src_refuses "templates/.github/CODEOWNERS.template"; then
  2065	    codeowners_src=""
  2066	  fi
  2067	
  2068	  # PLAN-185 W1 — pre-flight EVERY destination of this group. The CODEOWNERS
  2069	  # destination is itself an F1 site (debate C3): the `-e "$dst"` below follows
  2070	  # the link, the old `mkdir -p "$TARGET/.github"` checked no components, and
  2071	  # the render used `>`. Which of the two mutually exclusive CODEOWNERS
  2072	  # destinations is in play depends on the handle, exactly as the branches do.
  2073	  local _co_dst_rel=".github/CODEOWNERS"
  2074	  [[ -n "$GITHUB_OWNER" ]] || _co_dst_rel=".github/CODEOWNERS.template"
  2075	  if ! _dst_preflight "$_co_dst_rel" \
  2076	                      ".github/workflows/validate.yml.template" \
  2077	                      ".github/workflows/benchmarks.yml.template"; then
  2078	    return
  2079	  fi
  2080	
  2081	  if [[ -z "$codeowners_src" ]]; then
  2082	    echo "    SKIP (CODEOWNERS.template source refused — not confined to the framework checkout)"
  2083	  elif [[ ! -f "$codeowners_src" ]]; then
  2084	    echo "    SKIP (CODEOWNERS.template missing at $codeowners_src)"
  2085	  elif [[ -n "$GITHUB_OWNER" ]]; then
  2086	    local dst="$TARGET/.github/CODEOWNERS"
  2087	    # PLAN-185 W2 — GITHUB_OWNER is a global, and the flag parse is not the
  2088	    # only way it can be set. Re-validate through the SHARED grammar at the
  2089	    # boundary that RENDERS, so no path reaches the substitution unvalidated.
  2090	    _assert_github_owner_grammar "$GITHUB_OWNER" "the recorded GitHub owner"
  2091	    if [[ "$DRY_RUN" -eq 1 ]]; then
  2092	      if [[ -e "$dst" ]]; then
  2093	        echo "    (dry-run) EXISTS (would skip): .github/CODEOWNERS"
  2094	      else
  2095	        echo "    (dry-run) would SUBSTITUTE + write: .github/CODEOWNERS (@$GITHUB_OWNER)"
  2096	      fi
  2097	    elif [[ -e "$dst" && ! -s "$dst" ]]; then
  2098	      # PLAN-185 W2 / OQ-1 — a 0-byte CODEOWNERS is the signature of the defect
  2099	      # this wave closes (the `>` truncated the file, then `sed` aborted on the
  2100	      # delimiter), and it is ALSO how an adopter deliberately switches
  2101	      # mandatory review routing off without deleting the path. Size cannot
  2102	      # tell those apart, so PROVENANCE decides: re-render only where the
  2103	      # framework can prove it wrote this file, and say which evidence fired.
  2104	      local _co_prov=""
  2105	      if _co_prov="$( _codeowners_provenance )" && [[ -n "$_co_prov" ]]; then
  2106	        if _write_rendered_codeowners "$codeowners_src" "$GITHUB_OWNER" "$dst"; then
  2107	          echo "    RECOVERED: .github/CODEOWNERS was 0 bytes and $_co_prov — re-rendered (@$GITHUB_OWNER)"
  2108	          _state_record_op "recover_codeowners" ".github/CODEOWNERS"
  2109	          _append_delivered_template ".github/CODEOWNERS"
  2110	        fi
  2111	      else
  2112	        echo "    WARNING: .github/CODEOWNERS exists and is EMPTY, and nothing proves this framework wrote it — leaving it untouched." >&2
  2113	        echo "             GitHub reads an empty CODEOWNERS as 'no owners'. If that is not what you want:" >&2
  2114	        echo "               * run scripts/doctor.sh on this target to see what the framework believes it delivered; then" >&2
  2115	        echo "               * delete the file and re-run scripts/install.sh --github-owner <handle>, or write the owners by hand." >&2
  2116	        echo "             Re-rendering it here would silently re-enable review routing in a repository this framework cannot prove it owns." >&2
  2117	      fi
  2118	    elif [[ -e "$dst" ]]; then
  2119	      echo "    EXISTS (skipping): .github/CODEOWNERS"
  2120	      # PLAN-183 W5 (D3): byte-compare against the RENDERED bytes — the form
  2121	      # actually delivered — never against the .template source. An adopter
  2122	      # file that happened to match the UNRENDERED template is not a framework
  2123	      # delivery, and claiming it would put the adopter's CODEOWNERS under
  2124	      # framework ownership.
  2125	      # PLAN-185 W2: rendered on a PIPE. The pre-cure probe staged this in
  2126	      # $TMPDIR with `sed`, so an out-of-grammar handle aborted it in silence
  2127	      # (2>/dev/null), the `cmp` never ran, and the OWNERSHIP verdict flipped —
  2128	      # the upgrade then landed on PRESERVED (unclaimed) (debate C8).
  2129	      if _render_owner_handle "$codeowners_src" "$GITHUB_OWNER" | cmp -s - "$dst" 2>/dev/null; then
  2130	        _append_delivered_template ".github/CODEOWNERS"
  2131	      fi
  2132	    else
  2133	      if _write_rendered_codeowners "$codeowners_src" "$GITHUB_OWNER" "$dst"; then
  2134	        echo "    SUBSTITUTED: .github/CODEOWNERS (@$GITHUB_OWNER)"
  2135	        _append_delivered_template ".github/CODEOWNERS"
  2136	      fi
  2137	    fi
  2138	  else
  2139	    install_docs_template \
  2140	      "templates/.github/CODEOWNERS.template" \
  2141	      ".github/CODEOWNERS.template"
  2142	    _register_delivered_template \
  2143	      ".github/CODEOWNERS.template" \
  2144	      "templates/.github/CODEOWNERS.template"
  2145	  fi
  2146	
  2147	  install_docs_template \
  2148	    "templates/.github/workflows/validate.yml.template" \
  2149	    ".github/workflows/validate.yml.template"
  2150	  _register_delivered_template \
  2151	    ".github/workflows/validate.yml.template" \
  2152	    "templates/.github/workflows/validate.yml.template"
  2153	  install_docs_template \
  2154	    "templates/.github/workflows/benchmarks.yml.template" \
  2155	    ".github/workflows/benchmarks.yml.template"
  2156	  _register_delivered_template \
  2157	    ".github/workflows/benchmarks.yml.template" \
  2158	    "templates/.github/workflows/benchmarks.yml.template"
  2159	}
