  1335	    echo "           unusable (${_WBM_ROUTE_TABLE_WHY:-unknown reason})." >&2
  1336	    echo "           Every source would resolve through the identity fallback, which is" >&2
  1337	    echo "           defect D3; the manifest already on disk is left as it stands." >&2
