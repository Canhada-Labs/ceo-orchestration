   223	        echo "    ERROR: delivered-template entries REJECTED — route-table whitelist unavailable (fail-closed)" >&2
   224	      else
   225	        printf '%s\n' "$FMS_DELIVERED_TEMPLATES" | while IFS= read -r _fms_tpl; do
   226	          [ -n "$_fms_tpl" ] || continue
   227	          # rail round-1 F2/F4 — FMS_DELIVERED_TEMPLATES arrives through the
   228	          # ENVIRONMENT, so it is untrusted here exactly as the route table is.
   229	          # An absolute or `..`-bearing entry would enter the manifest as a
   230	          # framework-owned path outside the install, which a manifest-honouring
   231	          # uninstall then acts on. Same predicate, one place.
   232	          if ! _wbm_route_relpath_ok "$_fms_tpl"; then
   233	            echo "    ERROR: delivered-template entry REJECTED (not a confined relative path): '$_fms_tpl'" >&2
