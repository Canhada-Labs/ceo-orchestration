  1029	# The IDENTITY projection of _wbm_route_meta: the source relpath, and only for
  1030	# a route the framework copies VERBATIM.
  1031	#   rc 0 = identity route, source relpath on stdout
  1032	#   rc 1 = no row (callers keep today's behaviour: "$root/$rel")
  1033	#   rc 2 = RENDERED, or malformed => there are no framework source bytes to
  1034	#          hash. `${transform}` is compared against the literal `identity` and
  1035	#          nothing else: `:-identity` as a DEFAULT was the rail S325 fail-OPEN
  1150	# file) into an adopter tree. A caller that must not degrade to identity asks
  1151	# THIS question once, at startup, before any verdict is computed.
  1152	#
  1153	# It lives here, next to the reader, for the reason the whole wave exists: the
  1154	# shape of the table is knowledge the table's owner holds. doctor growing its
  1155	# own header parser is exactly the private copy W6 deleted.
  1156	#
  1157	# Checked: readable regular file; a header row whose first three fields are
  1158	# `dest`, `src`, `transform`; and at least one DATA row. An empty-but-present
  1159	# table is not a degenerate success — it is a file that would silently deliver
  1160	# and repair nothing.
  1161	_wbm_route_table_ok() {
  1162	  _wbm_tok_tbl="${_WBM_ROUTES_TSV:-}"
  1163	  _wbm_tok_why=""
  1164	  _wbm_tok_hdr=0
  1165	  _wbm_tok_rows=0
  1166	  # rc.1 re-pass round 3, part 1 — destinations SEEN so far, wrapped in the
  1167	  # one byte a destination cannot contain (TAB is the field separator), so a
  1168	  # membership test is exact. Quoting the expansion inside `case` keeps the
  1169	  # value literal, which matters: a destination carrying a glob character
  1170	  # would otherwise be matched as a PATTERN.
  1171	  _wbm_tok_seen=""
  1172	  _wbm_tok_tab="$( printf '\t' )"
  1173	  _wbm_tok_dupe=""
  1174	  if [ -z "$_wbm_tok_tbl" ]; then
  1175	    _WBM_ROUTE_TABLE_WHY="_WBM_ROUTES_TSV is empty"
  1176	    return 1
  1177	  fi
  1178	  # rc.1 re-pass part 2 P1 — `-f` FOLLOWS symlinks, so the gate below claimed
  1179	  # to require a regular file while a symlinked table was read (and, on the
  1180	  # upgrade path, snapshotted) with no evidence left that its bytes came from
  1181	  # outside the checkout. A well-formed external table can reroute an absent
  1182	  # `.github/CODEOWNERS` to another allowed `templates/*` source, and the
  1183	  # upgrade then installs those wrong bytes successfully. The leaf test comes
  1184	  # FIRST: `-f` on a link to a regular file is true, so asking afterwards
  1185	  # would be asking too late. (Symlinked path COMPONENTS and physical
  1186	  # confinement to the executing checkout are the same class and are NOT
  1187	  # closed here — named as an rc.2 item.)
  1188	  if [ -L "$_wbm_tok_tbl" ]; then
  1189	    _WBM_ROUTE_TABLE_WHY="delivery-route table is a symlink (refusing to follow): $_wbm_tok_tbl"
  1190	    return 1
  1191	  fi
  1192	  if [ ! -f "$_wbm_tok_tbl" ]; then
  1193	    _WBM_ROUTE_TABLE_WHY="not a readable file: $_wbm_tok_tbl"
  1194	    return 1
  1195	  fi
  1196	  if [ ! -r "$_wbm_tok_tbl" ]; then
  1197	    _WBM_ROUTE_TABLE_WHY="not readable (permissions): $_wbm_tok_tbl"
  1198	    return 1
  1199	  fi
  1200	  while IFS="$( printf '\t' )" read -r _wbm_tok_a _wbm_tok_b _wbm_tok_c _wbm_tok_rest \
  1201	        || [ -n "${_wbm_tok_a:-}" ]; do
  1202	    if [ -z "${_wbm_tok_a:-}" ]; then continue; fi
  1203	    case "$_wbm_tok_a" in \#*) continue ;; esac
  1204	    if [ "$_wbm_tok_a" = "dest" ]; then
  1205	      if [ "${_wbm_tok_b:-}" = "src" ] && [ "${_wbm_tok_c:-}" = "transform" ]; then
  1206	        _wbm_tok_hdr=1
  1207	      else
  1208	        _wbm_tok_why="header row is 'dest' but its 2nd/3rd fields are '${_wbm_tok_b:-}'/'${_wbm_tok_c:-}', not 'src'/'transform'"
  1209	      fi
  1210	      continue
  1211	    fi
  1212	    _wbm_tok_rows=$(( _wbm_tok_rows + 1 ))
  1213	    # rc.1 re-pass round 3, part 1 — a DUPLICATE destination is ambiguous
  1214	    # input, and the readers disagreed about it. `_wbm_route_dests` emits
  1215	    # both rows, so routes == rows and the conservation law holds, but every
  1216	    # consumer then asks `_wbm_route_src <dest>`, whose reader stops at the
  1217	    # FIRST match: the first row runs twice, the second is silently ignored,
  1218	    # and the run exits 0. The Python parity reader already refuses this
  1219	    # (`scripts/tests/_parity_classify.py`), so the shell and Python halves of
  1220	    # the same contract answered differently on exactly the input where
  1221	    # ambiguity matters. Refused HERE, in the one gate every reader passes,
  1222	    # so no consumer ever sees a table it would read two ways.
  1223	    case "$_wbm_tok_seen" in
  1224	      *"$_wbm_tok_tab$_wbm_tok_a$_wbm_tok_tab"*)
  1225	        [ -n "$_wbm_tok_dupe" ] || _wbm_tok_dupe="$_wbm_tok_a"
  1226	        ;;
  1227	      *)
  1228	        _wbm_tok_seen="$_wbm_tok_seen$_wbm_tok_tab$_wbm_tok_a$_wbm_tok_tab"
  1229	        ;;
  1230	    esac
  1231	  done < "$_wbm_tok_tbl"
  1232	  if [ -n "$_wbm_tok_dupe" ]; then
  1233	    _WBM_ROUTE_TABLE_WHY="duplicate destination '$_wbm_tok_dupe' (a destination declared twice is read one way by _wbm_route_src and another by the enumeration): $_wbm_tok_tbl"
  1234	    return 1
  1235	  fi
  1236	  if [ "$_wbm_tok_hdr" -ne 1 ]; then
  1237	    _WBM_ROUTE_TABLE_WHY="${_wbm_tok_why:-no 'dest<TAB>src<TAB>transform' header row}: $_wbm_tok_tbl"
  1238	    return 1
  1239	  fi
  1240	  if [ "$_wbm_tok_rows" -lt 1 ]; then
  1241	    _WBM_ROUTE_TABLE_WHY="header present but ZERO data rows: $_wbm_tok_tbl"
  1242	    return 1
  1243	  fi
  1244	  _WBM_ROUTE_TABLE_WHY=""
  1245	  return 0
  1246	}
