  2684	# P1-CR-3 / VP-F1: placeholder substitution pass
  2685	# ----------------------------------------------------------------------
  2686	# Iterate over a deterministic list of placeholder files (the ones
  2687	# templates/ writes out) and apply `sed -i` substitutions for every
  2688	# PH_* variable that is non-empty. Anything left as `{{...}}` after the
  2689	# pass is reported with a stderr warning.
  2690	#
  2691	# We restrict the pass to files install.sh actually placed (the
  2692	# templates/* files) to avoid touching user-authored content. If
  2693	# CLAUDE.md / MEMORY.md already existed at target, we leave them alone
  2694	# (install.sh never overwrites them).
  2695	
  2696	# The octal mode of a path, or EMPTY when it cannot be read. GNU-first with the
  2697	# output VALIDATED: on GNU, `stat -f` SUCCEEDS printing FILESYSTEM information
  2698	# instead of failing, so an unvalidated fallback chain silently returns a
  2699	# filesystem field where a mode was expected.
  2700	_file_mode() {
  2701	  local _fm_out
  2702	  _fm_out="$( stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || true )"
  2703	  case "$_fm_out" in
  2704	    ''|*[!0-7]*) printf '' ;;
  2705	    *)           printf '%s' "$_fm_out" ;;
  2706	  esac
  2707	}
  2708	
  2709	# Portable sed -i for GNU + BSD (macOS): stage beside the file, then rename.
  2710	portable_sed_inplace() {
  2711	  # $1 = sed script, $2 = file
  2712	  local script="$1" file="$2"
  2713	  local dir tmp mode
  2714	  dir="$( dirname "$file" )"
  2715	
  2716	  # PLAN-185 W1 (writer 6/7) — the staging name is UNPREDICTABLE and lives in
  2717	  # the file's OWN directory. The pre-cure name was `${file}.ceo-sed-tmp`: a
  2718	  # path an attacker can pre-plant as a symlink, so the `>` wrote the
  2719	  # substituted content THROUGH it, outside $TARGET, before the `mv` ever ran —
  2720	  # the same predictable-name defect the plan names at this site. Staging in the
  2721	  # destination directory (never $TMPDIR) also keeps `mv` a rename(2); across
  2722	  # filesystems it degrades to copy+unlink, which re-opens the truncated-
  2723	  # destination window this wave exists to close.
  2724	  tmp="$( mktemp "$dir/.ceo-sed.XXXXXX" 2>/dev/null || true )"
  2725	  if [[ -z "$tmp" ]]; then
  2726	    echo "    ERROR: could not stage the substitution for ${file#$TARGET/} in $dir" >&2
  2727	    return 1
  2728	  fi
  2729	  _ATOMIC_TMP_PENDING="$tmp"
  2730	
  2731	  # mktemp creates 0600, where the pre-cure `>` produced a umask-derived mode.
  2732	  # Carry the ORIGINAL file's mode across instead — that is what `sed -i` does,
  2733	  # and it keeps a delivered file readable by everyone who could read it before.
  2734	  mode="$( _file_mode "$file" )"
  2735	
  2736	  if ! sed "$script" "$file" > "$tmp" 2>/dev/null; then
  2737	    rm -f "$tmp"; _ATOMIC_TMP_PENDING=""
  2738	    echo "    ERROR: substitution failed for ${file#$TARGET/} — left unchanged" >&2
  2739	    return 1
  2740	  fi
  2741	  chmod "${mode:-644}" "$tmp" 2>/dev/null || true
  2742	  if ! mv -f "$tmp" "$file"; then
  2743	    rm -f "$tmp"; _ATOMIC_TMP_PENDING=""
  2744	    echo "    ERROR: could not move the substituted ${file#$TARGET/} into place — left unchanged" >&2
  2745	    return 1
  2746	  fi
  2747	  _ATOMIC_TMP_PENDING=""
  2748	}
