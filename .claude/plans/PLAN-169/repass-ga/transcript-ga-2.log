   950	# rc.1 r12: non-directory ancestor, ANCESTOR-ONLY, for a destination whose
   951	# LEAF policy is owned elsewhere. SPEC/v1 is that case: _ownership_verdict
   952	# decides replacement (PLAN-167) and a `--mode link` delivery leaves a SYMLINK
   953	# there, which _wbm_dst_refuses REFUSES — routing it through _dst_refuses
   954	# would break every link-mode install. An untraversable ancestor is not
   955	# negotiable: an adopter file named SPEC aborted this script at `mkdir` under
   956	# set -e, 387 lines in, with .claude/ already populated.
   957	_dst_ancestor_refuses() {
   958	  local dst_rel="$1"
   959	  local why=""
   960	  if ! command -v _wbm_dst_non_directory_ancestor_refuses >/dev/null 2>&1; then
   961	    why="destination-ancestor predicate unavailable (scripts/_framework_manifest_set.sh not sourced) — refusing rather than guessing"
   962	  elif _wbm_dst_non_directory_ancestor_refuses "$TARGET" "$dst_rel"; then
   963	    why="${_WBM_DST_REFUSE_WHY:-unknown reason}"
   964	  else
   965	    return 1
   966	  fi
   967	  _dst_record_refusal "$dst_rel" "$why"
   968	  return 0
   969	}
