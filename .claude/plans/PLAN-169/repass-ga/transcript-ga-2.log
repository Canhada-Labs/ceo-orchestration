  1311	_write_baseline_manifest() {
  1312	  _wbm_manifest="$1"
  1313	  if ! command -v _framework_manifest_files >/dev/null 2>&1 \
  1314	     || ! command -v _hash_file >/dev/null 2>&1; then
  1315	    echo "    NOTE: baseline manifest skipped — hash/enumeration helpers not sourced" >&2
  1316	    return 0
  1317	  fi
  1318	  : "${FMS_ROOT:?_write_baseline_manifest requires FMS_ROOT}"
  1319	  # PLAN-183 W5 (D3) fail-CLOSED precondition. Enumerating delivered templates
  1320	  # WITHOUT a usable route table would resolve each one as "$root/$rel" —
  1321	  # precisely the D3 defect, arriving silently. The table is INPUT, not
  1322	  # infrastructure (CLAUDE.md §4), so refuse to record rather than record the
  1323	  # wrong bytes; ownership is under-claimed, which is recoverable.
  1324	  #
  1325	  # rail round-6 F2 — the whole WRITE is abandoned, not just the delivered
  1326	  # templates. On the upgrade lane every path under $FMS_HASH_ROOT is resolved
  1327	  # through _wbm_route_src, which now answers rc=2 for ALL of them when the
  1328	  # table is unusable; carrying on would replace a correct manifest with a
  1329	  # near-empty one, and an empty baseline is what uninstall and doctor read
  1330	  # next. Leaving the previous manifest untouched is the recoverable direction.
  1331	  # The old check asked `[ ! -f ]`; the gate asks the same question and four
  1332	  # more (readable, regular, header, ≥1 data row).
  1333	  if ! _wbm_route_table_gate; then
