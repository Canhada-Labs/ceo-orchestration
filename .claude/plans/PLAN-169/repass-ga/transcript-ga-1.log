+                    | sed "s/{{OWNER_HANDLE}}/$_utg_handle/g" \
+                    | _hash_stdin 2>/dev/null || true )"
+    else
+      _utg_hash="$( git -C "$SOURCE_DIR" cat-file blob "$_utg_blob" 2>/dev/null \
+                    | _hash_stdin 2>/dev/null || true )"
+    fi
+    [ -n "$_utg_hash" ] || continue
