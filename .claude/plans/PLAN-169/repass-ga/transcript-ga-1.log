   817	if prof and not re.match(r"^[A-Za-z0-9_,.-]{1,200}$", prof):
   818	    sys.exit(3)
   819	if stack and not re.match(r"^[A-Za-z0-9_.-]{1,100}$", stack):
   820	    sys.exit(3)
