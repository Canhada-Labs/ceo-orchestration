  1384	          *"
  1385	$rel
  1386	"*)
  1387	            case "$_BASELINE_INVALID" in
  1388	              *"
  1389	$rel
  1390	"*) ;;
  1391	              *) _BASELINE_INVALID="$_BASELINE_INVALID
  1392	$rel
  1393	" ;;
  1394	            esac
  1395	            continue ;;
