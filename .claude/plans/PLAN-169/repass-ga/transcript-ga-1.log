  1496	  _cab_src="$( _hash_file "$SOURCE_DIR/$_cab_rel" 2>/dev/null || true )"
  1497	  # If either side cannot be hashed (missing file), fall back to legacy handling.
  1498	  if [ -z "$_cab_dst" ] || [ -z "$_cab_src" ]; then
  1499	    printf 'FALLBACK\n'; return 0
  1500	  fi
  1501	  if [ "$_cab_dst" = "$_cab_src" ]; then
  1502	    printf 'IDENTICAL\n'; return 0
  1503	  fi
  1504	  if [ "$_cab_dst" = "$_cab_base" ] && [ "$_cab_src" != "$_cab_base" ]; then
  1505	    printf 'FRAMEWORK-CHANGED\n'; return 0
  1506	  fi
  1507	  if [ "$_cab_dst" != "$_cab_base" ] && [ "$_cab_src" = "$_cab_base" ]; then
  1508	    printf 'ADOPTER-CUSTOMIZED\n'; return 0
  1509	  fi
  1510	  # Both differ from the baseline.
  1511	  printf 'CONFLICT\n'; return 0
  1512	}
