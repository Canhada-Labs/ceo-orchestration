  1012	# EXISTS-skipped forever. This reader refuses anything that is not a GitHub
  1013	# handle, so upgrade.sh cannot reproduce that defect.
  1014	#
  1015	# PLAN-185 W2 — the GRAMMAR is now consumed, not re-stated. It moved verbatim
  1016	# into scripts/_framework_manifest_set.sh as _wbm_github_handle_ok, and
  1017	# install.sh — the script that PRODUCES the 0-byte defect, and which until this
  1018	# wave accepted --github-owner raw — validates through that same function at its
  1019	# flag parse, before persisting, and before each render. A grammar written twice
  1020	# is a grammar that can answer differently on the two sides of one contract:
  1021	# whatever the writer persists that the reader refuses does not fail loudly, it
  1022	# exits 3 here and degrades the upgrade to an empty handle.
  1023	#
  1024	# python3 still does the JSON work (schema, types, presence); the CHARACTER SET
  1025	# question is answered by the shared predicate. Missing predicate = broken
  1026	# checkout = rc 3, never a local re-implementation.
  1027	_read_install_state_github_owner() {
  1028	  command -v python3 >/dev/null 2>&1 || return 3
  1029	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
  1030	  command -v _wbm_github_handle_ok >/dev/null 2>&1 || return 3
  1031	  _riso_h="$( PYTHONNOUSERSITE=1 python3 -I -c '
  1032	import json, sys
  1033	try:
  1034	    with open(sys.argv[1], "r", encoding="utf-8") as f:
  1035	        d = json.load(f)
  1036	except (OSError, ValueError):
  1037	    sys.exit(3)
  1038	if not isinstance(d, dict) or d.get("schema_version") != 1:
  1039	    sys.exit(3)
  1040	req = d.get("request")
  1041	if not isinstance(req, dict):
  1042	    sys.exit(3)
  1043	h = req.get("github_owner", "")
