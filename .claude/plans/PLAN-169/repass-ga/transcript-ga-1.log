   876	# ===========================================================================
   877	# PLAN-166 F3 (ADR-155-AMEND-1) — resolve the RECORDED install ceremony with
   878	# a reader of its OWN, INDEPENDENT of the replay path: --no-replay sets
   879	# REPLAY=0 and the replay block above (incl. _read_install_state_request) is
   880	# skipped entirely, so if the ceremony rode the replay, the documented
   881	# `upgrade.sh <target> --no-replay` would treat a `--ceremony user` install
   882	# as maintainer and force SPEC/protocol into the adopter's root (r9). This
   883	# reader ALWAYS runs. Fail-SAFE (re-pass rc.4 t3/t5, corrected t9 P2 —
   884	# this comment previously described the OLD maintainer default): state
   885	# absent/unreadable/invalid (ALL pre-Wave-B installs) => "user" — root
   886	# files untouched; a pre-state MAINTAINER opts back in explicitly with
   887	# `--ceremony maintainer` (or CEO_UPGRADE_CEREMONY), and only an explicit
   888	# or recorded value ever persists. Same trust class as the replay reader:
   889	# target-side, UNSIGNED, advisory; the value is validated against the
   890	# closed enum {maintainer,user} and never eval-ed.
   891	# ===========================================================================
   892	_read_install_state_ceremony() {
   893	  command -v python3 >/dev/null 2>&1 || return 3
   894	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
   895	  PYTHONNOUSERSITE=1 python3 -I -c '
   896	import json, sys
   897	try:
   898	    with open(sys.argv[1], "r", encoding="utf-8") as f:
   899	        d = json.load(f)
   900	except (OSError, ValueError):
   901	    sys.exit(3)
