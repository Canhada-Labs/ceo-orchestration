   991	# F-CHAOS-3: match a relative path against the --skip globs list.
   992	# Returns 0 (true) if matched. Also used before the first delivery mutation.
   993	_path_is_skipped() {
   994	  local rel="$1"
   995	  local pattern
   996	  for pattern in "${SKIP_GLOBS[@]:-}"; do
   997	    [[ -n "$pattern" ]] || continue
   998	    # Intentional unquoted glob match (the whole point of --skip patterns).
   999	    # shellcheck disable=SC2053,SC2254
  1000	    case "$rel" in
  1001	      $pattern) return 0 ;;
  1002	    esac
  1003	  done
  1004	  return 1
  1005	}
