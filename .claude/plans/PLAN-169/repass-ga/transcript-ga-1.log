     1	#!/usr/bin/env bash
     2	# upgrade.sh — update an existing ceo-orchestration install in a target repo
     3	#
     4	# Usage:
     5	#   ./upgrade.sh <target-repo-path> [--profile <list>] [--stack <name>]
     6	#                                    [--pin <tag>] [--dry-run]
     7	#                                    [--skip <glob>] [--no-diff-warn]
     8	#                                    [--no-deprecation-warn]
     9	#                                    [--ceremony <maintainer|user>]
    10	#
    11	# What it does:
    12	#   - Backs up the current .claude/team.md, .claude/frontend-team.md, .claude/skills/,
    13	#     .claude/hooks/, .claude/scripts/, .claude/commands/, .claude/pitfalls-catalog.yaml,
    14	#     .claude/task-chains.yaml to .claude.bak/{timestamp}/
    15	#   - (F-CHAOS-3) Before overwriting any adopter file that differs from the source,
    16	#     emits a `diff -q`-style WARNING line (shown on stderr) so the Owner is aware
    17	#     a customization will be replaced. Pass --no-diff-warn to silence.
    18	#     Pass --skip=<glob> to exclude files from the overwrite entirely (one --skip per pattern).
    19	#   - Replaces them with the latest from this repo, respecting --profile and --stack
    20	#   - Leaves CLAUDE.md, MEMORY.md, .claude/agent-metrics.md untouched — those are
    21	#     user-customized files. .claude/settings.json is preserved as-is for its
    22	#     existing keys, but the PLAN-135 W2 settings-merge step (below) ADDITIVELY
    23	#     registers new framework lifecycle hooks into it (idempotent, non-clobbering).
    24	#   - (DevOps-P1-4) Refreshes the PROTOCOL.md pointer to keep it aligned with the
    25	#     current source layout (framework-derived content, not user data).
    26	#   - (PLAN-135 W1 w0r) Pre-flight ADVISORY model-deprecation scan of the target
    27	#     via .claude/scripts/check-model-deprecations.py when present: already-retired
    28	#     or <=60-days-to-retirement Claude model ids emit stderr WARNING lines.
    29	#     NEVER blocks the upgrade — any infra failure degrades to a NOTE (fail-open).
    30	#     Pass --no-deprecation-warn to silence.
    31	#   - (PLAN-135 W2 H8) Idempotent settings-merge step. install.sh EXISTS-SKIPs an
    32	#     existing .claude/settings.json, so a fresh-install-only hook registration
    33	#     never reaches the S217 population of existing adopters. This step registers
    34	#     hook registrations from the shipped template for the selected ceremony
    35	#     and adds missing env defaults to the adopter's settings.json. Unknown
    36	#     ceremony applies only env values shared by both templates. The merge is
    37	#     additive and preserves existing entries; re-applying is a no-op.
    38	#     Fail-open: unavailable JSON tooling, malformed settings or merge error
    39	#     => stderr NOTE + the upgrade proceeds.
    40	#     Pass --no-settings-merge to opt out.
    41	#   - Owner-gated, no-silent-update: this script is NEVER auto-invoked. The Owner
    42	#     runs it explicitly after a deliberate `git pull`; the framework never
    43	#     self-updates or auto-downloads in the background (convergent with kooky's
    44	#     manual-only update checker — see PLAN-125 WS-3c / E5).
    45	#   - (PLAN-153 Wave B item B2) REPLAYS the RECORDED install request: when
    46	#     $TARGET/.claude/.install-state.json (written by install.sh since Wave B;
    47	#     schema ceo.install-state/v1) is present and valid, --profile/--stack
    48	#     DEFAULT to the recorded request.profile/request.stack. Explicit flags
    49	#     always win; --no-replay opts out entirely. BACK-COMPAT (debate C
    50	#     must-fix): a missing state file (every pre-Wave-B install) or an
    51	#     unreadable/invalid one NEVER errors and NEVER no-ops — the upgrade
    52	#     proceeds exactly as before on the ADR-155 path (--dry-run previews +
    53	#     the baseline drift-classifier below preserve/refuse customizations,
    54	#     degrading to diff -q warn-then-clobber when no baseline manifest
    55	#     exists either). After a successful non-dry upgrade the state file is
    56	#     (re)written, so the pre-Wave-B population acquires one (mirrors
    57	#     ADR-155 decision iv for the manifest). Replayed values are charset-
    58	#     validated data — the state file is UNSIGNED and advisory, never a
    59	#     trust anchor, and is never eval-ed.
    60	#   - (PLAN-163 T5.4) BASELINE-AWARE SETTINGS MIGRATION: availableModels,
    61	#     fallbackModel and permissions.defaultMode are migrated with an explicit
    62	#     IDEMPOTENT 3-state policy PER LEAF KEY (absent -> write the new
    63	#     baseline; equal to the OLD baseline (arrays byte-compared, exact order)
    64	#     -> updated to the new baseline; customized -> PRESERVED + a named
    65	#     WARNING). The new DirectoryAdded/Notification hook registrations are
    66	#     added only when not yet registered AND the T3.4 version-floor feature
    67	#     gate is on; customized registrations under the same events are always
    68	#     preserved. Opt out with --no-settings-migrate. Oracles derive their
    69	#     expectations from `upgrade.sh --print-settings-baselines` (the
    70	#     normative table IS the artifact — literals are never re-hardcoded).
    71	#   - (PLAN-164 W1, ADR-110-AMEND-1) PAIR-RAIL REGISTRATION-TIMEOUT VALUE
    72	#     MIGRATION: the check_pair_rail.py PreToolUse registration timeout is
    73	#     bumped to the template-derived cap IFF the adopter's current value is
    74	#     one of the frozen SUPERSEDED SHIPPED caps (60 pre-PLAN-164; 150 from
    75	#     PLAN-164/ADR-110-AMEND-1, shipped in v1.2.0 and superseded by
    76	#     ADR-110-AMEND-2's 210); any other adopter-chosen value is
    77	#     PRESERVED + a named WARNING; idempotent. Runs inside the same T5.4
    78	#     migration step (same opt-out, same --dry-run preview); the NEW cap is
    79	#     derived from templates/settings/settings.base.json, never hardcoded.
    80	#
    81	# Run after `git pull` in the source ceo-orchestration repo.
    82	
    83	# Bash 3.2 portability guard (DevOps-P1-3 parity with install.sh)
    84	if [ -z "${BASH_VERSINFO:-}" ]; then
    85	  echo "ERROR: upgrade.sh requires bash (detected non-bash shell)" >&2
    86	  exit 1
    87	fi
    88	if [ "${BASH_VERSINFO[0]}" -lt 3 ] || \
    89	   { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
    90	  echo "ERROR: upgrade.sh requires bash >= 3.2 (detected ${BASH_VERSION})" >&2
    91	  exit 1
    92	fi
    93	
    94	set -euo pipefail
    95	
    96	SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    97	SOURCE_DIR="$( cd "$SCRIPT_DIR/.." && pwd )"
    98	
    99	# PLAN-138 Wave C (ADR-155) — portable SHA-256 helpers + the single shared
   100	# framework-owned enumeration, sourced (not executed). Both back the baseline
   101	# classifier below. Fail-open: if a helper is absent (partial checkout) the
   102	# classifier degrades to today's diff -q warn-then-clobber behavior.
   103	if [ -f "$SCRIPT_DIR/_hash_lib.sh" ]; then
   104	  # shellcheck source=scripts/_hash_lib.sh
   105	  . "$SCRIPT_DIR/_hash_lib.sh"
   106	fi
   107	if [ -f "$SCRIPT_DIR/_framework_manifest_set.sh" ]; then
   108	  # shellcheck source=scripts/_framework_manifest_set.sh
   109	  . "$SCRIPT_DIR/_framework_manifest_set.sh"
   110	fi
   111	# PLAN-155 Wave 5 — codex harness emission helper (sourced, not executed).
   112	# Fail-open: absent => --harness codex round-trip degrades to a warning.
   113	if [ -f "$SCRIPT_DIR/_codex_harness.sh" ]; then
   114	  # shellcheck source=scripts/_codex_harness.sh
   115	  . "$SCRIPT_DIR/_codex_harness.sh"
   116	fi
   117	
   118	# PLAN-156 Wave 4 — Grok harness (sourced). Fail-open: absent => --harness
   119	# grok round-trip degrades to a warning (mirrors the codex source above).
   120	if [ -f "$SCRIPT_DIR/_grok_harness.sh" ]; then
   121	  # shellcheck source=scripts/_grok_harness.sh
   122	  . "$SCRIPT_DIR/_grok_harness.sh"
   123	fi
   124	
   125	# ===========================================================================
   126	# PLAN-163 T5.4 — settings baseline-migration NORMATIVE TABLE (W0b literals).
   127	# ---------------------------------------------------------------------------
   128	# ONE source of truth for the baseline-aware settings migration below
   129	# (_migrate_settings_baseline). Oracles derive their expectations from
   130	# `upgrade.sh --print-settings-baselines` (this exact JSON) instead of
   131	# hardcoding the literals — keep the table and the migration in lockstep.
   132	# Order is NORMATIVE: new model ids are APPENDED AT THE END (the arrays are
   133	# byte-compared and the first entry participates in default resolution —
   134	# ADR-149:95-102; mirror test :127-149,193-200); any other order needs an
   135	# ADR-181 justification. permissions.defaultMode follows the exact read
   136	# contract of _lib/effective_config.py:178-180,534-542 (stripped string).
   137	# The top-level scalar "model" leaf (the CC 2.1.220 session-default pin,
   138	# ADR-181 T1.1) has NO old-baseline value — old installs carry NO top-level
   139	# "model" key at all ("old": null documents that ABSENCE). Absence therefore
   140	# IS the old baseline: it is migrated to the new pin (claude-opus-5), closing
   141	# the T1.1 silent-flip (adding claude-sonnet-5 to availableModels must not
   142	# re-flip the session default) — BUT ONLY when claude-opus-5 is actually in
   143	# the resulting effective availableModels. C6 (codex R4): if an adopter has
   144	# CUSTOMIZED availableModels to a set that EXCLUDES claude-opus-5, setting the
   145	# pin would place it outside the allowlist and enforceAvailableModels would
   146	# reject it, so in that case the pin is NOT set and a named warning is emitted
   147	# (session default left to the adopter/harness). In the normal migrated case
   148	# claude-opus-5 IS present, so the pin is set and enforceAvailableModels
   149	# accepts it. Any PRESENT model value != the new pin is adopter-custom and
   150	# PRESERVED with a named warning (never re-flipped).
   151	# ADR-149 Amendment 2 (S338): an ARRAY leaf may also carry "superseded" —
   152	# EVERY previously SHIPPED value that is neither the original OLD baseline
   153	# nor the NEW one, as frozen historical literals (the same doctrine as
   154	# OLD_PAIR_RAIL_CAPS below). v1.2.0 and v1.3.0 shipped the 6-id
   155	# availableModels that was "new" until claude-fable-5-1 was appended;
   156	# without this list the 3-state policy would read every such adopter as
   157	# ADOPTER-CUSTOMIZED and never deliver the seventh id — silently: the
   158	# install/upgrade parity e2e declares settings.json an ACCEPTED divergence
   159	# (keys, not bytes), so CI would not notice. The match is
   160	# byte-exact (values AND order): a genuinely customized array still lands
   161	# in the PRESERVED branch.
   162	# Each registration carries a "match" filename used for the idempotent
   163	# append (mirrors the H8 jq `_reg` semantics: an event entry whose
   164	# hooks[].command references the filename counts as already registered).
   165	_T54_BASELINES_JSON='{
   166	  "availableModels": {
   167	    "old": ["claude-opus-4-8","claude-fable-5","claude-sonnet-4-6","claude-haiku-4-5"],
   168	    "superseded": [["claude-opus-4-8","claude-fable-5","claude-sonnet-4-6","claude-haiku-4-5","claude-opus-5","claude-sonnet-5"]],
   169	    "new": ["claude-opus-4-8","claude-fable-5","claude-sonnet-4-6","claude-haiku-4-5","claude-opus-5","claude-sonnet-5","claude-fable-5-1"]
   170	  },
   171	  "fallbackModel": {
   172	    "old": ["claude-opus-4-8"],
   173	    "new": ["claude-opus-5"]
   174	  },
   175	  "model": {
   176	    "old": null,
   177	    "new": "claude-opus-5"
   178	  },
   179	  "permissions.defaultMode": {
   180	    "old": "default",
   181	    "new": "manual"
   182	  },
   183	  "registrations": {
   184	    "DirectoryAdded": {
   185	      "match": "check_directory_added.py",
   186	      "entry": {
   187	        "_comment": "PLAN-163 T3.1: DirectoryAdded observer-writer - records session-added workspace roots into the session-roots registry (and, where the harness supports a block decision, enforces the narrowed hardblock floor). Posture per the T3.1 blockability probe; fail-open on infra. Kill: CEO_DIRECTORY_ADDED_GUARD=0.",
   188	        "matcher": "",
   189	        "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\" check_directory_added.py", "timeout": 5, "statusMessage": "Recording added workspace root..." } ]
   190	      }
   191	    },
   192	    "Notification": {
   193	      "match": "check_notification.py",
   194	      "entry": {
   195	        "_comment": "PLAN-163 T3.2: Notification lifecycle telemetry (agent_needs_input / agent_completed) -> typed audit emit with no-value-echo; feeds liveness telemetry. ADVISORY, fail-open. Kill: CEO_NOTIFICATION_TELEMETRY=0.",
   196	        "matcher": "",
   197	        "hooks": [ { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/_python-hook.sh\" check_notification.py", "timeout": 5, "statusMessage": "Recording notification lifecycle event..." } ]
   198	      }
   199	    }
   200	  }
   201	}'
   202	
   203	# PLAN-163 T3.4 FEATURE GATE — new-event registrations (DirectoryAdded,
   204	# Notification). SUPPORT.md declares the adopter floor >=2.0; until the
   205	# T3.4 version-floor probe (unknown-event-key tolerance on the floor
   206	# version) is recorded — or the floor is explicitly raised with
   207	# SUPPORT/install/upgrade kept coherent — emitting the new event keys into
   208	# ADOPTER settings stays OFF. Flip _T34_VERSION_FLOOR_PROBE_PASSED to 1 in
   209	# the SAME change that records the probe verdict
   210	# ({{FILL-FROM-PROBES}}: T3.4 version-floor probe — pending at authoring
   211	# time). Env override CEO_T34_NEW_EVENT_REGISTRATIONS={1|0} always wins
   212	# (test seam + operator escape hatch). The gate NEVER affects the three
   213	# model/permission leaf keys — those migrate regardless.
   214	_T34_VERSION_FLOOR_PROBE_PASSED=0
   215	_t34_new_event_registrations_enabled() {
   216	  case "${CEO_T34_NEW_EVENT_REGISTRATIONS:-}" in
   217	    1) return 0 ;;
   218	    0) return 1 ;;
   219	  esac
   220	  [ "$_T34_VERSION_FLOOR_PROBE_PASSED" -eq 1 ]
   221	}
