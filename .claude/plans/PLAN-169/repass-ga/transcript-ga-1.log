+    [ -n "$_utg_commit" ] || continue
+    _utg_blob="$( git -C "$SOURCE_DIR" rev-parse "$_utg_commit:$_utg_rel" 2>/dev/null || true )"
+    [ -n "$_utg_blob" ] || continue
