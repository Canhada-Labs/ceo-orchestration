   791	_UP_OPS_FILE=""
   792	
   793	# Print "<profile>\t<stack>" from a valid state file; non-zero rc on ANY
   794	# problem (missing python3, unreadable file, bad JSON, wrong schema_version,
   795	# non-string or charset-violating values) => caller falls back.
   796	_read_install_state_request() {
   797	  command -v python3 >/dev/null 2>&1 || return 3
   798	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
   799	  PYTHONNOUSERSITE=1 python3 -I -c '
   800	import json, re, sys
   801	try:
   802	    with open(sys.argv[1], "r", encoding="utf-8") as f:
   803	        d = json.load(f)
   804	except (OSError, ValueError):
   805	    sys.exit(3)
   806	if not isinstance(d, dict):
   807	    sys.exit(3)
   808	if d.get("schema_version") != 1:
   809	    sys.exit(3)
   810	req = d.get("request")
