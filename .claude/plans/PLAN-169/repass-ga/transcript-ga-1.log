+$_utg_out" in
+      *"
+$_utg_hash
+"*) continue ;;
+    esac
+    _utg_out="$_utg_out$_utg_hash
+"
+  done < <( git -C "$SOURCE_DIR" log --format='%H' -- "$_utg_rel" 2>/dev/null || true )
+  printf '%s' "$_utg_out"
+}
