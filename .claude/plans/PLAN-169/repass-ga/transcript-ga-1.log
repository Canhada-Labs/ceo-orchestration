  1484	# Classify a single repo-relative file against the baseline. Echoes ONE verdict:
  1485	#   FRAMEWORK-CHANGED  H_dst==H_base && H_src!=H_base  -> safe to auto-update
  1486	#   ADOPTER-CUSTOMIZED H_dst!=H_base && H_src==H_base  -> preserve
  1487	#   CONFLICT           both differ from H_base         -> --on-conflict
  1488	#   IDENTICAL          H_dst==H_src                    -> nothing to do
  1489	#   FALLBACK           no usable baseline / hasher      -> today's behavior
  1490	# H_dst and H_src are BOTH recomputed from disk THIS run (never cached H_src).
  1491	_classify_against_baseline() {
  1492	  _cab_rel="$1"
  1493	  command -v _hash_file >/dev/null 2>&1 || { printf 'FALLBACK\n'; return 0; }
  1494	  _cab_base="$( _baseline_lookup "$_cab_rel" )" || { printf 'FALLBACK\n'; return 0; }
