  1056	# CHARACTER SET question stays with _wbm_github_handle_ok, which remains the
  1057	# single owner of the grammar; restating the charset here would rebuild the
  1058	# second copy round-1 deleted.
  1059	if "\x00" in h or "\r" in h or "\n" in h:
  1060	    sys.exit(3)
