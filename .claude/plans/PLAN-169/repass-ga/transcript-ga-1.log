   903	    sys.exit(3)
   904	req = d.get("request")
   905	if not isinstance(req, dict):
   906	    sys.exit(3)
   907	cer = req.get("ceremony", "")
   908	if cer not in ("maintainer", "user"):
   909	    sys.exit(3)
   910	sys.stdout.write(cer + "\n")
   911	' "$_INSTALL_STATE_FILE" 2>/dev/null
   912	}
