   931	  CEREMONY_EFFECTIVE="$CEREMONY_FLAG"
   932	  _CEREMONY_SOURCE="explicit --ceremony flag (no install-state)"
   933	  _CEREMONY_PERSIST="1"
   934	elif [[ "${CEO_UPGRADE_CEREMONY:-}" == "maintainer" || "${CEO_UPGRADE_CEREMONY:-}" == "user" ]]; then
   935	  CEREMONY_EFFECTIVE="$CEO_UPGRADE_CEREMONY"
   936	  _CEREMONY_SOURCE="explicit CEO_UPGRADE_CEREMONY override (no install-state)"
   937	  _CEREMONY_PERSIST="1"
   938	fi
