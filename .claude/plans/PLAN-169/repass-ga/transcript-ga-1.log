  1336	# Load + sanitize the baseline manifest. On any problem (absent / unreadable /
  1337	# empty after sanitization) leaves _BASELINE_MANIFEST_FILE empty => fallback.
  1338	_load_baseline_manifest() {
  1339	  [ -f "$_BASELINE_MANIFEST_RAW" ] && [ -r "$_BASELINE_MANIFEST_RAW" ] || return 0
