   505	if [[ -z "$TARGET" || ! -d "$TARGET" ]]; then
   506	  echo "Usage: $0 <target-repo-path> [--profile <list>] [--stack <name>] [--pin <tag>] [--dry-run] [--ceremony <maintainer|user>]" >&2
   507	  exit 1
   508	fi
