   547	    fi
   548	    [ -n "$_utg_hash" ] || continue
   549	    case "
   550	$_utg_out" in
   551	      *"
   552	$_utg_hash
   553	"*) continue ;;
   554	    esac
   555	    _utg_out="$_utg_out$_utg_hash
   556	"
   557	  done < <( git -C "$SOURCE_DIR" log --format='%H' -- "$_utg_rel" 2>/dev/null || true )
   558	  printf '%s' "$_utg_out"
   559	}
   560	_up_tpl_symlink_refuses() {
   561	  _uts_rel="$1"
   562	  if [ -L "$TARGET/$_uts_rel" ]; then
   563	    echo "    WARNING: PRESERVED $_uts_rel (destination is a symlink — a refresh would write through it, outside the target; replace the link manually if that is intended)"
   564	    return 0
   565	  fi
   566	  _uts_walk="$( dirname "$_uts_rel" )"
   567	  while [ -n "$_uts_walk" ] && [ "$_uts_walk" != "." ] && [ "$_uts_walk" != "/" ]; do
   568	    if [ -L "$TARGET/$_uts_walk" ]; then
   569	      echo "    WARNING: PRESERVED $_uts_rel (ancestor $_uts_walk is a symlink — refusing to write through it)"
   570	      return 0
   571	    fi
   572	    _uts_walk="$( dirname "$_uts_walk" )"
   573	  done
   574	  return 1
   575	}
   576	_up_tpl_write() {
   577	  _utw_src="$1"; _utw_dst="$2"; _utw_handle="${3:-}"
   578	  _utw_dir="$( dirname "$_utw_dst" )"
   579	  _utw_tmp="$( mktemp "$_utw_dir/.ceo-deliver.XXXXXX" 2>/dev/null || true )"
   580	  if [ -z "$_utw_tmp" ]; then
   581	    return 1
   582	  fi
   583	  if [ -n "$_utw_handle" ]; then
   584	    if ! cat "$_utw_src" > "$_utw_tmp" 2>/dev/null; then
   585	      rm -f "$_utw_tmp"
   586	      return 1
   587	    fi
   588	  else
   589	    if ! cp "$_utw_src" "$_utw_tmp" 2>/dev/null; then
   590	      rm -f "$_utw_tmp"
   591	      return 1
   592	    fi
   593	  fi
   594	  _utw_mode="$( _up_tpl_install_mode "$_utw_src" "$_utw_handle" )"
   595	  if [ -n "$_utw_mode" ]; then
   596	    chmod "$_utw_mode" "$_utw_tmp" 2>/dev/null || true
   597	  fi
   598	  if ! mv -f "$_utw_tmp" "$_utw_dst" 2>/dev/null; then
   599	    rm -f "$_utw_tmp"
   600	    return 1
   601	  fi
   602	  return 0
   603	}
   604	_up_tpl_nlink() {
   605	  if ! command -v _wbm_nlink >/dev/null 2>&1; then
   606	    echo "    WARNING: hard-link detection unavailable (scripts/_framework_manifest_set.sh not sourced) — destinations will not be checked for extra names" >&2
   607	    printf ''
   608	    return 0
   609	  fi
   610	  _wbm_nlink "$1"
   611	}
   612	_up_tpl_multilink_refuses() {
   613	  _utm_rel="$1"
   614	  _utm_dst="$2"
   615	  [ -e "$_utm_dst" ] || return 1
   616	  _utm_n="$( _up_tpl_nlink "$_utm_dst" )"
   617	  [ -n "$_utm_n" ] || return 1
   618	  if [ "$_utm_n" -gt 1 ] 2>/dev/null; then
   619	    echo "    WARNING: PRESERVED $_utm_rel (destination has $_utm_n hard links — writing it would change every other name for the same inode, including names outside the target; break the link manually if that is intended)"
   620	    return 0
   621	  fi
   622	  return 1
   623	}
   624	_up_tpl_stat_mode() {
   625	  _utsm_out="$( stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || true )"
   626	  case "$_utsm_out" in
   627	    [0-7][0-7][0-7]|[0-7][0-7][0-7][0-7]) printf '%s\n' "$_utsm_out" ;;
   628	    *) printf '' ;;
   629	  esac
   630	}
   631	_up_tpl_install_mode() {
   632	  if [ -n "${2:-}" ]; then
   633	    _utim_umask="$( umask 2>/dev/null || printf '022' )"
   634	    case "$_utim_umask" in
   635	      [0-7]*) printf '%03o\n' "$(( 0666 & ~0$_utim_umask ))" ;;
   636	      *)      printf '' ;;
   637	    esac
   638	  else
   639	    _up_tpl_stat_mode "$1"
   640	  fi
   641	}
   642	_up_tpl_normalize_mode() {
   643	  _utnm_want="$( _up_tpl_install_mode "$3" "${4:-}" )"
   644	  _utnm_have="$( _up_tpl_stat_mode "$2" )"
   645	  if [ -z "$_utnm_want" ] || [ -z "$_utnm_have" ]; then
   646	    [ "${DRY_RUN:-0}" -eq 0 ] \
   647	      && echo "    NOTE: mode not normalised for $1 (stat/umask gave no usable answer)" >&2
   648	    return 0
   649	  fi
   650	  if [ "$(( 0$_utnm_have ))" -eq "$(( 0$_utnm_want ))" ]; then
   651	    return 0
   652	  fi
   653	  if [ "${DRY_RUN:-0}" -ne 0 ]; then
   654	    echo "    (dry-run) would MODE-NORMALIZE ($_utnm_have -> $_utnm_want): $1"
   655	    return 0
   656	  fi
   657	  _utnm_n="$( _up_tpl_nlink "$2" )"
   658	  if [ -n "$_utnm_n" ] && [ "$_utnm_n" -gt 1 ] 2>/dev/null; then
   659	    echo "    NOTE: mode $_utnm_have kept for $1 (destination has $_utnm_n hard links — a chmod would change the mode of every other name for the same inode)" >&2
   660	    return 0
   661	  fi
   662	  if chmod "$_utnm_want" "$2" 2>/dev/null; then
   663	    echo "    MODE-NORMALIZED ($_utnm_have -> $_utnm_want): $1"
   664	  else
   665	    echo "    NOTE: mode $_utnm_have kept for $1 (chmod to $_utnm_want failed)" >&2
   666	  fi
   667	  return 0
   668	}
   669	_up_tpl_confined_refuses() {
   670	  _utc_rel="$1"
   671	  if command -v _wbm_route_relpath_ok >/dev/null 2>&1; then
   672	    if ! _wbm_route_relpath_ok "$_utc_rel"; then
   673	      echo "    ERROR: REFUSED $_utc_rel — not a confined relative path (route table poisoned?)" >&2
   674	      return 0
   675	    fi
   676	  else
   677	    case "$_utc_rel" in
   678	      ""|/*|./*|..|../*|*/../*|*/..|*//*|*\\*|*[[:space:]]*|*[[:cntrl:]]*)
   679	        echo "    ERROR: REFUSED $_utc_rel — not a confined relative path (route table poisoned?)" >&2
   680	        return 0 ;;
   681	    esac
   682	  fi
   683	  if command -v _wbm_route_domain_ok >/dev/null 2>&1; then
   684	    if ! _wbm_route_domain_ok "$_utc_rel"; then
   685	      echo "    ERROR: REFUSED $_utc_rel — outside the delivery domain (this wave writes ONLY under docs/ or .github/)" >&2
   686	      return 0
   687	    fi
   688	  else
   689	    echo "    ERROR: REFUSED $_utc_rel — the delivery-domain predicate (_wbm_route_domain_ok) is unavailable; refusing rather than guessing" >&2
   690	    return 0
   691	  fi
   692	  _utc_tgt="$( cd -P "$TARGET" 2>/dev/null && pwd -P || true )"
   693	  if [ -z "$_utc_tgt" ]; then
   694	    echo "    ERROR: REFUSED $_utc_rel — the target directory does not resolve" >&2
   695	    return 0
   696	  fi
   697	  if _wbm_dst_non_directory_ancestor_refuses "$_utc_tgt" "$_utc_rel"; then
   698	    echo "    ERROR: REFUSED $_utc_rel — $_WBM_DST_REFUSE_WHY" >&2
   699	    return 0
   700	  fi
   701	  _utc_walk="$( dirname "$TARGET/$_utc_rel" )"
   702	  while [ -n "$_utc_walk" ] && [ ! -d "$_utc_walk" ]; do
   703	    _utc_next="$( dirname "$_utc_walk" )"
   704	    [ "$_utc_next" != "$_utc_walk" ] || break
   705	    _utc_walk="$_utc_next"
   706	  done
   707	  _utc_res="$( cd -P "$_utc_walk" 2>/dev/null && pwd -P || true )"
   708	  if [ -z "$_utc_res" ]; then
   709	    echo "    ERROR: REFUSED $_utc_rel — its nearest existing ancestor does not resolve" >&2
   710	    return 0
   711	  fi
   712	  case "$_utc_res" in
   713	    "$_utc_tgt"|"$_utc_tgt"/*) return 1 ;;
   714	  esac
   715	  echo "    ERROR: REFUSED $_utc_rel — resolves outside the target ($_utc_res is not under $_utc_tgt)" >&2
   716	  return 0
   717	}
   718	_up_src_confined_refuses() {
