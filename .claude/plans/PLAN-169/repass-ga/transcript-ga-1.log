   510	# ---------------------------------------------------------------------------
   511	# PLAN-106 Wave G.2 — git-checkout retry wrapper around index.lock contention.
   512	# ---------------------------------------------------------------------------
   513	# Wraps `git checkout --quiet "$PIN_REF"` with a 3-attempt retry on
   514	# `.git/index.lock` busy. Per-attempt audit event via emit_git_index_lock_retry.
   515	# Argv-pass invocation per PLAN-106 §3 Wave G.2.b — never source-string
   516	# interpolation; absolute HOOKS_DIR; PYTHONNOUSERSITE=1 python3 -I.
   517	#
   518	# Override budget via CEO_GIT_LOCK_RETRY_MAX (default 3) for tests.
   519	# Override unit-test override via CEO_GIT_LOCK_RETRY_BACKOFF_BASE (default 1)
   520	# so the test can use 0s waits.
   521	_git_checkout_with_lock_retry() {
   522	  local src_dir="$1"
   523	  local pin_ref="$2"
   524	  local max_attempts="${CEO_GIT_LOCK_RETRY_MAX:-3}"
   525	  local backoff_base="${CEO_GIT_LOCK_RETRY_BACKOFF_BASE:-1}"
   526	  local attempt=1
   527	  local rc=0
   528	  local err_out=""
   529	  local repo_root_for_hash
   530	  local hash
   531	  local hooks_dir
   532	
   533	  # Derive HASH explicitly as hex-only by construction (collision-resistant):
   534	  # use git rev-parse on the source dir; fall back to $src_dir literal if
   535	  # rev-parse fails (e.g. during sandbox-sim of a fresh init).
   536	  repo_root_for_hash="$( cd "$src_dir" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$src_dir" )"
   537	  # PLAN-138 Wave C (ADR-155): hash a STRING via the portable _hash_stdin
   538	  # (shasum||sha256sum). This hashes a PATH STRING (not a file), so the
   539	  # stdin/string hasher is correct — NOT a content hash. Fall back to the
   540	  # legacy bare shasum if the helper was not sourced (partial checkout).
   541	  if command -v _hash_stdin >/dev/null 2>&1; then
   542	    hash="$( printf '%s' "$repo_root_for_hash" | _hash_stdin )"
   543	  else
   544	    hash="$( printf '%s' "$repo_root_for_hash" | shasum -a 256 | awk '{print $1}' )"
   545	  fi
   546	  # Resolve hooks directory to ABSOLUTE path (Codex P0 fold — relative
   547	  # sys.path.insert is vulnerable to CWD manipulation):
   548	  hooks_dir="$SOURCE_DIR/.claude/hooks"
   549	
   550	  while [[ "$attempt" -le "$max_attempts" ]]; do
   551	    err_out="$( ( cd "$src_dir" && git checkout --quiet "$pin_ref" ) 2>&1 )" && rc=0 || rc=$?
   552	    if [[ "$rc" -eq 0 ]]; then
   553	      return 0
   554	    fi
   555	
   556	    # Detect index.lock contention. Two canonical git error strings:
   557	    #   "Another git process seems to be running in this repository"
   558	    #   "fatal: Unable to create '.git/index.lock': File exists"
   559	    if echo "$err_out" | grep -qE 'index\.lock|Another git process seems to be running'; then
   560	      local backoff_seconds=$(( backoff_base * (2 ** (attempt - 1)) ))
   561	
   562	      # PLAN-106 Wave G.2 hardened invocation. argv-pass eliminates
   563	      # source-string interpolation (lesson [[feedback-bash-heredoc-paren-in-subshell]]).
   564	      # python3 -I + PYTHONNOUSERSITE=1 shrink env-driven import surface.
   565	      # Best-effort emit — failure must NOT abort the retry chain.
   566	      PYTHONNOUSERSITE=1 python3 -I -c '
   567	import sys
   568	hooks_dir = sys.argv[1]
   569	if hooks_dir not in sys.path:
   570	    sys.path.insert(0, hooks_dir)
   571	from _lib.audit_emit import emit_git_index_lock_retry
   572	emit_git_index_lock_retry(
   573	    attempt=int(sys.argv[2]),
   574	    backoff_seconds=int(sys.argv[3]),
   575	    repo_path_hash=sys.argv[4],
   576	    operation="upgrade_sh_git_checkout",
   577	)' "$hooks_dir" "$attempt" "$backoff_seconds" "$hash" 2>/dev/null || true
   578	
   579	      echo "    NOTE: git index.lock busy (attempt $attempt/$max_attempts) — backing off ${backoff_seconds}s" >&2
   580	      if [[ "$attempt" -lt "$max_attempts" ]]; then
   581	        sleep "$backoff_seconds"
   582	      fi
   583	      attempt=$(( attempt + 1 ))
   584	      continue
   585	    fi
   586	
   587	    # Non-lock error — surface and bail.
   588	    echo "$err_out" >&2
   589	    return "$rc"
   590	  done
   591	
   592	  # Exhausted retries on lock contention.
   593	  echo "ERROR: git checkout $pin_ref retry budget exhausted after $max_attempts attempts (.git/index.lock contention)" >&2
   594	  return 2
   595	}
   596	
   597	# --pin contract (SPEC v1 install-cli.md, ADR-007):
   598	# - Resolve <ref> via git rev-parse --verify in the source framework repo
   599	# - Refuse if target has uncommitted .claude/ changes (exit 2)
   600	# - On --dry-run: print diff between current and pinned and exit 0
   601	# - Otherwise: git checkout <ref> in source; run normal upgrade;
   602	#   restore original branch at end
   603	PINNED_CHECKOUT_DONE=0
   604	ORIGINAL_BRANCH=""
   605	
   606	# PLAN-161 U1 (codex r2 F4) — ONE composed EXIT cleanup. The --pin block used
   607	# to install an inline EXIT trap restoring the source branch; any later plain
   608	# `trap ... EXIT` would CLOBBER it. All exit-time duties now live in this
   609	# single function, installed ONCE: (a) restore the pinned-source branch,
   610	# guarded by PINNED_CHECKOUT_DONE + ORIGINAL_BRANCH — the non-dry --pin
   611	# restore semantics are preserved exactly, on success AND on mid-run failure;
   612	# (b) reap the sanitized baseline-manifest tempfile, which now lives OUTSIDE
   613	# $TARGET (see _load_baseline_manifest); (c) reap the delivery-route snapshot
   614	# taken below (rail round-2 F2).
   615	_BASELINE_TMP_FILE=""
   616	_upgrade_cleanup() {
   617	  if [[ "${PINNED_CHECKOUT_DONE:-0}" -eq 1 ]] && [[ -n "${ORIGINAL_BRANCH:-}" ]]; then
   618	    ( cd "$SOURCE_DIR" && git checkout --quiet "$ORIGINAL_BRANCH" 2>/dev/null ) || true
   619	  fi
   620	  if [[ -n "${_BASELINE_TMP_FILE:-}" ]]; then
   621	    rm -f "$_BASELINE_TMP_FILE" 2>/dev/null || true
   622	  fi
   623	  if [[ -n "${_UP_ROUTES_SNAPSHOT:-}" ]]; then
   624	    rm -f "$_UP_ROUTES_SNAPSHOT" 2>/dev/null || true
   625	  fi
   626	}
   627	trap _upgrade_cleanup EXIT
   628	
   629	# --- rail round-2 F2: the route table must SURVIVE a pinned checkout -------
   630	# _WBM_ROUTES_TSV is RESOLVED when _framework_manifest_set.sh is
   631	# sourced (:463 there, from this file's :108) — i.e. out of the tree this
   632	# upgrader was invoked from — but the readers STAT that path at CALL time,
   633	# ~3300 lines later. Between the two sits `--pin <ref>`, which checks the
   634	# SOURCE tree out at <ref>. For any ref predating aaf32c7 the table is simply
   635	# GONE by then. MEASURED (S327): `git show v1.3.0:scripts/delivery-routes.tsv`
   636	# answers "exists on disk, but not in 'v1.3.0'" — so a `--pin v1.3.0` upgrade
   637	# enumerated ZERO routes, printed a precondition error, and still exited 0
   638	# with docs/ and .github/ undelivered. Pinned upgrades are exactly the
   639	# population the route table was added to serve.
   640	#
   641	# Cure: copy the table's BYTES out of the running upgrader's own checkout NOW,
   642	# before anything can check the source out at a pin, and point the ONE reader
   643	# at that snapshot for the rest of the run — so `_wbm_route_src`,
   644	# `_wbm_route_dests`, `_wbm_route_rows_total` and `_write_baseline_manifest`
   645	# all follow without knowing this happened.
   646	#
   647	# rail round-6 F3 — this is the ONLY production re-point of _WBM_ROUTES_TSV,
   648	# and it is in-process code running AFTER the library resolved the shipped
   649	# table, never a value read from the environment. The bytes copied are the
   650	# ones the running checkout ships; the destination is a scratch file this
   651	# process created (_up_tmpbase, below) and removes on EXIT. The oracles assert
   652	# that no second production assignment appears.
   653	#
   654	# What this deliberately does NOT change: route SOURCES are still read out of
   655	# the PINNED tree ("$SOURCE_DIR/$rel"), which is what --pin means. A source
   656	# absent at the pin is reported PER PATH by _up_deliver_template
   657	# ("SKIPPED (source missing at pin <ref>)"), never silently.
   658	#
   659	# Taken unconditionally, not only under --pin: the property wanted is "the
   660	# destination list cannot change under this run's feet", and making it
   661	# conditional would leave the same class open for every other way the source
   662	# tree can move mid-run.
   663	# --- rail round-5 F3: scratch NEVER lands inside $TARGET -------------------
   664	# `mktemp "${TMPDIR:-/tmp}/..."` is only outside the target while the CALLER's
   665	# TMPDIR is. Point TMPDIR at $TARGET (or any descendant) and every scratch file
   666	# this script takes is created INSIDE the adopter repository — under --dry-run
   667	# too, which contradicts the CLI's no-modification contract. The EXIT trap then
   668	# hides it from any final-tree comparison, while a SIGKILL leaves it behind.
   669	# _load_baseline_manifest (:1063-1084, PLAN-161 U1 codex r1 F5) already carries
   670	# the cure; this is that same check with ONE owner, because "where is scratch?"
   671	# is a question this file must not answer in five places (CLAUDE.md §4).
   672	# Physical resolution on BOTH sides (cd/pwd -P): /tmp is a symlink on macOS and
   673	# a lexical prefix test answers wrongly there.
   674	_up_tmpbase() {
   675	  _utb_base="${TMPDIR:-/tmp}"
   676	  _utb_base_abs="$( cd "$_utb_base" 2>/dev/null && pwd -P )" || _utb_base_abs=""
   677	  _utb_tgt_abs="$( cd "${TARGET:-/nonexistent}" 2>/dev/null && pwd -P )" || _utb_tgt_abs=""
   678	  if [[ -n "$_utb_base_abs" && -n "$_utb_tgt_abs" ]]; then
   679	    case "${_utb_base_abs%/}/" in
   680	      "${_utb_tgt_abs%/}/"*) _utb_base="/tmp" ;;
   681	    esac
   682	  fi
   683	  printf '%s\n' "$_utb_base"
   684	}
   685	
   686	_UP_ROUTES_ORIGIN="${_WBM_ROUTES_TSV:-}"
   687	_UP_ROUTES_SNAPSHOT=""
   688	# rc.1 re-pass round 3, part 1 — the snapshot LAUNDERED a symlinked table.
   689	# `[[ -f ]]` and `cp` both FOLLOW links, and the copy is a regular file, so
   690	# after the snapshot `_WBM_ROUTES_TSV` names a regular tempfile and the
   691	# reader's own `-L` refusal examines THAT — never the leaf the operator
   692	# actually has on disk. A well-formed external table therefore passed a gate
   693	# written to refuse it, and a route could point an allowed destination at
   694	# different `templates/` bytes with the upgrade exiting 0.
   695	#
   696	# The test goes BEFORE `-f`, because `-f` on a link to a regular file is
   697	# true and asking afterwards is asking too late. On refusal the pointer is
   698	# LEFT on the origin: the reader gate then refuses it by name, every reader
   699	# answers zero routes, and the AC-9 precondition below turns that into
   700	# `exit 3` + `upgrade_succeeded: false`. Two mechanisms saying the same
   701	# thing is deliberate — this one names it early, where an operator reads the
   702	# log, and the reader gate is the one that decides.
   703	# (Symlinked path COMPONENTS and physical confinement to the executing
   704	# checkout are the same class and are NOT closed here — declared residual.)
   705	if [[ -n "$_UP_ROUTES_ORIGIN" ]] && [[ -L "$_UP_ROUTES_ORIGIN" ]]; then
   706	  echo "    ERROR: the delivery-route table is a SYMLINK — refusing to snapshot it" >&2
   707	  echo "           ($_UP_ROUTES_ORIGIN). Copying it first would hand the reader a" >&2
   708	  echo "           regular tempfile and launder the link past its own -L refusal;" >&2
   709	  echo "           the reader keeps the ORIGINAL path and fails closed on it." >&2
   710	elif [[ -n "$_UP_ROUTES_ORIGIN" ]] && [[ -f "$_UP_ROUTES_ORIGIN" ]]; then
   711	  _UP_ROUTES_SNAPSHOT="$( mktemp "$( _up_tmpbase )/ceo-upgrade-routes.XXXXXX" 2>/dev/null || true )"
   712	  if [[ -n "$_UP_ROUTES_SNAPSHOT" ]] && cp "$_UP_ROUTES_ORIGIN" "$_UP_ROUTES_SNAPSHOT" 2>/dev/null; then
   713	    _WBM_ROUTES_TSV="$_UP_ROUTES_SNAPSHOT"
   714	  else
   715	    # Fail-OPEN on the SNAPSHOT only: an unusable tempdir is infrastructure,
   716	    # and leaving the reader pointed at the original path is exactly today's
   717	    # behaviour. The AC-9 precondition below is still the fail-CLOSED gate on
   718	    # what the reader actually returns.
   719	    [[ -n "$_UP_ROUTES_SNAPSHOT" ]] && rm -f "$_UP_ROUTES_SNAPSHOT" 2>/dev/null
   720	    _UP_ROUTES_SNAPSHOT=""
   721	    echo "    NOTE: could not snapshot the delivery-route table ($_UP_ROUTES_ORIGIN) —" >&2
   722	    echo "          a --pin checkout may leave it unreadable (rail round-2 F2)" >&2
   723	  fi
   724	fi
   725	
   726	if [[ -n "$PIN_REF" ]]; then
   727	  if ! pushd "$SOURCE_DIR" >/dev/null; then
   728	    echo "ERROR: cannot cd to source repo: $SOURCE_DIR" >&2
   729	    exit 1
   730	  fi
   731	  if ! git rev-parse --verify "$PIN_REF" >/dev/null 2>&1; then
   732	    echo "ERROR: unknown --pin ref: $PIN_REF" >&2
   733	    popd >/dev/null || true
   734	    exit 2
   735	  fi
   736	  ORIGINAL_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
   737	  popd >/dev/null || true
   738	
   739	  # Refuse on uncommitted target .claude/ changes unless CEO_ORCH_FORCE=1
   740	  if [[ -d "$TARGET/.claude" ]] && [[ -d "$TARGET/.git" ]] && [[ "${CEO_ORCH_FORCE:-0}" != "1" ]]; then
   741	    if ( cd "$TARGET" && ! git diff --quiet -- .claude/ 2>/dev/null ); then
   742	      echo "ERROR: target has uncommitted .claude/ changes." >&2
   743	      echo "       Commit, stash, or set CEO_ORCH_FORCE=1 to override." >&2
   744	      exit 2
   745	    fi
   746	  fi
   747	
   748	  if [[ "$DRY_RUN" -eq 1 ]]; then
   749	    echo "==> Dry-run: diff between current source and --pin $PIN_REF"
   750	    ( cd "$SOURCE_DIR" && git diff "$PIN_REF"...HEAD -- .claude/ scripts/ templates/ SPEC/ || true )
   751	    exit 0
   752	  fi
   753	
   754	  # PLAN-106 Wave G.2: wrapped retry around `git checkout`. Replaces the
   755	  # bare `git checkout --quiet "$PIN_REF"` call at the previous
   756	  # upgrade.sh:180. Retry budget is 3 attempts with exponential backoff
   757	  # (1s, 2s, 4s). Per-attempt audit event via emit_git_index_lock_retry.
   758	  if ! _git_checkout_with_lock_retry "$SOURCE_DIR" "$PIN_REF"; then
   759	    echo "ERROR: git checkout $PIN_REF failed in source." >&2
   760	    exit 2
   761	  fi
   762	  PINNED_CHECKOUT_DONE=1
   763	  # Source-branch restore on any exit is handled by the composed
   764	  # _upgrade_cleanup EXIT trap installed above (PLAN-161 U1, codex r2 F4).
   765	fi
   766	
   767	TARGET="$( cd "$TARGET" && pwd )"
   768	
   769	# ===========================================================================
   770	# PLAN-153 Wave B item B2 — replay the RECORDED install request.
   771	# ===========================================================================
   772	# install.sh (>= Wave B) records the original request in
   773	# $TARGET/.claude/.install-state.json (schema ceo.install-state/v1). When
   774	# present + valid, request.profile / request.stack become the DEFAULTS for
   775	# this upgrade so an adopter who installed `--profile core,fintech` does not
   776	# silently get the core,frontend default by forgetting the flag. Explicit
   777	# flags always win; --no-replay opts out.
   778	#
   779	# BACK-COMPAT (debate C must-fix): missing state (ALL pre-Wave-B installs)
   780	# or unreadable/invalid state NEVER errors and NEVER no-ops — the upgrade
   781	# proceeds with CLI/default flags on the ADR-155 path (the --dry-run preview
   782	# and the baseline drift-classifier below), and a state file is (re)written
   783	# after a successful non-dry upgrade so the NEXT run can replay.
   784	#
   785	# TRUST: the state file is target-side, UNSIGNED, advisory (ADR-155 trust
   786	# class). Values are parsed by python3 -I under PYTHONNOUSERSITE=1, charset-
   787	# validated (profile: [A-Za-z0-9_,.-]{1,200}; stack: [A-Za-z0-9_.-]{1,100}),
   788	# and NEVER eval-ed; anything suspect => fallback, exactly as if absent.
   789	_INSTALL_STATE_FILE="$TARGET/.claude/.install-state.json"
   790	_REPLAY_SOURCE="cli-default"
   791	_UP_OPS_FILE=""
   792	
   793	# Print "<profile>\t<stack>" from a valid state file; non-zero rc on ANY
   794	# problem (missing python3, unreadable file, bad JSON, wrong schema_version,
   795	# non-string or charset-violating values) => caller falls back.
   796	_read_install_state_request() {
   797	  command -v python3 >/dev/null 2>&1 || return 3
   798	  [ -f "$_INSTALL_STATE_FILE" ] && [ -r "$_INSTALL_STATE_FILE" ] || return 3
   799	  PYTHONNOUSERSITE=1 python3 -I -c '
   800	import json, re, sys
   801	try:
   802	    with open(sys.argv[1], "r", encoding="utf-8") as f:
   803	        d = json.load(f)
   804	except (OSError, ValueError):
   805	    sys.exit(3)
   806	if not isinstance(d, dict):
   807	    sys.exit(3)
   808	if d.get("schema_version") != 1:
   809	    sys.exit(3)
