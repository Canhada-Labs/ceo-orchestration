   408	def reset_cache_for_test() -> None:
   409	    """Test-only: clear the module-level salt cache.
   410	
   411	    Production code MUST NOT call this. The cache invariant —
   412	    salt is loaded at most once per process — is part of the
   413	    fail-open guarantee (filesystem failures after the first
   414	    successful load do not affect subsequent calls).
   415	    """
   416	    global _CACHED_SALT
   417	    _CACHED_SALT = None
   135	    recovered: int = 0
   136	    truly_lost: int = 0
   137	    tamper_rejected: int = 0
   138	    intentionally_deleted: int = 0
   139	
   140	
   141	# ---------------------------------------------------------------------------
   142	# Path helpers — mirror audit_emit conventions
   143	# ---------------------------------------------------------------------------
   144	
   145	
   146	# PLAN-111 Wave A — single-slot cache for _project_dir_from_env + _state_dir.
   147	# Keyed on env-tuple (CEO_AUDIT_LOG_DIR, HOME); replace-on-miss; explicit
   148	# reset via _reset_caches_for_test() bound to TestEnvContext.setUp/tearDown.
   149	# Single-threaded contract: concurrent os.environ mutation = UB; future
   150	# threading plans must add per-thread cache or thread-local env snapshot.
   151	# Debate Round 1: SA-K1 (single-slot), SA-K7 (single-threaded), SA-K10
   152	# (permission re-assertion on cache MISS), AC-A2a (store-on-mkdir-success
   153	# only; no cached-as-unusable Path).
   154	_PROJECT_DIR_CACHE: "Optional[Tuple[Tuple[Optional[str], Optional[str]], Path]]" = None
   155	_STATE_DIR_CACHE: "Optional[Tuple[Tuple[Optional[str], Optional[str]], Path]]" = None
   156	
   157	
   158	def _reset_caches_for_test() -> None:
   159	    """Clear _project_dir_from_env + _state_dir caches.
   160	
   161	    PLAN-111 Wave A.5: bound to TestEnvContext.setUp/tearDown to avoid
   162	    cross-test leakage when CEO_AUDIT_LOG_DIR or HOME mutate. Also bound
   163	    via unittest.addModuleCleanup in test_lifecycle_edge_cases.py for
   164	    bare-TestCase classes that don't inherit TestEnvContext.
   165	
   166	    PRODUCTION CODE MUST NOT CALL THIS — it's a test-only API. Calling
   167	    mid-flight flushes the cache and re-pays the mkdir + lstat cost on
   168	    next emit (correctness preserved; perf regressed for one call).
   169	    """
   170	    global _PROJECT_DIR_CACHE, _STATE_DIR_CACHE
   171	    _PROJECT_DIR_CACHE = None
   172	    _STATE_DIR_CACHE = None
   173	
   174	
   175	def _project_dir_cache_key() -> Tuple[Optional[str], ...]:
   176	    """Cache key for the declared environment and conditional cwd inputs.
   177	
   178	    PLAN-182 W1 cure: the Wave-A key was (CEO_AUDIT_LOG_DIR, HOME) — a
   179	    process that switched project mid-run (CLAUDE_PROJECT_DIR / cwd /
   180	    CLAUDE_PROJECT_DIR_NATIVE changed) kept being served the PREVIOUS
   181	    project's dir from cache, so the cross-project leak survived any
   182	    resolver cure. cwd participates when none of the directory candidates
   183	    is absolute. A lower-priority absolute candidate can still mask the
   184	    cwd dependency of a relative override; rc.1 condition 24 requires an
   185	    absolute CEO_AUDIT_LOG_DIR and records the remaining cache limitation.
   186	    """
   187	    env_dir = os.environ.get("CEO_AUDIT_LOG_DIR")
   188	    env_home = os.environ.get("HOME")
   189	    env_native = os.environ.get("CLAUDE_PROJECT_DIR_NATIVE")
   190	    env_proj = os.environ.get("CLAUDE_PROJECT_DIR")
   191	    cwd: Optional[str] = None
   192	    # rail r15 P2-3: o cwd entra na chave quando NENHUM override absoluto
   193	    # decide o dir — inclui o caso de um override RELATIVO, que
   194	    # `project_dir()` resolve CONTRA o cwd. Sem isso, um processo longo
   195	    # que muda de cwd com CLAUDE_PROJECT_DIR relativo continuaria servindo
   196	    # o dir do projeto anterior (e pularia a invalidacao dos caches).
   197	    def _abs(v):
   198	        return bool(v) and os.path.isabs(v)
   199	    if not (_abs(env_dir) or _abs(env_native) or _abs(env_proj)):
   200	        cwd = os.getcwd()
   201	    return (env_dir, env_home, env_native, env_proj, cwd)
   202	
   203	
   204	def _project_dir_from_env() -> Path:
   205	    """Return the audit project dir (BYTE-IDENTICAL to audit_emit._audit_dir).
   206	
   207	    P1-5: must mirror audit_emit._audit_dir() exactly — CEO_AUDIT_LOG_DIR
   208	    precedence, then the SAME single resolver (_lib/runtime_paths,
   209	    PLAN-182 W1) audit_emit delegates to. CEO_AUDIT_LOG_PATH is the FILE
   210	    path, not the dir path, so we do NOT derive the dir from it
   211	    (audit_emit doesn't either).
   212	
   213	    PLAN-111 Wave A cache, PLAN-182 W1 key: single-slot, keyed on
   214	    _project_dir_cache_key() (all resolver inputs). Cache HIT skips
   215	    re-construction of Path object. Cache MISS replaces the slot
   216	    atomically.
   217	
   218	    Single-threaded contract: concurrent os.environ mutation = UB.
   219	    """
   220	    global _PROJECT_DIR_CACHE
   221	    env_key = _project_dir_cache_key()
   222	    cached = _PROJECT_DIR_CACHE
   223	    if cached is not None and cached[0] == env_key:
   224	        return cached[1]
   225	    env_dir = env_key[0]
   226	    if env_dir:
   227	        p = Path(env_dir)
   228	    else:
   229	        p = _runtime_paths.runtime_state_dir()
   230	    _PROJECT_DIR_CACHE = (env_key, p)
   231	    return p
   232	
   233	
   234	def _invalidate_per_pid_caches_on_project_switch(old_dir: Path) -> None:
   235	    """Drop per-PID spool state when the resolved project changes.
   236	
   237	    rail r13 P1-1 (cura) + rail r14 (cura da cura): o flush do buffer
   238	    pendente e feito contra ``old_dir`` — o dir do projeto ANTERIOR, que
   239	    o chamador ja tem em cache. A primeira versao chamava
   240	    ``_flush_journal_buffer()``, que resolve o caminho por
   241	    ``_state_dir()``: como o cache ainda nao tinha sido trocado, aquilo
   242	    RE-ENTRAVA neste mesmo branch ate ``RecursionError`` e, pior,
   243	    reescrevia o payload antigo sob o dir do projeto NOVO — a
   244	    contaminacao cruzada que a invalidacao existe para impedir.
   245	
   246	    Fail-open: qualquer erro no flush apenas descarta os caches.
   247	    """
   248	    pid = os.getpid()
   249	    buf = _JOURNAL_BUFFER.get(pid)
   250	    if buf:
   251	        try:
   252	            target = old_dir / "{0}.{1}.journal".format(_JOURNAL_PREFIX, pid)
   253	            with target.open("ab") as fh:
   254	                for line in buf:
   255	                    fh.write(line)
   256	                fh.flush()
   257	                os.fsync(fh.fileno())
   258	        except Exception:  # pragma: no cover — nunca bloqueia a troca
   259	            pass
   260	    _SPOOL_HEADER_CACHE.pop(pid, None)
   261	    _ORDINAL_COUNTER.pop(pid, None)
   262	    _JOURNAL_BUFFER.pop(pid, None)
   263	
   264	
   265	def _state_dir() -> Path:
   266	    """Return <audit_dir>/state/ ensuring parents exist (0700).
   267	
   268	    P1-5: state dir is unconditionally a child of audit_emit._audit_dir();
   269	    no CEO_PROJECT_STATE_DIR override (audit_emit doesn't expose one).
   270	
   271	    PLAN-111 Wave A: single-slot cache keyed on (CEO_AUDIT_LOG_DIR, HOME).
   272	    Cache HIT skips mkdir syscall + Path construction (saves ~17us/call x
   273	    5.7x/emit cumulative ~= 100us/emit recovery).
   274	
   275	    Cache MISS semantics (AC-A2a + SA-K10 permission re-assertion +
   276	    PLAN-113 W4-SEC mode-mismatch self-heal):
   277	      1. Resolve target Path (uses _project_dir_from_env cache implicitly).
   278	      2. Attempt mkdir(parents=True, exist_ok=True, mode=0o700).
   279	      3. If mkdir FAILS: breadcrumb + DO NOT cache (next call retries).
   280	      4. If mkdir SUCCEEDS: validate via lstat() that dir is not a symlink,
   281	         is owned by os.getuid(), and has mode 0o700.
   282	         - symlink / wrong-owner mismatch: FAIL-CLOSED (raise) — we never
   283	           chmod-and-trust an attacker-controlled or other-owned dir.
   284	         - mode-only mismatch (e.g. a pre-existing state/ at 0o755 created
   285	           by an older path; exist_ok=True does NOT relax perms): attempt
   286	           SELF-HEAL via os.chmod(d, 0o700) then RE-lstat + re-validate the
   287	           full invariant. If it is now a non-symlink, owned by os.getuid(),
   288	           AND 0o700 → PROCEED (cache + return). Otherwise keep the SA-K10
   289	           fail-CLOSED.
   290	      5. Only if validation (incl. any self-heal) succeeds: cache the Path.
   291	
   292	    Single-threaded contract: concurrent os.environ mutation = UB.
   293	    """
   294	    global _STATE_DIR_CACHE
   295	    # PLAN-182 W1: key covers ALL resolver inputs (see
   296	    # _project_dir_cache_key) — a mid-process project switch must not be
   297	    # served the previous project's state dir.
   298	    env_key = _project_dir_cache_key()
   299	    cached = _STATE_DIR_CACHE
   300	    if cached is not None and cached[0] == env_key:
   301	        return cached[1]
   302	    # rail r13 P1-1: os caches POR PID (header/ordinal/journal) nao sao
   303	    # cobertos pela chave acima. Num processo longo A -> B -> A, o header
   304	    # de B seria reusado em A (UUID errado no corpo => o drain estrito
   305	    # QUARENTENA o spool de A) e o journal bufferizado poderia ir para o
   306	    # projeto errado. Uma transicao de projeto invalida os tres.
   307	    if cached is not None and cached[0] != env_key:
   308	        # passa o dir ANTIGO (cached[1]) — nunca re-resolve aqui.
   309	        _invalidate_per_pid_caches_on_project_switch(cached[1])
   310	    d = _project_dir_from_env() / "state"
   311	    mkdir_ok = False
   312	    try:
   313	        d.mkdir(parents=True, exist_ok=True, mode=0o700)
   314	        mkdir_ok = True
   315	    except OSError as e:
   316	        _breadcrumb(f"_state_dir mkdir failed (no cache): "
   317	                    f"{type(e).__name__}: {e}")
   318	    if mkdir_ok:
   319	        try:
   320	            import stat as _stat_mod
   321	
   322	            def _classify(st_mode: int, st_uid: int) -> "Optional[str]":
   323	                """Return a mismatch reason, or None when state/ is healthy."""
   324	                if _stat_mod.S_ISLNK(st_mode):
   325	                    return f"is_symlink: {d}"
   326	                if st_uid != os.getuid():
   327	                    return f"uid_mismatch: {st_uid} != {os.getuid()}"
   328	                if (st_mode & 0o777) != 0o700:
   329	                    return f"mode_mismatch: {oct(st_mode & 0o777)} != 0o700"
   330	                return None
   331	
   332	            st = os.lstat(str(d))
   333	            mismatch_reason: "Optional[str]" = _classify(st.st_mode, st.st_uid)
   334	
   335	            # PLAN-113 W4-SEC self-heal: a pre-existing state/ dir at a mode
   336	            # other than 0o700 (most commonly 0o755 from an older code path —
   337	            # exist_ok=True does NOT relax perms on an existing dir)
   338	            # previously fail-CLOSED on EVERY call, dropping the audit event
   339	            # and flooding the spool. Self-heal ONLY the mode-mismatch case
   340	            # (NEVER symlink / wrong-owner — chmod-and-trusting those is
   341	            # exactly the attack we fail closed on): chmod 0o700, then
   342	            # RE-lstat and re-validate the FULL invariant from scratch.
