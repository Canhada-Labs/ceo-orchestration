   736	    def test_unreadable_surface_is_unverified_not_absent(self):
   737	        unreadable = self.project_dir / "a-directory"
   738	        unreadable.mkdir()
   739	        result = lp.verify_entry_absent("A1", raw_path=unreadable)
   740	        self.assertFalse(result.verified)
   741	        self.assertEqual(result.outcome, "unreadable")
   742	
   743	    def test_unresolved_surface_is_not_a_verified_deletion(self):
   744	        """Rodada 6, P2 — `raw_path=None` nao e "arquivo ausente".
   745	
   746	        `None` significa que o chamador NAO conseguiu resolver a superficie:
   747	        nada foi lido. Devolver "absent" certificava uma delecao sem ler
   748	        superficie nenhuma — fail-open na entrada nao-resolvida.
   749	        """
   750	        result = lp.verify_entry_absent("A1", raw_path=None)
   751	        self.assertFalse(
   752	            result.verified,
   753	            "uma delecao foi certificada sem que nenhuma superficie fosse lida",
   754	        )
   755	        self.assertEqual(result.outcome, "unreadable")
   756	
   757	    def test_missing_file_holds_nothing(self):
   758	        result = lp.verify_entry_absent(
   759	            "A1", raw_path=self.project_dir / "no-such-ledger.md"
   760	        )
   761	        self.assertTrue(result.verified)
   762	        self.assertEqual(result.outcome, "absent")
   763	
   764	    def test_surface_over_the_read_cap_is_unreadable_not_absent(self):
   765	        """Pair-rail round 1, P1 — the fail-OPEN this closes.
   766	
   767	        The verification read is capped. If a surface exceeds the cap and
   768	        the marker lives PAST the prefix, a capped read that returns the
   769	        prefix makes ``verify_entry_absent`` search the wrong bytes, find
   770	        nothing, and certify a deletion that never happened. The ledger
   771	        size ceiling is advisory, so nothing upstream guarantees the file
   772	        fits.
   773	
   774	        POSITIVE CONTROL: the marker is written AFTER the cap, so the only
   775	        way to reach it is to notice truncation. A prefix-returning read
   776	        reports ``verified=True`` here (the bug); the fixed read reports
   777	        ``unreadable``, which ``DELETION_OUTCOMES`` defines as NOT absent.
   778	        """
   779	        big = self.project_dir / "huge-ledger.md"
   780	        marker = lp.entry_marker("A1")
   781	        pad = "x" * (lp._VERIFY_READ_CAP_BYTES + 4096)
   782	        big.write_text(pad + "\n" + marker + " still here\n", encoding="utf-8")
   783	        self.assertGreater(big.stat().st_size, lp._VERIFY_READ_CAP_BYTES)
   784	
   785	        result = lp.verify_entry_absent("A1", raw_path=big)
   786	        self.assertFalse(
   787	            result.verified,
   788	            "a surface too big to read whole was certified as verified — "
   789	            "that is the fail-open this test exists to catch",
   790	        )
   791	        self.assertEqual(result.outcome, "unreadable")
   792	
   793	    def test_surface_exactly_at_the_read_cap_still_reads(self):
   794	        """The boundary is not off by one: a file that fits EXACTLY in the
   795	        cap is a complete read, not a truncated one."""
   796	        exact = self.project_dir / "exact-ledger.md"
   797	        exact.write_bytes(b"y" * lp._VERIFY_READ_CAP_BYTES)
   798	        self.assertEqual(exact.stat().st_size, lp._VERIFY_READ_CAP_BYTES)
   799	        result = lp.verify_entry_absent("A1", raw_path=exact)
   800	        self.assertTrue(result.verified)
   801	        self.assertEqual(result.outcome, "absent")
   802	
   803	    def test_a_raising_deleter_is_still_verified_against_disk(self):
   804	        def _boom():
   805	            raise RuntimeError("delete failed")
   806	
   807	        result = lp.delete_and_verify(
