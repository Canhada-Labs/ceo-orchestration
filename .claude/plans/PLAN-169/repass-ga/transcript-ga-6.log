  2982	    redact_secrets call internally collapses whitespace already
  2983	    (see _lib/redact.py); the outer collapse was an O(N) no-op on
  2984	    the hot path that doubled the string scan cost for long inputs.
  2985	    str() coercion kept for defense-in-depth on Optional callers.
  2986	    KERNEL FILE - landed under CEO_KERNEL_OVERRIDE per ADR-116.
  2987	    """
  2988	    if not text:
  2989	        return ""
  2990	    redacted = _redact.redact_secrets(str(text))
  2991	    if len(redacted) > max_len:
  2992	        return redacted[: max_len - 1] + "…"
  2993	    return redacted
