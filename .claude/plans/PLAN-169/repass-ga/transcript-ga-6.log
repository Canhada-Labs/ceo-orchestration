   673	class TestPostDeletionVerification(_Base):
   674	    def setUp(self):
   675	        super().setUp()
   676	        self.raw = self.project_dir / "LEDGER.md"
   677	        self.summary = self.project_dir / "LEDGER-SUMMARY.md"
   678	        body = "\n".join(
   679	            [
   680	                "# ledger",
   681	                lp.render_entry(_entry("ceo-derived", "unit U5 landed", "U5")),
   682	                lp.render_entry(_entry("agent-returned", "agent said x", "A1")),
   683	            ]
   684	        )
   685	        self.raw.write_text(body + "\n", encoding="utf-8")
   686	        self.summary.write_text(
   687	            lp.render_entry(_entry("ceo-derived", "U5 summary", "U5")) + "\n",
   688	            encoding="utf-8",
   689	        )
   690	
   691	    def _drop(self, path, entry_id):
   692	        marker = lp.entry_marker(entry_id)
   693	        kept = [
   694	            line
   695	            for line in path.read_text(encoding="utf-8").splitlines()
   696	            if marker not in line
   697	        ]
   698	        path.write_text("\n".join(kept) + "\n", encoding="utf-8")
   699	
   700	    def test_a_real_deletion_verifies(self):
   701	        result = lp.delete_and_verify(
   702	            "A1",
   703	            raw_path=self.raw,
   704	            summary_path=self.summary,
   705	            deleter=lambda: self._drop(self.raw, "A1"),
   706	        )
   707	        self.assertTrue(result.verified)
   708	        self.assertEqual(result.outcome, "absent")
   709	        self.assertEqual(result.surfaces_checked_count, 2)
   710	        self.assertEqual(result.surfaces_holding, ())
   711	
   712	    def test_a_failed_delete_is_caught(self):
   713	        result = lp.delete_and_verify(
   714	            "A1",
   715	            raw_path=self.raw,
   716	            summary_path=self.summary,
   717	            deleter=lambda: None,  # presumes success, does nothing
   718	        )
   719	        self.assertFalse(result.verified)
   720	        self.assertEqual(result.outcome, "present")
   721	        self.assertEqual(result.surfaces_holding, ("raw",))
   722	        self.assertGreaterEqual(result.occurrences_count, 1)
   723	
   724	    def test_summary_surface_is_audited_separately_from_raw(self):
