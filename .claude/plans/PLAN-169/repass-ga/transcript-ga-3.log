  2670	# PLAN-135 W1 (unit w0r) — pre-flight model-deprecation advisory.
  2671	# Runs check-model-deprecations.py --check against the TARGET when the checker
  2672	# is available (source copy preferred — fresher ledger; falls back to the
  2673	# target's installed copy). NEVER blocks the upgrade: findings emit stderr
  2674	# WARNING lines (F-CHAOS-3 convention); any infra failure (no python3, corrupt
  2675	# ledger, unexpected rc) degrades to a NOTE and the upgrade proceeds
  2676	# (fail-open per CLAUDE.md §5). Suppress with --no-deprecation-warn.
  2677	# ---------------------------------------------------------------------------
  2678	_emit_deprecation_warnings() {
  2679	  [[ "$DEPRECATION_WARN" -eq 1 ]] || return 0
  2680	  local checker=""
  2681	  if [[ -f "$SOURCE_DIR/.claude/scripts/check-model-deprecations.py" ]]; then
  2682	    checker="$SOURCE_DIR/.claude/scripts/check-model-deprecations.py"
  2683	  elif [[ -f "$TARGET/.claude/scripts/check-model-deprecations.py" ]]; then
  2684	    checker="$TARGET/.claude/scripts/check-model-deprecations.py"
  2685	  fi
  2686	  [[ -n "$checker" ]] || return 0
  2687	  if ! command -v python3 >/dev/null 2>&1; then
  2688	    echo "    NOTE: model-deprecation scan skipped (python3 not found) — advisory only" >&2
  2689	    return 0
  2690	  fi
  2691	  local dep_rc=0
  2692	  python3 "$checker" --check "$TARGET" >/dev/null 2>&1 || dep_rc=$?
  2693	  if [[ "$dep_rc" -eq 1 ]]; then
  2694	    echo "    WARNING: deprecated/retiring Claude model ids detected in target" >&2
  2695	    echo "             (already retired, or <=60 days to retirement). Full report:" >&2
  2696	    echo "             python3 $checker $TARGET" >&2
  2697	  elif [[ "$dep_rc" -ne 0 ]]; then
  2698	    echo "    NOTE: model-deprecation scan inconclusive (rc=$dep_rc) — advisory only" >&2
  2699	  fi
  2700	  return 0
  2701	}
