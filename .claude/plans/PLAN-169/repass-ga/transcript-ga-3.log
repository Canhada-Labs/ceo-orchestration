   166	_ACTION_CANDIDATE_WRITTEN = "lesson_candidate_written"
   167	_ACTION_APPROVED = "lesson_approved"
   168	_ACTION_QUARANTINED = "lesson_quarantined"
   169	_ACTION_EXPIRED = "lesson_expired"
   170	_ACTION_INTEGRITY_FLAG = "lesson_integrity_flag"
