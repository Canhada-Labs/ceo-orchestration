     2	# uninstall.sh — manifest-honoring uninstaller for ceo-orchestration
     3	# (PLAN-083 sub-1.9)
     4	#
     5	# Safety property: ONLY removes files whose current sha256 matches the
     6	# recorded manifest entry. Files modified by the user post-install have
     7	# divergent SHAs and are PRESERVED. Files NOT listed in the manifest
     8	# (Owner-authored, never installed by us) are also PRESERVED.
     9	#
    10	# Usage:
    11	#   ./uninstall.sh <target-repo-path> [options]
    12	#
    13	# Options:
    14	#   --dry-run                  Preview what WOULD be removed; touch nothing
    15	#   --restore <backup-path>    Inverse mode: restore .claude/ from a backup .tar.gz
    16	#   --force                    Remove files even if SHA mismatches (DESTRUCTIVE)
    17	#   --no-backup                Skip the pre-uninstall backup tarball
    18	#   --no-hmac-verify           Skip HMAC verification of the restore backup's .hmac sidecar
    19	#   -h, --help                 Show this help
    20	#
    21	# Exit codes:
    22	#   0  success (or dry-run preview)
    23	#   1  generic failure / invalid args
    24	#   2  target path invalid OR no manifest found
    25	#   3  (reserved) — the install MANIFEST is NOT HMAC-verified in this version.
    26	#      The pre-uninstall backup gets an HMAC sidecar ONLY when a target-local
    27	#      key exists (.claude/.audit-key or .claude/.install-backup-key); neither
    28	#      install nor upgrade creates one in copy mode, so a normal backup is
    29	#      UNSIGNED and --restore accepts it as such (rc.1 condition 51). A
    30	#      manifest record is trusted for its PATH shape and SHA only.
    31	#   4  --restore: backup tar.gz invalid or HMAC mismatch
    32	#   5  uninstall INCOMPLETE: SHA mismatches encountered without --force
    33	#      (user-modified files preserved, manifest kept)
    34	#   6  uninstall INCOMPLETE: one or more manifest records REFUSED (unsafe
    35	#      path, symlinked ancestor, a relpath recorded more than once, or an
   232	# ---------------------------------------------------------------------------
   233	# RESTORE MODE — invert a backup
   234	# ---------------------------------------------------------------------------
   235	if [ -n "$RESTORE_PATH" ]; then
   236	  if [ ! -f "$RESTORE_PATH" ]; then
   237	    echo "ERROR: backup file not found: $RESTORE_PATH" >&2
   238	    exit 4
   239	  fi
   240	  _log "==> Restore mode: $RESTORE_PATH -> $TARGET"
   241	
   242	  # Optional HMAC verification of backup
   243	  if [ -f "$RESTORE_PATH.hmac" ] && [ "$NO_HMAC_VERIFY" -eq 0 ]; then
   244	    key_path="$(_resolve_backup_key || true)"
   245	    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
   246	      expected_hmac="$(awk '{print $1; exit}' "$RESTORE_PATH.hmac")"
   247	      actual_hmac="$(python3 -c "
   248	import hashlib, hmac, sys
   249	key = open('$key_path', 'rb').read()
   250	tar_sha = hashlib.sha256(open('$RESTORE_PATH', 'rb').read()).digest()
   251	sys.stdout.write(hmac.new(key, tar_sha, hashlib.sha256).hexdigest())
   252	")"
