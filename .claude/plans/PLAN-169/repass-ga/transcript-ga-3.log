   274	    # $TARGET/.claude directory, which the `! -d` guard would treat as "already
   275	    # restored". Clear the partial first so the moved-aside tree comes back
   276	    # whole rather than merged with half an extraction.
   277	    if [ -n "${aside:-}" ] && [ -d "$aside" ]; then
   278	      rm -rf "$TARGET/.claude" 2>/dev/null || true
   279	      mv "$aside" "$TARGET/.claude"
