   392	# Restore one hash-record file from SOURCE_DIR. Preconditions already checked
   393	# by the caller: source exists AND H_src == H_base, and DRY_RUN handled by the
   394	# caller (a dry-run preview leaves the finding UNRESOLVED — the disk still
   395	# drifts, so the exit code must stay 1). $1=rel $2=base-digest.
   396	# Returns 0 on verified restore, 1 otherwise.
   397	_restore_file() {
