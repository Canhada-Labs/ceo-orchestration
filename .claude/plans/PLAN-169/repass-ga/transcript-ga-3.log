   441	# PLAN-185-FOLLOWUP FU-7 (S340, rail r4 P1): `read -r` DROPS or truncates at a
   442	# NUL byte before any per-field check can see it, so a record carrying 0x00 is
   443	# not sanitizable line by line — it is unparseable security input and fails
   444	# CLOSED here, on the RAW bytes, before the line loop (same exit class as an
   445	# empty/corrupted manifest). Counted with tr on the raw file: locale-independent.
   446	_nul_count="$( LC_ALL=C tr -cd '\000' < "$MANIFEST" | wc -c | tr -d ' ' )"
   447	if [ "${_nul_count:-0}" -gt 0 ]; then
   448	  echo "ERROR: manifest at $MANIFEST carries $_nul_count NUL byte(s) — unparseable (corrupted or tampered); refusing to verify." >&2
   449	  echo "       Run upgrade.sh to regenerate the baseline." >&2
   450	  exit 2
   451	fi
   452	
   453	# Pin the manifest identity (device:inode by lstat — `stat` without -L; the GNU
   454	# spelling is tried first because `stat -f` is a DIFFERENT command on GNU and
   455	# would succeed with filesystem numbers) so every write below re-proves it is
   456	# the SAME regular file the sanitizer read: a leaf swapped for a link or for
   457	# another file mid-run is refused before the write, never followed.
   458	_manifest_identity() { stat -c '%d:%i' "$1" 2>/dev/null || stat -f '%d:%i' "$1" 2>/dev/null; }
   459	_MANIFEST_ID="$( _manifest_identity "$MANIFEST" )"
   460	if [ -z "$_MANIFEST_ID" ]; then
   461	  echo "ERROR: cannot establish the identity of $MANIFEST (stat failed); refusing to verify." >&2
   462	  exit 2
   463	fi
   464	# rc 0 only while the manifest is still that non-symlink regular file.
   465	_manifest_still_pinned() {
   466	  [ ! -L "$MANIFEST" ] && [ -f "$MANIFEST" ] \
   467	    && [ "$( _manifest_identity "$MANIFEST" )" = "$_MANIFEST_ID" ]
   468	}
   469	# One refusal for every write site (restore, backup+restore, re-link); the
   470	# caller counts the finding as unresolved exactly as it does for a refused
   471	# destination.
   472	_manifest_pin_refused() {
   473	  _log "    REFUSED: the install manifest changed identity or became a SYMLINK during this run — nothing written: $1"
   474	  REFUSED_COUNT=$((REFUSED_COUNT + 1))
   475	}
   476	
   477	while IFS= read -r line || [ -n "$line" ]; do
   478	  [ -n "$line" ] || continue
   479	  case "$line" in
   480	    '#'*) continue ;;
   481	    LINK\ \ *)
   482	      rest="${line#LINK  }"
   483	      case "$rest" in
   484	        *"  "*)
   485	          rel="${rest%%  *}"
   486	          target="${rest#*  }"
   487	          ;;
   488	        *) _mark_dropped "malformed LINK record (no target)" "$rest"; continue ;;
   489	      esac
   490	      if [ -z "$target" ] || _field_has_control_bytes "$target"; then
   491	        _mark_dropped "LINK target empty or carrying a control byte" "$rel"; continue
   492	      fi
   493	      if _relpath_unsafe "$rel" link; then
   494	        _mark_dropped "unsafe manifest path (traversal, absolute, control character, or symlinked ancestor)" "$rel"
   495	        continue
   496	      fi
   497	      if _seen_before "$rel"; then
   498	        _mark_invalid "$rel"
   499	        _mark_dropped "duplicate relpath (ambiguous — every record for it is dropped)" "$rel"
   500	        continue
   501	      fi
   502	      _mark_seen "$rel"
   503	      printf 'LINK  %s  %s\n' "$rel" "$target" >> "$SANITIZED"
   504	      ;;
   505	    *)
   506	      digest="${line%%  *}"
   507	      rel="${line#*  }"
   508	      if [ "$digest" = "$line" ]; then
   509	        _mark_dropped "malformed record (no two-space separator)" "$line"
   510	        continue
   511	      fi
   512	      case "$digest" in
   513	        *[!0-9a-f]*) _mark_dropped "malformed record (digest is not hexadecimal)" "$rel"; continue ;;
   514	      esac
   515	      if [ "${#digest}" -ne 64 ]; then
   516	        _mark_dropped "malformed record (digest is not 64 characters)" "$rel"
   517	        continue
   518	      fi
   519	      if _relpath_unsafe "$rel" file; then
   520	        _mark_dropped "unsafe manifest path (traversal, absolute, control character, or symlinked ancestor)" "$rel"
   521	        continue
   522	      fi
   523	      if _seen_before "$rel"; then
   524	        _mark_invalid "$rel"
   525	        _mark_dropped "duplicate relpath (ambiguous — every record for it is dropped)" "$rel"
   526	        continue
   527	      fi
   528	      _mark_seen "$rel"
   529	      printf '%s  %s\n' "$digest" "$rel" >> "$SANITIZED"
   530	      ;;
   531	  esac
   532	done < "$MANIFEST"
   533	
   534	# Second pass: drop records for relpaths flagged ambiguous (dup) — they were
   535	# emitted on first sight before the dup was discovered.
   536	if [ "$_INVALID" != "
   537	" ]; then
   538	  : > "$SANITIZED.f"
   539	  while IFS= read -r line || [ -n "$line" ]; do
   540	    case "$line" in
   541	      LINK\ \ *) rel_probe="${line#LINK  }"; rel_probe="${rel_probe%%  *}" ;;
   542	      *)         rel_probe="${line#*  }" ;;
   543	    esac
   544	    case "$_INVALID" in
   545	      *"
   546	$rel_probe
   547	"*) _mark_dropped "duplicate relpath (this earlier record is dropped too)" "$rel_probe"; continue ;;
   548	    esac
   549	    printf '%s\n' "$line" >> "$SANITIZED.f"
   550	  done < "$SANITIZED"
   551	  mv "$SANITIZED.f" "$SANITIZED"
   552	fi
   553	
   554	if [ ! -s "$SANITIZED" ]; then
   555	  # PLAN-185-FOLLOWUP FU-7 (S340, rail r2 P2): when EVERY record was rejected the
   556	  # drop report further down is never reached — print it here first, so an
   557	  # all-dropped manifest still tells the operator what was dropped and why.
   558	  if [ "$DROPPED_COUNT" -gt 0 ]; then
   559	    _log "==> Manifest records DROPPED at ingest — every record was rejected:"
   560	    printf '%s' "$_DROPPED"
   561	    if [ "$DROPPED_COUNT" -gt "$_DROP_LIST_CAP" ]; then
   562	      _log "    ... and $(( DROPPED_COUNT - _DROP_LIST_CAP )) more (names sanitized: non-printable shown as '?', truncated to 160 characters)"
   563	    fi
   564	    _log "    Dropped:   $DROPPED_COUNT (unsafe or malformed manifest records — NOT verified)"
   565	  fi
   566	  echo "ERROR: manifest at $MANIFEST contains no valid records after sanitization." >&2
   567	  echo "       It may be corrupted. Run upgrade.sh to regenerate the baseline." >&2
   568	  exit 2
   569	fi
