   372	# Per-file confirmation: --yes-file match, else interactive [y/N] on a TTY,
   373	# else refuse (0 = confirmed, 1 = not confirmed).
   374	_confirmed() {
   375	  _cf_rel="$1"
   376	  case "$YES_FILES" in
   377	    *"
   378	$_cf_rel
   379	"*) return 0 ;;
   380	  esac
   381	  if [ -t 0 ] && [ -r /dev/tty ]; then
   382	    printf '    restore %s (overwrites your modified copy; backup taken)? [y/N] ' "$_cf_rel"
   383	    _cf_ans=""
   384	    read -r _cf_ans < /dev/tty || _cf_ans=""
   385	    case "$_cf_ans" in
   386	      y|Y|yes|YES) return 0 ;;
   387	    esac
   388	  fi
   389	  return 1
   390	}
