  1075	# ---------------------------------------------------------------------------
  1076	# Orphan scan (report-only): files present under the framework-owned
  1077	# enumeration (_framework_manifest_set.sh, FMS_ROOT=$TARGET) with NO manifest
  1078	# record. Candidates ONLY — they may be adopter-authored; never removed.
  1079	# ---------------------------------------------------------------------------
  1080	if [ "$NO_ORPHAN_SCAN" -eq 0 ]; then
  1081	  # W6: the old `if [ "$HAVE_FMS" -eq 1 ]` guard and its "orphan scan skipped"
  1082	  # else-branch are GONE, not silenced — _framework_manifest_set.sh is required
  1083	  # at startup now, so the branch was unreachable, and an unreachable branch
  1084	  # that reports a degraded mode is a lie a future reader has to disprove.
  1085	  {
  1086	    if [ -n "$PROFILE" ]; then
  1087	      PROFILE_PARTS_STR="$( printf '%s' "$PROFILE" | tr ',' ' ' )"
  1088	    else
  1089	      # Auto-detect: core + frontend (absent dirs are skipped by the
  1090	      # enumerator) + every installed domain dir.
  1091	      PROFILE_PARTS_STR="core frontend"
  1092	      if [ -d "$TARGET/.claude/skills/domains" ]; then
  1093	        for d in "$TARGET/.claude/skills/domains"/*/; do
  1094	          [ -d "$d" ] || continue
  1095	          PROFILE_PARTS_STR="$PROFILE_PARTS_STR $( basename "$d" )"
  1096	        done
  1097	      fi
  1098	    fi
  1099	    # PLAN-166 F3 (ADR-155-AMEND-1): the FMS entries for PROTOCOL.md,
  1100	    # SPEC/v1 and .claude/.framework-version are CONDITIONAL on the
  1101	    # recorded delivery. doctor resolves the flags from the SAME record
  1102	    # the writers use — the sanitized baseline manifest — NEVER from the
  1103	    # ceremony: ceremony-only resolution would re-include paths a
  1104	    # `--ceremony user` install skipped and --strict-orphans would flag
  1105	    # the ADOPTER's own SPEC/PROTOCOL files as orphans (r19), while a
  1106	    # blanket maintainer default would do the same and a blanket user
  1107	    # default would hide a delivered SPEC from a maintainer (r9 P2).
  1108	    _dr_delivered() {  # $1 = ERE fragment anchored at the relpath position
  1109	      grep -Eq "^([0-9a-f]{64}|LINK)  $1" "$SANITIZED" 2>/dev/null
  1110	    }
  1111	    # `SPEC/v1(/|  |$)` and not a bare `SPEC/v1/`: a --mode link install
  1112	    # records the whole tree as ONE directory symlink (`LINK  SPEC/v1
  1113	    # <target>`, no trailing slash) — the same `(  |$)` treatment the
  1114	    # PROTOCOL/marker fragments below already have (re-pass closure; family
  1115	    # swept with upgrade.sh _baseline_has_spec_record).
  1116	    if _dr_delivered 'SPEC/v1(/|  |$)'; then
  1117	      FMS_DELIVERED_SPEC=1
  1118	    else
  1119	      FMS_DELIVERED_SPEC=0
  1120	    fi
  1121	    if _dr_delivered 'PROTOCOL\.md(  |$)'; then
  1122	      FMS_DELIVERED_PROTOCOL=1
  1123	    else
  1124	      FMS_DELIVERED_PROTOCOL=0
  1125	    fi
  1126	    if _dr_delivered '\.claude/\.framework-version(  |$)'; then
  1127	      FMS_DELIVERED_MARKER=1
  1128	    else
  1129	      FMS_DELIVERED_MARKER=0
  1130	    fi
  1131	    export FMS_DELIVERED_SPEC FMS_DELIVERED_PROTOCOL FMS_DELIVERED_MARKER
  1132	    export FMS_ROOT="$TARGET"
  1133	    export FMS_PROFILE_PARTS="$PROFILE_PARTS_STR"
  1134	    _framework_manifest_files > "$WORKDIR/enumerated" 2>/dev/null || : > "$WORKDIR/enumerated"
  1135	    unset FMS_ROOT FMS_PROFILE_PARTS
  1136	    unset FMS_DELIVERED_SPEC FMS_DELIVERED_PROTOCOL FMS_DELIVERED_MARKER
  1137	    # Manifest relpaths (both record kinds).
  1138	    awk '{
  1139	      idx = index($0, "  ");
  1140	      if (idx == 0) next;
  1141	      d = substr($0, 1, idx - 1);
  1142	      rest = substr($0, idx + 2);
  1143	      if (d == "LINK") { j = index(rest, "  "); if (j > 0) rest = substr(rest, 1, j - 1) }
  1144	      print rest;
  1145	    }' "$SANITIZED" | LC_ALL=C sort -u > "$WORKDIR/manifest-rels"
  1146	    LC_ALL=C sort -u "$WORKDIR/enumerated" > "$WORKDIR/enumerated.sorted"
  1147	    comm -23 "$WORKDIR/enumerated.sorted" "$WORKDIR/manifest-rels" > "$WORKDIR/orphans" || : > "$WORKDIR/orphans"
  1148	    if [ -s "$WORKDIR/orphans" ]; then
  1149	      _log ""
  1150	      _log "==> Orphan candidates (present in framework-owned dirs, absent from manifest;"
  1151	      _log "    possibly adopter-authored — REPORT-ONLY, nothing is removed):"
  1152	      while IFS= read -r orel; do
  1153	        [ -n "$orel" ] || continue
  1154	        ORPHAN_COUNT=$((ORPHAN_COUNT + 1))
  1155	        _log "    ORPHAN?: $orel"
  1156	      done < "$WORKDIR/orphans"
  1157	    fi
  1158	  }
  1159	fi
