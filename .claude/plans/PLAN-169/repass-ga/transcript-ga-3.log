   846	      if [ -L "$lpath" ]; then
   847	        cur_target="$( readlink "$lpath" 2>/dev/null || true )"
   848	        if [ "$cur_target" = "$target" ]; then
   849	          OK_COUNT=$((OK_COUNT + 1))
   850	          [ "$VERBOSE" -eq 1 ] && _log "    OK (link): $rel"
   851	          continue
   852	        fi
   853	      fi
   854	      if [ ! -e "$lpath" ] && [ ! -L "$lpath" ]; then
   855	        MISSING_COUNT=$((MISSING_COUNT + 1))
   856	        _log "    MISSING (link): $rel -> $target"
   857	        if [ "$REPAIR" -eq 1 ]; then
   858	          if [ "$DRY_RUN" -eq 1 ]; then
   859	            _log "    (dry-run) would RE-LINK: $rel -> $target"
   860	            WOULD_REPAIR=$((WOULD_REPAIR + 1))
   861	            UNRESOLVED=$((UNRESOLVED + 1))
   862	          elif ! _manifest_still_pinned; then
   863	            _manifest_pin_refused "$rel"
   864	            UNRESOLVED=$((UNRESOLVED + 1))
   865	          elif _link_dst_refuses "$rel"; then
   866	            UNRESOLVED=$((UNRESOLVED + 1))
   867	          else
   868	            mkdir -p "$TARGET/$( dirname "$rel" )"
   869	            if ln -s "$target" "$lpath" 2>/dev/null; then
   870	              _log "    RE-LINKED: $rel -> $target"
   871	              REPAIRED_COUNT=$((REPAIRED_COUNT + 1))
   872	              [ -e "$lpath" ] || _log "    NOTE: link target does not exist (broken link recreated as recorded): $target"
   873	            else
   874	              _log "    RESTORE-FAILED (ln -s failed): $rel"
   875	              UNRESOLVED=$((UNRESOLVED + 1))
   876	            fi
   877	          fi
   878	        else
   879	          UNRESOLVED=$((UNRESOLVED + 1))
   880	        fi
   881	        continue
   882	      fi
   883	      # Present but wrong: retargeted symlink, or a regular file replaced it.
   884	      DRIFT_COUNT=$((DRIFT_COUNT + 1))
   885	      _log "    DRIFT (link: expected -> $target): $rel"
   886	      if [ "$REPAIR" -eq 1 ]; then
   887	        if _confirmed "$rel"; then
   888	          if [ "$DRY_RUN" -eq 1 ]; then
   889	            _log "    (dry-run) would RE-LINK (replacing current): $rel -> $target"
   890	            WOULD_REPAIR=$((WOULD_REPAIR + 1))
   891	            UNRESOLVED=$((UNRESOLVED + 1))
   892	          elif ! _manifest_still_pinned; then
   893	            _manifest_pin_refused "$rel"
   894	            UNRESOLVED=$((UNRESOLVED + 1))
   895	          else
   896	            _lk_go=1
   897	            if [ -f "$lpath" ] && [ ! -L "$lpath" ]; then
   898	              if _backup_file "$rel"; then
   899	                _log "    BACKED-UP: $rel -> $BAK_DIR/$rel"
   900	              else
   901	                _lk_go=0   # FU-7: no backup, no overwrite
   902	              fi
   903	            fi
   904	            if [ "$_lk_go" -eq 0 ] || _link_dst_refuses "$rel"; then
   905	              UNRESOLVED=$((UNRESOLVED + 1))
   906	            else
   907	              rm -f "$lpath"
   908	              if ln -s "$target" "$lpath" 2>/dev/null; then
   909	                _log "    RE-LINKED: $rel -> $target"
   910	                REPAIRED_COUNT=$((REPAIRED_COUNT + 1))
   911	              else
   912	                _log "    RESTORE-FAILED (ln -s failed): $rel"
   913	                UNRESOLVED=$((UNRESOLVED + 1))
   914	              fi
   915	            fi
   916	          fi
   917	        else
   918	          SKIPPED_CONFIRM=$((SKIPPED_CONFIRM + 1))
   919	          UNRESOLVED=$((UNRESOLVED + 1))
   920	          _log "    SKIPPED (needs --yes-file '$rel' or interactive confirm): $rel"
   921	        fi
   922	      else
   923	        UNRESOLVED=$((UNRESOLVED + 1))
   924	      fi
   925	      ;;
   926	    *)
   927	      base="${line%%  *}"
   928	      rel="${line#*  }"
   929	      fpath="$TARGET/$rel"
   930	
   931	      if [ ! -e "$fpath" ] && [ ! -L "$fpath" ]; then
   932	        MISSING_COUNT=$((MISSING_COUNT + 1))
   933	        # D4: hash the route's SOURCE. A rendered route yields an empty
   934	        # src_hash on purpose, which the existing branch below already
   935	        # reports as not-repairable — the correct verdict.
   936	        _ms_rc=0
   937	        src_rel="$( _wbm_route_src "$rel" )" || _ms_rc=$?
   938	        if [ "$_ms_rc" -eq 2 ]; then
   939	          src_hash=""
   940	        else
   941	          if [ "$_ms_rc" -ne 0 ] || [ -z "${src_rel:-}" ]; then src_rel="$rel"; fi
