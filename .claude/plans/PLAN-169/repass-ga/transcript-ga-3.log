  2635	            _MARKER_DELIVERED=1
  2636	            _MARKER_HASH_SOURCE="HASH_PRIOR_RECORD"
  2637	          fi
  2638	          return 0
  2639	        fi
  2640	      fi
  2641	      mkdir -p "$( dirname "$dst" )"
  2642	      cp "$src" "$dst"
