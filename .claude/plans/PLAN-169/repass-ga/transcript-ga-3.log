  1239	if [ "$UNRESOLVED" -gt 0 ]; then
  1240	  exit 1
  1241	fi
  1242	if [ "$STRICT_ORPHANS" -eq 1 ] && [ "$ORPHAN_COUNT" -gt 0 ]; then
