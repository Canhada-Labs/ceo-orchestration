  2889	
  2890	  if [[ ! -f "$settings" ]]; then
  2891	    echo "    NOTE: settings-merge skipped — no $settings (fresh install builds it from template)" >&2
  2892	    return 0
  2893	  fi
  2894	  if ! command -v jq >/dev/null 2>&1; then
  2895	    echo "    NOTE: settings-merge skipped (jq not found) — register new framework hooks manually; advisory only" >&2
  2896	    return 0
  2897	  fi
  2898	  if [[ "$_tpl_posture" == "shared" ]]; then
  2899	    local _tpl_base="$SOURCE_DIR/templates/settings/settings.base.json"
  2900	    local _tpl_user="$SOURCE_DIR/templates/settings/settings.user.json"
  2901	    local _t _t_docs
  2902	    # BOTH sources are held to the standard the explicit postures apply to
  2903	    # their one template (rail round 9, P2): readable, exactly one JSON
  2904	    # document, an object with an object .hooks. A stream or a scalar would
  2905	    # otherwise be coerced into the derivation and applied as if it were real.
