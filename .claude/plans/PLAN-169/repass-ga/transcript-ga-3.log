  2938	    trap 'rm -f -- "$_UP_SHARED_TPL_TMP"' RETURN
  2939	    template="$_tpl_tmp"
  2940	    # What the two profiles PROVABLY agree on is their SETTINGS with equal
  2941	    # values — nothing else (rail round 9, P1). The hooks the two templates
  2942	    # share are identical blocks, but a hook's BEHAVIOUR can depend on a
  2943	    # setting the profiles disagree on (the config-protection hook blocks
  2944	    # unless the user profile's advisory switch is present), and that
  2945	    # dependency lives in code this script cannot read. So an unknown
  2946	    # ceremony registers NO hooks: the settings both profiles declare with the
  2947	    # same value are applied, everything else is WITHHELD and NAMED, and the
  2948	    # adopter is told how to state the ceremony. The pre-cure code pushed six
  2949	    # base-only literals into this population — and those six were the defect.
  2950	    if ! jq -n --slurpfile b "$_tpl_base" --slurpfile u "$_tpl_user" '
  2951	        ($b[0].env | if type == "object" then . else {} end) as $be
  2952	        | ($u[0].env | if type == "object" then . else {} end) as $ue
  2953	        | { hooks: {},
  2954	            env: ( $ue | with_entries(select( .key as $k | ($be | has($k)) and ($be[$k] == .value) )) ) }' \
  2955	        > "$template" 2>/dev/null || [[ ! -s "$template" ]]; then
  2956	      echo "    NOTE: settings-merge skipped — could not derive the settings shared by settings.base.json and settings.user.json; advisory only" >&2
  2957	      return 0
  2958	    fi
  2959	    local _wh_b _wh_u _we_b _we_u
  2960	    _wh_b="$( jq '[.hooks | to_entries[] | .value[]] | length' "$_tpl_base" 2>/dev/null || printf '?' )"
  2961	    _wh_u="$( jq '[.hooks | to_entries[] | .value[]] | length' "$_tpl_user" 2>/dev/null || printf '?' )"
  2962	    _we_b="$( jq --slurpfile s "$template" '((.env // {}) | length) - (($s[0].env // {}) | length)' "$_tpl_base" 2>/dev/null || printf '?' )"
  2963	    _we_u="$( jq --slurpfile s "$template" '((.env // {}) | length) - (($s[0].env // {}) | length)' "$_tpl_user" 2>/dev/null || printf '?' )"
  2964	    echo "    NOTE: ceremony UNKNOWN (no readable install-state, no --ceremony, no CEO_UPGRADE_CEREMONY) — NO hook registration is applied until the ceremony is stated; only the settings BOTH profiles declare with the same value are. WITHHELD: $_wh_b registration(s) + $_we_b setting(s) of settings.base.json, $_wh_u + $_we_u of settings.user.json. Pass --ceremony maintainer|user to register the profile you installed." >&2
  2965	  fi
  2966	  if [[ ! -r "$template" ]]; then
  2967	    echo "    NOTE: settings-merge skipped — template unreadable at $template; advisory only" >&2
  2968	    return 0
  2969	  fi
  2970	  # ONE document, exactly (rail round 7, P2). `jq -e` over a FILE validates
