   121	            out="benchmark-results/${base}.json"
   122	            md="benchmark-results/${base}.md"
   123	            # `$?` inside `if ! cmd` is the status of `!` (always 0), so the
   124	            # floor breach was reported as "runner error rc=0": capture the
   125	            # real status first, then branch on it.
