   292	    exit 4
   293	  fi
   294	
   295	  if _dry "would EXTRACT $RESTORE_PATH into $TARGET ($(grep -c . "$_rst_list") member(s) listed)"; then
   296	    rm -f "$_rst_list"
   297	    exit 0
   298	  fi
