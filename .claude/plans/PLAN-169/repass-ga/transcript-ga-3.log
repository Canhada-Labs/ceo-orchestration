   972	            if [ "$DRY_RUN" -eq 1 ]; then
   973	              _log "    (dry-run) would RESTORE: $rel"
   974	              WOULD_REPAIR=$((WOULD_REPAIR + 1))
   975	              UNRESOLVED=$((UNRESOLVED + 1))
   976	            elif _restore_file "$rel" "$base"; then
   977	              REPAIRED_COUNT=$((REPAIRED_COUNT + 1))
   978	            else
   979	              UNRESOLVED=$((UNRESOLVED + 1))
   980	            fi
   980	            fi
   981	          else
   982	            UNRESOLVED=$((UNRESOLVED + 1))
   983	          fi
   984	        fi
   985	        continue
   986	      fi
   987	
   988	      if [ -L "$fpath" ] || [ ! -f "$fpath" ]; then
   989	        # Hash record but the path is now a symlink / non-regular file. Never
   990	        # hash-through or repair-through it (symlink write-through escape).
   991	        DRIFT_COUNT=$((DRIFT_COUNT + 1))
   992	        BLOCKED_COUNT=$((BLOCKED_COUNT + 1))
   993	        UNRESOLVED=$((UNRESOLVED + 1))
   994	        _log "    DRIFT (type-change: regular file recorded, non-file found — not repairable): $rel"
   995	        continue
   996	      fi
   997	
   998	      cur="$( _hash_file "$fpath" 2>/dev/null || true )"
   999	      if [ "$cur" = "$base" ]; then
  1000	        OK_COUNT=$((OK_COUNT + 1))
  1001	        [ "$VERBOSE" -eq 1 ] && _log "    OK: $rel"
  1002	        continue
  1003	      fi
  1004	
  1005	      DRIFT_COUNT=$((DRIFT_COUNT + 1))
  1006	      # D4: hash the route's SOURCE (see the MISSING branch above).
  1007	      _dr_rc=0
  1008	      src_rel="$( _wbm_route_src "$rel" )" || _dr_rc=$?
  1009	      if [ "$_dr_rc" -eq 2 ]; then
  1010	        src_hash=""
  1011	      else
  1012	        if [ "$_dr_rc" -ne 0 ] || [ -z "${src_rel:-}" ]; then src_rel="$rel"; fi
  1013	        # rail round-8 — the same physical confinement the MISSING branch above
  1014	        # explains. THIS is the site the finding named: unguarded, a symlinked
  1015	        # source made `cur` and `src_hash` agree on the FOREIGN bytes and the
  1016	        # run reported `DRIFT (baseline-stale)`, i.e. "your baseline is behind
  1017	        # the framework, run upgrade.sh" — laundering content from outside the
  1018	        # checkout into the adopter's recorded framework baseline. Refused, the
  1019	        # empty src_hash lands on the existing not-repairable verdict below.
  1020	        if _wbm_source_confined "$SOURCE_DIR" "$src_rel"; then
  1021	          src_hash="$( _hash_file "$SOURCE_DIR/$src_rel" 2>/dev/null || true )"
  1022	        else
  1023	          _log "    SOURCE-BLOCKED (source '$src_rel' is not confined to the framework checkout — ${_WBM_SRC_CONFINE_WHY:-unknown reason}): $rel"
  1024	          src_hash=""
  1025	        fi
  1026	      fi
  1027	      if [ -z "$src_hash" ]; then
  1028	        _log "    DRIFT (framework checkout no longer ships this file — not repairable): $rel"
  1029	        BLOCKED_COUNT=$((BLOCKED_COUNT + 1))
  1030	        UNRESOLVED=$((UNRESOLVED + 1))
  1031	      elif [ "$cur" = "$src_hash" ]; then
  1032	        _log "    DRIFT (baseline-stale: file matches CURRENT framework; run upgrade.sh to refresh the baseline): $rel"
  1033	        BLOCKED_COUNT=$((BLOCKED_COUNT + 1))
  1034	        UNRESOLVED=$((UNRESOLVED + 1))
  1035	      elif [ "$src_hash" = "$base" ]; then
  1036	        _log "    DRIFT (adopter-modified): $rel"
  1037	        if [ "$REPAIR" -eq 1 ]; then
  1038	          if _confirmed "$rel"; then
  1039	            if [ "$DRY_RUN" -eq 1 ]; then
  1040	              _log "    (dry-run) would BACKUP + RESTORE: $rel"
  1041	              WOULD_REPAIR=$((WOULD_REPAIR + 1))
  1042	              UNRESOLVED=$((UNRESOLVED + 1))
  1043	            else
  1044	              if ! _manifest_still_pinned; then
  1045	                _manifest_pin_refused "$rel"
  1046	                UNRESOLVED=$((UNRESOLVED + 1))
  1047	              elif _backup_file "$rel"; then
  1048	                _log "    BACKED-UP: $rel -> $BAK_DIR/$rel"
  1049	                if _restore_file "$rel" "$base"; then
  1050	                  REPAIRED_COUNT=$((REPAIRED_COUNT + 1))
  1051	                else
  1052	                  UNRESOLVED=$((UNRESOLVED + 1))
  1053	                fi
  1054	              else
  1055	                UNRESOLVED=$((UNRESOLVED + 1))   # FU-7: no backup, no overwrite
  1056	              fi
  1057	            fi
  1058	          else
  1059	            SKIPPED_CONFIRM=$((SKIPPED_CONFIRM + 1))
  1060	            UNRESOLVED=$((UNRESOLVED + 1))
  1061	            _log "    SKIPPED (needs --yes-file '$rel' or interactive confirm): $rel"
  1062	          fi
  1063	        else
  1064	          UNRESOLVED=$((UNRESOLVED + 1))
  1065	        fi
  1066	      else
  1067	        _log "    DRIFT (conflict: file AND framework both diverged from baseline — run upgrade.sh): $rel"
  1068	        BLOCKED_COUNT=$((BLOCKED_COUNT + 1))
  1069	        UNRESOLVED=$((UNRESOLVED + 1))
  1070	      fi
  1071	      ;;
  1072	  esac
  1073	done < "$SANITIZED"
