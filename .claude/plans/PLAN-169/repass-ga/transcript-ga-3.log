   212	# Presence of the FILE is not presence of the CONTRACT. Assert the three route
   213	# functions BY NAME, so an upstream rename fails HERE, loudly, instead of
   214	# silently taking the identity path at the first repair. _wbm_route_row_ok is
   215	# asserted even though doctor never calls it directly: it is what makes
   216	# _wbm_route_src fail-closed, and a reader missing it would answer rc=2 to
   217	# everything. (The S327 rail round paid this exact lesson on the manifest
   218	# oracle's own fragment harness.)
   219	# rail round-6 F2 added _wbm_route_table_gate to that set: the three readers
   220	# call it, so a library missing it would answer rc=2 to every lookup — the
   221	# right posture, reached the wrong way and with no name attached to it.
   222	# rail round-7 F2 added _wbm_source_confined for the same reason: _restore_file
   223	# COPIES from "$SOURCE_DIR/$src", and a library without that predicate would
   224	# copy through a symlinked source without anything saying so. rail round-8
   225	# widened that to the THREE sites that resolve a source — the write site and
   226	# both HASH sites — so this name is now load-bearing for CLASSIFICATION too,
   227	# not only for the copy.
   228	# PLAN-185-FOLLOWUP FU-7 (S337) added _wbm_dst_refuses: every write doctor
   229	# makes under the target (restore, backup, re-link) is now answered by the SAME
   230	# destination-confinement predicate install.sh and upgrade.sh consume, so a
   231	# library without it must fail here, by name, instead of letting doctor fall
   232	# back to the retired local copy.
   233	for _fms_req in _wbm_route_src _wbm_route_relpath_ok _wbm_route_row_ok \
   234	                _wbm_route_table_ok _wbm_route_table_gate _wbm_source_confined \
   235	                _wbm_dst_refuses; do
   236	  if ! command -v "$_fms_req" >/dev/null 2>&1; then
   237	    echo "ERROR: $SCRIPT_DIR/_framework_manifest_set.sh does not define $_fms_req —" >&2
   238	    echo "       the shared delivery-route reader is unavailable. Refusing to run" >&2
   239	    echo "       rather than resolve delivery routes by identity (defect D4)." >&2
   240	    exit 2
   241	  fi
   242	done
   243	unset _fms_req
