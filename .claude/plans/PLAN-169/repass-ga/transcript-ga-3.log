   767	# Restore one hash-record file from SOURCE_DIR. Preconditions already checked
   768	# by the caller: source exists AND H_src == H_base, and DRY_RUN handled by the
   769	# caller (a dry-run preview leaves the finding UNRESOLVED — the disk still
   770	# drifts, so the exit code must stay 1). $1=rel $2=base-digest.
   771	# Returns 0 on verified restore, 1 otherwise.
   772	_restore_file() {
   773	  _rf_rel="$1"
   774	  _rf_base="$2"
   775	  if ! _manifest_still_pinned; then
   776	    _manifest_pin_refused "$_rf_rel"
   777	    return 1
   778	  fi
   779	  # D4: repair from the route's SOURCE, never from the destination relpath.
   780	  _rf_rc=0
   781	  _rf_src="$( _wbm_route_src "$_rf_rel" )" || _rf_rc=$?
   782	  if [ "$_rf_rc" -eq 2 ]; then
   783	    _log "    RESTORE-BLOCKED (delivered through a transform, or its route row was rejected — the bytes exist in no checkout): $_rf_rel"
   784	    return 1
   785	  fi
   786	  if [ "$_rf_rc" -ne 0 ] || [ -z "${_rf_src:-}" ]; then
   787	    _rf_src="$_rf_rel"
   788	  fi
   789	  # Belt and braces (W6). Deliberately AHEAD of `mkdir -p`: mkdir -p of an
   790	  # escaping destination already creates directories outside the target, so a
   791	  # check placed after it would be too late to prevent the side effect.
   792	  if _restore_refuses "$_rf_rel" "$_rf_src"; then
   793	    return 1
   794	  fi
   795	  mkdir -p "$TARGET/$( dirname "$_rf_rel" )"
   796	  cp -p "$SOURCE_DIR/$_rf_src" "$TARGET/$_rf_rel"
   797	  # Post-copy verification: the restored content MUST re-hash to the recorded
   798	  # baseline, or the uninstall SHA-identical property would silently not hold
   799	  # (TOCTOU on the source between classify and copy).
   800	  _rf_after="$( _hash_file "$TARGET/$_rf_rel" 2>/dev/null || true )"
   801	  if [ "$_rf_after" = "$_rf_base" ]; then
   802	    _log "    RESTORED: $_rf_rel"
   803	    return 0
   804	  fi
   805	  _log "    RESTORE-FAILED (post-copy hash != baseline — source changed mid-run?): $_rf_rel"
   806	  return 1
   807	}
   808	
   809	# ---------------------------------------------------------------------------
   810	# Main verification loop
   811	# ---------------------------------------------------------------------------
   812	OK_COUNT=0
   813	DRIFT_COUNT=0
   814	MISSING_COUNT=0
   815	REPAIRED_COUNT=0
  1212	# ---------------------------------------------------------------------------
  1213	# Summary + exit code
