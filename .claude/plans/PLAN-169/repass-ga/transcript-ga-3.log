  2858	  # ONE identity rule, hoisted (rail round 8) so that any second jq program in
  2859	  # this function shares it and the boundary fix of round 7 cannot drift
  2860	  # between two copies of the regex.
  2861	  local jq_defs
  2862	  jq_defs='
  2863	# Every shape this walks is ACCEPTED only after being proved to be the shape
  2864	# we expect (object / array / string). Anything else yields NO key, which
  2865	# makes its block unidentifiable and therefore untouched — the PLAN-185
  2866	# doctrine: enumerate what is provably safe, never guess at the rest. jq
  2867	# raises on indexing a number or slicing an object, and an uncaught raise here
  2868	# would abort the WHOLE merge, turning one odd event into a silent no-op for
  2869	# all 47 registrations (measured: E.8 of the e2e caught exactly that).
