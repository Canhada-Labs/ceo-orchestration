  2606	          echo "          does NOT reflect the pinned source: expect VERSION to" >&2
  2607	          echo "          over-report until the next full install (ADR-155-AMEND-1)" >&2
  2608	        fi
  2609	      elif [ "$_lt" = "symlink" ]; then
  2610	        echo "    WARNING: .claude/.framework-version is a symlink that does NOT match the" >&2
  2611	        echo "             recorded LINK delivery — preserved WITHOUT framework ownership" >&2
  2612	        echo "             (readers fall back to VERSION)" >&2
  2613	      else
  2614	        echo "    SKIP: .claude/.framework-version is $_lt — adopter-owned, refusing to write into/through it"
  2615	      fi
  2616	      return 0
  2617	      ;;
  2618	
  2619	    DELIVER|REFRESH)
  2620	      if [ "$DRY_RUN" -eq 1 ]; then
  2621	        echo "    (dry-run) would REFRESH: .claude/.framework-version ($(tr -d '[:space:]' < "$src" 2>/dev/null || true))"
  2622	        return 0
  2623	      fi
  2624	      if [ "$_verdict" = "REFRESH" ] && [ "$_lc" = "edited" ]; then
  2625	        mkdir -p "$( dirname "$bak" )" 2>/dev/null || true
  2626	        if { cp "$dst" "$bak" 2>/dev/null || false; }; then
  2627	          echo "    BACKED UP: .claude/.framework-version -> $bak"
  2628	        else
  2629	          # INV-3: an execution failure never advances the record.
  2630	          echo "    WARNING: could not back up differing .claude/.framework-version —" >&2
  2631	          echo "             REFUSING to overwrite it (backup-before-replace)" >&2
