  2644	      # as delivered, so every marker-first reader falls back to VERSION rather
  2645	      # than trusting a value the upgrade could not verify.
  2646	      if cmp -s "$src" "$dst" 2>/dev/null; then
  2647	        _MARKER_DELIVERED=1
  2648	        _up_record_op "refresh_framework_marker" "$(tr -d '[:space:]' < "$src" 2>/dev/null || true)"
  2649	        echo "    REFRESHED: .claude/.framework-version ($(tr -d '[:space:]' < "$dst" 2>/dev/null || true))"
  2650	      else
  2651	        echo "    WARNING: .claude/.framework-version write did not validate — NOT recorded as" >&2
  2652	        echo "             delivered (marker-first readers fall back to VERSION; r20)" >&2
  2653	      fi
  2654	      return 0
  2655	      ;;
  2656	  esac
  2657	}
