   270	    if len(content) > max_input_chars:
   450	async def call_api(
   451	    client,
   452	    *,
   453	    model: str,
   454	    system_prompt: str,
   455	    user_prompt: str,
   456	    max_tokens: int,
   457	) -> str:
   458	    """Call the API once and return the text response.
   459	
   460	    Retries with exponential backoff on rate limits / transient errors.
   461	    Max 3 attempts. Raises on final failure.
   462	    """
   463	    from anthropic import RateLimitError, APIError  # type: ignore
   464	
   465	    delay = 1.0
   466	    last_error = None
   467	    for attempt in range(3):
   468	        try:
   469	            resp = await asyncio.to_thread(
   470	                client.messages.create,
   471	                model=model,
   472	                max_tokens=max_tokens,
   473	                temperature=0,
   474	                top_p=1,
   475	                system=system_prompt,
   476	                messages=[{"role": "user", "content": user_prompt}],
   477	            )
   478	            # Extract text content from the response
   479	            parts = []
   480	            for block in resp.content:
   481	                if hasattr(block, "text"):
   482	                    parts.append(block.text)
   483	                elif isinstance(block, dict) and "text" in block:
   484	                    parts.append(block["text"])
   485	            return "".join(parts)
   486	        except (RateLimitError, APIError) as e:
   487	            last_error = e
   488	            if attempt == 2:
   489	                break
   490	            try:
   491	                await asyncio.sleep(delay)
   492	            except asyncio.CancelledError:
   493	                raise
   494	            except Exception:  # pragma: no cover — sleep should not raise other types
   495	                pass
   496	            delay *= 2
   497	    raise RuntimeError(f"API call failed after 3 attempts: {last_error}")
