   370	# --- PLAN-167 W2.3: the DECISION reaches the generator ----------------------
   371	# _ownership_verdict chooses a hash_source per conditional surface; the writer
   372	# obeys it instead of falling back to a default. Across all 62 rows of the
   373	# table the default (HASH_TARGET) is never the correct answer, and it is
   374	# exactly what let three P1 defects re-baseline adopter content as
   375	# framework-owned (docs §3.4).
   376	_wbm_declared_hash_source() {
   377	  case "$1" in
   378	    SPEC/v1|SPEC/v1/*)          printf '%s' "${FMS_HASH_SOURCE_SPEC:-}" ;;
   379	    PROTOCOL.md)                printf '%s' "${FMS_HASH_SOURCE_PROTOCOL:-}" ;;
   380	    .claude/.framework-version) printf '%s' "${FMS_HASH_SOURCE_MARKER:-}" ;;

