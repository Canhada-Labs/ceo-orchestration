    43	    branches: [main]
    44	    paths:
    45	      - ".claude/skills/**/benchmarks/**"
    46	      - ".claude/scripts/run-skill-benchmark.py"
    47	      - ".github/workflows/benchmarks.yml"
    48	
    49	concurrency:
    50	  group: benchmarks-${{ github.ref }}
    51	  cancel-in-progress: true
    52	
    53	permissions:
    54	  contents: read
    55	  # Write permission needed for $GITHUB_STEP_SUMMARY
    56	  pull-requests: write
    57	
    58	jobs:
    59	  benchmarks:
    60	    name: Run skill benchmarks
    61	    runs-on: ubuntu-latest
    62	    timeout-minutes: 10
    63	
    64	    # Fork PR safety: benchmarks require ANTHROPIC_API_KEY which fork PRs
    65	    # don't have access to. Skip visibly on forks. pull_request_target is
    66	    # EXPLICITLY FORBIDDEN per PLAN-002 §8 finding #18 (code-injection
    67	    # vector in the forked repo's workflow).
    68	    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    69	
    70	    steps:
    71	      - name: Checkout
    72	        uses: actions/checkout@v4
    73	
    74	      - name: Set up Python
    75	        uses: actions/setup-python@v5
    76	        with:
    77	          python-version: "3.12"
    78	
    79	      - name: Install dependencies
    80	        run: |
    81	          set -euo pipefail
    82	          python3 -m pip install --upgrade pip
    83	          python3 -m pip install pyyaml anthropic
    84	
    85	      - name: Detect changed benchmarks
    86	        id: detect
    87	        run: |
    88	          set -euo pipefail
    89	          # Find all benchmark YAMLs under skills/
    90	          mapfile -t ALL_BENCHES < <(find .claude/skills -type f -path '*/benchmarks/*.yaml' 2>/dev/null)
    91	          if [ ${#ALL_BENCHES[@]} -eq 0 ]; then
    92	            echo "no_benchmarks=true" >> "$GITHUB_OUTPUT"
    93	            echo "No benchmark YAMLs found — nothing to run" >&2
    94	          else
    95	            printf 'found %d benchmark file(s):\n' "${#ALL_BENCHES[@]}"
    96	            printf '  %s\n' "${ALL_BENCHES[@]}"
    97	          fi
    98	
    99	      - name: Run benchmarks (advisory, skip-if-no-key)
   100	        id: bench
   101	        env:
   102	          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
   103	        run: |
   104	          set -euo pipefail
   105	          mkdir -p benchmark-results
   106	
   107	          if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
   108	            echo "SKIPPED: ANTHROPIC_API_KEY secret not set (advisory mode)." >&2
   109	            echo "skipped=true" >> "$GITHUB_OUTPUT"
   110	            exit 0
   111	          fi
   112	
   113	          FAILED=0
   114	          mapfile -t ALL_BENCHES < <(find .claude/skills -type f -path '*/benchmarks/*.yaml')
   115	          # Sprint 3 Item B: absolute floor at 0.6 + write lessons on failure.
   116	          # Per debate consensus R-DEV1, rc=1 for ALL floor failures (no new
   117	          # exit codes — we distinguish via $GITHUB_STEP_SUMMARY, not rc).
   118	          for bench in "${ALL_BENCHES[@]}"; do
   119	            base=$(basename "$bench" .yaml)
   120	            echo "::group::Running $bench"
   121	            out="benchmark-results/${base}.json"
   122	            md="benchmark-results/${base}.md"
   123	            # `$?` inside `if ! cmd` is the status of `!` (always 0), so the
   124	            # floor breach was reported as "runner error rc=0": capture the
   125	            # real status first, then branch on it.
   126	            rc=0
   127	            python3 .claude/scripts/run-skill-benchmark.py \
   128	                 "$bench" \
   129	                 --output-json "$out" \
   130	                 --markdown \
   131	                 --floor 0.6 \
   132	                 --write-lessons \
   133	                 --skip-if-no-key > "$md" || rc=$?
   134	            if [ "$rc" -ne 0 ]; then
   135	              if [ "$rc" -eq 1 ]; then
   136	                echo "::error::$bench below floor (CRITICAL or <0.6)"
   137	                FAILED=1
   138	              else
   139	                echo "::error::$bench: runner error rc=$rc"
   140	                FAILED=1
   141	              fi
   142	            fi
   143	            if [ -s "$md" ]; then cat "$md"; fi
   144	            echo "::endgroup::"
   145	          done
   146	
   147	          echo "failed=$FAILED" >> "$GITHUB_OUTPUT"
   148	
   149	      - name: Post results to $GITHUB_STEP_SUMMARY
   150	        if: always()
   151	        run: |
   152	          set -euo pipefail
   153	          if [ "${{ steps.bench.outputs.skipped }}" = "true" ]; then
   154	            {
   155	              printf '## Benchmarks skipped\n\n'
   156	              printf 'ANTHROPIC_API_KEY secret is not configured.\n'
   157	              printf 'Enable in Settings -> Secrets and variables -> Actions.\n'
   158	            } >> "$GITHUB_STEP_SUMMARY"
   159	            exit 0
   160	          fi
   161	          if [ ! -d benchmark-results ] || [ -z "$(ls -A benchmark-results 2>/dev/null)" ]; then
   162	            printf '## Benchmarks: no results produced\n' >> "$GITHUB_STEP_SUMMARY"
   163	            exit 0
   164	          fi
   165	          # PLAN-183 W2 / A3: the summary is built from the per-benchmark
   166	          # Markdown that .claude/scripts/run-skill-benchmark.py emits with
   167	          # --markdown (captured per bench in the step above). The framework's
   168	          # .github/scripts/ is NOT installed, so it must not be called here.
   169	          if ls benchmark-results/*.md >/dev/null 2>&1; then
   170	            cat benchmark-results/*.md >> "$GITHUB_STEP_SUMMARY"
   171	          else
   172	            printf '## Benchmarks: results produced but no Markdown captured\n' \
   173	              >> "$GITHUB_STEP_SUMMARY"
   174	          fi
   175	
   176	      - name: Upload benchmark JSON results
   177	        if: always()
   178	        uses: actions/upload-artifact@v4
   179	        with:
   180	          name: benchmark-results
   181	          path: benchmark-results/
   182	          if-no-files-found: ignore
   183	          retention-days: 30
   184	
   185	      - name: Fail on floor breach
   186	        if: steps.bench.outputs.failed == '1'
   187	        run: |
   188	          echo "::error::One or more benchmarks fell below floor (CRITICAL < 0.4 or absolute < 0.6)"
   189	          exit 1
     1	name: Validate CEO Orchestration governance
     2	
     3	# INERT AS SHIPPED. install.sh copies this file to
     4	# `.github/workflows/validate.yml.template` — the `.template` suffix means
     5	# GitHub Actions never reads it. Activation is an EXPLICIT adopter step
     6	# (plain `mv -n`: on a fresh install the file is UNTRACKED so `git mv`
     7	# fails — rail 183-r1 — and `-n` refuses to clobber a pre-existing
     8	# validate.yml of your own — rail 183-r3; pick another name if it exists,
     9	# and commit afterwards):
    10	#   mv -n .github/workflows/validate.yml.template \
    11	#         .github/workflows/validate.yml
    12	# (PLAN-183 wave-183batch; mirrors benchmarks.yml.template:3-12. The
    13	# frozen-subset contract — 11 steps + pins — is untouched: comments only.)
    14	
    15	on:
    16	  pull_request:
    17	  push:
    18	    branches: [main]
    19	
    20	# Cancel in-progress runs when a newer commit lands on the same ref.
    21	# Prevents duplicate compute on rapid-fire PR updates and matches the
    22	# devops-ci-cd skill's concurrency-control mandate.
    23	concurrency:
    24	  group: validate-${{ github.ref }}
    25	  cancel-in-progress: true
    26	
    27	# Least-privilege: this workflow only reads the repo to validate.
    28	permissions:
    29	  contents: read
    30	
    31	jobs:
    32	  validate:
    33	    name: Governance, health, contamination, shellcheck
    34	    runs-on: ubuntu-latest
    35	    # Kill-switch parity with the framework's own validate job: set the repo
    36	    # variable CEO_SOTA_DISABLE=1 to disable this job without editing CI.
    37	    if: vars.CEO_SOTA_DISABLE != '1'
    38	    timeout-minutes: 15
    39	
    40	    steps:
    41	      - name: Checkout
    42	        # SHA-pinned (a floating major tag is mutable). Bump via Dependabot.
    43	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2
    44	
    45	      # -----------------------------------------------------------------
    46	      # Step: Governance structure validation
    47	      # -----------------------------------------------------------------
    48	      - name: Run validate-governance.sh
    49	        run: |
    50	          set -euo pipefail
    51	          bash .claude/scripts/validate-governance.sh
    52	
    53	      # -----------------------------------------------------------------
    54	      # Step: Skill health check (CI mode tolerates stale framework refs)
    55	      # -----------------------------------------------------------------
    56	      - name: Run check-skill-health.sh --ci
    57	        run: |
    58	          set -euo pipefail
    59	          bash .claude/scripts/check-skill-health.sh --ci
    60	
    61	      # -----------------------------------------------------------------
    62	      # Step: Pitfall regression check
    63	      # -----------------------------------------------------------------
    64	      - name: Run check-pitfall-regression.sh
    65	        run: |
    66	          set -euo pipefail
    67	          if [ -x .claude/scripts/check-pitfall-regression.sh ]; then
    68	            bash .claude/scripts/check-pitfall-regression.sh || {
    69	              rc=$?
    70	              # Accept exit 0 only. Anything else is a real regression.
    71	              echo "check-pitfall-regression.sh exited with rc=$rc" >&2
    72	              exit $rc
    73	            }
    74	          else
    75	            echo "check-pitfall-regression.sh not executable; skipping"
    76	          fi
    77	
    78	      # -----------------------------------------------------------------
    79	      # Step: Contamination check (project-specific refs outside allowed zones)
    80	      #
    81	      # Uses `git ls-files` so that (a) .gitignore is honored, (b) .git/
    82	      # is not descended into, (c) path anchoring is stable across runners.
    83	      # NFKC-normalizes each file before grepping to catch Unicode homoglyph
    84	      # attempts.
    85	      # -----------------------------------------------------------------
    86	      - name: Contamination check (no private-project/personal refs outside allowlist)
    87	        run: bash .claude/scripts/check-contamination.sh
    88	
    89	      # -----------------------------------------------------------------
    90	      # Step: Placeholder lint — no unfilled {{PLACEHOLDERS}} beyond the
    91	      # known template set in core/frontend skills.
    92	      # -----------------------------------------------------------------
    93	      - name: Placeholder lint (core/frontend skills only)
    94	        run: |
    95	          set -euo pipefail
    96	          # Known template placeholders we ship with (expected in template text).
    97	          ALLOWED='PROJECT_NAME|PROJECT_PATH|OWNER_NAME|DOMAIN|PRODUCTION_URL|APP_NAME|BACKEND_URL|FRONTEND_REPO_PATH|FOUNDER_NAME|CITY|COUNTRY|LEGAL_ID|STACK|DEPLOY_TARGET|DEPLOY_COMMAND|DATABASE|RUNTIME_NOTES|FILE_COUNT|LINES|TEST_COUNT|TEST_TOOL|LINT_TOOL|CI_TOOL|ARCHITECTURE_DIAGRAM|NUMERIC_RULES|ARCHITECTURE_RULES|SECURITY_RULES|ENDPOINT_LIST|DB_TABLES|ENV_VAR_COUNT|FRONTEND_PATH'
    98	          FOUND=$(grep -rhoE '\{\{[A-Z_][A-Z0-9_]*\}\}' .claude/skills/core .claude/skills/frontend 2>/dev/null | sort -u || true)
    99	          UNKNOWN=$(printf '%s\n' "$FOUND" | grep -vE "^\{\{($ALLOWED)\}\}$" || true)
   100	          if [ -n "$UNKNOWN" ]; then
   101	            echo "❌ Unknown {{PLACEHOLDERS}} in core/frontend skills:"
   102	            printf '%s\n' "$UNKNOWN"
   103	            echo ""
   104	            echo "Either fill the placeholder, replace with archetype text, or add it"
   105	            echo "to the ALLOWED list in THIS workflow file (only if it is"
   106	            echo "genuinely a shared template variable)."
   107	            exit 1
   108	          fi
   109	          echo "✓ Only known placeholders present in core/frontend skills"
   110	
   111	      # -----------------------------------------------------------------
   112	      # Step: JSON/YAML syntax check for governance files
   113	      # -----------------------------------------------------------------
   114	      - name: Validate settings.json and YAML catalogs
   115	        run: |
   116	          set -euo pipefail
   117	          jq empty .claude/settings.json
   118	          echo "✓ .claude/settings.json is valid JSON"
   119	          # PyYAML is a THIRD-PARTY module and the framework RUNTIME is
   120	          # stdlib-only (CLAUDE.md §3) — but this is CI, dev-time. A syntax
   121	          # gate that silently skips when its parser is missing is a gate
   122	          # that fails OPEN (a broken catalog would ride a green job), so the
   123	          # parser is installed here when absent and its absence is a failure.
   124	          if ! python3 -c 'import yaml' 2>/dev/null; then
   125	            python3 -m pip install --quiet --no-cache-dir "PyYAML>=6.0,<7" >/dev/null 2>&1 \
   126	              || sudo apt-get install -y -qq python3-yaml >/dev/null 2>&1 || true
   127	          fi
   128	          python3 -c 'import yaml' 2>/dev/null \
   129	            || { echo "ERROR: no YAML parser available — the catalog syntax gate cannot run (refusing to pass it silently)" >&2; exit 1; }
   130	          for y in .claude/pitfalls-catalog.yaml .claude/task-chains.yaml; do
   131	            [ -f "$y" ] || continue
   132	            python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1])); print('✓ '+sys.argv[1]+' is valid YAML')" "$y"
   133	          done
   134	
   135	      # -----------------------------------------------------------------
   136	      # Step: Shellcheck on all active hooks and scripts
   137	      #
   138	      # .claude/hooks/legacy/ is excluded — those are Sprint 1 bash
   139	      # fallbacks kept for one sprint per PLAN-002 §11-bis Q5. They are
   140	      # NOT on the execution path (settings.json uses the Python shim).
   141	      # -----------------------------------------------------------------
   142	      - name: Shellcheck hooks and scripts (excluding legacy/)
   143	        run: |
   144	          set -euo pipefail
   145	          if ! command -v shellcheck >/dev/null 2>&1; then
   146	            sudo apt-get update -qq
   147	            sudo apt-get install -y -qq shellcheck
   148	          fi
   149	          FAILED=0
   150	          while IFS= read -r -d '' script; do
   151	            echo "--- $script ---"
   152	            shellcheck -S warning "$script" || FAILED=1
   153	          done < <(find .claude/scripts .claude/hooks \
   154	                        -path '*/legacy/*' -prune -o \
   155	                        -name '*.sh' -print0 2>/dev/null)
   156	          if [ $FAILED -eq 1 ]; then
   157	            echo "shellcheck reported warnings or errors" >&2
   158	            exit 1
   159	          fi
   160	          echo "✓ Shellcheck clean on all active hooks/scripts"
   161	
   162	      # -----------------------------------------------------------------
   163	      # NOTE (PLAN-183 W2/A2): the framework's own hook + script unit
   164	      # suites are deliberately ABSENT here. `.claude/hooks/tests/` and
   165	      # `.claude/scripts/tests/` are framework-internal: install.sh never
   166	      # copies them (install_scripts_selective / install_hooks_selective
   167	      # ship top-level files only) and _framework_path_excluded() in
   168	      # scripts/_framework_manifest_set.sh classifies both as never-shipped
   169	      # — upgrade.sh actively PURGES them as mis-installed. Running
   170	      # `unittest discover` against them here fails with
   171	      # `ImportError: Start directory is not importable`. Put YOUR OWN
   172	      # test command in this slot.
   173	      # -----------------------------------------------------------------
   174	
   175	      # -----------------------------------------------------------------
   176	      # Step: core/frontend → domains tier boundary check
   177	      # -----------------------------------------------------------------
   178	      - name: Check tier boundaries (core/frontend must not reference domains)
   179	        run: |
   180	          set -euo pipefail
   181	          python3 .claude/scripts/check-tier-boundaries.py
   182	
   183	      # -----------------------------------------------------------------
   184	      # Step: actionlint — static analysis for GitHub Actions workflows
   185	      # Downloads the binary directly (no docker pull, no marketplace dep).
   186	      # -----------------------------------------------------------------
   187	      - name: actionlint
   188	        run: |
   189	          set -euo pipefail
   190	          cd "$RUNNER_TEMP"
   191	          # Pinned release asset — never `main` (unpinned remote script = a
   192	          # supply-chain hole that grades YOUR workflows).
   193	          VERSION="1.7.7"
   194	          # Digest of the pinned release asset, verified BEFORE extraction. The
   195	          # URL pin alone still downloads and EXECUTES whatever the release
   196	          # host serves; the digest closes that hole (same check as the
   197	          # framework's own validate.yml).
   198	          EXPECTED_SHA256="023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757"
   199	          ASSET="actionlint_${VERSION}_linux_amd64.tar.gz"
   200	          curl -fsSLO "https://github.com/rhysd/actionlint/releases/download/v${VERSION}/${ASSET}"
   201	          echo "${EXPECTED_SHA256}  ${ASSET}" | sha256sum -c -
   202	          tar -xzf "$ASSET" actionlint
   203	          chmod +x actionlint
   204	          # nullglob so an adopter with no activated *.yml does not hand
   205	          # actionlint an unexpanded literal glob.
   206	          shopt -s nullglob
   207	          WF=( "$GITHUB_WORKSPACE/.github/workflows/"*.yml "$GITHUB_WORKSPACE/.github/workflows/"*.yaml )
   208	          if [ ${#WF[@]} -eq 0 ]; then
   209	            echo "NOTE: no activated workflow files (*.yml) — nothing to lint"
   210	          else
   211	            ./actionlint -color "${WF[@]}"
   212	          fi
   213	
   214	      # -----------------------------------------------------------------
   215	      # NOTE (PLAN-183 W2/A2): the skill-inventory idempotency gate is
   216	      # framework-only and CANNOT hold at an adopter site. install.sh ships
   217	      # ceo-orchestration/SKILL.md with the framework's FULL inventory
   218	      # baked in, while domain squads install SELECTIVELY — so
   219	      # generate-skill-inventory.sh and the committed block diverge by
   220	      # construction for any adopter that did not install all domains
   221	      # (measured: 82 generated lines vs 341 committed, diff rc=1).
   222	      # -----------------------------------------------------------------
   223	
   224	      # -----------------------------------------------------------------
   225	      # Step: Hook executable bits (.sh + active Python hooks)
   226	      # -----------------------------------------------------------------
   227	      - name: Hook and script executable bits
   228	        run: |
   229	          set -euo pipefail
   230	          MISSING=""
   231	          # All .sh files under scripts/ and hooks/ (includes legacy for
   232	          # completeness — fallback scripts should still be executable).
   233	          while IFS= read -r -d '' script; do
   234	            if [ ! -x "$script" ]; then
   235	              MISSING="$MISSING $script"
   236	            fi
   237	          done < <(find .claude/scripts .claude/hooks -name '*.sh' -print0 2>/dev/null)
   238	          # Active Python hooks (not _lib or tests — those are libraries)
   239	          for py in .claude/hooks/check_agent_spawn.py .claude/hooks/audit_log.py .claude/hooks/check_bash_safety.py .claude/hooks/check_plan_edit.py; do
   240	            if [ -f "$py" ] && [ ! -x "$py" ]; then
   241	              MISSING="$MISSING $py"
   242	            fi
   243	          done
   244	          if [ -n "$MISSING" ]; then
   245	            echo "❌ The following files are not executable:"
   246	            for m in $MISSING; do echo "  - $m"; done
   247	            echo ""
   248	            echo "Run: chmod +x <file>"
   249	            exit 1
   250	          fi
   251	          echo "✓ All active hooks/scripts are executable"

