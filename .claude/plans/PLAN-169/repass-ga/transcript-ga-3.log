   374	  case "$1" in
   375	    *[[:cntrl:]]*) return 0 ;;
   376	    *$'\xc2'[$'\x80'-$'\x9f']*) return 0 ;;
   377	    *[$'\x80'-$'\xff']*)
   378	      [ "$_ICONV_OK" -eq 1 ] || return 0
   379	      printf '%s' "$1" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || return 0
   380	      ;;
   381	  esac
   382	  return 1
   383	}
   384	_ICONV_OK=0
   385	command -v iconv >/dev/null 2>&1 && _ICONV_OK=1
   386	_relpath_unsafe() {
   387	  _ru_rel="$1"
   388	  _ru_kind="${2:-file}"
   389	  case "$_ru_rel" in
   390	    ''|/*) return 0 ;;
   391	    *..*)  return 0 ;;
   392	  esac
   393	  if _field_has_control_bytes "$_ru_rel"; then return 0; fi
   394	  _ru_parent="$( dirname "$_ru_rel" )"
   395	  _ru_cur="$TARGET"
   396	  _ru_oldIFS="$IFS"
   397	  IFS='/'
   398	  # shellcheck disable=SC2086  # intentional word-split on the relpath components
   399	  for _ru_comp in $_ru_parent; do
   400	    [ -n "$_ru_comp" ] || continue
   401	    [ "$_ru_comp" = "." ] && continue
   402	    _ru_cur="$_ru_cur/$_ru_comp"
   403	    if [ -L "$_ru_cur" ]; then
   404	      IFS="$_ru_oldIFS"
   405	      return 0
   406	    fi
   407	  done
   408	  IFS="$_ru_oldIFS"
   409	  # Codex pair-rail P2 (S261): a symlinked LEAF is NOT a traversal risk and
   410	  # must NOT be filtered out here — dropping the record makes doctor exit
   411	  # clean while a managed regular-file path has been swapped for a symlink.
   412	  # It is a type-change: the diagnosis loop reports it as
   413	  # `DRIFT (type-change: regular file recorded, non-file found)` and repair
   414	  # refuses to follow it (leaf `-L` guard at the repair site). Only
   415	  # symlinked PARENT components (the loop above) are a genuine traversal
   416	  # hazard and stay filtered.
   417	  return 1
   418	}
   419	
   420	_seen_before() {
   421	  case "$_DUP_GUARD" in
   422	    *"
   423	$1
   424	"*) return 0 ;;
   425	  esac
   426	  return 1
   427	}
   428	
   429	_mark_seen()    { _DUP_GUARD="${_DUP_GUARD}${1}
   430	"; }
   431	_mark_invalid() {
   432	  case "$_INVALID" in
   433	    *"
   434	$1
   435	"*) : ;;
   436	    *) _INVALID="${_INVALID}${1}
   437	" ;;
   438	  esac
   439	}
