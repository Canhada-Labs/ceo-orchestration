   240	def estimate_cost_usd(
   241	    bench: Dict[str, Any],
   242	    *,
   243	    max_tokens: int,
   244	    repetitions: int,
   245	    approx_input_tokens_per_scenario: int = 4000,
   246	) -> float:
   247	    """Return a dollar estimate for one full run of the benchmark."""
   248	    n_scenarios = len(bench.get("scenarios", []))
   249	    input_mtok = (n_scenarios * repetitions * approx_input_tokens_per_scenario) / 1_000_000
   250	    output_mtok = (n_scenarios * repetitions * max_tokens) / 1_000_000
   251	    return round(
   252	        input_mtok * HAIKU_INPUT_PER_MTOK + output_mtok * HAIKU_OUTPUT_PER_MTOK,
   253	        4,
   254	    )
