   691	  case "$_wbm_nl_out" in
   692	    ''|*[!0-9]*) printf '' ;;
   693	    *)           printf '%s\n' "$_wbm_nl_out" ;;
   694	  esac
   695	}
   696	
   697	# Is this destination one the installer may write? The mirror of
   698	# _wbm_source_confined, on the side that WRITES.
   699	#
   700	# WHY THIS EXISTS: install.sh decides whether to write by testing the
   701	# destination for EXISTENCE, and `-e` FOLLOWS symlinks. A DANGLING link planted
   702	# at a destination answers false, so the writer takes the "nothing there yet"
   703	# branch and `cp`/`>` write THROUGH the link, outside $TARGET. MEASURED
   704	# pre-cure (S329) against the live installer: with `docs/rotation-log.md` a
   705	# dangling symlink to a path outside the target, a `--ceremony maintainer`
   706	# install exited 0, logged `COPIED:`, and 536 bytes landed at the external
   707	# path. A RESOLVED link and a symlinked ANCESTOR escape the same way; a HARD
   708	# LINK escapes while every path check passes, because a second name for one
   709	# inode is not a link any path walk can see.
   710	#
   711	# Three walls, all required:
   712	#   1. LEXICAL — the relpath must be confined, through the same
   713	#      _wbm_route_relpath_ok every other confined path in this library uses
   714	#      (absolute, `..`, empty segment, glob metacharacter, whitespace).
   715	#   2. NO SYMLINK COMPONENT — every component under the physical target root is
   716	#      tested with `-L`, leaf INCLUDED. `-L` is true for a DANGLING link, which
   717	#      is precisely the form the `-e` guard is blind to.
   718	#   3. PHYSICAL CONTAINMENT — the deepest EXISTING ancestor must resolve
   719	#      (cd -P/pwd -P; the bash 3.2 floor has no realpath) under the physically
   720	#      resolved root.
   721	# Plus two properties of the LEAF that walls 1-3 cannot express: an existing
   722	# leaf must be a REGULAR FILE or a DIRECTORY, and it must not carry a second
   723	# hard link. Refusing every OTHER file type is the PLAN-185 W0 inversion
   724	# applied here — enumerate the forms proven safe to write, refuse the rest —
   725	# so a fifo or a device node at a destination is a named refusal rather than a
   726	# form nobody modelled.
   727	#
   728	# POLICY IS NOT HERE (debate C5). This answers "must this destination be
   729	# refused?" and publishes the reason; whether that means FAIL, SKIP or
   730	# ACCUMULATE belongs to the caller — install_one keeps the EXISTS-skip its
   731	# tests fix, while the delivery writers accumulate a named refusal and fail the
   732	# run at the end.
   733	#
   734	# TOCTOU, declared: between this answer and the write, nothing prevents the
   735	# destination from BECOMING a symlink. bash offers no openat/O_NOFOLLOW, so the
   736	# window is irreducible — this narrows it, it does not close it.
   737	#
   738	# $1 = target root (absolute). $2 = destination relpath.
   739	# rc 0 = REFUSE the write, reason in _WBM_DST_REFUSE_WHY. rc 1 = confined.
   740	# The polarity is the one _install_src_refuses and _up_tpl_multilink_refuses
   741	# already use: the function is named for what a 0 MEANS.
   742	_WBM_DST_REFUSE_WHY=""
   743	# Structural check shared by the destination guard and the upgrader's early
   744	# delivery preflight. Callers validate the relative path first. Inspect only
   745	# STRICT ancestors: an absent directory can be created, but a regular file,
   746	# FIFO or other non-directory cannot be traversed by mkdir — and neither can
   747	# a symlink that does not RESOLVE to a directory (dangling, or pointing at a
   748	# file): `-e`/`-d` follow the link, so those two shapes are refused here too.
   749	# A symlink that resolves to a directory is NOT this helper's call — that
   750	# policy stays with each caller's existing confinement guard (the full
   751	# destination predicate refuses every symlink component; the forced SPEC/v1
   752	# route accepts a `--mode link` leaf). Pre-cure the `! -L` test skipped every
   753	# symlink, so `SPEC -> file` passed both preflights and the run aborted at
   754	# `mkdir` with the target already written (Codex review of the cure).
   755	_wbm_dst_non_directory_ancestor_refuses() {
   756	  local rel="$2" rest="$2" walk="$1" seg
   757	  _WBM_DST_REFUSE_WHY=""
   758	  while :; do
   759	    case "$rest" in
   760	      */*) seg="${rest%%/*}"; rest="${rest#*/}" ;;
   761	      *) break ;;
   762	    esac
   763	    walk="$walk/$seg"
   764	    if [ -L "$walk" ] && [ ! -e "$walk" ]; then
   765	      _WBM_DST_REFUSE_WHY="'$walk' is a DANGLING symlink — a non-directory ancestor of '$rel'; the destination cannot be created"
   766	      return 0
   767	    fi
   768	    if [ -e "$walk" ] && [ ! -d "$walk" ]; then
   769	      _WBM_DST_REFUSE_WHY="'$walk' is a non-directory ancestor of '$rel' — the destination cannot be created"
   770	      return 0
   771	    fi
   772	  done
   773	  return 1
   774	}
   775	
   776	_wbm_dst_refuses() {
   777	  _WBM_DST_REFUSE_WHY=""
   778	  _wbm_dr_root="${1:-}"
   779	  _wbm_dr_rel="${2:-}"
   780	  if [ -z "$_wbm_dr_root" ] || [ -z "$_wbm_dr_rel" ]; then
   781	    _WBM_DST_REFUSE_WHY="empty target root or destination relpath"
   782	    return 0
   783	  fi
   784	  if ! _wbm_route_relpath_ok "$_wbm_dr_rel"; then
   785	    _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' is not a confined relative path"
   786	    return 0
   787	  fi
   788	  # An ABSENT target root is not a refusal (rail round-1 P2). Nothing exists
   789	  # under a directory that does not exist, so there is no component to follow
   790	  # and nothing to escape through — the lexical wall above has already done the
   791	  # only work available. Refusing here instead broke `install.sh --dry-run`
   792	  # against a target that does not exist yet, which is SUPPORTED behaviour
   793	  # (preview without creating): measured pre-cure, 12 destinations came back
   794	  # "does not resolve" and the run exited 1.
   795	  #
   796	  # The ROOT is tested for being a symlink BEFORE it is resolved (rail round-2
   797	  # P1). The previous order asked `! -e` first, so only a DANGLING root was ever
   798	  # tested with `-L`: a RESOLVED symlink root answered `-e` true, fell through to
   799	  # `cd -P`, and silently moved the confinement BASE to the referent. MEASURED:
   800	  # with the target passed as a symlink to a real directory, the install ran to
   801	  # completion, 567 files landed under the referent and zero landed anywhere
   802	  # else — so containment held, but the comment here claimed a refusal that the
   803	  # code did not perform, and `install.sh` resolves the target with plain
   804	  # `cd`/`pwd` (LOGICAL path, symlink preserved), so the case is reachable on
   805	  # every real install.
   806	  #
   807	  # It is a REFUSAL, not a warning, and the reason carries the recovery: the
   808	  # operator re-runs against the referent. That keeps the gate fail-closed while
   809	  # costing a legitimate symlinked project directory exactly one re-run with the
   810	  # path the message prints — and it makes the dereference an explicit choice
   811	  # instead of something the installer did on the operator's behalf without
   812	  # saying so. Note `-L` tests only the LAST component, so an ordinary path that
   813	  # merely traverses a symlinked ancestor (/tmp -> /private/tmp on macOS) is
   814	  # unaffected.
   815	  if [ -L "$_wbm_dr_root" ]; then
   816	    _wbm_dr_ref="$( cd -P "$_wbm_dr_root" 2>/dev/null && pwd -P || true )"
   817	    if [ -n "$_wbm_dr_ref" ]; then
   818	      _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' is a SYMLINK to '$_wbm_dr_ref' — every write would follow it; re-run against '$_wbm_dr_ref' if that is the directory you meant"
   819	    else
   820	      _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' is a DANGLING symlink — every write under it would follow the link outside the target"
   821	    fi
   822	    return 0
   823	  fi
   824	  if [ ! -e "$_wbm_dr_root" ]; then
   825	    return 1
   826	  fi
