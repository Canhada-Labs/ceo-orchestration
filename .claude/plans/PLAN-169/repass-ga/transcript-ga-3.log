   294	# _write_baseline_manifest — THE single baseline-manifest generator (ADR-155
   295	# decision (iv)). Called by install.sh write_install_manifest AND by upgrade.sh
   296	# after a successful upgrade, so a long-lived adopter who upgrades but never
   297	# re-runs install.sh acquires/refreshes a manifest.
   298	#
   299	# Inputs (callers export these before calling):
   300	#   FMS_ROOT          — the installed target root (paths are relative to it)
   301	#   FMS_PROFILE_PARTS — space-separated profile list (profile-aware enumeration)
   302	#   FMS_MODE          — "link" to emit LINK records for symlinks, else "copy"
   303	# Requires _hash_file (from _hash_lib.sh) on PATH. Writes validated records to
   304	# $1 (the manifest path) atomically. Fail-open: returns 0 with a stderr NOTE on
   305	# any problem; never aborts the caller.
   306	#
   307	# Grammar:
   308	#   <64hex>  <relpath>          — content hash
   309	#   LINK  <relpath>  <target>   — link-mode symlink (content == source)
   310	
   311	# Does FMS_HASH_ROOT apply to this relpath? UNSET FMS_HASH_ROOT_PATHS means
   312	# ALL of them — the upgrade posture, where every enumerated file must record
   313	# what the framework SHIPS. install.sh needs the opposite default for most of
   314	# the tree: it RENDERS templates (`.claude/team.md`, skills, `{{X}}`
   315	# placeholders under --project et al), so those legitimately differ from
   316	# source and their baseline must be the rendered TARGET. A global
   317	# FMS_HASH_ROOT on an install rerun rewrote every rendered file's hash to the
   318	# unrendered source, which doctor.sh reads as widespread adopter drift and
   319	# later upgrades read as customized => the files stop being refreshed (codex
   320	# W1 round 8, P1). Scoping the override to the ownership-continuity paths
   321	# keeps the round-5 fix (an EDITED delivered SPEC must not be re-baselined as
   322	# framework-owned, or uninstall would delete the adopter's fork) without
   323	# touching the rendered tree. Prefix match: an entry covers the path itself
   324	# and everything under it.
   325	_wbm_hash_root_applies() {
   326	  [ -n "${FMS_HASH_ROOT_PATHS:-}" ] || return 0
   327	  _hra_rel="$1"
   328	  _hra_oldIFS="$IFS"
   329	  IFS='
   330	'
   331	  for _hra_p in $FMS_HASH_ROOT_PATHS; do
   332	    [ -n "$_hra_p" ] || continue
   333	    case "$_hra_rel" in
   334	      "$_hra_p"|"$_hra_p"/*)
   335	        IFS="$_hra_oldIFS"
   336	        return 0
   337	        ;;
   338	    esac
   339	  done
   340	  IFS="$_hra_oldIFS"
   341	  return 1
   342	}
   343	
   344	# May this relpath be serialized as a LINK record? UNSET FMS_LINK_PATHS means
   345	# ANY live symlink may — correct on the INSTALL path, where the installer
   346	# itself created every symlink it is about to record. On the UPGRADE rewrite
   347	# that default is too wide (codex W1 round 10, P2): FMS_MODE=link is inferred
   348	# from the presence of ANY prior LINK record, and every live symlink then
   349	# serializes as a delivery record — including an adopter's OWN symlink
   350	# preserved inside an enumerated directory like `.claude/hooks/`, converting
   351	# an unowned path into framework-managed content that doctor.sh polices.
   352	# upgrade.sh passes the exact set of pre-upgrade LINK relpaths instead.
   353	_wbm_link_allowed() {
   354	  [ -n "${FMS_LINK_PATHS:-}" ] || return 0
   355	  _wla_rel="$1"
   356	  _wla_oldIFS="$IFS"
   357	  IFS='
   358	'
   359	  for _wla_p in $FMS_LINK_PATHS; do
   360	    [ -n "$_wla_p" ] || continue
   361	    if [ "$_wla_rel" = "$_wla_p" ]; then
   362	      IFS="$_wla_oldIFS"
   363	      return 0
   364	    fi
   365	  done
   366	  IFS="$_wla_oldIFS"
   367	  return 1
   368	}
