   302	    aside="$TARGET/.claude.pre-restore-$(date -u +%Y%m%d-%H%M%SZ)"
   303	    _log "    Moving current .claude/ aside to: $aside"
   304	    mv "$TARGET/.claude" "$aside"
   305	  fi
