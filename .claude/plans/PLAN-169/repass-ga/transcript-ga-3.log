   132	# Collect commits to check for one pushed ref range.
   133	# Args: <local_sha> <remote_sha>
   134	_commits_in_range() {
   135	  local local_sha="$1" remote_sha="$2"
   136	  if [ "$local_sha" = "$_zero" ]; then
   137	    return 0  # branch deletion — nothing to push
   138	  fi
   139	  if [ "$remote_sha" = "$_zero" ]; then
   140	    # New branch: commits reachable from local_sha that are NOT already on any
   141	    # remote-tracking ref. `--not --all` was wrong and dangerous (pair-rail R4,
   142	    # S272; cured in the Grok twin first): `--all` includes LOCAL refs — among
   143	    # them refs/heads/<the branch being pushed>, which points at $local_sha
   144	    # itself — so the range subtracted itself and a first push of a branch
   145	    # carrying canonical edits sailed through with an EMPTY set. `--remotes`
   146	    # subtracts only what the remote already has.
   147	    git rev-list "$local_sha" --not --remotes 2>/dev/null || true
   148	  else
   149	    git rev-list "${remote_sha}..${local_sha}" 2>/dev/null || true
   150	  fi
   151	}
   152	
   153	# Canonical paths changed by one commit.
   154	_canonical_paths_in_commit() {
   155	  local sha="$1" p
   156	  # --root: without it, diff-tree emits NOTHING for a ROOT commit (there is no
   157	  # parent to diff against), so a first push whose root commit ADDS canonical
   158	  # files classified an empty set and passed the gate. The Grok twin has
   159	  # carried this flag since pair-rail R5 (S272); this copy did not, and the
   160	  # two gates disagreed about the one commit that has no parent.
   161	  git diff-tree --root --no-commit-id --name-only -r "$sha" 2>/dev/null | while IFS= read -r p; do
   162	    [ -n "$p" ] || continue
   163	    if _is_canonical_path "$p"; then
   164	      printf '%s\n' "$p"
   165	    fi
   166	  done
   167	}
   168	
   169	# Does this commit carry an APPROVE pair-rail trailer? (acceptance path a)
   170	_commit_has_approve_trailer() {
   171	  local sha="$1"
   172	  git log -1 --format='%B' "$sha" 2>/dev/null \
   173	    | grep -Eiq '^Pair-Rail-Reviewed:[[:space:]]*APPROVE' && return 0
   174	  return 1
   175	}
   176	
   177	# Does the sidecar review-log carry an APPROVE record matching this
   178	# fingerprint? (acceptance path b)
   179	_sidecar_has_approve() {
   180	  local fp="$1" log
   181	  log="$(_review_log)"
   182	  [ -n "$log" ] && [ -f "$log" ] || return 1
   183	  # Match a JSON object line that is APPROVE AND carries this fingerprint.
   184	  grep -F "\"fingerprint\": \"${fp}\"" "$log" 2>/dev/null \
   185	    | grep -Eq '"verdict": ?"APPROVE"' && return 0
   186	  # Tolerate compact JSON (no spaces).
   187	  grep -F "\"fingerprint\":\"${fp}\"" "$log" 2>/dev/null \
   188	    | grep -Eq '"verdict":"APPROVE"' && return 0
   189	  return 1
   190	}
   191	
   192	_fail_count=0
   193	_all_canonical_paths_file="$(mktemp)"
   194	trap 'rm -f "$_all_canonical_paths_file"' EXIT
   195	
   196	while read -r _local_ref _local_sha _remote_ref _remote_sha; do
   197	  [ -n "${_local_sha:-}" ] || continue
   198	  for _c in $(_commits_in_range "$_local_sha" "$_remote_sha"); do
   199	    _cpaths="$(_canonical_paths_in_commit "$_c")"
   200	    [ -n "$_cpaths" ] || continue
   201	    printf '%s\n' "$_cpaths" >> "$_all_canonical_paths_file"
   202	
   203	    # Acceptance path (a): commit-local APPROVE trailer.
   204	    if _commit_has_approve_trailer "$_c"; then
   205	      continue
   206	    fi
   207	    # Acceptance path (b): sidecar APPROVE record matching this commit's
   208	    # canonical path-set fingerprint.
   209	    _fp="$(printf '%s' "$(printf '%s\n' "$_cpaths" | sort -u)" | _sha256)"
   210	    if _sidecar_has_approve "$_fp"; then
   211	      continue
   212	    fi
   213	
   214	    _fail_count=$((_fail_count + 1))
   215	    {
   216	      echo "PRE-PUSH REVIEW GATE (inverted pair-rail) -- RED"
   217	      echo "  commit ${_c} touches L3/canonical paths with NO cross-model review record:"
   218	      printf '%s\n' "$_cpaths" | sed 's/^/    - /'
   219	      echo "  path-set fingerprint: ${_fp}"
   220	    } >&2
   221	  done
   222	done
   223	
   224	# RED-on-absence sweep: canonical paths pushed but the sidecar is empty/absent
   225	# AND no trailers cleared them (already counted above). If we saw canonical
   226	# paths at all and every one failed, that is the abandoned-Stop-gate case.
   227	if [ -s "$_all_canonical_paths_file" ] && [ "$_fail_count" -gt 0 ]; then
   228	  {
   229	    echo ""
   230	    echo "To clear this gate, EITHER:"
   231	    echo "  (a) add a 'Pair-Rail-Reviewed: APPROVE' trailer to the commit(s)"
   232	    echo "      AFTER a real claude -p cross-model review, OR"
   233	    echo "  (b) run the review at Stop time so check_codex_stop_review.py"
   234	    echo "      --record writes an APPROVE record for the path set."
   235	    echo ""
   236	    echo "Residual: 'git push --no-verify' bypasses this client-side hook;"
   237	    echo "CODEOWNERS + branch protection + the validate.yml review rider are"
   238	    echo "the server-side backstops. This gate is a BACKSTOP, not the sole line."
   239	  } >&2
   240	  if [ "$ADVISORY" = "1" ]; then
   241	    echo "pre-push-review-gate: ADVISORY mode -- ${_fail_count} unreviewed canonical commit(s); NOT blocking." >&2
   242	    exit 0
   243	  fi
   244	  exit 1
   245	fi
   246	
   247	exit 0
     1	#!/usr/bin/env bash
     2	# pre-push-review-gate.sh -- inverted pair-rail push backstop (PLAN-156 Wave 5, grok).
     3	#
     4	# THIRD install surface: the installer copies this to
     5	# `.git/hooks/pre-push-grok-review` on a `--harness grok` target (the
     6	# operator wires it as pre-push). Grok's Stop event is NON-blocking, so
     7	# unlike codex this push gate is not merely the abandoned-Stop backstop —
     8	# it is the PRIMARY enforcement point for cross-model review under grok. No manifest walk
     9	# reaches `.git/` naturally, so Wave 5's lifecycle-symmetry criteria must
    10	# list it explicitly (manifest + uninstall + backup + restore).
    11	#
    12	# ## What it enforces
    13	#
    14	# The teeth for the PARTIAL inverted pair-rail when the Stop gate was
    15	# abandoned (session killed / refused twice). Push is BLOCKED when commits
    16	# being pushed touch L3/canonical paths without a recorded cross-model
    17	# review. A review record is EITHER:
    18	#
    19	#   (a) a `Pair-Rail-Reviewed: APPROVE` trailer in each canonical-touching
    20	#       commit message (git-native; survives a fresh clone -- the ONLY path
    21	#       that works in CI / on another machine), OR
    22	#   (b) an APPROVE record in the local review-log sidecar written by
    23	#       `check_codex_stop_review.py (or its grok equivalent) --record`, matched by the path-set
    24	#       fingerprint (machine-local; absent on a fresh clone -- see residual).
    25	#
    26	# ## Fingerprint parity (PLAN-156-FOLLOWUP F5, debate C2 — unanimous)
    27	#
    28	# The recorder fingerprints the AGGREGATE canonical path set classified by
    29	# `check_canonical_edit._is_canonical` (the fine, single-source-of-truth
    30	# predicate). This gate previously hashed COARSE first-segment paths
    31	# PER-COMMIT — two break axes (classifier + granularity) that made sidecar
    32	# path (b) structurally unmatched. Now:
    33	#
    34	#   - Classification shells out to the single ORACLE:
    35	#     `python3 check_canonical_edit.py --is-canonical -` (path\t0|1 lines).
    36	#     Re-implementing the guard glob list in bash IS the drift class F5
    37	#     fixes; the bash list below survives ONLY as the oracle-failure
    38	#     fallback.
    39	#   - Granularity: the WHOLE pushed range's changed paths are aggregated
    40	#     ONCE (`git diff --name-only <remote>..<local>`, per-commit union on
    41	#     new-branch pushes) into ONE fingerprint — matching the recorder's
    42	#     aggregate working-tree set.
    43	#   - Hash construction unchanged: sha256 over the LC_ALL=C sorted-unique,
    44	#     newline-joined path set, no trailing newline (byte-identical to
    45	#     `check_codex_stop_review.fingerprint`).
    46	#   - Acceptance: sidecar APPROVE matching the aggregate fingerprint
    47	#     clears the WHOLE range; otherwise EVERY canonical-touching commit
    48	#     must carry an (a) trailer.
    49	#
    50	# ## RED-on-absence (debate A2)
    51	#
    52	# Canonical paths pushed AND neither full (a) trailer coverage nor a (b)
    53	# matching APPROVE record => RED (exit 1, push blocked). Silence is NOT
    54	# health: an empty/absent review-log with canonical commits to push is
    55	# RED, not green.
    56	#
    57	# ## Residuals (named, per house vocabulary)
    58	#
    59	# - `git push --no-verify` bypasses every client-side hook. Backstops:
    60	#   CODEOWNERS + branch protection + the CI review-record rider
    61	#   (validate.yml) which re-checks the (a) trailer path server-side.
    62	# - The (b) sidecar is machine-local; on a fresh clone only the (a) trailer
    63	#   survives. CI therefore checks (a) only.
    64	# - Coarse first-segment path classifier (mirror of
    65	#   check_canonical_edit._CANONICAL_PREFIXES) is retained ONLY as the
    66	#   oracle-failure fallback: it OVER-triggers review (fail-CLOSED — a
    67	#   missed L3 touch is the danger, an extra review is not) and its
    68	#   fingerprint will generally NOT match a recorder-written record, so
    69	#   oracle failure degrades to trailer-only acceptance, never to a bypass.
    70	#
    71	# ## Controls
    72	#
    73	# - `CEO_GROK_PUSH_GATE=0`  -> disabled (no-op, exit 0).
    74	# - `CEO_GROK_PUSH_GATE_ADVISORY=1` -> warn but do not block (exit 0).
    75	# - `CEO_GROK_REVIEW_STATE_DIR` / `CEO_AUDIT_LOG_DIR` -> sidecar location
    76	#   (matches check_codex_stop_review.py (or its grok equivalent) resolution).
    77	# - `CEO_CANONICAL_ORACLE` -> path to check_canonical_edit.py (default:
    78	#   `<repo-top>/.claude/hooks/check_canonical_edit.py`). Not a disarm
    79	#   surface beyond what CEO_GROK_PUSH_GATE=0 already grants: pointing it
    80	#   at garbage only triggers the fail-CLOSED coarse fallback.
    81	#
    82	# stdin (git pre-push protocol): `<local ref> <local sha> <remote ref> <remote sha>`
    83	# argv: `<remote name> <remote url>` (unused here).
    84	#
    85	# Stdlib tools only (git, python3 for the oracle with a no-python fallback,
    86	# sha256sum/shasum, sort, grep, awk). shellcheck -S warning clean.
    87	
    88	set -euo pipefail
    89	
    90	if [ "${CEO_GROK_PUSH_GATE:-1}" = "0" ]; then
    91	  exit 0
    92	fi
    93	
    94	ADVISORY="${CEO_GROK_PUSH_GATE_ADVISORY:-0}"
    95	
    96	_zero="0000000000000000000000000000000000000000"
    97	
    98	_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    99	_oracle="${CEO_CANONICAL_ORACLE:-${_repo_top}/.claude/hooks/check_canonical_edit.py}"
   100	# Set to 1 by _classify_canonical when the fine oracle could not be used.
   101	_ORACLE_DEGRADED=0
   102	
   103	# COARSE first-segment prefixes. FALLBACK ONLY (F5/C2(d)): used when the
   104	# oracle shell-out fails. It must OVER-trigger (e.g. every
   105	# `.claude/plans/*.md`) = fail-CLOSED: with sidecar acceptance disabled while
   106	# degraded, a failed oracle can only DEMAND MORE review (trailers), never wave
   107	# a real L3 touch through.
   108	#
   109	# SUPERSET INVARIANT (pair-rail R2, S272 — the reason this list is not the
   110	# original 4 prefixes): "over-triggers = fail-CLOSED" is only true if this set
   111	# CONTAINS the fine oracle's first segments. The original list omitted
   112	# `templates/`, `.grok/`, `.codex/`, `AGENTS.md` and `requirements.toml` —
   113	# precisely the distribution, egress and kill-switch surfaces the fine
   114	# predicate guards (settings.base.json lives under templates/). A degraded push
   115	# touching ONLY those produced an EMPTY canonical set, and an empty set exits 0:
   116	# an UNDER-trigger — the fail-OPEN direction — on the surfaces that matter most.
   117	#
   118	# Keep this a SUPERSET of the oracle's first segments. Adding a new top-level
   119	# guarded surface to `_CANONICAL_GUARDS` means adding its first segment here.
   120	_is_canonical_path() {
   121	  # $1 = repo-relative path
   122	  case "$1" in
   123	    .claude/*|.github/*|scripts/*|SPEC/*|templates/*|.grok/*|.codex/*) return 0 ;;
   124	    PROTOCOL.md|AGENTS.md|requirements.toml) return 0 ;;
   125	    *) return 1 ;;
   126	  esac
   127	}
   128	
   129	_sha256() {
   130	  # Read stdin, emit hex digest (portable: sha256sum or shasum -a 256).
   131	  if command -v sha256sum >/dev/null 2>&1; then
   132	    sha256sum | awk '{print $1}'
   133	  else
   134	    shasum -a 256 | awk '{print $1}'
   135	  fi
   136	}
   137	
   138	_state_dir() {
   139	  if [ -n "${CEO_GROK_REVIEW_STATE_DIR:-}" ]; then
   140	    printf '%s' "${CEO_GROK_REVIEW_STATE_DIR}"
   141	  elif [ -n "${CEO_AUDIT_LOG_DIR:-}" ]; then
   142	    printf '%s' "${CEO_AUDIT_LOG_DIR}"
   143	  else
   144	    # PLAN-182 OQ-6 (S326): the per-project runtime state dir comes from the
   145	    # framework single resolver -- never rebuilt here. Rebuilding the literal
   146	    # made every adopter under one $HOME share ONE review log, so an APPROVE
   147	    # recorded in one repository satisfied this gate in ANOTHER. Resolver
   148	    # missing (partial upgrade) or python3 absent => EMPTY: the sidecar
   149	    # acceptance path (b) is simply unavailable and only per-commit APPROVE
   150	    # trailers (path a) can clear the push -- the same degradation an oracle
   151	    # failure already takes. Never a literal fallback.
   152	    _rp="${_repo_top}/.claude/hooks/_lib/runtime_paths.py"
   153	    if [ -f "$_rp" ] && command -v python3 >/dev/null 2>&1; then
   154	      _base="$(CLAUDE_PROJECT_DIR="$_repo_top" python3 "$_rp" --state-dir 2>/dev/null || true)"
   155	      if [ -n "$_base" ]; then
   156	        printf '%s/state' "$_base"
   157	      else
   158	        echo "pre-push-review-gate: single resolver failed; sidecar APPROVE path unavailable (trailers still clear the push)" >&2
   159	      fi
   160	    else
   161	      echo "pre-push-review-gate: single resolver not found at $_rp; sidecar APPROVE path unavailable (run scripts/upgrade.sh)" >&2
   162	    fi
   163	  fi
   164	}
   165	
   166	_review_log() {
   167	  local sd
   168	  sd="$(_state_dir)"
   169	  # Empty state dir (resolver unavailable) => no sidecar log at all.
   170	  [ -n "$sd" ] || return 0
   171	  printf '%s/grok-review-log.jsonl' "$sd"
   172	}
   173	
   174	# Collect commits to check for one pushed ref range.
   175	# Args: <local_sha> <remote_sha>
   176	_commits_in_range() {
   177	  local local_sha="$1" remote_sha="$2"
   178	  if [ "$local_sha" = "$_zero" ]; then
   179	    return 0  # branch deletion — nothing to push
   180	  fi
   181	  if [ "$remote_sha" = "$_zero" ]; then
   182	    # New branch: commits reachable from local_sha that are NOT already on any
   183	    # remote-tracking ref.
   184	    #
   185	    # `--not --all` (pair-rail R4, S272) was wrong and is now dangerous: `--all`
   186	    # includes LOCAL refs — among them refs/heads/<the branch being pushed>,
   187	    # which points at $local_sha itself. That subtracts the range from itself,
   188	    # so the commit list came back EMPTY and, since the per-commit union (R3) is
   189	    # now the ONLY source of classified paths, a first push of a branch carrying
   190	    # canonical edits sailed through with an empty set. `--remotes` subtracts
   191	    # only what the remote already has — the question the gate actually asks.
   192	    git rev-list "$local_sha" --not --remotes 2>/dev/null || true
   193	  else
   194	    git rev-list "${remote_sha}..${local_sha}" 2>/dev/null || true
   195	  fi
   196	}
   197	
   198	# All paths changed by one pushed ref range, one per line (unsorted, dups ok).
   199	# Non-new-branch: ONE endpoint tree diff (net change — matches the
   200	# recorder's working-tree aggregate semantics, and merge-safe).
   201	# PER-COMMIT UNION, always (pair-rail R3, S272).
   202	#
   203	# The endpoint diff (`git diff remote..local`) reports the NET effect of the
   204	# push. That is the wrong question: a range that edits a canonical file in one
   205	# commit and REVERTS it in a later one has an empty net diff — the gate saw
   206	# nothing, exited 0, and the unreviewed canonical edit still travelled to the
   207	# remote inside the intermediate commit (from where a revert-of-the-revert or a
   208	# cherry-pick resurrects it, forever unreviewed). What the gate must classify is
   209	# every path any PUSHED COMMIT touches, so the union is taken over the range in
   210	# both the existing-branch and new-branch cases.
   211	#
   212	# Consequence, intended: for an edit+revert range the gate's aggregate no longer
   213	# equals the recorder's working-tree aggregate, so sidecar path (b) cannot match
   214	# and the push must carry per-commit APPROVE trailers — the fail-CLOSED
   215	# direction.
   216	_changed_paths_in_range() {
   217	  local local_sha="$1" remote_sha="$2" c
   218	  if [ "$local_sha" = "$_zero" ]; then
   219	    return 0
   220	  fi
   221	  for c in $(_commits_in_range "$local_sha" "$remote_sha"); do
   222	    # --root: without it, diff-tree emits NOTHING for a ROOT commit (no parent
   223	    # to diff against), so a first push whose root commit ADDS canonical files
   224	    # classified an empty set and passed (pair-rail R5, S272).
   225	    git diff-tree --root --no-commit-id --name-only -r "$c" 2>/dev/null || true
   226	  done
   227	}
   228	
   229	# Classify the paths in file $1 (unique, one per line) -> canonical subset
   230	# on stdout. Single source of truth: the check_canonical_edit.py oracle CLI
   231	# (F5/C2(b)). On ANY oracle failure (missing python3/oracle file, nonzero
   232	# exit, malformed or truncated output) -> fall back to the coarse
   233	# classifier above = OVER-trigger = fail-CLOSED (F5/C2(d)).
   234	_classify_canonical() {
   235	  local in_file="$1" oracle_out expected got malformed p
   236	  expected="$(grep -c . "$in_file" || true)"
   237	  [ "$expected" = "0" ] && return 0
   238	  if [ -f "$_oracle" ] && command -v python3 >/dev/null 2>&1; then
   239	    if oracle_out="$(CLAUDE_PROJECT_DIR="$_repo_top" python3 "$_oracle" \
   240	        --is-canonical - < "$in_file" 2>/dev/null)"; then
   241	      got="$(printf '%s\n' "$oracle_out" | grep -c . || true)"
   242	      malformed="$(printf '%s\n' "$oracle_out" | grep -cEv "	[01]\$" || true)"
   243	      if [ "$got" = "$expected" ] && [ "$malformed" = "0" ]; then
   244	        printf '%s\n' "$oracle_out" | awk -F'\t' '$2=="1" {print $1}'
   245	        return 0
   246	      fi
   247	    fi
   248	  fi
   249	  # DEGRADED: the fine predicate is unavailable. Classification over-triggers
   250	  # (fail-CLOSED), but the aggregate fingerprint computed from a COARSE set is
   251	  # collision-prone — two different pushes touching the same top-level prefixes
   252	  # hash identically, so one recorded APPROVE could clear an unrelated canonical
   253	  # edit (review-reuse). Acceptance path (b) is therefore DISABLED while
   254	  # degraded; only per-commit APPROVE trailers (path a) can clear the push.
   255	  _ORACLE_DEGRADED=1
   256	  echo "pre-push-review-gate: canonical-path ORACLE unavailable/failed;" \
   257	    "falling back to COARSE classifier (over-triggers = fail-CLOSED) and" \
   258	    "DISABLING sidecar acceptance (coarse fingerprints collide) — only" \
   259	    "per-commit APPROVE trailers can clear this push." >&2
   260	  while IFS= read -r p; do
   261	    [ -n "$p" ] || continue
   262	    if _is_canonical_path "$p"; then printf '%s\n' "$p"; fi
   263	  done < "$in_file"
   264	}
   265	
   266	# Does this commit carry an APPROVE pair-rail trailer? (acceptance path a)
   267	_commit_has_approve_trailer() {
   268	  local sha="$1"
   269	  git log -1 --format='%B' "$sha" 2>/dev/null \
   270	    | grep -Eiq '^Pair-Rail-Reviewed:[[:space:]]*APPROVE' && return 0
   271	  return 1
   272	}
   273	
   274	# Does the sidecar review-log carry an APPROVE record matching this
   275	# fingerprint? (acceptance path b)
   276	_sidecar_has_approve() {
   277	  local fp="$1" log
   278	  log="$(_review_log)"
   279	  [ -n "$log" ] && [ -f "$log" ] || return 1
   280	  # Match a JSON object line that is APPROVE AND carries this fingerprint.
   281	  grep -F "\"fingerprint\": \"${fp}\"" "$log" 2>/dev/null \
   282	    | grep -Eq '"verdict": ?"APPROVE"' && return 0
   283	  # Tolerate compact JSON (no spaces).
   284	  grep -F "\"fingerprint\":\"${fp}\"" "$log" 2>/dev/null \
   285	    | grep -Eq '"verdict":"APPROVE"' && return 0
   286	  return 1
   287	}
   288	
   289	_all_changed_file="$(mktemp)"
   290	_uniq_changed_file="$(mktemp)"
   291	_canonical_file="$(mktemp)"
   292	_commits_file="$(mktemp)"
   293	trap 'rm -f "$_all_changed_file" "$_uniq_changed_file" "$_canonical_file" "$_commits_file"' EXIT
   294	
   295	while read -r _local_ref _local_sha _remote_ref _remote_sha; do
   296	  [ -n "${_local_sha:-}" ] || continue
   297	  _changed_paths_in_range "$_local_sha" "$_remote_sha" >> "$_all_changed_file"
   298	  _commits_in_range "$_local_sha" "$_remote_sha" >> "$_commits_file"
   299	done
   300	
   301	# Aggregate ONCE across everything being pushed (F5/C2(c)): one path set,
   302	# one fingerprint — the recorder-side aggregate is one working-tree set.
   303	LC_ALL=C sort -u "$_all_changed_file" | grep -v '^$' > "$_uniq_changed_file" || true
   304	
   305	_classify_canonical "$_uniq_changed_file" > "$_canonical_file"
   306	
   307	if ! [ -s "$_canonical_file" ]; then
   308	  exit 0  # no canonical paths in the push — nothing to gate
   309	fi
   310	
   311	# Fingerprint: sha256 over LC_ALL=C sorted-unique newline-joined set, NO
   312	# trailing newline — byte-identical to check_codex_stop_review.fingerprint
   313	# ("\n".join(sorted(set(paths)))). The $(...) substitution strips the
   314	# trailing newline; LC_ALL=C sort orders by byte = Python codepoint order.
   315	_fp="$(printf '%s' "$(LC_ALL=C sort -u "$_canonical_file")" | _sha256)"
   316	
   317	# Acceptance path (b): sidecar APPROVE record matching the AGGREGATE
   318	# fingerprint clears the whole range — but ONLY when the fingerprint was built
   319	# from the FINE oracle set. Under a degraded (coarse) classification the
   320	# fingerprint is collision-prone, so path (b) is closed and the push must carry
   321	# per-commit APPROVE trailers (pair-rail R1 P1, S272).
   322	if [ "$_ORACLE_DEGRADED" = "0" ] && _sidecar_has_approve "$_fp"; then
   323	  exit 0
   324	fi
   325	
   326	# Acceptance path (a): every canonical-touching commit carries an APPROVE
   327	# trailer.
   328	_unreviewed_commits=""
   329	_fail_count=0
   330	while IFS= read -r _c; do
   331	  [ -n "$_c" ] || continue
   332	  # --root: a root commit has no parent; without it diff-tree emits nothing and
