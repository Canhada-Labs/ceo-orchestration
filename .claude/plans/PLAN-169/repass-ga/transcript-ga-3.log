   500	# ---------------------------------------------------------------------------
   501	# Per-scenario runner (worst-of-N + flaky flag — PLAN-133 C1)
   502	# ---------------------------------------------------------------------------
   503	
   504	
   505	async def run_one_scenario(
   506	    client,
   507	    scenario: Dict[str, Any],
   508	    *,
   509	    skill_content: str,
   510	    model: str,
   511	    max_tokens: int,
   512	    repetitions: int,
   513	    scoring: Dict[str, Any],
   514	    max_input_chars: int,
   515	) -> Dict[str, Any]:
   516	    """Run a scenario `repetitions` times, score each, aggregate the runs.
   517	
   518	    PLAN-133 C1 — aggregation switched from median-of-N to **worst-of-N**
   519	    (the conservative floor) and a ``flaky`` flag is set whenever the N
   520	    runs disagree on pass/fail. The aggregation mode is selectable via
   521	    ``CEO_BENCH_AGGREGATION`` (default "worst"; "median" restores legacy).
   522	
   523	    The aggregated score is exposed BOTH as ``aggregated_score`` (new,
   524	    explicit) and ``median_score`` (kept as the stable key the downstream
   525	    ``median_score_bps`` emit consumer + SPEC + markdown reporter read).
   526	    """
   527	    system_prompt, user_prompt = build_prompt(
   528	        skill_content, scenario, max_input_chars=max_input_chars
   529	    )
   530	    expected = scenario.get("expected", {})
   531	    is_control = bool(scenario.get("control", False))
   532	
   533	    raw_runs = []
   534	    for run_idx in range(repetitions):
   535	        t0 = time.monotonic()
   536	        try:
   537	            text = await call_api(
   538	                client,
   539	                model=model,
   540	                system_prompt=system_prompt,
   541	                user_prompt=user_prompt,
   542	                max_tokens=max_tokens,
   543	            )
   544	            # Redact before storing (defense in depth)
   545	            text_safe = redact_secrets(text, max_chars=0)
   546	            parsed = parse_response(text_safe)
   547	            result = score_scenario(
   548	                parsed, expected, scoring, is_control=is_control
   549	            )
   550	            result["elapsed_ms"] = int((time.monotonic() - t0) * 1000)
   551	            result["parse_error"] = parsed.get("_parse_error")
   552	            raw_runs.append(result)
   553	        except Exception as e:
   554	            raw_runs.append(
   555	                {
   556	                    "score": 0.0,
   557	                    "passed": False,
   558	                    "error": str(e),
   559	                    "elapsed_ms": int((time.monotonic() - t0) * 1000),
   560	                    "skipped": True,
