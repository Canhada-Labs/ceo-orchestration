  1161	# ---------------------------------------------------------------------------
  1162	# Pair-rail timeout coherence (PLAN-164 / ADR-110-AMEND-1 — ADVISORY,
  1163	# report-only, NEVER drives the exit code): the harness kills a hook at its
  1164	# settings.json registration timeout, so a check_pair_rail.py registration
  1165	# below the hook's INTERNAL default (CEO_PAIR_RAIL_TIMEOUT_S) + the 30s
  1166	# invariant margin means the codex verdict can be killed mid-flight — the
  1167	# historical 12/12 pair_rail_case F/TIMEOUT class (hook-kill risk). The
  1168	# internal default is read with the SAME regex the invariant uses:
  1169	# os.environ.get("CEO_PAIR_RAIL_TIMEOUT_S", "NNN"). Fail-open: missing
  1170	# jq/hook/settings or an unparseable value => NOTE + skip.
  1171	# ---------------------------------------------------------------------------
  1172	_pair_rail_timeout_check() {
  1173	  _prt_settings="$TARGET/.claude/settings.json"
  1174	  _prt_hook="$TARGET/.claude/hooks/check_pair_rail.py"
  1175	  if [ ! -f "$_prt_settings" ] || [ ! -f "$_prt_hook" ]; then
  1176	    return 0
  1177	  fi
  1178	  if ! command -v jq >/dev/null 2>&1; then
  1179	    _log "    NOTE: pair-rail timeout check skipped (jq not found) — advisory only"
  1180	    return 0
  1181	  fi
  1182	  _prt_reg="$( jq -r '[ .hooks // {} | to_entries[] | .value
  1183	      | select(type == "array") | .[] | .hooks[]?
  1184	      | select((type == "object")
  1185	          and ((.command? | type) == "string")
  1186	          and (.command | test("check_pair_rail\\.py")))
  1187	      | .timeout ] | first // empty' "$_prt_settings" 2>/dev/null || true )"
  1188	  _prt_int="$( sed -n 's/.*os\.environ\.get("CEO_PAIR_RAIL_TIMEOUT_S", "\([0-9][0-9]*\)").*/\1/p' "$_prt_hook" 2>/dev/null | head -n 1 )"
  1189	  case "$_prt_reg" in
  1190	    ''|*[!0-9]*)
  1191	      _log "    NOTE: pair-rail timeout check skipped (no numeric check_pair_rail.py registration timeout in settings.json) — advisory only"
  1192	      return 0 ;;
  1193	  esac
  1194	  case "$_prt_int" in
  1195	    ''|*[!0-9]*)
  1196	      _log "    NOTE: pair-rail timeout check skipped (internal CEO_PAIR_RAIL_TIMEOUT_S default not found in check_pair_rail.py) — advisory only"
  1197	      return 0 ;;
  1198	  esac
  1199	  if [ "$_prt_reg" -lt $((_prt_int + 30)) ]; then
  1200	    _log ""
  1201	    _log "    WARN: check_pair_rail.py registration timeout (${_prt_reg}s) < internal default (${_prt_int}s) + 30s margin —"
  1202	    _log "          the harness can KILL the hook before the codex verdict lands (PLAN-164 hook-kill risk;"
  1203	    _log "          the historical 12/12 pair_rail_case F/TIMEOUT class). Raise the settings.json registration"
  1204	    _log "          timeout to >= $((_prt_int + 30))s (upgrade.sh migrates the old default 60 -> 150)."
  1205	  elif [ "$VERBOSE" -eq 1 ]; then
  1206	    _log "    OK (pair-rail timeouts): registration ${_prt_reg}s >= internal ${_prt_int}s + 30s margin"
  1207	  fi
  1208	  return 0
  1209	}
  1210	_pair_rail_timeout_check
  1211	
  1212	# ---------------------------------------------------------------------------
  1213	# Summary + exit code
  1214	# ---------------------------------------------------------------------------
  1215	_log ""
  1216	_log "==> Doctor summary:"
  1217	_log "    OK:        $OK_COUNT"
  1218	_log "    Drift:     $DRIFT_COUNT"
  1219	_log "    Missing:   $MISSING_COUNT"
  1220	if [ "$REPAIR" -eq 1 ] && [ "$DRY_RUN" -eq 1 ]; then
  1221	  _log "    Repaired:  0 (dry-run: $WOULD_REPAIR would be repaired; nothing written)"
  1222	else
  1223	  _log "    Repaired:  $REPAIRED_COUNT"
  1224	fi
  1225	_log "    Skipped:   $SKIPPED_CONFIRM (awaiting per-file confirm)"
  1226	_log "    Blocked:   $BLOCKED_COUNT (baseline/framework divergence — use upgrade.sh)"
  1227	_log "    Refused:   $REFUSED_COUNT (destination not confined to the target — nothing written)"
  1228	_log "    Orphans:   $ORPHAN_COUNT (candidates, report-only)"
  1229	# Conditional ON PURPOSE (S340): a healthy run must keep printing exactly the
  1230	# summary it printed before this pack — the line appears only when there is
  1231	# something to report.
  1232	if [ "$DROPPED_COUNT" -gt 0 ]; then
  1233	  _log "    Dropped:   $DROPPED_COUNT (unsafe or malformed manifest records — NOT verified)"
  1234	fi
  1235	if [ -n "$BAK_DIR" ]; then
  1236	  _log "    Backups:   $BAK_DIR"
  1237	fi
  1238	
  1239	if [ "$UNRESOLVED" -gt 0 ]; then
  1240	  exit 1
  1241	fi
  1242	if [ "$STRICT_ORPHANS" -eq 1 ] && [ "$ORPHAN_COUNT" -gt 0 ]; then
  1243	  exit 1
  1244	fi
