   200	  # anything at all — an adopter's file, a PRESERVED delivery, another
   201	  # adopter-created directory — survives without this code having to reason
   202	  # about it.
   203	  printf '%s\n' "$swept_dirs" \
   204	    | awk 'NF { print gsub(/\//, "/") "\t" $0 }' \
   205	    | sort -rn -k1,1 \
   206	    | cut -f2- \
