  1010	        from _lib import audit_emit  # type: ignore
  1011	        typed = getattr(audit_emit, "emit_session_memory_delta_observed", None)
  1012	        if typed is None:
  1013	            # LOUD by design (PLAN-179 process defect #1: silent getattr
  1014	            # degradation). The symbol lands in the SAME ceremony patch as
  1015	            # this caller; its absence is a partial-upgrade adopter.
  1016	            sys.stderr.write(
  1017	                "# SessionEnd US8: audit_emit.emit_session_memory_delta_"
  1018	                "observed missing — delta event NOT emitted (partial "
  1019	                "upgrade?)\n"
  1020	            )
  1021	            return
  1022	        typed(
  1023	            outcome=delta.get("outcome") or "other",
  1024	            files_count=delta.get("files_count", 0),
  1025	            modified_count=delta.get("modified_count", 0),
  1026	            index_modified=delta.get("index_modified", False),
  1027	            anchor_source=delta.get("anchor_source") or "none",
  1028	            session_id=session_id,
  1029	            project=str(repo_root),
  1030	        )
  1031	    except Exception as e:
  1032	        # Rail r13 P2-b: falha de infra deixa breadcrumb ALTO (regra
  1033	        # fail-open) — sem ele a evidencia assinada do US8 sumiria em
  1034	        # silencio num upgrade parcial. So o TIPO da excecao (o repr
  1035	        # poderia carregar internals do emitter).
  1036	        try:
  1037	            sys.stderr.write(
  1038	                "[SessionEnd] memory-delta emit failed: %s\n"
  1039	                % type(e).__name__
  1040	            )
