   307	def _plan_file_for(plan_id: str, cwd: str) -> Optional[str]:
   308	    """Absolute path of the plan markdown file for ``plan_id``, or None.
   309	
   310	    Matches ``PLAN-NNN-*.md`` directly under ``.claude/plans/`` (PLAN-SCHEMA
   311	    naming). Returns the first match in sorted order (deterministic)."""
   312	    if not plan_id.startswith("PLAN-"):
   313	        return None
   314	    pattern = os.path.join(cwd, ".claude", "plans", plan_id + "-*.md")
   315	    matches = sorted(glob.glob(pattern))
   316	    return matches[0] if matches else None
