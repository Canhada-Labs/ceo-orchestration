   116	# session id, so it accumulates files the plan-scoped one does not. Every
   117	# session-scope write carries an EXPLICIT ttl so an orphaned snapshot expires
   118	# on its own even before the file-level GC item ships. Hygiene value (7 days),
   119	# not a decision-bearing number.
   120	SESSION_SNAPSHOT_TTL_S = 7 * 24 * 3600
