   182	def _git(
   183	    args: List[str], cwd: str, timeout_s: float = 2.0, raw: bool = False
   184	) -> str:
   185	    """stdout on success, '' on any failure (fail-open).
   186	
   187	    ``timeout_s`` (rail r2 P2-f): a caller under a shared wall deadline
   188	    passes its REMAINING time — a fixed 2s here let a late call run past
   189	    the hook budget. Existing call sites keep the historical default.
   190	
   191	    Rail r8 P2-b: um resto de budget ABAIXO do floor de subprocess não é
   192	    budget útil — o antigo ``max(0.05, ...)`` ESTICAVA um resto de 10ms
   193	    para 50ms e furava o wall deadline compartilhado. Sem budget, a
   194	    resposta honesta é o fail-open imediato, nunca uma chamada tardia."""
   195	    if timeout_s < 0.05:
   196	        return ""
   197	    try:
   198	        # Rail r10 P2-a: errors="replace" — filename nao-UTF-8 (legal em
   199	        # Linux) sob `-z` vem em bytes crus; o decode ESTRITO do text=True
   200	        # levantava UnicodeDecodeError que NENHUM except aqui pegava e o
   201	        # snapshot inteiro morria por causa do indice OPCIONAL. Com
   202	        # replacement o path vira U+FFFD, nao casa shape nenhum e degrada
   203	        # honesto.
   204	        p = subprocess.run(
   205	            ["git"] + args, cwd=cwd, capture_output=True, text=True,
   206	            errors="replace", timeout=timeout_s,
   207	        )
   208	        if p.returncode != 0:
   209	            return ""
   210	        # Rail r11 P2-c: em modo raw (-z) o strip do output INTEIRO
   211	        # corromperia whitespace legitimo do primeiro/ultimo path — os
   212	        # limites exatos ja vem dos NULs.
   213	        return p.stdout if raw else p.stdout.strip()
   214	    except (subprocess.TimeoutExpired, OSError):
   215	        return ""
