   281	def _session_scope_id(event: Dict[str, Any]) -> Optional[str]:
   282	    """Session id usable as a WRITE SCOPE, or None (PLAN-179 W1 US3, r1-C1).
   283	
   284	    Delegates the shape validation + the provenance rule to
   285	    ``scratchpad_lib.session_id_from_event``: the id must come from the HOOK
   286	    INPUT. If that helper returns None — no id in the event, malformed shape,
   287	    or an id that would have been sourced from ``CLAUDE_SESSION_ID`` (env is
   288	    agent-spoofable, consensus M2) — we REFUSE the fallback rather than write
   289	    under a scope an agent could have chosen. Import/derivation failure is
   290	    infrastructure: breadcrumb + None (fail-open)."""
   291	    try:
   292	        from _lib import scratchpad_lib  # noqa: E402
   293	    except Exception as exc:  # pragma: no cover — import guard
   294	        _breadcrumb("scratchpad_lib import failed at session scope (%s)" % str(exc)[:60])
   295	        return None
   296	    try:
   297	        sid = scratchpad_lib.session_id_from_event(event)
   298	    except Exception as exc:
   299	        _breadcrumb("session scope derivation failed (%s)" % str(exc)[:80])
   300	        return None
   301	    if isinstance(sid, str) and sid.strip():
   302	        return sid.strip()
   303	    # None here is a DECISION (env-sourced / absent / malformed), not an error.
   304	    return None
