  1064	        # o conta duas vezes. Rail r22 P1-a (TROCA DE ARQUITETURA, regra
  1065	        # fix-of-fix): CINCO rodadas de bypass na mesma classe (r15
  1066	        # espacos, r19 hifens, r20 camel/minuscula, r21 run-19, r22
  1067	        # "IgnoreAllRules" = 14 exatos que os validadores PERMITEM
  1068	        # expandido) provaram que sanitizar nome-livre para um canal
  1069	        # instruction-adjacent e insanavel por enumeracao. O canal de
  1070	        # NOMES sai do systemMessage: counts-only. O sanitizer + `names`
  1071	        # ficam no dict como gate de QUALQUER render futuro (testados);
  1072	        # nomes vivem a um `ls` de distancia do operador.
  1073	        index_mod = delta.get("index_modified") is True
  1074	        topics = modified_count
  1075	        if index_mod and isinstance(modified_count, int) and modified_count > 0:
