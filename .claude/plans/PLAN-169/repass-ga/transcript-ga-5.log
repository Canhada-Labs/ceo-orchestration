   247	def _trigger_class(event: Dict[str, Any]) -> str:
   248	    """Map the harness PreCompact trigger to the closed enum.
   249	
   250	    The documented PreCompact hook input carries a ``trigger`` field with
   251	    ``manual`` (user ran /compact) or ``auto`` (context-window threshold).
   252	    Anything else (incl. a missing field on a future harness change) is
   253	    ``other`` — the audit_emit scrub re-coerces too (defense in depth)."""
   254	    val = event.get("trigger")
   255	    if val in ("manual", "auto"):
   256	        return val
   257	    return "other"
