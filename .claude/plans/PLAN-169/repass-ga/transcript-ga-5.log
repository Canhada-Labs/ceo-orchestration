   741	def main() -> None:
   742	    try:
   743	        hook_input = json.loads(sys.stdin.read() or "{}")
   744	        if not isinstance(hook_input, dict):
   745	            raise ValueError("hook input is not a JSON object")
   746	    except Exception as exc:
   747	        # PLAN-091 S116: parse error is infra → breadcrumb + schema-compliant allow.
   748	        sys.stderr.write(
   749	            "# check_postcompact_reinject fail-open (stdin): %s\n" % str(exc)[:120]
   750	        )
   751	        print("{}")
   752	        return
   753	    try:
   754	        print(json.dumps(gate(hook_input)))
   755	    except Exception as exc:
   756	        sys.stderr.write(
   757	            "# check_postcompact_reinject fail-open: %s\n" % str(exc)[:120]
   758	        )
