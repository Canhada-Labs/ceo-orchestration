   432	def stamp_scope_kind(blob: Dict[str, Any], scope_kind: str) -> Dict[str, Any]:
   433	    """Stamp ``scope_kind`` into a snapshot blob before it is stored (r1-C1).
   434	
   435	    The stored blob carries which scope produced it so the PostCompact
   436	    reader can report honestly ("this came from the session fallback,
   437	    there was no resolved plan") instead of inferring it from where the
   438	    file happened to be.
   439	
   440	    Args:
   441	        blob: the snapshot dict, mutated in place and returned.
   442	        scope_kind: one of :data:`SCOPE_KIND_PLAN` /
   443	            :data:`SCOPE_KIND_SESSION` — a closed enum, like every other
   444	            governance-visible field in this family.
   445	
   446	    Returns:
   447	        The same dict, with ``scope_kind`` set.
   448	
   449	    Raises:
   450	        ValueError: when ``scope_kind`` is outside the enum.
   451	    """
   452	    if scope_kind not in _SCOPE_KINDS:
   453	        raise ValueError(
   454	            "scope_kind must be one of %r, got %r" % (list(_SCOPE_KINDS), scope_kind)
   455	        )
   456	    blob["scope_kind"] = scope_kind
   457	    return blob
