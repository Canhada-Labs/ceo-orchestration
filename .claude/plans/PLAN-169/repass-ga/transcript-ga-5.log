  1046	def _render_memory_delta_line(delta: Dict[str, object]) -> str:
  1047	    """One-line operator ratification string (SESSIONEND-NOTE.md §3 shapes).
  1048	
  1049	    The OMISSION phrasing is the point of the whole item: it is the line
  1050	    that makes E3 visible at the moment the operator can still act on it."""
  1051	    outcome = delta.get("outcome")
  1052	    files_count = delta.get("files_count", 0)
  1053	    modified_count = delta.get("modified_count", 0)
  1054	    if outcome == "absent":
  1055	        # Rail r23 P3-c: files_count inclui o MEMORY.md — "topics" aqui
  1056	        # inflaria a contagem em 1 (o ramo written conta o index em
  1057	        # separado). "entries" e o rotulo honesto.
  1058	        return (
  1059	            "SessionEnd: memory delta ABSENT (0 of %s entries touched this "
  1060	            "session) — ratify or record before closing" % files_count
