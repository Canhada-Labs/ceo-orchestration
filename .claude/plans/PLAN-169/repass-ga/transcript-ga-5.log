   104	if str(_HOOKS_DIR) not in sys.path:
   105	    sys.path.insert(0, str(_HOOKS_DIR))
   106	
   107	TIME_BUDGET_S = 2.5
   108	SCRATCHPAD_KEY = "compaction_continuity"
   109	MAX_CEREMONY_FLAGS = 5
   110	# Snapshot blob is capped well under the scratchpad 64 KiB per-key limit; the
   111	# label/path clamps below keep it small regardless.
   112	_LABEL_CLAMP = 160
   113	_PATH_CLAMP = 200
   114	
