   664	def _emit_reinject_event(
   665	    plan_id: str,
   666	    snapshot_found: bool,
   667	    age_s: int,
   668	    pointer_count: int,
   669	    constraint_count: int,
   670	) -> None:
   671	    """Emit the closed-enum compaction_context_reinjected breadcrumb.
   672	
   673	    Closed enums + counters only — the pointer TEXT and the constraint TEXT
   674	    never hit the wire. Import-guarded; any failure swallowed (NEVER blocks on
   675	    audit infra).
   676	
   677	    PLAN-179 W1-b: ``constraint_count`` is a SEPARATE counter from
   678	    ``pointer_count`` (whose meaning is unchanged: pointers only). Until the
   679	    audit owner adds it to ``_COMPACTION_CONTEXT_REINJECTED_ALLOWLIST`` + the
   680	    SPEC row, the deny-by-default scrub DROPS it — the emit is written now so
   681	    the field lands the moment that ceremony runs, and so the drop shows up in
   682	    the scrub breadcrumb instead of being invisible."""
   683	    try:
   684	        from _lib import audit_emit  # noqa: E402
   685	    except Exception:
   686	        return
   687	    try:
   688	        audit_emit.emit_generic(
   689	            action="compaction_context_reinjected",
   690	            plan_id=plan_id,
   691	            snapshot_found=snapshot_found,
   692	            snapshot_age_s=age_s,
   693	            pointer_count=pointer_count,
   694	            constraint_count=constraint_count,
   695	        )
   696	    except Exception as exc:  # pragma: no cover — belt-and-suspenders
   697	        _breadcrumb("audit emit failed (%s)" % str(exc)[:80])
   698	
