   322	def _flush_audit_log_filelock(repo_root: Path) -> None:
   323	    """Touch + release the audit-log filelock as a drain barrier.
   324	
   325	    This does not force a fsync; that is the writer's responsibility.
   326	    The barrier primitive ensures any concurrent writer holding the
   327	    lock finishes before this hook returns control to the harness.
   328	    """
   329	    try:
   330	        from _lib.filelock import FileLock  # type: ignore
   331	    except Exception:
   332	        return
   333	    try:
   334	        lock_path = (
   335	            _rp_state_dir()
   336	            / "audit-log.jsonl.lock"
   337	        )
   338	        if lock_path.exists():
   339	            with FileLock(str(lock_path), timeout=0.5):
   340	                pass
   341	    except Exception:
   342	        return
