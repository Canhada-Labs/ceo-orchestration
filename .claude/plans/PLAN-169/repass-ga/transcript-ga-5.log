    89	    from pathlib import Path as _P
    90	    import os as _o
    91	    _h = _o.environ.get("HOME") or str(_P.home())
    92	    return _P(_h) / ".claude" / "projects" / "ceo-orchestration"  # rp-allow: partial-upgrade-fallback
