   136	# bare `used_bucket=0`. The wire field is `used_bucket` and it is a COARSE
   137	# INTEGER PERCENT rung (share of the context window consumed), never a raw or
   138	# token-derived count: a raw count is a transcript-size side channel, and a
   139	# FLOAT under the HMAC chain discards the WHOLE event
   140	# ([[feedback-float-in-hmac-field-drops-whole-event]]).
   141	#
   142	# The rung SET is DERIVED from audit_emit at call time, never restated here
   143	# ([[feedback-closed-sets-must-be-derived-not-recalled]]): a literal copy would
   144	# drift from the scrub branch that validates it and the event would coerce to
   145	# the 0 sentinel forever, i.e. exactly the silent dead instrument this pass
   146	# exists to remove.
   147	_PRESSURE_RUNGS_ATTR = "_CONTEXT_PRESSURE_USED_BUCKETS_PCT"
   148	# This producer's value inside audit_emit._CONTEXT_PRESSURE_EVENT_SOURCES.
   149	_PRESSURE_EVENT_SOURCE = "precompact"
   150	# audit_emit's documented "unrecognized / absent bucket" sentinel — deliberately
   151	# OUTSIDE the percent enum so a consumer can always tell a real rung from a
   152	# coerced one. Emitted when the hook input carries no context-window accounting.
   153	_PRESSURE_BUCKET_UNKNOWN = 0
   154	# `should_emit_context_pressure(used_bucket, state_dir)` keeps its edge-trigger
   155	# marker under `<project>/.claude/state` (its own docstring names that path).
   156	_PRESSURE_STATE_SUBPATH = (".claude", "state")
