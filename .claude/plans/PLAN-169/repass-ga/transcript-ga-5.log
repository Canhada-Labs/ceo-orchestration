   161	# guessed here. Absent ⇒ no percent is invented
   162	# ([[feedback-measurement-must-list-its-inputs]]).
   163	_CONTEXT_WINDOW_KEYS = ("context_window", "context", "context_usage")
   164	_CONTEXT_PCT_KEYS = ("used_percentage", "used_pct", "percent_used")
   165	_CONTEXT_USED_KEYS = ("used_tokens", "input_tokens", "total_input_tokens")
   166	_CONTEXT_SIZE_KEYS = ("context_window_size", "max_tokens", "size")
