  1001	def _emit_session_memory_delta(
  1002	    *, session_id: str, repo_root: Path, delta: Dict[str, object]
  1003	) -> None:
  1004	    """Best-effort typed emit (SESSIONEND-NOTE.md §4). Never raises.
  1005	
  1006	    ``names`` NEVER rides — the wire denies basenames by contract; the
  1007	    typed emitter does not even accept them. An emit failure changes no
  1008	    decision (there is no decision here to change)."""
