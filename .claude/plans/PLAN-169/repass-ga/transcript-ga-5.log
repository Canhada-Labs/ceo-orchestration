   704	                            # nao aborta a varredura.
   705	                            continue
   706	            except FileLockTimeout:
   707	                continue  # lock ocupado = store ATIVO — nunca disputa
   708	            except OSError:
   709	                continue
   710	        if _last_decided is not None:
   711	            _gc_write_cursor(store_dir, _last_decided)
   712	    except OSError:
   713	        # Sweep-level fail-open (unreadable dir, vanished state root).
   714	        return removed
