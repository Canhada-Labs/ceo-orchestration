   136	def _validate_store_name(store_name: str) -> None:
   137	    """Reject store names that could escape the state root."""
   138	    if not store_name:
   139	        raise StateStoreInvalidName("store_name must be non-empty")
   140	    if len(store_name) > _STORE_NAME_MAX_LEN:
   141	        raise StateStoreInvalidName(
   142	            f"store_name too long ({len(store_name)} > {_STORE_NAME_MAX_LEN})"
   143	        )
   144	    # Allow kebab-case + underscore slugs only
   145	    for ch in store_name:
   146	        if not (ch.isalnum() or ch in "-_"):
   147	            raise StateStoreInvalidName(
   148	                f"store_name contains illegal char {ch!r}; allowed: [A-Za-z0-9_-]"
   149	            )
   150	
   151	
   152	def _validate_plan_id(plan_id: str) -> None:
   153	    """Reject plan_ids that could escape the store dir."""
   154	    if not plan_id:
   155	        raise StateStoreInvalidName("plan_id must be non-empty")
   156	    if len(plan_id) > _PLAN_ID_MAX_LEN:
   157	        raise StateStoreInvalidName(
   158	            f"plan_id too long ({len(plan_id)} > {_PLAN_ID_MAX_LEN})"
   159	        )
   160	    for ch in plan_id:
   161	        if not (ch.isalnum() or ch in "-_."):
   162	            raise StateStoreInvalidName(
   163	                f"plan_id contains illegal char {ch!r}; allowed: [A-Za-z0-9_.-]"
   164	            )
   165	    if plan_id.startswith(".") or ".." in plan_id:
   166	        raise StateStoreInvalidName(f"plan_id {plan_id!r} attempts path escape")
