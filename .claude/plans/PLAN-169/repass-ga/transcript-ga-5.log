   362	def session_scope_id(session_id: str) -> str:
   363	    """Build and validate the ``session-<uuid>`` scope id (r1-C1).
   364	
   365	    This is the ONLY place a session id becomes a filesystem-facing
   366	    identifier. Validation is explicit rather than inherited from
   367	    state_store's ``_validate_plan_id``: that validator allows ``.`` and
   368	    would happily accept ``PLAN-179`` — neither is acceptable for a
   369	    scope that must be unmistakably session-shaped.
   370	
   371	    Args:
   372	        session_id: raw session id (already sourced from the hook input
   373	            via :func:`session_id_from_event`).
   374	
   375	    Returns:
   376	        The scope id, e.g. ``session-9f1c0f6e-...``.
   377	
   378	    Raises:
   379	        StateStoreInvalidName: when the resulting id does not match
   380	            :data:`_SESSION_SCOPE_ID_RE`.
   381	    """
   382	    raw = str(session_id or "").strip()
   383	    scope = raw if raw.startswith("session-") else "session-" + raw
   384	    if not _SESSION_SCOPE_ID_RE.match(scope):
   385	        raise StateStoreInvalidName(
   386	            "session scope id %r is not of the form session-<uuid> "
   387	            "(allowed after the prefix: [0-9a-fA-F-]{8,60})" % scope
   388	        )
   389	    return scope
