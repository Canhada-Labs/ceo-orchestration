   173	def _sanitize_text(raw: str, clamp: int) -> str:
   174	    """Disk-sourced strings written into the snapshot are kept printable-ASCII
   175	    + clamped — the snapshot blob is later read by the PostCompact half and a
   176	    control char / newline could distort downstream rendering. Mirrors the
   177	    closeout-guard ``_sanitize_path`` hardening (Codex S228 P0)."""
   178	    cleaned = "".join(ch if 0x20 <= ord(ch) <= 0x7E else "?" for ch in raw)
   179	    return cleaned[:clamp]
