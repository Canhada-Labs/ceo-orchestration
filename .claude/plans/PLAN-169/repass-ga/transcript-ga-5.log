   612	def _render_constraints() -> List[str]:
   613	    """Return the pinned-constraint lines (PLAN-179 W1-b), or [] when disarmed.
   614	
   615	    The set is a CODE constant in ``_lib/pinned_constraints`` (amendment
   616	    r1-C5) — it is NOT snapshot-derived and therefore NOT sanitized here:
   617	    ``_sanitize_line`` exists to defang disk-sourced text, and applying it to
   618	    a code constant would only disguise where the trust boundary actually is.
   619	
   620	    Dedicated kill-switch ``CEO_CONSTRAINT_PINNING=0`` (PLAN-179 §8.8); import
   621	    or render failure degrades to [] with a breadcrumb (fail-OPEN on infra)."""
   622	    if os.environ.get("CEO_CONSTRAINT_PINNING", "1") == "0":
   623	        return []
   624	    try:
   625	        from _lib import pinned_constraints  # noqa: E402
   626	    except Exception as exc:  # pragma: no cover — import guard
   627	        _breadcrumb("pinned_constraints import failed (%s)" % str(exc)[:80])
   628	        return []
   629	    try:
   630	        return pinned_constraints.render_pinned_block()
   631	    except Exception as exc:  # pragma: no cover — belt-and-suspenders
   632	        _breadcrumb("render_pinned_block failed (%s)" % str(exc)[:80])
   633	        return []
   634	
   635	
   636	def _constraint_count() -> int:
   637	    """Pinned-set size for the audit counter (0 when the pinning is disarmed).
   638	
   639	    Counts the SET, not the rendered lines — the block carries a header line,
   640	    and a counter that drifts with formatting is not a counter.
   641	
   642	    PLAN-179 W0/W1 cross-file pass: ``pinned_constraints.constraint_count`` has
   643	    landed and is called directly; the return is coerced to ``int`` here rather
   644	    than trusted. That coercion is not defensive dressing — the value goes into
   645	    an HMAC-covered audit field, and a float (or any non-int) there is refused
   646	    by ``canonical_json`` and DISCARDS THE WHOLE EVENT, not just the field
   647	    ([[feedback-float-in-hmac-field-drops-whole-event]]). The bare ``except``
   648	    also stopped being silent: a missing module is an adopter on a
   649	    pre-PLAN-179 build, which is worth one line of stderr."""
   650	    if os.environ.get("CEO_CONSTRAINT_PINNING", "1") == "0":
   651	        return 0
   652	    try:
   653	        from _lib import pinned_constraints  # noqa: E402
   654	
   655	        return max(0, int(pinned_constraints.constraint_count()))
   656	    except Exception as exc:
   657	        _breadcrumb(
   658	            "pinned_constraints.constraint_count unavailable (%s) — "
   659	            "constraint_count reported as 0" % str(exc)[:80]
   660	        )
   661	        return 0
