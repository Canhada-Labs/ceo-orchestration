   392	def open_session_scratchpad(
   393	    session_id: str,
   394	    *,
   395	    value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   396	) -> SqliteStateStore:
   397	    """Open the SESSION-scoped scratchpad store (r1-C1).
   398	
   399	    Returns the same handle type :func:`open_store` returns, so callers
   400	    use it exactly like :func:`open_scratchpad` (``with`` block, then
   401	    ``set`` / ``get``). The difference is invisible at the call site and
   402	    total on disk: a different ``store_name`` means a different
   403	    directory, so this write can never collide with, shadow, or leak
   404	    into any plan's scratchpad.
   405	
   406	    The ``session-<uuid>`` value is passed as the store's SCOPE id, which
   407	    state_store happens to call ``plan_id`` in its own signature. That is
   408	    a positional-argument name inside another module, not a claim that
   409	    this is a plan: no plan store is ever opened with a ``session-*``
   410	    value, and no ``plan_id`` field in the blob or in any audit event is
   411	    overloaded with it (see :func:`stamp_scope_kind`).
   412	
   413	    Args:
   414	        session_id: session id sourced from the hook input dict.
   415	        value_max_bytes: per-key cap (default 64 KiB, as for plan scope).
   416	
   417	    Returns:
   418	        An unopened :class:`SqliteStateStore` handle.
   419	
   420	    Raises:
   421	        StateStoreInvalidName: when ``session_id`` does not produce a
   422	            valid ``session-<uuid>`` scope id.
   423	    """
   424	    scope = session_scope_id(session_id)
   425	    return open_store(
   426	        SESSION_SCRATCHPAD_STORE_NAME,
   427	        scope,
   428	        value_max_bytes=value_max_bytes,
   429	    )
