   656	def _sanitize_memory_basename(name: object) -> Optional[str]:
   657	    """§6 ingress gate for ONE rendered basename → the name, or None = DROP.
   658	
   659	    Memory basenames were written by a PREVIOUS session's model and enter
   660	    the current model's context via ``systemMessage`` — untrusted content on
   661	    an ingress path. Mirrors the boot-lesson render gate
   662	    (``ceo-boot.py::_validate_boot_lesson`` — mirrored, never imported: it
   663	    is a /ceo-boot private). Drop, never truncate; never render a redaction
   664	    placeholder as a file name. A dropped name still counts in
   665	    ``modified_count`` — counts stay truthful, only the display degrades."""
   666	    if not isinstance(name, str) or not name:
   667	        return None
   668	    try:
   669	        import unicodedata
   670	        norm = unicodedata.normalize("NFKC", name)
   671	    except Exception:
   672	        return None
   673	    # Rail r1 P1-1: the delimiter check runs on the NORMALIZED name — NFKC
   674	    # maps compatibility characters INTO the forbidden set (U+FF40 fullwidth
   675	    # grave -> backtick, U+FF1C -> "<"), so checking the raw name first and
   676	    # normalizing after would hand the renderer the very bytes the gate
   677	    # forbids. The spec's §6 ordering (raw check, then NFKC) is falsified by
   678	    # that mapping; deviation documented in the ceremony DESIGN. Control
   679	    # characters and Unicode line/paragraph separators (U+2028/U+2029 survive
   680	    # NFKC untouched) are rejected by the printable gate below.
   750	        # formas — crua e separador-expandida — passam pelo scan.
   751	        for _cand_text in (norm, expanded):
   752	            _res = _scan(_cand_text)
   753	            _matched = getattr(_res, "matched", None)
   754	            if _matched is None or _matched:
   755	                return None
   756	    except Exception:
   757	        return None
   758	    return norm
   759	
