   287	def open_scratchpad(
   288	    plan_id: Optional[str] = None,
   289	    *,
   290	    value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   291	) -> SqliteStateStore:
   292	    """Open a :class:`SqliteStateStore` for the scratchpad surface.
   293	
   294	    Args:
   295	        plan_id: explicit PLAN-NNN; if None, derived from the current
   296	            session via :func:`resolve_plan_id`.
   297	        value_max_bytes: per-key cap (default inherited from
   298	            state_store; 64 KiB).
   299	
   300	    Returns:
   301	        An unopened store handle. Use as a context manager (``with``)
   302	        or call ``close()`` explicitly.
   303	
   304	    Raises:
   305	        PlanIdDerivationError: when plan_id is None and derivation fails.
   306	        StateStoreInvalidName: when plan_id is malformed.
   307	    """
   308	    resolved = plan_id if plan_id is not None else resolve_plan_id()
   309	    return open_store(
   310	        SCRATCHPAD_STORE_NAME,
   311	        resolved,
   312	        value_max_bytes=value_max_bytes,
   313	    )
