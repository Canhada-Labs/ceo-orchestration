   176	        from _lib import audit_emit  # type: ignore
   177	        emitter = getattr(audit_emit, "emit_generic", None)
   178	        if emitter is not None:
   179	            emitter(
   180	                action="session_end",
   181	                session_id=session_id,
   182	                hook_version=_HOOK_VERSION,
   183	                reason=reason,
   184	                memory_writable=bool(memory_state.get("writable")),
   185	                memory_index_present=bool(memory_state.get("memory_md_present")),
   186	                project=str(repo_root),
