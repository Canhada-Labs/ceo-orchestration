   196	class PlanIdDerivationError(RuntimeError):
   197	    """Raised when we cannot derive a plan-id from the current session.
   198	
   199	    Callers should surface the message and exit non-zero. Falling back
   200	    to an env var is **forbidden** — consensus M2 treats env vars as
   201	    untrusted because an agent with subshell execution can set them.
   202	    """
   203	
   204	
   205	def _resolve_session_id(session_id: Optional[str]) -> str:
   206	    """Return the effective session id, checking CLAUDE_SESSION_ID if arg is None.
   207	
   208	    Empty / whitespace-only values are treated as missing.
   209	    """
   210	    if session_id is not None:
   211	        val = str(session_id).strip()
   212	        return val
   213	    env_val = os.environ.get("CLAUDE_SESSION_ID", "")
   214	    return env_val.strip()
   215	
   216	
   217	def resolve_plan_id(session_id: Optional[str] = None) -> str:
   218	    """Return the PLAN-NNN currently scoped to the given session.
   219	
   220	    Scans ``audit-log.jsonl`` (via :func:`audit_emit.iter_events`) for
   221	    ``plan_transition`` events whose ``session_id`` matches the argument
   222	    (or ``CLAUDE_SESSION_ID`` env var if the argument is None). Returns
   223	    the ``plan_id`` of the MOST RECENT matching event.
   224	
   225	    Args:
   226	        session_id: explicit session id; if None, pulled from env.
   227	
   228	    Returns:
   229	        The canonical ``PLAN-NNN`` string.
   230	
   231	    Raises:
   232	        PlanIdDerivationError: when no session id is available, when
   233	            the audit log is empty or missing, or when no
   234	            ``plan_transition`` event for the session exists.
   235	
   236	    Notes:
   237	        - **No env-var fallback.** Consensus M2 forbids deriving plan
   238	          id from ``CEO_CURRENT_PLAN`` or similar — those are
   239	          agent-spoofable.
   240	        - "Most recent" is *log order*: the last matching event in
   241	          linear file order wins. Timestamps are not re-sorted because
   242	          audit-log writes are ordered by the shared filelock, and
   243	          re-sorting by ts can tie-break wrong on same-second events.
   244	        - A completed-plan session (``to_status=done``) still resolves
   245	          to that plan; scratchpad clear is an explicit call, not an
   246	          implicit consequence of a terminal transition.
   247	        - **PLAN-179 W1 US3 leaves this function unchanged.** The
   248	          session-scope fallback is a NEW path taken by the CALLER after
   249	          this raises — it is not a loosening of the refusal here. This
   250	          function still never guesses a plan id and still never accepts
   251	          one from the environment.
   252	    """
   253	    sid = _resolve_session_id(session_id)
   254	    if not sid:
   255	        raise PlanIdDerivationError(
   256	            "cannot derive plan_id: no session_id provided and "
   257	            "CLAUDE_SESSION_ID env var is unset. Ensure the hook/CLI "
   258	            "is running in a Claude Code session with a live session id."
   259	        )
   260	
   261	    last_plan_id: Optional[str] = None
   262	    seen_any_transition = False
   263	    for event in _audit_emit.iter_events(action_filter="plan_transition"):
   264	        seen_any_transition = True
   265	        event_sid = str(event.get("session_id") or "")
   266	        if event_sid != sid:
   267	            continue
   268	        pid = event.get("plan_id")
   269	        if isinstance(pid, str) and pid:
   270	            last_plan_id = pid
   271	
   272	    if last_plan_id is None:
   273	        if not seen_any_transition:
   274	            raise PlanIdDerivationError(
   275	                f"cannot derive plan_id: no plan_transition events in "
   276	                f"audit-log for session {sid!r}. Is the audit log empty "
   277	                f"or pointed at the wrong path (CEO_AUDIT_LOG_PATH)?"
   278	            )
   279	        raise PlanIdDerivationError(
   280	            f"cannot derive plan_id: audit-log has plan_transition "
   281	            f"events but none for session {sid!r}. The session may not "
   282	            f"have transitioned a plan yet."
   283	        )
   284	    return last_plan_id
