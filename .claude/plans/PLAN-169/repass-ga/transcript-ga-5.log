   373	def _ceremony_flags(cwd: str, deadline: float) -> List[str]:
   374	    """Pending Owner-GPG ceremonies — executable finish-*.sh newer than the
   375	    last tag (the closeout-guard's signal). Repo-relative, sanitized, sorted,
   376	    bounded. These are POINTERS the operator must act on post-compaction."""
   377	    tag_time = _last_tag_time(cwd, timeout_s=deadline - time.monotonic())
   378	    found = set()
   379	    patterns = (
   380	        os.path.join(cwd, ".claude", "plans", "PLAN-*", "staged", "**", "finish-*.sh"),
   380	        os.path.join(cwd, ".claude", "plans", "PLAN-*", "staged", "**", "finish-*.sh"),
   381	        os.path.join(cwd, "scripts", "local", "finish-*.sh"),
   382	    )
   383	    for pattern in patterns:
   384	        # Rail r22 P2-c: deadline ANTES de cada glob e iteracao LAZY —
   385	        # glob.glob materializava a arvore inteira antes do primeiro
   386	        # check interno e o 2o pattern rodava mesmo apos o break.
   387	        if time.monotonic() > deadline:
   388	            break
   389	        for path in glob.iglob(pattern, recursive=True):
   390	            if time.monotonic() > deadline:
   391	                break
   392	            try:
   393	                if os.access(path, os.X_OK) and os.path.getmtime(path) > tag_time:
   394	                    found.add(
   395	                        _sanitize_text(os.path.relpath(path, cwd), _PATH_CLAMP)
   396	                    )
   397	            except OSError:
   398	                continue
   399	    return sorted(found)[:MAX_CEREMONY_FLAGS]
