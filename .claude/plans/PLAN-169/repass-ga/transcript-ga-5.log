   260	def _resolve_plan_id(event: Dict[str, Any]) -> str:
   261	    """Derive PLAN-NNN from the audit log (NOT env — agent-spoofable).
   262	
   263	    Returns ``unknown`` on any derivation failure (fail-open; the snapshot is
   264	    still written with what we have)."""
   265	    try:
   266	        from _lib import scratchpad_lib  # noqa: E402
   267	    except Exception as exc:  # pragma: no cover — import guard
   268	        _breadcrumb("scratchpad_lib import failed (%s)" % str(exc)[:60])
   269	        return "unknown"
   270	    session_id = None
   271	    sid = event.get("session_id") or event.get("sessionId")
   272	    if isinstance(sid, str) and sid.strip():
   273	        session_id = sid.strip()
   274	    try:
   275	        return scratchpad_lib.resolve_plan_id(session_id)
   276	    except Exception as exc:
   277	        _breadcrumb("plan_id derivation failed (%s)" % str(exc)[:80])
   278	        return "unknown"
