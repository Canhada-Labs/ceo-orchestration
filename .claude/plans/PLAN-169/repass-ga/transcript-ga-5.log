   346	def _memory_delta_rail_state() -> str:
   347	    """Resolve the US8 kill-switch into the CLOSED three-value state.
   348	
   349	    "full" (default — emit event + render the operator line), "quiet"
   350	    (emit event, no systemMessage line), "off" (no-op, nothing emitted).
   351	    Unset / any other value → "full" (SESSIONEND-NOTE.md §3 default-ON)."""
   352	    val = os.environ.get(_MEMORY_DELTA_ENV, "").strip().lower()
   353	    if val in {"0", "false", "off", "no"}:
   354	        return "off"
   355	    if val in {"quiet", "1q"}:
   356	        return "quiet"
   357	    return "full"
