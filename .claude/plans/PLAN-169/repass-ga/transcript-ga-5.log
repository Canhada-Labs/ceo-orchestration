   700	def gate(event: Dict[str, Any]) -> Dict[str, Any]:
   701	    """Read the snapshot, build pointers, reinject via additionalContext.
   702	
   703	    Returns the hookSpecificOutput dict, or ``{}`` when nothing to reinject
   704	    (kill-switch / nothing to say — always allow, never block).
   705	
   706	    PLAN-179 W1-b [r1-C3]: CONSTRAINTS are emitted FIRST, then pointers. The
   707	    two lists are built independently — the pointer cap is applied inside
   708	    ``_build_pointers`` and never sees the constraint lines."""
   709	    if os.environ.get("CEO_COMPACTION_CONTINUITY", "1") == "0":
   710	        return {}
   711	    # Rail round-10 [P1]: uma compactação ACONTECEU — feche a geração de
   712	    # pressão antes de qualquer outra coisa (independe de haver snapshot).
   713	    _clear_pressure_marker(event)
   714	    plan_id = _resolve_plan_id(event)
   715	    # PLAN-179 W1 US3 [r1-C1]: session id from the HOOK INPUT only, for the
   716	    # session-scope fallback read (never CLAUDE_SESSION_ID).
   717	    snapshot = _read_snapshot(plan_id, _session_id(event))
   718	    age_s = _snapshot_age_s(snapshot)
   719	    constraints = _render_constraints()
   720	    pointers = _build_pointers(plan_id, snapshot, age_s)
   721	    # Rail round-8 [P2]: o contador reporta o que foi RENDERIZADO. Quando o
   722	    # render degrada para [] (fail-open em import/raise), reportar o tamanho
   723	    # do SET afirmaria constraints emitidas com additionalContext só de
   724	    # pointers — escondendo exatamente a degradação que o campo existe para
   725	    # expor. Zero a menos que o bloco tenha saído.
   726	    constraint_count = _constraint_count() if constraints else 0
   727	    _emit_reinject_event(
   728	        plan_id, snapshot is not None, age_s, len(pointers), constraint_count
   729	    )
   730	    lines = constraints + pointers
   731	    if not lines:
   732	        return {}
   733	    return {
   734	        "hookSpecificOutput": {
   735	            "hookEventName": "PostCompact",
   736	            "additionalContext": "\n".join(lines),
   737	        }
   738	    }
   739	
