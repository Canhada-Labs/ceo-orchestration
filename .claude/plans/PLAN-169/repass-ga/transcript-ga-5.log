   319	def _execution_unit(plan_path: Optional[str], cwd: str, deadline: float) -> Dict[str, Any]:
   320	    """First unchecked ``- [ ]`` checkbox in the plan file (the active unit).
   321	
   322	    Returns ``{}`` when no plan file / no unchecked unit / budget blown.
   323	    Path is repo-relative + sanitized; label is sanitized + clamped. The
   324	    snapshot records position only — never the plan body."""
   325	    if not plan_path:
   326	        return {}
   327	    try:
   328	        rel = _sanitize_text(os.path.relpath(plan_path, cwd), _PATH_CLAMP)
   329	    except (OSError, ValueError):
   330	        rel = _sanitize_text(plan_path, _PATH_CLAMP)
   331	    try:
   332	        with open(plan_path, encoding="utf-8", errors="replace") as fh:
   333	            for lineno, line in enumerate(fh, start=1):
   334	                if time.monotonic() > deadline:
   335	                    return {}
   336	                stripped = line.lstrip()
   337	                # Unchecked checkbox, tolerant of leading list whitespace.
   338	                if stripped.startswith("- [ ]"):
   339	                    label = stripped[len("- [ ]"):].strip()
   340	                    return {
   341	                        "plan_path": rel,
   342	                        "line": lineno,
   343	                        "label": _sanitize_text(label, _LABEL_CLAMP),
   344	                    }
   345	    except OSError as exc:
   346	        _breadcrumb("plan file read failed (%s)" % str(exc)[:60])
   347	        return {"plan_path": rel}
   348	    # All checkboxes checked (or none): record the file, no active unit.
   349	    return {"plan_path": rel}
