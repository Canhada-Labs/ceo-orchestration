echo '--- validate-governance.sh (user) ---'
( cd "$U" && bash .claude/scripts/validate-governance.sh )
echo '--- assert only .claude/ at top level ---'  # WS4-sc2010-glob
extra=""
for _e in "$U"/* "$U"/.[!.]* "$U"/..?*; do
  [ -e "$_e" ] || continue
  _b="$(basename "$_e")"
  case "$_b" in .claude|.git) continue ;; esac
  extra="$extra $_b"
done
if [ -n "$extra" ]; then
  echo "::error::--ceremony user wrote outside .claude/:$extra"
  exit 1
fi
echo 'user-ceremony leg: PASS'

STEP 18 Install/upgrade parity e2e (maintainer + user ceremony)
set -euo pipefail
bash scripts/tests/test-install-upgrade-parity-e2e.sh

STEP 19 Install/upgrade parity - positive control (planted divergence)
set -uo pipefail
rc=0
bash scripts/tests/test-install-upgrade-parity-e2e.sh \
  --positive-control > /tmp/parity-control.log 2>&1 || rc=$?
if [ "$rc" -ne 1 ]; then
  cat /tmp/parity-control.log
  echo "::error::parity positive control returned rc=$rc, expected 1 - the planted install/upgrade divergence did NOT turn the gate red, so the gate above proves nothing"
  exit 1
fi
# Second factor, LOAD-BEARING (re-pass closure): under `set -uo
# pipefail` (no -e) a non-matching grep would NOT fail the step, so
# an rc=1 from a failure UNRELATED to the plant (log with none of
# the plant markers) would pass — the registered-vacuous class
# (S292) this step exists to close. Demand plant evidence or fail.
# PLAN-169 W3.2 (fecha a exceção nomeada do AC-4 do PLAN-166,
# achado r6-P2): o fator antigo aceitava evidência NÃO-causal —
# qualquer um dos 3 marcadores, mesmo sem o controle ter
# DISPARADO. Exigir a linha que só existe quando o plante
# disparou em TODOS os modos, e nenhum veredito por modo :0/:2.
{ grep -qF 'positive control: FIRED in every mode' /tmp/parity-control.log \
  && ! grep -E 'per-mode verdicts.*:(0|2)' /tmp/parity-control.log >/dev/null; } || {
  cat /tmp/parity-control.log
  echo "::error::rc=1 but the log carries no PLANTED/per-mode-verdict evidence - the control went red for an unrelated reason, which proves nothing about the plant (vacuous control)"
  exit 1
}
echo "positive control OK: planted divergence -> exit 1 in every ceremony mode"

STEP 20 Upgrade SPEC/marker delivery-record ownership (S1-S8)
set -euo pipefail
bash scripts/tests/test-upgrade-spec-ownership.sh

STEP 21 night-mode ignore efficacy (upgrade route + user ceremony)
set -euo pipefail
bash scripts/tests/test-night-mode-ignore-effect.sh

STEP 22 Upgrade historical-adopter delivery (D1 + OQ-5 amendment)
set -euo pipefail
bash scripts/tests/test-upgrade-historical-adopter.sh

STEP 23 Installer write-confinement e2e (F1 symlink/hardlink, F2 CODEOWNERS)
set -euo pipefail
T=scripts/tests/test-installer-write-safety-e2e.sh
if [[ ! -f "$T" ]]; then
  echo "::error::$T is missing — the write-confinement e2e was renamed, moved or deleted. This step must never pass without running it (PLAN-185 AC-3)."
  exit 1
fi
bash "$T"

STEP 24 Upgrade hook-roster derivation (W-E — template is the roster)
set -euo pipefail
bash scripts/tests/test-upgrade-lifecycle-hooks-derived.sh

STEP 25 Assert npx/npm shim contract (if present)
set -euo pipefail
if [[ -d "npm" ]]; then
  # Check no runtime deps
  if [[ -f npm/package.json ]]; then
    deps=$(jq '.dependencies // {} | length' npm/package.json)
    if [[ "$deps" -ne 0 ]]; then
      echo "::error::ceo-orchestration must ship with 0 runtime deps (got $deps)"
      exit 1
    fi
    echo "OK: npm shim has zero runtime dependencies"
  fi
else
  echo "npm/ shim not yet present — skipping"
fi


