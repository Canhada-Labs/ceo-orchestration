   188	concurrency:
   189	  group: smoke-install-${{ github.ref }}
   190	  cancel-in-progress: true
   191	
   192	jobs:
   193	  smoke:
   194	    # PLAN-012 Phase 2 CEO_SOTA_DISABLE parity.
   195	    if: vars.CEO_SOTA_DISABLE != '1'
   196	    runs-on: ubuntu-latest
   197	    # PLAN-161: 5 -> 8 — headroom for the two upgrade oracles (each runs
   198	    # full install + upgrade legs against fixture adopter repos).
   199	    # PLAN-166 F4: 8 -> 20. MEASURED, not guessed. The parity e2e runs 2 full
   200	    # install legs + 1 upgrade leg PER ceremony mode, and the positive control
   201	    # runs the same again with a planted divergence: 12 install/upgrade
   202	    # operations added to this job. Local wall time (Darwin arm64, 16 cores,
   203	    # 2026-08-05): gate 122s + control 118s = 240s. A 2-core ubuntu-latest
   204	    # runner is the usual 2-3x slower, i.e. 8-12 min of NEW work on top of the
   205	    # ~5 min this job already spent. 15 would sit inside the noise band, and
   206	    # the perf-gate N=20 flake (PLAN-159) was exactly that mistake. Re-tighten
   207	    # once real CI runs give a p95.
   208	    # PLAN-166 F3 (assembler): 20 -> 25. The spec-ownership e2e adds 4 more
   209	    # installs + 3 upgrades (S1-S8; ~3-4 min local per the W1-C measurement),
   210	    # i.e. up to ~8-10 more CI minutes at the same 2-3x factor. Same
   211	    # anti-flake sizing rule as the F4 bump above.
   212	    # PLAN-177 W1 (CF-9): 25 -> 32. The night-mode efficacy e2e adds 3 installs
   213	    # + 2 upgrades. MEASURED, not guessed: 2m06s wall on Darwin arm64 (16
   214	    # cores, 2026-08-13), reproduced across two runs. At the same 2-3x runner
   215	    # factor this workflow already sizes with, that is 4-7 CI minutes, so +7.
   216	    # A job-level timeout that clips a green run reports as `cancelled` on an
   217	    # innocent step (the S2xx lesson), so the margin stays deliberate.
   218	    # PLAN-183 W5 (D1 + OQ-5): 32 -> 50. The historical-adopter e2e adds 2
   219	    # installs + 8 full upgrades (six independent adopter fixtures; the two
   220	    # installs are cached and cp -R'd, the upgrades cannot be). MEASURED, not
   221	    # guessed: 357 s wall on Darwin arm64 under concurrent load, 2026-08-24
   222	    # (372 s for the uncached version — the machine was contended, so treat
   223	    # these as an upper bound, not a p50). At the same 2-3x runner factor this
   224	    # file already sizes with, that is 12-18 CI minutes of NEW work, so +18.
   225	    # The `if: always()` steps below also mean a RED main gate no longer ends
   226	    # the job early: the worst case now runs every step, which is the point.
   227	    # rail round-1 (F2 + F5): 50 -> 58. The two new legs of that e2e — H.12
   228	    # (an unclaimed rendered CODEOWNERS must suppress the .template route, on
   229	    # the first upgrade AND the second) and H.13 (a poisoned route row is
   230	    # refused and NOTHING lands outside $TARGET) — add TWO cached fixtures
   231	    # (cp -R, cheap) and THREE more full upgrades: 8 -> 11.
   232	    # MEASURED, not extrapolated from the count: 9m12s wall on Darwin arm64
   233	    # for the 11-upgrade version while a second e2e lane ran concurrently
   234	    # (2026-08-24) — an upper bound under deliberate contention, against the
   235	    # 357 s the 8-upgrade version measured. Scaling the solo figure by the
   236	    # upgrade count gives ~491 s, i.e. ~+2.2 min solo, which at the same 2-3x
   237	    # runner factor is +5-7 CI minutes, so +8 with the anti-flake margin this
   238	    # file's doctrine requires.
   239	    # The deepen step and the delivery-route oracle added below are seconds
   240	    # and are not what moved this number.
   241	    # rail round-2 (F2 + F3 + F4): 58 -> 68. Two sources, both MEASURED on
   242	    # Darwin arm64 (2026-08-24), neither extrapolated from a count:
   243	    #   (a) the historical e2e went 11 -> 13 upgrades (H.14 runs a real
   244	    #       `--pin v1.3.0` upgrade against a throwaway source repo it builds
   245	    #       from two `git archive` extractions — 7 s; H.15 adds one more
   246	    #       upgrade against a hostile route table). 552 s -> 650 s wall under
   247	    #       comparable contention, i.e. +98 s solo => +3-5 CI minutes at the
   248	    #       2-3x runner factor this file sizes with.
   249	    #   (b) the doctor delivery-route oracle wired below: 104 s wall, 59
   250	    #       assertions => +4-5 CI minutes at the same factor.
   251	    # +10 with the anti-flake margin this file's doctrine requires: a
   252	    # job-level timeout that clips a GREEN run surfaces as `cancelled` on an
   253	    # innocent step (the S2xx lesson). Re-tighten on a real CI p95, never on
   254	    # arithmetic.
   255	    # PLAN-185 W1+W2 (AC-3): 68 -> 83. The installer write-confinement e2e
   256	    # wired below runs ~13 real installs across an F0 unit section plus 15
   257	    # e2e fixtures. MEASURED on Darwin arm64, 2026-08-26 — TWO runs, because
   258	    # the first one is not a p50 and saying so matters more than a tidy
   259	    # number: 2m49s at 87% CPU (62 assertions), then 4m42s at 55% CPU (63
   260	    # assertions, file sha256 83e8ed3c…) with another night-run lane doing
   261	    # its own installs. Same suite, 1.7x spread — the machine, not the test.
   262	    # Sized on the UPPER bound: 282 s x the 2-3x runner factor this file
   263	    # already uses = 9-14 CI minutes of NEW work, so +15 with the anti-flake
   264	    # margin the doctrine above requires. Re-tighten on a real CI p95, never
   265	    # on arithmetic — and never on the faster of two local runs.
   266	    # PLAN-169 W-E (S329, rail rounds 1-3): 83 -> 126. The hook-roster
   267	    # derivation e2e wired below is a whole new e2e, not a leg on an existing
   268	    # one: 11 adopter fixtures (one real install, ten cp -R from the cache)
   269	    # and 15 full upgrades, two of them --dry-run.
   270	    # MEASURED on Darwin arm64, 2026-08-26, 51 assertions, rc=0 — and measured
   271	    # TWICE on purpose, because the two numbers disagree by 45%:
   272	    #   854 s  SOLO   <- the basis for this budget
   273	    #   1233 s with a second full e2e lane running concurrently
   274	    # The blocks above size from contended figures and call them upper bounds;
   275	    # doing that here would have compounded two pessimisms, so the solo run is
   276	    # the basis and the contended one is recorded as the observed spread. At
   277	    # the 2-3x runner factor this file sizes with, 854 s is 28-43 CI minutes of
   278	    # NEW work; +43 takes the top of that range and adds the anti-flake margin.
   279	    # (An earlier revision of this block read 101, sized from the 649 s the
   280	    # 12-upgrade version measured UNDER CONTENTION — lower than the solo figure
   281	    # of the 15-upgrade version, i.e. too tight. Left visible because "a
   282	    # contended measurement is not automatically the conservative one" is the
   283	    # part that was counter-intuitive.)
   284	    # NOTE the asymmetry this file keeps re-learning: over-sizing costs
   285	    # nothing on a green run, while under-sizing reports as `cancelled` on an
   286	    # innocent step. The FIRST real CI run of this step is the number that
   287	    # should replace this estimate — re-tighten on that p95, never on
   288	    # arithmetic.
   289	    # RE-DERIVED on the S329 morning, per item: this block was written as
   290	    # 68 -> 111 against a base that PLAN-185 W1+W2 had meanwhile taken to 83
   291	    # (its own e2e, +15, landed first in cc00235). The two e2e are ADDITIVE
   292	    # in this one job, so E's +43 lands on 83, not on 68: 126. Composing
   293	    # by taking the larger of the two (111) would have under-sized the job
   294	    # by exactly the PLAN-185 step — the `cancelled`-on-an-innocent-step
   295	    # class the doctrine above exists to prevent.
   296	    # PLAN-186 W4a (S343): 126 -> 150 — the first number in this block
   297	    # sized on MEASURED wall instead of on additive step arithmetic. Every
   298	    # block above composes per-step estimates; the samples below give an
   299	    # observed RANGE for this job, which the arithmetic never had. They do
   300	    # NOT say what causes the spread — see the note under the table.
   301	    # Instrument: wall of the JOB `smoke` (startedAt -> completedAt), which
   302	    # is what `timeout-minutes` gates. The RUN wall is 1-5 min longer and is
   303	    # NOT the right instrument — an earlier note in the project memory read
   304	    # `1h32` off a RUN, which is the same run measured as 92m32s here.
   305	    # Read with `gh run view <id> --json jobs`, seven most recent GREEN runs
   306	    # of this workflow, newest first (2026-09-03):
   307	    #   33809424817  92m32s   35f33a8
   308	    #   33743649231  90m40s   ba15c71
   309	    #   33630753302  77m53s   8efe09b
   310	    #   33582381725  87m50s   f0e98de
   311	    #   33503515412  86m52s   b7dad83
   312	    #   33388608651  86m44s   826688f
   313	    #   33364620284  73m18s   f348ee9
   314	    # min 73m18s, max 92m32s. What that establishes is the observed RANGE
   315	    # and nothing more: the seven runs share this workflow definition but
   316	    # NOT the executed workload — 826688f changed
   317	    # scripts/tests/smoke-install.sh; ba15c71 changed scripts/doctor.sh and
   318	    # the installer write-safety e2e; this job invokes all of them.
   319	    # Attributing the spread to the RUNNER would need repeated runs at ONE
   320	    # sha, which nobody has done. So this block sizes on the observed
   321	    # maximum and claims no cause. (The runner-variance class is real in
   322	    # this repo — S327: the hook-latency gate measured 77 ms locally and
   323	    # 209-435 ms in CI on the SAME sha — but that is a precedent, not
   324	    # evidence about these seven numbers.)
   325	    # 126 leaves 33m28s over the observed max (1.36x); 150 leaves 57m28s
   326	    # (1.62x). The house rule fires below 20% headroom and 126 was still
   327	    # ABOVE it at 26.6% — so the trigger that fired is not that one. The
   328	    # S336 deferral (Owner, 2026-09-01) named three, and this is the third:
   329	    # the next wave that already touches `.github/workflows/` takes the bump
   330	    # along at ~zero marginal cost. That wave is PLAN-186 W4a.
   331	    # What is deliberately NOT claimed: this is not a prediction that the
   332	    # job will take 150 minutes, and the W4a deletion riding in the same
   333	    # patch touches `validate.yml`, not this job — no number here is
   334	    # adjusted for it. Re-tighten on a real CI p95 with >= 3 further
   335	    # samples, never on arithmetic (AGENTS.md:9-11: this file records
   336	    # measurements and subtractions, never speed claims).
   337	    timeout-minutes: 150
   338	    permissions:
   339	      contents: read
   340	    steps:
   341	      - name: Checkout
   342	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   343	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   344	        with:
   345	          fetch-depth: 1
   346	
   347	      # PLAN-169 W2.8 (ADR-192, route (b)-narrow) — gate-scripts integrity.
   348	      # Same canonical manifest as release.yml: the free scripts whose
   349	      # verdict this gate consumes (validate-governance.sh here) must match
   350	      # .claude/governance/gate-scripts-manifest.txt or the run fails loudly
   351	      # BEFORE any member is invoked. Residual (documented in ADR-192):
   352	      # the parity step later runs the INSTALLED copy of
   353	      # validate-governance.sh inside the target — that copy is delivered
   354	      # from this verified repo copy by install.sh in this same run.
   355	      - name: Gate-scripts integrity (W2.8 checksum manifest)
   356	        run: |
   357	          set -euo pipefail
   358	          M=.claude/governance/gate-scripts-manifest.txt
   359	          [[ -f "$M" ]] || { echo "::error::$M missing (W2.8 canonical manifest)"; exit 1; }
   360	          shasum -a 256 -c "$M" \
   361	            || { echo "::error::gate-script drift vs $M (ADR-192) — member edits go through the canonical-edit ceremony"; exit 1; }
   362	          echo "OK: all gate scripts match $M"
   363	
   364	      # PLAN-166 F4: the parity e2e's historical leg installs from a PINNED
   365	      # TAG. `fetch-depth: 1` produces a checkout with NO tags, so the pin
   366	      # would not resolve and the gate would die before comparing a single
   367	      # tree - "it passes on my clone" is precisely the hole this test exists
   368	      # to close. The pin is READ FROM THE TEST (--print-pin) so the workflow
   369	      # never becomes a second copy of that truth.
   370	      - name: Fetch the parity pin tag
   371	        run: |
   372	          set -euo pipefail
   373	          PIN="$(bash scripts/tests/test-install-upgrade-parity-e2e.sh --print-pin)"
   374	          echo "parity historical pin: $PIN"
   375	          git fetch --no-tags --depth 1 origin "+refs/tags/$PIN:refs/tags/$PIN"
   376	          git rev-parse --verify "refs/tags/$PIN^{commit}"
   377	          # S313: the schema-generation pin guard derives the set of prior
   378	          # schema generations from EVERY release tag (the set an adopter
   379	          # could have installed). Depth-1 per tag — a handful of trees.
   380	          git fetch --no-tags --depth 1 origin "+refs/tags/v*:refs/tags/v*"
   380	          git fetch --no-tags --depth 1 origin "+refs/tags/v*:refs/tags/v*"
   381	          echo "release tags fetched: $(git tag -l 'v[0-9]*' | wc -l)"
   382	
   383	      - name: Setup Python 3.11
   384	        # SHA-pinned (Sprint 7 Dependabot bump): actions/setup-python@v6.2.0
   385	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405
   386	        with:
   387	          python-version: "3.11"
   388	
   389	      - name: Install jq (for settings.json merge)
   390	        run: |
   391	          set -euo pipefail
   392	          if ! command -v jq >/dev/null 2>&1; then
   393	            sudo apt-get update -qq
   394	            sudo apt-get install -y -qq jq
   395	          fi
   396	          jq --version
   397	
   398	      # PLAN-168 W1 (AC-4, per-PR half): the DECISION oracle —
   399	      # _ownership_verdict() against every truth-table cell, in milliseconds.
   400	      # The OBSERVATION half (the ~25-min e2e) runs in ownership-nightly.yml;
   401	      # this fast half is what makes table/harness PRs cheap to gate.
   402	      - name: Ownership verdict unit oracle (milliseconds)
   403	        run: |
   404	          set -euo pipefail
   405	          bash scripts/tests/test-ownership-verdict-unit.sh
   406	
   407	      # rail round-1 F6 — the delivery-route resolution oracle for the
   408	      # CANONICAL manifest generator (D3). Measured S327: this test was
   409	      # referenced by NOTHING but itself, so its independent
   410	      # installer-versus-table truth derivation and its malformed-row /
   411	      # escaping-row controls never executed in CI. Seconds to run, no
   412	      # network, mktemp -d only.
   413	      # `if: always()` for the PLAN-183 §9.8 reason: it is the instrument that
   414	      # certifies the route table the delivery steps below depend on, so it is
   415	      # exactly the step that must not report `skipped` when something earlier
   416	      # in the job is red.
   417	      - name: Delivery-route resolution oracle (manifest generator, D3)
   418	        if: always()
   419	        run: |
   420	          set -euo pipefail
   421	          bash scripts/tests/test-manifest-delivery-route.sh
   422	
   423	      # rail round-2 F4 — the OTHER canonical consumer of the same table.
   424	      # Measured S327: `grep -r test-doctor-delivery-route.sh .github/` = 0, so
   425	      # doctor.sh's route resolution, its restore/`--repair` confinement cases
   426	      # and the anti-rot assertions that no private parser grew back had NO CI
   427	      # execution at all — the D4 contamination leak (the maintainer's live
   428	      # .github/CODEOWNERS copied into an adopter tree) is exactly what these
   429	      # 59 assertions detect, and nothing was running them.
   430	      # ~107 s local (Darwin arm64) — cheap enough for per-PR, unlike the
   431	      # install-baseline manifest suite, which went to ownership-nightly.yml.
   432	      # `if: always()` for the same PLAN-183 §9.8 reason as the step above: it
   433	      # certifies the table the delivery steps below depend on.
   434	      - name: Delivery-route resolution oracle (doctor restore/repair, D4)
   435	        if: always()
   436	        run: |
   437	          set -euo pipefail
   438	          bash scripts/tests/test-doctor-delivery-route.sh
   439	
   440	      # Re-pass rc.4 t7 P2 (t6 condition 5): the gitignore symlink-refusal +
   441	      # dry-run preview unit is seconds — run it per-PR. The full
   442	      # install-state replay (B2 pre-state ceremony persistence + B2-c3/c4
   443	      # schema-refresh, --skip and symlink-refusal legs) is many minutes of
   444	      # real installs and runs in ownership-nightly.yml instead.
   445	      - name: Gitignore symlink + dry-run preview unit (t7)
   446	        run: |
   447	          set -euo pipefail
   448	          bash scripts/tests/test-gitignore-symlink-and-dryrun-unit.sh
   449	
   450	      # S313: upgrade.sh refreshes the plans/ schema docs HASH-GATED against
   451	      # a hand-written list of prior generations. A schema edit that forgets
   452	      # to append the replaced generation's hash leaves every adopter on it
   453	      # STALE (the parity e2e went red on 996d72b for exactly this). The
   454	      # guard derives the generation set from the release tags fetched
   455	      # above (+ history when available) — zero enumerable generations is a
   456	      # scaffold FAILURE (exit 2), never a green skip.
   457	      - name: Schema-doc prior-generation pins are complete (S313 guard)
   458	        run: |
   459	          set -euo pipefail
   460	          bash scripts/tests/test-schema-generation-pins-unit.sh
   461	
   462	      # PLAN-168 W1 (rail r3 P1): the nightly gate's fake-harness control is
   463	      # milliseconds — run it per-PR so a PR touching the gate cannot break
   464	      # its rc/status handling while PR checks stay green.
   465	      - name: Ownership nightly-gate positive control (fake harness)
   466	        run: |
   467	          set -euo pipefail
   468	          bash scripts/tests/test-ownership-nightly-gate.sh
   469	
   470	      # PLAN-183 W5 fix (S327b, measured in smoke run 32845976930): this deepen
   471	      # step MUST run BEFORE the parity e2e, not only before the historical e2e.
   472	      # The D1 hash-gate in upgrade.sh recognises an adopter file as framework-
   473	      # owned by matching it against the git GENERATIONS of the template SOURCE;
   474	      # with the depth-1 checkout the v1.2.0 generation is invisible, the three
   475	      # templates that diverged (docs/BRANCH-PROTECTION.md and the two workflow
   476	      # .template files) fall to PRESERVED, and the classifier reports STALE 3 —
   477	      # locally, with full history, the same tree measures STALE 0. Safe but
   478	      # blind: a shallow SOURCE never delivers wrong bytes, it just cannot see.
   479	      # `actions/checkout` above runs at `fetch-depth: 1` and the later fetches
   480	      # are `--depth 1` TAG fetches, so `git log -- <path>` sees exactly ONE
   481	      # commit: the H.3 fixture can find no PRIOR generation of
   482	      # templates/docs/BRANCH-PROTECTION.md and the test scaffold-errors on
   483	      # every run.
   484	      # MEASURED (S327, this repo): that template has TWO generations — the
   485	      # current one landed at depth 40, the only differing one is the ROOT
   486	      # commit at depth 502 of 503 total. There is therefore no honest
   487	      # `--deepen=<N>` short of the whole history, so this unshallows: 503
   488	      # commits / 43 MB of .git, seconds against a 50-minute job.
   489	      # `--no-tags` keeps the explicit pin/release tag fetches above
   490	      # authoritative over which tags this checkout holds.
   491	      # `if: always()` is NOT optional here: the step it feeds carries
   492	      # always(), so without it a red earlier step would skip the deepen and
   493	      # run the e2e shallow — turning the cure back into the finding.
   494	      - name: Deepen git history (parity + historical-adopter e2e need prior generations)
   495	        if: always()
   496	        run: |
   497	          set -euo pipefail
   498	          if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
   499	            git fetch --unshallow --no-tags
   500	            echo "unshallowed: $(git rev-list --count HEAD) commits now reachable"
   501	          else
   502	            echo "already complete: $(git rev-list --count HEAD) commits reachable"
   503	          fi
   504	          # Fail CLOSED if the deepen did not actually produce what the e2e
   505	          # needs. A green step here followed by a scaffold error there would
   506	          # point the blame at the test instead of at this step.
   507	          gens="$(git log --format=%H -- templates/docs/BRANCH-PROTECTION.md | wc -l | tr -d ' ')"
   508	          echo "generations of templates/docs/BRANCH-PROTECTION.md: $gens"
   509	          if [ "$gens" -lt 2 ]; then
   510	            echo "::error::history deepen did not expose a prior generation (gens=$gens); the historical-adopter e2e cannot run" >&2
   511	            exit 1
   512	          fi
   513	
   514	      # PLAN-168 W2 (AC-6, per-PR half of INV-4): the shared pointer
   515	      # generator's 8-scenario control — includes ONE real install (~1-2 min
   516	      # on CI iron). The full install->upgrade->cure e2e (4 legs, ~5 min CI)
   517	      # is nightly-only; MEASURED per the smoke budget notes above.
   518	      - name: Protocol pointer render control (generator parity)
   519	        run: |
   520	          set -euo pipefail
   521	          bash scripts/tests/test-protocol-pointer-render.sh
   522	
   523	      - name: Run smoke install
   524	        run: |
   525	          set -euo pipefail
   526	          bash scripts/tests/smoke-install.sh
   527	
   528	      # PLAN-161 upgrade oracles (green only once the U1/U2/U3 upgrade.sh
   529	      # fixes are in-tree — land atomically with them).
   530	      - name: Upgrade oracle — --dry-run identity (U1)
   531	        run: |
   532	          set -euo pipefail
   533	          bash scripts/tests/test-upgrade-dryrun-identity.sh
   534	
   535	      - name: Upgrade oracle — exclusion parity + opt-in purge (U2/U3)
   536	        run: |
   537	          set -euo pipefail
   538	          bash scripts/tests/test-upgrade-exclusions.sh
   539	
   540	      # WS4-user-ceremony-leg
   541	      - name: Install with --ceremony user (governance rc=0 + no out-of-.claude writes)
   542	        run: |
   543	          set -euo pipefail
   544	          U="$(mktemp -d)"
   545	          ( cd "$U" && git init -q )
   546	          CEO_INSTALL_SKIP_SELF_SHA=1 CEO_RAG_INSTALL_PROMPT=0 \
   547	            bash scripts/install.sh "$U" --ceremony user
   548	          echo '--- validate-governance.sh (user) ---'
   549	          ( cd "$U" && bash .claude/scripts/validate-governance.sh )
   550	          echo '--- assert only .claude/ at top level ---'  # WS4-sc2010-glob
   551	          extra=""
   552	          for _e in "$U"/* "$U"/.[!.]* "$U"/..?*; do
   553	            [ -e "$_e" ] || continue
   554	            _b="$(basename "$_e")"
   555	            case "$_b" in .claude|.git) continue ;; esac
   556	            extra="$extra $_b"
