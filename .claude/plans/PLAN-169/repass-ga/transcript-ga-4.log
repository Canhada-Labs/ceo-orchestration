   173	      # It installs at the PIN, so it also depends on the parity e2e
   174	      # (--print-pin) and on the .gitignore generator in the manifest lib,
   175	      # both already in this list.
   176	      - "scripts/tests/test-night-mode-ignore-effect.sh"
   177	      # t8 P2: the efficacy test hardcodes the paths night-mode.py emits —
   178	      # a PR changing only the emitter must light this gate up too.
   179	      - ".claude/scripts/night-mode.py"
   180	      - "templates/**"
   180	      - "templates/**"
   181	      - "SPEC/v1/**"
   182	      - "scripts/doctor.sh"
   183	      - ".claude/.framework-version"
   184	      - ".claude/scripts/check-framework-updates.sh"
   185	      - ".github/workflows/smoke-install.yml"
   186	      - ".claude/hooks/**"
