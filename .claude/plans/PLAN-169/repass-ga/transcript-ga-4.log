    82	on:
    83	  push:
    84	    tags:
    85	      - "v*"
    86	
    87	concurrency:
    88	  group: npm-publish-${{ github.ref }}
    89	  cancel-in-progress: false
    90	
    91	permissions:
    92	  contents: read
    93	  id-token: write   # required for OIDC trusted publishing + provenance
    94	
    95	jobs:
    96	  # ---------------------------------------------------------------------
    97	  # PLAN-166 W1 item 1 (F1, P0) — OBSERVE THE GOVERNANCE GATE.
    98	  # This job is the machine evidence that release.yml's `release-gate`
    99	  # job passed for this exact tag+SHA+push. It deliberately carries NO
   100	  # `environment:` and NO RC exclusion: it runs on rc tags too, which
   101	  # makes every RC a live positive control of the gate before GA ever
   102	  # depends on it.
   103	  # Decision function + battery: .claude/scripts/await_release_gate.py,
   104	  # .claude/scripts/tests/test_await_release_gate.py.
   105	  await-release-gate:
   106	    name: Await release-gate (release.yml)
   107	    runs-on: ubuntu-latest
   108	    # 50 > the poller's own 45-minute deadline, so a timeout surfaces as
   109	    # the decision function's fail-CLOSED BLOCK (with its inputs printed),
   110	    # not as an opaque runner kill. 45 min > the release-gate's own
   111	    # 35-minute timeout-minutes with margin (rail rc.3 r1 P1-3): the
   112	    # observer must always outlive the producer, or a gate finishing in
   113	    # minutes 31-35 goes green while the waiter already gave up.
   114	    timeout-minutes: 50
   115	    permissions:
   116	      contents: read   # checkout the tag to get the decision script
   117	      actions: read    # read release.yml's runs + jobs over the REST API
   118	    env:
   119	      # `permissions:` alone does NOT authenticate the `gh` CLI on a
   120	      # hosted runner. Without GH_TOKEN every poll dies on auth, which is
   121	      # BLOCK (fail-closed) — i.e. it would break EVERY release, RC and
   122	      # GA alike. This token is the job's only credential; the job has no
   123	      # id-token and no environment.
   124	      GH_TOKEN: ${{ github.token }}
   125	    steps:
   126	      - name: Checkout tag
   127	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   128	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   129	
   130	      # PLAN-169 W2.8 (ADR-192; pair-rail S300 r3 P1-1) — the program
   131	      # this job uses to WAIT for the release gate is itself a free
   132	      # script. Verifying the manifest only in release.yml is not
   133	      # enough: a drifted await_release_gate.py that fake-GRANTs would
   134	      # reach the production-npm approval while release.yml fails in
   135	      # parallel. Fail-closed BEFORE the script runs.
   136	      - name: Gate-scripts integrity (W2.8 checksum manifest)
   137	        run: |
   138	          set -euo pipefail
   139	          M=.claude/governance/gate-scripts-manifest.txt
   140	          [[ -f "$M" ]] || { echo "::error::$M missing (W2.8 canonical manifest)"; exit 1; }
   141	          shasum -a 256 -c "$M" \
   142	            || { echo "::error::gate-script drift vs $M (ADR-192) — member edits go through the canonical-edit ceremony"; exit 1; }
   143	          echo "OK: all gate scripts match $M"
   144	
   145	      - name: Poll release.yml until release-gate concludes
   146	        # No `${{ }}` interpolation inside this script by design — every
   147	        # value arrives through the environment, so no workflow expression
   148	        # is ever spliced into shell text.
   149	        run: |
   150	          set -euo pipefail
   151	          TAG="${GITHUB_REF_NAME}"
   152	          DEADLINE=$(( $(date +%s) + 2700 ))
   153	          SELF_CREATED_AT="$(gh api \
   154	            "repos/${GITHUB_REPOSITORY}/actions/runs/${GITHUB_RUN_ID}" \
   155	            --jq '.created_at' < /dev/null)"
   156	          echo "inputs: tag=${TAG} head_sha=${GITHUB_SHA} run_id=${GITHUB_RUN_ID}"
   157	          echo "inputs: self_created_at=${SELF_CREATED_AT} deadline_epoch=${DEADLINE}"
   158	
   159	          fetch_payload() {
   160	            # One document: every run for THIS head_sha, each carrying its
   161	            # jobs. A run whose jobs endpoint is unreadable keeps no `jobs`
   162	            # key — the decision function reads that as WAIT, never GRANT.
   163	            if ! gh api --paginate \
   164	                "repos/${GITHUB_REPOSITORY}/actions/runs?head_sha=${GITHUB_SHA}&per_page=100" \
   165	                --jq '.workflow_runs[] | {id, run_attempt, path, event, head_branch, head_sha, created_at, status, conclusion}' \
   166	                > runs.ndjson < /dev/null; then
   167	              # An API error is BLOCK by design (ADR-186: input we cannot
   168	              # verify is blocked, not waved through).
   169	              echo '{"api_error": "runs listing failed"}' > payload.json
   170	              return 0
   171	            fi
   172	            : > runs_with_jobs.ndjson
   173	            while read -r run; do
   174	              [ -n "${run}" ] || continue
   175	              rid="$(printf '%s' "${run}" | jq -r '.id')"
   176	              if ! run_jobs="$(gh api \
   177	                  "repos/${GITHUB_REPOSITORY}/actions/runs/${rid}/jobs?per_page=100" \
   178	                  --jq '[.jobs[] | {name, status, conclusion}]' < /dev/null)"; then
   179	                printf '%s\n' "${run}" >> runs_with_jobs.ndjson
   180	                continue
   181	              fi
   182	              printf '%s' "${run}" \
   183	                | jq -c --argjson jobs "${run_jobs}" '. + {jobs: $jobs}' \
   184	                >> runs_with_jobs.ndjson
   185	            done < runs.ndjson
   186	            jq -c -s '{workflow_runs: .}' runs_with_jobs.ndjson > payload.json
   187	          }
   188	
   189	          attempt=0
   190	          while true; do
   191	            attempt=$(( attempt + 1 ))
   192	            fetch_payload
   193	            set +e
   194	            python3 .claude/scripts/await_release_gate.py \
   195	              --payload-file payload.json \
   196	              --tag "${TAG}" \
   197	              --head-sha "${GITHUB_SHA}" \
   198	              --self-created-at "${SELF_CREATED_AT}" \
   199	              --deadline-epoch "${DEADLINE}"
   200	            rc=$?
   201	            set -e
   202	            case "${rc}" in
   203	              0)
   204	                echo "::notice::release-gate green for ${TAG} at ${GITHUB_SHA} — publish authorised (poll ${attempt})"
   205	                exit 0
   206	                ;;
   207	              3)
   208	                sleep 20
   209	                ;;
   210	              *)
   211	                echo "::error::release-gate did not authorise this publish (decision exit ${rc}, poll ${attempt}) — the printed inputs above name the run and job that were evaluated"
   212	                exit 1
   213	                ;;
   214	            esac
   215	          done
   216	
   217	  publish:
   218	    # PLAN-013 Phase 0 item 0.2 — RC tag guard.
   219	    # RC tags contain `-rc.` (e.g. `v1.4.0-rc.1`). Skip them entirely.
   220	    # Only GA tags (`v1.4.0`) proceed, and those gate through the
   221	    # `production-npm` environment (manual approval).
   222	    # PLAN-153 Wave B item 5 (f): RC posture UNCHANGED — this exclusion
   223	    # is load-bearing (PLAN-013 anti-goals #3/#16) and MUST survive any
   224	    # future edit to this file; the draft `next` dist-tag idea was
   225	    # DROPPED by ratified debate. Pinned by
   226	    # .claude/scripts/tests/test_release_workflow_asserts.py.
   227	    if: "!contains(github.ref, '-rc.')"
   228	    # PLAN-166 W1 item 1: publish only starts after `await-release-gate`
   229	    # proved release.yml's release-gate job green for this exact tag+SHA
   230	    # (default `success()` semantics of `needs:` — an await failure skips
   231	    # this job while the run itself goes red). Deliberate ordering: the
   232	    # production-npm manual-approval prompt appears only AFTER the gate
   233	    # is green. The `already_published` guard stays below, in this job.
   234	    needs: await-release-gate
   235	    runs-on: ubuntu-latest
   236	    environment: production-npm
   237	    timeout-minutes: 8
   238	    steps:
   239	      - name: Checkout tag
   240	        # SHA-pinned (Sprint 7 Dependabot bump): actions/checkout@v6.0.2
   241	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
   242	        with:
   243	          fetch-depth: 0
   244	
   245	      - name: Setup Node 20
   246	        # SHA-pinned: actions/setup-node@v4.1.0
   247	        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e
   248	        with:
   249	          node-version: "20"
   250	          registry-url: "https://registry.npmjs.org"

