+    def test_a_well_formed_template_still_merges(self) -> None:
+        """The control: the guard must not refuse valid templates."""
+        self._bad([{"matcher": "Bash",
+                    "hooks": [{"type": "command", "command": "bash h.sh check_x.py"}]}])
