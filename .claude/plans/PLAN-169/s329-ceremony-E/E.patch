+        )
+        appended = res["hooks"]["PreToolUse"][-1]
+        self.assertEqual([h["command"] for h in appended["hooks"]], ["bash h.sh check_b.py"])
+
+    def test_a_fully_present_block_is_a_no_op(self) -> None:
