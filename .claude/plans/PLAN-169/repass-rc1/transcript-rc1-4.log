  2911	                    _HMAC_AVAILABLE
  2912	                    and event.get("hmac")
  2913	                    and not _audit_hmac.is_disabled()
  2914	                ):
  2915	                    try:
  2916	                        _audit_hmac.write_last_hmac(
  2917	                            _audit_hmac.from_hex(event["hmac"])
  2918	                        )
  2919	                    except _audit_hmac.AuditHmacError:
  2920	                        pass  # next read falls back to genesis
  2921	
  2922	                # PLAN-044 audit-v2 C6-P0-03 fix: wire chain-length canary
  2923	                # increment under same FileLock, after the JSON line is
  2924	                # already on disk + last_hmac persisted. Detection aid for
