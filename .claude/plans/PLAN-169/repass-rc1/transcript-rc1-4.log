  2374	def _log_family_dir() -> Path:
  2375	    """Return the dir the lock/errors sidecars must share with the LOG.
  2376	
  2377	    PLAN-182 W1 family-atomicity cure (ADR-001 S318 amendment item 3):
  2378	    when ``CEO_AUDIT_LOG_PATH`` moves the log, the lock and errors
  2379	    FOLLOW its parent instead of staying on the default dir — the W0
  2380	    matrix measured that split leaving two projects with distinct logs
  2381	    serializing on one lock. ``.resolve().parent`` matches
  2382	    ``audit_hmac._audit_dir_from_env`` byte-for-byte so key, lock and
  2383	    errors co-locate under the same derivation.
  2384	    """
  2385	    env = os.environ.get("CEO_AUDIT_LOG_PATH")
  2386	    if env:
  2387	        return Path(env).resolve().parent
  2388	    return _audit_dir()
