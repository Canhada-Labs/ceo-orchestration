 10966	# ---------------------------------------------------------------------
 10967	# PLAN-078 Wave 1+2 — typed advisory emitters.
 10968	# Both share the `_scrub_ceo_boot_event` allowlist-agnostic helper.
 10969	# Caller-side fail-open is the responsibility of the call site (hook /
 10970	# detector); these wrappers themselves never raise, but if `_write_event`
 10971	# under their hood encounters an exception it breadcrumbs + returns.
 10972	# ---------------------------------------------------------------------
 10973	
 10974	
 10975	def _to_basis_points(value: Any, *, lo: int = 0, hi: int = 1_000_000) -> int:
 10976	    """Convert a float multiplier to integer basis-points (×1000), clamped.
 10977	
 10978	    Codex W1+W2 fix-pack #2: HMAC chain requires int (canonical_json forbids
 10979	    floats). Multiplier 1.234 → 1234 bp. NaN/inf → 0. Negatives → 0.
 10980	    Clamped to [lo, hi] to bound on-disk size + downstream consumers.
 10981	    """
 10982	    try:
 10983	        f = float(value)
 10984	    except (TypeError, ValueError):
 10985	        return lo
 10986	    # Reject NaN / inf (canonical_json bans these too).
 10987	    if f != f or f in (float("inf"), float("-inf")):
 10988	        return lo
 10989	    bp = int(round(f * 1000.0))
 10990	    if bp < lo:
 10991	        return lo
 10992	    if bp > hi:
 10993	        return hi
 10994	    return bp
 10995	
