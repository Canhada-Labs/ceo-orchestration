 11333	# PLAN-081 Phase 1-full / R1 S-Sec-5 — Codex ingress sanitization audit
 11334	# emitter. Wired via check_codex_response.py PostToolUse hook on
 11335	# mcp__codex__codex|mcp__codex__codex-reply matchers. Per ADR-106 the
 11336	# hook is advisory-only (cannot block); this audit event is the
 11337	# forensic-trail surface for downstream `audit-query.py
 11338	# codex-injection-summary`.
 11339	# ---------------------------------------------------------------------
 11340	
 11341	
 11342	def emit_pair_rail_codex_injection_detected(
 11343	    *,
 11344	    tool_name: str,
 11345	    family_ids: List[str],
 11346	    match_count: int,
 11347	    first_offset_bucket: str,
 11348	    session_id: str = "",
 11349	    project: str = "",
 11350	) -> None:
 11351	    """Emit `pair_rail_codex_injection_detected` event.
 11352	
 11353	    Fired by check_codex_response.py when Codex MCP stdout contains
 11354	    one of the harness-mimicry / xml-system-tag / tool-use-forgery
 11355	    injection patterns scanned by `_scan_injection`. Sec MF-3
 11356	    whitelisted fields ONLY:
 11357	
 11358	    - tool_name: which Codex MCP tool (mcp__codex__codex /
 11359	      mcp__codex__codex-reply).
 11360	    - family_ids: sorted unique pattern family identifiers that
 11361	      matched (subset of {"harness_mimicry", "xml_system_tag",
 11362	      "tool_use_forgery"}).
 11363	    - match_count: total match count across all families.
 11364	    - first_offset_bucket: coarse-bucketed first match offset
 11365	      ("0-100" / "100-1k" / "1k-10k" / "10k-100k" / "100k+") — raw
 11366	      offset is FORBIDDEN per LLM06 side-channel guard.
 11367	
 11368	    Raw matched content is NEVER persisted. The forensic surface is
 11369	    "patterns matched + how many + roughly where" — sufficient for
 11370	    SOC alerting without leaking the prompt prefix length or the
 11371	    matched-token bytes themselves.
 11372	
 11373	    R1 S-Sec-9 atomicity: this typed wrapper + the dispatch-gate
 11374	    elif branch + the _PAIR_RAIL_CODEX_INJECTION_DETECTED_ALLOWLIST
 11375	    frozenset MUST all land in the same ceremony script (per S87
 11376	    hot-fix history at audit_emit.py:386-396). The ceremony scripts
 11377	    enforces this via Block 3 verification.
 11378	    """
 11379	    # Defensive: coerce family_ids to sorted unique list[str] of
 11380	    # known families. Anything else is dropped to satisfy MF-3.
 11381	    _KNOWN_FAMILIES = ("harness_mimicry", "xml_system_tag", "tool_use_forgery")
 11382	    safe_families = sorted({
 11383	        str(f) for f in family_ids if str(f) in _KNOWN_FAMILIES
 11384	    })
 11385	    safe_count = max(0, int(match_count))
 11386	    safe_bucket = (
 11387	        first_offset_bucket
 11388	        if first_offset_bucket in ("0-100", "100-1k", "1k-10k", "10k-100k", "100k+")
 11389	        else "0-100"
 11390	    )
 11391	    emit_generic(
 11392	        "pair_rail_codex_injection_detected",
 11393	        session_id=session_id,
 11394	        tool_name=str(tool_name)[:50],
 11395	        family_ids=safe_families,
 11396	        match_count=safe_count,
 11397	        first_offset_bucket=safe_bucket,
 11398	        project=project,
 11399	    )
