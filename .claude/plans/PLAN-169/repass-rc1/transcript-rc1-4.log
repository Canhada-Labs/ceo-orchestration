  2512	# PLAN-112-FOLLOWUP-hmac-tamper-fix Wave B.3 — helper to emit
  2513	# chain_reset_marker as line 1 of new (post-rotation) audit-log + write
  2514	# rotation manifest. MUST be called UNDER the audit-log FileLock by the
  2515	# caller. Per ADR-055-AMEND-2.
  2516	def _emit_chain_reset_marker_under_lock(
  2517	    log: Path,
  2518	    previous_archive_path: str,
  2519	    rotation_trigger: str = "size_threshold",
  2520	) -> Optional[bytes]:
  2521	    """Emit chain_reset_marker as line 1 + write rotation manifest.
  2522	
  2523	    Caller MUST hold the canonical FileLock + the canonical log file
  2524	    MUST be empty (just rotated). Returns the marker HMAC bytes on
  2525	    success or None on failure (caller breadcrumbs + falls back to
  2526	    legacy-mode rotation without marker).
  2527	
  2528	    Side effects under the lock (sidecars-before-marker order per
  2529	    Codex R3 P1 fold — partial-failure recoverable):
  2530	    1. Read rotated archive's last hmac (best-effort; "" if not found)
  2531	    2. Compute marker HMAC at GENESIS_PREV (marker is genesis-anchored)
  2532	    3. **Write rotation manifest sidecar FIRST** (fail-closed: return None
  2533	       if fails — marker not on disk, next emit uses legacy mode)
  2534	    4. **Write audit-log.last-hmac with marker HMAC** (fail-closed: revert
  2535	       manifest, return None — both sidecars in pre-marker state)
  2536	    5. Write audit-log.chain-length to 1 (non-critical canary; fail-open
  2537	       with breadcrumb)
  2538	    6. **Append marker line LAST to new audit-log.jsonl** (line 1; if this
  2539	       fails, sidecars + manifest already consistent → verifier in
  2540	       manifest-required mode tamper-flags the missing line 1 marker,
  2541	       which is correct fail-LOUD detection)
  2542	
  2543	    Pre-R3 order was: append-then-sidecars (marker on disk before manifest
  2544	    write); a sidecar failure could leave marker on disk + stale sidecars,
  2545	    causing the NEXT emit to chain from genesis and produce a broken
  2546	    line 2. The sidecars-first ordering eliminates this failure mode.
  2547	    """
  2548	    from datetime import datetime, timezone
  2549	    try:
  2550	        # Step 1: read rotated archive's last hmac.
  2551	        previous_archive_last_hmac = ""
  2552	        try:
  2553	            archive_path = Path(previous_archive_path)
  2554	            if archive_path.exists() and archive_path.stat().st_size > 0:
  2555	                # Read last non-empty line from archive
  2556	                with open(archive_path, "rb") as f:
  2557	                    f.seek(0, 2)  # seek to end
  2558	                    file_size = f.tell()
  2559	                    # Read last 4KB (sufficient for one JSONL line)
  2560	                    seek_to = max(0, file_size - 4096)
  2561	                    f.seek(seek_to)
  2562	                    tail = f.read().decode("utf-8", errors="replace")
  2563	                    last_line = ""
  2564	                    for line in tail.splitlines():
  2565	                        line = line.strip()
  2566	                        if line:
  2567	                            last_line = line
  2568	                    if last_line:
  2569	                        try:
  2570	                            last_entry = json.loads(last_line)
  2571	                            if isinstance(last_entry, dict):
  2572	                                hmac_val = last_entry.get("hmac")
  2573	                                if isinstance(hmac_val, str) and len(hmac_val) == 64:
  2574	                                    previous_archive_last_hmac = hmac_val
  2575	                        except json.JSONDecodeError:
  2576	                            pass
  2577	        except (OSError, AttributeError):
  2578	            pass
  2579	
  2580	        # Step 2: compute marker HMAC at GENESIS_PREV (genesis-anchored).
  2581	        rotated_at = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
  2582	        marker_event = {
  2583	            "action": "chain_reset_marker",
  2584	            "previous_archive_path": str(previous_archive_path)[:256],
  2585	            "previous_archive_last_hmac": previous_archive_last_hmac[:64],
  2586	            "rotation_ts": rotated_at,
  2587	            "rotation_trigger": _normalize_rotation_trigger(rotation_trigger),
  2588	            "session_id": "",
  2589	            "project": "",
  2590	            "event_schema": "v2",
  2591	            "ts": rotated_at,
  2592	            "tokens_in": None,
  2593	            "tokens_out": None,
  2594	            "tokens_total": None,
  2595	        }
  2596	        key = _audit_hmac.get_or_create_key()
  2597	        marker_sans_hmac = {k: v for k, v in marker_event.items()
  2598	                            if k != "hmac" and k != "hmac_error"}
  2599	        try:
  2600	            marker_digest = _audit_hmac.compute_entry_hmac(
  2601	                key, _audit_hmac.GENESIS_PREV, marker_sans_hmac
  2602	            )
  2603	        except _audit_hmac.AuditProducerPathPollutionError as ppe:
  2604	            # PLAN-118 AC-B4 chokepoint 1 + recursion-safety case 3 —
  2605	            # detected at the marker chokepoint itself. SKIP the marker
  2606	            # emission entirely (the marker would otherwise be signed
  2607	            # under the polluted producer's canonicalization, perpetuating
  2608	            # the exact bug we're closing). Write ONE bounded breadcrumb
  2609	            # line directly to the host's audit-log via the pre-canonical
  2610	            # fast-path (stdlib `open(path, 'a')` JSON write — NO
  2611	            # _write_event, NO compute_entry_hmac re-entry, NO chain
