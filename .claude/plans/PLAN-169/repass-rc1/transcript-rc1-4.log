  4066	# ---------------------------------------------------------------------
  4067	# PLAN-085 Wave G.1b — ATLAS technique-ID schema (5 mappings).
  4068	# Immutable v1.19.0 registry; G.1a authored docs + fixtures + test
  4069	# infrastructure; G.1b lands the production audit_emit wiring.
  4070	# Source of truth: docs/EXT-011-mitre-atlas.md §2 SHIPPED table.
  4071	#
  4072	# PLAN-095 Wave A (S128) — registry expanded to 19 entries / 11 unique
  4073	# technique IDs by PLAN-088/089/090 across multiple plan ships. PLAN-095
  4074	# Wave B ships OWASP LLM03:2025 Supply Chain detection in
  4075	# `_lib/output_scan.py::_LLM_PATTERN_GROUPS` (family LLM03_2025_supply_chain).
  4076	# That detection family is NOT bound to a row in this registry because
  4077	# supply-chain is a family-level concern over output payloads, not a
  4078	# single technique-ID bound to a single audit-action. Cross-reference
  4079	# only; see `.claude/plans/PLAN-095/honest-scope-correction.md` §A.2.
  4080	# ---------------------------------------------------------------------
  4081	
  4082	_ATLAS_REGISTRY = {
