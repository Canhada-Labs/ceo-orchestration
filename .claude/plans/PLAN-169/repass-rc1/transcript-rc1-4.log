  3992	# PLAN-117 WS-A — closed-enum + constant for the late-set forensic emit. The
  3993	# rejected override VALUE must NEVER reach the payload, so the dispatch gate
  3994	# (below) forces the var name to this constant and coerces an out-of-enum
  3995	# provenance hint to "unspecified" — the no-value-echo invariant is enforced at
  3996	# the chokepoint, independent of the caller (defense-in-depth, mirrors the
  3997	# closed-enum reason_code precedent in tier_policy_loader_fallback_observed).
  3998	_CREDENTIAL_OVERRIDE_VAR_NAME = "CEO_CREDENTIAL_BLOCK_EMERGENCY_OVERRIDE"
  3999	_CREDENTIAL_OVERRIDE_PROVENANCE_HINTS = frozenset({
  4000	    "late_os_environ_set", "spawn_payload_env", "subprocess_inherited",
  4001	})
  4002	
  4003	
  4004	def emit_credential_override_late_set_ignored(
  4005	    provider: str,
  4006	    provenance_hint: str = "late_os_environ_set",
  4007	    session_id: str = "",
  4008	    project: str = "",
  4009	) -> None:
  4010	    """Emit credential_override_late_set_ignored (ADR-040-AMEND-2 §Layer-1).
  4011	
  4012	    Forensic trace for an emergency-override value that was present in the
  4013	    LIVE environment but ABSENT from the import-time trust-root snapshot
  4014	    (set post-anchor) and therefore IGNORED — never honored. The rejected
  4015	    VALUE is never persisted: the emit_generic dispatch gate FORCES
  4016	    ``attempted_var_name`` to the constant variable name and COERCES an
  4017	    out-of-enum ``provenance_hint`` — so the no-value-echo invariant does not
  4018	    depend on the caller (closed-enum-breadcrumb-must-not-echo-rejected-value).
  4019	    There is intentionally no ``attempted_var_name`` parameter: a caller cannot
  4020	    inject it.
  4021	    """
  4022	    emit_generic(
  4023	        "credential_override_late_set_ignored",
  4024	        provider=provider,
  4025	        provenance_hint=provenance_hint,
  4026	        session_id=session_id,
  4027	        project=project,
  4028	    )
