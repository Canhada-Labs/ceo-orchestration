  8188	
  8189	def _coerce_pair_rail_timeout_ms(value: Any) -> int:
  8190	    """Bound an effective-budget value to `[0, 6_000_000]` integer ms.
  8191	
  8192	    Deny-by-default VALUE coercion (Sec MF-3): a non-numeric, boolean,
  8193	    NaN or infinite input becomes `0` (the "unknown budget" sentinel)
  8194	    rather than reaching the signed chain. `bool` is rejected explicitly
  8195	    because `isinstance(True, int)` would otherwise sign `1` as a budget.
  8196	    """
  8197	    if isinstance(value, bool):
  8198	        return 0
  8199	    try:
  8200	        ms = int(value)
  8201	    except (TypeError, ValueError, OverflowError):
  8202	        return 0
  8203	    return max(0, min(_PAIR_RAIL_TIMEOUT_MS_MAX, ms))
