   328	    if not os.path.isdir(workspace):
   329	        sys.stderr.write("run-activated-workflow: workspace is not a directory: %s\n" % workspace)
   330	        return 2
   331	    if wf_rel.endswith(".template"):
   332	        sys.stderr.write("run-activated-workflow: refusing a .template — activate it first (the adopter's mv)\n")
   333	        return 2
   334	    if not os.path.isfile(wf_path):
   335	        sys.stderr.write("run-activated-workflow: workflow not found: %s\n" % wf_path)
   336	        return 2
   337	
   338	    try:
   339	        with open(wf_path, encoding="utf-8") as fh:
   340	            wf = parse_workflow(fh.read())
   341	    except ParseError as exc:
   342	        sys.stderr.write("run-activated-workflow: PARSE FAILURE in %s: %s\n" % (wf_rel, exc))
   343	        return 2
   344	
   345	    steps = wf["steps"]  # type: ignore[assignment]
   346	    assert isinstance(steps, list)
   347	    timeout_min = int(wf["timeout_min"])  # type: ignore[arg-type]
   348	    run_steps = [s for s in steps if s["kind"] == "run"]
   349	    print("==> activated workflow: %s (job %r, %d steps: %d run, %d uses; timeout-minutes %d)" % (
   350	        wf_rel, wf["job_id"], len(steps), len(run_steps), len(steps) - len(run_steps), timeout_min))
   351	    if wf["job_if"]:
   352	        print("    job-level if: %s — treated as unset repository variable (job runs)" % wf["job_if"])
   353	    if not run_steps:
   354	        sys.stderr.write("run-activated-workflow: no run: step — nothing would execute (refusing a vacuous pass)\n")
   355	        return 2
   356	
   357	    if "--list" in flags:
   358	        for i, s in enumerate(steps, 1):
   359	            if s["kind"] == "uses":
   360	                print("  %2d. [uses] %s  (%s)" % (i, s["name"], s["uses"]))
   361	            else:
   362	                first = str(s["script"]).strip().splitlines()[0]
   363	                print("  %2d. [run ] %s  (%s%s)" % (i, s["name"], first[:60], "…" if len(first) > 60 else ""))
   364	        return 0
   365	
   366	    runner_temp = tempfile.mkdtemp(prefix="runner-temp-")
   367	    env = _runner_env(workspace, runner_temp)
   368	    total = len(steps)
   369	    deadline = time.monotonic() + timeout_min * 60.0
   370	    for i, s in enumerate(steps, 1):
   371	        name = str(s["name"])
   372	        if s["kind"] == "uses":
   373	            print("==> step %d/%d: %s — SKIPPED (runner-provided: uses: %s)" % (i, total, name, s["uses"]))
   374	            sys.stdout.flush()
   375	            continue
   376	        remaining = deadline - time.monotonic()
   377	        if remaining <= 0:
   378	            print("    FAIL: job timeout-minutes %d expired before step %d/%d %r — the hosted runner would have cancelled the job" % (
   379	                timeout_min, i, total, name))
   380	            return 1
   381	        print("==> step %d/%d: %s" % (i, total, name))
   382	        sys.stdout.flush()
   383	        fd, script_path = tempfile.mkstemp(prefix="step-", suffix=".sh", dir=runner_temp)
   384	        with os.fdopen(fd, "w", encoding="utf-8") as fh:
   385	            fh.write(str(s["script"]))
   386	        t0 = time.monotonic()
   387	        try:
   388	            proc = subprocess.run(
   389	                ["bash", "--noprofile", "--norc", "-eo", "pipefail", script_path],
   390	                cwd=workspace, env=env, timeout=remaining,
   391	            )
   392	            rc = proc.returncode
   393	        except subprocess.TimeoutExpired:
   394	            print("    FAIL: job timeout-minutes %d expired during step %d/%d %r (%.0fs in) — killed, as the hosted runner would cancel it" % (
   395	                timeout_min, i, total, name, time.monotonic() - t0))
   396	            return 1
   397	        except OSError as exc:
   398	            print("    FAIL: could not start bash: %s" % exc)
   399	            return 1
   400	        dt = time.monotonic() - t0
   401	        if rc != 0:
   402	            print("    FAIL: step %d/%d %r exited rc=%d after %.1fs — the adopter's CI would be RED here" % (
   403	                i, total, name, rc, dt))
   404	            return 1
   405	        print("    ok (%.1fs)" % dt)
   406	        sys.stdout.flush()
   407	    print("==> activated workflow PASSED: %d run step(s) executed, %d runner-provided step(s) skipped by name" % (
   408	        len(run_steps), total - len(run_steps)))
   409	    return 0
   410	
   411	
   412	if __name__ == "__main__":
   413	    sys.exit(main(sys.argv))

