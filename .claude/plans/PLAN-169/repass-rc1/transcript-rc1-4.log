   276	  # under --collect-only -- so the session-level audit-dir redirect of the
   277	  # suite (a fixture) is NOT in force while modules import. Any import-time
   278	  # code that reaches an audit emitter then writes to the fallback
   279	  # $HOME/.claude/projects/<slug>: the LIVE HMAC chain. Measured S326
   280	  # (2026-08-24): 124 signed, unattributable links per collect, 19 pre-commit
   281	  # runs in 12 h = 79% of the live segment. Point the first-precedence
   282	  # carrier (CEO_AUDIT_LOG_DIR -- honoured by _lib/audit_emit._audit_dir()
   283	  # ahead of the single resolver, and NOT among the carriers the conftest
   284	  # pops at import) at a throwaway dir for THIS subprocess only. Guard:
   285	  # .claude/hooks/tests/test_collect_only_audit_isolation.py
   286	  _vc_audit_tmp=$(mktemp -d "${TMPDIR:-/tmp}/verify-counts-audit.XXXXXX")
   287	  _collect_out=$( { cd "$REPO_ROOT" && CEO_AUDIT_LOG_DIR="$_vc_audit_tmp" python3 -m pytest --collect-only -q 2>&1 | tail -5; } || true )
   288	  if [ -n "$_vc_audit_tmp" ] && [ -d "$_vc_audit_tmp" ]; then
