  5202	
  5203	def iter_events(
  5204	    path: Optional[Path] = None,
  5205	    action_filter: Optional[str] = None,
  5206	) -> Iterator[Dict[str, Any]]:
  5207	    """Yield events from the audit log, optionally filtering by action.
  5208	
  5209	    Tolerates malformed lines (logs breadcrumb, skips).
  5210	    """
  5211	    log = path or _log_path()
  5212	    if not log.exists():
  5213	        return
  5214	    try:
  5215	        with log.open("r", encoding="utf-8") as f:
  5216	            for line_num, raw in enumerate(f, 1):
  5217	                raw = raw.strip()
  5218	                if not raw:
  5219	                    continue
  5220	                try:
  5221	                    event = json.loads(raw)
  5222	                except json.JSONDecodeError:
  5223	                    _breadcrumb(f"iter_events: malformed line {line_num}")
  5224	                    continue
  5225	                if action_filter and event.get("action") != action_filter:
  5226	                    continue
  5227	                yield event
  5228	    except OSError as e:  # pragma: no cover
  5229	        _breadcrumb(f"iter_events open error: {e}")
