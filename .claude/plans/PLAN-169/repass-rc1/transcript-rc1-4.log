  8519	
  8520	def _coerce_egress_destination(dest: Any) -> str:
  8521	    """Reduce a destination to a bare host string (no scheme/path/query/cred).
  8522	
  8523	    Mirrors egress_taxonomy._host_only's contract but is self-contained (no import
  8524	    dependency). Non-str -> "". Pure; never raises.
  8525	    """
  8526	    if not isinstance(dest, str) or not dest:
  8527	        return ""
  8528	    s = dest.strip()
  8529	    if "://" in s:
  8530	        s = s.split("://", 1)[1]
  8531	    for sep in ("/", "?", "#"):
  8532	        idx = s.find(sep)
  8533	        if idx != -1:
  8534	            s = s[:idx]
  8535	    if "@" in s:
  8536	        s = s.rsplit("@", 1)[1]
  8537	    if s.startswith("["):
  8538	        end = s.find("]")
  8539	        if end != -1:
  8540	            s = s[: end + 1]
  8541	    elif ":" in s:
  8542	        s = s.split(":", 1)[0]
  8543	    return s[:_EGRESS_DEST_MAX_LEN]
  8544	
