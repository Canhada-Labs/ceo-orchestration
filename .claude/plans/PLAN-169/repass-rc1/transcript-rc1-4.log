  4089	    "pii_redacted_outgoing": "AML.T0048.004",
  4090	    "live_adapter_blocked": "AML.T0049",
  4091	    "codex_egress_redacted": "AML.T0054",
  4092	    # PLAN-088 canonical-13 ATLAS bindings (S114) — 6 actions with non-null
  4093	    # technique-IDs per W0 ATLAS-binding table. Remaining 7 canonical-13
  4094	    # actions have atlas_technique=null + atlas_rationale per PLAN-088 §1.5
  4095	    # (telemetry-only / UX-trigger / infra-error / cost-optimization).
  4096	    "subagent_findings_partial_drop": "AML.T0048",   # W1.4 SEMI-13 — Governance bypass observation
  4097	    "anthropic_429_observed":         "AML.T0029",   # W1.4 SEMI-13 — Denial of ML Service signal
  4098	    "codex_invoke_dispatched":        "AML.T0050",   # W1.4 SEMI-13 — LLM Plugin Compromise dual-rail
  4099	    "tier_policy_misrouting_advised": "AML.T0048",   # W2.1 AUTO-04 — Governance bypass
  4100	    "mcp_route_advised":              "AML.T0050",   # W3.1 AUTO-06 — LLM Plugin / supply-chain signal
  4101	    "pair_rail_phase_advanced":       "AML.T0050",   # W4.1 AUTO-07 — LLM Plugin Compromise dual-rail check
  4102	    # PLAN-089 Wave C.5 — ATT&CK Enterprise bindings (R1 TDE P0 fold +
  4103	    # R2 Codex iter-1 P1 taxonomy correction). T1556/T1565.001 are
  4104	    # ATT&CK Enterprise (not ATLAS); registry name is generic for
  4105	    # technique-ID storage despite historic ATLAS-only origin.
  4106	    "kernel_extension_landed":            "T1565.001",  # Stored Data Manipulation — canonical kernel surface
