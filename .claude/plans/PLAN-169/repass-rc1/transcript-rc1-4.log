   203	    # rail r2 (S337): whitelist the JOB-LEVEL keys before reading any of them —
   204	    # a job that gains env:/container:/strategy:/defaults: must fail the parse,
   205	    # never execute under a silently different local environment.
   206	    for i in range(job_idx + 1, job_end):
