     1	#!/usr/bin/env bash
     2	# PLAN-004 Phase 7 — smoke install test (release gate).
     3	#
     4	# Runs install.sh into a scratch directory and asserts invariants that
     5	# a fresh adopter should observe. Exits 0 on success, non-zero on any
     6	# failure. Used by .github/workflows/release.yml on tag push.
     7	#
