  2414	        err.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
  2415	        with err.open("a", encoding="utf-8") as f:
  2416	            f.write(f"{_utc_now_iso()} audit_emit: {message}\n")
  2417	    except Exception:  # pragma: no cover
