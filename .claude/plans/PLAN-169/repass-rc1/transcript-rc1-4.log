   301	  # "N errors" appears in the same -q summary line ("14219 tests collected,
   302	  # 22 errors in 3.98s"). No match => 0 (a clean collect prints no "errors").
   303	  DERIVED_TESTS_ERRORS=$(
   304	    printf '%s\n' "$_collect_out" | \
   305	    sed -e 's/\x1b\[[0-9;]*m//g' | \
   306	    awk 'match($0, /[0-9]+ error/) {
   307	      s = substr($0, RSTART, RLENGTH); sub(/ error/, "", s); print s; exit
   308	    }' || true
   309	  )
   310	  DERIVED_TESTS_ERRORS=${DERIVED_TESTS_ERRORS:-0}
   311	fi
