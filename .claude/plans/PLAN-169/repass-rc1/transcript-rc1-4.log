 13758	def _safe_claim_id_hash(raw: str) -> str:
 13759	    """Return collision-safe claim_id of form '<claim_type>:<12-hex>'.
 13760	
 13761	    Accepts pre-formatted claim_id ('<type>:<12-hex>') ONLY if the
 13762	    prefix matches the KNOWN_KINDS grammar `^[a-z_]{1,32}$`; else
 13763	    rehashes raw via NFKC + sha256[:12] (Codex iter-1 P0-3 fold —
 13764	    prior version accepted ARBITRARY prefix, allowing a direct
 13765	    `emit_generic(claim_id="password=hunter2:deadbeefdead")` to
 13766	    persist the secret unchanged through the "defensive" path).
 13767	
 13768	    Force `unknown:` prefix on rehash (no inheritance of caller
 13769	    prefix; mirrors `_persona_demand_safe_hash` strictness).
 13770	    """
 13771	    import hashlib
 13772	    import re
 13773	    import unicodedata
 13774	    s = str(raw or "").strip()
 13775	    _PREFIX_RE = re.compile(r"^[a-z_]{1,32}$")
 13776	    if ":" in s:
 13777	        prefix, _, suffix = s.partition(":")
 13778	        if (
 13779	            _PREFIX_RE.match(prefix)
 13780	            and len(suffix) == 12
 13781	            and all(c in "0123456789abcdef" for c in suffix.lower())
 13782	        ):
 13783	            return f"{prefix}:{suffix.lower()}"
 13784	    norm = unicodedata.normalize("NFKC", s)
 13785	    digest = hashlib.sha256(norm.encode("utf-8", errors="replace")).hexdigest()[:12]
 13786	    return f"unknown:{digest}"
 13787	
 13788	
 13789	def _safe_payload_hash(raw: str) -> str:
 13790	    """Return bare 12-hex payload_hash.
 13791	
 13792	    Distinct from `_safe_claim_id_hash` (P0-4 fold): the `payload_hash`
 13793	    audit field is the bare digest with NO `<type>:` prefix, so a
 13794	    pre-hashed caller value of exactly 12-hex MUST round-trip unchanged
 13795	    (otherwise determinism breaks between call sites — producer in
 13796	    `confidence_gate.py:_format_json` and re-hash defense at
 13797	    `emit_generic`).
 13798	    """
 13799	    import hashlib
 13800	    import unicodedata
 13801	    s = str(raw or "").strip().lower()
 13802	    if len(s) == 12 and all(c in "0123456789abcdef" for c in s):
 13803	        return s
 13804	    norm = unicodedata.normalize("NFKC", s)
 13805	    return hashlib.sha256(norm.encode("utf-8", errors="replace")).hexdigest()[:12]
 13806	
 13807	
 13808	def _safe_verifier_outcome(raw: str, claim_args: str = "") -> str:
 13809	    """Return redacted + truncated verifier_outcome (security iter-1 P1-B fold).
 13810	
 13811	    `r.detail` is verifier free-text output (e.g. `f"path {path} does
 13812	    not exist"` for path_exists verifier). It echoes `r.claim.args`
 13813	    fragments and can leak absolute paths, username, or claim payload
 13814	    via the free-text channel.
 13815	
 13816	    Pipeline (defense-in-depth):
 13817	      1. PII redact via shipped `_lib.redact.redact_secrets` — fail-
 13818	         CLOSED to empty string if redactor not importable.
 13819	      2. Overlap scrub: any contiguous substring of length >=8 chars
 13820	         that also appears in `claim_args` is replaced with
 13821	         `<redacted>` (catches r.detail echoing r.claim.args).
 13822	      3. NFKC normalize + clip to 64 chars.
 13823	    """
 13824	    try:
 13825	        from _lib.redact import redact_secrets as _redact
 13826	        s = _redact(str(raw or ""))
 13827	    except Exception:
 13828	        # Fail-CLOSED on missing redactor.
 13829	        return ""
 13830	    ca = str(claim_args or "")
 13831	    if ca:
 13832	        for i in range(0, max(0, len(ca) - 8 + 1)):
 13833	            window = ca[i:i + 8]
 13834	            if window in s:
 13835	                s = s.replace(window, "<redacted>")
 13836	    import unicodedata
 13837	    return unicodedata.normalize("NFKC", s)[:64]
 13838	
