 12569	    writes the breadcrumb via the fast-path ``open(path, 'a')`` directly
 12570	    (NOT this wrapper); spool_drain (case 5) uses this wrapper, accepting
 12571	    that its OWN HMAC will land as ``hmac:null`` + the same
 12572	    ``hmac_error`` channel — which is exactly the breadcrumb's purpose.
 12573	    """
 12574	    cp = str(chokepoint)
 12575	    if cp not in _AUDIT_PRODUCER_PATH_POLLUTION_CHOKEPOINTS:
 12576	        _breadcrumb(
 12577	            "emit_audit_producer_path_pollution_detected dropped: "
 12578	            f"chokepoint not in closed enum (len={len(cp)})"
 12579	        )
 12580	        return
 12581	    rc = str(reason_code)
 12582	    if rc not in _AUDIT_PRODUCER_PATH_POLLUTION_REASON_CODES:
 12583	        _breadcrumb(
 12584	            "emit_audit_producer_path_pollution_detected dropped: "
 12585	            f"reason_code not in closed enum (len={len(rc)})"
 12586	        )
 12587	        return
 12588	    psp = str(path_sha256_prefix)
 12589	    ecp = str(expected_canonical_prefix)
 12590	    for name, val in (("path_sha256_prefix", psp), ("expected_canonical_prefix", ecp)):
 12591	        if len(val) != 8 or not all(c in "0123456789abcdef" for c in val):
 12592	            _breadcrumb(
 12593	                "emit_audit_producer_path_pollution_detected dropped: "
 12594	                f"{name} not 8 hex chars (len={len(val)})"
 12595	            )
 12596	            return
 12597	    raw_event: Dict[str, Any] = {
 12598	        "action": "audit_producer_path_pollution_detected",
 12599	        "session_id": session_id,
 12600	        "project": project,
 12601	        "chokepoint": cp,
 12602	        "reason_code": rc,
 12603	        "path_sha256_prefix": psp,
 12604	        "expected_canonical_prefix": ecp,
 12605	    }
 12606	    cleaned, _ = _scrub_ceo_boot_event(
 12607	        raw_event, _AUDIT_PRODUCER_PATH_POLLUTION_DETECTED_ALLOWLIST
 12608	    )
 12609	    _write_event(cleaned)
