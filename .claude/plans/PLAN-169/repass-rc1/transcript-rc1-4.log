 11148	    *,
 11149	    session_id: str = "",
 11150	    rank: int = 0,
 11151	    severity: str = "",
 11152	    subject_hash: str = "",
 11153	    awaiting_confirm: bool = False,
 11154	    project: str = "",
 11155	) -> None:
 11156	    """Emit ceo_boot_task_candidate_emitted (PLAN-078 Wave 5).
 11157	
 11158	    Fired by .claude/scripts/ceo-boot.py:_emit_task_candidate_safe per
 11159	    `<!-- TASKCREATE-CANDIDATE -->` marker block written to stdout when the
 11160	    boot run has gate_pass=False AND the recommendation severity is medium
 11161	    or higher. Top-3 candidates per invocation; dedup by `subject_hash` is
 11162	    enforced caller-side via a 24h TTL state file under `_lib/filelock`.
 11163	
 11164	    Sec MF-3 field allowlist enforced (deny-by-default): NO subject text,
 11165	    NO recommendation body, NO check name/detail, NO env values, NO file
 11166	    paths. Only the 4 caller fields + the auto-baseline (action, ts,
 11167	    session_id, project, event_schema, tokens_*, hmac, hmac_error) added
 11168	    by `_write_event`.
 11169	
 11170	    Args:
 11171	        session_id: forensic correlator (matches sibling `ceo_boot_emitted`).
 11172	        rank: 1-based ordinal of the candidate in the boot run (1..3).
 11173	            Clamped to [1, 3]; values outside the range fall back to 0
 11174	            (sentinel for "drift" — caller invariants are bound to top-3).
 11175	        severity: recommendation engine bucket ∈ {low, medium, high}.
 11176	            Unknown values become "" (defense-in-depth).
 11177	        subject_hash: 12-hex-char prefix of sha256(canonical subject text).
 11178	            The full subject is NEVER persisted (Sec MF-3); the hash is
 11179	            the only stable identifier shared between this event and the
 11180	            dedup state file. Length-bounded to 12 chars; non-hex chars
 11181	            stripped to keep the on-disk shape predictable.
 11182	        awaiting_confirm: bool reserved for a future "Owner-must-confirm"
 11183	            escape (default False — Claude orchestrator auto-creates the
 11184	            task in the v1.15.0 baseline). Persisted as a bool literal.
 11185	        project: optional ``$CLAUDE_PROJECT_DIR`` correlator for adopters.
 11186	
 11187	    Fail-open per audit_emit contract — exceptions inside `_write_event`
 11188	    are swallowed; this wrapper itself never raises.
 11189	    """
 11190	    safe_rank = int(rank) if isinstance(rank, (int, bool)) else 0
 11191	    if safe_rank < 1 or safe_rank > 3:
 11192	        safe_rank = 0
 11193	    safe_severity = severity if severity in ("low", "medium", "high") else ""
 11194	    raw_hash = (subject_hash or "").lower()
 11195	    safe_hash = "".join(ch for ch in raw_hash if ch in "0123456789abcdef")[:12]
 11196	    raw_event: Dict[str, Any] = {
 11197	        "action": "ceo_boot_task_candidate_emitted",
 11198	        "session_id": session_id,
 11199	        "project": project,
 11200	        "rank": safe_rank,
 11201	        "severity": safe_severity,
 11202	        "subject_hash": safe_hash,
 11203	        "awaiting_confirm": bool(awaiting_confirm),
 11204	    }
 11205	    cleaned, dropped = _scrub_ceo_boot_event(
 11206	        raw_event, _CEO_BOOT_TASK_CANDIDATE_EMITTED_ALLOWLIST
 11207	    )
 11208	    _write_event(cleaned)
 11209	    if dropped:  # pragma: no cover — typed wrapper guarantees clean
 11210	        _breadcrumb(
 11211	            f"ceo_boot_task_candidate_emitted dropped forbidden field(s): "
 11212	            f"{sorted(dropped)[:10]}"
 11213	        )
