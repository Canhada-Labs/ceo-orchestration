  4455	def emit_mcp_soak_fpr_breach(
  4456	    window_days: int,
  4457	    fpr_observed: float,
  4458	    threshold: float,
  4459	    top_deny_reason: str,
  4460	    session_id: str = "",
  4461	    project: str = "",
  4462	) -> None:
  4463	    """Emit a mcp_soak_fpr_breach event (ADR-042-AMEND-1 §6.2 / AC-F-4).
  4464	
  4465	    Fires when 7-day rolling FPR > threshold (default 0.01 = 1%).
  4466	    Fires AT MOST once per breach day; the soak monitor enforces
  4467	    dedup against the most recent emit.
  4468	
  4469	    Float fields are encoded as integers to satisfy the canonical_json
  4470	    no-float invariant on HMAC-covered audit events:
  4471	
  4472	    - ``fpr_observed``  → ``fpr_observed_bps``  (rate × 10000, 0..10000+)
  4473	    - ``threshold``     → ``threshold_bps``     (rate × 10000, 0..10000+)
  4474	
  4475	    Example: FPR 0.01 (1%) → 100 bps; threshold 0.01 → 100 bps.
  4476	    Readers must divide by 10000 to recover the original rate.
  4477	    """
  4478	    event: Dict[str, Any] = {
  4479	        "action": "mcp_soak_fpr_breach",
  4480	        "window_days": int(window_days),
  4481	        "fpr_observed_bps": max(0, int(round(float(fpr_observed) * 10000))),
  4482	        "threshold_bps": max(0, int(round(float(threshold) * 10000))),
  4483	        "top_deny_reason": str(top_deny_reason),
  4484	        "session_id": session_id,
  4485	        "project": project,
  4486	    }
  4487	    _write_event(event)
