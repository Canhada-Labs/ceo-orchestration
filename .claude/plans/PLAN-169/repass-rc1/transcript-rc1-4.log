 13025	def streaming_rate_admit(persona: str, _now: Callable[[], float] = time.monotonic) -> bool:
 13026	    """Per-persona token bucket for streaming_token_yielded."""
 13027	    now = _now()
 13028	    with _PLAN090_BUCKET_LOCK:
 13029	        last_ts, tokens = _PLAN090_STREAM_BUCKETS.get(persona, (now, _PLAN090_STREAM_BURST))
 13030	        elapsed_min = (now - last_ts) / 60.0
 13031	        refill = int(elapsed_min * _PLAN090_STREAM_REFILL_PER_MIN)
 13032	        if refill > 0:
 13033	            tokens = min(_PLAN090_STREAM_BURST, tokens + refill)
 13034	            last_ts = now
 13035	        if tokens <= 0:
 13036	            _PLAN090_STREAM_BUCKETS[persona] = (last_ts, tokens)
 13037	            return False
 13038	        _PLAN090_STREAM_BUCKETS[persona] = (last_ts, tokens - 1)
 13039	        return True
 13040	
 13041	
 13042	def persona_auto_decision_rate_admit(
 13043	    persona: str, _now: Callable[[], float] = time.monotonic
 13044	) -> bool:
 13045	    """Per-persona token bucket for persona_auto_decision_emitted."""
 13046	    now = _now()
 13047	    with _PLAN090_BUCKET_LOCK:
 13048	        last_ts, tokens = _PLAN090_PERSONA_BUCKETS.get(persona, (now, _PLAN090_PERSONA_BURST))
 13049	        elapsed_min = (now - last_ts) / 60.0
 13050	        refill = int(elapsed_min * _PLAN090_PERSONA_REFILL_PER_MIN)
 13051	        if refill > 0:
 13052	            tokens = min(_PLAN090_PERSONA_BURST, tokens + refill)
 13053	            last_ts = now
 13054	        if tokens <= 0:
 13055	            _PLAN090_PERSONA_BUCKETS[persona] = (last_ts, tokens)
 13056	            return False
 13057	        _PLAN090_PERSONA_BUCKETS[persona] = (last_ts, tokens - 1)
 13058	        return True
