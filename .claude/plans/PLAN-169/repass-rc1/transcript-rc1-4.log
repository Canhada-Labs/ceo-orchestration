  2894	
  2895	                with log.open("a", encoding="utf-8") as f:
  2896	                    f.write(line)
  2897	                    f.flush()
  2898	                    try:
  2899	                        os.fsync(f.fileno())
  2900	                    except (OSError, AttributeError):
  2901	                        pass
