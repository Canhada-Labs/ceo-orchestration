   262	
   263	    steps: List[Dict[str, object]] = []
   264	    for k, s in enumerate(item_starts):
   265	        e = item_starts[k + 1] if k + 1 < len(item_starts) else steps_end
   266	        name = lines[s].split(":", 1)[1].strip()
   267	        if name[:1] in "\"'" and name[-1:] == name[:1] and len(name) >= 2:
   268	            name = name[1:-1]
