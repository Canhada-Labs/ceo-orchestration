 13540	# -----------------------------------------------------------------------------
 13541	# PLAN-104 Wave A.3 + A.4 — persona-demand ledger emit functions + allowlists.
 13542	# Kernel-protected; registered via CEO_KERNEL_OVERRIDE=PLAN-104-WAVE-A-
 13543	# AUDIT-EMIT-EXTENSION + CEO_KERNEL_OVERRIDE_ACK=I-ACCEPT (S123 pattern).
 13544	# Sec MF-3 caller-field deny-by-default per action.
 13545	# Field bodies NEVER persist raw target paths or branch refs.
 13546	# Codex iter-1 P0 #4 fold: target_ref_hash is re-derived defensively
 13547	# from a 12-hex check (strip + ascii-only); caller-supplied non-hex
 13548	# values fall back to sha256[:12] of the input. This blocks an LLM06
 13549	# side-channel where a hostile caller passes raw text as
 13550	# `target_ref_hash`.
 13551	# -----------------------------------------------------------------------------
 13552	
 13553	def _persona_demand_safe_hash(raw: str) -> str:
 13554	    """Return 12-hex target_ref_hash. Re-hashes if caller value not valid hex."""
 13555	    import hashlib
 13556	    s = str(raw or "").strip().lower()
 13557	    if len(s) == 12 and all(c in "0123456789abcdef" for c in s):
 13558	        return s
 13559	    return hashlib.sha256(s.encode("utf-8", errors="replace")).hexdigest()[:12]
 13560	
