    12	set -euo pipefail
    13	
    14	SCRIPT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    15	SOURCE_DIR="$( cd "$SCRIPT_DIR/../.." && pwd )"
    16	
    17	TARGET="${1:-}"
    18	CLEANUP=0
    19	if [[ -z "$TARGET" ]]; then
    20	  TARGET="$(mktemp -d -t ceo-smoke-XXXXXX)"
    21	  CLEANUP=1
    22	fi
    23	
    24	echo "==> smoke install into: $TARGET"
    25	mkdir -p "$TARGET"
    26	
    27	# Initialize a minimal git repo so CODEOWNERS / hooks have a valid context
    28	if [[ ! -d "$TARGET/.git" ]]; then
    29	  ( cd "$TARGET" && git init -q )
    30	fi
    31	
    32	# Run the installer (capture output to a log)
    33	LOG="$TARGET/.smoke-install.log"
    34	if ! bash "$SOURCE_DIR/scripts/install.sh" "$TARGET" --profile core,frontend >"$LOG" 2>&1; then
    35	  echo "::error::install.sh failed (see $LOG)"
    36	  tail -40 "$LOG"
    37	  exit 1
    38	fi
    39	echo "==> install.sh returned 0"
    40	
    41	# --- Assertions ---
    42	fail=0
    43	
    44	assert_exists() {
    45	  local path="$1"
    46	  if [[ ! -e "$TARGET/$path" ]]; then
    47	    echo "::error::missing: $path"
    48	    fail=1
    49	  fi
    50	}
    51	
    52	assert_not_contains() {
    53	  local pattern="$1"
    54	  local scope="$2"
    55	  # Allowlist: files that legitimately mention placeholder syntax in
    56	  # docstrings / help text / error messages targeted at the adopter
    57	  # themselves. These are documentation, not code that the installer
    58	  # is expected to render. Keep this list narrow and commented.
    59	  local allowlist_regex="(admin-invite\.py|check-originator-residue\.py)"
    60	  local matches
    61	  matches=$(grep -rn "$pattern" "$TARGET/$scope" 2>/dev/null || true)
    62	  # Filter out allowlisted files
    63	  local real_matches
    64	  real_matches=$(echo "$matches" | grep -Ev "$allowlist_regex" || true)
    65	  if [[ -n "$real_matches" ]]; then
    66	    echo "::error::unrendered placeholder '$pattern' leaked into $scope"
    67	    echo "$real_matches" | head -5 >&2
    68	    fail=1
    69	  fi
    70	}
