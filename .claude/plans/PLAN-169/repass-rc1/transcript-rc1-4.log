 11404	# ---------------------------------------------------------------------
 11405	# PLAN-081 Phase 2 — dispatcher_route typed wrapper.
 11406	# Wired via inject-agent-context.sh --pair-mode dispatch path. Carries
 11407	# routing-decision metadata for audit forensics (which archetype, which
 11408	# rail, why fallback if any) plus the perf metric source field
 11409	# (wall_clock_s) consumed by disable_predicate_eval._latency_p95.
 11410	#
 11411	# Sec MF-3: ONLY whitelisted fields persisted. NO archetype profile
 11412	# body, NO task description, NO skill content. The dispatch-gate in
 11413	# emit_generic re-enforces _DISPATCHER_ROUTE_EMIT_ALLOWLIST defensively.
 11414	# ---------------------------------------------------------------------
 11415	
 11416	
 11417	def emit_dispatcher_route(
 11418	    *,
 11419	    archetype: str,
 11420	    rail: str,
 11421	    reason_code: str,
 11422	    matrix_sha256_prefix: str,
 11423	    matrix_sha256_match: bool,
 11424	    coder: str,
 11425	    reviewer: str,
 11426	    coder_model: Optional[str] = None,
 11427	    reviewer_sandbox: str = "read-only",
 11428	    fallback_provider: str = "claude",
 11429	    wall_clock_ms: int = 0,
 11430	    retry_at_timeout_ms: Optional[int] = None,
 11431	    session_id: str = "",
 11432	    project: str = "",
 11433	) -> None:
 11434	    """Emit ``dispatcher_route`` event from inject-agent-context.sh.
 11435	
 11436	    Fired once per ``--pair-mode`` dispatch (one event per spawned
 11437	    Agent). Records the routing decision so post-hoc audit-query.py can
 11438	    reconstruct which rail was chosen + why fallback occurred (if any).
 11439	
 11440	    Args (all keyword-only):
 11441	        archetype: archetype name (e.g. ``"code-reviewer"``).
 11442	        rail: ``"pair_rail"`` | ``"fallback_claude_only"`` |
 11443	            ``"fallback_codex_only"``.
 11444	        reason_code: ``"ok"`` (pair-rail engaged) |
 11445	            ``"predicate_<id>_fired"`` (disable predicate triggered) |
 11446	            ``"matrix_sha_mismatch"`` | ``"health_prereq_unmet_<u-id>"``.
 11447	        matrix_sha256_prefix: 16-hex prefix of loaded matrix SHA-256
 11448	            (raw full hex digest is forbidden — bucket prefix only).
 11449	        matrix_sha256_match: True iff ``CEO_PAIR_RAIL_MATRIX_SHA256``
 11450	            env var was set AND matched the loaded matrix digest.
 11451	        coder: provider name from routing-matrix.yaml ``coder`` field.
 11452	        reviewer: provider name from routing-matrix.yaml ``reviewer``
 11453	            field.
 11454	        coder_model: optional model floor (sonnet/opus/haiku).
 11455	        reviewer_sandbox: sandbox mode for reviewer (read-only /
 11456	            workspace-write / danger-full-access).
 11457	        fallback_provider: provider used when pair-rail disabled.
 11458	        wall_clock_ms: dispatcher-side resolution wall-clock as an
 11459	            integer in milliseconds (≥0). Source field for the
 11460	            ``codex_latency_p95_s`` perf predicate aggregator (which
 11461	            divides by 1000 to recover seconds for percentile compare).
 11462	            Codex iter 1 P0-1: integer-only, NOT float — canonical_json
 11463	            forbids floats in HMAC-covered fields per
 11464	            ``_lib/canonical_json.py:85``.
 11465	        retry_at_timeout_ms: optional retry timeout (integer ms) when
 11466	            codex.py classifier escalated simple → audit class.
 11467	        session_id: optional session identifier.
 11468	        project: optional project tag.
 11469	
 11470	    Sec MF-3 enforcement: ALL fields whitelisted by
 11471	    ``_DISPATCHER_ROUTE_EMIT_ALLOWLIST``. Any caller drift carrying
 11472	    archetype profile body / task description / skill content is dropped
 11473	    by the dispatch-gate scrub in ``emit_generic``.
 11474	
 11475	    R1 S-Sec-9 atomicity: this typed wrapper + the dispatch-gate elif
 11476	    branch + the ``_DISPATCHER_ROUTE_EMIT_ALLOWLIST`` frozenset MUST all
 11477	    land in the same ceremony script per S87 hot-fix history at
 11478	    ``audit_emit.py:386-396``. Phase 2 ceremony Block 3 verification
 11479	    enforces this via grep -F assertions on all three.
 11480	    """
 11481	    # Defensive coercion to satisfy MF-3 + canonical_json no-float
 11482	    # invariant. Codex iter 1 P0-1: wall_clock_ms / retry_at_timeout_ms
 11483	    # are stored as integers (NOT floats) so the HMAC chain over the
 11484	    # event JSON does not reject the record at canonical_json validation.
 11485	    safe_rail = rail if rail in (
 11486	        "pair_rail", "fallback_claude_only", "fallback_codex_only"
 11487	    ) else "fallback_claude_only"
 11488	    safe_prefix = (matrix_sha256_prefix or "")[:16]
 11489	    try:
 11490	        safe_wall_ms = max(0, int(wall_clock_ms))
 11491	    except (TypeError, ValueError):
 11492	        safe_wall_ms = 0
 11493	    kwargs = dict(
 11494	        session_id=session_id,
 11495	        archetype=str(archetype)[:64],
 11496	        rail=safe_rail,
 11497	        reason_code=str(reason_code)[:80],
 11498	        matrix_sha256_prefix=safe_prefix,
 11499	        matrix_sha256_match=bool(matrix_sha256_match),
 11500	        coder=str(coder)[:32],
 11501	        reviewer=str(reviewer)[:32],
 11502	        coder_model=str(coder_model)[:32] if coder_model is not None else None,
 11503	        reviewer_sandbox=str(reviewer_sandbox)[:32],
 11504	        fallback_provider=str(fallback_provider)[:32],
 11505	        wall_clock_ms=safe_wall_ms,
 11506	        project=project,
 11507	    )
 11508	    if retry_at_timeout_ms is not None:
 11509	        try:
 11510	            kwargs["retry_at_timeout_ms"] = max(0, int(retry_at_timeout_ms))
 11511	        except (TypeError, ValueError):
 11512	            kwargs["retry_at_timeout_ms"] = 0
 11513	    emit_generic("dispatcher_route", **kwargs)
 11514	
 11515	
 11516	# ---------------------------------------------------------------------
 11517	# PLAN-081 Phase 3 — pair_rail_case typed wrapper.
 11518	# ---------------------------------------------------------------------
 11519	
 11520	
 11521	def emit_pair_rail_case(
 11522	    *,
 11523	    case: str,
 11524	    claude_verdict: str,
 11525	    codex_verdict: str,
 11526	    tool_name: str,
 11527	    file_path_hash_prefix: str,
 11528	    precondition_met: bool = False,
 11529	    rubric_violation_id: str = "",
 11530	    severity: str = "",
 11531	    jaccard_similarity_bucket: str = "",
 11532	    human_triage_grace_h: int = 0,
 11533	    session_id: str = "",
 11534	    review_id: str = "",
 11535	    timeout_ms: int = 0,
 11536	    project: str = "",
 11537	) -> None:
 11538	    """Emit ``pair_rail_case`` event from check_pair_rail.py:_decide_with_matrix.
 11539	
 11540	    ADR-110-AMEND-2 §1.6: ``timeout_ms`` is the EFFECTIVE post-clamp codex
 11541	    budget this invocation ran under, as INTEGER MILLISECONDS (bounded
 11542	    `[0, 6_000_000]`, off-shape COERCED to 0). NOT float seconds — see
 11543	    `emit_pair_rail_review_expected` for why a float would drop the whole
 11544	    event. It disambiguates a case F produced by a sub-floor
 11545	    `CEO_PAIR_RAIL_TIMEOUT_S` export from a genuine Codex outage (§4(i)).
 11546	
 11547	    PLAN-161 C5 r5 F2 + r6 F2: ``review_id`` (EXACTLY 16 lowercase hex or
 11548	    exactly ""; the RAW value is validated before any bounding — off-shape
 11549	    incl. oversize is DROPPED to "", never truncated) is the
 11550	    per-invocation correlation key minted by ``_decide()`` at review entry
 11551	    — identical on this case emit and the same invocation's
 11552	    ``pair_rail_review_expected``, so the /ceo-boot liveness deficit pairs
 11553	    a specific expected with its OWN case (invocation-exact; bucket
 11554	    counting could not). "" = legacy/id-less emit (falls back to the r4
 11555	    (session, file-hash) bucket heuristic).
 11556	    """
 11557	    import re as _re
 11558	    safe_case = case if case in ("A", "B", "C", "D", "E", "F") else "F"
 11559	    safe_claude = claude_verdict if claude_verdict in ("PASS", "BLOCK") else "PASS"
 11560	    safe_codex = codex_verdict if codex_verdict in (
 11561	        "PASS", "BLOCK", "ADVISORY", "TIMEOUT", "MALFORMED"
 11562	    ) else "MALFORMED"
 11563	    safe_tool = str(tool_name)[:32] if tool_name in (
 11564	        "Edit", "Write", "MultiEdit", "NotebookEdit"
 11565	    ) else "unknown"
 11566	    raw_prefix = (file_path_hash_prefix or "")[:16]
 11567	    safe_prefix = raw_prefix if _re.fullmatch(r"[0-9a-f]{0,16}", raw_prefix) else ""
 11568	    # r5 F2 + r6 F2 — the SAME exact-16-or-empty gate as the module-level
 11569	    # _PAIR_RAIL_REVIEW_ID_RE, applied to the RAW value (no truncation:
 11570	    # truncate-then-accept collapsed distinct oversize ids to one key).
 11571	    raw_rid = review_id if isinstance(review_id, str) else ""
 11572	    safe_rid = raw_rid if _PAIR_RAIL_REVIEW_ID_RE.fullmatch(raw_rid) else ""
 11573	    raw_rubric = (rubric_violation_id or "")[:64]
 11574	    if raw_rubric and not _re.fullmatch(r"[a-z][a-z0-9-]{0,63}", raw_rubric):
 11575	        safe_rubric = "unknown_rubric_id"
 11576	    else:
 11577	        safe_rubric = raw_rubric
 11578	    safe_severity = severity if severity in ("P0", "P1", "") else ""
 11579	    safe_jaccard = jaccard_similarity_bucket if jaccard_similarity_bucket in (
 11580	        "<=0.3", "0.3-0.5", "0.5-0.8", ">0.8", ""
 11581	    ) else ""
 11582	    try:
 11583	        safe_grace_h = max(0, min(24, int(human_triage_grace_h)))
 11584	    except (TypeError, ValueError):
 11585	        safe_grace_h = 0
 11586	    emit_generic(
 11587	        "pair_rail_case",
 11588	        session_id=session_id,
 11589	        case=safe_case,
 11590	        claude_verdict=safe_claude,
 11591	        codex_verdict=safe_codex,
 11592	        tool_name=safe_tool,
 11593	        file_path_hash_prefix=safe_prefix,
 11594	        precondition_met=bool(precondition_met),
 11595	        rubric_violation_id=safe_rubric,
 11596	        severity=safe_severity,
 11597	        jaccard_similarity_bucket=safe_jaccard,
 11598	        human_triage_grace_h=safe_grace_h,
 11599	        review_id=safe_rid,
 11600	        # ADR-110-AMEND-2 §1.6 — bounded integer ms, never float seconds.
 11601	        timeout_ms=_coerce_pair_rail_timeout_ms(timeout_ms),
 11602	        project=project,
 11603	    )
 11604	
 11605	
 11606	# ---------------------------------------------------------------------
 11607	# PLAN-081 Phase 4 — pair_rail_promotion typed wrapper.
 11608	# ---------------------------------------------------------------------
 11609	
 11610	
 11611	def emit_pair_rail_promotion(
 11612	    *,
 11613	    run_id: str,
 11614	    verdict: str,
 11615	    corpus_n: int,
 11616	    corpus_manifest_sha: str,
 11617	    catch_rate_num: int,
 11618	    catch_rate_den: int,
 11619	    fp_rate_bucket: str = "",
 11620	    schema_adherence_pct_bucket: str = "",
 11621	    rubric_gap_pp_bucket: str = "",
 11622	    codex_cli_version: str = "",
 11623	    python_version: str = "",
 11624	    git_head_sha_prefix: str = "",
 11625	    pass_2_retry_used: bool = False,
 11626	    manual_triage: bool = False,
 11627	    session_id: str = "",
 11628	    project: str = "",
 11629	) -> None:
