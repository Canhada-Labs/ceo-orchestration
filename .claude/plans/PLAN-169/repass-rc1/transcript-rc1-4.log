  1555	def _e3_safe_path_hashes(v):
  1556	    """Keep only comma-joined 12-hex tokens; drop anything else (a caller
  1557	    that tries to stuff a raw path gets it silently dropped, never echoed)."""
  1558	    s = str(v or "")
  1559	    toks = []
  1560	    for t in s.split(","):
  1561	        t = t.strip()
  1562	        if t and len(t) <= 12 and all(c in "0123456789abcdef" for c in t):
  1563	            toks.append(t)
  1564	    return ",".join(toks)[:512]
