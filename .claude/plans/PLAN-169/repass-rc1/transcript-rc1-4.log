 12823	def _try_rate_admit(action: str) -> bool:
 12824	    """Best-effort rate gate. Returns True (admit) if no gate available."""
 12825	    try:
 12826	        gate = globals().get("_plan088_rate_admit")
 12827	        if callable(gate):
 12828	            return bool(gate(action))
 12829	    except Exception:  # pragma: no cover
 12830	        pass
 12831	    return True
