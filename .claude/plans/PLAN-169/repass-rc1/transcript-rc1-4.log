  9419	def scrub_audit_tokens_event(
  9420	    event: Dict[str, Any],
  9421	    *,
  9422	    allowlist: Optional[frozenset] = None,
  9423	) -> Tuple[Dict[str, Any], List[str]]:
  9424	    """Filter an audit-tokens event dict to allowlisted keys only.
  9425	
  9426	    Returns ``(cleaned_event, dropped_keys)``. Dropped keys are
  9427	    typically forbidden (raw text, payload bodies). Caller should
  9428	    emit ``audit_tokens_key_dropped`` breadcrumb if dropped is
  9429	    non-empty (defense-in-depth on allowlist drift).
  9430	
  9431	    Pure function — no side effects. Never raises.
  9432	
  9433	    Per SEC-P0-04 spec §Hook integration, this is called by
  9434	    emit_audit_tokens_emitted before _write_event. Belt-and-braces
  9435	    on top of audit-tokens.py CLI flag (--content-ban=strict).
  9436	    """
  9437	    if allowlist is None:
  9438	        allowlist = _AUDIT_TOKENS_ALLOWLIST
  9439	    if not isinstance(event, dict):
  9440	        return ({}, [])
  9441	    cleaned: Dict[str, Any] = {}
  9442	    dropped: List[str] = []
  9443	    for key, value in event.items():
  9444	        if key in allowlist:
  9445	            cleaned[key] = value
  9446	        else:
  9447	            dropped.append(key)
  9448	    return (cleaned, dropped)
