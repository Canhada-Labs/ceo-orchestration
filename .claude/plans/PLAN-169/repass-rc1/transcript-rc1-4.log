  8372	def _learning_scope_tags_field(value: Any) -> List[str]:
  8373	    """Coerce scope_tags: <=16 bounded identifier tokens, rest dropped."""
  8374	    out: List[str] = []
  8375	    if isinstance(value, (list, tuple)):
  8376	        for item in value:
  8377	            if isinstance(item, str) and _LEARNING_ID_RE.match(item):
  8378	                out.append(item)
