  2762	        # Always set event_schema + ts
  2763	        event.setdefault("event_schema", EVENT_SCHEMA_V2)
  2764	        event.setdefault("ts", _utc_now_iso())
  2765	
  2766	        # Reserve nullable cost fields (AI specialist P5)
  2767	        event.setdefault("tokens_in", None)
  2768	        event.setdefault("tokens_out", None)
  2769	        event.setdefault("tokens_total", None)
