   318	DERIVED_TEST_FILES_CMD="git ls-files '*test_*.py' '*_test.py' | wc -l"
   319	DERIVED_TEST_FILES=$(
   320	  { cd "$REPO_ROOT" && git ls-files '*test_*.py' '*_test.py' 2>/dev/null || true; } \
