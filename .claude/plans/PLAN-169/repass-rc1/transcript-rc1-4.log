 11988	# =============================================================================
 11989	# PLAN-088 canonical-13 god-mode auto-activation (S114 / qa-architect-reviewed).
 11990	# Per W0 ATLAS-binding table + M-12/Sec-3 (rate-cap 100/min/action +
 11991	# payload_max_bytes=4096) + Sec MF-3 (deny-by-default allowlists).
 11992	#
 11993	# 11 net-new typed emitters + 11 allowlists + 11 emit_generic dispatch gates.
 11994	# The 2 remaining canonical-13 (`model_routing_advised` + `mcp_route_advised`)
 11995	# are pre-existing stubs registered by PLAN-078 / PLAN-086.
 11996	#
 11997	# QA fixes from S114 dispatch verdict ACCEPT-WITH-FIXES (4 P0):
 11998	#   1. `time` + `threading` moved to top-of-file imports (unaliased)
 11999	#   2. `_PLAN088_RATE_STATE` cleared via _plan088_rate_state_clear() in tests;
 12000	#      injectable clock via `_clock` parameter for test-time advance
 12001	#   3. `emit_generic` dispatch gates added for all 11 new actions (Sec MF-3
 12002	#      defense-in-depth — see emit_generic body for the 11 elif branches)
 12003	#   4. `_plan088_payload_cap` uses errors='ignore' + strip-continuation-byte
 12004	#      loop (utf-8 mid-codepoint boundary safe; no � overflow)
 12005	# =============================================================================
 12006	
 12007	_PLAN088_RATE_CAP_PER_MIN = 100
 12008	_PLAN088_PAYLOAD_MAX_BYTES = 4096
 12009	_PLAN088_RATE_STATE: Dict[str, Tuple[float, int, int]] = {}  # action -> (window_start_ts, count, dropped)
 12010	_PLAN088_RATE_LOCK = threading.Lock()
 12011	
 12012	
 12013	def _plan088_rate_state_clear() -> None:
 12014	    """Reset PLAN-088 rate-cap state. Test helper for cross-test isolation
 12015	    (qa-architect P0-2 fix: module-level mutable singleton needs explicit
 12016	    reset to avoid test order dependence)."""
 12017	    with _PLAN088_RATE_LOCK:
 12018	        _PLAN088_RATE_STATE.clear()
 12019	
 12020	
 12021	def _plan088_rate_admit(action: str, _clock: Callable[[], float] = time.time) -> bool:
 12022	    """Return True if action emit is within the 100/min/action cap.
 12023	
 12024	    Sliding 60s window; on rollover, resets count. Increments `dropped`
 12025	    counter when over-budget WITHOUT re-emitting (M-12 anti-recursive-flood
 12026	    invariant — never call `_write_event` or `_breadcrumb` from this path).
 12027	
 12028	    `_clock` is injectable for tests (advance simulated time without
 12029	    `time.sleep`).
 12030	    """
 12031	    now = _clock()
 12032	    with _PLAN088_RATE_LOCK:
 12033	        window_start, count, dropped = _PLAN088_RATE_STATE.get(action, (now, 0, 0))
 12034	        if now - window_start >= 60.0:
 12035	            window_start, count, dropped = now, 0, 0
 12036	        if count >= _PLAN088_RATE_CAP_PER_MIN:
 12037	            _PLAN088_RATE_STATE[action] = (window_start, count, dropped + 1)
 12038	            return False
 12039	        _PLAN088_RATE_STATE[action] = (window_start, count + 1, dropped)
 12040	        return True
 12041	
 12042	
 12043	def _plan088_payload_cap(value: str, max_bytes: int = _PLAN088_PAYLOAD_MAX_BYTES) -> str:
 12044	    """Truncate a utf-8 string to ``max_bytes`` without breaking codepoint.
 12045	
 12046	    M-12 anti-traceback-leak guard. qa-architect P0-4 fix: use ``errors='ignore'``
 12047	    + strip-continuation-byte loop so the cut point lands on a valid utf-8
 12048	    boundary (no \\ufffd replacement-char overflow that would push past
 12049	    max_bytes by 1-2 bytes).
 12050	
 12051	    Only accepts str input (P1 fix: do not coerce None / non-str types
 12052	    silently — let caller's typed default handle missing values).
 12053	    """
 12054	    if not isinstance(value, str):
 12055	        return ""
 12056	    encoded = value.encode("utf-8", errors="replace")
 12057	    if len(encoded) <= max_bytes:
 12058	        return value
 12059	    # Strip trailing continuation bytes (0b10xxxxxx) to land on a valid
 12060	    # codepoint boundary, then decode with errors='ignore' as belt+suspenders.
 12061	    cut = encoded[:max_bytes]
 12062	    while cut and (cut[-1] & 0xC0) == 0x80:
 12063	        cut = cut[:-1]
 12064	    return cut.decode("utf-8", errors="ignore")
 12065	
