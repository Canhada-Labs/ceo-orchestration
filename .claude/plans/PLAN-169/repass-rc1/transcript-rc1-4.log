  2357	    single family resolver — per-project native slug — instead of the
  2358	    four-month literal. ``CEO_AUDIT_LOG_DIR`` keeps its whole-dir
  2359	    precedence for tests/multi-log setups.
  2360	    """
  2361	    env_dir = os.environ.get("CEO_AUDIT_LOG_DIR")
