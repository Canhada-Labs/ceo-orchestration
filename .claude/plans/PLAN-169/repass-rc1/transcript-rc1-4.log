  3156	def emit_eval_task_completed(
  3157	    task_id: str,
  3158	    reward: float,
  3159	    status: str = "",
  3160	    attempts: int = 0,
  3161	    flaky: bool = False,
  3162	    tokens: int = 0,
  3163	    turns: int = 0,
  3164	) -> None:
  3165	    """Emit one real-task reward-benchmark result (PLAN-133 C3).
  3166	
  3167	    NO-VALUE-ECHO contract: the only free-text inputs are ``task_id`` (a stable
  3168	    task slug from .claude/eval/tasks/, NOT user/model content) and ``status``
  3169	    (coerced to the closed trial-status enum). No rejected env value, egress
  3170	    destination, retry_delay, or model output is ever carried. ``reward`` is
  3171	    encoded as basis-points (``reward_bps`` 0..1000) to satisfy the canonical_json
  3172	    no-float invariant; ``flaky`` is encoded as 0/1.
  3173	    """
  3174	    status_norm = status if status in ("pass", "partial", "fail") else "other"
  3175	    event: Dict[str, Any] = {
  3176	        "action": "eval_task_completed",
  3177	        "task_id": str(task_id)[:64],
  3178	        "reward_bps": max(0, min(1000, int(round(float(reward) * 1000)))),
  3179	        "status": status_norm,
  3180	        "attempts": max(0, int(attempts)),
  3181	        "flaky": 1 if flaky else 0,
  3182	        "tokens": max(0, int(tokens)),
  3183	        "turns": max(0, int(turns)),
  3184	    }
  3185	    _write_event(event)
