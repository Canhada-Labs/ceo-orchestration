  9070	# PLAN-179 rail round-5 [P2] — rotating identity shards, best-effort sweep.
  9071	# A shard selects eligible names; it does not preserve directory position.
  9072	# Each sweep starts a fresh scandir and can hit its deadline before the
  9073	# same tail, so expired markers there have no guaranteed reclamation.
  9074	_GC_SHARDS = 8
  9075	
  9076	# Contador de VARREDURA (rail round-6 [P2]): o shard avanca por SWEEP, nunca
  9077	# pelo relogio — varreduras no mesmo minuto modulo K starvariam as outras.
  9078	_GC_SHARD_COUNTER_NAME = ".gc-shard-cursor"
  9079	
  9080	
  9081	def _gc_shard_of_name(name):
  9082	    """Shard estavel derivado do NOME (nunca da ordem de leitura)."""
  9083	    try:
  9084	        return zlib.crc32(name.encode("utf-8", "replace")) % _GC_SHARDS
  9085	    except Exception:
  9086	        return 0
  9087	
  9088	
  9089	def _gc_next_shard(state_dir):
  9090	    """Select the next shard from a best-effort persisted counter.
  9091	
  9092	    A successful read/write advances the counter. A failed read seeds it
  9093	    from randomness (zero if randomness also fails); a failed write can
  9094	    leave the same counter for the next sweep. This selects eligible names,
  9095	    without guaranteeing that the deadline-bounded scan reaches each name.
  9096	    The counter read and ancestor paths retain the rc.1 condition 28 limits;
  9097	    O_NOFOLLOW here protects only the temporary file used for the write.
  9098	    """
  9099	    counter_path = Path(str(state_dir)) / _GC_SHARD_COUNTER_NAME
  9100	    current = None
  9101	    try:
  9102	        raw = counter_path.read_text(encoding="utf-8").strip()
  9103	        current = int(raw)
  9104	    except Exception:
  9105	        current = None
  9106	    if current is None:
  9107	        try:
  9108	            current = int.from_bytes(os.urandom(2), "big")
  9109	        except Exception:
  9110	            current = 0
  9111	    nxt = (current + 1) % (_GC_SHARDS * 1024)  # espaco folgado, sem overflow
  9112	    try:
  9113	        counter_path.parent.mkdir(parents=True, exist_ok=True)
  9114	        tmp = counter_path.parent / (
  9115	            "." + counter_path.name + "." + str(os.getpid()) + "."
  9116	            + os.urandom(4).hex() + ".tmp"
  9117	        )
  9118	        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0)
  9119	        fd = os.open(str(tmp), flags, 0o600)
  9120	        try:
  9121	            with os.fdopen(fd, "w", encoding="utf-8") as fh:
  9122	                fh.write(str(nxt))
  9123	        except Exception:
  9124	            try:
  9125	                os.unlink(str(tmp))
  9126	            except OSError:
  9127	                pass
  9128	            raise
  9129	        os.replace(str(tmp), str(counter_path))
  9130	    except Exception:
  9131	        pass  # housekeeping: nao persistir custa cobertura, nunca correcao
  9132	    return nxt % _GC_SHARDS
  9133	
  9134	def _gc_context_pressure_markers(
  9135	    state_dir: Any,
  9136	    ttl_seconds: int = _CONTEXT_PRESSURE_MARKER_TTL_S,
  9137	    max_files: int = _CONTEXT_PRESSURE_MARKER_GC_MAX,
  9138	) -> int:
  9139	    """Unlink aged-out per-session markers. Bounded, fail-open (finding A).
  9140	
  9141	    Per-session keying trades one shared file for one file per session, so
  9142	    it must come with its own reclaim or it re-opens the unbounded-growth
  9143	    class the rail rejected in the session STORES (finding C). Markers are
  9144	    ~4 bytes and are only created on a rung TRANSITION with the progress
  9145	    floor armed, so the rate is low — this sweep exists so "low" never
  9146	    becomes "forever".
  9147	
  9148	    Only names carrying the marker prefix AND a suffix are considered; the
  9149	    project-wide marker itself is never collected (it has no suffix), and an
  9150	    unrelated file in ``.claude/state/`` is left alone. Returns the number
  9151	    of files unlinked; every OSError is swallowed (housekeeping).
  9152	    """
  9153	    removed = 0
  9154	    prefix = _CONTEXT_PRESSURE_STATE_BASENAME + "."
  9155	    try:
  9156	        cutoff = time.time() - float(ttl_seconds)
  9157	        directory = Path(str(state_dir))
  9158	        # PLAN-179 rail rounds 2/3/4 [P2] — same story as the twin sweep in
  9159	        # `scratchpad_lib.gc_orphan_session_stores`, and the same conclusion.
  9160	        # r2 removed the sort+materialise; r3 replaced it with a fixed prefix
  9161	        # window that STARVED the tail; r4 showed the rotating offset was still
  9162	        # `% _scan_cap`, so nothing past ~2x that was ever reachable.
  9163	        # Scan lazily without sorting, stopping at `max_files` deletions
  9164	        # or the wall-clock deadline. The deadline can repeatedly leave
  9165	        # the same tail unvisited: shard rotation alone does not guarantee
  9166	        # coverage. A continuation mechanism remains an rc.1 P2 follow-up.
  9167	        _deadline = time.time() + _GC_MARKER_WALL_BUDGET_S
  9168	        _shard = _gc_next_shard(directory)
  9169	        _scanned = 0
  9170	        _it = os.scandir(str(directory))
  9171	        try:
  9172	            for _de in _it:
  9173	                _scanned += 1
  9174	                if removed >= int(max_files):
  9175	                    break
  9176	                if (_scanned & 63) == 0 and time.time() >= _deadline:
  9177	                    break
  9178	                entry = Path(_de.path)
  9179	                name = entry.name
  9180	                if _gc_shard_of_name(name) != _shard:
  9181	                    continue
  9182	                # Both the live marker `<prefix><sid>` and a crash-orphaned
  9183	                # atomic-write temp `.<prefix><sid>.<pid>.<rand>.tmp`.
  9184	                if name.startswith("."):
  9185	                    name = name[1:]
  9186	                if not name.startswith(prefix) or len(name) <= len(prefix):
  9187	                    continue
  9188	                try:
  9189	                    if entry.stat().st_mtime >= cutoff:
  9190	                        continue
  9191	                    entry.unlink()
  9192	                    removed += 1
  9193	                except OSError:
  9194	                    # Per-entry fail-open: a racing unlink must not abort it.
  9195	                    continue
  9196	        finally:
  9197	            try:
  9198	                _it.close()
  9199	            except Exception:
  9200	                pass
  9201	    except (OSError, TypeError, ValueError):
  9202	        return removed
  9203	    return removed
  9204	
