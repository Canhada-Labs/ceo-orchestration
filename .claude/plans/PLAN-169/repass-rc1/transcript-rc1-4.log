  3135	        "fail_count": int(fail_count),
  3136	        "pass_rate_bps": max(0, min(1000, int(round(float(pass_rate) * 1000)))),
  3137	        "median_score_bps": max(0, min(1000, int(round(float(median_score) * 1000)))),
  3138	        "floor_bps": max(0, min(1000, int(round(float(floor) * 1000)))),
  3139	        "cost_usd_cents": max(0, int(round(float(cost_usd) * 100))),
  3140	        "duration_ms": max(0, int(round(float(duration_s) * 1000))),
  3141	        "lessons_written": int(lessons_written),
