 13009	_PLAN090_STREAM_BUCKETS: Dict[str, Tuple[float, int]] = {}
 13010	_PLAN090_STREAM_BURST = 10
 13011	_PLAN090_STREAM_REFILL_PER_MIN = 5
 13012	_PLAN090_PERSONA_BUCKETS: Dict[str, Tuple[float, int]] = {}
 13013	_PLAN090_PERSONA_BURST = 10
 13014	_PLAN090_PERSONA_REFILL_PER_MIN = 5
 13015	_PLAN090_BUCKET_LOCK = threading.Lock()
 13016	_VERBOSE_STREAM_ENV = "CEO_AUDIT_STREAM_VERBOSE"
 13017	_VERBOSE_STREAM_ARMED_VALUE = "1"
 13018	
 13019	
 13020	def is_audit_stream_verbose() -> bool:
 13021	    """ADR-123 §4 — EXACT MATCH ``CEO_AUDIT_STREAM_VERBOSE=1`` only."""
 13022	    return os.environ.get(_VERBOSE_STREAM_ENV) == _VERBOSE_STREAM_ARMED_VALUE
