  8514	# PLAN-133 A3 — defensive host-only re-truncation of a persisted destination.
  8515	# Drops scheme/userinfo/port/path/query so even a direct emit_generic caller that
  8516	# passes a full URL in `destination` cannot leak a path/query/credential.
  8517	_EGRESS_DEST_MAX_LEN = 253
