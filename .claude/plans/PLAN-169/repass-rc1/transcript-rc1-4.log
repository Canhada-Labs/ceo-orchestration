  3065	def emit_veto_triggered(
  3066	    hook: str,
  3067	    reason_code: str,
  3068	    reason_preview: str,
  3069	    blocked_tool: str = "",
  3070	    strike_count: Optional[int] = None,
  3071	    session_id: str = "",
  3072	    project: str = "",
  3073	    caller: str = "",
  3074	) -> None:
  3075	    """Emit a veto / block event from any governance hook.
  3076	
  3077	    Args:
  3078	        hook: "check_agent_spawn" | "check_plan_edit" | "check_bash_safety"
  3079	        reason_code: machine-readable rule identifier (e.g. "missing_skill_content")
  3080	        reason_preview: human-readable summary (redacted + truncated)
  3081	        blocked_tool: tool call that was blocked
  3082	        strike_count: session-scoped count (if tracked)
  3083	        caller: identity of the spawning agent or "ceo" (kernel events
  3084	            require this for forensic traceability — schema v2.14)
  3085	    """
  3086	    event: Dict[str, Any] = {
