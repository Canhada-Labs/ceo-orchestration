  2115	def _federation_safe_path_hash(raw: str) -> str:
  2116	    """Return a 12-hex hash of a filesystem-path field (Sec MF-3 / LLM06).
  2117	
  2118	    Mirrors :func:`_persona_demand_safe_hash` strictness: an already-12-hex
  2119	    value passes through (idempotent re-hash safe); anything else (a raw
  2120	    host path) is SHA-256'd and truncated to 12 hex chars so no path body
  2121	    can leak into the HMAC-chained audit log.
  2122	    """
  2123	    import hashlib
  2124	    s = str(raw or "").strip().lower()
  2125	    if len(s) == 12 and all(c in "0123456789abcdef" for c in s):
  2126	        return s
  2127	    return hashlib.sha256(s.encode("utf-8", errors="replace")).hexdigest()[:12]
  2128	
