  2747	def _write_event(event: Dict[str, Any]) -> None:
  2748	    """Write a single JSONL event under the shared lock.
  2749	
  2750	    Fail-open: any exception writes a breadcrumb and returns silently.
  2751	    F-CHAOS-1 (PLAN-019): when the primary audit dir is unwritable, fall
  2752	    back to /tmp/ceo-audit-fallback-<user>.log with once-per-session banner.
