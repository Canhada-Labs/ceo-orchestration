  1338	      echo ""
  1339	      echo "    WARNING: domain '$part' not found at $DOMAIN_SRC — skipping"
  1340	      continue
  1341	    fi
  1342	    echo ""
  1343	    echo "==> Installing domain: $part"
  1344	    _state_record_op "install_skills" "domain:$part"
  1345	    install_one ".claude/skills/domains/$part"
