  2001	# ----------------------------------------------------------------------
  2002	# P1-CR-3 / VP-F1: placeholder substitution pass
  2003	# ----------------------------------------------------------------------
  2004	# Iterate over a deterministic list of placeholder files (the ones
  2005	# templates/ writes out) and apply `sed -i` substitutions for every
  2006	# PH_* variable that is non-empty. Anything left as `{{...}}` after the
  2007	# pass is reported with a stderr warning.
  2008	#
  2009	# We restrict the pass to files install.sh actually placed (the
  2010	# templates/* files) to avoid touching user-authored content. If
  2011	# CLAUDE.md / MEMORY.md already existed at target, we leave them alone
  2012	# (install.sh never overwrites them).
  2013	
  2014	# Portable sed -i for GNU + BSD (macOS): write to .tmp and mv.
  2015	portable_sed_inplace() {
  2016	  # $1 = sed script, $2 = file
  2017	  local script="$1" file="$2"
  2018	  local tmp="${file}.ceo-sed-tmp"
  2019	  sed "$script" "$file" > "$tmp" && mv "$tmp" "$file"
  2020	}
  2021	
  2022	# Build the sed script iteratively. Each non-empty placeholder adds an
  2023	# expression. We use `|` as the delimiter so slashes in values (paths)
  2024	# don't break. Values with `|` are escaped.
  2025	build_sed_script() {
  2026	  local script=""
  2027	  _add_sub() {
  2028	    local key="$1" val="$2"
  2029	    if [[ -n "$val" ]]; then
  2030	      # Escape | & \ in the replacement
  2031	      local esc
  2032	      esc="$(printf '%s' "$val" | sed 's/[|&\\]/\\&/g')"
  2033	      script="${script}s|{{${key}}}|${esc}|g;"
  2034	    fi
  2035	  }
  2036	  _add_sub "OWNER_NAME"          "$PH_OWNER_NAME"
  2037	  _add_sub "OWNER_HANDLE"        "$GITHUB_OWNER"
  2038	  _add_sub "PROJECT_NAME"        "$PH_PROJECT_NAME"
  2039	  _add_sub "PROJECT_PATH"        "$PH_PROJECT_PATH"
  2040	  _add_sub "STACK"               "$PH_STACK"
  2041	  _add_sub "PROTOCOL_SOURCE"     "$PH_PROTOCOL_SOURCE"
  2042	  _add_sub "DEPLOY_COMMAND"      "$PH_DEPLOY_COMMAND"
  2043	  _add_sub "DEPLOY_PLATFORM"     "$PH_DEPLOY_PLATFORM"
