+_dst_refuses() {
+  local dst_rel="$1"
+  local why=""
+  if ! command -v _wbm_dst_refuses >/dev/null 2>&1; then
+    why="destination-confinement predicate unavailable (scripts/_framework_manifest_set.sh not sourced) — refusing rather than guessing"
