  2924	
  2925	validate_no_unrendered_placeholders() {
  2926	  local strict="${STRICT_PLACEHOLDERS:-${CEO_INSTALL_STRICT_PH:-0}}"
  2927	  local found=0
  2928	  local report_file
  2929	  report_file="$(mktemp -t ceo-install-ph-report-XXXXXX)"
  2930	
  3075	#                                   upgrade classifier short-circuits LINK)
  3076	#
  3077	# Written to $TARGET/.claude/.install-manifest.sha256 (distinct from the
  3078	# release skill-manifest.sha256). EXCLUDES the manifest itself + .claude.bak/.
  3079	# Fail-open: any missing helper / unreadable file is skipped with a NOTE; the
  3080	# install never fails because the manifest could not be fully written.
  3081	# ----------------------------------------------------------------------
  3082	write_install_manifest() {
  3083	  # Guarded by the caller for DRY_RUN; defensive re-check here.
  3084	  [[ "${DRY_RUN:-0}" -eq 0 ]] || return 0
  3085	
  3086	  if ! command -v _write_baseline_manifest >/dev/null 2>&1; then
  3087	    echo "    NOTE: baseline manifest skipped — generator helper not sourced" >&2
  3088	    return 0
  3089	  fi
  3090	
  3091	  local manifest="$TARGET/.claude/.install-manifest.sha256"
  3092	  echo ""
  3093	  echo "==> Writing install baseline manifest (.claude/.install-manifest.sha256)"
  3094	  _state_record_op "write_install_manifest" ".claude/.install-manifest.sha256"
  3095	
  3096	  # Profile-aware enumeration rooted at the installed target; the SINGLE shared
  3097	  # generator in _framework_manifest_set.sh does the walk + hashing + LINK
  3098	  # records (the SAME generator upgrade.sh calls after a successful upgrade).
  3099	  export FMS_ROOT="$TARGET"
  3100	  export FMS_PROFILE_PARTS="${PROFILE_PARTS[*]}"
  3101	  export FMS_MODE="$MODE"
  3102	  # PLAN-166 F3 (ADR-155-AMEND-1): conditional ownership from the DELIVERY
  3103	  # RECORD — never the ceremony alone, never file presence. A path
  3104	  # install_one EXISTS-skipped stays out of the baseline, so doctor, the
  3105	  # update-checker and uninstall never treat an adopter file as
  3106	  # framework-owned (r7/r13/r17).
  3107	  #
  3108	  # Ownership CONTINUITY on reruns (codex W1-ceremony round, P1): a rerun
  3109	  # over an already-installed target EXISTS-skips all three paths, so the
  3110	  # THIS-RUN flags are 0 — but the manifest rewrite below REPLACES the old
  3111	  # manifest. Without consulting the PRIOR manifest's records, a rerun
  3112	  # would silently drop framework ownership of SPEC/PROTOCOL/marker (and a
  3113	  # v1.3 SPEC would later misclassify as ADOPTER-FORK — it is absent from
  3114	  # the legacy pristine fingerprints). Preserve a valid prior record: the
  3115	  # regexes mirror upgrade.sh _baseline_has_*_record byte-for-byte
  3116	  # (family-swept; `(/|  |$)` covers the --mode link single-LINK-line form).
  3117	  # A prior LINK record carries ownership forward only while the live symlink
  3118	  # still points where it was RECORDED (codex W1 round 10, P2). On a --link
  3119	  # reinstall over a RETARGETED managed symlink, install_one EXISTS-skips the
  3120	  # path and the continuity check used to accept the record blindly; the
  3121	  # rewrite then serialized the redirected target as the new delivery record
  3122	  # and every later upgrade accepted the foreign tree as healthy. Mirrors the
  3123	  # readlink-vs-record checks upgrade.sh already applies on its refresh
  3124	  # routes. Returns 0 (carry on) when there is no LINK record to compare.
  3125	  _prior_link_target_matches() {   # $1 = manifest, $2 = relpath
  3126	    local _plt_line _plt_rec="" _plt_live
  3127	    while IFS= read -r _plt_line || [[ -n "$_plt_line" ]]; do
  3128	      case "$_plt_line" in
  3129	        "LINK  $2  "*) _plt_rec="${_plt_line#LINK  $2  }"; break ;;
  3130	      esac
  3131	    done < "$1"
  3132	    _plt_live="$( readlink "$TARGET/$2" 2>/dev/null || true )"
  3133	    # A live SYMLINK with no prior LINK record is NOT a match — it is the
  3134	    # ABSENCE of evidence. Returning success there let a --link rerun over a
  3135	    # copy-installed path serialize an arbitrary symlink as a trusted delivery,
  3136	    # converting adopter-owned content into framework-owned (r11-F1, open since
  3137	    # S296; codex W3 r2 P1).
  3138	    if [[ -z "$_plt_rec" ]]; then
  3139	      # No prior LINK record. Ownership carries forward ONLY while the live
  3140	      # path still has the shape the record described. A symlink contradicts a
  3141	      # HASH record (r11-F1); so does a DIRECTORY, and that one is worse — the
  3142	      # continuity branch would enumerate the adopter's own children under it
  3143	      # and record their live hashes, so a later uninstall could delete files
  3144	      # the framework never wrote (codex W3 r3 P1).
  3145	      [[ -z "$_plt_live" ]] || return 1
  3146	      # SPEC/v1 IS a directory by design; only the two SINGLE-FILE surfaces are
  3147	      # contradicted by one. Rejecting every directory broke SPEC continuity.
  3148	      case "$2" in
  3149	        SPEC/v1) : ;;
  3150	        *) [[ ! -d "$TARGET/$2" ]] || return 1 ;;
  3151	      esac
  3152	      return 0
  3153	    fi
  3154	    [[ "$_plt_rec" == "$_plt_live" ]]
  3155	  }
  3156	  if [[ "${_DELIVERED_SPEC:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  3157	     && grep -Eq '^([0-9a-f]{64}|LINK)  SPEC/v1(/|  |$)' "$manifest" 2>/dev/null \
  3158	     && _prior_link_target_matches "$manifest" "SPEC/v1"; then
  3159	    _DELIVERED_SPEC=1
  3160	    _CONTINUITY_FIRED=1
  3161	    _CONTINUITY_PATHS="${_CONTINUITY_PATHS:-}
  3162	SPEC/v1"
  3163	    echo "    ownership continuity: SPEC/v1 delivery record preserved from prior manifest"
  3164	  fi
  3165	  if [[ "${_DELIVERED_PROTOCOL:-0}" != "1" ]] && [[ -f "$manifest" ]] \
  3166	     && grep -Eq '^([0-9a-f]{64}|LINK)  PROTOCOL\.md(  |$)' "$manifest" 2>/dev/null \
  3167	     && _prior_link_target_matches "$manifest" "PROTOCOL.md"; then
  3168	    # FMS_HASH_ROOT does NOT reach PROTOCOL.md: _write_baseline_manifest
  3169	    # special-cases the generated pointer and hashes the TARGET unless
  3170	    # FMS_PROTOCOL_HASH is supplied — which install never set. So a rerun over
  3171	    # a CUSTOMIZED delivered pointer re-baselined the adopter's own bytes as
  3172	    # framework-owned; the next upgrade would then overwrite them and
  3173	    # uninstall could DELETE them (codex W1 round 9, P1). Carry the PRIOR
