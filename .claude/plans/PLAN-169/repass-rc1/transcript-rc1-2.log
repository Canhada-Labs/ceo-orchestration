  1298	has_profile() {
  1299	  local p="$1"
  1300	  for part in "${PROFILE_PARTS[@]}"; do
  1301	    if [[ "$part" == "$p" ]]; then
  1302	      return 0
  1303	    fi
  1304	  done
  1305	  return 1
  1306	}
