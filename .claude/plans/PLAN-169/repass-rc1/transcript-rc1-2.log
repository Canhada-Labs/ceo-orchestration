   378	_log "==> Uninstall mode (manifest-honoring)"
   379	_log "    Target:   $TARGET"
   380	_log "    Manifest: $MANIFEST"
   381	_log "    Dry-run:  $DRY_RUN"
   382	_log "    Force:    $FORCE"
   383	_log ""
   384	
   385	# --- rc.1 re-pass round 3, part 3: the NUL preflight ------------------------
   386	# `read -r` on the Bash 3.2 floor this project supports DISCARDS a NUL and
   387	# everything after it in that record, so the per-record `grep [[:cntrl:]]`
   388	# below never sees it: `<valid-sha>  docs/file<NUL>garbage` arrived at the
   389	# parser already truncated to `<valid-sha>  docs/file`, hashed, matched, and
   390	# was deleted — with the manifest removed and the run exiting 0. The reviewer
   391	# reproduced exactly that under 3.2.57. A per-record check cannot see a byte
   392	# that `read` ate; the question has to be asked of the FILE, in raw bytes,
   393	# before anything parses it. Refusing the WHOLE manifest is the only honest
   394	# answer: a NUL means the file is not the text this uninstaller can read, and
   395	# picking the survivors would be deciding which truncation to trust.
   396	if ! LC_ALL=C tr -d '\000' < "$MANIFEST" | cmp -s - "$MANIFEST"; then
   397	  _log "    REFUSED: the manifest contains NUL byte(s) — this uninstaller"
   398	  _log "             cannot read it, and `read` would silently truncate the"
   399	  _log "             affected record(s) into shapes that look valid."
   400	  _log "             NOTHING was removed; the manifest is left as it stands."
   401	  exit 6
   402	fi
   403	
   404	# --- rc.1 re-pass round 3, part 3: ONE grammar, parsed ONCE ----------------
   405	# Backup construction and the removal walk used DIFFERENT grammars: the walk
   406	# accepted one OR two spaces after the digest (`  ?`), while the backup list
   407	# only matched records containing two consecutive spaces. A one-space record
   408	# was therefore deleted but never archived — the recovery tarball silently
   409	# missing exactly what the run removed. The canonical grammar is EXACTLY two
   410	# spaces (what the writer emits); it is applied once, here, into a sanitized
   411	# ledger that both the backup and the walk read. No second parser can drift
   412	# from this one because there is no second parser.
   413	_LEDGER="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger)"
   414	unsafe_count=0
   415	valid_count=0
   416	while IFS= read -r line || [ -n "$line" ]; do
   417	  case "$line" in '#'*|'') continue ;; esac
   418	  if printf '%s' "$line" | LC_ALL=C grep -q '[[:cntrl:]]'; then
   419	    unsafe_count=$((unsafe_count + 1))
   420	    _log "    REFUSED (manifest record carries control bytes — not touched)"
   421	    continue
   422	  fi
   423	  case "$line" in
   424	    LINK\ *)
   425	      # `LINK <relpath> <target>` is what a --link install records; this
   426	      # uninstaller handles copy-mode records only (rc.1 condition): the
   427	      # link stays, the refusal is named and counted.
   428	      unsafe_count=$((unsafe_count + 1))
   429	      _log "    REFUSED (LINK record — copy-mode uninstaller; the link is left in place): ${line#LINK }"
   430	      continue ;;
   431	  esac
   432	  if ! printf '%s' "$line" | LC_ALL=C grep -qE '^[0-9a-f]{64}  [^ ]'; then
   433	    unsafe_count=$((unsafe_count + 1))
   434	    _log "    REFUSED (malformed manifest record — not touched): $line"
   435	    continue
   436	  fi
   437	  _rel="${line#*  }"
   438	  if _rel_unsafe "$_rel"; then
   439	    unsafe_count=$((unsafe_count + 1))
   440	    _log "    REFUSED (unsafe manifest path — not touched): $_rel"
   441	    continue
   442	  fi
   443	  if _rel_ancestor_link "$_rel"; then
   444	    unsafe_count=$((unsafe_count + 1))
   445	    _log "    REFUSED (symlinked ancestor — a removal would follow it outside the target): $_rel"
   446	    continue
   447	  fi
   448	  valid_count=$((valid_count + 1))
   449	  printf '%s\t%s\n' "${line%%  *}" "$_rel" >> "$_LEDGER"
   450	done < "$MANIFEST"
   451	
   452	# rc.1 re-pass round 9, part 3: relpath UNIQUENESS across the whole ledger.
   453	# Each record was validated on its own, so a relpath recorded TWICE produced
   454	# two ledger rows and the walk below acts per row: `<old-sha>  docs/x` followed
   455	# by `<current-sha>  docs/x` PRESERVED the adopter's modified file on the first
   456	# row and REMOVED it on the second — without --force, exit 5 only afterwards.
   457	# Ambiguous provenance is refused WHOLE (every occurrence, as doctor.sh does):
   458	# nothing under a duplicated relpath is archived or removed.
   459	_dup_rels="$( cut -f2- "$_LEDGER" | LC_ALL=C sort | LC_ALL=C uniq -d )"
