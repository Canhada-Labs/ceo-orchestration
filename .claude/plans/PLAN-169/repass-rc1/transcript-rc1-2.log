  1866	# Is this EXACT destination in the delivered list? Line-exact on purpose:
  1867	# `.github/CODEOWNERS` is a PREFIX of `.github/CODEOWNERS.template`, so the
  1868	# substring `case` idiom used for _CONTINUITY_PATHS would fire on the wrong
  1869	# one — and those two are mutually exclusive per run, so the wrong answer is
  1870	# reachable, not theoretical.
  1871	_delivered_template_has() {
  1872	  local want="$1" line
  1873	  while IFS= read -r line; do
  1874	    if [[ "$line" = "$want" ]]; then return 0; fi
  1875	  done <<< "${_DELIVERED_TEMPLATES:-}"
  1876	  return 1
  1877	}
  1878	
  1879	# PLAN-183 W5 (D3) — accumulate ONE delivered destination for the baseline
  1880	# manifest. Newline-separated; the generator splits on IFS=newline.
  1881	_append_delivered_template() {
  1882	  # rail round-3 F1 — same WHITELIST discipline as the generator, applied at
  1883	  # the one choke point where this list grows. The generator is the fail-closed
  1884	  # floor (it lives in the same file as the reader and can always consult the
  1885	  # table); this is defence in depth, so a registration the shared table never
  1886	  # declared is refused HERE, named, instead of travelling to the manifest
  1887	  # writer to be silently dropped there. `command -v` guarded because the
  1888	  # library is sourced conditionally (install.sh:248, partial checkout).
  1889	  if command -v _wbm_route_dest_declared >/dev/null 2>&1 \
  1890	     && ! _wbm_route_dest_declared "$1"; then
  1891	    echo "    ERROR: delivered-template registration REJECTED (not a destination declared in the shared route table): '$1'" >&2
  1892	    return 0
  1893	  fi
  1894	  if [[ -n "${_DELIVERED_TEMPLATES:-}" ]]; then
  1895	    _DELIVERED_TEMPLATES="$_DELIVERED_TEMPLATES"$'\n'"$1"
  1896	  else
  1897	    _DELIVERED_TEMPLATES="$1"
  1898	  fi
  1899	}
  1900	
  1901	# Register a VERBATIM (identity-route) destination, mirroring the schema
  1902	# precedent at :1318-1329: delivered == this run WROTE it, OR the pre-existing
  1903	# target is byte-identical to the framework source.
  1904	#
  1905	# The byte-compare half is load-bearing, not decoration. "Result-only"
  1906	# (register only when we wrote) drops all five registrations on a SECOND
  1907	# consecutive install — every destination is then EXISTS-skipped — and it
  1908	# ships GREEN, because no current Check runs install twice. Byte-identical is
  1909	# origin proof here: the content is framework-specific (the rendered CODEOWNERS
  1910	# names .claude/skills/**, .claude/hooks/**, .claude/plans/PLAN-*.md).
  1911	# PRESERVED (target differs) and SKIPPED (source missing) stay OUT — recording
  1912	# an adopter's own bytes as framework-owned is the class uninstall deletes on.
  1913	_register_delivered_template() {
  1914	  local dst_rel="$1" src_rel="$2"
  1915	  if [[ "$DRY_RUN" -eq 1 ]]; then return 0; fi
  1916	  # rail round-7 F2 — `cmp` follows symlinks too, so an unconfined source could
  1917	  # make an ADOPTER file compare equal to FOREIGN bytes and be registered as
  1918	  # framework-owned (uninstall deletes on that record). Refuse the comparison
  1919	  # rather than let it answer.
  1920	  if _install_src_refuses "$src_rel"; then
  1921	    return 0
  1922	  fi
  1923	  if [[ "${_DOCS_TEMPLATE_WROTE:-0}" = "1" ]] \
  1924	     || cmp -s "$SOURCE_DIR/$src_rel" "$TARGET/$dst_rel" 2>/dev/null; then
  1925	    _append_delivered_template "$dst_rel"
  1926	  fi
  1927	  return 0
  1928	}
