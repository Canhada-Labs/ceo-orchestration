  1966	  #
  1967	  # Relative-path heuristic (unchanged): if $SOURCE_DIR starts with $TARGET,
  1968	  # the framework was copied INTO the target — relative pointer. In ALL other
  1969	  # cases the body is written with the user-editable {{PROTOCOL_SOURCE}}
  1970	  # marker and the placeholder substitution pass below resolves it.
  1971	  command -v _render_protocol_pointer >/dev/null 2>&1 || {
  1972	    echo "    ERROR: _render_protocol_pointer unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot write PROTOCOL.md pointer" >&2
  1973	    return 1
  1974	  }
  1975	
  1976	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1977	    echo "    (dry-run) would CREATE: PROTOCOL.md (pointer)"
  1978	    return 0
  1979	  fi
