  2750	# Build the sed script iteratively. Each non-empty placeholder adds an
  2751	# expression. We use `|` as the delimiter so slashes in values (paths)
  2752	# don't break. Values with `|` are escaped.
  2753	build_sed_script() {
  2754	  local script=""
  2755	  _add_sub() {
  2756	    local key="$1" val="$2"
  2757	    if [[ -n "$val" ]]; then
  2758	      # Escape | & \ in the replacement
  2759	      local esc
  2760	      esc="$(printf '%s' "$val" | sed 's/[|&\\]/\\&/g')"
  2761	      script="${script}s|{{${key}}}|${esc}|g;"
  2762	    fi
  2763	  }
  2764	  _add_sub "OWNER_NAME"          "$PH_OWNER_NAME"
  2765	  _add_sub "OWNER_HANDLE"        "$GITHUB_OWNER"
  2766	  _add_sub "PROJECT_NAME"        "$PH_PROJECT_NAME"
  2767	  _add_sub "PROJECT_PATH"        "$PH_PROJECT_PATH"
  2768	  _add_sub "STACK"               "$PH_STACK"
  2769	  _add_sub "PROTOCOL_SOURCE"     "$PH_PROTOCOL_SOURCE"
  2770	  _add_sub "DEPLOY_COMMAND"      "$PH_DEPLOY_COMMAND"
  2771	  _add_sub "DEPLOY_PLATFORM"     "$PH_DEPLOY_PLATFORM"
  2772	  _add_sub "DEPLOY_TARGET"       "$PH_DEPLOY_TARGET"
  2773	  _add_sub "RUNTIME_NOTES"       "$PH_RUNTIME_NOTES"
  2774	  _add_sub "DATABASE"            "$PH_DATABASE"
  2775	  _add_sub "N_BACKEND"           "$PH_N_BACKEND"
  2776	  _add_sub "N_FRONTEND"          "$PH_N_FRONTEND"
  2777	  _add_sub "FRONTEND_STACK"      "$PH_FRONTEND_STACK"
  2778	  _add_sub "FRONTEND_PATH"       "$PH_FRONTEND_PATH"
  2779	  _add_sub "FRONTEND_REPO_PATH"  "$PH_FRONTEND_REPO_PATH"
  2780	  _add_sub "UI_LIBRARY"          "$PH_UI_LIBRARY"
  2781	  _add_sub "STATE_MANAGEMENT"    "$PH_STATE_MANAGEMENT"
  2782	  _add_sub "REALTIME_TRANSPORT"  "$PH_REALTIME_TRANSPORT"
  2783	  _add_sub "CHARTING_LIBRARY"    "$PH_CHARTING_LIBRARY"
  2784	  _add_sub "AUTH_PROVIDER"       "$PH_AUTH_PROVIDER"
  2785	  _add_sub "I18N_FRAMEWORK"      "$PH_I18N_FRAMEWORK"
  2786	  _add_sub "TEST_FRAMEWORK"      "$PH_TEST_FRAMEWORK"
  2787	  _add_sub "TEST_TOOL"           "$PH_TEST_TOOL"
  2788	  _add_sub "TEST_COUNT"          "$PH_TEST_COUNT"
  2789	  _add_sub "LINT_TOOL"           "$PH_LINT_TOOL"
  2790	  _add_sub "CI_TOOL"             "$PH_CI_TOOL"
  2791	  _add_sub "APP_NAME"            "$PH_APP_NAME"
  2792	  _add_sub "SOURCE_FILE_COUNT"   "$PH_SOURCE_FILE_COUNT"
  2793	  _add_sub "LINE_COUNT"          "$PH_LINE_COUNT"
  2794	  _add_sub "LINES"               "$PH_LINES"
  2795	  _add_sub "FILE_COUNT"          "$PH_FILE_COUNT"
  2796	  _add_sub "PAGE_COUNT"          "$PH_PAGE_COUNT"
  2797	  _add_sub "COMPONENT_COUNT"     "$PH_COMPONENT_COUNT"
  2798	  _add_sub "HOOK_COUNT"          "$PH_HOOK_COUNT"
  2799	  _add_sub "BUNDLE_SIZE"         "$PH_BUNDLE_SIZE"
  2800	  _add_sub "CITY"                "$PH_CITY"
  2801	  _add_sub "COUNTRY"             "$PH_COUNTRY"
  2802	  _add_sub "DOMAIN"              "$PH_DOMAIN"
  2803	  _add_sub "FOUNDER_NAME"        "${PH_FOUNDER_NAME:-$PH_OWNER_NAME}"
  2804	  _add_sub "LEGAL_ID"            "$PH_LEGAL_ID"
  2805	  _add_sub "PRODUCTION_URL"      "$PH_PRODUCTION_URL"
  2806	  printf '%s' "$script"
  2807	}
