  1452	# WS4-dispatcher-fn: E6-F5 fix — copy .claude/dispatcher/ (validate-governance.sh REQUIRES it)
  1453	install_dispatcher() {
  1454	  local src="$SOURCE_DIR/.claude/dispatcher"
  1455	  local dst="$TARGET/.claude/dispatcher"
  1456	  if [[ ! -d "$src" ]]; then
  1457	    echo "    SKIP: .claude/dispatcher/ absent in source" >&2
  1458	    return 0
  1459	  fi
  1460	  echo ""
  1461	  echo "==> Installing dispatcher (.claude/dispatcher/ — E6-F5 validate-governance gate)"
  1462	  _state_record_op "install_dispatcher" ".claude/dispatcher"
  1463	  local f
  1464	  if [[ "$DRY_RUN" -eq 1 ]]; then
