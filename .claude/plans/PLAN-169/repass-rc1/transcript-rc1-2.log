  1987	_claude_dir_gitignore_body() {
  1988	  # Paths are anchored with a leading slash so they bind to .claude/ ONLY and
  1989	  # cannot match a same-named path deeper in an adopter tree.
  1990	  printf '%s\n' \
  1991	    "# Delivered by ceo-orchestration (PLAN-177 W1 / CF-9)." \
  1992	    "#" \
  1993	    "# Per-machine posture + runtime state that must never reach VCS:" \
  1994	    "#   state/             runtime state as a whole (PLAN-163 T3.1)" \
  1995	    "#   settings.local.json  permission overlay deciding the NEXT session's" \
  1996	    "#                        posture (PLAN-165)" \
  1997	    "#" \
  1998	    "# The root .gitignore carries the same exclusions for adopters who track" \
  1999	    "# this tree from the repository root. This file additionally covers the" \
  2000	    "# --ceremony user install, which never writes outside .claude/ and so" \
  2001	    "# never received them." \
  2002	    "#" \
  2003	    "# Adopter-owned once created: install and upgrade never REPLACE this" \
  2004	    "# file — adopter bytes are preserved; missing mandatory framework" \
  2005	    "# security entries may be APPENDED (additively reasserted) on upgrade." \
  2006	    "/state/" \
  2007	    "/settings.local.json"
  2008	}
  2009	
  2010	_apply_claude_dir_gitignore() {
  2011	  # $1 = the adopter .claude directory.
  2012	  # Create when absent; when PRESENT, append only the entries that are
  2013	  # missing, per line, preserving every adopter byte (re-pass rc.4 t1
  2014	  # P1-b: an adopter with a pre-existing .claude/.gitignore -- e.g.
  2015	  # /cache/ only -- never received /state/ nor /settings.local.json,
  2016	  # so night-mode state stayed commit-eligible under --ceremony user;
  2017	  # create-if-missing alone proved the clean-target case only). Same
  2018	  # grep -Fxq per-entry predicate as the root blocks: the file stays
  2019	  # adopter-owned, nothing is rewritten, a deliberate edit to OUR
  2020	  # comment lines is never repaired.
  2021	  _cdg_dir="$1"
  2022	  _cdg_file="$_cdg_dir/.gitignore"
  2023	  # Re-pass rc.4 t2 (P1): NEVER follow a symlink here. A .claude/.gitignore
  2024	  # symlinked to another writable file would receive framework appends at
  2025	  # the EXTERNAL target; a dangling symlink passes `[ ! -e ]` and the
  2026	  # redirect would CREATE its target. -L catches both, before any read.
  2027	  if [ -L "$_cdg_file" ]; then
  2028	    echo "    ERROR: .claude/.gitignore is a symlink — refusing to read or write through it (preserve/replace it manually)" >&2
  2029	    return 1
  2030	  fi
  2031	  if [ ! -e "$_cdg_file" ]; then
