  3078	# release skill-manifest.sha256). EXCLUDES the manifest itself + .claude.bak/.
  3079	# Fail-open: any missing helper / unreadable file is skipped with a NOTE; the
  3080	# install never fails because the manifest could not be fully written.
  3081	# ----------------------------------------------------------------------
  3082	write_install_manifest() {
  3083	  # Guarded by the caller for DRY_RUN; defensive re-check here.
