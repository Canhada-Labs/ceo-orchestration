  2454	# ---- 6b. P2-SEC-H (PLAN-019 Phase 3 Wave 3B): MCP secrets directory ----
  2455	#
  2456	# The MCP server authenticates clients via HMAC shared secrets stored at
  2457	# $TARGET/state/mcp_client_secrets/<client_id>.key. auth.load_secret()
  2458	# rejects any file whose perms are not exactly 0o600. If the containing
  2459	# directory is world-traversable (0o755 default umask), it's possible
  2460	# for a coexisting process to enumerate client_ids. Force 0o700 at
  2461	# install time and emit a banner. Additionally, ensure target/.gitignore
  2462	# excludes the secrets dir so keys never end up in VCS.
  2463	install_mcp_secrets_dir() {
  2464	  local secrets_dir="$TARGET/state/mcp_client_secrets"
  2465	  local gitignore="$TARGET/.gitignore"
  2466	
  2467	  if [[ "$DRY_RUN" -eq 1 ]]; then
  2468	    echo ""
  2469	    echo "==> MCP secrets directory (P2-SEC-H)"
  2470	    if [[ -d "$secrets_dir" ]]; then
  2471	      echo "    (dry-run) EXISTS: state/mcp_client_secrets (would chmod 700)"
  2472	    else
  2473	      echo "    (dry-run) would CREATE: state/mcp_client_secrets (chmod 700)"
  2474	    fi
  2475	    # t8 P2: the SHARED predicate, not a duplicated -L — the preview must
  2476	    # refuse exactly where the real run refuses, by the same code path.
  2477	    if ! _root_gitignore_symlink_guard "$TARGET/.gitignore" >/dev/null 2>&1; then
  2478	      echo "    (dry-run) ERROR: root .gitignore is a symlink — real run would REFUSE" >&2
  2479	      exit 1
  2480	    fi
  2481	    # t11 P1 #2: honest dry-run for TRACKED sensitive paths too — the
  2482	    # real run refuses and demands git rm --cached.
  2483	    _dry_tracked="$( _gitignore_tracked_sensitive "$TARGET" \
  2484	      ".claude/settings.local.json" ".claude/state" "state/mcp_client_secrets" )"
  2485	    if [ -n "$_dry_tracked" ]; then
  2486	      echo "    (dry-run) ERROR: sensitive path(s) already TRACKED — real run would REFUSE and demand git rm --cached:" >&2
  2487	      printf '%s\n' "$_dry_tracked" | sed 's/^/      /' >&2
  2488	      exit 1
  2489	    fi
  2490	    echo "    (dry-run) would ENSURE .gitignore excludes state/mcp_client_secrets/"
  2491	    return 0
  2492	  fi
  2493	
  2494	  echo ""
  2495	  echo "==> MCP secrets directory (P2-SEC-H)"
  2496	  _state_record_op "ensure_mcp_secrets_dir" "state/mcp_client_secrets 0700"
  2497	  mkdir -p "$secrets_dir"
  2498	  chmod 700 "$secrets_dir"
  2499	  echo "    ENSURED: $secrets_dir (mode 0700)"
  2500	  echo ""
  2501	  echo "    NOTE: this directory stores HMAC shared secrets for MCP clients."
  2502	  echo "          File perms MUST be 0600; auth.load_secret() fail-closes otherwise."
  2503	  echo "          DO NOT commit its contents to VCS."
