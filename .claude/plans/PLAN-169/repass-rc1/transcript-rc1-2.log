   852	echo "==> S.10 — _wbm_route_table_ok and the exact-match prior-digest lookup"
   853	
   854	_table_ok() {  # $1=table -> "<rc>|<reason>"
   855	  bash -c '
   856	    set -uo pipefail
   857	    # shellcheck source=/dev/null
