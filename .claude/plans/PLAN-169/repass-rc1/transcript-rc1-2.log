  1981	  case "$SOURCE_DIR" in
  1982	    "$TARGET"/*)
  1983	      _render_protocol_pointer "$SOURCE_DIR" "$TARGET" "$PROFILE" "$STACK" "" > "$TARGET/PROTOCOL.md"
  1984	      ;;
  1985	    *)
  1986	      _render_protocol_pointer_degraded "$TARGET" "$PROFILE" "$STACK" > "$TARGET/PROTOCOL.md"
  1987	      ;;
  1988	  esac
  1989	  echo "    CREATED: PROTOCOL.md (pointer)"
  1990	  _state_record_op "install_protocol_pointer" "PROTOCOL.md"
  1991	  # PLAN-166 F3 (ADR-155-AMEND-1): registered delivery — this line is only
  1992	  # reached when the heredoc actually wrote the pointer (the pre-existing
  1993	  # early-return above never gets here, so an adopter's own root
