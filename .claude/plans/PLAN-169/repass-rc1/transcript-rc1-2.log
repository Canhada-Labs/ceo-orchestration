  1442	  _state_record_op "install_hooks" "selective (top-level + _lib)"
  1443	  install_lib_selective
  1444	  local f base
  1445	  for f in "$SOURCE_DIR/.claude/hooks/"*.sh "$SOURCE_DIR/.claude/hooks/"*.py; do
  1446	    [[ -f "$f" ]] || continue
  1447	    base="$( basename "$f" )"
  1448	    install_one ".claude/hooks/$base"
  1449	  done
  1450	}
