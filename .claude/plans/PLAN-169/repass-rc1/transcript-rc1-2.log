  1962	_apply_posture_state_ignores() {
  1963	  # $1 = path to the adopter ROOT .gitignore (append creates it if absent).
  1964	  _psi_gitignore="$1"
  1965	  _root_gitignore_symlink_guard "$_psi_gitignore" || return 1
  1966	  for _psi_line in $( _posture_state_ignore_entries ); do
  1967	    if [ -f "$_psi_gitignore" ] && grep -Fxq "$_psi_line" "$_psi_gitignore" 2>/dev/null; then
  1968	      echo "    .gitignore already excludes $_psi_line"
  1969	      continue
  1970	    fi
  1971	    {
  1972	      echo ""
  1973	      echo "# PLAN-165 CX-3: per-machine posture/runtime state (never commit)"
  1974	      echo "$_psi_line"
  1975	    } >> "$_psi_gitignore"
  1976	    echo "    APPENDED to .gitignore: $_psi_line"
  1977	  done
  1978	  # t8 P1: presence pass done — now assert EFFECTIVENESS per entry.
  1979	  _psi_repo="$( dirname "$_psi_gitignore" )"
  1980	  _gitignore_reassert_effective "$_psi_repo" "$_psi_gitignore" \
  1981	    ".claude/state/" ".claude/state/__ceo_ignore_probe__" || return 1
  1982	  _gitignore_reassert_effective "$_psi_repo" "$_psi_gitignore" \
  1983	    ".claude/settings.local.json" ".claude/settings.local.json" || return 1
  1984	  return 0
  1985	}
