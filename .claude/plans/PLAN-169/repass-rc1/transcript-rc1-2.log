   247	  . "$SCRIPT_DIR/_hash_lib.sh"
   248	fi
   249	if [ -f "$SCRIPT_DIR/_framework_manifest_set.sh" ]; then
   250	  # shellcheck source=scripts/_framework_manifest_set.sh
   251	  . "$SCRIPT_DIR/_framework_manifest_set.sh"
   252	fi
