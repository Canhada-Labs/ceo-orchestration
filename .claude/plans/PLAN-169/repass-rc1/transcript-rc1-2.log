   492	while [[ $# -gt 0 ]]; do
   493	  case "$1" in
   494	    --link)
   495	      MODE="link"; shift ;;
   496	    --profile)
   497	      PROFILE="${2:-}"; shift 2 ;;
   498	    --ceremony)  # WS4-ceremony-case
   499	      CEREMONY="${2:-}"
   500	      case "$CEREMONY" in
   501	        maintainer|user) ;;
   502	        *)
   503	          echo "ERROR: --ceremony must be 'maintainer' or 'user' (got: $CEREMONY)" >&2
   504	          exit 2
   505	          ;;
   506	      esac
   507	      shift 2 ;;
   508	    --stack)
   509	      STACK="${2:-}"; STACK_EXPLICIT=1; shift 2 ;;
   510	    --github-owner)
   511	      GITHUB_OWNER="${2:-}"
   512	      _assert_github_owner_grammar "$GITHUB_OWNER" "--github-owner"
   513	      shift 2 ;;
   514	    --with-reference-personas)
   515	      WITH_REFERENCE_PERSONAS=1; shift ;;
   516	    --dry-run)
   517	      DRY_RUN=1; shift ;;
   518	    --strict-placeholders)
   519	      # Session 75 Codex Finding 5: was advertised in docs/READINESS-STATUS.md
   520	      # but the parser rejected it. Now wired — mirrors CEO_INSTALL_STRICT_PH=1
   521	      # post-install validator (fails install if any `{{X}}` placeholder
   522	      # remains unsubstituted in installed files).
   523	      STRICT_PLACEHOLDERS=1; shift ;;
   524	    --verify)
   525	      # Session 75 Codex Finding 5: re-checksum installed skill SHAs vs
   526	      # source manifest. Basic integrity check; sigstore backend OUT OF
   527	      # SCOPE per Owner D2 lock.
   528	      VERIFY=1; shift ;;
   529	    --verify-sigstore)
   530	      # Session 76 audit-v3 Finding D / Codex DIM-19 closure: deprecated
   531	      # alias for `--verify`. Owner D2 (Session 75) ruled the sigstore
   532	      # backend out of scope, but SemVer policy in SPEC/v1/install-cli.md
   533	      # §Deprecation requires alias retention with stdout warning + 90-day
   534	      # window before MAJOR removal. This emits the warning and behaves
   535	      # identically to --verify; the sigstore transparency-log path is
   536	      # NOT reintroduced (per D2). deprecated_in 1.11.4 / removed_in 2.0.0.
   537	      printf 'WARNING: --verify-sigstore is deprecated since v1.11.4 (sigstore backend removed per Session 75 Owner D2 lock); use --verify instead. Will be removed in v2.0.0 — see SPEC/v1/install-cli.md §Deprecation.\n' >&2
   538	      VERIFY=1; shift ;;
   539	
   540	    --target)
   541	      # Accept --target <dir> as alias for the positional form, to match
   542	      # the PLAN-019 Wave 2A acceptance invocation.
   543	      if [[ -z "$TARGET" ]]; then
   544	        TARGET="${2:-}"
   545	      else
   546	        echo "ERROR: --target conflicts with positional target: $TARGET" >&2
   547	        exit 1
   548	      fi
   549	      shift 2 ;;
   550	
   551	    # Placeholder substitution flags
   552	    --owner)               PH_OWNER_NAME="${2:-}";         shift 2 ;;
   553	    --project)             PH_PROJECT_NAME="${2:-}";       shift 2 ;;
   554	    --project-path)        PH_PROJECT_PATH="${2:-}";       shift 2 ;;
   555	    --stack-name)          PH_STACK="${2:-}";              shift 2 ;;
   556	    --protocol-source)     PH_PROTOCOL_SOURCE="${2:-}";    shift 2 ;;
   557	    --deploy-command)      PH_DEPLOY_COMMAND="${2:-}";     shift 2 ;;
   558	    --deploy-platform)     PH_DEPLOY_PLATFORM="${2:-}";    shift 2 ;;
   559	    --deploy-target)       PH_DEPLOY_TARGET="${2:-}";      shift 2 ;;
   560	    --runtime-notes)       PH_RUNTIME_NOTES="${2:-}";      shift 2 ;;
   561	    --database)            PH_DATABASE="${2:-}";           shift 2 ;;
   562	    --n-backend)           PH_N_BACKEND="${2:-}";          shift 2 ;;
