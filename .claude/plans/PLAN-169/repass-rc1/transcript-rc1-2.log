+  # caller instead of falling through to the empty-answer path below.
+  _wbm_nl_out="$( stat -c '%h' "$1" 2>/dev/null || stat -f '%l' "$1" 2>/dev/null || true )"
+  case "$_wbm_nl_out" in
+    ''|*[!0-9]*) _wbm_nl_out="$( ls -ld "$1" 2>/dev/null | awk 'NR==1 {print $2}' || true )" ;;
