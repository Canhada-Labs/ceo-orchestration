  2169	SETTINGS_DST="$TARGET/.claude/settings.json"
  2169	SETTINGS_DST="$TARGET/.claude/settings.json"
  2170	BASE_SRC="$SOURCE_DIR/templates/settings/settings.base.json"
  2170	BASE_SRC="$SOURCE_DIR/templates/settings/settings.base.json"
