  2255	    # sandbox keys, not just its hooks — otherwise `--stack sandbox` ships a
  2256	    # settings.json with the hook fragment but NO `.sandbox` /
  2257	    # `.autoAllowBashIfSandboxed`, leaving the OS-sandbox template inert.
