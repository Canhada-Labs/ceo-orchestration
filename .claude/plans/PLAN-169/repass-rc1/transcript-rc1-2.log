  2643	  # PLAN-168 W2 (AC-6, Owner decision D1-b): the body comes from the ONE
  2644	  # shared generator in _framework_manifest_set.sh — never a private heredoc.
  2645	  # INV-4 existed because this function and upgrade.sh each carried their own
  2646	  # copy of this text; a silent local fallback would resurrect the class, so
  2647	  # a missing generator is a broken checkout and fails LOUD.
  2648	  #
  2649	  # Relative-path heuristic (unchanged): if $SOURCE_DIR starts with $TARGET,
  2650	  # the framework was copied INTO the target — relative pointer. In ALL other
  2651	  # cases the body is written with the user-editable {{PROTOCOL_SOURCE}}
  2652	  # marker and the placeholder substitution pass below resolves it.
  2653	  command -v _render_protocol_pointer >/dev/null 2>&1 || {
  2654	    echo "    ERROR: _render_protocol_pointer unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot write PROTOCOL.md pointer" >&2
  2655	    return 1
  2656	  }
