  2556	    # real run refuses and demands git rm --cached.
  2557	    _dry_tracked="$( _gitignore_tracked_sensitive "$TARGET" \
  2558	      ".claude/settings.local.json" ".claude/state" "state/mcp_client_secrets" )"
