   254	# if absent (partial checkout), --harness codex degrades to a clear error at
   255	# use; the default claude path never references it.
   256	if [ -f "$SCRIPT_DIR/_codex_harness.sh" ]; then
   257	  # shellcheck source=scripts/_codex_harness.sh
   258	  . "$SCRIPT_DIR/_codex_harness.sh"
   259	fi
