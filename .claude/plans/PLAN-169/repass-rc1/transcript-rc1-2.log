  2750	# Build the sed script iteratively. Each non-empty placeholder adds an
  2751	# expression. We use `|` as the delimiter so slashes in values (paths)
  2752	# don't break. Values with `|` are escaped.
  2753	build_sed_script() {
  2754	  local script=""
  2755	  _add_sub() {
