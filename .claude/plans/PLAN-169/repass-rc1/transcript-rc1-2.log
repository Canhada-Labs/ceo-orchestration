  1366	      _wbm_target="$( readlink "$_wbm_abs" 2>/dev/null || true )"
  1367	      [ -n "$_wbm_target" ] || continue
  1368	      case "$_wbm_target" in
  1369	        *[$'\n\r\t']*) continue ;;
  1370	      esac
  1371	      printf 'LINK  %s  %s\n' "$_wbm_rel" "$_wbm_target" >> "$_wbm_tmp"
  1372	    elif [ -L "$_wbm_abs" ]; then
  1373	      # A live symlink that did NOT qualify as a LINK record (wrong mode, or
  1374	      # rejected by _wbm_link_allowed) must never fall through to the hash
  1375	      # branch: POSIX -f FOLLOWS the link, and the record would serialize the
  1376	      # ADOPTER's target content as a framework HASH delivery — a new route
  1377	      # around INV-2 (repass-r2 part-a V4). No record at all: not delivered.
  1378	      echo "    NOTE: symlink $_wbm_rel not recorded (no LINK authorization; refusing to hash through it)" >&2
  1379	      continue
  1380	    elif [ -f "$_wbm_abs" ]; then
  1381	      if [ "$_wbm_rel" = "PROTOCOL.md" ]; then
  1382	        # Generated pointer. Use the CANONICAL pointer hash (FMS_PROTOCOL_HASH,
  1383	        # exported by upgrade.sh _refresh_protocol_pointer) so a PRESERVED
  1384	        # adopter-customized PROTOCOL.md is NOT re-recorded as its own baseline
  1385	        # (Codex R2 P0 — else the next upgrade reads H_dst==H_base and clobbers
  1386	        # it). On install (no FMS_PROTOCOL_HASH) the target IS the freshly
  1387	        # written pointer, so hashing it directly is correct.
  1388	        if [ -n "${FMS_PROTOCOL_HASH:-}" ]; then
  1389	          _wbm_digest="$FMS_PROTOCOL_HASH"
  1390	        else
  1391	          _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )"
  1392	        fi
  1393	      elif _wbm_is_conditional "$_wbm_rel"; then
  1394	        _wbm_decl="$( _wbm_declared_hash_source "$_wbm_rel" )"
  1395	        case "$_wbm_decl" in
  1396	          HASH_SOURCE)
  1397	            # FMS_SOURCE_ROOT, never FMS_HASH_ROOT: the global override is an
  1398	            # upgrade-only mechanism, and borrowing it here is what dragged
  1399	            # install into the r8-F1 rendered-tree regression.
  1400	            if [ -n "${FMS_SOURCE_ROOT:-}" ] && [ -f "$FMS_SOURCE_ROOT/$_wbm_rel" ]; then
  1401	              _wbm_digest="$( _hash_file "$FMS_SOURCE_ROOT/$_wbm_rel" 2>/dev/null || true )"
  1402	            else
  1403	              continue   # the framework no longer ships it: record nothing
  1404	            fi
  1405	            ;;
  1406	          HASH_PRIOR_RECORD)   _wbm_digest="$( _wbm_prior_digest "$_wbm_rel" )" ;;
  1407	          HASH_CANONICAL_POINTER) _wbm_digest="${FMS_PROTOCOL_HASH:-}" ;;
  1408	          HASH_TARGET)         _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )" ;;
  1409	          HASH_NONE)           continue ;;
  1410	          *)
  1411	            # FAIL-CLOSED, scoped to the three conditional surfaces (Owner
  1412	            # ratified 2026-08-07). Under-claiming is recoverable; over-claiming
  1413	            # is the delete-the-adopter's-file class.
  1414	            echo "    NOTE: $_wbm_rel delivered but declared no hash_source —" >&2
  1415	            echo "          NOT recorded (fail-closed; ownership under-claimed)" >&2
  1416	            continue
  1417	            ;;
  1418	        esac
  1419	        case "$_wbm_digest" in
  1420	          "" ) continue ;;
  1421	        esac
  1422	      else
  1423	        # Hash the FRAMEWORK version. When FMS_HASH_ROOT is set (upgrade) and the
  1424	        # path is ABSENT there, the framework no longer ships it — OMIT it from
  1425	        # the baseline (recording the adopter-retained target file would falsely
  1426	        # mark it FRAMEWORK-CHANGED if the framework later reintroduces the
  1427	        # path). Codex R2 P1.
  1428	        _wbm_hash_path="$_wbm_abs"
  1429	        if [ -n "${FMS_HASH_ROOT:-}" ] && _wbm_hash_root_applies "$_wbm_rel"; then
  1430	          # PLAN-183 W5 (D3): resolve the SOURCE relpath through the shared
  1431	          # route table before touching $_wbm_hash_root. Identity-mapped paths
  1432	          # (rc=1, no row) keep today's "$root/$rel" behaviour exactly.
  1433	          _wbm_src_rel="$_wbm_rel"
  1434	          _wbm_route_rc=0
  1435	          _wbm_route_out="$( _wbm_route_src "$_wbm_rel" )" || _wbm_route_rc=$?
  1436	          case "$_wbm_route_rc" in
  1437	            0) _wbm_src_rel="$_wbm_route_out" ;;
  1438	            2)
  1439	              # RENDERED (or malformed row): the delivered bytes exist in NO
  1440	              # checkout, so this lane has nothing to hash. Today's behaviour
  1441	              # was to `continue` SILENTLY — the silence is the defect, not
  1442	              # the skip. Name the path.
  1443	              echo "    NOTE: $_wbm_rel is delivered through a TRANSFORM (or its route row is malformed) —" >&2
  1444	              echo "          no framework source bytes on this lane; NOT recorded (fail-closed)" >&2
  1445	              continue
  1446	              ;;
  1447	            *) : ;;   # rc=1: no route row — identity destination, unchanged
  1448	          esac
  1449	          if [ -f "$_wbm_hash_root/$_wbm_src_rel" ]; then
  1450	            _wbm_hash_path="$_wbm_hash_root/$_wbm_src_rel"
  1451	          else
  1452	            continue   # framework no longer ships this path — no baseline record
  1453	          fi
  1454	        fi
  1455	        _wbm_digest="$( _hash_file "$_wbm_hash_path" 2>/dev/null || true )"
  1456	      fi
  1457	      case "$_wbm_digest" in
  1458	        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  1459	        *) continue ;;
  1460	      esac
