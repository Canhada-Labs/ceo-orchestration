   292	    routes = []  # type: List[Dict[str, str]]
   293	    seen = set()  # type: set
   294	    saw_header = False
   295	    for lineno, line in enumerate(raw.splitlines(), start=1):
   296	        if not line.strip() or line.lstrip().startswith("#"):
   297	            continue
   298	        fields = line.split("\t")
