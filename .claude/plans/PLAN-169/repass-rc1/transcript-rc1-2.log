   752	# ---------------------------------------------------------------------
   753	# F-CHAOS-2/DevOps-P1-1: atomic install + rollback-on-failure
   754	# ---------------------------------------------------------------------
   755	# Strategy:
   756	#   - If $TARGET/.claude/ already exists, snapshot it to $BACKUP_DIR.
   757	#   - On ANY failure (trap EXIT rc != 0), remove the partial
   758	#     $TARGET/.claude/ and move the backup back into place.
   759	#   - On success, remove the backup in an explicit cleanup step.
   760	# The backup is placed in a unique mktemp tempdir so it cannot collide
   761	# with user data.
   762	
   763	BACKUP_DIR=""
   764	INSTALL_SUCCEEDED=0
   765	
   766	# WS4-mtime-helper: portable file mtime (epoch seconds) — GNU + BSD stat.
   767	detect_mtime() {
   768	  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || echo 0
   769	}
   770	
   771	cleanup_on_failure() {
   772	  local rc=$?
   773	  # PLAN-153 Wave B item B1 — the ops journal lives OUTSIDE $TARGET; drop it
   774	  # on every exit path (fail-open, never affects rc).
   775	  if [[ -n "${_STATE_OPS_FILE:-}" ]]; then rm -f "$_STATE_OPS_FILE" 2>/dev/null || true; fi
   776	  # PLAN-185 W2 — the staging file of an in-flight atomic write. Every failure
   777	  # path inside the writer removes it; this is the trap half, for an abort
   778	  # BETWEEN mktemp and mv (a signal, or `set -e` firing in a callee). Without
   779	  # it a `.ceo-codeowners.XXXXXX` would be left in the adopter's .github/.
   780	  if [[ -n "${_ATOMIC_TMP_PENDING:-}" ]]; then rm -f "$_ATOMIC_TMP_PENDING" 2>/dev/null || true; fi
   781	  if [[ "$DRY_RUN" -eq 1 ]]; then
   782	    # Dry-run never touches $TARGET, so never restore.
   783	    exit "$rc"
   784	  fi
   785	  if [[ "$INSTALL_SUCCEEDED" -eq 1 ]]; then
   786	    # Success — clean the backup silently.
   787	    if [[ -n "$BACKUP_DIR" && -d "$BACKUP_DIR" ]]; then
   788	      rm -rf "$BACKUP_DIR" 2>/dev/null || true
   789	    fi
   790	    exit "$rc"
   791	  fi
   792	  if [[ $rc -ne 0 && -n "$BACKUP_DIR" && -d "$BACKUP_DIR/.claude" ]]; then
   793	    echo "::error::install failed (rc=$rc) — restoring $TARGET/.claude from $BACKUP_DIR" >&2
   794	    if [[ -d "$TARGET/.claude" ]]; then
   795	      rm -rf "$TARGET/.claude" 2>/dev/null || true
   796	    fi
   797	    mv "$BACKUP_DIR/.claude" "$TARGET/.claude" 2>/dev/null || true
   798	    rm -rf "$BACKUP_DIR" 2>/dev/null || true
   799	    echo "::error::rollback complete — target restored to pre-install state" >&2
   800	  fi
   801	  exit "$rc"
   802	}
   803	
   804	# PLAN-185 W1 (rail round-4 P1) — EVERY path the EXIT trap deletes is
   805	# initialised HERE, before the trap can fire, so none of them can be inherited
   806	# from the caller's environment.
   807	#
   808	# The trap runs `rm -f` on `_STATE_OPS_FILE` and `_ATOMIC_TMP_PENDING`, and
   809	# `rm -rf` on `BACKUP_DIR`. `BACKUP_DIR` was already set above; the other two
   810	# were not — `_ATOMIC_TMP_PENDING` was first assigned inside the atomic writer
   811	# (which `--dry-run` never calls at all) and `_STATE_OPS_FILE` ten lines BELOW
   812	# the trap. Either one exported by the caller was an arbitrary path the trap
   813	# deleted on any exit. REPRODUCED against the pre-cure shadow:
   814	#
   815	#   env _ATOMIC_TMP_PENDING=/path/to/unrelated/file install.sh TARGET --dry-run
   816	#
   817	# exited 0 — with the "no files modified" promise on the label — and the
   818	# unrelated file was GONE. Same class this file already documents for
   819	# `_DELIVERED_TEMPLATES` (:841): a variable the script only ever writes is still
   820	# a variable the environment can seed.
   821	_ATOMIC_TMP_PENDING=""
   822	_STATE_OPS_FILE=""
   823	
   824	trap cleanup_on_failure EXIT
