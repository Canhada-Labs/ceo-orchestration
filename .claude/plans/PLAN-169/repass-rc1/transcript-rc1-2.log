   211	# Resolve SCRIPT_DIR with a readlink-with-fallback so the script works
   212	# when invoked via a symlink (e.g. from /usr/local/bin/install-ceo).
   213	_resolve_script_path() {
   214	  local src="$1"
   215	  # If GNU/BSD readlink is available, prefer it; fall back to $src as-is.
   216	  if command -v readlink >/dev/null 2>&1; then
   217	    # Try `readlink -f` (GNU) first; on macOS this may not exist, so
   218	    # fall through to plain readlink which follows one symlink level.
   219	    local resolved
   220	    if resolved="$(readlink -f "$src" 2>/dev/null)" && [ -n "$resolved" ]; then
   225	    while [ -L "$src" ]; do
   226	      local link_target
   227	      link_target="$(readlink "$src")"
   228	      case "$link_target" in
   229	        /*) src="$link_target" ;;
   230	        *)  src="$(cd "$(dirname "$src")" && pwd)/$link_target" ;;
   231	      esac
   232	    done
   233	  fi
   234	  printf '%s\n' "$src"
   235	}
   236	
   237	SCRIPT_SRC="$(_resolve_script_path "${BASH_SOURCE[0]}")"
   238	SCRIPT_DIR="$( cd "$( dirname "$SCRIPT_SRC" )" && pwd )"
   239	SOURCE_DIR="$( cd "$SCRIPT_DIR/.." && pwd )"
   240	
   241	# PLAN-138 Wave C (ADR-155) — portable SHA-256 helpers + the single shared
   242	# framework-owned enumeration. Sourced (not executed). Fail-open: if the
   243	# helper is somehow absent (partial checkout), the baseline-manifest step is
   244	# simply skipped later — the install itself never depends on it.
   245	if [ -f "$SCRIPT_DIR/_hash_lib.sh" ]; then
   246	  # shellcheck source=scripts/_hash_lib.sh
   247	  . "$SCRIPT_DIR/_hash_lib.sh"
   248	fi
   249	if [ -f "$SCRIPT_DIR/_framework_manifest_set.sh" ]; then
   250	  # shellcheck source=scripts/_framework_manifest_set.sh
   251	  . "$SCRIPT_DIR/_framework_manifest_set.sh"
   252	fi
   253	# PLAN-155 Wave 5 — Codex harness emission (sourced, not executed). Fail-open:
   254	# if absent (partial checkout), --harness codex degrades to a clear error at
   255	# use; the default claude path never references it.
   256	if [ -f "$SCRIPT_DIR/_codex_harness.sh" ]; then
   257	  # shellcheck source=scripts/_codex_harness.sh
   258	  . "$SCRIPT_DIR/_codex_harness.sh"
   259	fi
   260	
   261	# PLAN-156 Wave 4 — Grok harness emission (sourced, not executed). Same
   262	# fail-open shape as the codex source above: absent => --harness grok
   263	# degrades to a clear error at use; the default claude path never references it.
   264	if [ -f "$SCRIPT_DIR/_grok_harness.sh" ]; then
   265	  # shellcheck source=scripts/_grok_harness.sh
   266	  . "$SCRIPT_DIR/_grok_harness.sh"
   267	fi
