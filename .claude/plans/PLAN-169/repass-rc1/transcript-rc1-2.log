   262	# fail-open shape as the codex source above: absent => --harness grok
   263	# degrades to a clear error at use; the default claude path never references it.
   264	if [ -f "$SCRIPT_DIR/_grok_harness.sh" ]; then
   265	  # shellcheck source=scripts/_grok_harness.sh
