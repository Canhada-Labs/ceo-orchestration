   670	
   671	# --- PLAN-185 W1: DESTINATION confinement ----------------------------------
   672	# The link count of a path, or EMPTY when it cannot be read.
   673	#
   674	# Moved here from upgrade.sh's _up_tpl_nlink (which now consumes it) so that
   675	# ONE implementation answers "how many names does this inode have?" for both
   676	# sides of the delivery. Two copies of a confinement primitive drifting apart
   677	# is the exact mechanism of PLAN-183 D1-D4, six sessions of red main.
   678	#
   679	# GNU-first with the output VALIDATED, because on GNU `stat -f` SUCCEEDS
   680	# printing FILESYSTEM information rather than failing; `ls -ld` is the last
   681	# resort. An EMPTY answer means the infrastructure could not tell us, and
   682	# CLAUDE.md §4 makes that fail-OPEN: the caller does not refuse on it.
   683	_wbm_nlink() {
   684	  # `|| true` is load-bearing under `set -euo pipefail`: a failing pipeline
   685	  # inside a command substitution makes the ASSIGNMENT fail, which aborts the
   686	  # caller instead of falling through to the empty-answer path below.
   687	  _wbm_nl_out="$( stat -c '%h' "$1" 2>/dev/null || stat -f '%l' "$1" 2>/dev/null || true )"
   688	  case "$_wbm_nl_out" in
   689	    ''|*[!0-9]*) _wbm_nl_out="$( ls -ld "$1" 2>/dev/null | awk 'NR==1 {print $2}' || true )" ;;
   690	  esac
   691	  case "$_wbm_nl_out" in
   692	    ''|*[!0-9]*) printf '' ;;
   693	    *)           printf '%s\n' "$_wbm_nl_out" ;;
   694	  esac
   695	}
   696	
   697	# Is this destination one the installer may write? The mirror of
   698	# _wbm_source_confined, on the side that WRITES.
   699	#
   700	# WHY THIS EXISTS: install.sh decides whether to write by testing the
   701	# destination for EXISTENCE, and `-e` FOLLOWS symlinks. A DANGLING link planted
   702	# at a destination answers false, so the writer takes the "nothing there yet"
   703	# branch and `cp`/`>` write THROUGH the link, outside $TARGET. MEASURED
   704	# pre-cure (S329) against the live installer: with `docs/rotation-log.md` a
   705	# dangling symlink to a path outside the target, a `--ceremony maintainer`
   706	# install exited 0, logged `COPIED:`, and 536 bytes landed at the external
   707	# path. A RESOLVED link and a symlinked ANCESTOR escape the same way; a HARD
   708	# LINK escapes while every path check passes, because a second name for one
   709	# inode is not a link any path walk can see.
   710	#
   711	# Three walls, all required:
   712	#   1. LEXICAL — the relpath must be confined, through the same
   713	#      _wbm_route_relpath_ok every other confined path in this library uses
   714	#      (absolute, `..`, empty segment, glob metacharacter, whitespace).
   715	#   2. NO SYMLINK COMPONENT — every component under the physical target root is
   716	#      tested with `-L`, leaf INCLUDED. `-L` is true for a DANGLING link, which
   717	#      is precisely the form the `-e` guard is blind to.
   718	#   3. PHYSICAL CONTAINMENT — the deepest EXISTING ancestor must resolve
   719	#      (cd -P/pwd -P; the bash 3.2 floor has no realpath) under the physically
   720	#      resolved root.
   721	# Plus two properties of the LEAF that walls 1-3 cannot express: an existing
   722	# leaf must be a REGULAR FILE or a DIRECTORY, and it must not carry a second
   723	# hard link. Refusing every OTHER file type is the PLAN-185 W0 inversion
   724	# applied here — enumerate the forms proven safe to write, refuse the rest —
   725	# so a fifo or a device node at a destination is a named refusal rather than a
   726	# form nobody modelled.
   727	#
   728	# POLICY IS NOT HERE (debate C5). This answers "must this destination be
   729	# refused?" and publishes the reason; whether that means FAIL, SKIP or
   730	# ACCUMULATE belongs to the caller — install_one keeps the EXISTS-skip its
   731	# tests fix, while the delivery writers accumulate a named refusal and fail the
   732	# run at the end.
   733	#
   734	# TOCTOU, declared: between this answer and the write, nothing prevents the
   735	# destination from BECOMING a symlink. bash offers no openat/O_NOFOLLOW, so the
   736	# window is irreducible — this narrows it, it does not close it.
   737	#
   738	# $1 = target root (absolute). $2 = destination relpath.
   739	# rc 0 = REFUSE the write, reason in _WBM_DST_REFUSE_WHY. rc 1 = confined.
   740	# The polarity is the one _install_src_refuses and _up_tpl_multilink_refuses
   741	# already use: the function is named for what a 0 MEANS.
   742	_WBM_DST_REFUSE_WHY=""
   743	# Structural check shared by the destination guard and the upgrader's early
   744	# delivery preflight. Callers validate the relative path first. Inspect only
   745	# STRICT ancestors: an absent directory can be created, but a regular file,
   746	# FIFO or other non-directory cannot be traversed by mkdir — and neither can
   747	# a symlink that does not RESOLVE to a directory (dangling, or pointing at a
   748	# file): `-e`/`-d` follow the link, so those two shapes are refused here too.
   749	# A symlink that resolves to a directory is NOT this helper's call — that
   750	# policy stays with each caller's existing confinement guard (the full
   751	# destination predicate refuses every symlink component; the forced SPEC/v1
   752	# route accepts a `--mode link` leaf). Pre-cure the `! -L` test skipped every
   753	# symlink, so `SPEC -> file` passed both preflights and the run aborted at
   754	# `mkdir` with the target already written (Codex review of the cure).
   755	_wbm_dst_non_directory_ancestor_refuses() {
   756	  local rel="$2" rest="$2" walk="$1" seg
   757	  _WBM_DST_REFUSE_WHY=""
   758	  while :; do
   759	    case "$rest" in
   760	      */*) seg="${rest%%/*}"; rest="${rest#*/}" ;;
   761	      *) break ;;
   762	    esac
   763	    walk="$walk/$seg"
   764	    if [ -L "$walk" ] && [ ! -e "$walk" ]; then
   765	      _WBM_DST_REFUSE_WHY="'$walk' is a DANGLING symlink — a non-directory ancestor of '$rel'; the destination cannot be created"
   766	      return 0
   767	    fi
   768	    if [ -e "$walk" ] && [ ! -d "$walk" ]; then
   769	      _WBM_DST_REFUSE_WHY="'$walk' is a non-directory ancestor of '$rel' — the destination cannot be created"
   770	      return 0
   771	    fi
   772	  done
   773	  return 1
   774	}
   775	
   776	_wbm_dst_refuses() {
   777	  _WBM_DST_REFUSE_WHY=""
   778	  _wbm_dr_root="${1:-}"
   779	  _wbm_dr_rel="${2:-}"
   780	  if [ -z "$_wbm_dr_root" ] || [ -z "$_wbm_dr_rel" ]; then
   781	    _WBM_DST_REFUSE_WHY="empty target root or destination relpath"
   782	    return 0
   783	  fi
   784	  if ! _wbm_route_relpath_ok "$_wbm_dr_rel"; then
   785	    _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' is not a confined relative path"
   786	    return 0
   787	  fi
   788	  # An ABSENT target root is not a refusal (rail round-1 P2). Nothing exists
   789	  # under a directory that does not exist, so there is no component to follow
   790	  # and nothing to escape through — the lexical wall above has already done the
   791	  # only work available. Refusing here instead broke `install.sh --dry-run`
   792	  # against a target that does not exist yet, which is SUPPORTED behaviour
   793	  # (preview without creating): measured pre-cure, 12 destinations came back
   794	  # "does not resolve" and the run exited 1.
   795	  #
   796	  # The ROOT is tested for being a symlink BEFORE it is resolved (rail round-2
   797	  # P1). The previous order asked `! -e` first, so only a DANGLING root was ever
   798	  # tested with `-L`: a RESOLVED symlink root answered `-e` true, fell through to
   799	  # `cd -P`, and silently moved the confinement BASE to the referent. MEASURED:
   800	  # with the target passed as a symlink to a real directory, the install ran to
   801	  # completion, 567 files landed under the referent and zero landed anywhere
   802	  # else — so containment held, but the comment here claimed a refusal that the
   803	  # code did not perform, and `install.sh` resolves the target with plain
   804	  # `cd`/`pwd` (LOGICAL path, symlink preserved), so the case is reachable on
   805	  # every real install.
   806	  #
   807	  # It is a REFUSAL, not a warning, and the reason carries the recovery: the
   808	  # operator re-runs against the referent. That keeps the gate fail-closed while
   809	  # costing a legitimate symlinked project directory exactly one re-run with the
   810	  # path the message prints — and it makes the dereference an explicit choice
   811	  # instead of something the installer did on the operator's behalf without
   812	  # saying so. Note `-L` tests only the LAST component, so an ordinary path that
   813	  # merely traverses a symlinked ancestor (/tmp -> /private/tmp on macOS) is
   814	  # unaffected.
   815	  if [ -L "$_wbm_dr_root" ]; then
   816	    _wbm_dr_ref="$( cd -P "$_wbm_dr_root" 2>/dev/null && pwd -P || true )"
   817	    if [ -n "$_wbm_dr_ref" ]; then
   818	      _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' is a SYMLINK to '$_wbm_dr_ref' — every write would follow it; re-run against '$_wbm_dr_ref' if that is the directory you meant"
   819	    else
   820	      _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' is a DANGLING symlink — every write under it would follow the link outside the target"
   821	    fi
   822	    return 0
   823	  fi
   824	  if [ ! -e "$_wbm_dr_root" ]; then
   825	    return 1
   826	  fi
   827	  _wbm_dr_phys="$( cd -P "$_wbm_dr_root" 2>/dev/null && pwd -P || true )"
   828	  if [ -z "$_wbm_dr_phys" ]; then
   829	    _WBM_DST_REFUSE_WHY="the target root '$_wbm_dr_root' exists but does not resolve to a directory"
   830	    return 0
   831	  fi
   832	  if _wbm_dst_non_directory_ancestor_refuses "$_wbm_dr_phys" "$_wbm_dr_rel"; then
   833	    return 0
   834	  fi
   835	  _wbm_dr_walk="$_wbm_dr_phys"
   836	  _wbm_dr_rest="$_wbm_dr_rel"
   837	  while [ -n "$_wbm_dr_rest" ]; do
   838	    case "$_wbm_dr_rest" in
   839	      */*) _wbm_dr_seg="${_wbm_dr_rest%%/*}"; _wbm_dr_rest="${_wbm_dr_rest#*/}" ;;
   840	      *)   _wbm_dr_seg="$_wbm_dr_rest";       _wbm_dr_rest="" ;;
   841	    esac
   842	    _wbm_dr_walk="$_wbm_dr_walk/$_wbm_dr_seg"
   843	    if [ -L "$_wbm_dr_walk" ]; then
   844	      if [ -e "$_wbm_dr_walk" ]; then
   845	        _WBM_DST_REFUSE_WHY="component '$_wbm_dr_seg' of '$_wbm_dr_rel' is a symlink — the write would follow it outside the target"
   846	      else
   847	        _WBM_DST_REFUSE_WHY="component '$_wbm_dr_seg' of '$_wbm_dr_rel' is a DANGLING symlink — the existence test guarding this write answers false and the write follows the link outside the target"
   848	      fi
   849	      return 0
   850	    fi
   851	  done
   852	  _wbm_dr_anc="$( dirname "$_wbm_dr_phys/$_wbm_dr_rel" )"
   853	  while [ -n "$_wbm_dr_anc" ] && [ ! -d "$_wbm_dr_anc" ]; do
   854	    _wbm_dr_next="$( dirname "$_wbm_dr_anc" )"
   855	    [ "$_wbm_dr_next" != "$_wbm_dr_anc" ] || break
   856	    _wbm_dr_anc="$_wbm_dr_next"
   857	  done
   858	  _wbm_dr_res="$( cd -P "$_wbm_dr_anc" 2>/dev/null && pwd -P || true )"
   859	  if [ -z "$_wbm_dr_res" ]; then
   860	    _WBM_DST_REFUSE_WHY="the nearest existing ancestor of '$_wbm_dr_rel' does not resolve"
   861	    return 0
   862	  fi
   863	  case "$_wbm_dr_res" in
   864	    "$_wbm_dr_phys"|"$_wbm_dr_phys"/*) ;;
   865	    *)
   866	      _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' resolves to $_wbm_dr_res, outside the target $_wbm_dr_phys"
   867	      return 0
   868	      ;;
   869	  esac
   870	  _wbm_dr_leaf="$_wbm_dr_phys/$_wbm_dr_rel"
   871	  if [ -e "$_wbm_dr_leaf" ]; then
   872	    if [ ! -f "$_wbm_dr_leaf" ] && [ ! -d "$_wbm_dr_leaf" ]; then
   873	      _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' exists and is neither a regular file nor a directory — no proven-safe way to write it"
   874	      return 0
   875	    fi
   876	    if [ -f "$_wbm_dr_leaf" ]; then
   877	      _wbm_dr_n="$( _wbm_nlink "$_wbm_dr_leaf" )"
   878	      if [ -n "$_wbm_dr_n" ] && [ "$_wbm_dr_n" -gt 1 ] 2>/dev/null; then
   879	        _WBM_DST_REFUSE_WHY="'$_wbm_dr_rel' has $_wbm_dr_n hard links — writing it would change every other name for the same inode, including names outside the target"
   880	        return 0
   881	      fi
   882	    fi
   883	  fi
   884	  return 1
   885	}
   886	
   887	# --- PLAN-185 W2: the GitHub handle grammar, with ONE owner -----------------
   888	# The SAME grammar upgrade.sh:3700 has enforced since PLAN-183 §9.2, expressed
   889	# once, here, where both executables can reach it. Its comment there says in as
   890	# many words that it exists so the upgrade cannot reproduce the 0-byte
   891	# CODEOWNERS defect — while install.sh, the script that PRODUCES the defect,
   892	# accepted the flag raw. A third implementation would have been the fourth
   893	# local branch of one shared value (debate C6).
   894	#
   895	# Equivalent to the Python `^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$`: 1-39
   896	# characters, first alphanumeric, rest alphanumeric or hyphen. The character
   897	# sets are ENUMERATED rather than written as `[A-Za-z0-9]` ranges because a
   898	# shell range is resolved through the locale's collating sequence, which in a
   899	# UTF-8 locale can admit characters Python's codepoint ranges never match — and
   900	# a grammar that answers differently in two locales is not one grammar.
   901	#
   902	# What the closed set buys, and it is the whole point: the value cannot contain
   903	# `/` (the sed delimiter that produced the 0-byte CODEOWNERS), `&` or `\` (sed
   904	# replacement metacharacters), a newline, whitespace, or a shell metacharacter.
   905	#
   906	# DELIBERATELY NARROW (OQ-2, Owner default): `org/team` is valid CODEOWNERS
   907	# syntax — the template renders `@{{OWNER_HANDLE}}`, so `@org/team` names a
   908	# TEAM — and this grammar rejects it. Supporting teams means changing the
   909	# delimiter in every consumer, which is its own wave; until then the refusal
   910	# says so instead of corrupting the file.
   910	# says so instead of corrupting the file.
   911	# rc 0 = the value is a handle this framework may interpolate.
   912	#
   913	# rc.1 re-pass part 2 P2 — the predicate and the error text both call this a
   914	# GitHub-handle grammar, and it accepted `owner-` and `a--b`, which GitHub
   915	# does not issue. The installer then exited 0 after rendering that token into
   916	# every CODEOWNERS rule, so the repository carried the syntax of review
   917	# routing with none of the protection the success message implies. Two
   918	# refusals close the gap without renaming the contract: a final alphanumeric
   919	# character, and no consecutive hyphens. The consumers (install.sh's
   920	# `_assert_github_owner_grammar`, upgrade.sh's install-state reader,
   921	# doctor.sh) all pass through THIS function, so tightening it here tightens
   922	# them together — which is the reason it is one function and not three.
   923	_wbm_github_handle_ok() {
   924	  _wbm_gh_v="${1:-}"
   925	  [ -n "$_wbm_gh_v" ] || return 1
   926	  [ "${#_wbm_gh_v}" -le 39 ] || return 1
   927	  case "$_wbm_gh_v" in
   928	    [!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]*) return 1 ;;
   929	    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-]*) return 1 ;;
   930	    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789]) return 1 ;;
   931	    *--*) return 1 ;;
   932	  esac
   933	  return 0
   934	}
   935	
   936	# One row's fields, validated together. Emits a breadcrumb NAMING the offending
   937	# row on stderr — a rejection nobody can see is the silence D3 was made of.
   938	# rc 0 = the row may be used; rc 1 = rejected.
   939	#
   940	# This is the ONE choke point every reader passes through (_wbm_route_src via
   941	# _wbm_route_meta, _wbm_route_dests, and therefore _wbm_route_dest_declared),
   942	# which is why the round-5 domain check lands here and not in each caller: a
   943	# rejected row drops out of _wbm_route_dests, `routes < rows` becomes true, and
   944	# upgrade.sh's AC-9 precondition turns the whole delivery into a named failure
   945	# with exit 3 (rounds 3/4 semantics) instead of a partial write.
   946	_wbm_route_row_ok() {
   947	  if ! _wbm_route_relpath_ok "${1:-}"; then
   948	    echo "    ERROR: delivery-route row REJECTED (invalid destination): '${1:-}' in $_WBM_ROUTES_TSV" >&2
   949	    return 1
   950	  fi
   951	  if ! _wbm_route_relpath_ok "${2:-}"; then
   952	    echo "    ERROR: delivery-route row REJECTED (invalid source '${2:-}') for destination '${1}' in $_WBM_ROUTES_TSV" >&2
   953	    return 1
   954	  fi
   955	  if ! _wbm_route_domain_ok "${1:-}" "${2:-}"; then
   956	    echo "    ERROR: delivery-route row REJECTED (outside delivery domain): '${1:-}' <- '${2:-}' in $_WBM_ROUTES_TSV — delivery writes ONLY docs/<name>.md, .github/CODEOWNERS[.template] or .github/workflows/<name>.template, from templates/" >&2
   957	    return 1
   958	  fi
   959	  return 0
   960	}
   961	
   962	# --- rail round-5 F4: ONE accessor for a row's metadata --------------------
   963	# Prints "<src><TAB><transform>" for the row naming destination $1, AFTER the
   964	# row has passed _wbm_route_row_ok.
   965	#   rc 0 = a valid row exists (its transform may be ANY declared value —
   966	#          judging the transform is the caller's job, reading it is not);
   967	#   rc 1 = no table, or no row for this destination;
   968	#   rc 2 = the row exists and was REJECTED (never collapse this into rc=1:
   969	#          rc=1 is answered by the callers' identity fallback "$root/$rel",
   970	#          which for a poisoned row hands back exactly the D3 behaviour).
   971	#
   972	# WHY: upgrade.sh's rendered-CODEOWNERS branch used to pull `src` and
   973	# `transform` out of the table with its own two `awk` calls — a FOURTH parser
   974	# of the shared table, which ADR-194 vetoes by name, and one that would not
   975	# have inherited the round-1/3/5 validators or the round-4 unterminated-row
   976	# fix. This is the accessor it calls instead. _wbm_route_src is now a thin
   977	# projection of the same row, so the file holds ONE loop over the table for
   978	# per-destination lookups, not two that can drift.
   979	#
   980	# rail round-4 F4 — `|| [ -n "$dest" ]`: a final row with NO trailing newline
   981	# fills the read variables but returns non-zero, so a bare `while read` DROPS
   982	# it. MEASURED pre-cure (S327) on a newline-stripped copy of the real table:
   983	# _wbm_route_dests emitted 5 of 6 destinations and _wbm_route_rows_total
   984	# counted 5 — the two agreed, so upgrade.sh's AC-9 precondition
   985	# (routes == rows) PASSED and the run shipped omitting the last delivery,
   986	# exit 0. A disagreement is visible; an agreed-upon undercount is not.
   987	# The row is still put through _wbm_route_row_ok: "process it" is not "trust
   988	# it", and a TRUNCATED final row (missing the transform field) still resolves
   989	# fail-closed at the caller, which sees an empty transform.
   990	# bash 3.2: `read` clears the variables on a true EOF, so the guard is false
   991	# on the next pass and the loop terminates (verified on 3.2.57 for the
   992	# unterminated, terminated and empty-file cases).
   993	# It ALSO publishes the two fields as _WBM_ROUTE_SRC / _WBM_ROUTE_TRANSFORM
   994	# (always reset at entry, filled only on rc=0). That is not decoration: it lets
   995	# a hot caller read them WITHOUT a command substitution. doctor.sh asks
   996	# _wbm_route_src once per manifest record — several hundred per run — and a
   997	# subshell per record is a fork per record for a linear scan of six rows.
   998	_wbm_route_meta() {
   999	  _wbm_rm_want="${1:-}"
  1000	  _wbm_rm_rc=1
  1001	  _WBM_ROUTE_SRC=""
  1002	  _WBM_ROUTE_TRANSFORM=""
  1003	  [ -n "$_wbm_rm_want" ] || return 1
  1004	  # rail round-6 F2 — the TABLE is validated before any ROW is consumed, and
  1005	  # an unusable table answers 2, never 1. rc=1 is the identity fallback
  1006	  # ("$root/$rel") every caller applies, which for a table nobody could parse
  1007	  # is defect D3/D4 arriving through a header instead of a wrong branch. This
  1008	  # also SUBSUMES the old `[ ! -f ]` check: a missing file is one of the ways
  1009	  # a table is unusable, and it now gets the same fail-closed answer.
  1010	  _wbm_route_table_gate || return 2
  1011	  while IFS="$( printf '\t' )" read -r _wbm_rm_dest _wbm_rm_src _wbm_rm_transform _wbm_rm_rest \
  1012	        || [ -n "${_wbm_rm_dest:-}" ]; do
  1013	    if [ -z "${_wbm_rm_dest:-}" ]; then continue; fi
  1014	    case "$_wbm_rm_dest" in \#*|dest) continue ;; esac
  1015	    if [ "$_wbm_rm_dest" != "$_wbm_rm_want" ]; then continue; fi
  1016	    if ! _wbm_route_row_ok "$_wbm_rm_dest" "${_wbm_rm_src:-}"; then
  1017	      _wbm_rm_rc=2
  1018	      break
  1019	    fi
  1020	    _WBM_ROUTE_SRC="$_wbm_rm_src"
  1021	    _WBM_ROUTE_TRANSFORM="${_wbm_rm_transform:-}"
  1022	    printf '%s\t%s\n' "$_WBM_ROUTE_SRC" "$_WBM_ROUTE_TRANSFORM"
  1023	    _wbm_rm_rc=0
  1024	    break
  1025	  done < "$_WBM_ROUTES_TSV"
  1026	  return "$_wbm_rm_rc"
  1027	}
  1028	
  1029	# The IDENTITY projection of _wbm_route_meta: the source relpath, and only for
  1030	# a route the framework copies VERBATIM.
  1031	#   rc 0 = identity route, source relpath on stdout
  1032	#   rc 1 = no row (callers keep today's behaviour: "$root/$rel")
  1033	#   rc 2 = RENDERED, or malformed => there are no framework source bytes to
  1034	#          hash. `${transform}` is compared against the literal `identity` and
  1035	#          nothing else: `:-identity` as a DEFAULT was the rail S325 fail-OPEN
  1036	#          finding that let a truncated row be treated as copyable.
  1037	_wbm_route_src() {
  1038	  _wbm_rs_rc=0
  1039	  # In-process (stdout discarded, fields read from the globals), never
  1040	  # `$( _wbm_route_meta ... )`: this is the per-manifest-record hot path.
  1041	  _wbm_route_meta "${1:-}" >/dev/null || _wbm_rs_rc=$?
  1042	  [ "$_wbm_rs_rc" -eq 0 ] || return "$_wbm_rs_rc"
  1043	  case "${_WBM_ROUTE_TRANSFORM:-}" in
  1044	    identity)
