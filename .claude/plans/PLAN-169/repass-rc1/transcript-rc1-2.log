  3340	    echo "    link authorization: $( printf '%s\n' "$FMS_LINK_PATHS" | grep -c . || true ) path(s) authorized for LINK records (created this run + still-valid prior records)"
  3341	  fi
  3342	  _write_baseline_manifest "$manifest"
  3343	  unset FMS_ROOT FMS_PROFILE_PARTS FMS_MODE FMS_HASH_ROOT FMS_PROTOCOL_HASH \
  3344	        FMS_PRIOR_MANIFEST FMS_HASH_SOURCE_SPEC FMS_HASH_SOURCE_PROTOCOL \
  3345	        FMS_HASH_SOURCE_MARKER
