  1950	# PLAN-185 W2 — render {{OWNER_HANDLE}} with NO substitution LANGUAGE involved.
  1951	#
  1952	# The pre-cure form was `sed "s/{{OWNER_HANDLE}}/$GITHUB_OWNER/g"`, which puts
  1953	# the value inside a sed PROGRAM: a `/` ends the s-command, `&` re-inserts the
  1954	# match, `\` escapes. Escaping the value would only make the interpolation
  1955	# survivable; this removes the interpolation. The marker is a literal, `{` and
  1956	# `}` are not bash pattern metacharacters, and the replacement side of `${//}`
  1957	# has no active characters at all — so no value can change what this program
  1958	# DOES, only what it writes. That is also why the census stops seeing a
  1959	# sed-interpolation site here: the site is gone, not escaped.
  1960	#
  1961	# `|| [[ -n "$line" ]]` keeps a final line that lacks its newline (the shipped
  1962	# template ends with one — measured, 1442 bytes / 33 lines / 11 markers).
  1963	_render_owner_handle() {
  1964	  local _roh_src="$1" _roh_handle="$2"
  1965	  local _roh_marker='{{OWNER_HANDLE}}'
  1966	  local _roh_line
  1967	  while IFS= read -r _roh_line || [[ -n "$_roh_line" ]]; do
  1968	    printf '%s\n' "${_roh_line//$_roh_marker/$_roh_handle}"
  1969	  done < "$_roh_src"
  1970	}
