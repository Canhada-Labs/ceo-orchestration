+    */../*)        return 1 ;;   # embedded ..
+    */..)          return 1 ;;   # trailing ..
+    *//*)          return 1 ;;   # empty segment
+    *\\*)          return 1 ;;   # backslash
+    *\**)          return 1 ;;   # glob metacharacter *
