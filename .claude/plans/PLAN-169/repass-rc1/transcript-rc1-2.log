   447	print_help() {
   448	  # PLAN-087 B.6: print the full help block (was truncating at line 80
   449	  # which silently dropped the --verify-sigstore deprecation notice and
   450	  # the LGPD/fintech placeholder flags --city/--country/--domain/
   451	  # --founder-name/--legal-id/--production-url). Range bounded by the
   452	  # "Portability:" trailer to stay drift-stable. Bounded by the
