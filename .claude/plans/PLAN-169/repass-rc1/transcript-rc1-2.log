  2774	  _add_sub "DATABASE"            "$PH_DATABASE"
  2775	  _add_sub "N_BACKEND"           "$PH_N_BACKEND"
  2776	  _add_sub "N_FRONTEND"          "$PH_N_FRONTEND"
  2777	  _add_sub "FRONTEND_STACK"      "$PH_FRONTEND_STACK"
  2778	  _add_sub "FRONTEND_PATH"       "$PH_FRONTEND_PATH"
  2779	  _add_sub "FRONTEND_REPO_PATH"  "$PH_FRONTEND_REPO_PATH"
  2780	  _add_sub "UI_LIBRARY"          "$PH_UI_LIBRARY"
  2781	  _add_sub "STATE_MANAGEMENT"    "$PH_STATE_MANAGEMENT"
  2782	  _add_sub "REALTIME_TRANSPORT"  "$PH_REALTIME_TRANSPORT"
  2783	  _add_sub "CHARTING_LIBRARY"    "$PH_CHARTING_LIBRARY"
