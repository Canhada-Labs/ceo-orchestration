  2302	# ---- 6a. PLAN-153 Wave E item 3: coarse credential-read deny baseline ----
  2303	#
  2304	# Injects a small permissions.deny baseline into the settings.json THIS
  2305	# install run just produced.
  2306	#
  2307	# HONEST FRAMING (never sold as coverage): this is a coarse harness
  2308	# backstop. Claude Code Read deny rules cover the built-in file tools and
  2309	# the file commands the harness recognizes inside Bash (cat/head/tail/sed),
  2310	# but NOT arbitrary subprocesses that open files themselves; Bash pattern
  2311	# rules are trivially bypassable by rephrasing. The pipe-to-shell class is
  2312	# OWNED by check_bash_safety.py's parse gate — the single
  2313	# "Bash(curl * | bash)" entry here is a tripwire, not the rail.
  2314	# Scope, residuals, and opt-out: docs/deny-baseline.md.
  2315	#
  2316	# Exclusion note (ratified fallback): Claude Code evaluates deny before
  2317	# allow and "a deny rule can't carry allowlist exceptions", so
  2318	# "deny **/.env.* except .env.example" is NOT expressible via deny+allow.
  2319	# We therefore deny SPECIFIC sensitive .env variants only; .env.example /
  2320	# .env.sample / .env.template stay readable because they are simply not
  2321	# listed. Residual: unlisted variants (e.g. .env.secret) pass the backstop.
  2322	#
  2323	# Idempotency: runs ONLY when this run created settings.json
  2324	# (SETTINGS_PRE_EXISTING=0). Re-running install skips settings.json
  2325	# entirely, so removed entries are never re-added. The merge itself is
  2326	# also order-preserving + deduplicating, so even a forced re-apply cannot
  2327	# duplicate entries.
  2328	#
  2329	# Fail-open on infrastructure (house rule): if neither jq nor python3 is
  2330	# available, or the merge fails, WARN with manual instructions and leave
  2331	# the just-copied settings.json untouched.
  2332	#
  2333	# Opt-out: CEO_INSTALL_SKIP_DENY_BASELINE=1 (mirrors CEO_INSTALL_SKIP_SELF_SHA).
  2334	
  2335	DENY_BASELINE_ENTRIES=(
  2336	  "Read(~/.ssh/**)"
  2337	  "Read(~/.aws/**)"
  2338	  "Read(~/.npmrc)"
  2339	  "Read(~/.config/gcloud/**)"
  2340	  "Read(~/.kube/config)"
  2341	  "Read(~/.docker/config.json)"
  2342	  "Read(~/.git-credentials)"
  2343	  "Read(~/.netrc)"
  2344	  "Read(~/.pypirc)"
  2345	  "Read(**/.env)"
  2346	  "Read(**/.env.local)"
  2347	  "Read(**/.env.*.local)"
  2348	  "Read(**/.env.development)"
  2349	  "Read(**/.env.dev)"
  2350	  "Read(**/.env.production)"
  2351	  "Read(**/.env.prod)"
  2352	  "Read(**/.env.staging)"
  2353	  "Read(**/.env.test)"
  2354	  "Read(**/.env.ci)"
  2355	  "Bash(curl * | bash)"
  2356	)
