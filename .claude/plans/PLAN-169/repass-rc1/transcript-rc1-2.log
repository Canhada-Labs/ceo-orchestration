  1882	_posture_state_ignore_entries() {
  1883	  printf '%s\n' ".claude/state/ .claude/settings.local.json"
  1884	}
  1885	
  1886	_root_gitignore_symlink_guard() {
  1887	  # $1 = path to the adopter ROOT .gitignore. 0 = safe; 1 = symlink
  1888	  # (re-pass rc.4 t3 P2: shared predicate for APPLY *and* dry-run
  1889	  # previews — the preview must never say "would ENSURE" where the real
  1890	  # run refuses).
  1891	  if [ -L "$1" ]; then
  1892	    echo "    ERROR: root .gitignore is a symlink — refusing to write through it" >&2
  1893	    return 1
  1894	  fi
  1895	  return 0
  1896	}
  1897	
  1898	# t8 P1: textual PRESENCE of an exact ignore line is not EFFECTIVENESS —
  1899	# a later `!*.json` negation in the same (or a deeper) file wins in git,
  1900	# so `grep -Fxq` alone let night-mode artifacts stay commit-eligible.
  1901	# _gitignore_reassert_effective probes git's EFFECTIVE answer for each
  1902	# mandatory exclusion; when a probe is visible it APPENDS the exclusion
  1903	# again (after the winning negation — last matching rule wins) and
  1904	# re-probes; a still-visible probe fails loudly (the negation lives in a
  1905	# file this applier does not own, e.g. a deeper .gitignore).
  1906	#   $1 = repo root to run git in; $2 = gitignore file to re-assert into;
  1907	#   $3 = the raw exclusion line; $4 = repo-relative probe path.
  1908	# Outside a git work tree the probe cannot run — NOTE and return 0
  1909	# (fail-open on infra; the textual pass above already ran).
  1910	_gitignore_reassert_effective() {
  1911	  _gre_repo="$1"; _gre_file="$2"; _gre_line="$3"; _gre_probe="$4"
  1912	  if ! git -C "$_gre_repo" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  1913	    echo "    NOTE: not a git work tree — cannot probe effective ignore for $_gre_line"
  1914	    return 0
  1915	  fi
  1916	  # t10 P1 #2: ignore rules NEVER affect files already in the index — a
  1917	  # pre-rc.4 adopter who committed the posture/secret path stays dirty no
  1918	  # matter what this file says. Detect tracked content FIRST and require
  1919	  # an explicit migration; this is fail-CLOSED because leaving it silent
  1920	  # is exactly the leak this delivery exists to close.
  1921	  case "$_gre_probe" in
  1922	    */__ceo_ignore_probe__) _gre_scope="$( dirname "$_gre_probe" )" ;;
  1923	    *)                      _gre_scope="$_gre_probe" ;;
  1924	  esac
  1925	  # sed, never `head` (t11 P2): under the callers' pipefail, head closing
  1926	  # the pipe early makes ls-files exit 141 and aborts the WHOLE upgrade
  1927	  # before the migration message prints (the repo's known SIGPIPE class).
  1928	  _gre_tracked="$( git -C "$_gre_repo" ls-files -- "$_gre_scope" 2>/dev/null | sed -n '1,5p' )"
  1929	  if [ -n "$_gre_tracked" ]; then
  1930	    echo "    ERROR: $_gre_scope is already TRACKED by git — an ignore rule cannot protect it." >&2
  1931	    echo "      Migrate explicitly, then re-run:" >&2
  1932	    printf '%s\n' "$_gre_tracked" | while IFS= read -r _gre_t; do
  1933	      echo "        git rm --cached '$_gre_t'" >&2
  1934	    done
  1935	    return 1
  1936	  fi
  1937	  # t10 P1 #2: --no-index — plain check-ignore consults the index and
  1938	  # reports a tracked path as unmatched, causing a re-assert loop; the
  1939	  # question here is strictly "does the PATTERN SET cover this path?".
  1940	  if git -C "$_gre_repo" check-ignore -q --no-index -- "$_gre_probe" 2>/dev/null; then
  1941	    return 0
  1942	  fi
  1943	  {
  1944	    echo ""
  1945	    echo "# Re-asserted by ceo-orchestration (re-pass rc.4 t8 P1): a later"
  1946	    echo "# rule in this file negated the mandatory exclusion below; git's"
  1947	    echo "# last-matching-rule-wins makes this trailing copy effective."
  1948	    printf '%s\n' "$_gre_line"
  1949	  } >> "$_gre_file"
  1950	  if git -C "$_gre_repo" check-ignore -q --no-index -- "$_gre_probe" 2>/dev/null; then
  1951	    echo "    RE-ASSERTED (was textually present but negated): $_gre_line"
  1952	    return 0
  1953	  fi
  1954	  # t10 P1 #1: a still-visible SECURITY exclusion is a FAILURE, not a
  1955	  # warning — returning 0 here let install/upgrade finish green while
  1956	  # the secret store stayed commit-eligible (e.g. a deeper
  1957	  # state/.gitignore re-including it, which outranks this file).
  1958	  echo "    ERROR: $_gre_line is present but NOT effective (a rule outside $_gre_file wins — e.g. a deeper .gitignore re-including it). Fix the adopter ignore rules, then re-run." >&2
  1959	  return 1
  1960	}
