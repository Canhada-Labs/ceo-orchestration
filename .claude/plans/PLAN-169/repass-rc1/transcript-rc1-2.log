   460	# PLAN-185 W2 — validate the GitHub handle AT THE PARSE BOUNDARY, through the
   461	# ONE grammar scripts/_framework_manifest_set.sh owns (_wbm_github_handle_ok,
   462	# adopted from the one upgrade.sh:3700 already enforced).
   463	#
   464	# WHY HERE: this is the single point that covers all three interpolation sites
   465	# at once — the CODEOWNERS render, the EXISTS byte-compare probe, and the
   466	# placeholder substitution — plus the install-state persistence. MEASURED
   467	# pre-cure (S329): `--github-owner 'acme/platform'` was accepted raw, the `/`
   468	# closed the `sed` s-command early, sed exited "bad flag in substitute
   469	# command", and `>` had ALREADY truncated .github/CODEOWNERS to 0 bytes. That
   470	# file then survives as EXISTS-skipped forever, the rollback never reaches it
   471	# (the snapshot covers $TARGET/.claude only), and GitHub reads an empty
   472	# CODEOWNERS as "no owners".
   473	#
   474	# Fail-CLOSED when the predicate is missing: this validates INPUT, and content
   475	# a guard cannot parse is refused rather than waved through (CLAUDE.md §4).
   476	# exit 2 is the established code for a rejected flag VALUE (--ceremony, :471).
   477	_assert_github_owner_grammar() {
   478	  local _ago_val="$1" _ago_where="$2"
   479	  if ! command -v _wbm_github_handle_ok >/dev/null 2>&1; then
   480	    echo "ERROR: cannot validate $_ago_where — scripts/_framework_manifest_set.sh was not sourced (partial checkout)." >&2
   481	    echo "       Refusing rather than interpolating an unvalidated value into .github/CODEOWNERS." >&2
   482	    exit 2
   483	  fi
   484	  if ! _wbm_github_handle_ok "$_ago_val"; then
