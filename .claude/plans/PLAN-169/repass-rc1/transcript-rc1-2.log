  2809	apply_placeholder_substitutions() {
  2810	  local sed_script
  2811	  sed_script="$(build_sed_script)"
  2812	
  2813	  if [[ -z "$sed_script" ]]; then
  2814	    echo ""
  2815	    echo "==> Placeholder substitution: no values supplied (use --owner / --project / env vars)"
  2816	    echo "    Template files ship as-is. Edit them manually or re-run install.sh with flags."
  2817	    return 0
  2818	  fi
  2819	
  2820	  echo ""
  2821	  echo "==> Applying placeholder substitutions"
  2822	  _state_record_op "apply_placeholder_substitutions" ""
  2823	
  2824	  # Files we are allowed to rewrite — strictly the template-sourced files
  2825	  # that install.sh just placed. We check existence first.
  2826	  #
  2827	  # We intentionally do NOT touch:
  2828	  #   - .claude/settings.json          (user-edited hook registry)
  2829	  #   - .claude/plans/PLAN-*.md        (user's own plans)
  2830	  #   - .claude/adr/ADR-*.md           (user's own ADRs)
  2831	  #   - .claude/scripts/*              (executable code; placeholders
  2832	  #     inside .py docstrings are instructional, not install-time)
  2833	  #   - .claude/hooks/*                (same reason)
  2834	  # WS4-explicit-files-partition: maintainer rewrites root + docs/ +
  2835	  # .claude/ template files; user ceremony rewrites ONLY .claude/ files so
  2836	  # a real adopter repo's own root/docs files are never touched.
  2837	  local explicit_files=(
  2838	    "$TARGET/.claude/team.md"
  2839	    "$TARGET/.claude/frontend-team.md"
  2840	    "$TARGET/.claude/agent-metrics.md"
  2841	  )
  2842	  if [[ "$CEREMONY" != "user" ]]; then
  2843	    explicit_files=(
  2844	      "$TARGET/CLAUDE.md"
  2845	      "$TARGET/MEMORY.md"
  2846	      "$TARGET/PROTOCOL.md"
  2847	      "$TARGET/docs/BRANCH-PROTECTION.md"
  2848	      "$TARGET/docs/rotation-log.md"
  2849	      "$TARGET/.claude/team.md"
  2850	      "$TARGET/.claude/frontend-team.md"
  2851	      "$TARGET/.claude/agent-metrics.md"
  2852	    )
  2853	  fi
  2854	
  2855	  local f
  2856	  for f in "${explicit_files[@]}"; do
  2857	    # NUNCA substituir atraves de um symlink que o instalador NAO criou
  2858	    # (pair-rail S300 r11 P1-1 + refinamento r20): [[ -f ]] segue o
  2859	    # link e o sed-inplace o MATERIALIZA como arquivo regular — um
  2860	    # symlink do ADOTANTE (EXISTS-skipped pelo install_one) teria o
  2861	    # conteudo reescrito E viraria hash record de framework (classe
  2862	    # V4/V5 por rota nova). Links criados NESTA run
  2863	    # (_CREATED_LINK_RELPATHS) mantem a semantica shipped do link-mode:
  2864	    # a substituicao acontece como sempre aconteceu.
  2865	    if [[ -L "$f" ]]; then
  2866	      _aps_rel="${f#$TARGET/}"
  2867	      _aps_created=0
  2868	      while IFS= read -r _aps_c; do
  2869	        [[ -n "$_aps_c" ]] || continue
  2870	        [[ "$_aps_c" == "$_aps_rel" ]] && { _aps_created=1; break; }
  2871	      done <<< "${_CREATED_LINK_RELPATHS:-}"
  2872	      if [[ "$_aps_created" -ne 1 ]]; then
  2873	        echo "    SKIP (pre-existing symlink — not substituting through it): $_aps_rel"
  2874	        continue
  2875	      fi
  2876	    fi
  2877	    [[ -f "$f" ]] || continue
  2878	    if [[ "$DRY_RUN" -eq 1 ]]; then
  2879	      echo "    (dry-run) would SUBSTITUTE placeholders in: ${f#$TARGET/}"
  2880	      continue
  2881	    fi
  2882	    portable_sed_inplace "$sed_script" "$f"
  2883	    echo "    SUBSTITUTED: ${f#$TARGET/}"
  2884	  done
  2885	
  2886	  # Skills/**/SKILL*.md, skills/**/team-personas.md + pitfalls.yaml, and
  2887	  # progressive-disclosure references/*.md (PLAN-153 Wave C splits) —
  2888	  # these are canonical content that ships {{PROJECT_NAME}}, {{OWNER_NAME}},
  2889	  # {{DEPLOY_COMMAND}}, {{FRONTEND_REPO_PATH}}, {{APP_NAME}},
  2890	  # {{PRODUCTION_URL}}, etc. as installer-time substitutions (not
  2891	  # instructional placeholders). Recurse into the skills tree.
  2892	  local skills_root="$TARGET/.claude/skills"
  2893	  if [[ -d "$skills_root" ]]; then
  2894	    while IFS= read -r f; do
  2895	      [[ -n "$f" && -f "$f" ]] || continue
  2896	      if [[ "$DRY_RUN" -eq 1 ]]; then
  2897	        echo "    (dry-run) would SUBSTITUTE placeholders in: ${f#$TARGET/}"
  2898	        continue
  2899	      fi
  2900	      portable_sed_inplace "$sed_script" "$f"
  2901	      echo "    SUBSTITUTED: ${f#$TARGET/}"
  2902	    done < <(find "$skills_root" \
  2903	      \( -name 'SKILL.md' -o -name 'SKILL-*.md' \
  2904	         -o -name 'team-personas.md' -o -name 'pitfalls.yaml' \
  2905	         -o -path '*/references/*.md' -o -path '*/reference/*.md' \) \
  2906	      -type f 2>/dev/null)
  2907	  fi
  2908	}
