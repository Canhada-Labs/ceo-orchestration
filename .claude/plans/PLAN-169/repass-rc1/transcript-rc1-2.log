  3351	# ----------------------------------------------------------------------
  3352	# PLAN-153 Wave B item B1 — persist the install-state.
  3353	# ----------------------------------------------------------------------
  3354	# Writes $TARGET/.claude/.install-state.json (next to the ADR-155 baseline
  3355	# manifest): the ORIGINAL request — verbatim argv + every parsed flag + the
  3356	# RESOLVED placeholder map (CLI > env > deterministic default; empty values
  3357	# omitted) — plus the operation journal for THIS run.
  3358	#
  3359	#   * Atomic: python writes a same-directory tempfile, then os.replace().
  3360	#   * Updated on every run: first_recorded_at + run_count + a bounded
  3361	#     history (last 20 runs) survive re-installs; request/operations
  3362	#     reflect the LATEST run.
  3363	#   * Schema-versioned: schema ceo.install-state/v1, schema_version 1.
  3364	#   * Consumed by upgrade.sh (PLAN-153 B2): request.profile/request.stack
  3365	#     become upgrade DEFAULTS when its own flags are omitted. A missing or
  3366	#     invalid state file degrades upgrade.sh to the ADR-155 drift-classifier
  3367	#     path — never an error, never a no-op (debate C back-compat must-fix).
  3368	#   * TRUST: target-side, UNSIGNED, advisory — the same trust class as the
  3369	#     ADR-155 baseline manifest (whoever can write the target tree can
  3370	#     rewrite it). upgrade.sh charset-validates every replayed value and
  3371	#     falls back on anything suspect; values are data, never eval-ed.
  3372	#   * Fail-open: no python3 / write error => stderr NOTE, install still
  3373	#     succeeds. Dry-run never writes (the "no files modified" promise).
  3374	#   * NOT covered by the baseline-manifest enumeration (like the manifest
  3375	#     dotfile itself), so the upgrade classifier never touches it.
  3376	_write_install_state() {
  3377	  [[ "${DRY_RUN:-0}" -eq 0 ]] || return 0
  3378	  if ! command -v python3 >/dev/null 2>&1; then
  3379	    echo "    NOTE: install-state skipped (python3 not found) — upgrade.sh will use the ADR-155 fallback path" >&2
  3380	    return 0
  3580	  fi
  3581	  echo "    WROTE: .claude/.install-state.json (schema ceo.install-state/v1, atomic)"
  3582	  return 0
  3583	}
