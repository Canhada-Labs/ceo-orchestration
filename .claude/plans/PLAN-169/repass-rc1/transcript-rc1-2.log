  2197	build_settings() {
  2198	  # PLAN-185 W1 — the refusal was recorded when SETTINGS_DST was resolved. This
  2199	  # returns 0 rather than a failing rc on purpose: a non-zero return here is
  2200	  # `exit "$build_rc"` at the call site, an abort in the MIDDLE of delivery, and
  2201	  # docs/ + .github/ have no restore path. The run fails at the end instead,
  2202	  # with the whole refusal list (_dst_refusal_verdict).
  2203	  if [[ "${_SETTINGS_DST_REFUSED:-0}" -eq 1 ]]; then
  2204	    return 0
  2205	  fi
  2206	  if [[ "$DRY_RUN" -eq 1 ]]; then
  2207	    if [[ -e "$SETTINGS_DST" ]]; then
  2208	      echo "    (dry-run) EXISTS (would skip settings.json)"
  2209	      return 0
  2210	    fi
  2211	    if [[ "$STACK" == "none" ]]; then
  2212	      echo "    (dry-run) would COPY settings.base.json -> .claude/settings.json (base only)"
  2213	      return 0
  2214	    fi
  2215	    local stack_src="$SOURCE_DIR/templates/settings/settings.stack.$STACK.json"
  2216	    if [[ ! -f "$stack_src" ]]; then
  2217	      echo "    (dry-run) stack '$STACK' not found at $stack_src — would fall back to base only"
  2218	      return 0
  2219	    fi
  2220	    if command -v jq >/dev/null 2>&1; then
  2221	      echo "    (dry-run) would MERGE settings.base.json + settings.stack.$STACK.json -> .claude/settings.json"
  2222	    else
  2223	      if [[ "$STACK_EXPLICIT" -eq 1 ]]; then
  2224	        echo "    (dry-run) FATAL: jq not found and --stack $STACK was explicit — would exit rc=3"
  2225	      else
  2226	        echo "    (dry-run) jq not found — would warn + base only"
  2227	      fi
  2228	    fi
  2229	    return 0
  2230	  fi
  2231	
  2232	  if [[ -e "$SETTINGS_DST" ]]; then
  2233	    echo "    EXISTS (skipping settings.json — edit manually if you want to re-build)"
  2234	    return 0
  2235	  fi
  2236	  if [[ ! -f "$BASE_SRC" ]]; then
  2237	    echo "    ERROR: base settings template missing at $BASE_SRC" >&2
  2238	    return 1
  2239	  fi
  2240	  if [[ "$STACK" == "none" ]]; then
  2241	    cp "$BASE_SRC" "$SETTINGS_DST"
  2242	    echo "    COPIED: settings.base.json -> .claude/settings.json (base only, no stack hooks)"
  2243	    return 0
  2244	  fi
  2245	
  2246	  local stack_src="$SOURCE_DIR/templates/settings/settings.stack.$STACK.json"
  2247	  if [[ ! -f "$stack_src" ]]; then
  2248	    echo "    WARNING: stack '$STACK' not found at $stack_src — falling back to base only" >&2
  2249	    cp "$BASE_SRC" "$SETTINGS_DST"
  2250	    return 0
  2251	  fi
  2252	
  2253	  if command -v jq >/dev/null 2>&1; then
  2254	    # S4a (PLAN-136 W4): the reducer must also pull the stack's TOP-LEVEL
  2255	    # sandbox keys, not just its hooks — otherwise `--stack sandbox` ships a
  2256	    # settings.json with the hook fragment but NO `.sandbox` /
  2257	    # `.autoAllowBashIfSandboxed`, leaving the OS-sandbox template inert.
  2258	    # Additive `// (base default)` precedence mirrors the hooks lines: the
  2259	    # key only materializes when the stack (or base) actually carries it, so
  2260	    # a base-only install (e.g. --stack node) stays byte-identical.
  2261	    jq -s '
  2262	      .[0] as $base | .[1] as $stack |
  2263	      $base
  2264	      | .hooks.PreToolUse = (($base.hooks.PreToolUse // []) + ($stack.hooks.PreToolUse // []))
  2265	      | .hooks.PostToolUse = (($base.hooks.PostToolUse // []) + ($stack.hooks.PostToolUse // []))
  2266	      | if ($stack.sandbox // $base.sandbox) != null
  2267	        then .sandbox = ($stack.sandbox // $base.sandbox) else . end
  2268	      | if ($stack.autoAllowBashIfSandboxed != null)
  2269	        then .autoAllowBashIfSandboxed = $stack.autoAllowBashIfSandboxed
  2270	        elif ($base.autoAllowBashIfSandboxed != null)
  2271	        then .autoAllowBashIfSandboxed = $base.autoAllowBashIfSandboxed
  2272	        else . end
  2273	    ' "$BASE_SRC" "$stack_src" > "$SETTINGS_DST"
  2274	    echo "    MERGED: settings.base.json + settings.stack.$STACK.json -> .claude/settings.json"
  2275	    return 0
  2276	  fi
  2277	
  2278	  # jq missing: P2-2 — hard-fail when --stack was explicit; soft-warn otherwise.
  2279	  if [[ "$STACK_EXPLICIT" -eq 1 ]]; then
  2280	    echo "ERROR: jq is required to merge stack hooks for --stack $STACK, but jq was not found." >&2
  2281	    echo "       Install jq (brew install jq / apt-get install jq) and re-run." >&2
  2282	    echo "       Aborting install (rc=3) because the --stack flag was explicitly supplied." >&2
  2283	    return 3
  2284	  else
  2285	    echo "    WARNING: jq not found — using base only. Install jq and re-run to merge stack hooks." >&2
  2286	    cp "$BASE_SRC" "$SETTINGS_DST"
  2287	    return 0
  2288	  fi
  2289	}
