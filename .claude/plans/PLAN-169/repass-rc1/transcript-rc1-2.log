  3032	    # Look up this entry in the pre-snapshot (match on leading "name<TAB>").
  3033	    _ws4_pre=""
  3034	    if [[ -f "$_WS4_PRESNAP" ]]; then
  3035	      _ws4_pre="$(grep -F -- "$(printf '%s\t' "$_ws4_b")" "$_WS4_PRESNAP" 2>/dev/null | head -1 || true)"
  3036	    fi
  3037	    if [[ -z "$_ws4_pre" ]]; then
  3038	      # No pre-snapshot row => this entry was CREATED by install.
  3039	      _ws4_bad="$_ws4_bad created:$_ws4_b"
  3040	      continue
  3041	    fi
  3042	    # Pre-existed. If it is a file, compare size + mtime.
  3043	    if [[ -f "$_ws4_e" ]]; then
  3044	      _ws4_now_sz="$(wc -c < "$_ws4_e" 2>/dev/null | tr -d ' ')"
  3045	      _ws4_now_mt="$(detect_mtime "$_ws4_e" 2>/dev/null || echo 0)"
  3046	      _ws4_pre_sz="$(printf '%s' "$_ws4_pre" | cut -f2)"
  3047	      _ws4_pre_mt="$(printf '%s' "$_ws4_pre" | cut -f3)"
  3048	      if [[ "$_ws4_now_sz" != "$_ws4_pre_sz" || "$_ws4_now_mt" != "$_ws4_pre_mt" ]]; then
  3049	        _ws4_bad="$_ws4_bad modified:$_ws4_b"
  3050	      fi
  3051	    fi
  3052	  done
  3053	  if [[ -n "$_ws4_bad" ]]; then
  3054	    echo "ERROR: --ceremony user touched paths outside .claude/:$_ws4_bad" >&2
  3055	    rm -f "$_WS4_PRESNAP"
  3056	    exit 3
  3057	  fi
  3058	  rm -f "$_WS4_PRESNAP"
  3059	fi
