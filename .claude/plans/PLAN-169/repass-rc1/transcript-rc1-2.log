   739	echo "==> Installing ceo-orchestration"
   740	echo "    Source:       $SOURCE_DIR"
   741	echo "    Target:       $TARGET"
   742	echo "    Mode:         $MODE"
   743	echo "    Profile:      $PROFILE"
   744	echo "    Ceremony:     $CEREMONY"  # WS4-ceremony-banner
   745	echo "    Stack:        $STACK"
   746	echo "    GitHub owner: ${GITHUB_OWNER:-<unset — placeholder kept>}"
   747	if [[ "$DRY_RUN" -eq 1 ]]; then
   748	  echo "    Dry-run:      YES (no files will be written)"
   749	fi
   750	echo ""
