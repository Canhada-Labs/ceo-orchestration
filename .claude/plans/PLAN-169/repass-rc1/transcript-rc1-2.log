   118	    # WANTED there while globbing never is. `set -f` separates the two: it
   119	    # disables pathname expansion and leaves splitting intact. MEASURED
   120	    # pre-cure: `FMS_DELIVERED_TEMPLATES='docs/*'` with the repo root as cwd
