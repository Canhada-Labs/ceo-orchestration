  1475	# =============================================================================
  1476	# PLAN-167 — _ownership_verdict: THE ownership decision.
  1477	#
  1478	# install.sh and upgrade.sh stop deciding and start executing. Every defect in
  1479	# the 35-finding S296 review series was a cell of this space whose answer was
  1480	# decided branch-locally, so two branches could disagree about the same
  1481	# question and nothing detected it.
  1482	#
  1483	#   $1 surface        spec | protocol | marker
  1484	#   $2 prior_record   none | hash | link_match | link_retargeted
  1485	#   $3 live_type      absent | dir | dir_empty | regular | symlink | special
  1486	#                     | ancestor_symlink
  1487	#   $4 live_content   pristine | legacy_pristine | legacy_pristine_partial
  1488	#                     | edited | -
  1489	#   $5 source_has     yes | no
  1490	#   $6 mode           copy | link
  1491	#   $7 ceremony       user | maintainer
  1492	#   $8 operation      install_fresh | install_rerun | upgrade
  1493	#   $9 skip_requested none | self | descendant
  1494	#
  1495	#   stdout: "<VERDICT> <HASH_SOURCE>", rc 0
  1496	#   rc 1, no output: a combination the legality rules forbid.
  1497	#
  1498	# PURE: no filesystem, no globals, no environment. Callers observe the nine
  1499	# dimensions and pass them in. That purity is what lets the same table drive a
  1500	# millisecond unit oracle as well as the ~25-minute end-to-end suite; S296 had
  1501	# only the slow instrument, at one cell per ~40-minute round.
  1502	#
  1503	# ABORT_SURFACE is deliberately NOT produced here (round-1 consensus C2). A
  1504	# failed backup is not a property of these nine dimensions — it is the CALLER
  1505	# failing to carry out a verdict it was handed. And per INV-3 that failure
  1506	# NEVER advances the record: recording a delivery that did not happen is the
  1507	# over-claiming direction ADR-155-AMEND-1 §3 forbids.
  1508	#
  1509	# Contract: docs/ownership-decision-table.md · Truth: scripts/tests/ownership_table.tsv
  1510	# =============================================================================
  1830	#                                             word-split it AND print it
  1831	#                                             verbatim, so the single-line
  1832	#                                             shape is part of the contract)
  1833	#   _apply_posture_state_ignores GITIGNORE -> ensure them, append-only
  1834	#   _claude_dir_gitignore_body             -> the NEW .claude/.gitignore body
  1835	#   _apply_claude_dir_gitignore CLAUDE_DIR -> create-if-missing, never rewrite
  1836	#   _preview_claude_dir_gitignore CLAUDE_DIR -> dry-run twin of the apply:
  1837	#       reports would-CREATE / would-APPEND (per missing entry) /
  1838	#       would-PRESERVE, so a seeded adopter file (e.g. `/cache/` only) is
  1839	#       never misreported as PRESERVE when the real run would append
  1840	#       (re-pass rc.4 t2 P1 — the seeded-file dry-run regression)
  1841	# =============================================================================
  1842	
  1843	_mcp_secrets_ignore_entry() {
  1844	  printf '%s\n' "state/mcp_client_secrets/"
  1845	}
  1846	
  1847	_apply_mcp_secrets_ignore() {
  1848	  # $1 = path to the adopter ROOT .gitignore (may not exist yet).
  1849	  _msi_gitignore="$1"
  1850	  # Re-pass rc.4 t2 (P1): shared symlink refusal — a root .gitignore
  1851	  # symlink must never route framework appends elsewhere.
  1852	  _root_gitignore_symlink_guard "$_msi_gitignore" || return 1
  1853	  _msi_line="$( _mcp_secrets_ignore_entry )"
  1854	  if [ -f "$_msi_gitignore" ]; then
  1855	    if ! grep -Fxq "$_msi_line" "$_msi_gitignore" 2>/dev/null; then
  1856	      {
  1857	        echo ""
  1858	        echo "# PLAN-019 P2-SEC-H: MCP shared-secret store (never commit)"
  1859	        echo "$_msi_line"
  1860	      } >> "$_msi_gitignore"
  1861	      echo "    APPENDED to .gitignore: $_msi_line"
  1862	    else
  1863	      echo "    .gitignore already excludes $_msi_line"
  1864	    fi
  1865	  else
  1866	    {
  1867	      echo "# PLAN-019 P2-SEC-H: MCP shared-secret store (never commit)"
  1868	      echo "$_msi_line"
  1869	    } > "$_msi_gitignore"
  1870	    echo "    CREATED .gitignore with: $_msi_line"
  1871	  fi
  1872	  # t9 P1: the SECRET store is exactly where textual presence must not be
  1873	  # mistaken for effective exclusion — a later `!` negation would leave
  1874	  # secret files commit-eligible while this applier reports "already
  1875	  # excludes". Same shared probe + re-assert as the posture entries.
  1876	  _msi_repo="$( dirname "$_msi_gitignore" )"
  1877	  _gitignore_reassert_effective "$_msi_repo" "$_msi_gitignore" \
  1878	    "$_msi_line" "state/mcp_client_secrets/__ceo_ignore_probe__" || return 1
  1879	  return 0
  1880	}
