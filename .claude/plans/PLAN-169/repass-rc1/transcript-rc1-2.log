  1349	# ---- 5. Protocol enforcement (hooks, scripts, catalogs — always installed) ----
  1350	#
  1351	# NOTE (PLAN-003 Phase 0 I-4): hooks/ and scripts/ are installed
  1352	# SELECTIVELY — only top-level files + hooks/_lib/ are shipped to
  1353	# targets. Framework-internal directories excluded:
  1354	#
  1355	#   .claude/hooks/tests/      — 89 unit tests for the framework itself
  1356	#   .claude/hooks/legacy/     — Sprint 1 bash fallbacks (removed in
  1357	#                                Sprint 3 Item C once invariants met)
  1358	#   .claude/scripts/tests/    — 74 unit tests for audit-query,
  1359	#                                run-skill-benchmark, check-tier-boundaries
  1360	#
  1361	# Rationale: targets don't need our tests or fallbacks — they add ~100
  1362	# files of bloat. Target installs should only carry the ACTIVE runtime
  1363	# surface: _lib/, _python-hook.sh, active Python hooks, and active
  1364	# scripts. New hooks added at the top level (e.g. check_bash_safety.py
  1365	# in I-5a) are picked up automatically by the *.py/*.sh glob below.
  1366	
  1367	# PLAN-120-FOLLOWUP WS-D (E4-F1/E4-F2) — install _lib/ SELECTIVELY. A flat
  1368	# `install_one .claude/hooks/_lib` does cp -R (or a whole-tree symlink),
  1369	# which drags the framework's OWN test harness into the adopter runtime:
  1370	# _lib/tests/ (emits real audit events with no session redirect — no
  1371	# conftest ships) + test_isolation.py / testing.py (both `import pytest`
  1372	# at module top). We iterate the top-level _lib entries and skip exactly
  1373	# those three names; everything else (all runtime *.py + the runtime
  1374	# subdirs adapters/ estimation/ federation/ mcp/ otel/ tier_policy/ +
  1375	# __init__.py) ships. New runtime modules are picked up automatically by
  1376	# the glob, matching the install_scripts_selective convention.
  1377	# PLAN-161 U2 (codex r1 F7): prune nested __pycache__/ dirs + *.pyc files
  1378	# under a freshly-copied destination directory. The exclusion predicate above
  1379	# screens only TOP-LEVEL _lib entries; a permitted SUBDIRECTORY (e.g.
  1380	# _lib/adapters) is cp -R'd wholesale, dragging nested __pycache__ dirs and
  1381	# .pyc files the predicate declares globally excluded. Per-file delete +
  1382	# rmdir only — NEVER rm -rf. Refuses to operate through a symlink root
  1383	# (link-mode dst is a symlink into the SOURCE tree). Fail-open: every step
  1384	# is guarded; never changes the install exit status.
  1385	_prune_pycache_under() {
  1386	  local _pp_root="$1" _pp_d _pp_f
  1387	  [[ -d "$_pp_root" && ! -L "$_pp_root" ]] || return 0
  1388	  # 1) *.pyc files anywhere under the copied destination (find without -L:
  1389	  #    symlinks are never followed).
  1390	  while IFS= read -r _pp_f; do
  1391	    [[ -n "$_pp_f" ]] || continue
  1392	    rm -f "$_pp_f" 2>/dev/null || true
  1393	  done < <( find "$_pp_root" -type f -name '*.pyc' -print 2>/dev/null )
  1394	  # 2) __pycache__ dirs, deepest first (-depth): delete their files one by
  1395	  #    one, then rmdir. A dir still holding anything unexpected simply stays.
  1396	  while IFS= read -r _pp_d; do
  1397	    [[ -n "$_pp_d" && -d "$_pp_d" && ! -L "$_pp_d" ]] || continue
  1398	    while IFS= read -r _pp_f; do
  1399	      [[ -n "$_pp_f" ]] || continue
  1400	      rm -f "$_pp_f" 2>/dev/null || true
  1401	    done < <( find "$_pp_d" \( -type f -o -type l \) -print 2>/dev/null )
  1402	    rmdir "$_pp_d" 2>/dev/null || true
  1403	  done < <( find "$_pp_root" -depth -type d -name '__pycache__' -print 2>/dev/null )
  1404	  return 0
  1405	}
