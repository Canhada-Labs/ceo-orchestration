   105	# ---------------------------------------------------------------------------
   106	# Manifest-path safety (PLAN-183 §9.8, rail r1 S337). The manifest is a FILE in
   107	# the target and it is NOT integrity-checked before the walk: a crafted or
   108	# corrupted record must not turn this script into a deleter, reader or
   109	# extractor OUTSIDE the target. Two tests, applied before every removal, every
   110	# backup entry and every restore member:
   111	#   _rel_unsafe REL         lexical — empty, absolute, `.`/`..` segments,
   112	#                           control characters                 (rc 0 = unsafe)
   113	#   _rel_ancestor_link REL  physical — an ancestor component under $TARGET is
   114	#                           a symlink; `-f`, `rm -f` and `tar` all follow it,
   115	#                           `! -L` only ever tests the leaf     (rc 0 = linked)
   116	# Measured pre-cure (S337): a record `<sha>  ../outside/victim.txt` was
   117	# REMOVED (outside the target), and with `docs -> <outside dir>` the walk
   118	# deleted the outside file and the backup archived bytes read through the link.
   119	# ---------------------------------------------------------------------------
   120	_rel_unsafe() {
   121	  case "$1" in
   122	    ''|/*|.|./*|..|../*|*/./*|*/../*|*/.|*/..) return 0 ;;
   123	    # rc.1 re-pass round 10 (refuter): an EMPTY SEGMENT is an alias of the
   124	    # same path — `docs/x` and `docs//x` name one inode but are two strings,
   125	    # so the relpath-uniqueness pass below could not see them as one record
   126	    # and the walk acted on both (preserve, then remove). The shared route
   127	    # predicate (_wbm_route_relpath_ok) refuses `//` too; a trailing `/` is
   128	    # the same alias class.
   129	    *//*|*/) return 0 ;;
   130	    *[$'\n\r\t']*) return 0 ;;
   131	    # rail r2 (S337) P2: whitespace and glob metacharacters — no delivery route
   132	    # ever carries them (_wbm_route_relpath_ok rejects both), and a crafted
   133	    # name with either would word-split or pathname-expand in the sweep loop.
   134	    *' '*|*'*'*|*'?'*|*'['*|*']'*|*'\'*) return 0 ;;
   135	    # rail r3 (S337) P1: an option-like path — the leaf OR any component
   136	    # starting with '-' — would be read by tar as a flag, not an operand.
   137	    -*|*/-*) return 0 ;;
   138	  esac
   139	  return 1
   140	}
   141	_rel_ancestor_link() {
   142	  _ral_cur="$TARGET"
   143	  _ral_parent="$( dirname "$1" )"
   144	  _ral_old="$IFS"
   145	  IFS='/'
   360	# symlink was read THROUGH it — the ledger, the backup list and the removal
   361	# walk all came from bytes at a path nobody validated. The link itself is
   362	# refused (never followed) before anything reads it; exit 6 like every other
   363	# refusal, dry-run included (an input-integrity failure, not a preview).
   364	if [ -L "$MANIFEST" ]; then
   365	  _log "    REFUSED: the install manifest at $MANIFEST is a SYMLINK — this"
   366	  _log "             uninstaller never reads a manifest through a link."
   367	  _log "             NOTHING was removed; the link is left as it stands."
   368	  exit 6
   369	fi
   370	
   371	if [ ! -f "$MANIFEST" ]; then
   372	  echo "ERROR: install manifest not found at $MANIFEST" >&2
   373	  echo "       This target was not installed via PLAN-083 install.sh." >&2
   374	  echo "       To remove manually, see INSTALL.md §Uninstall." >&2
   375	  exit 2
   376	fi
