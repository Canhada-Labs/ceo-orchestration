  1901	# Register a VERBATIM (identity-route) destination, mirroring the schema
  1902	# precedent at :1318-1329: delivered == this run WROTE it, OR the pre-existing
  1903	# target is byte-identical to the framework source.
  1904	#
  1905	# The byte-compare half is load-bearing, not decoration. "Result-only"
  1906	# (register only when we wrote) drops all five registrations on a SECOND
  1907	# consecutive install — every destination is then EXISTS-skipped — and it
  1908	# ships GREEN, because no current Check runs install twice. Byte-identical is
  1909	# origin proof here: the content is framework-specific (the rendered CODEOWNERS
  1910	# names .claude/skills/**, .claude/hooks/**, .claude/plans/PLAN-*.md).
  1911	# PRESERVED (target differs) and SKIPPED (source missing) stay OUT — recording
  1912	# an adopter's own bytes as framework-owned is the class uninstall deletes on.
  1913	_register_delivered_template() {
  1914	  local dst_rel="$1" src_rel="$2"
  1915	  if [[ "$DRY_RUN" -eq 1 ]]; then return 0; fi
  1916	  # rail round-7 F2 — `cmp` follows symlinks too, so an unconfined source could
  1917	  # make an ADOPTER file compare equal to FOREIGN bytes and be registered as
  1918	  # framework-owned (uninstall deletes on that record). Refuse the comparison
  1919	  # rather than let it answer.
  1920	  if _install_src_refuses "$src_rel"; then
  1921	    return 0
  1922	  fi
  1923	  if [[ "${_DOCS_TEMPLATE_WROTE:-0}" = "1" ]] \
  1924	     || cmp -s "$SOURCE_DIR/$src_rel" "$TARGET/$dst_rel" 2>/dev/null; then
  1925	    _append_delivered_template "$dst_rel"
  1926	  fi
  1927	  return 0
  1928	}
