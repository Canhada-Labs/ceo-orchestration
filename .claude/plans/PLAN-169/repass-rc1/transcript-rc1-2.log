   242	# framework-owned enumeration. Sourced (not executed). Fail-open: if the
   243	# helper is somehow absent (partial checkout), the baseline-manifest step is
   244	# simply skipped later — the install itself never depends on it.
   245	if [ -f "$SCRIPT_DIR/_hash_lib.sh" ]; then
