  2918	# audit-v2 C4-P0-03: post-install placeholder validator
  2919	# ----------------------------------------------------------------------
  2920	# Scan installed `.py` and `.md` files for unrendered {{X}} patterns.
  2921	# Default: warn + continue. --strict-placeholders (or
  2922	# CEO_INSTALL_STRICT_PH=1) → exit 4 if any found.
  2923	# ----------------------------------------------------------------------
  2924	
  2925	validate_no_unrendered_placeholders() {
  2926	  local strict="${STRICT_PLACEHOLDERS:-${CEO_INSTALL_STRICT_PH:-0}}"
  2927	  local found=0
  2928	  local report_file
  2929	  report_file="$(mktemp -t ceo-install-ph-report-XXXXXX)"
  2930	
  2931	  echo ""
  2932	  echo "==> Scanning for unrendered placeholders ({{X}} patterns)"
  2933	  _state_record_op "scan_unrendered_placeholders" "strict=$strict"
  2934	
  2935	  local scan_roots=(
  2936	    "$TARGET/CLAUDE.md"
  2937	    "$TARGET/PROTOCOL.md"
  2938	    "$TARGET/MEMORY.md"
  2939	    "$TARGET/.claude/team.md"
  2940	    "$TARGET/.claude/frontend-team.md"
  2941	    "$TARGET/.claude/agent-metrics.md"
  2942	    "$TARGET/.claude/skills"
  2943	    "$TARGET/.claude/scripts"
  2944	    "$TARGET/.claude/hooks"
  2945	    "$TARGET/docs"
  2946	  )
  2947	
  2948	  local root
  2949	  for root in "${scan_roots[@]}"; do
  2950	    [[ -e "$root" ]] || continue
  2951	    if [[ -d "$root" ]]; then
  2952	      while IFS= read -r f; do
  2953	        [[ -n "$f" && -f "$f" ]] || continue
  2954	        if grep -E -n '\{\{[A-Z_]+\}\}' "$f" >/dev/null 2>&1; then
  2955	          grep -E -Hn '\{\{[A-Z_]+\}\}' "$f" >> "$report_file"
  2956	        fi
  2957	      done < <(find "$root" \( -name '*.md' -o -name '*.py' \) -type f 2>/dev/null)
  2958	    elif [[ -f "$root" ]]; then
  2959	      if grep -E -n '\{\{[A-Z_]+\}\}' "$root" >/dev/null 2>&1; then
  2960	        grep -E -Hn '\{\{[A-Z_]+\}\}' "$root" >> "$report_file"
  2961	      fi
  2962	    fi
  2963	  done
  2964	
  2965	  if [[ -s "$report_file" ]]; then
  2966	    found=$(wc -l < "$report_file" | tr -d ' ')
  2967	    echo ""
  2968	    echo "    UNRENDERED placeholders found ($found occurrences):"
  2969	    head -25 "$report_file" | sed 's|^|      |'
  2970	    if [[ "$found" -gt 25 ]]; then
  2971	      echo "      ... (and $((found - 25)) more — see $report_file)"
  2972	    fi
  2973	    echo ""
  2974	    if [[ "$strict" == "1" ]]; then
  2975	      echo "    STRICT mode (--strict-placeholders) — failing install." >&2
  2976	      rm -f "$report_file"
  2977	      exit 4
  2978	    else
  2979	      echo "    WARN: install continues. Re-run with --strict-placeholders" >&2
  2980	      echo "          to fail-closed on unrendered placeholders." >&2
  2981	    fi
  2982	  else
  2983	    echo "    OK: no unrendered placeholders detected."
  2984	  fi
  2985	
  2986	  rm -f "$report_file"
  2987	}
  2988	
  2989	validate_no_unrendered_placeholders
