   328	# fail-closed branch turns into "do not record" rather than a guess.
   329	_wbm_prior_digest() {
   330	  [ -n "${FMS_PRIOR_MANIFEST:-}" ] && [ -f "$FMS_PRIOR_MANIFEST" ] || { printf ''; return 0; }
   331	  grep -E "^[0-9a-f]{64}  $1\$" "$FMS_PRIOR_MANIFEST" 2>/dev/null | head -1 | cut -d' ' -f1 || printf ''
   332	}
   333	
   334	_write_baseline_manifest() {
   335	  _wbm_manifest="$1"
   336	  if ! command -v _framework_manifest_files >/dev/null 2>&1 \
   337	     || ! command -v _hash_file >/dev/null 2>&1; then
   338	    echo "    NOTE: baseline manifest skipped — hash/enumeration helpers not sourced" >&2
   339	    return 0
   340	  fi
   341	  : "${FMS_ROOT:?_write_baseline_manifest requires FMS_ROOT}"
   342	  # FMS_HASH_ROOT (optional): hash the FRAMEWORK version of each file from here
   343	  # instead of FMS_ROOT. The ENUMERATION still walks FMS_ROOT (what the target
   344	  # holds), but the recorded baseline must be what the framework SHIPS — never
   345	  # an adopter-customized target file. Without this, upgrade.sh's post-upgrade
   346	  # rewrite (C.7) records hash(customized-but-preserved file) as the baseline,
   347	  # which the NEXT upgrade reads as H_dst==H_base => FRAMEWORK-CHANGED => clobber
   348	  # (the verified C.5 idempotency failure). Default = FMS_ROOT (install path,
   349	  # where the target IS the freshly-written framework version). The root
   350	  # PROTOCOL.md is GENERATED (a pointer), not a source copy, so it always hashes
   351	  # from FMS_ROOT (the target pointer), never FMS_HASH_ROOT. (Codex R1 + dry-run)
   352	  _wbm_hash_root="${FMS_HASH_ROOT:-$FMS_ROOT}"
   353	
   354	  _wbm_tmp="$( mktemp "$_wbm_manifest.XXXXXX" 2>/dev/null )" || {
   355	    echo "    NOTE: baseline manifest skipped (mktemp failed) — advisory only" >&2
   356	    return 0
   357	  }
   358	
   359	  _framework_manifest_files | while IFS= read -r _wbm_rel; do
   360	    [ -n "$_wbm_rel" ] || continue
   361	    _wbm_abs="$FMS_ROOT/$_wbm_rel"
   362	    # Drop relpaths carrying control chars (line-based manifest).
   363	    case "$_wbm_rel" in
   364	      *[$'\n\r\t']*) continue ;;
   365	    esac
   366	    if [ "${FMS_MODE:-copy}" = "link" ] && [ -L "$_wbm_abs" ] \
   367	       && _wbm_link_allowed "$_wbm_rel"; then
   368	      _wbm_target="$( readlink "$_wbm_abs" 2>/dev/null || true )"
   369	      [ -n "$_wbm_target" ] || continue
   370	      case "$_wbm_target" in
   371	        *[$'\n\r\t']*) continue ;;
   372	      esac
   373	      printf 'LINK  %s  %s\n' "$_wbm_rel" "$_wbm_target" >> "$_wbm_tmp"
   374	    elif [ -f "$_wbm_abs" ]; then
   375	      if [ "$_wbm_rel" = "PROTOCOL.md" ]; then
   376	        # Generated pointer. Use the CANONICAL pointer hash (FMS_PROTOCOL_HASH,
   377	        # exported by upgrade.sh _refresh_protocol_pointer) so a PRESERVED
   378	        # adopter-customized PROTOCOL.md is NOT re-recorded as its own baseline
   379	        # (Codex R2 P0 — else the next upgrade reads H_dst==H_base and clobbers
   380	        # it). On install (no FMS_PROTOCOL_HASH) the target IS the freshly
   381	        # written pointer, so hashing it directly is correct.
   382	        if [ -n "${FMS_PROTOCOL_HASH:-}" ]; then
   383	          _wbm_digest="$FMS_PROTOCOL_HASH"
   384	        else
   385	          _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )"
   386	        fi
   387	      elif _wbm_is_conditional "$_wbm_rel"; then
   388	        _wbm_decl="$( _wbm_declared_hash_source "$_wbm_rel" )"
   389	        case "$_wbm_decl" in
   390	          HASH_SOURCE)
   391	            # FMS_SOURCE_ROOT, never FMS_HASH_ROOT: the global override is an
   392	            # upgrade-only mechanism, and borrowing it here is what dragged
   393	            # install into the r8-F1 rendered-tree regression.
   394	            if [ -n "${FMS_SOURCE_ROOT:-}" ] && [ -f "$FMS_SOURCE_ROOT/$_wbm_rel" ]; then
   395	              _wbm_digest="$( _hash_file "$FMS_SOURCE_ROOT/$_wbm_rel" 2>/dev/null || true )"
   396	            else
   397	              continue   # the framework no longer ships it: record nothing
   398	            fi
   399	            ;;
   400	          HASH_PRIOR_RECORD)   _wbm_digest="$( _wbm_prior_digest "$_wbm_rel" )" ;;
   401	          HASH_CANONICAL_POINTER) _wbm_digest="${FMS_PROTOCOL_HASH:-}" ;;
   402	          HASH_TARGET)         _wbm_digest="$( _hash_file "$_wbm_abs" 2>/dev/null || true )" ;;
   403	          HASH_NONE)           continue ;;
   404	          *)
   405	            # FAIL-CLOSED, scoped to the three conditional surfaces (Owner
   406	            # ratified 2026-08-07). Under-claiming is recoverable; over-claiming
   407	            # is the delete-the-adopter's-file class.
   408	            echo "    NOTE: $_wbm_rel delivered but declared no hash_source —" >&2
   409	            echo "          NOT recorded (fail-closed; ownership under-claimed)" >&2
   410	            continue
   411	            ;;
   412	        esac
   413	        case "$_wbm_digest" in
   414	          "" ) continue ;;
   415	        esac
   416	      else
   417	        # Hash the FRAMEWORK version. When FMS_HASH_ROOT is set (upgrade) and the
   418	        # path is ABSENT there, the framework no longer ships it — OMIT it from
   419	        # the baseline (recording the adopter-retained target file would falsely
   420	        # mark it FRAMEWORK-CHANGED if the framework later reintroduces the
   421	        # path). Codex R2 P1.
   422	        _wbm_hash_path="$_wbm_abs"
   423	        if [ -n "${FMS_HASH_ROOT:-}" ] && _wbm_hash_root_applies "$_wbm_rel"; then
   424	          if [ -f "$_wbm_hash_root/$_wbm_rel" ]; then
   425	            _wbm_hash_path="$_wbm_hash_root/$_wbm_rel"
   426	          else
   427	            continue   # framework no longer ships this path — no baseline record
   428	          fi
   429	        fi
   430	        _wbm_digest="$( _hash_file "$_wbm_hash_path" 2>/dev/null || true )"
   431	      fi
   432	      case "$_wbm_digest" in
   433	        [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
   434	        *) continue ;;
   435	      esac
   436	      printf '%s  %s\n' "$_wbm_digest" "$_wbm_rel" >> "$_wbm_tmp"
   437	    fi
   438	  done
   439	
   440	  LC_ALL=C sort -u "$_wbm_tmp" > "$_wbm_tmp.sorted" 2>/dev/null && mv "$_wbm_tmp.sorted" "$_wbm_tmp"
   441	  if mv "$_wbm_tmp" "$_wbm_manifest"; then
   442	    echo "    WROTE: $( wc -l < "$_wbm_manifest" | tr -d ' ' ) baseline records -> $_wbm_manifest"
   443	  else
   444	    rm -f "$_wbm_tmp" "$_wbm_tmp.sorted" 2>/dev/null || true
   445	    echo "    NOTE: baseline manifest atomic mv failed — advisory only" >&2
   446	  fi
   447	  return 0
   448	}
