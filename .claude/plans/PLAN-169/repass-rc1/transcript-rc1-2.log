  2759	      local esc
  2760	      esc="$(printf '%s' "$val" | sed 's/[|&\\]/\\&/g')"
  2761	      script="${script}s|{{${key}}}|${esc}|g;"
  2762	    fi
  2763	  }
  2764	  _add_sub "OWNER_NAME"          "$PH_OWNER_NAME"
