  1793	# ---- 5d. docs/ templates (PLAN-003 Phase 0 I-3) ----
  1794	
  1795	# rail round-7 F2 — PHYSICAL confinement of a delivery SOURCE, through the ONE
  1796	# predicate the library owns (_wbm_source_confined). `[ -f ]`, `cp`, `sed` and
  1797	# `cmp` all FOLLOW symlinks, so a `templates/...` source that is a link (or has
  1798	# a symlinked ancestor) to a regular file outside this checkout delivers FOREIGN
  1799	# bytes into the adopter as framework content — measured on the upgrade side
  1800	# (S327) with an identical sha, and install.sh reads exactly the same sources.
  1801	# Fail-CLOSED when the predicate is missing: the library is sourced at :248 and
  1802	# a partial checkout that lost it is not a tree this installer should deliver
  1803	# templates from. Returns 0 when the read must be REFUSED.
  1804	_install_src_refuses() {
  1805	  local src_rel="$1"
  1806	  if ! command -v _wbm_source_confined >/dev/null 2>&1; then
  1807	    echo "    SKIP (source-confinement predicate unavailable — refusing rather than guessing): $src_rel"
  1808	    return 0
  1809	  fi
  1810	  if ! _wbm_source_confined "$SOURCE_DIR" "$src_rel"; then
  1811	    echo "    SKIP (source not confined to the framework checkout — ${_WBM_SRC_CONFINE_WHY:-unknown reason}): $src_rel"
  1812	    return 0
  1813	  fi
  1814	  return 1
  1815	}
  1816	
  1817	install_docs_template() {
  1818	  local src_rel="$1"
  1819	  local dst_rel="$2"
  1820	  local src="$SOURCE_DIR/$src_rel"
  1821	  local dst="$TARGET/$dst_rel"
  1822	
  1823	  # PLAN-183 W5 (D3): per-destination delivery signal. INSTALL_ONE_WROTE is
  1824	  # OWNED by install_one (:877/:905/:919) and this function is not install_one
  1825	  # — writing to it here would clobber the flag the schema registrations at
  1826	  # :1318-1329 read. Own flag, reset on EVERY entry so a later SKIP can never
  1827	  # inherit an earlier COPY's verdict.
  1828	  _DOCS_TEMPLATE_WROTE=0
  1829	
  1830	  # rail round-7 F2 — ahead of the `-f` test, which follows symlinks.
  1831	  if _install_src_refuses "$src_rel"; then
  1832	    return
  1833	  fi
  1834	  # PLAN-185 W1 (writer 3/6) — the DESTINATION half of the same question. The
  1835	  # `-e "$dst"` below follows symlinks, so a dangling link here answered "not
  1836	  # installed yet" and the `cp` at the end wrote THROUGH it: measured (S329),
  1837	  # 536 bytes outside the target with the run exiting 0.
  1838	  if _dst_refuses "$dst_rel"; then
  1839	    return
  1840	  fi
  1841	  if [[ ! -f "$src" ]]; then
  1842	    echo "    SKIP (template missing): $src_rel"
  1843	    return
  1844	  fi
  1845	
  1846	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1847	    if [[ -e "$dst" ]]; then
  1848	      echo "    (dry-run) EXISTS (would skip): $dst_rel"
  1849	    else
  1850	      echo "    (dry-run) would COPY: $src_rel -> $dst_rel"
  1851	    fi
  1852	    return
  1853	  fi
  1854	
  1855	  if [[ -e "$dst" ]]; then
  1856	    echo "    EXISTS (skipping): $dst_rel"
  1857	    return
  1858	  fi
  1859	
  1860	  mkdir -p "$( dirname "$dst" )"
  1861	  cp "$src" "$dst"
  1862	  _DOCS_TEMPLATE_WROTE=1
  1863	  echo "    COPIED: $src_rel -> $dst_rel"
  1864	}
  1865	
  1866	# Is this EXACT destination in the delivered list? Line-exact on purpose:
  1867	# `.github/CODEOWNERS` is a PREFIX of `.github/CODEOWNERS.template`, so the
  1868	# substring `case` idiom used for _CONTINUITY_PATHS would fire on the wrong
  1869	# one — and those two are mutually exclusive per run, so the wrong answer is
  1870	# reachable, not theoretical.
  1871	_delivered_template_has() {
  1872	  local want="$1" line
  1873	  while IFS= read -r line; do
  1874	    if [[ "$line" = "$want" ]]; then return 0; fi
  1875	  done <<< "${_DELIVERED_TEMPLATES:-}"
  1876	  return 1
  1877	}
  1878	
  1879	# PLAN-183 W5 (D3) — accumulate ONE delivered destination for the baseline
  1880	# manifest. Newline-separated; the generator splits on IFS=newline.
  1881	_append_delivered_template() {
  1882	  # rail round-3 F1 — same WHITELIST discipline as the generator, applied at
  1883	  # the one choke point where this list grows. The generator is the fail-closed
  1884	  # floor (it lives in the same file as the reader and can always consult the
  1885	  # table); this is defence in depth, so a registration the shared table never
  1886	  # declared is refused HERE, named, instead of travelling to the manifest
  1887	  # writer to be silently dropped there. `command -v` guarded because the
  1888	  # library is sourced conditionally (install.sh:248, partial checkout).
  1889	  if command -v _wbm_route_dest_declared >/dev/null 2>&1 \
  1890	     && ! _wbm_route_dest_declared "$1"; then
  1891	    echo "    ERROR: delivered-template registration REJECTED (not a destination declared in the shared route table): '$1'" >&2
  1892	    return 0
  1893	  fi
  1894	  if [[ -n "${_DELIVERED_TEMPLATES:-}" ]]; then
  1895	    _DELIVERED_TEMPLATES="$_DELIVERED_TEMPLATES"$'\n'"$1"
  1896	  else
  1897	    _DELIVERED_TEMPLATES="$1"
  1898	  fi
  1899	}
  1900	
  1901	# Register a VERBATIM (identity-route) destination, mirroring the schema
  1902	# precedent at :1318-1329: delivered == this run WROTE it, OR the pre-existing
  1903	# target is byte-identical to the framework source.
  1904	#
  1905	# The byte-compare half is load-bearing, not decoration. "Result-only"
  1906	# (register only when we wrote) drops all five registrations on a SECOND
  1907	# consecutive install — every destination is then EXISTS-skipped — and it
  1908	# ships GREEN, because no current Check runs install twice. Byte-identical is
  1909	# origin proof here: the content is framework-specific (the rendered CODEOWNERS
  1910	# names .claude/skills/**, .claude/hooks/**, .claude/plans/PLAN-*.md).
  1911	# PRESERVED (target differs) and SKIPPED (source missing) stay OUT — recording
  1912	# an adopter's own bytes as framework-owned is the class uninstall deletes on.
  1913	_register_delivered_template() {
  1914	  local dst_rel="$1" src_rel="$2"
  1915	  if [[ "$DRY_RUN" -eq 1 ]]; then return 0; fi
  1916	  # rail round-7 F2 — `cmp` follows symlinks too, so an unconfined source could
  1917	  # make an ADOPTER file compare equal to FOREIGN bytes and be registered as
  1918	  # framework-owned (uninstall deletes on that record). Refuse the comparison
  1919	  # rather than let it answer.
  1920	  if _install_src_refuses "$src_rel"; then
  1921	    return 0
  1922	  fi
  1923	  if [[ "${_DOCS_TEMPLATE_WROTE:-0}" = "1" ]] \
  1924	     || cmp -s "$SOURCE_DIR/$src_rel" "$TARGET/$dst_rel" 2>/dev/null; then
  1925	    _append_delivered_template "$dst_rel"
  1926	  fi
  1927	  return 0
  1928	}
  1929	
  1930	install_docs_templates() {
  1931	  echo ""
  1932	  echo "==> Installing docs/ templates"
  1933	  _state_record_op "install_docs_templates" "BRANCH-PROTECTION.md + rotation-log.md"
  1934	  # PLAN-185 W1 — pre-flight the WHOLE group (both destinations) before the
  1935	  # first cp, so a refusal on rotation-log.md cannot leave BRANCH-PROTECTION.md
  1936	  # behind in a tree the rollback does not cover.
  1937	  if ! _dst_preflight "docs/BRANCH-PROTECTION.md" "docs/rotation-log.md"; then
  1938	    return
  1939	  fi
  1940	  install_docs_template "templates/docs/BRANCH-PROTECTION.md" "docs/BRANCH-PROTECTION.md"
  1941	  _register_delivered_template "docs/BRANCH-PROTECTION.md" "templates/docs/BRANCH-PROTECTION.md"
  1942	  install_docs_template "templates/docs/rotation-log.md" "docs/rotation-log.md"
  1943	  _register_delivered_template "docs/rotation-log.md" "templates/docs/rotation-log.md"
  1944	}
