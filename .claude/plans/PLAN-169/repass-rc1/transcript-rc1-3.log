  exit 1
fi

TARGET="$( cd "$TARGET" && pwd )"

_log() { printf '%s\n' "$*"; }
_dry() {
  if [ "$DRY_RUN" -eq 1 ]; then
    printf '(dry-run) %s\n' "$*"
    return 0
  fi
