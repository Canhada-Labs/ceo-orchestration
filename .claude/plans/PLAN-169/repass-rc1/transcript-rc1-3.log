  2482	    # real run refuses and demands git rm --cached.
  2483	    _dry_tracked="$( _gitignore_tracked_sensitive "$TARGET" \
  2484	      ".claude/settings.local.json" ".claude/state" "state/mcp_client_secrets" )"
  2485	    if [ -n "$_dry_tracked" ]; then
  2486	      echo "    (dry-run) ERROR: sensitive path(s) already TRACKED — real run would REFUSE and demand git rm --cached:" >&2
  2487	      printf '%s\n' "$_dry_tracked" | sed 's/^/      /' >&2
  2488	      exit 1
  2489	    fi
  2490	    echo "    (dry-run) would ENSURE .gitignore excludes state/mcp_client_secrets/"
  2491	    return 0
  2492	  fi
  2493	
  2494	  echo ""
  2495	  echo "==> MCP secrets directory (P2-SEC-H)"
  2496	  _state_record_op "ensure_mcp_secrets_dir" "state/mcp_client_secrets 0700"
  2497	  mkdir -p "$secrets_dir"
  2498	  chmod 700 "$secrets_dir"
  2499	  echo "    ENSURED: $secrets_dir (mode 0700)"
  2500	  echo ""
  2501	  echo "    NOTE: this directory stores HMAC shared secrets for MCP clients."
  2502	  echo "          File perms MUST be 0600; auth.load_secret() fail-closes otherwise."
