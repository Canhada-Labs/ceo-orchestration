   364	# Reject an unsafe relpath. $2 = "link" to allow a symlinked LEAF.
   365	_field_has_control_bytes() {
   366	  # Locale-INDEPENDENT control-byte test (rail S340 r3, codex P2). Under
   367	  # LC_ALL=C bash matches RAW bytes, so C0 (0x00-0x1f) and DEL are caught
   368	  # whatever locale the operator runs doctor in; C1 controls are caught both as
   369	  # valid UTF-8 (U+0080-U+009F = C2 80..C2 9F) and as stray 8-bit bytes (a raw
   370	  # 0x9b, the 8-bit CSI, is never valid UTF-8 — any non-ASCII field is validated
   371	  # with iconv; no iconv ⇒ non-ASCII is refused, fail-closed). The framework's
   372	  # own manifests are ASCII, so on a sane install this never spawns anything.
   373	  local LC_ALL=C
   374	  case "$1" in
   375	    *[[:cntrl:]]*) return 0 ;;
   376	    *$'\xc2'[$'\x80'-$'\x9f']*) return 0 ;;
   377	    *[$'\x80'-$'\xff']*)
   378	      [ "$_ICONV_OK" -eq 1 ] || return 0
   379	      printf '%s' "$1" | iconv -f UTF-8 -t UTF-8 >/dev/null 2>&1 || return 0
   380	      ;;
   381	  esac
   382	  return 1
   383	}
   384	_ICONV_OK=0
   385	command -v iconv >/dev/null 2>&1 && _ICONV_OK=1
   386	_relpath_unsafe() {
   387	  _ru_rel="$1"
   388	  _ru_kind="${2:-file}"
