   171	    .claude/*) return 0 ;;   # .claude has its own sweep
   172	    */*) ;;
   173	    *) return 0 ;;           # a top-level file leaves no directory behind
   174	  esac
   175	  _tt_dir="${1%/*}"
   176	  while [ -n "$_tt_dir" ] && [ "$_tt_dir" != "." ] && [ "$_tt_dir" != "/" ]; do
   177	    case "
   178	$swept_dirs" in
   179	      *"
   180	$_tt_dir
   181	"*) ;;
   182	      *) swept_dirs="$swept_dirs
   183	$_tt_dir" ;;
   184	    esac
   185	    case "$_tt_dir" in
   186	      */*) _tt_dir="${_tt_dir%/*}" ;;
   187	      *) _tt_dir="" ;;
   188	    esac
   189	  done
   190	}
   191	# The sweep itself: only EMPTY directories go (-empty), so a tree that still
   192	# holds a file of the adopter's — or a PRESERVED delivery — is never touched,
   193	# and trees this run did not remove from are not visited at all. Called on
   194	# BOTH exit paths (complete and incomplete): a partial uninstall that removed
   195	# every docs/ delivery but preserved an edited CODEOWNERS still empties docs/.
   196	_sweep_emptied_trees() {
   197	  # DEEPEST FIRST, so `docs/a/b` is tried before `docs/a` and a chain empties
   198	  # in one pass. `rmdir` on the exact path, never `find -delete` over a tree:
   199	  # rmdir refuses a non-empty directory by itself, so a directory holding
   200	  # anything at all — an adopter's file, a PRESERVED delivery, another
   201	  # adopter-created directory — survives without this code having to reason
   202	  # about it.
   203	  printf '%s\n' "$swept_dirs" \
   204	    | awk 'NF { print gsub(/\//, "/") "\t" $0 }' \
   205	    | sort -rn -k1,1 \
   206	    | cut -f2- \
   207	    | while IFS= read -r _dir; do
   208	        case "$_dir" in ''|.|..|/*|*..*) continue ;; esac   # never leave the target
   209	        [ -d "$TARGET/$_dir" ] || continue
   210	        [ -L "$TARGET/$_dir" ] && continue
   211	        if ! _dry "would REMOVE the empty directory $_dir/"; then
   212	          rmdir "$TARGET/$_dir" 2>/dev/null || true
   213	        fi
   214	      done
   215	}
   216	
   217	# ---------------------------------------------------------------------------
   218	# Resolve HMAC backup key (same algorithm as install.sh)
   219	# ---------------------------------------------------------------------------
   220	_resolve_backup_key() {
   221	  if [ -f "$TARGET/.claude/.audit-key" ]; then
   222	    printf '%s\n' "$TARGET/.claude/.audit-key"
   223	    return 0
   224	  fi
   225	  if [ -f "$TARGET/.claude/.install-backup-key" ]; then
   226	    printf '%s\n' "$TARGET/.claude/.install-backup-key"
   227	    return 0
   228	  fi
   229	  return 1
   230	}
   231	
   232	# ---------------------------------------------------------------------------
   233	# RESTORE MODE — invert a backup
   234	# ---------------------------------------------------------------------------
   235	if [ -n "$RESTORE_PATH" ]; then
   236	  if [ ! -f "$RESTORE_PATH" ]; then
   237	    echo "ERROR: backup file not found: $RESTORE_PATH" >&2
   238	    exit 4
   239	  fi
   240	  _log "==> Restore mode: $RESTORE_PATH -> $TARGET"
   241	
   242	  # Optional HMAC verification of backup
   243	  if [ -f "$RESTORE_PATH.hmac" ] && [ "$NO_HMAC_VERIFY" -eq 0 ]; then
   244	    key_path="$(_resolve_backup_key || true)"
   245	    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
   246	      expected_hmac="$(awk '{print $1; exit}' "$RESTORE_PATH.hmac")"
   247	      actual_hmac="$(python3 -c "
   248	import hashlib, hmac, sys
   249	key = open('$key_path', 'rb').read()
   250	tar_sha = hashlib.sha256(open('$RESTORE_PATH', 'rb').read()).digest()
   251	sys.stdout.write(hmac.new(key, tar_sha, hashlib.sha256).hexdigest())
   252	")"
   253	      if [ "$expected_hmac" != "$actual_hmac" ]; then
   254	        echo "ERROR: backup HMAC mismatch — tarball may have been tampered with" >&2
   255	        echo "       expected: $expected_hmac" >&2
   256	        echo "       actual:   $actual_hmac" >&2
   257	        exit 4
   258	      fi
   259	      _log "    Backup HMAC verified."
   260	    else
   261	      _log "    NOTE: no backup key found; skipping HMAC verification"
   262	    fi
   263	  fi
   264	
   265	  # rc.1 re-pass (round 7, part 3): the archive is VALIDATED before the
   266	  # dry-run preview, not after it. `--dry-run --restore README.md` used to
   267	  # print "would EXTRACT" and exit 0 for a file that is not a tarball —
   268	  # the help promises exit 4 for an invalid archive BEFORE the preview, and
   269	  # a preview that cannot fail is not a preview. The listing and the
   270	  # .claude-member check need nothing moved aside, so they run first; the
   271	  # rollback helper below tolerates an unset `aside` for exactly that.
   272	  _rst_rollback() {
   273	    # rail r3 (S337) P2: a FAILED .claude extraction can leave a PARTIAL
   274	    # $TARGET/.claude directory, which the `! -d` guard would treat as "already
   275	    # restored". Clear the partial first so the moved-aside tree comes back
   276	    # whole rather than merged with half an extraction.
   277	    if [ -n "${aside:-}" ] && [ -d "$aside" ]; then
   278	      rm -rf "$TARGET/.claude" 2>/dev/null || true
   279	      mv "$aside" "$TARGET/.claude"
   280	      _log "    Rolled the previous .claude/ back into place."
   281	    fi
   282	  }
   283	  _rst_list="$(mktemp 2>/dev/null || mktemp -t ceo-restore-list)"
   284	  if ! tar tzf "$RESTORE_PATH" > "$_rst_list" 2>/dev/null; then
   285	    rm -f "$_rst_list"
   286	    echo "ERROR: cannot list the backup archive (corrupt tarball?)" >&2
   287	    exit 4
   288	  fi
   289	  if ! grep -qE '^(\./)?\.claude(/|$)' "$_rst_list"; then
   290	    rm -f "$_rst_list"
   291	    echo "ERROR: the archive carries no .claude/ member — not a ceo-orchestration backup" >&2
   292	    exit 4
   293	  fi
   294	
   295	  if _dry "would EXTRACT $RESTORE_PATH into $TARGET ($(grep -c . "$_rst_list") member(s) listed)"; then
   296	    rm -f "$_rst_list"
   297	    exit 0
   298	  fi
   299	
   300	  # Move existing .claude/ aside (safety net)
   301	  if [ -d "$TARGET/.claude" ]; then
   302	    aside="$TARGET/.claude.pre-restore-$(date -u +%Y%m%d-%H%M%SZ)"
   303	    _log "    Moving current .claude/ aside to: $aside"
   304	    mv "$TARGET/.claude" "$aside"
   305	  fi
   306	
   307	  _log "    Extracting backup..."
   308	  # PLAN-183 §9.8 (rail r1, S337): the archive now carries deliveries OUTSIDE
   309	  # .claude/ (docs/, .github/, SPEC/, root files). `.claude/` is restored whole
   310	  # (the live one was moved aside above); every OTHER member is restored only
   311	  # when nothing exists at its path — a file the adopter recreated or edited
   312	  # since the uninstall is PRESERVED — and a member whose path is unsafe or
   313	  # whose ancestor is a symlink is never extracted (traversal / write-through).
   314	  # rail r2 (S337) P1: a restore that could not deliver is a FAILURE, not a
   315	  # note — a broken/absent .claude member rolls the moved-aside .claude back
   316	  # and exits 4; a failed or refused non-.claude member exits 1. Members are
   317	  # read from a LIST FILE, not a pipeline, so the counters survive the loop.
   318	  if ! ( cd "$TARGET" && tar xzf "$RESTORE_PATH" .claude 2>/dev/null ); then
   319	    rm -f "$_rst_list"
   320	    echo "ERROR: failed to extract .claude/ from the backup" >&2
   321	    _rst_rollback
   322	    exit 4
   323	  fi
   324	  restore_failed=0
   325	  restore_refused=0
   326	  while IFS= read -r _m; do
   327	    _mrel="${_m#./}"
   328	    case "$_mrel" in .claude|.claude/*|*/) continue ;; esac
   329	    if _rel_unsafe "$_mrel" || _rel_ancestor_link "$_mrel"; then
   330	      restore_refused=$((restore_refused + 1))
   331	      _log "    SKIPPED (unsafe path or symlinked ancestor — not extracted): $_mrel"
   332	      continue
   333	    fi
   334	    if [ -e "$TARGET/$_mrel" ] || [ -L "$TARGET/$_mrel" ]; then
   335	      _log "    PRESERVED (exists — not overwritten by restore): $_mrel"
   336	      continue
   337	    fi
   338	    if ( cd "$TARGET" && tar xzf "$RESTORE_PATH" -- "$_m" 2>/dev/null ); then
   339	      _log "    RESTORED: $_mrel"
   340	    else
   341	      restore_failed=$((restore_failed + 1))
   342	      _log "    RESTORE-FAILED: $_mrel"
   343	    fi
   344	  done < "$_rst_list"
   345	  rm -f "$_rst_list"
   346	  if [ "$restore_failed" -gt 0 ] || [ "$restore_refused" -gt 0 ]; then
   347	    _log "    Restore INCOMPLETE: $restore_failed member(s) failed, $restore_refused refused (unsafe path) — see the lines above."
   348	    exit 1
   349	  fi
   350	  _log "    Restore complete."
   351	  exit 0
   352	fi
   353	
   354	# ---------------------------------------------------------------------------
   355	# UNINSTALL MODE — manifest-honoring removal
   356	# ---------------------------------------------------------------------------
   357	MANIFEST="$TARGET/.claude/.install-manifest.sha256"
   358	
   359	# rc.1 re-pass round 9, part 3: `-f` FOLLOWS a link, so a manifest that is a
   360	# symlink was read THROUGH it — the ledger, the backup list and the removal
   361	# walk all came from bytes at a path nobody validated. The link itself is
   362	# refused (never followed) before anything reads it; exit 6 like every other
   363	# refusal, dry-run included (an input-integrity failure, not a preview).
   364	if [ -L "$MANIFEST" ]; then
   365	  _log "    REFUSED: the install manifest at $MANIFEST is a SYMLINK — this"
   366	  _log "             uninstaller never reads a manifest through a link."
   367	  _log "             NOTHING was removed; the link is left as it stands."
   368	  exit 6
   369	fi
   370	
   371	if [ ! -f "$MANIFEST" ]; then
   372	  echo "ERROR: install manifest not found at $MANIFEST" >&2
   373	  echo "       This target was not installed via PLAN-083 install.sh." >&2
   374	  echo "       To remove manually, see INSTALL.md §Uninstall." >&2
   375	  exit 2
   376	fi
   377	
   378	_log "==> Uninstall mode (manifest-honoring)"
   379	_log "    Target:   $TARGET"
   380	_log "    Manifest: $MANIFEST"
   381	_log "    Dry-run:  $DRY_RUN"
   382	_log "    Force:    $FORCE"
   383	_log ""
   384	
   385	# --- rc.1 re-pass round 3, part 3: the NUL preflight ------------------------
   386	# `read -r` on the Bash 3.2 floor this project supports DISCARDS a NUL and
   387	# everything after it in that record, so the per-record `grep [[:cntrl:]]`
   388	# below never sees it: `<valid-sha>  docs/file<NUL>garbage` arrived at the
   389	# parser already truncated to `<valid-sha>  docs/file`, hashed, matched, and
   390	# was deleted — with the manifest removed and the run exiting 0. The reviewer
   391	# reproduced exactly that under 3.2.57. A per-record check cannot see a byte
   392	# that `read` ate; the question has to be asked of the FILE, in raw bytes,
   393	# before anything parses it. Refusing the WHOLE manifest is the only honest
   394	# answer: a NUL means the file is not the text this uninstaller can read, and
   395	# picking the survivors would be deciding which truncation to trust.
   396	if ! LC_ALL=C tr -d '\000' < "$MANIFEST" | cmp -s - "$MANIFEST"; then
   397	  _log "    REFUSED: the manifest contains NUL byte(s) — this uninstaller"
   398	  _log "             cannot read it, and `read` would silently truncate the"
   399	  _log "             affected record(s) into shapes that look valid."
   400	  _log "             NOTHING was removed; the manifest is left as it stands."
   401	  exit 6
   402	fi
   403	
   404	# --- rc.1 re-pass round 3, part 3: ONE grammar, parsed ONCE ----------------
   405	# Backup construction and the removal walk used DIFFERENT grammars: the walk
   406	# accepted one OR two spaces after the digest (`  ?`), while the backup list
   407	# only matched records containing two consecutive spaces. A one-space record
   408	# was therefore deleted but never archived — the recovery tarball silently
   409	# missing exactly what the run removed. The canonical grammar is EXACTLY two
   410	# spaces (what the writer emits); it is applied once, here, into a sanitized
   411	# ledger that both the backup and the walk read. No second parser can drift
   412	# from this one because there is no second parser.
   413	_LEDGER="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger)"
   414	unsafe_count=0
   415	valid_count=0
   416	while IFS= read -r line || [ -n "$line" ]; do
   417	  case "$line" in '#'*|'') continue ;; esac
   418	  if printf '%s' "$line" | LC_ALL=C grep -q '[[:cntrl:]]'; then
   419	    unsafe_count=$((unsafe_count + 1))
   420	    _log "    REFUSED (manifest record carries control bytes — not touched)"
   421	    continue
   422	  fi
   423	  case "$line" in
   424	    LINK\ *)
   425	      # `LINK <relpath> <target>` is what a --link install records; this
   426	      # uninstaller handles copy-mode records only (rc.1 condition): the
   427	      # link stays, the refusal is named and counted.
   428	      unsafe_count=$((unsafe_count + 1))
   429	      _log "    REFUSED (LINK record — copy-mode uninstaller; the link is left in place): ${line#LINK }"
   430	      continue ;;
   431	  esac
   432	  if ! printf '%s' "$line" | LC_ALL=C grep -qE '^[0-9a-f]{64}  [^ ]'; then
   433	    unsafe_count=$((unsafe_count + 1))
   434	    _log "    REFUSED (malformed manifest record — not touched): $line"
   435	    continue
   436	  fi
   437	  _rel="${line#*  }"
   438	  if _rel_unsafe "$_rel"; then
   439	    unsafe_count=$((unsafe_count + 1))
   440	    _log "    REFUSED (unsafe manifest path — not touched): $_rel"
   441	    continue
   442	  fi
   443	  if _rel_ancestor_link "$_rel"; then
   444	    unsafe_count=$((unsafe_count + 1))
   445	    _log "    REFUSED (symlinked ancestor — a removal would follow it outside the target): $_rel"
   446	    continue
   447	  fi
   448	  valid_count=$((valid_count + 1))
   449	  printf '%s\t%s\n' "${line%%  *}" "$_rel" >> "$_LEDGER"
   450	done < "$MANIFEST"
   451	
   452	# rc.1 re-pass round 9, part 3: relpath UNIQUENESS across the whole ledger.
   453	# Each record was validated on its own, so a relpath recorded TWICE produced
   454	# two ledger rows and the walk below acts per row: `<old-sha>  docs/x` followed
   455	# by `<current-sha>  docs/x` PRESERVED the adopter's modified file on the first
   456	# row and REMOVED it on the second — without --force, exit 5 only afterwards.
   457	# Ambiguous provenance is refused WHOLE (every occurrence, as doctor.sh does):
   458	# nothing under a duplicated relpath is archived or removed.
   459	_dup_rels="$( cut -f2- "$_LEDGER" | LC_ALL=C sort | LC_ALL=C uniq -d )"
   460	if [ -n "$_dup_rels" ]; then
   461	  _LEDGER_UNIQ="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger-uniq)"
   462	  while IFS="$( printf '\t' )" read -r _lsha _lrel || [ -n "$_lrel" ]; do
   463	    [ -n "$_lrel" ] || continue
   464	    if printf '%s\n' "$_dup_rels" | LC_ALL=C grep -qxF -- "$_lrel"; then
   465	      unsafe_count=$((unsafe_count + 1))
   466	      valid_count=$((valid_count - 1))
   467	      _log "    REFUSED (relpath recorded more than once — ambiguous provenance, not touched): $_lrel"
   468	      continue
   469	    fi
   470	    printf '%s\t%s\n' "$_lsha" "$_lrel" >> "$_LEDGER_UNIQ"
   471	  done < "$_LEDGER"
   472	  mv -f "$_LEDGER_UNIQ" "$_LEDGER"
   473	fi
   474	
   475	# rc.1 re-pass round 10 (refuter): uniqueness by STRING cannot see every alias
   476	# of one inode — an empty segment (`docs//x`), case folding on a
   477	# case-insensitive filesystem (`docs/X`), Unicode normalisation on APFS, or a
   478	# hard link between two recorded paths. Enumerating spellings does not
   479	# converge; IDENTITY does: every ledger relpath that exists is lstat()ed
   480	# (the leaf is never followed) and EVERY relpath whose (st_dev, st_ino)
   481	# appears under more than one spelling is refused before backup and removal.
   482	# The grammar above already refused control bytes, whitespace and glob
   483	# characters, so the relpaths round-trip through python3 byte-exact.
   484	_alias_rels="$(python3 - "$TARGET" "$_LEDGER" <<'PY'
   485	import os, sys
   486	target, ledger = sys.argv[1], sys.argv[2]
   487	seen = {}
   488	with open(ledger, 'r', encoding='utf-8') as fh:
   489	    for line in fh:
   490	        line = line.rstrip('\n')
   491	        if '\t' not in line:
   492	            continue
   493	        rel = line.split('\t', 1)[1]
   494	        try:
   495	            st = os.lstat(os.path.join(target, rel))
   496	        except OSError:
   497	            continue
   498	        seen.setdefault((st.st_dev, st.st_ino), set()).add(rel)
   499	for rels in seen.values():
   500	    if len(rels) > 1:
   501	        for rel in sorted(rels):
   502	            sys.stdout.write(rel + '\n')
   503	PY
   504	)"
   505	if [ -n "$_alias_rels" ]; then
   506	  _LEDGER_IDENT="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger-ident)"
   507	  while IFS="$( printf '\t' )" read -r _lsha _lrel || [ -n "$_lrel" ]; do
   508	    [ -n "$_lrel" ] || continue
   509	    if printf '%s\n' "$_alias_rels" | LC_ALL=C grep -qxF -- "$_lrel"; then
   510	      unsafe_count=$((unsafe_count + 1))
   511	      valid_count=$((valid_count - 1))
   512	      _log "    REFUSED (relpath is an alias of another recorded path — same inode, ambiguous provenance, not touched): $_lrel"
   513	      continue
   514	    fi
   515	    printf '%s\t%s\n' "$_lsha" "$_lrel" >> "$_LEDGER_IDENT"
   516	  done < "$_LEDGER"
   517	  mv -f "$_LEDGER_IDENT" "$_LEDGER"
   518	fi
   519	
   520	# Pre-uninstall backup (unless --no-backup)
   521	if [ "$NO_BACKUP" -eq 0 ]; then
   522	  if ! _dry "would BACKUP .claude/ before uninstall"; then
   523	    timestamp="$(date -u +%Y%m%d-%H%M%SZ)"
   524	    backup="$TARGET/.claude.backup-uninstall-$timestamp.tar.gz"
   525	    _log "==> Pre-uninstall backup: $backup"
   526	    # PLAN-183 §9.8 (S337): the manifest records deliveries OUTSIDE .claude/
   527	    # (docs/, .github/ since W5; SPEC/, PROTOCOL.md, the marker) and the walk
   528	    # below removes them, so the backup must cover them too — a tarball of
   529	    # .claude/ alone could not restore what this run deletes. The list comes
   530	    # from the manifest itself, regular files only, nothing outside it.
   531	    backup_list="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-list)"
   532	    printf '.claude\n' > "$backup_list"
   533	    # rc.1 re-pass round 3, part 3 — from the SANITIZED LEDGER, which is the
   534	    # same set of records the removal walk below acts on. The path checks that
   535	    # used to be repeated here now live in the single parse; what is left is
   536	    # the archive-specific question of whether the file exists as a regular
   537	    # file right now (`-f` and `tar` follow links, `! -L` tests the leaf).
   538	    cut -f2- "$_LEDGER" 2>/dev/null \
   539	      | while IFS= read -r _brel; do
   540	          case "$_brel" in .claude/*) continue ;; esac
   541	          [ -f "$TARGET/$_brel" ] && [ ! -L "$TARGET/$_brel" ] && printf '%s\n' "$_brel"
   542	        done >> "$backup_list"
   543	    # NO --no-recursion: the list carries `.claude` as a DIRECTORY entry whose
   544	    # contents must be archived (its files are excluded from the list by
   545	    # design). Adding it emptied every backup of .claude/* — caught by e2e U.3
   546	    # and by the pair rail in the same round (r3 defect, cured r4).
   547	    ( cd "$TARGET" && tar czf "$backup" -T "$backup_list" 2>/dev/null )
   548	    rm -f "$backup_list"
   549	    key_path="$(_resolve_backup_key || true)"
   550	    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
   551	      backup_hmac="$(python3 -c "
   552	import hashlib, hmac, sys
   553	key = open('$key_path', 'rb').read()
   554	tar_sha = hashlib.sha256(open('$backup', 'rb').read()).digest()
   555	sys.stdout.write(hmac.new(key, tar_sha, hashlib.sha256).hexdigest())
   556	")"
   557	      printf '%s  %s\n' "$backup_hmac" "$backup" > "$backup.hmac"
   558	      chmod 0600 "$backup.hmac"
   559	    fi
   560	  fi
   561	fi
   562	
   563	# Walk the SANITIZED LEDGER; for each entry, verify SHA before delete.
   564	mismatch_count=0
   565	removed_count=0
   566	preserved_count=0
   567	absent_count=0
   568	mismatch_files=""
   569	
   570	# rc.1 re-pass (round 2, part 3): the parse is TOTAL. `read` alone drops an
   571	# unterminated final record (a manifest whose trailing newline was lost never
   572	# processed its last delivery); a record that matched no shape was skipped in
   573	# silence — so an empty, comment-only or malformed manifest left every counter
   574	# at zero, the ledger was DELETED below and the run exited 0 with framework
   575	# files still on disk.
   576	#
   577	# rc.1 re-pass (round 3, part 3): that parse now happens ONCE, above, into
   578	# `$_LEDGER` — the same records the backup archived. What is left here is the
   579	# filesystem question, and it used to fail OPEN on every answer but "regular
   580	# file": a directory or a FIFO at a managed path fell through `continue`
   581	# without touching a counter, so the run could remove the ownership manifest
   582	# and exit 0 with the managed path still there; a dangling symlink counted as
   583	# ABSENT; and a symlink leaf pointing at an external regular file passed `-f`
   584	# and was read THROUGH by the hasher. Every one of those is now REFUSED and
   585	# counted, which keeps the manifest and exits 6.
   586	while IFS="$( printf '\t' )" read -r recorded_sha rel || [ -n "$rel" ]; do
   587	  [ -n "$rel" ] || continue
   588	  fpath="$TARGET/$rel"
   589	
   590	  # BEFORE -e, because -e is FALSE for a dangling link and the link would
   591	  # otherwise be filed as "absent" and left behind. A link is never followed:
   592	  # not to test it, not to hash it, not to remove it.
   593	  if [ -L "$fpath" ]; then
   594	    unsafe_count=$((unsafe_count + 1))
   595	    _log "    REFUSED (manifest path is a symlink — never followed, never removed): $rel"
   596	    continue
   597	  fi
   598	
   599	  if [ ! -e "$fpath" ]; then
   600	    absent_count=$((absent_count + 1))
   601	    continue
   602	  fi
   603	
   604	  if [ ! -f "$fpath" ]; then
   605	    unsafe_count=$((unsafe_count + 1))
   606	    _log "    REFUSED (manifest path exists but is not a regular file — not touched): $rel"
   607	    continue
   608	  fi
   609	
   610	  actual_sha="$(python3 -c "
   611	import hashlib, sys
   612	with open(sys.argv[1], 'rb') as f:
   613	    sys.stdout.write(hashlib.sha256(f.read()).hexdigest())
   614	" "$fpath")"
   615	
   616	  if [ "$actual_sha" = "$recorded_sha" ]; then
   617	    if _dry "would REMOVE $rel"; then
