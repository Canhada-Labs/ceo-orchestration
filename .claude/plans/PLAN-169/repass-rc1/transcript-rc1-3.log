   388	def _fmt_resets(resets_at: Optional[str]) -> str:
   389	    """Render a reset time as ``(rHH:MM)`` local. Accepts the verified
   390	    UNIX-epoch-seconds form (e.g. ``"1738425600"``) OR an ISO-8601 string.
   391	    A pure integer string is treated as epoch; anything else is tried as
   392	    ISO. Out-of-range / unparseable → empty (fail-soft, never raises)."""
   393	    if not resets_at:
   394	        return ""
   395	    s = str(resets_at)
   396	    # Epoch seconds: an all-digit token (optionally fractional). Reject the
   397	    # absurd (negative/zero handled by the digit check; cap to ~year 3000).
   398	    if re.fullmatch(r"\d{6,12}(\.\d+)?", s):
   399	        try:
   400	            ts = datetime.fromtimestamp(float(s), tz=timezone.utc)
   401	            return "(r%s)" % ts.astimezone().strftime("%H:%M")
   402	        except (ValueError, OverflowError, OSError):
   403	            return ""
   404	    try:
   405	        ts = datetime.fromisoformat(s.replace("Z", "+00:00"))
   406	        return "(r%s)" % ts.astimezone().strftime("%H:%M")
   407	    except ValueError:
   408	        return ""
