   144	# ---------------------------------------------------------------------------
   145	# Path resolution (ADR-001; byte-mirrors _lib/audit_emit._audit_dir())
   146	# ---------------------------------------------------------------------------
   147	
   148	
   149	def _audit_dir() -> Path:
   150	    """Per-PROJECT runtime state dir, resolved by the single resolver.
   151	
   152	    PLAN-182 (S325): this template used to rebuild
   153	    `$HOME/.claude/projects/ceo-orchestration` literally. Every adopter that
   154	    installed it therefore wrote into a directory named after THIS framework
   155	    instead of their own project, entangling their HMAC chain with every
   156	    other project under the same $HOME — the class PLAN-182 W1 closed for the
   157	    live tree and left open in this orphan.
   158	
   159	    Fallback shape mirrors `.claude/hooks/SessionEnd.py`: fail-OPEN with a
   160	    stderr breadcrumb, because a partial upgrade must not crash a statusline.
   161	    """
   162	    env_dir = os.environ.get("CEO_AUDIT_LOG_DIR")
   163	    if env_dir:
   164	        return Path(env_dir)
   165	    if _rp is not None:
   166	        return _rp.runtime_state_dir()
   167	    sys.stderr.write(
   168	        "# statusline: _lib/runtime_paths ausente — fallback legado (partial upgrade)\n"
   169	    )
   170	    home = os.environ.get("HOME") or str(Path.home())
   171	    return Path(home) / ".claude" / "projects" / "ceo-orchestration"  # rp-allow: partial-upgrade-fallback
   172	
   173	
   174	def _default_sidecar_path() -> Path:
   175	    return _audit_dir() / "state" / "statusline-snapshot.json"
   176	
   177	
   178	def _sidecar_override_safe(raw: str, target: Path) -> bool:
   179	    """True iff the CEO_STATUSLINE_SIDECAR override is NOT a symlink target, has
   180	    no symlinked immediate parent, and contains no '..' traversal segment.
   181	
   182	    PLAN-135-FOLLOWUP (Codex R5 P1-3, a-symlink DiD). The override is a documented
   183	    full-path escape, so we do NOT constrain it under the audit dir (that would
   184	    break the override's purpose + the test fixture). We only reject the
   185	    symlink/traversal sub-vector: a tampered settings `env` block could point the
   186	    always-on writer at an attacker-controlled symlink so an os.replace overwrites
   187	    an out-of-tree file. Best-effort os.path.islink (one lstat each; NO
   188	    os.path.realpath — it stats every path component); OSError → fail-closed
   189	    (reject → default). RESIDUAL (intentionally not closed here): a plain absolute
   190	    path to an attacker-writable dir on the same host, or a symlinked deep
   191	    ancestor, still passes — the real control for the settings-injection vector is
   192	    effective_config's settings-layer tamper detection (Codex R5 P1-3, option b)."""
   193	    try:
   194	        # Inspect the RAW segments — os.path.normpath would RESOLVE a '..' away
   195	        # before we could see it, so a literal traversal segment must be caught
   196	        # pre-normalization.
   197	        if ".." in raw.replace("\\", os.sep).split(os.sep):
   198	            return False
   199	        if os.path.islink(str(target)):
   200	            return False
   201	        parent = target.parent
   202	        if parent.exists() and os.path.islink(str(parent)):
   203	            return False
   204	    except OSError:
   205	        return False
   206	    return True
   207	
   208	
   209	def _sidecar_path() -> Path:
   210	    env = os.environ.get("CEO_STATUSLINE_SIDECAR")
   211	    if env:
   212	        target = Path(os.path.expanduser(env))
   213	        if not _sidecar_override_safe(env, target):
   214	            sys.stderr.write(
   215	                "# statusline-ceo: CEO_STATUSLINE_SIDECAR rejected "
   216	                "(symlink/traversal target) — using default sidecar path\n"
   217	            )
   218	            return _default_sidecar_path()
   219	        return target
   220	    return _default_sidecar_path()
   221	
