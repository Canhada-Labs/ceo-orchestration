   623	def _emit(adapter, contract, *, allow: bool, reason, system_message) -> None:
   624	    """Emit the Stop decision through the resolved adapter (event-driven
   625	    host egress). Stop family: block => {"decision":"block","reason"},
   626	    allow => {} (+ systemMessage)."""
   627	    decision = contract.Decision(
   628	        allow=allow,
   629	        reason=reason,
   630	        system_message=system_message,
   631	        extra={"hookEventName": "Stop"},
   632	    )
   633	    adapter_basename = (getattr(adapter, "__name__", "") or "").rsplit(".", 1)[-1]
   634	    try:
   635	        if adapter_basename == "claude":
   636	            adapter.emit_decision(decision)
   637	        else:
   638	            adapter.emit_decision(decision, event=None)
   639	    except Exception:
   640	        # Last-resort: emit the codex Stop wire directly so a block is never
   641	        # dropped (foreign JSON would be a silent allow — the S254 class).
   642	        out: Dict[str, Any] = {}
   643	        if not allow:
   644	            out = {"decision": "block", "reason": reason or "review required"}
   645	        elif system_message:
   646	            out = {"systemMessage": system_message}
   647	        sys.stdout.write(json.dumps(out, ensure_ascii=False) + "\n")
   648	
   649	
   650	def _stop_main() -> int:
   651	    if os.environ.get(_KILL_SWITCH_ENV, "").strip().lower() in {
   652	        "0",
   653	        "false",
   654	        "off",
   655	        "no",
   656	    }:
   657	        sys.stdout.write("{}\n")
   658	        return 0
   659	
   660	    try:
   661	        from _lib import adapters as _adapters  # noqa: E402
   662	        from _lib import contract as _contract  # noqa: E402
   663	    except Exception:
   664	        # Infrastructure import failure → fail-open allow (never wedge Stop).
   665	        sys.stdout.write("{}\n")
   666	        return 0
   667	
   668	    adapter = _adapters.resolve()
   669	
   670	    try:
   671	        event = adapter.read_event(phase="Stop")
   672	    except Exception:
   673	        _emit(adapter, _contract, allow=True, reason=None, system_message=None)
   674	        return 0
   675	
   676	    if getattr(event, "parse_error", None):
   677	        # Garbled Stop envelope is INFRASTRUCTURE (not a security edit
   678	        # matcher) → allow. A Stop-block on garbage would wedge sessions.
   679	        _emit(adapter, _contract, allow=True, reason=None, system_message=None)
   680	        return 0
   681	
   682	    raw = getattr(event, "raw_payload", {}) or {}
   683	    session_id = str(getattr(event, "session_id", "") or "") or (
   684	        os.environ.get("CLAUDE_SESSION_ID", "") or "unknown-session"
   685	    )
   686	    stop_hook_active = bool(raw.get("stop_hook_active"))
   687	    repo_root = Path(
   688	        str(getattr(event, "project", "") or "")
   689	        or os.environ.get("CLAUDE_PROJECT_DIR")
   690	        or os.getcwd()
   691	    )
   692	
   693	    try:
   694	        allow, reason, system_message, red = decide(
   695	            repo_root=repo_root,
   696	            session_id=session_id,
   697	            stop_hook_active=stop_hook_active,
   698	        )
   699	    except Exception as exc:
   700	        _breadcrumb("decide() raised (fail-open allow): %s" % str(exc)[:120])
   701	        _emit(adapter, _contract, allow=True, reason=None, system_message=None)
   702	        return 0
   703	
   704	    if red and system_message:
   705	        _write_red_breadcrumb(system_message + " session=" + session_id[:64])
   706	
   707	    _emit(
   708	        adapter,
   709	        _contract,
   710	        allow=allow,
   711	        reason=reason,
   712	        system_message=system_message,
   713	    )
   714	    return 0
   715	
