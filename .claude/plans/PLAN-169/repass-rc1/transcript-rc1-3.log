     1	#!/usr/bin/env bash
     2	# scripts/doctor.sh — installed-state diagnostician + selective repair
     3	# (PLAN-153 Wave B item B3)
     4	#
     5	# Diffs an installed target repo against the baseline recorded at install
     6	# time in .claude/.install-manifest.sha256 (written by install.sh
     7	# write_install_manifest / upgrade.sh via _write_baseline_manifest) and
     8	# reports, per manifest record:
     9	#
    10	#   OK        current sha256 == recorded baseline (framework-pristine)
    11	#   DRIFT     file exists, sha256 != baseline (sub-classified against the
    12	#             framework checkout: adopter-modified / baseline-stale / conflict)
    13	#   MISSING   manifest record present, file absent on disk
    14	#   ORPHAN?   file present under a framework-owned directory but NOT in the
    15	#             manifest (candidates only — NEVER removed by this script)
    16	#
    17	# --repair restores drifted/missing files SELECTIVELY from the framework
    18	# checkout this script lives in (SOURCE_DIR resolution mirrors install.sh).
    19	#
    20	# SAFETY INVARIANTS (uninstall.sh depends on these):
    21	#   * uninstall.sh removes ONLY files whose current sha256 matches the
    22	#     manifest record (uninstall.sh:227). doctor.sh preserves that property:
    23	#     a repair copies a file ONLY when the framework source still hashes to
    24	#     the recorded baseline (H_src == H_base), and verifies the restored
    25	#     content re-hashes to the baseline. Post-repair state is therefore
    26	#     exactly the recorded install state.
    27	#   * doctor.sh NEVER writes .claude/.install-manifest.sha256. If the
    28	#     framework checkout has moved past the baseline, repair is BLOCKED for
    29	#     that file and upgrade.sh (which owns baseline rewrites) is advised.
    30	#   * Adopter-modified files are NEVER overwritten without an explicit
    31	#     per-file confirmation: --yes-file <relpath> (repeatable) or an
    32	#     interactive [y/N] prompt when stdin is a TTY. Overwritten files are
    33	#     first backed up to .claude.bak/doctor-<UTC-ts>/<relpath>.
    34	#   * Orphan candidates are report-only. doctor.sh deletes nothing, ever.
    35	#   * The manifest is never read through a symlink (a symlinked LEAF is
    36	#     refused before `-f`, exit 2), and its identity (device:inode) is
    37	#     pinned after sanitization and re-proved before every write of
    38	#     --repair: foreign provenance never drives a write (rc.1 round 11).
    39	#   * Every write under the target (restore, backup, re-link) is answered
    40	#     first by the destination-confinement predicate the installer and the
    41	#     upgrader use (_wbm_dst_refuses, PLAN-185 / PLAN-185-FOLLOWUP FU-7): a
    42	#     symlinked or hard-linked destination, a symlinked ancestor, or a path
    43	#     that resolves outside the target is REFUSED by name and nothing is
    44	#     written — a refusal counts as an unresolved finding (exit 1).
    45	#
    46	# Usage:
    47	#   ./doctor.sh <target-repo-path> [options]
    48	#
    49	# Options:
    50	#   --repair             Restore drifted/missing framework files (selective)
    51	#   --dry-run            With --repair: print what WOULD be restored, write
    52	#                        nothing. (Without --repair, report-only is already
    53	#                        the default posture.)
    54	#   --yes-file <rel>     Pre-approve restore of ONE adopter-modified file
    55	#                        (repeatable; exact manifest relpath)
    56	#   --profile <list>     Comma-separated profile list for the orphan scan
    57	#                        (default: auto-detect core,frontend + installed
    58	#                        domain dirs under .claude/skills/domains/)
    59	#   --strict-orphans     Orphan candidates also drive exit code 1
    60	#   --no-orphan-scan     Skip the orphan scan
    61	#   --verbose            Also print OK lines (default: findings only)
    62	#   -h, --help           Show this help
    63	#
    64	# Exit codes:
    65	#   0  clean (no unresolved drift/missing; orphans ignored unless --strict-orphans)
    66	#   1  findings remain after the run (drift/missing, or orphans under --strict-orphans)
    67	#   2  usage error / infrastructure problem (bad args, no manifest, no hasher)
    68	#
    69	# bash 3.2-safe (macOS /bin/bash): no mapfile, no associative arrays.
    70	
    71	# Bash portability guard (mirrors uninstall.sh:30-38).
    72	if [ -z "${BASH_VERSINFO:-}" ]; then
    73	  echo "ERROR: doctor.sh requires bash" >&2
    74	  exit 2
    75	fi
    76	if [ "${BASH_VERSINFO[0]}" -lt 3 ] || \
    77	   { [ "${BASH_VERSINFO[0]}" -eq 3 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
    78	  echo "ERROR: doctor.sh requires bash >= 3.2 (detected ${BASH_VERSION})" >&2
    79	  exit 2
    80	fi
    81	
    82	set -euo pipefail
    83	
    84	# ---------------------------------------------------------------------------
    85	# Argument parsing
    86	# ---------------------------------------------------------------------------
    87	TARGET=""
    88	REPAIR=0
    89	DRY_RUN=0
    90	PROFILE=""
    91	STRICT_ORPHANS=0
    92	NO_ORPHAN_SCAN=0
    93	VERBOSE=0
