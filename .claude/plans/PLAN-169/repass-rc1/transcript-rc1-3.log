    71	class TestFrozenSubsetDeclaration(TestEnvContext):
    72	    """Read-only over the live tree, but `TestEnvContext` is still the
    73	    base: env isolation is the corpus-wide contract for new tests
    74	    (check-test-env-hygiene gate), and it costs nothing here."""
    75	    def test_template_exists(self) -> None:
    76	        self.assertTrue(TEMPLATE.is_file(), TEMPLATE)
