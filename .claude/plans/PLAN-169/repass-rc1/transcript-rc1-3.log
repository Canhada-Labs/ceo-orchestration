  1160	# ---- Helpers ----
  1161	
  1162	# PLAN-120-FOLLOWUP WS-D (E10-F4) — refuse to write through a pre-existing
  1163	# symlinked INTERMEDIATE path component under $TARGET. The leaf $dst is
  1164	# already guarded by the `-L "$dst"` skip below; this closes the gap where
  1165	# e.g. $TARGET/.claude -> /etc would make `mkdir -p` + `cp -R` write under
  1166	# /etc. Walks every component strictly between $TARGET and dirname($dst)
  1167	# and hard-fails (exit 1, picked up by the rollback trap) if any existing
  1168	# component is a symlink. Legitimate `--mode link` installs symlink only
  1169	# the LEAF, never a parent, so this never trips them.
  1170	_assert_no_symlink_parents() {
  1171	  local rel_path="$1"
  1172	  # Only validate paths we write under $TARGET.
  1173	  local parent_rel
  1174	  parent_rel="$( dirname "$rel_path" )"
  1175	  [[ "$parent_rel" == "." ]] && return 0
  1176	  local cur="$TARGET"
  1177	  local comp rest="$parent_rel"
  1178	  # PLAN-185 W1 — the segment walk is now a `case` split, not `IFS='/'` plus an
  1179	  # UNQUOTED `for`. The old form asked for IFS word splitting and silently got
  1180	  # PATHNAME expansion with it, so a component containing `*` was replaced by
  1181	  # whatever it matched in the cwd (or, matching nothing, kept verbatim) — the
  1182	  # walk then tested paths that were not the ones being installed. Same walk as
  1183	  # _wbm_dst_refuses in the shared library, for the same reason.
  1184	  while [[ -n "$rest" ]]; do
  1185	    case "$rest" in
  1186	      */*) comp="${rest%%/*}"; rest="${rest#*/}" ;;
  1187	      *)   comp="$rest";       rest="" ;;
  1188	    esac
  1189	    [[ -z "$comp" || "$comp" == "." ]] && continue
  1190	    cur="$cur/$comp"
  1191	    if [[ -L "$cur" ]]; then
  1192	      echo "::error::refusing install — symlinked path component under target: $cur" >&2
  1193	      echo "::error::an intermediate component of '$rel_path' is a symlink; aborting to avoid write-through escape" >&2
  1194	      exit 1
  1195	    fi
  1196	  done
  1197	  return 0
  1198	}
  1199	
  1200	# The PLAN-185 W1 destination-confinement POLICY (_dst_refuses and friends) used
  1201	# to live here. It now sits immediately after `trap cleanup_on_failure EXIT`,
  1202	# because the global pre-flight has to answer BEFORE the first thing that
  1203	# touches the target — and that thing is `mkdir -p "$TARGET/.claude"`, which
  1204	# runs well above this point.
  1205	
  1206	install_one() {
  1207	  local rel_path="$1"
  1208	  local src="$SOURCE_DIR/$rel_path"
  1209	  local dst="$TARGET/$rel_path"
  1210	
  1211	  # PLAN-166 F3 (ADR-155-AMEND-1): delivery signal for the caller — 1 only
  1212	  # when THIS call actually wrote the destination (COPIED/LINKED). An
  1213	  # EXISTS-skip, a missing source and a dry-run all leave it 0.
  1214	  INSTALL_ONE_WROTE=0
  1215	
  1216	  if [[ ! -e "$src" ]]; then
  1217	    echo "    SKIP (source missing): $rel_path"
  1218	    return
  1219	  fi
  1220	
  1221	  if [[ "$DRY_RUN" -eq 1 ]]; then
  1222	    if [[ -e "$dst" || -L "$dst" ]]; then
  1223	      echo "    (dry-run) EXISTS (would skip): $rel_path"
  1224	    elif [[ "$MODE" == "link" ]]; then
  1225	      echo "    (dry-run) would LINK: $rel_path"
  1226	    else
  1227	      echo "    (dry-run) would COPY: $rel_path"
  1228	    fi
  1229	    return
  1230	  fi
  1231	
  1232	  _assert_no_symlink_parents "$rel_path"
  1233	  mkdir -p "$( dirname "$dst" )"
  1234	
  1235	  if [[ -e "$dst" || -L "$dst" ]]; then
  1236	    echo "    EXISTS (skipping): $rel_path"
  1237	    return
  1238	  fi
  1239	
  1240	  if [[ "$MODE" == "link" ]]; then
  1241	    ln -s "$src" "$dst"
  1242	    INSTALL_ONE_WROTE=1
  1243	    # V5 (repass-r2 part-a): remember every link THIS run created. The
  1244	    # manifest writer exports the exact set as FMS_LINK_PATHS, so the
  1245	    # generator never allow-all serializes a pre-existing adopter symlink
  1246	    # (EXISTS-skipped above, hence NOT in this list) as a LINK delivery.
  1247	    _CREATED_LINK_RELPATHS="${_CREATED_LINK_RELPATHS:-}
  1248	$rel_path"
  1249	    echo "    LINKED: $rel_path"
  1250	  else
  1251	    if [[ -d "$src" ]]; then
  1252	      cp -R "$src" "$dst"
  1253	    else
  1254	      cp "$src" "$dst"
  1255	    fi
  1256	    INSTALL_ONE_WROTE=1
  1257	    echo "    COPIED: $rel_path"
  1258	  fi
  1259	}
