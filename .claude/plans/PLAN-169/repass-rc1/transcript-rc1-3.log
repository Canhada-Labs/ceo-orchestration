   648	        "benchmark": {
   649	            "skill": skill_name,
   650	            "version": bench.get("benchmark_version"),
   651	            "owner": bench.get("owner"),
   652	            "scenario_count": total_count,
   653	        },
   654	        "model": args.model,
   655	        "repetitions": args.repetitions,
   656	        "overall": {
   657	            "passed": passed_count,
   658	            "total": total_count,
   659	            "score": round(overall_score, 3),
   660	            "health": _health_label(overall_score, scoring.get("health_thresholds", {})),
   661	        },
   662	        "scenarios": per_scenario,
   663	        "timestamp": _now_iso(),
   664	    }
   665	
   666	
   667	def _health_label(score: float, thresholds: Dict[str, float]) -> str:
   668	    critical = thresholds.get("critical", 0.4)
   669	    warning = thresholds.get("warning", 0.6)
   670	    healthy = thresholds.get("healthy", 0.8)
   671	    if score < critical:
   672	        return "CRITICAL"
   673	    if score < warning:
   674	        return "WARNING"
   675	    if score >= healthy:
   676	        return "HEALTHY"
   677	    return "OK"
   678	
   679	
   680	def _now_iso() -> str:
   681	    from datetime import datetime, timezone
   682	
   683	    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
   684	
   685	
   686	# ---------------------------------------------------------------------------
   687	# Reporters
   688	# ---------------------------------------------------------------------------
   689	
   690	
   691	def emit_markdown(results: Dict[str, Any]) -> str:
   692	    """Render benchmark results as a markdown table for PR preview."""
   693	    lines: List[str] = []
   694	    bench = results["benchmark"]
   695	    overall = results["overall"]
   696	    lines.append(f"## Benchmark: `{bench['skill']}` (v{bench.get('version')})")
   697	    lines.append("")
   698	    lines.append(f"- **Owner:** {bench.get('owner', 'unknown')}")
   699	    lines.append(f"- **Model:** `{results['model']}`")
   700	    scenarios = results.get("scenarios", [])
   701	    agg_mode = next(
   702	        (s.get("aggregation") for s in scenarios if s.get("aggregation")),
   703	        DEFAULT_AGGREGATION,
   704	    )
   705	    flaky_count = sum(1 for s in scenarios if s.get("flaky"))
   706	    lines.append(
   707	        f"- **Repetitions:** {results['repetitions']}× ({agg_mode}-of-N)"
   708	    )
   709	    lines.append(
   710	        f"- **Overall:** {overall['passed']} / {overall['total']} passed "
   711	        f"({int(overall['score'] * 100)}%) — **{overall['health']}**"
   712	    )
   713	    if flaky_count:
   714	        lines.append(f"- **Flaky scenarios:** {flaky_count} ⚠")
   715	    lines.append(f"- **Timestamp:** {results['timestamp']}")
   716	    lines.append("")
   717	    lines.append("| ID | Scenario | Score | Status | Type | Flaky |")
   718	    lines.append("|---|---|---:|---|---|---|")
   719	    for s in results["scenarios"]:
   720	        sid = s.get("id", "?")
   721	        name = s.get("name", "")
   722	        score = s.get("median_score", 0.0)
   723	        status = "✓ PASS" if s.get("passed") else "✗ FAIL"
   724	        stype = "control" if s.get("control") else "positive"
   725	        flaky = "⚠ FLAKY" if s.get("flaky") else ""
   726	        lines.append(
   727	            f"| `{sid}` | {name} | {score} | {status} | {stype} | {flaky} |"
   728	        )
   729	    return "\n".join(lines)
   730	
   731	
   732	def emit_json(results: Dict[str, Any]) -> str:
   733	    return json.dumps(results, indent=2, ensure_ascii=False)
