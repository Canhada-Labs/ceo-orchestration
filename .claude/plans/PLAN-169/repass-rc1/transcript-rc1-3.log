   809	# ---------------------------------------------------------------------------
   810	# Main verification loop
   811	# ---------------------------------------------------------------------------
   812	OK_COUNT=0
   813	DRIFT_COUNT=0
   814	MISSING_COUNT=0
   815	REPAIRED_COUNT=0
   816	WOULD_REPAIR=0
   817	SKIPPED_CONFIRM=0
   818	BLOCKED_COUNT=0
   819	REFUSED_COUNT=0   # FU-7: writes refused by the destination-confinement predicate
