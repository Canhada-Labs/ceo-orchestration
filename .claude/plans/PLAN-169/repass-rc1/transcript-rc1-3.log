   411	def render_line(snapshot: Dict[str, Any]) -> str:
   412	    parts = []
   413	    model = snapshot.get("model_display") or snapshot.get("model_id")
   414	    if model:
   415	        parts.append(str(model)[:24])
   416	    parts.append(snapshot.get("plan_id") or "-")
