    22	# --allow-expensive — a per-invocation cap, not a budget; there is NO
    23	# aggregate workflow-wide cap, and the paths filter below is the only
    24	# throttle on how often the whole job runs. With no secret configured the
    25	# job skips visibly and bills nothing.
    26	#
    27	# SELF-CONTAINED BY CONTRACT (PLAN-183 W2 / finding A3): every script this
    28	# workflow calls must be one the installer actually delivers.
    29	# `.claude/scripts/run-skill-benchmark.py` ships via
    30	# install.sh::install_scripts_selective(). The framework's own
    31	# `.github/scripts/` is NOT installed, so nothing here may reference it.
    32	#
    33	# Only runs on changes to skill benchmarks, the runner, or this workflow
    34	# itself. Per PLAN-002 §11-bis Q2: paths filter keeps docs/plans/hooks PRs
    35	# from paying API cost.
    36	on:
    37	  pull_request:
    38	    paths:
    39	      - ".claude/skills/**/benchmarks/**"
    40	      - ".claude/scripts/run-skill-benchmark.py"
    41	      - ".github/workflows/benchmarks.yml"
    42	  push:
    43	    branches: [main]
    44	    paths:
    45	      - ".claude/skills/**/benchmarks/**"
    46	      - ".claude/scripts/run-skill-benchmark.py"
    47	      - ".github/workflows/benchmarks.yml"
    48	
    49	concurrency:
    50	  group: benchmarks-${{ github.ref }}
    51	  cancel-in-progress: true
    52	
    53	permissions:
    54	  contents: read
    55	  # Write permission needed for $GITHUB_STEP_SUMMARY
    56	  pull-requests: write
    57	
    58	jobs:
    59	  benchmarks:
    60	    name: Run skill benchmarks
    61	    runs-on: ubuntu-latest
    62	    timeout-minutes: 10
    63	
    64	    # Fork PR safety: benchmarks require ANTHROPIC_API_KEY which fork PRs
    65	    # don't have access to. Skip visibly on forks. pull_request_target is
    66	    # EXPLICITLY FORBIDDEN per PLAN-002 §8 finding #18 (code-injection
    67	    # vector in the forked repo's workflow).
    68	    if: github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository
    69	
    70	    steps:
    71	      - name: Checkout
    72	        uses: actions/checkout@v4
    73	
    74	      - name: Set up Python
    75	        uses: actions/setup-python@v5
    76	        with:
    77	          python-version: "3.12"
    78	
    79	      - name: Install dependencies
    80	        run: |
    81	          set -euo pipefail
    82	          python3 -m pip install --upgrade pip
    83	          python3 -m pip install pyyaml anthropic
    84	
    85	      - name: Detect changed benchmarks
    86	        id: detect
    87	        run: |
    88	          set -euo pipefail
    89	          # Find all benchmark YAMLs under skills/
    90	          mapfile -t ALL_BENCHES < <(find .claude/skills -type f -path '*/benchmarks/*.yaml' 2>/dev/null)
    91	          if [ ${#ALL_BENCHES[@]} -eq 0 ]; then
    92	            echo "no_benchmarks=true" >> "$GITHUB_OUTPUT"
    93	            echo "No benchmark YAMLs found — nothing to run" >&2
    94	          else
    95	            printf 'found %d benchmark file(s):\n' "${#ALL_BENCHES[@]}"
    96	            printf '  %s\n' "${ALL_BENCHES[@]}"
    97	          fi
    98	
    99	      - name: Run benchmarks (advisory, skip-if-no-key)
   100	        id: bench
   101	        env:
   102	          ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
   103	        run: |
   104	          set -euo pipefail
   105	          mkdir -p benchmark-results
   106	
   107	          if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
   108	            echo "SKIPPED: ANTHROPIC_API_KEY secret not set (advisory mode)." >&2
   109	            echo "skipped=true" >> "$GITHUB_OUTPUT"
   110	            exit 0
   111	          fi
   112	
   113	          FAILED=0
   114	          mapfile -t ALL_BENCHES < <(find .claude/skills -type f -path '*/benchmarks/*.yaml')
   115	          # Sprint 3 Item B: absolute floor at 0.6 + write lessons on failure.
   116	          # Per debate consensus R-DEV1, rc=1 for ALL floor failures (no new
   117	          # exit codes — we distinguish via $GITHUB_STEP_SUMMARY, not rc).
   118	          for bench in "${ALL_BENCHES[@]}"; do
   119	            base=$(basename "$bench" .yaml)
   120	            echo "::group::Running $bench"
   121	            out="benchmark-results/${base}.json"
   122	            md="benchmark-results/${base}.md"
   123	            # `$?` inside `if ! cmd` is the status of `!` (always 0), so the
   124	            # floor breach was reported as "runner error rc=0": capture the
   125	            # real status first, then branch on it.
   126	            rc=0
   127	            python3 .claude/scripts/run-skill-benchmark.py \
   128	                 "$bench" \
   129	                 --output-json "$out" \
   130	                 --markdown \
   131	                 --floor 0.6 \
   132	                 --write-lessons \
   133	                 --skip-if-no-key > "$md" || rc=$?
   134	            if [ "$rc" -ne 0 ]; then
   135	              if [ "$rc" -eq 1 ]; then
   136	                echo "::error::$bench below floor (CRITICAL or <0.6)"
   137	                FAILED=1
   138	              else
   139	                echo "::error::$bench: runner error rc=$rc"
   140	                FAILED=1
   141	              fi
   142	            fi
   143	            if [ -s "$md" ]; then cat "$md"; fi
   144	            echo "::endgroup::"
   145	          done
   146	
   147	          echo "failed=$FAILED" >> "$GITHUB_OUTPUT"
   148	
   149	      - name: Post results to $GITHUB_STEP_SUMMARY
   150	        if: always()
   151	        run: |
   152	          set -euo pipefail
   153	          if [ "${{ steps.bench.outputs.skipped }}" = "true" ]; then
   154	            {
   155	              printf '## Benchmarks skipped\n\n'
   156	              printf 'ANTHROPIC_API_KEY secret is not configured.\n'
   157	              printf 'Enable in Settings -> Secrets and variables -> Actions.\n'
   158	            } >> "$GITHUB_STEP_SUMMARY"
   159	            exit 0
   160	          fi
   161	          if [ ! -d benchmark-results ] || [ -z "$(ls -A benchmark-results 2>/dev/null)" ]; then
   162	            printf '## Benchmarks: no results produced\n' >> "$GITHUB_STEP_SUMMARY"
   163	            exit 0
   164	          fi
   165	          # PLAN-183 W2 / A3: the summary is built from the per-benchmark
   166	          # Markdown that .claude/scripts/run-skill-benchmark.py emits with
   167	          # --markdown (captured per bench in the step above). The framework's
   168	          # .github/scripts/ is NOT installed, so it must not be called here.
   169	          if ls benchmark-results/*.md >/dev/null 2>&1; then
   170	            cat benchmark-results/*.md >> "$GITHUB_STEP_SUMMARY"
   171	          else
   172	            printf '## Benchmarks: results produced but no Markdown captured\n' \
   173	              >> "$GITHUB_STEP_SUMMARY"
   174	          fi
   175	
   176	      - name: Upload benchmark JSON results
   177	        if: always()
   178	        uses: actions/upload-artifact@v4
   179	        with:
   180	          name: benchmark-results
   181	          path: benchmark-results/
   182	          if-no-files-found: ignore
   183	          retention-days: 30
   184	
   185	      - name: Fail on floor breach
   186	        if: steps.bench.outputs.failed == '1'
   187	        run: |
   188	          echo "::error::One or more benchmarks fell below floor (CRITICAL < 0.4 or absolute < 0.6)"
   189	          exit 1
     1	name: Validate CEO Orchestration governance
     2	
     3	# INERT AS SHIPPED. install.sh copies this file to
     4	# `.github/workflows/validate.yml.template` — the `.template` suffix means
     5	# GitHub Actions never reads it. Activation is an EXPLICIT adopter step
     6	# (plain `mv -n`: on a fresh install the file is UNTRACKED so `git mv`
     7	# fails — rail 183-r1 — and `-n` refuses to clobber a pre-existing
     8	# validate.yml of your own — rail 183-r3; pick another name if it exists,
     9	# and commit afterwards):
    10	#   mv -n .github/workflows/validate.yml.template \
    11	#         .github/workflows/validate.yml
    12	# (PLAN-183 wave-183batch; mirrors benchmarks.yml.template:3-12. The
    13	# frozen-subset contract — 11 steps + pins — is untouched: comments only.)
    14	
    15	on:
    16	  pull_request:
    17	  push:
    18	    branches: [main]
    19	
    20	# Cancel in-progress runs when a newer commit lands on the same ref.
    21	# Prevents duplicate compute on rapid-fire PR updates and matches the
    22	# devops-ci-cd skill's concurrency-control mandate.
    23	concurrency:
    24	  group: validate-${{ github.ref }}
    25	  cancel-in-progress: true
    26	
    27	# Least-privilege: this workflow only reads the repo to validate.
    28	permissions:
    29	  contents: read
    30	
    31	jobs:
    32	  validate:
    33	    name: Governance, health, contamination, shellcheck
    34	    runs-on: ubuntu-latest
    35	    # Kill-switch parity with the framework's own validate job: set the repo
    36	    # variable CEO_SOTA_DISABLE=1 to disable this job without editing CI.
    37	    if: vars.CEO_SOTA_DISABLE != '1'
    38	    timeout-minutes: 15
    39	
    40	    steps:
    41	      - name: Checkout
    42	        # SHA-pinned (a floating major tag is mutable). Bump via Dependabot.
    43	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2
    44	
    45	      # -----------------------------------------------------------------
    46	      # Step: Governance structure validation
    47	      # -----------------------------------------------------------------
    48	      - name: Run validate-governance.sh
    49	        run: |
    50	          set -euo pipefail
    51	          bash .claude/scripts/validate-governance.sh
    52	
    53	      # -----------------------------------------------------------------
    54	      # Step: Skill health check (CI mode tolerates stale framework refs)
    55	      # -----------------------------------------------------------------
    56	      - name: Run check-skill-health.sh --ci
    57	        run: |
    58	          set -euo pipefail
    59	          bash .claude/scripts/check-skill-health.sh --ci
    60	
    61	      # -----------------------------------------------------------------
    62	      # Step: Pitfall regression check
    63	      # -----------------------------------------------------------------
    64	      - name: Run check-pitfall-regression.sh
    65	        run: |
    66	          set -euo pipefail
    67	          if [ -x .claude/scripts/check-pitfall-regression.sh ]; then
    68	            bash .claude/scripts/check-pitfall-regression.sh || {
    69	              rc=$?
    70	              # Accept exit 0 only. Anything else is a real regression.
    71	              echo "check-pitfall-regression.sh exited with rc=$rc" >&2
    72	              exit $rc
    73	            }
    74	          else
    75	            echo "check-pitfall-regression.sh not executable; skipping"
    76	          fi
    77	
    78	      # -----------------------------------------------------------------
    79	      # Step: Contamination check (project-specific refs outside allowed zones)
    80	      #
    81	      # Uses `git ls-files` so that (a) .gitignore is honored, (b) .git/
    82	      # is not descended into, (c) path anchoring is stable across runners.
    83	      # NFKC-normalizes each file before grepping to catch Unicode homoglyph
    84	      # attempts.
    85	      # -----------------------------------------------------------------
    86	      - name: Contamination check (no private-project/personal refs outside allowlist)
    87	        run: bash .claude/scripts/check-contamination.sh
    88	
    89	      # -----------------------------------------------------------------
    90	      # Step: Placeholder lint — no unfilled {{PLACEHOLDERS}} beyond the
    91	      # known template set in core/frontend skills.
    92	      # -----------------------------------------------------------------
    93	      - name: Placeholder lint (core/frontend skills only)
    94	        run: |
    95	          set -euo pipefail
    96	          # Known template placeholders we ship with (expected in template text).
    97	          ALLOWED='PROJECT_NAME|PROJECT_PATH|OWNER_NAME|DOMAIN|PRODUCTION_URL|APP_NAME|BACKEND_URL|FRONTEND_REPO_PATH|FOUNDER_NAME|CITY|COUNTRY|LEGAL_ID|STACK|DEPLOY_TARGET|DEPLOY_COMMAND|DATABASE|RUNTIME_NOTES|FILE_COUNT|LINES|TEST_COUNT|TEST_TOOL|LINT_TOOL|CI_TOOL|ARCHITECTURE_DIAGRAM|NUMERIC_RULES|ARCHITECTURE_RULES|SECURITY_RULES|ENDPOINT_LIST|DB_TABLES|ENV_VAR_COUNT|FRONTEND_PATH'
    98	          FOUND=$(grep -rhoE '\{\{[A-Z_][A-Z0-9_]*\}\}' .claude/skills/core .claude/skills/frontend 2>/dev/null | sort -u || true)
    99	          UNKNOWN=$(printf '%s\n' "$FOUND" | grep -vE "^\{\{($ALLOWED)\}\}$" || true)
   100	          if [ -n "$UNKNOWN" ]; then
   101	            echo "❌ Unknown {{PLACEHOLDERS}} in core/frontend skills:"
   102	            printf '%s\n' "$UNKNOWN"
   103	            echo ""
   104	            echo "Either fill the placeholder, replace with archetype text, or add it"
   105	            echo "to the ALLOWED list in THIS workflow file (only if it is"
   106	            echo "genuinely a shared template variable)."
   107	            exit 1
   108	          fi
   109	          echo "✓ Only known placeholders present in core/frontend skills"
   110	
   111	      # -----------------------------------------------------------------
   112	      # Step: JSON/YAML syntax check for governance files
   113	      # -----------------------------------------------------------------
   114	      - name: Validate settings.json and YAML catalogs
   115	        run: |
   116	          set -euo pipefail
   117	          jq empty .claude/settings.json
   118	          echo "✓ .claude/settings.json is valid JSON"
   119	          # PyYAML is a THIRD-PARTY module and the framework RUNTIME is
   120	          # stdlib-only (CLAUDE.md §3) — but this is CI, dev-time. A syntax
   121	          # gate that silently skips when its parser is missing is a gate
   122	          # that fails OPEN (a broken catalog would ride a green job), so the
   123	          # parser is installed here when absent and its absence is a failure.
   124	          if ! python3 -c 'import yaml' 2>/dev/null; then
   125	            python3 -m pip install --quiet --no-cache-dir "PyYAML>=6.0,<7" >/dev/null 2>&1 \
   126	              || sudo apt-get install -y -qq python3-yaml >/dev/null 2>&1 || true
   127	          fi
   128	          python3 -c 'import yaml' 2>/dev/null \
   129	            || { echo "ERROR: no YAML parser available — the catalog syntax gate cannot run (refusing to pass it silently)" >&2; exit 1; }
   130	          for y in .claude/pitfalls-catalog.yaml .claude/task-chains.yaml; do
   131	            [ -f "$y" ] || continue
   132	            python3 -c "import yaml,sys; yaml.safe_load(open(sys.argv[1])); print('✓ '+sys.argv[1]+' is valid YAML')" "$y"
   133	          done
   134	
   135	      # -----------------------------------------------------------------
   136	      # Step: Shellcheck on all active hooks and scripts
   137	      #
   138	      # .claude/hooks/legacy/ is excluded — those are Sprint 1 bash
   139	      # fallbacks kept for one sprint per PLAN-002 §11-bis Q5. They are
   140	      # NOT on the execution path (settings.json uses the Python shim).
   141	      # -----------------------------------------------------------------
   142	      - name: Shellcheck hooks and scripts (excluding legacy/)
   143	        run: |
   144	          set -euo pipefail
   145	          if ! command -v shellcheck >/dev/null 2>&1; then
   146	            sudo apt-get update -qq
   147	            sudo apt-get install -y -qq shellcheck
   148	          fi
   149	          FAILED=0
   150	          while IFS= read -r -d '' script; do
   151	            echo "--- $script ---"
   152	            shellcheck -S warning "$script" || FAILED=1
   153	          done < <(find .claude/scripts .claude/hooks \
   154	                        -path '*/legacy/*' -prune -o \
   155	                        -name '*.sh' -print0 2>/dev/null)
   156	          if [ $FAILED -eq 1 ]; then
   157	            echo "shellcheck reported warnings or errors" >&2
   158	            exit 1
   159	          fi
   160	          echo "✓ Shellcheck clean on all active hooks/scripts"
   161	
   162	      # -----------------------------------------------------------------
   163	      # NOTE (PLAN-183 W2/A2): the framework's own hook + script unit
   164	      # suites are deliberately ABSENT here. `.claude/hooks/tests/` and
   165	      # `.claude/scripts/tests/` are framework-internal: install.sh never
   166	      # copies them (install_scripts_selective / install_hooks_selective
   167	      # ship top-level files only) and _framework_path_excluded() in
   168	      # scripts/_framework_manifest_set.sh classifies both as never-shipped
   169	      # — upgrade.sh actively PURGES them as mis-installed. Running
   170	      # `unittest discover` against them here fails with
   171	      # `ImportError: Start directory is not importable`. Put YOUR OWN
   172	      # test command in this slot.
   173	      # -----------------------------------------------------------------
   174	
   175	      # -----------------------------------------------------------------
   176	      # Step: core/frontend → domains tier boundary check
   177	      # -----------------------------------------------------------------
   178	      - name: Check tier boundaries (core/frontend must not reference domains)
   179	        run: |
   180	          set -euo pipefail
   181	          python3 .claude/scripts/check-tier-boundaries.py
   182	
   183	      # -----------------------------------------------------------------
   184	      # Step: actionlint — static analysis for GitHub Actions workflows
   185	      # Downloads the binary directly (no docker pull, no marketplace dep).
   186	      # -----------------------------------------------------------------
   187	      - name: actionlint
   188	        run: |
   189	          set -euo pipefail
   190	          cd "$RUNNER_TEMP"
   191	          # Pinned release asset — never `main` (unpinned remote script = a
   192	          # supply-chain hole that grades YOUR workflows).
   193	          VERSION="1.7.7"
   194	          # Digest of the pinned release asset, verified BEFORE extraction. The
   195	          # URL pin alone still downloads and EXECUTES whatever the release
   196	          # host serves; the digest closes that hole (same check as the
   197	          # framework's own validate.yml).
   198	          EXPECTED_SHA256="023070a287cd8cccd71515fedc843f1985bf96c436b7effaecce67290e7e0757"
   199	          ASSET="actionlint_${VERSION}_linux_amd64.tar.gz"
   200	          curl -fsSLO "https://github.com/rhysd/actionlint/releases/download/v${VERSION}/${ASSET}"
   201	          echo "${EXPECTED_SHA256}  ${ASSET}" | sha256sum -c -
   202	          tar -xzf "$ASSET" actionlint
   203	          chmod +x actionlint
   204	          # nullglob so an adopter with no activated *.yml does not hand
   205	          # actionlint an unexpanded literal glob.
   206	          shopt -s nullglob
   207	          WF=( "$GITHUB_WORKSPACE/.github/workflows/"*.yml "$GITHUB_WORKSPACE/.github/workflows/"*.yaml )
   208	          if [ ${#WF[@]} -eq 0 ]; then
   209	            echo "NOTE: no activated workflow files (*.yml) — nothing to lint"
   210	          else
   211	            ./actionlint -color "${WF[@]}"
   212	          fi
   213	
   214	      # -----------------------------------------------------------------
   215	      # NOTE (PLAN-183 W2/A2): the skill-inventory idempotency gate is
   216	      # framework-only and CANNOT hold at an adopter site. install.sh ships
   217	      # ceo-orchestration/SKILL.md with the framework's FULL inventory
   218	      # baked in, while domain squads install SELECTIVELY — so
   219	      # generate-skill-inventory.sh and the committed block diverge by
   220	      # construction for any adopter that did not install all domains
   221	      # (measured: 82 generated lines vs 341 committed, diff rc=1).
   222	      # -----------------------------------------------------------------
   223	
   224	      # -----------------------------------------------------------------
   225	      # Step: Hook executable bits (.sh + active Python hooks)
   226	      # -----------------------------------------------------------------
   227	      - name: Hook and script executable bits
   228	        run: |
   229	          set -euo pipefail
   230	          MISSING=""
   231	          # All .sh files under scripts/ and hooks/ (includes legacy for
   232	          # completeness — fallback scripts should still be executable).
   233	          while IFS= read -r -d '' script; do
   234	            if [ ! -x "$script" ]; then
   235	              MISSING="$MISSING $script"
   236	            fi
   237	          done < <(find .claude/scripts .claude/hooks -name '*.sh' -print0 2>/dev/null)
   238	          # Active Python hooks (not _lib or tests — those are libraries)
   239	          for py in .claude/hooks/check_agent_spawn.py .claude/hooks/audit_log.py .claude/hooks/check_bash_safety.py .claude/hooks/check_plan_edit.py; do
   240	            if [ -f "$py" ] && [ ! -x "$py" ]; then
   241	              MISSING="$MISSING $py"
   242	            fi
   243	          done
   244	          if [ -n "$MISSING" ]; then
   245	            echo "❌ The following files are not executable:"
   246	            for m in $MISSING; do echo "  - $m"; done
   247	            echo ""
   248	            echo "Run: chmod +x <file>"
   249	            exit 1
   250	          fi
   251	          echo "✓ All active hooks/scripts are executable"
     1	#!/usr/bin/env bash
     2	# pre-push-review-gate.sh -- inverted pair-rail push backstop (PLAN-155 Wave 6).
     3	#
     4	# NOT DELIVERED BY THE INSTALLER in v1.4.0 (rc.1 re-pass, round 2, part 3):
     5	# the Codex emission roster ships `hooks.json`, `ceo.rules` and `AGENTS.md`
     6	# only, so a `--harness codex` target has NO push backstop unless you install
     7	# this file yourself:
     8	#     cp templates/codex/pre-push-review-gate.sh .git/hooks/pre-push && chmod +x .git/hooks/pre-push
     9	# The original design (debate A9, PLAN-155 Wave 6) named `.git/hooks/pre-push`
    10	# as a THIRD install surface that no manifest walk reaches naturally; wiring
    11	# it into the roster with the lifecycle symmetry (manifest + uninstall +
    12	# backup + restore) is a named item of the next release.
    13	#
    14	# ## What it enforces
    15	#
    16	# The teeth for the PARTIAL inverted pair-rail when the Stop gate was
    17	# abandoned (session killed / refused twice). Push is BLOCKED when commits
    18	# being pushed touch L3/canonical paths without a recorded cross-model
    19	# review. A review record is EITHER:
    20	#
    21	#   (a) a `Pair-Rail-Reviewed: APPROVE` trailer in each canonical-touching
    22	#       commit message (git-native; survives a fresh clone -- the ONLY path
    23	#       that works in CI / on another machine), OR
    24	#   (b) an APPROVE record in the local review-log sidecar written by
    25	#       `check_codex_stop_review.py --record`, matched by the path-set
    26	#       fingerprint (machine-local; absent on a fresh clone -- see residual).
    27	#
    28	# ## RED-on-absence (debate A2)
    29	#
    30	# Canonical commits present AND neither an (a) trailer nor a (b) matching
    31	# APPROVE record => RED (exit 1, push blocked). Silence is NOT health: an
    32	# empty/absent review-log with canonical commits to push is RED, not green.
    33	#
    34	# ## Residuals (named, per house vocabulary)
    35	#
    36	# - `git push --no-verify` bypasses every client-side hook. Backstops:
    37	#   CODEOWNERS + branch protection + the CI review-record rider
    38	#   (validate.yml) which re-checks the (a) trailer path server-side.
    39	# - The (b) sidecar is machine-local; on a fresh clone only the (a) trailer
    40	#   survives. CI therefore checks (a) only.
    41	# - Coarse first-segment path classifier: `.claude/`, `.github/`, `scripts/`,
    42	#   `SPEC/` and `PROTOCOL.md` ONLY. It does NOT recognize every path the
    43	#   framework's canonical oracle (`check_canonical_edit.py --is-canonical`)
    44	#   classifies as canonical — `.codex/rules/ceo.rules`, `.grok/config.toml`,
    45	#   `AGENTS.md`, `requirements.toml`, `templates/settings/settings.base.json`
    46	#   are canonical there and NON-canonical here (rc.1 re-pass, round 7,
    47	#   part 3). Installed by hand, this file is therefore a REMINDER, not a
    48	#   security gate: a push that touches only those paths passes without
    49	#   review. The Grok twin ports the fine oracle with a fail-closed superset
    50	#   fallback; porting it here is a named item of the next release.
    51	#
    52	# ## Controls
    53	#
    54	# - `CEO_CODEX_PUSH_GATE=0`  -> disabled (no-op, exit 0).
    55	# - `CEO_CODEX_PUSH_GATE_ADVISORY=1` -> warn but do not block (exit 0).
    56	# - `CEO_CODEX_REVIEW_STATE_DIR` / `CEO_AUDIT_LOG_DIR` -> sidecar location
    57	#   (matches check_codex_stop_review.py resolution).
    58	#
    59	# stdin (git pre-push protocol): `<local ref> <local sha> <remote ref> <remote sha>`
    60	# argv: `<remote name> <remote url>` (unused here).
    61	#
    62	# Stdlib tools only (git, sha256sum/shasum, sort, grep). shellcheck -S warning clean.
    63	
    64	set -euo pipefail
    65	
    66	if [ "${CEO_CODEX_PUSH_GATE:-1}" = "0" ]; then
    67	  exit 0
    68	fi
    69	
    70	ADVISORY="${CEO_CODEX_PUSH_GATE_ADVISORY:-0}"
    71	_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    72	
    73	_zero="0000000000000000000000000000000000000000"
    74	
    75	# Canonical first-segment prefixes (mirror of
    76	# check_canonical_edit._CANONICAL_PREFIXES; PROTOCOL.md is a file, matched
    77	# exactly).
    78	_is_canonical_path() {
    79	  # $1 = repo-relative path
    80	  case "$1" in
    81	    .claude/*|.github/*|scripts/*|SPEC/*) return 0 ;;
    82	    PROTOCOL.md) return 0 ;;
    83	    *) return 1 ;;
    84	  esac
    85	}
    86	
    87	_sha256() {
    88	  # Read stdin, emit hex digest (portable: sha256sum or shasum -a 256).
    89	  if command -v sha256sum >/dev/null 2>&1; then
    90	    sha256sum | awk '{print $1}'
    91	  else
    92	    shasum -a 256 | awk '{print $1}'
    93	  fi
    94	}
    95	
    96	_state_dir() {
    97	  if [ -n "${CEO_CODEX_REVIEW_STATE_DIR:-}" ]; then
    98	    printf '%s' "${CEO_CODEX_REVIEW_STATE_DIR}"
    99	  elif [ -n "${CEO_AUDIT_LOG_DIR:-}" ]; then
   100	    printf '%s' "${CEO_AUDIT_LOG_DIR}"
   101	  else
   102	    # PLAN-182 OQ-6 (S326): the per-project runtime state dir comes from the
   103	    # framework single resolver -- never rebuilt here. Rebuilding the literal
   104	    # made every adopter under one $HOME share ONE review log, so an APPROVE
   105	    # recorded in one repository satisfied this gate in ANOTHER. Resolver
   106	    # missing (partial upgrade) or python3 absent => EMPTY: the sidecar
   107	    # acceptance path (b) is simply unavailable and only per-commit APPROVE
   108	    # trailers (path a) can clear the push -- the same degradation an oracle
   109	    # failure already takes. Never a literal fallback.
   110	    _rp="${_repo_top}/.claude/hooks/_lib/runtime_paths.py"
   111	    if [ -f "$_rp" ] && command -v python3 >/dev/null 2>&1; then
   112	      _base="$(CLAUDE_PROJECT_DIR="$_repo_top" python3 "$_rp" --state-dir 2>/dev/null || true)"
   113	      if [ -n "$_base" ]; then
   114	        printf '%s/state' "$_base"
   115	      else
   116	        echo "pre-push-review-gate: single resolver failed; sidecar APPROVE path unavailable (trailers still clear the push)" >&2
   117	      fi
   118	    else
   119	      echo "pre-push-review-gate: single resolver not found at $_rp; sidecar APPROVE path unavailable (run scripts/upgrade.sh)" >&2
   120	    fi
   121	  fi
   122	}
   123	
   124	_review_log() {
   125	  local sd
   126	  sd="$(_state_dir)"
   127	  # Empty state dir (resolver unavailable) => no sidecar log at all.
   128	  [ -n "$sd" ] || return 0
   129	  printf '%s/codex-review-log.jsonl' "$sd"
   130	}
   131	
   132	# Collect commits to check for one pushed ref range.
   133	# Args: <local_sha> <remote_sha>
   134	_commits_in_range() {
   135	  local local_sha="$1" remote_sha="$2"
   136	  if [ "$local_sha" = "$_zero" ]; then
   137	    return 0  # branch deletion — nothing to push
   138	  fi
   139	  if [ "$remote_sha" = "$_zero" ]; then
   140	    # New branch: commits reachable from local_sha that are NOT already on any
   141	    # remote-tracking ref. `--not --all` was wrong and dangerous (pair-rail R4,
   142	    # S272; cured in the Grok twin first): `--all` includes LOCAL refs — among
   143	    # them refs/heads/<the branch being pushed>, which points at $local_sha
   144	    # itself — so the range subtracted itself and a first push of a branch
   145	    # carrying canonical edits sailed through with an EMPTY set. `--remotes`
   146	    # subtracts only what the remote already has.
   147	    git rev-list "$local_sha" --not --remotes 2>/dev/null || true
   148	  else
   149	    git rev-list "${remote_sha}..${local_sha}" 2>/dev/null || true
   150	  fi
   151	}
   152	
   153	# Canonical paths changed by one commit.
   154	_canonical_paths_in_commit() {
   155	  local sha="$1" p
   156	  # --root: without it, diff-tree emits NOTHING for a ROOT commit (there is no
   157	  # parent to diff against), so a first push whose root commit ADDS canonical
   158	  # files classified an empty set and passed the gate. The Grok twin has
   159	  # carried this flag since pair-rail R5 (S272); this copy did not, and the
   160	  # two gates disagreed about the one commit that has no parent.
   161	  git diff-tree --root --no-commit-id --name-only -r "$sha" 2>/dev/null | while IFS= read -r p; do
   162	    [ -n "$p" ] || continue
   163	    if _is_canonical_path "$p"; then
   164	      printf '%s\n' "$p"
   165	    fi
   166	  done
   167	}
   168	
   169	# Does this commit carry an APPROVE pair-rail trailer? (acceptance path a)
   170	_commit_has_approve_trailer() {
   171	  local sha="$1"
   172	  git log -1 --format='%B' "$sha" 2>/dev/null \
   173	    | grep -Eiq '^Pair-Rail-Reviewed:[[:space:]]*APPROVE' && return 0
   174	  return 1
   175	}
   176	
   177	# Does the sidecar review-log carry an APPROVE record matching this
   178	# fingerprint? (acceptance path b)
   179	_sidecar_has_approve() {
   180	  local fp="$1" log
   181	  log="$(_review_log)"
   182	  [ -n "$log" ] && [ -f "$log" ] || return 1
   183	  # Match a JSON object line that is APPROVE AND carries this fingerprint.
   184	  grep -F "\"fingerprint\": \"${fp}\"" "$log" 2>/dev/null \
   185	    | grep -Eq '"verdict": ?"APPROVE"' && return 0
   186	  # Tolerate compact JSON (no spaces).
   187	  grep -F "\"fingerprint\":\"${fp}\"" "$log" 2>/dev/null \
   188	    | grep -Eq '"verdict":"APPROVE"' && return 0
   189	  return 1
   190	}
   191	
   192	_fail_count=0
   193	_all_canonical_paths_file="$(mktemp)"
   194	trap 'rm -f "$_all_canonical_paths_file"' EXIT
   195	
   196	while read -r _local_ref _local_sha _remote_ref _remote_sha; do
   197	  [ -n "${_local_sha:-}" ] || continue
   198	  for _c in $(_commits_in_range "$_local_sha" "$_remote_sha"); do
   199	    _cpaths="$(_canonical_paths_in_commit "$_c")"
   200	    [ -n "$_cpaths" ] || continue
   201	    printf '%s\n' "$_cpaths" >> "$_all_canonical_paths_file"
   202	
   203	    # Acceptance path (a): commit-local APPROVE trailer.
   204	    if _commit_has_approve_trailer "$_c"; then
   205	      continue
   206	    fi
   207	    # Acceptance path (b): sidecar APPROVE record matching this commit's
   208	    # canonical path-set fingerprint.
   209	    _fp="$(printf '%s' "$(printf '%s\n' "$_cpaths" | sort -u)" | _sha256)"
   210	    if _sidecar_has_approve "$_fp"; then
   211	      continue
   212	    fi
   213	
   214	    _fail_count=$((_fail_count + 1))
   215	    {
   216	      echo "PRE-PUSH REVIEW GATE (inverted pair-rail) -- RED"
   217	      echo "  commit ${_c} touches L3/canonical paths with NO cross-model review record:"
   218	      printf '%s\n' "$_cpaths" | sed 's/^/    - /'
   219	      echo "  path-set fingerprint: ${_fp}"
   220	    } >&2
   221	  done
   222	done
   223	
   224	# RED-on-absence sweep: canonical paths pushed but the sidecar is empty/absent
   225	# AND no trailers cleared them (already counted above). If we saw canonical
   226	# paths at all and every one failed, that is the abandoned-Stop-gate case.
   227	if [ -s "$_all_canonical_paths_file" ] && [ "$_fail_count" -gt 0 ]; then
   228	  {
   229	    echo ""
   230	    echo "To clear this gate, EITHER:"
   231	    echo "  (a) add a 'Pair-Rail-Reviewed: APPROVE' trailer to the commit(s)"
   232	    echo "      AFTER a real claude -p cross-model review, OR"
   233	    echo "  (b) run the review at Stop time so check_codex_stop_review.py"
   234	    echo "      --record writes an APPROVE record for the path set."
   235	    echo ""
   236	    echo "Residual: 'git push --no-verify' bypasses this client-side hook;"
   237	    echo "CODEOWNERS + branch protection + the validate.yml review rider are"
   238	    echo "the server-side backstops. This gate is a BACKSTOP, not the sole line."
   239	  } >&2
   240	  if [ "$ADVISORY" = "1" ]; then
   241	    echo "pre-push-review-gate: ADVISORY mode -- ${_fail_count} unreviewed canonical commit(s); NOT blocking." >&2
   242	    exit 0
   243	  fi
   244	  exit 1
   245	fi
   246	
   247	exit 0
     1	#!/usr/bin/env bash
     2	# pre-push-review-gate.sh -- inverted pair-rail push backstop (PLAN-156 Wave 5, grok).
     3	#
     4	# THIRD install surface: the installer copies this to
     5	# `.git/hooks/pre-push-grok-review` on a `--harness grok` target (the
     6	# operator wires it as pre-push). Grok's Stop event is NON-blocking, so
     7	# unlike codex this push gate is not merely the abandoned-Stop backstop —
     8	# it is the PRIMARY enforcement point for cross-model review under grok. No manifest walk
     9	# reaches `.git/` naturally, so Wave 5's lifecycle-symmetry criteria must
    10	# list it explicitly (manifest + uninstall + backup + restore).
    11	#
    12	# ## What it enforces
    13	#
    14	# The teeth for the PARTIAL inverted pair-rail when the Stop gate was
    15	# abandoned (session killed / refused twice). Push is BLOCKED when commits
    16	# being pushed touch L3/canonical paths without a recorded cross-model
    17	# review. A review record is EITHER:
    18	#
    19	#   (a) a `Pair-Rail-Reviewed: APPROVE` trailer in each canonical-touching
    20	#       commit message (git-native; survives a fresh clone -- the ONLY path
    21	#       that works in CI / on another machine), OR
    22	#   (b) an APPROVE record in the local review-log sidecar written by
    23	#       `check_codex_stop_review.py (or its grok equivalent) --record`, matched by the path-set
    24	#       fingerprint (machine-local; absent on a fresh clone -- see residual).
    25	#
    26	# ## Fingerprint parity (PLAN-156-FOLLOWUP F5, debate C2 — unanimous)
    27	#
    28	# The recorder fingerprints the AGGREGATE canonical path set classified by
    29	# `check_canonical_edit._is_canonical` (the fine, single-source-of-truth
    30	# predicate). This gate previously hashed COARSE first-segment paths
    31	# PER-COMMIT — two break axes (classifier + granularity) that made sidecar
    32	# path (b) structurally unmatched. Now:
    33	#
    34	#   - Classification shells out to the single ORACLE:
    35	#     `python3 check_canonical_edit.py --is-canonical -` (path\t0|1 lines).
    36	#     Re-implementing the guard glob list in bash IS the drift class F5
    37	#     fixes; the bash list below survives ONLY as the oracle-failure
    38	#     fallback.
    39	#   - Granularity: the WHOLE pushed range's changed paths are aggregated
    40	#     ONCE (`git diff --name-only <remote>..<local>`, per-commit union on
    41	#     new-branch pushes) into ONE fingerprint — matching the recorder's
    42	#     aggregate working-tree set.
    43	#   - Hash construction unchanged: sha256 over the LC_ALL=C sorted-unique,
    44	#     newline-joined path set, no trailing newline (byte-identical to
    45	#     `check_codex_stop_review.fingerprint`).
    46	#   - Acceptance: sidecar APPROVE matching the aggregate fingerprint
    47	#     clears the WHOLE range; otherwise EVERY canonical-touching commit
    48	#     must carry an (a) trailer.
    49	#
    50	# ## RED-on-absence (debate A2)
    51	#
    52	# Canonical paths pushed AND neither full (a) trailer coverage nor a (b)
    53	# matching APPROVE record => RED (exit 1, push blocked). Silence is NOT
    54	# health: an empty/absent review-log with canonical commits to push is
    55	# RED, not green.
    56	#
    57	# ## Residuals (named, per house vocabulary)
    58	#
    59	# - `git push --no-verify` bypasses every client-side hook. Backstops:
    60	#   CODEOWNERS + branch protection + the CI review-record rider
    61	#   (validate.yml) which re-checks the (a) trailer path server-side.
    62	# - The (b) sidecar is machine-local; on a fresh clone only the (a) trailer
    63	#   survives. CI therefore checks (a) only.
    64	# - Coarse first-segment path classifier (mirror of
    65	#   check_canonical_edit._CANONICAL_PREFIXES) is retained ONLY as the
    66	#   oracle-failure fallback: it OVER-triggers review (fail-CLOSED — a
    67	#   missed L3 touch is the danger, an extra review is not) and its
    68	#   fingerprint will generally NOT match a recorder-written record, so
    69	#   oracle failure degrades to trailer-only acceptance, never to a bypass.
    70	#
    71	# ## Controls
    72	#
    73	# - `CEO_GROK_PUSH_GATE=0`  -> disabled (no-op, exit 0).
    74	# - `CEO_GROK_PUSH_GATE_ADVISORY=1` -> warn but do not block (exit 0).
    75	# - `CEO_GROK_REVIEW_STATE_DIR` / `CEO_AUDIT_LOG_DIR` -> sidecar location
    76	#   (matches check_codex_stop_review.py (or its grok equivalent) resolution).
    77	# - `CEO_CANONICAL_ORACLE` -> path to check_canonical_edit.py (default:
    78	#   `<repo-top>/.claude/hooks/check_canonical_edit.py`). Not a disarm
    79	#   surface beyond what CEO_GROK_PUSH_GATE=0 already grants: pointing it
    80	#   at garbage only triggers the fail-CLOSED coarse fallback.
    81	#
    82	# stdin (git pre-push protocol): `<local ref> <local sha> <remote ref> <remote sha>`
    83	# argv: `<remote name> <remote url>` (unused here).
    84	#
    85	# Stdlib tools only (git, python3 for the oracle with a no-python fallback,
    86	# sha256sum/shasum, sort, grep, awk). shellcheck -S warning clean.
    87	
    88	set -euo pipefail
    89	
    90	if [ "${CEO_GROK_PUSH_GATE:-1}" = "0" ]; then
    91	  exit 0
    92	fi
    93	
    94	ADVISORY="${CEO_GROK_PUSH_GATE_ADVISORY:-0}"
    95	
    96	_zero="0000000000000000000000000000000000000000"
    97	
    98	_repo_top="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    99	_oracle="${CEO_CANONICAL_ORACLE:-${_repo_top}/.claude/hooks/check_canonical_edit.py}"
   100	# Set to 1 by _classify_canonical when the fine oracle could not be used.
   101	_ORACLE_DEGRADED=0
   102	
   103	# COARSE first-segment prefixes. FALLBACK ONLY (F5/C2(d)): used when the
   104	# oracle shell-out fails. It must OVER-trigger (e.g. every
   105	# `.claude/plans/*.md`) = fail-CLOSED: with sidecar acceptance disabled while
   106	# degraded, a failed oracle can only DEMAND MORE review (trailers), never wave
   107	# a real L3 touch through.
   108	#
   109	# SUPERSET INVARIANT (pair-rail R2, S272 — the reason this list is not the
   110	# original 4 prefixes): "over-triggers = fail-CLOSED" is only true if this set
   111	# CONTAINS the fine oracle's first segments. The original list omitted
   112	# `templates/`, `.grok/`, `.codex/`, `AGENTS.md` and `requirements.toml` —
   113	# precisely the distribution, egress and kill-switch surfaces the fine
   114	# predicate guards (settings.base.json lives under templates/). A degraded push
   115	# touching ONLY those produced an EMPTY canonical set, and an empty set exits 0:
   116	# an UNDER-trigger — the fail-OPEN direction — on the surfaces that matter most.
   117	#
   118	# Keep this a SUPERSET of the oracle's first segments. Adding a new top-level
   119	# guarded surface to `_CANONICAL_GUARDS` means adding its first segment here.
   120	_is_canonical_path() {
   121	  # $1 = repo-relative path
   122	  case "$1" in
   123	    .claude/*|.github/*|scripts/*|SPEC/*|templates/*|.grok/*|.codex/*) return 0 ;;
   124	    PROTOCOL.md|AGENTS.md|requirements.toml) return 0 ;;
   125	    *) return 1 ;;
   126	  esac
   127	}
   128	
   129	_sha256() {
   130	  # Read stdin, emit hex digest (portable: sha256sum or shasum -a 256).
   131	  if command -v sha256sum >/dev/null 2>&1; then
   132	    sha256sum | awk '{print $1}'
   133	  else
   134	    shasum -a 256 | awk '{print $1}'
   135	  fi
   136	}
   137	
   138	_state_dir() {
   139	  if [ -n "${CEO_GROK_REVIEW_STATE_DIR:-}" ]; then
   140	    printf '%s' "${CEO_GROK_REVIEW_STATE_DIR}"
   141	  elif [ -n "${CEO_AUDIT_LOG_DIR:-}" ]; then
   142	    printf '%s' "${CEO_AUDIT_LOG_DIR}"
   143	  else
   144	    # PLAN-182 OQ-6 (S326): the per-project runtime state dir comes from the
   145	    # framework single resolver -- never rebuilt here. Rebuilding the literal
   146	    # made every adopter under one $HOME share ONE review log, so an APPROVE
   147	    # recorded in one repository satisfied this gate in ANOTHER. Resolver
   148	    # missing (partial upgrade) or python3 absent => EMPTY: the sidecar
   149	    # acceptance path (b) is simply unavailable and only per-commit APPROVE
   150	    # trailers (path a) can clear the push -- the same degradation an oracle
   151	    # failure already takes. Never a literal fallback.
   152	    _rp="${_repo_top}/.claude/hooks/_lib/runtime_paths.py"
   153	    if [ -f "$_rp" ] && command -v python3 >/dev/null 2>&1; then
   154	      _base="$(CLAUDE_PROJECT_DIR="$_repo_top" python3 "$_rp" --state-dir 2>/dev/null || true)"
   155	      if [ -n "$_base" ]; then
   156	        printf '%s/state' "$_base"
   157	      else
   158	        echo "pre-push-review-gate: single resolver failed; sidecar APPROVE path unavailable (trailers still clear the push)" >&2
   159	      fi
   160	    else
   161	      echo "pre-push-review-gate: single resolver not found at $_rp; sidecar APPROVE path unavailable (run scripts/upgrade.sh)" >&2
   162	    fi
   163	  fi
   164	}
   165	
   166	_review_log() {
   167	  local sd
   168	  sd="$(_state_dir)"
   169	  # Empty state dir (resolver unavailable) => no sidecar log at all.
   170	  [ -n "$sd" ] || return 0
   171	  printf '%s/grok-review-log.jsonl' "$sd"
   172	}
   173	
   174	# Collect commits to check for one pushed ref range.
   175	# Args: <local_sha> <remote_sha>
   176	_commits_in_range() {
   177	  local local_sha="$1" remote_sha="$2"
   178	  if [ "$local_sha" = "$_zero" ]; then
   179	    return 0  # branch deletion — nothing to push
   180	  fi
   181	  if [ "$remote_sha" = "$_zero" ]; then
   182	    # New branch: commits reachable from local_sha that are NOT already on any
   183	    # remote-tracking ref.
   184	    #
   185	    # `--not --all` (pair-rail R4, S272) was wrong and is now dangerous: `--all`
   186	    # includes LOCAL refs — among them refs/heads/<the branch being pushed>,
   187	    # which points at $local_sha itself. That subtracts the range from itself,
   188	    # so the commit list came back EMPTY and, since the per-commit union (R3) is
   189	    # now the ONLY source of classified paths, a first push of a branch carrying
   190	    # canonical edits sailed through with an empty set. `--remotes` subtracts
   191	    # only what the remote already has — the question the gate actually asks.
   192	    git rev-list "$local_sha" --not --remotes 2>/dev/null || true
   193	  else
   194	    git rev-list "${remote_sha}..${local_sha}" 2>/dev/null || true
   195	  fi
   196	}
   197	
   198	# All paths changed by one pushed ref range, one per line (unsorted, dups ok).
   199	# Non-new-branch: ONE endpoint tree diff (net change — matches the
   200	# recorder's working-tree aggregate semantics, and merge-safe).
   201	# PER-COMMIT UNION, always (pair-rail R3, S272).
   202	#
   203	# The endpoint diff (`git diff remote..local`) reports the NET effect of the
   204	# push. That is the wrong question: a range that edits a canonical file in one
   205	# commit and REVERTS it in a later one has an empty net diff — the gate saw
   206	# nothing, exited 0, and the unreviewed canonical edit still travelled to the
   207	# remote inside the intermediate commit (from where a revert-of-the-revert or a
   208	# cherry-pick resurrects it, forever unreviewed). What the gate must classify is
   209	# every path any PUSHED COMMIT touches, so the union is taken over the range in
   210	# both the existing-branch and new-branch cases.
   211	#
   212	# Consequence, intended: for an edit+revert range the gate's aggregate no longer
   213	# equals the recorder's working-tree aggregate, so sidecar path (b) cannot match
   214	# and the push must carry per-commit APPROVE trailers — the fail-CLOSED
   215	# direction.
   216	_changed_paths_in_range() {
   217	  local local_sha="$1" remote_sha="$2" c
   218	  if [ "$local_sha" = "$_zero" ]; then
   219	    return 0
   220	  fi
   221	  for c in $(_commits_in_range "$local_sha" "$remote_sha"); do
   222	    # --root: without it, diff-tree emits NOTHING for a ROOT commit (no parent
   223	    # to diff against), so a first push whose root commit ADDS canonical files
   224	    # classified an empty set and passed (pair-rail R5, S272).
   225	    git diff-tree --root --no-commit-id --name-only -r "$c" 2>/dev/null || true
   226	  done
   227	}
   228	
   229	# Classify the paths in file $1 (unique, one per line) -> canonical subset
   230	# on stdout. Single source of truth: the check_canonical_edit.py oracle CLI
   231	# (F5/C2(b)). On ANY oracle failure (missing python3/oracle file, nonzero
   232	# exit, malformed or truncated output) -> fall back to the coarse
   233	# classifier above = OVER-trigger = fail-CLOSED (F5/C2(d)).
   234	_classify_canonical() {
   235	  local in_file="$1" oracle_out expected got malformed p
   236	  expected="$(grep -c . "$in_file" || true)"
   237	  [ "$expected" = "0" ] && return 0
   238	  if [ -f "$_oracle" ] && command -v python3 >/dev/null 2>&1; then
   239	    if oracle_out="$(CLAUDE_PROJECT_DIR="$_repo_top" python3 "$_oracle" \
   240	        --is-canonical - < "$in_file" 2>/dev/null)"; then
   241	      got="$(printf '%s\n' "$oracle_out" | grep -c . || true)"
   242	      malformed="$(printf '%s\n' "$oracle_out" | grep -cEv "	[01]\$" || true)"
   243	      if [ "$got" = "$expected" ] && [ "$malformed" = "0" ]; then
   244	        printf '%s\n' "$oracle_out" | awk -F'\t' '$2=="1" {print $1}'
   245	        return 0
   246	      fi
   247	    fi
   248	  fi
   249	  # DEGRADED: the fine predicate is unavailable. Classification over-triggers
   250	  # (fail-CLOSED), but the aggregate fingerprint computed from a COARSE set is
   251	  # collision-prone — two different pushes touching the same top-level prefixes
   252	  # hash identically, so one recorded APPROVE could clear an unrelated canonical
   253	  # edit (review-reuse). Acceptance path (b) is therefore DISABLED while
   254	  # degraded; only per-commit APPROVE trailers (path a) can clear the push.
   255	  _ORACLE_DEGRADED=1
