   431	  esac
   432	  if ! printf '%s' "$line" | LC_ALL=C grep -qE '^[0-9a-f]{64}  [^ ]'; then
   433	    unsafe_count=$((unsafe_count + 1))
   434	    _log "    REFUSED (malformed manifest record — not touched): $line"
   435	    continue
   436	  fi
   437	  _rel="${line#*  }"
   438	  if _rel_unsafe "$_rel"; then
   439	    unsafe_count=$((unsafe_count + 1))
   440	    _log "    REFUSED (unsafe manifest path — not touched): $_rel"
   441	    continue
   442	  fi
   443	  if _rel_ancestor_link "$_rel"; then
   444	    unsafe_count=$((unsafe_count + 1))
   445	    _log "    REFUSED (symlinked ancestor — a removal would follow it outside the target): $_rel"
   446	    continue
   447	  fi
   448	  valid_count=$((valid_count + 1))
   449	  printf '%s\t%s\n' "${line%%  *}" "$_rel" >> "$_LEDGER"
   450	done < "$MANIFEST"
   451	
   452	# rc.1 re-pass round 9, part 3: relpath UNIQUENESS across the whole ledger.
   453	# Each record was validated on its own, so a relpath recorded TWICE produced
   454	# two ledger rows and the walk below acts per row: `<old-sha>  docs/x` followed
   455	# by `<current-sha>  docs/x` PRESERVED the adopter's modified file on the first
   456	# row and REMOVED it on the second — without --force, exit 5 only afterwards.
   457	# Ambiguous provenance is refused WHOLE (every occurrence, as doctor.sh does):
   458	# nothing under a duplicated relpath is archived or removed.
   459	_dup_rels="$( cut -f2- "$_LEDGER" | LC_ALL=C sort | LC_ALL=C uniq -d )"
   460	if [ -n "$_dup_rels" ]; then
   461	  _LEDGER_UNIQ="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger-uniq)"
   462	  while IFS="$( printf '\t' )" read -r _lsha _lrel || [ -n "$_lrel" ]; do
   463	    [ -n "$_lrel" ] || continue
   464	    if printf '%s\n' "$_dup_rels" | LC_ALL=C grep -qxF -- "$_lrel"; then
   465	      unsafe_count=$((unsafe_count + 1))
   466	      valid_count=$((valid_count - 1))
   467	      _log "    REFUSED (relpath recorded more than once — ambiguous provenance, not touched): $_lrel"
   468	      continue
   469	    fi
   470	    printf '%s\t%s\n' "$_lsha" "$_lrel" >> "$_LEDGER_UNIQ"
   471	  done < "$_LEDGER"
   472	  mv -f "$_LEDGER_UNIQ" "$_LEDGER"
   473	fi
   474	
   475	# rc.1 re-pass round 10 (refuter): uniqueness by STRING cannot see every alias
   476	# of one inode — an empty segment (`docs//x`), case folding on a
   477	# case-insensitive filesystem (`docs/X`), Unicode normalisation on APFS, or a
   478	# hard link between two recorded paths. Enumerating spellings does not
   479	# converge; IDENTITY does: every ledger relpath that exists is lstat()ed
   480	# (the leaf is never followed) and EVERY relpath whose (st_dev, st_ino)
   481	# appears under more than one spelling is refused before backup and removal.
   482	# The grammar above already refused control bytes, whitespace and glob
   483	# characters, so the relpaths round-trip through python3 byte-exact.
   484	_alias_rels="$(python3 - "$TARGET" "$_LEDGER" <<'PY'
   485	import os, sys
   486	target, ledger = sys.argv[1], sys.argv[2]
   487	seen = {}
   488	with open(ledger, 'r', encoding='utf-8') as fh:
   489	    for line in fh:
   490	        line = line.rstrip('\n')
   491	        if '\t' not in line:
   492	            continue
   493	        rel = line.split('\t', 1)[1]
   494	        try:
   495	            st = os.lstat(os.path.join(target, rel))
   496	        except OSError:
   497	            continue
   498	        seen.setdefault((st.st_dev, st.st_ino), set()).add(rel)
   499	for rels in seen.values():
   500	    if len(rels) > 1:
   501	        for rel in sorted(rels):
   502	            sys.stdout.write(rel + '\n')
   503	PY
   504	)"
   505	if [ -n "$_alias_rels" ]; then
   506	  _LEDGER_IDENT="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger-ident)"
   507	  while IFS="$( printf '\t' )" read -r _lsha _lrel || [ -n "$_lrel" ]; do
   508	    [ -n "$_lrel" ] || continue
   509	    if printf '%s\n' "$_alias_rels" | LC_ALL=C grep -qxF -- "$_lrel"; then
   510	      unsafe_count=$((unsafe_count + 1))
   511	      valid_count=$((valid_count - 1))
   512	      _log "    REFUSED (relpath is an alias of another recorded path — same inode, ambiguous provenance, not touched): $_lrel"
   513	      continue
   514	    fi
   515	    printf '%s\t%s\n' "$_lsha" "$_lrel" >> "$_LEDGER_IDENT"
   516	  done < "$_LEDGER"
   517	  mv -f "$_LEDGER_IDENT" "$_LEDGER"
   518	fi
   519	
   520	# Pre-uninstall backup (unless --no-backup)
   521	if [ "$NO_BACKUP" -eq 0 ]; then
   522	  if ! _dry "would BACKUP .claude/ before uninstall"; then
   523	    timestamp="$(date -u +%Y%m%d-%H%M%SZ)"
   524	    backup="$TARGET/.claude.backup-uninstall-$timestamp.tar.gz"
   525	    _log "==> Pre-uninstall backup: $backup"
   526	    # PLAN-183 §9.8 (S337): the manifest records deliveries OUTSIDE .claude/
   527	    # (docs/, .github/ since W5; SPEC/, PROTOCOL.md, the marker) and the walk
   528	    # below removes them, so the backup must cover them too — a tarball of
   529	    # .claude/ alone could not restore what this run deletes. The list comes
   530	    # from the manifest itself, regular files only, nothing outside it.
   531	    backup_list="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-list)"
   532	    printf '.claude\n' > "$backup_list"
   533	    # rc.1 re-pass round 3, part 3 — from the SANITIZED LEDGER, which is the
   534	    # same set of records the removal walk below acts on. The path checks that
   535	    # used to be repeated here now live in the single parse; what is left is
   536	    # the archive-specific question of whether the file exists as a regular
   537	    # file right now (`-f` and `tar` follow links, `! -L` tests the leaf).
