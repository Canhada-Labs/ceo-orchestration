   477	while IFS= read -r line || [ -n "$line" ]; do
   478	  [ -n "$line" ] || continue
   479	  case "$line" in
   480	    '#'*) continue ;;
   481	    LINK\ \ *)
   482	      rest="${line#LINK  }"
   483	      case "$rest" in
   484	        *"  "*)
   485	          rel="${rest%%  *}"
   486	          target="${rest#*  }"
   487	          ;;
   488	        *) _mark_dropped "malformed LINK record (no target)" "$rest"; continue ;;
