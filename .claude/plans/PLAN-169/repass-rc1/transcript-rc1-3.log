   544	    # contents must be archived (its files are excluded from the list by
   545	    # design). Adding it emptied every backup of .claude/* — caught by e2e U.3
   546	    # and by the pair rail in the same round (r3 defect, cured r4).
   547	    ( cd "$TARGET" && tar czf "$backup" -T "$backup_list" 2>/dev/null )
   548	    rm -f "$backup_list"
   549	    key_path="$(_resolve_backup_key || true)"
   550	    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
   551	      backup_hmac="$(python3 -c "
   552	import hashlib, hmac, sys
   553	key = open('$key_path', 'rb').read()
   554	tar_sha = hashlib.sha256(open('$backup', 'rb').read()).digest()
   555	sys.stdout.write(hmac.new(key, tar_sha, hashlib.sha256).hexdigest())
