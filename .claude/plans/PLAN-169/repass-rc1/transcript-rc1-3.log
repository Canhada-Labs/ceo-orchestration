   491	
   492	def write_sidecar_atomic(path: Path, snapshot: Dict[str, Any]) -> bool:
   493	    tmp = path.with_name(path.name + ".tmp.%d" % os.getpid())
   494	    try:
   495	        path.parent.mkdir(parents=True, exist_ok=True)
   496	        with open(tmp, "w", encoding="utf-8") as fh:
   497	            json.dump(snapshot, fh, sort_keys=True)
   498	            fh.write("\n")
   499	        os.replace(tmp, path)
   500	        return True
   501	    except OSError:
   502	        try:
   503	            if tmp.exists():  # best-effort tmp cleanup
   504	                tmp.unlink()
   505	        except OSError:
   506	            pass
   507	        return False
   508	
   509	
   510	# ---------------------------------------------------------------------------
   511	# Debounced closed-enum emit (fail-soft; heavy import only inside the branch)
   512	# ---------------------------------------------------------------------------
   513	
   514	
   515	def _emit_interval_s() -> int:
   516	    try:
   517	        return max(0, int(os.environ.get("CEO_STATUSLINE_EMIT_INTERVAL_S",
   518	                                         str(_DEFAULT_EMIT_INTERVAL_S))))
   519	    except ValueError:
   520	        return _DEFAULT_EMIT_INTERVAL_S
   521	
   522	
   523	def should_emit(marker_path: Path, digest: str, now_epoch: float,
   524	                interval_s: int) -> bool:
   525	    """True when the material digest changed AND the debounce floor elapsed."""
   526	    try:
   527	        with open(marker_path, "r", encoding="utf-8") as fh:
   528	            mark = json.load(fh)
   529	        last_digest = mark.get("digest")
   530	        last_ts = float(mark.get("emitted_at", 0))
   531	    except (OSError, ValueError, TypeError):
   532	        return True  # no/corrupt marker → first emit
   533	    if digest == last_digest:
   534	        return False
   535	    return (now_epoch - last_ts) >= interval_s
   536	
   537	
   538	def _write_marker(marker_path: Path, digest: str, now_epoch: float) -> None:
   539	    try:
   540	        tmp = marker_path.with_name(marker_path.name + ".tmp.%d" % os.getpid())
   541	        with open(tmp, "w", encoding="utf-8") as fh:
   542	            json.dump({"digest": digest, "emitted_at": now_epoch}, fh)
   543	        os.replace(tmp, marker_path)
   544	    except OSError:
   545	        pass
   546	
   547	
   548	def _pct_to_bps(pct: Optional[float], cap_bps: int = 10000) -> Optional[int]:
   549	    """Percentage (0..N) -> integer basis-points (0..cap_bps) for the
   550	    HMAC-covered statusline AUDIT breadcrumb only. None passes through.
   551	    PLAN-135-FOLLOWUP-2 (S234): the canonical encoder forbids float in a
   552	    signed payload (S181); the prior float form was written with hmac=null on
   553	    every emit since v2.44. context_pct is 0..100% (cap 10000);
   554	    buckets_used_pct_max is capped at 999% upstream (cap 99900 — no 100%
   555	    ceiling, so an over-quota burst is preserved, not floored). This does NOT
   556	    touch context_pct() or the on-disk sidecar JSON, which stay float."""
   557	    if pct is None:
   558	        return None
   559	    try:
   560	        return max(0, min(cap_bps, int(round(float(pct) * 100))))
   561	    except (TypeError, ValueError, OverflowError):
   562	        return None
