   409	
   410	
   411	def render_line(snapshot: Dict[str, Any]) -> str:
   412	    parts = []
   413	    model = snapshot.get("model_display") or snapshot.get("model_id")
   414	    if model:
   415	        parts.append(str(model)[:24])
   416	    parts.append(snapshot.get("plan_id") or "-")
   417	    pct = snapshot.get("context_pct")
   418	    if pct is not None:
   419	        parts.append("ctx:%d%%" % round(pct))
   420	    elif snapshot.get("exceeds_200k_tokens"):
   421	        parts.append("ctx:>200k")
   422	    rl = snapshot.get("rate_limits") or {}
   423	    bucket_bits = []
   424	    for key in sorted(rl):
   425	        b = rl[key]
   426	        if b.get("used_pct") is None:
   427	            continue
   428	        bucket_bits.append("%s:%d%%%s" % (_bucket_label(key), round(b["used_pct"]),
   429	                                          _fmt_resets(b.get("resets_at"))))
   430	    if bucket_bits:
   431	        parts.append(" ".join(bucket_bits))
   432	    cost = (snapshot.get("cost") or {}).get("total_cost_usd")
   433	    if cost is not None:
   434	        parts.append("$%.2f" % cost)
   435	    wt = snapshot.get("worktree") or {}
   436	    if wt.get("branch"):
   437	        parts.append("%s@%s" % (wt.get("dir") or "?", wt["branch"]))
   438	    elif wt.get("dir"):
   439	        parts.append(wt["dir"])
   440	    return " | ".join(parts) if parts else "ceo"
   441	
   442	
   443	# ---------------------------------------------------------------------------
   444	# Snapshot build + atomic sidecar write
   445	# ---------------------------------------------------------------------------
   446	
   447	
   448	def build_snapshot(data: Dict[str, Any]) -> Dict[str, Any]:
   449	    model = data.get("model") if isinstance(data.get("model"), dict) else {}
   450	    ws = data.get("workspace") if isinstance(data.get("workspace"), dict) else {}
   451	    project_dir_s = ws.get("project_dir") or data.get("cwd") or os.getcwd()
   452	    project_dir = Path(str(project_dir_s))
   453	    cost_in = data.get("cost") if isinstance(data.get("cost"), dict) else {}
   454	    cost = {}
   455	    for k in ("total_cost_usd", "total_lines_added", "total_lines_removed"):
   456	        v = _num(cost_in.get(k))
   457	        if v is not None:
   458	            cost[k] = v
   459	    exceeds = data.get("exceeds_200k_tokens")
   460	    rl = normalize_rate_limits(data.get("rate_limits"))
   461	    return {
   462	        "schema": SCHEMA,
   463	        "source": SOURCE,
   464	        "captured_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
   465	        "session_id": str(data.get("session_id") or "")[:64],
   466	        "cc_version": str(data.get("version") or "")[:32],
   467	        "model_id": str(model.get("id") or "")[:64] or None,
   468	        "model_display": str(model.get("display_name") or "")[:32] or None,
   469	        "project_dir": str(project_dir)[:256],
   470	        "plan_id": active_plan_id(project_dir),
   471	        "worktree": worktree_info(project_dir),
   472	        "context_pct": context_pct(data),
   473	        "exceeds_200k_tokens": exceeds if isinstance(exceeds, bool) else None,
   474	        "rate_limits": rl,
   475	        "rate_limits_available": bool(rl),
   476	        "cost": cost,
   477	    }
   478	
   479	
   480	def snapshot_digest(snapshot: Dict[str, Any]) -> str:
   481	    """Material digest — excludes captured_at/cost so a pure clock tick never re-emits."""
   482	    material = {k: snapshot.get(k) for k in
   483	                ("plan_id", "worktree", "rate_limits", "model_id", "session_id")}
   484	    pct = snapshot.get("context_pct")
   485	    material["context_decile"] = (int(pct // 10)
   486	                                  if isinstance(pct, (int, float)) and not isinstance(pct, bool)
   487	                                  else None)
   488	    return hashlib.sha256(
   489	        json.dumps(material, sort_keys=True, default=str).encode("utf-8")).hexdigest()
   490	
   491	
   492	def write_sidecar_atomic(path: Path, snapshot: Dict[str, Any]) -> bool:
   493	    tmp = path.with_name(path.name + ".tmp.%d" % os.getpid())
   494	    try:
   495	        path.parent.mkdir(parents=True, exist_ok=True)
   496	        with open(tmp, "w", encoding="utf-8") as fh:
   497	            json.dump(snapshot, fh, sort_keys=True)
   498	            fh.write("\n")
   499	        os.replace(tmp, path)
   500	        return True
   501	    except OSError:
   502	        try:
   503	            if tmp.exists():  # best-effort tmp cleanup
   504	                tmp.unlink()
   505	        except OSError:
   506	            pass
   507	        return False
   508	
   509	
   510	# ---------------------------------------------------------------------------
   511	# Debounced closed-enum emit (fail-soft; heavy import only inside the branch)
   512	# ---------------------------------------------------------------------------
   513	
   514	
   515	def _emit_interval_s() -> int:
   516	    try:
   517	        return max(0, int(os.environ.get("CEO_STATUSLINE_EMIT_INTERVAL_S",
   518	                                         str(_DEFAULT_EMIT_INTERVAL_S))))
   519	    except ValueError:
   520	        return _DEFAULT_EMIT_INTERVAL_S
   521	
   522	
   523	def should_emit(marker_path: Path, digest: str, now_epoch: float,
   524	                interval_s: int) -> bool:
   525	    """True when the material digest changed AND the debounce floor elapsed."""
   526	    try:
   527	        with open(marker_path, "r", encoding="utf-8") as fh:
   528	            mark = json.load(fh)
   529	        last_digest = mark.get("digest")
   530	        last_ts = float(mark.get("emitted_at", 0))
   531	    except (OSError, ValueError, TypeError):
   532	        return True  # no/corrupt marker → first emit
   533	    if digest == last_digest:
   534	        return False
   535	    return (now_epoch - last_ts) >= interval_s
   536	
   537	
   538	def _write_marker(marker_path: Path, digest: str, now_epoch: float) -> None:
   539	    try:
   540	        tmp = marker_path.with_name(marker_path.name + ".tmp.%d" % os.getpid())
   541	        with open(tmp, "w", encoding="utf-8") as fh:
   542	            json.dump({"digest": digest, "emitted_at": now_epoch}, fh)
   543	        os.replace(tmp, marker_path)
   544	    except OSError:
   545	        pass
   546	
   547	
   548	def _pct_to_bps(pct: Optional[float], cap_bps: int = 10000) -> Optional[int]:
   549	    """Percentage (0..N) -> integer basis-points (0..cap_bps) for the
   550	    HMAC-covered statusline AUDIT breadcrumb only. None passes through.
   551	    PLAN-135-FOLLOWUP-2 (S234): the canonical encoder forbids float in a
   552	    signed payload (S181); the prior float form was written with hmac=null on
   553	    every emit since v2.44. context_pct is 0..100% (cap 10000);
   554	    buckets_used_pct_max is capped at 999% upstream (cap 99900 — no 100%
   555	    ceiling, so an over-quota burst is preserved, not floored). This does NOT
   556	    touch context_pct() or the on-disk sidecar JSON, which stay float."""
   557	    if pct is None:
   558	        return None
   559	    try:
   560	        return max(0, min(cap_bps, int(round(float(pct) * 100))))
   561	    except (TypeError, ValueError, OverflowError):
   562	        return None
   563	
   564	
   565	def maybe_emit(sidecar: Path, snapshot: Dict[str, Any]) -> None:
   566	    if os.environ.get("CEO_STATUSLINE_EMIT", "1").strip().lower() in ("0", "false", "no", "off"):
   567	        return
   568	    digest = snapshot_digest(snapshot)
   569	    marker = sidecar.with_name(sidecar.name + ".emit-state.json")
   570	    now_epoch = time.time()
   571	    if not should_emit(marker, digest, now_epoch, _emit_interval_s()):
   572	        return
   573	    _write_marker(marker, digest, now_epoch)  # marker first — a crashed emit must not retry-flood
   574	    try:
   575	        hooks_dir = None
   576	        pd = snapshot.get("project_dir")
   577	        if pd and (Path(pd) / ".claude" / "hooks" / "_lib").is_dir():
   578	            hooks_dir = Path(pd) / ".claude" / "hooks"
   579	        else:
   580	            cand = Path(__file__).resolve().parents[1] / "hooks"
   581	            if (cand / "_lib").is_dir():
   582	                hooks_dir = cand
   583	        if hooks_dir is None:
   584	            return
   585	        if str(hooks_dir) not in sys.path:
   586	            sys.path.insert(0, str(hooks_dir))
   587	        from _lib import audit_emit  # noqa: E402  (deferred heavy import)
   588	        rl = snapshot.get("rate_limits") or {}
   589	        pcts = [b.get("used_pct") for b in rl.values() if b.get("used_pct") is not None]
   590	        audit_emit.emit_generic(
   591	            _EMIT_ACTION,
   592	            sidecar_path=str(sidecar),
   593	            plan_id=snapshot.get("plan_id"),
   594	            # PLAN-135-FOLLOWUP-2: percentages are HMAC-covered -> integer
   595	            # basis-points (pct * 100), never float (S181). Different caps:
   596	            # context 0..100% (10000); buckets up to 999% (99900).
   597	            context_pct_bps=_pct_to_bps(snapshot.get("context_pct")),
   598	            bucket_count=len(rl),
   599	            buckets_used_pct_max_bps=_pct_to_bps(
   600	                max(pcts) if pcts else None, cap_bps=99900
   601	            ),
   602	            session_id=snapshot.get("session_id") or "",
   603	            digest=digest[:12],
   604	        )
   605	    except Exception:
   606	        # Fail-soft: observability must never break the status line.
   607	        pass
   608	
   609	
   610	# ---------------------------------------------------------------------------
   611	# Main
   612	# ---------------------------------------------------------------------------
   613	
   614	
   615	def main() -> int:
   616	    try:
   617	        data = _read_stdin_json()
   618	        if data is None:
   619	            print("ceo | (no statusline payload)")
   620	            return 0
   621	        snapshot = build_snapshot(data)
   622	        print(render_line(snapshot))
   623	        if os.environ.get("CEO_STATUSLINE_DISABLE", "").strip().lower() in ("1", "true", "yes", "on"):
   624	            return 0
   625	        sidecar = _sidecar_path()
   626	        if os.environ.get("CEO_STATUSLINE_DEBUG", "").strip().lower() in ("1", "true", "yes", "on"):
   627	            write_sidecar_atomic(sidecar.with_name(sidecar.name + ".debug.json"), data)
   628	        if write_sidecar_atomic(sidecar, snapshot):
   629	            maybe_emit(sidecar, snapshot)
   630	        return 0
   631	    except Exception:
   632	        # Last-ditch fail-soft: still render SOMETHING, always exit 0.
   633	        try:
   634	            print("ceo")
   635	        except Exception:
   636	            pass
   637	        return 0
   638	
   639	
   640	if __name__ == "__main__":
   641	    sys.exit(main())

