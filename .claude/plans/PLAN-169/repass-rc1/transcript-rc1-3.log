   393	# before anything parses it. Refusing the WHOLE manifest is the only honest
   394	# answer: a NUL means the file is not the text this uninstaller can read, and
   395	# picking the survivors would be deciding which truncation to trust.
   396	if ! LC_ALL=C tr -d '\000' < "$MANIFEST" | cmp -s - "$MANIFEST"; then
   397	  _log "    REFUSED: the manifest contains NUL byte(s) — this uninstaller"
   398	  _log "             cannot read it, and `read` would silently truncate the"
   399	  _log "             affected record(s) into shapes that look valid."
   400	  _log "             NOTHING was removed; the manifest is left as it stands."
   401	  exit 6
   402	fi
   403	
   404	# --- rc.1 re-pass round 3, part 3: ONE grammar, parsed ONCE ----------------
   405	# Backup construction and the removal walk used DIFFERENT grammars: the walk
   406	# accepted one OR two spaces after the digest (`  ?`), while the backup list
   407	# only matched records containing two consecutive spaces. A one-space record
   408	# was therefore deleted but never archived — the recovery tarball silently
   409	# missing exactly what the run removed. The canonical grammar is EXACTLY two
   410	# spaces (what the writer emits); it is applied once, here, into a sanitized
   411	# ledger that both the backup and the walk read. No second parser can drift
   412	# from this one because there is no second parser.
   413	_LEDGER="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger)"
   414	unsafe_count=0
   415	valid_count=0
   416	while IFS= read -r line || [ -n "$line" ]; do
   417	  case "$line" in '#'*|'') continue ;; esac
   418	  if printf '%s' "$line" | LC_ALL=C grep -q '[[:cntrl:]]'; then
   419	    unsafe_count=$((unsafe_count + 1))
   420	    _log "    REFUSED (manifest record carries control bytes — not touched)"
   421	    continue
   422	  fi
   423	  case "$line" in
   424	    LINK\ *)
   425	      # `LINK <relpath> <target>` is what a --link install records; this
   426	      # uninstaller handles copy-mode records only (rc.1 condition): the
   427	      # link stays, the refusal is named and counted.
   428	      unsafe_count=$((unsafe_count + 1))
   429	      _log "    REFUSED (LINK record — copy-mode uninstaller; the link is left in place): ${line#LINK }"
   430	      continue ;;
   431	  esac
   432	  if ! printf '%s' "$line" | LC_ALL=C grep -qE '^[0-9a-f]{64}  [^ ]'; then
   433	    unsafe_count=$((unsafe_count + 1))
   434	    _log "    REFUSED (malformed manifest record — not touched): $line"
   435	    continue
   436	  fi
   437	  _rel="${line#*  }"
   438	  if _rel_unsafe "$_rel"; then
   439	    unsafe_count=$((unsafe_count + 1))
   440	    _log "    REFUSED (unsafe manifest path — not touched): $_rel"
   441	    continue
   442	  fi
   443	  if _rel_ancestor_link "$_rel"; then
   444	    unsafe_count=$((unsafe_count + 1))
   445	    _log "    REFUSED (symlinked ancestor — a removal would follow it outside the target): $_rel"
   446	    continue
   447	  fi
   448	  valid_count=$((valid_count + 1))
   449	  printf '%s\t%s\n' "${line%%  *}" "$_rel" >> "$_LEDGER"
   450	done < "$MANIFEST"
   451	
   452	# rc.1 re-pass round 9, part 3: relpath UNIQUENESS across the whole ledger.
   453	# Each record was validated on its own, so a relpath recorded TWICE produced
   454	# two ledger rows and the walk below acts per row: `<old-sha>  docs/x` followed
   455	# by `<current-sha>  docs/x` PRESERVED the adopter's modified file on the first
   456	# row and REMOVED it on the second — without --force, exit 5 only afterwards.
   457	# Ambiguous provenance is refused WHOLE (every occurrence, as doctor.sh does):
   458	# nothing under a duplicated relpath is archived or removed.
   459	_dup_rels="$( cut -f2- "$_LEDGER" | LC_ALL=C sort | LC_ALL=C uniq -d )"
   460	if [ -n "$_dup_rels" ]; then
   461	  _LEDGER_UNIQ="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger-uniq)"
   462	  while IFS="$( printf '\t' )" read -r _lsha _lrel || [ -n "$_lrel" ]; do
   463	    [ -n "$_lrel" ] || continue
   464	    if printf '%s\n' "$_dup_rels" | LC_ALL=C grep -qxF -- "$_lrel"; then
   465	      unsafe_count=$((unsafe_count + 1))
   466	      valid_count=$((valid_count - 1))
   467	      _log "    REFUSED (relpath recorded more than once — ambiguous provenance, not touched): $_lrel"
   468	      continue
   469	    fi
   470	    printf '%s\t%s\n' "$_lsha" "$_lrel" >> "$_LEDGER_UNIQ"
   471	  done < "$_LEDGER"
   472	  mv -f "$_LEDGER_UNIQ" "$_LEDGER"
   473	fi
   474	
   475	# rc.1 re-pass round 10 (refuter): uniqueness by STRING cannot see every alias
   476	# of one inode — an empty segment (`docs//x`), case folding on a
   477	# case-insensitive filesystem (`docs/X`), Unicode normalisation on APFS, or a
   478	# hard link between two recorded paths. Enumerating spellings does not
   479	# converge; IDENTITY does: every ledger relpath that exists is lstat()ed
   480	# (the leaf is never followed) and EVERY relpath whose (st_dev, st_ino)
   481	# appears under more than one spelling is refused before backup and removal.
   482	# The grammar above already refused control bytes, whitespace and glob
   483	# characters, so the relpaths round-trip through python3 byte-exact.
   484	_alias_rels="$(python3 - "$TARGET" "$_LEDGER" <<'PY'
   485	import os, sys
   486	target, ledger = sys.argv[1], sys.argv[2]
   487	seen = {}
   488	with open(ledger, 'r', encoding='utf-8') as fh:
   489	    for line in fh:
   490	        line = line.rstrip('\n')
   491	        if '\t' not in line:
   492	            continue
   493	        rel = line.split('\t', 1)[1]
   494	        try:
   495	            st = os.lstat(os.path.join(target, rel))
   496	        except OSError:
   497	            continue
   498	        seen.setdefault((st.st_dev, st.st_ino), set()).add(rel)
   499	for rels in seen.values():
   500	    if len(rels) > 1:
   501	        for rel in sorted(rels):
   502	            sys.stdout.write(rel + '\n')
   503	PY
   504	)"
   505	if [ -n "$_alias_rels" ]; then
   506	  _LEDGER_IDENT="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-ledger-ident)"
   507	  while IFS="$( printf '\t' )" read -r _lsha _lrel || [ -n "$_lrel" ]; do
   508	    [ -n "$_lrel" ] || continue
   509	    if printf '%s\n' "$_alias_rels" | LC_ALL=C grep -qxF -- "$_lrel"; then
   510	      unsafe_count=$((unsafe_count + 1))
   511	      valid_count=$((valid_count - 1))
   512	      _log "    REFUSED (relpath is an alias of another recorded path — same inode, ambiguous provenance, not touched): $_lrel"
   513	      continue
   514	    fi
   515	    printf '%s\t%s\n' "$_lsha" "$_lrel" >> "$_LEDGER_IDENT"
   516	  done < "$_LEDGER"
   517	  mv -f "$_LEDGER_IDENT" "$_LEDGER"
   518	fi
   519	
   520	# Pre-uninstall backup (unless --no-backup)
   521	if [ "$NO_BACKUP" -eq 0 ]; then
   522	  if ! _dry "would BACKUP .claude/ before uninstall"; then
   523	    timestamp="$(date -u +%Y%m%d-%H%M%SZ)"
   524	    backup="$TARGET/.claude.backup-uninstall-$timestamp.tar.gz"
   525	    _log "==> Pre-uninstall backup: $backup"
   526	    # PLAN-183 §9.8 (S337): the manifest records deliveries OUTSIDE .claude/
   527	    # (docs/, .github/ since W5; SPEC/, PROTOCOL.md, the marker) and the walk
   528	    # below removes them, so the backup must cover them too — a tarball of
   529	    # .claude/ alone could not restore what this run deletes. The list comes
   530	    # from the manifest itself, regular files only, nothing outside it.
   531	    backup_list="$(mktemp 2>/dev/null || mktemp -t ceo-uninstall-list)"
   532	    printf '.claude\n' > "$backup_list"
   533	    # rc.1 re-pass round 3, part 3 — from the SANITIZED LEDGER, which is the
   534	    # same set of records the removal walk below acts on. The path checks that
   535	    # used to be repeated here now live in the single parse; what is left is
   536	    # the archive-specific question of whether the file exists as a regular
   537	    # file right now (`-f` and `tar` follow links, `! -L` tests the leaf).
   538	    cut -f2- "$_LEDGER" 2>/dev/null \
   539	      | while IFS= read -r _brel; do
   540	          case "$_brel" in .claude/*) continue ;; esac
   541	          [ -f "$TARGET/$_brel" ] && [ ! -L "$TARGET/$_brel" ] && printf '%s\n' "$_brel"
   542	        done >> "$backup_list"
   543	    # NO --no-recursion: the list carries `.claude` as a DIRECTORY entry whose
   544	    # contents must be archived (its files are excluded from the list by
   545	    # design). Adding it emptied every backup of .claude/* — caught by e2e U.3
   546	    # and by the pair rail in the same round (r3 defect, cured r4).
   547	    ( cd "$TARGET" && tar czf "$backup" -T "$backup_list" 2>/dev/null )
   548	    rm -f "$backup_list"
   549	    key_path="$(_resolve_backup_key || true)"
   550	    if [ -n "$key_path" ] && [ -f "$key_path" ]; then
   551	      backup_hmac="$(python3 -c "
   552	import hashlib, hmac, sys
   553	key = open('$key_path', 'rb').read()
   554	tar_sha = hashlib.sha256(open('$backup', 'rb').read()).digest()
   555	sys.stdout.write(hmac.new(key, tar_sha, hashlib.sha256).hexdigest())
   556	")"
   557	      printf '%s  %s\n' "$backup_hmac" "$backup" > "$backup.hmac"
   558	      chmod 0600 "$backup.hmac"
   559	    fi
   560	  fi
   561	fi
   562	
   563	# Walk the SANITIZED LEDGER; for each entry, verify SHA before delete.
   564	mismatch_count=0
   565	removed_count=0
   566	preserved_count=0
   567	absent_count=0
   568	mismatch_files=""
   569	
   570	# rc.1 re-pass (round 2, part 3): the parse is TOTAL. `read` alone drops an
   571	# unterminated final record (a manifest whose trailing newline was lost never
   572	# processed its last delivery); a record that matched no shape was skipped in
   573	# silence — so an empty, comment-only or malformed manifest left every counter
   574	# at zero, the ledger was DELETED below and the run exited 0 with framework
   575	# files still on disk.
   576	#
   577	# rc.1 re-pass (round 3, part 3): that parse now happens ONCE, above, into
   578	# `$_LEDGER` — the same records the backup archived. What is left here is the
   579	# filesystem question, and it used to fail OPEN on every answer but "regular
   580	# file": a directory or a FIFO at a managed path fell through `continue`
   581	# without touching a counter, so the run could remove the ownership manifest
   582	# and exit 0 with the managed path still there; a dangling symlink counted as
   583	# ABSENT; and a symlink leaf pointing at an external regular file passed `-f`
   584	# and was read THROUGH by the hasher. Every one of those is now REFUSED and
   585	# counted, which keeps the manifest and exits 6.
   586	while IFS="$( printf '\t' )" read -r recorded_sha rel || [ -n "$rel" ]; do
   587	  [ -n "$rel" ] || continue
   588	  fpath="$TARGET/$rel"
   589	
   590	  # BEFORE -e, because -e is FALSE for a dangling link and the link would
   591	  # otherwise be filed as "absent" and left behind. A link is never followed:
   592	  # not to test it, not to hash it, not to remove it.
   593	  if [ -L "$fpath" ]; then
   594	    unsafe_count=$((unsafe_count + 1))
   595	    _log "    REFUSED (manifest path is a symlink — never followed, never removed): $rel"
   596	    continue
   597	  fi
   598	
   599	  if [ ! -e "$fpath" ]; then
   600	    absent_count=$((absent_count + 1))
   601	    continue
   602	  fi
   603	
   604	  if [ ! -f "$fpath" ]; then
   605	    unsafe_count=$((unsafe_count + 1))
   606	    _log "    REFUSED (manifest path exists but is not a regular file — not touched): $rel"
   607	    continue
   608	  fi
   609	
   610	  actual_sha="$(python3 -c "
   611	import hashlib, sys
   612	with open(sys.argv[1], 'rb') as f:
   613	    sys.stdout.write(hashlib.sha256(f.read()).hexdigest())
   614	" "$fpath")"
   615	
   616	  if [ "$actual_sha" = "$recorded_sha" ]; then
   617	    if _dry "would REMOVE $rel"; then
   618	      removed_count=$((removed_count + 1))
   619	    else
   620	      rm -f "$fpath"
   621	      removed_count=$((removed_count + 1))
   622	    fi
   623	    _track_tree "$rel"   # PLAN-183 §9.8: remember the tree for the emptied-directory sweep
   624	  else
   625	    mismatch_count=$((mismatch_count + 1))
   626	    mismatch_files="$mismatch_files $rel"
   627	    if [ "$FORCE" -eq 1 ]; then
   628	      if _dry "would FORCE-REMOVE (sha mismatch) $rel"; then
   629	        removed_count=$((removed_count + 1))
   630	      else
   631	        rm -f "$fpath"
   632	        removed_count=$((removed_count + 1))
   633	      fi
   634	      _track_tree "$rel"   # rail r1 (S337): forced removals empty trees too
   635	    else
   636	      preserved_count=$((preserved_count + 1))
   637	      _log "    PRESERVED (sha mismatch, user-modified): $rel"
   638	    fi
   639	  fi
   640	done < "$_LEDGER"
   641	rm -f "$_LEDGER"
   642	
   643	# No valid record at all (empty, comment-only or wholly malformed manifest) is
   644	# not "everything matched": it is an unreadable ledger, and deleting it would
   645	# erase the only evidence of what was installed.
   646	if [ "$valid_count" -eq 0 ]; then
   647	  unsafe_count=$((unsafe_count + 1))
   648	  _log "    REFUSED (manifest has no valid record — empty, comment-only or malformed; kept for inspection)"
   649	fi
   650	
   651	# Refuse if mismatches were encountered without --force, or if ANY record was
   652	# refused. rail r5 (S337) P2: --force overrides a sha MISMATCH, never a REFUSAL
   653	# (the manifest block below already says so), so a --force run that refused a
   654	# record is still an INCOMPLETE uninstall. Before this cure the `&& FORCE -eq 0`
   655	# applied to the refusal too: such a run fell through to the "everything
   656	# matched" summary below — a complete-looking report contradicted by its own
   657	# `Refused:` and `Manifest: KEPT` lines.
   658	if [ "$unsafe_count" -gt 0 ] || { [ "$mismatch_count" -gt 0 ] && [ "$FORCE" -eq 0 ]; }; then
   659	  _sweep_emptied_trees   # rail r1 (S337): the partial path empties trees too
   660	  _log ""
   661	  _log "==> Uninstall summary (incomplete):"
   662	  _log "    Removed:   $removed_count"
   663	  _log "    Preserved: $preserved_count (user-modified — sha didn't match manifest)"
   664	  _log "    Absent:    $absent_count (already gone)"
   665	  _log "    Refused:   $unsafe_count (unsafe manifest path, symlinked ancestor or relpath recorded more than once — not touched)"
   666	  _log ""
   667	  # The --force hint is only true for a sha mismatch met WITHOUT --force; a
   668	  # refusal is never lifted by --force, so say that instead of suggesting it.
   669	  if [ "$mismatch_count" -gt 0 ] && [ "$FORCE" -eq 0 ]; then
   670	    _log "    To force-remove user-modified files: re-run with --force"
   671	  fi
   672	  if [ "$unsafe_count" -gt 0 ]; then
   673	    _log "    Refused records are never removed, with or without --force: fix the manifest path or the symlinked ancestor, then re-run."
   674	  fi
   675	  _log "    Preserved files were NOT touched."
   676	  # An INCOMPLETE uninstall is never a success (rc.1 re-pass, part 3 U2):
   677	  # automation that reads only $? must not record a refused or preserved
   678	  # run as done. The dry-run stays 0 — it is a preview (header). Refusal
   679	  # outranks mismatch: a refused record is never lifted by --force.
   680	  if [ "$DRY_RUN" -eq 1 ]; then exit 0; fi
   681	  if [ "$unsafe_count" -gt 0 ]; then exit 6; fi
   682	  exit 5
   683	fi
   684	
   685	# Clean up manifest + empty .claude/ subdirs (only if everything matched)
   686	if ! _dry "would REMOVE manifest $MANIFEST"; then
   687	  # rail r3 (S337) P1: a refused record (unsafe path / symlinked ancestor) means
   688	  # the install was not fully removed — keep the manifest for a --force retry.
   689	  # rail r4 (S337) P2: --force overrides a sha MISMATCH, never a REFUSAL —
   690	  # a refused record was not removed by any run, so the ledger must survive.
   691	  if [ "$unsafe_count" -eq 0 ] && { [ "$mismatch_count" -eq 0 ] || [ "$FORCE" -eq 1 ]; }; then
   692	    rm -f "$MANIFEST"
   693	  fi
   694	fi
   695	
   696	# Clean up empty directories under .claude/ (post-removal sweep)
   697	if [ "$DRY_RUN" -eq 0 ] && [ -d "$TARGET/.claude" ]; then
   698	  find "$TARGET/.claude" -depth -type d -empty -delete 2>/dev/null || true
   699	fi
   700	
   701	# PLAN-183 §9.8 (S337): the same sweep for every other top-level tree this run
   702	# removed deliveries from (docs/, .github/, SPEC/ …). Measured before the cure:
   703	# a pristine uninstall left docs/, .github/workflows/ and SPEC/v1 behind, empty.
   704	_sweep_emptied_trees
   705	
   706	_log ""
   707	_log "==> Uninstall summary:"
   708	_log "    Removed:   $removed_count"
   709	_log "    Preserved: $preserved_count"
   710	_log "    Absent:    $absent_count"
   711	_log "    Refused:   $unsafe_count (unsafe manifest path, symlinked ancestor or relpath recorded more than once — not touched)"
   712	_log "    Manifest:  $([ -f "$MANIFEST" ] && echo "KEPT" || echo "REMOVED")"
   713	exit 0
   430	"; }
   431	_mark_invalid() {
   432	  case "$_INVALID" in
   433	    *"
   434	$1
   435	"*) : ;;
   436	    *) _INVALID="${_INVALID}${1}
   437	" ;;
   438	  esac
   439	}
   440	
   441	# PLAN-185-FOLLOWUP FU-7 (S340, rail r4 P1): `read -r` DROPS or truncates at a
   442	# NUL byte before any per-field check can see it, so a record carrying 0x00 is
   443	# not sanitizable line by line — it is unparseable security input and fails
   444	# CLOSED here, on the RAW bytes, before the line loop (same exit class as an
   445	# empty/corrupted manifest). Counted with tr on the raw file: locale-independent.
   446	_nul_count="$( LC_ALL=C tr -cd '\000' < "$MANIFEST" | wc -c | tr -d ' ' )"
   447	if [ "${_nul_count:-0}" -gt 0 ]; then
   448	  echo "ERROR: manifest at $MANIFEST carries $_nul_count NUL byte(s) — unparseable (corrupted or tampered); refusing to verify." >&2
   449	  echo "       Run upgrade.sh to regenerate the baseline." >&2
   450	  exit 2
   451	fi
   452	
   453	# Pin the manifest identity (device:inode by lstat — `stat` without -L; the GNU
   454	# spelling is tried first because `stat -f` is a DIFFERENT command on GNU and
   455	# would succeed with filesystem numbers) so every write below re-proves it is
   456	# the SAME regular file the sanitizer read: a leaf swapped for a link or for
   457	# another file mid-run is refused before the write, never followed.
   458	_manifest_identity() { stat -c '%d:%i' "$1" 2>/dev/null || stat -f '%d:%i' "$1" 2>/dev/null; }
   459	_MANIFEST_ID="$( _manifest_identity "$MANIFEST" )"
   460	if [ -z "$_MANIFEST_ID" ]; then
   461	  echo "ERROR: cannot establish the identity of $MANIFEST (stat failed); refusing to verify." >&2
   462	  exit 2
   463	fi
   464	# rc 0 only while the manifest is still that non-symlink regular file.
   465	_manifest_still_pinned() {
   466	  [ ! -L "$MANIFEST" ] && [ -f "$MANIFEST" ] \
   467	    && [ "$( _manifest_identity "$MANIFEST" )" = "$_MANIFEST_ID" ]
   468	}
   469	# One refusal for every write site (restore, backup+restore, re-link); the
   470	# caller counts the finding as unresolved exactly as it does for a refused
   471	# destination.
   472	_manifest_pin_refused() {
   473	  _log "    REFUSED: the install manifest changed identity or became a SYMLINK during this run — nothing written: $1"
   474	  REFUSED_COUNT=$((REFUSED_COUNT + 1))
   475	}
   476	
   477	while IFS= read -r line || [ -n "$line" ]; do
   478	  [ -n "$line" ] || continue
   479	  case "$line" in
   480	    '#'*) continue ;;
   481	    LINK\ \ *)
   482	      rest="${line#LINK  }"
   483	      case "$rest" in
   484	        *"  "*)
   485	          rel="${rest%%  *}"
   486	          target="${rest#*  }"
   487	          ;;
   488	        *) _mark_dropped "malformed LINK record (no target)" "$rest"; continue ;;
   489	      esac
   490	      if [ -z "$target" ] || _field_has_control_bytes "$target"; then
   491	        _mark_dropped "LINK target empty or carrying a control byte" "$rel"; continue
   492	      fi
   493	      if _relpath_unsafe "$rel" link; then
   494	        _mark_dropped "unsafe manifest path (traversal, absolute, control character, or symlinked ancestor)" "$rel"
   495	        continue
   496	      fi
   497	      if _seen_before "$rel"; then
   498	        _mark_invalid "$rel"
   499	        _mark_dropped "duplicate relpath (ambiguous — every record for it is dropped)" "$rel"
   500	        continue
   501	      fi
   502	      _mark_seen "$rel"
   503	      printf 'LINK  %s  %s\n' "$rel" "$target" >> "$SANITIZED"
   504	      ;;
   505	    *)
   506	      digest="${line%%  *}"
   507	      rel="${line#*  }"
   508	      if [ "$digest" = "$line" ]; then
   509	        _mark_dropped "malformed record (no two-space separator)" "$line"
   510	        continue
   511	      fi
   512	      case "$digest" in
   513	        *[!0-9a-f]*) _mark_dropped "malformed record (digest is not hexadecimal)" "$rel"; continue ;;
   514	      esac
   515	      if [ "${#digest}" -ne 64 ]; then
   516	        _mark_dropped "malformed record (digest is not 64 characters)" "$rel"
   517	        continue
   518	      fi
   519	      if _relpath_unsafe "$rel" file; then
   520	        _mark_dropped "unsafe manifest path (traversal, absolute, control character, or symlinked ancestor)" "$rel"
   521	        continue
   522	      fi
   523	      if _seen_before "$rel"; then
   524	        _mark_invalid "$rel"
   525	        _mark_dropped "duplicate relpath (ambiguous — every record for it is dropped)" "$rel"
   526	        continue
   527	      fi
   528	      _mark_seen "$rel"
   529	      printf '%s  %s\n' "$digest" "$rel" >> "$SANITIZED"
   530	      ;;
   531	  esac
   532	done < "$MANIFEST"
   533	
   534	# Second pass: drop records for relpaths flagged ambiguous (dup) — they were
   535	# emitted on first sight before the dup was discovered.
   536	if [ "$_INVALID" != "
   537	" ]; then
   538	  : > "$SANITIZED.f"
   539	  while IFS= read -r line || [ -n "$line" ]; do
   540	    case "$line" in
   541	      LINK\ \ *) rel_probe="${line#LINK  }"; rel_probe="${rel_probe%%  *}" ;;
   542	      *)         rel_probe="${line#*  }" ;;
   543	    esac
   544	    case "$_INVALID" in
   545	      *"
   546	$rel_probe
   547	"*) _mark_dropped "duplicate relpath (this earlier record is dropped too)" "$rel_probe"; continue ;;
   548	    esac
   549	    printf '%s\n' "$line" >> "$SANITIZED.f"
   550	  done < "$SANITIZED"
   551	  mv "$SANITIZED.f" "$SANITIZED"
   552	fi
   553	
