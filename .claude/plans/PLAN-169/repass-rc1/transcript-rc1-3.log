   571	# ---------------------------------------------------------------------------
   572	# Repair helpers
   573	# ---------------------------------------------------------------------------
   574	BAK_DIR=""       # created lazily on the first backup
   575	BAK_REL_DIR=""   # its relpath under $TARGET — the confinement predicate walks relpaths
   576	_ensure_bak_rel() {
   577	  if [ -z "$BAK_REL_DIR" ]; then
   578	    BAK_REL_DIR=".claude.bak/doctor-$(date -u +%Y%m%d-%H%M%SZ)"
   579	  fi
   580	}
   581	_ensure_bak_dir() {
   582	  _ensure_bak_rel
   583	  if [ -z "$BAK_DIR" ]; then
   584	    BAK_DIR="$TARGET/$BAK_REL_DIR"
   585	    mkdir -p "$BAK_DIR"
   586	  fi
   587	}
   588	
   589	_backup_file() {
   590	  # $1 = relpath of an existing regular file to preserve before overwrite.
   591	  # Returns 0 when the backup landed, 1 when it was REFUSED (nothing written):
   592	  # a caller must never overwrite a file whose backup could not be made.
   593	  _bf_rel="$1"
   594	  # PLAN-185-FOLLOWUP FU-7 (S337): the backup destination is a write under the
   595	  # target too, and nothing sanitised it at ingest — `.claude.bak` is not a
   596	  # manifest record. A symlink planted there sends the ADOPTER'S OWN bytes
   597	  # outside the target through `mkdir -p` + `cp -p` (e2e D.2 reproduces it
   598	  # against the pre-cure copy). Same shared predicate as every other write,
   599	  # asked about the relpath that will be written, BEFORE _ensure_bak_dir's own
   600	  # mkdir: the timestamped directory does not exist yet, so the walk covers
   601	  # `.claude.bak` and the nearest existing ancestor.
   602	  _ensure_bak_rel
   603	  if _wbm_dst_refuses "$TARGET" "$BAK_REL_DIR/$_bf_rel"; then
   604	    REFUSED_COUNT=$((REFUSED_COUNT + 1))
   605	    _log "    BACKUP-BLOCKED (destination refused — nothing written: ${_WBM_DST_REFUSE_WHY:-unknown reason}): $_bf_rel"
   606	    return 1
   607	  fi
   608	  _ensure_bak_dir
   609	  mkdir -p "$BAK_DIR/$( dirname "$_bf_rel" )"
   610	  cp -p "$TARGET/$_bf_rel" "$BAK_DIR/$_bf_rel"
   611	}
   612	
   613	# PLAN-185-FOLLOWUP FU-7 (S337): confinement for LINK-record repairs. A LINK
   614	# record's LEAF is legitimately a symlink (that is what the record describes),
   615	# so when the leaf is present and about to be replaced, the shared predicate is
   616	# asked about the PARENT the link is created in — a symlinked or escaping
   617	# ancestor is the write-through hazard; the leaf itself is replaced (`rm -f`
   618	# never follows a link), not written through. When the leaf is absent, the full
   619	# relpath is asked, exactly as for a regular file. $1 = link relpath.
   620	# Returns 0 to REFUSE (the polarity of _restore_refuses).
   621	_link_dst_refuses() {
   622	  _ld_rel="$1"
   623	  # rail r1 (S337) P1: the shared predicate refuses a SYMLINKED target root for
   624	  # every relpath it is asked about, and doctor resolves $TARGET logically
   625	  # (`cd && pwd`, symlink preserved) — so a root-level link whose parent IS the
   626	  # root must not skip that clause. Same test, same message, same recovery.
   627	  if [ -L "$TARGET" ]; then
   628	    REFUSED_COUNT=$((REFUSED_COUNT + 1))
   629	    _ld_ref="$( cd -P "$TARGET" 2>/dev/null && pwd -P || true )"
   630	    _log "    RESTORE-BLOCKED (link destination refused — nothing written: the target root '$TARGET' is a SYMLINK${_ld_ref:+ to '$_ld_ref'} — every write would follow it; re-run against the referent): $_ld_rel"
   631	    return 0
   632	  fi
   633	  _ld_ask="$_ld_rel"
   634	  if [ -e "$TARGET/$_ld_rel" ] || [ -L "$TARGET/$_ld_rel" ]; then
   635	    _ld_ask="$( dirname "$_ld_rel" )"
   636	    case "$_ld_ask" in
   637	      .|"") return 1 ;;   # root-level link: the (non-symlink) target root is the parent
   638	    esac
   639	  fi
   640	  if _wbm_dst_refuses "$TARGET" "$_ld_ask"; then
   641	    REFUSED_COUNT=$((REFUSED_COUNT + 1))
   642	    _log "    RESTORE-BLOCKED (link destination refused — nothing written: ${_WBM_DST_REFUSE_WHY:-unknown reason}): $_ld_rel"
   643	    return 0
   644	  fi
   645	  return 1
   646	}
   647	
   648	# Per-file confirmation: --yes-file match, else interactive [y/N] on a TTY,
   649	# else refuse (0 = confirmed, 1 = not confirmed).
   650	_confirmed() {
   651	  _cf_rel="$1"
   652	  case "$YES_FILES" in
   653	    *"
   654	$_cf_rel
   655	"*) return 0 ;;
   656	  esac
   657	  if [ -t 0 ] && [ -r /dev/tty ]; then
   658	    printf '    restore %s (overwrites your modified copy; backup taken)? [y/N] ' "$_cf_rel"
   659	    _cf_ans=""
   660	    read -r _cf_ans < /dev/tty || _cf_ans=""
   661	    case "$_cf_ans" in
   662	      y|Y|yes|YES) return 0 ;;
   663	    esac
   664	  fi
   665	  return 1
   666	}
   667	
   668	# ---------------------------------------------------------------------------
   669	# Delivery-route resolution (PLAN-183 W5 defect D4; consolidated in W6)
   670	# ---------------------------------------------------------------------------
   671	# Truth: scripts/delivery-routes.tsv. READER: _wbm_route_src, in
   672	# scripts/_framework_manifest_set.sh, sourced above — the SAME reader install.sh,
   673	# upgrade.sh and scripts/tests/_parity_classify.py resolve through. doctor is the
   674	# fourth consumer, and until W6 it was the odd one out: it carried a PRIVATE copy
   675	# of the parser.
   676	#
   677	# What the copy cost, MEASURED (pair-rail round 1, finding F2 — S327): the
   678	# canonical reader had grown path validation the copy never received, so a route
   679	# table with an absolute or `..`-bearing `src` resolved rc=0 here and reached
   680	# `cp "$SOURCE_DIR/$src"` in _restore_file — a read from OUTSIDE the framework
   681	# checkout, delivered into an adopter tree as framework content. The second
   682	# implementation was the defect, not a convenience: it is the same class
   683	# CLAUDE.md §4 records closing twice already (PLAN-182, 16 modules -> one
   684	# resolver; PLAN-167, _ownership_verdict).
   685	#
   686	# The contract the three call sites below depend on is the canonical one, and it
   687	# is byte-for-byte the contract doctor's retired copy published:
   688	#   stdout = source relpath, exit 0 : identity route — hashable and copyable
   689	#   exit 1                          : no route declared — identity applies
   690	#   exit 2                          : RENDERED, malformed, or a REJECTED
   691	#                                     (hostile) row — the delivered bytes exist
   692	#                                     in NO checkout; nothing to hash, nothing
   693	#                                     to copy.
   694	# rc=2 must never collapse into rc=1: rc=1 is answered by the identity fallback,
   695	# which is exactly D4 coming back.
   696	#
   697	# Table location: resolved by the READER, next to the library it ships in
   698	# (rail round-6 F3 removed the environment channel entirely). doctor's own
   699	# DELIVERY_ROUTES_TSV was RETIRED in W6. A second knob the reader does not
   700	# honour is worse than none: a caller could poison a table nobody reads and see
   701	# a green run for it.
   702	
   703	# Last gate before anything touches the filesystem. Returns 0 to REFUSE — the
   704	# polarity of upgrade.sh's _up_tpl_confined_refuses / _up_tpl_symlink_refuses,
   705	# deliberately, so the two files read as a pair; keep them consistent when
   706	# either changes. $1 = destination relpath, $2 = resolved source relpath.
   707	#
   708	# The route reader already rejects a hostile row, and doctor's manifest
   709	# sanitiser (_relpath_unsafe, above) already screens every destination at
   710	# INGEST. Neither of those is a property of THIS write: the table is a FILE and
   711	# a partial checkout or a tampered tree still reaches these fields, the
   712	# sanitiser ran before the whole verification loop (a symlink planted in
   713	# between is a real TOCTOU window), and this is the LAST place before `cp`.
   714	# Belt and braces, on BOTH halves of the copy:
   715	#   1. LEXICAL — the reader's own predicate, applied to the destination AND to
   716	#      the source relpath that will be appended to $SOURCE_DIR.
   717	#   2. SYMLINK — never write THROUGH a link: refuse a symlinked leaf and any
   718	#      symlinked ancestor component.
   719	#   3. PHYSICAL — the deepest EXISTING ancestor of the destination must resolve
   720	#      (cd -P/pwd -P; the bash 3.2 floor has no realpath) to $TARGET or to a
   721	#      path under it, comparing against the RESOLVED $TARGET so a symlinked
   722	#      target directory is not a spurious refusal.
   723	# `|| true` inside each command substitution is load-bearing under `set -e`:
   724	# without it a failing `cd -P` aborts the whole script (measured) and the
   725	# named-refusal branch below is unreachable.
   726	_restore_refuses() {
   727	  _rr_rel="$1"
   728	  _rr_src="${2:-}"
   729	  if ! _wbm_route_relpath_ok "$_rr_rel"; then
   730	    _log "    RESTORE-BLOCKED (destination is not a confined relative path): $_rr_rel"
   731	    return 0
   732	  fi
   733	  if [ -n "$_rr_src" ] && ! _wbm_route_relpath_ok "$_rr_src"; then
   734	    _log "    RESTORE-BLOCKED (source '$_rr_src' is not a confined relative path — route table poisoned?): $_rr_rel"
   735	    return 0
   736	  fi
   737	  # rail round-7 F2 — LEXICAL is not PHYSICAL on the source side either. `cp -p`
   738	  # follows symlinks, so a source whose leaf or ancestor is a link to a regular
   739	  # file outside this checkout would be copied into the adopter tree as
   740	  # framework content — the same escape measured on the upgrade side (S327),
   741	  # and the same class as D4/A3 (doctor copying the WRONG source) arriving
   742	  # through a different door. This covers BOTH lanes: the route lane and the
   743	  # identity fallback that answers for every `.claude/**` manifest record.
   744	  if [ -n "$_rr_src" ] && ! _wbm_source_confined "$SOURCE_DIR" "$_rr_src"; then
   745	    _log "    RESTORE-BLOCKED (source not confined to the framework checkout — ${_WBM_SRC_CONFINE_WHY:-unknown reason}): $_rr_rel"
   746	    return 0
   747	  fi
   748	  # PLAN-185-FOLLOWUP FU-7 (S337): the destination half is the SHARED
   749	  # predicate install.sh and upgrade.sh consume (_wbm_dst_refuses,
   750	  # scripts/_framework_manifest_set.sh) — one implementation, not doctor's own
   751	  # copy of the symlink walk + physical resolution that lived here. It refuses
   752	  # everything the retired copy refused (symlinked leaf, symlinked ancestor,
   753	  # unresolvable ancestor, resolution outside the RESOLVED target) and one
   754	  # thing the copy did not: a HARD-LINKED leaf (nlink > 1). `cp -p` writes an
   755	  # existing destination IN PLACE, so every other name for that inode —
   756	  # including names outside the target — sees the framework bytes; e2e D.1
   757	  # reproduces that escape against the pre-cure copy. Polarity preserved:
   758	  # 0 = REFUSE.
   759	  if _wbm_dst_refuses "$TARGET" "$_rr_rel"; then
   760	    REFUSED_COUNT=$((REFUSED_COUNT + 1))
   761	    _log "    RESTORE-BLOCKED (destination refused — nothing written: ${_WBM_DST_REFUSE_WHY:-unknown reason}): $_rr_rel"
   762	    return 0
   763	  fi
   764	  return 1
   765	}
   766	
   767	# Restore one hash-record file from SOURCE_DIR. Preconditions already checked
   768	# by the caller: source exists AND H_src == H_base, and DRY_RUN handled by the
   769	# caller (a dry-run preview leaves the finding UNRESOLVED — the disk still
   770	# drifts, so the exit code must stay 1). $1=rel $2=base-digest.
   771	# Returns 0 on verified restore, 1 otherwise.
   772	_restore_file() {
   773	  _rf_rel="$1"
   774	  _rf_base="$2"
   775	  if ! _manifest_still_pinned; then
   776	    _manifest_pin_refused "$_rf_rel"
