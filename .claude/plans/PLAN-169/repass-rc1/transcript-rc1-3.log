   717	def main() -> int:
   718	    argv = sys.argv[1:]
   719	    if "--emit-instruction" in argv:
   720	        repo_root = Path(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
   721	        sid = os.environ.get("CLAUDE_SESSION_ID", "") or "unknown-session"
   722	        sys.stdout.write(
   723	            build_review_instruction(
   724	                session_id=sid, paths=l3_paths(repo_root), repo_root=repo_root
   725	            )
   726	            + "\n"
   727	        )
   728	        return 0
   729	    if "--record" in argv:
   730	        return _record_main(argv)
   731	    return _stop_main()
