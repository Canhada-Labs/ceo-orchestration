   522	
   523	def should_emit(marker_path: Path, digest: str, now_epoch: float,
   524	                interval_s: int) -> bool:
   525	    """True when the material digest changed AND the debounce floor elapsed."""
   526	    try:
   527	        with open(marker_path, "r", encoding="utf-8") as fh:
   528	            mark = json.load(fh)
   529	        last_digest = mark.get("digest")
   530	        last_ts = float(mark.get("emitted_at", 0))
   531	    except (OSError, ValueError, TypeError):
   532	        return True  # no/corrupt marker → first emit
   533	    if digest == last_digest:
   534	        return False
   535	    return (now_epoch - last_ts) >= interval_s
   536	
   537	
   538	def _write_marker(marker_path: Path, digest: str, now_epoch: float) -> None:
   539	    try:
   540	        tmp = marker_path.with_name(marker_path.name + ".tmp.%d" % os.getpid())
   541	        with open(tmp, "w", encoding="utf-8") as fh:
   542	            json.dump({"digest": digest, "emitted_at": now_epoch}, fh)
   543	        os.replace(tmp, marker_path)
   544	    except OSError:
   545	        pass
