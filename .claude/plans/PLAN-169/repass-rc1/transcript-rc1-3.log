   643	# No valid record at all (empty, comment-only or wholly malformed manifest) is
   644	# not "everything matched": it is an unreadable ledger, and deleting it would
   645	# erase the only evidence of what was installed.
   646	if [ "$valid_count" -eq 0 ]; then
   647	  unsafe_count=$((unsafe_count + 1))
   648	  _log "    REFUSED (manifest has no valid record — empty, comment-only or malformed; kept for inspection)"
   649	fi
   650	
   651	# Refuse if mismatches were encountered without --force, or if ANY record was
   652	# refused. rail r5 (S337) P2: --force overrides a sha MISMATCH, never a REFUSAL
   653	# (the manifest block below already says so), so a --force run that refused a
   654	# record is still an INCOMPLETE uninstall. Before this cure the `&& FORCE -eq 0`
   655	# applied to the refusal too: such a run fell through to the "everything
   656	# matched" summary below — a complete-looking report contradicted by its own
   657	# `Refused:` and `Manifest: KEPT` lines.
   658	if [ "$unsafe_count" -gt 0 ] || { [ "$mismatch_count" -gt 0 ] && [ "$FORCE" -eq 0 ]; }; then
   659	  _sweep_emptied_trees   # rail r1 (S337): the partial path empties trees too
   660	  _log ""
   661	  _log "==> Uninstall summary (incomplete):"
   662	  _log "    Removed:   $removed_count"
   663	  _log "    Preserved: $preserved_count (user-modified — sha didn't match manifest)"
   664	  _log "    Absent:    $absent_count (already gone)"
   665	  _log "    Refused:   $unsafe_count (unsafe manifest path, symlinked ancestor or relpath recorded more than once — not touched)"
   666	  _log ""
   667	  # The --force hint is only true for a sha mismatch met WITHOUT --force; a
   668	  # refusal is never lifted by --force, so say that instead of suggesting it.
   669	  if [ "$mismatch_count" -gt 0 ] && [ "$FORCE" -eq 0 ]; then
   670	    _log "    To force-remove user-modified files: re-run with --force"
   671	  fi
   672	  if [ "$unsafe_count" -gt 0 ]; then
   673	    _log "    Refused records are never removed, with or without --force: fix the manifest path or the symlinked ancestor, then re-run."
   674	  fi
   675	  _log "    Preserved files were NOT touched."
   676	  # An INCOMPLETE uninstall is never a success (rc.1 re-pass, part 3 U2):
   677	  # automation that reads only $? must not record a refused or preserved
   678	  # run as done. The dry-run stays 0 — it is a preview (header). Refusal
   679	  # outranks mismatch: a refused record is never lifted by --force.
   680	  if [ "$DRY_RUN" -eq 1 ]; then exit 0; fi
   681	  if [ "$unsafe_count" -gt 0 ]; then exit 6; fi
   682	  exit 5
   683	fi
   684	
   685	# Clean up manifest + empty .claude/ subdirs (only if everything matched)
   686	if ! _dry "would REMOVE manifest $MANIFEST"; then
   687	  # rail r3 (S337) P1: a refused record (unsafe path / symlinked ancestor) means
   688	  # the install was not fully removed — keep the manifest for a --force retry.
   689	  # rail r4 (S337) P2: --force overrides a sha MISMATCH, never a REFUSAL —
   690	  # a refused record was not removed by any run, so the ledger must survive.
   691	  if [ "$unsafe_count" -eq 0 ] && { [ "$mismatch_count" -eq 0 ] || [ "$FORCE" -eq 1 ]; }; then
   692	    rm -f "$MANIFEST"
   693	  fi
   694	fi
   695	
   696	# Clean up empty directories under .claude/ (post-removal sweep)
   697	if [ "$DRY_RUN" -eq 0 ] && [ -d "$TARGET/.claude" ]; then
   698	  find "$TARGET/.claude" -depth -type d -empty -delete 2>/dev/null || true
   699	fi
   700	
   701	# PLAN-183 §9.8 (S337): the same sweep for every other top-level tree this run
   702	# removed deliveries from (docs/, .github/, SPEC/ …). Measured before the cure:
   703	# a pristine uninstall left docs/, .github/workflows/ and SPEC/v1 behind, empty.
   704	_sweep_emptied_trees
   705	
   706	_log ""
   707	_log "==> Uninstall summary:"
   708	_log "    Removed:   $removed_count"
   709	_log "    Preserved: $preserved_count"
   710	_log "    Absent:    $absent_count"
   711	_log "    Refused:   $unsafe_count (unsafe manifest path, symlinked ancestor or relpath recorded more than once — not touched)"
   712	_log "    Manifest:  $([ -f "$MANIFEST" ] && echo "KEPT" || echo "REMOVED")"
   713	exit 0

