   277	MANIFEST="$TARGET/.claude/.install-manifest.sha256"
   278	# rc.1 re-pass round 11, part 3 (P1): `-f` FOLLOWS a link, so a manifest leaf
   279	# symlinked to ANOTHER repository's valid manifest was read through it and
   280	# --repair recreated files and links from that foreign provenance, exit 0.
   281	# The link is refused (never followed) before anything reads it — the same
   282	# posture as uninstall.sh — in the manifest-input exit class (2). The
   283	# identity of the file the sanitizer reads is pinned below (_MANIFEST_ID)
   284	# and re-proved before every write.
   285	if [ -L "$MANIFEST" ]; then
   286	  echo "ERROR: install manifest at $MANIFEST is a SYMLINK — doctor never reads a manifest through a link; refusing (nothing verified, nothing written)." >&2
