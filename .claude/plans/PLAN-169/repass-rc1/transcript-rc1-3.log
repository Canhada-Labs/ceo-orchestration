   611	    async def bounded(scenario) -> Dict[str, Any]:
   612	        async with sem:
   613	            return await run_one_scenario(
   614	                client,
   615	                scenario,
   616	                skill_content=skill_content,
   617	                model=args.model,
   618	                max_tokens=args.max_tokens,
   619	                repetitions=args.repetitions,
   620	                scoring=scoring,
   621	                max_input_chars=DEFAULT_MAX_INPUT_CHARS,
   622	            )
   623	
   624	    tasks = [bounded(s) for s in scenarios]
   625	    try:
   626	        results = await asyncio.gather(*tasks, return_exceptions=True)
   627	    except asyncio.CancelledError:
   628	        raise
   629	    except Exception as gather_err:  # pragma: no cover — gather(return_exceptions=True) absorbs per-task errors
   630	        print(
   631	            f"benchmark: asyncio.gather failed unexpectedly: {gather_err}",
   632	            file=sys.stderr,
   633	        )
   634	        results = [gather_err] * len(tasks)
   635	
   636	    per_scenario: List[Dict[str, Any]] = []
   637	    for r in results:
   638	        if isinstance(r, Exception):
   639	            per_scenario.append({"error": str(r), "passed": False})
   640	        else:
   641	            per_scenario.append(r)
   642	
   643	    passed_count = sum(1 for r in per_scenario if r.get("passed"))
   644	    total_count = len(per_scenario)
