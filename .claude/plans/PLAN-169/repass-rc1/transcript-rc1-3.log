   316	# ---------------------------------------------------------------------------
   317	# Repo-derived fields (plan id + worktree) — read-only, capped, fail-soft
   318	# ---------------------------------------------------------------------------
   319	
   320	
   321	def active_plan_id(project_dir: Path) -> Optional[str]:
   322	    """Single ``status: executing`` plan id from ``.claude/plans/`` (capped scan).
   323	
   324	    Exactly one executing plan → its ``PLAN-NNN``. More than one → first
   325	    (sorted) + ``+N`` marker. Zero → None. Mirrors the /status convention,
   326	    deliberately simpler than check_budget's active-set logic.
   327	    """
   328	    plans_dir = project_dir / ".claude" / "plans"
   329	    try:
   330	        names = sorted(p for p in plans_dir.iterdir() if p.is_file()
   331	                       and p.name.startswith("PLAN-") and p.name.endswith(".md"))
   332	    except OSError:
   333	        return None
   334	    ids = []
   335	    for p in names[:_MAX_PLAN_FILES]:
   336	        try:
   337	            with open(p, "r", encoding="utf-8", errors="replace") as fh:
   338	                head = fh.read(_PLAN_HEAD_BYTES)
   339	        except OSError:
   340	            continue
   341	        if re.search(r"^status:\s*['\"]?executing\b", head, re.M):
   342	            m = re.match(r"(PLAN-\d{3})", p.name)
   343	            if m:
   344	                ids.append(m.group(1))
   345	    if not ids:
   346	        return None
   347	    if len(ids) == 1:
   348	        return ids[0]
   349	    return "%s+%d" % (ids[0], len(ids) - 1)
   350	
   351	
   352	def worktree_info(project_dir: Path) -> Dict[str, Optional[str]]:
   353	    """Worktree dir basename + branch, read from .git/HEAD (no subprocess)."""
   354	    branch: Optional[str] = None
   355	    git = project_dir / ".git"
   356	    try:
   357	        head_path: Optional[Path] = None
   358	        if git.is_file():  # linked worktree: ".git" is a pointer file
   359	            m = re.search(r"gitdir:\s*(.+)", git.read_text(encoding="utf-8", errors="replace"))
   360	            if m:
   361	                gd = Path(m.group(1).strip())
   362	                if not gd.is_absolute():
   363	                    gd = (project_dir / gd).resolve()
   364	                head_path = gd / "HEAD"
   365	        elif git.is_dir():
   366	            head_path = git / "HEAD"
   367	        if head_path is not None and head_path.is_file():
   368	            ht = head_path.read_text(encoding="utf-8", errors="replace").strip()
   369	            m = re.match(r"ref:\s*refs/heads/(.+)", ht)
   370	            branch = m.group(1)[:64] if m else (ht[:8] or None)  # detached → short sha
   371	    except OSError:
   372	        pass
   373	    return {"dir": project_dir.name[:64] or None, "branch": branch}
