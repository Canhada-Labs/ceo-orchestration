    78	    def test_steps_match_declaration_exactly_in_order(self) -> None:
    79	        got = _step_names(_template_text())
    80	        self.assertEqual(
    81	            got,
    82	            FROZEN_STEPS,
    83	            "validate.yml.template divergiu do subconjunto congelado "
    84	            "(Ramo B, PLAN-183 W2). Divergência DELIBERADA exige editar "
    85	            "a declaração FROZEN_STEPS neste teste no MESMO patch, com a "
    86	            "razão no plano.",
    87	        )
    88	
    89	    def test_removed_steps_do_not_return(self) -> None:
    90	        text = _template_text()
    91	        for name in REMOVED_STEPS:
    92	            self.assertNotIn(
    93	                name,
