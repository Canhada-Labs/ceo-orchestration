   174	# Collect commits to check for one pushed ref range.
   175	# Args: <local_sha> <remote_sha>
   176	_commits_in_range() {
   177	  local local_sha="$1" remote_sha="$2"
   178	  if [ "$local_sha" = "$_zero" ]; then
   179	    return 0  # branch deletion — nothing to push
