   539	      | while IFS= read -r _brel; do
   540	          case "$_brel" in .claude/*) continue ;; esac
   541	          [ -f "$TARGET/$_brel" ] && [ ! -L "$TARGET/$_brel" ] && printf '%s\n' "$_brel"
   542	        done >> "$backup_list"
