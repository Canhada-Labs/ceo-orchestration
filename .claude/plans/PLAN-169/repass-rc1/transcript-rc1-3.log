   509	        _mark_dropped "malformed record (no two-space separator)" "$line"
   510	        continue
   511	      fi
   512	      case "$digest" in
   513	        *[!0-9a-f]*) _mark_dropped "malformed record (digest is not hexadecimal)" "$rel"; continue ;;
   514	      esac
   515	      if [ "${#digest}" -ne 64 ]; then
   516	        _mark_dropped "malformed record (digest is not 64 characters)" "$rel"
   517	        continue
   518	      fi
   519	      if _relpath_unsafe "$rel" file; then
   520	        _mark_dropped "unsafe manifest path (traversal, absolute, control character, or symlinked ancestor)" "$rel"
   521	        continue
   522	      fi
   523	      if _seen_before "$rel"; then
   524	        _mark_invalid "$rel"
   525	        _mark_dropped "duplicate relpath (ambiguous — every record for it is dropped)" "$rel"
   526	        continue
   527	      fi
   528	      _mark_seen "$rel"
