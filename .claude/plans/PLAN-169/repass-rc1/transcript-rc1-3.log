   191	# The sweep itself: only EMPTY directories go (-empty), so a tree that still
   192	# holds a file of the adopter's — or a PRESERVED delivery — is never touched,
   193	# and trees this run did not remove from are not visited at all. Called on
   194	# BOTH exit paths (complete and incomplete): a partial uninstall that removed
   195	# every docs/ delivery but preserved an edited CODEOWNERS still empties docs/.
   196	_sweep_emptied_trees() {
   197	  # DEEPEST FIRST, so `docs/a/b` is tried before `docs/a` and a chain empties
   198	  # in one pass. `rmdir` on the exact path, never `find -delete` over a tree:
   199	  # rmdir refuses a non-empty directory by itself, so a directory holding
   200	  # anything at all — an adopter's file, a PRESERVED delivery, another
   201	  # adopter-created directory — survives without this code having to reason
   202	  # about it.
   203	  printf '%s\n' "$swept_dirs" \
   204	    | awk 'NF { print gsub(/\//, "/") "\t" $0 }' \
   205	    | sort -rn -k1,1 \
   206	    | cut -f2- \
   207	    | while IFS= read -r _dir; do
   208	        case "$_dir" in ''|.|..|/*|*..*) continue ;; esac   # never leave the target
   209	        [ -d "$TARGET/$_dir" ] || continue
   210	        [ -L "$TARGET/$_dir" ] && continue
   211	        if ! _dry "would REMOVE the empty directory $_dir/"; then
   212	          rmdir "$TARGET/$_dir" 2>/dev/null || true
   213	        fi
   214	      done
   215	}
   216	
   217	# ---------------------------------------------------------------------------
    15	# abandoned (session killed / refused twice). Push is BLOCKED when commits
    16	# being pushed touch L3/canonical paths without a recorded cross-model
    17	# review. A review record is EITHER:
    18	#
    19	#   (a) a `Pair-Rail-Reviewed: APPROVE` trailer in each canonical-touching
    20	#       commit message (git-native; survives a fresh clone -- the ONLY path
    21	#       that works in CI / on another machine), OR
    22	#   (b) an APPROVE record in the local review-log sidecar written by
    23	#       `check_codex_stop_review.py (or its grok equivalent) --record`, matched by the path-set
    24	#       fingerprint (machine-local; absent on a fresh clone -- see residual).
    25	#
    26	# ## Fingerprint parity (PLAN-156-FOLLOWUP F5, debate C2 — unanimous)
    27	#
    28	# The recorder fingerprints the AGGREGATE canonical path set classified by
    29	# `check_canonical_edit._is_canonical` (the fine, single-source-of-truth
    30	# predicate). This gate previously hashed COARSE first-segment paths
   160	    else
   161	      echo "pre-push-review-gate: single resolver not found at $_rp; sidecar APPROVE path unavailable (run scripts/upgrade.sh)" >&2
   162	    fi
   163	  fi
   164	}
   165	
   166	_review_log() {
   167	  local sd
   168	  sd="$(_state_dir)"
   169	  # Empty state dir (resolver unavailable) => no sidecar log at all.
   170	  [ -n "$sd" ] || return 0
   171	  printf '%s/grok-review-log.jsonl' "$sd"
   172	}
   173	
   174	# Collect commits to check for one pushed ref range.
   175	# Args: <local_sha> <remote_sha>
   176	_commits_in_range() {
   177	  local local_sha="$1" remote_sha="$2"
   178	  if [ "$local_sha" = "$_zero" ]; then
   179	    return 0  # branch deletion — nothing to push
   180	  fi
   345	if [ "$_fail_count" -gt 0 ]; then
   346	  {
   347	    echo "PRE-PUSH REVIEW GATE (inverted pair-rail) -- RED"
   348	    echo "  pushed range touches L3/canonical paths with NO cross-model review record:"
   349	    sed 's/^/    - /' "$_canonical_file"
   350	    echo "  aggregate path-set fingerprint: ${_fp}"
   351	    echo "  canonical-touching commit(s) without an APPROVE trailer:"
   352	    printf '%s' "$_unreviewed_commits"
   353	    echo ""
   354	    echo "To clear this gate, EITHER:"
   355	    echo "  (a) add a 'Pair-Rail-Reviewed: APPROVE' trailer to the commit(s)"
   356	    echo "      AFTER a real claude -p cross-model review, OR"
   357	    echo "  (b) run the review at Stop time so check_codex_stop_review.py (or its grok equivalent)"
   358	    echo "      --record writes an APPROVE record for the path set."
   359	    echo ""
   360	    echo "Residual: 'git push --no-verify' bypasses this client-side hook;"
   361	    echo "CODEOWNERS + branch protection + the validate.yml review rider are"
   362	    echo "the server-side backstops. This gate is a BACKSTOP, not the sole line."
   363	  } >&2
   364	  if [ "$ADVISORY" = "1" ]; then
   365	    echo "pre-push-review-gate: ADVISORY mode -- ${_fail_count} unreviewed canonical commit(s); NOT blocking." >&2

