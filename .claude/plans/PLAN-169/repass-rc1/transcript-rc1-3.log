     1	"""Unit tests for templates/compaction.md (PLAN-133 / Wave D / item D4).
     2	
     3	The compaction template is a NON-CANONICAL, editable framework artifact: a
     4	nine-section Markdown skeleton fed to the model when a session is compacted so
     5	that load-bearing state (blockers, env flags, staged canonical edits) survives
     6	the rewrite. These tests pin the load-bearing contract:
     7	
     8	  * the nine "## N. <Title>" section headers exist, in order, none dropped;
     9	  * the template carries the no-secret-echo rule (it must NEVER instruct the
    10	    model to copy a credential value into the summary);
    11	  * the template is contamination-clean (no personal handles / project names)
    12	    — it ships in templates/ which the contamination scanner gates;
    13	  * the editability affordance is present (placeholder tokens + "(none)"
    14	    convention) so a reader can tell "empty" from "forgotten".
    15	
    16	Stdlib-only, py>=3.9, fail-open-on-infra (a missing file is a hard test
    17	failure, never a crash that masks other tests).
    18	"""
    19	
    20	from __future__ import annotations
    21	
    22	import re
    23	import sys
    24	import unittest
    25	from pathlib import Path
    26	
    27	# templates/compaction.md lives at <repo-root>/templates/compaction.md.
    28	# This test file is at <repo-root>/.claude/scripts/tests/, so walk up 3.
    29	_REPO_ROOT = Path(__file__).resolve().parents[3]
    30	_TEMPLATE = _REPO_ROOT / "templates" / "compaction.md"
    31	
    32	# Import TestEnvContext from _lib so these tests get per-test env isolation
    33	# (env-hygiene mandate) instead of bare unittest.TestCase.
    34	_HOOKS_DIR = _REPO_ROOT / ".claude" / "hooks"
    35	if str(_HOOKS_DIR) not in sys.path:
    36	    sys.path.insert(0, str(_HOOKS_DIR))
    37	from _lib.testing import TestEnvContext  # noqa: E402
    38	
    39	# The nine section titles, in their contractually-required order. Downstream
    40	# readers key off the exact "## N. <Title>" line, so this list is the spec.
    41	_EXPECTED_SECTIONS = [
    42	    (1, "Mission & objective"),
    43	    (2, "Key decisions & rationale"),
    44	    (3, "Files & artifacts touched"),
    45	    (4, "Current state — what works, what is pending"),
    46	    (5, "Open problems & blockers"),
    47	    (6, "Next steps (ordered)"),
    48	    (7, "Constraints & operating context"),
    49	    (8, "Test & verification status"),
    50	    (9, "References"),
    51	]
    52	
    53	# Contamination patterns: mirror .claude/scripts/check_contamination.py so a
    54	# regression in the template is caught HERE (fast unit) as well as by the
    55	# repo-wide governance scan.
    56	_CONTAMINATION = re.compile(
    57	    r"42\s*[Ll]edger|joao[\s._\-]*canhada|Jo[aã]o\s+Canhada",
    58	    re.IGNORECASE,
    59	)
    60	
    61	
    62	class CompactionTemplateBase(TestEnvContext):
    63	    """Loads the template text once per test."""
    64	
    65	    def setUp(self) -> None:
    66	        super().setUp()
    67	        self.assertTrue(
    68	            _TEMPLATE.is_file(),
    69	            f"compaction template missing at {_TEMPLATE}",
    70	        )
    71	        self.text = _TEMPLATE.read_text(encoding="utf-8")
    72	
    73	    def _header_lines(self):
    74	        """Return the ordered list of '## ...' header lines (verbatim)."""
    75	        return [
    76	            line.strip()
    77	            for line in self.text.splitlines()
    78	            if line.startswith("## ")
    79	        ]
    80	
    81	
    82	class TestNineSectionContract(CompactionTemplateBase):
    83	
    84	    def test_exactly_nine_numbered_sections(self):
    85	        numbered = [
    86	            h for h in self._header_lines()
    87	            if re.match(r"^## \d+\.\s", h)
    88	        ]
    89	        self.assertEqual(
    90	            len(numbered), 9,
    91	            f"expected exactly 9 numbered sections, got {len(numbered)}: {numbered}",
    92	        )
    93	
    94	    def test_each_section_header_present_with_exact_title(self):
    95	        for num, title in _EXPECTED_SECTIONS:
    96	            expected = f"## {num}. {title}"
    97	            self.assertIn(
    98	                expected, self.text,
    99	                f"missing or renamed section header: {expected!r}",
   100	            )
   101	
   102	    def test_sections_appear_in_ascending_order(self):
   103	        positions = []
   104	        for num, title in _EXPECTED_SECTIONS:
   105	            header = f"## {num}. {title}"
   106	            idx = self.text.find(header)
   107	            self.assertNotEqual(idx, -1, f"header not found: {header!r}")
   108	            positions.append(idx)
   109	        self.assertEqual(
   110	            positions, sorted(positions),
   111	            "section headers are not in ascending document order",
   112	        )
   113	
   114	    def test_numbered_headers_are_strictly_1_through_9(self):
   115	        numbers = []
   116	        for h in self._header_lines():
   117	            m = re.match(r"^## (\d+)\.\s", h)
   118	            if m:
   119	                numbers.append(int(m.group(1)))
   120	        self.assertEqual(
   121	            numbers, list(range(1, 10)),
   122	            f"numbered headers must be 1..9 in order, got {numbers}",
   123	        )
   124	
   125	
   126	class TestSafetyAndEditability(CompactionTemplateBase):
   127	
   128	    def test_no_secret_echo_rule_is_documented(self):
   129	        # The template MUST tell the model never to copy a credential value.
   130	        lowered = self.text.lower()
   131	        self.assertIn("never echo a secret", lowered)
   132	
   133	    def test_no_value_echo_doctrine_language_present(self):
   134	        # Cross-references the framework's audit no-value-echo discipline.
   135	        self.assertIn("no-value-echo", self.text.lower())
   136	
   137	    def test_empty_section_convention_documented(self):
   138	        # Editors / model must emit the literal "(none)" for empty sections.
   139	        self.assertIn("(none)", self.text)
   140	
   141	    def test_placeholder_tokens_present_for_editability(self):
   142	        # @OWNER and <project> are the de-identified placeholders the
   143	        # framework convention requires (see check_contamination allowlist).
   144	        self.assertIn("@OWNER", self.text)
   145	        self.assertIn("<project>", self.text)
   146	
   147	    def test_template_is_contamination_clean(self):
   148	        # The whole point of using placeholders: no real identity leaks.
   149	        match = _CONTAMINATION.search(self.text)
   150	        self.assertIsNone(
   151	            match,
   152	            f"template leaks an identifying token: {match.group(0)!r}"
   153	            if match else "",
   154	        )
   155	
   156	    def test_preserve_identifiers_rule_present(self):
   157	        # Lossy summaries paraphrase identifiers; the template forbids that.
   158	        lowered = self.text.lower()
   159	        self.assertIn("verbatim", lowered)
   160	
   161	
   162	if __name__ == "__main__":  # pragma: no cover
   163	    unittest.main()
