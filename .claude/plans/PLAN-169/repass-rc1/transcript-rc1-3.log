   169	# Does this commit carry an APPROVE pair-rail trailer? (acceptance path a)
   170	_commit_has_approve_trailer() {
   171	  local sha="$1"
   172	  git log -1 --format='%B' "$sha" 2>/dev/null \
   173	    | grep -Eiq '^Pair-Rail-Reviewed:[[:space:]]*APPROVE' && return 0
   174	  return 1
   175	}
   176	
   177	# Does the sidecar review-log carry an APPROVE record matching this
   178	# fingerprint? (acceptance path b)
   179	_sidecar_has_approve() {
   180	  local fp="$1" log
   181	  log="$(_review_log)"
   182	  [ -n "$log" ] && [ -f "$log" ] || return 1
   183	  # Match a JSON object line that is APPROVE AND carries this fingerprint.
   184	  grep -F "\"fingerprint\": \"${fp}\"" "$log" 2>/dev/null \
