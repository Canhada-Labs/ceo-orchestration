  1407	install_lib_selective() {
  1408	  echo ""
  1409	  echo "==> Installing hooks/_lib (runtime only — tests/, test_isolation.py, testing.py excluded)"
  1410	  local e base preexisting
  1411	  for e in "$SOURCE_DIR/.claude/hooks/_lib/"*; do
  1412	    [[ -e "$e" ]] || continue
  1413	    base="$( basename "$e" )"
  1414	    # PLAN-161 U2 (CF-7): route through the ONE canonical framework-internal
  1415	    # exclusion predicate (scripts/_framework_manifest_set.sh) so install and
  1416	    # upgrade can never drift apart again. Behavior identical to the previous
  1417	    # literal case; the fallback case below only serves a partial checkout
  1418	    # where the helper file was absent at source time (fail-open parity).
  1419	    if command -v _framework_path_excluded >/dev/null 2>&1; then
  1420	      if _framework_path_excluded ".claude/hooks/_lib/$base"; then continue; fi
  1421	    else
  1422	      case "$base" in
  1423	        tests|test_isolation.py|testing.py|__pycache__) continue ;;
  1424	      esac
  1425	    fi
  1426	    preexisting=0
  1427	    [[ -e "$TARGET/.claude/hooks/_lib/$base" || -L "$TARGET/.claude/hooks/_lib/$base" ]] && preexisting=1
  1428	    install_one ".claude/hooks/_lib/$base"
  1429	    # PLAN-161 U2 (codex r1 F7): only a directory we JUST copied is pruned —
  1430	    # a pre-existing (EXISTS-skipped) adopter dir is left untouched, link
  1431	    # mode installs a symlink (the prune helper refuses symlink roots), and
  1432	    # dry-run copies nothing.
  1433	    if [[ "$DRY_RUN" -eq 0 && "$MODE" != "link" && "$preexisting" -eq 0 && -d "$e" && ! -L "$e" ]]; then
  1434	      _prune_pycache_under "$TARGET/.claude/hooks/_lib/$base"
  1435	    fi
  1436	  done
  1437	}
