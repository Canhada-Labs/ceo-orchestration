   289	fi
   290	if [ ! -f "$MANIFEST" ]; then
   291	  echo "ERROR: install manifest not found at $MANIFEST" >&2
   292	  echo "       This target has no recorded baseline (pre-PLAN-138 install?)." >&2
   293	  echo "       Run upgrade.sh once to (re)generate it, then re-run doctor." >&2
   294	  exit 2
   295	fi
