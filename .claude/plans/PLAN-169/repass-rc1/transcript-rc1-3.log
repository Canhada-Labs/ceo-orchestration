   547	
   548	def _pct_to_bps(pct: Optional[float], cap_bps: int = 10000) -> Optional[int]:
   549	    """Percentage (0..N) -> integer basis-points (0..cap_bps) for the
   550	    HMAC-covered statusline AUDIT breadcrumb only. None passes through.
   551	    PLAN-135-FOLLOWUP-2 (S234): the canonical encoder forbids float in a
   552	    signed payload (S181); the prior float form was written with hmac=null on
   553	    every emit since v2.44. context_pct is 0..100% (cap 10000);
   554	    buckets_used_pct_max is capped at 999% upstream (cap 99900 — no 100%
   555	    ceiling, so an over-quota burst is preserved, not floored). This does NOT
   556	    touch context_pct() or the on-disk sidecar JSON, which stay float."""
   557	    if pct is None:
   558	        return None
   559	    try:
   560	        return max(0, min(cap_bps, int(round(float(pct) * 100))))
   561	    except (TypeError, ValueError, OverflowError):
   562	        return None
   563	
   564	
   565	def maybe_emit(sidecar: Path, snapshot: Dict[str, Any]) -> None:
   566	    if os.environ.get("CEO_STATUSLINE_EMIT", "1").strip().lower() in ("0", "false", "no", "off"):
   567	        return
   568	    digest = snapshot_digest(snapshot)
   569	    marker = sidecar.with_name(sidecar.name + ".emit-state.json")
   570	    now_epoch = time.time()
   571	    if not should_emit(marker, digest, now_epoch, _emit_interval_s()):
   572	        return
   573	    _write_marker(marker, digest, now_epoch)  # marker first — a crashed emit must not retry-flood
   574	    try:
   575	        hooks_dir = None
   576	        pd = snapshot.get("project_dir")
   577	        if pd and (Path(pd) / ".claude" / "hooks" / "_lib").is_dir():
   578	            hooks_dir = Path(pd) / ".claude" / "hooks"
   579	        else:
   580	            cand = Path(__file__).resolve().parents[1] / "hooks"
   581	            if (cand / "_lib").is_dir():
   582	                hooks_dir = cand
   583	        if hooks_dir is None:
   584	            return
   585	        if str(hooks_dir) not in sys.path:
   586	            sys.path.insert(0, str(hooks_dir))
   587	        from _lib import audit_emit  # noqa: E402  (deferred heavy import)
   588	        rl = snapshot.get("rate_limits") or {}
   589	        pcts = [b.get("used_pct") for b in rl.values() if b.get("used_pct") is not None]
   590	        audit_emit.emit_generic(
   591	            _EMIT_ACTION,
   592	            sidecar_path=str(sidecar),
   593	            plan_id=snapshot.get("plan_id"),
   594	            # PLAN-135-FOLLOWUP-2: percentages are HMAC-covered -> integer
   595	            # basis-points (pct * 100), never float (S181). Different caps:
   596	            # context 0..100% (10000); buckets up to 999% (99900).
   597	            context_pct_bps=_pct_to_bps(snapshot.get("context_pct")),
   598	            bucket_count=len(rl),
   599	            buckets_used_pct_max_bps=_pct_to_bps(
   600	                max(pcts) if pcts else None, cap_bps=99900
   601	            ),
   602	            session_id=snapshot.get("session_id") or "",
   603	            digest=digest[:12],
   604	        )
   605	    except Exception:
   606	        # Fail-soft: observability must never break the status line.
   607	        pass
