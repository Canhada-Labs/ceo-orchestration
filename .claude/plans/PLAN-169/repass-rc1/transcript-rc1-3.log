   223	# ---------------------------------------------------------------------------
   224	# stdin parsing (tolerant)
   225	# ---------------------------------------------------------------------------
   226	
   227	
   228	def _read_stdin_json() -> Optional[Dict[str, Any]]:
   229	    try:
   230	        raw = sys.stdin.read()
   231	    except Exception:
   232	        return None
   233	    if not raw or not raw.strip():
   234	        return None
   235	    try:
   236	        data = json.loads(raw)
   237	    except ValueError:
   238	        return None
   239	    return data if isinstance(data, dict) else None
   240	
   241	
   242	def _num(v: Any) -> Optional[float]:
   243	    """Coerce to float; bool/None/str-garbage → None (numbers only)."""
   244	    if isinstance(v, bool) or v is None:
   245	        return None
   246	    if isinstance(v, (int, float)):
   247	        return float(v)
   248	    if isinstance(v, str):
   249	        try:
   250	            return float(v.strip())
   251	        except ValueError:
   252	            return None
   253	    return None
   254	
   255	
   256	def _safe_slug(name: Any, max_len: int = 32) -> str:
   257	    return re.sub(r"[^a-z0-9_]", "_", str(name).lower())[:max_len]
   258	
   259	
   260	def normalize_rate_limits(raw: Any) -> Dict[str, Dict[str, Any]]:
   261	    """Normalize the (unverified-shape) rate_limits field.
   262	
   263	    Accepts EITHER a flat ``{used_percentage, resets_at}`` object (one
   264	    primary bucket) OR ``{bucket_name: {used_percentage, resets_at}}``.
   265	    Output: ``{safe_bucket: {"used_pct": float|None, "resets_at": str|None}}``.
   266	    Unknown extra fields are dropped (numbers/ids only — no free text).
   267	    """
   268	    out: Dict[str, Dict[str, Any]] = {}
   269	    if not isinstance(raw, dict):
   270	        return out
   271	
   272	    def _bucket(name: Any, d: Any) -> None:
   273	        if not isinstance(d, dict):
   274	            return
   275	        pct = _num(d.get("used_percentage", d.get("utilization", d.get("used_pct"))))
   276	        if pct is not None:
   277	            pct = round(min(max(pct, 0.0), 999.0), 1)
   278	        # Verified contract: resets_at is UNIX EPOCH SECONDS (int). We also
   279	        # tolerate an ISO-8601 string in case a future build changes it.
   280	        # Stored faithfully (digits + ISO punctuation kept); the renderer
   281	        # parses both forms.
   282	        resets = d.get("resets_at", d.get("reset_at", d.get("resets")))
   283	        resets_s: Optional[str] = None
   284	        if isinstance(resets, (str, int, float)) and not isinstance(resets, bool):
   285	            resets_s = re.sub(r"[^0-9TZz:+.-]", "", str(resets))[:40] or None
   286	        if pct is None and resets_s is None:
   287	            return
   288	        key = _safe_slug(name) or "bucket"
   289	        out[key] = {"used_pct": pct, "resets_at": resets_s}
   290	
   291	    if any(isinstance(v, dict) for v in raw.values()):
   292	        for k, v in raw.items():
   293	            if isinstance(v, dict):
   294	                _bucket(k, v)
   295	    else:
   296	        _bucket("primary", raw)
   297	    return out
   298	
   299	
   300	def context_pct(data: Dict[str, Any]) -> Optional[float]:
   301	    """Best-effort context-usage %. Tries several candidate shapes; None when absent."""
   302	    for key in ("context_window", "context", "context_usage"):
   303	        cw = data.get(key)
   304	        if not isinstance(cw, dict):
   305	            continue
   306	        pct = _num(cw.get("used_percentage", cw.get("used_pct", cw.get("percent_used"))))
   307	        if pct is not None:
   308	            return round(min(max(pct, 0.0), 100.0), 1)
   309	        used = _num(cw.get("used_tokens", cw.get("input_tokens", cw.get("total_input_tokens"))))
   310	        size = _num(cw.get("context_window_size", cw.get("max_tokens", cw.get("size"))))
   311	        if used is not None and size is not None and size > 0:
   312	            return round(min(max(used / size * 100.0, 0.0), 100.0), 1)
   313	    return None
   314	
