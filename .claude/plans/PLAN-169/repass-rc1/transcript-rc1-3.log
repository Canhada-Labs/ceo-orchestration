   154	# ---------------------------------------------------------------------------
   155	# Resolve SCRIPT_DIR / SOURCE_DIR (mirrors install.sh:178-204 so doctor's
   156	# restore source is the SAME framework checkout install.sh would copy from,
   157	# including when invoked via a symlink).
   158	# ---------------------------------------------------------------------------
   159	_resolve_script_path() {
   160	  local src="$1"
   161	  if command -v readlink >/dev/null 2>&1; then
   162	    local resolved
   163	    if resolved="$(readlink -f "$src" 2>/dev/null)" && [ -n "$resolved" ]; then
   164	      printf '%s\n' "$resolved"
