   195	# ---------------------------------------------------------------------------
   196	# state dir + review log (check_subagent_start.py resolution precedent)
   197	# ---------------------------------------------------------------------------
   198	
   199	def _state_dir() -> Path:
   200	    override = os.environ.get("CEO_CODEX_REVIEW_STATE_DIR")
   201	    if override:
   202	        return Path(override)
   203	    audit_dir = os.environ.get("CEO_AUDIT_LOG_DIR")
   204	    if audit_dir:
   205	        return Path(audit_dir)
   206	    home = os.environ.get("HOME") or "/tmp"
   207	    return _rp_state_dir() / "state"
   208	
   209	
   210	def _review_log_path() -> Path:
   211	    return _state_dir() / _REVIEW_LOG_FILENAME
   212	
   213	
   214	def _append_review_record(record: Dict[str, Any]) -> bool:
   215	    """Append one review record (JSONL). Bounded, atomic-ish, never raises."""
   216	    try:
   217	        path = _review_log_path()
   218	        path.parent.mkdir(parents=True, exist_ok=True)
   219	        lines: List[str] = []
   220	        if path.is_file():
   221	            try:
   222	                lines = path.read_text(encoding="utf-8").splitlines()
   223	            except Exception:
   224	                lines = []
   225	        lines.append(json.dumps(record, ensure_ascii=False, sort_keys=True))
   226	        if len(lines) > _REVIEW_LOG_MAX_LINES:
   227	            lines = lines[-_REVIEW_LOG_MAX_LINES:]
   228	        tmp = path.with_name(path.name + ".tmp.%d" % os.getpid())
   229	        tmp.write_text("\n".join(lines) + "\n", encoding="utf-8")
   230	        os.replace(str(tmp), str(path))
   231	        return True
   232	    except Exception as exc:  # pragma: no cover — defensive
   233	        _breadcrumb("review-log append failed: %s" % str(exc)[:120])
   234	        return False
   235	
   236	
   237	def _read_review_records() -> List[Dict[str, Any]]:
   238	    path = _review_log_path()
   239	    if not path.is_file():
   240	        return []
   241	    out: List[Dict[str, Any]] = []
   242	    try:
   243	        for line in path.read_text(encoding="utf-8").splitlines():
   244	            line = line.strip()
   245	            if not line:
   246	                continue
   247	            try:
   248	                obj = json.loads(line)
   249	            except Exception:
   250	                continue
   251	            if isinstance(obj, dict):
   252	                out.append(obj)
   253	    except Exception:
   254	        return out
   255	    return out
   256	
   257	
   258	def latest_review_record(
   259	    session_id: str, fingerprint: str
   260	) -> Optional[Dict[str, Any]]:
   261	    """Most-recent review record matching this session AND path-set
   262	    fingerprint. A record with a non-matching fingerprint (the canonical
   263	    path set changed since it was written) does NOT satisfy the gate."""
   264	    match: Optional[Dict[str, Any]] = None
   265	    for rec in _read_review_records():
   266	        if str(rec.get("session_id") or "") != session_id:
   267	            continue
   268	        if str(rec.get("fingerprint") or "") != fingerprint:
   269	            continue
   270	        match = rec  # later lines win (append order == chronological)
   271	    return match
   272	
   273	
   274	# ---------------------------------------------------------------------------
   275	# L3 / canonical path detection (working tree)
   276	# ---------------------------------------------------------------------------
   277	
   278	# Fallback prefix set — mirror of check_canonical_edit._CANONICAL_PREFIXES.
   279	# Used ONLY if the real predicate cannot be imported. Coarser (first-segment
   280	# prefix) — it over-triggers review, which is the safe direction (a missed
   281	# L3 touch is the danger; an extra review is not).
   282	_FALLBACK_CANONICAL_PREFIXES = frozenset(
   283	    {".claude", ".github", "scripts", "SPEC", "PROTOCOL.md"}
   284	)
   285	
   286	
   287	def _import_is_canonical():  # type: ignore[no-untyped-def]
   288	    """Import check_canonical_edit._is_canonical, or None on failure."""
   289	    try:
   290	        import check_canonical_edit as _cce  # type: ignore
   291	        fn = getattr(_cce, "_is_canonical", None)
   292	        return fn if callable(fn) else None
   293	    except Exception:
   294	        return None
   295	
   296	
   297	def _is_l3_path(rel_path: str, repo_root: Path, is_canonical) -> bool:
   298	    """True if rel_path is an L3/canonical governed path.
   299	
   300	    Primary: check_canonical_edit._is_canonical (source of truth — the same
   301	    predicate the edit-time guard uses; its guard set is a superset covering
   302	    hooks/kernel/plans/ADRs/workflows). Fallback: first-segment prefix match.
   303	    """
   304	    if is_canonical is not None:
   305	        try:
   306	            return bool(is_canonical(str(repo_root / rel_path), repo_root))
   307	        except Exception:
   308	            pass
   309	    first_seg = rel_path.replace(os.sep, "/").split("/", 1)[0]
   310	    return first_seg in _FALLBACK_CANONICAL_PREFIXES
