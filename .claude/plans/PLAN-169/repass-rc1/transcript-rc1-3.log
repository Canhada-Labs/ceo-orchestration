    96	
    97	usage() {
    98	  # Header spans line 2 .. the "bash 3.2-safe" sentinel line (keep in sync).
    99	  # rail r2 (S337) P3: terminate at the sentinel, not at a line number — the
   100	  # header grows and a fixed range silently truncates the exit-code section.
   101	  sed -n '2,/^# bash 3\.2-safe/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
   102	}
   103	
   104	while [ $# -gt 0 ]; do
   105	  case "$1" in
   106	    --repair)          REPAIR=1; shift ;;
   107	    --dry-run)         DRY_RUN=1; shift ;;
   108	    --yes-file)
   109	      if [ -z "${2:-}" ]; then
   110	        echo "ERROR: --yes-file requires a relpath argument" >&2
   111	        exit 2
   112	      fi
   113	      YES_FILES="${YES_FILES}${2}
   114	"
   115	      shift 2 ;;
   116	    --yes-file=*)
   117	      YES_FILES="${YES_FILES}${1#--yes-file=}
   118	"
   119	      shift ;;
   120	    --profile)
   121	      if [ -z "${2:-}" ]; then
   122	        echo "ERROR: --profile requires a comma-separated list" >&2
   123	        exit 2
   124	      fi
   125	      PROFILE="$2"; shift 2 ;;
   126	    --profile=*)       PROFILE="${1#--profile=}"; shift ;;
   127	    --strict-orphans)  STRICT_ORPHANS=1; shift ;;
   128	    --no-orphan-scan)  NO_ORPHAN_SCAN=1; shift ;;
   129	    --verbose)         VERBOSE=1; shift ;;
   130	    -h|--help)         usage; exit 0 ;;
   131	    -*)
   132	      echo "ERROR: unknown option: $1" >&2
   133	      echo "Usage: $0 <target-repo-path> [--repair] [--dry-run] [--yes-file <rel>]..." >&2
   134	      exit 2 ;;
   135	    *)
   136	      if [ -n "$TARGET" ]; then
   137	        echo "ERROR: multiple target paths given ('$TARGET' and '$1')" >&2
   138	        exit 2
   139	      fi
   140	      TARGET="$1"; shift ;;
   141	  esac
   142	done
   143	
   144	if [ -z "$TARGET" ]; then
   145	  echo "Usage: $0 <target-repo-path> [--repair] [--dry-run] [--yes-file <rel>]..." >&2
   146	  exit 2
   147	fi
