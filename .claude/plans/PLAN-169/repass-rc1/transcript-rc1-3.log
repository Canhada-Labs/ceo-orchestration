   480	def snapshot_digest(snapshot: Dict[str, Any]) -> str:
   481	    """Material digest — excludes captured_at/cost so a pure clock tick never re-emits."""
   482	    material = {k: snapshot.get(k) for k in
   483	                ("plan_id", "worktree", "rate_limits", "model_id", "session_id")}
   484	    pct = snapshot.get("context_pct")
   485	    material["context_decile"] = (int(pct // 10)
   486	                                  if isinstance(pct, (int, float)) and not isinstance(pct, bool)
   487	                                  else None)
   488	    return hashlib.sha256(
   489	        json.dumps(material, sort_keys=True, default=str).encode("utf-8")).hexdigest()
