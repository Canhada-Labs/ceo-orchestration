  5624	    "schema": "ceo.install-state/v1",
  5625	    "schema_version": 1,
  5626	    "written_at": now,
  5627	    "first_recorded_at": first,
  5628	    "run_count": run_count,
  5629	    "tool": {"name": "upgrade.sh", "framework_version": fw_version},
  5630	    "request": req,
  5631	    "last_upgrade": {
  5632	        "at": now,
  5633	        "argv": up_argv,
  5634	        "profile": vals.get("profile", ""),
  5635	        "stack": vals.get("stack", ""),
  5636	        "on_conflict": vals.get("on_conflict", ""),
  5637	        "pin": vals.get("pin", ""),
  5638	        "replay_source": vals.get("replay_source", ""),
  5639	        "ceremony_effective": vals.get("ceremony_effective", ""),
  5640	    },
  5641	    "operations": ops,
  5642	    # rail round-3 F2: upgrade_succeeded is DERIVED from the deferred
  5643	    # route-delivery flag, never hardcoded True. route_delivery carries the
  5644	    # named reason so the record is triageable on its own.
  5645	    "result": {"upgrade_succeeded": _route_failed is not True,
