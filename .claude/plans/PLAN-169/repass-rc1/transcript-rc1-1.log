   862	      echo "          Proceeding with CLI/default flags on the ADR-155 path (baseline" >&2
   863	      echo "          drift-classifier; --dry-run previews). Never blocks (PLAN-153" >&2
   864	      echo "          debate C back-compat must-fix); a valid state file is rewritten" >&2
   865	      echo "          after this upgrade completes." >&2
   866	    fi
   867	  else
   868	    _REPLAY_SOURCE="fallback-no-state"
   869	    echo "    NOTE: no .claude/.install-state.json in target (pre-Wave-B install)." >&2
   870	    echo "          Proceeding with CLI/default flags on the ADR-155 path (baseline" >&2
   871	    echo "          drift-classifier when a manifest exists, else diff -q warn-then-" >&2
   872	    echo "          clobber). A state file is recorded after this upgrade completes." >&2
   873	  fi
   874	fi
