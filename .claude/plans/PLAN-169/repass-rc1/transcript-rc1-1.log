  1280	# $2 = record KIND, mirroring doctor.sh `_relpath_unsafe` (family sweep):
  1281	# "link" tolerates a symlinked LEAF, anything else (default "file") does not.
  1282	# A `LINK  <relpath>  <target>` record describes a --mode link delivery whose
  1283	# leaf IS a symlink by construction, so rejecting it here silently dropped the
  1284	# record from the sanitized manifest: _baseline_has_spec_record and both
  1285	# readlink-vs-recorded-target checks could then NEVER match, and every
  1286	# link-mode upgrade lost framework ownership of SPEC/v1 and the marker, with
  1287	# marker-first readers falling back to the stale root VERSION (codex W1
  1288	# round 6, P2). The leaf is never FOLLOWED here — validation stays at the
  1289	# consumers, which compare `readlink` against the recorded target. Hash
  1290	# records keep the strict leaf check: a managed regular file swapped for a
  1291	# symlink must not retain its record (_hash_file WOULD follow it). Symlinked
  1292	# PARENT components remain a genuine traversal hazard for both kinds.
  1293	_baseline_relpath_unsafe() {
  1294	  _bru_rel="$1"
  1295	  _bru_kind="${2:-file}"
  1296	  case "$_bru_rel" in
  1297	    /*) return 0 ;;                       # absolute
  1298	    *..*) return 0 ;;                      # parent traversal (covers ../ and /..)
  1299	  esac
  1300	  # Control chars / whitespace-only / empty.
  1301	  case "$_bru_rel" in
  1302	    ""|*[$'\n\r\t']*) return 0 ;;
  1303	  esac
  1304	  # Count the significant components first, so the leaf can be identified by
  1305	  # INDEX — reconstructing "$TARGET/$_bru_rel" for a leaf test would differ
  1306	  # from the walk on `./` and trailing-slash forms.
  1307	  _bru_n=0
  1308	  _bru_oldIFS="$IFS"
  1309	  IFS='/'
  1310	  for _bru_comp in $_bru_rel; do
  1311	    [ -n "$_bru_comp" ] || continue
  1312	    [ "$_bru_comp" = "." ] && continue
  1313	    _bru_n=$(( _bru_n + 1 ))
  1314	  done
  1315	  # Symlinked-component check: walk each path component under $TARGET; if any
  1316	  # EXISTING component is a symlink, reject (do not follow it).
  1317	  _bru_cur="$TARGET"
  1318	  _bru_i=0
  1319	  for _bru_comp in $_bru_rel; do
  1320	    [ -n "$_bru_comp" ] || continue
  1321	    [ "$_bru_comp" = "." ] && continue
  1322	    _bru_i=$(( _bru_i + 1 ))
  1323	    _bru_cur="$_bru_cur/$_bru_comp"
  1324	    if [ -L "$_bru_cur" ]; then
  1325	      if [ "$_bru_kind" = "link" ] && [ "$_bru_i" -eq "$_bru_n" ]; then
  1326	        continue                          # the LINK record's own leaf
  1327	      fi
  1328	      IFS="$_bru_oldIFS"
  1329	      return 0
  1330	    fi
  1331	  done
  1332	  IFS="$_bru_oldIFS"
  1333	  return 1
  1334	}
  1335	
  1336	# Load + sanitize the baseline manifest. On any problem (absent / unreadable /
  1337	# empty after sanitization) leaves _BASELINE_MANIFEST_FILE empty => fallback.
  1338	_load_baseline_manifest() {
  1339	  [ -f "$_BASELINE_MANIFEST_RAW" ] && [ -r "$_BASELINE_MANIFEST_RAW" ] || return 0
  1340	  command -v _hash_file >/dev/null 2>&1 || return 0
  1341	
  1342	  # PLAN-161 U1: the sanitized manifest used to be mktemp'd INSIDE $BAK_DIR —
  1343	  # a write inside the target even under --dry-run (and the reason dry-run
  1344	  # could not keep classification alive once BAK_DIR creation was gated). It
  1345	  # now lives in a secure temp OUTSIDE $TARGET in ALL runs; the composed
  1346	  # _upgrade_cleanup EXIT trap reaps it via the _BASELINE_TMP_FILE global.
  1347	  #
  1348	  # PLAN-161 U1 (codex r1 F5): "outside $TARGET" must hold even when the
  1349	  # CALLER's TMPDIR is $TARGET or lies under it — otherwise --dry-run writes
  1350	  # in the target again. That check was BORN here and, as of rail round-5 F3,
  1351	  # lives in _up_tmpbase (:641) so every scratch file this script takes gets
  1352	  # the same answer — the round-5 finding was a NEW mktemp that did not
  1353	  # inherit it. If the base cannot be resolved (nonexistent), mktemp fails
  1354	  # below and we return 0 (the existing no-manifest fallback).
  1355	  local _lbm_base
  1356	  _lbm_base="$( _up_tmpbase )"
  1357	  local sanitized
  1358	  sanitized="$( mktemp "$_lbm_base/ceo-baseline-manifest.XXXXXX" 2>/dev/null )" || return 0
  1359	  _BASELINE_TMP_FILE="$sanitized"
  1360	
  1361	  local line rest rel digest target
  1362	  # Read line-by-line; NEVER `eval` or interpret manifest content.
  1363	  while IFS= read -r line || [ -n "$line" ]; do
  1364	    [ -n "$line" ] || continue
  1365	    # Hash record: ^<64hex><2 spaces><relpath>$
  1366	    # Link record: ^LINK<2 spaces><relpath><2 spaces><target>$
  1367	    case "$line" in
  1368	      LINK\ \ *)
  1369	        rest="${line#LINK  }"
  1370	        # relpath is everything up to the FIRST double-space; target the rest.
  1371	        case "$rest" in
  1372	          *"  "*)
  1373	            rel="${rest%%  *}"
  1374	            target="${rest#*  }"
  1375	            ;;
  1376	          *) continue ;;   # malformed LINK (no target) — drop
  1377	        esac
  1378	        # KIND=link: the leaf of a LINK record IS a symlink by construction
  1379	        # (codex W1 round 6, P2). Symlinked PARENTS still reject.
  1380	        if _baseline_relpath_unsafe "$rel" link; then continue; fi
  1381	        # Duplicate relpath? Ambiguous provenance — invalidate the relpath
  1382	        # ENTIRELY (not first-wins): the lookup will refuse it -> fallback.
  1383	        case "$_BASELINE_DUP_GUARD" in
  1384	          *"
  1385	$rel
  1386	"*)
  1387	            case "$_BASELINE_INVALID" in
  1388	              *"
  1389	$rel
  1390	"*) ;;
  1391	              *) _BASELINE_INVALID="$_BASELINE_INVALID
  1392	$rel
  1393	" ;;
  1394	            esac
  1395	            continue ;;
  1396	        esac
  1397	        _BASELINE_DUP_GUARD="$_BASELINE_DUP_GUARD
  1398	$rel
  1399	"
  1400	        # Re-emit a normalized LINK record (target sanitized of control chars).
  1401	        case "$target" in
  1402	          *[$'\n\r\t']*) continue ;;
  1403	        esac
  1404	        printf 'LINK  %s  %s\n' "$rel" "$target" >> "$sanitized"
  1405	        ;;
  1406	      *)
  1407	        # Must be exactly 64-hex, two spaces, then relpath.
  1408	        digest="${line%%  *}"
  1409	        rel="${line#*  }"
  1410	        # Guard: the split must have actually found a double-space separator.
  1411	        [ "$digest" != "$line" ] || continue
  1412	        case "$digest" in
  1413	          [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
  1414	          *) continue ;;   # not a 64-hex digest — drop (provenance)
  1415	        esac
  1416	        if _baseline_relpath_unsafe "$rel"; then continue; fi
  1417	        # Duplicate relpath? Ambiguous provenance — invalidate ENTIRELY
  1418	        # (not first-wins): the lookup refuses it -> fallback. (Codex R1 P0#2)
  1419	        case "$_BASELINE_DUP_GUARD" in
  1420	          *"
  1421	$rel
  1422	"*)
  1423	            case "$_BASELINE_INVALID" in
  1424	              *"
  1425	$rel
  1426	"*) ;;
  1427	              *) _BASELINE_INVALID="$_BASELINE_INVALID
  1428	$rel
  1429	" ;;
  1430	            esac
  1431	            continue ;;
  1432	        esac
  1433	        _BASELINE_DUP_GUARD="$_BASELINE_DUP_GUARD
  1434	$rel
  1435	"
  1436	        printf '%s  %s\n' "$digest" "$rel" >> "$sanitized"
  1437	        ;;
  1438	    esac
  1439	  done < "$_BASELINE_MANIFEST_RAW"
  1440	
  1441	  if [ -s "$sanitized" ]; then
  1442	    _BASELINE_MANIFEST_FILE="$sanitized"
  1443	  else
  1444	    rm -f "$sanitized" 2>/dev/null || true
  1445	  fi
  1446	  return 0
  1447	}
  1448	
  1449	# Echo the baseline digest for $1 if (and only if) it is a validated HASH
  1450	# record. A LINK record or an absent line echoes nothing + returns 1 => the
  1451	# caller falls back. Exact relpath match (the part after the two-space
  1452	# separator must equal $1 exactly). awk does the exact match + 64-hex check in
  1453	# one pass — no fragile nested while/case under set -u.
  1454	_baseline_lookup() {
  1455	  _bl_rel="$1"
  1456	  [ -n "$_BASELINE_MANIFEST_FILE" ] || return 1
  1457	  [ -f "$_BASELINE_MANIFEST_FILE" ] || return 1
  1458	  # Refuse a relpath flagged as duplicate/ambiguous during load (Codex R1 P0#2):
  1459	  # never trust a baseline digest for a relpath that appeared more than once.
  1460	  case "$_BASELINE_INVALID" in
  1461	    *"
  1462	$_bl_rel
  1463	"*) return 1 ;;
  1464	  esac
  1465	  _bl_digest="$( awk -v want="$_bl_rel" '
  1466	    {
  1467	      # Split on the FIRST double-space: field1 = digest-or-LINK, rest = path[+target].
  1468	      idx = index($0, "  ");
  1469	      if (idx == 0) next;
  1470	      d = substr($0, 1, idx - 1);
  1471	      rest = substr($0, idx + 2);
  1472	      if (d == "LINK") next;                 # link record: no content baseline
  1473	      # rest must equal the wanted relpath exactly (hash records have no 2nd
  1474	      # double-space: relpath runs to EOL).
  1475	      if (rest != want) next;
  1476	      if (length(d) != 64) next;
  1477	      if (d ~ /^[0-9a-f]+$/) { print d; exit 0 }
  1478	    }
  1479	  ' "$_BASELINE_MANIFEST_FILE" 2>/dev/null )"
  1480	  [ -n "$_bl_digest" ] || return 1
  1481	  printf '%s\n' "$_bl_digest"
  1482	}
  1483	
  1484	# Classify a single repo-relative file against the baseline. Echoes ONE verdict:
  1485	#   FRAMEWORK-CHANGED  H_dst==H_base && H_src!=H_base  -> safe to auto-update
  1486	#   ADOPTER-CUSTOMIZED H_dst!=H_base && H_src==H_base  -> preserve
  1487	#   CONFLICT           both differ from H_base         -> --on-conflict
  1488	#   IDENTICAL          H_dst==H_src                    -> nothing to do
  1489	#   FALLBACK           no usable baseline / hasher      -> today's behavior
  1490	# H_dst and H_src are BOTH recomputed from disk THIS run (never cached H_src).
  1491	_classify_against_baseline() {
  1492	  _cab_rel="$1"
  1493	  command -v _hash_file >/dev/null 2>&1 || { printf 'FALLBACK\n'; return 0; }
  1494	  _cab_base="$( _baseline_lookup "$_cab_rel" )" || { printf 'FALLBACK\n'; return 0; }
  1495	  _cab_dst="$( _hash_file "$TARGET/$_cab_rel" 2>/dev/null || true )"
  1496	  _cab_src="$( _hash_file "$SOURCE_DIR/$_cab_rel" 2>/dev/null || true )"
  1497	  # If either side cannot be hashed (missing file), fall back to legacy handling.
  1498	  if [ -z "$_cab_dst" ] || [ -z "$_cab_src" ]; then
  1499	    printf 'FALLBACK\n'; return 0
  1500	  fi
  1501	  if [ "$_cab_dst" = "$_cab_src" ]; then
  1502	    printf 'IDENTICAL\n'; return 0
  1503	  fi
  1504	  if [ "$_cab_dst" = "$_cab_base" ] && [ "$_cab_src" != "$_cab_base" ]; then
  1505	    printf 'FRAMEWORK-CHANGED\n'; return 0
  1506	  fi
  1507	  if [ "$_cab_dst" != "$_cab_base" ] && [ "$_cab_src" = "$_cab_base" ]; then
  1508	    printf 'ADOPTER-CUSTOMIZED\n'; return 0
  1509	  fi
  1510	  # Both differ from the baseline.
  1511	  printf 'CONFLICT\n'; return 0
  1512	}
  1513	
  1514	_load_baseline_manifest
  1515	
  1516	# PLAN-161 U1 (codex r1 F4) — manifest-load observability. Byte-identity alone
  1517	# cannot prove a --dry-run kept provenance classification alive (a dry-run
  1518	# that silently lost the baseline would also write nothing), so EVERY run
  1519	# states which classification mode it operates in.
  1520	if [ -n "$_BASELINE_MANIFEST_FILE" ]; then
  1521	  echo "==> Baseline manifest: loaded (provenance classification ACTIVE)"
  1522	else
  1523	  echo "==> Baseline manifest: none — fallback diff -q classification"
  1524	fi
  1525	
  1526	# F-CHAOS-3: emit a diff-q-style WARNING line for every adopter file
  1527	# that differs from the source before we overwrite it. Recurses into
  1528	# directories. Respects --no-diff-warn and --skip globs.
  1529	_emit_diff_warnings() {
  1530	  local rel_path="$1"
  1531	  local src="$SOURCE_DIR/$rel_path"
  1532	  local dst="$TARGET/$rel_path"
  1533	
  1534	  [[ "$DIFF_WARN" -eq 1 ]] || return 0
  1535	  [[ -e "$dst" && -e "$src" ]] || return 0
  1536	
  1537	  if [[ -d "$src" && -d "$dst" ]]; then
  1538	    # Per-file diff within the directory
  1539	    local f rel sub
  1540	    while IFS= read -r f; do
  1541	      [[ -n "$f" ]] || continue
  1542	      sub="${f#$dst/}"
  1543	      rel="$rel_path/$sub"
  1544	      if _path_is_skipped "$rel"; then
  1545	        echo "    SKIP-DIFF (--skip): $rel" >&2
  1546	        continue
  1547	      fi
  1548	      if [[ -f "$SOURCE_DIR/$rel" ]]; then
  1549	        if ! diff -q "$f" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
  1550	          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN" >&2
  1551	          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
  1552	        fi
  1553	      fi
  1554	    done < <(find "$dst" -type f 2>/dev/null)
  1555	  elif [[ -f "$src" && -f "$dst" ]]; then
  1556	    if _path_is_skipped "$rel_path"; then
  1557	      echo "    SKIP-DIFF (--skip): $rel_path" >&2
  1558	      return 0
  1559	    fi
  1560	    if ! diff -q "$dst" "$src" >/dev/null 2>&1; then
  1561	      echo "    WARNING: adopter customization in $rel_path will be OVERWRITTEN" >&2
  1562	      echo "             (backup preserved in $BAK_DIR/$rel_path)" >&2
  1563	    fi
  1564	  fi
  1565	}
  1566	
  1567	# PLAN-138 Wave C (ADR-155): update ONE file under a classified directory walk.
  1568	# $1 = repo-relative file path. Backs up the dst file then copies src over it.
  1569	# Used by _per_file_classified_update for the FRAMEWORK-CHANGED / theirs / backup
  1570	# branches. find+delete idiom is unnecessary for a single file (plain cp).
  1571	_apply_single_file() {
  1572	  local rel="$1"
  1573	  local s="$SOURCE_DIR/$rel"
  1574	  local d="$TARGET/$rel"
  1575	  local b="$BAK_DIR/$rel"
  1576	  [[ -f "$s" ]] || return 0
  1577	  if [[ -e "$d" ]]; then
  1578	    mkdir -p "$( dirname "$b" )"
  1579	    cp "$d" "$b" 2>/dev/null || true
  1580	  fi
  1581	  mkdir -p "$( dirname "$d" )"
  1582	  cp "$s" "$d"
  1583	}
  1584	
  1585	# PLAN-138 Wave C (ADR-155): per-file walk of a DIRECTORY target driven by the
  1586	# baseline classifier. Replaces the whole-tree delete+cp -R when a baseline
  1587	# manifest is loaded, so an adopter customization INSIDE a directory is
  1588	# preserved/refused per-file instead of being wiped. The union of source + dst
  1589	# files is walked so framework-added files land and removed-from-source files
  1590	# are reported (never auto-deleted — destructive removals stay manual).
  1591	_per_file_classified_update() {
  1592	  local rel_dir="$1"
  1593	  local sdir="$SOURCE_DIR/$rel_dir"
  1594	  local ddir="$TARGET/$rel_dir"
  1595	  local listing rel verdict
  1596	  # Build the union of relpaths under src + dst (regular files only).
  1597	  listing="$( {
  1598	    [[ -d "$sdir" ]] && find "$sdir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$SOURCE_DIR"/}"; done
  1599	    [[ -d "$ddir" ]] && find "$ddir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$TARGET"/}"; done
  1600	  } | LC_ALL=C sort -u )"
  1601	
  1602	  printf '%s\n' "$listing" | while IFS= read -r rel; do
  1603	    [[ -n "$rel" ]] || continue
  1604	    # PLAN-161 U2 (CF-7): the canonical framework-internal exclusion set —
  1605	    # never install, never re-add after an adopter deletes, never report.
  1606	    # Silent skip; the opt-in U3 purge is the ONLY code allowed to touch
  1607	    # these paths (and only hash-gated).
  1608	    if command -v _framework_path_excluded >/dev/null 2>&1 && _framework_path_excluded "$rel"; then
  1609	      continue
  1610	    fi
  1611	    if _path_is_skipped "$rel"; then
  1612	      echo "    SKIPPED (--skip): $rel"
  1613	      continue
  1614	    fi
  1615	    # Source-removed file: present at dst, absent at src. Report, never delete.
  1616	    if [[ ! -f "$SOURCE_DIR/$rel" ]]; then
  1617	      echo "    KEPT (no longer shipped by framework — not removed): $rel" >&2
  1618	      continue
  1619	    fi
  1620	    # New framework file: absent at dst. Just install it.
  1621	    if [[ ! -f "$TARGET/$rel" ]]; then
  1622	      _apply_single_file "$rel"
  1623	      echo "    ADDED: $rel"
  1624	      continue
  1625	    fi
  1626	    verdict="$( _classify_against_baseline "$rel" )"
  1627	    case "$verdict" in
  1628	      IDENTICAL)
  1629	        : ;;  # nothing to do
  1630	      FRAMEWORK-CHANGED)
  1631	        # Quiet auto-update is the intended path (dst matched the recorded
  1632	        # baseline => the adopter had not customized this file). BUT the manifest
  1633	        # is UNSIGNED/target-side (OQ-trust): a tampered line where H_base==H_dst
  1634	        # would mis-classify a customized file into this branch. We cannot detect
  1635	        # that without a signed manifest, so per Codex R1 P0#1 this is downgraded
  1636	        # to NON-SILENT: _apply_single_file always backs up the original first,
  1637	        # and we surface the overwrite + backup location on stderr (recoverable
  1638	        # AND visible — worst case equals today's warn-then-clobber).
  1639	        _apply_single_file "$rel"
  1640	        echo "    UPDATED (framework-changed; unsigned baseline — original backed up to $BAK_DIR/$rel): $rel" >&2
  1641	        ;;
  1642	      ADOPTER-CUSTOMIZED)
  1643	        echo "    PRESERVED (ADOPTER-CUSTOMIZED — not overwritten): $rel" >&2
  1644	        ;;
  1645	      CONFLICT)
  1646	        case "$ON_CONFLICT" in
  1647	          theirs)
  1648	            _apply_single_file "$rel"
  1649	            echo "    OVERWROTE (CONFLICT, --on-conflict=theirs): $rel" >&2
  1650	            ;;
  1651	          backup)
  1652	            _apply_single_file "$rel"
  1653	            echo "    OVERWROTE (CONFLICT, --on-conflict=backup; original in $BAK_DIR/$rel): $rel" >&2
  1654	            ;;
  1655	          *)  # refuse (default): per-file skip-and-report-and-CONTINUE
  1656	            echo "    REFUSED (CONFLICT, --on-conflict=refuse — not overwritten): $rel" >&2
  1657	            ;;
  1658	        esac
  1659	        ;;
  1660	      FALLBACK|*)
  1661	        # No usable baseline for this file — today's diff -q warn-then-clobber.
  1662	        if [[ "$DIFF_WARN" -eq 1 ]] && ! diff -q "$TARGET/$rel" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
  1663	          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN (no baseline)" >&2
  1664	          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
  1665	        fi
  1666	        _apply_single_file "$rel"
  1667	        echo "    UPDATED (fallback): $rel"
  1668	        ;;
  1669	    esac
  1670	  done
  1671	}
  1672	
  1673	# PLAN-161 W2 fix-3 (codex r3 F11a): TRUE (rc 0) iff any STRICT ancestor
  1674	# component of relpath $2 under root $1 is a symlink. A preserved excluded
  1675	# SYMLINK must be an opaque leaf: a -f/-d/-L test (or rm/rmdir) on a path
  1676	# that runs THROUGH it resolves into the link TARGET, so an unguarded
  1677	# prune could delete adopter data OUTSIDE the tree. Every prune-side
  1678	# test/delete on "$TARGET/$rel" must first pass this lstat-walk guard.
  1679	# bash 3.2-safe: pure string splitting, [[ -L ]] never follows the leaf.
  1680	_lg_ancestor_is_symlink() {
  1681	  local _as_root="$1" _as_rel="$2" _as_walk=""
  1682	  while [[ "$_as_rel" == */* ]]; do
  1683	    _as_walk="${_as_walk:+$_as_walk/}${_as_rel%%/*}"
  1684	    _as_rel="${_as_rel#*/}"
  1685	    if [[ -L "$_as_root/$_as_walk" ]]; then return 0; fi
  1686	  done
  1687	  return 1
  1688	}
  1689	
  1690	backup_and_replace() {
  1691	  local rel_path="$1"
  1692	  local src="$SOURCE_DIR/$rel_path"
  1693	  local dst="$TARGET/$rel_path"
  1694	  local bak="$BAK_DIR/$rel_path"
  1695	
  1696	  if [[ ! -e "$src" ]]; then
