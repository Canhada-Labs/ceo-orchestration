223:# PLAN-153 Wave B item B2 — capture the ORIGINAL upgrade argv verbatim BEFORE
224:# parsing, for the post-upgrade state record (data only, never eval-ed).
225:ORIG_UP_ARGV=( "$@" )
226:
227:TARGET=""
228:PROFILE="core,frontend"
229:STACK="none"
230:PIN_REF=""
231:DRY_RUN=0
232:PURGE_MISINSTALLED=0   # PLAN-161 U3: opt-in hash-gated purge of mis-installed framework-internal files
233:DIFF_WARN=1
234:DEPRECATION_WARN=1
235:SETTINGS_MERGE=1
236:SETTINGS_MIGRATE=1       # PLAN-163 T5.4: baseline-aware settings migration (opt out: --no-settings-migrate)
237:SETTINGS_MIGRATE_ONLY=0  # PLAN-163 T5.4: run ONLY the settings migration (test/ops seam)
238:ON_CONFLICT="refuse"   # PLAN-138 Wave C (ADR-155): {refuse|theirs|backup}; default refuse (OQ2)
239:REPLAY=1               # PLAN-153 Wave B item B2: replay the recorded install request (opt out: --no-replay)
240:HARNESS=""             # PLAN-155 Wave 5: "" = infer from recorded request.harness (B2 mirror)
241:HARNESS_EXPLICIT=0     # explicit --harness always beats a replayed value
242:CODEX_MANAGED_HOOKS=0  # replayed from request.managed_hooks unless --managed-hooks
243:# shellcheck disable=SC2034  # CODEX_WITH_SKILLS/CODEX_FORCE consumed by the sourced _codex_harness.sh
244:CODEX_WITH_SKILLS=0
245:# shellcheck disable=SC2034
246:CODEX_FORCE=0          # upgrade derives this from --on-conflict for the codex refresh
247:PROFILE_EXPLICIT=0      # PLAN-153 B2: explicit --profile always beats a replayed value
248:STACK_EXPLICIT=0        # PLAN-153 B2: explicit --stack always beats a replayed value
249:SKIP_GLOBS=()
