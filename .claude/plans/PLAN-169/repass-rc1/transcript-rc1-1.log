   228	PROFILE="core,frontend"
   229	STACK="none"
   230	PIN_REF=""
   231	DRY_RUN=0
   232	PURGE_MISINSTALLED=0   # PLAN-161 U3: opt-in hash-gated purge of mis-installed framework-internal files
