4188:
4189:# DevOps-P1-4: PROTOCOL.md is framework-derived (pointer), not user data —
4190:# refresh it so it stays aligned with the current source layout.
4191:# PLAN-166 F3 (ADR-155-AMEND-1): CEREMONY-GATED — the refresh used to run
4192:# unconditionally and `cat >`-created a root PROTOCOL.md that a
4193:# `--ceremony user` install deliberately never has (install.sh
4194:# WS4-guard-proto forbids root files); the F4 tree-comparison e2e exposes
4195:# exactly this divergence (r7/r13). The gate reads the ceremony from
4196:# .claude/.install-state.json via the replay-independent reader above.
4197:_PROTOCOL_DELIVERED=0
4198:echo ""
4199:echo "==> Refreshing PROTOCOL.md pointer"
4200:if [[ "$CEREMONY_EFFECTIVE" == "user" ]]; then
4201:  echo "    SKIP: PROTOCOL.md pointer (recorded --ceremony user install — a user install never creates root files, WS4; r13)"
4202:  # Ownership continuity on the analogous skip (codex W1 round 7, P2) — see
4203:  # the SPEC/v1 ceremony skip: preserving the tree while erasing its record
4204:  # strands a framework-delivered pointer as unowned.
4205:  #
4206:  # But the flag alone is NOT enough (codex W1 round 9, P1): this skip never
4207:  # runs _refresh_protocol_pointer, so _REFRESH_PROTOCOL_CANON_HASH stays
4208:  # empty, and _write_baseline_manifest then hashes the LIVE pointer —
4209:  # re-recording an adopter-CUSTOMIZED PROTOCOL.md as the framework baseline,
4210:  # which the next upgrade overwrites and uninstall can DELETE. Retaining
4211:  # ownership must never retain the wrong bytes. Carry the PRIOR canonical
4212:  # digest; a LINK record needs none (the link branch of the rewrite fires
4213:  # before the PROTOCOL special case). When neither is available, DROP the
4214:  # claim — the pointer stays adopter-owned and preserved, which is the
4215:  # pre-continuity behaviour and loses nothing.
4216:  if _baseline_has_protocol_record; then
4217:    _REFRESH_PROTOCOL_CANON_HASH="$( _baseline_lookup "PROTOCOL.md" 2>/dev/null || true )"
4218:    if [[ -n "$_REFRESH_PROTOCOL_CANON_HASH" ]] \
4219:       || grep -Eq '^LINK  PROTOCOL\.md(  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
4220:      _PROTOCOL_DELIVERED=1
4221:    else
4222:      echo "    NOTE: PROTOCOL.md delivery record present but its canonical digest is" >&2
4223:      echo "          unrecoverable (ambiguous record) — ownership NOT claimed; the" >&2
4224:      echo "          pointer stays adopter-owned and preserved" >&2
4225:    fi
4226:  fi
4227:else
4228:  # _refresh_protocol_pointer sets _PROTOCOL_DELIVERED itself, from the
4229:  # VERDICT. Forcing it to 1 here overrode a PRESERVE_UNOWNED decision and
4230:  # recorded an adopter's own pre-existing PROTOCOL.md as framework-owned —
4231:  # a caller computing the right answer and then ignoring it (codex W3 r1 P1).
4232:  _refresh_protocol_pointer
4233:fi
