3742:# ===========================================================================
3743:# PLAN-161 U3 — opt-in hash-gated purge of mis-installed framework-internal
3744:# files (--purge-misinstalled; OQ1 Owner-ratified; ADR-155 Amendment).
3745:# ---------------------------------------------------------------------------
3746:# The 2026-07-21 adopter upgrade (bug 2b) shipped the framework's OWN dogfood
3747:# test trees (~967 files) into adopters. U2 stops the (re)install; this scan
3748:# is the cleanup for residue already present:
3749:#   * NOMINATION is a hardcoded walk of the excluded TREES + 2 files under
3750:#     $TARGET only — NEVER manifest-driven (an unsigned manifest must never
3751:#     be able to nominate arbitrary paths for deletion).
3752:#   * lstat/no-follow: find WITHOUT -L; symlinks are reported + skipped.
3753:#   * Relpaths pass the manifest-grade sanitizer (_baseline_relpath_unsafe);
3754:#     anything unsafe is kept + warned, never purged.
3755:#   * AUTHORIZATION per candidate: sha256(target file) equals the CURRENT
3756:#     framework source bytes at the SAME relpath, OR equals the recorded
3757:#     target-manifest baseline digest for that rel (_baseline_lookup). A
3758:#     byte-identical copy at a DIFFERENT relpath is NEVER authorized.
3759:#     Neither match => keep + warn.
3760:#   * Default (flag absent) and ALL --dry-run runs: preview only ('would
3761:#     PURGE' lines + a --purge-misinstalled hint). Deletion requires the
3762:#     explicit flag on a non-dry run, is backed up first (cp -P into
3763:#     $BAK_DIR/<rel>), and a second run is a no-op (nothing authorized left).
3764:# ===========================================================================
3765:_PM_AUTH_COUNT=0
3766:_PM_PURGED_COUNT=0
3767:
3768:# PLAN-161 U3 (codex r4 F2): find(1) resolves its COMMAND-LINE path through
3769:# symlinked ANCESTORS even without -L — only descent below the start point is
3770:# no-follow. So a nominated excluded tree whose ancestor (e.g. .claude/hooks
3771:# preserved via --skip as an adopter symlink) is a symlink would be walked —
3772:# and, once any purge elsewhere makes _PM_PURGED_COUNT positive, rmdir'd —
3773:# INSIDE the symlink's external target. Guard: before any find/rmdir over a
3774:# nominated path, walk every component from $TARGET down to the leaf with a
3775:# per-component lstat (same idiom as _baseline_relpath_unsafe) and refuse the
3776:# whole tree when ANY component is a symlink. On hit, prints the first
3777:# symlinked component's target-relative path to stdout and returns 0; returns
3778:# 1 when the component chain is symlink-free. bash-3.2-safe (IFS walk).
3779:_purge_tree_symlinked_component() {
3780:  _pts_rel="$1"
3781:  _pts_cur="$TARGET"
3782:  _pts_relcur=""
3783:  _pts_oldIFS="$IFS"
3784:  IFS='/'
3785:  for _pts_comp in $_pts_rel; do
3786:    [ -n "$_pts_comp" ] || continue
3787:    [ "$_pts_comp" = "." ] && continue
3788:    _pts_cur="$_pts_cur/$_pts_comp"
3789:    if [ -n "$_pts_relcur" ]; then
3790:      _pts_relcur="$_pts_relcur/$_pts_comp"
3791:    else
3792:      _pts_relcur="$_pts_comp"
3793:    fi
3794:    if [ -L "$_pts_cur" ]; then
3795:      IFS="$_pts_oldIFS"
3796:      printf '%s\n' "$_pts_relcur"
3797:      return 0
3798:    fi
3799:  done
3800:  IFS="$_pts_oldIFS"
3801:  return 1
3802:}
3803:
3804:# Evaluate ONE nominated candidate relpath (already lstat-screened as a
3805:# regular file by the caller). Prints exactly one verdict line.
3806:_purge_consider_one() {
3807:  local _pc_rel="$1"
3808:  local _pc_dst="$TARGET/$_pc_rel"
3809:  local _pc_h_dst="" _pc_h_src="" _pc_h_base="" _pc_auth=0
3810:  if _baseline_relpath_unsafe "$_pc_rel"; then
3811:    echo "    KEPT (excluded-tree file outside provenance rails — not purged): $_pc_rel"
3812:    return 0
3813:  fi
3814:  _pc_h_dst="$( _hash_file "$_pc_dst" 2>/dev/null || true )"
3815:  if [[ -n "$_pc_h_dst" && -f "$SOURCE_DIR/$_pc_rel" && ! -L "$SOURCE_DIR/$_pc_rel" ]]; then
3816:    _pc_h_src="$( _hash_file "$SOURCE_DIR/$_pc_rel" 2>/dev/null || true )"
3817:  fi
3818:  _pc_h_base="$( _baseline_lookup "$_pc_rel" 2>/dev/null || true )"
3819:  if [[ -n "$_pc_h_dst" && -n "$_pc_h_src" && "$_pc_h_dst" == "$_pc_h_src" ]]; then
3820:    _pc_auth=1
3821:  elif [[ -n "$_pc_h_dst" && -n "$_pc_h_base" && "$_pc_h_dst" == "$_pc_h_base" ]]; then
3822:    _pc_auth=1
3823:  fi
3824:  if [[ "$_pc_auth" -ne 1 ]]; then
3825:    echo "    KEPT (excluded-tree file outside provenance rails — not purged): $_pc_rel"
3826:    return 0
3827:  fi
3828:  _PM_AUTH_COUNT=$(( _PM_AUTH_COUNT + 1 ))
3829:  if [[ "$PURGE_MISINSTALLED" -eq 1 && "$DRY_RUN" -eq 0 ]]; then
3830:    # PLAN-161 U3 (codex r1 F6): every filesystem step here is per-candidate
3831:    # guarded — under `set -e` an unguarded mkdir/cp/rm permission error would
3832:    # abort the WHOLE upgrade mid-purge. Backup failure => KEPT (never delete
3833:    # without a good backup); delete failure AFTER a good backup => warn +
3834:    # continue. The purge scan never changes the upgrade exit status.
3835:    if ! mkdir -p "$( dirname "$BAK_DIR/$_pc_rel" )" 2>/dev/null; then
3836:      echo "    KEPT (backup dir create failed — not purged): $_pc_rel" >&2
3837:      return 0
3838:    fi
3839:    if ! cp -P "$_pc_dst" "$BAK_DIR/$_pc_rel" 2>/dev/null; then
3840:      echo "    KEPT (backup copy failed — not purged): $_pc_rel" >&2
3841:      return 0
3842:    fi
3843:    if ! rm -f "$_pc_dst" 2>/dev/null; then
3844:      echo "    KEPT (delete failed after backup — file left in place): $_pc_rel" >&2
3845:      return 0
3846:    fi
3847:    _up_record_op "purge_misinstalled" "$_pc_rel"
3848:    echo "    PURGED (mis-installed framework-internal; backup in $BAK_DIR/$_pc_rel): $_pc_rel"
3849:    _PM_PURGED_COUNT=$(( _PM_PURGED_COUNT + 1 ))
3850:  else
3851:    echo "    would PURGE (mis-installed framework-internal): $_pc_rel"
3852:  fi
3853:  return 0
3854:}
3855:
3856:_purge_misinstalled_scan() {
3857:  if ! command -v _hash_file >/dev/null 2>&1; then
3858:    echo "    NOTE: mis-install scan skipped — hash helpers not sourced (fail-open)" >&2
3859:    return 0
3860:  fi
3861:  local _pm_trees=( ".claude/hooks/tests" ".claude/hooks/legacy" ".claude/scripts/tests" ".claude/hooks/_lib/tests" )
3862:  local _pm_files=( ".claude/hooks/_lib/test_isolation.py" ".claude/hooks/_lib/testing.py" )
3863:  local _pm_t _pm_cand _pm_rel _pm_link
3864:  _PM_AUTH_COUNT=0
3865:  _PM_PURGED_COUNT=0
3866:
3867:  for _pm_t in "${_pm_trees[@]}"; do
3868:    # codex r4 F2: refuse the whole tree when ANY component from $TARGET down
3869:    # to the leaf is a symlink — never hand find(1) a path it would resolve
3870:    # through a symlinked ancestor into an external target.
3871:    _pm_link="$( _purge_tree_symlinked_component "$_pm_t" )" || _pm_link=""
3872:    if [[ -n "$_pm_link" ]]; then
3873:      if [[ "$_pm_link" == "$_pm_t" ]]; then
3874:        echo "    KEPT (symlink in excluded tree — never followed): $_pm_t"
3875:      else
3876:        echo "    KEPT (symlinked ancestor '$_pm_link' — tree never walked): $_pm_t"
3877:      fi
3878:      continue
3879:    fi
3880:    [[ -d "$TARGET/$_pm_t" ]] || continue
3881:    while IFS= read -r _pm_cand; do
3882:      [[ -n "$_pm_cand" ]] || continue
3883:      _pm_rel="${_pm_cand#"$TARGET"/}"
3884:      if [[ -L "$_pm_cand" ]]; then
3885:        echo "    KEPT (symlink in excluded tree — never followed): $_pm_rel"
3886:        continue
3887:      fi
3888:      _purge_consider_one "$_pm_rel"
3889:    done < <( find "$TARGET/$_pm_t" \( -type f -o -type l \) -print 2>/dev/null | LC_ALL=C sort )
3890:  done
3891:  for _pm_rel in "${_pm_files[@]}"; do
3892:    # codex r4 F2: same ancestor guard for the two nominated single files —
3893:    # `-L`/`-f` on the full path would themselves resolve through a symlinked
3894:    # ancestor (e.g. .claude/hooks -> external).
3895:    _pm_link="$( _purge_tree_symlinked_component "$_pm_rel" )" || _pm_link=""
3896:    if [[ -n "$_pm_link" ]]; then
3897:      if [[ "$_pm_link" == "$_pm_rel" ]]; then
3898:        echo "    KEPT (symlink in excluded tree — never followed): $_pm_rel"
3899:      else
3900:        echo "    KEPT (symlinked ancestor '$_pm_link' — file never touched): $_pm_rel"
3901:      fi
3902:      continue
3903:    fi
3904:    [[ -f "$TARGET/$_pm_rel" ]] || continue
3905:    _purge_consider_one "$_pm_rel"
3906:  done
3907:
3908:  if [[ "$_PM_PURGED_COUNT" -gt 0 ]]; then
3909:    # Remove the now-empty excluded dirs, children before parents. rmdir
3910:    # only — a dir still holding adopter-owned (kept) files simply stays.
3911:    # codex r4 F2: re-check the component chain HERE too (not only at
3912:    # nomination) — the sweep must never rmdir through a symlinked ancestor
3913:    # into an external target. Silent skip: the KEPT line already printed
3914:    # during nomination.
3915:    for _pm_t in "${_pm_trees[@]}"; do
3916:      if _purge_tree_symlinked_component "$_pm_t" >/dev/null; then
3917:        continue
3918:      fi
3919:      [[ -d "$TARGET/$_pm_t" && ! -L "$TARGET/$_pm_t" ]] || continue
3920:      while IFS= read -r _pm_cand; do
3921:        [[ -n "$_pm_cand" ]] || continue
3922:        rmdir "$_pm_cand" 2>/dev/null || true
3923:      done < <( find "$TARGET/$_pm_t" -depth -type d -print 2>/dev/null )
3924:    done
3925:  fi
3926:  if [[ "$_PM_AUTH_COUNT" -gt 0 && "$PURGE_MISINSTALLED" -eq 0 ]]; then
3927:    echo "    HINT: $_PM_AUTH_COUNT hash-authorized mis-installed file(s) found — re-run with --purge-misinstalled to delete them (each is backed up to .claude.bak/ first)."
3928:  fi
3929:  if [[ "$_PM_AUTH_COUNT" -eq 0 && "$_PM_PURGED_COUNT" -eq 0 ]]; then
3930:    echo "    clean: no hash-authorized mis-installed framework-internal files"
3931:  fi
3932:  return 0
3933:}
