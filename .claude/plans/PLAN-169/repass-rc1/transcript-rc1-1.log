3978:# Re-pass rc.4 t3 (smoke STALE) + t5 P1 (ownership): the plans/ SCHEMA
3979:# docs are FRAMEWORK contract files that install.sh seeds but upgrade never
3980:# refreshed — the first framework edit (S305, DEBATE-SCHEMA) left every
3981:# upgraded adopter on the old generation (F3 STALE). But a blanket
3982:# backup_and_replace would CLOBBER an adopter-modified schema (t5 P1: the
3983:# schemas are not in the baseline ownership enumeration for pre-existing
3984:# installs, so classification falls back to legacy overwrite). Refresh is
3985:# therefore HASH-GATED: only a byte-pristine copy of a KNOWN prior
3986:# framework generation is replaced; anything else is PRESERVED loudly.
3987:# t8 P1: delivery flags for the baseline manifest — the schemas enter the
3988:# enumeration ONLY when this upgrade left FRAMEWORK bytes at the path
3989:# (INSTALLED / REFRESHED / IDENTICAL). PRESERVED and SKIPPED stay out, so
3990:# an adopter-customized schema is never recorded as framework-owned.
3991:_SCHEMA_DELIVERED_PLAN=0
3992:_SCHEMA_DELIVERED_DEBATE=0
3993:_rsd_mark_delivered() {
3994:  case "$1" in
3995:    .claude/plans/PLAN-SCHEMA.md)   _SCHEMA_DELIVERED_PLAN=1 ;;
3996:    .claude/plans/DEBATE-SCHEMA.md) _SCHEMA_DELIVERED_DEBATE=1 ;;
3997:  esac
3998:}
3999:_refresh_schema_doc() {
4000:  # $1 = rel path; $2.. = sha256 of KNOWN prior framework generations.
4001:  _rsd_rel="$1"; shift
4002:  _rsd_src="$SOURCE_DIR/$_rsd_rel"; _rsd_dst="$TARGET/$_rsd_rel"
4003:  # Re-pass rc.4 t7 P1 (skip contract): --skip excludes this path from
4004:  # inspection AND write, like every other delivery in this script.
4005:  if _path_is_skipped "$_rsd_rel"; then
4006:    echo "    SKIPPED (--skip): $_rsd_rel"
4007:    return 0
4008:  fi
4009:  [ -e "$_rsd_src" ] || { echo "    SKIP (source missing): $_rsd_rel"; return 0; }
4010:  # Re-pass rc.4 t7 P1 (symlink escape): refuse to read or write through a
4011:  # symlinked LEAF (checked before -e: a BROKEN link would otherwise fall
4012:  # into the install branch and cp would create the referent outside the
4013:  # target) or any symlinked ANCESTOR — a --link install's schema symlink,
4014:  # or a hostile .claude/plans link, would make cp modify the referent
4015:  # outside the adopter target. Preservation is the only safe verdict.
4016:  if [ -L "$_rsd_dst" ]; then
4017:    echo "    WARNING: PRESERVED $_rsd_rel (destination is a symlink — a refresh would write through it, outside the target; replace the link manually if that is intended)"
4018:    return 0
4019:  fi
4020:  _rsd_walk="$(dirname "$_rsd_rel")"
4021:  while [ -n "$_rsd_walk" ] && [ "$_rsd_walk" != "." ] && [ "$_rsd_walk" != "/" ]; do
4022:    if [ -L "$TARGET/$_rsd_walk" ]; then
4023:      echo "    WARNING: PRESERVED $_rsd_rel (ancestor $_rsd_walk is a symlink — refusing to write through it)"
4024:      return 0
4025:    fi
4026:    _rsd_walk="$(dirname "$_rsd_walk")"
4027:  done
4028:  # rc.1 r12: the loop above answers only about SYMLINK ancestors. A regular
4029:  # file or FIFO at .claude/plans aborts the mkdir below under set -e,
4030:  # mid-upgrade. Same PRESERVED verdict, one shared predicate.
4031:  if command -v _wbm_dst_non_directory_ancestor_refuses >/dev/null 2>&1 \
4032:     && _wbm_dst_non_directory_ancestor_refuses "$TARGET" "$_rsd_rel"; then
4033:    echo "    WARNING: PRESERVED $_rsd_rel — $_WBM_DST_REFUSE_WHY" >&2
4034:    return 0
4035:  fi
4036:  if [ ! -e "$_rsd_dst" ]; then
4037:    mkdir -p "$(dirname "$_rsd_dst")"
4038:    cp "$_rsd_src" "$_rsd_dst"
4039:    echo "    INSTALLED: $_rsd_rel"
4040:    _rsd_mark_delivered "$_rsd_rel"
4041:    return 0
4042:  fi
4043:  # Re-pass rc.4 t7 P1 (hasher portability): the shared _hash_file
4044:  # abstraction, never a bare `shasum` — absent on Perl-less Linux hosts,
4045:  # where set -e would abort the whole upgrade mid-inspection. No usable
4046:  # hasher => ownership cannot be proven => preserve loudly.
4047:  if ! command -v _hash_file >/dev/null 2>&1; then
4048:    echo "    WARNING: PRESERVED $_rsd_rel (no sha256 hasher available — ownership unprovable, not refreshing)"
4049:    return 0
4050:  fi
4051:  if ! _rsd_h_dst="$(_hash_file "$_rsd_dst")" || [ -z "$_rsd_h_dst" ]; then
4052:    echo "    WARNING: PRESERVED $_rsd_rel (no sha256 hasher available — ownership unprovable, not refreshing)"
4053:    return 0
4054:  fi
4055:  if ! _rsd_h_src="$(_hash_file "$_rsd_src")" || [ -z "$_rsd_h_src" ]; then
4056:    echo "    WARNING: PRESERVED $_rsd_rel (no sha256 hasher available — ownership unprovable, not refreshing)"
4057:    return 0
4058:  fi
4059:  if [ "$_rsd_h_dst" = "$_rsd_h_src" ]; then
4060:    echo "    IDENTICAL: $_rsd_rel"
4061:    _rsd_mark_delivered "$_rsd_rel"
4062:    return 0
4063:  fi
4064:  for _rsd_prior in "$@"; do
4065:    if [ "$_rsd_h_dst" = "$_rsd_prior" ]; then
4066:      mkdir -p "$BAK_DIR/$(dirname "$_rsd_rel")"
4067:      cp "$_rsd_dst" "$BAK_DIR/$_rsd_rel"
4068:      cp "$_rsd_src" "$_rsd_dst"
4069:      echo "    REFRESHED (pristine prior generation): $_rsd_rel"
4070:      _rsd_mark_delivered "$_rsd_rel"
4071:      return 0
4072:    fi
4073:  done
4074:  echo "    WARNING: PRESERVED adopter-modified $_rsd_rel (framework schema changed upstream — diff it manually; a pristine copy would have been refreshed)"
4075:  return 0
4076:}
4077:if [[ "$DRY_RUN" -eq 1 ]]; then
4078:  # t7 P1 (accurate dry-run): report the per-path --skip verdict instead of
4079:  # a blanket line that hides the exclusion.
4080:  for _rsd_dry in ".claude/plans/PLAN-SCHEMA.md" ".claude/plans/DEBATE-SCHEMA.md"; do
4081:    if _path_is_skipped "$_rsd_dry"; then
4082:      echo "    (dry-run) schema doc SKIPPED (--skip): $_rsd_dry"
4083:    else
4084:      echo "    (dry-run) schema doc hash-gated refresh (pristine prior generations only): $_rsd_dry"
4085:    fi
4086:  done
4087:else
4088:  # sha256 of every shipped prior generation (git history of each file).
4089:  # CONTRACT: any commit that changes one of these schema docs MUST append
4090:  # the hash of the generation it replaces to that doc's list, in the SAME
4091:  # commit — otherwise every adopter on the previous generation is left
4092:  # STALE (the S313 smoke-install red: 996d72b changed PLAN-SCHEMA and the
4093:  # v1.2.0/v1.3.0 generation 8ca4f866 was never listed). Enforced by
4094:  # scripts/tests/test-schema-generation-pins-unit.sh, which derives the
4095:  # generation set from git (release tags + history) instead of memory.
4096:  _refresh_schema_doc ".claude/plans/PLAN-SCHEMA.md" \
4097:    "8a2033d241b113544f1e18abbd13f4c60cc6257140f304d95b29216193035232" \
4098:    "8ca4f866797b7b02ba5161e3ab0e1cf43fe2ce59f6b5257baadb1e848fa6abf2"
4099:  _refresh_schema_doc ".claude/plans/DEBATE-SCHEMA.md" \
4100:    "574bd22e401308400622b1766a9d090e5afede1fb45938995316f38c554f1bf3"
4101:fi
4102:# agent-metrics.md preserved (user data). settings.json is preserved here too —
4103:# ONLY the PLAN-135 W2 H8 settings-merge (additive lifecycle-hook registration)
4104:# and the PLAN-163 T5.4 baseline migration (3-state per leaf key; customized
4105:# values PRESERVED + named WARNING) below touch it; neither clobbers.
4106:
4107:# ===========================================================================
4108:# PLAN-020 Phase 1 (ADR-050) — native subagents canonical-5 preservation
4109:# ---------------------------------------------------------------------------
4110:# Replace ONLY the 5 canonical-5 native agent files we ship. Adopter-
4111:# authored .claude/agents/custom-*.md or any other adopter-named files
4112:# are PRESERVED (not touched, not backed up). This protects adopter
4113:# extensions while still letting framework upgrades land canonical
4114:# changes.
4115:# ===========================================================================
4116:upgrade_agents_canonical_only() {
4117:  local CANONICAL_AGENTS=(
4118:    "code-reviewer.md"
4119:    "security-engineer.md"
4120:    "qa-architect.md"
4121:    "performance-engineer.md"
4122:    "devops.md"
4123:  )
4124:  if [[ ! -d "$SOURCE_DIR/.claude/agents" ]]; then
4125:    echo "    NOTE: source has no .claude/agents/ — skipping native rail"
4126:    return 0
4127:  fi
4128:  # PLAN-161 U1: this writer family (mkdir + cp + awk-rewrite + $BAK_DIR
4129:  # backups) ignored --dry-run entirely (bug 2a, live 2026-07-21). Preview
4130:  # and return before ANY target write.
4131:  if [[ "$DRY_RUN" -eq 1 ]]; then
4132:    echo "    (dry-run) would REFRESH agent pins: canonical-5"
4133:    return 0
4134:  fi
4135:  echo ""
4136:  echo "==> Upgrading native subagent canonical-5 (ADR-050 + ADR-052)"
4137:  _up_record_op "upgrade_agents_canonical_only" "canonical-5"
4138:  mkdir -p "$TARGET/.claude/agents"
4139:  for name in "${CANONICAL_AGENTS[@]}"; do
4140:    local SRC="$SOURCE_DIR/.claude/agents/$name"
4141:    local DST="$TARGET/.claude/agents/$name"
4142:    if [[ -f "$SRC" ]]; then
4143:      # PLAN-021 ADR-052: preserve adopter model override.
4144:      # Detect if adopter customized the model: field vs framework default.
4145:      local adopter_model=""
4146:      local framework_model=""
4147:      if [[ -f "$DST" ]]; then
4148:        adopter_model=$(grep -E "^model:" "$DST" | head -1 || true)
4149:        framework_model=$(grep -E "^model:" "$SRC" | head -1 || true)
4150:        cp "$DST" "$BAK_DIR/agents-$name.bak" 2>/dev/null || true
4151:      fi
4152:      cp "$SRC" "$DST"
4153:
4154:      # If adopter had a custom model override, restore it in the
4155:      # refreshed file. Only triggers when the adopter's model line
4156:      # differs from the framework baseline for this agent.
4157:      if [[ -n "$adopter_model" && -n "$framework_model" \
4158:            && "$adopter_model" != "$framework_model" ]]; then
4159:        # Replace the framework model line with adopter's choice.
4160:        # Portable BSD/GNU sed in-place edit via temp file.
4161:        local tmp
4162:        tmp=$(mktemp)
4163:        awk -v old="$framework_model" -v new="$adopter_model" '
4164:          $0 == old { print new; next }
4165:          { print }
4166:        ' "$DST" > "$tmp" && mv "$tmp" "$DST"
4167:        echo "    canonical-5: refreshed $name (ADR-052 adopter model override PRESERVED: $adopter_model)"
4168:      else
4169:        echo "    canonical-5: refreshed $name"
4170:      fi
4171:    fi
4172:  done
4173:  echo "    PLAN-020 native-subagent rail installed; set CEO_NATIVE_SUBAGENTS=0 to opt out"
4174:  echo "    PLAN-021 multi-model dispatch active; set CEO_MULTIMODEL_ENABLE=0 to force all-Opus"
4175:}
