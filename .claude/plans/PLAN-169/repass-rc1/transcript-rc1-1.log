1251:# PLAN-155 Wave 5 — override the codex helper's no-op recorder so a codex
1252:# refresh during upgrade is journaled into the upgrade operation log.
1253:codex_journal() { _up_record_op "$1" "${2:-}"; }
1254:
1255:# ===========================================================================
1256:# PLAN-138 Wave C (ADR-155) — baseline manifest load + per-file classifier.
1257:# ===========================================================================
1258:# Read $TARGET/.claude/.install-manifest.sha256 ONCE at startup into a
1259:# validated, sanitized lookup file. Every line is re-validated here against the
1260:# two accepted record grammars; any line that matches NEITHER, or whose relpath
1261:# is absolute / contains `..` / control chars / duplicates an earlier relpath /
1262:# traverses a symlinked component, is DROPPED so it can never drive a silent
1263:# FRAMEWORK-CHANGED branch (CWE-345/494/22 provenance hardening). The raw
1264:# manifest is NEVER piped into `shasum -c`; classification recomputes +
1265:# compares in-process per validated relpath.
1266:#
1267:# bash 3.2-safe: no associative arrays. The validated manifest is a temp file;
1268:# lookups use a fixed-string, line-anchored grep.
1269:_BASELINE_MANIFEST_RAW="$TARGET/.claude/.install-manifest.sha256"
1270:_BASELINE_MANIFEST_FILE=""   # set to the sanitized temp file if a manifest loads
1271:_BASELINE_DUP_GUARD=""       # newline-list of relpaths already accepted (dup detection)
1272:_BASELINE_INVALID=""         # newline-list of relpaths seen >1x: AMBIGUOUS provenance,
1273:                             # rejected entirely (NOT first-wins) — Codex R1 P0#2 fold.
1274:
1275:# Reject a relpath that is unsafe to trust from the manifest. Returns 0 (reject)
1276:# / 1 (accept). Checks: absolute, `..` segment, control chars, and a symlinked
1277:# component anywhere along the path under $TARGET (lstat per component, never
1278:# follow). Duplicate relpaths are rejected by the caller via _BASELINE_DUP_GUARD.
1279:#
1280:# $2 = record KIND, mirroring doctor.sh `_relpath_unsafe` (family sweep):
1281:# "link" tolerates a symlinked LEAF, anything else (default "file") does not.
1282:# A `LINK  <relpath>  <target>` record describes a --mode link delivery whose
1283:# leaf IS a symlink by construction, so rejecting it here silently dropped the
1284:# record from the sanitized manifest: _baseline_has_spec_record and both
1285:# readlink-vs-recorded-target checks could then NEVER match, and every
1286:# link-mode upgrade lost framework ownership of SPEC/v1 and the marker, with
1287:# marker-first readers falling back to the stale root VERSION (codex W1
1288:# round 6, P2). The leaf is never FOLLOWED here — validation stays at the
1289:# consumers, which compare `readlink` against the recorded target. Hash
1290:# records keep the strict leaf check: a managed regular file swapped for a
1291:# symlink must not retain its record (_hash_file WOULD follow it). Symlinked
1292:# PARENT components remain a genuine traversal hazard for both kinds.
1293:_baseline_relpath_unsafe() {
1294:  _bru_rel="$1"
1295:  _bru_kind="${2:-file}"
1296:  case "$_bru_rel" in
1297:    /*) return 0 ;;                       # absolute
1298:    *..*) return 0 ;;                      # parent traversal (covers ../ and /..)
1299:  esac
1300:  # Control chars / whitespace-only / empty.
1301:  case "$_bru_rel" in
1302:    ""|*[$'\n\r\t']*) return 0 ;;
1303:  esac
1304:  # Count the significant components first, so the leaf can be identified by
1305:  # INDEX — reconstructing "$TARGET/$_bru_rel" for a leaf test would differ
1306:  # from the walk on `./` and trailing-slash forms.
1307:  _bru_n=0
1308:  _bru_oldIFS="$IFS"
1309:  IFS='/'
1310:  for _bru_comp in $_bru_rel; do
1311:    [ -n "$_bru_comp" ] || continue
1312:    [ "$_bru_comp" = "." ] && continue
1313:    _bru_n=$(( _bru_n + 1 ))
1314:  done
1315:  # Symlinked-component check: walk each path component under $TARGET; if any
1316:  # EXISTING component is a symlink, reject (do not follow it).
1317:  _bru_cur="$TARGET"
1318:  _bru_i=0
1319:  for _bru_comp in $_bru_rel; do
1320:    [ -n "$_bru_comp" ] || continue
1321:    [ "$_bru_comp" = "." ] && continue
1322:    _bru_i=$(( _bru_i + 1 ))
1323:    _bru_cur="$_bru_cur/$_bru_comp"
1324:    if [ -L "$_bru_cur" ]; then
1325:      if [ "$_bru_kind" = "link" ] && [ "$_bru_i" -eq "$_bru_n" ]; then
1326:        continue                          # the LINK record's own leaf
1327:      fi
1328:      IFS="$_bru_oldIFS"
1329:      return 0
1330:    fi
1331:  done
1332:  IFS="$_bru_oldIFS"
1333:  return 1
1334:}
1335:
1336:# Load + sanitize the baseline manifest. On any problem (absent / unreadable /
1337:# empty after sanitization) leaves _BASELINE_MANIFEST_FILE empty => fallback.
1338:_load_baseline_manifest() {
1339:  [ -f "$_BASELINE_MANIFEST_RAW" ] && [ -r "$_BASELINE_MANIFEST_RAW" ] || return 0
1340:  command -v _hash_file >/dev/null 2>&1 || return 0
1341:
1342:  # PLAN-161 U1: the sanitized manifest used to be mktemp'd INSIDE $BAK_DIR —
1343:  # a write inside the target even under --dry-run (and the reason dry-run
1344:  # could not keep classification alive once BAK_DIR creation was gated). It
1345:  # now lives in a secure temp OUTSIDE $TARGET in ALL runs; the composed
1346:  # _upgrade_cleanup EXIT trap reaps it via the _BASELINE_TMP_FILE global.
1347:  #
1348:  # PLAN-161 U1 (codex r1 F5): "outside $TARGET" must hold even when the
1349:  # CALLER's TMPDIR is $TARGET or lies under it — otherwise --dry-run writes
1350:  # in the target again. That check was BORN here and, as of rail round-5 F3,
1351:  # lives in _up_tmpbase (:641) so every scratch file this script takes gets
1352:  # the same answer — the round-5 finding was a NEW mktemp that did not
1353:  # inherit it. If the base cannot be resolved (nonexistent), mktemp fails
1354:  # below and we return 0 (the existing no-manifest fallback).
1355:  local _lbm_base
1356:  _lbm_base="$( _up_tmpbase )"
1357:  local sanitized
1358:  sanitized="$( mktemp "$_lbm_base/ceo-baseline-manifest.XXXXXX" 2>/dev/null )" || return 0
1359:  _BASELINE_TMP_FILE="$sanitized"
1360:
1361:  local line rest rel digest target
1362:  # Read line-by-line; NEVER `eval` or interpret manifest content.
1363:  while IFS= read -r line || [ -n "$line" ]; do
1364:    [ -n "$line" ] || continue
1365:    # Hash record: ^<64hex><2 spaces><relpath>$
1366:    # Link record: ^LINK<2 spaces><relpath><2 spaces><target>$
1367:    case "$line" in
1368:      LINK\ \ *)
1369:        rest="${line#LINK  }"
1370:        # relpath is everything up to the FIRST double-space; target the rest.
1371:        case "$rest" in
1372:          *"  "*)
1373:            rel="${rest%%  *}"
1374:            target="${rest#*  }"
1375:            ;;
1376:          *) continue ;;   # malformed LINK (no target) — drop
1377:        esac
1378:        # KIND=link: the leaf of a LINK record IS a symlink by construction
1379:        # (codex W1 round 6, P2). Symlinked PARENTS still reject.
1380:        if _baseline_relpath_unsafe "$rel" link; then continue; fi
1381:        # Duplicate relpath? Ambiguous provenance — invalidate the relpath
1382:        # ENTIRELY (not first-wins): the lookup will refuse it -> fallback.
1383:        case "$_BASELINE_DUP_GUARD" in
1384:          *"
1385:$rel
1386:"*)
1387:            case "$_BASELINE_INVALID" in
1388:              *"
1389:$rel
1390:"*) ;;
1391:              *) _BASELINE_INVALID="$_BASELINE_INVALID
1392:$rel
1393:" ;;
1394:            esac
1395:            continue ;;
1396:        esac
1397:        _BASELINE_DUP_GUARD="$_BASELINE_DUP_GUARD
1398:$rel
1399:"
1400:        # Re-emit a normalized LINK record (target sanitized of control chars).
1401:        case "$target" in
1402:          *[$'\n\r\t']*) continue ;;
1403:        esac
1404:        printf 'LINK  %s  %s\n' "$rel" "$target" >> "$sanitized"
1405:        ;;
1406:      *)
1407:        # Must be exactly 64-hex, two spaces, then relpath.
1408:        digest="${line%%  *}"
1409:        rel="${line#*  }"
1410:        # Guard: the split must have actually found a double-space separator.
1411:        [ "$digest" != "$line" ] || continue
1412:        case "$digest" in
1413:          [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]) ;;
1414:          *) continue ;;   # not a 64-hex digest — drop (provenance)
1415:        esac
1416:        if _baseline_relpath_unsafe "$rel"; then continue; fi
1417:        # Duplicate relpath? Ambiguous provenance — invalidate ENTIRELY
1418:        # (not first-wins): the lookup refuses it -> fallback. (Codex R1 P0#2)
1419:        case "$_BASELINE_DUP_GUARD" in
1420:          *"
1421:$rel
1422:"*)
1423:            case "$_BASELINE_INVALID" in
1424:              *"
1425:$rel
1426:"*) ;;
1427:              *) _BASELINE_INVALID="$_BASELINE_INVALID
1428:$rel
1429:" ;;
1430:            esac
1431:            continue ;;
1432:        esac
1433:        _BASELINE_DUP_GUARD="$_BASELINE_DUP_GUARD
1434:$rel
1435:"
1436:        printf '%s  %s\n' "$digest" "$rel" >> "$sanitized"
1437:        ;;
1438:    esac
1439:  done < "$_BASELINE_MANIFEST_RAW"
1440:
1441:  if [ -s "$sanitized" ]; then
1442:    _BASELINE_MANIFEST_FILE="$sanitized"
1443:  else
1444:    rm -f "$sanitized" 2>/dev/null || true
1445:  fi
1446:  return 0
1447:}
1448:
1449:# Echo the baseline digest for $1 if (and only if) it is a validated HASH
1450:# record. A LINK record or an absent line echoes nothing + returns 1 => the
1451:# caller falls back. Exact relpath match (the part after the two-space
1452:# separator must equal $1 exactly). awk does the exact match + 64-hex check in
1453:# one pass — no fragile nested while/case under set -u.
1454:_baseline_lookup() {
1455:  _bl_rel="$1"
1456:  [ -n "$_BASELINE_MANIFEST_FILE" ] || return 1
1457:  [ -f "$_BASELINE_MANIFEST_FILE" ] || return 1
1458:  # Refuse a relpath flagged as duplicate/ambiguous during load (Codex R1 P0#2):
1459:  # never trust a baseline digest for a relpath that appeared more than once.
1460:  case "$_BASELINE_INVALID" in
1461:    *"
1462:$_bl_rel
1463:"*) return 1 ;;
1464:  esac
1465:  _bl_digest="$( awk -v want="$_bl_rel" '
1466:    {
1467:      # Split on the FIRST double-space: field1 = digest-or-LINK, rest = path[+target].
1468:      idx = index($0, "  ");
1469:      if (idx == 0) next;
1470:      d = substr($0, 1, idx - 1);
1471:      rest = substr($0, idx + 2);
1472:      if (d == "LINK") next;                 # link record: no content baseline
1473:      # rest must equal the wanted relpath exactly (hash records have no 2nd
1474:      # double-space: relpath runs to EOL).
1475:      if (rest != want) next;
1476:      if (length(d) != 64) next;
1477:      if (d ~ /^[0-9a-f]+$/) { print d; exit 0 }
1478:    }
1479:  ' "$_BASELINE_MANIFEST_FILE" 2>/dev/null )"
1480:  [ -n "$_bl_digest" ] || return 1
1481:  printf '%s\n' "$_bl_digest"
1482:}
1483:
1484:# Classify a single repo-relative file against the baseline. Echoes ONE verdict:
1485:#   FRAMEWORK-CHANGED  H_dst==H_base && H_src!=H_base  -> safe to auto-update
1486:#   ADOPTER-CUSTOMIZED H_dst!=H_base && H_src==H_base  -> preserve
1487:#   CONFLICT           both differ from H_base         -> --on-conflict
1488:#   IDENTICAL          H_dst==H_src                    -> nothing to do
1489:#   FALLBACK           no usable baseline / hasher      -> today's behavior
1490:# H_dst and H_src are BOTH recomputed from disk THIS run (never cached H_src).
1491:_classify_against_baseline() {
1492:  _cab_rel="$1"
1493:  command -v _hash_file >/dev/null 2>&1 || { printf 'FALLBACK\n'; return 0; }
1494:  _cab_base="$( _baseline_lookup "$_cab_rel" )" || { printf 'FALLBACK\n'; return 0; }
1495:  _cab_dst="$( _hash_file "$TARGET/$_cab_rel" 2>/dev/null || true )"
1496:  _cab_src="$( _hash_file "$SOURCE_DIR/$_cab_rel" 2>/dev/null || true )"
1497:  # If either side cannot be hashed (missing file), fall back to legacy handling.
1498:  if [ -z "$_cab_dst" ] || [ -z "$_cab_src" ]; then
1499:    printf 'FALLBACK\n'; return 0
1500:  fi
1501:  if [ "$_cab_dst" = "$_cab_src" ]; then
1502:    printf 'IDENTICAL\n'; return 0
1503:  fi
1504:  if [ "$_cab_dst" = "$_cab_base" ] && [ "$_cab_src" != "$_cab_base" ]; then
1505:    printf 'FRAMEWORK-CHANGED\n'; return 0
1506:  fi
1507:  if [ "$_cab_dst" != "$_cab_base" ] && [ "$_cab_src" = "$_cab_base" ]; then
1508:    printf 'ADOPTER-CUSTOMIZED\n'; return 0
1509:  fi
1510:  # Both differ from the baseline.
1511:  printf 'CONFLICT\n'; return 0
1512:}
1513:
1514:_load_baseline_manifest
1515:
1516:# PLAN-161 U1 (codex r1 F4) — manifest-load observability. Byte-identity alone
1517:# cannot prove a --dry-run kept provenance classification alive (a dry-run
1518:# that silently lost the baseline would also write nothing), so EVERY run
1519:# states which classification mode it operates in.
1520:if [ -n "$_BASELINE_MANIFEST_FILE" ]; then
1521:  echo "==> Baseline manifest: loaded (provenance classification ACTIVE)"
1522:else
1523:  echo "==> Baseline manifest: none — fallback diff -q classification"
1524:fi
1525:
1526:# F-CHAOS-3: emit a diff-q-style WARNING line for every adopter file
1527:# that differs from the source before we overwrite it. Recurses into
1528:# directories. Respects --no-diff-warn and --skip globs.
1529:_emit_diff_warnings() {
1530:  local rel_path="$1"
1531:  local src="$SOURCE_DIR/$rel_path"
1532:  local dst="$TARGET/$rel_path"
1533:
1534:  [[ "$DIFF_WARN" -eq 1 ]] || return 0
1535:  [[ -e "$dst" && -e "$src" ]] || return 0
1536:
1537:  if [[ -d "$src" && -d "$dst" ]]; then
1538:    # Per-file diff within the directory
1539:    local f rel sub
1540:    while IFS= read -r f; do
1541:      [[ -n "$f" ]] || continue
1542:      sub="${f#$dst/}"
1543:      rel="$rel_path/$sub"
1544:      if _path_is_skipped "$rel"; then
1545:        echo "    SKIP-DIFF (--skip): $rel" >&2
1546:        continue
1547:      fi
1548:      if [[ -f "$SOURCE_DIR/$rel" ]]; then
1549:        if ! diff -q "$f" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
1550:          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN" >&2
1551:          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
1552:        fi
1553:      fi
1554:    done < <(find "$dst" -type f 2>/dev/null)
1555:  elif [[ -f "$src" && -f "$dst" ]]; then
1556:    if _path_is_skipped "$rel_path"; then
1557:      echo "    SKIP-DIFF (--skip): $rel_path" >&2
1558:      return 0
1559:    fi
1560:    if ! diff -q "$dst" "$src" >/dev/null 2>&1; then
1561:      echo "    WARNING: adopter customization in $rel_path will be OVERWRITTEN" >&2
1562:      echo "             (backup preserved in $BAK_DIR/$rel_path)" >&2
1563:    fi
1564:  fi
1565:}
1566:
1567:# PLAN-138 Wave C (ADR-155): update ONE file under a classified directory walk.
1568:# $1 = repo-relative file path. Backs up the dst file then copies src over it.
1569:# Used by _per_file_classified_update for the FRAMEWORK-CHANGED / theirs / backup
1570:# branches. find+delete idiom is unnecessary for a single file (plain cp).
1571:_apply_single_file() {
1572:  local rel="$1"
1573:  local s="$SOURCE_DIR/$rel"
1574:  local d="$TARGET/$rel"
1575:  local b="$BAK_DIR/$rel"
1576:  [[ -f "$s" ]] || return 0
1577:  if [[ -e "$d" ]]; then
1578:    mkdir -p "$( dirname "$b" )"
1579:    cp "$d" "$b" 2>/dev/null || true
1580:  fi
1581:  mkdir -p "$( dirname "$d" )"
1582:  cp "$s" "$d"
1583:}
1584:
1585:# PLAN-138 Wave C (ADR-155): per-file walk of a DIRECTORY target driven by the
1586:# baseline classifier. Replaces the whole-tree delete+cp -R when a baseline
1587:# manifest is loaded, so an adopter customization INSIDE a directory is
1588:# preserved/refused per-file instead of being wiped. The union of source + dst
1589:# files is walked so framework-added files land and removed-from-source files
1590:# are reported (never auto-deleted — destructive removals stay manual).
1591:_per_file_classified_update() {
1592:  local rel_dir="$1"
1593:  local sdir="$SOURCE_DIR/$rel_dir"
1594:  local ddir="$TARGET/$rel_dir"
1595:  local listing rel verdict
1596:  # Build the union of relpaths under src + dst (regular files only).
1597:  listing="$( {
1598:    [[ -d "$sdir" ]] && find "$sdir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$SOURCE_DIR"/}"; done
1599:    [[ -d "$ddir" ]] && find "$ddir" -type f -print 2>/dev/null | while IFS= read -r h; do printf '%s\n' "${h#"$TARGET"/}"; done
1600:  } | LC_ALL=C sort -u )"
1601:
1602:  printf '%s\n' "$listing" | while IFS= read -r rel; do
1603:    [[ -n "$rel" ]] || continue
1604:    # PLAN-161 U2 (CF-7): the canonical framework-internal exclusion set —
1605:    # never install, never re-add after an adopter deletes, never report.
1606:    # Silent skip; the opt-in U3 purge is the ONLY code allowed to touch
1607:    # these paths (and only hash-gated).
1608:    if command -v _framework_path_excluded >/dev/null 2>&1 && _framework_path_excluded "$rel"; then
1609:      continue
1610:    fi
1611:    if _path_is_skipped "$rel"; then
1612:      echo "    SKIPPED (--skip): $rel"
1613:      continue
1614:    fi
1615:    # Source-removed file: present at dst, absent at src. Report, never delete.
1616:    if [[ ! -f "$SOURCE_DIR/$rel" ]]; then
1617:      echo "    KEPT (no longer shipped by framework — not removed): $rel" >&2
1618:      continue
1619:    fi
1620:    # New framework file: absent at dst. Just install it.
1621:    if [[ ! -f "$TARGET/$rel" ]]; then
1622:      _apply_single_file "$rel"
1623:      echo "    ADDED: $rel"
1624:      continue
1625:    fi
1626:    verdict="$( _classify_against_baseline "$rel" )"
1627:    case "$verdict" in
1628:      IDENTICAL)
1629:        : ;;  # nothing to do
1630:      FRAMEWORK-CHANGED)
1631:        # Quiet auto-update is the intended path (dst matched the recorded
1632:        # baseline => the adopter had not customized this file). BUT the manifest
1633:        # is UNSIGNED/target-side (OQ-trust): a tampered line where H_base==H_dst
1634:        # would mis-classify a customized file into this branch. We cannot detect
1635:        # that without a signed manifest, so per Codex R1 P0#1 this is downgraded
1636:        # to NON-SILENT: _apply_single_file always backs up the original first,
1637:        # and we surface the overwrite + backup location on stderr (recoverable
1638:        # AND visible — worst case equals today's warn-then-clobber).
1639:        _apply_single_file "$rel"
1640:        echo "    UPDATED (framework-changed; unsigned baseline — original backed up to $BAK_DIR/$rel): $rel" >&2
1641:        ;;
1642:      ADOPTER-CUSTOMIZED)
1643:        echo "    PRESERVED (ADOPTER-CUSTOMIZED — not overwritten): $rel" >&2
1644:        ;;
1645:      CONFLICT)
1646:        case "$ON_CONFLICT" in
1647:          theirs)
1648:            _apply_single_file "$rel"
1649:            echo "    OVERWROTE (CONFLICT, --on-conflict=theirs): $rel" >&2
1650:            ;;
1651:          backup)
1652:            _apply_single_file "$rel"
1653:            echo "    OVERWROTE (CONFLICT, --on-conflict=backup; original in $BAK_DIR/$rel): $rel" >&2
1654:            ;;
1655:          *)  # refuse (default): per-file skip-and-report-and-CONTINUE
1656:            echo "    REFUSED (CONFLICT, --on-conflict=refuse — not overwritten): $rel" >&2
1657:            ;;
1658:        esac
1659:        ;;
1660:      FALLBACK|*)
1661:        # No usable baseline for this file — today's diff -q warn-then-clobber.
1662:        if [[ "$DIFF_WARN" -eq 1 ]] && ! diff -q "$TARGET/$rel" "$SOURCE_DIR/$rel" >/dev/null 2>&1; then
1663:          echo "    WARNING: adopter customization in $rel will be OVERWRITTEN (no baseline)" >&2
1664:          echo "             (backup preserved in $BAK_DIR/$rel)" >&2
1665:        fi
1666:        _apply_single_file "$rel"
1667:        echo "    UPDATED (fallback): $rel"
1668:        ;;
1669:    esac
1670:  done
1671:}
1672:
1673:# PLAN-161 W2 fix-3 (codex r3 F11a): TRUE (rc 0) iff any STRICT ancestor
1674:# component of relpath $2 under root $1 is a symlink. A preserved excluded
1675:# SYMLINK must be an opaque leaf: a -f/-d/-L test (or rm/rmdir) on a path
1676:# that runs THROUGH it resolves into the link TARGET, so an unguarded
1677:# prune could delete adopter data OUTSIDE the tree. Every prune-side
1678:# test/delete on "$TARGET/$rel" must first pass this lstat-walk guard.
1679:# bash 3.2-safe: pure string splitting, [[ -L ]] never follows the leaf.
1680:_lg_ancestor_is_symlink() {
1681:  local _as_root="$1" _as_rel="$2" _as_walk=""
1682:  while [[ "$_as_rel" == */* ]]; do
1683:    _as_walk="${_as_walk:+$_as_walk/}${_as_rel%%/*}"
1684:    _as_rel="${_as_rel#*/}"
1685:    if [[ -L "$_as_root/$_as_walk" ]]; then return 0; fi
1686:  done
1687:  return 1
1688:}
1689:
1690:backup_and_replace() {
1691:  local rel_path="$1"
1692:  local src="$SOURCE_DIR/$rel_path"
1693:  local dst="$TARGET/$rel_path"
1694:  local bak="$BAK_DIR/$rel_path"
1695:
1696:  if [[ ! -e "$src" ]]; then
1697:    echo "    SKIP (source missing): $rel_path"
1698:    return
1699:  fi
1700:
1701:  _up_record_op "refresh_target" "$rel_path"
1702:
1703:  # F-CHAOS-3: warn the Owner about any customization we're about to
1704:  # clobber, BEFORE the overwrite takes place. The backup under
1705:  # $BAK_DIR is still the rollback path, but the warning surfaces the
1706:  # diff at the moment it happens — without requiring the Owner to
1707:  # notice it via `git diff` later.
1708:  _emit_diff_warnings "$rel_path"
1709:
1710:  # Honour --skip for top-level files/dirs too
1711:  if _path_is_skipped "$rel_path"; then
1712:    echo "    SKIPPED (--skip): $rel_path"
1713:    return
1714:  fi
1715:
1716:  if [[ "$DRY_RUN" -eq 1 ]]; then
1717:    # PLAN-161 U1 (codex r1 F4): classification-aware preview for single-FILE
1718:    # targets when a baseline manifest is loaded — the dry-run log must PROVE
1719:    # the provenance classifier still runs (byte-identity alone would pass on
1720:    # a dry-run that silently lost classification). DIRECTORY targets keep
1721:    # the legacy one-line preview.
1722:    if [[ -f "$dst" && -f "$src" && -n "$_BASELINE_MANIFEST_FILE" ]]; then
1723:      local _drv
1724:      _drv="$( _classify_against_baseline "$rel_path" )"
1725:      case "$_drv" in
1726:        IDENTICAL)
1727:          echo "    (dry-run) would SKIP (IDENTICAL): $rel_path" ;;
1728:        ADOPTER-CUSTOMIZED)
1729:          echo "    (dry-run) would PRESERVE (ADOPTER-CUSTOMIZED): $rel_path" ;;
1730:        CONFLICT)
1731:          echo "    (dry-run) would apply --on-conflict=$ON_CONFLICT (CONFLICT): $rel_path" ;;
1732:        FRAMEWORK-CHANGED)
1733:          echo "    (dry-run) would UPDATE (FRAMEWORK-CHANGED; original would be backed up to $BAK_DIR/$rel_path): $rel_path" ;;
1734:        FALLBACK|*)
1735:          echo "    (dry-run) would BACKUP + UPDATE (no usable baseline): $rel_path" ;;
1736:      esac
1737:      return
1738:    fi
1739:    echo "    (dry-run) would BACKUP + UPDATE: $rel_path"
1740:    return
1741:  fi
1742:
1743:  # PLAN-138 Wave C (ADR-155): when this is a DIRECTORY target AND a baseline
1744:  # manifest is loaded, do a per-file classified walk so adopter customizations
1745:  # inside the tree are preserved/refused instead of wiped by delete+cp -R.
1746:  # Falls through to the legacy whole-tree path for FILE targets or when no
1747:  # manifest is present (fail-open to today's behavior). The whole-tree backup
1748:  # below still runs first so $BAK_DIR holds the pre-upgrade tree for rollback.
1749:  if [[ -d "$dst" && -d "$src" && -n "$_BASELINE_MANIFEST_FILE" ]]; then
1750:    if [[ -e "$dst" ]]; then
1751:      mkdir -p "$( dirname "$bak" )"
1752:      cp -R "$dst" "$bak"
1753:      echo "    BACKED UP: $rel_path"
1754:    fi
1755:    _per_file_classified_update "$rel_path"
1756:    echo "    UPDATED (per-file classified): $rel_path"
1757:    return
1758:  fi
1759:
1760:  # PLAN-138 Wave C (ADR-155): single-FILE target with a baseline loaded —
1761:  # classify it too (e.g. .claude/task-chains.yaml, .claude/team.md). Preserve
1762:  # an ADOPTER-CUSTOMIZED file / refuse a CONFLICT instead of clobbering.
1763:  if [[ -f "$dst" && -f "$src" && -n "$_BASELINE_MANIFEST_FILE" ]]; then
1764:    local _bfr_verdict
1765:    _bfr_verdict="$( _classify_against_baseline "$rel_path" )"
1766:    case "$_bfr_verdict" in
1767:      IDENTICAL)
1768:        return ;;
1769:      ADOPTER-CUSTOMIZED)
1770:        echo "    PRESERVED (ADOPTER-CUSTOMIZED — not overwritten): $rel_path" >&2
1771:        return ;;
1772:      CONFLICT)
1773:        case "$ON_CONFLICT" in
1774:          theirs|backup)
1775:            _apply_single_file "$rel_path"
1776:            echo "    OVERWROTE (CONFLICT, --on-conflict=$ON_CONFLICT; original in $BAK_DIR/$rel_path): $rel_path" >&2
1777:            return ;;
1778:          *)
1779:            echo "    REFUSED (CONFLICT, --on-conflict=refuse — not overwritten): $rel_path" >&2
1780:            return ;;
1781:        esac ;;
1782:      FRAMEWORK-CHANGED)
1783:        _apply_single_file "$rel_path"
1784:        echo "    UPDATED (framework-changed): $rel_path"
1785:        return ;;
1786:      FALLBACK|*)
1787:        : ;;  # fall through to legacy whole-file path below
1788:    esac
1789:  fi
1790:
1791:  if [[ -e "$dst" ]]; then
1792:    mkdir -p "$( dirname "$bak" )"
1793:    if [[ -d "$dst" ]]; then
1794:      cp -R "$dst" "$bak"
1795:    else
1796:      cp "$dst" "$bak"
1797:    fi
1798:    echo "    BACKED UP: $rel_path"
1799:  fi
1800:
1801:  # PLAN-161 W2 fix-2 (codex r2 F11): the legacy DIRECTORY branch used to
1802:  # empty $dst WHOLESALE (find -delete + rmdir) before the copy — which
1803:  # silently DELETED any excluded-tree content already present at dst
1804:  # (adopter-owned OR mis-installed), before any preview/hash gate: an
1805:  # implicit purge that violated the opt-in-only --purge-misinstalled
1806:  # contract (U3). The pre-copy delete now SKIPS excluded paths (files AND
1807:  # dirs, contents intact) and the copy below never writes them, so a
1808:  # legacy upgrade neither ADDS nor REMOVES excluded-tree files; the U3
1809:  # opt-in flag remains the ONLY path that deletes them. Survivors are
1810:  # recorded (relpaths, one per line) so the r1 post-copy prune can tell
1811:  # pre-existing excluded content (keep byte-for-byte) from a copy-path
1812:  # regression artifact (prune). Fail-open: predicate unavailable (older
1813:  # sourced lib) => exactly the pre-U2 wholesale behavior. NEVER rm -rf.
1814:  local _lg_excl_aware=0
1815:  local _lg_survivors=""
1816:  if command -v _framework_path_excluded >/dev/null 2>&1 \
1817:     && [[ -d "$dst" && -d "$src" ]]; then
1818:    _lg_survivors="$( mktemp "$( _up_tmpbase )/ceo-upg-survivors.XXXXXX" )"
1819:    _lg_excl_aware=1
1820:  fi
1821:
1822:  if [[ "$_lg_excl_aware" -eq 1 ]]; then
1823:    local _lg_hit _lg_rel
1824:    # F11a symlink-safety note: find runs PHYSICAL traversal (no -L/-H/
1825:    # -follow), so it never descends into a symlinked dir — a symlink is
1826:    # emitted as its own leaf (matches ! -type d, never -type d) and
1827:    # rm -f unlinks the LINK itself, never its target. Every path find
1828:    # emits here is symlink-free above the leaf by construction.
1829:    # Non-dir entries (files/symlinks/etc): delete non-excluded, record
1830:    # excluded survivors untouched.
1831:    while IFS= read -r _lg_hit; do
1832:      [[ -n "$_lg_hit" ]] || continue
1833:      _lg_rel="${_lg_hit#"$TARGET"/}"
1834:      if _framework_path_excluded "$_lg_rel"; then
1835:        printf '%s\n' "$_lg_rel" >> "$_lg_survivors"
1836:      else
1837:        rm -f "$_lg_hit"
1838:      fi
1839:    done < <( find "$dst" ! -type d -print 2>/dev/null )
1840:    # Dirs, children before parents (-depth): rmdir non-excluded (only
1841:    # succeeds once empty — a dir still holding excluded survivors stays);
1842:    # record excluded dirs so the prune's rmdir pass keeps them too.
1843:    while IFS= read -r _lg_hit; do
1844:      [[ -n "$_lg_hit" ]] || continue
1845:      _lg_rel="${_lg_hit#"$TARGET"/}"
1846:      if _framework_path_excluded "$_lg_rel"; then
1847:        printf '%s\n' "$_lg_rel" >> "$_lg_survivors"
1848:      else
1849:        rmdir "$_lg_hit" 2>/dev/null || true
1850:      fi
1851:    done < <( find "$dst" -depth -type d -print 2>/dev/null )
1852:  elif [[ -d "$dst" ]]; then
1853:    # Use find+delete instead of rm -rf to satisfy safety hooks on dev machines
1854:    find "$dst" -mindepth 1 -delete
1855:    rmdir "$dst"
1856:  elif [[ -e "$dst" ]]; then
1857:    rm -f "$dst"
1858:  fi
1859:
1860:  mkdir -p "$( dirname "$dst" )"
1861:  if [[ -d "$src" ]]; then
1862:    if [[ "$_lg_excl_aware" -eq 1 ]]; then
1863:      # PLAN-161 W2 fix-2 (codex r2 F11): exclusion-aware per-file copy —
1864:      # non-excluded dirs first (preserves empty framework dirs), then
1865:      # non-excluded files + symlinks (per-operand cp -R copies a symlink
1866:      # as a symlink, POSIX). Excluded SOURCE paths are NEVER written, so
1867:      # pre-existing excluded dst content (the pre-delete survivors) stays
1868:      # byte-for-byte identical across the upgrade — neither deleted,
1869:      # re-copied, nor overwritten by source bytes at a shadowed relpath.
1870:      while IFS= read -r _lg_hit; do
1871:        [[ -n "$_lg_hit" ]] || continue
1872:        _lg_rel="${_lg_hit#"$SOURCE_DIR"/}"
1873:        if _framework_path_excluded "$_lg_rel"; then continue; fi
1874:        mkdir -p "$TARGET/$_lg_rel"
1875:      done < <( find "$src" -type d -print 2>/dev/null )
1876:      while IFS= read -r _lg_hit; do
1877:        [[ -n "$_lg_hit" ]] || continue
1878:        _lg_rel="${_lg_hit#"$SOURCE_DIR"/}"
1879:        if _framework_path_excluded "$_lg_rel"; then continue; fi
1880:        mkdir -p "$( dirname "$TARGET/$_lg_rel" )"
1881:        cp -R "$_lg_hit" "$TARGET/$_lg_rel"
1882:      done < <( find "$src" \( -type f -o -type l \) -print 2>/dev/null )
1883:    else
1884:      cp -R "$src" "$dst"
1885:    fi
1886:    # PLAN-161 U2 (CF-7) r1 prune, F11-NARROWED (belt-and-suspenders): in
1887:    # the wholesale-cp fallback this removes the excluded source content
1888:    # cp -R just dragged in (~967 files in the live 2026-07-21 adopter
1889:    # upgrade). In the exclusion-aware path above the copy never writes
1890:    # excluded paths, so an excluded file found at dst here is either a
1891:    # recorded pre-delete SURVIVOR (adopter-owned or mis-installed — F11:
1892:    # MUST be left exactly as-is; only U3 --purge-misinstalled may delete
1893:    # it) or the artifact of a future copy-path regression (prune it).
1894:    # Per-file rm -f plus rmdir for the emptied dirs — NEVER rm -rf.
1895:    if command -v _framework_path_excluded >/dev/null 2>&1; then
1896:      local _pr_hit _pr_rel
1897:      while IFS= read -r _pr_hit; do
1898:        [[ -n "$_pr_hit" ]] || continue
1899:        _pr_rel="${_pr_hit#"$SOURCE_DIR"/}"
1900:        if _framework_path_excluded "$_pr_rel"; then
1901:          # F11a: never test or delete THROUGH a symlinked ancestor — the
1902:          # dst path would resolve into the link target (adopter data
1903:          # possibly outside the tree). Preserved symlink == opaque leaf.
1904:          if _lg_ancestor_is_symlink "$TARGET" "$_pr_rel"; then continue; fi
1905:          # Leaf: -L before -f (lstat-first; -f alone would follow a link).
1906:          if [[ -L "$TARGET/$_pr_rel" || -f "$TARGET/$_pr_rel" ]]; then
1907:            if [[ -n "$_lg_survivors" ]] \
1908:               && grep -Fxq "$_pr_rel" "$_lg_survivors" 2>/dev/null; then
1909:              :  # pre-existing excluded content — keep exactly as-is (F11)
1910:            else
1911:              rm -f "$TARGET/$_pr_rel"
1912:            fi
1913:          fi
1914:        fi
1915:      done < <( find "$src" \( -type f -o -type l \) -print 2>/dev/null )
1916:      # Remove the now-empty excluded dirs, children before parents (-depth)
1917:      # — but never a recorded survivor dir (pre-existing, adopter-held).
1918:      while IFS= read -r _pr_hit; do
1919:        [[ -n "$_pr_hit" ]] || continue
1920:        _pr_rel="${_pr_hit#"$SOURCE_DIR"/}"
1921:        # F11a: ancestor-symlink guard first, then -L BEFORE -d (lstat-first
1922:        # — -d follows a leaf symlink; a preserved excluded symlink-to-dir
1923:        # must be kept whole and its target never rmdir'd).
1924:        if _framework_path_excluded "$_pr_rel" \
1925:           && ! _lg_ancestor_is_symlink "$TARGET" "$_pr_rel" \
1926:           && [[ ! -L "$TARGET/$_pr_rel" && -d "$TARGET/$_pr_rel" ]]; then
1927:          if [[ -n "$_lg_survivors" ]] \
1928:             && grep -Fxq "$_pr_rel" "$_lg_survivors" 2>/dev/null; then
1929:            :  # pre-existing excluded dir — keep (F11)
1930:          else
1931:            rmdir "$TARGET/$_pr_rel" 2>/dev/null || true
1932:          fi
1933:        fi
1934:      done < <( find "$src" -depth -type d -print 2>/dev/null )
1935:    fi
1936:  else
1937:    cp "$src" "$dst"
1938:  fi
1939:  if [[ -n "$_lg_survivors" ]]; then
1940:    rm -f "$_lg_survivors"
1941:  fi
1942:  echo "    UPDATED: $rel_path"
1943:}
1944:
1945:# DevOps-P1-4: refresh PROTOCOL.md pointer on upgrade. This is
1946:# framework-derived content (not user data), so preserving it as-is
1947:# across upgrades traps stale pointers when the framework moves. We
1948:# regenerate it with the same heuristic install.sh uses.
1949:_refresh_protocol_pointer() {
1950:  local pointer="$TARGET/PROTOCOL.md"
1951:
1952:  # PLAN-168 W2 (AC-6, Owner decision D1-b): the body comes from the ONE
1953:  # shared generator in _framework_manifest_set.sh — never a private heredoc.
1954:  # INV-4 existed because this function and install.sh each carried their own
1955:  # copy of this text: install substituted {{PROTOCOL_SOURCE}}, this one did
1956:  # not — two bodies for the same file, and the recorded digest never matched
1957:  # the disk (OWN-0074). A missing generator preserves the surface (upgrade's
1958:  # fail-toward-preservation posture, same as an illegal cell below).
1959:  if ! command -v _render_protocol_pointer >/dev/null 2>&1; then
1960:    echo "    WARNING: _render_protocol_pointer unavailable — PROTOCOL.md pointer PRESERVED" >&2
1961:    return 0
1962:  fi
1963:
1964:  # Resolve the PROTOCOL_SOURCE the pointer should name (AC-6c, Owner
1965:  # decision D3). Precedence:
1966:  #   1. request.placeholders.PROTOCOL_SOURCE from the install-state — the
1967:  #      install has ALWAYS persisted it there (union across runs; the
1968:  #      PLAN-168 debate's claim that it was never persisted checked the
1969:  #      wrong key — codex rail r1 P1).
1970:  #   2. A HEALTHY on-disk pointer: extract the value it already names and
1971:  #      keep it — never silently rename a sound pointer to today's checkout.
1972:  #   3. $SOURCE_DIR (this upgrade's checkout) — last resort, used for
1973:  #      genuinely old installs with no state and no sound pointer (incl.
1974:  #      the degraded-cure path, where the pointer names nothing usable).
1975:  local _ptr_psource=""
1976:  if [ -f "$_INSTALL_STATE_FILE" ] && command -v python3 >/dev/null 2>&1; then
1977:    _ptr_psource="$( python3 - "$_INSTALL_STATE_FILE" <<'PYEOF' 2>/dev/null || true
1978:import json, sys
1979:try:
1980:    with open(sys.argv[1], "r", encoding="utf-8") as f:
1981:        doc = json.load(f)
1982:    v = (doc.get("request") or {}).get("placeholders", {}).get("PROTOCOL_SOURCE", "")
1983:    # PLAN-169 W3.1 - B.a, R-SEC8: POSITIVE charset allowlist. A value
1984:    # carrying newline or control chars previously flowed into a sed
1985:    # replacement under set -e and ABORTED the upgrade mid-flight.
1986:    # Reject means empty means route D3 fallback. The caller emits the
1987:    # WARNING naming the rejected key - asserted by the land battery.
1988:    # NOTE: keep this comment free of apostrophes, backticks and parens;
1989:    # the bash command-substitution scanner mis-parses them in heredocs.
1990:    import re as _re
1991:    if (isinstance(v, str) and v and "{{" not in v
1992:            and _re.match(r"\A[A-Za-z0-9._/ ~-]{1,512}\Z", v)):
1993:        sys.stdout.write(v)
1994:except Exception:
1995:    pass
1996:PYEOF
1997:)"
1998:    # W3.1: a present-but-rejected key must be LOUD — silence here would be
1999:    # a silent change of pointer ownership (the filter empties the value and
2000:    # the D3 fallback quietly takes over). Plain grep on a file: no pipe, no
2001:    # SIGPIPE class.
2002:    if [ -z "$_ptr_psource" ] && grep -q '"PROTOCOL_SOURCE"' "$_INSTALL_STATE_FILE" 2>/dev/null; then
2003:      echo "    WARNING: install-state key PROTOCOL_SOURCE present but REJECTED by the charset allowlist (control chars / newline?) — falling back to route D3 (this checkout's family)." >&2
2004:    fi
2005:  fi
2006:  if [ -z "$_ptr_psource" ] && [ -f "$pointer" ]; then
2007:    # D3 route 2: trust a SOUND pointer. Extract the source it names and
2008:    # accept it only if re-rendering with that value reproduces the file
2009:    # byte-for-byte (the same reconstruction discipline as the degraded
2010:    # recognizer — anything else is adopter content, not a source of truth).
2011:    local _ptr_cand
2012:    _ptr_cand="$( sed -n 's|^\(.*\)/PROTOCOL\.md$|\1|p' "$pointer" 2>/dev/null | sed -n '1p' )"
2013:    if [ -n "$_ptr_cand" ] && [ "${_ptr_cand#\{\{}" = "$_ptr_cand" ]; then
2014:      if _render_protocol_pointer "$SOURCE_DIR" "$TARGET" "$PROFILE" "$STACK" "$_ptr_cand" \
2015:           | cmp -s - "$pointer" 2>/dev/null; then
2016:        _ptr_psource="$_ptr_cand"
2017:      fi
2018:    fi
2019:  fi
2020:  if [ -z "$_ptr_psource" ]; then
2021:    _ptr_psource="$SOURCE_DIR"
2022:  fi
2023:
2024:  local _ptr_full
2025:  _ptr_full="$( _render_protocol_pointer "$SOURCE_DIR" "$TARGET" "$PROFILE" "$STACK" "$_ptr_psource" )"
2026:
2027:  # The CANONICAL digest: the hash of exactly what the framework WOULD write.
2028:  # Computed on every path, because the baseline rewrite must record it even
2029:  # when the pointer is preserved — recording the customised bytes instead
2030:  # would make the NEXT upgrade read H_dst == H_base and clobber them (C.5).
2031:  # Post-PLAN-168 this is the hash of the SUBSTITUTED body — the same bytes
2032:  # install writes — so the recorded digest finally matches the disk (INV-4).
2033:  _REFRESH_PROTOCOL_CANON_HASH=""
2034:  if command -v _hash_stdin >/dev/null 2>&1; then
2035:    _REFRESH_PROTOCOL_CANON_HASH="$( printf '%s\n' "$_ptr_full" | _hash_stdin 2>/dev/null || true )"
2036:  fi
2037:
2038:  # ---- OBSERVE -------------------------------------------------------------
2039:  local _lt _pr _lc
2040:  _lt="$( _ov_obs_live_type "$pointer" )"
2041:  _pr="$( _ov_obs_prior_record "PROTOCOL.md" )"
2042:  if [ "$_lt" != "regular" ]; then
2043:    _lc="-"
2044:  elif _protocol_pointer_is_degraded "$pointer"; then
2045:    # PLAN-168 W2 (AC-6b, Owner decision D2): byte-exact reconstruction of
2046:    # the {{PROTOCOL_SOURCE}}-literal template this script used to write.
2047:    # Framework garbage, not adopter content — the verdict routes it to the
2048:    # REFRESH cure below. Checked BEFORE pristine/edited: a degraded body
2049:    # can never equal the substituted canonical, and classifying it `edited`
2050:    # is exactly the immortal-defect route this wave closes.
2051:    _lc="degraded"
2052:  elif [ -n "$_REFRESH_PROTOCOL_CANON_HASH" ] \
2053:       && [ "$( _hash_file "$pointer" 2>/dev/null || true )" = "$_REFRESH_PROTOCOL_CANON_HASH" ]; then
2054:    _lc="pristine"
2055:  else
2056:    _lc="edited"
2057:  fi
2058:
2059:  # ---- DECIDE --------------------------------------------------------------
2060:  local _pair _verdict
2061:  if ! _pair="$( _ownership_verdict protocol "$_pr" "$_lt" "$_lc" yes copy \
2062:                   "$CEREMONY_EFFECTIVE" upgrade none )"; then
2063:    echo "    WARNING: PROTOCOL.md dimensions are not a legal cell — PRESERVED" >&2
2064:    return 0
2065:  fi
2066:  _verdict="${_pair%% *}"
2067:  _PROTOCOL_HASH_SOURCE="${_pair##* }"
2068:
2069:  # ---- EXECUTE -------------------------------------------------------------
2070:  # The guards this surface never had are not new branches: they are what the
2071:  # decision already says. A destination that is not a regular file is
2072:  # adopter-owned, so the verdict is unowned and nothing is written — which is
2073:  # exactly the leaf-symlink / directory / FIFO protection SPEC and the marker
2074:  # acquired during the S296 rounds and the pointer did not.
2075:  case "$_verdict" in
2076:    PRESERVE_UNOWNED|OMIT_RECORD)
2077:      case "$_lt" in
2078:        symlink) echo "    SKIP: PROTOCOL.md is a symlink — refusing to write THROUGH it (would mutate a path outside the target)" >&2 ;;
2079:        dir|dir_empty) echo "    SKIP: PROTOCOL.md is a directory — adopter-owned, refusing to write into it" >&2 ;;
2080:        special) echo "    SKIP: PROTOCOL.md is an unsupported special file — preserved, surface untouched" >&2 ;;
2081:        *) echo "    SKIP: PROTOCOL.md pointer (recorded --ceremony user install — a user install never creates root files, WS4)" ;;
2082:      esac
2083:      return 0
2084:      ;;
2085:
2086:    PRESERVE_OWNED)
2087:      _PROTOCOL_DELIVERED=1
2088:      if [ "$_lc" = "edited" ]; then
2089:        # ADR-155 decision (iii): the verified S238 case. An adopter-customised
2090:        # pointer is CONTENT, not a fork — it is preserved, and the record keeps
2091:        # the canonical digest so the next upgrade does not read it as pristine.
2092:        if [ "$DRY_RUN" -eq 0 ] && [ -f "$pointer" ]; then
2093:          mkdir -p "$BAK_DIR" 2>/dev/null || true
2094:          cp "$pointer" "$BAK_DIR/PROTOCOL.md" 2>/dev/null || true
2095:        fi
2096:        echo "    PRESERVED (root PROTOCOL.md is adopter-customised — pointer NOT refreshed; backup in $BAK_DIR/PROTOCOL.md)" >&2
2097:      else
2098:        echo "    SKIP: PROTOCOL.md pointer (ownership carried forward)"
2099:      fi
2100:      return 0
2101:      ;;
2102:
2103:    DELIVER|REFRESH)
2104:      if [ "$DRY_RUN" -eq 1 ]; then
2105:        echo "    (dry-run) would REFRESH: PROTOCOL.md pointer"
2106:        return 0
2107:      fi
2108:      _up_record_op "refresh_protocol_pointer" "PROTOCOL.md"
2109:      # Backup-always before the overwrite, even with no baseline manifest —
2110:      # this is what made the S238 loss recoverable on a FIRST upgrade.
2111:      if [ -f "$pointer" ]; then
2112:        mkdir -p "$BAK_DIR" 2>/dev/null || true
2113:        cp "$pointer" "$BAK_DIR/PROTOCOL.md" 2>/dev/null || true
2114:        echo "    BACKED UP: PROTOCOL.md (root) -> $BAK_DIR/PROTOCOL.md"
2115:      fi
2116:      printf '%s\n' "$_ptr_full" > "$pointer"
2117:      _PROTOCOL_DELIVERED=1
2118:      if [ "$_lc" = "degraded" ]; then
2119:        echo "    CURED: PROTOCOL.md pointer was framework-degraded ({{PROTOCOL_SOURCE}} left literal by an old upgrade) — refreshed; original in $BAK_DIR/PROTOCOL.md"
2120:      else
2121:        echo "    REFRESHED: PROTOCOL.md pointer"
2122:      fi
2123:      return 0
2124:      ;;
2125:  esac
2126:}
2127:
2128:# ===========================================================================
2129:# PLAN-166 F3 (ADR-155-AMEND-1) — delivery-record lookups + SPEC/v1 FORCED
2130:# refresh + framework version marker refresh.
2131:# ---------------------------------------------------------------------------
2132:# Ownership of the three conditional surfaces (PROTOCOL.md, SPEC/v1,
2133:# .claude/.framework-version) derives from the REGISTERED DELIVERY — here,
2134:# the PRE-upgrade baseline manifest records (the same record install.sh
2135:# writes and doctor.sh reads) — never from the ceremony alone and never from
2136:# file presence (r7/r13/r17/r19/r20).
2137:# ===========================================================================
2138:_baseline_has_spec_record() {
2139:  [[ -n "$_BASELINE_MANIFEST_FILE" && -f "$_BASELINE_MANIFEST_FILE" ]] || return 1
2140:  # `(/|  |$)` and not a bare trailing slash: a --mode link install records
2141:  # the WHOLE tree as one directory symlink — `LINK  SPEC/v1  <target>`, no
2142:  # trailing slash — which a `SPEC/v1/` fragment can never match (the same
2143:  # `(  |$)` treatment the marker/PROTOCOL readers already have; family
2144:  # swept with doctor.sh _dr_delivered, re-pass closure).
2145:  grep -Eq '^([0-9a-f]{64}|LINK)  SPEC/v1(/|  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null
2146:}
2147:_baseline_has_marker_record() {
2148:  [[ -n "$_BASELINE_MANIFEST_FILE" && -f "$_BASELINE_MANIFEST_FILE" ]] || return 1
2149:  grep -Eq '^([0-9a-f]{64}|LINK)  \.claude/\.framework-version(  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null
2150:}
2151:# Third sibling of the family (codex W1 round 7, P2): the `--ceremony user`
2152:# skip needs the same ownership-continuity question the SPEC/marker skips
2153:# already ask. `_baseline_lookup` is not a substitute — it resolves HASH
2154:# records only, and a --mode link PROTOCOL.md is a LINK record.
2155:_baseline_has_protocol_record() {
2156:  [[ -n "$_BASELINE_MANIFEST_FILE" && -f "$_BASELINE_MANIFEST_FILE" ]] || return 1
2157:  grep -Eq '^([0-9a-f]{64}|LINK)  PROTOCOL\.md(  |$)' "$_BASELINE_MANIFEST_FILE" 2>/dev/null
2158:}
2159:
2160:# PRISTINE fingerprints of every SPEC/v1 tree the framework shipped at
2161:# v1.2.0 and earlier (r20 LEGACY MIGRATION: v1.2-and-earlier installs never
2162:# enumerated SPEC/v1, so no historical delivery record can distinguish a
2163:# framework-installed SPEC from an adopter's own — the ambiguity resolves by
2164:# CONTENT). Derivation (deterministic — pinned tag content; run in the
2165:# framework repo, reproduces _spec_tree_fingerprint byte-for-byte):
2166:#   for t in v1.0.0 v1.0.1 v1.0.1-rc.1 v1.1.0 v1.1.0-rc.1 \
2167:#            v1.2.0 v1.2.0-rc.1 v1.2.0-rc.2 v1.2.0-rc.3; do
2168:#     git ls-tree -r --name-only "$t" -- SPEC/v1 | LC_ALL=C sort \
2169:#     | while IFS= read -r f; do
2170:#         printf '%s  %s\n' \
2171:#           "$(git show "$t:$f" | shasum -a 256 | awk '{print $1}')" "$f"
2172:#       done | shasum -a 256 | awk '{print $1}'
2173:#   done
2174:# Three distinct trees across the nine shipped tags:
2175:#   a4a4... = v1.0.0 / v1.0.1 / v1.0.1-rc.1
2176:#   94aa... = v1.1.0 / v1.1.0-rc.1
2177:#   469a... = v1.2.0 / v1.2.0-rc.1 / v1.2.0-rc.2 / v1.2.0-rc.3
2178:_SPEC_PRISTINE_FINGERPRINTS="a4a4504a224d72a975a853dd71a75d8e678fef034a70deb49df291dbb712c161 94aa62f781285ce4897ad1220edf15e97b4e9d7b629f9f7ba3389da5d45f22b1 469a49238867be181490214305b43bc7299f2bae3ef0b282a5452f6caf327f0b"
2179:
2180:# _spec_tree_fingerprint <root> — sha256 over the LC_ALL=C-sorted
2181:# "<sha256(file)>  <relpath>" lines of every regular file under
2182:# <root>/SPEC/v1 (the derivation comment above reproduces this from a tag).
2183:# Fails (rc 1, no output) on a missing tree/hasher or any unhashable file —
2184:# a PARTIAL fingerprint must never be compared against a pristine one.
2185:_spec_tree_fingerprint() {
2186:  local _sf_root="$1"
2187:  command -v _hash_file >/dev/null 2>&1 || return 1
2188:  command -v _hash_stdin >/dev/null 2>&1 || return 1
2189:  [[ -d "$_sf_root/SPEC/v1" ]] || return 1
2190:  # COMPLETENESS gate (codex W1-ceremony round, P2): the fingerprint hashes
2191:  # regular files only, so an adopter-ADDED symlink/fifo/etc would be
2192:  # invisible — the partial fingerprint could still byte-match a pristine
2193:  # release and the forced refresh would REPLACE an adopter-modified tree
2194:  # (the S238 class). Any non-regular, non-directory entry => no
2195:  # fingerprint (rc 1) => the caller's safe path (ADOPTER-FORK preserve).
2196:  # A find traversal error (unreadable subdir) is the same: partial
2197:  # inventory must never be compared against a pristine fingerprint.
2198:  local _sf_odd
2199:  _sf_odd="$( ( cd "$_sf_root" && find SPEC/v1 -mindepth 1 ! -type f ! -type d -print 2>&1 ) )" || return 1
2200:  [[ -z "$_sf_odd" ]] || return 1
2201:  local _sf_lines
2202:  _sf_lines="$(
2203:    ( cd "$_sf_root" && find SPEC/v1 -type f -print 2>/dev/null ) \
2204:      | LC_ALL=C sort | while IFS= read -r _sf_rel; do
2205:          [[ -n "$_sf_rel" ]] || continue
2206:          _sf_h="$( _hash_file "$_sf_root/$_sf_rel" 2>/dev/null || true )"
2207:          if [[ -z "$_sf_h" ]]; then
2208:            printf 'HASH-FAILED\n'
2209:            break
2210:          fi
2211:          printf '%s  %s\n' "$_sf_h" "$_sf_rel"
2212:        done
2213:  )"
2214:  case "$_sf_lines" in
2215:    ""|*HASH-FAILED*) return 1 ;;
2216:  esac
2217:  printf '%s\n' "$_sf_lines" | _hash_stdin
2218:}
