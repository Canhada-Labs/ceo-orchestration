1067:# --- rail round-3 F5: "is a CODEOWNERS surface already at the target?" ------
1068:# ONE definition, consulted by BOTH mutually-exclusive branches. `-e` alone is
1069:# FALSE for a DANGLING symlink, so a target whose .github/CODEOWNERS is a link
1070:# to a not-yet-existing file read as ABSENT and the .template route installed
1071:# alongside it — two active surfaces the moment the link target appears, which
1072:# no install ever produces, and permanently (the next upgrade finds the
1073:# template IDENTICAL and never removes it).
1074:# A symlink of ANY kind counts as PRESENT: _up_tpl_symlink_refuses already
1075:# refuses to write through a link at this destination, so "occupied" and "not
1076:# ours to overwrite" are the same answer here. Two branches asking the same
1077:# question two different ways is how this class was born (rail round-1 F5), so
1078:# the question gets exactly one implementation.
1079:_up_codeowners_present() {
1080:  [ -e "$TARGET/.github/CODEOWNERS" ] || [ -L "$TARGET/.github/CODEOWNERS" ]
1081:}
1082:
1083:# rc.1 r12: a regular file or FIFO at docs/, .github/ or a deeper
1084:# destination ancestor used to pass confinement, then abort a late mkdir
1085:# under set -e after other upgrade writes. Answer for the validated delivery
1086:# destinations before even creating the backup directory. Refusal preserves
1087:# the previous manifest/install-state byte-for-byte; it records no new run.
1088:# Existing symlink and hard-link policies remain at their existing guards.
1089:# rc.1 r12: accumulator OUTSIDE the branch — the SPEC/v1 forced route below
1090:# shares this gate and is not gated on _TEMPLATE_DELIVERY.
1091:_up_ancestor_refused=0
1092:if [[ "$_TEMPLATE_DELIVERY" -eq 1 ]]; then
1093:  # The handle a previous install recorded. Empty => this run cannot render
1094:  # CODEOWNERS, which is the SAME state install.sh is in without
1095:  # --github-owner, so the exclusivity below resolves to the .template branch
1096:  # exactly as install.sh's else at :1563 does.
1097:  #
1098:  # rail round-7 F4 — `request.github_owner` is a RECORDED REQUEST field, the
1099:  # same class as request.profile / request.stack / request.harness, and
1100:  # --no-replay is the documented opt-out from replaying the recorded request
1101:  # (:44-48, :406). Pre-cure this read was unconditional, so `--no-replay` on a
1102:  # target with a recorded handle still rendered and refreshed
1103:  # .github/CODEOWNERS with it — the option contradicted by the one field that
1104:  # never learned about it.
1105:  # This is NOT the `_read_install_state_ceremony` case (:838-846): that reader
1106:  # runs independently of REPLAY on purpose, because its fail-safe direction is
1107:  # to write LESS (a missing ceremony means "user", which touches nothing). The
1108:  # fail-safe direction here is the same one an absent handle already has —
1109:  # empty => the .template branch, exactly install.sh's else at :1563 — so
1110:  # honouring the opt-out costs no safety and removes a contradiction.
1111:  # There is no `--github-owner` flag on upgrade.sh (measured: 0 occurrences
1112:  # outside this block), so with --no-replay the handle is simply unknown.
1113:  _UP_GH_OWNER=""
1114:  if [ "${REPLAY:-1}" -eq 1 ]; then
1115:    if _UP_GH_OWNER="$( _read_install_state_github_owner )"; then
1116:      _UP_GH_OWNER="$( printf '%s' "$_UP_GH_OWNER" | tr -d '\n' )"
1117:    else
1118:      _UP_GH_OWNER=""
1119:    fi
1120:  fi
1121:  if ! command -v _wbm_dst_non_directory_ancestor_refuses >/dev/null 2>&1; then
1122:    echo "    ERROR: REFUSED delivery preflight — the ancestor predicate is unavailable" >&2
1123:    _up_ancestor_refused=1
1124:  elif ! command -v _wbm_route_dests >/dev/null 2>&1; then
1125:    # rc.1 r12: a missing route READER refuses too — falling through in
1126:    # silence enumerated ZERO destinations, a fail-OPEN hole in this gate.
1127:    echo "    ERROR: REFUSED delivery preflight — the route reader is unavailable" >&2
1128:    _up_ancestor_refused=1
1129:  else
1130:    # rc.1 r12: the reader's rc IS the table gate (a corrupted header answers
1131:    # 2). Refusing HERE (Codex review of the cure) exited before the delivery
1132:    # gate persisted `upgrade_succeeded: false` and printed `routes=0`
1133:    # (H.15e4/H.15f3 went red), so an unusable table is only NAMED here and
1134:    # DECIDED by that gate, which refuses it with exit 3 and the record; no
1135:    # route is written on a refused table, so there is no ancestor to ask.
1136:    _up_ancestor_dests=""
1137:    if ! _up_ancestor_dests="$( _wbm_route_dests )"; then
1138:      echo "    NOTE: delivery preflight — the delivery-route table did not enumerate; the delivery gate decides below" >&2
1139:      _up_ancestor_dests=""
1140:    fi
1141:    while IFS= read -r _up_ancestor_rel; do
1142:      [[ -n "$_up_ancestor_rel" ]] || continue
1143:      _path_is_skipped "$_up_ancestor_rel" && continue
1144:      # Ask only about destinations this run can write. The two CODEOWNERS
1145:      # branches share the validated replay decision and presence predicate
1146:      # used by delivery below; a skipped/inactive route must not veto docs.
1147:      case "$_up_ancestor_rel" in
1148:        .github/CODEOWNERS)
1149:          [ -n "$_UP_GH_OWNER" ] || continue
1150:          ;;
1151:        .github/CODEOWNERS.template)
1152:          if [ -n "$_UP_GH_OWNER" ] || _up_codeowners_present; then continue; fi
1153:          ;;
1154:      esac
1155:      # A pinned source tree can legitimately predate a declared destination.
1156:      # Its absent/unconfined source cannot reach a writer; leave its existing
1157:      # late SKIPPED/PRESERVED verdict intact, using the shared route reader.
1158:      if ! _wbm_route_meta "$_up_ancestor_rel" >/dev/null \
1159:         || ! _wbm_source_confined "$SOURCE_DIR" "$_WBM_ROUTE_SRC" \
1160:         || [ ! -f "$SOURCE_DIR/$_WBM_ROUTE_SRC" ]; then
1161:        continue
1162:      fi
1163:      if _wbm_dst_non_directory_ancestor_refuses "$TARGET" "$_up_ancestor_rel"; then
1164:        echo "    ERROR: REFUSED (nothing written): $_up_ancestor_rel — $_WBM_DST_REFUSE_WHY" >&2
1165:        _up_ancestor_refused=1
1166:      fi
1167:    done <<< "$_up_ancestor_dests"
1168:  fi
1169:fi
1170:
1171:# rc.1 r12: non-directory ancestor. SPEC/v1 is a FORCED route (PLAN-166 F3),
1172:# not a delivery-routes.tsv row, so the loop above cannot see it; a regular
1173:# file at $TARGET/SPEC aborted its late mkdir under set -e with 1247 entries
1174:# already written. ANCESTOR-ONLY, never _wbm_dst_refuses: the LEAF policy is
1175:# _ownership_verdict's (PLAN-167) and the full predicate refuses a `--mode
1176:# link` SPEC/v1, the delivery _refresh_spec_contract SKIPs by design.
1177:if [[ "$CEREMONY_EFFECTIVE" != "user" ]] \
1178:   && [ -d "$SOURCE_DIR/SPEC/v1" ] \
1179:   && ! _path_is_skipped "SPEC/v1"; then
1180:  if ! command -v _wbm_dst_non_directory_ancestor_refuses >/dev/null 2>&1; then
1181:    echo "    ERROR: REFUSED SPEC/v1 preflight — the ancestor predicate is unavailable" >&2
1182:    _up_ancestor_refused=1
1183:  elif _wbm_dst_non_directory_ancestor_refuses "$TARGET" "SPEC/v1"; then
1184:    echo "    ERROR: REFUSED (nothing written): SPEC/v1 — $_WBM_DST_REFUSE_WHY" >&2
1185:    _up_ancestor_refused=1
1186:  fi
1187:fi
