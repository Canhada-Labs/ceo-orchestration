  5513	  fi
  5514	  local pairs=(
  5515	    "target" "$TARGET"
  5516	    "profile" "$PROFILE"
  5517	    "stack" "$STACK"
  5518	    "on_conflict" "$ON_CONFLICT"
  5519	    "pin" "$PIN_REF"
  5520	    "replay_source" "$_REPLAY_SOURCE"
  5521	    "harness" "$HARNESS"
  5522	    "managed_hooks" "$CODEX_MANAGED_HOOKS"
  5523	    "ceremony_effective" "$CEREMONY_EFFECTIVE"
  5524	    "ceremony_persist" "$_CEREMONY_PERSIST"
