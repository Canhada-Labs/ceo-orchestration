269:      shift
270:      ;;
271:    --ceremony)
272:      # Re-pass rc.4 t3 (P1): explicit ceremony for PRE-STATE targets
273:      # (no readable .install-state.json). A RECORDED ceremony always
274:      # wins over this flag — the flag exists for the migration case.
275:      CEREMONY_FLAG="${2:-}"
276:      case "$CEREMONY_FLAG" in
277:        maintainer|user) : ;;
278:        *) echo "ERROR: --ceremony must be 'maintainer' or 'user' (got '$CEREMONY_FLAG')" >&2; exit 2 ;;
279:      esac
