1189:# rc.1 r12: ONE gate for the preflights above. Under --dry-run the preview
1190:# KEEPS RUNNING and the refusal is deferred to the rc, as install.sh does at
1191:# its own dry-run branch; truncating collapsed the preview from 146 lines to 5.
1192:_UP_ANCESTOR_REFUSED_DRY=0
1193:if [[ "$_up_ancestor_refused" -ne 0 ]]; then
1194:  if [[ "$DRY_RUN" -eq 1 ]]; then
1195:    echo "    (dry-run) PRE-FLIGHT: a real upgrade would REFUSE the destination(s) above and write NOTHING." >&2
1196:    _UP_ANCESTOR_REFUSED_DRY=1
1197:  else
1198:    echo "::error::upgrade REFUSED before its first target write — the target has NOT been touched." >&2
1199:    exit 3
1200:  fi
1201:fi
