1204:BAK_DIR="$TARGET/.claude.bak/$TIMESTAMP"
1205:
1206:IFS=',' read -r -a PROFILE_PARTS <<< "$PROFILE"
1207:
1208:echo "==> Upgrading ceo-orchestration"
1209:echo "    Source:  $SOURCE_DIR"
1210:echo "    Target:  $TARGET"
1211:echo "    Backup:  $BAK_DIR"
1212:echo "    Profile: $PROFILE"
1213:echo "    Stack:   $STACK"
1214:echo "    Ceremony: $CEREMONY_EFFECTIVE — $_CEREMONY_SOURCE"  # PLAN-166 F3
1215:if [[ "$_TEMPLATE_DELIVERY" -eq 1 ]]; then
1216:  echo "    docs/.github delivery: ENABLED — $_TEMPLATE_DELIVERY_SOURCE"   # PLAN-183 W5 OQ-5
1217:else
1218:  echo "    docs/.github delivery: DISABLED — $_TEMPLATE_DELIVERY_SOURCE"  # PLAN-183 W5 OQ-5
1219:fi
1220:if [[ "$_REPLAY_SOURCE" == "replay" ]]; then
1221:  echo "    Request: replayed from .claude/.install-state.json (PLAN-153 B2)"
1222:fi
1223:if [[ -n "$PIN_REF" ]]; then
1224:  echo "    Pinned:  $PIN_REF"
1225:fi
1226:echo ""
1227:
1228:# PLAN-161 U1: --dry-run must write NOTHING inside the target — eagerly
1229:# creating the (timestamped, thus always-new) backup dir was one of the three
1230:# dry-run-ignoring writer families found live in the 2026-07-21 adopter
1231:# upgrade. Real runs still create it up front (the U3 purge backup and the
1232:# agents-pin backup below rely on it existing).
1233:if [[ "$DRY_RUN" -eq 0 ]]; then
1234:  mkdir -p "$BAK_DIR"
1235:fi
1236:
1237:# PLAN-153 Wave B item B2 — upgrade operation journal (same shape as the
1238:# install-side journal): op<TAB>detail lines in a tempfile OUTSIDE $TARGET,
1239:# folded into .claude/.install-state.json by _write_upgrade_state at the end.
1240:# Dry-run never creates it. Fail-open throughout.
1241:if [[ "$DRY_RUN" -eq 0 ]]; then
1242:  _UP_OPS_FILE="$(mktemp "$( _up_tmpbase )/ceo-upgrade-ops.XXXXXX" 2>/dev/null || true)"
1243:fi
1244:_up_record_op() {
