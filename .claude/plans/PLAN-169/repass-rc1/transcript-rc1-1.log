  5537	import json, os, sys, tempfile, time
  5538	args = sys.argv[1:]
  5539	state_path, ops_path, fw_version = args[0], args[1], args[2]
  5540	n = int(args[3]); kv = args[4:4 + n]; up_argv = list(args[4 + n:])
  5541	vals = {}
  5542	i = 0
  5543	while i + 1 < len(kv):
  5544	    vals[kv[i]] = kv[i + 1]; i += 2
  5545	ops = []
  5546	if ops_path and os.path.isfile(ops_path):
  5547	    try:
  5548	        with open(ops_path, "r", encoding="utf-8", errors="replace") as f:
  5549	            for line in f:
  5550	                line = line.rstrip("\n")
  5551	                if not line:
  5552	                    continue
  5553	                parts = line.split("\t", 1)
  5554	                ops.append({"op": parts[0], "detail": parts[1] if len(parts) > 1 else ""})
