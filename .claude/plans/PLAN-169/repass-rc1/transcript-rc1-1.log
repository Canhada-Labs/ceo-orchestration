3338:# ===========================================================================
3339:# PLAN-163 T5.4 — BASELINE-AWARE settings migration (3-state per LEAF KEY).
3340:# ---------------------------------------------------------------------------
3341:# WHY: the H8 merge above only registers lifecycle hooks — an adopter whose
3342:# settings.json is otherwise preserved would NEVER receive the Claude-5
3343:# fleet refresh (availableModels/fallbackModel) nor the defaultMode posture.
3344:# This step migrates EXACTLY the leaf keys enumerated in _T54_BASELINES_JSON
3345:# (the normative table above) with an explicit, IDEMPOTENT policy per key:
3346:#   ABSENT                    -> write the NEW baseline
3347:#   EQUAL to the OLD baseline -> update to the NEW baseline
3348:#       (arrays byte-compared: exact values in exact order)
3349:#   CUSTOMIZED (anything else)-> PRESERVE + named WARNING (never clobber)
3350:#   already at the NEW baseline -> no-op (so a re-run changes nothing)
3351:# New-event registrations (DirectoryAdded/Notification) are added ONLY when
3352:# not yet registered AND the T3.4 version-floor feature gate is on
3353:# (_t34_new_event_registrations_enabled). Customized registrations under the
3354:# same events — and every other hooks entry/settings key — stay untouched.
3355:# PLAN-164 W1 (ADR-110-AMEND-1, recalibrated by ADR-110-AMEND-2): the
3356:# check_pair_rail.py PreToolUse registration TIMEOUT VALUE migrates under
3357:# the same 3-state policy — any frozen SUPERSEDED SHIPPED cap (60, 150)
3358:# -> the cap DERIVED from the template artifact
3359:# (templates/settings/settings.base.json pair-rail entry; install.sh copies
3360:# it verbatim, so template value == post-install value == migration target);
3361:# any other adopter-chosen value is PRESERVED + named WARNING; idempotent.
3362:# The file is rewritten ONLY when at least one key actually changed (atomic
3363:# same-directory tempfile + os.replace), so running the upgrade twice is
3364:# byte-identical (idempotency oracle). Fail-open per CLAUDE.md §4: missing
3365:# python3 / unreadable settings / write error => stderr NOTE + the upgrade
3366:# proceeds; a backup always lands under $BAK_DIR first on non-dry runs.
3367:# Opt out: --no-settings-migrate. --dry-run previews every verdict.
3368:# ===========================================================================
3369:_migrate_settings_baseline() {
3370:  [[ "$SETTINGS_MIGRATE" -eq 1 ]] || return 0
3371:  local settings="$TARGET/.claude/settings.json"
3372:  if [[ ! -f "$settings" ]]; then
3373:    echo "    NOTE: settings baseline migration skipped — no $settings (fresh install builds it from template)" >&2
3374:    return 0
3375:  fi
3376:  if ! command -v python3 >/dev/null 2>&1; then
3377:    echo "    NOTE: settings baseline migration skipped (python3 not found) — advisory only" >&2
3378:    return 0
3379:  fi
3380:
3381:  echo ""
3382:  echo "==> Settings baseline migration (PLAN-163 T5.4 — 3-state per leaf key)"
3383:
3384:  local _mig_mode="apply"
3385:  local _mig_gate="0"
3386:  # PLAN-164 W1: the pair-rail registration-timeout migration target is
3387:  # DERIVED from the source template artifact (see the helper below).
3388:  local _mig_template="$SOURCE_DIR/templates/settings/settings.base.json"
3389:  if [[ "$DRY_RUN" -eq 1 ]]; then
3390:    _mig_mode="preview"
3391:  fi
3392:  if _t34_new_event_registrations_enabled; then
3393:    _mig_gate="1"
3394:  fi
3395:
3396:  if [[ "$_mig_mode" == "apply" ]]; then
3397:    _up_record_op "migrate_settings_baseline" "3-state per-leaf-key settings migration (T5.4)"
3398:    mkdir -p "$BAK_DIR/.claude" 2>/dev/null || true
3399:    cp "$settings" "$BAK_DIR/.claude/settings.json.pre-t54-migration" 2>/dev/null || true
3400:    echo "    BACKED UP: .claude/settings.json -> $BAK_DIR/.claude/settings.json.pre-t54-migration"
3401:  fi
3402:
3403:  # argv-pass invocation (never source-string interpolation); python3 -I +
3404:  # PYTHONNOUSERSITE=1 shrink the env-driven import surface (same idiom as
3405:  # the B2 state reader/writer above).
3406:  if ! PYTHONNOUSERSITE=1 python3 -I -c '
3407:import json, os, sys, tempfile
3408:
3409:mode = sys.argv[1]
3410:path = sys.argv[2]
3411:baselines = json.loads(sys.argv[3])
3412:emit_new = sys.argv[4] == "1"
3413:dry = mode == "preview"
3414:MISSING = object()
3415:
3416:
3417:def out(msg):
3418:    sys.stdout.write("    " + msg + "\n")
3419:
3420:
3421:def warn(msg):
3422:    sys.stderr.write("    " + msg + "\n")
3423:
3424:
3425:def act(msg):
3426:    if dry:
3427:        out("(dry-run) would " + msg)
3428:    else:
3429:        out(msg)
3430:
3431:
3432:try:
3433:    with open(path, "r", encoding="utf-8") as f:
3434:        data = json.load(f)
3435:except (OSError, ValueError):
3436:    sys.exit(3)
3437:if not isinstance(data, dict):
3438:    sys.exit(3)
3439:
3440:changed = [False]
3441:
3442:# --- 3-state policy, top-level ARRAY leaf keys (byte-compared: exact
3443:# --- values in exact order; a re-ordered array counts as CUSTOMIZED).
3444:# --- eff_available_models captures the EFFECTIVE availableModels value AFTER
3445:# --- this loop resolves its branch (SET/MIGRATE => new baseline; already-new
3446:# --- or CUSTOMIZED => the current value PRESERVED). It is computed
3447:# --- independently of the `if not dry` write guard so it holds in BOTH apply
3448:# --- and dry-run modes, and it is the allowlist the model-pin SET below must
3449:# --- respect (this loop runs BEFORE the model leaf — order is normative).
3450:eff_available_models = MISSING
3451:for key in ("availableModels", "fallbackModel"):
3452:    spec = baselines[key]
3453:    cur = data.get(key, MISSING)
3454:    resolved = cur  # the effective value the key WILL carry post-migration
3455:    if cur is MISSING:
3456:        if not dry:
3457:            data[key] = list(spec["new"])
3458:        resolved = list(spec["new"])
3459:        changed[0] = True
3460:        act("SET (absent -> new baseline): " + key)
3461:    elif cur == spec["new"]:
3462:        out("OK (already at new baseline): " + key)
3463:    elif cur == spec["old"]:
3464:        if not dry:
3465:            data[key] = list(spec["new"])
3466:        resolved = list(spec["new"])
3467:        changed[0] = True
3468:        act("MIGRATE (matched OLD baseline -> new baseline): " + key)
3469:    elif cur in spec.get("superseded", []):
3470:        # ADR-149 Amendment 2 (S338): a previously SHIPPED baseline
3471:        # (frozen literal, byte-exact incl. order) migrates like OLD.
3472:        if not dry:
3473:            data[key] = list(spec["new"])
3474:        resolved = list(spec["new"])
3475:        changed[0] = True
3476:        act("MIGRATE (matched SUPERSEDED shipped baseline -> new baseline): " + key)
3477:    else:
3478:        warn("WARNING: " + key + " is ADOPTER-CUSTOMIZED - PRESERVED "
3479:             "(not migrated to the new baseline)")
3480:    if key == "availableModels":
3481:        eff_available_models = resolved
3482:
3483:# --- model (top-level SCALAR session-default pin; ADR-181 T1.1 anti-silent-
3484:# --- flip). The OLD baseline has NO top-level "model" leaf, so ABSENCE == the
3485:# --- old baseline: SET the new pin. An EXPLICIT null is treated as ABSENT for
3486:# --- the SET decision (null is not a deliberate model choice — no session-
3487:# --- default pin), NOT as a customized value. The SET is CONDITIONAL on the
3488:# --- pin being a member of the EFFECTIVE availableModels resolved above (C6):
3489:# --- an adopter who customized availableModels to EXCLUDE claude-opus-5 would
3490:# --- otherwise get a session-default pin OUTSIDE their own allowlist, which
3491:# --- enforceAvailableModels rejects. If the pin is not provably in the
3492:# --- effective allowlist (excluded, or the allowlist is not a JSON list we can
3493:# --- test) we do NOT pin and emit a NAMED warn, leaving the session default to
3494:# --- the harness/adopter. Any PRESENT non-null value != the new pin is adopter-
3495:# --- custom -> PRESERVED with a named WARN (never re-flipped); no-value-echo
3496:# --- (the adopter value is not printed, only the key name).
3497:spec = baselines["model"]
3498:pin = spec["new"]
3499:cur = data.get("model", MISSING)
3500:absent_or_null = cur is MISSING or cur is None
3501:pin_in_effective_allowlist = (
