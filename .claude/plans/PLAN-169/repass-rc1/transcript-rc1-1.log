  3105	          reduce ($te.value[]?) as $blk (.;
  3106	              ( if (.hooks | has($te.key)) then .hooks[$te.key] else [] end ) as $cur
  3107	            | ( $blk | _keys )                    as $k
  3108	            | ( [ $cur[] | _keys[] ] )            as $have
