  5504	_write_upgrade_state() {
  5505	  [[ "$DRY_RUN" -eq 0 ]] || return 0
  5506	  if ! command -v python3 >/dev/null 2>&1; then
  5507	    echo "    NOTE: install-state not (re)written (python3 not found) — the next upgrade uses the ADR-155 fallback path" >&2
