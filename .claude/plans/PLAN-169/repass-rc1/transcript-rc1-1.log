2220:
2221:# =============================================================================
2222:# PLAN-167 W2.2 — OBSERVERS.
2223:#
2224:# The callers no longer decide. They observe the nine dimensions, hand them to
2225:# _ownership_verdict, and execute what comes back. Everything below answers a
2226:# question about the world; nothing below chooses an outcome.
2227:#
2228:# That separation is the entire point. In S296 the answer to "is this owned?"
2229:# was recomputed inline at every branch, so two branches could answer the same
2230:# question differently and nothing detected the contradiction.
2231:# =============================================================================
2232:
2233:# _ov_obs_live_type <abs path> — lstat vocabulary, never following.
2234:_ov_obs_live_type() {
2235:  _olt_p="$1"
2236:  # Classify NON-REGULAR entries before anything opens the path. `ls -A` on a
2237:  # FIFO blocks forever waiting for a writer, so testing -d before -p turned
2238:  # the observer itself into the hang it was written to detect.
2239:  if   [ -L "$_olt_p" ]; then printf 'symlink'
2240:  elif [ ! -e "$_olt_p" ]; then printf 'absent'
2241:  elif [ -p "$_olt_p" ] || [ -S "$_olt_p" ]; then printf 'special'
2242:  elif [ -d "$_olt_p" ]; then
2243:    if [ -z "$( ls -A "$_olt_p" 2>/dev/null )" ]; then printf 'dir_empty'; else printf 'dir'; fi
2244:  elif [ -f "$_olt_p" ]; then printf 'regular'
2245:  else printf 'special'; fi
2246:}
2247:
2248:# _ov_obs_prior_record <relpath> — what the PRE-run sanitized baseline says.
2249:# link_match only when the recorded target still equals the live readlink; a
2250:# LINK row whose target moved is link_retargeted, and so is a LINK row whose
2251:# live path is no longer a symlink at all (readlink yields empty, which never
2252:# equals a recorded non-empty target).
2253:_ov_obs_prior_record() {
2254:  _opr_rel="$1"
2255:  [ -n "${_BASELINE_MANIFEST_FILE:-}" ] && [ -f "$_BASELINE_MANIFEST_FILE" ] || { printf 'none'; return 0; }
2256:  # Refuse a relpath flagged as duplicate/ambiguous during load — same guard
2257:  # as _baseline_lookup (Codex R1 P0#2). Without this, the raw greps below
2258:  # would answer 'hash'/'link_match' from a duplicated manifest line and the
2259:  # verdict would authorize a forced replace on ambiguous evidence
2260:  # (repass-r2 part-a V1; the S294 compose-wrong class).
2261:  case "${_BASELINE_INVALID:-}" in
2262:    *"
2263:$_opr_rel
2264:"*) printf 'none'; return 0 ;;
2265:  esac
2266:  # Superficie AGREGADA (SPEC/v1): o grep de hash abaixo casa por
2267:  # PREFIXO (rel(/|$)), entao um DESCENDENTE duplicado/ambiguo
2268:  # (ex.: SPEC/v1/foo.md 2x) tambem contamina a evidencia do agregado
2269:  # — a linha retida responderia 'hash' e autorizaria refresh forcado
2270:  # (pair-rail S300 r18; extensao da mesma classe V1).
2271:  while IFS= read -r _opr_inv; do
2272:    [ -n "$_opr_inv" ] || continue
2273:    case "$_opr_inv" in
2274:      "$_opr_rel"/*) printf 'none'; return 0 ;;
2275:    esac
2276:  done <<OPRINV
2277:${_BASELINE_INVALID:-}
2278:OPRINV
2279:  _opr_link="$( grep -E "^LINK  ${_opr_rel}  " "$_BASELINE_MANIFEST_FILE" 2>/dev/null | head -1 || true )"
2280:  if [ -n "$_opr_link" ]; then
2281:    # Fixed double-space delimiter, never whitespace field-splitting: a
2282:    # checkout path containing a space made awk '{print $3}' read an unchanged
2283:    # delivery as redirected.
2284:    _opr_rec="${_opr_link#LINK  ${_opr_rel}  }"
2285:    _opr_live="$( readlink "$TARGET/$_opr_rel" 2>/dev/null || true )"
2286:    if [ -n "$_opr_rec" ] && [ "$_opr_rec" = "$_opr_live" ]; then printf 'link_match'
2287:    else printf 'link_retargeted'; fi
2288:    return 0
2289:  fi
2290:  if grep -Eq "^[0-9a-f]{64}  ${_opr_rel}(/|$)" "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
2291:    printf 'hash'; return 0
2292:  fi
2293:  printf 'none'
2294:}
2295:
2296:# _ov_obs_spec_content — pristine | legacy_pristine | legacy_pristine_partial
2297:#                        | edited | -
2298:# A tree the fingerprint cannot fully inventory is NOT "pristine with a note":
2299:# it is its own observable, because a partial inventory must never certify a
2300:# wholesale replace (ADR-155-AMEND-1 §4).
2301:_ov_obs_spec_content() {
2302:  [ -e "$TARGET/SPEC/v1" ] || { printf '-'; return 0; }
2303:  _osc_fp="$( _spec_tree_fingerprint "$TARGET" 2>/dev/null || true )"
2304:  if [ -z "$_osc_fp" ]; then
2305:    # No fingerprint. Distinguish "cannot inventory" (a non-regular entry is
2306:    # present) from "not comparable at all".
2307:    _osc_odd="$( ( cd "$TARGET" && find SPEC/v1 -mindepth 1 ! -type f ! -type d -print 2>/dev/null ) )"
2308:    if [ -n "$_osc_odd" ]; then printf 'legacy_pristine_partial'; else printf 'edited'; fi
2309:    return 0
2310:  fi
2311:  _osc_src="$( _spec_tree_fingerprint "$SOURCE_DIR" 2>/dev/null || true )"
2312:  if [ -n "$_osc_src" ] && [ "$_osc_fp" = "$_osc_src" ]; then printf 'pristine'; return 0; fi
2313:  for _osc_pf in $_SPEC_PRISTINE_FINGERPRINTS; do
2314:    if [ "$_osc_fp" = "$_osc_pf" ]; then printf 'legacy_pristine'; return 0; fi
2315:  done
2316:  printf 'edited'
2317:}
2318:
2319:# _ov_obs_skip <relpath> — none | self | descendant.
2320:# The descendant scan walks the UNION of source and target and includes every
2321:# removable entry, not just regular files: the forced route find-deletes them
2322:# all, so a target-only symlink must be visible to skip detection too.
2323:_ov_obs_skip() {
2324:  _osk_rel="$1"
2325:  if _path_is_skipped "$_osk_rel"; then printf 'self'; return 0; fi
2326:  if [ "$_osk_rel" = "SPEC/v1" ]; then
2327:    _osk_hit=""
2328:    while IFS= read -r _osk_f; do
2329:      [ -n "$_osk_f" ] || continue
2330:      if _path_is_skipped "$_osk_f"; then _osk_hit=1; break; fi
2331:    done <<EOF
2332:$( { ( cd "$SOURCE_DIR" && find SPEC/v1 ! -type d -print 2>/dev/null );
2333:     [ -d "$TARGET/SPEC/v1" ] && ( cd "$TARGET" && find SPEC/v1 ! -type d -print 2>/dev/null ); } | LC_ALL=C sort -u )
2334:EOF
2335:    [ -n "$_osk_hit" ] && { printf 'descendant'; return 0; }
2336:  fi
2337:  printf 'none'
2338:}
2339:
2340:# _ov_obs_mode — the delivery mode this run carries. Evidence order: a prior
2341:# LINK record (authoritative), else a symlink probe on the owned roots.
2342:_ov_obs_mode() {
2343:  if [ -n "${_BASELINE_MANIFEST_FILE:-}" ] && [ -f "$_BASELINE_MANIFEST_FILE" ] \
2344:     && grep -Eq '^LINK  ' "$_BASELINE_MANIFEST_FILE" 2>/dev/null; then
2345:    printf 'link'; return 0
2346:  fi
2347:  if [ -L "$TARGET/SPEC/v1" ] || [ -L "$TARGET/.claude/.framework-version" ]; then
2348:    printf 'link'; return 0
2349:  fi
2350:  printf 'copy'
2351:}
2352:
2353:# _refresh_spec_contract — SPEC/v1 takes a FORCED route, NOT the generic
2354:# backup_and_replace: for a directory target with a baseline, the classified
2355:# walk PRESERVES adopter edits — so from the 2nd upgrade on, an edited SPEC
2356:# would classify ADOPTER-CUSTOMIZED and the stale-contract class would
2357:# return (r6). SPEC/v1 is the published compliance CONTRACT: an adopter edit
2358:# is a FORK of the contract, not a customization (OQ-3) => backup to
2359:# $BAK_DIR/SPEC/v1 + replace.
2360:#   * ceremony: a recorded `--ceremony user` install NEVER receives SPEC/v1
2361:#     (mirrors install.sh WS4-guard-spec), independent of --no-replay (r9).
2362:#   * ownership: baseline SPEC records => framework-owned (forced refresh);
2363:#     no target SPEC => new delivery; target SPEC with NO record => LEGACY
2364:#     MIGRATION by pristine content (r20): match => framework-owned refresh,
2365:#     no match => ADOPTER-FORK: preserve + snapshot + named WARNING.
2366:#   * root VERSION: this function (and the whole upgrade) NEVER touches it —
2367:#     install_one is skip-if-exists, so on an adopter with its own VERSION
2368:#     the framework never wrote there; backup_and_replace would TAKE the
2369:#     file (the S238/ADR-155 "verified worst case", trap C.5). See
2370:#     ADR-155-AMEND-1 for why the asymmetry is deliberate.
2371:_SPEC_DELIVERED=0
2372:_refresh_spec_contract() {
2373:  local sdir="$SOURCE_DIR/SPEC/v1"
2374:  local ddir="$TARGET/SPEC/v1"
2375:  local bdir="$BAK_DIR/SPEC/v1"
2376:
2377:  # ---- OBSERVE -------------------------------------------------------------
2378:  # Nothing here chooses an outcome. Each line answers one question about the
2379:  # world, and the answers go to _ownership_verdict as the nine dimensions.
2380:  local _lt _pr _lc _sh _md _sk
2381:  if _lg_ancestor_is_symlink "$TARGET" "SPEC/v1"; then
2382:    _lt="ancestor_symlink"           # reachable only by writing THROUGH a symlink
2383:  else
2384:    _lt="$( _ov_obs_live_type "$ddir" )"
2385:  fi
2386:  _pr="$( _ov_obs_prior_record "SPEC/v1" )"
2387:  _lc="$( _ov_obs_spec_content )"
2388:  _sh=no; [ -d "$sdir" ] && _sh=yes
2389:  _md="$( _ov_obs_mode )"
2390:  _sk="$( _ov_obs_skip "SPEC/v1" )"
2391:
2392:  # ---- DECIDE --------------------------------------------------------------
2393:  local _pair _verdict _hash
2394:  if ! _pair="$( _ownership_verdict spec "$_pr" "$_lt" "$_lc" "$_sh" "$_md" \
2395:                   "$CEREMONY_EFFECTIVE" upgrade "$_sk" )"; then
2396:    # The decision function refuses combinations its legality rules forbid.
2397:    # Fail toward preserve — under-claiming is recoverable, over-claiming is
2398:    # the delete-the-adopter's-file class (ADR-155-AMEND-1 §3).
2399:    echo "    WARNING: SPEC/v1 dimensions are not a legal cell" >&2
2400:    echo "             ($_pr/$_lt/$_lc/$_sh/$_md/$CEREMONY_EFFECTIVE/$_sk) —" >&2
2401:    echo "             PRESERVED without ownership. Please report this combination." >&2
2402:    return 0
2403:  fi
2404:  _verdict="${_pair%% *}"; _hash="${_pair##* }"
2405:  _SPEC_HASH_SOURCE="$_hash"   # consumed by the baseline rewrite
2406:
2407:  # ---- EXECUTE -------------------------------------------------------------
2408:  case "$_verdict" in
2409:    PRESERVE_OWNED)
2410:      _SPEC_DELIVERED=1
2411:      case "$_lt/$_sk/$_sh" in
2412:        ancestor_symlink/*/*) echo "    SKIP: SPEC/v1 has a symlinked ancestor (refusing to write through it — F11a)" ;;
2413:        symlink/*/*)          echo "    SKIP: SPEC/v1 is the recorded --mode link delivery (target unchanged)" ;;
2414:        */self/*)             echo "    SKIPPED (--skip): SPEC/v1" ;;
2415:        */descendant/*)       echo "    SKIPPED (--skip matches a descendant): SPEC/v1 refreshes as ONE contract unit — preserving the whole tree" ;;
2416:        */*/no)               echo "    SKIP: SPEC/v1 absent in source (ownership carried forward)" ;;
2417:        *)                    echo "    SKIP: SPEC/v1 (recorded --ceremony user install — root surfaces are out of scope, WS4)" ;;
2418:      esac
2419:      return 0
2420:      ;;
2421:
2422:    PRESERVE_UNOWNED|OMIT_RECORD)
2423:      # An adopter-owned surface. The ONLY case that earns a snapshot plus
2424:      # recovery guidance is the true ADOPTER-FORK: content the framework
2425:      # cannot claim, with no gate having refused first.
2426:      if [ "$_lt" = "dir" ] || [ "$_lt" = "dir_empty" ]; then
2427:        if [ "$DRY_RUN" -eq 1 ]; then
2428:          echo "    (dry-run) would PRESERVE (SPEC/v1 ADOPTER-FORK): SPEC/v1"
2429:          return 0
2430:        fi
2431:        local _snap_ok=0
2432:        if mkdir -p "$( dirname "$bdir" )" 2>/dev/null && cp -R "$ddir" "$bdir" 2>/dev/null; then
2433:          _snap_ok=1
2434:        fi
2435:        # The token "ADOPTER-FORK" is CONTRACT, not prose: the §1869 route
2436:        # comment promises a NAMED warning, and the F3 e2e (S4) greps for it.
2437:        # The PLAN-167 rewrite dropped it — caught by that e2e on the PLAN-166
2438:        # land (44/45) and restored here (PLAN-168).
2439:        echo "    WARNING: SPEC/v1 ADOPTER-FORK — not framework-owned (no delivery" >&2
2440:        echo "             record; matches neither this checkout nor any pristine shipped SPEC)" >&2
2441:        if [ "$_snap_ok" -eq 1 ]; then
2442:          echo "             — PRESERVED in place (snapshot in $BAK_DIR/SPEC/v1)." >&2
2443:          echo "             To hand it back to the framework: remove the target SPEC/v1," >&2
2444:          echo "             copy this checkout's tree in, and re-run — a byte-identical" >&2
2445:          echo "             tree is taken over and recorded." >&2
2446:        else
2447:          # Recovery guidance is WITHHELD without a snapshot: following it
2448:          # would destroy the only copy of the fork.
2449:          echo "             — PRESERVED in place, but the forensic snapshot COULD NOT be" >&2
2450:          echo "             created. Back SPEC/v1 up yourself before any manual takeover." >&2
2451:        fi
2452:        _up_record_op "preserve_spec_v1_adopter_fork" "SPEC/v1"
2453:      else
2454:        echo "    SKIP: SPEC/v1 is $_lt — adopter-owned, preserved without ownership" >&2
2455:      fi
2456:      return 0
2457:      ;;
2458:
2459:    DELIVER|REFRESH)
2460:      if [ "$DRY_RUN" -eq 1 ]; then
2461:        if [ "$_verdict" = "REFRESH" ]; then
2462:          echo "    (dry-run) would FORCE-REFRESH (backup to $BAK_DIR/SPEC/v1): SPEC/v1"
2463:        else
2464:          echo "    (dry-run) would ADD: SPEC/v1"
2465:        fi
2466:        return 0
2467:      fi
2468:      _up_record_op "refresh_spec_v1" "$_pr/$_lc"
2469:
2470:      if [ "$_lt" = "dir" ] || [ "$_lt" = "dir_empty" ]; then
2471:        mkdir -p "$( dirname "$bdir" )" 2>/dev/null || true
2472:        # `|| true` is load-bearing: under `set -euo pipefail` a failing cp
2473:        # KILLS the run before the guard below can refuse the surface, so the
2474:        # upgrade dies mid-way instead of leaving this surface untouched.
2475:        if ! { cp -R "$ddir" "$bdir" 2>/dev/null || false; }; then
2476:          # INV-3: an execution failure NEVER advances the record. The surface
2477:          # is left exactly as it was, and so is its prior ownership record.
2478:          echo "    WARNING: could not back up SPEC/v1 — REFUSING to replace it" >&2
2479:          echo "             (backup-before-replace is the contract; surface untouched)" >&2
2480:          # INV-3: the REFRESH did not happen, so the record must not advance
2481:          # to source hashes. Retain the prior digest with the ownership.
2482:          _up_record_op "preserve_spec_v1_backup_failed" "SPEC/v1"
2483:          if [ "$_pr" = "hash" ]; then
2484:            _SPEC_DELIVERED=1
2485:            _SPEC_HASH_SOURCE="HASH_PRIOR_RECORD"
2486:          fi
2487:          return 0
2488:        fi
2489:        echo "    BACKED UP: SPEC/v1 -> $BAK_DIR/SPEC/v1"
2490:        find "$ddir" -mindepth 1 -delete
2491:        rmdir "$ddir" 2>/dev/null || true
2492:      elif [ "$_lt" = "regular" ]; then
2493:        mkdir -p "$( dirname "$bdir" )"
2494:        if cp "$ddir" "$bdir" 2>/dev/null; then
2495:          rm -f "$ddir"
2496:          echo "    BACKED UP: SPEC/v1 (non-directory) -> $BAK_DIR/SPEC/v1"
2497:        else
2498:          echo "    WARNING: could not back up non-directory SPEC/v1 — REFUSING to remove it" >&2
2499:          # INV-3: the REFRESH did not happen, so the record must not advance
2500:          # to source hashes. Retain the prior digest with the ownership.
2501:          _up_record_op "preserve_spec_v1_backup_failed" "SPEC/v1"
2502:          if [ "$_pr" = "hash" ]; then
2503:            _SPEC_DELIVERED=1
2504:            _SPEC_HASH_SOURCE="HASH_PRIOR_RECORD"
2505:          fi
2506:          return 0
2507:        fi
2508:      fi
2509:
2510:      # rc.1 r12: non-directory ancestor, LAST place before the write —
2511:      # reaching here means it changed after the preflight (TOCTOU). Refuse
2512:      # NAMED instead of letting mkdir abort under set -e. INV-3: no refresh
2513:      # happened, so the record must not advance to source hashes.
2514:      if command -v _wbm_dst_non_directory_ancestor_refuses >/dev/null 2>&1 \
2515:         && _wbm_dst_non_directory_ancestor_refuses "$TARGET" "SPEC/v1"; then
2516:        echo "    WARNING: PRESERVED SPEC/v1 — $_WBM_DST_REFUSE_WHY" >&2
2517:        _up_record_op "preserve_spec_v1_unconfined_ancestor" "SPEC/v1"
2518:        if [ "$_pr" = "hash" ]; then
2519:          _SPEC_DELIVERED=1
2520:          _SPEC_HASH_SOURCE="HASH_PRIOR_RECORD"
2521:        fi
2522:        return 0
2523:      fi
2524:      mkdir -p "$( dirname "$ddir" )"
2525:      cp -R "$sdir" "$ddir"
2526:      _SPEC_DELIVERED=1
2527:      echo "    REFRESHED (forced — $_pr/$_lc): SPEC/v1"
2528:      return 0
2529:      ;;
2530:  esac
2531:}
2532:
2533:# _refresh_framework_marker — FORCED + VALIDATED write (r20 option (a)):
2534:# the marker is generated-refresh content — the upgrade rewrites it to the
2535:# source VERSION every run, backs up a differing pre-existing copy, and
2536:# read-back-validates the write. A marker the upgrade could not validate is
2537:# NOT recorded as delivered, so the FMS entry (and every marker-first
2538:# reader keyed off the SAME record) falls back to VERSION instead of
2539:# trusting a stale value. Delivered in BOTH ceremonies (inside .claude/).
2540:_MARKER_DELIVERED=0
2541:_refresh_framework_marker() {
2542:  local src="$SOURCE_DIR/.claude/.framework-version"
2543:  local dst="$TARGET/.claude/.framework-version"
2544:  local bak="$BAK_DIR/.claude/.framework-version"
2545:
2546:  # ---- OBSERVE -------------------------------------------------------------
2547:  local _lt _pr _lc _sh _md _sk
2548:  if _lg_ancestor_is_symlink "$TARGET" ".claude/.framework-version"; then
2549:    _lt="ancestor_symlink"
2550:  else
2551:    _lt="$( _ov_obs_live_type "$dst" )"
2552:  fi
2553:  _pr="$( _ov_obs_prior_record ".claude/.framework-version" )"
2554:  _sh=no; [ -f "$src" ] && _sh=yes
2555:  # Inspect CONTENT only for a regular file. `cmp` on a FIFO blocks waiting for
2556:  # a writer, hanging the upgrade before the verdict can say PRESERVE_UNOWNED —
2557:  # the third instance of "a reader opens what lstat already classified"
2558:  # (codex W3 r4 P1; the OWN-0029 timeout).
2559:  if [ "$_lt" != "regular" ]; then
2560:    _lc="-"
2561:  elif [ "$_sh" = yes ] && cmp -s "$src" "$dst" 2>/dev/null; then
2562:    _lc="pristine"
2563:  else
2564:    _lc="edited"
2565:  fi
2566:  _md="$( _ov_obs_mode )"
2567:  _sk="$( _ov_obs_skip ".claude/.framework-version" )"
2568:
2569:  # ---- DECIDE --------------------------------------------------------------
2570:  local _pair _verdict
2571:  if ! _pair="$( _ownership_verdict marker "$_pr" "$_lt" "$_lc" "$_sh" "$_md" \
2572:                   "$CEREMONY_EFFECTIVE" upgrade "$_sk" )"; then
2573:    echo "    WARNING: .claude/.framework-version dimensions are not a legal cell" >&2
2574:    echo "             — PRESERVED without ownership. Please report this combination." >&2
2575:    return 0
2576:  fi
2577:  _verdict="${_pair%% *}"
2578:  _MARKER_HASH_SOURCE="${_pair##* }"
2579:
2580:  # ---- EXECUTE -------------------------------------------------------------
2581:  case "$_verdict" in
2582:    PRESERVE_OWNED)
2583:      _MARKER_DELIVERED=1
2584:      case "$_lt/$_sk" in
2585:        ancestor_symlink/*) echo "    SKIP: .claude/.framework-version has a symlinked ancestor (refusing to write through it — F11a)" ;;
2586:        symlink/*)          echo "    SKIP: .claude/.framework-version is the recorded --mode link delivery (target unchanged)" ;;
2587:        */self)             echo "    SKIPPED (--skip): .claude/.framework-version" ;;
2588:        *)                  echo "    SKIP: .claude/.framework-version (ownership carried forward)" ;;
2589:      esac
2590:      return 0
2591:      ;;
2592:
2593:    OMIT_RECORD|PRESERVE_UNOWNED)
2594:      if [ "$_sh" = no ]; then
2595:        # The documented --pin downgrade: this source predates the marker, so a
2596:        # retained record would keep advertising a newer version over older
2597:        # content. Readers fall back to VERSION — which upgrade NEVER touches
2598:        # (install-time snapshot, ADR-155-AMEND-1), so after this downgrade
2599:        # VERSION OVER-REPORTS until the next full install. Say so honestly
2600:        # instead of claiming the pin updated it (repass-r2 part-a V2: the
2601:        # false claim recurred in all three rail rounds).
2602:        echo "    SKIP: .claude/.framework-version absent in source (pre-v1.3.0 checkout)"
2603:        if [ "$_pr" != "none" ]; then
2604:          echo "    NOTE: the prior delivery record is NOT carried forward — version" >&2
2605:          echo "          readers fall back to VERSION, an install-time snapshot that" >&2
2606:          echo "          does NOT reflect the pinned source: expect VERSION to" >&2
2607:          echo "          over-report until the next full install (ADR-155-AMEND-1)" >&2
2608:        fi
2609:      elif [ "$_lt" = "symlink" ]; then
2610:        echo "    WARNING: .claude/.framework-version is a symlink that does NOT match the" >&2
2611:        echo "             recorded LINK delivery — preserved WITHOUT framework ownership" >&2
2612:        echo "             (readers fall back to VERSION)" >&2
2613:      else
2614:        echo "    SKIP: .claude/.framework-version is $_lt — adopter-owned, refusing to write into/through it"
2615:      fi
2616:      return 0
2617:      ;;
2618:
2619:    DELIVER|REFRESH)
2620:      if [ "$DRY_RUN" -eq 1 ]; then
2621:        echo "    (dry-run) would REFRESH: .claude/.framework-version ($(tr -d '[:space:]' < "$src" 2>/dev/null || true))"
2622:        return 0
2623:      fi
2624:      if [ "$_verdict" = "REFRESH" ] && [ "$_lc" = "edited" ]; then
2625:        mkdir -p "$( dirname "$bak" )" 2>/dev/null || true
2626:        if { cp "$dst" "$bak" 2>/dev/null || false; }; then
2627:          echo "    BACKED UP: .claude/.framework-version -> $bak"
2628:        else
2629:          # INV-3: an execution failure never advances the record.
2630:          echo "    WARNING: could not back up differing .claude/.framework-version —" >&2
2631:          echo "             REFUSING to overwrite it (backup-before-replace)" >&2
2632:          # INV-3, same as the SPEC branch above.
2633:          _up_record_op "preserve_marker_backup_failed" ".claude/.framework-version"
2634:          if [ "$_pr" = "hash" ]; then
2635:            _MARKER_DELIVERED=1
2636:            _MARKER_HASH_SOURCE="HASH_PRIOR_RECORD"
2637:          fi
2638:          return 0
2639:        fi
2640:      fi
2641:      mkdir -p "$( dirname "$dst" )"
2642:      cp "$src" "$dst"
2643:      # Read-back validation: a write that cannot be confirmed is NOT recorded
2644:      # as delivered, so every marker-first reader falls back to VERSION rather
2645:      # than trusting a value the upgrade could not verify.
2646:      if cmp -s "$src" "$dst" 2>/dev/null; then
2647:        _MARKER_DELIVERED=1
2648:        _up_record_op "refresh_framework_marker" "$(tr -d '[:space:]' < "$src" 2>/dev/null || true)"
2649:        echo "    REFRESHED: .claude/.framework-version ($(tr -d '[:space:]' < "$dst" 2>/dev/null || true))"
2650:      else
2651:        echo "    WARNING: .claude/.framework-version write did not validate — NOT recorded as" >&2
2652:        echo "             delivered (marker-first readers fall back to VERSION; r20)" >&2
2653:      fi
2654:      return 0
2655:      ;;
2656:  esac
2657:}
2658:
2659:has_profile() {
2660:  local p="$1"
2661:  for part in "${PROFILE_PARTS[@]}"; do
2662:    if [[ "$part" == "$p" ]]; then
2663:      return 0
2664:    fi
2665:  done
2666:  return 1
2667:}
2668:
2669:# ---------------------------------------------------------------------------
2670:# PLAN-135 W1 (unit w0r) — pre-flight model-deprecation advisory.
2671:# Runs check-model-deprecations.py --check against the TARGET when the checker
2672:# is available (source copy preferred — fresher ledger; falls back to the
2673:# target's installed copy). NEVER blocks the upgrade: findings emit stderr
2674:# WARNING lines (F-CHAOS-3 convention); any infra failure (no python3, corrupt
2675:# ledger, unexpected rc) degrades to a NOTE and the upgrade proceeds
2676:# (fail-open per CLAUDE.md §5). Suppress with --no-deprecation-warn.
2677:# ---------------------------------------------------------------------------
2678:_emit_deprecation_warnings() {
2679:  [[ "$DEPRECATION_WARN" -eq 1 ]] || return 0
2680:  local checker=""
2681:  if [[ -f "$SOURCE_DIR/.claude/scripts/check-model-deprecations.py" ]]; then
2682:    checker="$SOURCE_DIR/.claude/scripts/check-model-deprecations.py"
2683:  elif [[ -f "$TARGET/.claude/scripts/check-model-deprecations.py" ]]; then
2684:    checker="$TARGET/.claude/scripts/check-model-deprecations.py"
2685:  fi
2686:  [[ -n "$checker" ]] || return 0
2687:  if ! command -v python3 >/dev/null 2>&1; then
2688:    echo "    NOTE: model-deprecation scan skipped (python3 not found) — advisory only" >&2
2689:    return 0
2690:  fi
2691:  local dep_rc=0
2692:  python3 "$checker" --check "$TARGET" >/dev/null 2>&1 || dep_rc=$?
2693:  if [[ "$dep_rc" -eq 1 ]]; then
2694:    echo "    WARNING: deprecated/retiring Claude model ids detected in target" >&2
2695:    echo "             (already retired, or <=60 days to retirement). Full report:" >&2
2696:    echo "             python3 $checker $TARGET" >&2
2697:  elif [[ "$dep_rc" -ne 0 ]]; then
2698:    echo "    NOTE: model-deprecation scan inconclusive (rc=$dep_rc) — advisory only" >&2
2699:  fi
2700:  return 0
2701:}
2702:
2703:_emit_deprecation_warnings
2704:
2705:# ---------------------------------------------------------------------------
2706:# PLAN-135 W2 (unit h8) — idempotent settings-merge: register framework hook
2707:# registrations into the adopter's EXISTING .claude/settings.json.
2708:#
2709:# WHY THIS EXISTS (constraint b, debate R1): install.sh EXISTS-SKIPs an
2710:# existing settings.json, so a hook that is only baked into the fresh-install
2711:# template (settings.base.json) NEVER reaches the S217 population of existing
2712:# adopters. Without this step every hook added after an adopter's original
2713:# install would be a silent no-op for that repo — the script on disk, the
2714:# channel unwired. We therefore merge the missing registration(s) into the
2715:# live settings.json here, at upgrade time, in the SAME ceremony.
2716:#
2717:# PLAN-169 W-E (S329) — THE LIST IS DERIVED, NEVER DECLARED TWICE.
2718:# ---------------------------------------------------------------------------
2719:# Until S329 this function carried a LITERAL roster of six lifecycle hooks
2720:# (PreCompact/PostCompact/ConfigChange/SubagentStart/Setup + the PLAN-179 W1-b
2721:# SessionStart(compact) pinning hook) inside its jq program, and repeated the
2722:# same six in prose for the --dry-run announcement. That is a second
2723:# declaration of a truth that already lives in
2724:# templates/settings/settings.base.json, and it rotted exactly the way a
2725:# second copy always does: check_ledger_checkpoint.py (PLAN-179 W2/W4) landed
2726:# in BOTH .claude/settings.json and the template mirror and in NEITHER list,
2727:# so every adopter that UPGRADED got the hook script with no registration
2728:# (fresh installs were fine — the template covers them — and
2729:# test_template_dogfood_parity is blind to it because it compares dogfood to
2730:# template, never dogfood to the RESULT OF AN UPGRADE). Measured S328, rail
2731:# codex round 3 of the PLAN-179 pack D; the finding is
2732:# .claude/plans/PLAN-179/s328-ceremony-D/FINDING-upgrade-lifecycle-hooks-S328.md
2733:#
2734:# The cure is NOT a seventh entry. The roster is now DERIVED, per upgrade run,
2735:# from the template that ships in the SOURCE checkout — the same artifact and
2736:# the same $SOURCE_DIR resolution the PLAN-164 W1 pair-rail timeout migration
2737:# already uses (see _migrate_settings_baseline: "the NEW cap is derived from
2738:# templates/settings/settings.base.json, never hardcoded"). Add a hook to the
2739:# template and upgraded adopters get it; there is no second place to forget.
2740:#
2741:# SOURCE (single):  $SOURCE_DIR/templates/settings/settings.base.json — the
2742:#   checkout that is EXECUTING this upgrade. Never $TARGET (that is the thing
2743:#   being upgraded; reading it would make the merge a fixpoint on the
2744:#   adopter's own drift).
2745:#
2746:# SEMANTICS (ADDITIVE — deliberate change from the pre-S329 six):
2747:#   registration ABSENT for that event  -> the template block is APPENDED
2748:#   registration PRESENT for that event -> the adopter's block is PRESERVED
2749:#                                          BYTE-IDENTICAL, never rewritten
2750:#   Pre-S329 the six were RE-CANONICALIZED: an adopter who had edited one got
2751:#   it silently replaced. That contradicts INV-4 of PLAN-167/168 (adopter
2752:#   edits are preserved; REPAIRING a drifted registration is doctor.sh's job,
2753:#   not the upgrader's), and it does not scale: re-canonicalizing all 47
2754:#   template registrations would clobber every timeout an adopter ever tuned.
2755:#   Additive is the only semantics that is safe at the full-roster scale.
2756:#
2757:# IDENTITY of a registration (the key the presence test compares):
2758:#   every "<name>.py" token in the block's hooks[].command, matched as a WHOLE
2759:#   token — the character class stops at "/" so a path yields its basename,
2760:#   and a trailing lookahead means "check_x.py" can never be found inside
2761:#   "check_xy.py" / "check_xy.python". A block whose command carries no .py at
2762:#   all (the inline PostToolUse|Agent file-assignment echo) is keyed by its
2763:#   FULL command string. A block is "already registered" under an event when
2764:#   EVERY key it carries is already present under that event. A block we
2765:#   cannot key at all (no hooks[]) is never appended — unidentifiable input is
2766:#   left alone rather than guessed at.
2767:#
2768:# --dry-run announces the SAME derivation (one jq program, --arg mode): a
2769:# migration that is silent in --dry-run is a migration the adopter cannot
2770:# review before it runs for real.
2771:#
2772:# The file is rewritten ONLY when at least one registration is actually
2773:# missing (same idempotency oracle as the T5.4 migration below), so a re-run
2774:# is byte-identical — including the adopter's own formatting, which the
2775:# pre-S329 unconditional `jq` rewrite destroyed on every upgrade.
2776:#
2777:# ABSENT vs PRESENT-BUT-FALSY (rail round 1, P2 — these are NOT the same
2778:# question, and the obvious jq idiom conflates them):
2779:#   .hooks / an event key MISSING       -> nothing was ever written there;
2780:#                                          this is the historical adopter, and
2781:#                                          registering is the whole point
2782:#   present with an EXPLICIT null/false -> the adopter wrote that on purpose;
2783:#                                          PRESERVED untouched + named on
2784:#                                          stderr, exactly like {"not":"array"}
2785:# `x // []` yields [] for BOTH, so every presence test in the jq program is
2786:# `has(...)` on the CONTAINER. Getting this wrong meant an adopter who had
2787:# deliberately emptied .hooks got 47 registrations written back into it.
2788:#
2789:# THE TWO INPUTS ARE NOT TRUSTED THE SAME WAY (rail round 2, P2):
2790:#   the ADOPTER's settings.json is untrusted and possibly hand-edited, so a
2791:#     shape we cannot parse is PRESERVED and NAMED, per EVENT — the other 46
2792:#     registrations still land (E.8/E.10 of the e2e)
2793:#   the TEMPLATE is the artifact that DEFINES the roster; it ships with the
2794:#     framework, and a malformed one means we do not know what the right
2795:#     answer IS. There is no partial merge to salvage: every event value must
2796:#     be an array of blocks or the whole merge is REFUSED, named, and nothing
2797:#     is written. Degrading to "merge the events that happen to parse" would
2798:#     silently ship a truncated roster, which is this wave's own bug class.
2799:#
2800:# Fail-open per CLAUDE.md §5: no jq, unreadable/invalid/structurally-invalid
2801:# template, malformed settings, or a merge error => stderr NOTE + the upgrade
2802:# proceeds. A structure we do not understand (settings.json not an object,
2803:# $.hooks present and not an object, or one event's value present and not an
2804:# array) is SKIPPED and NAMED WITH ITS TYPE, never coerced. The merged document is
2805:# validated as JSON and non-empty BEFORE the atomic same-directory mv, so a
2806:# partial settings.json is never observable. A backup of the pre-merge
2807:# settings.json is written under $BAK_DIR first so the Owner can always roll
2808:# back. Suppress entirely with --no-settings-merge.
2809:# ---------------------------------------------------------------------------
2810:_merge_lifecycle_hooks_into_settings() {
2811:  [[ "$SETTINGS_MERGE" -eq 1 ]] || return 0
2812:  local settings="$TARGET/.claude/settings.json"
2813:  # SINGLE SOURCE. $SOURCE_DIR is the checkout executing this upgrade (:96),
2814:  # the same resolution _migrate_settings_baseline uses for the pair-rail cap.
2815:  #
2816:  # WHICH template is the CEREMONY's call, and the call is not re-made here
2817:  # (rail round 6, P1). install.sh builds the adopter's settings.json from
2818:  # settings.user.json under `--ceremony user` (its WS4-ceremony-settings
2819:  # branch) — a profile that deliberately OMITS the governance hooks that block
2820:  # edits or need GPG/sentinel infrastructure. Deriving from settings.base.json
2821:  # regardless of ceremony would re-register exactly those on the next upgrade,
2822:  # silently turning the advisory user profile into the maintainer profile —
2823:  # wider than the pre-cure literal roster ever reached, and in the one
2824:  # population that chose not to have them. CEREMONY_EFFECTIVE is the ONE
2825:  # resolution of the ceremony in this script (recorded install-state, then
2826:  # --ceremony, then CEO_UPGRADE_CEREMONY, then the fail-safe `user`); this
2827:  # function CONSUMES it. Only the literal `maintainer` selects the wider
2828:  # template; every other value — including unset, which only a harness can
2829:  # produce — takes the narrower one, the same fail-SAFE direction the
2830:  # resolution itself chose.
2831:  #
2832:  # And INFERRED is not RECORDED (rail round 8, P1). With no readable
2833:  # install-state and no --ceremony, the resolver above answers `user` only as
2834:  # a fail-safe for ROOT WRITES (_CEREMONY_PERSIST=0): that population is the
2835:  # pre-Wave-B historical install whose ceremony nobody knows. Treating that
2836:  # as a real user profile would withhold every base-only hook from a
2837:  # historical MAINTAINER — the S328 finding itself, for exactly the adopters
2838:  # this wave exists to reach — and hand it the user-only advisory switch,
2839:  # which turns a blocking matcher it already carries into an allow. So the
2840:  # unknown case gets its own posture: the roster BOTH templates share, derived
2841:  # at run time (hooks by identity key, settings by key AND value), NAMED, with
2842:  # the opt-in spelled out. Nothing either profile would refuse, and the 20
2843:  # registrations the profiles agree on do arrive.
2844:  local template="" _tpl_posture _tpl_label
2845:  case "${CEREMONY_EFFECTIVE:-}/${_CEREMONY_PERSIST:-0}" in
2846:    maintainer/1)
2847:      _tpl_posture="maintainer"
2848:      template="$SOURCE_DIR/templates/settings/settings.base.json"
2849:      _tpl_label="templates/settings/settings.base.json" ;;
2850:    user/1)
2851:      _tpl_posture="user"
2852:      template="$SOURCE_DIR/templates/settings/settings.user.json"
2853:      _tpl_label="templates/settings/settings.user.json" ;;
2854:    *)
2855:      _tpl_posture="shared"
2856:      _tpl_label="the roster shared by settings.base.json and settings.user.json (ceremony unknown)" ;;
2857:  esac
2858:  # ONE identity rule, hoisted (rail round 8) so that any second jq program in
2859:  # this function shares it and the boundary fix of round 7 cannot drift
2860:  # between two copies of the regex.
2861:  local jq_defs
2862:  jq_defs='
2863:# Every shape this walks is ACCEPTED only after being proved to be the shape
2864:# we expect (object / array / string). Anything else yields NO key, which
2865:# makes its block unidentifiable and therefore untouched — the PLAN-185
2866:# doctrine: enumerate what is provably safe, never guess at the rest. jq
2867:# raises on indexing a number or slicing an object, and an uncaught raise here
2868:# would abort the WHOLE merge, turning one odd event into a silent no-op for
2869:# all 47 registrations (measured: E.8 of the e2e caught exactly that).
2870:def _cmds:
2871:  [ select(type == "object") | (.hooks // null)
2872:    | select(type == "array") | .[]
2873:    | select(type == "object") | (.command // null)
2874:    | select(type == "string") ];
2875:def _keys:
2876:  [ _cmds[]
2877:    | . as $cmd
2878:    # Both boundaries (rail round 7, P2): without the lookbehind, an adopter
2879:    # command that invokes a hidden (dot-prefixed) or dash-prefixed copy of a
2880:    # hook yields the CANONICAL name as its key, the template registration is
2881:    # judged PRESENT, and
2882:    # it is never wired. The Python oracle in the tests carries the same
2883:    # lookbehind; the two extractors have to agree or one of them is lying.
2884:    | ([ match("(?<![A-Za-z0-9_.-])[A-Za-z0-9_][A-Za-z0-9_.-]*\\.py(?![A-Za-z0-9_.-])"; "g").string ]) as $py
2885:    | if ($py | length) > 0 then $py[] else $cmd end ];
2886:def _disp:
2887:  (join(",") | gsub("\\s+"; " ") | if (length > 160) then (.[0:157] + "...") else . end);
2888:'
2889:
2890:  if [[ ! -f "$settings" ]]; then
2891:    echo "    NOTE: settings-merge skipped — no $settings (fresh install builds it from template)" >&2
2892:    return 0
2893:  fi
2894:  if ! command -v jq >/dev/null 2>&1; then
2895:    echo "    NOTE: settings-merge skipped (jq not found) — register new framework hooks manually; advisory only" >&2
2896:    return 0
2897:  fi
2898:  if [[ "$_tpl_posture" == "shared" ]]; then
2899:    local _tpl_base="$SOURCE_DIR/templates/settings/settings.base.json"
2900:    local _tpl_user="$SOURCE_DIR/templates/settings/settings.user.json"
2901:    local _t _t_docs
2902:    # BOTH sources are held to the standard the explicit postures apply to
2903:    # their one template (rail round 9, P2): readable, exactly one JSON
2904:    # document, an object with an object .hooks. A stream or a scalar would
2905:    # otherwise be coerced into the derivation and applied as if it were real.
2906:    for _t in "$_tpl_base" "$_tpl_user"; do
2907:      if [[ ! -r "$_t" ]]; then
2908:        echo "    NOTE: settings-merge skipped — template unreadable at $_t; advisory only" >&2
2909:        return 0
2910:      fi
2911:      _t_docs="$( jq -n --slurpfile t "$_t" '$t | length' 2>/dev/null )" || _t_docs=""
2912:      if [[ "$_t_docs" != "1" ]]; then
2913:        echo "    NOTE: settings-merge skipped — $_t is not exactly ONE JSON document (found: ${_t_docs:-unreadable}); NOTHING was written to settings.json; advisory only" >&2
2914:        return 0
2915:      fi
2916:      if ! jq -e 'type == "object" and (.hooks | type) == "object"' "$_t" >/dev/null 2>&1; then
2917:        echo "    NOTE: settings-merge skipped — $_t is not JSON with an object .hooks; NOTHING was written to settings.json; advisory only" >&2
2918:        return 0
2919:      fi
2920:    done
2921:    # Derived into a TEMP file, never under the adopter (rail round 9, P1): a
2922:    # --dry-run reaches this point too, and the whole-tree no-write guarantee
2923:    # of --dry-run has to hold here as well. The apply path copies the derived
2924:    # document next to the backup once it actually writes something.
2925:    local _tpl_tmp
2926:    # Through _up_tmpbase like every other scratch file of this script (rail
2927:    # round 11, P2): with TMPDIR pointing INSIDE the target, a raw mktemp would
2928:    # create the derived roster in the adopter — in a --dry-run too.
2929:    _tpl_tmp="$( mktemp "$( _up_tmpbase )/ceo-shared-roster.XXXXXX" )" || {
2930:      echo "    NOTE: settings-merge skipped — mktemp failed for the shared roster; advisory only" >&2
2931:      return 0
2932:    }
2933:    # The trap body is FIXED text (rail round 11, P2): the path is read from a
2934:    # GLOBAL when the trap fires, never re-parsed into the trap — an apostrophe
2935:    # in TMPDIR would otherwise abort the upgrade under set -e, and a crafted
2936:    # path could inject. Global on purpose: a `local` is gone by then.
2937:    _UP_SHARED_TPL_TMP="$_tpl_tmp"
2938:    trap 'rm -f -- "$_UP_SHARED_TPL_TMP"' RETURN
2939:    template="$_tpl_tmp"
2940:    # What the two profiles PROVABLY agree on is their SETTINGS with equal
2941:    # values — nothing else (rail round 9, P1). The hooks the two templates
2942:    # share are identical blocks, but a hook's BEHAVIOUR can depend on a
2943:    # setting the profiles disagree on (the config-protection hook blocks
2944:    # unless the user profile's advisory switch is present), and that
2945:    # dependency lives in code this script cannot read. So an unknown
2946:    # ceremony registers NO hooks: the settings both profiles declare with the
2947:    # same value are applied, everything else is WITHHELD and NAMED, and the
2948:    # adopter is told how to state the ceremony. The pre-cure code pushed six
2949:    # base-only literals into this population — and those six were the defect.
2950:    if ! jq -n --slurpfile b "$_tpl_base" --slurpfile u "$_tpl_user" '
2951:        ($b[0].env | if type == "object" then . else {} end) as $be
2952:        | ($u[0].env | if type == "object" then . else {} end) as $ue
2953:        | { hooks: {},
2954:            env: ( $ue | with_entries(select( .key as $k | ($be | has($k)) and ($be[$k] == .value) )) ) }' \
2955:        > "$template" 2>/dev/null || [[ ! -s "$template" ]]; then
2956:      echo "    NOTE: settings-merge skipped — could not derive the settings shared by settings.base.json and settings.user.json; advisory only" >&2
2957:      return 0
2958:    fi
2959:    local _wh_b _wh_u _we_b _we_u
2960:    _wh_b="$( jq '[.hooks | to_entries[] | .value[]] | length' "$_tpl_base" 2>/dev/null || printf '?' )"
2961:    _wh_u="$( jq '[.hooks | to_entries[] | .value[]] | length' "$_tpl_user" 2>/dev/null || printf '?' )"
2962:    _we_b="$( jq --slurpfile s "$template" '((.env // {}) | length) - (($s[0].env // {}) | length)' "$_tpl_base" 2>/dev/null || printf '?' )"
2963:    _we_u="$( jq --slurpfile s "$template" '((.env // {}) | length) - (($s[0].env // {}) | length)' "$_tpl_user" 2>/dev/null || printf '?' )"
2964:    echo "    NOTE: ceremony UNKNOWN (no readable install-state, no --ceremony, no CEO_UPGRADE_CEREMONY) — NO hook registration is applied until the ceremony is stated; only the settings BOTH profiles declare with the same value are. WITHHELD: $_wh_b registration(s) + $_we_b setting(s) of settings.base.json, $_wh_u + $_we_u of settings.user.json. Pass --ceremony maintainer|user to register the profile you installed." >&2
2965:  fi
2966:  if [[ ! -r "$template" ]]; then
2967:    echo "    NOTE: settings-merge skipped — template unreadable at $template; advisory only" >&2
2968:    return 0
2969:  fi
2970:  # ONE document, exactly (rail round 7, P2). `jq -e` over a FILE validates
2971:  # every document of a stream in turn, so a template that accidentally carries
2972:  # two top-level objects passes every shape guard below TWICE; `--slurpfile`
2973:  # then loads both and the program reads only $tpl[0] — the second document's
2974:  # registrations vanish without a word. The roster is all-or-nothing, so a
2975:  # stream is refused and NAMED, like every other malformed template.
2976:  local _tpl_docs
2977:  _tpl_docs="$( jq -n --slurpfile t "$template" '$t | length' 2>/dev/null )" || _tpl_docs=""
2978:  # An EMPTY count means jq could not parse the file at all; that case keeps
2979:  # its own, older, name ("not JSON") in the guard right below.
2980:  if [[ -n "$_tpl_docs" && "$_tpl_docs" != "1" ]]; then
2981:    echo "    NOTE: settings-merge skipped — the template is not exactly ONE JSON document (found: ${_tpl_docs:-unreadable}) ($template); NOTHING was written to settings.json; advisory only" >&2
2982:    return 0
2983:  fi
2984:  if ! jq -e 'type == "object" and (.hooks | type) == "object"' "$template" >/dev/null 2>&1; then
2985:    echo "    NOTE: settings-merge skipped — template is not JSON with an object .hooks ($template); advisory only" >&2
2986:    return 0
2987:  fi
2988:  # ".hooks is an object" is NOT enough (rail round 2, P2). Every event value in
2989:  # the template has to be an ARRAY of blocks, and neither the guard above nor
2990:  # `$te.value[]?` in the program below enforces that — `[]?` swallows the
2991:  # error and the two ways it goes wrong are both silent:
2992:  #
2993:  #   event value is an OBJECT -> `.[]?` iterates its VALUES, so whatever sits
2994:  #     under those keys is fed to the merge AS IF it were a hooks block and
2995:  #     can be APPENDED to the adopter's settings.json (measured: an object
2996:  #     {"x": {...}} yields the inner {...} as a $blk)
2997:  #   event value is a SCALAR/null/false -> `.[]?` yields NOTHING, so the whole
2998:  #     event is dropped from the roster without a word — the exact failure
2999:  #     this wave exists to remove, one layer up: registrations that are in the
3000:  #     template and never reach the adopter
3001:  #
3002:  # The adopter's settings.json is untrusted input and gets PRESERVED + NAMED
3003:  # (see the paragraph above). The TEMPLATE is different: it is the artifact
3004:  # that DEFINES the roster, it ships with the framework, and a malformed one
3005:  # means we do not know what the correct answer is. So this is fail-CLOSED on
3006:  # the merge — name every offending event with the type found, write nothing,
3007:  # and let the rest of the upgrade proceed (advisory, per CLAUDE.md §5).
3008:  # And an ARRAY of blocks is not enough either (rail round 3, P2). A block the
3009:  # key-derivation cannot identify — null, {}, {"hooks": []}, an entry with no
3010:  # string .command — yields ZERO keys, and the reduction's `($k|length) == 0`
3011:  # arm then SKIPS it while its well-formed siblings merge. That is a partial
3012:  # roster arriving through a different door than the one closed above, and it
3013:  # contradicts the all-or-nothing rule this guard exists to enforce. So every
3014:  # BLOCK is validated here too, before the reduction starts: an object, with a
3015:  # non-empty .hooks array, whose every entry is an object carrying a non-empty
3016:  # string .command. Anything else names the event, the INDEX and the reason.
3017:  # And .env, when PRESENT, has to be an object (rail round 10, P2): the
3018:  # settings travel with the hooks (round 7), so a template whose .env is
3019:  # malformed would otherwise be coerced to {} and its hooks written WITHOUT
3020:  # the settings that keep them in the profile's mode. Same all-or-nothing
3021:  # rule as a malformed event, same named refusal.
3022:  local _tpl_bad _tpl_rc=0
3023:  _tpl_bad="$( jq -r '
3024:      ( if (has("env")) and ((.env | type) != "object")
3025:        then "ENV (" + (.env | type) + ")" else empty end ),
3026:      ( .hooks
3027:      | to_entries[]
3028:      | .key as $ev
3029:      | if (.value | type) != "array" then
3030:          "EVENT " + $ev + " (" + (.value | type) + ")"
3031:        else
3032:          ( .value | to_entries[]
3033:            | .key as $ix
3034:            | .value as $blk
3035:            | ( if   ($blk | type) != "object"                then ($blk | type)
3036:                elif ($blk | has("hooks") | not)              then "no .hooks"
3037:                elif ($blk.hooks | type) != "array"           then ".hooks is " + ($blk.hooks | type)
3038:                elif ($blk.hooks | length) == 0               then ".hooks is empty"
3039:                elif ([ $blk.hooks[] | select(type != "object") ] | length) > 0
3040:                  then "a .hooks entry is not an object"
3041:                elif ([ $blk.hooks[] | select((.command | type) != "string") ] | length) > 0
3042:                  then "a .hooks entry has no string .command"
3043:                elif ([ $blk.hooks[] | select((.command | length) == 0) ] | length) > 0
3044:                  then "a .hooks entry has an empty .command"
3045:                else null end ) as $why
3046:            | select($why != null)
3047:            | "BLOCK " + $ev + "[" + ($ix | tostring) + "] (" + $why + ")" )
3048:        end )' "$template" 2>/dev/null )" || _tpl_rc=$?
3049:  if [[ "$_tpl_rc" -ne 0 ]]; then
3050:    echo "    NOTE: settings-merge skipped — could not validate the template's event shapes ($template); settings.json unchanged; advisory only" >&2
3051:    return 0
3052:  fi
3053:  if [[ -n "$_tpl_bad" ]]; then
3054:    echo "    NOTE: settings-merge skipped — the template is structurally invalid; NOTHING was written to settings.json; advisory only" >&2
3055:    local _tl _tkind _trest
3056:    while IFS= read -r _tl; do
3057:      [[ -n "$_tl" ]] || continue
3058:      _tkind="${_tl%% *}"; _trest="${_tl#* }"
3059:      case "$_tkind" in
3060:        EVENT) echo "          template event not an array: $_trest  ($template)" >&2 ;;
3061:        ENV)   echo "          template .env present but not an object: $_trest  ($template)" >&2 ;;
3062:        BLOCK) echo "          template block not identifiable: $_trest  ($template)" >&2 ;;
3063:        *)     echo "          template problem: $_tl  ($template)" >&2 ;;
3064:      esac
3065:    done <<< "$_tpl_bad"
3066:    return 0
3067:  fi
3068:
3069:  echo ""
3070:  echo "==> Registering framework hooks into .claude/settings.json (derived from $_tpl_label — ceremony=${CEREMONY_EFFECTIVE:-unset}, posture=$_tpl_posture)"
3071:  _up_record_op "merge_lifecycle_hooks" "additive settings.json merge (posture=$_tpl_posture, ceremony=${CEREMONY_EFFECTIVE:-unset})"
3072:
3073:  # ONE program, two modes. mode=report emits the decision lines the dry-run
3074:  # prints and the apply path echoes; mode=apply emits the merged document.
3075:  # Both walk the identical reduce, so the announcement cannot disagree with
3076:  # the write (the pre-S329 code had two hand-kept lists and they DID diverge).
3077:  #
3078:  # Single-quoted on purpose: the template's commands carry a LITERAL
3079:  # "$CLAUDE_PROJECT_DIR" that the harness expands at hook time. Here it
3080:  # travels as JSON from file to file and is never seen by the shell.
3081:  local jq_prog
3082:  jq_prog="$jq_defs"'
3083:
3084:# ABSENT is not the same question as FALSY, and `//` cannot tell them apart:
3085:# `null // []` and `false // []` both yield [], so an adopter who wrote an
3086:# EXPLICIT "hooks": null (or "PreCompact": false) would be read as "nothing
3087:# here yet" and silently overwritten with the template — the exact coercion
3088:# the paragraph above promises never happens. Every presence test below is
3089:# therefore `has(...)` on the container, never a `//` default on the value.
3090:. as $orig
3091:| ( if   (($orig | type) != "object")       then null
3092:    elif (($orig | has("hooks")) | not)     then {}
3093:    elif (($orig.hooks | type) == "object") then $orig.hooks
3094:    else null end ) as $ah
3095:| ( if (($tpl[0].hooks | type) == "object") then $tpl[0].hooks else null end ) as $th
3096:| if ($ah == null) or ($th == null) then
3097:    ( if   $mode == "apply"             then $orig
3098:      elif $th == null                  then "SKIP-ALL template"
3099:      elif ($orig | type) != "object"   then "SKIP-ALL document " + ($orig | type)
3100:      else "SKIP-ALL hooks " + ($orig.hooks | type) end )
3101:  else
3102:    ( reduce ($th | to_entries[]) as $te ($orig | .hooks = $ah;
3103:        if (.hooks | has($te.key)) and ((.hooks[$te.key] | type) != "array") then .
3104:        else
3105:          reduce ($te.value[]?) as $blk (.;
3106:              ( if (.hooks | has($te.key)) then .hooks[$te.key] else [] end ) as $cur
3107:            | ( $blk | _keys )                    as $k
3108:            | ( [ $cur[] | _keys[] ] )            as $have
3109:            | if   ($k | length) == 0                                then .
3110:              elif ($k | all(. as $n | $have | any(. == $n)))        then .
3111:              # Only the MISSING entries are appended (rail round 8, P2). A
3112:              # block with several commands of which the adopter already has
3113:              # some would otherwise be appended whole, and every present
3114:              # command would then run twice — for ever, since later upgrades
3115:              # see the duplicate as present. Each entry is judged on its own
3116:              # keys; an entry with none is dropped (the structural guard has
3117:              # already refused such blocks, so this is belt and braces).
3118:              else .hooks[$te.key] = ($cur + [ $blk | .hooks = [ .hooks[]
3119:                       | select(type == "object")
3120:                       | ({hooks: [.]} | _keys) as $ek
3121:                       | select( ($ek | length) > 0 and (($ek | all(. as $n | $have | any(. == $n))) | not) ) ] ]) end )
3122:        end ) ) as $out
3123:    # ENV is part of the roster (rail round 7, P1). A registration is only as
3124:    # advisory as the setting it reads: settings.user.json ships
3125:    # the config-protection hook TOGETHER with env.CEO_CONFIG_PROTECTION_ADVISORY,
3126:    # and an adopter that receives the hook without the key gets the BLOCKING
3127:    # variant. So the .env of the template travels with its .hooks — additively, key
3128:    # by key, never overwriting a value the adopter already has; an .env that is
3129:    # present but not an object is PRESERVED and NAMED, like a non-array event;
3130:    # a template without .env adds nothing (and creates no key, so a document
3131:    # without .env stays byte-identical on a no-op run).
3132:    | ( if   (($out | has("env")) | not)      then {}
3133:        elif (($out.env | type) == "object")  then $out.env
3134:        else null end ) as $ae
3135:    | ( if (($tpl[0] | has("env")) and (($tpl[0].env | type) == "object")) then $tpl[0].env else {} end ) as $te
3136:    | ( if $ae == null then {} else ($te | with_entries(select(.key as $k | ($ae | has($k)) | not))) end ) as $env_add
3137:    | ( if ($env_add | length) > 0 then ($out | .env = ($ae + $env_add)) else $out end ) as $out
3138:    | if $mode == "apply" then $out
3139:      else
3140:        ( [ $th | to_entries[] | .key as $e
3141:            | select( ($ah | has($e)) and (($ah[$e] | type) != "array") )
3142:            # The template keys ride along: a preserved event means every hook
3143:            # the template declares under it is ABSENT from the adopter, and
3144:            # the summary has to be able to NAME them (rail round 3, P2).
3145:            | "SKIP-EVENT " + $e + " " + ($ah[$e] | type) + " " + ([ .value[] | _keys[] ] | _disp) ]
3146:          + [ $out.hooks | to_entries[]
3147:              | select( (.value | type) == "array" )
3148:              | .key as $e
3149:              | ( if ($ah[$e] | type) == "array" then ($ah[$e] | length) else 0 end ) as $n0
3150:              | .value[$n0:][]
3151:              | "ADD " + $e + " " + (_keys | _disp) ]
3152:          + ( if ($ae == null) and (($te | length) > 0)
3153:              then [ "SKIP-ENV " + ($out.env | type) + " " + ($te | keys | join(",")) ]
3154:              else [] end )
3155:          + [ $env_add | keys[] | "ADD-ENV " + . ] )
3156:        | .[]
3157:      end
3158:  end'
3159:
3160:  local _report
3161:  # The adopter's settings.json has to be exactly ONE document too (rail round
3162:  # 11, P2): jq accepts a stream, so an EMPTY file would yield no report and
3163:  # be announced complete, and a stream of objects would yield several merged
3164:  # documents that the object validator below still accepts — the mv would
3165:  # install a file ordinary JSON consumers cannot parse. Unparseable input
3166:  # keeps its own, older name ("malformed settings.json") right below.
3167:  local _set_docs
3168:  _set_docs="$( jq -n --slurpfile s "$settings" '$s | length' 2>/dev/null )" || _set_docs=""
3169:  if [[ -n "$_set_docs" && "$_set_docs" != "1" ]]; then
3170:    echo "    NOTE: settings-merge skipped — .claude/settings.json is not exactly ONE JSON document (found: $_set_docs); PRESERVED untouched; advisory only" >&2
3171:    return 0
3172:  fi
3173:  if ! _report="$( jq -r --arg mode report --slurpfile tpl "$template" "$jq_prog" "$settings" 2>/dev/null )"; then
3174:    echo "    NOTE: settings-merge skipped (malformed settings.json?) — settings.json unchanged; advisory only" >&2
3175:    return 0
3176:  fi
3177:  # A whole-document skip. The reason is NAMED rather than folded into one
3178:  # message: "you wrote an explicit null" and "your .hooks is a list" are
3179:  # different mistakes with different fixes, and the adopter is the one who
3180:  # has to act on it.
3181:  # The observed type rides in a trailing `(found: <type>)` so the sentence a
3182:  # consumer already greps for stays intact: adding the diagnostic must not
3183:  # silently retire the wording the tests and the runbooks match on.
3184:  case "$_report" in
3185:    "SKIP-ALL template")
3186:      echo "    NOTE: settings-merge skipped — the template has no .hooks that is an object; settings.json unchanged; advisory only" >&2
3187:      return 0 ;;
3188:    "SKIP-ALL document "*)
3189:      echo "    NOTE: settings-merge skipped — .claude/settings.json is not a JSON object (found: ${_report#SKIP-ALL document }); PRESERVED untouched; advisory only" >&2
3190:      return 0 ;;
3191:    "SKIP-ALL hooks "*)
3192:      echo "    NOTE: settings-merge skipped — .claude/settings.json has a .hooks that is not an object (found: ${_report#SKIP-ALL hooks }); PRESERVED untouched; advisory only" >&2
3193:      return 0 ;;
3194:  esac
3195:
3196:  # Split the report: SKIP-EVENT lines are named regardless of mode (a silent
3197:  # skip is how a structural surprise becomes permanent); ADD lines drive both
3198:  # the dry-run preview and the post-write summary.
3199:  local _adds=0 _skips=0 _kind _rest _line _l _ev _ty _tail
3200:  local _pending="" _absent=""
3201:  while IFS= read -r _line; do
3202:    [[ -n "$_line" ]] || continue
3203:    _kind="${_line%% *}"; _rest="${_line#* }"
3204:    case "$_kind" in
3205:      SKIP-EVENT)
3206:        # "<event> <type> <template keys under it>" — the type distinguishes an
3207:        # explicit null or false (which we now PRESERVE) from a shape like an
3208:        # object, and the key list is what the summary needs to name the hooks
3209:        # this preservation leaves UNREGISTERED.
3210:        _ev="${_rest%% *}"; _tail="${_rest#* }"
3211:        _ty="${_tail%% *}"; _absent="$_absent$_ev: ${_tail#* }"$'\n'
3212:        _skips=$((_skips+1))
3213:        echo "    NOTE: event '$_ev' in settings.json is not an array (found: $_ty) — PRESERVED untouched, nothing registered under it" >&2
3214:        ;;
3215:      ADD)
3216:        _adds=$((_adds+1))
3217:        _pending="$_pending$_rest"$'\n'
3218:        ;;
3219:      ADD-ENV)
3220:        # A setting the template ships and the adopter lacks. It rides the same
3221:        # counters as a hook: it is written in the same atomic mv, announced in
3222:        # the same dry-run list, and its absence makes the result incomplete.
3223:        _adds=$((_adds+1))
3224:        _pending="${_pending}env $_rest"$'\n'
3225:        ;;
3226:      SKIP-ENV)
3227:        _ty="${_rest%% *}"; _tail="${_rest#* }"
3228:        _absent="${_absent}env: ${_tail}"$'\n'
3229:        _skips=$((_skips+1))
3230:        echo "    NOTE: .env in settings.json is not an object (found: $_ty) — PRESERVED untouched, these template settings are NOT applied: $_tail" >&2
3231:        ;;
3232:    esac
3233:  done <<< "$_report"
3234:
3235:  # A PRESERVED event is not a registered one (rail round 3, P2). With
3236:  # `_adds == 0` the old summary said "every framework hook registration in the
3237:  # template is already present" even when an event had just been skipped —
3238:  # and the hooks the template declares under that event are precisely the ones
3239:  # that are NOT there. The completeness sentence is therefore reserved for
3240:  # `_skips == 0`; otherwise the result is PARTIAL and names what is missing.
3241:  # `_report_preserved` prints that tail for both modes, so the dry-run and the
3242:  # apply cannot drift apart in the one place the adopter reads for reassurance.
3243:  _report_preserved() {  # $1 = "(dry-run) " prefix or ""
3244:    local _p="$1" _a
3245:    echo "    ${_p}PRESERVED: $_skips container(s) in settings.json have an unexpected shape and were left untouched, so these template entries are NOT applied:"
3246:    while IFS= read -r _a; do
3247:      if [[ -z "$_a" ]]; then continue; fi
3248:      case "$_a" in
3249:        env:*) echo "    ${_p}  NOT APPLIED to $_a" ;;
3250:        *)     echo "    ${_p}  NOT REGISTERED under $_a" ;;
3251:      esac
3252:    done <<< "$_absent"
3253:    echo "    ${_p}To apply them, give those containers the expected shape (events: arrays; env: an object) in .claude/settings.json and re-run the upgrade."
3254:  }
3255:
3256:  if [[ "$DRY_RUN" -eq 1 ]]; then
3257:    if [[ "$_adds" -eq 0 ]]; then
3258:      if [[ "$_skips" -eq 0 && "$_tpl_posture" != "shared" ]]; then
3259:        echo "    (dry-run) every framework hook registration in the template is ALREADY present — would be a no-op"
3260:      elif [[ "$_skips" -eq 0 ]]; then
3261:        echo "    (dry-run) PARTIAL (ceremony unknown): hook registrations WITHHELD, the shared settings are in place — pass --ceremony maintainer|user to register the profile you installed"
3262:      else
3263:        echo "    (dry-run) nothing would be REGISTERED — but the result is PARTIAL, not complete:"
3264:        _report_preserved "(dry-run) "
3265:      fi
3266:    else
3267:      echo "    (dry-run) $_adds hook registration(s) missing from .claude/settings.json:"
3268:      # `if`, not `[[ ... ]] && echo`: the AND-list returns 1 on the trailing
3269:      # empty line, and whether that trips `set -e` inside a loop body is a
3270:      # thing a reader should not have to re-derive.
3271:      while IFS= read -r _l; do
3272:        if [[ -n "$_l" ]]; then echo "    (dry-run) would REGISTER $_l"; fi
3273:      done <<< "$_pending"
3274:      [[ "$_skips" -eq 0 ]] || _report_preserved "(dry-run) "
3275:      [[ "$_tpl_posture" != "shared" ]] || echo "    (dry-run) PARTIAL (ceremony unknown): hook registrations WITHHELD — pass --ceremony maintainer|user to register the profile you installed"
3276:    fi
3277:    return 0
3278:  fi
3279:
3280:  if [[ "$_adds" -eq 0 ]]; then
3281:    # Nothing missing => do not touch the file at all. Rewriting it would
3282:    # reformat the adopter's JSON for no reason and break byte-idempotency.
3283:    if [[ "$_skips" -eq 0 && "$_tpl_posture" != "shared" ]]; then
3284:      echo "    OK: every framework hook registration in the template is already present — settings.json untouched"
3285:    elif [[ "$_skips" -eq 0 ]]; then
3286:      echo "    PARTIAL (ceremony unknown): hook registrations WITHHELD, the shared settings are in place — settings.json untouched; pass --ceremony maintainer|user to register the profile you installed"
3287:    else
3288:      echo "    PARTIAL: nothing to register outside the preserved event(s) — settings.json untouched"
3289:      _report_preserved ""
3290:    fi
3291:    return 0
3292:  fi
3293:
3294:  # Backup before the additive merge (rollback path).
3295:  mkdir -p "$BAK_DIR/.claude" 2>/dev/null || true
3296:  cp "$settings" "$BAK_DIR/.claude/settings.json.pre-h8-merge" 2>/dev/null || true
3297:
3298:  local tmp
3299:  tmp="$(mktemp "$settings.upgrade-merge.XXXXXX")" || {
3300:    echo "    NOTE: settings-merge skipped (mktemp failed) — advisory only" >&2
3301:    return 0
3302:  }
3303:  # Atomic: same-directory tempfile, JSON-validated and non-empty BEFORE the
3304:  # mv. jq writing a truncated file (disk full, killed mid-write) must never
3305:  # become the live settings.json.
3306:  if jq --arg mode apply --slurpfile tpl "$template" "$jq_prog" "$settings" > "$tmp" 2>/dev/null \
3307:     && [[ -s "$tmp" ]] \
3308:     && jq -e 'type == "object" and (.hooks | type) == "object"' "$tmp" >/dev/null 2>&1; then
3309:    if mv "$tmp" "$settings"; then
3310:      echo "    REGISTERED: $_adds hook registration(s) derived from the template (idempotent — re-runs are no-ops):"
3311:      while IFS= read -r _l; do
3312:        if [[ -n "$_l" ]]; then echo "      $_l"; fi
3313:      done <<< "$_pending"
3314:      # Same tail as the dry-run: a run that registered something AND preserved
3315:      # an event is still a PARTIAL result, and saying so is the whole point.
3316:      [[ "$_skips" -eq 0 ]] || _report_preserved ""
3317:      if [[ "$_tpl_posture" == "shared" ]]; then
3318:        # The audit copy of what an unknown-ceremony upgrade applied lands next
3319:        # to the backup — only here, on the path that actually wrote.
3320:        if cp "$template" "$BAK_DIR/.claude/settings.template-shared.json" 2>/dev/null; then
3321:          echo "    kept the derived shared settings at $BAK_DIR/.claude/settings.template-shared.json"
3322:        fi
3323:        echo "    PARTIAL (ceremony unknown): hook registrations WITHHELD — pass --ceremony maintainer|user to register the profile you installed"
3324:      fi
3325:    else
3326:      rm -f "$tmp"
3327:      echo "    NOTE: settings-merge atomic mv failed — settings.json unchanged; advisory only" >&2
3328:    fi
3329:  else
3330:    rm -f "$tmp"
3331:    echo "    NOTE: settings-merge jq failed (malformed settings.json?) — settings.json unchanged;" >&2
3332:    echo "          backup at $BAK_DIR/.claude/settings.json.pre-h8-merge; advisory only" >&2
3333:  fi
3334:  return 0
3335:}
