1490:+    # lookbehind; the two extractors have to agree or one of them is lying.
1491:+    | ([ match("(?<![A-Za-z0-9_.-])[A-Za-z0-9_][A-Za-z0-9_.-]*\\.py(?![A-Za-z0-9_.-])"; "g").string ]) as $py
