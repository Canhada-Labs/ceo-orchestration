  3338	# ===========================================================================
  3339	# PLAN-163 T5.4 — BASELINE-AWARE settings migration (3-state per LEAF KEY).
  3340	# ---------------------------------------------------------------------------
  3341	# WHY: the H8 merge above only registers lifecycle hooks — an adopter whose
  3342	# settings.json is otherwise preserved would NEVER receive the Claude-5
  3343	# fleet refresh (availableModels/fallbackModel) nor the defaultMode posture.
  3344	# This step migrates EXACTLY the leaf keys enumerated in _T54_BASELINES_JSON
  3345	# (the normative table above) with an explicit, IDEMPOTENT policy per key:
  3346	#   ABSENT                    -> write the NEW baseline
  3347	#   EQUAL to the OLD baseline -> update to the NEW baseline
  3348	#       (arrays byte-compared: exact values in exact order)
  3349	#   CUSTOMIZED (anything else)-> PRESERVE + named WARNING (never clobber)
  3350	#   already at the NEW baseline -> no-op (so a re-run changes nothing)
  3351	# New-event registrations (DirectoryAdded/Notification) are added ONLY when
  3352	# not yet registered AND the T3.4 version-floor feature gate is on
  3353	# (_t34_new_event_registrations_enabled). Customized registrations under the
  3354	# same events — and every other hooks entry/settings key — stay untouched.
  3355	# PLAN-164 W1 (ADR-110-AMEND-1, recalibrated by ADR-110-AMEND-2): the
  3356	# check_pair_rail.py PreToolUse registration TIMEOUT VALUE migrates under
  3357	# the same 3-state policy — any frozen SUPERSEDED SHIPPED cap (60, 150)
  3358	# -> the cap DERIVED from the template artifact
  3359	# (templates/settings/settings.base.json pair-rail entry; install.sh copies
  3360	# it verbatim, so template value == post-install value == migration target);
  3361	# any other adopter-chosen value is PRESERVED + named WARNING; idempotent.
  3362	# The file is rewritten ONLY when at least one key actually changed (atomic
  3363	# same-directory tempfile + os.replace), so running the upgrade twice is
  3364	# byte-identical (idempotency oracle). Fail-open per CLAUDE.md §4: missing
  3365	# python3 / unreadable settings / write error => stderr NOTE + the upgrade
  3366	# proceeds; a backup always lands under $BAK_DIR first on non-dry runs.
  3367	# Opt out: --no-settings-migrate. --dry-run previews every verdict.
  3368	# ===========================================================================
  3369	_migrate_settings_baseline() {
  3370	  [[ "$SETTINGS_MIGRATE" -eq 1 ]] || return 0
  3371	  local settings="$TARGET/.claude/settings.json"
  3372	  if [[ ! -f "$settings" ]]; then
  3373	    echo "    NOTE: settings baseline migration skipped — no $settings (fresh install builds it from template)" >&2
  3374	    return 0
  3375	  fi
  3376	  if ! command -v python3 >/dev/null 2>&1; then
  3377	    echo "    NOTE: settings baseline migration skipped (python3 not found) — advisory only" >&2
  3378	    return 0
  3379	  fi
  3380	
  3381	  echo ""
  3382	  echo "==> Settings baseline migration (PLAN-163 T5.4 — 3-state per leaf key)"
  3383	
  3384	  local _mig_mode="apply"
  3385	  local _mig_gate="0"
  3386	  # PLAN-164 W1: the pair-rail registration-timeout migration target is
  3387	  # DERIVED from the source template artifact (see the helper below).
  3388	  local _mig_template="$SOURCE_DIR/templates/settings/settings.base.json"
