   181	_ancestor_tree_digest() {
   182	  python3 -I - "$1" <<'PY'
   183	import hashlib
   184	import os
   185	import stat
   186	import sys
   187	
   188	root = sys.argv[1]
   189	rows = []
   190	for directory, dirs, files in os.walk(root, followlinks=False):
   191	    for path in [directory] + [os.path.join(directory, x) for x in sorted(dirs + files)]:
   192	        info = os.lstat(path)
   193	        payload = ""
   194	        if stat.S_ISREG(info.st_mode):
   195	            with open(path, "rb") as stream:
   196	                payload = hashlib.sha256(stream.read()).hexdigest()
   197	        elif stat.S_ISLNK(info.st_mode):
   198	            payload = os.readlink(path)
   199	        rows.append((os.path.relpath(path, root), info.st_mode, info.st_ino,
   200	                     info.st_mtime_ns, payload))
   201	print(hashlib.sha256(repr(sorted(set(rows))).encode()).hexdigest())
   202	PY
   203	}
