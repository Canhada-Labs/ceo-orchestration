4246:# PLAN-177 W1 (P1-1 / CF-9) — the .gitignore surfaces install.sh has always
4247:# delivered and this script never did.
4248:#
4249:# Root .gitignore: two marker-guarded blocks (MCP shared-secret store, PLAN-019
4250:# P2-SEC-H; posture/runtime state, PLAN-165 CX-3). An adopter who installed at
4251:# v1.2.0 and only ever upgrades got /night-mode without the posture ignores, so
4252:# `on` leaves the permission overlay + state marker untracked (PLAN-165 AC-1
4253:# says `git status` stays empty); an adopter older than v1.2.0 never got the
4254:# secrets entry either. The parity gate named the gap and allowlisted it, so CI
4255:# could not fail on it. Both deliveries are ADDITIVE + idempotent and go
4256:# through the SAME generator install.sh calls (INV-4/PLAN-168 W2 — two copies
4257:# of one emitted text is the class that produced the pointer divergence). The
4258:# ORDER (secrets, then posture) mirrors install.sh's two call sites, because it
4259:# decides the order of the blocks in the resulting file.
4260:#
4261:# CEREMONY-GATED, mirroring the PROTOCOL.md skip above: install.sh guards both
4262:# of its calls with `[[ "$CEREMONY" != "user" ]]` (a user install writes no root
4263:# files at all, WS4), so skipping here is what keeps the two routes in
4264:# agreement. A line number would rot the moment either file moves.
4265:#
4266:# Missing generator = broken checkout, fails LOUD. That is install.sh's posture
4267:# for this library, not the preserve-the-surface posture of
4268:# _refresh_protocol_pointer: nothing here overwrites an adopter file, so there
4269:# is no surface a silent degrade would be protecting.
4270:echo ""
4271:echo "==> Refreshing root .gitignore framework blocks (PLAN-019 P2-SEC-H + PLAN-165 CX-3)"
4272:if [[ "$CEREMONY_EFFECTIVE" == "user" ]]; then
4273:  echo "    SKIP: root .gitignore blocks (recorded --ceremony user install — install.sh writes no root files either)"
4274:else
4275:  command -v _mcp_secrets_ignore_entry >/dev/null 2>&1 || {
4276:    echo "    ERROR: _mcp_secrets_ignore_entry unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot ensure the MCP-secrets .gitignore entry" >&2
4277:    exit 1
4278:  }
4279:  command -v _apply_mcp_secrets_ignore >/dev/null 2>&1 || {
4280:    echo "    ERROR: _apply_mcp_secrets_ignore unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot ensure the MCP-secrets .gitignore entry" >&2
4281:    exit 1
4282:  }
4283:  command -v _posture_state_ignore_entries >/dev/null 2>&1 || {
4284:    echo "    ERROR: _posture_state_ignore_entries unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot ensure posture-state .gitignore entries" >&2
4285:    exit 1
4286:  }
4287:  command -v _apply_posture_state_ignores >/dev/null 2>&1 || {
4288:    echo "    ERROR: _apply_posture_state_ignores unavailable (scripts/_framework_manifest_set.sh not sourced) — cannot ensure posture-state .gitignore entries" >&2
4289:    exit 1
4290:  }
4291:  _UP_MCP_ENTRY="$( _mcp_secrets_ignore_entry )"
4292:  _UP_POSTURE_ENTRIES="$( _posture_state_ignore_entries )"
4293:  if [[ "$DRY_RUN" -eq 1 ]]; then
4294:    # t8 P2: the SHARED predicate, not a duplicated -L — the preview must
4295:    # refuse exactly where the real run refuses, by the same code path.
4296:    if ! _root_gitignore_symlink_guard "$TARGET/.gitignore" >/dev/null 2>&1; then
4297:      echo "    (dry-run) ERROR: root .gitignore is a symlink — real run would REFUSE" >&2
4298:      exit 1
4299:    fi
4300:    # t11 P1 #2: honest dry-run for TRACKED sensitive paths too — the
4301:    # real run refuses and demands git rm --cached.
4302:    _dry_tracked="$( _gitignore_tracked_sensitive "$TARGET" \
4303:      ".claude/settings.local.json" ".claude/state" "state/mcp_client_secrets" )"
4304:    if [ -n "$_dry_tracked" ]; then
4305:      echo "    (dry-run) ERROR: sensitive path(s) already TRACKED — real run would REFUSE and demand git rm --cached:" >&2
4306:      printf '%s\n' "$_dry_tracked" | sed 's/^/      /' >&2
4307:      exit 1
4308:    fi
4309:    echo "    (dry-run) would ENSURE .gitignore excludes: $_UP_MCP_ENTRY"
4310:    echo "    (dry-run) would ENSURE .gitignore excludes: $_UP_POSTURE_ENTRIES"
4311:  else
4312:    _up_record_op "ensure_mcp_secrets_ignore" "$_UP_MCP_ENTRY"
4313:    _apply_mcp_secrets_ignore "$TARGET/.gitignore"
4314:    _up_record_op "ensure_posture_state_ignores" "$_UP_POSTURE_ENTRIES"
4315:    _apply_posture_state_ignores "$TARGET/.gitignore"
4316:  fi
4317:fi
