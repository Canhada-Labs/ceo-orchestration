  1145	        _invoke_value_dashboard_summarize(
  1146	            repo_root=repo_root,
  1147	            session_id=session_id,
  1148	        )
  1149	        # PLAN-179 W2 US8 — emit BEFORE session_end so the delta lands in
  1150	        # the same session window, adjacent for a reader scanning
  1151	        # backwards from session_end (SESSIONEND-NOTE.md §5 constraint #2).
  1152	        if delta is not None:
  1153	            _emit_session_memory_delta(
  1154	                session_id=_delta_sid, repo_root=repo_root, delta=delta,
  1155	            )
  1156	        _emit_session_end(
  1157	            session_id=session_id,
  1158	            reason=reason,
  1159	            memory_state=memory_state,
  1160	            repo_root=repo_root,
  1161	        )
  1162	        message = (
  1163	            f"SessionEnd: reason={reason}, "
  1164	            f"memory_writable={memory_state.get('writable')}"
  1165	        )
