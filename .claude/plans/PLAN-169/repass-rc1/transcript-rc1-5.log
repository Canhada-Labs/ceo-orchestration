   673	
   674	def _git(repo_root: Path, args: List[str], deadline: float) -> Optional[str]:
   675	    """Run ``git <args>`` in ``repo_root``. None on ANY failure/timeout."""
   676	    if time.monotonic() >= deadline:
   677	        return None
   678	    try:
   679	        proc = subprocess.run(
   680	            ["git"] + list(args),
   681	            cwd=str(repo_root),
   682	            stdout=subprocess.PIPE,
   683	            stderr=subprocess.DEVNULL,
   684	            timeout=min(_GIT_TIMEOUT_S, max(0.05, deadline - time.monotonic())),
   685	            check=False,
   686	        )
   687	    except Exception:
   688	        return None
   689	    if proc.returncode != 0:
   690	        return None
   691	    try:
   692	        return proc.stdout.decode("utf-8", "replace")
   693	    except Exception:  # pragma: no cover
   694	        return None
