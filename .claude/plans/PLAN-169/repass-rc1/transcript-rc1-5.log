  1197	def _open_index_directory(path: str, parent_fd: Optional[int] = None) -> int:
  1198	    """Open one real directory relative to an already validated parent.
  1199	
  1200	    The repository root is the trust anchor; components below it are opened
  1201	    one at a time. Unsupported no-follow primitives make the optional index
  1202	    unavailable rather than falling back to a pathname read.
  1203	    """
  1204	    if not all(hasattr(os, name) for name in ("O_DIRECTORY", "O_NOFOLLOW")):
  1205	        raise OSError("no-follow directory reads unavailable")
  1206	    before = os.stat(path, dir_fd=parent_fd, follow_symlinks=False)
  1207	    if not stat_mod.S_ISDIR(before.st_mode):
  1208	        raise OSError("index ancestor is not a real directory")
  1209	    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
  1210	                 dir_fd=parent_fd)
  1211	    try:
  1212	        after = os.fstat(fd)
  1213	        if (not stat_mod.S_ISDIR(after.st_mode)
  1214	                or (after.st_dev, after.st_ino) != (before.st_dev, before.st_ino)):
  1215	            raise OSError("index directory changed identity")
  1216	    except BaseException:
  1217	        os.close(fd)
  1218	        raise
  1219	    return fd
