   142	def _memory_dir_state(repo_root: Path) -> Dict[str, object]:
   143	    """Check native memory dir health. Returns {writable, memory_md_present}.
   144	
   145	    Uses ~/.claude/projects/<slug>/memory/ where slug is derived from
   146	    the absolute repo path. Best-effort — never raises.
   147	    """
   148	    state: Dict[str, object] = {
   149	        "writable": False,
   150	        "memory_md_present": False,
   151	        "slug": "",
   152	    }
   153	    try:
   154	        from _lib import runtime_paths as _rp
   155	
   156	        slug = _rp.project_slug(str(repo_root))  # PLAN-182 W3 (S321): slug via resolvedor unico
   157	        memory_dir = Path.home() / ".claude" / "projects" / slug / "memory"
   158	        state["slug"] = slug
   159	        if memory_dir.is_dir():
   160	            state["writable"] = os.access(memory_dir, os.W_OK)
   161	            state["memory_md_present"] = (memory_dir / "MEMORY.md").is_file()
   162	    except Exception:
   163	        pass
   164	    return state
