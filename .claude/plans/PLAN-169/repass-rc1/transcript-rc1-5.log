   550	def _parse_commit_args(args: List[str], inv: CommitInvocation) -> None:
   551	    """Fill ``all_flag`` / ``amend`` / ``message`` / ``pathspecs``."""
   552	    i = 0
   553	    n = len(args)
   554	    after_ddash = False
   555	    while i < n:
   556	        tok = args[i]
   557	        if tok in _SEPARATORS:
   558	            break
   559	        if after_ddash:
   560	            inv.pathspecs.append(tok)
   561	            i += 1
   562	            continue
   563	        if tok == "--":
   564	            after_ddash = True
   565	            i += 1
   566	            continue
   567	        if tok in ("-a", "--all"):
   568	            inv.all_flag = True
   569	            i += 1
   570	            continue
   571	        if tok == "--amend":
   572	            inv.amend = True
   573	            i += 1
   574	            continue
   575	        if tok in ("-m", "--message"):
   576	            if i + 1 < n:
   577	                inv.message = args[i + 1]
   578	                i += 2
   579	                continue
   580	            i += 1
   581	            continue
   582	        if tok.startswith("--message="):
   583	            inv.message = tok[len("--message="):]
   584	            i += 1
   585	            continue
   586	        if tok == _PATHSPEC_FROM_FILE or tok.startswith(_PATHSPEC_FROM_FILE + "="):
   587	            # O commit passa a ser dirigido por paths que este hook NAO
   588	            # resolve (o arquivo pode conter globs, exclusoes, diretorios).
   589	            # Marcar como pathspec faz `_committed_paths()` devolver None e o
   590	            # caller reportar `unparseable` — a MESMA resposta que o modulo ja
   591	            # da para pathspec explicito, nao uma semantica nova.
   592	            inv.pathspecs.append(_PATHSPEC_FROM_FILE)
   593	            i += 2 if (tok == _PATHSPEC_FROM_FILE and i + 1 < n) else 1
   594	            continue
   595	        if tok in _COMMIT_VALUE_OPTS_LONG:
   596	            # Consume the VALUE too, or it lands in `pathspecs` and makes an
   597	            # ordinary commit look unparseable.
   598	            i += 2 if i + 1 < n else 1
   599	            continue
   600	        if tok.startswith("--"):
   601	            i += 1
   602	            continue
   603	        if tok in _COMMIT_VALUE_OPTS_SHORT:
   604	            i += 2 if i + 1 < n else 1
