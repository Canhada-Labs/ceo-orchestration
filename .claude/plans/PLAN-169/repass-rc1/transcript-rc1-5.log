   761	def _memory_delta_observed(repo_root: Path, session_id: str) -> Dict[str, object]:
   762	    """The stat-only observation (SESSIONEND-NOTE.md §2/§3). Never raises.
   763	
   764	    Returns exactly ``{outcome, files_count, modified_count, index_modified,
   765	    names, anchor_source}`` — ``names`` (sanitized basenames, sorted, ≤
   766	    ``_MEMORY_DELTA_MAX_NAMES``) is rendered NOWHERE since rail r22 (the
   767	    operator line is counts-only; the list stays as the tested ingress
   768	    gate for any future render) and is never passed to audit_emit;
   769	    ``anchor_source`` rides the dict because the §4 wire contract needs
   770	    it (see ``_session_start_ts``).
   771	
   772	    Outcome precedence: a real modification wins ("written"/"index_only" —
   773	    the truest fact even on a degraded dir), then ``start_unknown`` (no
   774	    window ⇒ nothing can be claimed modified, by construction), then
   775	    ``not_writable``, then ``absent``. The whole pass is wall-capped at
   776	    ``_MEMORY_DELTA_SCAN_BUDGET_MS``; exhaustion returns partial counts
   777	    with ``outcome="error"`` — a slow filesystem must never be reported as
   778	    "memory written".
   779	
   780	    Rail r6 P2-a: the observation is WINDOW-scoped, never an AUTHORSHIP
   781	    claim — the per-project memory dir is SHARED, and a concurrent
   782	    session's write inside this session's window counts (ADR-005 overlap
   783	    is a supported case). A stat carries no author; the wire row says
   784	    "activity inside THIS session's window over the project dir", and
   785	    per-write provenance would need infrastructure this stat-only rail
   786	    refuses by design."""
   787	    out: Dict[str, object] = {
   788	        "outcome": "error",
   789	        "files_count": 0,
   790	        "modified_count": 0,
   791	        "index_modified": False,
   792	        "names": [],
   793	        "anchor_source": "none",
   794	    }
   795	    try:
   796	        state = _memory_dir_state(repo_root)
   797	        slug = str(state.get("slug") or "")
   798	        if not slug:
   799	            # Rail r12 P2-c: slug vazio e falha de INFRA (runtime_paths
   800	            # ausente/raise num upgrade parcial), nunca evidencia de
   801	            # diretorio ausente — dir_missing aqui seria claim FALSO
   802	            # escondendo a falha real. outcome fica "error" (o default) e
   803	            # o breadcrumb nomeia a causa (regra fail-open de infra).
   804	            sys.stderr.write(
   805	                "[SessionEnd] memory-delta: slug unresolved (infra)\n"
   806	            )
   807	            return out
   808	        # Fronteira declarada (rail r11 P2-a, refutado): o DIRETORIO de
   809	        # memoria pode ser um symlink legitimo (dotfiles managers) e e
   810	        # seguido — a observacao e sobre o CONTEUDO real da memoria,
   811	        # onde quer que viva. A garantia no-symlink do r10 e por ENTRADA
   812	        # (um link dentro do dir nunca atribui mtime externo a um topico);
