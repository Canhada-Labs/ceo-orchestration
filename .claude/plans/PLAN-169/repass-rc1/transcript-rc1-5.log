   305	def _parse_snapshot(raw: Any) -> Optional[Dict[str, Any]]:
   306	    """Parse a scratchpad blob into the snapshot dict, or None.
   307	
   308	    Factored out of ``_read_snapshot`` (PLAN-179 W1 US3) so the plan-scope and
   309	    session-scope reads share BYTE-IDENTICAL validation — a fallback path with
   310	    its own laxer parser would be exactly the kind of second, weaker door this
   311	    repo keeps finding."""
   312	    if not raw:
   313	        return None
   314	    try:
   315	        data = json.loads(raw.decode("utf-8") if isinstance(raw, bytes) else raw)
   316	    except (ValueError, AttributeError) as exc:
   317	        _breadcrumb("snapshot parse failed (%s)" % str(exc)[:60])
   318	        return None
   319	    return data if isinstance(data, dict) else None
