   205	def _resolve_session_id(session_id: Optional[str]) -> str:
   206	    """Return the effective session id, checking CLAUDE_SESSION_ID if arg is None.
   207	
   208	    Empty / whitespace-only values are treated as missing.
   209	    """
   210	    if session_id is not None:
   211	        val = str(session_id).strip()
   212	        return val
