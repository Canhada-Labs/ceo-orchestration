   656	def _sanitize_memory_basename(name: object) -> Optional[str]:
   657	    """§6 ingress gate for ONE rendered basename → the name, or None = DROP.
   658	
   659	    Memory basenames were written by a PREVIOUS session's model and enter
   660	    the current model's context via ``systemMessage`` — untrusted content on
   650	    # mudanca no tool_lifecycle (fora do escopo revisado). O valor
   651	    # "state_file" do enum permanece REGISTRADO no wire por compat — este
   652	    # produtor nunca mais o emite. chain-or-none e a resolucao honesta.
   653	    return None, "none"
