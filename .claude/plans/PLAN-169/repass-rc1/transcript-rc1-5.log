   495	# materializada) estourava o budget; r3/r4 (janela por posicao) starvavam a
   496	# cauda; r5/r6 (fatia por identidade + contador de sweep) garantiam a fatia
   497	# mas nao a RETOMADA — com a ordem do scandir estavel, um break por deadline
   498	# caia sempre no mesmo prefixo e a cauda nunca era alcancada. O que garante
   499	# cobertura e retomar DE ONDE PAROU: os escopos sao ordenados
   500	# lexicograficamente, o processamento comeca no primeiro escopo DEPOIS do
   501	# cursor persistido e da a volta (wrap); o cursor grava o ultimo escopo
   502	# DECIDIDO. Em N varreduras, todo escopo e visitado.
   503	_GC_CURSOR_NAME = ".gc-scan-cursor"
   504	
   505	# Teto duro de entradas lidas no scandir (anti-DoS num diretorio patologico;
   506	# ler nomes e barato, mas nada aqui pode ser ilimitado dentro de um hook).
   507	_GC_SCAN_HARD_CAP = 20000
   508	
   509	
   510	def _gc_read_cursor(state_dir):
   511	    """Ultimo escopo DECIDIDO pela varredura anterior, ou '' (comeco)."""
   512	    try:
   513	        raw = (Path(str(state_dir)) / _GC_CURSOR_NAME).read_text(
   514	            encoding="utf-8"
   515	        ).strip()
   516	    except Exception:
   517	        return ""
   518	    return raw if _SESSION_SCOPE_ID_RE.match(raw) else ""
   519	
   520	
   521	def _gc_write_cursor(state_dir, stem):
   522	    """Persiste o cursor com o idioma atomico O_EXCL+O_NOFOLLOW do marker.
   523	
   524	    Falha de escrita e housekeeping (fail-open): custa recomecar do mesmo
   525	    ponto na proxima varredura, nunca correcao."""
   526	    cursor_path = Path(str(state_dir)) / _GC_CURSOR_NAME
   527	    try:
   528	        cursor_path.parent.mkdir(parents=True, exist_ok=True)
   529	        tmp = cursor_path.parent / (
   530	            "." + cursor_path.name + "." + str(os.getpid()) + "."
   531	            + os.urandom(4).hex() + ".tmp"
   532	        )
   533	        flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | getattr(os, "O_NOFOLLOW", 0)
   534	        fd = os.open(str(tmp), flags, 0o600)
   535	        try:
   536	            with os.fdopen(fd, "w", encoding="utf-8") as fh:
   537	                fh.write(str(stem))
   538	        except Exception:
   539	            try:
   540	                os.unlink(str(tmp))
   541	            except OSError:
   542	                pass
   543	            raise
   544	        os.replace(str(tmp), str(cursor_path))
   545	    except Exception:
   546	        pass
