   481	def _write_snapshot(
   482	    plan_id: str, blob: Dict[str, Any], session_id: Optional[str] = None
   483	) -> str:
   484	    """Persist the snapshot blob to the plan- or session-scoped scratchpad.
   485	
   486	    Returns the closed-enum snapshot_outcome:
   487	
   488	      - ``written`` — plan scope resolved, blob written under ``plan_id``;
   489	      - ``written_session_scope`` — PLAN-179 W1 US3: no plan scope, but the
   490	        hook input carried a usable session id, so the blob was written under
   491	        the SESSION store (``scope_kind="session"`` inside the blob; the
   492	        ``plan_id`` field is left at ``unknown`` — emenda r1-C1 forbids
   493	        overloading it, the store's plan-isolation invariant depends on it);
   494	      - ``scratchpad_unavailable`` — a REAL unavailability: the scratchpad_lib
   495	        import failed, or there is no scope we are allowed to write under
   496	        (session id absent / malformed / env-sourced ⇒ refused, r1-C1). It no
   497	        longer means "the plan was not resolved" — that case now WRITES;
   498	      - ``error`` — serialization or the store write itself failed.
   499	
   500	    Secrets: the blob is handed to ``store.set`` as a ``str`` on BOTH paths so
   501	    the store's ``redact_secrets`` pass actually runs (PLAN-179 amendment 8.3
   502	    / debate C9 — the previous ``payload.encode("utf-8")`` took the bytes
   503	    branch, which ``state_store`` trusts verbatim, making the documented
   504	    "secrets-redacted" claim false on the only path this hook used).
   505	    ``set`` overwrites the prior snapshot in either scope."""
   506	    try:
   507	        from _lib import scratchpad_lib  # noqa: E402
   508	    except Exception as exc:
   509	        _breadcrumb("scratchpad_lib import failed at write (%s)" % str(exc)[:60])
   510	        return "scratchpad_unavailable"
   511	
   512	    plan_scoped = plan_id != "unknown" and plan_id.startswith("PLAN-")
   513	    if not plan_scoped and not session_id:
   514	        # No scope we may write under: the plan is unresolved AND the session
   515	        # id was absent/malformed/env-sourced. The audit event still records
   516	        # the attempt (PostCompact degrades to snapshot_found=False).
   517	        _breadcrumb("no plan scope and no hook-input session id — write skipped")
   518	        return "scratchpad_unavailable"
   519	
   520	    # scope_kind travels INSIDE the blob (r1-C1) so the PostCompact half can
   521	    # tell a session-scoped snapshot from a plan-scoped one without guessing.
   522	    #
   523	    # PLAN-179 W0/W1 cross-file pass — closes the "recalled closed set" defect:
   524	    # this used to write the literal strings "plan"/"session". The enum's owner
   525	    # is scratchpad_lib (SCOPE_KIND_PLAN / SCOPE_KIND_SESSION, validated by
   526	    # stamp_scope_kind, which RAISES on an off-enum value). Stamping through the
   527	    # library means a future rename cannot leave this writer emitting a value
   528	    # the PostCompact reader no longer recognises
   529	    # ([[feedback-closed-sets-must-be-derived-not-recalled]]).
   530	    body = dict(blob)
   531	    try:
   532	        scope_kind = (
   533	            scratchpad_lib.SCOPE_KIND_PLAN
   534	            if plan_scoped
   535	            else scratchpad_lib.SCOPE_KIND_SESSION
   536	        )
