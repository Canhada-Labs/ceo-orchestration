   540	        # genuine cross-version case); ValueError = an off-enum scope_kind, which
   541	        # would be a bug in THIS file. Either way the snapshot is still worth
   542	        # writing, but it MUST carry the field the PostCompact reader keys on —
   543	        # so fall back to the literal and say loudly that the library did not
   544	        # own the enum on this run.
   545	        _breadcrumb(
   546	            "scratchpad_lib scope-kind API unavailable/refused (%s) — "
   547	            "stamping scope_kind inline; expected the library to own this enum"
   548	            % str(exc)[:60]
   549	        )
   550	        body["scope_kind"] = "plan" if plan_scoped else "session"
   551	    # Rail round-8 [P1]: redaction is a FIELD-level duty here, not a
   552	    # store-level one. `state_store.set` runs `redact_secrets` over str
   553	    # values, and its kv pattern (`token=\S{1,2048}`) is JSON-blind: on a
   554	    # serialized snapshot whose field ends in assignment-shaped text
   555	    # (`deploy token=abc`) it consumes the closing quote/comma and stores
   556	    # MALFORMED JSON — PostCompact parses nothing and the continuity cure
   557	    # dies silently for exactly the secrets it must survive. So every str
   558	    # field is redacted BEFORE serialization (max_chars=0, no truncation)
   559	    # and the store receives BYTES — its documented "caller owns the
   560	    # content" route (amendment 8.3's redaction CLAIM stays true; only the
   561	    # layer that fulfils it moved). If the redactor is unavailable, fall
   562	    # back to the old str path: the store's pass still guarantees nothing
   563	    # unredacted lands on disk (the residual cost is the corruption this
   564	    # cure removes — never a secret).
   565	    try:
   566	        from _lib.redact import redact_secrets as _redact_fn
   567	    except Exception:
   568	        _redact_fn = None
   569	    if _redact_fn is not None:
   570	        def _redact_tree(node):
   571	            if isinstance(node, str):
   572	                return _redact_fn(node, max_chars=0)
   573	            if isinstance(node, dict):
   574	                return {k: _redact_tree(v) for k, v in node.items()}
   575	            if isinstance(node, list):
   576	                return [_redact_tree(v) for v in node]
   577	            return node
   578	        try:
   579	            body = _redact_tree(body)
   580	        except Exception as exc:
   581	            _breadcrumb("snapshot field redaction failed (%s)" % str(exc)[:60])
   582	            _redact_fn = None
   583	
   584	    try:
   585	        payload = json.dumps(body, ensure_ascii=False, sort_keys=True)
   586	    except (TypeError, ValueError) as exc:
   587	        _breadcrumb("snapshot serialize failed (%s)" % str(exc)[:60])
   588	        return "error"
   589	    store_value = (
   590	        payload.encode("utf-8") if _redact_fn is not None else payload
   591	    )
   592	
   593	    try:
   594	        if plan_scoped:
   595	            with scratchpad_lib.open_scratchpad(plan_id=plan_id) as store:
   596	                store.set(SCRATCHPAD_KEY, store_value)
   597	            return "written"
