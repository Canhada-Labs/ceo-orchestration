  1269	def _ac_path_index_mirror(
  1270	    cwd: str, deadline: float
  1271	) -> Tuple[Dict[str, str], bool]:
  1272	    """``(AC path -> PLAN-NNN, complete)`` — perna plan_ac espelhada.
  1273	
  1274	    Bounded pelos MESMOS caps do checkpoint + o wall deadline
  1275	    compartilhado; em path repetido o MENOR plan id vence (determinismo).
  1276	    Nada aqui consulta session state, env ou audit log (emenda r1-C6).
  1277	
  1278	    Rail r15 P2-b: ``complete=False`` em QUALQUER corte — enumeracao falha,
  1279	    >200 arquivos de plano (o slice esconderia planos), deadline no meio,
  1280	    arquivo ilegivel, ou AC alem do cap de 256 KiB de UM arquivo (lido
  1281	    cap+1 para detectar). Um mapeamento parcial elege plano ERRADO no
  1282	    tie-break do chamador; o chamador recusa o indice inteiro. The AC grammar
  1283	    and matching rules mirror the checkpoint; filesystem reads additionally
  1284	    require a no-follow directory chain and a stable regular-file identity.
  1285	    An unsafe candidate invalidates the whole index, including earlier ACs.
  1286	    """
  1287	    index: Dict[str, str] = {}
  1288	    try:
  1289	        if time.monotonic() >= deadline:
  1290	            return {}, False
  1291	        with _plan_index_directory(cwd) as directory_fd:
  1292	            # Scan the held descriptor itself: a second pathname-based glob
  1293	            # could follow an ancestor replaced after the directory checks.
  1294	            # scandir errors remain visible (glob otherwise swallows them).
  1295	            all_files: List[str] = []
  1296	            with os.scandir(directory_fd) as entries:
  1297	                for entry in entries:
  1298	                    if time.monotonic() >= deadline:
  1299	                        return {}, False
