   210	# CLI — the resolver for SHELL consumers (PLAN-182 OQ-6; Owner decision
   211	# 2026-08-22, S322; landed S326).
   212	#
   213	# The two pre-push review gates delivered to adopters and the operator
   214	# scripts ceo-backup.sh / ceo-restore.sh are bash. Without a CLI they rebuilt
   215	# the literal locally — the class W1 closed for Python — and a review APPROVE
   216	# recorded in one adopter satisfied the gate in ANOTHER (shared state dir).
   217	# Contract: module docstring §CLI contract. Keep it a thin printer: every
   218	# rule lives in the functions above, the CLI only chooses which one to call.
   219	# ---------------------------------------------------------------------------
   220	
   221	_CLI_MODES = ("--state-dir", "--slug", "--project-dir")
   222	_CLI_USAGE = (
   223	    "usage: runtime_paths.py [--state-dir | --slug | --project-dir] "
   224	    "[--project PATH]\n"
   225	    "  --state-dir     per-project runtime state dir (default)\n"
   226	    "  --slug          native path-based project slug\n"
   227	    "  --project-dir   the project dir the slug is derived from\n"
   228	    "  --project PATH  derive for PATH instead of CLAUDE_PROJECT_DIR / cwd\n"
   229	)
