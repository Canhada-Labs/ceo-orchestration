   547	                _pfx = hmac_chain.get("last_hmac_prefix", "")
   548	                if not isinstance(_pfx, str) or not re.fullmatch(
   549	                    _HMAC_PREFIX_PATTERN, _pfx
   550	                ):
   551	                    if _pfx != "":
   552	                        _breadcrumb("hmac_chain.last_hmac_prefix off-shape — suffix dropped")
