  1084	        return (
  1085	            "SessionEnd: memory delta UNKNOWN (session start not "
  1086	            "resolvable) — treat as unverified"
  1087	        )
  1088	    return "SessionEnd: memory delta UNAVAILABLE (%s)" % outcome
