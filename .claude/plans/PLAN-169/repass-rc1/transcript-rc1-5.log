  1320	                    # would remove the leading dot from `.claude/...`.
  1321	                    while candidate.startswith("./"):
  1322	                        candidate = candidate[2:]
  1323	                    if not candidate or candidate.startswith("<"):
  1324	                        continue
  1325	                    current = index.get(candidate)
  1326	                    if current is None or plan_id < current:
  1327	                        index[candidate] = plan_id
