   414	def _build_pointers(
   415	    plan_id: str, snapshot: Optional[Dict[str, Any]], age_s: int
   416	) -> List[str]:
   417	    """Assemble the POINTERS-ONLY governance reinjection lines.
   418	
   419	    Order: durable Gate-1 reminder first (always present), then plan-derived
   420	    pointers from the snapshot. Each pointer names a location — never a body.
   421	    Bounded to <=9 lines (pointer_count audit enum).
   422	
   423	    PLAN-179 W1-b [r1-C3]: this cap is the POINTER budget and nothing else.
   424	    The pinned constraints are rendered by ``_render_constraints`` on their own
   425	    budget and prepended by ``gate`` — a work-state pointer must never be able
   426	    to push a governance rule out of the payload."""
   427	    # rc.1 re-pass part 5 H1 — the FIELD NAMES (code literals, never values)
   428	    # of snapshot fields refused by their shape gate. A dropped field is
   429	    # reported as a count, so an operator can tell "the snapshot said nothing"
   430	    # apart from "the snapshot said something this hook would not repeat".
   431	    dropped: List[str] = []
   432	    pointers: List[str] = [
   433	        "Context was just compacted. Re-anchor on governance before continuing: "
   434	        "re-read CLAUDE.md §0 Gate-1 (CLAUDE.md, PROTOCOL.md, team.md) and the "
   435	        "active plan — the pre-compaction reads may have been summarized away."
   436	    ]
   437	    if _plan_id_ok(plan_id):
   438	        pointers.append("Active plan: %s (re-open its plan file under .claude/plans/)." % plan_id)
   439	    elif plan_id != "unknown":
   440	        # `unknown` is the honest "no plan resolved" answer and renders no
   441	        # pointer by design — it is not a drop. Anything ELSE reaching here
   442	        # was shaped like a plan id enough to pass the old `startswith` and is
   443	        # not one: it came from an audit line nobody verified, so it is
   444	        # omitted and counted rather than repeated to the model.
   445	        _breadcrumb("plan_id off-shape — Active plan pointer dropped")
   446	        dropped.append("plan_id")
