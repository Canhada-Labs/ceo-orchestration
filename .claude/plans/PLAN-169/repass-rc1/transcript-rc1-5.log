   501	                lpath = ""
   502	            else:
   503	                lpath = _lp_raw
   504	            _lc_raw = str(lidx.get("last_commit", ""))
   505	            lcommit = _lc_raw if re.fullmatch(r"[0-9a-f]{4,16}", _lc_raw) else ""
   506	            if lpath and lcommit:
   507	                pointers.append(
   508	                    "Work ledger: %s (last touched at commit %s) — "
   509	                    "re-open it to resume from the last recorded unit."
   510	                    % (lpath, lcommit)
   511	                )
   512	            elif lpath:
   513	                pointers.append(
   514	                    "Work ledger: %s — re-open it to resume from the "
   515	                    "last recorded unit." % lpath
   516	                )
