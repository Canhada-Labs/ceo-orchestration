   612	def _render_constraints() -> List[str]:
   613	    """Return the pinned-constraint lines (PLAN-179 W1-b), or [] when disarmed.
   614	
   615	    The set is a CODE constant in ``_lib/pinned_constraints`` (amendment
   616	    r1-C5) — it is NOT snapshot-derived and therefore NOT sanitized here:
   617	    ``_sanitize_line`` exists to defang disk-sourced text, and applying it to
   618	    a code constant would only disguise where the trust boundary actually is.
   619	
   620	    Dedicated kill-switch ``CEO_CONSTRAINT_PINNING=0`` (PLAN-179 §8.8); import
   621	    or render failure degrades to [] with a breadcrumb (fail-OPEN on infra)."""
   622	    if os.environ.get("CEO_CONSTRAINT_PINNING", "1") == "0":
   623	        return []
   624	    try:
   625	        from _lib import pinned_constraints  # noqa: E402
   626	    except Exception as exc:  # pragma: no cover — import guard
   627	        _breadcrumb("pinned_constraints import failed (%s)" % str(exc)[:80])
   628	        return []
   629	    try:
   630	        return pinned_constraints.render_pinned_block()
   631	    except Exception as exc:  # pragma: no cover — belt-and-suspenders
   632	        _breadcrumb("render_pinned_block failed (%s)" % str(exc)[:80])
   633	        return []
