   694	def _num(val: Any) -> Optional[float]:
   695	    """Numeric coercion for harness-supplied accounting fields, or None.
   696	
   697	    ``bool`` is rejected explicitly: it is an ``int`` subclass and ``True``
   698	    would otherwise sail through as the number 1."""
   699	    if isinstance(val, bool):
   700	        return None
   701	    if isinstance(val, (int, float)):
   702	        return float(val)
   703	    return None
