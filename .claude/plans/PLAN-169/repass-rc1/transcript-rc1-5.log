   322	def _read_session_snapshot(session_id: Optional[str]) -> Optional[Dict[str, Any]]:
   323	    """Read the PreCompact snapshot from the SESSION-scoped scratchpad.
   324	
   325	    PLAN-179 W1 US3: this is the path that cures the measured empty reinject.
   326	    ``resolve_plan_id`` requires a ``plan_transition`` event FROM THIS SESSION,
   327	    and the S309 census found 2 such events in 12,515 audit lines — so in the
   328	    long sessions that actually compact, the plan scope is normally absent and
   329	    the old code returned None here, yielding ``pointer_count=1``.
   330	
   331	    Returns None (never raises) when there is no hook-input session id, when
   332	    the session-scope opener is unavailable, or on any read/parse failure."""
   333	    if not session_id:
   334	        return None
   335	    try:
   336	        from _lib import scratchpad_lib  # noqa: E402
   337	    except Exception as exc:
   338	        _breadcrumb("scratchpad_lib import failed at session read (%s)" % str(exc)[:60])
   339	        return None
   340	    # PLAN-179 W0/W1 cross-file pass: `open_session_scratchpad` HAS landed in
   341	    # _lib/scratchpad_lib.py (amendment r1-C1: own store_name + scope_kind in
   342	    # the blob, so the store's plan-isolation invariant stays intact), so it is
   343	    # called DIRECTLY. The previous `getattr(...) is None` probe was written
   344	    # while that sibling AC was still in flight; leaving it would have kept a
   345	    # permanent degradation branch for a condition that can no longer occur in
   346	    # this build.
   347	    #
   348	    # The one genuine remaining case is an ADOPTER whose vendored
   349	    # scratchpad_lib predates PLAN-179. That surfaces as AttributeError and is
   350	    # caught explicitly below, so the diagnosis stays as specific as the probe
   351	    # made it instead of being swallowed by the broad handler. A malformed
   352	    # session id raises StateStoreInvalidName from `session_scope_id` and takes
   353	    # the broad branch — a refusal, correctly, not a crash.
   354	    try:
   355	        with scratchpad_lib.open_session_scratchpad(session_id) as store:
   356	            raw = store.get(SCRATCHPAD_KEY)
   357	    except AttributeError as exc:
   358	        _breadcrumb(
   359	            "session-scope fallback UNAVAILABLE: "
   360	            "scratchpad_lib.open_session_scratchpad missing (%s) — this build "
   361	            "predates PLAN-179 W1 US3; reinject stays plan-scope only"
   362	            % str(exc)[:60]
   363	        )
   364	        return None
   365	    except Exception as exc:
   366	        _breadcrumb("session scratchpad read failed (%s)" % str(exc)[:80])
   367	        return None
   368	    return _parse_snapshot(raw)
