  1222	@contextlib.contextmanager
  1223	def _plan_index_directory(cwd: str) -> Iterator[int]:
  1224	    """Hold the repository/.claude/plans descriptor chain for the scan."""
  1225	    descriptors: List[int] = []
  1226	    try:
  1227	        descriptors.append(_open_index_directory(os.path.abspath(cwd)))
  1228	        for component in (".claude", "plans"):
  1229	            descriptors.append(_open_index_directory(component, descriptors[-1]))
  1230	        yield descriptors[-1]
  1231	    finally:
  1232	        for fd in reversed(descriptors):
  1233	            os.close(fd)
