   548	def gc_orphan_session_stores(
   549	    *,
   550	    ttl_seconds: int = SESSION_SCOPE_TTL_SECONDS,
   551	    max_files: int = MAX_GC_FILES_PER_RUN,
   552	    now: Optional[float] = None,
   553	) -> int:
   554	    """Unlink aged-out session store FILES. Bounded, fail-open (r1-C2).
   555	
   556	    ``prune_expired`` deletes expired ROWS; it cannot delete the file
   557	    that holds them, so a TTL alone still leaves one empty
   558	    ``session-<uuid>.sqlite`` per session forever. This collects the
   559	    files themselves.
   560	
   561	    A STORE (db + WAL + SHM, one scope) is collectable when the newest
   562	    mtime among its DATA components is older than ``ttl_seconds``: since
   563	    every session write carries the same TTL, an untouched store past
   564	    that age holds nothing but expired rows. The decision and the unlinks
   565	    happen under the store's own ``FileLock`` — a busy lock means an
   566	    active writer and skips the store (rail round-7 [P1]). The
   567	    ``.sqlite.lock`` itself is NEVER unlinked (rail round-9 [P2]:
   568	    deleting a lock inode under a blocked waiter creates dual critical
   569	    sections); empty lock files are the declared residual until the
   570	    substrate cure (state_store opening sqlite UNDER the lock) lands.
   571	
   572	    Safety: only the session store directory is scanned, and only names
   573	    whose stem matches :data:`_SESSION_SCOPE_ID_RE` with a known suffix
   574	    are unlinked — an unrelated file dropped in that directory is left
   575	    alone rather than deleted by a loose glob.
   576	
   577	    Fail mode: fail-OPEN. This is housekeeping, not correctness (ADR-005
   578	    shape). Any :class:`OSError` — missing dir, unreadable entry, racing
   579	    unlink, read-only filesystem — ends or skips the sweep and returns
   580	    the count achieved so far; it never propagates into the hook.
   581	
   582	    Args:
   583	        ttl_seconds: age threshold in seconds (default 72h).
   584	        max_files: hard ceiling on unlinks this run.
   585	        now: epoch seconds override for tests; defaults to wall clock.
   586	
   587	    Returns:
   588	        Number of files unlinked (0 when the directory does not exist).
   589	    """
   590	    removed = 0
   591	    try:
   592	        store_dir = _state_store._state_root() / SESSION_SCRATCHPAD_STORE_NAME
   593	        if not store_dir.is_dir():
   594	            return 0
   595	        cutoff = (time.time() if now is None else float(now)) - float(ttl_seconds)
   596	        # PLAN-179 rail rounds 2/3/4 [P2] — three attempts, and only this one
   597	        # is right. The history is the point:
   598	        #   r2: `sorted(iterdir())` materialised and SORTED the whole directory
   599	        #       before the cap could break — the "bounded" cleanup was the part
   600	        #       that could blow the hook's budget.
   601	        #   r3: a fixed prefix window fixed the cost but STARVED the tail: an
   602	        #       expired store behind a fresh prefix was never reached. (The
   603	        #       comment I wrote then also claimed a cursor that did not exist.)
   604	        #   r4: the rotating offset was still `% _scan_cap`, so nothing beyond
   605	        #       ~2x _scan_cap was reachable — starvation with extra steps.
   606	        #
   607	        # What is actually true: the expensive parts were the SORT and the
   608	        # materialised list, not the walk. `os.scandir()` is lazy and its
   609	        # DirEntry carries the stat the readdir already paid for, so a full
   610	        # pass is cheap. So: walk EVERYTHING (no starvation, no cursor to get
   611	        # wrong), skip the sort entirely (order does not matter for a TTL
   612	        # sweep), stop at `max_files` deletions, and bound the whole thing with
   613	        # a wall-clock DEADLINE so a pathological directory can never eat the
   614	        # hook budget. Cost is bounded by TIME, correctness by coverage.
   615	        _deadline = time.time() + _GC_WALL_BUDGET_S
   616	        _scanned = 0
   617	        # Passo 1 — agrupar por ESCOPO. Rail round-7 [P1]: os componentes de
   618	        # um store expiravam um a um; a expiracao agora e decidida por store,
   619	        # sob o lock DELE. Ler nomes com scandir e barato (o stat vem do
   620	        # readdir); o teto duro limita o pior caso patologico.
   621	        _scopes: Dict[str, Dict[str, float]] = {}
   622	        _it = os.scandir(str(store_dir))
   623	        try:
   624	            for _de in _it:
   625	                _scanned += 1
   626	                if _scanned > _GC_SCAN_HARD_CAP:
   627	                    break
   628	                name = _de.name
   629	                stem = None
   630	                for suffix in _SESSION_STORE_SUFFIXES:
   631	                    if name.endswith(suffix):
   632	                        stem = name[: -len(suffix)]
   633	                        break
   634	                if stem is None or not _SESSION_SCOPE_ID_RE.match(stem):
   635	                    continue
   636	                try:
   637	                    _scopes.setdefault(stem, {})[name] = _de.stat().st_mtime
   638	                except OSError:
   639	                    continue
   640	        finally:
   641	            try:
   642	                _it.close()
   643	            except Exception:
   644	                pass
   645	        # Rotacao por cursor (round-10 [P2]): comeca no primeiro escopo
   646	        # DEPOIS do ultimo decidido na varredura anterior e da a volta —
   647	        # um break por deadline nunca starva a mesma cauda duas vezes.
   648	        _cursor = _gc_read_cursor(store_dir)
   649	        _sorted = sorted(_scopes)
   650	        _order = (
   651	            [s for s in _sorted if s > _cursor]
   652	            + [s for s in _sorted if s <= _cursor]
   653	        )
   654	        _last_decided = None
   655	        # Passo 2 — por escopo, decidir e coletar SOB o lock do store.
   656	        #
   657	        # Rail round-9 [P2]: o `.sqlite.lock` NUNCA e removido. Deletar um
   658	        # lock file enquanto um waiter bloqueia no flock dele deixa o waiter
   659	        # adquirir um inode MORTO enquanto outro processo cria e tranca um
   660	        # arquivo novo — duas secoes criticas simultaneas, e o GC podia
   661	        # remover um db que o waiter ja tinha aberto (state_store abre o
   662	        # sqlite ANTES de adquirir o flock). Residual DECLARADO: um lock
   663	        # file vazio por sessao expirada fica para tras (bytes ~0, contagem
   664	        # sem teto); a cura definitiva e de substrato — state_store passar a
   665	        # abrir o sqlite SOB o lock — nomeada para o pack W2/W4
   666	        # (staged-w24), quando o GC podera coletar locks com seguranca.
   667	        for stem in _order:
   668	            if removed >= int(max_files) or time.time() >= _deadline:
   669	                break
   670	            _seen = _scopes[stem]
   671	            _last_decided = stem
   672	            _lock_name = stem + _SESSION_STORE_LOCK_SUFFIX
   673	            _pre_data = [m for n, m in _seen.items() if n != _lock_name]
   674	            if not _pre_data:
   675	                continue  # escopo so com `.lock` — nada colecionavel
   676	            if max(_pre_data) >= cutoff:
   677	                continue  # store com dado fresco — nem disputa o lock
   678	            _lock_path = store_dir / _lock_name
   679	            try:
   680	                with FileLock(str(_lock_path), timeout=_GC_LOCK_TIMEOUT_S):
   681	                    # Re-checa SOB o lock: um writer pode ter tocado o store
   682	                    # entre o scandir e a aquisicao.
   683	                    _present = []
   684	                    _fresh = False
   685	                    for _suffix in _SESSION_STORE_DATA_SUFFIXES:
   686	                        _p = store_dir / (stem + _suffix)
   687	                        try:
   688	                            if _p.stat().st_mtime >= cutoff:
   689	                                _fresh = True
   690	                                break
   691	                        except OSError:
   692	                            continue
   693	                        _present.append(_p)
   694	                    if _fresh:
   695	                        continue
   696	                    for _p in _present:
   697	                        if removed >= int(max_files):
   698	                            break
   699	                        try:
   700	                            _p.unlink()
   701	                            removed += 1
   702	                        except OSError:
   703	                            # Per-entry fail-open: um problema em UM arquivo
   704	                            # nao aborta a varredura.
   705	                            continue
   706	            except FileLockTimeout:
   707	                continue  # lock ocupado = store ATIVO — nunca disputa
   708	            except OSError:
   709	                continue
   710	        if _last_decided is not None:
   711	            _gc_write_cursor(store_dir, _last_decided)
   712	    except OSError:
   713	        # Sweep-level fail-open (unreadable dir, vanished state root).
   714	        return removed
   715	    return removed
