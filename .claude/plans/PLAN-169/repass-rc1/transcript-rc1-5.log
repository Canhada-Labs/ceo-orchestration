   352	def _last_tag_time(cwd: str, timeout_s: float = 2.0) -> float:
   353	    # Rail r21 P2-c: o caller sob deadline compartilhado passa o RESTO —
   354	    # o default fixo de 2.0s somado a fatia do indice estourava o
   355	    # TIME_BUDGET_S de 2.5s do gate num repositorio lento.
   356	    out = _git(
   357	        [
   358	            "for-each-ref",
   359	            "--sort=-creatordate",
   360	            "--count=1",
   361	            "--format=%(creatordate:unix)",
   362	            "refs/tags",
   363	        ],
   364	        cwd,
   365	        timeout_s=timeout_s,
   366	    )
   367	    try:
   368	        return float(out)
   369	    except ValueError:
   370	        return 0.0
