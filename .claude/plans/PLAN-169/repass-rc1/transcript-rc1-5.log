   115	def _state_root() -> Path:
   116	    """Return the base dir for all plan-scoped state stores.
   117	
   118	    Env-overridable via ``CEO_STATE_ROOT`` (whole state root) and
   119	    ``CEO_PROJECT_NAME`` (legacy name-based slug, kept as an EXPLICIT
   120	    operator escape hatch — it re-creates the basename-collision
   121	    hazard, so it never participates in the default). Default follows
   122	    ADR-001 (S318 amendment) via the single family resolver: the
   123	    per-project native slug dir + ``/state`` — matching audit-log
   124	    siblings (PLAN-182 W1).
   125	    """
   126	    env = os.environ.get("CEO_STATE_ROOT")
   127	    if env:
   128	        return Path(env)
   129	    project = os.environ.get("CEO_PROJECT_NAME")
   130	    if project:
   131	        home = os.environ.get("HOME") or str(Path.home())
   132	        return Path(home) / ".claude" / "projects" / project / "state"
   133	    return _runtime_paths.runtime_state_dir() / "state"
