   732	def observe_commits_since(
   733	    repo_root: Path, deadline: float
   734	) -> Tuple[int, str]:
   735	    """Return ``(commits_since_last_observation, state_kind)`` and re-anchor.
   736	
   737	    ``fresh`` means "no prior anchor", so the 0 is structural — a report
   738	    MUST NOT read it as "no unobserved commits". ``unavailable`` means git
   739	    or the state file failed; the count is 0 and equally uninformative.
   740	    """
   741	    head = _git(repo_root, ["rev-parse", "HEAD"], deadline)
   742	    head_sha = (head or "").strip()
   743	    if not _SHA40_RE.match(head_sha):
   744	        return 0, "unavailable"
   745	
   746	    previous = None  # type: Optional[str]
   747	    path = _state_path(repo_root)
   748	    try:
   749	        if path.is_file():
   750	            blob = json.loads(path.read_text(encoding="utf-8") or "{}")
   751	            if isinstance(blob, dict):
   752	                cand = str(blob.get("last_observed_head") or "")
   753	                if _SHA40_RE.match(cand):
   754	                    previous = cand
   755	    except Exception as exc:
   756	        _breadcrumb("observation state unreadable: %s" % str(exc)[:80])
   757	
   758	    count = 0
   759	    kind = "fresh"
   760	    if previous is not None:
   761	        if previous == head_sha:
   762	            count, kind = 0, "resumed"
   763	        else:
   764	            out = _git(
   765	                repo_root,
   766	                ["rev-list", "--count", "%s..%s" % (previous, head_sha)],
   767	                deadline,
   768	            )
   769	            if out is None:
   770	                kind = "unavailable"
   771	            else:
   772	                count, kind = _clamp_count((out or "").strip()), "resumed"
   773	
   774	    try:
   775	        path.parent.mkdir(parents=True, exist_ok=True)
   776	        path.write_text(
   777	            json.dumps(
   778	                {"last_observed_head": head_sha, "schema": "ledger-checkpoint/v1"},
   779	                sort_keys=True,
   780	            ),
   781	            encoding="utf-8",
   782	        )
   783	    except Exception as exc:
   784	        _breadcrumb("observation state unwritable: %s" % str(exc)[:80])
   785	    return count, kind
