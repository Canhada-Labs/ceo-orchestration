   758	def _context_pct_from_sidecar(
   759	    session_id: Optional[str] = None, cwd: Optional[str] = None
   760	) -> Optional[int]:
   761	    """Context-usage percent read from the statusline sidecar, or None.
   762	
   763	    PLAN-179 rail round-5 [P2] — IDENTITY IS CHECKED BEFORE THE VALUE IS USED.
   764	    This repo's own W0 measurement recorded the finding
   765	    (`PLAN-179/w0-measurement.md`): the sidecar is SHARED and gets rewritten
   766	    with another repository's `project_dir` while a session runs. Reading
   767	    `context_pct` blind would therefore let one session's pressure be reported
   768	    as another's AND re-arm the wrong hysteresis marker, suppressing the next
   769	    genuine transition — a wrong measurement that looks like a right one,
   770	    which is worse than none. So the sidecar's `session_id` and `project_dir`
   771	    must match this invocation, and a mismatch (or a missing identity field)
   772	    returns None: the guard degrades to silence rather than to fiction.
   773	
   774	    PLAN-179 rail round-4 [P2] — THE fix for a dead instrument. The documented
   775	    PreCompact input carries ONLY ``trigger`` and ``custom_instructions``
   776	    (`.claude/data/hook-schema-2.1.220.json`), so reading token accounting from
   777	    the event can never succeed in production: with the floor armed, every real
   778	    PreCompact took the "no measurement" skip path and the sole producer of
   779	    ``context_pressure_observed`` could not emit. The integration test passed
   780	    only because it injected a statusline-shaped payload the hook never
   781	    receives — a test feeding its subject something production does not send.
   782	
   783	    There IS a real source: ``statusline-ceo.py`` writes
   784	    ``<audit-dir>/state/statusline-snapshot.json`` with a ``context_pct``
   785	    field, refreshed as the session runs. This reads THAT, read-only and
   786	    fail-soft: unreadable, absent, malformed or non-numeric all yield None and
   787	    the guard stays a no-op. Nothing is estimated from the transcript.
   788	
   789	    Freshness is deliberately NOT checked here: a stale percent is still a
   790	    measurement someone took, and the alternative (inventing one) is the thing
   791	    W0 exists to prevent. The row it produces is a bucket transition, not a
   792	    precise reading."""
   793	    # PLAN-179 rail round-6 [P2]: resolve the sidecar the SAME way the writer
   794	    # does, override included. `statusline-ceo.py` honours a full-path override
   795	    # in CEO_STATUSLINE_SIDECAR and only falls back to
   796	    # `<audit-dir>/state/statusline-snapshot.json`. Reading just the fallback
   797	    # meant that any adopter using the override got silence instead of
   798	    # telemetry — a reader and a writer disagreeing about where the file is.
   799	    _override = os.environ.get("CEO_STATUSLINE_SIDECAR", "").strip()
   800	    snap = None
   801	    if _override:
   802	        # Rail round-7 [P2]: resolve AND validate exactly like the writer
   803	        # (`statusline-ceo.py:_sidecar_path`): expanduser first, then the
   804	        # symlink/traversal rejection. A rejected override falls through to
   805	        # the default — that is where the writer actually wrote.
   806	        _target = Path(os.path.expanduser(_override))
   807	        if _sidecar_override_safe(_override, _target):
   808	            snap = _target
   809	    if snap is None:
   810	        try:
   811	            # Reuse the ONE resolver the audit rail already uses, so the
   812	            # fallback path is looked up where the writer put it — including
   813	            # under test isolation, which redirects it.
   814	            from _lib import audit_emit as _ae  # noqa: E402
   815	            base = _ae._audit_dir()
   816	        except Exception:
   817	            return None
   818	        snap = Path(base) / "state" / "statusline-snapshot.json"
   819	    try:
   820	        if not snap.is_file():
   821	            return None
   822	        with snap.open("r", encoding="utf-8") as fh:
   823	            data = json.load(fh)
   824	        if not isinstance(data, dict):
   825	            return None
   826	        # --- identity gate (round-5 [P2]) -------------------------------
   827	        # Both sides must be present AND equal. An absent identity field is a
   828	        # MISMATCH, not a pass: a sidecar that cannot say whose it is cannot
   829	        # be attributed, and attributing it anyway is the defect.
   830	        snap_sid = data.get("session_id")
   831	        if session_id:
   832	            if not isinstance(snap_sid, str) or snap_sid != session_id:
   833	                return None
   834	        elif snap_sid:
   835	            # No trusted id on this side: refuse rather than accept a value
   836	            # that demonstrably belongs to SOME session we cannot match.
   837	            return None
   838	        snap_proj = data.get("project_dir")
   839	        if cwd:
   840	            try:
   841	                # Rail round-8 [P2]: o escritor grava workspace.project_dir
   842	                # (o ROOT do projeto); o cwd do hook pode ser um SUBDIRETÓRIO
   843	                # dele (CwdChanged). Igualdade estrita rejeitava sidecar
   844	                # válido e o evento de pressão ficava mudo em produção.
   845	                # Aceita se cwd É o root ou vive DENTRO dele — outro repo
   846	                # continua sendo mismatch.
   847	                _cwd_r = Path(cwd).resolve()
   848	                _proj_r = (
   849	                    Path(snap_proj).resolve()
   850	                    if isinstance(snap_proj, str) and snap_proj else None
   851	                )
   852	                same = _proj_r is not None and (
   853	                    _cwd_r == _proj_r or _proj_r in _cwd_r.parents
   854	                )
   855	            except Exception:
   856	                same = False
   857	            if not same:
   858	                return None
   859	        elif snap_proj:
   860	            return None
   861	        # ----------------------------------------------------------------
   862	        pct = data.get("context_pct")
   863	        if isinstance(pct, bool) or not isinstance(pct, (int, float)):
   864	            return None
   865	        return max(0, min(100, int(pct)))
   866	    except Exception:
   867	        return None
   868	
