   697	def _committed_paths(
   698	    repo_root: Path, inv: CommitInvocation, deadline: float
   699	) -> Optional[List[str]]:
   700	    """Repo-relative paths this commit would carry, or None if unknowable.
   701	
   702	    - default: the staged set (``git diff --cached --name-only``);
   703	    - ``-a/--all``: staged ∪ tracked-modified (``git diff --name-only HEAD``);
   704	    - explicit pathspecs: NOT resolved (globs, directories, exclusions) —
   705	      returns None so the caller reports ``unparseable`` rather than
   706	      inventing a set.
   707	    """
   708	    if inv.pathspecs:
   709	        return None
   710	    out = _git(repo_root, ["diff", "--cached", "--name-only", "-z"], deadline)
   711	    if out is None:
   712	        return None
   713	    paths = [p for p in out.split("\0") if p]
   714	    if inv.all_flag:
   715	        extra = _git(repo_root, ["diff", "--name-only", "-z", "HEAD"], deadline)
   716	        if extra is None:
   717	            return None
   718	        for p in extra.split("\0"):
   719	            if p and p not in paths:
   720	                paths.append(p)
   721	    return paths[:_MAX_PATHS]
