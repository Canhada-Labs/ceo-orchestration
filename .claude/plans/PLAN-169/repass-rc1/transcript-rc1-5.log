  1176	def main() -> int:
  1177	    """Hook entry point. Emits schema-compliant lifecycle JSON output.
  1178	
  1179	    Output shape: `{"continue": true, "systemMessage": "..."}` — no
  1180	    `decision` field (lifecycle schema does NOT accept "allow").
  1181	    """
  1182	    try:
  1183	        from _lib.adapters import claude as _claude_adapter  # noqa: E402
  1184	    except Exception:
  1185	        sys.stdout.write(_emit_observe() + "\n")
  1186	        return 0
  1187	
  1188	    try:
  1189	        event = _claude_adapter.read_event(phase="SessionEnd")
  1190	    except Exception:
  1191	        sys.stdout.write(_emit_observe() + "\n")
  1192	        return 0
  1193	
  1194	    # Rail r12 P2-b (wave-179close) kept the LEGACY lifecycle (session_end,
  1195	    # dashboard/audit-tokens closeout, cleanup) env-first to mirror the
  1196	    # SessionStart producer of the day. PLAN-179-FOLLOWUP (S338) flips the
  1197	    # FOUR lifecycle producers (SessionStart / UserPromptSubmit / Stop /
  1198	    # SessionEnd) together to PAYLOAD-first — payload > env > timestamp —
  1199	    # so start<->end correlation is preserved AND the ids are the ones the
  1200	    # US8 consumer reads: `_session_start_ts` matches `session_start` and
  1201	    # segments on `session_end` by the PAYLOAD id only (env is
  1202	    # agent-spoofable and never anchors — rails r3/r4, consumer lock kept).
  1203	    # An env-first `session_end` was invisible to that segmentation whenever
  1204	    # env != payload (S337 P2 sweep); a PARTIAL flip would split one
  1205	    # lifecycle across two ids (pair-rail r1 of this wave). `payload_sid`
  1206	    # still travels separately, with NO fallback: it is the only id the
  1207	    # memory-delta rail accepts.
  1208	    payload_sid = getattr(event, "session_id", "") or ""
  1209	    session_id = (
  1210	        payload_sid
  1211	        or os.environ.get("CLAUDE_SESSION_ID", "")
  1212	    ) or datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%S")
  1213	    reason = os.environ.get("CLAUDE_SESSION_END_REASON", "normal")
  1214	    repo_root = Path(os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd())
  1215	
  1216	    try:
  1217	        out = decide(
  1218	            repo_root=repo_root,
  1219	            session_id=session_id,
  1220	            reason=reason,
  1221	            payload_session_id=payload_sid,
  1222	        )
  1223	    except Exception as e:
  1224	        sys.stderr.write(f"[SessionEnd] FATAL: {type(e).__name__}: {e}\n")
  1225	        sys.stdout.write(_emit_observe() + "\n")
  1226	        return 0
  1227	
