   637	def classify_message(message: str) -> Optional[str]:
   638	    """Operator-declared skip class for a commit message, or None.
   639	
   640	    Returns one of ``operator_opt_out`` / ``hotfix`` / ``exploratory``. The
   641	    message text NEVER leaves this function: only the enum does.
   642	    """
   643	    msg = (message or "").strip().lower()
   644	    if not msg:
   645	        return None
   646	    for tag in _OPT_OUT_TAGS:
   647	        if tag in msg:
   648	            return "operator_opt_out"
   649	    for tag in _HOTFIX_TAGS:
   650	        if tag in msg:
   651	            return "hotfix"
   652	    for tag in _EXPLORATORY_TAGS:
   653	        if tag in msg:
   654	            return "exploratory"
   655	    head = msg[:_MSG_TYPE_REGION]
   656	    # Palavra NUA casa por FRONTEIRA, nunca por substring: `wip` dentro de
   657	    # `swipe` fazia `feat: swipe gesture` virar uma isencao `exploratory`
   658	    # FALSA, e isencao falsa corrompe exatamente a metrica da janela que este
   659	    # rail existe para medir (pair-rail rodada 6, P2). Os TAGS acima seguem
   660	    # por substring de proposito: sao delimitados (`[skip-ledger]`).
   661	    for word in _HOTFIX_WORDS:
   662	        if re.search(r"\b%s\b" % re.escape(word), head):
   663	            return "hotfix"
   664	    for word in _EXPLORATORY_WORDS:
   665	        if re.search(r"\b%s\b" % re.escape(word), head):
   666	            return "exploratory"
   667	    return None
