   251	def _resolve_project_root(cwd: str) -> str:
   252	    """O MESMO walk-up decisivo de
   253	    ``check_precompact_continuity.py:_resolve_project_root`` (rounds 9/10):
   254	    ancestral mais próximo com ``.claude/``. O fallback por git-toplevel do
   255	    PreCompact é DELIBERADAMENTE ausente aqui — este hook processa snapshot
   256	    ENVENENADO e seu contrato proíbe primitivas de execução e processos
   257	    externos, vigiado por ``test_postcompact_reinject_no_exec_payload``. Sem
   258	    perda: se os hooks estão registrados, ``.claude/`` existe no root e o
   259	    walk-up decide; o fallback do PreCompact só age onde marker nenhum
   260	    existe para re-armar."""
   261	    probe = os.path.realpath(cwd)
   262	    while True:
   263	        if os.path.isdir(os.path.join(probe, ".claude")):
   264	            return probe
   265	        parent = os.path.dirname(probe)
   266	        if parent == probe:
   267	            return os.path.realpath(cwd)
   268	        probe = parent
