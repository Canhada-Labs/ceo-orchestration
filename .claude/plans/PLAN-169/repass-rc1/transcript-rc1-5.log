   319	def session_id_from_event(event: Optional[Mapping[str, Any]]) -> Optional[str]:
   320	    """Return the session id carried by a hook INPUT dict, or None.
   321	
   322	    PLAN-179 amendment r1-C1 — the refusal. This reads the hook event and
   323	    NOTHING else. In particular it never consults
   324	    ``os.environ['CLAUDE_SESSION_ID']``, and it is deliberately NOT
   325	    routed through :func:`_resolve_session_id` (which does read the env
   326	    as a convenience for the plan path).
   327	
   328	    Why: an env var is agent-spoofable. Any agent that can run a subshell
   329	    can ``export CLAUDE_SESSION_ID=<other-session>`` before a hook fires
   330	    and steer the continuity write into a scope it chose — the same
   331	    threat consensus M2 cited when it banned ``CEO_CURRENT_PLAN``. The
   332	    hook input dict is supplied by the harness on stdin and is not
   333	    writable from inside the agent's shell, so it is the only acceptable
   334	    source here.
   335	
   336	    The contract for callers is therefore: **None means REFUSE the
   337	    fallback**, not "go look somewhere else". A caller that reacts to
   338	    None by reading the env has reintroduced the spoof.
   339	
   340	    Args:
   341	        event: parsed hook input. Accepts both the snake_case
   342	            (``session_id``) and camelCase (``sessionId``) spellings the
   343	            harness has used, matching the continuity hooks.
   344	
   345	    Returns:
   346	        The stripped session id, or None when absent / blank / not a
   347	        string / not a mapping.
   348	    """
   349	    # isinstance against collections.abc (typing.Mapping is annotation-only
   350	    # in the idiom this repo targets: py>=3.9, stdlib-only).
   351	    if not isinstance(event, _ABCMapping):
   352	        return None
   353	    for field in ("session_id", "sessionId"):
   354	        raw = event.get(field)
   355	        if isinstance(raw, str):
   356	            val = raw.strip()
   357	            if val:
   358	                return val
   359	    return None
