   214	def _session_id(event: Dict[str, Any]) -> Optional[str]:
   215	    """Return the hook-input session id, or None.
   216	
   217	    PLAN-179 W1 US3 [amendment r1-C1]: the session id used for the
   218	    session-scope fallback comes from the HOOK INPUT ONLY. It is deliberately
   219	    NOT read from ``CLAUDE_SESSION_ID`` — consensus M2 treats env vars as
   220	    agent-spoofable, and a fallback scope chosen by a spoofed env var would be
   221	    a cross-session read primitive. No hook-input id ⇒ no fallback.
   222	
   223	    PLAN-179 W0/W1 cross-file pass: the extraction is DELEGATED to
   224	    ``scratchpad_lib.session_id_from_event`` — the same function the PreCompact
   225	    writer uses. This file previously reimplemented it inline, which made the
   226	    reader's acceptance rule a SECOND, independently-maintained door on the
   227	    same provenance decision; that is the exact "second, weaker door" shape
   228	    ``_parse_snapshot`` was factored out to avoid. The one behavioural
   229	    difference the reimplementation had is real and is now gone: ``a or b``
   230	    treats a whitespace-only ``session_id`` as falsy and silently falls through
   231	    to ``sessionId``, whereas the library returns the first field that is a
   232	    non-blank string and refuses otherwise."""
   233	    try:
   234	        from _lib import scratchpad_lib  # noqa: E402
   235	    except Exception as exc:  # pragma: no cover — import guard
   236	        _breadcrumb("scratchpad_lib import failed at session id (%s)" % str(exc)[:60])
   237	        return None
   238	    try:
   239	        sid = scratchpad_lib.session_id_from_event(event)
   240	    except Exception as exc:
   241	        _breadcrumb("session id derivation failed (%s)" % str(exc)[:80])
   242	        return None
   243	    return sid if isinstance(sid, str) and sid.strip() else None
