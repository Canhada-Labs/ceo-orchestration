   792	def _ac_path_index(repo_root: Path, deadline: float) -> Dict[str, str]:
   793	    """Map ``AC path -> PLAN-NNN`` by scanning plan files for the AC grammar.
   794	
   795	    Bounded by ``_AC_SCAN_MAX_FILES`` / ``_AC_SCAN_MAX_BYTES`` / the wall
   796	    deadline. On the first plan whose id repeats a path, the LOWEST plan id
   797	    wins so the mapping is deterministic across runs.
   798	    """
   799	    index = {}  # type: Dict[str, str]
   800	    plans_dir = repo_root / ".claude" / "plans"
   801	    try:
   802	        files = sorted(plans_dir.glob(_PLAN_FILE_GLOB))[:_AC_SCAN_MAX_FILES]
   803	    except Exception:
   804	        return index
   805	    for plan_file in files:
   806	        if time.monotonic() >= deadline:
   807	            _breadcrumb("AC scan stopped at the wall budget")
   808	            break
   809	        match = _PLAN_FILE_ID_RE.match(plan_file.name)
   810	        if match is None:
   811	            continue
   812	        plan_id = match.group(1)
   813	        try:
   814	            with plan_file.open("r", encoding="utf-8", errors="replace") as fh:
   815	                text = fh.read(_AC_SCAN_MAX_BYTES)
   816	        except OSError:
   817	            continue
   818	        for ac_path in _AC_PATH_RE.findall(text):
   819	            candidate = ac_path.strip().strip("`").strip()
   820	            # A leading "./" is a PREFIX, not a character class: `lstrip("./")`
   821	            # would eat the leading dot of `.claude/...` and silently make
   822	            # every AC path in this repo unmatchable.
   823	            while candidate.startswith("./"):
   824	                candidate = candidate[2:]
   825	            if not candidate or candidate.startswith("<"):
   826	                continue
   827	            current = index.get(candidate)
   828	            if current is None or plan_id < current:
   829	                index[candidate] = plan_id
   830	    return index
