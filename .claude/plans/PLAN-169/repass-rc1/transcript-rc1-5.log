   706	def _used_tokens_from_event(event: Dict[str, Any]) -> Optional[int]:
   707	    """Context tokens already used, as reported BY THE HARNESS, or None.
   708	
   709	    PLAN-179 W0 US2b. The documented PreCompact hook input carries no token
   710	    accounting, so this reads OPTIONAL numeric fields and returns None when
   711	    absent — the guard then no-ops. We do NOT estimate the number from the
   712	    transcript: an invented measurement is exactly what W0 exists to prevent
   713	    ([[feedback-measurement-must-list-its-inputs]]).
   714	
   715	    PLAN-179 W0/W1 cross-file pass: also looks inside the nested
   716	    context-window object, using the SAME candidate keys
   717	    ``.claude/scripts/statusline-ceo.py:context_pct()`` already established for
   718	    this harness. Reading only the top level made the floor guard a no-op on
   719	    every shape that repo has actually observed."""
   720	    for key in ("used_tokens", "usedTokens"):
   721	        val = event.get(key)
   722	        if isinstance(val, bool):  # bool is an int subclass — never a token count
   723	            continue
   724	        if isinstance(val, int):
   725	            return val if val >= 0 else None
   726	    for key in _CONTEXT_WINDOW_KEYS:
   727	        window = event.get(key)
   728	        if not isinstance(window, dict):
   729	            continue
   730	        for used_key in _CONTEXT_USED_KEYS:
   731	            used = _num(window.get(used_key))
   732	            if used is not None:
   733	                return int(used) if used >= 0 else None
   734	    return None
