  1136	        _cleanup_tool_lifecycle(session_id)
  1137	        _flush_audit_log_filelock(repo_root)
  1138	        # SEC-P0-04: audit-tokens stub auto-run BEFORE session_end emit
  1139	        # so the emitted event lands in the same session window.
  1140	        _invoke_audit_tokens_stub(
  1141	            repo_root=repo_root,
  1142	            session_id=session_id,
  1143	        )
