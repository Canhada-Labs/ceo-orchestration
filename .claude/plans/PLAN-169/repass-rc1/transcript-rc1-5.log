   557	                        "Audit HMAC-chain anchor at compaction: length=%d "
   558	                        "prefix=%s (integrity reference only)." % (_cl, _pfx)
   559	                    )
   560	                else:
   561	                    pointers.append(
   562	                        "Audit HMAC-chain anchor at compaction: length=%d "
   563	                        "(integrity reference only)." % _cl
   564	                    )
