   737	def _sidecar_override_safe(raw: str, target: Path) -> bool:
   738	    """True iff the CEO_STATUSLINE_SIDECAR override is NOT a symlink target,
   739	    has no symlinked immediate parent, and no '..' traversal segment.
   740	
   741	    Rail round-7 [P2]: byte-mirrors ``statusline-ceo.py:_sidecar_override_safe``
   742	    — reader and WRITER must accept and reject the SAME overrides, or the
   743	    reader can consume a path the writer refused (crafted data with matching
   744	    identity) while real telemetry lands on the default path unread."""
   745	    try:
   746	        if ".." in raw.replace("\\", os.sep).split(os.sep):
   747	            return False
   748	        if os.path.islink(str(target)):
   749	            return False
   750	        parent = target.parent
   751	        if parent.exists() and os.path.islink(str(parent)):
   752	            return False
   753	    except OSError:
   754	        return False
   755	    return True
