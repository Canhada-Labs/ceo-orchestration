  1236	def _read_index_plan(
  1237	    directory_fd: int, name: str,
  1238	    limit: int = _LEDGER_AC_SCAN_MAX_BYTES + 1,
  1239	) -> bytes:
  1240	    """Read a bounded regular leaf; never follow a link or block on a FIFO.
  1241	
  1242	    ``limit`` is the byte cap of the CALLER, because the two call sites
  1243	    promise different ceilings: the AC index reads cap+1 so it can DETECT
  1244	    overflow, while the ledger reader keeps its own smaller 64 KiB cap.
  1245	    """
  1246	    if not all(hasattr(os, flag) for flag in ("O_NOFOLLOW", "O_NONBLOCK")):
  1247	        raise OSError("no-follow nonblocking file reads unavailable")
  1248	    before = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
  1249	    if not stat_mod.S_ISREG(before.st_mode):
  1250	        raise OSError("index plan is not a regular file")
  1251	    # O_NONBLOCK covers a regular-to-FIFO swap between stat and open;
  1252	    # fstat then refuses the changed type/identity before any read.
  1253	    fd: Optional[int] = os.open(
  1254	        name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory_fd,
  1255	    )
  1256	    try:
  1257	        with os.fdopen(fd, "rb") as fh:
  1258	            fd = None  # the file object now owns the descriptor
  1259	            after = os.fstat(fh.fileno())
  1260	            if (not stat_mod.S_ISREG(after.st_mode)
  1261	                    or (after.st_dev, after.st_ino) != (before.st_dev, before.st_ino)):
  1262	                raise OSError("index plan changed type or identity")
  1263	            return fh.read(limit)
  1264	    finally:
  1265	        if fd is not None:
  1266	            os.close(fd)
