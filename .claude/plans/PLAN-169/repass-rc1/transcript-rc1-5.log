   169	def _plan_id_hash(plan_id: str) -> str:
   170	    """Short, stable hash for plan_id — used in audit events without leaking the raw id."""
   171	    return hashlib.sha256(plan_id.encode("utf-8", errors="replace")).hexdigest()[:16]
   172	
   173	
   174	def _key_hash(key: str) -> str:
   175	    """Short, stable hash for key — audit-safe."""
   176	    return hashlib.sha256(key.encode("utf-8", errors="replace")).hexdigest()[:16]
