  1301	                        continue
  1302	                    all_files.append(entry.name)
  1303	                    if len(all_files) > _LEDGER_AC_SCAN_MAX_FILES:
  1304	                        return {}, False
  1305	            all_files.sort()
  1306	            for plan_file in all_files:
  1307	                if time.monotonic() >= deadline:
  1308	                    return {}, False
