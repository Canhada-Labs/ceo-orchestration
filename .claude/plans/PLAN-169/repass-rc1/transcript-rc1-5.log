  1091	def decide(
  1092	    *,
  1093	    repo_root: Path,
  1094	    session_id: str,
  1095	    reason: str,
  1096	    payload_session_id: Optional[str] = None,
  1097	) -> str:
  1098	    """Pure decision function.
  1099	
  1100	    ``payload_session_id`` (rail r4 P2): o id COMO VEIO DO PAYLOAD do
  1101	    harness, sem fallback. O rail de memory-delta (US8) exige proveniencia
  1102	    de payload ("threaded from the harness event, no silent default" —
  1103	    SESSIONEND-NOTE par.4): um id vindo de CLAUDE_SESSION_ID (spoofable) ou
  1104	    fabricado de timestamp ancoraria o scan na chain ERRADA e emitiria
  1105	    atribuicao escolhida/fabricada. None = chamador legado/teste que ja
  1106	    passa o id confiavel em ``session_id`` (compat); STRING VAZIA = o
  1107	    payload NAO trouxe id, o delta e PULADO com breadcrumb LOUD (omissao
  1108	    visivel) e o resto do hook segue com o id legado."""
  1109	    if _kill_switch_active():
  1110	        return _emit_observe(system_message="SessionEnd: kill-switch active, no-op")
  1111	
  1112	    try:
  1113	        memory_state = _memory_dir_state(repo_root)
  1114	        # PLAN-179 W2 US8 — memory-delta observation. MUST run BEFORE
  1115	        # `_cleanup_tool_lifecycle`: the fallback session-start anchor
  1116	        # reads the per-session tool_lifecycle record file that
  1117	        # `cleanup_session()` deletes (SESSIONEND-NOTE.md §5 constraint
  1118	        # #1 — inverting these silently degrades every session to
  1119	        # anchor_source="none", a green-looking rail answering nothing).
  1120	        rail = _memory_delta_rail_state()
  1121	        _delta_sid = (
  1122	            session_id if payload_session_id is None else payload_session_id
  1123	        )
  1124	        delta: Optional[Dict[str, object]] = None
  1125	        if rail != "off" and not _delta_sid:
  1126	            # rail r4 P2 — sem id de payload nao ha ancora atribuivel:
  1127	            # pular e DIZER e o honesto; fabricar um id violaria o par.4.
  1128	            sys.stderr.write(
  1129	                "# SessionEnd US8: payload sem session_id — memory-delta "
  1130	                "PULADO (contrato de proveniencia par.4: no silent "
  1131	                "default)\n"
  1132	            )
  1133	        elif rail != "off":
  1134	            delta = _memory_delta_observed(repo_root, _delta_sid)
