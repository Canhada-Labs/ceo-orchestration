   402	def _hmac_chain_breadcrumb(deadline: Optional[float] = None) -> Dict[str, Any]:
   403	    """READ-ONLY snapshot of the HMAC-chain anchor: last-hmac hex PREFIX +
   404	    chain-length counter.
   405	
   406	    Lock-respecting (audit_hmac readers MUST hold the audit filelock — we take
   407	    a best-effort shared lock; on unavailability we still read, since these are
   408	    advisory sidecars and a one-event race is harmless for a snapshot anchor).
   409	    Returns ``{"chain_length": 0}`` on any failure (fail-open). Only the FIRST
   410	    12 hex chars of the last-hmac are kept — enough to detect a post-compaction
   411	    chain divergence, not enough to be a forgery oracle."""
   412	    out: Dict[str, Any] = {"chain_length": 0, "last_hmac_prefix": ""}
   413	    try:
   414	        from _lib import audit_hmac  # noqa: E402
   415	    except Exception as exc:  # pragma: no cover — import guard
   416	        _breadcrumb("audit_hmac import failed (%s)" % str(exc)[:60])
   417	        return out
   418	    try:
   419	        from _lib.filelock import FileLock, FileLockTimeout  # noqa: E402
   420	        _have_lock = True
   421	    except Exception:  # pragma: no cover
   422	        FileLock = None  # type: ignore[assignment]
   423	        FileLockTimeout = Exception  # type: ignore[assignment, misc]
   424	        _have_lock = False
   425	
   426	    def _read() -> None:
   427	        try:
   428	            out["chain_length"] = int(audit_hmac.read_chain_length())
   429	        except Exception:
   430	            out["chain_length"] = 0
   431	        try:
   432	            prev = audit_hmac.read_prev_hmac()
   433	            out["last_hmac_prefix"] = audit_hmac.hex_digest(prev)[:12]
   434	        except Exception:
   435	            out["last_hmac_prefix"] = ""
   436	
   437	    # Rail r21 P2-c: a espera de lock respeita o deadline compartilhado —
   438	    # sem resto de budget, leitura lockless direta (advisory sidecar; a
   439	    # corrida de um evento e inofensiva, doutrina ja declarada acima).
   440	    _lock_wait = 0.5
   441	    if deadline is not None:
   442	        _lock_wait = min(0.5, deadline - time.monotonic())
   443	    if _have_lock and FileLock is not None and _lock_wait > 0:
   444	        try:
   445	            lock_path = audit_hmac.last_hmac_path().with_name("audit-log.lock")
   446	            with FileLock(lock_path, timeout=_lock_wait):
   447	                _read()
   448	            return out
   449	        except FileLockTimeout:
   450	            _breadcrumb("hmac sidecar lock timeout — lockless best-effort read")
   451	        except Exception as exc:
   452	            _breadcrumb("hmac sidecar lock error (%s) — lockless read" % str(exc)[:60])
   453	    _read()
   454	    return out
   455	
