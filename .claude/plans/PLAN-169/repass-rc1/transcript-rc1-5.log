   833	def derive_scope(
   834	    paths: List[str], repo_root: Path, deadline: float
   835	) -> Tuple[Optional[str], str, List[str]]:
   836	    """``(plan_id, scope_source, in_scope_paths)`` from the commit's PATHS.
   837	
   838	    NOTHING here consults session state, env, or the audit log. When several
   839	    plans match, the one with the most in-scope paths wins; ties break on the
   840	    lowest plan id, so the choice is reproducible.
   841	    """
   842	    by_plan = {}  # type: Dict[str, List[str]]
   843	    sources = {}  # type: Dict[str, set]
   844	    for path in paths:
   845	        m = _PLAN_DIR_RE.match(path)
   846	        if m is not None:
   847	            plan_id = m.group(1)
   848	            by_plan.setdefault(plan_id, []).append(path)
   849	            sources.setdefault(plan_id, set()).add("plan_dir")
   850	
   851	    unmatched = [p for p in paths if not _PLAN_DIR_RE.match(p)]
   852	    if unmatched:
   853	        index = _ac_path_index(repo_root, deadline)
   854	        if index:
   855	            for path in unmatched:
   856	                plan_id = index.get(path)
   857	                if plan_id is None:
   858	                    for ac_path, candidate in index.items():
   859	                        if ac_path.endswith("/") and path.startswith(ac_path):
   860	                            plan_id = candidate
   861	                            break
   862	                        if path.startswith(ac_path + "/"):
   863	                            plan_id = candidate
   864	                            break
   865	                if plan_id is not None:
   866	                    by_plan.setdefault(plan_id, []).append(path)
   867	                    sources.setdefault(plan_id, set()).add("plan_ac")
   868	
   869	    if not by_plan:
   870	        return None, "other", []
   871	    best = sorted(by_plan.items(), key=lambda kv: (-len(kv[1]), kv[0]))[0]
   872	    plan_id = best[0]
   873	    kinds = sources.get(plan_id, set())
   874	    if kinds == {"plan_dir"}:
   875	        source = "plan_dir"
   876	    elif kinds == {"plan_ac"}:
   877	        source = "plan_ac"
   878	    elif kinds:
   879	        source = "both"
   880	    else:  # pragma: no cover - unreachable, kept total
   881	        source = "other"
   882	    return plan_id, source, best[1]
   883	
