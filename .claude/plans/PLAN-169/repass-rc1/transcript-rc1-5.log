   870	def _context_used_pct(event: Dict[str, Any]) -> Optional[int]:
   871	    """Share of the context window already consumed, as an INTEGER percent.
   872	
   873	    PLAN-179 W0/W1 cross-file pass — this is the input the wire actually wants.
   874	    ``audit_emit`` validates ``used_bucket`` as an integer PERCENT rung, so a
   875	    percent (not a token count) has to be derived before the emit; the previous
   876	    token-count bucket could never match a rung and was dropped by the scrub.
   877	
   878	    Candidate shapes mirror ``statusline-ceo.py:context_pct()`` — the direct
   879	    percentage first, then used/size — so the two surfaces read the same
   880	    harness payload rather than each guessing. Returns None when the input
   881	    carries no context-window accounting at all; NOTHING is estimated from the
   882	    transcript. Integer-only by construction: the value ends up in an
   883	    HMAC-covered field and a float there discards the whole event
   884	    ([[feedback-float-in-hmac-field-drops-whole-event]])."""
   885	    for key in _CONTEXT_WINDOW_KEYS:
   886	        window = event.get(key)
   887	        if not isinstance(window, dict):
   888	            continue
   889	        for pct_key in _CONTEXT_PCT_KEYS:
   890	            pct = _num(window.get(pct_key))
   891	            if pct is not None:
   892	                return max(0, min(100, int(pct)))
   893	        used = None  # type: Optional[float]
   894	        for used_key in _CONTEXT_USED_KEYS:
   895	            used = _num(window.get(used_key))
   896	            if used is not None:
   897	                break
   898	        size = None  # type: Optional[float]
   899	        for size_key in _CONTEXT_SIZE_KEYS:
   900	            size = _num(window.get(size_key))
   901	            if size is not None:
   902	                break
