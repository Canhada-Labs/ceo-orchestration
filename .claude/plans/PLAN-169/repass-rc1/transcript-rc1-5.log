   231	
   232	def _cli(argv: List[str]) -> int:
   233	    """Parse ``argv`` (no argparse: keeps the leaf tiny and the usage text
   234	    byte-stable) and print exactly one path. Returns the exit status."""
   235	    mode = "--state-dir"
   236	    mode_seen = False
   237	    project: Optional[str] = None
   238	    i = 0
   239	    while i < len(argv):
   240	        arg = argv[i]
   241	        if arg in _CLI_MODES:
   242	            if mode_seen:
   243	                sys.stderr.write("runtime_paths: one mode flag only\n" + _CLI_USAGE)
   244	                return 2
   245	            mode, mode_seen = arg, True
   246	        elif arg == "--project":
   247	            # A missing value must never swallow the NEXT option as a path
   248	            # (pair-rail r6/r8 P2: `--project --slug` and `--project -h`
   249	            # printed a valid-looking state dir for a project literally
   250	            # named after the option). Any token that starts with "-" is an
   251	            # option, not a PATH; a real path beginning with "-" is not
   252	            # supported — use an absolute path.
   253	            if i + 1 >= len(argv) or not argv[i + 1] or argv[i + 1].startswith("-"):
   254	                sys.stderr.write("runtime_paths: --project needs a PATH\n" + _CLI_USAGE)
   255	                return 2
   256	            project = argv[i + 1]
   257	            i += 1
   258	        elif arg in ("-h", "--help"):
   259	            sys.stdout.write(_CLI_USAGE)
   260	            return 0
   261	        else:
   262	            sys.stderr.write("runtime_paths: unknown argument %r\n%s" % (arg, _CLI_USAGE))
   263	            return 2
   264	        i += 1
   265	    if mode == "--project-dir":
   266	        out = Path(os.path.abspath(project)) if project is not None else project_dir()
   267	    elif mode == "--slug":
   268	        out = project_slug(project)
   269	    else:
   270	        out = runtime_state_dir(project)
   271	    sys.stdout.write("%s\n" % out)
   272	    return 0
   273	
   274	
   275	if __name__ == "__main__":
   276	    sys.exit(_cli(sys.argv[1:]))
