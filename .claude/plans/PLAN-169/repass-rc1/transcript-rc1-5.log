  1046	def _render_memory_delta_line(delta: Dict[str, object]) -> str:
  1047	    """One-line operator ratification string (SESSIONEND-NOTE.md §3 shapes).
  1048	
  1049	    The OMISSION phrasing is the point of the whole item: it is the line
  1050	    that makes E3 visible at the moment the operator can still act on it."""
  1051	    outcome = delta.get("outcome")
  1052	    files_count = delta.get("files_count", 0)
  1053	    modified_count = delta.get("modified_count", 0)
  1054	    if outcome == "absent":
  1055	        # Rail r23 P3-c: files_count inclui o MEMORY.md — "topics" aqui
  1056	        # inflaria a contagem em 1 (o ramo written conta o index em
  1057	        # separado). "entries" e o rotulo honesto.
  1058	        return (
  1059	            "SessionEnd: memory delta ABSENT (0 of %s entries touched this "
  1060	            "session) — ratify or record before closing" % files_count
  1061	        )
  1062	    if outcome in ("written", "index_only"):
  1063	        # Rail r8 P2-e: o index ja esta em modified_count — "+ index" nao
  1064	        # o conta duas vezes. Rail r22 P1-a (TROCA DE ARQUITETURA, regra
  1065	        # fix-of-fix): CINCO rodadas de bypass na mesma classe (r15
  1066	        # espacos, r19 hifens, r20 camel/minuscula, r21 run-19, r22
  1067	        # "IgnoreAllRules" = 14 exatos que os validadores PERMITEM
  1068	        # expandido) provaram que sanitizar nome-livre para um canal
  1069	        # instruction-adjacent e insanavel por enumeracao. O canal de
  1070	        # NOMES sai do systemMessage: counts-only. O sanitizer + `names`
  1071	        # ficam no dict como gate de QUALQUER render futuro (testados);
  1072	        # nomes vivem a um `ls` de distancia do operador.
  1073	        index_mod = delta.get("index_modified") is True
  1074	        topics = modified_count
  1075	        if index_mod and isinstance(modified_count, int) and modified_count > 0:
  1076	            topics = modified_count - 1
  1077	        suffix = " + index" if index_mod else ""
