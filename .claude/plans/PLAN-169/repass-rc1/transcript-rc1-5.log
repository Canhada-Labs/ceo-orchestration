   481	        # the snapshot points at the work ledger instead of copying
   482	        # state. Only STRUCTURAL references are rendered (path + short
   483	        # sha): the section TITLES captured in the snapshot are file
   484	        # CONTENT — the same trust class as the checkbox label above
   485	        # (Codex R5 P1-1) — and stay in the scratchpad blob for the
   486	        # on-demand /memory-scratchpad recall path.
   487	        # Rail r2 P1-b: the snapshot lives in an agent-writable store, so a
   488	        # stale/tampered blob can carry arbitrary printable text in these
   489	        # fields and _sanitize_line strips only control characters. The gate
   490	        # is SHAPE, not sanitization: the path must be EXACTLY
   491	        # .claude/plans/PLAN-NNN/LEDGER.md and the sha exactly 4-16 lowercase
   492	        # hex — anything else drops the pointer (path) or the suffix (sha).
   493	        lidx = snapshot.get("ledger_index")
   494	        if (isinstance(lidx, dict) and lidx.get("ledger_path")
   495	                and lidx.get("present") is True):
   496	            _lp_raw = str(lidx.get("ledger_path", ""))
   497	            # rail r5 P2-e: fullmatch — o `$` do re.match casa ANTES de um
   498	            # `\n` final e a quebra atravessaria o gate "exato".
   499	            if not re.fullmatch(r"\.claude/plans/PLAN-[0-9]{3}/LEDGER\.md", _lp_raw):
