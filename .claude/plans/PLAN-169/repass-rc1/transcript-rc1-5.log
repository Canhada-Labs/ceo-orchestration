  1329	                return {}, False
  1330	    except FileNotFoundError:
  1331	        # ENOENT is ABSENCE, not unsafe input: an adopter with no
  1332	        # `.claude/plans`, or a plan file that vanished mid-scan. The
  1333	        # index is refused either way; staying silent keeps the
  1334	        # breadcrumb below forensic instead of firing on every
  1335	        # PreCompact of such a repo.
  1336	        return {}, False
  1337	    except Exception:
  1338	        _breadcrumb("plan AC index unavailable or unsafe — refusing partial scope")
  1339	        return {}, False
  1340	    return index, True
