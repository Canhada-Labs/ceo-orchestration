  1243	        try:
  1244	            os.chmod(paths["dir"], 0o700)
  1245	        except OSError:
  1246	            pass
  1247	    except OSError as e:
  1248	        write_breadcrumb(paths["err"], f"cannot create audit dir: {e}")
  1249	        return
  1250	
  1251	    # PLAN-085 Wave B.3 — inline HMAC computation closes the two-writer
  1252	    # chain gap (F-C1-001 / T0-line-168 transition_violation root cause).
