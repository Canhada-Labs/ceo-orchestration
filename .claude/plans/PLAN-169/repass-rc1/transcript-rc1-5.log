   599	            # Explicit ttl (emenda r1-C2): session scopes are per-session and
   600	            # would otherwise accumulate forever.
   601	            #
   602	            # PLAN-179 W0/W1 cross-file pass: routed through the library's
   603	            # `set_session_value` rather than `store.set(..., ttl_seconds=...)`.
   604	            # That helper is where r1-C2 made the positive TTL MECHANICAL — it
   605	            # RAISES on a None/non-positive ttl instead of silently writing a
   606	            # never-expiring row, which is precisely the accumulation bug the
   607	            # amendment named. Calling store.set directly bypassed the guard the
   608	            # library exists to provide.
   609	            scratchpad_lib.set_session_value(
   610	                store, SCRATCHPAD_KEY, store_value,
   611	                ttl_seconds=SESSION_SNAPSHOT_TTL_S,
   612	            )
   613	        return "written_session_scope"
   614	    except Exception as exc:
   615	        _breadcrumb("scratchpad write failed (%s)" % str(exc)[:80])
   616	        return "error"
   617	
