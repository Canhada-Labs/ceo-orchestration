   218	def _resolve_project_root(cwd: str) -> str:
   219	    """Project ROOT for every path this hook derives (rail round-9 [P2]).
   220	
   221	    O ``cwd`` do hook-input segue o CwdChanged da sessão para
   222	    subdiretórios; derivar `.claude/...` dele fragmenta o estado — o
   223	    lookup de plano erra, e o marker de pressão ganha uma cópia por
   224	    subdiretório, derrotando o contrato de histerese. A autoridade é o
   225	    toplevel do git (lição feedback-guard-must-resolve-repo-by-git-toplevel);
   226	    o fallback sobe até o ancestral mais próximo com `.claude/`, e falha
   227	    de resolução mantém o cwd (degradado, nunca quebrado)."""
   228	    # Walk-up PRIMEIRO (não git-first): o leitor do marker no PostCompact
   229	    # tem contrato no-exec e só pode usar o walk-up — para escritor e
   230	    # leitor concordarem em TODO caso decisivo, a regra primária dos dois
   231	    # é idêntica. O git-toplevel fica como fallback para o caso sem
   232	    # `.claude/` em ancestral algum (onde não há marker a re-armar).
   233	    probe = os.path.realpath(cwd)
   234	    while True:
   235	        if os.path.isdir(os.path.join(probe, ".claude")):
   236	            return probe
   237	        parent = os.path.dirname(probe)
   238	        if parent == probe:
   239	            break
   240	        probe = parent
   241	    top = _git(["rev-parse", "--show-toplevel"], cwd)
   242	    if top and os.path.isdir(top):
   243	        return os.path.realpath(top)
   244	    return os.path.realpath(cwd)
