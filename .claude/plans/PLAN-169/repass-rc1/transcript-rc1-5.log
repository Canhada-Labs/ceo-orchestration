   371	def _read_snapshot(
   372	    plan_id: str, session_id: Optional[str] = None
   373	) -> Optional[Dict[str, Any]]:
   374	    """Read the PreCompact snapshot blob, plan scope first, session scope after.
   375	
   376	    Returns the parsed dict, or None when neither scope yields a readable
   377	    snapshot (PostCompact then reinjects only the durable reminders).
   378	
   379	    PLAN-179 W1 US3: the scope choice MIRRORS the writer. The PreCompact half
   380	    writes under the session scope exactly when ``resolve_plan_id`` raised, so
   381	    the reader falls back exactly when the plan id is unresolved — no
   382	    speculative second read when a plan scope exists but is empty."""
   383	    # rc.1 re-pass round 2, part 5 — SHAPE, not prefix. `startswith("PLAN-")`
   384	    # let an off-shape id through, and two lines below it becomes the
   385	    # `plan_id=` KEY of `open_scratchpad`. Failing the shape check routes to
   386	    # the session scope, which is the fail-safe direction already taken when
   387	    # no plan resolves at all: it reads a store this hook owns instead of one
   388	    # named by an unverified audit line.
   389	    if not _plan_id_ok(plan_id):
   390	        return _read_session_snapshot(session_id)
   391	    try:
   392	        from _lib import scratchpad_lib  # noqa: E402
   393	    except Exception as exc:
   394	        _breadcrumb("scratchpad_lib import failed at read (%s)" % str(exc)[:60])
   395	        return None
