   397	        with scratchpad_lib.open_scratchpad(plan_id=plan_id) as store:
   398	            raw = store.get(SCRATCHPAD_KEY)
   399	    except Exception as exc:
   400	        _breadcrumb("scratchpad read failed (%s)" % str(exc)[:80])
   401	        return None
   402	    return _parse_snapshot(raw)
