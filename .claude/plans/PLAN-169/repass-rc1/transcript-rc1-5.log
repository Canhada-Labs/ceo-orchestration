   360	def _parse_wire_ts(raw: object) -> Optional[float]:
   361	    """Wire ``ts`` (ISO-8601 UTC ``YYYY-MM-DDTHH:MM:SSZ``) → POSIX seconds.
   362	
   363	    Numeric epoch is accepted for forward-compat; anything unparseable is
   364	    None — never a guess (a wrong window produces a false "you wrote
   365	    memory", worse than absent)."""
   366	    if isinstance(raw, bool):
   367	        return None
   368	    if isinstance(raw, (int, float)):
   369	        # Rail r7 P2-f: json.loads aceita NaN/Infinity por default (com
   370	        # HMAC desligado nada mais barra a linha). NaN faz TODA comparacao
   371	        # `st_mtime >= start` dar False => falso "absent" a partir de uma
   372	        # ancora malformada — exatamente a classe "unparseable laundered
   373	        # into a claim". Nao-finito e imparseavel: None.
   374	        if not math.isfinite(float(raw)):
   375	            return None
   376	        return float(raw)
   377	    if not isinstance(raw, str):
   378	        return None
   379	    try:
   380	        dt = datetime.strptime(raw, "%Y-%m-%dT%H:%M:%SZ")
   381	        return dt.replace(tzinfo=timezone.utc).timestamp()
   382	    except ValueError:
   383	        return None
   384	
   385	
   386	def _session_start_ts(session_id: str, repo_root: Path) -> Tuple[Optional[float], str]:
   387	    """SESSIONEND-NOTE.md §2 resolution order → ``(posix_ts | None, anchor)``.
   388	
   389	    ``anchor`` is the closed enum member naming which step answered
   390	    ("chain" / "state_file" / "none"). It is returned alongside the
   391	    timestamp because the §4 wire contract carries ``anchor_source`` and no
   392	    §3 signature does — the smallest reconciliation (documented in the
   393	    wave-179-close DESIGN notes). The timestamp is used only for the
   394	    in-process comparison; it never reaches the wire.
   395	
   396	    1. PRIMARY — the HMAC chain: bounded reverse scan of the audit log for
   397	       THIS session's ``session_start`` event (≤200 lines, ≤256 KiB,
   398	       ≤100 ms — the chain is the anchor, never a mutable side file;
   399	       ADR-160 §3 / A6 applied here).
   400	    2. TERMINAL — ``(None, "none")``: the hook reports it could not bound
   401	       the window; it does NOT substitute "since midnight" or process
   402	       start. Budget exhaustion also lands here, never a partial answer.
   403	       (A tool_lifecycle state-file leg existed through rail r4 and was
   404	       RETIRED in r5: os.replace rewrites reset even st_birthtime — no
   405	       immutable artifact exists on that surface. The "state_file" enum
   406	       value stays wire-registered, never produced.)"""
   407	    deadline = time.monotonic() + (_MEMORY_DELTA_ANCHOR_BUDGET_MS / 1000.0)
   408	    try:
   409	        # Rail r1 P2-3: the emitter honours CEO_AUDIT_LOG_PATH /
   410	        # CEO_AUDIT_LOG_DIR (PLAN-182 family-atomicity), so the reader must
   411	        # resolve the SAME way or a configured session loses its chain
   412	        # anchor. Authority: audit_emit._log_path(); probed defensively, with
   413	        # the documented precedence mirrored as fallback for a partial
   414	        # upgrade whose audit_emit predates the resolver.
   415	        log_path = None
   416	        try:
   417	            from _lib import audit_emit as _ae_anchor  # type: ignore
   418	            _lp = getattr(_ae_anchor, "_log_path", None)
   419	            if _lp is not None:
   420	                log_path = _lp()
   421	        except Exception:
   422	            log_path = None
   423	        if log_path is None:
   424	            _env_lp = os.environ.get("CEO_AUDIT_LOG_PATH")
   425	            _env_ld = os.environ.get("CEO_AUDIT_LOG_DIR")
   426	            if _env_lp:
   427	                log_path = Path(_env_lp)
   428	            elif _env_ld:
   429	                log_path = Path(_env_ld) / "audit-log.jsonl"
   430	            else:
   431	                log_path = _rp_state_dir() / "audit-log.jsonl"
   432	        if session_id and log_path.is_file():
   433	            with open(log_path, "rb") as fh:
   434	                fh.seek(0, 2)
   435	                size = fh.tell()
   436	                fh.seek(max(0, size - _MEMORY_DELTA_ANCHOR_MAX_BYTES))
   437	                raw = fh.read(_MEMORY_DELTA_ANCHOR_MAX_BYTES)
   438	            window_covers_file = size <= _MEMORY_DELTA_ANCHOR_MAX_BYTES
   439	            # Rail r16 P2-b: split nos BYTES b"\n", nunca str.splitlines()
   440	            # — producao grava ensure_ascii=False e um campo com U+2028/
   441	            # U+2029 literal (validos em string JSON) fragmentaria a
   442	            # PROPRIA linha assinada em pedacos imparseaveis (anchor
   443	            # perdido) e inflaria a contagem da janela de 200 linhas.
   444	            # Rail r17 P2-a: TODO segmento whitespace-only cai fora ANTES
   445	            # do cap de 200 (linha em branco interna / CRLF-only /
   446	            # newlines finais multiplos) — o verify_chain pula registros
   447	            # vazios, e um branco contando no cap ou quebrando o walk do
   448	            # predecessor divergiria do oraculo.
   449	            lines = [
   450	                seg.decode("utf-8", "replace")
   451	                for seg in raw.split(b"\n")
   452	                if seg.strip()
   453	            ]
   454	            # Rail r8 P2-c: o corte por LINHAS tambem descarta prefixo — a
   455	            # flag tem de refletir os DOIS caps (SPEC: genesis so quando a
   456	            # janela cobre o arquivo INTEIRO). Sem isto, um arquivo pequeno
   457	            # em bytes com >200 linhas manteria covers=True com prefixo
   458	            # dropado, e uma linha genesis-assinada na 1a posicao retida
   459	            # verificaria contra GENESIS com o acima-de-si INVERIFICAVEL
   460	            # (fora da janela).
   461	            if len(lines) > _MEMORY_DELTA_ANCHOR_MAX_LINES:
   462	                window_covers_file = False
   463	            lines = lines[-_MEMORY_DELTA_ANCHOR_MAX_LINES:]
   464	            # Rail r2 P1-c: the catch-all SessionStart matcher re-fires on a
   465	            # compact resume and emits a SECOND session_start for the SAME
   466	            # session id — the newest match is the post-compact restart, and
   467	            # anchoring there reports memory written before the compaction
   468	            # as a false "absent". The anchor is therefore the OLDEST match
   469	            # in the bounded window (forward scan, first hit wins). Residual
   470	            # (documented): a session so long that its original start left
   471	            # the 256 KiB window anchors on a later restart — bounded
   472	            # honesty, same class as the window caps themselves.
   473	            #
   474	            # Rail r2 P1-d: verify-before-consume (ADR-160). A candidate is
   475	            # accepted only when its per-entry HMAC verifies against the
   476	            # previous line's hmac with the project key —
   477	            # hmac_sha256(key, prev || canonical_json(entry sans hmac)),
   478	            # the exact compute_entry_hmac formula. An appended/forged line
   479	            # without a valid hmac is SKIPPED; no verifiable candidate =>
   480	            # the terminal "none", never a trusted guess. When the operator
   481	            # disabled the HMAC rail (CEO_AUDIT_HMAC_DISABLE=1) the chain
   482	            # makes no integrity claim and candidates are accepted as-is.
   483	            _ah = None
   484	            _ah_key = None
   485	            _ah_disabled = False
   486	            try:
   487	                from _lib import audit_hmac as _ah  # type: ignore
   488	                _ah_disabled = bool(_ah.is_disabled())
   489	                if not _ah_disabled:
   490	                    _read_key = getattr(_ah, "_read_key_file", None)
   491	                    if _read_key is not None:
   492	                        _ah_key = _read_key(_ah.key_path())
   493	            except Exception:
   494	                _ah = None
   495	                _ah_key = None
   496	
   497	            def _anchor_verified(idx: int, ev_obj: dict, raw_line: str) -> bool:
   498	                # Fronteira declarada (rail r7 P2-a, refutado como ganho
   499	                # REAL): a verificacao e POR-ENTRADA — o candidato contra o
   500	                # digest DECLARADO da linha predecessora; o predecessor em
   501	                # si nao e re-verificado. Verificar o segmento nao
   502	                # compraria nada contra o atacante do threat model: quem
   503	                # escreve neste log roda sob o MESMO UID e le a chave 0600
   504	                # (CLAUDE.md §5 — fronteira real exigiria UID separado,
   505	                # fora de escopo por decisao), logo forjaria a cadeia
   506	                # inteira. Integridade de cadeia COMPLETA e trabalho do
   507	                # verify_chain offline, nunca deste leitor bounded.
   508	                if _ah_disabled:
   509	                    return True
   510	                if _ah is None or _ah_key is None:
   511	                    return False
   512	                ev_hmac = ev_obj.get("hmac")
   513	                if not isinstance(ev_hmac, str) or len(ev_hmac) != 64:
   514	                    return False
   515	                # Rail r5 P2-c: o predecessor REAL. Espelha verify_chain:
   516	                # linhas hmac-null no prefixo (pre-v2.9 / fail-open) sao
   517	                # ATRAVESSADAS — o prev e a ultima linha ASSINADA acima do
   518	                # candidato; esgotado o prefixo, GENESIS vale apenas quando
   519	                # a janela cobre o arquivo INTEIRO (um slice truncado nao
   520	                # sabe o que ficou fora => inverificavel, skip).
   521	                prev = None
   522	                j = idx - 1
   523	                crossed_null = False
   524	                while j >= 0:
   525	                    try:
   526	                        prev_obj = json.loads(lines[j])
   527	                    except ValueError:
   528	                        return False  # linha ilegivel no caminho do prev
   529	                    # Rail r17 P2-b: registro nao-objeto (lista/escalar) e
   530	                    # `line_not_object` no verify_chain — trata-lo como
   531	                    # null-legado o faria atravessavel e um candidato
   532	                    # validaria contra genesis numa cadeia que o oraculo
   533	                    # REJEITA. Fail-closed.
   534	                    if not isinstance(prev_obj, dict):
   535	                        return False
   536	                    prev_hex = prev_obj.get("hmac")
   537	                    if isinstance(prev_hex, str) and len(prev_hex) == 64:
   538	                        # Rail r16 P2-c: null DEPOIS de linha assinada e
   539	                        # LACUNA fail-open (verify_chain acusa a transicao)
   540	                        # — atravessa-la e consumir ancora de cadeia
   541	                        # QUEBRADA. O traversal de nulls so vale para o
   542	                        # PREFIXO legado (nada assinado acima).
   543	                        if crossed_null:
   544	                            return False
   545	                        try:
   546	                            prev = _ah.from_hex(prev_hex)
   547	                        except Exception:
   548	                            return False
   549	                        break
   550	                    if prev_hex is None:
   551	                        crossed_null = True
   552	                        j -= 1  # legado/fail-open: atravessa (verify_chain)
   553	                        continue
   554	                    return False  # hmac presente mas mal-formado
   555	                if prev is None:
   556	                    if window_covers_file:
   557	                        prev = _ah.GENESIS_PREV
   558	                    else:
   559	                        return False
   560	                try:
   561	                    entry = dict(ev_obj)
   562	                    # Rail r4 P1: o produtor assina EXCLUINDO `hmac` E
   563	                    # `hmac_error` (audit_emit._write_event: `entry_sans =
   564	                    # {... if k != "hmac" and k != "hmac_error"}`). Um
   565	                    # verificador que tira so `hmac` reprovaria toda linha
   566	                    # que carregue `hmac_error` — o field-set da verificacao
   567	                    # TEM de espelhar o da assinatura byte a byte, ou o
   568	                    # verify-before-consume vira gerador de falso
   569	                    # start_unknown.
   570	                    entry.pop("hmac", None)
   571	                    entry.pop("hmac_error", None)
   572	                    calc = _ah.compute_entry_hmac(_ah_key, prev, entry)
   573	                    return _ah.hex_digest(calc) == ev_hmac
   574	                except Exception:
   575	                    return False
   576	
   577	            # Rail r22 P2-b: um resume NATIVO reusa o session_id — o
   578	            # oldest-match cru ancoraria no start da invocacao ANTERIOR e
   579	            # a janela atravessaria invocacoes (topico escrito antes do
   580	            # resume viraria "written" numa invocacao sem escrita). O
   581	            # segmento desta invocacao comeca DEPOIS do ultimo
   582	            # session_end verificado do mesmo id; um session_end que casa
   583	            # mas nao verifica e fronteira inverificavel ⇒ terminal
   584	            # unknown (encolher janela por fronteira forjada fabricaria
   585	            # absent — a direcao PIOR).
   586	            segment_from = 0
   587	            for _eidx, _eline in enumerate(lines):
   588	                if time.monotonic() > deadline:
   589	                    return None, "none"
   590	                if '"session_end"' not in _eline:
   591	                    continue
   592	                try:
   593	                    _eev = json.loads(_eline)
   594	                except ValueError:
   595	                    continue
   596	                if not isinstance(_eev, dict):
   597	                    continue
   598	                if _eev.get("action") != "session_end":
   599	                    continue
   600	                if _eev.get("session_id") != session_id:
   601	                    continue
