   179	class SqliteStateStore:
   180	    """Plan-scoped key/value store backed by a single sqlite file.
   181	
   182	    Not thread-safe within a process (callers should open one store per
   183	    thread). Cross-process safety is provided by the sibling filelock.
   184	
   185	    Args:
   186	        store_name: short slug identifying the store (e.g. "scratchpad").
   187	        plan_id: canonical PLAN-NNN string scoping the data.
   188	        value_max_bytes: per-key cap. Default 64 KiB.
   189	        lock_timeout: filelock wallclock budget. Default 5.0s.
   190	
   191	    Raises:
   192	        StateStoreInvalidName: if store_name or plan_id fail validation.
   193	    """
   194	
   195	    def __init__(
   196	        self,
   197	        store_name: str,
   198	        plan_id: str,
   199	        value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   200	        lock_timeout: float = _LOCK_TIMEOUT_SEC,
   201	        *,
   202	        clock: Optional[Callable[[], float]] = None,
   203	    ) -> None:
   204	        _validate_store_name(store_name)
   205	        _validate_plan_id(plan_id)
   206	        self.store_name = store_name
   207	        self.plan_id = plan_id
   208	        self.value_max_bytes = int(value_max_bytes)
   209	        self.lock_timeout = float(lock_timeout)
   210	        # PLAN-045 Wave 2 F-03-04: injectable clock so TTL tests can
   211	        # fast-forward instead of sleeping. Default: wall clock.
   212	        self._clock: Callable[[], float] = clock if clock is not None else time.time
   213	
   214	        self._store_dir = _state_root() / store_name
   215	        self._db_path = self._store_dir / f"{plan_id}.sqlite"
   216	        self._lock_path = self._store_dir / f"{plan_id}.sqlite.lock"
   217	
   218	        self._conn: Optional[sqlite3.Connection] = None
   219	        self._opened = False
   220	        self._db_ident = None  # (st_dev, st_ino) of the open db — round-11 [P2]
   221	
   222	    def _ensure_open(self) -> None:
   223	        if self._opened:
   224	            return
   225	        self._store_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
   226	        # sqlite connect will create the file if absent
   227	        self._conn = sqlite3.connect(
   228	            str(self._db_path),
   229	            timeout=self.lock_timeout,
   230	            isolation_level=None,  # autocommit; we manage transactions via BEGIN/COMMIT
   231	        )
   232	        # Tight file perms — owner-only
   233	        try:
   234	            os.chmod(self._db_path, 0o600)
   235	        except OSError:
   236	            pass
   237	        self._conn.execute("PRAGMA journal_mode=WAL")
   238	        self._conn.execute("PRAGMA synchronous=NORMAL")
   239	        self._conn.execute("PRAGMA temp_store=MEMORY")
   240	        self._conn.execute(
   241	            """
   242	            CREATE TABLE IF NOT EXISTS kv (
   243	                key TEXT PRIMARY KEY,
   244	                value BLOB NOT NULL,
   245	                expires_at INTEGER,           -- epoch seconds, NULL = no expiry
   246	                created_at INTEGER NOT NULL,  -- epoch seconds
   247	                redacted INTEGER NOT NULL     -- 1 if redact_secrets changed the value
   248	            )
   249	            """
   250	        )
   485	
   486	    def _emit_audit(self, action: str, **fields) -> None:
   487	        """Dispatch to audit_emit — fail-open."""
   488	        try:
   489	            from _lib import audit_emit  # local import to avoid cycle
   490	
   491	            emit_fn = getattr(audit_emit, f"emit_{action}", None)
   492	            if emit_fn is None:
   493	                return
   494	            emit_fn(
   495	                store_name=self.store_name,
   496	                plan_id_hash=_plan_id_hash(self.plan_id),
   497	                **fields,
   498	            )
   499	        except Exception:  # pragma: no cover — fail-open per ADR-005
   500	            pass
