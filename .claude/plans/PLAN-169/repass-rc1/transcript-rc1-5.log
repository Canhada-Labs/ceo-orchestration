   207	def _invoke_audit_tokens_stub(*, repo_root: Path, session_id: str) -> None:
   208	    """SEC-P0-04 / ADR-080 — invoke audit-tokens.py stub format with timeout.
   209	
   210	    Runs `audit-tokens.py --window 1 --format stub --content-ban=strict
   211	    --session-id <id>` as subprocess with `_AUDIT_TOKENS_TIMEOUT_SECONDS`
   212	    wall clock. On TimeoutExpired: emit audit_tokens_timeout event +
   213	    skip the audit_tokens_emitted event (subprocess writes the event
   214	    itself when it succeeds; on timeout the writer never runs).
   215	
   216	    Fail-open contract: any other exception → silent return. Hook is
   217	    observational and MUST NOT block session-end on this path.
   218	    """
   219	    if not _audit_tokens_auto_active():
   220	        return  # Kill-switch off (default OFF per opt-in policy)
   221	
   222	    audit_tokens_script = repo_root / ".claude" / "scripts" / "audit-tokens.py"
   223	    if not audit_tokens_script.is_file():
   224	        return  # Script not present (some adopter configs)
   225	
   226	    try:
   227	        import subprocess as _sp
   228	        _sp.run(
   229	            [
   230	                sys.executable,
   231	                str(audit_tokens_script),
   232	                "--window", "1",
   233	                "--format", "stub",
   234	                "--content-ban", "strict",
   235	                "--session-id", session_id,
   236	            ],
   237	            timeout=_AUDIT_TOKENS_TIMEOUT_SECONDS,
   238	            capture_output=True,
   239	            text=True,
   240	            check=False,
   241	        )
   242	    except _sp.TimeoutExpired:
   243	        # SEC-P0-04 §Performance budget — emit timeout breadcrumb in
   244	        # place of the audit_tokens_emitted event. The subprocess never
   245	        # got to call emit_audit_tokens_emitted, so no allowlist event
   246	        # was written; we record the timeout fact for forensic analysis.
   247	        try:
   248	            from _lib import audit_emit  # type: ignore
   249	            emit_timeout = getattr(audit_emit, "emit_audit_tokens_timeout", None)
   250	            if emit_timeout is not None:
   251	                emit_timeout(
   252	                    session_id=session_id,
   253	                    timeout_seconds=_AUDIT_TOKENS_TIMEOUT_SECONDS,
   254	                    project=str(repo_root),
   255	                )
   256	        except Exception:
   257	            pass
   258	    except Exception:
   259	        # All other exceptions silently swallowed (fail-open).
   260	        pass
