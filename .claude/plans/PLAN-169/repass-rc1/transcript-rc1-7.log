   526	          # Pre-GA waiver check (PLAN-051 round-19, ADR-007 amendment
   527	          # extension). Same waiver registry as the RC-hold gate:
   528	          # pre-GA phase with adopter_count=0 waives advisory-workflow
   529	          # staleness per Owner authorization. Post-first-adopter, the
   530	          # waiver file is expected to be empty and the gate resumes
   531	          # default enforcement.
   532	          WAIVER_FILE=".claude/governance/governance-waivers.yaml"
   533	          if [[ -f "$WAIVER_FILE" ]]; then
   534	            if awk '/^workflow_staleness:/{f=1; next} f && /^[a-z_]+:/{f=0} f' "$WAIVER_FILE" | grep -qE "^[[:space:]]*-[[:space:]]*version:[[:space:]]*${VERSION}[[:space:]]*$"; then
   535	              echo "::notice::$TAG has a pre-GA waiver in $WAIVER_FILE — skipping weekly workflow staleness gate"
   536	              exit 0
   537	            fi
   538	          fi
   539	
   540	          # PLAN-025 Batch G F-wf-002: fail-fast if gh is unavailable (rare
   541	          # on ubuntu-latest but not impossible on custom runners). Clearer
   542	          # error than "gh: command not found" in an obscure subshell.
   543	          command -v gh >/dev/null 2>&1 || {
   544	            echo "::error::gh CLI not found on runner; install via \"sudo apt-get install gh\" or use actions/setup-gh"
   545	            exit 1
   546	          }
   547	          # Tolerance: each workflow is checked across the last 3 runs.
   548	          # If ANY run in that window is `failure` → fail the release.
   549	          # `skipped` runs are fine (kill-switch or paths-filter).
   550	          WORKFLOWS=(chaos.yml otel-smoke.yml perf-profile.yml adapter-live.yml red-team.yml formal-verify.yml)
   551	          STALENESS_DAYS=14
   552	          STALENESS_SECS=$((STALENESS_DAYS * 86400))
   553	          NOW_SECS=$(date -u +%s)
   554	          FAILED=0
   555	          for wf in "${WORKFLOWS[@]}"; do
   556	            # Fetch up to 3 runs with both conclusion AND startedAt timestamp.
   557	            runs_json=$(gh run list --workflow "$wf" --limit 3 \
   558	              --json conclusion,startedAt 2>/dev/null || echo "[]")
   559	            if [ -z "$runs_json" ] || [ "$runs_json" = "[]" ]; then
   560	              # Absence of runs is NOT neutral post-DevOps-P2-1: it means
   561	              # the advisory workflow has never triggered in this repo.
   562	              # For a mature release (v1.x.y), that's a bug — kill switch
   563	              # set, cron disabled, or workflow deleted.
   564	              echo "::error::$wf — zero runs recorded; staleness gate fails"
   565	              FAILED=1
   566	              continue
   567	            fi
   568	            # Extract conclusions for the failure-scan logic.
   569	            # Session 33 refinement: the previous rule "any failure in
   570	            # last 3 → block" did not distinguish "past bug, now fixed"
   571	            # from "still broken / intermittent flake". Both classes
   572	            # block release, but only the second is a real tag risk.
   573	            # New rule: block iff BOTH of these hold simultaneously:
   574	            #   (a) at least one failure in last 3 runs
   575	            #   (b) the MOST RECENT run also failed
   576	            # Rationale: (a) alone is false-positive after a root-cause
   577	            # fix; (b) alone would let a "one green after 10 reds"
   578	            # flake slip through. Both together = persistent failure
   579	            # that a tag should not paper over.
   580	            conclusions=$(echo "$runs_json" | jq -r '.[].conclusion')
   581	            latest_conclusion=$(echo "$runs_json" | jq -r '.[0].conclusion')
   582	            if echo "$conclusions" | grep -q '^failure$' \
   583	               && [ "$latest_conclusion" = "failure" ]; then
   584	              echo "::error::$wf — failure in last 3 AND latest run failed; block release"
   585	              FAILED=1
   586	            elif echo "$conclusions" | grep -q '^failure$'; then
   587	              echo "::notice::$wf — past failure in last 3 but latest run green; accepting as fixed"
   588	            fi
   589	            # Staleness check: most-recent run's startedAt must be within
   590	            # STALENESS_DAYS of now. startedAt is ISO-8601 UTC
   591	            # (e.g. "2026-04-10T12:34:56Z"). GitHub runners are Linux →
   592	            # GNU `date -d` is always available.
   593	            latest_started=$(echo "$runs_json" | jq -r '.[0].startedAt')
   594	            if [ -z "$latest_started" ] || [ "$latest_started" = "null" ]; then
   595	              echo "::error::$wf — cannot parse startedAt for most-recent run"
   596	              FAILED=1
   597	              continue
   598	            fi
   599	            started_secs=$(date -u -d "$latest_started" +%s 2>/dev/null || echo 0)
   600	            if [ "$started_secs" -eq 0 ]; then
   601	              echo "::error::$wf — failed to parse startedAt: $latest_started"
   602	              FAILED=1
   603	              continue
   604	            fi
   605	            delta=$((NOW_SECS - started_secs))
   606	            days=$((delta / 86400))
   607	            if [ "$delta" -gt "$STALENESS_SECS" ]; then
   608	              echo "::error::$wf stale — last run $days days ago (> $STALENESS_DAYS day limit)"
   609	              FAILED=1
   610	            else
   611	              echo "::notice::$wf — recent runs OK; last run $days days ago"
   612	            fi
   613	          done
   614	          if [ "$FAILED" -eq 1 ]; then
   615	            echo "::error::release gate: one or more advisory workflows red or stale"
   616	            exit 1
   617	          fi
   618	          echo "OK: all 6 advisory workflows clean in last 3 runs + fresh within $STALENESS_DAYS days"
