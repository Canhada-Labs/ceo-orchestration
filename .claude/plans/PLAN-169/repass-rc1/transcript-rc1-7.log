    96	            exit 1
    97	          fi
    98	          if [[ "$EXPECTED" != "$BASE" ]]; then
    99	            echo "OK: VERSION=$FILE matches RC tag=$TAG (compared against base '$BASE' after stripping the -rc.N pre-release suffix)"
   100	          else
   101	            echo "OK: VERSION=$FILE matches tag=$TAG"
   102	          fi
   103	
   104	      # -----------------------------------------------------------------
   105	      # PLAN-166 W1 item 2 (F3, ADR-155-AMEND-1 §5, Forma A (ii)) — the
   106	      # framework version marker `.claude/.framework-version` is a TRACKED
   107	      # one-line file, byte-identical to VERSION (the version bump writes
   108	      # it as a site; verify-counts.sh cross-checks it). This assert is
   109	      # deliberately UNCONDITIONAL and fail-closed: a missing marker in a
   110	      # release checkout means the ceremony that introduced it was
   111	      # reverted or the bump skipped a site — either way the tag must not
   112	      # ship. Kept NEXT TO the VERSION↔tag assert above so the whole
   113	      # version-consistency family lives in one place (same convention as
   114	      # the plugin-manifest step below).
   115	      # -----------------------------------------------------------------
   116	      - name: Assert framework-version marker matches VERSION
   117	        run: |
   118	          set -euo pipefail
   119	          if [[ ! -f .claude/.framework-version ]]; then
   120	            echo "::error::.claude/.framework-version is missing — it is a tracked file (PLAN-166 F3 / ADR-155-AMEND-1); a release checkout without it must not ship"
   121	            exit 1
   122	          fi
   123	          # BYTE-identical, as the contract says — cmp, not tr-stripped
   124	          # equality. The old tr -d '[:space:]' compare accepted '1 . 3 . 0'
   125	          # or '1.3.0\n\n' while the error message promised byte identity
   126	          # (repass-r2 part-e P2: assert weaker than its own claim).
   127	          if ! cmp -s VERSION .claude/.framework-version; then
   128	            echo "::error::.claude/.framework-version is not byte-identical to VERSION — the version bump writes it as a site (Forma A (ii), fail-closed). xxd both files to see the drift."
   129	            exit 1
   130	          fi
   131	          echo "OK: .claude/.framework-version is byte-identical to VERSION ($(tr -d '[:space:]' < VERSION))"
   132	
   133	      # -----------------------------------------------------------------
   134	      # PLAN-153 Wave B item 5 (e) — version↔plugin-manifest sync, kept
   135	      # NEXT TO the VERSION↔tag assert above so the whole
   136	      # version-consistency family lives in one place.
   137	      #
   138	      # `.claude-plugin/{plugin.json,marketplace.json}` are generated by
   139	      # `build-plugin.py` (Wave B item 6). Until item 6 lands, the
   140	      # manifests do not exist and this step passes with a ::notice
   141	      # (self-arming: the equality checks become enforcing the moment
   142	      # the manifests appear in the tree — no workflow re-edit needed).
   143	      # `marketplace.json`'s schema is owned by build-plugin.py, so we
   144	      # assert on EVERY nested `version` field found rather than
   145	      # hardcoding one JSON path.
   146	      # -----------------------------------------------------------------
   147	      - name: Assert plugin manifest versions match VERSION
   148	        run: |
   149	          set -euo pipefail
   150	          FILE="$(tr -d '[:space:]' < VERSION)"
   151	          if [[ ! -f .claude-plugin/plugin.json ]]; then
   152	            echo "::notice::.claude-plugin/plugin.json not present yet (PLAN-153 Wave B item 6) — sync check self-arms once it lands"
   153	            exit 0
   154	          fi
   155	          PLUGIN_V=$(jq -r '.version // empty' .claude-plugin/plugin.json)
