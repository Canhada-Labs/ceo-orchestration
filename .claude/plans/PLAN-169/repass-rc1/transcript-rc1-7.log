   311	    def close(self) -> None:
   312	        """Close the connection. Idempotent."""
   313	        if self._conn is not None:
   314	            try:
   315	                self._conn.close()
   316	            except sqlite3.Error:
   317	                pass
   318	            self._conn = None
   319	        self._opened = False
   320	
   321	    # --- primary operations -----------------------------------------------
   322	
   323	    def set(
   324	        self,
   325	        key: str,
   326	        value: Union[str, bytes],
   327	        ttl_seconds: Optional[int] = None,
   328	    ) -> None:
   329	        """Write a key/value pair with optional TTL.
   330	
   331	        Args:
   332	            key: free-form string key. No length cap enforced at this layer;
   333	                sqlite TEXT PK handles it.
   334	            value: str (redacted before write) or bytes (stored as-is).
   335	            ttl_seconds: None = no expiry; positive int = seconds from now.
   336	
   337	        Raises:
   338	            StateStoreValueTooLarge: if value exceeds ``value_max_bytes``.
   339	            ValueError: if ttl_seconds is negative or zero.
   340	        """
   341	        self._ensure_open()
   342	        assert self._conn is not None  # for type-checker
   343	
   344	        if ttl_seconds is not None and ttl_seconds <= 0:
   345	            raise ValueError(f"ttl_seconds must be positive, got {ttl_seconds}")
   346	
   347	        # Redaction: strings go through the regex redactor; bytes are trusted.
   348	        redacted = 0
   349	        if isinstance(value, str):
   350	            # Use max_chars=0 so full string survives — the cap below
   351	            # still enforces size.
   352	            redacted_text = _redact.redact_secrets(value, max_chars=0)
   353	            if redacted_text != value:
   354	                redacted = 1
   355	            value_bytes = redacted_text.encode("utf-8", errors="replace")
   356	        elif isinstance(value, (bytes, bytearray)):
   357	            value_bytes = bytes(value)
   358	        else:
   359	            raise TypeError(f"value must be str or bytes, got {type(value).__name__}")
   360	
   361	        if len(value_bytes) > self.value_max_bytes:
   362	            raise StateStoreValueTooLarge(
   363	                f"value is {len(value_bytes)} bytes, cap is {self.value_max_bytes}"
   364	            )
   365	
   366	        now = int(self._clock())
   367	        expires_at: Optional[int] = None
   368	        if ttl_seconds is not None:
   369	            expires_at = now + int(ttl_seconds)
   370	
   371	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   372	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   373	            self._conn.execute(
   374	                """
   375	                INSERT INTO kv(key, value, expires_at, created_at, redacted)
   376	                VALUES (?, ?, ?, ?, ?)
   377	                ON CONFLICT(key) DO UPDATE SET
   378	                    value = excluded.value,
   379	                    expires_at = excluded.expires_at,
   380	                    created_at = excluded.created_at,
   381	                    redacted = excluded.redacted
   382	                """,
   383	                (key, value_bytes, expires_at, now, redacted),
   384	            )
   385	
   386	        # Audit emit (fail-open inside)
   387	        self._emit_audit(
   388	            "state_store_write",
   389	            key_hash=_key_hash(key),
   390	            value_bytes=len(value_bytes),
   391	            ttl_seconds=ttl_seconds,
   392	            redaction_applied=bool(redacted),
   393	        )
   394	
   395	    def get(self, key: str) -> Optional[bytes]:
   396	        """Read a key; returns None if missing or expired.
   397	
   398	        Expired entries are NOT automatically pruned — call
   399	        :meth:`prune_expired` on a schedule. This keeps get() side-effect
   400	        free for observability.
   401	        """
   402	        self._ensure_open()
   403	        assert self._conn is not None
   404	
   405	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   406	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   407	            row = self._conn.execute(
   408	                "SELECT value, expires_at FROM kv WHERE key = ?", (key,)
   409	            ).fetchone()
   410	
   411	        found = False
   412	        value: Optional[bytes] = None
   413	        if row is not None:
   414	            raw_value, expires_at = row
   415	            now = int(self._clock())
   416	            if expires_at is None or expires_at > now:
   417	                value = bytes(raw_value)
   418	                found = True
   419	
   420	        self._emit_audit(
   421	            "state_store_read",
   422	            key_hash=_key_hash(key),
   423	            found=found,
   424	        )
   425	        return value
   426	
   427	    def delete(self, key: str) -> bool:
   428	        """Delete a key. Returns True if the key existed."""
   429	        self._ensure_open()
   430	        assert self._conn is not None
   431	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   432	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   433	            cur = self._conn.execute("DELETE FROM kv WHERE key = ?", (key,))
   434	            return cur.rowcount > 0
   435	
   436	    def list_keys(self, *, include_expired: bool = False) -> List[str]:
   437	        """List keys in the store. Expired entries are skipped by default."""
   438	        self._ensure_open()
   439	        assert self._conn is not None
   440	        now = int(self._clock())
   441	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   442	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   443	            if include_expired:
   444	                rows = self._conn.execute("SELECT key FROM kv ORDER BY key").fetchall()
   445	            else:
   446	                rows = self._conn.execute(
   447	                    "SELECT key FROM kv WHERE expires_at IS NULL OR expires_at > ? ORDER BY key",
   448	                    (now,),
   449	                ).fetchall()
   450	        return [r[0] for r in rows]
   451	
   452	    def prune_expired(self) -> int:
   453	        """Delete expired keys. Returns the count pruned."""
   454	        self._ensure_open()
   455	        assert self._conn is not None
   456	        now = int(self._clock())
   457	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   458	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   459	            cur = self._conn.execute(
   460	                "DELETE FROM kv WHERE expires_at IS NOT NULL AND expires_at <= ?",
   461	                (now,),
   462	            )
   463	            pruned = cur.rowcount
   464	
   465	        if pruned:
   466	            self._emit_audit("state_store_pruned", keys_pruned_count=pruned)
   467	        return int(pruned)
   468	
   469	    def clear_plan(self) -> int:
   470	        """Drop every key for this plan_id. Returns the count deleted.
   471	
   472	        Used on plan status `executing → draft` rollback (consensus M2).
   473	        """
   474	        self._ensure_open()
   475	        assert self._conn is not None
   476	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   477	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   478	            cur = self._conn.execute("DELETE FROM kv")
   479	            cleared = cur.rowcount
   480	        if cleared:
   481	            self._emit_audit("state_store_pruned", keys_pruned_count=cleared)
   482	        return int(cleared)
