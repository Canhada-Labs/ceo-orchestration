   332	def _redirect_collection_window() -> Dict[str, Optional[str]]:
   333	    """Point the primary audit anchor at a throwaway tree for the window between
   334	    conftest import and the session fixture body (module docstring, Axis 3).
   335	
   336	    Import-time by design, for the same reason as Axis 2. Three steps whose
   337	    ORDER is the whole point:
   338	
   339	    1. The throwaway tree and its ``atexit`` cleanup come FIRST (pair-rail r2
   340	       P2): ``atexit`` is LIFO and importing ``audit_emit`` (which step 2
   341	       does) registers the spool drain. Registering ``rmtree`` before that
   342	       import makes the drain run first and the ``rmtree`` last — the other
   343	       order let the drain re-create the tree we had just removed, leaking
   344	       one ``ceo-collect-isolation-*`` per process.
   345	    2. The live snapshot is captured BEFORE the anchor moves. An inherited,
   346	       well-formed value wins (pair-rail r1 P1: an xdist worker inherits the
   347	       truth AND a redirected anchor; re-resolving would return the parent's
   348	       collection tree). An inherited value that is NOT well-formed is a
   349	       redirected/stale one: resolve with the anchors removed (r2 P1) — never
   350	       through the anchor that produced it. Nothing inherited: resolve as the
   351	       process sees it (an operator-level ``CEO_AUDIT_LOG_DIR`` IS the live
   352	       location and must be honoured).
   353	    3. Only then the anchors move to the throwaway tree.
   354	
   355	    Returns the previous anchor values — diagnostic only, never restored (a
   356	    restore anywhere inside the process re-opens the escape at shutdown).
   357	    """
   358	    global COLLECT_WINDOW_DIR, IMPORT_TIME_LIVE_LOG_SNAPSHOT
   359	    # 1) tree + cleanup first (LIFO argument above)
   360	    root = Path(tempfile.mkdtemp(prefix=COLLECT_WINDOW_PREFIX))
   361	    atexit.register(shutil.rmtree, str(root), True)
   362	    audit = root / "audit"
   363	    state = audit / "state"
   364	    state.mkdir(parents=True, exist_ok=True)
   365	    # 2) snapshot before the anchor moves
   366	    inherited = os.environ.get(LIVE_LOG_SNAPSHOT_VAR) or None
   367	    if inherited is not None and _snapshot_is_wellformed(inherited):
   368	        snapshot: Optional[str] = inherited
   369	    elif inherited is not None:
   370	        snapshot = _resolve_live_snapshot_outside_isolation()
   371	    else:
   372	        snapshot = _resolve_live_log_path_snapshot()
   373	    IMPORT_TIME_LIVE_LOG_SNAPSHOT = snapshot
   374	    if snapshot is not None:
   375	        os.environ[LIVE_LOG_SNAPSHOT_VAR] = snapshot
   376	    else:
   377	        os.environ.pop(LIVE_LOG_SNAPSHOT_VAR, None)
   378	    # 3) move the anchors
   379	    previous = {
   380	        "CEO_AUDIT_LOG_DIR": os.environ.get("CEO_AUDIT_LOG_DIR"),
   381	        "CEO_PROJECT_STATE_DIR": os.environ.get("CEO_PROJECT_STATE_DIR"),
   382	    }
   383	    os.environ["CEO_AUDIT_LOG_DIR"] = str(audit)
   384	    os.environ["CEO_PROJECT_STATE_DIR"] = str(state)
   385	    # Per-file overrides inherited from the shell could still point a single
   386	    # sidecar at the live tree; clear them now, exactly as the fixture does.
   387	    for key in AUDIT_CLEAR_CARRIERS:
   388	        os.environ.pop(key, None)
   389	    COLLECT_WINDOW_DIR = root
   390	    return previous
