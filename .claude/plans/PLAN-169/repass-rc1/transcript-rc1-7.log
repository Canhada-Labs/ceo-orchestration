     1	"""Policy-engine mutation harness — PLAN-014 Phase A.6.
     2	
     3	Runs every mutation under ``tests/mutations/`` in-process and asserts:
     4	
     5	1. for engine mutations: at least one of the listed TARGETS fails (the
     6	   existing test corpus kills the mutation);
     7	2. for policy mutations: replaying the fixture JSONL against the mutated
     8	   YAML produces ≥1 ``(decision, reason)`` tuple that differs from the
     9	   un-mutated baseline.
    10	
    11	``TestMutationKillRateGate`` fails with the full list of surviving
    12	mutations if kill-rate < 100 %.
    13	
    14	Design notes
    15	------------
    16	
    17	* **In-process** — pytest-subprocess-per-mutation was too slow. The
    18	  harness imports ``_lib.policy``, calls ``mutation.apply(policy_mod)``,
    19	  runs the targets, then invokes the returned ``revert()``. Each
    20	  mutation is fully isolated.
    21	* **Engine tests are unittest.TestCase subclasses** — the harness
    22	  instantiates a dynamic subclass, drives setUp/tearDown, captures the
    23	  first failure per target.
    24	* **Policy mutations** load the mutated YAML via ``_lib.policy.load``
    25	  through a tmpfile and replay the matching ``.fixtures.jsonl`` corpus.
    26	  Un-mutated baseline is loaded once per module load.
    27	* **TestEnvContext** subclass for env isolation per ADJ-028.
    28	"""
    29	
    30	from __future__ import annotations
    31	
    32	import importlib
    33	import importlib.util
    34	import json
    35	import sys
    36	import unittest
    37	from pathlib import Path
    38	from typing import Any, Dict, List, Tuple
    39	
    40	_HOOKS_DIR = Path(__file__).resolve().parent.parent
    41	
    42	# Make .claude/hooks/tests/ importable so we can resolve target classes.
    43	_TESTS_DIR = Path(__file__).resolve().parent
    44	
    45	from _lib.testing import TestEnvContext  # noqa: E402
    46	from _lib import policy as _policy  # noqa: E402
    47	
    48	
    49	_REPO_ROOT = _HOOKS_DIR.parent.parent
    50	_POLICIES_DIR = _REPO_ROOT / ".claude" / "policies"
    51	_FIXTURES_DIR = _POLICIES_DIR / "fixtures"
    52	_ENGINE_MUT_DIR = _TESTS_DIR / "mutations" / "engine_mutations"
    53	_POLICY_MUT_DIR = _TESTS_DIR / "mutations" / "policy_mutations"
    54	
    55	
    56	# ---------------------------------------------------------------------------
    57	# Mutation discovery
    58	# ---------------------------------------------------------------------------
    59	
    60	
    61	def _discover(pkg_dir: Path) -> List[Tuple[str, Any]]:
    62	    """Import every ``mutation_*.py`` in pkg_dir; return [(name, module)]."""
    63	    out = []
    64	    for path in sorted(pkg_dir.glob("mutation_*.py")):
    65	        name = path.stem
    66	        spec = importlib.util.spec_from_file_location(
    67	            f"_mutations.{pkg_dir.name}.{name}", path
    68	        )
    69	        if spec is None or spec.loader is None:
    70	            continue
    71	        mod = importlib.util.module_from_spec(spec)
    72	        spec.loader.exec_module(mod)
    73	        out.append((name, mod))
    74	    return out
    75	
    76	
    77	_ENGINE_MUTATIONS = _discover(_ENGINE_MUT_DIR)
    78	_POLICY_MUTATIONS = _discover(_POLICY_MUT_DIR)
    79	
    80	
    81	# ---------------------------------------------------------------------------
    82	# Target resolution — lazy import of test_policy_engine once
    83	# ---------------------------------------------------------------------------
    84	
    85	
    86	def _import_target_module() -> Any:
    87	    # Re-import fresh so the class bodies pick up any module-level patches.
    88	    if "test_policy_engine" in sys.modules:
    89	        # Keep the already-imported module; its tests use ``_lib.policy`` via
    90	        # the module binding ``P``, which we patch at module level.
    91	        return sys.modules["test_policy_engine"]
    92	    import test_policy_engine  # noqa: E402
    93	    return test_policy_engine
    94	
    95	
    96	def _resolve_target(node_id: str):
    97	    """``test_policy_engine.py::Class::method`` -> (Class, method_name)."""
    98	    # Accept both ``file::Class::method`` and ``Class::method``
    99	    parts = node_id.split("::")
   100	    if len(parts) == 3:
   101	        _file, cls_name, meth_name = parts
   102	    elif len(parts) == 2:
   103	        cls_name, meth_name = parts
   104	    else:
   105	        raise ValueError(f"unparseable target: {node_id!r}")
   106	    mod = _import_target_module()
   107	    cls = getattr(mod, cls_name, None)
   108	    if cls is None:
   109	        raise AttributeError(f"class {cls_name} not found in test_policy_engine")
   110	    return cls, meth_name
   111	
   112	
   113	def _run_target(node_id: str) -> Tuple[bool, str]:
   114	    """Instantiate + run a single unittest test method.
   115	
   116	    Returns ``(passed, detail)``; ``passed=False`` means the mutation killed
   117	    the test (either via AssertionError or unexpected exception).
   118	    """
   119	    try:
   120	        cls, meth = _resolve_target(node_id)
   121	    except Exception as e:
   122	        return False, f"resolve-failed: {e}"
   123	    inst = cls(meth)
   124	    result = unittest.TestResult()
   125	    try:
   126	        inst.run(result)
   127	    except Exception as e:
   128	        return False, f"run-crash: {e}"
   129	    if result.failures or result.errors:
   130	        detail = ""
   131	        if result.failures:
   132	            detail = result.failures[0][1].splitlines()[-1] if result.failures[0][1] else "failure"
   133	        elif result.errors:
   134	            detail = result.errors[0][1].splitlines()[-1] if result.errors[0][1] else "error"
   135	        return False, detail
   136	    return True, "ok"
   137	
   138	
   139	# ---------------------------------------------------------------------------
   140	# Policy-mutation fixture runner
   141	# ---------------------------------------------------------------------------
   142	
   143	
   144	def _load_fixtures(fixture_file: str) -> List[Dict[str, Any]]:
   145	    path = _FIXTURES_DIR / fixture_file
   146	    entries = []
   147	    with path.open("r", encoding="utf-8") as f:
   148	        for line in f:
   149	            line = line.strip()
   150	            if not line:
   151	                continue
   152	            entries.append(json.loads(line))
   153	    return entries
   154	
   155	
   156	def _baseline_decisions(policy_slug: str) -> List[Tuple[str, Any]]:
   157	    """Run the un-mutated policy against its fixture corpus. Returns list of
   158	    (decision, reason) tuples aligned with fixture order.
   159	    """
   160	    policy_path = _POLICIES_DIR / f"{policy_slug}.policy.yaml"
   161	    pol = _policy.load(policy_path)
   162	    fixture_file = f"{policy_slug}.fixtures.jsonl"
   163	    out = []
   164	    for entry in _load_fixtures(fixture_file):
   165	        d = pol.decide(entry["input"])
   166	        out.append((d["decision"], d.get("reason")))
   167	    return out
   168	
   169	
   170	# Baseline cache — filled on FIRST USE, never at import (S326, 2026-08-24).
   171	# ``pol.decide()`` emits ``policy_evaluated`` / ``policy_denied`` audit events.
   172	# Module import happens at pytest COLLECTION, before the session isolation
   173	# fixture has redirected the audit dir (fixtures never run under
   174	# ``--collect-only``), so an import-time replay of the corpus wrote 124
   175	# HMAC-signed, unattributable links (82 rows + 42 denies) into the LIVE chain
   176	# on every collect — ``verify-counts.sh`` runs one before each commit: 19 runs
   177	# / 2,356 links in 12 h. Guard: ``test_collect_only_audit_isolation.py``.
   178	_POLICY_BASELINES: Dict[str, List[Tuple[str, Any]]] = {}
   179	
   180	

