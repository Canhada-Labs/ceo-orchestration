  1352	      - name: Checkout
  1353	        # SHA-pinned: actions/checkout@v6.0.2 (matches sibling jobs)
  1354	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd
  1355	
