    80	    def _production_shape_env(self, home: Path) -> Dict[str, str]:
    81	        """The env ``verify-counts.sh`` runs its collect in: no audit carriers,
    82	        no test-harness signals, HOME = the throwaway tree. PYTHONUSERBASE is
    83	        re-exported to the REAL user site so the child can import pytest
    84	        (HOME redirect alone loses the user site — measured)."""
    85	        drop = set(test_isolation.ALL_AUDIT_CARRIERS)
    86	        drop.update(test_isolation.WHOLE_DIR_OVERRIDE_CARRIERS)
    87	        drop.update((
    88	            test_isolation.TEST_HARNESS_VAR,
    89	            test_isolation.SYNC_MODE_VAR,
    90	            test_isolation.LIVE_LOG_SNAPSHOT_VAR,
    91	            "PYTEST_ADDOPTS",
    92	        ))
    93	        env = {
    94	            k: v for k, v in os.environ.items()
    95	            if k not in drop and not k.startswith("PYTEST_")
    96	        }
    97	        env["HOME"] = str(home)
    98	        # TestEnvContext sandboxes CLAUDE_PROJECT_DIR; the collect must see the
    99	        # real repo (that is where verify-counts.sh runs it).
   100	        env["CLAUDE_PROJECT_DIR"] = str(_REPO_ROOT)
   101	        env["PYTHONUSERBASE"] = os.environ.get("PYTHONUSERBASE") or site.getuserbase()
   102	        return env
