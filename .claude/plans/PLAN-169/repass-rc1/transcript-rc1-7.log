   111	def _sha256(path: str) -> str:
   112	    h = hashlib.sha256()
   113	    with open(path, "rb") as fh:
   114	        for chunk in iter(lambda: fh.read(65536), b""):
   115	            h.update(chunk)
   116	    return h.hexdigest()
