   208	def _emit_unlock_audit(sha: str, reason: str) -> None:
   209	    """Advisory, fail-open: emissor canônico; senão, breadcrumb durável.
   210	
   211	    RESTAURADO (S318, pack SENT-S318 — o mesmo pack que registrou a ação
   212	    ``ceremony_lint_unlock_used`` nas DUAS fontes canônicas que o gate
   213	    ``check-audit-registry-coverage.py`` exige: ``_KNOWN_ACTIONS`` em
   214	    ``.claude/hooks/_lib/audit_emit.py`` e a tabela por-ação de
   215	    ``SPEC/v1/audit-log.schema.md``). Histórico: o PLAN-174 W1 (7d467a8)
   216	    embarcou este emissor SEM a metade canônica do registro, o gate pegou o
   217	    órfão (6 jobs vermelhos), e a S317 (908707e) parcou o emit fixando a
   218	    regra "um emissor não embarca antes do registro dele" — precedente
   219	    v2.51 / SENT-GK-F.
   220	
   221	    Wire metadata-only (LLM06): ``file_sha256`` = prefixo 16-hex do sha256
   222	    do script destravado; ``reason_len`` = comprimento do
   223	    ``CEO_CEREMONY_LINT_UNLOCK_REASON``. O TEXTO do motivo nunca vai ao
   224	    log — fica só no stderr do operador (abaixo).
   225	
   226	    Fail-open em TODA rota (um unlock advisory nunca pode quebrar o lint):
   227	    emissor indisponível ⇒ breadcrumb durável em ``audit-log.errors`` — o
   228	    mesmo destino que a versão parcada usava — e o stderr sempre imprime.
   229	    """
   230	    line = (f"ceremony-lint UNLOCK usado sha={sha[:16]} "
   231	            f"reason_len={len(reason)}")
   232	    try:
   233	        sys.path.insert(0, os.path.join(REPO_ROOT, ".claude", "hooks"))
   234	        from _lib import audit_emit  # type: ignore
   235	        fn = getattr(audit_emit, "emit_generic", None)
   236	        if callable(fn):
   237	            # emit_generic takes **kwargs as TOP-LEVEL event fields — the
   238	            # 7d467a8 shape (`fields={...}`) nested the payload under a
   239	            # single "fields" key the scrub correctly drops (caught by the
   240	            # S318 clone-sim; the parked emitter had never run live).
   241	            fn(action="ceremony_lint_unlock_used",
   242	               file_sha256=sha[:16], reason_len=len(reason))
   243	        else:
   244	            crumb = getattr(audit_emit, "_breadcrumb", None)
   245	            if callable(crumb):
   246	                crumb(line)
   247	    except Exception:
   248	        try:
   249	            from _lib import audit_emit as _ae  # type: ignore
   250	            crumb = getattr(_ae, "_breadcrumb", None)
   251	            if callable(crumb):
   252	                crumb(line)
   253	        except Exception:
   254	            pass
   255	    try:
   256	        # Rail S318 (P2): o stderr do operador também fica dentro da
   257	        # fronteira fail-open — um BrokenPipeError/encoding error aqui não
   258	        # pode abortar o lint depois de um unlock válido.
   259	        print(f"ceremony-lint: UNLOCK usado sha={sha[:16]} motivo={reason!r}",
   260	              file=sys.stderr)
   261	    except Exception:
   262	        pass
