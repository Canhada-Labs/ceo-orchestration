    41	          python-version: "3.11"
    42	
    43	      # -----------------------------------------------------------------
    44	      # PLAN-169 W2.8 (ADR-192, route (b)-narrow) — gate-scripts integrity.
    45	      # The surfaces that DECIDE this release are canonical, but the body
    46	      # of the decision lives in free scripts they invoke. This step pins
    47	      # the release-critical subset by content: any drift between the
    48	      # canonical manifest (.claude/governance/gate-scripts-manifest.txt —
    49	      # updating it requires the GPG ceremony) and the tagged tree fails
