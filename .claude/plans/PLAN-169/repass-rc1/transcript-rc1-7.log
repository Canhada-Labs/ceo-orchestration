   165	class TestCli(TestEnvContext):
   166	    """PLAN-182 OQ-6 (S326) — the CLI is a thin printer over the functions."""
   167	
   168	    def _run(self, *args, env=None, cwd=None):
   169	        if env is None:
   170	            env = self.subprocess_env()  # the sanctioned isolated-env builder
   171	        return subprocess.run(
   172	            [sys.executable, str(_RESOLVER_FILE), *args],
   173	            env=env, cwd=cwd, capture_output=True, text=True, timeout=60,
   174	        )
   175	
   176	    def test_default_prints_state_dir_identical_to_the_function(self):
   177	        env = self.subprocess_env()
   178	        res = self._run(env=env)
   179	        self.assertEqual(res.returncode, 0, msg=res.stderr)
   180	        expected = str(Path(env["HOME"]) / ".claude" / "projects"
   181	                       / runtime_paths.project_slug(env["CLAUDE_PROJECT_DIR"]))
   182	        self.assertEqual(res.stdout, expected + "\n")
   183	        self.assertEqual(res.stderr, "")
   184	
   185	    def test_slug_and_project_dir_modes(self):
   186	        env = self.subprocess_env()
   187	        slug = self._run("--slug", env=env)
   188	        pdir = self._run("--project-dir", env=env)
   189	        self.assertEqual(slug.stdout.rstrip("\n"),
   190	                         runtime_paths.project_slug(env["CLAUDE_PROJECT_DIR"]))
   191	        self.assertEqual(pdir.stdout.rstrip("\n"),
   192	                         os.path.abspath(env["CLAUDE_PROJECT_DIR"]))
