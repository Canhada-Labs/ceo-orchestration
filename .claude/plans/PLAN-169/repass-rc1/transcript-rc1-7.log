   132	def _composite_key(project_path: str, user_id: str, date_iso: str) -> str:
   133	    """Return 32-hex prefix of sha256(project_path:user_id:date_iso).
   134	
   135	    Per ADR-133 §A dated tenant-iso. Each new UTC date produces a NEW
   136	    key → NEW state file → implicit midnight rollover (no migration).
   137	    """
   138	    raw = f"{project_path}:{user_id}:{date_iso}".encode("utf-8")
   139	    return hashlib.sha256(raw).hexdigest()[:32]
