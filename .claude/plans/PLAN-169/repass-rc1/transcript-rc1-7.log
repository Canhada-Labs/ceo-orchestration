    72	class TestCollectOnlyAuditIsolation(TestEnvContext):
    73	    """S326 — nothing that runs at collection time may reach the live chain."""
    74	
    75	    def _throwaway_home(self) -> Path:
    76	        home = Path(tempfile.mkdtemp(prefix="s326-home-"))
    77	        self.addCleanup(shutil.rmtree, str(home), True)
    78	        return home
