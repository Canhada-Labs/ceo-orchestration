   497	      # PLAN-012 Phase 2 §R11 — weekly-workflow status gate.
   498	      # PLAN-019 P2 DevOps-P2-1 — 14-day staleness check added.
   499	      #
   500	      # Before a tag ships, assert that recent runs of the six advisory
   501	      # workflows (chaos, otel-smoke, perf-profile, adapter-live,
   502	      # red-team, formal-verify) have NOT been failing AND are fresh
   503	      # (most-recent run within 14 days). A red chaos.yml in the past 3
   504	      # runs means we have live regressions that a tag should not paper
   505	      # over. A stale workflow (no runs in 14 days) means the advisory
   506	      # check is silently disabled — kill switch, cron disabled, or
   507	      # workflow deleted.
   508	      #
   509	      # Staleness defense (P2 DevOps-P2-1): absence of runs is NOT
   510	      # neutral. Prior logic treated "no runs" as pass — a 1-year-old
   511	      # repo with 0 runs silently passed, turning the gate into a
   512	      # honeypot. Now: most-recent run must have started within 14 days
   513	      # OR the gate fails with `Workflow X stale — last run N days ago`.
   514	      #
   515	      # Uses `gh run list` against the REST API via $GITHUB_TOKEN; read
   516	      # permission on `actions` is granted at job level.
   517	      # -----------------------------------------------------------------
   518	      - name: Weekly workflow status gate (advisory health check + 14-day staleness, waiver-aware)
   519	        env:
   520	          GH_TOKEN: ${{ github.token }}
   521	        run: |
   522	          set -euo pipefail
   523	          TAG="${GITHUB_REF_NAME}"
   524	          VERSION="${TAG#v}"
