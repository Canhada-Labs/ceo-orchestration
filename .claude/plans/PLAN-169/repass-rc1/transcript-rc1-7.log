   142	def _state_dir(project_path: str) -> Path:
   143	    home = Path(os.environ.get("HOME") or "/tmp")
   144	    project_slug = project_path.replace("/", "-").strip("-") or "default"
   145	    return home / ".claude" / "projects" / project_slug / "state"
