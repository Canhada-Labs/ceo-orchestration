   612	def _render_constraints() -> List[str]:
   613	    """Return the pinned-constraint lines (PLAN-179 W1-b), or [] when disarmed.
   614	
   615	    The set is a CODE constant in ``_lib/pinned_constraints`` (amendment
   616	    r1-C5) — it is NOT snapshot-derived and therefore NOT sanitized here:
   617	    ``_sanitize_line`` exists to defang disk-sourced text, and applying it to
   618	    a code constant would only disguise where the trust boundary actually is.
   619	
   620	    Dedicated kill-switch ``CEO_CONSTRAINT_PINNING=0`` (PLAN-179 §8.8); import
   621	    or render failure degrades to [] with a breadcrumb (fail-OPEN on infra)."""
   622	    if os.environ.get("CEO_CONSTRAINT_PINNING", "1") == "0":
   623	        return []
   624	    try:
   625	        from _lib import pinned_constraints  # noqa: E402
   626	    except Exception as exc:  # pragma: no cover — import guard
   627	        _breadcrumb("pinned_constraints import failed (%s)" % str(exc)[:80])
   628	        return []
   629	    try:
   630	        return pinned_constraints.render_pinned_block()
   631	    except Exception as exc:  # pragma: no cover — belt-and-suspenders
   632	        _breadcrumb("render_pinned_block failed (%s)" % str(exc)[:80])
   633	        return []
   634	
   635	
   636	def _constraint_count() -> int:
   637	    """Pinned-set size for the audit counter (0 when the pinning is disarmed).
   638	
   639	    Counts the SET, not the rendered lines — the block carries a header line,
   640	    and a counter that drifts with formatting is not a counter.
   641	
   642	    PLAN-179 W0/W1 cross-file pass: ``pinned_constraints.constraint_count`` has
   643	    landed and is called directly; the return is coerced to ``int`` here rather
   644	    than trusted. That coercion is not defensive dressing — the value goes into
   645	    an HMAC-covered audit field, and a float (or any non-int) there is refused
   646	    by ``canonical_json`` and DISCARDS THE WHOLE EVENT, not just the field
   647	    ([[feedback-float-in-hmac-field-drops-whole-event]]). The bare ``except``
   648	    also stopped being silent: a missing module is an adopter on a
   649	    pre-PLAN-179 build, which is worth one line of stderr."""
   650	    if os.environ.get("CEO_CONSTRAINT_PINNING", "1") == "0":
   651	        return 0
   652	    try:
   653	        from _lib import pinned_constraints  # noqa: E402
   654	
   655	        return max(0, int(pinned_constraints.constraint_count()))
   656	    except Exception as exc:
   657	        _breadcrumb(
   658	            "pinned_constraints.constraint_count unavailable (%s) — "
   659	            "constraint_count reported as 0" % str(exc)[:80]
   660	        )
   661	        return 0
   662	
   663	
   664	def _emit_reinject_event(
   665	    plan_id: str,
   666	    snapshot_found: bool,
   667	    age_s: int,
   668	    pointer_count: int,
   669	    constraint_count: int,
   670	) -> None:
   671	    """Emit the closed-enum compaction_context_reinjected breadcrumb.
   672	
   673	    Closed enums + counters only — the pointer TEXT and the constraint TEXT
   674	    never hit the wire. Import-guarded; any failure swallowed (NEVER blocks on
   675	    audit infra).
   676	
   677	    PLAN-179 W1-b: ``constraint_count`` is a SEPARATE counter from
   678	    ``pointer_count`` (whose meaning is unchanged: pointers only). Until the
   679	    audit owner adds it to ``_COMPACTION_CONTEXT_REINJECTED_ALLOWLIST`` + the
   680	    SPEC row, the deny-by-default scrub DROPS it — the emit is written now so
   681	    the field lands the moment that ceremony runs, and so the drop shows up in
   682	    the scrub breadcrumb instead of being invisible."""
   683	    try:
   684	        from _lib import audit_emit  # noqa: E402
   685	    except Exception:
   686	        return
   687	    try:
   688	        audit_emit.emit_generic(
   689	            action="compaction_context_reinjected",
   690	            plan_id=plan_id,
   691	            snapshot_found=snapshot_found,
   692	            snapshot_age_s=age_s,
   693	            pointer_count=pointer_count,
   694	            constraint_count=constraint_count,
   695	        )
   696	    except Exception as exc:  # pragma: no cover — belt-and-suspenders
   697	        _breadcrumb("audit emit failed (%s)" % str(exc)[:80])
   698	
   699	
   700	def gate(event: Dict[str, Any]) -> Dict[str, Any]:
   701	    """Read the snapshot, build pointers, reinject via additionalContext.
   702	
   703	    Returns the hookSpecificOutput dict, or ``{}`` when nothing to reinject
   704	    (kill-switch / nothing to say — always allow, never block).
   705	
   706	    PLAN-179 W1-b [r1-C3]: CONSTRAINTS are emitted FIRST, then pointers. The
   707	    two lists are built independently — the pointer cap is applied inside
   708	    ``_build_pointers`` and never sees the constraint lines."""
   709	    if os.environ.get("CEO_COMPACTION_CONTINUITY", "1") == "0":
   710	        return {}
   711	    # Rail round-10 [P1]: uma compactação ACONTECEU — feche a geração de
   712	    # pressão antes de qualquer outra coisa (independe de haver snapshot).
   713	    _clear_pressure_marker(event)
   714	    plan_id = _resolve_plan_id(event)
   715	    # PLAN-179 W1 US3 [r1-C1]: session id from the HOOK INPUT only, for the
   716	    # session-scope fallback read (never CLAUDE_SESSION_ID).
   717	    snapshot = _read_snapshot(plan_id, _session_id(event))
   718	    age_s = _snapshot_age_s(snapshot)
   719	    constraints = _render_constraints()
   720	    pointers = _build_pointers(plan_id, snapshot, age_s)
   721	    # Rail round-8 [P2]: o contador reporta o que foi RENDERIZADO. Quando o
   722	    # render degrada para [] (fail-open em import/raise), reportar o tamanho
   723	    # do SET afirmaria constraints emitidas com additionalContext só de
   724	    # pointers — escondendo exatamente a degradação que o campo existe para
   725	    # expor. Zero a menos que o bloco tenha saído.
   726	    constraint_count = _constraint_count() if constraints else 0
   727	    _emit_reinject_event(
   728	        plan_id, snapshot is not None, age_s, len(pointers), constraint_count
   729	    )
   730	    lines = constraints + pointers
   731	    if not lines:
   732	        return {}
   733	    return {
   734	        "hookSpecificOutput": {
   735	            "hookEventName": "PostCompact",
   736	            "additionalContext": "\n".join(lines),
   737	        }
   738	    }
   739	
   740	
   741	def main() -> None:
   742	    try:
   743	        hook_input = json.loads(sys.stdin.read() or "{}")
   744	        if not isinstance(hook_input, dict):
   745	            raise ValueError("hook input is not a JSON object")
   746	    except Exception as exc:
   747	        # PLAN-091 S116: parse error is infra → breadcrumb + schema-compliant allow.
   748	        sys.stderr.write(
   749	            "# check_postcompact_reinject fail-open (stdin): %s\n" % str(exc)[:120]
   750	        )
   751	        print("{}")
   752	        return
   753	    try:
   754	        print(json.dumps(gate(hook_input)))
   755	    except Exception as exc:
   756	        sys.stderr.write(
   757	            "# check_postcompact_reinject fail-open: %s\n" % str(exc)[:120]
   758	        )
   759	        print("{}")
   760	
   761	
   762	if __name__ == "__main__":
   763	    main()
