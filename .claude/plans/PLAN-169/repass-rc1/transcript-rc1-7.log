   238	    def test_cli_keeps_the_module_a_leaf(self):
   239	        """The resolver must stay importable from any hook: stdlib only, no
   240	        ``_lib`` sibling imports (the CLI must not have smuggled one in)."""
   241	        tree = ast.parse(_RESOLVER_FILE.read_text(encoding="utf-8"))
   242	        for node in ast.walk(tree):
   243	            if isinstance(node, ast.ImportFrom):
   244	                self.assertFalse((node.module or "").startswith("_lib"), ast.dump(node))
   245	            elif isinstance(node, ast.Import):
   246	                for alias in node.names:
   247	                    self.assertFalse(alias.name.startswith("_lib"), alias.name)
