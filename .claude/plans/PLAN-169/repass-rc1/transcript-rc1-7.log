    64	_GRAPH_FILE_RE = re.compile(
    65	    r"^(PLAN-\d{3})-(\d{8}T\d{6}Z)\.json(?:\.age|\.gpg|\.plain\.json)?$"
    66	)
    67	FRESH_GRAPH_WINDOW = timedelta(hours=24)
    68	
    69	
