  1362	      - name: Run profile-opus-4-7.py --smoke
  1363	        run: |
  1364	          set -euo pipefail
  1365	          # 30s budget enforced by --budget-seconds; non-zero exit on overrun
  1366	          # E12-F3 fix: script now also exits non-zero if any check.passed=false
  1367	          python3 .claude/scripts/profile-opus-4-7.py --smoke --budget-seconds 30
  1368	          echo "✓ opus-4-7 profiler smoke green (all checks passed)"
  1369	
  1370	      - name: Run profile-opus-4-7.py --hook-latency (p95/p99 gate)
  1371	        run: |
  1372	          set -euo pipefail
  1373	          # PLAN-159 / ADR-163: N=200 warm iterations (percentile stability).
  1374	          # At N=20 the nearest-rank index collapsed (int((n-1)*p/100) gives
  1375	          # idx_p95 == idx_p99 == 18 -> both ceilings gated the SAME
  1376	          # 2nd-largest sample; p99 was dead code) and 2 contended
  1377	          # iterations out of 20 failed the gate: 8 load-flakes S272/S273
  1378	          # on doc-only commits. At N=200, p95 (rank 190) tolerates 10
  1379	          # outliers and p99 (rank 198) gates independently. The profiler
  1380	          # itself now fail-louds on a collapsed index (minimum N=22).
  1381	          # Ceilings (ADR-163 §Amendment S318): p95<180ms HARD (recalibrated
  1382	          # from the 2026-07 value of 120ms — on 2026-08-20 an unloaded
  1383	          # runner measured the heaviest entry at p95 110.6ms, an 8% margin,
  1384	          # while the local baseline held at 70.6ms: the runner shifted, not
  1385	          # the hooks; N=1000 perf-profile artifacts show the whole
  1386	          # distribution moving 1.5-2.3x between runner windows). p99 is
  1387	          # ADVISORY (--p99-advisory): a p99 breach is echoed as WARN and
  1388	          # lands in the step summary, but never fails the gate — on a
  1389	          # shared runner the extreme tail prices the runner, not the code
  1390	          # (the run of 2026-08-20 19:54Z failed ONLY on p99 177ms with p95
  1391	          # within budget; same evidence class as the W2.2 median-on-CI
  1392	          # decision). The advisory sibling test_hook_latency.py already
  1393	          # samples N=200. Detection stays per-entry vs the ABSOLUTE p95
  1394	          # ceiling — ADR-163 §Detection contract.
  1395	          #
  1396	          # Retry contract (ADR-163 invariant, §Amendment PLAN-161 C4 —
  1397	          # 2 unconditional attempts + inter-attempt backoff + AT MOST
  1398	          # one probe-gated 3rd attempt; never unbounded): contention is
  1399	          # bursty, so each retry relocates the measurement to a fresh
  1400	          # scheduler window, and a sleep of CEO_PERF_GATE_BACKOFF_S
  1401	          # (default 60s) between windows defends against SUSTAINED load
  1402	          # (two doc-only commits defeated the back-to-back 2-attempt
  1403	          # shape). After a double failure an explicit contention
  1404	          # pre-probe (30s-capped --floor run; verdict: nonzero exit or
  1405	          # malformed JSON => CONTENDED fail-safe, else p50<=200ms =>
  1406	          # UNCONTENDED) decides: a still-contended VM fail-fasts with a
  1407	          # distinct infrastructure label and NO 3rd attempt; an
  1408	          # uncontended VM earns exactly one 3rd attempt whose failure
  1409	          # IS the regression verdict. Each attempt stays wall-capped
  1410	          # (coreutils timeout 420s ~= 5.5x the 77s local N=200 cost);
  1411	          # every failure path is an explicit exit 1 (fail-closed; NOT
  1412	          # continue-on-error, no third-party retry action). Attempt
  1413	          # percentiles go to the step summary whenever the attempt
  1414	          # leaves a parseable report — a cap-killed attempt that leaves
  1415	          # none is NOTED explicitly — so green-on-retry drift stays
  1416	          # visible. Truth table proven case-by-case by
  1417	          # .claude/plans/PLAN-161/proof-retry-matrix.sh (the script's
  1418	          # run_case list is the canonical case inventory).
  1419	          run_gate() {
  1420	            timeout 420 python3 .claude/scripts/profile-opus-4-7.py \
  1421	              --hook-latency \
  1422	              --latency-iterations 200 \
  1423	              --p95-ceiling-ms 180 \
  1424	              --p99-ceiling-ms 160 \
  1425	              --exec-reference \
  1426	              --relative-advisory \
  1427	              --p99-advisory > "/tmp/hook-latency-attempt-$1.json"
  1428	          }
  1429	          publish() {
  1430	            # Advisory logging only — never gates (any failure tolerated).
  1431	            # A cap-killed (124) attempt may leave no report: that case is
  1432	            # NOTED explicitly in the summary, never silently skipped
  1433	            # (pair-rail round-1 finding #3b).
  1434	            python3 - "$1" <<'PYSUM' || true
  1435	          import json, os, sys
  1436	          att = sys.argv[1]
  1437	          out = os.environ.get("GITHUB_STEP_SUMMARY")
  1438	          def note(text):
  1439	              if out:
  1440	                  with open(out, "a") as f:
  1441	                      f.write(text + "\n")
  1442	          try:
  1443	              with open(f"/tmp/hook-latency-attempt-{att}.json") as f:
  1444	                  d = json.load(f)
  1445	          except Exception:
  1446	              note(f"hook-latency attempt {att}: NO parseable report (a 420s cap-killed attempt leaves none)")
  1447	              sys.exit(0)
  1448	          # ADR-163 S318: the summary carries the p99 advisory verdict per
  1449	          # entry — a green job with a breached (advisory) p99 must be
  1450	          # visible here, not only in the CLI WARN line.
  1451	          def p99cell(h):
  1452	              if "p99_within" not in h:
  1453	                  return str(h.get("p99_ms"))
  1454	              return f"{h.get('p99_ms')} ({'ok' if h.get('p99_within') else 'BREACH-advisory'})"
  1455	          rows = [f"| attempt {att}: {name} | {h.get('p50_ms')} | {h.get('p95_ms')} | {p99cell(h)} | {h.get('max_ms')} |"
  1456	                  for name, h in d.get("hooks", {}).items() if isinstance(h, dict) and "p95_ms" in h]
  1457	          if rows:
  1458	              mode = "advisory" if d.get("p99_advisory") else "hard"
  1459	              note(f"hook-latency attempt {att}: p95 ceiling {d.get('p95_ceiling_ms')}ms hard / p99 {d.get('p99_ceiling_ms')}ms {mode}")
  1460	              note(f"hook-latency attempt {att}: second key phase={d.get('phase','-')} verdict={d.get('verdict_label','-')} — " + " | ".join(f"{n}: {h.get('verdict_label','-')} ref_p50={h.get('ref_p50_ms','-')}ms R_e={h.get('R_e','-')}" for n, h in d.get("hooks", {}).items() if isinstance(h, dict) and "p95_ms" in h))
  1461	              note("| hook-latency entry | p50 | p95 | p99 | max (ms) |")
  1462	              note("|---|---|---|---|---|")
  1463	              note("\n".join(rows))
  1464	          else:
  1465	              note(f"hook-latency attempt {att}: report parsed but carries no per-hook stats (early-error report: {str(d.get('error','?'))[:120]})")
  1466	          PYSUM
  1467	          }
  1468	          BACKOFF_S="${CEO_PERF_GATE_BACKOFF_S:-60}"
  1469	          probe_floor_raw() {
  1470	            timeout 30 python3 .claude/scripts/profile-opus-4-7.py --floor 2>/dev/null
  1471	          }
  1472	          contention_probe() {
  1473	            # Contention verdict (ADR-163 §Amendment, PLAN-161 C4): the
  1474	            # floor probe's EXIT STATUS overrides apparently-uncontended
  1475	            # JSON (codex r4 F4; covers timeout rc 124); else p50<=200ms
  1476	            # (boundary == is UNCONTENDED) parsed fail-safe: malformed
  1477	            # output reads as CONTENDED, never as permission to retry.
  1478	            # p50 must be a REAL JSON number (int/float, never bool), finite
  1479	            # and >= 0 — true/"-1"/-Infinity coercions read as CONTENDED
  1480	            # (codex r1 F8).
  1481	            local probe_out="" probe_rc=0
  1482	            probe_out="$(probe_floor_raw)" || probe_rc=$?
  1483	            if [ "$probe_rc" -ne 0 ]; then
  1484	              echo "contention probe: floor probe exited $probe_rc (124 = 30s cap) -> CONTENDED (exit status overrides JSON)"
  1485	              return 1
  1486	            fi
  1487	            CEO_PROBE_JSON="$probe_out" python3 - <<'PYPROBE'
  1488	          import json, math, os, sys
  1489	          try:
  1490	              p50 = json.loads(os.environ.get("CEO_PROBE_JSON", ""))["subprocess_floor_ms"]["p50"]
  1491	          except Exception as e:
  1492	              print(f"contention probe: floor JSON unparseable ({type(e).__name__}) -> CONTENDED (fail-safe)")
  1493	              sys.exit(1)
  1494	          if isinstance(p50, bool) or not isinstance(p50, (int, float)) \
  1495	                  or not math.isfinite(p50) or p50 < 0:
  1496	              print(f"contention probe: floor p50 is not a finite non-negative JSON number ({p50!r}) -> CONTENDED (fail-safe; codex r1 F8)")
  1497	              sys.exit(1)
  1498	          if p50 <= 200:
  1499	              print(f"contention probe: subprocess floor p50={p50}ms <= 200ms -> UNCONTENDED")
  1500	              sys.exit(0)
  1501	          print(f"contention probe: subprocess floor p50={p50}ms > 200ms -> CONTENDED")
  1502	          sys.exit(1)
  1503	          PYPROBE
  1504	          }
