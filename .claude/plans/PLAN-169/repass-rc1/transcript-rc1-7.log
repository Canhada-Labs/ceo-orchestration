   164	              [[ -z "$v" ]] && continue
   165	              if [[ "$v" != "$FILE" ]]; then
   166	                echo "::error::.claude-plugin/marketplace.json carries version '$v' != VERSION ('$FILE')"
   167	                BAD=1
   168	              fi
   169	            done < <(jq -r '.. | objects | .version? // empty' .claude-plugin/marketplace.json)
   170	            if [[ "$BAD" -ne 0 ]]; then
   171	              exit 1
   172	            fi
   173	            echo "OK: every marketplace.json version field matches VERSION"
   174	          else
   175	            echo "::notice::.claude-plugin/marketplace.json not present — skipping"
   176	          fi
   177	
   178	      # -----------------------------------------------------------------
   179	      # F5 — RC-hold / staleness waiver SUNSET assertion.
   180	      #
     1	# PLAN-153 Wave E item 4 — scheduled supply-chain watch (NEW workflow).
     2	#
     3	# Two watch axes, weekly:
     4	#   (a) workflow policy — SHA-pin format across ALL workflows + policy
     5	#       assertions (no pull_request_target, no unguarded fork-reachable
     6	#       secrets) + tag-comment drift vs upstream, via the extended
     7	#       `.claude/scripts/check-action-sha-drift.py --policy --strict`.
     8	#   (b) npm provenance — the latest published `ceo-orchestration` version
     9	#       still carries a SLSA provenance attestation on the npm registry,
    10	#       still corresponds to a tag in THIS repo, and `npm audit
    11	#       signatures` still verifies (honest-limits note inline below).
    12	# On any red: create/update a SINGLE pinned issue (idempotent, searched
    13	# by label — reality-ledger.yml / ADR-064 precedent) and red the run.
    14	#
    15	# Security envelope (mirrors reality-ledger.yml §4.5 precedent):
    16	#   1. Triggers: schedule + workflow_dispatch ONLY. NEVER pull_request /
    17	#      pull_request_target — nothing here is fork-reachable (would also
    18	#      be self-contradictory: axis (a) enforces exactly that policy).
    19	#   2. Permissions: contents:read baseline; issues:write exists SOLELY
    20	#      for the red-path pinned issue. No other write surface.
    21	#   3. All `uses:` SHA-pinned; checkout persist-credentials:false.
    22	#   4. Zero secrets.* except the ambient GITHUB_TOKEN (gh api + issue).
    23	#      npm registry queries are unauthenticated public reads.
    24	#   5. CEO_SOTA_DISABLE honored at job level (_README.md §R8).
    25	#   6. timeout-minutes bounded; concurrency no-cancel (cron precedent).
    26	
    27	name: supply-chain-watch
    28	
    29	on:
    30	  workflow_dispatch:
    31	  schedule:
    32	    # Monday 19:23 UTC — 19:00 band is a free slot per the
    33	    # .github/workflows/_README.md stagger table (next-free list
    34	    # 00/19/20/22/01/02); off-:00 minute because GitHub delays/drops
    35	    # scheduled runs queued at high-load minute 0.
    36	    - cron: "23 19 * * 1"
    37	
    38	permissions:
    39	  contents: read
    40	  issues: write
    41	
    42	concurrency:
    43	  group: supply-chain-watch-main
    44	  cancel-in-progress: false
    45	
    46	jobs:
    47	  watch:
    48	    name: Supply-chain watch (weekly, advisory-red)
    49	    # CEO_SOTA_DISABLE parity per _README.md §R8 + fork belt-and-braces
    50	    # (scheduled workflows are disabled on forks by default; keep the
    51	    # guard anyway per reality-ledger.yml precedent).
    52	    if: vars.CEO_SOTA_DISABLE != '1' && github.event.repository.fork == false
    53	    runs-on: ubuntu-latest
    54	    timeout-minutes: 15
    55	    steps:
    56	      - name: Checkout
    57	        uses: actions/checkout@de0fac2e4500dabe0009e67214ff5f5447ce83dd  # v6.0.2
    58	        with:
    59	          fetch-depth: 1
    60	          persist-credentials: false
    61	
    62	      - name: Set up Python
    63	        uses: actions/setup-python@a309ff8b426b58ec0e2a45f0f869d46889d02405  # v6.2.0
    64	        with:
    65	          python-version: "3.12"
    66	
    67	      - name: Workflow policy + SHA-pin drift (axis a)
    68	        id: policy
    69	        env:
    70	          # Authenticated tag-dereference (5000 req/hr) for the drift
    71	          # pass — read-only use of the ambient token.
    72	          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
    73	        run: |
    74	          set -uo pipefail
    75	          # rc semantics from the script: 0 green; 1 format/policy
    76	          # violation; 2 tag-comment drift under --strict OR network
    77	          # failure. In a weekly watch we treat ANY nonzero as red —
    78	          # upstream-tag drift IS the action-compromise tripwire, and a
    79	          # network fail-red is the fail-closed direction (noted in the
    80	          # issue body so triage can dismiss transient network reds).
    81	          python3 .claude/scripts/check-action-sha-drift.py --policy --strict
    82	          RC=$?
    83	          echo "rc=$RC" >> "$GITHUB_OUTPUT"
    84	          echo "axis (a) policy/pin/drift rc=$RC"
    85	          exit 0
    86	
    87	      - name: npm SLSA provenance chain (axis b)
    88	        id: provenance
    89	        env:
    90	          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
    91	        run: |
    92	          set -uo pipefail
    93	          # HONEST LIMITS — what this step does and does NOT prove:
    94	          #   * Proves: the npm registry still SERVES a SLSA provenance
    95	          #     attestation for the latest published version; that
    96	          #     version corresponds to a tag in THIS repo; and
    97	          #     `npm audit signatures` verifies the registry signature +
    98	          #     attestation for the fetched tarball.
    99	          #   * Does NOT prove the tarball content matches this repo's
   100	          #     source tree (no rebuild/diff here).
   101	          #   * Does NOT stop a compromised npm account publishing a NEW
   102	          #     version WITH valid provenance from a compromised
   103	          #     workflow — the tag-correspondence check below is only a
   104	          #     partial tripwire for that class.
   105	          #   * `npm audit signatures` is thin for ceo-orchestration
   106	          #     anyway: zero runtime deps means the "audit" covers
   107	          #     exactly one package — there is no dependency tree whose
   108	          #     signatures add coverage.
   109	          RC=0
   110	          PKG="ceo-orchestration"  # rp-allow: product-label (npm package name)
   111	
   112	          # (1) Latest published version straight from the registry.
   113	          LATEST=$(curl -fsS --max-time 30 "https://registry.npmjs.org/${PKG}" \
   114	            | python3 -c 'import json,sys; print(json.load(sys.stdin)["dist-tags"]["latest"])') || LATEST=""
   115	          if [ -z "$LATEST" ]; then
   116	            echo "::error::axis (b): could not resolve npm dist-tags.latest for ${PKG}"
   117	            RC=1
   118	          else
   119	            echo "npm latest: ${PKG}@${LATEST}"
   120	
   121	            # (2) SLSA provenance attestation still present.
   122	            PREDICATES=$(curl -fsS --max-time 30 \
   123	              "https://registry.npmjs.org/-/npm/v1/attestations/${PKG}@${LATEST}" \
   124	              | python3 -c 'import json,sys; d=json.load(sys.stdin); print("\n".join(a.get("predicateType","") for a in d.get("attestations",[])))') || PREDICATES=""
   125	            if printf '%s\n' "$PREDICATES" | grep -q "slsa.dev/provenance"; then
   126	              echo "OK: SLSA provenance attestation present for ${PKG}@${LATEST}"
   127	            else
   128	              echo "::error::axis (b): NO SLSA provenance attestation on ${PKG}@${LATEST} (predicates: ${PREDICATES:-none}) — regression vs npm-publish.yml --provenance"
   129	              RC=1
   130	            fi
   131	
   132	            # (3) Latest npm version must correspond to a tag in THIS
   133	            # repo (partial hijacked-publish tripwire).
   134	            if gh api "repos/${GITHUB_REPOSITORY}/git/ref/tags/v${LATEST}" >/dev/null 2>&1; then
   135	              echo "OK: tag v${LATEST} exists in ${GITHUB_REPOSITORY}"
   136	            else
   137	              echo "::error::axis (b): npm ${PKG}@${LATEST} has NO corresponding tag v${LATEST} in ${GITHUB_REPOSITORY} — possible out-of-band publish"
   138	              RC=1
   139	            fi
   140	
   141	            # (4) Latest GitHub release recorded for cross-reference in
   142	            # the summary (advisory only: release may legitimately lead
   143	            # npm while the production-npm manual gate is pending).
   144	            REL_TAG=$(gh api "repos/${GITHUB_REPOSITORY}/releases/latest" --jq .tag_name 2>/dev/null || echo "unknown")
   145	            echo "latest GitHub release: ${REL_TAG}"
   146	
   147	            # (5) Registry signature + attestation verification.
   148	            # --ignore-scripts: NEVER execute lifecycle scripts of the
   149	            # fetched package, even our own (defense in depth).
   150	            WORKDIR=$(mktemp -d)
   151	            (
   152	              cd "$WORKDIR" || exit 1
   153	              npm init -y >/dev/null 2>&1
   154	              npm install "${PKG}@${LATEST}" --ignore-scripts --no-audit --no-fund >/dev/null 2>&1 \
   155	                && npm audit signatures
   156	            )
   157	            SIG_RC=$?
   158	            if [ "$SIG_RC" -ne 0 ]; then
   159	              echo "::error::axis (b): npm audit signatures failed (rc=${SIG_RC}) for ${PKG}@${LATEST}"
   160	              RC=1

