   255	    root = Path(root)
   256	    home = root / "home"
   257	    audit = home / ".claude" / "projects" / "ceo-orchestration"
   258	    state = audit / "state"
   259	    overrides = {
   260	        "HOME": str(home),
   261	        "CEO_AUDIT_LOG_DIR": str(audit),
   262	        "CEO_PROJECT_STATE_DIR": str(state),
   263	        TEST_HARNESS_VAR: "1",
