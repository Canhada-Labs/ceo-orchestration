     6	    branches: [main]
     7	  # PLAN-184 A0 — BACKSTOP do corte da matriz de Python no `push`.
     8	  # Medido ANTES de cortar: 100% dos runs deste workflow na janela
     9	  # vieram de `push` (por evento: {'push': 167}) e NAO existia
    10	  # `schedule:` nenhum. Sem este cron, remover 3.10/3.11 do `push`
    11	  # seria PERDA de cobertura, nao atraso de deteccao: as duas versoes
    12	  # deixariam de ser exercitadas em QUALQUER gatilho.
    13	  # O minuto e off-mark de proposito (nao :00/:30).
    14	  schedule:
    15	    - cron: "37 7 * * *"
    16	
    17	# Cancel in-progress runs when a newer commit lands on the same ref.
    18	# Prevents duplicate compute on rapid-fire PR updates and matches the
    19	# devops-ci-cd skill's concurrency-control mandate.
    20	#
    21	# rc.1 re-pass round 2, part 4 — the group carries the EVENT NAME because
    22	# `schedule` and `push` share `github.ref` on the default branch: both are
    23	# `refs/heads/main`. With one group and `cancel-in-progress: true`, a push
    24	# to main during the nightly CANCELLED it, and the replacement run is a
    25	# `push` run — which the matrix above deliberately narrows to 3.9 and 3.12.
    26	# The A0 backstop exists precisely so 3.10/3.11 stay covered on this branch;
    27	# sharing the group is what silently spent that coverage. (`pull_request`
    28	# never collided: its ref is `refs/pull/<n>/merge`.)
    29	concurrency:
    30	  group: validate-${{ github.event_name }}-${{ github.ref }}
    31	  cancel-in-progress: true
