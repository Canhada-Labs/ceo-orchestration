# Fresh install of profile core into a brand-new scratch target. Echoes the path.
fresh_install() {
  local prof="${1:-core}"
  local t
  t="$( mktemp -d "$WORKROOT/tgt-XXXXXX" )"
  _git_init_retry "$t"
  if ! bash "$SOURCE_DIR/scripts/install.sh" "$t" --profile "$prof" >"$t/.install.log" 2>&1; then
