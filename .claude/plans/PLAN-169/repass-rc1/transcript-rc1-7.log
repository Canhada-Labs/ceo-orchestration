  1339	  # ===========================================================================
  1340	  opus-4-7-profiler-smoke:
  1341	    if: vars.CEO_SOTA_DISABLE != '1'
  1342	    runs-on: ubuntu-latest
  1343	    # PLAN-159/ADR-163 (amended PLAN-161 C4): sized for the WORST case —
  1344	    # 3x420s (capped attempts) + 2x60s (backoffs) + 30s (probe cap) +
  1345	    # 30s (floor-sanity cap) + ~180s (checkout/setup/smoke headroom)
  1346	    # ~= 1620s ~= 27min -> 28. Both 30s terms are ENFORCED `timeout 30`
  1347	    # wall-caps (probe_floor_raw + the floor-sanity step; codex r3 F4).
  1348	    timeout-minutes: 28
