   244	def audit_carrier_overrides(root: Path, *, sync_mode: bool = False) -> Dict[str, str]:
   245	    """Return the carrier env vars to SET so the FULL audit/HMAC surface resolves
   246	    under ``root`` (an isolated tmp tree), plus the sticky test signals.
