    51	      # a drifted member never gets to vote on its own integrity.
    52	      # release.sh has no CI surface that runs it; its entry here is the
    53	      # post-hoc check (the tagged tree's driver matched the manifest).
    54	      # -----------------------------------------------------------------
    55	      - name: Gate-scripts integrity (W2.8 checksum manifest)
    56	        run: |
    57	          set -euo pipefail
    58	          M=.claude/governance/gate-scripts-manifest.txt
    59	          if [[ ! -f "$M" ]]; then
    60	            echo "::error::$M missing — the W2.8 gate-scripts manifest is a canonical tracked file"
    61	            exit 1
    62	          fi
    63	          if ! shasum -a 256 -c "$M"; then
    64	            echo "::error::gate-script drift: a release-critical script does not match $M (ADR-192). Legitimate edits to a member go through the canonical-edit ceremony that updates the manifest."
    65	            exit 1
    66	          fi
    67	          echo "OK: all gate scripts match $M"
    68	
    69	      # -----------------------------------------------------------------
    70	      # PLAN-153 Wave B item 5 (c) — RC-aware VERSION↔tag comparison.
    71	      # Closes PLAN-152 §Deferred `release-gate-rc-version-mismatch`
    72	      # (red run 28663453202 precedent).
    73	      #
    74	      # THE RC FLOW (documented so this never regresses): an RC tag
    75	      # `v<X.Y.Z>-rc.N` is cut from a tree whose VERSION file ALREADY
    76	      # reads the GA value `X.Y.Z` — the `-rc.N` pre-release suffix
    77	      # exists only in the tag name, never in the VERSION file. (The
    78	      # 24h RC-hold gate below encodes the same convention: it derives
    79	      # the RC tag family `v${VERSION}-rc.*` from the GA VERSION.)
    80	      # The old comparison (`FILE != TAG#v`) therefore hard-failed
    81	      # every RC tag's own release run: `v1.0.1-rc.1` vs
    82	      # `VERSION=1.0.1`. Fix: strip a trailing `-rc.<digits>` from the
    83	      # tag before comparing. GA tags are unaffected (nothing to
    84	      # strip); a wrong-version RC (`v1.0.2-rc.1` on `VERSION=1.0.1`)
    85	      # still hard-fails.
    86	      # -----------------------------------------------------------------
    87	      - name: Assert VERSION matches tag
