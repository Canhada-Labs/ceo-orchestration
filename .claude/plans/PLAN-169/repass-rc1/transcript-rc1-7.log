   160	def _list_recent_state_files(
   161	    project_path: str, user_id: str, n_days: int, today: Optional[_date_cls] = None
   162	) -> list:
   163	    """Return list of (date_iso, Path) for the last `n_days` UTC dates.
   164	
   165	    Used by weekly / monthly window aggregation. Missing files are
   166	    silently skipped (zero contribution). Sorted oldest → newest.
   167	    """
   168	    from datetime import timedelta
   169	    d_today = today or datetime.now(timezone.utc).date()
   170	    out = []
   171	    for delta in range(n_days):
   172	        d = d_today - timedelta(days=delta)
   173	        diso = d.isoformat()
   174	        p = _state_path_for(project_path, user_id, diso)
   175	        if p.is_file():
   176	            out.append((diso, p))
   177	    out.sort()
   178	    return out
