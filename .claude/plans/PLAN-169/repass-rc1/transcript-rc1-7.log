   157	            echo "::error::.claude-plugin/plugin.json version ('$PLUGIN_V') does not match VERSION ('$FILE')"
   158	            exit 1
   159	          fi
   160	          echo "OK: plugin.json version=$PLUGIN_V matches VERSION"
