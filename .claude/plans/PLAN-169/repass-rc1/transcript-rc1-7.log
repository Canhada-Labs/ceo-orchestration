   405	def _snapshot_age_s(snapshot: Optional[Dict[str, Any]]) -> int:
   406	    if not snapshot:
   407	        return 0
   408	    try:
   409	        return max(0, int(time.time() - float(snapshot.get("ts", 0))))
   410	    except (TypeError, ValueError):
   411	        return 0
