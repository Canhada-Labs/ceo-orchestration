   163	def lint_file(path: str, rel: str, git_mode: Optional[str]) -> List[dict]:
   164	    findings: List[dict] = []
   165	    try:
   166	        with open(path, errors="replace") as fh:
   167	            body = fh.read()
   168	    except OSError as exc:
   169	        return [{"rule": "R0", "sev": "BLOCKING", "line": 0,
   170	                 "msg": f"ilegível ({exc}) — input fail-closed"}]
   171	    lines = body.splitlines()
   172	
   173	    if PROVENANCE_MARK not in body and EXCEPTION_MARK not in body:
   174	        findings.append({"rule": "R1", "sev": "BLOCKING", "line": 1,
   175	                         "msg": "sem marca AUTO-GENERATED e sem exceção explícita"})
   176	    for i, ln in enumerate(lines, 1):
   177	        if OR_TRUE_RE.search(ln):
   178	            if IRREVERSIBLE_RE.search(ln):
   179	                findings.append({"rule": "R2", "sev": "BLOCKING", "line": i,
   180	                                 "msg": "`|| true` sobre operação remota irreversível"})
   181	            else:
   182	                findings.append({"rule": "R2a", "sev": "ADVISORY", "line": i,
   183	                                 "msg": "`|| true` cru"})
   184	        if GREP_TAIL_RE.search(ln):
   185	            findings.append({"rule": "R3", "sev": "BLOCKING", "line": i,
   186	                             "msg": "grep|tail em parsing de VERDICT"})
   187	        if GIT_ADD_DIR_RE.search(ln):
   188	            findings.append({"rule": "R4", "sev": "BLOCKING", "line": i,
   189	                             "msg": "git add de diretório"})
   190	        if CP_MV_VARDEST_RE.search(ln):
   191	            ctx = "\n".join(lines[max(0, i - 6):i - 1])
   192	            if not SYMLINK_TEST_RE.search(ctx):
   193	                findings.append({"rule": "R5", "sev": "ADVISORY", "line": i,
   194	                                 "msg": "cp/mv p/ destino em variável sem teste -L próximo"})
   195	        if SHASUM_C_RE.search(ln):
   196	            ctx = "\n".join(lines[max(0, i - 4):min(len(lines), i + 3)])
   197	            if not SET_EQ_NEAR_RE.search(ctx):
   198	                findings.append({"rule": "R6", "sev": "ADVISORY", "line": i,
   199	                                 "msg": "shasum -c sem asserção de conjunto (set-equality)"})
   200	    # R8 só na superfície de binding assinado (.claude/plans/): exec-bit
   201	    # em ferramenta de scripts/local/ é legítimo (invocada diretamente).
   202	    if git_mode == "100755" and rel.startswith(".claude/plans/"):
   203	        findings.append({"rule": "R8", "sev": "BLOCKING", "line": 0,
   204	                         "msg": "exec-bit no índice git (modo 100755)"})
   205	    return findings
