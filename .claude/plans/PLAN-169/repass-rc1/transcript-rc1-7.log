   123	            capture_output=True, text=True, timeout=30, check=False,
   124	        ).stdout
   125	    except Exception:
   126	        return {}
   127	    modes: Dict[str, str] = {}
   128	    for line in out.splitlines():
   129	        parts = line.split(None, 3)
   130	        if len(parts) == 4:
   131	            modes[parts[3]] = parts[0]
