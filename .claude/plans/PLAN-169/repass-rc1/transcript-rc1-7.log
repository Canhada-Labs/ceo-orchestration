   179	class SqliteStateStore:
   180	    """Plan-scoped key/value store backed by a single sqlite file.
   181	
   182	    Not thread-safe within a process (callers should open one store per
   183	    thread). Cross-process safety is provided by the sibling filelock.
   184	
   185	    Args:
   186	        store_name: short slug identifying the store (e.g. "scratchpad").
   187	        plan_id: canonical PLAN-NNN string scoping the data.
   188	        value_max_bytes: per-key cap. Default 64 KiB.
   189	        lock_timeout: filelock wallclock budget. Default 5.0s.
   190	
   191	    Raises:
   192	        StateStoreInvalidName: if store_name or plan_id fail validation.
   193	    """
   194	
   195	    def __init__(
   196	        self,
   197	        store_name: str,
   198	        plan_id: str,
   199	        value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   200	        lock_timeout: float = _LOCK_TIMEOUT_SEC,
   201	        *,
   202	        clock: Optional[Callable[[], float]] = None,
   203	    ) -> None:
   204	        _validate_store_name(store_name)
   205	        _validate_plan_id(plan_id)
   206	        self.store_name = store_name
   207	        self.plan_id = plan_id
   208	        self.value_max_bytes = int(value_max_bytes)
   209	        self.lock_timeout = float(lock_timeout)
   210	        # PLAN-045 Wave 2 F-03-04: injectable clock so TTL tests can
   211	        # fast-forward instead of sleeping. Default: wall clock.
   212	        self._clock: Callable[[], float] = clock if clock is not None else time.time
   213	
   214	        self._store_dir = _state_root() / store_name
   215	        self._db_path = self._store_dir / f"{plan_id}.sqlite"
   216	        self._lock_path = self._store_dir / f"{plan_id}.sqlite.lock"
   217	
   218	        self._conn: Optional[sqlite3.Connection] = None
   219	        self._opened = False
   220	        self._db_ident = None  # (st_dev, st_ino) of the open db — round-11 [P2]
   221	
   222	    def _ensure_open(self) -> None:
   223	        if self._opened:
   224	            return
   225	        self._store_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
   226	        # sqlite connect will create the file if absent
   227	        self._conn = sqlite3.connect(
   228	            str(self._db_path),
   229	            timeout=self.lock_timeout,
   230	            isolation_level=None,  # autocommit; we manage transactions via BEGIN/COMMIT
   231	        )
   232	        # Tight file perms — owner-only
   233	        try:
   234	            os.chmod(self._db_path, 0o600)
   235	        except OSError:
   236	            pass
   237	        self._conn.execute("PRAGMA journal_mode=WAL")
   238	        self._conn.execute("PRAGMA synchronous=NORMAL")
   239	        self._conn.execute("PRAGMA temp_store=MEMORY")
   240	        self._conn.execute(
   241	            """
   242	            CREATE TABLE IF NOT EXISTS kv (
   243	                key TEXT PRIMARY KEY,
   244	                value BLOB NOT NULL,
   245	                expires_at INTEGER,           -- epoch seconds, NULL = no expiry
   246	                created_at INTEGER NOT NULL,  -- epoch seconds
   247	                redacted INTEGER NOT NULL     -- 1 if redact_secrets changed the value
   248	            )
   249	            """
   250	        )
   251	        self._conn.execute("CREATE INDEX IF NOT EXISTS idx_kv_expires ON kv(expires_at)")
   252	        # Identity of the inode this connection targets (rail round-11 [P2]):
   253	        # `_reopen_if_vanished` compares against it UNDER the lock to detect
   254	        # both absence and REPLACEMENT of the db file by another handle.
   255	        try:
   256	            _st = os.stat(self._db_path)
   257	            self._db_ident = (_st.st_dev, _st.st_ino)
   258	        except OSError:
   259	            self._db_ident = None
   260	        self._opened = True
   261	
   262	    # --- context manager --------------------------------------------------
   263	
   264	    def _reopen_if_vanished(self) -> None:
   265	        """GC coordination — MUST be called UNDER the FileLock.
   266	
   267	        PLAN-179 rail round-10 [P1]: the continuity GC unlinks aged session
   268	        stores while holding this same lock, and `_ensure_open` runs BEFORE
   269	        lock acquisition — so a connection opened earlier (or cached across
   270	        operations) can point at an UNLINKED inode; committing there loses
   271	        the write invisibly. Under the lock the check is race-free: if the
   272	        db identity is unchanged now, the GC cannot remove it until we
   273	        release; otherwise reopening lands the write on disk.
   274	
   275	        Rail round-11 [P2]: absence alone is NOT the whole signal. With two
   276	        handles opened before a GC unlink, the first reopen RECREATES the
   277	        path, so the second handle would see it existing while its own
   278	        connection still targets the dead inode. The identity compared is
   279	        therefore ``(st_dev, st_ino)`` captured at open time, which detects
   280	        REPLACEMENT as well as absence."""
   281	        if not self._opened:
   282	            return
   283	        try:
   284	            st = os.stat(self._db_path)
   285	            current = (st.st_dev, st.st_ino)
   286	        except OSError:
   287	            current = None
   288	        if current is not None and current == self._db_ident:
   289	            return
   290	        try:
   291	            if self._conn is not None:
   292	                self._conn.close()
   293	        except Exception:
   294	            pass
   295	        self._conn = None
   296	        self._opened = False
   297	        self._ensure_open()
   298	
   299	    def __enter__(self) -> "SqliteStateStore":
   300	        self._ensure_open()
   301	        return self
   302	
   303	    def __exit__(
   304	        self,
   305	        exc_type: Optional[Type[BaseException]],
   306	        exc_val: Optional[BaseException],
   307	        exc_tb: Optional[TracebackType],
   308	    ) -> None:
   309	        self.close()
   310	
   311	    def close(self) -> None:
   312	        """Close the connection. Idempotent."""
   313	        if self._conn is not None:
   314	            try:
   315	                self._conn.close()
   316	            except sqlite3.Error:
   317	                pass
   318	            self._conn = None
   319	        self._opened = False
   320	
   321	    # --- primary operations -----------------------------------------------
   322	
   323	    def set(
   324	        self,
   325	        key: str,
   326	        value: Union[str, bytes],
   327	        ttl_seconds: Optional[int] = None,
   328	    ) -> None:
   329	        """Write a key/value pair with optional TTL.
   330	
   331	        Args:
   332	            key: free-form string key. No length cap enforced at this layer;
   333	                sqlite TEXT PK handles it.
   334	            value: str (redacted before write) or bytes (stored as-is).
   335	            ttl_seconds: None = no expiry; positive int = seconds from now.
   336	
   337	        Raises:
   338	            StateStoreValueTooLarge: if value exceeds ``value_max_bytes``.
   339	            ValueError: if ttl_seconds is negative or zero.
   340	        """
   341	        self._ensure_open()
   342	        assert self._conn is not None  # for type-checker
   343	
   344	        if ttl_seconds is not None and ttl_seconds <= 0:
   345	            raise ValueError(f"ttl_seconds must be positive, got {ttl_seconds}")
   346	
   347	        # Redaction: strings go through the regex redactor; bytes are trusted.
   348	        redacted = 0
   349	        if isinstance(value, str):
   350	            # Use max_chars=0 so full string survives — the cap below
   351	            # still enforces size.
   352	            redacted_text = _redact.redact_secrets(value, max_chars=0)
   353	            if redacted_text != value:
   354	                redacted = 1
   355	            value_bytes = redacted_text.encode("utf-8", errors="replace")
   356	        elif isinstance(value, (bytes, bytearray)):
   357	            value_bytes = bytes(value)
   358	        else:
   359	            raise TypeError(f"value must be str or bytes, got {type(value).__name__}")
   360	
   361	        if len(value_bytes) > self.value_max_bytes:
   362	            raise StateStoreValueTooLarge(
   363	                f"value is {len(value_bytes)} bytes, cap is {self.value_max_bytes}"
   364	            )
   365	
   366	        now = int(self._clock())
   367	        expires_at: Optional[int] = None
   368	        if ttl_seconds is not None:
   369	            expires_at = now + int(ttl_seconds)
   370	
   371	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   372	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   373	            self._conn.execute(
   374	                """
   375	                INSERT INTO kv(key, value, expires_at, created_at, redacted)
   376	                VALUES (?, ?, ?, ?, ?)
   377	                ON CONFLICT(key) DO UPDATE SET
   378	                    value = excluded.value,
   379	                    expires_at = excluded.expires_at,
   380	                    created_at = excluded.created_at,
   381	                    redacted = excluded.redacted
   382	                """,
   383	                (key, value_bytes, expires_at, now, redacted),
   384	            )
   385	
   386	        # Audit emit (fail-open inside)
   387	        self._emit_audit(
   388	            "state_store_write",
   389	            key_hash=_key_hash(key),
   390	            value_bytes=len(value_bytes),
   391	            ttl_seconds=ttl_seconds,
   392	            redaction_applied=bool(redacted),
   393	        )
   394	
   395	    def get(self, key: str) -> Optional[bytes]:
   396	        """Read a key; returns None if missing or expired.
   397	
   398	        Expired entries are NOT automatically pruned — call
   399	        :meth:`prune_expired` on a schedule. This keeps get() side-effect
   400	        free for observability.
   401	        """
   402	        self._ensure_open()
   403	        assert self._conn is not None
   404	
   405	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   406	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   407	            row = self._conn.execute(
   408	                "SELECT value, expires_at FROM kv WHERE key = ?", (key,)
   409	            ).fetchone()
   410	
   411	        found = False
   412	        value: Optional[bytes] = None
   413	        if row is not None:
   414	            raw_value, expires_at = row
   415	            now = int(self._clock())
   416	            if expires_at is None or expires_at > now:
   417	                value = bytes(raw_value)
   418	                found = True
   419	
   420	        self._emit_audit(
   421	            "state_store_read",
   422	            key_hash=_key_hash(key),
   423	            found=found,
   424	        )
   425	        return value
   426	
   427	    def delete(self, key: str) -> bool:
   428	        """Delete a key. Returns True if the key existed."""
   429	        self._ensure_open()
   430	        assert self._conn is not None
   431	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   432	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   433	            cur = self._conn.execute("DELETE FROM kv WHERE key = ?", (key,))
   434	            return cur.rowcount > 0
   435	
   436	    def list_keys(self, *, include_expired: bool = False) -> List[str]:
   437	        """List keys in the store. Expired entries are skipped by default."""
   438	        self._ensure_open()
   439	        assert self._conn is not None
   440	        now = int(self._clock())
   441	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   442	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   443	            if include_expired:
   444	                rows = self._conn.execute("SELECT key FROM kv ORDER BY key").fetchall()
   445	            else:
   446	                rows = self._conn.execute(
   447	                    "SELECT key FROM kv WHERE expires_at IS NULL OR expires_at > ? ORDER BY key",
   448	                    (now,),
   449	                ).fetchall()
   450	        return [r[0] for r in rows]
   451	
   452	    def prune_expired(self) -> int:
   453	        """Delete expired keys. Returns the count pruned."""
   454	        self._ensure_open()
   455	        assert self._conn is not None
   456	        now = int(self._clock())
   457	        with FileLock(str(self._lock_path), timeout=self.lock_timeout):
   458	            self._reopen_if_vanished()  # rail round-10 [P1] — see docstring
   459	            cur = self._conn.execute(
   460	                "DELETE FROM kv WHERE expires_at IS NOT NULL AND expires_at <= ?",
   461	                (now,),
   462	            )
