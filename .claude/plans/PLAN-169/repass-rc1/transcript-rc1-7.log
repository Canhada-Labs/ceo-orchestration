   277	
   278	
   279	def _resolve_live_log_path_snapshot() -> Optional[str]:
   280	    """Resolve the LIVE audit-log path under the CURRENT (pre-redirect) env, via
   281	    the production resolver. Returns a realpath string, or None on any failure
   282	    (the WS-D1 comparator fails safe to no-quarantine when absent)."""
   283	    try:
   284	        from _lib import audit_emit as _audit_emit
   285	        return str(Path(_audit_emit._log_path()).resolve())
   286	    except Exception:
   287	        return None
   288	
   289	
   290	# --- Axis 3 — collection-window redirect (S326) ----------------------------------
   291	COLLECT_WINDOW_PREFIX = "ceo-collect-isolation-"
   292	COLLECT_WINDOW_DIR: Optional[Path] = None
   293	IMPORT_TIME_LIVE_LOG_SNAPSHOT: Optional[str] = None
   294	
   295	
   296	def _snapshot_is_wellformed(value: str) -> bool:
   297	    """A usable inherited snapshot is an ABSOLUTE path that does NOT live
   298	    inside an isolation tree (a stale or redirected value is not truth).
   299	
   300	    Nothing about the name is pinned — not the basename and not the extension
   301	    (pair-rail r6 P2 + r7 P1): the documented ``CEO_AUDIT_LOG_PATH`` override
   302	    accepts any file (``/srv/audit/current.log``), and rejecting that inherited
   303	    truth made a worker re-resolve the DEFAULT path — so WS-D1 watched the
   304	    wrong file."""
   305	    return (
   306	        os.path.isabs(value)
   307	        and COLLECT_WINDOW_PREFIX not in value
   308	        and "ceo-suite-isolation-" not in value
   309	    )
   310	
   311	
   312	def _resolve_live_snapshot_outside_isolation() -> Optional[str]:
   313	    """Resolve the live log path with the whole-dir anchors temporarily removed
   314	    (pair-rail r2 P1). Used ONLY when an inherited snapshot was rejected: that
   315	    rejection is the proof the current anchor is an isolation redirect, so
   316	    resolving through it would hand the rejected path straight back. The
   317	    resolver then falls back to HOME; a result that still lives inside an
   318	    isolation tree is not truth either → ``None`` (the WS-D1 comparator fails
   319	    safe to no-quarantine when the snapshot is absent)."""
   320	    saved = {k: os.environ.pop(k, None) for k in ("CEO_AUDIT_LOG_DIR", "CEO_PROJECT_STATE_DIR")}
   321	    try:
   322	        candidate = _resolve_live_log_path_snapshot()
   323	    finally:
   324	        for key, value in saved.items():
   325	            if value is not None:
   326	                os.environ[key] = value
   327	    if candidate is not None and _snapshot_is_wellformed(candidate):
   328	        return candidate
   329	    return None
