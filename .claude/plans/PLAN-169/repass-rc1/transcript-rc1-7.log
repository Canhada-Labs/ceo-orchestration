   483	    # 4) Reset spool_writer dir caches so the new env resolves immediately.
   484	    try:
   485	        from _lib import spool_writer as _spool_writer
   486	        _spool_writer._reset_caches_for_test()
   487	    except Exception:
   488	        pass  # fail-open; cache invalidation is hygiene, not correctness
   489	
   490	    _REDIRECT = {"tmp_root": tmp_root, "env_snapshot": env_snapshot}
   491	    return _REDIRECT
