    60	def pytest_collectstart(collector):  # noqa: D401
    61	    """Ensure `.claude/hooks/` is on sys.path BEFORE any test module imports.
    62	
    63	    Hook unit tests import modules like `check_agent_spawn`, `audit_log`,
    64	    `_lib.output_scan`, etc. These live under `.claude/hooks/`. We add
    65	    that directory to sys.path once here so every test module can
    66	    `from _lib import output_scan` without a manual sys.path.insert.
    67	
    68	    Using `pytest_collectstart` (fires before test module import) avoids
    69	    the late-binding hazard of `pytest_configure`.
    70	    """
    71	    hooks_dir = Path(__file__).resolve().parent.parent
    72	    hooks_dir_str = str(hooks_dir)
    73	    if hooks_dir_str not in sys.path:
    74	        sys.path.insert(0, hooks_dir_str)
    75	
    76	
    77	# PLAN-118 AC-B7 — canonical `_lib/` path for the HMAC-trio post-collection
    78	# snapshot guard. Resolved at conftest import time from this file's
    79	# location (`<repo>/.claude/hooks/tests/conftest.py` → parent.parent =
    80	# `<repo>/.claude/hooks/` → `_lib/`). Used by
    81	# pytest_collection_finish() below to verify that no test file's
    82	# sys.path.insert() polluted the HMAC trio before any test body runs.
    83	_CANONICAL_HOOKS_DIR = Path(__file__).resolve().parent.parent
    84	_CANONICAL_LIB_DIR_FOR_SNAPSHOT = _CANONICAL_HOOKS_DIR / "_lib"
    85	_HMAC_TRIO_MODULE_NAMES = ("_lib.audit_emit", "_lib.audit_hmac", "_lib.canonical_json")
    86	
    87	
    88	def pytest_collection_finish(session):  # noqa: D401
    89	    """PLAN-118 AC-B7 — sys.modules snapshot guard (REQUIRED, was optional).
    90	
    91	    Fires AFTER pytest collection completes, BEFORE any test body runs.
    92	    For each of the HMAC trio (`_lib.audit_emit` / `_lib.audit_hmac` /
    93	    `_lib.canonical_json`) currently in :data:`sys.modules`, reads
    94	    ``<mod>.__file__``, resolves to absolute, asserts the parent is
    95	    the canonical ``.claude/hooks/_lib/`` directory.
    96	
    97	    On mismatch: ``pytest.fail()`` (NOT plain ``assert`` — assert in
    98	    conftest can be silently caught + the file accidentally collected
    99	    as a test item).
   100	
   101	    This is the only layer that catches pollution sourced from a
   102	    DIFFERENT test file's ``sys.path.insert`` BEFORE any test body
   103	    executes. Defense-in-depth alongside:
   104	      - audit_hmac._ensure_canonical_lib_modules (runtime fail-CLOSED
   105	        at compute_entry_hmac entry) — catches at HMAC-emit time
   106	      - test_lib_canonical_import.py (in-process PASS + subprocess FAIL
   107	        regression) — catches at test-runtime
   108	
   109	    Modules NOT yet imported at collection-finish are skipped (the
   110	    pytest collector may import them later when their first consumer
   111	    test loads).
   112	    """
   113	    import pytest  # local import — avoid top-level pytest dep in conftest
   114	
   115	    for mod_name in _HMAC_TRIO_MODULE_NAMES:
   116	        mod = sys.modules.get(mod_name)
   117	        if mod is None:
   118	            continue  # collector hasn't loaded it yet — skip
   119	        mod_file = getattr(mod, "__file__", None)
   120	        if mod_file is None:
   121	            continue  # builtins / namespace — skip
   122	        try:
   123	            resolved_parent = Path(mod_file).resolve().parent
   124	        except (OSError, ValueError):
   125	            continue  # symlink loop / weird path — skip
   126	        if resolved_parent != _CANONICAL_LIB_DIR_FOR_SNAPSHOT:
   127	            pytest.fail(
   128	                f"PLAN-118 AC-B7 — sys.modules pollution detected at "
   129	                f"collection-finish: {mod_name} resolves to a non-"
   130	                f"canonical _lib/ parent. Some test file's sys.path."
   131	                f"insert() shadowed the canonical _lib/ before this "
   132	                f"test session loaded the module. Hint: search for "
   133	                f"`sys.path.insert` in .claude/hooks/tests/ + recent "
   134	                f"PRs; the offender is a test that loads a stale `_lib` "
   135	                f"BEFORE the canonical one. (Resolved parent + canonical "
   136	                f"parent intentionally NOT echoed to avoid leaking "
   137	                f"absolute paths into CI logs — verify locally.)",
   138	                pytrace=False,
   139	            )
