    63	def _audit_log_lines(home: Path) -> Dict[str, int]:
    64	    """Every ``audit-log*.jsonl`` under ``home`` → line count (empty = none)."""
    65	    out: Dict[str, int] = {}
    66	    for p in home.rglob("audit-log*.jsonl"):
    67	        with open(p, encoding="utf-8", errors="replace") as fh:
    68	            out[str(p.relative_to(home))] = sum(1 for _ in fh)
    69	    return out
