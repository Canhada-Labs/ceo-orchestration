   148	def _state_path_for(project_path: str, user_id: str, date_iso: str) -> Path:
   149	    """Date-keyed state file path. Today's writes target today's file."""
   150	    key = _composite_key(project_path, user_id, date_iso)
   151	    return _state_dir(project_path) / f"cost-envelope-{key}.json"
   152	
   153	
   154	def _lock_path_for(project_path: str, user_id: str, date_iso: str) -> Path:
   155	    """Date-keyed sibling lock path; pairs with `_state_path_for`."""
   156	    key = _composite_key(project_path, user_id, date_iso)
   157	    return _state_dir(project_path) / f"cost-envelope-{key}.json.lock"
