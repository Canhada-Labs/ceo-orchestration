   290	def _resolve_plan_id(event: Dict[str, Any]) -> str:
   291	    """Derive PLAN-NNN from the audit log (NOT env). ``unknown`` on failure."""
   292	    try:
   293	        from _lib import scratchpad_lib  # noqa: E402
   294	    except Exception as exc:  # pragma: no cover — import guard
   295	        _breadcrumb("scratchpad_lib import failed (%s)" % str(exc)[:60])
   296	        return "unknown"
   297	    session_id = _session_id(event)
   298	    try:
   299	        return scratchpad_lib.resolve_plan_id(session_id)
   300	    except Exception as exc:
   301	        _breadcrumb("plan_id derivation failed (%s)" % str(exc)[:80])
   302	        return "unknown"
