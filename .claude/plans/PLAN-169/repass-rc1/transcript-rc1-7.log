   508	      - name: PLAN-155 Wave 6 pair-rail + advisory teeth
   509	        run: |
   510	          set -euo pipefail
   511	          cd "$GITHUB_WORKSPACE"
   512	          for adapter in claude codex grok; do
   513	            if [ "$adapter" = "grok" ]; then
   514	              # PLAN-156 Wave 2/4 — grok is SHAPE-DIFFERENT: Stop is passive
   515	              # there, so the codex Stop-review/advisory-teeth tests do not
   516	              # apply. Grok's ENFORCEMENT teeth are the decision->exit-2
   517	              # chokepoint (RED-on-absence, hermetic) + the adapter golden/
   518	              # drift round-trip over the recorded grok wire.
   519	              CEO_HOOK_ADAPTER=grok python3 -m pytest \
