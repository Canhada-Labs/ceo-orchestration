   273	    histerese para o próximo ciclo (o produtor é PreCompact-only e nunca
   274	    observaria a queda pós-compactação; sem isto, duas compactações no
   275	    mesmo degrau suprimem a segunda travessia). Fail-open integral."""
   276	    try:
   277	        from _lib import audit_emit  # noqa: E402 — lazy, como o emit path
   278	        clear = getattr(audit_emit, "clear_context_pressure_marker", None)
   279	        if clear is None:
   280	            return  # build pré-round-10 — degrada para o comportamento antigo
   281	        root = _resolve_project_root(
