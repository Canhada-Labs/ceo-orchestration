+    expanded = re.sub(r"(?<=[a-z0-9])(?=[A-Z])", " ", expanded)
+    expanded = re.sub(r"(?<=[A-Za-z])(?=[0-9])", " ", expanded)
+    expanded = re.sub(r"(?<=[0-9])(?=[A-Za-z])", " ", expanded)
