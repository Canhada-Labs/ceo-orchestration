+def _memory_delta_observed(repo_root: Path, session_id: str) -> Dict[str, object]:
+    """The stat-only observation (SESSIONEND-NOTE.md §2/§3). Never raises.
+
+    Returns exactly ``{outcome, files_count, modified_count, index_modified,
