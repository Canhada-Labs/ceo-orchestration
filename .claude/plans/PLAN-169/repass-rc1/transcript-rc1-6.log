   902	def _write_journal_envelope(
   903	    pid: int,
   904	    record_id: str,
   905	    spool_uuid: str,
   906	    ordinal: int,
   907	    sha256_of_line: str,
   908	    op: str,
   909	    drain_epoch: Optional[str] = None,
   910	) -> None:
   911	    """Buffer + amortized-fsync journal envelope. Best-effort fail-open.
   912	
   913	    P1-2: NOT a hot-path fsync. Envelopes are buffered in
   914	    _JOURNAL_BUFFER[pid]; flushed + fsync'd at drain boundary, signal
   915	    handler, atexit, or every _JOURNAL_FLUSH_EVERY writes (per ADR-055-
   916	    AMEND-1 §3 line 96: "journal fsync every 100ms OR 10 emits").
   917	    """
   918	    env: Dict[str, Any] = {
   919	        "record_id": record_id,
   920	        "spool_uuid": spool_uuid,
   920	        "spool_uuid": spool_uuid,
   921	        "ordinal_within_file": ordinal,
   922	        "sha256_of_line": sha256_of_line,
   923	        "op": op,
   924	        "wall_ns": time.time_ns(),
   925	    }
   926	    if drain_epoch is not None:
   927	        env["drain_epoch_at_commit"] = drain_epoch
   928	    try:
   929	        line = (json.dumps(env, separators=(",", ":"), ensure_ascii=False)
   930	                + "\n").encode("utf-8")
   931	    except (TypeError, ValueError) as e:
   932	        _breadcrumb(f"journal encode failed: {type(e).__name__}: {e}")
   933	        return
   934	    buf = _JOURNAL_BUFFER.setdefault(pid, [])
   935	    buf.append(line)
   936	    if len(buf) >= _JOURNAL_FLUSH_EVERY:
   937	        _flush_journal_buffer(pid)
   938	
   939	
   940	def _flush_journal_buffer(pid: int) -> None:
   941	    """Flush buffered journal envelopes for PID with a single fsync.
   942	
   943	    P1-2: invoked at drain boundary, signal handler, atexit, or when
   944	    buffer hits _JOURNAL_FLUSH_EVERY. Best-effort fail-open. Acquires
   945	    the per-PID journal flock around the append+fsync window.
   946	    """
   947	    buf = _JOURNAL_BUFFER.get(pid)
   948	    if not buf:
   949	        return
   950	    p = _journal_path(pid)
   951	    try:
   952	        p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   953	    except OSError as e:
   954	        _breadcrumb(f"journal mkdir failed: {type(e).__name__}: {e}")
   955	        return
   956	    payload = b"".join(buf)
   957	    try:
   958	        with FileLock(_journal_flock_path(pid), timeout=SPOOL_LOCK_TIMEOUT):
   959	            fd = os.open(
   960	                str(p), os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600,
   961	            )
   962	            try:
   963	                os.write(fd, payload)
   964	                os.fsync(fd)
   965	            finally:
   966	                os.close(fd)
   967	        # Only clear on successful write; on failure the buffer retains
   968	        # the envelopes for the next flush attempt (best-effort durability).
   969	        _JOURNAL_BUFFER[pid] = []
   970	    except FileLockTimeout:
   971	        _breadcrumb(f"journal flock timeout pid={pid}")
   972	    except OSError as e:
   973	        _breadcrumb(f"journal flush failed: {type(e).__name__}: {e}")
   974	
