  9238	        # Off-enum input must never re-arm the marker (that would let a
  9239	        # bogus value suppress the NEXT real transition). The dispatch
  9240	        # branch coerces the field itself, so there is nothing to debounce.
  9241	        return True
  9242	    try:
  9243	        marker = Path(str(state_dir)) / _context_pressure_marker_name(session_id)
  9244	    except (TypeError, ValueError):  # pragma: no cover - defensive
  9245	        return True
  9246	    current = str(int(used_bucket))
  9247	    previous = None  # type: Optional[str]
  9248	    try:
  9249	        previous = marker.read_text(encoding="utf-8").strip()
  9250	    except (OSError, ValueError, UnicodeDecodeError):
  9251	        previous = None
  9252	    if previous == current:
  9253	        return False
  9254	    # Re-arm atomically (tmp + os.replace, 0600) — same idiom as
  9255	    # check_directory_added._atomic_write, kept inline so audit_emit gains
  9256	    # no new import.
  9257	    try:
  9258	        marker.parent.mkdir(parents=True, exist_ok=True)
  9259	        # PLAN-179 rail finding A: the tmp name is derived from the SAME
  9260	        # per-session marker name. Reusing the bare basename here would give
  9261	        # two sessions re-arming at the same moment one shared tmp path.
  9262	        # PLAN-179 rail round-3 [P1] — SYMLINK-SAFE, and the name is not
  9263	        # guessable. `.claude/state/` is gitignored and world-writable to
  9264	        # anything running as this user, so a PREDICTABLE tmp path could be
  9265	        # pre-created as a symlink; a plain `open(..., "w")` follows it and the
  9266	        # hook then truncates whatever it points at — an arbitrary-write
  9267	        # primitive that routes around every canonical-edit guard, reached
  9268	        # through an advisory audit helper. Three things close it together:
  9269	        # O_EXCL (refuses an existing path), O_NOFOLLOW (refuses a symlink even
  9270	        # if it appears between the check and the open), and a random suffix so
  9271	        # pre-creation is not feasible in the first place. The mode is set AT
  9272	        # CREATION, which also removes the window the old separate `chmod` left.
  9273	        _rand = os.urandom(6).hex()
