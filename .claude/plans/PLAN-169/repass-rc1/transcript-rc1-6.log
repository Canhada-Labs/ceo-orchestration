   144	# keyring (a real-keyring leak let sentinel ``.asc`` verification SUCCEED in
   145	# tests that require it to fail; see TOOLING_CLEAR_VARS). Net: isolate the audit
   146	# dir + the GPG keyring, without breaking user-site package resolution.
   147	#
   148	# ``CLAUDE_PROJECT_DIR`` is DELIBERATELY NOT redirected — it steers where hooks
   149	# find the PROJECT's ``.claude/`` files (policies, team.md, cookbook patterns),
   150	# is not an audit-location carrier, and redirecting it broke "the real repo is
   151	# configured" tests (test_flip_closures, test_cookbook_advisor_hook) for zero
   152	# isolation gain.
   153	AUDIT_DIR_CARRIERS = (
   154	    "HOME",
   155	    "CEO_AUDIT_LOG_DIR",
   156	    "CEO_PROJECT_STATE_DIR",
   157	)
   158	# Tooling env vars re-exported (to REAL values) after the HOME redirect so a
