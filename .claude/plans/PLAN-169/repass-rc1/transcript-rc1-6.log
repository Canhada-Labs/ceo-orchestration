  2465	
  2466	
  2467	def reconcile_journal_at_session_start() -> JournalReconciliation:
  2468	    """Walk audit-pending.*.journal entries; classify counts; emit forensic.
  2469	
  2470	    Returns the JournalReconciliation populated with counts. Emits
  2471	    audit_flush_dropped_count via wired forensic callback (caller in
  2472	    audit_emit wires the callback before invoking this).
  2473	    """
  2474	    rec = JournalReconciliation()
  2475	    state_dir = _state_dir()
  2476	    try:
  2477	        if not state_dir.exists():
  2478	            _forensic("audit_flush_dropped_count", _journal_rec_dict(rec))
  2479	            return rec
  2480	        names = sorted(os.listdir(str(state_dir)))
  2481	    except OSError:
  2482	        _forensic("audit_flush_dropped_count", _journal_rec_dict(rec))
  2483	        return rec
  2484	
  2485	    by_record: Dict[str, Dict[str, bool]] = {}
  2486	    for name in names:
  2487	        if not name.startswith(_JOURNAL_PREFIX + "."):
  2488	            continue
  2489	        if not name.endswith(".journal"):
  2490	            continue
  2491	        if name == _aggregate_journal_path().name:
  2492	            continue
  2493	        # Parse <pid> from "audit-pending.<pid>.journal"
  2494	        rest = name[len(_JOURNAL_PREFIX) + 1:]
  2495	        pid_str = rest[:-len(".journal")]
  2496	        try:
  2497	            pid = int(pid_str)
  2498	        except ValueError:
  2499	            continue
  2500	        if pid == os.getpid():
  2501	            continue
  2502	        if _is_alive_pid(pid):
  2503	            continue
