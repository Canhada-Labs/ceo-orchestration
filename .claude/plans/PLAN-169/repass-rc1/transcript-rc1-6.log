   473	def read_prev_hmac() -> bytes:
   474	    """Return the binary previous-HMAC or the genesis value.
   475	
   476	    Reads the sidecar ``audit-log.last-hmac`` (hex-encoded 64 chars +
   477	    optional trailing newline). If absent or malformed → genesis.
   478	    Fail-open invariant: a corrupted sidecar must not block writes.
   479	    The log tail itself remains the source of truth; verify-chain
   480	    re-reads from the log, not the sidecar.
   481	
   482	    MUST be called WITH the audit-log FileLock held.
   483	    """
   484	    p = last_hmac_path()
   485	    if not p.exists():
   486	        return GENESIS_PREV
   487	    try:
   488	        raw = p.read_text(encoding="utf-8").strip()
   489	    except OSError:
   490	        return GENESIS_PREV
   491	    if len(raw) != HMAC_HEX_LEN:
   492	        return GENESIS_PREV
   493	    try:
   494	        return bytes.fromhex(raw)
   495	    except ValueError:
   496	        return GENESIS_PREV
   497	
   498	
   499	def write_last_hmac(digest: bytes) -> None:
   500	    """Persist the last HMAC to the sidecar (best-effort, no fsync).
   501	
   502	    Performance-engineer review §10 red flag #1: a second fsync under
   503	    the lock doubles variance. The sidecar is reconstructible from
   504	    log tail so skipping fsync is the right trade-off. If the sidecar
   505	    is corrupt or absent after a crash, :func:`read_prev_hmac` returns
   506	    genesis and the chain reseals on next write (operator sees a
   507	    one-line break in verify-chain, distinguishable from tamper via
   508	    monotonic ``ts``).
   509	
   510	    MUST be called WITH the audit-log FileLock held.
   510	    MUST be called WITH the audit-log FileLock held.
   511	    """
   512	    if len(digest) != HMAC_BYTES:
   513	        raise AuditHmacError(
   514	            "digest is {n} bytes, expected {k}".format(
   515	                n=len(digest), k=HMAC_BYTES
   516	            )
   517	        )
   518	    p = last_hmac_path()
   519	    p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   520	    tmp = p.with_name(p.name + ".tmp.{pid}".format(pid=os.getpid()))
   521	    try:
   522	        with open(tmp, "w", encoding="utf-8") as f:
   523	            f.write(digest.hex())
   524	        os.replace(str(tmp), str(p))
   525	        try:
   526	            os.chmod(p, 0o600)
   527	        except OSError:
   528	            pass
   529	    except OSError as e:
   530	        try:
   531	            if tmp.exists():
   532	                os.unlink(tmp)
   533	        except OSError:
   534	            pass
   535	        raise AuditHmacError(
   536	            "could not write {p}: {e}".format(p=p, e=e)
   537	        ) from e
   538	
   539	
   540	def reset_chain_on_rotation() -> None:
   541	    """Clear the sidecars so the new file starts with a genesis chain.
   542	
   543	    PLAN-045 Wave 1 F-01-05 extension: also clears the chain-length
   544	    canary sidecar. Rotation renames the log to an archive file; the
   545	    new log starts at genesis + chain-length 0. Historical archive
   546	    files retain the canary value at time of rotation (verification of
   547	    archives falls back to walking each archive independently — the
   548	    current live chain has no memory of archived counters).
   549	
   550	    MUST be called WITH the audit-log FileLock held, after the log
   551	    rename but before the new file's first write.
   552	    """
   553	    for p in (last_hmac_path(), chain_length_path()):
   554	        try:
   555	            if p.exists():
   556	                p.unlink()
   557	        except OSError:
   558	            # Best-effort: next read falls back to genesis / 0 if the
   559	            # sidecar is corrupt or absent.
   560	            pass
   561	
   562	
   563	# ---------------------------------------------------------------------------
   564	# Chain-length canary (PLAN-045 Wave 1 F-01-05) — ACTIVE since v1.11.x
   565	# ---------------------------------------------------------------------------
   566	# audit-v2 (2026-04-27) C6-P0-03 closed Wave D-2 (2026-04-28):
   567	# `audit_emit._write_event` now calls `write_chain_length(n+1)` under
   568	# the same FileLock as `write_last_hmac`, gate-guarded on
   569	# (`_HMAC_AVAILABLE` AND `event["hmac"]` AND `not is_disabled()`).
   570	#
   571	# Tail-truncation detection is now active:
   572	#   - `read_chain_length()` returns the persisted counter
   573	#   - `verify_chain(strict_against_counter=True)` compares walker-count
   574	#     vs counter; counter > walker -> STATUS_TAMPER with
   575	#     reason="chain_length_truncation"
   576	#
   577	# Forensic limitation (forward-only): tail-truncation detection is
   578	# active for entries written AFTER the canary-wire commit. Pre-wire
   579	# entries rely solely on the per-entry HMAC chain. See
   580	# `docs/STATE-RECOVERY.md` ("Chain-length canary forward-only").
   581	#
   582	# Threat-model limitation (deferred to C6-P0-03b): the counter sidecar
   583	# is plaintext, defending only against truncate-only attackers. An
   584	# attacker with audit-dir write access can rewrite the counter to match
   585	# a truncated walker count. Hardening (HMAC-protected counter) is
   586	# tracked as follow-up.
   587	#
   588	# Active defenses for chain integrity:
   589	#   - Per-entry HMAC chain (verified by verify_chain at audit-time)
   590	#   - HMAC chain reset on log rotation (reset_chain_on_rotation)
   591	#   - Per-event hash salting (UserPromptSubmit.py:182)
   592	#   - Chain-length canary (this section, wired Wave D-2)
   593	# ---------------------------------------------------------------------------
   594	
   595	
   596	def read_chain_length() -> int:
   597	    """Return the persisted chain-length counter, or 0 if absent/malformed.
   598	
   599	    Fail-open: a missing or corrupt sidecar returns 0 (the genesis
   600	    value). ``verify_chain(strict_against_counter=True)`` treats any
   601	    walker-count >= returned-counter as pass; counter > walker indicates
   602	    tail truncation and fails-closed.
   603	
   604	    MUST be called WITH the audit-log FileLock held.
   605	    """
   606	    p = chain_length_path()
   607	    if not p.exists():
   608	        return 0
   609	    try:
   610	        raw = p.read_text(encoding="utf-8").strip()
   611	    except OSError:
   612	        return 0
   613	    if not raw:
   614	        return 0
   615	    try:
   616	        n = int(raw)
   617	    except ValueError:
   618	        return 0
   619	    if n < 0:
   620	        return 0
   621	    return n
   622	
   623	
   624	def write_chain_length(n: int) -> None:
   625	    """Persist the chain-length counter (atomic rename, 0600 perms).
   626	
   627	    Called by ``audit_emit._write_event`` after each successful HMAC
   628	    entry write. Monotonic; caller is responsible for incrementing
   629	    against ``read_chain_length() + 1``.
   630	
   631	    Fail-open: raises ``AuditHmacError`` so the caller can decide
   632	    whether to skip the canary update (fail-open) or propagate. The
   633	    canary is a detection aid, not a correctness requirement.
   634	
   635	    MUST be called WITH the audit-log FileLock held.
   636	    """
   637	    if n < 0:
   638	        raise AuditHmacError(
   639	            "chain-length must be non-negative, got {n}".format(n=n)
   640	        )
   641	    p = chain_length_path()
   642	    p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   643	    tmp = p.with_name(p.name + ".tmp.{pid}".format(pid=os.getpid()))
   644	    try:
   645	        with open(tmp, "w", encoding="utf-8") as f:
   646	            f.write(str(n))
   647	        os.replace(str(tmp), str(p))
   648	        try:
   649	            os.chmod(p, 0o600)
   650	        except OSError:
   651	            pass
   652	    except OSError as e:
   653	        try:
   654	            if tmp.exists():
   655	                os.unlink(tmp)
   656	        except OSError:
   657	            pass
   658	        raise AuditHmacError(
   659	            "could not write {p}: {e}".format(p=p, e=e)
   660	        ) from e
   661	
