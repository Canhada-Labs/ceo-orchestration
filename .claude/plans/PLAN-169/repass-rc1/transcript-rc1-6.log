  2387	                        stats.quarantined_files += 1
  2388	
  2389	                # iter2-P0-1 + iter4-P2-2: phase 3 returns
  2390	                # (deduped, Dict[str, Set[int]], duplicate_consumed_count)
  2391	                deduped, partial_consumed, dup_consumed = (
  2392	                    _phase3_collect_and_sort(
  2393	                        valid_files, drain_epoch, stats,
  2394	                    )
  2395	                )
  2396	
  2397	                # P0-2 + P1-3 + iter2-P0-1: phase 4 returns
  2398	                # (batch_lines, _, per_file_consumed_set, last_hmac, ids)
  2399	                # iter4-P2-2: pass dup_consumed as starting_processed so
  2400	                # combined Phase-3 + Phase-4 work bounded by K_MAX.
  2401	                (batch_lines, _, per_file_consumed, last_hmac,
  2402	                 drained_ids) = _phase4_build_batch(
  2403	                    deduped, drain_epoch, in_recovery, stats,
  2404	                    starting_processed=dup_consumed,
  2405	                )
  2406	
  2407	                # iter2-P0-1: merge partial/duplicate-rejection consumed
  2408	                # indices (Set[int] union) into the Phase-4 per-file map so
  2409	                # Phase 5 split honors the COMPLEMENT for remainder lines.
  2410	                for path_key, idx_set in partial_consumed.items():
  2411	                    if path_key in per_file_consumed:
  2412	                        per_file_consumed[path_key] |= idx_set
  2413	                    else:
  2414	                        per_file_consumed[path_key] = set(idx_set)
  2415	
  2416	                stats.appended = _phase5_append_canonical(batch_lines, last_hmac)
  2417	
  2418	                # P1-3: emit op:"drained" envelopes grouped by pid + flush.
  2419	                drained_by_pid: Dict[int, List[str]] = {}
  2420	                for rec_id, pid in drained_ids:
  2421	                    drained_by_pid.setdefault(pid, []).append(rec_id)
  2422	                for pid, ids in drained_by_pid.items():
  2423	                    _journal_compact_drained(pid, ids, drain_epoch)
  2424	
  2425	                _phase5_split_and_cleanup(
  2426	                    valid_files, per_file_consumed, drain_epoch, stats,
  2427	                )
  2428	
  2429	                # P1-2: drain-boundary journal flush for our own PID
  2430	                _flush_journal_buffer(our_pid)
  2431	        except FileLockTimeout:
  2432	            if force:
  2433	                # Forced drain could not complete — genuinely anomalous.
  2434	                stats.ok = False
  2435	                stats.error = "canonical_lock_timeout"
  2436	                _breadcrumb("drain canonical lock timeout")
  2437	            else:
  2438	                # Opportunistic yield — expected under concurrency, NOT an
  2439	                # error. Another drainer holds the lock; its global sweep plus
  2440	                # our own later drain cover our events, so ok stays True.
  2441	                stats.contended_skip = True
