   152	
   153	def _generate_and_persist(
   154	    path: Path, replace_existing: bool = False
   155	) -> Tuple[bytes, str]:
   156	    """Generate a new 32-byte salt and write it to ``path``.
   157	
   158	    Returns ``(salt, outcome)`` where outcome is one of:
   159	
   160	    * ``"created"`` — this process won the race and the returned bytes
   161	      are the ones now on disk;
   162	    * ``"exists"`` — another process created the file first; NOTHING was
   163	      written and the caller must read the winner's bytes;
   164	    * ``"error"`` — an I/O failure; the salt is ``b""`` (fail-open, the
   165	      caller degrades to the unsalted hash).
