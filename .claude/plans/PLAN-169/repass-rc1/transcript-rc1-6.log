   325	        # Race-safe against parallel audit_log invocations because we
   326	        # check existence after write and prefer the already-existing
   327	        # key.
   328	        tmp = p.with_name(p.name + ".tmp.{pid}".format(pid=os.getpid()))
   329	        try:
   330	            fd = os.open(
   331	                str(tmp),
