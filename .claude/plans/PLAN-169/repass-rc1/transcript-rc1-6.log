   425	                    os.unlink(tmp)
   426	                except OSError:
   427	                    pass
   428	            else:
   429	                os.replace(str(tmp), str(p))
   430	        except FileExistsError:
   431	            # tmp existed (stale). Remove + fall through to the read.
   432	            try:
   433	                if tmp.exists():
   434	                    os.unlink(tmp)
   435	            except OSError:
   436	                pass
   437	        except OSError as e:
   438	            try:
   439	                if tmp.exists():
   440	                    os.unlink(tmp)
   441	            except OSError:
   442	                pass
