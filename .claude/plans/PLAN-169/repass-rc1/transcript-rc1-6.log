   688	    p = rotation_manifest_path()
   689	    p.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
   690	    tmp = p.with_name(p.name + ".tmp.{pid}".format(pid=os.getpid()))
   691	    try:
   692	        with open(tmp, "w", encoding="utf-8") as f:
   693	            _json.dump(manifest, f, separators=(",", ":"), ensure_ascii=False)
   694	        os.replace(str(tmp), str(p))
   695	        try:
   696	            os.chmod(p, 0o600)
   697	        except OSError:
   698	            pass
   699	    except OSError as e:
   700	        try:
   701	            if tmp.exists():
   702	                os.unlink(tmp)
   703	        except OSError:
   704	            pass
   705	        raise AuditHmacError(
   706	            "could not write rotation manifest {p}: {e}".format(p=p, e=e)
