  2378	                        # the canonical destination IS the live chain; applied
  2379	                        # AFTER header validation and BEFORE phase 3, so test
  2380	                        # entries never reach batch_lines / the canonical append.
  2381	                        if _should_quarantine_test_origin(f, log_path):
  2382	                            _quarantine_test_origin(f, drain_epoch)
  2383	                            stats.test_origin_quarantined += 1
  2384	                        else:
  2385	                            valid_files.append(f)
