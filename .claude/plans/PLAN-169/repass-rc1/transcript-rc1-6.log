   135	def _read_existing(path: Path) -> Optional[bytes]:
   136	    """Read salt file if present and well-formed.
   137	
   138	    Returns the bytes if size matches ``_SALT_BYTES``; ``None`` if
   139	    the file is absent, the wrong size, or unreadable. Callers
