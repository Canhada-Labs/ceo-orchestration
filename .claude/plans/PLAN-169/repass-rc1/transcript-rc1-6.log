  1233	def _is_alive_pid(pid: int) -> bool:
  1234	    """Return True if a process with PID is alive in current namespace."""
  1235	    if pid <= 0:
  1236	        return False
  1237	    try:
  1238	        os.kill(pid, 0)
  1239	    except ProcessLookupError:
  1240	        return False
  1241	    except PermissionError:
  1242	        return True
  1243	    except OSError:
  1244	        return False
  1245	    return True
