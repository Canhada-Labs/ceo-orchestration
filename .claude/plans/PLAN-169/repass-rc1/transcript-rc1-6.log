    98	def _generate_and_persist(path: Path) -> bytes:
    99	    """Generate a new 32-byte salt and write it to ``path``.
   100	
   101	    Returns the salt on success; ``b""`` on any I/O failure. Sets
   102	    file mode ``0o600`` and parent dir mode ``0o700`` (best-effort).
   103	    """
   104	    try:
   105	        path.parent.mkdir(parents=True, exist_ok=True, mode=_DIR_MODE)
   106	    except OSError:
   107	        return b""
   108	    try:
   109	        salt = os.urandom(_SALT_BYTES)
   110	        path.write_bytes(salt)
   111	    except OSError:
   112	        return b""
   113	    try:
   114	        os.chmod(path, _SALT_MODE)
   115	    except OSError:
   116	        # Permission failure on chmod is non-fatal — the salt is
   117	        # written but with default umask perms. Caller still gets
   118	        # the salt; future readers may face stricter access but the
   119	        # current process succeeds.
   120	        pass
   121	    return salt
