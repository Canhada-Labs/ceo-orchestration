  2129	
  2130	def _phase5_split_and_cleanup(
  2131	    files: List[_DrainingFile],
  2132	    per_file_consumed: Dict[str, Set[int]],
  2133	    drain_epoch: str,
  2134	    stats: DrainStats,
  2135	) -> None:
  2136	    """For each draining file: unlink if fully consumed; else atomic-split.
  2137	
  2138	    iter2-P0-1: per_file_consumed is a Set[int] of body INDICES. The
  2139	    remainder file is built from the COMPLEMENT (all body indices NOT in
  2140	    the set). This correctly handles out-of-order index consumption (e.g.
  2141	    wall_ns clock-skew rollback where a later body index sorts BEFORE an
  2142	    earlier one and is cut by K_MAX) — prefix-based cleanup would have
  2143	    discarded unprocessed earlier lines.
  2144	
  2145	    iter2-P0-3: SKIP any _DrainingFile whose .quarantined flag is set —
  2146	    the file is already renamed to .malformed.<epoch>; trying to split
  2147	    or unlink the original path would either fail (ENOENT) or, worse,
  2148	    re-sweep the renamed quarantined file on a subsequent drain.
  2149	
  2150	    iter2-P1-3: when splitting, mint a NEW drain_epoch for the destination
  2151	    so dst path != src path. This closes the `.split.tmp` two-step window
  2152	    (old code reused src epoch → dst==src → os.rename(src,dst) no-op AND
  2153	    the temp suffix dance remained). Now: tmp → fsync → rename(tmp,
  2154	    new_dst) atomic; unlink(src). Single window if rename succeeds.
  2155	
  2156	    P2-4: header is written VERBATIM from file.header_raw — no JSON
  2157	    re-encode (preserves byte identity of _spool_uuid sentinel chain).
  2158	    """
  2159	    for f in files:
  2160	        # iter2-P0-3: skip quarantined files — original path doesn't exist
  2320	        st = _spool_path(pid).stat()
  2321	    except OSError:
  2322	        return False
  2323	    if st.st_size == 0:
  2324	        return False
  2325	    age_ms = (time.time() - st.st_mtime) * 1000.0
  2326	    return age_ms > DRAIN_TRIGGER_MTIME_MS
