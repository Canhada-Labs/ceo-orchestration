  1078	# Drain trigger
  1079	# ---------------------------------------------------------------------------
  1080	
  1081	
  1082	def should_drain() -> bool:
  1083	    """Return True if current spool meets event-count or staleness trigger.
  1084	
  1085	    P2-1: event-count trigger uses an actual newline-count over the spool
  1086	    body (capped at DRAIN_TRIGGER_SIZE + 2 to keep the probe cheap), NOT
  1087	    a byte-size proxy. Header is 1 line; we trigger when body lines >=
  1088	    DRAIN_TRIGGER_SIZE.
  1089	    """
  1090	    try:
  1091	        pid = os.getpid()
  1092	        p = _spool_path(pid)
  1093	        if not p.exists():
  1094	            return False
  1095	        st = p.stat()
  1096	        if st.st_size == 0:
  1097	            return False
  1098	        # Staleness trigger first (cheap)
  1099	        age_ms = (time.time() - st.st_mtime) * 1000.0
  1100	        if age_ms > DRAIN_TRIGGER_MTIME_MS:
  1101	            return True
  1102	        # P2-1: honest newline count, capped at DRAIN_TRIGGER_SIZE + 2
  1103	        # (1 for header + 1 to early-exit once we cross the threshold).
  1104	        cap = DRAIN_TRIGGER_SIZE + 2
  1105	        count = 0
  1106	        try:
  1107	            with p.open("rb") as f:
  1108	                while count < cap:
  1109	                    chunk = f.read(8192)
  1110	                    if not chunk:
  1111	                        break
  1112	                    count += chunk.count(b"\n")
  1113	                    if count >= cap:
  1114	                        break
  1115	        except OSError:
  1116	            return False
  1117	        # Body lines = count - 1 (header is line 1). Trigger when
  1118	        # body_lines >= DRAIN_TRIGGER_SIZE → count >= DRAIN_TRIGGER_SIZE+1.
  1119	        return count >= (DRAIN_TRIGGER_SIZE + 1)
  1120	    except Exception:
  1121	        return False
  1122	
