  8791	def _ledger_int_field(value: Any, hi: int) -> int:
  8792	    """TYPE-strict clamp for the ledger rail's integer wire fields.
  8793	
  8794	    Deliberately NOT ``int(value)``: ``bool`` is an ``int`` subclass (so
  8795	    ``True`` would sail through any numeric test) and ``canonical_json``
  8796	    REFUSES floats in HMAC-covered fields — a float here would drop the
  8797	    WHOLE event to an ``audit-log.errors`` breadcrumb rather than the one
  8798	    field (S181 / ADR-055-AMEND-2). Anything that is not a plain
  8799	    non-negative ``int`` therefore becomes ``0``, and values above ``hi``
  8800	    are clamped. Never echoes the rejected value.
  8801	    """
  8802	    if isinstance(value, bool) or not isinstance(value, int):
  8803	        return 0
  8804	    if value < 0:
  8805	        return 0
  8806	    return value if value <= hi else hi
