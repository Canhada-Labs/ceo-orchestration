    89	
    90	# Value size cap: per-key payload in bytes
    91	DEFAULT_VALUE_MAX_BYTES = 64 * 1024
    92	
    93	# Max plan_id length (PLAN-NNN plus slack for suffixes)
    94	_PLAN_ID_MAX_LEN = 64
    95	
    96	# Max store name length (slug conventions)
    97	_STORE_NAME_MAX_LEN = 32
    98	
    99	# Default filelock timeout — generous because sqlite itself is fast
   100	_LOCK_TIMEOUT_SEC = 5.0
