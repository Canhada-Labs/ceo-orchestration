   355	            "." + _MINT_MARKER_FILENAME + "." + os.urandom(6).hex() + ".tmp"
   356	        )
   357	        _mfd = os.open(
   358	            str(_tmp_path),
   359	            os.O_WRONLY | os.O_CREAT | os.O_EXCL | getattr(os, "O_NOFOLLOW", 0),
   360	            _SALT_MODE,
   361	        )
   362	        try:
   363	            with os.fdopen(_mfd, "w", encoding="utf-8") as _mfh:
   364	                _mfh.write(json.dumps(marker, sort_keys=True) + "\n")
   365	            try:
   366	                os.chmod(str(_tmp_path), _SALT_MODE)
   367	            except OSError:
   368	                pass
