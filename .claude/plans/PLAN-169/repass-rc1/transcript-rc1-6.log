  1204	@dataclass(eq=False)
  1205	class _DrainingFile:
  1206	    """One file under drain in the current cycle.
  1207	
  1208	    P0-2: declared eq=False so default object identity hash applies —
  1209	    instances are usable as Dict keys without TypeError. (We still key
  1210	    per_file_consumed on str(path) per Option B in the review for
  1211	    clarity; the eq=False guard is defense-in-depth.)
  1212	
  1213	    P2-4: header_raw stores the verbatim bytes (incl. trailing newline)
  1214	    of the header line, so Phase 5 atomic-split writes the byte-identical
  1215	    header to the new .draining.<new_epoch> file (no re-encode drift).
  1216	
  1217	    iter2-P0-3: `quarantined` flag — set by `_quarantine()` after mid-file
  1218	    tamper rename so Phase 5 cleanup SKIPS the entry (the file is already
  1219	    moved aside as .malformed.<epoch>; trying to split would touch a
  1220	    non-existent path or re-sweep the quarantined file).
  1221	    """
  1222	
  1223	    path: Path
  1224	    pid: int
  1225	    drain_epoch: str
  1226	    header: Optional[Dict[str, Any]] = None
  1227	    header_raw: bytes = b""
  1228	    body_lines: List[bytes] = field(default_factory=list)
  1229	    consumed_count: int = 0
  1230	    quarantined: bool = False
