  9323	
  9324	# PLAN-135 W2 H5 (ADR-154) — Sec field allowlist for the bash-input-rewrite
  9325	# breadcrumb (bash_input_rewritten, producer .claude/hooks/check_bash_safety.py).
  9326	# Deny-by-default. Same no-value-echo contract as settings_tamper_detected
