   179	class SqliteStateStore:
   180	    """Plan-scoped key/value store backed by a single sqlite file.
   181	
   182	    Not thread-safe within a process (callers should open one store per
   183	    thread). Cross-process safety is provided by the sibling filelock.
   184	
   185	    Args:
   186	        store_name: short slug identifying the store (e.g. "scratchpad").
   187	        plan_id: canonical PLAN-NNN string scoping the data.
   188	        value_max_bytes: per-key cap. Default 64 KiB.
   189	        lock_timeout: filelock wallclock budget. Default 5.0s.
   190	
   191	    Raises:
   192	        StateStoreInvalidName: if store_name or plan_id fail validation.
   193	    """
   194	
   195	    def __init__(
   196	        self,
   197	        store_name: str,
   198	        plan_id: str,
   199	        value_max_bytes: int = DEFAULT_VALUE_MAX_BYTES,
   200	        lock_timeout: float = _LOCK_TIMEOUT_SEC,
   201	        *,
   202	        clock: Optional[Callable[[], float]] = None,
   203	    ) -> None:
   204	        _validate_store_name(store_name)
   205	        _validate_plan_id(plan_id)
   206	        self.store_name = store_name
   207	        self.plan_id = plan_id
   208	        self.value_max_bytes = int(value_max_bytes)
   209	        self.lock_timeout = float(lock_timeout)
   210	        # PLAN-045 Wave 2 F-03-04: injectable clock so TTL tests can
   211	        # fast-forward instead of sleeping. Default: wall clock.
   212	        self._clock: Callable[[], float] = clock if clock is not None else time.time
   213	
   214	        self._store_dir = _state_root() / store_name
   215	        self._db_path = self._store_dir / f"{plan_id}.sqlite"
   216	        self._lock_path = self._store_dir / f"{plan_id}.sqlite.lock"
   217	
   218	        self._conn: Optional[sqlite3.Connection] = None
   219	        self._opened = False
   220	        self._db_ident = None  # (st_dev, st_ino) of the open db — round-11 [P2]
   221	
   222	    def _ensure_open(self) -> None:
   223	        if self._opened:
   224	            return
   225	        self._store_dir.mkdir(parents=True, exist_ok=True, mode=0o700)
   226	        # sqlite connect will create the file if absent
   227	        self._conn = sqlite3.connect(
   228	            str(self._db_path),
   229	            timeout=self.lock_timeout,
   230	            isolation_level=None,  # autocommit; we manage transactions via BEGIN/COMMIT
   231	        )
   232	        # Tight file perms — owner-only
   233	        try:
   234	            os.chmod(self._db_path, 0o600)
   235	        except OSError:
   236	            pass
   237	        self._conn.execute("PRAGMA journal_mode=WAL")
   238	        self._conn.execute("PRAGMA synchronous=NORMAL")
   239	        self._conn.execute("PRAGMA temp_store=MEMORY")
   240	        self._conn.execute(
   241	            """
   242	            CREATE TABLE IF NOT EXISTS kv (
   243	                key TEXT PRIMARY KEY,
   244	                value BLOB NOT NULL,
   245	                expires_at INTEGER,           -- epoch seconds, NULL = no expiry
   246	                created_at INTEGER NOT NULL,  -- epoch seconds
   247	                redacted INTEGER NOT NULL     -- 1 if redact_secrets changed the value
   248	            )
   249	            """
   250	        )
   251	        self._conn.execute("CREATE INDEX IF NOT EXISTS idx_kv_expires ON kv(expires_at)")
   252	        # Identity of the inode this connection targets (rail round-11 [P2]):
   253	        # `_reopen_if_vanished` compares against it UNDER the lock to detect
   254	        # both absence and REPLACEMENT of the db file by another handle.
   255	        try:
   256	            _st = os.stat(self._db_path)
   257	            self._db_ident = (_st.st_dev, _st.st_ino)
   258	        except OSError:
   259	            self._db_ident = None
   260	        self._opened = True
   261	
   262	    # --- context manager --------------------------------------------------
   263	
   264	    def _reopen_if_vanished(self) -> None:
   265	        """GC coordination — MUST be called UNDER the FileLock.
   266	
   267	        PLAN-179 rail round-10 [P1]: the continuity GC unlinks aged session
   268	        stores while holding this same lock, and `_ensure_open` runs BEFORE
   269	        lock acquisition — so a connection opened earlier (or cached across
   270	        operations) can point at an UNLINKED inode; committing there loses
   150	# is not an audit-location carrier, and redirecting it broke "the real repo is
   151	# configured" tests (test_flip_closures, test_cookbook_advisor_hook) for zero
   152	# isolation gain.
   153	AUDIT_DIR_CARRIERS = (
   154	    "HOME",
   155	    "CEO_AUDIT_LOG_DIR",
   156	    "CEO_PROJECT_STATE_DIR",
   157	)
   158	# Tooling env vars re-exported (to REAL values) after the HOME redirect so a
   159	# subprocess can still resolve user-site packages (PyYAML etc.).
   160	TOOLING_PRESERVE_VARS = ("PYTHONUSERBASE",)
   161	# Tooling env vars CLEARED after the HOME redirect so they resolve under the
   162	# redirected (isolated) HOME. GNUPGHOME → the redirected HOME's empty `.gnupg`,
   163	# so the suite cannot use the real signing keyring (tests that exercise GPG set
   164	# their own keyring_home/GNUPGHOME).
   165	TOOLING_CLEAR_VARS = ("GNUPGHOME",)
   166	# Carriers we explicitly CLEAR (the "or-clear" half of set-or-clear). These are
   167	# the per-file path OVERRIDES + tunables. We do NOT set them to fixed session
   168	# paths because ``TestEnvContext`` re-isolates per test by re-pointing only
   169	# ``CEO_AUDIT_LOG_DIR`` (+ LOG_PATH/ERR/LOCK) and RELIES on the KEY /
   170	# LAST_HMAC / CHAIN_LENGTH sidecars defaulting off ``CEO_AUDIT_LOG_DIR``. If the
   171	# session redirect pinned those overrides to a session path, every
   172	# ``TestEnvContext`` test's sidecars would stay stuck in the session dir while
   173	# its log moved to the per-test dir → chain-length/canary mismatch. Clearing
   174	# them (a) removes any stale parent-shell value that could point at the live
   175	# tree and (b) lets both the session anchor and each per-test anchor drive
   176	# resolution coherently.
   177	AUDIT_CLEAR_CARRIERS = (
   178	    "CEO_AUDIT_LOG_PATH",
   179	    "CEO_AUDIT_LOG_ERR",
   180	    "CEO_AUDIT_LOG_LOCK",
   181	    "CEO_AUDIT_KEY_PATH",
   182	    "CEO_AUDIT_LAST_HMAC_PATH",
   183	    "CEO_AUDIT_CHAIN_LENGTH_PATH",
   184	    "CEO_AUDIT_LOG_FALLBACK_PATH",
   185	    "CEO_AUDIT_LOG_ROTATE_BYTES",
   186	    "CEO_AUDIT_HMAC_DISABLE",
   187	)
   188	# Whole-directory overrides: carriers that select the ENTIRE runtime-state dir
   189	# at the TOP of the resolver precedence (``_lib/runtime_paths``, PLAN-182 W1).
   190	# They are NEUTRALISED at import time and NEVER restored inside the process —
   191	# see the module docstring, Axis 2, for the two measurements that force both
   192	# halves of that sentence.
   193	#
   194	# Deliberately NOT part of ``ALL_AUDIT_CARRIERS``: membership there means
   195	# "snapshot me and restore me at session end", and restoring this carrier
   196	# before interpreter shutdown is exactly the measured re-opening of the escape.
   197	WHOLE_DIR_OVERRIDE_CARRIERS = (
   198	    "CLAUDE_PROJECT_DIR_NATIVE",
   199	)
   200	# The full carrier surface — used by the WS-C partial-override rejection and by
   201	# the WS-E grep gate (every carrier must be enumerated in ONE place).
   202	ALL_AUDIT_CARRIERS = AUDIT_DIR_CARRIERS + AUDIT_CLEAR_CARRIERS
   203	
   204	# Sticky signals set into the (test) environment + inherited by children.
   205	TEST_HARNESS_VAR = "CEO_TEST_HARNESS"
   206	SYNC_MODE_VAR = "CEO_AUDIT_SYNC_MODE"
   207	# WS-D1 live-chain comparator: the resolved LIVE audit-log path captured BEFORE
   208	# the redirect. The drainer (which, post-redirect, cannot infer the live path
   209	# from env) reads this to decide whether a `_origin:"test"` spool is heading for
   210	# the live chain. Absent/unreadable ⇒ WS-D1 fails SAFE to no-quarantine.
   211	LIVE_LOG_SNAPSHOT_VAR = "CEO_AUDIT_LIVE_LOG_PATH_SNAPSHOT"
