   960	def _read_surface(path: object) -> Tuple[str, Optional[str]]:
   961	    """Return ``(state, text)`` where state is absent/present/unreadable.
   962	
   963	    A missing FILE is "absent" — nothing can hold the entry. Any other
   964	    read failure is "unreadable", which the caller treats as NOT verified.
   965	    """
   966	    if path is None:
   967	        # "absent" e uma AFIRMACAO sobre um caminho concreto que nao existe.
   968	        # `None` e ausencia de caminho: o chamador nao conseguiu resolver a
   969	        # superficie, e nada foi lido. Devolver "absent" fazia
   970	        # `verify_entry_absent` certificar uma delecao SEM ler superficie
   971	        # nenhuma — fail-open no caso exato de entrada nao-resolvida
   972	        # (pair-rail rodada 6, P2).
   973	        return "unreadable", None
   974	    try:
   975	        p = Path(path)
   976	    except (TypeError, ValueError):
   977	        return "unreadable", None
   978	    try:
   979	        if not p.exists():
   980	            return "absent", None
   981	        # Fresh read every time: verification that trusts a cache is
   982	        # presumption wearing a verification's clothes.
   983	        #
   984	        # Read ONE byte past the cap so truncation is DETECTABLE. A capped
   985	        # read that silently returns a prefix is fail-OPEN: if the surface
   986	        # exceeds the cap and the marker lives past it, the caller searches
   987	        # a prefix, finds nothing, and certifies a deletion that never
   988	        # happened. The ledger size ceiling is advisory, so nothing upstream
   989	        # guarantees the file fits. "unreadable" is NOT "absent" (see
   990	        # DELETION_OUTCOMES) and unverified is fail-CLOSED here — an
   991	        # over-cap surface is exactly that: not verified.
   992	        # (pair-rail round 1, P1: "Treat truncated deletion reads as
   993	        # unverified".)
   994	        with p.open("rb") as fh:
   995	            raw = fh.read(_VERIFY_READ_CAP_BYTES + 1)
   996	    except OSError:
   997	        return "unreadable", None
   998	    except Exception:  # noqa: BLE001
   999	        return "unreadable", None
  1000	    if len(raw) > _VERIFY_READ_CAP_BYTES:
  1001	        return "unreadable", None
  1002	    return "present", raw.decode("utf-8", errors="replace")
