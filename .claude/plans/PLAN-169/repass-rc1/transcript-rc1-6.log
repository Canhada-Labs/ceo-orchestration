  1124	# ---------------------------------------------------------------------------
  1125	# Tail read of canonical log (Phase 4 prev_hmac + _drain_sha256 set)
  1126	# ---------------------------------------------------------------------------
  1127	
  1128	
  1129	def _read_canonical_tail(
  1130	    log_path: Path, k_lines: int
  1131	) -> Tuple[Optional[bytes], List[Dict[str, Any]]]:
  1132	    """Return (prev_hmac_bytes_or_None, last_k_entries) from canonical log.
  1133	
  1134	    Reads up to k_lines from EOF using a backward chunked scan. Returns the
  1135	    last entry's hmac (raw bytes) plus the parsed dicts for the last K
  1136	    well-formed JSON lines. Empty / missing log → (None, []).
  1137	    """
  1138	    if not log_path.exists():
  1139	        return None, []
  1140	    try:
  1141	        size = log_path.stat().st_size
  1142	    except OSError:
  1143	        return None, []
  1144	    if size == 0:
  1145	        return None, []
  1146	
  1147	    chunk = 8192
  1148	    buf = b""
  1149	    lines: List[bytes] = []
  1150	    try:
  1151	        with log_path.open("rb") as f:
  1152	            pos = size
  1153	            while pos > 0 and len(lines) <= k_lines:
  1154	                read = min(chunk, pos)
  1155	                pos -= read
  1156	                f.seek(pos)
  1157	                buf = f.read(read) + buf
  1158	                parts = buf.split(b"\n")
  1159	                # First element may be a partial fragment until we read
  1160	                # further; keep it in buf, take the tail-complete lines.
  1161	                buf = parts[0]
  1162	                # parts[1:] are complete lines (after the first newline).
  1163	                # Reverse so we accumulate newest-first.
  1164	                for ln in reversed(parts[1:]):
  1165	                    if ln:
  1166	                        lines.append(ln)
  1167	                    if len(lines) >= k_lines:
  1168	                        break
  1169	            if pos == 0 and buf:
  1170	                if len(lines) < k_lines:
  1171	                    lines.append(buf)
  1172	    except OSError as e:
  1173	        _breadcrumb(f"canonical tail read failed: {type(e).__name__}: {e}")
  1174	        return None, []
  1175	
  1176	    # lines is newest-first; reverse to chronological order
  1177	    lines.reverse()
  1178	    entries: List[Dict[str, Any]] = []
  1179	    for raw in lines[-k_lines:]:
  1180	        try:
  1181	            obj = json.loads(raw.decode("utf-8"))
  1182	            if isinstance(obj, dict):
  1183	                entries.append(obj)
  1184	        except (json.JSONDecodeError, UnicodeDecodeError):
  1185	            continue
  1186	
  1187	    prev_hmac: Optional[bytes] = None
  1188	    for obj in reversed(entries):
  1189	        hx = obj.get("hmac")
  1190	        if isinstance(hx, str) and len(hx) == 64:
  1191	            try:
  1192	                prev_hmac = bytes.fromhex(hx)
  1193	                break
  1194	            except ValueError:
  1195	                continue
  1196	    return prev_hmac, entries
  1197	
