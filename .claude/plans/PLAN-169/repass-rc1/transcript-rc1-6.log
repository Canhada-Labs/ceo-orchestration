  2443	                # observable. Emit a DISTINCT, gated breadcrumb ONLY when our
  2444	                # own spool is already stale past the staleness trigger (holder
  2445	                # not keeping up = real starvation). Benign single-winner
  2446	                # contention (fresh spool) stays silent, so the existing
  2447	                # audit-log.errors line-count detectors (ceo-diagnose.py /
  2448	                # status.py) still surface a wedge without the benign volume.
  2449	                if _own_spool_stale_past_trigger(our_pid):
  2450	                    _breadcrumb(
  2451	                        "drain canonical lock STARVED: own spool stale past "
  2452	                        "trigger while opportunistic drain yielded"
  2453	                    )
  2454	            return stats
  2455	    except Exception as e:
  2456	        stats.ok = False
  2457	        stats.error = f"{type(e).__name__}: {e}"
  2458	        _breadcrumb(f"drain_now unexpected: {type(e).__name__}: {e}")
