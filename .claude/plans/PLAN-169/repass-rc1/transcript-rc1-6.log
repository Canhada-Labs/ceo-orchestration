   248	    pid = os.getpid()
   249	    buf = _JOURNAL_BUFFER.get(pid)
   250	    if buf:
   251	        try:
   252	            target = old_dir / "{0}.{1}.journal".format(_JOURNAL_PREFIX, pid)
   253	            with target.open("ab") as fh:
   254	                for line in buf:
   255	                    fh.write(line)
   256	                fh.flush()
   257	                os.fsync(fh.fileno())
   258	        except Exception:  # pragma: no cover — nunca bloqueia a troca
   259	            pass
   260	    _SPOOL_HEADER_CACHE.pop(pid, None)
   261	    _ORDINAL_COUNTER.pop(pid, None)
   262	    _JOURNAL_BUFFER.pop(pid, None)
