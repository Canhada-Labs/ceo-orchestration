   878	            f"spool partial-final-line isolated pid={pid} size={st.st_size}"
   879	        )
   880	    except OSError as e:  # pragma: no cover
   881	        _breadcrumb(
   882	            f"spool ready-for-append check failed pid={pid}: "
   883	            f"{type(e).__name__}: {e}"
   884	        )
