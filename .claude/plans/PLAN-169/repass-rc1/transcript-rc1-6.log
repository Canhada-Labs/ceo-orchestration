  9298	    # rung TRANSITION, which is rare by construction (that is the whole point
  9299	    # of the hysteresis above). It is bounded and fail-open by its own
  9300	    # contract, and its result cannot change what this function returns.
  9301	    _gc_context_pressure_markers(marker.parent)
