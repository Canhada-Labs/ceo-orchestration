   102	
   103	class StateStoreError(Exception):
   104	    """Base exception for all state_store errors."""
   105	
   106	
   107	class StateStoreValueTooLarge(StateStoreError):
   108	    """Raised when a set() value exceeds the per-key cap."""
   109	
   110	
   111	class StateStoreInvalidName(StateStoreError):
   112	    """Raised when store_name or plan_id fails validation."""
   113	
   114	
   115	def _state_root() -> Path:
   116	    """Return the base dir for all plan-scoped state stores.
   117	
   118	    Env-overridable via ``CEO_STATE_ROOT`` (whole state root) and
   119	    ``CEO_PROJECT_NAME`` (legacy name-based slug, kept as an EXPLICIT
   120	    operator escape hatch — it re-creates the basename-collision
   121	    hazard, so it never participates in the default). Default follows
   122	    ADR-001 (S318 amendment) via the single family resolver: the
   123	    per-project native slug dir + ``/state`` — matching audit-log
   124	    siblings (PLAN-182 W1).
   125	    """
   126	    env = os.environ.get("CEO_STATE_ROOT")
   127	    if env:
   128	        return Path(env)
   129	    project = os.environ.get("CEO_PROJECT_NAME")
   130	    if project:
   131	        home = os.environ.get("HOME") or str(Path.home())
   132	        return Path(home) / ".claude" / "projects" / project / "state"
   133	    return _runtime_paths.runtime_state_dir() / "state"
   134	
   135	
   136	def _validate_store_name(store_name: str) -> None:
   137	    """Reject store names that could escape the state root."""
   138	    if not store_name:
   139	        raise StateStoreInvalidName("store_name must be non-empty")
   140	    if len(store_name) > _STORE_NAME_MAX_LEN:
   141	        raise StateStoreInvalidName(
   142	            f"store_name too long ({len(store_name)} > {_STORE_NAME_MAX_LEN})"
   143	        )
   144	    # Allow kebab-case + underscore slugs only
   145	    for ch in store_name:
   146	        if not (ch.isalnum() or ch in "-_"):
   147	            raise StateStoreInvalidName(
   148	                f"store_name contains illegal char {ch!r}; allowed: [A-Za-z0-9_-]"
   149	            )
   150	
   151	
   152	def _validate_plan_id(plan_id: str) -> None:
   153	    """Reject plan_ids that could escape the store dir."""
   154	    if not plan_id:
   155	        raise StateStoreInvalidName("plan_id must be non-empty")
   156	    if len(plan_id) > _PLAN_ID_MAX_LEN:
   157	        raise StateStoreInvalidName(
   158	            f"plan_id too long ({len(plan_id)} > {_PLAN_ID_MAX_LEN})"
   159	        )
   160	    for ch in plan_id:
   161	        if not (ch.isalnum() or ch in "-_."):
   162	            raise StateStoreInvalidName(
   163	                f"plan_id contains illegal char {ch!r}; allowed: [A-Za-z0-9_.-]"
   164	            )
   165	    if plan_id.startswith(".") or ".." in plan_id:
   166	        raise StateStoreInvalidName(f"plan_id {plan_id!r} attempts path escape")
   167	
   168	
   169	def _plan_id_hash(plan_id: str) -> str:
   170	    """Short, stable hash for plan_id — used in audit events without leaking the raw id."""
   171	    return hashlib.sha256(plan_id.encode("utf-8", errors="replace")).hexdigest()[:16]
   172	
   173	
   174	def _key_hash(key: str) -> str:
   175	    """Short, stable hash for key — audit-safe."""
   176	    return hashlib.sha256(key.encode("utf-8", errors="replace")).hexdigest()[:16]
