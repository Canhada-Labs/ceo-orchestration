   189	    def tearDown(self) -> None:
   190	        """Restore env + cwd + sys.path + remove the per-test tmp tree.
   191	
   192	        Two-step env restoration:
   193	
   194	        1. Remove any ``CEO_*``/``CLAUDE_*``/``HOME`` env var NOT present
   195	           in ``self._env_snapshot`` (tests may have added new ones).
   196	        2. Restore the snapshotted values (delete if value was ``None``
   197	           indicating originally-unset, otherwise set to recorded value).
   198	
   199	        Also chdir back to the original cwd and restore ``sys.path`` so
   200	        test-local imports don't leak between cases.
   201	        """
   202	
   203	        # PLAN-111 Wave A.5 — invalidate spool_writer state-dir cache
   204	        # on test teardown (env restored so cache will resolve to a
   205	        # potentially-now-deleted tmpdir).
   206	        try:
   207	            from _lib import spool_writer as _spool_writer
   208	            _spool_writer._reset_caches_for_test()
   209	        except Exception:
   210	            pass
   211	        # Restore env
   212	        # 1. Remove any env vars we may have set that weren't in the snapshot
   213	        for key in list(os.environ.keys()):
   214	            if (
   215	                key.startswith("CEO_")
   216	                or key.startswith("CLAUDE_")
   217	                or key == "HOME"
   218	            ):
   219	                if key not in self._env_snapshot:
   220	                    del os.environ[key]
   221	        # 2. Restore snapshotted values
   222	        for key, value in self._env_snapshot.items():
   223	            if value is None:
   224	                os.environ.pop(key, None)
   225	            else:
   226	                os.environ[key] = value
   227	
   228	        # Restore cwd + sys.path
   229	        try:
   230	            os.chdir(self._cwd_snapshot)
   231	        except OSError:
   232	            pass
   233	        sys.path[:] = self._syspath_snapshot
   234	
   235	        # Clean the temp dir
   236	        shutil.rmtree(self._tmp_root, ignore_errors=True)
   237	
   238	        super().tearDown()
   239	
