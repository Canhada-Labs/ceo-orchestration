   153	def _generate_and_persist(
   154	    path: Path, replace_existing: bool = False
   155	) -> Tuple[bytes, str]:
   156	    """Generate a new 32-byte salt and write it to ``path``.
   157	
   158	    Returns ``(salt, outcome)`` where outcome is one of:
   159	
   160	    * ``"created"`` — this process won the race and the returned bytes
   161	      are the ones now on disk;
   162	    * ``"exists"`` — another process created the file first; NOTHING was
   163	      written and the caller must read the winner's bytes;
   164	    * ``"error"`` — an I/O failure; the salt is ``b""`` (fail-open, the
   165	      caller degrades to the unsalted hash).
   166	
   167	    rc.1 re-pass part 6 C2 — the outcome is the whole point of the
   168	    signature. Pre-cure this returned bare bytes written with
   169	    ``path.write_bytes``, which TRUNCATES: two processes minting at once
   170	    both "succeeded", each cached its own value, and one of the two was
   171	    orphaned from the file. A caller that cannot tell "I created it"
   172	    from "someone else did" also cannot tell whether it may register a
   173	    mint, and the loser used to write a ``salt-minted.json`` marker for
   174	    a mint it never performed.
   175	
   176	    ``replace_existing`` selects ``O_TRUNC`` over ``O_EXCL`` for the one
   177	    case that must overwrite: a pre-existing MALFORMED salt, which
   178	    ``_read_existing`` rejected and ``get_instance_salt`` records as a
   179	    rotation rather than a first mint. ``O_NOFOLLOW`` holds in both
   180	    arms. Sets file mode ``0o600`` and parent dir mode ``0o700``.
   181	    """
   182	    try:
   183	        # rail r2 F + r5: cria e aperta SO no caminho default — um dir
   184	        # inteiro escolhido via CLAUDE_PROJECT_DIR_NATIVE preserva o modo
   185	        # que o operador definiu.
   186	        # rail r14: TODO override capaz de escolher `_slug_dir()` desliga
   187	        # o tighten — inclusive os de familia que a cura P1-5 passou a
   188	        # honrar. Apertar um dir 0750 escolhido pelo operador revogaria
   189	        # acesso de auditor, contra a promessa assinada do sentinel.
   190	        _overridden = any(os.environ.get(_k) for _k in (
   191	            "CLAUDE_PROJECT_DIR_NATIVE",
   192	            "CEO_AUDIT_LOG_PATH",
   193	            "CEO_AUDIT_LOG_DIR",
   194	        ))
   195	        _runtime_paths.ensure_state_dir(path.parent, tighten=not _overridden)
   196	    except Exception:
   197	        return b"", "error"
   198	    salt = os.urandom(_SALT_BYTES)
   199	    # O_EXCL is the election; O_NOFOLLOW refuses a symlink squatting on
   200	    # the salt path (same discipline as the marker below, and as the
   201	    # audit writer PLAN-024 already ratified). O_TRUNC only on the
   202	    # deliberate replace-a-malformed-salt arm.
   203	    _flags = os.O_WRONLY | os.O_CREAT | getattr(os, "O_NOFOLLOW", 0)
   204	    _flags |= os.O_TRUNC if replace_existing else os.O_EXCL
   205	    try:
   206	        _fd = os.open(str(path), _flags, _SALT_MODE)
   207	    except FileExistsError:
   208	        # Lost the race. Writing nothing is the entire cure: the winner's
   209	        # bytes stay on disk and the caller re-reads them.
   210	        return b"", "exists"
   211	    except OSError:
   212	        return b"", "error"
   213	    try:
   214	        with os.fdopen(_fd, "wb") as _fh:
   215	            _fh.write(salt)
   216	    except OSError:
   217	        return b"", "error"
   218	    try:
   219	        os.chmod(path, _SALT_MODE)
   220	    except OSError:
   221	        # Permission failure on chmod is non-fatal — the salt is
   222	        # written but with default umask perms. Caller still gets
   223	        # the salt; future readers may face stricter access but the
   224	        # current process succeeds.
   225	        pass
   226	    return salt, "created"
   227	
