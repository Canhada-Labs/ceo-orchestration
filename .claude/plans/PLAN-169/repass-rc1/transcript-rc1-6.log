  9281	            with os.fdopen(_fd, "w", encoding="utf-8") as fh:
  9282	                fh.write(current + "\n")
  9283	        except Exception:
  9284	            # Never leave the temp behind on a failed write — the GC below
  9285	            # only sweeps by AGE, so an orphan would linger for a full TTL.
  9286	            try:
  9287	                os.unlink(str(tmp))
  9288	            except OSError:
  9289	                pass
  9290	            raise
